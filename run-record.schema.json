{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cc-matrix run record, schema 2",
  "description": "The record cc-matrix writes into each game it makes, as <script type=\"application/json\" id=\"cc-matrix-run\"> just before </body>. Written and read by run-record.mjs. A new field can appear within schema 2; a renamed or removed one makes schema 3.",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "stampedAt",
    "id",
    "aiHub",
    "result",
    "prompt",
    "interview"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "tool": {
      "const": "cc-matrix"
    },
    "stampedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was written (UTC)."
    },
    "id": {
      "type": "string",
      "description": "The run's id: its folder in runs/."
    },
    "lab": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "Anthropic",
        "OpenAI",
        "Google",
        "xAI",
        "Meta"
      ]
    },
    "cli": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "Claude Code CLI",
        "Codex CLI",
        "Grok CLI",
        "Antigravity CLI",
        "Muse Code CLI"
      ]
    },
    "upgradedFrom": {
      "const": 1,
      "description": "Only on a schema 1 record read in schema 2's shape (run-record.mjs upgrade()); never written."
    },
    "aiHub": {
      "$ref": "#/$defs/aiHub"
    },
    "stages": {
      "$ref": "#/$defs/stages"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "prompt": {
      "$ref": "#/$defs/prompt"
    },
    "interview": {
      "$ref": "#/$defs/interview"
    }
  },
  "$defs": {
    "aiHub": {
      "description": "AI Hub catalogue fields, named and written the way ai-hub's catalogue has them (its data/overrides.json and games.json), so an import can take them as they are. Lowest first: what ai-hub reads from the game's <head> (title as Name — Tagline, description, theme-color, hub:* meta), the agent's answers under aiHub in its exit interview, then the runner's (model, effort, harness, sourceDate). A field with no value is left out.",
      "type": "object",
      "required": [
        "type",
        "model",
        "effort",
        "harness",
        "sourceDate",
        "provenance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The game's title."
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "Game",
            "Tech demo",
            "Tool"
          ],
          "description": "Always one of the three: Game unless the agent says otherwise. A genre written as the type goes to genre (if there is none)."
        },
        "genre": {
          "type": "string",
          "examples": [
            "Action",
            "Adventure",
            "Fighting",
            "Flight",
            "Horror",
            "Kids & Learning",
            "Life Sim",
            "Platformer",
            "Puzzle",
            "Racing",
            "RPG",
            "Shooter",
            "Simulation",
            "Sports",
            "Stealth",
            "Strategy",
            "Tech Demo",
            "Graphics"
          ],
          "description": "One of the catalogue's genres when it matches one whatever its case; else as the agent wrote it."
        },
        "source": {
          "type": "string",
          "description": "The work the game is based on."
        },
        "series": {
          "type": "string",
          "description": "Its franchise."
        },
        "players": {
          "type": "string",
          "examples": [
            "1",
            "1–2",
            "1–4"
          ],
          "description": "A range is written with an en dash."
        },
        "controls": {
          "type": "string",
          "description": "One line."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lowercase, no repeats."
        },
        "themeColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{3,8}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "Claude Opus 5.5",
            "GPT-6.1 Sol",
            "Gemini 4 Argon"
          ],
          "description": "The model the run used, by the name the wall gives it."
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "medium",
            "xhigh",
            "max",
            "high-ultracode"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "Claude Code",
            "Codex",
            "Grok",
            "Antigravity",
            "Muse Code"
          ],
          "description": "The agent's CLI."
        },
        "sourceDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the run started (UTC): the date ai-hub sorts by."
        },
        "provenance": {
          "type": "object",
          "description": "What ai-hub's import registry keeps for a game.",
          "required": [
            "sourceKind",
            "artifactId",
            "sourceDate"
          ],
          "properties": {
            "sourceKind": {
              "const": "cc-matrix-run"
            },
            "artifactId": {
              "type": "string",
              "description": "The run's id."
            },
            "sourceDate": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      },
      "additionalProperties": {
        "description": "Any other hub:* field from the game's <head> (session, sessionPlayers, sessionMode, sessionMinutes, sessionGoal, sessionHowto, webgpu …) or the agent's answers."
      }
    },
    "stages": {
      "description": "Only on a run in stages (result.stage). Its game was made by every step of its chain: each step’s figures, first to last (this run last), and them added up. A plan makes no game, so this is the only record that has its figures. Taken from each step’s result.json when the game is stamped, else, when an earlier run has gone since, kept from the record already in the game.",
      "type": "object",
      "required": [
        "steps",
        "total",
        "complete"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "stage",
              "model"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The step’s run id: its folder in runs/."
              },
              "stage": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "plan",
                  "build",
                  "content"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The model ID, as in result.model.",
                "examples": [
                  "claude-opus-5-5"
                ]
              },
              "modelName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The model as ai-hub writes it.",
                "examples": [
                  "Claude Opus 5.5"
                ]
              },
              "effort": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "As aiHub.effort writes it.",
                "examples": [
                  "max",
                  "high-ultracode"
                ]
              },
              "harness": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "Claude Code",
                  "Codex"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "ok"
                ]
              },
              "startedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "finishedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "wallMinutes": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Wall-clock minutes, all its sessions."
              },
              "inputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Every token sent, cached included."
              },
              "outputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Output, reasoning included."
              },
              "cachedTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Cache reads."
              },
              "reasoningTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Thinking (part of output)."
              },
              "totalTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Input + output."
              },
              "costUsd": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "The cost the CLI reported (Claude Code, Grok), else null."
              },
              "apiCostUsd": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Its tokens at the labs’ public API list prices, so it compares across CLIs; not what a subscription paid."
              }
            }
          }
        },
        "total": {
          "type": "object",
          "description": "The steps’ figures added up; null where any step lacks that figure.",
          "properties": {
            "wallMinutes": {
              "type": [
                "number",
                "null"
              ],
              "description": "Wall-clock minutes, all its sessions."
            },
            "inputTokens": {
              "type": [
                "number",
                "null"
              ],
              "description": "Every token sent, cached included."
            },
            "outputTokens": {
              "type": [
                "number",
                "null"
              ],
              "description": "Output, reasoning included."
            },
            "cachedTokens": {
              "type": [
                "number",
                "null"
              ],
              "description": "Cache reads."
            },
            "reasoningTokens": {
              "type": [
                "number",
                "null"
              ],
              "description": "Thinking (part of output)."
            },
            "totalTokens": {
              "type": [
                "number",
                "null"
              ],
              "description": "Input + output."
            },
            "costUsd": {
              "type": [
                "number",
                "null"
              ],
              "description": "The cost the CLI reported (Claude Code, Grok), else null."
            },
            "apiCostUsd": {
              "type": [
                "number",
                "null"
              ],
              "description": "Its tokens at the labs’ public API list prices, so it compares across CLIs; not what a subscription paid."
            }
          }
        },
        "complete": {
          "type": "boolean",
          "description": "False when fewer steps were found than result.chain has (an earlier run deleted before it was ever stamped here)."
        }
      }
    },
    "result": {
      "description": "The run's result.json as the runner wrote it, minus sessionId and plan. Every dimension's variant is a field of its own (source, goal …). The README's Notes describe each field.",
      "type": "object",
      "required": [
        "id",
        "agent",
        "provider",
        "model",
        "effort",
        "status",
        "startedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "claude",
            "codex",
            "grok",
            "agy",
            "muse"
          ]
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "ultracode": {
          "type": "boolean"
        },
        "stage": {
          "type": "string"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              }
            }
          }
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cliVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "variantHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wallMinutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "apiMinutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "description": "What the CLI reported (Claude Code, Grok)."
        },
        "apiCostUsd": {
          "type": [
            "number",
            "null"
          ],
          "description": "The run's tokens at the labs' public API list prices."
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "uncachedInputTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cachedTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cacheWriteTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoningTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "totalTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "models": {
          "type": "object",
          "description": "Tokens and cost per model."
        },
        "delivered": {
          "type": "boolean"
        },
        "entry": {
          "type": [
            "string",
            "null"
          ],
          "description": "The game's path from the runs folder: <id>/work/<file>.html."
        },
        "kb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "loc": {
          "type": [
            "integer",
            "null"
          ]
        },
        "todos": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gameSha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "The game as the agent left it, without this record."
        },
        "exitInterview": {
          "enum": [
            "ok",
            "invalid",
            "missing"
          ]
        },
        "goalMet": {
          "type": "boolean",
          "description": "Whether the run's last /goal check passed (Claude Code, read from its transcript); false when it never got one. Not there for a run sent no /goal."
        },
        "goalChecks": {
          "type": "integer",
          "description": "How many /goal checks the run got."
        },
        "goalForced": {
          "type": "boolean",
          "description": "Claude Code ended the turn itself after the goal check had blocked it 9 times in a row, so the run finished without its goal."
        },
        "goalReason": {
          "type": "string",
          "description": "What the last goal check said was missing, when the goal wasn't met."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "description": "The computer's time zone: the folder name and {{stamp}} are local time."
        }
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "A hash of the template (result.promptVersion)."
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Its number in prompt-history.json (v1, v2 …)."
        },
        "savedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When that version's template was last saved."
        },
        "firstRanAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When a batch first ran that version."
        },
        "template": {
          "type": [
            "string",
            "null"
          ],
          "description": "The template, with each section's {{placeholder}}."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "The prompt as filled for this run (TASK.md for a /goal or stage run)."
        },
        "stageText": {
          "type": [
            "string",
            "null"
          ],
          "description": "A stage run's own text, what it was sent."
        },
        "goal": {
          "type": [
            "string",
            "null"
          ],
          "description": "The /goal message sent."
        },
        "sections": {
          "type": "object",
          "description": "Each dimension's variant, in the prompt's order.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "As sent; null when that can't be told any more."
              },
              "hash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "interview": {
      "type": "object",
      "properties": {
        "file": {
          "enum": [
            "exit-interview.json",
            null
          ],
          "description": "Where the answers came from; null when the run left none."
        },
        "answers": {
          "type": "object",
          "description": "exit-interview.json as the agent wrote it, except that a list of answers under a dimension's name (testingFeedback, engineFeedback, promptFeedback) is paired with that dimension's questions.",
          "properties": {
            "sourceInformation": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "testingFeedback": {
              "$ref": "#/$defs/answers"
            },
            "engineFeedback": {
              "$ref": "#/$defs/answers"
            },
            "promptFeedback": {
              "$ref": "#/$defs/answers"
            },
            "aiHub": {
              "type": "object",
              "description": "The agent's catalogue answers as written; the top-level aiHub has them the catalogue's way."
            }
          }
        },
        "error": {
          "type": "string",
          "description": "Why the file couldn't be read as one JSON object."
        },
        "text": {
          "type": "string",
          "description": "The file as written, when it couldn't be."
        },
        "reply": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent's final reply (reply.md)."
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {}
        }
      }
    }
  }
}
