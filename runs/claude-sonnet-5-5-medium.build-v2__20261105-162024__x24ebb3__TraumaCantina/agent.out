{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgkg4r5dpZfDnQYsnBAjV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Bw9Niep9U4bpfUTKN3PLXE","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/sim/campaign.js <<'EOF'\n// The campaign as data + pure save helpers (so a scripted playthrough can run in Node).\nexport const CAMPAIGN = [\n  { scene: 'ep1', op: 'op1' }, { scene: 'ep2', op: 'op2' }, { scene: 'ep3', op: 'op3' }, { scene: 'ep4', op: 'op4' }, { scene: 'ep5', op: 'op5' },\n  { scene: 'ep6', op: 'op6' }, { scene: 'ep7', op: 'op7' }, { scene: 'ep8', op: 'op8' }, { scene: 'ep9', op: 'op9' }, { scene: 'ep10', op: 'op10' }, { scene: 'end', report: true },\n];\nconst ORDER = 'SABC';\nexport const betterRank = (a, b) => (!a ? b : !b ? a : ORDER.indexOf(a) <= ORDER.indexOf(b) ? a : b);\nexport function recordResult(save, opId, res) {\n  const c = (save.cleared[opId] ??= { best: null, bestScore: 0, plays: 0, pristine: false });\n  c.best = betterRank(c.best, res.rank); c.bestScore = Math.max(c.bestScore, res.total); c.plays++; c.pristine = c.pristine || res.pristine;\n  const idx = CAMPAIGN.findIndex((s) => s.op === opId); if (idx >= 0 && idx + 1 > save.next) save.next = idx + 1;\n  if (opId === 'op3') save.quietOn = true;\n  return save;\n}\nexport const isUnlocked = (save, opId) => save.unlockedAll || !!save.cleared[opId] || CAMPAIGN.findIndex((s) => s.op === opId) <= save.next;\nexport const clearedOps = (save) => Object.keys(save.cleared);\nexport function shiftReport(save) { return CAMPAIGN.filter((s) => s.op).map((s) => ({ op: s.op, rank: save.cleared[s.op]?.best || '-' })); }\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally with ticks, the rank stamp slams, Reyes comments, the patient's follow-up.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../app.js';\nimport { go, swap } from '../core/nav.js';\nimport { BY_ID } from '../content/ops/index.js';\nimport { recordResult, CAMPAIGN } from '../sim/campaign.js';\nimport { ctext, mtext, textW, wrap, bar, prompts } from '../ui/hud.js';\nimport { fmtTime } from '../ui/hud.js';\nimport { buildSet } from '../view/sets.js';\nimport { LOOK } from '../core/look.js';\nimport { pick } from '../content/lines.js';\nimport { Speaker } from '../audio/speak.js';\nconst REYES = { S: 'Pristine hands, Doctor. I am *suspicious*.', A: '...Adequate. Do not let it go to your head. It is not attached to anything useful.', B: 'Acceptable. Do better. I believe you can. That is the problem.', C: 'He will keep the arm. Do better.' };\nexport class ResultsStage {\n  name = 'Results';\n  constructor(a) { this.a = a; this.def = BY_ID[a.opId]; }\n  async setup(ctx) {\n    this.ctx = ctx; this.t = 0; this.res = this.a.res; const sim = this.a.sim;\n    ctx.engine.setLook(LOOK(1, 0.4, 0)); ctx.engine.sun.intensity = 0.3; ctx.engine.ambient.intensity = 0.3;\n    this.set = buildSet(ctx, 'or7'); const c = ctx.camera.camera; c.position.set(0, 4.6, 8.6); c.lookAt(0, 1.6, 0); this.lines = [];\n    const r = this.res; const per = this.a.sim.per;\n    this.rows = [['TIME LEFT', fmtTime(r.timeLeft), `+${r.timeBonus}`], ['VITALS', `${r.vit}`, `+${r.vitBonus}`], ['TECHNIQUE', `${r.clean}C ${r.good}G ${r.sloppy}S`, `${r.points}`], ['BEST STREAK', `${r.maxStreak}`, ''], ['MISTAKES', `${r.mistakes}`, r.mistakes ? `-${r.mistakes * 150}` : '0']];\n    this.shown = 0; this.stamped = false; this.speaker = new Speaker(app); this.rankPlay = r.rank;\n    if (!this.a.noSave && !app.attractActive) { recordResult(app.save, this.def.id, r); if (this.def.id === 'op3') app.save.quietOn = true; app.flush(); }\n    ctx.audio.stopLoops(); app.director.start(ctx, r.rank === 'C' ? 'results-sad' : 'results', 0);\n    this.fu = (this.def.patient.followUp[r.rank] || this.def.patient.followUp.C); this.rc = REYES[r.rank];\n    this.state = 'tally'; this.tt = 0; this.done = false; this.act0 = app.devices.activity;\n  }\n  cameraTarget() { return new THREE.Vector3(0, 1.6, 0); }\n  status() { return `results ${this.def.id} rank ${this.res.rank} total ${this.res.total}`; }\n  update(ctx, dt) {\n    const hud = ctx.hud, dev = app.devices; dev.poll(dt, ctx); const nav = dev.nav; this.t += dt; this.set.update(dt, this.t);\n    hud.clear(); const w = hud.width, h = hud.height;\n    if (this.a.attract && dev.activity !== this.act0) return go.title(ctx, { swallow: true });\n    // the chart drops in\n    const drop = Math.min(1, this.t / 0.6), y0 = Math.round(-200 + 200 * (1 - Math.pow(1 - drop, 3)) + 8), cw = 320, cx = Math.round((w - cw) / 2);\n    hud.rect(cx - 2, y0 - 2, cw + 4, h - 16, 'slate'); hud.rect(cx, y0, cw, h - 20, 'white'); hud.rect(cx + cw / 2 - 16, y0 - 6, 32, 8, 'ink');\n    hud.text(cx + 8, y0 + 8, 'OPERATIVE REPORT', { color: 'ink', shadow: false, scale: 2 }); hud.text(cx + 8, y0 + 26, `${this.def.patient.name}  ${this.def.patient.age ? 'AGE ' + this.def.patient.age : ''}`, { color: 'navy', shadow: false }); hud.text(cx + 8, y0 + 35, this.def.title, { color: 'red', shadow: false });\n    this.tt += dt; const per = 0.55; const n = Math.min(this.rows.length, Math.floor(Math.max(0, this.t - 0.8) / per) + 1); if (this.t > 0.8 && n > this.shown) { this.shown = n; ctx.audio.play('tick', { pitch: n }); }\n    this.rows.forEach((r, i) => { if (i >= this.shown) return; const yy = y0 + 52 + i * 14; hud.text(cx + 10, yy, r[0], { color: 'ink', shadow: false }); hud.text(cx + 120, yy, r[1], { color: 'navy', shadow: false }); hud.text(cx + cw - 12 - textW(hud, r[2]), yy, r[2], { color: r[2].startsWith('-') ? 'red' : 'green', shadow: false }); hud.rect(cx + 10, yy + 9, cw - 20, 1, 'mist'); });\n    const doneRows = this.t > 0.8 + this.rows.length * per + 0.3;\n    if (doneRows) { hud.text(cx + 10, y0 + 52 + 5 * 14 + 4, 'TOTAL', { color: 'ink', shadow: false, scale: 2 }); hud.text(cx + 120, y0 + 52 + 5 * 14 + 4, String(this.res.total), { color: 'navy', shadow: false, scale: 2 }); }\n    const st = this.t - (0.8 + this.rows.length * per + 0.9);\n    if (st > 0) {\n      if (!this.stamped) { this.stamped = true; ctx.audio.play('stamp'); ctx.engine.shake.add(app.settings.shake ? 0.8 : 0); ctx.engine.hitstop?.(0.1); app.devices.rumbleAll(1, 1, 250); if (this.res.rank === 'S') ctx.audio.play('fanfare'); this.speaker.start('reyes', this.rc.replace(/\\*/g, '')); }\n      const k = Math.min(1, st / 0.2), sc = 6 - Math.round(3 * k) + (this.res.rank === 'S' ? 0 : 0), col = { S: 'sand', A: 'lime', B: 'sky', C: 'orange' }[this.res.rank];\n      const rx = cx + cw - 70, ry = y0 + 40; hud.text(rx, ry, this.res.rank, { scale: sc, color: col, shadow: 'ink' }); if (this.res.pristine) hud.text(rx - 10, ry + 42, 'PRISTINE', { color: 'sand', scale: 1, shadow: 'ink' }); if (this.res.capped) hud.text(rx - 12, ry + 52, `CAPPED AT ${this.res.capped}`, { color: 'red', shadow: false });\n      this.speaker.update(ctx, dt);\n      const ty = y0 + 52 + 5 * 14 + 28; hud.text(cx + 10, ty, 'REYES:', { color: 'red', shadow: false }); wrap(hud, this.speaker.shown, cw - 70).slice(0, 3).forEach((l, i) => mtext(hud, cx + 52, ty + i * 9, l, { color: 'ink', hi: 'red', shadow: false }));\n      if (st > 2.2) { hud.text(cx + 10, ty + 34, 'FOLLOW-UP:', { color: 'navy', shadow: false }); wrap(hud, this.fu, cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, ty + 44 + i * 9, l, { color: 'ink', shadow: false })); this.done = true; }\n    }\n    if (this.done) { prompts(hud, app, [{ act: 'confirm', label: this.a.consult ? 'BACK TO CONSULT' : 'CONTINUE' }], 'center', h - 14); if (nav.confirm || nav.click) this.next(ctx); }\n    else if (nav.confirm || nav.click) { if (this.t < 0.8 + this.rows.length * per + 0.5) this.t = 0.8 + this.rows.length * per + 0.5; }\n    if (this.a.attract && this.t > 9) go.attractNext?.(ctx, this.a.attract);\n  }\n  next(ctx) {\n    if (this.leaving) return; this.leaving = true; ctx.audio.play('uiOk');\n    if (this.a.consult) return go.consult(ctx); if (this.a.attract) return go.attractNext?.(ctx, this.a.attract);\n    if (this.a.replay) return go.menu(ctx);\n    const idx = CAMPAIGN.findIndex((s) => s.op === this.def.id); const nx = CAMPAIGN[idx + 1]; if (!nx) return go.menu(ctx);\n    go.story(ctx, nx.scene, { next: () => (nx.op ? go.briefing(ctx, nx.op) : go.credits(ctx)) });\n  }\n  dispose() {}\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// Briefing: a clipboard chart over a dim OR-7, then the camera dives to the field behind an iris.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../app.js';\nimport { go, swap } from '../core/nav.js';\nimport { BY_ID } from '../content/ops/index.js';\nimport { LINES } from '../content/lines.js';\nimport { ctext, mtext, wrap, prompts, textW } from '../ui/hud.js';\nimport { buildSet } from '../view/sets.js';\nimport { LOOK } from '../core/look.js';\nconst OBJ = { op1: 'REMOVE ALL THE HOOKS. CLOSE THE ARM.', op2: 'FIND WHAT HE SWALLOWED. REMOVE IT. CLOSE.', op3: 'KEEP ALL THREE PATIENTS ALIVE.', op4: 'REBUILD THE BONE. SEAL IT. SURVIVE THE CODE.', op5: 'FIND THE KNOCK. PULL THE STRAIN OUT.', op6: 'TRANSPLANT THE KIDNEY BEFORE IT GOES COLD.', op7: 'CALM THE WEEPER. DRAIN THE TEARS.', op8: 'WORK ON THE BEAT. STOP THE HEART\\'S RAGE.', op9: 'NO SIGNAL. TRUST YOUR HANDS.', op10: 'DO NO HARM. TAKE YOUR TIME.', pileup: 'EVERYONE SCRUBS IN. CLOSE THE WOUND.' };\nexport class BriefingStage {\n  name = 'Briefing';\n  constructor(a) { this.a = a; this.def = BY_ID[a.opId]; }\n  async setup(ctx) {\n    this.ctx = ctx; this.t = 0; ctx.engine.setLook(LOOK(0.9, 0.5, 0)); this.set = buildSet(ctx, 'or7'); const c = ctx.camera.camera; c.position.set(0, 4.6, 8.6); c.fov = 46; c.updateProjectionMatrix(); c.lookAt(0, 1.6, 0);\n    app.director.start(ctx, 'or-calm', 0); this.go = false; this.gt = 0; this.act0 = app.devices.activity;\n  }\n  cameraTarget() { return new THREE.Vector3(0, 1.6, 0); }\n  status() { return `briefing ${this.def.id}`; }\n  update(ctx, dt) {\n    const hud = ctx.hud, dev = app.devices; dev.poll(dt, ctx); const nav = dev.nav; this.t += dt; this.set.update(dt, this.t);\n    hud.clear(); const w = hud.width, h = hud.height; const p = this.def.patient;\n    if (this.go) { this.gt += dt; const k = Math.min(1, this.gt / 1.3), c = ctx.camera.camera; const e = k * k * (3 - 2 * k); c.position.set(0.5 * e, 4.6 + (9.6 - 4.6) * e, 8.6 + (3.1 - 8.6) * e); c.lookAt(0, 1.6 * (1 - e), 0.1 * e); if (this.gt > 1.0 && !this.cov) { this.cov = true; this.start(ctx); } return; }\n    const drop = Math.min(1, this.t / 0.5), y0 = Math.round(14 - 240 * Math.pow(1 - drop, 3)), cw = 290, cx = Math.round((w - cw) / 2) - 20;\n    hud.rect(cx - 2, y0 - 2, cw + 4, 224, 'slate'); hud.rect(cx, y0, cw, 220, 'white'); hud.rect(cx + cw / 2 - 20, y0 - 6, 40, 9, 'ink');\n    hud.text(cx + 10, y0 + 10, 'PATIENT CHART', { color: 'navy', shadow: false }); hud.text(cx + 10, y0 + 22, p.name, { color: 'ink', scale: 2, shadow: false });\n    hud.text(cx + 10, y0 + 42, p.age ? `AGE ${p.age}   ${p.job}` : p.job, { color: 'navy', shadow: false });\n    hud.rect(cx + 10, y0 + 54, cw - 20, 1, 'mist'); wrap(hud, p.hook, cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, y0 + 62 + i * 10, l, { color: 'ink', shadow: false }));\n    hud.text(cx + 10, y0 + 100, 'OBJECTIVE', { color: 'red', shadow: false }); wrap(hud, OBJ[this.def.id] || '', cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, y0 + 110 + i * 10, l, { color: 'ink', shadow: false }));\n    hud.text(cx + 10, y0 + 146, `SURGEON: ${this.def.surgeon === 'sabine' ? 'DR. ACHTERBERG' : this.def.partner ? 'DR. MARSH + DR. ACHTERBERG' : 'DR. MARSH'}`, { color: 'navy', shadow: false });\n    // op title stamp\n    const st = Math.min(1, Math.max(0, (this.t - 0.9) / 0.25)); if (st > 0) { const sc = 3 - Math.round(st); const tw = textW(hud, this.def.title, sc) ; hud.rect(cx + 8, y0 + 170, cw - 16, 40, 'white'); for (let i = 0; i < 4; i++) hud.rect(cx + 8 + i, y0 + 170 + i, cw - 16 - 2 * i, 1, 'red'); hud.text(Math.round(cx + cw / 2 - tw / 2), y0 + 182, this.def.title, { color: 'red', scale: sc, shadow: false }); if (!this.sd) { this.sd = true; ctx.audio.play('stamp'); ctx.engine.shake.add(0.3); } }\n    prompts(hud, app, [{ act: 'confirm', label: 'SCRUB IN' }, { act: 'back', label: 'BACK' }], 'center', h - 14);\n    if (this.t > 0.6 && nav.confirm) { this.go = true; this.gt = 0; ctx.audio.play('uiOk'); } if (nav.click && this.t > 0.6) { this.go = true; this.gt = 0; } if (nav.back) go.menu(ctx);\n  }\n  start(ctx) { go.operation(ctx, { opId: this.def.id, difficulty: app.save.difficulty, noDive: true }); }\n  dispose() {}\n}\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19591,"cache_read_input_tokens":337802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19591},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"8b4ee001-15fd-4788-b6c3-4d22360c05cf","timestamp":"2026-11-05T23:48:34.669Z","request_id":"req_011Cgkg4qpG6HMiNJc5ppVTr","wire_tool_inputs":{"toolu_01Bw9Niep9U4bpfUTKN3PLXE":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/sim/campaign.js <<'EOF'\n// The campaign as data + pure save helpers (so a scripted playthrough can run in Node).\nexport const CAMPAIGN = [\n  { scene: 'ep1', op: 'op1' }, { scene: 'ep2', op: 'op2' }, { scene: 'ep3', op: 'op3' }, { scene: 'ep4', op: 'op4' }, { scene: 'ep5', op: 'op5' },\n  { scene: 'ep6', op: 'op6' }, { scene: 'ep7', op: 'op7' }, { scene: 'ep8', op: 'op8' }, { scene: 'ep9', op: 'op9' }, { scene: 'ep10', op: 'op10' }, { scene: 'end', report: true },\n];\nconst ORDER = 'SABC';\nexport const betterRank = (a, b) => (!a ? b : !b ? a : ORDER.indexOf(a) <= ORDER.indexOf(b) ? a : b);\nexport function recordResult(save, opId, res) {\n  const c = (save.cleared[opId] ??= { best: null, bestScore: 0, plays: 0, pristine: false });\n  c.best = betterRank(c.best, res.rank); c.bestScore = Math.max(c.bestScore, res.total); c.plays++; c.pristine = c.pristine || res.pristine;\n  const idx = CAMPAIGN.findIndex((s) => s.op === opId); if (idx >= 0 && idx + 1 > save.next) save.next = idx + 1;\n  if (opId === 'op3') save.quietOn = true;\n  return save;\n}\nexport const isUnlocked = (save, opId) => save.unlockedAll || !!save.cleared[opId] || CAMPAIGN.findIndex((s) => s.op === opId) <= save.next;\nexport const clearedOps = (save) => Object.keys(save.cleared);\nexport function shiftReport(save) { return CAMPAIGN.filter((s) => s.op).map((s) => ({ op: s.op, rank: save.cleared[s.op]?.best || '-' })); }\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally with ticks, the rank stamp slams, Reyes comments, the patient's follow-up.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../app.js';\nimport { go, swap } from '../core/nav.js';\nimport { BY_ID } from '../content/ops/index.js';\nimport { recordResult, CAMPAIGN } from '../sim/campaign.js';\nimport { ctext, mtext, textW, wrap, bar, prompts } from '../ui/hud.js';\nimport { fmtTime } from '../ui/hud.js';\nimport { buildSet } from '../view/sets.js';\nimport { LOOK } from '../core/look.js';\nimport { pick } from '../content/lines.js';\nimport { Speaker } from '../audio/speak.js';\nconst REYES = { S: 'Pristine hands, Doctor. I am *suspicious*.', A: '...Adequate. Do not let it go to your head. It is not attached to anything useful.', B: 'Acceptable. Do better. I believe you can. That is the problem.', C: 'He will keep the arm. Do better.' };\nexport class ResultsStage {\n  name = 'Results';\n  constructor(a) { this.a = a; this.def = BY_ID[a.opId]; }\n  async setup(ctx) {\n    this.ctx = ctx; this.t = 0; this.res = this.a.res; const sim = this.a.sim;\n    ctx.engine.setLook(LOOK(1, 0.4, 0)); ctx.engine.sun.intensity = 0.3; ctx.engine.ambient.intensity = 0.3;\n    this.set = buildSet(ctx, 'or7'); const c = ctx.camera.camera; c.position.set(0, 4.6, 8.6); c.lookAt(0, 1.6, 0); this.lines = [];\n    const r = this.res; const per = this.a.sim.per;\n    this.rows = [['TIME LEFT', fmtTime(r.timeLeft), `+${r.timeBonus}`], ['VITALS', `${r.vit}`, `+${r.vitBonus}`], ['TECHNIQUE', `${r.clean}C ${r.good}G ${r.sloppy}S`, `${r.points}`], ['BEST STREAK', `${r.maxStreak}`, ''], ['MISTAKES', `${r.mistakes}`, r.mistakes ? `-${r.mistakes * 150}` : '0']];\n    this.shown = 0; this.stamped = false; this.speaker = new Speaker(app); this.rankPlay = r.rank;\n    if (!this.a.noSave && !app.attractActive) { recordResult(app.save, this.def.id, r); if (this.def.id === 'op3') app.save.quietOn = true; app.flush(); }\n    ctx.audio.stopLoops(); app.director.start(ctx, r.rank === 'C' ? 'results-sad' : 'results', 0);\n    this.fu = (this.def.patient.followUp[r.rank] || this.def.patient.followUp.C); this.rc = REYES[r.rank];\n    this.state = 'tally'; this.tt = 0; this.done = false; this.act0 = app.devices.activity;\n  }\n  cameraTarget() { return new THREE.Vector3(0, 1.6, 0); }\n  status() { return `results ${this.def.id} rank ${this.res.rank} total ${this.res.total}`; }\n  update(ctx, dt) {\n    const hud = ctx.hud, dev = app.devices; dev.poll(dt, ctx); const nav = dev.nav; this.t += dt; this.set.update(dt, this.t);\n    hud.clear(); const w = hud.width, h = hud.height;\n    if (this.a.attract && dev.activity !== this.act0) return go.title(ctx, { swallow: true });\n    // the chart drops in\n    const drop = Math.min(1, this.t / 0.6), y0 = Math.round(-200 + 200 * (1 - Math.pow(1 - drop, 3)) + 8), cw = 320, cx = Math.round((w - cw) / 2);\n    hud.rect(cx - 2, y0 - 2, cw + 4, h - 16, 'slate'); hud.rect(cx, y0, cw, h - 20, 'white'); hud.rect(cx + cw / 2 - 16, y0 - 6, 32, 8, 'ink');\n    hud.text(cx + 8, y0 + 8, 'OPERATIVE REPORT', { color: 'ink', shadow: false, scale: 2 }); hud.text(cx + 8, y0 + 26, `${this.def.patient.name}  ${this.def.patient.age ? 'AGE ' + this.def.patient.age : ''}`, { color: 'navy', shadow: false }); hud.text(cx + 8, y0 + 35, this.def.title, { color: 'red', shadow: false });\n    this.tt += dt; const per = 0.55; const n = Math.min(this.rows.length, Math.floor(Math.max(0, this.t - 0.8) / per) + 1); if (this.t > 0.8 && n > this.shown) { this.shown = n; ctx.audio.play('tick', { pitch: n }); }\n    this.rows.forEach((r, i) => { if (i >= this.shown) return; const yy = y0 + 52 + i * 14; hud.text(cx + 10, yy, r[0], { color: 'ink', shadow: false }); hud.text(cx + 120, yy, r[1], { color: 'navy', shadow: false }); hud.text(cx + cw - 12 - textW(hud, r[2]), yy, r[2], { color: r[2].startsWith('-') ? 'red' : 'green', shadow: false }); hud.rect(cx + 10, yy + 9, cw - 20, 1, 'mist'); });\n    const doneRows = this.t > 0.8 + this.rows.length * per + 0.3;\n    if (doneRows) { hud.text(cx + 10, y0 + 52 + 5 * 14 + 4, 'TOTAL', { color: 'ink', shadow: false, scale: 2 }); hud.text(cx + 120, y0 + 52 + 5 * 14 + 4, String(this.res.total), { color: 'navy', shadow: false, scale: 2 }); }\n    const st = this.t - (0.8 + this.rows.length * per + 0.9);\n    if (st > 0) {\n      if (!this.stamped) { this.stamped = true; ctx.audio.play('stamp'); ctx.engine.shake.add(app.settings.shake ? 0.8 : 0); ctx.engine.hitstop?.(0.1); app.devices.rumbleAll(1, 1, 250); if (this.res.rank === 'S') ctx.audio.play('fanfare'); this.speaker.start('reyes', this.rc.replace(/\\*/g, '')); }\n      const k = Math.min(1, st / 0.2), sc = 6 - Math.round(3 * k) + (this.res.rank === 'S' ? 0 : 0), col = { S: 'sand', A: 'lime', B: 'sky', C: 'orange' }[this.res.rank];\n      const rx = cx + cw - 70, ry = y0 + 40; hud.text(rx, ry, this.res.rank, { scale: sc, color: col, shadow: 'ink' }); if (this.res.pristine) hud.text(rx - 10, ry + 42, 'PRISTINE', { color: 'sand', scale: 1, shadow: 'ink' }); if (this.res.capped) hud.text(rx - 12, ry + 52, `CAPPED AT ${this.res.capped}`, { color: 'red', shadow: false });\n      this.speaker.update(ctx, dt);\n      const ty = y0 + 52 + 5 * 14 + 28; hud.text(cx + 10, ty, 'REYES:', { color: 'red', shadow: false }); wrap(hud, this.speaker.shown, cw - 70).slice(0, 3).forEach((l, i) => mtext(hud, cx + 52, ty + i * 9, l, { color: 'ink', hi: 'red', shadow: false }));\n      if (st > 2.2) { hud.text(cx + 10, ty + 34, 'FOLLOW-UP:', { color: 'navy', shadow: false }); wrap(hud, this.fu, cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, ty + 44 + i * 9, l, { color: 'ink', shadow: false })); this.done = true; }\n    }\n    if (this.done) { prompts(hud, app, [{ act: 'confirm', label: this.a.consult ? 'BACK TO CONSULT' : 'CONTINUE' }], 'center', h - 14); if (nav.confirm || nav.click) this.next(ctx); }\n    else if (nav.confirm || nav.click) { if (this.t < 0.8 + this.rows.length * per + 0.5) this.t = 0.8 + this.rows.length * per + 0.5; }\n    if (this.a.attract && this.t > 9) go.attractNext?.(ctx, this.a.attract);\n  }\n  next(ctx) {\n    if (this.leaving) return; this.leaving = true; ctx.audio.play('uiOk');\n    if (this.a.consult) return go.consult(ctx); if (this.a.attract) return go.attractNext?.(ctx, this.a.attract);\n    if (this.a.replay) return go.menu(ctx);\n    const idx = CAMPAIGN.findIndex((s) => s.op === this.def.id); const nx = CAMPAIGN[idx + 1]; if (!nx) return go.menu(ctx);\n    go.story(ctx, nx.scene, { next: () => (nx.op ? go.briefing(ctx, nx.op) : go.credits(ctx)) });\n  }\n  dispose() {}\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// Briefing: a clipboard chart over a dim OR-7, then the camera dives to the field behind an iris.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../app.js';\nimport { go, swap } from '../core/nav.js';\nimport { BY_ID } from '../content/ops/index.js';\nimport { LINES } from '../content/lines.js';\nimport { ctext, mtext, wrap, prompts, textW } from '../ui/hud.js';\nimport { buildSet } from '../view/sets.js';\nimport { LOOK } from '../core/look.js';\nconst OBJ = { op1: 'REMOVE ALL THE HOOKS. CLOSE THE ARM.', op2: 'FIND WHAT HE SWALLOWED. REMOVE IT. CLOSE.', op3: 'KEEP ALL THREE PATIENTS ALIVE.', op4: 'REBUILD THE BONE. SEAL IT. SURVIVE THE CODE.', op5: 'FIND THE KNOCK. PULL THE STRAIN OUT.', op6: 'TRANSPLANT THE KIDNEY BEFORE IT GOES COLD.', op7: 'CALM THE WEEPER. DRAIN THE TEARS.', op8: 'WORK ON THE BEAT. STOP THE HEART\\'S RAGE.', op9: 'NO SIGNAL. TRUST YOUR HANDS.', op10: 'DO NO HARM. TAKE YOUR TIME.', pileup: 'EVERYONE SCRUBS IN. CLOSE THE WOUND.' };\nexport class BriefingStage {\n  name = 'Briefing';\n  constructor(a) { this.a = a; this.def = BY_ID[a.opId]; }\n  async setup(ctx) {\n    this.ctx = ctx; this.t = 0; ctx.engine.setLook(LOOK(0.9, 0.5, 0)); this.set = buildSet(ctx, 'or7'); const c = ctx.camera.camera; c.position.set(0, 4.6, 8.6); c.fov = 46; c.updateProjectionMatrix(); c.lookAt(0, 1.6, 0);\n    app.director.start(ctx, 'or-calm', 0); this.go = false; this.gt = 0; this.act0 = app.devices.activity;\n  }\n  cameraTarget() { return new THREE.Vector3(0, 1.6, 0); }\n  status() { return `briefing ${this.def.id}`; }\n  update(ctx, dt) {\n    const hud = ctx.hud, dev = app.devices; dev.poll(dt, ctx); const nav = dev.nav; this.t += dt; this.set.update(dt, this.t);\n    hud.clear(); const w = hud.width, h = hud.height; const p = this.def.patient;\n    if (this.go) { this.gt += dt; const k = Math.min(1, this.gt / 1.3), c = ctx.camera.camera; const e = k * k * (3 - 2 * k); c.position.set(0.5 * e, 4.6 + (9.6 - 4.6) * e, 8.6 + (3.1 - 8.6) * e); c.lookAt(0, 1.6 * (1 - e), 0.1 * e); if (this.gt > 1.0 && !this.cov) { this.cov = true; this.start(ctx); } return; }\n    const drop = Math.min(1, this.t / 0.5), y0 = Math.round(14 - 240 * Math.pow(1 - drop, 3)), cw = 290, cx = Math.round((w - cw) / 2) - 20;\n    hud.rect(cx - 2, y0 - 2, cw + 4, 224, 'slate'); hud.rect(cx, y0, cw, 220, 'white'); hud.rect(cx + cw / 2 - 20, y0 - 6, 40, 9, 'ink');\n    hud.text(cx + 10, y0 + 10, 'PATIENT CHART', { color: 'navy', shadow: false }); hud.text(cx + 10, y0 + 22, p.name, { color: 'ink', scale: 2, shadow: false });\n    hud.text(cx + 10, y0 + 42, p.age ? `AGE ${p.age}   ${p.job}` : p.job, { color: 'navy', shadow: false });\n    hud.rect(cx + 10, y0 + 54, cw - 20, 1, 'mist'); wrap(hud, p.hook, cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, y0 + 62 + i * 10, l, { color: 'ink', shadow: false }));\n    hud.text(cx + 10, y0 + 100, 'OBJECTIVE', { color: 'red', shadow: false }); wrap(hud, OBJ[this.def.id] || '', cw - 24).slice(0, 3).forEach((l, i) => hud.text(cx + 10, y0 + 110 + i * 10, l, { color: 'ink', shadow: false }));\n    hud.text(cx + 10, y0 + 146, `SURGEON: ${this.def.surgeon === 'sabine' ? 'DR. ACHTERBERG' : this.def.partner ? 'DR. MARSH + DR. ACHTERBERG' : 'DR. MARSH'}`, { color: 'navy', shadow: false });\n    // op title stamp\n    const st = Math.min(1, Math.max(0, (this.t - 0.9) / 0.25)); if (st > 0) { const sc = 3 - Math.round(st); const tw = textW(hud, this.def.title, sc) ; hud.rect(cx + 8, y0 + 170, cw - 16, 40, 'white'); for (let i = 0; i < 4; i++) hud.rect(cx + 8 + i, y0 + 170 + i, cw - 16 - 2 * i, 1, 'red'); hud.text(Math.round(cx + cw / 2 - tw / 2), y0 + 182, this.def.title, { color: 'red', scale: sc, shadow: false }); if (!this.sd) { this.sd = true; ctx.audio.play('stamp'); ctx.engine.shake.add(0.3); } }\n    prompts(hud, app, [{ act: 'confirm', label: 'SCRUB IN' }, { act: 'back', label: 'BACK' }], 'center', h - 14);\n    if (this.t > 0.6 && nav.confirm) { this.go = true; this.gt = 0; ctx.audio.play('uiOk'); } if (nav.click && this.t > 0.6) { this.go = true; this.gt = 0; } if (nav.back) go.menu(ctx);\n  }\n  start(ctx) { go.operation(ctx, { opId: this.def.id, difficulty: app.save.difficulty, noDive: true }); }\n  dispose() {}\n}\nEOF\necho ok"}}}
