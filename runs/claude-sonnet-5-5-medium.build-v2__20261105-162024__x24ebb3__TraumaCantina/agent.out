orTimeout(400); } await shot('bust-' + sc, 1500); }\nconsole.log('errs', errs.slice(0, 5)); await browser.close();\nEOF\ntimeout 590 node tests/browser/review.mjs 2>&1 | tail -3\" completed (exit code 0)","uuid":"b513f29f-c156-4385-9516-9e5900cc6a65","session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5"}
