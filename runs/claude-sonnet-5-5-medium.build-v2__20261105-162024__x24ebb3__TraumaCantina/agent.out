{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkfgV6xXfJ76mgiTwYBK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ABC4Biau1Dhc3HgM1ordg9","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/content/scenes.js <<'EOF'\n// Story scenes are data: { id, set, music, beats:[{ who, emo, say, cue }] }. Each beat is at most 2 lines of 60 characters.\nconst B = (who, emo, say, extra = {}) => ({ who, emo, say, ...extra });\nexport const SCENES = [\n  { id: 'ep1', title: 'EP 1: NIGHT SHIFT', set: 'or7', music: 'title', beats: [\n    B('narrator', 'neutral', 'PORT VERITY. 3 A.M. THE RAIN HAS NOT STOPPED SINCE TUESDAY.', { cue: 'horn' }),\n    B('reyes', 'angry', 'DOCTOR. *DOCTOR.* WAKE UP.', { cue: 'clipboard' }),\n    B('ilya', 'panic', 'I AM AWAKE. I AM DEFINITELY AWAKE. WHERE IS THE CHIEF?'),\n    B('reyes', 'stern', 'UNREACHABLE. THE STORM HAS TAKEN THE PHONES AND HIS PATIENCE.'),\n    B('reyes', 'stern', 'YOU. YES, YOU. THE ONE HOLDING THE COFFEE. YOU ARE ON.'),\n    B('ilya', 'panic', 'ME? I AM A SECOND-YEAR. I SPILL THINGS. I SPILL *COFFEE*.'),\n    B('reyes', 'stern', 'TOMASZ DOLAN. TRAWLER DECKHAND. ELEVEN FISHHOOKS, ONE ARM.'),\n    B('ilya', 'shock', 'ELEVEN?! HOW DO YOU GET ELEVEN FISHHOOKS IN ONE ARM?'),\n    B('tomasz', 'sad', 'IT WAS A LONG NET, DOC. HIS DAUGHTER... MY DAUGHTER... WEDDING SATURDAY.'),\n    B('ilya', 'neutral', 'I CAN DO THIS. I CAN DO THIS. NURSE REYES, CAN I DO THIS?'),\n    B('reyes', 'stern', 'SCALPEL, DOCTOR. THE SHARP END GOES TOWARD THE PATIENT.'),\n    B('reyes', 'stern', 'WE HAVE DISCUSSED THIS. SCRUB IN.'),\n  ] },\n  { id: 'ep2', title: 'EP 2: MORNING ROUNDS', set: 'ward', music: 'ward', beats: [\n    B('narrator', 'neutral', 'MORNING ROUNDS. THE WARD LEAKS IN THREE PLACES. ALL OF THEM ARE BUCKETS.'),\n    B('ilya', 'panic', 'BED FOUR HAS A... NUMBER. BED FIVE HAS ANOTHER NUMBER. I AM FINE.'),\n    B('pem', 'smile', 'PATIENT IS UNDER. SLEEPING LIKE A BABY. A VERY EXPENSIVE BABY.'),\n    B('ilya', 'stern', 'DR. OKOYE, THEY ARE AWAKE. THEY ARE JUST *LOOKING* AT US.'),\n    B('pem', 'smile', 'I RETIRE TO MY BOAT IN SIX WEEKS. I HAVE BEEN SAYING THAT FOR NINE YEARS.'),\n    B('reyes', 'stern', 'DOCTOR. BED SEVEN. THE GREAT ZAMBONI. HE SWALLOWED SOMETHING.'),\n    B('zamboni', 'smile', 'A TRICK, DARLINGS! THE ACT WENT WRONG. WE DO NOT SPEAK OF WHAT.'),\n    B('ilya', 'stern', 'SIR, WHAT DID YOU SWALLOW?'),\n    B('zamboni', 'smile', 'A MAGICIAN NEVER TELLS. ALSO I DO NOT KNOW. IT WAS A LOT.'),\n    B('reyes', 'neutral', 'SCRUB IN, DOCTOR. KEEP THE DOVE OUT OF RECOVERY.'),\n  ] },\n  { id: 'ep3', title: 'EP 3: MASS CASUALTY', set: 'corridor', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'A FERRY HAS HIT THE BREAKWATER. THE CORRIDOR SMELLS OF DIESEL AND SALT.'),\n    B('reyes', 'angry', 'THREE TABLES! ONE DOCTOR! WE ARE SHORT EVERYTHING EXCEPT RAIN!'),\n    B('bram', 'stern', 'MEDICINE ISN\\'T MIRACLES, SON. IT IS SHOWING UP AGAIN TOMORROW.'),\n    B('ilya', 'neutral', 'CHIEF. YOUR HAND. IT IS SHAKING.'),\n    B('bram', 'stern', 'IT IS COLD. TAKE THE CHARTS, DOCTOR. THE LEG, THE DEBRIS, THE CHEST.'),\n    B('ilya', 'panic', 'I CANNOT BE IN THREE PLACES. NURSE REYES, CAN I BE IN THREE PLACES?'),\n    B('reyes', 'stern', 'YOU WILL BE IN ONE PLACE AT A TIME. QUICKLY. SWITCH WITH THE TABLE KEYS.'),\n    B('bram', 'sad', 'AND SON... IF THE ROOM GOES QUIET. DO NOT BE AFRAID OF IT.'),\n    B('ilya', 'shock', 'WHAT DOES THAT MEAN?'),\n    B('reyes', 'angry', 'IT MEANS *MOVE*, DOCTOR.'),\n  ] },\n  { id: 'ep4', title: 'EP 4: AFTERMATH', set: 'office', music: 'or-calm', beats: [\n    B('narrator', 'neutral', 'THE CHIEF\\'S OFFICE. THE HARBOUR LIGHTS BLINK THROUGH THE GLASS.'),\n    B('bram', 'stern', 'HOW LONG DID THE ROOM GO QUIET, DOCTOR?'),\n    B('ilya', 'panic', 'I... FOUR SECONDS? TEN? IT FELT LIKE A DAY. YOU KNEW.'),\n    B('bram', 'sad', 'I HAD IT ONCE. WE CALL IT THE QUIET. THE FOUNDATION CALLS IT A LIABILITY.'),\n    B('bram', 'stern', 'THE MERCY FOUNDATION HAS COMPLAINED TO THE BOARD. A CONSULTANT ARRIVES.'),\n    B('sabine', 'stern', 'DR. SABINE ACHTERBERG. I AUDIT. YOU HAVE TWO OPTIONS. THE SECOND IS ALSO WRONG.'),\n    B('ilya', 'shock', 'THAT IS... A LOT OF INFORMATION FOR A GREETING.'),\n    B('sabine', 'stern', 'OLLIE BRANDT. SIXTEEN. A BONE THAT BROKE INTO SIX OPINIONS. YOU WILL OPERATE.'),\n    B('sabine', 'neutral', 'I WILL BE ON THE GALLERY INTERCOM. DO NOT ANSWER IT UNTIL YOU ARE READY.'),\n    B('ollie', 'sad', 'I JUST WANT TO PLAY GOALKEEPER AGAIN. IS THAT... A LOT?'),\n  ] },\n  { id: 'ep5', title: 'EP 5: THE SMILING WARD', set: 'ward', music: 'ward', beats: [\n    B('narrator', 'neutral', 'THE WARD IS QUIET. EVERYONE IN IT IS SMILING. IT IS HORRIBLE.'),\n    B('anselm', 'smile', 'DOCTOR! ISN\\'T IT WONDERFUL? I HAVE NOT FELT A THING IN YEARS.'),\n    B('ilya', 'shock', 'MR. ANSELM, YOUR ABDOMEN IS LIKE A BAG OF KNIVES. YOU FEEL *NOTHING*?'),\n    B('anselm', 'smile', 'NOTHING! THE FOUNDATION\\'S PROGRAMME. \"NO ONE SHOULD HURT.\" LOVELY PEOPLE.'),\n    B('reyes', 'stern', 'THERE IS *MERCY* IN THE BLOODSTREAM. I HAVE SEEN IT ONCE BEFORE.'),\n    B('ilya', 'panic', 'MERCY? THAT IS A DRUG? THAT IS... A NAME?'),\n    B('sabine', 'shock', '...MERC-Y. METABOLIC ENDO-RECEPTOR CYTOFORM. TYPE Y.'),\n    B('sabine', 'stern', 'SHOW IT NONE, DOCTOR. GET IT OUT.'),\n    B('narrator', 'neutral', 'SOMETHING UNDER THE LIVER KNOCKS. NOBODY ANSWERS.'),\n  ] },\n  { id: 'ep6', title: 'EP 6: THE FILE', set: 'scrub', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'THE SCRUB ROOM. THE SINKS RUN COLD. SABINE WASHES HER HANDS TWICE.'),\n    B('sabine', 'sad', 'I HAVE SEEN THIS. A RELIEF CAMP, ELEVEN YEARS AGO. NO ONE HURT. EVERYONE DIED.'),\n    B('ilya', 'neutral', 'THE CLOUD. THE FILE THEY HUNG ON YOU.'),\n    B('sabine', 'stern', 'THEY BLAMED THE SURGEON. THE SURGEON WAS ME. THE PATHOGEN WAS *MERCY*.'),\n    B('pem', 'stern', 'MY SISTER ADA NEEDS A KIDNEY. THE DONOR KIDNEY IS FROM THE FOUNDATION\\'S OWN BANK.'),\n    B('reyes', 'stern', 'THEN SOMETHING IS ASLEEP IN IT. SOMEONE HAS TO CUT IT OUT.'),\n    B('sabine', 'stern', 'I WILL TAKE THE NEXT CASE MYSELF. ILYA. PASS ME THE GLOVES.'),\n    B('ilya', 'shock', 'YOU WANT ME TO... WATCH?'),\n    B('sabine', 'neutral', 'I WANT YOU TO LEARN WHY SOMEONE WHO REWINDS HAS NO PATIENCE FOR MISTAKES.'),\n  ] },\n  { id: 'ep7', title: 'EP 7: THE VISIT', set: 'atrium', music: 'ward', beats: [\n    B('narrator', 'neutral', 'THE ATRIUM. WHITE MARBLE, GOLD TRIM, FLOWERS THAT NEVER WILT.'),\n    B('hesper', 'smile', 'DOCTORS. I BRING FLOWERS AND A FUNDING OFFER. NO ONE SHOULD HURT.'),\n    B('bram', 'stern', 'HESPER. THE BOARD WOULD LIKE TO KNOW WHY YOUR SYMBIONT HAS A KNOCK.'),\n    B('hesper', 'smile', 'PAIN IS ONLY THE BODY BEGGING. I SIMPLY TAUGHT IT TO STOP.'),\n    B('sabine', 'stern', 'YOU TAUGHT IT TO STOP *EVERYTHING*.'),\n    B('hesper', 'smile', 'A CHARMING LITTLE HOSPITAL. SUCH A SHAME IF THE FUNDING WENT ELSEWHERE.'),\n    B('reyes', 'sad', '...OTTILIE. OTTILIE MARR. THAT IS HER ON THAT STRETCHER.'),\n    B('ottilie', 'smile', 'ODALYS! I FEEL SO GOOD! WHY IS EVERYONE CRYING?'),\n    B('reyes', 'stern', 'SCRUB IN, DOCTOR. SHE IS MY OLDEST FRIEND. DO NOT MISS.'),\n  ] },\n  { id: 'ep8', title: 'EP 8: THE CONFESSION', set: 'office', music: 'or-calm', beats: [\n    B('narrator', 'neutral', 'THE CHIEF\\'S OFFICE. NIGHT. THE RAIN HAS FOUND A NEW WAY IN.'),\n    B('bram', 'sad', 'I CO-WROTE THE PAPER. MERC-Y\\'S FOUNDING PAPER. I WAS TWENTY-NINE AND A *FOOL*.'),\n    B('ilya', 'shock', 'YOUR HANDS. THE TREMOR. IT IS NOT AGE.'),\n    B('bram', 'sad', 'IT WAS MERCY ALL ALONG. IT FEEDS MY QUIET. IT IS FEEDING ON ME.'),\n    B('sabine', 'angry', 'HESPER\\'S PLAN. TELL HIM.'),\n    B('bram', 'stern', 'AEROSOL MERCY, ON THE HARBOUR FERRIES, AT DAWN. THE WHOLE CITY. SMILING.'),\n    B('bram', 'sad', 'AH. THERE IT GOES.'),\n    B('reyes', 'angry', 'CHIEF! DOCTOR! HE IS GOING DOWN! GET HIM TO THE TABLE!'),\n    B('bram', 'stern', 'DON\\'T YOU DARE BE GENTLE, SON. TAKE THE SCALPEL. IT WAS MINE.'),\n  ] },\n  { id: 'ep9', title: 'EP 9: THE ROOF', set: 'roof', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'THE HELIPAD. NIGHT. RAIN LIKE A WALL. A CANISTER HISSING AT ITS SEAL.'),\n    B('hesper', 'smile', 'YOU CANNOT CURE ME OF BEING RIGHT, DOCTOR.', { cue: 'horn' }),\n    B('ilya', 'angry', 'NO ONE SHOULD HURT. BUT NO ONE SHOULD LIE ABOUT IT, EITHER.'),\n    B('sabine', 'angry', 'THE CANISTER. REYES. *REYES!*'),\n    B('reyes', 'angry', 'GET BACK! SHE IS NOT BREATHING THAT! NOBODY IS BREATHING THAT!'),\n    B('narrator', 'neutral', 'THE CANISTER BREACHES. REYES SHIELDS A PATIENT. SHE TAKES THE FULL DOSE.'),\n    B('reyes', 'sad', 'START WITHOUT ME. DO NOT... DO NOT LOOK AT ME LIKE THAT, DOCTORS.'),\n    B('ilya', 'panic', 'NURSE REYES? NURSE REYES! SABINE, SHE IS FALLING!'),\n    B('sabine', 'stern', 'THEN WE OPERATE. BOTH OF US. NOW. SCRUB IN.'),\n    B('narrator', 'neutral', 'THE COMM STRIP SHOWS ONE WORD. NO SIGNAL.'),\n  ] },\n  { id: 'ep10', title: 'EP 10: THE STRETCHER', set: 'or7', music: 'op10', beats: [\n    B('narrator', 'neutral', 'OR-7. DAWN IS A RUMOUR. A STRETCHER BANGS THROUGH THE DOORS.'),\n    B('hesper', 'sad', 'I TOOK MERCY FIRST. ELEVEN YEARS AGO. I WOULD NEVER ASK OF OTHERS WHAT I WOULD NOT TAKE.'),\n    B('sabine', 'stern', 'SHE IS DYING. THE STRAIN LIES ALONG HER SPINE. IT IS NOT FIGHTING.'),\n    B('bram', 'stern', 'EVERYONE IS LOOKING AT YOU, SON.'),\n    B('ilya', 'panic', 'ME? SHE BUILT THE THING THAT HURT US ALL!'),\n    B('hesper', 'sad', 'I KNOW. DO WHAT YOU LIKE. I HAVE FELT NOTHING FOR ELEVEN YEARS. I AM... TIRED OF IT.'),\n    B('ilya', 'stern', 'NO ONE SHOULD HURT. NOT EVEN YOU.'),\n    B('hesper', 'smile', 'THAT IS MY LINE, DOCTOR.'),\n    B('ilya', 'stern', 'SCRUB IN. IT IS MY SHIFT.'),\n  ] },\n  { id: 'end', title: 'ENDING: MORNING', set: 'roof', music: 'credits', beats: [\n    B('narrator', 'neutral', 'THE ROOF. MORNING. THE RAIN HAS STOPPED. IT HAS NOT DONE THAT SINCE TUESDAY.'),\n    B('ilya', 'smile', 'IT IS... SUNNY. NURSE REYES? IS THAT... IS THAT *THE SUN*?'),\n    B('reyes', 'smile', 'DOCTOR. HOW NICE OF YOU TO NOTICE.'),\n    B('sabine', 'smile', 'THE FOUNDATION IS UNDER INVESTIGATION. THE STRAIN IS IN A JAR. I AM *MILDLY* PLEASED.'),\n    B('bram', 'smile', 'MEDICINE ISN\\'T MIRACLES. IT IS SHOWING UP AGAIN TOMORROW.'),\n    B('pem', 'smile', 'I AM RETIRING TO MY BOAT. THAT WAS A LIE. I AM STAYING. THE BOAT IS A *HOBBY*.'),\n    B('reyes', 'stern', 'YOU HAVE A SEVEN A.M., DOCTOR. IT IS A GALLBLADDER. TRY NOT TO SPILL ANYTHING.'),\n    B('ilya', 'smile', 'I CAN DO THIS. I CAN DO THIS. NURSE REYES... CAN I DO THIS?'),\n    B('reyes', 'smile', '...ADEQUATE.'),\n  ] },\n];\nexport const SCENE_BY_ID = Object.fromEntries(SCENES.map((s) => [s.id, s]));\nEOF\ncat > src/content/cast.js <<'EOF'\n// Cast: busts and figures are built from these descriptions (view/bust.js, view/figure.js).\nexport const CAST = {\n  ilya: { name: 'DR. ILYA MARSH', skin: 0xe8b890, hair: 0x2a1c18, hairStyle: 'messy', cap: 0x5ab0e8, scrub: 0x2a9a98, extra: 'coffee', height: 1.0 },\n  reyes: { name: 'NURSE ODALYS REYES', skin: 0xd8a478, hair: 0x101010, hairStyle: 'bun', cap: null, scrub: 0x1c2a5a, glasses: 0xd02828, brows: 'fierce', height: 0.88 },\n  sabine: { name: 'DR. SABINE ACHTERBERG', skin: 0xf0d0b8, hair: 0xe8e8ee, hairStyle: 'bob', cap: null, scrub: 0x7a3a7a, scar: true, height: 1.02 },\n  bram: { name: 'CHIEF CORNELIUS BRAM', skin: 0xe0b08c, hair: 0xe8e8e8, hairStyle: 'bald', cap: null, scrub: 0xf4f4f4, moustache: 0xe8e8e8, glasses: 0xc8c8d0, height: 1.0 },\n  pem: { name: 'DR. PEMBERTON OKOYE', skin: 0xa0683c, hair: null, hairStyle: 'bald', cap: 0xf08a28, scrub: 0x2a9a98, fish: true, height: 1.0, round: true },\n  hesper: { name: 'DR. HESPER LINDQVIST', skin: 0xf0d8c8, hair: 0xc8ccd4, hairStyle: 'swept', cap: null, scrub: 0xf8f8f8, pin: 0xf5b700, height: 0.98 },\n  tomasz: { name: 'TOMASZ DOLAN', skin: 0xd8a070, hair: 0x4a3020, hairStyle: 'messy', cap: 0x2a4a6a, scrub: 0xa08a50, height: 1.05 },\n  zamboni: { name: 'THE GREAT ZAMBONI', skin: 0xe8c0a0, hair: 0x101010, hairStyle: 'slick', cap: 0x181820, scrub: 0x6a1a8a, moustache: 0x101010, height: 1.0 },\n  ollie: { name: 'OLLIE BRANDT', skin: 0xe8b890, hair: 0x8a5a2a, hairStyle: 'messy', cap: null, scrub: 0x6aa0c8, height: 0.9 },\n  anselm: { name: 'MR. ANSELM', skin: 0xd8b090, hair: 0xc8c8c8, hairStyle: 'bald', cap: 0x2a2a4a, scrub: 0x8a9aa8, moustache: 0xc8c8c8, height: 1.0 },\n  ottilie: { name: 'OTTILIE MARR', skin: 0xe0b098, hair: 0xa07050, hairStyle: 'bob', cap: null, scrub: 0xc86a8a, height: 0.95 },\n  narrator: { name: '', skin: 0, hair: 0, hairStyle: 'none', height: 1 },\n  system: { name: '', skin: 0, hair: 0, hairStyle: 'none', height: 1 },\n};\nexport const EMOTIONS = {\n  neutral: { brow: [0, 0], lid: 1, mouth: [1, 1], tilt: 0 }, stern: { brow: [-0.28, -0.05], lid: 0.8, mouth: [0.9, 0.5], tilt: 0 },\n  shock: { brow: [0.28, 0.08], lid: 1.25, mouth: [0.7, 1.7], tilt: 0.05 }, sad: { brow: [0.25, 0.04], lid: 0.8, mouth: [0.8, 0.6], tilt: -0.1 },\n  smile: { brow: [0.05, 0.02], lid: 0.85, mouth: [1.5, 0.6], tilt: 0.04 }, angry: { brow: [-0.42, -0.08], lid: 0.7, mouth: [1.1, 1.0], tilt: 0 },\n  panic: { brow: [0.34, 0.1], lid: 1.3, mouth: [1.0, 1.5], tilt: 0.08 },\n};\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3830,"cache_read_input_tokens":299978,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3830},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"131ba606-f973-4886-b89a-e1b3ca4f2914","timestamp":"2026-11-05T23:43:37.454Z","request_id":"req_011CgkfgUrq3hBXtd6QPGBFi","wire_tool_inputs":{"toolu_01ABC4Biau1Dhc3HgM1ordg9":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/content/scenes.js <<'EOF'\n// Story scenes are data: { id, set, music, beats:[{ who, emo, say, cue }] }. Each beat is at most 2 lines of 60 characters.\nconst B = (who, emo, say, extra = {}) => ({ who, emo, say, ...extra });\nexport const SCENES = [\n  { id: 'ep1', title: 'EP 1: NIGHT SHIFT', set: 'or7', music: 'title', beats: [\n    B('narrator', 'neutral', 'PORT VERITY. 3 A.M. THE RAIN HAS NOT STOPPED SINCE TUESDAY.', { cue: 'horn' }),\n    B('reyes', 'angry', 'DOCTOR. *DOCTOR.* WAKE UP.', { cue: 'clipboard' }),\n    B('ilya', 'panic', 'I AM AWAKE. I AM DEFINITELY AWAKE. WHERE IS THE CHIEF?'),\n    B('reyes', 'stern', 'UNREACHABLE. THE STORM HAS TAKEN THE PHONES AND HIS PATIENCE.'),\n    B('reyes', 'stern', 'YOU. YES, YOU. THE ONE HOLDING THE COFFEE. YOU ARE ON.'),\n    B('ilya', 'panic', 'ME? I AM A SECOND-YEAR. I SPILL THINGS. I SPILL *COFFEE*.'),\n    B('reyes', 'stern', 'TOMASZ DOLAN. TRAWLER DECKHAND. ELEVEN FISHHOOKS, ONE ARM.'),\n    B('ilya', 'shock', 'ELEVEN?! HOW DO YOU GET ELEVEN FISHHOOKS IN ONE ARM?'),\n    B('tomasz', 'sad', 'IT WAS A LONG NET, DOC. HIS DAUGHTER... MY DAUGHTER... WEDDING SATURDAY.'),\n    B('ilya', 'neutral', 'I CAN DO THIS. I CAN DO THIS. NURSE REYES, CAN I DO THIS?'),\n    B('reyes', 'stern', 'SCALPEL, DOCTOR. THE SHARP END GOES TOWARD THE PATIENT.'),\n    B('reyes', 'stern', 'WE HAVE DISCUSSED THIS. SCRUB IN.'),\n  ] },\n  { id: 'ep2', title: 'EP 2: MORNING ROUNDS', set: 'ward', music: 'ward', beats: [\n    B('narrator', 'neutral', 'MORNING ROUNDS. THE WARD LEAKS IN THREE PLACES. ALL OF THEM ARE BUCKETS.'),\n    B('ilya', 'panic', 'BED FOUR HAS A... NUMBER. BED FIVE HAS ANOTHER NUMBER. I AM FINE.'),\n    B('pem', 'smile', 'PATIENT IS UNDER. SLEEPING LIKE A BABY. A VERY EXPENSIVE BABY.'),\n    B('ilya', 'stern', 'DR. OKOYE, THEY ARE AWAKE. THEY ARE JUST *LOOKING* AT US.'),\n    B('pem', 'smile', 'I RETIRE TO MY BOAT IN SIX WEEKS. I HAVE BEEN SAYING THAT FOR NINE YEARS.'),\n    B('reyes', 'stern', 'DOCTOR. BED SEVEN. THE GREAT ZAMBONI. HE SWALLOWED SOMETHING.'),\n    B('zamboni', 'smile', 'A TRICK, DARLINGS! THE ACT WENT WRONG. WE DO NOT SPEAK OF WHAT.'),\n    B('ilya', 'stern', 'SIR, WHAT DID YOU SWALLOW?'),\n    B('zamboni', 'smile', 'A MAGICIAN NEVER TELLS. ALSO I DO NOT KNOW. IT WAS A LOT.'),\n    B('reyes', 'neutral', 'SCRUB IN, DOCTOR. KEEP THE DOVE OUT OF RECOVERY.'),\n  ] },\n  { id: 'ep3', title: 'EP 3: MASS CASUALTY', set: 'corridor', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'A FERRY HAS HIT THE BREAKWATER. THE CORRIDOR SMELLS OF DIESEL AND SALT.'),\n    B('reyes', 'angry', 'THREE TABLES! ONE DOCTOR! WE ARE SHORT EVERYTHING EXCEPT RAIN!'),\n    B('bram', 'stern', 'MEDICINE ISN\\'T MIRACLES, SON. IT IS SHOWING UP AGAIN TOMORROW.'),\n    B('ilya', 'neutral', 'CHIEF. YOUR HAND. IT IS SHAKING.'),\n    B('bram', 'stern', 'IT IS COLD. TAKE THE CHARTS, DOCTOR. THE LEG, THE DEBRIS, THE CHEST.'),\n    B('ilya', 'panic', 'I CANNOT BE IN THREE PLACES. NURSE REYES, CAN I BE IN THREE PLACES?'),\n    B('reyes', 'stern', 'YOU WILL BE IN ONE PLACE AT A TIME. QUICKLY. SWITCH WITH THE TABLE KEYS.'),\n    B('bram', 'sad', 'AND SON... IF THE ROOM GOES QUIET. DO NOT BE AFRAID OF IT.'),\n    B('ilya', 'shock', 'WHAT DOES THAT MEAN?'),\n    B('reyes', 'angry', 'IT MEANS *MOVE*, DOCTOR.'),\n  ] },\n  { id: 'ep4', title: 'EP 4: AFTERMATH', set: 'office', music: 'or-calm', beats: [\n    B('narrator', 'neutral', 'THE CHIEF\\'S OFFICE. THE HARBOUR LIGHTS BLINK THROUGH THE GLASS.'),\n    B('bram', 'stern', 'HOW LONG DID THE ROOM GO QUIET, DOCTOR?'),\n    B('ilya', 'panic', 'I... FOUR SECONDS? TEN? IT FELT LIKE A DAY. YOU KNEW.'),\n    B('bram', 'sad', 'I HAD IT ONCE. WE CALL IT THE QUIET. THE FOUNDATION CALLS IT A LIABILITY.'),\n    B('bram', 'stern', 'THE MERCY FOUNDATION HAS COMPLAINED TO THE BOARD. A CONSULTANT ARRIVES.'),\n    B('sabine', 'stern', 'DR. SABINE ACHTERBERG. I AUDIT. YOU HAVE TWO OPTIONS. THE SECOND IS ALSO WRONG.'),\n    B('ilya', 'shock', 'THAT IS... A LOT OF INFORMATION FOR A GREETING.'),\n    B('sabine', 'stern', 'OLLIE BRANDT. SIXTEEN. A BONE THAT BROKE INTO SIX OPINIONS. YOU WILL OPERATE.'),\n    B('sabine', 'neutral', 'I WILL BE ON THE GALLERY INTERCOM. DO NOT ANSWER IT UNTIL YOU ARE READY.'),\n    B('ollie', 'sad', 'I JUST WANT TO PLAY GOALKEEPER AGAIN. IS THAT... A LOT?'),\n  ] },\n  { id: 'ep5', title: 'EP 5: THE SMILING WARD', set: 'ward', music: 'ward', beats: [\n    B('narrator', 'neutral', 'THE WARD IS QUIET. EVERYONE IN IT IS SMILING. IT IS HORRIBLE.'),\n    B('anselm', 'smile', 'DOCTOR! ISN\\'T IT WONDERFUL? I HAVE NOT FELT A THING IN YEARS.'),\n    B('ilya', 'shock', 'MR. ANSELM, YOUR ABDOMEN IS LIKE A BAG OF KNIVES. YOU FEEL *NOTHING*?'),\n    B('anselm', 'smile', 'NOTHING! THE FOUNDATION\\'S PROGRAMME. \"NO ONE SHOULD HURT.\" LOVELY PEOPLE.'),\n    B('reyes', 'stern', 'THERE IS *MERCY* IN THE BLOODSTREAM. I HAVE SEEN IT ONCE BEFORE.'),\n    B('ilya', 'panic', 'MERCY? THAT IS A DRUG? THAT IS... A NAME?'),\n    B('sabine', 'shock', '...MERC-Y. METABOLIC ENDO-RECEPTOR CYTOFORM. TYPE Y.'),\n    B('sabine', 'stern', 'SHOW IT NONE, DOCTOR. GET IT OUT.'),\n    B('narrator', 'neutral', 'SOMETHING UNDER THE LIVER KNOCKS. NOBODY ANSWERS.'),\n  ] },\n  { id: 'ep6', title: 'EP 6: THE FILE', set: 'scrub', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'THE SCRUB ROOM. THE SINKS RUN COLD. SABINE WASHES HER HANDS TWICE.'),\n    B('sabine', 'sad', 'I HAVE SEEN THIS. A RELIEF CAMP, ELEVEN YEARS AGO. NO ONE HURT. EVERYONE DIED.'),\n    B('ilya', 'neutral', 'THE CLOUD. THE FILE THEY HUNG ON YOU.'),\n    B('sabine', 'stern', 'THEY BLAMED THE SURGEON. THE SURGEON WAS ME. THE PATHOGEN WAS *MERCY*.'),\n    B('pem', 'stern', 'MY SISTER ADA NEEDS A KIDNEY. THE DONOR KIDNEY IS FROM THE FOUNDATION\\'S OWN BANK.'),\n    B('reyes', 'stern', 'THEN SOMETHING IS ASLEEP IN IT. SOMEONE HAS TO CUT IT OUT.'),\n    B('sabine', 'stern', 'I WILL TAKE THE NEXT CASE MYSELF. ILYA. PASS ME THE GLOVES.'),\n    B('ilya', 'shock', 'YOU WANT ME TO... WATCH?'),\n    B('sabine', 'neutral', 'I WANT YOU TO LEARN WHY SOMEONE WHO REWINDS HAS NO PATIENCE FOR MISTAKES.'),\n  ] },\n  { id: 'ep7', title: 'EP 7: THE VISIT', set: 'atrium', music: 'ward', beats: [\n    B('narrator', 'neutral', 'THE ATRIUM. WHITE MARBLE, GOLD TRIM, FLOWERS THAT NEVER WILT.'),\n    B('hesper', 'smile', 'DOCTORS. I BRING FLOWERS AND A FUNDING OFFER. NO ONE SHOULD HURT.'),\n    B('bram', 'stern', 'HESPER. THE BOARD WOULD LIKE TO KNOW WHY YOUR SYMBIONT HAS A KNOCK.'),\n    B('hesper', 'smile', 'PAIN IS ONLY THE BODY BEGGING. I SIMPLY TAUGHT IT TO STOP.'),\n    B('sabine', 'stern', 'YOU TAUGHT IT TO STOP *EVERYTHING*.'),\n    B('hesper', 'smile', 'A CHARMING LITTLE HOSPITAL. SUCH A SHAME IF THE FUNDING WENT ELSEWHERE.'),\n    B('reyes', 'sad', '...OTTILIE. OTTILIE MARR. THAT IS HER ON THAT STRETCHER.'),\n    B('ottilie', 'smile', 'ODALYS! I FEEL SO GOOD! WHY IS EVERYONE CRYING?'),\n    B('reyes', 'stern', 'SCRUB IN, DOCTOR. SHE IS MY OLDEST FRIEND. DO NOT MISS.'),\n  ] },\n  { id: 'ep8', title: 'EP 8: THE CONFESSION', set: 'office', music: 'or-calm', beats: [\n    B('narrator', 'neutral', 'THE CHIEF\\'S OFFICE. NIGHT. THE RAIN HAS FOUND A NEW WAY IN.'),\n    B('bram', 'sad', 'I CO-WROTE THE PAPER. MERC-Y\\'S FOUNDING PAPER. I WAS TWENTY-NINE AND A *FOOL*.'),\n    B('ilya', 'shock', 'YOUR HANDS. THE TREMOR. IT IS NOT AGE.'),\n    B('bram', 'sad', 'IT WAS MERCY ALL ALONG. IT FEEDS MY QUIET. IT IS FEEDING ON ME.'),\n    B('sabine', 'angry', 'HESPER\\'S PLAN. TELL HIM.'),\n    B('bram', 'stern', 'AEROSOL MERCY, ON THE HARBOUR FERRIES, AT DAWN. THE WHOLE CITY. SMILING.'),\n    B('bram', 'sad', 'AH. THERE IT GOES.'),\n    B('reyes', 'angry', 'CHIEF! DOCTOR! HE IS GOING DOWN! GET HIM TO THE TABLE!'),\n    B('bram', 'stern', 'DON\\'T YOU DARE BE GENTLE, SON. TAKE THE SCALPEL. IT WAS MINE.'),\n  ] },\n  { id: 'ep9', title: 'EP 9: THE ROOF', set: 'roof', music: 'or-tense', beats: [\n    B('narrator', 'neutral', 'THE HELIPAD. NIGHT. RAIN LIKE A WALL. A CANISTER HISSING AT ITS SEAL.'),\n    B('hesper', 'smile', 'YOU CANNOT CURE ME OF BEING RIGHT, DOCTOR.', { cue: 'horn' }),\n    B('ilya', 'angry', 'NO ONE SHOULD HURT. BUT NO ONE SHOULD LIE ABOUT IT, EITHER.'),\n    B('sabine', 'angry', 'THE CANISTER. REYES. *REYES!*'),\n    B('reyes', 'angry', 'GET BACK! SHE IS NOT BREATHING THAT! NOBODY IS BREATHING THAT!'),\n    B('narrator', 'neutral', 'THE CANISTER BREACHES. REYES SHIELDS A PATIENT. SHE TAKES THE FULL DOSE.'),\n    B('reyes', 'sad', 'START WITHOUT ME. DO NOT... DO NOT LOOK AT ME LIKE THAT, DOCTORS.'),\n    B('ilya', 'panic', 'NURSE REYES? NURSE REYES! SABINE, SHE IS FALLING!'),\n    B('sabine', 'stern', 'THEN WE OPERATE. BOTH OF US. NOW. SCRUB IN.'),\n    B('narrator', 'neutral', 'THE COMM STRIP SHOWS ONE WORD. NO SIGNAL.'),\n  ] },\n  { id: 'ep10', title: 'EP 10: THE STRETCHER', set: 'or7', music: 'op10', beats: [\n    B('narrator', 'neutral', 'OR-7. DAWN IS A RUMOUR. A STRETCHER BANGS THROUGH THE DOORS.'),\n    B('hesper', 'sad', 'I TOOK MERCY FIRST. ELEVEN YEARS AGO. I WOULD NEVER ASK OF OTHERS WHAT I WOULD NOT TAKE.'),\n    B('sabine', 'stern', 'SHE IS DYING. THE STRAIN LIES ALONG HER SPINE. IT IS NOT FIGHTING.'),\n    B('bram', 'stern', 'EVERYONE IS LOOKING AT YOU, SON.'),\n    B('ilya', 'panic', 'ME? SHE BUILT THE THING THAT HURT US ALL!'),\n    B('hesper', 'sad', 'I KNOW. DO WHAT YOU LIKE. I HAVE FELT NOTHING FOR ELEVEN YEARS. I AM... TIRED OF IT.'),\n    B('ilya', 'stern', 'NO ONE SHOULD HURT. NOT EVEN YOU.'),\n    B('hesper', 'smile', 'THAT IS MY LINE, DOCTOR.'),\n    B('ilya', 'stern', 'SCRUB IN. IT IS MY SHIFT.'),\n  ] },\n  { id: 'end', title: 'ENDING: MORNING', set: 'roof', music: 'credits', beats: [\n    B('narrator', 'neutral', 'THE ROOF. MORNING. THE RAIN HAS STOPPED. IT HAS NOT DONE THAT SINCE TUESDAY.'),\n    B('ilya', 'smile', 'IT IS... SUNNY. NURSE REYES? IS THAT... IS THAT *THE SUN*?'),\n    B('reyes', 'smile', 'DOCTOR. HOW NICE OF YOU TO NOTICE.'),\n    B('sabine', 'smile', 'THE FOUNDATION IS UNDER INVESTIGATION. THE STRAIN IS IN A JAR. I AM *MILDLY* PLEASED.'),\n    B('bram', 'smile', 'MEDICINE ISN\\'T MIRACLES. IT IS SHOWING UP AGAIN TOMORROW.'),\n    B('pem', 'smile', 'I AM RETIRING TO MY BOAT. THAT WAS A LIE. I AM STAYING. THE BOAT IS A *HOBBY*.'),\n    B('reyes', 'stern', 'YOU HAVE A SEVEN A.M., DOCTOR. IT IS A GALLBLADDER. TRY NOT TO SPILL ANYTHING.'),\n    B('ilya', 'smile', 'I CAN DO THIS. I CAN DO THIS. NURSE REYES... CAN I DO THIS?'),\n    B('reyes', 'smile', '...ADEQUATE.'),\n  ] },\n];\nexport const SCENE_BY_ID = Object.fromEntries(SCENES.map((s) => [s.id, s]));\nEOF\ncat > src/content/cast.js <<'EOF'\n// Cast: busts and figures are built from these descriptions (view/bust.js, view/figure.js).\nexport const CAST = {\n  ilya: { name: 'DR. ILYA MARSH', skin: 0xe8b890, hair: 0x2a1c18, hairStyle: 'messy', cap: 0x5ab0e8, scrub: 0x2a9a98, extra: 'coffee', height: 1.0 },\n  reyes: { name: 'NURSE ODALYS REYES', skin: 0xd8a478, hair: 0x101010, hairStyle: 'bun', cap: null, scrub: 0x1c2a5a, glasses: 0xd02828, brows: 'fierce', height: 0.88 },\n  sabine: { name: 'DR. SABINE ACHTERBERG', skin: 0xf0d0b8, hair: 0xe8e8ee, hairStyle: 'bob', cap: null, scrub: 0x7a3a7a, scar: true, height: 1.02 },\n  bram: { name: 'CHIEF CORNELIUS BRAM', skin: 0xe0b08c, hair: 0xe8e8e8, hairStyle: 'bald', cap: null, scrub: 0xf4f4f4, moustache: 0xe8e8e8, glasses: 0xc8c8d0, height: 1.0 },\n  pem: { name: 'DR. PEMBERTON OKOYE', skin: 0xa0683c, hair: null, hairStyle: 'bald', cap: 0xf08a28, scrub: 0x2a9a98, fish: true, height: 1.0, round: true },\n  hesper: { name: 'DR. HESPER LINDQVIST', skin: 0xf0d8c8, hair: 0xc8ccd4, hairStyle: 'swept', cap: null, scrub: 0xf8f8f8, pin: 0xf5b700, height: 0.98 },\n  tomasz: { name: 'TOMASZ DOLAN', skin: 0xd8a070, hair: 0x4a3020, hairStyle: 'messy', cap: 0x2a4a6a, scrub: 0xa08a50, height: 1.05 },\n  zamboni: { name: 'THE GREAT ZAMBONI', skin: 0xe8c0a0, hair: 0x101010, hairStyle: 'slick', cap: 0x181820, scrub: 0x6a1a8a, moustache: 0x101010, height: 1.0 },\n  ollie: { name: 'OLLIE BRANDT', skin: 0xe8b890, hair: 0x8a5a2a, hairStyle: 'messy', cap: null, scrub: 0x6aa0c8, height: 0.9 },\n  anselm: { name: 'MR. ANSELM', skin: 0xd8b090, hair: 0xc8c8c8, hairStyle: 'bald', cap: 0x2a2a4a, scrub: 0x8a9aa8, moustache: 0xc8c8c8, height: 1.0 },\n  ottilie: { name: 'OTTILIE MARR', skin: 0xe0b098, hair: 0xa07050, hairStyle: 'bob', cap: null, scrub: 0xc86a8a, height: 0.95 },\n  narrator: { name: '', skin: 0, hair: 0, hairStyle: 'none', height: 1 },\n  system: { name: '', skin: 0, hair: 0, hairStyle: 'none', height: 1 },\n};\nexport const EMOTIONS = {\n  neutral: { brow: [0, 0], lid: 1, mouth: [1, 1], tilt: 0 }, stern: { brow: [-0.28, -0.05], lid: 0.8, mouth: [0.9, 0.5], tilt: 0 },\n  shock: { brow: [0.28, 0.08], lid: 1.25, mouth: [0.7, 1.7], tilt: 0.05 }, sad: { brow: [0.25, 0.04], lid: 0.8, mouth: [0.8, 0.6], tilt: -0.1 },\n  smile: { brow: [0.05, 0.02], lid: 0.85, mouth: [1.5, 0.6], tilt: 0.04 }, angry: { brow: [-0.42, -0.08], lid: 0.7, mouth: [1.1, 1.0], tilt: 0 },\n  panic: { brow: [0.34, 0.1], lid: 1.3, mouth: [1.0, 1.5], tilt: 0.08 },\n};\nEOF\necho ok"}}}
