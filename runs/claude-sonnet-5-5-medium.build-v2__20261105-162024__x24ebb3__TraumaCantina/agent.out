{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgkgge3LWDck2sR1QKdfC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WkmDY4XeA7S7yHBxRdJ7gF","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && python3 - <<'EOF'\nimport re\np='tests/sim.test.mjs'\ns=open(p).read()\ns=s.replace(\"export async function run_(T) { }\\n\",\"\")\ns=s.replace(\"export async function run(T) {\",\"export async function SUITE_(T) {\")\ns=re.sub(r\"\\brun\\(\", \"st(\", s)\ns=s.replace(\"const run = (sim, n, inp)\",\"const st = (sim, n, inp)\").replace(\"const st = (sim, n, inp) =>\",\"const st = (sim, n, inp) =>\")\ns=s.replace(\"export async function SUITE_(T) {\",\"export async function run(T) {\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"^const st\\|export async\" tests/sim.test.mjs; cat > tests/content.test.mjs <<'EOF'\nimport { LINES, POOLS } from '../src/content/lines.js';\nimport { SCENES } from '../src/content/scenes.js';\nimport { CAST } from '../src/content/cast.js';\nimport { BY_ID, OPS } from '../src/content/ops/index.js';\nimport { ABOUT } from '../src/content/about.js';\nimport { SONGS } from '../src/content/songs.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { CAST_VOICES } from '../src/audio/voice.js';\nimport { ARENAS } from '../src/content/arenas.js';\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { resolve, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst FONT = /^[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]*$/;\nconst TOK = new Set(['use', 'tool', 'gift', 'steady', 'confirm', 'back', 'table', 'extra', 'paddles', 'rotate', 'move', 'skip', 'last', 'pause', 'quick']);\nconst clean = (s) => s.replace(/—|–/g, '-').toUpperCase();\nfunction wrapN(text, widthPx) { const words = text.replace(/\\{(\\w+)\\}/g, 'XXXX').replace(/\\*/g, '').split(' '); let lines = 1, cur = 0; for (const w of words) { const wpx = w.length * 6; if (cur && cur + 6 + wpx > widthPx) { lines++; cur = wpx; } else cur += (cur ? 6 : 0) + wpx; } return lines; }\nexport async function run(T) {\n  const files = []; const walk = (d) => { for (const f of readdirSync(d)) { if (['node_modules', 'dist', 'check', 'vendor', 'examples', 'types', 'tests', 'docs', 'packs'].includes(f)) continue; const p = d + '/' + f; if (statSync(p).isDirectory()) walk(p); else if (/\\.(js|mjs)$/.test(f) && f !== 'pixel-engine.js' && f !== 'check.mjs') files.push(p); } }; walk(ROOT);\n  const src = files.map((f) => [f, readFileSync(f, 'utf8')]);\n  // No TODO / placeholders, no forbidden names\n  const FORBID = ['derek stiles', 'angie thompson', 'naomi kimishima', 'nozomi weaver', 'hope hospital', 'caduceus', 'delphi', 'guilt', 'kyriaki', 'healing touch', 'stigma', 'rosalia', 'tuberculosis'];\n  for (const [f, t] of src) { T.ok(!/\\bTODO\\b|\\bFIXME\\b|PLACEHOLDER|lorem ipsum/i.test(t), `${f}: no TODO/placeholder`); const low = t.toLowerCase(); for (const n of FORBID) T.ok(!low.includes(n), `${f}: forbidden name \"${n}\"`); }\n  // Comm lines: fit 2 wrapped lines at 480 wide (344 px of text), 3 at 342 wide (200 px)\n  for (const [k, l] of Object.entries(LINES)) { const text = clean(l.text.join(' ')); T.ok(FONT.test(text), `line ${k}: font characters (${text.replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')})`); T.ok(wrapN(text, 344) <= 2, `line ${k}: fits 2 lines at 480 wide`); T.ok(wrapN(text, 200) <= 3, `line ${k}: fits 3 lines at 342 wide`); for (const t of text.match(/\\{(\\w+)\\}/g) || []) T.ok(TOK.has(t.slice(1, -1)), `line ${k}: valid glyph token ${t}`); T.ok(CAST[l.who] || l.who === 'system', `line ${k}: speaker exists`); }\n  for (const [k, p] of Object.entries(POOLS)) for (const t of p) T.ok(FONT.test(clean(t)) && wrapN(clean(t), 344) <= 2, `pool ${k}: ${t.slice(0, 20)} fits`);\n  // Story scenes\n  const SETS = ['or7', 'ward', 'corridor', 'office', 'scrub', 'atrium', 'roof'];\n  for (const sc of SCENES) { T.ok(SETS.includes(sc.set), `scene ${sc.id}: set exists`); T.ok(sc.beats.length >= 8 && sc.beats.length <= 16, `scene ${sc.id}: 8 to 16 beats (${sc.beats.length})`); T.ok(!!SONGS[sc.music], `scene ${sc.id}: music exists`); for (const b of sc.beats) { const t = clean(b.say); T.ok(CAST[b.who] && CAST_VOICES[b.who], `scene ${sc.id}: ${b.who} in cast`); T.ok(FONT.test(t), `scene ${sc.id}: font chars in \"${b.say.slice(0, 24)}\" -> ${t.replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')}`); T.ok(wrapN(t, 440) <= 3, `scene ${sc.id}: beat fits 3 lines \"${b.say.slice(0, 20)}\"`); T.ok(t.length <= 140, `scene ${sc.id}: beat length ${t.length}`); } }\n  // Ops\n  const TOOLS = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'];\n  const KIND_TOOL = { pool: 'drain', hook: 'forceps', drag: 'forceps', cut: 'scalpel', lac: 'suture', mask: 'gel', polyp: 'laser', egg: 'laser', cyst: 'laser' };\n  const seenKinds = new Set();\n  for (const d of Object.values(BY_ID)) {\n    T.ok(!!ARENAS[d.arena], `${d.id}: arena exists`); T.ok(!!SONGS[d.music], `${d.id}: music exists`); T.ok(d.tools.every((t) => TOOLS.includes(t)), `${d.id}: tools valid`);\n    T.ok(!d.scene || SCENES.some((s) => s.id === d.scene), `${d.id}: scene exists`); T.ok(d.patient.name && d.patient.hook && d.patient.followUp.S && d.patient.followUp.C, `${d.id}: patient chart + follow-ups`);\n    for (const r of ['S', 'A', 'B', 'C']) { const f = d.patient.followUp[r]; if (f) T.ok(FONT.test(clean(f)), `${d.id}: follow-up ${r} font chars`); }\n    T.ok(FONT.test(clean(d.patient.hook)) && FONT.test(clean(d.patient.job)) && FONT.test(clean(d.title)), `${d.id}: chart text font chars`);\n    const used = new Set(d.unlockedTools || d.tools);\n    const sweep = (o) => { if (!o || typeof o !== 'object') return; if (Array.isArray(o)) return o.forEach(sweep); if (o.k) seenKinds.add(o.k); if (o.say) T.ok(!!LINES[o.say], `${d.id}: say key ${o.say} exists`); if (o.unlock) T.ok(TOOLS.includes(o.unlock), `${d.id}: unlock ${o.unlock}`); if (o.at && o.k !== 'strain') { const [x, z] = o.at; T.ok(Math.abs(x) <= 7 && z >= -3.8 && z <= 3.2, `${d.id}: ${o.id || o.k} at (${x},${z}) is inside the playable area`); if (o.k === 'hook' && o.pull) { const ex = x + Math.cos(o.a || 0) * o.pull, ez = z + Math.sin(o.a || 0) * o.pull; T.ok(Math.abs(ex) <= 7 && ez >= -3.8 && ez <= 3.2, `${d.id}: hook ${o.id} path ends inside the area (${ex.toFixed(1)},${ez.toFixed(1)})`); } } for (const v of Object.values(o)) sweep(v); };\n    sweep(d.stages); sweep(d.timeline);\n    for (const [i, s] of d.stages.entries()) { T.ok(s.id, `${d.id}: stage ${i} has an id`); if (s.hint) T.ok([...TOOLS, 'move', 'dress', 'tables', 'paddles'].includes(s.hint), `${d.id}: hint ${s.hint}`); }\n    const sp = JSON.stringify(d); T.ok(sp.length > 100, `${d.id}: is data`); try { JSON.parse(sp); T.ok(true, ''); } catch { T.ok(false, `${d.id}: JSON-safe`); }\n  }\n  for (const k of ['pool', 'hook', 'cut', 'lac', 'mask', 'polyp', 'egg', 'cyst', 'strain', 'dress', 'drag', 'marker']) T.ok(seenKinds.has(k), `entity kind ${k} used by content`);\n  // About has every field\n  T.ok(ABOUT.source.length === 15 - 0 || ABOUT.source.length >= 14, `about: source fields (${ABOUT.source.length})`);\n  for (const [k, v] of ABOUT.source) T.ok(k && v && v !== 'unknown' || k === 'RESEARCH', `about: ${k} filled`);\n  T.ok(ABOUT.testing.length === 4 && ABOUT.engine.length === 6 && ABOUT.prompt.length === 4, `about: feedback questions (${ABOUT.testing.length}/${ABOUT.engine.length}/${ABOUT.prompt.length})`);\n  for (const arr of [ABOUT.testing, ABOUT.engine, ABOUT.prompt]) for (const [q, a] of arr) T.ok(q && a && FONT.test(clean(a)), `about: answer font chars \"${q.slice(0, 20)}\" ${clean(a).replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')}`);\n  for (const l of ABOUT.credits) T.ok(FONT.test(clean(l)), `credits font: ${l.slice(0, 20)}`);\n  // Engine kit untouched, session client verbatim\n  T.ok(readFileSync(ROOT + '/vendor/session.js', 'utf8').length > 10000, 'session client present');\n  const html = readFileSync(ROOT + '/dist/game.html', 'utf8'); T.ok(html.includes(readFileSync(ROOT + '/vendor/session.js', 'utf8')), 'built page contains the session client verbatim');\n  for (const t of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:webgpu', 'hub:session-goal', 'hub:session-howto']) T.ok(html.includes(`name=\"${t}\"`), `head tag ${t}`);\n  T.ok(html.indexOf('<meta charset') < html.indexOf('AIHub') , 'session client right after meta charset');\n}\nEOF\ncat > tests/audio.test.mjs <<'EOF'\nimport { renderSyllable, toWav, b64, syllableFor, CAST_VOICES } from '../src/audio/voice.js';\nimport { renderSound } from '../pixel-engine.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { SONGS } from '../src/content/songs.js';\nexport async function run(T) {\n  for (let t = 0; t < 3; t++) for (let v = 0; v < 5; v++) for (let o = 0; o < 3; o++) { const a = renderSyllable(t, v, o); let m = 0, bad = 0; for (const x of a) { if (!Number.isFinite(x)) bad++; m = Math.max(m, Math.abs(x)); } T.ok(!bad && m > 0.05 && m <= 1, `syllable ${t}${v}${o} non-silent and finite`); }\n  const w = toWav(renderSyllable(0, 0, 0)); T.ok(String.fromCharCode(...w.slice(0, 4)) === 'RIFF' && b64(w).length > 100, 'WAV header + base64');\n  for (const [k, d] of Object.entries(SFX_DEFS)) { const a = renderSound(d); let m = 0, bad = 0; for (const x of a) { if (!Number.isFinite(x)) bad++; m = Math.max(m, Math.abs(x)); } T.ok(!bad && m > 0.01, `sfx ${k} non-silent and finite`); }\n  T.eq(syllableFor('HELLO', 1, CAST_VOICES.reyes), syllableFor('HELLO', 1, CAST_VOICES.reyes), 'letters pick syllables deterministically');\n  T.ok(syllableFor('WHAT?', 0, CAST_VOICES.ilya).pitch > syllableFor('WHAT', 0, CAST_VOICES.ilya).pitch, '? raises pitch');\n  for (const [k, s] of Object.entries(SONGS)) { T.ok(s.bpm > 40 && s.order.length >= 4, `song ${k} has bars`); for (const p of Object.values(s.patterns)) { const n = Object.values(p).map((x) => x.split(' ').length); T.ok(new Set(n).size === 1, `song ${k}: equal track lengths`); } }\n  T.ok(['title', 'ward', 'or-calm', 'or-tense', 'or-critical', 'boss-introit', 'boss-lacrimosa', 'boss-wrath', 'boss-miserere', 'op10', 'results', 'results-sad', 'credits'].every((k) => SONGS[k]), 'every planned song exists');\n}\nEOF\ncat > tests/net.test.mjs <<'EOF'\nimport { createOp, step, drainEvents } from '../src/sim/op.js';\nimport { newBot, botInput } from '../src/sim/bot.js';\nimport { BY_ID, SESSION_ROUNDS } from '../src/content/ops/index.js';\nimport { encodeKey, decodeKey, encodeSnap, applySnap, jsonSize } from '../src/net/codec.js';\nimport { resetConfig } from '../src/core/config.js';\nexport async function run(T) {\n  for (const def of [...SESSION_ROUNDS, BY_ID.op9, BY_ID.op3]) {\n    resetConfig(); const seats = [0, 1, 2, 3].map((i) => ({ id: i, doctor: i % 2 ? 'sabine' : 'ilya' })); const sim = createOp(def, { seed: 2, seats, quietOn: true, humans: 4 });\n    const bots = seats.map(() => newBot(0.8)); let maxK = 0, maxS = 0, last = new Map();\n    for (let i = 0; i < 60 * 70 && !sim.over; i++) { const inp = {}; sim.seats.forEach((s, k) => (inp[s.id] = botInput(sim, s, bots[k]))); step(sim, inp); drainEvents(sim); if (i % 30 === 0) { maxK = Math.max(maxK, jsonSize(encodeKey(sim, []))); maxS = Math.max(maxS, jsonSize(encodeSnap(sim, i, last))); } }\n    T.ok(maxK <= 16000, `${def.id}: keyframe <= 16 KB (${maxK})`); T.ok(maxS <= 1100, `${def.id}: snapshot <= 1,100 bytes (${maxS})`);\n    const k = JSON.parse(JSON.stringify(encodeKey(sim, []))); const sim2 = createOp(def, { seed: 2, seats, quietOn: true, humans: 4 }); decodeKey(k, sim2);\n    T.ok(sim2.ents.length === sim.ents.length && Math.abs(sim2.t - sim.t) < 0.02 && sim2.stage === sim.stage, `${def.id}: keyframe round trip`);\n    const sn = JSON.parse(JSON.stringify(encodeSnap(sim, 1, new Map()))); applySnap(sim2, sn); T.ok(Math.abs(sim2.tables[0].vitals - sim.tables[0].vitals) <= 1, `${def.id}: snapshot round trip`);\n  }\n}\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6421,"cache_read_input_tokens":422632,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6421},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"059c8294-6b67-4097-9cbb-69967baebc21","timestamp":"2026-11-05T23:56:26.742Z","request_id":"req_011CgkggdiVJFtX63MN2onBk","wire_tool_inputs":{"toolu_01WkmDY4XeA7S7yHBxRdJ7gF":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && python3 - <<'EOF'\nimport re\np='tests/sim.test.mjs'\ns=open(p).read()\ns=s.replace(\"export async function run_(T) { }\\n\",\"\")\ns=s.replace(\"export async function run(T) {\",\"export async function SUITE_(T) {\")\ns=re.sub(r\"\\brun\\(\", \"st(\", s)\ns=s.replace(\"const run = (sim, n, inp)\",\"const st = (sim, n, inp)\").replace(\"const st = (sim, n, inp) =>\",\"const st = (sim, n, inp) =>\")\ns=s.replace(\"export async function SUITE_(T) {\",\"export async function run(T) {\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"^const st\\|export async\" tests/sim.test.mjs; cat > tests/content.test.mjs <<'EOF'\nimport { LINES, POOLS } from '../src/content/lines.js';\nimport { SCENES } from '../src/content/scenes.js';\nimport { CAST } from '../src/content/cast.js';\nimport { BY_ID, OPS } from '../src/content/ops/index.js';\nimport { ABOUT } from '../src/content/about.js';\nimport { SONGS } from '../src/content/songs.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { CAST_VOICES } from '../src/audio/voice.js';\nimport { ARENAS } from '../src/content/arenas.js';\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { resolve, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst FONT = /^[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]*$/;\nconst TOK = new Set(['use', 'tool', 'gift', 'steady', 'confirm', 'back', 'table', 'extra', 'paddles', 'rotate', 'move', 'skip', 'last', 'pause', 'quick']);\nconst clean = (s) => s.replace(/\\u2014|\\u2013/g, '-').toUpperCase();\nfunction wrapN(text, widthPx) { const words = text.replace(/\\{(\\w+)\\}/g, 'XXXX').replace(/\\*/g, '').split(' '); let lines = 1, cur = 0; for (const w of words) { const wpx = w.length * 6; if (cur && cur + 6 + wpx > widthPx) { lines++; cur = wpx; } else cur += (cur ? 6 : 0) + wpx; } return lines; }\nexport async function run(T) {\n  const files = []; const walk = (d) => { for (const f of readdirSync(d)) { if (['node_modules', 'dist', 'check', 'vendor', 'examples', 'types', 'tests', 'docs', 'packs'].includes(f)) continue; const p = d + '/' + f; if (statSync(p).isDirectory()) walk(p); else if (/\\.(js|mjs)$/.test(f) && f !== 'pixel-engine.js' && f !== 'check.mjs') files.push(p); } }; walk(ROOT);\n  const src = files.map((f) => [f, readFileSync(f, 'utf8')]);\n  // No TODO / placeholders, no forbidden names\n  const FORBID = ['derek stiles', 'angie thompson', 'naomi kimishima', 'nozomi weaver', 'hope hospital', 'caduceus', 'delphi', 'guilt', 'kyriaki', 'healing touch', 'stigma', 'rosalia', 'tuberculosis'];\n  for (const [f, t] of src) { T.ok(!/\\bTODO\\b|\\bFIXME\\b|PLACEHOLDER|lorem ipsum/i.test(t), `${f}: no TODO/placeholder`); const low = t.toLowerCase(); for (const n of FORBID) T.ok(!low.includes(n), `${f}: forbidden name \"${n}\"`); }\n  // Comm lines: fit 2 wrapped lines at 480 wide (344 px of text), 3 at 342 wide (200 px)\n  for (const [k, l] of Object.entries(LINES)) { const text = clean(l.text.join(' ')); T.ok(FONT.test(text), `line ${k}: font characters (${text.replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')})`); T.ok(wrapN(text, 344) <= 2, `line ${k}: fits 2 lines at 480 wide`); T.ok(wrapN(text, 200) <= 3, `line ${k}: fits 3 lines at 342 wide`); for (const t of text.match(/\\{(\\w+)\\}/g) || []) T.ok(TOK.has(t.slice(1, -1)), `line ${k}: valid glyph token ${t}`); T.ok(CAST[l.who] || l.who === 'system', `line ${k}: speaker exists`); }\n  for (const [k, p] of Object.entries(POOLS)) for (const t of p) T.ok(FONT.test(clean(t)) && wrapN(clean(t), 344) <= 2, `pool ${k}: ${t.slice(0, 20)} fits`);\n  // Story scenes\n  const SETS = ['or7', 'ward', 'corridor', 'office', 'scrub', 'atrium', 'roof'];\n  for (const sc of SCENES) { T.ok(SETS.includes(sc.set), `scene ${sc.id}: set exists`); T.ok(sc.beats.length >= 8 && sc.beats.length <= 16, `scene ${sc.id}: 8 to 16 beats (${sc.beats.length})`); T.ok(!!SONGS[sc.music], `scene ${sc.id}: music exists`); for (const b of sc.beats) { const t = clean(b.say); T.ok(CAST[b.who] && CAST_VOICES[b.who], `scene ${sc.id}: ${b.who} in cast`); T.ok(FONT.test(t), `scene ${sc.id}: font chars in \"${b.say.slice(0, 24)}\" -> ${t.replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')}`); T.ok(wrapN(t, 440) <= 3, `scene ${sc.id}: beat fits 3 lines \"${b.say.slice(0, 20)}\"`); T.ok(t.length <= 140, `scene ${sc.id}: beat length ${t.length}`); } }\n  // Ops\n  const TOOLS = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'];\n  const KIND_TOOL = { pool: 'drain', hook: 'forceps', drag: 'forceps', cut: 'scalpel', lac: 'suture', mask: 'gel', polyp: 'laser', egg: 'laser', cyst: 'laser' };\n  const seenKinds = new Set();\n  for (const d of Object.values(BY_ID)) {\n    T.ok(!!ARENAS[d.arena], `${d.id}: arena exists`); T.ok(!!SONGS[d.music], `${d.id}: music exists`); T.ok(d.tools.every((t) => TOOLS.includes(t)), `${d.id}: tools valid`);\n    T.ok(!d.scene || SCENES.some((s) => s.id === d.scene), `${d.id}: scene exists`); T.ok(d.patient.name && d.patient.hook && d.patient.followUp.S && d.patient.followUp.C, `${d.id}: patient chart + follow-ups`);\n    for (const r of ['S', 'A', 'B', 'C']) { const f = d.patient.followUp[r]; if (f) T.ok(FONT.test(clean(f)), `${d.id}: follow-up ${r} font chars`); }\n    T.ok(FONT.test(clean(d.patient.hook)) && FONT.test(clean(d.patient.job)) && FONT.test(clean(d.title)), `${d.id}: chart text font chars`);\n    const used = new Set(d.unlockedTools || d.tools);\n    const sweep = (o) => { if (!o || typeof o !== 'object') return; if (Array.isArray(o)) return o.forEach(sweep); if (o.k) seenKinds.add(o.k); if (o.say) T.ok(!!LINES[o.say], `${d.id}: say key ${o.say} exists`); if (o.unlock) T.ok(TOOLS.includes(o.unlock), `${d.id}: unlock ${o.unlock}`); if (o.at && o.k !== 'strain') { const [x, z] = o.at; T.ok(Math.abs(x) <= 7 && z >= -3.8 && z <= 3.2, `${d.id}: ${o.id || o.k} at (${x},${z}) is inside the playable area`); if (o.k === 'hook' && o.pull) { const ex = x + Math.cos(o.a || 0) * o.pull, ez = z + Math.sin(o.a || 0) * o.pull; T.ok(Math.abs(ex) <= 7 && ez >= -3.8 && ez <= 3.2, `${d.id}: hook ${o.id} path ends inside the area (${ex.toFixed(1)},${ez.toFixed(1)})`); } } for (const v of Object.values(o)) sweep(v); };\n    sweep(d.stages); sweep(d.timeline);\n    for (const [i, s] of d.stages.entries()) { T.ok(s.id, `${d.id}: stage ${i} has an id`); if (s.hint) T.ok([...TOOLS, 'move', 'dress', 'tables', 'paddles'].includes(s.hint), `${d.id}: hint ${s.hint}`); }\n    const sp = JSON.stringify(d); T.ok(sp.length > 100, `${d.id}: is data`); try { JSON.parse(sp); T.ok(true, ''); } catch { T.ok(false, `${d.id}: JSON-safe`); }\n  }\n  for (const k of ['pool', 'hook', 'cut', 'lac', 'mask', 'polyp', 'egg', 'cyst', 'strain', 'dress', 'drag', 'marker']) T.ok(seenKinds.has(k), `entity kind ${k} used by content`);\n  // About has every field\n  T.ok(ABOUT.source.length === 15 - 0 || ABOUT.source.length >= 14, `about: source fields (${ABOUT.source.length})`);\n  for (const [k, v] of ABOUT.source) T.ok(k && v && v !== 'unknown' || k === 'RESEARCH', `about: ${k} filled`);\n  T.ok(ABOUT.testing.length === 4 && ABOUT.engine.length === 6 && ABOUT.prompt.length === 4, `about: feedback questions (${ABOUT.testing.length}/${ABOUT.engine.length}/${ABOUT.prompt.length})`);\n  for (const arr of [ABOUT.testing, ABOUT.engine, ABOUT.prompt]) for (const [q, a] of arr) T.ok(q && a && FONT.test(clean(a)), `about: answer font chars \"${q.slice(0, 20)}\" ${clean(a).replace(/[A-Z0-9 .,:;!?\\-+%/()\\[\\]'\"#&*=<>]/g, '')}`);\n  for (const l of ABOUT.credits) T.ok(FONT.test(clean(l)), `credits font: ${l.slice(0, 20)}`);\n  // Engine kit untouched, session client verbatim\n  T.ok(readFileSync(ROOT + '/vendor/session.js', 'utf8').length > 10000, 'session client present');\n  const html = readFileSync(ROOT + '/dist/game.html', 'utf8'); T.ok(html.includes(readFileSync(ROOT + '/vendor/session.js', 'utf8')), 'built page contains the session client verbatim');\n  for (const t of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:webgpu', 'hub:session-goal', 'hub:session-howto']) T.ok(html.includes(`name=\"${t}\"`), `head tag ${t}`);\n  T.ok(html.indexOf('<meta charset') < html.indexOf('AIHub') , 'session client right after meta charset');\n}\nEOF\ncat > tests/audio.test.mjs <<'EOF'\nimport { renderSyllable, toWav, b64, syllableFor, CAST_VOICES } from '../src/audio/voice.js';\nimport { renderSound } from '../pixel-engine.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { SONGS } from '../src/content/songs.js';\nexport async function run(T) {\n  for (let t = 0; t < 3; t++) for (let v = 0; v < 5; v++) for (let o = 0; o < 3; o++) { const a = renderSyllable(t, v, o); let m = 0, bad = 0; for (const x of a) { if (!Number.isFinite(x)) bad++; m = Math.max(m, Math.abs(x)); } T.ok(!bad && m > 0.05 && m <= 1, `syllable ${t}${v}${o} non-silent and finite`); }\n  const w = toWav(renderSyllable(0, 0, 0)); T.ok(String.fromCharCode(...w.slice(0, 4)) === 'RIFF' && b64(w).length > 100, 'WAV header + base64');\n  for (const [k, d] of Object.entries(SFX_DEFS)) { const a = renderSound(d); let m = 0, bad = 0; for (const x of a) { if (!Number.isFinite(x)) bad++; m = Math.max(m, Math.abs(x)); } T.ok(!bad && m > 0.01, `sfx ${k} non-silent and finite`); }\n  T.eq(syllableFor('HELLO', 1, CAST_VOICES.reyes), syllableFor('HELLO', 1, CAST_VOICES.reyes), 'letters pick syllables deterministically');\n  T.ok(syllableFor('WHAT?', 0, CAST_VOICES.ilya).pitch > syllableFor('WHAT', 0, CAST_VOICES.ilya).pitch, '? raises pitch');\n  for (const [k, s] of Object.entries(SONGS)) { T.ok(s.bpm > 40 && s.order.length >= 4, `song ${k} has bars`); for (const p of Object.values(s.patterns)) { const n = Object.values(p).map((x) => x.split(' ').length); T.ok(new Set(n).size === 1, `song ${k}: equal track lengths`); } }\n  T.ok(['title', 'ward', 'or-calm', 'or-tense', 'or-critical', 'boss-introit', 'boss-lacrimosa', 'boss-wrath', 'boss-miserere', 'op10', 'results', 'results-sad', 'credits'].every((k) => SONGS[k]), 'every planned song exists');\n}\nEOF\ncat > tests/net.test.mjs <<'EOF'\nimport { createOp, step, drainEvents } from '../src/sim/op.js';\nimport { newBot, botInput } from '../src/sim/bot.js';\nimport { BY_ID, SESSION_ROUNDS } from '../src/content/ops/index.js';\nimport { encodeKey, decodeKey, encodeSnap, applySnap, jsonSize } from '../src/net/codec.js';\nimport { resetConfig } from '../src/core/config.js';\nexport async function run(T) {\n  for (const def of [...SESSION_ROUNDS, BY_ID.op9, BY_ID.op3]) {\n    resetConfig(); const seats = [0, 1, 2, 3].map((i) => ({ id: i, doctor: i % 2 ? 'sabine' : 'ilya' })); const sim = createOp(def, { seed: 2, seats, quietOn: true, humans: 4 });\n    const bots = seats.map(() => newBot(0.8)); let maxK = 0, maxS = 0, last = new Map();\n    for (let i = 0; i < 60 * 70 && !sim.over; i++) { const inp = {}; sim.seats.forEach((s, k) => (inp[s.id] = botInput(sim, s, bots[k]))); step(sim, inp); drainEvents(sim); if (i % 30 === 0) { maxK = Math.max(maxK, jsonSize(encodeKey(sim, []))); maxS = Math.max(maxS, jsonSize(encodeSnap(sim, i, last))); } }\n    T.ok(maxK <= 16000, `${def.id}: keyframe <= 16 KB (${maxK})`); T.ok(maxS <= 1100, `${def.id}: snapshot <= 1,100 bytes (${maxS})`);\n    const k = JSON.parse(JSON.stringify(encodeKey(sim, []))); const sim2 = createOp(def, { seed: 2, seats, quietOn: true, humans: 4 }); decodeKey(k, sim2);\n    T.ok(sim2.ents.length === sim.ents.length && Math.abs(sim2.t - sim.t) < 0.02 && sim2.stage === sim.stage, `${def.id}: keyframe round trip`);\n    const sn = JSON.parse(JSON.stringify(encodeSnap(sim, 1, new Map()))); applySnap(sim2, sn); T.ok(Math.abs(sim2.tables[0].vitals - sim.tables[0].vitals) <= 1, `${def.id}: snapshot round trip`);\n  }\n}\nEOF\necho ok"}}}
