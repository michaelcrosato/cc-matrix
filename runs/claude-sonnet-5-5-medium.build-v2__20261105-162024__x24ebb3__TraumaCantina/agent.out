{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkgdumpAMD1bdow6yvKm","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3898,"cache_read_input_tokens":418734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3898},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"e5e80adb-e2f9-4327-ab10-7ee90e4af413","timestamp":"2026-11-05T23:55:14.617Z","request_id":"req_011CgkgduVgrKJEVmgpZBdj8","thinking_duration_ms":1127,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkgdumpAMD1bdow6yvKm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014MamoHu4C5kLR6ytsxfQev","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && sed -i \"s/hud.rect(4, h - 30, 28, 28, 'navy'); drawFace/hud.rect(4, h - csH + 2, 28, 28, 'navy'); drawFace/\" src/ui/opHud.js && cat > tests/sim.test.mjs <<'EOF'\nimport { runBot } from './harness.mjs';\nimport { createOp, step, drainEvents, result, hash, rankOf } from '../src/sim/op.js';\nimport { newBot, botInput } from '../src/sim/bot.js';\nimport { BY_ID, OPS } from '../src/content/ops/index.js';\nimport { cfg, resetConfig, DEFAULTS, SLIDERS } from '../src/core/config.js';\nimport { spawn } from '../src/sim/core.js';\nconst IDLE = {};\nconst mk = (id = 'op2', o = {}) => { resetConfig(); const def = BY_ID[id]; const sim = createOp(def, { seed: 3, seats: [{ id: 0, doctor: def.surgeon }], quietOn: true, ...o }); sim.unlocked = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner']; return sim; };\nconst run = (sim, n, inp) => { for (let i = 0; i < n; i++) step(sim, { 0: typeof inp === 'function' ? inp(i, sim) : inp }); };\nconst clearEnts = (sim) => { sim.ents.length = 0; };\nexport async function run_(T) { }\nexport async function run(T) {\n  // ---- tools ----\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'pool', id: 'p', at: [0, 0], r: 1.2 }); spawn(s, { k: 'hook', id: 'h', at: [0, 0.2], a: 0, hiddenBy: 'p', pull: 1.2, arc: 0 });\n    T.ok(s.ents.find((e) => e.id === 'h').hid === 'p:p', 'hook hidden under pool');\n    run(s, 240, { px: 0, pz: 0, tool: 'drain', use: true }); T.ok(!s.ents.find((e) => e.id === 'p'), 'drain removes pool'); T.ok(s.ents.find((e) => e.id === 'h').hid === null, 'drain reveals the hook');\n    run(s, 5, { px: 0, pz: 0.2, tool: 'forceps', use: true }); T.ok(s.seats[0].grab === 'h', 'forceps grab a hook'); let x = 0; run(s, 120, () => ({ px: (x += 0.015), pz: 0.2, tool: 'forceps', use: true })); T.ok(!s.ents.find((e) => e.id === 'h'), 'forceps pull the hook along its path'); T.ok(s.score.clean + s.score.good >= 1, 'hook rated'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'hook', id: 'h', at: [0, 0], a: 0, pull: 1.2, arc: 0 }); run(s, 5, { px: 0, pz: 0, tool: 'forceps', use: true }); run(s, 30, { px: 0.3, pz: 2.5, tool: 'forceps', use: true }); T.ok(s.score.mistakes === 1 && s.ents.some((e) => e.k === 'nick'), 'forceps off path tear tissue: mistake + nick'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'cut', id: 'c', path: [[-1, 0], [1, 0]] }); run(s, 3, { px: -1, pz: 0, tool: 'scalpel', use: true }); T.ok(s.seats[0].cut === 'c', 'scalpel starts at the guide start'); let x = -1; run(s, 150, () => ({ px: (x += 0.02), pz: 0, tool: 'scalpel', use: true })); T.ok(!s.ents.find((e) => e.id === 'c') && s.score.clean >= 1, 'scalpel clean cut completes');\n    const s2 = mk('op2'); clearEnts(s2); spawn(s2, { k: 'cut', id: 'c', path: [[-1, 0], [1, 0]] }); run(s2, 3, { px: -1, pz: 0, tool: 'scalpel', use: true }); run(s2, 10, { px: -0.5, pz: 1.4, tool: 'scalpel', use: true }); T.ok(s2.score.mistakes === 1 && s2.ents.some((e) => e.k === 'pool'), 'scalpel > 0.8 off cuts healthy tissue: pool + mistake'); }\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'lac', id: 'l', at: [-1, 0], a: 0, len: 1.35 }); const n = s.ents[0].n; let t = 0; run(s, 600, (i, sm) => { const l = sm.ents[0]; if (!l) return { px: 0, pz: 0, tool: 'suture', use: true }; const side = Math.floor(i / 22) % 2 ? 1 : -1; const u = -1 + l.tied * 0.45 + 0.1 + ((i % 22) / 22) * 0.2; return { px: u, pz: side * 0.46, tool: 'suture', use: true }; }); T.ok(!s.ents.find((e) => e.id === 'l') || s.ents.find((e) => e.id === 'l').tied > 0, 'suture ties stitches when zigzagging'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'polyp', id: 'p', at: [1, 1] }); run(s, 60, { px: 1, pz: 1, tool: 'laser', use: true }); T.ok(!s.ents.find((e) => e.id === 'p'), 'laser burns a polyp in 0.7 s'); run(s, 70, { px: -3, pz: -2, tool: 'laser', use: true }); T.ok(s.score.mistakes === 1, 'laser on healthy tissue > 0.5 s burns it: mistake'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'cyst', id: 'c', at: [1, 1], real: false }); run(s, 60, { px: 1, pz: 1, tool: 'laser', use: true }); T.ok(s.score.mistakes === 1, 'a false cyst is a mistake'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'prop', id: 'x' }); spawn(s, { k: 'hook', id: 'h', at: [1, 1], a: 0, hid: 'scan' }); run(s, 3, { px: 0, pz: 0.5, tool: 'scanner', use: true }); T.ok(s.ents.find((e) => e.id === 'h').hid === null, 'scanner reveals hidden things within 2.2'); }\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'mask', id: 'm', shape: { cx: 0, cz: 0, rx: 1, rz: 1 } }); let a = 0; run(s, 400, (i) => ({ px: Math.cos((a += 0.05)) * 0.8 * (1 - (i % 120) / 200), pz: Math.sin(a) * 0.8 * (1 - (i % 120) / 200), tool: 'gel', use: true })); T.ok(s.ents.find((e) => e.id === 'm') === undefined || s.ents[0].cov > 0.5, 'gel paints a mask'); }\n  { const s = mk('op1'); s.tables[0].vitals = 30; run(s, 30, { px: 0, pz: 0, tool: 'syringe', use: true }); const ring = s.rings[0]; T.ok(!!ring, 'syringe draws a ring in 0.45 s'); run(s, 3, { px: ring.x, pz: ring.z, tool: 'syringe', use: true }); run(s, 3, { px: ring.x, pz: ring.z, tool: 'syringe', use: false }); T.ok(s.tables[0].vitals > 45 && s.doses === BY_ID.op1.doses - 1, 'syringe inside the ring: +18 vitals, -1 dose'); }\n  { const s = mk('op1'); s.tables[0].vitals = 30; run(s, 30, { px: 0, pz: 0, tool: 'syringe', use: true }); const ring = s.rings[0]; run(s, 2, { px: ring.x + 3, pz: ring.z, tool: 'syringe', use: false }); T.ok(s.score.sloppy >= 1 && s.doses === BY_ID.op1.doses - 1, 'syringe outside the ring is wasted + SLOPPY'); }\n  // ---- Code Blue ----\n  { const s = mk('op1', { cheat: {} }); s.tables[0].vitals = 0.001; clearEnts(s); run(s, 5, {}); T.ok(!!s.cb && s.unscriptedCB, 'vitals 0 starts an unscripted Code Blue (caps rank at A)');\n    const shock = (good) => { run(s, 2, { use: true, use2: true }); const target = 0.7; let guard = 0; run(s, 400, (i, sm) => { const ok = good ? Math.abs(sm.cb.pos - 0.7) < 0.03 : sm.cb.pos < 0.2; return { use: !(ok && sm.cb.charge > 0.3), use2: !(ok && sm.cb.charge > 0.3) }; }); };\n    shock(true); T.ok(s.cb && s.cb.goods === 1, 'a good shock counts'); shock(true); T.ok(!s.cb && s.tables[0].vitals === 25, 'two good shocks return vitals to 25'); const r = result(s); T.ok('SABC'.indexOf(r.rank) >= 1, 'an unscripted Code Blue caps the rank at A'); }\n  { const s = mk('op1'); s.tables[0].vitals = 0.001; s.savesLeft = 0; run(s, 5, {}); T.ok(s.over === 'fail', 'no saves left: the patient is lost'); }\n  // ---- The Quiet and The Second Look ----\n  { const s = mk('op1', { quietOn: true }); s.giftsOn.quiet = true; const a = s.tables[0].vitals; run(s, 60, { gift: true }); T.ok(s.quiet && s.tables[0].vitals === a, 'The Quiet stops vitals falling'); T.ok(s.composure < 40, 'The Quiet drains composure'); const t0 = s.t; run(s, 60, { gift: true }); T.ok(Math.abs((s.t - t0) - 0.25) < 0.01, 'The Quiet slows the sim to x0.25'); run(s, 1, {}); }\n  { const def = BY_ID.op6; resetConfig(); const s = createOp(def, { seed: 1, seats: [{ id: 0, doctor: 'sabine' }] }); s.composure = 100; const bot = newBot(1); bot.x = s.seats[0].x; bot.z = s.seats[0].z; for (let i = 0; i < 240; i++) step(s, { 0: botInput(s, s.seats[0], bot) }); const before = JSON.stringify([s.ents.map((e) => [e.id, e.x, e.z]), s.tables[0].vitals.toFixed(2)]); const t4 = s.t; for (let i = 0; i < 300; i++) step(s, { 0: botInput(s, s.seats[0], bot) }); const tNow = s.t; step(s, { 0: { gift: true } }); T.ok(s.lookUsed === 1 && s.t < tNow - 3 && s.t > tNow - 5, 'The Second Look rewinds 4 s of sim time'); T.ok(s.composure === 100 - cfg.lookCost, 'The Second Look costs composure'); }\n  // ---- scoring ----\n  T.eq([rankOf(0.9), rankOf(0.75), rankOf(0.55), rankOf(0.2), rankOf(0.85), rankOf(0.7), rankOf(0.5)], ['S', 'A', 'B', 'C', 'S', 'A', 'B'], 'rank bounds');\n  { const r = runBot('op1', { skill: 1 }); T.ok(r.res && r.res.rank === 'S' || r.res.rank === 'A', 'op1 bot rank'); T.ok(r.res.pristine === (r.res.rank === 'S' && r.sim.score.mistakes === 0), 'pristine = S + zero mistakes'); const rr = r; rr.sim.retried = true; T.ok('SABC'.indexOf(result(rr.sim).rank) >= 2, 'a retried stage caps rank at B'); }\n  // ---- sliders ----\n  { resetConfig(); for (const [k, , lo, hi] of SLIDERS) { cfg[k] = hi; } T.ok(SLIDERS.every(([k, , , hi]) => cfg[k] === hi), 'sliders set live config'); resetConfig(); T.ok(SLIDERS.every(([k]) => cfg[k] === DEFAULTS[k]), 'reset restores defaults');\n    resetConfig(); cfg.drainMul = 3; const a = runBot('op1', { skill: 0, maxSec: 30 }); resetConfig(); const b = runBot('op1', { skill: 0, maxSec: 30 }); T.ok(a.sim.tables[0].vitals < b.sim.tables[0].vitals, 'vitals drain slider changes the sim'); resetConfig(); }\n  // ---- every op: idle fails; bot clears; determinism; retry ----\n  const ids = [...OPS.map((o) => o.id), 'pileup', 's-introit', 's-lacrimosa', 's-wrath'];\n  for (const id of ids) {\n    const idle = runBot(id, { skill: 0, maxSec: 600 }); T.ok(idle.sim.over === 'fail', `${id}: idle fails (${idle.sim.over})`);\n    const a = runBot(id, { skill: 0.7 }); T.ok(a.sim.over === 'win', `${id}: bot 0.7 clears (${a.sim.over} ${a.sim.why || ''} t=${a.sim.t.toFixed(0)} st=${a.sim.stage})`);\n    if (a.sim.over === 'win') { const b = runBot(id, { skill: 0.7 }); T.ok(hash(a.sim) === hash(b.sim), `${id}: determinism hash stable`); }\n    const def = BY_ID[id]; if (def.stages.length > 2 && !def.tables) { const st = Math.min(2, def.stages.length - 1); const r = runBot(id, { skill: 0.7, startStage: st }); T.ok(r.sim.over === 'win', `${id}: retry from stage ${st} works (${r.sim.over} ${r.sim.why || ''})`); }\n  }\n  // diffs\n  { const a = runBot('op5', { skill: 0.7, difficulty: 'intern' }), c = runBot('op5', { skill: 0.7, difficulty: 'attending' }); T.ok(a.sim.over === 'win' && c.sim.over === 'win', 'intern and attending both playable'); T.ok(a.sim.clockMax > c.sim.clockMax, 'intern has more time than attending'); T.ok(!c.sim.hintOn && a.sim.hintOn, 'attending has no hint marker'); }\n}\nEOF\ncat > tests/campaign.test.mjs <<'EOF'\nimport { runBot } from './harness.mjs';\nimport { CAMPAIGN, recordResult, isUnlocked, shiftReport } from '../src/sim/campaign.js';\nimport { DEFAULT_SAVE } from '../src/core/save.js';\nimport { SCENE_BY_ID } from '../src/content/scenes.js';\nimport { BY_ID } from '../src/content/ops/index.js';\nexport async function run(T) {\n  // whole-game scripted playthrough: every scene and op to credits, with save and unlock checks\n  const save = structuredClone(DEFAULT_SAVE); let n = 0;\n  for (const step of CAMPAIGN) {\n    T.ok(!!SCENE_BY_ID[step.scene], `scene ${step.scene} exists`);\n    if (!step.op) { T.ok(save.next === CAMPAIGN.length - 1, 'every op cleared before the ending'); continue; }\n    T.ok(isUnlocked(save, step.op), `${step.op} unlocked in order`); if (n + 1 < CAMPAIGN.length - 1) T.ok(!isUnlocked(save, CAMPAIGN[n + 2].op || 'x') || n + 2 >= 10, `${CAMPAIGN[n + 2]?.op} still locked`);\n    const r = runBot(step.op, { skill: 0.7, quietOn: step.op !== 'op1' && step.op !== 'op2' && step.op !== 'op3' ? true : false });\n    T.ok(r.sim.over === 'win', `campaign: ${step.op} cleared`); if (r.res) recordResult(save, step.op, r.res); n++;\n  }\n  T.ok(save.quietOn === true, 'The Quiet stays unlocked after op3'); T.ok(shiftReport(save).every((r) => r.rank !== '-'), 'shift report has every rank'); T.ok(Object.keys(save.cleared).length === 10, 'save has 10 cleared ops');\n  JSON.parse(JSON.stringify(save));\n}\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3898,"cache_read_input_tokens":418734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3898},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"09dff758-7381-44a3-af9f-d86ae996bc0d","timestamp":"2026-11-05T23:55:49.536Z","request_id":"req_011CgkgduVgrKJEVmgpZBdj8","wire_tool_inputs":{"toolu_014MamoHu4C5kLR6ytsxfQev":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && sed -i \"s/hud.rect(4, h - 30, 28, 28, 'navy'); drawFace/hud.rect(4, h - csH + 2, 28, 28, 'navy'); drawFace/\" src/ui/opHud.js && cat > tests/sim.test.mjs <<'EOF'\nimport { runBot } from './harness.mjs';\nimport { createOp, step, drainEvents, result, hash, rankOf } from '../src/sim/op.js';\nimport { newBot, botInput } from '../src/sim/bot.js';\nimport { BY_ID, OPS } from '../src/content/ops/index.js';\nimport { cfg, resetConfig, DEFAULTS, SLIDERS } from '../src/core/config.js';\nimport { spawn } from '../src/sim/core.js';\nconst IDLE = {};\nconst mk = (id = 'op2', o = {}) => { resetConfig(); const def = BY_ID[id]; const sim = createOp(def, { seed: 3, seats: [{ id: 0, doctor: def.surgeon }], quietOn: true, ...o }); sim.unlocked = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner']; return sim; };\nconst run = (sim, n, inp) => { for (let i = 0; i < n; i++) step(sim, { 0: typeof inp === 'function' ? inp(i, sim) : inp }); };\nconst clearEnts = (sim) => { sim.ents.length = 0; };\nexport async function run_(T) { }\nexport async function run(T) {\n  // ---- tools ----\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'pool', id: 'p', at: [0, 0], r: 1.2 }); spawn(s, { k: 'hook', id: 'h', at: [0, 0.2], a: 0, hiddenBy: 'p', pull: 1.2, arc: 0 });\n    T.ok(s.ents.find((e) => e.id === 'h').hid === 'p:p', 'hook hidden under pool');\n    run(s, 240, { px: 0, pz: 0, tool: 'drain', use: true }); T.ok(!s.ents.find((e) => e.id === 'p'), 'drain removes pool'); T.ok(s.ents.find((e) => e.id === 'h').hid === null, 'drain reveals the hook');\n    run(s, 5, { px: 0, pz: 0.2, tool: 'forceps', use: true }); T.ok(s.seats[0].grab === 'h', 'forceps grab a hook'); let x = 0; run(s, 120, () => ({ px: (x += 0.015), pz: 0.2, tool: 'forceps', use: true })); T.ok(!s.ents.find((e) => e.id === 'h'), 'forceps pull the hook along its path'); T.ok(s.score.clean + s.score.good >= 1, 'hook rated'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'hook', id: 'h', at: [0, 0], a: 0, pull: 1.2, arc: 0 }); run(s, 5, { px: 0, pz: 0, tool: 'forceps', use: true }); run(s, 30, { px: 0.3, pz: 2.5, tool: 'forceps', use: true }); T.ok(s.score.mistakes === 1 && s.ents.some((e) => e.k === 'nick'), 'forceps off path tear tissue: mistake + nick'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'cut', id: 'c', path: [[-1, 0], [1, 0]] }); run(s, 3, { px: -1, pz: 0, tool: 'scalpel', use: true }); T.ok(s.seats[0].cut === 'c', 'scalpel starts at the guide start'); let x = -1; run(s, 150, () => ({ px: (x += 0.02), pz: 0, tool: 'scalpel', use: true })); T.ok(!s.ents.find((e) => e.id === 'c') && s.score.clean >= 1, 'scalpel clean cut completes');\n    const s2 = mk('op2'); clearEnts(s2); spawn(s2, { k: 'cut', id: 'c', path: [[-1, 0], [1, 0]] }); run(s2, 3, { px: -1, pz: 0, tool: 'scalpel', use: true }); run(s2, 10, { px: -0.5, pz: 1.4, tool: 'scalpel', use: true }); T.ok(s2.score.mistakes === 1 && s2.ents.some((e) => e.k === 'pool'), 'scalpel > 0.8 off cuts healthy tissue: pool + mistake'); }\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'lac', id: 'l', at: [-1, 0], a: 0, len: 1.35 }); const n = s.ents[0].n; let t = 0; run(s, 600, (i, sm) => { const l = sm.ents[0]; if (!l) return { px: 0, pz: 0, tool: 'suture', use: true }; const side = Math.floor(i / 22) % 2 ? 1 : -1; const u = -1 + l.tied * 0.45 + 0.1 + ((i % 22) / 22) * 0.2; return { px: u, pz: side * 0.46, tool: 'suture', use: true }; }); T.ok(!s.ents.find((e) => e.id === 'l') || s.ents.find((e) => e.id === 'l').tied > 0, 'suture ties stitches when zigzagging'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'polyp', id: 'p', at: [1, 1] }); run(s, 60, { px: 1, pz: 1, tool: 'laser', use: true }); T.ok(!s.ents.find((e) => e.id === 'p'), 'laser burns a polyp in 0.7 s'); run(s, 70, { px: -3, pz: -2, tool: 'laser', use: true }); T.ok(s.score.mistakes === 1, 'laser on healthy tissue > 0.5 s burns it: mistake'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'cyst', id: 'c', at: [1, 1], real: false }); run(s, 60, { px: 1, pz: 1, tool: 'laser', use: true }); T.ok(s.score.mistakes === 1, 'a false cyst is a mistake'); }\n  { const s = mk('op2'); clearEnts(s); spawn(s, { k: 'prop', id: 'x' }); spawn(s, { k: 'hook', id: 'h', at: [1, 1], a: 0, hid: 'scan' }); run(s, 3, { px: 0, pz: 0.5, tool: 'scanner', use: true }); T.ok(s.ents.find((e) => e.id === 'h').hid === null, 'scanner reveals hidden things within 2.2'); }\n  { const s = mk('op1'); clearEnts(s); spawn(s, { k: 'mask', id: 'm', shape: { cx: 0, cz: 0, rx: 1, rz: 1 } }); let a = 0; run(s, 400, (i) => ({ px: Math.cos((a += 0.05)) * 0.8 * (1 - (i % 120) / 200), pz: Math.sin(a) * 0.8 * (1 - (i % 120) / 200), tool: 'gel', use: true })); T.ok(s.ents.find((e) => e.id === 'm') === undefined || s.ents[0].cov > 0.5, 'gel paints a mask'); }\n  { const s = mk('op1'); s.tables[0].vitals = 30; run(s, 30, { px: 0, pz: 0, tool: 'syringe', use: true }); const ring = s.rings[0]; T.ok(!!ring, 'syringe draws a ring in 0.45 s'); run(s, 3, { px: ring.x, pz: ring.z, tool: 'syringe', use: true }); run(s, 3, { px: ring.x, pz: ring.z, tool: 'syringe', use: false }); T.ok(s.tables[0].vitals > 45 && s.doses === BY_ID.op1.doses - 1, 'syringe inside the ring: +18 vitals, -1 dose'); }\n  { const s = mk('op1'); s.tables[0].vitals = 30; run(s, 30, { px: 0, pz: 0, tool: 'syringe', use: true }); const ring = s.rings[0]; run(s, 2, { px: ring.x + 3, pz: ring.z, tool: 'syringe', use: false }); T.ok(s.score.sloppy >= 1 && s.doses === BY_ID.op1.doses - 1, 'syringe outside the ring is wasted + SLOPPY'); }\n  // ---- Code Blue ----\n  { const s = mk('op1', { cheat: {} }); s.tables[0].vitals = 0.001; clearEnts(s); run(s, 5, {}); T.ok(!!s.cb && s.unscriptedCB, 'vitals 0 starts an unscripted Code Blue (caps rank at A)');\n    const shock = (good) => { run(s, 2, { use: true, use2: true }); const target = 0.7; let guard = 0; run(s, 400, (i, sm) => { const ok = good ? Math.abs(sm.cb.pos - 0.7) < 0.03 : sm.cb.pos < 0.2; return { use: !(ok && sm.cb.charge > 0.3), use2: !(ok && sm.cb.charge > 0.3) }; }); };\n    shock(true); T.ok(s.cb && s.cb.goods === 1, 'a good shock counts'); shock(true); T.ok(!s.cb && s.tables[0].vitals === 25, 'two good shocks return vitals to 25'); const r = result(s); T.ok('SABC'.indexOf(r.rank) >= 1, 'an unscripted Code Blue caps the rank at A'); }\n  { const s = mk('op1'); s.tables[0].vitals = 0.001; s.savesLeft = 0; run(s, 5, {}); T.ok(s.over === 'fail', 'no saves left: the patient is lost'); }\n  // ---- The Quiet and The Second Look ----\n  { const s = mk('op1', { quietOn: true }); s.giftsOn.quiet = true; const a = s.tables[0].vitals; run(s, 60, { gift: true }); T.ok(s.quiet && s.tables[0].vitals === a, 'The Quiet stops vitals falling'); T.ok(s.composure < 40, 'The Quiet drains composure'); const t0 = s.t; run(s, 60, { gift: true }); T.ok(Math.abs((s.t - t0) - 0.25) < 0.01, 'The Quiet slows the sim to x0.25'); run(s, 1, {}); }\n  { const def = BY_ID.op6; resetConfig(); const s = createOp(def, { seed: 1, seats: [{ id: 0, doctor: 'sabine' }] }); s.composure = 100; const bot = newBot(1); bot.x = s.seats[0].x; bot.z = s.seats[0].z; for (let i = 0; i < 240; i++) step(s, { 0: botInput(s, s.seats[0], bot) }); const before = JSON.stringify([s.ents.map((e) => [e.id, e.x, e.z]), s.tables[0].vitals.toFixed(2)]); const t4 = s.t; for (let i = 0; i < 300; i++) step(s, { 0: botInput(s, s.seats[0], bot) }); const tNow = s.t; step(s, { 0: { gift: true } }); T.ok(s.lookUsed === 1 && s.t < tNow - 3 && s.t > tNow - 5, 'The Second Look rewinds 4 s of sim time'); T.ok(s.composure === 100 - cfg.lookCost, 'The Second Look costs composure'); }\n  // ---- scoring ----\n  T.eq([rankOf(0.9), rankOf(0.75), rankOf(0.55), rankOf(0.2), rankOf(0.85), rankOf(0.7), rankOf(0.5)], ['S', 'A', 'B', 'C', 'S', 'A', 'B'], 'rank bounds');\n  { const r = runBot('op1', { skill: 1 }); T.ok(r.res && r.res.rank === 'S' || r.res.rank === 'A', 'op1 bot rank'); T.ok(r.res.pristine === (r.res.rank === 'S' && r.sim.score.mistakes === 0), 'pristine = S + zero mistakes'); const rr = r; rr.sim.retried = true; T.ok('SABC'.indexOf(result(rr.sim).rank) >= 2, 'a retried stage caps rank at B'); }\n  // ---- sliders ----\n  { resetConfig(); for (const [k, , lo, hi] of SLIDERS) { cfg[k] = hi; } T.ok(SLIDERS.every(([k, , , hi]) => cfg[k] === hi), 'sliders set live config'); resetConfig(); T.ok(SLIDERS.every(([k]) => cfg[k] === DEFAULTS[k]), 'reset restores defaults');\n    resetConfig(); cfg.drainMul = 3; const a = runBot('op1', { skill: 0, maxSec: 30 }); resetConfig(); const b = runBot('op1', { skill: 0, maxSec: 30 }); T.ok(a.sim.tables[0].vitals < b.sim.tables[0].vitals, 'vitals drain slider changes the sim'); resetConfig(); }\n  // ---- every op: idle fails; bot clears; determinism; retry ----\n  const ids = [...OPS.map((o) => o.id), 'pileup', 's-introit', 's-lacrimosa', 's-wrath'];\n  for (const id of ids) {\n    const idle = runBot(id, { skill: 0, maxSec: 600 }); T.ok(idle.sim.over === 'fail', `${id}: idle fails (${idle.sim.over})`);\n    const a = runBot(id, { skill: 0.7 }); T.ok(a.sim.over === 'win', `${id}: bot 0.7 clears (${a.sim.over} ${a.sim.why || ''} t=${a.sim.t.toFixed(0)} st=${a.sim.stage})`);\n    if (a.sim.over === 'win') { const b = runBot(id, { skill: 0.7 }); T.ok(hash(a.sim) === hash(b.sim), `${id}: determinism hash stable`); }\n    const def = BY_ID[id]; if (def.stages.length > 2 && !def.tables) { const st = Math.min(2, def.stages.length - 1); const r = runBot(id, { skill: 0.7, startStage: st }); T.ok(r.sim.over === 'win', `${id}: retry from stage ${st} works (${r.sim.over} ${r.sim.why || ''})`); }\n  }\n  // diffs\n  { const a = runBot('op5', { skill: 0.7, difficulty: 'intern' }), c = runBot('op5', { skill: 0.7, difficulty: 'attending' }); T.ok(a.sim.over === 'win' && c.sim.over === 'win', 'intern and attending both playable'); T.ok(a.sim.clockMax > c.sim.clockMax, 'intern has more time than attending'); T.ok(!c.sim.hintOn && a.sim.hintOn, 'attending has no hint marker'); }\n}\nEOF\ncat > tests/campaign.test.mjs <<'EOF'\nimport { runBot } from './harness.mjs';\nimport { CAMPAIGN, recordResult, isUnlocked, shiftReport } from '../src/sim/campaign.js';\nimport { DEFAULT_SAVE } from '../src/core/save.js';\nimport { SCENE_BY_ID } from '../src/content/scenes.js';\nimport { BY_ID } from '../src/content/ops/index.js';\nexport async function run(T) {\n  // whole-game scripted playthrough: every scene and op to credits, with save and unlock checks\n  const save = structuredClone(DEFAULT_SAVE); let n = 0;\n  for (const step of CAMPAIGN) {\n    T.ok(!!SCENE_BY_ID[step.scene], `scene ${step.scene} exists`);\n    if (!step.op) { T.ok(save.next === CAMPAIGN.length - 1, 'every op cleared before the ending'); continue; }\n    T.ok(isUnlocked(save, step.op), `${step.op} unlocked in order`); if (n + 1 < CAMPAIGN.length - 1) T.ok(!isUnlocked(save, CAMPAIGN[n + 2].op || 'x') || n + 2 >= 10, `${CAMPAIGN[n + 2]?.op} still locked`);\n    const r = runBot(step.op, { skill: 0.7, quietOn: step.op !== 'op1' && step.op !== 'op2' && step.op !== 'op3' ? true : false });\n    T.ok(r.sim.over === 'win', `campaign: ${step.op} cleared`); if (r.res) recordResult(save, step.op, r.res); n++;\n  }\n  T.ok(save.quietOn === true, 'The Quiet stays unlocked after op3'); T.ok(shiftReport(save).every((r) => r.rank !== '-'), 'shift report has every rank'); T.ok(Object.keys(save.cleared).length === 10, 'save has 10 cleared ops');\n  JSON.parse(JSON.stringify(save));\n}\nEOF\necho ok"}}}
