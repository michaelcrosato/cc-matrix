,o);let m=0;for(const x of a){if(!Number.isFinite(x))bad++;m=Math.max(m,Math.abs(x))}if(m<0.05)bad++}\nfor(const [k,d] of Object.entries(SFX_DEFS)){const a=renderSound(d);let m=0;for(const x of a){if(!Number.isFinite(x))bad++;m=Math.max(m,Math.abs(x))}if(m<0.01){bad++;console.log('silent',k)}}\nconsole.log('bad',bad)\" 2>&1 | tail -3"}}}
