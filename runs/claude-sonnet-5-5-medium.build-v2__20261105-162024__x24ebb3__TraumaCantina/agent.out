    st.blink -= dt; if (st.blink < 0) { st.bt = 0.14; st.blink = 2 + (Math.sin(t * 3.7) + 1) * 1.5; } st.bt = Math.max(0, st.bt - dt);\n      const lidS = st.bt > 0 ? 1.6 : 0.1 / (e.lid || 1) * 0.6 + 0.1; parts.lids.forEach((l) => { l.scale.y = st.bt > 0 ? 6 : Math.max(0.1, 1.2 - e.lid); l.position.y = 0.1 + (st.bt > 0 ? -0.08 : 0); });\n      mouth.scale.set(e.mouth[0], 0.6 + mouthAmt * 2.6 + (e.mouth[1] - 1) * 0.5, 1); inner.visible = mouthAmt > 0.15 || e.mouth[1] > 1.4;\n      head.rotation.z += ((e.tilt - head.rotation.z) * Math.min(1, dt * 6)); head.rotation.y = Math.sin(t * 0.7) * 0.06; head.rotation.x = Math.sin(t * 0.9 + 1) * 0.03 - mouthAmt * 0.04;\n      sweat.visible = st.emo === 'panic' || st.emo === 'shock'; blush.visible = st.emo === 'smile'; root.position.y = Math.sin(t * 1.3) * 0.01;\n      root.traverse((o) => { if (o.material && o.isMesh) o.visible = o.visible; });\n    },\n  };\n  return api;\n}\nEOF\ncat > src/view/figure.js <<'EOF'\n// Full-body figures for wide shots. Pivots carry the hero rig's joint names, so every HERO_CLIPS clip plays on them.\nimport { THREE, toonMaterial, setLookLayer, compileClips, HERO_CLIPS, HERO_RIG } from '../../pixel-engine.js';\nimport { CAST } from '../content/cast.js';\nconst { Group, Mesh, BoxGeometry, AnimationMixer, SphereGeometry } = THREE;\nexport function buildFigure(id) {\n  const c = CAST[id] || CAST.ilya, root = new Group();\n  const part = (p, w, h, d, color, x = 0, y = 0, z = 0) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(color)); m.position.set(x, y, z); m.castShadow = true; p.add(m); return m; };\n  const piv = (name, p, x, y, z) => { const g = new Group(); g.name = name; g.position.set(x, y, z); p.add(g); return g; };\n  const scrub = c.scrub || 0x2a9a98, skin = c.skin || 0xe8b890;\n  const pel = piv('Pelvis', root, 0, 0.62, 0); part(pel, 0.36, 0.18, 0.22, scrub, 0, 0.02, 0);\n  const tor = piv('Torso', pel, 0, 0.1, 0); part(tor, 0.38, 0.42, 0.24, id === 'bram' || id === 'hesper' ? 0xf4f4f4 : scrub, 0, 0.22, 0);\n  const head = piv('Head', tor, 0, 0.44, 0); part(head, 0.26, 0.28, 0.24, skin, 0, 0.12, 0); part(head, 0.28, 0.1, 0.26, c.cap || c.hair || 0x2a1c18, 0, 0.27, 0); part(head, 0.2, 0.1, 0.02, 0xe8f0f0, 0, 0.06, 0.13);\n  if (c.hairStyle === 'bun') part(head, 0.1, 0.1, 0.1, c.hair, 0, 0.32, -0.12);\n  for (const [s, x] of [['R', -0.25], ['L', 0.25]]) {\n    const a = piv('Arm' + s, tor, x, 0.36, 0); part(a, 0.11, 0.25, 0.11, scrub, 0, -0.12, 0);\n    const f = piv('Forearm' + s, a, 0, -0.25, 0); part(f, 0.1, 0.23, 0.1, skin, 0, -0.11, 0);\n    const h = piv('Hand' + s, f, 0, -0.23, 0); part(h, 0.12, 0.13, 0.12, 0x7ab8e8, 0, -0.06, 0);\n    const l = piv('Leg' + s, pel, s === 'R' ? -0.14 : 0.14, 0, 0); part(l, 0.15, 0.3, 0.15, scrub, 0, -0.15, 0);\n    const sh = piv('Shin' + s, l, 0, -0.3, 0); part(sh, 0.13, 0.22, 0.13, scrub, 0, -0.11, 0);\n    const ft = piv('Foot' + s, sh, 0, -0.22, 0); part(ft, 0.15, 0.1, 0.28, 0x2a2a30, 0, -0.05, 0.06);\n  }\n  root.scale.setScalar(2.2 * (c.height || 1)); setLookLayer(root, 'actors');\n  const clips = compileClips(HERO_CLIPS, HERO_RIG, root), mixer = new AnimationMixer(root), by = {}; for (const cl of clips) by[cl.name] = cl;\n  let action = null;\n  return { group: root, mixer, play(n, loop = true) { const cl = by[n] || by.Idle; if (!cl) return; const a = mixer.clipAction(cl); if (action && action !== a) { a.reset().play(); action.crossFadeTo(a, 0.25, false); } else a.play(); action = a; }, update(dt) { mixer.update(dt); } };\n}\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3522,"cache_read_input_tokens":316420,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3522},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use