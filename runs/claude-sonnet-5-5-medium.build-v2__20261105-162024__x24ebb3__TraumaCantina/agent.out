{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgkf2EQ7PVMtgcKYos3UD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01REPrCutH1htEJ5zdJUFCky","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish gibberish: syllables rendered as PCM at boot (pure JS, testable in Node).\nexport const SR = 22050;\nconst VOWELS = [[800, 1200], [400, 2000], [300, 2300], [500, 900], [350, 800]]; // a e i o u (F1, F2)\nconst TIMBRES = [{ f0: 130, f3: 2600, bw: 1.0 }, { f0: 190, f3: 3100, bw: 0.85 }, { f0: 105, f3: 2400, bw: 1.2 }];\nexport const VOICE_NAMES = ['mid', 'high', 'low'];\nfunction res(f, bw) { const r = Math.exp(-Math.PI * bw * 90 / SR), c = 2 * r * Math.cos(2 * Math.PI * f / SR); return { a1: c, a2: -r * r, g: 1 - r }; }\nexport function renderSyllable(timbre, vowel, onset, len = 0.12) {\n  const T = TIMBRES[timbre % 3], V = VOWELS[vowel % 5], n = Math.floor(SR * len), out = new Float32Array(n);\n  const rs = [res(V[0], T.bw), res(V[1], T.bw), res(T.f3, T.bw)], st = rs.map(() => [0, 0]);\n  let seed = 1234 + timbre * 77 + vowel * 13 + onset * 5, ph = 0;\n  const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296 - 0.5; };\n  const on = onset === 1 ? Math.floor(SR * 0.035) : onset === 2 ? Math.floor(SR * 0.012) : 0;\n  for (let i = 0; i < n; i++) {\n    const t = i / n; const f0 = T.f0 * (1 + 0.08 * Math.sin(t * Math.PI)); ph += f0 / SR; if (ph > 1) ph -= 1;\n    let x = (ph < 0.5 ? ph * 4 - 1 : 3 - ph * 4) * 0.7 + (ph < 0.1 ? 0.6 : 0); // glottal-ish pulse\n    if (i < on) x = rnd() * (onset === 1 ? 1.4 : 2.2) * (1 - i / on);\n    let y = 0; for (let k = 0; k < 3; k++) { const s = st[k], q = rs[k], o = q.g * x + q.a1 * s[0] + q.a2 * s[1]; s[1] = s[0]; s[0] = o; y += o * (k === 0 ? 1 : k === 1 ? 0.7 : 0.35); }\n    const env = Math.min(1, i / (SR * 0.012)) * Math.min(1, (n - i) / (SR * 0.03));\n    out[i] = Math.max(-1, Math.min(1, y * env * 0.9));\n  }\n  return out;\n}\nexport function toWav(f32, sr = SR) {\n  const n = f32.length, buf = new ArrayBuffer(44 + n * 2), v = new DataView(buf);\n  const w = (o, s) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };\n  w(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); w(8, 'WAVE'); w(12, 'fmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n  v.setUint32(24, sr, true); v.setUint32(28, sr * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); w(36, 'data'); v.setUint32(40, n * 2, true);\n  for (let i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, f32[i])) * 32767, true);\n  return new Uint8Array(buf);\n}\nexport function b64(u8) { let s = ''; for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000)); return typeof btoa === 'function' ? btoa(s) : Buffer.from(s, 'binary').toString('base64'); }\nexport const sylName = (t, v, o) => `syl-${t}${v}${o}`;\nexport async function loadVoices(audio) {\n  for (let t = 0; t < 3; t++) for (let v = 0; v < 5; v++) for (let o = 0; o < 3; o++) await audio.load(sylName(t, v, o), 'data:audio/wav;base64,' + b64(toWav(renderSyllable(t, v, o))));\n}\n// Letter -> syllable, deterministic. Returns { name, pitch, volume } for the syllable made by the letter pair at `i`.\nexport function syllableFor(text, i, voice) {\n  const ch = text[i] || 'a', code = ch.toUpperCase().charCodeAt(0), nx = (text[i + 1] || 'e').toUpperCase().charCodeAt(0);\n  const vow = 'AEIOU'.indexOf(ch.toUpperCase()); const v = vow >= 0 ? vow : (code + nx) % 5, o = vow >= 0 ? 0 : (code % 2) + 1;\n  let pitch = voice.base + ((code * 7 + nx * 3) % (voice.range * 2 + 1)) - voice.range, vol = 0.8;\n  const rest = text.slice(i, i + 12);\n  if (rest.includes('?') ) pitch += 3; if (rest.includes('!')) { pitch += 2; vol = 1; }\n  return { name: sylName(voice.timbre, v, o), pitch, volume: vol };\n}\nexport const CAST_VOICES = {\n  ilya: { timbre: 1, base: 3, range: 3, speed: 1.1 }, reyes: { timbre: 0, base: -1, range: 2, speed: 1.25 }, sabine: { timbre: 2, base: 1, range: 1, speed: 0.8 },\n  bram: { timbre: 2, base: -6, range: 1, speed: 0.7 }, pem: { timbre: 0, base: -3, range: 3, speed: 0.9 }, hesper: { timbre: 1, base: -2, range: 1, speed: 0.75 },\n  narrator: { timbre: 0, base: 0, range: 2, speed: 1 }, zamboni: { timbre: 1, base: 1, range: 4, speed: 1.1 }, system: { timbre: 0, base: 0, range: 1, speed: 1 },\n};\nEOF\ncat > src/content/sfx.js <<'EOF'\n// Every sound effect is a SoundDef (data). Registered into ctx.audio at boot.\nexport const SFX_DEFS = {\n  uiMove: { wave: 'square', duty: 0.25, freq: 660, decay: 0.04, volume: 0.18 },\n  uiOk: { wave: 'square', duty: 0.5, freq: 520, decay: 0.12, volume: 0.25, arp: [0, 7], arpRate: 0.05 },\n  uiBack: { wave: 'square', duty: 0.25, freq: 400, freqEnd: 200, decay: 0.1, volume: 0.22 },\n  stamp: { wave: 'noise', freq: 300, decay: 0.25, volume: 0.6, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.3, volume: 0.7 }] },\n  chime: { wave: 'triangle', freq: 880, decay: 0.3, volume: 0.3, arp: [0, 4, 7, 12], arpRate: 0.06 },\n  rateClean: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.28, arp: [0, 7], arpRate: 0.05 },\n  rateGood: { wave: 'triangle', freq: 740, decay: 0.14, volume: 0.22 },\n  rateSloppy: { wave: 'square', duty: 0.125, freq: 330, freqEnd: 260, decay: 0.14, volume: 0.2 },\n  mistake: { wave: 'saw', freq: 180, freqEnd: 70, decay: 0.3, volume: 0.35, layers: [{ wave: 'noise', freq: 600, decay: 0.15, volume: 0.3 }] },\n  wrong: { wave: 'square', duty: 0.5, freq: 200, decay: 0.05, volume: 0.2 },\n  slurp: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.16, volume: 0.28, vibrato: { depth: 3, rate: 18 } },\n  drainLoop: { wave: 'noise', freq: 500, decay: 0.3, sustain: 0.1, volume: 0.1, vibrato: { depth: 2, rate: 9 } },\n  grab: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 600, decay: 0.05, volume: 0.22 },\n  hookPop: { wave: 'triangle', freq: 300, freqEnd: 700, decay: 0.09, volume: 0.35 },\n  dish: { wave: 'square', duty: 0.25, freq: 2400, decay: 0.12, volume: 0.28, layers: [{ wave: 'triangle', freq: 3200, decay: 0.2, volume: 0.15, delay: 0.04 }] },\n  cutStart: { wave: 'noise', freq: 2400, decay: 0.07, volume: 0.2 },\n  cutLoop: { wave: 'noise', freq: 3200, decay: 0.2, sustain: 0.05, volume: 0.08 },\n  cutDone: { wave: 'saw', freq: 1400, freqEnd: 500, decay: 0.12, volume: 0.22 },\n  stitch: { wave: 'square', duty: 0.25, freq: 523, decay: 0.07, volume: 0.25 },\n  knot: { wave: 'triangle', freq: 392, decay: 0.2, volume: 0.3, arp: [0, 4, 7], arpRate: 0.05 },\n  laser: { wave: 'saw', freq: 220, decay: 0.2, sustain: 0.05, volume: 0.1, vibrato: { depth: 5, rate: 30 } },\n  burn: { wave: 'noise', freq: 1200, freqEnd: 400, decay: 0.3, volume: 0.3 },\n  ping: { wave: 'sine', freq: 1320, decay: 0.5, volume: 0.35, layers: [{ wave: 'sine', freq: 1980, decay: 0.4, volume: 0.15, delay: 0.1 }] },\n  gelLoop: { wave: 'noise', freq: 200, decay: 0.3, sustain: 0.05, volume: 0.1, vibrato: { depth: 4, rate: 14 } },\n  gelOk: { wave: 'triangle', freq: 600, decay: 0.2, volume: 0.25, arp: [0, 5, 9], arpRate: 0.05 },\n  syrDraw: { wave: 'triangle', freq: 300, freqEnd: 600, decay: 0.4, volume: 0.2 },\n  syrLoad: { wave: 'sine', freq: 1000, decay: 0.2, volume: 0.3 },\n  inject: { wave: 'noise', freq: 1500, freqEnd: 300, decay: 0.3, volume: 0.3, layers: [{ wave: 'triangle', freq: 500, freqEnd: 900, decay: 0.3, volume: 0.2 }] },\n  beep: { wave: 'sine', freq: 880, decay: 0.09, volume: 0.22 },\n  alarm: { wave: 'square', duty: 0.5, freq: 1200, decay: 0.1, volume: 0.2, arp: [0, -4, 0, -4], arpRate: 0.1 },\n  flatline: { wave: 'sine', freq: 900, decay: 1.8, sustain: 1.5, volume: 0.28 },\n  charge: { wave: 'saw', freq: 200, freqEnd: 2200, decay: 1.1, volume: 0.16 },\n  clear: { wave: 'sine', freq: 70, freqEnd: 35, decay: 0.5, volume: 0.9, layers: [{ wave: 'noise', freq: 800, decay: 0.2, volume: 0.6 }] },\n  quietIn: { wave: 'sine', freq: 90, freqEnd: 45, decay: 0.6, volume: 0.5 },\n  heartbeat: { wave: 'sine', freq: 70, freqEnd: 45, decay: 0.16, volume: 0.55, layers: [{ wave: 'sine', freq: 60, freqEnd: 40, decay: 0.14, volume: 0.45, delay: 0.17 }] },\n  rewind: { wave: 'saw', freq: 1600, freqEnd: 120, decay: 0.7, volume: 0.25, vibrato: { depth: 3, rate: 22 }, layers: [{ wave: 'noise', freq: 2400, freqEnd: 400, decay: 0.7, volume: 0.15 }] },\n  knock: { wave: 'sine', freq: 110, freqEnd: 60, decay: 0.2, volume: 0.9, layers: [{ wave: 'noise', freq: 300, decay: 0.08, volume: 0.4 }] },\n  strainHit: { wave: 'saw', freq: 140, freqEnd: 60, decay: 0.35, volume: 0.4 },\n  strainDead: { wave: 'saw', freq: 600, freqEnd: 40, decay: 1.0, volume: 0.4, layers: [{ wave: 'noise', freq: 900, freqEnd: 100, decay: 0.9, volume: 0.3 }] },\n  weep: { wave: 'sine', freq: 1500, freqEnd: 900, decay: 0.15, volume: 0.2 },\n  splat: { wave: 'noise', freq: 600, decay: 0.1, volume: 0.25 },\n  thump: { wave: 'sine', freq: 60, freqEnd: 40, decay: 0.2, volume: 0.6 },\n  massage: { wave: 'sine', freq: 100, freqEnd: 50, decay: 0.15, volume: 0.6 },\n  fanfare: { wave: 'square', duty: 0.25, freq: 523, decay: 0.2, volume: 0.25, arp: [0, 4, 7, 12, 7, 12, 16], arpRate: 0.1 },\n  sad: { wave: 'triangle', freq: 440, decay: 0.8, volume: 0.25, arp: [0, -2, -5, -9], arpRate: 0.22 },\n  tick: { wave: 'square', duty: 0.125, freq: 1500, decay: 0.02, volume: 0.15 },\n  horn: { wave: 'saw', freq: 110, freqEnd: 100, decay: 1.6, sustain: 0.6, volume: 0.16 },\n  bell: { wave: 'sine', freq: 660, decay: 1.2, volume: 0.15, layers: [{ wave: 'sine', freq: 990, decay: 0.8, volume: 0.1 }] },\n  pop: { wave: 'sine', freq: 400, freqEnd: 900, decay: 0.06, volume: 0.3 },\n  fizz: { wave: 'noise', freq: 4000, decay: 0.12, volume: 0.15 },\n  swap: { wave: 'sine', freq: 300, freqEnd: 700, decay: 0.15, volume: 0.2 },\n  lamp: { wave: 'noise', freq: 5000, decay: 0.05, volume: 0.15 },\n  rain: { wave: 'noise', freq: 6000, decay: 0.5, sustain: 0.4, volume: 0.05 },\n  dressSwipe: { wave: 'noise', freq: 1500, decay: 0.1, volume: 0.1 },\n};\nexport function registerSfx(audio) { for (const [k, v] of Object.entries(SFX_DEFS)) audio.register(k, v); }\nEOF\nnode --input-type=module -e \"\nimport {renderSyllable,toWav,b64} from './src/audio/voice.js';\nimport {renderSound} from './pixel-engine.js';\nimport {SFX_DEFS} from './src/content/sfx.js';\nlet bad=0;for(let t=0;t<3;t++)for(let v=0;v<5;v++)for(let o=0;o<3;o++){const a=renderSyllable(t,v,o);let m=0;for(const x of a){if(!Number.isFinite(x))bad++;m=Math.max(m,Math.abs(x))}if(m<0.05)bad++}\nfor(const [k,d] of Object.entries(SFX_DEFS)){const a=renderSound(d);let m=0;for(const x of a){if(!Number.isFinite(x))bad++;m=Math.max(m,Math.abs(x))}if(m<0.01){bad++;console.log('silent',k)}}\nconsole.log('bad',bad)\" 2>&1 | tail -3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1649,"cache_read_input_tokens":222369,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1649},"output_tokens":48,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cb47e1-b6a0-4fd4-af20-38b42f9600a5","uuid":"251e62e4-9144-4e89-b9b5-21e04b8d94f3","timestamp":"2026-11-05T23:34:37.999Z","request_id":"req_011Cgkf2E9VE2mSjdNJm7ktF","wire_tool_inputs":{"toolu_01REPrCutH1htEJ5zdJUFCky":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162024__x24ebb3/work/Trauma*/ && cat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish gibberish: syllables rendered as PCM at boot (pure JS, testable in Node).\nexport const SR = 22050;\nconst VOWELS = [[800, 1200], [400, 2000], [300, 2300], [500, 900], [350, 800]]; // a e i o u (F1, F2)\nconst TIMBRES = [{ f0: 130, f3: 2600, bw: 1.0 }, { f0: 190, f3: 3100, bw: 0.85 }, { f0: 105, f3: 2400, bw: 1.2 }];\nexport const VOICE_NAMES = ['mid', 'high', 'low'];\nfunction res(f, bw) { const r = Math.exp(-Math.PI * bw * 90 / SR), c = 2 * r * Math.cos(2 * Math.PI * f / SR); return { a1: c, a2: -r * r, g: 1 - r }; }\nexport function renderSyllable(timbre, vowel, onset, len = 0.12) {\n  const T = TIMBRES[timbre % 3], V = VOWELS[vowel % 5], n = Math.floor(SR * len), out = new Float32Array(n);\n  const rs = [res(V[0], T.bw), res(V[1], T.bw), res(T.f3, T.bw)], st = rs.map(() => [0, 0]);\n  let seed = 1234 + timbre * 77 + vowel * 13 + onset * 5, ph = 0;\n  const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296 - 0.5; };\n  const on = onset === 1 ? Math.floor(SR * 0.035) : onset === 2 ? Math.floor(SR * 0.012) : 0;\n  for (let i = 0; i < n; i++) {\n    const t = i / n; const f0 = T.f0 * (1 + 0.08 * Math.sin(t * Math.PI)); ph += f0 / SR; if (ph > 1) ph -= 1;\n    let x = (ph < 0.5 ? ph * 4 - 1 : 3 - ph * 4) * 0.7 + (ph < 0.1 ? 0.6 : 0); // glottal-ish pulse\n    if (i < on) x = rnd() * (onset === 1 ? 1.4 : 2.2) * (1 - i / on);\n    let y = 0; for (let k = 0; k < 3; k++) { const s = st[k], q = rs[k], o = q.g * x + q.a1 * s[0] + q.a2 * s[1]; s[1] = s[0]; s[0] = o; y += o * (k === 0 ? 1 : k === 1 ? 0.7 : 0.35); }\n    const env = Math.min(1, i / (SR * 0.012)) * Math.min(1, (n - i) / (SR * 0.03));\n    out[i] = Math.max(-1, Math.min(1, y * env * 0.9));\n  }\n  return out;\n}\nexport function toWav(f32, sr = SR) {\n  const n = f32.length, buf = new ArrayBuffer(44 + n * 2), v = new DataView(buf);\n  const w = (o, s) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };\n  w(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); w(8, 'WAVE'); w(12, 'fmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n  v.setUint32(24, sr, true); v.setUint32(28, sr * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); w(36, 'data'); v.setUint32(40, n * 2, true);\n  for (let i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, f32[i])) * 32767, true);\n  return new Uint8Array(buf);\n}\nexport function b64(u8) { let s = ''; for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000)); return typeof btoa === 'function' ? btoa(s) : Buffer.from(s, 'binary').toString('base64'); }\nexport const sylName = (t, v, o) => `syl-${t}${v}${o}`;\nexport async function loadVoices(audio) {\n  for (let t = 0; t < 3; t++) for (let v = 0; v < 5; v++) for (let o = 0; o < 3; o++) await audio.load(sylName(t, v, o), 'data:audio/wav;base64,' + b64(toWav(renderSyllable(t, v, o))));\n}\n// Letter -> syllable, deterministic. Returns { name, pitch, volume } for the syllable made by the letter pair at `i`.\nexport function syllableFor(text, i, voice) {\n  const ch = text[i] || 'a', code = ch.toUpperCase().charCodeAt(0), nx = (text[i + 1] || 'e').toUpperCase().charCodeAt(0);\n  const vow = 'AEIOU'.indexOf(ch.toUpperCase()); const v = vow >= 0 ? vow : (code + nx) % 5, o = vow >= 0 ? 0 : (code % 2) + 1;\n  let pitch = voice.base + ((code * 7 + nx * 3) % (voice.range * 2 + 1)) - voice.range, vol = 0.8;\n  const rest = text.slice(i, i + 12);\n  if (rest.includes('?') ) pitch += 3; if (rest.includes('!')) { pitch += 2; vol = 1; }\n  return { name: sylName(voice.timbre, v, o), pitch, volume: vol };\n}\nexport const CAST_VOICES = {\n  ilya: { timbre: 1, base: 3, range: 3, speed: 1.1 }, reyes: { timbre: 0, base: -1, range: 2, speed: 1.25 }, sabine: { timbre: 2, base: 1, range: 1, speed: 0.8 },\n  bram: { timbre: 2, base: -6, range: 1, speed: 0.7 }, pem: { timbre: 0, base: -3, range: 3, speed: 0.9 }, hesper: { timbre: 1, base: -2, range: 1, speed: 0.75 },\n  narrator: { timbre: 0, base: 0, range: 2, speed: 1 }, zamboni: { timbre: 1, base: 1, range: 4, speed: 1.1 }, system: { timbre: 0, base: 0, range: 1, speed: 1 },\n};\nEOF\ncat > src/content/sfx.js <<'EOF'\n// Every sound effect is a SoundDef (data). Registered into ctx.audio at boot.\nexport const SFX_DEFS = {\n  uiMove: { wave: 'square', duty: 0.25, freq: 660, decay: 0.04, volume: 0.18 },\n  uiOk: { wave: 'square', duty: 0.5, freq: 520, decay: 0.12, volume: 0.25, arp: [0, 7], arpRate: 0.05 },\n  uiBack: { wave: 'square', duty: 0.25, freq: 400, freqEnd: 200, decay: 0.1, volume: 0.22 },\n  stamp: { wave: 'noise', freq: 300, decay: 0.25, volume: 0.6, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.3, volume: 0.7 }] },\n  chime: { wave: 'triangle', freq: 880, decay: 0.3, volume: 0.3, arp: [0, 4, 7, 12], arpRate: 0.06 },\n  rateClean: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.28, arp: [0, 7], arpRate: 0.05 },\n  rateGood: { wave: 'triangle', freq: 740, decay: 0.14, volume: 0.22 },\n  rateSloppy: { wave: 'square', duty: 0.125, freq: 330, freqEnd: 260, decay: 0.14, volume: 0.2 },\n  mistake: { wave: 'saw', freq: 180, freqEnd: 70, decay: 0.3, volume: 0.35, layers: [{ wave: 'noise', freq: 600, decay: 0.15, volume: 0.3 }] },\n  wrong: { wave: 'square', duty: 0.5, freq: 200, decay: 0.05, volume: 0.2 },\n  slurp: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.16, volume: 0.28, vibrato: { depth: 3, rate: 18 } },\n  drainLoop: { wave: 'noise', freq: 500, decay: 0.3, sustain: 0.1, volume: 0.1, vibrato: { depth: 2, rate: 9 } },\n  grab: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 600, decay: 0.05, volume: 0.22 },\n  hookPop: { wave: 'triangle', freq: 300, freqEnd: 700, decay: 0.09, volume: 0.35 },\n  dish: { wave: 'square', duty: 0.25, freq: 2400, decay: 0.12, volume: 0.28, layers: [{ wave: 'triangle', freq: 3200, decay: 0.2, volume: 0.15, delay: 0.04 }] },\n  cutStart: { wave: 'noise', freq: 2400, decay: 0.07, volume: 0.2 },\n  cutLoop: { wave: 'noise', freq: 3200, decay: 0.2, sustain: 0.05, volume: 0.08 },\n  cutDone: { wave: 'saw', freq: 1400, freqEnd: 500, decay: 0.12, volume: 0.22 },\n  stitch: { wave: 'square', duty: 0.25, freq: 523, decay: 0.07, volume: 0.25 },\n  knot: { wave: 'triangle', freq: 392, decay: 0.2, volume: 0.3, arp: [0, 4, 7], arpRate: 0.05 },\n  laser: { wave: 'saw', freq: 220, decay: 0.2, sustain: 0.05, volume: 0.1, vibrato: { depth: 5, rate: 30 } },\n  burn: { wave: 'noise', freq: 1200, freqEnd: 400, decay: 0.3, volume: 0.3 },\n  ping: { wave: 'sine', freq: 1320, decay: 0.5, volume: 0.35, layers: [{ wave: 'sine', freq: 1980, decay: 0.4, volume: 0.15, delay: 0.1 }] },\n  gelLoop: { wave: 'noise', freq: 200, decay: 0.3, sustain: 0.05, volume: 0.1, vibrato: { depth: 4, rate: 14 } },\n  gelOk: { wave: 'triangle', freq: 600, decay: 0.2, volume: 0.25, arp: [0, 5, 9], arpRate: 0.05 },\n  syrDraw: { wave: 'triangle', freq: 300, freqEnd: 600, decay: 0.4, volume: 0.2 },\n  syrLoad: { wave: 'sine', freq: 1000, decay: 0.2, volume: 0.3 },\n  inject: { wave: 'noise', freq: 1500, freqEnd: 300, decay: 0.3, volume: 0.3, layers: [{ wave: 'triangle', freq: 500, freqEnd: 900, decay: 0.3, volume: 0.2 }] },\n  beep: { wave: 'sine', freq: 880, decay: 0.09, volume: 0.22 },\n  alarm: { wave: 'square', duty: 0.5, freq: 1200, decay: 0.1, volume: 0.2, arp: [0, -4, 0, -4], arpRate: 0.1 },\n  flatline: { wave: 'sine', freq: 900, decay: 1.8, sustain: 1.5, volume: 0.28 },\n  charge: { wave: 'saw', freq: 200, freqEnd: 2200, decay: 1.1, volume: 0.16 },\n  clear: { wave: 'sine', freq: 70, freqEnd: 35, decay: 0.5, volume: 0.9, layers: [{ wave: 'noise', freq: 800, decay: 0.2, volume: 0.6 }] },\n  quietIn: { wave: 'sine', freq: 90, freqEnd: 45, decay: 0.6, volume: 0.5 },\n  heartbeat: { wave: 'sine', freq: 70, freqEnd: 45, decay: 0.16, volume: 0.55, layers: [{ wave: 'sine', freq: 60, freqEnd: 40, decay: 0.14, volume: 0.45, delay: 0.17 }] },\n  rewind: { wave: 'saw', freq: 1600, freqEnd: 120, decay: 0.7, volume: 0.25, vibrato: { depth: 3, rate: 22 }, layers: [{ wave: 'noise', freq: 2400, freqEnd: 400, decay: 0.7, volume: 0.15 }] },\n  knock: { wave: 'sine', freq: 110, freqEnd: 60, decay: 0.2, v