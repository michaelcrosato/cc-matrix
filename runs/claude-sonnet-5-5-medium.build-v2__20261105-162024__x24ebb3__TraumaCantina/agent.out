ud.rect(x + 4, y + 5, 2, 12, c.hair); hud.rect(x + 22, y + 5, 2, 12, c.hair); if (c.hairStyle === 'bun') hud.rect(x + 11, y, 6, 4, c.hair); }\n  if (c.cap) hud.rect(x + 4, y + 2, 20, 5, c.cap);\n  const blink = ((t * 0.5) % 3.2) > 3.05; const ey = emo === 'angry' || emo === 'stern' ? 1 : 0;\n  for (const ex of [9, 17]) { hud.rect(x + ex, y + 11 + ey, 3, blink ? 1 : 3, 0xf8f8f8); if (!blink) hud.rect(x + ex + 1, y + 12 + ey, 1, 2, 0x201018); hud.rect(x + ex - 1, y + 9 + (emo === 'sad' || emo === 'panic' ? -1 : ey), 5, 1, c.brows === 'fierce' ? 0x101010 : (c.hair || 0x4a3a2a)); }\n  if (c.glasses) { hud.rect(x + 8, y + 10, 5, 5, c.glasses); hud.rect(x + 9, y + 11, 3, 3, c.skin); hud.rect(x + 16, y + 10, 5, 5, c.glasses); hud.rect(x + 17, y + 11, 3, 3, c.skin); }\n  if (c.moustache) hud.rect(x + 9, y + 18, 10, 2, c.moustache);\n  const mo = Math.round(mouth * 3); hud.rect(x + 11, y + 20 + (c.moustache ? 1 : 0), 6, 1 + mo, emo === 'smile' ? 0xa03030 : 0x7a2030);\n}\nexport function drawCodeBlue\"\"\",1)\nopen(p,'w').write(s)\np='src/stages/operation.js'\ns=open(p).read()\ns=s.replace(\"const view = { sim, def: this.def, seat, comm: this.comm,\",\"const view = { sim, def: this.def, seat, comm: this.comm, mouth: this.speaker.mouth,\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"emo\" src/stages/operation.js | head -3; sed -i \"s/this.comm = { who, text, shown: '' };/this.comm = { who, text, shown: '', emo: LINES_EMO[text] || 'stern' };/\" src/stages/operation.js; sed -i \"s/^const CAM = /const LINES_EMO = {};\\nconst CAM = /\" src/stages/operation.js; node tools/build.mjs 2>&1 | tail -1; for o in op5 op8; do timeout 120 node tests/browser/shot.mjs \"?op=$o&bot=1\" 12 $o; done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":872,"cache_read_input_tokens":411532,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":872},"output_tokens":2,"servic