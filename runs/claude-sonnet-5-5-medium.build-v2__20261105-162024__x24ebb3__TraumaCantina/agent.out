0.5, 2 + (i % 3) * 0.4, -4.8, { glow: true });\")\ns=s.replace(\"const hp = new Mesh(new CylinderGeometry(4.2, 4.2, 0.05, 28), toonMaterial(0x3a4048)); hp.position.set(0, 0.03, 0); g.add(hp);\",\"box(g, 8.4, 0.05, 8.4, 0x3a4048, 0, 0.03, 0, { cyl: true });\")\ns=s.replace(\"const d = prop('desk', [0, 0, -2.4], 0, 2.2) ?? box(g, 3, 1.1, 1.2, PALETTE.orange, 0, 0.55, -2.4); if (d.isGroup) g.add(d);\",\"const d = prop('desk', [0, 0, -2.4], 0, 2.2); if (d) g.add(d); else box(g, 3, 1.1, 1.2, PALETTE.orange, 0, 0.55, -2.4);\")\ns=s.replace(\"  const g = new Group(), S = { group: g,\",\"  DR = []; const g = new Group(), S = { group: g,\",1)\ns=s.replace(\"  if (S.rain) { g.add(S.rain); }\",\"  finishDressing(g, id);\\n  if (S.rain) { g.add(S.rain); }\",1)\nopen(p,'w').write(s)\n# field frame as model\np='src/content/models/index.js'\ns=open(p).read()\ns+='''\nexport const fieldFrameDef = model({ id: 'field-frame', about: 'Drapes and clamps framing an operating field', tags: ['set', 'surgery'], floats: true, palette: { drape: 'teal', steel: 'slate' }, parts: [\n  { box: [2.4, 0.8, 12], at: [-9.2, 0.2, 0], c: 'drape' }, { box: [2.4, 0.8, 12], at: [9.2, 0.2, 0], c: 'drape' }, { box: [20, 0.8, 1.6], at: [0, 0.2, -5.4], c: 'drape' }, { box: [20, 0.8, 1.6], at: [0, 0.2, 5.6], c: 'drape' },\n  { box: [0.5, 0.5, 0.9], at: [-7.8, 0.75, -4.0], c: 'steel' }, { box: [0.5, 0.5, 0.9], at: [7.8, 0.75, -4.0], c: 'steel' }, { box: [0.5, 0.5, 0.9], at: [-7.8, 0.75, 4.0], c: 'steel' }] });\nMODELS.push(fieldFrameDef);\n'''\nopen(p,'w').write(s)\np='src/view/field.js'\ns=open(p).read()\ni=s.index(\"    // drapes and clamps frame the field\")\nj=s.index(\"    return { base, cv, g, tex, mesh, geo\")\ns=s[:i]+\"    const fr = buildModel(fieldFrameDef).object; fr.position.x = this.X0(tb); fr.traverse((m) => { if (m.isMesh) { m.castShadow = m.receiveShadow = true; } }); setLookLayer(fr, 'actors'); this.root.add(fr);\\n\"+s[j:]\ns=s.replace(\"import { entDefs }\",\"import { entDefs, fieldFrameDef }