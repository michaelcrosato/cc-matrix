 t.magFilter = NearestFilter; return { cv, t, g: cv.getContext('2d') }; }\n\nexport function buildSet(ctx, id) {\n  const g = new Group(), S = { group: g, update() {}, figures: [], shots: {}, lights: [], dispose() { g.removeFromParent(); } };\n  const eng = ctx.engine; ctx.scene.add(g);\n  const light = (o) => { S.lights.push(ctx.lights.request(o)); };\n  const fig = (cid, x, z, rot, anim = 'Idle') => { const f = buildFigure(cid); f.group.position.set(x, 0, z); f.group.rotation.y = rot; f.play(anim); g.add(f.group); S.figures.push(f); return f; };\n  S.fig = fig;\n  switch (id) {\n    case 'or7': {\n      eng.sun.intensity = 0.35; eng.ambient.intensity = 0.28; eng.ambient.color.setHex(0x8fa8c8);\n      room(g, 18, 14, 6, 0x2a3440, 0x3a4a58);\n      box(g, 8, 3.2, 0.12, 0x4a7a8a, 0, 3, -6.9).material = toonMaterial(PALETTE.cyan); // gallery glass\n      box(g, 8.4, 0.2, 0.3, 0x2a2a30, 0, 1.4, -6.85); box(g, 8.4, 0.2, 0.3, 0x2a2a30, 0, 4.6, -6.85);\n      box(g, 3.4, 0.2, 1.6, PALETTE.slate, 0, 1.2, 0); for (const x of [-1.4, 1.4]) box(g, 0.2, 1.2, 1.2, PALETTE.slate, x, 0.6, 0); // table\n      box(g, 2.8, 0.3, 1.2, PALETTE.teal, 0, 1.45, 0); const pt = new Mesh(new SphereGeometry(0.4, 10, 8), toonMaterial(0xe8b890)); pt.position.set(-1.5, 1.5, 0); g.add(pt);\n      const lamp = new Group(); lamp.position.set(0, 5.6, 0); g.add(lamp); box(lamp, 0.1, 2.4, 0.1, PALETTE.slate, 0, -1.2, 0); const sh = new Mesh(new CylinderGeometry(0.2, 0.9, 0.5, 14), toonMaterial(PALETTE.mist)); sh.position.y = -2.5; lamp.add(sh); setLookLayer(lamp, 'actors');\n      const mon = box(g, 1.2, 0.9, 0.2, PALETTE.ink, 3.6, 2.6, -1.0), mt = monitorTex(); const scr = new Mesh(new PlaneGeometry(1.0, 0.75), new MeshBasicMaterial({ map: mt.t })); scr.position.set(3.6, 2.6, -0.88); g.add(scr); box(g, 0.1, 2, 0.1, PALETTE.slate, 3.6, 1, -1.0);\n      box(g, 1.4, 0.1, 0.8, PALETTE.slate, -3.6, 1.4, 0.2); for (let i = 0; i < 4; i++) box(g, 0.08, 0.06, 0.5, PALETTE.mist, -4 + i * 0.25, 1.5, 0.2);\n     