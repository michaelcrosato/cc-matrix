) {","+    this.t = 0; this.goal = null; this.watchId = null;","+    const st = this.steps[this.i];","+    this.current = st || null;","+    if (!st) return;","     if (st.caption) this.caption = st.caption;","-    this.current = st; this.t = 0;","     if (st.walk) this.goal = cellWorld(st.walk);","     if (st.watch) this.watchId = st.watch;","-    if (st.photo) { this.shot = true; this.photoPending = true; }","   },","-  update(dt, g) {","+  next() {","+    this.i++;","+    if (this.i >= this.steps.length) {                  // the vignette ends: loop the reel","+      this.vignette = (this.vignette + 1) % this.reel.length;","+      this.begin(this.reel[this.vignette]);","+      return;","+    }","+    this.enter();","+  },","+  update(dt) {","     const cur = this.current;","     this.t += dt;","-    if (cur) {","-      if (cur.walk) { const [x, y] = cellWorld(cur.walk); if (Math.hypot(x - DANA.x, y - DANA.y) < 8) this.advance(g); }","-      else if (cur.watch) { if (this.t >= cur.s) this.advance(g); }","-      else if (cur.photo) { this.advance(g); }","-      else if (cur.wait) { if (this.t >= cur.wait) this.advance(g); }","-    }","-    if (this.goal == null && this.script.length && !this.current) this.advance(g);","-    this.badge = (this.badge + dt) % 1;","+    this.shot = !!(cur && cur.photo && !cur.done && this.t > .3);     // the shutter fires once, mid-step","+    if (this.shot) cur.done = true;","     fieldUpdate(dt, this.bot, { cheat: true, silent: true, interacts: [] });","+    this.shot = false;","+    if (!cur) { this.next(); return; }","+    if (cur.walk) { const [x, y] = cellWorld(cur.walk); if (Math.hypot(x - DANA.x, y - DANA.y) < 8) this.next(); }","+    else if (cur.watch) { if (this.t >= cur.s) this.next(); }","+    else if (cur.photo) { if (cur.done) this.next(); }","+    else if (cur.wait) { if (this.t >= cur.wait) this.next(); }","+    this.badge = (this.badge + dt) % 1;","   },","   draw(r) {","     const H = Math.round(r.H * .07);"]},{"oldStart":75,"oldLines":6,"newStart":79,"newLines":6,"lines":["     });","     r.text('DEMO', 10, H + 8, '#ffb347', { shadow: '#000' });","     r.text(this.caption, r.W / 2, r.H - H - 26, '#f2ece0', { align: 'center', shadow: '#000' });","-    if (this.badge < .6) r.text('PRESS ' + prompt(game, 'confirm', 'TO PLAY').toUpperCase(), r.W / 2, r.H - H - 12, '#ffffff', { align: 'center', shadow: '#000' });","+    if (this.badge < .6) r.text('PRESS ' + glyph(game, 'confirm').toUpperCase() + ' TO PLAY', r.W / 2, r.H - H - 12, '#ffffff', { align: 'center', shadow: '#000' });","   },"," };"]}],"originalFile":"// Attract mode (PLAN §10): a bot plays the field, on a script, with captions. It cheats: its watchers never look.\n// Any input returns to the title. Nothing it does is saved (saveState is off while ATTRACT.on).\nconst ATTRACT = {\n  on: false, stashed: null, script: [], i: 0, t: 0, goal: null, caption: '', watchId: null, shot: false, badge: 0,\n  reel: [\n    { name: 'THE CORNER', steps: [\n      { caption: 'The corner keeps its hours. The detail keeps its own.', walk: [36, 26] },\n      { wait: 9 },\n    ] },\n    { name: 'EYES ON', steps: [\n      { caption: 'Take the faces. Read the jobs. Stay unseen.', walk: [36, 31] },\n      { watch: 'tee', s: 1.6 }, { photo: 1 },\n      { watch: 'rook', s: 1.6 }, { photo: 2 },\n      { watch: 'pigeon', s: 1.6 }, { photo: 3 },\n      { wait: 2 },\n    ] },\n  ],\n  vignette: 0,\n  start(g) {\n    this.vignette = 0; this.script = this.reel[0].steps.slice(); this.i = 0; this.t = 0;\n    this.caption = this.reel[0].name; this.watchId = null; this.goal = null;\n    this.bot = {\n      ground: () => {\n        if (!ATTRACT.goal) return [0, 0];\n        const [gx, gy] = ATTRACT.goal;\n        const dx = gx - DANA.x, dy = gy - DANA.y, d = Math.hypot(dx, dy);\n        if (d < 4) return [0, 0];\n        const dir = FLOW ? FLOW.dir(DANA.x, DANA.y, gx, gy) : [dx / d, dy / d];\n        return [dir[0] * .85, dir[1] * .85];\n      },\n      down: a => (a === 'watch' ? !!ATTRACT.watchId : false),\n      pressed: a => a === 'photo' && ATTRACT.shot,\n      reticleAt: () => {\n        const p = ATTRACT.watchId && PEOPLE.find(q => q.id === ATTRACT.watchId);\n        return p ? [p.x, p.y] : null;\n      },\n    };\n    this.advance(g);\n  },\n  advance(g) {\n    const st = this.script[this.i];\n    this.goal = null; this.watchId = null; this.shot = false;\n    if (!st) {                                     // the reel's next vignette, looping\n      this.vignette = (this.vignette + 1) % this.reel.length;\n      this.script = this.reel[this.vignette].steps.slice(); this.i = 0; this.caption = this.reel[this.vignette].name;\n      this.t = 0;\n      if (this.script[0]) this.advance(g);\n      return;\n    }\n    this.i++;\n    if (st.caption) this.caption = st.caption;\n    this.current = st; this.t = 0;\n    if (st.walk) this.goal = cellWorld(st.walk);\n    if (st.watch) this.watchId = st.watch;\n    if (st.photo) { this.shot = true; this.photoPending = true; }\n  },\n  update(dt, g) {\n    const cur = this.current;\n    this.t += dt;\n    if (cur) {\n      if (cur.walk) { const [x, y] = cellWorld(cur.walk); if (Math.hypot(x - DANA.x, y - DANA.y) < 8) this.advance(g); }\n      else if (cur.watch) { if (this.t >= cur.s) this.advance(g); }\n      else if (cur.photo) { this.advance(g); }\n      else if (cur.wait) { if (this.t >= cur.wait) this.advance(g); }\n    }\n    if (this.goal == null && this.script.length && !this.current) this.advance(g);\n    this.badge = (this.badge + dt) % 1;\n    fieldUpdate(dt, this.bot, { cheat: true, silent: true, interacts: [] });\n  },\n  draw(r) {\n    const H = Math.round(r.H * .07);\n    r.overlay(g => {\n      E.px.rect(g, 0, 0, r.W, H, '#000000');\n      E.px.rect(g, 0, r.H - H, r.W, H, '#000000');\n    });\n    r.text('DEMO', 10, H + 8, '#ffb347', { shadow: '#000' });\n    r.text(this.caption, r.W / 2, r.H - H - 26, '#f2ece0', { align: 'center', shadow: '#000' });\n    if (this.badge < .6) r.text('PRESS ' + prompt(game, 'confirm', 'TO PLAY').toUpperCase(), r.W / 2, r.H - H - 12, '#ffffff', { align: 'center', shadow: '#000' });\n  },\n};\n","userModified":false},"tool_result_meta":[{"id":"toolu_01KSDQ9FA4PEcXFMzVoxZhUs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
