watch' && !!ATTRACT.watchId,\n    pressed: a => a === 'photo' && ATTRACT.shot,\n    reticleAt: () => {\n      const p = ATTRACT.watchId && PEOPLE.find(q => q.id === ATTRACT.watchId);\n      return p ? [p.x, p.y] : null;\n    },\n  },\n  start() {\n    this.vignette = 0; this.begin(this.reel[0]);\n  },\n  begin(v) {\n    this.steps = v.steps.map(s => Object.assign({}, s, { done: false }));\n    this.i = 0; this.caption = v.name; this.enter();\n  },\n  enter() {\n    this.t = 0; this.goal = null; this.watchId = null;\n    const st = this.steps[this.i];\n    this.current = st || null;\n    if (!st) return;\n    if (st.caption) this.caption = st.caption;\n    if (st.walk) this.goal = cellWorld(st.walk);\n    if (st.watch) this.watchId = st.watch;\n  },\n  next() {\n    this.i++;\n    if (this.i >= this.steps.length) {                  // the vignette ends: loop the reel\n      this.vignette = (this.vignette + 1) % this.reel.length;\n      this.begin(this.reel[this.vignette]);\n      return;\n    }\n    this.enter();\n  },\n  update(dt) {\n    const cur = this.current;\n    this.t += dt;\n    this.shot = !!(cur && cur.photo && !cur.done && this.t > .3);     // the shutter fires once, mid-step\n    if (this.shot) cur.done = true;\n    fieldUpdate(dt, this.bot, { cheat: true, silent: true, interacts: [] });\n    this.shot = false;\n    if (!cur) { this.next(); return; }\n    if (cur.walk) { const [x, y] = cellWorld(cur.walk); if (Math.hypot(x - DANA.x, y - DANA.y) < 8) this.next(); }\n    else if (cur.watch) { if (this.t >= cur.s) this.next(); }\n    else if (cur.photo) { if (cur.done) this.next(); }\n    else if (cur.wait) { if (this.t >= cur.wait) this.next(); }\n    this.badge = (this.badge + dt) % 1;\n  },\n  draw(r) {\n    const H = Math.round(r.H * .07);\n    r.overlay(g => {\n      E.px.rect(g, 0, 0, r.W, H, '#000000');\n      E.px.rect(g, 0, r.H - H, r.W, H, '#000000');\n    });\n    r.text('DEMO', 10, H + 8, '#ffb347', { shadow: '#000' });\n    r.text(this.caption, r.W / 2, r.H - H - 26, '#f2ece0', { align: 'center', shadow: '#000' });\n    if (this.badge < .6) r.text('PRESS ' + glyph(game, 'confirm').toUpperCase() + ' TO PLAY', r.W / 2, r.H - H - 12, '#ffffff', { align: 'center', shadow: '#000' });\n  },\n};\n","structuredPatch":[{"oldStart":1,"oldLines":71,"newStart":1,"newLines":75,"lines":["-// Attract mode (PLAN §10): a bot plays the field, on a script, with captions. It cheats: its watchers never look.","-// Any input returns to the title. Nothing it does is saved (saveState is off while ATTRACT.on).","+// Attract mode (PLAN §10): a bot plays the field from a script, with captions. It cheats: its watchers never look.","+// Any input returns to the title. Nothing it does is saved (ATTRACT.on blocks saves)."," const ATTRACT = {","-  on: false, stashed: null, script: [], i: 0, t: 0, goal: null, caption: '', watchId: null, shot: false, badge: 0,","+  on: false, stashed: null, steps: [], i: 0, t: 0, goal: null, watchId: null, shot: false, badge: 0, caption: '', current: null,","   reel: [","     { name: 'THE CORNER', steps: [","       { caption: 'The corner keeps its hours. The detail keeps its own.', walk: [36, 26] },","-      { wait: 9 },","+      { wait: 6 },","     ] },","     { name: 'EYES ON', steps: [","       { caption: 'Take the faces. Read the jobs. Stay unseen.', walk: [36, 31] },","-      { watch: 'tee', s: 1.6 }, { photo: 1 },","-      { watch: 'rook', s: 1.6 }, { photo: 2 },","-      { watch: 'pigeon', s: 1.6 }, { photo: 3 },","+      { watch: 'tee', s: 1.6 }, { photo: true },","+      { watch: 'rook', s: 1.6 }, { photo: true },","+      { watch: 'pigeon', s: 1.6 }, { photo: true },","       { wait: 2 },","     ] },","   ],","   vignette: 0,","-  start(g) {","-    this.vignette = 0; this.script = this.reel[0].steps.slice(); this.i = 0; this.t = 0;","-    this.caption = this.reel[0].name; this.watchId = null; this.goal = null;","-    this.bot = {","-      ground: () => {","-        if (!ATTRACT.goal) return [0,