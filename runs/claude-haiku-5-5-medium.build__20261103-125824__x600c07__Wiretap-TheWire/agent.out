                            // must parse back\nwriteFileSync(OUT_JSON, json);\n\nconst gameSrc = `(() => {\\n'use strict';\\nconst CREDITS = ${JSON.stringify(credits.about)};\\n${game}\\n})();`;\nfor (const [name, js] of [['engine', engine], ['game', gameSrc], ['hub client', session]]) {\n  if (/<\\/script/i.test(js)) {\n    // escape the closing tag inside inlined scripts (valid JS in strings, comments and code alike)\n    if (name === 'game') continue;\n  }\n}\nconst esc = js => js.replace(/<\\/script/gi, '<\\\\/script');\nconst html = `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>${esc(session)}</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-4\">\n<title>WIRETAP</title>\n<style>\n${css}\n</style>\n</head>\n<body>\n<canvas id=\"screen\"></canvas>\n<div id=\"ui\"></div>\n<script>${esc(engine)}</script>\n<script>${esc(gameSrc)}</script>\n</body>\n</html>\n`;\nif (/<\\/script/i.test(html.replace(/<\\\\\\/script/gi, ''))) throw new Error('an unescaped </script remains');\nwriteFileSync(OUT_HTML, html);\nconsole.log(`wrote ${OUT_HTML} (${(html.length / 1e6).toFixed(2)} MB)`);\nconsole.log(`wrote ${OUT_JSON} (parsed back OK)`);\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01EmzAJJ5DbevSBSS1yd7qse","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
