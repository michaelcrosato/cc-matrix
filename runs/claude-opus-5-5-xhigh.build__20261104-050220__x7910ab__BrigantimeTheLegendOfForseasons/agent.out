 return { sp, w, x, y: 44, hx: x, hy: 44, facing: -Math.PI / 2 + (i < a.length / 2 ? .8 : -.8), pose: null, expr: null, emote: null, et: 0 }; });\"\nassert s.count(old)==1; s=s.replace(old,new)\nold=\"      if (c) { c.y = c.hy + 8; c.pose = l.opts.pose || null; c.expr = l.opts.expr || null; if (l.opts.emote) { c.emote = l.opts.emote; c.et = 0; } const other = EVS.cast.find(o => o !== c); if (other) c.facing = other.x > c.x ? 0 : Math.PI; EVS.focus = [c.x, 40]; }\"\nnew=\"      if (c) { c.y = c.hy - 6; c.pose = l.opts.pose || null; c.expr = l.opts.expr || null; if (l.opts.emote) { c.emote = l.opts.emote; c.et = 0; } const others = EVS.cast.filter(o => o !== c), mx = others.length ? G.sum(others, o => o.x) / others.length : c.x; c.facing = -Math.PI / 2 + (mx > c.x ? .9 : -.9); EVS.focus = [c.x * .5 + 70, 40]; }\"\nassert s.count(old)==1; s=s.replace(old,new)\ns=s.replace(\"G.SCENES.event = {\\n  pausable: true, view: 'brawler', input: G.PRESET, camera: { zoom: [1, 1.6], start: 1.25 },\",\"G.SCENES.event = {\\n  pausable: true, view: 'brawler', input: G.PRESET, camera: { zoom: [1, 1.6], start: 1.15 },\")\nold=\"  G.UI.prompts(r, [['confirm', 'Next'], ['info', 'Backlog'], ['cancel', 'Hold: Skip']]);\\n};\"\nnew=\"  G.UI.prompts(r, [['confirm', 'Next'], ['info', 'Backlog'], ['cancel', 'Hold: Skip']], { y: r.H - 70 * G.UI.k() });\\n};\"\nassert s.count(old)==1; s=s.replace(old,new)\nopen(p,'w').write(s)\n\np='src/66-scene-about.js'; s=open(p).read()\nold=\"const k = AU.k(), W = r.W, H = r.H, w = Math.min(W - 24, 380), x = Math.round((W - w) / 2), top = pg.scene ? Math.round(H * .46) : 34;\"\nnew=\"const k = AU.k(), W = r.W, H = r.H, w = Math.min(W - 24, 400), x = Math.round((W - w) / 2), top = pg.scene ? Math.round(H * .4) : 34;\"\nassert s.count(old)==1; s=s.replace(old,new)\ns=s.replace(\"        AU.text(g, (S.p + 1) + ' / ' + S.pages.length, W / 2, H - 22 * k, AU.COL.dim, { align: 'center' });\",\"        AU.text(g, (S.p + 1) + ' / ' + S.pages.length, x + w - 6, top + 