 }, o)); } catch (e) { G.game.fail('sting', e); } };\nG.layer = (name, vol, fade = .8) => { const a = G.game && G.game.audio; if (a && a.layer) try { a.layer(name, vol, fade); } catch (e) { /* the song has no such layer */ } };\n"}}}
