{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cghx7W5njNz9B9hsgCTck","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015Eu9W8eeVtm8XL2vE5uMLY","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050220__x7910ab/work/BrigantimeTheLegendOfForseasons-BrigandineTheLegendOfForsena-claude-opus-5-5-xhigh-20261104-050220/tests/run.mjs","content":"// The one test command: node tests/run.mjs [suite ...] [--browser]\n// Prints only failures (\"suite › test: message\") and one final line: \"N passed, M failed (S suites, T s)\". Exit 1 on failure.\n// Node suites load engine/my-3d2dge.js, engine-ext/beasts.js and dist/game.js into a vm context and drive the game with\n// game.advance, input.tap / hold / feed and game.debug. --browser adds the Playwright suites (bundle, hub).\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\nimport { join, dirname } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst DEV = join(dirname(fileURLToPath(import.meta.url)), '..');\nconst argv = process.argv.slice(2), browser = argv.includes('--browser'), only = argv.filter(a => !a.startsWith('--'));\nconst scripts = ['engine/my-3d2dge.js', 'engine-ext/beasts.js', 'dist/game.js'].map(f => new vm.Script(readFileSync(join(DEV, f), 'utf8'), { filename: f }));\n/** a fresh game: { E, G, game, I, snap, step(s), tap(a), hold(a, s) } */\nexport async function boot(hash = '#title', o = {}) {\n  const store = {}, ctx = { console: { log() {}, info() {}, warn() {}, error() {} }, addEventListener() {}, removeEventListener() {}, location: { hash, search: '' } };\n  ctx.window = ctx; ctx.localStorage = { getItem: k => (k in store ? store[k] : null), setItem: (k, v) => { store[k] = String(v); }, removeItem: k => { delete store[k]; } };\n  if (o.ctx) Object.assign(ctx, o.ctx);\n  vm.createContext(ctx);\n  if (o.before) o.before(ctx);\n  for (const s of scripts) s.runInContext(ctx);\n  const E = ctx.My3D2dge, game = E.current, G = ctx.BRIG, I = game.input;\n  await game.booted;\n  const h = { E, G, game, I, ctx, store,\n    snap: () => game.debug.snapshot(),\n    step: (s = .1) => game.advance(s),\n    tap: (a, n = 1) => { for (let i = 0; i < n; i++) { I.tap(a); game.advance(.06); } },\n    hold: (a, s) => { I.hold(a, true); game.advance(s); I.hold(a, false); game.advance(.05); },\n    errors: () => game.errors.map(e => e.message || String(e))\n  };\n  return h;\n}\nconst suites = {};\nexport const suite = (name, fn) => { suites[name] = fn; };\nconst failures = []; let passed = 0, failed = 0;\nconst assert = (suiteName) => {\n  const t = async (name, fn) => {\n    try { const r = await fn(); if (r === false) throw new Error('returned false'); passed++; }\n    catch (e) { failed++; failures.push(`${suiteName} › ${name}: ${String(e && e.message || e).slice(0, 400)}`); }\n  };\n  return t;\n};\nexport const ok = (v, msg) => { if (!v) throw new Error(msg || 'not ok'); };\nexport const eq = (a, b, msg) => { if (a !== b) throw new Error((msg ? msg + ': ' : '') + JSON.stringify(a) + ' !== ' + JSON.stringify(b)); };\n\nconst t0 = Date.now();\nconst files = readdirSync(join(DEV, 'tests')).filter(f => /^t-.*\\.mjs$/.test(f)).sort();\nfor (const f of files) await import(pathToFileURL(join(DEV, 'tests', f)).href);\nconst names = Object.keys(suites).filter(n => (only.length ? only.includes(n) : true) && (browser || !n.startsWith('browser:')));\nfor (const n of names) {\n  try { await suites[n](assert(n)); }\n  catch (e) { failed++; failures.push(`${n} › (suite crashed): ${String(e && e.stack || e).split('\\n').slice(0, 3).join(' | ')}`); }\n}\nfor (const f of failures) console.log(f);\nconsole.log(`${passed} passed, ${failed} failed (${names.length} suites, ${((Date.now() - t0) / 1000).toFixed(1)} s)`);\nprocess.exit(failed ? 1 : 0);\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3098,"cache_read_input_tokens":805994,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3098},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0be74ee3-a3fa-4a1d-ada4-50a1716096a9","uuid":"83ee433e-35db-4ac8-a591-ecf07403510a","timestamp":"2026-11-04T13:16:44.403Z","request_id":"req_011Cghx7ViTqqHJwbR3xjJGR","wire_tool_inputs":{"toolu_015Eu9W8eeVtm8XL2vE5uMLY":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050220__x7910ab/work/BrigantimeTheLegendOfForseasons-BrigandineTheLegendOfForsena-claude-opus-5-5-xhigh-20261104-050220/tests/run.mjs","content":"// The one test command: node tests/run.mjs [suite ...] [--browser]\n// Prints only failures (\"suite › test: message\") and one final line: \"N passed, M failed (S suites, T s)\". Exit 1 on failure.\n// Node suites load engine/my-3d2dge.js, engine-ext/beasts.js and dist/game.js into a vm context and drive the game with\n// game.advance, input.tap / hold / feed and game.debug. --browser adds the Playwright suites (bundle, hub).\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\nimport { join, dirname } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst DEV = join(dirname(fileURLToPath(import.meta.url)), '..');\nconst argv = process.argv.slice(2), browser = argv.includes('--browser'), only = argv.filter(a => !a.startsWith('--'));\nconst scripts = ['engine/my-3d2dge.js', 'engine-ext/beasts.js', 'dist/game.js'].map(f => new vm.Script(readFileSync(join(DEV, f), 'utf8'), { filename: f }));\n/** a fresh game: { E, G, game, I, snap, step(s), tap(a), hold(a, s) } */\nexport async function boot(hash = '#title', o = {}) {\n  const store = {}, ctx = { console: { log() {}, info() {}, warn() {}, error() {} }, addEventListener() {}, removeEventListener() {}, location: { hash, search: '' } };\n  ctx.window = ctx; ctx.localStorage = { getItem: k => (k in store ? store[k] : null), setItem: (k, v) => { store[k] = String(v); }, removeItem: k => { delete store[k]; } };\n  if (o.ctx) Object.assign(ctx, o.ctx);\n  vm.createContext(ctx);\n  if (o.before) o.before(ctx);\n  for (const s of scripts) s.runInContext(ctx);\n  const E = ctx.My3D2dge, game = E.current, G = ctx.BRIG, I = game.input;\n  await game.booted;\n  const h = { E, G, game, I, ctx, store,\n    snap: () => game.debug.snapshot(),\n    step: (s = .1) => game.advance(s),\n    tap: (a, n = 1) => { for (let i = 0; i < n; i++) { I.tap(a); game.advance(.06); } },\n    hold: (a, s) => { I.hold(a, true); game.advance(s); I.hold(a, false); game.advance(.05); },\n    errors: () => game.errors.map(e => e.message || String(e))\n  };\n  return h;\n}\nconst suites = {};\nexport const suite = (name, fn) => { suites[name] = fn; };\nconst failures = []; let passed = 0, failed = 0;\nconst assert = (suiteName) => {\n  const t = async (name, fn) => {\n    try { const r = await fn(); if (r === false) throw new Error('returned false'); passed++; }\n    catch (e) { failed++; failures.push(`${suiteName} › ${name}: ${String(e && e.message || e).slice(0, 400)}`); }\n  };\n  return t;\n};\nexport const ok = (v, msg) => { if (!v) throw new Error(msg || 'not ok'); };\nexport const eq = (a, b, msg) => { if (a !== b) throw new Error((msg ? msg + ': ' : '') + JSON.stringify(a) + ' !== ' + JSON.stringify(b)); };\n\nconst t0 = Date.now();\nconst files = readdirSync(join(DEV, 'tests')).filter(f => /^t-.*\\.mjs$/.test(f)).sort();\nfor (const f of files) await import(pathToFileURL(join(DEV, 'tests', f)).href);\nconst names = Object.keys(suites).filter(n => (only.length ? only.includes(n) : true) && (browser || !n.startsWith('browser:')));\nfor (const n of names) {\n  try { await suites[n](assert(n)); }\n  catch (e) { failed++; failures.push(`${n} › (suite crashed): ${String(e && e.stack || e).split('\\n').slice(0, 3).join(' | ')}`); }\n}\nfor (const f of failures) console.log(f);\nconsole.log(`${passed} passed, ${failed} failed (${names.length} suites, ${((Date.now() - t0) / 1000).toFixed(1)} s)`);\nprocess.exit(failed ? 1 : 0);\n"}}}
