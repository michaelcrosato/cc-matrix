touchidle=title;;wait:12000;;check:[BRIG.In.touchOnly,My3D2dge.current.sceneName]', '--touch');\n    eq(JSON.stringify(a.checks[0]), JSON.stringify([true, 'attract']), 'attract after 10 s on a phone');\n  });\n});\nsuite('browser:hub', async t => {\"\"\"\nassert s.count(a)==1; s=s.replace(a,b); open(p,'w').write(s)\nEOF\ngrep -n \"browser\" tests/run.mjs | head -5","description":"Add menu-idle attract and browser input tests"}},"wire_ingest_context":{"toolu_01YKbMLjN3BUG1co9iN2rWej":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050220__x7910ab/work/BrigantimeTheLegendOfForseasons-BrigandineTheLegendOfForsena-claude-opus-5-5-xhigh-20261104-050220"}}}
