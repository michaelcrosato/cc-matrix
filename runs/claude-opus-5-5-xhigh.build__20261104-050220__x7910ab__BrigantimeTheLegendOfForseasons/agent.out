 { name: 'Autumn Acorn', slot: 'promotion', elem: 'autumn', icon: 'acorn', desc: 'Promotes an Autumn monster (T2 from Lv 6, T3 from Lv 16)' });\nI('wintershard', { name: 'Winter Shard', slot: 'promotion', elem: 'winter', icon: 'shard', desc: 'Promotes a Winter monster (T2 from Lv 6, T3 from Lv 16)' });\nI('writ', { name: 'Writ of Knighthood', slot: 'special', icon: 'scroll', desc: 'Allows a tier-3 class change from Lv 20' });\n\nG.SEASON_SEED = { spring: 'springseed', summer: 'summerember', autumn: 'autumnacorn', winter: 'wintershard' };\n/** may a knight of this class equip the item? */\nG.canEquip = (item, cls) => {\n  const it = G.get('item', item), c = G.get('class', cls);\n  if (!['weapon', 'armor', 'accessory'].includes(it.slot)) return false;\n  if (it.who.includes('all') || it.who.includes(cls) || it.who.includes(c.line)) return true;\n  if (c.line === 'ruler' && it.who.includes('ruler')) return it.slot !== 'weapon' || !it.kind || c.weapons.includes(it.kind);\n  if ((c.line === 'unique' || c.line === 'ruler') && it.slot === 'weapon') return c.weapons.includes(it.kind) && !it.who.every(w => G.LINES[w]);\n  return false;\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01WNooJZbr8FEPPMUZVBQcFz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
