ayer=id;\\\", \\\"wheel(id){this.menuOwner=id;this.wheelPlayer=id;\\\")\ns=s.replace(\\\"\"'${primary?'\"'PRIMARY CONFIRMED':ready?'RELEASE WINDOW':'IMPACT OFFSET '+Math.round(dist)+' M'}\\\", \\\"\"'${primary?'\"'PRIMARY CONFIRMED':s.sightDamaged?'COARSE IMPACT REFERENCE':ready?'RELEASE WINDOW':'IMPACT OFFSET '+Math.round(dist)+' M'}\\\")\ns=s.replace(\\\"else if(threat)context.push([\"'`GUN\", \"else if(threat&&s.mounts[p?.station])context.push(['\"'FIRE BURST','fire']);else if(threat)context.push([\"'`GUN\")\ns=s.replace(\"b.onpointerdown=(ev)=>{\", \"b.onpointerdown=(ev)=>{\")\n# The current UI uses delegated activation; add fire holds independently after binding.\ns=s.replace(\"const cv=$('\"'#crew-portrait',this.hud);\\\", \\\"\\\"\\\"this.hud.querySelectorAll('[data-context=fire]').forEach(b=>{b.onpointerdown=e=>{e.preventDefault();this.touch.fire=true;b.setPointerCapture?.(e.pointerId);};b.onpointerup=b.onpointercancel=()=>this.touch.fire=false;});\n const cv=\"'$('\"'#crew-portrait',this.hud);\\\"\\\"\\\")\n# Native pointer handlers rebuilt every HUD tick need an independent lift on window in app too.\ninsert=\\\"\\\"\\\"emergency(){this.menuOwner=this.game.pausedBy||this.menuOwner||1;this.show('emergency',{kicker:'ENGINEER / COMMAND AUTHORITY',title:'One aircraft. One chance.',text:'The fire bottle is single-use. Jettison permanently discards remaining bombs and improves return performance.',actions:[['Extinguish engine fire',()=>{this.send({type:'extinguish'},this.menuOwner);this.shell.toast('ENGINEER',this.sim.state.aircraft.fire?'Bottle unavailable.':'Fire checked.');}],['Back',()=>this.shell.back()]]});const b=document.createElement('button');b.textContent='Hold 1.5 seconds to jettison payload';b.dataset.holdJettison='true';let timer;const start=e=>{e.preventDefault();clearTimeout(timer);b.textContent='HOLD… PAYLOAD WILL BE LOST';timer=setTimeout(()=>{this.send({type:'jettison',held:1.5},this.menuOwner);b.textContent='PAYLOAD JETTISONED';},1500);};const stop=()=>{clearTimeout(timer);if(this.sim.state.bombsLeft)b.textContent='Hold 1.5 seconds to jettison payload';};b.onpointerdown=start;b.onpointerup=b.onpointercancel=stop;b.onkeydown=e=>{if(\"'!e.repeat&&(e.code==='\"'Space'||e.code==='Enter'))start(e);};b.onkeyup=stop;b.onblur=stop;\"'$('\"'.esh-btns',this.shell.root).prepend(b);}\n \\\"\\\"\\\"\ns=s.replace(\\\"leaveMenu(){\\\",insert+\\\"leaveMenu(){\\\")\nopen(p,'w').write(s)\nPY\ncat >> src/style.css <<'EOF'\n/* Native shell buttons inherit TV-sized type; the source theme fixes them at 13px. */\n.esh button{font-family:Arial,Helvetica,sans-serif\"'!important;font-size:.82em!important}.esh h1{font-size:clamp(54px,5.4vw,104px)!important;letter-spacing:-.015em!important}.esh .esh-ttl .esh-btns{max-width:22em}.esh .esh-ttl>div{width:min(49vw,940px)}.esh .esh-ttl .esh-btns button{min-height:2.6em!important}.esh .esh-btns .pri{font-size:.86em!important}.esh .esh-ttl .esh-sub{font-style:normal!important}.esh .brief-copy{font-size:.75em}.esh .esh-btns button:disabled{opacity:.4}.esh .credit-content button{font-size:.7em!important}\n@media(max-width:800px){.esh h1{font-size:clamp(48px,11vw,86px)!important}.esh .esh-ttl>div{width:100%}.esh .esh-ttl .esh-btns button{font-size:.85em!important}}\nEOF\nnode --check src/app.js && node --check src/ui.js && npm run build'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
