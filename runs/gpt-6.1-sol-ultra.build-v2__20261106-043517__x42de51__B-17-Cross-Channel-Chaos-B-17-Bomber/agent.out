ircraft.holdYaw=a.yaw;this.say('bombardier','Target astern. Map: another pass, refinery, or home.',true);}\n  if(s.route.target==='home'&&s.phase\"'!=='\"'landing'&&Math.hypot(a.x,a.y)<15000&&s.t>25){s.phase='landing';s.landingT=0;s.aircraft.hold=true;this.emit('recovery');this.say('pilot','Rookfield in sight. Ground crew has us. Welcome home.');}\n  if(s.phase==='return'&&\"'!this.encounterSet.has('\"'return-tail')&&a.x<245000&&a.x>180000){this.encounterSet.add('return-tail');this.spawnFighter('tail','pursuit');}\n  if(s.phase==='landing'){s.landingT+=dt;a.gear=Math.min(1,a.gear+dt*.4);a.bank*=Math.max(0,1-dt*3);a.pitch=-.035;a.z=Math.max(80,a.z-dt*260);if(s.landingT>12){s.returned=true;this.result(s.primary?'success':'abort');}}\n  const remaining=a.fuel/Math.max(.1,(.6+a.throttle*.55)*this.balance.fuelConsumption),homeTime=Math.hypot(a.x,a.y)/Math.max(a.speed,700)+45;s.reserve=Math.max(0,remaining-homeTime);s.warning=a.fire?'ENGINE FIRE · EXTINGUISH':a.stall?'STALL · ADD POWER':a.fuel/a.maxFuel<.25?'LOW FUEL · RETURN':s.flak.some(f=>\"'!f.burst)?'\"'FLAK · CHANGE COURSE':s.enemies.some(e=>e.alive&&e.phase==='attack')?'FIGHTERS ATTACKING':null;\n }\n result(reason='timeup'){const s=this.state;if(s.result)return s.result;const a=s.aircraft,success=s.primary&&s.returned,outcome=success?'MISSION COMPLETE':s.returned?'CREW RECOVERED':s.primary?'PRIMARY DESTROYED':'SORTIE ENDED';const damage=Math.round((100-a.hull)*4),accuracy=s.bombsDropped?Math.round(s.missionHits/s.bombsDropped*100):0,returnBonus=s.returned?1500:0,penalty=s.wasted*75,total=Math.max(0,s.score+returnBonus+Math.round(accuracy*3)-damage-penalty);s.result={reason,outcome,win:success,score:total,stats:{primary:s.primary,returned:s.returned,kills:s.kills,bombs:s.bombsDropped,hits:s.missionHits,accuracy,damagePenalty:damage,wastedPenalty:penalty,returnBonus,fuel:Math.round(a.fuel/a.maxFuel*100),duration:Math.round(s.t)},cheated:s.cheated,practice:s.practice};s.phase='debrief';s.shots=[];s.enemies=[];this.em