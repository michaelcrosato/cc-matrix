);if(e.t>18&&Math.floor(s.t*5)%3===0)demoSim.hitFighter(e,.1);}else if(s.players[0].station\"'!=='\"'pilot')demoSim.command(id,{type:'station',station:'pilot'});}\n if(s.flak.some(f=>\"'!f.burst)&&Math.floor(s.t)%8<3)a.z+=dt*100;\n demoSim.step(dt);\n}\nfunction inputStep(dt){if(!ready)return;const rawPads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean);for(const pad of rawPads){if(pad.connected===false)continue;const deliberate=pad.buttons.some(b=>b.pressed||b.value>.5)||pad.axes.some(v=>Math.abs(v)>.28);if(deliberate){if(attract){exitAttract();return;}activity();}}\n if(game.paused!==lastPaused){lastPaused=game.paused;clearActions();sound.pause(game.paused&&!online.active);}\n if(attract)return;\n if(game.sceneName==='\"'title'){if(ui.shell.screen==='title'&&game.real-idleAt>=10)enterAttract();return;}\n if(game.sceneName\"'!=='\"'play'||sim.state.result||online.ended)return;\n if(game.paused||ui.shell.screen){for(const p of localPlayers())send({type:'controls'},p.id);return;}\n const pp=localPlayers();for(let index=0;index<pp.length;index++){\n  const p=pp[index],I=online.active?game.input:game.players[index]||game.input,m=I.move(),isGun=BEARINGS[p.station]\"'!==undefined;\n  if(I.anyPressed())activity();p.input=I.lastDevice;\n  if(I.pressed('\"'wheel')){clearActions();ui.wheel(p.id);return;}\n  if(I.pressed('map')){clearActions();ui.preview=sim.state.primary?'home':'harbor';ui.map();return;}\n  if(I.pressed('pilot')){send({type:'station',station:'pilot'},p.id);fireLocked[p.id]=true;}\n  if(I.pressed('guns')){send({type:'station',station:sim.state.enemies.find(e=>e.alive)?.bearing||'nose'},p.id);fireLocked[p.id]=true;}\n  if(I.pressed('bombs')){send({type:'station',station:'bombs'},p.id);fireLocked[p.id]=true;}\n  if(isGun)for(const station of Object.keys(BEARINGS))if(I.pressed(station)){send({type:'station',station},p.id);fireLocked[p.id]=true;}\n  if(I.pressed('hold'))send({type:'hold'},p.id);if(I.pressed('extinguish'))send({type:'extinguish'},p.id);\n  jettisonHold[p.id]=I.down('jettison')?(jettisonHold[p.id]||0)+dt:0;if(jettisonHold[p.id]>1.5){send({type:'jettison',held:jettisonHold[p.id]},p.id);jettisonHold[p.id]=-100;ui.shell.toast('PAYLOAD JETTISONED','Return performance improved. Ordnance is gone.',3);}\n  const sight=p.station==='bombs';if(sight&&I.pressed('doors'))send({type:'doors'},p.id);if(sight&&I.pressed('salvo'))send({type:'salvo',salvo:[1,2,4][([1,2,4].indexOf(sim.state.salvo)+1)%3]},p.id);\n  if(\"'!I.down('\"'fire'))fireLocked[p.id]=false;const canFire=\"'!fireLocked[p.id]&&game.real>blockUntil;\n  if(sight&&I.pressed('\"'fire')&&canFire)send({type:'release',salvo:sim.state.salvo},p.id);\n  const sens=game.settings.aimSensitivity;let ax=(I.value('aimRight')-I.value('aimLeft'))*sens,ay=(I.value('aimDown')-I.value('aimUp'))*sens;\n  if(isGun&&I.lastDevice\"'!=='\"'gamepad'){ax+=m[0]*sens;ay+=m[1]*sens;}\n  if(touch.active&&index===0){ax+=touch.right[0]*sens;ay+=touch.right[1]*sens;}\n  if(I.lastDevice==='mouse'&&I.pointer()&&(isGun||p.station==='pilot')){const pos=I.pointer(),vp=game.viewports[index],W=vp?.w||game.W,H=vp?.h||game.H,x=pos[0]-(vp?.x||0),y=pos[1]-(vp?.y||0);send({type:'aim',yaw:clamp((x/W-.5)*1.25,-.83,.83),pitch:clamp((.5-y/H)*.85,-.48,.65)},p.id);}\n  p.zoom=I.down('zoom');let bank=m[0],pitch=-m[1];if(touch.active&&index===0){bank=touch.left[0];pitch=-touch.left[1];if(Math.abs(bank)+Math.abs(pitch)<.12&&sim.state.aircraft.holdMode==='route')sim.state.aircraft.hold=true;}\n  send({type:'controls',bank:p.station==='pilot'?bank:0,pitch:p.station==='pilot'?pitch*(game.settings.invertFlight?-1:1):0,throttleDelta:p.station==='pilot'?Number(I.down('throttleUp'))-Number(I.down('throttleDown')):0,aimX:ax,aimY:ay*(game.settings.invertY?-1:1),fire:isGun&&I.down('fire')&&canFire,zoom:I.down('zoom')},p.id);\n }\n}\nfunction fixed(dt){if(attract){for(let i=0;i<10;i++)demoBot(dt);const ds=demoSim.state;ds.aircraft.shake=0;view.update(dt,ds);sound.update(dt,ds,{active:true});return;}\n if(game.sceneName==='title'){sim.state.t+=dt;sim.state.aircraft.x+=Math.cos(sim.state.aircraft.yaw)*sim.state.aircraft.speed*dt;sim.state.aircraft.y+=Math.sin(sim.state.aircraft.yaw)*sim.state.aircraft.speed*dt;view.update(dt,sim.state);return;}\n if(game.sceneName==='play'){\n  if(\"'!online.active&&!ui.dev.paused)sim.step(dt);\n  if(sim.state.result&&!online.active&&!resultShown){resultShown=true;sound.stop();ui.results();}\n  view.update(dt,sim.state);sound.update(dt,sim.state,{active:!online.server&&!online.ended&&(!online.active||online.playing),paused:game.paused&&!online.active});\n }\n}\nfunction draw(r){if(!ready||online.server)return;const state=attract?demoSim.state:sim.state,players=online.active?localPlayers():state.players;view.draw(r,state,players,{exterior:game.sceneName==='\"'title'&&(\"'!attract||state.t<30||state.phase==='\"'landing'),title:game.sceneName==='title'&&\"'!attract,freeCamera:ui.dev.freeCamera,debug:ui.dev.debug});if(!r.viewport||r.viewport.i===0)ui.paint(1/60);}\nfunction setupTouch(){const cv=game.screen.canvas;cv.addEventListener('\"'pointerdown',e=>{if(e.pointerType\"'!=='\"'touch'||ui.shell.screen||game.sceneName\"'!=='\"'play')return;touch.active=true;const side=e.clientX<innerWidth*.5?'left':'right';touch.fingers.set(e.pointerId,{x:e.clientX,y:e.clientY,side});cv.setPointerCapture?.(e.pointerId);e.preventDefault();},{passive:false});cv.addEventListener('pointermove',e=>{const f=touch.fingers.get(e.pointerId);if(\"'!f)return;touch[f.side]=[clamp((e.clientX-f.x)/85,-1,1),clamp((e.clientY-f.y)/85,-1,1)];e.preventDefault();},{passive:false});const lift=e=>{const f=touch.fingers.get(e.pointerId);if(f){touch[f.side]=[0,0];touch.fingers.delete(e.pointerId);}};cv.addEventListener('\"'pointerup',lift);cv.addEventListener('pointercancel',lift);game.input.touchButtons([]);game.input.touchFilter=()=>false;}\nfunction detectDevices(){addEventListener('gamepaddisconnected',e=>{clearActions();if(\"'!online.active&&sim.state.players.length>1){const index