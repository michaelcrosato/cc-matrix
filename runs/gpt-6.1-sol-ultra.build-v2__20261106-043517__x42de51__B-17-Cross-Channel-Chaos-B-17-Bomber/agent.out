,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"running\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 14\n          }\n        }\n      ]\n    }\n  },\n  {\n    \"scenario\": \"guest-leave\",\n    \"pass\": true,\n    \"seconds\": 15.68,\n    \"checks\": 13,\n    \"observations\": {\n      \"departureReturnedDutiesToAI\": true,\n      \"terminal\": [\n        {\n          \"title\": \"Red Fox\",\n          \"ended\": true,\n          \"host\": true,\n          \"adapter\": {\n            \"sent\": 28,\n            \"received\": 27,\n            \"maxPacket\": 3124,\n            \"finishes\": 1,\n            \"accepted\": 12,\n            \"rejected\": 0\n          },\n          \"audio\": {\n            \"unlocked\": true,\n            \"running\": false,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"running\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 13\n          }\n        }\n      ]\n    }\n  },\n  {\n    \"scenario\": \"host-leave\",\n    \"pass\": true,\n    \"seconds\": 13.02,\n    \"checks\": 13,\n    \"observations\": {\n      \"terminal\": [\n        {\n          \"title\": \"Blue Otter\",\n          \"ended\": true,\n          \"host\": false,\n          \"adapter\": {\n            \"sent\": 15,\n            \"received\": 13,\n            \"maxPacket\": 284,\n            \"finishes\": 0,\n            \"accepted\": 0,\n            \"rejected\": 0\n          },\n          \"audio\": {\n            \"unlocked\": true,\n            \"running\": false,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"running\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 6\n          }\n        }\n      ]\n    }\n  },\n  {\n    \"scenario\": \"server\",\n    \"pass\": true,\n    \"seconds\": 14.8,\n    \"checks\": 14,\n    \"observations\": {\n      \"terminal\": [\n        {\n          \"title\": \"Red Fox\",\n          \"ended\": true,\n          \"host\": false,\n          \"adapter\": {\n            \"sent\": 45,\n            \"received\": 44,\n            \"maxPacket\": 138,\n            \"finishes\": 0,\n            \"accepted\": 0,\n            \"rejected\": 0\n          },\n          \"audio\": {\n            \"unlocked\": true,\n            \"running\": false,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"running\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 13\n          }\n        },\n        {\n          \"title\": \"Blue Otter\",\n          \"ended\": true,\n          \"host\": false,\n          \"adapter\": {\n            \"sent\": 45,\n            \"received\": 44,\n            \"maxPacket\": 284,\n            \"finishes\": 0,\n            \"accepted\": 0,\n            \"rejected\": 0\n          },\n          \"audio\": {\n            \"unlocked\": true,\n            \"running\": false,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"running\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 13\n          }\n        },\n        {\n          \"title\": \"Server\",\n          \"ended\": true,\n          \"host\": true,\n          \"adapter\": {\n            \"sent\": 44,\n            \"received\": 88,\n            \"maxPacket\": 3113,\n            \"finishes\": 1,\n            \"accepted\": 14,\n            \"rejected\": 0\n          },\n          \"audio\": {\n            \"unlocked\": false,\n            \"running\": false,\n            \"paused\": false,\n            \"disposed\": false,\n            \"context\": \"locked\",\n            \"activeSources\": 0,\n            \"musicVolume\": 0.1,\n            \"sfxVolume\": 1,\n            \"voiceVolume\": 0.7,\n            \"musicPlaying\": false,\n            \"motif\": null,\n            \"rms\": 0,\n            \"peak\": 0,\n            \"lastEvent\": 0\n          }\n        }\n      ]\n    }\n  }\n]\n\"\"\"Public-UI/input verification of the actual portable HTML. No simulation shortcuts.\nThe root verifier invokes this script; all detailed evidence stays in tests/browser-result.json.\n\"\"\"\nfrom pathlib import Path\nimport json, re, shutil, traceback\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nIDENTITY=json.loads((ROOT/'identity.json').read_text())\nARTIFACT=ROOT.parent/(IDENTITY['slug']+'.html')\nOUT=ROOT/'tests/browser-evidence'\nOUT.mkdir(exist_ok=True)\nRESULT={'cases':[], 'assertions':0,'failures':[], 'limitations':[]}\nPAD_STUB=\"\"\"window.__pads=[];Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads,configurable:true});window.__makePad=(index=0)=>({id:'DualSense Wireless Controller (test stub)',index,connected:true,mapping:'standard',timestamp:1,axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0})),vibrationActuator:null});\"\"\"\n\ndef check(ok,message):\n    RESULT['assertions']+=1\n    if not ok:raise AssertionError(message)\n\ndef advance(page,seconds=.1,draw=True):\n    return page.evaluate('([seconds,draw])=>game.advance(seconds,{draw})',[seconds,draw])\n\ndef key(page,code,seconds=.08):\n    page.keyboard.down(code);advance(page,seconds);page.keyboard.up(code);advance(page,.05)\n\ndef pad(page,index,button,seconds=.06):\n    page.evaluate('([i,b])=>{__pads[i].buttons[b]={pressed:true,touched:true,value:1};__pads[i].timestamp++}',[index,button])\n    advance(page,seconds)\n    page.evaluate('([i,b])=>{__pads[i].buttons[b]={pressed:false,touched:false,value:0};__pads[i].timestamp++}',[index,button])\n    advance(page,.05)\n\ndef click(page,name):\n    page.get_by_role('button',name=name,exact=True).click()\n    advance(page,.12)\n\ndef state(page):return page.evaluate('__bomber.sim.snapshot()')\n\ndef open_game(browser,**options):\n    context=browser.new_context(viewport={'width':1920,'height':1080},**options)\n    context.add_init_script(PAD_STUB)\n    page=context.new_page();errors=[];requests=[]\n    page.on('pageerror',lambda e:errors.append(str(e)))\n    page.on('console',lambda m:errors.append(m.text) if m.type=='error' else None)\n    page.on('requestfailed',lambda r:requests.append({'url':r.url,'failure':r.failure}))\n    page.goto(ARTIFACT.as_uri()+'?backend=webgl',wait_until='load')\n    page.wait_for_function('window.__bomber?.ready || window.__bomber?.error',timeout=90000)\n    check(page.evaluate('__bomber.ready'),'Packaged game booted')\n    page.wait_for_function('game.sceneName===\"title\"',timeout=15000)\n    page.wait_for_timeout(350);page.evaluate('game.stop()');advance(page,.15)\n    return context,page,errors,requests\n\ndef launch(page):\n    click(page,'Fly a sortie');click(page,'Launch sortie');advance(page,.4)\n    check(page.evaluate('game.sceneName')=='play','Public launch enters flight')\n\ndef no_errors(page,errors,requests):\n    check(not errors,'No browser errors: '+str(errors[:2]))\n    check(not page.evaluate('game.errors'),'No engine errors')\n    check(not requests,'No missing asset/dependency requests')\n\ndef run(name,fn):\n    try:\n        info=fn() or {};RESULT['cases'].append({'name':name,'pass':True,**info})\n    except Exception as exc:\n        text=f'{name}: {type(exc).__name__}: {exc}'\n        RESULT['failures'].append(text);RESULT['cases'].append({'name':name,'pass':False,'trace':traceback.format_exc()})\n        print('FAIL '+text)\n\n\ndef menus(browser):\n","exit_code":0,"status":"completed"}}
