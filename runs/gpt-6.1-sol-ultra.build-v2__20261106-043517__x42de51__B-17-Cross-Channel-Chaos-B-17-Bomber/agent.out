{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js'\ns=open(p).read().replace(\\\"if(\"'!p||!STATIONS.includes(station))return false;const other\", \"if(!p||!STATIONS.includes(station))return false;if(p.station===station)return true;const other\")\ns=s.replace(\"q.station=p.station;s.owners[p.station]=other;\", \"q.station=p.station;s.owners[p.station]=other;if(q.station==='\"'pilot')s.commandOwner=other;\\\")\ns=s.replace(\\\"const battery=s.targets.find(t=>t.id==='battery'),near=a.x>240000&&a.x<390000&&s.phase\"'!=='\"'landing';\\\", \\\"const battery=s.targets.find(t=>t.id==='battery'),near=a.x>240000&&a.x<390000&&s.phase\"'!=='\"'landing';\\\")\ns=s.replace(\\\"this.flakCool=12+this.random()*4;\\\", \\\"this.flakCool=(12+this.random()*4)*(s.routeChoice==='dogleg'&&a.x<310000?1.8:1);\\\")\nopen(p,'w').write(s)\np='src/app.js'\ns=open(p).read().replace(\\\"addEventListener('contextmenu'\\\", \\\"addEventListener('pointerup',()=>{touch.fire=false;});addEventListener('pointercancel',()=>{touch.fire=false;});\\\\naddEventListener('contextmenu'\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/public-playthrough.py <<'EOF'\n\\\"\\\"\\\"Complete native E.Game playthrough: real DOM, keys and mouse; no sim commands/teleports.\\\"\\\"\\\"\nfrom pathlib import Path\nimport json,math,time,sys\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parent.parent\nOUT=ROOT/'docs/public-playthrough.json'\nfailures=[];count=0\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--use-angle=swiftshader','--enable-unsafe-swiftshader'])\n page=b.new_page(viewport={'width':1920,'height':1080})\n errs=[];page.on('pageerror',lambda e:errs.append(str(e)))\n page.goto((ROOT/'game.html').as_uri()+'?backend=webgl',wait_until='load')\n page.wait_for_function('window.__bomber?.ready',timeout=120000)\n page.get_by_role('button',name='Fly a sortie',exact=True).click()\n page.wait_for_timeout(300)\n page.screenshot(path=str(ROOT/'tests/briefing-live.png'))\n page.get_by_role('button',name='Launch sortie',exact=True).click()\n page.wait_for_function('game.sceneName===\\\"play\\\"')\n page.evaluate('game.stop();game.audio.mute(true)')\n def advance(n=.05):page.evaluate('(n)=>game.advance(n)',n)\n def key(code,n=.05):\n  page.keyboard.down(code);advance(n);page.keyboard.up(code);advance(.02)\n def state():return page.evaluate('({t:__bomber.sim.state.t,a:__bomber.sim.state.aircraft,p:__bomber.sim.state.players[0],foes:__bomber.sim.state.enemies.filter(e=>e.alive),pred:__bomber.sim.state.prediction,primary:__bomber.sim.state.primary,phase:__bomber.sim.state.phase,result:__bomber.sim.state.result,shots:__bomber.sim.state.fired,bombs:__bomber.sim.state.bombsLeft})')\n def check(ok,message):\n  global count\n  count+=1\n  if not ok:failures.append(message)\n advance(.3)\n # Power and route hold are actual native controls.\n key('e',.8)\n seen=set();released=False;returning=False;gunheld=False\n for step in range(760):\n  s=state()\n  if s['result']:break\n  if s['phase']=='landing':advance(13);continue\n  if s['primary'] and not returning:\n   if gunheld:page.mouse.up();gunheld=False\n   key('m');advance(.05)\n   page.get_by_role('button',name='Return: Rookfield',exact=True).click()\n   page.get_by_role('button',name='Fly to ROOKFIELD',exact=True).click()\n   advance(.05);returning=True\n  elif not returning and s['a']['x']>304000 and not released:\n   if s['p']['station']\"'!='\"'bombs':\n    if gunheld:page.mouse.up();gunheld=False\n    key('3');advance(1)\n   target={'x':340000,'y':18000}\n   if math.hypot(s['pred']['x']-target['x'],s['pred']['y']-target['y'])<1200:\n    key('Space');released=True\n    page.evaluate('game.advance(.01,{draw:true})')\n    page.screenshot(path=str(ROOT/'tests/bombs-public.png'))\n  elif (s['a']['x']<295000 or returning) and s['foes']:\n   foe=s['foes'][0];bearing=foe['bearing'];seen.add(bearing)\n   if s['p']['station']\"'!=bearing:\n    if gunheld:page.mouse.up();gunheld=False\n    key('\"'2')\n   by={'nose':0,'starboard':math.pi/2,'tail':math.pi,'port':-math.pi/2}[bearing]\n   dx=foe['x']-s['a']['x'];dy=foe['y']-s['a']['y'];dz=foe['z']-s['a']['z']\n   yaw=math.atan2(math.sin(math.atan2(dy,dx)-s['a']['yaw']-by),math.cos(math.atan2(dy,dx)-s['a']['yaw']-by))\n   pitch=math.atan2(dz,math.hypot(dx,dy))\n   page.mouse.move(1920*(.5+yaw/1.25),1080*(.5-pitch/.85))\n   if not gunheld:page.mouse.down();gunheld=True\n  elif s['p']['station'] not in ('pilot','bombs'):\n   if gunheld:page.mouse.up();gunheld=False\n   key('1')\n  advance(.75 if s['a']['x']>300000 and not released and not returning else 1)\n if gunheld:page.mouse.up()\n final=page.evaluate('({state:__bomber.sim.snapshot(),errors:game.errors,screen:__bomber.ui.shell.screen})')\n r=final['state']['result']\n check(bool(r),'Public input sortie did not terminate')\n check(bool(r and r['win']),'Public input sortie did not destroy primary and recover')\n check(final['state']['bombsDropped']==2,'Public input release did not drop exactly two bombs')\n check(set(final['state']['encounters'])=={'nose','port','starboard','tail'},'Not all four bearings encountered')\n check(final['state']['fired']>0,'Public input never fired a gun')\n check(final['state']['cheated'] is False,'Public input run was marked cheated')\n check(not final['errors'] and not errs,'Browser/native errors: '+str(final['errors'])+str(errs))\n check(final['screen']=='results','Results screen absent')\n page.evaluate('game.advance(.01,{draw:true})');page.wait_for_timeout(300)\n page.screenshot(path=str(ROOT/'tests/debrief-public.png'))\n OUT.write_text(json.dumps({'checks':count,'failures':failures,'result':r,'encounters':final['state']['encounters'],'inputObservedBearings':list(seen),'fired':final['state']['fired'],'cheated':final['state']['cheated'],'browserErrors':errs},indent=2))\n b.close()\nfor f in failures:print('FAIL public-playthrough: '+f)\nprint(f'{count-len(failures)}/{count} public-input checks passed')\nsys.exit(bool(failures))\nEOF\nnpm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js'\ns=open(p).read().replace(\\\"if(\"'!p||!STATIONS.includes(station))return false;const other\", \"if(!p||!STATIONS.includes(station))return false;if(p.station===station)return true;const other\")\ns=s.replace(\"q.station=p.station;s.owners[p.station]=other;\", \"q.station=p.station;s.owners[p.station]=other;if(q.station==='\"'pilot')s.commandOwner=other;\\\")\ns=s.replace(\\\"const battery=s.targets.find(t=>t.id==='battery'),near=a.x>240000&&a.x<390000&&s.phase\"'!=='\"'landing';\\\", \\\"const battery=s.targets.find(t=>t.id==='battery'),near=a.x>240000&&a.x<390000&&s.phase\"'!=='\"'landing';\\\")\ns=s.replace(\\\"this.flakCool=12+this.random()*4;\\\", \\\"this.flakCool=(12+this.random()*4)*(s.routeChoice==='dogleg'&&a.x<310000?1.8:1);\\\")\nopen(p,'w').write(s)\np='src/app.js'\ns=open(p).read().replace(\\\"addEventListener('contextmenu'\\\", \\\"addEventListener('pointerup',()=>{touch.fire=false;});addEventListener('pointercancel',()=>{touch.fire=false;});\\\\naddEventListener('contextmenu'\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/public-playthrough.py <<'EOF'\n\\\"\\\"\\\"Complete native E.Game playthrough: real DOM, keys and mouse; no sim commands/teleports.\\\"\\\"\\\"\nfrom pathlib import Path\nimport json,math,time,sys\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parent.parent\nOUT=ROOT/'docs/public-playthrough.json'\nfailures=[];count=0\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--use-angle=swiftshader','--enable-unsafe-swiftshader'])\n page=b.new_page(viewport={'width':1920,'height':1080})\n errs=[];page.on('pageerror',lambda e:errs.append(str(e)))\n page.goto((ROOT/'game.html').as_uri()+'?backend=webgl',wait_until='load')\n page.wait_for_function('window.__bomber?.ready',timeout=120000)\n page.get_by_role('button',name='Fly a sortie',exact=True).click()\n page.wait_for_timeout(300)\n page.screenshot(path=str(ROOT/'tests/briefing-live.png'))\n page.get_by_role('button',name='Launch sortie',exact=True).click()\n page.wait_for_function('game.sceneName===\\\"play\\\"')\n page.evaluate('game.stop();game.audio.mute(true)')\n def advance(n=.05):page.evaluate('(n)=>game.advance(n)',n)\n def key(code,n=.05):\n  page.keyboard.down(code);advance(n);page.keyboard.up(code);advance(.02)\n def state():return page.evaluate('({t:__bomber.sim.state.t,a:__bomber.sim.state.aircraft,p:__bomber.sim.state.players[0],foes:__bomber.sim.state.enemies.filter(e=>e.alive),pred:__bomber.sim.state.prediction,primary:__bomber.sim.state.primary,phase:__bomber.sim.state.phase,result:__bomber.sim.state.result,shots:__bomber.sim.state.fired,bombs:__bomber.sim.state.bombsLeft})')\n def check(ok,message):\n  global count\n  count+=1\n  if not ok:failures.append(message)\n advance(.3)\n # Power and route hold are actual native controls.\n key('e',.8)\n seen=set();released=False;returning=False;gunheld=False\n for step in range(760):\n  s=state()\n  if s['result']:break\n  if s['phase']=='landing':advance(13);continue\n  if s['primary'] and not returning:\n   if gunheld:page.mouse.up();gunheld=False\n   key('m');advance(.05)\n   page.get_by_role('button',name='Return: Rookfield',exact=True).click()\n   page.get_by_role('button',name='Fly to ROOKFIELD',exact=True).click()\n   advance(.05);returning=True\n  elif not returning and s['a']['x']>304000 and not released:\n   if s['p']['station']\"'!='\"'bombs':\n    if gunheld:page.mouse.up();gunheld=False\n    key('3');advance(1)\n   target={'x':340000,'y':18000}\n   if math.hypot(s['pred']['x']-target['x'],s['pred']['y']-target['y'])<1200:\n    key('Space');released=True\n    page.evaluate('game.advance(.01,{draw:true})')\n    page.screenshot(path=str(ROOT/'tests/bombs-public.png'))\n  elif (s['a']['x']<295000 or returning) and s['foes']:\n   foe=s['foes'][0];bearing=foe['bearing'];seen.add(bearing)\n   if s['p']['station']\"'!=bearing:\n    if gunheld:page.mouse.up();gunheld=False\n    key('\"'2')\n   by={'nose':0,'starboard':math.pi/2,'tail':math.pi,'port':-math.pi/2}[bearing]\n   dx=foe['x']-s['a']['x'];dy=foe['y']-s['a']['y'];dz=foe['z']-s['a']['z']\n   yaw=math.atan2(math.sin(math.atan2(dy,dx)-s['a']['yaw']-by),math.cos(math.atan2(dy,dx)-s['a']['yaw']-by))\n   pitch=math.atan2(dz,math.hypot(dx,dy))\n   page.mouse.move(1920*(.5+yaw/1.25),1080*(.5-pitch/.85))\n   if not gunheld:page.mouse.down();gunheld=True\n  elif s['p']['station'] not in ('pilot','bombs'):\n   if gunheld:page.mouse.up();gunheld=False\n   key('1')\n  advance(.75 if s['a']['x']>300000 and not released and not returning else 1)\n if gunheld:page.mouse.up()\n final=page.evaluate('({state:__bomber.sim.snapshot(),errors:game.errors,screen:__bomber.ui.shell.screen})')\n r=final['state']['result']\n check(bool(r),'Public input sortie did not terminate')\n check(bool(r and r['win']),'Public input sortie did not destroy primary and recover')\n check(final['state']['bombsDropped']==2,'Public input release did not drop exactly two bombs')\n check(set(final['state']['encounters'])=={'nose','port','starboard','tail'},'Not all four bearings encountered')\n check(final['state']['fired']>0,'Public input never fired a gun')\n check(final['state']['cheated'] is False,'Public input run was marked cheated')\n check(not final['errors'] and not errs,'Browser/native errors: '+str(final['errors'])+str(errs))\n check(final['screen']=='results','Results screen absent')\n page.evaluate('game.advance(.01,{draw:true})');page.wait_for_timeout(300)\n page.screenshot(path=str(ROOT/'tests/debrief-public.png'))\n OUT.write_text(json.dumps({'checks':count,'failures':failures,'result':r,'encounters':final['state']['encounters'],'inputObservedBearings':list(seen),'fired':final['state']['fired'],'cheated':final['state']['cheated'],'browserErrors':errs},indent=2))\n b.close()\nfor f in failures:print('FAIL public-playthrough: '+f)\nprint(f'{count-len(failures)}/{count} public-input checks passed')\nsys.exit(bool(failures))\nEOF\nnpm run build\"","aggregated_output":"npm notice run b17-cross-channel-chaos@1.0.0 build\nnpm notice run bun tools/build.mjs\nB-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517.html · 4.67 MB · self-contained\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"tail -30 tests/sim-test.mjs && tail -25 tests/hub-unit.mjs && tail -20 tests/hub-sim.mjs && sed -n '1,130p' tests/hub-verify.py && rg -n 'def |__hubCheck|json|print' tests/hub-verify.py | tail -30 && rg --files tests | sort\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"tail -30 tests/sim-test.mjs && tail -25 tests/hub-unit.mjs && tail -20 tests/hub-sim.mjs && sed -n '1,130p' tests/hub-verify.py && rg -n 'def |__hubCheck|json|print' tests/hub-verify.py | tail -30 && rg --files tests | sort\"","aggregated_output":"    sim.dev('infinite', true); sim.state.bombsLeft = 0; sim.step(DT); check(sim.state.bombsLeft >= 4 && sim.state.aircraft.fuel === sim.state.aircraft.maxFuel, 'infinite resources really refill');\n    for (const kind of ['engine', 'gun', 'sight', 'fire']) sim.dev('damage', kind); sim.dev('repair'); check(sim.state.aircraft.engines.every(e => e === 1) && !sim.state.aircraft.fire && !sim.state.sightDamaged, 'dev damage and repair use live systems');\n    for (const bearing of Object.keys(BEARINGS)) sim.dev('fighter', bearing); check(sim.state.enemies.filter(e => e.alive).length === 3, 'fighter spawn respects pressure ceiling');\n    sim.dev('flak'); sim.dev('flak'); sim.dev('flak'); check(sim.state.flak.filter(e => !e.burst).length === 2, 'flak spawn respects pressure ceiling');\n    for (const beat of ['outbound', 'coast', 'bomb', 'home']) { sim.dev('jump', beat); check(Number.isFinite(sim.state.aircraft.x) && sim.state.aircraft.airborne, `dev ${beat} jump is usable`); }\n    const data = JSON.parse(sim.exportMission()); check(validateMission(data).length === 0 && data.targets.some(t => t.primary), 'mission export parses and validates');\n    data.waypoints.harbor.x += 200; check(sim.importMission(JSON.stringify(data)) && JSON.parse(sim.exportMission()).waypoints.harbor.x === data.waypoints.harbor.x, 'edited mission export/import round trip');\n    const bad = copy(data); bad.targets[0].r = -2; let refused = false; try { sim.importMission(bad); } catch { refused = true; } check(refused, 'invalid mission data rejected');\n    check(validateMission(copy(MISSION)).length === 0, 'canonical mission is valid');\n  });\n\n  if (full) for (const loadout of Object.keys(LOADOUTS)) for (const difficulty of Object.keys(DIFFICULTIES)) test(`whole sortie ${loadout}/${difficulty}`, () => {\n    const run = playSortie({loadout, difficulty}), s = run.sim.state;\n    check(s.result?.win && s.primary && s.returned, 'honest command bot completes strike and recovery', `reason=${s.result?.reason}; t=${s.t.toFixed(1)}; x=${s.aircraft.x.toFixed(0)}; y=${s.aircraft.y.toFixed(0)}; hull=${s.aircraft.hull.toFixed(1)}; released=${run.releaseSent}`);\n    check(['launch', 'outbound', 'coast', 'strike', 'return', 'landing', 'debrief'].every(p => run.phases.has(p)), 'all mission beats were reached', [...run.phases].join(','));\n    check(Object.keys(BEARINGS).every(b => run.encounters.has(b)), 'all four actual threat bearings appear', [...run.encounters].join(','));\n    check(run.seenTypes.has('gun') && run.seenTypes.has('flak-burst') && run.seenTypes.has('release') && run.seenTypes.has('impact'), 'operation couples defense, flak, deliberate release and impact');\n    check(s.aircraft.fuel > 0 && s.bombsLeft >= 0 && !s.cheated, 'resource viable without cheats');\n    details.push({loadout, difficulty, result: s.result, beats: run.beats, encounters: [...run.encounters], frames: run.frames});\n  });\n  return {count, failures, details};\n}\n\nif (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {\n  const result = runSimTests({full: !process.argv.includes('--quick')});\n  for (const failure of result.failures) console.error(failure);\n  console.log(`${result.count} simulation checks, ${result.failures.length} failures`);\n  if (process.argv.includes('--details')) console.log(JSON.stringify(result.details, null, 2));\n  process.exitCode = result.failures.length ? 1 : 0;\n}\ntest(\"finish lists every present teammate once\", () =>\n\tassert.deepEqual(hh.result.standings, [[0]]));\nhh.emit(\"end\", { reason: \"finished\" });\nconst count = hh.packets.length;\nhost.command({ type: \"release\", salvo: 1 });\nhost.update(1);\ntest(\"end stops sends and audio\", () => {\n\tassert.equal(hh.packets.length, count);\n\tassert.ok(stopped > 0);\n});\nconst ss = sim(),\n\tsh = mock(-1, true, true);\nsh.clock = 0;\nconst server = new HubAdapter({ sim: ss, hub: sh });\nawait server.connect();\nserver.ready();\nserver.update(0.2);\ntest(\"playerless server has no local command seat\", () => {\n\tassert.equal(server.localId, null);\n\tassert.equal(server.command({ type: \"release\", salvo: 1 }), false);\n\tassert.ok(sh.packets.length > 0);\n});\nfor (const f of failures) console.error(`FAIL Hub ${f}`);\nconsole.log(`${checks} Hub checks passed; ${failures.length} failures`);\nif (failures.length) process.exitCode = 1;\nflush();\ntest(\"remote deliberate jettison preserves hold confirmation\", () =>\n\tassert.equal(sim.state.bombsLeft, 0));\nhostHub.emit(\"leave\", { id: 1, reason: \"disconnected\" });\ntest(\"departed commanding pilot duties return to AI and survivor\", () => {\n\tassert.equal(sim.state.owners.pilot, \"AI\");\n\tassert.equal(sim.state.commandOwner, 1);\n});\nhostHub.emit(\"time-up\", {});\nhostHub.emit(\"time-up\", {});\ntest(\"actual terminal partial reports once\", () => {\n\tassert.equal(hostHub.finishCount, 1);\n\tassert.deepEqual(hostHub.result.standings, [[0]]);\n\tassert.equal(hostHub.result.won, false);\n});\nfor (const message of failures) console.error(`FAIL Hub sim ${message}`);\nconsole.log(\n\t`${pass} Hub simulation checks passed; ${failures.length} failures`,\n);\nif (failures.length) process.exitCode = 1;\n\"\"\"Released AI Hub harness, actual packaged game, one browser and an owned ephemeral server.\nRun with the installed Playwright Python interpreter. Prints failures and one count line.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport functools\nimport http.server\nimport json\nimport threading\nimport time\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import Error as PlaywrightError\nfrom playwright.sync_api import sync_playwright\n\nDEV = Path(__file__).resolve().parents[1]\nROOT = DEV.parent\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--game\", type=Path)\n    parser.add_argument(\n        \"--scenarios\", default=\"normal,degraded,guest-leave,host-leave,server\"\n    )\n    args = parser.parse_args()\n    identity = json.loads((DEV / \"identity.json\").read_text())\n    game = (args.game or ROOT / (identity[\"slug\"] + \".html\")).resolve()\n    relative = game.relative_to(ROOT).as_posix()\n    evidence = []\n    failures = []\n    handler = functools.partial(QuietHandler, directory=str(ROOT))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    origin = f\"http://127.0.0.1:{server.server_address[1]}\"\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(\n                headless=True,\n                args=[\"--use-angle=swiftshader\", \"--enable-unsafe-swiftshader\"],\n            )\n            context = browser.new_context(viewport={\"width\": 1600, \"height\": 1000})\n            for scenario in args.scenarios.split(\",\"):\n                page = context.new_page()\n                warnings = []\n                page.on(\n                    \"console\",\n                    lambda msg, warnings=warnings: (\n                        warnings.append(msg.text)\n                        if \"[AIHub]\" in msg.text and msg.type in (\"warning\", \"error\")\n                        else None\n                    ),\n                )\n                params = {\n                    \"game\": \"/\" + relative + \"?backend=webgl\",\n                    \"players\": \"2\",\n                    \"auto\": \"1\",\n                    \"seed\": \"4217\",\n                    \"play\": \"60000\" if scenario == \"normal\" else \"8000\",\n                    \"limit\": \"90\",\n                }\n                if scenario == \"degraded\":\n                    params.update(latency=\"150\", jitter=\"50\", loss=\"5\")\n                if scenario in (\"host-leave\", \"server\"):\n                    params[\"scenario\"] = scenario\n                start = time.monotonic()\n                report = None\n                observations = {}\n                scenario_ok = False\n                try:\n                    # Confirm the ephemeral server is serving this game's identity first.\n                    response = context.request.get(origin + \"/\" + relative)\n                    assert response.ok and identity[\"title\"] in response.text(), (\n                        \"server identity mismatch\"\n                    )\n                    url = (\n                        origin\n                        + \"/\"\n                        + DEV.name\n                        + \"/tools/hub-harness.html?\"\n                        + urlencode(params)\n                    )\n                    page.goto(url, wait_until=\"domcontentloaded\")\n                    if scenario == \"normal\":\n                        page.wait_for_function(\n                            \"[...document.querySelectorAll('iframe')].length===2 && [...document.querySelectorAll('iframe')].every(f=>f.contentWindow.__bomber?.online?.playing&&f.contentWindow.__bomber?.online?.started)\",\n                            timeout=90000,\n                        )\n                        # Semantic public commands exercise the exact local/remote transport used by UI.\n                        # The separate browser-input suite verifies physical-key/menu paths.\n                        page.evaluate(\"\"\"() => {\n                          const frames=[...document.querySelectorAll('iframe')];\n                          // A genuine local settings/help overlay isolates station assertions from the\n                          // admission harness's concurrent random flight keys; authority must keep stepping.\n                          for(const f of frames)f.contentWindow.__bomber.ui.shell.show('help',{title:'CREW STATIONS',text:'The shared aircraft continues while this local overlay is open.'});\n                          frames[0].contentWindow.__bomber.online.command({type:'station',station:'port'});\n                          frames[1].contentWindow.__bomber.online.command({type:'station',station:'tail'});\n                          frames[1].contentWindow.__bomber.online.command({type:'aim',yaw:.25,pitch:.1});\n                        }\"\"\")\n                        page.wait_for_function(\n                            \"document.querySelectorAll('iframe')[0].contentWindow.__bomber.sim.state.owners.port===1 && document.querySelectorAll('iframe')[0].contentWindow.__bomber.sim.state.owners.tail===2\",\n                            timeout=10000,\n                        )\n                        page.evaluate(\"\"\"() => {\n                          const frames=[...document.querySelectorAll('iframe')];\n                          frames[0].contentWindow.__bomber.online.command({type:'station',station:'pilot'});\n                          frames[1].contentWindow.__bomber.online.command({type:'station',station:'bombs'});\n                        }\"\"\")\n                        page.wait_for_function(\n                            \"document.querySelectorAll('iframe')[0].contentWindow.__bomber.sim.state.aircraft.airborne && document.querySelectorAll('iframe')[0].contentWindow.__bomber.sim.state.aircraft.doors>.9\",\n                            timeout=45000,\n                        )\n                        inventory = page.evaluate(\n                            \"document.querySelectorAll('iframe')[0].contentWindow.__bomber.sim.state.bombsLeft\"\n                        )\n                        page.evaluate(\n                            \"document.querySelectorAll('iframe')[1].contentWindow.__bomber.online.command({type:'release',salvo:2})\"\n                        )\n                        page.wait_for_function(\n                            f\"[...document.querySelectorAll('iframe')].every(f=>f.contentWindow.__bomber.sim.state.bombsLeft==={inventory - 2})\",\n                            timeout=10000,\n10:import json\n24:    def log_message(self, *_args):\n28:def run():\n35:    identity = json.loads((DEV / \"identity.json\").read_text())\n167:                    report = page.evaluate(\"window.__hubCheck\")\n220:    (DEV / \"docs\" / \"hub-results.json\").write_text(json.dumps(evidence, indent=2))\n222:        print(\"FAIL \" + failure)\n223:    print(\ntests/audio-test.js\ntests/briefing.png\ntests/cockpit.png\ntests/hub-sim.mjs\ntests/hub-unit.mjs\ntests/hub-verify.py\ntests/public-playthrough.py\ntests/sim-test.mjs\ntests/smoke.py\ntests/title.png\ntests/view-bombs.png\ntests/view-pilot.png\ntests/view-proof-result.json\ntests/view-proof-webgpu-result.json\ntests/view-proof.html\ntests/view-proof.py\ntests/view-split.png\ntests/view-title.png\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_53","type":"agent_message","text":"The first packaged-file launch is clean, and the cockpit and title composition look right in Chromium. Interface checks also found and fixed a co-op split-view reset and command ownership after a station exchange. I’m now checking touch holds, menu ownership, and a full sortie through keyboard and mouse input.\n"}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/app.js'\ns=open(p).read().replace('idleAt=0,lastPointer', 'idleAt=0,idleWall=performance.now(),pauseOwner=1,lastPointer')\ns=s.replace('function activity(){idleAt=game.real;}','function activity(){idleAt=game.real;idleWall=performance.now();}')\ns=s.replace(\\\"if(game.paused&&game.pausedBy===2)\\\",\\\"if(game.paused&&lastPaused)game.pausedBy=pauseOwner;else if(game.paused)pauseOwner=game.pausedBy||1;\\\\n if(game.paused&&game.pausedBy===2)\\\")\ns=s.replace(\\\"game.real-idleAt>=10)\\\",\\\"(game.real-idleAt>=10||performance.now()-idleWall>=10000))\\\")\nopen(p,'w').write(s)\np='src/sim.js'\ns=open(p).read().replace('throttle:.72,fuel','throttle:.72,autoPower:true,fuel')\ns=s.replace(\\\"if(c?.throttleDelta)a.throttle=clamp(a.throttle+c.throttleDelta*dt*.24,.05,1);\\\", \\\"if(c?.throttleDelta){a.throttle=clamp(a.throttle+c.throttleDelta*dt*.24,.05,1);a.autoPower=false;}\\\")\ns=s.replace(\\\"a.throttle=Math.max(a.throttle,.8);\\\", \\\"if(a.autoPower\"'!==false)a.throttle=Math.max(a.throttle,.8);\")\nopen(p,'\"'w').write(s)\np='src/ui.js'\ns=open(p).read().replace(\\\"clear(){this.shell.hide();\\\", \\\"clear(){clearTimeout(this.jettisonTimer);this.jettisonTimer=null;this.shell.hide();\\\")\ns=s.replace(\\\"['Fly to '+MISSION.waypoints[this.preview].label,()=>{this.send({type:'route',target:this.preview},this.menuOwner);this.clear();}]\\\", \\\"{label:'Fly to '+MISSION.waypoints[this.preview].label,disabled:s.commandOwner\"'!==this.menuOwner,fn:()=>{this.send({type:'\"'route',target:this.preview},this.menuOwner);this.clear();}}\\\")\ns=s.replace(\\\"let timer;const start=e=>{e.preventDefault();clearTimeout(timer);\\\", \\\"const start=e=>{e.preventDefault();if(e.pointerId\"'!==undefined)b.setPointerCapture?.(e.pointerId);clearTimeout(this.jettisonTimer);\")\ns=s.replace(\"timer=setTimeout(()=>{this.send\", \"this.jettisonTimer=setTimeout(()=>{this.send\")\ns=s.replace(\"const stop=()=>{clearTimeout(timer);\", \"const stop=()=>{clearTimeout(this.jettisonTimer);\")\nopen(p,'\"'w').write(s)\nPY\nnode --check src/app.js && node --check src/ui.js && node --check src/sim.js\nbun tools/build.mjs --quiet\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
