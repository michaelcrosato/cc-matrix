{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/audio.js && sed -n '1,125p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/view.js\"","aggregated_output":"/* Original procedural score, machinery, weapons and radio babble.\n * Adapter: const sound = new BomberAudio(E, game); apply persisted audio levels\n * after construction; call sound.unlock() in a deliberate input handler,\n * sound.update(dt, simState, {active,paused}) after fixed simulation steps,\n * and sound.event(event, simState) for newly accepted authoritative events.\n * update also consumes state.events, deduplicated by id. stop() ends a sortie;\n * update on a fresh nonterminal state restarts cleanly. dispose() ends ownership.\n * All custom nodes use native audio buses. No files, TTS or gameplay RNG.\n */\n\nconst clamp = (v, a, b) => Math.min(b, Math.max(a, Number(v) || 0));\nconst TAU = Math.PI * 2;\nconst TERMINAL = new Set(['debrief', 'failed', 'failure', 'ended', 'results', 'complete']);\n\nexport const BOMBER_SCORES = Object.freeze({\n  prepare: {\n    bpm: 76, steps: 2,\n    tracks: [\n      { name: 'air', wave: 'triangle', vol: 0.15, notes: 'D4 - . A4 F4 - E4 - | D4 - . F4 G4 - A4 - | Bb4 - A4 - F4 - E4 - | D4 - A3 - D4 - . .' },\n      { name: 'ground', wave: 'sine', vol: 0.17, notes: 'D2 - - - A2 - - - | Bb2 - - - F2 - - - | G2 - - - A2 - - - | D2 - - - D3 - - -' },\n    ],\n  },\n  approach: {\n    bpm: 104, steps: 2,\n    tracks: [\n      { name: 'pulse', wave: 'triangle', vol: 0.1, notes: 'D3 . A3 . D4 . A3 . | C3 . G3 . C4 . G3 . | Bb2 . F3 . Bb3 . F3 . | A2 . E3 . A3 . E3 .' },\n      { name: 'signal', wave: 'sine', vol: 0.14, notes: 'D5 - . . F5 - E5 - | D5 - . . C5 - A4 - | Bb4 - . . F5 - E5 - | A4 - - - . . . .' },\n      { name: 'march', wave: 'drums', vol: 0.13, notes: 'k . h . . . h . k . h . s . h .' },\n    ],\n  },\n  home: {\n    bpm: 80, steps: 2,\n    tracks: [\n      { name: 'home', wave: 'triangle', vol: 0.17, notes: 'F4 - A4 - C5 - A4 - | Bb4 - G4 - F4 - D4 - | F4 - A4 - G4 - E4 - | F4 - - - . . . .' },\n      { name: 'field', wave: 'sine', vol: 0.16, notes: 'F2 - - - C3 - - - | Bb2 - - - D3 - - - | F2 - - - C3 - - - | F2 - - - F3 - - -' },\n    ],\n  },\n});\n\nfunction random(seed = 0x71e25a9) {\n  let x = seed >>> 0 || 1;\n  return () => { x ^= x << 13; x ^= x >>> 17; x ^= x << 5; return (x >>> 0) / 4294967296; };\n}\n\n/** Shared by real-time sound and OfflineAudioContext verification. */\nexport function synthNoiseBuffer(ctx, seconds = 1, seed = 0x71e25a9) {\n  const buffer = ctx.createBuffer(1, Math.max(1, Math.floor(ctx.sampleRate * seconds)), ctx.sampleRate);\n  const samples = buffer.getChannelData(0), next = random(seed);\n  let smooth = 0;\n  for (let i = 0; i < samples.length; i++) {\n    const white = next() * 2 - 1;\n    smooth = 0.985 * smooth + 0.015 * white;\n    samples[i] = white * 0.7 + smooth * 0.3;\n  }\n  return buffer;\n}\n\n/** Schedule one bounded sound. Handles include every source for hard cleanup. */\nexport function scheduleBomberSound(ctx, destination, kind, options = {}) {\n  const at = Math.max(ctx.currentTime || 0, Number(options.at) || 0);\n  const level = clamp(options.gain === undefined ? 1 : options.gain, 0, 1.5);\n  const pitch = clamp(options.pitch === undefined ? 1 : options.pitch, 0.35, 3);\n  const sources = [], nodes = [], randomValue = random(options.seed || 74191);\n  const output = ctx.createGain(); output.gain.value = level; output.connect(destination); nodes.push(output);\n  let duration = 0;\n  const voice = ({start = 0, dur = 0.1, freq = 220, to = freq, vol = 0.1, wave = 'sine', filter, q = 0.8, attack = 0.005}) => {\n    const t = at + start, end = t + dur, envelope = ctx.createGain();\n    envelope.gain.setValueAtTime(0, t);\n    envelope.gain.linearRampToValueAtTime(vol, t + Math.min(attack, dur * 0.25));\n    envelope.gain.exponentialRampToValueAtTime(0.00001, end);\n    envelope.gain.setValueAtTime(0, end + 0.002);\n    let source;\n    if (wave === 'noise') {\n      source = ctx.createBufferSource(); source.buffer = synthNoiseBuffer(ctx, Math.max(0.5, dur + 0.05), (options.seed || 74191) + sources.length * 17); source.loop = true;\n      const band = ctx.createBiquadFilter(); band.type = filter || 'bandpass'; band.Q.value = q;\n      band.frequency.setValueAtTime(Math.max(30, freq * pitch), t);\n      band.frequency.exponentialRampToValueAtTime(Math.max(30, to * pitch), end);\n      source.connect(band); band.connect(envelope); nodes.push(band);\n    } else {\n      source = ctx.createOscillator(); source.type = wave;\n      source.frequency.setValueAtTime(Math.max(20, freq * pitch), t);\n      source.frequency.exponentialRampToValueAtTime(Math.max(20, to * pitch), end);\n      if (filter) {\n        const band = ctx.createBiquadFilter(); band.type = 'bandpass'; band.frequency.value = filter; band.Q.value = q;\n        source.connect(band); band.connect(envelope); nodes.push(band);\n      } else source.connect(envelope);\n    }\n    envelope.connect(output); source.start(t); source.stop(end + 0.012);\n    sources.push(source); nodes.push(envelope); duration = Math.max(duration, start + dur + 0.02);\n  };\n  switch (kind) {\n    case 'gun':\n      voice({wave: 'noise', freq: 2100, to: 380, dur: 0.085, vol: 0.26, filter: 'lowpass', attack: 0.001});\n      voice({wave: 'sine', freq: 130, to: 48, dur: 0.11, vol: 0.18, attack: 0.001});\n      voice({wave: 'triangle', start: 0.025, freq: 620, to: 190, dur: 0.055, vol: 0.035});\n      break;\n    case 'flak':\n      voice({wave: 'noise', freq: 1500, to: 95, dur: 0.8, vol: 0.34, filter: 'lowpass', attack: 0.003});\n      voice({freq: 82, to: 29, dur: 0.65, vol: 0.27, attack: 0.002});\n      break;\n    case 'impact':\n      voice({wave: 'noise', freq: 2600, to: 110, dur: 1.05, vol: 0.32, filter: 'lowpass', attack: 0.001});\n      voice({freq: 96, to: 24, dur: 0.95, vol: 0.24, attack: 0.001});\n      voice({wave: 'triangle', start: 0.06, freq: 235, to: 47, dur: 0.45, vol: 0.08});\n      break;\n    case 'bomb':\n      voice({wave: 'noise', freq: 1600, to: 500, dur: 0.1, vol: 0.11});\n      voice({wave: 'triangle', freq: 290, to: 90, dur: 0.16, vol: 0.08});\n      voice({wave: 'sine', start: 0.1, freq: 900, to: 1700, dur: 0.75, vol: 0.045, attack: 0.12});\n      break;\n    case 'hit':\n      voice({wave: 'noise', freq: 3200, to: 500, dur: 0.24, vol: 0.24, filter: 'highpass', attack: 0.001});\n      voice({wave: 'triangle', freq: 440, to: 80, dur: 0.22, vol: 0.14});\n      break;\n    case 'landing':\n      voice({wave: 'noise', freq: 1100, to: 180, dur: 0.8, vol: 0.19, filter: 'lowpass', attack: 0.02});\n      voice({freq: 105, to: 42, dur: 0.34, vol: 0.16});\n      voice({wave: 'triangle', start: 0.16, freq: 170, to: 80, dur: 0.26, vol: 0.05});\n      break;\n    case 'radio':\n      voice({wave: 'noise', freq: 2600, to: 1500, dur: 0.045, vol: 0.065, filter: 'bandpass', attack: 0.001});\n      break;\n    case 'warning':\n      for (let i = 0; i < 3; i++) voice({wave: 'triangle', start: i * 0.19, freq: i % 2 ? 760 : 570, dur: 0.12, vol: 0.08});\n      break;\n    case 'extinguish':\n      voice({wave: 'noise', freq: 3500, to: 650, dur: 0.85, vol: 0.14, filter: 'highpass', attack: 0.035});\n      break;\n    case 'jettison':\n      voice({wave: 'noise', freq: 600, to: 160, dur: 0.42, vol: 0.12, filter: 'lowpass'});\n      voice({wave: 'triangle', freq: 210, to: 55, dur: 0.3, vol: 0.1});\n      break;\n    case 'voice': {\n      const role = String(options.role || 'navigator').toLowerCase();\n      const base = /bomb|reed/.test(role) ? 132 : /gun|pip/.test(role) ? 248 : /pilot|captain|mercer/.test(role) ? 174 : 207;\n      const syllables = options.urgent ? 8 : 6;\n      for (let i = 0; i < syllables; i++) {\n        const start = 0.045 + i * (options.urgent ? 0.065 : 0.092);\n        const f = base * [1, 1.25, 0.89, 1.12, 0.94, 1.33, 1.06, 0.84][i % 8] * (0.98 + randomValue() * 0.04);\n        voice({wave: 'sawtooth', start, freq: f, to: f * (i % 2 ? 0.92 : 1.13), dur: 0.052 + randomValue() * 0.018, vol: 0.085, filter: 850 + (i % 3) * 560, q: 1.6, attack: 0.009});\n        voice({wave: 'noise', start, freq: 2700, to: 1400, dur: 0.018, vol: 0.025, filter: 'bandpass'});\n      }\n      break;\n    }\n    default: break;\n  }\n  const handle = {\n    sources, output, duration, at, end: at + duration, stopped: false,\n    stop() {\n      if (handle.stopped) return;\n/** Native my-3D2dge World3D presentation. Simulation coordinates are never mutated. */\nconst TAU = Math.PI * 2, ORIGIN = { x: 131072, y: 262144 };\nconst clamp = (n, a, b) => Math.max(a, Math.min(b, n));\nconst C = {\n  olive: '#65765a', oliveLight: '#82916b', oliveDark: '#3e5149', metal: '#a9b4aa',\n  ink: '#182d32', sea: '#23536a', foam: '#93b9bb', glass: '#a0c6c6', amber: '#ecc276',\n  gold: '#c8a46b', cloud: '#d7dfd8', cream: '#f4edce', danger: '#e2774e', red: '#9a4436',\n};\nfunction terrainColor(x, y, z, nz, out) {\n  x -= ORIGIN.x; y -= ORIGIN.y;\n  const coast = 250000 + Math.sin(y / 19000) * 8200 + Math.sin(y / 6800) * 2700;\n  const home = 38000 + Math.sin(y / 15000) * 5500;\n  const inlet = x < 343700 && x > 241000 && Math.abs(y - 18000 - Math.sin(x / 17000) * 2000) < 11500 + Math.max(0, 315000 - x) * .11;\n  const land = x < home || (x > coast && !inlet);\n  const h = ((Math.floor(x / 4300) * 31 + Math.floor(y / 3700) * 47) >>> 0) % 13 / 13;\n  if (land) {\n    const field = (Math.floor(x / 5100) + Math.floor(y / 4100) * 3) & 3;\n    out[0] = 88 + field * 7 + h * 7; out[1] = 112 + field * 6 + h * 5; out[2] = 77 + field * 5;\n    if (x < home && x > home - 1900 || x > coast && x < coast + 1600 && !inlet) { out[0] = 174; out[1] = 169; out[2] = 123; }\n  } else {\n    const wave = Math.sin((x + y * .21) / 2200) * .5 + .5;\n    out[0] = 28 + wave * 8; out[1] = 77 + wave * 13; out[2] = 99 + wave * 16;\n    if (inlet) { out[0] += 7; out[1] += 7; }\n  }\n  return out;\n}\nfunction installShapes(E) {\n  if (E.SHAPES.cccHangar) return;\n  const materials = {\n    cccRoof: { color: '#5a6860', pattern: 'metal', rivet: .1 },\n    cccWall: { color: '#b2af90', pattern: 'bricks', bw: 18, bh: 9 },\n    cccSteel: { color: '#657b79', pattern: 'metal' },\n  };\n  Object.assign(E.MATERIALS, materials);\n  E.SHAPES.cccHangar = { about: 'arched corrugated bomber hangar', tags: 'airfield industrial military', mats: { r: 'cccRoof', w: 'cccWall', d: '#263c3d' }, parts: [\n    ['box','w',[0,0,0],[980,700,310]],\n    ['prism','r',[0,0,310],[[-490,0],[-420,150],[-250,260],[0,300],[250,260],[420,150],[490,0]],740,{axis:'y'}],\n    ['box','d',[0,-352,0],[800,8,290]], ['row',5,[180,0,0],['box','r',[0,-362,0],[7,12,290]]],\n  ] };\n  E.SHAPES.cccCrane = { about: 'lattice harbor crane with suspended hook', tags: 'harbor military industrial', mats: { a:'#d6b878', s:'cccSteel', b:'#354b4f' }, parts: [\n    ['mirror','xy',['box','s',[105,105,0],[35,35,920]]], ['box','s',[0,0,850],[310,310,100]],\n    ['box','a',[0,0,960],[420,300,230]], ['box','b',[0,-157,1010],[270,10,115]],\n    ['box','a',[0,460,1180],[95,1380,75]], ['box','s',[0,-500,1120],[250,420,130]],\n    ['row',7,[0,180,0],['box','s',[0,450,1260],[40,14,180],{rot:[0,30,0]}]],\n    ['cyl','s',[0,1060,240],12,930], ['box','s',[0,1060,220],[120,30,50]],\n  ] };\n  E.SHAPES.cccWarehouse = { about: 'sawtooth shipyard workshop', tags: 'industrial warehouse military', mats: { w:'cccWall', r:'cccRoof', g:'#729395' }, parts: [\n    ['box','w',[0,0,0],[1500,850,420]],\n    ['prism','r',[0,0,420],[[-750,0],[0,260],[750,0]],900,{axis:'y'}],\n    ['row',7,[190,0,0],['box','g',[0,-429,200],[120,6,110]]],\n    ['row',3,[400,0,0],['box','r',[0,432,0],[260,8,290]]],\n  ] };\n  E.SHAPES.cccCottage = { about:'low coastal farm dwelling',tags:'house scenery',mats:{w:'#c1b795',r:'#896f55'},parts:[\n    ['box','w',[0,0,0],[240,190,140]], ['prism','r',[0,0,140],[[-130,0],[0,100],[130,0]],220,{axis:'y'}],\n    ['box','r',[65,-100,0],[40,8,95]], ['box','r',[-55,-100,50],[45,8,45]],\n  ] };\n}\nfunction transformLocal(a, x, y, z) {\n  const cy = Math.cos(a.yaw || 0), sy = Math.sin(a.yaw || 0), cp = Math.cos(a.pitch || 0), sp = Math.sin(a.pitch || 0), cr = Math.cos(a.bank || 0), sr = Math.sin(a.bank || 0);\n  const rx = -sy * cr + cy * sp * sr, ry = cy * cr + sy * sp * sr, rz = -cp * sr;\n  const ux = -cy * sp * cr - sy * sr, uy = -sy * sp * cr + cy * sr, uz = cp * cr;\n  return {x:a.x + cy*cp*x + rx*y + ux*z, y:a.y + sy*cp*x + ry*y + uy*z, z:a.z + sp*x + rz*y + uz*z};\n}\nconst defaults = () => ({x:0,y:0,z:14400,yaw:0,pitch:0,bank:0,speed:1120,throttle:.76,hull:100,engines:[1,1,1,1],doors:0,gear:0});\n\nexport class BomberView {\n  constructor(E, game) {\n    this.E = E; this.game = game; this.world = null; this.state = null; this.players = [];\n    this.options = {}; this.views = []; this.render = true; this._lastTime = 0;\n    this.clouds = Array.from({length:76},(_,i)=>({x:-40000+(i*7919)%500000,y:-120000+(i*19067)%270000,z:21000+(i*773)%11500,k:1600+(i*317)%2600,a:i*2.399}));\n  }\n  async init({render=true}={}) {\n    this.render = render;\n    await this.E.World3D.init(this.game,{render});\n    installShapes(this.E);\n    this.world = new this.E.World3D(this.game,{\n      terrain:{size:1048576,cell:1024,chunk:16,height:()=>0,color:terrainColor,far:220000,physics:1,detail:1.15,speckle:0,mottle:0,bottom:-2000},\n      look:'puppet',res:'pixels',outlines:true,shadows:true,\n      sky:{top:'#487a91',horizon:'#e0dbc1',ground:'#315e6b',sun:'#ffe7b0',haze:.23},\n      fog:{color:'#b5c9c5',near:90000,far:215000},\n      ambient:['#d3e3e0','#788a71',2.0],sun:{color:'#ffe3b0',intensity:2.0,dir:[-.6,.3,-.7],area:5000,shadow:2048},\n      torchLights:0,glowLights:4,lights:0,\n      filter:{look:'clean',bands:4,punch:1.08,ink:.45},\n      camera:{mode:'fixed',near:1,far:245000,fov:70,mouseLook:false},\n      onDraw:(w,r)=>this.onDraw(w,r),\n    });\n    this.world.addCamera({mode:'fixed',near:1,far:245000,fov:70,mouseLook:false});\n    this._scenery();\n    this.state = {aircraft:defaults(),t:0,players:[{id:1,station:'pilot',aim:{yaw:0,pitch:0}}],targets:[],enemies:[],bombs:[],flak:[],shots:[],effects:[]};\n    this.players = this.state.players;\n    this.update(0,this.state);\n    return this;\n  }\n  _scenery() {\n    const w=this.world, p=(id,x,y,z=0,o={})=>w.shape(id,x+ORIGIN.x,y+ORIGIN.y,z,{solid:false,...o});\n    // Harthaven: shelter, control hut and three pens along an east-west strip.\n    p('cccHangar',-2900,-1700,0,{facing:Math.PI}); p('cccHangar',-4200,-1700,0,{facing:Math.PI});\n    p('cccHangar',-1600,-1700,0,{facing:Math.PI});\n    p('cccWarehouse',1400,-1600,0,{scale:.35});\n    // Saltwick harbor's cranes and warehouses frame the military targets.\n    for(let i=0;i<5;i++) p('cccCrane',339000+i*1150,21200,40,{facing:Math.PI/2});\n    for(let i=0;i<5;i++) p('cccWarehouse',341000+i*1900,24300+(i%2)*1600,40,{facing:.05*(i%2)});\n    for(let i=0;i<6;i++) p('cccWarehouse',333000+i*2600,12000,40,{scale:.65,facing:Math.PI/2});\n    // Distant villages are composed from the same chunky native registry.\n    for(let i=0;i<40;i++){\n      const x=i<14?4000+(i*317)%25000:281000+(i*799)%98000, y=i<14?12000+(i*257)%11000:-25000-(i*997)%42000;\n      p('cccCottage',x,y,0,{scale:1.5,facing:(i*.72)%TAU});\n      if(i%2===0)p('pine',x+800,y+600,0,{scale:18,params:{h:35}});\n    }\n  }\n  update(dt,state) {\n    if(!this.world)return;\n    this.state = state || this.state;\n    this.players = this.state.players || this.players;\n    const a=this.state.aircraft || defaults();\n    const target={x:a.x+ORIGIN.x,y:a.y+ORIGIN.y,z:a.z};\n    for(let i=0;i<2;i++){\n      const p=this.players[i]||this.players[0]||{station:'pilot'};\n      const cam=this.world.cameras[i];\n      cam.target=target;cam.set('fixed');cam.fixed=this.cameraPose(a,p,i);cam.update(dt);\n    }\n    this.world.step(dt);\n  }\n  cameraPose(a,p,i=0) {\n    const t=this.state?.t||0, aim=p.aim||{}, look=p.look||[0,0];\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '450,525p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/dist/handoff/API-INDEX.md && rg -n \\\"players\\\\(|setPlayers|padIndex|keyboard|gamepad\\\" B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/dist/handoff/API.md | head -30 && sed -n '147,190p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/view.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '450,525p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/dist/handoff/API-INDEX.md && rg -n \\\"players\\\\(|setPlayers|padIndex|keyboard|gamepad\\\" B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/dist/handoff/API.md | head -30 && sed -n '147,190p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/view.js\"","aggregated_output":"- `r.ix`, `r.iy`: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer)\n- `r.outline = '#140c1c'`: the color of the 1-pixel outline round every actor\n- `r.rim = '#ffe2b8'` †: the rim light's color on actors' lit edges\n- `r.rimAlpha = .28` †: its strength 0..1\n- `r.xrayColor = '#8fe3ff'` †: the default color of x-ray silhouettes\n- `r.xrayOutline = '#e8fdff'` †: the default 1-px outline round a silhouette's hidden part (null for none)\n\n## 10. Game\n\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n- `new E.Game({ draw })`: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\n- `new E.Game({ live })`: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it, the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n- `game.H`: the screen's height in game pixels (W is its width)\n- `game.W`: internal buffer size in pixels (HUD layout)\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test that catches what a player would see break). Returns the updates run\n- `game.after(seconds, fn, o = {})`: run fn once after `seconds` of game time. Cleared on scene change, unless { keep: true } (a site's clock, a watcher of the whole game: it outlives scenes, as a kept tween does). Returns { cancel() }\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\n- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\n- `game.every(seconds, fn, o = {})`: run fn every `seconds` of game time. Cleared on scene change, unless { keep: true }. Returns { cancel() }\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\n- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\n- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it\n- `game.menu(name, o)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when a menu opened\n- `game.mouseGround()`: the mouse's point on the ground: [x, y] in world units (an array, not { x, y }), or null with no mouse over the canvas\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\n- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\n- `game.resume()`: take the game out of pause (and close the pause screen)\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\n- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\n- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\n- `game.baseView` †: the chosen view without zoom and turn\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\n134:With no code: a **pause menu** on pausable scenes (Resume, Settings, Controls, Full screen, Quit to title; keys, mouse, gamepad and touch), **settings** saved per game (`game.settings`: volume, music, [... omitted end of long line]\n135:- Adjust: `new E.Game({ menu: { items: [['Restart', fn]], settings: [{ key: 'hints', label: 'Hints', value: true }, { key: 'difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal' }], contro [... omitted end of long line]\n145:- Players (two to four on one machine): `game.players` is `[game.input, ...]`, each an input with this API, its `player` number, `name` (`'P2'`), `color` (`E.PLAYER_COLORS`) and device. `game.allowJoi [... omitted end of long line]\n    }\n    return {...pos,x:pos.x+ORIGIN.x,y:pos.y+ORIGIN.y,yaw,pitch,roll,fov,ortho:false};\n  }\n  draw(r,state,players=state?.players,opts={}) {\n    if(!this.world)return;\n    this.state=state||this.state;this.players=players||this.state.players||this.players;this.options=opts||{};\n    const i=r.viewport?.i||0;\n    const p=this.players[i]||this.players[0]||{station:'pilot'};\n    const cam=this.world.cameras[i];cam.fixed=this.cameraPose(this.state.aircraft||defaults(),p,i);cam.update(0);\n    this.world.draw(r);\n    this.views[i]={cam:cam.cam,viewport:r.viewport?{...r.viewport}:null,W:r.W,H:r.H};\n    this.hints(r,p,i);\n  }\n  projectFor(i,x,y,z=0) {\n    const v=this.views[i];if(!v)return null;\n    const p=this.E.World3D.toThree(x+ORIGIN.x,y+ORIGIN.y,z);p.project(v.cam);\n    if(p.z<-1||p.z>1)return null;\n    const vp=v.viewport, W=vp?.w||v.W,H=vp?.h||v.H;\n    return [(vp?.x||0)+(p.x*.5+.5)*W,(vp?.y||0)+(.5-p.y*.5)*H];\n  }\n  onDraw(w,r) {\n    const s=this.state;if(!s)return;const a=s.aircraft||defaults(),i=r.viewport?.i||0,p=this.players[i]||this.players[0]||{station:'pilot'};\n    const pen=w.pen, t=s.t||0,exterior=this.options.exterior||this.options.freeCamera||p.station==='exterior';\n    // Rebuild for each viewport: native pen batches are consumed after every draw.\n    this.landmarks(pen,s);\n    this.drawClouds(pen,a,t);\n    this.bomber(pen,a,t,{exterior,station:p.station});\n    for(const e of s.enemies||[])if(e.alive!==false&&e.hp!==0)this.fighter(pen,e,t);\n    for(const b of s.bombs||[]){pen.at(b.x+ORIGIN.x,b.y+ORIGIN.y,b.z,Math.atan2(b.vy||0,b.vx||1),1,Math.atan2(b.vz||-1,Math.hypot(b.vx||0,b.vy||0)));pen.ball(0,0,0,12,4,4,C.oliveDark).cone(8,0,0,17,0,0,4,C.ink).box(-10,0,0,8,14,1.5,C.metal).box(-10,0,0,8,1.5,14,C.metal);}\n    pen.at();\n    for(const q of s.shots||[]){const c=q.team==='enemy'?'#ed9762':'#ffe7a2';pen.tube((q.px??q.x)+ORIGIN.x,(q.py??q.y)+ORIGIN.y,q.pz??q.z,q.x+ORIGIN.x,q.y+ORIGIN.y,q.z,q.team==='enemy'?2.4:2.1,c);pen.glow(q.x+ORIGIN.x,q.y+ORIGIN.y,q.z,4,c);}\n    for(const f of s.flak||[])this.flak(pen,f,t);\n    for(const e of s.effects||[])this.effect(pen,e,t);\n    if(!exterior)this.foreground(pen,w.camera.pose,p,a,s);\n    if(this.options.debug)this.debugVolumes(pen,s);\n    pen.at();\n  }\n  landmarks(p,s){\n    const t=s.t||0;\n    p.at(ORIGIN.x,ORIGIN.y,0);\n    // Runway centerline, threshold piano keys, approach lamps and hardstands.\n    p.box(0,0,4,7200,620,8,'#4c5b58').box(0,0,10,7200,12,1,'#d8d3af');\n    for(let i=-6;i<=6;i++){p.box(i*490,0,11,220,18,2,C.cream);if(i%2===0){p.glow(i*490,-330,18,7,C.amber).glow(i*490,330,18,7,C.amber);}}\n    for(const side of[-1,1])for(let k=0;k<5;k++)p.box(-3100,side*(70+k*39),11,370,19,2,C.cream);\n","exit_code":0,"status":"completed"}}
