{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '3035,3105p' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/engine/my-3d2dge.js && rg -n 'prototype\\\\.resume|resume\\\\(|_pauseInput' B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/vendor/engine/engine/my-3d2dge.js | head -18\"","aggregated_output":" *      menu stays there in play (it is the touch START), and over a menu screen a close button takes its place.\n *    - the page set up for phones: a viewport that reaches the safe areas, and no scrolling, zooming, text selection or\n *      callouts on the game's canvas (menus keep theirs).\n *    E.Shell draws the menu's screens (pause, settings, controls): section 21d.\n * ============================================================================= */\nconst ZOOM_PLAYER = [.5, 2];   // the player's zoom (settings.zoom): half to twice the game's, within each scene's range\nconst SETTINGS_VERSION = 2;   // 2: fullscreen false means turned off (version 1's also meant left by a gesture: forgotten)\n/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\n *  function of the game), min, max, step, options: [[value, label]], help, apply(game, value) }. Groups: Display,\n *  Sound, Comfort (the settings screen), Controller, Touch (the controls screen) */\nconst STANDARD_SETTINGS = {\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertAimY = !!v; } },\n  invertMoveX: { group: 'Controller', label: 'Invert move left and right', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveX = !!v; } },\n  invertMoveY: { group: 'Controller', label: 'Invert move up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveY = !!v; } },\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n};\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\nfunction settingValue(sp, v) {\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n  if (sp.type === 'bindings') {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n    const out = {};\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n    return out;\n  }\n  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\n}\nclass Settings {\n  /**\n   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n   * with the defaults (saved: false)\n   */\n  constructor(game, own = []) {\n    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n    hide('saved', true);\n    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n    hide('onChange', null);\n    const raw = store.get(this._key, null);\n    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n    for (const k in STANDARD_SETTINGS) if (!(game.o.touch === 'never' && STANDARD_SETTINGS[k].group === 'Touch')) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));   // (touch: 'never': no Touch group)\n    for (const sp of own) this.define(sp && !sp.label && Object.prototype.hasOwnProperty.call(STANDARD_SETTINGS, sp.key) ? Object.assign({ key: sp.key }, STANDARD_SETTINGS[sp.key], sp) : sp);   // (a standard key with no label: the game's fields over the standard ones; with a label it is the game's own)\n2531:   *  The player resumes (Escape, Start, Resume); resume() does it from code */\n2535:  resume() { this.paused = false; this.pauseReason = null; this._goOn = false; }\n2602:    if (this.paused) this.resume(); else this.menu();\n3033: *      and waits for the player (game.pause(reason), game.resume(), game.pauseReason).\n7769:      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\n7771:      resume();\n7792:  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept  [... omitted end of long line]\n9489:    this._stack.pop(); this._capEnd(); if (top.name === 'pause') this._game.resume();\n9493:  hide() { const p = this._stack.some(t => t.name === 'pause'); this._stack.length = 0; this._capEnd(); if (p) this._game.resume(); this._closed(); this._render(); return this; }\n9495:  _closed() { if (!this._stack.length && this._ownPause) { this._ownPause = false; this._game.resume(); } }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/content/credits.json <<'EOF'\n{\n \\\"sourceInformation\\\":{\\\"date\\\":\\\"2026-11-06 04:35:17\\\",\\\"source\\\":\\\"B-17 Bomber (Intellivision, 1982)\\\",\\\"plan\\\":\\\"PLAN.md\\\",\\\"genre\\\":\\\"Arcade flight action, station shooting and light mission planning\\\",\\\"perspective\\\":\\\"First-person pilot and four gun stations, downward bombsight, overhead operational map, exterior reveals\\\",\\\"tech\\\":\\\"my-3D2dge 0.89.1 + native World3D, Three.js 0.182.0, Rapier 0.19.3; JavaScript/Web Audio; Bun single-file bundle\\\",\\\"artDirection\\\":\\\"Original procedural chunky PS1/N64 geometry, olive aircraft, amber instruments and a blue Channel\\\",\\\"animation\\\":\\\"Native World3D pen, continuous math poses, native Humanoid radio portraits and fixed-step aircraft animations\\\",\\\"audio\\\":\\\"Original code-synthesized music, engines, weapons, flak and Animalese-style radio gibberish; music defaults to 10%\\\",\\\"online\\\":\\\"1–2 local couch co-op; AI Hub Session Protocol v1 shared-world, client 1.4.0\\\",\\\"testing\\\":\\\"Headless simulation, installed Playwright Chromium/WebKit stand-ins, offline synthesized audio, AI Hub harness; no physical pad or listener\\\",\\\"research\\\":\\\"Preserved original instructions and developers’ history at Blue Sky Rangers; preserved screenshots at Intv Funhouse. Original recordings not audited.\\\",\\\"environment\\\":\\\"Codex CLI (headless); Linux\\\",\\\"model\\\":\\\"OpenAI, gpt-6.1-sol, reasoning effort ultra\\\",\\\"usage\\\":\\\"added on import\\\"},\n \\\"testingFeedback\\\":[\\\"unknown\\\",\\\"unknown\\\",\\\"unknown\\\",\\\"unknown\\\"],\n \\\"engineFeedback\\\":[\\\"Native World3D pen, shapes, cameras and fixed-step E.Game made a coherent procedural aircraft possible.\\\",\\\"The split-view camera overlay is skipped by the renderer; foreground is drawn with the native world pen per viewport.\\\",\\\"Coupled bomber simulation, shared station authority, bombing ballistics and sortie orchestration.\\\",\\\"Portable dependency bundling and first-person geometry across two independent native viewports.\\\",\\\"No upstream engine source changes; extended native input, menus and World3D with game-specific systems.\\\",\\\"Make per-viewport first-person overlays a documented public rendering path.\\\"],\n \\\"promptFeedback\\\":[\\\"The full sortie loop and exact handoff schema gave the build a clear destination.\\\",\\\"The source jettisons fuel while the plan deliberately specifies payload jettison; the adaptation follows the plan.\\\",\\\"Proving one authoritative game across local co-op, portable file origin and AI Hub.\\\",\\\"Separate required acceptance gates from optional polish, and specify an expected evidence format.\\\"],\n \\\"aiHub\\\":{\\\"name\\\":\\\"B-17 Cross Channel Chaos\\\",\\\"tagline\\\":\\\"One bomber. Six stations. Bring everyone home.\\\",\\\"description\\\":\\\"Command a vulnerable four-engine bomber across the Channel. Defend four bearings, line up a military harbor strike, and get the crew home, solo or with a second crew member.\\\",\\\"type\\\":\\\"Game\\\",\\\"genre\\\":\\\"Flight\\\",\\\"source\\\":\\\"B-17 Bomber (Intellivision, 1982)\\\",\\\"series\\\":\\\"\\\",\\\"players\\\":\\\"1–2\\\",\\\"controls\\\":\\\"WASD fly, E/Q power, 1/2/3 stations, mouse aim, click/Space fire/release, M map, H hold; pad sticks, R2, Triangle, Square, L1/R1.\\\",\\\"tags\\\":[\\\"3d\\\",\\\"retro\\\",\\\"co-op\\\",\\\"first-person\\\",\\\"vehicles\\\",\\\"arcade\\\"]}\n}\nEOF\ncat > B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/ui.js <<'EOF'\nimport {LABELS,STATIONS,LOADOUTS,DIFFICULTIES,TUNING,DEFAULT_BALANCE,MISSION,U} from '../content/mission.js';\nimport CREDITS from '../content/credits.json';\nconst esc=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst \"'$(s,r=document)=>r.querySelector(s);\nconst minutes=t=>`${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'\"'0')}\"'`;\nexport class BomberUI{\n constructor(app){Object.assign(this,app);this.hud=$('\"'#hud');this.lastHud=0;this.setup={loadout:'balanced',difficulty:'normal',route:'direct',coop:false};this.wheelPlayer=null;this.preview='harbor';this.dev={freeCamera:false,debug:false,paused:false};\n  this.shell=new this.E.Shell(this.game,{theme:{scale:1,font:'Arial, sans-serif',titleFont:'Impact, sans-serif',ink:'#f2e8cb',paper:'#102f38',accent:'#ebbd6c'},screens:{pause:{kicker:'FLIGHT DESK',title:'Crew at ease',text:'The aircraft waits here. Resume when the crew is ready.',actions:[['Mission map',()=>this.map()],['Flight handbook',()=>this.controls()],['Dev mode',()=>this.devMenu()],['Leave sortie',()=>this.leaveMenu()]]}},standard:true});\n  for(const [key,label,min,max,step,unit]of TUNING)this.game.settings.define({key:'dev_'+key,label,type:'slider',value:DEFAULT_BALANCE[key],min,max,step,unit,group:'Flight tuning'});\n  this.game.settings.onChange=(key,value)=>{if(key.startsWith('dev_')){this.sim.balance[key.slice(4)]=value;this.sim.state.cheated=true;}if(key==='voice'){const b=this.game.audio.bus('voice');if(b)b.gain.value=value;}if(key==='captions')this.hud.style.setProperty('--caption-scale',value);};\n  this.shell.root.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&\"'!b.disabled)b.focus({preventScroll:true});});\n  this.shell.root.addEventListener('\"'pointerdown',()=>this.activity(),{passive:true});\n }\n show(name,spec){this.shell.show(name,spec);this.screenStamp++;this.hud.hidden=true;return this.shell;}\n clear(){this.shell.hide();this.game.input.clear();for(const i of this.game.players)i.clear();this.activity();}\n title(){this.clear();this.show('title',{kicker:'A CREW. A BOMBER. A WAY HOME.',name:'B-17\\\\nCROSS CHANNEL\\\\nCHAOS',subtitle:'Cross the water. Answer the warning.\\\\nBring everyone home.',actions:[['Fly a sortie',()=>this.brief(false)],['Co-op crew',()=>this.coopMenu()],['Practice',()=>this.practiceMenu()],['Settings',()=>this.settings()],['About / Credits',()=>this.about()]],meta:['1–2 CREW','10–12 MIN SORTIE','OPERATION COPPER TIDE'],footer:'An original flight game inspired by B-17 Bomber (1982).\\\\nIdle for a crew demonstration.'});this.activity();}\n settings(){this.show('settings',{title:'Make it your aircraft',text:'Your settings stay with this device.',rows:['#Flight & comfort','invertFlight','aimSensitivity','captions','voice','glyphs'],back:()=>{this.shell.back();}});}\n controls(){this.show('help',{kicker:'FLIGHT HANDBOOK',title:'Every station matters',text:'Route hold flies the selected course. Any flight stick input takes the aircraft back. The crew never releases your bombs.',keys:[['WASD / Left stick','Bank and pitch'],['Mouse / Right stick','Aim or look'],['Click · Space / R2','Fire gun / release bombs'],['Q · E / L1 · R1','Decrease / increase power'],['Tab / △','Station wheel'],['1 · 2 · 3','Pilot · threatened gun · bombsight'],['Arrows / D-pad','Guns: 12 · 3 · 6 · 9 o’clock'],['M / □','Operational map'],['H / L3','Toggle navigation hold'],['B · V / L1 · R1 in sight','Bomb doors · salvo size'],['F / ○','Extinguish engine fire (one bottle)'],['Hold J / R3 for 1.5s','Jettison remaining payload'],['Esc / Options','Pause / menu']],sections:[['Bombing','The gold impact ring predicts where your bomb will land, including velocity and wind. Open the sight early, keep the ship inside the ring, and release deliberately. The last bomb never prevents a return.'],['Crew assistance','Unattended guns suppress fighters. Leave a station to AI by taking another. An occupied station requires a second selection to exchange duties. Fire after the transition.'],['Touch','Drag the left half to fly and the right half to aim. Context actions appear for threats, bombing and return. The menu opens the map and emergency actions.']]});}\n coopMenu(){this.show('coop',{kicker:'TWO PEOPLE · ONE AIRCRAFT',title:'Assemble your crew',text:'One flies. One watches the glass. Both may change stations. Connect two standard pads, or use keyboard/mouse plus one pad. The shared sortie pauses for either crew member.',actions:[['Keyboard + controller',()=>{this.setup.coop=true;this.setup.coopMode='mixed';this.brief(true);}],['Two controllers',()=>{this.setup.coop=true;this.setup.coopMode='pads';this.brief(true);}],['Back',()=>this.shell.back()]]});}\n brief(coop=false){this.setup.coop=coop;this.show('brief',{kicker:'OPERATION 01 / COPPER TIDE',title:'Greyhaven. Then home.',text:'Destroy the armed transport at Greyhaven docks. Everything after that is your decision.',actions:[['Launch sortie',()=>this.start(this.setup)],['Route: '+(this.setup.route==='direct'?'Direct':'Northern dogleg'),()=>{this.setup.route=this.setup.route==='direct'?'dogleg':'direct';this.brief(coop);}],['Payload: '+LOADOUTS[this.setup.loadout].name,()=>{const a=Object.keys(LOADOUTS),i=a.indexOf(this.setup.loadout);this.setup.loadout=a[(i+1)%a.length];this.brief(coop);}],['Skill: '+DIFFICULTIES[this.setup.difficulty].name,()=>{const a=Object.keys(DIFFICULTIES);this.setup.difficulty=a[(a.indexOf(this.setup.difficulty)+1)%a.length];this.brief(coop);}],['Back',()=>this.shell.back()]]});\n  const grid=document.createElement('div');grid.className='brief-grid';grid.innerHTML=\"'`<div class=\"map-board\">${this.mapSvg(false)}<div class=\"map-key\"><span>CHANNEL SECTOR / 06:40</span><span>N ↑ · 5 KM GRID</span></div></div><div class=\"brief-copy\"><h3>THE TRANSPORT IS THE TARGET</h3><p>A naval transport shelters between the cranes. One accurate two-bomb salvo can finish the primary.</p><p>Direct: shorter crossing, defended coast.<br>Dogleg: longer flight, a quieter approach.</p><div class=\"loadout\"><strong>${LOADOUTS[this.setup.loadout].name}</strong><p>${LOADOUTS[this.setup.loadout].desc}<br>${LOADOUTS[this.setup.loadout].reserve}</p></div><p>Guns can jam. A sight can fail. One fire bottle buys a second chance. Home repairs, refuels and rearms.</p></div>`;\n  $('\"'.esh-mod',this.shell.root).insertBefore(grid,\"'$('\"'.esh-btns',this.shell.root));this.bindMap(grid,false);\n }\n mapSvg(live=true){const s=this.sim.state,a=s.aircraft,kx=x=>55+(x+10000)/460000*620,ky=y=>130+(y+10000)/230000*220,home=[kx(0),ky(0)],harbor=[kx(340000),ky(18000)],dog=[kx(140000),ky(-66000)];\n  return \"'`<svg viewBox=\"0 0 720 330\" role=\"img\" aria-label=\"Operational map of the Channel, Rookfield, Greyhaven and Bracken\"><defs><pattern id=\"chart-grid\" width=\"72\" height=\"55\" patternUnits=\"userSpaceOnUse\"><path d=\"M72 0H0V55\" fill=\"none\" stroke=\"#45665f\" stroke-width=\".6\" opacity=\".6\"/></pattern></defs><rect width=\"720\" height=\"330\" fill=\"#143745\"/><path d=\"M0 0H95L108 65 92 100 110 150 98 205 120 245 90 330H0Z\" fill=\"#536b50\" stroke=\"#b3b18a\" stroke-width=\"2\"/><path d=\"M470 0L454 56 476 94 451 122 480 154 460 180 476 208 460 250 492 288 480 330H720V0Z\" fill=\"#5c7051\" stroke=\"#b3b18a\" stroke-width=\"2\"/><path d=\"M470 153 Q530 150 564 165 L550 178 478 174\" fill=\"#143745\"/><rect width=\"720\" height=\"330\" fill=\"url(#chart-grid)\"/><text x=\"14\" y=\"26\" class=\"map-minor\">ENGLAND</text><text x=\"548\" y=\"28\" class=\"map-minor\">OCCUPIED COAST</text><text x=\"238\" y=\"276\" class=\"map-label\" opacity=\".5\" transform=\"rotate(-8,238,276)\">THE CHANNEL</text><path d=\"M${home}L${this.setup.route==='\"'dogleg'?dog+'L':''}\"'${harbor}\" fill=\"none\" stroke=\"#ebbd6c\" stroke-width=\"2\" stroke-dasharray=\"7 6\"/><circle cx=\"${kx(270000)}\" cy=\"${ky(-12000)}\" r=\"26\" fill=\"#d5764c\" opacity=\".2\"/><circle cx=\"${harbor[0]}\" cy=\"${harbor[1]}\" r=\"35\" fill=\"#d5764c\" opacity=\".13\"/>\n ${Object.entries(MISSION.waypoints).map(([id,t])=>{const x=kx(t.x),y=ky(t.y);return `<g class=\"map-hit\" data-target=\"${id}\" tabindex=\"0\" role=\"button\" aria-label=\"Preview ${esc(t.label)}\"><circle cx=\"${x}\" cy=\"${y}\" r=\"${id==='\"'harbor'?8:5}\\\" fill=\\\"\"'${id==='\"'home'?'#9fc8a2':id==='harbor'?'#ebbd6c':'#b5c5ae'}\\\" stroke=\\\"#0e2a32\\\" stroke-width=\\\"2\\\"/><circle cx=\\\"\"'${x}\" cy=\"${y}\" r=\"20\" fill=\"transparent\"/><text class=\"map-label\" x=\"${x+(id==='\"'refinery'?-130:12)}\\\" y=\\\"\"'${y+(id==='\"'home'?-12:5)}\\\">\"'${esc(t.label)}</text></g>`;}).join('\"'')}\n \"'${live?`<g transform=\"translate(${kx(a.x)},${ky(a.y)}) rotate(${a.yaw*180/Math.PI+90})\"><path d=\"M0 -12L8 8 0 4 -8 8Z\" fill=\"#fff3cf\" stroke=\"#122d33\" stroke-width=\"2\"/></g>`:'\"''}<text x=\\\"680\\\" y=\\\"30\\\" class=\\\"map-label\\\">N ↑</text></svg>\"'`;\n }\n bindMap(root,live){root.querySelectorAll('\"'[data-target]').forEach(e=>{const f=()=>{this.preview=e.dataset.target;if(live)this.map();else{const copy=\"'$('\"'.brief-copy',root);const t=MISSION.waypoints[this.preview];copy.querySelector('h3').textContent=t.label;copy.querySelector('p').textContent=this.targetDescription(this.preview);}};e.addEventListener('click',f);e.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();f();}});});}\n targetDescription(id){return{harbor:'Primary: armed transport. Two direct hits, or one centered salvo. Harbor tanks and works offer optional score.',battery:'Optional: cliff battery. Destroy it to suppress this coast’s barrage. It is not required for the primary.',refinery:'Optional: Bracken refinery. Two hits. Only continue if fuel and ordnance permit.',home:'Rookfield: cross the approach circle to trigger assisted recovery. A safe abort saves the crew.',dogleg:'Northern dogleg. Longer distance; more time to answer fighter warnings before the coast.'}[id];}\n map(){const s=this.sim.state;this.show('navigation',{kicker:'NAVIGATOR / AIRCRAFT CONTINUES',title:'Choose your next move',text:'Fuel and flight continue while this chart is open. Only the flight commander can commit a course.',actions:[['Fly to '+MISSION.waypoints[this.preview].label,()=>{this.send({type:'route',target:this.preview});this.clear();}],['Primary: Greyhaven',()=>{this.preview='harbor';this.map();}],['Return: Rookfield',()=>{this.preview='home';this.map();}],['Optional: Refinery',()=>{this.preview='refinery';this.map();}],['Optional: Battery',()=>{this.preview='battery';this.map();}],['Back to station',()=>this.clear()]]});\n  const board=document.createElement('div');board.className='brief-grid';board.innerHTML=\"'`<div class=\"map-board\">${this.mapSvg()}<div class=\"map-key\"><span>LIVE POSITION</span><span>NO PAUSE</span></div></div><div class=\"brief-copy\"><h3>${MISSION.waypoints[this.preview].label}</h3><p>${this.targetDescription(this.preview)}</p><div class=\"loadout\"><strong>RETURN FORECAST</strong><p>${Math.round(s.aircraft.fuel/s.aircraft.maxFuel*100)}% fuel · ${s.bombsLeft} bombs<br>${Math.max(0,Math.round(s.reserve||0))} seconds above estimated home fuel.<br>Home approach is always available.</p></div></div>`;$('\"'.esh-mod',this.shell.root).insertBefore(board,\"'$('\"'.esh-btns',this.shell.root));this.bindMap(board,true);this.game.resume();\n }\n wheel(id){this.wheelPlayer=id;this.show('stations',{kicker:'STATION SELECT / AI HOLDS COURSE',title:'Your next job',text:'Each gun watches its own bearing. Select an occupied station twice to exchange duties.',actions:STATIONS.map(station=>[LABELS[station]+(this.sim.state.owners[station]==='AI'?' · CREW':this.sim.state.owners[station]===id?' · YOU':' · P'+this.sim.state.owners[station]),()=>{const busy=this.sim.state.owners[station]\"'!=='\"'AI'&&this.sim.state.owners[station]\"'!==id;const key=id+station;if(busy&&this.requestKey!==key){this.requestKey=key;this.send({type:'\"'station',station},id);this.wheel(id);return;}this.send({type:'station',station,handover:busy},id);this.requestKey=null;this.clear();}]).concat([['Back',()=>this.clear()]])});this.game.resume();}\n practiceMenu(){this.show('practice',{kicker:'GROUND SCHOOL / LIVE SYSTEMS',title:'Learn the crew’s jobs',text:'Short drills use the same weapons, bombs, fuel and damage as the operation. Return home or end the drill from pause.',actions:[['Directional gunnery',()=>this.start({...this.setup,coop:false,practice:'gunnery'})],['Bomb calibration',()=>this.start({...this.setup,coop:false,practice:'bombing'})],['Damaged return',()=>this.start({...this.setup,coop:false,practice:'return'})],['Back',()=>this.shell.back()]]});}\n leaveMenu(){this.show('leave',{kicker:'LEAVE SORTIE',title:'Close the flight log?',text:'A safe abort is available through the map. Ending here records the current outcome.',actions:[['Continue flying',()=>this.shell.back()],['End and debrief',()=>{this.sim.result('manual');this.clear();}],['Title screen',()=>this.toTitle()]]});}\n devMenu(){if(this.online.active){this.show('dev',{kicker:'LIVE HUB ROUND',title:'The authority stays in charge',text:'World-changing developer tools are available in standalone flight. Display, controls and audio settings remain local to you.',actions:[['Settings',()=>this.settings()],['Back',()=>this.shell.back()]]});return;}\n  this.show('dev',{kicker:'DEVELOPER FLIGHT DESK · RUN MARKED',title:'Test the whole aircraft',text:'Changes are live. Every tool marks this sortie as a test run. Controller: up/down selects, left/right adjusts sliders.',rows:TUNING.map(t=>'dev_'+t[0]),actions:[['Reset tuning',()=>{for(const[k,v]of Object.entries(DEFAULT_BALANCE)){this.game.settings.set('dev_'+k,v);this.sim.balance[k]=v;}this.devMenu();}],['Resume test flight',()=>{this.clear();this.game.resume();}]]});\n  const tools=document.createElement('div');tools.className='dev-tools';const buttons=[['Invulnerable: '+(this.sim.state.invulnerable?'ON':'OFF'),()=>this.sim.dev('invulnerable',\"'!this.sim.state.invulnerable)],['\"'Infinite stores: '+(this.sim.state.infinite?'ON':'OFF'),()=>this.sim.dev('infinite',\"'!this.sim.state.infinite)],['\"'Free camera: '+(this.dev.freeCamera?'ON':'OFF'),()=>this.dev.freeCamera=\"'!this.dev.freeCamera],['\"'Collision / trigger volumes',()=>this.dev.debug=\"'!this.dev.debug],['\"'Jump: intercept',()=>this.sim.dev('jump','intercept')],['Jump: coast',()=>this.sim.dev('jump','coast')],['Jump: bomb approach',()=>this.sim.dev('jump','bomb')],['Teleport home approach',()=>this.sim.dev('jump','home')],['Spawn nose fighter',()=>this.sim.dev('fighter','nose')],['Spawn port fighter',()=>this.sim.dev('fighter','port')],['Spawn starboard fighter',()=>this.sim.dev('fighter','starboard')],['Spawn tail fighter',()=>this.sim.dev('fighter','tail')],['Spawn flak danger',()=>this.sim.dev('flak')],['Damage engine',()=>this.sim.dev('damage','engine')],['Start engine fire',()=>this.sim.dev('damage','fire')],['Jam gun',()=>this.sim.dev('damage','gun')],['Damage sight',()=>this.sim.dev('damage','sight')],['Repair all systems',()=>this.sim.dev('repair')],['Pause / step: '+(this.dev.paused?'FROZEN':'RUNNING'),()=>{this.dev.paused=\"'!this.dev.paused;this.game.resume();}],['\"'Step 1/60 second',()=>{this.sim.step(1/120);this.sim.step(1/120);}],['Export state JSON',()=>this.download('bomber-state.json',JSON.stringify(this.sim.snapshot(),null,2))],['Mission authoring',()=>this.editor()],['Restart same seed',()=>this.start({...this.setup,seed:this.sim.state.seed})]];\n  for(const[label,fn]of buttons){const b=document.createElement('button');b.textContent=label;b.onclick=()=>{this.sim.state.cheated=true;fn();if(this.shell.screen==='dev')this.devMenu();};tools.append(b);}const box=\"'$('\"'.esh-mod',this.shell.root);box.insertBefore(tools,\"'$('\"'.esh-btns',box));this.sim.state.cheated=true;\n }\n editor(){this.show('editor',{kicker:'MISSION AUTHORING / DATA DRIVEN',title:'Place the next objective',text:'Choose a waypoint, enter world coordinates in metres and apply. Export the definition for another operation. Trigger volumes are shown in the flight test view.',actions:[['Export mission JSON',()=>this.download('copper-tide.json',this.sim.exportMission())],['Import mission JSON',()=>this.importFile()],['Back',()=>this.shell.back()]]});const div=document.createElement('div');div.className='mission-editor';div.innerHTML='<div id=\\\"editor-picks\\\"></div><label>East <input id=\\\"edit-x\\\" type=\\\"number\\\" step=\\\"10\\\"></label><label>South <input id=\\\"edit-y\\\" type=\\\"number\\\" step=\\\"10\\\"></label><div id=\\\"editor-message\\\" aria-live=\\\"polite\\\"></div>';\n  const picks=\"'$('\"'#editor-picks',div);let selected='harbor';const load=id=>{selected=id;\"'$('\"'#edit-x',div).value=Math.round(this.sim.definition.waypoints[id].x/U);\"'$('\"'#edit-y',div).value=Math.round(this.sim.definition.waypoints[id].y/U);};for(const[id,p]of Object.entries(this.sim.definition.waypoints)){const b=document.createElement('button');b.textContent=p.label;b.onclick=()=>load(id);picks.append(b);}const apply=document.createElement('button');apply.textContent='Apply waypoint & associated target';apply.onclick=()=>{const x=Number(\"'$('\"'#edit-x',div).value)*U,y=Number(\"'$('\"'#edit-y',div).value)*U;if(\"'!Number.isFinite(x)||!Number.isFinite(y))return;Object.assign(this.sim.definition.waypoints[selected],{x,y});const id=selected==='\"'harbor'?'ship':selected;for(const list of[this.sim.definition.targets,this.sim.state.targets]){const t=list.find(t=>t.id===id);if(t)Object.assign(t,{x,y});}this.sim.state.cheated=true;this.dev.debug=true;\"'$('\"'#editor-message',div).textContent='Position applied. Export retains these changes.';};div.append(apply);\"'$('\"'.esh-mod',this.shell.root).insertBefore(div,\"'$('\"'.esh-btns',this.shell.root));load('harbor');}\n importFile(){const f=document.createElement('input');f.type='file';f.accept='.json';f.onchange=async()=>{try{this.sim.importMission(await f.files[0].text());this.shell.toast('Mission imported','Definition validated. Restart applies new encounters.');}catch(e){this.shell.toast('Import rejected',e.message);}};f.click();}\n download(name,text){const url=URL.createObjectURL(new Blob([text],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\n about(page=0){this.show('about',{kicker:'BUILT FOR THE CREW',title:'Source, craft & credits',text:'An original game inspired by B-17 Bomber. No affiliation with the original publishers. Original art, music, effects and gibberish voices are generated in code.',actions:[['Source Information',()=>this.about(0)],['Testing Feedback',()=>this.about(1)],['Engine Feedback',()=>this.about(2)],['Prompt Feedback',()=>this.about(3)],['Back',()=>this.shell.back()]]});const q=[[],['Issues caught','Critical / game-breaking','Most helpful test','Least helpful test'],['Liked most','Stuck or guessed wrong','Built for this game','Hardest engine task','Engine changes','One requested change'],['Liked most','Confusing','Hardest task','Suggested change']];const keys=['sourceInformation','testingFeedback','engineFeedback','promptFeedback'],title=['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback'];const div=document.createElement('div');div.className='credit-content';if(\"'!page){div.innerHTML='\"'<h3>Source Information</h3><dl>'+Object.entries(CREDITS.sourceInformation).map(([k,v])=>\"'`<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('\"'')+'</dl><h3>Research & notices</h3><p><a href=\\\"https://history.blueskyrangers.com/instructions/b17bomber.html\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Original instructions</a> · <a href=\\\"https://history.blueskyrangers.com/mattelelectronics/games/b17bomber.html\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Developer history</a> · <a href=\\\"https://www.intvfunhouse.com/games/b17b.php\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Preserved screenshots</a></p><p>my-3D2dge and Three.js: MIT. Rapier: Apache 2.0. Full notices are embedded in this file.</p>';const details=document.createElement('details');details.innerHTML='<summary>Full dependency notices</summary>';const pre=document.createElement('pre');pre.style.whiteSpace='pre-wrap';pre.style.fontSize='.8em';pre.textContent=\"'$('\"'#legal-notices').textContent;details.append(pre);div.append(details);}else div.innerHTML=\"'`<h3>${title[page]}</h3>`+CREDITS[keys[page]].map((v,i)=>`<p><strong>${q[page][i]}</strong><br>${esc(v)}</p>`).join('\"'');\"'$('\"'.esh-mod',this.shell.root).insertBefore(div,\"'$('\"'.esh-btns',this.shell.root));}\n results(){const s=this.sim.state,r=s.result;this.clear();this.show('results',{kicker:(s.practice?'PRACTICE / ':s.cheated?'TEST RUN / ':'FLIGHT LOG / ')+MISSION.name,title:r.outcome,emblem:r.win?'✦':'◇',text:{success:'Primary destroyed. Crew recovered. Rookfield will repair, refuel and rearm the aircraft.',abort:'Crew recovered. The primary remains. A safe abort leaves another sortie.',deadline:'Operation deadline reached. Current progress is recorded.',destroyed:'The aircraft was lost. Review the warnings and try another approach.','fuel-exhausted':'Fuel exhausted. Route and loadout choices leave a larger reserve.','ground-impact':'Ground impact. Keep airspeed and altitude above the danger zone.',fire:'Engine fire spread beyond recovery. Use the single bottle early.'}[r.reason]||'Your sortie is recorded. Repair, refuel and rearm for another run.',stats:[[r.score.toLocaleString(),'TOTAL SCORE'],[r.stats.kills,'FIGHTERS DOWN'],[r.stats.accuracy+'%','BOMB ACCURACY'],[minutes(r.stats.duration),'FLIGHT TIME'],[r.stats.fuel+'%','FUEL REMAINING'],[r.stats.returnBonus,'RETURN BONUS']],medals:[['Primary destroyed',r.stats.primary],['Crew recovered',r.stats.returned],['Damage −'+r.stats.damagePenalty,r.stats.damagePenalty===0],['Wasted bombs −'+r.stats.wastedPenalty,r.stats.wastedPenalty===0]],actions:[['Repair, rearm & fly again',()=>this.start({...this.setup,seed:((s.seed+7919)>>>0)})],['Review briefing',()=>{this.toTitle();this.brief(this.setup.coop);}],['Title screen',()=>this.toTitle()]]});}\n paint(dt){const s=this.sim.state;if(this.game.sceneName\"'!=='\"'play'||s.attract){this.hud.hidden=true;return;}if(this.shell.screen){this.hud.hidden=true;return;}if(this.game.real-this.lastHud<.08)return;this.lastHud=this.game.real;const pp=this.localPlayers(),split=pp.length>1,a=s.aircraft,primary=s.primary;this.hud.hidden=false;this.hud.className=(split?'split ':'')+(this.touch.active?'touch-mode':'');\n const objective=s.phase==='return'||s.phase==='landing'?'BRING THE CREW HOME':primary?'PRIMARY DESTROYED · CHOOSE HOME':'DESTROY THE ARMED TRANSPORT';const fuel=Math.round(a.fuel/a.maxFuel*100),heading=((a.yaw*180/Math.PI+90+360)%360),d=Math.hypot(s.route.x-a.x,s.route.y-a.y)/U/1000;\n let html=\"'`<div class=\"hud-top\"><div class=\"objective\"><div class=\"mini\">COPPER TIDE / ${s.phase.toUpperCase()}</div><b>${objective}</b><small>${esc(s.route.label)} · ${d.toFixed(1)} KM · ${minutes(s.t)} / 12:00</small></div><div class=\"vitals\"><div class=\"vital\"><label>FUEL RESERVE</label><strong>${fuel}%</strong><div class=\"bar\"><i style=\"width:${fuel}%\"></i></div></div><div class=\"vital\"><label>AIRFRAME</label><strong>${Math.round(a.hull)}%</strong><div class=\"bar\"><i style=\"width:${a.hull}%;background:${a.hull<35?'\"'#e78c69':'#a8c7a4'}\\\"></i></div></div></div><button class=\\\"menu-toggle\\\" aria-label=\\\"Pause menu\\\">☰</button></div>\"'`;\n if(split)html+='\"'<div class=\\\"split-line\\\"></div>';\n pp.forEach((p,i)=>{const I=this.game.players[i]||this.game.input,k=action=>esc(I.label(action)),gun=s.mounts[p.station],status=gun?\"'`${gun.jammed?'\"'JAMMED':gun.ammo+' ROUNDS'} · \"'${Math.round((p.aim.yaw||0)*180/Math.PI)}° TRAVERSE`:p.station==='\"'bombs'?\"'`${s.bombsLeft} BOMBS · SALVO ${s.salvo} · ${a.doors>.85?'\"'DOORS OPEN':'DOORS MOVING'}\"'`:`${a.hold?'\"'NAV HOLD':'MANUAL FLIGHT'} · POWER \"'${Math.round(a.throttle*100)}%`;\n const tip=gun?`${k('\"'fire')} Fire &nbsp; \"'${k('\"'zoom')} Fine aim &nbsp; Arrows / D-pad bearing\"'`:p.station==='\"'bombs'?\"'`${k('\"'fire')} Release &nbsp; \"'${k('\"'doors')} Doors &nbsp; \"'${k('\"'salvo')} Salvo\"'`:`${k('\"'up')} \"'${k('\"'left')} \"'${k('\"'down')} \"'${k('\"'right')} Fly &nbsp; \"'${k('\"'hold')} Hold &nbsp; \"'${k('\"'throttleUp')} / \"'${k('\"'throttleDown')} Power\"'`;\n html+=`<div class=\"seat-hud ${i?'\"'p2':''}\\\"><div class=\\\"mini\\\">\"'${split?'\"'P'+p.id+' / ':''}\"'${esc(p.name||'\"'AIRCREW')} · \"'${s.commandOwner===p.id?'\"'COMMAND':'CREW'}</div><b>\"'${LABELS[p.station]}</b><div class=\"readings\"><strong>${status}</strong></div><div class=\"prompts\">${tip}<br>${k('\"'wheel')} Stations &nbsp; \"'${k('\"'map')} Map &nbsp; \"'${k('\"'pause')} Menu</div><div class=\\\"station-links\\\"><button data-station=\\\"pilot\\\" data-player=\\\"\"'${p.id}\">1 FLIGHT</button><button data-station=\"${s.enemies.find(e=>e.alive)?.bearing||'\"'nose'}\\\" data-player=\\\"\"'${p.id}\">2 GUNS</button><button data-station=\"bombs\" data-player=\"${p.id}\">3 SIGHT</button></div></div><div class=\"instrument ${i?'\"'p2':''}\\\"><label>\"'${p.station==='\"'bombs'?'TIME TO IMPACT':'ALTITUDE / AIRSPEED'}</label><strong>\"'${p.station==='\"'bombs'?s.prediction.time.toFixed(1)+' SEC':Math.round(a.z/U)+' M'}</strong><small>\"'${Math.round(a.speed/U*3.6)} KM/H · HDG ${String(Math.round(heading)).padStart(3,'\"'0')}°</small></div>\"'`;\n if(gun)html+=`<div class=\"reticle ${i?'\"'p2':''}\\\"></div>\"'`;\n });\n if(s.caption){const role=MISSION.crew[s.caption.role]||'\"'AIRCREW';html+=\"'`<div class=\"radio ${s.caption.urgent?'\"'urgent':''}\\\" style=\\\"font-size:\"'${this.game.settings.captions}em\"><canvas id=\"crew-portrait\" width=\"90\" height=\"90\"></canvas><div><div class=\"role\">RADIO / ${esc(role)}</div><p>${esc(s.caption.text)}</p></div></div>`;}\n if(s.warning)html+=`<div class=\"warning\">${esc(s.warning)}</div>`;if(s.cheated)html+='\"'<div class=\\\"cheat-badge\\\">DEV FLIGHT · SCORES UNSAVED</div>';\n if(pp.some(p=>p.station==='bombs')){const dist=Math.hypot(s.prediction.x-s.targets[0].x,s.prediction.y-s.targets[0].y)/U,ready=dist<110;html+=\"'`<div class=\"bomb-inset\"><label>${s.sightDamaged?'\"'COARSE SIGHT · DAMAGED':'BOMB SOLUTION · WIND INCLUDED'}</label><strong>\"'${primary?'\"'PRIMARY CONFIRMED':ready?'RELEASE WINDOW':'IMPACT OFFSET '+Math.round(dist)+' M'}</strong><small>\"'${primary?'\"'Select HOME on the map.':ready?'Transport in blast radius. Fire to release.':'Guide the gold ring over the transport.'}<br>Wind \"'${Math.round(s.wind.y*1.5)} kn right · ${s.bombsLeft} bombs left</small></div>`;}\n if(s.lastImpact&&s.t-s.lastImpact.at<7)html+=`<div class=\"bomb-inset\"><label>IMPACT REPORT</label><strong>${s.lastImpact.hit?'\"'DIRECT HIT':'SPLASH / WIDE'}</strong><small>\"'${s.primary?'\"'Transport destroyed. Set a return course.':s.bombsLeft?'Another pass remains available.':'Set course for Rookfield.'}</small></div>\"'`;\n const p=pp[0],threat=s.enemies.find(e=>e.alive),context=[];if(a.fire)context.push(['\"'EXTINGUISH','extinguish']);if(p?.station==='bombs')context.push([\"'`RELEASE ×${s.salvo}`,'\"'release']);else if(a.x>240000&&\"'!s.primary&&s.bombsLeft)context.push(['\"'BOMB SIGHT','bombs']);else if(threat)context.push([\"'`GUN · ${{nose:12,starboard:3,tail:6,port:9}[threat.bearing]}`,'\"'gun']);if(primary||\"'!s.bombsLeft)context.push(['\"'HOME','home']);if(\"'!context.length)context.push(['\"'STATIONS','stations']);html+='<div class=\\\"touch-actions\\\">'+context.map(([l,id])=>\"'`<button data-context=\"${id}\">${l}</button>`).join('\"'')+'</div>';\n this.hud.innerHTML=html;\"'$('\"'.menu-toggle',this.hud).onclick=()=>this.game.menu();this.hud.querySelectorAll('[data-station]').forEach(b=>b.onclick=()=>{this.send({type:'station',station:b.dataset.station,handover:false},Number(b.dataset.player));this.clear();});this.hud.querySelectorAll('[data-context]').forEach(b=>b.onclick=()=>{const c=b.dataset.context;if(c==='release')this.send({type:'release',salvo:s.salvo});else if(c==='home')this.send({type:'route',target:'home'});else if(c==='bombs')this.send({type:'station',station:'bombs'});else if(c==='gun')this.send({type:'station',station:threat.bearing});else if(c==='stations')this.wheel(p.id);else this.send({type:c});});\n const cv=\"'$('\"'#crew-portrait',this.hud);if(cv){const rig=this.portraits[s.caption.role]||this.portraits.pilot;rig.update(dt,{expr:s.caption.urgent?'shout':'smile'});rig.drawPortrait(cv.getContext('2d'),45,45,86,{zoom:2.6,turn:.3,bg:'#29484b',frame:false});}\n }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/content/credits.json <<'EOF'\n{\n \\\"sourceInformation\\\":{\\\"date\\\":\\\"2026-11-06 04:35:17\\\",\\\"source\\\":\\\"B-17 Bomber (Intellivision, 1982)\\\",\\\"plan\\\":\\\"PLAN.md\\\",\\\"genre\\\":\\\"Arcade flight action, station shooting and light mission planning\\\",\\\"perspective\\\":\\\"First-person pilot and four gun stations, downward bombsight, overhead operational map, exterior reveals\\\",\\\"tech\\\":\\\"my-3D2dge 0.89.1 + native World3D, Three.js 0.182.0, Rapier 0.19.3; JavaScript/Web Audio; Bun single-file bundle\\\",\\\"artDirection\\\":\\\"Original procedural chunky PS1/N64 geometry, olive aircraft, amber instruments and a blue Channel\\\",\\\"animation\\\":\\\"Native World3D pen, continuous math poses, native Humanoid radio portraits and fixed-step aircraft animations\\\",\\\"audio\\\":\\\"Original code-synthesized music, engines, weapons, flak and Animalese-style radio gibberish; music defaults to 10%\\\",\\\"online\\\":\\\"1–2 local couch co-op; AI Hub Session Protocol v1 shared-world, client 1.4.0\\\",\\\"testing\\\":\\\"Headless simulation, installed Playwright Chromium/WebKit stand-ins, offline synthesized audio, AI Hub harness; no physical pad or listener\\\",\\\"research\\\":\\\"Preserved original instructions and developers’ history at Blue Sky Rangers; preserved screenshots at Intv Funhouse. Original recordings not audited.\\\",\\\"environment\\\":\\\"Codex CLI (headless); Linux\\\",\\\"model\\\":\\\"OpenAI, gpt-6.1-sol, reasoning effort ultra\\\",\\\"usage\\\":\\\"added on import\\\"},\n \\\"testingFeedback\\\":[\\\"unknown\\\",\\\"unknown\\\",\\\"unknown\\\",\\\"unknown\\\"],\n \\\"engineFeedback\\\":[\\\"Native World3D pen, shapes, cameras and fixed-step E.Game made a coherent procedural aircraft possible.\\\",\\\"The split-view camera overlay is skipped by the renderer; foreground is drawn with the native world pen per viewport.\\\",\\\"Coupled bomber simulation, shared station authority, bombing ballistics and sortie orchestration.\\\",\\\"Portable dependency bundling and first-person geometry across two independent native viewports.\\\",\\\"No upstream engine source changes; extended native input, menus and World3D with game-specific systems.\\\",\\\"Make per-viewport first-person overlays a documented public rendering path.\\\"],\n \\\"promptFeedback\\\":[\\\"The full sortie loop and exact handoff schema gave the build a clear destination.\\\",\\\"The source jettisons fuel while the plan deliberately specifies payload jettison; the adaptation follows the plan.\\\",\\\"Proving one authoritative game across local co-op, portable file origin and AI Hub.\\\",\\\"Separate required acceptance gates from optional polish, and specify an expected evidence format.\\\"],\n \\\"aiHub\\\":{\\\"name\\\":\\\"B-17 Cross Channel Chaos\\\",\\\"tagline\\\":\\\"One bomber. Six stations. Bring everyone home.\\\",\\\"description\\\":\\\"Command a vulnerable four-engine bomber across the Channel. Defend four bearings, line up a military harbor strike, and get the crew home, solo or with a second crew member.\\\",\\\"type\\\":\\\"Game\\\",\\\"genre\\\":\\\"Flight\\\",\\\"source\\\":\\\"B-17 Bomber (Intellivision, 1982)\\\",\\\"series\\\":\\\"\\\",\\\"players\\\":\\\"1–2\\\",\\\"controls\\\":\\\"WASD fly, E/Q power, 1/2/3 stations, mouse aim, click/Space fire/release, M map, H hold; pad sticks, R2, Triangle, Square, L1/R1.\\\",\\\"tags\\\":[\\\"3d\\\",\\\"retro\\\",\\\"co-op\\\",\\\"first-person\\\",\\\"vehicles\\\",\\\"arcade\\\"]}\n}\nEOF\ncat > B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/ui.js <<'EOF'\nimport {LABELS,STATIONS,LOADOUTS,DIFFICULTIES,TUNING,DEFAULT_BALANCE,MISSION,U} from '../content/mission.js';\nimport CREDITS from '../content/credits.json';\nconst esc=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst \"'$(s,r=document)=>r.querySelector(s);\nconst minutes=t=>`${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'\"'0')}\"'`;\nexport class BomberUI{\n constructor(app){Object.assign(this,app);this.hud=$('\"'#hud');this.lastHud=0;this.setup={loadout:'balanced',difficulty:'normal',route:'direct',coop:false};this.wheelPlayer=null;this.preview='harbor';this.dev={freeCamera:false,debug:false,paused:false};\n  this.shell=new this.E.Shell(this.game,{theme:{scale:1,font:'Arial, sans-serif',titleFont:'Impact, sans-serif',ink:'#f2e8cb',paper:'#102f38',accent:'#ebbd6c'},screens:{pause:{kicker:'FLIGHT DESK',title:'Crew at ease',text:'The aircraft waits here. Resume when the crew is ready.',actions:[['Mission map',()=>this.map()],['Flight handbook',()=>this.controls()],['Dev mode',()=>this.devMenu()],['Leave sortie',()=>this.leaveMenu()]]}},standard:true});\n  for(const [key,label,min,max,step,unit]of TUNING)this.game.settings.define({key:'dev_'+key,label,type:'slider',value:DEFAULT_BALANCE[key],min,max,step,unit,group:'Flight tuning'});\n  this.game.settings.onChange=(key,value)=>{if(key.startsWith('dev_')){this.sim.balance[key.slice(4)]=value;this.sim.state.cheated=true;}if(key==='voice'){const b=this.game.audio.bus('voice');if(b)b.gain.value=value;}if(key==='captions')this.hud.style.setProperty('--caption-scale',value);};\n  this.shell.root.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&\"'!b.disabled)b.focus({preventScroll:true});});\n  this.shell.root.addEventListener('\"'pointerdown',()=>this.activity(),{passive:true});\n }\n show(name,spec){this.shell.show(name,spec);this.screenStamp++;this.hud.hidden=true;return this.shell;}\n clear(){this.shell.hide();this.game.input.clear();for(const i of this.game.players)i.clear();this.activity();}\n title(){this.clear();this.show('title',{kicker:'A CREW. A BOMBER. A WAY HOME.',name:'B-17\\\\nCROSS CHANNEL\\\\nCHAOS',subtitle:'Cross the water. Answer the warning.\\\\nBring everyone home.',actions:[['Fly a sortie',()=>this.brief(false)],['Co-op crew',()=>this.coopMenu()],['Practice',()=>this.practiceMenu()],['Settings',()=>this.settings()],['About / Credits',()=>this.about()]],meta:['1–2 CREW','10–12 MIN SORTIE','OPERATION COPPER TIDE'],footer:'An original flight game inspired by B-17 Bomber (1982).\\\\nIdle for a crew demonstration.'});this.activity();}\n settings(){this.show('settings',{title:'Make it your aircraft',text:'Your settings stay with this device.',rows:['#Flight & comfort','invertFlight','aimSensitivity','captions','voice','glyphs'],back:()=>{this.shell.back();}});}\n controls(){this.show('help',{kicker:'FLIGHT HANDBOOK',title:'Every station matters',text:'Route hold flies the selected course. Any flight stick input takes the aircraft back. The crew never releases your bombs.',keys:[['WASD / Left stick','Bank and pitch'],['Mouse / Right stick','Aim or look'],['Click · Space / R2','Fire gun / release bombs'],['Q · E / L1 · R1','Decrease / increase power'],['Tab / △','Station wheel'],['1 · 2 · 3','Pilot · threatened gun · bombsight'],['Arrows / D-pad','Guns: 12 · 3 · 6 · 9 o’clock'],['M / □','Operational map'],['H / L3','Toggle navigation hold'],['B · V / L1 · R1 in sight','Bomb doors · salvo size'],['F / ○','Extinguish engine fire (one bottle)'],['Hold J / R3 for 1.5s','Jettison remaining payload'],['Esc / Options','Pause / menu']],sections:[['Bombing','The gold impact ring predicts where your bomb will land, including velocity and wind. Open the sight early, keep the ship inside the ring, and release deliberately. The last bomb never prevents a return.'],['Crew assistance','Unattended guns suppress fighters. Leave a station to AI by taking another. An occupied station requires a second selection to exchange duties. Fire after the transition.'],['Touch','Drag the left half to fly and the right half to aim. Context actions appear for threats, bombing and return. The menu opens the map and emergency actions.']]});}\n coopMenu(){this.show('coop',{kicker:'TWO PEOPLE · ONE AIRCRAFT',title:'Assemble your crew',text:'One flies. One watches the glass. Both may change stations. Connect two standard pads, or use keyboard/mouse plus one pad. The shared sortie pauses for either crew member.',actions:[['Keyboard + controller',()=>{this.setup.coop=true;this.setup.coopMode='mixed';this.brief(true);}],['Two controllers',()=>{this.setup.coop=true;this.setup.coopMode='pads';this.brief(true);}],['Back',()=>this.shell.back()]]});}\n brief(coop=false){this.setup.coop=coop;this.show('brief',{kicker:'OPERATION 01 / COPPER TIDE',title:'Greyhaven. Then home.',text:'Destroy the armed transport at Greyhaven docks. Everything after that is your decision.',actions:[['Launch sortie',()=>this.start(this.setup)],['Route: '+(this.setup.route==='direct'?'Direct':'Northern dogleg'),()=>{this.setup.route=this.setup.route==='direct'?'dogleg':'direct';this.brief(coop);}],['Payload: '+LOADOUTS[this.setup.loadout].name,()=>{const a=Object.keys(LOADOUTS),i=a.indexOf(this.setup.loadout);this.setup.loadout=a[(i+1)%a.length];this.brief(coop);}],['Skill: '+DIFFICULTIES[this.setup.difficulty].name,()=>{const a=Object.keys(DIFFICULTIES);this.setup.difficulty=a[(a.indexOf(this.setup.difficulty)+1)%a.length];this.brief(coop);}],['Back',()=>this.shell.back()]]});\n  const grid=document.createElement('div');grid.className='brief-grid';grid.innerHTML=\"'`<div class=\"map-board\">${this.mapSvg(false)}<div class=\"map-key\"><span>CHANNEL SECTOR / 06:40</span><span>N ↑ · 5 KM GRID</span></div></div><div class=\"brief-copy\"><h3>THE TRANSPORT IS THE TARGET</h3><p>A naval transport shelters between the cranes. One accurate two-bomb salvo can finish the primary.</p><p>Direct: shorter crossing, defended coast.<br>Dogleg: longer flight, a quieter approach.</p><div class=\"loadout\"><strong>${LOADOUTS[this.setup.loadout].name}</strong><p>${LOADOUTS[this.setup.loadout].desc}<br>${LOADOUTS[this.setup.loadout].reserve}</p></div><p>Guns can jam. A sight can fail. One fire bottle buys a second chance. Home repairs, refuels and rearms.</p></div>`;\n  $('\"'.esh-mod',this.shell.root).insertBefore(grid,\"'$('\"'.esh-btns',this.shell.root));this.bindMap(grid,false);\n }\n mapSvg(live=true){const s=this.sim.state,a=s.aircraft,kx=x=>55+(x+10000)/460000*620,ky=y=>130+(y+10000)/230000*220,home=[kx(0),ky(0)],harbor=[kx(340000),ky(18000)],dog=[kx(140000),ky(-66000)];\n  return \"'`<svg viewBox=\"0 0 720 330\" role=\"img\" aria-label=\"Operational map of the Channel, Rookfield, Greyhaven and Bracken\"><defs><pattern id=\"chart-grid\" width=\"72\" height=\"55\" patternUnits=\"userSpaceOnUse\"><path d=\"M72 0H0V55\" fill=\"none\" stroke=\"#45665f\" stroke-width=\".6\" opacity=\".6\"/></pattern></defs><rect width=\"720\" height=\"330\" fill=\"#143745\"/><path d=\"M0 0H95L108 65 92 100 110 150 98 205 120 245 90 330H0Z\" fill=\"#536b50\" stroke=\"#b3b18a\" stroke-width=\"2\"/><path d=\"M470 0L454 56 476 94 451 122 480 154 460 180 476 208 460 250 492 288 480 330H720V0Z\" fill=\"#5c7051\" stroke=\"#b3b18a\" stroke-width=\"2\"/><path d=\"M470 153 Q530 150 564 165 L550 178 478 174\" fill=\"#143745\"/><rect width=\"720\" height=\"330\" fill=\"url(#chart-grid)\"/><text x=\"14\" y=\"26\" class=\"map-minor\">ENGLAND</text><text x=\"548\" y=\"28\" class=\"map-minor\">OCCUPIED COAST</text><text x=\"238\" y=\"276\" class=\"map-label\" opacity=\".5\" transform=\"rotate(-8,238,276)\">THE CHANNEL</text><path d=\"M${home}L${this.setup.route==='\"'dogleg'?dog+'L':''}\"'${harbor}\" fill=\"none\" stroke=\"#ebbd6c\" stroke-width=\"2\" stroke-dasharray=\"7 6\"/><circle cx=\"${kx(270000)}\" cy=\"${ky(-12000)}\" r=\"26\" fill=\"#d5764c\" opacity=\".2\"/><circle cx=\"${harbor[0]}\" cy=\"${harbor[1]}\" r=\"35\" fill=\"#d5764c\" opacity=\".13\"/>\n ${Object.entries(MISSION.waypoints).map(([id,t])=>{const x=kx(t.x),y=ky(t.y);return `<g class=\"map-hit\" data-target=\"${id}\" tabindex=\"0\" role=\"button\" aria-label=\"Preview ${esc(t.label)}\"><circle cx=\"${x}\" cy=\"${y}\" r=\"${id==='\"'harbor'?8:5}\\\" fill=\\\"\"'${id==='\"'home'?'#9fc8a2':id==='harbor'?'#ebbd6c':'#b5c5ae'}\\\" stroke=\\\"#0e2a32\\\" stroke-width=\\\"2\\\"/><circle cx=\\\"\"'${x}\" cy=\"${y}\" r=\"20\" fill=\"transparent\"/><text class=\"map-label\" x=\"${x+(id==='\"'refinery'?-130:12)}\\\" y=\\\"\"'${y+(id==='\"'home'?-12:5)}\\\">\"'${esc(t.label)}</text></g>`;}).join('\"'')}\n \"'${live?`<g transform=\"translate(${kx(a.x)},${ky(a.y)}) rotate(${a.yaw*180/Math.PI+90})\"><path d=\"M0 -12L8 8 0 4 -8 8Z\" fill=\"#fff3cf\" stroke=\"#122d33\" stroke-width=\"2\"/></g>`:'\"''}<text x=\\\"680\\\" y=\\\"30\\\" class=\\\"map-label\\\">N ↑</text></svg>\"'`;\n }\n bindMap(root,live){root.querySelectorAll('\"'[data-target]').forEach(e=>{const f=()=>{this.preview=e.dataset.target;if(live)this.map();else{const copy=\"'$('\"'.brief-copy',root);const t=MISSION.waypoints[this.preview];copy.querySelector('h3').textContent=t.label;copy.querySelector('p').textContent=this.targetDescription(this.preview);}};e.addEventListener('click',f);e.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();f();}});});}\n targetDescription(id){return{harbor:'Primary: armed transport. Two direct hits, or one centered salvo. Harbor tanks and works offer optional score.',battery:'Optional: cliff battery. Destroy it to suppress this coast’s barrage. It is not required for the primary.',refinery:'Optional: Bracken refinery. Two hits. Only continue if fuel and ordnance permit.',home:'Rookfield: cross the approach circle to trigger assisted recovery. A safe abort saves the crew.',dogleg:'Northern dogleg. Longer distance; more time to answer fighter warnings before the coast.'}[id];}\n map(){const s=this.sim.state;this.show('navigation',{kicker:'NAVIGATOR / AIRCRAFT CONTINUES',title:'Choose your next move',text:'Fuel and flight continue while this chart is open. Only the flight commander can commit a course.',actions:[['Fly to '+MISSION.waypoints[this.preview].label,()=>{this.send({type:'route',target:this.preview});this.clear();}],['Primary: Greyhaven',()=>{this.preview='harbor';this.map();}],['Return: Rookfield',()=>{this.preview='home';this.map();}],['Optional: Refinery',()=>{this.preview='refinery';this.map();}],['Optional: Battery',()=>{this.preview='battery';this.map();}],['Back to station',()=>this.clear()]]});\n  const board=document.createElement('div');board.className='brief-grid';board.innerHTML=\"'`<div class=\"map-board\">${this.mapSvg()}<div class=\"map-key\"><span>LIVE POSITION</span><span>NO PAUSE</span></div></div><div class=\"brief-copy\"><h3>${MISSION.waypoints[this.preview].label}</h3><p>${this.targetDescription(this.preview)}</p><div class=\"loadout\"><strong>RETURN FORECAST</strong><p>${Math.round(s.aircraft.fuel/s.aircraft.maxFuel*100)}% fuel · ${s.bombsLeft} bombs<br>${Math.max(0,Math.round(s.reserve||0))} seconds above estimated home fuel.<br>Home approach is always available.</p></div></div>`;$('\"'.esh-mod',this.shell.root).insertBefore(board,\"'$('\"'.esh-btns',this.shell.root));this.bindMap(board,true);this.game.resume();\n }\n wheel(id){this.wheelPlayer=id;this.show('stations',{kicker:'STATION SELECT / AI HOLDS COURSE',title:'Your next job',text:'Each gun watches its own bearing. Select an occupied station twice to exchange duties.',actions:STATIONS.map(station=>[LABELS[station]+(this.sim.state.owners[station]==='AI'?' · CREW':this.sim.state.owners[station]===id?' · YOU':' · P'+this.sim.state.owners[station]),()=>{const busy=this.sim.state.owners[station]\"'!=='\"'AI'&&this.sim.state.owners[station]\"'!==id;const key=id+station;if(busy&&this.requestKey!==key){this.requestKey=key;this.send({type:'\"'station',station},id);this.wheel(id);return;}this.send({type:'station',station,handover:busy},id);this.requestKey=null;this.clear();}]).concat([['Back',()=>this.clear()]])});this.game.resume();}\n practiceMenu(){this.show('practice',{kicker:'GROUND SCHOOL / LIVE SYSTEMS',title:'Learn the crew’s jobs',text:'Short drills use the same weapons, bombs, fuel and damage as the operation. Return home or end the drill from pause.',actions:[['Directional gunnery',()=>this.start({...this.setup,coop:false,practice:'gunnery'})],['Bomb calibration',()=>this.start({...this.setup,coop:false,practice:'bombing'})],['Damaged return',()=>this.start({...this.setup,coop:false,practice:'return'})],['Back',()=>this.shell.back()]]});}\n leaveMenu(){this.show('leave',{kicker:'LEAVE SORTIE',title:'Close the flight log?',text:'A safe abort is available through the map. Ending here records the current outcome.',actions:[['Continue flying',()=>this.shell.back()],['End and debrief',()=>{this.sim.result('manual');this.clear();}],['Title screen',()=>this.toTitle()]]});}\n devMenu(){if(this.online.active){this.show('dev',{kicker:'LIVE HUB ROUND',title:'The authority stays in charge',text:'World-changing developer tools are available in standalone flight. Display, controls and audio settings remain local to you.',actions:[['Settings',()=>this.settings()],['Back',()=>this.shell.back()]]});return;}\n  this.show('dev',{kicker:'DEVELOPER FLIGHT DESK · RUN MARKED',title:'Test the whole aircraft',text:'Changes are live. Every tool marks this sortie as a test run. Controller: up/down selects, left/right adjusts sliders.',rows:TUNING.map(t=>'dev_'+t[0]),actions:[['Reset tuning',()=>{for(const[k,v]of Object.entries(DEFAULT_BALANCE)){this.game.settings.set('dev_'+k,v);this.sim.balance[k]=v;}this.devMenu();}],['Resume test flight',()=>{this.clear();this.game.resume();}]]});\n  const tools=document.createElement('div');tools.className='dev-tools';const buttons=[['Invulnerable: '+(this.sim.state.invulnerable?'ON':'OFF'),()=>this.sim.dev('invulnerable',\"'!this.sim.state.invulnerable)],['\"'Infinite stores: '+(this.sim.state.infinite?'ON':'OFF'),()=>this.sim.dev('infinite',\"'!this.sim.state.infinite)],['\"'Free camera: '+(this.dev.freeCamera?'ON':'OFF'),()=>this.dev.freeCamera=\"'!this.dev.freeCamera],['\"'Collision / trigger volumes',()=>this.dev.debug=\"'!this.dev.debug],['\"'Jump: intercept',()=>this.sim.dev('jump','intercept')],['Jump: coast',()=>this.sim.dev('jump','coast')],['Jump: bomb approach',()=>this.sim.dev('jump','bomb')],['Teleport home approach',()=>this.sim.dev('jump','home')],['Spawn nose fighter',()=>this.sim.dev('fighter','nose')],['Spawn port fighter',()=>this.sim.dev('fighter','port')],['Spawn starboard fighter',()=>this.sim.dev('fighter','starboard')],['Spawn tail fighter',()=>this.sim.dev('fighter','tail')],['Spawn flak danger',()=>this.sim.dev('flak')],['Damage engine',()=>this.sim.dev('damage','engine')],['Start engine fire',()=>this.sim.dev('damage','fire')],['Jam gun',()=>this.sim.dev('damage','gun')],['Damage sight',()=>this.sim.dev('damage','sight')],['Repair all systems',()=>this.sim.dev('repair')],['Pause / step: '+(this.dev.paused?'FROZEN':'RUNNING'),()=>{this.dev.paused=\"'!this.dev.paused;this.game.resume();}],['\"'Step 1/60 second',()=>{this.sim.step(1/120);this.sim.step(1/120);}],['Export state JSON',()=>this.download('bomber-state.json',JSON.stringify(this.sim.snapshot(),null,2))],['Mission authoring',()=>this.editor()],['Restart same seed',()=>this.start({...this.setup,seed:this.sim.state.seed})]];\n  for(const[label,fn]of buttons){const b=document.createElement('button');b.textContent=label;b.onclick=()=>{this.sim.state.cheated=true;fn();if(this.shell.screen==='dev')this.devMenu();};tools.append(b);}const box=\"'$('\"'.esh-mod',this.shell.root);box.insertBefore(tools,\"'$('\"'.esh-btns',box));this.sim.state.cheated=true;\n }\n editor(){this.show('editor',{kicker:'MISSION AUTHORING / DATA DRIVEN',title:'Place the next objective',text:'Choose a waypoint, enter world coordinates in metres and apply. Export the definition for another operation. Trigger volumes are shown in the flight test view.',actions:[['Export mission JSON',()=>this.download('copper-tide.json',this.sim.exportMission())],['Import mission JSON',()=>this.importFile()],['Back',()=>this.shell.back()]]});const div=document.createElement('div');div.className='mission-editor';div.innerHTML='<div id=\\\"editor-picks\\\"></div><label>East <input id=\\\"edit-x\\\" type=\\\"number\\\" step=\\\"10\\\"></label><label>South <input id=\\\"edit-y\\\" type=\\\"number\\\" step=\\\"10\\\"></label><div id=\\\"editor-message\\\" aria-live=\\\"polite\\\"></div>';\n  const picks=\"'$('\"'#editor-picks',div);let selected='harbor';const load=id=>{selected=id;\"'$('\"'#edit-x',div).value=Math.round(this.sim.definition.waypoints[id].x/U);\"'$('\"'#edit-y',div).value=Math.round(this.sim.definition.waypoints[id].y/U);};for(const[id,p]of Object.entries(this.sim.definition.waypoints)){const b=document.createElement('button');b.textContent=p.label;b.onclick=()=>load(id);picks.append(b);}const apply=document.createElement('button');apply.textContent='Apply waypoint & associated target';apply.onclick=()=>{const x=Number(\"'$('\"'#edit-x',div).value)*U,y=Number(\"'$('\"'#edit-y',div).value)*U;if(\"'!Number.isFinite(x)||!Number.isFinite(y))return;Object.assign(this.sim.definition.waypoints[selected],{x,y});const id=selected==='\"'harbor'?'ship':selected;for(const list of[this.sim.definition.targets,this.sim.state.targets]){const t=list.find(t=>t.id===id);if(t)Object.assign(t,{x,y});}this.sim.state.cheated=true;this.dev.debug=true;\"'$('\"'#editor-message',div).textContent='Position applied. Export retains these changes.';};div.append(apply);\"'$('\"'.esh-mod',this.shell.root).insertBefore(div,\"'$('\"'.esh-btns',this.shell.root));load('harbor');}\n importFile(){const f=document.createElement('input');f.type='file';f.accept='.json';f.onchange=async()=>{try{this.sim.importMission(await f.files[0].text());this.shell.toast('Mission imported','Definition validated. Restart applies new encounters.');}catch(e){this.shell.toast('Import rejected',e.message);}};f.click();}\n download(name,text){const url=URL.createObjectURL(new Blob([text],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\n about(page=0){this.show('about',{kicker:'BUILT FOR THE CREW',title:'Source, craft & credits',text:'An original game inspired by B-17 Bomber. No affiliation with the original publishers. Original art, music, effects and gibberish voices are generated in code.',actions:[['Source Information',()=>this.about(0)],['Testing Feedback',()=>this.about(1)],['Engine Feedback',()=>this.about(2)],['Prompt Feedback',()=>this.about(3)],['Back',()=>this.shell.back()]]});const q=[[],['Issues caught','Critical / game-breaking','Most helpful test','Least helpful test'],['Liked most','Stuck or guessed wrong','Built for this game','Hardest engine task','Engine changes','One requested change'],['Liked most','Confusing','Hardest task','Suggested change']];const keys=['sourceInformation','testingFeedback','engineFeedback','promptFeedback'],title=['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback'];const div=document.createElement('div');div.className='credit-content';if(\"'!page){div.innerHTML='\"'<h3>Source Information</h3><dl>'+Object.entries(CREDITS.sourceInformation).map(([k,v])=>\"'`<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('\"'')+'</dl><h3>Research & notices</h3><p><a href=\\\"https://history.blueskyrangers.com/instructions/b17bomber.html\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Original instructions</a> · <a href=\\\"https://history.blueskyrangers.com/mattelelectronics/games/b17bomber.html\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Developer history</a> · <a href=\\\"https://www.intvfunhouse.com/games/b17b.php\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Preserved screenshots</a></p><p>my-3D2dge and Three.js: MIT. Rapier: Apache 2.0. Full notices are embedded in this file.</p>';const details=document.createElement('details');details.innerHTML='<summary>Full dependency notices</summary>';const pre=document.createElement('pre');pre.style.whiteSpace='pre-wrap';pre.style.fontSize='.8em';pre.textContent=\"'$('\"'#legal-notices').textContent;details.append(pre);div.append(details);}else div.innerHTML=\"'`<h3>${title[page]}</h3>`+CREDITS[keys[page]].map((v,i)=>`<p><strong>${q[page][i]}</strong><br>${esc(v)}</p>`).join('\"'');\"'$('\"'.esh-mod',this.shell.root).insertBefore(div,\"'$('\"'.esh-btns',this.shell.root));}\n results(){const s=this.sim.state,r=s.result;this.clear();this.show('results',{kicker:(s.practice?'PRACTICE / ':s.cheated?'TEST RUN / ':'FLIGHT LOG / ')+MISSION.name,title:r.outcome,emblem:r.win?'✦':'◇',text:{success:'Primary destroyed. Crew recovered. Rookfield will repair, refuel and rearm the aircraft.',abort:'Crew recovered. The primary remains. A safe abort leaves another sortie.',deadline:'Operation deadline reached. Current progress is recorded.',destroyed:'The aircraft was lost. Review the warnings and try another approach.','fuel-exhausted':'Fuel exhausted. Route and loadout choices leave a larger reserve.','ground-impact':'Ground impact. Keep airspeed and altitude above the danger zone.',fire:'Engine fire spread beyond recovery. Use the single bottle early.'}[r.reason]||'Your sortie is recorded. Repair, refuel and rearm for another run.',stats:[[r.score.toLocaleString(),'TOTAL SCORE'],[r.stats.kills,'FIGHTERS DOWN'],[r.stats.accuracy+'%','BOMB ACCURACY'],[minutes(r.stats.duration),'FLIGHT TIME'],[r.stats.fuel+'%','FUEL REMAINING'],[r.stats.returnBonus,'RETURN BONUS']],medals:[['Primary destroyed',r.stats.primary],['Crew recovered',r.stats.returned],['Damage −'+r.stats.damagePenalty,r.stats.damagePenalty===0],['Wasted bombs −'+r.stats.wastedPenalty,r.stats.wastedPenalty===0]],actions:[['Repair, rearm & fly again',()=>this.start({...this.setup,seed:((s.seed+7919)>>>0)})],['Review briefing',()=>{this.toTitle();this.brief(this.setup.coop);}],['Title screen',()=>this.toTitle()]]});}\n paint(dt){const s=this.sim.state;if(this.game.sceneName\"'!=='\"'play'||s.attract){this.hud.hidden=true;return;}if(this.shell.screen){this.hud.hidden=true;return;}if(this.game.real-this.lastHud<.08)return;this.lastHud=this.game.real;const pp=this.localPlayers(),split=pp.length>1,a=s.aircraft,primary=s.primary;this.hud.hidden=false;this.hud.className=(split?'split ':'')+(this.touch.active?'touch-mode':'');\n const objective=s.phase==='return'||s.phase==='landing'?'BRING THE CREW HOME':primary?'PRIMARY DESTROYED · CHOOSE HOME':'DESTROY THE ARMED TRANSPORT';const fuel=Math.round(a.fuel/a.maxFuel*100),heading=((a.yaw*180/Math.PI+90+360)%360),d=Math.hypot(s.route.x-a.x,s.route.y-a.y)/U/1000;\n let html=\"'`<div class=\"hud-top\"><div class=\"objective\"><div class=\"mini\">COPPER TIDE / ${s.phase.toUpperCase()}</div><b>${objective}</b><small>${esc(s.route.label)} · ${d.toFixed(1)} KM · ${minutes(s.t)} / 12:00</small></div><div class=\"vitals\"><div class=\"vital\"><label>FUEL RESERVE</label><strong>${fuel}%</strong><div class=\"bar\"><i style=\"width:${fuel}%\"></i></div></div><div class=\"vital\"><label>AIRFRAME</label><strong>${Math.round(a.hull)}%</strong><div class=\"bar\"><i style=\"width:${a.hull}%;background:${a.hull<35?'\"'#e78c69':'#a8c7a4'}\\\"></i></div></div></div><button class=\\\"menu-toggle\\\" aria-label=\\\"Pause menu\\\">☰</button></div>\"'`;\n if(split)html+='\"'<div class=\\\"split-line\\\"></div>';\n pp.forEach((p,i)=>{const I=this.game.players[i]||this.game.input,k=action=>esc(I.label(action)),gun=s.mounts[p.station],status=gun?\"'`${gun.jammed?'\"'JAMMED':gun.ammo+' ROUNDS'} · \"'${Math.round((p.aim.yaw||0)*180/Math.PI)}° TRAVERSE`:p.station==='\"'bombs'?\"'`${s.bombsLeft} BOMBS · SALVO ${s.salvo} · ${a.doors>.85?'\"'DOORS OPEN':'DOORS MOVING'}\"'`:`${a.hold?'\"'NAV HOLD':'MANUAL FLIGHT'} · POWER \"'${Math.round(a.throttle*100)}%`;\n const tip=gun?`${k('\"'fire')} Fire &nbsp; \"'${k('\"'zoom')} Fine aim &nbsp; Arrows / D-pad bearing\"'`:p.station==='\"'bombs'?\"'`${k('\"'fire')} Release &nbsp; \"'${k('\"'doors')} Doors &nbsp; \"'${k('\"'salvo')} Salvo\"'`:`${k('\"'up')} \"'${k('\"'left')} \"'${k('\"'down')} \"'${k('\"'right')} Fly &nbsp; \"'${k('\"'hold')} Hold &nbsp; \"'${k('\"'throttleUp')} / \"'${k('\"'throttleDown')} Power\"'`;\n html+=`<div class=\"seat-hud ${i?'\"'p2':''}\\\"><div class=\\\"mini\\\">\"'${split?'\"'P'+p.id+' / ':''}\"'${esc(p.name||'\"'AIRCREW')} · \"'${s.commandOwner===p.id?'\"'COMMAND':'CREW'}</div><b>\"'${LABELS[p.station]}</b><div class=\"readings\"><strong>${status}</strong></div><div class=\"prompts\">${tip}<br>${k('\"'wheel')} Stations &nbsp; \"'${k('\"'map')} Map &nbsp; \"'${k('\"'pause')} Menu</div><div class=\\\"station-links\\\"><button data-station=\\\"pilot\\\" data-player=\\\"\"'${p.id}\">1 FLIGHT</button><button data-station=\"${s.enemies.find(e=>e.alive)?.bearing||'\"'nose'}\\\" data-player=\\\"\"'${p.id}\">2 GUNS</button><button data-station=\"bombs\" data-player=\"${p.id}\">3 SIGHT</button></div></div><div class=\"instrument ${i?'\"'p2':''}\\\"><label>\"'${p.station==='\"'bombs'?'TIME TO IMPACT':'ALTITUDE / AIRSPEED'}</label><strong>\"'${p.station==='\"'bombs'?s.prediction.time.toFixed(1)+' SEC':Math.round(a.z/U)+' M'}</strong><small>\"'${Math.round(a.speed/U*3.6)} KM/H · HDG ${String(Math.round(heading)).padStart(3,'\"'0')}°</small></div>\"'`;\n if(gun)html+=`<div class=\"reticle ${i?'\"'p2':''}\\\"></div>\"'`;\n });\n if(s.caption){const role=MISSION.crew[s.caption.role]||'\"'AIRCREW';html+=\"'`<div class=\"radio ${s.caption.urgent?'\"'urgent':''}\\\" style=\\\"font-size:\"'${this.game.settings.captions}em\"><canvas id=\"crew-portrait\" width=\"90\" height=\"90\"></canvas><div><div class=\"role\">RADIO / ${esc(role)}</div><p>${esc(s.caption.text)}</p></div></div>`;}\n if(s.warning)html+=`<div class=\"warning\">${esc(s.warning)}</div>`;if(s.cheated)html+='\"'<div class=\\\"cheat-badge\\\">DEV FLIGHT · SCORES UNSAVED</div>';\n if(pp.some(p=>p.station==='bombs')){const dist=Math.hypot(s.prediction.x-s.targets[0].x,s.prediction.y-s.targets[0].y)/U,ready=dist<110;html+=\"'`<div class=\"bomb-inset\"><label>${s.sightDamaged?'\"'COARSE SIGHT · DAMAGED':'BOMB SOLUTION · WIND INCLUDED'}</label><strong>\"'${primary?'\"'PRIMARY CONFIRMED':ready?'RELEASE WINDOW':'IMPACT OFFSET '+Math.round(dist)+' M'}</strong><small>\"'${primary?'\"'Select HOME on the map.':ready?'Transport in blast radius. Fire to release.':'Guide the gold ring over the transport.'}<br>Wind \"'${Math.round(s.wind.y*1.5)} kn right · ${s.bombsLeft} bombs left</small></div>`;}\n if(s.lastImpact&&s.t-s.lastImpact.at<7)html+=`<div class=\"bomb-inset\"><label>IMPACT REPORT</label><strong>${s.lastImpact.hit?'\"'DIRECT HIT':'SPLASH / WIDE'}</strong><small>\"'${s.primary?'\"'Transport destroyed. Set a return course.':s.bombsLeft?'Another pass remains available.':'Set course for Rookfield.'}</small></div>\"'`;\n const p=pp[0],threat=s.enemies.find(e=>e.alive),context=[];if(a.fire)context.push(['\"'EXTINGUISH','extinguish']);if(p?.station==='bombs')context.push([\"'`RELEASE ×${s.salvo}`,'\"'release']);else if(a.x>240000&&\"'!s.primary&&s.bombsLeft)context.push(['\"'BOMB SIGHT','bombs']);else if(threat)context.push([\"'`GUN · ${{nose:12,starboard:3,tail:6,port:9}[threat.bearing]}`,'\"'gun']);if(primary||\"'!s.bombsLeft)context.push(['\"'HOME','home']);if(\"'!context.length)context.push(['\"'STATIONS','stations']);html+='<div class=\\\"touch-actions\\\">'+context.map(([l,id])=>\"'`<button data-context=\"${id}\">${l}</button>`).join('\"'')+'</div>';\n this.hud.innerHTML=html;\"'$('\"'.menu-toggle',this.hud).onclick=()=>this.game.menu();this.hud.querySelectorAll('[data-station]').forEach(b=>b.onclick=()=>{this.send({type:'station',station:b.dataset.station,handover:false},Number(b.dataset.player));this.clear();});this.hud.querySelectorAll('[data-context]').forEach(b=>b.onclick=()=>{const c=b.dataset.context;if(c==='release')this.send({type:'release',salvo:s.salvo});else if(c==='home')this.send({type:'route',tar