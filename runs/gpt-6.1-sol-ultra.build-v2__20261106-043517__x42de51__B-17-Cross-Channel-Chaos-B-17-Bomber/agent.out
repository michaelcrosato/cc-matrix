tor/free camera\", pause_dev),\n                (\"attract/input consumption\", attract),\n                (\"mixed couch co-op\", mixed_coop),\n                (\"two pads/glyphs\", two_pads),\n                (\"touch/multitouch\", touch),\n                (\"copied artifact portability\", portable),\n            ]:\n                if not names or any(x in name for x in names):\n                    run(name, lambda fn=fn: fn(browser))\n        finally:\n            browser.close()\n        if not names or \"webkit\" in names:\n            run(\"WebKit native renderer\", lambda: webkit(p))\n        if not names or \"firefox\" in names:\n            run(\"Firefox unsupported renderer\", lambda: firefox(p))\n    output = ROOT / \"tests/browser-result.json\"\n    if output.exists():\n        history = OUT / \"browser-run-history.json\"\n        runs = json.loads(history.read_text()) if history.exists() else []\n        runs.append(json.loads(output.read_text()))\n        history.write_text(json.dumps(runs, indent=2))\n    output.write_text(json.dumps(RESULT, indent=2))\n    print(\n        f\"Browser verification: {RESULT['assertions']} assertions, {len(RESULT['cases'])} scenarios, {len(RESULT['failures'])} failures\"\n    )\n    raise SystemExit(bool(RESULT[\"failures\"]))\n\n\nif __name__ == \"__main__\":\n    main()\n96:def foreground_retained(page, label, solo=False):\n101:            (\"nose canopy\", \"40x140+680+200\", 0.08),\n105:        else [(\"solo nose canopy\", \"110x160+370+430\", 0.08)]\n126:        check(ink > minimum, f\"{label}: {part} retained in rendered pixels ({ink:.3f})\")\n455:        foreground_retained(page, f\"{backend}-before-pause\")\n471:        for frame in range(12):\n473:            foreground_retained(page, f\"{backend}-viewport-{frame:02}\")\n498:        foreground_retained(page, f\"{backend}-solo-after-departure\", solo=True)\n\t\t\ttorchLights: 0,\n\t\t\tglowLights: 4,\n\t\t\tlights: 0,\n\t\t\tfilter: { look: \"clean\", bands: 4, punch: 1.08, ink: 0.45 },\n\t\t\tcamera: {\n\t\t\t\tmode: \"fixed\",\n\t\t\t\tnear: 1,\n\t\t\t\tfar: 245000,\n\t\t\t\tfov: 70,\n\t\t\t\tmouseLook: false,\n\t\t\t},\n\t\t\tonDraw: (w, r) => this.onDraw(w, r),\n\t\t});\n\t\tthis.world.addCamera({\n\t\t\tmode: \"fixed\",\n\t\t\tnear: 1,\n\t\t\tfar: 245000,\n\t\t\tfov: 70,\n\t\t\tmouseLook: false,\n\t\t});\n\t\tthis._scenery();\n\t\tthis._cloudMeshes();\n\t\tthis._stationOverlays();\n\t\tthis.state = {\n\t\t\taircraft: defaults(),\n\t\t\tt: 0,\n\t\t\tplayers: [{ id: 1, station: \"pilot\", aim: { yaw: 0, pitch: 0 } }],\n\t\t\ttargets: [],\n\t\t\tenemies: [],\n\t\t\tbombs: [],\n\t\t\tflak: [],\n\t\t\tshots: [],\n\t\t\teffects: [],\n\t\t};\n\t\tthis.players = this.state.players;\n\t\tthis.update(0, this.state);\n\t\treturn this;\n\t}\n\t_stationOverlays() {\n\t\tthis.stationOverlays = [];\n\t\tfor (let i = 0; i < 2; i++) {\n\t\t\tthis.world._makeOverlay({ fov: 70, on: false });\n\t\t\tthis.stationOverlays.push(this.world.overlay);\n\t\t}\n\t\t// The native world intentionally skips overlays in split screen. Draw each\n\t\t// native overlay explicitly in its viewport, with its own camera-space pen.\n\t\tthis.world.overlay = null;\n\t}\n\t_drawStationOverlay(r, player, aircraft, state, index) {\n\t\tif (\n\t\t\tthis.options.exterior ||\n\t\t\tthis.options.freeCamera ||\n\t\t\tplayer.station === \"exterior\"\n\t\t)\n\t\t\treturn;\n\t\tconst overlay = this.stationOverlays[index] || this.stationOverlays[0];\n\t\tconst renderer = this.E.World3D.renderer;\n\t\tif (!overlay || !renderer) return;\n\t\tfor (const batch of Object.values(overlay.pen.B)) batch.begin();\n\t\tthis.foreground(\n\t\t\toverlay.pen,\n\t\t\t{ x: 0, y: 0, z: 0, yaw: 0, pitch: 0, roll: 0 },\n\t\t\tplayer,\n\t\t\taircraft,\n\t\t\tstate,\n\t\t);\n\t\tfor (const batch of Object.values(overlay.pen.B))\n\t\t\tbatch.end(this.world.outlines);\n\t\tconst size = renderer.getDrawingBufferSize(new this.E.THREE.Vector2());\n\t\tconst vp = r.viewport,\n\t\t\tscale = size.x / this.game.W;\n\t\tconst x = vp ? Math.round(vp.x * scale) : 0;\n\t\tconst y = vp ? Math.round(vp.y * scale) : 0;\n\t\tconst width = vp ? Math.round(vp.w * scale) : size.x;\n\t\tconst height = vp ? Math.round(vp.h * scale) : size.y;\n\t\toverlay.camera.aspect = width / height;\n\t\toverlay.camera.fov = 70;\n\t\toverlay.camera.updateProjectionMatrix();\n\t\tconst previous = this.world.overlay;\n\t\tthis.world.overlay = overlay;\n\t\tthis.world._lightOverlay(this.world.cameras[index].cam);\n\t\tthis.world.overlay = previous;\n\t\trenderer.setViewport(x, y, width, height);\n\t\trenderer.setScissor(x, y, width, height);\n\t\trenderer.setScissorTest(!!vp);\n\t\trenderer.autoClear = false;\n\t\ttry {\n\t\t\trenderer.clearDepth();\n\t\t\trenderer.render(overlay.scene, overlay.camera);\n\t\t} finally {\n\t\t\trenderer.autoClear = true;\n\t\t\trenderer.setViewport(0, 0, size.x, size.y);\n\t\t\trenderer.setScissorTest(false);\n\t\t}\n\n```sh\nnpm run build\nnpm run verify\n```\n\n`build` uses Bun to inline the complete native engine and locally pinned Three.js/Rapier dependencies into both delivery copies. `verify` is the quiet entry point: it prints failures and a final count, and writes detailed evidence under `docs/verify/` and `tests/`.\n\nRelevant subsets can be selected without rerunning unchanged coverage:\n\n```sh\nnode tools/verify.mjs --suite=static,sim,package\nnode tools/verify.mjs --suite=browser\nnode tools/verify.mjs --suite=split\nnode tools/verify.mjs --suite=public\nnode tools/verify.mjs --suite=hub-unit,hub\n```\n\nBrowser-only diagnostic filtering is also available:\n\n```sh\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/browser-verify.py --cases=pause,touch,firefox\n```\n\nThe public-operation test uses the real briefing, keys, mouse and map to fly the full sortie. Browser scenarios exercise menus, settings, credits, pause, live tools/editor, both couch configurations, glyphs, disconnect/handover, attract exits, touch multitouch/context/holds, native WebKit rendering, persistent first-person geometry in both split viewports, and a copied offline artifact. Hub verification uses the downloaded official harness with normal and impaired transport, departures and playerless authority. Audio checks inspect synthesized output rather than relying on a listener.\n\nSee `docs/testing.md`, `docs/acceptance.md`, `docs/CONTROLS.md`, `docs/research.md` and machine-readable result files for the actual evidence and limits. No physical controller, real phone, second human or listening test is claimed.\n\n## Native technology and rendering\n\n- my-3D2dge **0.89.1**, revision `8ecc2f62353761187bdfe226f327b7ea5d2eb691`, with its native World3D extension.\n- Three.js **0.182.0** and Rapier **0.19.3**, locally bundled.\n- Native fixed stepping, input/settings/menu foundation, humanoid portraits, material/shape registry and 3D pen.\n- Original flight, shared station authority, swept projectiles, bomb ballistics, mission/scoring, AI, procedural sound and Hub transport adapter.\n\nThe default uses the engine’s native **WebGL 2** backend. An explicit `?backend=webgpu` exercises the native WebGPU diagnostic route. The supplied SwiftShader WebGPU route lost its device during an isolated scene test; the underlying cause is unknown. Incompatible renderers receive a useful support screen. A packaging compatibility shim supplies standard WebGPU enum constants when absent so the native WebGL path can initialize without a WebGPU implementation.\n\nAll visuals are code-authored geometry. Music, effects and crew gibberish voices are synthesized in code; music starts at 10% on a fresh device. Required MIT and Apache notices are embedded in the artifact and available from About/Credits. The original game is credited as inspiration without affiliation.\n\n`content/credits.json` is the single source for the in-game Source Information, Testing Feedback, Engine Feedback and Prompt Feedback, and is copied to the root `exit-interview.json`. Usage is recorded as **added on import**.\n","exit_code":0,"status":"completed"}}
