se) HOOKS.pause(this, acts);\n    if (this._std || this._items().length) acts.push(['Settings', () => this.show('settings')]);\n    if (!this._std) { if (help) acts.push(['Help', () => this.show('help')]); return; }\n    acts.push(['Controls', () => this.show('controls')]);\n    if (g.o.fullscreen !== false && fs.supported && !fs.standalone) acts.push([fs.on ? 'Leave full screen' : 'Full screen', () => { fs.toggle(); }]);\n    if (help) acts.push(['Help', () => this.show('help')]);\n    // a recorded page (?record=1) saves its session from the menu: a phone has no console (the share sheet, or a download).\n    // Its replay has the button too (doing nothing): the recorded tap on it lands on it, not on the next one (Quit)\n    if (E.session && (E.session.recording || E.session.replaying)) acts.push(['Save session', () => { if (E.session.recording) E.session.share(); }]);\n    if (quit && g.scenes && g.scenes[quit] && g.sceneName !== quit) acts.push(['Quit to ' + (quit === 'title' ? 'title' : actionName(quit).toLowerCase()), () => this.show('confirm', { kicker: 'Quit', title: 'Leave this game?', text: 'Progress since the last save is lost.',\n      actions: [{ label: 'Keep playing', fn: () => this.back() }, { label: 'Quit', fn: () => { this.hide(); g.go(quit); } }] })]);\n  }\n  /** draw a TileMap from above: floor, roofs by height, water and grass, then markers and the body at (an arrow) */\n  _map(cv, s, large) {\n    const m = s.map, g = cv.getContext('2d'), W = cv.width, H = cv.height, T = m.T, ww = m.w * T, hh = m.h * T, pad = large ? 22 : 8;\n    const k = Math.min((W - pad * 2) / ww, (H - pad * 2) / hh), ox = (W - ww * k) / 2, oy = (H - hh * k) / 2, P = (x, y) => [ox + x * k, oy + y * k];\n    cv._xf = { k, ox, oy };\n    if (!m._shellBase || m._shellBase.v !== m.version || m._shellBase.w !== W) {   // the cells, cached until the map changes\n      const b = mkCanvas(W, H), bg = ctx2d(b); bg.fillStyle = '#121b1d'; bg.fillRect(0, 0, W, H);\n      let top = 1; for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) top = Math.max(top, m.height(cx, cy));\n      for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) {\n        const c = m.cell(cx, cy), tag = m.floorAt((cx + .5) * T, (cy + .5) * T);\n        bg.fillStyle = c > 0 ? mix('#4a5650', '#d2c296', m.height(cx, cy) / top) : tag === 'water' || tag === 'lava' ? (tag === 'water' ? '#1d3e56' : '#6a2a1a') : tag === 'grass' ? '#29452f' : '#1f2b2c';\n        bg.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k));\n      }\n      m._shellBase = { v: m.version, w: W, cv: b };\n    }\n    g.drawImage(m._shellBase.cv, 0, 0);\n    }\n    g.fillStyle = '#b6c5b5'; g.textAlign = 'right'; g.fillText('N', W - (large ? 12 : 5), large ? 18 : 10);\n  }\n  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n   *  screen is open, move the focus with the game's input and hold the rest of it back from the game */\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\n    const keep = this._held; this._held = new Set();\n    const has = a => !!I.map[a], confirm = has('confirm') && I.pressed('confirm'), cancel = has('cancel') && I.pressed('cancel'), closeAll = has('pause') && I.pressed('pause'), mv = I.move();\n    const hit = ['up', 'down', 'left', 'right'].find(a => has(a) && I.pressed(a)), dir = Math.abs(mv[1]) > .5 ? (mv[1] < 0 ? 'up' : 'down') : Math.abs(mv[0]) > .5 ? (mv[0] < 0 ? 'left' : 'right') : null;\n    for (const a in I.map) if (!keep.has(a)) I.suppress(a);   // the game doesn't see what the menu used\n    if (this._cap) { this._capPad(); return; }   // binding: the next button is the answer, not a move in the menu\n    if (!this.root) { if (cancel) this.back(); else if (closeAll) this.hide(); return; }\n    if (hit) { this._dir = hit; this._dirT = now + .35; this._nav(hit); }   // a press (however short), then the held direction repeats\n    else if (dir !== this._dir) { this._dir = dir; this._dirT = now + .35; if (dir) this._nav(dir); }\n    else if (dir && now > this._dirT) { this._dirT = now + .09; this._nav(dir); }\n    const f = document.activeElement, mine = f && this._els.scr.contains(f);\n    if (confirm && mine && f.tagName === 'BUTTON') f.click();\n    else if (cancel) this.back();\n    else if (closeAll) this.hide();   // Start (or P) closes the whole menu; Escape and B go back one screen\n  }\n  /** binding a controller button: the first one pressed since binding began (Start cancels) */\n  _capPad() {\n    const c = this._cap, I = this._ctlI(); if (!c || c.device !== 'pad') return;\n    const i = I.padPrev.findIndex((on, k) => on && !c.prev[k]); c.prev = I.padPrev.slice();\n    const ra = RSTICK.find(k => I.held.has(k) && !c.prevR.includes(k)); c.prevR = RSTICK.filter(k => I.held.has(k));   // (the right stick pushed: its direction)\n    if (i === 9) this._capEnd('Not changed.'); else if (i >= 0) this._capBind('Pad' + i); else if (ra) this._capBind(ra);\n  }\n  /** move the focus (or turn a focused slider or choice), keeping it in view */\n  _nav(dir) {\n    const all = this._focusables(); if (!all.length) return;\n    const f = document.activeElement, i = all.indexOf(f), side = dir === 'left' || dir === 'right', d = dir === 'up' || dir === 'left' ? -1 : 1;\n    if (f && side && f.type === 'range') { if (d < 0) f.stepDown(); else f.stepUp(); f.dispatchEvent(new Event('input')); return; }\n    if (f && side && f._cycle) { f._cycle(d); return; }\n    const n = all[((i < 0 ? 0 : i + d) + all.length) % all.length]; n.focus({ preventScroll: true }); if (n.scrollIntoView) n.scrollIntoView({ block: 'nearest' });\n  }\n}\nE.Shell = Shell;\n\n/* =============================================================================\n * 22. GPU LIGHTING (WebGPU)  optional. game.enableGPU({ map }) turns it on.\n *    The Canvas renderer still draws every color. Alongside it, it writes an\n *    \"info\" image (height, surface type, glow per pixel). The GPU then lights each\n *    pixel: colored point lights, soft shadows marched through a heightmap of the\n *    level, light wrapping around characters (normals from their silhouettes),\n *    glow spilling onto nearby surfaces, dithered light bands, and heat shimmer.\n *    If WebGPU is missing or fails, the game keeps the Canvas lighting.\n * ============================================================================= */\nconst WGSL_COMMON = /* wgsl */`\nstruct Params {\n  a: vec4f, b: vec4f, c: vec4f, camv: vec4f,\n  right: vec4f, up: vec4f, amb: vec4f, fx: vec4f,\n  mapd: vec4f, scr: vec4f, scr2: vec4f, bufd: vec4f,\n  nheat: vec4f, p0: vec4f, p1: vec4f, p2: vec4f,\n  lights: array<vec4f, 64>,\n  heat: array<vec4f, 8>,\n};\n510:- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | [... omitted end of long line]\n/** AI Hub v1 shared-aircraft adapter. No transport other than the released Hub API. */\nconst STATIONS = new Set(['pilot', 'nose', 'starboard', 'tail', 'port', 'bombs']);\nconst ROUTES = new Set(['home', 'harbor', 'refinery', 'battery', 'dogleg']);\nconst ACTIONS = new Set(['station', 'release', 'route', 'extinguish', 'jettison', 'hold', 'doors', 'salvo']);\nconst limit = (v, lo = -1, hi = 1) => Number.isFinite(v) ? Math.max(lo, Math.min(hi, v)) : 0;\nconst rounded = v => Number.isFinite(v) ? Math.round(v * 1000) / 1000 : 0;\nconst copy = v => JSON.parse(JSON.stringify(v));\nconst EMPTY = () => ({type:'controls', bank:0,pitch:0,throttleDelta:0,aimX:0,aimY:0,fire:false,zoom:false});\n\nexport function cleanHubCommand(command) {\n  if (!command || typeof command !== 'object') return null;\n  const type = command.type;\n  if (type === 'controls') return {type,bank:limit(command.bank),pitch:limit(command.pitch),throttleDelta:limit(command.throttleDelta),aimX:limit(command.aimX),aimY:limit(command.aimY),fire:command.fire===true,zoom:command.zoom===true};\n  if (type === 'station' && STATIONS.has(command.station)) return {type,station:command.station};\n  if (type === 'route' && ROUTES.has(command.target)) return {type,target:command.target};\n  if (type === 'release') return {type,salvo:Math.round(limit(command.salvo ?? 1,1,8))};\n  if (type === 'extinguish' || type === 'jettison' || type === 'hold' || type === 'doors') return {type};\n  if (type === 'salvo') return {type,salvo:Math.round(limit(command.salvo ?? 1,1,8))};\n  return null;\n}\n\n// Checkpoints retain the complete renderable state; transient histories never travel.\n// Explicit field names are kept here so a designer can inspect network captures.\nexport function hubCheckpoint(snapshot) {\n  const s = copy(snapshot);\n  for (const key of ['history','events','eventHistory','actionHistory','commands','inputs']) delete s[key];\n  for (const key of Object.keys(s)) {\n    if (typeof s[key] === 'function' || key.startsWith('_')) delete s[key];\n  }\n  if (Array.isArray(s.effects)) s.effects = s.effects.slice(-12);\n  if (Array.isArray(s.shots)) s.shots = s.shots.slice(-12);\n  const text = JSON.stringify(s, (_k,v) => typeof v === 'number' ? rounded(v) : v);\n  if (text.length <= 14500) return JSON.parse(text);\n  s.effects = []; s.shots = [];\n  if (Array.isArray(s.flak)) s.flak = s.flak.slice(-12);\n  return JSON.parse(JSON.stringify(s, (_k,v) => typeof v === 'number' ? rounded(v) : v));\n}\n\nconst AK = ['x','y','z','yaw','pitch','bank','speed','throttle','fuel','maxFuel','hull','engines','fire','doors','gear','hold','shake','bombs','ammo','sight','extinguishers','stall','verticalSpeed','vz','vx','vy','jammed','jettisoned'];\nconst PK = ['id','station','aim','look','connected','owner','transition','request'];\nconst EK = ['id','x','y','z','yaw','pitch','bank','hp','alive','bearing','phase','t','kind'];\nconst BK = ['id','x','y','z','vx','vy','vz','age'];\nconst FK = ['id','x','y','z','r','timer','age','burst'];\nconst vec = (o,keys) => keys.map(k => typeof o?.[k] === 'number' ? rounded(o[k]) : o?.[k] ?? null);\nconst obj = (a,keys) => Object.fromEntries(keys.filter((_k,i)=>a[i]!==null&&a[i]!==undefined).map((k)=>[k,a[keys.indexOf(k)]]));\nexport function hubLive(snapshot) {\n  const s = snapshot;\n  const packet = {t:s.t,k:s.tick,p:s.phase,a:vec(s.aircraft||{},AK),u:(s.players||[]).map(p=>vec(p,PK)),e:(s.enemies||[]).filter(e=>e.alive!==false).slice(0,6).map(e=>vec(e,EK)),b:(s.bombs||[]).slice(-8).map(b=>vec(b,BK)),f:(s.flak||[]).slice(-5).map(f=>vec(f,FK)),s:s.score,r:s.route,c:s.caption,o:s.owners,d:s.prediction};\n  // A normal unreliable datagram stays below the transport's fragmentation threshold.\n  // The complete state, including every entity, follows over the reliable channel.\n  const size = () => JSON.stringify(packet).length;\n  if (size()>1150) { delete packet.c; delete packet.d; }\n  if (size()>1150) packet.f = [];\n  if (size()>1150) packet.b = packet.b.slice(-2);\n  if (size()>1150) packet.e = packet.e.slice(0,3);\n  if (size()>1150) { delete packet.r; delete packet.o; }\n  return packet;\n}\nexport function applyHubLive(previous, p) {\n  const s = copy(previous);\n  s.t=p.t; s.tick=p.k; s.phase=p.p;\n  s.aircraft = {...s.aircraft,...obj(p.a||[],AK)};\n  s.players=(p.u||[]).map(a=>({...s.players?.find(x=>x.id===a[0]),...obj(a,PK)}));\n  s.enemies=(p.e||[]).map(a=>({...s.enemies?.find(x=>x.id===a[0]),...obj(a,EK)}));\n  s.bombs=(p.b||[]).map(a=>obj(a,BK)); s.flak=(p.f||[]).map(a=>obj(a,FK));\n  if(p.s!==undefined)s.score=p.s; if(p.r!==undefined)s.route=p.r;\n  if(p.c!==undefined)s.caption=p.c; if(p.o!==undefined)s.owners=p.o; if(p.d!==undefined)s.prediction=p.d;\n  return s;\n}\n\n/** Root owns the fixed-step simulation clock; update() services transport independently of drawing. */\nexport class HubAdapter {\n  constructor({sim,onSession=()=>{},onStart=()=>{},onEnd=()=>{},onStatus=()=>{},stopSound=()=>{},hub=globalThis.AIHub}={}) {\n    this.sim=sim; this.hub=hub; this.onSession=onSession; this.onStart=onStart; this.onEnd=onEnd; this.onStatus=onStatus; this.stopSound=stopSound;\n    this.active=false; this.isHost=false; this.server=false; this.localId=1; this.ended=false; this.reported=false; this.readySent=false;\n    this.elapsed=0; this.sendAt=0; this.checkpointAt=0; this.seq=0; this.actionSeq=0; this.applied=-1; this.queue=[]; this.controls=EMPTY();\n    this.seats=new Map(); this.present=new Set(); this.lastInput=new Map(); this.seenActions=new Map(); this.remoteAt=new Map(); this.removers=[]; this.dirty=true; this.started=false;\n    this.stats={sent:0,received:0,maxPacket:0,finishes:0,accepted:0,rejected:0};\n  }\n  get playing(){return this.active&&!this.ended&&this.readySent&&this.hub.time()>=0;}\n  async connect() {\n    if (!this.hub) return null;\n    const info=await this.hub.connect({mode:'shared-world',seats:[1,2]});\n    if (!info) return null;\n    this.info=info; this.active=true; this.isHost=!!info.isHost; this.server=!!info.server;\n    (info.players||[]).forEach((p,i)=>{this.seats.set(p.id,i+1);this.present.add(p.id);});\n    this.localId=this.server?null:(this.seats.get(info.me)??null);\n    // Keep named streams rather than asking for a new random generator each frame.\n    this.random=this.hub.rng('bomber-operation');\n    const seed=Math.floor(this.random()*0x100000000)>>>0;\n    this.sim.reset({seed,loadout:'balanced',difficulty:'normal',players:[...this.seats.values()]});\n    for(const p of this.sim.state.players||[]){const hp=info.players.find(q=>this.seats.get(q.id)===p.id);if(hp)p.name=String(hp.name);}\n    this.removers.push(this.hub.on('message',(data,from)=>this._message(data,from)));\n    this.removers.push(this.hub.on('leave',e=>this._leave(e)));\n    this.removers.push(this.hub.on('time-up',()=>{if(this.isHost&&!this.ended)this.finish('deadline');}));\n    this.removers.push(this.hub.on('end',e=>this._end(e)));\n    this.removers.push(this.hub.on('start',()=>this.onStatus('CREW READY · AWAITING LAUNCH')));\n    this.onSession(info); this.onStatus(this.server?'AUTHORITATIVE CREW SERVER':'CONNECTED · CREW ASSEMBLING');\n    return info;\n  }\n","exit_code":0,"status":"completed"}}
