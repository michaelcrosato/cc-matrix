globalThis.__bomber=debug;globalThis.game=game;\n game.hook('\"'input',inputStep);setupTouch();detectDevices();\n game.start({scene:info?'play':'title',scenes:{title:{pausable:false,enter(){titleState();ui.title();},update:fixed,draw},play:{pausable:true,enter(){if(\"'!online.active)ui.clear();},update:fixed,draw,back(){return false;}}}});\n if(info){ui.clear();game.splitScreen(1);let last=performance.now(),acc=0;sessionClock=setInterval(()=>{const now=performance.now(),dt=Math.min(.2,(now-last)/1000);last=now;online.update(dt);if(online.isHost&&online.playing&&!online.ended){acc+=dt;while(acc>=1/120){sim.step(1/120);acc-=1/120;}if(sim.state.result)online.finish(sim.state.result.reason);}else acc=0;},16);online.ready();if(online.server){game.stop();document.body.dataset.server='\"'true';}}\n }catch(error){console.error('Bomber boot:',error);document.getElementById('loading').hidden=true;const box=document.getElementById('support');box.hidden=false;box.innerHTML='<strong>THIS AIRCRAFT NEEDS WEBGL 2</strong><p>Open this file in a current Chromium, Safari or WebKit browser with 3D graphics enabled. This browser could not create the native renderer.</p><p></p>';box.lastElementChild.textContent=String(error?.message||error);globalThis.__bomber={...app,ready:false,error:String(error)};}}\nboot();\nEOF\npython3 - <<'PY'\np='B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/sim.js'\ns=open(p).read().replace(\\\"p.aim.pitch=clamp(p.aim.pitch-c.aimY*dt*.85,-.48,.65);if(BEARINGS\\\", \\\"p.aim.pitch=clamp(p.aim.pitch-c.aimY*dt*.85,-.48,.65);p.zoom=\"'!!c.zoom;if(p.station==='\"'pilot')p.look=[p.aim.yaw,p.aim.pitch];if(BEARINGS\\\")\nopen(p,'w').write(s)\np='B-17-Cross-Channel-Chaos-B-17-Bomber-gpt-6.1-sol-ultra-20261106-043517/src/ui.js'\ns=open(p).read().replace(\\\"map(){const s=this.sim.state;this.show\\\", \\\"map(){if(this.game.paused){this.shell.hide();this.game.resume();}const s=this.sim.state;this.show\\\")\ns=s.replace(\\\"leaveMenu(){this.sho