{"type":"item.completed","item":{"id":"item_135","type":"command_execution","command":"/bin/bash -lc \"sed -n '312,347p' src/app.js && sed -n '910,925p' src/app.js && sed -n '854,879p' src/ui.js\"","aggregated_output":"\tgame.splitScreen(options.coop ? 2 : 1, { layout: \"rows\" });\n\tactivity();\n\tsound.unlock();\n\tif (touch.active) {\n\t\tsim.state.aircraft.throttle = 0.85;\n\t\tui.shell.tutorial(\n\t\t\t\"TWO THUMBS. ONE BOMBER.\",\n\t\t\t\"Left drag flies. Right drag aims. Tap a context action for the next job. The menu opens your map.\",\n\t\t\t9,\n\t\t);\n\t}\n\treturn sim.state;\n}\nfunction toTitle() {\n\tif (online.active) {\n\t\tui.clear();\n\t\treturn;\n\t}\n\tsound.stop();\n\tui.clear();\n\tclearActions();\n\tgame.splitScreen(1);\n\twhile (game.players.length > 1) game.removePlayer(2);\n\tattract = false;\n\tdemoSim = null;\n\tdocument.getElementById(\"attract-label\").hidden = true;\n\tsim.reset({ seed: 1942 });\n\tgame.go(\"title\", null, { fade: 0 });\n\tresultShown = false;\n\tactivity();\n}\nfunction titleState() {\n\tconst s = sim.state;\n\ts.aircraft.x = 294000;\n\ts.aircraft.y = -8000;\n\ts.aircraft.z = 13000;\n\t\t\tget attract() {\n\t\t\t\treturn attract;\n\t\t\t},\n\t\t\tget demo() {\n\t\t\t\treturn demoSim;\n\t\t\t},\n\t\t\texitAttract,\n\t\t\tenterAttract,\n\t\t};\n\t\tglobalThis.__bomber = debug;\n\t\tglobalThis.game = game;\n\t\tgame.hook(\"input\", inputStep);\n\t\tsetupTouch();\n\t\tdetectDevices();\n\t\tif (online.ended) return;\n\t\tgame.start({\n\t\t\t\t[minutes(r.stats.duration), \"FLIGHT TIME\"],\n\t\t\t\t[r.stats.fuel + \"%\", \"FUEL REMAINING\"],\n\t\t\t\t[r.stats.returnBonus, \"RETURN BONUS\"],\n\t\t\t],\n\t\t\tmedals: [\n\t\t\t\t[\"Primary destroyed\", r.stats.primary],\n\t\t\t\t[\"Crew recovered\", r.stats.returned],\n\t\t\t\t[\"Damage −\" + r.stats.damagePenalty, r.stats.damagePenalty === 0],\n\t\t\t\t[\"Wasted bombs −\" + r.stats.wastedPenalty, r.stats.wastedPenalty === 0],\n\t\t\t],\n\t\t\tactions: [\n\t\t\t\t[\n\t\t\t\t\t\"Repair, rearm & fly again\",\n\t\t\t\t\t() => this.start({ ...this.setup, seed: (s.seed + 7919) >>> 0 }),\n\t\t\t\t],\n\t\t\t\t[\n\t\t\t\t\t\"Review briefing\",\n\t\t\t\t\t() => {\n\t\t\t\t\t\tthis.toTitle();\n\t\t\t\t\t\tthis.brief(this.setup.coop);\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\t[\"Title screen\", () => this.toTitle()],\n\t\t\t],\n\t\t});\n\t}\n","exit_code":0,"status":"completed"}}
