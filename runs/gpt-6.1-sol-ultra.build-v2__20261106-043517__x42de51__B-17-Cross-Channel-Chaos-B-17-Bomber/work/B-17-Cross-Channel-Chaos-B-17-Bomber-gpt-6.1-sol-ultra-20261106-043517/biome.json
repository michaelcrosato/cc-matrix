{
	"files": {
		"includes": [
			"src/**",
			"content/**",
			"tools/*.mjs",
			"tests/*.js",
			"tests/*.mjs",
			"package.json",
			"!tests/audio-bundle.js"
		]
	},
	"linter": {
		"rules": {
			"style": {
				"useTemplate": "off",
				"noDescendingSpecificity": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"noUndeclaredVariables": "error"
			}
		}
	},
	"javascript": {
		"globals": ["Bun"]
	}
}
