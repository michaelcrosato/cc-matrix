16000;\n  const MAX_STATE = 196608;\n  const MAX_CHUNKS = 24;\n  const CHUNK_SIZE = 9000;\n  const EVENT_TYPES = new Set(['fire', 'interact', 'dash', 'dodge', 'quickstep', 'travel', 'quiver', 'map', 'continue']);\n  const now = () => root.performance?.now?.() ?? Date.now();\n  const clone = (x) => JSON.parse(JSON.stringify(x));\n  const blank = () => ({ mx: 0, my: 0, ax: 1, ay: 0, focus: false, run: false, revive: false });\n  function token() {\n    const a = new Uint32Array(3);\n    if (root.crypto?.getRandomValues) root.crypto.getRandomValues(a);\n    else for (let i = 0; i < a.length; i++) a[i] = Math.floor(Math.random() * 4294967296);\n    return Array.from(a, (n) => n.toString(36)).join('-');\n  }\n  function safeHeld(h) {\n    if (!h || typeof h !== 'object' || Array.isArray(h)) return blank();\n    const out = blank();\n    for (const k of ['mx', 'my', 'ax', 'ay']) out[k] = Number.isFinite(h[k]) ? Math.max(-1, Math.min(1, h[k])) : out[k];\n    for (const k of ['focus', 'run', 'revive']) out[k] = h[k] === true;\n    return out;\n  }\n  function safeEvent(e) {\n    if (typeof e === 'string') e = { type: e };\n    if (!e || typeof e !== 'object' || !EVENT_TYPES.has(e.type)) return null;\n    const out = { type: e.type };\n    if (typeof e.target === 'string' && e.target.length <= 64) out.target = e.target;\n    if (typeof e.node === 'string' && e.node.length <= 64) out.node = e.node;\n    if (Number.isInteger(e.index) && e.index >= 0 && e.index < 32) out.index = e.index;\n    for (const k of ['ax', 'ay']) if (Number.isFinite(e[k])) out[k] = Math.max(-1, Math.min(1, e[k]));\n    return out;\n  }\n  function validPacket(m, nonce) {\n    if (!m || typeof m !== 'object' || m.dt !== VERSION || m.c !== CONTENT || m.nonce !== nonce) return false;\n    try { return JSON.stringify(m).length <= MAX_PACKET; } catch { return false; }\n  }\n  class Link {\n    constructor(hooks, options) {\n      this.hooks = hooks || {};\n      this.mode = options.mode;\n      this.authority = options.authority;\n      this.dedicated = options.dedicated === true;\n      this.localId = this.dedicated ? null : options.localId;\n      this.hostId = options.hostId;\n      this.playerIds = options.playerIds.slice();\n      this.seed = options.seed >>> 0;\n      this.nonce = options.nonce;\n      this.epoch = token();\n      this.open = options.open !== false;\n      this.ended = false;\n      this.finished = false;\n      this.started = this.mode !== 'hub';\n      this.bootstrapped = this.authority;\n      this.held = blank();\n      this.events = [];\n      this.eventSeq = 0;\n      this.inputSeq = 0;\n      this.snapshotSeq = 0;\n      this.appliedSnapshot = -1;\n      this.lastInputSend = -Infinity;\n      this.lastStateSend = -Infinity;\n      this.lastSend = -Infinity;\n      this.peers = new Map();\n      this.outbound = [];\n      this.parts = new Map();\n      this.sendRaw = options.send;\n      this.clock = options.clock || now;\n      this.stats = { sent: 0, received: 0, bytes: 0, rejected: 0, duplicateActions: 0, retransmittedActions: 0, maxBytes: 0, maxRate: 0, lastInputSequence: 0, snapshots: 0 };\n      this.sendTimes = [];\n      this.removers = [];\n      if (options.initialize !== false) this.initialize();\n    }\n    initialize() {\n      this.hooks.init?.({ mode: this.mode, authority: this.authority, dedicated: this.dedicated, localId: this.localId, playerIds: this.playerIds.slice(), seed: this.seed });\n    }\n    canStep() {\n      if (!this.open || this.ended || this.finished || !this.bootstrapped) return false;\n      return this.mode !== 'hub' || (this.started && root.AIHub.time() >= 0);\n    }\n    input(held, events = []) {\n      if (this.ended || this.finished || this.localId == null) return;\n      this.held = safeHeld(held);\n      // UI may sample while the Hub card is up. Those actions must never leak into play.\n      if (!this.canStep()) return;\n      const clean = events.map(safeEvent).filter(Boolean);\n      if (this.authority) this.hooks.applyInput?.(this.localId, this.held, clean.map((e) => ({ ...e, id: ++this.eventSeq })));\n      else {\n        for (const e of clean) {\n          if (this.events.length >= 96) break;\n          this.events.push({ ...e, id: ++this.eventSeq });\n        }\n      }\n    }\n    packet(type, data) { return { dt: VERSION, c: CONTENT, nonce: this.nonce, t: type, ...data }; }\n    enqueue(type, data, to) {\n      const p = this.packet(type, data);\n      if (JSON.stringify(p).length > MAX_PACKET) { this.stats.rejected++; return false; }\n      this.outbound.push({ p, to });\n      return true;\n    }\n    flush(t) {\n      if (!this.open || this.ended || t - this.lastSend < 65 || !this.outbound.length) return;\n      const item = this.outbound[0];\n      const text = JSON.stringify(item.p);\n      if (this.sendRaw(item.p, item.to) === false) return;\n      this.outbound.shift();\n      this.lastSend = t;\n      this.stats.sent++;\n","exit_code":0,"status":"completed"}}
