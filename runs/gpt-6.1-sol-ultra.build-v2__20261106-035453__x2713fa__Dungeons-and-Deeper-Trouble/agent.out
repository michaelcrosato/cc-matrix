{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/tests/browser.py <<'EOF'\nfrom pathlib import Path\nimport json\nimport traceback\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nCONFIG=json.loads((ROOT/'build-config.json').read_text())\nURL=(ROOT.parent/CONFIG['filename']).as_uri()\npassed=[]\nfailures=[]\nerrors=[]\n\ndef check(name, fn):\n    try:\n        fn()\n        passed.append(name)\n    except Exception as error:\n        failures.append(name+': '+str(error))\n\ndef expect(value, message):\n    assert value, message\n\ndef advance(page, seconds=0.1):\n    page.evaluate('(seconds)=>__DT.game.advance(seconds,{draw:true})', seconds)\n\ndef press(page, key, seconds=0.05):\n    page.keyboard.down(key)\n    advance(page,seconds)\n    page.keyboard.up(key)\n    advance(page,0.025)\n\nPAD_STUB=\\\"\\\"\\\"window.__pads=[];window.__makePad=(index=0)=>({id:'DualSense standard test pad',index,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0});Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});\\\"\\\"\\\"\nwith sync_playwright() as pw:\n    browser=pw.chromium.launch(headless=True)\n    context=browser.new_context(viewport={'width':1920,'height':1080},device_scale_factor=1)\n    context.add_init_script(PAD_STUB)\n    page=context.new_page()\n    page.on('pageerror',lambda error:errors.append(str(error)))\n    page.goto(URL)\n    page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n    page.evaluate('__DT.game.stop()')\n    advance(page)\n    check('actual file boots with correct unique marker',lambda:expect(page.evaluate(\\\"document.body.dataset.game==='dungeons-and-deeper-trouble' && __DT.game.errors.length===0\\\"),'wrong artifact or runtime error'))\n    check('title choices fit the TV viewport',lambda:expect(page.evaluate(\\\"[...document.querySelectorAll('.esh-ttl .esh-btns button')].every(b=>{const r=b.getBoundingClientRect();return r.top>=0&&r.bottom<=innerHeight})\\\"),'title choices clipped'))\n    page.get_by_role('button',name='Settings',exact=True).hover()\n    check('mouse hover moves menu focus',lambda:expect(page.evaluate(\\\"document.activeElement.textContent==='Settings'\\\"),'hover did not focus'))\n    page.get_by_role('button',name='Settings',exact=True).click()\n    check('music starts at exactly ten percent',lambda:expect(page.evaluate('__DT.game.settings.music===0.1 && __DT.game.audio.musicVolume===0.1'),'music default is wrong'))\n    page.evaluate(\\\"__DT.game.settings.set('music',0.27)\\\")\n    page.reload()\n    page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n    page.evaluate('__DT.game.stop()')\n    advance(page)\n    check('explicit music setting survives reload',lambda:expect(page.evaluate('__DT.game.settings.music===0.27'),'music override lost'))\n    page.evaluate(\\\"__DT.game.settings.set('music',0.1)\\\")\n    page.get_by_role('button',name='About & credits',exact=True).click()\n    check('source information is present in game credits',lambda:expect('added on import' in page.locator('.esh-mod').inner_text() and 'PLAN.md' in page.locator('.esh-mod').inner_text(),'missing source metadata'))\n    page.get_by_role('button',name='Testing feedback',exact=True).click()\n    check('testing feedback screen populated',lambda:expect('Critical issues' in page.locator('.esh-mod').inner_text(),'missing feedback'))\n    page.evaluate('__DT.app.toTitle()')\n    advance(page)\n    page.get_by_role('button',name='Begin expedition',exact=True).click()\n    advance(page,.1)\n    check('begin enters a playable route graph',lambda:expect(page.evaluate(\\\"__DT.state.phase==='map'&&__DT.app.ui.shell.screen==='route'\\\"),'route screen missing'))\n    page.get_by_role('button',name='→ The Pale Below',exact=True).click()\n    advance(page,1.7)\n    check('first cave enters through actual travel interaction',lambda:expect(page.evaluate(\\\"__DT.state.phase==='cave'&&__DT.state.cave==='chalk'\\\"),'travel did not enter cave'))\n    page.mouse.move(1300,600)\n    advance(page)\n    initial=page.evaluate('__DT.state.stats.shots')\n    page.mouse.down()\n    advance(page,.8)\n    check('held mouse fires one shaft per press',lambda:expect(page.evaluate('__DT.state.stats.shots')==initial+1,'held fire repeated or failed'))\n    page.mouse.up()\n    advance(page,.5)\n    x=page.evaluate('__DT.state.players[0].x')\n    press(page,'d',.4)\n    check('keyboard movement reaches production simulation',lambda:expect(page.evaluate('__DT.state.players[0].x')>x+10,'WASD did not move'))\n    press(page,'Escape')\n    tick=page.evaluate('__DT.state.tick')\n    advance(page,1)\n    check('solo pause freezes gameplay clock',lambda:expect(page.evaluate('__DT.game.paused && __DT.state.tick')==tick,'paused simulation advanced'))\n    page.get_by_role('button',name='Resume',exact=True).click()\n    advance(page,.2)\n    check('resume returns to the expedition',lambda:expect(page.evaluate('__DT.state.tick')>tick,'resume stayed frozen'))\n    press(page,'Tab')\n    check('field map opens with explored fog',lambda:expect(page.evaluate(\\\"__DT.app.ui.shell.screen==='map'&&__DT.game.paused\\\"),'field map failed'))\n    press(page,'Escape')\n    advance(page,.1)\n    check('map closes without stuck inputs',lambda:expect(page.evaluate(\\\"\"'!__DT.app.ui.shell.screen&&!__DT.game.paused\"),'\"'map did not close'))\n    page.evaluate(\\\"window.__pads=[__makePad(0)];__pads[0].axes[0]=.75\\\")\n    advance(page,.3)\n    check('standard gamepad movement switches prompts',lambda:expect(page.evaluate(\\\"__DT.game.input.lastDevice==='gamepad'\\\"),'pad not detected'))\n    page.evaluate('__pads[0].axes[0]=0;__pads[0].buttons[7]={pressed:true,value:1,touched:true}')\n    advance(page,.6)\n    page.evaluate('__pads[0].buttons[7]={pressed:false,value:0,touched:false}')\n    advance(page,.1)\n    check('PlayStation glyphs are the controller default',lambda:expect(page.evaluate(\\\"__DT.game.input.label('fire')==='R2'\\\"),'wrong PS glyph'))\n    page.evaluate(\\\"__DT.game.settings.set('glyphs','xbox')\\\")\n    check('Xbox glyph preference applies to prompts',lambda:expect(page.evaluate(\\\"__DT.game.input.label('interact')==='A'\\\"),'wrong Xbox glyph'))\n    page.evaluate(\\\"__DT.game.settings.set('glyphs','playstation');__DT.game.input.rebind('fire','keys','KeyF');__DT.game.input.lastDevice='keyboard'\\\")\n    check('rebinding updates action prompts',lambda:expect(page.evaluate(\\\"__DT.game.input.label('fire')==='F'\\\"),'rebind prompt unchanged'))\n    page.evaluate('__DT.game.input.resetBindings();__pads=[]')\n    advance(page,.1)\n    check('controller loss clears movement and pauses solo',lambda:expect(page.evaluate('__DT.game.paused'),'controller loss did not pause'))\n    page.get_by_role('button',name='Developer tools',exact=True).click()\n    page.get_by_role('button',name='Tune movement',exact=True).click()\n    page.evaluate(\\\"__DT.game.settings.set('dev_moveSpeed',83)\\\")\n    check('live balance slider changes current rules',lambda:expect(page.evaluate('__DT.app.sim.tunables.moveSpeed===83'),'live value unchanged'))\n    page.get_by_role('button',name='Reset this page',exact=True).click()\n    check('reset restores balance defaults',lambda:expect(page.evaluate('__DT.app.sim.tunables.moveSpeed===DTConfig.defaults.moveSpeed'),'reset failed'))\n    page.evaluate('__DT.app.ui.shell.hide();__DT.app.toTitle()')\n    advance(page)\n    checksum=page.evaluate(\\\"[localStorage.getItem('deeper-trouble:campaign:1:a'),localStorage.getItem('deeper-trouble:campaign:1:b')].join('|')\\\")\n    page.evaluate('__DT.app.lastActivity=__DT.game.real')\n    advance(page,9.99)\n    check('attract waits for ten seconds of idle',lambda:expect(not page.evaluate('__DT.app.attract'),'attract started early'))\n    advance(page,.04)\n    check('attract starts an isolated demonstration',lambda:expect(page.evaluate('__DT.app.attract && \"'!__DT.app.net'\"'),'attract did not start'))\n    press(page,'x')\n    check('first input dismisses and is consumed',lambda:expect(page.evaluate('__DT.app.frontend&&\"'!__DT.app.attract'\"'),'attract input started play'))\n    check('attract preserves campaign save byte-for-byte',lambda:expect(page.evaluate(\\\"[localStorage.getItem('deeper-trouble:campaign:1:a'),localStorage.getItem('deeper-trouble:campaign:1:b')].join('|')\\\")==checksum,'attract changed save'))\n    page.evaluate(\\\"__DT.start('couch');__DT.app.ui.shell.hide();__DT.app.sim.enterCave('chalk');window.__pads=[__makePad(0)];__DT.game.input.pad=null;__DT.game.addPlayer({pad:0});__pads[0].axes[0]=.8\\\")\n    advance(page,.3)\n    check('keyboard and pad own distinct couch seats',lambda:expect(page.evaluate('__DT.state.players.length===2&&__DT.game.players[0].pad===null&&__DT.game.players[1].pad===0'),'device seat assignment failed'))\n    page.evaluate('__DT.app.save(true)')\n    page.reload()\n    page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n    page.evaluate('__DT.game.stop()')\n    advance(page)\n    check('continue is available after saved expedition',lambda:expect(page.get_by_role('button',name='Continue the trail',exact=True).count()==1,'missing Continue'))\n    page.get_by_role('button',name='Continue the trail',exact=True).click()\n    advance(page,.2)\n    check('continue restores valid current and restart state',lambda:expect(page.evaluate('__DT.state.players.length===1&&__DT.app.sim.checkpoint.version===DTContent.version'),'continue state malformed'))\n    check('Chromium reports no game or JavaScript errors',lambda:expect(not errors and page.evaluate('__DT.game.errors.length===0'),str(errors)))\n    context.close()\n    phone=browser.new_context(**pw.devices['iPhone 13'],has_touch=True)\n    mobile=phone.new_page()\n    mobile.on('pageerror',lambda e:errors.append(str(e)))\n    mobile.goto(URL)\n    mobile.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n    mobile.evaluate(\\\"__DT.game.stop();__DT.start('solo');__DT.app.sim.enterCave('chalk');__DT.app.ui.shell.hide()\\\")\n    advance(mobile,.2)\n    before=mobile.evaluate('__DT.state.stats.shots')\n    mobile.touchscreen.tap(330,470)\n    advance(mobile,.5)\n    check('touch right-side tap fires a single intentional shaft',lambda:expect(mobile.evaluate('__DT.state.stats.shots')==before+1,'touch shot failed'))\n    mobile.evaluate(\\\"()=>{const c=__DT.game.screen.canvas;c.dispatchEvent(new PointerEvent('pointerdown',{pointerId:91,pointerType:'touch',clientX:80,clientY:500,bubbles:true}));c.dispatchEvent(new PointerEvent('pointermove',{pointerId:91,pointerType:'touch',clientX:130,clientY:500,bubbles:true}));}\\\")\n    advance(mobile,.3)\n    mobile.evaluate(\\\"__DT.game.screen.canvas.dispatchEvent(new PointerEvent('pointercancel',{pointerId:91,pointerType:'touch',clientX:130,clientY:500,bubbles:true}))\\\")\n    advance(mobile,.1)\n    check('touch cancellation releases invisible stick',lambda:expect(mobile.evaluate('__DT.app.inputs.touch.pointers.size===0&&__DT.app.inputs.touch.move.every(x=>x===0)'),'touch remained held'))\n    mobile.screenshot(path=str(ROOT/'reports/touch.png'))\n    phone.close()\n    browser.close()\n    second=pw.webkit.launch(headless=True)\n    ctx=second.new_context(viewport={'width':1280,'height':720})\n    pg=ctx.new_page()\n    try:\n        pg.goto(URL)\n        pg.wait_for_function(\\\"document.body.dataset.ready==='true'\\\",timeout=20000)\n        pg.get_by_role('button',name='Begin expedition',exact=True).click()\n        pg.wait_for_timeout(300)\n        check('secondary WebKit engine boots the same file and route UI',lambda:expect(pg.evaluate(\\\"__DT.state.phase==='map'&&__DT.game.errors.length===0\\\"),'WebKit startup failed'))\n    except Exception as e:\n        failures.append('WebKit startup: '+str(e))\n    finally:\n        ctx.close()\n        second.close()\nreport={'passed':len(passed),'failed':len(failures),'checks':passed,'failures':failures,'pageErrors':errors}\n(ROOT/'reports/browser.json').write_text(json.dumps(report,indent=2))\nfor failure in failures: print(failure)\nprint(f'{len(passed)} browser/input checks passed; {len(failures)} failed')\nraise SystemExit(bool(failures))\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/tests/browser.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
