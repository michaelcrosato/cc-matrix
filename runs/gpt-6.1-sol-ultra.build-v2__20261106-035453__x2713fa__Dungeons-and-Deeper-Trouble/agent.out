{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc 'ls -lt reports/test-logs | head -5 && cat reports/test-logs/campaign.log 2>/dev/null'","aggregated_output":"total 56\n-rw-r--r-- 1 micha micha 1278 Nov  6 04:38 campaign.log\n-rw-r--r-- 1 micha micha   39 Nov  6 04:36 lifecycle.log\n-rw-r--r-- 1 micha micha   34 Nov  6 04:36 rtc.log\n-rw-r--r-- 1 micha micha   39 Nov  6 04:35 presentation.log\nNetwork campaign: 7 passed, 2 failed.\nstandard-rules two-ranger expedition reaches shared victory: campaign did not win: {\"phase\": \"cave\", \"cave\": \"root\", \"players\": [{\"id\": 0, \"x\": 633.6334242323502, \"y\": 455.99947607860787, \"z\": 0, \"vx\": 0, \"vy\": 0, \"aim\": 1.0303768265243125, \"hp\": 3, \"maxHp\": 3, \"down\": 0, \"invuln\": 0, \"bow\": \"idle\", \"draw\": -0.0033333333333333045, \"recover\": -0.004999999999999954, \"dash\": 0, \"dashCooldown\": 0, \"focus\": false, \"stepClock\": 0.16166666666666668, \"revive\": 0, \"anim\": \"idle\", \"animTime\": 0, \"lastAction\": 66, \"tether\": 250.57437862907997}, {\"id\": 1, \"x\": 386.9249438942308, \"y\": 412.15378125453987, \"z\": 0, \"vx\": 89.2823764963708, \"vy\": -17.597080643115095, \"aim\": -0.11563005429178609, \"hp\": 3, \"maxHp\": 3, \"down\": 0, \"invuln\": 0, \"bow\": \"idle\", \"draw\": 0, \"recover\": 0, \"dash\": 0, \"dashCooldown\": 0, \"focus\": false, \"stepClock\": 0.07833333333333337, \"revive\": 0, \"anim\": \"run\", \"animTime\": 0, \"lastAction\": 65, \"tether\": 250.57437862907997}], \"director\": {\"done\": false, \"errors\": [], \"progress\": [\"chalk\", \"pickup:chalk-rest-quiver\", \"tutorial:\", \"pickup:chalk-fork-quiver\", \"pickup:chalk-cairn-treasure\", \"pickup:chalk-axe\", \"root\", \"pickup:root-bank-quiver\", \"bank:\"]}}\nauthority resolves shared victory only once: finish call count 0\n","exit_code":0,"status":"completed"}}
