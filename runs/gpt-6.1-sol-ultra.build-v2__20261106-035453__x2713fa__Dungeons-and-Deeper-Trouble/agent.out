ed} passed, {failed} failed.')\nsys.exit(bool(failed))\n            context.close()\n        browser.close()\n(ROOT/'reports/network-lifecycle.json').write_text(json.dumps({'artifact':ARTIFACT.name,'sha256':ARTIFACT_HASH,'checks':checks},indent=2))\nfailed=sum(not c['pass'] for c in checks)\nfor c in checks:\n    if not c['pass']:print(c['name']+': '+c.get('detail',''),file=sys.stderr)\nprint(f'Network lifecycle: {len(checks)-failed} passed, {failed} failed.')\nsys.exit(bool(failed))\n                    \"map.png\",\n                    \"cave.png\",\n                    \"ember.png\",\n                    \"rime.png\",\n                ],\n            },\n            indent=2,\n        )\n    )\n    print(f\"3 rendered-artifact checks; {failures} failures\")\n    browser.close()\nraise SystemExit(1 if failures else 0)\n","exit_code":0,"status":"completed"}}
