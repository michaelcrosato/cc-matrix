{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"ls Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/vendor && rg --files Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/vendor -g '*LICENSE*' -g '*COPYING*' && cat Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/tests/render.test.mjs | head -28 && tail -6 Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/tests/render.test.mjs && tail -12 Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/src/sim/director.js\"","aggregated_output":"engine-repo\nhub\nhub-repo\nDungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/vendor/engine-repo/LICENSE\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nimport path from 'node:path';\nconst root=path.resolve(import.meta.dirname,'..');\nfor(const f of ['vendor/engine-repo/dist/handoff/my-3d2dge.js','src/content/campaign.js','src/render/world.js','src/audio/score.js'])vm.runInThisContext(fs.readFileSync(path.join(root,f),'utf8'),{filename:f});\nconst E=globalThis.My3D2dge;\nlet count=0;const failures=[];\nfunction check(name,fn){try{fn();count++;}catch(e){failures.push(name+': '+e.stack);}}\ncheck('native bow attachment agrees in every aim direction',()=>{\n for(let i=0;i<8;i++){const aim=i*Math.PI/4,p={x:100,y:100,z:0,aim},o=DTRender.bowOrigin(p),rig=DTArt.ranger();rig._bowPull=1;rig.update(1,{x:p.x,y:p.y,z:0,facing:aim,pose:'dt-bow'});const h=rig.hand();assert.ok(Math.hypot(h[0]-o.x,h[1]-o.y,h[2]-o.z)<1e-5,'real native bow hand must match projectile origin');}\n});\ncheck('all original creatures and bow draw through native painter',()=>{\n E.store.clear();const game=new E.Game({headless:true,draw:true,res:'ps1',expand:true,view:'threequarter'});const R=new DTRender(game);let state;\n game.start({update(dt){R.update(dt,state,{title:false});},draw(r){R.draw(r,state,{debug:{fogReveal:true}});}});\n for(const [id,c]of Object.entries(DTContent.caves)){\n  const room=c.rooms[0];state={phase:'cave',cave:id,time:2,tick:240,node:'camp',players:[{id:'p1',x:c.spawn[0],y:c.spawn[1],aim:0,hp:3,bow:'draw',draw:.15}],enemies:c.enemies.map((e,i)=>({...e,x:c.spawn[0]+35+(i%2)*20,y:c.spawn[1]+Math.floor(i/2)*16,state:'windup',hp:DTContent.creatures[e.kind].hp,maxHp:DTContent.creatures[e.kind].hp})),arrows:[],pickups:c.pickups,visible:[],explored:[],events:[],noise:[],tools:{},relics:[]};game.advance(1/120);assert.deepEqual(game.errors,[]);\n }\n game.dispose();\n});\ncheck('unknown enemies draw no body, shadow, label or telegraph',()=>{\n E.store.clear();const game=new E.Game({headless:true,draw:true,res:'ps1',view:'threequarter'});const R=new DTRender(game),c=DTContent.caves.chalk,enemy={id:'hidden',kind:'guardian1',x:c.spawn[0]+40,y:c.spawn[1]+20,hp:3,maxHp:3,state:'windup'},state={phase:'cave',cave:'chalk',time:1,node:'camp',players:[{id:1,x:c.spawn[0],y:c.spawn[1],hp:3,aim:0}],enemies:[enemy],arrows:[],pickups:[],visible:[],explored:[],events:[],noise:[],tools:{}};let calls=[];const before=JSON.stringify(state);\n game.start({update(dt){R.update(dt,state);},draw(r){const actor=r.actor,shadow=r.shadow;r.actor=function(x,y,...rest){calls.push(['actor',x,y]);return actor.call(this,x,y,...rest);};r.shadow=function(x,y,...rest){calls.push(['shadow',x,y]);return shadow.call(this,x,y,...rest);};try{R.draw(r,state);}finally{r.actor=actor;r.shadow=shadow;}}});game.advance(1/120);assert.ok(!calls.some(c=>c[1]===enemy.x&&c[2]===enemy.y));assert.equal(JSON.stringify(state),before);assert.deepEqual(game.errors,[]);game.dispose();\n});\ncheck('title and map painter paths have no draw errors',()=>{\n E.store.clear();const game=new E.Game({headless:true,draw:true,res:'ps1',expand:true,view:'threequarter'});const R=new DTRender(game);let options={title:true};const state={phase:'map',node:'camp',tools:{},players:[],time:3};game.start({update(dt){R.update(dt,state,options);},draw(r){R.draw(r,state,options);}});game.advance(1/120);options={title:false};game.advance(1/120);assert.deepEqual(game.errors,[]);game.dispose();\n});\ncheck('code audio cues have finite bounded envelopes and unique identities',()=>{\ncheck('code audio cues have finite bounded envelopes and unique identities',()=>{\n assert.ok(Object.keys(DTAudio.CUES).length>=22);for(const [name,voices]of Object.entries(DTAudio.CUES)){assert.ok(voices.length);for(const v of voices){assert.ok(v.f>=20&&v.f<=20000,name);assert.ok(v.v>0&&v.v<=.3,name);assert.ok(v.d>0&&v.d<2,name);}}\n assert.equal(new Set(Object.values(DTAudio.CUES).map(x=>JSON.stringify(x))).size,Object.keys(DTAudio.CUES).length);\n});\nfor(const f of failures)console.error(f);\nconsole.log(count+' render/audio checks passed; '+failures.length+' failed');if(failures.length)process.exitCode=1;\n   if(s.flags.bankLesson)finished=true;else if(this.stage===0){if(this.go(at(24,24),cmd,3)){cmd.ax=3/Math.sqrt(34);cmd.ay=5/Math.sqrt(34);cmd.actions.push(this.command('fire'));this.stage=1;this.beat=0;}}\n   else{this.beat+=dt;if(this.beat>1.5){this.stage=0;}}\n  }else if(task.kind==='ooze'){\n   const ooze=s.enemies.find(e=>e.kind==='ooze');if(this.stage===0){if(this.go(at(21,29),cmd,5)){const dx=ooze.x-p.x,dy=ooze.y-p.y,l=Math.hypot(dx,dy);cmd.ax=dx/l;cmd.ay=dy/l;cmd.actions.push(this.command('fire'));this.stage=1;this.beat=0;}}\n   else if(this.stage===1){this.beat+=dt;if(this.beat>.8){const goal=at(25,25);this.go(goal,cmd,6);if(d(p,goal)<8)finished=true;}}\n  }\n  if(finished){this.tasks.shift();this.stage=0;this.beat=0;this.progress.push(task.kind+':'+(task.id||''));}\n  sim.submit(this.id,cmd);\n }\n}\nG.DTDirector={ExpeditionDirector};\n})(globalThis);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/tests/product.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nconst dir=path.resolve(import.meta.dirname,'..');\nfor(const f of ['src/config.js','src/content/campaign.js','src/sim/geometry.js','src/sim/simulation.js','src/save/save.js'])vm.runInThisContext(fs.readFileSync(path.join(dir,f),'utf8'),{filename:f});\nlet passed=0;const failures=[];\nconst check=(name,fn)=>{try{fn();passed++;}catch(e){failures.push(name+': '+e.message);}};\nconst memory=()=>{const map=new Map();return{getItem:k=>map.get(k)||null,setItem:(k,v)=>map.set(k,v),removeItem:k=>map.delete(k),map};};\ncheck('checksummed alternating save persists current and restart snapshots',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage),sim=new DTSim.Simulation();sim.enterCave('chalk');sim.state.quiver=1;store.write(sim);const read=new DTSave.CampaignStore(storage).read();const next=new DTSim.Simulation();next.load(read.save);assert.equal(next.state.quiver,1);assert.equal(next.checkpoint.quiver,3);});\ncheck('an interrupted latest write falls back atomically',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage),sim=new DTSim.Simulation();store.write(sim);sim.state.quiver=8;store.write(sim);storage.setItem(store.key+':b','{\\\"schema\\\":1');const saved=new DTSave.CampaignStore(storage).read();assert.equal(saved.save.state.quiver,3);});\ncheck('checksum corruption is rejected',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage),sim=new DTSim.Simulation();store.write(sim);const key=store.key+':a',data=JSON.parse(storage.getItem(key));data.payload=data.payload.replace('\\\"quiver\\\":3','\\\"quiver\\\":999');storage.setItem(key,JSON.stringify(data));assert.equal(new DTSave.CampaignStore(storage).read(),null);});\ncheck('unsupported content and schema are rejected safely',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage),sim=new DTSim.Simulation();store.write(sim);const key=store.key+':a',data=JSON.parse(storage.getItem(key));data.schema=999;storage.setItem(key,JSON.stringify(data));assert.equal(new DTSave.CampaignStore(storage).read(),null);});\ncheck('denied storage continues in memory',()=>{const store=new DTSave.CampaignStore({getItem(){throw Error('denied');},setItem(){throw Error('denied');}});assert.equal(store.read(),null);store.write(new DTSim.Simulation());assert.ok(store.read());assert.equal(store.available,false);assert.match(store.error,/visit/);});\ncheck('dev and attract never overwrite an expedition',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage),sim=new DTSim.Simulation();store.write(sim);const before=JSON.stringify([...storage.map]);sim.state.mode='attract';assert.equal(store.write(sim),false);sim.state.mode='dev';assert.equal(store.write(sim),false);sim.state.mode='solo';sim.state.stats.assisted=true;assert.equal(store.write(sim),false);assert.equal(JSON.stringify([...storage.map]),before);});\ncheck('Hub progress cannot overwrite a local expedition',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage);assert.equal(store.write(new DTSim.Simulation({mode:'hub'})),false);assert.equal(storage.map.size,0);});\ncheck('save erase removes both old envelopes',()=>{const storage=memory(),store=new DTSave.CampaignStore(storage);store.write(new DTSim.Simulation());store.write(new DTSim.Simulation());store.clear();assert.equal(store.read(),null);assert.equal(storage.map.size,0);});\nconst config=JSON.parse(fs.readFileSync(path.join(dir,'build-config.json'))),html=fs.readFileSync(path.join(dir,'..',config.filename),'utf8'),meta=JSON.parse(fs.readFileSync(path.join(dir,'..','exit-interview.json')));\ncheck('artifact session client is first script immediately after charset',()=>{