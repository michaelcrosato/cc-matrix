nsition:null,checkpoint:'Morrow Camp',outcome:null};\n  this.checkpoint=copy(this.state);this.resumeRevision=0;if(o.state)this.restore(o.state);else this.event('voice',{text:this.state.notice,cue:'guide'});\n }\n getCave(){return C.caves[this.state.cave]||null;}\n get stateVersion(){return this.state.version;}\n event(type,data={}){const e={id:++this.ids,type,time:this.state.time,...data};this.state.events.push(e);if(this.state.events.length>16)this.state.events.shift();return e;}\n say(text,duration=5){this.state.notice=text;this.state.noticeTime=duration;this.event('voice',{text,cue:'guide'});}\n notice(text,duration=4){this.state.notice=text;this.state.noticeTime=duration;}\n objective(){const s=this.state;if(s.phase==='victory')return 'The Crown is whole. Morning has found its way home.';if(s.phase==='defeat')return 'The expedition is lost. A new road still waits.';\n  if(s.phase==='cave'){const cave=this.getCave();if(cave.id==='root'&&!s.flags.bankLesson)return 'Ring the brass gong with a banked arrow.';if(cave.exit.requires&&!this.has(cave.exit.requires))return cave.id==='ember'?'Claim the first Crown half.':cave.id==='rime'?'Claim the second Crown half.':'Find the '+cave.exit.requires+'. Then find the ladder.';return cave.next?'Take the Crown half to the far ladder.':'Reach the marked ladder.';}\n  return !s.tools.axe?'Find the axe in The Pale Below.':!s.tools.boat?'Use the axe. Find the boat in Briarwake.':!s.tools.key?'Cross Foldwater. Recover the Index Key.':s.relics.length<2?'Open the Kingless Wall. Reunite the Crown.':'Return the light to Morrow Camp.';\n }\n has(kind){return !!this.state.tools[kind]||this.state.relics.includes(kind);}\n submit(id,cmd={}){\n  const p=this.state.players.find(p=>String(p.id)===String(id));if(!p)return false;\n  let prev=this.commands.get(String(id));if(!prev)prev={mx:0,my:0,ax:Math.cos(p.aim),ay:Math.sin(p.aim),focus:false,sprint:false,heldInteract:false,actions:[],age:0};\n  const h={...prev,age:0};for(const k of ['mx','my','ax','ay'])if(Number.isFinite(cmd[k]))h[k]=clamp(cmd[k],-1,1);\n  h.focus=!!cmd.focus;h.sprint=!!(cmd.sprint||cmd.run);h.heldInteract=!!(cmd.heldInteract||cmd.revive);\n  for(const action of cmd.actions||[]){if(!action||typeof action.type!=='string')continue;const n=Number(action.id);if(!Number.isSafeInteger(n)||n<=p.lastAction)continue;p.lastAction=n;h.actions.push({...action,id:n,type:action.type==='dodge'?'dash':action.type});}\n  this.commands.set(String(id),h);return true;\n }\n clearInput(id=null){for(const [k,c]of this.commands)if(id===null||String(id)===k){c.mx=c.my=0;c.focus=c.sprint=c.heldInteract=false;c.actions=[];}}\n join(id){if(this.state.players.some(p=>String(p.id)===String(id))||this.state.players.length>=2)return false;const anchor=this.safePoint(this.state.players[0]||{x:0,y:0});const p=createPlayer(id,anchor.x,anchor.y);p.invuln=3;this.state.players.push(p);this.event('join',{player:id,x:p.x,y:p.y});return true;}\n leave(id){const n=this.state.players.length;this.state.players=this.state.players.filter(p=>String(p.id)!==String(id));this.commands.delete(String(id));if(n!==this.state.players.length){this.event('leave',{player:id});return true;}return false;}\n enterCave(id){const cave=C.caves[id];if(!cave)return false;const s=this.state;s.phase='cave';s.cave=id;s.enemies=cave.enemies.map(e=>({...copy(e),z:0,aim:Math.PI,state:'dormant',timer:0,phase:0,hp:e.hp||C.creatures[e.kind].hp,maxHp:e.hp||C.creatures[e.kind].hp,home:[e.x,e.y],cueClock:1,heard:0,target:null,hitPlayers:[],attackDir:Math.PI,path:[]}));\n  s.pickups=copy(cave.pickups);s.arrows=[];s.noise=[];s.explored=[];s.visible=[];s.transition=null;s.flags['room:'+id]=null;\n  s.players.forEach((p,i)=>{Object.assign(p,{x:cave.spawn[0]+i*12,y:cave.spawn[1],z:0,vx:0,vy:0,hp:3,down:0,invuln:3,bow:'idle',draw:0,recover:0,dash:0,revive:0,anim:'climb',animTime:.7});});\n  this.clearInput();this.pathCache.clear();s.checkpoint=cave.name;this.say(cave.entrance,5);this.updateVisibility();s.objective=this.objective();this.commitCheckpoint();this.event('cave-enter',{cave:id,x:cave.spawn[0],y:cave.spawn[1]});return true;\n }\n commitCheckpoint(){this.checkpoint=copy(this.state);this.resumeRevision++;this.event('checkpoint',{name:this.state.checkpoint});}\n save(){return{schema:1,version:C.version,state:this.snapshot(),checkpoint:copy(this.checkpoint),idCounter:this.ids};}\n load(payload){if(!payload||payload.schema!==1||payload.version!==C.version||!payload.state||!payload.checkpoint)throw Error('Unsupported expedition save');this.restore(payload.state);this.checkpoint=copy(payload.checkpoint);this.ids=Math.max(this.ids,payload.idCounter||0);return true;}\n snapshot(){return copy(this.state);}\n restore(snapshot){if(!snapshot||snapshot.version!==C.version||!Array.isArray(snapshot.players)||snapshot.players.length>2||!Number.isFinite(snapshot.tick)||!['map','cave','victory','defeat'].includes(snapshot.phase))throw Error('Invalid expedition state');if(snapshot.cave&&!C.caves[snapshot.cave])throw Error('Unknown cave');this.state=copy(snapshot);this.ids=Math.max(this.ids,...this.state.events.map(e=>e.id||0),...this.state.arrows.map(e=>Number(String(e.id).split('-').pop())||0));this.commands.clear();this.pathCache.clear();this.visClock=0;return true;}\n restart(assisted=false){if(this.state.mode==='hub'&&!assisted)return false;const reserves=this.state.reserves,stats=copy(this.state.stats),players=this.state.players.map(p=>p.id);this.state=copy(this.checkpoint);this.state.reserves=reserves;this.state.stats={...this.state.stats,...stats,restarts:stats.restarts+1,assisted:stats.assisted||assisted};this.state.players=this.state.players.filter(p=>players.includes(p.id));for(const id of players)if(!this.state.players.some(p=>p.id===id))this.join(id);this.clearInput();this.pathCache.clear();this.resumeRevision++;this.notice('Section restored. Creatures, arrows and supplies begin together.');this.event('restart');return true;}\n assistedContinue(){if(this.state.phase!=='defeat')return false;this.state.reserves=3;this.restart(true);this.state.reserves=3;this.state.outcome=null;return true;}\n travel(id,target){const s=this.state;if(s.phase!=='map'||s.transition)return false;const n=C.nodes.find(n=>n.id===target),edge=C.edges.find(e=>(e.from===s.node&&e.to===target)||(e.to===s.node&&e.from===target));if(!n||!edge)return false;\n  const required=edge.requires||n.requires;if(required&&!s.tools[required]){this.notice('You need the '+required+' to open that route.');this.event('locked',{tool:required});return false;}\n  s.transition={kind:'travel',from:s.node,to:target,time:0,duration:1.3};this.event('travel',{from:s.node,to:target,tool:required});return true;\n }\n arrive(target){const s=this.state,n=C.nodes.find(n=>n.id===target);s.node=target;s.transition=null;this.clearInput();\n  if(n.cave&&!s.cleared.includes(n.cave)){this.enterCave(n.cave);return;}\n  if(n.kind==='summit'&&s.cleared.includes('ember')&&!s.cleared.includes('rime')){this.enterCave('rime');return;}\n  if(n.kind==='camp'||n.kind==='spring'){s.players.forEach(p=>{p.hp=3;p.down=0;});if(!s.flags['spring-cache']&&n.kind==='spring'){s.quiver=Math.min(this.tunables.quiverCapacity,s.quiver+3);s.flags['spring-cache']=true;this.event('pickup',{kind:'arrows',count:3});}this.say(n.kind==='camp'?'Old Tern: “A road is a promise. Keep enough arrows to keep yours.”':'Clear water, three dry shafts, and a moment without teeth.');}\n  else if(n.kind==='lookout'){if(!s.flags['lookout-cache']){s.quiver=Math.min(this.tunables.quiverCapacity,s.quiver+4);s.flags['lookout-cache']=true;this.event('pickup',{kind:'arrows',count:4});}this.say('The two summit bells answer each other. “A crown in pieces is still a crown,” someone carved here.');}\n  else this.notice(n.clue,5);s.objective=this.objective();s.checkpoint=n.name;this.commitCheckpoint();\n }\n exitCave(){const s=this.state,cave=this.getCave();if(!cave||s.transition)return false;const p=s.players.find(p=>!p.down&&dist(p,cave.exit)<35);if(!p)return false;\n  if(cave.exit.requires&&!this.has(cave.exit.requires)){this.notice('Take the '+cave.exit.requires.replace('half-','Crown half of ')+' before leaving.');return false;}\n  if(cave.exit.guard&&s.enemies.some(e=>e.id===cave.exit.guard&&e.hp>0)){this.notice('The ladder’s guardian still watches.');return false;}\n  const standing=s.players.filter(p=>!p.down);if(standing.some(q=>dist(q,cave.exit)>95)){this.notice('Gather the rangers near the ladder.');return false;}\n  s.transition={kind:'exit',time:0,duration:1.3};s.players.forEach(p=>{p.anim='climb';p.animTime=1.3;});this.event('ladder',{x:cave.exit.x,y:cave.exit.y});return true;\n }\n completeCave(){const s=this.state,cave=this.getCave();if(!s.cleared.includes(cave.id))s.cleared.push(cave.id);s.transition=null;\n  if(cave.next){this.enterCave(cave.next);return;}\n  if(s.relics.length===2){this.win();return;}\n  s.phase='map';s.cave=null;s.node=cave.id==='chalk'?'chalk':cave.id==='root'?'root':'tide';s.enemies=[];s.arrows=[];s.pickups=[];s.noise=[];s.visible=[];s.explored=[];s.players.forEach(p=>{p.hp=3;p.down=0;p.anim='celebrate';p.animTime=1.3;});s.checkpoint=C.nodes.find(n=>n.id===s.node).name;this.say('Daylight. The '+cave.exit.requires+' opens a new road. This mountain is now a safe shortcut.',5);s.objective=this.objective();this.commitCheckpoint();\n }\n win(){const s=this.state;if(s.phase==='victory')return;s.phase='victory';s.cave=null;s.transition=null;s.outcome='win';s.checkpoint='The Morning Road';s.players.forEach(p=>{p.hp=3;p.anim='celebrate';p.animTime=999;});s.objective=this.objective();this.say('The Wayfarer’s Crown is whole. The storm unthreads. Far below, the camp bells greet the morning.',12);this.event('victory',{stats:copy(s.stats)});this.resumeRevision++;}\n defeat(){const s=this.state;if(s.phase==='defeat')return;s.phase='defeat';s.outcome='loss';s.transition=null;this.clearInput();this.say('The mountain has the last word today. The road will wait for another expedition.',10);this.event('defeat');this.resumeRevision++;}\n wall(cx,cy){const cave=this.getCave();if(!cave)return false;if(cave.rows[cy]?.[cx]!=='.')return true;for(const gate of cave.gates||[])if(!this.state.flags[gate.requires]&&cx>=gate.cx-Math.floor(gate.w/2)&&cx<gate.cx-Math.floor(gate.w/2)+gate.w&&cy>=gate.cy&&cy<gate.cy+gate.h)return true;return false;}\n clearAt(x,y,r=0){const x0=Math.floor((x-r)/T),x1=Math.floor((x+r)/T),y0=Math.floor((y-r)/T),y1=Math.floor((y+r)/T);for(let cy=y0;cy<=y1;cy++)for(let cx=x0;cx<=x1;cx++)if(this.wall(cx,cy)){const qx=clamp(x,cx*T,(cx+1)*T),qy=clamp(y,cy*T,(cy+1)*T);if(Math.hypot(x-qx,y-qy)<r+.01)return false;}return true;}\n lineClear(x0,y0,x1,y1){const dx=x1-x0,dy=y1-y0,steps=Math.ceil(Math.hypot(dx,dy)/5);for(let i=0;i<=steps;i++){const u=i/(steps||1);if(this.wall(Math.floor((x0+dx*u)/T),Math.floor((y0+dy*u)/T)))return false;}return true;}\n safePoint(p){if(!this.getCave())return{x:p.x||0,y:p.y||0};if(this.clearAt(p.x,p.y,5))return{x:p.x,y:p.y};const cave=this.getCave();const q=[[Math.floor(p.x/T),Math.floor(p.y/T)]],seen=new Set();while(q.length&&seen.size<5000){const [x,y]=q.shift(),key=x+','+y;if(seen.has(key)||x<0||y<0||x>=cave.width||y>=cave.height)continue;seen.add(key);if(!this.wall(x,y)&&this.clearAt((x+.5)*T,(y+.5)*T,5))return{x:(x+.5)*T,y:(y+.5)*T};q.push([x+1,y],[x-1,y],[x,y+1],[x,y-1]);}return{x:cave.spawn[0],y:cave.spawn[1]};}\n moveActor(p,vx,vy,dt,r=5){const dx=vx*dt,dy=vy*dt,steps=Math.max(1,Math.ceil(Math.max(Math.abs(dx),Math.abs(dy))/2));for(let n=0;n<steps;n++){if(this.clearAt(p.x+dx/steps,p.y,r)||this.cheats.noclip&&p.maxHp===3)p.x+=dx/steps;if(this.clearAt(p.x,p.y+dy/steps,r)||this.cheats.noclip&&p.maxHp===3)p.y+=dy/steps;}}\n path(from,to){const cave=this.getCave();if(!cave)return[];const sx=Math.floor(from.x/T),sy=Math.floor(from.y/T),tx=Math.floor(to.x/T),ty=Math.floor(to.y/T),key=sx+','+sy+'>'+tx+','+ty+'|'+!!this.state.flags.bankLesson;\n  if(this.pathCache.has(key))return this.pathCache.get(key);const q=[[sx,sy]],came=new Map([[sx+','+sy,null]]);let found=false;\n  for(let head=0;head<q.length&&head<7000;head++){const [x,y]=q[head];if(x===tx&&y===ty){found=true;break;}for(const [xx,yy]of [[x+1,y],[x-1,y],[x,y+1],[x,y-1]]){const k=xx+','+yy;if(!came.has(k)&&!this.wall(xx,yy)){came.set(k,[x,y]);q.push([xx,yy]);}}}\n  const result=[];if(found){let at=[tx,ty];while(at&&!(at[0]===sx&&at[1]===sy)){result.push({x:(at[0]+.5)*T,y:(at[1]+.5)*T});at=came.get(at[0]+','+at[1]);}result.reverse();}if(this.pathCache.size>500)this.pathCache.clear();this.pathCache.set(key,result);return result;\n }\n acoustic(from,to,maxDistance=400){const path=this.path(from,to);if(!path.length)return dist(from,to)<T?dist(from,to):Infinity;const d=(path.length-1)*T+dist(from,path[0])+dist(to,path[path.length-1]);return d<=maxDistance?d:Infinity;}\n noise(kind,x,y,loudness,owner=null){const e={id:++this.ids,x,y,kind,loudness,time:this.state.time,life:1.6,owner};this.state.noise.push(e);if(this.state.noise.length>10)this.state.noise.shift();this.event('sound',{cue:kind,x,y,loudness});return e;}\n updateVisibility(){const s=this.state,cave=this.getCave();if(!cave)return;const visible=new Set(),explored=new Set(s.explored),paint=(p,r,remember)=>{const r2=r*r,cx=Math.floor(p.x/T),cy=Math.floor(p.y/T),rn=Math.ceil(r/T);for(let y=cy-rn;y<=cy+rn;y++)for(let x=cx-rn;x<=cx+rn;x++){if(x<0||y<0||x>=cave.width||y>=cave.height)continue;const xx=(x+.5)*T,yy=(y+.5)*T;if((xx-p.x)**2+(yy-p.y)**2>r2||!this.lineClear(p.x,p.y,xx,yy))continue;const k=y*cave.width+x;visible.add(k);if(remember)explored.add(k);}};\n  for(const p of s.players)if(!p.down)paint(p,this.tunables.vision,true);for(const a of s.arrows)paint(a,this.tunables.arrowVision,false);\n  if(this.cheats.reveal)for(let y=0;y<cave.height;y++)for(let x=0;x<cave.width;x++)visible.add(y*cave.width+x);\n  s.visible=[...visible];s.explored=[...explored];this.visibleSet=visible;\n }\n isVisible(x,y){const cave=this.getCave();return !cave||this.cheats.reveal||new Set(this.state.visible).has(Math.floor(y/T)*cave.width+Math.floor(x/T));}\n visibleEnemy(e){return e.hp>0&&this.isVisible(e.x,e.y);}\n context(id){const s=this.state,p=s.players.find(p=>String(p.id)===String(id));if(!p)return null;if(s.phase==='map')return{label:'Choose a nearby landmark',type:'travel',enabled:true};if(s.phase!=='cave'||p.down)return null;\n  const down=s.players.find(q=>q.id!==p.id&&q.down>0&&dist(p,q)<31);if(down)return{label:'Hold to revive ranger',type:'revive',target:down.id,enabled:true};\n  const pick=s.pickups.find(q=>q.count>0&&dist(p,q)<30);if(pick){const guard=pick.guard&&s.enemies.find(e=>e.id===pick.guard&&e.hp>0);return{label:guard?'Defeat the guardian first':pick.kind==='arrows'?'Recover '+pick.count+' arrows':pick.kind==='treasure'?'Read the old cache':pick.kind==='heart'?'Drink clear water':'Claim '+pick.kind.replace('half-','Crown half: '),type:'pickup',target:pick.id,enabled:!guard};}\n  if(dist(p,this.getCave().exit)<38)return{label:'Climb the ladder',type:'exit',enabled:true};return null;\n }\n interact(p){if(p.down)return;const s=this.state;let got=false;for(const pick of s.pickups){if(pick.count<=0||dist(p,pick)>30)continue;if(pick.guard&&s.enemies.some(e=>e.id===pick.guard&&e.hp>0)){this.notice('Its guardian still watches.');continue;}\n   const kind=pick.kind;\n   if(kind==='arrows'){const capacity=Math.round(this.tunables.quiverCapacity),take=Math.min(pick.count,Math.max(0,capacity-s.quiver));if(!take){this.notice('Quiver full. The spare shafts will wait.');continue;}s.quiver+=take;pick.count-=take;s.stats.recovered+=pick.recovered?take:0;if(pick.recovered)s.flags.recovered=true;this.event('pickup',{kind,x:pick.x,y:pick.y,count:take,idPickup:pick.id});}\n   else if(kind==='heart'){if(p.hp>=3){this.notice('The water will wait until you need it.');continue;}p.hp=3;pick.count=0;this.event('pickup',{kind,x:pick.x,y:pick.y});}\n   else if(kind==='treasure'){pick.count=0;s.stats.treasures++;this.say('A pilgrim’s silver feather. The journal reads: