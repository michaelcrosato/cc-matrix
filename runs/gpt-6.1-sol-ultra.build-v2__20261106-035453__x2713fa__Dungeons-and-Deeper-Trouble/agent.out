on||game.real-app.lastSave>10){app.store.write(app.sim);app.lastSave=game.real;app.lastSaveRevision=app.sim.resumeRevision;}};\n  app.configurePlayers=function(couch){\n    game.allowJoin(false);while(game.players.length>1)game.removePlayer(game.players.length);game.input.pad='\"'any';\n    if(couch){\n      game.allowJoin({max:2,keys:false,onJoin:(input,n)=>{if(app.sim.state.players.length<2)app.sim.join(n);input.use(DTInput.preset);app.ui.shell.toast('A second ranger joins','Arrows, tools and the road home are shared.');}});\n      const pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean);\n      if(pads.length){const p1Pad=game.input.lastDevice==='gamepad'?game.input.padIndex:null;const next=pads.find(p=>p.index\"'!==p1Pad);if(next){game.input.pad=p1Pad;game.addPlayer({pad:next.index});}}\n      app.ui.shell.toast('\"'Couch expedition','A free controller joins with Options. Keyboard / mouse remains Ranger 1.');\n    }\n  };\n  app.start=function(mode='solo',resume=false,seed=7){\n    if(app.hub)return;\n    app.peer?.cancel();app.peer=null;app.net?.close?.();app.net=null;app.online=false;app.mode=mode;app.localId=1;app.frontend=false;app.attract=false;app.pairing=false;app.ready=true;game.live=mode==='couch';game.o.autoPause=true;game.timeScale=1;\n    app.sim=new DTSim.Simulation({players:[1],seed,mode});\n    if(resume){const stored=app.store.read();if(stored)try{app.sim.load(stored.save);app.sim.state.mode=mode;const p=app.sim.state.players[0];if(p){p.id=1;app.sim.state.players=[p];}app.sim.commands.clear();const cp=app.sim.checkpoint;if(cp?.players?.length){cp.players[0].id=1;cp.players=[cp.players[0]];} }catch(e){app.ui.shell.toast('The trail could not be read','A new expedition begins safely.');}}\n    app.configurePlayers(mode==='couch');app.renderer.sim=app.sim;app.actionSequence=Math.max(0,...app.sim.state.players.map(p=>p.lastAction||0));app.ui.lastPhase='';app.ui.lastRoute='';app.ui.lastNotice='';app.inputs.clear();app.ui.shell.hide();game.resume();game.go('play',null,{fade:0});app.lastSaveRevision=-1;attractBanner.hidden=true;app.save(true);\n  };\n  app.toTitle=function(){if(app.hub)return;app.save(true);app.peer?.cancel();app.peer=null;app.net?.close?.();app.net=null;app.online=false;app.mode='solo';app.frontend=true;app.attract=false;app.pairing=false;app.localId=1;game.live=false;game.o.autoPause=true;game.timeScale=1;app.configurePlayers(false);app.inputs.clear();app.sim=new DTSim.Simulation({players:[1],seed:7,mode:'preview'});app.renderer.sim=app.sim;app.lastActivity=game.real;app.ui.shell.hide();game.resume();game.go('title',null,{fade:0});attractBanner.hidden=true;app.audio?.stop();app.ui.title();};\n  app.command=function(id,cmd){const p=app.sim.state.players.find(p=>String(p.id)===String(id));if(\"'!p)return;const actions=(cmd.actions||[]).map(a=>({...a,id:++app.actionSequence}));app.actionSequence=Math.max(app.actionSequence,p.lastAction||0);app.sim.submit(id,{...cmd,actions});};\n  app.send=function(cmd){if(app.net){const {actions,...held}=cmd;app.net.input(held,actions||[]);}else app.command(app.localId,cmd);};\n  app.travel=function(target){app.send({mx:0,my:0,actions:[{type:'\"'travel',target}]});app.ui.shell.hide();app.inputs.clear();game.resume();};\n  app.networkHooks=function(){const held=new Map();return{\n    init(info){app.hub=info.mode==='hub';app.mode=info.mode;app.online=true;app.frontend=false;app.pairing=false;app.attract=false;app.localId=info.localId;app.ready=true;app.actionSequence=0;app.configurePlayers(false);game.live=true;game.o.autoPause=false;game.o.menu.quit=app.hub?false:'title';game.timeScale=1;\n      app.sim=new DTSim.Simulation({players:info.playerIds,seed:info.seed,mode:info.mode});app.sim.readOnly=app.hub;app.renderer.sim=app.sim;app.inputs.clear();app.ui.shell.hide();app.ui.lastPhase='';app.ui.lastRoute='';game.resume();game.go('play',null,{fade:0});attractBanner.hidden=true;\n      if(\"'!app.hub)app.net=app.peer;},\n    applyInput(id,h,events){if(h)held.set(String(id),h);const last=held.get(String(id))||{mx:0,my:0};app.command(id,{...last,sprint:last.run??last.sprint,heldInteract:last.revive??last.heldInteract,actions:events||[]});},\n    snapshot(){return app.sim.snapshot();},restore(state){app.sim.restore(state);app.renderer.sim=app.sim;},\n    addPlayer(id){app.sim.join(id);},removePlayer(id){app.sim.leave(id);held.delete(String(id));app.save(true);},\n    status(text){if(app.pairing){app.ui.pairStatus=text;app.ui.renderPair();}else if(app.ready)app.ui.shell.toast('\"'The shared trail',text);},\n    stop(reason){app.inputs.clear();app.sim.clearInput();app.audio?.stop();app.ended=true;if(\"'!app.hub)app.ui.open('\"'connection-ended',{kicker:'The shared trail',title:'The connection has ended.',text:String(reason||'The host has left. Pair again for a fresh connection.'),actions:[['Return to title',()=>app.toTitle()]]});},\n    timeUp(){app.sim.clearInput();},result(){return{stats:app.sim.state.stats};}\n  };};\n  function activity(){app.lastActivity=game.real;if(app.attract){app.toTitle();return true;}return false;}\n  const signal=game._abort?.signal;\n  addEventListener('keydown',e=>{if(e.repeat)return;if(activity()){e.preventDefault();e.stopImmediatePropagation();}},{capture:true,signal});\n  addEventListener('pointerdown',e=>{if(activity()){e.preventDefault();e.stopImmediatePropagation();}},{capture:true,signal});\n  let lastPointer=[0,0];addEventListener('pointermove',e=>{if(Math.hypot(e.clientX-lastPointer[0],e.clientY-lastPointer[1])>3){lastPointer=[e.clientX,e.clientY];if(activity()){e.preventDefault();e.stopImmediatePropagation();}}},{capture:true,signal});\n  addEventListener('wheel',e=>{if(activity()){e.preventDefault();e.stopImmediatePropagation();}},{capture:true,passive:false,signal});\n  app.beginAttract=function(){if(app.hub||app.pairing||\"'!app.frontend)return;app.attract=true;app.frontend=false;app.attractTime=0;app.attractBeat=-1;app.savedPreview=app.sim;app.sim=new DTSim.Simulation({mode:'\"'attract',players:[1],seed:2718});app.renderer.sim=app.sim;app.ui.shell.hide();game.resume();game.go('attract',null,{fade:0});app.inputs.clear();attractBanner.hidden=false;};\n  function attractStep(dt){app.attractTime+=dt;const beat=Math.floor(app.attractTime/9)%6;const stages=[['chalk',22,27,'Every shaft makes a little light.'],['chalk',39,27,'Listen before you hurry.'],['root',23,28,'A bright bevel turns the shot.'],['tide',24,29,'Put the noise somewhere else.'],['ember',43,22,'A seam in the guardian’s armor.'],['rime',45,23,'Wait for the pale breath to pass.']];\n    if(beat\"'!==app.attractBeat){app.attractBeat=beat;const [id,x,y,label]=stages[beat];app.sim.dev('\"'warp',id);app.sim.cheats.infiniteHealth=true;app.sim.cheats.infiniteAmmo=true;app.sim.state.tools={axe:true,boat:true,key:true};const p=app.sim.state.players[0];p.x=(x+.5)*16;p.y=(y+.5)*16;app.sim.updateVisibility();app.ui.shell.toast('A tale from the deep',label,6);}\n    const p=app.sim.state.players[0],t=app.attractTime%9;let ax=Math.cos(t*.6),ay=Math.sin(t*.6);const visible=app.sim.state.enemies.find(e=>e.hp>0&&app.sim.isVisible(e.x,e.y));if(visible){const n=Math.hypot(visible.x-p.x,visible.y-p.y)||1;ax=(visible.x-p.x)/n;ay=(visible.y-p.y)/n;}\n    app.command(1,{mx:t<2?.35:Math.sin(t)*.18,my:Math.cos(t)*.12,ax,ay,focus:t>4,actions:Math.floor(app.attractTime*2)\"'!==app.attractShot?[{type:'\"'fire'}]:[]});app.attractShot=Math.floor(app.attractTime*2);app.sim.step(dt);\n  }\n  game.hook('input',()=>{\n    if(\"'!app.ready)return;\n    const I=game.input,padUsed=I.lastDevice==='\"'gamepad'&&(I.anyPressed()||Math.hypot(...I.padMove)>.25||I.padAim);\n    if(padUsed&&activity()){I.clear();I.consumeAll();return;}\n    if(app.frontend&&\"'!app.pairing&&!app.hub&&game.real-app.lastActivity>=10)app.beginAttract();\n    app.ui.syncScreen();\n    if(!app.frontend&&!app.attract&&!app.online&&game.paused)app.save();\n  });\n  const update=function(dt){if(!app.ready)return;\n    if(app.frontend){app.renderer.upd