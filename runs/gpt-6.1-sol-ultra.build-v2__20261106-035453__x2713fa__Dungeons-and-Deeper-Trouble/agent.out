{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"cat > tests/extended-browser.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\n\nroot=Path(__file__).resolve().parents[1]\nconfig=json.loads((root/'build-config.json').read_text())\nurl=(root.parent/config['filename']).as_uri()\npassed=[]\nfailures=[]\ndef check(name,value):\n    (passed if value else failures).append(name)\nwith sync_playwright() as p:\n    browser=p.chromium.launch(headless=True)\n    context=browser.new_context(viewport={'width':1920,'height':1080})\n    page=context.new_page()\n    try:\n        page.goto(url)\n        page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n        page.evaluate(\\\"__DT.game.stop();__DT.start('couch');__DT.app.sim.enterCave('chalk');__DT.app.ui.shell.hide();__DT.game.advance(.1)\\\")\n        page.keyboard.press('Escape')\n        page.evaluate('__DT.game.advance(.1)')\n        result=page.evaluate(\\\"(()=>{const t=__DT.state.tick;__DT.game.advance(.5);return __DT.game.paused&&\"'!__DT.game.live&&__DT.state.tick===t})()\")\n        check('\"'couch menu is a clearly shared pause',result and 'shared couch pause' in page.locator('.esh-mod').inner_text())\n        page.evaluate(\\\"__DT.app.ui.devSliders('Clock');__DT.game.settings.set('dev_timeScale',.5)\\\")\n        check('developer speed has one clock multiplier',page.evaluate('__DT.game.timeScale===1&&__DT.app.sim.tunables.timeScale===.5'))\n        page.evaluate(\\\"__DT.game.settings.set('dev_timeScale',0);__DT.app.ui.dev()\\\")\n        before=page.evaluate('__DT.state.tick')\n        page.get_by_role('button',name='Single fixed step',exact=True).click()\n        check('single step works while simulation speed is zero',page.evaluate('__DT.state.tick')==before+1 and page.evaluate('__DT.app.sim.tunables.timeScale===0'))\n        page.evaluate(\\\"__DT.app.start('solo');__DT.app.ui.devSliders('Movement')\\\")\n        check('new developer page displays actual current defaults',page.evaluate('__DT.game.settings.dev_moveSpeed===__DT.app.sim.tunables.moveSpeed'))\n        page.evaluate(\\\"__DT.app.toTitle();__DT.game.advance(.05);__DT.app.beginAttract();__DT.game.advance(21)\\\")\n        check('attract includes a tool-opened wilderness beat',page.evaluate(\\\"__DT.app.attract&&__DT.state.phase==='map'&&__DT.state.tools.axe&&__DT.state.node==='forest'\\\"))\n        page.evaluate('__DT.game.advance(12)')\n        check('attract demonstrates a physical successful bank shot',page.evaluate(\\\"__DT.state.cave==='root'&&__DT.state.flags.bankLesson\\\"))\n        page.mouse.click(100,100)\n        page.evaluate('__DT.game.advance(.05)')\n        check('pointer dismisses attract without entering game',page.evaluate('__DT.app.frontend&&\"'!__DT.app.attract'\"'))\n        page.evaluate('__DT.app.ui.about(0)')\n        page.screenshot(path=str(root/'reports/about.png'))\n        for index in range(6):\n            page.evaluate('(i)=>__DT.app.ui.about(i)',index)\n            check(f'credits page {index+1} has readable content',page.evaluate(\\\"\"'!!document.querySelector('\"'.esh-mod h2')&&document.querySelector('.esh-mod').innerText.length>120\\\"))\n        page.evaluate('__DT.app.toTitle();__DT.game.advance(.05)')\n        page.screenshot(path=str(root/'reports/title-final.png'))\n        check('no extended UI runtime errors',page.evaluate('__DT.game.errors.length===0'))\n    finally:\n        context.close()\n    phone=browser.new_context(**p.devices['iPhone 13'])\n    page=phone.new_page()\n    try:\n        page.goto(url)\n        page.wait_for_function(\\\"document.body.dataset.ready==='true'\\\")\n        page.evaluate(\\\"__DT.game.stop();__DT.start('solo');__DT.app.sim.enterCave('root');__DT.app.ui.shell.hide();const p=__DT.state.players[0];Object.assign(p,{x:392,y:392,invuln:99});__DT.app.sim.updateVisibility();__DT.game.advance(.1)\\\")\n        page.touchs