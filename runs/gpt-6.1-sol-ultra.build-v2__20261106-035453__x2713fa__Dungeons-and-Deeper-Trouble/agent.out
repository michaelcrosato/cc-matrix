AIHub.send(data, { to, reliable })` | ghost and shared world |\n388:| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n389:| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n390:| `AIHub.fail(message)` | the game cannot run in this browser |\n392:`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\n  if(s.phase==='victory'||s.phase==='defeat')return;\n  if(s.transition){s.transition.time+=dt;if(s.transition.time>=s.transition.duration){const tr=s.transition;if(tr.kind==='travel')this.arrive(tr.to);else this.completeCave();}return;}\n  this.updatePlayers(dt);if(this.state!==s)return;\n  if(s.phase==='cave'){\n   this.stepArrows(dt);this.updateEnemies(dt);this.deathRecovery();if(this.state!==s||s.phase!=='cave')return;\n   s.noise=s.noise.filter(n=>s.time-n.time<n.life);this.visClock-=dt;if(this.visClock<=0){this.visClock=.08;this.updateVisibility();this.clues();}\n  }\n  s.objective=this.objective();\n }\n setTunable(key,value){const slider=K.sliders.find(s=>s.key===key);if(!slider||!Number.isFinite(value))return false;this.tunables[key]=clamp(value,slider.min,slider.max);this.state.stats.assisted=true;return true;}\n resetTunables(){this.tunables={...K.defaults};return true;}\n dev(action,value){if(this.readOnly||this.state.mode==='hub')return false;this.state.stats.assisted=true;\n  if(action==='heal'){this.state.players.forEach(p=>{p.hp=3;p.down=0;p.invuln=3;});this.state.reserves=3;}\n  else if(action in this.cheats)this.cheats[action]=value===undefined?!this.cheats[action]:!!value;\n  else if(action==='warp'&&C.caves[value]){this.enterCave(value);this.state.stats.assisted=true;}\n  else if(action==='spawn'&&C.creatures[value]&&this.getCave()){const p=this.state.players[0],at=this.safePoint({x:p.x+48,y:p.y});this.state.enemies.push({id:'dev-'+(++this.ids),kind:value,...at,z:0,aim:Math.PI,state:'dormant',timer:0,phase:0,hp:C.creatures[value].hp,maxHp:C.creatures[value].hp,home:[at.x,at.y],cueClock:1,heard:0,target:null,hitPlayers:[],attackDir:0});}\n  else if(action==='seed'&&Number.isSafeInteger(Number(value)))this.state.seed=Number(value);\n  else if(action==='restart')this.restart();else return false;return true;\n }\n}\nG.DTSim={Simulation,geometry:M,createPlayer};\n})(globalThis);\n    }\n  }\n  globalThis.DTRender=WorldRenderer;\n  globalThis.DTArt={ranger,drawCreature,palettes:PALETTES};\n})();\n","exit_code":0,"status":"completed"}}
