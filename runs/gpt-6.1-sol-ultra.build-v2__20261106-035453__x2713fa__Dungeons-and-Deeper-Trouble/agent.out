{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/src/config.js && sed -n '1,130p' Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/src/content/campaign.js && sed -n '230,330p' Dungeons-and-Deeper-Trouble-Advanced-Dungeons-and-Dragons-1982-gpt-6.1-sol-ultra-20261106-035453/src/net/network.js\"","aggregated_output":"(function (G) {\n'use strict';\nconst defaults = Object.freeze({\n  moveSpeed: 60, runSpeed: 91, focusSpeed: 28, dashSpeed: 195, dashCooldown: .9,\n  arrowSpeed: 265, arrowLife: 1.12, arrowRecovery: .22, arrowDraw: .18, reflections: 3,\n  quiverCapacity: 12, supplyYield: 1, vision: 108, arrowVision: 42, hearing: 1,\n  footNoise: 1, enemySpeed: 1, enemyDamage: 1, guardianWindup: 1.4,\n  guardianRecovery: 2.1, immunity: 1.1, timeScale: 1\n});\nconst sliders = [\n ['Movement', 'moveSpeed', 'Walk speed', 30, 100, 1], ['Movement', 'runSpeed', 'Run speed', 60, 140, 1],\n ['Movement','focusSpeed','Listening speed',12,50,1], ['Movement','dashCooldown','Quickstep cooldown',.3,2,.1],\n ['Arrows','arrowSpeed','Arrow speed',150,450,5], ['Arrows','arrowRecovery','Bow recovery',.1,.6,.02],\n ['Arrows','reflections','Wall reflections',1,6,1], ['Quiver','quiverCapacity','Quiver capacity',6,24,1],\n ['Quiver','supplyYield','Supply multiplier',.5,2,.1], ['Senses','vision','Lantern radius',64,180,4],\n ['Senses','hearing','Creature hearing',.3,2,.1], ['Senses','footNoise','Footstep noise',.2,2,.1],\n ['Creatures','enemySpeed','Creature speed',.4,1.8,.1], ['Creatures','enemyDamage','Wound damage',1,3,1],\n ['Guardians','guardianWindup','Guardian anticipation',.7,3,.1], ['Guardians','guardianRecovery','Guardian recovery',1,4,.1],\n ['Clock','timeScale','Simulation speed',0,3,.1]\n].map(([group,key,label,min,max,step])=>({group,key,label,min,max,step}));\nG.DTConfig={defaults,sliders};\n})(globalThis);\n(function(G){\n'use strict';\nconst TILE=16, center=n=>(n+.5)*TILE, point=(x,y)=>({x:center(x),y:center(y)});\nconst room=(id,name,x,y,w,h,purpose,tip)=>({id,name,x,y,w,h,purpose,tip});\nconst enemy=(id,kind,cx,cy,extra={})=>({id,kind,...point(cx,cy),...extra});\nconst pickup=(id,kind,cx,cy,count=1,extra={})=>({id,kind,...point(cx,cy),count,...extra});\nconst prop=(kind,cx,cy,extra={})=>({id:kind+'-'+cx+'-'+cy,kind,...point(cx,cy),...extra});\nconst palettes={\n chalk:{floor:'#5d6264',floorAlt:'#686b65',wall:'#737774',wallSide:'#343e42',accent:'#e9bf73',fog:'#071119',light:'#ffe0a3',theme:'chalk'},\n root:{floor:'#394c42',floorAlt:'#435649',wall:'#58624b',wallSide:'#223d35',accent:'#ade095',fog:'#06130f',light:'#d1ef9c',theme:'root'},\n tide:{floor:'#3b5660',floorAlt:'#496774',wall:'#64838b',wallSide:'#233c52',accent:'#9be3ef',fog:'#05121d',light:'#a3edff',theme:'tide'},\n ember:{floor:'#594747',floorAlt:'#6b5146',wall:'#896759',wallSide:'#473342',accent:'#ffc487',fog:'#180b17',light:'#ffcb96',theme:'ember'},\n rime:{floor:'#3b4c6b',floorAlt:'#4c6280',wall:'#7c94b5',wallSide:'#28354d',accent:'#b9dcff',fog:'#080e20',light:'#bcdcff',theme:'rime'}\n};\n// Authored room rectangles are compiled into collision/drawing rows. Links are explicit, never procedural.\nfunction compile(spec){\n const W=spec.width,H=spec.height, cells=Array.from({length:H},()=>Array(W).fill('#'));\n const carve=(x,y,w,h)=>{for(let yy=y;yy<y+h;yy++)for(let xx=x;xx<x+w;xx++)if(xx>0&&yy>0&&xx<W-1&&yy<H-1)cells[yy][xx]='.';};\n for(const r of spec.rooms)carve(r.x,r.y,r.w,r.h);\n for(const link of spec.links){const [a,b]=link.points; const width=link.width||3;\n  if(a[0]===b[0])carve(a[0]-Math.floor(width/2),Math.min(a[1],b[1]),width,Math.abs(a[1]-b[1])+1);\n  else if(a[1]===b[1])carve(Math.min(a[0],b[0]),a[1]-Math.floor(width/2),Math.abs(a[0]-b[0])+1,width);\n  else throw Error('Link must be axial '+spec.id);\n }\n return {...spec,tile:TILE,rows:cells.map(r=>r.join('')),palette:palettes[spec.id],spawn:[center(spec.spawnCell[0]),center(spec.spawnCell[1])],exit:{...point(...spec.exitCell),radius:25,guard:spec.exitGuard||null,requires:spec.reward||null},safeAnchors:[point(...spec.spawnCell),...(spec.anchors||[]).map(v=>point(...v))],banks:(spec.banks||[]).map(b=>({...b,a:b.a.map(v=>v*TILE),b:b.b.map(v=>v*TILE)}))};\n}\nconst caves={};\ncaves.chalk=compile({id:'chalk',name:'The Pale Below',subtitle:'I · THE AXE IN THE DARK',width:83,height:38,spawnCell:[5,27],exitCell:[76,13],exitGuard:'chalk-ladder-snake',reward:'axe',\n entrance:'The entrance crumbles behind you. Find the marked ladder.',\n rooms:[\n room('chalk-threshold','Lantern Threshold',2,22,11,10,'Learn to move; a one-way descent.','WASD / left stick to move. The mountain keeps what you have seen.'),\n room('chalk-practice','The Archer’s Rest',18,22,12,10,'A safe first shot, recoverable arrows and a supply.','Aim, then fire once. A missed shaft can be picked up. Keep three arrows for what waits.'),\n room('chalk-scratching','Scratcher’s Crossing',35,22,12,10,'First rat, tracks and a deliberate shot.','Small prints. Scratching beyond the stones. Listen before you hurry.'),\n room('chalk-fork','The Split Cairn',35,7,12,10,'A dark junction and an optional supply route.','Fresh claw marks turn east. The old cairn points toward a spare quiver.'),\n room('chalk-coil','Coil Gallery',51,7,13,11,'Sleeping snake, telegraph and the axe.','The raised head means a straight lunge. Step aside; shoot while it settles.'),\n room('chalk-ladder','Daylight Shaft',69,7,11,11,'Guarded ladder and required tool exit.','A ladder! Claim the axe before you climb. Every way forward is still a way deeper.'),\n room('chalk-cairn','The Unmarked Cairn',51,23,11,10,'Optional heart and recovered expedition journal.','Someone left the heavy things and carried on. Their arrows are still sound.')\n ],links:[{points:[[12,27],[35,27]]},{points:[[41,27],[41,15]]},{points:[[46,12],[69,12]]},{points:[[46,27],[51,27]]}],\n enemies:[enemy('chalk-rat','rat',41,27,{tutorial:true}),enemy('chalk-coil-snake','snake',57,12),enemy('chalk-ladder-snake','snake',74,12)],\n pickups:[pickup('chalk-rest-quiver','arrows',24,26,7),pickup('chalk-fork-quiver','arrows',39,11,5),pickup('chalk-axe','axe',60,12,1,{guard:'chalk-coil-snake'}),pickup('chalk-cairn-heart','heart',56,28),pickup('chalk-cairn-treasure','treasure',57,27)],\n props:[prop('lantern',6,25),prop('target',25,29),prop('sign',21,24),prop('bones',38,26),prop('rock',43,25),prop('cairn',38,10),prop('crystal',53,9),prop('crystal',61,9),prop('ladder',76,13),prop('torch',71,9),prop('bones',54,26)],\n tracks:[{kind:'rat',from:[35,27],to:[40,27]},{kind:'snake',from:[52,13],to:[57,12]}],\n banks:[{id:'chalk-practice-bank',a:[27,23],b:[29,25]}],anchors:[[24,27],[40,12]]\n});\ncaves.root=compile({id:'root',name:'Briarwake Hollows',subtitle:'II · THE BOAT UNDER ROOTS',width:83,height:40,spawnCell:[5,29],exitCell:[76,28],exitGuard:'root-ladder-drake',reward:'boat',entrance:'The briar slope slides shut. The northern rootway is the only passage.',\n rooms:[\n room('root-entry','The Felled Door',2,24,11,10,'Forest opening and the echo of the axe.','The axe has opened the forest. Below it, roots have swallowed an older road.'),\n room('root-bank','Mirrorstone Bend',18,23,14,12,'Mandatory safe bank shot at a hanging gong; bridge opens.','Strike the brass gong with a bounced arrow. Aim at the bright bevel; reflected light marks the way.'),\n room('root-roost','The Listening Roof',35,6,12,11,'Bats mask a hiss; tracks remain readable.','Wings can drown a hiss. Prints and moving dust tell the same tale.'),\n room('root-web','The Silver Pantry',53,6,12,12,'Spider theft and a free shaft stash.','Spiders hoard fallen shafts. Follow silver drag marks; no arrow is needed to reclaim the stash.'),\n room('root-boat','The Folded Ferry',53,24,12,11,'Boat under a coil; optional costly treasure.','A boat of bark and brass. It will remember every river you cross.'),\n room('root-ladder','The Root Stair',70,23,11,12,'Ground drake guards ladder; return shortcut.','Heavy prints. A long breath before the charge. The roots leave room to step aside.')\n ],links:[{points:[[12,29],[35,29]]},{points:[[40,29],[40,16]]},{points:[[40,16],[40,11]]},{points:[[46,11],[53,11]]},{points:[[59,16],[59,24]]},{points:[[64,29],[70,29]]}],\n gates:[{id:'root-gong-bridge',cx:40,cy:21,w:3,h:1,requires:'bankLesson',reason:'The root bridge unfolds when a banked arrow rings the gong.'}],\n enemies:[enemy('root-gong','target',28,28,{requiresBank:true}),enemy('root-bat','bat',41,11),enemy('root-roost-snake','snake',43,14),enemy('root-spider','spider',60,10,{stash:[center(62),center(8)]}),enemy('root-boat-snake','snake',58,29),enemy('root-ladder-drake','drake',75,28)],\n pickups:[pickup('root-bank-quiver','arrows',22,27,8),pickup('root-web-stash','arrows',62,8,6,{stash:true}),pickup('root-ferry-quiver','arrows',55,27,6),pickup('root-boat','boat',62,30,1,{guard:'root-boat-snake'}),pickup('root-risk-cache','treasure',55,32)],\n props:[prop('tree',4,25),prop('sign',20,25),prop('gong',28,28),prop('mushroom',36,9),prop('mushroom',45,15),prop('cobweb',62,7),prop('boat',62,30),prop('ladder',76,28),prop('torch',72,25),prop('vines',57,25)],\n tracks:[{kind:'bank',from:[22,30],to:[25,27]},{kind:'spider',from:[55,13],to:[62,8]},{kind:'drake',from:[71,29],to:[75,28]}],\n // A southeast-facing shot at the bevel turns east toward the gong. Helpful pale inlay is authored floor decoration.\n banks:[{id:'root-lesson-bevel',a:[24,25],b:[27,28],lesson:true}],anchors:[[23,29],[55,28]]\n});\ncaves.tide=compile({id:'tide',name:'The Drowned Archive',subtitle:'III · THE KEY UNDER WATER',width:83,height:41,spawnCell:[6,29],exitCell:[76,11],exitGuard:'tide-ladder-drake',reward:'key',entrance:'Your folded ferry carries you below the broken spillway. The current forbids return.',\n rooms:[\n room('tide-entry','The Unmoored Landing',2,24,12,11,'Boat crossing, cold masonry and supply.','Water carries every sound. A bright shaft can call something you would rather not fight.'),\n room('tide-ooze','The Patient Green',20,23,14,13,'Indestructible ooze with lure and alternate loop.','The ooze sheds arrows unharmed. Put a loud shot behind it, then take the other passage.'),\n room('tide-loop','The Dry Marginalia',20,5,14,11,'Safe bypass of the ooze and layered sound.','Words worn from stone. Only the old route marks remain: three notches, then east.'),\n room('tide-drake','The Scribe’s Watch',40,5,13,12,'Sleeping ground drake and safe recovery lanes.','A snore beyond the shelves. Heavy prints lead toward the vault.'),\n room('tide-key','The Brass Index',59,23,13,12,'Key, a snake and an optional flooded cache.','The Index Key opens the summit wall. The lock has waited longer than the king.'),\n room('tide-ladder','The Upward Well',69,5,11,12,'Exit challenge with mixed cues and clear ladder.','The ladder breathes cold air. Check your quiver before the summit.')\n ],links:[{points:[[13,29],[20,29]]},{points:[[27,24],[27,15]]},{points:[[33,10],[40,10]]},{points:[[52,10],[69,10]]},{points:[[46,15],[46,29]]},{points:[[33,29],[59,29]]},{points:[[65,29],[65,10]]}],\n enemies:[enemy('tide-ooze','ooze',27,29),enemy('tide-bat','bat',26,10),enemy('tide-watch-drake','drake',46,10),enemy('tide-key-snake','snake',65,28),enemy('tide-ladder-drake','drake',75,11)],\n pickups:[pickup('tide-landing-quiver','arrows',9,28,8),pickup('tide-ink-quiver','arrows',23,8,5),pickup('tide-vault-quiver','arrows',61,26,7),pickup('tide-key','key',68,30,1,{guard:'tide-key-snake'}),pickup('tide-drowned-treasure','treasure',61,32),pickup('tide-vault-heart','heart',69,32)],\n props:[prop('boat',5,27),prop('torch',11,26),prop('pillar',22,25),prop('pillar',31,32),prop('crystal',22,7),prop('books',43,7),prop('books',50,14),prop('chest',68,30),prop('ladder',76,11),prop('crystal',72,7),prop('bones',61,31)],\n tracks:[{kind:'ooze',from:[21,29],to:[27,29]},{kind:'drake',from:[40,11],to:[46,10]},{kind:'snake',from:[60,28],to:[65,28]}],\n banks:[{id:'tide-lure-bank',a:[30,25],b:[33,28]},{id:'tide-watch-bank',a:[50,7],b:[52,9]}],anchors:[[9,29],[25,9],[61,27]]\n});\ncaves.ember=compile({id:'ember',name:'The Bellwether Wing',subtitle:'IV · A CROWN IN TWO PIECES',width:65,height:43,spawnCell:[7,32],exitCell:[56,10],exitGuard:'ember-guardian',reward:'half-ember',next:'rime',entrance:'The summit door closes against the storm. Two old bells answer from opposite wings.',\n rooms:[\n room('ember-threshold','The Crownless Hall',2,26,13,12,'Summit foreshadowing, reserve arrows and final preparation.','Two halves of the Wayfarer’s Crown still hold the storm. Bring them together; bring the morning home.'),\n room('ember-listener','The Ear of Stone',21,25,13,13,'Noise placement and armored-front lesson.','The Bellwether guards its face. A banked arrow or a shot from its flank finds the bright seam.'),\n room('ember-arena','The Bronze Belfry',39,5,21,21,'First guardian; armor, listening, flank and swoop.','Listen for the bronze note. When its wings load, step out of the marked line.'),\n room('ember-cache','The Bellmaker’s Niche',21,5,12,12,'Optional supplies and a listening vantage.','The bellmaker carried arrows instead of a hammer. A practical pilgrim.')\n ],links:[{points:[[14,32],[21,32]]},{points:[[28,26],[28,15]]},{points:[[28,15],[39,15]]},{points:[[33,32],[49,32]]},{points:[[49,32],[49,25]]}],\n enemies:[enemy('ember-snake','snake',28,30),enemy('ember-guardian','guardian1',49,15,{arena:[40,6,59,25],name:'The Bellwether',hp:3})],\n pickups:[pickup('ember-entry-quiver','arrows',10,31,12),pickup('ember-niche-quiver','arrows',25,8,9),pickup('ember-arena-quiver','arrows',42,22,6),pickup('ember-niche-heart','heart',25,10),pickup('ember-half','half-ember',56,10,1,{guard:'ember-guardian'})],\n props:[prop('crown',10,28),prop('torch',4,29),prop('pillar',23,27),prop('pillar',31,35),prop('bell',49,9),prop('pillar',42,8),prop('pillar',57,22),prop('ladder',56,10),prop('bones',23,9)],\n tracks:[{kind:'guardian',from:[41,22],to:[49,15]},{kind:'snake',from:[24,31],to:[28,30]}],\n banks:[{id:'ember-west-bevel',a:[41,12],b:[44,9]},{id:'ember-east-bevel',a:[55,20],b:[58,17]}],anchors:[[9,32],[25,12],[43,22]]\n});\ncaves.rime=compile({id:'rime',name:'The Galeglass Wing',subtitle:'V · THE LAST LIGHT',width:66,height:43,spawnCell:[7,31],exitCell:[56,10],exitGuard:'rime-guardian',reward:'half-rime',entrance:'One crown half rings softly in your pack. The other answers beyond the frost.',\n rooms:[\n room('rime-threshold','The Bridge of One Bell',2,25,13,12,'Between-guardian checkpoint and guaranteed resources.','One half is safe. This wing is a new checkpoint. Its spare arrows are yours even with an empty quiver.'),\n room('rime-web','The Frosted Thread',22,25,13,12,'Spider resource reminder and arrow-light scout.','Silver threads turn blue in the cold. Follow them to the last cache.'),\n room('rime-arena','The Galeglass Choir',40,5,21,21,'Alternating breath lanes, safe banks and recovery wounds.','The Galeglass breathes along the marked lane. Move across it, wait for the light to dim, then shoot.'),\n room('rime-altar','The Morning Niche',22,5,12,12,'Optional treasure and relic assembly foreshadowing.','The crown was made for a road, not a throne. Its light belongs to everyone who finds a way home.')\n ],links:[{points:[[14,31],[22,31]]},{points:[[28,25],[28,15]]},{points:[[28,15],[40,15]]},{points:[[34,31],[50,31]]},{points:[[50,31],[50,25]]}],\n enemies:[enemy('rime-spider','spider',29,30,{stash:[center(32),center(27)]}),enemy('rime-guardian','guardian2',50,15,{arena:[41,6,60,25],name:'The Galeglass',hp:3})],\n pickups:[pickup('rime-entry-quiver','arrows',10,30,12),pickup('rime-web-stash','arrows',32,27,8,{stash:true}),pickup('rime-arena-quiver','arrows',43,22,8),pickup('rime-niche-heart','heart',25,10),pickup('rime-niche-treasure','treasure',28,8),pickup('rime-half','half-rime',56,10,1,{guard:'rime-guardian'})],\n props:[prop('torch',5,28),prop('cobweb',32,26),prop('crystal',25,7),prop('altar',27,9),prop('pillar',43,8),prop('pillar',58,22),prop('bell',50,9),prop('crown',56,10),prop('ladder',56,10)],\n tracks:[{kind:'spider',from:[24,31],to:[32,27]},{kind:'guardian',from:[43,22],to:[50,15]}],\n banks:[{id:'rime-west-bevel',a:[42,12],b:[45,9]},{id:'rime-east-bevel',a:[56,20],b:[59,17]}],anchors:[[9,31],[25,12],[44,22]]\n});\nconst nodes=[\n {id:'camp',name:'Morrow Camp',x:110,y:338,kind:'camp',clue:'Reunite the Wayfarer’s Crown. Three arrows. Three reserves. One road home.'},\n {id:'chalk',name:'The Pale Below',x:251,y:316,kind:'cave',cave:'chalk',clue:'Dry stone. Small prints. An axe beneath the mountain.'},\n {id:'forest',name:'Briarwake',x:366,y:245,kind:'forest',requires:'axe',clue:'The old forest opens to the axe.'},\n {id:'root',name:'Root Hollows',x:493,y:295,kind:'cave',cave:'root',clue:'Bright bevels ring true. Something has hoarded a boat.'},\n {id:'river',name:'Foldwater',x:600,y:227,kind:'river',requires:'boat',clue:'Unfold the ferry. Cross once; cross whenever you need.'},\n {id:'tide',name:'Drowned Archive',x:701,y:305,kind:'cave',cave:'tide',clue:'A patient green listener. A brass key in drowned halls.'},\n {id:'wall',name:'The Kingless Wall',x:785,y:181,kind:'wall',requires:'key',clue:'The Index Key still fits the summit gate.'},\n {id:'summit',name:'Crownweather',x:670,y:91,kind:'summit',cave:'ember',clue:'Two wings. Two guardians. Two halves of the morning.'},\n {id:'spring',name:'The Kind Spring',x:229,y:433,kind:'spring',clue:'Clear water and a ranger’s small reserve. A useful detour.'},\n {id:'lookout',name:'Bellwatch Cairn',x:421,y:128,kind:'lookout',clue:'The summit bells can be heard even here. An old cache waits.'}\n];\nconst edges=[['camp','chalk'],['camp','spring'],['chalk','forest','axe'],['forest','root'],['forest','lookout'],['root','river','boat'],['river','tide'],['tide','wall','key'],['wall','summit'],['lookout','river','boat']].map(([from,to,requires])=>({from,to,requires:requires||null}));\nconst creatures={\n rat:{hp:1,r:6,speed:34,windup:.52,attackTime:.36,recovery:1.25,range:43,hearing:.56,cue:'scratching',caption:'Small claws scratch the stone.'},\n snake:{hp:2,r:7,speed:15,windup:.9,attackTime:.44,recovery:1.8,range:64,hearing:.72,cue:'hiss',caption:'A dry hiss curls around the bend.'},\n bat:{hp:1,r:6,speed:40,windup:.68,attackTime:.5,recovery:1.4,range:52,hearing:.35,cue:'wings',caption:'Wingbeats briefly swallow the quiet.'},\n spider:{hp:1,r:7,speed:31,windup:.8,attackTime:.4,recovery:1.5,range:40,hearing:.48,cue:'skitter',caption:'Thin feet tick against the stone.'},\n ooze:{hp:999,r:12,speed:14,windup:1.1,attackTime:.75,recovery:1.8,range:26,hearing:.18,cue:'ooze',caption:'A slow wet drag answers the noise.'},\n drake:{hp:2,r:10,speed:20,windup:1.25,attackTime:.64,recovery:2.1,range:95,hearing:.65,cue:'snore',caption:'A heavy snore. Then silence.'},\n guardian1:{hp:3,r:19,speed:24,windup:1.4,attackTime:.9,recovery:2.1,range:165,hearing:.28,cue:'bronze',caption:'A bronze note trembles in the dust.'},\n guardian2:{hp:3,r:19,speed:14,windup:1.4,attackTime:1.05,recovery:2.1,range:190,hearing:.5,cue:'glass',caption:'Glass sings; a pale breath gathers.'},\n target:{hp:1,r:9,speed:0,windup:1,attackTime:1,recovery:1,range:0,hearing:999,cue:'gong',caption:'A brass gong waits beyond the bevel.'}\n};\nfunction validate(){const errors=[], ids=new Set();\n for(const cave of Object.values(caves)){\n  const valid=(x,y)=>cave.rows[Math.floor(y/TILE)]?.[Math.floor(x/TILE)]==='.';\n  for(const r of cave.rooms){if(ids.has(r.id))errors.push('duplicate '+r.id);ids.add(r.id);if(!r.purpose)errors.push('missing purpose '+r.id);}\n    const info = await root.AIHub.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!info) return null;\n    const link = new Link(hooks, { mode: 'hub', authority: info.isHost, dedicated: info.server, localId: info.me, hostId: info.host, playerIds: info.players.map((p) => p.id), seed: info.seed, nonce: `hub-${info.round}-${info.seed}`, send: (p, to) => root.AIHub.send(p, { to, reliable: true }) });\n    link.removers.push(root.AIHub.on('start', () => { link.started = true; hooks.status?.('The expedition begins at the common signal.'); }));\n    link.removers.push(root.AIHub.on('message', (p, from) => link.receive(p, from)));\n    link.removers.push(root.AIHub.on('leave', ({ id }) => { link.removePlayer(id); hooks.status?.('A ranger has left. The remaining expedition continues.'); }));\n    link.removers.push(root.AIHub.on('time-up', () => { if (link.authority) { hooks.timeUp?.(); link.finish(false, hooks.result?.()?.stats || {}); } }));\n    link.removers.push(root.AIHub.on('end', ({ reason }) => link.stop(reason)));\n    // All lifecycle listeners are in place before this single genuine loading completion.\n    root.AIHub.ready();\n    return link;\n  }\n  function encodeSignal(signal) {\n    const text = JSON.stringify(signal);\n    return `DT1.${root.btoa(unescape(encodeURIComponent(text)))}`;\n  }\n  function decodeSignal(text, role, nonce) {\n    if (typeof text !== 'string' || text.length > 262144 || !text.trim().startsWith('DT1.')) throw new Error('This is not a Dungeons and Deeper Trouble invitation or reply.');\n    let s;\n    try { s = JSON.parse(decodeURIComponent(escape(root.atob(text.trim().slice(4))))); } catch { throw new Error('The pairing text is incomplete or damaged. Copy the entire invitation or reply.'); }\n    if (s.v !== VERSION || s.c !== CONTENT) throw new Error('These expeditions use different game versions. Load the same HTML on both devices.');\n    if (s.role !== role || (nonce && s.nonce !== nonce)) throw new Error('That pairing text belongs to another invitation or the wrong step.');\n    if (typeof s.nonce !== 'string' || s.nonce.length > 64 || !Number.isFinite(s.at) || Math.abs(Date.now() - s.at) > 600000) throw new Error('This invitation has expired. Ask the host for a new one.');\n    const type = role === 'host' ? 'offer' : 'answer';\n    if (s.desc?.type !== type || typeof s.desc.sdp !== 'string' || s.desc.sdp.length > 150000 || !s.desc.sdp.startsWith('v=0')) throw new Error('The pairing text has no valid connection description.');\n    return s;\n  }\n  class Peer {\n    constructor(hooks, options = {}) {\n      if (root.AIHub?.active) throw new Error('AI Hub owns this round’s network.');\n      this.hooks = hooks || {};\n      this.options = options;\n      this.pc = null; this.channel = null; this.link = null;\n      this.nonce = null; this.role = null; this.cancelled = false;\n      this.status = 'Choose Host or Join.';\n      this.timeout = null; this.gatherCancel = null;\n    }\n    say(text) { this.status = text; this.hooks.status?.(text); }\n    makePC() {\n      if (!root.RTCPeerConnection) throw new Error('This browser does not support direct WebRTC co-op. Solo and couch co-op remain available.');\n      this.cancelled = false;\n      // STUN is discovery only. There is deliberately no undisclosed signaling or relay service.\n      this.pc = new root.RTCPeerConnection({ iceServers: this.options.iceServers ?? [{ urls: 'stun:stun.l.google.com:19302' }] });\n      this.pc.onconnectionstatechange = () => {\n        const state = this.pc?.connectionState;\n        if (state === 'failed') this.fail('Direct connection failed. Some networks require a TURN relay; try another network or couch co-op.');\n        if (state === 'disconnected') { this.say('Connection interrupted. Waiting briefly for the same peer…'); this.timeout = setTimeout(() => { if (this.pc?.connectionState === 'disconnected') this.lost(); }, 6000); }\n        if (state === 'connected') { if (this.timeout) clearTimeout(this.timeout); this.timeout = null; }\n        if (state === 'closed' && !this.cancelled) this.lost();\n      };\n      this.pc.ondatachannel = (e) => { if (e.channel.label === 'dt-expedition') this.bindChannel(e.channel); else e.channel.close(); };\n    }\n    bindChannel(channel) {\n      if (this.channel && this.channel !== channel) { channel.close(); return; }\n      this.channel = channel;\n      channel.onopen = () => { this.say('Connected. Checking expedition version…'); this.raw({ hello: VERSION, c: CONTENT, nonce: this.nonce, role: this.role }); };\n      channel.onmessage = (e) => {\n        if (typeof e.data !== 'string' || e.data.length > MAX_PACKET) return;\n        let m; try { m = JSON.parse(e.data); } catch { return; }\n        if (m.hello) {\n          if (m.hello !== VERSION || m.c !== CONTENT || m.nonce !== this.nonce || m.role === this.role) return this.fail('The peer failed the expedition version check.');\n          if (!this.link) this.start();\n        } else if (this.link) this.link.receive(m, this.role === 'host' ? 1 : 0);\n      };\n      channel.onclose = () => { if (!this.cancelled) this.lost(); };\n      channel.onerror = () => this.say('The data channel reported a connection error.');\n    }\n    raw(m) { if (this.channel?.readyState !== 'open') return false; this.channel.send(JSON.stringify(m)); return true; }\n    async gathered() {\n      const pc = this.pc;\n      if (pc.iceGatheringState === 'complete') return;\n      await new Promise((resolve, reject) => {\n        const timer = setTimeout(() => { pc.removeEventListener('icegatheringstatechange', change); this.gatherCancel = null; reject(new Error('Candidate discovery timed out. Cancel and try again on another network.')); }, 15000);\n        this.gatherCancel = () => { clearTimeout(timer); pc.removeEventListener('icegatheringstatechange', change); this.gatherCancel = null; reject(new Error('Pairing was cancelled.')); };\n        const change = () => { if (pc.iceGatheringState === 'complete') { clearTimeout(timer); pc.removeEventListener('icegatheringstatechange', change); this.gatherCancel = null; resolve(); } };\n        pc.addEventListener('icegatheringstatechange', change);\n        if (pc.iceGatheringState === 'complete') change();\n      });\n      if (this.cancelled) throw new Error('Pairing was cancelled.');\n    }\n    async offer() {\n      this.cancel(); this.role = 'host'; this.nonce = token(); this.makePC();\n      this.say('Preparing invitation. Discovering a direct path…');\n      this.bindChannel(this.pc.createDataChannel('dt-expedition', { ordered: true }));\n      try { await this.pc.setLocalDescription(await this.pc.createOffer()); await this.gathered(); const s = encodeSignal({ v: VERSION, c: CONTENT, role: 'host', nonce: this.nonce, at: Date.now(), desc: this.pc.localDescription }); this.say('Copy the invitation to the guest. Paste their reply here.'); return s; } catch (e) { this.fail(e.message); throw e; }\n    }\n    async answer(text) {\n      const signal = decodeSignal(text, 'host');\n      this.cancel(); this.role = 'guest'; this.nonce = signal.nonce; this.makePC();\n      this.say('Preparing reply. Discovering a direct path…');\n      try { await this.pc.setRemoteDescription(signal.desc); await this.pc.setLocalDescription(await this.pc.createAnswer()); await this.gathered(); const s = encodeSignal({ v: VERSION, c: CONTENT, role: 'guest', nonce: this.nonce, at: Date.now(), desc: this.pc.localDescription }); this.say('Copy this reply to the host. Play starts once they connect.'); return s; } catch (e) { this.fail(e.message); throw e; }\n    }\n    async accept(text) {\n      if (this.role !== 'host' || !this.pc) throw new Error('Create a host invitation before pasting a reply.');\n      const signal = decodeSignal(text, 'guest', this.nonce);\n      await this.pc.setRemoteDescription(signal.desc);\n      this.say('Connecting to the invited ranger…');\n    }\n    start() {\n      const host = this.role === 'host';\n      this.link = new Link(this.hooks, { mode: 'peer', authority: host, localId: host ? 0 : 1, hostId: 0, playerIds: [0, 1], seed: this.options.seed ?? 1729, nonce: this.nonce, send: (m) => this.raw(m) });\n","exit_code":0,"status":"completed"}}
