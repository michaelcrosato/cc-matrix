{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9YWws1oZvUtNHuFUmN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RNX9mRXYMZy1JnQdrTiFmw","name":"Bash","input":{"command":"sed -n 1,80p engine/input/aim.ts; echo ....; sed -n 1,110p engine/input/actionMaps.ts; echo ....; sed -n 1,60p engine/input/intents.ts; echo ...; grep -n \"seed\\|restart\\|pause\\|resume\\|set(\\|scene\\b\" engine/dev/inspector.ts | head -50","description":"Read the aim rules, action maps, intents and inspector members"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16124,"cache_read_input_tokens":192084,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16124},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"82bcd4f3-0635-4310-acf0-6d4c081dade9","timestamp":"2026-11-05T04:27:00.627Z","request_id":"req_011Cgj9YWiU9pe9sAcDuhuxB","wire_tool_inputs":{"toolu_01RNX9mRXYMZy1JnQdrTiFmw":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/engine && sed -n 1,80p engine/input/aim.ts; echo ....; sed -n 1,110p engine/input/actionMaps.ts; echo ....; sed -n 1,60p engine/input/intents.ts; echo ...; grep -n \"seed\\|restart\\|pause\\|resume\\|set(\\|scene\\b\" engine/dev/inspector.ts | head -50","description":"Read the aim rules, action maps, intents and inspector members"}},"wire_ingest_context":{"toolu_01RNX9mRXYMZy1JnQdrTiFmw":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/engine"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNX9mRXYMZy1JnQdrTiFmw","type":"tool_result","content":"/**\n * @file Aiming (PLAN.md WP 13.9, docs/PLAYGROUND.md §4; doctrine: Reproducible): the point a player aims at, which the\n * intents' `aim` carries, by the rule an action map names (`aimWith`, engine/input/actionMaps.ts): `centre`, the screen\n * centre's ray to what it meets (first person and the shooter: the body aims at that point); `pointer`, the pointer's\n * ray onto the level plane a level shot leaves at (`height` above the player's feet: isometric and top-down), or, on a\n * pad, the right stick pushed from the player along the floor (twin sticks); `none`, no aim. The page works the point\n * out each frame from the camera it drew and records it with the step's other intents, so the sim reads only the\n * point, and live play replays without a camera.\n *\n * `screenRay(pose, at, aspect)` is the ray through the point `at` of the picture (`[x, y]` from −1 to 1, +y up:\n * three.js's normalized device coordinates) for a perspective or orthographic pose, the boost's stretch of heights\n * undone, so it runs through true heights; `onFloor(ray, y)` is where it meets the level plane at height `y`;\n * `aimPoint(rule, view)` the aim from the camera, the pointer, the stick, the player's feet and a raycast into the\n * world, which the app passes in (the sim's read-only queries, the player's own body skipped).\n *\n * Invariants: pure, plain numbers in and out (the input layer imports no camera and no physics); a ray's direction has\n * length 1; the roll the view effects add is left out (the centre's ray is the same either way); `aimPoint` is\n * undefined when the rule aims nowhere this frame (no player, the pointer off the picture and the stick at rest).\n *\n * @example\n * const top = { position: [0, 10, 0], yaw: 0, pitch: -Math.PI / 2, projection: 'orthographic', fov: 50, frustumSize: 20, zoom: 1 } as const; // prettier-ignore\n * screenRay(top, [0, 0], 1).direction; // [0, -1, 6e-17]: straight down\n * onFloor(screenRay(top, [0.5, 0], 1), 0); // [-5, 0, 0]: right of the middle (right is −X facing +Z)\n * aimPoint('pointer', { pose: top, aspect: 1, feet: [0, 0, 0], pointer: [0, 0.5] }); // [0, 0, 5]: up the picture\n * const eye = { position: [0, 1.5, 0], yaw: 0, pitch: 0, projection: 'perspective', fov: 70, frustumSize: 0, zoom: 1 } as const; // prettier-ignore\n * aimPoint('centre', { pose: eye, aspect: 1, feet: [0, 0, 0], eye: [0, 1.5, 0], cast: () => 4 }); // [0, 1.5, 4]\n * @see engine/input/aim.test.ts\n */\nimport { fromCamera } from './intents';\n\n/** A point or direction, m. */\nexport type Vec3 = readonly [number, number, number];\n\n/** What aims a player's look or pointer, by an action map's `aim`: see the file comment. */\nexport type AimRule = 'none' | 'centre' | 'pointer';\n\n/** The aim rules, in the order the docs list them. */\nexport const AIM_RULES: readonly AimRule[] = Object.freeze(['none', 'centre', 'pointer']);\n\n/** How far the centre's ray looks (m): one that meets nothing aims this far along it. */\nexport const AIM_RANGE = 100;\n\n/** How far from the player a right stick pushed all the way aims (m): twin sticks aim by direction. */\nexport const STICK_REACH = 5;\n\n/** A camera's pose as aiming reads it: engine/gfx/cameras/pose.ts's `CameraPose` fits it. */\nexport interface AimPose {\n  readonly position: Vec3;\n  /** The heading of the view direction, rad: forward(ψ) = (sin ψ, 0, cos ψ). */\n  readonly yaw: number;\n  /** Up or down from level, rad: + up. */\n  readonly pitch: number;\n  readonly projection: 'perspective' | 'orthographic';\n  /** The vertical field of view the picture was drawn with, degrees. */\n  readonly fov: number;\n  /** Orthographic: the frustum's height at zoom 1, m. */\n  readonly frustumSize: number;\n  /** 2 shows half as much. */\n  readonly zoom: number;\n  /** Heights stretched in the picture by this, about y = 0 (engine/gfx/cameras/boost.ts); 1 when absent. */\n  readonly boost?: number;\n}\n\n/** A ray: where it starts and its unit direction. */\nexport interface AimRay {\n  readonly origin: Vec3;\n  readonly direction: Vec3;\n}\n\n/** What `aimPoint` aims from: the camera drawn, the picture's aspect, the devices and the world. */\nexport interface AimView {\n  readonly pose: AimPose;\n  /** The picture's width over its height. */\n  readonly aspect: number;\n  /** The player's feet, m; none without a player (nothing is aimed). */\n  readonly feet?: Vec3;\n  /**\n   * The player's eye, m (the feet when absent): the centre's ray counts only what lies beyond it, so a camera behind\n   * the player never aims at what stands between them.\n   */\n....\n/**\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\n *\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\n * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\n * (`createEngine({ actionMap })`, WP 13.9).\n *\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\n * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\n *\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\n * shared registry when this module loads.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\n *\n * @example\n * const map = getActionMap('actionMap:thirdPerson');\n * map.actions.jump; // ['Space', 'PadSouth']\n * map.move; // ['forward', 'back', 'left', 'right']\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\n * @see engine/input/bindings.test.ts\n */\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { show, type Schema } from '../core/schema';\nimport { AIM_RULES, type AimRule } from './aim';\nimport { isCode } from './codes';\n\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\n  pause: ['Escape', 'PadStart'],\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\n  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\n});\n\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\n  'Escape',\n  'PadStart',\n  'PadHome',\n  'F5',\n  'F11',\n  'F12',\n  'MetaLeft',\n  'MetaRight',\n]);\n\n/** The fields of an `actionMap` entry. */\nconst ACTION_MAP_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\n  actions: {\n    type: 'object',\n    required: true,\n    description:\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\n  },\n  move: {\n    type: 'array',\n    items: { type: 'string' },\n    default: ['forward', 'back', 'left', 'right'],\n    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\n  },\n  values: {\n    type: 'object',\n    default: {},\n    description:\n      'Custom intent key (\"game:throttle\") → action: its analog strength (0 to 1, a trigger) is that intent.',\n  },\n  look: {\n    type: 'boolean',\n    default: false,\n    description: \"True for first person and the shooter: the intents carry look = [the camera's yaw, its pitch].\",\n  },\n  aimWith: {\n    type: 'string',\n    enum: AIM_RULES,\n    default: 'none',\n    description:\n      \"What the intents' aim holds: none; centre, the point the screen centre's ray meets (first person, the shooter); pointer, the pointer's ray onto the player's floor or a right stick's push (isometric, top-down).\",\n  },\n  lock: {\n    type: 'boolean',\n    default: false,\n    description:\n      'True when the mouse turns the view: a click on the game takes the pointer lock, which pause and Escape give back.',\n  },\n  view: {\n    type: 'array',\n    items: { type: 'string' },\n    default: [],\n    description:\n....\n/**\n * @file The intents vocabulary (PLAN.md §6.4, §6.5 item 3, §8.4, WP 1.5; doctrine: Reproducible): everything the sim\n * reads from outside arrives once per step as plain data, recorded by replays. `move` is a world-space direction\n * `[x, z]` (`fromCamera` turns a stick or keys into one, so W walks away from the camera), `cam` the camera heading,\n * `aim` a world-space aim point, `look` a view direction, `b` the buttons held and `p` the buttons pressed this step,\n * and game code adds its own keys, namespaced (`'game:charge'`). Devices (WP 3.3) make intents; the sim only reads them.\n *\n * Invariants: `normalizeIntents` checks every key and value (an unknown key names the closest; numbers are finite;\n * custom values are plain data) and returns a frozen object with keys in a fixed order, buttons sorted and unique, and\n * absent or empty entries left out. `p` is the union of the presses given and the edges of `b` (held now, not held the\n * step before), so a press is never lost and a hold presses once; when one frame runs several steps, the frame loop\n * passes its taps to the first step only (§6.4). `diffIntents` and `applyIntents` are the replay encoding (§8.4): held\n * state repeats until a change-point changes it (`null` clears a key), `p` belongs to its step and is written only for\n * presses the edges of `b` do not explain, so `applyIntents(prev, diffIntents(prev, next))` is `next` again. `-0` is\n * kept (`Object.is`), since replays must give the sim the very bits live play gave it.\n *\n * `cam` is the yaw of the camera's horizontal view direction, forward(ψ) = (sin ψ, 0, cos ψ) (§6.3), not three.js's\n * `camera.rotation.y`, which is ψ − π since a camera looks down its −Z.\n *\n * Edges, buffering and `consume` in sim time (WP 3.3): an `InputBuffer` is what a body remembers of its buttons across\n * steps, plain data in a component field, so the world hashes, captures and restores it. `updateInputBuffer(buffer,\n * intents, w.tick)` runs once per step (a system in the phase `intents`); then `released` says a button went up this\n * step (a tap shorter than a step is pressed and released on the same one), `buffered` that it was pressed within the\n * last `BUFFER_STEPS` steps and not yet used up by `consume` (a jump pressed just before landing still jumps), and\n * `repeated` that a held button repeats, as a menu cursor does. Carried from `my-3d2dge:engine/my-3d2dge.js:564-583`\n * (`released`, `repeat`, `buffered`, `consume`, `consumeAll`), counted in steps instead of seconds.\n *\n * @example\n * const step1 = normalizeIntents({ move: fromCamera(Math.PI / 2, [0, 1]), b: ['jump'] }); // move ≈ [1, 0]: +X\n * pressed(step1, 'jump'); // true: an edge of b\n * const step2 = normalizeIntents({ move: step1.move, b: ['jump'] }, step1);\n * [held(step2, 'jump'), pressed(step2, 'jump')]; // [true, false]\n * diffIntents(step1, normalizeIntents({}, step1)); // { b: null, move: null }\n * const buffer = updateInputBuffer(createInputBuffer(), step1, 1);\n * buffered(buffer, 'jump'); // true for 9 steps, or until consume(buffer, 'jump')\n * @see engine/input/intents.test.ts\n * @see engine/input/buffer.test.ts\n */\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { isPlainObject, show } from '../core/schema';\n\n/** The codes this module raises, with their fixes. */\nexport const INTENT_CODES = defineCodes('input', {\n  INPUT_BAD_INTENTS: {\n    template: '{where}: {problems}',\n    fix: 'give intents as { move: [x, z], cam, aim: [x, y, z], look: [yaw, pitch], b: [held buttons], p: [pressed buttons] } with finite numbers, plus custom keys namespaced \"game:key\" holding plain data (engine/input/intents.ts); null or a missing key means not given',\n    doc: 'Raised by `normalizeIntents`, `applyIntents` and the replay checks (engine/input/intents.ts, engine/sim/replay.ts) for an unknown key (named with the closest), a non-finite or misshapen number, a button that is not a non-empty string, or a custom value that is not plain data. Every problem is listed at once.',\n  },\n});\n\n/** A custom intent's value: plain data, as a replay file holds it. */\nexport type IntentValue = number | string | boolean | readonly IntentValue[] | { readonly [key: string]: IntentValue };\n\n/** A namespaced key for game code's own intents: `'game:charge'`. */\nexport type CustomIntentKey = `${string}:${string}`;\n\n/** One step's intents, as the sim reads them (systems get them as their second argument). */\nexport type Intents = {\n  /** The direction to move in, world space `[x, z]`, length 1 at most from `fromCamera`. */\n  readonly move?: readonly [number, number];\n...\n8: * name (`scene.dump`) is a call on a namespace object. A call checks its arguments against the member's schema\n13: * recorded); `errors` and `advice` → the log; `pause`, `resume`, `step` and `timeScale` → the clock (steps recorded\n15: * refuses a capture this run did not take or one changed since: engine/sim/scene.ts); `state`, `hash`, `trace`,\n16: * `entities` and `get` → the world, read-only (a query names an undeclared component with the closest); `seed(n)`\n17: * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n74:  scene: string;\n75:  seed: number;\n89:  pause(): void;\n90:  resume(): void;\n93:  seed(n?: number): number;\n99:  set(path: string, value: unknown): SettingChange;\n106:  /** The members later WPs register (`input`, `stats`, `scene.dump`…). */\n178:    help: \"The engine's identity and health (version, runtime, adapter, features, downgrades, deps) and the run: scene, seed, tick, hz.\",\n187:      scene: h.session.scene.id,\n188:      seed: h.session.world.seed,\n193:  pause: {\n194:    help: 'Pauses sim time (the time.paused setting); step(n) still runs single steps.',\n195:    impl: (h) => h.clock.pause(),\n197:  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n221:  seed: {\n222:    help: \"Starts the scene again with seed n (keeping the settings changed since it started) when n is given; returns the run's seed.\",\n224:      n: { type: 'integer', minimum: 0, description: 'The new seed: a whole number, 0 or more, as replays hold it.' },\n227:      if (n !== undefined) h.restart(n);\n228:      return h.session.world.seed;\n274:      return h.session.set(path, typed);","is_error":false}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"41040999-96d5-4697-9628-9e8dea439a13","timestamp":"2026-11-05T04:27:00.706Z","tool_use_result":{"stdout":"/**\n * @file Aiming (PLAN.md WP 13.9, docs/PLAYGROUND.md §4; doctrine: Reproducible): the point a player aims at, which the\n * intents' `aim` carries, by the rule an action map names (`aimWith`, engine/input/actionMaps.ts): `centre`, the screen\n * centre's ray to what it meets (first person and the shooter: the body aims at that point); `pointer`, the pointer's\n * ray onto the level plane a level shot leaves at (`height` above the player's feet: isometric and top-down), or, on a\n * pad, the right stick pushed from the player along the floor (twin sticks); `none`, no aim. The page works the point\n * out each frame from the camera it drew and records it with the step's other intents, so the sim reads only the\n * point, and live play replays without a camera.\n *\n * `screenRay(pose, at, aspect)` is the ray through the point `at` of the picture (`[x, y]` from −1 to 1, +y up:\n * three.js's normalized device coordinates) for a perspective or orthographic pose, the boost's stretch of heights\n * undone, so it runs through true heights; `onFloor(ray, y)` is where it meets the level plane at height `y`;\n * `aimPoint(rule, view)` the aim from the camera, the pointer, the stick, the player's feet and a raycast into the\n * world, which the app passes in (the sim's read-only queries, the player's own body skipped).\n *\n * Invariants: pure, plain numbers in and out (the input layer imports no camera and no physics); a ray's direction has\n * length 1; the roll the view effects add is left out (the centre's ray is the same either way); `aimPoint` is\n * undefined when the rule aims nowhere this frame (no player, the pointer off the picture and the stick at rest).\n *\n * @example\n * const top = { position: [0, 10, 0], yaw: 0, pitch: -Math.PI / 2, projection: 'orthographic', fov: 50, frustumSize: 20, zoom: 1 } as const; // prettier-ignore\n * screenRay(top, [0, 0], 1).direction; // [0, -1, 6e-17]: straight down\n * onFloor(screenRay(top, [0.5, 0], 1), 0); // [-5, 0, 0]: right of the middle (right is −X facing +Z)\n * aimPoint('pointer', { pose: top, aspect: 1, feet: [0, 0, 0], pointer: [0, 0.5] }); // [0, 0, 5]: up the picture\n * const eye = { position: [0, 1.5, 0], yaw: 0, pitch: 0, projection: 'perspective', fov: 70, frustumSize: 0, zoom: 1 } as const; // prettier-ignore\n * aimPoint('centre', { pose: eye, aspect: 1, feet: [0, 0, 0], eye: [0, 1.5, 0], cast: () => 4 }); // [0, 1.5, 4]\n * @see engine/input/aim.test.ts\n */\nimport { fromCamera } from './intents';\n\n/** A point or direction, m. */\nexport type Vec3 = readonly [number, number, number];\n\n/** What aims a player's look or pointer, by an action map's `aim`: see the file comment. */\nexport type AimRule = 'none' | 'centre' | 'pointer';\n\n/** The aim rules, in the order the docs list them. */\nexport const AIM_RULES: readonly AimRule[] = Object.freeze(['none', 'centre', 'pointer']);\n\n/** How far the centre's ray looks (m): one that meets nothing aims this far along it. */\nexport const AIM_RANGE = 100;\n\n/** How far from the player a right stick pushed all the way aims (m): twin sticks aim by direction. */\nexport const STICK_REACH = 5;\n\n/** A camera's pose as aiming reads it: engine/gfx/cameras/pose.ts's `CameraPose` fits it. */\nexport interface AimPose {\n  readonly position: Vec3;\n  /** The heading of the view direction, rad: forward(ψ) = (sin ψ, 0, cos ψ). */\n  readonly yaw: number;\n  /** Up or down from level, rad: + up. */\n  readonly pitch: number;\n  readonly projection: 'perspective' | 'orthographic';\n  /** The vertical field of view the picture was drawn with, degrees. */\n  readonly fov: number;\n  /** Orthographic: the frustum's height at zoom 1, m. */\n  readonly frustumSize: number;\n  /** 2 shows half as much. */\n  readonly zoom: number;\n  /** Heights stretched in the picture by this, about y = 0 (engine/gfx/cameras/boost.ts); 1 when absent. */\n  readonly boost?: number;\n}\n\n/** A ray: where it starts and its unit direction. */\nexport interface AimRay {\n  readonly origin: Vec3;\n  readonly direction: Vec3;\n}\n\n/** What `aimPoint` aims from: the camera drawn, the picture's aspect, the devices and the world. */\nexport interface AimView {\n  readonly pose: AimPose;\n  /** The picture's width over its height. */\n  readonly aspect: number;\n  /** The player's feet, m; none without a player (nothing is aimed). */\n  readonly feet?: Vec3;\n  /**\n   * The player's eye, m (the feet when absent): the centre's ray counts only what lies beyond it, so a camera behind\n   * the player never aims at what stands between them.\n   */\n....\n/**\n * @file Action maps and presets (PLAN.md WP 3.3, I-24; doctrine: Common ground): the registry kind `actionMap`, a set\n * of named actions with the physical codes bound to each (engine/input/codes.ts), as Unity's action maps and Godot's\n * InputMap hold them; the presets; and the system layer, which no player rebinds.\n *\n * An action is a button the sim reads: held actions arrive as the intents' `b`, pressed ones as `p`\n * (engine/input/intents.ts). The four actions a map names in `move` (forward, back, left, right) are not buttons:\n * their strengths make the move axes `[right − left, forward − back]`, so keys walk at full speed and a half-pushed\n * stick at half, and `fromCamera` turns the axes into a world direction. `values` writes an action's analog strength\n * (a trigger) as a custom intent. `look: true` (first person, the shooter) adds the camera's view direction as `look`,\n * `aimWith` names the rule that gives the intents' `aim` its point (engine/input/aim.ts: the screen centre's ray, the\n * pointer's onto the floor, or none; the action `aim`, where a map has one, raises the sights), and `lock: true` takes\n * the pointer lock on a click so the mouse turns the view (with the cursor free, it points and aims). The actions a\n * map names in `view` (a camera switch, a view's turn) are the page's: bound and rebound like the others, never\n * buttons in the intents (`createEngine({ onView })`). A game with several camera modes gives each its own map\n * (`createEngine({ actionMap })`, WP 13.9).\n *\n * The system layer (`SYSTEM_ACTIONS`): pause, and the menu's accept, cancel and directions. It is always active\n * beside the map, never rebound, and never part of the intents: the app and the UI read it (`input.pressed('pause')`),\n * so remapping movement never breaks a menu (the lesson of `my-3d2dge:docs/CONTROLS-AUDIT.md`). `RESERVED_CODES` (the\n * pause buttons, and keys the browser or system keeps) and a map's own `reserved` codes are refused by rebinding.\n *\n * Invariants (`CORE_BAD_SPEC` when broken): every code is valid (`isCode`), action names are lower-case words\n * (`jump`, `skill2`) and none is a system action, `move` names four actions of the map and `view` others, `values` keys\n * are namespaced custom intents naming actions of the map, and no action binds a reserved code. The presets are registered on the\n * shared registry when this module loads.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:670-693` (`Input.DEFAULT`, `PLATFORMER`, `SHMUP`, `MENU_KEYS`) with 3D\n * movement, and shardfall's layer that is never rebound (`shardfall:crates/pav_app/src/input.rs:131-161`).\n *\n * @example\n * const map = getActionMap('actionMap:thirdPerson');\n * map.actions.jump; // ['Space', 'PadSouth']\n * map.move; // ['forward', 'back', 'left', 'right']\n * SYSTEM_ACTIONS.pause; // ['Escape', 'PadStart']\n * listActionMaps().map((entry) => entry.id); // ['actionMap:firstPerson', 'actionMap:platformer', …]\n * @see engine/input/bindings.test.ts\n */\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { show, type Schema } from '../core/schema';\nimport { AIM_RULES, type AimRule } from './aim';\nimport { isCode } from './codes';\n\n/** The system layer: action → codes. Always active, never rebound, never in the intents. */\nexport const SYSTEM_ACTIONS: Readonly<Record<string, readonly string[]>> = Object.freeze({\n  pause: ['Escape', 'PadStart'],\n  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\n  uiCancel: ['Escape', 'Backspace', 'PadEast'],\n  uiUp: ['ArrowUp', 'PadUp', 'PadLeftStickUp'],\n  uiDown: ['ArrowDown', 'PadDown', 'PadLeftStickDown'],\n  uiLeft: ['ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\n  uiRight: ['ArrowRight', 'PadRight', 'PadLeftStickRight'],\n});\n\n/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\nexport const RESERVED_CODES: readonly string[] = Object.freeze([\n  'Escape',\n  'PadStart',\n  'PadHome',\n  'F5',\n  'F11',\n  'F12',\n  'MetaLeft',\n  'MetaRight',\n]);\n\n/** The fields of an `actionMap` entry. */\nconst ACTION_MAP_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the map is for, in plain words.' },\n  actions: {\n    type: 'object',\n    required: true,\n    description:\n      'Action name → the codes bound to it (KeyboardEvent.code, MouseLeft…, PadSouth…, PadLeftStickUp…): held actions are the intents b, pressed ones p.',\n  },\n  move: {\n    type: 'array',\n    items: { type: 'string' },\n    default: ['forward', 'back', 'left', 'right'],\n    description: 'The four actions that walk, as forward, back, left, right: their strengths make the move axes.',\n  },\n  values: {\n    type: 'object',\n    default: {},\n    description:\n      'Custom intent key (\"game:throttle\") → action: its analog strength (0 to 1, a trigger) is that intent.',\n  },\n  look: {\n    type: 'boolean',\n    default: false,\n    description: \"True for first person and the shooter: the intents carry look = [the camera's yaw, its pitch].\",\n  },\n  aimWith: {\n    type: 'string',\n    enum: AIM_RULES,\n    default: 'none',\n    description:\n      \"What the intents' aim holds: none; centre, the point the screen centre's ray meets (first person, the shooter); pointer, the pointer's ray onto the player's floor or a right stick's push (isometric, top-down).\",\n  },\n  lock: {\n    type: 'boolean',\n    default: false,\n    description:\n      'True when the mouse turns the view: a click on the game takes the pointer lock, which pause and Escape give back.',\n  },\n  view: {\n    type: 'array',\n    items: { type: 'string' },\n    default: [],\n    description:\n....\n/**\n * @file The intents vocabulary (PLAN.md §6.4, §6.5 item 3, §8.4, WP 1.5; doctrine: Reproducible): everything the sim\n * reads from outside arrives once per step as plain data, recorded by replays. `move` is a world-space direction\n * `[x, z]` (`fromCamera` turns a stick or keys into one, so W walks away from the camera), `cam` the camera heading,\n * `aim` a world-space aim point, `look` a view direction, `b` the buttons held and `p` the buttons pressed this step,\n * and game code adds its own keys, namespaced (`'game:charge'`). Devices (WP 3.3) make intents; the sim only reads them.\n *\n * Invariants: `normalizeIntents` checks every key and value (an unknown key names the closest; numbers are finite;\n * custom values are plain data) and returns a frozen object with keys in a fixed order, buttons sorted and unique, and\n * absent or empty entries left out. `p` is the union of the presses given and the edges of `b` (held now, not held the\n * step before), so a press is never lost and a hold presses once; when one frame runs several steps, the frame loop\n * passes its taps to the first step only (§6.4). `diffIntents` and `applyIntents` are the replay encoding (§8.4): held\n * state repeats until a change-point changes it (`null` clears a key), `p` belongs to its step and is written only for\n * presses the edges of `b` do not explain, so `applyIntents(prev, diffIntents(prev, next))` is `next` again. `-0` is\n * kept (`Object.is`), since replays must give the sim the very bits live play gave it.\n *\n * `cam` is the yaw of the camera's horizontal view direction, forward(ψ) = (sin ψ, 0, cos ψ) (§6.3), not three.js's\n * `camera.rotation.y`, which is ψ − π since a camera looks down its −Z.\n *\n * Edges, buffering and `consume` in sim time (WP 3.3): an `InputBuffer` is what a body remembers of its buttons across\n * steps, plain data in a component field, so the world hashes, captures and restores it. `updateInputBuffer(buffer,\n * intents, w.tick)` runs once per step (a system in the phase `intents`); then `released` says a button went up this\n * step (a tap shorter than a step is pressed and released on the same one), `buffered` that it was pressed within the\n * last `BUFFER_STEPS` steps and not yet used up by `consume` (a jump pressed just before landing still jumps), and\n * `repeated` that a held button repeats, as a menu cursor does. Carried from `my-3d2dge:engine/my-3d2dge.js:564-583`\n * (`released`, `repeat`, `buffered`, `consume`, `consumeAll`), counted in steps instead of seconds.\n *\n * @example\n * const step1 = normalizeIntents({ move: fromCamera(Math.PI / 2, [0, 1]), b: ['jump'] }); // move ≈ [1, 0]: +X\n * pressed(step1, 'jump'); // true: an edge of b\n * const step2 = normalizeIntents({ move: step1.move, b: ['jump'] }, step1);\n * [held(step2, 'jump'), pressed(step2, 'jump')]; // [true, false]\n * diffIntents(step1, normalizeIntents({}, step1)); // { b: null, move: null }\n * const buffer = updateInputBuffer(createInputBuffer(), step1, 1);\n * buffered(buffer, 'jump'); // true for 9 steps, or until consume(buffer, 'jump')\n * @see engine/input/intents.test.ts\n * @see engine/input/buffer.test.ts\n */\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { isPlainObject, show } from '../core/schema';\n\n/** The codes this module raises, with their fixes. */\nexport const INTENT_CODES = defineCodes('input', {\n  INPUT_BAD_INTENTS: {\n    template: '{where}: {problems}',\n    fix: 'give intents as { move: [x, z], cam, aim: [x, y, z], look: [yaw, pitch], b: [held buttons], p: [pressed buttons] } with finite numbers, plus custom keys namespaced \"game:key\" holding plain data (engine/input/intents.ts); null or a missing key means not given',\n    doc: 'Raised by `normalizeIntents`, `applyIntents` and the replay checks (engine/input/intents.ts, engine/sim/replay.ts) for an unknown key (named with the closest), a non-finite or misshapen number, a button that is not a non-empty string, or a custom value that is not plain data. Every problem is listed at once.',\n  },\n});\n\n/** A custom intent's value: plain data, as a replay file holds it. */\nexport type IntentValue = number | string | boolean | readonly IntentValue[] | { readonly [key: string]: IntentValue };\n\n/** A namespaced key for game code's own intents: `'game:charge'`. */\nexport type CustomIntentKey = `${string}:${string}`;\n\n/** One step's intents, as the sim reads them (systems get them as their second argument). */\nexport type Intents = {\n  /** The direction to move in, world space `[x, z]`, length 1 at most from `fromCamera`. */\n  readonly move?: readonly [number, number];\n...\n8: * name (`scene.dump`) is a call on a namespace object. A call checks its arguments against the member's schema\n13: * recorded); `errors` and `advice` → the log; `pause`, `resume`, `step` and `timeScale` → the clock (steps recorded\n15: * refuses a capture this run did not take or one changed since: engine/sim/scene.ts); `state`, `hash`, `trace`,\n16: * `entities` and `get` → the world, read-only (a query names an undeclared component with the closest); `seed(n)`\n17: * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n74:  scene: string;\n75:  seed: number;\n89:  pause(): void;\n90:  resume(): void;\n93:  seed(n?: number): number;\n99:  set(path: string, value: unknown): SettingChange;\n106:  /** The members later WPs register (`input`, `stats`, `scene.dump`…). */\n178:    help: \"The engine's identity and health (version, runtime, adapter, features, downgrades, deps) and the run: scene, seed, tick, hz.\",\n187:      scene: h.session.scene.id,\n188:      seed: h.session.world.seed,\n193:  pause: {\n194:    help: 'Pauses sim time (the time.paused setting); step(n) still runs single steps.',\n195:    impl: (h) => h.clock.pause(),\n197:  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n221:  seed: {\n222:    help: \"Starts the scene again with seed n (keeping the settings changed since it started) when n is given; returns the run's seed.\",\n224:      n: { type: 'integer', minimum: 0, description: 'The new seed: a whole number, 0 or more, as replays hold it.' },\n227:      if (n !== undefined) h.restart(n);\n228:      return h.session.world.seed;\n274:      return h.session.set(path, typed);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RNX9mRXYMZy1JnQdrTiFmw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
