{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013mP4149Qt7QaGztrKBraqU","type":"tool_result","content":"1\t<!doctype html>\n2\t<html lang=\"en\">\n3\t<head>\n4\t<meta charset=\"utf-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6\t<title>Star Arena — AI Hub session example (shared world)</title>\n7\t<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n8\t<meta name=\"theme-color\" content=\"#1b1530\">\n9\t<meta name=\"hub:type\" content=\"Tech demo\">\n10\t<meta name=\"hub:players\" content=\"1\">\n11\t<meta name=\"hub:session\" content=\"1\">\n12\t<meta name=\"hub:session-players\" content=\"2-4\">\n13\t<meta name=\"hub:session-mode\" content=\"shared-world\">\n14\t<meta name=\"hub:session-minutes\" content=\"2\">\n15\t<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n16\t<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n17\t<style>\n18\t  html, body { margin: 0; height: 100%; background: #1b1530; color: #f3eef7; font: 16px system-ui, sans-serif; overflow: hidden; }\n19\t  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n20\t</style>\n21\t<script>\n22\t/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n23\t(function (root) {\n24\t  'use strict';\n25\t  if (root.AIHub) return;\n26\t\n27\t  var VERSION = '1.4.0';\n28\t  var HELLO_EVERY_MS = 500;\n29\t  var HELLO_TIMEOUT_MS = 10000;\n30\t  var PROGRESS_EVERY_MS = 1000;\n31\t  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n32\t  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n33\t\n34\t  var framed = false;\n35\t  try {\n36\t    framed = root.parent && root.parent !== root;\n37\t  } catch (e) {\n38\t    framed = true;\n39\t  }\n40\t  var search = String(root.location && root.location.search);\n41\t  var flagged = /[?&]aihub=/.test(search);\n42\t  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n43\t\n44\t  var hub = {\n45\t    version: VERSION,\n46\t    protocol: 1,\n47\t    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n48\t    active: !!(flagged && framed),\n49\t    me: null,\n50\t    host: null,\n51\t    isHost: false,\n52\t    players: [],\n53\t    mode: null,\n54\t    seed: 0,\n55\t    limitMs: 0,\n56\t    round: 0,\n57\t    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n58\t    splash: false,\n59\t    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n60\t    seeded: false,\n61\t  };\n62\t\n63\t  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n64\t  function memoryStorage() {\n65\t    var data = Object.create(null);\n66\t    var api = {\n67\t      getItem: function (k) {\n68\t        k = String(k);\n69\t        return k in data ? data[k] : null;\n70\t      },\n71\t      setItem: function (k, v) {\n72\t        data[String(k)] = String(v);\n73\t      },\n74\t      removeItem: function (k) {\n75\t        delete data[String(k)];\n76\t      },\n77\t      clear: function () {\n78\t        for (var k in data) delete data[k];\n79\t      },\n80\t      key: function (i) {\n81\t        var keys = Object.keys(data);\n82\t        return i >= 0 && i < keys.length ? keys[i] : null;\n83\t      },\n84\t    };\n85\t    if (typeof Proxy !== 'function') return api;\n86\t    return new Proxy(api, {\n87\t      get: function (t, k) {\n88\t        if (k === 'length') return Object.keys(data).length;\n89\t        if (typeof k === 'symbol' || k in t) return t[k];\n90\t        return k in data ? data[k] : undefined;\n91\t      },\n92\t      set: function (t, k, v) {\n93\t        if (typeof k !== 'symbol') data[k] = String(v);\n94\t        return true;\n95\t      },\n96\t      has: function (t, k) {\n97\t        return k in data || k in t;\n98\t      },\n99\t      deleteProperty: function (t, k) {\n100\t        delete data[k];\n101\t        return true;\n102\t      },\n103\t      ownKeys: function () {\n104\t        return Object.keys(data);\n105\t      },\n106\t      getOwnPropertyDescriptor: function (t, k) {\n107\t        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n108\t      },\n109\t    });\n110\t  }\n111\t\n112\t  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n113\t  function generator(a) {\n114\t    return function () {\n115\t      a = (a + 0x6d2b79f5) >>> 0;\n116\t      var t = a;\n117\t      t = Math.imul(t ^ (t >>> 15), t | 1);\n118\t      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n119\t      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n120\t    };\n121\t  }\n122\t\n123\t  // A fair start: in a session the game gets an empty storage of its own, so\n124\t  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n125\t  // and nothing the round saves touches the player's own saves.\n126\t  if (hub.active) {\n127\t    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n128\t      try {\n129\t        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n130\t      } catch (e) {\n131\t        warn('could not give the game a fresh ' + stores[s]);\n132\t      }\n133\t    }\n134\t  }\n135\t\n136\t  // Side by side: before any of the game's own scripts run, Math.random becomes\n137\t  // a generator seeded by the hub, so every copy builds the same start.\n138\t  var realRandom = Math.random;\n139\t  var seededRandom = null;\n140\t  if (hub.active && seedArg) {\n141\t    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n142\t    hub.seeded = true;\n143\t  }\n144\t\n145\t  // In a session the hub owns fullscreen: a game that asks for it gets the\n146\t  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n147\t  // hub says when its page goes in and out, so the game's own toggle and its\n148\t  // fullscreenchange listeners work as they always did.\n149\t  var fullscreenOn = false;\n150\t  if (hub.active && root.Element && root.document) {\n151\t    var asks = function (on) {\n152\t      return function () {\n153\t        post('fullscreen', { on: on });\n154\t        return Promise.resolve();\n155\t      };\n156\t    };\n157\t    var proto = root.Element.prototype;\n158\t    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n159\t    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n160\t    var shown = function () {\n161\t      return fullscreenOn ? root.document.documentElement || null : null;\n162\t    };\n163\t    try {\n164\t      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n165\t      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n166\t    } catch (e) {}\n167\t  }\n168\t\n169\t  /**\n170\t   * No hub after all: play on, with Math.random the page's own again. The\n171\t   * empty storage stays: the game has read it already, and what it writes\n172\t   * must never land on the player's real saves.\n173\t   */\n174\t  function standAlone() {\n175\t    hub.active = false;\n176\t    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n177\t    hub.seeded = false;\n178\t  }\n179\t\n180\t  var origin = '*';\n181\t  var welcomed = false;\n182\t  var ended = false;\n183\t  var connecting = null;\n184\t  var goAt = null;\n185\t  var sentReady = false;\n186\t  var reported = false;\n187\t  var handlers = {};\n188\t  var pending = {};\n189\t  var tokens = limits.burst;\n190\t  var refilled = now();\n191\t  var probeFn = null;\n192\t  var lastProgress = -Infinity;\n193\t  var nextProgress = null;\n194\t  var progressTimer = null;\n195\t\n196\t  function now() {\n197\t    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n198\t  }\n199\t\n200\t  function warn(text) {\n201\t    if (root.console) root.console.warn('[AIHub] ' + text);\n202\t  }\n203\t\n204\t  function own(o, k) {\n205\t    return Object.prototype.hasOwnProperty.call(o, k);\n206\t  }\n207\t\n208\t  /** This client's own fields, which no welcome may overwrite. */\n209\t  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n210\t\n211\t  /** A plain JSON copy, or undefined when it is not JSON. */\n212\t  function json(value) {\n213\t    try {\n214\t      var text = JSON.stringify(value);\n215\t      return text === undefined ? undefined : JSON.parse(text);\n216\t    } catch (e) {\n217\t      return undefined;\n218\t    }\n219\t  }\n220\t\n221\t  function post(type, fields) {\n222\t    var msg = { aihub: 1, type: type };\n223\t    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n224\t    try {\n225\t      root.parent.postMessage(msg, origin);\n226\t    } catch (e) {\n227\t      warn('could not reach the hub: ' + e.message);\n228\t    }\n229\t  }\n230\t\n231\t  function emit(type, args) {\n232\t    var list = handlers[type];\n233\t    if (!list || !list.length || pending[type]) {\n234\t      (pending[type] = pending[type] || []).push(args);\n235\t      return;\n236\t    }\n237\t    for (var i = 0; i < list.length; i++) {\n238\t      try {\n239\t        list[i].apply(null, args);\n240\t      } catch (e) {\n241\t        setTimeout(function () {\n242\t          throw e;\n243\t        });\n244\t      }\n245\t    }\n246\t  }\n247\t\n248\t  function onMessage(event) {\n249\t    if (event.source !== root.parent) return;\n250\t    var m = event.data;\n251\t    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n252\t    if (m.type === 'welcome') {\n253\t      if (welcomed) return;\n254\t      welcomed = true;\n255\t      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n256\t      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n257\t      for (var key in m) {\n258\t        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n259\t        hub[key] = m[key];\n260\t      }\n261\t      hub.players = (m.players || []).slice();\n262\t      hub.seed = m.seed >>> 0;\n263\t      hub.isHost = m.me === m.host;\n264\t      hub.splash = m.splash === true;\n265\t      if (m.limits) {\n266\t        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n267\t        tokens = limits.burst;\n268\t      }\n269\t      if (connecting) connecting.resolve(info());\n270\t      return;\n271\t    }\n272\t    if (m.type === 'fullscreen') {\n273\t      fullscreenOn = m.on === true;\n274\t      try {\n275\t        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n276\t      } catch (e) {}\n277\t      return;\n278\t    }\n279\t    if (!welcomed || ended) return;\n280\t    if (m.type === 'start') {\n281\t      goAt = now() + Number(m.in || 0);\n282\t      emit('start', [{ in: Number(m.in || 0) }]);\n283\t    } else if (m.type === 'message') {\n284\t      emit('message', [m.data, m.from]);\n285\t    } else if (m.type === 'leave') {\n286\t      hub.players = hub.players.filter(function (p) {\n287\t        return p.id !== m.id;\n288\t      });\n289\t      emit('leave', [{ id: m.id, reason: m.reason }]);\n290\t    } else if (m.type === 'time-up') {\n291\t      emit('time-up', [{ graceMs: m.graceMs }]);\n292\t    } else if (m.type === 'end') {\n293\t      ended = true;\n294\t      if (progressTimer) clearTimeout(progressTimer);\n295\t      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n296\t    } else {\n297\t      // An event this client has never heard of: hand it on as it came.\n298\t      var detail = {};\n299\t      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n300\t      emit(m.type, [detail]);\n301\t    }\n302\t  }\n303\t\n304\t  function info() {\n305\t    var out = {};\n306\t    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n307\t    out.players = hub.players.slice();\n308\t    return out;\n309\t  }\n310\t\n311\t  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n312\t  hub.connect = function (opts) {\n313\t    if (connecting) return connecting.promise;\n314\t    var done;\n315\t    var promise = new Promise(function (resolve) {\n316\t      done = resolve;\n317\t    });\n318\t    connecting = { promise: promise, resolve: done };\n319\t    if (!hub.active) {\n320\t      done(null);\n321\t      return promise;\n322\t    }\n323\t    opts = opts || {};\n324\t    root.addEventListener('message', onMessage);\n325\t    var started = now();\n326\t    var hello = function () {\n327\t      if (welcomed) return;\n328\t      if (now() - started > HELLO_TIMEOUT_MS) {\n329\t        standAlone();\n330\t        warn('no hub answered; playing normally');\n331\t        done(null);\n332\t        return;\n333\t      }\n334\t      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n335\t      setTimeout(hello, HELLO_EVERY_MS);\n336\t    };\n337\t    hello();\n338\t    return promise;\n339\t  };\n340\t\n341\t  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n342\t  hub.ready = function () {\n343\t    if (!welcomed || sentReady || ended) return;\n344\t    sentReady = true;\n345\t    post('ready', {});\n346\t  };\n347\t\n348\t  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n349\t  hub.answer = function (what) {\n350\t    if (!welcomed || ended || goAt !== null) return;\n351\t    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n352\t    post('answer', { answer: what });\n353\t  };\n354\t\n355\t  hub.on = function (type, fn) {\n356\t    (handlers[type] = handlers[type] || []).push(fn);\n357\t    if (pending[type] && !pending[type].flushing) {\n358\t      pending[type].flushing = true;\n359\t      setTimeout(function () {\n360\t        var queued = pending[type];\n361\t        delete pending[type];\n362\t        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n363\t      });\n364\t    }\n365\t    return function () {\n366\t      var list = handlers[type] || [];\n367\t      var at = list.indexOf(fn);\n368\t      if (at !== -1) list.splice(at, 1);\n369\t    };\n370\t  };\n371\t\n372\t  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n373\t  hub.send = function (data, opts) {\n374\t    if (!welcomed || ended) return false;\n375\t    opts = opts || {};\n376\t    var text;\n377\t    try {\n378\t      text = JSON.stringify(data);\n379\t    } catch (e) {\n380\t      warn('send: data is not JSON');\n381\t      return false;\n382\t    }\n383\t    if (text === undefined) return false;\n384\t    if (text.length > limits.maxBytes) {\n385\t      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n386\t      return false;\n387\t    }\n388\t    var t = now();\n389\t    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n390\t    refilled = t;\n391\t    if (tokens < 1) {\n392\t      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n393\t      return false;\n394\t    }\n395\t    tokens -= 1;\n396\t    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n397\t    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n398\t    post('send', fields);\n399\t    return true;\n400\t  };\n401\t\n402\t  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n403\t  hub.time = function () {\n404\t    return goAt === null ? -Infinity : now() - goAt;\n405\t  };\n406\t\n407\t  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n408\t  hub.rng = function (label) {\n409\t    var h = 2166136261;\n410\t    var s = String(label === undefined ? '' : label);\n411\t    for (var i = 0; i < s.length; i++) {\n412\t      h ^= s.charCodeAt(i);\n413\t      h = Math.imul(h, 16777619);\n414\t    }\n415\t    return generator((hub.seed ^ h) >>> 0);\n416\t  };\n417\t\n418\t  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n419\t  function finite(v) {\n420\t    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n421\t  }\n422\t\n423\t  /**\n424\t   * The whole outcome as plain JSON, field by field: the hub checks and trims\n425\t   * it, so new optional fields need no new client. A field that is not JSON\n426\t   * (a cycle, a BigInt) is left out, not the whole outcome.\n427\t   */\n428\t  function outcomeOf(outcome) {\n429\t    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n430\t      warn('the outcome is not a plain object');\n431\t      return null;\n432\t    }\n433\t    var copy = {};\n434\t    for (var key in outcome) {\n435\t      if (!own(outcome, key)) continue;\n436\t      var value = json(outcome[key]);\n437\t      if (value !== undefined) copy[key] = value;\n438\t      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n439\t    }\n440\t    return copy;\n441\t  }\n442\t\n443\t  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n444\t  hub.result = function (outcome) {\n445\t    if (!welcomed || ended || reported) return;\n446\t    var fields = outcomeOf(outcome);\n447\t    if (!fields) return;\n448\t    var given = outcome || {};\n449\t    delete fields.time;\n450\t    delete fields.score;\n451\t    if (finite(given.time)) fields.time = Number(given.time);\n452\t    if (finite(given.score)) fields.score = Number(given.score);\n453\t    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n454\t    reported = true;\n455\t    if (progressTimer) clearTimeout(progressTimer);\n456\t    post('result', fields);\n457\t  };\n458\t\n459\t  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n460\t  hub.finish = function (outcome) {\n461\t    if (!welcomed || ended || reported) return;\n462\t    if (!hub.isHost) return warn('finish is for the host only');\n463\t    var fields = outcomeOf(outcome);\n464\t    if (!fields) return;\n465\t    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n466\t    reported = true;\n467\t    post('finish', fields);\n468\t  };\n469\t\n470\t  function sendProgress() {\n471\t    progressTimer = null;\n472\t    if (!nextProgress || ended || reported) return;\n473\t    lastProgress = now();\n474\t    post('progress', nextProgress);\n475\t    nextProgress = null;\n476\t  }\n477\t\n478\t  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n479\t  hub.progress = function (p) {\n480\t    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n481\t    nextProgress = { score: Number(p.score) };\n482\t    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n483\t    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n484\t    if (wait <= 0) sendProgress();\n485\t    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n486\t  };\n487\t\n488\t  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n489\t  hub.probe = function (fn) {\n490\t    probeFn = typeof fn === 'function' ? fn : null;\n491\t  };\n492\t\n493\t  hub.inspect = function () {\n494\t    if (!probeFn) return null;\n495\t    try {\n496\t      return JSON.parse(JSON.stringify(probeFn()));\n497\t    } catch (e) {\n498\t      return { error: String((e && e.message) || e) };\n499\t    }\n500\t  };\n501\t\n502\t  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n503\t  hub.fail = function (message) {\n504\t    if (!hub.active) return;\n505\t    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n506\t  };\n507\t\n508\t  root.AIHub = hub;\n509\t})(typeof window !== 'undefined' ? window : globalThis);\n510\t</script>\n511\t</head>\n512\t<body>\n513\t<canvas id=\"c\" aria-label=\"Star Arena\"></canvas>\n514\t<script>\n515\t'use strict';\n516\t// Star Arena: the smallest honest shared-world game, the plain form of \"Shared\n517\t// world\" (lib/hub/README.md): the host runs the world. Every copy moves its own\n518\t// player from its own stick, at once, and never waits for the network to do\n519\t// it. The host's copy runs only what is shared, the star and the scores:\n520\t//   me     each other copy → the host, ~15 a second, unreliable: where my player is\n521\t//   s      the host → everyone, ~15 a second, unreliable: every player, its score, the star\n522\t//   claim  a copy → the host, reliable, once a star: my player touched star n\n523\t//   pick   the host → everyone, reliable: player id took star n\n524\t// The host takes each player where it says it is, and a claim scores unless\n525\t// someone else got there first. A last snapshot, reliable, ends the round.\n526\t// The host may be a server, a copy with no player of its own (AIHub.server):\n527\t// it runs the same host code, moves nobody and draws nothing.\n528\t// First to TARGET stars wins.\n529\tconst W = 800, H = 600, R = 18, SPEED = 260, TARGET = 10;\n530\tconst canvas = document.getElementById('c');\n531\tconst ctx = canvas.getContext('2d');\n532\tconst keys = new Set();\n533\tlet pointer = null;\n534\tlet audio = null;\n535\t\n536\taddEventListener('keydown', (e) => {\n537\t  if (e.key === 'Escape') return toggleMenu();\n538\t  if (menu.open) return menuKey(e.key);\n539\t  keys.add(e.key.toLowerCase());\n540\t  gesture();\n541\t});\n542\taddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n543\tcanvas.addEventListener('pointerdown', (e) => { pointer = e; gesture(); });\n544\tcanvas.addEventListener('pointermove', (e) => { if (pointer) pointer = e; });\n545\taddEventListener('pointerup', () => { pointer = null; });\n546\t\n547\tfunction beep(freq) {\n548\t  if (!audio || muted) return;\n549\t  const o = audio.createOscillator(), g = audio.createGain();\n550\t  o.frequency.value = freq; g.gain.value = 0.05;\n551\t  o.connect(g).connect(audio.destination);\n552\t  o.start(); o.stop(audio.currentTime + 0.08);\n553\t}\n554\t\n555\t// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n556\t// Cross 0, Circle 1, Triangle 3, Create 8, Options 9, D-pad 12-15, left stick\n557\t// axes 0 and 1). Buttons count on the frame they go down.\n558\tconst PAD = { cross: 0, circle: 1, triangle: 3, create: 8, options: 9, up: 12, down: 13 };\n559\tlet pad = null, padNow = [], padWas = [];\n560\tfunction readPad() {\n561\t  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n562\t  padWas = padNow;\n563\t  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n564\t  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n565\t  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n566\t  if (menu.open) {\n567\t    if (pressed(PAD.up)) menuKey('ArrowUp');\n568\t    if (pressed(PAD.down)) menuKey('ArrowDown');\n569\t    if (pressed(PAD.cross)) menuKey('Enter');\n570\t    if (pressed(PAD.circle)) toggleMenu();\n571\t  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n572\t}\n573\tconst pressed = (b) => !!padNow[b] && !padWas[b];\n574\t\n575\t// ---- the settings menu: Esc or Options, over the running game. It never\n576\t// pauses anything; while it is open your player simply stands still.\n577\tlet muted = false;\n578\tconst menu = {\n579\t  open: false,\n580\t  at: 0,\n581\t  items: [\n582\t    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n583\t    { label: () => 'Back to the game', act: () => toggleMenu() },\n584\t  ],\n585\t};\n586\tfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\n587\tfunction menuKey(key) {\n588\t  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n589\t  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n590\t  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n591\t}\n592\t\n593\t/** The local stick: keys, the first gamepad, or a held pointer. Still while the menu is open. */\n594\tfunction stick(me) {\n595\t  if (menu.open) return { x: 0, y: 0, sprint: false };\n596\t  let x = 0, y = 0;\n597\t  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n598\t  if (keys.has('arrowright') || keys.has('d')) x += 1;\n599\t  if (keys.has('arrowup') || keys.has('w')) y -= 1;\n600\t  if (keys.has('arrowdown') || keys.has('s')) y += 1;\n601\t  if (pad) {\n602\t    if (Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n603\t    if (Math.abs(pad.axes[1]) > 0.2) y = pad.axes[1];\n604\t    if (padNow[12]) y = -1;\n605\t    if (padNow[13]) y = 1;\n606\t    if (padNow[14]) x = -1;\n607\t    if (padNow[15]) x = 1;\n608\t  }\n609\t  if (pointer && me) {\n610\t    const p = toWorld(pointer);\n611\t    const dx = p.x - me.x, dy = p.y - me.y, d = Math.hypot(dx, dy);\n612\t    if (d > 8) { x = dx / d; y = dy / d; }\n613\t  }\n614\t  const sprint = keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7];\n615\t  const len = Math.hypot(x, y);\n616\t  return len > 1 ? { x: x / len, y: y / len, sprint } : { x, y, sprint };\n617\t}\n618\t\n619\tfunction toWorld(e) {\n620\t  const r = canvas.getBoundingClientRect(), s = Math.min(r.width / W, r.height / H);\n621\t  return { x: (e.clientX - r.left - (r.width - W * s) / 2) / s, y: (e.clientY - r.top - (r.height - H * s) / 2) / s };\n622\t}\n623\t\n624\t// ---- state shared by both modes\n625\tconst game = {\n626\t  phase: 'title',            // title | waiting | playing | over\n627\t  players: [],               // {id, name, color, x, y, score, gone}, drawn at x, y\n628\t  star: { x: W / 2, y: H / 2, n: 0 },   // n numbers the stars, so a claim names the one it touched\n629\t  rng: Math.random,\n630\t  message: '',\n631\t  standings: null,\n632\t};\n633\tlet felt = { x: 0, y: 0, sprint: false };   // the local stick as last read\n634\t\n635\tfunction place(players) {\n636\t  players.forEach((p, i) => {\n637\t    const a = (i / Math.max(players.length, 1)) * Math.PI * 2;\n638\t    p.tx = p.x = W / 2 + Math.cos(a) * 200; p.ty = p.y = H / 2 + Math.sin(a) * 180;\n639\t  });\n640\t}\n641\tfunction newStar() {\n642\t  game.star = { x: 40 + game.rng() * (W - 80), y: 40 + game.rng() * (H - 80), n: game.star.n + 1 };\n643\t}\n644\t\n645\t/** Your own player, from your own stick. Every copy moves its own, every frame, host or not. */\n646\tfunction move(p, s, dt) {\n647\t  const speed = SPEED * (s.sprint ? 1.5 : 1);\n648\t  p.x = Math.max(R, Math.min(W - R, p.x + s.x * speed * dt));\n649\t  p.y = Math.max(R, Math.min(H - R, p.y + s.y * speed * dt));\n650\t}\n651\tconst touching = (p) => Math.hypot(p.x - game.star.x, p.y - game.star.y) < R + 12;\n652\t\n653\t// ---- solo: the game as it plays on its own\n654\tfunction solo() {\n655\t  game.players = [{ id: 0, name: 'You', color: '#f5b700', x: W / 2, y: H / 2, score: 0 }];\n656\t  game.phase = 'title';\n657\t  game.message = 'Star Arena — press any key or tap to play';\n658\t}\n659\tlet soloEnds = 0;\n660\t\n661\t// ---- hub mode. Every other player also has tx, ty: where it last said it is\n662\t// (and on the host, at: when). It is drawn easing toward there; your own player\n663\t// is drawn where you put it.\n664\tlet hub = null;\n665\tlet lastSent = 0;\n666\tlet lastSnap = -Infinity;    // the newest snapshot taken, by its AIHub.time()\n667\tlet claimed = -1;            // the star this copy claimed last: one claim a star\n668\t\n669\tasync function connect() {\n670\t  const info = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n671\t  if (!info) return solo();\n672\t  hub = info;\n673\t  game.rng = AIHub.rng('stars');\n674\t  game.players = info.players.map((p) => ({ ...p, x: 0, y: 0, score: 0, gone: false, at: -Infinity }));\n675\t  place(game.players);\n676\t  newStar();                 // the first star comes from the seed: the same on every copy\n677\t  // The hub's card collects everyone's ready: ready up as soon as the arena is built.\n678\t  game.phase = 'waiting';\n679\t  game.message = 'Get ready…';\n680\t  AIHub.ready();\n681\t  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n682\t  AIHub.on('message', (data, from) => {\n683\t    if (hub.isHost && data.t === 'me') heard(from, data);\n684\t    if (hub.isHost && data.t === 'claim') take(from, data.n);\n685\t    if (from === hub.host && data.t === 's') applySnapshot(data);\n686\t    if (from === hub.host && data.t === 'pick' && data.id !== hub.me) beep(330);   // your own cheered at the claim\n687\t  });\n688\t  AIHub.on('leave', ({ id }) => {\n689\t    const p = game.players.find((q) => q.id === id);\n690\t    if (p) p.gone = true;\n691\t    if (hub.isHost && game.phase === 'playing' && game.players.filter((q) => !q.gone).length < 2) finish();\n692\t  });\n693\t  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n694\t  AIHub.on('end', ({ reason, standings }) => {\n695\t    game.phase = 'over';\n696\t    game.standings = standings;\n697\t    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n698\t  });\n699\t}\n700\tconst inside = (v, max) => Math.max(R, Math.min(max - R, Number(v) || 0));\n701\t\n702\t/** Host: a player says where it is, and there it is, unless an older report arrived late. */\n703\tfunction heard(id, m) {\n704\t  const p = game.players.find((q) => q.id === id);\n705\t  if (!p || !(m.at > p.at)) return;\n706\t  p.at = m.at; p.tx = inside(m.x, W); p.ty = inside(m.y, H);\n707\t}\n708\t\n709\t/** Host: player id touched star n. It scores, unless someone else got there first. */\n710\tfunction take(id, n) {\n711\t  const p = game.players.find((q) => q.id === id);\n712\t  if (game.phase !== 'playing' || !p || p.gone || n !== game.star.n) return;\n713\t  p.score++;\n714\t  newStar();\n715\t  beep(id === hub.me ? 660 : 330);\n716\t  AIHub.send({ t: 'pick', id, n });\n717\t  if (p.score >= TARGET) finish();\n718\t}\n719\t\n720\t/** Host: one snapshot for everyone: every player still here with its score, and the star. */\n721\tfunction snapshot() {\n722\t  const spot = (p) => (p.id === hub.me ? [p.x, p.y] : [p.tx, p.ty]);   // the others: where they said\n723\t  return {\n724\t    t: 's',\n725\t    at: Math.round(AIHub.time()),\n726\t    p: game.players.filter((p) => !p.gone).map((p) => [p.id, ...spot(p).map(Math.round), p.score]),\n727\t    s: [Math.round(game.star.x), Math.round(game.star.y), game.star.n],\n728\t  };\n729\t}\n730\t\n731\t/** Not the host: take the scores, the star and the other players from the snapshot, never your own player. */\n732\tfunction applySnapshot(s) {\n733\t  if (s.at < lastSnap) return;   // unreliable: an older one that arrived late\n734\t  lastSnap = s.at;\n735\t  for (const [id, x, y, score] of s.p) {\n736\t    const p = game.players.find((q) => q.id === id);\n737\t    if (!p) continue;\n738\t    p.score = score;\n739\t    if (id !== hub.me) { p.tx = x; p.ty = y; }\n740\t  }\n741\t  game.star = { x: s.s[0], y: s.s[1], n: s.s[2] };\n742\t  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n743\t}\n744\t\n745\t/** Host: standings by score, ties together, best first. A last snapshot, reliable, ends every copy on the same scores. */\n746\tfunction finish() {\n747\t  if (game.phase === 'over') return;\n748\t  AIHub.send({ ...snapshot(), over: 1 });\n749\t  const live = game.players.filter((p) => !p.gone).sort((a, b) => b.score - a.score);\n750\t  const standings = [];\n751\t  for (const p of live) {\n752\t    const last = standings[standings.length - 1];\n753\t    if (last && last.score === p.score) last.ids.push(p.id);\n754\t    else standings.push({ score: p.score, ids: [p.id] });\n755\t  }\n756\t  const scores = Object.fromEntries(game.players.map((p) => [p.id, p.score]));\n757\t  AIHub.finish({ standings: standings.map((g) => g.ids), scores });\n758\t  game.phase = 'over';\n759\t  game.message = 'Round over';\n760\t}\n761\t\n762\tfunction unlockAudio() {\n763\t  if (!audio) {\n764\t    try { audio = new AudioContext(); } catch { audio = null; }\n765\t  }\n766\t  audio?.resume?.().catch(() => {});\n767\t}\n768\t\n769\tfunction gesture() {\n770\t  unlockAudio();\n771\t  if (!hub && (game.phase === 'title' || game.phase === 'over')) {\n772\t    solo();\n773\t    game.phase = 'playing';\n774\t    soloEnds = performance.now() + 60_000;\n775\t  }\n776\t}\n777\t\n778\t// ---- the loop: advance by elapsed time, never pause\n779\tlet last = performance.now();\n780\tfunction frame(now) {\n781\t  const dt = Math.min((now - last) / 1000, 0.25);\n782\t  last = now;\n783\t  readPad();\n784\t  const me = game.players.find((p) => p.id === (hub ? hub.me : 0));\n785\t  felt = stick(me);\n786\t  if (game.phase === 'playing' && (!hub || AIHub.time() >= 0)) {\n787\t    if (me) move(me, felt, dt);   // now, on every copy: your controls never wait for the network\n788\t    if (hub) play(now, dt, me);\n789\t    else {\n790\t      if (touching(me)) { me.score++; newStar(); beep(660); }\n791\t      if (now > soloEnds) { game.phase = 'over'; game.message = `Time! ${me.score} stars — press to play again`; }\n792\t    }\n793\t  }\n794\t  if (!hub?.server) draw(now);   // a server runs the world and needs no picture of it\n795\t  requestAnimationFrame(frame);\n796\t}\n797\t\n798\t/** A session frame, after your own move: the star, what this copy sends, and the others eased toward where they are. */\n799\tfunction play(now, dt, me) {\n800\t  if (me && touching(me)) {\n801\t    if (hub.isHost) take(hub.me, game.star.n);\n802\t    else if (claimed !== game.star.n) {\n803\t      // Predict the contact: claim the star once, hide it and cheer now. The host decides the point.\n804\t      claimed = game.star.n;\n805\t      AIHub.send({ t: 'claim', n: claimed }, { to: hub.host });\n806\t      beep(660);\n807\t    }\n808\t  }\n809\t  if (game.phase === 'playing' && now - lastSent > 66) {\n810\t    lastSent = now;\n811\t    if (hub.isHost) AIHub.send(snapshot(), { reliable: false });\n812\t    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()), x: Math.round(me.x), y: Math.round(me.y) }, { to: hub.host, reliable: false });\n813\t  }\n814\t  const k = 1 - Math.pow(0.001, dt);\n815\t  for (const p of game.players) if (p !== me) { p.x += (p.tx - p.x) * k; p.y += (p.ty - p.y) * k; }\n816\t}\n817\t\n818\tfunction draw(now) {\n819\t  const r = canvas.getBoundingClientRect();\n820\t  const dpr = devicePixelRatio || 1;\n821\t  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n822\t    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n823\t  }\n824\t  const s = Math.min(canvas.width / W, canvas.height / H);\n825\t  ctx.setTransform(1, 0, 0, 1, 0, 0);\n826\t  ctx.fillStyle = '#120e22'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n827\t  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n828\t  ctx.fillStyle = '#1b1530'; ctx.fillRect(0, 0, W, H);\n829\t\n830\t  if (game.star.n !== claimed) {   // a star you claimed is gone here until the host's next one arrives\n831\t    ctx.fillStyle = '#ffd34d';\n832\t    ctx.beginPath(); ctx.arc(game.star.x, game.star.y, 10 + Math.sin(now / 150) * 2, 0, Math.PI * 2); ctx.fill();\n833\t  }\n834\t\n835\t  ctx.textAlign = 'center';\n836\t  for (const p of game.players) {\n837\t    if (p.gone) continue;\n838\t    ctx.fillStyle = p.color;\n839\t    ctx.beginPath(); ctx.arc(p.x, p.y, R, 0, Math.PI * 2); ctx.fill();\n840\t    ctx.fillStyle = '#f3eef7'; ctx.font = '14px system-ui';\n841\t    ctx.fillText(`${p.name} ${p.score}`, p.x, p.y - R - 8);\n842\t  }\n843\t\n844\t  ctx.font = '22px system-ui';\n845\t  ctx.fillStyle = '#f3eef7';\n846\t  if (hub && game.phase === 'playing' && AIHub.time() < 0) {\n847\t    ctx.font = 'bold 96px system-ui';\n848\t    ctx.fillText(String(Math.ceil(-AIHub.time() / 1000)), W / 2, H / 2 + 32);\n849\t  } else if (game.phase !== 'playing') {\n850\t    ctx.fillStyle = 'rgba(0,0,0,.55)'; ctx.fillRect(0, H / 2 - 120, W, 240);\n851\t    ctx.fillStyle = '#f3eef7';\n852\t    ctx.fillText(game.message, W / 2, H / 2 - 70);\n853\t    const rows = game.standings\n854\t      ? game.standings.flatMap((ids, place) => ids.map((id) => [place + 1, game.players.find((p) => p.id === id)]))\n855\t      : game.players.map((p) => [null, p]);\n856\t    ctx.font = '18px system-ui';\n857\t    rows.slice(0, 4).forEach(([place, p], i) => {\n858\t      if (!p) return;\n859\t      ctx.fillStyle = p.color;\n860\t      ctx.fillText(`${place ? place + '. ' : ''}${p.name}${hub && p.id === hub.me ? ' (you)' : ''} — ${p.score}`, W / 2, H / 2 - 30 + i * 28);\n861\t    });\n862\t  }\n863\t  if (menu.open) drawMenu();\n864\t}\n865\t\n866\tfunction drawMenu() {\n867\t  ctx.fillStyle = 'rgba(10,8,20,.82)'; ctx.fillRect(W / 2 - 170, 150, 340, 70 + menu.items.length * 40);\n868\t  ctx.textAlign = 'center';\n869\t  ctx.fillStyle = '#f3eef7'; ctx.font = 'bold 22px system-ui';\n870\t  ctx.fillText('Settings', W / 2, 186);\n871\t  ctx.font = '18px system-ui';\n872\t  menu.items.forEach((item, i) => {\n873\t    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#f3eef7';\n874\t    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 226 + i * 40);\n875\t  });\n876\t}\n877\t\n878\tconnect();\n879\trequestAnimationFrame(frame);\n880\t</script>\n881\t</body>\n882\t</html>\n883\t"}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"6a1dedfb-9cc4-4d50-a725-4578bb6da994","timestamp":"2026-11-05T04:24:24.126Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/hub/lib/hub/examples/arena.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Star Arena — AI Hub session example (shared world)</title>\n<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n<meta name=\"theme-color\" content=\"#1b1530\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"2\">\n<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #1b1530; color: #f3eef7; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n    var shown = function () {\n      return fullscreenOn ? root.document.documentElement || null : null;\n    };\n    try {\n      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n    } catch (e) {}\n  }\n\n  /**\n   * No hub after all: play on, with Math.random the page's own again. The\n   * empty storage stays: the game has read it already, and what it writes\n   * must never land on the player's real saves.\n   */\n  function standAlone() {\n    hub.active = false;\n    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n    hub.seeded = false;\n  }\n\n  var origin = '*';\n  var welcomed = false;\n  var ended = false;\n  var connecting = null;\n  var goAt = null;\n  var sentReady = false;\n  var reported = false;\n  var handlers = {};\n  var pending = {};\n  var tokens = limits.burst;\n  var refilled = now();\n  var probeFn = null;\n  var lastProgress = -Infinity;\n  var nextProgress = null;\n  var progressTimer = null;\n\n  function now() {\n    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n  }\n\n  function warn(text) {\n    if (root.console) root.console.warn('[AIHub] ' + text);\n  }\n\n  function own(o, k) {\n    return Object.prototype.hasOwnProperty.call(o, k);\n  }\n\n  /** This client's own fields, which no welcome may overwrite. */\n  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n\n  /** A plain JSON copy, or undefined when it is not JSON. */\n  function json(value) {\n    try {\n      var text = JSON.stringify(value);\n      return text === undefined ? undefined : JSON.parse(text);\n    } catch (e) {\n      return undefined;\n    }\n  }\n\n  function post(type, fields) {\n    var msg = { aihub: 1, type: type };\n    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n    try {\n      root.parent.postMessage(msg, origin);\n    } catch (e) {\n      warn('could not reach the hub: ' + e.message);\n    }\n  }\n\n  function emit(type, args) {\n    var list = handlers[type];\n    if (!list || !list.length || pending[type]) {\n      (pending[type] = pending[type] || []).push(args);\n      return;\n    }\n    for (var i = 0; i < list.length; i++) {\n      try {\n        list[i].apply(null, args);\n      } catch (e) {\n        setTimeout(function () {\n          throw e;\n        });\n      }\n    }\n  }\n\n  function onMessage(event) {\n    if (event.source !== root.parent) return;\n    var m = event.data;\n    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n    if (m.type === 'welcome') {\n      if (welcomed) return;\n      welcomed = true;\n      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n      for (var key in m) {\n        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n        hub[key] = m[key];\n      }\n      hub.players = (m.players || []).slice();\n      hub.seed = m.seed >>> 0;\n      hub.isHost = m.me === m.host;\n      hub.splash = m.splash === true;\n      if (m.limits) {\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n        tokens = limits.burst;\n      }\n      if (connecting) connecting.resolve(info());\n      return;\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n</script>\n</head>\n<body>\n<canvas id=\"c\" aria-label=\"Star Arena\"></canvas>\n<script>\n'use strict';\n// Star Arena: the smallest honest shared-world game, the plain form of \"Shared\n// world\" (lib/hub/README.md): the host runs the world. Every copy moves its own\n// player from its own stick, at once, and never waits for the network to do\n// it. The host's copy runs only what is shared, the star and the scores:\n//   me     each other copy → the host, ~15 a second, unreliable: where my player is\n//   s      the host → everyone, ~15 a second, unreliable: every player, its score, the star\n//   claim  a copy → the host, reliable, once a star: my player touched star n\n//   pick   the host → everyone, reliable: player id took star n\n// The host takes each player where it says it is, and a claim scores unless\n// someone else got there first. A last snapshot, reliable, ends the round.\n// The host may be a server, a copy with no player of its own (AIHub.server):\n// it runs the same host code, moves nobody and draws nothing.\n// First to TARGET stars wins.\nconst W = 800, H = 600, R = 18, SPEED = 260, TARGET = 10;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst keys = new Set();\nlet pointer = null;\nlet audio = null;\n\naddEventListener('keydown', (e) => {\n  if (e.key === 'Escape') return toggleMenu();\n  if (menu.open) return menuKey(e.key);\n  keys.add(e.key.toLowerCase());\n  gesture();\n});\naddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\ncanvas.addEventListener('pointerdown', (e) => { pointer = e; gesture(); });\ncanvas.addEventListener('pointermove', (e) => { if (pointer) pointer = e; });\naddEventListener('pointerup', () => { pointer = null; });\n\nfunction beep(freq) {\n  if (!audio || muted) return;\n  const o = audio.createOscillator(), g = audio.createGain();\n  o.frequency.value = freq; g.gain.value = 0.05;\n  o.connect(g).connect(audio.destination);\n  o.start(); o.stop(audio.currentTime + 0.08);\n}\n\n// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n// Cross 0, Circle 1, Triangle 3, Create 8, Options 9, D-pad 12-15, left stick\n// axes 0 and 1). Buttons count on the frame they go down.\nconst PAD = { cross: 0, circle: 1, triangle: 3, create: 8, options: 9, up: 12, down: 13 };\nlet pad = null, padNow = [], padWas = [];\nfunction readPad() {\n  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n  padWas = padNow;\n  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n  if (menu.open) {\n    if (pressed(PAD.up)) menuKey('ArrowUp');\n    if (pressed(PAD.down)) menuKey('ArrowDown');\n    if (pressed(PAD.cross)) menuKey('Enter');\n    if (pressed(PAD.circle)) toggleMenu();\n  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n}\nconst pressed = (b) => !!padNow[b] && !padWas[b];\n\n// ---- the settings menu: Esc or Options, over the running game. It never\n// pauses anything; while it is open your player simply stands still.\nlet muted = false;\nconst menu = {\n  open: false,\n  at: 0,\n  items: [\n    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n    { label: () => 'Back to the game', act: () => toggleMenu() },\n  ],\n};\nfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\nfunction menuKey(key) {\n  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n}\n\n/** The local stick: keys, the first gamepad, or a held pointer. Still while the menu is open. */\nfunction stick(me) {\n  if (menu.open) return { x: 0, y: 0, sprint: false };\n  let x = 0, y = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (keys.has('arrowup') || keys.has('w')) y -= 1;\n  if (keys.has('arrowdown') || keys.has('s')) y += 1;\n  if (pad) {\n    if (Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n    if (Math.abs(pad.axes[1]) > 0.2) y = pad.axes[1];\n    if (padNow[12]) y = -1;\n    if (padNow[13]) y = 1;\n    if (padNow[14]) x = -1;\n    if (padNow[15]) x = 1;\n  }\n  if (pointer && me) {\n    const p = toWorld(pointer);\n    const dx = p.x - me.x, dy = p.y - me.y, d = Math.hypot(dx, dy);\n    if (d > 8) { x = dx / d; y = dy / d; }\n  }\n  const sprint = keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7];\n  const len = Math.hypot(x, y);\n  return len > 1 ? { x: x / len, y: y / len, sprint } : { x, y, sprint };\n}\n\nfunction toWorld(e) {\n  const r = canvas.getBoundingClientRect(), s = Math.min(r.width / W, r.height / H);\n  return { x: (e.clientX - r.left - (r.width - W * s) / 2) / s, y: (e.clientY - r.top - (r.height - H * s) / 2) / s };\n}\n\n// ---- state shared by both modes\nconst game = {\n  phase: 'title',            // title | waiting | playing | over\n  players: [],               // {id, name, color, x, y, score, gone}, drawn at x, y\n  star: { x: W / 2, y: H / 2, n: 0 },   // n numbers the stars, so a claim names the one it touched\n  rng: Math.random,\n  message: '',\n  standings: null,\n};\nlet felt = { x: 0, y: 0, sprint: false };   // the local stick as last read\n\nfunction place(players) {\n  players.forEach((p, i) => {\n    const a = (i / Math.max(players.length, 1)) * Math.PI * 2;\n    p.tx = p.x = W / 2 + Math.cos(a) * 200; p.ty = p.y = H / 2 + Math.sin(a) * 180;\n  });\n}\nfunction newStar() {\n  game.star = { x: 40 + game.rng() * (W - 80), y: 40 + game.rng() * (H - 80), n: game.star.n + 1 };\n}\n\n/** Your own player, from your own stick. Every copy moves its own, every frame, host or not. */\nfunction move(p, s, dt) {\n  const speed = SPEED * (s.sprint ? 1.5 : 1);\n  p.x = Math.max(R, Math.min(W - R, p.x + s.x * speed * dt));\n  p.y = Math.max(R, Math.min(H - R, p.y + s.y * speed * dt));\n}\nconst touching = (p) => Math.hypot(p.x - game.star.x, p.y - game.star.y) < R + 12;\n\n// ---- solo: the game as it plays on its own\nfunction solo() {\n  game.players = [{ id: 0, name: 'You', color: '#f5b700', x: W / 2, y: H / 2, score: 0 }];\n  game.phase = 'title';\n  game.message = 'Star Arena — press any key or tap to play';\n}\nlet soloEnds = 0;\n\n// ---- hub mode. Every other player also has tx, ty: where it last said it is\n// (and on the host, at: when). It is drawn easing toward there; your own player\n// is drawn where you put it.\nlet hub = null;\nlet lastSent = 0;\nlet lastSnap = -Infinity;    // the newest snapshot taken, by its AIHub.time()\nlet claimed = -1;            // the star this copy claimed last: one claim a star\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n  if (!info) return solo();\n  hub = info;\n  game.rng = AIHub.rng('stars');\n  game.players = info.players.map((p) => ({ ...p, x: 0, y: 0, score: 0, gone: false, at: -Infinity }));\n  place(game.players);\n  newStar();                 // the first star comes from the seed: the same on every copy\n  // The hub's card collects everyone's ready: ready up as soon as the arena is built.\n  game.phase = 'waiting';\n  game.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    if (hub.isHost && data.t === 'me') heard(from, data);\n    if (hub.isHost && data.t === 'claim') take(from, data.n);\n    if (from === hub.host && data.t === 's') applySnapshot(data);\n    if (from === hub.host && data.t === 'pick' && data.id !== hub.me) beep(330);   // your own cheered at the claim\n  });\n  AIHub.on('leave', ({ id }) => {\n    const p = game.players.find((q) => q.id === id);\n    if (p) p.gone = true;\n    if (hub.isHost && game.phase === 'playing' && game.players.filter((q) => !q.gone).length < 2) finish();\n  });\n  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n  AIHub.on('end', ({ reason, standings }) => {\n    game.phase = 'over';\n    game.standings = standings;\n    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n  });\n}\nconst inside = (v, max) => Math.max(R, Math.min(max - R, Number(v) || 0));\n\n/** Host: a player says where it is, and there it is, unless an older report arrived late. */\nfunction heard(id, m) {\n  const p = game.players.find((q) => q.id === id);\n  if (!p || !(m.at > p.at)) return;\n  p.at = m.at; p.tx = inside(m.x, W); p.ty = inside(m.y, H);\n}\n\n/** Host: player id touched star n. It scores, unless someone else got there first. */\nfunction take(id, n) {\n  const p = game.players.find((q) => q.id === id);\n  if (game.phase !== 'playing' || !p || p.gone || n !== game.star.n) return;\n  p.score++;\n  newStar();\n  beep(id === hub.me ? 660 : 330);\n  AIHub.send({ t: 'pick', id, n });\n  if (p.score >= TARGET) finish();\n}\n\n/** Host: one snapshot for everyone: every player still here with its score, and the star. */\nfunction snapshot() {\n  const spot = (p) => (p.id === hub.me ? [p.x, p.y] : [p.tx, p.ty]);   // the others: where they said\n  return {\n    t: 's',\n    at: Math.round(AIHub.time()),\n    p: game.players.filter((p) => !p.gone).map((p) => [p.id, ...spot(p).map(Math.round), p.score]),\n    s: [Math.round(game.star.x), Math.round(game.star.y), game.star.n],\n  };\n}\n\n/** Not the host: take the scores, the star and the other players from the snapshot, never your own player. */\nfunction applySnapshot(s) {\n  if (s.at < lastSnap) return;   // unreliable: an older one that arrived late\n  lastSnap = s.at;\n  for (const [id, x, y, score] of s.p) {\n    const p = game.players.find((q) => q.id === id);\n    if (!p) continue;\n    p.score = score;\n    if (id !== hub.me) { p.tx = x; p.ty = y; }\n  }\n  game.star = { x: s.s[0], y: s.s[1], n: s.s[2] };\n  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n}\n\n/** Host: standings by score, ties together, best first. A last snapshot, reliable, ends every copy on the same scores. */\nfunction finish() {\n  if (game.phase === 'over') return;\n  AIHub.send({ ...snapshot(), over: 1 });\n  const live = game.players.filter((p) => !p.gone).sort((a, b) => b.score - a.score);\n  const standings = [];\n  for (const p of live) {\n    const last = standings[standings.length - 1];\n    if (last && last.score === p.score) last.ids.push(p.id);\n    else standings.push({ score: p.score, ids: [p.id] });\n  }\n  const scores = Object.fromEntries(game.players.map((p) => [p.id, p.score]));\n  AIHub.finish({ standings: standings.map((g) => g.ids), scores });\n  game.phase = 'over';\n  game.message = 'Round over';\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (game.phase === 'title' || game.phase === 'over')) {\n    solo();\n    game.phase = 'playing';\n    soloEnds = performance.now() + 60_000;\n  }\n}\n\n// ---- the loop: advance by elapsed time, never pause\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  const me = game.players.find((p) => p.id === (hub ? hub.me : 0));\n  felt = stick(me);\n  if (game.phase === 'playing' && (!hub || AIHub.time() >= 0)) {\n    if (me) move(me, felt, dt);   // now, on every copy: your controls never wait for the network\n    if (hub) play(now, dt, me);\n    else {\n      if (touching(me)) { me.score++; newStar(); beep(660); }\n      if (now > soloEnds) { game.phase = 'over'; game.message = `Time! ${me.score} stars — press to play again`; }\n    }\n  }\n  if (!hub?.server) draw(now);   // a server runs the world and needs no picture of it\n  requestAnimationFrame(frame);\n}\n\n/** A session frame, after your own move: the star, what this copy sends, and the others eased toward where they are. */\nfunction play(now, dt, me) {\n  if (me && touching(me)) {\n    if (hub.isHost) take(hub.me, game.star.n);\n    else if (claimed !== game.star.n) {\n      // Predict the contact: claim the star once, hide it and cheer now. The host decides the point.\n      claimed = game.star.n;\n      AIHub.send({ t: 'claim', n: claimed }, { to: hub.host });\n      beep(660);\n    }\n  }\n  if (game.phase === 'playing' && now - lastSent > 66) {\n    lastSent = now;\n    if (hub.isHost) AIHub.send(snapshot(), { reliable: false });\n    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()), x: Math.round(me.x), y: Math.round(me.y) }, { to: hub.host, reliable: false });\n  }\n  const k = 1 - Math.pow(0.001, dt);\n  for (const p of game.players) if (p !== me) { p.x += (p.tx - p.x) * k; p.y += (p.ty - p.y) * k; }\n}\n\nfunction draw(now) {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#120e22'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#1b1530'; ctx.fillRect(0, 0, W, H);\n\n  if (game.star.n !== claimed) {   // a star you claimed is gone here until the host's next one arrives\n    ctx.fillStyle = '#ffd34d';\n    ctx.beginPath(); ctx.arc(game.star.x, game.star.y, 10 + Math.sin(now / 150) * 2, 0, Math.PI * 2); ctx.fill();\n  }\n\n  ctx.textAlign = 'center';\n  for (const p of game.players) {\n    if (p.gone) continue;\n    ctx.fillStyle = p.color;\n    ctx.beginPath(); ctx.arc(p.x, p.y, R, 0, Math.PI * 2); ctx.fill();\n    ctx.fillStyle = '#f3eef7'; ctx.font = '14px system-ui';\n    ctx.fillText(`${p.name} ${p.score}`, p.x, p.y - R - 8);\n  }\n\n  ctx.font = '22px system-ui';\n  ctx.fillStyle = '#f3eef7';\n  if (hub && game.phase === 'playing' && AIHub.time() < 0) {\n    ctx.font = 'bold 96px system-ui';\n    ctx.fillText(String(Math.ceil(-AIHub.time() / 1000)), W / 2, H / 2 + 32);\n  } else if (game.phase !== 'playing') {\n    ctx.fillStyle = 'rgba(0,0,0,.55)'; ctx.fillRect(0, H / 2 - 120, W, 240);\n    ctx.fillStyle = '#f3eef7';\n    ctx.fillText(game.message, W / 2, H / 2 - 70);\n    const rows = game.standings\n      ? game.standings.flatMap((ids, place) => ids.map((id) => [place + 1, game.players.find((p) => p.id === id)]))\n      : game.players.map((p) => [null, p]);\n    ctx.font = '18px system-ui';\n    rows.slice(0, 4).forEach(([place, p], i) => {\n      if (!p) return;\n      ctx.fillStyle = p.color;\n      ctx.fillText(`${place ? place + '. ' : ''}${p.name}${hub && p.id === hub.me ? ' (you)' : ''} — ${p.score}`, W / 2, H / 2 - 30 + i * 28);\n    });\n  }\n  if (menu.open) drawMenu();\n}\n\nfunction drawMenu() {\n  ctx.fillStyle = 'rgba(10,8,20,.82)'; ctx.fillRect(W / 2 - 170, 150, 340, 70 + menu.items.length * 40);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#f3eef7'; ctx.font = 'bold 22px system-ui';\n  ctx.fillText('Settings', W / 2, 186);\n  ctx.font = '18px system-ui';\n  menu.items.forEach((item, i) => {\n    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#f3eef7';\n    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 226 + i * 40);\n  });\n}\n\nconnect();\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n","numLines":883,"startLine":1,"totalLines":883}},"tool_result_meta":[{"id":"toolu_013mP4149Qt7QaGztrKBraqU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
