{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AsTqtY2pw1DGUi4PEsv3pv","type":"tool_result","content":"1\t<!doctype html>\n2\t<html lang=\"en\">\n3\t<head>\n4\t<meta charset=\"utf-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6\t<title>Starfall — AI Hub session example (parallel)</title>\n7\t<meta name=\"description\" content=\"A minimal parallel game for the AI Hub Session Protocol: everyone plays their own one-minute run of the same falling stars, and the hub keeps the score.\">\n8\t<meta name=\"theme-color\" content=\"#15103a\">\n9\t<meta name=\"hub:type\" content=\"Tech demo\">\n10\t<meta name=\"hub:players\" content=\"1\">\n11\t<meta name=\"hub:session\" content=\"1\">\n12\t<meta name=\"hub:session-players\" content=\"1-4\">\n13\t<meta name=\"hub:session-mode\" content=\"parallel\">\n14\t<meta name=\"hub:session-minutes\" content=\"1\">\n15\t<meta name=\"hub:session-goal\" content=\"Most points in one minute: catch stars, dodge rocks\">\n16\t<meta name=\"hub:session-howto\" content=\"Move: ← →, A D or a stick · dash: Space or Cross · or drag a finger\">\n17\t<style>\n18\t  html, body { margin: 0; height: 100%; background: #15103a; color: #eef3fb; font: 16px system-ui, sans-serif; overflow: hidden; }\n19\t  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n20\t</style>\n21\t<script>\n22\t/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n23\t(function (root) {\n24\t  'use strict';\n25\t  if (root.AIHub) return;\n26\t\n27\t  var VERSION = '1.4.0';\n28\t  var HELLO_EVERY_MS = 500;\n29\t  var HELLO_TIMEOUT_MS = 10000;\n30\t  var PROGRESS_EVERY_MS = 1000;\n31\t  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n32\t  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n33\t\n34\t  var framed = false;\n35\t  try {\n36\t    framed = root.parent && root.parent !== root;\n37\t  } catch (e) {\n38\t    framed = true;\n39\t  }\n40\t  var search = String(root.location && root.location.search);\n41\t  var flagged = /[?&]aihub=/.test(search);\n42\t  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n43\t\n44\t  var hub = {\n45\t    version: VERSION,\n46\t    protocol: 1,\n47\t    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n48\t    active: !!(flagged && framed),\n49\t    me: null,\n50\t    host: null,\n51\t    isHost: false,\n52\t    players: [],\n53\t    mode: null,\n54\t    seed: 0,\n55\t    limitMs: 0,\n56\t    round: 0,\n57\t    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n58\t    splash: false,\n59\t    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n60\t    seeded: false,\n61\t  };\n62\t\n63\t  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n64\t  function memoryStorage() {\n65\t    var data = Object.create(null);\n66\t    var api = {\n67\t      getItem: function (k) {\n68\t        k = String(k);\n69\t        return k in data ? data[k] : null;\n70\t      },\n71\t      setItem: function (k, v) {\n72\t        data[String(k)] = String(v);\n73\t      },\n74\t      removeItem: function (k) {\n75\t        delete data[String(k)];\n76\t      },\n77\t      clear: function () {\n78\t        for (var k in data) delete data[k];\n79\t      },\n80\t      key: function (i) {\n81\t        var keys = Object.keys(data);\n82\t        return i >= 0 && i < keys.length ? keys[i] : null;\n83\t      },\n84\t    };\n85\t    if (typeof Proxy !== 'function') return api;\n86\t    return new Proxy(api, {\n87\t      get: function (t, k) {\n88\t        if (k === 'length') return Object.keys(data).length;\n89\t        if (typeof k === 'symbol' || k in t) return t[k];\n90\t        return k in data ? data[k] : undefined;\n91\t      },\n92\t      set: function (t, k, v) {\n93\t        if (typeof k !== 'symbol') data[k] = String(v);\n94\t        return true;\n95\t      },\n96\t      has: function (t, k) {\n97\t        return k in data || k in t;\n98\t      },\n99\t      deleteProperty: function (t, k) {\n100\t        delete data[k];\n101\t        return true;\n102\t      },\n103\t      ownKeys: function () {\n104\t        return Object.keys(data);\n105\t      },\n106\t      getOwnPropertyDescriptor: function (t, k) {\n107\t        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n108\t      },\n109\t    });\n110\t  }\n111\t\n112\t  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n113\t  function generator(a) {\n114\t    return function () {\n115\t      a = (a + 0x6d2b79f5) >>> 0;\n116\t      var t = a;\n117\t      t = Math.imul(t ^ (t >>> 15), t | 1);\n118\t      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n119\t      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n120\t    };\n121\t  }\n122\t\n123\t  // A fair start: in a session the game gets an empty storage of its own, so\n124\t  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n125\t  // and nothing the round saves touches the player's own saves.\n126\t  if (hub.active) {\n127\t    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n128\t      try {\n129\t        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n130\t      } catch (e) {\n131\t        warn('could not give the game a fresh ' + stores[s]);\n132\t      }\n133\t    }\n134\t  }\n135\t\n136\t  // Side by side: before any of the game's own scripts run, Math.random becomes\n137\t  // a generator seeded by the hub, so every copy builds the same start.\n138\t  var realRandom = Math.random;\n139\t  var seededRandom = null;\n140\t  if (hub.active && seedArg) {\n141\t    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n142\t    hub.seeded = true;\n143\t  }\n144\t\n145\t  // In a session the hub owns fullscreen: a game that asks for it gets the\n146\t  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n147\t  // hub says when its page goes in and out, so the game's own toggle and its\n148\t  // fullscreenchange listeners work as they always did.\n149\t  var fullscreenOn = false;\n150\t  if (hub.active && root.Element && root.document) {\n151\t    var asks = function (on) {\n152\t      return function () {\n153\t        post('fullscreen', { on: on });\n154\t        return Promise.resolve();\n155\t      };\n156\t    };\n157\t    var proto = root.Element.prototype;\n158\t    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n159\t    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n160\t    var shown = function () {\n161\t      return fullscreenOn ? root.document.documentElement || null : null;\n162\t    };\n163\t    try {\n164\t      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n165\t      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n166\t    } catch (e) {}\n167\t  }\n168\t\n169\t  /**\n170\t   * No hub after all: play on, with Math.random the page's own again. The\n171\t   * empty storage stays: the game has read it already, and what it writes\n172\t   * must never land on the player's real saves.\n173\t   */\n174\t  function standAlone() {\n175\t    hub.active = false;\n176\t    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n177\t    hub.seeded = false;\n178\t  }\n179\t\n180\t  var origin = '*';\n181\t  var welcomed = false;\n182\t  var ended = false;\n183\t  var connecting = null;\n184\t  var goAt = null;\n185\t  var sentReady = false;\n186\t  var reported = false;\n187\t  var handlers = {};\n188\t  var pending = {};\n189\t  var tokens = limits.burst;\n190\t  var refilled = now();\n191\t  var probeFn = null;\n192\t  var lastProgress = -Infinity;\n193\t  var nextProgress = null;\n194\t  var progressTimer = null;\n195\t\n196\t  function now() {\n197\t    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n198\t  }\n199\t\n200\t  function warn(text) {\n201\t    if (root.console) root.console.warn('[AIHub] ' + text);\n202\t  }\n203\t\n204\t  function own(o, k) {\n205\t    return Object.prototype.hasOwnProperty.call(o, k);\n206\t  }\n207\t\n208\t  /** This client's own fields, which no welcome may overwrite. */\n209\t  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n210\t\n211\t  /** A plain JSON copy, or undefined when it is not JSON. */\n212\t  function json(value) {\n213\t    try {\n214\t      var text = JSON.stringify(value);\n215\t      return text === undefined ? undefined : JSON.parse(text);\n216\t    } catch (e) {\n217\t      return undefined;\n218\t    }\n219\t  }\n220\t\n221\t  function post(type, fields) {\n222\t    var msg = { aihub: 1, type: type };\n223\t    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n224\t    try {\n225\t      root.parent.postMessage(msg, origin);\n226\t    } catch (e) {\n227\t      warn('could not reach the hub: ' + e.message);\n228\t    }\n229\t  }\n230\t\n231\t  function emit(type, args) {\n232\t    var list = handlers[type];\n233\t    if (!list || !list.length || pending[type]) {\n234\t      (pending[type] = pending[type] || []).push(args);\n235\t      return;\n236\t    }\n237\t    for (var i = 0; i < list.length; i++) {\n238\t      try {\n239\t        list[i].apply(null, args);\n240\t      } catch (e) {\n241\t        setTimeout(function () {\n242\t          throw e;\n243\t        });\n244\t      }\n245\t    }\n246\t  }\n247\t\n248\t  function onMessage(event) {\n249\t    if (event.source !== root.parent) return;\n250\t    var m = event.data;\n251\t    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n252\t    if (m.type === 'welcome') {\n253\t      if (welcomed) return;\n254\t      welcomed = true;\n255\t      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n256\t      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n257\t      for (var key in m) {\n258\t        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n259\t        hub[key] = m[key];\n260\t      }\n261\t      hub.players = (m.players || []).slice();\n262\t      hub.seed = m.seed >>> 0;\n263\t      hub.isHost = m.me === m.host;\n264\t      hub.splash = m.splash === true;\n265\t      if (m.limits) {\n266\t        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n267\t        tokens = limits.burst;\n268\t      }\n269\t      if (connecting) connecting.resolve(info());\n270\t      return;\n271\t    }\n272\t    if (m.type === 'fullscreen') {\n273\t      fullscreenOn = m.on === true;\n274\t      try {\n275\t        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n276\t      } catch (e) {}\n277\t      return;\n278\t    }\n279\t    if (!welcomed || ended) return;\n280\t    if (m.type === 'start') {\n281\t      goAt = now() + Number(m.in || 0);\n282\t      emit('start', [{ in: Number(m.in || 0) }]);\n283\t    } else if (m.type === 'message') {\n284\t      emit('message', [m.data, m.from]);\n285\t    } else if (m.type === 'leave') {\n286\t      hub.players = hub.players.filter(function (p) {\n287\t        return p.id !== m.id;\n288\t      });\n289\t      emit('leave', [{ id: m.id, reason: m.reason }]);\n290\t    } else if (m.type === 'time-up') {\n291\t      emit('time-up', [{ graceMs: m.graceMs }]);\n292\t    } else if (m.type === 'end') {\n293\t      ended = true;\n294\t      if (progressTimer) clearTimeout(progressTimer);\n295\t      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n296\t    } else {\n297\t      // An event this client has never heard of: hand it on as it came.\n298\t      var detail = {};\n299\t      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n300\t      emit(m.type, [detail]);\n301\t    }\n302\t  }\n303\t\n304\t  function info() {\n305\t    var out = {};\n306\t    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n307\t    out.players = hub.players.slice();\n308\t    return out;\n309\t  }\n310\t\n311\t  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n312\t  hub.connect = function (opts) {\n313\t    if (connecting) return connecting.promise;\n314\t    var done;\n315\t    var promise = new Promise(function (resolve) {\n316\t      done = resolve;\n317\t    });\n318\t    connecting = { promise: promise, resolve: done };\n319\t    if (!hub.active) {\n320\t      done(null);\n321\t      return promise;\n322\t    }\n323\t    opts = opts || {};\n324\t    root.addEventListener('message', onMessage);\n325\t    var started = now();\n326\t    var hello = function () {\n327\t      if (welcomed) return;\n328\t      if (now() - started > HELLO_TIMEOUT_MS) {\n329\t        standAlone();\n330\t        warn('no hub answered; playing normally');\n331\t        done(null);\n332\t        return;\n333\t      }\n334\t      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n335\t      setTimeout(hello, HELLO_EVERY_MS);\n336\t    };\n337\t    hello();\n338\t    return promise;\n339\t  };\n340\t\n341\t  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n342\t  hub.ready = function () {\n343\t    if (!welcomed || sentReady || ended) return;\n344\t    sentReady = true;\n345\t    post('ready', {});\n346\t  };\n347\t\n348\t  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n349\t  hub.answer = function (what) {\n350\t    if (!welcomed || ended || goAt !== null) return;\n351\t    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n352\t    post('answer', { answer: what });\n353\t  };\n354\t\n355\t  hub.on = function (type, fn) {\n356\t    (handlers[type] = handlers[type] || []).push(fn);\n357\t    if (pending[type] && !pending[type].flushing) {\n358\t      pending[type].flushing = true;\n359\t      setTimeout(function () {\n360\t        var queued = pending[type];\n361\t        delete pending[type];\n362\t        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n363\t      });\n364\t    }\n365\t    return function () {\n366\t      var list = handlers[type] || [];\n367\t      var at = list.indexOf(fn);\n368\t      if (at !== -1) list.splice(at, 1);\n369\t    };\n370\t  };\n371\t\n372\t  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n373\t  hub.send = function (data, opts) {\n374\t    if (!welcomed || ended) return false;\n375\t    opts = opts || {};\n376\t    var text;\n377\t    try {\n378\t      text = JSON.stringify(data);\n379\t    } catch (e) {\n380\t      warn('send: data is not JSON');\n381\t      return false;\n382\t    }\n383\t    if (text === undefined) return false;\n384\t    if (text.length > limits.maxBytes) {\n385\t      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n386\t      return false;\n387\t    }\n388\t    var t = now();\n389\t    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n390\t    refilled = t;\n391\t    if (tokens < 1) {\n392\t      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n393\t      return false;\n394\t    }\n395\t    tokens -= 1;\n396\t    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n397\t    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n398\t    post('send', fields);\n399\t    return true;\n400\t  };\n401\t\n402\t  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n403\t  hub.time = function () {\n404\t    return goAt === null ? -Infinity : now() - goAt;\n405\t  };\n406\t\n407\t  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n408\t  hub.rng = function (label) {\n409\t    var h = 2166136261;\n410\t    var s = String(label === undefined ? '' : label);\n411\t    for (var i = 0; i < s.length; i++) {\n412\t      h ^= s.charCodeAt(i);\n413\t      h = Math.imul(h, 16777619);\n414\t    }\n415\t    return generator((hub.seed ^ h) >>> 0);\n416\t  };\n417\t\n418\t  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n419\t  function finite(v) {\n420\t    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n421\t  }\n422\t\n423\t  /**\n424\t   * The whole outcome as plain JSON, field by field: the hub checks and trims\n425\t   * it, so new optional fields need no new client. A field that is not JSON\n426\t   * (a cycle, a BigInt) is left out, not the whole outcome.\n427\t   */\n428\t  function outcomeOf(outcome) {\n429\t    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n430\t      warn('the outcome is not a plain object');\n431\t      return null;\n432\t    }\n433\t    var copy = {};\n434\t    for (var key in outcome) {\n435\t      if (!own(outcome, key)) continue;\n436\t      var value = json(outcome[key]);\n437\t      if (value !== undefined) copy[key] = value;\n438\t      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n439\t    }\n440\t    return copy;\n441\t  }\n442\t\n443\t  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n444\t  hub.result = function (outcome) {\n445\t    if (!welcomed || ended || reported) return;\n446\t    var fields = outcomeOf(outcome);\n447\t    if (!fields) return;\n448\t    var given = outcome || {};\n449\t    delete fields.time;\n450\t    delete fields.score;\n451\t    if (finite(given.time)) fields.time = Number(given.time);\n452\t    if (finite(given.score)) fields.score = Number(given.score);\n453\t    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n454\t    reported = true;\n455\t    if (progressTimer) clearTimeout(progressTimer);\n456\t    post('result', fields);\n457\t  };\n458\t\n459\t  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n460\t  hub.finish = function (outcome) {\n461\t    if (!welcomed || ended || reported) return;\n462\t    if (!hub.isHost) return warn('finish is for the host only');\n463\t    var fields = outcomeOf(outcome);\n464\t    if (!fields) return;\n465\t    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n466\t    reported = true;\n467\t    post('finish', fields);\n468\t  };\n469\t\n470\t  function sendProgress() {\n471\t    progressTimer = null;\n472\t    if (!nextProgress || ended || reported) return;\n473\t    lastProgress = now();\n474\t    post('progress', nextProgress);\n475\t    nextProgress = null;\n476\t  }\n477\t\n478\t  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n479\t  hub.progress = function (p) {\n480\t    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n481\t    nextProgress = { score: Number(p.score) };\n482\t    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n483\t    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n484\t    if (wait <= 0) sendProgress();\n485\t    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n486\t  };\n487\t\n488\t  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n489\t  hub.probe = function (fn) {\n490\t    probeFn = typeof fn === 'function' ? fn : null;\n491\t  };\n492\t\n493\t  hub.inspect = function () {\n494\t    if (!probeFn) return null;\n495\t    try {\n496\t      return JSON.parse(JSON.stringify(probeFn()));\n497\t    } catch (e) {\n498\t      return { error: String((e && e.message) || e) };\n499\t    }\n500\t  };\n501\t\n502\t  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n503\t  hub.fail = function (message) {\n504\t    if (!hub.active) return;\n505\t    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n506\t  };\n507\t\n508\t  root.AIHub = hub;\n509\t})(typeof window !== 'undefined' ? window : globalThis);\n510\t</script>\n511\t</head>\n512\t<body>\n513\t<canvas id=\"c\" aria-label=\"Starfall\"></canvas>\n514\t<script>\n515\t'use strict';\n516\t// Starfall: the smallest honest parallel game. Every copy plays its own\n517\t// one-minute run, alone, with no game traffic at all. The stars come from\n518\t// plain Math.random, as in most games; in a parallel session the hub's\n519\t// client seeds Math.random before this script runs, so every copy gets the\n520\t// same stars. The game tells the hub its score once a second (progress) and\n521\t// reports once at the end (result); the hub draws the scoreboard and ranks.\n522\t// Before the round it shows its own card (connect({ card: true })): the\n523\t// title, who is playing, how to win, the controls and the time left, with\n524\t// Ready and More time on Enter / Cross, T / Triangle or a tap.\n525\tconst W = 600, H = 800, RUN_MS = 60_000, R = 13, CATCHER = 64;\n526\tconst canvas = document.getElementById('c');\n527\tconst ctx = canvas.getContext('2d');\n528\tconst keys = new Set();\n529\tlet pointerX = null;\n530\tlet audio = null;\n531\t\n532\taddEventListener('keydown', (e) => {\n533\t  if (run.phase === 'card') return cardKey(e.key);\n534\t  if (e.key === 'Escape') return toggleMenu();\n535\t  if (menu.open) return menuKey(e.key);\n536\t  keys.add(e.key.toLowerCase());\n537\t  gesture();\n538\t});\n539\taddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n540\t\n541\t// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n542\t// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n543\t// Buttons count on the frame they go down.\n544\tconst PAD = { cross: 0, circle: 1, triangle: 3, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\n545\tlet pad = null, padNow = [], padWas = [];\n546\tfunction readPad() {\n547\t  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n548\t  padWas = padNow;\n549\t  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n550\t  if (run.phase === 'card') {\n551\t    if (pressed(PAD.cross)) AIHub.answer('ready');\n552\t    if (pressed(PAD.triangle)) AIHub.answer('more');\n553\t    return;\n554\t  }\n555\t  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n556\t  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n557\t  if (menu.open) {\n558\t    if (pressed(PAD.up)) menuKey('ArrowUp');\n559\t    if (pressed(PAD.down)) menuKey('ArrowDown');\n560\t    if (pressed(PAD.cross)) menuKey('Enter');\n561\t    if (pressed(PAD.circle)) toggleMenu();\n562\t  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n563\t}\n564\tconst pressed = (b) => !!padNow[b] && !padWas[b];\n565\t\n566\t// ---- the settings menu: Esc or Options, over the running game. The run is\n567\t// on the clock, so it keeps falling while the menu is open.\n568\tlet muted = false;\n569\tconst menu = {\n570\t  open: false,\n571\t  at: 0,\n572\t  items: [\n573\t    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n574\t    { label: () => 'Back to the game', act: () => toggleMenu() },\n575\t  ],\n576\t};\n577\tfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\n578\tfunction menuKey(key) {\n579\t  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n580\t  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n581\t  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n582\t}\n583\tcanvas.addEventListener('pointerdown', (e) => {\n584\t  if (run.phase === 'card') return cardTap(e);\n585\t  pointerX = e.clientX;\n586\t  gesture();\n587\t});\n588\tcanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\n589\taddEventListener('pointerup', () => { pointerX = null; });\n590\t\n591\tfunction beep(freq) {\n592\t  if (!audio || muted) return;\n593\t  const o = audio.createOscillator(), g = audio.createGain();\n594\t  o.frequency.value = freq; g.gain.value = 0.05;\n595\t  o.connect(g).connect(audio.destination);\n596\t  o.start(); o.stop(audio.currentTime + 0.1);\n597\t}\n598\t\n599\tconst run = {\n600\t  phase: 'title',     // title | card | playing | done | over\n601\t  x: W / 2, score: 0, stars: 0, combo: 0, best: 0, stun: 0,\n602\t  falling: [], nextAt: 0, ms: 0,\n603\t  message: 'Starfall — press any key or tap to play',\n604\t};\n605\tlet hub = null;\n606\tlet soloStart = 0;\n607\tlet lastProgress = -1;\n608\tlet felt = 0;    // the local steering as last read\n609\tlet dash = false;   // Space or Cross held: the catcher moves faster\n610\t\n611\t/** The next thing to fall, from Math.random: a star, now and then a gold one or a rock. */\n612\tfunction spawn() {\n613\t  const roll = Math.random();\n614\t  run.falling.push({\n615\t    x: 30 + Math.random() * (W - 60),\n616\t    y: -20,\n617\t    speed: 220 + Math.random() * 160,\n618\t    kind: roll < 0.12 ? 'rock' : roll < 0.22 ? 'gold' : 'star',\n619\t  });\n620\t  run.nextAt += 250 + Math.random() * 450;\n621\t}\n622\t\n623\tfunction steer() {\n624\t  if (menu.open) return 0;\n625\t  let x = 0;\n626\t  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n627\t  if (keys.has('arrowright') || keys.has('d')) x += 1;\n628\t  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n629\t  if (padNow[PAD.left]) x = -1;\n630\t  if (padNow[PAD.right]) x = 1;\n631\t  if (pointerX !== null) {\n632\t    const r = canvas.getBoundingClientRect();\n633\t    const target = ((pointerX - r.left) / r.width) * W;\n634\t    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n635\t  }\n636\t  return x;\n637\t}\n638\t\n639\tasync function connect() {\n640\t  const info = await AIHub.connect({ mode: 'parallel', seats: [1, 4], card: true });\n641\t  if (!info) return;\n642\t  hub = info;\n643\t  // Our own card until the start. Ready as soon as we can play: the players answer on the card.\n644\t  run.phase = 'card';\n645\t  AIHub.on('card', (c) => { card = { ...c, at: performance.now() }; });\n646\t  AIHub.ready();\n647\t  AIHub.on('start', () => { begin(); unlockAudio(); });\n648\t  AIHub.on('time-up', () => {\n649\t    if (run.phase === 'playing') finish();\n650\t  });\n651\t  AIHub.on('end', ({ reason, standings }) => {\n652\t    run.phase = 'over';\n653\t    run.standings = standings;\n654\t    run.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n655\t  });\n656\t}\n657\t\n658\t// ---- the card: Starfall's own, before the round (lib/hub/README.md, \"The card\").\n659\t// It draws no numbers from Math.random: that would change the round's stars.\n660\tlet card = null;\n661\tconst sky = (() => {\n662\t  const rng = AIHub.rng('card');\n663\t  return Array.from({ length: 40 }, () => ({ x: rng() * W, y: rng() * H, speed: 20 + rng() * 40, size: 1 + rng() * 2.5 }));\n664\t})();\n665\tconst CARD_BUTTONS = [\n666\t  { answer: 'ready', x: 70, y: 640, w: 220, h: 64, label: 'Ready', keys: 'Enter · ✕' },\n667\t  { answer: 'more', x: 310, y: 640, w: 220, h: 64, label: 'More time', keys: 'T · △' },\n668\t];\n669\tfunction cardKey(key) {\n670\t  unlockAudio();\n671\t  if (key === 'Enter' || key === ' ') AIHub.answer('ready');\n672\t  else if (key === 't' || key === 'T') AIHub.answer('more');\n673\t}\n674\tfunction cardTap(e) {\n675\t  unlockAudio();\n676\t  const r = canvas.getBoundingClientRect();\n677\t  const s = Math.min(r.width / W, r.height / H);\n678\t  const x = (e.clientX - r.left - (r.width - W * s) / 2) / s;\n679\t  const y = (e.clientY - r.top - (r.height - H * s) / 2) / s;\n680\t  const hit = CARD_BUTTONS.find((b) => x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h);\n681\t  if (hit) AIHub.answer(hit.answer);\n682\t}\n683\t\n684\tfunction drawCard() {\n685\t  const now = performance.now();\n686\t  for (const st of sky) {\n687\t    const y = (st.y + (now / 1000) * st.speed) % H;\n688\t    ctx.fillStyle = 'rgba(238,243,251,.5)';\n689\t    ctx.beginPath(); ctx.arc(st.x, y, st.size, 0, Math.PI * 2); ctx.fill();\n690\t  }\n691\t  ctx.textAlign = 'center';\n692\t  ctx.fillStyle = '#ffd34d'; ctx.font = 'bold 72px system-ui';\n693\t  ctx.fillText('STARFALL', W / 2, 130);\n694\t  ctx.fillStyle = '#eef3fb'; ctx.font = '20px system-ui';\n695\t  ctx.fillText('Most points in one minute: catch stars, dodge rocks', W / 2, 175);\n696\t\n697\t  // Who is playing, in their colours, and who is ready.\n698\t  ctx.font = '20px system-ui';\n699\t  hub.players.forEach((p, i) => {\n700\t    const y = 250 + i * 44;\n701\t    ctx.fillStyle = 'rgba(0,0,0,.35)'; ctx.fillRect(100, y - 28, 400, 38);\n702\t    ctx.fillStyle = p.color; ctx.fillRect(100, y - 28, 8, 38);\n703\t    ctx.textAlign = 'left'; ctx.fillStyle = '#eef3fb';\n704\t    ctx.fillText(`${p.name}${p.id === hub.me ? ' (you)' : ''}`, 122, y - 2);\n705\t    const ready = card?.ready?.includes(p.id);\n706\t    ctx.textAlign = 'right'; ctx.fillStyle = ready ? '#7ee787' : '#8c86a8';\n707\t    ctx.fillText(ready ? 'ready ✓' : '…', 488, y - 2);\n708\t  });\n709\t\n710\t  // The controls this player uses.\n711\t  ctx.textAlign = 'center'; ctx.fillStyle = '#c9c4e0'; ctx.font = '18px system-ui';\n712\t  ctx.fillText('Move: ← → or A D, a stick, or drag a finger', W / 2, 455);\n713\t  ctx.fillText('Dash: hold Space or ✕', W / 2, 482);\n714\t\n715\t  // The time left, from the hub's card.\n716\t  ctx.fillStyle = '#eef3fb';\n717\t  if (!card) { ctx.font = '22px system-ui'; ctx.fillText('Get ready…', W / 2, 575); }\n718\t  else if (card.starting) { ctx.font = '26px system-ui'; ctx.fillText('Starting…', W / 2, 575); }\n719\t  else if (card.paused) { ctx.fillStyle = '#ffd34d'; ctx.font = '22px system-ui'; ctx.fillText('Paused: most players want more time', W / 2, 575); }\n720\t  else {\n721\t    ctx.font = 'bold 64px system-ui';\n722\t    ctx.fillText(String(Math.max(0, Math.ceil((card.left - (now - card.at)) / 1000))), W / 2, 590);\n723\t  }\n724\t  if (card?.asking) {\n725\t    ctx.fillStyle = '#ffd34d'; ctx.font = '16px system-ui';\n726\t    ctx.fillText(card.asked ? 'You asked for more time' : `${card.asking} asking for more time`, W / 2, 618);\n727\t  }\n728\t\n729\t  const mine = card?.ready?.includes(hub.me);\n730\t  for (const b of CARD_BUTTONS) {\n731\t    const on = b.answer === 'ready' ? mine : card?.asked;\n732\t    ctx.fillStyle = b.answer === 'ready' ? (on ? '#2f6f3e' : '#ffd34d') : on ? '#3b335f' : 'rgba(0,0,0,.4)';\n733\t    ctx.fillRect(b.x, b.y, b.w, b.h);\n734\t    ctx.strokeStyle = '#ffd34d'; ctx.lineWidth = 2; ctx.strokeRect(b.x, b.y, b.w, b.h);\n735\t    ctx.fillStyle = b.answer === 'ready' && !on ? '#15103a' : '#eef3fb';\n736\t    ctx.font = 'bold 22px system-ui';\n737\t    ctx.fillText(b.answer === 'ready' && on ? 'Ready ✓' : b.answer === 'more' && on ? 'Take it back' : b.label, b.x + b.w / 2, b.y + 30);\n738\t    ctx.font = '14px system-ui';\n739\t    ctx.fillText(b.keys, b.x + b.w / 2, b.y + 52);\n740\t  }\n741\t}\n742\t\n743\tfunction begin() {\n744\t  Object.assign(run, { phase: 'playing', x: W / 2, score: 0, stars: 0, combo: 0, best: 0, stun: 0, falling: [], nextAt: 0, ms: 0 });\n745\t  soloStart = performance.now();\n746\t}\n747\t\n748\t/** The run is over: report it once. */\n749\tfunction finish() {\n750\t  run.phase = 'done';\n751\t  run.message = `${run.score} points — ${run.stars} stars`;\n752\t  beep(880);\n753\t  if (!hub) return;\n754\t  const awards = run.best >= 12 ? [{ title: 'Star streak', detail: `${run.best} in a row` }] : [];\n755\t  AIHub.result({ score: run.score, stats: { stars: run.stars, 'best streak': run.best }, awards });\n756\t  run.message += ' — waiting for the others';\n757\t}\n758\t\n759\tfunction unlockAudio() {\n760\t  if (!audio) {\n761\t    try { audio = new AudioContext(); } catch { audio = null; }\n762\t  }\n763\t  audio?.resume?.().catch(() => {});\n764\t}\n765\t\n766\tfunction gesture() {\n767\t  unlockAudio();\n768\t  if (!hub && (run.phase === 'title' || run.phase === 'done')) begin();\n769\t}\n770\t\n771\t/** Run time: the hub's shared clock in a session, the local one alone. */\n772\tconst runTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n773\t\n774\tlet last = performance.now();\n775\tfunction frame(now) {\n776\t  const dt = Math.min((now - last) / 1000, 0.25);\n777\t  last = now;\n778\t  readPad();\n779\t  felt = steer();\n780\t  dash = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n781\t  const t = runTime();\n782\t  if (run.phase === 'playing' && t >= 0) {\n783\t    if (run.stun > 0) run.stun -= dt;\n784\t    else run.x = Math.max(CATCHER / 2, Math.min(W - CATCHER / 2, run.x + felt * (dash ? 700 : 420) * dt));\n785\t    // Spawns follow the run's clock, so every copy draws the same numbers in the same order.\n786\t    while (run.nextAt <= t && run.nextAt < RUN_MS) spawn();\n787\t    for (const f of run.falling) {\n788\t      f.y += f.speed * dt;\n789\t      if (f.y >= H - 110 && f.y <= H - 70 && Math.abs(f.x - run.x) <= CATCHER / 2 + R) {\n790\t        f.gone = true;\n791\t        if (f.kind === 'rock') { run.stun = 0.8; run.combo = 0; beep(140); continue; }\n792\t        run.combo++;\n793\t        run.best = Math.max(run.best, run.combo);\n794\t        run.stars++;\n795\t        run.score += (f.kind === 'gold' ? 50 : 10) * (1 + Math.floor(run.combo / 5));\n796\t        beep(f.kind === 'gold' ? 990 : 660);\n797\t      } else if (f.y > H) {\n798\t        f.gone = true;\n799\t        if (f.kind !== 'rock') run.combo = 0;   // a star that got away ends the streak\n800\t      }\n801\t    }\n802\t    run.falling = run.falling.filter((f) => !f.gone);\n803\t    // The hub draws the scoreboard: tell it the score about once a second.\n804\t    const second = Math.floor(t / 1000);\n805\t    if (hub && second !== lastProgress) {\n806\t      lastProgress = second;\n807\t      AIHub.progress?.({ score: run.score, label: `${run.stars} stars` });\n808\t    }\n809\t    if (t >= RUN_MS) finish();\n810\t  }\n811\t  draw(t);\n812\t  requestAnimationFrame(frame);\n813\t}\n814\t\n815\tfunction draw(t) {\n816\t  const r = canvas.getBoundingClientRect();\n817\t  const dpr = devicePixelRatio || 1;\n818\t  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n819\t    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n820\t  }\n821\t  const s = Math.min(canvas.width / W, canvas.height / H);\n822\t  ctx.setTransform(1, 0, 0, 1, 0, 0);\n823\t  ctx.fillStyle = '#0b0820'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n824\t  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n825\t  ctx.fillStyle = '#15103a'; ctx.fillRect(0, 0, W, H);\n826\t\n827\t  for (const f of run.falling) {\n828\t    ctx.fillStyle = f.kind === 'rock' ? '#6b6585' : f.kind === 'gold' ? '#ffd34d' : '#eef3fb';\n829\t    ctx.beginPath(); ctx.arc(f.x, f.y, f.kind === 'gold' ? R + 3 : R, 0, Math.PI * 2); ctx.fill();\n830\t  }\n831\t  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n832\t  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n833\t  if (run.phase !== 'card') ctx.fillRect(run.x - CATCHER / 2, H - 96, CATCHER, 14);\n834\t\n835\t  ctx.textAlign = 'center';\n836\t  ctx.fillStyle = '#eef3fb';\n837\t  ctx.font = '20px system-ui';\n838\t  if (run.phase === 'card') drawCard();\n839\t  else if (run.phase === 'playing') {\n840\t    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n841\t    else {\n842\t      ctx.fillText(`${run.score}   ·   ${Math.max(0, Math.ceil((RUN_MS - t) / 1000))} s`, W / 2, 34);\n843\t      if (run.combo >= 5) { ctx.font = '16px system-ui'; ctx.fillText(`streak ${run.combo}`, W / 2, 60); }\n844\t    }\n845\t  } else {\n846\t    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n847\t    ctx.fillStyle = '#eef3fb';\n848\t    ctx.fillText(run.message, W / 2, H / 2 - 80);\n849\t    if (run.standings && hub) {\n850\t      ctx.font = '18px system-ui';\n851\t      let row = 0;\n852\t      run.standings.forEach((ids, place) => ids.forEach((id) => {\n853\t        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n854\t        ctx.fillStyle = p.color;\n855\t        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n856\t      }));\n857\t    }\n858\t  }\n859\t  if (menu.open) drawMenu();\n860\t}\n861\t\n862\tfunction drawMenu() {\n863\t  ctx.fillStyle = 'rgba(4,4,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n864\t  ctx.textAlign = 'center';\n865\t  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n866\t  ctx.fillText('Settings', W / 2, 286);\n867\t  ctx.font = '18px system-ui';\n868\t  menu.items.forEach((item, i) => {\n869\t    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n870\t    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n871\t  });\n872\t}\n873\t\n874\tconnect();\n875\trequestAnimationFrame(frame);\n876\t</script>\n877\t</body>\n878\t</html>\n879\t"}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"87c6be26-b3e7-4324-80ca-86de319b2753","timestamp":"2026-11-05T04:24:24.799Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/hub/lib/hub/examples/parallel.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Starfall — AI Hub session example (parallel)</title>\n<meta name=\"description\" content=\"A minimal parallel game for the AI Hub Session Protocol: everyone plays their own one-minute run of the same falling stars, and the hub keeps the score.\">\n<meta name=\"theme-color\" content=\"#15103a\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"parallel\">\n<meta name=\"hub:session-minutes\" content=\"1\">\n<meta name=\"hub:session-goal\" content=\"Most points in one minute: catch stars, dodge rocks\">\n<meta name=\"hub:session-howto\" content=\"Move: ← →, A D or a stick · dash: Space or Cross · or drag a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #15103a; color: #eef3fb; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n    var shown = function () {\n      return fullscreenOn ? root.document.documentElement || null : null;\n    };\n    try {\n      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n    } catch (e) {}\n  }\n\n  /**\n   * No hub after all: play on, with Math.random the page's own again. The\n   * empty storage stays: the game has read it already, and what it writes\n   * must never land on the player's real saves.\n   */\n  function standAlone() {\n    hub.active = false;\n    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n    hub.seeded = false;\n  }\n\n  var origin = '*';\n  var welcomed = false;\n  var ended = false;\n  var connecting = null;\n  var goAt = null;\n  var sentReady = false;\n  var reported = false;\n  var handlers = {};\n  var pending = {};\n  var tokens = limits.burst;\n  var refilled = now();\n  var probeFn = null;\n  var lastProgress = -Infinity;\n  var nextProgress = null;\n  var progressTimer = null;\n\n  function now() {\n    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n  }\n\n  function warn(text) {\n    if (root.console) root.console.warn('[AIHub] ' + text);\n  }\n\n  function own(o, k) {\n    return Object.prototype.hasOwnProperty.call(o, k);\n  }\n\n  /** This client's own fields, which no welcome may overwrite. */\n  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n\n  /** A plain JSON copy, or undefined when it is not JSON. */\n  function json(value) {\n    try {\n      var text = JSON.stringify(value);\n      return text === undefined ? undefined : JSON.parse(text);\n    } catch (e) {\n      return undefined;\n    }\n  }\n\n  function post(type, fields) {\n    var msg = { aihub: 1, type: type };\n    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n    try {\n      root.parent.postMessage(msg, origin);\n    } catch (e) {\n      warn('could not reach the hub: ' + e.message);\n    }\n  }\n\n  function emit(type, args) {\n    var list = handlers[type];\n    if (!list || !list.length || pending[type]) {\n      (pending[type] = pending[type] || []).push(args);\n      return;\n    }\n    for (var i = 0; i < list.length; i++) {\n      try {\n        list[i].apply(null, args);\n      } catch (e) {\n        setTimeout(function () {\n          throw e;\n        });\n      }\n    }\n  }\n\n  function onMessage(event) {\n    if (event.source !== root.parent) return;\n    var m = event.data;\n    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n    if (m.type === 'welcome') {\n      if (welcomed) return;\n      welcomed = true;\n      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n      for (var key in m) {\n        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n        hub[key] = m[key];\n      }\n      hub.players = (m.players || []).slice();\n      hub.seed = m.seed >>> 0;\n      hub.isHost = m.me === m.host;\n      hub.splash = m.splash === true;\n      if (m.limits) {\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n        tokens = limits.burst;\n      }\n      if (connecting) connecting.resolve(info());\n      return;\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n</script>\n</head>\n<body>\n<canvas id=\"c\" aria-label=\"Starfall\"></canvas>\n<script>\n'use strict';\n// Starfall: the smallest honest parallel game. Every copy plays its own\n// one-minute run, alone, with no game traffic at all. The stars come from\n// plain Math.random, as in most games; in a parallel session the hub's\n// client seeds Math.random before this script runs, so every copy gets the\n// same stars. The game tells the hub its score once a second (progress) and\n// reports once at the end (result); the hub draws the scoreboard and ranks.\n// Before the round it shows its own card (connect({ card: true })): the\n// title, who is playing, how to win, the controls and the time left, with\n// Ready and More time on Enter / Cross, T / Triangle or a tap.\nconst W = 600, H = 800, RUN_MS = 60_000, R = 13, CATCHER = 64;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst keys = new Set();\nlet pointerX = null;\nlet audio = null;\n\naddEventListener('keydown', (e) => {\n  if (run.phase === 'card') return cardKey(e.key);\n  if (e.key === 'Escape') return toggleMenu();\n  if (menu.open) return menuKey(e.key);\n  keys.add(e.key.toLowerCase());\n  gesture();\n});\naddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n\n// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n// Buttons count on the frame they go down.\nconst PAD = { cross: 0, circle: 1, triangle: 3, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\nlet pad = null, padNow = [], padWas = [];\nfunction readPad() {\n  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n  padWas = padNow;\n  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n  if (run.phase === 'card') {\n    if (pressed(PAD.cross)) AIHub.answer('ready');\n    if (pressed(PAD.triangle)) AIHub.answer('more');\n    return;\n  }\n  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n  if (menu.open) {\n    if (pressed(PAD.up)) menuKey('ArrowUp');\n    if (pressed(PAD.down)) menuKey('ArrowDown');\n    if (pressed(PAD.cross)) menuKey('Enter');\n    if (pressed(PAD.circle)) toggleMenu();\n  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n}\nconst pressed = (b) => !!padNow[b] && !padWas[b];\n\n// ---- the settings menu: Esc or Options, over the running game. The run is\n// on the clock, so it keeps falling while the menu is open.\nlet muted = false;\nconst menu = {\n  open: false,\n  at: 0,\n  items: [\n    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n    { label: () => 'Back to the game', act: () => toggleMenu() },\n  ],\n};\nfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\nfunction menuKey(key) {\n  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n}\ncanvas.addEventListener('pointerdown', (e) => {\n  if (run.phase === 'card') return cardTap(e);\n  pointerX = e.clientX;\n  gesture();\n});\ncanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\naddEventListener('pointerup', () => { pointerX = null; });\n\nfunction beep(freq) {\n  if (!audio || muted) return;\n  const o = audio.createOscillator(), g = audio.createGain();\n  o.frequency.value = freq; g.gain.value = 0.05;\n  o.connect(g).connect(audio.destination);\n  o.start(); o.stop(audio.currentTime + 0.1);\n}\n\nconst run = {\n  phase: 'title',     // title | card | playing | done | over\n  x: W / 2, score: 0, stars: 0, combo: 0, best: 0, stun: 0,\n  falling: [], nextAt: 0, ms: 0,\n  message: 'Starfall — press any key or tap to play',\n};\nlet hub = null;\nlet soloStart = 0;\nlet lastProgress = -1;\nlet felt = 0;    // the local steering as last read\nlet dash = false;   // Space or Cross held: the catcher moves faster\n\n/** The next thing to fall, from Math.random: a star, now and then a gold one or a rock. */\nfunction spawn() {\n  const roll = Math.random();\n  run.falling.push({\n    x: 30 + Math.random() * (W - 60),\n    y: -20,\n    speed: 220 + Math.random() * 160,\n    kind: roll < 0.12 ? 'rock' : roll < 0.22 ? 'gold' : 'star',\n  });\n  run.nextAt += 250 + Math.random() * 450;\n}\n\nfunction steer() {\n  if (menu.open) return 0;\n  let x = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n  if (padNow[PAD.left]) x = -1;\n  if (padNow[PAD.right]) x = 1;\n  if (pointerX !== null) {\n    const r = canvas.getBoundingClientRect();\n    const target = ((pointerX - r.left) / r.width) * W;\n    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n  }\n  return x;\n}\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'parallel', seats: [1, 4], card: true });\n  if (!info) return;\n  hub = info;\n  // Our own card until the start. Ready as soon as we can play: the players answer on the card.\n  run.phase = 'card';\n  AIHub.on('card', (c) => { card = { ...c, at: performance.now() }; });\n  AIHub.ready();\n  AIHub.on('start', () => { begin(); unlockAudio(); });\n  AIHub.on('time-up', () => {\n    if (run.phase === 'playing') finish();\n  });\n  AIHub.on('end', ({ reason, standings }) => {\n    run.phase = 'over';\n    run.standings = standings;\n    run.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n  });\n}\n\n// ---- the card: Starfall's own, before the round (lib/hub/README.md, \"The card\").\n// It draws no numbers from Math.random: that would change the round's stars.\nlet card = null;\nconst sky = (() => {\n  const rng = AIHub.rng('card');\n  return Array.from({ length: 40 }, () => ({ x: rng() * W, y: rng() * H, speed: 20 + rng() * 40, size: 1 + rng() * 2.5 }));\n})();\nconst CARD_BUTTONS = [\n  { answer: 'ready', x: 70, y: 640, w: 220, h: 64, label: 'Ready', keys: 'Enter · ✕' },\n  { answer: 'more', x: 310, y: 640, w: 220, h: 64, label: 'More time', keys: 'T · △' },\n];\nfunction cardKey(key) {\n  unlockAudio();\n  if (key === 'Enter' || key === ' ') AIHub.answer('ready');\n  else if (key === 't' || key === 'T') AIHub.answer('more');\n}\nfunction cardTap(e) {\n  unlockAudio();\n  const r = canvas.getBoundingClientRect();\n  const s = Math.min(r.width / W, r.height / H);\n  const x = (e.clientX - r.left - (r.width - W * s) / 2) / s;\n  const y = (e.clientY - r.top - (r.height - H * s) / 2) / s;\n  const hit = CARD_BUTTONS.find((b) => x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h);\n  if (hit) AIHub.answer(hit.answer);\n}\n\nfunction drawCard() {\n  const now = performance.now();\n  for (const st of sky) {\n    const y = (st.y + (now / 1000) * st.speed) % H;\n    ctx.fillStyle = 'rgba(238,243,251,.5)';\n    ctx.beginPath(); ctx.arc(st.x, y, st.size, 0, Math.PI * 2); ctx.fill();\n  }\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#ffd34d'; ctx.font = 'bold 72px system-ui';\n  ctx.fillText('STARFALL', W / 2, 130);\n  ctx.fillStyle = '#eef3fb'; ctx.font = '20px system-ui';\n  ctx.fillText('Most points in one minute: catch stars, dodge rocks', W / 2, 175);\n\n  // Who is playing, in their colours, and who is ready.\n  ctx.font = '20px system-ui';\n  hub.players.forEach((p, i) => {\n    const y = 250 + i * 44;\n    ctx.fillStyle = 'rgba(0,0,0,.35)'; ctx.fillRect(100, y - 28, 400, 38);\n    ctx.fillStyle = p.color; ctx.fillRect(100, y - 28, 8, 38);\n    ctx.textAlign = 'left'; ctx.fillStyle = '#eef3fb';\n    ctx.fillText(`${p.name}${p.id === hub.me ? ' (you)' : ''}`, 122, y - 2);\n    const ready = card?.ready?.includes(p.id);\n    ctx.textAlign = 'right'; ctx.fillStyle = ready ? '#7ee787' : '#8c86a8';\n    ctx.fillText(ready ? 'ready ✓' : '…', 488, y - 2);\n  });\n\n  // The controls this player uses.\n  ctx.textAlign = 'center'; ctx.fillStyle = '#c9c4e0'; ctx.font = '18px system-ui';\n  ctx.fillText('Move: ← → or A D, a stick, or drag a finger', W / 2, 455);\n  ctx.fillText('Dash: hold Space or ✕', W / 2, 482);\n\n  // The time left, from the hub's card.\n  ctx.fillStyle = '#eef3fb';\n  if (!card) { ctx.font = '22px system-ui'; ctx.fillText('Get ready…', W / 2, 575); }\n  else if (card.starting) { ctx.font = '26px system-ui'; ctx.fillText('Starting…', W / 2, 575); }\n  else if (card.paused) { ctx.fillStyle = '#ffd34d'; ctx.font = '22px system-ui'; ctx.fillText('Paused: most players want more time', W / 2, 575); }\n  else {\n    ctx.font = 'bold 64px system-ui';\n    ctx.fillText(String(Math.max(0, Math.ceil((card.left - (now - card.at)) / 1000))), W / 2, 590);\n  }\n  if (card?.asking) {\n    ctx.fillStyle = '#ffd34d'; ctx.font = '16px system-ui';\n    ctx.fillText(card.asked ? 'You asked for more time' : `${card.asking} asking for more time`, W / 2, 618);\n  }\n\n  const mine = card?.ready?.includes(hub.me);\n  for (const b of CARD_BUTTONS) {\n    const on = b.answer === 'ready' ? mine : card?.asked;\n    ctx.fillStyle = b.answer === 'ready' ? (on ? '#2f6f3e' : '#ffd34d') : on ? '#3b335f' : 'rgba(0,0,0,.4)';\n    ctx.fillRect(b.x, b.y, b.w, b.h);\n    ctx.strokeStyle = '#ffd34d'; ctx.lineWidth = 2; ctx.strokeRect(b.x, b.y, b.w, b.h);\n    ctx.fillStyle = b.answer === 'ready' && !on ? '#15103a' : '#eef3fb';\n    ctx.font = 'bold 22px system-ui';\n    ctx.fillText(b.answer === 'ready' && on ? 'Ready ✓' : b.answer === 'more' && on ? 'Take it back' : b.label, b.x + b.w / 2, b.y + 30);\n    ctx.font = '14px system-ui';\n    ctx.fillText(b.keys, b.x + b.w / 2, b.y + 52);\n  }\n}\n\nfunction begin() {\n  Object.assign(run, { phase: 'playing', x: W / 2, score: 0, stars: 0, combo: 0, best: 0, stun: 0, falling: [], nextAt: 0, ms: 0 });\n  soloStart = performance.now();\n}\n\n/** The run is over: report it once. */\nfunction finish() {\n  run.phase = 'done';\n  run.message = `${run.score} points — ${run.stars} stars`;\n  beep(880);\n  if (!hub) return;\n  const awards = run.best >= 12 ? [{ title: 'Star streak', detail: `${run.best} in a row` }] : [];\n  AIHub.result({ score: run.score, stats: { stars: run.stars, 'best streak': run.best }, awards });\n  run.message += ' — waiting for the others';\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (run.phase === 'title' || run.phase === 'done')) begin();\n}\n\n/** Run time: the hub's shared clock in a session, the local one alone. */\nconst runTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  felt = steer();\n  dash = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n  const t = runTime();\n  if (run.phase === 'playing' && t >= 0) {\n    if (run.stun > 0) run.stun -= dt;\n    else run.x = Math.max(CATCHER / 2, Math.min(W - CATCHER / 2, run.x + felt * (dash ? 700 : 420) * dt));\n    // Spawns follow the run's clock, so every copy draws the same numbers in the same order.\n    while (run.nextAt <= t && run.nextAt < RUN_MS) spawn();\n    for (const f of run.falling) {\n      f.y += f.speed * dt;\n      if (f.y >= H - 110 && f.y <= H - 70 && Math.abs(f.x - run.x) <= CATCHER / 2 + R) {\n        f.gone = true;\n        if (f.kind === 'rock') { run.stun = 0.8; run.combo = 0; beep(140); continue; }\n        run.combo++;\n        run.best = Math.max(run.best, run.combo);\n        run.stars++;\n        run.score += (f.kind === 'gold' ? 50 : 10) * (1 + Math.floor(run.combo / 5));\n        beep(f.kind === 'gold' ? 990 : 660);\n      } else if (f.y > H) {\n        f.gone = true;\n        if (f.kind !== 'rock') run.combo = 0;   // a star that got away ends the streak\n      }\n    }\n    run.falling = run.falling.filter((f) => !f.gone);\n    // The hub draws the scoreboard: tell it the score about once a second.\n    const second = Math.floor(t / 1000);\n    if (hub && second !== lastProgress) {\n      lastProgress = second;\n      AIHub.progress?.({ score: run.score, label: `${run.stars} stars` });\n    }\n    if (t >= RUN_MS) finish();\n  }\n  draw(t);\n  requestAnimationFrame(frame);\n}\n\nfunction draw(t) {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#0b0820'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#15103a'; ctx.fillRect(0, 0, W, H);\n\n  for (const f of run.falling) {\n    ctx.fillStyle = f.kind === 'rock' ? '#6b6585' : f.kind === 'gold' ? '#ffd34d' : '#eef3fb';\n    ctx.beginPath(); ctx.arc(f.x, f.y, f.kind === 'gold' ? R + 3 : R, 0, Math.PI * 2); ctx.fill();\n  }\n  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n  if (run.phase !== 'card') ctx.fillRect(run.x - CATCHER / 2, H - 96, CATCHER, 14);\n\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#eef3fb';\n  ctx.font = '20px system-ui';\n  if (run.phase === 'card') drawCard();\n  else if (run.phase === 'playing') {\n    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n    else {\n      ctx.fillText(`${run.score}   ·   ${Math.max(0, Math.ceil((RUN_MS - t) / 1000))} s`, W / 2, 34);\n      if (run.combo >= 5) { ctx.font = '16px system-ui'; ctx.fillText(`streak ${run.combo}`, W / 2, 60); }\n    }\n  } else {\n    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n    ctx.fillStyle = '#eef3fb';\n    ctx.fillText(run.message, W / 2, H / 2 - 80);\n    if (run.standings && hub) {\n      ctx.font = '18px system-ui';\n      let row = 0;\n      run.standings.forEach((ids, place) => ids.forEach((id) => {\n        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n        ctx.fillStyle = p.color;\n        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n      }));\n    }\n  }\n  if (menu.open) drawMenu();\n}\n\nfunction drawMenu() {\n  ctx.fillStyle = 'rgba(4,4,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n  ctx.fillText('Settings', W / 2, 286);\n  ctx.font = '18px system-ui';\n  menu.items.forEach((item, i) => {\n    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n  });\n}\n\nconnect();\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n","numLines":879,"startLine":1,"totalLines":879}},"tool_result_meta":[{"id":"toolu_01AsTqtY2pw1DGUi4PEsv3pv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
