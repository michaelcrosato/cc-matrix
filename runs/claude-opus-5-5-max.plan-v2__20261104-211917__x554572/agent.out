labs/game/view/', r'labs/game/cast/actions/']),\n 'art_base':    (15, \"Use the engine’s native style as the base\", [r\"Base: the engine's native style\"]),\n 'art_new':     (15, 'Make new art assets', [r\"make new props for what sells the hospital\"]),\n 'art_lib':     (15, 'fine for generic props', [r\"library is fine for generic props\"]),\n 'anim':        (17, 'native animation system as the base', [r\"\\*\\*Base:\\*\\* the engine's animator\", r'\\*\\*New actions\\*\\*']),\n 'audio_code':  (19, 'written in code, with no audio files', [r'written in code; no audio files']),\n 'audio_voice': (19, 'Animalese/Simlish-style gibberish', [r'\\*\\*Voices are gibberish\\*\\*, Animalese/Simlish']),\n 'audio_music': (19, 'Music is to be set to 10%', [r\"audio\\.volume\\('music', 0\\.10\\)\", r'\\*\\*Music 10%\\*\\*']),\n 'online':      (21, 'ai-hub/tree/main/lib/hub', [r'ai-hub/main/lib/hub/README\\.md']),\n 'env_folder':  (24, 'Create a subfolder', [r'subfolder TASK\\.md tells you']),\n 'env_bundle':  (24, 'develop separate modules, then bundle', [r'labs/game/tools/one-file\\.mts']),\n 'env_outside': (24, 'Do not read files outside what you need', [r'Stay in your own folder']),\n 'env_file':    (24, 'Prefer file://', [r\"Prefer `file://` and the engine's headless tools\"]),\n 'env_server':  (24, 'bind 127.0.0.1 on a port the OS picks', [r'--bind 127\\.0\\.0\\.1', r'confirm the page is your game']),\n 'env_pid':     (24, 'never pkill, killall, fuser -k', [r'never `pkill`, `killall` or `fuser -k`', r'by PID']),\n 'perf':        (26, 'Treat the performance budget as unlimited', [r'performance budget is unlimited', r'FPS targets and optimisation are out of scope']),\n 'test_cmd':    (28, 'one command that prints only failures', [r'One command: `npm run verify`', r'prints only failures and one final line']),\n 'test_play':   (28, 'scripted playthrough of the whole game', [r'Whole-game playthrough']),\n 'test_rerun':  (28, 'rerun it only after changing the code it covers', [r'Rerun it only after changing the code it covers']),\n 'test_shots':  (28, 'screenshots only for what a script', [r'screenshots only for what a script cannot check']),\n 'test_agents': (28, 'subagents or workflows to debate', [r'No subagents or workflows to debate, review, judge or audit']),\n 'display':     (37, 'needs xvfb-run', [r'xvfb-run']),\n 'browsers':    (38, 'Phone and tablet device profiles', [r'phone and tablet profiles']),\n 'secure':      (39, 'WebGPU only works on a secure page', [r'secure page']),\n 'blank':       (39, 'blank in a headless screenshot', [r'blank in headless screenshots']),\n 'pw_node':     (40, 'npm install playwright@1.63.0', [r'playwright@1\\.63\\.0']),\n 'memory':      (46, 'earlyoom', [r'earlyoom', r'Target closed']),\n 'pad':         (52, 'navigator.getGamepads', [r'navigator\\.getGamepads', r'stub pad']),\n 'touch_test':  (53, 'tap with page.touchscreen', [r'page\\.touchscreen']),\n 'listen':      (54, 'OfflineAudioContext', [r'OfflineAudioContext', r'AnalyserNode']),\n 'second':      (55, 'two browser pages', [r'two browser pages']),\n 'iphone':      (56, 'WebKit with an iPhone profile', [r'WebKit with an iPhone profile']),\n 'tv':          (57, 'screenshots at 1920×1080', [r'1920×1080']),\n 'share':       (61, 'one or two browsers', [r'one or two browsers']),\n 'files':       (62, 'Keep every file you make inside your own folder', [r'Keep your real files in your folder']),\n 'noinstall':   (63, \"don't run `playwright install`\", [r'`playwright install`']),\n 'uv':          (64, 'use uv', [r'`uv run --with']),\n 'original':    (68, 'Build an original game', [r'Build an original game']),\n 'distinct':    (72, 'world, characters, themes and tone', [r'its world, characters, themes and tone']),\n 'all_features':(72, 'show ALL features and gameplay mechanics', [r'demo shows everything']),\n 'can_cannot':  (72, 'what they can and cannot do', [r'\\*\\*Handbook', r'cannot do']),\n 'slice':       (72, 'complete, polished vertical slice'