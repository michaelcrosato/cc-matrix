{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LCyoAqhEHx6Aq6tApstHXb","type":"tool_result","content":"148:export interface Engine {\n149-  /** The inspector, also `window.__engine`; null when the scene could not start. */\n150-  readonly inspector: Inspector | null;\n151-  /** True once the first frame is drawn; never after a startup error. */\n152-  readonly ready: boolean;\n153-  /** What the query asked for; null when it could not be read. */\n154-  readonly routes: Routes | null;\n155-  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n156-  readonly ui: Overlay | null;\n157-  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n158-  readonly input: Input | null;\n159-  /** Stops the frame loop. */\n160-  stop(): void;\n161-}\n162-\n163-/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\n164-interface Asked {\n165-  playback?: Playback;\n166-  error?: unknown;\n167-}\n168-\n169-/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\n170-async function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\n171-  const load = replays?.[name];\n172-  if (!load) {\n173-    const names = Object.keys(replays ?? {}).sort();\n174-    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\n175-  }\n176-  try {\n177-    return { playback: createPlayback(JSON.parse(await load())) };\n178-  } catch (error) {\n179-    return { error };\n180-  }\n181-}\n182-\n183-/** A store that reads and writes whichever run's settings are current, for the renderer made once. */\n184-function currentSettings(run: () => AppRun): Settings {\n185-  return new Proxy({} as Settings, {\n186-    get(_, key: keyof Settings) {\n187-      const store = run().session.