{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KNhtpvYjVN1eGWchV6EF2r","type":"tool_result","content":"/**\n * @file A game's own cameras (PLAN.md WP 13.8; doctrine: Common ground: a camera is a function of input and time): the\n * registry kind `camera`. `defineCamera(name, { create })` adds a camera mode without editing the engine: its code is\n * `cam3=<name>[,…]`, which `readCameraCode` and `createCamera` (engine/gfx/cameras/place.ts) hand to `create` with the\n * camera before it, so `__engine.camera.set`, the page's switches, blends and effects (engine/gfx/cameras/rig.ts) and\n * the feel kit's camera metrics all take it. `create` returns a camera: the engine's factories make one, and\n * `followCamera(type, state, steps, { effects, fade })` (engine/gfx/cameras/chase.ts) wraps a game's own pure steps; one\n * that returns anything else is refused when the camera is made (`madeCamera`: `GFX_BAD_GAME_CAMERA`).\n *\n * Invariants: a name is a word that no engine camera or view has (`CAMERA_NAMES`); entries are frozen; cameras are view\n * state, never the sim's.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const registry = createRegistry();\n * defineCamera('low', { description: 'The shooter, lower.', create: (_code, { from }) => createShoulderCamera({ pitch: 0.2, from }) }, registry); // prettier-ignore\n * cameraEntry('low', registry)?.description; // 'The shooter, lower.'\n * @see engine/gfx/cameras/define.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { defineSchema } from '../../core/schema';\nimport { CAMERA_3D, FOLLOW_CAMERAS, VIEW_NAMES } from './codes';\nimport type { Camera, CameraPose } from './pose';\n\n/** The codes this module raises, with their fixes. */\nexport const GAME_CAMERA_CODES = defineCodes('gfx', {\n  GFX_BAD_GAME_CAMERA: {\n    template: \"the camera {name}'s create returned {value}, not a camera\",\n    fix: \"return a camera from create: one of the engine's factories (createShoulderCamera, createFollowCamera, createViewCamera, …) or followCamera(type, state, steps) over your own pure steps (engine/gfx/came\n    doc: \"Raised by `createCamera` (engine/gfx/cameras/place.ts) when a game camera's `create` (`defineCamera`) returns something without a camera's `update`, `pose`, `yaw`, `spec`, `code` and `describe`.\",\n  },\n});\n\n/** Every name the engine's cameras and views take: a game's camera takes another. */\nexport const CAMERA_NAMES: readonly string[] = Object.freeze([...VIEW_NAMES, ...CAMERA_3D, ...FOLLOW_CAMERAS]);\n\n/** A game camera's fields. */\nexport const CAMERA_FIELDS = defineSchema({\n  description: { type: 'string', default: '', description: 'What it shows, in words.' },\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n{\"keys\":[\"format\",\"scene\",\"settings\",\"seed\",\"hz\",\"steps\",\"inputs\",\"hashes\"],\"ups\":[[0,{\"cam\":0,\"game:hands\":[[0.25,0.5,3,1]]}],[26,{\"game:hands\":[[0.75,0.5,3,0]]}]],\"scene\":\"game:play\",\"count\":2}\n{ members: 8393 } []","is_error":false}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"58e66b9c-719f-4c52-a790-2fe6ed77bf93","timestamp":"2026-11-05T04:41:20.414Z","tool_use_result":{"stdout":"/**\n * @file A game's own cameras (PLAN.md WP 13.8; doctrine: Common ground: a camera is a function of input and time): the\n * registry kind `camera`. `defineCamera(name, { create })` adds a camera mode without editing the engine: its code is\n * `cam3=<name>[,…]`, which `readCameraCode` and `createCamera` (engine/gfx/cameras/place.ts) hand to `create` with the\n * camera before it, so `__engine.camera.set`, the page's switches, blends and effects (engine/gfx/cameras/rig.ts) and\n * the feel kit's camera metrics all take it. `create` returns a camera: the engine's factories make one, and\n * `followCamera(type, state, steps, { effects, fade })` (engine/gfx/cameras/chase.ts) wraps a game's own pure steps; one\n * that returns anything else is refused when the camera is made (`madeCamera`: `GFX_BAD_GAME_CAMERA`).\n *\n * Invariants: a name is a word that no engine camera or view has (`CAMERA_NAMES`); entries are frozen; cameras are view\n * state, never the sim's.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const registry = createRegistry();\n * defineCamera('low', { description: 'The shooter, lower.', create: (_code, { from }) => createShoulderCamera({ pitch: 0.2, from }) }, registry); // prettier-ignore\n * cameraEntry('low', registry)?.description; // 'The shooter, lower.'\n * @see engine/gfx/cameras/define.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { defineSchema } from '../../core/schema';\nimport { CAMERA_3D, FOLLOW_CAMERAS, VIEW_NAMES } from './codes';\nimport type { Camera, CameraPose } from './pose';\n\n/** The codes this module raises, with their fixes. */\nexport const GAME_CAMERA_CODES = defineCodes('gfx', {\n  GFX_BAD_GAME_CAMERA: {\n    template: \"the camera {name}'s create returned {value}, not a camera\",\n    fix: \"return a camera from create: one of the engine's factories (createShoulderCamera, createFollowCamera, createViewCamera, …) or followCamera(type, state, steps) over your own pure steps (engine/gfx/came\n    doc: \"Raised by `createCamera` (engine/gfx/cameras/place.ts) when a game camera's `create` (`defineCamera`) returns something without a camera's `update`, `pose`, `yaw`, `spec`, `code` and `describe`.\",\n  },\n});\n\n/** Every name the engine's cameras and views take: a game's camera takes another. */\nexport const CAMERA_NAMES: readonly string[] = Object.freeze([...VIEW_NAMES, ...CAMERA_3D, ...FOLLOW_CAMERAS]);\n\n/** A game camera's fields. */\nexport const CAMERA_FIELDS = defineSchema({\n  description: { type: 'string', default: '', description: 'What it shows, in words.' },\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n{\"keys\":[\"format\",\"scene\",\"settings\",\"seed\",\"hz\",\"steps\",\"inputs\",\"hashes\"],\"ups\":[[0,{\"cam\":0,\"game:hands\":[[0.25,0.5,3,1]]}],[26,{\"game:hands\":[[0.75,0.5,3,0]]}]],\"scene\":\"game:play\",\"count\":2}\n{ members: 8393 } []","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KNhtpvYjVN1eGWchV6EF2r","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
