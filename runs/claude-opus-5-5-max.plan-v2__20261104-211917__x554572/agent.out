* swapShoulder('cam3=shoulder,0,0,3.8'); // 'cam3=shoulder,0,0,3.8,-1': over the left shoulder\n * nextLook('look:playground-clean'); // 'look:playground-cel'\n * @see labs/playground/views.test.ts\n */\n\n/** A camera mode: its name, the camera code that opens it, and what it is for. */\nexport interface CameraMode {\n  readonly name: string;\n  readonly code: string;\n  readonly label: string;\n...\ndata/anim:\nLICENSES\nSOURCES.md\nactions\ncatalogs\ncmu\nsets\nupgrade.json\n\ndata/anim/actions:\nbackflip.json\nbored.json\ncharge.json\ndeathBlown.json\ndeathCrush.json\ndeathPop.json\ndeathShock.json\ndeathShrink.json\ndeathSink.json\ndeathSpin.json\ndeathTopple.json\ndizzy.json\ngetUp.json\ngrab.json\ngrabbed.json\ngroundPound.json\nhurt.json\nitemGet.json\njump.json\nlandHeavy.json\nlabs/box/library.ts:5: * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\nlabs/box/library.ts:13: * Invariants: the sets register sorted by directory, each once (`defineClipSet` keeps a set registered already); the\nlabs/box/library.ts:21:import { clipSetFromFiles, defineClipSet, defineMannequin, getClipSet, parseClip } from '../../engine';\nlabs/box/library.ts:33:    .map((dir) => defineClipSet(clipSetFromFiles(dirs[dir], `data/anim/sets/${dir}`)).id);\nlabs/box/library.ts:48:  defineClipSet({ set, sources: getClipSet(from).sources, clips: { [name]: parseClip(text, name) } });\n8.2M\tdata/anim/sets\nengine/gfx/resolution.ts:3: * the view setting `gfx.resolution`. `pixels` draws the engine's own chunky pixels, at most 330 lines and a whole\nengine/gfx/resolution.ts:35: * // resolution.prefer('full'); // the look's mode, drawn while gfx.resolution is 'auto'\nengine/gfx/resolution.ts:36: * @see engine/gfx/resolution.test.ts\nengine/gfx/resolution.ts:48:/** What `gfx.resolution` takes: `auto` (the look's mode, else `pixels`), or a mode held whatever the look asks. */\nengine/gfx/resolution.ts:59:  'gfx.resolution': {\ne