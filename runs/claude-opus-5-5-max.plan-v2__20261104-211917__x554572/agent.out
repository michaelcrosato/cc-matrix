{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019TPAt5edcMe8KUj8Yya5Xs","type":"tool_result","content":"const EVERY_NAME = '^';\nconst THREE = {\n  regex: '^three(?:/|$)',\n  importNamePattern: EVERY_NAME,\n  message: `game code reaches three.js through the barrels: its math classes (${THREE_MATH.join(', ')}) from engine/sim-api.ts, AnimationClip and AnimationMixer from engine/index.ts; for anything else, the barrel gains a documented re-export (PLAN.md §6.1)`,\n};\nconst RAPIER = {\n  regex: '^@dimforge/',\n  importNamePattern: EVERY_NAME,\n  message:\n    'game code reaches physics through engine/sim-api.ts (bodies, queries), never Rapier itself (PLAN.md §6.1, ADR-0020)',\n};\n\n/** The public-API blocks; `on` is `SWITCHES.publicApi` (on since WP 1.6). */\nexport function publicApiBlocks(on: boolean): Linter.Config[] {\n  const severity = on ? 'error' : 'off';\n  const block = (name: string, files: string[], ignores: string[], allowed: string, where: string): Linter.Config => {\n    const internal = `(?:/(?!(?:${allowed})(?:\\\\.ts)?$).*)`; // a path under engine/ other than an allowed barrel\n    const folder = allowed.split('|').includes('index'); // `engine` alone is engine/index.ts: refused unless allowed\n    const patterns = [\n      {\n        regex: `^(?:\\\\.\\\\./)+engine${internal}${folder ? '' : '?'}$`,\n        importNamePattern: EVERY_NAME,\n        caseSensitive: true,\n        message: `${where}: import it from ${allowed === 'sim-api' ? 'engine/sim-api.ts' : 'engine/index.ts (pages) or engine/sim-api.ts (sim-side code)'} under the same name; if the barrel lacks it, add the re-export there with its doc comment (PLAN.md §6.1, ADR-0020)`,\n      },\n      { ...THREE, caseSensitive: true },\n      { ...RAPIER, caseSensitive: true },\n    ];\n    return {\n      name,\n      files,\n      ignores: ['**/*.test.ts', ...ignores],\n      plugins: { 'public-api': publicApiPlugin },\n      rules: {\n        'public-api/no-restricted-imports': [severity, { patterns }],\n        'public-api/no-unnamed-imports': [\n          severity,\n          { patterns: patterns.map(({ regex, message }) => ({ regex, message })) },\n        ],\n      },\n    };\n  };\n  return [\n    block(\n      'public-api: game code',\n      ['labs/**'],\n      ['labs/hello/**'],\n      'index|sim-api',\n      'game code imports the engine only through its barrels',\n    ),\n    block(\n      'public-api: sim-side game code',\n      SIM_SIDE_GAME_CODE,\n      [],\n      'sim-api',\n      'sim-side game code imports only the sim barrel, so x sim runs it in Node',\n    ),\n  ];\n}\n....\nlabs/anim:\nindex.html\nmain.ts\noverlay.ts\nscenes\n\nlabs/cameras:\nindex.html\nmain.ts\n\nlabs/fx:\nindex.html\nmain.ts\n\nlabs/hello:\nboot.ts\nhello.ts\nindex.html\n\nlabs/index:\ngallery.ts\nindex.html\nlab.css\nlab.ts\nlabs.ts\nmain.ts\n\nlabs/library:\nindex.html\nmain.ts\n\nlabs/materials:\nindex.html\nmain.ts\n\nlabs/physics:\nindex.html\nmain.ts\n\nlabs/props:\nindex.html\nmain.ts\n....\n14:import { galleryLab } from '../index/gallery';\n...\n17:  help: 'Whether the engine is up: a page once its first frame is drawn, headless at once; false after a startup error.',\n23:  help: \"Draws n frames of the current state now, without stepping; resolves with the last frame's report (drawn, built, alpha).\",\n30:  help: 'Renders the view into a target and reads it back: the ID pass, look metrics, thumbnail, marks or pixels as asked; resolves with plain JSON.',\n44:  help: 'The camera: its code (cam=iso), what it shows in words, its type, heading and pose.',\n49:  help: 'Switches to the camera a code names (cam=topdown, cam=iso,45,2, cam3=shoulder, cam3=fly) at once, or blending over cam.blend seconds with { blend: true } as the page\\'s live switches do; view only, never recorded; returns camera.get().', // prettier-ignore\n58:  help: \"Moves the camera on by n frames of 1/60 s, drawing nothing and never stepping, as a page's frames move i