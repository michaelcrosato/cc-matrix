{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9gFzRc25FxoKSBAKkA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01S1G3zS3HSk9yJGZV8WmwZC","name":"Bash","input":{"command":"sed -n 1,60p engine/gfx/puppets/rigBody.ts; echo ....; sed -n 1,50p engine/sim/crowdBodies.ts; echo ....; sed -n 1,40p engine/gfx/stageCrowd.ts; echo ....; sed -n 1,80p engine/gfx/materials/material.ts | sed -n 1,80p; grep -n \"PROP_BODY\\|type: *{\\|enum\" engine/world/props/prop.ts | head -20; sed -n 70,190p engine/world/props/prop.ts | grep -n \"body\\|kinematic\\|none\\|scale\" | head -20","description":"Read rig bodies, crowd bodies, stage crowd, material and prop body fields"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16873,"cache_read_input_tokens":248570,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16873},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"ef83ca4c-b435-417b-928f-15fc55888771","timestamp":"2026-11-05T04:29:09.893Z","request_id":"req_011Cgj9gFfKfHkyNPbi9GvZY","wire_tool_inputs":{"toolu_01S1G3zS3HSk9yJGZV8WmwZC":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/engine && sed -n 1,60p engine/gfx/puppets/rigBody.ts; echo ....; sed -n 1,50p engine/sim/crowdBodies.ts; echo ....; sed -n 1,40p engine/gfx/stageCrowd.ts; echo ....; sed -n 1,80p engine/gfx/materials/material.ts | sed -n 1,80p; grep -n \"PROP_BODY\\|type: *{\\|enum\" engine/world/props/prop.ts | head -20; sed -n 70,190p engine/world/props/prop.ts | grep -n \"body\\|kinematic\\|none\\|scale\" | head -20","description":"Read rig bodies, crowd bodies, stage crowd, material and prop body fields"}},"wire_ingest_context":{"toolu_01S1G3zS3HSk9yJGZV8WmwZC":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211917__x554572/work/.scratch/engine"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S1G3zS3HSk9yJGZV8WmwZC","type":"tool_result","content":"/**\n * @file Rig bodies (PLAN.md WP 5.4, I-21): the data form in which a rig (a blob, a floater, a quadruped: engine/anim/)\n * wears its body, as `createCrowd` draws it (engine/gfx/puppets/crowd.ts `rig`). A rig body (`RigBody`) has material\n * slots, each a name with its colour, and parts, each a unit shape (compile.ts's file comment; any but the limb) on\n * one joint of the rig's pose (`RigJoints`: a matrix, a point or a list of points), placed and sized as `RigPart`\n * says. The bodies themselves are data in engine/gfx/puppets/bodies/ (`BLOB_BODY`, `FLOATER_BODY`, `QUADRUPED_BODY`).\n * Split from crowd.ts at its size cap (WP 11.4); crowd.ts re-exports the types, so its importers are as they were.\n *\n * Invariants: types only, no code: a rig body's problems are found when the crowd first draws it (`GFX_RIG_BODY`).\n *\n * @example\n * // const dot: RigBody = { name: 'dot', description: 'A ball.', slots: { skin: '#ffffff' },\n * //   parts: [{ shape: 'ball', on: 'core', size: 0.1, slot: 'skin' }] };\n * @see engine/gfx/puppets/crowd.test.ts\n */\nimport type { Matrix4, Vector3 } from 'three/webgpu';\nimport type { PieceShape } from './compile';\n\n/** A unit shape a rig part draws: any but the limb. */\nexport type RigShape = Exclude<PieceShape, 'limb'>;\n\ntype Vec3 = readonly [number, number, number];\n\n/**\n * One part of a rig body: a unit shape (compile.ts's file comment) on one joint of the rig's pose, a matrix, a point\n * or a list of points (one part on each). It sits at `at` in the joint's frame, through the joint's whole matrix,\n * points `toward` a direction and has a `size` in metres: it turns with the joint but keeps its size, scaled only by\n * the rig's `scale` (a blob's radius over its body's), unless it `stretch`es through the joint's scale too (a\n * squashing body), when its size is in the joint's units. `eye` parts are unlit (the body's glow material); a part\n * with a `material` of its own draws in a batch of its own; `when` and `unless` name the rig's flags (`squint`).\n */\nexport interface RigPart {\n  /** Its unit shape; `eye` is drawn unlit. */\n  readonly shape: RigShape;\n  /** The joint it rides: a key of the rig's pose. */\n  readonly on: string;\n  /** Its origin in the joint's frame, through the joint's whole matrix (the joint's origin by default). */\n  readonly at?: Vec3;\n  /** Its size along x, y and z (one number for all three): metres, or with `stretch` the joint's units. */\n  readonly size: number | Vec3;\n  /** Where its +Y points, in the joint's frame (+Y by default). */\n  readonly toward?: Vec3;\n  /** Sized by the joint's scale too. */\n  readonly stretch?: boolean;\n  readonly slot: string;\n  /** A material id of its own: drawn in a batch of its own, casting no shadow. */\n  readonly material?: string;\n  /** Drawn only while this flag of the rig is on. */\n  readonly when?: string;\n  /** Drawn only while this flag of the rig is off. */\n  readonly unless?: string;\n}\n\n/** A rig body (see the file comment): its slots and parts, and the materials and shadow it is drawn with. */\nexport interface RigBody {\n  /** Its name, for messages. */\n  readonly name: string;\n  readonly description: string;\n  /** Material slots: each name with its hex colour. */\n  readonly slots: Readonly<Record<string, string>>;\n....\n/**\n * @file Crowd bodies, sim-side (PLAN.md WP 5.7 core proposal, ADR-0008 amendment 6; §6.4; ADR-0009): what a member of\n * a crowd looks like, and its rig's step. An entity with the component `crowdBody` (`CROWD_BODY_FIELDS`) names its rig\n * (a humanoid in a build, a blob, a floater, a quadruped), where it stands and the rig's state as plain data; the\n * stage draws it\n * through a crowd (engine/gfx/stageCrowd.ts: instanced batches, each body posed at its band's detail), instead of a\n * stand-in.\n *\n * `stepCrowdBody(w, id, body, input)` is the rig's sim step (ADR-0009's `anim.step`: every tick, part of the hash),\n * for a system in the phase `anim`: it loads the rig from `body.state`, steps it with `input` and saves it back, and\n * moves the body to `input.at`. A humanoid's is its animator's (engine/anim/character.ts: the body states, its\n * breathing phase drawn from `rng.entity(id, 'anim')` at its first step, as an actor's); a blob's and a floater's are\n * theirs (engine/anim/blob.ts, floater.ts), the floater's clock spread from the same stream; a quadruped's is its own\n * (engine/anim/quadruped.ts, WP 13.21: its clock spread so, its feet on the world's ground where the world has\n * physics, a raycast through the group `world`, `crowdGround`). The first step fills an\n * empty `state` (a spawned body's default) with the rig at rest, turned to `body.yaw`. The rigs are pooled per world\n * and loaded at every step, so they keep no state of their own: a restore continues exactly.\n *\n * - `rig`: `humanoid` (its `look` is a build id, `build:chibi` when empty), `blob` (its `look` names its features:\n *   `horns`, `ears` or `wings`, none when empty; `size` its radius at rest, `BLOB.radius` when 0), `floater` or\n *   `quadruped` (told `input.quadruped`: to sit, what to look at and how hard to wag).\n * - `x`, `y`, `z` (m): a humanoid's, a blob's or a quadruped's feet, a floater's core; `yaw` (rad): where it faces\n *   (a humanoid's from `input.yaw`, a blob's look, a floater's and a quadruped's heading from their rigs).\n *\n * Invariants: everything a crowd body is in the sim is its component; the step writes only the component; footsteps\n * are not emitted (a crowd's would flood the events). The view poses rigs it loads from the component and never\n * writes it, so drawing, LOD and culling never change the hash.\n *\n * @example\n * import { createWorld } from './world';\n * const w = createWorld({ seed: 1 });\n * const id = w.spawn({ crowdBody: { rig: 'blob', x: 2, z: 3 } });\n * const body = w.get(id)!.crowdBody as CrowdBody;\n * w.run((w) => stepCrowdBody(w, id, body, { at: [2, 0, 3.05], velocity: [0, 0, 3] })); // a slime hopping south\n * [body.z, body.yaw]; // [3.05, 0]: moved, looking south\n * (body.state as { squash: number }).squash; // 0: the blob's state, at rest\n * @see engine/sim/crowdBodies.test.ts\n */\nimport { AnimatorPool, ANIMATOR_FIELDS, type AnimatorData } from '../anim/character';\nimport { Blob, type BlobInput, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\nimport type { GaitProbe } from '../anim/proc/gait';\nimport { Quadruped, type QuadrupedState } from '../anim/quadruped';\nimport { STEP } from '../anim/humanoidRates';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { copyValue, defineSchema } from '../core/schema';\nimport { hasPhysics, physicsOf } from '../physics/binding';\nimport type { Vec3Like } from '../physics/queries';\n....\n/**\n * @file Crowd bodies on the stage (PLAN.md WP 5.7 core proposal, ADR-0008 amendment 6; §6.4's view; I-21): every\n * entity with the component `crowdBody` (engine/sim/crowdBodies.ts: a humanoid, blob, floater or quadruped rig, where it stands\n * and its rig's state) drawn through a crowd (engine/gfx/puppets/crowd.ts: instanced batches, a few dozen draw calls\n * for thousands), seen through the crowd's level of detail (engine/gfx/puppets/lod.ts) from the frame's camera. The\n * stage (engine/gfx/stage.ts) draws these instead of stand-ins.\n *\n * `capture(entities, dt)` after each sim step keeps each crowd body's last two places (where it stands and faces) and\n * its component, and returns the ids it draws. `draw(alpha, camera)`, once the frame's camera is placed, puts each\n * body `alpha` of the way from its place a step ago to its last and asks the crowd whether the camera sees it: only a\n * seen body is posed (the view's half of its rig, loaded from the component: a humanoid's animator at its band's\n * detail, `animator.pose({ lod })`; a blob, a floater or a quadruped from its state alone) and drawn, a blob shadow\n * under each humanoid, blob and quadruped on the level's floor. Humanoids wear the neutral humanoid (`body:humanoid`)\n * in their build, blobs `BLOB_BODY` with their features (`blobBody`), floaters `FLOATER_BODY`, quadrupeds\n * `QUADRUPED_BODY` (the dog).\n *\n * The crowd is made when the first crowd body arrives, and added to the stage's scene then: a stage with none has\n * none, and its scene graph is the one it had before. Each look is prepared (its batches made) when the first body\n * wearing it arrives; `register` registers the crowd's batches, present and future, with the warm-up and adds the\n * prepared looks to the shader key, so the frame after a new look arrives warms up first instead of stalling, and a\n * crowd growing in a look it has already built builds no pipeline (its new pages share their batch's shader).\n * Given the renderer's features with `feature:gpuCrowds` on (engine/gfx/features.ts `gpuCrowdsFor`, WP 11.4),\n * `register` makes the crowd again, drawn through a GPU crowd (engine/gfx/enhanced/crowds.ts) sized for the bodies held\n * then; a frame that outgrows it makes it again twice as large and draws again, its size in the shader key, so the\n * renderer warms up before the larger one draws. Headless, or with the feature off, the instancing service draws.\n *\n * Invariants: presentation only (doctrine: WebGPU only): it reads the components and writes nothing back; its rigs\n * are its own, loaded from the component at every pose, so drawing, LOD, culling or not drawing never changes the\n * hash; every object it makes is under the crowd's root.\n *\n * @example\n * // const crowd = createStageCrowd({ scene: stage.scene, materials: library, level });\n * // const drawn = crowd.capture(world.query('crowdBody'), world.dt); // the ids drawn as crowd bodies\n * // crowd.draw(0.5, camera); // halfway between the last two steps, as the camera sees them\n * @see engine/gfx/stageCrowd.test.ts\n */\nimport { type Camera, type Material, type Scene } from 'three/webgpu';\nimport { AnimatorPool, type AnimatorData } from '../anim/character';\nimport { Blob, BLOB, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\n....\n/**\n * @file The material registry (PLAN.md WP 2.3, §6.6, §6.7, I-49): the registry kind `material`, one entry per\n * material, as data with the parameters agents know from three.js's classic materials: `color`, `map`, `roughness`,\n * `metalness`, `emissive`, `emissiveIntensity`, `normalScale`, `opacity`, `transparent`, `alphaTest`, `side`,\n * `flatShading`, `vertexColors`, `fog`, `depthWrite`, plus `unlit` (glTF's word: drawn without lights). How a\n * material is drawn is the engine's business (engine/gfx/materials/compile.ts): v1 compiles the same data to\n * `MeshLambertMaterial` or `MeshBasicMaterial`, later WPs to better node materials and styles (WP 7.2), without the\n * data changing (doctrine: Common ground outside, Quality under the hood inside).\n *\n * `map` names a texture generator (engine/gfx/textures/texture.ts): an id (`'texture:brick'`) or\n * `{ texture, seed, params, size, look, repeat }`. One generator fills every slot: its colour is the `map`, its\n * height the normal map (scaled by `normalScale`), its roughness the roughness map (used by styles that shade with\n * roughness) and its emissive the emissive map.\n *\n * `defineMaterial(id, spec)` adds one (a game's own materials live with the game); `materialKind(registry)` declares\n * the kind with the engine's built-in materials (engine/gfx/materials/builtins.ts), and `material:default` stands in,\n * with a warning, for a missing id.\n *\n * Invariants: colours are hex strings; a map's texture exists when the material is defined (define textures\n * first), and its parameters, size, look and repeat are checked then, so a bad map fails at `defineMaterial`, never\n * at the first frame. Problems raise `CORE_BAD_SPEC` naming each, as every registry kind does.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const reg = createRegistry();\n * defineMaterial('material:mossyBrick', { color: '#c8d8b0', map: { texture: 'texture:brick', seed: 4 } }, reg);\n * reg.get('material', 'material:mossyBrick').roughness; // 1, the default\n * textureRefOf(reg.get('material', 'material:mossyBrick').map); // { texture: 'texture:brick', seed: 4, … }\n * @see engine/gfx/materials/material.test.ts\n */\nimport { hex } from '../../core/color';\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { isPlainObject, type Schema, type SpecOf } from '../../core/schema';\nimport { textureSampler, type TextureRef } from '../textures/bake';\nimport { textureKind } from '../textures/texture';\nimport type { TextureLook } from '../textures/types';\nimport { BUILT_IN_MATERIALS } from './builtins';\n\n/** The fields of a `material` entry: three.js's classic material parameters, as data. */\nexport const MATERIAL_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is for, in plain sentences.' },\n  color: {\n    type: 'string',\n    default: '#ffffff',\n    description: \"The base colour, hex; it multiplies the map (three.js's color).\",\n  },\n  map: {\n    type: 'any',\n    default: null,\n    description:\n      \"The texture generator that fills the maps: a texture id ('texture:brick'), or { texture, seed, params, size, look, repeat }; null for none. Its height becomes the normal map, its roughness the roughness map, its emissive the emissive map.\",\n  },\n  roughness: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 1,\n    description: 'Microfacet roughness, 0 (mirror) to 1 (matte), for the styles that shade with it (pbr, WP 7.2).',\n  },\n  metalness: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 1,\n    description: 'How metallic, 0 to 1, for the styles that shade with it (pbr, WP 7.2).',\n  },\n  emissive: {\n    type: 'string',\n    default: '#000000',\n    description:\n      \"The colour it glows with, hex, unaffected by light; it multiplies the map's emissive, as three.js's emissiveMap does (write '#ffffff' to show a glowing texture as baked).\",\n  },\n  emissiveIntensity: { type: 'number', default: 1, minimum: 0, description: 'A multiplier on emissive.' },\n  normalScale: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 8,\n    description: \"How deep the map's relief looks: scales the normal map from its height (0 turns it off).\",\n113:  type: {\n115:    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n120:  shape: { type: 'string', enum: PROP_SHAPES, default: 'box', description: 'Its shape.' },\n18:    description: \"A material for its tops and bottoms (faces within 45° of up or down: a barrel's lids); '' for none.\",\n39:/** The physics shapes a prop's body may have, sized as three.js sizes its geometries. */\n42:/** The fields of a prop's body: its type, its shape and its material (engine/physics/bodies.ts's PROP_MATERIAL). */\n46:    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n47:    default: 'none',\n49:      \"'dynamic' falls, slides and is knocked; 'fixed' stands where it is placed and blocks; 'kinematic' moves only as the sim drives it (a door on its hinge, WP 13.16); 'none' has none.\",\n70:  tag: { type: 'string', default: '', description: \"What kind of light it is ('torch'); '' for none.\" },\n81:  into: { type: 'string', default: '', description: \"The prop its pieces are ('prop:<id>', dynamic); '' none.\" },\n95:    description: \"The spawn name whose points place it, on their floor (a glyph with spawn: 'crate'); '' none.\",\n100:    description: \"The light-spot tag whose spots place it, on the top of the spot's tile ('torch'); '' none.\",\n113:  body: {\n116:    description: 'Its body in the physics world, standing on its base: { type, shape, size, radius, height, … }.',","is_error":false}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"31719ab3-221f-4bbc-8804-eec4939deee6","timestamp":"2026-11-05T04:29:09.940Z","tool_use_result":{"stdout":"/**\n * @file Rig bodies (PLAN.md WP 5.4, I-21): the data form in which a rig (a blob, a floater, a quadruped: engine/anim/)\n * wears its body, as `createCrowd` draws it (engine/gfx/puppets/crowd.ts `rig`). A rig body (`RigBody`) has material\n * slots, each a name with its colour, and parts, each a unit shape (compile.ts's file comment; any but the limb) on\n * one joint of the rig's pose (`RigJoints`: a matrix, a point or a list of points), placed and sized as `RigPart`\n * says. The bodies themselves are data in engine/gfx/puppets/bodies/ (`BLOB_BODY`, `FLOATER_BODY`, `QUADRUPED_BODY`).\n * Split from crowd.ts at its size cap (WP 11.4); crowd.ts re-exports the types, so its importers are as they were.\n *\n * Invariants: types only, no code: a rig body's problems are found when the crowd first draws it (`GFX_RIG_BODY`).\n *\n * @example\n * // const dot: RigBody = { name: 'dot', description: 'A ball.', slots: { skin: '#ffffff' },\n * //   parts: [{ shape: 'ball', on: 'core', size: 0.1, slot: 'skin' }] };\n * @see engine/gfx/puppets/crowd.test.ts\n */\nimport type { Matrix4, Vector3 } from 'three/webgpu';\nimport type { PieceShape } from './compile';\n\n/** A unit shape a rig part draws: any but the limb. */\nexport type RigShape = Exclude<PieceShape, 'limb'>;\n\ntype Vec3 = readonly [number, number, number];\n\n/**\n * One part of a rig body: a unit shape (compile.ts's file comment) on one joint of the rig's pose, a matrix, a point\n * or a list of points (one part on each). It sits at `at` in the joint's frame, through the joint's whole matrix,\n * points `toward` a direction and has a `size` in metres: it turns with the joint but keeps its size, scaled only by\n * the rig's `scale` (a blob's radius over its body's), unless it `stretch`es through the joint's scale too (a\n * squashing body), when its size is in the joint's units. `eye` parts are unlit (the body's glow material); a part\n * with a `material` of its own draws in a batch of its own; `when` and `unless` name the rig's flags (`squint`).\n */\nexport interface RigPart {\n  /** Its unit shape; `eye` is drawn unlit. */\n  readonly shape: RigShape;\n  /** The joint it rides: a key of the rig's pose. */\n  readonly on: string;\n  /** Its origin in the joint's frame, through the joint's whole matrix (the joint's origin by default). */\n  readonly at?: Vec3;\n  /** Its size along x, y and z (one number for all three): metres, or with `stretch` the joint's units. */\n  readonly size: number | Vec3;\n  /** Where its +Y points, in the joint's frame (+Y by default). */\n  readonly toward?: Vec3;\n  /** Sized by the joint's scale too. */\n  readonly stretch?: boolean;\n  readonly slot: string;\n  /** A material id of its own: drawn in a batch of its own, casting no shadow. */\n  readonly material?: string;\n  /** Drawn only while this flag of the rig is on. */\n  readonly when?: string;\n  /** Drawn only while this flag of the rig is off. */\n  readonly unless?: string;\n}\n\n/** A rig body (see the file comment): its slots and parts, and the materials and shadow it is drawn with. */\nexport interface RigBody {\n  /** Its name, for messages. */\n  readonly name: string;\n  readonly description: string;\n  /** Material slots: each name with its hex colour. */\n  readonly slots: Readonly<Record<string, string>>;\n....\n/**\n * @file Crowd bodies, sim-side (PLAN.md WP 5.7 core proposal, ADR-0008 amendment 6; §6.4; ADR-0009): what a member of\n * a crowd looks like, and its rig's step. An entity with the component `crowdBody` (`CROWD_BODY_FIELDS`) names its rig\n * (a humanoid in a build, a blob, a floater, a quadruped), where it stands and the rig's state as plain data; the\n * stage draws it\n * through a crowd (engine/gfx/stageCrowd.ts: instanced batches, each body posed at its band's detail), instead of a\n * stand-in.\n *\n * `stepCrowdBody(w, id, body, input)` is the rig's sim step (ADR-0009's `anim.step`: every tick, part of the hash),\n * for a system in the phase `anim`: it loads the rig from `body.state`, steps it with `input` and saves it back, and\n * moves the body to `input.at`. A humanoid's is its animator's (engine/anim/character.ts: the body states, its\n * breathing phase drawn from `rng.entity(id, 'anim')` at its first step, as an actor's); a blob's and a floater's are\n * theirs (engine/anim/blob.ts, floater.ts), the floater's clock spread from the same stream; a quadruped's is its own\n * (engine/anim/quadruped.ts, WP 13.21: its clock spread so, its feet on the world's ground where the world has\n * physics, a raycast through the group `world`, `crowdGround`). The first step fills an\n * empty `state` (a spawned body's default) with the rig at rest, turned to `body.yaw`. The rigs are pooled per world\n * and loaded at every step, so they keep no state of their own: a restore continues exactly.\n *\n * - `rig`: `humanoid` (its `look` is a build id, `build:chibi` when empty), `blob` (its `look` names its features:\n *   `horns`, `ears` or `wings`, none when empty; `size` its radius at rest, `BLOB.radius` when 0), `floater` or\n *   `quadruped` (told `input.quadruped`: to sit, what to look at and how hard to wag).\n * - `x`, `y`, `z` (m): a humanoid's, a blob's or a quadruped's feet, a floater's core; `yaw` (rad): where it faces\n *   (a humanoid's from `input.yaw`, a blob's look, a floater's and a quadruped's heading from their rigs).\n *\n * Invariants: everything a crowd body is in the sim is its component; the step writes only the component; footsteps\n * are not emitted (a crowd's would flood the events). The view poses rigs it loads from the component and never\n * writes it, so drawing, LOD and culling never change the hash.\n *\n * @example\n * import { createWorld } from './world';\n * const w = createWorld({ seed: 1 });\n * const id = w.spawn({ crowdBody: { rig: 'blob', x: 2, z: 3 } });\n * const body = w.get(id)!.crowdBody as CrowdBody;\n * w.run((w) => stepCrowdBody(w, id, body, { at: [2, 0, 3.05], velocity: [0, 0, 3] })); // a slime hopping south\n * [body.z, body.yaw]; // [3.05, 0]: moved, looking south\n * (body.state as { squash: number }).squash; // 0: the blob's state, at rest\n * @see engine/sim/crowdBodies.test.ts\n */\nimport { AnimatorPool, ANIMATOR_FIELDS, type AnimatorData } from '../anim/character';\nimport { Blob, type BlobInput, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\nimport type { GaitProbe } from '../anim/proc/gait';\nimport { Quadruped, type QuadrupedState } from '../anim/quadruped';\nimport { STEP } from '../anim/humanoidRates';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { copyValue, defineSchema } from '../core/schema';\nimport { hasPhysics, physicsOf } from '../physics/binding';\nimport type { Vec3Like } from '../physics/queries';\n....\n/**\n * @file Crowd bodies on the stage (PLAN.md WP 5.7 core proposal, ADR-0008 amendment 6; §6.4's view; I-21): every\n * entity with the component `crowdBody` (engine/sim/crowdBodies.ts: a humanoid, blob, floater or quadruped rig, where it stands\n * and its rig's state) drawn through a crowd (engine/gfx/puppets/crowd.ts: instanced batches, a few dozen draw calls\n * for thousands), seen through the crowd's level of detail (engine/gfx/puppets/lod.ts) from the frame's camera. The\n * stage (engine/gfx/stage.ts) draws these instead of stand-ins.\n *\n * `capture(entities, dt)` after each sim step keeps each crowd body's last two places (where it stands and faces) and\n * its component, and returns the ids it draws. `draw(alpha, camera)`, once the frame's camera is placed, puts each\n * body `alpha` of the way from its place a step ago to its last and asks the crowd whether the camera sees it: only a\n * seen body is posed (the view's half of its rig, loaded from the component: a humanoid's animator at its band's\n * detail, `animator.pose({ lod })`; a blob, a floater or a quadruped from its state alone) and drawn, a blob shadow\n * under each humanoid, blob and quadruped on the level's floor. Humanoids wear the neutral humanoid (`body:humanoid`)\n * in their build, blobs `BLOB_BODY` with their features (`blobBody`), floaters `FLOATER_BODY`, quadrupeds\n * `QUADRUPED_BODY` (the dog).\n *\n * The crowd is made when the first crowd body arrives, and added to the stage's scene then: a stage with none has\n * none, and its scene graph is the one it had before. Each look is prepared (its batches made) when the first body\n * wearing it arrives; `register` registers the crowd's batches, present and future, with the warm-up and adds the\n * prepared looks to the shader key, so the frame after a new look arrives warms up first instead of stalling, and a\n * crowd growing in a look it has already built builds no pipeline (its new pages share their batch's shader).\n * Given the renderer's features with `feature:gpuCrowds` on (engine/gfx/features.ts `gpuCrowdsFor`, WP 11.4),\n * `register` makes the crowd again, drawn through a GPU crowd (engine/gfx/enhanced/crowds.ts) sized for the bodies held\n * then; a frame that outgrows it makes it again twice as large and draws again, its size in the shader key, so the\n * renderer warms up before the larger one draws. Headless, or with the feature off, the instancing service draws.\n *\n * Invariants: presentation only (doctrine: WebGPU only): it reads the components and writes nothing back; its rigs\n * are its own, loaded from the component at every pose, so drawing, LOD, culling or not drawing never changes the\n * hash; every object it makes is under the crowd's root.\n *\n * @example\n * // const crowd = createStageCrowd({ scene: stage.scene, materials: library, level });\n * // const drawn = crowd.capture(world.query('crowdBody'), world.dt); // the ids drawn as crowd bodies\n * // crowd.draw(0.5, camera); // halfway between the last two steps, as the camera sees them\n * @see engine/gfx/stageCrowd.test.ts\n */\nimport { type Camera, type Material, type Scene } from 'three/webgpu';\nimport { AnimatorPool, type AnimatorData } from '../anim/character';\nimport { Blob, BLOB, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\n....\n/**\n * @file The material registry (PLAN.md WP 2.3, §6.6, §6.7, I-49): the registry kind `material`, one entry per\n * material, as data with the parameters agents know from three.js's classic materials: `color`, `map`, `roughness`,\n * `metalness`, `emissive`, `emissiveIntensity`, `normalScale`, `opacity`, `transparent`, `alphaTest`, `side`,\n * `flatShading`, `vertexColors`, `fog`, `depthWrite`, plus `unlit` (glTF's word: drawn without lights). How a\n * material is drawn is the engine's business (engine/gfx/materials/compile.ts): v1 compiles the same data to\n * `MeshLambertMaterial` or `MeshBasicMaterial`, later WPs to better node materials and styles (WP 7.2), without the\n * data changing (doctrine: Common ground outside, Quality under the hood inside).\n *\n * `map` names a texture generator (engine/gfx/textures/texture.ts): an id (`'texture:brick'`) or\n * `{ texture, seed, params, size, look, repeat }`. One generator fills every slot: its colour is the `map`, its\n * height the normal map (scaled by `normalScale`), its roughness the roughness map (used by styles that shade with\n * roughness) and its emissive the emissive map.\n *\n * `defineMaterial(id, spec)` adds one (a game's own materials live with the game); `materialKind(registry)` declares\n * the kind with the engine's built-in materials (engine/gfx/materials/builtins.ts), and `material:default` stands in,\n * with a warning, for a missing id.\n *\n * Invariants: colours are hex strings; a map's texture exists when the material is defined (define textures\n * first), and its parameters, size, look and repeat are checked then, so a bad map fails at `defineMaterial`, never\n * at the first frame. Problems raise `CORE_BAD_SPEC` naming each, as every registry kind does.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const reg = createRegistry();\n * defineMaterial('material:mossyBrick', { color: '#c8d8b0', map: { texture: 'texture:brick', seed: 4 } }, reg);\n * reg.get('material', 'material:mossyBrick').roughness; // 1, the default\n * textureRefOf(reg.get('material', 'material:mossyBrick').map); // { texture: 'texture:brick', seed: 4, … }\n * @see engine/gfx/materials/material.test.ts\n */\nimport { hex } from '../../core/color';\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { isPlainObject, type Schema, type SpecOf } from '../../core/schema';\nimport { textureSampler, type TextureRef } from '../textures/bake';\nimport { textureKind } from '../textures/texture';\nimport type { TextureLook } from '../textures/types';\nimport { BUILT_IN_MATERIALS } from './builtins';\n\n/** The fields of a `material` entry: three.js's classic material parameters, as data. */\nexport const MATERIAL_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is for, in plain sentences.' },\n  color: {\n    type: 'string',\n    default: '#ffffff',\n    description: \"The base colour, hex; it multiplies the map (three.js's color).\",\n  },\n  map: {\n    type: 'any',\n    default: null,\n    description:\n      \"The texture generator that fills the maps: a texture id ('texture:brick'), or { texture, seed, params, size, look, repeat }; null for none. Its height becomes the normal map, its roughness the roughness map, its emissive the emissive map.\",\n  },\n  roughness: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 1,\n    description: 'Microfacet roughness, 0 (mirror) to 1 (matte), for the styles that shade with it (pbr, WP 7.2).',\n  },\n  metalness: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 1,\n    description: 'How metallic, 0 to 1, for the styles that shade with it (pbr, WP 7.2).',\n  },\n  emissive: {\n    type: 'string',\n    default: '#000000',\n    description:\n      \"The colour it glows with, hex, unaffected by light; it multiplies the map's emissive, as three.js's emissiveMap does (write '#ffffff' to show a glowing texture as baked).\",\n  },\n  emissiveIntensity: { type: 'number', default: 1, minimum: 0, description: 'A multiplier on emissive.' },\n  normalScale: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 8,\n    description: \"How deep the map's relief looks: scales the normal map from its height (0 turns it off).\",\n113:  type: {\n115:    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n120:  shape: { type: 'string', enum: PROP_SHAPES, default: 'box', description: 'Its shape.' },\n18:    description: \"A material for its tops and bottoms (faces within 45° of up or down: a barrel's lids); '' for none.\",\n39:/** The physics shapes a prop's body may have, sized as three.js sizes its geometries. */\n42:/** The fields of a prop's body: its type, its shape and its material (engine/physics/bodies.ts's PROP_MATERIAL). */\n46:    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n47:    default: 'none',\n49:      \"'dynamic' falls, slides and is knocked; 'fixed' stands where it is placed and blocks; 'kinematic' moves only as the sim drives it (a door on its hinge, WP 13.16); 'none' has none.\",\n70:  tag: { type: 'string', default: '', description: \"What kind of light it is ('torch'); '' for none.\" },\n81:  into: { type: 'string', default: '', description: \"The prop its pieces are ('prop:<id>', dynamic); '' none.\" },\n95:    description: \"The spawn name whose points place it, on their floor (a glyph with spawn: 'crate'); '' none.\",\n100:    description: \"The light-spot tag whose spots place it, on the top of the spot's tile ('torch'); '' none.\",\n113:  body: {\n116:    description: 'Its body in the physics world, standing on its base: { type, shape, size, radius, height, … }.',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01S1G3zS3HSk9yJGZV8WmwZC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
