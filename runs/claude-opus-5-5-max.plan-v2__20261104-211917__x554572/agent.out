yback.test.ts:108:    const run = await playInto({ ...played, shoot }, text('kernel-movers'), { until: 5, views });\nengine/app/playback.test.ts:110:    expect((await playInto(played, text('kernel-movers'), { until: 5, views })).shots).toBeUndefined(); // no shoot: headless\nengine/app/playback.test.ts:115:    await expect(playInto(target().played, text('kernel-movers'), { views })).rejects.toThrow(/APP_PLAY_SETTING/);\nengine/app/playback.test.ts:117:    await expect(playInto(target().played, JSON.stringify(viewed))).rejects.toThrow(/SIM_BAD_REPLAY.*marked view/);\nengine/app/playback.ts:8: * `playInto(target, text, options)` plays a replay's text from step 0 in a running engine: it starts the replay's run\nengine/app/playback.ts:21: * // const run = await playInto(host, readFileSync('tests/replays/box-1-room.replay.json', 'utf8'), { every: true });\nengine/app/playback.ts:93:/** How `playInto` plays. */\nengine/app/playback.ts:94:export interface PlayIntoOptions {\nengine/app/playback.ts:106:export interface PlayResult {\nengine/app/playback.ts:142:export async function playInto(target: PlayTarget, text: string, options: PlayIntoOptions = {}): Promise<PlayResult> {\nengine/app/playback.ts:182:  const result: PlayResult = { scene: replay.scene, steps: until, hashes, hash: session.world.hash(), frames };\nengine/app/headless.ts:59:import { playInto, type PlayIntoOptions, type PlayResult } from './playback';\nengine/app/headless.ts:292:    async replay(text: string, playOptions: PlayIntoOptions): Promise<PlayResult> {\nengine/app/headless.ts:295:        return await playInto(\nengine/app/viewMembers.ts:28:import type { PlayIntoOptions, PlayResult } from './playback';\nengine/app/viewMembers.ts:42:  replay(text: string, options: PlayIntoOptions): Promise<PlayResult>;\nengine/app/viewMembers.ts:131:  impl: (h, text: string, options: PlayIntoOptions) => app(h).replay(text, options),\n---\n/**\n * @file Writes and checks the one-file playground, `playground.html` (tools/lib/oneFile.ts; ADR-0023 amendment 5): the\n * playground as one self-contained HTML page, the file the engine is distributed and tested as.\n *\n * - `--write` builds it and writes it when it differs; commit it with the change that made it differ.\n * - `--check` (the default) builds it and fails while the committed file differs (`HTML_STALE`, fixed by `--write`) or\n *   loads anything from outside itself (`HTML_EXTERNAL`). The quick gate runs it (tools/cmd/ci.ts).\n *\n * The build takes about 11 s and gives the same bytes every time. The report's metrics give the file's size in bytes.\n *\n * Usage: node x html [--check | --write]. Exit 0 when the file is current (or was written), 1 otherwise, 2 on a\n * usage error.\n *\n * @example\n * // node x html --write   → x html: ok: wrote playground.html (6,912,709 bytes)\n * // node x html --check   → x html: ok: playground.html current (6,912,709 bytes)\n * @see tools/cmd/html.test.ts\n */\nimport { existsSync, readFileSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { buildOneFile, externalRefs, ONE_FILE } from '../lib/oneFile';\nimport type { Finding } from '../lib/report';\nimport { UsageError, type Command, type CommandResult } from '../x';\n\n/** Builds the command; tests inject the build. */\nexport function createHtmlCommand(build: (root: string) => Promise<string> = buildOneFile): Command {\n  return {\n    usage: 'html [--check | --write]',\n    options: { check: { type: 'boolean' }, write: { type: 'boolean' } },\n    maxPositionals: 0,\n    async run({ values, root }): Promise<CommandResult> {\n      if (values.check && values.write) throw new UsageError('choose --check or --write, not both');\n      const html = await build(root);\n      const path = join(root, ONE_FILE);\n      const current = existsSync(path) && readFileSync(path, 'utf8') === html;\n      const failures: Finding[] = externalRefs(html).map((ref) => ({\n        id: 'HTML_EXTERNAL',\n        message: `the one file loads ${ref}, which a file opened from disk cannot reach: inline it (tools/lib/oneFile.ts) or import it from the page's code`, // prettier-ignore\n        file: ONE_FILE,\n      }));\n      const bytes = Buffer.byteLength(html);\n      const size = `${bytes.toLocaleString('en-US')} bytes`;\n      if (values.write) {\n        if (!current) writeFileSync(path, html);\n        return {\n          ok: failures.length === 0,\n          summary: current ? `${ONE_FILE} was already current (${size})` : `wrote ${ONE_FILE} (${size})`,\n          failures,\n          metrics: { bytes, written: current ? 0 : 1 },\n        };\n      }\n      if (!current) {\n        failures.push({\n          id: 'HTML_STALE',\n          message: `${ONE_FILE} ${existsSync(path) ? 'differs from a build of its sources' : 'is missing'}: run node x html --write and commit it`, // prettier-ignore\n          file: ONE_FILE,\n        });\n      }\n      return {\n        ok: failures.length === 0,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PtJW6W2qeTD8v77u4Jwhwq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
