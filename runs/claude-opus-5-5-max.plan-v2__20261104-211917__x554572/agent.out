{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K24w9Bgk4RtDyiCFvPT5wH","type":"tool_result","content":"/**\n * @file The menu (PLAN.md §6.7, WP 10.6, I-50): a list with a cursor, for title screens, pause menus, settings and\n * shops, as HTML/CSS over the overlay. `createMenu(parent, items, { input, sound, title, place, onPick, onCancel,\n * onMove, send })` makes it open; `update(dt)` each frame reads the page's input and returns true when it picked or\n * cancelled.\n *\n * `uiUp` and `uiDown` (keys, the pad's D-pad and left stick; held, they repeat: engine/ui/widgets.ts `createRepeat`)\n * move the cursor over the items, round the ends, past disabled ones; `uiAccept` picks the item under it, `uiCancel`\n * calls `onCancel` when there is one; a pointer moving over an item moves the cursor there (a menu opening under a still\n * pointer, or rows shifting under it, moves none), a click picks it. A gamepad drives the menu with its buttons, and any\n * other panel through the pad's cursor (`createPadCursor`).\n *\n * Picks that change play: the system layer never enters the intents (engine/input/actionMaps.ts), so a menu never\n * reaches the sim itself. An item with an `id` is handed to `send(id)` when picked, which the page turns into input\n * the session records (a dev action, `__engine.actions.run`, or a custom intent for the next step), so the replay\n * holds the pick; `onPick` hears every pick, for what only the page changes (a look, a panel).\n *\n * Elements: `[data-ui=menu]` (`data-id`, `data-value` the cursor's index; `data-place`), its `[data-ui=menu-title]`,\n * and a `[data-ui=item]` per item (`data-id` its id or index, `data-value` `selected`, `disabled` or empty). Cues: `move`,\n * `pick`, `cancel`. Invariants: presentation only; `active: false` reads no input; the cursor never rests on a disabled\n * item while another is enabled. Carried from `my-3d2dge:engine/my-3d2dge.js:4288-4330` (`Menu`: items, disabled ones\n * skipped, onPick, onCancel, onMove) and shardfall's rule that menu actions reach the game as input (§5.8).\n *\n * @example\n * // browser: the menu needs a page\n * // const pause = createMenu(ui.root, ['Resume', { label: 'Restart', id: 'restart' }], {\n * //   input, title: 'Paused', onCancel: () => pause.remove(), send: (id) => engine.actions.run(id) });\n * // pause.update(dt); // each frame\n * @see engine/ui/menu.test.ts\n * @see tests/e2e/ui.spec.ts\n */\nimport { codeError, defineCodes } from '../core/log';\nimport { createRepeat, setText, uiElement, widgetStyle, type UiInput, type UiSound } from './widgets';\n\n/** The codes this module raises, with their fixes. */\nexport const MENU_CODES = defineCodes('ui', {\n  UI_BAD_MENU: {\n    template: 'menu: {problem}',\n    fix: \"give items as strings or { label, id?, disabled? }, and update(dt) the frame's seconds, 0 or more\",\n    doc: 'Raised by the menu (engine/ui/menu.ts) for an item that is neither a string nor `{ label, id?, disabled? }`, or a frame time that is not a number of seconds from 0.',\n  },\n});\n\n/** One menu item: its label, or `{ label, id, disabled }` (an `id` is sent when picked). */\nexport type MenuItem = string | { readonly label: string; readonly id?: string; readonly disabled?: boolean };\n....\n/**\n * @file The dialog box (PLAN.md §6.7, WP 10.6, I-50): text that types itself out a page at a time, with a speaker's\n * name and, on its last page, choices (Zelda's, Dragon Quest's, Final Fantasy's), as HTML/CSS over the overlay.\n * `createDialog(parent, { input, sound, speed, place })` makes it closed; `say(text, options)` opens it, each string a\n * page; `update(dt)` each frame types `speed` characters a second (50), reads the page's input and returns true while\n * it is open and modal, so the game waits.\n *\n * Accept (`uiAccept`: Enter, Space, the pad's south button; or a click on the box) shows the rest of a page that is\n * still typing, else turns the page, else closes it: with choices, it picks the one marked, `uiUp` and `uiDown` moving\n * the mark (held, they repeat: engine/ui/widgets.ts `createRepeat`) and a click picking one, while cancel (`uiCancel`)\n * marks the last (the \"no\"). `onChoice(i, choice)` then `onDone()` hear it. `auto: s` turns each typed page after `s`\n * seconds and closes after the last; `modal: false` reads no input and holds nothing back (radio chatter). Cues: `type`\n * every second character shown, `move` for the mark, `pick` on closing. A pick that changes play is the game's to send\n * as input (a dev action or a custom intent), since the system layer never reaches the intents.\n *\n * Elements: `[data-ui=dialog]` (`data-value`: `typing`, `shown` or `asking`; `data-place`), its `[data-ui=dialog-name]`\n * and `[data-ui=dialog-text]` (the characters shown), and a `[data-ui=choice]` per choice (`data-value=selected` on the\n * one marked). Invariants: presentation only; typing follows `dt` alone, so the same frames show the same text; it\n * never reads the sim. Carried from `my-3d2dge:engine/my-3d2dge.js:4194-4284` (`Dialog`: say, typing, pages, choices,\n * cancel to the last, auto, modal), the pixel-font wrap replaced by CSS.\n *\n * @example\n * // browser: the dialog needs a page\n * // const talk = createDialog(ui.root, { input, sound: (cue) => audio.play(`ui.${cue}`) });\n * // talk.say(['Hello, traveler!', 'Take the shield?'], { name: 'OLD MAN', choices: ['YES', 'NO'], onChoice: (i) => … });\n * // if (talk.update(dt)) return; // each frame: true while it is open, so play waits\n * @see engine/ui/dialog.test.ts\n * @see tests/e2e/ui.spec.ts\n */\nimport { codeError, defineCodes } from '../core/log';\nimport { createRepeat, setText, uiElement, widgetStyle, type UiInput, type UiSound } from './widgets';\n\n/** The codes this module raises, with their fixes. */\nexport const DIALOG_CODES = defineCodes('ui', {\n  UI_BAD_DIALOG: {\n    template: 'dialog.{call}: {problem}',\n    fix: \"say(text, { choices }) takes a string or a list of strings, and choices as a list of strings; update(dt) takes the frame's seconds, 0 or more\",\n    doc: 'Raised by the dialog box (engine/ui/dialog.ts) for text that is not a string or a list of them, choices that are not, or a frame time that is not a number of seconds from 0.',\n  },\n});\n\n/** Where the dialog box stands. */\nexport type DialogPlace = 'bottom' | 'middle' | 'top';\n\n/** How a dialog box is made. */\n....\n/**\n * @file The frame loop (PLAN.md §6.4, WP 2.7; doctrine: Reproducible): fixed sim steps plus interpolation, once per\n * animation frame. `createLoop` calls `frame(now)` from `requestAnimationFrame`: it samples the devices into intents,\n * asks the clock (engine/core/time.ts) how many fixed 1/60 s steps the real time since the last frame holds (at most\n * `time.maxSteps`, a time scale and pause applied), runs them, then has the view drawn at the clock's alpha, the\n * fraction of a step real time is past the last one (the view blends the last two states by it).\n *\n * Inputs across steps (§6.4): the frame's sample goes to its first step and its later steps get it without `p`\n * (held state repeats, edges apply once). A press sampled in a frame that runs no step (a display faster than 60 Hz,\n * a pause) waits for the next step, so a tap shorter than a step is never lost. While `hold()` says so (a replay is\n * playing through the same session), frames step nothing and draw nothing, and the time they cover is dropped.\n *\n * Touch screens draw at most 60 frames a second (WP 3.12, built, not tested): while `cap()` says so, an animation\n * frame that arrives more than 2.5 ms before the next 16.667 ms slot is skipped whole, and the slot starts again from\n * a frame that falls behind (`shardfall:crates/pav_app/src/app.rs:799-808`).\n *\n * Invariants: the loop reads no clock of its own: time comes from the animation frame's timestamp, so under the\n * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\n * frame stops the loop and goes to `onError` once, instead of repeating every frame.\n *\n * @example\n * // const loop = createLoop({ clock: () => run.clock, sample: (now) => input.sample(view.camera, now), step, draw, onError });\n * // loop.start();\n * // loop.frame(performance.now()); // one frame by hand: { steps: 1, alpha: 0.4, … }\n * @see engine/app/loop.test.ts\n */\nimport type { Clock, Frame } from '../core/time';\n\n/** What the loop drives. */\nexport interface LoopOptions {\n  /** The run's clock (read each frame: a restart makes a new one). */\n  clock(): Clock;\n  /** The devices' intents for the frame at timestamp `now` (`input.sample(camera, now)`); `{}` when there are none. */\n  sample(now: number): Record<string, unknown>;\n  /** Runs one sim step with these intents, through the session. */\n  step(intents: Record<string, unknown>): void;\n  /** Draws the view at the clock's `alpha`; `dt` is the real seconds since the last frame. */\n  draw(frame: { alpha: number; dt: number }): void;\n  /** True while frames must neither step nor draw (a replay plays). */\n  hold?(): boolean;\n  /** True while frames are capped at 60 a second (touch mode). */\n  cap?(): boolean;\n  /** Gets a frame's error, once; the loop has stopped. */\n  onError(error: unknown): void;\n  /** `requestAnimationFrame` and `cancelAnimationFrame` (the window's). */\n  request?: (callback: (now: number) => void) => number;\n  cancel?: (id: number) => void;\n}\n\n/** A running frame loop. */\nexport interface Loop {\n  /** Starts calling `frame` on every animation frame. */\n  start(): void;\n  /** Stops it. */\n  stop(): void;\n  /** Runs one frame at timestamp `now` (ms): sample, step, draw; returns what the clock handed out. */\n  frame(now: number): Frame;\n  /** Frames run, and sim steps run by them. */\n  readonly frames: number;\n  readonly steps: number;\n....\n  },\n  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n  step: {\n    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\n    args: {\n      n: { type: 'integer', default: 1, minimum: 0, description: 'How many steps.' },\n      intents: {\n        type: 'any',\n        description:\n          'One intents object for every step (its pressed buttons, p, on the first only), or a list of one per step (none past its end); none samples the virtual device each step (__engine.input).',\n      },\n    },\n    impl: (h, n: number, intents: unknown) => {\n      h.step(n, intents);\n      return h.session.world.tick;\n    },\n  },\n  timeScale: {\n    help: 'Sets sim seconds per real second (the time.scale setting) when k is given; returns it.',\n    args: { k: { type: 'number', minimum: 0, description: 'The new time scale: 0.5 is half speed.' } },\n    impl: (h, k: number | undefined) => {\n....\n/**\n * @file Props drawn (PLAN.md WP 4.5, §6.1): `createPropMeshes({ materials })` draws the `prop` entries\n * (engine/world/props/prop.ts) through the instancing service (engine/gfx/instancing.ts), one batch per prop part\n * (`prop:crate/mesh`, its pages `…/page0` in the ID pass), so a hundred crates are one draw call. Each frame:\n * `begin(time)`, `add(id, pose, key)` per prop, `end()`. A pose is the prop's centre and turn: its body's\n * (`physics.readBody(id)`) or, for a prop without one, `propPose(placement)`; the meshes stand `propCentre` below it,\n * so a knocked crate's mesh is wherever its body is.\n *\n * - **Parts.** A part's geometry is built once (`buildPropPart`), placed in the prop's frame (`partMatrix`) and\n *   drawn with the material library's materials, tinted per instance.\n * - **Flames.** A part with `flame.tongues` is drawn as that many tongues round its origin, each its tint round a\n *   core of `flame.core`, rising, swaying and leaning on their own sines (`tongueMatrices`). Each prop dances from its\n *   own phase, drawn once per `key` (an entity id) from the visual streams (`fxRng`: never hashed).\n * - **Lights.** `lights()` lists the light spots of this frame's props in world space, flickering (`FLICKER`) when\n *   the prop's light does: what the light pool (WP 7.1) places its lights at.\n * - **Looks.** The props' texture and materials (engine/gfx/propLooks.ts) are defined on the registry a prop mesh set\n *   is made over. A prop the sim turned off (a lamp's switch: `on` false in its pose) draws its `lit` parts dimmed\n *   (`OFF`) and gives no light.\n * - **Post-processing.** The root is tagged an object (`setPart`, engine/gfx/post/mrt.ts), in one outline group.\n *\n * Carried from `my-3d2dge:src/stress-world/30-crowd.js:293-329` (`crateTex`, `barrelTex`'s lids, `drawProps`: every\n * prop where its body is) and `src/stress-world/10-hall.js:409-436` (`animateBraziers`' tongues, `FLICKER`).\n *\n * Invariants: presentation only: it reads poses and entries and writes nothing back; equal inputs and streams give\n * equal matrices; a batch is made for each prop of `props` (every prop by default) before the warm-up, and for\n * another prop when first added (re-warming); geometries are this module's, materials the library's.\n *\n * @example\n * import { createMaterialLibrary } from './materials/library';\n * const props = createPropMeshes({ materials: createMaterialLibrary() });\n9: * - **Parts.** A part's geometry is built once (`buildPropPart`), placed in the prop's frame (`partMatrix`) and\n45:import { buildGeometry } from './geometry/geometry';\n46:import { sidesThenTops } from './geometry/groups';\n57:/** Builds `part`'s geometry (the caller's), with its tops and bottoms a group of their own when it has a `top`. */\n59:  const geometry = buildGeometry({ geometry: part.geometry, params: { ...part.params } }, registry);\n60:  return part.top ? sidesThenTops(geometry) : geometry;\n149:  geometry: BufferGeometry;\n178:    const geometry = buildPropPart(part, registry);\n185:      geometry,\n195:    const off = part.lit ? tint.clone().multiplyScalar(OFF) : tint;\n196:    return { part, batch, geometry, local, tint, core: new Color(part.flame.core), off };\n290:        for (const { batch, geometry } of draw.parts) {\n292:          geometry.dispose();\n....\n34: *     spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: 0.4 });\n51:/** The component `sceneProp`'s fields. */\n113:  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\n115:  defineComponent('propHealth', { description: \"A breakable prop's hit points (WP 13.16).\", fields: { hp } }, registry);\n116:  const fields = {\n120:  defineComponent('propLight', { description: \"A switchable prop's state (WP 13.16).\", fields }, registry);\n143: * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\n144: * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\n149: * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\n....\nengine/audio/runtime/audio.ts:46:import { BUS_VOLUMES, createMixer, type AudioBus, type Mixer, type MixerInfo } from './mixer';\nengine/audio/runtime/audio.ts-47-import { createMusic, type Music, type MusicChange, type MusicPosition } from './music';\nengine/audio/runtime/audio.ts-48-import { roomSpec, type RoomName, type RoomSpec } from './reverb';\nengine/audio/runtime/audio.ts-49-import { foldLoop, toBuffer } from './buffers';\nengine/audio/runtime/audio.ts-50-import { checkPlay, createVoice, type PlayOptions, type Sound, type RuntimeSound } from './sound';\nengine/audio/runtime/audio.ts-51-import { placeListener, wallsBetween, type ListenerPose, type Vec3 } from './spatial';\nengine/audio/runtime/audio.ts-52-import { createVoicePool, type VoiceLimits } from './voices';\nengine/audio/runtime/audio.ts-53-\nengine/audio/runtime/audio.ts-54-/** The runtime's codes, with their fixes. */\n--\nengine/audio/runtime/audio.ts:138:  const volumes = { ...BUS_VOLUMES };\nengine/audio/runtime/audio.ts-139-  let muted = false;\nengine/audio/runtime/audio.ts-140-  let room: RoomName | RoomSpec = 'none';\nengine/audio/runtime/audio.ts-141-  let pose: ListenerPose | null = null;\nengine/audio/runtime/audio.ts-142-  let queries: QueryView | undefined;\nengine/audio/runtime/audio.ts-143-  let pending: { id: string | null; options: MusicChange & { intensity?: number } } | null = null;\nengine/audio/runtime/audio.ts-144-  let level: number | undefined;\nengine/audio/runtime/audio.ts-145-  let context: BaseAudioContext | null = null;\nengine/audio/runtime/audio.ts-146-  let mixer: Mixer | null = null;\nengine/audio/runtime/mixer.ts:14: * Invariants: volumes are clamped to [0, 1]; `BUS_VOLUMES` are the starting levels (the source's: master 0.7, music\nengine/audio/runtime/mixer.ts-15- * 0.5, the rest 1). A room change fades the old reverb out and the new one in over `ROOM_FADE` seconds; asking for\nengine/audio/runtime/mixer.ts-16- * the room already in place changes nothing, so a game may name its room every frame. Nothing here reads a clock but\nengine/audio/runtime/mixer.ts-17- * the context's own `currentTime`.\nengine/audio/runtime/mixer.ts-18- *","is_error":false}]},"parent_tool_use_id":null,"session_id":"41ecbf1a-95aa-45b3-a227-3833f8bfa7e2","uuid":"b9e3355e-5fb4-4387-9447-79fb1a10ba4b","timestamp":"2026-11-05T04:33:19.727Z","tool_use_result":{"stdout":"/**\n * @file The menu (PLAN.md §6.7, WP 10.6, I-50): a list with a cursor, for title screens, pause menus, settings and\n * shops, as HTML/CSS over the overlay. `createMenu(parent, items, { input, sound, title, place, onPick, onCancel,\n * onMove, send })` makes it open; `update(dt)` each frame reads the page's input and returns true when it picked or\n * cancelled.\n *\n * `uiUp` and `uiDown` (keys, the pad's D-pad and left stick; held, they repeat: engine/ui/widgets.ts `createRepeat`)\n * move the cursor over the items, round the ends, past disabled ones; `uiAccept` picks the item under it, `uiCancel`\n * calls `onCancel` when there is one; a pointer moving over an item moves the cursor there (a menu opening under a still\n * pointer, or rows shifting under it, moves none), a click picks it. A gamepad drives the menu with its buttons, and any\n * other panel through the pad's cursor (`createPadCursor`).\n *\n * Picks that change play: the system layer never enters the intents (engine/input/actionMaps.ts), so a menu never\n * reaches the sim itself. An item with an `id` is handed to `send(id)` when picked, which the page turns into input\n * the session records (a dev action, `__engine.actions.run`, or a custom intent for the next step), so the replay\n * holds the pick; `onPick` hears every pick, for what only the page changes (a look, a panel).\n *\n * Elements: `[data-ui=menu]` (`data-id`, `data-value` the cursor's index; `data-place`), its `[data-ui=menu-title]`,\n * and a `[data-ui=item]` per item (`data-id` its id or index, `data-value` `selected`, `disabled` or empty). Cues: `move`,\n * `pick`, `cancel`. Invariants: presentation only; `active: false` reads no input; the cursor never rests on a disabled\n * item while another is enabled. Carried from `my-3d2dge:engine/my-3d2dge.js:4288-4330` (`Menu`: items, disabled ones\n * skipped, onPick, onCancel, onMove) and shardfall's rule that menu actions reach the game as input (§5.8).\n *\n * @example\n * // browser: the menu needs a page\n * // const pause = createMenu(ui.root, ['Resume', { label: 'Restart', id: 'restart' }], {\n * //   input, title: 'Paused', onCancel: () => pause.remove(), send: (id) => engine.actions.run(id) });\n * // pause.update(dt); // each frame\n * @see engine/ui/menu.test.ts\n * @see tests/e2e/ui.spec.ts\n */\nimport { codeError, defineCodes } from '../core/log';\nimport { createRepeat, setText, uiElement, widgetStyle, type UiInput, type UiSound } from './widgets';\n\n/** The codes this module raises, with their fixes. */\nexport const MENU_CODES = defineCodes('ui', {\n  UI_BAD_MENU: {\n    template: 'menu: {problem}',\n    fix: \"give items as strings or { label, id?, disabled? }, and update(dt) the frame's seconds, 0 or more\",\n    doc: 'Raised by the menu (engine/ui/menu.ts) for an item that is neither a string nor `{ label, id?, disabled? }`, or a frame time that is not a number of seconds from 0.',\n  },\n});\n\n/** One menu item: its label, or `{ label, id, disabled }` (an `id` is sent when picked). */\nexport type MenuItem = string | { readonly label: string; readonly id?: string; readonly disabled?: boolean };\n....\n/**\n * @file The dialog box (PLAN.md §6.7, WP 10.6, I-50): text that types itself out a page at a time, with a speaker's\n * name and, on its last page, choices (Zelda's, Dragon Quest's, Final Fantasy's), as HTML/CSS over the overlay.\n * `createDialog(parent, { input, sound, speed, place })` makes it closed; `say(text, options)` opens it, each string a\n * page; `update(dt)` each frame types `speed` characters a second (50), reads the page's input and returns true while\n * it is open and modal, so the game waits.\n *\n * Accept (`uiAccept`: Enter, Space, the pad's south button; or a click on the box) shows the rest of a page that is\n * still typing, else turns the page, else closes it: with choices, it picks the one marked, `uiUp` and `uiDown` moving\n * the mark (held, they repeat: engine/ui/widgets.ts `createRepeat`) and a click picking one, while cancel (`uiCancel`)\n * marks the last (the \"no\"). `onChoice(i, choice)` then `onDone()` hear it. `auto: s` turns each typed page after `s`\n * seconds and closes after the last; `modal: false` reads no input and holds nothing back (radio chatter). Cues: `type`\n * every second character shown, `move` for the mark, `pick` on closing. A pick that changes play is the game's to send\n * as input (a dev action or a custom intent), since the system layer never reaches the intents.\n *\n * Elements: `[data-ui=dialog]` (`data-value`: `typing`, `shown` or `asking`; `data-place`), its `[data-ui=dialog-name]`\n * and `[data-ui=dialog-text]` (the characters shown), and a `[data-ui=choice]` per choice (`data-value=selected` on the\n * one marked). Invariants: presentation only; typing follows `dt` alone, so the same frames show the same text; it\n * never reads the sim. Carried from `my-3d2dge:engine/my-3d2dge.js:4194-4284` (`Dialog`: say, typing, pages, choices,\n * cancel to the last, auto, modal), the pixel-font wrap replaced by CSS.\n *\n * @example\n * // browser: the dialog needs a page\n * // const talk = createDialog(ui.root, { input, sound: (cue) => audio.play(`ui.${cue}`) });\n * // talk.say(['Hello, traveler!', 'Take the shield?'], { name: 'OLD MAN', choices: ['YES', 'NO'], onChoice: (i) => … });\n * // if (talk.update(dt)) return; // each frame: true while it is open, so play waits\n * @see engine/ui/dialog.test.ts\n * @see tests/e2e/ui.spec.ts\n */\nimport { codeError, defineCodes } from '../core/log';\nimport { createRepeat, setText, uiElement, widgetStyle, type UiInput, type UiSound } from './widgets';\n\n/** The codes this module raises, with their fixes. */\nexport const DIALOG_CODES = defineCodes('ui', {\n  UI_BAD_DIALOG: {\n    template: 'dialog.{call}: {problem}',\n    fix: \"say(text, { choices }) takes a string or a list of strings, and choices as a list of strings; update(dt) takes the frame's seconds, 0 or more\",\n    doc: 'Raised by the dialog box (engine/ui/dialog.ts) for text that is not a string or a list of them, choices that are not, or a frame time that is not a number of seconds from 0.',\n  },\n});\n\n/** Where the dialog box stands. */\nexport type DialogPlace = 'bottom' | 'middle' | 'top';\n\n/** How a dialog box is made. */\n....\n/**\n * @file The frame loop (PLAN.md §6.4, WP 2.7; doctrine: Reproducible): fixed sim steps plus interpolation, once per\n * animation frame. `createLoop` calls `frame(now)` from `requestAnimationFrame`: it samples the devices into intents,\n * asks the clock (engine/core/time.ts) how many fixed 1/60 s steps the real time since the last frame holds (at most\n * `time.maxSteps`, a time scale and pause applied), runs them, then has the view drawn at the clock's alpha, the\n * fraction of a step real time is past the last one (the view blends the last two states by it).\n *\n * Inputs across steps (§6.4): the frame's sample goes to its first step and its later steps get it without `p`\n * (held state repeats, edges apply once). A press sampled in a frame that runs no step (a display faster than 60 Hz,\n * a pause) waits for the next step, so a tap shorter than a step is never lost. While `hold()` says so (a replay is\n * playing through the same session), frames step nothing and draw nothing, and the time they cover is dropped.\n *\n * Touch screens draw at most 60 frames a second (WP 3.12, built, not tested): while `cap()` says so, an animation\n * frame that arrives more than 2.5 ms before the next 16.667 ms slot is skipped whole, and the slot starts again from\n * a frame that falls behind (`shardfall:crates/pav_app/src/app.rs:799-808`).\n *\n * Invariants: the loop reads no clock of its own: time comes from the animation frame's timestamp, so under the\n * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\n * frame stops the loop and goes to `onError` once, instead of repeating every frame.\n *\n * @example\n * // const loop = createLoop({ clock: () => run.clock, sample: (now) => input.sample(view.camera, now), step, draw, onError });\n * // loop.start();\n * // loop.frame(performance.now()); // one frame by hand: { steps: 1, alpha: 0.4, … }\n * @see engine/app/loop.test.ts\n */\nimport type { Clock, Frame } from '../core/time';\n\n/** What the loop drives. */\nexport interface LoopOptions {\n  /** The run's clock (read each frame: a restart makes a new one). */\n  clock(): Clock;\n  /** The devices' intents for the frame at timestamp `now` (`input.sample(camera, now)`); `{}` when there are none. */\n  sample(now: number): Record<string, unknown>;\n  /** Runs one sim step with these intents, through the session. */\n  step(intents: Record<string, unknown>): void;\n  /** Draws the view at the clock's `alpha`; `dt` is the real seconds since the last frame. */\n  draw(frame: { alpha: number; dt: number }): void;\n  /** True while frames must neither step nor draw (a replay plays). */\n  hold?(): boolean;\n  /** True while frames are capped at 60 a second (touch mode). */\n  cap?(): boolean;\n  /** Gets a frame's error, once; the loop has stopped. */\n  onError(error: unknown): void;\n  /** `requestAnimationFrame` and `cancelAnimationFrame` (the window's). */\n  request?: (callback: (now: number) => void) => number;\n  cancel?: (id: number) => void;\n}\n\n/** A running frame loop. */\nexport interface Loop {\n  /** Starts calling `frame` on every animation frame. */\n  start(): void;\n  /** Stops it. */\n  stop(): void;\n  /** Runs one frame at timestamp `now` (ms): sample, step, draw; returns what the clock handed out. */\n  frame(now: number): Frame;\n  /** Frames run, and sim steps run by them. */\n  readonly frames: number;\n  readonly steps: number;\n....\n  },\n  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n  step: {\n    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\n    args: {\n      n: { type: 'integer', default: 1, minimum: 0, description: 'How many steps.' },\n      intents: {\n        type: 'any',\n        description:\n          'One intents object for every step (its pressed buttons, p, on the first only), or a list of one per step (none past its end); none samples the virtual device each step (__engine.input).',\n      },\n    },\n    impl: (h, n: number, intents: unknown) => {\n      h.step(n, intents);\n      return h.session.world.tick;\n    },\n  },\n  timeScale: {\n    help: 'Sets sim seconds per real second (the time.scale setting) when k is given; returns it.',\n    args: { k: { type: 'number', minimum: 0, description: 'The new time scale: 0.5 is half speed.' } },\n    impl: (h, k: number | undefined) => {\n....\n/**\n * @file Props drawn (PLAN.md WP 4.5, §6.1): `createPropMeshes({ materials })` draws the `prop` entries\n * (engine/world/props/prop.ts) through the instancing service (engine/gfx/instancing.ts), one batch per prop part\n * (`prop:crate/mesh`, its pages `…/page0` in the ID pass), so a hundred crates are one draw call. Each frame:\n * `begin(time)`, `add(id, pose, key)` per prop, `end()`. A pose is the prop's centre and turn: its body's\n * (`physics.readBody(id)`) or, for a prop without one, `propPose(placement)`; the meshes stand `propCentre` below it,\n * so a knocked crate's mesh is wherever its body is.\n *\n * - **Parts.** A part's geometry is built once (`buildPropPart`), placed in the prop's frame (`partMatrix`) and\n *   drawn with the material library's materials, tinted per instance.\n * - **Flames.** A part with `flame.tongues` is drawn as that many tongues round its origin, each its tint round a\n *   core of `flame.core`, rising, swaying and leaning on their own sines (`tongueMatrices`). Each prop dances from its\n *   own phase, drawn once per `key` (an entity id) from the visual streams (`fxRng`: never hashed).\n * - **Lights.** `lights()` lists the light spots of this frame's props in world space, flickering (`FLICKER`) when\n *   the prop's light does: what the light pool (WP 7.1) places its lights at.\n * - **Looks.** The props' texture and materials (engine/gfx/propLooks.ts) are defined on the registry a prop mesh set\n *   is made over. A prop the sim turned off (a lamp's switch: `on` false in its pose) draws its `lit` parts dimmed\n *   (`OFF`) and gives no light.\n * - **Post-processing.** The root is tagged an object (`setPart`, engine/gfx/post/mrt.ts), in one outline group.\n *\n * Carried from `my-3d2dge:src/stress-world/30-crowd.js:293-329` (`crateTex`, `barrelTex`'s lids, `drawProps`: every\n * prop where its body is) and `src/stress-world/10-hall.js:409-436` (`animateBraziers`' tongues, `FLICKER`).\n *\n * Invariants: presentation only: it reads poses and entries and writes nothing back; equal inputs and streams give\n * equal matrices; a batch is made for each prop of `props` (every prop by default) before the warm-up, and for\n * another prop when first added (re-warming); geometries are this module's, materials the library's.\n *\n * @example\n * import { createMaterialLibrary } from './materials/library';\n * const props = createPropMeshes({ materials: createMaterialLibrary() });\n9: * - **Parts.** A part's geometry is built once (`buildPropPart`), placed in the prop's frame (`partMatrix`) and\n45:import { buildGeometry } from './geometry/geometry';\n46:import { sidesThenTops } from './geometry/groups';\n57:/** Builds `part`'s geometry (the caller's), with its tops and bottoms a group of their own when it has a `top`. */\n59:  const geometry = buildGeometry({ geometry: part.geometry, params: { ...part.params } }, registry);\n60:  return part.top ? sidesThenTops(geometry) : geometry;\n149:  geometry: BufferGeometry;\n178:    const geometry = buildPropPart(part, registry);\n185:      geometry,\n195:    const off = part.lit ? tint.clone().multiplyScalar(OFF) : tint;\n196:    return { part, batch, geometry, local, tint, core: new Color(part.flame.core), off };\n290:        for (const { batch, geometry } of draw.parts) {\n292:          geometry.dispose();\n....\n34: *     spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: 0.4 });\n51:/** The component `sceneProp`'s fields. */\n113:  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\n115:  defineComponent('propHealth', { description: \"A breakable prop's hit points (WP 13.16).\", fields: { hp } }, registry);\n116:  const fields = {\n120:  defineComponent('propLight', { description: \"A switchable prop's state (WP 13.16).\", fields }, registry);\n143: * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\n144: * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\n149: * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\n....\nengine/audio/runtime/audio.ts:46:import { BUS_VOLUMES, createMixer, type AudioBus, type Mixer, type MixerInfo } from './mixer';\nengine/audio/runtime/audio.ts-47-import { createMusic, type Music, type MusicChange, type MusicPosition } from './music';\nengine/audio/runtime/audio.ts-48-import { roomSpec, type RoomName, type RoomSpec } from './reverb';\nengine/audio/runtime/audio.ts-49-import { foldLoop, toBuffer } from './buffers';\nengine/audio/runtime/audio.ts-50-import { checkPlay, createVoice, type PlayOptions, type Sound, type RuntimeSound } from './sound';\nengine/audio/runtime/audio.ts-51-import { placeListener, wallsBetween, type ListenerPose, type Vec3 } from './spatial';\nengine/audio/runtime/audio.ts-52-import { createVoicePool, type VoiceLimits } from './voices';\nengine/audio/runtime/audio.ts-53-\nengine/audio/runtime/audio.ts-54-/** The runtime's codes, with their fixes. */\n--\nengine/audio/runtime/audio.ts:138:  const volumes = { ...BUS_VOLUMES };\nengine/audio/runtime/audio.ts-139-  let muted = false;\nengine/audio/runtime/audio.ts-140-  let room: RoomName | RoomSpec = 'none';\nengine/audio/runtime/audio.ts-141-  let pose: ListenerPose | null = null;\nengine/audio/runtime/audio.ts-142-  let queries: QueryView | undefined;\nengine/audio/runtime/audio.ts-143-  let pending: { id: string | null; options: MusicChange &