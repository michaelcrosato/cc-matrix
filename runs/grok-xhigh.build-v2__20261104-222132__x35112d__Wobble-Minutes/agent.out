er().map(|n| [n.t, n.lane as f32]).collect();\\n    }\\n    fallback_notes()\\n}\\n\\nfn fallback_notes() -> Vec<[f32; 2]> {\\n    let mut notes = Vec::new();\\n    let mut t = 1.0;\\n    let mut i = 0;\\n380→    while notes.len() < 100 && t < 62.0 {\\n        let lane = if i % 11 == 10 { 2.0 } else { (i % 2) as f32 };\\n        notes.push([t, lane]);\\n        t += if i < 32 { 0.625 } else { 0.3125 };\\n        i += 1;\\n    }\\n    notes\\n}\\n\\nfn pd(bal: &BalanceCore, rules: &Rules, target: Vec2) -> Vec2 {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/events.rs\",\"offset\":250,\"limit\":140,\"raw_output\":\"            depth: 0.0,\\n            reps: 0,\\n            survived: 0.0,\\n            out_t: 0.0,\\n            flopped: false,\\n            streak: 0.0,\\n            pose_i: 0,\\n            notes: Vec::new(),\\n            note_i: 0,\\n            hits: 0,\\n            spin: 0.0,\\n            prev_ang: 0.0,\\n            have_ang: false,\\n            rings: 0,\\n            band_t: 0.0,\\n            dir: 1.0,\\n            catch_i: 0,\\n            steps: 0,\\n            last_side: 0,\\n            step_times: Vec::new(),\\n            zone_t: 0.0,\\n            lateral: 0.0,\\n            ribbons: 0,\\n            bumps: 0,\\n            shells: Vec::new(),\\n            pools: Vec::new(),\\n            potted: 0,\\n            board: 0,\\n            px: 0.0,\\n            pz: 0.0,\\n            speed: 0.0,\\n            gates: Vec::new(),\\n            gate_i: 0,\\n            missed: 0,\\n            glasses: [0.0; 5],\\n            glass_ok: [true; 5],\\n            jolts: Vec::new(),\\n            dives: 0,\\n            power: 0.0,\\n            air: 0.0,\\n            tuck: 0.0,\\n            dive_scores: Vec::new(),\\n            leaping: false,\\n            forfeit: false,\\n            