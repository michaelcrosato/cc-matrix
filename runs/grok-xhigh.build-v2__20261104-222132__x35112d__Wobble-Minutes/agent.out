,47,32,72,101,108,100,32,103,97,109,101,32,98,117,116,116,111,110,115,32,102,114,111,109,32,97,108,108,32,100,101,118,105,99,101,115,46,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":24,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_app/src/input.rs\",\"matches\":[{\"line_number\":185,\"content\":\"pub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\"},{\"line_number\":186,\"content\":\"    match device {\"},{\"line_number\":226,\"content\":\"/// Human-readable control guide per device.\"},{\"line_number\":227,\"content\":\"pub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\"},{\"line_number\":228,\"content\":\"    match device {\"},{\"line_number\":296,\"content\":\"    pub device: u8,\"},{\"line_number\":311,\"content\":\"    pub last_device: Device,\"},{\"line_number\":321,\"content\":\"    /// A key or a pad has been used. A coarse pointer stays touch-only until then.\"},{\"line_number\":323,\"content\":\"    /// `matchMedia('(pointer: coarse)')` and no fine pointer.\"},{\"line_number\":324,\"content\":\"    pub coarse: bool,\"},{\"line_number\":452,\"content\":\"            last_device: Device::KeyboardMouse,\"},{\"line_number\":460,\"content\":\"            coarse: false,\"},{\"line_number\":483,\"content\":\"    /// Lean, device and pointer for one stay frame. `items` are normalized rects.\"},{\"line_number\":484,\"content\":\"    pub fn fit_sample(&mut self, dt: f32, size: Vec2, items: &[(u16, [f32; 4])], clicked: bool) -> FitSample {\"},{\"line_number\":504,\"content\":\"        if self.mouse_travel > 6.0 && !self.coarse {\"},{\"line_number\":539,\"content\":\"        let device = if self.coarse && !self.seen_real {\"},{\"line_number\":541,\"content\":\"        } else if self.last_device == Device::Gamepad {\"},{\"line_number\":545,\"content\":\"        } else if self.last_device == Device::Touch {\"},{\"line_number\":550,\"content\":\"        let any = !self.coarse && (self.pad.any_activity || travel > 6.0 || stick.length() > 0.3 || lean.length() > 0.3);\"},{\"line_number\":551,\"content\":\"        FitSample { lean, device, any, ui, extra }\"},{\"line_number\":555,\"content\":\"        self.last_device = Device::KeyboardMouse;\"},{\"line_number\":569,\"content\":\"        self.last_device = Device::KeyboardMouse;\"},{\"line_number\":722,\"content\":\"            self.last_device = Device::Gamepad;\"},{\"line_number\":737,\"content\":\"    /// Held game buttons from all devices.\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"7523731e-f384-4cab-baec-26ef069c4de1"}
