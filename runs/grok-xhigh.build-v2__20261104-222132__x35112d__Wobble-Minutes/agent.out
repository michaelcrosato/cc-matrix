&PuppetDef, st: &PuppetState, feet: Vec3, cam_fwd: Vec3) -> (Vec<PuppetPart>, Option<(Vec3, Vec3)>) {\"},{\"line_number\":1100,\"content\":\"pub fn procedural(def: &PuppetDef, st: &PuppetState, table: &crate::moves::MoveTable) -> Skel {\"},{\"line_number\":1277,\"content\":\"fn dress(def: &PuppetDef, st: &PuppetState, sk: &Skel, feet: Vec3, cam_fwd: Vec3) -> (Vec<PuppetPart>, Option<(Vec3, Vec3)>) {\"},{\"line_number\":1324,\"content\":\"    let gear = &def.gear;\"},{\"line_number\":1445,\"content\":\"    let glove = Color::try_hex(&def.gear.gloves).unwrap_or(skin);\"},{\"line_number\":1446,\"content\":\"    let fore = if def.gear.gloves.is_empty() { skin } else { glove };\"},{\"line_number\":1450,\"content\":\"        push(elbow, hand, lr * 0.95, lr * if def.gear.gloves.is_empty() { 0.85 } else { 1.05 }, fore);\"},{\"line_number\":1452,\"content\":\"        if def.gear.pauldrons > 0.0 {\"},{\"line_number\":1453,\"content\":\"            let pc = Color::try_hex(&def.gear.armor_color).unwrap_or(shirt);\"},{\"line_number\":1455,\"content\":\"            let r = lr * 1.9 * def.gear.pauldrons;\"},{\"line_number\":1478,\"content\":\"    let out = if def.gear.helm == HelmKind::Great { 1.13 } else { 0.9 };\"},{\"line_number\":1609,\"content\":\"        let parts = pose(&PuppetDef::default(), &PuppetState::default(), None, Vec3::ZERO, Vec3::NEG_Y);\"},{\"line_number\":1619,\"content\":\"            let mut def = PuppetDef::preset(plan);\"},{\"line_number\":1632,\"content\":\"        let def = PuppetDef::default();\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/clips.rs\",\"matches\":[{\"line_number\":23,\"content\":\"use crate::puppet::{PuppetDef, PuppetState, Skel};\"},{\"line_number\":473,\"content\":\"pub fn hip_height(def: &PuppetDef) -> f32 {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178f