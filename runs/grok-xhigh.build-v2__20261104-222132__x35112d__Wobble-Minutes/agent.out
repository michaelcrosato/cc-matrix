r audio dependencies).\\n// `x as Real` casts are no-ops with f32 physics but required by the f64 switch.\\n#![allow(clippy::unnecessary_cast)]\\n\\npub mod ai;\\npub mod anim;\\npub mod animation_edit;\\npub mod animation_preview;\\npub mod arpg;\\n10→pub mod behaviors;\\npub mod catalogue;\\npub mod character;\\npub mod clip_browser;\\npub mod clips;\\npub mod color;\\npub mod course;\\npub mod creature_preview;\\npub mod creatures;\\npub mod destruct;\\n20→pub mod entity;\\npub mod feel;\\npub mod figure;\\npub mod frame;\\npub mod fxdef;\\npub mod games;\\npub mod guide;\\npub mod health;\\npub mod history;\\npub mod input;\\n30→pub mod issue;\\npub mod joints;\\npub mod level;\\npub mod material;\\npub mod moves;\\npub mod nav;\\npub mod params;\\npub mod parts;\\npub mod physics;\\npub mod projectile;\\n40→pub mod prop_instance;\\npub mod prop_preview;\\npub mod props;\\npub mod puppet;\\npub mod rig;\\npub mod rng;\\npub mod room;\\npub mod scenes;\\npub mod shape;\\npub mod sim;\\n50→pub mod softbody;\\npub mod statics;\\npub mod stealth;\\npub mod store;\\npub mod terrain;\\npub mod vehicle;\\npub mod world;\\npub mod zones;\\n\\npub use color::Color;\\n60→pub use entity::{Behavior, BodyKind, Entity, EntityId, Spawn};\\npub use frame::{RenderFrame, RenderObject, SimEvent};\\npub use glam;\\npub use input::InputFrame;\\npub use rapier;\\npub use shape::{Look, Shape, Visual};\\npub use sim::{Sim, SimConfig, SimState};\\n\",\"content_concise\":\"1→//! Pavilion simulation core: headless (no window, GPU or audio dependencies).\\n// `x as Real` casts are no-ops with f32 physics but required by the f64 switch.\\n#![allow(clippy::unnecessary_cast)]\\n\\npub mod ai;\\npub mod anim;\\npub mod animation_edit;\\npub mod animation_preview;\\npub mod arpg;\\n10→pub mod behaviors;\\npub mod catalogue;\\npub mod character;\\npub mod clip_browser;\\npub mod clips;\\npub mod color;\\npub mod course;\\npub mod creature_preview;\\npub mod creatures;\\npub mod destruct;\\n20→pu