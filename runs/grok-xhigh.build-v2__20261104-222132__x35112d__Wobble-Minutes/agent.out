a/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104\\n-222132/engine/target/debug/deps/libserde-8fa7d6033a418fdd.rmeta --extern serde_json=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps/libserde_json-8131d7d7ab393d8d.rmeta --extern toml=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps/libtoml-53d37a09b6de8722.rmeta\\n 433746       00:16 89.9  4.5 /home/micha/.rustup/toolchains/1.98.1-x86_64-unknown-linux-gnu/bin/rustc --crate-name pav_tools --edition=2024 crates/pav_tools/src/lib.rs --error-format=json --json=diagnostic-rendered-ansi,artifacts,future-incompat --crate-type lib --emit=dep-info,metadata,link -C opt-level=1 -C embed-bitcode=no -C debuginfo=line-tables-only --allow=clippy::type_complexity --allow=clippy::too_many_arguments --allow=clippy::collapsible_match --allow=clippy::collapsible_if -C debug-assertions=on --check-cfg cfg(docsrs,test) --check-cfg cfg(feature, values()) -C metadata=a743ed3252ca260d -C extra-filename=-f60f07c25eab6f5d --out-dir /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps -L dependency=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps --extern anyhow=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps/libanyhow-01da988748fe3d85.rmeta --extern egui=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/target/debug/deps/libegui-4f3df0