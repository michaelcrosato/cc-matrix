ber\":67,\"content\":\"    pub input: Mutex<InputFrame>,\"},{\"line_number\":110,\"content\":\"        input: Mutex::new(InputFrame::default()),\"},{\"line_number\":270,\"content\":\"                InputFrame::default()\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"ffdbb633-3bec-4ed3-a35a-a426306a672f"}
