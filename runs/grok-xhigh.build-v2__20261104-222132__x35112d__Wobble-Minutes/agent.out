, beach and wellness props\\n ... \\nes, then stand still when it matters.\\\", \\\"type\\\": \\\"Game\\\", \\\"genre\\\": \\\"Sports\\\", \\\"source\\\": \\\"Wii Fit\\\", \\\"series\\\": \\\"Wii Fit\\\", \\\"players\\\": \\\"1–4\\\", \\\"controls\\\": \\\"Lean with the stick, WASD or the mouse. Confirm with Cross, Space or click.\\\", \\\"tags\\\": [\\\"3d\\\", \\\"third-person\\\", \\\"sports\\\", \\\"comedy\\\", \\\"low-poly\\\", \\\"versus\\\"]}}\\n\\n=== script attrs='' len=1801 at 21588 ===\\n (() => {   const boot = window.__gameBoot = { scene: null, seed: null, today: Math.floor(Date.now() / 86400000),                                      about: document.getElementById('about-data')?.textContent ?? '' };   if (!window.AIHub || !AIHub.active) return;   const hub = window.__hub = { go: false, ended: false, players: [], me: 0, ghosts: {} };   boot.scene = 'fit/medley';   boot.seed = Num\\n ... \\n-1 }, { reliable: false });       if (s?.done) report();     }, 100);     AIHub.on('message', (data, from) => { hub.ghosts[from] = data; });     AIHub.on('leave', ({ id }) => { delete hub.ghosts[id]; });     AIHub.on('time-up', report);     AIHub.on('end', () => { hub.ended = true; });   }); })();  \\n\\n=== script attrs='' len=661 at 25645 ===\\n\\n  const coarseOnly = matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\\n  if (coarseOnly) document.documentElement.classList.add('touch-only');\\n  const needBtn = document.getElementById('need-settings');\\n  if (needBtn) needBtn.addEventListener('click', () => { window.__fitClick = 4; });\\n  const dropNeed = () => { const n = document.getElementById('need'); if (n) n.remove(); };\\n  addEventListener('keydown', dropNeed);\\n  setInterval(() => {\\n    const pads = navigator.getGamepads ? navigator.getGamepads() : [];\\n    for (const p of pads) if (p && p.buttons && [...p.buttons].some((b) => b.pressed)) dropNeed();\\n  }, 250);\\n\\n\\n=== script attrs=' type=\\\"module\\\"' len=1004 at 26324 ===\\n\\n  const name = document.title;\\n  const msg = document.getElementById('msg');\\n  if (!navigator.gpu) {\\n    msg.replaceChildren('Controller or keyboard required', document.createElement('br'),\\n      `${name} needs WebGPU.`, document.createElement('br'),\\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\\n  } else {\\n    new MutationObserver((_, obs) => {\\n      const c = document.querySelector('canvas');\\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\\n    }).observe(document.body, { childList: true });\\n    try {\\n      if (window.loadGame) await window.loadGame();\\n      else await (await import('./shardfall.js')).default();\\n    } catch (error) {\\n      console.error(`${name} failed to load:`, error);\\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\\n      document.body.append(msg);\\n    }\\n  }\\n\\n\\n=== script attrs=' id=\\\"game-wasm\\\" type=\\\"application/octet-stream\\\" data-size=\\\"28803599\\\"' len=11523612 at 27360 ===\\\\n ... \\\\n\\n=== script attrs='' len=2130 at 11551058 ===\\n (() => {   const msg = document.getElementById('msg');   // The start scene baked in at build time, unless the address names a room or a scene.   const scene = \\\"fit\\\", query = new URLSearchParams(location.search);   if (scene && !query.get('room') && !query.get('scene')) {     query.set('scene', scene);     try { history.replaceState(history.state, '', '?' + query + location.hash); }     catch (er\\n ... \\n line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;     }     if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);     line.textContent = 'Starting…';     await paint();     const init = await glue;     await init({ module_or_path: wasm });   }; })(); \\n\\n=== script attrs=' type=\\\"module\\\"' len=117735 at 11553206 ===\\n /**  * Format that each sample has. Usually, this corresponds to the sampling  * depth of the audio source. For example, 16 bit quantized samples can be  * encoded in `i16` or `u16`. Note that the quantized sampling depth is not  * directly visible for formats where [`is_float`] is true.  *  * Also note that the backend must support the encoding of the quantized  * samples in the given format, as\\n ... \\n module_or_path instanceof URL)) {         module_or_path = fetch(module_or_path);     }      const { instance, module } = await __wbg_load(await module_or_path, imports);      return __wbg_finalize_init(instance, module); }  export { initSync, __wbg_init as default };  window.gameGlue(__wbg_init); \\n\\nloadGame count 3\\nwindow.loadGame True\\n\",\"exit_code\":0,\"command\":\"python3 - << 'PY'\\nfrom pathlib import Path\\ntext = Path(\\\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132.html\\\").read_text(encoding=\\\"utf-8\\\", errors=\\\"replace\\\")\\n# find script tags and their first/last 200 chars, skip huge ones\\nimport re\\nfor m in re.finditer(r\\\"<script\\\\b([^>]*)>\\\", text):\\n    start = m.end()\\n    end = text.find(\\\"</script>\\\", start)\\n    attrs = m.group(1)\\n    body = text[start:end]\\n    print(f\\\"\\\\n=== script attrs={attrs!r} len={len(body)} at {m.start()} ===\\\")\\n    if len(body) > 1500:\\n        print(body[:400].replace(\\\"\\\\n\\\",\\\" \\\")[:400])\\n        print(\\\" ... \\\")\\n        print(body[-300:].replace(\\\"\\\\n\\\",\\\" \\\")[:300])\\n    else:\\n        print(body[:1500])\\nprint(\\\"\\\\nloadGame count\\\", text.count(\\\"loadGame\\\"))\\nprint(\\\"window.loadGame\\\", \\\"window.loadGame\\\" in text)\\nPY\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Map script blocks in the packed page\",\"current_dir\":\"/home/micha/dev/cc-matrix