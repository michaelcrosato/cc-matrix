4,93,44,34,101,110,103,105,110,101,70,101,101,100,98,97,99,107,34,58,91,34,112,97,117,115,101,32,114,101,116,117,114,110,115,32,105,110,115,105,100,101,32,116,104,101,32,116,105,99,107,34,93,44,34,112,114,111,109,112,116,70,101,101,100,98,97,99,107,34,58,91,34,116,104,101,32,102,117,108,108,32,114,111,115,116,101,114,32,115,104,105,112,115,34,93,125,34,35,46,105,110,116,111,40,41,59,10,50,54,55,58,32,32,32,32,115,105,109,46,115,116,101,112,40,38,73,110,112,117,116,70,114,97,109,101,32,123,32,117,105,58,32,83,111,109,101,40,85,105,69,118,101,110,116,58,58,67,108,105,99,107,40,53,41,41,44,32,100,101,118,105,99,101,58,32,50,44,32,112,114,101,115,115,101,100,58,32,48,44,32,46,46,68,101,102,97,117,108,116,58,58,100,101,102,97,117,108,116,40,41,32,125,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":13,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/tests/fit.rs\",\"matches\":[{\"line_number\":91,\"content\":\"        let age = s[\\\"age\\\"].as_u64().unwrap_or(0);\"},{\"line_number\":92,\"content\":\"        assert!((18..=99).contains(&age), \\\"age {age}\\\");\"},{\"line_number\":111,\"content\":\"    sim.step(&InputFrame { pressed: buttons::CONFIRM, device: 2, ..Default::default() });\"},{\"line_number\":132,\"content\":\"    assert_eq!(phase(&sim), \\\"dev\\\");\"},{\"line_number\":148,\"content\":\"fn music_defaults_quiet_and_a_dev_slider_resets() {\"},{\"line_number\":154,\"content\":\"    assert_eq!(phase(&sim), \\\"dev\\\");\"},{\"line_number\":157,\"content\":\"    assert!((moved - stiff).abs() > 1.0, \\\"slider left stiffness at {moved}\\\");\"},{\"line_number\":229,\"content\":\"        g.age = 22;\"},{\"line_number\":236,\"content\":\"        g.age = 80;\"},{\"line_number\":245,\"content\":\"    assert_eq!(s[\\\"age\\\"], 22);\"},{\"line_number\"