          });\\n                }\\n            }\\n        }\\n        let device = if self.coarse && !self.seen_real {\\n            4\\n        } else if self.last_device == Device::Gamepad {\\n            1\\n        } else if self.lean_from == 3 {\\n            3\\n        } else if self.last_device == Device::Touch {\\n            4\\n        } else {\\n            2\\n        };\\n        let any = !self.coarse && (self.pad.any_activity || travel > 6.0 || stick.length() > 0.3 || lean.length() > 0.3);\\n        FitSample { lean, device, any, ui, extra }\\n    }\\n\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.seen_real = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.keys.insert(code);\\n                self.key_taps.insert(code);\\n            }\\n            ElementState::Released => {\\n                self.keys.remove(&code);\\n            }\\n        }\\n    }\\n\\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.mouse_active = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.mouse.insert(b);\\n                self.mouse_taps.insert(b);\\n            }\\n            ElementState::Released => {\\n                self.mouse.remove(&b);\\n            }\\n        }\\n    }\\n\\n    pub fn clear(&mut self) {\\n        self.keys.clear();\\n        self.mouse.clear();\\n    }\\n\\n    /// Reads gamepad events and state (first connected pad).\\n    pub fn poll_gamepad(&mut self) {\\n        use gilrs::{Axis, Button};\\n        let mut activity = false;\\n        let mut taps = Vec::new();\\n        // One pad state from the first connected pad, or from the pad script while it runs.\\n        let mut state: Option<PadState> = None;\\n        if let Some(g) = &mut self.gilrs {\\n            while let Some(ev) = g.next_event() {\\n                match ev.event {\\n                    gilrs::EventType::ButtonPressed(b, _) => {\\n                        taps.push(b);\\n                        activity = true;\\n                    }\\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\\n                    gilrs::EventType::Connected => log::info!(\\\"gamepad connected\\\"),\\n                    gilrs::EventType::Disconnected => log::info!(\\\"gamepad disconnected\\\"),\\n                    _ => {}\\n                }\\n            }\\n            if let Some((_, gp)) = g.gamepads().next() {\\n                const ALL: [Button; 15] = [\\n                    Button::South,\\n                    Button::East,\\n                    Button::North,\\n                    Button::West,\\n                    Button::LeftTrigger,\\n                    Button::RightTrigger,\\n                    Button::Select,\\n                    Button::Start,\\n                    Button::DPadUp,\\n                    Button::DPadDown,\\n                    Button::DPadLeft,\\n                    Button::DPadRight,\\n                    Button::LeftThumb,\\n                    Button::RightThumb,\\n                    Button::Mode,\\n                ];\\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\\n                state = Some(PadState {\\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\\n                    lt2: trig(Button::LeftTrigger2),\\n                    rt2: trig(Button::RightTrigger2),\\n                });\\n            }\\n        }\\n        if let Some(script) = &mut self.pad_script {\\n            if let Some((st, first)) = script.next() {\\n                if first {\\n                    taps.extend(st.tap.iter().copied());\\n                }\\n                activity = true;\\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\\n            }\\n        }\\n        let start = taps.contains(&Button::Start);\\n        let map = taps.contains(&Button::DPadLeft);\\n        let mut pad = Pad { start_pressed: start && !self.fit, map_pressed: map && !self.fit, taps, any_activity: activity, ..Default::default() };\\n        if let Some(st) = state {\\n            let is = |b: Button| st.held.contains(&b);\\n            pad.raw_left = st.left;\\n            pad.left = if self.fit { st.left } else { deadzone(st.left, 0.18) };\\n            pad.right = deadzone(st.right, 0.25);\\n            let mut held = 0;\\n            let layout: &[(Button, u32)] = if self.fit {\\n                &[\\n                    (Button::South, buttons::CONFIRM),\\n                    (Button::East, buttons::BACK),\\n                    (Button::West, buttons::WAVE),\\n                    (Button::North, buttons::SCHEDULE),\\n                    (Button::LeftTrigger, buttons::STEP_L),\\n                    (Button::RightTrigger, buttons::STEP_R),\\n                    (Button::DPadUp, buttons::MENU_UP),\\n                    (Button::DPadDown, buttons::MENU_DOWN),\\n                    (Button::DPadLeft, buttons::MENU_LEFT),\\n                    (Button::DPadRight, buttons::MENU_RIGHT),\\n                ]\\n            } else if self.game {\\n                &[\\n                    (Button::West, buttons::PRIMARY),\\n                    (Button::North, buttons::SECONDARY),\\n                    (Button::East, buttons::SKILL3),\\n                    (Button::RightTrigger, buttons::SKILL4),\\n                    (Button::LeftTrigger, buttons::SKILL5),\\n                    (Button::South, buttons::DODGE),\\n                    (Button::DPadUp, buttons::POTION),\\n                    (Button::DPadRight, buttons::INTERACT),\\n                ]\\n            } else {\\n                &[\\n                    (Button::South, buttons::JUMP),\\n                    (Button::East, buttons::CROUCH),\\n                    (Button::North, buttons::CRAWL),\\n                    (Button::West, buttons::USE),\\n                    (Button::DPadRight, buttons::INTERACT),\\n                ]\\n            };\\n            for (btn, action) in layout {\\n                if is(*btn) {\\n                    held |= action;\\n                }\\n            }\\n            if self.fit {\\n                if st.lt2 {\\n                    held |= buttons::STEP_L;\\n                }\\n                if st.rt2 {\\n                    held |= buttons::STEP_R;\\n                }\\n                if is(Button::Start) && !is(Button::Mode) {\\n                    held |= buttons::PAUSE;\\n                }\\n            } else {\\n                if st.rt2 {\\n                    held |= if self.game { buttons::SKILL6 } else { buttons::USE };\\n                }\\n                if st.lt2 {\\n                    held |= buttons::FOCUS;\\n                }\\n            }\\n            pad.held = held;\\n            pad.rotate = if self.game || self.fit { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\\n            // In the game the D-pad is potion / use / map / panels, not zoom.\\n            pad.zoom = if self.game || self.fit { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\\n            pad.a_held = is(Button::South);\\n            pad.x_held = is(Button::West);\\n            pad.y_held = is(Button::North);\\n            pad.back_held = is(Button::Select);\\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\\n                pad.any_activity = true;\\n            }\\n        }\\n        if pad.any_activity {\\n            self.last_device = Device::Gamepad;\\n            self.seen_real = true;\\n        }\\n        self.pad = pad;\\n    }\\n\\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\\n    pub fn move_axis(&self) -> Vec2 {\\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\\n        let b = &self.bindings;\\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\\n        v.clamp_length_max(1.0)\\n    }\\n\\n    /// Held game buttons from all devices.\\n    pub fn held(&self) -> u32 {\\n        let mut b = self.pad.held;\\n        for (bit, codes) in &self.bindings.buttons {\\n            if codes.iter().any(|c| self.keys.contains(c)) {\\n                b |= bit;\\n            }\\n        }\\n        if self.mouse.contains(&MouseButton::Left) {\\n            b |= buttons::PRIMARY;\\n        }\\n        if self.game && self.mouse.contains(&MouseButton::Right) {\\n            b |= buttons::SECONDARY;\\n        }\\n        b\\n    }\\n\\n    /// Returns (held, newly pressed since the last call).\\n    pub fn buttons(&mut self) -> (u32, u32) {\\n        let held = self.held();\\n        let mut pressed = held & !self.prev_held;\\n        for (bit, codes) in &self.bindings.buttons {\\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\\n                pressed |= bit;\\n            }\\n        }\\n        if self.mouse_taps.contains(&MouseButton::Left) {\\n            pressed |= buttons::PRIMARY;\\n        }\\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\\n            pressed |= buttons::SECONDARY;\\n        }\\n        self.key_taps.clear();\\n        self.mouse_taps.clear();\\n        self.prev_held = held;\\n        // A tap shorter than a frame still counts as held for that frame.\\n        (held | pressed, pressed)\\n    }\\n\\n    /// True if `b` was pressed since the last call (consumes the tap).\\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\\n        self.mouse_taps.remove(&b)\\n    }\\n\\n    pub fn rewind_held(&self) -> bool {\\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\\n    }\\n}\\n\\n#[cfg(test)]\\nmod pad_script_tests {\\n    use super::*;\\n\\n    #[test]\\n    fn pad_scripts_parse_and_play() {\\n        let mut p = PadScript::parse(\\\"# open the bag\\\\n2\\\\n1 tap=DPadDown\\\\n3 left=0.5,-1 hold=A,Y\\\\n\\\").unwrap();\\n        assert_eq!(p.steps.len(), 3);\\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\\n        assert_eq!(frames.len(), 6);\\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\\n        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\\n        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\\n        assert!(PadScript::parse(\\\"x tap=A\\\").is_err());\\n        assert!(PadScript::parse(\\\"1 tap=Q\\\").is_err());\\n    }\\n\\n    #[test]\\n    fn a_held_pointer_on_a_slider_row_drags_it() {\\n        let mut input = Input::new();\\n        input.cursor = Vec2::new(100.0, 40.0);\\n        input.mouse.insert(MouseButton::Left);\\n        let items = [(610u16, [0.0, 0.0, 0.5, 0.2])];\\n        let sample = input.fit_sample(1.0 / 60.0, Vec2::new(400.0, 400.0), &items, false);\\n        match sample.ui {\\n            Some(pav_core::input::UiEvent::Slider(610, v)) => assert!((v - 0.5).abs() < 0.02, \\\"{v}\\\"),\\n            other => panic!(\\\"expected a slider drag, got {other:?}\\\"),\\n        }\\n    }\\n}\\n\",\"total_lines\":825}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8888db42-14cc-4249-b408-4745057a95b6-90","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"530→        self.audio_unlocked = audio;\\n    }\\n\\n    fn touch_save(&mut self) {\\n        if self.demo || self.run == Run::Demo || self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        self.save_serial = self.save_serial.wrapping_add(1);\\n        self.write_slot();\\n    }\\n540→\\n    fn script(&self) -> &'static Script {\\n        script::script()\\n    }\\n\\n    fn goal(&self) -> u32 {\\n        match self.day {\\n            1 => 3,\\n            2 => 5,\\n            3 => 7,\\n550→            4 => 9,\\n            _ => 0,\\n        }\\n    }\\n\\n    fn day_clear(&self) -> bool {\\n        if self.free_play || self.day >= 5 {\\n            return false;\\n        }\\n        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n560→        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n            EventId::for_day(self.day).to_vec()\\n570→        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n580→                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n590→                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Name => page_labels(&s.names, 400, self.page, 6),\\n600→            Flow::Look => page_labels(&s.skins, 500, self.page, 6),\\n            Flow::Outfit => page_labels(&s.outfits, 520, self.page, 6),\\n            Flow::Schedule => self.schedule_rows(),\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n610→                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo => vec![(ACT_BACK, \\\"Back\\\".into())],\\n            Flow::Wardrobe => self.wardrobe_rows(),\\n            Flow::Calendar => self.calendar_rows(),\\n            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n620→            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n630→                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n640→                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.dev_tab {\\n            1 => page_rows(&self.jump_rows(), self.page, 4),\\n650→            2 => page_rows(&self.cheat_rows(), self.page, 4),\\n            3 => page_rows(&self.time_rows(), self.page, 4),\\n            4 => self.tuning_rows(),\\n            5 => self.view_rows(),\\n            6 => self.save_rows(),\\n            _ => {\\n                let pages: [&[(u16, &str)]; 3] = [\\n                    &[\\n                        (200, \\\"Jump\\\"),\\n                        (201, \\\"Cheats\\\"),\\n660→                        (202, \\\"Time\\\"),\\n                        (203, \\\"Tuning\\\"),\\n                        (43, \\\"Wardrobe\\\"),\\n                        (ACT_RESUME, \\\"Resume\\\"),\\n                    ],\\n                    &[\\n                        (44, \\\"Calendar\\\"),\\n                        (ACT_DEV_RESET, \\\"Reset feel\\\"),\\n                        (ACT_SETTINGS, \\\"Settings\\\"),\\n                        (ACT_ABOUT, \\\"About\\\"),\\n670→                        (ACT_HOWTO, \\\"How to Stand\\\"),\\n                        (ACT_BACK, \\\"Back\\\"),\\n                    ],\\n                    &[(204, \\\"View\\\"), (205, \\\"Save\\\"), (ACT_BACK, \\\"Back\\\")],\\n                ];\\n                let page = self.page % pages.len();\\n                pages[page].iter().map(|(id, label)| (*id, (*label).to_string())).collect()\\n            }\\n        }\\n    }\\n680→\\n    fn schedule_rows(&self) -> Vec<(u16, String)> {\\n        let evs = self.schedule_events();\\n        let per = 4;\\n        let pages = (evs.len().max(1) + per - 1) / per;\\n        let start = (self.page % pages) * per;\\n        let mut v = Vec::new();\\n        for (i, e) in evs.iter().enumerate().skip(start).take(per) {\\n            let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n            v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n690→        }\\n        if self.day_clear() {\\n            v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n        }\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n    fn jump_rows(&self) -> Vec<(u16, String)> {\\n        let mut all = Vec::new();\\n700→        for (i, e) in EventId::ALL.iter().enumerate() {\\n            all.push((220 + i as u16, e.title().to_string()));\\n        }\\n        all.push((240, \\\"Pose gusts\\\".into()));\\n        all.push((241, \\\"Step window\\\".into()));\\n        all.push((242, \\\"Brace\\\".into()));\\n        all.push((243, \\\"Long stillness\\\".into()));\\n        all.push((244, \\\"Attract\\\".into()));\\n        all.push((245, \\\"Medley\\\".into()));\\n        all.push((246, \\\"Island\\\".into()));\\n710→        for d in 1..=5 {\\n            all.push((246 + d, format!(\\\"Day {d}\\\")));\\n        }\\n        all\\n    }\\n\\n    fn cheat_rows(&self) -> Vec<(u16, String)> {\\n        let on = |flag: bool| if flag { \\\"on\\\" } else { \\\"off\\\" };\\n        vec![\\n            (230, format!(\\\"No tips {}\\\", on(self.cheat_no_tips))),\\n720→            (231, format!(\\\"Autoplay {}\\\", on(self.cheat_auto))),\\n            (232, \\\"Give minutes\\\".into()),\\n            (233, \\\"Unlock all\\\".into()),\\n            (234, \\\"All stars\\\".into()),\\n            (235, format!(\\\"Skip dialogue {}\\\", on(self.skip_lines))),\\n            (236, \\\"Win this event\\\".into()),\\n            (237, \\\"Lose this event\\\".into()),\\n        ]\\n    }\\n\\n730→    fn time_rows(&self) -> Vec<(u16, String)> {\\n        let mark = |scale: f32, label: &str| {\\n            if (self.time_scale - scale).abs() < 0.001 { format!(\\\"{label} · on\\\") } else { label.to_string() }\\n        };\\n        vec![\\n            (210, mark(0.25, \\\"0.25x\\\")),\\n            (211, mark(1.0, \\\"1x\\\")),\\n            (212, mark(2.0, \\\"2x\\\")),\\n            (213, mark(4.0, \\\"4x\\\")),\\n            (214, mark(0.0, \\\"Pause clock\\\")),\\n740→            (215, \\\"Single step\\\".into()),\\n        ]\\n    }\\n\\n    fn tuning_rows(&self) -> Vec<(u16, String)> {\\n        let mut rules = self.rules.clone();\\n        let infos = params::list(&mut rules);\\n        let per = 3;\\n        let pages = (infos.len().max(1) + per - 1) / per;\\n        let start = (self.page % pages) * per;\\n750→        let mut v: Vec<(u16, String)> = infos\\n            .iter()\\n            .enumerate()\\n            .skip(start)\\n            .take(per)\\n            .map(|(i, info)| {\\n                let label = match &info.value {\\n                    ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n                    ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                    _ => info.path.clone(),\\n760→                };\\n                (300 + i as u16, label)\\n            })\\n            .collect();\\n        v.push((ACT_DEV_RESET_GROUP, \\\"Reset group\\\".into()));\\n        v.push((ACT_DEV_RESET, \\\"Reset feel\\\".into()));\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n770→    fn wardrobe_rows(&self) -> Vec<(u16, String)> {\\n        let mut all = vec![\\n            (260, \\\"Sun cap\\\".into()),\\n            (261, \\\"Towel hood\\\".into()),\\n            (262, \\\"Crown\\\".into()),\\n            (263, \\\"Halo\\\".into()),\\n            (264, \\\"Sweatbands\\\".into()),\\n            (265, \\\"Floaties\\\".into()),\\n            (266, \\\"Belt\\\".into()),\\n        ];\\n780→        for (i, name) in self.script().outfits.iter().enumerate() {\\n            all.push((520 + i as u16, name.clone()));\\n        }\\n        page_rows(&all, self.page, 5)\\n    }\\n\\n    fn calendar_rows(&self) -> Vec<(u16, String)> {\\n        let mut v = Vec::new();\\n        for d in 1..=5u8 {\\n            let state = if self.days_completed >= d as u32 || self.stamps >= d as u8 { \\\"stamped\\\" } else { \\\"open\\\" };\\n790→            v.push((270 + d as u16, format!(\\\"Day {d} · {state}\\\")));\\n        }\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n    fn view_rows(&self) -> Vec<(u16, String)> {\\n        let on = |flag: bool| if flag { \\\"on\\\" } else { \\\"off\\\" };\\n        vec![\\n            (280, format!(\\\"Input viewer {}\\\", on(self.view_input))),\\n800→            (281, format!(\\\"Dot trace {}\\\", on(self.view_trace))),\\n            (282, format!(\\\"Engine stats {}\\\", on(self.view_stats))),\\n            (283, format!(\\\"Free camera {}\\\", on(self.view_free))),\\n            (284, format!(\\\"Ghost lanes {}\\\", on(self.view_lanes))),\\n            (ACT_BACK, \\\"Back\\\".into()),\\n        ]\\n    }\\n\\n    fn save_rows(&self) -> Vec<(u16, String)> {\\n        vec![(285, format!(\\\"Reset {}\\\", self.name)), (ACT_BACK, \\\"Back\\\".into())]\",\"content_concise\":\"530→        self.audio_unlocked = audio;\\n    }\\n\\n    fn touch_save(&mut self) {\\n        if self.demo || self.run == Run::Demo || self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        self.save_serial = self.save_serial.wrapping_add(1);\\n        self.write_slot();\\n    }\\n540→\\n    fn script(&self) -> &'static Script {\\n        script::script()\\n    }\\n\\n    fn goal(&self) -> u32 {\\n        match self.day {\\n            1 => 3,\\n            2 => 5,\\n            3 => 7,\\n550→            4 => 9,\\n            _ => 0,\\n        }\\n    }\\n\\n    fn day_clear(&self) -> bool {\\n        if self.free_play || self.day >= 5 {\\n            return false;\\n        }\\n        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n560→        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n            EventId::for_day(self.day).to_vec()\\n570→        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n580→                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n                for (i, 