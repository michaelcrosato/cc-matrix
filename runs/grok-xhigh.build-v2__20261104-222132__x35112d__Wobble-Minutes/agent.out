word` matches a row: the whole leaf 5.5 (`table` before `round_table`), in the leaf 5,\"},{\"line_number\":743,\"content\":\"            \\\"LIB/core/market_stall_with_awning\\\",\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/scripts/asset_bench/s3_briefs.toml\",\"matches\":[{\"line_number\":11,\"content\":\"text = \\\"\\\"\\\"Build a short wooden dock reaching into the water, about 400 cm long. Moor a rowboat about 300 cm long beside it, put a fish crate about 60 cm wide on the boards, and light the end with a lamp post about 180 cm tall. A fisherman stands at the edge in a looping idle.\\\"\\\"\\\"\"},{\"line_number\":13,\"content\":\"  {role = \\\"rowboat\\\", kind = \\\"prop\\\", count = 1, l = [255, 345]},\"},{\"line_number\":19,\"content\":\"needs = [\\\"prop: a small rowboat about 300 cm long\\\", \\\"prop: a lamp post about 180 cm tall that gives light\\\", \\\"prop: a fish crate about 60 cm wide\\\", \\\"material: weathered wooden planks for the dock\\\", \\\"clip: a fisherman's looping idle\\\"]\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/rooms/library_hall.toml\",\"matches\":[{\"line_number\":523,\"content\":\"LIB/core/lamp_post\"},{\"line_number\":550,\"content\":\"LIB/core/market_stall\"},{\"line_number\":568,\"content\":\"LIB/core/park_bench\"},{\"line_number\":586,\"content\":\"LIB/core/round_table\"},{\"line_number\":595,\"content\":\"LIB/core/rowboat\"},{\"line_number\":1517,\"content\":\"name = \\\"lamp_post\\\"\"},{\"line_number\":1518,\"content\":\"asset = \\\"LIB/core/lamp_post\\\"\"},{\"line_number\":1523,\"content\":\"name = \\\"figure_lamp_post\\\"\"},{\"line_number\":1530,\"content\":\"name = \\\"head_lamp_post\\\"\"},{\"line_number\":1577,\"content\":\"name = \\\"market_stall\\\"\"},{\"line_number\":1578,\"content\