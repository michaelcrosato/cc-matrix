\\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\\n        let host = cpal::default_host();\\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\\\"no sound output device\\\"))?;\\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \\\"default\\\".into());\\n710→        let supported = device.default_output_config()?;\\n        let format = supported.sample_format();\\n        let config: cpal::StreamConfig = supported.config();\\n        let rate = config.sample_rate as u32;\\n        let channels = config.channels as usize;\\n        let (tx, rx) = channel::<Cmd>();\\n        let stream = match format {\\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\\n720→            other => anyhow::bail!(\\\"unsupported sample format {other:?}\\\"),\\n        };\\n        stream.play()?;\\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, voice_gain: std::sync::Mutex::new(1.0) })\\n    }\\n\\n    pub fn set_gains(&self, music: f32, voice: f32) {\\n        if let Ok(mut v) = self.voice_gain.lock() {\\n            *v = voice;\\n        }\\n730→        let _ = self.tx.send(Cmd::MusicGain(music));\\n        let _ = self.tx.send(Cmd::VoiceGain(voice));\\n    }\\n\\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\\n        if let SimEvent::Music { song } = ev {\\n            let _ = self.tx.send(Cmd::Song(*song));\\n            return;\\n        }\\n        let bus = if matches!(ev, SimEvent::Syllable { .. }) { self.voice_gain.lock().map(|v| *v).unwrap_or(1.0) } else { 1.0 };\\n740→        let (pan, gain) = match event_pos(ev) {\\n            Some(p) => {\\n                let d = p - l.pos;\\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\\n            }\\n            None => (0.0, 1.0),\\n        };\\n        for (patch, delay) in sounds_for(ev) {\\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx * bus, delay));\\n        }\",\"content_concise\":\"700→    pub device: String,\\n    voice_gain: std::sync::Mutex<f32>,\\n}\\n\\nimpl AudioOut {\\n    pub fn start() -> anyhow::Result<Self> {\\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\\n        let host = cpal::default_host();\\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\\\"no sound output device\\\"))?;\\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \\\"default\\\".into());\\n710→        let supported = device.default_output_config()?;\\n        let format = supported.sample_format();\\n        let config: cpal::StreamConfig = supported.config();\\n        let rate = config.sample_rate as u32;\\n        let channels = config.channels as usize;\\n        let (tx, rx) = channel::<Cmd>();\\n        let stream = match format {\\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\\n720→            other => anyhow::bail!(\\\"unsupported sample format {other:?}\\\"),\\n        };\\n        stream.play()?;\\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, voice_gain: std::sync::Mutex::new(1.0) })\\n    }\\n\\n    pub fn set_gains(&self, music: f32, voice: f32) {\\n        if let Ok(mut v) = self.voice_gain.lock() {\\n            *v = voice;\\n        }\\n730→        let _ = self.tx.send(Cmd::MusicGain(music));\\n        let _ = self.tx.send(Cmd::VoiceGain(voice));\\n    }\\n\\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\\n        if let SimEvent::Music { song } 