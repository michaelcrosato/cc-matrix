t SaveDto {\\n    version: u32,\\n    slots: Vec<Slot>,\\n    settings: Settings,\\n    last_day: i64,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n230→pub struct FitGame {\\n    pub flow: Flow,\\n    run: Run,\\n    saved_run: Run,\\n    pub rules: Rules,\\n    pub settings: Settings,\\n    slots: Vec<Slot>,\\n    pub slot: u8,\\n    continuing: bool,\\n    pub name: String,\\n240→    pub skin: u8,\\n    pub outfit: u8,\\n    pub day: u8,\\n    pub day_minutes: u32,\\n    pub total_stars: u32,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/mod.rs\",\"offset\":155,\"limit\":90,\"raw_output\":\"impl Default for Settings {\\n    fn default() -> Self {\\n        Self {\\n            music: 0.10,\\n            sfx: 0.80,\\n            voice: 0.80,\\n            xbox: false,\\n            sensitivity: 1.0,\\n            wobble_assist: 0.0,\\n            rhythm_offset: 0.0,\\n            text_speed: 1.0,\\n            fullscreen: false,\\n        }\\n    }\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\n#[serde(default)]\\nstruct Slot {\\n    used: bool,\\n    name: String,\\n    skin: u8,\\n    outfit: u8,\\n    day: u8,\\n    minutes: u32,\\n    stars: u32,\\n    stamps: u8,\\n    days_completed: u32,\\n    age: u8,\\n    bests: BTreeMap<String, f32>,\\n    played: Vec<String>,\\n    ages: Vec<u8>,\\n    flips: u8,\\n    golden: bool,\\n    free_play: bool,\\n    won: bool,\\n    ghosts: BTreeMap<String, Vec<GhostSample>>,\\n    ending: String,\\n}\\n\\nimpl Default for Slot {\\n    fn default() -> Self {\\n        Self {\\n            used: false,\\n            name: \\\"Guest\\\".into(),\\n            skin: 0,\\n            outfit: 0,\\n            day: 1,\\n            minutes: 0,\\n            stars: 0,\\n            stamps: 0,\\n            days_completed: 0,\\n            age: 80,\\n           