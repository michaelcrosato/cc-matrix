 `glow_now` is set shine (enchanted helmets).\"},{\"line_number\":1326,\"content\":\"    if gear.helm != HelmKind::None {\"},{\"line_number\":1327,\"content\":\"        let hc = Color::try_hex(&gear.helm_color).unwrap_or(Color::hex(\\\"#8a8f99\\\"));\"},{\"line_number\":1331,\"content\":\"        match gear.helm {\"},{\"line_number\":1347,\"content\":\"                let full = matches!(gear.helm, HelmKind::Great);\"},{\"line_number\":1368,\"content\":\"                if gear.helm == HelmKind::Horned {\"},{\"line_number\":1377,\"content\":\"                if gear.helm == HelmKind::Halo {\"},{\"line_number\":1478,\"content\":\"    let out = if def.gear.helm == HelmKind::Great { 1.13 } else { 0.9 };\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-624aab91-4ad8-4f56-8882-b17f9f6da160-142","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,95,95,120,51,53,49,49,50,100,47,119,111,114,107,34,62,10,78,111,32,109,97,116,99,104,101,115,32,102,111,117,110,100,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":1,\"match_count\":0,\"file_matches\":[]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"cb1c1751-5d8f-4a3f-9f0b-ec8696466627"}
