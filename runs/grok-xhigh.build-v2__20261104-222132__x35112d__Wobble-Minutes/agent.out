ert!(sim.rewind_to(tick));\\n    assert_eq!(sim.state_hash(), hash);\\n\\n    let mut again = Sim::new(\\\"starter\\\", 3).unwrap();\\n    for f in sim.recording.iter() {\\n        again.step(f);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n60→}\\n\\n#[test]\\nfn game_keys_name_one_scene_each() {\\n    let names = pav_core::scenes::names();\\n    for g in GAMES {\\n        assert_eq!(names.iter().filter(|n| *n == g.key).count(), 1, \\\"'{}' is also a scene or room key\\\", g.key);\\n        assert!(!g.key.contains('/'), \\\"'{}': `<key>/<rest>` passes the rest to the game\\\", g.key);\\n        assert!(Sim::new(g.key, 1).unwrap().play().is_some_and(|p| p.key() == g.key));\\n    }\\n70→}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/tests/games.rs\",\"offset\":50,\"limit\":40,\"raw_output\":\"    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90));\\n    assert!(sim.rewind_to(tick));\\n    assert_eq!(sim.state_hash(), hash);\\n\\n    let mut again = Sim::new(\\\"starter\\\", 3).unwrap();\\n    for f in sim.recording.iter() {\\n        again.step(f);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn game_keys_name_one_scene_each() {\\n    let names = pav_core::scenes::names();\\n    for g in GAMES {\\n        assert_eq!(names.iter().filter(|n| *n == g.key).count(), 1, \\\"'{}' is also a scene or room key\\\", g.key);\\n        assert!(!g.key.contains('/'), \\\"'{}': `<key>/<rest>` passes the rest to the game\\\", g.key);\\n        assert!(Sim::new(g.key, 1).unwrap().play().is_some_and(|p| p.key() == g.key));\\n    }\\n}\\n\",\"total_lines\":70}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"b44f5afd-df05-4e9a-b10a-cd321b06674a"}
