[2] * css_w,\\n                    \\\"h\\\": it.rect[3] * css_h,\\n                })\\n            })\\n2400→            .collect::<Vec<_>>()\\n    });\\n    let ui_json = serde_json::to_string(&items.unwrap_or_default()).unwrap_or_else(|_| \\\"[]\\\".into());\\n    crate::weblink::publish(status, &ui_json);\\n}\\n\\nfn apply_browser_save(host: &SimHost, status: Option<&str>, loaded: &mut bool, serial: &mut u32) {\\n    #[cfg(not(target_arch = \\\"wasm32\\\"))]\\n    {\\n        let _ = (host, status, loaded, serial);\\n2410→    }\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    {\\n        let Some(status) = status else { return };\\n        let Ok(v) = serde_json::from_str::<serde_json::Value>(status) else { return };\\n        let now = v.get(\\\"save_serial\\\").and_then(|n| n.as_u64()).unwrap_or(0) as u32;\\n        if !*loaded {\\n            *loaded = true;\\n            *serial = now;\\n            let saved = crate::weblink::storage_get(\\\"wobble-minutes-v1\\\");\\n2420→            let today = crate::weblink::boot_parts().2.unwrap_or_else(crate::weblink::epoch_day);\\n            if saved.is_some() || today != 0 {\\n                host.exec(move |sim| {\\n                    let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<pav_core::games::fit::FitGame>()) else {\\n                        return;\\n                    };\\n                    if let Some(text) = saved {\\n                        if g.import_save(&text) {\\n                            g.flow = pav_core::games::fit::Flow::Title;\\n                        }\\n2430→                    }\\n                    if today != 0 {\\n                        g.today = today;\\n                    }\\n                });\\n            }\\n            return;\\n        }\\n        if now != *serial {\\n            *serial = now;\\n2440→            if let Some(blob) = host\\n                .query(|sim| {\\n                    sim.state.play.as_mut().and_then(|p| p.get_mut::<pav_core::games::fit::FitGame>()).map(|g| g.export_save())\\n                })\\n                .flatten()\\n            {\\n                crate::weblink::storage_set(\\\"wobble-minutes-v1\\\", &blob);\\n            }\\n        }\\n    }\\n2450→}\\n\\nfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\\n    let mut v: Vec<RoomEntry> = sim\\n        .state\\n        .world\\n        .rooms\\n        .iter()\\n        .map(|r| RoomEntry {\\n            key: r.key.clone(),\\n2460→            name: if r.def.name.is_empty() { r.key.clone() } else { r.def.name.clone() },\\n            wing: r.def.wing.clone(),\\n            about: r.def.about.clone(),\\n            ask: r.def.learn.ask.clone(),\\n        })\\n        .collect();\\n    v.sort_by(|a, b| (&a.wing, &a.name).cmp(&(&b.wing, &b.name)));\\n    v\\n}\\n\",\"content_concise\":\"2380→\\nfn publish_stay(gfx: &Gfx, hud: &pav_core::frame::HudFrame) {\\n    let Some(status) = hud.status.as_deref() else { return };\\n    let scale = (gfx.window.scale_factor() as f32).max(0.01);\\n    let (pw, ph) = gfx.size();\\n    let css_w = pw as f32 / scale;\\n    let css_h = ph as f32 / scale;\\n    let items = hud.fit.as_ref().map(|ui| {\\n        ui.items\\n            .iter()\\n2390→            .map(|it| {\\n                serde_json::json!({\\n                    \\\"id\\\": it.id,\\n                    \\\"label\\\": it.label,\\n                    \\\"x\\\": it.rect[0] * css_w,\\n                    \\\"y\\\": it.rect[1] * css_h,\\n                    \\\"w\\\": it.rect[2] * css_w,\\n                    \\\"h\\\": it.rect[3] * css_h,\\n                })\\n            })\\n2400→            .collect::<Vec<_>>()\\n    });\\n    let ui_json = serde_json::to_string(&items.unwrap_or_default()).unwrap_or_else(|_| \\\"[]\\\".into());\\n    crate::weblink::publish(status, &ui_json);\\n}\\n\\nfn apply_browser_save(host: &SimHost, status: Option<&str>, loaded: &mut bool, serial: &mut u32) {\\n    #[cfg(not(target_arch = \\\"wasm32\\\"))]\\n    {\\