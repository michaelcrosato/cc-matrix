0,0], [13])\\\")\\n    base_tick = (status(page) or {}).get(\\\"tick\\\") or 0\\n    s = None\\n    # Hold D-pad down until a sim tick actually samples it. A stalled frame is not a miss.\\n    for _ in range(40):\\n        page.wait_for_timeout(200)\\n        s = status(page)\\n        if s and s.get(\\\"menu_focus\\\") == 1:\\n            break\\n        if s and (s.get(\\\"tick\\\") or 0) > base_tick + 40:\\n            break\\n    page.evaluate(\\\"() => window.__setPad([0,0,0,0], [])\\\")\\n    if not s or s.get(\\\"menu_focus\\\") != 1:\\n        return fail(f\\\"pad did not move focus: {None if not s else s.get('menu_focus')} prompt {None if not s else s.get('prompt')}\\\")\\n    if s.get(\\\"prompt\\\") != \\\"Cross\\\":\\n        return fail(f\\\"pad prompt {s.get('prompt')}\\\")\\n    page.keyboard.down(\\\"ArrowDown\\\")\\n    s = wait_status_pred(page, lambda st: st.get(\\\"prompt\\\") == \\\"Space\\\" and st.get(\\\"menu_focus\\\") == 2, ms=2000)\\n    page.keyboard.up(\\\"ArrowDown\\\")\\n    if not s or s.get(\\\"prompt\\\") != \\\"Space\\\":\\n        return fail(f\\\"keyboard prompt {None if not s else s.get('prompt')}\\\")\\n    if s.get(\\\"menu_focus\\\") != 2:\\n\",\"total_lines\":431}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"11840063-a38b-4d5d-bb21-d6f2f3768c6a"}
{"type":"assistant","message":{"id":"msg_714","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Menu items need closer inspection. Names and outfits are limited to six.\n\nChecking tick functions and menu selection logic for bugs. The `age_moves_the_right_way` test validates the age formula directly rather than through the morning check. This may conflict with the verification plan's requirement for age direction and 18–99 bounds.","signature":""},{"type":"tool_use","id":"call-97976fae-9381-4eec-aeb3-b88311fa0ed5-31","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/events.rs","offset":540,"limit":750}},{"type":"tool_use","id":"call-97976fae-9381-4eec-aeb3-b88311fa0ed5-32","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/mod.rs","offset":520,"limit":450}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4301,"output_tokens":372,"cache_read_input_tokens":71680,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"5fa182bd-311b-416e-92ed-543d36a5976c"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-97976fae-9381-4eec-aeb3-b88311fa0ed5-31","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"540→        3 => (pd(bal, rules, Vec2::ZERO), buttons::STEP_L | buttons::STEP_R),\\n        _ => (pd(bal, rules, Vec2::ZERO), 0),\\n    }\\n}\\n\\nfn ring_center(t: f32) -> Vec2 {\\n    let a = 0.35;\\n    Vec2::new(a * (std::f32::consts::TAU * 0.12 * t).sin(), a * (std::f32::consts::TAU * 0.09 * t + 1.3).sin())\\n}\\n\\n550→fn squat_guide(t: f32) -> f32 {\\n    let c = (t / 3.2).fract();\\n    if c < 2.0 / 3.2 {\\n        c / (2.0 / 3.2)\\n    } else {\\n        1.0 - (c - 2.0 / 3.2) / (1.2 / 3.2)\\n    }\\n}\\n\\nfn breath_guide(t: f32) -> f32 {\\n560→    let c = (t / 8.0).fract();\\n    if c < 0.5 { c * 2.0 } else { 1.0 - (c - 0.5) * 2.0 }\\n}\\n\\npub fn tick(act: &mut Activity, bal: &mut BalanceCore, sim: &mut Sim, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    if act.done {\\n        return;\\n    }\\n    let amp = rules.wobble * act.amp_scale * if act.kind == EventId::Plank { 1.0 + act.t / 30.0 } else { 1.0 };\\n    bal.amp = amp;\\n570→    bal.gust = if act.kind == EventId::BigStand && act.phase == 1 {\\n        Vec2::new(rules.big_gust * (act.sub / 20.0) * (act.sub * 1.7).sin(), 0.0)\\n    } else if act.kind == EventId::Paddle && (act.t * 0.35).sin() > 0.85 {\\n        Vec2::new(rules.gust * 0.15, 0.0)\\n    } else {\\n        Vec2::ZERO\\n    };\\n    bal.step(lean, dt, rules, &mut sim.state.rng);\\n    if bal.tipped {\\n        act.tips += 1;\\n580→        act.lock = 1.2;\\n        events.push(SimEvent::Sfx { id: 7, gain: 0.8, pitch: 1.0 });\\n        if act.kind == EventId::Pose {\\n            act.lock = 1.5;\\n            act.streak = 0.0;\\n        }\\n    }\\n    act.lock = (act.lock - dt).max(0.0);\\n    if act.samples.len() < 80 && sim.state.tick.is_multiple_of(6) {\\n        act.samples.push(GhostSample { t: act.t, lean: [lean.x, lean.y], x: act.px, z: act.pz });\\n590→    }\\n    match act.kind {\\n        EventId::Check => tick_check(act, bal, pressed, dt),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n600→        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n610→\\nfn finish_score(act: &mut Activity) {\\n    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n620→            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n630→                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n640→                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n650→                act.hold += dt;\\n            } else {\\n                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n660→            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n670→            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n680→            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n            }\\n            act.sub += dt;\\n690→            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n700→\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n710→    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n        if finale {\\n            act.phase_scores.push(act.score);\\n720→        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n730→    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\\n    } else {\\n        act.streak = 0.0;\\n740→    }\\n    let mult = 1.0 + (act.streak / 2.0).floor().min(3.0);\\n    if inside {\\n        act.acc += dt * mult;\\n    }\\n    act.t += dt;\\n    if act.t >= pose_len * 3.0 {\\n        act.score = (act.acc / (pose_len * 3.0) * 700.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n750→}\\n\\nfn tick_squat(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    act.guide = squat_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.depth = (act.depth + dt / 2.0).min(1.0);\\n    } else {\\n        act.depth = (act.depth - dt / 1.0).max(0.0);\\n    }\\n    let bottom = (act.t / 3.2).fract();\\n760→    let was = ((act.t - dt) / 3.2).fract();\\n    // A rep completes as the guide returns to the top.\\n    if was > 0.8 && bottom < 0.2 && act.reps < rules.squat_reps as u8 {\\n        let timing = (1.0 - (act.depth - 0.15).abs()).clamp(0.0, 1.0);\\n        // lungs keeps the deepest point of this rep. A rep that never left the top barely scores.\\n        let deep = if act.lungs > 0.75 { 1.0 } else { (act.lungs / 0.75).clamp(0.0, 1.0) };\\n        let band = if act.hold < 0.25 { 1.0 } else { 0.3 };\\n        let moved = if deep > 0.2 { 0.25 * band } else { 0.0 };\\n        act.acc += 0.75 * deep.max(timing * 0.12) + moved;\\n        act.reps += 1;\\n770→        act.lungs = 0.0;\\n        act.hold = 0.0;\\n        events.push(SimEvent::Sfx { id: 15, gain: 0.7, pitch: 1.0 + act.reps as f32 * 0.03 });\\n        if act.reps == rules.squat_reps as u8 {\\n            act.gag = true;\\n        }\\n    }\\n    if act.depth > act.lungs {\\n        act.lungs = act.depth;\\n    }\\n780→    if bal.cob.x.abs() >= 0.25 {\\n        act.hold += dt;\\n    }\\n    act.t += dt;\\n    let need = rules.squat_reps as f32 * 3.2 + 0.5;\\n    if act.t >= need || act.reps >= rules.squat_reps as u8 && bottom < 0.15 && act.t > 3.0 {\\n        let n = rules.squat_reps.max(1) as f32;\\n        act.score = (act.acc / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n790→}\\n\\nfn braced(held: u32) -> bool {\\n    let l = held & (buttons::STEP_L) != 0;\\n    let r = held & (buttons::STEP_R) != 0;\\n    l && r\\n}\\n\\nfn tick_plank(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules) {\\n    let span = rules.plank_secs.max(1.0);\\n800→    let radius = 0.40 + (0.20 - 0.40) * (act.t / span).clamp(0.0, 1.0);\\n    // The card says brace. A fraction of a second covers the handoff from the countdown.\\n    if act.t > 0.6 && !braced(held) {\\n        act.flopped = true;\\n    }\\n    if bal.cob.length() > radius {\\n        act.out_t += dt;\\n        if act.out_t > 1.0 {\\n            act.flopped = true;\\n        }\\n810→    } else {\\n        act.out_t = 0.0;\\n    }\\n    if act.flopped {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n        return;\\n    }\\n    act.survived += dt;\\n    act.t += dt;\\n820→    if act.t >= span {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_step(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules) {\\n    let total = act.notes.len().max(1) as f32;\\n    while let Some(n) = act.notes.get(act.note_i as usize) {\\n        if act.t + 0.02 < n[0] {\\n830→            break;\\n        }\\n        if act.t - n[0] > rules.rhythm_good {\\n            act.note_i += 1;\\n            continue;\\n        }\\n        let lane = n[1] as u8;\\n        let l = pressed & buttons::STEP_L != 0;\\n        let r = pressed & buttons::STEP_R != 0;\\n        let ok = match lane {\\n840→            0 => l,\\n            1 => r,\\n            _ => l && r,\\n        };\\n        if ok {\\n            let err = (act.t - n[0]).abs();\\n            if err <= rules.rhythm_perfect {\\n                act.hits += 1;\\n                act.acc += 1.0;\\n            } else {\\n850→                act.hits += 1;\\n                act.acc += 0.6;\\n            }\\n            act.note_i += 1;\\n        } else if act.t > n[0] + rules.rhythm_good {\\n            act.note_i += 1;\\n        } else {\\n            break;\\n        }\\n    }\\n860→    act.t += dt;\\n    if act.t >= rules.step_secs {\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_floatie(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if ((act.t / 15.0).floor() as i32) % 2 == 1 {\\n        act.dir = -1.0;\\n870→    } else {\\n        act.dir = 1.0;\\n    }\\n    if lean.length() > 0.4 {\\n        let ang = lean.y.atan2(lean.x);\\n        if act.have_ang {\\n            let mut d = ang - act.prev_ang;\\n            if d > std::f32::consts::PI {\\n                d -= std::f32::consts::TAU;\\n            }\\n880→            if d < -std::f32::consts::PI {\\n                d += std::f32::consts::TAU;\\n            }\\n            let w = d / dt.max(1e-4);\\n            act.spin += (w - act.spin) * 0.35;\\n        }\\n        act.prev_ang = ang;\\n        act.have_ang = true;\\n    } else {\\n        act.spin *= 0.9;\\n890→    }\\n    let scale = rules.spin_band_scale;\\n    let s = act.spin * act.dir;\\n    let in_band = s > rules.spin_lo / scale && s < rules.spin_hi * scale;\\n    if in_band {\\n        act.band_t += dt;\\n    }\\n    let catches = [6.0_f32, 13.0, 20.0, 27.0, 34.0, 41.0, 48.0];\\n    if let Some(t) = catches.get(act.catch_i as usize) {\\n        let want_l = act.catch_i % 2 == 0;\\n900→        let got = if want_l { pressed & buttons::STEP_L != 0 } else { pressed & buttons::STEP_R != 0 };\\n        if got && (act.t - t).abs() < 0.25 {\\n            act.rings = (act.rings + 1).min(7);\\n            act.catch_i += 1;\\n        } else if act.t > t + 0.25 {\\n            act.catch_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    if act.t >= rules.floatie_secs {\\n910→        let rings = act.rings as f32 / 7.0;\\n        let band = act.band_t / rules.floatie_secs;\\n        act.score = (rings * band * 1400.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_lap(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if pressed & buttons::STEP_L != 0 && act.last_side != -1 {\\n        act.steps += 1;\\n920→        act.last_side = -1;\\n        act.step_times.push(act.t);\\n    }\\n    if pressed & buttons::STEP_R != 0 && act.last_side != 1 {\\n        act.steps += 1;\\n        act.last_side = 1;\\n        act.step_times.push(act.t);\\n    }\\n    act.step_times.retain(|t| act.t - *t < 1.0);\\n    let rate = act.step_times.len() as f32;\\n930→    if (1.6..=2.4).contains(&rate) && act.t > 1.0 {\\n        act.zone_t += dt;\\n    }\\n    act.lateral = (act.lateral + lean.x * 1.2 * dt).clamp(-1.2, 1.2);\\n    let ribbon = ribbon_at(act.t);\\n    if ribbon.abs() > 0.2 && (act.lateral - ribbon).abs() < 0.35 && act.t.fract() < dt + 0.02 {\\n        // once per ribbon window, roughly\\n        if act.ribbons < 5 && (act.t - ribbon_time(act.ribbons)).abs() < 1.0 {\\n            act.ribbons += 1;\\n        }\\n940→    }\\n    let crab = crab_at(act.t);\\n    if crab.abs() > 0.2 && (act.lateral - crab).abs() < 0.25 {\\n        act.bumps += 1;\\n        act.lateral = 0.0;\\n    }\\n    act.px = act.lateral;\\n    act.pz = act.t;\\n    act.t += dt;\\n    if act.t >= rules.lap_secs {\\n950→        let zone = act.zone_t / rules.lap_secs;\\n        act.score = (zone * 800.0 + act.ribbons as f32 * 50.0 - act.bumps as f32 * 40.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn ribbon_time(i: u8) -> f32 {\\n    [8.0, 22.0, 40.0, 58.0, 75.0][i as usize]\\n}\\n\\n960→fn crab_at(t: f32) -> f32 {\\n    let spots = [15.0_f32, 33.0, 50.0, 68.0];\\n    let xs = [-0.8, 0.85, -0.6, 0.7];\\n    for (i, s) in spots.iter().enumerate() {\\n        if (t - s).abs() < 0.8 {\\n            return xs[i];\\n        }\\n    }\\n    0.0\\n}\\n970→\\nfn tick_tide(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, rng: &mut Rng) {\\n    let tilt = if bal.cob.length() > 0.18 { bal.cob } else { Vec2::ZERO };\\n    let g = 9.0;\\n    let friction = 3.2;\\n    let mut potted_now = 0;\\n    for s in &mut act.shells {\\n        if s.pot {\\n            continue;\\n        }\\n980→        let ax = tilt.x * g - friction * s.vx;\\n        let az = tilt.y * g - friction * s.vz;\\n        s.vx += ax * dt;\\n        s.vz += az * dt;\\n        s.x += s.vx * dt;\\n        s.z += s.vz * dt;\\n        if s.x.abs() > 2.2 {\\n            s.x = s.x.clamp(-2.2, 2.2);\\n            s.vx *= -0.5;\\n        }\\n990→        if s.z.abs() > 1.6 {\\n            s.z = s.z.clamp(-1.6, 1.6);\\n            s.vz *= -0.5;\\n        }\\n        for p in &act.pools {\\n            let dx = s.x - p[0];\\n            let dz = s.z - p[1];\\n            let sp = (s.vx * s.vx + s.vz * s.vz).sqrt();\\n            if dx * dx + dz * dz < 0.28 * 0.28 && sp < 3.5 {\\n                s.pot = true;\\n1000→                potted_now += 1;\\n                break;\\n            }\\n        }\\n    }\\n    act.potted += potted_now;\\n    // Board 2 pool drifts.\\n    if act.board == 1 {\\n        if let Some(p) = act.pools.first_mut() {\\n            p[0] = (act.sub * 0.6).sin() * 0.8;\\n1010→        }\\n    }\\n    act.sub += dt;\\n    act.t += dt;\\n    if act.sub >= rules.tide_secs {\\n        if act.board < 2 {\\n            act.setup_board(act.board + 1, rng);\\n        } else {\\n            let total = 3.0 + 5.0 + 7.0;\\n            let time_bonus = (1.0 - (act.t / (rules.tide_secs * 3.0)).clamp(0.0, 1.0)) * 150.0;\\n1020→            act.score = (act.potted as f32 / total * 850.0 + time_bonus).clamp(0.0, 1000.0);\\n            act.done = true;\\n        }\\n    }\\n}\\n\\nfn tick_paddle(act: &mut Activity, lean: Vec2, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let forward = lean.y.clamp(-1.0, 1.0);\\n    let target = if forward > 0.0 { forward * 6.5 } else { forward * 2.0 };\\n    act.speed += (target - act.speed) * dt * 2.2;\\n1030→    act.speed = act.speed.max(0.0);\\n    act.pz += act.speed * dt;\\n    act.px = (act.px + lean.x * 3.2 * dt).clamp(-2.2, 2.2);\\n    if act.t.fract() < dt {\\n        events.push(SimEvent::Wake { pos: glam::Vec3::new(act.px, 0.0, act.pz) });\\n    }\\n    if let Some(g) = act.gates.get(act.gate_i as usize) {\\n        if act.pz >= g[0] {\\n            if (act.px - g[1]).abs() > 0.7 {\\n                act.missed += 1;\\n1040→            }\\n            act.gate_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    let finished = act.pz >= 56.0 || act.t >= rules.paddle_secs;\\n    if finished {\\n        let mut t = if act.pz >= 56.0 { act.t } else { rules.paddle_secs };\\n        t += act.missed as f32 * 2.0;\\n        let par = rules.paddle_par;\\n1050→        let raw = (1.6 * par - t) / (0.8 * par);\\n        act.score = (raw.clamp(0.0, 1.0) * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_tray(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let mut kick = 0.0;\\n    for s in &act.jolts {\\n        let d = act.t - s[0];\\n1060→        if d > 0.0 && d <= dt + 1e-4 {\\n            kick += s[1] * 0.48;\\n        }\\n    }\\n    let tilt = bal.cob.x;\\n    for i in 0..5 {\\n        if !act.glass_ok[i] {\\n            continue;\\n        }\\n        act.glasses[i] += kick + tilt * dt * 2.2;\\n1070→        if act.glasses[i].abs() > 1.0 {\\n            act.glass_ok[i] = false;\\n            events.push(SimEvent::Sfx { id: 19, gain: 0.8, pitch: 1.0 });\\n        }\\n    }\\n    act.t += dt;\\n    act.pz = act.t;\\n    if act.t >= rules.tray_secs {\\n        let kept = act.glass_ok.iter().filter(|g| **g).count() as f32;\\n        let bonus = if kept == 5.0 { 0.0 } else { 0.0 };\\n1080→        act.score = (kept * 200.0 + bonus).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_cannon(act: &mut Activity, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let _ = rules;\\n    if !act.leaping {\\n        let phase = act.t / 1.2;\\n        let s = (phase * std::f32::consts::TAU).sin();\\n1090→        let prev = ((act.t - dt) / 1.2 * std::f32::consts::TAU).sin();\\n        let bottom = s < -0.9 && s > prev;\\n        if bottom && pressed & buttons::CONFIRM != 0 && act.power < 4.0 {\\n            act.power += 1.0;\\n            events.push(SimEvent::Sfx { id: 14, gain: 0.6, pitch: 0.8 + act.power * 0.1 });\\n            if act.power >= 4.0 {\\n                act.leaping = true;\\n                act.air = 0.0;\\n                act.tuck = 0.0;\\n            }\\n1100→        }\\n    } else {\\n        act.air += dt;\\n        if held & buttons::CONFIRM != 0 {\\n            act.tuck = (act.tuck + dt / 0.35).min(1.0);\\n        }\\n        act.px += lean.x * dt;\\n        let s = (act.air * 3.0).sin();\\n        let prev = ((act.air - dt) * 3.0).sin();\\n        // Landing is the way down, while the tuck still counts. Waiting for the splash to flatten scored nothing.\\n1110→        let landing = act.air > 0.55 && s > 0.0 && s < prev && s < 0.5;\\n        if landing {\\n            let timing = (1.0 - (act.air - 0.9).abs() / 0.35).clamp(0.0, 1.0);\\n            let sc = ((0.35 + 0.65 * act.tuck) * (0.4 + 0.6 * timing) * rules.bounce_gain).clamp(0.0, 1.0);\\n            act.dive_scores.push(sc);\\n            act.dives += 1;\\n            events.push(SimEvent::BigSplash { pos: glam::Vec3::new(act.px, 0.0, 2.0), size: 1.2 + act.tuck });\\n            act.leaping = false;\\n            act.power = 0.0;\\n            act.air = 0.0;\\n1120→            act.tuck = 0.0;\\n        }\\n    }\\n    act.t += dt;\\n    if act.dives >= 3 || act.t >= rules.cannon_secs {\\n        let n = 3.0;\\n        let sum: f32 = act.dive_scores.iter().sum();\\n        act.score = (sum / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n1130→}\\n\\nfn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\\n    let _ = lean;\\n    match act.phase {\\n        0 => {\\n            let before = act.t;\\n            tick_breath(act, bal, held, dt, rules, true);\\n            act.t = before + dt;\\n            if act.t >= 32.0 {\\n1140→                act.phase = 1;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.done = false;\\n            }\\n        }\\n        1 => {\\n            let c = ring_center(act.sub);\\n            let inside = (bal.cob - c).length() < 0.28;\\n            if inside {\\n1150→                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.note_i = 0;\\n1160→                // Use the first notes, time-shifted into this phase by rewriting a local clock.\\n                act.t_shift_notes();\\n            }\\n        }\\n        2 => {\\n            let local_pressed = pressed;\\n            let start_t = act.t;\\n            // tick_step uses act.t against note times. Notes were shifted.\\n            let saved_dur = rules.step_secs;\\n            let _ = saved_dur;\\n1170→            tick_step_window(act, local_pressed, dt, rules, 40.0);\\n            if act.t - start_t < dt * 0.5 {\\n                act.t = start_t + dt;\\n            }\\n            act.sub += dt;\\n            if act.sub >= 40.0 {\\n                act.phase_scores.push(act.score);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n                act.done = false;\\n1180→                act.flopped = false;\\n                act.survived = 0.0;\\n            }\\n        }\\n        3 => {\\n            if braced(held) && bal.cob.length() < 0.45 {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n1190→            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 4;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n            }\\n        }\\n        _ => {\\n            if act.sub >= 15.0 && pressed != 0 {\\n1200→                act.forfeit = true;\\n            }\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 30.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                let quiet = (1.0 - mean / 0.2).clamp(0.0, 1.0);\\n                let mut s = quiet * 1000.0;\\n1210→                if !act.forfeit {\\n                    s = (s + 200.0).min(1000.0);\\n                } else {\\n                    s *= 0.5;\\n                }\\n                act.phase_scores.push(s);\\n                let n = act.phase_scores.len().max(1) as f32;\\n                let sum: f32 = act.phase_scores.iter().copied().sum();\\n                act.score = (sum / n).clamp(0.0, 1000.0);\\n                // Tips cost score but never end the run.\\n1220→                act.score = (act.score - act.tips as f32 * 15.0).max(0.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Activity {\\n    fn t_shift_notes(&mut self) {\\n        if self.notes.is_empty() {\\n1230→            return;\\n        }\\n        let t0 = self.notes[0][0];\\n        for n in &mut self.notes {\\n            n[0] = self.t + (n[0] - t0);\\n        }\\n        self.note_i = 0;\\n        self.acc = 0.0;\\n        self.hits = 0;\\n    }\\n1240→}\\n\\nfn tick_step_window(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules, window: f32) {\\n    let total = act.notes.len().max(1) as f32;\\n    let t0 = act.t;\\n    tick_step(act, pressed, dt, rules);\\n    // tick_step may mark done at step_secs. The finale uses its own clock.\\n    if act.done && act.kind == EventId::BigStand {\\n        act.done = false;\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n1250→    }\\n    if act.t < t0 + dt * 0.5 {\\n        act.t = t0 + dt;\\n    }\\n    let _ = window;\\n}\\n\",\"content_concise\":\"540→        3 => (pd(bal, rules, Vec2::ZERO), buttons::STEP_L | buttons::STEP_R),\\n        _ => (pd(bal, rules, Vec2::ZERO), 0),\\n    }\\n}\\n\\nfn ring_center(t: f32) -> Vec2 {\\n    let a = 0.35;\\n    Vec2::new(a * (std::f32::consts::TAU * 0.12 * t).sin(), a * (std::f32::consts::TAU * 0.09 * t + 1.3).sin())\\n}\\n\\n550→fn squat_guide(t: f32) -> f32 {\\n    let c = (t / 3.2).fract();\\n    if c < 2.0 / 3.2 {\\n        c / (2.0 / 3.2)\\n    } else {\\n        1.0 - (c - 2.0 / 3.2) / (1.2 / 3.2)\\n    }\\n}\\n\\nfn breath_guide(t: f32) -> f32 {\\n560→    let c = (t / 8.0).fract();\\n    if c < 0.5 { c * 2.0 } else { 1.0 - (c - 0.5) * 2.0 }\\n}\\n\\npub fn tick(act: &mut Activity, bal: &mut BalanceCore, sim: &mut Sim, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    if act.done {\\n        return;\\n    }\\n    let amp = rules.wobble * act.amp_scale * if act.kind == EventId::Plank { 1.0 + act.t / 30.0 } else { 1.0 };\\n    bal.amp = amp;\\n570→    bal.gust = if act.kind == EventId::BigStand && act.phase == 1 {\\n        Vec2::new(rules.big_gust * (act.sub / 20.0) * (act.sub * 1.7).sin(), 0.0)\\n    } else if act.kind == EventId::Paddle && (act.t * 0.35).sin() > 0.85 {\\n        Vec2::new(rules.gust * 0.15, 0.0)\\n    } else {\\n        Vec2::ZERO\\n    };\\n    bal.step(lean, dt, rules, &mut sim.state.rng);\\n    if bal.tipped {\\n        act.tips += 1;\\n580→        act.lock = 1.2;\\n        events.push(SimEvent::Sfx { id: 7, gain: 0.8, pitch: 1.0 });\\n        if act.kind == EventId::Pose {\\n            act.lock = 1.5;\\n            act.streak = 0.0;\\n        }\\n    }\\n    act.lock = (act.lock - dt).max(0.0);\\n    if act.samples.len() < 80 && sim.state.tick.is_multiple_of(6) {\\n        act.samples.push(GhostSample { t: act.t, lean: [lean.x, lean.y], x: act.px, z: act.pz });\\n590→    }\\n    match act.kind {\\n        EventId::Check => tick_check(act, bal, pressed, dt),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n600→        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n610→\\nfn finish_score(act: &mut Activity) {\\n    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n620→            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n630→                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n640→                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n650→                act.hold += dt;\\n            } else {\\n                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n660→            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n670→            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n680→            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n            }\\n            act.sub += dt;\\n690→            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n700→\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n710→    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n        if finale {\\n            act.phase_scores.push(act.score);\\n720→        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n730→    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\\n    } else {\\n        act.streak = 0.0;\\n740→    }\\n    let mult = 1.0 + (act.streak / 2.0).floor().min(3.0);\\n    if inside {\\n        act.acc += dt * mult;\\n    }\\n    act.t += dt;\\n    if act.t >= pose_len * 3.0 {\\n        act.score = (act.acc / (pose_len * 3.0) * 700.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n750→}\\n\\nfn tick_squat(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    act.guide = squat_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.depth = (act.depth + dt / 2.0).min(1.0);\\n    } else {\\n        act.depth = (act.depth - dt / 1.0).max(0.0);\\n    }\\n    let bottom = (act.t / 3.2).fract();\\n760→    let was = ((act.t - dt) / 3.2).fract();\\n    // A rep completes as the guide returns to the top.\\n    if was > 0.8 && bottom < 0.2 && act.reps < rules.squat_reps as u8 {\\n        let timing = (1.0 - (act.depth - 0.15).abs()).clamp(0.0, 1.0);\\n        // lungs keeps the deepest point of this rep. A rep that never left the top barely scores.\\n        let deep = if act.lungs > 0.75 { 1.0 } else { (act.lungs / 0.75).clamp(0.0, 1.0) };\\n        let band = if act.hold < 0.25 { 1.0 } else { 0.3 };\\n        let moved = if deep > 0.2 { 0.25 * band } else { 0.0 };\\n        act.acc += 0.75 * deep.max(timing * 0.12) + moved;\\n        act.reps += 1;\\n770→        act.lungs = 0.0;\\n        act.hold = 0.0;\\n        events.push(SimEvent::Sfx { id: 15, gain: 0.7, pitch: 1.0 + act.reps as f32 * 0.03 });\\n        if act.reps == rules.squat_reps as u8 {\\n            act.gag = true;\\n        }\\n    }\\n    if act.depth > act.lungs {\\n        act.lungs = act.depth;\\n    }\\n780→    if bal.cob.x.abs() >= 0.25 {\\n        act.hold += dt;\\n    }\\n    act.t += dt;\\n    let need = rules.squat_reps as f32 * 3.2 + 0.5;\\n    if act.t >= need || act.reps >= rules.squat_reps as u8 && bottom < 0.15 && act.t > 3.0 {\\n        let n = rules.squat_reps.max(1) as f32;\\n        act.score = (act.acc / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n790→}\\n\\nfn braced(held: u32) -> bool {\\n    let l = held & (buttons::STEP_L) != 0;\\n    let r = held & (buttons::STEP_R) != 0;\\n    l && r\\n}\\n\\nfn tick_plank(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules) {\\n    let span = rules.plank_secs.max(1.0);\\n800→    let radius = 0.40 + (0.20 - 0.40) * (act.t / span).clamp(0.0, 1.0);\\n    // The card says brace. A fraction of a second covers the handoff from the countdown.\\n    if act.t > 0.6 && !braced(held) {\\n        act.flopped = true;\\n    }\\n    if bal.cob.length() > radius {\\n        act.out_t += dt;\\n        if act.out_t > 1.0 {\\n            act.flopped = true;\\n        }\\n810→    } else {\\n        act.out_t = 0.0;\\n    }\\n    if act.flopped {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n        return;\\n    }\\n    act.survived += dt;\\n    act.t += dt;\\n820→    if act.t >= span {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_step(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules) {\\n    let total = act.notes.len().max(1) as f32;\\n    while let Some(n) = act.notes.get(act.note_i as usize) {\\n        if act.t + 0.02 < n[0] {\\n830→            break;\\n        }\\n        if act.t - n[0] > rules.rhythm_good {\\n            act.note_i += 1;\\n            continue;\\n        }\\n        let lane = n[1] as u8;\\n        let l = pressed & buttons::STEP_L != 0;\\n        let r = pressed & buttons::STEP_R != 0;\\n        let ok = match lane {\\n840→            0 => l,\\n            1 => r,\\n            _ => l && r,\\n        };\\n        if ok {\\n            let err = (act.t - n[0]).abs();\\n            if err <= rules.rhythm_perfect {\\n                act.hits += 1;\\n                act.acc += 1.0;\\n            } else {\\n850→                act.hits += 1;\\n                act.acc += 0.6;\\n            }\\n            act.note_i += 1;\\n        } else if act.t > n[0] + rules.rhythm_good {\\n            act.note_i += 1;\\n        } else {\\n            break;\\n        }\\n    }\\n860→    act.t += dt;\\n    if act.t >= rules.step_secs {\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_floatie(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if ((act.t / 15.0).floor() as i32) % 2 == 1 {\\n        act.dir = -1.0;\\n870→    } else {\\n        act.dir = 1.0;\\n    }\\n    if lean.length() > 0.4 {\\n        let ang = lean.y.atan2(lean.x);\\n        if act.have_ang {\\n            let mut d = ang - act.prev_ang;\\n            if d > std::f32::consts::PI {\\n                d -= std::f32::consts::TAU;\\n            }\\n880→            if d < -std::f32::consts::PI {\\n                d += std::f32::consts::TAU;\\n            }\\n            let w = d / dt.max(1e-4);\\n            act.spin += (w - act.spin) * 0.35;\\n        }\\n        act.prev_ang = ang;\\n        act.have_ang = true;\\n    } else {\\n        act.spin *= 0.9;\\n890→    }\\n    let scale = rules.spin_band_scale;\\n    let s = act.spin * act.dir;\\n    let in_band = s > rules.spin_lo / scale && s < rules.spin_hi * scale;\\n    if in_band {\\n        act.band_t += dt;\\n    }\\n    let catches = [6.0_f32, 13.0, 20.0, 27.0, 34.0, 41.0, 48.0];\\n    if let Some(t) = catches.get(act.catch_i as usize) {\\n        let want_l = act.catch_i % 2 == 0;\\n900→        let got = if want_l { pressed & buttons::STEP_L != 0 } else { pressed & buttons::STEP_R != 0 };\\n        if got && (act.t - t).abs() < 0.25 {\\n            act.rings = (act.rings + 1).min(7);\\n            act.catch_i += 1;\\n        } else if act.t > t + 0.25 {\\n            act.catch_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    if act.t >= rules.floatie_secs {\\n910→        let rings = act.rings as f32 / 7.0;\\n        let band = act.band_t / rules.floatie_secs;\\n        act.score = (rings * band * 1400.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_lap(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if pressed & buttons::STEP_L != 0 && act.last_side != -1 {\\n        act.steps += 1;\\n920→        act.last_side = -1;\\n        act.step_times.push(act.t);\\n    }\\n    if pressed & buttons::STEP_R != 0 && act.last_side != 1 {\\n        act.steps += 1;\\n        act.last_side = 1;\\n        act.step_times.push(act.t);\\n    }\\n    act.step_times.retain(|t| act.t - *t < 1.0);\\n    let rate = act.step_times.len() as f32;\\n930→    if (1.6..=2.4).contains(&rate) && act.t > 1.0 {\\n        act.zone_t += dt;\\n    }\\n    act.lateral = (act.lateral + lean.x * 1.2 * dt).clamp(-1.2, 1.2);\\n    let ribbon = ribbon_at(act.t);\\n    if ribbon.abs() > 0.2 && (act.lateral - ribbon).abs() < 0.35 && act.t.fract() < dt + 0.02 {\\n        // once per ribbon window, roughly\\n        if act.ribbons < 5 && (act.t - ribbon_time(act.ribbons)).abs() < 1.0 {\\n            act.ribbons += 1;\\n        }\\n940→    }\\n    let crab = crab_at(act.t);\\n    if crab.abs() > 0.2 && (act.lateral - crab).abs() < 0.25 {\\n        act.bumps += 1;\\n        act.lateral = 0.0;\\n    }\\n    act.px = act.lateral;\\n    act.pz = act.t;\\n    act.t += dt;\\n    if act.t >= rules.lap_secs {\\n950→        let zone = act.zone_t / rules.lap_secs;\\n        act.score = (zone * 800.0 + act.ribbons as f32 * 50.0 - act.bumps as f32 * 40.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn ribbon_time(i: u8) -> f32 {\\n    [8.0, 22.0, 40.0, 58.0, 75.0][i as usize]\\n}\\n\\n960→fn crab_at(t: f32) -> f32 {\\n    let spots = [15.0_f32, 33.0, 50.0, 68.0];\\n    let xs = [-0.8, 0.85, -0.6, 0.7];\\n    for (i, s) in spots.iter().enumerate() {\\n        if (t - s).abs() < 0.8 {\\n            return xs[i];\\n        }\\n    }\\n    0.0\\n}\\n970→\\nfn tick_tide(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, rng: &mut Rng) {\\n    let tilt = if bal.cob.length() > 0.18 { bal.cob } else { Vec2::ZERO };\\n    let g = 9.0;\\n    let friction = 3.2;\\n    let mut potted_now = 0;\\n    for s in &mut act.shells {\\n        if s.pot {\\n            continue;\\n        }\\n980→        let ax = tilt.x * g - friction * s.vx;\\n        let az = tilt.y * g - friction * s.vz;\\n        s.vx += ax * dt;\\n        s.vz += az * dt;\\n        s.x += s.vx * dt;\\n        s.z += s.vz * dt;\\n        if s.x.abs() > 2.2 {\\n            s.x = s.x.clamp(-2.2, 2.2);\\n            s.vx *= -0.5;\\n        }\\n990→        if s.z.abs() > 1.6 {\\n            s.z = s.z.clamp(-1.6, 1.6);\\n            s.vz *= -0.5;\\n        }\\n        for p in &act.pools {\\n            let dx = s.x - p[0];\\n            let dz = s.z - p[1];\\n            let sp = (s.vx * s.vx + s.vz * s.vz).sqrt();\\n            if dx * dx + dz * dz < 0.28 * 0.28 && sp < 3.5 {\\n                s.pot = true;\\n1000→                potted_now += 1;\\n                break;\\n            }\\n        }\\n    }\\n    act.potted += potted_now;\\n    // Board 2 pool drifts.\\n    if act.board == 1 {\\n        if let Some(p) = act.pools.first_mut() {\\n            p[0] = (act.sub * 0.6).sin() * 0.8;\\n1010→        }\\n    }\\n    act.sub += dt;\\n    act.t += dt;\\n    if act.sub >= rules.tide_secs {\\n        if act.board < 2 {\\n            act.setup_board(act.board + 1, rng);\\n        } else {\\n            let total = 3.0 + 5.0 + 7.0;\\n            let time_bonus = (1.0 - (act.t / (rules.tide_secs * 3.0)).clamp(0.0, 1.0)) * 150.0;\\n1020→            act.score = (act.potted as f32 / total * 850.0 + time_bonus).clamp(0.0, 1000.0);\\n            act.done = true;\\n        }\\n    }\\n}\\n\\nfn tick_paddle(act: &mut Activity, lean: Vec2, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let forward = lean.y.clamp(-1.0, 1.0);\\n    let target = if forward > 0.0 { forward * 6.5 } else { forward * 2.0 };\\n    act.speed += (target - act.speed) * dt * 2.2;\\n1030→    act.speed = act.speed.max(0.0);\\n    act.pz += act.speed * dt;\\n    act.px = (act.px + lean.x * 3.2 * dt).clamp(-2.2, 2.2);\\n    if act.t.fract() < dt {\\n        events.push(SimEvent::Wake { pos: glam::Vec3::new(act.px, 0.0, act.pz) });\\n    }\\n    if let Some(g) = act.gates.get(act.gate_i as usize) {\\n        if act.pz >= g[0] {\\n            if (act.px - g[1]).abs() > 0.7 {\\n                act.missed += 1;\\n1040→            }\\n            act.gate_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    let finished = act.pz >= 56.0 || act.t >= rules.paddle_secs;\\n    if finished {\\n        let mut t = if act.pz >= 56.0 { act.t } else { rules.paddle_secs };\\n        t += act.missed as f32 * 2.0;\\n        let par = rules.paddle_par;\\n1050→        let raw = (1.6 * par - t) / (0.8 * par);\\n        act.score = (raw.clamp(0.0, 1.0) * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_tray(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let mut kick = 0.0;\\n    for s in &act.jolts {\\n        let d = act.t - s[0];\\n1060→        if d > 0.0 && d <= dt + 1e-4 {\\n            kick += s[1] * 0.48;\\n        }\\n    }\\n    let tilt = bal.cob.x;\\n    for i in 0..5 {\\n        if !act.glass_ok[i] {\\n            continue;\\n        }\\n        act.glasses[i] += kick + tilt * dt * 2.2;\\n1070→        if act.glasses[i].abs() > 1.0 {\\n            act.glass_ok[i] = false;\\n            events.push(SimEvent::Sfx { id: 19, gain: 0.8, pitch: 1.0 });\\n        }\\n    }\\n    act.t += dt;\\n    act.pz = act.t;\\n    if act.t >= rules.tray_secs {\\n        let kept = act.glass_ok.iter().filter(|g| **g).count() as f32;\\n        let bonus = if kept == 5.0 { 0.0 } else { 0.0 };\\n1080→        act.score = (kept * 200.0 + bonus).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_cannon(act: &mut Activity, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let _ = rules;\\n    if !act.leaping {\\n        let phase = act.t / 1.2;\\n        let s = (phase * std::f32::consts::TAU).sin();\\n1090→        let prev = ((act.t - dt) / 1.2 * std::f32::consts::TAU).sin();\\n        let bottom = s < -0.9 && s > prev;\\n        if bottom && pressed & buttons::CONFIRM != 0 && act.power < 4.0 {\\n            act.power += 1.0;\\n            events.push(SimEvent::Sfx { id: 14, gain: 0.6, pitch: 0.8 + act.power * 0.1 });\\n            if act.power >= 4.0 {\\n                act.leaping = true;\\n                act.air = 0.0;\\n                act.tuck = 0.0;\\n            }\\n1100→        }\\n    } else {\\n        act.air += dt;\\n        if held & buttons::CONFIRM != 0 {\\n            act.tuck = (act.tuck + dt / 0.35).min(1.0);\\n        }\\n        act.px += lean.x * dt;\\n        let s = (act.air * 3.0).sin();\\n        let prev = ((act.air - dt) * 3.0).sin();\\n        // Landing is the way down, while the tuck still counts. Waiting for the splash to flatten scored nothing.\\n1110→        let landing = act.air > 0.55 && s > 0.0 && s < prev && s < 0.5;\\n        if landing {\\n            let timing = (1.0 - (act.air - 0.9).abs() / 0.35).clamp(0.0, 1.0);\\n            let sc = ((0.35 + 0.65 * act.tuck) * (0.4 + 0.6 * timing) * rules.bounce_gain).clamp(0.0, 1.0);\\n            act.dive_scores.push(sc);\\n            act.dives += 1;\\n            events.push(SimEvent::BigSplash { pos: glam::Vec3::new(act.px, 0.0, 2.0), size: 1.2 + act.tuck });\\n            act.leaping = false;\\n            act.power = 0.0;\\n            act.air = 0.0;\\n1120→            act.tuck = 0.0;\\n        }\\n    }\\n    act.t += dt;\\n    if act.dives >= 3 || act.t >= rules.cannon_secs {\\n        let n = 3.0;\\n        let sum: f32 = act.dive_scores.iter().sum();\\n        act.score = (sum / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n1130→}\\n\\nfn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\\n    let _ = lean;\\n    match act.phase {\\n        0 => {\\n            let before = act.t;\\n            tick_breath(act, bal, held, dt, rules, true);\\n            act.t = before + dt;\\n            if act.t >= 32.0 {\\n1140→                act.phase = 1;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.done = false;\\n            }\\n        }\\n        1 => {\\n            let c = ring_center(act.sub);\\n            let inside = (bal.cob - c).length() < 0.28;\\n            if inside {\\n1150→                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.note_i = 0;\\n1160→                // Use the first notes, time-shifted into this phase by rewriting a local clock.\\n                act.t_shift_notes();\\n            }\\n        }\\n        2 => {\\n            let local_pressed = pressed;\\n            let start_t = act.t;\\n            // tick_step uses act.t against note times. Notes were shifted.\\n            let saved_dur = rules.step_secs;\\n            let _ = saved_dur;\\n1170→            tick_step_window(act, local_pressed, dt, rules, 40.0);\\n            if act.t - start_t < dt * 0.5 {\\n                act.t = start_t + dt;\\n            }\\n            act.sub += dt;\\n            if act.sub >= 40.0 {\\n                act.phase_scores.push(act.score);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n                act.done = false;\\n1180→                act.flopped = false;\\n                act.survived = 0.0;\\n            }\\n        }\\n        3 => {\\n            if braced(held) && bal.cob.length() < 0.45 {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n1190→            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 4;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n            }\\n        }\\n        _ => {\\n            if act.sub >= 15.0 && pressed != 0 {\\n1200→                act.forfeit = true;\\n            }\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 30.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                let quiet = (1.0 - mean / 0.2).clamp(0.0, 1.0);\\n                let mut s = quiet * 1000.0;\\n1210→                if !act.forfeit {\\n                    s = (s + 200.0).min(1000.0);\\n                } else {\\n                    s *= 0.5;\\n                }\\n                act.phase_scores.push(s);\\n                let n = act.phase_scores.len().max(1) as f32;\\n                let sum: f32 = act.phase_scores.iter().copied().sum();\\n                act.score = (sum / n).clamp(0.0, 1000.0);\\n                // Tips cost score but never end the run.\\n1220→                act.score = (act.score - act.tips as f32 * 15.0).max(0.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Activity {\\n    fn t_shift_notes(&mut self) {\\n        if self.notes.is_empty() {\\n1230→            return;\\n        }\\n        let t0 = self.notes[0][0];\\n        for n in &mut self.notes {\\n            n[0] = self.t + (n[0] - t0);\\n        }\\n        self.note_i = 0;\\n        self.acc = 0.0;\\n        self.hits = 0;\\n    }\\n1240→}\\n\\nfn tick_step_window(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules, window: f32) {\\n    let total = act.notes.len().max(1) as f32;\\n    let t0 = act.t;\\n    tick_step(act, pressed, dt, rules);\\n    // tick_step may mark done at step_secs. The finale uses its own clock.\\n    if act.done && act.kind == EventId::BigStand {\\n        act.done = false;\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n1250→    }\\n    if act.t < t0 + dt * 0.5 {\\n        act.t = t0 + dt;\\n    }\\n    let _ = window;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/events.rs\",\"offset\":540,\"limit\":750,\"raw_output\":\"        3 => (pd(bal, rules, Vec2::ZERO), buttons::STEP_L | buttons::STEP_R),\\n        _ => (pd(bal, rules, Vec2::ZERO), 0),\\n    }\\n}\\n\\nfn ring_center(t: f32) -> Vec2 {\\n    let a = 0.35;\\n    Vec2::new(a * (std::f32::consts::TAU * 0.12 * t).sin(), a * (std::f32::consts::TAU * 0.09 * t + 1.3).sin())\\n}\\n\\nfn squat_guide(t: f32) -> f32 {\\n    let c = (t / 3.2).fract();\\n    if c < 2.0 / 3.2 {\\n        c / (2.0 / 3.2)\\n    } else {\\n        1.0 - (c - 2.0 / 3.2) / (1.2 / 3.2)\\n    }\\n}\\n\\nfn breath_guide(t: f32) -> f32 {\\n    let c = (t / 8.0).fract();\\n    if c < 0.5 { c * 2.0 } else { 1.0 - (c - 0.5) * 2.0 }\\n}\\n\\npub fn tick(act: &mut Activity, bal: &mut BalanceCore, sim: &mut Sim, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    if act.done {\\n        return;\\n    }\\n    let amp = rules.wobble * act.amp_scale * if act.kind == EventId::Plank { 1.0 + act.t / 30.0 } else { 1.0 };\\n    bal.amp = amp;\\n    bal.gust = if act.kind == EventId::BigStand && act.phase == 1 {\\n        Vec2::new(rules.big_gust * (act.sub / 20.0) * (act.sub * 1.7).sin(), 0.0)\\n    } else if act.kind == EventId::Paddle && (act.t * 0.35).sin() > 0.85 {\\n        Vec2::new(rules.gust * 0.15, 0.0)\\n    } else {\\n        Vec2::ZERO\\n    };\\n    bal.step(lean, dt, rules, &mut sim.state.rng);\\n    if bal.tipped {\\n        act.tips += 1;\\n        act.lock = 1.2;\\n        events.push(SimEvent::Sfx { id: 7, gain: 0.8, pitch: 1.0 });\\n        if act.kind == EventId::Pose {\\n            act.lock = 1.5;\\n            act.streak = 0.0;\\n        }\\n    }\\n    act.lock = (act.lock - dt).max(0.0);\\n    if act.samples.len() < 80 && sim.state.tick.is_multiple_of(6) {\\n        act.samples.push(GhostSample { t: act.t, lean: [lean.x, lean.y], x: act.px, z: act.pz });\\n    }\\n    match act.kind {\\n        EventId::Check => tick_check(act, bal, pressed, dt),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n\\nfn finish_score(act: &mut Activity) {\\n    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n                act.hold += dt;\\n            } else {\\n                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n            }\\n            act.sub += dt;\\n            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n        if finale {\\n            act.phase_scores.push(act.score);\\n        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\\n    } else {\\n        act.streak = 0.0;\\n    }\\n    let mult = 1.0 + (act.streak / 2.0).floor().min(3.0);\\n    if inside {\\n        act.acc += dt * mult;\\n    }\\n    act.t += dt;\\n    if act.t >= pose_len * 3.0 {\\n        act.score = (act.acc / (pose_len * 3.0) * 700.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_squat(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    act.guide = squat_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.depth = (act.depth + dt / 2.0).min(1.0);\\n    } else {\\n        act.depth = (act.depth - dt / 1.0).max(0.0);\\n    }\\n    let bottom = (act.t / 3.2).fract();\\n    let was = ((act.t - dt) / 3.2).fract();\\n    // A rep completes as the guide returns to the top.\\n    if was > 0.8 && bottom < 0.2 && act.reps < rules.squat_reps as u8 {\\n        let timing = (1.0 - (act.depth - 0.15).abs()).clamp(0.0, 1.0);\\n        // lungs keeps the deepest point of this rep. A rep that never left the top barely scores.\\n        let deep = if act.lungs > 0.75 { 1.0 } else { (act.lungs / 0.75).clamp(0.0, 1.0) };\\n        let band = if act.hold < 0.25 { 1.0 } else { 0.3 };\\n        let moved = if deep > 0.2 { 0.25 * band } else { 0.0 };\\n        act.acc += 0.75 * deep.max(timing * 0.12) + moved;\\n        act.reps += 1;\\n        act.lungs = 0.0;\\n        act.hold = 0.0;\\n        events.push(SimEvent::Sfx { id: 15, gain: 0.7, pitch: 1.0 + act.reps as f32 * 0.03 });\\n        if act.reps == rules.squat_reps as u8 {\\n            act.gag = true;\\n        }\\n    }\\n    if act.depth > act.lungs {\\n        act.lungs = act.depth;\\n    }\\n    if bal.cob.x.abs() >= 0.25 {\\n        act.hold += dt;\\n    }\\n    act.t += dt;\\n    let need = rules.squat_reps as f32 * 3.2 + 0.5;\\n    if act.t >= need || act.reps >= rules.squat_reps as u8 && bottom < 0.15 && act.t > 3.0 {\\n        let n = rules.squat_reps.max(1) as f32;\\n        act.score = (act.acc / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn braced(held: u32) -> bool {\\n    let l = held & (buttons::STEP_L) != 0;\\n    let r = held & (buttons::STEP_R) != 0;\\n    l && r\\n}\\n\\nfn tick_plank(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules) {\\n    let span = rules.plank_secs.max(1.0);\\n    let radius = 0.40 + (0.20 - 0.40) * (act.t / span).clamp(0.0, 1.0);\\n    // The card says brace. A fraction of a second covers the handoff from the countdown.\\n    if act.t > 0.6 && !braced(held) {\\n        act.flopped = true;\\n    }\\n    if bal.cob.length() > radius {\\n        act.out_t += dt;\\n        if act.out_t > 1.0 {\\n            act.flopped = true;\\n        }\\n    } else {\\n        act.out_t = 0.0;\\n    }\\n    if act.flopped {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n        return;\\n    }\\n    act.survived += dt;\\n    act.t += dt;\\n    if act.t >= span {\\n        act.score = (act.survived / 60.0 * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_step(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules) {\\n    let total = act.notes.len().max(1) as f32;\\n    while let Some(n) = act.notes.get(act.note_i as usize) {\\n        if act.t + 0.02 < n[0] {\\n            break;\\n        }\\n        if act.t - n[0] > rules.rhythm_good {\\n            act.note_i += 1;\\n            continue;\\n        }\\n        let lane = n[1] as u8;\\n        let l = pressed & buttons::STEP_L != 0;\\n        let r = pressed & buttons::STEP_R != 0;\\n        let ok = match lane {\\n            0 => l,\\n            1 => r,\\n            _ => l && r,\\n        };\\n        if ok {\\n            let err = (act.t - n[0]).abs();\\n            if err <= rules.rhythm_perfect {\\n                act.hits += 1;\\n                act.acc += 1.0;\\n            } else {\\n                act.hits += 1;\\n                act.acc += 0.6;\\n            }\\n            act.note_i += 1;\\n        } else if act.t > n[0] + rules.rhythm_good {\\n            act.note_i += 1;\\n        } else {\\n            break;\\n        }\\n    }\\n    act.t += dt;\\n    if act.t >= rules.step_secs {\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_floatie(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if ((act.t / 15.0).floor() as i32) % 2 == 1 {\\n        act.dir = -1.0;\\n    } else {\\n        act.dir = 1.0;\\n    }\\n    if lean.length() > 0.4 {\\n        let ang = lean.y.atan2(lean.x);\\n        if act.have_ang {\\n            let mut d = ang - act.prev_ang;\\n            if d > std::f32::consts::PI {\\n                d -= std::f32::consts::TAU;\\n            }\\n            if d < -std::f32::consts::PI {\\n                d += std::f32::consts::TAU;\\n            }\\n            let w = d / dt.max(1e-4);\\n            act.spin += (w - act.spin) * 0.35;\\n        }\\n        act.prev_ang = ang;\\n        act.have_ang = true;\\n    } else {\\n        act.spin *= 0.9;\\n    }\\n    let scale = rules.spin_band_scale;\\n    let s = act.spin * act.dir;\\n    let in_band = s > rules.spin_lo / scale && s < rules.spin_hi * scale;\\n    if in_band {\\n        act.band_t += dt;\\n    }\\n    let catches = [6.0_f32, 13.0, 20.0, 27.0, 34.0, 41.0, 48.0];\\n    if let Some(t) = catches.get(act.catch_i as usize) {\\n        let want_l = act.catch_i % 2 == 0;\\n        let got = if want_l { pressed & buttons::STEP_L != 0 } else { pressed & buttons::STEP_R != 0 };\\n        if got && (act.t - t).abs() < 0.25 {\\n            act.rings = (act.rings + 1).min(7);\\n            act.catch_i += 1;\\n        } else if act.t > t + 0.25 {\\n            act.catch_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    if act.t >= rules.floatie_secs {\\n        let rings = act.rings as f32 / 7.0;\\n        let band = act.band_t / rules.floatie_secs;\\n        act.score = (rings * band * 1400.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_lap(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\\n    if pressed & buttons::STEP_L != 0 && act.last_side != -1 {\\n        act.steps += 1;\\n        act.last_side = -1;\\n        act.step_times.push(act.t);\\n    }\\n    if pressed & buttons::STEP_R != 0 && act.last_side != 1 {\\n        act.steps += 1;\\n        act.last_side = 1;\\n        act.step_times.push(act.t);\\n    }\\n    act.step_times.retain(|t| act.t - *t < 1.0);\\n    let rate = act.step_times.len() as f32;\\n    if (1.6..=2.4).contains(&rate) && act.t > 1.0 {\\n        act.zone_t += dt;\\n    }\\n    act.lateral = (act.lateral + lean.x * 1.2 * dt).clamp(-1.2, 1.2);\\n    let ribbon = ribbon_at(act.t);\\n    if ribbon.abs() > 0.2 && (act.lateral - ribbon).abs() < 0.35 && act.t.fract() < dt + 0.02 {\\n        // once per ribbon window, roughly\\n        if act.ribbons < 5 && (act.t - ribbon_time(act.ribbons)).abs() < 1.0 {\\n            act.ribbons += 1;\\n        }\\n    }\\n    let crab = crab_at(act.t);\\n    if crab.abs() > 0.2 && (act.lateral - crab).abs() < 0.25 {\\n        act.bumps += 1;\\n        act.lateral = 0.0;\\n    }\\n    act.px = act.lateral;\\n    act.pz = act.t;\\n    act.t += dt;\\n    if act.t >= rules.lap_secs {\\n        let zone = act.zone_t / rules.lap_secs;\\n        act.score = (zone * 800.0 + act.ribbons as f32 * 50.0 - act.bumps as f32 * 40.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn ribbon_time(i: u8) -> f32 {\\n    [8.0, 22.0, 40.0, 58.0, 75.0][i as usize]\\n}\\n\\nfn crab_at(t: f32) -> f32 {\\n    let spots = [15.0_f32, 33.0, 50.0, 68.0];\\n    let xs = [-0.8, 0.85, -0.6, 0.7];\\n    for (i, s) in spots.iter().enumerate() {\\n        if (t - s).abs() < 0.8 {\\n            return xs[i];\\n        }\\n    }\\n    0.0\\n}\\n\\nfn tick_tide(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, rng: &mut Rng) {\\n    let tilt = if bal.cob.length() > 0.18 { bal.cob } else { Vec2::ZERO };\\n    let g = 9.0;\\n    let friction = 3.2;\\n    let mut potted_now = 0;\\n    for s in &mut act.shells {\\n        if s.pot {\\n            continue;\\n        }\\n        let ax = tilt.x * g - friction * s.vx;\\n        let az = tilt.y * g - friction * s.vz;\\n        s.vx += ax * dt;\\n        s.vz += az * dt;\\n        s.x += s.vx * dt;\\n        s.z += s.vz * dt;\\n        if s.x.abs() > 2.2 {\\n            s.x = s.x.clamp(-2.2, 2.2);\\n            s.vx *= -0.5;\\n        }\\n        if s.z.abs() > 1.6 {\\n            s.z = s.z.clamp(-1.6, 1.6);\\n            s.vz *= -0.5;\\n        }\\n        for p in &act.pools {\\n            let dx = s.x - p[0];\\n            let dz = s.z - p[1];\\n            let sp = (s.vx * s.vx + s.vz * s.vz).sqrt();\\n            if dx * dx + dz * dz < 0.28 * 0.28 && sp < 3.5 {\\n                s.pot = true;\\n                potted_now += 1;\\n                break;\\n            }\\n        }\\n    }\\n    act.potted += potted_now;\\n    // Board 2 pool drifts.\\n    if act.board == 1 {\\n        if let Some(p) = act.pools.first_mut() {\\n            p[0] = (act.sub * 0.6).sin() * 0.8;\\n        }\\n    }\\n    act.sub += dt;\\n    act.t += dt;\\n    if act.sub >= rules.tide_secs {\\n        if act.board < 2 {\\n            act.setup_board(act.board + 1, rng);\\n        } else {\\n            let total = 3.0 + 5.0 + 7.0;\\n            let time_bonus = (1.0 - (act.t / (rules.tide_secs * 3.0)).clamp(0.0, 1.0)) * 150.0;\\n            act.score = (act.potted as f32 / total * 850.0 + time_bonus).clamp(0.0, 1000.0);\\n            act.done = true;\\n        }\\n    }\\n}\\n\\nfn tick_paddle(act: &mut Activity, lean: Vec2, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let forward = lean.y.clamp(-1.0, 1.0);\\n    let target = if forward > 0.0 { forward * 6.5 } else { forward * 2.0 };\\n    act.speed += (target - act.speed) * dt * 2.2;\\n    act.speed = act.speed.max(0.0);\\n    act.pz += act.speed * dt;\\n    act.px = (act.px + lean.x * 3.2 * dt).clamp(-2.2, 2.2);\\n    if act.t.fract() < dt {\\n        events.push(SimEvent::Wake { pos: glam::Vec3::new(act.px, 0.0, act.pz) });\\n    }\\n    if let Some(g) = act.gates.get(act.gate_i as usize) {\\n        if act.pz >= g[0] {\\n            if (act.px - g[1]).abs() > 0.7 {\\n                act.missed += 1;\\n            }\\n            act.gate_i += 1;\\n        }\\n    }\\n    act.t += dt;\\n    let finished = act.pz >= 56.0 || act.t >= rules.paddle_secs;\\n    if finished {\\n        let mut t = if act.pz >= 56.0 { act.t } else { rules.paddle_secs };\\n        t += act.missed as f32 * 2.0;\\n        let par = rules.paddle_par;\\n        let raw = (1.6 * par - t) / (0.8 * par);\\n        act.score = (raw.clamp(0.0, 1.0) * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_tray(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let mut kick = 0.0;\\n    for s in &act.jolts {\\n        let d = act.t - s[0];\\n        if d > 0.0 && d <= dt + 1e-4 {\\n            kick += s[1] * 0.48;\\n        }\\n    }\\n    let tilt = bal.cob.x;\\n    for i in 0..5 {\\n        if !act.glass_ok[i] {\\n            continue;\\n        }\\n        act.glasses[i] += kick + tilt * dt * 2.2;\\n        if act.glasses[i].abs() > 1.0 {\\n            act.glass_ok[i] = false;\\n            events.push(SimEvent::Sfx { id: 19, gain: 0.8, pitch: 1.0 });\\n        }\\n    }\\n    act.t += dt;\\n    act.pz = act.t;\\n    if act.t >= rules.tray_secs {\\n        let kept = act.glass_ok.iter().filter(|g| **g).count() as f32;\\n        let bonus = if kept == 5.0 { 0.0 } else { 0.0 };\\n        act.score = (kept * 200.0 + bonus).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_cannon(act: &mut Activity, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\\n    let _ = rules;\\n    if !act.leaping {\\n        let phase = act.t / 1.2;\\n        let s = (phase * std::f32::consts::TAU).sin();\\n        let prev = ((act.t - dt) / 1.2 * std::f32::consts::TAU).sin();\\n        let bottom = s < -0.9 && s > prev;\\n        if bottom && pressed & buttons::CONFIRM != 0 && act.power < 4.0 {\\n            act.power += 1.0;\\n            events.push(SimEvent::Sfx { id: 14, gain: 0.6, pitch: 0.8 + act.power * 0.1 });\\n            if act.power >= 4.0 {\\n                act.leaping = true;\\n                act.air = 0.0;\\n                act.tuck = 0.0;\\n            }\\n        }\\n    } else {\\n        act.air += dt;\\n        if held & buttons::CONFIRM != 0 {\\n            act.tuck = (act.tuck + dt / 0.35).min(1.0);\\n        }\\n        act.px += lean.x * dt;\\n        let s = (act.air * 3.0).sin();\\n        let prev = ((act.air - dt) * 3.0).sin();\\n        // Landing is the way down, while the tuck still counts. Waiting for the splash to flatten scored nothing.\\n        let landing = act.air > 0.55 && s > 0.0 && s < prev && s < 0.5;\\n        if landing {\\n            let timing = (1.0 - (act.air - 0.9).abs() / 0.35).clamp(0.0, 1.0);\\n            let sc = ((0.35 + 0.65 * act.tuck) * (0.4 + 0.6 * timing) * rules.bounce_gain).clamp(0.0, 1.0);\\n            act.dive_scores.push(sc);\\n            act.dives += 1;\\n            events.push(SimEvent::BigSplash { pos: glam::Vec3::new(act.px, 0.0, 2.0), size: 1.2 + act.tuck });\\n            act.leaping = false;\\n            act.power = 0.0;\\n            act.air = 0.0;\\n            act.tuck = 0.0;\\n        }\\n    }\\n    act.t += dt;\\n    if act.dives >= 3 || act.t >= rules.cannon_secs {\\n        let n = 3.0;\\n        let sum: f32 = act.dive_scores.iter().sum();\\n        act.score = (sum / n * 1000.0).clamp(0.0, 1000.0);\\n        act.done = true;\\n    }\\n}\\n\\nfn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\\n    let _ = lean;\\n    match act.phase {\\n        0 => {\\n            let before = act.t;\\n            tick_breath(act, bal, held, dt, rules, true);\\n            act.t = before + dt;\\n            if act.t >= 32.0 {\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.done = false;\\n            }\\n        }\\n        1 => {\\n            let c = ring_center(act.sub);\\n            let inside = (bal.cob - c).length() < 0.28;\\n            if inside {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.note_i = 0;\\n                // Use the first notes, time-shifted into this phase by rewriting a local clock.\\n                act.t_shift_notes();\\n            }\\n        }\\n        2 => {\\n            let local_pressed = pressed;\\n            let start_t = act.t;\\n            // tick_step uses act.t against note times. Notes were shifted.\\n            let saved_dur = rules.step_secs;\\n            let _ = saved_dur;\\n            tick_step_window(act, local_pressed, dt, rules, 40.0);\\n            if act.t - start_t < dt * 0.5 {\\n                act.t = start_t + dt;\\n            }\\n            act.sub += dt;\\n            if act.sub >= 40.0 {\\n                act.phase_scores.push(act.score);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n                act.done = false;\\n                act.flopped = false;\\n                act.survived = 0.0;\\n            }\\n        }\\n        3 => {\\n            if braced(held) && bal.cob.length() < 0.45 {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 4;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n            }\\n        }\\n        _ => {\\n            if act.sub >= 15.0 && pressed != 0 {\\n                act.forfeit = true;\\n            }\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 30.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                let quiet = (1.0 - mean / 0.2).clamp(0.0, 1.0);\\n                let mut s = quiet * 1000.0;\\n                if !act.forfeit {\\n                    s = (s + 200.0).min(1000.0);\\n                } else {\\n                    s *= 0.5;\\n                }\\n                act.phase_scores.push(s);\\n                let n = act.phase_scores.len().max(1) as f32;\\n                let sum: f32 = act.phase_scores.iter().copied().sum();\\n                act.score = (sum / n).clamp(0.0, 1000.0);\\n                // Tips cost score but never end the run.\\n                act.score = (act.score - act.tips as f32 * 15.0).max(0.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Activity {\\n    fn t_shift_notes(&mut self) {\\n        if self.notes.is_empty() {\\n            return;\\n        }\\n        let t0 = self.notes[0][0];\\n        for n in &mut self.notes {\\n            n[0] = self.t + (n[0] - t0);\\n        }\\n        self.note_i = 0;\\n        self.acc = 0.0;\\n        self.hits = 0;\\n    }\\n}\\n\\nfn tick_step_window(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules, window: f32) {\\n    let total = act.notes.len().max(1) as f32;\\n    let t0 = act.t;\\n    tick_step(act, pressed, dt, rules);\\n    // tick_step may mark done at step_secs. The finale uses its own clock.\\n    if act.done && act.kind == EventId::BigStand {\\n        act.done = false;\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n    }\\n    if act.t < t0 + dt * 0.5 {\\n        act.t = t0 + dt;\\n    }\\n    let _ = window;\\n}\\n\",\"total_lines\":1255}}","is_error":false},{"type":"tool_result","tool_use_id":"call-97976fae-9381-4eec-aeb3-b88311fa0ed5-32","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"520→        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n530→            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n540→                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n550→                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n560→            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n570→                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n580→            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n590→            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n600→                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n610→                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n620→            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let mut rules = self.rules.clone();\\n630→                let infos = params::list(&mut rules);\\n                let start = (self.page - 1) * 4;\\n                let mut v: Vec<(u16, String)> = infos\\n                    .iter()\\n                    .enumerate()\\n                    .skip(start)\\n                    .take(4)\\n                    .map(|(i, info)| {\\n                        let label = match &info.value {\\n                            ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n640→                            ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                            _ => info.path.clone(),\\n                        };\\n                        (300 + i as u16, label)\\n                    })\\n                    .collect();\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n        }\\n650→    }\\n\\n    fn start_activity(&mut self, kind: EventId, sim: &mut Sim) {\\n        if let Some(id) = self.ghost_id.take() {\\n            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n660→                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n670→    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n680→        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n690→    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n700→                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n710→                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n720→                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n730→                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n740→                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n750→                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n760→                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n770→            }\\n            Run::Demo => {}\\n        }\\n    }\\n\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n780→        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n790→        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n800→    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n810→            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n820→        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n830→                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n840→                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n850→                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n860→                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n870→                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n880→                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n890→                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n900→                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n910→                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n920→                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n930→            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n940→                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n950→                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n960→            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\",\"content_concise\":\"520→        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n530→            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n540→                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n550→                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n560→            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n570→                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n580→            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n590→            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n600→                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n610→                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n620→            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let mut rules = self.rules.clone();\\n630→                let infos = params::list(&mut rules);\\n                let start = (self.page - 1) * 4;\\n                let mut v: Vec<(u16, String)> = infos\\n                    .iter()\\n                    .enumerate()\\n                    .skip(start)\\n                    .take(4)\\n                    .map(|(i, info)| {\\n                        let label = match &info.value {\\n                            ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n640→                            ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                            _ => info.path.clone(),\\n                        };\\n                        (300 + i as u16, label)\\n                    })\\n                    .collect();\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n        }\\n650→    }\\n\\n    fn start_activity(&mut self, kind: EventId, sim: &mut Sim) {\\n        if let Some(id) = self.ghost_id.take() {\\n            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n660→                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n670→    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n680→        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n690→    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n700→                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n710→                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n720→                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n730→                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n740→                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n750→                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n760→                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n770→            }\\n            Run::Demo => {}\\n        }\\n    }\\n\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n780→        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n790→        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n800→    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n810→            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n820→        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n830→                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n840→                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n850→                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n860→                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n870→                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n880→                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n890→                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n900→                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n910→                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n920→                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n930→            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n940→                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n950→                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n960→            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/mod.rs\",\"offset\":520,\"limit\":450,\"raw_output\":\"        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let 