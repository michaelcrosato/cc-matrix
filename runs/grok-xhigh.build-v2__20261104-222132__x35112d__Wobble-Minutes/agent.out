\n    pub touch_only: bool,\\n    audio_unlocked: bool,\\n    song: u8,\\n    return_flow: Flow,\\n    paused_from: Flow,\\n    hub_mode: bool,\\n    hub_wait: bool,\\n290→    hub_done: bool,\\n    hub_stats: [f32; 3],\\n    medley_i: u8,\\n    together_n: u8,\\n    together_i: u8,\\n    together_scores: Vec<f32>,\\n    together_names: Vec<String>,\\n    podium: Vec<(String, f32)>,\\n    demo: bool,\\n    attract_i: u8,\\n300→    attract_t: f32,\\n    reset_arm: bool,\\n    ghost_id: Option<crate::entity::EntityId>,\\n    about_page: usize,\\n    /// Plain About text from the page (`__gameBoot.about`). Empty in native tests.\\n    #[serde(default)]\\n    pub about_blob: String,\\n    /// Dev Mode tab. 0 root, 1 jump, 2 cheats, 3 time, 4 tuning.\\n    #[serde(default)]\\n    dev_tab: u8,\\n310→    #[serde(default)]\\n    cheat_no_tips: bool,\\n    #[serde(default)]\\n    cheat_auto: bool,\\n    #[serde(default)]\\n    skip_lines: bool,\\n    #[serde(default)]\\n    step_once: bool,\\n    /// Event mats on the island: key, world x, world z.\\n    #[serde(default)]\\n320→    mats: Vec<(String, f32, f32)>,\\n}\\n\\nimpl FitGame {\\n    fn fresh() -> Self {\\n        Self {\\n            flow: Flow::Title,\\n            run: Run::Story,\\n            saved_run: Run::Story,\\n            rules: Rules::default(),\\n330→            settings: Settings::default(),\\n            slots: vec![Slot::default(); 4],\\n            slot: 0,\\n            continuing: false,\\n            name: \\\"Guest\\\".into(),\\n            skin: 0,\\n            outfit: 0,\\n            day: 1,\\n            day_minutes: 0,\\n            total_stars: 0,\\n340→            stamps: 0,\\n            days_completed: 0,\\n            age: 80,\\n            skill: 0.0,\\n            ages: Vec::new(),\\n            ever_played: Vec::new(),\\n            today_played: Vec::new(),\\n            bests: BTreeMap::new(),\\n            ghosts: BTreeMap::new(),\\n            flips: 0,\\n350→            golden: