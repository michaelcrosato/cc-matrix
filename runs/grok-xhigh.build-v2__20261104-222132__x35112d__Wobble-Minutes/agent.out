15,116,97,116,117,115,32,61,61,61,32,39,112,108,97,121,101,100,39,44,32,114,101,99,111,114,100,32,63,32,96,36,123,114,101,99,111,114,100,46,115,116,97,116,117,115,125,32,40,36,123,114,101,99,111,114,100,46,114,101,97,115,111,110,125,41,96,32,58,32,39,110,111,32,101,110,100,32,119,105,116,104,105,110,32,116,104,101,32,103,114,97,99,101,32,112,101,114,105,111,100,39,41,59,10,53,50,55,58,32,32,32,32,100,111,99,117,109,101,110,116,46,98,111,100,121,46,100,97,116,97,115,101,116,46,99,111,109,112,108,101,116,101,32,61,32,39,116,114,117,101,39,59,10,53,52,52,58,105,102,32,40,97,117,116,111,41,32,99,111,110,102,111,114,109,97,110,99,101,40,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":26,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/hub/harness.html\",\"matches\":[{\"line_number\":12,\"content\":\"  body { display: grid; grid-template-rows: auto 1fr; }\"},{\"line_number\":23,\"content\":\"  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\"},{\"line_number\":26,\"content\":\"  .cell__state { margin-left: auto; color: var(--dim); }\"},{\"line_number\":29,\"content\":\"  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\"},{\"line_number\":37,\"content\":\"  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\"},{\"line_number\":61,\"content\":\"    <section id=\\\"checks\\\"><h2>Conformance</h2><ul id=\\\"checklist\\\"><li class=\\\"hint\\\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\"},{\"line_number\":72,\"content\":\"const auto = params.get('auto') === '1';\"},{\"line_number\":204,\"content\":\"    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\"},{\"line_number\":211,\"content\":\"    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\"},{\"line_number\":224,\"content\":\"    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\"},{\"line_number\":238,\"content\":\"      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\"},{\"line_number\":241,\"content\":\"        cell.progress.push({ at: performance.now(), ...report });\"},{\"line_number\":242,\"content\":\"        state.coordinator.progress(id, report.score);\"},{\"line_number\":258,\"content\":\"    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\"},{\"line_number\":302,\"content\":\"  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\"},{\"line_number\":339,\"content\":\"    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\"},{\"line_number\":343,\"content\":\"    const last = cell.progress.at(-1);\"},{\"line_number\":344,\"content\":\"    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\"},{\"line_number\":377,\"content\":\" * ?auto=1 — the conformance run. It presses keys inside each frame with\"},{\"line_number\":379,\"content\":\" * page's origin). Results land in window.__hubCheck, and body[data-complete]\"},{\"line_number\":469,\"content\":\"    // still tagged race was built to race's contract: no seeded start, and no progress asked.\"},{\"line_number\":489,\"content\":\"      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\"},{\"line_number\":490,\"content\":\"        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\"},{\"line_number\":508,\"content\":\"      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\"},{\"line_number\":527,\"content\":\"    document.body.dataset.complete = 'true';\"},{\"line_number\":544,\"content\":\"if (auto) conformance();\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-9a44134e-359c-4293-80a7-4ea1c56a2eb6-80","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n10→\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n20→> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n30→|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n40→- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n50→\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n60→   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n70→<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n80→\",\"content_concise\":\"1→# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n10→\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n20→> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n30→|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n40→- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n50→\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n60→   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n70→<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n80→\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/hub/README.md\",\"offset\":null,\"limit\":80,\"raw_output\":\"# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n\\n\",\"total_lines\":410}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"1d32b211-30d6-4cf0-9b66-11670bc365dc"}
{"type":"assistant","message":{"id":"msg_264","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"tool_use","id":"call-cf0fb290-d394-4422-b5d6-240d4aede29e-81","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/hub/harness.html","offset":370,"limit":120}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3260,"output_tokens":104,"cache_read_input_tokens":135168,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"b449302f-6020-4a5b-b1f2-440ef8863615"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-cf0fb290-d394-4422-b5d6-240d4aede29e-81","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n420→    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\\n\\n    // Every copy: the players, and in a server round the server's copy.\\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\\n430→    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\\n    if (!helloed) return;\\n    const caps = state.coordinator.seats().map((s) => s.caps);\\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\\n      return;\\n    }\\n\\n440→    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\\n    if (caps.some((c) => c?.card)) {\\n      const players = state.cells.filter((c) => !c.server);\\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\\n      for (const cell of players) poke(cell, 'Enter');\\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n450→    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n460→      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n470→    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n480→    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\",\"content_concise\":\"370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n420→    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\\n\\n    // Every copy: the players, and in a server round the server's copy.\\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\\n430→    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\\n    if (!helloed) return;\\n    const caps = state.coordinator.seats().map((s) => s.caps);\\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\\n      return;\\n    }\\n\\n440→    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\\n    if (caps.some((c) => c?.card)) {\\n      const players = state.cells.filter((c) => !c.server);\\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\\n      for (const cell of players) poke(cell, 'Enter');\\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n450→    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n460→      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n470→    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCel