  Flow::Look => page_labels(&s.skins, 500, self.page, 6),\\n            Flow::Outfit => page_labels(&s.outfits, 520, self.page, 6),\\n            Flow::Schedule => self.schedule_rows(),\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo => vec![(ACT_BACK, \\\"Back\\\".into())],\\n            Flow::Wardrobe => self.wardrobe_rows(),\\n            Flow::Calendar => self.calendar_rows(),\\n            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.dev_tab {\\n            1 => page_rows(&self.jump_rows(), self.page, 4),\\n            2 => page_rows(&self.cheat_rows(), self.page, 4),\\n            3 => page_rows(&self.time_rows(), self.page, 4),\\n            4 => self.tuning_rows(),\\n            5 => self.view_rows(),\\n            6 => self.save_rows(),\\n            _ => {\\n                let pages: [&[(u16, &str)]; 3] = [\\n                    &[\\n                        (200, \\\"Jump\\\"),\\n                        (201, \\\"Cheats\\\"),\\n                        (202, \\\"Time\\\"),\\n                        (203, \\\"Tuning\\\"),\\n                        (43, \\\"Wardrobe\\\"),\\n                        (ACT_RESUME, \\\"Resume\\\"),\\n                    ],\\n                    &[\\n                        (44, \\\"Calendar\\\"),\\n                        (ACT_DEV_RESET, \\\"Reset feel\\\"),\\n                        (ACT_SETTINGS, \\\"Settings\\\"),\\n                        (ACT_ABOUT, \\\"About\\\"),\\n                        (ACT_HOWTO, \\\"How to Stand\\\"),\\n                        (ACT_BACK, \\\"Back\\\"),\\n                    ],\\n                    &[(204, \\\"View\\\"), (205, \\\"Save\\\"), (ACT_BACK, \\\"Back\\\")],\\n                ];\\n                let page = self.page % pages.len();\\n                pages[page].iter().map(|(id, label)| (*id, (*label).to_string())).collect()\\n            }\\n        }\\n    }\\n\\n    fn schedule_rows(&self) -> Vec<(u16, String)> {\\n        let evs = self.schedule_events();\\n        let per = 4;\\n        let pages = (evs.len().max(1) + per - 1) / per;\\n        let start = (self.page % pages) * per;\\n        let mut v = Vec::new();\\n        for (i, e) in evs.iter().enumerate().skip(start).take(per) {\\n            let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n            v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n        }\\n        if self.day_clear() {\\n            v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n        }\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n    fn jump_rows(&self) -> Vec<(u16, String)> {\\n        let mut all = Vec::new();\\n        for (i, e) in EventId::ALL.iter().enumerate() {\\n            all.push((220 + i as u16, e.title().to_string()));\\n        }\\n        all.push((240, \\\"Pose gusts\\\".into()));\\n        all.push((241, \\\"Step window\\\".into()));\\n        all.push((242, \\\"Brace\\\".into()));\\n        all.push((243, \\\"Long stillness\\\".into()));\\n        all.push((244, \\\"Attract\\\".into()));\\n        all.push((245, \\\"Medley\\\".into()));\\n        all.push((246, \\\"Island\\\".into()));\\n        for d in 1..=5 {\\n            all.push((246 + d, format!(\\\"Day {d}\\\")));\\n        }\\n        all\\n    }\\n\\n    fn cheat_rows(&self) -> Vec<(u16, String)> {\\n        let on = |flag: bool| if flag { \\\"on\\\" } else { \\\"off\\\" };\\n        vec![\\n            (230, format!(\\\"No tips {}\\\", on(self.cheat_no_tips))),\\n            (231, format!(\\\"Autoplay {}\\\", on(self.cheat_auto))),\\n            (232, \\\"Give minutes\\\".into()),\\n            (233, \\\"Unlock all\\\".into()),\\n            (234, \\\"All stars\\\".into()),\\n            (235, format!(\\\"Skip dialogue {}\\\", on(self.skip_lines))),\\n            (236, \\\"Win this event\\\".into()),\\n            (237, \\\"Lose this event\\\".into()),\\n        ]\\n    }\\n\\n    fn time_rows(&self) -> Vec<(u16, String)> {\\n        let mark = |scale: f32, label: &str| {\\n            if (self.time_scale - scale).abs() < 0.001 { format!(\\\"{label} · on\\\") } else { label.to_string() }\\n        };\\n        vec![\\n            (210, mark(0.25, \\\"0.25x\\\")),\\n            (211, mark(1.0, \\\"1x\\\")),\\n            (212, mark(2.0, \\\"2x\\\")),\\n            (213, mark(4.0, \\\"4x\\\")),\\n            (214, mark(0.0, \\\"Pause clock\\\")),\\n            (215, \\\"Single step\\\".into()),\\n        ]\\n    }\\n\\n    fn tuning_rows(&self) -> Vec<(u16, String)> {\\n        let mut rules = self.rules.clone();\\n        let infos = params::list(&mut rules);\\n        let per = 3;\\n        let pages = (infos.len().max(1) + per - 1) / per;\\n        let start = (self.page % pages) * per;\\n        let mut v: Vec<(u16, String)> = infos\\n            .iter()\\n            .enumerate()\\n            .skip(start)\\n            .take(per)\\n            .map(|(i, info)| {\\n                let label = match &info.value {\\n                    ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n                    ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                    _ => info.path.clone(),\\n                };\\n                (300 + i as u16, label)\\n            })\\n            .collect();\\n        v.push((ACT_DEV_RESET_GROUP, \\\"Reset group\\\".into()));\\n        v.push((ACT_DEV_RESET, \\\"Reset feel\\\".into()));\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n    fn wardrobe_rows(&self) -> Vec<(u16, String)> {\\n        let mut all = vec![\\n            (260, \\\"Sun cap\\\".into()),\\n            (261, \\\"Towel hood\\\".into()),\\n            (262, \\\"Crown\\\".into()),\\n            (263, \\\"Halo\\\".into()),\\n            (264, \\\"Sweatbands\\\".into()),\\n            (265, \\\"Floaties\\\".into()),\\n            (266, \\\"Belt\\\".into()),\\n        ];\\n        for (i, name) in self.script().outfits.iter().enumerate() {\\n            all.push((520 + i as u16, name.clone()));\\n        }\\n        page_rows(&all, self.page, 5)\\n    }\\n\\n    fn calendar_rows(&self) -> Vec<(u16, String)> {\\n        let mut v = Vec::new();\\n        for d in 1..=5u8 {\\n            let state = if self.days_completed >= d as u32 || self.stamps >= d as u8 { \\\"stamped\\\" } else { \\\"open\\\" };\\n            v.push((270 + d as u16, format!(\\\"Day {d} · {state}\\\")));\\n        }\\n        v.push((ACT_BACK, \\\"Back\\\".into()));\\n        v\\n    }\\n\\n    fn view_rows(&self) -> Vec<(u16, String)> {\\n        let on = |flag: bool| if flag { \\\"on\\\" } else { \\\"off\\\" };\\n        vec![\\n            (280, format!(\\\"Input viewer {}\\\", on(self.view_input))),\\n            (281, format!(\\\"Dot trace {}\\\", on(self.view_trace))),\\n            (282, format!(\\\"Engine stats {}\\\", on(self.view_stats))),\\n            (283, format!(\\\"Free camera {}\\\", on(self.view_free))),\\n            (284, format!(\\\"Ghost lanes {}\\\", on(self.view_lanes))),\\n            (ACT_BACK, \\\"Back\\\".into()),\\n        ]\\n    }\\n\\n    fn save_rows(&self) -> Vec<(u16, String)> {\\n        vec![(285, format!(\\\"Reset {}\\\", self.name)), (ACT_BACK, \\\"Back\\\".into())]\\n\",\"total_lines\":2628}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e94661b6-b8e3-42c0-ad36-65d9c1823863-33","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→    let medley = boot(\\\"fit/medley\\\", 3);\\n    let ghost = &status(&medley)[\\\"hub\\\"][\\\"ghost\\\"];\\n    assert!(ghost.is_object(), \\\"{ghost}\\\");\\n    assert_eq!(ghost[\\\"area\\\"], 9, \\\"paddle is event index 9\\\");\\n    assert!(ghost[\\\"position\\\"].is_array());\\n    assert!(ghost[\\\"lean\\\"].is_array());\\n    let title = boot(\\\"fit\\\", 3);\\n    assert_eq!(status(&title)[\\\"hub\\\"][\\\"ghost\\\"][\\\"area\\\"], -1);\\n\\n    let mut sim = boot(\\\"fit\\\", 4);\\n310→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.about_blob = r#\\\"{\\\"sourceInformation\\\":{\\\"usage\\\":\\\"added on import\\\",\\\"source\\\":\\\"Wii Fit\\\"},\\\"testingFeedback\\\":[\\\"the bot caught a gust\\\"],\\\"engineFeedback\\\":[\\\"pause returns inside the tick\\\"],\\\"promptFeedback\\\":[\\\"the full roster ships\\\"]}\\\"#.into();\\n    }\\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(5)), device: 2, pressed: 0, ..Default::default() });\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"Source:\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"added on import\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"Testing Feedback\\\"), \\\"{blob}\\\");\\n320→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::TAB_R));\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"the bot caught a gust\\\"), \\\"{blob}\\\");\\n}\\n\\n#[test]\\nfn name_and_outfit_pages_reach_gray_and_golden() {\\n    let mut sim = boot(\\\"fit\\\", 16);\\n330→    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"slots\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"name\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(phase(&sim), \\\"look\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"outfit\\\");\\n340→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"outfit\\\"], 7, \\\"Golden is the eighth outfit\\\");\\n    assert_eq!(phase(&sim), \\\"intro\\\");\\n}\\n\\n#[test]\\nfn schedule_pages_to_cannonball_after_unlock() {\\n    let mut sim = boot(\\\"fit\\\", 18);\\n350→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    sim.step(&press(buttons::SCHEDULE));\\n    assert_eq!(phase(&sim), \\\"schedule\\\");\\n360→    pick(&mut sim, \\\"Cannonball\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"cannon\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn eyes_closed_hides_the_puck_and_the_tone_moves() {\\n    let mut sim = boot(\\\"fit/event/check\\\", 3);\\n    assert!(\\n370→        bot_until(&mut sim, |s| phase(s) == \\\"check\\\" && status(s)[\\\"act_phase\\\"].as_u64() == Some(2), 4000),\\n        \\\"phase {} act {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"act_phase\\\"]\\n    );\\n    let ui = ui_of(&sim);\\n    assert!(ui.puck.is_none(), \\\"puck stayed up\\\");\\n    assert!(ui.dim > 0.5, \\\"dim {}\\\", ui.dim);\\n    let blob = ui.lines.join(\\\" \\\").to_ascii_lowercase();\\n    assert!(blob.contains(\\\"eyes\\\"), \\\"{blob}\\\");\\n380→    let tone = status(&sim)[\\\"tone\\\"].as_f64().unwrap();\\n    for _ in 0..30 {\\n        sim.step(&InputFrame { lean: Vec2::new(1.0, 0.0), ..Default::default() });\\n    }\\n    let later = status(&sim);\\n    assert_eq!(later[\\\"act_phase\\\"], 2, \\\"left the eyes-closed phase\\\");\\n    let moved = later[\\\"tone\\\"].as_f64().unwrap();\\n    assert!((moved - tone).abs() > 0.05, \\\"tone {tone} -> {moved}\\\");\\n}\\n\\n390→#[test]\\nfn long_stillness_goes_quiet_and_offers_a_fake_skip() {\\n    let mut sim = boot(\\\"fit\\\", 5);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Time\\\");\\n    pick(&mut sim, \\\"4x\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    let opened = status(&sim);\\n400→    assert_eq!(opened[\\\"phase\\\"], \\\"event\\\");\\n    assert_eq!(opened[\\\"event\\\"], \\\"bigstand\\\");\\n    assert_eq!(opened[\\\"song\\\"], 3, \\\"finale bed\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Long stillness\\\");\\n    let still = status(&sim);\\n    assert_eq!(still[\\\"song\\\"], 0, \\\"stillness should be silent\\\");\\n    assert_eq!(still[\\\"act_phase\\\"], 4);\\n    let mut guard = 0;\\n410→    while status(&sim)[\\\"act_sub\\\"].as_f64().unwrap_or(0.0) < 15.0 && guard < 400 {\\n        sim.step(&InputFrame::default());\\n        guard += 1;\\n    }\\n    let s = status(&sim);\\n    assert!(s[\\\"act_sub\\\"].as_f64().unwrap() >= 15.0, \\\"sub {} after {guard}\\\", s[\\\"act_sub\\\"]);\\n    let ui = ui_of(&sim);\\n    let line = ui.lines.join(\\\" \\\");\\n    assert!(line.contains(\\\"Press\\\") && line.contains(\\\"skip\\\"), \\\"{line}\\\");\\n    assert!(ui.footer.contains(\\\"Press\\\") && ui.footer.contains(\\\"skip\\\"), \\\"{}\\\", ui.footer);\\n420→    assert!(ui.big.is_empty(), \\\"score banner {}\\\", ui.big);\\n    assert!(ui.title.is_empty(), \\\"title fell back to {}\\\", ui.title);\\n    assert!(ui.puck.is_some(), \\\"puck should stay\\\");\\n}\\n\\n#[test]\\nfn a_good_finale_can_rowboat_from_a_middle_age() {\\n    let mut sim = boot(\\\"fit\\\", 1);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n430→        g.age = 45;\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"bigstand\\\");\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"ending\\\", 20_000),\\n        \\\"phase {} score {}\\\",\\n        phase(&sim),\\n440→        status(&sim)[\\\"score\\\"]\\n    );\\n    let s = status(&sim);\\n    let score = s[\\\"score\\\"].as_f64().unwrap();\\n    let cut = (score / 100.0).floor().min(10.0) as u8;\\n    let expect = 45u8.saturating_sub(cut).max(18);\\n    assert_eq!(s[\\\"age\\\"], expect, \\\"score {score}\\\");\\n    if score >= 500.0 {\\n        assert_eq!(s[\\\"ending\\\"], \\\"rowboat\\\", \\\"score {score} age {}\\\", s[\\\"age\\\"]);\\n    }\\n450→}\\n\\n#[test]\\nfn pose_parade_plays_the_tree_clip() {\\n    let mut sim = boot(\\\"fit/event/pose\\\", 2);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..20 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n460→    let tree = pav_core::clips::find(\\\"FIT/Tree\\\").expect(\\\"FIT/Tree\\\");\\n    let clip = status(&sim)[\\\"clip\\\"].as_u64().unwrap();\\n    assert_ne!(clip, 0);\\n    assert_eq!(clip, tree as u64);\\n}\\n\\n#[test]\\nfn wardrobe_calendar_and_beach_props() {\\n    let mut sim = boot(\\\"fit\\\", 20);\\n    let props = sim.state.entities.iter().filter(|e| e.prop.is_some()).count();\\n470→    assert!(props > 0, \\\"no beach props\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap_or_default();\\n    assert!(mats.len() >= 11, \\\"{mats:?}\\\");\\n    assert!(mats.iter().any(|m| m[\\\"event\\\"] == \\\"cannon\\\"), \\\"{mats:?}\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Wardrobe\\\");\\n    pick(&mut sim, \\\"Sun cap\\\");\\n    assert_eq!(sim.config.puppet.gear.helm, HelmKind::Cap);\\n    pick(&mut sim, \\\"Calendar\\\");\\n    let ui = ui_of(&sim);\\n480→    assert!(ui.items.iter().any(|it| it.label.contains(\\\"Day\\\")), \\\"{:?}\\\", ui.items);\\n}\\n\\n#[test]\\nfn a_mat_on_the_sand_starts_its_event() {\\n    let mut sim = boot(\\\"fit\\\", 22);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n490→    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap();\\n    let mat = mats.iter().find(|m| m[\\\"event\\\"] == \\\"floatie\\\").expect(\\\"floatie mat\\\");\\n    let x = mat[\\\"x\\\"].as_f64().unwrap() as f32;\\n    let z = mat[\\\"z\\\"].as_f64().unwrap() as f32;\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let mut arrived = false;\\n    for _ in 0..700 {\\n500→        let feet = sim.feet(id).expect(\\\"feet\\\");\\n        let dx = x - feet.x;\\n        let dz = z - feet.z;\\n        if dx.hypot(dz) < 0.8 {\\n            arrived = true;\\n            break;\\n        }\\n        let d = dx.hypot(dz).max(0.001);\\n        sim.step(&InputFrame { move_dir: Vec2::new(dx / d, dz / d), ..Default::default() });\\n    }\\n510→    assert!(arrived, \\\"never reached the floatie mat\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"floatie\\\", \\\"{s}\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn view_and_save_tabs_change_the_stay() {\\n    let mut sim = boot(\\\"fit\\\", 3);\\n520→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 4;\\n        g.stamps = 3;\\n        g.day_minutes = 9;\\n        g.name = \\\"Gray\\\".into();\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"View\\\");\\n    pick(&mut sim, \\\"Input\\\");\\n530→    pick(&mut sim, \\\"Dot\\\");\\n    pick(&mut sim, \\\"Engine\\\");\\n    pick(&mut sim, \\\"Free\\\");\\n    pick(&mut sim, \\\"Ghost\\\");\\n    let view = status(&sim)[\\\"view\\\"].clone();\\n    assert_eq!(view[\\\"input\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"stats\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"free\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"lanes\\\"], true, \\\"{view}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n540→    pick(&mut sim, \\\"Save\\\");\\n    pick(&mut sim, \\\"Reset Gray\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 1, \\\"{s}\\\");\\n    assert_eq!(s[\\\"stamps\\\"], 0);\\n    assert_eq!(s[\\\"minutes\\\"], 0);\\n    assert_eq!(s[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(s[\\\"view\\\"][\\\"lanes\\\"], true, \\\"reset cleared the viewer\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n550→    pick(&mut sim, \\\"Pose Parade\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"pose\\\");\\n    for _ in 0..8 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let ui = ui_of(&sim);\\n    assert!(!ui.trace.is_empty(), \\\"dot trace stayed empty\\\");\\n    assert!(ui.overlay.contains(\\\"Lean\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.overlay.contains(\\\"Tick\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.camera_yaw.is_some());\\n560→    assert!(status(&sim)[\\\"view\\\"][\\\"trace\\\"].as_u64().unwrap_or(0) > 0);\\n}\\n\",\"content_concise\":\"300→    let medley = boot(\\\"fit/medley\\\", 3);\\n    let ghost = &status(&medley)[\\\"hub\\\"][\\\"ghost\\\"];\\n    assert!(ghost.is_object(), \\\"{ghost}\\\");\\n    assert_eq!(ghost[\\\"area\\\"], 9, \\\"paddle is event index 9\\\");\\n    assert!(ghost[\\\"position\\\"].is_array());\\n    assert!(ghost[\\\"lean\\\"].is_array());\\n    let title = boot(\\\"fit\\\", 3);\\n    assert_eq!(status(&title)[\\\"hub\\\"][\\\"ghost\\\"][\\\"area\\\"], -1);\\n\\n    let mut sim = boot(\\\"fit\\\", 4);\\n310→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.about_blob = r#\\\"{\\\"sourceInformation\\\":{\\\"usage\\\":\\\"added on import\\\",\\\"source\\\":\\\"Wii Fit\\\"},\\\"testingFeedback\\\":[\\\"the bot caught a gust\\\"],\\\"engineFeedback\\\":[\\\"pause returns inside the tick\\\"],\\\"promptFeedback\\\":[\\\"the full roster ships\\\"]}\\\"#.into();\\n    }\\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(5)), device: 2, pressed: 0, ..Default::default() });\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"Source:\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"added on import\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"Testing Feedback\\\"), \\\"{blob}\\\");\\n320→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::TAB_R));\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"the bot caught a gust\\\"), \\\"{blob}\\\");\\n}\\n\\n#[test]\\nfn name_and_outfit_pages_reach_gray_and_golden() {\\n    let mut sim = boot(\\\"fit\\\", 16);\\n330→    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"slots\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"name\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(phase(&sim), \\\"look\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"outfit\\\");\\n340→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"outfit\\\"], 7, \\\"Golden is the eighth outfit\\\");\\n    assert_eq!(phase(&sim), \\\"intro\\\");\\n}\\n\\n#[test]\\nfn schedule_pages_to_cannonball_after_unlock() {\\n    let mut sim = boot(\\\"fit\\\", 18);\\n350→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    sim.step(&press(buttons::SCHEDULE));\\n    assert_eq!(phase(&sim), \\\"schedule\\\");\\n360→    pick(&mut sim, \\\"Cannonball\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"cannon\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn eyes_closed_hides_the_puck_and_the_tone_moves() {\\n    let mut sim = boot(\\\"fit/event/check\\\", 3);\\n    assert!(\\n370→        bot_until(&mut sim, |s| phase(s) == \\\"check\\\" && status(s)[\\\"act_phase\\\"].as_u64() == Some(2), 4000),\\n        \\\"phase {} act {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"act_phase\\\"]\\n    );\\n    let ui = ui_of(&sim);\\n    assert!(ui.puck.is_none(), \\\"puck stayed up\\\");\\n    assert!(ui.dim > 0.5, \\\"dim {}\\\", ui.dim);\\n    let blob = ui.lines.join(\\\" \\\").to_ascii_lowercase();\\n    assert!(blob.contains(\\\"eyes\\\"), \\\"{blob}\\\");\\n380→    let tone = status(&sim)[\\\"tone\\\"].as_f64().unwrap();\\n    for _ in 0..30 {\\n        sim.step(&InputFrame { lean: Vec2::new(1.0, 0.0), ..Default::default() });\\n    }\\n    let later = status(&sim);\\n    assert_eq!(later[\\\"act_phase\\\"], 2, \\\"left the eyes-closed phase\\\");\\n    let moved = later[\\\"tone\\\"].as_f64().unwrap();\\n    assert!((moved - tone).abs() > 0.05, \\\"tone {tone} -> {moved}\\\");\\n}\\n\\n390→#[test]\\nfn long_stillness_goes_quiet_and_offers_a_fake_skip() {\\n    let mut sim = boot(\\\"fit\\\", 5);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Time\\\");\\n    pick(&mut sim, \\\"4x\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    let opened = status(&sim);\\n400→    assert_eq!(opened[\\\"phase\\\"], \\\"event\\\");\\n    assert_eq!(opened[\\\"event\\\"], \\\"bigstand\\\");\\n    assert_eq!(opened[\\\"song\\\"], 3, \\\"finale bed\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Long stillness\\\");\\n    let still = status(&sim);\\n    assert_eq!(still[\\\"song\\\"], 0, \\\"stillness should be silent\\\");\\n    assert_eq!(still[\\\"act_phase\\\"], 4);\\n    let mut guard = 0;\\n410→    while status(&sim)[\\\"act_sub\\\"].as_f64().unwrap_or(0.0) < 15.0 && guard < 400 {\\n        sim.step(&InputFrame::default());\\n        guard += 1;\\n    }\\n    let s = status(&sim);\\n    assert!(s[\\\"act_sub\\\"].as_f64().unwrap() >= 15.0, \\\"sub {} after {guard}\\\", s[\\\"act_sub\\\"]);\\n    let ui = ui_of(&sim);\\n    let line = ui.lines.join(\\\" \\\");\\n    assert!(line.contains(\\\"Press\\\") && line.contains(\\\"skip\\\"), \\\"{line}\\\");\\n    assert!(ui.footer.contains(\\\"Press\\\") && ui.footer.contains(\\\"skip\\\"), \\\"{}\\\", ui.footer);\\n420→    assert!(ui.big.is_empty(), \\\"score banner {}\\\", ui.big);\\n    assert!(ui.title.is_empty(), \\\"title fell back to {}\\\", ui.title);\\n    assert!(ui.puck.is_some(), \\\"puck should stay\\\");\\n}\\n\\n#[test]\\nfn a_good_finale_can_rowboat_from_a_middle_age() {\\n    let mut sim = boot(\\\"fit\\\", 1);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n430→        g.age = 45;\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"bigstand\\\");\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"ending\\\", 20_000),\\n        \\\"phase {} score {}\\\",\\n        phase(&sim),\\n440→        status(&sim)[\\\"score\\\"]\\n    );\\n    let s = status(&sim);\\n    let score = s[\\\"score\\\"].as_f64().unwrap();\\n    let cut = (score / 100.0).floor().min(10.0) as u8;\\n    let expect = 45u8.saturating_sub(cut).max(18);\\n    assert_eq!(s[\\\"age\\\"], expect, \\\"score {score}\\\");\\n    if score >= 500.0 {\\n        assert_eq!(s[\\\"ending\\\"], \\\"rowboat\\\", \\\"score {score} age {}\\\", s[\\\"age\\\"]);\\n    }\\n450→}\\n\\n#[test]\\nfn pose_parade_plays_the_tree_clip() {\\n    let mut sim = boot(\\\"fit/event/pose\\\", 2);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..20 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n460→    let tree = pav_core::clips::find(\\\"FIT/Tree\\\").expect(\\\"FIT/Tree\\\");\\n    let clip = status(&sim)[\\\"clip\\\"].as_u64().unwrap();\\n    assert_ne!(clip, 0);\\n    assert_eq!(clip, tree as u64);\\n}\\n\\n#[test]\\nfn wardrobe_calendar_and_beach_props() {\\n    let mut sim = boot(\\\"fit\\\", 20);\\n    let props = sim.state.entities.iter().filter(|e| e.prop.is_some()).count();\\n470→    assert!(props > 0, \\\"no beach props\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap_or_default();\\n    assert!(mats.len() >= 11, \\\"{mats:?}\\\");\\n    assert!(mats.iter().any(|m| m[\\\"event\\\"] == \\\"cannon\\\"), \\\"{mats:?}\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Wardrobe\\\");\\n    pick(&mut sim, \\\"Sun cap\\\");\\n    assert_eq!(sim.config.puppet.gear.helm, HelmKind::Cap);\\n    pick(&mut sim, \\\"Calendar\\\");\\n    let ui = ui_of(&sim);\\n480→    assert!(ui.items.iter().any(|it| it.label.contains(\\\"Day\\\")), \\\"{:?}\\\", ui.items);\\n}\\n\\n#[test]\\nfn a_mat_on_the_sand_starts_its_event() {\\n    let mut sim = boot(\\\"fit\\\", 22);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n490→    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    let mats = 