\":\"    pub phase: u8,\"},{\"line_number\":216,\"content\":\"    pub phase_scores: Vec<f32>,\"},{\"line_number\":247,\"content\":\"            phase: 0,\"},{\"line_number\":306,\"content\":\"            phase_scores: Vec::new(),\"},{\"line_number\":427,\"content\":\"    match act.phase {\"},{\"line_number\":533,\"content\":\"    match act.phase {\"},{\"line_number\":564,\"content\":\"pub fn tick(act: &mut Activity, bal: &mut BalanceCore, sim: &mut Sim, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\"},{\"line_number\":570,\"content\":\"    bal.gust = if act.kind == EventId::BigStand && act.phase == 1 {\"},{\"line_number\":615,\"content\":\"fn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32) {\"},{\"line_number\":616,\"content\":\"    match act.phase {\"},{\"line_number\":628,\"content\":\"                act.phase = 1;\"},{\"line_number\":641,\"content\":\"                act.phase = 2;\"},{\"line_number\":673,\"content\":\"                act.phase = 3;\"},{\"line_number\":701,\"content\":\"fn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\"},{\"line_number\":719,\"content\":\"            act.phase_scores.push(act.score);\"},{\"line_number\":724,\"content\":\"fn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\"},{\"line_number\":752,\"content\":\"fn tick_squat(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\"},{\"line_number\":798,\"content\":\"fn tick_plank(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules) {\"},{\"line_number\":826,\"content\":\"fn tick_step(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules) {\"},{\"line_number\":867,\"content\":\"fn tick_floatie(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\"},{\"line_number\":917,\"content\":\"fn tick_lap(act: &mut Activity, lean: Vec2, pressed: u32, dt: f32, rules: &Rules) {\"},{\"line_number\":971,\"content\":\"fn tick_tide(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, rng: &mut Rng) {\"},{\"line_number\":1026,\"content\":\"fn tick_paddle(act: &mut Activity, lean: Vec2, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\"},{\"line_number\":1056,\"content\":\"fn tick_tray(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\"},{\"line_number\":1085,\"content\":\"fn tick_cannon(act: &mut Activity, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, events: &mut Vec<SimEvent>) {\"},{\"line_number\":1088,\"content\":\"        let phase = act.t / 1.2;\"},{\"line_number\":1089,\"content\":\"        let s = (phase * std::f32::consts::TAU).sin();\"},{\"line_number\":1132,\"content\":\"fn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\"},{\"line_number\":1134,\"content\":\"    match act.phase {\"},{\"line_number\":1140,\"content\":\"                act.phase = 1;\"},{\"line_number\":1155,\"content\":\"                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\"},{\"line_number\":1156,\"content\":\"                act.phase = 2;\"},{\"line_number\":1160,\"content\":\"                // Use the first notes, time-shifted into this phase by rewriting a local clock.\"},{\"line_number\":1176,\"content\":\"                act.phase_scores.push(act.score);\"},{\"line_number\":1177,\"content\":\"                act.phase = 3;\"},{\"line_number\":1191,\"content\":\"                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\"},{\"line_number\":1192,\"content\":\"                act.phase = 4;\"},{\"line_number\":1215,\"content\":\"                act.phase_scores.push(s);\"},{\"line_number\":1216,\"content\":\"                let n = act.phase_scores.len().max(1) as f32;\"}]}]}","is_error":false},{"type":"tool_result","to