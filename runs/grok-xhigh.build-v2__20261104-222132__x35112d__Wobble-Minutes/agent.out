[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\\npub enum EventId {\\n    Check,\\n    Breath,\\n    Pose,\\n    Squat,\\n    Plank,\\n    Step,\\n20→    Floatie,\\n    Lap,\\n    Tide,\\n    Paddle,\\n    Tray,\\n    Cannon,\\n    BigStand,\\n}\\n\\nimpl EventId {\\n30→    pub const ALL: [EventId; 13] = [\\n        EventId::Check,\\n        EventId::Breath,\\n        EventId::Pose,\\n        EventId::Squat,\\n        EventId::Plank,\\n        EventId::Step,\\n        EventId::Floatie,\\n        EventId::Lap,\\n        EventId::Tide,\\n40→        EventId::Paddle,\\n        EventId::Tray,\\n        EventId::Cannon,\\n        EventId::BigStand,\\n    ];\\n\\n    pub fn key(self) -> &'static str {\\n        match self {\\n            EventId::Check => \\\"check\\\",\\n            EventId::Breath => \\\"breath\\\",\\n50→            EventId::Pose => \\\"pose\\\",\\n            EventId::Squat => \\\"squat\\\",\\n            EventId::Plank => \\\"plank\\\",\\n            EventId::Step => \\\"step\\\",\\n            EventId::Floatie => \\\"floatie\\\",\\n            EventId::Lap => \\\"lap\\\",\\n            EventId::Tide => \\\"tide\\\",\\n            EventId::Paddle => \\\"paddle\\\",\\n            EventId::Tray => \\\"tray\\\",\\n            EventId::Cannon => \\\"cannon\\\",\\n60→            EventId::BigStand => \\\"bigstand\\\",\\n        }\\n    }\\n\\n    pub fn from_key(s: &str) -> Option<EventId> {\\n        Self::ALL.into_iter().find(|e| e.key() == s)\\n    }\\n\\n    pub fn title(self) -> &'static str {\\n        match self {\\n70→            EventId::Check => \\\"Morning Wobble Check\\\",\\n            EventId::Breath => \\\"Breath Bloom\\\",\\n            EventId::Pose => \\\"Pose Parade\\\",\\n            EventId::Squat => \\\"Tempo Squats\\\",\\n            EventId::Plank => \\\"Plank Standoff\\\",\\n            EventId::Step => \\\"Step Party\\\",\\n            EventId::Floatie => \\\"Floatie Spin\\\",\\n            EventId::Lap => \\\"Morning Lap\\\",\\n            EventId::Tide => \\\"Tide Table\\\",\\n            EventId::Paddle => \\\"Paddle Slalom\\\",\\n80→            EventId::Tray => \\\"Tray Trek\\\",\",\"content_concise\":\"1→//! Every Tippy Cay activity, on the shared balance model.\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::core::{BalanceCore, Rules, stars_from_plank, stars_from_score};\\nuse crate::frame::SimEvent;\\nuse crate::input::buttons;\\nuse crate::rng::Rng;\\n10→use crate::sim::Sim;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\\npub enum EventId {\\n    Check,\\n    Breath,\\n    Pose,\\n    Squat,\\n    Plank,\\n    Step,\\n20→    Floatie,\\n    Lap,\\n    Tide,\\n    Paddle,\\n    Tray,\\n    Cannon,\\n    BigStand,\\n}\\n\\nimpl EventId {\\n30→    pub const ALL: [EventId; 13] = [\\n        EventId::Check,\\n        EventId::Breath,\\n        EventId::Pose,\\n        EventId::Squat,\\n        EventId::Plank,\\n        EventId::Step,\\n        EventId::Floatie,\\n        EventId::Lap,\\n        EventId::Tide,\\n40→        EventId::Paddle,\\n        EventId::Tray,\\n        EventId::Cannon,\\n        EventId::BigStand,\\n    ];\\n\\n    pub fn key(self) -> &'static str {\\n        match self {\\n            EventId::Check => \\\"check\\\",\\n            EventId::Breath => \\\"breath\\\",\\n50→            EventId::Pose => \\\"pose\\\",\\n            EventId::Squat => \\\"squat\\\",\\n            EventId::Plank => \\\"plank\\\",\\n            EventId::Step => \\\"step\\\",\\n            EventId::Floatie => \\\"floatie\\\",\\n            EventId::Lap => \\\"lap\\\",\\n            EventId::Tide => \\\"tide\\\",\\n            EventId::Paddle => \\\"paddle\\\",\\n            EventId::Tray => \\\"tray\\\",\\n            EventId::Cannon => \\\"cannon\\\",\\n60→            EventId::BigStand => \\\"bigstand\\\",\\n        }\\n    }\\n\\n    pub fn from_key(s: &str) -> Option<EventId> {\\n        Self::ALL.into_iter().find(|e| e.key() == s)\\n    }\\n\\n    pub fn title(self) -> &'static str {\\n        match self {\\n70→            EventId::Check => \\\"Morning Wobble Check\\\",\\n            EventId::Breath => \\\"Breath Bloom\\\",\\n            EventId::Pose => \\\"Pose Parade\\\",\\n            EventId::Squat => \\\"Tempo Squats\\\",\\n            EventId::Plank => \\\"Plank Standoff\\\",\\n            EventId::Step => \\\"Step Party\\\",\\n            EventId::Floatie => \\\"Floatie Spin\\\",\\n            EventId::Lap => \\\"Morning Lap\\\",\\n            EventId::Tide => \\\"Tide Table\\\",\\n            EventId::Paddle => \\\"Paddle Slalom\\\",\\n80→            EventId::Tray => \\\"Tray Trek\\\",\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/events.rs\",\"offset\":1,\"limit\":80,\"raw_output\":\"//! Every Tippy Cay activity, on the shared balance model.\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::core::{BalanceCore, Rules, stars_from_plank, stars_from_score};\\nuse crate::frame::SimEvent;\\nuse crate::input::buttons;\\nuse crate::rng::Rng;\\nuse crate::sim::Sim;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\\npub enum EventId {\\n    Check,\\n    Breath,\\n    Pose,\\n    Squat,\\n    Plank,\\n    Step,\\n    Floatie,\\n    Lap,\\n    Tide,\\n    Paddle,\\n    Tray,\\n    Cannon,\\n    BigStand,\\n}\\n\\nimpl EventId {\\n    pub const ALL: [EventId; 13] = [\\n        EventId::Check,\\n        EventId::Breath,\\n        EventId::Pose,\\n        EventId::Squat,\\n        EventId::Plank,\\n        EventId::Step,\\n        EventId::Floatie,\\n        EventId::Lap,\\n        EventId::Tide,\\n        EventId::Paddle,\\n        EventId::Tray,\\n        EventId::Cannon,\\n        EventId::BigStand,\\n    ];\\n\\n   