_default();\\n                Window { title, rect: rect4(r), text }\\n            })\\n            .collect();\\n        sort(&mut hud);\\n        let controls = if self.device == Device::Touch {\\n            self.touch.placed().iter().map(|p| Control { control: format!(\\\"{:?}\\\", p.control), rect: rect4(p.rect) }).collect()\\n        } else {\\n            Vec::new()\\n        };\\n        Reading {\\n            screen: [screen.width(), screen.height()],\\n            device: match self.device {\\n                Device::KeyboardMouse => \\\"mouse\\\",\\n                Device::Gamepad => \\\"pad\\\",\\n                Device::Touch => \\\"touch\\\",\\n            },\\n            open: Self::WINDOWS.into_iter().filter(|w| self.is_open(w)).collect(),\\n            hud,\\n            windows,\\n            controls,\\n        }\\n    }\\n\\n    fn is_open(&self, name: &str) -> bool {\\n        match name {\\n            \\\"inventory\\\" => self.game.inventory,\\n            \\\"character\\\" => self.game.character,\\n            \\\"skills\\\" => self.game.skills,\\n            \\\"tree\\\" => self.game.tree.open,\\n            \\\"map\\\" => self.game.map,\\n            _ => false,\\n        }\\n    }\\n}\\n\\n/// Each window (an egui area other than the screen-wide `root`) on screen this pass: its rect\\n/// and the text on its layer. Read before the pass ends, while egui still holds shapes by layer.\\nfn window_layers(ctx: &egui::Context, root: egui::LayerId, screen: Rect) -> Vec<(Rect, Vec<(Rect, String)>)> {\\n    let areas: Vec<(egui::LayerId, Rect)> = ctx.memory(|m| {\\n        let mut ids: Vec<egui::LayerId> = m.areas().visible_layer_ids().into_iter().filter(|l| *l != root).collect();\\n        ids.sort_by_key(|l| (l.order, l.id.value()));\\n        ids.into_iter().filter_map(|l| m.area_rect(l.id).map(|r| (l, r))).collect()\\n    });\\n    areas\\n        .into_iter()\\n        .map(|(layer, rect)| {\\n            let mut texts = Vec::new();\\n            ctx.graphics(|g| {\\n                for clipped in g.get(layer).map(|list| list.all_entries().collect::<Vec<_>>()).unwrap_or_default() {\\n                    collect(&clipped.shape, clipped.clip_rect.intersect(screen), &mut texts);\\n                }\\n            });\\n            (rect, texts)\\n        })\\n        .collect()\\n}\\n\\n/// Texts with where they are; a drop shadow (the same text a point or two off) is kept once.\\nfn dedupe(texts: Vec<(Rect, String)>) -> Vec<Text> {\\n    let mut kept: Vec<(Rect, String)> = Vec::new();\\n    for (rect, text) in texts {\\n        if !kept.iter().any(|(r, t)| *t == text && r.min.distance(rect.min) < 3.0) {\\n            kept.push((rect, text));\\n        }\\n    }\\n    kept.into_iter().map(|(r, text)| Text { text, at: [r.min.x.round(), r.min.y.round()] }).collect()\\n}\\n\\n/// Every visible text in `shape` with its bounds.\\nfn collect(shape: &Shape, clip: Rect, out: &mut Vec<(Rect, String)>) {\\n    match shape {\\n        Shape::Vec(shapes) => {\\n            for s in shapes {\\n                collect(s, clip, out);\\n            }\\n        }\\n        Shape::Text(t) => {\\n            let rect = t.visual_bounding_rect();\\n            let text = t.galley.text().trim();\\n            if !text.is_empty() && t.opacity_factor > 0.0 && clip.intersects(rect) {\\n                out.push((rect, text.to_string()));\\n            }\\n        }\\n        _ => {}\\n    }\\n}\\n\\n/// Reading order: rows top to bottom (within 4 points is one row), then left to right.\\nfn sort(texts: &mut [Text]) {\\n    texts.sort_by(|a, b| {\\n        let row = |t: &Text| (t.at[1] / 4.0).round();\\n        row(a).total_cmp(&row(b)).then(a.at[0].total_cmp(&b.at[0]))\\n    });\\n}\\n\\nfn rect4(r: Rect) -> [f32; 4] {\\n    [r.min.x.round(), r.min.y.round(), r.max.x.round(), r.max.y.round()]\\n}\\n\\n/// Paints egui output over a texture (a capture), on one device.\\npub struct Overlay {\\n    renderer: egui_wgpu::Renderer,\\n    format: wgpu::TextureFormat,\\n}\\n\\nimpl Overlay {\\n    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\\n        Self { renderer: egui_wgpu::Renderer::new(device, format, egui_wgpu::RendererOptions::default()), format }\\n    }\\n\\n    pub fn format(&self) -> wgpu::TextureFormat {\\n        self.format\\n    }\\n\\n    /// Records the UI's draw over `view` (loaded, not cleared) into `encoder`. Its textures\\n    /// are uploaded now and freed after.\\n    pub fn paint(\\n        &mut self,\\n        device: &wgpu::Device,\\n        queue: &wgpu::Queue,\\n        encoder: &mut wgpu::CommandEncoder,\\n        view: &wgpu::TextureView,\\n        size: (u32, u32),\\n        paint: &Paint,\\n    ) {\\n        let prims = &paint.primitives;\\n        for (id, delta) in &paint.textures.set {\\n            for d in delta {\\n                self.renderer.update_texture(device, queue, *id, d);\\n            }\\n        }\\n        let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: paint.pixels_per_point };\\n        let cmds = self.renderer.update_buffers(device, queue, encoder, prims, &sd);\\n        queue.submit(cmds);\\n        let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {\\n            label: Some(\\\"ui overlay\\\"),\\n            color_attachments: &[Some(wgpu::RenderPassColorAttachment {\\n                view,\\n                depth_slice: None,\\n                resolve_target: None,\\n                ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },\\n            })],\\n            depth_stencil_attachment: None,\\n            timestamp_writes: None,\\n            occlusion_query_set: None,\\n            multiview_mask: None,\\n        });\\n        self.renderer.render(&mut pass.forget_lifetime(), prims, &sd);\\n        for id in &paint.textures.free {\\n            self.renderer.free_texture(id);\\n        }\\n    }\\n}\\n\",\"total_lines\":369}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0c114616-b0ee-49b9-9404-a9b24d4f6bc8-51","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,95,95,120,51,53,49,49,50,100,47,119,111,114,107,34,62,10,70,111,117,110,100,32,52,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,95,95,120,51,53,49,49,50,100,47,119,111,114,107,47,87,111,98,98,108,101,32,77,105,110,117,116,101,115,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,117,105,47,115,114,99,47,97,114,112,103,95,105,116,101,109,115,46,114,115,10,49,49,54,56,58,32,32,32,32,32,32,32,32,108,101,116,32,103,97,108,108,101,121,32,61,32,99,116,120,46,102,111,110,116,115,95,109,117,116,40,124,102,124,32,102,46,108,97,121,111,117,116,95,110,111,95,119,114,97,112,40,108,46,110,97,109,101,46,99,108,111,110,101,40,41,44,32,102,111,110,116,46,99,108,111,110,101,40,41,44,32,114,97,114,105,116,121,95,99,111,108,111,114,40,108,46,114,97,114,105,116,121,41,41,41,59,10,49,49,54,57,58,32,32,32,32,32,32,32,32,108,101,116,32,115,105,122,101,32,61,32,103,97,108,108,101,121,46,115,105,122,101,40,41,32,43,32,69,86,101,99,50,58,58,110,101,119,40,49,48,46,48,44,32,52,46,48,41,59,10,49,49,56,56,58,32,32,32,32,32,32,32,32,32,32,32,32,112,46,103,97,108,108,101,121,40,114,46,109,105,110,32,43,32,69,86,101,99,50,58,58,110,101,119,40,53,46,48,44,32,50,46,48,41,44,32,103,97,108,108,101,121,44,32,67,111,108,111,114,51,50,58,58,87,72,73,84,69,41,59,10,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,95,95,120,51,53,49,49,50,100,47,119,111,114,107,47,87,111,98,98,108,101,32,77,105,110,117,116,101,115,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,50,49,51,50,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,117,105,47,115,114,99,47,104,101,97,100,108,101,115,115,46,114,115,10,50,57,53,58,32,32,32,32,32,32,32,32,32,32,32,32,108,101,116,32,116,101,120,116,32,61,32,116,46,103,97,108,108,101,121,46,116,101,120,116,40,41,46,116,114,105,109,40,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":4,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_ui/src/arpg_items.rs\",\"matches\":[{\"line_number\":1168,\"content\":\"        let galley = ctx.fonts_mut(|f| f.layout_no_wrap(l.name.clone(), font.clone(), rarity_color(l.rarity)));\"},{\"line_number\":1169,\"content\":\"        let size = galley.size() + EVec2::new(10.0, 4.0);\"},{\"line_number\":1188,\"content\":\"            p.galley(r.min + EVec2::new(5.0, 2.0), galley, Color32::WHITE);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_ui/src/headless.rs\",\"matches\":[{\"line_number\":295,\"content\":\"            let text = t.galley.text().trim();\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-0c114616-b0ee-49b9-9404-a9b24d4f6bc8-52","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→SOURCE: Wii Fit\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n10→\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/shardfall/blob/main/START_HERE.md, making a new game on its engine. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\\n20→\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\n30→Effort: Spend effort however you see fit.\\n\\n## This computer\\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\\n\\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\\n40→  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\\n- **Not installed:** sox, bun, deno.\\n- **Network:** internet works (github.com, registry.npmjs.org).\\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\\n\\n### What this computer doesn't have\\n\\n50→No script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\\n\\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\\n\\n### Sharing this computer\\n60→\\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\\n\\n## Goal\\n\\nBuild an original game inspired by the source.\\n\\n70→Scope\\n\\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\\n\\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\\n\\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\\n\\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\\n\\n80→Narrative tone: Use a writing style similar to the source’s.\",\"content_concise\":\"1→SOURCE: Wii Fit\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n10→\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/shardfall/blob/main/START_HERE.md, making a new game on its engine. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\\n20→\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\n30→Effort: Spend effort however you see fit.\\n\\n## This computer\\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\\n\\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\\n40→  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\\n- **Not installed:** sox, bun, deno.\\n- **Network:** internet works (github.com, registry.npmjs.org).\\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \\\"Target closed\\\", \\\"page crashed\\\" or \\\"browser has been closed\\\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\\n\\n### What this computer doesn't have\\n\\n50→No script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\\n\\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\\n\\n### Sharing this computer\\n60→\\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\\n\\n## Goal\\n\\nBuild an original game inspired by the source.\\n\\n70→Scope\\n\\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\\n\\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\\n\\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\\n\\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\\n\\n80→Narrative tone: Use a writing style similar to the source’s.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/TASK.md\",\"offset\":null,\"limit\":80,\"raw_output\":\"SOURCE: Wii Fit\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-grok-4.7-xhigh-20261104-222132].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/shardfall/blob/main/START_HERE.md, making a new game on its engine. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are