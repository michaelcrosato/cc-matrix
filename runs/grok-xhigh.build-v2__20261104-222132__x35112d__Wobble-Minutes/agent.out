ing.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"','\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"pip.beat1\\\" = [\\\"Your first exercises are in the Stillness Studio. Bank 3 minutes in the giant clam.\\\", \\\"Our minutes are longer. It is a wellness thing.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'), ('\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"pip.beat2\\\" = [\\\"Today you may visit the Iron Gazebo. The wardrobe by the desk is also open. Clothes are optional. They are not. Bank 5 minutes.\\\"]'\\\"'\\\"''\\\"'\\\"''\\\"'\\\"','\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"pip.beat2\\\" = [\\\"Today you may visit the Iron Gazebo. Bank 5 minutes.\\\", \\\"The wardrobe by the desk is also open. Clothes are optional. They are not.\\\"]'\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'), ('\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"pip.beat3\\\" = [\\\"Today, the Boardwalk. Also, a ghost of you will appear beside you, doing yesterday'\\\"'\\\"'s best. I am not comparing you. Bank 7 minutes.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"','\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"pip.beat3\\\" = [\\\"Today, the Boardwalk. Bank 7 minutes.\\\", \\\"Also, a ghost of you will appear beside you, doing yesterday'\\\"'\\\"'s best.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'), ('\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"tom.reward\\\" = [\\\"All five! You'\\\"'\\\"'ve gone and done it. I don'\\\"'\\\"'t\\n know what to say. I'\\\"'\\\"'ll say this: you take these. The golden ones. Won them in a raffle. Too good for me.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"','\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'\\\"tom.reward\\\" = [\\\"All five! You'\\\"'\\\"'ve gone and done it. I don'\\\"'\\\"'t know what to say.\\\", \\\"I'\\\"'\\\"'ll say this: you take these. The golden ones. Won them in a raffle. Too good for me.\\\", '\\\"'\\\"''\\\"'\\\"''\\\"'\\\"'), ]) patch(F+'\\\"'\\\"'flow.rs'\\\"'\\\"',[ (\\\"\\\"\\\"        // Dialogue first.         if self.dialog.is_some() && self.overlays.is_empty() && !input.just(b::PAUSE) {\\\"\\\"\\\",\\\"\\\"\\\"        // The intro can be sk