\\n        radius: f32,\\n    },\\n    Step {\\n        pos: Vec3,\\n    },\\n    Throw {\\n        pos: Vec3,\\n    },\\n90→    EnterRoom {\\n        room: u16,\\n    },\\n    ExitRoom {\\n        room: u16,\\n    },\\n    Hit {\\n        pos: Vec3,\\n        strength: f32,\\n        /// The character struck, when it is one.\\n100→        #[serde(default)]\\n        target: Option<EntityId>,\\n    },\\n    Respawn {\\n        pos: Vec3,\\n    },\\n    CourseStart {\\n        pos: Vec3,\\n    },\\n    CourseFinish {\\n110→        pos: Vec3,\\n        time: f32,\\n        new_best: bool,\\n    },\\n    Gate {\\n        pos: Vec3,\\n        ok: bool,\\n    },\\n    Checkpoint {\\n        pos: Vec3,\\n120→    },\\n    Splash {\\n        pos: Vec3,\\n    },\\n    Pad {\\n        pos: Vec3,\\n    },\\n    /// A blaster shot, an enemy hit, an enemy destroyed.\\n    Shot {\\n        pos: Vec3,\\n130→    },\\n    Damage {\\n        pos: Vec3,\\n    },\\n    Destroyed {\\n        pos: Vec3,\\n        size: f32,\\n    },\\n    /// A guard raised the alarm.\\n    Spotted {\\n140→        pos: Vec3,\\n    },\\n    Grab {\\n        pos: Vec3,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/frame.rs\",\"offset\":64,\"limit\":80,\"raw_output\":\"pub enum SimEvent {\\n    Spawned {\\n        id: EntityId,\\n        pos: Vec3,\\n    },\\n    Impact {\\n        pos: Vec3,\\n        strength: f32,\\n    },\\n    Jump {\\n        pos: Vec3,\\n    },\\n    Land {\\n        pos: Vec3,\\n        speed: f32,\\n    },\\n    Explosion {\\n        pos: Vec3,\\n        radius: f32,\\n    },\\n    Step {\\n        pos: Vec3,\\n    },\\n    Throw {\\n        pos: Vec3,\\n    },\\n    EnterRoom {\\n        room: u16,\\n    },\\n    ExitRoom {\\n        room: u16,\\n    },\\n    Hit {\\n        pos: Vec3,\\n        strength: f32,\\n        /// The character struck