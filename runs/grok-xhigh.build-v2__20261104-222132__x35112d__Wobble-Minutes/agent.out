   visual: pav_core::Visual::new(pav_core::Shape::Sphere { radius: 0.0 }, pav_core::Color([0.9, 0.9, 0.95])),\\n            prop: None,\\n            puppet: Some(pav_core::frame::PuppetFrame {\\n                state,\\n                feet_offset: 0.9,\\n                def: None,\\n                rig: None,\\n                tint: Some((tint, 0.55)),\\n2430→            }),\\n            pulse: -1.0,\\n            soft: None,\\n            vehicle: None,\\n            cone: None,\\n            scenery: false,\\n        });\\n    }\\n}\\n\\n2440→fn publish_stay(gfx: &Gfx, hud: &pav_core::frame::HudFrame) {\\n    let Some(status) = hud.status.as_deref() else { return };\\n    let scale = (gfx.window.scale_factor() as f32).max(0.01);\\n    let (pw, ph) = gfx.size();\\n    let css_w = pw as f32 / scale;\\n    let css_h = ph as f32 / scale;\\n    let items = hud.fit.as_ref().map(|ui| {\\n        ui.items\\n            .iter()\\n            .map(|it| {\\n2450→                serde_json::json!({\\n                    \\\"id\\\": it.id,\\n                    \\\"label\\\": it.label,\\n                    \\\"x\\\": it.rect[0] * css_w,\\n                    \\\"y\\\": it.rect[1] * css_h,\\n                    \\\"w\\\": it.rect[2] * css_w,\\n                    \\\"h\\\": it.rect[3] * css_h,\\n                })\\n            })\\n            .collect::<Vec<_>>()\\n2460→    });\\n    let ui_json = serde_json::to_string(&items.unwrap_or_default()).unwrap_or_else(|_| \\\"[]\\\".into());\\n    crate::weblink::publish(status, &ui_json);\\n}\\n\\nfn apply_browser_save(host: &SimHost, status: Option<&str>, loaded: &mut bool, serial: &mut u32) {\\n    #[cfg(not(target_arch = \\\"wasm32\\\"))]\\n    {\\n        let _ = (host, status, loaded, serial);\\n    }\\n2470→    #[cfg(target_arch = \\\"wasm32\\\")]\\n    {\\n        let Some(status) = status else { return };\\n        let Ok(v) = serde_json::from_str::<serde_json::Value>(status) else { return };\\n        let now = v.get(\