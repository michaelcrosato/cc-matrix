\"            eyes(&mut parts, head, hr, fwd, right, cam_fwd, def, 0.24);\"},{\"line_number\":642,\"content\":\"            eyes(&mut parts, head, hr, d0, r0, cam_fwd, def, 0.22);\"},{\"line_number\":676,\"content\":\"            eyes(&mut parts, head + hf * hr * 0.15, hr, hf, hr_, cam_fwd, def, 0.2);\"},{\"line_number\":697,\"content\":\"            eyes(&mut parts, face, (w * 0.5).min(h * 0.5), yaw * Vec3::Z, yaw * Vec3::X, cam_fwd, def, 0.16);\"},{\"line_number\":740,\"content\":\"                let color = Color::hex(if def.body == BodyPlan::Biped { &def.eyes } else { &def.skin });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/puppet.rs\",\"matches\":[{\"line_number\":168,\"content\":\"    pub eyes: String,\"},{\"line_number\":179,\"content\":\"    /// Tilt the eyes toward the camera so they stay visible from above (0..1).\"},{\"line_number\":180,\"content\":\"    pub eyes_to_camera: f32,\"},{\"line_number\":300,\"content\":\"            eyes: \\\"#15161a\\\".into(),\"},{\"line_number\":309,\"content\":\"            eyes_to_camera: 0.6,\"},{\"line_number\":356,\"content\":\"                eyes: \\\"#f2e6c9\\\".into(),\"},{\"line_number\":402,\"content\":\"                eyes: \\\"#2a1e14\\\".into(),\"},{\"line_number\":452,\"content\":\"        v.float(\\\"eyes_to_camera\\\", &mut self.eyes_to_camera, 0.0, 1.0, \\\"Keep eyes visible from above\\\");\"},{\"line_number\":736,\"content\":\"    pub fn play_clip(&mut self, id: u32, flags: u8, speed: f32) {\"},{\"line_number\":761,\"content\":\"    pub fn replay_clip(&mut self, id: u32, flags: u8, speed: f32) {\"},{\"line_number\":770,\"content\":\"        self.play_clip(id, flags, speed);\"},{\"line_number\":866,\"content\":\"    /// Glow (emissive), for enchanted blades, orbs and eyes.\"},{\"line_number\":994,\"content\":\"        // Small features (eyes, markings) inside a bigger 