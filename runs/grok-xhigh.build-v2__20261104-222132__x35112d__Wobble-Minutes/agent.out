{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-e61231f5-3bfc-4714-b861-0c4528b3c401-20","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"650→            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n660→        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n670→            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n680→    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n690→        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n700→                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n710→                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n720→                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n730→                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n740→                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n750→                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n760→                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Demo => {}\\n        }\\n    }\\n770→\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n780→            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n790→                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n800→        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n810→        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n820→        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n830→                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n840→                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n850→                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n860→                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n870→            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n880→                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n890→            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n900→                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n910→                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n920→                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n930→                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n940→                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n950→                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n960→            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn begin_together(&mut self, n: u8) {\\n        let names = self.script().names.clone();\\n        self.together_n = n.clamp(2, 4);\\n        self.together_i = 0;\\n970→        self.medley_i = 0;\\n        self.together_names = (0..self.together_n).map(|i| names.get(i as usize).cloned().unwrap_or_else(|| format!(\\\"Guest {}\\\", i + 1))).collect();\\n        self.together_scores = vec![0.0; self.together_n as usize];\\n        self.run = Run::Together;\\n        self.flow = Flow::Pass;\\n        self.focus = 0;\\n        self.line_i = 0;\\n    }\\n\\n    fn open_settings(&mut self) {\\n980→        self.return_flow = if self.flow == Flow::Settings { self.return_flow } else { self.flow };\\n        if self.flow == Flow::Attract {\\n            self.demo = false;\\n        }\\n        self.flow = Flow::Settings;\\n        self.page = 0;\\n        self.focus = 0;\\n        self.reset_arm = false;\\n    }\\n\\n990→    fn activate_settings(&mut self, id: u16) {\\n        match id {\\n            ACT_XBOX => self.settings.xbox = !self.settings.xbox,\\n            ACT_FULLSCREEN => self.settings.fullscreen = !self.settings.fullscreen,\\n            ACT_RESET_SAVE => {\\n                if self.reset_arm {\\n                    self.slots = vec![Slot::default(); 4];\\n                    self.reset_arm = false;\\n                    self.save_serial = self.save_serial.wrapping_add(1);\\n                } else {\\n1000→                    self.reset_arm = true;\\n                }\\n            }\\n            ACT_BACK => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n1010→        self.flow = match self.flow {\\n            Flow::Slots | Flow::About | Flow::HowTo | Flow::Settings | Flow::Podium => {\\n                if self.flow == Flow::Settings || self.flow == Flow::About || self.flow == Flow::HowTo {\\n                    let back = self.return_flow;\\n                    if back == Flow::Attract {\\n                        self.demo = true;\\n                    }\\n                    if self.flow == Flow::Podium {\\n                        self.run = Run::Story;\\n                    }\\n1020→                    back\\n                } else if self.flow == Flow::Podium {\\n                    self.run = Run::Story;\\n                    Flow::Title\\n                } else {\\n                    Flow::Title\\n                }\\n            }\\n            Flow::Schedule => Flow::Island,\\n            Flow::Wardrobe | Flow::Calendar => self.return_flow,\\n1030→            Flow::Dev => self.paused_from,\\n            Flow::Name | Flow::Look | Flow::Outfit => Flow::Title,\\n            _ => Flow::Title,\\n        };\\n    }\\n\\n    fn after_result(&mut self) {\\n        self.focus = 0;\\n        if self.run == Run::Direct || self.hub_mode {\\n            return;\\n1040→        }\\n        if self.run == Run::Together {\\n            return;\\n        }\\n        self.flow = Flow::Island;\\n    }\\n\\n    fn apply_slider(&mut self, id: u16, v: f32) {\\n        let v = v.clamp(0.0, 1.0);\\n        match id {\",\"content_concise\":\"650→            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n660→        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n670→            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n680→    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n690→        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n700→                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n710→                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n720→                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n730→                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n740→                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n750→                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n760→                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Demo => {}\\n        }\\n    }\\n770→\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n780→            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n790→                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n800→        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n810→        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n820→        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n830→                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n840→                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n850→                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n860→                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n870→            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n880→                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n890→            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n900→                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n910→                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n920→                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n930→                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n940→                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n950→                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n960→            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn begin_together(&mut self, n: u8) {\\n        let names = self.script().names.clone();\\n        self.together_n = n.clamp(2, 4);\\n        self.together_i = 0;\\n970→        self.medley_i = 0;\\n        self.together_names = (0..self.together_n).map(|i| names.get(i as usize).cloned().unwrap_or_else(|| format!(\\\"Guest {}\\\", i + 1))).collect();\\n        self.together_scores = vec![0.0; self.together_n as usize];\\n        self.run = Run::Together;\\n        self.flow = Flow::Pass;\\n        self.focus = 0;\\n        self.line_i = 0;\\n    }\\n\\n    fn open_settings(&mut self) {\\n980→        self.return_flow = if self.flow == Flow::Settings { self.return_flow } else { self.flow };\\n        if self.flow == Flow::Attract {\\n            self.demo = false;\\n        }\\n        self.flow = Flow::Settings;\\n        self.page = 0;\\n        self.focus = 0;\\n        self.reset_arm = false;\\n    }\\n\\n990→    fn activate_settings(&mut self, id: u16) {\\n        match id {\\n            ACT_XBOX => self.settings.xbox = !self.settings.xbox,\\n            ACT_FULLSCREEN => self.settings.fullscreen = !self.settings.fullscreen,\\n            ACT_RESET_SAVE => {\\n                if self.reset_arm {\\n                    self.slots = vec![Slot::default(); 4];\\n                    self.reset_arm = false;\\n                    self.save_serial = self.save_serial.wrapping_add(1);\\n                } else {\\n1000→                    self.reset_arm = true;\\n                }\\n            }\\n            ACT_BACK => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n1010→        self.flow = match self.flow {\\n            Flow::Slots | Flow::About | Flow::HowTo | Flow::Settings | Flow::Podium => {\\n              