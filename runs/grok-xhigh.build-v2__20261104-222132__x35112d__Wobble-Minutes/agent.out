: &str) -> Result<Self, String> {\"},{\"line_number\":185,\"content\":\"        if let Some(format) = value.get(\\\"format\\\").filter(|format| format.as_u64() != Some(1)) {\"},{\"line_number\":188,\"content\":\"                .fix(\\\"translate the set to format 1, or keep it out of anim/: format 2.0's hands, fingers, spine, yaw and requires would be lost\\\");\"},{\"line_number\":193,\"content\":\"                .fix(\\\"a format-1 set holds set, title, format, credit, legend, fps, sources, fit and clips\\\")\"},{\"line_number\":290,\"content\":\"            &format!(\\\"\\\\\\\"set\\\\\\\": {},\\\\n\\\\\\\"title\\\\\\\": {},\\\\n\\\\\\\"format\\\\\\\": {},\\\\n\\\", json(&self.set), json(&self.title), self.format.max(1));\"},{\"line_number\":1032,\"content\":\"            format!(r#\\\"{{\\\"set\\\":\\\"T\\\",\\\"format\\\":{format},\\\"clips\\\":{{\\\"Stand\\\":{{\\\"dur\\\":1,\\\"keys\\\":[{key}]{extra}}}}}}}\\\"#)\"},{\"line_number\":1040,\"content\":\"        assert!(error.contains(\\\"handL\\\"), \\\"a field format 1 does not know is refused, not dropped: {error}\\\");\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"bf73f8ff-e481-4ae5-b9a2-27711b92c25d"}
