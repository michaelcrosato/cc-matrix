frames: u32,\\n    pub left: Vec2,\\n    pub right: Vec2,\\n    pub hold: Vec<gilrs::Button>,\\n    pub tap: Vec<gilrs::Button>,\\n}\\n\\n/// A scripted gamepad, one step per line:\\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\\n#[derive(Clone, Debug, Default)]\\npub struct PadScript {\\n    pub steps: Vec<PadStep>,\\n    at: usize,\\n    frame: u32,\\n}\\n\\nimpl PadScript {\\n    #[cfg_attr(target_arch = \\\"wasm32\\\", allow(dead_code))]\\n    pub fn parse(text: &str) -> Result<PadScript, String> {\\n        let button = |n: &str| -> Result<gilrs::Button, String> {\\n            use gilrs::Button as B;\\n            Ok(match n {\\n                \\\"South\\\" | \\\"A\\\" => B::South,\\n                \\\"East\\\" | \\\"B\\\" => B::East,\\n                \\\"West\\\" | \\\"X\\\" => B::West,\\n                \\\"North\\\" | \\\"Y\\\" => B::North,\\n                \\\"LeftTrigger\\\" | \\\"LB\\\" => B::LeftTrigger,\\n                \\\"RightTrigger\\\" | \\\"RB\\\" => B::RightTrigger,\\n                \\\"Start\\\" => B::Start,\\n                \\\"Select\\\" => B::Select,\\n                \\\"DPadUp\\\" => B::DPadUp,\\n                \\\"DPadDown\\\" => B::DPadDown,\\n                \\\"DPadLeft\\\" => B::DPadLeft,\\n                \\\"DPadRight\\\" => B::DPadRight,\\n                o => return Err(format!(\\\"unknown button '{o}'\\\")),\\n            })\\n        };\\n        let vec = |v: &str| -> Result<Vec2, String> {\\n            let (x, y) = v.split_once(',').ok_or(format!(\\\"'{v}': want x,y\\\"))?;\\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\\\"'{v}'\\\"))?, y.trim().parse().map_err(|_| format!(\\\"'{v}'\\\"))?))\\n        };\\n        let mut steps = Vec::new();\\n        for (n, line) in text.lines().enumerate() {\\n            let line = line.split('#').next().unwrap_or(\\\"\\\").trim();\\n            if line.is_empty() {\\n                continue;\\n            }\\n            let mut words = line.split_whitespace();\\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\\\"line {}: starts with a frame count\\\", n + 1))?;\\n            let mut st = PadStep { frames, ..Default::default() };\\n            for w in words {\\n                let (k, v) = w.split_once('=').ok_or(format!(\\\"line {}: '{w}'\\\", n + 1))?;\\n                match k {\\n                    \\\"left\\\" => st.left = vec(v)?,\\n                    \\\"right\\\" => st.right = vec(v)?,\\n                    \\\"hold\\\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\\n                    \\\"tap\\\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\\n                    o => return Err(format!(\\\"line {}: unknown '{o}'\\\", n + 1)),\\n                }\\n            }\\n            steps.push(st);\\n        }\\n        Ok(PadScript { steps, at: 0, frame: 0 })\\n    }\\n\\n    /// This frame's step (and whether it's the step's first frame); None when done.\\n    fn next(&mut self) -> Option<(PadStep, bool)> {\\n        let st = self.steps.get(self.at)?.clone();\\n        let first = self.frame == 0;\\n        self.frame += 1;\\n        if self.frame >= st.frames.max(1) {\\n            self.at += 1;\\n            self.frame = 0;\\n        }\\n        Some((st, first))\\n    }\\n}\\n\\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\\n    let l = v.length();\\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\\n}\\n\\nimpl Input {\\n    pub fn new() -> Self {\\n        let gilrs = match gilrs::Gilrs::new() {\\n            Ok(g) => {\\n                for (_, gp) in g.gamepads() {\\n                    log::info!(\\\"gamepad: {} ({:?})\\\", gp.name(), gp.power_info());\\n                }\\n                Some(g)\\n            }\\n            Err(e) => {\\n                log::warn!(\\\"gamepads unavailable: {e}\\\");\\n                None\\n            }\\n        };\\n        Self {\\n            keys: HashSet::new(),\\n            mouse: HashSet::new(),\\n            cursor: Vec2::ZERO,\\n            mouse_active: false,\\n            gilrs,\\n            pad_script: None,\\n            pad: Pad::default(),\\n            // Pad glyphs until a key, a mouse move, or a stick is actually used.\\n            last_device: Device::Gamepad,\\n            prev_held: 0,\\n            key_taps: HashSet::new(),\\n            mouse_taps: HashSet::new(),\\n            bindings: Bindings::default(),\\n            game: false,\\n            fit: false,\\n            seen_real: false,\\n            coarse: false,\\n            lean_ramp: Vec2::ZERO,\\n            lean_from: 2,\\n            mouse_travel: 0.0,\\n            have_cursor: false,\\n            stick_y: 0.0,\\n            touch_tap: false,\\n        }\\n    }\\n\\n    pub fn note_pointer(&mut self, p: Vec2) {\\n        if self.have_cursor {\\n            self.mouse_travel += (p - self.cursor).length();\\n        } else {\\n            self.have_cursor = true;\\n        }\\n        self.cursor = p;\\n    }\\n\\n    pub fn mark_touch_tap(&mut self) {\\n        self.touch_tap = true;\\n    }\\n\\n    /// Lean, device and pointer for one stay frame. `items` are normalized rects.\\n    pub fn fit_sample(&mut self, dt: f32, size: Vec2, items: &[(u16, [f32; 4])], clicked: bool) -> FitSample {\\n        use pav_core::games::fit::intent::{key_ramp2, mouse_lean, shape_stick2};\\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c));\\n        let b = &self.bindings;\\n        let held_dir = Vec2::new(\\n            k(&b.right) as i32 as f32 - k(&b.left) as i32 as f32,\\n            k(&b.up) as i32 as f32 - k(&b.down) as i32 as f32,\\n        );\\n        let shift = self.held() & buttons::FOCUS != 0;\\n        let rate = if shift { 0.55 } else { 1.6 };\\n        self.lean_ramp = key_ramp2(self.lean_ramp, held_dir, dt, rate, 1.2);\\n        let stick = shape_stick2(self.pad.raw_left, 0.12, 1.5);\\n        if stick.length() > 0.05 {\\n            self.lean_from = 1;\\n            self.seen_real = true;\\n        }\\n        if held_dir.length() > 0.0 {\\n            self.lean_from = 2;\\n            self.seen_real = true;\\n        }\\n        if self.mouse_travel > 6.0 && !self.coarse {\\n            self.lean_from = 3;\\n        }\\n        let lean = match self.lean_from {\\n            1 => stick,\\n            3 => {\\n                let offset = Vec2::new(self.cursor.x - size.x * 0.5, size.y * 0.5 - self.cursor.y);\\n                mouse_lean(offset, size.y)\\n            }\\n            _ => self.lean_ramp,\\n        };\\n        let mut extra = 0u32;\\n        if stick.y > 0.55 && self.stick_y <= 0.55 {\\n            extra |= buttons::MENU_UP;\\n        }\\n        if stick.y < -0.55 && self.stick_y >= -0.55 {\\n            extra |= buttons::MENU_DOWN;\\n        }\\n        self.stick_y = stick.y;\\n        let mut ui = None;\\n        let travel = self.mouse_travel;\\n        self.mouse_travel = 0.0;\\n        let tap = clicked || self.touch_tap;\\n        self.touch_tap = false;\\n        if size.x > 1.0 && size.y > 1.0 {\\n            for (id, rect) in items {\\n                let x = rect[0] * size.x;\\n                let y = rect[1] * size.y;\\n                let w = rect[2] * size.x;\\n                let h = rect[3] * size.y;\\n                if self.cursor.x >= x && self.cursor.x <= x + w && self.cursor.y >= y && self.cursor.y <= y + h {\\n                    ui = Some(if tap { pav_core::input::UiEvent::Click(*id) } else { pav_core::input::UiEvent::Hover(*id) });\\n                }\\n            }\\n        }\\n        let device = if self.coarse && !self.seen_real {\\n            4\\n        } else if self.last_device == Device::Gamepad {\\n            1\\n        } else if self.lean_from == 3 {\\n            3\\n        } else if self.last_device == Device::Touch {\\n            4\\n        } else {\\n            2\\n        };\\n        let any = !self.coarse && (self.pad.any_activity || travel > 6.0 || stick.length() > 0.3 || lean.length() > 0.3);\\n        FitSample { lean, device, any, ui, extra }\\n    }\\n\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.seen_real = true;\\n        match state {\\n            ElementState::Pressed => {\\n\",\"total_lines\":803}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"6c39b182-86d5-428f-aca2-923309ff3ec2"}
