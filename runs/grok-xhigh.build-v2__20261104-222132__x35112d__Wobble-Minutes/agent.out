nt\":\"    LAYER_KEYS\"},{\"line_number\":725,\"content\":\"        _ if LAYER_KEYS.contains(&key) => {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/starter.rs\",\"matches\":[{\"line_number\":5,\"content\":\"//! `<key>.toml`, change `KEY`, add its line to `GAMES` in `mod.rs`, then change the rules.\"},{\"line_number\":77,\"content\":\"    let def = RoomDef::parse(&super::level_text(Starter::KEY, LEVEL)).map_err(|e| anyhow!(\\\"starter.toml: {e}\\\"))?;\"},{\"line_number\":79,\"content\":\"    crate::scenes::build_standalone_room(sim, Starter::KEY, def);\"},{\"line_number\":110,\"content\":\"    const KEY: &'static str = \\\"starter\\\";\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/mod.rs\",\"matches\":[{\"line_number\":47,\"content\":\"    /// The scene key that starts the game: `load scene=<KEY>`, `--scene <KEY>`, `?scene=<KEY>`.\"},{\"line_number\":48,\"content\":\"    const KEY: &'static str;\"},{\"line_number\":115,\"content\":\"    Entry { key: G::KEY, about, build, load: load_as::<G> }\"},{\"line_number\":242,\"content\":\"        G::KEY\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/props/write.rs\",\"matches\":[{\"line_number\":248,\"content\":\"    use crate::material::schema::{FIELDS, LAYER_KEYS};\"},{\"line_number\":266,\"content\":\"                                ordered(layer, LAYER_KEYS)\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/mod.rs\",\"matches\":[{\"line_number\":1407,\"content\":\"    const KEY