_number\":47,\"content\":\"pub const ACT_END_DAY: u16 = 90;\"},{\"line_number\":48,\"content\":\"pub const ACT_RETRY: u16 = 91;\"},{\"line_number\":49,\"content\":\"pub const ACT_RESULT_BACK: u16 = 92;\"},{\"line_number\":50,\"content\":\"pub const ACT_G2: u16 = 80;\"},{\"line_number\":51,\"content\":\"pub const ACT_G3: u16 = 81;\"},{\"line_number\":52,\"content\":\"pub const ACT_G4: u16 = 82;\"},{\"line_number\":534,\"content\":\"                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\"},{\"line_number\":536,\"content\":\"                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\"},{\"line_number\":538,\"content\":\"                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\"},{\"line_number\":539,\"content\":\"                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\"},{\"line_number\":540,\"content\":\"                v.push((ACT_ABOUT, \\\"About\\\".into()));\"},{\"line_number\":541,\"content\":\"                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\"},{\"line_number\":553,\"content\":\"                v.push((ACT_BACK, \\\"Back\\\".into()));\"},{\"line_number\":567,\"content\":\"                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\"},{\"line_number\":569,\"content\":\"                v.push((ACT_BACK, \\\"Back\\\".into()));\"},{\"line_number\":573,\"content\":\"                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\"},{\"line_number\":574,\"content\":\"                (ACT_RETRY, \\\"Retry\\\".into()),\"},{\"line_number\":577,\"content\":\"                (ACT_G2, \\\"2 guests\\\".into()),\"},{\"line_number\":578,\"content\":\"                (ACT_G3, \\\"3 guests\\\".into()),\"},{\"line_number\":579,\"content\":\"                (ACT_G4, \\\"4 guests\\\".into()),\"},{\"line_number\":580,\"content\":\"                (ACT_BACK, \\\"Back\\\".into()),\"},{\"line_number\":584,\"content\":\"            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\"},{\"line_number\":585,\"content\":\"            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\"},{\"line_number\":586,\"content\":\"            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\"},{\"line_number\":587,\"content\":\"            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\"},{\"line_number\":599,\"content\":\"                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\"},{\"line_number\":601,\"content\":\"                (ACT_BACK, \\\"Back\\\".into()),\"},{\"line_number\":607,\"content\":\"                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\"},{\"line_number\":608,\"content\":\"                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\"},{\"line_number\":609,\"content\":\"                (ACT_BACK, \\\"Back\\\".into()),\"},{\"line_number\":617,\"content\":\"                (ACT_RESUME, \\\"Resume\\\".into()),\"},{\"line_number\":618,\"content\":\"                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\"},{\"line_number\":621,\"content\":\"                (ACT_SETTINGS, \\\"Settings\\\".into()),\"},{\"line_number\":622,\"content\":\"                (ACT_ABOUT, \\\"About\\\".into()),\"},{\"line_number\":642,\"content\":\"                v.push((ACT_BACK, \\\"Back\\\".into()));\"},{\"line_number\":686,\"content\":\"    fn finish_play(&mut self, sim: &mut Sim) {\"},{\"line_number\":820,\"content\":\"        if id == ACT_BACK {\"},{\"line_number\":826,\"content\":\"                ACT_NEW => {\"},{\"line_number\":831,\"content\":\"                ACT_CONTINUE => {\"},{\"line_number\":836,\"content\":\"                ACT_TOGETHER => {\"},{\"line_number\":841,\"content\":\"                ACT_SETTINGS => self.open_settings(),\"}