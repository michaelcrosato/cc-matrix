{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-d4fbd167-e261-4cde-9269-24dc6544ab6f-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"600→        EventId::Check => tick_check(act, bal, pressed, dt, events),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n610→        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n\\nfn finish_score(act: &mut Activity) {\\n620→    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32, events: &mut Vec<SimEvent>) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n630→            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n640→                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n650→                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n                act.hold += dt;\\n            } else {\\n660→                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n670→                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            // Eyes closed: the pitch is the only tell. Higher means farther from the middle.\\n            let pitch = 0.55 + bal.cob.length() * 3.0;\\n            act.guide = pitch;\\n            events.push(SimEvent::Sfx { id: 31, gain: 0.35, pitch });\\n            act.still_sum += bal.cob.length() * dt;\\n680→            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n690→            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n700→            }\\n            act.sub += dt;\\n            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n710→    }\\n}\\n\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n720→    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n730→        if finale {\\n            act.phase_scores.push(act.score);\\n        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n740→    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\",\"content_concise\":\"600→        EventId::Check => tick_check(act, bal, pressed, dt, events),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n610→        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n\\nfn finish_score(act: &mut Activity) {\\n620→    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32, events: &mut Vec<SimEvent>) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n630→            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n640→                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n650→                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n                act.hold += dt;\\n            } else {\\n660→                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n670→                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            // Eyes closed: the pitch is the only tell. Higher means farther from the middle.\\n            let pitch = 0.55 + bal.cob.length() * 3.0;\\n            act.guide = pitch;\\n            events.push(SimEvent::Sfx { id: 31, gain: 0.35, pitch });\\n            act.still_sum += bal.cob.length() * dt;\\n680→            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n690→            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n700→            }\\n            act.sub += dt;\\n            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n710→    }\\n}\\n\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n720→    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n730→        if finale {\\n            act.phase_scores.push(act.score);\\n        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n740→    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/events.rs\",\"offset\":600,\"limit\":150,\"raw_output\":\"        EventId::Check => tick_check(act, bal, pressed, dt, events),\\n        EventId::Breath => tick_breath(act, bal, held, dt, rules, false),\\n        EventId::Pose => tick_pose(act, bal, dt, rules),\\n        EventId::Squat => tick_squat(act, bal, held, dt, rules, events),\\n        EventId::Plank => tick_plank(act, bal, held, dt, rules),\\n        EventId::Step => tick_step(act, pressed, dt, rules),\\n        EventId::Floatie => tick_floatie(act, lean, pressed, dt, rules),\\n        EventId::Lap => tick_lap(act, lean, pressed, dt, rules),\\n        EventId::Tide => tick_tide(act, bal, dt, rules, &mut sim.state.rng),\\n        EventId::Paddle => tick_paddle(act, lean, dt, rules, events),\\n        EventId::Tray => tick_tray(act, bal, dt, rules, events),\\n        EventId::Cannon => tick_cannon(act, lean, held, pressed, dt, rules, events),\\n        EventId::BigStand => tick_big(act, bal, lean, held, pressed, dt, rules, events),\\n    }\\n    if act.done {\\n        finish_score(act);\\n    }\\n}\\n\\nfn finish_score(act: &mut Activity) {\\n    act.stars = if act.kind == EventId::Plank { stars_from_plank(act.survived) } else { stars_from_score(act.score) };\\n}\\n\\nfn tick_check(act: &mut Activity, bal: &BalanceCore, pressed: u32, dt: f32, events: &mut Vec<SimEvent>) {\\n    match act.phase {\\n        0 => {\\n            if act.sub >= 5.0 && !act.nudged {\\n                act.nudged = true;\\n            }\\n            let extra = if act.nudged && act.sub < 5.4 { 0.25 } else { 0.0 };\\n            act.still_sum += (bal.cob.length() + extra) * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 8.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[0] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                act.target_i = 0;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        1 => {\\n            let targets = [-0.70_f32, 0.55, 0.0];\\n            if act.target_i >= 3 {\\n                act.metrics[1] = act.targets_hit as f32 / 3.0;\\n                act.phase = 2;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n                return;\\n            }\\n            let x = targets[act.target_i as usize];\\n            let close = (bal.cob.x - x).abs() < 0.06 && bal.cob.y.abs() < 0.25;\\n            if close {\\n                act.hold += dt;\\n            } else {\\n                act.hold = 0.0;\\n            }\\n            act.target_time += dt;\\n            if act.hold >= 1.5 {\\n                act.targets_hit += 1;\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            } else if act.target_time >= 5.0 {\\n                act.target_i += 1;\\n                act.hold = 0.0;\\n                act.target_time = 0.0;\\n            }\\n        }\\n        2 => {\\n            // Eyes closed: the pitch is the only tell. Higher means farther from the middle.\\n            let pitch = 0.55 + bal.cob.length() * 3.0;\\n            act.guide = pitch;\\n            events.push(SimEvent::Sfx { id: 31, gain: 0.35, pitch });\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            if act.sub >= 6.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n                act.metrics[2] = (1.0 - mean / 0.10).clamp(0.0, 1.0);\\n                act.phase = 3;\\n                act.sub = 0.0;\\n            }\\n        }\\n        _ => {\\n            let beat = 0.6;\\n            let i = (act.sub / beat).floor() as i32;\\n            if pressed & (buttons::STEP_L | buttons::STEP_R) != 0 && i >= 0 && i < 8 {\\n                let at = i as f32 * beat;\\n                let err = (act.sub - at).abs();\\n                let want_l = i % 2 == 0;\\n                let got_l = pressed & buttons::STEP_L != 0;\\n                if err < 0.12 && want_l == got_l && act.step_hit as i32 <= i {\\n                    act.step_hit += 1;\\n                }\\n            }\\n            act.sub += dt;\\n            if act.sub >= 8.0 * beat {\\n                act.metrics[3] = act.step_hit as f32 / 8.0;\\n                let m = act.metrics;\\n                let skill = 0.30 * m[0] + 0.25 * m[1] + 0.25 * m[2] + 0.20 * m[3];\\n                act.score = (skill * 1000.0).clamp(0.0, 1000.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nfn tick_breath(act: &mut Activity, bal: &BalanceCore, held: u32, dt: f32, rules: &Rules, finale: bool) {\\n    let cap = if finale { 32.0 } else { rules.breath_secs };\\n    act.guide = breath_guide(act.t);\\n    if held & buttons::CONFIRM != 0 {\\n        act.lungs = (act.lungs + dt / 4.0).min(1.0);\\n    } else {\\n        act.lungs = (act.lungs - dt / 4.0).max(0.0);\\n    }\\n    let err = ((act.lungs - act.guide).abs() / 0.35).clamp(0.0, 1.0);\\n    let in_ring = if bal.cob.length() < 0.35 { 1.0 } else { 0.0 };\\n    // Standing in the ring without breathing is a low score. Following the guide is the activity.\\n    let tick = 0.85 * (1.0 - err) + 0.15 * in_ring;\\n    act.acc += tick * dt;\\n    act.t += dt;\\n    if act.t >= cap {\\n        act.score = (act.acc / cap * 1000.0).clamp(0.0, 1000.0);\\n        act.done = !finale;\\n        if finale {\\n            act.phase_scores.push(act.score);\\n        }\\n    }\\n}\\n\\nfn tick_pose(act: &mut Activity, bal: &BalanceCore, dt: f32, rules: &Rules) {\\n    let pose_len = rules.pose_secs;\\n    act.pose_i = (act.t / pose_len).floor().clamp(0.0, 2.0) as u8;\\n    let local = act.t - act.pose_i as f32 * pose_len;\\n    if act.pose_i == 1 && local >= 12.0 && local < 17.0 {\\n        act.amp_scale = 1.6;\\n    } else {\\n        act.amp_scale = 1.0;\\n    }\\n    let shrink = (local / pose_len).clamp(0.0, 1.0);\\n    let radius = rules.pose_ring + (0.18 - rules.pose_ring) * shrink;\\n    let inside = act.lock <= 0.0 && (bal.cob - ring_center(act.t)).length() < radius.max(0.12);\\n    if inside {\\n        act.streak += dt;\\n\",\"total_lines\":1267}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d4fbd167-e261-4cde-9269-24dc6544ab6f-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1100→        let phase = act.t / 1.2;\\n        let s = (phase * std::f32::consts::TAU).sin();\\n        let prev = ((act.t - dt) / 1.2 * std::f32::consts::TAU).sin();\\n        let bottom = s < -0.9 && s > prev;\\n        if bottom && pressed & buttons::CONFIRM != 0 && act.power < 4.0 {\\n            act.power += 1.0;\\n            events.push(SimEvent::Sfx { id: 14, gain: 0.6, pitch: 0.8 + act.power * 0.1 });\\n            if act.power >= 4.0 {\\n                act.leaping = true;\\n                act.air = 0.0;\\n1110→                act.tuck = 0.0;\\n            }\\n        }\\n    } else {\\n        act.air += dt;\\n        if held & buttons::CONFIRM != 0 {\\n            act.tuck = (act.tuck + dt / 0.35).min(1.0);\\n        }\\n        act.px += lean.x * dt;\\n        let s = (act.air * 3.0).sin();\\n1120→        let prev = ((act.air - dt) * 3.0).sin();\\n        // Landing is the way down, while the tuck still counts. Waiting for the splash to flatten scored nothing.\\n        let landing = act.air > 0.55 && s > 0.0 && s < prev && s < 0.5;\\n        if landing {\\n            let timing = (1.0 - (act.air - 0.9).abs() / 0.35).clamp(0.0, 1.0);\\n            let sc = ((0.35 + 0.65 * act.tuck) * (0.4 + 0.6 * timing) * rules.bounce_gain).clamp(0.0, 1.0);\\n            act.dive_scores.push(sc);\\n            act.dives += 1;\\n            events.push(SimEvent::BigSplash { pos: glam::Vec3::new(act.px, 0.0, 2.0), size: 1.2 + act.tuck });\\n            act.leaping = false;\\n1130→            act.power = 0.0;\\n            act.air = 0.0;\\n            act.tuck = 0.0;\\n        }\\n    }\\n    act.t += dt;\\n    if act.dives >= 3 || act.t >= rules.cannon_secs {\\n        let n = 3.0;\\n        let sum: f32 = act.dive_scores.iter().sum();\\n        act.score = (sum / n * 1000.0).clamp(0.0, 1000.0);\\n1140→        act.done = true;\\n    }\\n}\\n\\nfn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\\n    let _ = lean;\\n    match act.phase {\\n        0 => {\\n            let before = act.t;\\n            tick_breath(act, bal, held, dt, rules, true);\\n1150→            act.t = before + dt;\\n            if act.t >= 32.0 {\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.done = false;\\n            }\\n        }\\n        1 => {\\n            let c = ring_center(act.sub);\\n1160→            let inside = (bal.cob - c).length() < 0.28;\\n            if inside {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 2;\\n                act.sub = 0.0;\\n1170→                act.acc = 0.0;\\n                act.note_i = 0;\\n                // Use the first notes, time-shifted into this phase by rewriting a local clock.\\n                act.t_shift_notes();\\n            }\\n        }\\n        2 => {\\n            let local_pressed = pressed;\\n            let start_t = act.t;\\n            // tick_step uses act.t against note times. Notes were shifted.\\n1180→            let saved_dur = rules.step_secs;\\n            let _ = saved_dur;\\n            tick_step_window(act, local_pressed, dt, rules, 40.0);\\n            if act.t - start_t < dt * 0.5 {\\n                act.t = start_t + dt;\\n            }\\n            act.sub += dt;\\n            if act.sub >= 40.0 {\\n                act.phase_scores.push(act.score);\\n                act.phase = 3;\\n1190→                act.sub = 0.0;\\n                act.done = false;\\n                act.flopped = false;\\n                act.survived = 0.0;\\n            }\\n        }\\n        3 => {\\n            if braced(held) && bal.cob.length() < 0.45 {\\n                act.acc += dt;\\n            }\\n1200→            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 4;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n            }\\n        }\\n1210→        _ => {\\n            if act.sub >= 15.0 && pressed != 0 {\\n                act.forfeit = true;\\n            }\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 30.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n1220→                let quiet = (1.0 - mean / 0.2).clamp(0.0, 1.0);\\n                let mut s = quiet * 1000.0;\\n                if !act.forfeit {\\n                    s = (s + 200.0).min(1000.0);\\n                } else {\\n                    s *= 0.5;\\n                }\\n                act.phase_scores.push(s);\\n                let n = act.phase_scores.len().max(1) as f32;\\n                let sum: f32 = act.phase_scores.iter().copied().sum();\\n1230→                act.score = (sum / n).clamp(0.0, 1000.0);\\n                // Tips cost score but never end the run.\\n                act.score = (act.score - act.tips as f32 * 15.0).max(0.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Activity {\\n1240→    fn t_shift_notes(&mut self) {\\n        if self.notes.is_empty() {\\n            return;\\n        }\\n        let t0 = self.notes[0][0];\\n        for n in &mut self.notes {\\n            n[0] = self.t + (n[0] - t0);\\n        }\\n        self.note_i = 0;\\n        self.acc = 0.0;\\n1250→        self.hits = 0;\\n    }\\n}\\n\\nfn tick_step_window(act: &mut Activity, pressed: u32, dt: f32, rules: &Rules, window: f32) {\\n    let total = act.notes.len().max(1) as f32;\\n    let t0 = act.t;\\n    tick_step(act, pressed, dt, rules);\\n    // tick_step may mark done at step_secs. The finale uses its own clock.\\n    if act.done && act.kind == EventId::BigStand {\\n1260→        act.done = false;\\n        act.score = (act.acc / total * 1000.0).clamp(0.0, 1000.0);\\n    }\\n    if act.t < t0 + dt * 0.5 {\\n        act.t = t0 + dt;\\n    }\\n    let _ = window;\\n}\\n\",\"content_concise\":\"1100→        let phase = act.t / 1.2;\\n        let s = (phase * std::f32::consts::TAU).sin();\\n        let prev = ((act.t - dt) / 1.2 * std::f32::consts::TAU).sin();\\n        let bottom = s < -0.9 && s > prev;\\n        if bottom && pressed & buttons::CONFIRM != 0 && act.power < 4.0 {\\n            act.power += 1.0;\\n            events.push(SimEvent::Sfx { id: 14, gain: 0.6, pitch: 0.8 + act.power * 0.1 });\\n            if act.power >= 4.0 {\\n                act.leaping = true;\\n                act.air = 0.0;\\n1110→                act.tuck = 0.0;\\n            }\\n        }\\n    } else {\\n        act.air += dt;\\n        if held & buttons::CONFIRM != 0 {\\n            act.tuck = (act.tuck + dt / 0.35).min(1.0);\\n        }\\n        act.px += lean.x * dt;\\n        let s = (act.air * 3.0).sin();\\n1120→        let prev = ((act.air - dt) * 3.0).sin();\\n        // Landing is the way down, while the tuck still counts. Waiting for the splash to flatten scored nothing.\\n        let landing = act.air > 0.55 && s > 0.0 && s < prev && s < 0.5;\\n        if landing {\\n            let timing = (1.0 - (act.air - 0.9).abs() / 0.35).clamp(0.0, 1.0);\\n            let sc = ((0.35 + 0.65 * act.tuck) * (0.4 + 0.6 * timing) * rules.bounce_gain).clamp(0.0, 1.0);\\n            act.dive_scores.push(sc);\\n            act.dives += 1;\\n            events.push(SimEvent::BigSplash { pos: glam::Vec3::new(act.px, 0.0, 2.0), size: 1.2 + act.tuck });\\n            act.leaping = false;\\n1130→            act.power = 0.0;\\n            act.air = 0.0;\\n            act.tuck = 0.0;\\n        }\\n    }\\n    act.t += dt;\\n    if act.dives >= 3 || act.t >= rules.cannon_secs {\\n        let n = 3.0;\\n        let sum: f32 = act.dive_scores.iter().sum();\\n        act.score = (sum / n * 1000.0).clamp(0.0, 1000.0);\\n1140→        act.done = true;\\n    }\\n}\\n\\nfn tick_big(act: &mut Activity, bal: &BalanceCore, lean: Vec2, held: u32, pressed: u32, dt: f32, rules: &Rules, _events: &mut Vec<SimEvent>) {\\n    let _ = lean;\\n    match act.phase {\\n        0 => {\\n            let before = act.t;\\n            tick_breath(act, bal, held, dt, rules, true);\\n1150→            act.t = before + dt;\\n            if act.t >= 32.0 {\\n                act.phase = 1;\\n                act.sub = 0.0;\\n                act.acc = 0.0;\\n                act.done = false;\\n            }\\n        }\\n        1 => {\\n            let c = ring_center(act.sub);\\n1160→            let inside = (bal.cob - c).length() < 0.28;\\n            if inside {\\n                act.acc += dt;\\n            }\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 2;\\n                act.sub = 0.0;\\n1170→                act.acc = 0.0;\\n                act.note_i = 0;\\n                // Use the first notes, time-shifted into this phase by rewriting a local clock.\\n                act.t_shift_notes();\\n            }\\n        }\\n        2 => {\\n            let local_pressed = pressed;\\n            let start_t = act.t;\\n            // tick_step uses act.t against note times. Notes were shifted.\\n1180→            let saved_dur = rules.step_secs;\\n            let _ = saved_dur;\\n            tick_step_window(act, local_pressed, dt, rules, 40.0);\\n            if act.t - start_t < dt * 0.5 {\\n                act.t = start_t + dt;\\n            }\\n            act.sub += dt;\\n            if act.sub >= 40.0 {\\n                act.phase_scores.push(act.score);\\n                act.phase = 3;\\n1190→                act.sub = 0.0;\\n                act.done = false;\\n                act.flopped = false;\\n                act.survived = 0.0;\\n            }\\n        }\\n        3 => {\\n            if braced(held) && bal.cob.length() < 0.45 {\\n                act.acc += dt;\\n            }\\n1200→            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 20.0 {\\n                act.phase_scores.push((act.acc / 20.0 * 1000.0).clamp(0.0, 1000.0));\\n                act.phase = 4;\\n                act.sub = 0.0;\\n                act.still_sum = 0.0;\\n                act.still_n = 0.0;\\n            }\\n        }\\n1210→        _ => {\\n            if act.sub >= 15.0 && pressed != 0 {\\n                act.forfeit = true;\\n            }\\n            act.still_sum += bal.cob.length() * dt;\\n            act.still_n += dt;\\n            act.sub += dt;\\n            act.t += dt;\\n            if act.sub >= 30.0 {\\n                let mean = act.still_sum / act.still_n.max(0.001);\\n1220→                let quiet = (1.0 - mean / 0.2).clamp(0.0, 1.0);\\n                let mut s = quiet * 1000.0;\\n                if !act.forfeit {\\n                    s = (s + 200.0).min(1000.0);\\n                } else {\\n                    s *= 0.5;\\n                }\\n                act.phase_scores.push(s);\\n                let n = act.phase_scores.len().max(1) as f32;\\n                let sum: f32 = act.phase_scores.iter().copied().sum();\\n1230→                act.score = (sum / n).clamp(0.0, 1000.0);\\n                // Tips cost score but never end the run.\\n                act.score = (act.score - act.tips as f32 * 15.0).max(0.0);\\n                act.done = true;\\n            }\\n        }\\n    }\\n}\\n\\nimpl Activity {\\n1240→    fn t_shift_notes(&mut self) {\\n        if self.notes.is_empty() {\\n            return;\\n        }\\n        let t0 = self.notes[0][0];\\n        for n in &mut self.notes {\\n            n[0] = self.t + (n[0] - t0);\\n        }\\n        self.note_i = 0;\\n        self.acc = 0.0;\\n1250→        self.hits = 0;\\n    }\\n}\\n\\n