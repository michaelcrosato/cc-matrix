,32,32,32,32,32,32,32,32,32,83,101,114,118,101,114,67,108,97,115,115,61,84,104,114,101,97,100,105,110,103,72,84,84,80,83,101,114,118,101,114,44,10,49,52,49,54,58,32,32,32,32,99,108,97,115,115,32,68,117,97,108,83,116,97,99,107,83,101,114,118,101,114,77,105,120,105,110,58,10,49,52,50,57,58,32,32,32,32,99,108,97,115,115,32,72,84,84,80,68,117,97,108,83,116,97,99,107,83,101,114,118,101,114,40,68,117,97,108,83,116,97,99,107,83,101,114,118,101,114,77,105,120,105,110,44,32,84,104,114,101,97,100,105,110,103,72,84,84,80,83,101,114,118,101,114,41,58,10,49,52,51,49,58,32,32,32,32,99,108,97,115,115,32,72,84,84,80,83,68,117,97,108,83,116,97,99,107,83,101,114,118,101,114,40,68,117,97,108,83,116,97,99,107,83,101,114,118,101,114,77,105,120,105,110,44,32,84,104,114,101,97,100,105,110,103,72,84,84,80,83,83,101,114,118,101,114,41,58,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":9,\"file_matches\":[{\"path\":\"/home/linuxbrew/.linuxbrew/Cellar/python@3.14/3.14.8/lib/python3.14/http/server.py\",\"matches\":[{\"line_number\":86,\"content\":\"    \\\"HTTPServer\\\", \\\"ThreadingHTTPServer\\\",\"},{\"line_number\":87,\"content\":\"    \\\"HTTPSServer\\\", \\\"ThreadingHTTPSServer\\\",\"},{\"line_number\":154,\"content\":\"class ThreadingHTTPServer(socketserver.ThreadingMixIn, HTTPServer):\"},{\"line_number\":195,\"content\":\"class ThreadingHTTPSServer(socketserver.ThreadingMixIn, HTTPSServer):\"},{\"line_number\":1336,\"content\":\"def test(HandlerClass=BaseHTTPRequestHandler,\"},{\"line_number\":1337,\"content\":\"         ServerClass=ThreadingHTTPServer,\"},{\"line_number\":1416,\"content\":\"    class DualStackServerMixin:\"},{\"line_number\":1429,\"content\":\"    class HTTPDualStackServer(DualStackServerMixin, ThreadingHTTPServer):\"},{\"line_number\":1431,\"content\":\"    class HTTPSDualStackServer(DualStackServerMixin, ThreadingHTTPSServer):\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":