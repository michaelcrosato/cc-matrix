, rng);\\n        }\\n        if kind == EventId::Paddle {\\n            for i in 0..6 {\\n                a.gates.push([8.0 + i as f32 * 8.0, rng.range(-1.3, 1.3)]);\\n320→            }\\n        }\\n        if kind == EventId::Tray {\\n            // Scripted jolts the bot can see coming.\\n            // Same-direction shoves. An idle tray walks off; a lean the other way keeps the glasses.\\n            for i in 0..8 {\\n                let t = 4.0 + i as f32 * 5.5;\\n                a.jolts.push([t, 1.0]);\\n            }\\n        }\\n330→        a\\n    }\\n\\n    fn setup_board(&mut self, board: u8, rng: &mut Rng) {\\n        self.board = board;\\n        self.sub = 0.0;\\n        self.shells.clear();\\n        self.pools.clear();\\n        let n = [3, 5, 7][board as usize];\\n        self.pools.push([0.0, 1.6]);\",\"content_concise\":\"140→#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct GhostSample {\\n    pub t: f32,\\n    pub lean: [f32; 2],\\n    pub x: f32,\\n    pub z: f32,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Activity {\\n150→    pub kind: EventId,\\n    pub t: f32,\\n    pub dur: f32,\\n    pub score: f32,\\n    pub stars: u8,\\n    pub done: bool,\\n    pub acc: f32,\\n    pub phase: u8,\\n    pub sub: f32,\\n    pub lungs: f32,\\n160→    pub depth: f32,\\n    pub reps: u8,\\n    pub survived: f32,\\n    pub out_t: f32,\\n    pub flopped: bool,\\n    pub streak: f32,\\n    pub pose_i: u8,\\n    pub notes: Vec<[f32; 2]>,\\n    pub note_i: u16,\\n    pub hits: u16,\\n170→    pub spin: f32,\\n    pub prev_ang: f32,\\n    pub have_ang: bool,\\n    pub rings: u8,\\n    pub band_t: f32,\\n    pub dir: f32,\\n    pub catch_i: u8,\\n    pub steps: u16,\\n    pub last_side: i8,\\n    pub step_times: Vec<f32>,\\n180→    pub zone_t: f32,\\n    pub lateral: f32,\\n    pub ribbons: u8,\\n    pub bumps: u8,\\n    pub shells: Vec<Shell>,\\n    pub pools: Vec<[f32; 2]>,\\n    pub potted: u8,\\n    pub board: u8,\\n    pu