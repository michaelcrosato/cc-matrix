unt = 1},\"},{\"line_number\":62,\"content\":\"needs = [\\\"prop: an iron barred cell gate about 220 cm tall\\\", \\\"prop: a plain cot about 190 cm long\\\", \\\"prop: a wooden bucket about 30 cm tall\\\", \\\"prop: a wall torch that gives light\\\", \\\"material: damp stone brick\\\", \\\"clip: a slumped prisoner's looping idle\\\"]\"},{\"line_number\":73,\"content\":\"  {role = \\\"square ground\\\", kind = \\\"material\\\", count = 1},\"},{\"line_number\":76,\"content\":\"needs = [\\\"prop: a stone well about 110 cm tall\\\", \\\"prop: a wooden bucket about 30 cm tall\\\", \\\"prop: a hay bale about 100 cm wide\\\", \\\"material: cobblestones for the square\\\", \\\"clip: a villager's friendly wave\\\"]\"},{\"line_number\":100,\"content\":\"  {role = \\\"bridge deck\\\", kind = \\\"material\\\", count = 1},\"},{\"line_number\":103,\"content\":\"needs = [\\\"prop: a wooden barricade about 200 cm wide\\\", \\\"prop: an alarm bell hanging on a post about 180 cm tall\\\", \\\"material: wooden planks for the bridge deck\\\", \\\"clip: a single sword swing attack\\\"]\"},{\"line_number\":115,\"content\":\"  {role = \\\"rock face\\\", kind = \\\"material\\\", count = 1},\"},{\"line_number\":118,\"content\":\"needs = [\\\"prop: a timber mine support beam about 250 cm tall\\\", \\\"prop: a hanging mine lamp that gives light\\\", \\\"prop: a minecart about 120 cm long\\\", \\\"prop: a pickaxe about 90 cm long\\\", \\\"material: rough rock for the cave wall\\\", \\\"clip: a miner's looping pickaxe swing\\\"]\"},{\"line_number\":129,\"content\":\"  {role = \\\"floor\\\", kind = \\\"material\\\", count = 1},\"},{\"line_number\":132,\"content\":\"needs = [\\\"prop: a stone fireplace about 180 cm tall that gives light\\\", \\\"prop: an iron cooking pot about 40 cm tall\\\", \\\"prop: a straw broom about 130 cm long\\\", \\\"material: checkered tile floor\\\", \\\"clip: a cook's looping stirring motion\\\"]\"},{\"line_number\":143,\"content\":\"  {role = \\\"stall planks\\\", k