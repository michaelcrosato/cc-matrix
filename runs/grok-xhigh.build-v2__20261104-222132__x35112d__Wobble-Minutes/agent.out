\n    pub const CROUCH: u32 = 1 << 1;\\n10→    pub const INTERACT: u32 = 1 << 2;\\n    pub const USE: u32 = 1 << 3;\\n    pub const FOCUS: u32 = 1 << 4;\\n    pub const SPRINT: u32 = 1 << 5;\\n    pub const PRIMARY: u32 = 1 << 6;\\n    pub const SECONDARY: u32 = 1 << 7;\\n    pub const CRAWL: u32 = 1 << 8;\\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\\n    pub const SKILL3: u32 = 1 << 9;\\n    pub const SKILL4: u32 = 1 << 10;\\n20→    pub const SKILL5: u32 = 1 << 11;\\n    pub const SKILL6: u32 = 1 << 12;\\n    pub const DODGE: u32 = 1 << 13;\\n    pub const POTION: u32 = 1 << 14;\\n    /// Wobble Minutes: menu and balance actions (bits 15–28).\\n    pub const CONFIRM: u32 = 1 << 15;\\n    pub const BACK: u32 = 1 << 16;\\n    pub const MENU_UP: u32 = 1 << 17;\\n    pub const MENU_DOWN: u32 = 1 << 18;\\n    pub const MENU_LEFT: u32 = 1 << 19;\\n30→    pub const MENU_RIGHT: u32 = 1 << 20;\\n    pub const TAB_L: u32 = 1 << 21;\\n    pub const TAB_R: u32 = 1 << 22;\\n    pub const PAUSE: u32 = 1 << 23;\\n    pub const SCHEDULE: u32 = 1 << 24;\\n    pub const WAVE: u32 = 1 << 25;\\n    pub const STEP_L: u32 = 1 << 26;\\n    pub const STEP_R: u32 = 1 << 27;\\n    pub const HUB_GO: u32 = 1 << 28;\\n\\n40→    pub const NAMES: &[(&str, u32)] = &[\\n        (\\\"jump\\\", JUMP),\\n        (\\\"crouch\\\", CROUCH),\\n        (\\\"interact\\\", INTERACT),\\n        (\\\"use\\\", USE),\\n        (\\\"focus\\\", FOCUS),\\n        (\\\"sprint\\\", SPRINT),\\n        (\\\"primary\\\", PRIMARY),\\n        (\\\"secondary\\\", SECONDARY),\\n        (\\\"crawl\\\", CRAWL),\\n50→        (\\\"skill3\\\", SKILL3),\\n        (\\\"skill4\\\", SKILL4),\\n        (\\\"skill5\\\", SKILL5),\\n        (\\\"skill6\\\", SKILL6),\\n        (\\\"dodge\\\", DODGE),\\n        (\\\"potion\\\", POTION),\\n        (\\\"confirm\\\", CONFIRM),\\n        (\\\"back\\\", BACK),\\n        (\\\"menu_up\\\", MENU_UP),\\n        (\\\"menu_down\\\", MENU_DOWN),\\n60→        (\\\"menu_left\\\", MENU_LEFT),\\n        (\\\"menu_right\\\", MENU_RIGHT),\\n        (\\\"tab_l\\\", TAB_L),\\n        (\\\"tab_r\\\", TAB_R),\\n        (\\\"pause\\\", PAUSE),\\n        (\\\"schedule\\\", SCHEDULE),\\n        (\\\"wave\\\", WAVE),\\n        (\\\"step_l\\\", STEP_L),\\n        (\\\"step_r\\\", STEP_R),\\n        (\\\"hub_go\\\", HUB_GO),\\n70→    ];\\n\\n    pub fn from_name(n: &str) -> Option<u32> {\\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct InputFrame {\\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\\n80→    pub move_dir: Vec2,\",\"content_concise\":\"1→//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\\n//! it; the simulation never sees devices. Directions are already in world space.\\n\\nuse glam::{Vec2, Vec3};\\nuse serde::{Deserialize, Serialize};\\n\\npub mod buttons {\\n    pub const JUMP: u32 = 1 << 0;\\n    pub const CROUCH: u32 = 1 << 1;\\n10→    pub const INTERACT: u32 = 1 << 2;\\n    pub const USE: u32 = 1 << 3;\\n    pub const FOCUS: u32 = 1 << 4;\\n    pub const SPRINT: u32 = 1 << 5;\\n    pub const PRIMARY: u32 = 1 << 6;\\n    pub const SECONDARY: u32 = 1 << 7;\\n    pub const CRAWL: u32 = 1 << 8;\\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\\n    pub const SKILL3: u32 = 1 << 9;\\n    pub const SKILL4: u32 = 1 << 10;\\n20→    pub const SKILL5: u32 = 1 << 11;\\n    pub const SKILL6: u32 = 1 << 12;\\n    pub const DODGE: u32 = 1 << 13;\\n    pub const POTION: u32 = 1 << 14;\\n    /// Wobble Minutes: menu and balance actions (bits 15–28).\\n    pub const CONFIRM: u32 = 1 << 15;\\n    pub const BACK: u32 = 1 << 16;\\n    pub const MENU_UP: u32 = 1 << 17;\\n    pub const MENU_DOWN: u32 = 1 << 18;\\n    pub const MENU_LEFT: u32 = 1 << 19;\\n30→    pub const MENU_RIGHT: u32 = 1 << 20;\\n    pub const TAB_L: u32 = 1 << 21;\\n    pub const TAB_R: u32 = 1 << 22;\\n    pub const PAUSE: u32 = 1 << 23;\\n    pub const SCHEDULE: u32 = 1 << 24;\\n    pub const WAVE: u32 = 1 << 25;\\n    pub const STEP_L: u32 = 1 << 26;\\n    pub const STEP_R: u32 = 1 << 27;\\n    pub const HUB_GO: u32 = 1 << 28;\\n\\n40→    pub const NAMES: &[(&str, u32)] = &[\\n        (\\\"jump\\\", JUMP),\\n        (\\\"crouch\\\", CROUCH),\\n        (\\\"interact\\\", INTERACT),\\n        (\\\"use\\\", USE),\\n        (\\\"focus\\\", FOCUS),\\n        (\\\"sprint\\\", SPRINT),\\n        (\\\"primary\\\", PRIMARY),\\n        (\\\"secondary\\\", SECONDARY),\\n        (\\\"crawl\\\", CRAWL),\\n50→        (\\\"skill3\\\", SKILL3),\\n        (\\\"skill4\\\", SKILL4),\\n        (\\\"skill5\\\", SKILL5),\\n        (\\\"skill6\\\", SKILL6),\\n        (\\\"dodge\\\", DODGE),\\n        (\\\"potion\\\", POTION),\\n        (\\\"confirm\\\", CONFIRM),\\n        (\\\"back\\\", BACK),\\n        (\\\"menu_up\\\", MENU_UP),\\n        (\\\"menu_down\\\", MENU_DOWN),\\n60→        (\\\"menu_left\\\", MENU_LEFT),\\n        (\\\"menu_right\\\", MENU_RIGHT),\\n        (\\\"tab_l\\\", TAB_L),\\n        (\\\"tab_r\\\", TAB_R),\\n        (\\\"pause\\\", PAUSE),\\n        (\\\"schedule\\\", SCHEDULE),\\n        (\\\"wave\\\", WAVE),\\n        (\\\"step_l\\\", STEP_L),\\n        (\\\"step_r\\\", STEP_R),\\n        (\\\"hub_go\\\", HUB_GO),\\n70→    ];\\n\\n    pub fn from_name(n: &str) -> Option<u32> {\\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct InputFrame {\\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\\n80→    pub move_dir: Vec2,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core