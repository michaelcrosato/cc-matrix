{"type":"assistant","message":{"id":"msg_1010","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Reviewing the code to verify prior fixes and identify real bugs.I need to check the action handlers for sliders, time scale, cheats, jump, age calculation, big stand phase 5, eyes-closed tone, and island mats.","signature":""},{"type":"tool_use","id":"call-6d2d3f26-80cd-4b85-a740-e71cbb3caed9-9","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/tests/fit.rs","offset":150,"limit":450}},{"type":"tool_use","id":"call-6d2d3f26-80cd-4b85-a740-e71cbb3caed9-10","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_app/src/input.rs","offset":470,"limit":120}},{"type":"tool_use","id":"call-6d2d3f26-80cd-4b85-a740-e71cbb3caed9-11","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_app/src/input.rs","offset":760,"limit":120}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3595,"output_tokens":487,"cache_read_input_tokens":33536,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"a969295b-1afb-4855-b675-f8a8538d215d"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-6d2d3f26-80cd-4b85-a740-e71cbb3caed9-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"150→    sim.step(&InputFrame { pressed: buttons::CONFIRM, device: 2, ..Default::default() });\\n    let off = status(&sim);\\n    assert_eq!(off[\\\"phase\\\"], \\\"title\\\");\\n    assert_eq!(off[\\\"demo\\\"], false);\\n    assert_eq!(off[\\\"save_serial\\\"], serial);\\n}\\n\\n#[test]\\nfn pause_freezes_world_time_and_the_body() {\\n    let mut sim = boot(\\\"fit/event/breath\\\", 6);\\n160→    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..40 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n    let before = status(&sim);\\n    let wt = before[\\\"world_time\\\"].as_f64().unwrap();\\n    assert!(wt > 0.0, \\\"world time never started\\\");\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let feet = sim.feet(id).expect(\\\"feet\\\");\\n170→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    for _ in 0..120 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let frozen = status(&sim);\\n    assert!((frozen[\\\"world_time\\\"].as_f64().unwrap() - wt).abs() < 1e-5);\\n    let feet2 = sim.feet(id).expect(\\\"feet\\\");\\n    assert!((feet2 - feet).length() < 1e-3, \\\"body moved while paused\\\");\\n    sim.step(&press(buttons::PAUSE));\\n180→    assert_eq!(phase(&sim), \\\"event\\\");\\n    let input = sim.bot_input();\\n    sim.step(&input);\\n    assert!(status(&sim)[\\\"world_time\\\"].as_f64().unwrap() > wt);\\n}\\n\\n#[test]\\nfn music_defaults_quiet_and_a_dev_slider_resets() {\\n    let mut sim = boot(\\\"fit\\\", 8);\\n    let s = status(&sim);\\n190→    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.10).abs() < 1e-6, \\\"music {}\\\", s[\\\"music\\\"]);\\n    let stiff = s[\\\"stiffness\\\"].as_f64().unwrap();\\n    pick(&mut sim, \\\"Settings\\\");\\n    assert_eq!(phase(&sim), \\\"settings\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let music = status(&sim)[\\\"music\\\"].as_f64().unwrap();\\n    assert!((music - 0.20).abs() < 0.02, \\\"pad right left music at {music}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    assert_eq!(phase(&sim), \\\"title\\\");\\n    sim.step(&press(buttons::PAUSE));\\n200→    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Tuning\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let moved = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((moved - stiff).abs() > 1.0, \\\"pad right left stiffness at {moved}\\\");\\n    pick(&mut sim, \\\"Reset feel\\\");\\n    let back = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((back - stiff).abs() < 1e-3, \\\"reset left {back}, was {stiff}\\\");\\n}\\n\\n210→#[test]\\nfn medley_is_the_same_course_twice() {\\n    let a = medley_scores(9);\\n    let b = medley_scores(9);\\n    for (i, (x, y)) in a.iter().zip(b.iter()).enumerate() {\\n        assert!((x - y).abs() < 1e-3, \\\"stat {i} {x} vs {y}\\\");\\n    }\\n    assert!(a.iter().sum::<f64>() <= 3000.0);\\n}\\n\\n220→fn medley_scores(seed: u64) -> Vec<f64> {\\n    let mut sim = boot(\\\"fit/medley\\\", seed);\\n    assert!(bot_until(&mut sim, |s| status(s)[\\\"hub\\\"][\\\"done\\\"].as_bool() == Some(true), 30_000));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"hub\\\"][\\\"label\\\"], \\\"Inter-Resort Medley\\\");\\n    let stats = &s[\\\"hub\\\"][\\\"stats\\\"];\\n    vec![\\n        stats[\\\"paddle\\\"].as_f64().unwrap(),\\n        stats[\\\"tide\\\"].as_f64().unwrap(),\\n        stats[\\\"cannon\\\"].as_f64().unwrap(),\\n230→    ]\\n}\\n\\n#[test]\\nfn play_together_reaches_a_podium() {\\n    let mut sim = boot(\\\"fit\\\", 12);\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"together\\\");\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"podium\\\", 40_000), \\\"phase {}\\\", phase(&sim));\\n240→    let s = status(&sim);\\n    let podium = s[\\\"podium\\\"].as_array().cloned().unwrap_or_default();\\n    assert_eq!(podium.len(), 2, \\\"{podium:?}\\\");\\n    assert_eq!(s[\\\"outcome\\\"], \\\"playing\\\");\\n}\\n\\n#[test]\\nfn shipped_text_stays_in_bounds() {\\n    let files: [(&str, &str); 5] = [\\n        (\\\"script\\\", include_str!(\\\"../src/games/fit/script.toml\\\")),\\n250→        (\\\"rules\\\", include_str!(\\\"../src/games/fit/rules.toml\\\")),\\n        (\\\"charts\\\", include_str!(\\\"../src/games/fit/charts.toml\\\")),\\n        (\\\"hub\\\", include_str!(\\\"../src/games/fit/hub.toml\\\")),\\n        (\\\"events\\\", include_str!(\\\"../src/games/fit/events.rs\\\")),\\n    ];\\n    let banned = [\\\"todo\\\", \\\"placeholder\\\", \\\"bmi\\\", \\\"diet\\\", \\\"weight\\\", \\\"wii\\\", \\\"nintendo\\\"];\\n    for (name, text) in files {\\n        for (n, line) in text.lines().enumerate() {\\n            if line.contains(\\\"Source:\\\") {\\n                continue;\\n260→            }\\n            let low = line.to_ascii_lowercase();\\n            for word in banned {\\n                assert!(!low.contains(word), \\\"{name}:{} contains {word}\\\", n + 1);\\n            }\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Wobble Minutes\\\");\\n}\\n\\n270→#[test]\\nfn save_round_trip_matches_the_slot() {\\n    let mut sim = boot(\\\"fit\\\", 15);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 3;\\n        g.age = 22;\\n        g.stamps = 2;\\n        g.name = \\\"Kai\\\".into();\\n        g.settings.music = 0.25;\\n280→        g.today = 20;\\n        let blob = g.export_save();\\n        g.day = 1;\\n        g.age = 80;\\n        g.name = \\\"Guest\\\".into();\\n        g.settings.music = 0.10;\\n        assert!(g.import_save(&blob));\\n        assert!(!g.import_save(\\\"{\\\"));\\n        assert!(!g.import_save(\\\"{\\\\\\\"version\\\\\\\":9,\\\\\\\"slots\\\\\\\":[],\\\\\\\"settings\\\\\\\":{},\\\\\\\"last_day\\\\\\\":0}\\\"));\\n    }\\n290→    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 3);\\n    assert_eq!(s[\\\"age\\\"], 22);\\n    assert_eq!(s[\\\"name\\\"], \\\"Kai\\\");\\n    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.25).abs() < 1e-6);\\n    assert_eq!(s[\\\"version\\\"], 1);\\n}\\n\\n#[test]\\nfn hub_ghost_is_a_sample_and_about_pages_turn() {\\n300→    let medley = boot(\\\"fit/medley\\\", 3);\\n    let ghost = &status(&medley)[\\\"hub\\\"][\\\"ghost\\\"];\\n    assert!(ghost.is_object(), \\\"{ghost}\\\");\\n    assert_eq!(ghost[\\\"area\\\"], 9, \\\"paddle is event index 9\\\");\\n    assert!(ghost[\\\"position\\\"].is_array());\\n    assert!(ghost[\\\"lean\\\"].is_array());\\n    let title = boot(\\\"fit\\\", 3);\\n    assert_eq!(status(&title)[\\\"hub\\\"][\\\"ghost\\\"][\\\"area\\\"], -1);\\n\\n    let mut sim = boot(\\\"fit\\\", 4);\\n310→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.about_blob = r#\\\"{\\\"sourceInformation\\\":{\\\"usage\\\":\\\"added on import\\\",\\\"source\\\":\\\"Wii Fit\\\"},\\\"testingFeedback\\\":[\\\"the bot caught a gust\\\"],\\\"engineFeedback\\\":[\\\"pause returns inside the tick\\\"],\\\"promptFeedback\\\":[\\\"the full roster ships\\\"]}\\\"#.into();\\n    }\\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(5)), device: 2, pressed: 0, ..Default::default() });\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"Source:\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"added on import\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"Testing Feedback\\\"), \\\"{blob}\\\");\\n320→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::TAB_R));\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"the bot caught a gust\\\"), \\\"{blob}\\\");\\n}\\n\\n#[test]\\nfn name_and_outfit_pages_reach_gray_and_golden() {\\n    let mut sim = boot(\\\"fit\\\", 16);\\n330→    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"slots\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"name\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(phase(&sim), \\\"look\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"outfit\\\");\\n340→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"outfit\\\"], 7, \\\"Golden is the eighth outfit\\\");\\n    assert_eq!(phase(&sim), \\\"intro\\\");\\n}\\n\\n#[test]\\nfn schedule_pages_to_cannonball_after_unlock() {\\n    let mut sim = boot(\\\"fit\\\", 18);\\n350→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    sim.step(&press(buttons::SCHEDULE));\\n    assert_eq!(phase(&sim), \\\"schedule\\\");\\n360→    pick(&mut sim, \\\"Cannonball\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"cannon\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn eyes_closed_hides_the_puck_and_the_tone_moves() {\\n    let mut sim = boot(\\\"fit/event/check\\\", 3);\\n    assert!(\\n370→        bot_until(&mut sim, |s| phase(s) == \\\"check\\\" && status(s)[\\\"act_phase\\\"].as_u64() == Some(2), 4000),\\n        \\\"phase {} act {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"act_phase\\\"]\\n    );\\n    let ui = ui_of(&sim);\\n    assert!(ui.puck.is_none(), \\\"puck stayed up\\\");\\n    assert!(ui.dim > 0.5, \\\"dim {}\\\", ui.dim);\\n    let blob = ui.lines.join(\\\" \\\").to_ascii_lowercase();\\n    assert!(blob.contains(\\\"eyes\\\"), \\\"{blob}\\\");\\n380→    let tone = status(&sim)[\\\"tone\\\"].as_f64().unwrap();\\n    for _ in 0..30 {\\n        sim.step(&InputFrame { lean: Vec2::new(1.0, 0.0), ..Default::default() });\\n    }\\n    let later = status(&sim);\\n    assert_eq!(later[\\\"act_phase\\\"], 2, \\\"left the eyes-closed phase\\\");\\n    let moved = later[\\\"tone\\\"].as_f64().unwrap();\\n    assert!((moved - tone).abs() > 0.05, \\\"tone {tone} -> {moved}\\\");\\n}\\n\\n390→#[test]\\nfn long_stillness_goes_quiet_and_offers_a_fake_skip() {\\n    let mut sim = boot(\\\"fit\\\", 5);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Time\\\");\\n    pick(&mut sim, \\\"4x\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    let opened = status(&sim);\\n400→    assert_eq!(opened[\\\"phase\\\"], \\\"event\\\");\\n    assert_eq!(opened[\\\"event\\\"], \\\"bigstand\\\");\\n    assert_eq!(opened[\\\"song\\\"], 3, \\\"finale bed\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Long stillness\\\");\\n    let still = status(&sim);\\n    assert_eq!(still[\\\"song\\\"], 0, \\\"stillness should be silent\\\");\\n    assert_eq!(still[\\\"act_phase\\\"], 4);\\n    let mut guard = 0;\\n410→    while status(&sim)[\\\"act_sub\\\"].as_f64().unwrap_or(0.0) < 15.0 && guard < 400 {\\n        sim.step(&InputFrame::default());\\n        guard += 1;\\n    }\\n    let s = status(&sim);\\n    assert!(s[\\\"act_sub\\\"].as_f64().unwrap() >= 15.0, \\\"sub {} after {guard}\\\", s[\\\"act_sub\\\"]);\\n    let ui = ui_of(&sim);\\n    let line = ui.lines.join(\\\" \\\");\\n    assert!(line.contains(\\\"Press\\\") && line.contains(\\\"skip\\\"), \\\"{line}\\\");\\n    assert!(ui.footer.contains(\\\"Press\\\") && ui.footer.contains(\\\"skip\\\"), \\\"{}\\\", ui.footer);\\n420→    assert!(ui.big.is_empty(), \\\"score banner {}\\\", ui.big);\\n    assert!(ui.title.is_empty(), \\\"title fell back to {}\\\", ui.title);\\n    assert!(ui.puck.is_some(), \\\"puck should stay\\\");\\n}\\n\\n#[test]\\nfn a_good_finale_can_rowboat_from_a_middle_age() {\\n    let mut sim = boot(\\\"fit\\\", 1);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n430→        g.age = 45;\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"bigstand\\\");\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"ending\\\", 20_000),\\n        \\\"phase {} score {}\\\",\\n        phase(&sim),\\n440→        status(&sim)[\\\"score\\\"]\\n    );\\n    let s = status(&sim);\\n    let score = s[\\\"score\\\"].as_f64().unwrap();\\n    let cut = (score / 100.0).floor().min(10.0) as u8;\\n    let expect = 45u8.saturating_sub(cut).max(18);\\n    assert_eq!(s[\\\"age\\\"], expect, \\\"score {score}\\\");\\n    if score >= 500.0 {\\n        assert_eq!(s[\\\"ending\\\"], \\\"rowboat\\\", \\\"score {score} age {}\\\", s[\\\"age\\\"]);\\n    }\\n450→}\\n\\n#[test]\\nfn pose_parade_plays_the_tree_clip() {\\n    let mut sim = boot(\\\"fit/event/pose\\\", 2);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..20 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n460→    let tree = pav_core::clips::find(\\\"FIT/Tree\\\").expect(\\\"FIT/Tree\\\");\\n    let clip = status(&sim)[\\\"clip\\\"].as_u64().unwrap();\\n    assert_ne!(clip, 0);\\n    assert_eq!(clip, tree as u64);\\n}\\n\\n#[test]\\nfn wardrobe_calendar_and_beach_props() {\\n    let mut sim = boot(\\\"fit\\\", 20);\\n    let props = sim.state.entities.iter().filter(|e| e.prop.is_some()).count();\\n470→    assert!(props > 0, \\\"no beach props\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap_or_default();\\n    assert!(mats.len() >= 11, \\\"{mats:?}\\\");\\n    assert!(mats.iter().any(|m| m[\\\"event\\\"] == \\\"cannon\\\"), \\\"{mats:?}\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Wardrobe\\\");\\n    pick(&mut sim, \\\"Sun cap\\\");\\n    assert_eq!(sim.config.puppet.gear.helm, HelmKind::Cap);\\n    pick(&mut sim, \\\"Calendar\\\");\\n    let ui = ui_of(&sim);\\n480→    assert!(ui.items.iter().any(|it| it.label.contains(\\\"Day\\\")), \\\"{:?}\\\", ui.items);\\n}\\n\\n#[test]\\nfn a_mat_on_the_sand_starts_its_event() {\\n    let mut sim = boot(\\\"fit\\\", 22);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n490→    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap();\\n    let mat = mats.iter().find(|m| m[\\\"event\\\"] == \\\"floatie\\\").expect(\\\"floatie mat\\\");\\n    let x = mat[\\\"x\\\"].as_f64().unwrap() as f32;\\n    let z = mat[\\\"z\\\"].as_f64().unwrap() as f32;\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let mut arrived = false;\\n    for _ in 0..700 {\\n500→        let feet = sim.feet(id).expect(\\\"feet\\\");\\n        let dx = x - feet.x;\\n        let dz = z - feet.z;\\n        if dx.hypot(dz) < 0.8 {\\n            arrived = true;\\n            break;\\n        }\\n        let d = dx.hypot(dz).max(0.001);\\n        sim.step(&InputFrame { move_dir: Vec2::new(dx / d, dz / d), ..Default::default() });\\n    }\\n510→    assert!(arrived, \\\"never reached the floatie mat\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"floatie\\\", \\\"{s}\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn view_and_save_tabs_change_the_stay() {\\n    let mut sim = boot(\\\"fit\\\", 3);\\n520→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 4;\\n        g.stamps = 3;\\n        g.day_minutes = 9;\\n        g.name = \\\"Gray\\\".into();\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"View\\\");\\n    pick(&mut sim, \\\"Input\\\");\\n530→    pick(&mut sim, \\\"Dot\\\");\\n    pick(&mut sim, \\\"Engine\\\");\\n    pick(&mut sim, \\\"Free\\\");\\n    pick(&mut sim, \\\"Ghost\\\");\\n    let view = status(&sim)[\\\"view\\\"].clone();\\n    assert_eq!(view[\\\"input\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"stats\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"free\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"lanes\\\"], true, \\\"{view}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n540→    pick(&mut sim, \\\"Save\\\");\\n    pick(&mut sim, \\\"Reset Gray\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 1, \\\"{s}\\\");\\n    assert_eq!(s[\\\"stamps\\\"], 0);\\n    assert_eq!(s[\\\"minutes\\\"], 0);\\n    assert_eq!(s[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(s[\\\"view\\\"][\\\"lanes\\\"], true, \\\"reset cleared the viewer\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n550→    pick(&mut sim, \\\"Pose Parade\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"pose\\\");\\n    for _ in 0..8 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let ui = ui_of(&sim);\\n    assert!(!ui.trace.is_empty(), \\\"dot trace stayed empty\\\");\\n    assert!(ui.overlay.contains(\\\"Lean\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.overlay.contains(\\\"Tick\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.camera_yaw.is_some());\\n560→    assert!(status(&sim)[\\\"view\\\"][\\\"trace\\\"].as_u64().unwrap_or(0) > 0);\\n}\\n\",\"content_concise\":\"150→    sim.step(&InputFrame { pressed: buttons::CONFIRM, device: 2, ..Default::default() });\\n    let off = status(&sim);\\n    assert_eq!(off[\\\"phase\\\"], \\\"title\\\");\\n    assert_eq!(off[\\\"demo\\\"], false);\\n    assert_eq!(off[\\\"save_serial\\\"], serial);\\n}\\n\\n#[test]\\nfn pause_freezes_world_time_and_the_body() {\\n    let mut sim = boot(\\\"fit/event/breath\\\", 6);\\n160→    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..40 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n    let before = status(&sim);\\n    let wt = before[\\\"world_time\\\"].as_f64().unwrap();\\n    assert!(wt > 0.0, \\\"world time never started\\\");\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let feet = sim.feet(id).expect(\\\"feet\\\");\\n170→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    for _ in 0..120 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let frozen = status(&sim);\\n    assert!((frozen[\\\"world_time\\\"].as_f64().unwrap() - wt).abs() < 1e-5);\\n    let feet2 = sim.feet(id).expect(\\\"feet\\\");\\n    assert!((feet2 - feet).length() < 1e-3, \\\"body moved while paused\\\");\\n    sim.step(&press(buttons::PAUSE));\\n180→    assert_eq!(phase(&sim), \\\"event\\\");\\n    let input = sim.bot_input();\\n    sim.step(&input);\\n    assert!(status(&sim)[\\\"world_time\\\"].as_f64().unwrap() > wt);\\n}\\n\\n#[test]\\nfn music_defaults_quiet_and_a_dev_slider_resets() {\\n    let mut sim = boot(\\\"fit\\\", 8);\\n    let s = status(&sim);\\n190→    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.10).abs() < 1e-6, \\\"music {}\\\", s[\\\"music\\\"]);\\n    let stiff = s[\\\"stiffness\\\"].as_f64().unwrap();\\n    pick(&mut sim, \\\"Settings\\\");\\n    assert_eq!(phase(&sim), \\\"settings\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let music = status(&sim)[\\\"music\\\"].as_f64().unwrap();\\n    assert!((music - 0.20).abs() < 0.02, \\\"pad right left music at {music}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    assert_eq!(phase(&sim), \\\"title\\\");\\n    sim.step(&press(buttons::PAUSE));\\n200→    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Tuning\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let moved = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((moved - stiff).abs() > 1.0, \\\"pad right left stiffness at {moved}\\\");\\n    pick(&mut sim, \\\"Reset feel\\\");\\n    let back = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((back - stiff).abs() < 1e-3, \\\"reset left {back}, was {stiff}\\\");\\n}\\n\\n210→#[test]\\nfn medley_is_the_same_course_twice() {\\n    let a = medley_scores(9);\\n    let b = medley_scores(9);\\n    for (i, (x, y)) in a.iter().zip(b.iter()).enumerate() {\\n        assert!((x - y).abs() < 1e-3, \\\"stat {i} {x} vs {y}\\\");\\n    }\\n    assert!(a.iter().sum::<f64>() <= 3000.0);\\n}\\n\\n220→fn medley_scores(seed: u64) -> Vec<f64> {\\n    let mut sim = boot(\\\"fit/medley\\\", seed);\\n    assert!(bot_until(&mut sim, |s| status(s)[\\\"hub\\\"][\\\"done\\\"].as_bool() == Some(true), 30_000));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"hub\\\"][\\\"label\\\"], \\\"Inter-Resort Medley\\\");\\n    let stats = &s[\\\"hub\\\"][\\\"stats\\\"];\\n    vec![\\n        stats[\\\"paddle\\\"].as_f64().unwrap(),\\n        stats[\\\"tide\\\"].as_f64().unwrap(),\\n        stats[\\\"cannon\\\"].as_f64().unwrap(),\\n230→    ]\\n}\\n\\n#[test]\\nfn play_together_reaches_a_podium() {\\n    let mut sim = boot(\\\"fit\\\", 12);\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"together\\\");\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"podium\\\", 40_000), \\\"phase {}\\\", phase(&sim));\\n240→    let s = status(&sim);\\n    let podium = s[\\\"podium\\\"].as_array().cloned().unwrap_or_default();\\n    assert_eq!(podium.len(), 2, \\\"{podium:?}\\\");\\n    assert_eq!(s[\\\"outcome\\\"], \\\"playing\\\");\\n}\\n\\n#[test]\\nfn shipped_text_stays_in_bounds() {\\n    let files: [(&str, &str); 5] = [\\n        (\\\"script\\\", include_str!(\\\"../src/games/fit/script.toml\\\")),\\n250→        (\\\"rules\\\", include_str!(\\\"../src/games/fit/rules.toml\\\")),\\n        (\\\"charts\\\", include_str!(\\\"../src/games/fit/charts.toml\\\")),\\n        (\\\"hub\\\", include_str!(\\\"../src/games/fit/hub.toml\\\")),\\n        (\\\"events\\\", include_str!(\\\"../src/games/fit/events.rs\\\")),\\n    ];\\n    let banned = [\\\"todo\\\", \\\"placeholder\\\", \\\"bmi\\\", \\\"diet\\\", \\\"weight\\\", \\\"wii\\\", \\\"nintendo\\\"];\\n    for (name, text) in files {\\n        for (n, line) in text.lines().enumerate() {\\n            if line.contains(\\\"Source:\\\") {\\n                continue;\\n260→            }\\n            let low = line.to_ascii_lowercase();\\n            for word in banned {\\n                assert!(!low.contains(word), \\\"{name}:{} contains {word}\\\", n + 1);\\n            }\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Wobble Minutes\\\");\\n}\\n\\n270→#[test]\\nfn save_round_trip_matches_the_slot() {\\n    let mut sim = boot(\\\"fit\\\", 15);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 3;\\n        g.age = 22;\\n        g.stamps = 2;\\n        g.name = \\\"Kai\\\".into();\\n        g.settings.music = 0.25;\\n280→        g.today = 20;\\n        let blob = g.export_save();\\n        g.day = 1;\\n        g.age = 80;\\n        g.name = \\\"Guest\\\".into();\\n        g.settings.music = 0.10;\\n        assert!(g.import_save(&blob));\\n        assert!(!g.import_save(\\\"{\\\"));\\n        assert!(!g.import_save(\\\"{\\\\\\\"version\\\\\\\":9,\\\\\\\"slots\\\\\\\":[],\\\\\\\"settings\\\\\\\":{},\\\\\\\"last_day\\\\\\\":0}\\\"));\\n    }\\n290→    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 3);\\n    assert_eq!(s[\\\"age\\\"], 22);\\n    assert_eq!(s[\\\"name\\\"], \\\"Kai\\\");\\n    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.25).abs() < 1e-6);\\n    assert_eq!(s[\\\"version\\\"], 1);\\n}\\n\\n#[test]\\nfn hub_ghost_is_a_sample_and_about_pages_turn() {\\n300→    let medley = boot(\\\"fit/medley\\\", 3);\\n    let ghost = &status(&medley)[\\\"hub\\\"][\\\"ghost\\\"];\\n    assert!(ghost.is_object(), \\\"{ghost}\\\");\\n    assert_eq!(ghost[\\\"area\\\"], 9, \\\"paddle is event index 9\\\");\\n    assert!(ghost[\\\"position\\\"].is_array());\\n    assert!(ghost[\\\"lean\\\"].is_array());\\n    let title = boot(\\\"fit\\\", 3);\\n    assert_eq!(status(&title)[\\\"hub\\\"][\\\"ghost\\\"][\\\"area\\\"], -1);\\n\\n    let mut sim = boot(\\\"fit\\\", 4);\\n310→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.about_blob = r#\\\"{\\\"sourceInformation\\\":{\\\"usage\\\":\\\"added on import\\\",\\\"source\\\":\\\"Wii Fit\\\"},\\\"testingFeedback\\\":[\\\"the bot caught a gust\\\"],\\\"engineFeedback\\\":[\\\"pause returns inside the tick\\\"],\\\"promptFeedback\\\":[\\\"the full roster ships\\\"]}\\\"#.into();\\n    }\\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(5)), device: 2, pressed: 0, ..Default::default() });\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"Source:\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"added on import\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"Testing Feedback\\\"), \\\"{blob}\\\");\\n320→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::TAB_R));\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"the bot caught a gust\\\"), \\\"{blob}\\\");\\n}\\n\\n#[test]\\nfn name_and_outfit_pages_reach_gray_and_golden() {\\n    let mut sim = boot(\\\"fit\\\", 16);\\n330→    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"slots\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"name\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(phase(&sim), \\\"look\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"outfit\\\");\\n340→    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"outfit\\\"], 7, \\\"Golden is the eighth outfit\\\");\\n    assert_eq!(phase(&sim), \\\"intro\\\");\\n}\\n\\n#[test]\\nfn schedule_pages_to_cannonball_after_unlock() {\\n    let mut sim = boot(\\\"fit\\\", 18);\\n350→    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    sim.step(&press(buttons::SCHEDULE));\\n    assert_eq!(phase(&sim), \\\"schedule\\\");\\n360→    pick(&mut sim, \\\"Cannonball\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"cannon\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn eyes_closed_hides_the_puck_and_the_tone_moves() {\\n    let mut sim = boot(\\\"fit/event/check\\\", 3);\\n    assert!(\\n370→        bot_until(&mut sim, |s| phase(s) == \\\"check\\\" && status(s)[\\\"act_phase\\\"].as_u64() == Some(2), 4000),\\n        \\\"phase {} act {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"act_phase\\\"]\\n    );\\n    let ui = ui_of(&sim);\\n    assert!(ui.puck.is_none(), \\\"puck stayed up\\\");\\n    assert!(ui.dim > 0.5, \\\"dim {}\\\", ui.dim);\\n    let blob = ui.lines.join(\\\" \\\").to_ascii_lowercase();\\n    assert!(blob.contains(\\\"eyes\\\"), \\\"{blob}\\\");\\n380→    let tone = status(&sim)[\\\"tone\\\"].as_f64().unwrap();\\n    for _ in 0..30 {\\n        sim.step(&InputFrame { lean: Vec2::new(1.0, 0.0), ..Default::default() });\\n    }\\n    let later = status(&sim);\\n    assert_eq!(later[\\\"act_phase\\\"], 2, \\\"left the eyes-closed phase\\\");\\n    let moved = later[\\\"tone\\\"].as_f64().unwrap();\\n    assert!((moved - tone).abs() > 0.05, \\\"tone {tone} -> {moved}\\\");\\n}\\n\\n390→#[test]\\nfn long_stillness_goes_quiet_and_offers_a_fake_skip() {\\n    let mut sim = boot(\\\"fit\\\", 5);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Time\\\");\\n    pick(&mut sim, \\\"4x\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    let opened = status(&sim);\\n400→    assert_eq!(opened[\\\"phase\\\"], \\\"event\\\");\\n    assert_eq!(opened[\\\"event\\\"], \\\"bigstand\\\");\\n    assert_eq!(opened[\\\"song\\\"], 3, \\\"finale bed\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Long stillness\\\");\\n    let still = status(&sim);\\n    assert_eq!(still[\\\"song\\\"], 0, \\\"stillness should be silent\\\");\\n    assert_eq!(still[\\\"act_phase\\\"], 4);\\n    let mut guard = 0;\\n410→    while status(&sim)[\\\"act_sub\\\"].as_f64().unwrap_or(0.0) < 15.0 && guard < 400 {\\n        sim.step(&InputFrame::default());\\n        guard += 1;\\n    }\\n    let s = status(&sim);\\n    assert!(s[\\\"act_sub\\\"].as_f64().unwrap() >= 15.0, \\\"sub {} after {guard}\\\", s[\\\"act_sub\\\"]);\\n    let ui = ui_of(&sim);\\n    let line = ui.lines.join(\\\" \\\");\\n    assert!(line.contains(\\\"Press\\\") && line.contains(\\\"skip\\\"), \\\"{line}\\\");\\n    assert!(ui.footer.contains(\\\"Press\\\") && ui.footer.contains(\\\"skip\\\"), \\\"{}\\\", ui.footer);\\n420→    assert!(ui.big.is_empty(), \\\"score banner {}\\\", ui.big);\\n    assert!(ui.title.is_empty(), \\\"title fell back to {}\\\", ui.title);\\n    assert!(ui.puck.is_some(), \\\"puck should stay\\\");\\n}\\n\\n#[test]\\nfn a_good_finale_can_rowboat_from_a_middle_age() {\\n    let mut sim = boot(\\\"fit\\\", 1);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n430→        g.age = 45;\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"bigstand\\\");\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"ending\\\", 20_000),\\n        \\\"phase {} score {}\\\",\\n        phase(&sim),\\n440→        status(&sim)[\\\"score\\\"]\\n    );\\n    let s = status(&sim);\\n    let score = s[\\\"score\\\"].as_f64().unwrap();\\n    let cut = (score / 100.0).floor().min(10.0) as u8;\\n    let expect = 45u8.saturating_sub(cut).max(18);\\n    assert_eq!(s[\\\"age\\\"], expect, \\\"score {score}\\\");\\n    if score >= 500.0 {\\n        assert_eq!(s[\\\"ending\\\"], \\\"rowboat\\\", \\\"score {score} age {}\\\", s[\\\"age\\\"]);\\n    }\\n450→}\\n\\n#[test]\\nfn pose_parade_plays_the_tree_clip() {\\n    let mut sim = boot(\\\"fit/event/pose\\\", 2);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..20 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n460→    let tree = pav_core::clips::find(\\\"FIT/Tree\\\").expect(\\\"FIT/Tree\\\");\\n    let clip = status(&sim)[\\\"clip\\\"].as_u64().unwrap();\\n    assert_ne!(clip, 0);\\n    assert_eq!(clip, tree as u64);\\n}\\n\\n#[test]\\nfn wardrobe_calendar_and_beach_props() {\\n    let mut sim = boot(\\\"fit\\\", 20);\\n    let props = sim.state.entities.iter().filter(|e| e.prop.is_some()).count();\\n470→    assert!(props > 0, \\\"no beach props\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap_or_default();\\n    assert!(mats.len() >= 11, \\\"{mats:?}\\\");\\n    assert!(mats.iter().any(|m| m[\\\"event\\\"] == \\\"cannon\\\"), \\\"{mats:?}\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Wardrobe\\\");\\n    pick(&mut sim, \\\"Sun cap\\\");\\n    assert_eq!(sim.config.puppet.gear.helm, HelmKind::Cap);\\n    pick(&mut sim, \\\"Calendar\\\");\\n    let ui = ui_of(&sim);\\n480→    assert!(ui.items.iter().any(|it| it.label.contains(\\\"Day\\\")), \\\"{:?}\\\", ui.items);\\n}\\n\\n#[test]\\nfn a_mat_on_the_sand_starts_its_event() {\\n    let mut sim = boot(\\\"fit\\\", 22);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n490→    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap();\\n    let mat = mats.iter().find(|m| m[\\\"event\\\"] == \\\"floatie\\\").expect(\\\"floatie mat\\\");\\n    let x = mat[\\\"x\\\"].as_f64().unwrap() as f32;\\n    let z = mat[\\\"z\\\"].as_f64().unwrap() as f32;\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let mut arrived = false;\\n    for _ in 0..700 {\\n500→        let feet = sim.feet(id).expect(\\\"feet\\\");\\n        let dx = x - feet.x;\\n        let dz = z - feet.z;\\n        if dx.hypot(dz) < 0.8 {\\n            arrived = true;\\n            break;\\n        }\\n        let d = dx.hypot(dz).max(0.001);\\n        sim.step(&InputFrame { move_dir: Vec2::new(dx / d, dz / d), ..Default::default() });\\n    }\\n510→    assert!(arrived, \\\"never reached the floatie mat\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"floatie\\\", \\\"{s}\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn view_and_save_tabs_change_the_stay() {\\n    let mut sim = boot(\\\"fit\\\", 3);\\n520→    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 4;\\n        g.stamps = 3;\\n        g.day_minutes = 9;\\n        g.name = \\\"Gray\\\".into();\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"View\\\");\\n    pick(&mut sim, \\\"Input\\\");\\n530→    pick(&mut sim, \\\"Dot\\\");\\n    pick(&mut sim, \\\"Engine\\\");\\n    pick(&mut sim, \\\"Free\\\");\\n    pick(&mut sim, \\\"Ghost\\\");\\n    let view = status(&sim)[\\\"view\\\"].clone();\\n    assert_eq!(view[\\\"input\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"stats\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"free\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"lanes\\\"], true, \\\"{view}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n540→    pick(&mut sim, \\\"Save\\\");\\n    pick(&mut sim, \\\"Reset Gray\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 1, \\\"{s}\\\");\\n    assert_eq!(s[\\\"stamps\\\"], 0);\\n    assert_eq!(s[\\\"minutes\\\"], 0);\\n    assert_eq!(s[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(s[\\\"view\\\"][\\\"lanes\\\"], true, \\\"reset cleared the viewer\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n550→    pick(&mut sim, \\\"Pose Parade\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"pose\\\");\\n    for _ in 0..8 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let ui = ui_of(&sim);\\n    assert!(!ui.trace.is_empty(), \\\"dot trace stayed empty\\\");\\n    assert!(ui.overlay.contains(\\\"Lean\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.overlay.contains(\\\"Tick\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.camera_yaw.is_some());\\n560→    assert!(status(&sim)[\\\"view\\\"][\\\"trace\\\"].as_u64().unwrap_or(0) > 0);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/tests/fit.rs\",\"offset\":150,\"limit\":450,\"raw_output\":\"    sim.step(&InputFrame { pressed: buttons::CONFIRM, device: 2, ..Default::default() });\\n    let off = status(&sim);\\n    assert_eq!(off[\\\"phase\\\"], \\\"title\\\");\\n    assert_eq!(off[\\\"demo\\\"], false);\\n    assert_eq!(off[\\\"save_serial\\\"], serial);\\n}\\n\\n#[test]\\nfn pause_freezes_world_time_and_the_body() {\\n    let mut sim = boot(\\\"fit/event/breath\\\", 6);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..40 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n    let before = status(&sim);\\n    let wt = before[\\\"world_time\\\"].as_f64().unwrap();\\n    assert!(wt > 0.0, \\\"world time never started\\\");\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let feet = sim.feet(id).expect(\\\"feet\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    for _ in 0..120 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let frozen = status(&sim);\\n    assert!((frozen[\\\"world_time\\\"].as_f64().unwrap() - wt).abs() < 1e-5);\\n    let feet2 = sim.feet(id).expect(\\\"feet\\\");\\n    assert!((feet2 - feet).length() < 1e-3, \\\"body moved while paused\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"event\\\");\\n    let input = sim.bot_input();\\n    sim.step(&input);\\n    assert!(status(&sim)[\\\"world_time\\\"].as_f64().unwrap() > wt);\\n}\\n\\n#[test]\\nfn music_defaults_quiet_and_a_dev_slider_resets() {\\n    let mut sim = boot(\\\"fit\\\", 8);\\n    let s = status(&sim);\\n    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.10).abs() < 1e-6, \\\"music {}\\\", s[\\\"music\\\"]);\\n    let stiff = s[\\\"stiffness\\\"].as_f64().unwrap();\\n    pick(&mut sim, \\\"Settings\\\");\\n    assert_eq!(phase(&sim), \\\"settings\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let music = status(&sim)[\\\"music\\\"].as_f64().unwrap();\\n    assert!((music - 0.20).abs() < 0.02, \\\"pad right left music at {music}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    assert_eq!(phase(&sim), \\\"title\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Tuning\\\");\\n    sim.step(&press(buttons::MENU_RIGHT));\\n    let moved = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((moved - stiff).abs() > 1.0, \\\"pad right left stiffness at {moved}\\\");\\n    pick(&mut sim, \\\"Reset feel\\\");\\n    let back = status(&sim)[\\\"stiffness\\\"].as_f64().unwrap();\\n    assert!((back - stiff).abs() < 1e-3, \\\"reset left {back}, was {stiff}\\\");\\n}\\n\\n#[test]\\nfn medley_is_the_same_course_twice() {\\n    let a = medley_scores(9);\\n    let b = medley_scores(9);\\n    for (i, (x, y)) in a.iter().zip(b.iter()).enumerate() {\\n        assert!((x - y).abs() < 1e-3, \\\"stat {i} {x} vs {y}\\\");\\n    }\\n    assert!(a.iter().sum::<f64>() <= 3000.0);\\n}\\n\\nfn medley_scores(seed: u64) -> Vec<f64> {\\n    let mut sim = boot(\\\"fit/medley\\\", seed);\\n    assert!(bot_until(&mut sim, |s| status(s)[\\\"hub\\\"][\\\"done\\\"].as_bool() == Some(true), 30_000));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"hub\\\"][\\\"label\\\"], \\\"Inter-Resort Medley\\\");\\n    let stats = &s[\\\"hub\\\"][\\\"stats\\\"];\\n    vec![\\n        stats[\\\"paddle\\\"].as_f64().unwrap(),\\n        stats[\\\"tide\\\"].as_f64().unwrap(),\\n        stats[\\\"cannon\\\"].as_f64().unwrap(),\\n    ]\\n}\\n\\n#[test]\\nfn play_together_reaches_a_podium() {\\n    let mut sim = boot(\\\"fit\\\", 12);\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"together\\\");\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"podium\\\", 40_000), \\\"phase {}\\\", phase(&sim));\\n    let s = status(&sim);\\n    let podium = s[\\\"podium\\\"].as_array().cloned().unwrap_or_default();\\n    assert_eq!(podium.len(), 2, \\\"{podium:?}\\\");\\n    assert_eq!(s[\\\"outcome\\\"], \\\"playing\\\");\\n}\\n\\n#[test]\\nfn shipped_text_stays_in_bounds() {\\n    let files: [(&str, &str); 5] = [\\n        (\\\"script\\\", include_str!(\\\"../src/games/fit/script.toml\\\")),\\n        (\\\"rules\\\", include_str!(\\\"../src/games/fit/rules.toml\\\")),\\n        (\\\"charts\\\", include_str!(\\\"../src/games/fit/charts.toml\\\")),\\n        (\\\"hub\\\", include_str!(\\\"../src/games/fit/hub.toml\\\")),\\n        (\\\"events\\\", include_str!(\\\"../src/games/fit/events.rs\\\")),\\n    ];\\n    let banned = [\\\"todo\\\", \\\"placeholder\\\", \\\"bmi\\\", \\\"diet\\\", \\\"weight\\\", \\\"wii\\\", \\\"nintendo\\\"];\\n    for (name, text) in files {\\n        for (n, line) in text.lines().enumerate() {\\n            if line.contains(\\\"Source:\\\") {\\n                continue;\\n            }\\n            let low = line.to_ascii_lowercase();\\n            for word in banned {\\n                assert!(!low.contains(word), \\\"{name}:{} contains {word}\\\", n + 1);\\n            }\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Wobble Minutes\\\");\\n}\\n\\n#[test]\\nfn save_round_trip_matches_the_slot() {\\n    let mut sim = boot(\\\"fit\\\", 15);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 3;\\n        g.age = 22;\\n        g.stamps = 2;\\n        g.name = \\\"Kai\\\".into();\\n        g.settings.music = 0.25;\\n        g.today = 20;\\n        let blob = g.export_save();\\n        g.day = 1;\\n        g.age = 80;\\n        g.name = \\\"Guest\\\".into();\\n        g.settings.music = 0.10;\\n        assert!(g.import_save(&blob));\\n        assert!(!g.import_save(\\\"{\\\"));\\n        assert!(!g.import_save(\\\"{\\\\\\\"version\\\\\\\":9,\\\\\\\"slots\\\\\\\":[],\\\\\\\"settings\\\\\\\":{},\\\\\\\"last_day\\\\\\\":0}\\\"));\\n    }\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 3);\\n    assert_eq!(s[\\\"age\\\"], 22);\\n    assert_eq!(s[\\\"name\\\"], \\\"Kai\\\");\\n    assert!((s[\\\"music\\\"].as_f64().unwrap() - 0.25).abs() < 1e-6);\\n    assert_eq!(s[\\\"version\\\"], 1);\\n}\\n\\n#[test]\\nfn hub_ghost_is_a_sample_and_about_pages_turn() {\\n    let medley = boot(\\\"fit/medley\\\", 3);\\n    let ghost = &status(&medley)[\\\"hub\\\"][\\\"ghost\\\"];\\n    assert!(ghost.is_object(), \\\"{ghost}\\\");\\n    assert_eq!(ghost[\\\"area\\\"], 9, \\\"paddle is event index 9\\\");\\n    assert!(ghost[\\\"position\\\"].is_array());\\n    assert!(ghost[\\\"lean\\\"].is_array());\\n    let title = boot(\\\"fit\\\", 3);\\n    assert_eq!(status(&title)[\\\"hub\\\"][\\\"ghost\\\"][\\\"area\\\"], -1);\\n\\n    let mut sim = boot(\\\"fit\\\", 4);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.about_blob = r#\\\"{\\\"sourceInformation\\\":{\\\"usage\\\":\\\"added on import\\\",\\\"source\\\":\\\"Wii Fit\\\"},\\\"testingFeedback\\\":[\\\"the bot caught a gust\\\"],\\\"engineFeedback\\\":[\\\"pause returns inside the tick\\\"],\\\"promptFeedback\\\":[\\\"the full roster ships\\\"]}\\\"#.into();\\n    }\\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(5)), device: 2, pressed: 0, ..Default::default() });\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"Source:\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"added on import\\\"), \\\"{blob}\\\");\\n    assert!(blob.contains(\\\"Testing Feedback\\\"), \\\"{blob}\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::TAB_R));\\n    let ui = sim.play().unwrap().fit_ui(&sim).unwrap();\\n    let blob = ui.lines.join(\\\" \\\");\\n    assert!(blob.contains(\\\"the bot caught a gust\\\"), \\\"{blob}\\\");\\n}\\n\\n#[test]\\nfn name_and_outfit_pages_reach_gray_and_golden() {\\n    let mut sim = boot(\\\"fit\\\", 16);\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"slots\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"name\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(phase(&sim), \\\"look\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(phase(&sim), \\\"outfit\\\");\\n    sim.step(&press(buttons::TAB_R));\\n    sim.step(&press(buttons::MENU_DOWN));\\n    sim.step(&press(buttons::CONFIRM));\\n    assert_eq!(status(&sim)[\\\"outfit\\\"], 7, \\\"Golden is the eighth outfit\\\");\\n    assert_eq!(phase(&sim), \\\"intro\\\");\\n}\\n\\n#[test]\\nfn schedule_pages_to_cannonball_after_unlock() {\\n    let mut sim = boot(\\\"fit\\\", 18);\\n    sim.step(&press(buttons::PAUSE));\\n    assert_eq!(phase(&sim), \\\"dev\\\");\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    sim.step(&press(buttons::SCHEDULE));\\n    assert_eq!(phase(&sim), \\\"schedule\\\");\\n    pick(&mut sim, \\\"Cannonball\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"cannon\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn eyes_closed_hides_the_puck_and_the_tone_moves() {\\n    let mut sim = boot(\\\"fit/event/check\\\", 3);\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"check\\\" && status(s)[\\\"act_phase\\\"].as_u64() == Some(2), 4000),\\n        \\\"phase {} act {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"act_phase\\\"]\\n    );\\n    let ui = ui_of(&sim);\\n    assert!(ui.puck.is_none(), \\\"puck stayed up\\\");\\n    assert!(ui.dim > 0.5, \\\"dim {}\\\", ui.dim);\\n    let blob = ui.lines.join(\\\" \\\").to_ascii_lowercase();\\n    assert!(blob.contains(\\\"eyes\\\"), \\\"{blob}\\\");\\n    let tone = status(&sim)[\\\"tone\\\"].as_f64().unwrap();\\n    for _ in 0..30 {\\n        sim.step(&InputFrame { lean: Vec2::new(1.0, 0.0), ..Default::default() });\\n    }\\n    let later = status(&sim);\\n    assert_eq!(later[\\\"act_phase\\\"], 2, \\\"left the eyes-closed phase\\\");\\n    let moved = later[\\\"tone\\\"].as_f64().unwrap();\\n    assert!((moved - tone).abs() > 0.05, \\\"tone {tone} -> {moved}\\\");\\n}\\n\\n#[test]\\nfn long_stillness_goes_quiet_and_offers_a_fake_skip() {\\n    let mut sim = boot(\\\"fit\\\", 5);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Time\\\");\\n    pick(&mut sim, \\\"4x\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    let opened = status(&sim);\\n    assert_eq!(opened[\\\"phase\\\"], \\\"event\\\");\\n    assert_eq!(opened[\\\"event\\\"], \\\"bigstand\\\");\\n    assert_eq!(opened[\\\"song\\\"], 3, \\\"finale bed\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Long stillness\\\");\\n    let still = status(&sim);\\n    assert_eq!(still[\\\"song\\\"], 0, \\\"stillness should be silent\\\");\\n    assert_eq!(still[\\\"act_phase\\\"], 4);\\n    let mut guard = 0;\\n    while status(&sim)[\\\"act_sub\\\"].as_f64().unwrap_or(0.0) < 15.0 && guard < 400 {\\n        sim.step(&InputFrame::default());\\n        guard += 1;\\n    }\\n    let s = status(&sim);\\n    assert!(s[\\\"act_sub\\\"].as_f64().unwrap() >= 15.0, \\\"sub {} after {guard}\\\", s[\\\"act_sub\\\"]);\\n    let ui = ui_of(&sim);\\n    let line = ui.lines.join(\\\" \\\");\\n    assert!(line.contains(\\\"Press\\\") && line.contains(\\\"skip\\\"), \\\"{line}\\\");\\n    assert!(ui.footer.contains(\\\"Press\\\") && ui.footer.contains(\\\"skip\\\"), \\\"{}\\\", ui.footer);\\n    assert!(ui.big.is_empty(), \\\"score banner {}\\\", ui.big);\\n    assert!(ui.title.is_empty(), \\\"title fell back to {}\\\", ui.title);\\n    assert!(ui.puck.is_some(), \\\"puck should stay\\\");\\n}\\n\\n#[test]\\nfn a_good_finale_can_rowboat_from_a_middle_age() {\\n    let mut sim = boot(\\\"fit\\\", 1);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.age = 45;\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"The Big Stand\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"bigstand\\\");\\n    assert!(\\n        bot_until(&mut sim, |s| phase(s) == \\\"ending\\\", 20_000),\\n        \\\"phase {} score {}\\\",\\n        phase(&sim),\\n        status(&sim)[\\\"score\\\"]\\n    );\\n    let s = status(&sim);\\n    let score = s[\\\"score\\\"].as_f64().unwrap();\\n    let cut = (score / 100.0).floor().min(10.0) as u8;\\n    let expect = 45u8.saturating_sub(cut).max(18);\\n    assert_eq!(s[\\\"age\\\"], expect, \\\"score {score}\\\");\\n    if score >= 500.0 {\\n        assert_eq!(s[\\\"ending\\\"], \\\"rowboat\\\", \\\"score {score} age {}\\\", s[\\\"age\\\"]);\\n    }\\n}\\n\\n#[test]\\nfn pose_parade_plays_the_tree_clip() {\\n    let mut sim = boot(\\\"fit/event/pose\\\", 2);\\n    assert!(bot_until(&mut sim, |s| phase(s) == \\\"event\\\", 400));\\n    for _ in 0..20 {\\n        let input = sim.bot_input();\\n        sim.step(&input);\\n    }\\n    let tree = pav_core::clips::find(\\\"FIT/Tree\\\").expect(\\\"FIT/Tree\\\");\\n    let clip = status(&sim)[\\\"clip\\\"].as_u64().unwrap();\\n    assert_ne!(clip, 0);\\n    assert_eq!(clip, tree as u64);\\n}\\n\\n#[test]\\nfn wardrobe_calendar_and_beach_props() {\\n    let mut sim = boot(\\\"fit\\\", 20);\\n    let props = sim.state.entities.iter().filter(|e| e.prop.is_some()).count();\\n    assert!(props > 0, \\\"no beach props\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap_or_default();\\n    assert!(mats.len() >= 11, \\\"{mats:?}\\\");\\n    assert!(mats.iter().any(|m| m[\\\"event\\\"] == \\\"cannon\\\"), \\\"{mats:?}\\\");\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Wardrobe\\\");\\n    pick(&mut sim, \\\"Sun cap\\\");\\n    assert_eq!(sim.config.puppet.gear.helm, HelmKind::Cap);\\n    pick(&mut sim, \\\"Calendar\\\");\\n    let ui = ui_of(&sim);\\n    assert!(ui.items.iter().any(|it| it.label.contains(\\\"Day\\\")), \\\"{:?}\\\", ui.items);\\n}\\n\\n#[test]\\nfn a_mat_on_the_sand_starts_its_event() {\\n    let mut sim = boot(\\\"fit\\\", 22);\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"Cheats\\\");\\n    pick(&mut sim, \\\"Unlock all\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Island\\\");\\n    assert_eq!(phase(&sim), \\\"island\\\");\\n    let mats = status(&sim)[\\\"mats\\\"].as_array().cloned().unwrap();\\n    let mat = mats.iter().find(|m| m[\\\"event\\\"] == \\\"floatie\\\").expect(\\\"floatie mat\\\");\\n    let x = mat[\\\"x\\\"].as_f64().unwrap() as f32;\\n    let z = mat[\\\"z\\\"].as_f64().unwrap() as f32;\\n    let id = sim.state.player.expect(\\\"player\\\");\\n    let mut arrived = false;\\n    for _ in 0..700 {\\n        let feet = sim.feet(id).expect(\\\"feet\\\");\\n        let dx = x - feet.x;\\n        let dz = z - feet.z;\\n        if dx.hypot(dz) < 0.8 {\\n            arrived = true;\\n            break;\\n        }\\n        let d = dx.hypot(dz).max(0.001);\\n        sim.step(&InputFrame { move_dir: Vec2::new(dx / d, dz / d), ..Default::default() });\\n    }\\n    assert!(arrived, \\\"never reached the floatie mat\\\");\\n    sim.step(&press(buttons::CONFIRM));\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"event\\\"], \\\"floatie\\\", \\\"{s}\\\");\\n    assert!(matches!(s[\\\"phase\\\"].as_str(), Some(\\\"card\\\" | \\\"countdown\\\" | \\\"event\\\")), \\\"{}\\\", s[\\\"phase\\\"]);\\n}\\n\\n#[test]\\nfn view_and_save_tabs_change_the_stay() {\\n    let mut sim = boot(\\\"fit\\\", 3);\\n    {\\n        let g = sim.state.play.as_mut().unwrap().get_mut::<FitGame>().unwrap();\\n        g.day = 4;\\n        g.stamps = 3;\\n        g.day_minutes = 9;\\n        g.name = \\\"Gray\\\".into();\\n    }\\n    sim.step(&press(buttons::PAUSE));\\n    pick(&mut sim, \\\"View\\\");\\n    pick(&mut sim, \\\"Input\\\");\\n    pick(&mut sim, \\\"Dot\\\");\\n    pick(&mut sim, \\\"Engine\\\");\\n    pick(&mut sim, \\\"Free\\\");\\n    pick(&mut sim, \\\"Ghost\\\");\\n    let view = status(&sim)[\\\"view\\\"].clone();\\n    assert_eq!(view[\\\"input\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"stats\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"free\\\"], true, \\\"{view}\\\");\\n    assert_eq!(view[\\\"lanes\\\"], true, \\\"{view}\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Save\\\");\\n    pick(&mut sim, \\\"Reset Gray\\\");\\n    let s = status(&sim);\\n    assert_eq!(s[\\\"day\\\"], 1, \\\"{s}\\\");\\n    assert_eq!(s[\\\"stamps\\\"], 0);\\n    assert_eq!(s[\\\"minutes\\\"], 0);\\n    assert_eq!(s[\\\"name\\\"], \\\"Gray\\\");\\n    assert_eq!(s[\\\"view\\\"][\\\"lanes\\\"], true, \\\"reset cleared the viewer\\\");\\n    pick(&mut sim, \\\"Back\\\");\\n    pick(&mut sim, \\\"Jump\\\");\\n    pick(&mut sim, \\\"Pose Parade\\\");\\n    assert_eq!(status(&sim)[\\\"event\\\"], \\\"pose\\\");\\n    for _ in 0..8 {\\n        sim.step(&InputFrame::default());\\n    }\\n    let ui = ui_of(&sim);\\n    assert!(!ui.trace.is_empty(), \\\"dot trace stayed empty\\\");\\n    assert!(ui.overlay.contains(\\\"Lean\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.overlay.contains(\\\"Tick\\\"), \\\"{}\\\", ui.overlay);\\n    assert!(ui.camera_yaw.is_some());\\n    assert!(status(&sim)[\\\"view\\\"][\\\"trace\\\"].as_u64().unwrap_or(0) > 0);\\n}\\n\",\"total_lines\":561}}","is_error":false},{"type":"tool_result","tool_use_id":"call-6d2d3f26-80cd-4b85-a740-e71cbb3caed9-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"470→\\n    pub fn note_pointer(&mut self, p: Vec2) {\\n        if self.have_cursor {\\n            self.mouse_travel += (p - self.cursor).length();\\n        } else {\\n            self.have_cursor = true;\\n        }\\n        self.cursor = p;\\n    }\\n\\n480→    pub fn mark_touch_tap(&mut self) {\\n        self.touch_tap = true;\\n    }\\n\\n    /// Lean, device and pointer for one stay frame. `items` are normalized rects.\\n    pub fn fit_sample(&mut self, dt: f32, size: Vec2, items: &[(u16, [f32; 4])], clicked: bool) -> FitSample {\\n        use pav_core::games::fit::intent::{key_ramp2, mouse_lean, shape_stick2};\\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c));\\n        let b = &self.bindings;\\n        let held_dir = Vec2::new(\\n490→            k(&b.right) as i32 as f32 - k(&b.left) as i32 as f32,\\n            k(&b.up) as i32 as f32 - k(&b.down) as i32 as f32,\\n        );\\n        let shift = self.held() & buttons::FOCUS != 0;\\n        let rate = if shift { 0.55 } else { 1.6 };\\n        self.lean_ramp = key_ramp2(self.lean_ramp, held_dir, dt, rate, 1.2);\\n        let stick = shape_stick2(self.pad.raw_left, 0.12, 1.5);\\n        if stick.length() > 0.05 {\\n            self.lean_from = 1;\\n            self.seen_real = true;\\n500→        }\\n        if held_dir.length() > 0.0 {\\n            self.lean_from = 2;\\n            self.seen_real = true;\\n        }\\n        if self.mouse_travel > 6.0 && !self.coarse {\\n            self.lean_from = 3;\\n        }\\n        let lean = match self.lean_from {\\n            1 => stick,\\n510→            3 => {\\n                let offset = Vec2::new(self.cursor.x - size.x * 0.5, size.y * 0.5 - self.cursor.y);\\n                mouse_lean(offset, size.y)\\n            }\\n            _ => self.lean_ramp,\\n        };\\n        let mut extra = 0u32;\\n        if stick.y > 0.55 && self.stick_y <= 0.55 {\\n            extra |= buttons::MENU_UP;\\n        }\\n520→        if stick.y < -0.55 && self.stick_y >= -0.55 {\\n            extra |= buttons::MENU_DOWN;\\n        }\\n        self.stick_y = stick.y;\\n        let mut ui = None;\\n        let travel = self.mouse_travel;\\n        self.mouse_travel = 0.0;\\n        let tap = clicked || self.touch_tap;\\n        self.touch_tap = false;\\n        if size.x > 1.0 && size.y > 1.0 {\\n530→            for (id, rect) in items {\\n                let x = rect[0] * size.x;\\n                let y = rect[1] * size.y;\\n                let w = rect[2] * size.x;\\n                let h = rect[3] * size.y;\\n                if self.cursor.x >= x && self.cursor.x <= x + w && self.cursor.y >= y && self.cursor.y <= y + h {\\n                    let slider = (*id >= 300 && *id < 400) || (610..=616).contains(id);\\n                    let dragging = self.mouse.contains(&MouseButton::Left) && !tap && w > 1.0;\\n                    ui = Some(if tap {\\n                        pav_core::input::UiEvent::Click(*id)\\n540→                    } else if dragging && slider {\\n                        let along = ((self.cursor.x - x) / w).clamp(0.0, 1.0);\\n                        pav_core::input::UiEvent::Slider(*id, along)\\n                    } else {\\n                        pav_core::input::UiEvent::Hover(*id)\\n                    });\\n                }\\n            }\\n        }\\n        let device = if self.coarse && !self.seen_real {\\n550→            4\\n        } else if self.last_device == Device::Gamepad {\\n            1\\n        } else if self.lean_from == 3 {\\n            3\\n        } else if self.last_device == Device::Touch {\\n            4\\n        } else {\\n            2\\n        };\\n560→        let any = !self.coarse && (self.pad.any_activity || travel > 6.0 || stick.length() > 0.3 || lean.length() > 0.3);\\n        FitSample { lean, device, any, ui, extra }\\n    }\\n\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.seen_real = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.keys.insert(code);\\n570→                self.key_taps.insert(code);\\n            }\\n            ElementState::Released => {\\n                self.keys.remove(&code);\\n            }\\n        }\\n    }\\n\\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n580→        self.mouse_active = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.mouse.insert(b);\\n                self.mouse_taps.insert(b);\\n            }\\n            ElementState::Released => {\\n                self.mouse.remove(&b);\\n            }\\n        }\",\"content_concise\":\"470→\\n    pub fn note_pointer(&mut self, p: Vec2) {\\n        if self.have_cursor {\\n            self.mouse_travel += (p - self.cursor).length();\\n        } else {\\n            self.have_cursor = true;\\n        }\\n        self.cursor = p;\\n    }\\n\\n480→    pub fn mark_touch_tap(&mut self) {\\n        self.touch_tap = true;\\n    }\\n\\n    /// Lean, device and pointer for one stay frame. `items` are normalized rects.\\n    pub fn fit_sample(&mut self, dt: f32, size: Vec2, items: &[(u16, [f32; 4])], clicked: bool) -> FitSample {\\n        use pav_core::games::fit::intent::{key_ramp2, mouse_lean, shape_stick2};\\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c));\\n        let b = &self.bindings;\\n        let held_dir = Vec2::new(\\n490→            k(&b.right) as i32 as f32 - k(&b.left) as i32 as f3