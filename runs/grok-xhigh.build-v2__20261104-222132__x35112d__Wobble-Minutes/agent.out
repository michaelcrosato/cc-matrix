fed by talking gym gear.\\\"\\n10→OUT=\\\"$WORK/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132.html\\\"\\ncd \\\"$DEV/engine\\\"\\nscripts/build-web.sh --single-file --scene fit \\\\\\n  --title \\\"$TITLE\\\" \\\\\\n  --description \\\"$DESC\\\" \\\\\\n  --theme-color \\\"#f4e7d4\\\" \\\\\\n  --out \\\"$OUT\\\"\\n\",\"content_concise\":\"1→#!/usr/bin/env bash\\n# Copy the exit interview into the page, then pack one HTML file for the work folder.\\nset -euo pipefail\\nDEV=\\\"$(cd \\\"$(dirname \\\"$0\\\")/..\\\" && pwd)\\\"\\nWORK=\\\"$(cd \\\"$DEV/..\\\" && pwd)\\\"\\nexport CARGO_BUILD_JOBS=\\\"${CARGO_BUILD_JOBS:-8}\\\"\\npython3 \\\"$DEV/tools/write_index.py\\\"\\nTITLE=\\\"Wobble Minutes — Five days, one mat\\\"\\nDESC=\\\"Lean through a week of balance games at Tippy Cay, a pastel resort staffed by talking gym gear.\\\"\\n10→OUT=\\\"$WORK/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132.html\\\"\\ncd \\\"$DEV/engine\\\"\\nscripts/build-web.sh --single-file --scene fit \\\\\\n  --title \\\"$TITLE\\\" \\\\\\n  --description \\\"$DESC\\\" \\\\\\n  --theme-color \\\"#f4e7d4\\\" \\\\\\n  --out \\\"$OUT\\\"\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/tools/build.sh\",\"offset\":null,\"raw_output\":\"#!/usr/bin/env bash\\n# Copy the exit interview into the page, then pack one HTML file for the work folder.\\nset -euo pipefail\\nDEV=\\\"$(cd \\\"$(dirname \\\"$0\\\")/..\\\" && pwd)\\\"\\nWORK=\\\"$(cd \\\"$DEV/..\\\" && pwd)\\\"\\nexport CARGO_BUILD_JOBS=\\\"${CARGO_BUILD_JOBS:-8}\\\"\\npython3 \\\"$DEV/tools/write_index.py\\\"\\nTITLE=\\\"Wobble Minutes — Five days, one mat\\\"\\nDESC=\\\"Lean through a week of balance games at Tippy Cay, a pastel resort staffed by talking gym gear.\\\"\\nOUT=\\\"$WORK/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132.html\\\"\\ncd \\\"$DEV/engine\\\"\\nscripts/build-web.sh --single-file --scene fit \\