            together_scores: Vec::new(),\\n            together_names: Vec::new(),\\n            podium: Vec::new(),\\n            demo: false,\\n            attract_i: 0,\\n            attract_t: 0.0,\\n            reset_arm: false,\\n            ghost_id: None,\\n            about_page: 0,\\n            about_blob: String::new(),\\n        }\\n    }\\n\\n    /// Versioned save. Progress and settings only; attract never calls this.\\n    pub fn export_save(&mut self) -> String {\\n        self.write_slot();\\n        let dto = SaveDto {\\n\",\"total_lines\":1928}}","is_error":false},{"type":"tool_result","tool_use_id":"call-94ac85f9-e7d8-429b-98fc-7343bf2262c6-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"480→        *self = Self::fresh();\\n        self.settings = settings;\\n        self.today = today;\\n        self.last_day = last_day;\\n        self.save_serial = serial;\\n        self.slot = slot;\\n        self.slots = slots;\\n        self.flops = flops;\\n        self.device = device;\\n        self.seen_real = seen;\\n490→        self.touch_only = touch;\\n        self.audio_unlocked = audio;\\n    }\\n\\n    fn touch_save(&mut self) {\\n        if self.demo || self.run == Run::Demo || self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        self.save_serial = self.save_serial.wrapping_add(1);\\n        self.write_slot();\\n500→    }\\n\\n    fn script(&self) -> &'static Script {\\n        script::script()\\n    }\\n\\n    fn goal(&self) -> u32 {\\n        match self.day {\\n            1 => 3,\\n            2 => 5,\\n510→            3 => 7,\\n            4 => 9,\\n            _ => 0,\\n        }\\n    }\\n\\n    fn day_clear(&self) -> bool {\\n        if self.free_play || self.day >= 5 {\\n            return false;\\n        }\\n520→        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n530→            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n540→                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n550→                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n560→            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n570→                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n580→            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n590→            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n600→                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n610→                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n620→            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let mut rules = self.rules.clone();\\n630→                let infos = params::list(&mut rules);\\n                let start = (self.page - 1) * 4;\\n                let mut v: Vec<(u16, String)> = infos\\n                    .iter()\\n                    .enumerate()\\n                    .skip(start)\\n                    .take(4)\\n                    .map(|(i, info)| {\\n                        let label = match &info.value {\\n                            ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n640→                            ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                            _ => info.path.clone(),\\n                        };\\n                        (300 + i as u16, label)\\n                    })\\n                    .collect();\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n        }\\n650→    }\\n\\n    fn start_activity(&mut self, kind: EventId, sim: &mut Sim) {\\n        if let Some(id) = self.ghost_id.take() {\\n            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n660→                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n670→    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n680→        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n690→    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n700→                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n710→                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n720→                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n730→                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n740→                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n750→                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n760→                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n770→            }\\n            Run::Demo => {}\\n        }\\n    }\\n\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n780→        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n790→        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n800→    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n810→            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n820→        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n830→                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n840→                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n850→                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n860→                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n870→                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n880→                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n890→                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n900→                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n910→                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n920→                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n930→            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n940→                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n950→                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n960→            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n970→    fn begin_together(&mut self, n: u8) {\\n        let names = self.script().names.clone();\\n        self.together_n = n.clamp(2, 4);\\n        self.together_i = 0;\\n        self.medley_i = 0;\\n        self.together_names = (0..self.together_n).map(|i| names.get(i as usize).cloned().unwrap_or_else(|| format!(\\\"Guest {}\\\", i + 1))).collect();\\n        self.together_scores = vec![0.0; self.together_n as usize];\\n        self.run = Run::Together;\\n        self.flow = Flow::Pass;\\n        self.focus = 0;\\n980→        self.line_i = 0;\\n    }\\n\\n    fn open_settings(&mut self) {\\n        self.return_flow = if self.flow == Flow::Settings { self.return_flow } else { self.flow };\\n        if self.flow == Flow::Attract {\\n            self.demo = false;\\n        }\\n        self.flow = Flow::Settings;\\n        self.page = 0;\\n990→        self.focus = 0;\\n        self.reset_arm = false;\\n    }\\n\\n    fn activate_settings(&mut self, id: u16) {\\n        match id {\\n            ACT_XBOX => self.settings.xbox = !self.settings.xbox,\\n            ACT_FULLSCREEN => self.settings.fullscreen = !self.settings.fullscreen,\\n            ACT_RESET_SAVE => {\\n                if self.reset_arm {\\n1000→                    self.slots = vec![Slot::default(); 4];\\n                    self.reset_arm = false;\\n                    self.save_serial = self.save_serial.wrapping_add(1);\\n                } else {\\n                    self.reset_arm = true;\\n                }\\n            }\\n            ACT_BACK => self.go_back(),\\n            _ => {}\\n        }\\n1010→    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n        self.flow = match self.flow {\\n            Flow::Slots | Flow::About | Flow::HowTo | Flow::Settings | Flow::Podium => {\\n                if self.flow == Flow::Settings || self.flow == Flow::About || self.flow == Flow::HowTo {\\n                    let back = self.return_flow;\\n                    if back == Flow::Attract {\\n                        self.demo = true;\\n1020→                    }\\n                    if self.flow == Flow::Podium {\\n                        self.run = Run::Story;\\n                    }\\n                    back\\n                } else if self.flow == Flow::Podium {\\n                    self.run = Run::Story;\\n                    Flow::Title\\n                } else {\\n                    Flow::Title\\n1030→                }\\n            }\\n            Flow::Schedule => Flow::Island,\\n            Flow::Wardrobe | Flow::Calendar => self.return_flow,\\n            Flow::Dev => self.paused_from,\\n            Flow::Name | Flow::Look | Flow::Outfit => Flow::Title,\\n            _ => Flow::Title,\\n        };\\n    }\\n\\n1040→    fn after_result(&mut self) {\\n        self.focus = 0;\\n        if self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        if self.run == Run::Together {\\n            return;\\n        }\\n        self.flow = Flow::Island;\\n    }\\n1050→\\n    fn apply_slider(&mut self, id: u16, v: f32) {\\n        let v = v.clamp(0.0, 1.0);\\n        match id {\\n            610 => self.settings.music = v,\\n            611 => self.settings.sfx = v,\\n            612 => self.settings.voice = v,\\n            613 => self.settings.sensitivity = 0.5 + v,\\n            614 => self.settings.wobble_assist = v,\\n            615 => self.settings.rhythm_offset = (v - 0.5) * 0.1,\\n1060→            616 => self.settings.text_speed = 0.5 + v * 1.5,\\n            _ => {}\\n        }\\n        if !(300..400).contains(&id) {\\n            return;\\n        }\\n        let mut rules = self.rules.clone();\\n        let infos = params::list(&mut rules);\\n        let Some(info) = infos.get((id - 300) as usize) else { return };\\n        let path = info.path.clone();\\n1070→        let value = match info.kind.clone() {\\n            ParamKind::Float { min, max } => ParamValue::Float((min + v * (max - min)) as f64),\\n            ParamKind::Int { min, max } => ParamValue::Int((min as f32 + v * (max - min) as f32).round() as i64),\\n            _ => return,\\n        };\\n        let _ = params::set(&mut self.rules, &path, value);\\n    }\\n\\n    fn talk(&self) -> Vec<(String, String)> {\\n        let s = self.script();\\n1080→        let pull = |speaker: &str, tag: &str| -> Vec<(String, String)> {\\n            let n = s.count(speaker, tag);\\n            (0..n).filter_map(|i| s.line(speaker, tag, i).map(|t| (speaker.to_string(), t.to_string()))).collect()\\n        };\\n        match self.flow {\\n            Flow::Intro => {\\n                let mut v = pull(\\\"Pip\\\", \\\"intro\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Welcome ashore. The mat remembers nothing yet.\\\".into()));\\n                }\\n1090→                v\\n            }\\n            Flow::Wake => {\\n                let mut v = Vec::new();\\n                if self.last_day > 0 && self.today > self.last_day {\\n                    let d = self.today - self.last_day;\\n                    v.push((\\\"Pip\\\".into(), format!(\\\"You were away {d} days. The mat kept your place.\\\")));\\n                }\\n                let tag = format!(\\\"wake{}\\\", self.day.min(5));\\n                v.extend(pull(\\\"Pip\\\", &tag));\\n1100→                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Morning. The deck is already warm.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Reveal => {\\n                let mut v = pull(\\\"Pip\\\", \\\"reveal\\\");\\n                v.insert(0, (\\\"Pip\\\".into(), format!(\\\"Balance Age {}. Lower means the mat was calmer.\\\", self.age)));\\n                v\\n            }\\n1110→            Flow::Sleep => {\\n                let mut v = pull(\\\"Pip\\\", \\\"sleep\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Stamp the day. The hammock is already on your side.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Ending => {\\n                let tag_line = if self.ending == \\\"rowboat\\\" {\\n                    \\\"The rowboat is ready. You may check out, or stay and play.\\\"\\n1120→                } else {\\n                    \\\"The week would like a little more of you. The hammock agrees. This is the Extended Stay.\\\"\\n                };\\n                vec![(\\\"Pip\\\".into(), tag_line.into())]\\n            }\\n            Flow::Credits => {\\n                let mut v = pull(\\\"Pip\\\", \\\"credits\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Tippy Cay keeps the light on.\\\".into()));\\n                }\",\"content_concise\":\"480→        *self = Self::fresh();\\n        self.settings = settings;\\n        self.today = today;\\n        self.last_day = last_day;\\n        self.save_serial = serial;\\n        self.slot = slot;\\n        self.slots = slots;\\n        self.flops = flops;\\n        self.device = device;\\n        self.seen_real = seen;\\n490→        self.touch_only = touch;\\n        self.audio_unlocked = audio;\\n    }\\n\\n    fn touch_save(&mut self) {\\n        if self.demo || self.run == Run::Demo || self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        self.save_serial = self.save_serial.wrapping_add(1);\\n        self.write_slot();\\n500→    }\\n\\n    fn script(&self) -> &'static Script {\\n        script::script()\\n    }\\n\\n    fn goal(&self) -> u32 {\\n        match self.day {\\n            1 => 3,\\n            2 => 5,\\n510→            3 => 7,\\n            4 => 9,\\n            _ => 0,\\n        }\\n    }\\n\\n    fn day_clear(&self) -> bool {\\n        if self.free_play || self.day >= 5 {\\n            return false;\\n        }\\n520→        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n530→            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n540→                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n550→                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n560→            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n570→                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n580→            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n590→            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n600→                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n610→                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n620→            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let mut rules = self.rules.clone();\\n630→                let infos = params::list(&mut rules);\\n                let start = (self.page - 1) * 4;\\n                let mut v: Vec<(u16, String)> = infos\\n                    .iter()\\n                    .enumerate()\\n                    .skip(start)\\n                    .take(4)\\n                    .map(|(i, info)| {\\n                        let label = match &info.value {\\n                            ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n640→                            ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                            _ => info.path.clone(),\\n                        };\\n                        (300 + i as u16, label)\\n                    })\\n                    .collect();\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n        }\\n650→    }\\n\\n    fn start_activity(&mut self, kind: EventId, sim: &mut Sim) {\\n        if let Some(id) = self.ghost_id.take() {\\n            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n660→                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n670→    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n680→        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n690→    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n700→                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n710→                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n720→                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n730→                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n740→                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n750→                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n760→                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n770→            }\\n            Run::Demo => {}\\n        }\\n    }\\n\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n780→        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n790→        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n800→    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n810→            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n820→        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n830→                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n840→                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n850→                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n860→                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n870→                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n880→                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n890→                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n900→                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n910→                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n920→                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n930→            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n940→                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n950→                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n960→            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n970→    fn begin_together(&mut self, n: u8) {\\n        let names = self.script().names.clone();\\n        self.together_n = n.clamp(2, 4);\\n        self.together_i = 0;\\n        self.medley_i = 0;\\n        self.together_names = (0..self.together_n).map(|i| names.get(i as usize).cloned().unwrap_or_else(|| format!(\\\"Guest {}\\\", i + 1))).collect();\\n        self.together_scores = vec![0.0; self.together_n as usize];\\n        self.run = Run::Together;\\n        self.flow = Flow::Pass;\\n        self.focus = 0;\\n980→        self.line_i = 0;\\n    }\\n\\n    fn open_settings(&mut self) {\\n        self.return_flow = if self.flow == Flow::Settings { self.return_flow } else { self.flow };\\n        if self.flow == Flow::Attract {\\n            self.demo = false;\\n        }\\n        self.flow = Flow::Settings;\\n        self.page = 0;\\n990→        self.focus = 0;\\n        self.reset_arm = false;\\n    }\\n\\n    fn activate_settings(&mut self, id: u16) {\\n        match id {\\n            ACT_XBOX => self.settings.xbox = !self.settings.xbox,\\n            ACT_FULLSCREEN => self.settings.fullscreen = !self.settings.fullscreen,\\n            ACT_RESET_SAVE => {\\n                if self.reset_arm {\\n1000→                    self.slots = vec![Slot::default(); 4];\\n                    self.reset_arm = false;\\n                    self.save_serial = self.save_serial.wrapping_add(1);\\n                } else {\\n                    self.reset_arm = true;\\n                }\\n            }\\n            ACT_BACK => self.go_back(),\\n            _ => {}\\n        }\\n1010→    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n        self.flow = match self.flow {\\n            Flow::Slots | Flow::About | Flow::HowTo | Flow::Settings | Flow::Podium => {\\n                if self.flow == Flow::Settings || self.flow == Flow::About || self.flow == Flow::HowTo {\\n                    let back = self.return_flow;\\n                    if back == Flow::Attract {\\n                        self.demo = true;\\n1020→                    }\\n                    if self.flow == Flow::Podium {\\n                        self.run = Run::Story;\\n                    }\\n                    back\\n                } else if self.flow == Flow::Podium {\\n                    self.run = Run::Story;\\n                    Flow::Title\\n                } else {\\n                    Flow::Title\\n1030→                }\\n            }\\n            Flow::Schedule => Flow::Island,\\n            Flow::Wardrobe | Flow::Calendar => self.return_flow,\\n            Flow::Dev => self.paused_from,\\n            Flow::Name | Flow::Look | Flow::Outfit => Flow::Title,\\n            _ => Flow::Title,\\n        };\\n    }\\n\\n1040→    fn after_result(&mut self) {\\n        self.focus = 0;\\n        if self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        if self.run == Run::Together {\\n            return;\\n        }\\n        self.flow = Flow::Island;\\n    }\\n1050→\\n    fn apply_slider(&mut self, id: u16, v: f32) {\\n        let v = v.clamp(0.0, 1.0);\\n        match id {\\n            610 => self.settings.music = v,\\n            611 => self.settings.sfx = v,\\n            612 => self.settings.voice = v,\\n            613 => self.settings.sensitivity = 0.5 + v,\\n            614 => self.settings.wobble_assist = v,\\n            615 => self.settings.rhythm_offset = (v - 0.5) * 0.1,\\n1060→            616 => self.settings.text_speed = 0.5 + v * 1.5,\\n            _ => {}\\n        }\\n        if !(300..400).contains(&id) {\\n            return;\\n        }\\n        let mut rules = self.rules.clone();\\n        let infos = params::list(&mut rules);\\n        let Some(info) = infos.get((id - 300) as usize) else { return };\\n        let path = info.path.clone();\\n1070→        let value = match info.kind.clone() {\\n            ParamKind::Float { min, max } => ParamValue::Float((min + v * (max - min)) as f64),\\n            ParamKind::Int { min, max } => ParamValue::Int((min as f32 + v * (max - min) as f32).round() as i64),\\n            _ => return,\\n        };\\n        let _ = params::set(&mut self.rules, &path, value);\\n    }\\n\\n    fn talk(&self) -> Vec<(String, String)> {\\n        let s = self.script();\\n1080→        let pull = |speaker: &str, tag: &str| -> Vec<(String, String)> {\\n            let n = s.count(speaker, tag);\\n            (0..n).filter_map(|i| s.line(speaker, tag, i).map(|t| (speaker.to_string(), t.to_string()))).collect()\\n        };\\n        match self.flow {\\n            Flow::Intro => {\\n                let mut v = pull(\\\"Pip\\\", \\\"intro\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Welcome ashore. The mat remembers nothing yet.\\\".into()));\\n                }\\n1090→                v\\n            }\\n            Flow::Wake => {\\n                let mut v = Vec::new();\\n                if self.last_day > 0 && self.today > self.last_day {\\n                    let d = self.today - self.last_day;\\n                    v.push((\\\"Pip\\\".into(), format!(\\\"You were away {d} days. The mat kept your place.\\\")));\\n                }\\n                let tag = format!(\\\"wake{}\\\", self.day.min(5));\\n                v.extend(pull(\\\"Pip\\\", &tag));\\n1100→                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Morning. The deck is already warm.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Reveal => {\\n                let mut v = pull(\\\"Pip\\\", \\\"reveal\\\");\\n                v.insert(0, (\\\"Pip\\\".into(), format!(\\\"Balance Age {}. Lower means the mat was calmer.\\\", self.age)));\\n                v\\n            }\\n1110→            Flow::Sleep => {\\n                let mut v = pull(\\\"Pip\\\", \\\"sleep\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Stamp the day. The hammock is already on your side.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Ending => {\\n                let tag_line = if self.ending == \\\"rowboat\\\" {\\n                    \\\"The rowboat is ready. You may check out, or stay and play.\\\"\\n1120→                } else {\\n                    \\\"The week would like a little more of you. The hammock agrees. This is the Extended Stay.\\\"\\n                };\\n                vec![(\\\"Pip\\\".into(), tag_line.into())]\\n            }\\n            Flow::Credits => {\\n                let mut v = pull(\\\"Pip\\\", \\\"credits\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Tippy Cay keeps the light on.\\\".into()));\\n                }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-222132__x35112d/work/Wobble Minutes-Wii Fit-grok-4.7-xhigh-20261104-222132/engine/crates/pav_core/src/games/fit/mod.rs\",\"offset\":480,\"limit\":650,\"raw_output\":\"        *self = Self::fresh();\\n        self.settings = settings;\\n        self.today = today;\\n        self.last_day = last_day;\\n        self.save_serial = serial;\\n        self.slot = slot;\\n        self.slots = slots;\\n        self.flops = flops;\\n        self.device = device;\\n        self.seen_real = seen;\\n        self.touch_only = touch;\\n        self.audio_unlocked = audio;\\n    }\\n\\n    fn touch_save(&mut self) {\\n        if self.demo || self.run == Run::Demo || self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        self.save_serial = self.save_serial.wrapping_add(1);\\n        self.write_slot();\\n    }\\n\\n    fn script(&self) -> &'static Script {\\n        script::script()\\n    }\\n\\n    fn goal(&self) -> u32 {\\n        match self.day {\\n            1 => 3,\\n            2 => 5,\\n            3 => 7,\\n            4 => 9,\\n            _ => 0,\\n        }\\n    }\\n\\n    fn day_clear(&self) -> bool {\\n        if self.free_play || self.day >= 5 {\\n            return false;\\n        }\\n        let all = EventId::for_day(self.day).iter().all(|e| self.today_played.iter().any(|p| p == e.key()));\\n        all && self.day_minutes >= self.goal()\\n    }\\n\\n    fn schedule_events(&self) -> Vec<EventId> {\\n        if self.free_play {\\n            EventId::ALL.into_iter().filter(|e| !matches!(e, EventId::Check | EventId::BigStand)).collect()\\n        } else if self.day >= 5 {\\n            vec![EventId::BigStand]\\n        } else {\\n            EventId::for_day(self.day).to_vec()\\n        }\\n    }\\n\\n    fn screen_items(&self) -> Vec<(u16, String)> {\\n        let s = self.script();\\n        match self.flow {\\n            Flow::Title => {\\n                let mut v = vec![(ACT_NEW, \\\"New Stay\\\".into())];\\n                if self.slots.iter().any(|sl| sl.used) {\\n                    v.push((ACT_CONTINUE, \\\"Continue\\\".into()));\\n                }\\n                v.push((ACT_TOGETHER, \\\"Play Together\\\".into()));\\n                v.push((ACT_SETTINGS, \\\"Settings\\\".into()));\\n                v.push((ACT_ABOUT, \\\"About\\\".into()));\\n                v.push((ACT_HOWTO, \\\"How to Stand\\\".into()));\\n                v\\n            }\\n            Flow::Slots => {\\n                let mut v = Vec::new();\\n                for (i, sl) in self.slots.iter().enumerate().take(4) {\\n                    if self.continuing && !sl.used {\\n                        continue;\\n                    }\\n                    let label = if sl.used { format!(\\\"{} · day {}\\\", sl.name, sl.day) } else { format!(\\\"Hammock {} · empty\\\", i + 1) };\\n                    v.push((10 + i as u16, label));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Name => s.names.iter().enumerate().map(|(i, n)| (400 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Look => s.skins.iter().enumerate().map(|(i, n)| (500 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Outfit => s.outfits.iter().enumerate().map(|(i, n)| (520 + i as u16, n.clone())).take(6).collect(),\\n            Flow::Schedule => {\\n                let evs = self.schedule_events();\\n                let mut v = Vec::new();\\n                for (i, e) in evs.iter().enumerate().take(4) {\\n                    let done = if self.today_played.iter().any(|p| p == e.key()) { \\\" · done\\\" } else { \\\"\\\" };\\n                    v.push((100 + i as u16, format!(\\\"{}{done}\\\", e.title())));\\n                }\\n                if self.day_clear() {\\n                    v.push((ACT_END_DAY, \\\"End the day\\\".into()));\\n                }\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n            Flow::Result => vec![\\n                (ACT_RESULT_BACK, \\\"Back to the island\\\".into()),\\n                (ACT_RETRY, \\\"Retry\\\".into()),\\n            ],\\n            Flow::Together => vec![\\n                (ACT_G2, \\\"2 guests\\\".into()),\\n                (ACT_G3, \\\"3 guests\\\".into()),\\n                (ACT_G4, \\\"4 guests\\\".into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            Flow::Settings => self.settings_items(),\\n            Flow::Dev => self.dev_items(),\\n            Flow::Pause => vec![(ACT_RESUME, \\\"Resume\\\".into()), (ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => vec![(ACT_BACK, \\\"Back\\\".into())],\\n            Flow::Attract if self.touch_only => vec![(ACT_SETTINGS, \\\"Settings\\\".into())],\\n            Flow::Podium => vec![(ACT_BACK, \\\"Back to the title\\\".into())],\\n            _ => Vec::new(),\\n        }\\n    }\\n\\n    fn settings_items(&self) -> Vec<(u16, String)> {\\n        let m = self.settings.music;\\n        match self.page {\\n            0 => vec![\\n                (610, format!(\\\"Music {:.0}%\\\", m * 100.0)),\\n                (611, format!(\\\"Effects {:.0}%\\\", self.settings.sfx * 100.0)),\\n                (612, format!(\\\"Voices {:.0}%\\\", self.settings.voice * 100.0)),\\n                (ACT_XBOX, if self.settings.xbox { \\\"Glyphs: Xbox\\\" } else { \\\"Glyphs: PlayStation\\\" }.into()),\\n                (613, format!(\\\"Lean {:.0}%\\\", self.settings.sensitivity * 100.0)),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n            _ => vec![\\n                (614, format!(\\\"Wobble assist {:.0}%\\\", self.settings.wobble_assist * 100.0)),\\n                (615, \\\"Rhythm offset\\\".into()),\\n                (616, format!(\\\"Text {:.1}\\\", self.settings.text_speed)),\\n                (ACT_FULLSCREEN, if self.settings.fullscreen { \\\"Fullscreen on\\\" } else { \\\"Fullscreen off\\\" }.into()),\\n                (ACT_RESET_SAVE, if self.reset_arm { \\\"Confirm erase\\\" } else { \\\"Erase save\\\" }.into()),\\n                (ACT_BACK, \\\"Back\\\".into()),\\n            ],\\n        }\\n    }\\n\\n    fn dev_items(&self) -> Vec<(u16, String)> {\\n        match self.page {\\n            0 => vec![\\n                (ACT_RESUME, \\\"Resume\\\".into()),\\n                (ACT_DEV_RESET, \\\"Reset feel\\\".into()),\\n                (43, \\\"Wardrobe\\\".into()),\\n                (44, \\\"Calendar\\\".into()),\\n                (ACT_SETTINGS, \\\"Settings\\\".into()),\\n                (ACT_ABOUT, \\\"About\\\".into()),\\n            ],\\n            _ => {\\n                let mut rules = self.rules.clone();\\n                let infos = params::list(&mut rules);\\n                let start = (self.page - 1) * 4;\\n                let mut v: Vec<(u16, String)> = infos\\n                    .iter()\\n                    .enumerate()\\n                    .skip(start)\\n                    .take(4)\\n                    .map(|(i, info)| {\\n                        let label = match &info.value {\\n                            ParamValue::Float(f) => format!(\\\"{} {f:.2}\\\", info.path),\\n                            ParamValue::Int(n) => format!(\\\"{} {n}\\\", info.path),\\n                            _ => info.path.clone(),\\n                        };\\n                        (300 + i as u16, label)\\n                    })\\n                    .collect();\\n                v.push((ACT_BACK, \\\"Back\\\".into()));\\n                v\\n            }\\n        }\\n    }\\n\\n    fn start_activity(&mut self, kind: EventId, sim: &mut Sim) {\\n        if let Some(id) = self.ghost_id.take() {\\n            sim.despawn(id);\\n        }\\n        let rules = self.rules.clone();\\n        let mut act = Activity::start(kind, &rules, &mut sim.state.rng);\\n        if matches!(kind, EventId::Step | EventId::BigStand) {\\n            for n in &mut act.notes {\\n                n[0] += self.settings.rhythm_offset;\\n            }\\n        }\\n        self.bal = BalanceCore::default();\\n        self.bal.amp = self.rules.wobble * (1.0 - self.settings.wobble_assist).clamp(0.0, 1.0);\\n        self.bal.phase = [0, 1, 2, 3].map(|_| sim.state.rng.f32() * std::f32::consts::TAU);\\n        self.act = Some(act);\\n        self.score = 0.0;\\n        self.stars = 0;\\n        self.maybe_ghost(sim, kind);\\n    }\\n\\n    fn maybe_ghost(&mut self, sim: &mut Sim, kind: EventId) {\\n        if self.day < 3 || self.run != Run::Story {\\n            return;\\n        }\\n        let zone = zone_of(kind);\\n        let have = self.ghosts.keys().any(|k| EventId::from_key(k).map(zone_of) == Some(zone));\\n        if !have {\\n            return;\\n        }\\n        let feet = sim.state.spawn + Vec3::new(1.6, 0.0, 0.4);\\n        let id = sim.spawn_npc(\\\"yesterday\\\", feet, 0.0, PuppetDef::default(), None, None);\\n        self.ghost_id = Some(id);\\n    }\\n\\n    fn kind_now(&self) -> Option<EventId> {\\n        self.act.as_ref().map(|a| a.kind)\\n    }\\n\\n    fn finish_play(&mut self, sim: &mut Sim) {\\n        let Some(kind) = self.kind_now() else { return };\\n        self.score = self.act.as_ref().map(|a| a.score).unwrap_or(0.0);\\n        self.stars = self.act.as_ref().map(|a| a.stars).unwrap_or(0);\\n        if self.run == Run::Demo {\\n            return;\\n        }\\n        match self.run {\\n            Run::Direct => {\\n                self.bank(kind);\\n                self.flow = Flow::Result;\\n                self.focus = 0;\\n            }\\n            Run::Medley => {\\n                let i = self.medley_i as usize;\\n                if i < 3 {\\n                    self.hub_stats[i] = self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Event;\\n                } else {\\n                    self.hub_done = true;\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Together => {\\n                if let Some(slot) = self.together_scores.get_mut(self.together_i as usize) {\\n                    *slot += self.score;\\n                }\\n                self.medley_i += 1;\\n                if (self.medley_i as usize) < MEDLEY.len() {\\n                    let next = MEDLEY[self.medley_i as usize];\\n                    self.start_activity(next, sim);\\n                    self.flow = Flow::Card;\\n                    self.card_t = 0.0;\\n                } else if self.together_i + 1 < self.together_n {\\n                    self.together_i += 1;\\n                    self.medley_i = 0;\\n                    self.flow = Flow::Pass;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                } else {\\n                    self.podium = self\\n                        .together_names\\n                        .iter()\\n                        .cloned()\\n                        .zip(self.together_scores.iter().copied())\\n                        .collect();\\n                    self.podium.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));\\n                    self.flow = Flow::Podium;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Story => {\\n                if kind == EventId::Check {\\n                    self.skill = (self.score / 1000.0).clamp(0.0, 1.0);\\n                    self.age = balance_age(self.skill, self.days_completed, self.total_stars);\\n                    self.ages.push(self.age);\\n                    self.mark_played(kind);\\n                    self.flow = Flow::Reveal;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else if kind == EventId::BigStand {\\n                    self.bank(kind);\\n                    self.stamps = self.stamps.saturating_add(1);\\n                    self.ending = if self.age <= 40 { \\\"rowboat\\\" } else { \\\"extended\\\" }.into();\\n                    self.flow = Flow::Ending;\\n                    self.focus = 0;\\n                    self.line_i = 0;\\n                    self.touch_save();\\n                } else {\\n                    self.bank(kind);\\n                    self.flow = Flow::Result;\\n                    self.focus = 0;\\n                }\\n            }\\n            Run::Demo => {}\\n        }\\n    }\\n\\n    fn bank(&mut self, kind: EventId) {\\n        let first = !self.ever_played.iter().any(|k| k == kind.key());\\n        if self.run == Run::Story && !matches!(kind, EventId::Check | EventId::BigStand) {\\n            let add = if first { 1 + self.stars as u32 } else { 1 };\\n            self.day_minutes += add;\\n        }\\n        self.total_stars += self.stars as u32;\\n        self.mark_played(kind);\\n        if !matches!(kind, EventId::Check) && self.run == Run::Story {\\n            let key = kind.key().to_string();\\n            if !self.today_played.iter().any(|p| p == &key) {\\n                self.today_played.push(key);\\n            }\\n        }\\n        let key = kind.key().to_string();\\n        let best = self.bests.get(&key).copied().unwrap_or(0.0);\\n        if self.score >= best {\\n            self.bests.insert(key.clone(), self.score);\\n            if let Some(act) = &self.act {\\n                self.ghosts.insert(key, act.samples.clone());\\n            }\\n        }\\n        self.touch_save();\\n    }\\n\\n    fn mark_played(&mut self, kind: EventId) {\\n        let key = kind.key().to_string();\\n        if !self.ever_played.iter().any(|k| k == &key) {\\n            self.ever_played.push(key);\\n        }\\n    }\\n\\n    fn sleep_advance(&mut self) {\\n        if self.day <= 4 {\\n            self.stamps = self.stamps.saturating_add(1);\\n            self.days_completed += 1;\\n        }\\n        if self.day < 5 {\\n            self.day += 1;\\n        }\\n        self.day_minutes = 0;\\n        self.today_played.clear();\\n        self.touch_save();\\n        self.flow = Flow::Wake;\\n        self.line_i = 0;\\n        self.focus = 0;\\n    }\\n\\n    fn activate(&mut self, id: u16, sim: &mut Sim) {\\n        if id == ACT_BACK {\\n            self.go_back();\\n            return;\\n        }\\n        match self.flow {\\n            Flow::Title => match id {\\n                ACT_NEW => {\\n                    self.continuing = false;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_CONTINUE => {\\n                    self.continuing = true;\\n                    self.flow = Flow::Slots;\\n                    self.focus = 0;\\n                }\\n                ACT_TOGETHER => {\\n                    self.run = Run::Together;\\n                    self.flow = Flow::Together;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                ACT_HOWTO => {\\n                    self.return_flow = Flow::Title;\\n                    self.flow = Flow::HowTo;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Slots => {\\n                if (10..14).contains(&id) {\\n                    let i = (id - 10) as usize;\\n                    if self.continuing {\\n                        if self.slots.get(i).map(|s| s.used).unwrap_or(false) {\\n                            self.read_slot(i);\\n                        }\\n                    } else {\\n                        self.slot = i as u8;\\n                        self.reset_progress();\\n                        self.slot = i as u8;\\n                        self.flow = Flow::Name;\\n                        self.focus = 0;\\n                    }\\n                }\\n            }\\n            Flow::Name => {\\n                if let Some(n) = self.script().names.get((id as usize).saturating_sub(400)) {\\n                    self.name = n.clone();\\n                    self.flow = Flow::Look;\\n                    self.focus = 0;\\n                }\\n            }\\n            Flow::Look => {\\n                self.skin = id.saturating_sub(500) as u8;\\n                self.flow = Flow::Outfit;\\n                self.focus = 0;\\n            }\\n            Flow::Outfit => {\\n                self.outfit = id.saturating_sub(520) as u8;\\n                self.flow = Flow::Intro;\\n                self.line_i = 0;\\n                self.focus = 0;\\n                self.touch_save();\\n            }\\n            Flow::Schedule => {\\n                if id == ACT_END_DAY && self.day_clear() {\\n                    self.flow = Flow::Sleep;\\n                    self.line_i = 0;\\n                    self.focus = 0;\\n                } else if (100..180).contains(&id) {\\n                    let evs = self.schedule_events();\\n                    if let Some(kind) = evs.get((id - 100) as usize).copied() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                }\\n            }\\n            Flow::Result => {\\n                if id == ACT_RETRY {\\n                    if let Some(kind) = self.kind_now() {\\n                        self.start_activity(kind, sim);\\n                        self.flow = Flow::Card;\\n                        self.card_t = 0.0;\\n                    }\\n                } else {\\n                    self.after_result();\\n                }\\n            }\\n            Flow::Together => {\\n                let n = match id {\\n                    ACT_G2 => 2,\\n                    ACT_G3 => 3,\\n                    ACT_G4 => 4,\\n                    _ => 0,\\n                };\\n                if n > 0 {\\n                    self.begin_together(n);\\n                }\\n            }\\n            Flow::Dev => match id {\\n                ACT_RESUME | ACT_BACK => self.flow = self.paused_from,\\n                ACT_DEV_RESET => self.rules = Rules::default(),\\n                43 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Wardrobe;\\n                    self.focus = 0;\\n                }\\n                44 => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::Calendar;\\n                    self.focus = 0;\\n                }\\n                ACT_SETTINGS => self.open_settings(),\\n                ACT_ABOUT => {\\n                    self.return_flow = Flow::Dev;\\n                    self.flow = Flow::About;\\n                    self.about_page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Flow::Pause => {\\n                if id == ACT_RESUME {\\n                    self.flow = self.paused_from;\\n                } else if id == ACT_SETTINGS {\\n                    self.open_settings();\\n                }\\n            }\\n            Flow::Settings => self.activate_settings(id),\\n            Flow::Podium => {\\n                self.flow = Flow::Title;\\n                self.run = Run::Story;\\n                self.focus = 0;\\n            }\\n            Flow::About | Flow::HowTo | Flow::Wardrobe | Flow::Calendar => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn begin_together(&mut self, n: u8) {\\n        let names = self.script().names.clone();\\n        self.together_n = n.clamp(2, 4);\\n        self.together_i = 0;\\n        self.medley_i = 0;\\n        self.together_names = (0..self.together_n).map(|i| names.get(i as usize).cloned().unwrap_or_else(|| format!(\\\"Guest {}\\\", i + 1))).collect();\\n        self.together_scores = vec![0.0; self.together_n as usize];\\n        self.run = Run::Together;\\n        self.flow = Flow::Pass;\\n        self.focus = 0;\\n        self.line_i = 0;\\n    }\\n\\n    fn open_settings(&mut self) {\\n        self.return_flow = if self.flow == Flow::Settings { self.return_flow } else { self.flow };\\n        if self.flow == Flow::Attract {\\n            self.demo = false;\\n        }\\n        self.flow = Flow::Settings;\\n        self.page = 0;\\n        self.focus = 0;\\n        self.reset_arm = false;\\n    }\\n\\n    fn activate_settings(&mut self, id: u16) {\\n        match id {\\n            ACT_XBOX => self.settings.xbox = !self.settings.xbox,\\n            ACT_FULLSCREEN => self.settings.fullscreen = !self.settings.fullscreen,\\n            ACT_RESET_SAVE => {\\n                if self.reset_arm {\\n                    self.slots = vec![Slot::default(); 4];\\n                    self.reset_arm = false;\\n                    self.save_serial = self.save_serial.wrapping_add(1);\\n                } else {\\n                    self.reset_arm = true;\\n                }\\n            }\\n            ACT_BACK => self.go_back(),\\n            _ => {}\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n        self.focus = 0;\\n        self.flow = match self.flow {\\n            Flow::Slots | Flow::About | Flow::HowTo | Flow::Settings | Flow::Podium => {\\n                if self.flow == Flow::Settings || self.flow == Flow::About || self.flow == Flow::HowTo {\\n                    let back = self.return_flow;\\n                    if back == Flow::Attract {\\n                        self.demo = true;\\n                    }\\n                    if self.flow == Flow::Podium {\\n                        self.run = Run::Story;\\n                    }\\n                    back\\n                } else if self.flow == Flow::Podium {\\n                    self.run = Run::Story;\\n                    Flow::Title\\n                } else {\\n                    Flow::Title\\n                }\\n            }\\n            Flow::Schedule => Flow::Island,\\n            Flow::Wardrobe | Flow::Calendar => self.return_flow,\\n            Flow::Dev => self.paused_from,\\n            Flow::Name | Flow::Look | Flow::Outfit => Flow::Title,\\n            _ => Flow::Title,\\n        };\\n    }\\n\\n    fn after_result(&mut self) {\\n        self.focus = 0;\\n        if self.run == Run::Direct || self.hub_mode {\\n            return;\\n        }\\n        if self.run == Run::Together {\\n            return;\\n        }\\n        self.flow = Flow::Island;\\n    }\\n\\n    fn apply_slider(&mut self, id: u16, v: f32) {\\n        let v = v.clamp(0.0, 1.0);\\n        match id {\\n            610 => self.settings.music = v,\\n            611 => self.settings.sfx = v,\\n            612 => self.settings.voice = v,\\n            613 => self.settings.sensitivity = 0.5 + v,\\n            614 => self.settings.wobble_assist = v,\\n            615 => self.settings.rhythm_offset = (v - 0.5) * 0.1,\\n            616 => self.settings.text_speed = 0.5 + v * 1.5,\\n            _ => {}\\n        }\\n        if !(300..400).contains(&id) {\\n            return;\\n        }\\n        let mut rules = self.rules.clone();\\n        let infos = params::list(&mut rules);\\n        let Some(info) = infos.get((id - 300) as usize) else { return };\\n        let path = info.path.clone();\\n        let value = match info.kind.clone() {\\n            ParamKind::Float { min, max } => ParamValue::Float((min + v * (max - min)) as f64),\\n            ParamKind::Int { min, max } => ParamValue::Int((min as f32 + v * (max - min) as f32).round() as i64),\\n            _ => return,\\n        };\\n        let _ = params::set(&mut self.rules, &path, value);\\n    }\\n\\n    fn talk(&self) -> Vec<(String, String)> {\\n        let s = self.script();\\n        let pull = |speaker: &str, tag: &str| -> Vec<(String, String)> {\\n            let n = s.count(speaker, tag);\\n            (0..n).filter_map(|i| s.line(speaker, tag, i).map(|t| (speaker.to_string(), t.to_string()))).collect()\\n        };\\n        match self.flow {\\n            Flow::Intro => {\\n                let mut v = pull(\\\"Pip\\\", \\\"intro\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Welcome ashore. The mat remembers nothing yet.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Wake => {\\n                let mut v = Vec::new();\\n                if self.last_day > 0 && self.today > self.last_day {\\n                    let d = self.today - self.last_day;\\n                    v.push((\\\"Pip\\\".into(), format!(\\\"You were away {d} days. The mat kept your place.\\\")));\\n                }\\n                let tag = format!(\\\"wake{}\\\", self.day.min(5));\\n                v.extend(pull(\\\"Pip\\\", &tag));\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Morning. The deck is already warm.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Reveal => {\\n                let mut v = pull(\\\"Pip\\\", \\\"reveal\\\");\\n                v.insert(0, (\\\"Pip\\\".into(), format!(\\\"Balance Age {}. Lower means the mat was calmer.\\\", self.age)));\\n                v\\n            }\\n            Flow::Sleep => {\\n                let mut v = pull(\\\"Pip\\\", \\\"sleep\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Stamp the day. The hammock is already on your side.\\\".into()));\\n                }\\n                v\\n            }\\n            Flow::Ending => {\\n                let tag_line = if self.ending == \\\"rowboat\\\" {\\n                    \\\"The rowboat is ready. You may check out, or stay and play.\\\"\\n                } else {\\n                    \\\"The week would like a little more of you. The hammock agrees. This is the Extended Stay.\\\"\\n                };\\n                vec![(\\\"Pip\\\".into(), tag_line.into())]\\n            }\\n            Flow::Credits => {\\n                let mut v = pull(\\\"Pip\\\", \\\"credits\\\");\\n                if v.is_empty() {\\n                    v.push((\\\"Pip\\\".into(), \\\"Tippy Cay keeps the light on.\\\".into()));\\n                }\\n\",\"total_lines\":1928}}","is_error":false},{"type":"tool_result","tool_use_id":"call-94ac85f9-e7d8-429b-98fc-7343bf2262c6-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"280→    /// D-pad left (the game's map).\\n    pub map_pressed: bool,\\n    /// Buttons pressed since the last poll (menus read these as taps).\\n    pub taps: Vec<gilrs::Button>,\\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\\n    pub a_held: bool,\\n    pub x_held: bool,\\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\\n    pub y_held: bool,\\n    pub back_held: bool,\\n290→    pub any_activity: bool,\\n}\\n\\n/// One frame of stay input, after the stick, keys and mouse have been shaped.\\npub struct FitSample {\\n    pub lean: Vec2,\\n    pub device: u8,\\n    pub any: bool,\\n    pub ui: Option<pav_core::input::UiEvent>,\\n    pub extra: u32,\\n300→}\\n\\npub struct Input {\\n    pub keys: HashSet<KeyCode>,\\n    pub mouse: HashSet<MouseButton>,\\n    pub cursor: Vec2,\\n    pub mouse_active: bool,\\n    pub gilrs: Option<gilrs::Gilrs>,\\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\\n    pub pad_script: Option<PadScript>,\\n310→    pub pad: Pad,\\n    pub last_device: Device,\\n    prev_held: u32,\\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\\n    key_taps: HashSet<KeyCode>,\\n    pub mouse_taps: HashSet<MouseButton>,\\n    pub bindings: Bindings,\\n    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\\n    pub game: bool,\\n    /// Wobble Minutes is on screen. Bindings and the pad layout follow it.\\n320→    pub fit: bool,\\n    /// A key or a pad has been used. A coarse pointer stays touch-only until then.\\n    pub seen_real: bool,\\n    /// `matchMedia('(pointer: coarse)')` and no fine pointer.\\n    pub coarse: bool,\\n    lean_ramp: Vec2,\\n    lean_from: u8,\\n    mouse_travel: f32,\\n    have_cursor: bool,\\n    stick_y: f32,\\n330→    touch_tap: bool,\\n}\\n\\n/// A pad's raw state for one frame.\\nstruct PadState {\\n    left: Vec2,\\n    right: Vec2,\\n    held: Vec<gilrs::Button>,\\n    lt2: bool,\\n    rt2: bool,\\n340→}\\n\\n/// One line of a pad script: hold this for so many frames.\\n#[derive(Clone, Debug, Default)]\\npub struct PadStep {\\n    pub frames: u32,\\n    pub left: Vec2,\\n    pub right: Vec2,\\n    pub hold: Vec<gilrs::Button>,\\n    pub tap: Vec<gilrs::Button>,\\n350→}\\n\\n/// A scripted gamepad, one step per line:\\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\\n#[derive(Clone, Debug, Default)]\\npub struct PadScript {\\n    pub steps: Vec<PadStep>,\\n    at: usize,\\n360→    frame: u32,\\n}\\n\\nimpl PadScript {\\n    #[cfg_attr(target_arch = \\\"wasm32\\\", allow(dead_code))]\\n    pub fn parse(text: &str) -> Result<PadScript, String> {\\n        let button = |n: &str| -> Result<gilrs::Button, String> {\\n            use gilrs::Button as B;\\n            Ok(match n {\\n                \\\"South\\\" | \\\"A\\\" => B::South,\\n370→                \\\"East\\\" | \\\"B\\\" => B::East,\\n                \\\"West\\\" | \\\"X\\\" => B::West,\\n                \\\"North\\\" | \\\"Y\\\" => B::North,\\n                \\\"LeftTrigger\\\" | \\\"LB\\\" => B::LeftTrigger,\\n                \\\"RightTrigger\\\" | \\\"RB\\\" => B::RightTrigger,\\n                \\\"Start\\\" => B::Start,\\n                \\\"Select\\\" => B::Select,\\n                \\\"DPadUp\\\" => B::DPadUp,\\n                \\\"DPadDown\\\" => B::DPadDown,\\n                \\\"DPadLeft\\\" => B::DPadLeft,\\n380→                \\\"DPadRight\\\" => B::DPadRight,\\n                o => return Err(format!(\\\"unknown button '{o}'\\\")),\\n            })\\n        };\\n        let vec = |v: &str| -> Result<Vec2, String> {\\n            let (x, y) = v.split_once(',').ok_or(format!(\\\"'{v}': want x,y\\\"))?;\\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\\\"'{v}'\\\"))?, y.trim().parse().map_err(|_| format!(\\\"'{v}'\\\"))?))\\n        };\\n        let mut steps = Vec::new();\\n        for (n, line) in text.lines().enumerate() {\\n390→            let line = line.split('#').next().unwrap_or(\\\"\\\").trim();\\n            if line.is_empty() {\\n                continue;\\n            }\\n            let mut words = line.split_whitespace();\\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\\\"line {}: starts with a frame count\\\", n + 1))?;\\n            let mut st = PadStep { frames, ..Default::default() };\\n            for w in words {\\n                let (k, v) = w.split_once('=').ok_or(format!(\\\"line {}: '{w}'\\\", n + 1))?;\\n                match k {\\n400→                    \\\"left\\\" => st.left = vec(v)?,\\n                    \\\"right\\\" => st.right = vec(v)?,\\n                    \\\"hold\\\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\\n                    \\\"tap\\\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\\n                    o => return Err(format!(\\\"line {}: unknown '{o}'\\\", n + 1)),\\n                }\\n            }\\n            steps.push(st);\\n        }\\n        Ok(PadScript { steps, at: 0, frame: 0 })\\n410→    }\\n\\n    /// This frame's step (and whether it's the step's first frame); None when done.\\n    fn next(&mut self) -> Option<(PadStep, bool)> {\\n        let st = self.steps.get(self.at)?.clone();\\n        let first = self.frame == 0;\\n        self.frame += 1;\\n        if self.frame >= st.frames.max(1) {\\n            self.at += 1;\\n            self.frame = 0;\\n420→        }\\n        Some((st, first))\\n    }\\n}\\n\\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\\n    let l = v.length();\\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\\n}\\n\\n430→impl Input {\\n    pub fn new() -> Self {\\n        let gilrs = match gilrs::Gilrs::new() {\\n            Ok(g) => {\\n                for (_, gp) in g.gamepads() {\\n                    log::info!(\\\"gamepad: {} ({:?})\\\", gp.name(), gp.power_info());\\n                }\\n                Some(g)\\n            }\\n            Err(e) => {\\n440→                log::warn!(\\\"gamepads unavailable: {e}\\\");\\n                None\\n            }\\n        };\\n        Self {\\n            keys: HashSet::new(),\\n            mouse: HashSet::new(),\\n            cursor: Vec2::ZERO,\\n            mouse_active: false,\\n            gilrs,\\n450→            pad_script: None,\\n            pad: Pad::default(),\\n            // Pad glyphs until a key, a mouse move, or a stick is actually used.\\n            last_device: Device::Gamepad,\\n            prev_held: 0,\\n            key_taps: HashSet::new(),\\n            mouse_taps: HashSet::new(),\\n            bindings: Bindings::default(),\\n            game: false,\\n            fit: false,\\n460→            seen_real: false,\\n            coarse: false,\\n            lean_ramp: Vec2::ZERO,\\n            lean_from: 2,\\n            mouse_travel: 0.0,\\n            have_cursor: false,\\n            stick_y: 0.0,\\n            touch_tap: false,\\n        }\\n    }\\n470→\\n    pub fn note_pointer(&mut self, p: Vec2) {\\n        if self.have_cursor {\\n            self.mouse_travel += (p - self.cursor).length();\\n        } else {\\n            self.have_cursor = true;\\n        }\\n        self.cursor = p;\\n    }\\n\\n480→    pub fn mark_touch_tap(&mut self) {\\n        self.touch_tap = true;\\n    }\\n\\n    /// Lean, device and pointer for one stay frame. `items` are normalized rects.\\n    pub fn fit_sample(&mut self, dt: f32, size: Vec2, items: &[(u16, [f32; 4])], clicked: bool) -> FitSample {\\n        use pav_core::games::fit::intent::{key_ramp2, mouse_lean, shape_stick2};\\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c));\\n        let b = &self.bindings;\\n        let held_dir = Vec2::new(\\n490→            k(&b.right) as i32 as f32 - k(&b.left) as i32 as f32,\\n            k(&b.up) as i32 as f32 - k(&b.down) as i32 as f32,\\n        );\\n        let shift = self.held() & buttons::FOCUS != 0;\\n        let rate = if shift { 0.55 } else { 1.6 };\\n        self.lean_ramp = key_ramp2(self.lean_ramp, held_dir, dt, rate, 1.2);\\n        let stick = shape_stick2(self.pad.raw_left, 0.12, 1.5);\\n        if stick.length() > 0.05 {\\n            self.lean_from = 1;\\n            self.seen_real = true;\\n500→        }\\n        if held_dir.length() > 0.0 {\\n            self.lean_from = 2;\\n            self.seen_real = true;\\n        }\\n        if self.mouse_travel > 6.0 && !self.coarse {\\n            self.lean_from = 3;\\n        }\\n        let lean = match self.lean_from {\\n            1 => stick,\\n510→            3 => {\\n                let offset = Vec2::new(self.cursor.x - size.x * 0.5, size.y * 0.5 - self.cursor.y);\\n                mouse_lean(offset, size.y)\\n            }\\n            _ => self.lean_ramp,\\n        };\\n        let mut extra = 0u32;\\n        if stick.y > 0.55 && self.stick_y <= 0.55 {\\n            extra |= buttons::MENU_UP;\\n        }\\n520→        if stick.y < -0.55 && self.stick_y >= -0.55 {\\n            extra |= buttons::MENU_DOWN;\\n        }\\n        self.stick_y = stick.y;\\n        let mut ui = None;\\n        let travel = self.mouse_travel;\\n        self.mouse_travel = 0.0;\\n        let tap = clicked || self.touch_tap;\\n        self.touch_tap = false;\\n        if size.x > 1.0 && size.y > 1.0 {\\n530→            for (id, rect) in items {\\n                let x = rect[0] * size.x;\\n                let y = rect[1] * size.y;\\n                let w = rect[2] * size.x;\\n                let h = rect[3] * size.y;\\n                if self.cursor.x >= x && self.cursor.x <= x + w && self.cursor.y >= y && self.cursor.y <= y + h {\\n                    ui = Some(if tap { pav_core::input::UiEvent::Click(*id) } else { pav_core::input::UiEvent::Hover(*id) });\\n                }\\n            }\\n        }\\n540→        let device = if self.coarse && !self.seen_real {\\n            4\\n        } else if self.last_device == Device::Gamepad {\\n            1\\n        } else if self.lean_from == 3 {\\n            3\\n        } else if self.last_device == Device::Touch {\\n            4\\n        } else {\\n            2\\n550→        };\\n        let any = !self.coarse && (self.pad.any_activity || travel > 6.0 || stick.length() > 0.3 || lean.length() > 0.3);\\n        FitSample { lean, device, any, ui, extra }\\n    }\\n\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.seen_real = true;\\n        match state {\\n            ElementState::Pressed => {\",\"content_concise\":\"280→    /// D-pad left (the game's map).\\n    pub map_pressed: bool,\\n    /// Buttons pressed since the last poll (menus read these as taps).\\n    pub taps: Vec<gilrs::Button>,\\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\\n    pub a_held: bool,\\n    pub x_held: bool,\\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\\n    pub y_held: bool,\\n    pub back_held: bool,\\n290→    pub any_activity: bool,\\n}\\n\\n/// One frame of stay input, after the stick, keys and mouse have been shaped.\\npub struct FitSample {\\n    pub lean: Vec2,\\n    pub device: u8,\\n    pub any: bool,\\n    pub ui: Option<pav_core::input::UiEvent>,\\n    pub extra: u32,\\n300→}\\n\\npub struct Input {\\n    pub keys: HashSet<KeyCode>,\\n    pub mouse: HashSet<MouseButton>,\\n    pub cursor: Vec2,\\n    pub mouse_active: bool,\\n    pub gilrs: Option<gilrs::Gilrs>,\\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\\n    pub pad_script: Option<PadScript>,\\n310→    pub pad: Pad,\\n    pub last_device: Device,\\n    prev_held: u32,\\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\\n    key_taps: HashSet<KeyCode>,\\n    pub mouse_taps: HashSet<MouseButton