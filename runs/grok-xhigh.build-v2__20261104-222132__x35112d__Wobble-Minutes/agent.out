tent\":\"pub enum SimEvent {\"},{\"line_number\":212,\"content\":\"    Sfx {\"},{\"line_number\":218,\"content\":\"    Syllable {\"},{\"line_number\":224,\"content\":\"    Music {\"},{\"line_number\":228,\"content\":\"    BigSplash {\"},{\"line_number\":233,\"content\":\"    Wake {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa27-ba86-7730-89c2-9178ff908bce","uuid":"d8c7bc20-47a8-4661-8685-9a367353e04e"}
