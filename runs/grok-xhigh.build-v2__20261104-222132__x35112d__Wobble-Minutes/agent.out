337-4e50-9067-a2b661f92267-36","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→# Tippy Cay script. Speakers, preset names, titles, looks.\\nnames = [\\\"Avery\\\", \\\"Blair\\\", \\\"Casey\\\", \\\"Devon\\\", \\\"Eden\\\", \\\"Finley\\\", \\\"Gray\\\", \\\"Harper\\\", \\\"Indigo\\\", \\\"Jules\\\", \\\"Kai\\\", \\\"Lane\\\", \\\"Marlow\\\", \\\"Nico\\\", \\\"Oak\\\", \\\"Piper\\\", \\\"Quinn\\\", \\\"Reese\\\", \\\"Sage\\\", \\\"Tatum\\\", \\\"Umber\\\", \\\"Vesper\\\", \\\"Winter\\\", \\\"Yael\\\", \\\"Zephyr\\\", \\\"Ash\\\", \\\"Bay\\\", \\\"Cove\\\", \\\"Dell\\\", \\\"Echo\\\", \\\"Fern\\\", \\\"Glen\\\", \\\"Haze\\\", \\\"Isle\\\", \\\"Jory\\\", \\\"Kit\\\", \\\"Lark\\\", \\\"Moss\\\", \\\"Nell\\\", \\\"Orla\\\"]\\ntitles = [\\\"Human Soup\\\", \\\"Acceptable Human\\\", \\\"Certified Lean-To\\\", \\\"Wobble Enthusiast\\\", \\\"Seasoned Tilter\\\", \\\"Stillness Intern\\\", \\\"Professional Standing Person\\\", \\\"Alarmingly Balanced\\\", \\\"Soft Architecture\\\", \\\"Temporary Tower\\\", \\\"Polite Collapse\\\", \\\"Almost a Statue\\\", \\\"Guest of Gravity\\\", \\\"Mildly Vertical\\\", \\\"The Lean Years\\\", \\\"Upright Citizen\\\", \\\"Foam and Fortune\\\", \\\"Unbothered\\\", \\\"Quiet Furniture\\\", \\\"Balance Curious\\\", \\\"Practised Sway\\\", \\\"Harbour of Knees\\\", \\\"Steady Enough\\\", \\\"The Long Blink\\\", \\\"Kind to the Floor\\\", \\\"Not a Statue Yet\\\", \\\"Vertical-ish\\\", \\\"Champion of Standing Around\\\", \\\"Inner Puddle\\\", \\\"Buoyant Citizen\\\", \\\"Resort-Grade Upright\\\", \\\"Golden Pause\\\"]\\nskins = [\\\"Sand\\\", \\\"Seafoam\\\", \\\"Coral\\\", \\\"Dusk\\\", \\\"Foam\\\", \\\"Kelp\\\"]\\noutfits = [\\\"Linen\\\", \\\"Rash Guard\\\", \\\"Resort Stripe\\\", \\\"Evening\\\", \\\"Coach\\\", \\\"Guest\\\", \\\"Swim\\\", \\\"Golden\\\"]\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"intro\\\"\\n10→text = \\\"Welcome ashore. The mat remembers nothing yet.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"intro\\\"\\ntext = \\\"The deck is warm. You do not have to be.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"intro\\\"\\n20→text = \\\"Hold the rail if you like. It does not judge.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"intro\\\"\\ntext = \\\"Morning. I saved you the shady side of the board.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake1\\\"\\n30→text = \\\"Breathe like the tide is a suggestion, not a boss.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake1\\\"\\ntext = \\\"Your feet are doing a conversation. Let them finish.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake2\\\"\\n40→text = \\\"We measure balance here, and then we stop measuring.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake2\\\"\\ntext = \\\"A tip is a comma. The stay continues.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake3\\\"\\n50→text = \\\"Stars are compliments. Minutes are the rent.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake3\\\"\\ntext = \\\"The rowboat leaves when the week says you can stand in it.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake4\\\"\\n60→text = \\\"If the week is not finished with you, the hammock is.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake4\\\"\\ntext = \\\"I am a small coach with a large belief in standing.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake5\\\"\\n70→text = \\\"Posey will ask you to pose. The pose can be ordinary.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"wake5\\\"\\ntext = \\\"Kettle counts reps the way a kettle counts boils. Patiently, then suddenly.\\\"\\n\\n[[lines]]\\nspeaker = \\\"Pip\\\"\\ntag = \\\"sleep\\\"\\n80→text = \\\"Bounce thinks every heartbeat is a party invitation.\\\"\",\"content_concise\":\"1→# Tippy Cay script. Speakers, preset names, titles, looks.\\nnames = [\\\"Avery\\\", \\\"Blair\\\", \\\"Casey\\\", \\\"Devon\\\", \\\"Eden\\\", \\\"Finley\\\", \\\"Gray\\\", \\\"