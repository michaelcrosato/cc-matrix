{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"ls node_modules/@dimforge/rapier3d-compat && sed -n '1,15p' hub_harness_test.py && rg -n 'page|launch|route|webgpu|server' hub_harness_test.py\"","aggregated_output":"coarena.d.ts\ncontrol\ndynamics\nexports.d.ts\ngeometry\ninit.d.ts\nmath.d.ts\npackage.json\npipeline\nrapier.cjs\nrapier.cjs.map\nrapier.d.ts\nrapier.mjs\nrapier.mjs.map\nrapier_wasm3d.d.ts\nrapier_wasm3d.js\nrapier_wasm3d_bg.wasm\nrapier_wasm3d_bg.wasm.d.ts\nraw.d.ts\n\"\"\"Official AI Hub lifecycle checks for the final single HTML game.\n\nCan be imported by the main test command: run_harness(browser, base_url, game_url).\nCLI starts a private OS-selected loopback server and owns its complete lifecycle.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom threading import Thread\nfrom urllib.parse import urlencode\n4:CLI starts a private OS-selected loopback server and owns its complete lifecycle.\n12:from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\n23:    (\"dedicated-server\", {\"scenario\": \"server\"}),\n36:        page = context.new_page()\n38:        page.on(\"pageerror\", lambda error, captured=errors: captured.append(str(error)))\n50:            page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n51:            if \"AI Hub\" not in page.title():\n52:                raise AssertionError(f\"Unexpected harness page: {page.title()}\")\n53:            page.wait_for_function(\n56:            report = page.evaluate(\"window.__hubCheck\")\n74:                    f\"AI Hub {name} page error: {error}\" for error in errors\n79:                reports[name] = page.evaluate(\"window.__hubCheck || null\")\n108:    server = None\n112:        server = ThreadingHTTPServer(\n115:        Thread(target=server.serve_forever, daemon=True).start()\n116:        base_url = f\"http://127.0.0.1:{server.server_port}\"\n119:            browser = playwright.chromium.launch(\n122:                    \"--enable-unsafe-webgpu\",\n124:                    \"--use-webgpu-adapter=swiftshader\",\n143:        if server:\n144:            server.shutdown()\n145:            server.server_close()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"head -15 art.js && sed -n '28,95p' hub_harness_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"head -15 art.js && sed -n '28,95p' hub_harness_test.py\"","aggregated_output":"import * as THREE from 'three';\nimport { MeshStandardNodeMaterial } from 'three/webgpu';\nimport { normalWorld, vec3, color as nodeColor, float, step } from 'three/tsl';\n\n// Paper, lacquer and thick printer's ink: all geometry is authored in code.\nconst P = { ink: 0x152c38, navy: 0x214858, blue: 0x408ca0, mint: 0x9ed7c2, teal: 0x387d79, coral: 0xe77962, yellow: 0xf1c55b, cream: 0xfff2d5, white: 0xfff9e9, pink: 0xe9a0a0, wood: 0xbb7956, skin: 0xf2ba83, lilac: 0xa3a0cb };\nconst mats = new Map();\n// Three hard light bands retain the paper palette as figures turn in the mall.\n// Standard node lighting still supplies real scene shadows and emissive lamps.\nconst celFacing = normalWorld.dot(vec3(-.35, .82, .62).normalize()).mul(.5).add(.5);\nconst celBands = float(.66).add(step(.46, celFacing).mul(.20)).add(step(.74, celFacing).mul(.14));\nfunction mat(color, extra = {}) {\n  const key = JSON.stringify([color, extra]);\n  if (!mats.has(key)) {\n    const material = new MeshStandardNodeMaterial({ color, roughness: .92, metalness: 0, flatShading: true, ...extra });\n    \"\"\"Run official unmodified harness; return results without writing/printing.\"\"\"\n    from playwright.sync_api import Error as PlaywrightError\n\n    passed = 0\n    failures = []\n    reports = {}\n    for name, extra in scenarios:\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 800})\n        page = context.new_page()\n        errors = []\n        page.on(\"pageerror\", lambda error, captured=errors: captured.append(str(error)))\n        params = {\n            \"game\": game_url,\n            \"players\": 2,\n            \"auto\": 1,\n            \"play\": 6000,\n            \"limit\": 60,\n            \"seed\": 23831983,\n            **extra,\n        }\n        url = f\"{base_url.rstrip('/')}/{DEV.name}/harness.html?{urlencode(params)}\"\n        try:\n            page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n            if \"AI Hub\" not in page.title():\n                raise AssertionError(f\"Unexpected harness page: {page.title()}\")\n            page.wait_for_function(\n                \"document.body.dataset.complete === 'true'\", timeout=100000\n            )\n            report = page.evaluate(\"window.__hubCheck\")\n            reports[name] = report\n            if not report or not report.get(\"done\"):\n                failures.append(f\"AI Hub {name}: no completed harness report\")\n            else:\n                for check in report.get(\"checks\", []):\n                    if check.get(\"pass\"):\n                        passed += 1\n                    else:\n                        failures.append(\n                            f\"AI Hub {name}: {check.get('name')}: {check.get('detail')}\"\n                        )\n                if report.get(\"pass\") is not True and all(\n                    c.get(\"pass\") for c in report.get(\"checks\", [])\n                ):\n                    failures.append(f\"AI Hub {name}: overall pass is false\")\n            if errors:\n                failures.extend(\n                    f\"AI Hub {name} page error: {error}\" for error in errors\n                )\n        except (PlaywrightError, AssertionError) as error:\n            failures.append(f\"AI Hub {name}: {error}\")\n            try:\n                reports[name] = page.evaluate(\"window.__hubCheck || null\")\n            except PlaywrightError:\n                reports[name] = None\n        finally:\n            context.close()\n    return {\n        \"passed\": passed,\n        \"failed\": len(failures),\n        \"failures\": failures,\n        \"reports\": reports,\n    }\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='template.html';s=open(p).read().replace('\\\"three/tsl\\\":','\\\"three/webgpu\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/tsl\\\":');open(p,'w').write(s)\np='app.js';s=open(p).read().replace(\\\"else if(screen){if(e.code==='ArrowDown'\\\", \\\"else if(screen){if(e.code==='Enter')e.preventDefault();if(e.code==='ArrowDown'\\\");open(p,'w').write(s)\nPY\ncat > smoke.py <<'EOF'\nfrom pathlib import Path\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler,ThreadingHTTPServer\nfrom threading import Thread\nfrom playwright.sync_api import sync_playwright\nimport json\nD=Path(__file__).resolve().parent\nclass Quiet(SimpleHTTPRequestHandler):\n def log_message(self,*args):pass\ns=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(D.parent)))\nThread(target=s.serve_forever,daemon=True).start()\ntry:\n with sync_playwright() as p:\n  b=p.chromium.launch(args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n  c=b.new_context(ignore_https_errors=True,viewport={'width':1600,'height':1000})\n  pg=c.new_page();errors=[];logs=[]\n  pg.on('pageerror',lambda e:errors.append(str(e)))\n  pg.on('console',lambda e:logs.append(e.type+': '+e.text))\n  pg.goto(f'http://127.0.0.1:{s.server_port}/{D.name}.html',wait_until='domcontentloaded')\n  try:pg.wait_for_function('window.__game && window.__game.renderer.frames>3',timeout=90000)\n  except Exception as e:print('STARTUP FAILURE',str(e),pg.locator('#loading-text').inner_text())\n  print(json.dumps({'errors':errors,'logs':logs[-12:],'state':pg.evaluate('window.__game?{mode:__game.mode,screen:__game.screen,renderer:__game.renderer}:null')}))\n  pg.screenshot(path=str(D/'title.png'))\n  if pg.evaluate('\"'!!window.__game'\"'):\n   pg.click('[data-action=solo]');pg.wait_for_timeout(3500);pg.screenshot(path=str(D/'gameplay.png'))\n   print(json.dumps(pg.evaluate('({state:__game.state.mode,players:__game.state.players,audio:__game.audio.inspect()})')))\n  b.close()\nfinally:s.shutdown();s.server_close()\nEOF\npython3 build.py\n/home/micha/.local/share/pipx/venvs/playwright/bin/python smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
