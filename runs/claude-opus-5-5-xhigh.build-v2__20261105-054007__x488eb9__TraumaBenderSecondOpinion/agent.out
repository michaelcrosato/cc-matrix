\n    const fine = !!dev.fine, a = Cursor.assist(S, dev.assist), speedK = (dev.speed ?? 1) * (S && S.doctor === 'vale' ? 1.15 : 1);\n    if (dev.mouse) { c.x = dev.mouse[0]; c.y = dev.mouse[1]; c.vx = 0; c.vy = 0; c.mouseOn = true; }\n    else {\n      c.mouseOn = false;\n      const sx = dev.stick ? dev.stick[0] : 0, sy = dev.stick ? dev.stick[1] : 0, m = Math.min(1, Math.hypot(sx, sy));\n      let tx = 0, ty = 0;\n      if (m > 0) { const v = Math.pow(m, T.curve) * T.curSpeed * speedK * (fine ? T.fineK : 1) / m; tx = sx * v; ty = sy * v; }\n      if (dev.keys && (dev.keys[0] || dev.keys[1])) { const l = Math.hypot(dev.keys[0], dev.keys[1]) || 1; const v = T.keySpeed * speedK * (fine ? T.fineK : 1) / l; tx += dev.keys[0] * v; ty += dev.keys[1] * v; }\n      if (dev.nudge && (dev.nudge[0] || dev.nudge[1])) { tx += dev.nudge[0] * T.nudge; ty += dev.nudge[1] * T.nudge; }\n      if (S && h) {\n        // guide-follow: during a stroke or stitch the push across the guide is scaled down\n        const g = Cursor.guideAt(S, h, c);\n        if (g) {\n          const along = tx * g.tx + ty * g.ty, ax = g.tx * along, ay = g.ty * along, k = 1 - .8 * a;\n          tx = ax + (tx - ax) * k; ty = ay + (ty - ay) * k;\n          if (m > .05 || tx || ty) { tx += (g.x - c.x) * a * 8; ty += (g.y - c.y) * a * 8; }\n        } else if (!h.held) {\n          // magnet: near a valid target the stick slows, and at rest the cursor settles on it\n          const t = G.Op.magnetTarget(S, h.tool, c.x, c.y, T.magnetR, h);\n          if (t) {\n            const k = 1 - .55 * a; tx *= k; ty *= k;\n            if (m < .15 && !tx && !ty || (m < .15 && Math.hypot(tx, ty) < 6)) { const dx = t.x - c.x, dy = t.y - c.y, d = Math.hypot(dx, dy); if (d > .25) { const v = Math.min(90 * a, d / dt); tx += dx / d * v; ty += dy / d * v; } }\n          }\n        }\n      }\n      const r = Math.min(1, dt / T.curRamp); c.vx += (tx - c.vx) * r; c.vy += (ty - c.vy) * r;\n      c.x += c.vx * dt; c.y += c.vy * dt;\n    }\n    const W = dev.bounds ? dev.bounds[0] : G.FIELD_W, H = dev.bounds ? dev.bounds[1] : G.FIELD_H, ox = dev.bounds ? dev.bounds[2] : 0, oy = dev.bounds ? dev.bounds[3] : 0;\n    c.x = U.clamp(c.x, ox, ox + W); c.y = U.clamp(c.y, oy, oy + H);\n    c.loupeT = fine ? c.loupeT + dt : 0;\n  },\n  /** the guide under a stroke or a stitch: { x, y, tx, ty } the nearest point on it and its direction */\n  guideAt(S, h, c) {\n    if (h.stroke) { const g = G.Op.byId(S, h.stroke); if (!g) return null; const p = U.polyAt(g.pts, Math.min(g.len, g.prog + 6)), n = U.polyNear(g.pts, c.x, c.y, Math.max(0, g.prog - 8), g.prog + 18); return { x: n.x, y: n.y, tx: p.tx, ty: p.ty }; }\n    if (h.stitch) { const o = G.Op.byId(S, h.stitch.id); if (!o) return null; const st = G.Op.nextStitch(S, o); if (!st) return null; const a = h.stitch.from === 'a' ? st.a : st.b, b = h.stitch.from === 'a' ? st.b : st.a, dx = b[0] - a[0], dy = b[1] - a[1], l = Math.hypot(dx, dy) || 1, q = U.seg(c.x, c.y, a[0], a[1], b[0], b[1]); return { x: q.x, y: q.y, tx: dx / l, ty: dy / l }; }\n    return null;\n  },\n};\n\n// ------------------------------------------------------------------ the wheel\nconst SECTOR = (x, y) => { const a = Math.atan2(y, x) + Math.PI / 2 + Math.PI * 2 + Math.PI / 8; return Math.floor(a / (Math.PI / 4)) % 8; };   // 0 = north, clockwise\nconst Wheel = G.Wheel = {\n  SECTOR,\n  /**\n   * dev: { wheelStick: [x, y] (pad), step: -1 | 0 | 1, digit: 0..7 or -1, mouseHold: bool, mousePos: [x, y] }.\n   * Sets c.tool; c.wheelT is how long the ring keeps showing; c.wheelSector the highlighted one (for the HUD).\n   */\n  update(c, dev, dt) {\n    const tools = G.TOOLS, before = c.tool;\n    c.wheelT = Math.max(0, c.wheelT - dt);\n    const st = dev.wheelStick; const m = st ? Math.hypot(st[0], st[1]) : 0;\n    if (m > .6) {\n      const s = SECTOR(st[0], st[1]);\n      if (s !== c.wheelCand) { c.wheelCand = s; c.wheelCandT = 0; } else c.wheelCandT += dt;\n      c.wheelSector = s; c.wheelT = .3; c.wheelOut = true; c.ringFree = false;\n      if (c.wheelCandT >= .08 - 1e-6) c.tool = tools[s];\n    } else { if (m < .35) { c.wheelCand = -1; c.wheelOut = false; } }\n    if (dev.step) { const i = tools.indexOf(c.tool); c.tool = tools[(i + dev.step + 8) % 8]; c.wheelT = .5; c.wheelSector = tools.indexOf(c.tool); }\n    if (dev.digit >= 0 && dev.digit < 8) { c.tool = tools[dev.digit]; c.wheelT = .4; c.wheelSector = dev.digit; }\n    if (dev.mouseHold) {\n      if (!c.wheelHold) { c.wheelHold = 1; c.ringX = dev.mousePos[0]; c.ringY = dev.mousePos[1]; c.ringFree = true; }\n      const dx = dev.mousePos[0] - c.ringX, dy = dev.mousePos[1] - c.ringY; c.wheelT = .3;\n      if (Math.hypot(dx, dy) > 7) c.wheelSector = SECTOR(dx, dy); else c.wheelSector = tools.indexOf(c.tool);\n    } else if (c.wheelHold) {\n      c.wheelHold = 0; if (c.wheelSector >= 0) c.tool = tools[c.wheelSector]; c.wheelT = .3;\n    }\n    if (c.tool !== before) c.justSwapped = true;\n  },\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Lqnckb6rA4NaF6PBCDZzuN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjozozCd4GNgU66a9dTa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VCZ84HYup9YJsXS61sPzXD","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/bot/autosurgeon.js","content":"// One bot, three jobs (19.4): attract mode (cheats on), the scripted playthrough (cheats off), balance runs. It plays through a\n// virtual device fed to Cursor.update and Wheel.update, the same path as a pad. Each object type gives a plan as a generator.\n(() => {\nconst G = (window.GAME ||= {}), T = G.TUNING, U = G.U, OBJ = G.OBJ;\nconst Bot = G.Bot = {\n  plans: {},    // type -> function*(o, S, B)\n  /** skill: speed (u/s), react (s), aim (u of error), chain (keeps its plan going), breathAt etc. */\n  create(S, handI, o = {}) {\n    const skill = Object.assign({ speed: 330, react: 0, aim: 0, iv: 38, seed: 77, gifts: true }, o);\n    const B = { S, i: handI, c: G.Cursor.make(213, 116), skill, plan: null, planObj: 0, wait: 0, press: 0, stick: [0, 0], digit: -1, fine: false, gift: false, consult: false, cancel: false, shock: false, rng: skill.seed * 2654435761 >>> 0, tx: 213, ty: 116, stuck: 0, jobId: 0, lastRewinds: 0 };\n    Object.assign(B, botApi(B));\n    return B;\n  },\n  /** one step: returns the sim input for this hand */\n  step(B, S, dt) {\n    B.S = S; const h = S.hands[B.i];\n    B.stick = [0, 0]; B.digit = -1; B.gift = false; B.consult = false; B.cancel = false; B.fine = false;\n    if (S.status === 'code') { B.plan = null; Bot.code(B, S); }\n    else if (S.status === 'closing') { B.plan = null; Bot.closing(B, S); }\n    else if (S.status === 'play') {\n      if (S.stats.rewinds !== B.lastRewinds) { B.lastRewinds = S.stats.rewinds; B.plan = null; B.press = 0; }\n      Bot.think(B, S, h, dt);\n    } else { B.press = 0; }\n    const dev = { stick: B.stick, fine: B.fine, assist: B.skill.assist ?? .6, speed: B.skill.speed / T.curSpeed };\n    if (S.status === 'play' && h) G.Cursor.update(B.c, dev, S, h, dt); else if (B.moving) G.Cursor.update(B.c, dev, null, null, dt);\n    G.Wheel.update(B.c, { digit: B.digit, step: 0, wheelStick: null, mouseHold: false }, dt);\n    return { x: B.c.x, y: B.c.y, tool: B.c.tool, trig: B.press, fine: B.fine, gift: B.gift, consult: B.consult, cancel: B.cancel, shock: B.shock };\n  },\n  code(B, S) { const c = S.code, peak = c.k * T.codeEvery; B.shock = Math.abs(c.t - peak) < .02; },\n  closing(B, S) { const c = S.close; if (!c.done) { B.press = Math.abs(c.r - 12) < 1.2 ? 1 : 0; } else B.press = 0; B.shock = false; },\n  think(B, S, h, dt) {\n    B.shock = false;\n    if (B.wait > 0) { B.wait -= dt; return; }\n    // gifts, when they are asked for or when things are bad\n    if (B.skill.gifts) {\n      if (S.prompt === 'breath' && S.steady >= T.breathCost && !S.breath) B.gift = true;\n      else if (S.prompt === 'look' && G.Op.canLook(S)) B.gift = true;\n      else if (S.prompt === 'consult') B.consult = true;\n      else if (S.breath && !S.prompt && S.steady < 8) B.gift = true;\n    }\n    if (B.plan) {\n      const r = B.plan.next();\n      if (r.done) { B.plan = null; B.press = 0; if (B.skill.react) B.wait = B.skill.react; }\n      else return;\n    }\n    // panic button: the IV\n    if (S.vitals < B.skill.iv && !h.held && !h.stroke && !h.stitch) { B.plan = planIV(B, S); return; }\n    const job = G.Op.nextJob(S, h);\n    if (!job) { if (S.tut && S.tut.tool === 'syringe') B.plan = planIV(B, S); else if (S.phs && G.Op.phaseDef(S).clear && G.Op.phaseDef(S).clear.vitals && S.vitals < G.Op.phaseDef(S).clear.vitals) B.plan = planIV(B, S); else B.press = 0; return; }\n    const planFn = OBJ[job.o.type].bot || Bot.plans[job.tool + ':' + job.o.type] || Bot.plans[job.tool];\n    B.plan = planFn ? planFn(job.o, S, B, job) : null; B.jobId = job.o.id;\n  },\n};\n\n/** the plan API: moves through the virtual stick, with the human-like error in skill.aim */\nfunction botApi(B) { return {\n  *tool(id) { const i = G.TOOLS.indexOf(id); while (B.c.tool !== id || (B.S.hands[B.i] && B.S.hands[B.i].swap > 0)) { B.digit = i; yield; } },\n  /** steer toward a point (a moving target if x is a function) */\n  *moveTo(x, y, speed, tol = 1.5) { const err = B.skill.aim; let ex = 0, ey = 0; if (err) { const a = botRand(B) * Math.PI * 2, r = botRand(B) * err; ex = Math.cos(a) * r; ey = Math.sin(a) * r; } let guard = 0; for (;;) { const tx = (typeof x === 'function' ? x() : x) + ex, ty = (typeof y === 'function' ? y() : y) + ey, dx = tx - B.c.x, dy = ty - B.c.y, d = Math.hypot(dx, dy); if (d <= tol + err * .3 || guard++ > 480) return; B.steer(dx, dy, d, speed); yield; } },\n  steer(dx, dy, d, speed) { const v = Math.min(speed ?? B.skill.speed, d * 16), full = T.curSpeed * (B.skill.speed / T.curSpeed), m = Math.pow(Math.min(1, v / Math.max(1, full)), 1 / T.curve); B.stick = [dx / (d || 1) * m, dy / (d || 1) * m]; },\n  /** straight line at a speed, for strokes and pulls: press first */\n  *line(x, y, speed) { let guard = 0; for (;;) { const dx = x - B.c.x, dy = y - B.c.y, d = Math.hypot(dx, dy); if (d < 1.2 || guard++ > 900) return; B.steer(dx, dy, d, speed); yield; } },\n  *hold(secs) { let t = secs; while (t > 0) { t -= 1 / 120; yield; } },\n  press() { B.press = 1; },\n  release() { B.press = 0; },\n}; }\nfunction botRand(B) { B.rng = (B.rng + 0x6D2B79F5) | 0; let t = Math.imul(B.rng ^ (B.rng >>> 15), 1 | B.rng); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }\nfunction* planIV(B, S) { yield* B.tool('syringe'); B.press(); yield* B.hold(T.fillT + .03); B.release(); yield* B.hold(T.syrCool + .02); }\n\nconst P = Bot.plans;\nconst alive = (B, o) => { const q = G.Op.byId(B.S, o.id); return q && !q.done ? q : null; };\n/** the embedded pull */\nfunction* pull(o, S, B) {\n  yield* B.tool('forceps'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y);\n  B.press(); yield;\n  const p = q.pull, sp = Math.min(90, (p.max || T.tearSpeed) * .62);\n  if (!q.free) { const left = p.depth - p.prog + 3; yield* B.line(B.c.x + p.ax * left, B.c.y + p.ay * left, sp); yield; }\n  // carry it to the dish\n  const dx = q.x - (q.ox ?? q.x), dy = q.y - (q.oy ?? q.y), l = Math.hypot(dx, dy) || 1; const need = T.dishR + 3 - l;\n  if (need > 0) yield* B.line(B.c.x + dx / l * need, B.c.y + dy / l * need, 170);\n  yield; B.release(); yield; yield;\n}\nP.forceps = pull;\nP.scalpel = function* (o, S, B) {\n  yield* B.tool('scalpel'); const g = alive(B, o); if (!g) return;\n  if (g.type === 'guide') {\n    const a = U.polyAt(g.pts, g.prog); yield* B.moveTo(a.x, a.y); B.press(); yield;\n    let guard = 0;\n    while (alive(B, g) && guard++ < 3000) {\n      if (g.beatLock && B.S.beatV > .22) { yield; continue; }\n      const q = U.polyAt(g.pts, Math.min(g.len, g.prog + (g.beatLock ? 5 : 9))); const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); B.steer(dx, dy, d, g.beatLock ? 70 : 210); yield;\n    }\n    B.release(); yield;\n  } else yield* slash(g, B);\n};\nfunction* slash(o, B) {\n  const q = alive(B, o); if (!q) return; const dirX = Math.cos((q.id || 1) * 2.1), dirY = Math.sin((q.id || 1) * 2.1), r = (q.r || 4) + 18;\n  yield* B.moveTo(() => q.x - dirX * r, () => q.y - dirY * r, undefined, 3); B.press(); yield;\n  const ex = q.x + dirX * r, ey = q.y + dirY * r; yield* B.line(ex, ey, 240); B.release(); yield; yield;\n}\nBot.slash = slash;\nP.suture = function* (o, S, B) {\n  yield* B.tool('suture');\n  let guard = 0;\n  while (alive(B, o) && guard++ < 40) {\n    const st = G.Op.nextStitch(B.S, o); if (!st) break;\n    yield* B.moveTo(() => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[0] : B.c.x, () => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[1] : B.c.y, 240, 2); if (!alive(B, o)) break;\n    if (o.beatOnly) { while (B.S.beatP > .05 && B.S.beatP < .9) yield; }\n    B.press(); yield;\n    const end = () => G.Op.nextStitch(B.S, o); let g2 = 0;\n    for (;;) { const e = end(); if (!e || g2++ > 200) break; const dx = e.b[0] - B.c.x, dy = e.b[1] - B.c.y, d = Math.hypot(dx, dy); if (d < 1.8) break; B.steer(dx, dy, d, 130); yield; }\n    if (o.beatOnly) { let w = 0; while (B.S.beatV > .25 && w++ < 240) yield; }\n    B.release(); yield; yield;\n  }\n};\nP.salve = function* (o, S, B) {\n  yield* B.tool('salve'); const q = alive(B, o); if (!q) return;\n  const r = q.r || 8; yield* B.moveTo(q.x - r * .6, q.y - r * .6); B.press(); yield;\n  let guard = 0, row = 0;\n  while (alive(B, q) && guard++ < 600) {\n    if (q.cells) {\n      // go to the nearest cell left\n      const c = q.cells, x0 = q.x - c.w * 2, y0 = q.y - c.h * 2; let bx = 0, by = 0, bd = 1e9; for (let j = 0; j < c.h; j++) for (let i = 0; i < c.w; i++) if (c.g[j * c.w + i] === 0) { const x = x0 + (i + .5) * 4, y = y0 + (j + .5) * 4, d = U.dist(x, y, B.c.x, B.c.y); if (d < bd) { bd = d; bx = x; by = y; } }\n      if (bd > 1e8) break; const dx = bx - B.c.x, dy = by - B.c.y; if (bd > 1) B.steer(dx, dy, bd, 190);\n    } else { const dx = q.x - B.c.x, dy = q.y - B.c.y; B.steer(dx, dy, Math.hypot(dx, dy), 90); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.syringe = function* (o, S, B) {\n  yield* B.tool('syringe'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); B.press(); yield* B.hold(T.fillT + .02);\n  if (OBJ[q.type].doseWindow) { let w = 0; while (!OBJ[q.type].doseWindow(q, B.S) && w++ < 300) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 1) B.steer(dx, dy, d, 200); yield; } }\n  B.release(); yield; yield* B.hold(T.syrCool + .02);\n};\nP.cautery = function* (o, S, B) {\n  yield* B.tool('cautery'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); const h = () => B.S.hands[B.i];\n  while (h().lock > 0 || h().heat > .8) yield;\n  B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 720) {\n    if (!G.Op.valid(B.S, q, 'cautery', h()) && !OBJ[q.type].burnThrough) { if (h().down) break; }\n    const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > .6) B.steer(dx, dy, d, 300);\n    if (h().heat > .92) { B.release(); yield* B.hold(.4); B.press(); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.suction = function* (o, S, B) {\n  yield* B.tool('suction'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y, undefined, 4); B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 1200) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 3) B.steer(dx, dy, d, 120); yield; }\n  B.release(); yield;\n};\nP.sonar = function* (o, S, B) {\n  yield* B.tool('sonar'); const q = alive(B, o); if (!q) return;\n  B.press(); yield* B.moveTo(() => q.x, () => q.y, 260, 12); let guard = 0;\n  while (alive(B, q) && !(q.marked > 2) && guard++ < 120) yield;\n  B.release(); yield;\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12132,"cache_read_input_tokens":209441,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12132},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"eb8fea9d-f970-4710-b5b2-542c5d5677c0","timestamp":"2026-11-05T12:52:32.787Z","request_id":"req_011Cgjozohpcsi9fEashPxKo","wire_tool_inputs":{"toolu_01VCZ84HYup9YJsXS61sPzXD":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/bot/autosurgeon.js","content":"// One bot, three jobs (19.4): attract mode (cheats on), the scripted playthrough (cheats off), balance runs. It plays through a\n// virtual device fed to Cursor.update and Wheel.update, the same path as a pad. Each object type gives a plan as a generator.\n(() => {\nconst G = (window.GAME ||= {}), T = G.TUNING, U = G.U, OBJ = G.OBJ;\nconst Bot = G.Bot = {\n  plans: {},    // type -> function*(o, S, B)\n  /** skill: speed (u/s), react (s), aim (u of error), chain (keeps its plan going), breathAt etc. */\n  create(S, handI, o = {}) {\n    const skill = Object.assign({ speed: 330, react: 0, aim: 0, iv: 38, seed: 77, gifts: true }, o);\n    const B = { S, i: handI, c: G.Cursor.make(213, 116), skill, plan: null, planObj: 0, wait: 0, press: 0, stick: [0, 0], digit: -1, fine: false, gift: false, consult: false, cancel: false, shock: false, rng: skill.seed * 2654435761 >>> 0, tx: 213, ty: 116, stuck: 0, jobId: 0, lastRewinds: 0 };\n    Object.assign(B, botApi(B));\n    return B;\n  },\n  /** one step: returns the sim input for this hand */\n  step(B, S, dt) {\n    B.S = S; const h = S.hands[B.i];\n    B.stick = [0, 0]; B.digit = -1; B.gift = false; B.consult = false; B.cancel = false; B.fine = false;\n    if (S.status === 'code') { B.plan = null; Bot.code(B, S); }\n    else if (S.status === 'closing') { B.plan = null; Bot.closing(B, S); }\n    else if (S.status === 'play') {\n      if (S.stats.rewinds !== B.lastRewinds) { B.lastRewinds = S.stats.rewinds; B.plan = null; B.press = 0; }\n      Bot.think(B, S, h, dt);\n    } else { B.press = 0; }\n    const dev = { stick: B.stick, fine: B.fine, assist: B.skill.assist ?? .6, speed: B.skill.speed / T.curSpeed };\n    if (S.status === 'play' && h) G.Cursor.update(B.c, dev, S, h, dt); else if (B.moving) G.Cursor.update(B.c, dev, null, null, dt);\n    G.Wheel.update(B.c, { digit: B.digit, step: 0, wheelStick: null, mouseHold: false }, dt);\n    return { x: B.c.x, y: B.c.y, tool: B.c.tool, trig: B.press, fine: B.fine, gift: B.gift, consult: B.consult, cancel: B.cancel, shock: B.shock };\n  },\n  code(B, S) { const c = S.code, peak = c.k * T.codeEvery; B.shock = Math.abs(c.t - peak) < .02; },\n  closing(B, S) { const c = S.close; if (!c.done) { B.press = Math.abs(c.r - 12) < 1.2 ? 1 : 0; } else B.press = 0; B.shock = false; },\n  think(B, S, h, dt) {\n    B.shock = false;\n    if (B.wait > 0) { B.wait -= dt; return; }\n    // gifts, when they are asked for or when things are bad\n    if (B.skill.gifts) {\n      if (S.prompt === 'breath' && S.steady >= T.breathCost && !S.breath) B.gift = true;\n      else if (S.prompt === 'look' && G.Op.canLook(S)) B.gift = true;\n      else if (S.prompt === 'consult') B.consult = true;\n      else if (S.breath && !S.prompt && S.steady < 8) B.gift = true;\n    }\n    if (B.plan) {\n      const r = B.plan.next();\n      if (r.done) { B.plan = null; B.press = 0; if (B.skill.react) B.wait = B.skill.react; }\n      else return;\n    }\n    // panic button: the IV\n    if (S.vitals < B.skill.iv && !h.held && !h.stroke && !h.stitch) { B.plan = planIV(B, S); return; }\n    const job = G.Op.nextJob(S, h);\n    if (!job) { if (S.tut && S.tut.tool === 'syringe') B.plan = planIV(B, S); else if (S.phs && G.Op.phaseDef(S).clear && G.Op.phaseDef(S).clear.vitals && S.vitals < G.Op.phaseDef(S).clear.vitals) B.plan = planIV(B, S); else B.press = 0; return; }\n    const planFn = OBJ[job.o.type].bot || Bot.plans[job.tool + ':' + job.o.type] || Bot.plans[job.tool];\n    B.plan = planFn ? planFn(job.o, S, B, job) : null; B.jobId = job.o.id;\n  },\n};\n\n/** the plan API: moves through the virtual stick, with the human-like error in skill.aim */\nfunction botApi(B) { return {\n  *tool(id) { const i = G.TOOLS.indexOf(id); while (B.c.tool !== id || (B.S.hands[B.i] && B.S.hands[B.i].swap > 0)) { B.digit = i; yield; } },\n  /** steer toward a point (a moving target if x is a function) */\n  *moveTo(x, y, speed, tol = 1.5) { const err = B.skill.aim; let ex = 0, ey = 0; if (err) { const a = botRand(B) * Math.PI * 2, r = botRand(B) * err; ex = Math.cos(a) * r; ey = Math.sin(a) * r; } let guard = 0; for (;;) { const tx = (typeof x === 'function' ? x() : x) + ex, ty = (typeof y === 'function' ? y() : y) + ey, dx = tx - B.c.x, dy = ty - B.c.y, d = Math.hypot(dx, dy); if (d <= tol + err * .3 || guard++ > 480) return; B.steer(dx, dy, d, speed); yield; } },\n  steer(dx, dy, d, speed) { const v = Math.min(speed ?? B.skill.speed, d * 16), full = T.curSpeed * (B.skill.speed / T.curSpeed), m = Math.pow(Math.min(1, v / Math.max(1, full)), 1 / T.curve); B.stick = [dx / (d || 1) * m, dy / (d || 1) * m]; },\n  /** straight line at a speed, for strokes and pulls: press first */\n  *line(x, y, speed) { let guard = 0; for (;;) { const dx = x - B.c.x, dy = y - B.c.y, d = Math.hypot(dx, dy); if (d < 1.2 || guard++ > 900) return; B.steer(dx, dy, d, speed); yield; } },\n  *hold(secs) { let t = secs; while (t > 0) { t -= 1 / 120; yield; } },\n  press() { B.press = 1; },\n  release() { B.press = 0; },\n}; }\nfunction botRand(B) { B.rng = (B.rng + 0x6D2B79F5) | 0; let t = Math.imul(B.rng ^ (B.rng >>> 15), 1 | B.rng); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }\nfunction* planIV(B, S) { yield* B.tool('syringe'); B.press(); yield* B.hold(T.fillT + .03); B.release(); yield* B.hold(T.syrCool + .02); }\n\nconst P = Bot.plans;\nconst alive = (B, o) => { const q = G.Op.byId(B.S, o.id); return q && !q.done ? q : null; };\n/** the embedded pull */\nfunction* pull(o, S, B) {\n  yield* B.tool('forceps'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y);\n  B.press(); yield;\n  const p = q.pull, sp = Math.min(90, (p.max || T.tearSpeed) * .62);\n  if (!q.free) { const left = p.depth - p.prog + 3; yield* B.line(B.c.x + p.ax * left, B.c.y + p.ay * left, sp); yield; }\n  // carry it to the dish\n  const dx = q.x - (q.ox ?? q.x), dy = q.y - (q.oy ?? q.y), l = Math.hypot(dx, dy) || 1; const need = T.dishR + 3 - l;\n  if (need > 0) yield* B.line(B.c.x + dx / l * need, B.c.y + dy / l * need, 170);\n  yield; B.release(); yield; yield;\n}\nP.forceps = pull;\nP.scalpel = function* (o, S, B) {\n  yield* B.tool('scalpel'); const g = alive(B, o); if (!g) return;\n  if (g.type === 'guide') {\n    const a = U.polyAt(g.pts, g.prog); yield* B.moveTo(a.x, a.y); B.press(); yield;\n    let guard = 0;\n    while (alive(B, g) && guard++ < 3000) {\n      if (g.beatLock && B.S.beatV > .22) { yield; continue; }\n      const q = U.polyAt(g.pts, Math.min(g.len, g.prog + (g.beatLock ? 5 : 9))); const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); B.steer(dx, dy, d, g.beatLock ? 70 : 210); yield;\n    }\n    B.release(); yield;\n  } else yield* slash(g, B);\n};\nfunction* slash(o, B) {\n  const q = alive(B, o); if (!q) return; const dirX = Math.cos((q.id || 1) * 2.1), dirY = Math.sin((q.id || 1) * 2.1), r = (q.r || 4) + 18;\n  yield* B.moveTo(() => q.x - dirX * r, () => q.y - dirY * r, undefined, 3); B.press(); yield;\n  const ex = q.x + dirX * r, ey = q.y + dirY * r; yield* B.line(ex, ey, 240); B.release(); yield; yield;\n}\nBot.slash = slash;\nP.suture = function* (o, S, B) {\n  yield* B.tool('suture');\n  let guard = 0;\n  while (alive(B, o) && guard++ < 40) {\n    const st = G.Op.nextStitch(B.S, o); if (!st) break;\n    yield* B.moveTo(() => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[0] : B.c.x, () => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[1] : B.c.y, 240, 2); if (!alive(B, o)) break;\n    if (o.beatOnly) { while (B.S.beatP > .05 && B.S.beatP < .9) yield; }\n    B.press(); yield;\n    const end = () => G.Op.nextStitch(B.S, o); let g2 = 0;\n    for (;;) { const e = end(); if (!e || g2++ > 200) break; const dx = e.b[0] - B.c.x, dy = e.b[1] - B.c.y, d = Math.hypot(dx, dy); if (d < 1.8) break; B.steer(dx, dy, d, 130); yield; }\n    if (o.beatOnly) { let w = 0; while (B.S.beatV > .25 && w++ < 240) yield; }\n    B.release(); yield; yield;\n  }\n};\nP.salve = function* (o, S, B) {\n  yield* B.tool('salve'); const q = alive(B, o); if (!q) return;\n  const r = q.r || 8; yield* B.moveTo(q.x - r * .6, q.y - r * .6); B.press(); yield;\n  let guard = 0, row = 0;\n  while (alive(B, q) && guard++ < 600) {\n    if (q.cells) {\n      // go to the nearest cell left\n      const c = q.cells, x0 = q.x - c.w * 2, y0 = q.y - c.h * 2; let bx = 0, by = 0, bd = 1e9; for (let j = 0; j < c.h; j++) for (let i = 0; i < c.w; i++) if (c.g[j * c.w + i] === 0) { const x = x0 + (i + .5) * 4, y = y0 + (j + .5) * 4, d = U.dist(x, y, B.c.x, B.c.y); if (d < bd) { bd = d; bx = x; by = y; } }\n      if (bd > 1e8) break; const dx = bx - B.c.x, dy = by - B.c.y; if (bd > 1) B.steer(dx, dy, bd, 190);\n    } else { const dx = q.x - B.c.x, dy = q.y - B.c.y; B.steer(dx, dy, Math.hypot(dx, dy), 90); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.syringe = function* (o, S, B) {\n  yield* B.tool('syringe'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); B.press(); yield* B.hold(T.fillT + .02);\n  if (OBJ[q.type].doseWindow) { let w = 0; while (!OBJ[q.type].doseWindow(q, B.S) && w++ < 300) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 1) B.steer(dx, dy, d, 200); yield; } }\n  B.release(); yield; yield* B.hold(T.syrCool + .02);\n};\nP.cautery = function* (o, S, B) {\n  yield* B.tool('cautery'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); const h = () => B.S.hands[B.i];\n  while (h().lock > 0 || h().heat > .8) yield;\n  B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 720) {\n    if (!G.Op.valid(B.S, q, 'cautery', h()) && !OBJ[q.type].burnThrough) { if (h().down) break; }\n    const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > .6) B.steer(dx, dy, d, 300);\n    if (h().heat > .92) { B.release(); yield* B.hold(.4); B.press(); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.suction = function* (o, S, B) {\n  yield* B.tool('suction'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y, undefined, 4); B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 1200) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 3) B.steer(dx, dy, d, 120); yield; }\n  B.release(); yield;\n};\nP.sonar = function* (o, S, B) {\n  yield* B.tool('sonar'); const q = alive(B, o); if (!q) return;\n  B.press(); yield* B.moveTo(() => q.x, () => q.y, 260, 12); let guard = 0;\n  while (alive(B, q) && !(q.marked > 2) && guard++ < 120) yield;\n  B.release(); yield;\n};\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCZ84HYup9YJsXS61sPzXD","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/bot/autosurgeon.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"d8214cfa-094e-4776-9e5b-d306b386a994","timestamp":"2026-11-05T12:52:32.823Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/bot/autosurgeon.js","content":"// One bot, three jobs (19.4): attract mode (cheats on), the scripted playthrough (cheats off), balance runs. It plays through a\n// virtual device fed to Cursor.update and Wheel.update, the same path as a pad. Each object type gives a plan as a generator.\n(() => {\nconst G = (window.GAME ||= {}), T = G.TUNING, U = G.U, OBJ = G.OBJ;\nconst Bot = G.Bot = {\n  plans: {},    // type -> function*(o, S, B)\n  /** skill: speed (u/s), react (s), aim (u of error), chain (keeps its plan going), breathAt etc. */\n  create(S, handI, o = {}) {\n    const skill = Object.assign({ speed: 330, react: 0, aim: 0, iv: 38, seed: 77, gifts: true }, o);\n    const B = { S, i: handI, c: G.Cursor.make(213, 116), skill, plan: null, planObj: 0, wait: 0, press: 0, stick: [0, 0], digit: -1, fine: false, gift: false, consult: false, cancel: false, shock: false, rng: skill.seed * 2654435761 >>> 0, tx: 213, ty: 116, stuck: 0, jobId: 0, lastRewinds: 0 };\n    Object.assign(B, botApi(B));\n    return B;\n  },\n  /** one step: returns the sim input for this hand */\n  step(B, S, dt) {\n    B.S = S; const h = S.hands[B.i];\n    B.stick = [0, 0]; B.digit = -1; B.gift = false; B.consult = false; B.cancel = false; B.fine = false;\n    if (S.status === 'code') { B.plan = null; Bot.code(B, S); }\n    else if (S.status === 'closing') { B.plan = null; Bot.closing(B, S); }\n    else if (S.status === 'play') {\n      if (S.stats.rewinds !== B.lastRewinds) { B.lastRewinds = S.stats.rewinds; B.plan = null; B.press = 0; }\n      Bot.think(B, S, h, dt);\n    } else { B.press = 0; }\n    const dev = { stick: B.stick, fine: B.fine, assist: B.skill.assist ?? .6, speed: B.skill.speed / T.curSpeed };\n    if (S.status === 'play' && h) G.Cursor.update(B.c, dev, S, h, dt); else if (B.moving) G.Cursor.update(B.c, dev, null, null, dt);\n    G.Wheel.update(B.c, { digit: B.digit, step: 0, wheelStick: null, mouseHold: false }, dt);\n    return { x: B.c.x, y: B.c.y, tool: B.c.tool, trig: B.press, fine: B.fine, gift: B.gift, consult: B.consult, cancel: B.cancel, shock: B.shock };\n  },\n  code(B, S) { const c = S.code, peak = c.k * T.codeEvery; B.shock = Math.abs(c.t - peak) < .02; },\n  closing(B, S) { const c = S.close; if (!c.done) { B.press = Math.abs(c.r - 12) < 1.2 ? 1 : 0; } else B.press = 0; B.shock = false; },\n  think(B, S, h, dt) {\n    B.shock = false;\n    if (B.wait > 0) { B.wait -= dt; return; }\n    // gifts, when they are asked for or when things are bad\n    if (B.skill.gifts) {\n      if (S.prompt === 'breath' && S.steady >= T.breathCost && !S.breath) B.gift = true;\n      else if (S.prompt === 'look' && G.Op.canLook(S)) B.gift = true;\n      else if (S.prompt === 'consult') B.consult = true;\n      else if (S.breath && !S.prompt && S.steady < 8) B.gift = true;\n    }\n    if (B.plan) {\n      const r = B.plan.next();\n      if (r.done) { B.plan = null; B.press = 0; if (B.skill.react) B.wait = B.skill.react; }\n      else return;\n    }\n    // panic button: the IV\n    if (S.vitals < B.skill.iv && !h.held && !h.stroke && !h.stitch) { B.plan = planIV(B, S); return; }\n    const job = G.Op.nextJob(S, h);\n    if (!job) { if (S.tut && S.tut.tool === 'syringe') B.plan = planIV(B, S); else if (S.phs && G.Op.phaseDef(S).clear && G.Op.phaseDef(S).clear.vitals && S.vitals < G.Op.phaseDef(S).clear.vitals) B.plan = planIV(B, S); else B.press = 0; return; }\n    const planFn = OBJ[job.o.type].bot || Bot.plans[job.tool + ':' + job.o.type] || Bot.plans[job.tool];\n    B.plan = planFn ? planFn(job.o, S, B, job) : null; B.jobId = job.o.id;\n  },\n};\n\n/** the plan API: moves through the virtual stick, with the human-like error in skill.aim */\nfunction botApi(B) { return {\n  *tool(id) { const i = G.TOOLS.indexOf(id); while (B.c.tool !== id || (B.S.hands[B.i] && B.S.hands[B.i].swap > 0)) { B.digit = i; yield; } },\n  /** steer toward a point (a moving target if x is a function) */\n  *moveTo(x, y, speed, tol = 1.5) { const err = B.skill.aim; let ex = 0, ey = 0; if (err) { const a = botRand(B) * Math.PI * 2, r = botRand(B) * err; ex = Math.cos(a) * r; ey = Math.sin(a) * r; } let guard = 0; for (;;) { const tx = (typeof x === 'function' ? x() : x) + ex, ty = (typeof y === 'function' ? y() : y) + ey, dx = tx - B.c.x, dy = ty - B.c.y, d = Math.hypot(dx, dy); if (d <= tol + err * .3 || guard++ > 480) return; B.steer(dx, dy, d, speed); yield; } },\n  steer(dx, dy, d, speed) { const v = Math.min(speed ?? B.skill.speed, d * 16), full = T.curSpeed * (B.skill.speed / T.curSpeed), m = Math.pow(Math.min(1, v / Math.max(1, full)), 1 / T.curve); B.stick = [dx / (d || 1) * m, dy / (d || 1) * m]; },\n  /** straight line at a speed, for strokes and pulls: press first */\n  *line(x, y, speed) { let guard = 0; for (;;) { const dx = x - B.c.x, dy = y - B.c.y, d = Math.hypot(dx, dy); if (d < 1.2 || guard++ > 900) return; B.steer(dx, dy, d, speed); yield; } },\n  *hold(secs) { let t = secs; while (t > 0) { t -= 1 / 120; yield; } },\n  press() { B.press = 1; },\n  release() { B.press = 0; },\n}; }\nfunction botRand(B) { B.rng = (B.rng + 0x6D2B79F5) | 0; let t = Math.imul(B.rng ^ (B.rng >>> 15), 1 | B.rng); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }\nfunction* planIV(B, S) { yield* B.tool('syringe'); B.press(); yield* B.hold(T.fillT + .03); B.release(); yield* B.hold(T.syrCool + .02); }\n\nconst P = Bot.plans;\nconst alive = (B, o) => { const q = G.Op.byId(B.S, o.id); return q && !q.done ? q : null; };\n/** the embedded pull */\nfunction* pull(o, S, B) {\n  yield* B.tool('forceps'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y);\n  B.press(); yield;\n  const p = q.pull, sp = Math.min(90, (p.max || T.tearSpeed) * .62);\n  if (!q.free) { const left = p.depth - p.prog + 3; yield* B.line(B.c.x + p.ax * left, B.c.y + p.ay * left, sp); yield; }\n  // carry it to the dish\n  const dx = q.x - (q.ox ?? q.x), dy = q.y - (q.oy ?? q.y), l = Math.hypot(dx, dy) || 1; const need = T.dishR + 3 - l;\n  if (need > 0) yield* B.line(B.c.x + dx / l * need, B.c.y + dy / l * need, 170);\n  yield; B.release(); yield; yield;\n}\nP.forceps = pull;\nP.scalpel = function* (o, S, B) {\n  yield* B.tool('scalpel'); const g = alive(B, o); if (!g) return;\n  if (g.type === 'guide') {\n    const a = U.polyAt(g.pts, g.prog); yield* B.moveTo(a.x, a.y); B.press(); yield;\n    let guard = 0;\n    while (alive(B, g) && guard++ < 3000) {\n      if (g.beatLock && B.S.beatV > .22) { yield; continue; }\n      const q = U.polyAt(g.pts, Math.min(g.len, g.prog + (g.beatLock ? 5 : 9))); const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); B.steer(dx, dy, d, g.beatLock ? 70 : 210); yield;\n    }\n    B.release(); yield;\n  } else yield* slash(g, B);\n};\nfunction* slash(o, B) {\n  const q = alive(B, o); if (!q) return; const dirX = Math.cos((q.id || 1) * 2.1), dirY = Math.sin((q.id || 1) * 2.1), r = (q.r || 4) + 18;\n  yield* B.moveTo(() => q.x - dirX * r, () => q.y - dirY * r, undefined, 3); B.press(); yield;\n  const ex = q.x + dirX * r, ey = q.y + dirY * r; yield* B.line(ex, ey, 240); B.release(); yield; yield;\n}\nBot.slash = slash;\nP.suture = function* (o, S, B) {\n  yield* B.tool('suture');\n  let guard = 0;\n  while (alive(B, o) && guard++ < 40) {\n    const st = G.Op.nextStitch(B.S, o); if (!st) break;\n    yield* B.moveTo(() => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[0] : B.c.x, () => G.Op.nextStitch(B.S, o) ? G.Op.nextStitch(B.S, o).a[1] : B.c.y, 240, 2); if (!alive(B, o)) break;\n    if (o.beatOnly) { while (B.S.beatP > .05 && B.S.beatP < .9) yield; }\n    B.press(); yield;\n    const end = () => G.Op.nextStitch(B.S, o); let g2 = 0;\n    for (;;) { const e = end(); if (!e || g2++ > 200) break; const dx = e.b[0] - B.c.x, dy = e.b[1] - B.c.y, d = Math.hypot(dx, dy); if (d < 1.8) break; B.steer(dx, dy, d, 130); yield; }\n    if (o.beatOnly) { let w = 0; while (B.S.beatV > .25 && w++ < 240) yield; }\n    B.release(); yield; yield;\n  }\n};\nP.salve = function* (o, S, B) {\n  yield* B.tool('salve'); const q = alive(B, o); if (!q) return;\n  const r = q.r || 8; yield* B.moveTo(q.x - r * .6, q.y - r * .6); B.press(); yield;\n  let guard = 0, row = 0;\n  while (alive(B, q) && guard++ < 600) {\n    if (q.cells) {\n      // go to the nearest cell left\n      const c = q.cells, x0 = q.x - c.w * 2, y0 = q.y - c.h * 2; let bx = 0, by = 0, bd = 1e9; for (let j = 0; j < c.h; j++) for (let i = 0; i < c.w; i++) if (c.g[j * c.w + i] === 0) { const x = x0 + (i + .5) * 4, y = y0 + (j + .5) * 4, d = U.dist(x, y, B.c.x, B.c.y); if (d < bd) { bd = d; bx = x; by = y; } }\n      if (bd > 1e8) break; const dx = bx - B.c.x, dy = by - B.c.y; if (bd > 1) B.steer(dx, dy, bd, 190);\n    } else { const dx = q.x - B.c.x, dy = q.y - B.c.y; B.steer(dx, dy, Math.hypot(dx, dy), 90); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.syringe = function* (o, S, B) {\n  yield* B.tool('syringe'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); B.press(); yield* B.hold(T.fillT + .02);\n  if (OBJ[q.type].doseWindow) { let w = 0; while (!OBJ[q.type].doseWindow(q, B.S) && w++ < 300) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 1) B.steer(dx, dy, d, 200); yield; } }\n  B.release(); yield; yield* B.hold(T.syrCool + .02);\n};\nP.cautery = function* (o, S, B) {\n  yield* B.tool('cautery'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y); const h = () => B.S.hands[B.i];\n  while (h().lock > 0 || h().heat > .8) yield;\n  B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 720) {\n    if (!G.Op.valid(B.S, q, 'cautery', h()) && !OBJ[q.type].burnThrough) { if (h().down) break; }\n    const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > .6) B.steer(dx, dy, d, 300);\n    if (h().heat > .92) { B.release(); yield* B.hold(.4); B.press(); }\n    yield;\n  }\n  B.release(); yield;\n};\nP.suction = function* (o, S, B) {\n  yield* B.tool('suction'); const q = alive(B, o); if (!q) return;\n  yield* B.moveTo(() => q.x, () => q.y, undefined, 4); B.press(); let guard = 0;\n  while (alive(B, q) && guard++ < 1200) { const dx = q.x - B.c.x, dy = q.y - B.c.y, d = Math.hypot(dx, dy); if (d > 3) B.steer(dx, dy, d, 120); yield; }\n  B.release(); yield;\n};\nP.sonar = function* (o, S, B) {\n  yield* B.tool('sonar'); const q = alive(B, o); if (!q) return;\n  B.press(); yield* B.moveTo(() => q.x, () => q.y, 260, 12); let guard = 0;\n  while (alive(B, q) && !(q.marked > 2) && guard++ < 120) yield;\n  B.release(); yield;\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01VCZ84HYup9YJsXS61sPzXD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
