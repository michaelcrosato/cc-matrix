 const c = G.CAST[id] || G.CAST.quill, key = id + '|' + (o.expr || 'neutral') + '|' + (o.blink > .5 ? 1 : 0) + '|' + (o.talk > .5 ? 1 : 0) + '|' + (o.maskUp ? 1 : 0) + '|' + (o.look || 0);\n  let cv = CACHE.get(key);\n  if (!cv) { cv = E.mkCanvas(W, H); const g = cv.getContext('2d'); if (c.hat0) c.hat0(g); drawBust(g, c, o); if (c.extra) c.extra(g, c, o); E.px.reset(g); CACHE.set(key, cv); }\n  return cv;\n};\nG.BUST_W = W; G.BUST_H = H;\n})();\n\"\"\"\ndev='TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/'\nopen(dev+'src/art/bust.js','w').write(out)\nopen(dev+'notes/tmp/cast4.txt','w').write(cast)\nEOF\nsed -n 1,4p TraumaBender*/notes/tmp/cast4.txt | cut -c1-200","description":"Copy the bust painter from the plan and extend its expressions"}}}
