ked = !!c.mask; }\n    if (c.speak !== undefined) { this.speaker = c.speak; if (c.speak && c.expr) { const a = this.actors[c.speak]; if (a) { if (c.expr === 'shock' && a.expr !== 'shock') a.shake = .3; a.expr = c.expr; } } if (c.speak && this.actors[c.speak] === undefined && G.CAST[c.speak]) { this.actors[c.speak] = { id: c.speak, side: G.CAST[c.speak].side || 'right', expr: c.expr || 'neutral', masked: false, x: G.CAST[c.speak].side === 'left' ? -130 : G.game.W + 20, shake: 0, off: false }; } }\n    if (c.sfx) G.Sfx[c.sfx] && G.Sfx[c.sfx]();\n    if (c.shake) { G.game.shake(c.shake); for (const k in this.actors) this.actors[k].shake = .3; }\n    if (c.flash) G.game.flash(c.flash, .25);\n    if (c.set) G.Flow.setFlag(c.set);\n    if (c.card) { this.card = { big: c.card[0], small: c.card[1], t: 0 }; G.Sfx.foghorn(); }\n    else if (c.cine) { if (G.Cine && G.Cine.has(c.cine) && !this.story.skip) { this.cine = G.Cine.start(c.cine, () => { this.cine = null; this.story.resume(); }); } else this.story.resume(); }\n    else if (c.wait) { this.waitT = c.wait; }\n  },\n  update(dt) {\n    const game = G.game, I = game.input, st = this.story; this.t += dt; game.focus(game.W / 2, game.H / 2, 0);\n    this.flash = Math.max(0, this.flash - dt);\n    for (const k in this.actors) { const a = this.actors[k], tx = a.off ? (a.side === 'left' ? -130 : game.W + 20) : a.side === 'left' ? Math.max(8, game.W * .07 | 0) : a.side === 'mid' ? game.W / 2 - 56 : game.W - 112 - Math.max(8, game.W * .07 | 0); a.x += (tx - a.x) * Math.min(1, dt * 11); a.shake = Math.max(0, a.shake - dt); if (a.off && Math.abs(a.x - tx) < 2) delete this.actors[k]; }\n    if (this.ended) { const f = this.d.onDone; this.ended = false; if (f) f(); else G.Flow.advance(); return; }\n    if (this.cine) { this.cine.update(dt); return; }\n    if (this.card) { const c = this.card; c.t += dt; if ((c.t > .5 && (I.pressed('confirm') || I.clicked() || I.pressed('skip'))) || c.t > 3.2 || st.skip) { this.card = null; st.resume(); } return; }\n    if (this.waitT > 0) { this.waitT -= dt; if (this.waitT <= 0) { this.waitT = 0; st.resume(); } return; }\n    if (this.logOpen) { if (I.pressed('log') || I.pressed('cancel')) this.logOpen = false; if (I.repeat('up')) this.logI = Math.min(st.log.length - 1, this.logI + 1); if (I.repeat('down')) this.logI = Math.max(0, this.logI - 1); return; }\n    if (I.pressed('log') && !this.d.auto) { this.logOpen = true; this.logI = 0; return; }\n    st.skip = I.down('skip') && !this.d.auto;\n    st.update(dt);\n  },\n  draw(r) {\n    const W = r.W, H = r.H, game = G.game;\n    if (this.cine) { this.cine.draw(r); return; }\n    G.Stage.draw(r, this.stage, this.t);\n    r.overlay(g => {\n      const talkOn = this.story.talk.open && this.story.talk.typing, blink = (this.t % 3.7) < .12;\n      const y0 = H - 128 - 8;\n      const order = Object.values(this.actors).sort((a, b) => (a.id === this.speaker) - (b.id === this.speaker));\n      for (const a of order) {\n        const sp = a.id === this.speaker, cv = G.bust(a.id, { expr: a.expr, blink: blink ? 1 : 0, talk: sp && talkOn && (this.t * 11 | 0) % 2 === 0 ? 1 : 0, maskUp: a.masked, look: sp ? 0 : a.side === 'left' ? 1 : -1 });\n        const bob = sp && talkOn ? Math.round(Math.abs(Math.sin(this.t * 9)) * 2) : 0, sh = a.shake > 0 ? Math.round(Math.sin(this.t * 80) * 3) : 0, x = Math.round(a.x + sh), y = y0 - bob + (sp ? 0 : 3);\n        if (g.drawImage) { g.imageSmoothingEnabled = false; g.drawImage(cv, x, y); px.reset(g); }\n        if (!sp && this.speaker) px.blend(g, .001, 'normal', () => {});\n      }\n      if (this.story.talk.open) { const lw = Glyph.width(game.input, 'skip'); Glyph.action(g, game.input, 'skip', W - lw - 72, 5); Pix.text(g, 'Hold: fast', W - 69, 6, '#a8c8c0'); }\n      this.story.draw(r);\n      if (this.card) { px.blend(g, .85, 'normal', () => px.rect(g, 0, H / 2 - 42, W, 84, '#04121a')); px.rect(g, 0, H / 2 - 43, W, 1, '#4fd0c4'); px.rect(g, 0, H / 2 + 42, W, 1, '#4fd0c4'); E.font.text(g, this.card.big, W / 2, H / 2 - 30, '#ffd36a', { align: 'center', scale: 2, outline: false, shadow: '#000' }); E.font.text(g, this.card.small, W / 2, H / 2 - 6, '#ffffff', { align: 'center', scale: 3, outline: false, shadow: '#000' }); }\n      if (this.logOpen) this.drawLog(g, W, H);\n      if (this.d.ribbon) G.HUD.ribbon(g, W, H, { t: this.t });\n    });\n  },\n  drawLog(g, W, H) {\n    px.blend(g, .92, 'normal', () => px.rect(g, 0, 0, W, H, '#04121a')); Pix.text(g, 'BACKLOG', W / 2, 8, '#ffd36a', { align: 'center' });\n    const L = this.story.log, rows = Math.floor((H - 40) / 20); let y = H - 26; for (let i = L.length - 1 - this.logI, n = 0; i >= 0 && n < rows; i--, n++) { const e = L[i], lines = E.font.wrap(e.text, W - 100); y -= lines.length * 9 + 3; lines.forEach((l, k) => Pix.text(g, l, 88, y + k * 9, e.who === 'choice' ? '#9fffc0' : '#ffffff')); if (e.name) Pix.text(g, e.name.slice(0, 13), 8, y, '#ffd36a'); }\n    Pix.text(g, 'Up and down to read, back to return', W / 2, H - 12, '#8fb8b0', { align: 'center' });\n  },\n};\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014fuxCdCS855Lj4ZzeczzwU","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/scenes/story.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"16761f96-48e9-46cc-a6be-74980578f081","timestamp":"2026-11-05T13:12:40.248Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/scenes/story.js","content":"// The story scene: painted stages, large busts, typed lines with gibberish voices. Content is data: defStory(id, steps) (CONTENT.md).\n// A step: [who, line, expr?], or { stage, music, enter: [[id, side, expr, masked]], leave, expr: [id, expr], choose: [..], replies: [[who, line], ..],\n// card: [big, small], cine: id, narr: line, sfx, shake, flash, wait, set }.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px } = E, Pix = G.Pix, Glyph = G.Glyph;\nconst SRC = G.STORIES = {}, NODES = G.STORY_NODES = {};\nG.EXPRS = ['neutral', 'smile', 'angry', 'sad', 'shock', 'shout', 'smirk', 'tired', 'cry'];\nG.defStory = (id, steps) => { SRC[id] = steps; const out = []; let n = 0;\n  for (const s of steps) {\n    if (Array.isArray(s)) { const [who, say, expr] = s; out.push({ event: 'cue', cue: { speak: who, expr } }); out.push({ who, say }); }\n    else if (s.choose) { const k = '_r' + (n++); out.push({ who: s.who || 'vale', say: s.prompt || '...', choices: s.choose.map((text, i) => ({ text, set: { [k]: i } })) }); s.replies.forEach((r, i) => { out.push({ if: k + ' == ' + i, event: 'cue', cue: { speak: r[0], expr: r[2] } }); out.push({ if: k + ' == ' + i, who: r[0], say: r[1] }); }); }\n    else if (s.narr) { out.push({ event: 'cue', cue: { speak: null } }); out.push({ say: s.narr }); }\n    else if (s.card || s.cine || s.wait) out.push({ event: 'cue', wait: true, cue: s });\n    else out.push({ event: 'cue', cue: s });\n  }\n  NODES[id] = out; };\n\nconst Scene = G.StoryScene = {\n  get() {\n    if (G.story) return G.story; const game = G.game, people = {}; for (const k in G.CAST) people[k] = { name: G.CAST[k].name };\n    const talk = new E.Dialog(game, { lines: 2, width: Math.min(404, game.W - 16), bg: '#06181c', border: '#4fd0c4', nameColor: '#ffd36a', speed: 52, voice: (ch, i, t) => { const sc = game.scene; if (sc && sc.speaker) G.Babble.letter(sc.speaker, ch, i, t._page ? t._page.join(' ') : ''); } });\n    G.story = new E.Story(game, { people, nodes: NODES, dialog: talk, on: { cue(st, step) { const sc = G.game.scene; if (sc && sc.cue) sc.cue(step.cue, step.wait); else if (step.wait) st.resume(); } } });\n    return G.story;\n  },\n};\nG.scenes = G.scenes || {};\nG.scenes.story = {\n  pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(data = {}) {\n    const game = G.game; this.d = data; this.t = 0; this.stage = data.stage || 'corridor'; this.actors = {}; this.speaker = null; this.card = null; this.logOpen = false; this.logI = 0; this.cine = null; this.ended = false; this.flash = 0; this.shakeT = 0; this.blinkT = 2;\n    const st = this.story = Scene.get(); st.talk.width = Math.min(404, game.W - 16); st.talk.speed = { slow: 30, normal: 52, fast: 96 }[game.settings.textSpeed] || 52; st._speed = st.talk.speed; st.auto = data.auto || 0; st.skip = false;\n    if (game.saves) game.saves.canSave = false;\n    game.setView && game.setView('overhead'); game.focus(game.W / 2, game.H / 2, 0);\n    this.startNode(data.node);\n  },\n  startNode(id) { this.node = id; this.story.run(id, { onDone: () => { this.ended = true; } }); },\n  cue(c, held) {\n    if (c.stage) this.stage = c.stage;\n    if (c.music) G.Music.play(c.music === 'none' ? null : c.music);\n    if (c.enter) for (const a of c.enter) { const [id, side, expr, masked] = a; this.actors[id] = { id, side: side || 'right', expr: expr || 'neutral', masked: !!masked, x: side === 'left' ? -130 : side === 'mid' ? G.game.W / 2 - 56 : G.game.W + 20, shake: 0, off: false }; }\n    if (c.leave) for (const id of [].concat(c.leave)) if (this.actors[id]) this.actors[id].off = true;\n    if (c.expr) { const a = this.actors[c.expr[0]]; if (a) a.expr = c.expr[1]; }\n    if (c.mask !== undefined) { for (const k in this.actors) this.actors[k].masked = !!c.mask; }\n    if (c.speak !== undefined) { this.speaker = c.speak; if (c.speak && c.expr) { const a = this.actors[c.speak]; if (a) { if (c.expr === 'shock' && a.expr !== 'shock') a.shake = .3; a.expr = c.expr; } } if (c.speak && this.actors[c.speak] === undefined && G.CAST[c.speak]) { this.actors[c.speak] = { id: c.speak, side: G.CAST[c.speak].side || 'right', expr: c.expr || 'neutral', masked: false, x: G.CAST[c.speak].side === 'left' ? -130 : G.game.W + 20, shake: 0, off: false }; } }\n    if (c.sfx) G.Sfx[c.sfx] && G.Sfx[c.sfx]();\n    if (c.shake) { G.game.shake(c.shake); for (const k in this.actors) this.actors[k].shake = .3; }\n    if (c.flash) G.game.flash(c.flash, .25);\n    if (c.set) G.Flow.setFlag(c.set);\n    if (c.card) { this.card = { big: c.card[0], small: c.card[1], t: 0 }; G.Sfx.foghorn(); }\n    else if (c.cine) { if (G.Cine && G.Cine.has(c.cine) && !this.story.skip) { this.cine = G.Cine.start(c.cine, () => { this.cine = null; this.story.resume(); }); } else this.story.resume(); }\n    else if (c.wait) { this.waitT = c.wait; }\n  },\n  update(dt) {\n    const game = G.game, I = game.input, st = this.story; this.t += dt; game.focus(game.W / 2, game.H / 2, 0);\n    this.flash = Math.max(0, this.flash - dt);\n    for (const k in this.actors) { const a = this.actors[k], tx = a.off ? (a.side === 'left' ? -130 : game.W + 20) : a.side === 'left' ? Math.max(8, game.W * .07 | 0) : a.side === 'mid' ? game.W / 2 - 56 : game.W - 112 - Math.max(8, game.W * .07 | 0); a.x += (tx - a.x) * Math.min(1, dt * 11); a.shake = Math.max(0, a.shake - dt); if (a.off && Math.abs(a.x - tx) < 2) delete this.actors[k]; }\n    if (this.ended) { const f = this.d.onDone; this.ended = false; if (f) f(); else G.Flow.advance(); return; }\n    if (this.cine) { this.cine.update(dt); return; }\n    if (this.card) { const c = this.card; c.t += dt; if ((c.t > .5 && (I.pressed('confirm') || I.clicked() || I.pressed('skip'))) || c.t > 3.2 || st.skip) { this.card = null; st.resume(); } return; }\n    if (this.waitT > 0) { this.waitT -= dt; if (this.waitT <= 0) { this.waitT = 0; st.resume(); } return; }\n    if (this.logOpen) { if (I.pressed('log') || I.pressed('cancel')) this.logOpen = false; if (I.repeat('up')) this.logI = Math.min(st.log.length - 1, this.logI + 1); if (I.repeat('down')) this.logI = Math.max(0, this.logI - 1); return; }\n    if (I.pressed('log') && !this.d.auto) { this.logOpen = true; this.logI = 0; return; }\n    st.skip = I.down('skip') && !this.d.auto;\n    st.update(dt);\n  },\n  draw(r) {\n    const W = r.W, H = r.H, game = G.game;\n    if (this.cine) { this.cine.draw(r); return; }\n    G.Stage.draw(r, this.stage, this.t);\n    r.overlay(g => {\n      const talkOn = this.story.talk.open && this.story.talk.typing, blink = (this.t % 3.7) < .12;\n      const y0 = H - 128 - 8;\n      const order = Object.values(this.actors).sort((a, b) => (a.id === this.speaker) - (b.id === this.speaker));\n      for (const a of order) {\n        const sp = a.id === this.speaker, cv = G.bust(a.id, { expr: a.expr, blink: blink ? 1 : 0, talk: sp && talkOn && (this.t * 11 | 0) % 2 === 0 ? 1 : 0, maskUp: a.masked, look: sp ? 0 : a.side === 'left' ? 1 : -1 });\n        const bob = sp && talkOn ? Math.round(Math.abs(Math.sin(this.t * 9)) * 2) : 0, sh = a.shake > 0 ? Math.round(Math.sin(this.t * 80) * 3) : 0, x = Math.round(a.x + sh), y = y0 - bob + (sp ? 0 : 3);\n        if (g.drawImage) { g.imageSmoothingEnabled = false; g.drawImage(cv, x, y); px.reset(g); }\n        if (!sp && this.speaker) px.blend(g, .001, 'normal', () => {});\n      }\n      if (this.story.talk.open) { const lw = Glyph.width(game.input, 'skip'); Glyph.action(g, game.input, 'skip', W - lw - 72, 5); Pix.text(g, 'Hold: fast', W - 69, 6, '#a8c8c0'); }\n      this.story.draw(r);\n      if (this.card) { px.blend(g, .85, 'normal', () => px.rect(g, 0, H / 2 - 42, W, 84, '#04121a')); px.rect(g, 0, H / 2 - 43, W, 1, '#4fd0c4'); px.rect(g, 0, H / 2 + 42, W, 1, '#4fd0c4'); E.font.text(g, this.card.big, W / 2, H / 2 - 30, '#ffd36a', { align: 'center', scale: 2, outline: false, shadow: '#000' }); E.font.text(g, this.card.small, W / 2, H / 2 - 6, '#ffffff', { align: 'center', scale: 3, outline: false, shadow: '#000' }); }\n      if (this.logOpen) this.drawLog(g, W, H);\n      if (this.d.ribbon) G.HUD.ribbon(g, W, H, { t: this.t });\n    });\n  },\n  drawLog(g, W, H) {\n    px.blend(g, .92, 'normal', () => px.rect(g, 0, 0, W, H, '#04121a')); Pix.text(g, 'BACKLOG', W / 2, 8, '#ffd36a', { align: 'center' });\n    const L = this.story.log, rows = Math.floor((H - 40) / 20); let y = H - 26; for (let i = L.length - 1 - this.logI, n = 0; i >= 0 && n < rows; i--, n++) { const e = L[i], lines = E.font.wrap(e.text, W - 100); y -= lines.length * 9 + 3; lines.forEach((l, k) => Pix.text(g, l, 88, y + k * 9, e.who === 'choice' ? '#9fffc0' : '#ffffff')); if (e.name) Pix.text(g, e.name.slice(0, 13), 8, y, '#ffd36a'); }\n    Pix.text(g, 'Up and down to read, back to return', W / 2, H - 12, '#8fb8b0', { align: 'center' });\n  },\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_014fuxCdCS855Lj4ZzeczzwU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjqZPKuLvWHA2MW6c8NW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PyqcwP1i74Y3vNQ7mxrVT6","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/scenes/flow.js","content":"// The campaign's order, the save, and which scene follows which (section 4). The order itself is data: src/data/story/campaign.js.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {});\nconst fresh = () => ({ i: -1, diff: 'resident', flags: {}, ranks: {}, chapter: 1, seenEnding: false, patients: [], talked: {} });\nconst Flow = G.Flow = {\n  prog: fresh(), origin: 'story', lastCase: null, fails: {}, overrideDiff: {},\n  debug() { return { i: Flow.prog.i, ranks: Object.keys(Flow.prog.ranks).length, chapter: Flow.prog.chapter, ending: Flow.prog.seenEnding }; },\n  setFlag(k) { Flow.prog.flags[k] = true; },\n  bestRanks: () => E.store.get('tb:ranks', {}),\n  starCount() { let n = 0; const b = Flow.bestRanks(); for (const c in b) for (const d in b[c]) if (b[c][d].star) n++; return n; },\n  recordRank(caseId, diff, rank, star) {\n    const b = Flow.bestRanks(), order = ['S', 'A', 'B', 'C', 'D']; b[caseId] = b[caseId] || {}; const old = b[caseId][diff];\n    if (!old || order.indexOf(rank) < order.indexOf(old.rank) || (star && !old.star)) b[caseId][diff] = { rank: !old || order.indexOf(rank) < order.indexOf(old.rank) ? rank : old.rank, star: star || (old && old.star) };\n    E.store.set('tb:ranks', b); Flow.prog.ranks[caseId] = rank;\n  },\n  unlocked(caseId) { if (E.store.get('tb:unlockAll', false)) return true; const b = Flow.bestRanks(); if (b[caseId]) return true; const seen = E.store.get('tb:seen', {}); return !!seen[caseId]; },\n  markSeen(caseId) { const s = E.store.get('tb:seen', {}); s[caseId] = true; E.store.set('tb:seen', s); },\n  endingSeen: () => E.store.get('tb:ending', false),\n  newGame(diff) { Flow.prog = fresh(); Flow.prog.diff = diff; Flow.origin = 'story'; Flow.fails = {}; Flow.overrideDiff = {}; G.game.settings.set('difficulty', diff); Flow.advance(); },\n  /** the next thing in the campaign */\n  advance() {\n    const P = Flow.prog; P.i++; const e = G.CAMPAIGN[P.i]; Flow.origin = 'story';\n    if (!e) { G.game.go('title'); return; }\n    Flow.runEntry(e);\n  },\n  runEntry(e) {\n    const game = G.game, P = Flow.prog;\n    if (e.chapter) P.chapter = e.chapter;\n    if (e.story) game.go('story', { node: e.story });\n    else if (e.case) { Flow.markSeen(e.case); P.patientsNext = e.case; game.go('chart', { caseId: e.case }); }\n    else if (e.ward) game.go('ward', { ward: e.ward, next: e.next, chapter: e.chapter || P.chapter });\n    else if (e.credits) { P.seenEnding = true; E.store.set('tb:ending', true); game.go('credits', {}); }\n    else Flow.advance();\n  },\n  place() { const e = G.CAMPAIGN[Flow.prog.i] || {}; return (e.ward ? (e.ward === 'ship' ? \"Ship's ward\" : 'Ward 3') : e.case ? G.CASES[e.case].title : 'St. Raz\\'s'); },\n  install(game) {\n    game.saves.write = () => ({ data: JSON.parse(JSON.stringify(Flow.prog)), place: Flow.place(), level: 'Chapter ' + Flow.prog.chapter });\n    game.saves.read = save => { Flow.load(save.data); };\n  },\n  load(data) { Flow.prog = Object.assign(fresh(), data); Flow.origin = 'story'; Flow.fails = {}; const e = G.CAMPAIGN[Flow.prog.i]; if (e) Flow.runEntry(e); else G.game.go('title'); },\n  continueGame() { const s = G.game.saves.latest && G.game.saves.latest(); if (!s) return false; const r = G.game.saves.load(s.slot ?? s.id ?? 'auto'); return r !== false; },\n  difficultyFor(caseId) { return Flow.overrideDiff[caseId] || G.game.settings.difficulty || Flow.prog.diff; },\n  // ---------------------------------------------------------------- case outcomes\n  startCase(caseId, o = {}) { const diff = Flow.difficultyFor(caseId); G.game.go('op', Object.assign({ caseId, difficulty: diff, seed: (Math.random() * 1e9) | 0 }, o)); },\n  caseClosed(S, scene) {\n    Flow.fails[S.caseId] = 0; delete Flow.overrideDiff[S.caseId];\n    const dev = (G.Dev && G.Dev.changed()) || G.tuningChanged();\n    if (!dev && S.mode !== 'lab') Flow.recordRank(S.caseId, S.diff, S.rank, S.star);\n    if (S.caseId && !Flow.prog.patients.includes(S.caseId)) Flow.prog.patients.push(S.caseId);\n    G.game.go('results', { S, dev, origin: Flow.origin });\n  },\n  caseLost(S, scene) { Flow.fails[S.caseId] = (Flow.fails[S.caseId] || 0) + 1; G.game.go('lost', { S, fails: Flow.fails[S.caseId] }); },\n  restartPhase(scene) { if (!scene || !scene.S) return; G.Op.retryPhase(scene.S); scene.V.bark = null; G.game.resume(); },\n  afterResults() { if (Flow.origin === 'files') { Flow.origin = 'story'; G.game.go('casefiles', {}); } else Flow.advance(); },\n  quitToFiles() { Flow.origin = 'story'; G.game.go('casefiles', {}); },\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15191,"cache_read_input_tokens":367325,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15191},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"76854164-193c-41bf-977e-c4e54927ff14","timestamp":"2026-11-05T13:12:59.662Z","request_id":"req_011CgjqZNvbz6q5uaLUpgK3X","wire_tool_inputs":{"toolu_01PyqcwP1i74Y3vNQ7mxrVT6":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/scenes/flow.js","content":"// The campaign's order, the save, and which scene follows which (section 4). The order itself is data: src/data/story/campaign.js.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {});\nconst fresh = () => ({ i: -1, diff: 'resident', flags: {}, ranks: {}, chapter: 1, seenEnding: false, patients: [], talked: {} });\nconst Flow = G.Flow = {\n  prog: fresh(), origin: 'story', lastCase: null, fails: {}, overrideDiff: {},\n  debug() { return { i: Flow.prog.i, ranks: Object.keys(Flow.prog.ranks).length, chapter: Flow.prog.chapter, ending: Flow.prog.seenEnding }; },\n  setFlag(k) { Flow.prog.flags[k] = true; },\n  bestRanks: () => E.store.get('tb:ranks', {}),\n  starCount() { let n = 0; const b = Flow.bestRanks(); for (const c in b) for (const d in b[c]) if (b[c][d].star) n++; return n; },\n  recordRank(caseId, diff, rank, star) {\n    const b = Flow.bestRanks(), order = ['S', 'A', 'B', 'C', 'D']; b[caseId] = b[caseId] || {}; const old = b[caseId][diff];\n    if (!old || order.indexOf(rank) < order.indexOf(old.rank) || (star && !old.star)) b[caseId][diff] = { rank: !old || order.indexOf(rank) < order.indexOf(old.rank) ? rank : old.rank, star: star || (old && old.star) };\n    E.store.set('tb:ranks', b); Flow.prog.ranks[caseId] = rank;\n  },\n  unlocked(caseId) { if (E.store.get('tb:unlockAll', false)) return true; const b = Flow.bestRanks(); if (b[caseId]) return true; const seen = E.store.get('tb:seen', {}); return !!seen[caseId]; },\n  markSeen(caseId) { const s = E.store.get('tb:seen', {}); s[caseId] = true; E.store.set('tb:seen', s); },\n  endingSeen: () => E.store.get('tb:ending', false),\n  newGame(diff) { Flow.prog = fresh(); Flow.prog.diff = diff; Flow.origin = 'story'; Flow.fails = {}; Flow.overrideDiff = {}; G.game.settings.set('difficulty', diff); Flow.advance(); },\n  /** the next thing in the campaign */\n  advance() {\n    const P = Flow.prog; P.i++; const e = G.CAMPAIGN[P.i]; Flow.origin = 'story';\n    if (!e) { G.game.go('title'); return; }\n    Flow.runEntry(e);\n  },\n  runEntry(e) {\n    const game = G.game, P = Flow.prog;\n    if (e.chapter) P.chapter = e.chapter;\n    if (e.story) game.go('story', { node: e.story });\n    else if (e.case) { Flow.markSeen(e.case); P.patientsNext = e.case; game.go('chart', { caseId: e.case }); }\n    else if (e.ward) game.go('ward', { ward: e.ward, next: e.next, chapter: e.chapter || P.chapter });\n    else if (e.credits) { P.seenEnding = true; E.store.set('tb:ending', true); game.go('credits', {}); }\n    else Flow.advance();\n  },\n  place() { const e = G.CAMPAIGN[Flow.prog.i] || {}; return (e.ward ? (e.ward === 'ship' ? \"Ship's ward\" : 'Ward 3') : e.case ? G.CASES[e.case].title : 'St. Raz\\'s'); },\n  install(game) {\n    game.saves.write = () => ({ data: JSON.parse(JSON.stringify(Flow.prog)), place: Flow.place(), level: 'Chapter ' + Flow.prog.chapter });\n    game.saves.read = save => { Flow.load(save.data); };\n  },\n  load(data) { Flow.prog = Object.assign(fresh(), data); Flow.origin = 'story'; Flow.fails = {}; const e = G.CAMPAIGN[Flow.prog.i]; if (e) Flow.runEntry(e); else G.game.go('title'); },\n  continueGame() { const s = G.game.saves.latest && G.game.saves.latest(); if (!s) return false; const r = G.game.saves.load(s.slot ?? s.id ?? 'auto'); return r !== false; },\n  difficultyFor(caseId) { return Flow.overrideDiff[caseId] || G.game.settings.difficulty || Flow.prog.diff; },\n  // ---------------------------------------------------------------- case outcomes\n  startCase(caseId, o = {}) { const diff = Flow.difficultyFor(caseId); G.game.go('op', Object.assign({ caseId, difficulty: diff, seed: (Math.random() * 1e9) | 0 }, o)); },\n  caseClosed(S, scene) {\n    Flow.fails[S.caseId] = 0; delete Flow.overrideDiff[S.caseId];\n    const dev = (G.Dev && G.Dev.changed()) || G.tuningChanged();\n    if (!dev && S.mode !== 'lab') Flow.recordRank(S.caseId, S.diff, S.rank, S.star);\n    if (S.caseId && !Flow.prog.patients.includes(S.caseId)) Flow.prog.patients.push(S.caseId);\n    G.game.go('results', { S, dev, origin: Flow.origin });\n  },\n  caseLost(S, scene) { Flow.fails[S.caseId] = (Flow.fails[S.caseId] || 0) + 1; G.game.go('lost', { S, fails: Flow.fails[S.caseId] }); },\n  restartPhase(scene) { if (!scene || !scene.S) return; G.Op.retryPhase(scene.S); scene.V.bark = null; G.game.resume(); },\n  afterResults() { if (Flow.origin === 'files') { Flow.origin = 'story'; G.game.go('casefiles', {}); } else Flow.advance(); },\n  quitToFiles() { Flow.origin = 'story'; G.game.go('casefiles', {}); },\n};\n})();\n"}}}
