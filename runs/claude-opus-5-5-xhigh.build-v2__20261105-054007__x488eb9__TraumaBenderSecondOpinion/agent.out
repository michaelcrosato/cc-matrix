 return null; },\n  burnNeed: o => 1e9,\n  burning(S, h, o, dt) { o.burn += dt; S.ev.push(['tremBurn', o.x, o.y]); if (o.burn >= o.burnNeedAll / 2 && !o.crawling) { o.crawling = true; o.wakeT = 4; S.ev.push(['tremTear', o.x, o.y]); S.ev.push(['sayp', 'crawl']); } if (o.burn >= o.burnNeedAll) { o.stage = 3; o.crawling = false; o.pull = { ax: Math.cos(o.pullAng ?? -1.2), ay: Math.sin(o.pullAng ?? -1.2), depth: 40, prog: 0, t: 0, tears: 0, par: 2.2, max: 46 }; o.ox = o.x; o.oy = o.y; o.burnT = 0; S.ev.push(['strainHit', o.x, o.y]); S.ev.push(['sayp', 'lastpull']); Score().award(S, h, o.x, o.y, h.dirty ? 'Clean' : 'Textbook', 120); } },\n  grip(S, h, o) { if (o.stage === 2) { o.pinT = 2; S.ev.push(['grip', o.x, o.y, h.id]); } },\n  hold(S, h, o, dt) { if (o.stage === 3) G.Tools.pullStep(S, h, o, dt); else { o.pinT = 2; } },\n  release(S, h, o) { if (o.stage === 3 && o.free) { const far = U.dist(o.x, o.y, o.ox, o.oy) >= 24 || !U.inCavity(o.x, o.y, 4); if (far) { S.jitter = null; S.ev.push(['dish', o.x, o.y, h.id]); S.ev.push(['strainDead', o.x, o.y]); for (const r of S.objs) if (r.type === 'reed' && r.owner === o.id) r.done = true; Op().finishObj(S, o, h, o.pull.tears ? 'Clean' : 'Textbook', 400, 'forceps'); } } },\n  freed(S, h, o) { },\n  step(o, S, w) {\n    S.jitter = o.done ? null : { x: o.x, y: o.y, r: 70, amp: o.amp };\n    if (o.stage === 1) { if (o.amp <= .21) { o.stage = 2; S.ev.push(['shellCrack', o.x, o.y]); S.ev.push(['sayp', 'crack']); G.Score.charge(S, 15); } }\n    else if (o.stage === 2) {\n      o.wakeT -= w; if (o.wakeT <= 0) { o.wakeT = 6; const r = S.objs.find(q => q.type === 'reed' && q.owner === o.id && q.sedated); if (r) { r.sedated = false; o.amp = Math.min(1, o.amp + .2); S.ev.push(['reedWake', r.x, r.y]); } }\n      if (o.crawling) { o.pinT -= w; if (o.pinT <= 0 && o.vessel) { const len = U.polyLen(o.vessel); o.crawlS = (o.crawlS + w * 16 * T.strainSpeed); const s = o.crawlS % (len * 2), q = U.polyAt(o.vessel, s < len ? s : len * 2 - s); o.x = q.x; o.y = q.y; o.cutT -= w; if (o.cutT <= 0) { o.cutT = 3; if (S.objs.filter(q2 => q2.type === 'laceration' && !q2.done).length < 5) Op().spawn(S, { type: 'laceration', x: o.x, y: o.y, r: 7, req: false, ang: U.rnd(S) * 3 }); S.ev.push(['beadBite', o.x, o.y]); } } }\n    }\n    if (S.t - (o.singT ?? -9) > 1.6) { o.singT = S.t; S.ev.push(['tremSing', o.x, o.amp]); }\n  },\n  onDone(S) { S.jitter = null; },\n  job(o, S, h) {\n    const reeds = S.objs.filter(q => q.type === 'reed' && q.owner === o.id && !q.sedated && !q.done);\n    if (o.stage === 1 || (o.stage === 2 && reeds.length && o.amp > .6)) { if (reeds.length) return { tool: 'syringe', o: reeds[0] }; }\n    if (o.stage === 2) return { tool: 'cautery', o, plan: 'tremBurn' };\n    if (o.stage === 3) return { tool: 'forceps', o, plan: 'tremPull' };\n    return null;\n  },\n});\ndef('reed', {\n  strain: true, r: 4, worth: 50, ghost: o => ({ k: 'reed', x: o.x, y: o.y }),\n  init(o) { o.sedated = false; },\n  accept: (o, t) => t === 'syringe' && !o.sedated ? 'Sedate' : null,\n  doseWindow: (o, S) => inWindow(S),\n  dose(S, h, o, q) {\n    const c = Op().byId(S, o.owner);\n    if (inWindow(S)) { o.sedated = true; if (c) c.amp = Math.max(0, c.amp - .2); S.ev.push(['sedate', o.x, o.y]); Score().award(S, h, o.x, o.y, q, 60); if (S.tut && S.tut.tool === 'syringe') S.tut = null; }\n    else { S.ev.push(['reedSpit', o.x, o.y]); Score().hurt(S, 2 * T.strainDamage); S.flow = 0; if (S.objs.filter(q2 => q2.type === 'laceration' && !q2.done).length < 6) Op().spawn(S, { type: 'laceration', x: o.x + U.range(S, -8, 8), y: o.y + 10, r: 6, req: false, ang: 1 }); S.ev.push(['say', 'beat']); }\n  },\n});\n\nconst reg = () => {\n  const P = G.Bot.plans;\n  P.tremBurn = function* (o, S, B) {\n    yield* B.tool('cautery'); const h = () => B.S.hands[B.i];\n    yield* B.moveTo(() => o.x, () => o.y, undefined, 2); B.press(); let guard = 0;\n    while (!o.done && o.stage === 2 && guard++ < 420) { if (h().heat > .9 || h().lock > 0) { B.release(); yield* B.hold(.45); B.press(); } const dx = o.x - B.c.x, dy = o.y - B.c.y, d = Math.hypot(dx, dy); if (d > .5) B.steer(dx, dy, d, 300); yield; const reeds = B.S.objs.filter(q => q.type === 'reed' && q.owner === o.id && !q.sedated && !q.done); if (reeds.length >= 3) break; }\n    B.release(); yield;\n  };\n  P.tremPull = function* (o, S, B) {\n    yield* B.tool('forceps'); yield* B.moveTo(() => o.x, () => o.y, undefined, 1.5); B.press(); yield; const p = o.pull, sp = Math.min(38, p.max * .7); const left = p.depth - p.prog + 3; yield* B.line(B.c.x + p.ax * left, B.c.y + p.ay * left, sp); yield; const dx = o.x - o.ox, dy = o.y - o.oy, l = Math.hypot(dx, dy) || 1; if (l < 28) yield* B.line(B.c.x + dx / l * (28 - l), B.c.y + dy / l * (28 - l), 120); B.release(); yield; yield;\n  };\n};\nif (G.Bot) reg(); else (G._after ||= []).push(reg);\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011uwosbpqft91cdXtLf45ps","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjr4JocFzwaBYEnGTnhu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DHSZkxsRDMRenXh9CSegN3","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/core/strains/dacapo.js","content":"// Da Capo: three lobes on a glowing staff with repeat signs. Each opens on its own timer; the first kill starts ten seconds, and at zero the dead regrow, \"from the top\".\n(() => {\nconst G = (window.GAME ||= {}), T = G.TUNING, U = G.U, def = G.defObject, Op = () => G.Op, Score = () => G.Score;\nconst TIMES = { A: [6, 2.5], B: [7, 2.5], C: [9, 3] };\nconst isOpen = (o, S, c) => { const [p, d] = TIMES[o.kind], k = c ? c.speed : 1; return ((c ? c.t : S.t) + (o.off || 0)) % (p / k) < d / k; };\nconst kill = (S, h, o, grade) => { o.dead = true; o.stage = 0; o.burnT = 0; o.coatT = 0; S.ev.push(['lobeDead', o.x, o.y, o.kind]); Score().award(S, h, o.x, o.y, grade, 150); const c = Op().byId(S, o.owner); if (c && c.countdown <= 0) { c.countdown = c.limit; S.ev.push(['daCapoStart', c.x, c.y]); S.ev.push(['sayp', 'countdown']); } };\n\ndef('dacapo', {\n  strain: true, sings: true, r: 0, prio: 3, ghost: o => ({ k: 'dacapo', x: o.x, y: o.y }),\n  hazard: () => .3,\n  init(o, S) {\n    o.speed = o.speed ?? 1; o.limit = o.limit ?? 10; o.countdown = 0; o.t = 0; o.repeats = 0; o.beadT = 5; o.req = true;\n    const sp = o.spread ?? 92; [['A', -sp, -16], ['B', 0, 18], ['C', sp, -16]].forEach(([kind, dx, dy], i) => Op().spawn(S, { type: 'lobe', kind, x: o.x + dx, y: o.y + dy, owner: o.id, off: i * .7, req: false }));\n  },\n  accept: () => null,\n  step(o, S, w) {\n    o.t += w; const lobes = S.objs.filter(q => q.type === 'lobe' && q.owner === o.id && !q.done);\n    for (const l of lobes) { const was = l.open; l.open = !l.dead && isOpen(l, S, o); if (l.open && !was) S.ev.push(['lobeOpen', l.x, l.y, l.kind]); }\n    if (o.countdown > 0) {\n      o.countdown -= w;\n      if (o.countdown <= 0) { o.countdown = 0; let any = false; for (const l of lobes) if (l.dead) { l.dead = false; any = true; } if (any) { o.repeats++; Score().hurt(S, 8 * T.strainDamage); S.ev.push(['daCapo', o.x, o.y]); S.ev.push(['sayp', 'fromtop']); } }\n    }\n    if (lobes.length && lobes.every(l => l.dead)) { for (const l of lobes) l.done = true; for (const b of S.objs) if (b.type === 'bead' && b.fromCapo) b.done = true; S.ev.push(['strainDead', o.x, o.y]); Op().finishObj(S, o, S.hands[0], o.repeats ? 'Clean' : 'Textbook', 400, 'none'); return; }\n    if (o.speed > 1) { o.beadT -= w * T.spawnRate; if (o.beadT <= 0 && S.objs.filter(q => q.type === 'bead' && !q.done).length < 4) { o.beadT = 5; Op().spawn(S, { type: 'bead', x: o.x + U.range(S, -60, 60), y: o.y + U.range(S, -30, 30), req: false, fromCapo: true }); S.ev.push(['nestSpit', o.x, o.y]); } }\n    if (S.t - (o.singT ?? -9) > 2.6) { o.singT = S.t; S.ev.push(['capoSing', o.x]); }\n  },\n  job(o, S, h) {\n    const lobes = S.objs.filter(q => q.type === 'lobe' && q.owner === o.id && !q.done && !q.dead); if (!lobes.length) return null;\n    // the bot goes to the lobe that opens soonest\n    let best = lobes[0], bs = 1e9; for (const l of lobes) { const [p, d] = TIMES[l.kind], per = p / o.speed, ph = (o.t + (l.off || 0)) % per, wait = l.open ? 0 : per - ph; if (wait < bs) { bs = wait; best = l; } }\n    return { tool: best.kind === 'A' ? 'cautery' : best.kind === 'B' ? (best.stage ? 'forceps' : 'scalpel') : (best.stage ? 'salve' : 'syringe'), o: best, plan: 'lobe' };\n  },\n});\ndef('lobe', {\n  strain: true, r: 8, reach: 6, worth: 150, ghost: o => ({ k: 'lobe', x: o.x, y: o.y, open: o.open, dead: o.dead, kind: o.kind }),\n  init(o) { o.open = false; o.dead = false; o.stage = 0; o.coatT = 0; G.mkPull(o, { depth: 12, ang: -1.57 }); },\n  accept(o, t) {\n    if (o.dead || !o.open) return null;\n    if (o.kind === 'A') return t === 'cautery' ? 'Burn' : null;\n    if (o.kind === 'B') return t === 'scalpel' && !o.stage ? 'Slash' : t === 'forceps' && o.stage ? 'Pull' : null;\n    return t === 'syringe' && !o.stage ? 'Dose' : t === 'salve' && o.stage ? 'Coat' : null;\n  },\n  burnNeed: () => 1 * T.strainHealth, burned(S, h, o, gr) { kill(S, h, o, gr); },\n  slashed(S, h, o) { if (o.stage) return; o.stage = 1; S.ev.push(['strainHit', o.x, o.y]); Score().award(S, h, o.x, o.y, 'Clean', 40); },\n  dose(S, h, o, q) { o.stage = 1; S.ev.push(['sedate', o.x, o.y]); Score().award(S, h, o.x, o.y, q, 40); },\n  coat(S, h, o, dt) { o.coatT += dt; if (o.coatT >= 1 * T.strainHealth) kill(S, h, o, 'Textbook'); },\n  hold(S, h, o, dt) { G.Tools.pullStep(S, h, o, dt); if (o.free && o.pull.prog >= o.pull.depth) { h.held = 0; o.free = false; o.pull.prog = 0; o.pull.t = 0; o.x = o.ox; o.y = o.oy; S.ev.push(['dish', o.x, o.y, h.id]); kill(S, h, o, o.pull.tears ? 'Clean' : 'Textbook'); } },\n  release(S, h, o) { if (!o.free) { o.x = o.ox; o.y = o.oy; } },\n  torn(S, h, o) { },\n});\n\nconst reg = () => {\n  const P = G.Bot.plans;\n  P.lobe = function* (l, S, B, job) {\n    const C = () => G.Op.byId(B.S, l.owner), tool = job.tool, h = () => B.S.hands[B.i];\n    yield* B.tool(tool);\n    const X = l.x, Y = l.y;\n    if (tool === 'scalpel') { const r = 26, a = 1.1; yield* B.moveTo(X - Math.cos(a) * r, Y - Math.sin(a) * r, undefined, 3); let w = 0; while (!l.open && w++ < 1200 && !l.dead) yield; if (l.dead) return; B.press(); yield; yield* B.line(X + Math.cos(a) * r, Y + Math.sin(a) * r, 240); B.release(); yield; return; }\n    yield* B.moveTo(X, Y, undefined, 2);\n    let w = 0; while (!l.open && w++ < 1200 && !l.dead && !l.done) { if (tool === 'syringe' && !h().down && w > 10) { } yield; }\n    if (l.dead || l.done) return;\n    if (tool === 'cautery') { B.press(); let g = 0; while (l.open && !l.dead && !l.done && g++ < 300) { if (h().heat > .92) { B.release(); yield* B.hold(.3); B.press(); } yield; } B.release(); yield; }\n    else if (tool === 'syringe') { B.press(); yield* B.hold(T.fillT + .02); B.release(); yield; yield* B.hold(T.syrCool); }\n    else if (tool === 'salve') { B.press(); let g = 0; while (l.open && !l.dead && !l.done && g++ < 300) yield; B.release(); yield; }\n    else if (tool === 'forceps') { B.press(); yield; const p = l.pull; yield* B.line(B.c.x + p.ax * (p.depth + 3), B.c.y + p.ay * (p.depth + 3), 70); yield; B.release(); yield; }\n  };\n};\nif (G.Bot) reg(); else (G._after ||= []).push(reg);\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5261,"cache_read_input_tokens":426892,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5261},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"cebe1b42-843c-48aa-a34a-a85a9e5615ab","timestamp":"2026-11-05T13:21:05.580Z","request_id":"req_011Cgjr4JWzsHCHf7h7LeZDN","wire_tool_inputs":{"toolu_01DHSZkxsRDMRenXh9CSegN3":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007/src/core/strains/dacapo.js","content":"// Da Capo: three lobes on a glowing staff with repeat signs. Each opens on its own timer; the first kill starts ten seconds, and at zero the dead regrow, \"from the top\".\n(() => {\nconst G = (window.GAME ||= {}), T = G.TUNING, U = G.U, def = G.defObject, Op = () => G.Op, Score = () => G.Score;\nconst TIMES = { A: [6, 2.5], B: [7, 2.5], C: [9, 3] };\nconst isOpen = (o, S, c) => { const [p, d] = TIMES[o.kind], k = c ? c.speed : 1; return ((c ? c.t : S.t) + (o.off || 0)) % (p / k) < d / k; };\nconst kill = (S, h, o, grade) => { o.dead = true; o.stage = 0; o.burnT = 0; o.coatT = 0; S.ev.push(['lobeDead', o.x, o.y, o.kind]); Score().award(S, h, o.x, o.y, grade, 150); const c = Op().byId(S, o.owner); if (c && c.countdown <= 0) { c.countdown = c.limit; S.ev.push(['daCapoStart', c.x, c.y]); S.ev.push(['sayp', 'countdown']); } };\n\ndef('dacapo', {\n  strain: true, sings: true, r: 0, prio: 3, ghost: o => ({ k: 'dacapo', x: o.x, y: o.y }),\n  hazard: () => .3,\n  init(o, S) {\n    o.speed = o.speed ?? 1; o.limit = o.limit ?? 10; o.countdown = 0; o.t = 0; o.repeats = 0; o.beadT = 5; o.req = true;\n    const sp = o.spread ?? 92; [['A', -sp, -16], ['B', 0, 18], ['C', sp, -16]].forEach(([kind, dx, dy], i) => Op().spawn(S, { type: 'lobe', kind, x: o.x + dx, y: o.y + dy, owner: o.id, off: i * .7, req: false }));\n  },\n  accept: () => null,\n  step(o, S, w) {\n    o.t += w; const lobes = S.objs.filter(q => q.type === 'lobe' && q.owner === o.id && !q.done);\n    for (const l of lobes) { const was = l.open; l.open = !l.dead && isOpen(l, S, o); if (l.open && !was) S.ev.push(['lobeOpen', l.x, l.y, l.kind]); }\n    if (o.countdown > 0) {\n      o.countdown -= w;\n      if (o.countdown <= 0) { o.countdown = 0; let any = false; for (const l of lobes) if (l.dead) { l.dead = false; any = true; } if (any) { o.repeats++; Score().hurt(S, 8 * T.strainDamage); S.ev.push(['daCapo', o.x, o.y]); S.ev.push(['sayp', 'fromtop']); } }\n    }\n    if (lobes.length && lobes.every(l => l.dead)) { for (const l of lobes) l.done = true; for (const b of S.objs) if (b.type === 'bead' && b.fromCapo) b.done = true; S.ev.push(['strainDead', o.x, o.y]); Op().finishObj(S, o, S.hands[0], o.repeats ? 'Clean' : 'Textbook', 400, 'none'); return; }\n    if (o.speed > 1) { o.beadT -= w * T.spawnRate; if (o.beadT <= 0 && S.objs.filter(q => q.type === 'bead' && !q.done).length < 4) { o.beadT = 5; Op().spawn(S, { type: 'bead', x: o.x + U.range(S, -60, 60), y: o.y + U.range(S, -30, 30), req: false, fromCapo: true }); S.ev.push(['nestSpit', o.x, o.y]); } }\n    if (S.t - (o.singT ?? -9) > 2.6) { o.singT = S.t; S.ev.push(['capoSing', o.x]); }\n  },\n  job(o, S, h) {\n    const lobes = S.objs.filter(q => q.type === 'lobe' && q.owner === o.id && !q.done && !q.dead); if (!lobes.length) return null;\n    // the bot goes to the lobe that opens soonest\n    let best = lobes[0], bs = 1e9; for (const l of lobes) { const [p, d] = TIMES[l.kind], per = p / o.speed, ph = (o.t + (l.off || 0)) % per, wait = l.open ? 0 : per - ph; if (wait < bs) { bs = wait; best = l; } }\n    return { tool: best.kind === 'A' ? 'cautery' : best.kind === 'B' ? (best.stage ? 'forceps' : 'scalpel') : (best.stage ? 'salve' : 'syringe'), o: best, plan: 'lobe' };\n  },\n});\ndef('lobe', {\n  strain: true, r: 8, reach: 6, worth: 150, ghost: o => ({ k: 'lobe', x: o.x, y: o.y, open: o.open, dead: o.dead, kind: o.kind }),\n  init(o) { o.open = false; o.dead = false; o.stage = 0; o.coatT = 0; G.mkPull(o, { depth: 12, ang: -1.57 }); },\n  accept(o, t) {\n    if (o.dead || !o.open) return null;\n    if (o.kind === 'A') return t === 'cautery' ? 'Burn' : null;\n    if (o.kind === 'B') return t === 'scalpel' && !o.stage ? 'Slash' : t === 'forceps' && o.stage ? 'Pull' : null;\n    return t === 'syringe' && !o.stage ? 'Dose' : t === 'salve' && o.stage ? 'Coat' : null;\n  },\n  burnNeed: () => 1 * T.strainHealth, burned(S, h, o, gr) { kill(S, h, o, gr); },\n  slashed(S, h, o) { if (o.stage) return; o.stage = 1; S.ev.push(['strainHit', o.x, o.y]); Score().award(S, h, o.x, o.y, 'Clean', 40); },\n  dose(S, h, o, q) { o.stage = 1; S.ev.push(['sedate', o.x, o.y]); Score().award(S, h, o.x, o.y, q, 40); },\n  coat(S, h, o, dt) { o.coatT += dt; if (o.coatT >= 1 * T.strainHealth) kill(S, h, o, 'Textbook'); },\n  hold(S, h, o, dt) { G.Tools.pullStep(S, h, o, dt); if (o.free && o.pull.prog >= o.pull.depth) { h.held = 0; o.free = false; o.pull.prog = 0; o.pull.t = 0; o.x = o.ox; o.y = o.oy; S.ev.push(['dish', o.x, o.y, h.id]); kill(S, h, o, o.pull.tears ? 'Clean' : 'Textbook'); } },\n  release(S, h, o) { if (!o.free) { o.x = o.ox; o.y = o.oy; } },\n  torn(S, h, o) { },\n});\n\nconst reg = () => {\n  const P = G.Bot.plans;\n  P.lobe = function* (l, S, B, job) {\n    const C = () => G.Op.byId(B.S, l.owner), tool = job.tool, h = () => B.S.hands[B.i];\n    yield* B.tool(tool);\n    const X = l.x, Y = l.y;\n    if (tool === 'scalpel') { const r = 26, a = 1.1; yield* B.moveTo(X - Math.cos(a) * r, Y - Math.sin(a) * r, undefined, 3); let w = 0; while (!l.open && w++ < 1200 && !l.dead) yield; if (l.dead) return; B.press(); yield; yield* B.line(X + Math.cos(a) * r, Y + Math.sin(a) * r, 240); B.release(); yield; return; }\n    yield* B.moveTo(X, Y, undefined, 2);\n    let w = 0; while (!l.open && w++ < 1200 && !l.dead && !l.done) { if (tool === 'syringe' && !h().down && w > 10) { } yield; }\n    if (l.dead || l.done) return;\n    if (tool === 'cautery') { B.press(); let g = 0; while (l.open && !l.dead && !l.done && g++ < 300) { if (h().heat > .92) { B.release(); yield* B.hold(.3); B.press(); } yield; } B.release(); yield; }\n    else if (tool === 'syringe') { B.press(); yield* B.hold(T.fillT + .02); B.release(); yield; yield* B.hold(T.syrCool); }\n    else if (tool === 'salve') { B.press(); let g = 0; while (l.open && !l.dead && !l.done && g++ < 300) yield; B.release(); yield; }\n    else if (tool === 'forceps') { B.press(); yield; const p = l.pull; yield* B.line(B.c.x + p.ax * (p.depth + 3), B.c.y + p.ay * (p.depth + 3), 70); yield; B.release(); yield; }\n  };\n};\nif (G.Bot) reg(); else (G._after ||= []).push(reg);\n})();\n"}}}
