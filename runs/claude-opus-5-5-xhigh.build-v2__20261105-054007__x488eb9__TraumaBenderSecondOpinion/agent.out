; pg.screenshot(path='notes/tmp/h2.png')\n        print(pg.evaluate(\"()=>[...document.querySelectorAll('iframe')].map(f=>{const g=f.contentWindow.GAME.game,s=g.scene;return [s.phase,s.info&&s.info.isHost,s.S.objs.length,g.errors.length]})\"))\n        b.close()\nfinally:\n    srv.terminate(); srv.wait(timeout=5)\nEOF\ntimeout 60 python3 notes/tmp/hubview.py | cut -c1-300; cd notes/tmp; magick h1.png h2.png -append -resize 60% h.png","description":"Screenshot a two-player Hub round's card and play","timeout":80000}}}
