t_for_timeout(600); pg.screenshot(path='notes/tmp/k_breath.png')\n    # wheel with hint (a person's hand): tutorial on the first pull\n    pg.evaluate(\"()=>{GAME.game.go('op',{caseId:'glasshouse',phase:0,seed:7,difficulty:'intern'});}\"); pg.wait_for_timeout(1500); pg.keyboard.press('Digit3'); pg.wait_for_timeout(120); pg.screenshot(path='notes/tmp/k_wheel.png')\n    # second look\n    go('forcenine',0,',steady:true'); wait_for(pg,\"()=>GAME.game.scene.S&&GAME.game.scene.S.status==='rewind'\",60000); pg.wait_for_timeout(500); pg.screenshot(path='notes/tmp/k_rewind.png')\n    wait_for(pg,\"()=>GAME.game.scene.S.status==='play'\"); pg.wait_for_timeout(1200); pg.screenshot(path='notes/tmp/k_ghost.png')\n    # closing and results\n    pg.evaluate(\"()=>{const g=GAME.game; g.go('op',{caseId:'glasshouse',phase:3,seed:7,difficulty:'resident',dev:{noTut:true},onEnd(){},attract:true,botSkill:{iv:90}});}\"); wait_for(pg,\"()=>GAME.game.scene.S&&GAME.game.scene.S.status==='closing'&&GAME.game.scene.S.close.t<.6&&!GAME.game.scene.S.close.done\"); pg.screenshot(path='notes/tmp/k_dress.png')\n    wait_for(pg,\"()=>GAME.game.scene.S.close&&GAME.game.scene.S.close.done&&GAME.game.scene.S.close.t>.5\"); pg.screenshot(path='notes/tmp/k_stamp.png')\n    pg.evaluate(\"()=>{const S=GAME.Op.create('glasshouse',{seed:5}); S.score=2600;S.clock=120;S.bestFlow=14;S.rank='S';S.stats.vSum=70;S.stats.vN=1;S.stats.tb=12; GAME.game.go('results',{S,onDone(){}});}\"); pg.wait_for_timeout(4200); pg.screenshot(path='notes/tmp/k_results.png')\n    pg.evaluate(\"()=>{const S=GAME.Op.create('crane9',{seed:5}); S.status='lost';S.lost='vitals'; GAME.game.go('lost',{S,fails:2});}\"); pg.wait_for_timeout(1500); pg.screenshot(path='notes/tmp/k_lost.png')\n    print('errs',errs[:3], pg.evaluate(\"()=>GAME.game.errors.map(e=>String(e.message||e)).slice(0,3)\"))\n    b.close()\nEOF\ntimeout 170 python3 notes/tmp/moments.py 2>&1 | cut -c1-500; cd notes/tmp; magick \\( k_code.png k_breath.png k_wheel.png +append