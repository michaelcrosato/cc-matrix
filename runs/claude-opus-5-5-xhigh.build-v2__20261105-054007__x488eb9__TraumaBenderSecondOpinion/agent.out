y with Source Information + 3 feedback sections.\n\n\"\"\"+s[b:]\nopen(p,'w').write(s)\nEOF\ncat > notes/tmp/dbg2.mjs <<'EOF'\nimport { loadSim } from '../../tools/simrun.mjs';\nconst ctx = loadSim(), G=ctx.GAME; const players=[{id:0,name:'A'},{id:1,name:'B'},{id:2,name:'C'}];\nconst S=G.Op.create('grandrounds',{seed:100,players,difficulty:'resident'}); const bots=S.hands.map((_,i)=>G.Bot.create(S,i,{react:.1,speed:300,seed:7+i})); let last=-1,n=0;\nwhile(S.status!=='closed'&&S.status!=='lost'&&n++<120*90){G.Op.step(S,bots.map(b=>G.Bot.step(b,S,1/120)),1/120); if(S.ph!==last){last=S.ph;console.log('ph',S.ph,'t',n/120|0,'v',S.vitals|0);} for(const e of S.ev) if(['lobeDead','daCapo','daCapoStart','lobeOpen'].includes(e[0])&&S.ph===3) console.log((n/120).toFixed(1),e[0],e[3]||''); if(S.ph>=3&&n%600===0){const c=S.objs.find(o=>o.type==='dacapo'); console.log((n/120)|0,'cd',c&&c.countdown|0,S.objs.filter(o=>o.type==='lobe').map(o=>o.kind+(o.dead?'x':'')+(o.open?'o':'')+o.stage).join(' '),'hands',S.hands.map(h=>h.tool+(h.down?'*':'')).join(' '));} }\nconsole.log(S.status,S.ph,S.lost,S.vitals|0);\nEOF\ntimeout 60 node notes/tmp/dbg2.mjs 2>&1 | sed -n 1,40p | cut -c1-200","description":"Trace three bots against Da Capo","timeout":90000}}}
