.done || (q.hidden && !(q.marked > 0)) || G.Op.covered(DS, q)) continue; const sp = G.OBJ[q.type]; if (!(sp.hazard || sp.strain) || q.type === 'dome') continue; const R2 = Math.max(6, (q.r || 6) + 3) + Math.sin(V.t * 5 + q.id) * 1.5; Pix.ring(g, q.x + OXs, q.y + OYs, R2, sp.strain ? '#5ff0e0' : '#ffffff', 2); }\\n    // ghosts of a Second Look\\n\")\np='src/ui/hud.js'\nsub(p,\"const v = Math.ceil(S.vitals), flash = S.vitals < 30 && Math.sin(V.t * 9) < 0;\",\"const shakeV = S.jitter && !S.breath ? Math.round(Math.sin(V.t * 23) * 3 * S.jitter.amp) : 0, v = Math.ceil(S.vitals) + shakeV, flash = S.vitals < 30 && Math.sin(V.t * 9) < 0;\")\np='src/scenes/hubround.js'\nsub(p,\"if (d.ev && d.ev.length) { S.ev = d.ev; if (!G.isServerCopy) G.OpScene.drainEvents(G.game, S, this.V, { mute: false }); S.ev = []; }\",\"if (d.ev && d.ev.length) { for (const e of d.ev) if (e[0] === 'phase') S.ph = e[1]; S.ev = d.ev; G.OpScene.drainEvents(G.game, S, this.V, { mute: false }); S.ev = []; }\")\nsub(p,\"if (info.isHost) this.hostStep(dt, mine); else this.clientStep(dt, mine);\\n    G.OpScene.updateView(game, S, V, dt, I);\",\"if (info.isHost) this.hostStep(dt, mine); else this.clientStep(dt, mine);\\n    G.OpScene.updateView(game, S, V, dt, I); if (this.locals[0]) G.OpScene.hints(S, V, this.locals[0], dt);\")\n# tests: lobby, half keyboard, ward walking\np='tests/run.mjs'\nsub(p,\"// ------------------------------------------------------------------ about data and the exit interview\",\"\"\"// ------------------------------------------------------------------ couch co-op and the ward's hands\nsafe('couch', () => {\n  const ctx = load(), G = ctx.GAME, game = G.game, I = game.input; game.fadeTime = 0; game.advance(.2); game.go('lobby', {}); game.advance(.1); const sc = game.scene; check('the lobby opens with player 1 seated', game.sceneName === 'lobby' && sc.seats[0] && !sc.seats[1]);\n  sc.pick(1); check('add an AI colleague', sc.seats[1] && sc.seats[1].kind === 'bot'); sc.pick(1); sc.pick(1); sc.pick(2); check('remove one', !sc.seats[3] && sc.seats[2].kind === 'bot');\n  const q = game.addPlayer({ keys: 'right' }); check('a second keyboard half can join', !!q && game.players.length === 2); sc.seats[3] = { kind: 'p', input: q, name: 'P4' };\n  sc.pick(0); game.advance(.2); check('Grand Rounds starts with those seats', game.sceneName === 'op' && game.scene.S.hands.length === 4 && game.scene.S.mode === 'rounds', game.sceneName); const op = game.scene; check('each seat has a color and a cursor', new Set(op.S.hands.map(h => h.color)).size === 4 && op.locals.length === 4);\n  q.hold('curR', true); const x0 = op.locals[3].c.x; game.advance(.5); q.hold('curR', false); check('player 4 moves their own cursor', op.locals[3].c.x > x0 + 40, op.locals[3].c.x - x0);\n  q.tap('toolNext'); game.advance(.2); check('player 4 steps their own tool', op.S.hands[3].tool === 'scalpel', op.S.hands[3].tool); op.locals[0].bot = G.Bot.create(op.S, 0, {}); let n = 0; while (game.sceneName === 'op' && n++ < 700) game.advance(1); check('the couch round ends on the results', game.sceneName === 'roundsend', game.sceneName); const r = game.scene; check('standings and awards are ready', r.st.length >= 1 && Array.isArray(r.aw)); I.tap && game.advance(1.2); I.tap('confirm'); game.advance(.2); check('back to the lobby', game.sceneName === 'lobby', game.sceneName); check('no errors on the couch', !game.errors.length, game.errors.map(e => String(e.stack || e)).slice(0, 2).join(' | '));\n  G.Flow.prog.patients = ['glasshouse']; G.Flow.prog.chapter = 2; game.go('ward', { ward: 'ward3', chapter: 2 }); game.advance(.2); const w = game.scene; check('saved patients are in the beds', w.people.some(p => p.id === 'agnes' && p.bed)); check('the ward can save', game.saves.canSave); const hx = w.hero.x; I.hold('right', true); game.advance(.5); I.hold('right', false); check('walking', w.hero.x > hx + 10, w.hero.x - hx); const ag = w.people.find(p => p.id === 'agnes'); w.hero.x = ag.x; w.hero.y = ag.y + 20; game.advance(.05); I.tap('interact'); game.advance(.1); check('talking', w.talk.open); for (let i = 0; i < 5 && w.talk.open; i++) { I.tap('confirm'); game.advance(.3); } for (const p of w.people) { w.use(p); for (let i = 0; i < 5 && w.talk.open; i++) { I.tap('confirm'); game.advance(.3); } } check('talk to everyone: morale', G.Flow.prog.morale === true);\n  const k = G.Op.create('glasshouse', { seed: 1, steady: 10 }); check('morale starts the next case with +10 Steady', k.steady === 10);\n});\n// ------------------------------------------------------------------ about data and the exit interview\"\"\")\nEOF\ncat > CONTENT.md <<'EOF'\n# Adding content: no engine or sim edits, a data file and a recipe\n\nEverything below is loaded in the order of `src/manifest.json`; add your file there. `node tests/run.mjs --fast --only=content` validates every reference. Dev mode's Jump tab and the Skills Lab are the workshop.\n\n## A case\n`src/data/cases/*.js`: `G.defCase({ id, n, chapter, title, doctor, site, clock, vitals, drain, patient: { name, age, face, where, complaint, human }, lightbox?, teaches?, duo?, look?, boss?, music?, closeAt, phases: [...], barks })`.\n- A phase: `{ id, obj (at most 26 characters, a verb first), spawn: [objects], tut?: { tool, text }, clear?: { t, vitals, flag, found, only }, enter?: [actions], script?: [{ t, do: [actions] }], music?, title? }`.\n- An object: `{ type, x, y, ...its fields, then?: [actions], leaves?: [objects] }`. Field units: the cavity is the ellipse at (213, 116), radii (171, 91).\n- Barks: `{ enter: [per phase], done: [per phase], hint: [per phase], extra: { name: [[who, line]] } }`, each line at most 40 characters.\n- Add the case to `G.CAMPAIGN` (`src/data/story/campaign.js`), then run `node tools/balance.mjs yourcase` and `node tools/balance.mjs --par`.\n\n## A thing on the table, or a strain\n`G.defObject(type, { hazard, accept(o, tool, S) -> verb, burnNeed, burned, dose, slashed, coat, grip, hold, release, step(o, S, wdt, dt), init(o, S), job, bot, ghost, strain: true })` in `src/core/` (no draw, audio or DOM there). Its look: `G.defArt(type, { stamp(F, o, S, x, y, C), over(g, o, S, x, y, C) })` in `src/art/`. Its sound and picture: emit `S.ev.push(['name', ...])` from the sim and add `G.FeelExtra.name` in `src/art/strains.js`. A strain's figure lives in `src/audio/choir.js`. A bot plan is a generator: `bot: function* (o, S, B) { yield* B.tool('forceps'); yield* B.moveTo(o.x, o.y); B.press(); ... }`.\n\n## A site\n`G.defSite(id, { label, bake(W, H, seed) -> TissueField })` in `src/art/sites.js`: use `shell`, `blob`, `tube`, `veins`, `coil`, then `F.finish()`.\n\n## A character\n`G.defCast(id, { name, skin, hair, iris, cloth, frontHair, backHair, glasses, voice: { base, syl, wave } ... })` in `src/data/cast.js` (the parts kit is at its top). A body for the ward and cinematics: add a look to `LOOK` in `src/art/props.js`.\n\n## A story node\n`G.defStory(id, [steps])` in `src/data/story/*.js`. A step is `[who, line, expr?]`, or `{ stage, music, enter: [[id, side, expr, masked]], leave, choose: [a, b], replies: [[who, line], ...], card: [big, small], cine, narr, sfx, shake, flash, wait, set }`. Add it to `G.CAMPAIGN`. Ward talk: `G.WARD_TALK[person][chapter]`.\n\n## A stage, a song, a cinematic\n`G.defStage(id, { bake(g, W, H), anim(g, W, H, t) })` in `src/art/stages.js`. `G.SONGS[id]` in `src/data/songs.js` (the engine's notation). A cinematic is a generator in `DEFS` in `src/scenes/cine.js`.\n\n## Tuning\nEvery number that matters is in `G.TUNING_DEFAULTS` in `src/config.js`. Tune live in dev mode, then Info, Copy tuning, and paste the values back.\nEOF\nnode tools/build.mjs; timeout 300 node tests/run.mjs --fast --only=couch 2>&1 | tail -12 | cut -c1-500; timeout 60 node tests/run.mjs --fast --only=draw 2>&1 | tail -3 | cut -c1-500","description":"Apply remaining plan details, write CONTENT.md, add couch tests","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1563,"cache_read_input_tokens":704352,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1563},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"455aabbf-dbfa-409a-91df-ba2177dd6342","uuid":"956677c9-fc07-4c5f-9474-4b4380367aa3","timestamp":"2026-11-05T13:59:49.262Z","request_id":"req_011Cgju8DUMJfciEejYnufZS","wire_tool_inputs":{"toolu_01RnLZSZeAyFDJf48YL5eJF1":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-054007__x488eb9/work/TraumaBenderSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-054007\npython3 - <<'EOF'\ndef sub(p, a, b):\n    s=open(p).read()\n    if a not in s: print('MISSING', p, a[:90])\n    open(p,'w').write(s.replace(a,b,1))\n# ward: flow field only when the goal changes\np='src/scenes/ward.js'\nsub(p,\"const g2 = this.goal, gx = g2.x, gy = g2.y; this.flow.update(gx, gy); const dir\",\"const g2 = this.goal, gx = g2.x, gy = g2.y; if (!g2.fu) { g2.fu = true; this.flow.update(gx, gy); } const dir\")\nsub(p,\"game.lights.tint = undefined; if (W.window) game.weather = null;\",\"if (W.sway) { const L = G.Sfx.loop('creak'); if (L) L.set(.02); }\")\nsub(p,\"exit() { G.game.lights.enabled = false;\",\"exit() { G.Sfx.stopLoops(); G.game.lights.enabled = false;\")\n# story prompts: top-left, plus an advance cap\np='src/scenes/story.js'\nsub(p,\"if (this.story.talk.open) { const lw = Glyph.width(game.input, 'skip'); Glyph.action(g, game.input, 'skip', W - lw - 72, 5); Pix.text(g, 'Hold: fast', W - 69, 6, '#a8c8c0'); }\",\"if (this.story.talk.open && !this.d.auto) { let x = 6; x += Glyph.action(g, game.input, 'skip', x, 5) + 3; Pix.text(g, 'Hold: fast', x, 6, '#a8c8c0'); x += 58; x += Glyph.action(g, game.input, 'log',