"src/data/songs.js\", \"src/audio/sfx.js\", \"src/audio/babble.js\", \"src/audio/choir.js\", \"src/audio/music.js\",\n    \"src/ui/hud.js\", \"src/ui/dev.js\", \"src/ui/attract.js\", \"src/scenes/flow.js\", \"src/scenes/story.js\", \"src/data/story/ch1.js\", \"src/data/story/ch2.js\", \"src/data/story/ch3.js\", \"src/data/story/ch4.js\", \"src/data/story/campaign.js\",\n    \"src/scenes/op.js\", \"src/scenes/title.js\", \"src/scenes/chart.js\", \"src/scenes/results.js\", \"src/scenes/menus.js\", \"src/scenes/ward.js\", \"src/scenes/cine.js\", \"src/scenes/lobby.js\", \"src/scenes/hubround.js\",\n    \"src/main.js\"] }\nEOF\necho '{\"sourceInformation\":{},\"testingFeedback\":[],\"engineFeedback\":[],\"promptFeedback\":[],\"aiHub\":{},\"credits\":[]}' > src/about-data.json\nnode tools/build.mjs -v\ncat > notes/tmp/headless.mjs <<'EOF'\nimport vm from 'node:vm'; import { readFileSync } from 'node:fs';\nconst ctx={console,performance,structuredClone,setTimeout,clearTimeout}; ctx.window=ctx; vm.createContext(ctx);\nconst man=JSON.parse(readFileSync('src/manifest.json','utf8'));\nvm.runInContext(readFileSync('vendor/my-3d2dge/dist/handoff/my-3d2dge.js','utf8'),ctx,{filename:'engine'});\nfor (const f of [...man.sim,...man.game]) vm.runInContext(readFileSync(f,'utf8'),ctx,{filename:f});\nconst E=ctx.My3D2dge, G=ctx.GAME, game=G.game; game.fadeTime=0;\ngame.advance(.5); console.log('scene',game.sceneName,'errors',game.errors.length, game.errors.slice(0,2).map(e=>String(e.message||e)));\nEOF\ntimeout 40 node notes/tmp/headless.mjs 2>&1 | tail -12 | cut -c1-260","description":"Wire the manifest and multi-seat play, then boot it headless","timeout":60000}}}
