}\nif (typeof document !== 'undefined') { window.__T={start:performance.now()}; await Engine.start(new Spike(), { container: document.getElementById('app'), camera:{preset:'first',fov:Number(q.get('fov')??62)}, settings:{button:false}, look: q.get('look')?LOOK_PRESETS[q.get('look')]:undefined }); }\nEOF\ncat > $S/build.mjs <<'EOF'\n// Bundles a module with esbuild and inlines it after the session client in one HTML file.\nimport { execFileSync } from 'node:child_process'; import { readFileSync, writeFileSync } from 'node:fs';\nconst [,, entry, out, sessionPath, ...metas] = process.argv;\nconst js = execFileSync('esbuild',[entry,'--bundle','--format=esm','--target=esnext','--log-level=warning'],{maxBuffer:1<<29}).toString();\nconst safe = js.replace(/<\\/script/gi,'<\\\\/script');\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\">\\n<script>${readFileSync(sessionPath,'utf8').replace(/<\\/script/gi,'<\\\\/script')}</script>\\n${metas.join('\\n')}\\n<title>spike</title></head><body><div id=\"app\"></div><script type=\"module\">${safe}</script></body></html>`;\nwriteFileSync(out,html); console.log('built',out,(html.length/1e6).toFixed(2),'MB');\nEOF\ncd $S && node build.mjs v1.js v1.html ../hub/session.js && ls -la v1.html && grep -c \"</script\" v1.html; cd $W","description":"Write the visual spike and bundle it into one HTML file","timeout":120000}}}
