46\t  }\n147\t\n148\t  /**\n149\t   * No hub after all: play on, with Math.random the page's own again. The\n150\t   * empty storage stays: the game has read it already, and what it writes\n151\t   * must never land on the player's real saves.\n152\t   */\n153\t  function standAlone() {\n154\t    hub.active = false;\n155\t    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n156\t    hub.seeded = false;\n157\t  }\n158\t\n159\t  var origin = '*';\n160\t  var welcomed = false;\n161\t  var ended = false;\n162\t  var connecting = null;\n163\t  var goAt = null;\n164\t  var sentReady = false;\n165\t  var reported = false;\n166\t  var handlers = {};\n167\t  var pending = {};\n168\t  var tokens = limits.burst;\n169\t  var refilled = now();\n170\t  var probeFn = null;\n171\t  var lastProgress = -Infinity;\n172\t  var nextProgress = null;\n173\t  var progressTimer = null;\n174\t\n175\t  function now() {\n176\t    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n177\t  }\n178\t\n179\t  function warn(text) {\n180\t    if (root.console) root.console.warn('[AIHub] ' + text);\n181\t  }\n182\t\n183\t  function own(o, k) {\n184\t    return Object.prototype.hasOwnProperty.call(o, k);\n185\t  }\n186\t\n187\t  /** This client's own fields, which no welcome may overwrite. */\n188\t  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n189\t\n190\t  /** A plain JSON copy, or undefined when it is not JSON. */\n191\t  function json(value) {\n192\t    try {\n193\t      var text = JSON.stringify(value);\n194\t      return text === undefined ? undefined : JSON.parse(text);\n195\t    } catch (e) {\n196\t      return undefined;\n197\t    }\n198\t  }\n199\t\n200\t  function post(type, fields) {\n201\t    var msg = { aihub: 1, type: type };\n202\t    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n203\t    try {\n204\t      root.parent.postMessage(msg, origin);\n205\t    } catch (e) {\n206\t      warn('could not reach the hub: ' + e.message);\n207\t    }\n208\t  }\n209\t\n210\t  function emit(type, args) {\n211\t    var list = handlers[type];\n212\t    if (!list || !list.length || pending[type]) {\n213\t      (pending[type] = pending[type] || []).push(args);\n214\t      return;\n215\t    }\n216\t    for (var i = 0; i < list.length; i++) {\n217\t      try {\n218\t        list[i].apply(null, args);\n219\t      } catch (e) {\n220\t        setTimeout(function () {\n221\t          throw e;\n222\t        });\n223\t      }\n224\t    }\n225\t  }\n226\t\n227\t  function onMessage(event) {\n228\t    if (event.source !== root.parent) return;\n229\t    var m = event.data;\n230\t    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n231\t    if (m.type === 'welcome') {\n232\t      if (welcomed) return;\n233\t      welcomed = true;\n234\t      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n235\t      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n236\t      for (var key in m) {\n237\t        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n238\t        hub[key] = m[key];\n239\t      }\n240\t      hub.players = (m.players || []).slice();\n241\t      hub.seed = m.seed >>> 0;\n242\t      hub.isHost = m.me === m.host;\n243\t      hub.splash = m.splash === true;\n244\t      if (m.limits) {\n245\t        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n246\t        tokens = limits.burst;\n247\t      }\n248\t      if (connecting) connecting.resolve(info());\n249\t      return;\n250\t    }\n251\t    if (m.type === 'fullscreen') {\n252\t      fullscreenOn = m.on === true;\n253\t      try {\n254\t        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n255\t      } catch (e) {}\n256\t      return;\n257\t    }\n258\t    if (!welcomed || ended) return;\n259\t    if (m.type === 'start') {\n260\t      goAt = now() + Number(m.in || 0);\n261\t      emit('start', [{ in: Number(m.in || 0) }]);\n262\t    } else if (m.type === 'message') {\n263\t      emit('message', [m.data, m.from]);\n264\t    } else if (m.type === 'leave') {\n265\t      hub.players = hub.players.filter(function (p) {\n266\t        return p.id !== m.id;\n267\t      });\n268\t      emit('leave', [{ id: m.id, reason: m.reason }]);\n269\t    } else if (m.type === 'time-up') {\n270\t      emit('time-up', [{ graceMs: m.graceMs }]);\n271\t    } else if (m.type === 'end') {\n272\t      ended = true;\n273\t      if (progressTimer) clearTimeout(progressTimer);\n274\t      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n275\t    } else {\n276\t      // An event this client has never heard of: hand it on as it came.\n277\t      var detail = {};\n278\t      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n279\t      emit(m.type, [detail]);\n280\t    }\n281\t  }\n282\t\n283\t  function info() {\n284\t    var out = {};\n285\t    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n286\t    out.players = hub.players.slice();\n287\t    return out;\n288\t  }\n289\t\n290\t  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n291\t  hub.connect = function (opts) {\n292\t    if (connecting) return connecting.promise;\n293\t    var done;\n294\t    var promise = new Promise(function (resolve) {\n295\t      done = resolve;\n296\t    });\n297\t    connecting = { promise: promise, resolve: done };\n298\t    if (!hub.active) {\n299\t      done(null);\n300\t      return promise;\n301\t    }\n302\t    opts = opts || {};\n303\t    root.addEventListener('message', onMessage);\n304\t    var started = now();\n305\t    var hello = function () {\n306\t      if (welcomed) return;\n307\t      if (now() - started > HELLO_TIMEOUT_MS) {\n308\t        standAlone();\n30