{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J472LxC3AgoRt5ZVeKmvZA","type":"tool_result","content":"/**\n * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n */\nexport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\nexport interface GamepadLike {\n    readonly connected?: boolean;\n    readonly mapping?: string;\n    readonly axes: readonly number[];\n    readonly buttons: readonly {\n        readonly pressed: boolean;\n        readonly value?: number;\n    }[];\n}\n/**\n * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n * direction is kept (no square-gate snapping to the axes).\n */\nexport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n    x: number;\n    y: number;\n};\n/** How long a queued press stays consumable, in seconds of game time. */\nexport declare const PRESS_WINDOW = 0.15;\n/**\n * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n * from the frame before.\n */\nexport interface InputFrame {\n    /** Real seconds this frame lasted (game time follows from it). */\n    dt: number;\n    /** Keys held, keyboard and gamepad buttons together, sorted. */\n    held?: string[];\n    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n    pressed?: string[];\n    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n    analog?: [number, number];\n    pad?: [number, number];\n    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n    delta?: [number, number];\n    wheel?: number;\n    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n    pointer?: [number, number, number, number];\n    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n    gamepad?: boolean;\n    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n    touch?: boolean;\n    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n    clicks?: [string, 0 | 1, number, number][];\n    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n    commands?: unknown[];\n    /**\n     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n     * callbacks ran between them. A replay waits for them before every other frame.\n     */\n    sync?: true;\n}\n/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\nexport interface InputState {\n    readonly held: readonly string[];\n    /** Queued presses: [key, seconds of game time since it was pressed]. */\n    readonly queued: readonly (readonly [string, number])[];\n    readonly pointer: readonly [number, number, number, number];\n    readonly gamepad: boolean;\n    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n    readonly outbox: readonly unknown[];\n}\n/** What the frame before held, for `snapshot()` to leave out what did not change. */\nexport interface SnapshotMemory {\n    held: string;\n    pointer: string;\n    gamepad?: boolean;\n    touch?: boolean;\n}\n/**\n * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n */\nexport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\nexport declare const TOUCH_KEY = \"Touch\";\n/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\nexport interface ButtonEvent {\n    readonly code: string;\n    readonly down: boolean;\n    readonly x: number;\n    readonly y: number;\n}\n/**\n * Keyboard + pointer + gamepad input.\n * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n *   right stick feeds the pointer delta (camera look), buttons press key codes\n *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n *   a frame is not lost.\n * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n *   and recorded with it.\n * - `dispose()` removes every listener it added.\n */\nexport declare class Input {\n    private readonly target;\n    private readonly held;\n    private readonly pressed;\n    /** Queued presses → the game time they happened at. */\n    private readonly queued;\n    /** Keys held through gamepad buttons (merged into isDown). */\n    private readonly padHeld;\n    private readonly listeners;\n    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n    readonly mouseDelta: {\n        x: number;\n        y: number;\n    };\n    /**\n     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n     * Under pointer lock it is the screen's centre (the crosshair).\n     */\n    readonly pointer: {\n        x: number;\n        y: number;\n        over: boolean;\n        touch: boolean;\n    };\n    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n    wheel: number;\n    /** This frame's button presses and releases, in order (`buttonEvents`). */\n    private _buttonEvents;\n    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n    private outbox;\n    private _commands;\n    private lockTarget;\n    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n    wantsPointerLock: boolean;\n    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n    readonly analog: {\n        x: number;\n        y: number;\n    };\n    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n    readonly padAxis: {\n        x: number;\n        y: number;\n    };\n    /** True while any gamepad is connected. */\n    gamepadConnected: boolean;\n    /**\n     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n     */\n    readonly preventKeys: Set<string>;\n    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n    gamepadButtons: Record<number, string>;\n    /** Stick deadzone (radial, 0..1). */\n    gamepadDeadzone: number;\n    /** Right stick look speed: pointer pixels per second at full tilt. */\n    gamepadLookSpeed: number;\n    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n    now: number;\n    /**\n     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n     * are ignored, and `playBefore` / `playAfter` set everything.\n     */\n    get playing(): boolean;\n    set playing(on: boolean);\n    private _playing;\n    private playedPad;\n    /** Queued presses older than this many seconds of game time are dropped. */\n    pressWindow: number;\n    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n    constructor(target?: Window | null);\n    /**\n     * Listen for pointer input on the game canvas. Only pointers that went down on the\n     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n     * pinch to zoom (emitted as wheel ticks).\n     */\n    attachPointer(el: HTMLElement): void;\n    /** Remove every listener this Input added (window and canvas). */\n    dispose(): void;\n    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n    release(): void;\n    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n    reset(): void;\n    /**\n     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n     */\n    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n    get pointerLocked(): boolean;\n    isDown(...codes: string[]): boolean;\n    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n    anyDown(codes: readonly string[]): boolean;\n    /** True once per physical key press (valid for the current render frame). */\n    wasPressed(...codes: string[]): boolean;\n    /**\n     * True once per physical key press, kept until consumed or until it is older than\n     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n     * several times per frame) so no press is dropped, while a stale press (made during a\n     * pause, a loading screen or a long hitch) never fires late.\n     */\n    consumePress(...codes: string[]): boolean;\n    /** `consumePress` for a list of codes, without building a rest-argument array. */\n    consumeAny(codes: readonly string[]): boolean;\n    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n    state(): InputState;\n    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n    setState(s: InputState, now: number): void;\n    /** Presses waiting to be consumed (tooling / tests). */\n    get queuedPresses(): string[];\n    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n    clearQueued(...codes: string[]): void;\n    /**\n     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n     */\n    moveAxis(): {\n        x: number;\n        y: number;\n    };\n    /** Call at the end of each rendered frame. */\n    endFrame(): void;\n    /** Test hook: simulate a key being held (true) or released (false). */\n    setKey(code: string, down: boolean): void;\n    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n    setPointer(x: number, y: number, down?: boolean): void;\n    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n    setButtons(bits: number): void;\n    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n    get mouseButtons(): number;\n    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n    private button;\n    /**\n     * This frame's pointer button presses and releases, in order, each with where the pointer\n     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n     */\n    get buttonEvents(): readonly ButtonEvent[];\n    /**\n     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n     * a save read from storage, anything a game would otherwise take straight from the page. It\n     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n     * through JSON first: live play reads exactly what a replay will.\n     */\n    send(command: unknown): void;\n    /**\n     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n     */\n    get commands(): readonly unknown[];\n    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n    deliver(): void;\n    /** Test hook: inject pointer movement / wheel for the next frame. */\n    addPointer(dx: number, dy: number, wheel?: number): void;\n    /**\n     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n     * before: unchanged held keys, pointer and gamepad connection are left out.\n     */\n    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n    /**\n     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n     * at the time they would have arrived, the frame before's game time).\n     */\n    playBefore(f: InputFrame): void;\n    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n    playAfter(f: InputFrame): void;\n    private press;\n    private pollGamepads;\n}\n/**\n * A drivable car on Rapier's ray-cast vehicle controller: a dynamic chassis on four wheels\n * that are rays with springs (suspension), each with grip along and across it. Throttle drives\n * the rear wheels, steering turns the front ones (less at speed), the brake slows all four and\n * the handbrake locks the rear and lets them slide: a drift. Everything is tunable live.\n *\n *   const car = new Vehicle(physics, { at: [0, 1, 0] });\n *   // per fixed step: car.drive({ throttle, steer, brake, handbrake }, dt)\n *   // per frame: car.wheelPose(i, outPosition, outQuaternion) for the wheel meshes\n */\nimport { Quaternion, Vector3 } from 'three/webgpu';\nimport { type Physics, RAPIER } from './Physics';\nexport interface VehicleOptions {\n    at: readonly [number, number, number];\n    /** Heading (radians about Y; 0 drives toward +Z). */\n    yaw?: number;\n    /** Chassis half extents (m). Default [0.9, 0.35, 1.8]. */\n    size?: readonly [number, number, number];\n    /** Chassis mass in world units. Default 8. */\n    mass?: number;\n    wheelRadius?: number;\n    /** Suspension rest length and stiffness. */\n    suspension?: number;\n    stiffness?: number;\n    /** Forward drive force per driven wheel at full throttle. Default 30. */\n    power?: number;\n    /** The engine gives out toward this speed (m/s). Default 16. */\n    topSpeed?: number;\n    /** Most steering angle (radians). Default 0.55. */\n    steer?: number;\n    /** Grip (friction slip): how much sideways force the tyres hold before sliding. Default 2.2. */\n    grip?: number;\n    /** Most spin (rad/s) the handbrake's drift push builds up. Default 2.4; 0 turns the assist off. */\n    driftYaw?: number;\n}\nexport interface DriveInput {\n    /** -1 (reverse) … 1 */\n    throttle: number;\n    /** -1 (left) … 1 (right) */\n    steer: number;\n    brake?: boolean;\n    handbrake?: boolean;\n}\nexport declare class Vehicle {\n    private readonly physics;\n    readonly body: RAPIER.RigidBody;\n    readonly controller: RAPIER.DynamicRayCastVehicleController;\n    readonly o: Required<Omit<VehicleOptions, 'at' | 'yaw'>>;\n    /** Wheels' chassis-space mount points (front left, front right, rear left, rear right). */\n    readonly mounts: [number, number, number][];\n    /** Smoothed steering (-1..1). */\n    steering: number;\n    /** How fast the car slides sideways (m/s), and the angle between where it points and where it goes (radians): drifting when high. */\n    slip: number;\n    slipAngle: number;\n    private readonly q;\n    private readonly q2;\n    private readonly v;\n    constructor(physics: Physics, o: VehicleOptions);\n    /** Spring stiffness of every wheel's suspension (live). */\n    setSuspension(stiffness: number): void;\n    /**\n     * Speed along the car's heading (m/s, negative reversing). Not Rapier's\n     * `currentVehicleSpeed`, which counts the up-and-down too (the suspension holding the body up\n     * against gravity every step reads as a crawl when parked).\n     */\n    get speed(): number;\n    /** One fixed step of driving. */\n    drive(input: DriveInput, dt: number): void;\n    /**\n     * Where wheel `i` is drawn: on its suspension, turned by steering and spin. In the world, or\n     * with `local` in the chassis' own space (a wheel mesh parented to a chassis mesh that a\n     * physics binding draws between steps).\n     */\n    wheelPose(i: number, pos: Vector3, rot: Quaternion, local?: boolean): void;\n    /** The chassis' heading (radians about Y; 0 drives toward +Z). */\n    get yaw(): number;\n    /** Put it back on its wheels at `at` (a reset after a roll). */\n    reset(at: readonly [number, number, number], yaw?: number): void;\n    dispose(): void;\n}\n/**\n * Terrain from a height function: a grid of heights drawn as a flat-shaded mesh coloured by\n * height and slope (beach, grass, rock, snow), and the same grid as a Rapier heightfield the\n * character walks on. `erode` runs hydraulic erosion: raindrops that roll downhill, pick up\n * soil where they speed up and drop it where they slow, carving gullies and filling valleys.\n *\n *   const land = new Terrain({ size: [40, 30], cells: [80, 60] });\n *   land.generate((x, z) => 4 * noise.fbm2(x * 0.04, z * 0.04));\n *   land.erode();                         // about one raindrop per grid point\n *   land.attach(physics);                 // the heightfield collider (again after a change)\n *   scene.add(land.mesh);\n *   land.heightAt(x, z);                  // what the collider says, between the grid points too\n *\n * The grid's cells are split into triangles the way Rapier splits its heightfield (the\n * diagonal from the cell's +x corner to its +z corner), so mesh, `heightAt` and collider agree.\n */\nimport { Mesh, Vector3 } from 'three/webgpu';\nimport { type Physics, RAPIER } from '../physics/Physics';\nexport interface TerrainBand {\n    /** Heights below this (metres above the terrain's origin) take this colour. */\n    below: number;\n    color: number;\n}\nexport interface TerrainOptions {\n    /** Size in metres along x and z (default [32, 32]). */\n    size?: readonly [number, number];\n    /** Cells along x and z (default one per metre). */\n    cells?: readonly [number, number];\n    /** Where the middle of the grid's height 0 is (default the origin). */\n    at?: readonly [number, number, number];\n    /** Colour by height, lowest first; the last band takes everything above. */\n    bands?: readonly TerrainBand[];\n    /** Faces steeper than this (their normal's y below it) are rock. Default 0.72 (about 44°). */\n    steep?: number;\n    rock?: number;\n}\nexport interface ErosionOptions {\n    /** Raindrops to roll (default one per grid point). */\n    droplets?: number;\n    seed?: number;\n    /** Steps a drop lives (default 40). */\n    lifetime?: number;\n    /** How much a drop keeps its direction instead of following the slope (0..1, default 0.05). */\n    inertia?: number;\n    /** Soil a drop can carry, per unit of speed, water and drop in height (default 4). */\n    capacity?: number;\n    /** Fraction of its spare capacity a drop digs up per step (default 0.3). */\n    erode?: number;\n    /** Fraction of its excess it lays down per step (default 0.3). */\n    deposit?: number;\n    /** Water lost per step (default 0.02). */\n    evaporate?: number;\n    /** How fast drops speed up downhill (default 4). */\n    gravity?: number;\n    /** Radius (whole cells) a drop digs over, so it carves gullies rather than pits (default 2). */\n    radius?: number;\n    /** Grid points along each edge left exactly as they are (default 0): where the land meets a floor or a wall. */\n    margin?: number;\n}\n/** Sea, beach, grass, forest, rock, snow (the engine palette). */\nexport declare const TERRAIN_BANDS: readonly TerrainBand[];\nexport declare class Terrain {\n    readonly nx: number;\n    readonly nz: number;\n    readonly sizeX: number;\n    readonly sizeZ: number;\n    readonly at: readonly [number, number, number];\n    /** Heights at the grid points, row by row along z: `heights[ix + iz * (nx + 1)]`. */\n    readonly heights: Float32Array;\n    readonly mesh: Mesh;\n    collider: RAPIER.Collider | null;\n    private readonly bands;\n    private readonly steep;\n    private readonly rock;\n    private physics;\n    constructor(o?: TerrainOptions);\n    /** Metres between grid points along x and z. */\n    get cell(): [number, number];\n    /** World x, z of grid point (ix, iz). */\n    pointX(ix: number): number;\n    pointZ(iz: number): number;\n    /** Fill the heights from `f(x, z)` (world x, z; metres above the terrain's origin), then redraw. */\n    generate(f: (x: number, z: number) => number): this;\n    private h;\n    /**\n     * Height of the surface at world (x, z), in world y: the triangle it is over, as the mesh and\n     * the collider have it. Outside the grid: its nearest edge.\n     */\n    heightAt(x: number, z: number): number;\n    /** The surface's normal at world (x, z) (central differences over half a cell). */\n    normalAt(x: number, z: number, out?: Vector3): Vector3;\n    /** Redraw the mesh from the heights (positions, flat normals, colours per face). */\n    update(): void;\n    private bandColor;\n    /**\n     * Make (or remake, after `generate` / `erode`) the heightfield collider: a fixed body at the\n     * terrain's origin. Returns it.\n     */\n    attach(physics: Physics): RAPIER.Collider;\n    /** Remove the collider (the mesh stays). */\n    detach(): void;\n    /** The collider and the mesh's geometry go (the shared material stays). */\n    dispose(): void;\n    /**\n     * Hydraulic erosion: `droplets` raindrops, each rolling downhill from a random point. A drop\n     * carries soil up to a capacity that grows with its speed, water and how steeply it is\n     * falling: below capacity it digs (over a small radius), above it, or going uphill, it drops\n     * soil. It evaporates as it goes. Redraws when done; reattach the collider after.\n     */\n    erode(o?: ErosionOptions): void;\n}\nimport type { Framing, Resolution } from '../framing';\nimport { type PaletteColor } from '../palette';\n/** Where an element is attached on screen; it is also aligned that way (right-anchored text grows left). */\nexport type HudAnchor = 'top-left' | 'top' | 'top-right' | 'left' | 'center' | 'right' | 'bottom-left' | 'bottom' | 'bottom-right';\nexport type HudColor = PaletteColor | number;\nexport interface HudOptions {\n    /** Default 'white'. */\n    color?: HudColor;\n    /** 1-pixel drop shadow color, or false. Default 'ink'. */\n    shadow?: HudColor | false;\n    /** Integer art-pixel scale (2 = double-size glyphs). Default 1. */\n    scale?: number;\n    /** Default 'top-left': x/y are offsets from that screen corner/edge, in art pixels. */\n    anchor?: HudAnchor;\n}\n/**\n * Pixel HUD: crisp text and icons drawn in art pixels on top of the game, never through\n * the post filters. It is a 2D canvas at the internal resolution (480×270 / 320×180),\n * laid over the game canvas with the same integer scale and letterbox offset\n * (`framing.ts`), so one HUD pixel is exactly one art pixel at every resolution.\n *\n * Retained: what you add stays on screen until `clear()`. Redraw everything each frame\n * (clear + add) or only when something changes; the canvas repaints only when the content,\n * resolution or framing changed. Available as `ctx.hud`.\n *\n *   ctx.hud.clear();\n *   ctx.hud.text(4, 4, `COINS ${n}/12`, { color: 'sand' });\n *   ctx.hud.text(4, 4, 'PAUSED', { anchor: 'center', scale: 2 });\n */\nexport declare class Hud {\n    private readonly container;\n    /** The overlay canvas (created on the first draw; null when nothing was ever drawn). */\n    canvas: HTMLCanvasElement | null;\n    visible: boolean;\n    private items;\n    private drawn;\n    private size;\n    private layoutKey;\n    constructor(container: HTMLElement | null);\n    /** HUD width/height in art pixels (the internal resolution). */\n    get width(): number;\n    get height(): number;\n    /** Text in the 5×7 bitmap font (uppercase; digits and common punctuation). */\n    text(x: number, y: number, text: string, options?: HudOptions): void;\n    /** A filled rectangle (panels, bars). */\n    rect(x: number, y: number, w: number, h: number, color: HudColor, anchor?: HudAnchor): void;\n    /**\n     * A tiny pixel-art icon as data: one string per row, one character per pixel, mapped\n     * through `colors` ('.' or ' ' = transparent).\n     *\n     *   hud.sprite(4, 4, ['.yy.', 'ywyy', 'yyyy', '.yy.'], { y: 'sand', w: 'white' });\n     */\n    sprite(x: number, y: number, rows: readonly string[], colors: Record<string, HudColor>, options?: HudOptions): void;\n    /** Remove everything. */\n    clear(): void;\n    /** Size of `text` in art pixels at `scale`. */\n    measure(text: string, scale?: number): {\n        width: number;\n        height: number;\n    };\n    /** Engine: follow the renderer's resolution and framing, and repaint if needed. */\n    sync(resolution: Resolution, framing: Framing): void;\n    dispose(): void;\n    private createCanvas;\n    private paint;\n    private glyphs;\n    private place;\n}\n/**\n * Top-left corner, in whole art pixels, of a w×h element placed at offset (x, y) from\n * `anchor` on a screen of `size` art pixels. Pure (unit-tested).\n */\nexport declare function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number];","is_error":false}]},"parent_tool_use_id":null,"session_id":"a7680a17-bf1f-4ce7-9c9a-ea1ace567b93","uuid":"ab786b6a-05e6-48dc-ab25-634a419da693","timestamp":"2026-11-05T04:21:46.754Z","tool_use_result":{"stdout":"/**\n * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n */\nexport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\nexport interface GamepadLike {\n    readonly connected?: boolean;\n    readonly mapping?: string;\n    readonly axes: readonly number[];\n    readonly buttons: readonly {\n        readonly pressed: boolean;\n        readonly value?: number;\n    }[];\n}\n/**\n * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n * direction is kept (no square-gate snapping to the axes).\n */\nexport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n    x: number;\n    y: number;\n};\n/** How long a queued press stays consumable, in seconds of game time. */\nexport declare const PRESS_WINDOW = 0.15;\n/**\n * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n * from the frame before.\n */\nexport interface InputFrame {\n    /** Real seconds this frame lasted (game time follows from it). */\n    dt: number;\n    /** Keys held, keyboard and gamepad buttons together, sorted. */\n    held?: string[];\n    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n    pressed?: string[];\n    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n    analog?: [number, number];\n    pad?: [number, number];\n    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n    delta?: [number, number];\n    wheel?: number;\n    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n    pointer?: [number, number, number, number];\n    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n    gamepad?: boolean;\n    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n    touch?: boolean;\n    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n    clicks?: [string, 0 | 1, number, number][];\n    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n    commands?: unknown[];\n    /**\n     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n     * callbacks ran between them. A replay waits for them before every other frame.\n     */\n    sync?: true;\n}\n/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\nexport interface InputState {\n    readonly held: readonly string[];\n    /** Queued presses: [key, seconds of game time since it was pressed]. */\n    readonly queued: readonly (readonly [string, number])[];\n    readonly pointer: readonly [number, number, number, number];\n    readonly gamepad: boolean;\n    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n    readonly outbox: readonly unknown[];\n}\n/** What the frame before held, for `snapshot()` to leave out what did not change. */\nexport interface SnapshotMemory {\n    held: string;\n    pointer: string;\n    gamepad?: boolean;\n    touch?: boolean;\n}\n/**\n * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n */\nexport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\nexport declare const TOUCH_KEY = \"Touch\";\n/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\nexport interface ButtonEvent {\n    readonly code: string;\n    readonly down: boolean;\n    readonly x: number;\n    readonly y: number;\n}\n/**\n * Keyboard + pointer + gamepad input.\n * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n *   right stick feeds the pointer delta (camera look), buttons press key codes\n *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n *   a frame is not lost.\n * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n *   and recorded with it.\n * - `dispose()` removes every listener it added.\n */\nexport declare class Input {\n    private readonly target;\n    private readonly held;\n    private readonly pressed;\n    /** Queued presses → the game time they happened at. */\n    private readonly queued;\n    /** Keys held through gamepad buttons (merged into isDown). */\n    private readonly padHeld;\n    private readonly listeners;\n    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n    readonly mouseDelta: {\n        x: number;\n        y: number;\n    };\n    /**\n     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n     * Under pointer lock it is the screen's centre (the crosshair).\n     */\n    readonly pointer: {\n        x: number;\n        y: number;\n        over: boolean;\n        touch: boolean;\n    };\n    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n    wheel: number;\n    /** This frame's button presses and releases, in order (`buttonEvents`). */\n    private _buttonEvents;\n    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n    private outbox;\n    private _commands;\n    private lockTarget;\n    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n    wantsPointerLock: boolean;\n    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n    readonly analog: {\n        x: number;\n        y: number;\n    };\n    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n    readonly padAxis: {\n        x: number;\n        y: number;\n    };\n    /** True while any gamepad is connected. */\n    gamepadConnected: boolean;\n    /**\n     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n     */\n    readonly preventKeys: Set<string>;\n    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n    gamepadButtons: Record<number, string>;\n    /** Stick deadzone (radial, 0..1). */\n    gamepadDeadzone: number;\n    /** Right stick look speed: pointer pixels per second at full tilt. */\n    gamepadLookSpeed: number;\n    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n    now: number;\n    /**\n     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n     * are ignored, and `playBefore` / `playAfter` set everything.\n     */\n    get playing(): boolean;\n    set playing(on: boolean);\n    private _playing;\n    private playedPad;\n    /** Queued presses older than this many seconds of game time are dropped. */\n    pressWindow: number;\n    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n    constructor(target?: Window | null);\n    /**\n     * Listen for pointer input on the game canvas. Only pointers that went down on the\n     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n     * pinch to zoom (emitted as wheel ticks).\n     */\n    attachPointer(el: HTMLElement): void;\n    /** Remove every listener this Input added (window and canvas). */\n    dispose(): void;\n    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n    release(): void;\n    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n    reset(): void;\n    /**\n     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n     */\n    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n    get pointerLocked(): boolean;\n    isDown(...codes: string[]): boolean;\n    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n    anyDown(codes: readonly string[]): boolean;\n    /** True once per physical key press (valid for the current render frame). */\n    wasPressed(...codes: string[]): boolean;\n    /**\n     * True once per physical key press, kept until consumed or until it is older than\n     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n     * several times per frame) so no press is dropped, while a stale press (made during a\n     * pause, a loading screen or a long hitch) never fires late.\n     */\n    consumePress(...codes: string[]): boolean;\n    /** `consumePress` for a list of codes, without building a rest-argument array. */\n    consumeAny(codes: readonly string[]): boolean;\n    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n    state(): InputState;\n    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n    setState(s: InputState, now: number): void;\n    /** Presses waiting to be consumed (tooling / tests). */\n    get queuedPresses(): string[];\n    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n    clearQueued(...codes: string[]): void;\n    /**\n     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n     */\n    moveAxis(): {\n        x: number;\n        y: number;\n    };\n    /** Call at the end of each rendered frame. */\n    endFrame(): void;\n    /** Test hook: simulate a key being held (true) or released (false). */\n    setKey(code: string, down: boolean): void;\n    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n    setPointer(x: number, y: number, down?: boolean): void;\n    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n    setButtons(bits: number): void;\n    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n    get mouseButtons(): number;\n    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n    private button;\n    /**\n     * This frame's pointer button presses and releases, in order, each with where the pointer\n     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n     */\n    get buttonEvents(): readonly ButtonEvent[];\n    /**\n     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n     * a save read from storage, anything a game would otherwise take straight from the page. It\n     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n     * through JSON first: live play reads exactly what a replay will.\n     */\n    send(command: unknown): void;\n    /**\n     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n     */\n    get commands(): readonly unknown[];\n    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n    deliver(): void;\n    /** Test hook: inject pointer movement / wheel for the next frame. */\n    addPointer(dx: number, dy: number, wheel?: number): void;\n    /**\n     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n     * before: unchanged held keys, pointer and gamepad connection are left out.\n     */\n    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n    /**\n     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n     * at the time they would have arrived, the frame before's game time).\n     */\n    playBefore(f: InputFrame): void;\n    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n    playAfter(f: InputFrame): void;\n    private press;\n    private pollGamepads;\n}\n/**\n * A drivable car on Rapier's ray-cast vehicle controller: a dynamic chassis on four wheels\n * that are rays with springs (suspension), each with grip along and across it. Throttle drives\n * the rear wheels, steering turns the front ones (less at speed), the brake slows all four and\n * the handbrake locks the rear and lets them slide: a drift. Everything is tunable live.\n *\n *   const car = new Vehicle(physics, { at: [0, 1, 0] });\n *   // per fixed step: car.drive({ throttle, steer, brake, handbrake }, dt)\n *   // per frame: car.wheelPose(i, outPosition, outQuaternion) for the wheel meshes\n */\nimport { Quaternion, Vector3 } from 'three/webgpu';\nimport { type Physics, RAPIER } from './Physics';\nexport interface VehicleOptions {\n    at: readonly [number, number, number];\n    /** Heading (radians about Y; 0 drives toward +Z). */\n    yaw?: number;\n    /** Chassis half extents (m). Default [0.9, 0.35, 1.8]. */\n    size?: readonly [number, number, number];\n    /** Chassis mass in world units. Default 8. */\n    mass?: number;\n    wheelRadius?: number;\n    /** Suspension rest length and stiffness. */\n    suspension?: number;\n    stiffness?: number;\n    /** Forward drive force per driven wheel at full throttle. Default 30. */\n    power?: number;\n    /** The engine gives out toward this speed (m/s). Default 16. */\n    topSpeed?: number;\n    /** Most steering angle (radians). Default 0.55. */\n    steer?: number;\n    /** Grip (friction slip): how much sideways force the tyres hold before sliding. Default 2.2. */\n    grip?: number;\n    /** Most spin (rad/s) the handbrake's drift push builds up. Default 2.4; 0 turns the assist off. */\n    driftYaw?: number;\n}\nexport interface DriveInput {\n    /** -1 (reverse) … 1 */\n    throttle: number;\n    /** -1 (left) … 1 (right) */\n    steer: number;\n    brake?: boolean;\n    handbrake?: boolean;\n}\nexport declare class Vehicle {\n    private readonly physics;\n    readonly body: RAPIER.RigidBody;\n    readonly controller: RAPIER.DynamicRayCastVehicleController;\n    readonly o: Required<Omit<VehicleOptions, 'at' | 'yaw'>>;\n    /** Wheels' chassis-space mount points (front left, front right, rear left, rear right). */\n    readonly mounts: [number, number, number][];\n    /** Smoothed steering (-1..1). */\n    steering: number;\n    /** How fast the car slides sideways (m/s), and the angle between where it points and where it goes (radians): drifting when high. */\n    slip: number;\n    slipAngle: number;\n    private readonly q;\n    private readonly q2;\n    private readonly v;\n    constructor(physics: Physics, o: VehicleOptions);\n    /** Spring stiffness of every wheel's suspension (live). */\n    setSuspension(stiffness: number): void;\n    /**\n     * Speed along the car's heading (m/s, negative reversing). Not Rapier's\n     * `currentVehicleSpeed`, which counts the up-and-down too (the suspension holding the body up\n     * against gravity every step reads as a crawl when parked).\n     */\n    get speed(): number;\n    /** One fixed step of driving. */\n    drive(input: DriveInput, dt: number): void;\n    /**\n     * Where wheel `i` is drawn: on its suspension, turned by steering and spin. In the world, or\n     * with `local` in the chassis' own space (a wheel mesh parented to a chassis mesh that a\n     * physics binding draws between steps).\n     */\n    wheelPose(i: number, pos: Vector3, rot: Quaternion, local?: boolean): void;\n    /** The chassis' heading (radians about Y; 0 drives toward +Z). */\n    get yaw(): number;\n    /** Put it back on its wheels at `at` (a reset after a roll). */\n    reset(at: readonly [number, number, number], yaw?: number): void;\n    dispose(): void;\n}\n/**\n * Terrain from a height function: a grid of heights drawn as a flat-shaded mesh coloured by\n * height and slope (beach, grass, rock, snow), and the same grid as a Rapier heightfield the\n * character walks on. `erode` runs hydraulic erosion: raindrops that roll downhill, pick up\n * soil where they speed up and drop it where they slow, carving gullies and filling valleys.\n *\n *   const land = new Terrain({ size: [40, 30], cells: [80, 60] });\n *   land.generate((x, z) => 4 * noise.fbm2(x * 0.04, z * 0.04));\n *   land.erode();                         // about one raindrop per grid point\n *   land.attach(physics);                 // the heightfield collider (again after a change)\n *   scene.add(land.mesh);\n *   land.heightAt(x, z);                  // what the collider says, between the grid points too\n *\n * The grid's cells are split into triangles the way Rapier splits its heightfield (the\n * diagonal from the cell's +x corner to its +z corner), so mesh, `heightAt` and collider agree.\n */\nimport { Mesh, Vector3 } from 'three/webgpu';\nimport { type Physics, RAPIER } from '../physics/Physics';\nexport interface TerrainBand {\n    /** Heights below this (metres above the terrain's origin) take this colour. */\n    below: number;\n    color: number;\n}\nexport interface TerrainOptions {\n    /** Size in metres along x and z (default [32, 32]). */\n    size?: readonly [number, number];\n    /** Cells along x and z (default one per metre). */\n    cells?: readonly [number, number];\n    /** Where the middle of the grid's height 0 is (default the origin). */\n    at?: readonly [number, number, number];\n    /** Colour by height, lowest first; the last band takes everything above. */\n    bands?: readonly TerrainBand[];\n    /** Faces steeper than this (their normal's y below it) are rock. Default 0.72 (about 44°). */\n    steep?: number;\n    rock?: number;\n}\nexport interface ErosionOptions {\n    /** Raindrops to roll (default one per grid point). */\n    droplets?: number;\n    seed?: number;\n    /** Steps a drop lives (default 40). */\n    lifetime?: number;\n    /** How much a drop keeps its direction instead of following the slope (0..1, default 0.05). */\n    inertia?: number;\n    /** Soil a drop can carry, per unit of speed, water and drop in height (default 4). */\n    capacity?: number;\n    /** Fraction of its spare capacity a drop digs up per step (default 0.3). */\n    erode?: number;\n    /** Fraction of its excess it lays down per step (default 0.3). */\n    deposit?: number;\n    /** Water lost per step (default 0.02). */\n    evaporate?: number;\n    /** How fast drops speed up downhill (default 4). */\n    gravity?: number;\n    /** Radius (whole cells) a drop digs over, so it carves gullies rather than pits (default 2). */\n    radius?: number;\n    /** Grid points along each edge left exactly as they are (default 0): where the land meets a floor or a wall. */\n    margin?: number;\n}\n/** Sea, beach, grass, forest, rock, snow (the engine palette). */\nexport declare const TERRAIN_BANDS: readonly TerrainBand[];\nexport declare class Terrain {\n    readonly nx: number;\n    readonly nz: number;\n    readonly sizeX: number;\n    readonly sizeZ: number;\n    readonly at: readonly [number, number, number];\n    /** Heights at the grid points, row by row along z: `heights[ix + iz * (nx + 1)]`. */\n    readonly heights: Float32Array;\n    readonly mesh: Mesh;\n    collider: RAPIER.Collider | null;\n    private readonly bands;\n    private readonly steep;\n    private readonly rock;\n    private physics;\n    constructor(o?: TerrainOptions);\n    /** Metres between grid points along x and z. */\n    get cell(): [number, number];\n    /** World x, z of grid point (ix, iz). */\n    pointX(ix: number): number;\n    pointZ(iz: number): number;\n    /** Fill the heights from `f(x, z)` (world x, z; metres above the terrain's origin), then redraw. */\n    generate(f: (x: number, z: number) => number): this;\n    private h;\n    /**\n     * Height of the surface at world (x, z), in world y: the triangle it is over, as the mesh and\n     * the collider have it. Outside the grid: its nearest edge.\n     */\n    heightAt(x: number, z: number): number;\n    /** The surface's normal at world (x, z) (central differences over half a cell). */\n    normalAt(x: number, z: number, out?: Vector3): Vector3;\n    /** Redraw the mesh from the heights (positions, flat normals, colours per face). */\n    update(): void;\n    private bandColor;\n    /**\n     * Make (or remake, after `generate` / `erode`) the heightfield collider: a fixed body at the\n     * terrain's origin. Returns it.\n     */\n    attach(physics: Physics): RAPIER.Collider;\n    /** Remove the collider (the mesh stays). */\n    detach(): void;\n    /** The collider and the mesh's geometry go (the shared material stays). */\n    dispose(): void;\n    /**\n     * Hydraulic erosion: `droplets` raindrops, each rolling downhill from a random point. A drop\n     * carries soil up to a capacity that grows with its speed, water and how steeply it is\n     * falling: below capacity it digs (over a small radius), above it, or going uphill, it drops\n     * soil. It evaporates as it goes. Redraws when done; reattach the collider after.\n     */\n    erode(o?: ErosionOptions): void;\n}\nimport type { Framing, Resolution } from '../framing';\nimport { type PaletteColor } from '../palette';\n/** Where an element is attached on screen; it is also aligned that way (right-anchored text grows left). */\nexport type HudAnchor = 'top-left' | 'top' | 'top-right' | 'left' | 'center' | 'right' | 'bottom-left' | 'bottom' | 'bottom-right';\nexport type HudColor = PaletteColor | number;\nexport interface HudOptions {\n    /** Default 'white'. */\n    color?: HudColor;\n    /** 1-pixel drop shadow color, or false. Default 'ink'. */\n    shadow?: HudColor | false;\n    /** Integer art-pixel scale (2 = double-size glyphs). Default 1. */\n    scale?: number;\n    /** Default 'top-left': x/y are offsets from that screen corner/edge, in art pixels. */\n    anchor?: HudAnchor;\n}\n/**\n * Pixel HUD: crisp text and icons drawn in art pixels on top of the game, never through\n * the post filters. It is a 2D canvas at the internal resolution (480×270 / 320×180),\n * laid over the game canvas with the same integer scale and letterbox offset\n * (`framing.ts`), so one HUD pixel is exactly one art pixel at every resolution.\n *\n * Retained: what you add stays on screen until `clear()`. Redraw everything each frame\n * (clear + add) or only when something changes; the canvas repaints only when the content,\n * resolution or framing changed. Available as `ctx.hud`.\n *\n *   ctx.hud.clear();\n *   ctx.hud.text(4, 4, `COINS ${n}/12`, { color: 'sand' });\n *   ctx.hud.text(4, 4, 'PAUSED', { anchor: 'center', scale: 2 });\n */\nexport declare class Hud {\n    private readonly container;\n    /** The overlay canvas (created on the first draw; null when nothing was ever drawn). */\n    canvas: HTMLCanvasElement | null;\n    visible: boolean;\n    private items;\n    private drawn;\n    private size;\n    private layoutKey;\n    constructor(container: HTMLElement | null);\n    /** HUD width/height in art pixels (the internal resolution). */\n    get width(): number;\n    get height(): number;\n    /** Text in the 5×7 bitmap font (uppercase; digits and common punctuation). */\n    text(x: number, y: number, text: string, options?: HudOptions): void;\n    /** A filled rectangle (panels, bars). */\n    rect(x: number, y: number, w: number, h: number, color: HudColor, anchor?: HudAnchor): void;\n    /**\n     * A tiny pixel-art icon as data: one string per row, one character per pixel, mapped\n     * through `colors` ('.' or ' ' = transparent).\n     *\n     *   hud.sprite(4, 4, ['.yy.', 'ywyy', 'yyyy', '.yy.'], { y: 'sand', w: 'white' });\n     */\n    sprite(x: number, y: number, rows: readonly string[], colors: Record<string, HudColor>, options?: HudOptions): void;\n    /** Remove everything. */\n    clear(): void;\n    /** Size of `text` in art pixels at `scale`. */\n    measure(text: string, scale?: number): {\n        width: number;\n        height: number;\n    };\n    /** Engine: follow the renderer's resolution and framing, and repaint if needed. */\n    sync(resolution: Resolution, framing: Framing): void;\n    dispose(): void;\n    private createCanvas;\n    private paint;\n    private glyphs;\n    private place;\n}\n/**\n * Top-left corner, in whole art pixels, of a w×h element placed at offset (x, y) from\n * `anchor` on a screen of `size` art pixels. Pure (unit-tested).\n */\nexport declare function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01J472LxC3AgoRt5ZVeKmvZA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
