{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKPbKMcGwYZpFThdLdpkZn","type":"tool_result","content":"1\t/**\n2\t * A meadow: thousands of grass blades in one instanced draw, bent by the vertex shader. Wind\n3\t * leans every blade and sends gusts across the field as visible waves; up to four pushers\n4\t * (the hero, a ball) part and flatten the blades around them. Blades are two crossed\n5\t * triangles (they read from any side), toon-lit as if they were the ground (an up normal), so\n6\t * they take the same light bands and shadows as the floor they stand on.\n7\t *\n8\t *   const grass = new GrassField({ area: [12, 8], at: [0, 0, 0], count: 6000 });\n9\t *   scene.add(grass);\n10\t *   // per frame: grass.update(t); grass.push(0, hero.position, 0.9)\n11\t *   grass.wind.set(2.5, 0.5);       // m/s-ish: direction and strength\n12\t */\n13\timport { InstancedMesh, Vector2, type Vector3Like } from 'three/webgpu';\n14\texport declare const MAX_PUSHERS = 4;\n15\texport interface GrassOptions {\n16\t    /** Width (x) and depth (z) of the patch, m. */\n17\t    area: readonly [number, number];\n18\t    /** Centre of the patch on the ground. */\n19\t    at: readonly [number, number, number];\n20\t    count: number;\n21\t    /** Blade heights (m): shortest and tallest. Default [0.25, 0.55]. */\n22\t    height?: readonly [number, number];\n23\t    /** Blade width at the root (m). Default 0.07. */\n24\t    width?: number;\n25\t    /** Colours (hex): roots and tips. */\n26\t    base?: number;\n27\t    tip?: number;\n28\t    /** Where blades grow (world x, z); default everywhere in the patch. */\n29\t    mask?: (x: number, z: number) => boolean;\n30\t    /** Ground height under a blade (default: the patch's y). */\n31\t    ground?: (x: number, z: number) => number;\n32\t    seed?: number;\n33\t}\n34\texport declare class GrassField extends InstancedMesh {\n35\t    /** Wind along x and z (its length is the strength). */\n36\t    readonly wind: Vector2;\n37\t    /** How far blades lean per unit of wind (m at the tip). Default 0.12. */\n38\t    sway: number;\n39\t    private readonly uTime;\n40\t    private readonly uWind;\n41\t    private readonly uSway;\n42\t    private readonly uPush;\n43\t    /** Blades actually placed (the mask can leave fewer than `count`). */\n44\t    readonly blades: number;\n45\t    constructor(o: GrassOptions);\n46\t    /** Pusher `i` (0..3): blades within `radius` of `at` part and flatten (radius 0: none). */\n47\t    push(i: number, at: Vector3Like | null, radius?: number): void;\n48\t    /** Per frame (game time). */\n49\t    update(time: number): void;\n50\t    dispose(): this;\n51\t}\n52\t/**\n53\t * Pixel sprites in a 3D world (Doom's monsters, Paper Mario, Octopath's characters): flat\n54\t * pictures that always face the camera, drawn with nearest sampling so their pixels stay\n55\t * square, cut out by alpha (no blending), animated by flipping frames of a sheet. Many\n56\t * sprites of one sheet are one instanced draw; each has its own position, size, frame and\n57\t * mirror. Sheets can be drawn in code (`drawSheet`), so a game needs no image files.\n58\t *\n59\t *   const sheet = drawSheet({ frame: [16, 16], frames: 4 }, (g, f) => { g.fillStyle = '#f4f4f4'; g.fillRect(4, 4 + (f % 2), 8, 8); });\n60\t *   const sprites = new SpriteBatch(sheet, { capacity: 64 });\n61\t *   const s = sprites.spawn([0, 1, 0], { size: 1 });\n62\t *   sprites.set(s, { frame: 2, flip: true });       // move, animate and mirror whenever\n63\t *\n64\t * Sprite positions are in the batch's own space: leave the batch itself unrotated and unscaled.\n65\t */\n66\timport { InstancedMesh, type Texture } from 'three/webgpu';\n67\texport interface SpriteSheet {\n68\t    /**\n69\t     * The sheet (nearest-filtered); `drawSheet` makes one from code. Frames run left to right,\n70\t     * top to bottom, from the image's top-left; a texture with `flipY` false (a `DataTexture`)\n71\t     * holds its rows top line first.\n72\t     */\n73\t    readonly texture: Texture;\n74\t    /** Frame size in pixels and the frames across and down. */\n75\t    readonly frame: readonly [number, number];\n76\t    readonly cols: number;\n77\t    readonly rows: number;\n78\t    readonly frames: number;\n79\t}\n80\t/**\n81\t * Draw a sheet in code: `draw(g, frame)` paints one frame into a `frame`-sized box (the\n82\t * context is translated there and clipped). Pixel coordinates; draw with `fillRect`.\n83\t */\n84\texport declare function drawSheet(o: {\n85\t    frame: readonly [number, number];\n86\t    frames: number;\n87\t    cols?: number;\n88\t}, draw: (g: CanvasRenderingContext2D, frame: number) => void): SpriteSheet;\n89\texport interface SpriteOptions {\n90\t    /** Height in metres (the width follows the frame's aspect). Default 1. */\n91\t    size?: number;\n92\t    frame?: number;\n93\t    /** Mirror left-right (a sprite facing the other way). */\n94\t    flip?: boolean;\n95\t}\n96\texport declare class SpriteBatch extends InstancedMesh {\n97\t    readonly sheet: SpriteSheet;\n98\t    /** Per sprite: x, y, z (its bottom middle), size. */\n99\t    private readonly place;\n100\t    /** Per sprite: frame, flip (±1). */\n101\t    private readonly look;\n102\t    constructor(sheet: SpriteSheet, o: {\n103\t        capacity: number;\n104\t    });\n105\t    /** A new sprite (its index), or -1 when full. */\n106\t    spawn(at: readonly [number, number, number], o?: SpriteOptions): number;\n107\t    /** Move or change sprite `i`. */\n108\t    set(i: number, o: SpriteOptions & {\n109\t        at?: readonly [number, number, number];\n110\t    }): void;\n111\t    /** `set` without the options object, for many sprites every frame: position, then frame and mirror. */\n112\t    put(i: number, x: number, y: number, z: number, frame?: number, flip?: boolean): void;\n113\t    /** Where sprite `i` stands. */\n114\t    at(i: number): [number, number, number];\n115\t    /** A whole frame number on the sheet (negative and past-the-end frames wrap round). */\n116\t    private wrap;\n117\t    /** The frame sprite `i` shows. */\n118\t    frameOf(i: number): number;\n119\t    dispose(): this;\n120\t}\n121\t/**\n122\t * Decals: marks left on surfaces (footprints, scorch marks, paint splats, cracks), each a\n123\t * small flat quad laid on the surface along its normal, its shape cut out in the shader (no\n124\t * texture), coloured per mark, and faded out at the end of its life by an ordered dither (no\n125\t * blending). One instanced draw per shape, a fixed pool: when it is full the oldest mark goes.\n126\t *\n127\t *   const decals = new Decals(scene, { capacity: 256 });\n128\t *   decals.add('scorch', hit.point, hit.normal, { size: 1.6, color: PALETTE.ink, life: 8 });\n129\t *   decals.add('footprint', feet, UP, { size: 0.3, rotation: heading, color: PALETTE.slate });\n130\t *   // per frame: decals.update(dt)\n131\t */\n132\timport { InstancedMesh, type Scene, type Vector3Like } from 'three/webgpu';\n133\texport declare const DECAL_SHAPES: readonly [\"footprint\", \"scorch\", \"splat\", \"crack\", \"ring\"];\n134\texport type DecalShape = (typeof DECAL_SHAPES)[number];\n135\texport interface DecalOptions {\n136\t    /** Width of the mark (m). Default 0.5. */\n137\t    size?: number;\n138\t    /** Turn about the normal (radians). Default random. */\n139\t    rotation?: number;\n140\t    /** Colour (hex). Default dark. */\n141\t    color?: number;\n142\t    /** Seconds before it starts to fade (0: forever). Default 10. */\n143\t    life?: number;\n144\t}\n145\texport declare class Decals {\n146\t    private readonly scene;\n147\t    readonly o: {\n148\t        capacity?: number;\n149\t    };\n150\t    readonly meshes: Map<\"ring\" | \"crack\" | \"footprint\" | \"scorch\" | \"splat\", InstancedMesh<import(\"three\").BufferGeometry<import(\"three\").NormalBufferAttributes, import(\"three\").BufferGeometryEventMap>, import(\"three\").Material<import(\"three\").MaterialEventMap> | import(\"three\").Material<import(\"three\").MaterialEventMap>[], import(\"three\").Object3DEventMap>>;\n151\t    private readonly slots;\n152\t    private readonly next;\n153\t    private readonly fades;\n154\t    private readonly m;\n155\t    private readonly q;\n156\t    private readonly q2;\n157\t    private readonly s;\n158\t    private readonly p;\n159\t    private readonly n;\n160\t    private readonly c;\n161\t    private seed;\n162\t    constructor(scene: Scene, o?: {\n163\t        capacity?: number;\n164\t    });\n165\t    private mesh;\n166\t    /** Lay a mark at `at` on a surface facing `normal`. Returns its index in that shape's pool. */\n167\t    add(shape: DecalShape, at: Vector3Like, normal: Vector3Like, o?: DecalOptions): number;\n168\t    /** Marks alive (per shape or all). */\n169\t    count(shape?: DecalShape): number;\n170\t    /** Per frame: age the marks; old ones dither away over a second. */\n171\t    update(dt: number): void;\n172\t    /** Remove every mark (the meshes stay for reuse). */\n173\t    clear(): void;\n174\t    dispose(): void;\n175\t}\n176\t/**\n177\t * Time of day: a sun that rises in the east, crosses the sky and sets in the west, warm at\n178\t * dawn and dusk, a dim blue moon at night, with the ambient light, the sky colour and the fog\n179\t * colour following. `skyAt(hour)` is pure (keyframes interpolated, unit-tested); `applySky`\n180\t * puts it on an engine (the sun, its direction and shadows, the ambient light, the\n181\t * background). Levels unload back to the engine's defaults.\n182\t *\n183\t *   const s = skyAt(18.5);                 // 0..24\n184\t *   applySky(engine, s);                   // or read s.night to light the lanterns\n185\t */\n186\timport { Color, type Node } from 'three/webgpu';\n187\timport type { Engine } from '../Engine';\n188\texport interface SkyState {\n189\t    /** Unit vector toward the sun (or the moon, at night). */\n190\t    readonly sunDir: [number, number, number];\n191\t    readonly sunColor: number;\n192\t    readonly sunIntensity: number;\n193\t    readonly ambientColor: number;\n194\t    readonly ambientIntensity: number;\n195\t    /** Background (sky) and fog colour. */\n196\t    readonly sky: number;\n197\t    /** 0 by day, 1 deep at night: lanterns, stars, windows. */\n198\t    readonly night: number;\n199\t}\n200\t/** The sky at `hour` (wraps around 24). */\n201\texport declare function skyAt(hour: number): SkyState;\n202\t/** Put a sky on the engine: sun direction, colour and strength, ambient light, background. */\n203\texport declare function applySky(engine: Pick<Engine, 'sun' | 'ambient' | 'scene' | 'setSunDirection'>, s: SkyState): void;\n204\t/**\n205\t * Fog for `scene.fogNode` with live settings (uniforms: changing them never recompiles):\n206\t * ground mist that thickens below `top` (m) and a haze that grows with distance from the\n207\t * camera, both up to `amount` (0..1), in `color` (match the sky).\n208\t *\n209\t *   const mist = groundFog({ color: s.sky, top: 1.5 });\n210\t *   (scene as { fogNode: unknown }).fogNode = mist.node;\n211\t *   mist.amount.value = 0.8; mist.color.value.setHex(s.sky);\n212\t */\n213\texport declare function groundFog(o?: {\n214\t    color?: number;\n215\t    top?: number;\n216\t    amount?: number;\n217\t    near?: number;\n218\t    far?: number;\n219\t}): {\n220\t    node: Node;\n221\t    color: import(\"three/webgpu\").UniformNode<\"color\", Color>;\n222\t    amount: import(\"three/webgpu\").UniformNode<\"float\", number>;\n223\t    top: import(\"three/webgpu\").UniformNode<\"float\", number>;\n224\t};\n225\t/**\n226\t * Rain and snow: thousands of drops or flakes in one instanced draw, placed entirely by the\n227\t * vertex shader. Each drop's start comes from a hash of its instance index; it falls through a\n228\t * box of air around a centre (the camera's focus) whose x and z wrap in world space, so walking\n229\t * through the weather doesn't drag the drops sideways (the box's height follows the centre). Rain falls fast and slants with the wind; snow\n230\t * drifts and sways. `intensity` (0..1) shows that share of the drops: no buffers change, no\n231\t * shader recompiles. Splashes are left to the game (`splashes(dt)` says how many this frame).\n232\t *\n233\t *   const rain = new Precipitation({ kind: 'rain', count: 3000, area: [24, 14, 24] });\n234\t *   scene.add(rain);\n235\t *   // per frame: rain.update(dt, camera.focus); rain.intensity = 0.7; rain.wind.set(3, 0)\n236\t */\n237\timport { InstancedMesh, Vector2, Vector3 } from 'three/webgpu';\n238\texport type PrecipitationKind = 'rain' | 'snow';\n239\texport interface PrecipitationOptions {\n240\t    kind: PrecipitationKind;\n241\t    /** Most drops at once (the instance count). */\n242\t    count: number;\n243\t    /** Width, height and depth of the air the drops fall through, around the centre. */\n244\t    area?: readonly [number, number, number];\n245\t    /** Drop colour (hex). */\n246\t    color?: number;\n247\t    /** Fall speed (m/s). Rain 16, snow 1.4. */\n248\t    speed?: number;\n249\t}\n250\texport declare class Precipitation extends InstancedMesh {\n251\t    readonly kind: PrecipitationKind;\n252\t    readonly area: readonly [number, number, number];\n253\t    /** Wind (m/s along x and z): rain slants, snow drifts. */\n254\t    readonly wind: Vector2;\n255\t    private readonly uTime;\n256\t    private readonly uCenter;\n257\t    private readonly uWind;\n258\t    private readonly uIntensity;\n259\t    private readonly uSpeed;\n260\t    private t;\n261\t    constructor(o: PrecipitationOptions);\n262\t    /** Share of the drops falling (0..1). */\n263\t    get intensity(): number;\n264\t    set intensity(v: number);\n265\t    /** Fall speed (m/s). */\n266\t    get speed(): number;\n267\t    set speed(v: number);\n268\t    /** Per frame (game time): advance the fall and follow `center`. */\n269\t    update(dt: number, center: Vector3): void;\n270\t    /** How many drops hit the ground in `dt` seconds at this intensity (for splash particles, ripples). */\n271\t    splashes(dt: number): number;\n272\t    dispose(): this;\n273\t}\n274\t/**\n275\t * Cutscenes as data: camera keys the camera glides through on a smooth curve (or cuts to),\n276\t * cues that fire once when the playhead passes them (an actor starts walking, a door opens, a\n277\t * sound), subtitles, and letterbox bars that slide in and out. The timeline only keeps time\n278\t * and answers \"where is the camera now, what line is showing\": the game puts the camera\n279\t * there and draws the bars, so it works with any camera and any HUD.\n280\t *\n281\t *   const scene = new Timeline({\n282\t *     shots: [\n283\t *       { at: 0, position: [0, 2, 9], target: [0, 1, 0] },\n284\t *       { at: 4, position: [6, 3, 4], target: [0, 1, 0] },   // a glide from the first key\n285\t *       { at: 4, position: [1, 1.6, 2], target: [0, 1.5, 0], cut: true },  // a cut\n286\t *     ],\n287\t *     cues: [{ at: 1, name: 'wave', run: () => actor.play('Wave') }],\n288\t *     lines: [{ at: 0.5, until: 3, who: 'GUIDE', text: 'Welcome.' }],\n289\t *   });\n290\t *   scene.play();\n291\t *   scene.update(dt);                       // per frame: fires the cues it passes\n292\t *   const shot = scene.camera();            // { position, target, fov }\n293\t *   scene.skip();                           // to the end: cues that matter still fire\n294\t *\n295\t * Pure (no three.js): unit-tested.\n296\t */\n297\texport type V3 = readonly [number, number, number];\n298\texport interface CameraKey {\n299\t    /** Time (s) the camera is exactly here. */\n300\t    at: number;\n301\t    position: V3;\n302\t    /** The point it looks at. */\n303\t    target: V3;\n304\t    /** Vertical field of view (degrees); default the previous key's, or 50. */\n305\t    fov?: number;\n306\t    /** Jump here instead of gliding from the key before (a cut to a new shot). */\n307\t    cut?: boolean;\n308\t}\n309\texport interface Cue {\n310\t    at: number;\n311\t    name?: string;\n312\t    run: () => void;\n313\t    /**\n314\t     * Cosmetic (a sound, a puff of dust): not run when the scene is skipped past it. Cues that\n315\t     * change the world (a door left open, an item given) are run on skip so the world ends up\n316\t     * the same either way.\n317\t     */\n318\t    cosmetic?: boolean;\n319\t}\n320\texport interface Line {\n321\t    at: number;\n322\t    until: number;\n323\t    text: string;\n324\t    /** Who is speaking (shown before the text). */\n325\t    who?: string;\n326\t}\n327\texport interface CameraShot {\n328\t    position: [number, number, number];\n329\t    target: [number, number, number];\n330\t    fov: number;\n331\t}\n332\texport interface TimelineOptions {\n333\t    shots?: readonly CameraKey[];\n334\t    cues?: readonly Cue[];\n335\t    lines?: readonly Line[];\n336\t    /** Length (s); default the last key, cue or line. */\n337\t    duration?: number;\n338\t    /** Seconds the letterbox bars take to slide in and out (default 0.6; 0: no bars). */\n339\t    bars?: number;\n340\t    /** Called once when the playhead reaches the end (or the scene is skipped). */\n341\t    onEnd?: () => void;\n342\t}\n343\texport declare class Timeline {\n344\t    readonly duration: number;\n345\t    /** The playhead (s). */\n346\t    time: number;\n347\t    playing: boolean;\n348\t    /** Playback rate (1: real time, 0.5: slow motion). */\n349\t    speed: number;\n350\t    /** True once the end has been reached (by playing or skipping). */\n351\t    ended: boolean;\n352\t    /** Cue names in the order they fired (tests and tools). */\n353\t    readonly fired: string[];\n354\t    private readonly keys;\n355\t    private readonly cues;\n356\t    private readonly lines;\n357\t    private readonly barTime;\n358\t    private readonly onEnd?;\n359\t    /** How many cues (in time order) have fired. */\n360\t    private next;\n361\t    /** Bumped by every seek and skip: a cue that moves the playhead stops the cues after it. */\n362\t    private jumps;\n363\t    /** Inside skip(): cues run to the end whatever they do to the playhead. */\n364\t    private skipping;\n365\t    constructor(o: TimelineOptions);\n366\t    play(): void;\n367\t    pause(): void;\n368\t    /** Advance by `dt` seconds of game time (times `speed`) while playing, firing the cues passed. */\n369\t    update(dt: number): void;\n370\t    /**\n371\t     * Move the playhead to `t` without firing the cues in between (scrubbing). Cues before `t`\n372\t     * count as done and cues after it will fire again (going back re-arms them). Ignored while\n373\t     * skipping (a cue that loops back cannot undo a skip).\n374\t     */\n375\t    seek(t: number): void;\n376\t    /**\n377\t     * Jump to the end: the cues not yet fired run (except the cosmetic ones), then `onEnd`. Cues\n378\t     * after `duration` never fire, played or skipped.\n379\t     */\n380\t    skip(): void;\n381\t    private fireUpTo;\n382\t    private finish;\n383\t    /**\n384\t     * Where the camera is at `t` (default now): on each key at its time, gliding between keys\n385\t     * on a smooth curve (Catmull-Rom tangents, so the speed has no jolt at a key; the first and\n386\t     * last key of each shot ease in and out). A `cut` key starts a new shot. Null without keys.\n387\t     */\n388\t    camera(t?: number): CameraShot | null;\n389\t    /** The subtitle showing at `t` (default now), or null. */\n390\t    line(t?: number): Line | null;\n391\t    /** How far the letterbox bars are in (0..1) at `t` (default now): sliding in at the start, out at the end. */\n392\t    bars(t?: number): number;\n393\t}\n394\timport { type Camera, Group, Vector3 } from 'three/webgpu';\n395\timport { type BurstOptions, type ParticlePreset } from './pool';\n396\timport { Rng } from '../random';\n397\t/** What the particle system needs to size particles in art pixels. */\n398\texport interface ParticleView {\n399\t    camera: Camera;\n400\t    /** Point the camera looks at (sizes are exact there). */\n401\t    focus: Vector3;\n402\t    /** Internal (art) resolution height. */\n403\t    height: number;\n404\t}\n405\t/**\n406\t * Pixel-art particles: CPU-simulated pools, drawn as camera-facing square sprites in flat\n407\t * palette colors. One emitter (one instanced draw call, one pooled instance buffer) per\n408\t * preset; sizes are whole art pixels, so in Pixel mode a particle is a crisp N×N block.\n409\t * Available as `ctx.particles`; emitters are created on first use and freed by `clear()`\n410\t * (the engine calls it when a level unloads).\n411\t *\n412\t *   ctx.particles.burst('dust', hero.feet);\n413\t *   ctx.particles.burst('skid', feet, { direction: [-vx, 0.3, -vz], count: 2 });\n414\t */\n415\texport declare class Particles {\n416\t    private readonly view;\n417\t    /** Engine-owned group holding every emitter. */\n418\t    readonly group: Group<import(\"three\").Object3DEventMap>;\n419\t    /** Preset registry: the built-ins plus anything registered. */\n420\t    readonly presets: Map<string, ParticlePreset>;\n421\t    /** World units per art pixel at the camera focus (updated every frame). */\n422\t    readonly pixelWorld: import(\"three/webgpu\").UniformNode<\"float\", number>;\n423\t    /** Emitters by key: `@name` for registered presets, `#<json>` for inline preset objects. */\n424\t    private readonly emitters;\n425\t    private readonly inlineKeys;\n426\t    private readonly geometry;\n427\t    private warnedMany;\n428\t    /** Where bursts get their randomness: the level's stream (the engine reseeds it per level). */\n429\t    private rng;\n430\t    private readonly random;\n431\t    constructor(view: () => ParticleView);\n432\t    /** Add or replace a named preset. Replacing frees the old preset's emitter. */\n433\t    register(name: string, preset: ParticlePreset): void;\n434\t    /**\n435\t     * Spawn a burst of `preset` (a name or a ParticlePreset) at `at`. Returns the number of\n436\t     * particles spawned (fewer when the pool is full, 0 for an unknown preset). Inline\n437\t     * preset objects share one emitter per distinct content, so `burst({ ...literal }, at)`\n438\t     * every frame stays one pool and one draw call; prefer `register` + a name, and vary a\n439\t     * burst with `options` (count, direction, speed, scale, colors).\n440\t     */\n441\t    burst(preset: string | ParticlePreset, at: Vector3 | readonly [number, number, number], options?: BurstOptions): number;\n442\t    /** Particles alive right now, over all emitters. */\n443\t    get alive(): number;\n444\t    /** Emitters (= draw calls at most) currently allocated. */\n445\t    get emitterCount(): number;\n446\t    /** Simulate and upload. Called by the engine every frame (frozen while paused). */\n447\t    update(dt: number): void;\n448\t    /** Take bursts' randomness from `rng` (the engine passes each level's `ctx.random` fork). */\n449\t    reseed(rng: Rng): void;\n450\t    /** Kill every particle and free the emitters (GPU buffers, materials). */\n451\t    clear(): void;\n452\t    dispose(): void;\n453\t    private inlineKey;\n454\t    private free;\n455\t    private emitter;\n456\t    private updatePixelSize;\n457\t}\n458\t/**\n459\t * Navigation on a grid: which cells can be walked, the shortest path between two points\n460\t * (A*, 8-connected, no corner cutting, smoothed by line of sight), a flow field toward one\n461\t * target (one Dijkstra fill, then any number of agents read a direction per cell for free),\n462\t * and line-of-sight tests (vision cones, stealth). Pure and allocation-light; unit-tested.\n463\t *\n464\t *   const nav = NavGrid.fromRows(['#########', '#...#...#', '#.#...#.#', '#########'], { cell: 1, origin: [-4.5, 0, -2] });\n465\t *   const path = nav.path([-3, 0, -1], [3, 0, -1]);       // world points, corners only\n466\t *   nav.flowTo(hero.x, hero.z);                            // once when the target changes cell\n467\t *   nav.flowDirection(x, z, out);                          // per agent per step\n468\t *   nav.lineOfSight(ax, az, bx, bz);                       // walls block, open cells don't\n469\t */\n470\texport interface NavGridOptions {\n471\t    /** Metres per cell. Default 1. */\n472\t    cell?: number;\n473\t    /** World x, z of the top-left cell's corner (column 0, row 0). Default: centred on the origin. */\n474\t    origin?: readonly [number, number, number];\n475\t}\n476\texport declare class NavGrid {\n477\t    readonly width: number;\n478\t    readonly height: number;\n479\t    readonly cell: number;\n480\t    /** World x, z of cell (0, 0)'s corner. */\n481\t    readonly ox: number;\n482\t    readonly oz: number;\n483\t    /** 1 = walkable. */\n484\t    readonly open: Uint8Array;\n485\t    /** Bumped by `setOpen`: flow fields rebuild. */\n486\t    version: number;\n487\t    private readonly g;\n488\t    private readonly from;\n489\t    private readonly flow;\n490\t    private readonly heap;\n491\t    private flowTarget;\n492\t    private flowVersion;\n493\t    /** How many times a flow field was built (tools: should be one per target cell change). */\n494\t    flowBuilds: number;\n495\t    constructor(width: number, height: number, o?: NavGridOptions);\n496\t    /**\n497\t     * From an ASCII map: `blocked` characters are closed, everything else open. Default '# ': walls\n498\t     * and pits (a ' ' has no floor in RoomKit's maps); past the end of a short row is a wall.\n499\t     */\n500\t    static fromRows(rows: readonly string[], o?: NavGridOptions & {\n501\t        blocked?: string;\n502\t    }): NavGrid;\n503\t    col(x: number): number;\n504\t    row(z: number): number;\n505\t    /** World x, z of a cell's centre. */\n506\t    centerX(col: number): number;\n507\t    centerZ(row: number): number;\n508\t    isOpen(col: number, row: number): boolean;\n509\t    /** Is the world point on a walkable cell? */\n510\t    walkable(x: number, z: number): boolean;\n511\t    setOpen(col: number, row: number, open: boolean): void;\n512\t    /**\n513\t     * Shortest path between two world points (x, z used; y kept from `from`): A* over cells,\n514\t     * no corner cutting, then smoothed so it only turns where a wall is in the way. Null when\n515\t     * there is no way. The first point is `from`, the last `to` (snapped into its cell).\n516\t     */\n517\t    path(from: readonly [number, number, number], to: readonly [number, number, number]): [number, number, number][] | null;\n518\t    /** A* from cell `start` to cell `goal`: the cells of a shortest way, or null. */\n519\t    private search;\n520\t    /** Drop every point the path can skip in a straight line. */\n521\t    smooth(pts: [number, number, number][]): [number, number, number][];\n522\t    /** Open cells near (col, row), nearest first (itself if open; else within 4 cells, straight neighbours before diagonals). */\n523\t    private openNear;\n524\t    /**\n525\t     * Can you see (or walk straight) from a to b? Walks the cells under the segment (a DDA);\n526\t     * `radius` > 0 also tests two lines offset sideways (a body that wide fits).\n527\t     */\n528\t    lineOfSight(ax: number, az: number, bx: number, bz: number, radius?: number): boolean;\n529\t    /**\n530\t     * Distance from a along a direction to the first closed cell (at most `max`): the same cell\n531\t     * walk as `lineOfSight`, so a vision cone drawn with it shows exactly what a guard can see.\n532\t     */\n533\t    castWall(ax: number, az: number, dx: number, dz: number, max: number): number;\n534\t    /** Grid DDA: true if every cell the segment crosses is open. */\n535\t    private ray;\n536\t    /**\n537\t     * Walk the cells along a + t·d for t in 0..1 (a DDA): where the first closed cell begins, as\n538\t     * a fraction of d (0 when a is in one), or 1 when there is none.\n539\t     */\n540\t    private walk;\n541\t    /**\n542\t     * A flow field toward the world point (x, z): the walking distance from every cell to it.\n543\t     * Rebuilt only when the target changes cell or the grid changed (`version`). Returns\n544\t     * whether it was rebuilt.\n545\t     */\n546\t    flowTo(x: number, z: number): boolean;\n547\t    /** Walking distance to the flow target from a world point (Infinity: no way). */\n548\t    flowDistance(x: number, z: number): number;\n549\t    /**\n550\t     * Which way to go from (x, z) toward the flow target: the unit direction to the\n551\t     * lowest-distance neighbour (into `out` [x, z]). Returns false at the target or with no way.\n552\t     */\n553\t    flowDirection(x: number, z: number, out: [number, number]): boolean;\n554\t}\n555\timport { type Resolution } from './framing';\n556\timport type { QualityOption } from './quality';\n557\timport { type Look } from './render/look';\n558\timport type { RenderMode } from './render/PixelRenderer';\n559\t/**\n560\t * The player's settings: the standard picture and engine options every game gets, as plain data\n561\t * (sound is the AudioManager's, which keeps its own volumes). A field left out is the game's own\n562\t * choice; a field set is the player's and wins over it. `engine.settings` holds them, applies\n563\t * them, saves them per game and shows them in the settings panel (the ⚙ button).\n564\t */\n565\texport interface PlayerSettings {\n566\t    /** A LOOK_PRESETS name. Left out: the look the game gives each level. */\n567\t    look?: string;\n568\t    /** Pixel art (the pixel pass), or false for smooth 3D (render mode `raw`). */\n569\t    pixelArt?: boolean;\n570\t    /** The art resolution: `fine` (the game's, 480×270 by default) or `chunky` (two thirds of it: bigger pixels). */\n571\t    pixelSize?: 'fine' | 'chunky';\n572\t    /** Shadow and light quality: a level, or `auto` (the device's). */\n573\t    quality?: QualityOption;\n574\t    /** Frame cap: 60, 30, or 0 for the display's own rate. */\n575\t    fps?: number;\n576\t    /** The debug panel: frame rate, camera, GPU errors and the game's status. */\n577\t    debugInfo?: boolean;\n578\t}\n579\texport declare const PIXEL_SIZES: readonly [\"fine\", \"chunky\"];\n580\texport declare const QUALITY_OPTIONS: readonly QualityOption[];\n581\texport declare const FPS_OPTIONS: readonly number[];\n582\t/** Keep only fields with a valid value: what storage or a caller handed over may be anything. */\n583\texport declare function normalizeSettings(raw: unknown): PlayerSettings;\n584\t/** The settings saved under `key` ({} when there are none, or storage is blocked or holds junk). */\n585\texport declare function loadSettings(key: string): PlayerSettings;\n586\texport declare function storeSettings(key: string, settings: PlayerSettings): void;\n587\t/** The engine options a page URL's review flags set (what `optionsFromUrl` gives). */\n588\texport type UrlFlags = {\n589\t    look?: unknown;\n590\t    filters?: unknown;\n591\t    mode?: unknown;\n592\t    resolution?: unknown;\n593\t    quality?: unknown;\n594\t    maxFps?: unknown;\n595\t    debugUI?: unknown;\n596\t};\n597\t/**\n598\t * The settings a page URL's review flags set (`?look=`, `?filters=`, `?mode=`, `?res=`,\n599\t * `?quality=`, `?fps=`, `?debug=`): the fields `url` (optionsFromUrl) holds that the game's\n600\t * `options` took (`withUrlOptions`). They win over the saved ones at start.\n601\t */\n602\texport declare function urlSettings(url: UrlFlags, options?: UrlFlags): Set<keyof PlayerSettings>;\n603\t/** Chunky pixels for a resolution: the engine's 320×180 for its 480×270, else two thirds of it. */\n604\texport declare function chunkyResolution(base: Resolution): Resolution;\n605\t/** What the settings change in the engine (Engine implements it; tests pass a fake). */\n606\texport interface SettingsHost {\n607\t    readonly look: Look;\n608\t    setLook(look: Look): void;\n609\t    readonly renderer: {\n610\t        readonly mode: RenderMode;\n611\t        readonly baseResolution: Resolution;\n612\t        readonly lookVersion: number;\n613\t        setMode(mode: RenderMode): void;\n614\t        setResolution(resolution: Resolution): void;\n615\t    };\n616\t    maxFps: number;\n617\t    readonly qualityOption: QualityOption;\n618\t    useQuality(option: QualityOption): void;\n619\t    readonly debugShown: boolean;\n620\t    showDebug(on: boolean): void;\n621\t}\n622\t/**\n623\t * `engine.settings`: the player's settings, applied to the engine and saved. A field the page URL\n624\t * sets (`?look=`, `?mode=`, `?res=`, `?quality=`, `?fps=`, `?debug=`: review flags) wins over a\n625\t * saved one at start (which stays saved). `open`, `close` and `toggle` show and hide the\n626\t * settings panel.\n627\t */\n628\texport declare class Settings {\n629\t    private readonly host;\n630\t    readonly key: string | null;\n631\t    /** The player's choices: the saved ones from the start, and a game's `set()` before it. */\n632\t    private current;\n633\t    /** Saved choices a review flag in the URL overrides: not applied, still saved. */\n634\t    private held;\n635\t    private game;\n636\t    private readonly listeners;\n637\t    private shown;\n638\t    /** `host.renderer.lookVersion` once the settings last set the look: unchanged, nothing else did since. */\n639\t    private lookShown;\n640\t    /** `key`: where they are saved (`pixel-engine:settings:<key>`), or null for nowhere. */\n641\t    constructor(host: SettingsHost, key: string | null);\n642\t    /** The player's choices in effect: fields left out are the game's (or a review flag's). */\n643\t    get values(): Readonly<PlayerSettings>;\n644\t    get isOpen(): boolean;\n645\t    /** Change some settings: applied at once and saved. A field set to `undefined` goes back to the game's. */\n646\t    set(patch: PlayerSettings): void;\n647\t    /** Forget every choice, the held ones too: the game's own picture again. */\n648\t    reset(): void;\n649\t    /** Make `values` the settings, changing only the fields that differ: the ones it leaves out go back to the game's. */\n650\t    replace(values: PlayerSettings): void;\n651\t    /** Called with the values after every change; returns the unsubscribe. */\n652\t    onChange(fn: (values: Readonly<PlayerSettings>) => void): () => void;\n653\t    open(): void;\n654\t    close(): void;\n655\t    toggle(): void;\n656\t    private save;\n657\t    /** Put each field of `s` into the engine; `fields` also lists cleared ones (back to the game's). */\n658\t    private apply;\n659\t}\n660\t/**\n661\t * Behaviour trees: an agent's decisions as a tree of small nodes, ticked every step. Each tick\n662\t * a node answers success, failure or running (still at it). Selectors try their children in\n663\t * priority order until one doesn't fail; sequences run theirs in order until one doesn't\n664\t * succeed. Both are reactive: every tick starts again from the first child, so a higher\n665\t * priority (flee!) takes over at once, and whatever was running below it is halted.\n666\t *\n667\t *   const tree = new BehaviorTree(\n668\t *     selector('root',\n669\t *       sequence('flee', condition('scared?', (b) => b.threat < 3), action('run away', fleeStep)),\n670\t *       sequence('work', action('go to crystal', goTo), action('pick it up', pickUp)),\n671\t *       action('wander', wander)),\n672\t *     blackboard);\n673\t *   tree.tick(dt);       // per step; tree.trace() for drawing it\n674\t */\n675\texport type Status = 'success' | 'failure' | 'running';\n676\texport declare abstract class BtNode<B> {\n677\t    readonly name: string;\n678\t    readonly kind: string;\n679\t    /** Status at the last tick that reached this node. */\n680\t    status: Status | null;\n681\t    /** The tree's tick count when this node last ran. */\n682\t    visited: number;\n683\t    readonly children: BtNode<B>[];\n684\t    /** The tree it belongs to: a node keeps its own state, so it can be in one tree only. */\n685\t    tree: BehaviorTree<B> | null;\n686\t    constructor(name: string, kind: string);\n687\t    protected abstract tick(b: B, dt: number, tree: BehaviorTree<B>): Status;\n688\t    /** Tick this node (keeps `status` and `visited` for the trace). */\n689\t    run(b: B, dt: number, tree: BehaviorTree<B>): Status;\n690\t    /** Interrupted: forget any progress, and tell actions that were running to stop. */\n691\t    halt(b: B): void;\n692\t}\n693\t/** Children in priority order: the first that doesn't fail decides (success or running). */\n694\texport declare const selector: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n695\t/** Children in order: fails at the first failure, runs while one runs, succeeds when all have. Reactive: from the top each tick. */\n696\texport declare const sequence: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n697\t/** A sequence that resumes where it was (steps that must not be checked again once done). */\n698\texport declare const steps: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n699\t/** All children at once (each until it finishes): 'all' succeeds when every one has and fails at a failure, 'one' succeeds as soon as one has. */\n700\texport declare const parallel: <B>(name: string, needed: \"all\" | \"one\", ...children: BtNode<B>[]) => BtNode<B>;\n701\t/** A test: success if true, failure if not. */\n702\texport declare const condition: <B>(name: string, test: (b: B) => boolean) => BtNode<B>;\n703\t/** Something done a step at a time: return 'running' until it is done. `onHalt` tidies up if it is interrupted. */\n704\texport declare const action: <B>(name: string, step: (b: B, dt: number) => Status, onHalt?: (b: B) => void) => BtNode<B>;\n705\t/** Running for `seconds`, then success (from zero again next time, or after a halt). */\n706\texport declare const wait: <B>(name: string, seconds: number) => BtNode<B>;\n707\t/** Success becomes failure and failure success. */\n708\texport declare const inverter: <B>(child: BtNode<B>, name?: string) => BtNode<B>;\n709\t/** Success whatever the child answered, once it has finished. */\n710\texport declare const succeeder: <B>(child: BtNode<B>, name?: string) => BtNode<B>;\n711\t/** The child `times` times over: running until it has succeeded that often; a failure fails. */\n712\texport declare const repeat: <B>(child: BtNode<B>, times: number, name?: string) => BtNode<B>;\n713\t/** After the child succeeds it fails, without running, for `seconds` of tree time (no spamming). */\n714\texport declare const cooldown: <B>(child: BtNode<B>, seconds: number, name?: string) => BtNode<B>;\n715\texport interface TraceRow {\n716\t    name: string;\n717\t    kind: string;\n718\t    depth: number;\n719\t    /** This tick's answer, or null if this tick never reached the node. */\n720\t"}]},"parent_tool_use_id":null,"session_id":"a7680a17-bf1f-4ce7-9c9a-ea1ace567b93","uuid":"e1577dc6-5f33-4abe-b8f8-9c33811d5372","timestamp":"2026-11-05T04:24:51.890Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261104-211929--x031fe2-work/a7680a17-bf1f-4ce7-9c9a-ea1ace567b93/tool-results/bf4atyb3o.txt","content":"/**\n * A meadow: thousands of grass blades in one instanced draw, bent by the vertex shader. Wind\n * leans every blade and sends gusts across the field as visible waves; up to four pushers\n * (the hero, a ball) part and flatten the blades around them. Blades are two crossed\n * triangles (they read from any side), toon-lit as if they were the ground (an up normal), so\n * they take the same light bands and shadows as the floor they stand on.\n *\n *   const grass = new GrassField({ area: [12, 8], at: [0, 0, 0], count: 6000 });\n *   scene.add(grass);\n *   // per frame: grass.update(t); grass.push(0, hero.position, 0.9)\n *   grass.wind.set(2.5, 0.5);       // m/s-ish: direction and strength\n */\nimport { InstancedMesh, Vector2, type Vector3Like } from 'three/webgpu';\nexport declare const MAX_PUSHERS = 4;\nexport interface GrassOptions {\n    /** Width (x) and depth (z) of the patch, m. */\n    area: readonly [number, number];\n    /** Centre of the patch on the ground. */\n    at: readonly [number, number, number];\n    count: number;\n    /** Blade heights (m): shortest and tallest. Default [0.25, 0.55]. */\n    height?: readonly [number, number];\n    /** Blade width at the root (m). Default 0.07. */\n    width?: number;\n    /** Colours (hex): roots and tips. */\n    base?: number;\n    tip?: number;\n    /** Where blades grow (world x, z); default everywhere in the patch. */\n    mask?: (x: number, z: number) => boolean;\n    /** Ground height under a blade (default: the patch's y). */\n    ground?: (x: number, z: number) => number;\n    seed?: number;\n}\nexport declare class GrassField extends InstancedMesh {\n    /** Wind along x and z (its length is the strength). */\n    readonly wind: Vector2;\n    /** How far blades lean per unit of wind (m at the tip). Default 0.12. */\n    sway: number;\n    private readonly uTime;\n    private readonly uWind;\n    private readonly uSway;\n    private readonly uPush;\n    /** Blades actually placed (the mask can leave fewer than `count`). */\n    readonly blades: number;\n    constructor(o: GrassOptions);\n    /** Pusher `i` (0..3): blades within `radius` of `at` part and flatten (radius 0: none). */\n    push(i: number, at: Vector3Like | null, radius?: number): void;\n    /** Per frame (game time). */\n    update(time: number): void;\n    dispose(): this;\n}\n/**\n * Pixel sprites in a 3D world (Doom's monsters, Paper Mario, Octopath's characters): flat\n * pictures that always face the camera, drawn with nearest sampling so their pixels stay\n * square, cut out by alpha (no blending), animated by flipping frames of a sheet. Many\n * sprites of one sheet are one instanced draw; each has its own position, size, frame and\n * mirror. Sheets can be drawn in code (`drawSheet`), so a game needs no image files.\n *\n *   const sheet = drawSheet({ frame: [16, 16], frames: 4 }, (g, f) => { g.fillStyle = '#f4f4f4'; g.fillRect(4, 4 + (f % 2), 8, 8); });\n *   const sprites = new SpriteBatch(sheet, { capacity: 64 });\n *   const s = sprites.spawn([0, 1, 0], { size: 1 });\n *   sprites.set(s, { frame: 2, flip: true });       // move, animate and mirror whenever\n *\n * Sprite positions are in the batch's own space: leave the batch itself unrotated and unscaled.\n */\nimport { InstancedMesh, type Texture } from 'three/webgpu';\nexport interface SpriteSheet {\n    /**\n     * The sheet (nearest-filtered); `drawSheet` makes one from code. Frames run left to right,\n     * top to bottom, from the image's top-left; a texture with `flipY` false (a `DataTexture`)\n     * holds its rows top line first.\n     */\n    readonly texture: Texture;\n    /** Frame size in pixels and the frames across and down. */\n    readonly frame: readonly [number, number];\n    readonly cols: number;\n    readonly rows: number;\n    readonly frames: number;\n}\n/**\n * Draw a sheet in code: `draw(g, frame)` paints one frame into a `frame`-sized box (the\n * context is translated there and clipped). Pixel coordinates; draw with `fillRect`.\n */\nexport declare function drawSheet(o: {\n    frame: readonly [number, number];\n    frames: number;\n    cols?: number;\n}, draw: (g: CanvasRenderingContext2D, frame: number) => void): SpriteSheet;\nexport interface SpriteOptions {\n    /** Height in metres (the width follows the frame's aspect). Default 1. */\n    size?: number;\n    frame?: number;\n    /** Mirror left-right (a sprite facing the other way). */\n    flip?: boolean;\n}\nexport declare class SpriteBatch extends InstancedMesh {\n    readonly sheet: SpriteSheet;\n    /** Per sprite: x, y, z (its bottom middle), size. */\n    private readonly place;\n    /** Per sprite: frame, flip (±1). */\n    private readonly look;\n    constructor(sheet: SpriteSheet, o: {\n        capacity: number;\n    });\n    /** A new sprite (its index), or -1 when full. */\n    spawn(at: readonly [number, number, number], o?: SpriteOptions): number;\n    /** Move or change sprite `i`. */\n    set(i: number, o: SpriteOptions & {\n        at?: readonly [number, number, number];\n    }): void;\n    /** `set` without the options object, for many sprites every frame: position, then frame and mirror. */\n    put(i: number, x: number, y: number, z: number, frame?: number, flip?: boolean): void;\n    /** Where sprite `i` stands. */\n    at(i: number): [number, number, number];\n    /** A whole frame number on the sheet (negative and past-the-end frames wrap round). */\n    private wrap;\n    /** The frame sprite `i` shows. */\n    frameOf(i: number): number;\n    dispose(): this;\n}\n/**\n * Decals: marks left on surfaces (footprints, scorch marks, paint splats, cracks), each a\n * small flat quad laid on the surface along its normal, its shape cut out in the shader (no\n * texture), coloured per mark, and faded out at the end of its life by an ordered dither (no\n * blending). One instanced draw per shape, a fixed pool: when it is full the oldest mark goes.\n *\n *   const decals = new Decals(scene, { capacity: 256 });\n *   decals.add('scorch', hit.point, hit.normal, { size: 1.6, color: PALETTE.ink, life: 8 });\n *   decals.add('footprint', feet, UP, { size: 0.3, rotation: heading, color: PALETTE.slate });\n *   // per frame: decals.update(dt)\n */\nimport { InstancedMesh, type Scene, type Vector3Like } from 'three/webgpu';\nexport declare const DECAL_SHAPES: readonly [\"footprint\", \"scorch\", \"splat\", \"crack\", \"ring\"];\nexport type DecalShape = (typeof DECAL_SHAPES)[number];\nexport interface DecalOptions {\n    /** Width of the mark (m). Default 0.5. */\n    size?: number;\n    /** Turn about the normal (radians). Default random. */\n    rotation?: number;\n    /** Colour (hex). Default dark. */\n    color?: number;\n    /** Seconds before it starts to fade (0: forever). Default 10. */\n    life?: number;\n}\nexport declare class Decals {\n    private readonly scene;\n    readonly o: {\n        capacity?: number;\n    };\n    readonly meshes: Map<\"ring\" | \"crack\" | \"footprint\" | \"scorch\" | \"splat\", InstancedMesh<import(\"three\").BufferGeometry<import(\"three\").NormalBufferAttributes, import(\"three\").BufferGeometryEventMap>, import(\"three\").Material<import(\"three\").MaterialEventMap> | import(\"three\").Material<import(\"three\").MaterialEventMap>[], import(\"three\").Object3DEventMap>>;\n    private readonly slots;\n    private readonly next;\n    private readonly fades;\n    private readonly m;\n    private readonly q;\n    private readonly q2;\n    private readonly s;\n    private readonly p;\n    private readonly n;\n    private readonly c;\n    private seed;\n    constructor(scene: Scene, o?: {\n        capacity?: number;\n    });\n    private mesh;\n    /** Lay a mark at `at` on a surface facing `normal`. Returns its index in that shape's pool. */\n    add(shape: DecalShape, at: Vector3Like, normal: Vector3Like, o?: DecalOptions): number;\n    /** Marks alive (per shape or all). */\n    count(shape?: DecalShape): number;\n    /** Per frame: age the marks; old ones dither away over a second. */\n    update(dt: number): void;\n    /** Remove every mark (the meshes stay for reuse). */\n    clear(): void;\n    dispose(): void;\n}\n/**\n * Time of day: a sun that rises in the east, crosses the sky and sets in the west, warm at\n * dawn and dusk, a dim blue moon at night, with the ambient light, the sky colour and the fog\n * colour following. `skyAt(hour)` is pure (keyframes interpolated, unit-tested); `applySky`\n * puts it on an engine (the sun, its direction and shadows, the ambient light, the\n * background). Levels unload back to the engine's defaults.\n *\n *   const s = skyAt(18.5);                 // 0..24\n *   applySky(engine, s);                   // or read s.night to light the lanterns\n */\nimport { Color, type Node } from 'three/webgpu';\nimport type { Engine } from '../Engine';\nexport interface SkyState {\n    /** Unit vector toward the sun (or the moon, at night). */\n    readonly sunDir: [number, number, number];\n    readonly sunColor: number;\n    readonly sunIntensity: number;\n    readonly ambientColor: number;\n    readonly ambientIntensity: number;\n    /** Background (sky) and fog colour. */\n    readonly sky: number;\n    /** 0 by day, 1 deep at night: lanterns, stars, windows. */\n    readonly night: number;\n}\n/** The sky at `hour` (wraps around 24). */\nexport declare function skyAt(hour: number): SkyState;\n/** Put a sky on the engine: sun direction, colour and strength, ambient light, background. */\nexport declare function applySky(engine: Pick<Engine, 'sun' | 'ambient' | 'scene' | 'setSunDirection'>, s: SkyState): void;\n/**\n * Fog for `scene.fogNode` with live settings (uniforms: changing them never recompiles):\n * ground mist that thickens below `top` (m) and a haze that grows with distance from the\n * camera, both up to `amount` (0..1), in `color` (match the sky).\n *\n *   const mist = groundFog({ color: s.sky, top: 1.5 });\n *   (scene as { fogNode: unknown }).fogNode = mist.node;\n *   mist.amount.value = 0.8; mist.color.value.setHex(s.sky);\n */\nexport declare function groundFog(o?: {\n    color?: number;\n    top?: number;\n    amount?: number;\n    near?: number;\n    far?: number;\n}): {\n    node: Node;\n    color: import(\"three/webgpu\").UniformNode<\"color\", Color>;\n    amount: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    top: import(\"three/webgpu\").UniformNode<\"float\", number>;\n};\n/**\n * Rain and snow: thousands of drops or flakes in one instanced draw, placed entirely by the\n * vertex shader. Each drop's start comes from a hash of its instance index; it falls through a\n * box of air around a centre (the camera's focus) whose x and z wrap in world space, so walking\n * through the weather doesn't drag the drops sideways (the box's height follows the centre). Rain falls fast and slants with the wind; snow\n * drifts and sways. `intensity` (0..1) shows that share of the drops: no buffers change, no\n * shader recompiles. Splashes are left to the game (`splashes(dt)` says how many this frame).\n *\n *   const rain = new Precipitation({ kind: 'rain', count: 3000, area: [24, 14, 24] });\n *   scene.add(rain);\n *   // per frame: rain.update(dt, camera.focus); rain.intensity = 0.7; rain.wind.set(3, 0)\n */\nimport { InstancedMesh, Vector2, Vector3 } from 'three/webgpu';\nexport type PrecipitationKind = 'rain' | 'snow';\nexport interface PrecipitationOptions {\n    kind: PrecipitationKind;\n    /** Most drops at once (the instance count). */\n    count: number;\n    /** Width, height and depth of the air the drops fall through, around the centre. */\n    area?: readonly [number, number, number];\n    /** Drop colour (hex). */\n    color?: number;\n    /** Fall speed (m/s). Rain 16, snow 1.4. */\n    speed?: number;\n}\nexport declare class Precipitation extends InstancedMesh {\n    readonly kind: PrecipitationKind;\n    readonly area: readonly [number, number, number];\n    /** Wind (m/s along x and z): rain slants, snow drifts. */\n    readonly wind: Vector2;\n    private readonly uTime;\n    private readonly uCenter;\n    private readonly uWind;\n    private readonly uIntensity;\n    private readonly uSpeed;\n    private t;\n    constructor(o: PrecipitationOptions);\n    /** Share of the drops falling (0..1). */\n    get intensity(): number;\n    set intensity(v: number);\n    /** Fall speed (m/s). */\n    get speed(): number;\n    set speed(v: number);\n    /** Per frame (game time): advance the fall and follow `center`. */\n    update(dt: number, center: Vector3): void;\n    /** How many drops hit the ground in `dt` seconds at this intensity (for splash particles, ripples). */\n    splashes(dt: number): number;\n    dispose(): this;\n}\n/**\n * Cutscenes as data: camera keys the camera glides through on a smooth curve (or cuts to),\n * cues that fire once when the playhead passes them (an actor starts walking, a door opens, a\n * sound), subtitles, and letterbox bars that slide in and out. The timeline only keeps time\n * and answers \"where is the camera now, what line is showing\": the game puts the camera\n * there and draws the bars, so it works with any camera and any HUD.\n *\n *   const scene = new Timeline({\n *     shots: [\n *       { at: 0, position: [0, 2, 9], target: [0, 1, 0] },\n *       { at: 4, position: [6, 3, 4], target: [0, 1, 0] },   // a glide from the first key\n *       { at: 4, position: [1, 1.6, 2], target: [0, 1.5, 0], cut: true },  // a cut\n *     ],\n *     cues: [{ at: 1, name: 'wave', run: () => actor.play('Wave') }],\n *     lines: [{ at: 0.5, until: 3, who: 'GUIDE', text: 'Welcome.' }],\n *   });\n *   scene.play();\n *   scene.update(dt);                       // per frame: fires the cues it passes\n *   const shot = scene.camera();            // { position, target, fov }\n *   scene.skip();                           // to the end: cues that matter still fire\n *\n * Pure (no three.js): unit-tested.\n */\nexport type V3 = readonly [number, number, number];\nexport interface CameraKey {\n    /** Time (s) the camera is exactly here. */\n    at: number;\n    position: V3;\n    /** The point it looks at. */\n    target: V3;\n    /** Vertical field of view (degrees); default the previous key's, or 50. */\n    fov?: number;\n    /** Jump here instead of gliding from the key before (a cut to a new shot). */\n    cut?: boolean;\n}\nexport interface Cue {\n    at: number;\n    name?: string;\n    run: () => void;\n    /**\n     * Cosmetic (a sound, a puff of dust): not run when the scene is skipped past it. Cues that\n     * change the world (a door left open, an item given) are run on skip so the world ends up\n     * the same either way.\n     */\n    cosmetic?: boolean;\n}\nexport interface Line {\n    at: number;\n    until: number;\n    text: string;\n    /** Who is speaking (shown before the text). */\n    who?: string;\n}\nexport interface CameraShot {\n    position: [number, number, number];\n    target: [number, number, number];\n    fov: number;\n}\nexport interface TimelineOptions {\n    shots?: readonly CameraKey[];\n    cues?: readonly Cue[];\n    lines?: readonly Line[];\n    /** Length (s); default the last key, cue or line. */\n    duration?: number;\n    /** Seconds the letterbox bars take to slide in and out (default 0.6; 0: no bars). */\n    bars?: number;\n    /** Called once when the playhead reaches the end (or the scene is skipped). */\n    onEnd?: () => void;\n}\nexport declare class Timeline {\n    readonly duration: number;\n    /** The playhead (s). */\n    time: number;\n    playing: boolean;\n    /** Playback rate (1: real time, 0.5: slow motion). */\n    speed: number;\n    /** True once the end has been reached (by playing or skipping). */\n    ended: boolean;\n    /** Cue names in the order they fired (tests and tools). */\n    readonly fired: string[];\n    private readonly keys;\n    private readonly cues;\n    private readonly lines;\n    private readonly barTime;\n    private readonly onEnd?;\n    /** How many cues (in time order) have fired. */\n    private next;\n    /** Bumped by every seek and skip: a cue that moves the playhead stops the cues after it. */\n    private jumps;\n    /** Inside skip(): cues run to the end whatever they do to the playhead. */\n    private skipping;\n    constructor(o: TimelineOptions);\n    play(): void;\n    pause(): void;\n    /** Advance by `dt` seconds of game time (times `speed`) while playing, firing the cues passed. */\n    update(dt: number): void;\n    /**\n     * Move the playhead to `t` without firing the cues in between (scrubbing). Cues before `t`\n     * count as done and cues after it will fire again (going back re-arms them). Ignored while\n     * skipping (a cue that loops back cannot undo a skip).\n     */\n    seek(t: number): void;\n    /**\n     * Jump to the end: the cues not yet fired run (except the cosmetic ones), then `onEnd`. Cues\n     * after `duration` never fire, played or skipped.\n     */\n    skip(): void;\n    private fireUpTo;\n    private finish;\n    /**\n     * Where the camera is at `t` (default now): on each key at its time, gliding between keys\n     * on a smooth curve (Catmull-Rom tangents, so the speed has no jolt at a key; the first and\n     * last key of each shot ease in and out). A `cut` key starts a new shot. Null without keys.\n     */\n    camera(t?: number): CameraShot | null;\n    /** The subtitle showing at `t` (default now), or null. */\n    line(t?: number): Line | null;\n    /** How far the letterbox bars are in (0..1) at `t` (default now): sliding in at the start, out at the end. */\n    bars(t?: number): number;\n}\nimport { type Camera, Group, Vector3 } from 'three/webgpu';\nimport { type BurstOptions, type ParticlePreset } from './pool';\nimport { Rng } from '../random';\n/** What the particle system needs to size particles in art pixels. */\nexport interface ParticleView {\n    camera: Camera;\n    /** Point the camera looks at (sizes are exact there). */\n    focus: Vector3;\n    /** Internal (art) resolution height. */\n    height: number;\n}\n/**\n * Pixel-art particles: CPU-simulated pools, drawn as camera-facing square sprites in flat\n * palette colors. One emitter (one instanced draw call, one pooled instance buffer) per\n * preset; sizes are whole art pixels, so in Pixel mode a particle is a crisp N×N block.\n * Available as `ctx.particles`; emitters are created on first use and freed by `clear()`\n * (the engine calls it when a level unloads).\n *\n *   ctx.particles.burst('dust', hero.feet);\n *   ctx.particles.burst('skid', feet, { direction: [-vx, 0.3, -vz], count: 2 });\n */\nexport declare class Particles {\n    private readonly view;\n    /** Engine-owned group holding every emitter. */\n    readonly group: Group<import(\"three\").Object3DEventMap>;\n    /** Preset registry: the built-ins plus anything registered. */\n    readonly presets: Map<string, ParticlePreset>;\n    /** World units per art pixel at the camera focus (updated every frame). */\n    readonly pixelWorld: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    /** Emitters by key: `@name` for registered presets, `#<json>` for inline preset objects. */\n    private readonly emitters;\n    private readonly inlineKeys;\n    private readonly geometry;\n    private warnedMany;\n    /** Where bursts get their randomness: the level's stream (the engine reseeds it per level). */\n    private rng;\n    private readonly random;\n    constructor(view: () => ParticleView);\n    /** Add or replace a named preset. Replacing frees the old preset's emitter. */\n    register(name: string, preset: ParticlePreset): void;\n    /**\n     * Spawn a burst of `preset` (a name or a ParticlePreset) at `at`. Returns the number of\n     * particles spawned (fewer when the pool is full, 0 for an unknown preset). Inline\n     * preset objects share one emitter per distinct content, so `burst({ ...literal }, at)`\n     * every frame stays one pool and one draw call; prefer `register` + a name, and vary a\n     * burst with `options` (count, direction, speed, scale, colors).\n     */\n    burst(preset: string | ParticlePreset, at: Vector3 | readonly [number, number, number], options?: BurstOptions): number;\n    /** Particles alive right now, over all emitters. */\n    get alive(): number;\n    /** Emitters (= draw calls at most) currently allocated. */\n    get emitterCount(): number;\n    /** Simulate and upload. Called by the engine every frame (frozen while paused). */\n    update(dt: number): void;\n    /** Take bursts' randomness from `rng` (the engine passes each level's `ctx.random` fork). */\n    reseed(rng: Rng): void;\n    /** Kill every particle and free the emitters (GPU buffers, materials). */\n    clear(): void;\n    dispose(): void;\n    private inlineKey;\n    private free;\n    private emitter;\n    private updatePixelSize;\n}\n/**\n * Navigation on a grid: which cells can be walked, the shortest path between two points\n * (A*, 8-connected, no corner cutting, smoothed by line of sight), a flow field toward one\n * target (one Dijkstra fill, then any number of agents read a direction per cell for free),\n * and line-of-sight tests (vision cones, stealth). Pure and allocation-light; unit-tested.\n *\n *   const nav = NavGrid.fromRows(['#########', '#...#...#', '#.#...#.#', '#########'], { cell: 1, origin: [-4.5, 0, -2] });\n *   const path = nav.path([-3, 0, -1], [3, 0, -1]);       // world points, corners only\n *   nav.flowTo(hero.x, hero.z);                            // once when the target changes cell\n *   nav.flowDirection(x, z, out);                          // per agent per step\n *   nav.lineOfSight(ax, az, bx, bz);                       // walls block, open cells don't\n */\nexport interface NavGridOptions {\n    /** Metres per cell. Default 1. */\n    cell?: number;\n    /** World x, z of the top-left cell's corner (column 0, row 0). Default: centred on the origin. */\n    origin?: readonly [number, number, number];\n}\nexport declare class NavGrid {\n    readonly width: number;\n    readonly height: number;\n    readonly cell: number;\n    /** World x, z of cell (0, 0)'s corner. */\n    readonly ox: number;\n    readonly oz: number;\n    /** 1 = walkable. */\n    readonly open: Uint8Array;\n    /** Bumped by `setOpen`: flow fields rebuild. */\n    version: number;\n    private readonly g;\n    private readonly from;\n    private readonly flow;\n    private readonly heap;\n    private flowTarget;\n    private flowVersion;\n    /** How many times a flow field was built (tools: should be one per target cell change). */\n    flowBuilds: number;\n    constructor(width: number, height: number, o?: NavGridOptions);\n    /**\n     * From an ASCII map: `blocked` characters are closed, everything else open. Default '# ': walls\n     * and pits (a ' ' has no floor in RoomKit's maps); past the end of a short row is a wall.\n     */\n    static fromRows(rows: readonly string[], o?: NavGridOptions & {\n        blocked?: string;\n    }): NavGrid;\n    col(x: number): number;\n    row(z: number): number;\n    /** World x, z of a cell's centre. */\n    centerX(col: number): number;\n    centerZ(row: number): number;\n    isOpen(col: number, row: number): boolean;\n    /** Is the world point on a walkable cell? */\n    walkable(x: number, z: number): boolean;\n    setOpen(col: number, row: number, open: boolean): void;\n    /**\n     * Shortest path between two world points (x, z used; y kept from `from`): A* over cells,\n     * no corner cutting, then smoothed so it only turns where a wall is in the way. Null when\n     * there is no way. The first point is `from`, the last `to` (snapped into its cell).\n     */\n    path(from: readonly [number, number, number], to: readonly [number, number, number]): [number, number, number][] | null;\n    /** A* from cell `start` to cell `goal`: the cells of a shortest way, or null. */\n    private search;\n    /** Drop every point the path can skip in a straight line. */\n    smooth(pts: [number, number, number][]): [number, number, number][];\n    /** Open cells near (col, row), nearest first (itself if open; else within 4 cells, straight neighbours before diagonals). */\n    private openNear;\n    /**\n     * Can you see (or walk straight) from a to b? Walks the cells under the segment (a DDA);\n     * `radius` > 0 also tests two lines offset sideways (a body that wide fits).\n     */\n    lineOfSight(ax: number, az: number, bx: number, bz: number, radius?: number): boolean;\n    /**\n     * Distance from a along a direction to the first closed cell (at most `max`): the same cell\n     * walk as `lineOfSight`, so a vision cone drawn with it shows exactly what a guard can see.\n     */\n    castWall(ax: number, az: number, dx: number, dz: number, max: number): number;\n    /** Grid DDA: true if every cell the segment crosses is open. */\n    private ray;\n    /**\n     * Walk the cells along a + t·d for t in 0..1 (a DDA): where the first closed cell begins, as\n     * a fraction of d (0 when a is in one), or 1 when there is none.\n     */\n    private walk;\n    /**\n     * A flow field toward the world point (x, z): the walking distance from every cell to it.\n     * Rebuilt only when the target changes cell or the grid changed (`version`). Returns\n     * whether it was rebuilt.\n     */\n    flowTo(x: number, z: number): boolean;\n    /** Walking distance to the flow target from a world point (Infinity: no way). */\n    flowDistance(x: number, z: number): number;\n    /**\n     * Which way to go from (x, z) toward the flow target: the unit direction to the\n     * lowest-distance neighbour (into `out` [x, z]). Returns false at the target or with no way.\n     */\n    flowDirection(x: number, z: number, out: [number, number]): boolean;\n}\nimport { type Resolution } from './framing';\nimport type { QualityOption } from './quality';\nimport { type Look } from './render/look';\nimport type { RenderMode } from './render/PixelRenderer';\n/**\n * The player's settings: the standard picture and engine options every game gets, as plain data\n * (sound is the AudioManager's, which keeps its own volumes). A field left out is the game's own\n * choice; a field set is the player's and wins over it. `engine.settings` holds them, applies\n * them, saves them per game and shows them in the settings panel (the ⚙ button).\n */\nexport interface PlayerSettings {\n    /** A LOOK_PRESETS name. Left out: the look the game gives each level. */\n    look?: string;\n    /** Pixel art (the pixel pass), or false for smooth 3D (render mode `raw`). */\n    pixelArt?: boolean;\n    /** The art resolution: `fine` (the game's, 480×270 by default) or `chunky` (two thirds of it: bigger pixels). */\n    pixelSize?: 'fine' | 'chunky';\n    /** Shadow and light quality: a level, or `auto` (the device's). */\n    quality?: QualityOption;\n    /** Frame cap: 60, 30, or 0 for the display's own rate. */\n    fps?: number;\n    /** The debug panel: frame rate, camera, GPU errors and the game's status. */\n    debugInfo?: boolean;\n}\nexport declare const PIXEL_SIZES: readonly [\"fine\", \"chunky\"];\nexport declare const QUALITY_OPTIONS: readonly QualityOption[];\nexport declare const FPS_OPTIONS: readonly number[];\n/** Keep only fields with a valid value: what storage or a caller handed over may be anything. */\nexport declare function normalizeSettings(raw: unknown): PlayerSettings;\n/** The settings saved under `key` ({} when there are none, or storage is blocked or holds junk). */\nexport declare function loadSettings(key: string): PlayerSettings;\nexport declare function storeSettings(key: string, settings: PlayerSettings): void;\n/** The engine options a page URL's review flags set (what `optionsFromUrl` gives). */\nexport type UrlFlags = {\n    look?: unknown;\n    filters?: unknown;\n    mode?: unknown;\n    resolution?: unknown;\n    quality?: unknown;\n    maxFps?: unknown;\n    debugUI?: unknown;\n};\n/**\n * The settings a page URL's review flags set (`?look=`, `?filters=`, `?mode=`, `?res=`,\n * `?quality=`, `?fps=`, `?debug=`): the fields `url` (optionsFromUrl) holds that the game's\n * `options` took (`withUrlOptions`). They win over the saved ones at start.\n */\nexport declare function urlSettings(url: UrlFlags, options?: UrlFlags): Set<keyof PlayerSettings>;\n/** Chunky pixels for a resolution: the engine's 320×180 for its 480×270, else two thirds of it. */\nexport declare function chunkyResolution(base: Resolution): Resolution;\n/** What the settings change in the engine (Engine implements it; tests pass a fake). */\nexport interface SettingsHost {\n    readonly look: Look;\n    setLook(look: Look): void;\n    readonly renderer: {\n        readonly mode: RenderMode;\n        readonly baseResolution: Resolution;\n        readonly lookVersion: number;\n        setMode(mode: RenderMode): void;\n        setResolution(resolution: Resolution): void;\n    };\n    maxFps: number;\n    readonly qualityOption: QualityOption;\n    useQuality(option: QualityOption): void;\n    readonly debugShown: boolean;\n    showDebug(on: boolean): void;\n}\n/**\n * `engine.settings`: the player's settings, applied to the engine and saved. A field the page URL\n * sets (`?look=`, `?mode=`, `?res=`, `?quality=`, `?fps=`, `?debug=`: review flags) wins over a\n * saved one at start (which stays saved). `open`, `close` and `toggle` show and hide the\n * settings panel.\n */\nexport declare class Settings {\n    private readonly host;\n    readonly key: string | null;\n    /** The player's choices: the saved ones from the start, and a game's `set()` before it. */\n    private current;\n    /** Saved choices a review flag in the URL overrides: not applied, still saved. */\n    private held;\n    private game;\n    private readonly listeners;\n    private shown;\n    /** `host.renderer.lookVersion` once the settings last set the look: unchanged, nothing else did since. */\n    private lookShown;\n    /** `key`: where they are saved (`pixel-engine:settings:<key>`), or null for nowhere. */\n    constructor(host: SettingsHost, key: string | null);\n    /** The player's choices in effect: fields left out are the game's (or a review flag's). */\n    get values(): Readonly<PlayerSettings>;\n    get isOpen(): boolean;\n    /** Change some settings: applied at once and saved. A field set to `undefined` goes back to the game's. */\n    set(patch: PlayerSettings): void;\n    /** Forget every choice, the held ones too: the game's own picture again. */\n    reset(): void;\n    /** Make `values` the settings, changing only the fields that differ: the ones it leaves out go back to the game's. */\n    replace(values: PlayerSettings): void;\n    /** Called with the values after every change; returns the unsubscribe. */\n    onChange(fn: (values: Readonly<PlayerSettings>) => void): () => void;\n    open(): void;\n    close(): void;\n    toggle(): void;\n    private save;\n    /** Put each field of `s` into the engine; `fields` also lists cleared ones (back to the game's). */\n    private apply;\n}\n/**\n * Behaviour trees: an agent's decisions as a tree of small nodes, ticked every step. Each tick\n * a node answers success, failure or running (still at it). Selectors try their children in\n * priority order until one doesn't fail; sequences run theirs in order until one doesn't\n * succeed. Both are reactive: every tick starts again from the first child, so a higher\n * priority (flee!) takes over at once, and whatever was running below it is halted.\n *\n *   const tree = new BehaviorTree(\n *     selector('root',\n *       sequence('flee', condition('scared?', (b) => b.threat < 3), action('run away', fleeStep)),\n *       sequence('work', action('go to crystal', goTo), action('pick it up', pickUp)),\n *       action('wander', wander)),\n *     blackboard);\n *   tree.tick(dt);       // per step; tree.trace() for drawing it\n */\nexport type Status = 'success' | 'failure' | 'running';\nexport declare abstract class BtNode<B> {\n    readonly name: string;\n    readonly kind: string;\n    /** Status at the last tick that reached this node. */\n    status: Status | null;\n    /** The tree's tick count when this node last ran. */\n    visited: number;\n    readonly children: BtNode<B>[];\n    /** The tree it belongs to: a node keeps its own state, so it can be in one tree only. */\n    tree: BehaviorTree<B> | null;\n    constructor(name: string, kind: string);\n    protected abstract tick(b: B, dt: number, tree: BehaviorTree<B>): Status;\n    /** Tick this node (keeps `status` and `visited` for the trace). */\n    run(b: B, dt: number, tree: BehaviorTree<B>): Status;\n    /** Interrupted: forget any progress, and tell actions that were running to stop. */\n    halt(b: B): void;\n}\n/** Children in priority order: the first that doesn't fail decides (success or running). */\nexport declare const selector: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n/** Children in order: fails at the first failure, runs while one runs, succeeds when all have. Reactive: from the top each tick. */\nexport declare const sequence: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n/** A sequence that resumes where it was (steps that must not be checked again once done). */\nexport declare const steps: <B>(name: string, ...children: BtNode<B>[]) => BtNode<B>;\n/** All children at once (each until it finishes): 'all' succeeds when every one has and fails at a failure, 'one' succeeds as soon as one has. */\nexport declare const parallel: <B>(name: string, needed: \"all\" | \"one\", ...children: BtNode<B>[]) => BtNode<B>;\n/** A test: success if true, failure if not. */\nexport declare const condition: <B>(name: string, test: (b: B) => boolean) => BtNode<B>;\n/** Something done a step at a time: return 'running' until it is done. `onHalt` tidies up if it is interrupted. */\nexport declare const action: <B>(name: string, step: (b: B, dt: number) => Status, onHalt?: (b: B) => void) => BtNode<B>;\n/** Running for `seconds`, then success (from zero again next time, or after a halt). */\nexport declare const wait: <B>(name: string, seconds: number) => BtNode<B>;\n/** Success becomes failure and failure success. */\nexport declare const inverter: <B>(child: BtNode<B>, name?: string) => BtNode<B>;\n/** Success whatever the child answered, once it has finished. */\nexport declare const succeeder: <B>(child: BtNode<B>, name?: string) => BtNode<B>;\n/** The child `times` times over: running until it has succeeded that often; a failure fails. */\nexport declare const repeat: <B>(child: BtNode<B>, times: number, name?: string) => BtNode<B>;\n/** After the child succeeds it fails, without running, for `seconds` of tree time (no spamming). */\nexport declare const cooldown: <B>(child: BtNode<B>, seconds: number, name?: string) => BtNode<B>;\nexport interface TraceRow {\n    name: string;\n    kind: string;\n    depth: number;\n    /** This tick's answer, or null if this tick never reached the node. */\n","numLines":720,"startLine":1,"totalLines":720}},"tool_result_meta":[{"id":"toolu_01JKPbKMcGwYZpFThdLdpkZn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
