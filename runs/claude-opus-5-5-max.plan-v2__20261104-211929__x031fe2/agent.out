e:[1280,1280],cells:[512,512],bands:[{below:-7,color:PALETTE.red},{below:-1,color:PALETTE.orange},{below:12,color:PALETTE.sand},{below:99,color:PALETTE.orange}],steep:0.8,rock:PALETTE.plum});\n    land.generate(height); land.attach(physics); land.mesh.receiveShadow=true; scene.add(land.mesh); this.land=land;\n    this.sky=skyAt(HOUR); applySky(engine,this.sky);\n    const fog=groundFog({color:this.sky.sky,top:1,amount:0.7,near:120,far:FAR*0.9}); scene.fogNode=fog.node;\n    // grass around the start\n    const grass=new GrassField({area:[140,140],at:[0,0,0],count:60000,height:[0.5,1.1],width:0.12,base:PALETTE.orange,tip:PALETTE.sand,ground:(x,z)=>land.heightAt(x,z),seed:3,mask:(x,z)=>noise.fbm2(x*0.03,z*0.03)>-0.25}); scene.add(grass); this.grass=grass; grass.wind.set(2.5,0.8);\n    // trees\n    const place=(id,x,z,o={},yaw=0)=>{const m=buildModel(id,{...o,catalog:MODELS}); m.object.position.set(x,land.heightAt(x,z),z); m.object.rotation.y=yaw; scene.add(m.object); return m;};\n    for(let i=0;i<220;i++){const x=ctx.random.range(-620,620),z=ctx.random.range(-620,620); const a=place('acacia',x,z,{seed:i},ctx.random.range(0,6.28)); a.object.scale.setScalar(ctx.random.range(0.8,1.5)); }\n    this.tree=place('acacia',18,-22,{},1);\n    place('boulders',8,-12,{params:{size:2}}); place('dead-tree',-14,-18,{params:{h:4}});\n    // soldiers on the hero rig, built from a model def\n    const clips=(obj)=>compileClips(HERO_CLIPS.filter(c=>['Run','Idle','Walk','Crouch','Death','Hurt'].includes(c.name)),{...HERO_RIG,spine:undefined},obj);\n    for(let i=0;i<6;i++){ const b=buildModel('soldier',{catalog:MODELS}); const x=-6+i*3, z=-16-(i%2)*4; b.object.position.set(x,land.heightAt(x,z),z); b.object.rotation.y=i*0.7; setLookLayer(b.object,'actors'); scene.add(b.object); const mix=new AnimationMixer(b.object); const cl=clips(b.object); const act=mix.clipAction(cl.find(c=>c.name===(i%2?'Run':'Idle'))||cl[0]); act.play(); this.actors.push({b,mix}); const sh=new ContactShadow(0.42);