ead_text()\nfixes = [\n (\"`r.prop`\\n(lamps, flags, banners, torches, barrels)\", \"`r.prop`\\n(lamps, street lamps, banners, torches, braziers, fire drums, lanterns)\"),\n (\"and props (`lamp`, `streetlamp`, `banner`, `flag`, `torch`, `candle`, `lantern`,\\n`pot`, `skull`, `cobweb`).\",\n  \"and props (`lamp`, `streetlamp`, `banner`, `torch`, `brazier`, `firedrum`, `candle`,\\n`lantern`, `pot`, `skull`, `cobweb`).\"),\n (\"A flag and windsock show it, and a HUD arrow with mph.\", \"A windsock (a shape) and the banners' sway show it, and a HUD arrow with mph.\"),\n]\nfor old, new in fixes:\n    n = s.count(old); assert n == 1, (n, old[:60])\n    s = s.replace(old, new)\np.write_text(s); print('ok')\nPY\ngrep -n \"flag\" PLAN.md | cut -c1-150","description":"Replace the nonexistent flag prop with real ones"}},"wire_ingest_context":{"toolu_013TM8ZdR3wvNEvEpFwvVqNY":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174819__xcfe199/work"}}}
