px 0 #0004}.action.primary{background:var(--orange);color:var(--ink);border:2px solid var(--orange)}.action.primary:focus,.action.primary:hover{background:var(--yellow);border-color:var(--yellow)}.action small{font-size:.6em;text-transform:uppercase;letter-spacing:.12em;opacity:.75}.arrow{font-size:1.4em;line-height:.7}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:.5em;max-width:21em}.two-col .action{font-size:.72em}.footer-note{font-size:.62em;color:var(--muted);line-height:1.6;margin-top:1.6em;max-width:33em}.stamp{position:absolute;right:4vw;top:5vh;transform:rotate(5deg);border:2px solid var(--ink);padding:.4em .8em;color:var(--ink);background:var(--yellow);font-weight:900;font-size:.62em;text-transform:uppercase;letter-spacing:.12em;box-shadow:3px 3px 0 var(--ink)}#corner{position:absolute;left:2.6vw;bottom:3vh;font-size:.62em;letter-spacing:.12em;text-transform:uppercase;pointer-events:none;text-shadow:1px 2px var(--ink)}#loading{position:absolute;inset:0;background:var(--ink);display:grid;place-content:center;text-align:center;z-index:10}#loading b{font-size:2.7em;font-family:'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;color:var(--orange)}#loading p{font-size:.8em;margin-top:1em;color:var(--muted)}.spinner{margin:1.5em auto;width:2em;height:2em;border:3px solid #42615b;border-top-color:var(--yellow);border-radius:50%;animation:spin 1s infinite linear}#hud{position:absolute;inset:0;pointer-events:none;padding:2.6vh 3vw;display:flex;flex-direction:column;justify-content:space-between}.hud-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1em}.hud-box{background:#102b35ed;padding:.55em .8em;border-bottom:4px solid var(--orange);box-shadow:3px 3px 0 #081c2350}.score-box{min-width:8em}.label{font-size:.53em;letter-spacing:.18em;font-weight:800;text-transform:uppercase;color:var(--muted)}#score{font-family:'Barlow Condensed',Impact,sans-serif;font-size:2em;line-height:1.1;font-weight:800;letter-spacing:.03em}#best{font-size:.5em;color:var(--yellow)}.sector-box{text-align:center;min-width:18em;border-color:var(--teal)}#sectorName{font-family:'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;letter-spacing:.06em;font-size:1.28em;line-height:1.4}.route-line{height:4px;background:#41605d;position:relative;width:100%;margin:.35em 0 .1em}.route-line:before,.route-line:after{content:'';position:absolute;top:-3px;width:2px;height:10px;background:var(--cream)}.route-line:before{left:30%}.route-line:after{left:63%}#routeFill{height:100%;width:0;background:var(--yellow)}.status-box{min-width:12em;border-color:var(--yellow)}#hull{letter-spacing:.2em;font-size:1.1em;color:var(--orange);line-height:1.5}.fuel-row{display:flex;align-items:center;justify-content:space-between;font-size:.58em;letter-spacing:.12em;font-weight:800}.fuel-meter{height:.6em;background:#44615b;margin-top:.3em;border:1px solid #8b9c83}#fuelFill{height:100%;background:var(--teal);width:100%;transition:background .2s}.hud-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:1em}.radio{max-width:25em;display:flex;align-items:center;gap:.8em;background:#102b35e8;border-left:4px solid var(--teal);padding:.7em 1em}.radio-icon{color:var(--teal);font-size:1.5em;font-weight:800}#radioText{font-size:.72em;line-height:1.4}.abilities{background:#102b35e8;display:flex;gap:1.5em;padding:.65em .9em}.ability{min-width:4em}.ability strong{font-size:.8em;color:var(--yellow)}.ability small{display:block;font-size:.48em;letter-spacing:.08em;text-transform:uppercase;line-height:1.8;color:var(--muted)}#pauseButton{position:absolute;right:3vw;top:calc(2.6vh + 8.4em);pointer-events:auto;border:1px solid #819b88;background:#102b35e0;padding:.3em .65em;font-size:.65em}#banner{position:absolute;left:50%;top:29%;transform:translate(-50%,-50%) rotate(-2deg);text-align:center;pointer-events:none;min-width:22em;filter:drop-shadow(4px 4px #102b3540)}#banner strong{display:block;font-family:'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;font-size:3.2em;font-weight:900;line-height:1;color:var(--cream);text-shadow:3px 3px 0 var(--ink)}#banner small{display:inline-block;background:var(--orange);color:var(--ink);text-transform:uppercase;letter-spacing:.13em;font-size:.63em;padding:.5em 1em;margin-top:.4em;font-weight:800}#bossHud{position:absolute;top:19vh;left:50%;transform:translateX(-50%);width:min(26em,45vw);background:#102b35e8;padding:.4em .8em}#bossHud .label{color:var(--orange)}.boss-track{margin-top:.3em;height:.4em;background:#45605b}#bossFill{height:100%;background:var(--orange);width:100%}#attractTag{position:absolute;bottom:16vh;left:50%;transform:translateX(-50%);background:var(--yellow);color:var(--ink);font-size:.7em;text-align:center;padding:.5em 1em;font-weight:800;letter-spacing:.1em;box-shadow:4px 4px var(--ink)}#ghosts{font-size:.55em;position:absolute;left:3vw;top:18vh;background:#102b35d8;padding:.6em .9em;color:#d9c9ff;white-space:pre-line;max-width:23em}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65em;margin-bottom:1em}.info-card{padding:.8em;background:#21434b;border-left:3px solid var(--teal);font-size:.76em;line-height:1.45}.info-card b{display:block;font-size:1.05em;color:var(--yellow);margin-bottom:.3em}.row{display:flex;align-items:center;gap:1em;justify-content:space-between;padding:.55em .1em;border-bottom:1px solid #49645e;font-size:.82em}.row label{flex:1}.row input[type=range]{width:43%;accent-color:var(--orange);cursor:pointer}.row output{min-width:2.8em;text-align:right;color:var(--yellow);font-weight:700}.row select{background:#31585e;color:var(--cream);padding:.35em;border:1px solid #8c9f88;max-width:50%;font-size:.9em}.row input[type=checkbox]{accent-color:var(--orange);width:1.3em;height:1.3em}.row input[type=text]{min-width:3em;width:55%;padding:.4em;background:#24474e;color:var(--cream);border:1px solid #7e9c8c;text-transform:uppercase}.back-row{display:flex;gap:.5em;margin-top:1em}.back-row .action{font-size:.85em;flex:1}.scroll-body{max-height:57vh;overflow:auto;overscroll-behavior:contain;padding-right:1em;font-size:.74em;line-height:1.55;touch-action:pan-y}.scroll-body h3{font-size:1.15em}.credit-row{padding:.22em 0;border-bottom:1px solid #41605b}.credit-row b{color:var(--muted)}.feedback-item{margin:.45em 0}.feedback-item b{color:var(--yellow)}#flash{position:absolute;inset:0;pointer-events:none;background:#ff684d;opacity:0}#touchMenu{display:none;position:absolute;right:4vw;top:4vh;border:2px solid var(--cream);background:#102b35a0;border-radius:50%;width:2.5em;height:2.5em;font-size:.9em}#touchPulse{display:none;position:absolute;right:6vw;bottom:15vh;border:2px solid var(--yellow);background:#102b35b0;border-radius:50%;width:3.2em;height:3.2em;font-size:.8em;color:var(--yellow)}#touchRing{position:absolute;pointer-events:none;border:2px solid #fff0cc55;border-radius:50%;width:90px;height:90px;transform:translate(-50%,-50%);display:none}#touchDot{position:absolute;pointer-events:none;background:#fff0cc88;border:2px solid var(--ink);border-radius:50%;width:25px;height:25px;transform:translate(-50%,-50%);display:none}.metrics{display:flex;gap:1.4em;margin:1em 0}.metric b{display:block;color:var(--yellow);font-size:2em;font-family:'Barlow Condensed',Impact,sans-serif}.metric small{font-size:.6em;text-transform:uppercase;letter-spacing:.1em}#debugLine{font-family:monospace;font-size:.54em;color:var(--muted);margin:.6em 0;line-height:1.5}.local-note{padding:.7em;background:#25494f;font-size:.72em;line-height:1.5;border-left:3px solid var(--yellow);margin-bottom:1em}.badge{display:inline-block;border:1px solid var(--teal);color:var(--teal);font-size:.55em;padding:.3em .7em;letter-spacing:.1em;margin-top:1em}body[data-touch=true] #touchMenu{display:block}body[data-touch=true].in-flight #touchPulse{display:block}body[data-touch=true] #pauseButton{display:none}body[data-touch=true] #corner{display:none}body[data-touch=true] .abilities{display:none}@keyframes spin{to{transform:rotate(360deg)}}@keyframes slide-in{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:translateX(0)}}@media(max-width:850px){:root{--ui:clamp(15px,2.25vw,21px)}#menu{padding:4vh 5vw;background:linear-gradient(90deg,#102b35fa,#102b35ed 50%,#102b3555)}h1{font-size:clamp(64px,13vw,108px)}.title-panel{max-width:24em}.stamp{font-size:.55em;right:3vw}.sector-box{min-width:12em}.status-box{min-width:9em}.hud-box{padding:.4em .6em}.score-box{min-width:6.5em}.radio{max-width:24em}.info-grid{gap:.5em}#bossHud{top:23vh}}@media(max-width:600px){#menu{padding:5vh 6vw;background:linear-gradient(90deg,#102b35f5,#102b35dc 75%,#102b3560);align-items:flex-start}.panel{margin:auto 0}.title-panel{padding-top:1em}h1{font-size:21vw}.eyebrow{font-size:.6em}.stamp{top:2vh;font-size:.45em}.title-panel .menu-list{max-width:22em;gap:.35em}.action{min-height:2.65em}.footer-note{margin-top:1em}.sector-box{min-width:0;position:absolute;left:50%;transform:translateX(-50%);top:13vh;width:17em;font-size:.73em;padding:.3em .7em}#hud{padding:2vh 4vw}.status-box{margin-right:3em;min-width:9em;font-size:.85em}.score-box{font-size:.85em}.radio{font-size:.9em;max-width:22em;padding:.5em .8em}.info-grid{grid-template-columns:1fr}.info-card{padding:.55em}.info-card b{margin-bottom:.1em}h2{font-size:2.4em}#banner{top:35%;min-width:20em;font-size:.75em}#attractTag{bottom:21vh;width:80%;font-size:.6em}#bossHud{top:23vh;width:75vw}#ghosts{top:21vh;left:4vw;font-size:.5em}.scroll-body{max-height:62vh}.hud-bottom{margin-bottom:2vh}.metrics{gap:1em}.back-row{flex-wrap:wrap}}\n@media(prefers-reduced-motion:reduce){*{animation:none\"'!important;transition:none!important}}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/tsl\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\",\"rapier\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs\"}}</script>\n</head><body>\n<canvas id=\"game\" aria-label=\"Upstream Uproar river flight game\"></canvas><div id=\"vignette\"></div><div id=\"grain\"></div>\n<div id=\"loading\"><div class=\"eyebrow\">A river needs a little trouble</div><b>Upstream Uproar</b><div class=\"spinner\"></div><p id=\"loadingMessage\">Warming up the propeller…</p></div>\n<div id=\"menu\" class=\"hidden\"></div>\n<div id=\"hud\" class=\"hidden\"><div class=\"hud-top\"><div class=\"hud-box score-box\"><div class=\"label\">River score</div><div id=\"score\">000000</div><div id=\"best\">BEST 000000</div></div><div class=\"hud-box sector-box\"><div class=\"label\" id=\"sectorLabel\">Sector 01 / 03</div><div id=\"sectorName\">Sandbar Shuffle</div><div class=\"route-line\"><div id=\"routeFill\"></div></div></div><div class=\"hud-box status-box\"><div class=\"fuel-row\"><span>Hull <span id=\"lives\"></span></span><span id=\"combo\"></span></div><div id=\"hull\">◆◆◆◆</div><div class=\"fuel-row\"><span>Fuel</span><span id=\"fuelNumber\">100%</span></div><div class=\"fuel-meter\"><div id=\"fuelFill\"></div></div></div></div><div class=\"hud-bottom\"><div class=\"radio\"><div class=\"radio-icon\">≋</div><div><div class=\"label\">Finch / River radio</div><div id=\"radioText\">Keep your wings dry, hotshot.</div></div></div><div class=\"abilities\"><div class=\"ability\"><strong id=\"rollStatus\">READY</strong><small id=\"rollPrompt\">SHIFT · ROLL</small></div><div class=\"ability\"><strong id=\"pulseStatus\">● ● ●</strong><small id=\"pulsePrompt\">Q · PULSE</small></div></div></div><button id=\"pauseButton\">ESC Ⅱ</button></div>\n<div id=\"bossHud\" class=\"hidden\"><div class=\"label\">Ironwake · River lockdown</div><div class=\"boss-track\"><div id=\"bossFill\"></div></div></div>\n<div id=\"banner\" class=\"hidden\"><strong></strong><small></small></div><div id=\"attractTag\" class=\"hidden\">AUTOPILOT DEMO · ANY INPUT TO TAKE OVER</div><div id=\"ghosts\" class=\"hidden\"></div><div id=\"flash\"></div>\n<div id=\"corner\">Move · WASD &nbsp;&nbsp; Fire · SPACE &nbsp;&nbsp; Pause · ESC</div><button id=\"touchMenu\" aria-label=\"Pause or open menu\">Ⅱ</button><button id=\"touchPulse\" aria-label=\"River pulse\">PULSE</button><div id=\"touchRing\"></div><div id=\"touchDot\"></div>\n<script type=\"module\">\n// GAME_CODE\n</script></body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' world.js && sed -n '120,225p' world.js && sed -n '225,340p' world.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' world.js && sed -n '120,225p' world.js && sed -n '225,340p' world.js\"","aggregated_output":"import * as THREE from 'three/webgpu';\n\n// All silhouettes, terrain and animation are generated here. No image assets.\nconst INK = 0x173b3b;\nconst P = { ink: INK, water: 0x167f85, deep: 0x116773, foam: 0x8ed8cb, sand: 0xf6c46b, cream: 0xfff1c3, grass: 0x79a970, darkGrass: 0x46795f, red: 0xf66b47, navy: 0x254d58 };\nconst materials = new Map();\nconst edgeMaterial = new THREE.LineBasicMaterial({ color: INK });\nconst shadowMaterial = new THREE.MeshBasicMaterial({ color: 0x074e5d, transparent: true, opacity: 0.26, depthWrite: false });\nconst ramp = new THREE.DataTexture(new Uint8Array([105,105,105,255,170,170,170,255,224,224,224,255,255,255,255,255]),4,1,THREE.RGBAFormat);\nramp.minFilter=THREE.NearestFilter;ramp.magFilter=THREE.NearestFilter;ramp.needsUpdate=true;\nfunction mat(color, unlit = false) {\n  const key = color + ':' + unlit;\n  if (!materials.has(key)) materials.set(key, unlit ? new THREE.MeshBasicMaterial({ color }) : new THREE.MeshToonMaterial({ color, gradientMap:ramp, flatShading: true }));\n  return materials.get(key);\n}\nfunction mesh(geometry, color, outline = true, unlit = false) {\n  const m = new THREE.Mesh(geometry, mat(color, unlit));\n  m.castShadow = true;\n  m.receiveShadow = true;\n  if (outline) m.add(new THREE.LineSegments(new THREE.EdgesGeometry(geometry, 24), edgeMaterial));\n  return m;\n}\nfunction box(g, x, y, z, color, px = 0, py = 0, pz = 0, outline = true) {\n  const m = mesh(new THREE.BoxGeometry(x, y, z), color, outline);\n  m.position.set(px, py, pz); g.add(m); return m;\n}\nfunction cylinder(g, r1, r2, height, color, x = 0, y = 0, z = 0, sides = 8) {\n  const m = mesh(new THREE.CylinderGeometry(r1, r2, height, sides), color);\n  m.position.set(x, y, z); g.add(m); return m;\n}\nfunction beam(g, a, b, radius, color) {\n  const start = new THREE.Vector3(...a), end = new THREE.Vector3(...b), d = end.clone().sub(start);\n  const m = mesh(new THREE.CylinderGeometry(radius, radius, d.length(), 5), color);\n  m.position.copy(start.add(end).multiplyScalar(0.5));\n  m.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), d.normalize());\n  g.add(m); return m;\n}\nfunction prism(points, height, color) {\n  const vectors = points.map(p => new THREE.Vector2(p[0], p[1]));\n  const tri = THREE.ShapeUtils.triangulateShape(vectors, []);\n  const verts = [], n = points.length;\n  const put = (i,y) => verts.push(points[i][0], y, points[i][1]);\n  for (const t of tri) { for (const i of [...t].reverse()) put(i,height/2); for (const i of t) put(i,-height/2); }\n  for(let i=0;i<n;i++) {const j=(i+1)%n; put(i,-height/2);put(j,height/2);put(j,-height/2);put(i,-height/2);put(i,height/2);put(j,height/2);}\n  const geo = new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));geo.computeVertexNormals();\n  return mesh(geo,color);\n}\nfunction shadow(g, x = 1.5, z = 2, y = -1.26) {\n  const s = new THREE.Mesh(new THREE.CircleGeometry(1, 16), shadowMaterial);\n  s.rotation.x = -Math.PI / 2; s.scale.set(x, z, 1); s.position.set(0.25, y, 0.6); g.add(s);return s;\n}\n\nexport function river(progress) {\n  return { center: Math.sin(progress * 0.014) * 3.5 + Math.sin(progress * 0.031 + 0.6) * 1.9, width: 8.8 + Math.sin(progress * 0.023) * 1.15 + Math.sin(progress * 0.007 + 1) * 0.75 };\n}\n\nexport function makePlane(color = P.red) {\n  const group = new THREE.Group();\n  const body = new THREE.Group(); body.name = 'airframe'; group.add(body);\n  const hull = prism([[-0.34,-1.65],[0.34,-1.65],[0.53,-0.45],[0.28,1.6],[-0.28,1.6],[-0.53,-0.45]], 0.55, color); body.add(hull);\n  const wing = prism([[-0.35,-0.45],[-2.15,0.27],[-2.15,0.72],[-0.28,0.31],[0.28,0.31],[2.15,0.72],[2.15,0.27],[0.35,-0.45]], 0.16,P.cream); wing.position.y = 0.02;body.add(wing);\n  box(body,0.23,0.2,0.56,P.navy,-1.97,0.04,0.49); box(body,0.23,0.2,0.56,P.navy,1.97,0.04,0.49);\n  const tail=prism([[-0.2,0.9],[-1,1.43],[-1,1.69],[0,1.38],[1,1.69],[1,1.43],[0.2,0.9]],0.12,color);tail.position.y=.19;body.add(tail);\n  box(body,0.12,0.64,0.7,P.cream,0,.42,1.18);\n  const canopy = mesh(new THREE.SphereGeometry(0.44, 8, 5), P.navy); canopy.scale.set(.72,.67,1.4); canopy.position.set(0,.34,-.13);body.add(canopy);\n  const glass = mesh(new THREE.SphereGeometry(.25,6,4),0xa9e5da,false,true);glass.scale.set(.65,.35,1.1);glass.position.set(-.09,.59,-.21);body.add(glass);\n  box(body,.14,.04,.46,P.cream,0,.3,-1.1);\n  const nose = mesh(new THREE.ConeGeometry(.33,.48,8),P.cream);nose.rotation.x=-Math.PI/2;nose.position.z=-1.82;body.add(nose);\n  const prop = new THREE.Group();prop.name='propeller';prop.position.set(0,0,-2.03);body.add(prop);\n  box(prop,1.2,.09,.075,P.navy);box(prop,.09,1.2,.075,P.navy);\n  const flame = mesh(new THREE.ConeGeometry(.21,.7,7),0xffdb77,false,true);flame.name='thrust';flame.rotation.x=Math.PI/2;flame.position.set(0,-.04,1.84);body.add(flame);\n  const ring = new THREE.Mesh(new THREE.TorusGeometry(.35,.025,4,20),mat(P.cream,true));ring.position.z=-.95;ring.rotation.x=Math.PI/2;body.add(ring);\n  shadow(group,1.8,1.3);\n  const mixer = new THREE.AnimationMixer(group);\n  const clip = new THREE.AnimationClip('Cruise', .8, [\n    new THREE.NumberKeyframeTrack('propeller.rotation[z]',[0,.8],[0,Math.PI*12]),\n    new THREE.NumberKeyframeTrack('thrust.scale[y]',[0,.2,.4,.6,.8],[1,1.3,.8,1.2,1]),\n    new THREE.NumberKeyframeTrack('airframe.position[y]',[0,.4,.8],[0,.07,0]),\n  ]);\n  mixer.clipAction(clip).play();\n  group.userData.airframe=body;group.userData.flame=flame;\n  return {group,mixer};\n}\n\nexport function makeGhost(color=0x89ddd9) {\n  const {group,mixer}=makePlane(color);\n  group.traverse(o=>{if(o.isMesh){o.material=o.material.clone();o.material.transparent=true;o.material.opacity=.6;o.material.depthWrite=false;}});\n  group.userData.mixer=mixer;return group;\n}\n\nfunction boat() {\n  const g=new THREE.Group();\n  g.add(prism([[-.75,1.55],[-.94,-.6],[0,-1.7],[.94,-.6],[.75,1.55]],.48,P.navy));\n  const deck=prism([[-.59,1.4],[-.75,-.55],[0,-1.4],[.75,-.55],[.59,1.4]],.12,P.cream);deck.position.y=.3;g.add(deck);\n  box(g,1.05,.5,1.0,P.red,0,.56,.45);box(g,.8,.25,.45,P.navy,0,.9,.36);\n  cylinder(g,.25,.3,.27,P.navy,0,.53,-.65);beam(g,[0,.64,-.65],[0,.64,-1.5],.09,P.ink);\n  beam(g,[-.66,.45,.1],[-.66,.45,1.3],.035,P.ink);beam(g,[.66,.45,.1],[.66,.45,1.3],.035,P.ink);\n  return g;\n}\nfunction helicopter() {\n  const g=new THREE.Group();\n  const hull=mesh(new THREE.SphereGeometry(.7,8,5),0xe8bd5e);hull.scale.set(1,.75,1.5);hull.position.y=.8;g.add(hull);\n  const glass=mesh(new THREE.SphereGeometry(.53,8,4),P.navy);glass.scale.set(1,.75,.9);glass.position.set(0,.96,-.6);g.add(glass);\n  const tail=mesh(new THREE.ConeGeometry(.25,2.0,5),P.red);tail.rotation.x=Math.PI/2;tail.position.set(0,.75,1.6);g.add(tail);\n  box(g,.1,.6,.6,P.navy,0,1,2.4);beam(g,[0,1,0],[0,1.65,0],.08,P.ink);\n  const rotor=new THREE.Group();rotor.position.y=1.65;g.add(rotor);\n  box(rotor,3.8,.065,.18,P.ink);box(rotor,.18,.065,3.8,P.ink);\n  for(const x of [-.58,.58]) {beam(g,[x,.26,-.55],[x,.26,.8],.07,P.cream);beam(g,[x,.26,.1],[x,.61,.1],.05,P.ink);}\n  g.userData.rotor=rotor;shadow(g,1.5,1.2,-.65);return g;\n}\nfunction fuel() {\n  const g=new THREE.Group();\n  box(g,2.25,.16,3.2,P.cream,0,.04,0);box(g,2.0,.06,2.95,0x4ea984,0,.16,0);\n  for(const x of [-.63,.63]) cylinder(g,.29,.29,.9,P.sand,x,.63,.4,8);\n  box(g,1.3,.65,.85,0xeff5c9,0,.55,-.55);box(g,.35,.06,.95,P.red,0,.91,-.55);box(g,.95,.06,.35,P.red,0,.92,-.55);\n  const ring=new THREE.Mesh(new THREE.TorusGeometry(1.45,.06,5,28),mat(P.cream,true));ring.rotation.x=-Math.PI/2;ring.position.y=.23;g.add(ring);g.userData.ring=ring;\n  for(const x of [-1,1]) {box(g,.08,1.5,.08,P.ink,x,.85,-1.3);box(g,.32,.3,.03,P.sand,x,1.5,-1.3);}\n  return g;\n}\nfunction bridge() {\nfunction bridge() {\n  const g=new THREE.Group();\n  box(g,20,.42,2.6,P.cream,0,.2,0);box(g,20,.07,1.6,P.navy,0,.44,0);\n  for(let x=-9;x<10;x+=2) box(g,.85,.025,.06,P.cream,x,.49,0,false);\n  for(const z of [-1.25,1.25]) {\n    beam(g,[-10,.45,z],[10,.45,z],.075,P.ink);beam(g,[-10,1.8,z],[10,1.8,z],.09,P.red);\n    for(let x=-10;x<10;x+=2) {beam(g,[x,.45,z],[x+1,1.8,z],.07,P.red);beam(g,[x+1,1.8,z],[x+2,.45,z],.07,P.red);}\n  }\n  for(const x of [-8,8]) box(g,.75,1.2,3.2,P.sand,x,-.3,0);\n  box(g,2.2,.75,1.8,P.red,0,.91,0);box(g,.3,.04,1.4,P.cream,0,1.31,0);box(g,1.6,.04,.3,P.cream,0,1.32,0);\n  return g;\n}\nfunction turret() {\n  const g=new THREE.Group();\n  cylinder(g,.85,1.05,.35,P.sand,0,.2,0,8);cylinder(g,.63,.73,.5,P.navy,0,.6,0,8);\n  const gun=new THREE.Group();g.add(gun);cylinder(g,.42,.5,.4,P.red,0,.97,0);\n  beam(g,[0,1.05,0],[0,1.05,1.3],.13,P.ink);g.userData.turret=gun;return g;\n}\nfunction boss() {\n  const g=new THREE.Group();\n  g.add(prism([[-2.5,3.6],[-2.9,-2.4],[-1.6,-4.1],[1.6,-4.1],[2.9,-2.4],[2.5,3.6]],.75,P.navy));\n  const deck=prism([[-2.15,3.35],[-2.45,-2.3],[-1.35,-3.6],[1.35,-3.6],[2.45,-2.3],[2.15,3.35]],.18,0xe5bd67);deck.position.y=.5;g.add(deck);\n  box(g,2.9,.85,2.25,P.red,0,1,-.8);box(g,2.4,.6,1.3,P.cream,0,1.7,-.8);box(g,2.15,.3,.45,P.navy,0,1.94,-1.26);\n  for(const x of [-1.5,1.5]) {const t=turret();t.scale.setScalar(.9);t.position.set(x,.53,1.75);g.add(t);box(g,.45,.2,1.3,0xffd87e,x,.65,3);}\n  const mast=new THREE.Group();mast.position.set(0,2,-.5);g.add(mast);beam(mast,[0,0,0],[0,1.8,0],.08,P.ink);\n  const radar=box(mast,1.8,.45,.12,P.cream,0,1.7,0);g.userData.radar=radar;\n  for(const x of [-2.6,2.6]) {box(g,.5,.5,5.5,P.red,x,.5,0);for(let z=-2;z<3;z++)box(g,.54,.1,.32,P.cream,x,.8,z);}\n  return g;\n}\n\nexport function makeEntity(type) {\n  if(type==='boat')return boat();if(type==='heli')return helicopter();if(type==='fuel')return fuel();if(type==='bridge')return bridge();if(type==='turret')return turret();if(type==='boss')return boss();\n  const g=new THREE.Group();\n  if(type==='bullet') {const m=box(g,.14,.16,1.0,0xfff4bc,0,0,0,false);m.material=mat(0xfff4bc,true);box(g,.35,.1,.32,0xffae54,0,0,.4,false);}\n  else if(type==='enemyBullet') {const m=mesh(new THREE.OctahedronGeometry(.22),0xffd677,false,true);g.add(m);}\n  return g;\n}\n\nfunction tree(seed=0) {\n  const g=new THREE.Group();\n  cylinder(g,.13,.19,1.4,0x8a7054,0,.5,0,5);\n  const colors=[0x3d806b,0x4e9674,0x6aaa7c];\n  for(let j=0;j<2;j++){const crown=mesh(new THREE.IcosahedronGeometry(.9-j*.17,0),colors[(seed+j)%3]);crown.scale.set(1,1.15,1);crown.position.set(j*.12,1.65+j*.65,0);g.add(crown);}\n  return g;\n}\nfunction rock(seed) {\n  const g=new THREE.Group();const m=mesh(new THREE.IcosahedronGeometry(1,0),seed%2?0xe4a65d:0xf1bd71);m.scale.set(1.3+(seed%3)*.4,.6+(seed%4)*.3,.9);m.rotation.y=seed;g.add(m);\n  const top=mesh(new THREE.IcosahedronGeometry(.65,0),0x89a976);top.scale.set(1.3,.35,.9);top.position.y=.6+(seed%4)*.21;g.add(top);return g;\n}\nfunction pylon() {\n  const g=new THREE.Group();\n  for(const x of [-.4,.4])for(const z of [-.35,.35])beam(g,[x,0,z],[x*.4,3.2,z*.4],.045,P.ink);\n  for(let y=.5;y<3;y+=.7){beam(g,[-.4,y,-.35],[.4,y+.6,-.35],.03,P.ink);beam(g,[.4,y,.35],[-.4,y+.6,.35],.03,P.ink);}\n  box(g,2.3,.09,.09,P.ink,0,2.75,0);for(const x of [-.9,.9])cylinder(g,.13,.13,.27,P.cream,x,2.9,0,6);\n  return g;\n}\n\nclass Ribbon {\n  constructor(scene,steps,color,unlit=false) {\n    this.steps=steps;this.positions=new Float32Array(steps*18);this.geometry=new THREE.BufferGeometry();\n    this.geometry.setAttribute('position',new THREE.BufferAttribute(this.positions,3));\n    const normals=new Float32Array(steps*18);for(let i=1;i<normals.length;i+=3)normals[i]=1;this.geometry.setAttribute('normal',new THREE.BufferAttribute(normals,3));\n    this.mesh=new THREE.Mesh(this.geometry,mat(color,unlit));this.mesh.receiveShadow=!unlit;this.mesh.frustumCulled=false;scene.add(this.mesh);\n  }\n  update(sample,z0,step) {\n    const a=this.positions;\n    for(let i=0;i<this.steps;i++) {\n      const z=z0+i*step, p=sample(z),q=sample(z+step), j=i*18;\n      if(p[0]>p[1]){[p[0],p[1]]=[p[1],p[0]];[p[2],p[3]]=[p[3],p[2]];}\n      if(q[0]>q[1]){[q[0],q[1]]=[q[1],q[0]];[q[2],q[3]]=[q[3],q[2]];}\n      a.set([p[0],p[2],z,q[0],q[2],z+step,q[1],q[3],z+step,p[0],p[2],z,q[1],q[3],z+step,p[1],p[3],z],j);\n    }\n    this.geometry.attributes.position.needsUpdate=true;\n  }\n}\n\nexport class WorldView {\n  constructor(scene) {\n    this.scene=scene;this.effects=[];this.time=0;this.progress=0;this.ribbons=[];\n    const steps=96;\n    const add=(color,sample,unlit=false)=>this.ribbons.push({r:new Ribbon(scene,steps,color,unlit),sample});\n    add(P.water,(r)=>[r.center-r.width,r.center+r.width,0,0],true);\n    for(const side of [-1,1]) {\n      const edge=(r)=>r.center+side*r.width;\n      add(0x279d98,r=>[edge(r)-side*.7,edge(r),.012,.012],true);\n      add(P.ink,r=>[edge(r),edge(r)+side*.12,.025,.025],true);\n      add(P.sand,r=>[edge(r)+side*.12,edge(r)+side*.8,.1,.13]);\n      add(0xcd9158,r=>[edge(r)+side*.8,edge(r)+side*1.15,.13,.75]);\n      add(P.ink,r=>[edge(r)+side*1.15,edge(r)+side*1.25,.76,.76],true);\n      add(0x8bb57d,r=>[edge(r)+side*1.25,edge(r)+side*3.2,.78,.78]);\n      add(0x78a571,r=>[edge(r)+side*3.2,side*75,.8,.8]);\n    }\n    this.props=[];\n    for(let i=0;i<68;i++) {\n      const seed=i%17;const obj=seed%8===0?pylon():seed%3===0?rock(seed):tree(seed);\n      scene.add(obj);this.props.push({obj,slot:i});\n    }\n    this.foams=[];\n    for(let i=0;i<100;i++) {\n      const f=new THREE.Mesh(new THREE.PlaneGeometry(.045,.55+(i%5)*.22),mat(i%3?0x4eb7af:0x8bd6c9,true));f.rotation.x=-Math.PI/2;f.position.y=.024;scene.add(f);this.foams.push(f);\n    }\n    this.clouds=[];\n    for(let i=0;i<7;i++) {\n      const cloud=new THREE.Group();for(let j=0;j<3;j++){const m=mesh(new THREE.IcosahedronGeometry(1.7,1),0xfff1cd,false,true);m.scale.set(1.5,.32,1);m.position.x=j*1.5;cloud.add(m);}cloud.position.y=8+i*.3;scene.add(cloud);this.clouds.push(cloud);\n    }\n  }\n  }\n  render(progress,time) {\n    this.progress=progress;this.time=time;\n    for(const {r,sample} of this.ribbons) r.update(z=>sample(river(progress-z+5)),-106,1.5);\n    const first=Math.floor(progress/5)*5;\n    for(const {obj,slot} of this.props) {\n      const side=slot%2===0?-1:1,at=first+(Math.floor(slot/2)-4)*5;\n      const v=river(at),noise=Math.sin(at*1.732+side*8),off=2.7+(noise+1)*3.2;\n      obj.position.set(v.center+side*(v.width+off),.9,5-(at-progress));obj.rotation.y=Math.sin(at)*2;\n      obj.scale.setScalar(.8+(Math.sin(at*.73)+1)*.3);\n    }\n    for(let i=0;i<this.foams.length;i++) {\n      const at=first+(i-17)*1.25 + ((time*.5)%1.25),v=river(at);\n      this.foams[i].position.set(v.center+Math.sin(i*71.7)*(v.width-.8),.025,5-(at-progress));\n      this.foams[i].scale.y=1+Math.sin(time*2+i)*.2;\n    }\n    for(let i=0;i<this.clouds.length;i++) {const at=first+(i-1)*21;this.clouds[i].position.x=river(at).center+(i%2?21:-25)+Math.sin(time*.05+i)*4;this.clouds[i].position.z=5-(at-progress);}\n  }\n  makeBurst(x,z,color=0xf9c66e) {\n    const g=new THREE.Group();g.position.set(x,.9,z);this.scene.add(g);\n    for(let i=0;i<16;i++) {const m=mesh(new THREE.OctahedronGeometry(.18+(i%3)*.12),i%3?color:P.cream,false,true);g.add(m);m.userData.velocity=new THREE.Vector3(Math.cos(i*2.399)*(.8+i*.15),1+(i%4),Math.sin(i*2.399)*(.8+i*.15));}\n    const ring=new THREE.Mesh(new THREE.TorusGeometry(.45,.06,4,20),mat(P.cream,true));ring.rotation.x=-Math.PI/2;g.add(ring);\n    this.effects.push({g,life:0,ring});return g;\n  }\n  updateEffects(dt) {\n    for(let i=this.effects.length-1;i>=0;i--) {\n      const e=this.effects[i];e.life+=dt;for(const m of e.g.children){if(m.userData.velocity){m.position.addScaledVector(m.userData.velocity,dt);m.userData.velocity.y-=dt*6;m.rotation.x+=dt*4;m.rotation.z+=dt*2;m.scale.setScalar(Math.max(.01,1-e.life));}}\n      e.ring.scale.setScalar(1+e.life*7);e.ring.visible=e.life<.55;\n      if(e.life>1){this.scene.remove(e.g);e.g.traverse(o=>{if(o.isMesh)o.geometry.dispose();});this.effects.splice(i,1);}\n    }\n    return this.effects.length;\n  }\n  river(progress){return river(progress);}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'rapier';\nimport { WorldView, river, makePlane, makeGhost, makeEntity } from './world.js';\nimport { AudioSystem } from './audio.js';\nimport { NetworkSession } from './network.js';\nimport { CREDITS } from './credits.js';\n\nconst \"'$ = id => document.getElementById(id);\nconst clamp = (v,a,b) => Math.max(a,Math.min(b,v));\nconst lerp = (a,b,t) => a+(b-a)*t;\nconst padNumber = n => Math.floor(n).toString().padStart(6,'\"'0');\nconst escapeHTML = s => String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst DEFAULTS = Object.freeze({speed:16,steering:13,fireRate:7,fuelDrain:.92,enemyRate:1,damage:1,timeScale:1});\nconst tuning = {...DEFAULTS};\nconst settings = {music:.1,sfx:.7,glyphs:'playstation',shake:true,assist:false};\ntry {Object.assign(settings,JSON.parse(localStorage.getItem('upstream-settings')||'{}'));}catch{}\nsettings.music=clamp(Number(settings.music)||0,0,1);settings.sfx=clamp(Number(settings.sfx)||0,0,1);\nlet best=0;try{best=+localStorage.getItem('upstream-best')||0;}catch{}\nconst audio = new AudioSystem();audio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst network = new NetworkSession();\nconst keys = new Set(), previousPads=new Map(), ghostMeshes=new Map();\nlet renderer,scene,camera,world,physics,eventQueue;\nlet state='loading',previousMenu='title',lastInput=performance.now(),lastFrame=0,accumulator=0,visualTime=0,titleProgress=250;\nlet players=[],entities=[],bullets=[],enemyBullets=[],colliders=new Map(),nextId=1;\nlet progress=0,score=0,fuel=100,hull=4,lives=3,pulses=3,combo=1,comboClock=0,kills=0,bridges=0,refuels=0,elapsed=0,checkpoint=0;\nlet bossDefeated=false,attract=false,coop=false,godMode=false,autoPilot=false,shake=0,flash=0,sector=0,shownSector=-1,reportClock=0;\nlet bannerClock=0,radioClock=0,lastRadio='',rolls=0,shots=0,deaths=0,clearTimer=0,hubStarted=false,hubEnded=false;\nlet inputMode='keyboard',mouseX=null,mouseHeld=false,touchControl=null,pulseQueued=false,rollQueued=false,menuFocus=0,menuCooldown=0;\nlet stats={collisions:0,damage:0,fuelCollected:0,bridgeKills:0,bossPhases:0,simSteps:0};\nconst diagnostics={ready:false,renderer:'unknown',errors:[],bootMs:0};\nconst bootAt=performance.now();\nconst SECTORS=['Sandbar Shuffle','Needle Bend','Ironwake Lock'];\nconst BOSS_AT=2420,FINISH_AT=2650;\nconst activePlay=()=>state==='playing';\nconst gameplayScreen=()=>['playing','paused','dev'].includes(state);\nconst hasPad=()=>inputMode==='pad';\nconst glyph=(action)=>{\n  if(\"'!hasPad()) return ({fire:'\"'SPACE',roll:'SHIFT',pulse:'Q',pause:'ESC',accept:'ENTER',back:'ESC',move:'WASD'})[action];\n  const ps=settings.glyphs\"'!=='\"'xbox';return ({fire:'RT',roll:ps?'R1':'RB',pulse:ps?'○':'B',pause:ps?'OPTIONS':'MENU',accept:ps?'✕':'A',back:ps?'○':'B',move:'L STICK'})[action];\n};\nfunction saveSettings(){try{localStorage.setItem('upstream-settings',JSON.stringify(settings));}catch{}}\nfunction setInputMode(mode){if(inputMode===mode)return;inputMode=mode;document.body.dataset.touch=String(mode==='touch');updatePrompts();}\nfunction updatePrompts(){\n \"'$('\"'rollPrompt').textContent=\"'`${glyph('\"'roll')} · ROLL\"'`;$('\"'pulsePrompt').textContent=\"'`${glyph('\"'pulse')} · PULSE\"'`;\n $('\"'pauseButton').textContent=\"'`${glyph('\"'pause')} Ⅱ\"'`;\n $('\"'corner').textContent=inputMode==='touch'?'Drag anywhere · Auto fire · Tap PULSE to clear danger':\"'`${glyph('\"'move')} · STEER     \"'${glyph('\"'fire')} · FIRE     \"'${glyph('\"'roll')} · ROLL     \"'${glyph('\"'pulse')} · PULSE\"'`;\n document.querySelectorAll('\"'[data-glyph]').forEach(e=>e.textContent=glyph(e.dataset.glyph));\n}\nfunction activity(mode){lastInput=performance.now();if(mode)setInputMode(mode);if(attract){goTitle();return true;}return false;}\nfunction menuControls(){return [...\"'$('\"'menu').querySelectorAll('button:not(:disabled),input,select')];}\nfunction focusMenu(index){const a=menuControls();if(\"'!a.length)return;menuFocus=(index+a.length)%a.length;a[menuFocus].focus({preventScroll:true});a[menuFocus].scrollIntoView({block:'\"'nearest'});}\nfunction action(text,id,small='',primary=false){return \"'`<button class=\"action${primary?'\"' primary':''}\\\" data-action=\\\"\"'${id}\"><span>${text}</span>${small?`<small>${small}</small>`:'\"'<span class=\\\"arrow\\\">↗</span>'}</button>\"'`;}\nfunction backRow(extra='\"''){return \"'`<div class=\"back-row\">${action('\"'Back','back',glyph('back'))}\"'${extra}</div>`;}\nfunction panel(eyebrow,title,body,cls='\"''){return \"'`<section class=\"panel ${cls}\"><div class=\"eyebrow\">${eyebrow}</div><h2>${title}</h2>${body}</section>`;}\nfunction showMenu(which){\n if(network.active&&['\"'title','results','room'].includes(which))return;\n state=which;\"'$('\"'menu').classList.remove('hidden');\"'$('\"'hud').classList.toggle('hidden',which==='title'||which==='instructions'||which==='about'||which==='room'||which==='settings'&&previousMenu==='title');\n \"'$('\"'bossHud').classList.add('hidden');\"'$('\"'banner').classList.add('hidden');\"'$('\"'attractTag').classList.add('hidden');document.body.classList.remove('in-flight');\n let content='';\n if(which==='title') content=\"'`<section class=\"panel title-panel\"><div class=\"eyebrow\">The river is calling. Collect.</div><h1>Upstream<br><span>Uproar</span></h1><div class=\"tagline\">Low flight. High mischief.</div><div class=\"menu-list\">${action('\"'Fly the river','solo','1 pilot',true)}\"'${action('\"'Bring a wingmate','coop','2 pilots · local')}\"'${action('\"'Ghost challenge','room','AI Hub + browser rooms')}<div class=\\\"two-col\\\">\"'${action('\"'Flight manual','instructions')}\"'${action('\"'Settings','settings')}\"'${action('\"'About / credits','about')}\"'${action('\"'Fullscreen','fullscreen')}</div></div><p class=\\\"footer-note\\\">A river, a propeller, and absolutely no clearance.<br>Three sectors. Two bridges. One very stubborn boat.</p></section><div class=\\\"stamp\\\">RIVER PATROL / NO. 82</div>\"'`;\n if(which==='\"'paused')content=panel('Propeller on hold','Take a breather',\"'`<div class=\"menu-list\">${action('\"'Back to the river','resume',glyph('accept'),true)}\"'${action('\"'Settings','settings')}\"'${action('\"'Flight manual','instructions')}\"'${action('\"'Developer tools','dev')}\"'${action('\"'About / credits','about')}\"'${!network.active?action('\"'Restart mission','restart')+action('Return to title','title'):''}</div><p class=\\\"footer-note\\\">\"'${network.active?'\"'Hub round clock continues while your flight is paused.':'Your fuel is safe. The river can wait.'}</p>\"'`);\n if(which==='\"'settings')content=panel('Make yourself comfortable','Settings',\"'`<div class=\"row\"><label for=\"music\">Music</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"${settings.music*100}\"><output>${Math.round(settings.music*100)}%</output></div><div class=\"row\"><label for=\"sfx\">Effects &amp; radio</label><input id=\"sfx\" data-setting=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"${settings.sfx*100}\"><output>${Math.round(settings.sfx*100)}%</output></div><div class=\"row\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"playstation\" ${settings.glyphs==='\"'playstation'?'selected':''}>PlayStation</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"row\\\"><label for=\\\"shakeSetting\\\">Camera shake</label><input id=\\\"shakeSetting\\\" data-setting=\\\"shake\\\" type=\\\"checkbox\\\" \"'${settings.shake?'\"'checked':''}></div><div class=\\\"row\\\"><label for=\\\"assistSetting\\\">Auto cannon / aim assist</label><input id=\\\"assistSetting\\\" data-setting=\\\"assist\\\" type=\\\"checkbox\\\" \"'${settings.assist?'\"'checked':''}></div><p class=\\\"blurb\\\">Music starts at 10%. Touch flight always uses auto fire, light aim assist, and safe-bank steering.</p>\"'${backRow(action('\"'Reset settings','resetSettings'))}\"'`);\n if(which==='\"'instructions')content=panel('A small aircraft. A big attitude.','Flight manual',\"'`<div class=\"info-grid\"><div class=\"info-card\"><b>01 / Follow the current</b>${glyph('\"'move')} steers. Up accelerates; down brakes. Stay between the inked banks.</div><div class=\\\"info-card\\\"><b>02 / Make some room</b>Hold \"'${glyph('\"'fire')} to fire. \"'${glyph('\"'roll')} rolls through danger; \"'${glyph('\"'pulse')} clears bullets and hits nearby enemies.</div><div class=\\\"info-card\\\"><b>03 / Keep it topped up</b>Fly directly over green fuel barges. A full pass refills fuel and repairs one hull point. Brake to stay over them longer.</div><div class=\\\"info-card\\\"><b>04 / Break the blockade</b>Destroy both bridges for checkpoints. Sink the Ironwake, then fly clear. Kills build a score chain.</div></div><p class=\\\"blurb\\\">Mouse: move over the river to steer, hold left click to fire. Touch: drag anywhere to steer; cannon and emergency rolls are assisted. Tap the pulse button when danger closes in.</p><p class=\\\"blurb\\\">Local co-op: pilot 1 uses WASD / Space / Shift / Q; pilot 2 uses arrows / Enter / Slash / Period. Two standard controllers also work. Hull, fuel, and score are shared.</p>\"'${backRow()}`);\n if(which==='\"'room')content=panel('Leave a purple wake','Ghost challenge',\"'`<div class=\"local-note\"><b>Online with AI Hub</b><br>Launch this game in an AI Hub session for 1–4 networked pilots. Race your own mission with live, non-colliding ghosts and a shared score board.</div><div class=\"local-note\"><b>Browser-local rooms</b><br>Open the game in another tab in this browser, enter the same room code, and fly. These rooms connect tabs on this device; they do not connect separate devices.</div><div class=\"row\"><label for=\"roomCode\">Room code</label><input id=\"roomCode\" maxlength=\"16\" type=\"text\" value=\"${escapeHTML(network.room||'\"'RIVER82')}\\\" autocomplete=\\\"off\\\"></div><p class=\\\"blurb\\\" id=\\\"roomStatus\\\">\"'${network.room?`Room ${escapeHTML(network.room)} · ${network.peers.size} other pilot(s)`:'\"'Your ghost appears when the other pilot is in the same stretch of river.'}</p><div class=\\\"menu-list\\\">\"'${action('\"'Join room & fly','joinRoom','browser-local',true)}\"'${network.room?action('\"'Leave room','leaveRoom'):''}</div>\"'${backRow()}`);\n if(which==='\"'dev'){\n const sliders=[['speed','Cruise speed',6,32,.5],['steering','Steering speed',5,25,.5],['fireRate','Cannon / second',2,16,.5],['fuelDrain','Fuel / second',0,3,.05],['enemyRate','Enemy fire rate',0,3,.1],['damage','Collision damage',0,4,.25],['timeScale','Time scale',.25,3,.25]];\n content=panel('Live mission tuning','Developer tools',\"'`<div class=\"scroll-body\">${sliders.map(([k,label,min,max,step])=>`<div class=\"row\"><label for=\"tune-${k}\">${label}</label><input type=\"range\" id=\"tune-${k}\" data-tuning=\"${k}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[k]}\"><output>${tuning[k]}</output></div>`).join('\"'')}<div class=\\\"row\\\"><label for=\\\"invul\\\">Invulnerable / infinite fuel</label><input id=\\\"invul\\\" type=\\\"checkbox\\\" data-dev=\\\"god\\\" \"'${godMode?'\"'checked':''}></div><div class=\\\"row\\\"><label for=\\\"auto\\\">Autopilot</label><input id=\\\"auto\\\" type=\\\"checkbox\\\" data-dev=\\\"auto\\\" \"'${autoPilot?'\"'checked':''}></div><div class=\\\"back-row\\\">\"'${action('\"'Repair & resupply','resupply')}\"'${action('\"'Clear hostiles','clearHostiles')}</div><div class=\\\"back-row\\\">\"'${action('\"'Sector 1','warp0')}\"'${action('\"'Sector 2','warp1')}\"'${action('\"'Boss encounter','warp2')}</div><div id=\\\"debugLine\\\"></div></div>\"'${backRow(action('\"'Reset defaults','resetTuning'))}\"'`);\n }\n if(which==='\"'about'){\n const s=CREDITS.sourceInformation;\n content=panel('Made for the long way upstream','About / credits',\"'`<div class=\"scroll-body\"><p><b>Upstream Uproar</b> is an original arcade river-flight game inspired by the fuel pressure, river banks, and bridge busting of River Raid (1982). Original procedural art, writing, music, and sound.</p><h3>Source Information</h3>${Object.entries(s).map(([k,v])=>`<div class=\"credit-row\"><b>${escapeHTML(k)}:</b> ${escapeHTML(v)}</div>`).join('\"'')}\"'${['\"'testingFeedback','engineFeedback','promptFeedback'].map((key,i)=>\"'`<h3>${['\"'Testing Feedback','Engine Feedback','Prompt Feedback'][i]}</h3>\"'${CREDITS[key].map(t=>`<p class=\"feedback-item\">${escapeHTML(t)}</p>`).join('\"'')}\"'`).join('\"'')}<h3>Built with</h3><p>Three.js by the Three.js contributors · Rapier by Dimforge · Barlow typeface by Jeremy Tribby, with local system fallbacks · AI Hub Session Protocol v1 / client 1.4.0. No recorded audio or raster art assets.</p></div>\"'${backRow()}`);\n }\n if(which==='\"'results'){\n const won=bossDefeated&&progress>=FINISH_AT;\n const rank=won?(score>18000?'S':score>12000?'A':'B'):'—';\n content=panel(won?'The current is free again':'The river keeps its secrets',won?'Clear water ahead\"'!'\"':'Wings down.',\"'`<p class=\"blurb\">${won?'\"'Finch: “That boat had it coming. Same time tomorrow?”':'Finch: “We saved you a seat. And another propeller.”'}</p><div class=\\\"metrics\\\"><div class=\\\"metric\\\"><b>\"'${padNumber(score)}</b><small>Score</small></div><div class=\"metric\"><b>${rank}</b><small>Flight rank</small></div><div class=\"metric\"><b>${Math.floor(elapsed/60)}:${Math.floor(elapsed%60).toString().padStart(2,'\"'0')}</b><small>Flight time</small></div></div><p class=\\\"blurb\\\">\"'${kills} targets · ${bridges} bridges · ${refuels} fuel passes · ${rolls} rolls<br>Best score ${padNumber(best)}</p><div class=\"menu-list\">${action('\"'One more run','restart',glyph('accept'),true)}\"'${action('\"'Return to title','title')}</div>\"'`);\n }\n $('\"'menu').innerHTML=content;\n \"'$('\"'menu').querySelectorAll('[data-action]').forEach(el=>{el.addEventListener('click',()=>handleAction(el.dataset.action));el.addEventListener('pointerenter',()=>{el.focus({preventScroll:true});menuFocus=menuControls().indexOf(el);});});\n \"'$('\"'menu').querySelectorAll('[data-setting]').forEach(el=>el.addEventListener('input',()=>{const k=el.dataset.setting;settings[k]=el.type==='checkbox'?el.checked:el.type==='range'?+el.value/100:el.value;if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=Math.round(settings[k]*100)+'%';audio.setMusic(settings.music);audio.setSfx(settings.sfx);saveSettings();updatePrompts();}));\n \"'$('\"'menu').querySelectorAll('[data-tuning]').forEach(el=>el.addEventListener('input',()=>{tuning[el.dataset.tuning]=+el.value;el.nextElementSibling.textContent=el.value;}));\n \"'$('\"'menu').querySelectorAll('[data-dev]').forEach(el=>el.addEventListener('input',()=>{if(el.dataset.dev==='god')godMode=el.checked;else autoPilot=el.checked;}));\n updatePrompts();focusMenu(0);audio.pause(true);updateHud();\n}\nfunction handleAction(id){\n audio.unlock();lastInput=performance.now();\n if(id==='solo'||id==='coop'){resetRun({coop:id==='coop'});return;}\n if(id==='resume'){resume();return;}if(id==='restart'){resetRun({coop});return;}\n if(id==='title'){goTitle();return;}if(id==='fullscreen'){if(document.fullscreenElement)document.exitFullscreen?.();else document.documentElement.requestFullscreen?.().catch(()=>{});return;}\n if(id==='back'){showMenu(previousMenu==='paused'?'paused':'title');return;}\n if(['settings','instructions','about','dev','room'].includes(id)){if(state==='title'||state==='paused')previousMenu=state;showMenu(id);return;}\n if(id==='joinRoom'){const code=\"'$('\"'roomCode').value;if(network.joinRoom(code)){resetRun({});radio(\"'`Ghost room ${network.room}. Keep an eye out for purple wings.`);}else $('\"'roomStatus').textContent='This browser does not support local rooms.';return;}\n if(id==='leaveRoom'){network.leaveRoom();showMenu('room');return;}\n if(id==='resetSettings'){Object.assign(settings,{music:.1,sfx:.7,glyphs:'playstation',shake:true,assist:false});saveSettings();audio.setMusic(.1);audio.setSfx(.7);showMenu('settings');return;}\n if(id==='resetTuning'){Object.assign(tuning,DEFAULTS);godMode=false;autoPilot=false;showMenu('dev');return;}\n if(id==='resupply'){hull=4;fuel=100;pulses=3;lives=3;banner('Fresh wings','Fully repaired & refueled');updateHud();return;}\n if(id==='clearHostiles'){for(const e of [...entities])if(e.type\"'!=='\"'fuel')destroyEntity(e,true);for(const b of [...enemyBullets])removeObject(b,enemyBullets);updateHud();return;}\n if(id.startsWith('warp')){const target=[0,850,2350][+id.slice(-1)];const wasCoop=coop;resetRun({coop:wasCoop,at:target});godMode=true;state='paused';previousMenu='paused';showMenu('dev');return;}\n}\nfunction pause(){if(state\"'!=='\"'playing'||attract||hubEnded)return;keys.clear();mouseHeld=false;touchControl=null;previousMenu='paused';showMenu('paused');}\nfunction resume(){if(hubEnded)return;state='playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');document.body.classList.add('in-flight');audio.pause(false);keys.clear();lastInput=performance.now();}\nfunction goTitle(){if(network.active)return;attract=false;autoPilot=false;clearObjects();players.forEach(p=>scene.remove(p.mesh));players=[];state='title';titleProgress=progress||250;lastInput=performance.now();showMenu('title');\"'$('\"'ghosts').classList.add('hidden');hideTouchStick();}\nfunction banner(title,subtitle,duration=3){\"'$('\"'banner').querySelector('strong').textContent=title;\"'$('\"'banner').querySelector('small').textContent=subtitle;bannerClock=duration;\"'$('\"'banner').classList.remove('hidden');}\nfunction radio(text,voice='radio'){if(text===lastRadio&&radioClock>0)return;lastRadio=text;radioClock=6;\"'$('\"'radioText').textContent=text;audio.voice(voice);}\nfunction createPhysicsObject(obj,half){\n const desc=RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(obj.x,0,obj.z);\n obj.body=physics.createRigidBody(desc);\n const c=RAPIER.ColliderDesc.cuboid(...half).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS).setActiveCollisionTypes(RAPIER.ActiveCollisionTypes.ALL);\n obj.collider=physics.createCollider(c,obj.body);colliders.set(obj.collider.handle,obj);\n}\nfunction disposeMesh(group){group.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.isMesh&&o.material?.transparent&&o.material.opacity===.6)o.material.dispose();});}\nfunction removeObject(obj,list){if(obj.dead)return;obj.dead=true;if(obj.body){colliders.delete(obj.collider.handle);physics.removeRigidBody(obj.body);obj.body=null;}if(obj.mesh){scene.remove(obj.mesh);disposeMesh(obj.mesh);}if(list){const i=list.indexOf(obj);if(i>=0)list.splice(i,1);}}\nfunction clearObjects(){for(const list of [entities,bullets,enemyBullets])for(const e of [...list])removeObject(e,list);for(const p of players)if(p.body){colliders.delete(p.collider.handle);physics.removeRigidBody(p.body);p.body=null;}colliders.clear();}\nfunction spawnPlayer(index){\n const made=makePlane(index?0x63d9c0:0xff7048);const x=river(progress).center+(coop?(index?2.7:-2.7):0);\n const p={id:nextId++,type:'player',index,mesh:made.group,mixer:made.mixer,x,z:coop?6:5,roll:0,rollCooldown:0,fireCooldown:0,invul:3,bank:0,dead:false};\n p.mesh.position.set(x,1.7,p.z);scene.add(p.mesh);createPhysicsObject(p,[.65,1,.9]);players.push(p);return p;\n}\nfunction buildMission(){\n const specs=[];\n for(let at=90,i=0;at<2330;at+=27+(i%4)*6,i++){\n const type=i%7===3?'turret':i%4===1?'heli':'boat';specs.push({type,at,ratio:Math.sin(i*2.4)*.68});\n if(i>10&&i%4===0)specs.push({type:'boat',at:at+10,ratio:-Math.sin(i*2.4)*.65});\n }\n for(let i=0,at=175;at<2300;at+=240,i++)specs.push({type:'fuel',at,ratio:Math.sin(i*1.7)*.4});\n for(const at of [780,1580])specs.push({type:'bridge',at,ratio:0});\n specs.push({type:'fuel',at:2310,ratio:0},{type:'boss',at:BOSS_AT,ratio:0});\n return specs.sort((a,b)=>a.at-b.at).map((s)=>({id:nextId++,...s,dead:false,active:false,x:river(s.at).center+river(s.at).width*s.ratio,z:5-(s.at-progress),hp:({boat:3,heli:2,turret:5,fuel:1,bridge:26,boss:190})[s.type],maxHp:({boat:3,heli:2,turret:5,fuel:1,bridge:26,boss:190})[s.type],cooldown:1+(s.at%5)*.2,age:0}));\n}\nfunction resetRun(options={}){\n clearObjects();players.forEach(p=>{scene.remove(p.mesh);disposeMesh(p.mesh);});players=[];\n coop=\"'!!options.coop;attract=!!options.attract;autoPilot=false;\n progress=options.at||0;score=0;fuel=100;hull=4;lives=3;pulses=3;combo=1;comboClock=0;kills=0;bridges=progress>=1600?2:progress>=800?1:0;refuels=0;elapsed=0;checkpoint=progress>=1600?1600:progress>=800?800:0;\n bossDefeated=false;sector=0;shownSector=-1;rolls=0;shots=0;deaths=0;clearTimer=0;stats={collisions:0,damage:0,fuelCollected:0,bridgeKills:0,bossPhases:0,simSteps:0};\n entities=buildMission();entities=entities.filter(e=>e.at>progress-8);spawnPlayer(0);if(coop)spawnPlayer(1);\n state='\"'playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');\"'$('\"'bossHud').classList.add('hidden');\"'$('\"'attractTag').classList.toggle('hidden',\"'!attract);document.body.classList.add('\"'in-flight');audio.pause(false);keys.clear();pulseQueued=false;rollQueued=false;accumulator=0;network.reported=false;\n banner(progress>2300?'The Ironwake':'Sector 01 · Sandbar Shuffle',progress>2300?'Bust the boat. Free the current.':'Keep it low. Keep it moving.');\n radio('Keep your wings dry, hotshot. Green barges mean fuel.');updateHud();\n}\nfunction activateEntity(e){\n e.active=true;e.mesh=makeEntity(e.type);scene.add(e.mesh);\n if(e.type==='bridge')e.mesh.scale.x=river(e.at).width/10+0.2;\n const half=({boat:[.9,1,1.5],heli:[.9,1,1],fuel:[1.5,1,2.4],bridge:[river(e.at).width+1,1,1.5],boss:[2.9,1,4],turret:[.9,1,.9]})[e.type];\n createPhysicsObject(e,half);\n if(e.type==='boss'){banner('Ironwake','Make a little room upstream',3);radio('That is one very stubborn boat. Hit it between the volleys\"'!'\"','danger');stats.bossPhases=1;}\n if(e.type==='bridge'){radio('Bridge blockade ahead. Cannon first. Questions later.');}\n}\nfunction fire(p){\n if(p.fireCooldown>0)return;p.fireCooldown=1/tuning.fireRate;shots++;audio.shoot();\n const assist=settings.assist||inputMode==='touch';let vx=0;\n if(assist){const target=entities.filter(e=>e.active&&e.type\"'!=='\"'fuel'&&e.z<p.z-3&&e.z>p.z-55).sort((a,b)=>Math.abs(a.x-p.x)-Math.abs(b.x-p.x))[0];if(target)vx=clamp((target.x-p.x)*2,-10,10);}\n const b={id:nextId++,type:'bullet',x:p.x,z:p.z-2.2,vx,vz:-65,life:1.3,owner:p.index,mesh:makeEntity('bullet'),dead:false};scene.add(b.mesh);b.mesh.position.set(b.x,1.4,b.z);createPhysicsObject(b,[.23,1,.65]);bullets.push(b);\n}\nfunction enemyFire(e){\n if(tuning.enemyRate<=0)return;\n const target=players[(Math.floor(e.age)%players.length)]||players[0];if(\"'!target)return;\n const speed=e.type==='\"'boss'?16:12;const dx=target.x-e.x,dz=target.z-e.z,len=Math.hypot(dx,dz)||1;\n const spread=e.type==='boss'?(e.hp<e.maxHp*.5?[-.38,-.19,0,.19,.38]:[-.24,0,.24]):[0];\n for(const angle of spread){const a=Math.atan2(dx,dz)+angle,b={id:nextId++,type:'enemyBullet',x:e.x,z:e.z+1.8,vx:Math.sin(a)*speed,vz:Math.cos(a)*speed,life:7,mesh:makeEntity('enemyBullet'),dead:false};scene.add(b.mesh);createPhysicsObject(b,[.26,1,.26]);enemyBullets.push(b);}\n}\nfunction roll(p){if(p.rollCooldown>0||p.roll>0)return;p.roll=.7;p.rollCooldown=4.5;p.invul=Math.max(p.invul,.8);rolls++;audio.voice('roll');}\nfunction pulse(){\n if(pulses<=0)return;pulses--;shake=.3;flash=.12;audio.explosion();\n for(const p of players){world.makeBurst(p.x,p.z,0x60f3ca);p.invul=Math.max(p.invul,1.5);}\n for(const b of [...enemyBullets])removeObject(b,enemyBullets);\n for(const e of [...entities])if(e.active&&e.type\"'!=='\"'fuel'&&e.z>-48&&e.z<18){e.hp-=e.type==='boss'?32:12;if(e.hp<=0)destroyEntity(e);else world.makeBurst(e.x,e.z);}\n banner('River pulse',\"'`${pulses} remaining · bullets cleared`,1);updateHud();\n}\nfunction destroyEntity(e,silent=false){\n if(e.dead)return;\n const type=e.type,ex=e.x,ez=e.z;removeObject(e,entities);\n if(!silent){const points=({boat:150,heli:200,turret:250,bridge:1000,boss:5000})[type]||0;score+=points*combo;kills++;comboClock=4;combo=clamp(combo+1,1,5);world.makeBurst(ex,ez,type==='\"'boss'?0xff7048:0xffd467);audio.explosion();shake=Math.max(shake,type==='boss'?.65:.12);}\n if(type==='bridge'){bridges++;stats.bridgeKills++;checkpoint=e.at+20;fuel=clamp(fuel+25,0,100);pulses=Math.min(3,pulses+1);banner('Bridge busted\"'!'\"',\"'`Checkpoint ${bridges} / 2 · fuel +25 · pulse +1`);radio('\"'One less toll to pay. Nice flying\"'!'\"','win');}\n if(type==='boss'){bossDefeated=true;score+=2000;banner('Ironwake sunk\"'!'\"','The river is yours. Fly clear\"'!'\"',4);radio('Clear water ahead\"'! Bring those wings home.'\"','victory');\"'$('\"'bossHud').classList.add('hidden');for(const b of [...enemyBullets])removeObject(b,enemyBullets);fuel=Math.max(fuel,45);}\n}\nfunction takeDamage(p,amount=tuning.damage,reason='hit'){\n if(p.invul>0||godMode||attract||autoPilot||amount<=0)return;\n stats.damage+=amount;hull-=amount;p.invul=1.8;combo=1;comboClock=0;shake=.4;flash=.35;audio.explosion();world.makeBurst(p.x,p.z,0xff7048);radio(reason==='bank'?'Easy on the banks\"'! Keep your wingtips inside.'\"':'That scratched the paint. Roll through the next one\"'!'\"','hit');\n if(hull<=0){lives--;deaths++;if(lives<=0){finishRun(false);return;}respawn();}\n}\nfunction respawn(){\n const keptScore=score,keptKills=kills,keptStats={...stats},keptTime=elapsed,keptLives=lives,keptDeaths=deaths,keptRefuels=refuels;\n const checkpointAt=checkpoint;resetRun({coop,at:checkpointAt});score=keptScore;kills=keptKills;stats=keptStats;elapsed=keptTime;lives=keptLives;deaths=keptDeaths;refuels=keptRefuels;fuel=85;banner('Fresh propeller',\"'`${lives} aircraft left · checkpoint restored`);radio('\"'Back in the air. We are not done yet.');\n}\nfunction finishRun(won){\n if(state\"'!=='\"'playing')return;\n if(attract){clearTimer=4;state='attractEnd';banner(won?'Clear water\"'!'\"':'Another run?', 'Autopilot loops shortly',4);return;}\n best=Math.max(best,score);try{localStorage.setItem('upstream-best',String(best));}catch{}\n if(network.active){network.result(score,{Targets:kills,Bridges:bridges,'Fuel passes':refuels});state='hubresult';banner(won?'Mission complete':'Wings down',\"'`Score ${padNumber(score)} · waiting for the other pilots`,360);audio.pause(true);return;}\n network.result(score,{Targets:kills});showMenu('\"'results');audio.voice(won?'victory':'hit');\n}\nfunction inputFor(p){\n let x=0,y=0,fireHeld=false,rollPressed=false,pulsePressed=false;\n const pads=navigator.getGamepads?.()||[];const pad=pads[p.index];\n if(pad?.connected\"'!==false&&pad){x=Math.abs(pad.axes[0]||0)>.13?pad.axes[0]:0;y=Math.abs(pad.axes[1]||0)>.13?pad.axes[1]:0;fireHeld=!!(pad.buttons[7]?.pressed||pad.buttons[0]?.pressed);rollPressed=!!pad.buttons[5]?.pressed;pulsePressed=!!pad.buttons[1]?.pressed;}\n if(p.index===0){x+=(keys.has('\"'KeyD')?1:0)-(keys.has('KeyA')?1:0);y+=(keys.has('KeyS')?1:0)-(keys.has('KeyW')?1:0);if(\"'!coop){x+=(keys.has('\"'ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0);y+=(keys.has('ArrowDown')?1:0)-(keys.has('ArrowUp')?1:0);}fireHeld||=keys.has('Space')||keys.has('KeyJ')||mouseHeld||settings.assist||inputMode==='touch';rollPressed||=keys.has('ShiftLeft')||keys.has('ShiftRight')||rollQueued;pulsePressed||=pulseQueued;\n if(inputMode==='touch'&&touchControl){x=touchControl.x;y=touchControl.y;}\n if(inputMode==='mouse'&&mouseX\"'!==null&&Math.abs(x)<.1)x=clamp((mouseX-p.x)*3,-1,1);\n }else{x+=(keys.has('\"'ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0);y+=(keys.has('ArrowDown')?1:0)-(keys.has('ArrowUp')?1:0);fireHeld||=keys.has('Enter');rollPressed||=keys.has('Slash');pulsePressed||=keys.has('Period');}\n if(attract||autoPilot){\n const upcomingFuel=entities.find(e=>e.type==='fuel'&&e.at-progress>-2&&e.at-progress<45);\n const target=entities.filter(e=>e.active&&e.type\"'!=='\"'fuel'&&e.z<0&&e.z>-50).sort((a,b)=>b.z-a.z)[0];\n const safe=river(progress+6).center;const aim=upcomingFuel&&fuel<92?upcomingFuel.x:target?target.x:safe;\n x=clamp((aim-p.x)*2,-1,1);y=-.1;fireHeld=true;rollPressed=(Math.floor(elapsed*2)%14===0);pulsePressed=pulses>0&&enemyBullets.length>10;\n }\n return{x:clamp(x,-1,1),y:clamp(y,-1,1),fire:fireHeld,roll:rollPressed,pulse:pulsePressed};\n}\nfunction simulate(dt){\n if(state\"'!=='\"'playing')return;stats.simSteps++;elapsed+=dt;comboClock-=dt;if(comboClock<=0)combo=1;\n const inputs=players.map(inputFor);const throttle=inputs[0]?.y||0;let speed=tuning.speed*(1-throttle*.42);\n const boss=entities.find(e=>e.type==='boss');if(boss&&\"'!bossDefeated&&progress>=BOSS_AT-32)speed=0;\n progress=Math.min(FINISH_AT+2,progress+speed*dt);\n fuel-=tuning.fuelDrain*dt*(speed>0?1+Math.max(0,-throttle)*.25:.65);if(godMode||attract||autoPilot)fuel=Math.max(fuel,70);fuel=clamp(fuel,0,100);\n if(fuel<25&&fuel>24.9)radio('\"'Fuel is getting shy. Overfly a green barge.','danger');\n if(fuel<=0){takeDamage(players[0],1,'fuel');fuel=0;}\n for(let i=0;i<players.length;i++){\n const p=players[i],input=inputs[i];p.invul=Math.max(0,p.invul-dt);p.rollCooldown=Math.max(0,p.rollCooldown-dt);p.fireCooldown=Math.max(0,p.fireCooldown-dt);\n p.x+=input.x*tuning.steering*dt;p.z=lerp(p.z,5+input.y*2.2,dt*4);\n const r=river(progress-p.z+5),margin=.75;\n if(inputMode==='touch'||attract||autoPilot){p.x=clamp(p.x,r.center-r.width+margin,r.center+r.width-margin);if(inputMode==='touch'&&enemyBullets.some(b=>Math.hypot(b.x-p.x,b.z-p.z)<2.6))roll(p);}\n if(Math.abs(p.x-r.center)>r.width-.3)takeDamage(p,tuning.damage,'bank');p.x=clamp(p.x,r.center-r.width-1,r.center+r.width+1);\n p.bank=lerp(p.bank,-input.x*.4,dt*7);if(input.roll)roll(p);if(input.pulse&&pulses>0&&\"'!p.pulseLatch)pulse();p.pulseLatch=input.pulse;\n if(input.fire)fire(p);p.roll=Math.max(0,p.roll-dt);p.mesh.rotation.z=p.bank+(p.roll>0?(1-p.roll/.7)*Math.PI*2:0);p.mesh.position.set(p.x,1.7+Math.sin(visualTime*3+i)*.04,p.z);p.mesh.visible=p.invul<=0||Math.floor(elapsed*12)%2===0||p.roll>0;\n p.body?.setNextKinematicTranslation({x:p.x,y:0,z:p.z});p.mixer.update(dt);\n }\n pulseQueued=false;rollQueued=false;\n let shouldRefuel=false;\n for(const e of [...entities]){\n e.z=5-(e.at-progress);if(e.z>20){removeObject(e,entities);continue;}if(!e.active&&e.z>-76)activateEntity(e);if(!e.active)continue;\n e.age+=dt;\n if(e.type==='\"'heli')e.x=river(e.at).center+Math.sin(e.age*.9+e.at)*Math.min(6,river(e.at).width-2);\n if(e.type==='boat')e.x=river(e.at).center+river(e.at).width*e.ratio+Math.sin(e.age*.65+e.at)*.7;\n if(e.type==='boss'){e.x=river(e.at).center+Math.sin(e.age*.6)*3.7;if(e.hp<e.maxHp*.5&&stats.bossPhases===1){stats.bossPhases=2;radio('Its engines are hot. Watch the wide volleys\"'!'\"','danger');banner('Ironwake enraged','Keep rolling. Keep firing.',2);}}\n e.mesh.position.set(e.x,e.type==='heli'?1.7:.25,e.z);if(e.type==='heli')e.mesh.rotation.z=Math.cos(e.age*.9+e.at)*-.1;\n if(e.mesh.userData.rotor)e.mesh.userData.rotor.rotation.y+=dt*28;if(e.mesh.userData.ring)e.mesh.userData.ring.rotation.z+=dt;if(e.mesh.userData.radar)e.mesh.userData.radar.rotation.y+=dt;\n e.body.setNextKinematicTranslation({x:e.x,y:0,z:e.z});\n if(['boat','heli','turret','boss'].includes(e.type)&&e.z>-58&&e.z<4){e.cooldown-=dt*tuning.enemyRate;if(e.cooldown<=0){enemyFire(e);e.cooldown=e.type==='boss'?(e.hp<e.maxHp*.5?.75:1.15):e.type==='turret'?1.9:3.2;}}\n if(e.type==='fuel'&&players.some(p=>Math.abs(p.x-e.x)<1.9&&Math.abs(p.z-e.z)<3.2)){\n shouldRefuel=true;const amount=Math.min(100-fuel,62*dt);fuel+=amount;stats.fuelCollected+=amount;\n if(\"'!e.collected){e.collected=true;refuels++;hull=Math.min(4,hull+1);score+=350;audio.pickup();radio('\"'Topped up. Wings patched. Cause some trouble\"'!'\"','pickup');}\n }\n }\n for(const b of [...bullets,...enemyBullets]){\n b.x+=b.vx*dt;b.z+=b.vz*dt+(b.type==='enemyBullet'?speed*dt:0);b.life-=dt;b.mesh.position.set(b.x,1.4,b.z);b.mesh.rotation.y=b.type==='bullet'?Math.atan2(-b.vx,65):visualTime*3;\n b.body?.setNextKinematicTranslation({x:b.x,y:0,z:b.z});if(b.life<=0||b.z<-85||b.z>23||Math.abs(b.x)>40)removeObject(b,b.type==='bullet'?bullets:enemyBullets);\n }\n physics.timestep=dt;physics.step(eventQueue);\n const contacts=[];eventQueue.drainCollisionEvents((a,b,started)=>{if(started)contacts.push([colliders.get(a),colliders.get(b)]);});\n for(let [a,b] of contacts){if(\"'!a||!b||a.dead||b.dead)continue;stats.collisions++;\n if(b.type==='\"'bullet'||b.type==='player'){[a,b]=[b,a];}\n if(a.type==='bullet'&&b.type\"'!=='\"'player'&&b.type\"'!=='\"'bullet'&&b.type\"'!=='\"'enemyBullet'&&b.type\"'!=='\"'fuel'){\n removeObject(a,bullets);b.hp-=2;if(b.hp<=0)destroyEntity(b);else if(b.type==='bridge'||b.type==='boss')world.makeBurst(a.x,a.z,0xffd467);\n }else if(a.type==='player'&&b.type\"'!=='\"'bullet'&&b.type\"'!=='\"'player'&&b.type\"'!=='\"'fuel'){\n takeDamage(a);if(b.type==='enemyBullet')removeObject(b,enemyBullets);else if(\"'!['\"'bridge','boss'].includes(b.type))destroyEntity(b);\n }\n }\n if(shouldRefuel)\"'$('\"'fuelFill').style.background='#fff0cc';else \"'$('\"'fuelFill').style.background=fuel<25?'#ff7048':'#42d8bc';\n sector=progress<820?0:progress<1640?1:2;if(sector\"'!==shownSector){shownSector=sector;if(sector>0){banner(SECTORS[sector],`Sector 0${sector+1} · ${sector===1?'\"'Keep your wingtips inside':'Last stop: river lockdown'}\"'`);radio(sector===1?'\"'Needle Bend. Small river, big attitude.':'Ironwake territory. Give them a proper hello.');}}\n if(progress>=FINISH_AT&&bossDefeated)finishRun(true);\n}\nfunction updateHud(){\n \"'$('\"'score').textContent=padNumber(score);\"'$('\"'best').textContent='BEST '+padNumber(best);\"'$('\"'sectorLabel').textContent=\"'`Sector 0${sector+1} / 03`;$('\"'sectorName').textContent=SECTORS[sector];\"'$('\"'routeFill').style.width=clamp(progress/FINISH_AT*100,0,100)+'%';\"'$('\"'hull').textContent='◆'.repeat(Math.ceil(Math.max(0,hull)))+'◇'.repeat(Math.max(0,4-Math.ceil(Math.max(0,hull))));\"'$('\"'lives').textContent='×'+lives;\"'$('\"'fuelNumber').textContent=Math.ceil(fuel)+'%';\"'$('\"'fuelFill').style.width=fuel+'%';\"'$('\"'combo').textContent=combo>1?'CHAIN ×'+combo:'';\n const p=players[0];\"'$('\"'rollStatus').textContent=p&&p.rollCooldown>0?p.rollCooldown.toFixed(1)+'s':'READY';\"'$('\"'pulseStatus').textContent=pulses?'● '.repeat(pulses).trim():'EMPTY';\n const boss=entities.find(e=>e.type==='boss'&&e.active);\"'$('\"'bossHud').classList.toggle('hidden',\"'!boss||state!=='\"'playing');if(boss)\"'$('\"'bossFill').style.width=Math.max(0,boss.hp/boss.maxHp*100)+'%';\n if(state==='dev')\"'$('\"'debugLine').textContent=\"'`${diagnostics.renderer} · Rapier ${RAPIER.version()}'\"\\\\nDistance \"'${Math.floor(progress)} / ${FINISH_AT} · ${entities.filter(e=>e.active).length} hostiles · ${stats.collisions} contacts'\"\\\\nSeeded mission · \"'${stats.simSteps} simulation steps · no recorded assets`;\n}\nfunction updateGhosts(dt){\n for(const [id,g] of network.peers){\n let mesh=ghostMeshes.get(id);if(!mesh){mesh=makeGhost(g.color);scene.add(mesh);ghostMeshes.set(id,mesh);}\n const delta=g.progress-progress;mesh.visible=activePlay()&&Math.abs(delta)<65&&g.sector===sector;mesh.position.set(g.x,2.1,5-delta);mesh.rotation.z=g.bank;mesh.userData.mixer.update(dt);\n }\n for(const [id,mesh] of ghostMeshes)if(!network.peers.has(id)){scene.remove(mesh);disposeMesh(mesh);ghostMeshes.delete(id);}\n const visible=network.peers.size>0&&state==='\"'playing';\"'$('\"'ghosts').classList.toggle('hidden',\"'!visible);if(visible)$('\"'ghosts').textContent=[network.active?'LIVE RIVER GHOSTS':'BROWSER-LOCAL GHOSTS',...([...network.peers.values()].map(g=>\"'`${g.name}   ${padNumber(g.score)}   ${Math.abs(g.progress-progress)<65?'\"'IN SIGHT':Math.round((g.progress-progress)/16)+'s'}\"'`))].join('\"'\\\\n');\n}\nfunction pollGamepads(dt){\n menuCooldown=Math.max(0,menuCooldown-dt);const pads=navigator.getGamepads?.()||[];\n for(const pad of pads){if(\"'!pad)continue;const prior=previousPads.get(pad.index)||[];const pressed=pad.buttons.map(b=>b.pressed);const edge=i=>pressed[i]&&!prior[i];const active=pressed.some(Boolean)||pad.axes.some(a=>Math.abs(a)>.25);\n if(active){if(activity('\"'pad')){previousPads.set(pad.index,pressed);return;}}\n if(edge(9)&&\"'!pressed[8]){if(state==='\"'playing')pause();else if(state==='paused')resume();}\n else if(\"'!['\"'playing','hubwait','hubresult','hubended','attractEnd'].includes(state)){\n const down=edge(13)||(pad.axes[1]>.55&&menuCooldown<=0),up=edge(12)||(pad.axes[1]<-.55&&menuCooldown<=0);\n if(down||up){focusMenu(menuFocus+(down?1:-1));menuCooldown=.2;}\n if(edge(0))document.activeElement?.click();\n if(edge(1)&&state\"'!=='\"'title')handleAction('back');\n const dir=edge(15)?1:edge(14)?-1:Math.abs(pad.axes[0])>.6&&menuCooldown<=0?Math.sign(pad.axes[0]):0;\n if(dir){adjustFocused(dir);menuCooldown=.15;}\n }\n previousPads.set(pad.index,pressed);\n }\n}\nfunction adjustFocused(dir){const e=document.activeElement;if(e?.type==='range'){e.value=clamp(+e.value+dir*(+e.step||1),+e.min,+e.max);e.dispatchEvent(new Event('input',{bubbles:true}));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+dir+e.options.length)%e.options.length;e.dispatchEvent(new Event('input',{bubbles:true}));}}\nfunction hideTouchStick(){touchControl=null;\"'$('\"'touchRing').style.display='none';\"'$('\"'touchDot').style.display='none';}\nconst raycaster=new THREE.Raycaster(),aimPlane=new THREE.Plane(new THREE.Vector3(0,1,0),-1.7),aimPoint=new THREE.Vector3();\nfunction bindInput(){\n document.addEventListener('keydown',e=>{\n if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code)&&\"'!['\"'INPUT','SELECT'].includes(e.target.tagName))e.preventDefault();\n if(activity('keyboard')){e.preventDefault();return;}audio.unlock();\n if(e.code==='Escape'){if(state==='playing')pause();else if(state==='paused')resume();else if(\"'!network.active&&state!=='\"'title')handleAction('back');return;}\n if(state==='playing'){keys.add(e.code);if(e.code==='KeyQ')pulseQueued=true;return;}\n if(e.target.tagName==='INPUT'&&e.target.type==='text')return;\n if(e.code==='ArrowDown'||e.code==='ArrowUp'){focusMenu(menuFocus+(e.code==='ArrowDown'?1:-1));e.preventDefault();}\n if(e.code==='ArrowLeft'||e.code==='ArrowRight')adjustFocused(e.code==='ArrowRight'?1:-1);\n if(e.code==='Enter'&&\"'!e.repeat&&e.target.tagName!=='\"'BUTTON')document.activeElement?.click();\n });\n document.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();mouseHeld=false;if(\"'!network.active&&state==='\"'playing'&&\"'!attract)pause();});\n document.addEventListener('\"'pointerdown',e=>{if(activity(e.pointerType==='touch'?'touch':'mouse')){e.stopImmediatePropagation();e.preventDefault();return;}audio.unlock();},true);\n \"'$('\"'game').addEventListener('pointerdown',e=>{if(state\"'!=='\"'playing')return;audio.unlock();if(e.pointerType==='touch'){touchControl={id:e.pointerId,startX:e.clientX,startY:e.clientY,x:0,y:0};\"'$('\"'touchRing').style.cssText=\"'`display:block;left:${e.clientX}px;top:${e.clientY}px`;$('\"'touchDot').style.cssText=\"'`display:block;left:${e.clientX}px;top:${e.clientY}px`;}else mouseHeld=true;$('\"'game').setPointerCapture(e.pointerId);});\n document.addEventListener('pointermove',e=>{\n if(e.pointerType==='touch'){if(touchControl?.id===e.pointerId){touchControl.x=clamp((e.clientX-touchControl.startX)/65,-1,1);touchControl.y=clamp((e.clientY-touchControl.startY)/65,-1,1);\"'$('\"'touchDot').style.left=touchControl.startX+touchControl.x*42+'px';\"'$('\"'touchDot').style.top=touchControl.startY+touchControl.y*42+'px';}return;}\n if(Math.abs(e.movementX)+Math.abs(e.movementY)>0)activity('mouse');if(\"'!camera)return;\n raycaster.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1),camera);if(raycaster.ray.intersectPlane(aimPlane,aimPoint))mouseX=aimPoint.x;\n });\n document.addEventListener('\"'pointerup',e=>{mouseHeld=false;if(touchControl?.id===e.pointerId)hideTouchStick();});document.addEventListener('pointercancel',()=>{mouseHeld=false;hideTouchStick();});\n \"'$('\"'pauseButton').addEventListener('click',pause);\"'$('\"'touchMenu').addEventListener('click',()=>{if(state==='playing')pause();else if(state==='paused')resume();else if(state\"'!=='\"'title')handleAction('back');});\n \"'$('\"'touchPulse').addEventListener('pointerdown',e=>{e.stopPropagation();pulseQueued=true;});window.addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(document.hidden&&\"'!network.active&&state==='\"'playing'&&\"'!attract)pause();});\n window.addEventListener('\"'gamepadconnected',()=>setInputMode('pad'));\n if(matchMedia('(pointer:coarse)').matches)setInputMode('touch');\n}\nfunction resize(){\n if(\"'!renderer||!camera)return;renderer.setSize(innerWidth,innerHeight,false);\n const aspect=innerWidth/innerHeight,halfWidth=aspect<1?18:Math.max(24,aspect*18),halfHeight=halfWidth/aspect;\n camera.left=-halfWidth;camera.right=halfWidth;camera.top=halfHeight;camera.bottom=-halfHeight;camera.updateProjectionMatrix();\n}\nfunction renderFrame(now){\n const raw=lastFrame?Math.min((now-lastFrame)/1000,.1):0;lastFrame=now;visualTime+=raw;pollGamepads(raw);\n if(state==='\"'hubwait'&&hubStarted&&globalThis.AIHub.time()>=0){resetRun({});}\n if(state==='title'&&now-lastInput>=10000&&\"'!network.active)resetRun({attract:true});\n if(state==='\"'attractEnd'){clearTimer-=raw;if(clearTimer<=0)resetRun({attract:true});}\n if(state==='playing'){\n accumulator+=raw*tuning.timeScale;let steps=0;while(accumulator>=1/60&&steps<20&&state==='playing'){simulate(1/60);accumulator-=1/60;steps++;}\n }else accumulator=0;\n if(state==='title'||['settings','about','instructions','room'].includes(state)&&previousMenu==='title'){titleProgress+=raw*5;world.render(titleProgress,visualTime);}else world.render(progress,visualTime);\n world.updateEffects(raw);updateGhosts(raw);bannerClock-=raw;if(bannerClock<=0)\"'$('\"'banner').classList.add('hidden');radioClock-=raw;\n shake=Math.max(0,shake-raw);flash=Math.max(0,flash-raw*1.5);\"'$('\"'flash').style.opacity=flash*.35;\n const riverCenter=river(state==='title'?titleProgress:progress+18).center;\n const menuScene=state==='title'||(['settings','instructions','about','room'].includes(state)&&previousMenu==='title');\n const targetX=menuScene?-10:riverCenter*.4;\n camera.position.set(targetX+(settings.shake?Math.sin(visualTime*89)*shake*.4:0),48,29);camera.lookAt(targetX,0,-16);\n audio.update(raw,{playing:state==='playing'&&\"'!attract,speed:1-(inputForSafe()?.y||0)*.42,danger:fuel<25||!!entities.find(e=>e.type==='\"'boss'&&e.active),sector});\n if(state==='playing'||state==='hubresult'){\n const p=players[0];if(p)network.update(raw,{x:p.x,y:p.z,progress,bank:p.bank,fire:p.fireCooldown>0,sector},score,\"'`${SECTORS[sector]} · ${Math.floor(progress/FINISH_AT*100)}%`);\n }\n reportClock+=raw;if(reportClock>.08){updateHud();reportClock=0;}\n renderer.render(scene,camera);\n}\nfunction inputForSafe(){return players[0]?{y:keys.has('\"'KeyW')?-1:keys.has('KeyS')?1:0}:null;}\nasync function boot(){\n try{\n await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});eventQueue=new RAPIER.EventQueue(true);\n renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'game'),antialias:true,alpha:false,powerPreference:'high-performance'});\n renderer.setPixelRatio(Math.min(devicePixelRatio,network.active?1:1.7));await renderer.init();\n diagnostics.renderer=renderer.backend?.isWebGPUBackend?'WebGPU':'WebGL fallback';\n scene=new THREE.Scene();scene.background=new THREE.Color(0x78a571);scene.fog=new THREE.Fog(0x9fb982,90,180);\n scene.add(new THREE.HemisphereLight(0xfff3cf,0x3f6975,2.4));const sun=new THREE.DirectionalLight(0xffe8b3,3.2);sun.position.set(-25,60,20);scene.add(sun);\n camera=new THREE.OrthographicCamera(-30,30,20,-20,.1,250);camera.position.set(0,48,29);camera.lookAt(0,0,-16);world=new WorldView(scene);resize();world.render(titleProgress,0);\n bindInput();\n await network.init({onStart:()=>{hubStarted=true;},onTimeUp:()=>{network.result(score,{Targets:kills,Bridges:bridges,'Fuel passes':refuels});state='hubresult';audio.pause(true);},onEnd:()=>{hubEnded=true;state='hubended';keys.clear();mouseHeld=false;audio.stop();\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.add('hidden');\"'$('\"'bossHud').classList.add('hidden');\"'$('\"'banner').classList.add('hidden');}});\n \"'$('\"'loading').classList.add('hidden');diagnostics.ready=true;diagnostics.bootMs=performance.now()-bootAt;\n if(network.active){state='hubwait';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.add('hidden');network.ready();}else showMenu('title');\n renderer.setAnimationLoop(renderFrame);\n }catch(error){diagnostics.errors.push(String(error.stack||error));\"'$('\"'loadingMessage').textContent='Flight could not start: '+error.message+' · Use a browser with WebGPU, and allow the CDN dependencies.';document.querySelector('.spinner')?.remove();globalThis.AIHub?.active&&globalThis.AIHub.fail(error.message);console.error(error);}\n}\n// Read-only diagnostics are always available; mutation helpers require ?test=1.\nwindow.__UPROAR__={get state(){return state;},get diagnostics(){return {...diagnostics,physics:RAPIER.version?.(),network:network.diagnostics(),audio:audio.diagnostics()};},snapshot(){return {state,attract,coop,progress,score,fuel,hull,lives,pulses,combo,kills,bridges,refuels,elapsed,checkpoint,bossDefeated,sector,rolls,shots,deaths,stats:{...stats},players:players.map(p=>({x:p.x,z:p.z,invul:p.invul,roll:p.roll,rollCooldown:p.rollCooldown})),entities:entities.filter(e=>e.active).map(e=>({id:e.id,type:e.type,x:e.x,z:e.z,hp:e.hp,at:e.at})),bullets:bullets.length,enemyBullets:enemyBullets.length,tuning:{...tuning},settings:{...settings}};}};\nif(new URLSearchParams(location.search).get('test')==='1')Object.assign(window.__UPROAR__,{start:options=>resetRun(options),step:(seconds)=>{for(let i=0;i<Math.ceil(seconds*60)&&state==='playing';i++)simulate(1/60);updateHud();return window.__UPROAR__.snapshot();},autopilot:v=>{autoPilot=v;},god:v=>{godMode=v;},setFuel:v=>{fuel=clamp(v,0,100);},setHull:v=>{hull=v;},setLives:v=>{lives=v;},setPlayer:(x,z=5)=>{players[0].x=x;players[0].z=z;players[0].invul=0;},hurt:()=>takeDamage(players[0]),fire:()=>fire(players[0]),roll:()=>roll(players[0]),pulse,warp:at=>resetRun({at}),setTuning:(k,v)=>{if(k in tuning)tuning[k]=v;},setAttractIdle:()=>{lastInput=performance.now()-10001;},radio,river,finish:()=>{bossDefeated=true;progress=FINISH_AT;finishRun(true);},network, audio});\nwindow.addEventListener('error',e=>diagnostics.errors.push(e.message));window.addEventListener('unhandledrejection',e=>diagnostics.errors.push(String(e.reason)));\nboot();\nEOF\ncat > build.py <<'EOF'\nfrom pathlib import Path\nimport json,re\nroot=Path(__file__).resolve().parent\ncredits=json.loads((root.parent/'exit-interview.json').read_text())\n(root/'credits.js').write_text('export const CREDITS = '+json.dumps(credits,ensure_ascii=False)+';\\\\n')\ncode=[]\nfor name in ['world.js','audio.js','network.js','credits.js','main.js']:\n    source=(root/name).read_text()\n    if name\"'!='\"'main.js':\n        source=re.sub(r'\"'^import .*?;'\"\\\\n','',source,flags=re.M)\n    else:\n        source=re.sub(r\\\"\"'^import .*? from '\"'\\\\./.*?';\\\\n\\\",'',source,flags=re.M)\n    source=re.sub(r'\"'^export '\"','',source,flags=re.M)\n    code.append(source)\nhtml=(root/'shell.html').read_text().replace('<\"'!-- HUB_CLIENT -->'\"','<script>\\\\n'+(root/'hub-session.js').read_text()+'\\\\n</script>').replace('// GAME_CODE','\\\\n'.join(code))\npath=root.parent/(root.name+'.html');path.write_text(html)\nprint(path.name+' · '+str(path.stat().st_size)+' bytes')\nEOF\ncat > README.md <<'EOF'\n# Upstream Uproar\n\nA complete three-sector arcade river-flight mission inspired by River Raid (1982).\n\nOpen the HTML in the parent folder with a modern WebGPU browser. An Internet connection loads Three.js r180, Rapier 0.19.3, and the optional Google font. No server or build step is needed to play the shared HTML. Local two-player co-op supports two controllers or shared keyboard. Online ghost competition is provided by AI Hub sessions; standalone browser-local rooms use BroadcastChannel between same-origin tabs on one device.\n\nControls: WASD / arrows steer and change throttle, Space fire, Shift roll, Q pulse, Esc pause. Mouse moves the plane and left click fires. Controller: left stick, RT or Cross/A fire, R1/RB roll, Circle/B pulse, Options/Menu pause. Touch: drag anywhere; assisted cannon and emergency rolls, tap Pulse when needed.\n\n## Build\n\n\"'`python3 build.py` embeds the game modules, credits, and unmodified Hub client in one HTML. External runtime libraries remain pinned CDN dependencies.\n\n## Tests\n\n`./test.sh` builds the current game, starts its own loopback server on an OS-selected port, runs state-driven browser checks plus the official AI Hub harness and a full scripted mission, closes its browser and stops its own server. It prints only failures and a one-line count.\n\nDeveloper tools are in the pause menu. Live balancing, invulnerability, autopilot, resupply, hostile clear, and sector jumps are implemented. Query `?test=1` exposes additional script-only mutation helpers; read-only game state and diagnostics are always available at `window.__UPROAR__`.\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'rapier';\nimport { WorldView, river, makePlane, makeGhost, makeEntity } from './world.js';\nimport { AudioSystem } from './audio.js';\nimport { NetworkSession } from './network.js';\nimport { CREDITS } from './credits.js';\n\nconst \"'$ = id => document.getElementById(id);\nconst clamp = (v,a,b) => Math.max(a,Math.min(b,v));\nconst lerp = (a,b,t) => a+(b-a)*t;\nconst padNumber = n => Math.floor(n).toString().padStart(6,'\"'0');\nconst escapeHTML = s => String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst DEFAULTS = Object.freeze({speed:16,steering:13,fireRate:7,fuelDrain:.92,enemyRate:1,damage:1,timeScale:1});\nconst tuning = {...DEFAULTS};\nconst settings = {music:.1,sfx:.7,glyphs:'playstation',shake:true,assist:false};\ntry {Object.assign(settings,JSON.parse(localStorage.getItem('upstream-settings')||'{}'));}catch{}\nsettings.music=clamp(Number(settings.music)||0,0,1);settings.sfx=clamp(Number(settings.sfx)||0,0,1);\nlet best=0;try{best=+localStorage.getItem('upstream-best')||0;}catch{}\nconst audio = new AudioSystem();audio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst network = new NetworkSession();\nconst keys = new Set(), previousPads=new Map(), ghostMeshes=new Map();\nlet renderer,scene,camera,world,physics,eventQueue;\nlet state='loading',previousMenu='title',lastInput=performance.now(),lastFrame=0,accumulator=0,visualTime=0,titleProgress=250;\nlet players=[],entities=[],bullets=[],enemyBullets=[],colliders=new Map(),nextId=1;\nlet progress=0,score=0,fuel=100,hull=4,lives=3,pulses=3,combo=1,comboClock=0,kills=0,bridges=0,refuels=0,elapsed=0,checkpoint=0;\nlet bossDefeated=false,attract=false,coop=false,godMode=false,autoPilot=false,shake=0,flash=0,sector=0,shownSector=-1,reportClock=0;\nlet bannerClock=0,radioClock=0,lastRadio='',rolls=0,shots=0,deaths=0,clearTimer=0,hubStarted=false,hubEnded=false;\nlet inputMode='keyboard',mouseX=null,mouseHeld=false,touchControl=null,pulseQueued=false,rollQueued=false,menuFocus=0,menuCooldown=0;\nlet stats={collisions:0,damage:0,fuelCollected:0,bridgeKills:0,bossPhases:0,simSteps:0};\nconst diagnostics={ready:false,renderer:'unknown',errors:[],bootMs:0};\nconst bootAt=performance.now();\nconst SECTORS=['Sandbar Shuffle','Needle Bend','Ironwake Lock'];\nconst BOSS_AT=2420,FINISH_AT=2650;\nconst activePlay=()=>state==='playing';\nconst gameplayScreen=()=>['playing','paused','dev'].includes(state);\nconst hasPad=()=>inputMode==='pad';\nconst glyph=(action)=>{\n  if(\"'!hasPad()) return ({fire:'\"'SPACE',roll:'SHIFT',pulse:'Q',pause:'ESC',accept:'ENTER',back:'ESC',move:'WASD'})[action];\n  const ps=settings.glyphs\"'!=='\"'xbox';return ({fire:'RT',roll:ps?'R1':'RB',pulse:ps?'○':'B',pause:ps?'OPTIONS':'MENU',accept:ps?'✕':'A',back:ps?'○':'B',move:'L STICK'})[action];\n};\nfunction saveSettings(){try{localStorage.setItem('upstream-settings',JSON.stringify(settings));}catch{}}\nfunction setInputMode(mode){if(inputMode===mode)return;inputMode=mode;document.body.dataset.touch=String(mode==='touch');updatePrompts();}\nfunction updatePrompts(){\n \"'$('\"'rollPrompt').textContent=\"'`${glyph('\"'roll')} · ROLL\"'`;$('\"'pulsePrompt').textContent=\"'`${glyph('\"'pulse')} · PULSE\"'`;\n $('\"'pauseButton').textContent=\"'`${glyph('\"'pause')} Ⅱ\"'`;\n $('\"'corner').textContent=inputMode==='touch'?'Drag anywhere · Auto fire · Tap PULSE to clear danger':\"'`${glyph('\"'move')} · STEER     \"'${glyph('\"'fire')} · FIRE     \"'${glyph('\"'roll')} · ROLL     \"'${glyph('\"'pulse')} · PULSE\"'`;\n document.querySelectorAll('\"'[data-glyph]').forEach(e=>e.textContent=glyph(e.dataset.glyph));\n}\nfunction activity(mode){lastInput=performance.now();if(mode)setInputMode(mode);if(attract){goTitle();return true;}return false;}\nfunction menuControls(){return [...\"'$('\"'menu').querySelectorAll('button:not(:disabled),input,select')];}\nfunction focusMenu(index){const a=menuControls();if(\"'!a.length)return;menuFocus=(index+a.length)%a.length;a[menuFocus].focus({preventScroll:true});a[menuFocus].scrollIntoView({block:'\"'nearest'});}\nfunction action(text,id,small='',primary=false){return \"'`<button class=\"action${primary?'\"' primary':''}\\\" data-action=\\\"\"'${id}\"><span>${text}</span>${small?`<small>${small}</small>`:'\"'<span class=\\\"arrow\\\">↗</span>'}</button>\"'`;}\nfunction backRow(extra='\"''){return \"'`<div class=\"back-row\">${action('\"'Back','back',glyph('back'))}\"'${extra}</div>`;}\nfunction panel(eyebrow,title,body,cls='\"''){return \"'`<section class=\"panel ${cls}\"><div class=\"eyebrow\">${eyebrow}</div><h2>${title}</h2>${body}</section>`;}\nfunction showMenu(which){\n if(network.active&&['\"'title','results','room'].includes(which))return;\n state=which;\"'$('\"'menu').classList.remove('hidden');\"'$('\"'hud').classList.toggle('hidden',which==='title'||which==='instructions'||which==='about'||which==='room'||which==='settings'&&previousMenu==='title');\n \"'$('\"'bossHud').classList.add('hidden');\"'$('\"'banner').classList.add('hidden');\"'$('\"'attractTag').classList.add('hidden');document.body.classList.remove('in-flight');\n let content='';\n if(which==='title') content=\"'`<section class=\"panel title-panel\"><div class=\"eyebrow\">The river is calling. Collect.</div><h1>Upstream<br><span>Uproar</span></h1><div class=\"tagline\">Low flight. High mischief.</div><div class=\"menu-list\">${action('\"'Fly the river','solo','1 pilot',true)}\"'${action('\"'Bring a wingmate','coop','2 pilots · local')}\"'${action('\"'Ghost challenge','room','AI Hub + browser rooms')}<div class=\\\"two-col\\\">\"'${action('\"'Flight manual','instructions')}\"'${action('\"'Settings','settings')}\"'${action('\"'About / credits','about')}\"'${action('\"'Fullscreen','fullscreen')}</div></div><p class=\\\"footer-note\\\">A river, a propeller, and absolutely no clearance.<br>Three sectors. Two bridges. One very stubborn boat.</p></section><div class=\\\"stamp\\\">RIVER PATROL / NO. 82</div>\"'`;\n if(which==='\"'paused')content=panel('Propeller on hold','Take a breather',\"'`<div class=\"menu-list\">${action('\"'Back to the river','resume',glyph('accept'),true)}\"'${action('\"'Settings','settings')}\"'${action('\"'Flight manual','instructions')}\"'${action('\"'Developer tools','dev')}\"'${action('\"'About / credits','about')}\"'${!network.active?action('\"'Restart mission','restart')+action('Return to title','title'):''}</div><p class=\\\"footer-note\\\">\"'${network.active?'\"'Hub round clock continues while your flight is paused.':'Your fuel is safe. The river can wait.'}</p>\"'`);\n if(which==='\"'settings')content=panel('Make yourself comfortable','Settings',\"'`<div class=\"row\"><label for=\"music\">Music</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"${settings.music*100}\"><output>${Math.round(settings.music*100)}%</output></div><div class=\"row\"><label for=\"sfx\">Effects &amp; radio</label><input id=\"sfx\" data-setting=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"${settings.sfx*100}\"><output>${Math.round(settings.sfx*100)}%</output></div><div class=\"row\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"playstation\" ${settings.glyphs==='\"'playstation'?'selected':''}>PlayStation</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"row\\\"><label for=\\\"shakeSetting\\\">Camera shake</label><input id=\\\"shakeSetting\\\" data-setting=\\\"shake\\\" type=\\\"checkbox\\\" \"'${settings.shake?'\"'checked':''}></div><div class=\\\"row\\\"><label for=\\\"assistSetting\\\">Auto cannon / aim assist</label><input id=\\\"assistSetting\\\" data-setting=\\\"assist\\\" type=\\\"checkbox\\\" \"'${settings.assist?'\"'checked':''}></div><p class=\\\"blurb\\\">Music starts at 10%. Touch flight always uses auto fire, light aim assist, and safe-bank steering.</p>\"'${backRow(action('\"'Reset settings','resetSettings'))}\"'`);\n if(which==='\"'instructions')content=panel('A small aircraft. A big attitude.','Flight manual',\"'`<div class=\"info-grid\"><div class=\"info-card\"><b>01 / Follow the current</b>${glyph('\"'move')} steers. Up accelerates; down brakes. Stay between the inked banks.</div><div class=\\\"info-card\\\"><b>02 / Make some room</b>Hold \"'${glyph('\"'fire')} to fire. \"'${glyph('\"'roll')} rolls through danger; \"'${glyph('\"'pulse')} clears bullets and hits nearby enemies.</div><div class=\\\"info-card\\\"><b>03 / Keep it topped up</b>Fly directly over green fuel barges. A full pass refills fuel and repairs one hull point. Brake to stay over them longer.</div><div class=\\\"info-card\\\"><b>04 / Break the blockade</b>Destroy both bridges for checkpoints. Sink the Ironwake, then fly clear. Kills build a score chain.</div></div><p class=\\\"blurb\\\">Mouse: move over the river to steer, hold left click to fire. Touch: drag anywhere to steer; cannon and emergency rolls are assisted. Tap the pulse button when danger closes in.</p><p class=\\\"blurb\\\">Local co-op: pilot 1 uses WASD / Space / Shift / Q; pilot 2 uses arrows / Enter / Slash / Period. Two standard controllers also work. Hull, fuel, and score are shared.</p>\"'${backRow()}`);\n if(which==='\"'room')content=panel('Leave a purple wake','Ghost challenge',\"'`<div class=\"local-note\"><b>Online with AI Hub</b><br>Launch this game in an AI Hub session for 1–4 networked pilots. Race your own mission with live, non-colliding ghosts and a shared score board.</div><div class=\"local-note\"><b>Browser-local rooms</b><br>Open the game in another tab in this browser, enter the same room code, and fly. These rooms connect tabs on this device; they do not connect separate devices.</div><div class=\"row\"><label for=\"roomCode\">Room code</label><input id=\"roomCode\" maxlength=\"16\" type=\"text\" value=\"${escapeHTML(network.room||'\"'RIVER82')}\\\" autocomplete=\\\"off\\\"></div><p class=\\\"blurb\\\" id=\\\"roomStatus\\\">\"'${network.room?`Room ${escapeHTML(network.room)} · ${network.peers.size} other pilot(s)`:'\"'Your ghost appears when the other pilot is in the same stretch of river.'}</p><div class=\\\"menu-list\\\">\"'${action('\"'Join room & fly','joinRoom','browser-local',true)}\"'${network.room?action('\"'Leave room','leaveRoom'):''}</div>\"'${backRow()}`);\n if(which==='\"'dev'){\n const sliders=[['speed','Cruise speed',6,32,.5],['steering','Steering speed',5,25,.5],['fireRate','Cannon / second',2,16,.5],['fuelDrain','Fuel / second',0,3,.05],['enemyRate','Enemy fire rate',0,3,.1],['damage','Collision damage',0,4,.25],['timeScale','Time scale',.25,3,.25]];\n content=panel('Live mission tuning','Developer tools',\"'`<div class=\"scroll-body\">${sliders.map(([k,label,min,max,step])=>`<div class=\"row\"><label for=\"tune-${k}\">${label}</label><input type=\"range\" id=\"tune-${k}\" data-tuning=\"${k}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[k]}\"><output>${tuning[k]}</output></div>`).join('\"'')}<div class=\\\"row\\\"><label for=\\\"invul\\\">Invulnerable / infinite fuel</label><input id=\\\"invul\\\" type=\\\"checkbox\\\" data-dev=\\\"god\\\" \"'${godMode?'\"'checked':''}></div><div class=\\\"row\\\"><label for=\\\"auto\\\">Autopilot</label><input id=\\\"auto\\\" type=\\\"checkbox\\\" data-dev=\\\"auto\\\" \"'${autoPilot?'\"'checked':''}></div><div class=\\\"back-row\\\">\"'${action('\"'Repair & resupply','resupply')}\"'${action('\"'Clear hostiles','clearHostiles')}</div><div class=\\\"back-row\\\">\"'${action('\"'Sector 1','warp0')}\"'${action('\"'Sector 2','warp1')}\"'${action('\"'Boss encounter','warp2')}</div><div id=\\\"debugLine\\\"></div></div>\"'${backRow(action('\"'Reset defaults','resetTuning'))}\"'`);\n }\n if(which==='\"'about'){\n const s=CREDITS.sourceInformation;\n content=panel('Made for the long way upstream','About / credits',\"'`<div class=\"scroll-body\"><p><b>Upstream Uproar</b> is an original arcade river-flight game inspired by the fuel pressure, river banks, and bridge busting of River Raid (1982). Original procedural art, writing, music, and sound.</p><h3>Source Information</h3>${Object.entries(s).map(([k,v])=>`<div class=\"credit-row\"><b>${escapeHTML(k)}:</b> ${escapeHTML(v)}</div>`).join('\"'')}\"'${['\"'testingFeedback','engineFeedback','promptFeedback'].map((key,i)=>\"'`<h3>${['\"'Testing Feedback','Engine Feedback','Prompt Feedback'][i]}</h3>\"'${CREDITS[key].map(t=>`<p class=\"feedback-item\">${escapeHTML(t)}</p>`).join('\"'')}\"'`).join('\"'')}<h3>Built with</h3><p>Three.js by the Three.js contributors · Rapier by Dimforge · Barlow typeface by Jeremy Tribby, with local system fallbacks · AI Hub Session Protocol v1 / client 1.4.0. No recorded audio or raster art assets.</p></div>\"'${backRow()}`);\n }\n if(which==='\"'results'){\n const won=bossDefeated&&progress>=FINISH_AT;\n const rank=won?(score>18000?'S':score>12000?'A':'B'):'—';\n content=panel(won?'The current is free again':'The river keeps its secrets',won?'Clear water ahead\"'!'\"':'Wings down.',\"'`<p class=\"blurb\">${won?'\"'Finch: “That boat had it coming. Same time tomorrow?”':'Finch: “We saved you a seat. And another propeller.”'}</p><div class=\\\"metrics\\\"><div class=\\\"metric\\\"><b>\"'${padNumber(score)}</b><small>Score</small></div><div class=\"metric\"><b>${rank}</b><small>Flight rank</small></div><div class=\"metric\"><b>${Math.floor(elapsed/60)}:${Math.floor(elapsed%60).toString().padStart(2,'\"'0')}</b><small>Flight time</small></div></div><p class=\\\"blurb\\\">\"'${kills} targets · ${bridges} bridges · ${refuels} fuel passes · ${rolls} rolls<br>Best score ${padNumber(best)}</p><div class=\"menu-list\">${action('\"'One more run','restart',glyph('accept'),true)}\"'${action('\"'Return to title','title')}</div>\"'`);\n }\n $('\"'menu').innerHTML=content;\n \"'$('\"'menu').querySelectorAll('[data-action]').forEach(el=>{el.addEventListener('click',()=>handleAction(el.dataset.action));el.addEventListener('pointerenter',()=>{el.focus({preventScroll:true});menuFocus=menuControls().indexOf(el);});});\n \"'$('\"'menu').querySelectorAll('[data-setting]').forEach(el=>el.addEventListener('input',()=>{const k=el.dataset.setting;settings[k]=el.type==='checkbox'?el.checked:el.type==='range'?+el.value/100:el.value;if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=Math.round(settings[k]*100)+'%';audio.setMusic(settings.music);audio.setSfx(settings.sfx);saveSettings();updatePrompts();}));\n \"'$('\"'menu').querySelectorAll('[data-tuning]').forEach(el=>el.addEventListener('input',()=>{tuning[el.dataset.tuning]=+el.value;el.nextElementSibling.textContent=el.value;}));\n \"'$('\"'menu').querySelectorAll('[data-dev]').forEach(el=>el.addEventListener('input',()=>{if(el.dataset.dev==='god')godMode=el.checked;else autoPilot=el.checked;}));\n updatePrompts();focusMenu(0);audio.pause(true);updateHud();\n}\nfunction handleAction(id){\n audio.unlock();lastInput=performance.now();\n if(id==='solo'||id==='coop'){resetRun({coop:id==='coop'});return;}\n if(id==='resume'){resume();return;}if(id==='restart'){resetRun({coop});return;}\n if(id==='title'){goTitle();return;}if(id==='fullscreen'){if(document.fullscreenElement)document.exitFullscreen?.();else document.documentElement.requestFullscreen?.().catch(()=>{});return;}\n if(id==='back'){showMenu(previousMenu==='paused'?'paused':'title');return;}\n if(['settings','instructions','about','dev','room'].includes(id)){if(state==='title'||state==='paused')previousMenu=state;showMenu(id);return;}\n if(id==='joinRoom'){const code=\"'$('\"'roomCode').value;if(network.joinRoom(code)){resetRun({});radio(\"'`Ghost room ${network.room}. Keep an eye out for purple wings.`);}else $('\"'roomStatus').textContent='This browser does not support local rooms.';return;}\n if(id==='leaveRoom'){network.leaveRoom();showMenu('room');return;}\n if(id==='resetSettings'){Object.assign(settings,{music:.1,sfx:.7,glyphs:'playstation',shake:true,assist:false});saveSettings();audio.setMusic(.1);audio.setSfx(.7);showMenu('settings');return;}\n if(id==='resetTuning'){Object.assign(tuning,DEFAULTS);godMode=false;autoPilot=false;showMenu('dev');return;}\n if(id==='resupply'){hull=4;fuel=100;pulses=3;lives=3;banner('Fresh wings','Fully repaired & refueled');updateHud();return;}\n if(id==='clearHostiles'){for(const e of [...entities])if(e.type\"'!=='\"'fuel')destroyEntity(e,true);for(const b of [...enemyBullets])removeObject(b,enemyBullets);updateHud();return;}\n if(id.startsWith('warp')){const target=[0,850,2350][+id.slice(-1)];const wasCoop=coop;resetRun({coop:wasCoop,at:target});godMode=true;state='paused';previousMenu='paused';showMenu('dev');return;}\n}\nfunction pause(){if(state\"'!=='\"'playing'||attract||hubEnded)return;keys.clear();mouseHeld=false;touchControl=null;previousMenu='paused';showMenu('paused');}\nfunction resume(){if(hubEnded)return;state='playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');document.body.classList.add('in-flight');audio.pause(false);keys.clear();lastInput=performance.now();}\nfunction goTitle(){if(network.active)return;attract=false;autoPilot=false;clearObjects();players.forEach(p=>scene.remove(p.mesh));players=[];state='title';titleProgress=progress||250;lastInput=performance.now();showMenu('title');\"'$('\"'ghosts').classList.add('hidden');hideTouchStick();}\nfunction banner(title,subtitle,duration=3){\"'$('\"'banner').querySelector('strong').textContent=title;\"'$('\"'banner').querySelector('small').textContent=subtitle;bannerClock=duration;\"'$('\"'banner').classList.remove('hidden');}\nfunction radio(text,voice='radio'){if(text===lastRadio&&radioClock>0)return;lastRadio=text;radioClock=6;\"'$('\"'radioText').textContent=text;audio.voice(voice);}\nfunction createPhysicsObject(obj,half){\n const desc=RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(obj.x,0,obj.z);\n obj.body=physics.createRigidBody(desc);\n const c=RAPIER.ColliderDesc.cuboid(...half).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS).setActiveCollisionTypes(RAPIER.ActiveCollisionTypes.ALL);\n obj.collider=physics.createCollider(c,obj.body);colliders.set(obj.collider.handle,obj);\n}\nfunction disposeMesh(group){group.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.isMesh&&o.material?.transparent&&o.material.opacity===.6)o.material.dispose();});}\nfunction removeObject(obj,list){if(obj.dead)return;obj.dead=true;if(obj.body){colliders.delete(obj.collider.handle);physics.removeRigidBody(obj.body);obj.body=null;}if(obj.mesh){scene.remove(obj.mesh);disposeMesh(obj.mesh);}if(list){const i=list.indexOf(obj);if(i>=0)list.splice(i,1);}}\nfunction clearObjects(){for(const list of [entities,bullets,enemyBullets])for(const e of [...list])removeObject(e,list);for(const p of players)if(p.body){colliders.delete(p.collider.handle);physics.removeRigidBody(p.body);p.body=null;}colliders.clear();}\nfunction spawnPlayer(index){\n const made=makePlane(index?0x63d9c0:0xff7048);const x=river(progress).center+(coop?(index?2.7:-2.7):0);\n const p={id:nextId++,type:'player',index,mesh:made.group,mixer:made.mixer,x,z:coop?6:5,roll:0,rollCooldown:0,fireCooldown:0,invul:3,bank:0,dead:false};\n p.mesh.position.set(x,1.7,p.z);scene.add(p.mesh);createPhysicsObject(p,[.65,1,.9]);players.push(p);return p;\n}\nfunction buildMission(){\n const specs=[];\n for(let at=90,i=0;at<2330;at+=27+(i%4)*6,i++){\n const type=i%7===3?'turret':i%4===1?'heli':'boat';specs.push({type,at,ratio:Math.sin(i*2.4)*.68});\n if(i>10&&i%4===0)specs.push({type:'boat',at:at+10,ratio:-Math.sin(i*2.4)*.65});\n }\n for(let i=0,at=175;at<2300;at+=240,i++)specs.push({type:'fuel',at,ratio:Math.sin(i*1.7)*.4});\n for(const at of [780,1580])specs.push({type:'bridge',at,ratio:0});\n specs.push({type:'fuel',at:2310,ratio:0},{type:'boss',at:BOSS_AT,ratio:0});\n return specs.sort((a,b)=>a.at-b.at).map((s)=>({id:nextId++,...s,dead:false,active:false,x:river(s.at).center+river(s.at).width*s.ratio,z:5-(s.at-progress),hp:({boat:3,heli:2,turret:5,fuel:1,bridge:26,boss:190})[s.type],maxHp:({boat:3,heli:2,turret:5,fuel:1,bridge:26,boss:190})[s.type],cooldown:1+(s.at%5)*.2,age:0}));\n}\nfunction resetRun(options={}){\n clearObjects();players.forEach(p=>{scene.remove(p.mesh);disposeMesh(p.mesh);});players=[];\n coop=\"'!!options.coop;attract=!!options.attract;autoPilot=false;\n progress=options.at||0;score=0;fuel=100;hull=4;lives=3;pulses=3;combo=1;comboClock=0;kills=0;bridges=progress>=1600?2:progress>=800?1:0;refuels=0;elapsed=0;checkpoint=progress>=1600?1600:progress>=800?800:0;\n bossDefeated=false;sector=0;shownSector=-1;rolls=0;shots=0;deaths=0;clearTimer=0;stats={collisions:0,damage:0,fuelCollected:0,bridgeKills:0,bossPhases:0,simSteps:0};\n entities=buildMission();entities=entities.filter(e=>e.at>progress-8);spawnPlayer(0);if(coop)spawnPlayer(1);\n state='\"'playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');\"'$('\"'bossHud').classList.add('hidden');\"'$('\"'attractTag').classList.toggle('hidden',\"'!attract);document.body.classList.add('\"'in-flight');audio.pause(false);keys.clear();pulseQueued=false;rollQueued=false;accumulator=0;network.reported=false;\n banner(progress>2300?'The Ironwake':'Sector 01 · Sandbar Shuffle',progress>2300?'Bust the boat. Free the current.':'Keep it low. Keep it moving.');\n radio('Keep your wings dry, hotshot. Green barges mean fuel.');updateHud();\n}\nfunction activateEntity(e){\n e.active=true;e.mesh=makeEntity(e.type);scene.add(e.mesh);\n if(e.type==='bridge')e.mesh.scale.x=river(e.at).width/10+0.2;\n const half=({boat:[.9,1,1.5],heli:[.9,1,1],fuel:[1.5,1,2.4],bridge:[river(e.at).width+1,1,1.5],boss:[2.9,1,4],turret:[.9,1,.9]})[e.type];\n createPhysicsObject(e,half);\n if(e.type==='boss'){banner('Ironwake','Make a little room upstream',3);radio('That is one very stubborn boat. Hit it between the volleys\"'!'\"','danger');stats.bossPhases=1;}\n if(e.type==='bridge'){radio('Bridge blockade ahead. Cannon first. Questions later.');}\n}\nfunction fire(p){\n if(p.fireCooldown>0)return;p.fireCooldown=1/tuning.fireRate;shots++;audio.shoot();\n const assist=settings.assist||inputMode==='touch';let vx=0;\n if(assist){const target=entities.filter(e=>e.active&&e.type\"'!=='\"'fuel'&&e.z<p.z-3&&e.z>p.z-55).sort((a,b)=>Math.abs(a.x-p.x)-Math.abs(b.x-p.x))[0];if(target)vx=clamp((target.x-p.x)*2,-10,10);}\n const b={id:nextId++,type:'bullet',x:p.x,z:p.z-2.2,vx,vz:-65,life:1.3,owner:p.index,mesh:makeEntity('bullet'),dead:false};scene.add(b.mesh);b.mesh.position.set(b.x,1.4,b.z);createPhysicsObject(b,[.23,1,.65]);bullets.push(b);\n}\nfunction enemyFire(e){\n if(tuning.enemyRate<=0)return;\n const target=players[(Math.floor(e.age)%players.length)]||players[0];if(\"'!target)return;\n const speed=e.type==='\"'boss'?16:12;const dx=target.x-e.x,dz=target.z-e.z,len=Math.hypot(dx,dz)||1;\n const spread=e.type==='boss'?(e.hp<e.maxHp*.5?[-.38,-.19,0,.19,.38]:[-.24,0,.24]):[0];\n for(const angle of spread){const a=Math.atan2(dx,dz)+angle,b={id:nextId++,type:'enemyBullet',x:e.x,z:e.z+1.8,vx:Math.sin(a)*speed,vz:Math.cos(a)*speed,life:7,mesh:makeEntity('enemyBullet'),dead:false};scene.add(b.mesh);createPhysicsObject(b,[.26,1,.26]);enemyBullets.push(b);}\n}\nfunction roll(p){if(p.rollCooldown>0||p.roll>0)return;p.roll=.7;p.rollCooldown=4.5;p.invul=Math.max(p.invul,.8);rolls++;audio.voice('roll');}\nfunction pulse(){\n if(pulses<=0)return;pulses--;shake=.3;flash=.12;audio.explosion();\n for(const p of players){world.makeBurst(p.x,p.z,0x60f3ca);p.invul=Math.max(p.invul,1.5);}\n for(const b of [...enemyBullets])removeObject(b,enemyBullets);\n for(const e of [...entities])if(e.active&&e.type\"'!=='\"'fuel'&&e.z>-48&&e.z<18){e.hp-=e.type==='boss'?32:12;if(e.hp<=0)destroyEntity(e);else world.makeBurst(e.x,e.z);}\n banner('River pulse',\"'`${pulses} remaining · bullets cleared`,1);updateHud();\n}\nfunction destroyEntity(e,silent=false){\n if(e.dead)return;\n const type=e.type,ex=e.x,ez=e.z;removeObject(e,entities);\n if(!silent){const points=({boat:150,heli:200,turret:250,bridge:1000,boss:5000})[type]||0;score+=points*combo;kills++;comboClock=4;combo=clamp(combo+1,1,5);world.makeBurst(ex,ez,type==='\"'boss'?0xff7048:0xffd467);audio.explosion();shake=Math.max(shake,type==='boss'?.65:.12);}\n if(type==='bridge'){bridges++;stats.bridgeKills++;checkpoint=e.at+20;fuel=clamp(fuel+25,0,100);pulses=Math.min(3,pulses+1);banner('Bridge busted\"'!'\"',\"'`Checkpoint ${bridges} / 2 · fuel +25 · pulse +1`);radio('\"'One less toll to pay. Nice flying\"'!'\"','win');}\n if(type==='boss'){bossDefeated=true;score+=2000;banner('Ironwake sunk\"'!'\"','The river is yours. Fly clear\"'!'\"',4);radio('Clear water ahead\"'! Bring those wings home.'\"','victory');\"'$('\"'bossHud').classList.add('hidden');for(const b of [...enemyBullets])removeObject(b,enemyBullets);fuel=Math.max(fuel,45);}\n}\nfunction takeDamage(p,amount=tuning.damage,reason='hit'){\n if(p.invul>0||godMode||attract||autoPilot||amount<=0)return;\n stats.damage+=amount;hull-=amount;p.invul=1.8;combo=1;comboClock=0;shake=.4;flash=.35;audio.explosion();world.makeBurst(p.x,p.z,0xff7048);radio(reason==='bank'?'Easy on the banks\"'! Keep your wingtips inside.'\"':'That scratched the paint. Roll through the next one\"'!'\"','hit');\n if(hull<=0){lives--;deaths++;if(lives<=0){finishRun(false);return;}respawn();}\n}\nfunction respawn(){\n const keptScore=score,keptKills=kills,keptStats={...stats},keptTime=elapsed,keptLives=lives,keptDeaths=deaths,keptRefuels=refuels;\n const checkpointAt=checkpoint;resetRun({coop,at:checkpointAt});score=keptScore;kills=keptKills;stats=keptStats;elapsed=keptTime;lives=keptLives;deaths=keptDeaths;refuels=keptRefuels;fuel=85;banner('Fresh propeller',\"'`${lives} aircraft left · checkpoint restored`);radio('\"'Back in the air. We are not done yet.');\n}\nfunction finishRun(won){\n if(state\"'!=='\"'playing')return;\n if(attract){clearTimer=4;state='attractEnd';banner(won?'Clear water\"'!'\"':'Another run?', 'Autopilot loops shortly',4);return;}\n best=Math.max(best,score);try{localStorage.setItem('upstream-best',String(best));}catch{}\n if(network.active){network.result(score,{Targets:kills,Bridges:bridges,'Fuel passes':refuels});state='hubresult';banner(won?'Mission complete':'Wings down',\"'`Score ${padNumber(score)} · waiting for the other pilots`,360);audio.pause(true);return;}\n network.result(score,{Targets:kills});showMenu('\"'results');audio.voice(won?'victory':'hit');\n}\nfunction inputFor(p){\n let x=0,y=0,fireHeld=false,rollPressed=false,pulsePressed=false;\n const pads=navigator.getGamepads?.()||[];const pad=pads[p.index];\n if(pad?.connected\"'!==false&&pad){x=Math.abs(pad.axes[0]||0)>.13?pad.axes[0]:0;y=Math.abs(pad.axes[1]||0)>.13?pad.axes[1]:0;fireHeld=!!(pad.buttons[7]?.pressed||pad.buttons[0]?.pressed);rollPressed=!!pad.buttons[5]?.pressed;pulsePressed=!!pad.buttons[1]?.pressed;}\n if(p.index===0){x+=(keys.has('\"'KeyD')?1:0)-(keys.has('KeyA')?1:0);y+=(keys.has('KeyS')?1:0)-(keys.has('KeyW')?1:0);if(\"'!coop){x+=(keys.has('\"'ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0);y+=(keys.has('ArrowDown')?1:0)-(keys.has('ArrowUp')?1:0);}fireHeld||=keys.has('Space')||keys.has('KeyJ')||mouseHeld||settings.assist||inputMode==='touch';rollPressed||=keys.has('ShiftLeft')||keys.has('ShiftRight')||rollQueued;pulsePressed||=pulseQueued;\n if(inputMode==='touch'&&touchControl){x=touchControl.x;y=touchControl.y;}\n if(inputMode==='mouse'&&mouseX\"'!==null&&Math.abs(x)<.1)x=clamp((mouseX-p.x)*3,-1,1);\n }else{x+=(keys.has('\"'ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0);y+=(keys.has('ArrowDown')?1:0)-(keys.has('ArrowUp')?1:0);fireHeld||=keys.has('Enter');rollPressed||=keys.has('Slash');pulsePressed||=keys.has('Period');}\n if(attract||autoPilot){\n const upcomingFuel=entities.find(e=>e.type==='fuel'&&e.at-progress>-2&&e.at-progress<45);\n const target=entities.filter(e=>e.active&&e.type\"'!=='\"'fuel'&&e.z<0&&e.z>-50).sort((a,b)=>b.z-a.z)[0];\n const safe=river(progress+6).center;const aim=upcomingFuel&&fuel<92?upcomingFuel.x:target?target.x:safe;\n x=clamp((aim-p.x)*2,-1,1);y=-.1;fireHeld=true;rollPressed=(Math.floor(elapsed*2)%14===0);pulsePressed=pulses>0&&enemyBullets.length>10;\n }\n return{x:clamp(x,-1,1),y:clamp(y,-1,1),fire:fireHeld,roll:rollPressed,pulse:pulsePressed};\n}\nfunction simulate(dt){\n if(state\"'!=='\"'playing')return;stats.simSteps++;elapsed+=dt;comboClock-=dt;if(comboClock<=0)combo=1;\n const inputs=players.map(inputFor);const throttle=inputs[0]?.y||0;let speed=tuning.speed*(1-throttle*.42);\n const boss=entities.find(e=>e.type==='boss');if(boss&&\"'!bossDefeated&&progress>=BOSS_AT-32)speed=0;\n progress=Math.min(FINISH_AT+2,progress+speed*dt);\n fuel-=tuning.fuelDrain*dt*(speed>0?1+Math.max(0,-throttle)*.25:.65);if(godMode||attract||autoPilot)fuel=Math.max(fuel,70);fuel=clamp(fuel,0,100);\n if(fuel<25&&fuel>24.9)radio('\"'Fuel is getting shy. Overfly a green barge.','danger');\n if(fuel<=0){takeDamage(players[0],1,'fuel');fuel=0;}\n for(let i=0;i<players.length;i++){\n const p=players[i],input=inputs[i];p.invul=Math.max(0,p.invul-dt);p.rollCooldown=Math.max(0,p.rollCooldown-dt);p.fireCooldown=Math.max(0,p.fireCooldown-dt);\n p.x+=input.x*tuning.steering*dt;p.z=lerp(p.z,5+input.y*2.2,dt*4);\n const r=river(progress-p.z+5),margin=.75;\n if(inputMode==='touch'||attract||autoPilot){p.x=clamp(p.x,r.center-r.width+margin,r.center+r.width-margin);if(inputMode==='touch'&&enemyBullets.some(b=>Math.hypot(b.x-p.x,b.z-p.z)<2.6))roll(p);}\n if(Math.abs(p.x-r.center)>r.width-.3)takeDamage(p,tuning.damage,'bank');p.x=clamp(p.x,r.center-r.width-1,r.center+r.width+1);\n p.bank=lerp(p.bank,-input.x*.4,dt*7);if(input.roll)roll(p);if(input.pulse&&pulses>0&&\"'!p.pulseLatch)pulse();p.pulseLatch=input.pulse;\n if(input.fire)fire(p);p.roll=Math.max(0,p.roll-dt);p.mesh.rotation.z=p.bank+(p.roll>0?(1-p.roll/.7)*Math.PI*2:0);p.mesh.position.set(p.x,1.7+Math.sin(visualTime*3+i)*.04,p.z);p.mesh.visible=p.invul<=0||Math.floor(elapsed*12)%2===0||p.roll>0;\n p.body?.setNextKinematicTranslation({x:p.x,y:0,z:p.z});p.mixer.update(dt);\n }\n pulseQueued=false;rollQueued=false;\n let shouldRefuel=false;\n for(const e of [...entities]){\n e.z=5-(e.at-progress);if(e.z>20){removeObject(e,entities);continue;}if(!e.active&&e.z>-76)activateEntity(e);if(!e.active)continue;\n e.age+=dt;\n if(e.type==='\"'heli')e.x=river(e.at).center+Math.sin(e.age*.9+e.at)*Math.min(6,river(e.at).width-2);\n if(e.type==='boat')e.x=river(e.at).center+river(e.at).width*e.ratio+Math.sin(e.age*.65+e.at)*.7;\n if(e.type==='boss'){e.x=river(e.at).center+Math.sin(e.age*.6)*3.7;if(e.hp<e.maxHp*.5&&stats.bossPhases===1){stats.bossPhases=2;radio('Its engines are hot. Watch the wide volleys\"'!'\"','danger');banner('Ironwake enraged','Keep rolling. Keep firing.',2);}}\n e.mesh.position.set(e.x,e.type==='heli'?1.7:.25,e.z);if(e.type==='heli')e.mesh.rotation.z=Math.cos(e.age*.9+e.at)*-.1;\n if(e.mesh.userData.rotor)e.mesh.userData.rotor.rotation.y+=dt*28;if(e.mesh.userData.ring)e.mesh.userData.ring.rotation.z+=dt;if(e.mesh.userData.radar)e.mesh.userData.radar.rotation.y+=dt;\n e.body.setNextKinematicTranslation({x:e.x,y:0,z:e.z});\n if(['boat','heli','turret','boss'].includes(e.type)&&e.z>-58&&e.z<4){e.cooldown-=dt*tuning.enemyRate;if(e.cooldown<=0){enemyFire(e);e.cooldown=e.type==='boss'?(e.hp<e.maxHp*.5?.75:1.15):e.type==='turret'?1.9:3.2;}}\n if(e.type==='fuel'&&players.some(p=>Math.abs(p.x-e.x)<1.9&&Math.abs(p.z-e.z)<3.2)){\n shouldRefuel=true;const amount=Math.min(100-fuel,62*dt);fuel+=amount;stats.fuelCollected+=amount;\n if(\"'!e.collected){e.collected=true;refuels++;hull=Math.min(4,hull+1);score+=350;audio.pickup();radio('\"'Topped up. Wings patched. Cause some trouble\"'!'\"','pickup');}\n }\n }\n for(const b of [...bullets,...enemyBullets]){\n b.x+=b.vx*dt;b.z+=b.vz*dt+(b.type==='enemyBullet'?speed*dt:0);b.life-=dt;b.mesh.position.set(b.x,1.4,b.z);b.mesh.rotation.y=b.type==='bullet'?Math.atan2(-b.vx,65):visualTime*3;\n b.body?.setNextKinematicTranslation({x:b.x,y:0,z:b.z});if(b.life<=0||b.z<-85||b.z>23||Math.abs(b.x)>40)removeObject(b,b.type==='bullet'?bullets:enemyBullets);\n }\n physics.timestep=dt;physics.step(eventQueue);\n const contacts=[];eventQueue.drainCollisionEvents((a,b,started)=>{if(started)contacts.push([colliders.get(a),colliders.get(b)]);});\n for(let [a,b] of contacts){if(\"'!a||!b||a.dead||b.dead)continue;stats.collisions++;\n if(b.type==='\"'bullet'||b.type==='player'){[a,b]=[b,a];}\n if(a.type==='bullet'&&b.type\"'!=='\"'player'&&b.type\"'!=='\"'bullet'&&b.type\"'!=='\"'enemyBullet'&&b.type\"'!=='\"'fuel'){\n removeObject(a,bullets);b.hp-=2;if(b.hp<=0)destroyEntity(b);else if(b.type==='bridge'||b.type==='boss')world.makeBurst(a.x,a.z,0xffd467);\n }else if(a.type==='player'&&b.type\"'!=='\"'bullet'&&b.type\"'!=='\"'player'&&b.type\"'!=='\"'fuel'){\n takeDamage(a);if(b.type==='enemyBullet')removeObject(b,enemyBullets);else if(\"'!['\"'bridge','boss'].includes(b.type))destroyEntity(b);\n }\n }\n if(shouldRefuel)\"'$('\"'fuelFill').style.background='#fff0cc';else \"'$('\"'fuelFill').style.background=fuel<25?'#ff7048':'#42d8bc';\n sector=progress<820?0:progress<1640?1:2;if(sector\"'!==shownSector){shownSector=sector;if(sector>0){banner(SECTORS[sector],`Sector 0${sector+1} · ${sector===1?'\"'Keep your wingtips inside':'Last stop: river lockdown'}\"'`);radio(sector===1?'\"'Needle Bend. Small river, big attitude.':'Ironwake territory. Give them a proper hello.');}}\n if(progress>=FINISH_AT&&bossDefeated)finishRun(true);\n}\nfunction updateHud(){\n \"'$('\"'score').textContent=padNumber(score);\"'$('\"'best').textContent='BEST '+padNumber(best);\"'$('\"'sectorLabel').textContent=\"'`Sector 0${sector+1} / 03`;$('\"'sectorName').textContent=SECTORS[sector];\"'$('\"'routeFill').style.width=clamp(progress/FINISH_AT*100,0,100)+'%';\"'$('\"'hull').textContent='◆'.repeat(Math.ceil(Math.max(0,hull)))+'◇'.repeat(Math.max(0,4-Math.ceil(Math.max(0,hull))));\"'$('\"'lives').textContent='×'+lives;\"'$('\"'fuelNumber').textContent=Math.ceil(fuel)+'%';\"'$('\"'fuelFill').style.width=fuel+'%';\"'$('\"'combo').textContent=combo>1?'CHAIN ×'+combo:'';\n const p=players[0];\"'$('\"'rollStatus').textContent=p&&p.rollCooldown>0?p.rollCooldown.toFixed(1)+'s':'READY';\"'$('\"'pulseStatus').textContent=pulses?'● '.repeat(pulses).trim():'EMPTY';\n const boss=entities.find(e=>e.type==='boss'&&e.active);\"'$('\"'bossHud').classList.toggle('hidden',\"'!boss||state!=='\"'playing');if(boss)\"'$('\"'bossFill').style.width=Math.max(0,boss.hp/boss.maxHp*100)+'%';\n if(state==='dev')\"'$('\"'debugLine').textContent=\"'`${diagnostics.renderer} · Rapier ${RAPIER.version()}'\"\\\\nDistance \"'${Math.floor(progress)} / ${FINISH_AT} · ${entities.filter(e=>e.active).length} hostiles · ${stats.collisions} contacts'\"\\\\nSeeded mission · \"'${stats.simSteps} simulation steps · no recorded assets`;\n}\nfunction updateGhosts(dt){\n for(const [id,g] of network.peers){\n let mesh=ghostMeshes.get(id);if(!mesh){mesh=makeGhost(g.color);scene.add(mesh);ghostMeshes.set(id,mesh);}\n const delta=g.progress-progress;mesh.visible=activePlay()&&Math.abs(delta)<65&&g.sector===sector;mesh.position.set(g.x,2.1,5-delta);mesh.rotation.z=g.bank;mesh.userData.mixer.update(dt);\n }\n for(const [id,mesh] of ghostMeshes)if(!network.peers.has(id)){scene.remove(mesh);disposeMesh(mesh);ghostMeshes.delete(id);}\n const visible=network.peers.size>0&&state==='\"'playing';\"'$('\"'ghosts').classList.toggle('hidden',\"'!visible);if(visible)$('\"'ghosts').textContent=[network.active?'LIVE RIVER GHOSTS':'BROWSER-LOCAL GHOSTS',...([...network.peers.values()].map(g=>\"'`${g.name}   ${padNumber(g.score)}   ${Math.abs(g.progress-progress)<65?'\"'IN SIGHT':Math.round((g.progress-progress)/16)+'s'}\"'`))].join('\"'\\\\n');\n}\nfunction pollGamepads(dt){\n menuCooldown=Math.max(0,menuCooldown-dt);const pads=navigator.getGamepads?.()||[];\n for(const pad of pads){if(\"'!pad)continue;const prior=previousPads.get(pad.index)||[];const pressed=pad.buttons.map(b=>b.pressed);const edge=i=>pressed[i]&&!prior[i];const active=pressed.some(Boolean)||pad.axes.some(a=>Math.abs(a)>.25);\n if(active){if(activity('\"'pad')){previousPads.set(pad.index,pressed);return;}}\n if(edge(9)&&\"'!pressed[8]){if(state==='\"'playing')pause();else if(state==='paused')resume();}\n else if(\"'!['\"'playing','hubwait','hubresult','hubended','attractEnd'].includes(state)){\n const down=edge(13)||(pad.axes[1]>.55&&menuCooldown<=0),up=edge(12)||(pad.axes[1]<-.55&&menuCooldown<=0);\n if(down||up){focusMenu(menuFocus+(down?1:-1));menuCooldown=.2;}\n if(edge(0))document.activeElement?.click();\n if(edge(1)&&state\"'!=='\"'title')handleAction('back');\n const dir=edge(15)?1:edge(14)?-1:Math.abs(pad.axes[0])>.6&&menuCooldown<=0?Math.sign(pad.axes[0]):0;\n if(dir){adjustFocused(dir);menuCooldown=.15;}\n }\n previousPads.set(pad.index,pressed);\n }\n}\nfunction adjustFocused(dir){const e=document.activeElement;if(e?.type==='range'){e.value=clamp(+e.value+dir*(+e.step||1),+e.min,+e.max);e.dispatchEvent(new Event('input',{bubbles:true}));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+dir+e.options.length)%e.options.length;e.dispatchEvent(new Event('input',{bubbles:true}));}}\nfunction hideTouchStick(){touchControl=null;\"'$('\"'touchRing').style.display='none';\"'$('\"'touchDot').style.display='none';}\nconst raycaster=new THREE.Raycaster(),aimPlane=new THREE.Plane(new THREE.Vector3(0,1,0),-1.7),aimPoint=new THREE.Vector3();\nfunction bindInput(){\n document.addEventListener('keydown',e=>{\n if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code)&&\"'!['\"'INPUT','SELECT'].includes(e.target.tagName))e.preventDefault();\n if(activity('keyboard')){e.preventDefault();return;}audio.unlock();\n if(e.code==='Escape'){if(state==='playing')pause();else if(state==='paused')resume();else if(\"'!network.active&&state!=='\"'title')handleAction('back');return;}\n if(state==='playing'){keys.add(e.code);if(e.code==='KeyQ')pulseQueued=true;return;}\n if(e.target.tagName==='INPUT'&&e.target.type==='text')return;\n if(e.code==='ArrowDown'||e.code==='ArrowUp'){focusMenu(menuFocus+(e.code==='ArrowDown'?1:-1));e.preventDefault();}\n if(e.code==='ArrowLeft'||e.code==='ArrowRight')adjustFocused(e.code==='ArrowRight'?1:-1);\n if(e.code==='Enter'&&\"'!e.repeat&&e.target.tagName!=='\"'BUTTON')document.activeElement?.click();\n });\n document.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();mouseHeld=false;if(\"'!network.active&&state==='\"'playing'&&\"'!attract)pause();});\n document.addEventListener('\"'pointerdown',e=>{if(activity(e.pointerType==='touch'?'touch':'mouse')){e.stopImmediatePropagation();e.preventDefault();return;}audio.unlock();},true);\n \"'$('\"'game').addEventListener('pointerdown',e=>{if(state\"'!=='\"'playing')return;audio.unlock();if(e.pointerType==='touch'){touchControl={id:e.pointerId,startX:e.clientX,startY:e.clientY,x:0,y:0};\"'$('\"'touchRing').style.cssText=\"'`display:block;left:${e.clientX}px;top:${e.clientY}px`;$('\"'touchDot').style.cssText=\"'`display:block;left:${e.clientX}px;top:${e.clientY}px`;}else mouseHeld=true;$('\"'game').setPointerCapture(e.pointerId);});\n document.addEventListener('pointermove',e=>{\n if(e.pointerType==='touch'){if(touchControl?.id===e.pointerId){touchControl.x=clamp((e.clientX-touchControl.startX)/65,-1,1);touchControl.y=clamp((e.clientY-touchControl.startY)/65,-1,1);\"'$('\"'touchDot').style.left=touchControl.startX+touchControl.x*42+'px';\"'$('\"'touchDot').style.top=touchControl.startY+touchControl.y*42+'px';}return;}\n if(Math.abs(e.movementX)+Math.abs(e.movementY)>0)activity('mouse');if(\"'!camera)return;\n raycaster.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1),camera);if(raycaster.ray.intersectPlane(aimPlane,aimPoint))mouseX=aimPoint.x;\n });\n document.addEventListener('\"'pointerup',e=>{mouseHeld=false;if(touchControl?.id===e.pointerId)hideTouchStick();});document.addEventListener('pointercancel',()=>{mouseHeld=false;hideTouchStick();});\n \"'$('\"'pauseButton').addEventListener('click',pause);\"'$('\"'touchMenu').addEventListener('click',()=>{if(state==='playing')pause();else if(state==='paused')resume();else if(state\"'!=='\"'title')handleAction('back');});\n \"'$('\"'touchPulse').addEventListener('pointerdown',e=>{e.stopPropagation();pulseQueued=true;});window.addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(document.hidden&&\"'!network.active&&state==='\"'playing'&&\"'!attract)pause();});\n window.addEventListener('\"'gamepadconnected',()=>setInputMode('pad'));\n if(matchMedia('(pointer:coarse)').matches)setInputMode('touch');\n}\nfunction resize(){\n if(\"'!renderer||!camera)return;renderer.setSize(innerWidth,innerHeight,false);\n const aspect=innerWidth/innerHeight,halfWidth=aspect<1?18:Math.max(24,aspect*18),halfHeight=halfWidth/aspect;\n camera.left=-halfWidth;camera.right=halfWidth;camera.top=halfHeight;camera.bottom=-halfHeight;camera.updateProjectionMatrix();\n}\nfunction renderFrame(now){\n const raw=lastFrame?Math.min((now-lastFrame)/1000,.1):0;lastFrame=now;visualTime+=raw;pollGamepads(raw);\n if(state==='\"'hubwait'&&hubStarted&&globalThis.AIHub.time()>=0){resetRun({});}\n if(state==='title'&&now-lastInput>=10000&&\"'!network.active)resetRun({attract:true});\n if(state==='\"'attractEnd'){clearTimer-=raw;if(clearTimer<=0)resetRun({attract:true});}\n if(state==='playing'){\n accumulator+=raw*tuning.timeScale;let steps=0;while(accumulator>=1/60&&steps<20&&state==='playing'){simulate(1/60);accumulator-=1/60;steps++;}\n }else accumulator=0;\n if(state==='title'||['settings','about','instructions','room'].includes(state)&&previousMenu==='title'){titleProgress+=raw*5;world.render(titleProgress,visualTime);}else world.render(progress,visualTime);\n world.updateEffects(raw);updateGhosts(raw);bannerClock-=raw;if(bannerClock<=0)\"'$('\"'banner').classList.add('hidden');radioClock-=raw;\n shake=Math.max(0,shake-raw);flash=Math.max(0,flash-raw*1.5);\"'$('\"'flash').style.opacity=flash*.35;\n const riverCenter=river(state==='title'?titleProgress:progress+18).center;\n const menuScene=state==='title'||(['settings','instructions','about','room'].includes(state)&&previousMenu==='title');\n const targetX=menuScene?-10:riverCenter*.4;\n camera.position.set(targetX+(settings.shake?Math.sin(visualTime*89)*shake*.4:0),48,29);camera.lookAt(targetX,0,-16);\n audio.update(raw,{playing:state==='playing'&&\"'!attract,speed:1-(inputForSafe()?.y||0)*.42,danger:fuel<25||!!entities.find(e=>e.type==='\"'boss'&&e.active),sector});\n if(state==='playing'||state==='hubresult'){\n const p=players[0];if(p)network.update(raw,{x:p.x,y:p.z,progress,bank:p.bank,fire:p.fireCooldown>0,sector},score,\"'`${SECTORS[sector]} · ${Math.floor(progress/FINISH_AT*100)}%`);\n }\n reportClock+=raw;if(reportClock>.08){updateHud();reportClock=0;}\n renderer.render(scene,camera);\n}\nfunction inputForSafe(){return players[0]?{y:keys.has('\"'KeyW')?-1:keys.has('KeyS')?1:0}:null;}\nasync function boot(){\n try{\n await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});eventQueue=new RAPIER.EventQueue(true);\n renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'game'),antialias:true,alpha:false,powerPreference:'high-performance'});\n renderer.setPixelRatio(Math.min(devicePixelRatio,network.active?1:1.7));await renderer.init();\n diagnostics.renderer=renderer.backend?.isWebGPUBackend?'WebGPU':'WebGL fallback';\n scene=new THREE.Scene();scene.background=new THREE.Color(0x78a571);scene.fog=new THREE.Fog(0x9fb982,90,180);\n scene.add(new THREE.HemisphereLight(0xfff3cf,0x3f6975,2.4));const sun=new THREE.DirectionalLight(0xffe8b3,3.2);sun.position.set(-25,60,20);scene.add(sun);\n camera=new THREE.OrthographicCamera(-30,30,20,-20,.1,250);camera.position.set(0,48,29);camera.lookAt(0,0,-16);world=new WorldView(scene);resize();world.render(titleProgress,0);\n bindInput();\n await network.init({onStart:()=>{hubStarted=true;},onTimeUp:()=>{network.result(score,{Targets:kills,Bridges:bridges,'Fuel passes':refuels});state='hubresult';audio.pause(true);},onEnd:()=>{hubEnded=true;state='hubended';keys.clear();mouseHeld=false;audio.stop();\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.add('hidden');\"'$('\"'bossHud').classList.add('hidden');\"'$('\"'banner').classList.add('hidden');}});\n \"'$('\"'loading').classList.add('hidden');diagnostics.ready=true;diagnostics.bootMs=performance.now()-bootAt;\n if(network.active){state='hubwait';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.add('hidden');network.ready();}else showMenu('title');\n renderer.setAnimationLoop(renderFrame);\n }catch(error){diagnostics.errors.push(String(error.stack||error));\"'$('\"'loadingMessage').textContent='Flight could not start: '+error.message+' · Use a browser with WebGPU, and allow the CDN dependencies.';document.querySelector('.spinner')?.remove();globalThis.AIHub?.active&&globalThis.AIHub.fail(error.message);console.error(error);}\n}\n// Read-only diagnostics are always available; mutation helpers require ?test=1.\nwindow.__UPROAR__={get state(){return state;},get diagnostics(){return {...diagnostics,physics:RAPIER.version?.(),network:network.diagnostics(),audio:audio.diagnostics()};},snapshot(){return {state,attract,coop,progress,score,fuel,hull,lives,pulses,combo,kills,bridges,refuels,elapsed,checkpoint,bossDefeated,sector,rolls,shots,deaths,stats:{...stats},players:players.map(p=>({x:p.x,z:p.z,invul:p.invul,roll:p.roll,rollCooldown:p.rollCooldown})),entities:entities.filter(e=>e.active).map(e=>({id:e.id,type:e.type,x:e.x,z:e.z,hp:e.hp,at:e.at})),bullets:bullets.length,enemyBullets:enemyBullets.length,tuning:{...tuning},settings:{...settings}};}};\nif(new URLSearchParams(location.search).get('test')==='1')Object.assign(window.__UPROAR__,{start:options=>resetRun(options),step:(seconds)=>{for(let i=0;i<Math.ceil(seconds*60)&&state==='playing';i++)simulate(1/60);updateHud();return window.__UPROAR__.snapshot();},autopilot:v=>{autoPilot=v;},god:v=>{godMode=v;},setFuel:v=>{fuel=clamp(v,0,100);},setHull:v=>{hull=v;},setLives:v=>{lives=v;},setPlayer:(x,z=5)=>{players[0].x=x;players[0].z=z;players[0].invul=0;},hurt:()=>takeDamage(players[0]),fire:()=>fire(players[0]),roll:()=>roll(players[0]),pulse,warp:at=>resetRun({at}),setTuning:(k,v)=>{if(k in tuning)tuning[k]=v;},setAttractIdle:()=>{lastInput=performance.now()-10001;},radio,river,finish:()=>{bossDefeated=true;progress=FINISH_AT;finishRun(true);},network, audio});\nwindow.addEventListener('error',e=>diagnostics.errors.push(e.message));window.addEventListener('unhandledrejection',e=>diagnostics.errors.push(String(e.reason)));\nboot();\nEOF\ncat > build.py <<'EOF'\nfrom pathlib import Path\nimport json,re\nroot=Path(__file__).resolve().parent\ncredits=json.loads((root.parent/'exit-interview.json').read_text())\n(root/'credits.js').write_text('export const CREDITS = '+json.dumps(credits,ensure_ascii=False)+';\\\\n')\ncode=[]\nfor name in ['world.js','audio.js','network.js','credits.js','main.js']:\n    source=(root/name).read_text()\n    if name\"'!='\"'main.js':\n        source=re.sub(r'\"'^import .*?;'\"\\\\n','',source,flags=re.M)\n    else:\n        source=re.sub(r\\\"\"'^import .*? from '\"'\\\\./.*?';\\\\n\\\",'',source,flags=re.M)\n    source=re.sub(r'\"'^export '\"','',source,flags=re.M)\n    code.append(source)\nhtml=(root/'shell.html').read_text().replace('<\"'!-- HUB_CLIENT -->'\"','<script>\\\\n'+(root/'hub-session.js').read_text()+'\\\\n</script>').replace('// GAME_CODE','\\\\n'.join(code))\npath=root.parent/(root.name+'.html');path.write_text(html)\nprint(path.name+' · '+str(path.stat().st_size)+' bytes')\nEOF\ncat > README.md <<'EOF'\n# Upstream Uproar\n\nA complete three-sector arcade river-flight mission inspired by River Raid (1982).\n\nOpen the HTML in the parent folder with a modern WebGPU browser. An Internet connection loads Three.js r180, Rapier 0.19.3, and the optional Google font. No server or build step is needed to play the shared HTML. Local two-player co-op supports two controllers or shared keyboard. Online ghost competition is provided by AI Hub sessions; standalone browser-local rooms use BroadcastChannel between same-origin tabs on one device.\n\nControls: WASD / arrows steer and change throttle, Space fire, Shift roll, Q pulse, Esc pause. Mouse moves the plane and left click fires. Controller: left stick, RT or Cross/A fire, R1/RB roll, Circle/B pulse, Options/Menu pause. Touch: drag anywhere; assisted cannon and emergency rolls, tap Pulse when needed.\n\n## Build\n\n\"'`python3 build.py` embeds the game modules, credits, and unmodified Hub client in one HTML. External runtime libraries remain pinned CDN dependencies.\n\n## Tests\n\n`./test.sh` builds the current game, starts its own loopback server on an OS-selected port, runs state-driven browser checks plus the official AI Hub harness and a full scripted mission, closes its browser and stops its own server. It prints only failures and a one-line count.\n\nDeveloper tools are in the pause menu. Live balancing, invulnerability, autopilot, resupply, hostile clear, and sector jumps are implemented. Query `?test=1` exposes additional script-only mutation helpers; read-only game state and diagnostics are always available at `window.__UPROAR__`.\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,pathlib\np=pathlib.Path('exit-interview.json')\ndata={'sourceInformation':{'date':'2026-11-06 01:11:35','source':'River Raid (1982)','plan':'none','genre':'Arcade flight / scrolling shooter','perspective':'Overhead 3D with an angled orthographic camera','tech':'Three.js r180 (0.180.0), WebGPU, Rapier 0.19.3, Gamepad API, Web Audio API, vanilla JavaScript, HTML/CSS; AI Hub Session Protocol v1 client 1.4.0','artDirection':'Procedural cel-shaded low-poly scenery, ink outlines, warm sand, teal water, coral aircraft','animation':'Three.js AnimationMixer with native keyframe clips for propeller, thrust and airframe; procedural banking, rolls, rotors and particles','audio':'Code-synthesized surf/funk music, engines, cannon, explosions, pickups and Animalese-style radio gibberish; default music 10%','online':'AI Hub ghost competition for 1–4 players; same-device browser-local ghost rooms using BroadcastChannel; standalone local co-op for 1–2 players','testing':'Headless Chromium with software WebGPU, scripted state checks and full mission, emulated standard gamepads, mobile touch profile, Web Audio analyser, official AI Hub harness; screenshots for visual inspection','research':'none; native model knowledge. Supplied AI Hub integration files read directly; no internet search. Pinned runtime dependencies downloaded.','environment':'Codex CLI (headless); Linux / Ubuntu on WSL2','model':'OpenAI, gpt-6.1-sol, reasoning effort ultra','usage':'added on import'},'testingFeedback':['Issues caught: unknown; final testing in progress.','Critical or game-breaking issues: unknown; final testing in progress.','Most helpful test: unknown; final testing in progress.','Least helpful test: unknown; final testing in progress.'],'engineFeedback':['Three.js native animation and geometry APIs made procedural aircraft, faceted scenery, and a coherent ink style straightforward.','A MeshToonMaterial flatShading option was unsupported in r180; removed it. Other integration findings: unknown until final testing.','The mission simulation, procedural river, controls and controller-first menu system were built specifically for this game.','Coordinating fixed-step Rapier contacts, a scrolling world, and WebGPU rendering was the hardest engine integration.','none','Provide a concise end-to-end WebGPU game template with physics, audio activation and controller navigation.'],'promptFeedback':['The concrete source and controller-first philosophy gave the game a clear mechanical and visual target.','The no-internet-research rule coexists with required online integration documentation; the supplied Hub files were treated as implementation specifications.','Delivering a complete mission, accessible input methods, procedural audiovisuals and verified multiplayer in one shareable HTML.','Separate required platform integration from optional features and explicitly distinguish local co-op, browser-local rooms and Internet multiplayer.'],'aiHub':{'name':'Upstream Uproar','tagline':'Low flight. High mischief.','description':'Skim a winding cel-shaded river, top up on fuel, and blast two bridge blockades before facing the Ironwake. Fly solo, bring a local wingmate, or chase live ghosts in AI Hub.','type':'Game','genre':'Shooter','source':'River Raid (1982)','series':'','players':'1–4','controls':'WASD / left stick steer and throttle; Space / RT fire; Shift / R1 roll; Q / Circle pulse; Esc / Options pause. Mouse steering and touch assisted flight.','tags':['3d','arcade','top-down','vehicles','co-op','boss fights']}}\np.write_text(json.dumps(data,indent=2,ensure_ascii=False)+'\\\\n')\nPY\npython3 Upstream-Uproar-River-Raid-gpt-6.1-sol-ultra-20261106-011135/build.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
