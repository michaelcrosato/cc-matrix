{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba test-game.py | sed -n '70,155p'\ncat test-results.json\ncat mission-test.json\"","aggregated_output":"    70\t check('barrel roll invulnerability',s['hull']==3 and s['rolls']==1 and s['players'][0]['rollCooldown']>4)\n    71\t start(page);js(page,'window.__UPROAR__.god(false);window.__UPROAR__.setHull(1);window.__UPROAR__.setFuel(0);window.__UPROAR__.setPlayer(0)');s=step(page,.1)\n    72\t check('fuel death respawn recovery',s['lives']==2 and s['fuel']>80 and s['hull']==4,str(s))\n    73\t js(page,'window.__UPROAR__.warp(760);window.__UPROAR__.god(true)');s=step(page,8)\n    74\t check('bridge blockade cannot be bypassed',s['progress']<770 and s['bridges']==0,str(s))\n    75\t js(page,'{let e=window.__UPROAR__.snapshot().entities.find(e=>e.type===\"bridge\");window.__UPROAR__.setPlayer(e.x)}')\n    76\t page.keyboard.down('Space');s=step(page,4);page.keyboard.up('Space')\n    77\t check('bridge destruction checkpoint',s['bridges']==1 and s['checkpoint']==800,str(s))\n    78\t js(page,'window.__UPROAR__.warp(2388);window.__UPROAR__.god(true)');s=step(page,2)\n    79\t check('boss fires volleys',s['enemyBullets']>0,str(s))\n    80\t js(page,'window.__UPROAR__.pulse()');s=snap(page)\n    81\t check('pulse clears projectiles',s['enemyBullets']==0 and s['pulses']==2)\n    82\t check('pulse damages boss',any(e['type']=='boss' and e['hp']<190 for e in s['entities']))\n    83\t page.keyboard.press('Escape');s=snap(page);before=s['elapsed'];step(page,10)\n    84\t check('pause freezes mission',snap(page)['state']=='paused' and snap(page)['elapsed']==before)\n    85\t page.get_by_role('button',name='Developer tools').click();slider=page.locator('#tune-speed');slider.fill('24');slider.dispatch_event('input')\n    86\t check('live developer slider',snap(page)['tuning']['speed']==24)\n    87\t page.get_by_role('button',name='Reset defaults').click();check('balance reset'