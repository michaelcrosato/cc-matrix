{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,re\nroot=Path.cwd();slug='Upstream-Uproar-River-Raid-1982-gpt-6.1-sol-ultra-20261106-011135';dev=root/slug\nmetadata=json.loads((root/'exit-interview.json').read_text());html=(root/(slug+'.html')).read_text();report=json.loads((dev/'test-results.json').read_text());issues=json.loads((dev/'testing-issues.json').read_text())\nassert set(metadata)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\nassert len(metadata['testingFeedback'])==4 and len(metadata['engineFeedback'])==6 and len(metadata['promptFeedback'])==4\nassert metadata['sourceInformation']['usage']=='added on import'\nassert report=={'passed':100,'failed':0,'failures':[]}\nassert len(issues)==20 and sum(i['critical'] for i in issues)==4 and all(i['fixed'] for i in issues)\nassert '<script>\\\\n'+(dev/'hub-session.js').read_text()+'\\\\n</script>' in html\nassert all(v in html for v in ['three@0.180.0','rapier3d-compat@0.19.3','Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import'])\nassert not re.search(r'\\\\bfrom\\\\s+[\\\\\\\"\\\\x27]\\\\.\\\\.?/',(dev/'game.bundle.js').read_text())\nassert 'final testing in progress' not in html\nmission=json.loads((dev/'mission-test.json').read_text());assert mission[-1]['state']=='results' and mission[-1]['bossDefeated'] and mission[-1]['bridges']==2\nprint(json.dumps({'html':slug+'.html','bytes':(root/(slug+'.html')).stat().st_size,'checks':report['passed'],'missionSeconds':round(mission[-1]['elapsed'],2),'rootFiles':[p.name for p in root.iterdir() if p.is_file()]}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
