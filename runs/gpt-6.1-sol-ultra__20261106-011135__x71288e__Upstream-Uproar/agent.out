lect_option('xbox');page.locator('#glyphs').dispatch_event('input');js(page,'testPad.axes[0]=.3');page.wait_for_timeout(100)\n   101\t check('Xbox dynamic prompt',page.locator('[data-glyph=\"back\"]').first.inner_text()=='B')\n   102\t page.locator('#glyphs').select_option('playstation');page.locator('#glyphs').dispatch_event('input');page.get_by_role('button',name='Back',exact=False).click();page.get_by_role('button',name='Flight manual').click()\n   103\t check('PlayStation R2 prompt','R2' in page.locator('.info-grid').inner_text())\n   104\t js(page,'testPad.axes[3]=1');page.wait_for_timeout(150);js(page,'testPad.axes[3]=0;navigator.getGamepads=()=>[]')\n   105\t start(page,'{coop:true}');js(page,'window.__UPROAR__.god(true)');before=snap(page)['players'][1]['x'];page.keyboard.down('ArrowRight');page.keyboard.down('Enter');s=step(page,.4);page.keyboard.up('ArrowRight');page.keyboard.up('Enter')\n   106\t check('local co-op second pilot',s['coop'] and len(s['players'])==2 and s['players'][1]['x']>before+1 and s['shots']>0)\n   107\t # Entire mission through combat; autopilot cheats survival, not objectives.\n   108\t start(page);js(page,'window.__UPROAR__.autopilot(true)')\n   109\t for i in range(28):\n   110\t  s=step(page,12);mission.append({k:s[k] for k in ['elapsed','progress','score','bridges','refuels','kills','bossDefeated','state']})\n   111\t  if s['state']!='playing':break\n   112\t check('complete scripted mission',s['state']=='results' and s['bossDefeated'] and s['progress']>=2650,str(s))\n   113\t check('all bridge objectives',s['bridges']==2,str(s))\n   114\t check('mission demonstrates fuel',s['refuels']>=4,str(s))\n   115\t check('boss second attack phase',s['stats']['bossPhases']==2,str(s))\n   116\t check('mission demonstrates combat and rolls',s['kills']>25 and s['shots']>300 and s['rolls']>8,str(s))\n   117\t # Two copies exchange actual BroadcastChannel states.\n   118\t page2=context.new_page();ready(page2,base+game+'?test=1')\n   119\t for tab in [page,page2]:js(tab,'window.__UPROAR__.network.joinRoom(\"AUTOTEST\",\"Pilot\");window.__UPROAR__.start({});window.__UPROAR__.autopilot(true)')\n   120\t page.wait_for_function('window.__UPROAR__.diagnostics.network.peers===1',timeout=10000);page2.wait_for_function('window.__UPROAR__.diagnostics.network.peers===1',timeout=10000)\n   121\t check('two-tab ghost transport',js(page,'window.__UPROAR__.diagnostics.network.received')>0 and js(page2,'window.__UPROAR__.diagnostics.network.received')>0)\n   122\t js(page2,'window.__UPROAR__.network.leaveRoom()');page.wait_for_function('window.__UPROAR__.diagnostics.network.peers===0');check('ghost room leave',js(page,'window.__UPROAR__.diagnostics.network.peers')==0);page2.close()\n   123\t check('no uncaught runtime errors',not errors,'; '.join(errors))\n   124\t context.close()\n   125\t context=browser.new_context(viewport={'width':1280,'height':800});filepage=context.new_page();ready(filepage,(ROOT.parent/game).as_uri()+'?test=1');check('standalone file URL boot',snap(filepage)['state']=='title');context.close()\n   126\t # Touch uses native injected multitouch, no physical device needed.\n   127\t context=browser.new_context(**p.devices['Pixel 7']);page=context.new_page();ready(page,base+game+'?test=1')\n   128\t page.get_by_role('button',name='Fly the river').tap();js(page,'window.__UPROAR__.god(true)')\n   129\t check('touch mode selected',js(page,'document.body.dataset.touch')=='true')\n   130\t cdp=context.new_cdp_session(page);cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':100,'y':540}]});cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':165,'y':540}]});before=snap(page)['players'][0]['x'];s=step(page,.4)\n   131\t check('touch drag steering',s['players'][0]['x']>before+1)\n   132\t check('touch assisted auto cannon',s['shots']>0)\n   133\t cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]});page.locator('#touchPulse').tap();step(page,.1)\n   134\t check('touch pulse action',snap(page)['pulses']==2)\n   135\t page.locator('#touchMenu').tap();check('touch menu pause',snap(page)['state']=='paused')\n   136\t context.close()\n   137\t\n   138\ttry:\n   139\t with sync_playwright() as p:\n   140\t  browser=p.chromium.launch(headless=True,args=hub.WEBGPU_ARGS)\n   141\t  try:\n   142\t   try:main_tests(browser,p)\n   143\t   except Exception as exc:failures.append('game test execution: '+str(exc))\n   144\t   count,hub_failures=hub.run_hub_tests(browser,base,'/'+game);passed+=count;failures.extend(hub_failures)\n   145\t  finally:browser.close()\n   146\tfinally:\n   147\t server.shutdown();server.server_close()\n   148\t(ROOT/'mission-test.json').write_text(json.dumps(mission,indent=2)+'\\n')\n   149\treport={'passed':passed,'failed':len(failures),'failures':failures}\n   150\t(ROOT/'test-results.json').write_text(json.dumps(report,indent=2)+'\\n')\n   151\tfor f in failures:print('FAIL '+f)\n   152\tprint(f'{passed}/{passed+len(failures)} checks passed')\n   153\traise SystemExit(bool(failures))\n{\n  \"passed\": 77,\n  \"failed\": 1,\n  \"failures\": [\n    \"game test execution: Page.wait_for_function: Timeout 30000ms exceeded.\"\n  ]\n}\n[]\n","exit_code":0,"status":"completed"}}
