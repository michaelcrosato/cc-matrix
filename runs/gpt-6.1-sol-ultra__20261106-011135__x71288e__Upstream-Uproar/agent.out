{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read().replace(\\\"state='playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');\"'$('\"'bossHud').classList.add('hidden');\\\", \\\"mouseX=null;mouseHeld=false;hideTouchStick();state='playing';\"'$('\"'menu').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden');\"'$('\"'bossHud').classList.add('hidden');\\\")\ns=s.replace(\\\"if(new URLSearchParams(location.search).get('test')==='1')Object.assign(window.__UPROAR__,{start:\\\",\\\"if(new URLSearchParams(location.search).get('test')==='1')Object.assign(window.__UPROAR__,{readFrame:async()=>{const target=new THREE.RenderTarget(64,64);renderer.setRenderTarget(target);renderer.render(scene,camera);const bytes=await renderer.readRenderTargetPixelsAsync(target,0,0,64,64);renderer.setRenderTarget(null);target.dispose();const colors=new Set();let nonzero=0;for(let i=0;i<bytes.length;i+=4){colors.add(\"'`${bytes[i]},${bytes[i+1]},${bytes[i+2]}`);if(bytes[i]+bytes[i+1]+bytes[i+2]>0)nonzero++;}return{colors:colors.size,nonzero};},start:\")\nopen(p,'\"'w').write(s)\np='test-game.py';s=open(p).read().replace(\\\"check('Rapier pinned version',\\\", \\\"frame=js(page,'window.__UPROAR__.readFrame()');check('WebGPU rendered pixels',frame['colors']>12 and frame['nonzero']>1000,str(frame))\\\\n check('Rapier pinned version',\\\")\nopen(p,'w').write(s)\nPY\nnode --check main.js\npython3 build.py\n./test.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
