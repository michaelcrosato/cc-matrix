dard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n76:const playMs = Number(params.get('play')) || 6000;\n79:for (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n103:      players: meta('hub:session-players'),\n115: * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n132:    latency: Math.max(0, Number($('latency').value) || 0),\n133:    jitter: Math.max(0, Number($('jitter').value) || 0),\n134:    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n164:    log(`Not loading ${game}: the harness only plays pages from this site.`);\n167:  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n173:  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n187:    players,\n208:  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n254:  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n286:/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\n301:  const players = state.cells.filter((c) => !c.server && !c.gone);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n328:  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n335:    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n349:  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n352:    const name = (id) => s.players[id]?.name ?? `#${id}`;\n374:for (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n378: * synthetic events while the round plays (the frames must be served from this\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n422:    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n424:    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n","exit_code":0,"status":"completed"}}
