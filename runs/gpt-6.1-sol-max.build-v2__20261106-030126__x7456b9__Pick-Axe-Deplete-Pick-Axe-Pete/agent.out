{"type":"item.started","item":{"id":"item_178","type":"command_execution","command":"/bin/bash -lc \"biome check --write tools/verify-background.mjs src/main.js && ruff check tests/input-browser.py && node tools/build.mjs && /home/micha/.local/share/pipx/venvs/playwright/bin/python - <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True)\n try:\n  page=b.new_page()\n  page.add_init_script(\\\"window.probePad={id:'DualSense Wireless Controller',index:0,mapping:'standard',connected:true,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[probePad]\\\")\n  page.goto(Path('index.html').resolve().as_uri());page.wait_for_function('window.__pd');page.evaluate('__pd.game.stop();__pd.game.advance(.02)')\n  page.evaluate('probePad.buttons[9]={pressed:true,touched:true,value:1};__pd.game.advance(.02)')\n  result=page.evaluate('({state:__pd.app.state,screen:__pd.ui.screen,paused:__pd.game.paused})')\n  assert result['screen']=='title' and result['state']=='title',result\n  print('Title Options regression passed')\n finally:b.close()\nPY\nnode tools/verify-background.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
