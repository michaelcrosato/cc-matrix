{"type":"item.completed","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -lc \"sed -n '220,335p' src/input/pilot.js && sed -n '110,225p' src/net/hub.js && rg -n 'redirectQueue|actionKind|redirect' src/sim/mine.js | tail -22 && cat docs/evidence/hub-full-results.json | head -35\"","aggregated_output":"        .sort((a, c) => a.time - c.time);\n      const threat = threats[0];\n      if (\n        threat &&\n        (p.tool === 0 || (network && p.hp <= (P.ROUTES[this.route]?.family === 'heavy' ? 2 : 1))) &&\n        !b.climbing &&\n        b.onGround\n      ) {\n        const height = threat.at.z - b.z;\n        if (height > 23) {\n          input.down = true;\n          input.x = 0;\n        } else if (threat.time < 0.34 + responseLead && m.tick > this.nextJump) {\n          input.down = false;\n          input.jump = input.jumpPressed = true;\n          this.nextJump = m.tick + 53;\n        }\n      }\n      if (b.air && b.vz > 0 && m.tick < this.nextJump - 20) input.jump = true;\n      return input;\n    }\n  }\n  P.Pilot = Pilot;\n})();\n          baseX: a[4],\n          age: a[5],\n          life: a[6],\n          recovered: a[7],\n          reason: a[8],\n          dead: false,\n        }\n      : null;\n  const serial = (id) => Number(String(id).split(':').at(-1));\n\n  const movementState = (b, p) => [\n    milli(b.drop),\n    milli(b.dashing),\n    milli(b._coy),\n    b._cut ? 1 : 0,\n    b._airJ || 0,\n    milli(b.stun),\n    milli(p.jumpQueue),\n  ];\n  function packPlayer(p) {\n    const b = p.body,\n      a = p.action;\n    return [\n      p.id,\n      round(b.x),\n      round(b.z),\n      round(b.vx),\n      round(b.vz),\n      b.facing,\n      bodyMask(b, p),\n      p.hp,\n      p.tool,\n      round(p.invuln),\n      p.pose || null,\n      round(p.poseT),\n      p.actionKind,\n      round(p.aim),\n      round(p.collectT),\n      round(p.jamT),\n      round(p.rescueT),\n      PHASES.indexOf(a.phase),\n      round(a.t),\n      [a.spec.wind, a.spec.active, a.spec.recover],\n      [p.contribution.ore, p.contribution.redirects, p.contribution.rescues, p.contribution.key],\n      b.h,\n      round(b.stun),\n      movementState(b, p),\n    ];\n  }\n  function fullPacket(world, seq, acknowledgements) {\n    return {\n      v: 1,\n      k: 'f',\n      e: world.epoch,\n      s: seq,\n      t: world.tick,\n      a: acknowledgements,\n      w: WORLD.map((k) => (typeof world[k] === 'number' ? round(world[k]) : (world[k] ?? null))),\n      f: [\n        world.finale.wave,\n        world.finale.active,\n        world.finale.cleared,\n        world.finale.startCollisions,\n        round(world.finale.retry),\n      ],\n      p: world.players.map(packPlayer),\n      r: world.rocks.map((r) => [\n        r.id,\n        r.kind,\n        round(r.x),\n        round(r.z),\n        round(r.vx),\n        round(r.vz),\n        r.r,\n        r.hp,\n        round(r.life),\n        round(r.spin),\n        r.redirect,\n        round(r.grace),\n      ]),\n      i: world.pickups.map(itemPack),\n      key: itemPack(world.key),\n      l: world.room.ladders.map((l) => [l.state, round(l.timer), round(l.grace), l.cycle]),\n      d: world.room.doors.map((d) => [round(d.warning), round(d.pulse)]),\n      n: world.warnings.map((w) => [\n        w.id,\n        w.type,\n        w.reward || null,\n        w.tier ?? null,\n        round(w.x),\n        round(w.z),\n        round(w.t),\n        round(w.original),\n        w.door ?? null,\n        w.kind || null,\n      ]),\n      g: STATS.map((k) => world.stats[k] || 0),\n      b: { ...world.tuning },\n      u: { ...world.tutorial },\n      z: { ...world.features },\n      ev: [],\n    };\n  }\n  function motionPacket(world, seq, acknowledgements) {\n    return {\n      v: 1,\n      k: 'm',\n      e: world.epoch,\n      s: seq,\n      t: world.tick,\n      a: acknowledgements,\n      w: [\n        world.status,\n        world.score,\n        world.work,\n        round(world.pressure),\n406:        r.redirect = p.id;\n409:        p.contribution.redirects++;\n410:        this.stats.redirects++;\n412:        this.tutorial.redirect = true;\n413:        this.emit('redirect', {\n470:        redirected: a.redirect !== null || b.redirect !== null,\n530:        return { type: 'redirect', id: rock.id, target: rock, label: 'Redirect', symbol: '↗' };\n928:        if (input.face && (input.chop || input.redirect)) b.facing = input.face;\n958:        p.redirectQueue = Math.max(0, (p.redirectQueue || 0) - dt);\n959:        if (input.redirect && (!p.action.busy || p.actionKind !== 'redirect')) {\n960:          p.redirectQueue = this.tuning.chopCycle + 0.14;\n961:          p.redirectAim = input.aim || (input.up ? 1 : input.down ? -1 : 0);\n962:          if (p.actionKind === 'chop' && p.action.phase === 'wind') p.action.cancel();\n964:        if (p.tool > 0 && !p.action.busy && (p.redirectQueue > 0 || input.chop)) {\n965:          const redirect = p.redirectQueue > 0;\n966:          p.actionKind = redirect ? 'redirect' : 'chop';\n967:          p.aim = redirect ? p.redirectAim : input.aim || (input.up ? 1 : input.down ? -1 : 0);\n968:          p.redirectQueue = 0;\n969:          p.action = redirect\n972:                active: this.tuning.redirectWindow,\n985:          this.emit('swing', { p: p.id, kind: p.actionKind, x: b.x, z: b.z });\n1016:            (Math.abs(a.vx - b.vx) > 30 || a.redirect !== null || b.redirect !== null)\n[\n  {\n    \"case\": \"full online server route 0\",\n    \"timeline\": [\n      {\n        \"wallSeconds\": 0.13,\n        \"title\": \"Pick Axe Deplete\",\n        \"ready\": \"true\",\n        \"online\": true,\n        \"server\": true,\n        \"started\": false,\n        \"ended\": false,\n        \"status\": \"playing\",\n        \"epoch\": 1,\n        \"tick\": 0,\n        \"members\": [\n          0,\n          1\n        ],\n        \"keyOwner\": null,\n        \"score\": 0,\n        \"health\": [\n          3,\n          3\n     