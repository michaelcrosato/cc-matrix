{"type":"item.completed","item":{"id":"item_185","type":"command_execution","command":"/bin/bash -lc \"rg -n 'route =>|const pilot|controls.read|full_expedition' tests/hub-browser.py | head -12 && sed -n '155,183p' tests/hub-browser.py\"","aggregated_output":"142:def full_expedition(browser, base, scenario=\"server\", route=0):\n169:                    \"\"\"route => {\n170:                  const pilot = new PD.Pilot(route);\n171:                  __pd.controls.read = () => pilot.intent(__pd.mine,__pd.mine.players.find(p=>p.id===AIHub.me));\n302:                    full_expedition(browser, base)\n310:                        full_expedition(browser, base)\n    )\n    timeline = []\n    next_progress = 0\n    try:\n        page.goto(f\"{base}/{DEV.name}/vendor/hub/harness.html?{query}\")\n        page.wait_for_function(\n            'document.querySelectorAll(\"iframe\").length === 3', timeout=10000\n        )\n        for frame in page.frames[1:]:\n            frame.wait_for_function(\n                \"window.__pd && document.body.dataset.ready === 'true'\", timeout=15000\n            )\n            if not frame.evaluate(\"AIHub.server\"):\n                frame.evaluate(\n                    \"\"\"route => {\n                  const pilot = new PD.Pilot(route);\n                  __pd.controls.read = () => pilot.intent(__pd.mine,__pd.mine.players.find(p=>p.id===AIHub.me));\n                }\"\"\",\n                    route,\n                )\n        page.locator(\"#release\").click()\n        started = time.monotonic()\n        while time.monotonic() - started < 720:\n            rows = inspect_frames(page)\n            hosts = [r for r in rows if r[\"network\"][\"host\"]]\n            if hosts:\n                host = hosts[0]\n                if time.monotonic() > next_progress:\n                    next_progress = time.monotonic() + 5\n","exit_code":0,"status":"completed"}}
