{"type":"item.completed","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"rg -n 'E.mix|mix\\\\(' vendor/engine/API-INDEX.md | head -8 && cat docs/evidence/hub-progress.json\"","aggregated_output":"169:- `E.mix(h1, h2, t)`: the color t of the way from h1 to h2 ('#rrggbb')\n{\"case\": \"full online server route 0\", \"wallSeconds\": 16.65, \"title\": \"Pick Axe Deplete\", \"ready\": \"true\", \"online\": true, \"server\": true, \"started\": true, \"ended\": false, \"status\": \"playing\", \"epoch\": 1, \"tick\": 1643, \"members\": [0, 1], \"keyOwner\": null, \"score\": 0, \"health\": [2, 2], \"errors\": [], \"network\": {\"sent\": 137, \"received\": 254, \"dropped\": 0, \"rejected\": 4, \"maxBytes\": 1548, \"maxUnreliableBytes\": 271, \"full\": 35, \"motion\": 102, \"inputs\": 0, \"finishCalls\": 0, \"maxPerSecond\": 10, \"clock\": 13.69, \"epoch\": 1, \"host\": true, \"server\": true, \"ended\": false, \"finished\": false, \"members\": [0, 1], \"peers\": [0, 1], \"pendingEvents\": 3, \"inputEdges\": [0, 0, 0], \"inputAcks\": [0, 0, 0], \"fullSeq\": -1, \"motionSeq\": -1, \"authorityTick\": 1643}, \"audio\": null}","exit_code":0,"status":"completed"}}
