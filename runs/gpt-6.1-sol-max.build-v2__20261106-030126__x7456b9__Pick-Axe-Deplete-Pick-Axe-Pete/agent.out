{"type":"item.completed","item":{"id":"item_171","type":"command_execution","command":"/bin/bash -lc \"sed -n '326,351p' tests/input-browser.py && sed -n '528,561p' tests/input-browser.py && cat docs/evidence/hub-progress.json\"","aggregated_output":"def pads_and_menus(s, page, errors):\n    def pad_title():\n        tap_pad(page, 13)\n        s.ok(\n            page.evaluate(\n                '__pd.game.input.padIndex===0 && __pd.game.input.lastDevice===\"gamepad\"'\n            ),\n            \"Pad not assigned to P1\",\n        )\n        s.ok(\n            page.evaluate('__pd.game.input.label(\"jump\")===\"✕\"'),\n            \"Default controller glyph is not PlayStation\",\n        )\n        pad_choose(page, \"Chamber practice\")\n        s.ok(page.evaluate(\"__pd.ui.screen\") == \"practice\", \"Pad did not open practice\")\n        pad_choose(page, \"03 · The Motherload\")\n        s.ok(\n            page.evaluate(\"__pd.mine.chamber===2 && __pd.mine.practice\"),\n            \"Pad could not launch third chamber practice\",\n        )\n\n    s.check(\"standard-mapping pad title and practice\", pad_title)\n\n    def pad_options():\n        tap_pad(page, 9)\n        s.ok(page.evaluate(\"__pd.ui.screen\") == \"pause\", \"Options did not open pause\")\n    def results():\n        page.evaluate(\"__pd.title();__pd.start()\")\n        result = page.evaluate(\"__pd.script(0,900)\")\n        s.ok(\n            result[\"status\"] == \"victory\"\n            and page.evaluate(\"__pd.ui.screen\") == \"results\",\n            \"Browser canonical normal-input expedition did not reach results\",\n        )\n        for feature in [\n            \"break\",\n            \"pick\",\n            \"key\",\n            \"door\",\n            \"redirect\",\n            \"waveClear\",\n            \"victory\",\n        ]:\n            s.ok(\n                result[\"features\"].get(feature, 0) > 0,\n                f\"Full browser expedition omitted {feature}\",\n            )\n        pad_choose(page, \"Chamber practice\")\n        tap_pad(page, 1)\n        pad_choose(page, \"Another spectacular payday\")\n        s.ok(\n            page.evaluate(\n                '__pd.app.state===\"play\" && __pd.mine.chamber===0 && __pd.mine.score===0'\n            ),\n            \"Pad replay did not start clean\",\n        )\n\n    s.check(\"browser normal-input expedition, results and pad replay\", results)\n\n    def local_coop_start_and_leave():\n{\"case\": \"full online server route 0\", \"wallSeconds\": 185.8, \"title\": \"Pick Axe Deplete\", \"ready\": \"true\", \"online\": true, \"server\": true, \"started\": true, \"ended\": false, \"status\": \"playing\", \"epoch\": 2, \"tick\": 16964, \"members\": [0, 1], \"keyOwner\": null, \"score\": 222, \"health\": [1, 1], \"errors\": [], \"network\": {\"sent\": 1414, \"received\": 2571, \"dropped\": 0, \"rejected\": 62, \"maxBytes\": 2651, \"maxUnreliableBytes\": 466, \"full\": 364, \"motion\": 1050, \"inputs\": 0, \"finishCalls\": 0, \"maxPerSecond\": 10, \"clock\": 141.37, \"epoch\": 2, \"host\": true, \"server\": true, \"ended\": false, \"finished\": false, \"members\": [0, 1], \"peers\": [1, 0], \"pendingEvents\": 2, \"predictionFrames\": 0, \"predictionCorrections\": 0, \"predictionError\": 0, \"inputEdges\": [0, 0, 0], \"inputAcks\": [0, 0, 0], \"fullSeq\": -1, \"motionSeq\": -1, \"authorityTick\": 16964}, \"audio\": null}","exit_code":0,"status":"completed"}}
