    shape('helmet','Prospector hardhat with bright headlamp',[\n      cyl('gold',[0,0,0],5.2,1.3,{seg:10}),\n      ['ball','amber',[0,0,2],4.4,{sz:.6}],\n      cyl('iron',[0,4.4,1.4],2,1,{rot:[90,0,0],seg:8}),\n      cyl('glowGold',[0,5.2,1.4],1.3,.8,{rot:[90,0,0],seg:8}),\n    ]);\n    shape('rescue','Large dropped hardhat marker; crossed rescue struts',[\n      ['use',A.helmet,[0,0,0]],box('glowRose',[0,0,12],[2,2,10]),\n      box('glowRose',[0,0,16],[10,2,2]),\n    ],{lights:[[0,0,13,'#ffbcce',40]]});\n    shape('lamp','Protected hanging brass worklight with bright square glass',[\n      cyl('iron',[0,0,0],3.5,1.5,{seg:6}),box('glowGold',[0,0,1.5],[4,4,6]),\n      box('iron',[-2.5,0,1],[1,5,7]),box('iron',[2.5,0,1],[1,5,7]),\n      cyl('gold',[0,0,8],4,2,{seg:6,r2:2}),box('iron',[0,0,9],[1,1,4]),\n    ],{lights:[[0,0,5,'#ffc36b',64]]});\n    shape('timber','Iron-capped timber shore, natural knots and side brace',[\n      box('oak',[0,0,0],[6,7,42]),box('iron',[0,0,3],[7,8,3]),\n      box('iron',[0,0,35],[7,8,3]),box('wood',[6,0,31],[19,6,4],{rot:[0,-35,0]}),\n      box('gold',[0,4.4,5],[2,1,2]),box('gold',[0,4.4,37],[2,1,2]),\n    ]);\n    shape('ladderTop','Riveted ladder cap; amber hourglass timing mark',[\n      box('iron',[0,0,0],[14,4,4]),box('gold',[-5,2,1],[2,1,2]),box('gold',[5,2,1],[2,1,2]),\n      prism('glowGold',[0,3,0],[[-2,3],[2,3],[-2,0],[2,0]],1),\n    ]);\n    shape('wheel','Heavy six-spoke ore machine flywheel',[\n      cyl('iron',[0,0,12],12,3,{rot:[90,0,0],seg:12}),\n      cyl('void',[0,2,12],9,3,{rot:[90,0,0],seg:12}),\n      ...Array.from({length:6},(_,i)=>{const a=i*Math.PI/3,c=Math.cos(a),s=Math.sin(a);return prism('amber',[0,4,12],[[s*.7,-c*.7],[c*9+s*.7,s*9-c*.7],[c*9-s*.7,s*9+c*.7],[-s*.7,c*.7]],1.4);}),\n      cyl('gold',[0,4,12],3,3,{rot:[90,0,0],seg:8}),\n    ]);\n    shape('extractor','Mine-wide extraction head: twin pistons, brass flywheel and beacon',[\n      box('dark',[0,0,0],[58,12,6]),box('iron',[-23,0,3],[8,10,37]),box('iron',[23,0,3],[8,10,37]),\n      box('amber',[0,0,34],[64,11,7]),box('steel',[-23,0,9],[3,12,20]),box('steel',[23,0,9],[3,12,20]),\n      box('iron',[0,1,10],[27,10,23]), ['use',A.wheel,[0,5,11],{scale:.66}],\n      box('gold',[0,0,39],[18,10,4]),box('glowGold',[0,0,43],[10,8,5]),\n      box('dark',[0,5,29],[20,1,3]),box('glowRose',[-7,5.7,30],[3,1,1]),\n      box('glowCyan',[0,5.7,30],[3,1,1]),box('glowGold',[7,5.7,30],[3,1,1]),\n    ],{lights:[[0,0,45,'#ffc85e',90]]});\n    shape('oreCart','Iron mine cart heaped with native ore and a warm gold seam',[\n      ['use','cart',[0,0,0],{mats:{w:'PD:wood',m:'PD:iron'}}],\n      ['use',A.ore,[-5,0,10],{scale:.65}],['use',A.ore,[4,0,11],{scale:.7}],\n    ]);\n    registerHat('PD:helmet',false);\n    registerHat('PD:twinHelmet',true);\n    E.Humanoid.weapon('PD:pickaxe',{\n      length: 13.5, rest: [.45,.08,-.9], blade: true,\n359:- `E.font`: Pixel fonts. 'normal' (default) is a 5x7 proportional font with lower case; 'tiny' is the 3x5 upper-case font. text(g, str, x, y, color, opts) where opts is an outline color, false, or { f [... omitted end of long line]\n363:- `E.font.text(g, s, x, y, color = '#ffffff', o = '#0b0814')`: draw text at (x, y) (its top-left; align: 'center' or 'right' moves it) in color. o: an outline color, or { outline, shadow, gradient, sc [... omitted end of long line]\n396:- `game.particles.glints(x, y, z, n = 5, color = '#fff6c0', spread = 10)`: twinkling star glints for magic, treasure and pickups\n400:- `game.particles.sparks(x, y, z, n, dir = null, o = {})`: n bright sparks thrown from (x, y, z), every way or around angle dir (radians). o: { color, speed }\n401:- `game.particles.text(x, y, z, text, color = '#fff2c4', o = {})`: floating number or word: text(x, y, z, '12', color, { scale: 2, bounce: true }) (bounce: lands and holds, Final Fantasy style)\n441:- `r.text(str, x, y, color = '#ffffff', o)`: HUD text in screen pixels, drawn on top and never lit: r.text('SCORE 120', 4, 4, '#fff', { align, scale, outline })\n662:    this.resize();\n663:    if (canvas) addEventListener('resize', () => this.resize(), { signal });\n678:  resize() {\n700:  setOptions(o) { Object.assign(this._o, o); this.resize(); }\n702:  setScale(v) { this.scale = v === 'sharp' || v === 'fill' ? v : 'auto'; this.resize(); }\n","exit_code":0,"status":"completed"}}
