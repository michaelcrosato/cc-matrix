{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {load} from './tools/load.mjs';const P=load();\nfor (const route of [0,1,2]) { const m=new P.Mine({route}); const bot=new P.Pilot(route); let last=-1;\nfor(let n=0;n<120*880&&m.status\"'!=='\"'victory'&&m.status\"'!=='\"'failure';n++){m.step({0:bot.intent(m)});if(m.chamber\"'!==last){last=m.chamber;console.log(route,'\"'chamber',last,'at',m.time.toFixed(1));}}\nconsole.log(route,m.status,m.time.toFixed(1),m.score,m.stats,m.work,m.finale,m.players.map(p=>({x:p.body.x,z:p.body.z,hp:p.hp,tool:p.tool,climb:p.body.climbing})),bot.target);\n}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
