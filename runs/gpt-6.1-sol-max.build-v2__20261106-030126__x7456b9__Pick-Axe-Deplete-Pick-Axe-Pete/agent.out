{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';import {load} from './tools/load.mjs';const P=load();const m=new P.Mine({roster:[{id:0},{id:1}]});for(let n=0;n<200;n++)m.step({0:{x:1,jump:n<40,jumpPressed:n===1},1:{up:true}});const restored=P.Mine.restore(m.snapshot());for(let n=0;n<120;n++){m.step({0:{chop:true},1:{up:true}});restored.step({0:{chop:true},1:{up:true}})}try{assert.deepEqual(m.snapshot(),restored.snapshot());console.log('equal')}catch(e){console.log(e.message.slice(0,5000))}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
