{"type":"item.completed","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"head -38 tests/network-unit.mjs && head -35 tests/sim.test.mjs && sed -n '720,785p' src/audio/audio.js && cat docs/evidence/hub-progress.json\"","aggregated_output":"import assert from \"node:assert/strict\";\nimport { pathToFileURL } from \"node:url\";\nimport { load } from \"../tools/load.mjs\";\n\nconst P = load([\n\t\"vendor/engine/my-3d2dge.js\",\n\t\"src/content/content.js\",\n\t\"src/sim/mine.js\",\n\t\"src/input/pilot.js\",\n\t\"src/net/hub.js\",\n]);\n\nfunction mesh({ server = false, latency = 0, jitter = 0, loss = 0, seed = 73082 } = {}) {\n\tconst players = [\n\t\t{ id: 0, name: \"<Pete>\", color: \"#e8443a\" },\n\t\t{ id: 1, name: \"Polly\", color: \"#3b82f6\" },\n\t];\n\tconst host = server ? 99 : 0,\n\t\tids = server ? [99, 0, 1] : [0, 1];\n\tconst links = new Map(),\n\t\thubs = new Map(),\n\t\tpending = [],\n\t\tsent = [],\n\t\tresults = [];\n\tlet time = 0,\n\t\tunreliable = 0;\n\tconst faults = new P.Random(8473), ordered = new Map();\n\tfor (const id of ids) {\n\t\tconst handlers = new Map();\n\t\tconst hub = {\n\t\t\tme: id,\n\t\t\thost,\n\t\t\tserver: id === 99,\n\t\t\tisHost: id === host,\n\t\t\tseed: 73082,\n\t\t\tplayers,\n\t\t\ttime: () => time * 1000,\n\t\t\trng: () => {\nimport assert from \"node:assert/strict\";\nimport { load } from \"../tools/load.mjs\";\n\n/** Quiet deterministic tests; the aggregate runner owns reporting. */\nexport async function runSimulationTests() {\n\tconst P = globalThis.PD || load();\n\tconst E = globalThis.My3D2dge;\n\tconst failures = [];\n\tlet count = 0;\n\tconst test = (name, fn) => {\n\t\tcount++;\n\t\ttry {\n\t\t\tfn();\n\t\t} catch (error) {\n\t\t\tfailures.push(`${name}: ${error.message}`);\n\t\t}\n\t};\n\tconst approx = (value, target, tolerance = 0.01) =>\n\t\tassert.ok(\n\t\t\tMath.abs(value - target) <= tolerance,\n\t\t\t`expected ${value} near ${target} ±${tolerance}`,\n\t\t);\n\tconst advance = (m, seconds, intents = {}) => {\n\t\tconst ticks = Math.ceil(seconds / P.STEP);\n\t\tfor (let i = 0; i < ticks; i++)\n\t\t\tm.step(typeof intents === \"function\" ? intents(i, m) : intents);\n\t};\n\tconst fresh = (options = {}) => {\n\t\tconst m = new P.Mine(options);\n\t\tm.relief = 0;\n\t\tm.nextSpawn = m.nextPair = 1e6;\n\t\tm.step();\n\t\tm.step();\n\t\tm.takeEvents();\n\t\treturn m;\n\t\t\tif (this.elapsed - (this.cooldowns.get(sound) ?? -10) < cooldown)\n\t\t\t\treturn false;\n\t\t\tthis.cooldowns.set(sound, this.elapsed);\n\t\t\tconst pan = Number.isFinite(event.x)\n\t\t\t\t? clamp((event.x / 480) * 2 - 1, -0.8, 0.8)\n\t\t\t\t: 0;\n\t\t\tconst handle = native.sfx(`pd:${sound}`, { pan, vary: 0.018 });\n\t\t\tif (handle?.playing)\n\t\t\t\tthis.effects.push({ handle, end: native.ctx.currentTime + 1.2 });\n\t\t\tif ([\"break\", \"hurt\", \"down\", \"jam\"].includes(type))\n\t\t\t\tthis._babble(\"alarm\", event.p);\n\t\t\tif (\n\t\t\t\t[\"pick\", \"key\", \"rescue\", \"door\", \"entry\", \"waveClear\"].includes(type)\n\t\t\t)\n\t\t\t\tthis._babble(\n\t\t\t\t\t[\"door\", \"entry\"].includes(type) ? \"boast\" : \"delight\",\n\t\t\t\t\tevent.p,\n\t\t\t\t);\n\t\t\treturn !!handle?.playing;\n\t\t}\n\n\t\tstop() {\n\t\t\tif (this.disposed) return;\n\t\t\tthis.stopped = true;\n\t\t\tthis.songKey = null;\n\t\t\tconst n = this.native;\n\t\t\tn.muted = true;\n\t\t\tn.applyVolume();\n\t\t\tfor (const { handle } of this.effects) handle.stop(0);\n\t\t\tthis.effects.length = 0;\n\t\t\tfor (const entry of this.sources) {\n\t\t\t\ttry {\n\t\t\t\t\tentry.source.stop();\n\t\t\t\t\tentry.source.disconnect();\n\t\t\t\t\tfor (const node of entry.nodes) node.disconnect();\n\t\t\t\t} catch (_) {}\n\t\t\t}\n\t\t\tthis.sources.clear();\n\t\t\t// The public stop stops the current score; draining its native crossfade/sting\n\t\t\t// lists makes the engine's scheduler unable to schedule another source at end.\n\t\t\tn.stopMusic(0);\n\t\t\tfor (const song of [...(n._fading || []), ...(n._stings || [])]) {\n\t\t\t\tif (song.bus)\n\t\t\t\t\ttry {\n\t\t\t\t\t\tsong.bus.disconnect();\n\t\t\t\t\t} catch (_) {}\n\t\t\t}\n\t\t\tif (n._fading) n._fading.length = 0;\n\t\t\tif (n._stings) n._stings.length = 0;\n\t\t\tif (n._timer) {\n\t\t\t\tclearInterval(n._timer);\n\t\t\t\tn._timer = null;\n\t\t\t}\n\t\t\tthis.cooldowns.clear();\n\t\t\tthis.seen.clear();\n\t\t\tthis.seenOrder.length = 0;\n\t\t}\n\n\t\tdispose() {\n\t\t\tif (this.disposed) return;\n\t\t\tthis.stop();\n\t\t\tthis.disposed = true;\n\t\t\tthis.awakened = false;\n\t\t}\n\n\t\tdiagnostics() {\n{\"case\": \"full online server route 0\", \"wallSeconds\": 37.68, \"title\": \"Pick Axe Deplete\", \"ready\": \"true\", \"online\": true, \"server\": true, \"started\": true, \"ended\": false, \"status\": \"playing\", \"epoch\": 1, \"tick\": 3987, \"members\": [0, 1], \"keyOwner\": null, \"score\": 21, \"health\": [0, 1], \"errors\": [], \"network\": {\"sent\": 333, \"received\": 624, \"dropped\": 0, \"rejected\": 5, \"maxBytes\": 2183, \"maxUnreliableBytes\": 386, \"full\": 85, \"motion\": 248, \"inputs\": 0, \"finishCalls\": 0, \"maxPerSecond\": 10, \"clock\": 33.22, \"epoch\": 1, \"host\": true, \"server\": true, \"ended\": false, \"finished\": false, \"members\": [0, 1], \"peers\": [0, 1], \"pendingEvents\": 0, \"inputEdges\": [0, 0, 0], \"inputAcks\": [0, 0, 0], \"fullSeq\": -1, \"motionSeq\": -1, \"authorityTick\": 3987}, \"audio\": null}","exit_code":0,"status":"completed"}}
