{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"sed -n '9650,9700p' vendor/engine/my-3d2dge.js && sed -n '378,490p' vendor/hub/harness.html\"","aggregated_output":"      P.forEach((q, k) => { const b = this._el('button', k === (this._pl || 0) ? 'pri' : '', 'Player ' + (k + 1) + (q.device === 'gamepad' ? ' (controller)' : q.half ? ' (' + q.half + ' keys)' : '')); b.onclick = () => { this._pl = k; this._capEnd(''); this._render(); }; row.appendChild(b); });\n      add(row);\n    }\n    add(this._el('p', 'esh-m', 'Choose a key or button, then press the new one. The arrow keys, the d-pad, Enter and Escape always work in menus.'), st);\n    const S = this._game.settings, coarse = window.matchMedia && matchMedia('(any-pointer: coarse)').matches, touch = I._touchArgs && (coarse || I._touched || S.touch === 'on');\n    const touchRows = () => { add(this._el('div', 'esh-k esh-sec', 'Touch')); for (const k of S.keys('Touch')) add(this._row(k)); }, first = touch && I.lastDevice === 'touch';\n    if (first) touchRows();   // (a phone in hand: its buttons first)\n    const grid = this._el('div', 'esh-bind'); grid.append(this._el('span'), this._el('small', '', 'Keyboard'), this._el('small', '', 'Controller'));\n    for (const a of Object.keys(I.map).filter(a => I.rebindable(a))) {\n      const name = typeof names[a] === 'string' ? names[a] : actionName(a); grid.appendChild(this._el('span', '', name));\n      for (const d of ['keys', 'pad']) {\n        const codes = I.map[a].filter(c => !c.startsWith('Act:') && !c.startsWith('PadAxis') && padCode(c) === (d === 'pad')), cap = this._cap && this._cap.a === a && this._cap.device === d;\n        const b = this._el('button', cap ? 'cap' : '', cap ? 'Press…' : codes.map(c => I.codeLabel(c)).join(' / ') || '—');\n        b.setAttribute('aria-label', name + ', ' + (d === 'pad' ? 'controller' : 'keyboard') + ': ' + (codes.map(c => I.codeLabel(c)).join(', ') || 'none'));\n        b.onclick = () => this._capStart(a, d, name); grid.appendChild(b);\n      }\n    }\n    add(grid);\n    const pad = I.padId ? 'Controller: ' + I.padId.replace(/\\s*\\(.*$/, '') : 'No controller found: press a button on one to connect it.';\n    add(this._el('div', 'esh-k esh-sec', 'Controller'), this._el('p', 'esh-m', pad));\n    for (const k of S.keys('Controller')) add(this._row(k));\n    if (touch && !first) touchRows();\n  }\n  _capStart(a, device, name) {\n    const CI = this._ctlI(); this._cap = { a, device, name, prev: CI.padPrev.slice(), prevR: RSTICK.filter(k => CI.held.has(k)) };\n    this._status = device === 'pad' ? 'Press a controller button for ' + name + ' (Start cancels).' : 'Press a key or mouse button for ' + name + ' (Escape cancels).';\n    this._render();\n  }\n  _capBind(code) {\n    const c = this._cap; if (!c) return;\n    const I = this._ctlI(), r = I.rebind(c.a, c.device, code), names = I.names || {}, nm = a => typeof names[a] === 'string' ? names[a] : actionName(a);\n    if (r === 'reserved') { this._status = I.codeLabel(code) + ' is kept for the menus. Choose another, or press Escape.'; this._render(); return; }\n    if (r) { this._status = I.codeLabel(code) + ' is already ' + nm(r) + '. Rebind ' + nm(r) + ' first, or choose another.'; this._render(); return; }\n    this._capEnd(nm(c.a) + ': ' + I.codeLabel(code) + '. Saved.');\n  }\n  /** stop listening for a new binding (msg: what the status line says) */\n  _capEnd(msg) { if (!this._cap) { if (msg !== undefined) this._status = msg; return; } this._cap = null; this._status = msg || ''; this._ctlI().clear(); this._render(); }\n  /** a button: [label, fn] or { label, fn, act, primary, disabled } */\n  _btn(a, i, pri = true) {\n    const b = Array.isArray(a) ? { label: a[0], fn: a[1] } : a, e = this._el('button', b.primary || (b.primary === undefined && i === 0 && pri) ? 'pri' : '', b.label);\n    e.disabled = !!b.disabled;\n    if (b.down) {   // (a press, timed: the event's own time, not the click's after the finger lifts)\n      e.onpointerdown = ev => { ev.preventDefault(); b.down(ev.timeStamp); };\n      e.onkeydown = ev => { if ((ev.key === ' ' || ev.key === 'Enter') && !ev.repeat) { ev.preventDefault(); b.down(ev.timeStamp); } };\n    } else e.onclick = () => { if (b.fn) b.fn(); else if (b.act) { this._game.input.tap(b.act); this._held.add(b.act); } };\n    return e;\n  }\n  /** the audio offset's calibration screen: clicks on the beat, a Tap button (or Space) on each one heard; after eight\n   *  the offset found, kept with Keep it */\n  _calibrate(key) {\n    const K = this._game.audio.calibrate(), close = () => { K.stop(); this.back(); };\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,85p' vendor/hub/harness.html && tail -35 vendor/hub/harness.html && sed -n '490,595p' vendor/hub/harness.html && sed -n '145,178p' vendor/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,85p' vendor/hub/harness.html && tail -35 vendor/hub/harness.html && sed -n '490,595p' vendor/hub/harness.html && sed -n '145,178p' vendor/hub/harness.html\"","aggregated_output":"const params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,59p' vendor/hub/harness.html && sed -n '208,270p' vendor/hub/harness.html && sed -n '309,378p' vendor/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,59p' vendor/hub/harness.html && sed -n '208,270p' vendor/hub/harness.html && sed -n '309,378p' vendor/hub/harness.html\"","aggregated_output":"  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n  for (const cell of current.cells) removeCell(cell, false);\n  current.hubEnd.close();\n  current = null;\n}\n\nfunction removeCell(cell, tellRound = true) {\n  if (cell.gone) return;\n  cell.gone = true;\n  cell.detach();\n  cell.endpoint.close();\n  cell.frame.remove();\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n    if (p.out) bits.push(`out: ${p.out}`);\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n    else if (p.ready) bits.push('ready');\n    else if (p.hello) bits.push('welcomed');\n    else bits.push('loading');\n    const last = cell.progress.at(-1);\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n  }\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n  if (state.record) {\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,95p' vendor/hub-repo/scripts/lib/hub-client.mjs && rg -n 'class HubLink|constructor\\\\(|intents\\\\(|update\\\\(|onView' src/net/hub.js | head -16 && sed -n '400,455p' src/net/hub.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,95p' vendor/hub-repo/scripts/lib/hub-client.mjs && rg -n 'class HubLink|constructor\\\\(|intents\\\\(|update\\\\(|onView' src/net/hub.js | head -16 && sed -n '400,455p' src/net/hub.js\"","aggregated_output":"/**\n * hub-client.mjs — the session client pasted into games, found, checked and\n * upgraded without a model.\n *\n * Every session game pastes lib/hub/session.js unmodified (lib/hub/README.md,\n * \"Parallel\"). A pasted copy runs from its banner, `/*! aihub-session\n * X.Y.Z`, to the client's last line. It is pristine when its text is, line\n * endings aside, exactly a released client: RELEASES holds each one's\n * SHA-256. Only a pristine copy is ever replaced, so a client someone edited\n * is reported and left alone, never overwritten.\n */\n\nimport { createHash } from 'node:crypto';\n\n/** SHA-256 of each released client, banner to last line, with LF line endings. */\nexport const RELEASES = Object.freeze({\n  '1.0.0': '6fc9b691a78c237944ba0e972f506079e9906fbcc6b83e3d6acb8e832f88bb19',\n  '1.1.0': '6625a3a55ed0380baf268d593dd24e85f6c49fcd00d524fc308ae0fd4b484272',\n  '1.2.0': '2d6e9bd677210500e7683deaa88dace3f70b28295f85b0525a1811b2bc9bd088',\n  '1.3.0': '32ed0ff62e4e0880bc78db850a0cff8dd7c9277d34ef76cafc60d535d41761db',\n  '1.4.0': '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a',\n});\n\nconst BANNER = '/*! aihub-session ';\nexport const CLIENT_END = \"})(typeof window !== 'undefined' ? window : globalThis);\";\n\nconst sha256 = (text) => createHash('sha256').update(text).digest('hex');\nconst lf = (text) => text.replace(/\\r\\n/g, '\\n');\n\n/** Compare dotted versions: negative when a is older than b. */\nexport function compareVersions(a, b) {\n  const pa = String(a).split('.').map(Number);\n  const pb = String(b).split('.').map(Number);\n  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {\n    const d = (pa[i] || 0) - (pb[i] || 0);\n    if (d) return d;\n  }\n  return 0;\n}\n\n/**\n * Every pasted client in a page or script: where it sits, the version its\n * banner names, and whether it is exactly that release.\n */\nexport function findClients(text) {\n  const out = [];\n  let from = 0;\n  for (;;) {\n    const start = text.indexOf(BANNER, from);\n    if (start === -1) break;\n    const close = text.indexOf(CLIENT_END, start);\n    const version = text.slice(start + BANNER.length).match(/^\\d+\\.\\d+\\.\\d+/)?.[0] ?? null;\n    if (close === -1) {\n      out.push({ start, end: text.length, version, pristine: false, complete: false });\n      break;\n    }\n    const end = close + CLIENT_END.length;\n    const hash = sha256(lf(text.slice(start, end)));\n    out.push({ start, end, version, pristine: !!version && RELEASES[version] === hash, complete: true, hash });\n    from = end;\n  }\n  return out;\n}\n\n/** The released client's version and the hash a pasted copy of it must have. */\nexport function describeClient(source) {\n  const [found] = findClients(source);\n  if (!found?.complete || !found.version) throw new Error('lib/hub/session.js has no banner or no last line');\n  return { version: found.version, hash: found.hash, text: lf(source.slice(found.start, found.end)) };\n}\n\n/**\n * Replace every pristine client older than `current` with it, keeping the\n * file's own line endings. Returns the new text and what happened to each copy.\n */\nexport function upgradeText(text, current) {\n  const copies = findClients(text);\n  const crlf = text.includes('\\r\\n');\n  const replacement = crlf ? current.text.replace(/\\n/g, '\\r\\n') : current.text;\n  let out = '';\n  let at = 0;\n  const report = [];\n  for (const copy of copies) {\n    let action = 'kept';\n    if (!copy.complete || !copy.pristine) action = 'edited';\n    else if (compareVersions(copy.version, current.version) < 0) action = 'upgraded';\n    else if (compareVersions(copy.version, current.version) > 0) action = 'newer';\n    report.push({ version: copy.version, action });\n    if (action !== 'upgraded') continue;\n    out += text.slice(at, copy.start) + replacement;\n    at = copy.end;\n  }\n  out += text.slice(at);\n  return { text: out, copies: report, changed: report.some((r) => r.action === 'upgraded') };\n}\n284:\tclass HubLink {\n285:\t\tconstructor(hub, worldOrNull, options = {}) {\n299:\t\t\tthis.onView = options.onView || (() => {});\n395:\t\tintents(localIntent) {\n422:\t\tupdate(dt, localIntent = P.neutral()) {\n887:\t\t\tthis.onView(view);\n980:\t\t\t\tthis.onView(view);\n\t\t\t\toutput[this.hub.me] = this.epochFence\n\t\t\t\t\t? P.neutral()\n\t\t\t\t\t: P.canonical(localIntent);\n\t\t\tthis.epochFence = false;\n\t\t\tfor (const id of this.members) {\n\t\t\t\tif (!this.server && id === this.hub.me) continue;\n\t\t\t\tconst remote = this.remotes.get(id);\n\t\t\t\tif (!remote || this.clock - remote.at > SILENCE) {\n\t\t\t\t\toutput[id] = P.neutral();\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tconst intent = { ...remote.intent };\n\t\t\t\tintent.jumpPressed = remote.pending[0] > 0;\n\t\t\t\tintent.redirect = remote.pending[1] > 0;\n\t\t\t\tintent.interactPressed = remote.pending[2] > 0;\n\t\t\t\tfor (let i = 0; i < 3; i++)\n\t\t\t\t\tif (remote.pending[i] > 0) remote.pending[i]--;\n\t\t\t\toutput[id] = intent;\n\t\t\t}\n\t\t\treturn output;\n\t\t}\n\n\t\tupdate(dt, localIntent = P.neutral()) {\n\t\t\tif (!this._running()) return;\n\t\t\tthis.clock += Math.max(0, Math.min(Number(dt) || 0, 0.1));\n\t\t\tif (this.isHost) this._changeEpoch(this.world.epoch);\n\t\t\telse {\n\t\t\t\tconst raw = P.canonical(localIntent);\n\t\t\t\tconst edges = [raw.jumpPressed, raw.redirect, raw.interactPressed];\n\t\t\t\tfor (let i = 0; i < 3; i++)\n\t\t\t\t\tif (edges[i] && !this.edgeLatch[i]) this.outEdges[i]++;\n\t\t\t\tthis.edgeLatch = edges;\n\t\t\t\tthis.lastRaw = raw;\n\t\t\t\tif (this.epochFence) {\n\t\t\t\t\tthis.lastRaw = P.neutral();\n\t\t\t\t\tthis.epochFence = false;\n\t\t\t\t}\n\t\t\t\tthis._interpolate(dt);\n\t\t\t}\n\t\t\tif (this.clock + 1e-8 < this.nextSend) return;\n\t\t\tthis.nextSend = this.clock + SEND_INTERVAL;\n\t\t\tif (this.isHost) this._publishSlot();\n\t\t\telse\n\t\t\t\tthis._send(\n\t\t\t\t\t{\n\t\t\t\t\t\tv: 1,\n\t\t\t\t\t\tk: \"i\",\n\t\t\t\t\t\te: this.epoch,\n\t\t\t\t\t\ts: ++this.inputSeq,\n\t\t\t\t\t\th: [\n\t\t\t\t\t\t\tMath.round(this.lastRaw.x * 100),\n\t\t\t\t\t\t\tholdMask(this.lastRaw),\n\t\t\t\t\t\t\tMath.round(this.lastRaw.aim * 100),\n\t\t\t\t\t\t\tthis.lastRaw.face || 0,\n\t\t\t\t\t\t],\n\t\t\t\t\t\tc: [...this.outEdges],\n","exit_code":0,"status":"completed"}}
