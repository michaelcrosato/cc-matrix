{"type":"item.started","item":{"id":"item_192","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,json\nhere=Path.cwd().resolve();rows=[]\nfor p in Path('/proc').iterdir():\n if not p.name.isdigit():continue\n try:\n  if (p/'cwd').resolve()\"'!=here:continue\n  if int(p.name)==os.getpid():continue\n  command=(p/'\"'cmdline').read_bytes().replace(b'\\\\x00',b' ').decode(errors='replace')\n  if 'python3 - ' in command or command.startswith('/bin/bash -lc python3 -'):continue\n  rows.append({'pid':int(p.name),'command':command[:200]})\n except (FileNotFoundError,PermissionError,ProcessLookupError):pass\nprint(json.dumps({'remainingOwnedRuntimeProcesses':rows}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
