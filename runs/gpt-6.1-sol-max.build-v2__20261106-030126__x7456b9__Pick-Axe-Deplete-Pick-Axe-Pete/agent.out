th.round(u * .6)), gap);\n  PD.updateMinerRig = function updateMinerRig(rig,miner,dt) {\n    const b=miner.body;\n    const tool=typeof miner.tool==='number'?miner.tool:miner.tool?.durability??6;\n    rig._pdWear=tool;rig.o.weapon=tool>0&&!miner.down?'PD:pickaxe':null;\n    let pose=miner.pose;\n    if(pose && !E.Humanoid.poses[pose] && E.Humanoid.poses[`PD:${pose}`])pose=`PD:${pose}`;\n    if(miner.down)pose='die';\n    else if(miner.jamT>0)pose='PD:jam';\n    else if(miner.rescueT>0)pose='PD:rescue';\n    else if(miner.collectT>0)pose='PD:collect';\n    else if(!pose&&tool===0&&!b.air&&!b.climbing)pose='PD:unarmed';\n    const action=miner.action?.state??miner.action??null;\n    const s=b.rigState?b.rigState({}):{x:b.x,y:0,z:b.z,vx:b.vx,vz:b.vz,facing:b.facing>0?0:Math.PI,air:b.air,climb:b.climbing,crouch:b.crouching};\n    s.pose=pose||null;s.attack=action?.spec? action:null;s.crouch=!!b.crouching;\n    s.hurt=(miner.invuln>0&&miner.invuln<1.35)||b.stun>0;\n    s.expr=miner.down||s.hurt?'wince':miner.jamT>0?'shout':pose==='PD:celebrate'?'smile':null;\n    s.aim=miner.aim==='low'?-.35:miner.aim==='high'?.7:typeof miner.aim==='number'?miner.aim:.4;\n    if(b.jumped)rig.kick(1.2);\n    if(b.landed)rig.land(.4);\n    rig.update(clamp(dt,0,.05),s);\n    return rig;\n  };\n  PD.installAssets();\n})();\n851:      if (e.pointerType === 'mouse' || this._fingers.size === 1) this._gesture('down', ...this.screenPoint(e.clientX, e.clientY), { touch: e.pointerType !== 'mouse', button: e.button, id: e.pointerId  [... omitted end of long line]\n987:    if (this._never) { this.touchEnabled = false; if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); return null; }   // (touch: 'never')\n1121:  /** a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false,\n1131:    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: 