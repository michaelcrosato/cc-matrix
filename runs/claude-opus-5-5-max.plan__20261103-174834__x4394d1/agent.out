{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eVntEQru96KR7aTqz9MAE","type":"tool_result","content":"1\t// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n2\t// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n3\t// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n4\t// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n5\t//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n6\t// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\n7\timport { resolve } from 'node:path';\n8\timport { readSet, writeSet } from './mocap-lib.mjs';\n9\t\n10\tconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\n11\tconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\n12\tif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Title]'); process.exit(2); }\n13\tconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\n14\tfor (const want of opt('clips').split(',')) {\n15\t  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n16\t  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n17\t  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n18\t  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n19\t  const S = hits[0], c = S.clips[clipName];\n20\t  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n21\t  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n22\t  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n23\t}\n24\t// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\n25\tconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\n26\tsources[lead] = first.sources[lead];\n27\tfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n28\t  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n29\t  sources[id] = rec;\n30\t}\n31\tconst out = Object.assign({ set: opt('name') }, opt('title') ? { title: opt('title') } : {}, { format: first.format, credit: opt('credit') || first.credit,\n32\t  from: from.length === 1 ? from[0] : from, fps: first.fps, sources, body: first.body, fit, clips });\n33\tconst w = writeSet(out, resolve(opt('out')));\n34\tconsole.log(`wrote ${opt('out')}: ${w.clips} clips from ${from.join(' and ')}, ${w.keys} key poses, ${w.kb.toFixed(0)} KB`);\n35\t"}]},"parent_tool_use_id":null,"session_id":"9eca6c66-8849-4edb-a442-cc89add0a71e","uuid":"f9cf33e2-0fd3-4aff-927a-a6beb8135826","timestamp":"2026-11-04T01:04:00.415Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/cc-plan-x4394d1/out/anim-set.mjs.txt","content":"// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\nimport { resolve } from 'node:path';\nimport { readSet, writeSet } from './mocap-lib.mjs';\n\nconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\nconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\nif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Title]'); process.exit(2); }\nconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\nfor (const want of opt('clips').split(',')) {\n  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n  const S = hits[0], c = S.clips[clipName];\n  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n}\n// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\nconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\nsources[lead] = first.sources[lead];\nfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n  sources[id] = rec;\n}\nconst out = Object.assign({ set: opt('name') }, opt('title') ? { title: opt('title') } : {}, { format: first.format, credit: opt('credit') || first.credit,\n  from: from.length === 1 ? from[0] : from, fps: first.fps, sources, body: first.body, fit, clips });\nconst w = writeSet(out, resolve(opt('out')));\nconsole.log(`wrote ${opt('out')}: ${w.clips} clips from ${from.join(' and ')}, ${w.keys} key poses, ${w.kb.toFixed(0)} KB`);\n","numLines":35,"startLine":1,"totalLines":35}},"tool_result_meta":[{"id":"toolu_012eVntEQru96KR7aTqz9MAE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
