{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017PvKFpCjJtKQ3FeNf2gJwm","type":"tool_result","content":"2960\t *    - game.settings: the player's choices (display, sound, comfort, controls), saved per game (a version, every value\n2961\t *      checked when it loads, a bad one falls back to its default), applied at once. A game adds its own with\n2962\t *      new E.Game({ menu: { settings: [{ key: 'hints', label: 'Hints', value: true }] } }) and reads game.settings.hints.\n2963\t *    - game.fullscreen: the page full screen from a tap, click or key. A phone's first tap takes it there, and a game\n2964\t *      started by a tap does again; turning it off (the corner's button, the menu) is the player's choice, kept.\n2965\t *    - the back gesture: a phone's back steps back in the game (game.back(): a menu screen closes, play pauses) before it\n2966\t *      leaves the page.\n2967\t *    - pausing: a pausable scene pauses when the page is hidden or loses focus, or the controller in use is unplugged,\n2968\t *      and waits for the player (game.pause(reason), game.resume(), game.pauseReason).\n2969\t *    - the corner: a menu button and a full-screen button at the top right, inside the safe area; on a touch screen the\n2970\t *      menu stays there in play (it is the touch START), and over a menu screen a close button takes its place.\n2971\t *    - the page set up for phones: a viewport that reaches the safe areas, and no scrolling, zooming, text selection or\n2972\t *      callouts on the game's canvas (menus keep theirs).\n2973\t *    E.Shell draws the menu's screens (pause, settings, controls): section 21d.\n2974\t * ============================================================================= */\n2975\tconst ZOOM_PLAYER = [.5, 2];   // the player's zoom (settings.zoom): half to twice the game's, within each scene's range\n2976\tconst SETTINGS_VERSION = 2;   // 2: fullscreen false means turned off (version 1's also meant left by a gesture: forgotten)\n2977\t/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\n2978\t *  function of the game), min, max, step, options: [[value, label]], help, apply(game, value) }. Groups: Display,\n2979\t *  Sound, Comfort (the settings screen), Controller, Touch (the controls screen) */\n2980\tconst STANDARD_SETTINGS = {\n2981\t  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n2982\t  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n2983\t  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n2984\t  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n2985\t  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n2986\t  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n2987\t  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n2988\t  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n2989\t  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n2990\t  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n2991\t  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n2992\t  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n2993\t  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n2994\t  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n2995\t  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n2996\t  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n2997\t  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { g.input.deadzone = v; } },\n2998\t  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { g.input.invertAimY = !!v; } },\n2999\t  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n3000\t  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { g.input.rumbleScale = v; } },\n3001\t  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n3002\t  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\n3003\t  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n3004\t  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n3005\t};\n3006\t/** a value for a setting, checked: the value kept, or undefined when it can't be one */\n3007\tfunction settingValue(sp, v) {\n3008\t  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n3009\t  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n3010\t  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n3011\t  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n3012\t  if (sp.type === 'bindings') {\n3013\t    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n3014\t    const out = {};\n3015\t    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n3016\t    return out;\n3017\t  }\n3018\t  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\n3019\t}\n3020\tclass Settings {\n3021\t  /**\n3022\t   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n3023\t   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n3024\t   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n3025\t   * with the defaults (saved: false)\n3026\t   */\n3027\t  constructor(game, own = []) {\n3028\t    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n3029\t    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n3030\t    hide('saved', true);\n3031\t    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n3032\t    hide('onChange', null);\n3033\t    const raw = store.get(this._key, null);\n3034\t    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n3035\t    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n3036\t    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n3037\t    for (const k in STANDARD_SETTINGS) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));\n3038\t    for (const sp of own) this.define(sp);\n3039\t  }\n3040\t  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n3041\t   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\n3042\t   *  applied; it shows on the settings screen. Returns its value */\n3043\t  define(sp) {\n3044\t    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \"hints\", label: \"Hints\", value: true }'); return undefined; }\n3045\t    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \"' + sp.key + '\" (a name the settings object uses)'); return undefined; }\n3046\t    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\n3047\t    this._specs[s.key] = s;\n3048\t    const saved = settingValue(s, this._raw[s.key]);\n3049\t    if (saved !== undefined) this._saved[s.key] = saved;\n3050\t    this[s.key] = saved !== undefined ? saved : this.default(s.key);\n3051\t    this._apply(s.key);\n3052\t    return this[s.key];\n3053\t  }\n3054\t  /** a setting's default value */\n3055\t  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\n3056\t  /** the spec a setting was defined with (its label, type, range, options), or undefined */\n3057\t  spec(key) { return this._specs[key]; }\n3058\t  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\n3059\t  keys(group) { return Object.keys(this._specs).filter(k => !group || this._specs[k].group === group); }\n3060\t  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\n3061\t   *  Returns the value kept (the old one when v is not a valid value) */\n3062\t  set(key, v) {\n3063\t    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \"' + key + '\". Settings: ' + this.keys().join(', ')); return undefined; }\n3064\t    const ok = settingValue(s, v); if (ok === undefined) return this[key];\n3065\t    this[key] = ok; this._saved[key] = ok; this._save(); this._apply(key);\n3066\t    if (this.onChange) try { this.onChange(key, ok); } catch (e) { this._g.fail('settings.onChange', e); }\n3067\t    return ok;\n3068\t  }\n3069\t  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */"}]},"parent_tool_use_id":null,"session_id":"9eca6c66-8849-4edb-a442-cc89add0a71e","uuid":"bdcfd5bf-99ea-41d2-97ac-037243f3ba5e","timestamp":"2026-11-04T00:52:26.495Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/cc-plan-x4394d1/engine/dist/handoff/my-3d2dge.js","content":" *    - game.settings: the player's choices (display, sound, comfort, controls), saved per game (a version, every value\n *      checked when it loads, a bad one falls back to its default), applied at once. A game adds its own with\n *      new E.Game({ menu: { settings: [{ key: 'hints', label: 'Hints', value: true }] } }) and reads game.settings.hints.\n *    - game.fullscreen: the page full screen from a tap, click or key. A phone's first tap takes it there, and a game\n *      started by a tap does again; turning it off (the corner's button, the menu) is the player's choice, kept.\n *    - the back gesture: a phone's back steps back in the game (game.back(): a menu screen closes, play pauses) before it\n *      leaves the page.\n *    - pausing: a pausable scene pauses when the page is hidden or loses focus, or the controller in use is unplugged,\n *      and waits for the player (game.pause(reason), game.resume(), game.pauseReason).\n *    - the corner: a menu button and a full-screen button at the top right, inside the safe area; on a touch screen the\n *      menu stays there in play (it is the touch START), and over a menu screen a close button takes its place.\n *    - the page set up for phones: a viewport that reaches the safe areas, and no scrolling, zooming, text selection or\n *      callouts on the game's canvas (menus keep theirs).\n *    E.Shell draws the menu's screens (pause, settings, controls): section 21d.\n * ============================================================================= */\nconst ZOOM_PLAYER = [.5, 2];   // the player's zoom (settings.zoom): half to twice the game's, within each scene's range\nconst SETTINGS_VERSION = 2;   // 2: fullscreen false means turned off (version 1's also meant left by a gesture: forgotten)\n/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\n *  function of the game), min, max, step, options: [[value, label]], help, apply(game, value) }. Groups: Display,\n *  Sound, Comfort (the settings screen), Controller, Touch (the controls screen) */\nconst STANDARD_SETTINGS = {\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { g.input.deadzone = v; } },\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { g.input.invertAimY = !!v; } },\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { g.input.rumbleScale = v; } },\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n};\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\nfunction settingValue(sp, v) {\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n  if (sp.type === 'bindings') {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n    const out = {};\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n    return out;\n  }\n  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\n}\nclass Settings {\n  /**\n   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n   * with the defaults (saved: false)\n   */\n  constructor(game, own = []) {\n    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n    hide('saved', true);\n    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n    hide('onChange', null);\n    const raw = store.get(this._key, null);\n    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n    for (const k in STANDARD_SETTINGS) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));\n    for (const sp of own) this.define(sp);\n  }\n  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\n   *  applied; it shows on the settings screen. Returns its value */\n  define(sp) {\n    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \"hints\", label: \"Hints\", value: true }'); return undefined; }\n    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \"' + sp.key + '\" (a name the settings object uses)'); return undefined; }\n    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\n    this._specs[s.key] = s;\n    const saved = settingValue(s, this._raw[s.key]);\n    if (saved !== undefined) this._saved[s.key] = saved;\n    this[s.key] = saved !== undefined ? saved : this.default(s.key);\n    this._apply(s.key);\n    return this[s.key];\n  }\n  /** a setting's default value */\n  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\n  /** the spec a setting was defined with (its label, type, range, options), or undefined */\n  spec(key) { return this._specs[key]; }\n  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\n  keys(group) { return Object.keys(this._specs).filter(k => !group || this._specs[k].group === group); }\n  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\n   *  Returns the value kept (the old one when v is not a valid value) */\n  set(key, v) {\n    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \"' + key + '\". Settings: ' + this.keys().join(', ')); return undefined; }\n    const ok = settingValue(s, v); if (ok === undefined) return this[key];\n    this[key] = ok; this._saved[key] = ok; this._save(); this._apply(key);\n    if (this.onChange) try { this.onChange(key, ok); } catch (e) { this._g.fail('settings.onChange', e); }\n    return ok;\n  }\n  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */","numLines":110,"startLine":2960,"totalLines":14707}},"tool_result_meta":[{"id":"toolu_017PvKFpCjJtKQ3FeNf2gJwm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
