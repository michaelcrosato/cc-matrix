c = ui.ctx().clone();\n            shell.frame(&c, &input, Some(&frame), vp);\n        });\n        let _ = hub_screen;\n        state.platform_output(&gfx.window, out.platform_output);\n        let pixels = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, pixels);\n        let mut textures = out.textures_delta;\n        if let Some(scene) = &scene {\n            gfx.draw(scene, Some((&prims, &mut textures, pixels)));\n        } else {\n            textures.clear();\n        }\n        // Hide the OS cursor in operations.\n        let want_visible = !matches!(frame.stage, Stage::Op | Stage::Code | Stage::OpStart)\n            || !matches!(p.shell.screen, Screen::Playing | Screen::Session);\n        if want_visible != p.last_cursor_visible {\n            p.last_cursor_visible = want_visible;\n            gfx.window.set_cursor_visible(want_visible);\n        }\n\n        // Edges consumed.\n        p.key_edges.clear();\n        p.left_edge = false;\n        p.right_edge = false;\n        p.mouse_moved = false;\n        p.wheel = 0.0;\n        p.tap = None;\n        p.first_frame_done = true;\n\n        // Stats.\n        p.frames += 1;\n        p.frames_total += 1;\n        p.fps_t += dt;\n        if p.fps_t >= 0.5 {\n            p.fps = p.frames as f32 / p.fps_t;\n            p.tps = (frame.tick.saturating_sub(p.last_tick)) as f32 / p.fps_t;\n            p.last_tick = frame.tick;\n            p.frames = 0;\n            p.fps_t = 0.0;\n            p.shell.dev.fps = p.fps;\n            p.shell.dev.tps = p.tps;\n        }\n\n        // Do what the shell asked.\n        let cmds = std::mem::take(&mut p.shell.cmds);\n        for c in cmds {\n    }\n    let (steps, bot, cmds) = QUEUE.with(|q| {\n        let mut q = q.borrow_mut();\n        let r = (q.0, q.1, std::mem::take(&mut q.2));\n        q.0 = 0;\n        r\n    });\n    for c in cmds {\n        let v: Value = serde_json::from_str(&c).unwrap_or(Value::Null);\n        if let Some(scene) = v[\"load\"].as_str() {\n            let scene = scene.to_string();\n            app.load_surgery_scene(&scene, 7);\n        }\n        if let Some(s) = v[\"screen\"].as_str() {\n            let p = app.product.as_mut().unwrap();\n            p.shell.screen = match s {\n                \"Title\" => Screen::Title,\n                \"Menu\" => Screen::Menu,\n                \"Playing\" => Screen::Playing,\n                \"Dev\" => Screen::Dev,\n                \"Pause\" => Screen::Pause,\n                \"About\" => Screen::About,\n                \"Settings\" => Screen::Settings,\n                _ => p.shell.screen,\n            };\n        }\n        if let Some(cmd) = v.get(\"sim\").and_then(|x| serde_json::from_value::<SurgeryCmd>(x.clone()).ok()) {\n            if let Some(host) = &app.host {\n                host.shared.surgery_cmds.lock().unwrap().push_back(cmd);\n            }\n        }\n    }\n    if steps > 0 {\n        if let Some(host) = &app.host {\n            host.exec(move |sim| {\n                for _ in 0..steps {\n                    let f = if bot { sim.bot_input() } else { Default::default() };\n                    sim.step(&f);\n                }\n            });\n        }\n    }\n    let status = app.status_json(frame);\n    QUEUE.with(|q| q.borrow_mut().3 = status.to_string());\n}\n#[cfg(not(target_arch = \"wasm32\"))]\n145:    hands: [Hands; 4],\n207:            hands: Default::default(),\n880:                    held |= hands::USE;\n883:                    held |= hands::PRECISION;\npub struct Product {\n    pub shell: Shell,\n    keys: HashSet<KeyCode>,\n    key_edges: HashSet<KeyCode>,\n    mouse_pos: Vec2,\n    mouse_moved: bool,\n    mouse_left: bool,\n    mouse_right: bool,\n    left_edge: bool,\n    right_edge: bool,\n    wheel: f32,\n    tap: Option<Vec2>,\n    /// How long a drawn frame takes, and when the next may be drawn (hub rounds\n    draw_cost: f32,\n    next_draw: Instant,\n    drew_last: bool,\n    /// Surface pixels 