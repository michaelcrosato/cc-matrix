port json\nimport pathlib\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nfrom common import ARGS, CRASHED, GAME, ROOT, sync_playwright, wait_for_memory\n\nHUB = ROOT / \"hub\"\nQUERIES = [\n    \"players=4&latency=150&jitter=50&loss=5&auto=1&limit=20\",\n    \"players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=20\",\n    \"players=2&scenario=server&auto=1&limit=20\",\n    \"players=1&auto=1&limit=20\",\n]\n\n\ndef serve():\n    proc = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"-d\", str(HUB)], stdout=subpro\n    line = proc.stdout.readline()\n    port = int(line.split(\"port \")[1].split(\" \")[0])\n    return proc, port\n\n\ndef main():\n    passed = failed = 0\n    shutil.copy(GAME, HUB / \"game.html\")\n    proc, port = serve()\n    base = f\"http://127.0.0.1:{port}\"\n    try:\n        with sync_playwright() as p:\n            b = p.chromium.launch(args=ARGS)\n            for q in ([] if \"two\" in sys.argv else QUERIES):\n                for attempt in range(3):\n                    wait_for_memory(4.0)\n                    try:\n                        ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                        page = ctx.new_page()\n                        page.goto(f\"{base}/harness.html?game=game.html&{q}\")\n                        page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=480000)\n                        check = page.evaluate(\"window.__hubCheck\")\n                        if check and check.get(\"pass\"):\n                            passed += 1\n                        else:\n                            failed += 1\n                            bad = [c for c in (check or {}).get(\"checks\", []) if not c.get(\"ok\", c.get(\"pass\", True))]\n                            print(f\"FAIL harness {q}: {json.dumps(bad or check)[:1500]}\")\n                        ctx.close()\n                        break\n                    except Exception as e:\n                        if any(c in str(e) for c in CRASHED) and attempt < 2:\n                            try:\n                                b.close()\n                            except Exception:\n                                pass\n                            time.sleep(20)\n                            b = p.chromium.launch(args=ARGS)\n                            continue\n20:def serve():\n27:def main():\n84:                            st.append(f.evaluate(\"window.__game ? window.__game.status() : null\"))\n115:                page.wait_for_function(\"window.__game && window.__game.status() && window.__game.status().screen === 'Title'\",\n116:                assert page.evaluate(\"window.__game.status().hub\") is False","is_error":false}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"299f42d7-d768-47d8-aa2d-933bb5e3703e","timestamp":"2026-11-05T21:13:16.512Z","tool_use_result":{"stdout":"17:use pav_core::input::{SurgeonInput, SurgeryCmd, hands};\n77:fn read_pads(g: &mut gilrs::Gilrs) -> Vec<PadState> {\n240:    fn pad_edge(&self, f: impl Fn(&PadState) -> bool) -> bool {\n770:    fn surgeon_input(&mut self, frame: &SurgeryFrame, dt: f32, size: Vec2) {\n782:        let mut out = [SurgeonInput { tool: -1, ..Default::default() }; 4];\n820:                    i.surgeons = [SurgeonInput::default(); 4];\n849:            let mut pressure = 1.0f32;\n926:                    pressure = q.r2;\n930:                    pressure = 1.0;\n944:                // The signature: a flick switches tools, with no menu and no slowdown.\n945:                if let Some(i) = surgeon::flick(q.left) {\n996:            o.pressure = pressure;\n1050:        v[\"pressure\"] = serde_json::json!(frame.surgeons.first().map(|s| s.pressure));\n38:pub fn key_from_name(n: &str) -> Option<KeyCode> {\n104:    pub fn game() -> Self {\n125:    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<S