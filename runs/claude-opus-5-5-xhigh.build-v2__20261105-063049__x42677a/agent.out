{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjtjmz4adJ1suJr3C86U","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011LYGoHccdqDYsihRYDEGqg","name":"Bash","input":{"command":"cd crates/pav_core/src/games/surgery/content\ncat > level.toml <<'EOF'\n# The operating room for the wide shots, far from the field, so it is on screen only when a story\n# camera looks at it. Puppets in scrubs stand around a table built from blocks.\n# Check it with `pav room_check path=crates/pav_core/src/games/surgery/content/level.toml`.\nname = \"The Operating Room\"\nabout = \"Mercy Harbor General, theatre three.\"\nentrance = { at = [8, 12], facing = \"south\" }\n\n[view]\nsky = \"#10282c\"\n\n[layout]\norigin = [86.0, 0.0, -9.0]\n\n[[layout.layer]]\ny = 0\nmap = '''\n################\n#..............#\n#.ss........ss.#\n#..............#\n#.....TTTT.....#\n#.....TTTT.....#\n#..............#\n#..............#\n#.ll........ll.#\n#..............#\n#..............#\n#..............#\n################\n'''\n\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 4.5, color = \"#7fa3a0\" }]\n\n[layout.legend.'T']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 0.95, color = \"#c8d0d4\", rounded = true }]\n\n[layout.legend.'s']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 1.5, color = \"#5c6a70\", rounded = true }]\n\n[layout.legend.'l']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 0.8, color = \"#a0aab0\" }]\n\n[[npc]]\nname = \"surgeon\"\npos = [5.5, 0, 3.6]\nyaw = 180\nclips = [\"MESH2MOTION/Idle_Talking\"]\nlook = { shirt = \"#2e9692\", pants = \"#2e9692\", skin = \"#f2c8ac\" }\n\n[[npc]]\nname = \"nurse\"\npos = [10.5, 0, 3.6]\nyaw = 180\nclips = [\"QUATERNIUS/Idle_Loop\"]\nlook = { shirt = \"#3c68a4\", pants = \"#3c68a4\", skin = \"#be8e68\" }\n\n[[npc]]\nname = \"gas\"\npos = [8.0, 0, 7.4]\nyaw = 0\nclips = [\"QUATERNIUS/Idle_Loop\"]\nlook = { shirt = \"#5c8a54\", pants = \"#5c8a54\", skin = \"#e0b896\" }\n\n[[npc]]\nname = \"chief\"\npos = [13.2, 0, 8.6]\nyaw = 300\nclips = [\"MESH2MOTION/Idle_Talking\"]\nlook = { shirt = \"#c8ccd4\", pants = \"#30343c\", skin = \"#e8c8b0\" }\nEOF\ncat > callouts.toml <<'EOF'\n# In-op callouts, by trigger. `nurse` is whoever is calling the operation: Bashir, until he is the\n# patient. One line is picked at random each time.\n[wrong_tool]\nlines = [[\"nurse\", \"Wrong instrument, Doctor.\"], [\"nurse\", \"Not that one, Doctor.\"], [\"nurse\", \"Doctor. The other one.\"]]\n[healthy]\nlines = [[\"nurse\", \"Doctor, that's healthy tissue.\"], [\"nurse\", \"That was healthy, Doctor. It was.\"]]\n[off_axis]\nlines = [[\"nurse\", \"Along the barb, Doctor. Along it.\"], [\"nurse\", \"You tore it. Steady.\"]]\n[sloppy_suture]\nlines = [[\"nurse\", \"That stitch will leak, Doctor.\"]]\n[overheat]\nlines = [[\"nurse\", \"Too long. You've burned him.\"], [\"nurse\", \"Let go sooner, Doctor.\"]]\n[overdose]\nlines = [[\"teddy\", \"Whoa, whoa, that's too much, that's a lot of drug, that's all the drug.\"]]\n[found]\nlines = [[\"nurse\", \"There. On the monitor.\"], [\"nurse\", \"Found one. Eight seconds, Doctor.\"]]\n[immaculate]\nlines = [[\"nurse\", \"Clean. Again.\"], [\"nurse\", \"Immaculate, Doctor.\"], [\"nurse\", \"...Doctor.\"], [\"teddy\", \"Okay. Okay! Who is she?\"]]\n[clean]\nlines = [[\"nurse\", \"Clean.\"], [\"nurse\", \"Good hands, Doctor.\"], [\"nurse\", \"Next.\"]]\n[burst]\nlines = [[\"nurse\", \"Burst! Caustic on the field!\"], [\"teddy\", \"That one's crying acid! That's new! I hate that!\"]]\n[eye_open]\nlines = [[\"nurse\", \"The eye! Across it, Doctor. Now.\"], [\"mara\", \"It's looking at me. Bashir, it's looking at me.\"]]\n[missed_pull]\nlines = [[\"nurse\", \"Too slow. The shell's back.\"]]\n[lift_off]\nlines = [[\"pet\", \"Lift off! Lift off!\"], [\"nurse\", \"Lift off! Lift off!\"]]\n[scorched]\nlines = [[\"nurse\", \"Hands up on the ring, Doctor.\"], [\"pet\", \"I said lift. It's a very short word.\"]]\n[diastole]\nlines = [[\"pet\", \"Not against the beat! Wait for it to breathe!\"], [\"teddy\", \"Diastole! Pull in diastole! The squishy part!\"]]\n[vitals_forty]\nlines = [[\"nurse\", \"Vitals at forty. Push the IV. Now!\"], [\"teddy\", \"Forty! Forty and falling! IV, IV, IV!\"]]\n[code]\nlines = [[\"teddy\", \"He's flat! Paddles, paddles, paddles!\"], [\"nurse\", \"Charge. Both triggers. On the ghost.\"]]\n[code_back]\nlines = [[\"teddy\", \"Sinus rhythm! Oh, I love you. I love all of you.\"], [\"nurse\", \"We have a rhythm, Doctor.\"]]\n[code_again]\nlines = [[\"nurse\", \"Again. Charge it first, then let go on the line.\"]]\n[next_shock]\nlines = [[\"teddy\", \"Still flat! Again!\"], [\"pet\", \"Again. It's listening. Make it hear you.\"]]\n[defib_miss]\nlines = [[\"teddy\", \"That didn't take! On the line, on the line!\"]]\n[time_up]\nlines = [[\"nurse\", \"That's the time, Doctor.\"]]\n[codeblue_tempo]\nlines = [[\"teddy\", \"It's getting faster! Why is it getting faster!\"], [\"nurse\", \"Pace is up. Stay with it.\"]]\n[codeblue_finale]\nlines = [[\"nurse\", \"Something's moving under there. Scanner's clean. It's the waltz.\"]]\nEOF\ncat > plates/forearm.toml <<'EOF'\nname = \"Forearm\"\nlobes = [[0, 0.1, 150, 16, 1.2], [-3.5, -1.1, 22, 4, 0.34], [3.8, 1.2, 26, 4, 0.3], [0.5, -0.2, 40, 2.2, 0.24]]\nbed = [74, 22, 30]\nflesh = [214, 92, 84]\ntop = [246, 150, 128]\nvein = [150, 40, 60]\npulse = 0.04\nbreathe = 0.02\nveins = 0.55\nvessels = [[[-9, -2.4], [-5, -1.6], [-1, -2], [3, -1.2], [9, -1.8]], [[-9, 2.2], [-3, 1.7], [2, 2.5], [9, 2]]]\nEOF\ncat > plates/abdomen.toml <<'EOF'\nname = \"Abdomen, skin\"\nlobes = [[0, 0.1, 150, 34, 1.25]]\nbed = [70, 40, 40]\nflesh = [226, 176, 148]\ntop = [250, 214, 190]\nvein = [196, 138, 124]\npulse = 0.02\nbreathe = 0.07\nveins = 0.14\nnoise = 0.25\nwet = 0.2\nEOF\ncat > plates/bowel.toml <<'EOF'\nname = \"Bowel\"\nlobes = [[-6, -2.2, 8, 3, 0.9], [-2.2, -2.5, 9, 2.6, 0.95], [2, -2.4, 9, 2.8, 0.9], [6, -2, 8, 3, 0.95], [-7, 0.8, 7, 3, 1], [-3, 0.6, 8, 2.8, 1.05], [1.2, 0.8, 9, 3, 1], [5.5, 0.9, 8, 3, 1], [-5, 3.2, 8, 2.5, 0.9], [-1, 3.3, 8, 2.4, 0.95], [3.4, 3.3, 8, 2.4, 0.9], [7.5, 3.1, 6, 2.5, 0.9]]\nbed = [84, 26, 36]\nflesh = [226, 118, 104]\ntop = [252, 176, 148]\nvein = [168, 56, 72]\npulse = 0.05\nbreathe = 0.06\nveins = 0.45\nwet = 0.8\nEOF\ncat > plates/chest.toml <<'EOF'\nname = \"Chest, skin\"\nlobes = [[0, 0.1, 150, 34, 1.15]]\nbed = [62, 34, 34]\nflesh = [214, 156, 130]\ntop = [244, 198, 172]\nvein = [186, 124, 112]\npulse = 0.05\nbreathe = 0.09\nveins = 0.14\nnoise = 0.25\nwet = 0.2\nridges = [[[-8, -2.8], [-3, -3.2], [3, -3.2], [8, -2.8]], [[-8, -0.6], [-3, -1], [3, -1], [8, -0.6]], [[-8, 1.7], [-3, 1.3], [3, 1.3], [8, 1.7]]]\nEOF\ncat > plates/lung.toml <<'EOF'\nname = \"Lung and rib\"\nlobes = [[-4.2, 0.2, 34, 22, 1.2], [4.4, 0.1, 34, 22, 1.25], [0, 0, 8, 26, 0.5]]\nbed = [58, 30, 44]\nflesh = [226, 134, 140]\ntop = [250, 190, 186]\nvein = [160, 62, 92]\npulse = 0.04\nbreathe = 0.16\nveins = 0.7\nwet = 0.65\nvessels = [[[0, -4.5], [-2, -2], [-5, -1.2], [-8, -1.8]], [[0, -4.5], [2, -1.6], [5, -0.8], [8, -1.4]]]\nridges = [[[-9, 4.6], [-3, 4.1], [3, 4.1], [9, 4.6]]]\nEOF\ncat > plates/liver.toml <<'EOF'\nname = \"Liver\"\nlobes = [[-2.2, 0, 62, 24, 1.3], [5.2, 0.6, 22, 13, 1], [-7, -0.4, 10, 12, 0.7]]\nbed = [46, 16, 22]\nflesh = [150, 58, 56]\ntop = [206, 96, 84]\nvein = [96, 26, 44]\npulse = 0.05\nbreathe = 0.1\nveins = 0.5\nwet = 0.9\nvessels = [[[9, 4], [5, 2.5], [1, 2.7], [-3, 1.7]], [[9, -4], [4, -2.5], [0, -2.9]]]\nEOF\ncat > plates/femur.toml <<'EOF'\nname = \"Femur\"\nlobes = [[0, 0.1, 150, 34, 0.9], [0, 0.1, 110, 3.4, 0.8]]\nbed = [64, 22, 28]\nflesh = [190, 78, 74]\ntop = [242, 222, 196]\nvein = [120, 32, 48]\npulse = 0.03\nbreathe = 0.02\nveins = 0.35\nwet = 0.5\nvessels = [[[-9, -3.4], [-3, -2.8], [3, -3.5], [9, -3]]]\nEOF\ncat > plates/pericardium.toml <<'EOF'\nname = \"Pericardium\"\nlobes = [[0, 0.1, 70, 26, 1.45], [-4, -0.8, 20, 10, 0.4], [4, 0.8, 20, 10, 0.4]]\nbed = [56, 18, 28]\nflesh = [206, 106, 92]\ntop = [244, 186, 150]\nvein = [140, 42, 58]\npulse = 0.13\nbreathe = 0.08\nveins = 0.6\nwet = 0.75\nvessels = [[[-8, -3], [-3, -1.6], [0, 0], [4, 1.8], [8, 3.4]]]\nEOF\ncat > plates/furnace.toml <<'EOF'\nname = \"The Furnace\"\nlobes = [[0, 0.1, 70, 26, 1.45], [0, 0, 6, 3, -0.45]]\nbed = [40, 8, 14]\nflesh = [148, 40, 36]\ntop = [240, 120, 60]\nvein = [255, 140, 60]\npulse = 0.16\nbreathe = 0.08\nveins = 0.85\nwet = 0.6\nEOF\ncat > plates/heart.toml <<'EOF'\nname = \"The Heart\"\nlobes = [[-1.6, -0.6, 42, 16, 1.55], [2.8, 0.7, 26, 15, 1.35], [0.5, 2.4, 14, 7, 0.8]]\nbed = [46, 12, 22]\nflesh = [186, 62, 60]\ntop = [240, 128, 104]\nvein = [130, 28, 52]\npulse = 0.34\nbreathe = 0.06\nveins = 0.55\nwet = 0.9\nvessels = [[[0.5, -5], [0.8, -2.5], [-0.2, 0], [0.6, 2.2], [0.2, 4]], [[-0.2, -1], [-3, -0.2], [-5, 1], [-6.5, 2.8]], [[0.7, -2.2], [3, -1], [5, 1], [6.3, 3]]]\nvessel_color = [180, 70, 40]\nEOF\ncat > plates/torso.toml <<'EOF'\nname = \"Torso\"\nlobes = [[0, 0.1, 150, 34, 1.15], [-3.6, -0.8, 22, 9, 0.3], [3.6, -0.8, 22, 9, 0.3]]\nbed = [74, 22, 30]\nflesh = [214, 92, 84]\ntop = [246, 150, 128]\nvein = [150, 40, 60]\npulse = 0.09\nbreathe = 0.11\nveins = 0.5\nwet = 0.6\nvessels = [[[-9, 3.8], [-3, 3], [3, 3.2], [9, 3.8]]]\nEOF\nRING='ring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"scanner\", \"iv\"]'\ncat > cases/case0.toml <<EOF\nname = \"Barbs\"\nsurgeon = \"mara\"\nplate = \"forearm\"\n$RING\ntimer = 240\npar = 6000\npatient = \"Anton Deverell\"\nlife = \"Net-mender, Pier Nine. Forty years of other men's knots.\"\ndiagnosis = \"Forearm full of hooks and cable splinters, inflamed. The storm took his boat's winch.\"\nfate = \"Anton Deverell will mend nets again by spring.\"\nfate_lost = \"Anton Deverell's nets stayed on the pier. Nobody else can read his knots.\"\nbefore = \"case0_before\"\nafter = \"case0_after\"\nguided = true\n\n[[phase]]\nname = \"Prep\"\nobjective = \"Gel the inflamed skin. Hold it and paint.\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [-4.2, -0.5]\nr = 0.9\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [0.4, 1.2]\nr = 0.85\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [4.6, -0.9]\nr = 0.9\ntag = \"inflammation\"\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Gel, Doctor. Flick it, then paint until the ring is full.\"]\n\n[[phase]]\nname = \"Hooks\"\nobjective = \"Forceps. Grab each hook and pull along its arrow.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-5.4, 1]\naxis = -60\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-1.8, -1.4]\naxis = 200\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [2, 1.5]\naxis = 20\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [5.5, -1]\naxis = -120\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.4, 2.5]\npts = [[-4.4, 2.4], [-3.4, 2.7], [-2.4, 2.4]]\noptional = true\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Forceps, Doctor. Lift the mass. ...Doctor.\"]\n[[phase.event]]\nremaining = 2\nsay = [\"bashir\", \"Along the barb. It came in one way. It leaves the same way.\"]\n\n[[phase]]\nname = \"Splinters\"\nobjective = \"Suction the blood. Something is under it.\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-3.3, -0.8]\naxis = 160\ntag = \"splinter\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.6, 0.9]\naxis = 70\ntag = \"splinter\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [3.8, 1.2]\naxis = -30\ntag = \"shard\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [3.8, 1.2]\nr = 1.5\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"That pool is hiding one. Suction. Harder drains faster.\"]\nbanner = \"SOMETHING UNDER THE BLOOD\"\ncue = \"stinger\"\n\n[[phase]]\nname = \"Close\"\nobjective = \"Suture each wound. Zigzag across, near the needle.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.6, 0.2]\npts = [[-5.4, 0.8], [-4.2, 0], [-3, 0.4], [-1.8, -0.2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.2, -0.4]\npts = [[1.8, -0.2], [3, -0.8], [4.6, -0.5]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Suture. Back and forth across the wound, even and quick.\"]\n\n[[phase]]\nname = \"Dress\"\nobjective = \"Dressing. Draw along the closure.\"\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 0]\npts = [[-6, 0.3], [-2, -0.3], [2, 0.3], [6, -0.2]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Last thing. Dress it. He'll want the arm back.\"]\nEOF\ncat > cases/case1.toml <<EOF\nname = \"Routine\"\nsurgeon = \"mara\"\nplate = \"abdomen\"\n$RING\ntimer = 270\npar = 8000\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. Has never once run a ship aground, and mentions it.\"\ndiagnosis = \"Acute appendicitis. Routine, the board says, underlined twice.\"\nfate = \"Rosalind Pike was back on the pilot boat in a fortnight, complaining about the tea.\"\nfate_lost = \"The harbour flew its flags low for Rosalind Pike, and the ships came in slower.\"\nbefore = \"case1_before\"\nafter = \"case1_after\"\nguided = true\n\n[[phase]]\nname = \"Open\"\nobjective = \"Scalpel. Follow the dashed line, one stroke.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [0, 0]\npts = [[-4.8, -0.5], [-2, -0.8], [1, -0.4], [4.8, -0.7]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Scalpel, Doctor. One stroke. Stay on the line.\"]\n\n[[phase]]\nname = \"Polyps\"\nobjective = \"Laser the polyps. Let go when the ring is nearly full.\"\nplate = \"bowel\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-6, -1.6]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-4.8, -0.9]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.2, 1.1]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [0.2, 2.2]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.6, -1.8]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [5, -0.7]\nr = 0.36\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Laser. Hold it on one. Eighty to a hundred on the ring, then let go.\"]\n\n[[phase]]\nname = \"Appendix\"\nobjective = \"Gel the inflammation, then lift the appendix out.\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [1.8, 0.4]\nr = 1.2\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [1.8, 0.4]\naxis = -70\nr = 0.5\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [-3, 2.3]\nr = 1\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Dr. Quill. The appendix is the part that is not supposed to be on fire.\"]\n\n[[phase]]\nname = \"Complication\"\nobjective = \"The artery! Stitch the bleeder. IV Push if the vitals fall.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-1, 0.4]\naxis = 30\n[[phase.spawn]]\nkind = \"pool\"\nat = [-1.4, 1.1]\nr = 1.3\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.2, 2.1]\npts = [[2.2, 1.7], [3.4, 2.3], [4.6, 2]]\n[[phase.event]]\nat_time = 0.1\nsay = [\"teddy\", \"That's arterial! That's a lot of arterial! Pressure's dropping, guys!\"]\nbanner = \"AN ARTERY LET GO\"\nshake = 1\ncue = \"alarm\"\nvitals = -22\n[[phase.event]]\nat_time = 1.8\nsay = [\"bashir\", \"Three quick crossings on the bleeder. IV Push for the numbers. Green band, then let go.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close the skin, then dress it.\"\nplate = \"abdomen\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [0, 0]\npts = [[-4.8, -0.5], [-2, -0.8], [1, -0.4], [4.8, -0.7]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 1.4]\npts = [[-5, 1.5], [-1, 1.2], [3, 1.5], [5, 1.3]]\nEOF\ncat > cases/case2.toml <<EOF\nname = \"Shrapnel Night\"\nsurgeon = \"mara\"\nplate = \"chest\"\n$RING\ntimer = 300\npar = 10000\npatient = \"Gideon Marr\"\nlife = \"Foreman, Grain Terminal Two. Ran back in for the night shift's lunch tins.\"\ndiagnosis = \"Blast injury. Chest full of machine parts nobody can count from out here.\"\nfate = \"Gideon Marr woke up asking after his crew. All eleven of them came to ask after him.\"\nfate_lost = \"Eleven men carried Gideon Marr's lunch tin to the harbour wall.\"\nbefore = \"case2_before\"\nafter = \"case2_after\"\n\n[[phase]]\nname = \"Open\"\nobjective = \"Two incisions, between the ribs.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [-3.6, 0.3]\npts = [[-6.2, 0.4], [-3.6, 0.1], [-1, 0.4]]\n[[phase.spawn]]\nkind = \"incision\"\nat = [3.6, 0.3]\npts = [[1, 0.4], [3.6, 0.1], [6.2, 0.4]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"teddy\", \"No rush! Except, you know. A lot of rush.\"]\n\n[[phase]]\nname = \"Shrapnel\"\nobjective = \"Scanner. Sweep for the metal, then forceps.\"\nplate = \"lung\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-5.4, -1.6]\naxis = 200\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-2.6, 1.8]\naxis = 110\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [2.4, -2]\naxis = -70\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [5.4, 1.2]\naxis = 10\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.6, 0.3]\naxis = 240\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, 2.4]\npts = [[-6, 2.1], [-5, 2.7], [-3.8, 2.4]]\noptional = true\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Scanner, Doctor. Hold and sweep. What it finds stays lit for eight seconds.\"]\n\n[[phase]]\nname = \"Arrest\"\nobjective = \"The heart stopped. Charge, then shock on the ghost beat.\"\n[[phase.event]]\nat_time = 0.6\nsay = [\"mara\", \"Now.\"]\n[[phase.event]]\nat_time = 1.1\ncode = true\nsay = [\"teddy\", \"Wait, how did she... He's flat! He just went flat!\"]\n\n[[phase]]\nname = \"Bleeders\"\nobjective = \"Stitch the bleeders. Clear the field.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-3.8, -0.8]\naxis = 80\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [3.6, 1]\naxis = 150\n[[phase.spawn]]\nkind = \"pool\"\nat = [-3.1, 0.1]\nr = 1.2\n[[phase.spawn]]\nkind = \"laceration\"\nat = [0, -2.3]\npts = [[-1.4, -2.2], [0, -2.6], [1.5, -2.2]]\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.4, 2.1]\naxis = 35\ntag = \"shard\"\nhidden = true\n[[phase.event]]\nat_time = 0.5\nsay = [\"bashir\", \"Back with us. Two bleeders. And I count one more piece of the terminal.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close and dress.\"\nplate = \"chest\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.6, 0.3]\npts = [[-6.2, 0.4], [-3.6, 0.1], [-1, 0.4]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.6, 0.3]\npts = [[1, 0.4], [3.6, 0.1], [6.2, 0.4]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2]\npts = [[-5, 2], [0, 1.7], [5, 2]]\nEOF\ncat > cases/case3.toml <<EOF\nname = \"Something Moved\"\nsurgeon = \"mara\"\nplate = \"liver\"\n$RING\ntimer = 360\npar = 15000\npatient = \"Ines Calloway\"\nlife = \"Courier for the Vane Foundation. Carries sealed envelopes and asks nothing.\"\ndiagnosis = \"Benign liver mass. Elective. Should take forty minutes and a good night's sleep.\"\nfate = \"Ines Calloway has been told it was a benign mass. She has stopped sleeping anyway.\"\nfate_lost = \"Ines Calloway's last envelope was never delivered. Someone came for it the same night.\"\nbefore = \"case3_before\"\nafter = \"case3_after\"\n\n[[phase]]\nname = \"Approach\"\nobjective = \"Open the capsule. Laser the polyps on the way.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [-3, -2.4]\npts = [[-6, -2.2], [-3, -2.7], [0, -2.4]]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.6, -2.2]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [5.6, -0.8]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [4.8, 1.6]\n[[phase.event]]\nat_time = 0.4\nsay = [\"bashir\", \"Benign mass, Doctor. Elective. I brought a sandwich.\"]\n\n[[phase]]\nname = \"The Mass\"\nobjective = \"Cut around the mass, lift it out, gel the bed.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"tumor\"\nat = [-1, 0.6]\naxis = -90\nr = 1.2\n[[phase.event]]\nremaining = 1\nat_time = 0.3\nsay = [\"bashir\", \"Ring cut. Then forceps. Then gel.\"]\n\n[[phase]]\nname = \"Introit\"\nobjective = \"It moved. Scanner to find it, Laser at rest, Forceps quickly.\"\ncheckpoint = true\nmeter = 3\nstrain = { kind = \"introit\", waves = 4, tough = 1.0, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.1\nsay = [\"mara\", \"It moved.\"]\ncue = \"stinger\"\nshake = 0.7\n[[phase.event]]\nat_time = 2.8\nsay = [\"bashir\", \"Masses don't move.\"]\n[[phase.event]]\nat_time = 5.2\nsay = [\"mara\", \"Bashir. It moved.\"]\n[[phase.event]]\nat_time = 8.2\nsay = [\"teddy\", \"Guys? The ECG just went into three-four time. That's a waltz. Hearts aren't in a time signature. Hearts aren't allowed.\"]\nbanner = \"3/4\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 14.0\nsay = [\"bashir\", \"Scanner to find it. Laser while it rests. Forceps within two beats, or the shell comes back.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Repair what it left behind. Then close.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-4, 1.4]\npts = [[-5.4, 1.2], [-4, 1.7], [-2.6, 1.3]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.8, -1]\npts = [[2.6, -0.8], [3.8, -1.3], [5, -0.9]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2.7]\npts = [[-5, 2.7], [0, 2.4], [5, 2.7]]\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Finish. Then you will wash your hands.\"]\nEOF\ncat > cases/case4.toml <<EOF\nname = \"The Night Ward\"\nsurgeon = \"mara\"\nplate = \"lung\"\n$RING\ntimer = 360\npar = 16000\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. Came back for a follow-up. Did not expect a follow-up like this.\"\ndiagnosis = \"Lacrimosa strain, seeded in recovery. Bilateral. Nothing on any chart anywhere.\"\nfate = \"Rosalind Pike believes she had a bad reaction to the anaesthetic. Dr. Quill signed the form that says so.\"\nfate_lost = \"The pilot boat went out without Rosalind Pike. The ships came in crooked for a month.\"\nbefore = \"case4_before\"\nafter = \"case4_after\"\ngift = true\n\n[[phase]]\nname = \"Flood\"\nobjective = \"Clear the flood. Find what's feeding it.\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [-4.8, -1]\nr = 1.5\n[[phase.spawn]]\nkind = \"pool\"\nat = [4.6, 1.3]\nr = 1.6\n[[phase.spawn]]\nkind = \"pool\"\nat = [0.2, 2.4]\nr = 1.1\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-4.8, -1]\naxis = 45\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [4.6, 1.3]\naxis = 110\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]\naxis = -50\ntag = \"seed\"\nhidden = true\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"No guidance, Doctor. Not tonight. Nobody down here has done this and lived to write it up.\"]\n\n[[phase]]\nname = \"Lacrimosa\"\nobjective = \"Laser the stems before they burst. Then cut the eye.\"\ncheckpoint = true\nmeter = 6\nstrain = { kind = \"lacrimosa\", waves = 3, count = 6, beats = 15, at = [0, 0.1] }\n[[phase.event]]\nat_time = 0.4\nsay = [\"teddy\", \"Six-eight. It's in six-eight. It's a lullaby. I'd like to go home.\"]\nbanner = \"6/8\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 4.5\nsay = [\"mara\", \"They swell on the beat. Take the stems.\"]\n\n[[phase]]\nname = \"Repair\"\nobjective = \"Stitch, soothe, and close her.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-4, 1.8]\npts = [[-5.6, 1.6], [-4.2, 2.2], [-2.8, 1.8]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.8, -2]\npts = [[2.6, -1.8], [3.8, -2.4], [5.2, -2]]\n[[phase.spawn]]\nkind = \"burn\"\nat = [0.4, -1.2]\nr = 1\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 3.1]\npts = [[-5, 3.1], [0, 2.8], [5, 3.1]]\nEOF\ncat > cases/case5.toml <<EOF\nname = \"Second Opinion\"\nsurgeon = \"pet\"\nplate = \"femur\"\n$RING\ntimer = 360\npar = 15000\npatient = \"Tomasz Bell\"\nlife = \"Longshoreman. Caught a falling container and, regrettably, held it for a moment.\"\ndiagnosis = \"Shattered femur. Then, on the second film, something growing in the marrow.\"\nfate = \"Tomasz Bell walks with a stick now. He has stopped catching things.\"\nfate_lost = \"The union took up a collection for Tomasz Bell's boys. It was a good collection.\"\nbefore = \"case5_before\"\nafter = \"case5_after\"\ntremor = true\n\n[[phase]]\nname = \"Reduction\"\nobjective = \"Forceps: carry each fragment home, turn it, wire it.\"\n[[phase.spawn]]\nkind = \"bone\"\nat = [-4.4, -2.3]\nto = [-3.2, 0.1]\nangle = 40\naxis = 0\n[[phase.spawn]]\nkind = \"bone\"\nat = [2.6, 2.6]\nto = [0, 0.1]\nangle = -50\naxis = 0\n[[phase.spawn]]\nkind = \"bone\"\nat = [5.4, -2.2]\nto = [3.2, 0.1]\nangle = 70\naxis = 0\n[[phase.event]]\nat_time = 0.3\nsay = [\"pet\", \"Carry it, turn it with the shoulder buttons, set it, wire it. A child could. I've seen children try.\"]\n[[phase.event]]\nat_time = 7.0\nsay = [\"pet\", \"Yes, it shakes. No, I don't want your opinion of it.\"]\n\n[[phase]]\nname = \"Marrow\"\nobjective = \"Cysts in the marrow. Laser them.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-5.6, 0.1]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-3.4, -0.3]\nr = 0.36\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1, 0.4]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, -0.3]\nr = 0.36\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.8, 0.5]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [6, -0.2]\nr = 0.36\ntag = \"cyst\"\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Doctor. There are cysts in the marrow. That film was clean this morning.\"]\n[[phase.event]]\nremaining = 3\nsay = [\"pet\", \"They're keeping time. Hm. There you are, you old fool.\"]\ngift = true\ncue = \"gift_ready\"\nshake = 0.6\n\n[[phase]]\nname = \"The Echo\"\nobjective = \"Your hands split. Take the Echo: whatever you do, they do again.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, -2]\npts = [[-6.2, -1.8], [-5, -2.4], [-3.8, -2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, 2.4]\npts = [[-6.2, 2.1], [-5, 2.6], [-3.8, 2.3]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [5, -2]\npts = [[3.8, -1.8], [5, -2.4], [6.2, -2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [5, 2.4]\npts = [[3.8, 2.1], [5, 2.6], [6.2, 2.3]]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.6, -2.6]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, -2.6]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.6, 2.8]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, 2.8]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [0, -1.8]\nr = 0.7\n[[phase.event]]\nat_time = 1.4\nsay = [\"bashir\", \"Doctor Nwosu... there were two of you.\"]\n[[phase.event]]\nat_time = 5\nsay = [\"pet\", \"There were always two of me, young man. One of them retired.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Set the last piece and dress it.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bone\"\nat = [-1.6, -2.2]\nto = [-1.5, 0.1]\nangle = -30\naxis = 0\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2.9]\npts = [[-5, 2.9], [0, 2.6], [5, 2.9]]\nEOF\ncat > cases/case6.toml <<EOF\nname = \"Dies Irae\"\nsurgeon = \"pet\"\nplate = \"pericardium\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"cryo\", \"gel\", \"laser\", \"iv\"]\ntimer = 420\npar = 18000\npatient = \"Chief Ottoline Voss\"\nlife = \"Chief of Surgery. Eleven years of carrying this, and three decades of saying adequate.\"\ndiagnosis = \"Dies Irae strain, pericardial. She designed the host-entrainment. She is the host.\"\nfate = \"Ottoline Voss sat up on the second day and corrected the nurse's chart. She was right.\"\nfate_lost = \"The form was filled out by Perpetua Nwosu, in her best hand. It took her a very long time.\"\nbefore = \"case6_before\"\nafter = \"case6_after\"\ngift = true\ntremor = true\n\n[[phase]]\nname = \"Open\"\nobjective = \"Open the sac. Soothe the burns.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [0, -2.8]\npts = [[-4.6, -2.6], [-1.6, -3], [1.6, -3], [4.6, -2.6]]\n[[phase.spawn]]\nkind = \"burn\"\nat = [-4, 1]\nr = 0.9\n[[phase.spawn]]\nkind = \"burn\"\nat = [4, 1.4]\nr = 0.9\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"If I die on your table, Perpetua, you'll have to fill out the form.\"]\n[[phase.event]]\nat_time = 4\nsay = [\"pet\", \"I have been looking forward to it.\"]\n\n[[phase]]\nname = \"Embers\"\nobjective = \"Cryoprobe an ember, Scalpel to crack it, Forceps the pieces. Lift on the ring.\"\ncheckpoint = true\nmeter = 5\nstrain = { kind = \"dies_irae\", count = 5, rings = 5, fever = 0.9, furnace = true, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"Fever's climbing. And now it's in five-four. Nobody can dance to five-four. That's the point, isn't it.\"]\nbanner = \"5/4\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 6\nsay = [\"pet\", \"When it counts in, take your finger off. Every fifth beat. It's not hard. It's only frightening.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close the sac.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3, -2.6]\npts = [[-4.6, -2.6], [-3, -3], [-1.4, -2.7]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3, -2.6]\npts = [[1.4, -2.7], [3, -3], [4.6, -2.6]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 3]\npts = [[-5, 3], [0, 2.7], [5, 3]]\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Adequate.\"]\nEOF\ncat > cases/case7.toml <<EOF\nname = \"Libera Me\"\nsurgeon = \"both\"\nplate = \"heart\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"cryo\", \"iv\"]\ntimer = 540\npar = 24000\npatient = \"Bashir Haddad\"\nlife = \"OR scrub nurse, twenty-two years. Says Doctor fourteen different ways.\"\ndiagnosis = \"Every strain at once, delivered by a bouquet. Time signature: all of them.\"\nfate = \"Bashir Haddad was back on shift in six weeks. He reports the flowers were not his taste.\"\nfate_lost = \"They ran the theatre in silence for a month. Nobody could bring themselves to say Doctor.\"\nbefore = \"case7_before\"\nafter = \"case7_after\"\ngift = true\n\n[[phase]]\nname = \"A: Introit\"\nobjective = \"Pools and nodules. Laser at rest, Forceps within two beats.\"\nmeter = 3\nstrain = { kind = \"introit\", waves = 3, amen = false, visible = true, tough = 0.8, at = [0, 0.2] }\n[[phase.spawn]]\nkind = \"pool\"\nat = [-5, 2]\nr = 1.2\n[[phase.spawn]]\nkind = \"pool\"\nat = [5.2, -1.6]\nr = 1.1\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"...I'll call it. I've seen it done. Mostly. Three-four, guys. Everything's fine.\"]\nbanner = \"3/4\"\n[[phase.event]]\nat_time = 5\nsay = [\"pet\", \"Good, Mara. Keep up. He'd only tell you to.\"]\n\n[[phase]]\nname = \"B: Lacrimosa\"\nobjective = \"Sacs on the coronaries. Take the stems. Cut the eye.\"\ncheckpoint = true\nmeter = 6\nstrain = { kind = \"lacrimosa\", waves = 2, count = 5, beats = 14, at = [0.2, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"Six-eight! Sacs on the coronaries! That's bad! I'm told that's bad!\"]\nbanner = \"6/8\"\n\n[[phase]]\nname = \"C: Dies Irae\"\nobjective = \"Embers and rings, in seven. Lift on the ring.\"\ncheckpoint = true\nmeter = 7\nstrain = { kind = \"dies_irae\", count = 3, rings = 7, fever = 0, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"pet\", \"Seven-eight. Show-off. Count with me, child, and lift.\"]\nbanner = \"7/8\"\n\n[[phase]]\nname = \"D: Stopped\"\nobjective = \"It stopped the heart on purpose. Three shocks, each on the ghost.\"\ncheckpoint = true\nstrain = { kind = \"shocks\", count = 3 }\n[[phase.event]]\nat_time = 0.2\nsay = [\"mara\", \"It's holding its breath. It wants us to listen.\"]\n\n[[phase]]\nname = \"E: The Soloist\"\nobjective = \"The Soloist. Scalpel on the beat. Then the spine, in diastole.\"\ncheckpoint = true\nmeter = 4\nstrain = { kind = \"soloist\", count = 14, beats = 6, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.2\nsay = [\"pet\", \"There's the soloist. Everything else was the orchestra.\"]\nbanner = \"THE SOLOIST\"\ncue = \"stinger\"\nshake = 1\n[[phase.event]]\nat_time = 3\nsay = [\"mara\", \"Dr. Nwosu. Your hands. My ears.\"]\n[[phase.event]]\nat_time = 4.5\ngift = true\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close him. Dress it.\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3, 2.4]\npts = [[-4.8, 2.3], [-3, 2.8], [-1.2, 2.4]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3, 2.4]\npts = [[1.2, 2.4], [3, 2.8], [4.8, 2.3]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, -2.8]\npts = [[-5, -2.7], [0, -3.1], [5, -2.7]]\n[[phase.event]]\nat_time = 0.4\nsay = [\"bashir\", \"Clean, Doctor.\"]\ncue = \"good\"\n[[phase.event]]\nat_time = 3\nsay = [\"teddy\", \"He's... he's awake. He's correcting you. Oh, thank God.\"]\nEOF\ncat > cases/codeblue.toml <<EOF\nname = \"Code Blue\"\nsurgeon = \"all\"\nplate = \"torso\"\n$RING\ntimer = 240\npar = 26000\npatient = \"John Doe, Ward Nine\"\nlife = \"Nobody has claimed him. Everybody has an opinion.\"\ndiagnosis = \"All of it, at once, and the board keeps adding more.\"\nfate = \"He woke up, asked what all the fuss was about, and left without signing out.\"\nfate_lost = \"Time of death, the board says. Nobody at the table will look at the board.\"\ngift = true\n\n[[phase]]\nname = \"Triage\"\nobjective = \"Keep the patient alive until the bell.\"\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Everybody hands in. Keep him alive until the bell.\"]\nEOF\necho written","description":"Write the level, callouts, plates and all case files"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5353,"cache_read_input_tokens":401616,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5353},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"cde005c0-e710-4795-a55a-baf2e7d7712d","timestamp":"2026-11-05T13:55:40.504Z","request_id":"req_011CgjtjmfhWjyB99MoVcKun","wire_tool_inputs":{"toolu_011LYGoHccdqDYsihRYDEGqg":{"command":"cd crates/pav_core/src/games/surgery/content\ncat > level.toml <<'EOF'\n# The operating room for the wide shots, far from the field, so it is on screen only when a story\n# camera looks at it. Puppets in scrubs stand around a table built from blocks.\n# Check it with `pav room_check path=crates/pav_core/src/games/surgery/content/level.toml`.\nname = \"The Operating Room\"\nabout = \"Mercy Harbor General, theatre three.\"\nentrance = { at = [8, 12], facing = \"south\" }\n\n[view]\nsky = \"#10282c\"\n\n[layout]\norigin = [86.0, 0.0, -9.0]\n\n[[layout.layer]]\ny = 0\nmap = '''\n################\n#..............#\n#.ss........ss.#\n#..............#\n#.....TTTT.....#\n#.....TTTT.....#\n#..............#\n#..............#\n#.ll........ll.#\n#..............#\n#..............#\n#..............#\n################\n'''\n\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 4.5, color = \"#7fa3a0\" }]\n\n[layout.legend.'T']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 0.95, color = \"#c8d0d4\", rounded = true }]\n\n[layout.legend.'s']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 1.5, color = \"#5c6a70\", rounded = true }]\n\n[layout.legend.'l']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#2f5a5c\" }, { y0 = 0, y1 = 0.8, color = \"#a0aab0\" }]\n\n[[npc]]\nname = \"surgeon\"\npos = [5.5, 0, 3.6]\nyaw = 180\nclips = [\"MESH2MOTION/Idle_Talking\"]\nlook = { shirt = \"#2e9692\", pants = \"#2e9692\", skin = \"#f2c8ac\" }\n\n[[npc]]\nname = \"nurse\"\npos = [10.5, 0, 3.6]\nyaw = 180\nclips = [\"QUATERNIUS/Idle_Loop\"]\nlook = { shirt = \"#3c68a4\", pants = \"#3c68a4\", skin = \"#be8e68\" }\n\n[[npc]]\nname = \"gas\"\npos = [8.0, 0, 7.4]\nyaw = 0\nclips = [\"QUATERNIUS/Idle_Loop\"]\nlook = { shirt = \"#5c8a54\", pants = \"#5c8a54\", skin = \"#e0b896\" }\n\n[[npc]]\nname = \"chief\"\npos = [13.2, 0, 8.6]\nyaw = 300\nclips = [\"MESH2MOTION/Idle_Talking\"]\nlook = { shirt = \"#c8ccd4\", pants = \"#30343c\", skin = \"#e8c8b0\" }\nEOF\ncat > callouts.toml <<'EOF'\n# In-op callouts, by trigger. `nurse` is whoever is calling the operation: Bashir, until he is the\n# patient. One line is picked at random each time.\n[wrong_tool]\nlines = [[\"nurse\", \"Wrong instrument, Doctor.\"], [\"nurse\", \"Not that one, Doctor.\"], [\"nurse\", \"Doctor. The other one.\"]]\n[healthy]\nlines = [[\"nurse\", \"Doctor, that's healthy tissue.\"], [\"nurse\", \"That was healthy, Doctor. It was.\"]]\n[off_axis]\nlines = [[\"nurse\", \"Along the barb, Doctor. Along it.\"], [\"nurse\", \"You tore it. Steady.\"]]\n[sloppy_suture]\nlines = [[\"nurse\", \"That stitch will leak, Doctor.\"]]\n[overheat]\nlines = [[\"nurse\", \"Too long. You've burned him.\"], [\"nurse\", \"Let go sooner, Doctor.\"]]\n[overdose]\nlines = [[\"teddy\", \"Whoa, whoa, that's too much, that's a lot of drug, that's all the drug.\"]]\n[found]\nlines = [[\"nurse\", \"There. On the monitor.\"], [\"nurse\", \"Found one. Eight seconds, Doctor.\"]]\n[immaculate]\nlines = [[\"nurse\", \"Clean. Again.\"], [\"nurse\", \"Immaculate, Doctor.\"], [\"nurse\", \"...Doctor.\"], [\"teddy\", \"Okay. Okay! Who is she?\"]]\n[clean]\nlines = [[\"nurse\", \"Clean.\"], [\"nurse\", \"Good hands, Doctor.\"], [\"nurse\", \"Next.\"]]\n[burst]\nlines = [[\"nurse\", \"Burst! Caustic on the field!\"], [\"teddy\", \"That one's crying acid! That's new! I hate that!\"]]\n[eye_open]\nlines = [[\"nurse\", \"The eye! Across it, Doctor. Now.\"], [\"mara\", \"It's looking at me. Bashir, it's looking at me.\"]]\n[missed_pull]\nlines = [[\"nurse\", \"Too slow. The shell's back.\"]]\n[lift_off]\nlines = [[\"pet\", \"Lift off! Lift off!\"], [\"nurse\", \"Lift off! Lift off!\"]]\n[scorched]\nlines = [[\"nurse\", \"Hands up on the ring, Doctor.\"], [\"pet\", \"I said lift. It's a very short word.\"]]\n[diastole]\nlines = [[\"pet\", \"Not against the beat! Wait for it to breathe!\"], [\"teddy\", \"Diastole! Pull in diastole! The squishy part!\"]]\n[vitals_forty]\nlines = [[\"nurse\", \"Vitals at forty. Push the IV. Now!\"], [\"teddy\", \"Forty! Forty and falling! IV, IV, IV!\"]]\n[code]\nlines = [[\"teddy\", \"He's flat! Paddles, paddles, paddles!\"], [\"nurse\", \"Charge. Both triggers. On the ghost.\"]]\n[code_back]\nlines = [[\"teddy\", \"Sinus rhythm! Oh, I love you. I love all of you.\"], [\"nurse\", \"We have a rhythm, Doctor.\"]]\n[code_again]\nlines = [[\"nurse\", \"Again. Charge it first, then let go on the line.\"]]\n[next_shock]\nlines = [[\"teddy\", \"Still flat! Again!\"], [\"pet\", \"Again. It's listening. Make it hear you.\"]]\n[defib_miss]\nlines = [[\"teddy\", \"That didn't take! On the line, on the line!\"]]\n[time_up]\nlines = [[\"nurse\", \"That's the time, Doctor.\"]]\n[codeblue_tempo]\nlines = [[\"teddy\", \"It's getting faster! Why is it getting faster!\"], [\"nurse\", \"Pace is up. Stay with it.\"]]\n[codeblue_finale]\nlines = [[\"nurse\", \"Something's moving under there. Scanner's clean. It's the waltz.\"]]\nEOF\ncat > plates/forearm.toml <<'EOF'\nname = \"Forearm\"\nlobes = [[0, 0.1, 150, 16, 1.2], [-3.5, -1.1, 22, 4, 0.34], [3.8, 1.2, 26, 4, 0.3], [0.5, -0.2, 40, 2.2, 0.24]]\nbed = [74, 22, 30]\nflesh = [214, 92, 84]\ntop = [246, 150, 128]\nvein = [150, 40, 60]\npulse = 0.04\nbreathe = 0.02\nveins = 0.55\nvessels = [[[-9, -2.4], [-5, -1.6], [-1, -2], [3, -1.2], [9, -1.8]], [[-9, 2.2], [-3, 1.7], [2, 2.5], [9, 2]]]\nEOF\ncat > plates/abdomen.toml <<'EOF'\nname = \"Abdomen, skin\"\nlobes = [[0, 0.1, 150, 34, 1.25]]\nbed = [70, 40, 40]\nflesh = [226, 176, 148]\ntop = [250, 214, 190]\nvein = [196, 138, 124]\npulse = 0.02\nbreathe = 0.07\nveins = 0.14\nnoise = 0.25\nwet = 0.2\nEOF\ncat > plates/bowel.toml <<'EOF'\nname = \"Bowel\"\nlobes = [[-6, -2.2, 8, 3, 0.9], [-2.2, -2.5, 9, 2.6, 0.95], [2, -2.4, 9, 2.8, 0.9], [6, -2, 8, 3, 0.95], [-7, 0.8, 7, 3, 1], [-3, 0.6, 8, 2.8, 1.05], [1.2, 0.8, 9, 3, 1], [5.5, 0.9, 8, 3, 1], [-5, 3.2, 8, 2.5, 0.9], [-1, 3.3, 8, 2.4, 0.95], [3.4, 3.3, 8, 2.4, 0.9], [7.5, 3.1, 6, 2.5, 0.9]]\nbed = [84, 26, 36]\nflesh = [226, 118, 104]\ntop = [252, 176, 148]\nvein = [168, 56, 72]\npulse = 0.05\nbreathe = 0.06\nveins = 0.45\nwet = 0.8\nEOF\ncat > plates/chest.toml <<'EOF'\nname = \"Chest, skin\"\nlobes = [[0, 0.1, 150, 34, 1.15]]\nbed = [62, 34, 34]\nflesh = [214, 156, 130]\ntop = [244, 198, 172]\nvein = [186, 124, 112]\npulse = 0.05\nbreathe = 0.09\nveins = 0.14\nnoise = 0.25\nwet = 0.2\nridges = [[[-8, -2.8], [-3, -3.2], [3, -3.2], [8, -2.8]], [[-8, -0.6], [-3, -1], [3, -1], [8, -0.6]], [[-8, 1.7], [-3, 1.3], [3, 1.3], [8, 1.7]]]\nEOF\ncat > plates/lung.toml <<'EOF'\nname = \"Lung and rib\"\nlobes = [[-4.2, 0.2, 34, 22, 1.2], [4.4, 0.1, 34, 22, 1.25], [0, 0, 8, 26, 0.5]]\nbed = [58, 30, 44]\nflesh = [226, 134, 140]\ntop = [250, 190, 186]\nvein = [160, 62, 92]\npulse = 0.04\nbreathe = 0.16\nveins = 0.7\nwet = 0.65\nvessels = [[[0, -4.5], [-2, -2], [-5, -1.2], [-8, -1.8]], [[0, -4.5], [2, -1.6], [5, -0.8], [8, -1.4]]]\nridges = [[[-9, 4.6], [-3, 4.1], [3, 4.1], [9, 4.6]]]\nEOF\ncat > plates/liver.toml <<'EOF'\nname = \"Liver\"\nlobes = [[-2.2, 0, 62, 24, 1.3], [5.2, 0.6, 22, 13, 1], [-7, -0.4, 10, 12, 0.7]]\nbed = [46, 16, 22]\nflesh = [150, 58, 56]\ntop = [206, 96, 84]\nvein = [96, 26, 44]\npulse = 0.05\nbreathe = 0.1\nveins = 0.5\nwet = 0.9\nvessels = [[[9, 4], [5, 2.5], [1, 2.7], [-3, 1.7]], [[9, -4], [4, -2.5], [0, -2.9]]]\nEOF\ncat > plates/femur.toml <<'EOF'\nname = \"Femur\"\nlobes = [[0, 0.1, 150, 34, 0.9], [0, 0.1, 110, 3.4, 0.8]]\nbed = [64, 22, 28]\nflesh = [190, 78, 74]\ntop = [242, 222, 196]\nvein = [120, 32, 48]\npulse = 0.03\nbreathe = 0.02\nveins = 0.35\nwet = 0.5\nvessels = [[[-9, -3.4], [-3, -2.8], [3, -3.5], [9, -3]]]\nEOF\ncat > plates/pericardium.toml <<'EOF'\nname = \"Pericardium\"\nlobes = [[0, 0.1, 70, 26, 1.45], [-4, -0.8, 20, 10, 0.4], [4, 0.8, 20, 10, 0.4]]\nbed = [56, 18, 28]\nflesh = [206, 106, 92]\ntop = [244, 186, 150]\nvein = [140, 42, 58]\npulse = 0.13\nbreathe = 0.08\nveins = 0.6\nwet = 0.75\nvessels = [[[-8, -3], [-3, -1.6], [0, 0], [4, 1.8], [8, 3.4]]]\nEOF\ncat > plates/furnace.toml <<'EOF'\nname = \"The Furnace\"\nlobes = [[0, 0.1, 70, 26, 1.45], [0, 0, 6, 3, -0.45]]\nbed = [40, 8, 14]\nflesh = [148, 40, 36]\ntop = [240, 120, 60]\nvein = [255, 140, 60]\npulse = 0.16\nbreathe = 0.08\nveins = 0.85\nwet = 0.6\nEOF\ncat > plates/heart.toml <<'EOF'\nname = \"The Heart\"\nlobes = [[-1.6, -0.6, 42, 16, 1.55], [2.8, 0.7, 26, 15, 1.35], [0.5, 2.4, 14, 7, 0.8]]\nbed = [46, 12, 22]\nflesh = [186, 62, 60]\ntop = [240, 128, 104]\nvein = [130, 28, 52]\npulse = 0.34\nbreathe = 0.06\nveins = 0.55\nwet = 0.9\nvessels = [[[0.5, -5], [0.8, -2.5], [-0.2, 0], [0.6, 2.2], [0.2, 4]], [[-0.2, -1], [-3, -0.2], [-5, 1], [-6.5, 2.8]], [[0.7, -2.2], [3, -1], [5, 1], [6.3, 3]]]\nvessel_color = [180, 70, 40]\nEOF\ncat > plates/torso.toml <<'EOF'\nname = \"Torso\"\nlobes = [[0, 0.1, 150, 34, 1.15], [-3.6, -0.8, 22, 9, 0.3], [3.6, -0.8, 22, 9, 0.3]]\nbed = [74, 22, 30]\nflesh = [214, 92, 84]\ntop = [246, 150, 128]\nvein = [150, 40, 60]\npulse = 0.09\nbreathe = 0.11\nveins = 0.5\nwet = 0.6\nvessels = [[[-9, 3.8], [-3, 3], [3, 3.2], [9, 3.8]]]\nEOF\nRING='ring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"scanner\", \"iv\"]'\ncat > cases/case0.toml <<EOF\nname = \"Barbs\"\nsurgeon = \"mara\"\nplate = \"forearm\"\n$RING\ntimer = 240\npar = 6000\npatient = \"Anton Deverell\"\nlife = \"Net-mender, Pier Nine. Forty years of other men's knots.\"\ndiagnosis = \"Forearm full of hooks and cable splinters, inflamed. The storm took his boat's winch.\"\nfate = \"Anton Deverell will mend nets again by spring.\"\nfate_lost = \"Anton Deverell's nets stayed on the pier. Nobody else can read his knots.\"\nbefore = \"case0_before\"\nafter = \"case0_after\"\nguided = true\n\n[[phase]]\nname = \"Prep\"\nobjective = \"Gel the inflamed skin. Hold it and paint.\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [-4.2, -0.5]\nr = 0.9\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [0.4, 1.2]\nr = 0.85\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [4.6, -0.9]\nr = 0.9\ntag = \"inflammation\"\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Gel, Doctor. Flick it, then paint until the ring is full.\"]\n\n[[phase]]\nname = \"Hooks\"\nobjective = \"Forceps. Grab each hook and pull along its arrow.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-5.4, 1]\naxis = -60\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-1.8, -1.4]\naxis = 200\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [2, 1.5]\naxis = 20\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [5.5, -1]\naxis = -120\ntag = \"hook\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.4, 2.5]\npts = [[-4.4, 2.4], [-3.4, 2.7], [-2.4, 2.4]]\noptional = true\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Forceps, Doctor. Lift the mass. ...Doctor.\"]\n[[phase.event]]\nremaining = 2\nsay = [\"bashir\", \"Along the barb. It came in one way. It leaves the same way.\"]\n\n[[phase]]\nname = \"Splinters\"\nobjective = \"Suction the blood. Something is under it.\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-3.3, -0.8]\naxis = 160\ntag = \"splinter\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.6, 0.9]\naxis = 70\ntag = \"splinter\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [3.8, 1.2]\naxis = -30\ntag = \"shard\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [3.8, 1.2]\nr = 1.5\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"That pool is hiding one. Suction. Harder drains faster.\"]\nbanner = \"SOMETHING UNDER THE BLOOD\"\ncue = \"stinger\"\n\n[[phase]]\nname = \"Close\"\nobjective = \"Suture each wound. Zigzag across, near the needle.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.6, 0.2]\npts = [[-5.4, 0.8], [-4.2, 0], [-3, 0.4], [-1.8, -0.2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.2, -0.4]\npts = [[1.8, -0.2], [3, -0.8], [4.6, -0.5]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Suture. Back and forth across the wound, even and quick.\"]\n\n[[phase]]\nname = \"Dress\"\nobjective = \"Dressing. Draw along the closure.\"\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 0]\npts = [[-6, 0.3], [-2, -0.3], [2, 0.3], [6, -0.2]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Last thing. Dress it. He'll want the arm back.\"]\nEOF\ncat > cases/case1.toml <<EOF\nname = \"Routine\"\nsurgeon = \"mara\"\nplate = \"abdomen\"\n$RING\ntimer = 270\npar = 8000\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. Has never once run a ship aground, and mentions it.\"\ndiagnosis = \"Acute appendicitis. Routine, the board says, underlined twice.\"\nfate = \"Rosalind Pike was back on the pilot boat in a fortnight, complaining about the tea.\"\nfate_lost = \"The harbour flew its flags low for Rosalind Pike, and the ships came in slower.\"\nbefore = \"case1_before\"\nafter = \"case1_after\"\nguided = true\n\n[[phase]]\nname = \"Open\"\nobjective = \"Scalpel. Follow the dashed line, one stroke.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [0, 0]\npts = [[-4.8, -0.5], [-2, -0.8], [1, -0.4], [4.8, -0.7]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"bashir\", \"Scalpel, Doctor. One stroke. Stay on the line.\"]\n\n[[phase]]\nname = \"Polyps\"\nobjective = \"Laser the polyps. Let go when the ring is nearly full.\"\nplate = \"bowel\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-6, -1.6]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-4.8, -0.9]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.2, 1.1]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [0.2, 2.2]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.6, -1.8]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [5, -0.7]\nr = 0.36\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Laser. Hold it on one. Eighty to a hundred on the ring, then let go.\"]\n\n[[phase]]\nname = \"Appendix\"\nobjective = \"Gel the inflammation, then lift the appendix out.\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [1.8, 0.4]\nr = 1.2\ntag = \"inflammation\"\n[[phase.spawn]]\nkind = \"foreign\"\nat = [1.8, 0.4]\naxis = -70\nr = 0.5\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [-3, 2.3]\nr = 1\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Dr. Quill. The appendix is the part that is not supposed to be on fire.\"]\n\n[[phase]]\nname = \"Complication\"\nobjective = \"The artery! Stitch the bleeder. IV Push if the vitals fall.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-1, 0.4]\naxis = 30\n[[phase.spawn]]\nkind = \"pool\"\nat = [-1.4, 1.1]\nr = 1.3\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.2, 2.1]\npts = [[2.2, 1.7], [3.4, 2.3], [4.6, 2]]\n[[phase.event]]\nat_time = 0.1\nsay = [\"teddy\", \"That's arterial! That's a lot of arterial! Pressure's dropping, guys!\"]\nbanner = \"AN ARTERY LET GO\"\nshake = 1\ncue = \"alarm\"\nvitals = -22\n[[phase.event]]\nat_time = 1.8\nsay = [\"bashir\", \"Three quick crossings on the bleeder. IV Push for the numbers. Green band, then let go.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close the skin, then dress it.\"\nplate = \"abdomen\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [0, 0]\npts = [[-4.8, -0.5], [-2, -0.8], [1, -0.4], [4.8, -0.7]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 1.4]\npts = [[-5, 1.5], [-1, 1.2], [3, 1.5], [5, 1.3]]\nEOF\ncat > cases/case2.toml <<EOF\nname = \"Shrapnel Night\"\nsurgeon = \"mara\"\nplate = \"chest\"\n$RING\ntimer = 300\npar = 10000\npatient = \"Gideon Marr\"\nlife = \"Foreman, Grain Terminal Two. Ran back in for the night shift's lunch tins.\"\ndiagnosis = \"Blast injury. Chest full of machine parts nobody can count from out here.\"\nfate = \"Gideon Marr woke up asking after his crew. All eleven of them came to ask after him.\"\nfate_lost = \"Eleven men carried Gideon Marr's lunch tin to the harbour wall.\"\nbefore = \"case2_before\"\nafter = \"case2_after\"\n\n[[phase]]\nname = \"Open\"\nobjective = \"Two incisions, between the ribs.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [-3.6, 0.3]\npts = [[-6.2, 0.4], [-3.6, 0.1], [-1, 0.4]]\n[[phase.spawn]]\nkind = \"incision\"\nat = [3.6, 0.3]\npts = [[1, 0.4], [3.6, 0.1], [6.2, 0.4]]\n[[phase.event]]\nat_time = 0.2\nsay = [\"teddy\", \"No rush! Except, you know. A lot of rush.\"]\n\n[[phase]]\nname = \"Shrapnel\"\nobjective = \"Scanner. Sweep for the metal, then forceps.\"\nplate = \"lung\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-5.4, -1.6]\naxis = 200\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [-2.6, 1.8]\naxis = 110\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [2.4, -2]\naxis = -70\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [5.4, 1.2]\naxis = 10\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.6, 0.3]\naxis = 240\ntag = \"shard\"\nhidden = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, 2.4]\npts = [[-6, 2.1], [-5, 2.7], [-3.8, 2.4]]\noptional = true\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Scanner, Doctor. Hold and sweep. What it finds stays lit for eight seconds.\"]\n\n[[phase]]\nname = \"Arrest\"\nobjective = \"The heart stopped. Charge, then shock on the ghost beat.\"\n[[phase.event]]\nat_time = 0.6\nsay = [\"mara\", \"Now.\"]\n[[phase.event]]\nat_time = 1.1\ncode = true\nsay = [\"teddy\", \"Wait, how did she... He's flat! He just went flat!\"]\n\n[[phase]]\nname = \"Bleeders\"\nobjective = \"Stitch the bleeders. Clear the field.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-3.8, -0.8]\naxis = 80\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [3.6, 1]\naxis = 150\n[[phase.spawn]]\nkind = \"pool\"\nat = [-3.1, 0.1]\nr = 1.2\n[[phase.spawn]]\nkind = \"laceration\"\nat = [0, -2.3]\npts = [[-1.4, -2.2], [0, -2.6], [1.5, -2.2]]\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.4, 2.1]\naxis = 35\ntag = \"shard\"\nhidden = true\n[[phase.event]]\nat_time = 0.5\nsay = [\"bashir\", \"Back with us. Two bleeders. And I count one more piece of the terminal.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close and dress.\"\nplate = \"chest\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3.6, 0.3]\npts = [[-6.2, 0.4], [-3.6, 0.1], [-1, 0.4]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.6, 0.3]\npts = [[1, 0.4], [3.6, 0.1], [6.2, 0.4]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2]\npts = [[-5, 2], [0, 1.7], [5, 2]]\nEOF\ncat > cases/case3.toml <<EOF\nname = \"Something Moved\"\nsurgeon = \"mara\"\nplate = \"liver\"\n$RING\ntimer = 360\npar = 15000\npatient = \"Ines Calloway\"\nlife = \"Courier for the Vane Foundation. Carries sealed envelopes and asks nothing.\"\ndiagnosis = \"Benign liver mass. Elective. Should take forty minutes and a good night's sleep.\"\nfate = \"Ines Calloway has been told it was a benign mass. She has stopped sleeping anyway.\"\nfate_lost = \"Ines Calloway's last envelope was never delivered. Someone came for it the same night.\"\nbefore = \"case3_before\"\nafter = \"case3_after\"\n\n[[phase]]\nname = \"Approach\"\nobjective = \"Open the capsule. Laser the polyps on the way.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [-3, -2.4]\npts = [[-6, -2.2], [-3, -2.7], [0, -2.4]]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.6, -2.2]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [5.6, -0.8]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\nat = [4.8, 1.6]\n[[phase.event]]\nat_time = 0.4\nsay = [\"bashir\", \"Benign mass, Doctor. Elective. I brought a sandwich.\"]\n\n[[phase]]\nname = \"The Mass\"\nobjective = \"Cut around the mass, lift it out, gel the bed.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"tumor\"\nat = [-1, 0.6]\naxis = -90\nr = 1.2\n[[phase.event]]\nremaining = 1\nat_time = 0.3\nsay = [\"bashir\", \"Ring cut. Then forceps. Then gel.\"]\n\n[[phase]]\nname = \"Introit\"\nobjective = \"It moved. Scanner to find it, Laser at rest, Forceps quickly.\"\ncheckpoint = true\nmeter = 3\nstrain = { kind = \"introit\", waves = 4, tough = 1.0, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.1\nsay = [\"mara\", \"It moved.\"]\ncue = \"stinger\"\nshake = 0.7\n[[phase.event]]\nat_time = 2.8\nsay = [\"bashir\", \"Masses don't move.\"]\n[[phase.event]]\nat_time = 5.2\nsay = [\"mara\", \"Bashir. It moved.\"]\n[[phase.event]]\nat_time = 8.2\nsay = [\"teddy\", \"Guys? The ECG just went into three-four time. That's a waltz. Hearts aren't in a time signature. Hearts aren't allowed.\"]\nbanner = \"3/4\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 14.0\nsay = [\"bashir\", \"Scanner to find it. Laser while it rests. Forceps within two beats, or the shell comes back.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Repair what it left behind. Then close.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-4, 1.4]\npts = [[-5.4, 1.2], [-4, 1.7], [-2.6, 1.3]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.8, -1]\npts = [[2.6, -0.8], [3.8, -1.3], [5, -0.9]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2.7]\npts = [[-5, 2.7], [0, 2.4], [5, 2.7]]\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Finish. Then you will wash your hands.\"]\nEOF\ncat > cases/case4.toml <<EOF\nname = \"The Night Ward\"\nsurgeon = \"mara\"\nplate = \"lung\"\n$RING\ntimer = 360\npar = 16000\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. Came back for a follow-up. Did not expect a follow-up like this.\"\ndiagnosis = \"Lacrimosa strain, seeded in recovery. Bilateral. Nothing on any chart anywhere.\"\nfate = \"Rosalind Pike believes she had a bad reaction to the anaesthetic. Dr. Quill signed the form that says so.\"\nfate_lost = \"The pilot boat went out without Rosalind Pike. The ships came in crooked for a month.\"\nbefore = \"case4_before\"\nafter = \"case4_after\"\ngift = true\n\n[[phase]]\nname = \"Flood\"\nobjective = \"Clear the flood. Find what's feeding it.\"\n[[phase.spawn]]\nkind = \"pool\"\nat = [-4.8, -1]\nr = 1.5\n[[phase.spawn]]\nkind = \"pool\"\nat = [4.6, 1.3]\nr = 1.6\n[[phase.spawn]]\nkind = \"pool\"\nat = [0.2, 2.4]\nr = 1.1\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [-4.8, -1]\naxis = 45\n[[phase.spawn]]\nkind = \"bleeder\"\nat = [4.6, 1.3]\naxis = 110\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]\naxis = -50\ntag = \"seed\"\nhidden = true\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"No guidance, Doctor. Not tonight. Nobody down here has done this and lived to write it up.\"]\n\n[[phase]]\nname = \"Lacrimosa\"\nobjective = \"Laser the stems before they burst. Then cut the eye.\"\ncheckpoint = true\nmeter = 6\nstrain = { kind = \"lacrimosa\", waves = 3, count = 6, beats = 15, at = [0, 0.1] }\n[[phase.event]]\nat_time = 0.4\nsay = [\"teddy\", \"Six-eight. It's in six-eight. It's a lullaby. I'd like to go home.\"]\nbanner = \"6/8\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 4.5\nsay = [\"mara\", \"They swell on the beat. Take the stems.\"]\n\n[[phase]]\nname = \"Repair\"\nobjective = \"Stitch, soothe, and close her.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-4, 1.8]\npts = [[-5.6, 1.6], [-4.2, 2.2], [-2.8, 1.8]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3.8, -2]\npts = [[2.6, -1.8], [3.8, -2.4], [5.2, -2]]\n[[phase.spawn]]\nkind = \"burn\"\nat = [0.4, -1.2]\nr = 1\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 3.1]\npts = [[-5, 3.1], [0, 2.8], [5, 3.1]]\nEOF\ncat > cases/case5.toml <<EOF\nname = \"Second Opinion\"\nsurgeon = \"pet\"\nplate = \"femur\"\n$RING\ntimer = 360\npar = 15000\npatient = \"Tomasz Bell\"\nlife = \"Longshoreman. Caught a falling container and, regrettably, held it for a moment.\"\ndiagnosis = \"Shattered femur. Then, on the second film, something growing in the marrow.\"\nfate = \"Tomasz Bell walks with a stick now. He has stopped catching things.\"\nfate_lost = \"The union took up a collection for Tomasz Bell's boys. It was a good collection.\"\nbefore = \"case5_before\"\nafter = \"case5_after\"\ntremor = true\n\n[[phase]]\nname = \"Reduction\"\nobjective = \"Forceps: carry each fragment home, turn it, wire it.\"\n[[phase.spawn]]\nkind = \"bone\"\nat = [-4.4, -2.3]\nto = [-3.2, 0.1]\nangle = 40\naxis = 0\n[[phase.spawn]]\nkind = \"bone\"\nat = [2.6, 2.6]\nto = [0, 0.1]\nangle = -50\naxis = 0\n[[phase.spawn]]\nkind = \"bone\"\nat = [5.4, -2.2]\nto = [3.2, 0.1]\nangle = 70\naxis = 0\n[[phase.event]]\nat_time = 0.3\nsay = [\"pet\", \"Carry it, turn it with the shoulder buttons, set it, wire it. A child could. I've seen children try.\"]\n[[phase.event]]\nat_time = 7.0\nsay = [\"pet\", \"Yes, it shakes. No, I don't want your opinion of it.\"]\n\n[[phase]]\nname = \"Marrow\"\nobjective = \"Cysts in the marrow. Laser them.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-5.6, 0.1]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-3.4, -0.3]\nr = 0.36\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1, 0.4]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, -0.3]\nr = 0.36\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [3.8, 0.5]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [6, -0.2]\nr = 0.36\ntag = \"cyst\"\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Doctor. There are cysts in the marrow. That film was clean this morning.\"]\n[[phase.event]]\nremaining = 3\nsay = [\"pet\", \"They're keeping time. Hm. There you are, you old fool.\"]\ngift = true\ncue = \"gift_ready\"\nshake = 0.6\n\n[[phase]]\nname = \"The Echo\"\nobjective = \"Your hands split. Take the Echo: whatever you do, they do again.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, -2]\npts = [[-6.2, -1.8], [-5, -2.4], [-3.8, -2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-5, 2.4]\npts = [[-6.2, 2.1], [-5, 2.6], [-3.8, 2.3]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [5, -2]\npts = [[3.8, -1.8], [5, -2.4], [6.2, -2]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [5, 2.4]\npts = [[3.8, 2.1], [5, 2.6], [6.2, 2.3]]\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.6, -2.6]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, -2.6]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-1.6, 2.8]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"polyp\"\nat = [1.6, 2.8]\ntag = \"cyst\"\n[[phase.spawn]]\nkind = \"burn\"\nat = [0, -1.8]\nr = 0.7\n[[phase.event]]\nat_time = 1.4\nsay = [\"bashir\", \"Doctor Nwosu... there were two of you.\"]\n[[phase.event]]\nat_time = 5\nsay = [\"pet\", \"There were always two of me, young man. One of them retired.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Set the last piece and dress it.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"bone\"\nat = [-1.6, -2.2]\nto = [-1.5, 0.1]\nangle = -30\naxis = 0\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 2.9]\npts = [[-5, 2.9], [0, 2.6], [5, 2.9]]\nEOF\ncat > cases/case6.toml <<EOF\nname = \"Dies Irae\"\nsurgeon = \"pet\"\nplate = \"pericardium\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"cryo\", \"gel\", \"laser\", \"iv\"]\ntimer = 420\npar = 18000\npatient = \"Chief Ottoline Voss\"\nlife = \"Chief of Surgery. Eleven years of carrying this, and three decades of saying adequate.\"\ndiagnosis = \"Dies Irae strain, pericardial. She designed the host-entrainment. She is the host.\"\nfate = \"Ottoline Voss sat up on the second day and corrected the nurse's chart. She was right.\"\nfate_lost = \"The form was filled out by Perpetua Nwosu, in her best hand. It took her a very long time.\"\nbefore = \"case6_before\"\nafter = \"case6_after\"\ngift = true\ntremor = true\n\n[[phase]]\nname = \"Open\"\nobjective = \"Open the sac. Soothe the burns.\"\n[[phase.spawn]]\nkind = \"incision\"\nat = [0, -2.8]\npts = [[-4.6, -2.6], [-1.6, -3], [1.6, -3], [4.6, -2.6]]\n[[phase.spawn]]\nkind = \"burn\"\nat = [-4, 1]\nr = 0.9\n[[phase.spawn]]\nkind = \"burn\"\nat = [4, 1.4]\nr = 0.9\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"If I die on your table, Perpetua, you'll have to fill out the form.\"]\n[[phase.event]]\nat_time = 4\nsay = [\"pet\", \"I have been looking forward to it.\"]\n\n[[phase]]\nname = \"Embers\"\nobjective = \"Cryoprobe an ember, Scalpel to crack it, Forceps the pieces. Lift on the ring.\"\ncheckpoint = true\nmeter = 5\nstrain = { kind = \"dies_irae\", count = 5, rings = 5, fever = 0.9, furnace = true, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"Fever's climbing. And now it's in five-four. Nobody can dance to five-four. That's the point, isn't it.\"]\nbanner = \"5/4\"\ncue = \"alarm\"\n[[phase.event]]\nat_time = 6\nsay = [\"pet\", \"When it counts in, take your finger off. Every fifth beat. It's not hard. It's only frightening.\"]\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close the sac.\"\ncheckpoint = true\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3, -2.6]\npts = [[-4.6, -2.6], [-3, -3], [-1.4, -2.7]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3, -2.6]\npts = [[1.4, -2.7], [3, -3], [4.6, -2.6]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, 3]\npts = [[-5, 3], [0, 2.7], [5, 3]]\n[[phase.event]]\nat_time = 0.3\nsay = [\"voss\", \"Adequate.\"]\nEOF\ncat > cases/case7.toml <<EOF\nname = \"Libera Me\"\nsurgeon = \"both\"\nplate = \"heart\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"cryo\", \"iv\"]\ntimer = 540\npar = 24000\npatient = \"Bashir Haddad\"\nlife = \"OR scrub nurse, twenty-two years. Says Doctor fourteen different ways.\"\ndiagnosis = \"Every strain at once, delivered by a bouquet. Time signature: all of them.\"\nfate = \"Bashir Haddad was back on shift in six weeks. He reports the flowers were not his taste.\"\nfate_lost = \"They ran the theatre in silence for a month. Nobody could bring themselves to say Doctor.\"\nbefore = \"case7_before\"\nafter = \"case7_after\"\ngift = true\n\n[[phase]]\nname = \"A: Introit\"\nobjective = \"Pools and nodules. Laser at rest, Forceps within two beats.\"\nmeter = 3\nstrain = { kind = \"introit\", waves = 3, amen = false, visible = true, tough = 0.8, at = [0, 0.2] }\n[[phase.spawn]]\nkind = \"pool\"\nat = [-5, 2]\nr = 1.2\n[[phase.spawn]]\nkind = \"pool\"\nat = [5.2, -1.6]\nr = 1.1\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"...I'll call it. I've seen it done. Mostly. Three-four, guys. Everything's fine.\"]\nbanner = \"3/4\"\n[[phase.event]]\nat_time = 5\nsay = [\"pet\", \"Good, Mara. Keep up. He'd only tell you to.\"]\n\n[[phase]]\nname = \"B: Lacrimosa\"\nobjective = \"Sacs on the coronaries. Take the stems. Cut the eye.\"\ncheckpoint = true\nmeter = 6\nstrain = { kind = \"lacrimosa\", waves = 2, count = 5, beats = 14, at = [0.2, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"teddy\", \"Six-eight! Sacs on the coronaries! That's bad! I'm told that's bad!\"]\nbanner = \"6/8\"\n\n[[phase]]\nname = \"C: Dies Irae\"\nobjective = \"Embers and rings, in seven. Lift on the ring.\"\ncheckpoint = true\nmeter = 7\nstrain = { kind = \"dies_irae\", count = 3, rings = 7, fever = 0, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.3\nsay = [\"pet\", \"Seven-eight. Show-off. Count with me, child, and lift.\"]\nbanner = \"7/8\"\n\n[[phase]]\nname = \"D: Stopped\"\nobjective = \"It stopped the heart on purpose. Three shocks, each on the ghost.\"\ncheckpoint = true\nstrain = { kind = \"shocks\", count = 3 }\n[[phase.event]]\nat_time = 0.2\nsay = [\"mara\", \"It's holding its breath. It wants us to listen.\"]\n\n[[phase]]\nname = \"E: The Soloist\"\nobjective = \"The Soloist. Scalpel on the beat. Then the spine, in diastole.\"\ncheckpoint = true\nmeter = 4\nstrain = { kind = \"soloist\", count = 14, beats = 6, at = [0, 0.2] }\n[[phase.event]]\nat_time = 0.2\nsay = [\"pet\", \"There's the soloist. Everything else was the orchestra.\"]\nbanner = \"THE SOLOIST\"\ncue = \"stinger\"\nshake = 1\n[[phase.event]]\nat_time = 3\nsay = [\"mara\", \"Dr. Nwosu. Your hands. My ears.\"]\n[[phase.event]]\nat_time = 4.5\ngift = true\n\n[[phase]]\nname = \"Close\"\nobjective = \"Close him. Dress it.\"\n[[phase.spawn]]\nkind = \"laceration\"\nat = [-3, 2.4]\npts = [[-4.8, 2.3], [-3, 2.8], [-1.2, 2.4]]\n[[phase.spawn]]\nkind = \"laceration\"\nat = [3, 2.4]\npts = [[1.2, 2.4], [3, 2.8], [4.8, 2.3]]\n[[phase.spawn]]\nkind = \"closure\"\nat = [0, -2.8]\npts = [[-5, -2.7], [0, -3.1], [5, -2.7]]\n[[phase.event]]\nat_time = 0.4\nsay = [\"bashir\", \"Clean, Doctor.\"]\ncue = \"good\"\n[[phase.event]]\nat_time = 3\nsay = [\"teddy\", \"He's... he's awake. He's correcting you. Oh, thank God.\"]\nEOF\ncat > cases/codeblue.toml <<EOF\nname = \"Code Blue\"\nsurgeon = \"all\"\nplate = \"torso\"\n$RING\ntimer = 240\npar = 26000\npatient = \"John Doe, Ward Nine\"\nlife = \"Nobody has claimed him. Everybody has an opinion.\"\ndiagnosis = \"All of it, at once, and the board keeps adding more.\"\nfate = \"He woke up, asked what all the fuss was about, and left without signing out.\"\nfate_lost = \"Time of death, the board says. Nobody at the table will look at the board.\"\ngift = true\n\n[[phase]]\nname = \"Triage\"\nobjective = \"Keep the patient alive until the bell.\"\n[[phase.event]]\nat_time = 0.3\nsay = [\"bashir\", \"Everybody hands in. Keep him alive until the bell.\"]\nEOF\necho written","description":"Write the level, callouts, plates and all case files"}}}
