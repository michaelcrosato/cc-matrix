{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjxsQLkX3m3UJs6c1Vo2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H9Sf5Wa2Qon5Rpgmm9pDHc","name":"Bash","input":{"command":"python3 - <<'EOF'\nC='crates/pav_core/src/games/surgery/content/cases/'\ns=open(C+'case4.toml').read()\ns=s.replace('''[[phase.spawn]]\nkind = \"bleeder\"\nat = [4.6, 1.3]\naxis = 110\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]''','''[[phase.spawn]]\nkind = \"laceration\"\nat = [4.6, 1.3]\npts = [[3.6, 1], [4.6, 1.6], [5.8, 1.2]]\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]''')\ns=s.replace('''[[phase.spawn]]\nkind = \"bleeder\"\nat = [5, 1.8]\naxis = 140\n''','''[[phase.spawn]]\nkind = \"laceration\"\nat = [5, 1.8]\npts = [[4, 1.6], [5, 2.2], [6.2, 1.8]]\n''')\nopen(C+'case4.toml','w').write(s)\np='crates/pav_core/src/games/surgery/director.rs'\ns=open(p).read()\ns=s.replace('next_wave: 0.5, interval: 11.0, tempo: 1.0','next_wave: 0.5, interval: 13.0, tempo: 1.0')\nopen(p,'w').write(s)\nEOF\nmkdir -p ../tests/hub\ncat > ../tests/run_all.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Everything, behind one command: prints only failures and a one-line count.\n\nusage: python3 tests/run_all.py [--rust] [--web] [--hub]    (no flags: all of it)\nRun with the system python3, without -I: -I hides Playwright.\n\"\"\"\nimport pathlib\nimport re\nimport subprocess\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent\nENGINE = ROOT.parent / \"engine\"\npassed = failed = 0\n\n\ndef run_cargo(args):\n    global passed, failed\n    r = subprocess.run([\"cargo\", \"test\", \"--offline\", *args], cwd=ENGINE, capture_output=True, text=True, env={**__import__(\"os\").environ, \"CARGO_BUILD_JOBS\": \"10\"})\n    out = r.stdout + r.stderr\n    for m in re.finditer(r\"test result: \\w+\\. (\\d+) passed; (\\d+) failed\", out):\n        passed += int(m[1])\n        failed += int(m[2])\n    if r.returncode != 0:\n        lines = [l for l in out.splitlines() if re.search(r\"FAILED|panicked|error(\\[|:)|assertion|left:|right:\", l)]\n        print(f\"cargo test {' '.join(args)} failed:\")\n        print(\"\\n\".join(lines[:40]))\n        if \"test result\" not in out:\n            failed += 1\n\n\ndef rust():\n    for args in (\n        [\"-p\", \"pav_core\", \"--test\", \"surgery\"],\n        [\"-p\", \"pav_core\", \"--lib\", \"surgery\"],\n        [\"-p\", \"pav_ui\", \"--lib\", \"surgery\"],\n        [\"-p\", \"pav_audio\", \"--lib\"],\n    ):\n        run_cargo(args)\n\n\ndef module(name):\n    global passed, failed\n    sys.path.insert(0, str(ROOT / \"browser\"))\n    mod = __import__(name)\n    p, f = mod.main()\n    passed += p\n    failed += f\n\n\nargs = set(sys.argv[1:])\nif not args or \"--rust\" in args:\n    rust()\nif not args or \"--web\" in args:\n    module(\"web_tests\")\nif not args or \"--hub\" in args:\n    module(\"hub_tests\")\nprint(f\"{passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nEOF\ncat > ../tests/browser/web_tests.py <<'EOF'\n\"\"\"The built single file, from file://, in Chromium with software WebGPU. Prints only failures.\"\"\"\nimport json\nimport sys\nimport time\nimport traceback\n\nfrom common import ARGS, OUT, key, open_game, status, sync_playwright, wait\n\nresults = []\n\n\ndef test(fn):\n    results.append(fn)\n    return fn\n\n\ndef to_title(page):\n    return wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title\")\n\n\n@test\ndef boots_clean_with_the_right_title(b):\n    ctx, page, errs = open_game(b)\n    s = to_title(page)\n    assert \"Diorama Center\" in page.title(), page.title()\n    assert s[\"device\"] in (\"mouse\", \"pad\")\n    # None of the engine's overlays: the stage is ours and the status comes from our shell.\n    assert s[\"scene\"] == \"surgery/title\"\n    time.sleep(1.5)\n    assert not errs, errs[:3]\n    assert page.evaluate(\"!!document.querySelector('meta[name=\\\"hub:session\\\"]')\"), \"hub tags\"\n    assert page.evaluate(\"document.head.querySelector('script').textContent.includes('aihub-session')\"), \"the client is the first script\"\n    assert page.evaluate(\"!!document.getElementById('about-data')\"), \"about block\"\n    ctx.close()\n\n\n@test\ndef music_defaults_to_ten_percent_and_the_analyser_hears_it(b):\n    ctx, page, errs = open_game(b, tap=True)\n    s = to_title(page)\n    assert abs(s[\"music\"] - 0.10) < 1e-3, s[\"music\"]\n    assert abs(s[\"bus_gains\"][0] - 0.10) < 1e-3, s[\"bus_gains\"]\n    page.mouse.click(300, 300)  # sound is allowed after a click\n    peak = 0.0\n    for _ in range(40):\n        time.sleep(0.25)\n        peak = max(peak, page.evaluate(\"window.__peak ? window.__peak() : 0\"))\n        if peak > 0.002:\n            break\n    assert peak > 0.002, f\"silent: {peak}\"\n    ctx.close()\n\n\n@test\ndef a_dualsense_walks_menus_flicks_tools_and_r2_is_analog(b):\n    ctx, page, errs = open_game(b, pad=True)\n    to_title(page)\n\n    def hit(i, v=1.0, hold=0.25):\n        page.evaluate(f\"__padHit({i},{v})\")\n        time.sleep(hold)\n        page.evaluate(f\"__padHit({i},0)\")\n        time.sleep(0.2)\n\n    hit(0)\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    assert s[\"device\"] == \"pad\"\n    assert \"Cross\" in s[\"prompts\"], s[\"prompts\"]\n    hit(13)  # D-pad down\n    s = status(page)\n    assert s[\"focus\"] == 1 or s[\"focus\"] == 2, s[\"focus\"]\n    # Into a case, by the hook, and play it with the pad.\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 0 and s[\"sim\"][\"stage\"] == \"Chart\", 30, \"the chart\")\n    hit(0)\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"the operation\")\n    # A flick of the left stick up-right picks the second instrument, with no menu.\n    page.evaluate(\"__padAxis(0,0.8);__padAxis(1,-0.8)\")\n    time.sleep(0.5)\n    page.evaluate(\"__padAxis(0,0);__padAxis(1,0)\")\n    s = wait(page, lambda s: s[\"tool\"] == \"Forceps\", 15, \"flick\")\n    # Down-left: gel.\n    page.evaluate(\"__padAxis(0,-0.8);__padAxis(1,0.8)\")\n    s = wait(page, lambda s: s[\"tool\"] == \"Gel\", 15, \"flick to gel\")\n    page.evaluate(\"__padAxis(0,0);__padAxis(1,0)\")\n    # Analog R2 reaches the sim.\n    page.evaluate(\"__padHit(7,0.5)\")\n    s = wait(page, lambda s: s[\"using\"] and 0.3 < s[\"pressure\"] < 0.7, 15, \"analog R2\")\n    page.evaluate(\"__padHit(7,0)\")\n    # The right stick moves the cursor.\n    before = status(page)[\"cursor\"]\n    page.evaluate(\"__padAxis(2,1)\")\n    wait(page, lambda s: s[\"cursor\"][0] > before[0] + 0.5, 15, \"the stick moves the cursor\")\n    page.evaluate(\"__padAxis(2,0)\")\n    # Options pauses.\n    hit(9)\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Options pauses\")\n    # Options while Create is held: the hub's, ignored.\n    hit(9)\n    wait(page, lambda s: s[\"screen\"] == \"Playing\", 10, \"Options resumes\")\n    page.evaluate(\"__padHit(8,1)\")\n    hit(9)\n    page.evaluate(\"__padHit(8,0)\")\n    assert status(page)[\"screen\"] == \"Playing\", \"Create + Options is the hub's\"\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef keyboard_and_mouse_tools_wheel_hover_click_and_prompts_flip(b):\n    ctx, page, errs = open_game(b, 1280, 720, pad=True)\n    to_title(page)\n    page.keyboard.press(\"Enter\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu by Enter\")\n    assert s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], s[\"prompts\"]\n    # Hover moves the focus: the fourth row of the list (canvas y 240 + 104*k at 1080p).\n    y = int((240 + 104 * 2 + 40) * 720 / 1080)\n    page.mouse.move(300, y)\n    wait(page, lambda s: s[\"focus\"] == 2, 15, \"hover focus\")\n    # The pad takes over at once, and back.\n    page.evaluate(\"__padHit(12,1)\")\n    wait(page, lambda s: s[\"device\"] == \"pad\" and \"Cross\" in s[\"prompts\"], 15, \"prompts flip to pad\")\n    page.evaluate(\"__padHit(12,0)\")\n    page.keyboard.press(\"ArrowDown\")\n    wait(page, lambda s: s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], 15, \"prompts flip back\")\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 0, 30, \"the case\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"the operation\")\n    # Digit picks a tool.\n    page.keyboard.press(\"6\")\n    wait(page, lambda s: s[\"tool\"] == \"Gel\", 15, \"digit\")\n    # Wheel cycles.\n    page.mouse.wheel(0, 120)\n    wait(page, lambda s: s[\"tool\"] != \"Gel\", 15, \"wheel\")\n    # The mouse aims: a move lands in field coordinates near the middle.\n    page.mouse.move(640, 380)\n    s = wait(page, lambda s: abs(s[\"cursor\"][0]) < 1.0, 15, \"mouse aim\")\n    page.mouse.down()\n    wait(page, lambda s: s[\"using\"], 15, \"left button uses\")\n    page.mouse.up()\n    # Esc pauses.\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Esc pauses\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef attract_at_ten_seconds_and_exit_on_key_pad_and_mouse(b):\n    ctx, page, errs = open_game(b, pad=True)\n    s = to_title(page)\n    for how in (\"key\", \"pad\", \"mouse\"):\n        s = wait(page, lambda s: s[\"screen\"] == \"Attract\", 40, \"attract\")\n        wait(page, lambda s: \"attract\" in s[\"scene\"], 10, \"attract scene\")\n        if how == \"key\":\n            page.keyboard.press(\"x\")\n        elif how == \"pad\":\n            page.evaluate(\"__padHit(0,1)\")\n            time.sleep(0.4)\n            page.evaluate(\"__padHit(0,0)\")\n        else:\n            page.mouse.move(100 + time.time() % 50, 120)\n            page.mouse.move(200, 220)\n        wait(page, lambda s: s[\"screen\"] == \"Title\", 15, f\"exit on {how}\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef phone_profile_shows_the_message_and_no_touch_controls(b):\n    device = sync_pw.devices[\"Pixel 7\"]\n    ctx, page, errs = open_game(b, **{k: v for k, v in device.items() if k not in (\"viewport\", \"default_browser_type\")}, width=device[\"viewport\"][\"width\"], height=device[\"viewport\"][\"height\"])\n    s = wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title\")\n    assert s[\"touch_only\"] is True, s\n    assert s[\"device\"] == \"touch\", s[\"device\"]\n    # The Settings button answers a tap: find it on the canvas (canvas y 540+260 of 1080).\n    w, h = device[\"viewport\"][\"width\"], device[\"viewport\"][\"height\"]\n    page.touchscreen.tap(w / 2, (540 + 260) * h / 1080)\n    wait(page, lambda s: s[\"screen\"] == \"Settings\", 20, \"settings by tap\")\n    # A tap on Back returns; attract still runs.\n    x = w - 190 * h / 1080 if False else None\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Title'}))\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Attract\", 40, \"attract on a phone\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef settings_persist_across_a_reload(b):\n    ctx, page, errs = open_game(b, width=1280, height=720)\n    to_title(page)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Settings'}))\")\n    wait(page, lambda s: s[\"screen\"] == \"Settings\", 10, \"settings\")\n    for _ in range(2):\n        key(page, \"ArrowRight\", 0.1)\n    s = wait(page, lambda s: s[\"music\"] > 0.11, 10, \"music up\")\n    level = s[\"music\"]\n    page.reload()\n    s = wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title again\")\n    assert abs(s[\"music\"] - level) < 1e-3, (s[\"music\"], level)\n    assert abs(s[\"bus_gains\"][0] - level) < 1e-3, s[\"bus_gains\"]\n    ctx.close()\n\n\n@test\ndef dev_mode_from_the_pause_menu_and_sliders_reach_the_sim(b):\n    ctx, page, errs = open_game(b, width=1280, height=720)\n    to_title(page)\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/1'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 1, 30, \"case\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"pause\")\n    for _ in range(4):\n        key(page, \"ArrowDown\", 0.08)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Dev\", 15, \"dev\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef the_whole_campaign_steps_to_won_in_the_browser(b):\n    ctx, page, errs = open_game(b)\n    to_title(page)\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/campaign/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"mode\") == \"Campaign\", 30, \"campaign\")\n    end = time.time() + 280\n    s = None\n    while time.time() < end:\n        page.evaluate(\"__game.step(2000, true)\")\n        time.sleep(0.8)\n        s = status(page)\n        if s[\"sim\"][\"outcome\"] == \"won\":\n            break\n    assert s[\"sim\"][\"outcome\"] == \"won\", s[\"sim\"]\n    assert s[\"sim\"][\"cases_won\"] == 8, s[\"sim\"]\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef webkit_iphone_goes_as_far_as_it_goes(b0):\n    if sync_pw is None:\n        return\n    device = sync_pw.devices[\"iPhone 14\"]\n    wk = sync_pw.webkit.launch()\n    try:\n        ctx = wk.new_context(**{k: v for k, v in device.items() if k != \"default_browser_type\"})\n        page = ctx.new_page()\n        from common import GAME\n        page.goto(GAME.as_uri())\n        time.sleep(3)\n        text = page.evaluate(\"document.body.innerText\")\n        ok = \"WebGPU\" in text or page.evaluate(\"!!document.querySelector('canvas')\")\n        assert ok, text[:200]\n    finally:\n        wk.close()\n\n\n@test\ndef screenshots_at_1080p(b):\n    ctx, page, errs = open_game(b, 1920, 1080)\n    to_title(page)\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_title.png\"))\n    page.keyboard.press(\"Enter\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_menu.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/campaign/3'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"story\"), 30, \"story\")\n    page.keyboard.press(\"Enter\")\n    time.sleep(0.8)\n    page.keyboard.press(\"Enter\")\n    time.sleep(3)\n    page.screenshot(path=str(OUT / \"p_story.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/4'}))\")\n    wait(page, lambda s: s[\"sim\"].get(\"case\") == 4, 20, \"op\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    page.evaluate(\"__game.step(1200, true)\")\n    time.sleep(3)\n    page.screenshot(path=str(OUT / \"p_op.png\"))\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 15, \"pause\")\n    time.sleep(0.5)\n    page.screenshot(path=str(OUT / \"p_pause.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Dev'}))\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_dev.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'About'}))\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_about.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Playing'}));__game.do(JSON.stringify({sim:{Cheat:{id:6,value:1}}}))\")\n    time.sleep(1)\n    page.keyboard.press(\"Escape\")\n    time.sleep(0.5)\n    wait(page, lambda s: s[\"screen\"] in (\"Pause\", \"Playing\"), 5, \"any\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s[\"stage\"] == \"Results\", 40, \"results\")\n    time.sleep(5)\n    page.screenshot(path=str(OUT / \"p_results.png\"))\n    ctx.close()\n\n\nsync_pw = None\n\n\ndef main():\n    global sync_pw\n    passed = failed = 0\n    with sync_playwright() as p:\n        sync_pw = p\n        b = p.chromium.launch(args=ARGS)\n        only = [a for a in sys.argv[1:] if not a.startswith(\"--\")]\n        for fn in results:\n            if only and not any(o in fn.__name__ for o in only):\n                continue\n            try:\n                fn(b)\n                passed += 1\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL {fn.__name__}: {e}\")\n                tb = traceback.format_exc().splitlines()\n                print(\"  \" + \"\\n  \".join(tb[-6:-1]))\n        b.close()\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(\"%d passed, %d failed\" % main())\nEOF\ncat > ../tests/browser/hub_tests.py <<'EOF'\n\"\"\"The AI Hub harness, next to the built game, on a port the OS picks. Prints only failures.\"\"\"\nimport json\nimport pathlib\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nfrom common import ARGS, GAME, ROOT, sync_playwright\n\nHUB = ROOT / \"hub\"\nQUERIES = [\n    \"players=4&latency=150&jitter=50&loss=5&auto=1&limit=20\",\n    \"players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=20\",\n    \"players=2&scenario=server&auto=1&limit=20\",\n    \"players=1&auto=1&limit=20\",\n]\n\n\ndef serve():\n    proc = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"-d\", str(HUB)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)\n    line = proc.stdout.readline()\n    port = int(line.split(\"port \")[1].split(\" \")[0])\n    return proc, port\n\n\ndef main():\n    passed = failed = 0\n    shutil.copy(GAME, HUB / \"game.html\")\n    proc, port = serve()\n    base = f\"http://127.0.0.1:{port}\"\n    try:\n        with sync_playwright() as p:\n            b = p.chromium.launch(args=ARGS)\n            for q in QUERIES:\n                ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                page = ctx.new_page()\n                page.goto(f\"{base}/harness.html?game=game.html&{q}\")\n                try:\n                    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=420000)\n                    check = page.evaluate(\"window.__hubCheck\")\n                    if check and check.get(\"pass\"):\n                        passed += 1\n                    else:\n                        failed += 1\n                        print(f\"FAIL harness {q}: {json.dumps(check)[:1200]}\")\n                except Exception as e:\n                    failed += 1\n                    check = page.evaluate(\"window.__hubCheck || null\")\n                    print(f\"FAIL harness {q}: {e} {json.dumps(check)[:1200]}\")\n                ctx.close()\n            # Two copies: a client's input moves its cursor on the host; both see the same vitals.\n            try:\n                ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                page = ctx.new_page()\n                page.goto(f\"{base}/harness.html?game=game.html&players=2&limit=40\")\n                page.wait_for_function(\"document.querySelectorAll('iframe').length >= 2\", timeout=60000)\n                frames = [f for f in page.frames if \"game.html\" in f.url]\n                deadline = time.time() + 300\n                host = client = None\n                while time.time() < deadline:\n                    st = [f.evaluate(\"window.__game ? window.__game.status() : null\") for f in frames]\n                    if all(st) and all(s[\"screen\"] == \"Card\" for s in st):\n                        for f in frames:\n                            f.evaluate(\"document.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}))\")\n                    if all(st) and all(s[\"screen\"] == \"Session\" for s in st) and any(s.get(\"vitals\", 0) > 0 for s in st):\n                        host = next((f for f, s in zip(frames, st) if \"codeblue\" in s[\"scene\"]), None)\n                        client = next((f for f, s in zip(frames, st) if \"mirror\" in s[\"scene\"]), None)\n                        if host and client and st[0][\"stage\"] == \"Op\" and st[1][\"stage\"] == \"Op\":\n                            break\n                    time.sleep(0.5)\n                assert host and client, f\"never reached play: {st}\"\n                # The client's mouse moves its surgeon.\n                client.evaluate(\"\"\"() => {\n                    const c = document.querySelector('canvas');\n                    window.__move = (x, y) => c.dispatchEvent(new PointerEvent('pointermove', {clientX: x, clientY: y, bubbles: true, pointerId: 1, pointerType: 'mouse'}));\n                }\"\"\")\n                moved = False\n                for k in range(40):\n                    box = page.query_selector_all(\"iframe\")[[f for f in page.frames].index(client) - 1].bounding_box() if False else None\n                    client.evaluate(f\"__move({200 + k * 8}, {240 + k * 2})\")\n                    time.sleep(0.25)\n                    hs = host.evaluate(\"window.__game.status()\")\n                    cs = client.evaluate(\"window.__game.status()\")\n                    cur = hs[\"sim\"][\"cursors\"][1] if hs.get(\"sim\") else [0, 0]\n                    if abs(cur[0]) + abs(cur[1]) > 0.05:\n                        moved = True\n                        break\n                assert moved, \"the client's hands never reached the host\"\n                # Both see the same vitals, near enough.\n                hs = host.evaluate(\"window.__game.status()\")\n                cs = client.evaluate(\"window.__game.status()\")\n                assert abs(hs[\"vitals\"] - cs[\"vitals\"]) < 6.0, (hs[\"vitals\"], cs[\"vitals\"])\n                passed += 1\n                ctx.close()\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL two copies: {e}\")\n            # Outside a session: the title appears, the game is unaffected.\n            try:\n                ctx = b.new_context(viewport={\"width\": 960, \"height\": 540})\n                page = ctx.new_page()\n                page.goto(f\"{base}/game.html\")\n                page.wait_for_function(\"window.__game && window.__game.status() && window.__game.status().screen === 'Title'\", timeout=150000)\n                assert page.evaluate(\"window.__game.status().hub\") is False\n                passed += 1\n                ctx.close()\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL outside a session: {e}\")\n            b.close()\n    finally:\n        proc.terminate()\n        proc.wait(timeout=5)\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(\"%d passed, %d failed\" % main())\nEOF\nCARGO_BUILD_JOBS=12 cargo build --offline -p pav_tools --bin pav 2>&1 | grep -E \"^error|^ +--> \" -A4 | head -20; cat > ../gen/about.py <<'EOF'\n# Writes web/about.json from the exit interview (run after writing it).\nimport json, pathlib, sys\nroot = pathlib.Path(__file__).resolve().parent.parent\nwork = root.parent\nei_path = work / 'exit-interview.json'\nei = json.loads(ei_path.read_text()) if ei_path.exists() else None\nsecs = [{\"title\": \"Credits\", \"lines\": [\n  \"Diorama Center: Second Opinion. An original surgical-action melodrama.\",\n  \"Engine: Pavilion (Shardfall), by Michael Crosato, MIT-style project licence as in its repository: Rust, wgpu, egui, rapier3d, cpal, gilrs, winit.\",\n  \"Font: Barlow Condensed SemiBold, by Jeremy Tribby, SIL Open Font License 1.1.\",\n  \"Motion clips for the operating-room wide shot: Quaternius (CC0) and Mesh2Motion (CC0), from the engine's library.\",\n  \"All music, sound effects and voices are written in code. There are no audio files.\",\n  \"All art is made in code and text: no image or model files.\",\n]}]\nif ei:\n    si = ei[\"sourceInformation\"]\n    names = [(\"Date\",\"date\"),(\"Source\",\"source\"),(\"Plan\",\"plan\"),(\"Genre\",\"genre\"),(\"Perspective\",\"perspective\"),(\"Tech\",\"tech\"),(\"Art Direction\",\"artDirection\"),(\"Animation\",\"animation\"),(\"Audio\",\"audio\"),(\"Online\",\"online\"),(\"Testing\",\"testing\"),(\"Research\",\"research\"),(\"Environment\",\"environment\"),(\"Model\",\"model\"),(\"Usage\",\"usage\")]\n    secs.append({\"title\":\"Source Information\",\"lines\":[f\"{n}: {si[k]}\" for n,k in names]})\n    for title,key,qs in ((\"Testing Feedback\",\"testingFeedback\",[\"How many issues did testing catch?\",\"How many would be considered critical issues / game breaking?\",\"What was the most helpful test you ran?\",\"What was the least helpful test you ran?\"]),\n        (\"Engine Feedback\",\"engineFeedback\",[\"What did you like most about the engine?\",\"Did you get stuck or guess wrong?\",\"What was the most important thing you had to build yourself?\",\"What was the hardest part about using the engine?\",\"What did you change in the engine, and why?\",\"If you could change one thing about the engine, what would it be?\"]),\n        (\"Prompt Feedback\",\"promptFeedback\",[\"What did you like most about this prompt?\",\"What was confusing?\",\"What was the hardest thing to do?\",\"What would you change in this prompt?\"])):\n        lines=[]\n        for q,a in zip(qs,ei[key]):\n            lines.append(q); lines.append(\"   \"+a)\n        secs.append({\"title\":title,\"lines\":lines})\ntext=json.dumps({\"sections\":secs},ensure_ascii=False)\n(root/'engine'/'web'/'about.json').write_text(text,encoding='utf-8')\n(root/'engine'/'crates'/'pav_ui'/'src'/'surgery'/'about.json').write_text(text,encoding='utf-8')\nprint('about sections',len(secs))\nEOF\npython3 ../gen/about.py; CARGO_BUILD_JOBS=12 timeout 590 scripts/build-web.sh --single-file --scene surgery/title --title \"Diorama Center: Second Opinion\" --description \"You are the hands: a surgical action melodrama.\" --theme-color \"#0a1a1e\" --out ../tests/out/game.html 2>&1 | tail -1 | cut -c150-","description":"Write the one-command test runner, browser and hub tests, rebuild the page","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9449,"cache_read_input_tokens":699504,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9449},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"a230c71c-f437-4ee9-9804-a408455f8334","timestamp":"2026-11-05T14:48:56.313Z","request_id":"req_011CgjxsPxfmdeBGyratDMst","wire_tool_inputs":{"toolu_01H9Sf5Wa2Qon5Rpgmm9pDHc":{"command":"python3 - <<'EOF'\nC='crates/pav_core/src/games/surgery/content/cases/'\ns=open(C+'case4.toml').read()\ns=s.replace('''[[phase.spawn]]\nkind = \"bleeder\"\nat = [4.6, 1.3]\naxis = 110\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]''','''[[phase.spawn]]\nkind = \"laceration\"\nat = [4.6, 1.3]\npts = [[3.6, 1], [4.6, 1.6], [5.8, 1.2]]\n[[phase.spawn]]\nkind = \"foreign\"\nat = [0.2, 2.4]''')\ns=s.replace('''[[phase.spawn]]\nkind = \"bleeder\"\nat = [5, 1.8]\naxis = 140\n''','''[[phase.spawn]]\nkind = \"laceration\"\nat = [5, 1.8]\npts = [[4, 1.6], [5, 2.2], [6.2, 1.8]]\n''')\nopen(C+'case4.toml','w').write(s)\np='crates/pav_core/src/games/surgery/director.rs'\ns=open(p).read()\ns=s.replace('next_wave: 0.5, interval: 11.0, tempo: 1.0','next_wave: 0.5, interval: 13.0, tempo: 1.0')\nopen(p,'w').write(s)\nEOF\nmkdir -p ../tests/hub\ncat > ../tests/run_all.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Everything, behind one command: prints only failures and a one-line count.\n\nusage: python3 tests/run_all.py [--rust] [--web] [--hub]    (no flags: all of it)\nRun with the system python3, without -I: -I hides Playwright.\n\"\"\"\nimport pathlib\nimport re\nimport subprocess\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent\nENGINE = ROOT.parent / \"engine\"\npassed = failed = 0\n\n\ndef run_cargo(args):\n    global passed, failed\n    r = subprocess.run([\"cargo\", \"test\", \"--offline\", *args], cwd=ENGINE, capture_output=True, text=True, env={**__import__(\"os\").environ, \"CARGO_BUILD_JOBS\": \"10\"})\n    out = r.stdout + r.stderr\n    for m in re.finditer(r\"test result: \\w+\\. (\\d+) passed; (\\d+) failed\", out):\n        passed += int(m[1])\n        failed += int(m[2])\n    if r.returncode != 0:\n        lines = [l for l in out.splitlines() if re.search(r\"FAILED|panicked|error(\\[|:)|assertion|left:|right:\", l)]\n        print(f\"cargo test {' '.join(args)} failed:\")\n        print(\"\\n\".join(lines[:40]))\n        if \"test result\" not in out:\n            failed += 1\n\n\ndef rust():\n    for args in (\n        [\"-p\", \"pav_core\", \"--test\", \"surgery\"],\n        [\"-p\", \"pav_core\", \"--lib\", \"surgery\"],\n        [\"-p\", \"pav_ui\", \"--lib\", \"surgery\"],\n        [\"-p\", \"pav_audio\", \"--lib\"],\n    ):\n        run_cargo(args)\n\n\ndef module(name):\n    global passed, failed\n    sys.path.insert(0, str(ROOT / \"browser\"))\n    mod = __import__(name)\n    p, f = mod.main()\n    passed += p\n    failed += f\n\n\nargs = set(sys.argv[1:])\nif not args or \"--rust\" in args:\n    rust()\nif not args or \"--web\" in args:\n    module(\"web_tests\")\nif not args or \"--hub\" in args:\n    module(\"hub_tests\")\nprint(f\"{passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nEOF\ncat > ../tests/browser/web_tests.py <<'EOF'\n\"\"\"The built single file, from file://, in Chromium with software WebGPU. Prints only failures.\"\"\"\nimport json\nimport sys\nimport time\nimport traceback\n\nfrom common import ARGS, OUT, key, open_game, status, sync_playwright, wait\n\nresults = []\n\n\ndef test(fn):\n    results.append(fn)\n    return fn\n\n\ndef to_title(page):\n    return wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title\")\n\n\n@test\ndef boots_clean_with_the_right_title(b):\n    ctx, page, errs = open_game(b)\n    s = to_title(page)\n    assert \"Diorama Center\" in page.title(), page.title()\n    assert s[\"device\"] in (\"mouse\", \"pad\")\n    # None of the engine's overlays: the stage is ours and the status comes from our shell.\n    assert s[\"scene\"] == \"surgery/title\"\n    time.sleep(1.5)\n    assert not errs, errs[:3]\n    assert page.evaluate(\"!!document.querySelector('meta[name=\\\"hub:session\\\"]')\"), \"hub tags\"\n    assert page.evaluate(\"document.head.querySelector('script').textContent.includes('aihub-session')\"), \"the client is the first script\"\n    assert page.evaluate(\"!!document.getElementById('about-data')\"), \"about block\"\n    ctx.close()\n\n\n@test\ndef music_defaults_to_ten_percent_and_the_analyser_hears_it(b):\n    ctx, page, errs = open_game(b, tap=True)\n    s = to_title(page)\n    assert abs(s[\"music\"] - 0.10) < 1e-3, s[\"music\"]\n    assert abs(s[\"bus_gains\"][0] - 0.10) < 1e-3, s[\"bus_gains\"]\n    page.mouse.click(300, 300)  # sound is allowed after a click\n    peak = 0.0\n    for _ in range(40):\n        time.sleep(0.25)\n        peak = max(peak, page.evaluate(\"window.__peak ? window.__peak() : 0\"))\n        if peak > 0.002:\n            break\n    assert peak > 0.002, f\"silent: {peak}\"\n    ctx.close()\n\n\n@test\ndef a_dualsense_walks_menus_flicks_tools_and_r2_is_analog(b):\n    ctx, page, errs = open_game(b, pad=True)\n    to_title(page)\n\n    def hit(i, v=1.0, hold=0.25):\n        page.evaluate(f\"__padHit({i},{v})\")\n        time.sleep(hold)\n        page.evaluate(f\"__padHit({i},0)\")\n        time.sleep(0.2)\n\n    hit(0)\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    assert s[\"device\"] == \"pad\"\n    assert \"Cross\" in s[\"prompts\"], s[\"prompts\"]\n    hit(13)  # D-pad down\n    s = status(page)\n    assert s[\"focus\"] == 1 or s[\"focus\"] == 2, s[\"focus\"]\n    # Into a case, by the hook, and play it with the pad.\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 0 and s[\"sim\"][\"stage\"] == \"Chart\", 30, \"the chart\")\n    hit(0)\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"the operation\")\n    # A flick of the left stick up-right picks the second instrument, with no menu.\n    page.evaluate(\"__padAxis(0,0.8);__padAxis(1,-0.8)\")\n    time.sleep(0.5)\n    page.evaluate(\"__padAxis(0,0);__padAxis(1,0)\")\n    s = wait(page, lambda s: s[\"tool\"] == \"Forceps\", 15, \"flick\")\n    # Down-left: gel.\n    page.evaluate(\"__padAxis(0,-0.8);__padAxis(1,0.8)\")\n    s = wait(page, lambda s: s[\"tool\"] == \"Gel\", 15, \"flick to gel\")\n    page.evaluate(\"__padAxis(0,0);__padAxis(1,0)\")\n    # Analog R2 reaches the sim.\n    page.evaluate(\"__padHit(7,0.5)\")\n    s = wait(page, lambda s: s[\"using\"] and 0.3 < s[\"pressure\"] < 0.7, 15, \"analog R2\")\n    page.evaluate(\"__padHit(7,0)\")\n    # The right stick moves the cursor.\n    before = status(page)[\"cursor\"]\n    page.evaluate(\"__padAxis(2,1)\")\n    wait(page, lambda s: s[\"cursor\"][0] > before[0] + 0.5, 15, \"the stick moves the cursor\")\n    page.evaluate(\"__padAxis(2,0)\")\n    # Options pauses.\n    hit(9)\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Options pauses\")\n    # Options while Create is held: the hub's, ignored.\n    hit(9)\n    wait(page, lambda s: s[\"screen\"] == \"Playing\", 10, \"Options resumes\")\n    page.evaluate(\"__padHit(8,1)\")\n    hit(9)\n    page.evaluate(\"__padHit(8,0)\")\n    assert status(page)[\"screen\"] == \"Playing\", \"Create + Options is the hub's\"\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef keyboard_and_mouse_tools_wheel_hover_click_and_prompts_flip(b):\n    ctx, page, errs = open_game(b, 1280, 720, pad=True)\n    to_title(page)\n    page.keyboard.press(\"Enter\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu by Enter\")\n    assert s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], s[\"prompts\"]\n    # Hover moves the focus: the fourth row of the list (canvas y 240 + 104*k at 1080p).\n    y = int((240 + 104 * 2 + 40) * 720 / 1080)\n    page.mouse.move(300, y)\n    wait(page, lambda s: s[\"focus\"] == 2, 15, \"hover focus\")\n    # The pad takes over at once, and back.\n    page.evaluate(\"__padHit(12,1)\")\n    wait(page, lambda s: s[\"device\"] == \"pad\" and \"Cross\" in s[\"prompts\"], 15, \"prompts flip to pad\")\n    page.evaluate(\"__padHit(12,0)\")\n    page.keyboard.press(\"ArrowDown\")\n    wait(page, lambda s: s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], 15, \"prompts flip back\")\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 0, 30, \"the case\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"the operation\")\n    # Digit picks a tool.\n    page.keyboard.press(\"6\")\n    wait(page, lambda s: s[\"tool\"] == \"Gel\", 15, \"digit\")\n    # Wheel cycles.\n    page.mouse.wheel(0, 120)\n    wait(page, lambda s: s[\"tool\"] != \"Gel\", 15, \"wheel\")\n    # The mouse aims: a move lands in field coordinates near the middle.\n    page.mouse.move(640, 380)\n    s = wait(page, lambda s: abs(s[\"cursor\"][0]) < 1.0, 15, \"mouse aim\")\n    page.mouse.down()\n    wait(page, lambda s: s[\"using\"], 15, \"left button uses\")\n    page.mouse.up()\n    # Esc pauses.\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Esc pauses\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef attract_at_ten_seconds_and_exit_on_key_pad_and_mouse(b):\n    ctx, page, errs = open_game(b, pad=True)\n    s = to_title(page)\n    for how in (\"key\", \"pad\", \"mouse\"):\n        s = wait(page, lambda s: s[\"screen\"] == \"Attract\", 40, \"attract\")\n        wait(page, lambda s: \"attract\" in s[\"scene\"], 10, \"attract scene\")\n        if how == \"key\":\n            page.keyboard.press(\"x\")\n        elif how == \"pad\":\n            page.evaluate(\"__padHit(0,1)\")\n            time.sleep(0.4)\n            page.evaluate(\"__padHit(0,0)\")\n        else:\n            page.mouse.move(100 + time.time() % 50, 120)\n            page.mouse.move(200, 220)\n        wait(page, lambda s: s[\"screen\"] == \"Title\", 15, f\"exit on {how}\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef phone_profile_shows_the_message_and_no_touch_controls(b):\n    device = sync_pw.devices[\"Pixel 7\"]\n    ctx, page, errs = open_game(b, **{k: v for k, v in device.items() if k not in (\"viewport\", \"default_browser_type\")}, width=device[\"viewport\"][\"width\"], height=device[\"viewport\"][\"height\"])\n    s = wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title\")\n    assert s[\"touch_only\"] is True, s\n    assert s[\"device\"] == \"touch\", s[\"device\"]\n    # The Settings button answers a tap: find it on the canvas (canvas y 540+260 of 1080).\n    w, h = device[\"viewport\"][\"width\"], device[\"viewport\"][\"height\"]\n    page.touchscreen.tap(w / 2, (540 + 260) * h / 1080)\n    wait(page, lambda s: s[\"screen\"] == \"Settings\", 20, \"settings by tap\")\n    # A tap on Back returns; attract still runs.\n    x = w - 190 * h / 1080 if False else None\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Title'}))\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Attract\", 40, \"attract on a phone\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef settings_persist_across_a_reload(b):\n    ctx, page, errs = open_game(b, width=1280, height=720)\n    to_title(page)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Settings'}))\")\n    wait(page, lambda s: s[\"screen\"] == \"Settings\", 10, \"settings\")\n    for _ in range(2):\n        key(page, \"ArrowRight\", 0.1)\n    s = wait(page, lambda s: s[\"music\"] > 0.11, 10, \"music up\")\n    level = s[\"music\"]\n    page.reload()\n    s = wait(page, lambda s: s.get(\"screen\") == \"Title\", 150, \"title again\")\n    assert abs(s[\"music\"] - level) < 1e-3, (s[\"music\"], level)\n    assert abs(s[\"bus_gains\"][0] - level) < 1e-3, s[\"bus_gains\"]\n    ctx.close()\n\n\n@test\ndef dev_mode_from_the_pause_menu_and_sliders_reach_the_sim(b):\n    ctx, page, errs = open_game(b, width=1280, height=720)\n    to_title(page)\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/1'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 1, 30, \"case\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"pause\")\n    for _ in range(4):\n        key(page, \"ArrowDown\", 0.08)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Dev\", 15, \"dev\")\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef the_whole_campaign_steps_to_won_in_the_browser(b):\n    ctx, page, errs = open_game(b)\n    to_title(page)\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/campaign/0'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"mode\") == \"Campaign\", 30, \"campaign\")\n    end = time.time() + 280\n    s = None\n    while time.time() < end:\n        page.evaluate(\"__game.step(2000, true)\")\n        time.sleep(0.8)\n        s = status(page)\n        if s[\"sim\"][\"outcome\"] == \"won\":\n            break\n    assert s[\"sim\"][\"outcome\"] == \"won\", s[\"sim\"]\n    assert s[\"sim\"][\"cases_won\"] == 8, s[\"sim\"]\n    assert not errs, errs[:3]\n    ctx.close()\n\n\n@test\ndef webkit_iphone_goes_as_far_as_it_goes(b0):\n    if sync_pw is None:\n        return\n    device = sync_pw.devices[\"iPhone 14\"]\n    wk = sync_pw.webkit.launch()\n    try:\n        ctx = wk.new_context(**{k: v for k, v in device.items() if k != \"default_browser_type\"})\n        page = ctx.new_page()\n        from common import GAME\n        page.goto(GAME.as_uri())\n        time.sleep(3)\n        text = page.evaluate(\"document.body.innerText\")\n        ok = \"WebGPU\" in text or page.evaluate(\"!!document.querySelector('canvas')\")\n        assert ok, text[:200]\n    finally:\n        wk.close()\n\n\n@test\ndef screenshots_at_1080p(b):\n    ctx, page, errs = open_game(b, 1920, 1080)\n    to_title(page)\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_title.png\"))\n    page.keyboard.press(\"Enter\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_menu.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/campaign/3'}));__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"story\"), 30, \"story\")\n    page.keyboard.press(\"Enter\")\n    time.sleep(0.8)\n    page.keyboard.press(\"Enter\")\n    time.sleep(3)\n    page.screenshot(path=str(OUT / \"p_story.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({load:'surgery/case/4'}))\")\n    wait(page, lambda s: s[\"sim\"].get(\"case\") == 4, 20, \"op\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    page.evaluate(\"__game.step(1200, true)\")\n    time.sleep(3)\n    page.screenshot(path=str(OUT / \"p_op.png\"))\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 15, \"pause\")\n    time.sleep(0.5)\n    page.screenshot(path=str(OUT / \"p_pause.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Dev'}))\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_dev.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'About'}))\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_about.png\"))\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Playing'}));__game.do(JSON.stringify({sim:{Cheat:{id:6,value:1}}}))\")\n    time.sleep(1)\n    page.keyboard.press(\"Escape\")\n    time.sleep(0.5)\n    wait(page, lambda s: s[\"screen\"] in (\"Pause\", \"Playing\"), 5, \"any\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s[\"stage\"] == \"Results\", 40, \"results\")\n    time.sleep(5)\n    page.screenshot(path=str(OUT / \"p_results.png\"))\n    ctx.close()\n\n\nsync_pw = None\n\n\ndef main():\n    global sync_pw\n    passed = failed = 0\n    with sync_playwright() as p:\n        sync_pw = p\n        b = p.chromium.launch(args=ARGS)\n        only = [a for a in sys.argv[1:] if not a.startswith(\"--\")]\n        for fn in results:\n            if only and not any(o in fn.__name__ for o in only):\n                continue\n            try:\n                fn(b)\n                passed += 1\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL {fn.__name__}: {e}\")\n                tb = traceback.format_exc().splitlines()\n                print(\"  \" + \"\\n  \".join(tb[-6:-1]))\n        b.close()\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(\"%d passed, %d failed\" % main())\nEOF\ncat > ../tests/browser/hub_tests.py <<'EOF'\n\"\"\"The AI Hub harness, next to the built game, on a port the OS picks. Prints only failures.\"\"\"\nimport json\nimport pathlib\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nfrom common import ARGS, GAME, ROOT, sync_playwright\n\nHUB = ROOT / \"hub\"\nQUERIES = [\n    \"players=4&latency=150&jitter=50&loss=5&auto=1&limit=20\",\n    \"players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1&limit=20\",\n    \"players=2&scenario=server&auto=1&limit=20\",\n    \"players=1&auto=1&limit=20\",\n]\n\n\ndef serve():\n    proc = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"-d\", str(HUB)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)\n    line = proc.stdout.readline()\n    port = int(line.split(\"port \")[1].split(\" \")[0])\n    return proc, port\n\n\ndef main():\n    passed = failed = 0\n    shutil.copy(GAME, HUB / \"game.html\")\n    proc, port = serve()\n    base = f\"http://127.0.0.1:{port}\"\n    try:\n        with sync_playwright() as p:\n            b = p.chromium.launch(args=ARGS)\n            for q in QUERIES:\n                ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                page = ctx.new_page()\n                page.goto(f\"{base}/harness.html?game=game.html&{q}\")\n                try:\n                    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=420000)\n                    check = page.evaluate(\"window.__hubCheck\")\n                    if check and check.get(\"pass\"):\n                        passed += 1\n                    else:\n                        failed += 1\n                        print(f\"FAIL harness {q}: {json.dumps(check)[:1200]}\")\n                except Exception as e:\n                    failed += 1\n                    check = page.evaluate(\"window.__hubCheck || null\")\n                    print(f\"FAIL harness {q}: {e} {json.dumps(check)[:1200]}\")\n                ctx.close()\n            # Two copies: a client's input moves its cursor on the host; both see the same vitals.\n            try:\n                ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                page = ctx.new_page()\n                page.goto(f\"{base}/harness.html?game=game.html&players=2&limit=40\")\n                page.wait_for_function(\"document.querySelectorAll('iframe').length >= 2\", timeout=60000)\n                frames = [f for f in page.frames if \"game.html\" in f.url]\n                deadline = time.time() + 300\n                host = client = None\n                while time.time() < deadline:\n                    st = [f.evaluate(\"window.__game ? window.__game.status() : null\") for f in frames]\n                    if all(st) and all(s[\"screen\"] == \"Card\" for s in st):\n                        for f in frames:\n                            f.evaluate(\"document.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}))\")\n                    if all(st) and all(s[\"screen\"] == \"Session\" for s in st) and any(s.get(\"vitals\", 0) > 0 for s in st):\n                        host = next((f for f, s in zip(frames, st) if \"codeblue\" in s[\"scene\"]), None)\n                        client = next((f for f, s in zip(frames, st) if \"mirror\" in s[\"scene\"]), None)\n                        if host and client and st[0][\"stage\"] == \"Op\" and st[1][\"stage\"] == \"Op\":\n                            break\n                    time.sleep(0.5)\n                assert host and client, f\"never reached play: {st}\"\n                # The client's mouse moves its surgeon.\n                client.evaluate(\"\"\"() => {\n                    const c = document.querySelector('canvas');\n                    window.__move = (x, y) => c.dispatchEvent(new PointerEvent('pointermove', {clientX: x, clientY: y, bubbles: true, pointerId: 1, pointerType: 'mouse'}));\n                }\"\"\")\n                moved = False\n                for k in range(40):\n                    box = page.query_selector_all(\"iframe\")[[f for f in page.frames].index(client) - 1].bounding_box() if False else None\n                    client.evaluate(f\"__move({200 + k * 8}, {240 + k * 2})\")\n                    time.sleep(0.25)\n                    hs = host.evaluate(\"window.__game.status()\")\n                    cs = client.evaluate(\"window.__game.status()\")\n                    cur = hs[\"sim\"][\"cursors\"][1] if hs.get(\"sim\") else [0, 0]\n                    if abs(cur[0]) + abs(cur[1]) > 0.05:\n                        moved = True\n                        break\n                assert moved, \"the client's hands never reached the host\"\n                # Both see the same vitals, near enough.\n                hs = host.evaluate(\"window.__game.status()\")\n                cs = client.evaluate(\"window.__game.status()\")\n                assert abs(hs[\"vitals\"] - cs[\"vitals\"]) < 6.0, (hs[\"vitals\"], cs[\"vitals\"])\n                passed += 1\n                ctx.close()\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL two copies: {e}\")\n            # Outside a session: the title appears, the game is unaffected.\n            try:\n                ctx = b.new_context(viewport={\"width\": 960, \"height\": 540})\n                page = ctx.new_page()\n                page.goto(f\"{base}/game.html\")\n                page.wait_for_function(\"window.__game && window.__game.status() && window.__game.status().screen === 'Title'\", timeout=150000)\n                assert page.evaluate(\"window.__game.status().hub\") is False\n                passed += 1\n                ctx.close()\n            except Exception as e:\n                failed += 1\n                print(f\"FAIL outside a session: {e}\")\n            b.close()\n    finally:\n        proc.terminate()\n        proc.wait(timeout=5)\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(\"%d passed, %d failed\" % main())\nEOF\nCARGO_BUILD_JOBS=12 cargo build --offline -p pav_tools --bin pav 2>&1 | grep -E \"^error|^ +--> \" -A4 | head -20; cat > ../gen/about.py <<'EOF'\n# Writes web/about.json from the exit interview (run after writing it).\nimport json, pathlib, sys\nroot = pathlib.Path(__file__).resolve().parent.parent\nwork = root.parent\nei_path = work / 'exit-interview.json'\nei = json.loads(ei_path.read_text()) if ei_path.exists() else None\nsecs = [{\"title\": \"Credits\", \"lines\": [\n  \"Diorama Center: Second Opinion. An original surgical-action melodrama.\",\n  \"Engine: Pavilion (Shardfall), by Michael Crosato, MIT-style project licence as in its repository: Rust, wgpu, egui, rapier3d, cpal, gilrs, winit.\",\n  \"Font: Barlow Condensed SemiBold, by Jeremy Tribby, SIL Open Font License 1.1.\",\n  \"Motion clips for the operating-room wide shot: Quaternius (CC0) and Mesh2Motion (CC0), from the engine's library.\",\n  \"All music, sound effects and voices are written in code. There are no audio files.\",\n  \"All art is made in code and text: no image or model files.\",\n]}]\nif ei:\n    si = ei[\"sourceInformation\"]\n    names = [(\"Date\",\"date\"),(\"Source\",\"source\"),(\"Plan\",\"plan\"),(\"Genre\",\"genre\"),(\"Perspective\",\"perspective\"),(\"Tech\",\"tech\"),(\"Art Direction\",\"artDirection\"),(\"Animation\",\"animation\"),(\"Audio\",\"audio\"),(\"Online\",\"online\"),(\"Testing\",\"testing\"),(\"Research\",\"research\"),(\"Environment\",\"environment\"),(\"Model\",\"model\"),(\"Usage\",\"usage\")]\n    secs.append({\"title\":\"Source Information\",\"lines\":[f\"{n}: {si[k]}\" for n,k in names]})\n    for title,key,qs in ((\"Testing Feedback\",\"testingFeedback\",[\"How many issues did testing catch?\",\"How many would be considered critical issues / game breaking?\",\"What was the most helpful test you ran?\",\"What was the least helpful test you ran?\"]),\n        (\"Engine Feedback\",\"engineFeedback\",[\"What did you like most about the engine?\",\"Did you get stuck or guess wrong?\",\"What was the most important thing you had to build yourself?\",\"What was the hardest part about using the engine?\",\"What did you change in the engine, and why?\",\"If you could change one thing about the engine, what would it be?\"]),\n        (\"Prompt Feedback\",\"promptFeedback\",[\"What did you like most about this prompt?\",\"What was confusing?\",\"What was the hardest thing to do?\",\"What would you change in this prompt?\"])):\n        lines=[]\n        for q,a in zip(qs,ei[key]):\n            lines.append(q); lines.append(\"   \"+a)\n        secs.append({\"title\":title,\"lines\":lines})\ntext=json.dumps({\"sections\":secs},ensure_ascii=False)\n(root/'engine'/'web'/'about.json').write_text(text,encoding='utf-8')\n(root/'engine'/'crates'/'pav_ui'/'src'/'surgery'/'about.json').write_text(text,encoding='utf-8')\nprint('about sections',len(secs))\nEOF\npython3 ../gen/about.py; CARGO_BUILD_JOBS=12 timeout 590 scripts/build-web.sh --single-file --scene surgery/title --title \"Diorama Center: Second Opinion\" --description \"You are the hands: a surgical action melodrama.\" --theme-color \"#0a1a1e\" --out ../tests/out/game.html 2>&1 | tail -1 | cut -c150-","description":"Write the one-command test runner, browser and hub tests, rebuild the page","timeout":600000}}}
