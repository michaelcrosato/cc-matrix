{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QWT6yYETzZzGFFEiG2jUSE","type":"tool_result","content":"1\tuse anyhow::Result;\n2\tuse glam::Vec3;\n3\tuse pav_core::params::{ParamVisitor, Tunable, nested};\n4\tuse pav_core::{InputFrame, RenderFrame, Sim, SimConfig};\n5\tuse pav_render::{Renderer, gpu::Headless};\n6\tuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\n7\t\n8\tpub struct Gpu {\n9\t    pub headless: Headless,\n10\t    pub renderer: Renderer,\n11\t    pub builder: ViewBuilder,\n12\t    /// The live bridge keeps this device between requests, even when the human UI opens or\n13\t    /// closes a stage through a separate session with no GPU.\n14\t    studio_mode: pav_core::prop_preview::StudioMode,\n15\t    /// Paints the game UI over captures (made on first use).\n16\t    overlay: Option<pav_ui::headless::Overlay>,\n17\t}\n18\t\n19\timpl Gpu {\n20\t    fn prepare_frame(&mut self, frame: &RenderFrame) {\n21\t        let studio_mode = frame.studio_mode();\n22\t        if self.studio_mode != studio_mode {\n23\t            self.builder = ViewBuilder::new();\n24\t            self.renderer.clear_particles();\n25\t            self.studio_mode = studio_mode;\n26\t        }\n27\t    }\n28\t}\n29\t\n30\t/// One agent session: a simulation plus everything needed to look at it.\n31\tpub struct Session {\n32\t    pub sim: Sim,\n33\t    pub camera: CameraRig,\n34\t    pub view: ViewSettings,\n35\t    pub input: InputFrame,\n36\t    pub gpu: Option<Gpu>,\n37\t    pub prev_frame: RenderFrame,\n38\t    /// Room whose camera defaults were applied last, and the camera before entering it.\n39\t    room_cam: Option<(u16, CameraParams)>,\n40\t    cue_serial: u64,\n41\t    cue_base: Option<CameraParams>,\n42\t    /// Events since the last render (they become particles and shockwaves in captures).\n43\t    pub(crate) events: Vec<pav_core::frame::SimEvent>,\n44\t    /// View settings before the current room's `[view]` table / pad overrides.\n45\t    view_base: Option<ViewSettings>,\n46\t    view_room: Option<u16>,\n47\t    view_serial: u64,\n48\t    /// Running inside the game (live bridge): the game applies room cameras and views itself.\n49\t    pub(crate) live: bool,\n50\t    /// The look layer (`look` tool, the game's Look & Filters menu): its sections that are on\n51\t    /// replace the view settings in captures.\n52\t    pub look: pav_view::look::Look,\n53\t    /// Set by the native bridge. Headless sessions do not wait for or report window frames.\n54\t    pub feedback: Option<crate::live_feedback::SharedFeedback>,\n55\t    /// Live requests share owner 0; independent headless sessions adopt only their own jobs.\n56\t    pub(crate) creature_owner: u64,\n57\t    /// The game UI as the tools draw it (`ui`, captures): which windows are open, the device.\n58\t    pub ui: pav_ui::headless::Headless,\n59\t}\n60\t\n61\t/// All tunables reachable by path: `sim.*`, `camera.*`, `view.*`.\n62\tpub struct ParamsRoot<'a> {\n63\t    pub sim: &'a mut SimConfig,\n64\t    pub camera: &'a mut CameraParams,\n65\t    pub view: &'a mut ViewSettings,\n66\t}\n67\t\n68\timpl Tunable for ParamsRoot<'_> {\n69\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n70\t        self.sim.visit_groups(v);\n71\t        nested(v, \"camera\", self.camera);\n72\t        nested(v, \"view\", self.view);\n73\t    }\n74\t}\n75\t\n76\timpl Session {\n77\t    pub fn new(scene: &str, seed: u64) -> Result<Self> {\n78\t        // Materials first: props compile against them.\n79\t        #[cfg(not(target_arch = \"wasm32\"))]\n80\t        if let Err(error) = crate::material_tools::initialize_authored() {\n81\t            log::warn!(\"saved materials: {error:#}\");\n82\t        }\n83\t        #[cfg(not(target_arch = \"wasm32\"))]\n84\t        if let Err(error) = crate::asset_tools::initialize_authored() {\n85\t            log::warn!(\"saved objects: {error:#}\");\n86\t        }\n87\t        #[cfg(not(target_arch = \"wasm32\"))]\n88\t        if let Err(error) = crate::creature_tools::initialize_authored() {\n89\t            log::warn!(\"saved creatures: {error:#}\");\n90\t        }\n91\t        let mut sim = Sim::new(scene, seed)?;\n92\t        let mut camera = CameraRig::default();\n93\t        camera.snap(sim.state.focus);\n94\t        let prev_frame = sim.frame();\n95\t        let mut s = Self {\n96\t            sim,\n97\t            camera,\n98\t            view: ViewSettings::default(),\n99\t            input: InputFrame::default(),\n100\t            gpu: None,\n101\t            prev_frame,\n102\t            room_cam: None,\n103\t            cue_serial: 0,\n104\t            cue_base: None,\n105\t            events: Vec::new(),\n106\t            view_base: None,\n107\t            view_room: None,\n108\t            view_serial: 0,\n109\t            live: false,\n110\t            look: Default::default(),\n111\t            feedback: None,\n112\t            creature_owner: crate::creature_tools::new_owner(),\n113\t            ui: Default::default(),\n114\t        };\n115\t        s.sync_camera();\n116\t        Ok(s)\n117\t    }\n118\t\n119\t    /// Wraps the game's running simulation, camera and view for one live-bridge request.\n120\t    pub fn from_live(mut sim: Sim, camera: CameraRig, view: ViewSettings, gpu: Option<Gpu>) -> Self {\n121\t        let prev_frame = sim.frame();\n122\t        Self {\n123\t            sim,\n124\t            camera,\n125\t            view,\n126\t            input: InputFrame::default(),\n127\t            gpu,\n128\t            prev_frame,\n129\t            room_cam: None,\n130\t            cue_serial: 0,\n131\t            cue_base: None,\n132\t            events: Vec::new(),\n133\t            view_base: None,\n134\t            view_room: None,\n135\t            view_serial: 0,\n136\t            live: true,\n137\t            look: Default::default(),\n138\t            feedback: None,\n139\t            creature_owner: 0,\n140\t            ui: Default::default(),\n141\t        }\n142\t    }\n143\t\n144\t    /// Hands everything back to the game after a live-bridge request.\n145\t    pub fn into_live(self) -> (Sim, CameraRig, ViewSettings, Option<Gpu>) {\n146\t        (self.sim, self.camera, self.view, self.gpu)\n147\t    }\n148\t\n149\t    pub fn is_live(&self) -> bool {\n150\t        self.live\n151\t    }\n152\t\n153\t    pub fn params(&mut self) -> ParamsRoot<'_> {\n154\t        ParamsRoot { sim: &mut self.sim.config, camera: &mut self.camera.params, view: &mut self.view }\n155\t    }\n156\t\n157\t    pub fn gpu(&mut self) -> Result<&mut Gpu> {\n158\t        if self.gpu.is_none() {\n159\t            let headless = Headless::new()?;\n160\t            let renderer = Renderer::new(&headless.device, &headless.queue);\n161\t            self.gpu = Some(Gpu {\n162\t                headless,\n163\t                renderer,\n164\t                builder: ViewBuilder::new(),\n165\t                studio_mode: pav_core::prop_preview::StudioMode::World,\n166\t                overlay: None,\n167\t            });\n168\t        }\n169\t        Ok(self.gpu.as_mut().unwrap())\n170\t    }\n171\t\n172\t    pub fn step(&mut self, ticks: u64) {\n173\t        for _ in 0..ticks {\n174\t            self.sim.step(&self.input);\n175\t            self.input.pressed = 0;\n176\t        }\n177\t        self.keep_events();\n178\t        self.sync_camera();\n179\t    }\n180\t\n181\t    /// Moves the simulation's new events into the render queue (bounded).\n182\t    pub fn keep_events(&mut self) {\n183\t        let ev = self.sim.drain_events();\n184\t        self.events.extend(ev);\n185\t        if self.events.len() > 400 {\n186\t            let cut = self.events.len() - 400;\n187\t            self.events.drain(..cut);\n188\t        }\n189\t    }\n190\t\n191\t    /// Drops live particles: a previewed prop's emitters must not drift into the next one.\n192\t    pub fn clear_particles(&mut self) {\n193\t        if let Some(gpu) = &mut self.gpu {\n194\t            gpu.builder.clear_particles();\n195\t            gpu.renderer.clear_particles();\n196\t        }\n197\t    }\n198\t\n199\t    /// Starts an isolated view with no bursts or particles left from the previous scene.\n200\t    pub fn clear_view_effects(&mut self) {\n201\t        self.events.clear();\n202\t        let _ = self.sim.drain_events();\n203\t        if let Some(gpu) = &mut self.gpu {\n204\t            gpu.builder = ViewBuilder::new();\n205\t            gpu.renderer.clear_particles();\n206\t            gpu.studio_mode = self.sim.studio_mode();\n207\t        }\n208\t    }\n209\t\n210\t    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\n211\t    /// cues, the way the game does (without blending). Called after every step.\n212\t    pub fn sync_camera(&mut self) {\n213\t        use pav_core::params::{ParamValue, apply_map};\n214\t        if self.live || self.sim.studio_active() {\n215\t            return;\n216\t        }\n217\t        let w = &self.sim.state.world;\n218\t        let now = w.current_room;\n219\t        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n220\t        let c = &self.sim.state.courses;\n221\t        if c.cue_serial != self.cue_serial {\n222\t            self.cue_serial = c.cue_serial;\n223\t            // Like the game: each cue applies on top of the camera from before the first cue;\n224\t            // sweeps start at their `from` value (captures are single moments).\n225\t            match c.cue() {\n226\t                Some(cue) => {\n227\t                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n228\t                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\n229\t                    let mut set = cue.set.clone();\n230\t                    for sw in &cue.sweep {\n231\t                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\n232\t                    }\n233\t                    if let Some(y) = set.get(\"yaw\").and_then(|v| v.as_f64()) {\n234\t                        set.insert(\"yaw\".into(), rot(y, q));\n235\t                    }\n236\t                    self.camera.params = base;\n237\t                    apply_map(&mut self.camera.params, &set);\n238\t                }\n239\t                None => {\n240\t                    if let Some(b) = self.cue_base.take() {\n241\t                        self.camera.params = b;\n242\t                    }\n243\t                }\n244\t            }\n245\t        }\n246\t        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\n247\t        if now != self.room_cam.as_ref().map(|r| r.0) {\n248\t            if let Some((_, saved)) = self.room_cam.take() {\n249\t                self.camera.params = saved;\n250\t            }\n251\t            if let Some(r) = now.and_then(|i| w.rooms.get(i as usize)).filter(|r| !r.def.camera.is_empty()) {\n252\t                let saved = self.camera.params.clone();\n253\t                let mut cam = r.def.camera.clone();\n254\t                let yaw = cam.get(\"yaw\").and_then(|v| v.as_f64()).unwrap_or(0.0);\n255\t                cam.insert(\"yaw\".into(), rot(yaw, r.place.quarters));\n256\t                apply_map(&mut self.camera.params, &cam);\n257\t                self.room_cam = Some((r.id, saved));\n258\t            }\n259\t        }\n260\t        self.sync_view();\n261\t    }\n262\t\n263\t    /// Takes `params` as the base camera and applies the current room's `[camera]` on top.\n264\t    pub fn reset_camera(&mut self, params: CameraParams) {\n265\t        self.camera.params = params;\n266\t        self.room_cam = None;\n267\t        self.cue_base = None;\n268\t        self.sync_camera();\n269\t    }\n270\t\n271\t    /// The camera without the current room's defaults.\n272\t    pub fn camera_base_or_current(&self) -> CameraParams {\n273\t        self.room_cam.as_ref().map(|(_, c)| c.clone()).unwrap_or_else(|| self.camera.params.clone())\n274\t    }\n275\t\n276\t    /// The view settings without the current room's / pads' overrides.\n277\t    pub fn view_base_or_current(&self) -> ViewSettings {\n278\t        self.view_base.clone().unwrap_or_else(|| self.view.clone())\n279\t    }\n280\t\n281\t    /// Takes `view` as the base settings and applies the current room's `[view]` table on top.\n282\t    pub fn reset_view(&mut self, view: ViewSettings) {\n283\t        self.view = view;\n284\t        self.view_base = None;\n285\t        self.view_room = None;\n286\t        self.view_serial = u64::MAX;\n287\t        self.sync_view();\n288\t    }\n289\t\n290\t    /// Room `[view]` tables and pad `view.*` overrides, like the game applies them.\n291\t    fn sync_view(&mut self) {\n292\t        let w = &self.sim.state.world;\n293\t        let now = w.current_room;\n294\t        let serial = self.sim.state.courses.view_serial;\n295\t        if now == self.view_room && serial == self.view_serial {\n296\t            return;\n297\t        }\n298\t        if let Some(base) = self.view_base.take() {\n299\t            self.view = base;\n300\t        }\n301\t        self.view_room = now;\n302\t        self.view_serial = serial;\n303\t        let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n304\t        let room =\n305\t            now.and_then(|i| w.rooms.get(i as usize)).map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n306\t        let pads = pav_view::build::room_view_map(&self.sim.state.courses.view, q);\n307\t        if room.is_empty() && pads.is_empty() {\n308\t            return;\n309\t        }\n310\t        self.view_base = Some(self.view.clone());\n311\t        self.view.apply(&room);\n312\t        self.view.apply(&pads);\n313\t    }\n314\t\n315\t    /// The view settings captures use: the session's, the game place's look, then the look\n316\t    /// layer.\n317\t    pub fn view_for(&self, frame: &pav_core::RenderFrame) -> ViewSettings {\n318\t        let mut view = self.view.clone();\n319\t        if let Some(g) = &frame.game {\n320\t            pav_view::arpg::place_look(g, &mut view);\n321\t        }\n322\t        self.look.apply(&mut view);\n323\t        view\n324\t    }\n325\t\n326\t    /// Renders the current state to RGBA8 pixels.\n327\t    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n328\t        let frame = self.sim.frame();\n329\t        let focus = frame.focus;\n330\t        self.camera.snap(focus);\n331\t        let camera = self.camera.clone();\n332\t        let view = self.view_for(&frame);\n333\t        let events = std::mem::take(&mut self.events);\n334\t        let gpu = self.gpu()?;\n335\t        gpu.prepare_frame(&frame);\n336\t        if !frame.studio_active() {\n337\t            gpu.builder.add_events(&events);\n338\t        }\n339\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n340\t        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n341\t    }\n342\t\n343\t    /// Renders like `render` with the game UI over it (when a game runs: Shardfall, or a\n344\t    /// `pav_core::games` game's HUD lines): the pixels, and what the UI drew (`None` without a\n345\t    /// game). `input` hovers or clicks.\n346\t    pub fn render_ui(\n347\t        &mut self,\n348\t        width: u32,\n349\t        height: u32,\n350\t        input: pav_ui::headless::Input,\n351\t    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n352\t        let frame = self.sim.frame();\n353\t        let focus = frame.focus;\n354\t        self.camera.snap(focus);\n355\t        let camera = self.camera.clone();\n356\t        let view = self.view_for(&frame);\n357\t        let events = std::mem::take(&mut self.events);\n358\t        let gpu = self.gpu()?;\n359\t        gpu.prepare_frame(&frame);\n360\t        if !frame.studio_active() {\n361\t            gpu.builder.add_events(&events);\n362\t        }\n363\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n364\t        let vp = scene.camera.proj * scene.camera.view;\n365\t        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n366\t        let gpu = self.gpu.as_mut().unwrap();\n367\t        let Some(paint) = drawn.as_ref().map(|d| &d.paint) else {\n368\t            return Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, None));\n369\t        };\n370\t        let device = gpu.renderer.device().clone();\n371\t        let overlay =\n372\t            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n373\t        let rgba = pav_render::capture::render_to_rgba_with(\n374\t            &mut gpu.renderer,\n375\t            &scene,\n376\t            width,\n377\t            height,\n378\t            |device, queue, encoder, target| overlay.paint(device, queue, encoder, target, (width, height), paint),\n379\t        )?;\n380\t        Ok((rgba, drawn))\n381\t    }\n382\t\n383\t    /// The game UI's reading without rendering (no GPU): what is on screen at `width` x\n384\t    /// `height` from the session's camera. `None` without a game.\n385\t    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n386\t        let frame = self.sim.frame();\n387\t        if !has_ui(&frame) {\n388\t            return None;\n389\t        }\n390\t        self.camera.snap(frame.focus);\n391\t        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n392\t        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n393\t    }\n394\t\n395\t    /// Renders `frame`, a stage the simulation does not hold (a material swatch), from the\n396\t    /// session's camera as it is.\n397\t    pub fn render_frame(&mut self, frame: &RenderFrame, width: u32, height: u32) -> Result<Vec<u8>> {\n398\t        let camera = self.camera.clone();\n399\t        let view = self.view_for(frame);\n400\t        let gpu = self.gpu()?;\n401\t        gpu.prepare_frame(frame);\n402\t        let scene = gpu.builder.build(frame, frame, 1.0, &camera, width as f32 / height as f32, &view, frame.focus);\n403\t        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n404\t    }\n405\t\n406\t    /// Renders like `render` and also returns the camera's view-projection (to place marks).\n407\t    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\n408\t        let frame = self.sim.frame();\n409\t        let focus = frame.focus;\n410\t        self.camera.snap(focus);\n411\t        let camera = self.camera.clone();\n412\t        let view = self.view_for(&frame);\n413\t        let events = std::mem::take(&mut self.events);\n414\t        let gpu = self.gpu()?;\n415\t        gpu.prepare_frame(&frame);\n416\t        if !frame.studio_active() {\n417\t            gpu.builder.add_events(&events);\n418\t        }\n419\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n420\t        let vp = scene.camera.proj * scene.camera.view;\n421\t        Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, vp))\n422\t    }\n423\t\n424\t    pub fn camera_eye(&self) -> Vec3 {\n425\t        self.camera.eye()\n426\t    }\n427\t\n428\t    pub fn focus(&self) -> Vec3 {\n429\t        self.sim.state.focus\n430\t    }\n431\t}\n432\t\n433\t/// A game's UI is on screen: Shardfall's, or a `pav_core::games` game's HUD lines.\n434\tpub fn has_ui(frame: &RenderFrame) -> bool {\n435\t    frame.game.is_some() || !frame.hud.lines.is_empty()\n436\t}\n437\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"110224cf-f4cc-4807-82ee-9bbd340099e1","timestamp":"2026-11-05T13:31:51.259Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_tools/src/session.rs","content":"use anyhow::Result;\nuse glam::Vec3;\nuse pav_core::params::{ParamVisitor, Tunable, nested};\nuse pav_core::{InputFrame, RenderFrame, Sim, SimConfig};\nuse pav_render::{Renderer, gpu::Headless};\nuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\n\npub struct Gpu {\n    pub headless: Headless,\n    pub renderer: Renderer,\n    pub builder: ViewBuilder,\n    /// The live bridge keeps this device between requests, even when the human UI opens or\n    /// closes a stage through a separate session with no GPU.\n    studio_mode: pav_core::prop_preview::StudioMode,\n    /// Paints the game UI over captures (made on first use).\n    overlay: Option<pav_ui::headless::Overlay>,\n}\n\nimpl Gpu {\n    fn prepare_frame(&mut self, frame: &RenderFrame) {\n        let studio_mode = frame.studio_mode();\n        if self.studio_mode != studio_mode {\n            self.builder = ViewBuilder::new();\n            self.renderer.clear_particles();\n            self.studio_mode = studio_mode;\n        }\n    }\n}\n\n/// One agent session: a simulation plus everything needed to look at it.\npub struct Session {\n    pub sim: Sim,\n    pub camera: CameraRig,\n    pub view: ViewSettings,\n    pub input: InputFrame,\n    pub gpu: Option<Gpu>,\n    pub prev_frame: RenderFrame,\n    /// Room whose camera defaults were applied last, and the camera before entering it.\n    room_cam: Option<(u16, CameraParams)>,\n    cue_serial: u64,\n    cue_base: Option<CameraParams>,\n    /// Events since the last render (they become particles and shockwaves in captures).\n    pub(crate) events: Vec<pav_core::frame::SimEvent>,\n    /// View settings before the current room's `[view]` table / pad overrides.\n    view_base: Option<ViewSettings>,\n    view_room: Option<u16>,\n    view_serial: u64,\n    /// Running inside the game (live bridge): the game applies room cameras and views itself.\n    pub(crate) live: bool,\n    /// The look layer (`look` tool, the game's Look & Filters menu): its sections that are on\n    /// replace the view settings in captures.\n    pub look: pav_view::look::Look,\n    /// Set by the native bridge. Headless sessions do not wait for or report window frames.\n    pub feedback: Option<crate::live_feedback::SharedFeedback>,\n    /// Live requests share owner 0; independent headless sessions adopt only their own jobs.\n    pub(crate) creature_owner: u64,\n    /// The game UI as the tools draw it (`ui`, captures): which windows are open, the device.\n    pub ui: pav_ui::headless::Headless,\n}\n\n/// All tunables reachable by path: `sim.*`, `camera.*`, `view.*`.\npub struct ParamsRoot<'a> {\n    pub sim: &'a mut SimConfig,\n    pub camera: &'a mut CameraParams,\n    pub view: &'a mut ViewSettings,\n}\n\nimpl Tunable for ParamsRoot<'_> {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        self.sim.visit_groups(v);\n        nested(v, \"camera\", self.camera);\n        nested(v, \"view\", self.view);\n    }\n}\n\nimpl Session {\n    pub fn new(scene: &str, seed: u64) -> Result<Self> {\n        // Materials first: props compile against them.\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = crate::material_tools::initialize_authored() {\n            log::warn!(\"saved materials: {error:#}\");\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = crate::asset_tools::initialize_authored() {\n            log::warn!(\"saved objects: {error:#}\");\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = crate::creature_tools::initialize_authored() {\n            log::warn!(\"saved creatures: {error:#}\");\n        }\n        let mut sim = Sim::new(scene, seed)?;\n        let mut camera = CameraRig::default();\n        camera.snap(sim.state.focus);\n        let prev_frame = sim.frame();\n        let mut s = Self {\n            sim,\n            camera,\n            view: ViewSettings::default(),\n            input: InputFrame::default(),\n            gpu: None,\n            prev_frame,\n            room_cam: None,\n            cue_serial: 0,\n            cue_base: None,\n            events: Vec::new(),\n            view_base: None,\n            view_room: None,\n            view_serial: 0,\n            live: false,\n            look: Default::default(),\n            feedback: None,\n            creature_owner: crate::creature_tools::new_owner(),\n            ui: Default::default(),\n        };\n        s.sync_camera();\n        Ok(s)\n    }\n\n    /// Wraps the game's running simulation, camera and view for one live-bridge request.\n    pub fn from_live(mut sim: Sim, camera: CameraRig, view: ViewSettings, gpu: Option<Gpu>) -> Self {\n        let prev_frame = sim.frame();\n        Self {\n            sim,\n            camera,\n            view,\n            input: InputFrame::default(),\n            gpu,\n            prev_frame,\n            room_cam: None,\n            cue_serial: 0,\n            cue_base: None,\n            events: Vec::new(),\n            view_base: None,\n            view_room: None,\n            view_serial: 0,\n            live: true,\n            look: Default::default(),\n            feedback: None,\n            creature_owner: 0,\n            ui: Default::default(),\n        }\n    }\n\n    /// Hands everything back to the game after a live-bridge request.\n    pub fn into_live(self) -> (Sim, CameraRig, ViewSettings, Option<Gpu>) {\n        (self.sim, self.camera, self.view, self.gpu)\n    }\n\n    pub fn is_live(&self) -> bool {\n        self.live\n    }\n\n    pub fn params(&mut self) -> ParamsRoot<'_> {\n        ParamsRoot { sim: &mut self.sim.config, camera: &mut self.camera.params, view: &mut self.view }\n    }\n\n    pub fn gpu(&mut self) -> Result<&mut Gpu> {\n        if self.gpu.is_none() {\n            let headless = Headless::new()?;\n            let renderer = Renderer::new(&headless.device, &headless.queue);\n            self.gpu = Some(Gpu {\n                headless,\n                renderer,\n                builder: ViewBuilder::new(),\n                studio_mode: pav_core::prop_preview::StudioMode::World,\n                overlay: None,\n            });\n        }\n        Ok(self.gpu.as_mut().unwrap())\n    }\n\n    pub fn step(&mut self, ticks: u64) {\n        for _ in 0..ticks {\n            self.sim.step(&self.input);\n            self.input.pressed = 0;\n        }\n        self.keep_events();\n        self.sync_camera();\n    }\n\n    /// Moves the simulation's new events into the render queue (bounded).\n    pub fn keep_events(&mut self) {\n        let ev = self.sim.drain_events();\n        self.events.extend(ev);\n        if self.events.len() > 400 {\n            let cut = self.events.len() - 400;\n            self.events.drain(..cut);\n        }\n    }\n\n    /// Drops live particles: a previewed prop's emitters must not drift into the next one.\n    pub fn clear_particles(&mut self) {\n        if let Some(gpu) = &mut self.gpu {\n            gpu.builder.clear_particles();\n            gpu.renderer.clear_particles();\n        }\n    }\n\n    /// Starts an isolated view with no bursts or particles left from the previous scene.\n    pub fn clear_view_effects(&mut self) {\n        self.events.clear();\n        let _ = self.sim.drain_events();\n        if let Some(gpu) = &mut self.gpu {\n            gpu.builder = ViewBuilder::new();\n            gpu.renderer.clear_particles();\n            gpu.studio_mode = self.sim.studio_mode();\n        }\n    }\n\n    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\n    /// cues, the way the game does (without blending). Called after every step.\n    pub fn sync_camera(&mut self) {\n        use pav_core::params::{ParamValue, apply_map};\n        if self.live || self.sim.studio_active() {\n            return;\n        }\n        let w = &self.sim.state.world;\n        let now = w.current_room;\n        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n        let c = &self.sim.state.courses;\n        if c.cue_serial != self.cue_serial {\n            self.cue_serial = c.cue_serial;\n            // Like the game: each cue applies on top of the camera from before the first cue;\n            // sweeps start at their `from` value (captures are single moments).\n            match c.cue() {\n                Some(cue) => {\n                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\n                    let mut set = cue.set.clone();\n                    for sw in &cue.sweep {\n                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\n                    }\n                    if let Some(y) = set.get(\"yaw\").and_then(|v| v.as_f64()) {\n                        set.insert(\"yaw\".into(), rot(y, q));\n                    }\n                    self.camera.params = base;\n                    apply_map(&mut self.camera.params, &set);\n                }\n                None => {\n                    if let Some(b) = self.cue_base.take() {\n                        self.camera.params = b;\n                    }\n                }\n            }\n        }\n        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\n        if now != self.room_cam.as_ref().map(|r| r.0) {\n            if let Some((_, saved)) = self.room_cam.take() {\n                self.camera.params = saved;\n            }\n            if let Some(r) = now.and_then(|i| w.rooms.get(i as usize)).filter(|r| !r.def.camera.is_empty()) {\n                let saved = self.camera.params.clone();\n                let mut cam = r.def.camera.clone();\n                let yaw = cam.get(\"yaw\").and_then(|v| v.as_f64()).unwrap_or(0.0);\n                cam.insert(\"yaw\".into(), rot(yaw, r.place.quarters));\n                apply_map(&mut self.camera.params, &cam);\n                self.room_cam = Some((r.id, saved));\n            }\n        }\n        self.sync_view();\n    }\n\n    /// Takes `params` as the base camera and applies the current room's `[camera]` on top.\n    pub fn reset_camera(&mut self, params: CameraParams) {\n        self.camera.params = params;\n        self.room_cam = None;\n        self.cue_base = None;\n        self.sync_camera();\n    }\n\n    /// The camera without the current room's defaults.\n    pub fn camera_base_or_current(&self) -> CameraParams {\n        self.room_cam.as_ref().map(|(_, c)| c.clone()).unwrap_or_else(|| self.camera.params.clone())\n    }\n\n    /// The view settings without the current room's / pads' overrides.\n    pub fn view_base_or_current(&self) -> ViewSettings {\n        self.view_base.clone().unwrap_or_else(|| self.view.clone())\n    }\n\n    /// Takes `view` as the base settings and applies the current room's `[view]` table on top.\n    pub fn reset_view(&mut self, view: ViewSettings) {\n        self.view = view;\n        self.view_base = None;\n        self.view_room = None;\n        self.view_serial = u64::MAX;\n        self.sync_view();\n    }\n\n    /// Room `[view]` tables and pad `view.*` overrides, like the game applies them.\n    fn sync_view(&mut self) {\n        let w = &self.sim.state.world;\n        let now = w.current_room;\n        let serial = self.sim.state.courses.view_serial;\n        if now == self.view_room && serial == self.view_serial {\n            return;\n        }\n        if let Some(base) = self.view_base.take() {\n            self.view = base;\n        }\n        self.view_room = now;\n        self.view_serial = serial;\n        let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n        let room =\n            now.and_then(|i| w.rooms.get(i as usize)).map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n        let pads = pav_view::build::room_view_map(&self.sim.state.courses.view, q);\n        if room.is_empty() && pads.is_empty() {\n            return;\n        }\n        self.view_base = Some(self.view.clone());\n        self.view.apply(&room);\n        self.view.apply(&pads);\n    }\n\n    /// The view settings captures use: the session's, the game place's look, then the look\n    /// layer.\n    pub fn view_for(&self, frame: &pav_core::RenderFrame) -> ViewSettings {\n        let mut view = self.view.clone();\n        if let Some(g) = &frame.game {\n            pav_view::arpg::place_look(g, &mut view);\n        }\n        self.look.apply(&mut view);\n        view\n    }\n\n    /// Renders the current state to RGBA8 pixels.\n    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` with the game UI over it (when a game runs: Shardfall, or a\n    /// `pav_core::games` game's HUD lines): the pixels, and what the UI drew (`None` without a\n    /// game). `input` hovers or clicks.\n    pub fn render_ui(\n        &mut self,\n        width: u32,\n        height: u32,\n        input: pav_ui::headless::Input,\n    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n        let gpu = self.gpu.as_mut().unwrap();\n        let Some(paint) = drawn.as_ref().map(|d| &d.paint) else {\n            return Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, None));\n        };\n        let device = gpu.renderer.device().clone();\n        let overlay =\n            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n        let rgba = pav_render::capture::render_to_rgba_with(\n            &mut gpu.renderer,\n            &scene,\n            width,\n            height,\n            |device, queue, encoder, target| overlay.paint(device, queue, encoder, target, (width, height), paint),\n        )?;\n        Ok((rgba, drawn))\n    }\n\n    /// The game UI's reading without rendering (no GPU): what is on screen at `width` x\n    /// `height` from the session's camera. `None` without a game.\n    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n        let frame = self.sim.frame();\n        if !has_ui(&frame) {\n            return None;\n        }\n        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n    }\n\n    /// Renders `frame`, a stage the simulation does not hold (a material swatch), from the\n    /// session's camera as it is.\n    pub fn render_frame(&mut self, frame: &RenderFrame, width: u32, height: u32) -> Result<Vec<u8>> {\n        let camera = self.camera.clone();\n        let view = self.view_for(frame);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(frame);\n        let scene = gpu.builder.build(frame, frame, 1.0, &camera, width as f32 / height as f32, &view, frame.focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` and also returns the camera's view-projection (to place marks).\n    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, vp))\n    }\n\n    pub fn camera_eye(&self) -> Vec3 {\n        self.camera.eye()\n    }\n\n    pub fn focus(&self) -> Vec3 {\n        self.sim.state.focus\n    }\n}\n\n/// A game's UI is on screen: Shardfall's, or a `pav_core::games` game's HUD lines.\npub fn has_ui(frame: &RenderFrame) -> bool {\n    frame.game.is_some() || !frame.hud.lines.is_empty()\n}\n","numLines":437,"startLine":1,"totalLines":437}},"tool_result_meta":[{"id":"toolu_01QWT6yYETzZzGFFEiG2jUSE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
