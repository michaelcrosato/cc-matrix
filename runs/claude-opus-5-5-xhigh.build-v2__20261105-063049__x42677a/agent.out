{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Tcmdf8XaC6CUW8R3yeJxf","type":"tool_result","content":"50\t             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\n\\\n51\t             Startup settings live in shardfall.toml next to the executable.\"\n52\t        );\n53\t        return;\n54\t    }\n55\t    log::info!(\n56\t        \"Shardfall {} ({} {}, {} build) — log file: {}\",\n57\t        env!(\"CARGO_PKG_VERSION\"),\n58\t        if cfg!(target_arch = \"wasm32\") { \"browser\" } else { std::env::consts::OS },\n59\t        std::env::consts::ARCH,\n60\t        if cfg!(debug_assertions) { \"debug\" } else { \"release\" },\n61\t        d.log_path.display()\n62\t    );\n63\t    let settings = match boot::stage(\"settings\", || {\n64\t        let (s, note) = settings::Settings::load(&args);\n65\t        Ok((s, note))\n66\t    }) {\n67\t        Ok(s) => s,\n68\t        Err(e) => fatal(&format!(\"{e:#}\")),\n69\t    };\n70\t    // The browser's event loop runs on after `run` returns; errors show on the page.\n71\t    #[cfg(target_arch = \"wasm32\")]\n72\t    if let Err(e) = app::run(settings) {\n73\t        fatal(&format!(\"{e:#}\"));\n74\t    }\n75\t    #[cfg(not(target_arch = \"wasm32\"))]\n76\t    match std::panic::catch_unwind(|| app::run(settings)) {\n77\t        Ok(Ok(())) => log::info!(\"clean exit\"),\n78\t        Ok(Err(e)) => fatal(&format!(\"{e:#}\")),\n79\t        Err(_) => {\n80\t            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \"unknown crash\".into());\n81\t            fatal(&format!(\"Shardfall crashed:\\n{msg}\"));\n82\t        }\n83\t    }\n84\t}\n85\t//! Window-bound graphics: surface, device, scene renderer and egui renderer.\n86\t\n87\tuse std::sync::Arc;\n88\t\n89\tuse anyhow::{Context, Result, anyhow};\n90\tuse pav_render::gpu::{self, BackendChoice};\n91\tuse pav_render::wgpu;\n92\tuse pav_render::{Renderer, Scene};\n93\tuse winit::window::Window;\n94\t\n95\tuse crate::boot::{stage, stage_async};\n96\t\n97\tpub struct Gfx {\n98\t    pub window: Arc<Window>,\n99\t    pub surface: wgpu::Surface<'static>,\n100\t    pub adapter: wgpu::Adapter,\n101\t    pub device: wgpu::Device,\n102\t    pub queue: wgpu::Queue,\n103\t    pub config: wgpu::SurfaceConfiguration,\n104\t    pub renderer: Renderer,\n105\t    pub egui: egui_wgpu::Renderer,\n106\t    pub vsync: bool,\n107\t    pub adapter_name: String,\n108\t    pub gpu_errors: Arc<std::sync::atomic::AtomicU32>,\n109\t}\n110\t\n111\timpl Gfx {\n112\t    #[cfg(not(target_arch = \"wasm32\"))]\n113\t    pub fn new(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n114\t        pollster_block(Self::create(window, backend, vsync))\n115\t    }\n116\t\n117\t    /// Creates everything; only the adapter and device requests wait (in the browser).\n118\t    pub async fn create(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n119\t        let web = cfg!(target_arch = \"wasm32\");\n120\t        let instance = stage(\"graphics instance\", || {\n121\t            Ok((gpu::create_instance(backend), format!(\"backend: {}\", if web { \"webgpu\" } else { backend.name() })))\n122\t        })?;\n123\t        let surface = stage(\"window surface\", || {\n124\t            let s = instance.create_surface(window.clone()).context(\"could not create a drawing surface for the window\")?;\n125\t            Ok((s, String::new()))\n126\t        })?;\n127\t        let adapter = stage_async(\"graphics adapter\", async {\n128\t            if !web {\n129\t                let all = gpu::list_adapters(&instance, backend);\n130\t                for a in &all {\n131\t                    log::info!(\"  found adapter: {}\", gpu::describe(a));\n132\t                }\n133\t                if all.is_empty() {\n134\t                    return Err(anyhow!(\n135\t                        \"no {} adapter found. Update your graphics driver{}\",\n136\t                        backend.name(),\n137\t                        if backend == BackendChoice::Vulkan { \", or try backend = \\\"dx12\\\" in shardfall.toml\" } else { \"\" }\n138\t                    ));\n139\t                }\n140\t            }\n141\t            let a = gpu::request_adapter_async(&instance, Some(&surface)).await.map_err(|e| {\n142\t                if web { anyhow!(\"{e:#}. This page needs a browser with WebGPU (a recent Chrome or Edge)\") } else { e }\n143\t            })?;\n144\t            let d = gpu::describe(&a.get_info());\n145\t            Ok((a, d))\n146\t        })\n147\t        .await?;\n148\t        let (device, queue) = stage_async(\"graphics device\", async {\n149\t            let (d, q) = gpu::request_device_async(&adapter).await?;\n150\t            Ok(((d, q), String::new()))\n151\t        })\n152\t        .await?;\n153\t        let gpu_errors = Arc::new(std::sync::atomic::AtomicU32::new(0));\n154\t        {\n155\t            let errs = gpu_errors.clone();\n156\t            device.on_uncaptured_error(Arc::new(move |e| {\n157\t                errs.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n158\t                log::error!(\"GPU error: {e}\");\n159\t            }));\n160\t            device.set_device_lost_callback(|reason, msg| log::error!(\"GPU device lost ({reason:?}): {msg}\"));\n161\t        }\n162\t        let size = window.inner_size();\n163\t        let config = stage(\"surface configure\", || {\n164\t            let caps = surface.get_capabilities(&adapter);\n165\t            let mut c = surface\n166\t                .get_default_config(&adapter, size.width.max(1), size.height.max(1))\n167\t                .context(\"surface not supported by adapter\")?;\n168\t            // Non-sRGB target: the post pass encodes sRGB itself, and egui expects a linear-blend target.\n169\t            c.format = caps.formats.iter().copied().find(|f| !f.is_srgb()).unwrap_or(c.format);\n170\t            c.present_mode = present_mode(&caps, vsync);\n171\t            surface.configure(&device, &c);\n172\t            Ok((c.clone(), format!(\"{:?}, {:?}, {}x{}\", c.format, c.present_mode, c.width, c.height)))\n173\t        })?;\n174\t        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);\n175\t        let renderer = stage(\"renderer & shaders\", || Ok((Renderer::new(&device, &queue), String::new())))?;\n176\t        if let Some(e) = scope.pop().await {\n177\t            return Err(anyhow!(\"shader/pipeline creation failed: {e}\"));\n178\t        }\n179\t        let egui = stage(\"ui renderer\", || {\n180\t            Ok((egui_wgpu::Renderer::new(&device, config.format, egui_wgpu::RendererOptions::default()), String::new()))\n181\t        })?;\n182\t        let adapter_name = gpu::describe(&adapter.get_info());\n183\t        Ok(Self { window, surface, adapter, device, queue, config, renderer, egui, vsync, adapter_name, gpu_errors })\n184\t    }\n185\t\n186\t    pub fn resize(&mut self, w: u32, h: u32) {\n187\t        if w == 0 || h == 0 {\n188\t            return;\n189\t        }\n190\t        self.config.width = w;\n191\t        self.config.height = h;\n192\t        self.surface.configure(&self.device, &self.config);\n193\t    }\n194\t\n195\t    pub fn set_vsync(&mut self, on: bool) {\n196\t        self.vsync = on;\n197\t        let caps = self.surface.get_capabilities(&self.adapter);\n198\t        self.config.present_mode = present_mode(&caps, on);\n199\t        self.surface.configure(&self.device, &self.config);\n200\t    }\n201\t\n202\t    /// Acquires the next surface texture, reconfiguring when needed. None = skip this frame.\n203\t    pub fn acquire(&mut self) -> Option<wgpu::SurfaceTexture> {\n204\t        match self.surface.get_current_texture() {\n205\t            wgpu::CurrentSurfaceTexture::Success(t) => Some(t),\n206\t            wgpu::CurrentSurfaceTexture::Suboptimal(t) => {\n207\t                // Use this frame, reconfigure for the next one.\n208\t                self.surface.configure(&self.device, &self.config);\n209\t                Some(t)\n210\t            }\n211\t            wgpu::CurrentSurfaceTexture::Outdated | wgpu::CurrentSurfaceTexture::Lost => {\n212\t                self.surface.configure(&self.device, &self.config);\n213\t                None\n214\t            }\n215\t            _ => None,\n216\t        }\n217\t    }\n218\t\n219\t    pub fn size(&self) -> (u32, u32) {\n220\t        (self.config.width, self.config.height)\n221\t    }\n222\t\n223\t    /// Renders the scene plus the egui overlay and presents. Texture updates are always\n224\t    /// applied (and the delta cleared), even when the frame is skipped.\n225\t    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\n226\t        let mut ui = ui;\n227\t        if let Some((_, textures, _)) = ui.as_mut() {\n228\t            for (id, deltas) in &textures.set {\n229\t                for delta in deltas {\n230\t                    self.egui.update_texture(&self.device, &self.queue, *id, delta);\n231\t                }\n232\t            }\n233\t        }\n234\t        let frame = self.acquire();\n235\t[package]\n236\tname = \"pav_app\"\n237\tversion.workspace = true\n238\tedition.workspace = true\n239\tpublish.workspace = true\n240\t\n241\t[[bin]]\n242\tname = \"shardfall\"\n243\tpath = \"src/main.rs\"\n244\t\n245\t[dependencies]\n246\tpav_core.workspace = true\n247\tpav_render.workspace = true\n248\tpav_view.workspace = true\n249\tpav_tools.workspace = true\n250\tpav_ui.workspace = true\n251\tpav_audio.workspace = true\n252\tglam.workspace = true\n253\twinit.workspace = true\n254\tegui.workspace = true\n255\tegui-wgpu = { workspace = true, features = [\"winit\"] }\n256\tgilrs.workspace = true\n257\tserde.workspace = true\n258\tserde_json.workspace = true\n259\tanyhow.workspace = true\n260\tlog.workspace = true\n261\tweb-time.workspace = true\n262\t\n263\t[target.'cfg(not(target_arch = \"wasm32\"))'.dependencies]\n264\tnotify.workspace = true\n265\tegui-winit = { workspace = true, features = [\"clipboard\"] }\n266\t\n267\t[target.'cfg(target_arch = \"wasm32\")'.dependencies]\n268\twasm-bindgen.workspace = true\n269\twasm-bindgen-futures.workspace = true\n270\tweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n271\t\n272\t[target.'cfg(windows)'.dependencies]\n273\twindows-sys = { version = \"0.61\", features = [\"Win32_UI_WindowsAndMessaging\", \"Win32_System_Console\", \"Win32_Foundation\"] }\n274\t\n275\t[lints]\n276\tworkspace = true\n277\t[package]\n278\tname = \"pav_ui\"\n279\tversion.workspace = true\n280\tedition.workspace = true\n281\tpublish.workspace = true\n282\t\n283\t[dependencies]\n284\tpav_core.workspace = true\n285\tglam.workspace = true\n286\tegui.workspace = true\n287\tegui-wgpu.workspace = true\n288\twgpu.workspace = true\n289\tserde.workspace = true\n290\tweb-time.workspace = true\n291\t\n292\t[lints]\n293\tworkspace = true\n294\t//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n295\t//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n296\t//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n297\t//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n298\t\n299\tpub mod arpg_items;\n300\tpub mod arpg_tree;\n301\tpub mod arpg_ui;\n302\tpub mod headless;\n303\tpub mod touch;\n304\t\n305\t/// The input device the player is on: hints and the HUD follow it.\n306\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n307\tpub enum Device {\n308\t    #[default]\n309\t    KeyboardMouse,\n310\t    Gamepad,\n311\t    /// A phone or tablet (touch.rs).\n312\t    Touch,\n313\t}\n314\t\n315\t/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n316\t/// scrolls. `on = false` puts the desktop sizes back.\n317\tpub fn touch_style(ctx: &egui::Context, on: bool) {\n318\t    use egui::{FontId, TextStyle};\n319\t    ctx.all_styles_mut(|s| {\n320\t        s.spacing = egui::style::Spacing::default();\n321\t        s.text_styles = egui::style::default_text_styles();\n322\t        if on {\n323\t            let sp = &mut s.spacing;\n324\t            sp.interact_size = egui::vec2(44.0, 34.0);\n325\t            sp.button_padding = egui::vec2(12.0, 7.0);\n326\t            sp.item_spacing = egui::vec2(10.0, 8.0);\n327\t            sp.slider_width = 170.0;\n328\t            sp.icon_width = 20.0;\n329\t            sp.icon_width_inner = 12.0;\n330\t            sp.combo_height = 320.0;\n331\t            sp.scroll = egui::style::ScrollStyle::solid();\n332\t            sp.scroll.bar_width = 8.0;\n333\t            for (style, size) in\n334\t                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n335\t            {\n336\t                s.text_styles.insert(style, FontId::proportional(size));\n337\t            }\n338\t            s.interaction.tooltip_delay = 0.35;\n339\t        }\n340\t    });\n341\t}\n342\t\n343\t/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\n344\tpub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n345\t    if h.lines.is_empty() {\n346\t        return;\n347\t    }\n348\t    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n349\t        egui::Frame::popup(ui.style()).show(ui, |ui| {\n350\t            for line in &h.lines {\n351\t                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n352\t            }\n353\t        });\n354\t    });\n355\t}\n356\t#!/usr/bin/env python3\n357\t\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n358\t\n359\tusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n360\t           [--theme-color C] [--scene NAME] [--out PATH]\n361\t\n362\tBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n363\t--single-file makes it and runs this. The page is web/index.html with the options written into\n364\tits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\n365\tgiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\n366\tloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\n367\tinline module script. The loader shows a progress line, bakes in --scene (used when the address\n368\tnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\n369\tURLs are needed. Out: target/web/<title>.html.\n370\t\"\"\"\n371\timport argparse\n372\timport base64\n373\timport gzip\n374\timport html\n375\timport json\n376\timport pathlib\n377\timport re\n378\timport sys\n379\t\n380\tROOT = pathlib.Path(__file__).resolve().parent.parent\n381\tPAGE = ROOT / \"web\" / \"index.html\"\n382\t\n383\t# Runs while the page parses, before index.html's module script.\n384\tLOADER = \"\"\"\n385\t(() => {\n386\t  const msg = document.getElementById('msg');\n387\t  // The start scene baked in at build time, unless the address names a room or a scene.\n388\t  const scene = __SCENE__, query = new URLSearchParams(location.search);\n389\t  if (scene && !query.get('room') && !query.get('scene')) {\n390\t    query.set('scene', scene);\n391\t    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n392\t    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n393\t  }\n394\t  const line = document.createElement('div');\n395\t  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n396\t  msg.style.flexDirection = 'column';\n397\t  msg.style.gap = '8px';\n398\t  msg.replaceChildren(`Loading ${document.title}…`, line);\n399\t  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n400\t  // The JS glue is the module script at the end of the page: it hands over its init function.\n401\t  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n402\t  window.loadGame = async () => {\n403\t    line.textContent = 'Unpacking…';\n404\t    await paint();\n405\t    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n406\t    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n407\t    block.remove();\n408\t    let packed;\n409\t    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n410\t    else {\n411\t      const bin = atob(text);\n412\t      packed = new Uint8Array(bin.length);\n413\t      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n414\t    }\n415\t    const wasm = new Uint8Array(size);\n416\t    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n417\t    let n = 0;\n418\t    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n419\t      wasm.set(r.value, n);\n420\t      n += r.value.length;\n421\t      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n422\t    }\n423\t    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n424\t    line.textContent = 'Starting…';\n425\t    await paint();\n426\t    const init = await glue;\n427\t    await init({ module_or_path: wasm });\n428\t  };\n429\t})();\n430\t\"\"\"\n431\t\n432\t\n433\tdef fail(text):\n434\t    sys.exit(f\"pack_single_html: {text}\")\n435\t\n436\t\n437\tdef replace_one(page, pattern, make, what):\n438\t    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n439\t    page, n = re.subn(pattern, make, page)\n440\t    if n != 1:\n441\t        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n442\t    return page\n443\t\n444\t\n445\tdef main():\n446\t    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n447\t    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n448\t    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n449\t    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n450\t    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n451\t    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n452\t    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n453\t    a = ap.parse_args()\n454\t\n455\t    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n456\t    for p in (js, wasm_path):\n457\t        if not p.is_file():\n458\t            fail(f\"{p} is missing: run wasm-bindgen --target web --out-name shardfall first\")\n459\t    # The glue goes in the page as an inline module script, so it can't import other files\n460\t    # (wasm-bindgen snippets) or hold text that would end the script element early.\n461\t    glue = js.read_text(encoding=\"utf-8\")\n462\t    if (a.bindgen_dir / \"snippets\").exists() or re.search(r\"^import\\b\", glue, re.M):\n463\t        fail(\"the JS glue imports other files (wasm-bindgen snippets); inline them before packing\")\n464\t    if re.search(r\"(?i)</script|<script|<!--\", glue):\n465\t        fail(\"the JS glue contains <script, </script or <!--, which can't sit inside an inline script\")\n466\t    init = re.search(r\"^export \\{[^}]*?\\b([\\w$]+) as default\\b\", glue, re.M)\n467\t    if not init:\n468\t        fail(\"can't find the JS glue's default export (its init function)\")\n469\t\n470\t    page = PAGE.read_text(encoding=\"utf-8\")\n471\t    if a.title is not None:\n472\t        page = replace_one(page, r\"<title>[^<]*</title>\", lambda m: f\"<title>{html.escape(a.title)}</title>\", \"<title>\")\n473\t    for name, value in ((\"description\", a.description), (\"theme-color\", a.theme_color)):\n474\t        if value is not None:\n475\t            page = replace_one(\n476\t                page,\n477\t                rf'<meta name=\"{name}\" content=\"[^\"]*\">',\n478\t                lambda m, name=name, value=value: f'<meta name=\"{name}\" content=\"{html.escape(value)}\">',\n479\t                f\"<meta name={name}>\",\n480\t            )\n481\t    # A manifest is another file to load: the single page goes without one.\n482\t    page = replace_one(page, r'[ \\t]*<link rel=\"manifest\"[^>]*>\\n', lambda m: \"\", \"manifest link\")\n483\t\n484\t    wasm = wasm_path.read_bytes()\n485\t    packed = gzip.compress(wasm, compresslevel=9, mtime=0)\n486\t    # JSON is valid JS; escaping \"<\" keeps a scene name from closing the script element.\n487\t    loader = LOADER.replace(\"__SCENE__\", json.dumps(a.scene or None).replace(\"<\", \"\\\\u003c\"))\n488\t    tail = (\n489\t        f'<script id=\"game-wasm\" type=\"application/octet-stream\" data-size=\"{len(wasm)}\">'\n490\t        f\"{base64.b64encode(packed).decode()}</script>\\n\"\n491\t        f\"<script>{loader}</script>\\n\"\n492\t        f'<script type=\"module\">\\n{glue}\\nwindow.gameGlue({init[1]});\\n</script>\\n'\n493\t    )\n494\t    page = replace_one(page, r\"</body>\", lambda m: tail + \"</body>\", \"</body>\")\n495\t\n496\t    title = a.title if a.title is not None else html.unescape(re.search(r\"<title>([^<]*)</title>\", page)[1])\n497\t    out = a.out or ROOT / \"target\" / \"web\" / f\"{re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-') or 'game'}.html\"\n498\t    out.parent.mkdir(parents=True, exist_ok=True)\n499\t    out.write_text(page, encoding=\"utf-8\")\n500\t    mb = lambda n: f\"{n / 1e6:.1f} MB\"  # noqa: E731\n501\t    print(f\"{out}: {mb(out.stat().st_size)} (wasm {mb(len(wasm))}, gzipped {mb(len(packed))}; JS glue {mb(len(glue))})\")\n502\t\n503\t\n504\tif __name__ == \"__main__\":\n505\t    main()\n506\t#!/usr/bin/env bash\n507\t# Builds the browser version (WebAssembly + WebGPU). Output: target/web/{index.html,manifest.webmanifest,shardfall.js,shardfall_bg.wasm}\n508\t# Serve that folder over HTTP (e.g. `python3 -m http.server -d target/web`) and open it in Chrome or Edge.\n509\t# --single-file writes only target/web/<title>.html (shardfall.html): one page with the glue and gzipped wasm inside\n510\t#   that runs from file:// or any host (scripts/pack_single_html.py; also --title, --description, --theme-color,\n511\t#   --scene NAME for the start scene when the address names none, --out PATH).\n512\t# Needs: rustup target add wasm32-unknown-unknown\n513\t#        cargo install wasm-bindgen-cli --version <the wasm-bindgen version in Cargo.lock>\n514\tset -euo pipefail\n515\tcaller=$PWD\n516\tcd \"$(dirname \"$0\")/..\"\n517\tsingle=false\n518\tpack=()\n519\twhile (($#)); do\n520\t\tcase $1 in\n521\t\t--single-file) single=true ;;\n522\t\t--title | --description | --theme-color | --scene | --out)\n523\t\t\t(($# > 1)) || { echo \"build-web.sh: $1 needs a value\" >&2; exit 2; }\n524\t\t\tvalue=$2\n525\t\t\t[[ $1 == --out && $value != /* ]] && value=$caller/$value\n526\t\t\tpack+=(\"$1\" \"$value\")\n527\t\t\tshift\n528\t\t\t;;\n529\t\t*) echo \"build-web.sh: unknown option $1 (options are listed at the top of $0)\" >&2; exit 2 ;;\n530\t\tesac\n531\t\tshift\n532\tdone\n533\tif ((${#pack[@]})) && ! $single; then\n534\t\techo \"build-web.sh: ${pack[0]} needs --single-file\" >&2\n535\t\texit 2\n536\tfi\n537\tcargo build --locked --profile dist --target wasm32-unknown-unknown -p pav_app\n538\twasm=${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/dist/shardfall.wasm\n539\tout=target/web\n540\tif $single; then\n541\t\tbindgen=$(mktemp -d)\n542\t\ttrap 'rm -rf \"$bindgen\"' EXIT\n543\t\twasm-bindgen --target web --no-typescript --out-dir \"$bindgen\" --out-name shardfall \"$wasm\"\n544\t\tpython3 -I scripts/pack_single_html.py \"$bindgen\" \"${pack[@]}\"\n545\t\texit\n546\tfi\n547\trm -rf \"$out\"\n548\tmkdir -p \"$out\"\n549\twasm-bindgen --target web --no-typescript --out-dir \"$out\" --out-name shardfall \"$wasm\"\n550\tcp web/index.html web/manifest.webmanifest \"$out/\"\n551\tls -la \"$out\"\n552\t<!doctype html>\n553\t<html lang=\"en\">\n554\t<head>\n555\t<meta charset=\"utf-8\">\n556\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n557\t<title>Shardfall</title>\n558\t<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n559\t<meta name=\"theme-color\" content=\"#15171c\">\n560\t<meta name=\"mobile-web-app-capable\" content=\"yes\">\n561\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n562\t<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n563\t<link rel=\"manifest\" href=\"manifest.webmanifest\">\n564\t<link rel=\"icon\" href=\"data:,\">\n565\t<style>\n566\t  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n567\t  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n568\t               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n569\t               -webkit-tap-highlight-color: transparent; }\n570\t  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n571\t     dvh: the height that is visible while a phone's browser bars come and go. */\n572\t  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n573\t           outline: none; touch-action: none; }\n574\t  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n575\t         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n576\t  /* Phones held upright: a hint to turn sideways that fades by itself. */\n577\t  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n578\t          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n579\t          pointer-events: none; animation: fade 1s 5s forwards; }\n580\t  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n581\t  @keyframes fade { to { opacity: 0; } }\n582\t</style>\n583\t</head>\n584\t<body>\n585\t<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n586\t<div id=\"turn\">Turn your phone sideways for the best view</div>\n587\t<script type=\"module\">\n588\t  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n589\t  // Messages name the game by the page title (a single-file build may retitle it).\n590\t  const name = document.title;\n591\t  const msg = document.getElementById('msg');\n592\t  if (!navigator.gpu) {\n593\t    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n594\t      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n595\t  } else {\n596\t    // The game hides this message once its canvas exists, and takes keyboard focus.\n597\t    new MutationObserver((_, obs) => {\n598\t      const c = document.querySelector('canvas');\n599\t      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n600\t    }).observe(document.body, { childList: true });\n601\t    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n602\t    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n603\t    if (matchMedia('(pointer: coarse)').matches) {\n604\t      addEventListener('pointerup', () => {\n605\t        const el = document.documentElement;\n606\t        if (!document.fullscreenElement && el.requestFullscreen) {\n607\t          el.requestFullscreen({ navigationUI: 'hide' })\n608\t            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n609\t            .catch(() => {});\n610\t        }\n611\t      }, { once: true, capture: true });\n612\t    }\n613\t    try {\n614\t      // The game is shardfall.js and its .wasm beside this page. A single-file build\n615\t      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n616\t      if (window.loadGame) await window.loadGame();\n617\t      else await (await import('./shardfall.js')).default();\n618\t    } catch (error) {\n619\t      console.error(`${name} failed to load:`, error);\n620\t      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n621\t      document.body.append(msg);\n622\t    }\n623\t  }\n624\t</script>\n625\t</body>\n626\t</html>\n627\t15:    /// --scene NAME or --room NAME.\n628\t16:    pub scene: String,\n629\t43:            scene: String::new(),\n630\t65:        let query = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();\n631\t68:                s.scene = format!(\"world/{r}\");\n632\t70:            if let Some(r) = p.get(\"scene\").filter(|r| !r.is_empty()) {\n633\t71:                s.scene = r;\n634\t83:        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\n635\t84:            s.scene = \"empty\".into();\n636\t86:        if s.scene.is_empty() {\n637\t87:            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n638\t88:            s.scene = \"town\".into();\n639\t150:                \"--scene\" => s.scene = it.next().cloned().unwrap_or(s.scene),\n640\t151:                \"--room\" => s.scene = it.next().map(|r| format!(\"world/{r}\")).unwrap_or(s.scene),\n641\t165:            if s.scene.is_empty() {\n642\t166:                s.scene = \"empty\".into();\n643\t172:        if s.scene.is_empty() {\n644\t173:            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n645\t174:            s.scene = \"town\".into();\n646\t194:            \"start_room\" if !v.is_empty() => s.scene = format!(\"world/{v}\"),\n647\t//! Tools for games built on the engine (`pav_core::games`): the starter and any game an agent\n648\t//! adds there.\n649\t\n650\tuse anyhow::{Result, bail};\n651\tuse pav_core::Sim;\n652\tuse pav_core::games::{GAMES, Outcome};\n653\tuse serde_json::json;\n654\t\n655\tuse crate::session::Session;\n656\tuse crate::tools::{Args, Output, get_bool, get_u64};\n657\t\n658\t/// `play`: the running game's HUD, outcome and state; `bot=true` lets its bot play on;\n659\t/// `seeds=N` plays fresh runs on seeds 1..N with the bot and leaves the session alone.\n660\tpub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n661\t    let keys = || GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \");\n662\t    let Some(key) = s.sim.play().map(|g| g.key()) else {\n663\t        bail!(\"no game is running: `load scene=<key>` with one of: {}\", keys());\n664\t    };\n665\t    let bot = get_bool(a, \"bot\", false)?;\n666\t    let ticks = get_u64(a, \"ticks\", 3600)?;\n667\t    let hz = s.sim.config.tick_rate.hz() as f64;\n668\t    if a.contains_key(\"seeds\") {\n669\t        if !bot {\n670\t            bail!(\"seeds= runs the bot: add bot=true\");\n671\t        }\n672\t        let n = get_u64(a, \"seeds\", 1)?.clamp(1, 200);\n673\t        let scene = s.sim.state.scene.clone();\n674\t        let (mut runs, mut not_won) = (Vec::new(), Vec::new());\n675\t        let mut wins = 0;\n676\t        for seed in 1..=n {\n677\t            let mut sim = Sim::new(&scene, seed)?;\n678\t            sim.config = s.sim.config.clone();\n679\t            let (outcome, played) = sim.run_bot(ticks);\n680\t            runs.push(json!([seed, outcome, round2(played as f64 / hz)]));\n681\t            if outcome == Outcome::Won {\n682\t                wins += 1;\n683\t            } else {\n684\t                // The state where the bot lost or ran out of time, to see why.\n685\t                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n686\t            }\n687\t        }\n688\t        return Ok(Output::Json(json!({\n689\t            \"game\": key,\n690\t            \"wins\": format!(\"{wins}/{n}\"),\n691\t            \"cols\": \"seed outcome seconds\",\n692\t            \"runs\": runs,\n693\t            \"not_won\": not_won,\n694\t        })));\n695\t    }\n696\t    let mut played = None;\n697\t    if bot {\n698\t        let (_, t) = s.sim.run_bot(ticks);\n699\t        s.keep_events();\n700\t        s.sync_camera();\n701\t        played = Some(round2(t as f64 / hz));\n702\t    }\n703\t    let g = s.sim.play().expect(\"the game is still running\");\n704\t    Ok(Output::Json(json!({\n705\t        \"game\": key,\n706\t        \"outcome\": g.outcome(),\n707\tcrates/pav_tools/src/tools.rs:108:        name: \"input\",\n708\tcrates/pav_tools/src/tools.rs:1358:fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\n709\t178:                crate::game_lines(&ctx, hud_lines);\n710\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"9ffa83a0-93fc-4cbe-8a65-2159c061cde8","timestamp":"2026-11-05T13:32:28.915Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-xhigh-build-v2--20261105-063049--x42677a-work/092dc2e9-85ec-49f9-8a5e-82413bbc454c/tool-results/bnnrsbp22.txt","content":"             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\n\\\n             Startup settings live in shardfall.toml next to the executable.\"\n        );\n        return;\n    }\n    log::info!(\n        \"Shardfall {} ({} {}, {} build) — log file: {}\",\n        env!(\"CARGO_PKG_VERSION\"),\n        if cfg!(target_arch = \"wasm32\") { \"browser\" } else { std::env::consts::OS },\n        std::env::consts::ARCH,\n        if cfg!(debug_assertions) { \"debug\" } else { \"release\" },\n        d.log_path.display()\n    );\n    let settings = match boot::stage(\"settings\", || {\n        let (s, note) = settings::Settings::load(&args);\n        Ok((s, note))\n    }) {\n        Ok(s) => s,\n        Err(e) => fatal(&format!(\"{e:#}\")),\n    };\n    // The browser's event loop runs on after `run` returns; errors show on the page.\n    #[cfg(target_arch = \"wasm32\")]\n    if let Err(e) = app::run(settings) {\n        fatal(&format!(\"{e:#}\"));\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    match std::panic::catch_unwind(|| app::run(settings)) {\n        Ok(Ok(())) => log::info!(\"clean exit\"),\n        Ok(Err(e)) => fatal(&format!(\"{e:#}\")),\n        Err(_) => {\n            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \"unknown crash\".into());\n            fatal(&format!(\"Shardfall crashed:\\n{msg}\"));\n        }\n    }\n}\n//! Window-bound graphics: surface, device, scene renderer and egui renderer.\n\nuse std::sync::Arc;\n\nuse anyhow::{Context, Result, anyhow};\nuse pav_render::gpu::{self, BackendChoice};\nuse pav_render::wgpu;\nuse pav_render::{Renderer, Scene};\nuse winit::window::Window;\n\nuse crate::boot::{stage, stage_async};\n\npub struct Gfx {\n    pub window: Arc<Window>,\n    pub surface: wgpu::Surface<'static>,\n    pub adapter: wgpu::Adapter,\n    pub device: wgpu::Device,\n    pub queue: wgpu::Queue,\n    pub config: wgpu::SurfaceConfiguration,\n    pub renderer: Renderer,\n    pub egui: egui_wgpu::Renderer,\n    pub vsync: bool,\n    pub adapter_name: String,\n    pub gpu_errors: Arc<std::sync::atomic::AtomicU32>,\n}\n\nimpl Gfx {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    pub fn new(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n        pollster_block(Self::create(window, backend, vsync))\n    }\n\n    /// Creates everything; only the adapter and device requests wait (in the browser).\n    pub async fn create(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n        let web = cfg!(target_arch = \"wasm32\");\n        let instance = stage(\"graphics instance\", || {\n            Ok((gpu::create_instance(backend), format!(\"backend: {}\", if web { \"webgpu\" } else { backend.name() })))\n        })?;\n        let surface = stage(\"window surface\", || {\n            let s = instance.create_surface(window.clone()).context(\"could not create a drawing surface for the window\")?;\n            Ok((s, String::new()))\n        })?;\n        let adapter = stage_async(\"graphics adapter\", async {\n            if !web {\n                let all = gpu::list_adapters(&instance, backend);\n                for a in &all {\n                    log::info!(\"  found adapter: {}\", gpu::describe(a));\n                }\n                if all.is_empty() {\n                    return Err(anyhow!(\n                        \"no {} adapter found. Update your graphics driver{}\",\n                        backend.name(),\n                        if backend == BackendChoice::Vulkan { \", or try backend = \\\"dx12\\\" in shardfall.toml\" } else { \"\" }\n                    ));\n                }\n            }\n            let a = gpu::request_adapter_async(&instance, Some(&surface)).await.map_err(|e| {\n                if web { anyhow!(\"{e:#}. This page needs a browser with WebGPU (a recent Chrome or Edge)\") } else { e }\n            })?;\n            let d = gpu::describe(&a.get_info());\n            Ok((a, d))\n        })\n        .await?;\n        let (device, queue) = stage_async(\"graphics device\", async {\n            let (d, q) = gpu::request_device_async(&adapter).await?;\n            Ok(((d, q), String::new()))\n        })\n        .await?;\n        let gpu_errors = Arc::new(std::sync::atomic::AtomicU32::new(0));\n        {\n            let errs = gpu_errors.clone();\n            device.on_uncaptured_error(Arc::new(move |e| {\n                errs.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n                log::error!(\"GPU error: {e}\");\n            }));\n            device.set_device_lost_callback(|reason, msg| log::error!(\"GPU device lost ({reason:?}): {msg}\"));\n        }\n        let size = window.inner_size();\n        let config = stage(\"surface configure\", || {\n            let caps = surface.get_capabilities(&adapter);\n            let mut c = surface\n                .get_default_config(&adapter, size.width.max(1), size.height.max(1))\n                .context(\"surface not supported by adapter\")?;\n            // Non-sRGB target: the post pass encodes sRGB itself, and egui expects a linear-blend target.\n            c.format = caps.formats.iter().copied().find(|f| !f.is_srgb()).unwrap_or(c.format);\n            c.present_mode = present_mode(&caps, vsync);\n            surface.configure(&device, &c);\n            Ok((c.clone(), format!(\"{:?}, {:?}, {}x{}\", c.format, c.present_mode, c.width, c.height)))\n        })?;\n        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);\n        let renderer = stage(\"renderer & shaders\", || Ok((Renderer::new(&device, &queue), String::new())))?;\n        if let Some(e) = scope.pop().await {\n            return Err(anyhow!(\"shader/pipeline creation failed: {e}\"));\n        }\n        let egui = stage(\"ui renderer\", || {\n            Ok((egui_wgpu::Renderer::new(&device, config.format, egui_wgpu::RendererOptions::default()), String::new()))\n        })?;\n        let adapter_name = gpu::describe(&adapter.get_info());\n        Ok(Self { window, surface, adapter, device, queue, config, renderer, egui, vsync, adapter_name, gpu_errors })\n    }\n\n    pub fn resize(&mut self, w: u32, h: u32) {\n        if w == 0 || h == 0 {\n            return;\n        }\n        self.config.width = w;\n        self.config.height = h;\n        self.surface.configure(&self.device, &self.config);\n    }\n\n    pub fn set_vsync(&mut self, on: bool) {\n        self.vsync = on;\n        let caps = self.surface.get_capabilities(&self.adapter);\n        self.config.present_mode = present_mode(&caps, on);\n        self.surface.configure(&self.device, &self.config);\n    }\n\n    /// Acquires the next surface texture, reconfiguring when needed. None = skip this frame.\n    pub fn acquire(&mut self) -> Option<wgpu::SurfaceTexture> {\n        match self.surface.get_current_texture() {\n            wgpu::CurrentSurfaceTexture::Success(t) => Some(t),\n            wgpu::CurrentSurfaceTexture::Suboptimal(t) => {\n                // Use this frame, reconfigure for the next one.\n                self.surface.configure(&self.device, &self.config);\n                Some(t)\n            }\n            wgpu::CurrentSurfaceTexture::Outdated | wgpu::CurrentSurfaceTexture::Lost => {\n                self.surface.configure(&self.device, &self.config);\n                None\n            }\n            _ => None,\n        }\n    }\n\n    pub fn size(&self) -> (u32, u32) {\n        (self.config.width, self.config.height)\n    }\n\n    /// Renders the scene plus the egui overlay and presents. Texture updates are always\n    /// applied (and the delta cleared), even when the frame is skipped.\n    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\n        let mut ui = ui;\n        if let Some((_, textures, _)) = ui.as_mut() {\n            for (id, deltas) in &textures.set {\n                for delta in deltas {\n                    self.egui.update_texture(&self.device, &self.queue, *id, delta);\n                }\n            }\n        }\n        let frame = self.acquire();\n[package]\nname = \"pav_app\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[[bin]]\nname = \"shardfall\"\npath = \"src/main.rs\"\n\n[dependencies]\npav_core.workspace = true\npav_render.workspace = true\npav_view.workspace = true\npav_tools.workspace = true\npav_ui.workspace = true\npav_audio.workspace = true\nglam.workspace = true\nwinit.workspace = true\negui.workspace = true\negui-wgpu = { workspace = true, features = [\"winit\"] }\ngilrs.workspace = true\nserde.workspace = true\nserde_json.workspace = true\nanyhow.workspace = true\nlog.workspace = true\nweb-time.workspace = true\n\n[target.'cfg(not(target_arch = \"wasm32\"))'.dependencies]\nnotify.workspace = true\negui-winit = { workspace = true, features = [\"clipboard\"] }\n\n[target.'cfg(target_arch = \"wasm32\")'.dependencies]\nwasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\nweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n\n[target.'cfg(windows)'.dependencies]\nwindows-sys = { version = \"0.61\", features = [\"Win32_UI_WindowsAndMessaging\", \"Win32_System_Console\", \"Win32_Foundation\"] }\n\n[lints]\nworkspace = true\n[package]\nname = \"pav_ui\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\npav_core.workspace = true\nglam.workspace = true\negui.workspace = true\negui-wgpu.workspace = true\nwgpu.workspace = true\nserde.workspace = true\nweb-time.workspace = true\n\n[lints]\nworkspace = true\n//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n\npub mod arpg_items;\npub mod arpg_tree;\npub mod arpg_ui;\npub mod headless;\npub mod touch;\n\n/// The input device the player is on: hints and the HUD follow it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub enum Device {\n    #[default]\n    KeyboardMouse,\n    Gamepad,\n    /// A phone or tablet (touch.rs).\n    Touch,\n}\n\n/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n/// scrolls. `on = false` puts the desktop sizes back.\npub fn touch_style(ctx: &egui::Context, on: bool) {\n    use egui::{FontId, TextStyle};\n    ctx.all_styles_mut(|s| {\n        s.spacing = egui::style::Spacing::default();\n        s.text_styles = egui::style::default_text_styles();\n        if on {\n            let sp = &mut s.spacing;\n            sp.interact_size = egui::vec2(44.0, 34.0);\n            sp.button_padding = egui::vec2(12.0, 7.0);\n            sp.item_spacing = egui::vec2(10.0, 8.0);\n            sp.slider_width = 170.0;\n            sp.icon_width = 20.0;\n            sp.icon_width_inner = 12.0;\n            sp.combo_height = 320.0;\n            sp.scroll = egui::style::ScrollStyle::solid();\n            sp.scroll.bar_width = 8.0;\n            for (style, size) in\n                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n            {\n                s.text_styles.insert(style, FontId::proportional(size));\n            }\n            s.interaction.tooltip_delay = 0.35;\n        }\n    });\n}\n\n/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\npub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n    if h.lines.is_empty() {\n        return;\n    }\n    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            for line in &h.lines {\n                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n            }\n        });\n    });\n}\n#!/usr/bin/env python3\n\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n           [--theme-color C] [--scene NAME] [--out PATH]\n\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n--single-file makes it and runs this. The page is web/index.html with the options written into\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\nURLs are needed. Out: target/web/<title>.html.\n\"\"\"\nimport argparse\nimport base64\nimport gzip\nimport html\nimport json\nimport pathlib\nimport re\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nPAGE = ROOT / \"web\" / \"index.html\"\n\n# Runs while the page parses, before index.html's module script.\nLOADER = \"\"\"\n(() => {\n  const msg = document.getElementById('msg');\n  // The start scene baked in at build time, unless the address names a room or a scene.\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\n  if (scene && !query.get('room') && !query.get('scene')) {\n    query.set('scene', scene);\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n  }\n  const line = document.createElement('div');\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n  msg.style.flexDirection = 'column';\n  msg.style.gap = '8px';\n  msg.replaceChildren(`Loading ${document.title}…`, line);\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n  // The JS glue is the module script at the end of the page: it hands over its init function.\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n  window.loadGame = async () => {\n    line.textContent = 'Unpacking…';\n    await paint();\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n    block.remove();\n    let packed;\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n    else {\n      const bin = atob(text);\n      packed = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n    }\n    const wasm = new Uint8Array(size);\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n    let n = 0;\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n      wasm.set(r.value, n);\n      n += r.value.length;\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n    }\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n    line.textContent = 'Starting…';\n    await paint();\n    const init = await glue;\n    await init({ module_or_path: wasm });\n  };\n})();\n\"\"\"\n\n\ndef fail(text):\n    sys.exit(f\"pack_single_html: {text}\")\n\n\ndef replace_one(page, pattern, make, what):\n    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n    page, n = re.subn(pattern, make, page)\n    if n != 1:\n        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n    return page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n    a = ap.parse_args()\n\n    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n    for p in (js, wasm_path):\n        if not p.is_file():\n            fail(f\"{p} is missing: run wasm-bindgen --target web --out-name shardfall first\")\n    # The glue goes in the page as an inline module script, so it can't import other files\n    # (wasm-bindgen snippets) or hold text that would end the script element early.\n    glue = js.read_text(encoding=\"utf-8\")\n    if (a.bindgen_dir / \"snippets\").exists() or re.search(r\"^import\\b\", glue, re.M):\n        fail(\"the JS glue imports other files (wasm-bindgen snippets); inline them before packing\")\n    if re.search(r\"(?i)</script|<script|<!--\", glue):\n        fail(\"the JS glue contains <script, </script or <!--, which can't sit inside an inline script\")\n    init = re.search(r\"^export \\{[^}]*?\\b([\\w$]+) as default\\b\", glue, re.M)\n    if not init:\n        fail(\"can't find the JS glue's default export (its init function)\")\n\n    page = PAGE.read_text(encoding=\"utf-8\")\n    if a.title is not None:\n        page = replace_one(page, r\"<title>[^<]*</title>\", lambda m: f\"<title>{html.escape(a.title)}</title>\", \"<title>\")\n    for name, value in ((\"description\", a.description), (\"theme-color\", a.theme_color)):\n        if value is not None:\n            page = replace_one(\n                page,\n                rf'<meta name=\"{name}\" content=\"[^\"]*\">',\n                lambda m, name=name, value=value: f'<meta name=\"{name}\" content=\"{html.escape(value)}\">',\n                f\"<meta name={name}>\",\n            )\n    # A manifest is another file to load: the single page goes without one.\n    page = replace_one(page, r'[ \\t]*<link rel=\"manifest\"[^>]*>\\n', lambda m: \"\", \"manifest link\")\n\n    wasm = wasm_path.read_bytes()\n    packed = gzip.compress(wasm, compresslevel=9, mtime=0)\n    # JSON is valid JS; escaping \"<\" keeps a scene name from closing the script element.\n    loader = LOADER.replace(\"__SCENE__\", json.dumps(a.scene or None).replace(\"<\", \"\\\\u003c\"))\n    tail = (\n        f'<script id=\"game-wasm\" type=\"application/octet-stream\" data-size=\"{len(wasm)}\">'\n        f\"{base64.b64encode(packed).decode()}</script>\\n\"\n        f\"<script>{loader}</script>\\n\"\n        f'<script type=\"module\">\\n{glue}\\nwindow.gameGlue({init[1]});\\n</script>\\n'\n    )\n    page = replace_one(page, r\"</body>\", lambda m: tail + \"</body>\", \"</body>\")\n\n    title = a.title if a.title is not None else html.unescape(re.search(r\"<title>([^<]*)</title>\", page)[1])\n    out = a.out or ROOT / \"target\" / \"web\" / f\"{re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-') or 'game'}.html\"\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(page, encoding=\"utf-8\")\n    mb = lambda n: f\"{n / 1e6:.1f} MB\"  # noqa: E731\n    print(f\"{out}: {mb(out.stat().st_size)} (wasm {mb(len(wasm))}, gzipped {mb(len(packed))}; JS glue {mb(len(glue))})\")\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env bash\n# Builds the browser version (WebAssembly + WebGPU). Output: target/web/{index.html,manifest.webmanifest,shardfall.js,shardfall_bg.wasm}\n# Serve that folder over HTTP (e.g. `python3 -m http.server -d target/web`) and open it in Chrome or Edge.\n# --single-file writes only target/web/<title>.html (shardfall.html): one page with the glue and gzipped wasm inside\n#   that runs from file:// or any host (scripts/pack_single_html.py; also --title, --description, --theme-color,\n#   --scene NAME for the start scene when the address names none, --out PATH).\n# Needs: rustup target add wasm32-unknown-unknown\n#        cargo install wasm-bindgen-cli --version <the wasm-bindgen version in Cargo.lock>\nset -euo pipefail\ncaller=$PWD\ncd \"$(dirname \"$0\")/..\"\nsingle=false\npack=()\nwhile (($#)); do\n\tcase $1 in\n\t--single-file) single=true ;;\n\t--title | --description | --theme-color | --scene | --out)\n\t\t(($# > 1)) || { echo \"build-web.sh: $1 needs a value\" >&2; exit 2; }\n\t\tvalue=$2\n\t\t[[ $1 == --out && $value != /* ]] && value=$caller/$value\n\t\tpack+=(\"$1\" \"$value\")\n\t\tshift\n\t\t;;\n\t*) echo \"build-web.sh: unknown option $1 (options are listed at the top of $0)\" >&2; exit 2 ;;\n\tesac\n\tshift\ndone\nif ((${#pack[@]})) && ! $single; then\n\techo \"build-web.sh: ${pack[0]} needs --single-file\" >&2\n\texit 2\nfi\ncargo build --locked --profile dist --target wasm32-unknown-unknown -p pav_app\nwasm=${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/dist/shardfall.wasm\nout=target/web\nif $single; then\n\tbindgen=$(mktemp -d)\n\ttrap 'rm -rf \"$bindgen\"' EXIT\n\twasm-bindgen --target web --no-typescript --out-dir \"$bindgen\" --out-name shardfall \"$wasm\"\n\tpython3 -I scripts/pack_single_html.py \"$bindgen\" \"${pack[@]}\"\n\texit\nfi\nrm -rf \"$out\"\nmkdir -p \"$out\"\nwasm-bindgen --target web --no-typescript --out-dir \"$out\" --out-name shardfall \"$wasm\"\ncp web/index.html web/manifest.webmanifest \"$out/\"\nls -la \"$out\"\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Shardfall</title>\n<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n<meta name=\"theme-color\" content=\"#15171c\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" href=\"data:,\">\n<style>\n  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n               -webkit-tap-highlight-color: transparent; }\n  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n     dvh: the height that is visible while a phone's browser bars come and go. */\n  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n           outline: none; touch-action: none; }\n  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n  /* Phones held upright: a hint to turn sideways that fades by itself. */\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n          pointer-events: none; animation: fade 1s 5s forwards; }\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n  @keyframes fade { to { opacity: 0; } }\n</style>\n</head>\n<body>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n<div id=\"turn\">Turn your phone sideways for the best view</div>\n<script type=\"module\">\n  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n  // Messages name the game by the page title (a single-file build may retitle it).\n  const name = document.title;\n  const msg = document.getElementById('msg');\n  if (!navigator.gpu) {\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n  } else {\n    // The game hides this message once its canvas exists, and takes keyboard focus.\n    new MutationObserver((_, obs) => {\n      const c = document.querySelector('canvas');\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n    }).observe(document.body, { childList: true });\n    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n    if (matchMedia('(pointer: coarse)').matches) {\n      addEventListener('pointerup', () => {\n        const el = document.documentElement;\n        if (!document.fullscreenElement && el.requestFullscreen) {\n          el.requestFullscreen({ navigationUI: 'hide' })\n            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n            .catch(() => {});\n        }\n      }, { once: true, capture: true });\n    }\n    try {\n      // The game is shardfall.js and its .wasm beside this page. A single-file build\n      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n      if (window.loadGame) await window.loadGame();\n      else await (await import('./shardfall.js')).default();\n    } catch (error) {\n      console.error(`${name} failed to load:`, error);\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n      document.body.append(msg);\n    }\n  }\n</script>\n</body>\n</html>\n15:    /// --scene NAME or --room NAME.\n16:    pub scene: String,\n43:            scene: String::new(),\n65:        let query = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();\n68:                s.scene = format!(\"world/{r}\");\n70:            if let Some(r) = p.get(\"scene\").filter(|r| !r.is_empty()) {\n71:                s.scene = r;\n83:        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\n84:            s.scene = \"empty\".into();\n86:        if s.scene.is_empty() {\n87:            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n88:            s.scene = \"town\".into();\n150:                \"--scene\" => s.scene = it.next().cloned().unwrap_or(s.scene),\n151:                \"--room\" => s.scene = it.next().map(|r| format!(\"world/{r}\")).unwrap_or(s.scene),\n165:            if s.scene.is_empty() {\n166:                s.scene = \"empty\".into();\n172:        if s.scene.is_empty() {\n173:            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n174:            s.scene = \"town\".into();\n194:            \"start_room\" if !v.is_empty() => s.scene = format!(\"world/{v}\"),\n//! Tools for games built on the engine (`pav_core::games`): the starter and any game an agent\n//! adds there.\n\nuse anyhow::{Result, bail};\nuse pav_core::Sim;\nuse pav_core::games::{GAMES, Outcome};\nuse serde_json::json;\n\nuse crate::session::Session;\nuse crate::tools::{Args, Output, get_bool, get_u64};\n\n/// `play`: the running game's HUD, outcome and state; `bot=true` lets its bot play on;\n/// `seeds=N` plays fresh runs on seeds 1..N with the bot and leaves the session alone.\npub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n    let keys = || GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \");\n    let Some(key) = s.sim.play().map(|g| g.key()) else {\n        bail!(\"no game is running: `load scene=<key>` with one of: {}\", keys());\n    };\n    let bot = get_bool(a, \"bot\", false)?;\n    let ticks = get_u64(a, \"ticks\", 3600)?;\n    let hz = s.sim.config.tick_rate.hz() as f64;\n    if a.contains_key(\"seeds\") {\n        if !bot {\n            bail!(\"seeds= runs the bot: add bot=true\");\n        }\n        let n = get_u64(a, \"seeds\", 1)?.clamp(1, 200);\n        let scene = s.sim.state.scene.clone();\n        let (mut runs, mut not_won) = (Vec::new(), Vec::new());\n        let mut wins = 0;\n        for seed in 1..=n {\n            let mut sim = Sim::new(&scene, seed)?;\n            sim.config = s.sim.config.clone();\n            let (outcome, played) = sim.run_bot(ticks);\n            runs.push(json!([seed, outcome, round2(played as f64 / hz)]));\n            if outcome == Outcome::Won {\n                wins += 1;\n            } else {\n                // The state where the bot lost or ran out of time, to see why.\n                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n            }\n        }\n        return Ok(Output::Json(json!({\n            \"game\": key,\n            \"wins\": format!(\"{wins}/{n}\"),\n            \"cols\": \"seed outcome seconds\",\n            \"runs\": runs,\n            \"not_won\": not_won,\n        })));\n    }\n    let mut played = None;\n    if bot {\n        let (_, t) = s.sim.run_bot(ticks);\n        s.keep_events();\n        s.sync_camera();\n        played = Some(round2(t as f64 / hz));\n    }\n    let g = s.sim.play().expect(\"the game is still running\");\n    Ok(Output::Json(json!({\n        \"game\": key,\n        \"outcome\": g.outcome(),\ncrates/pav_tools/src/tools.rs:108:        name: \"input\",\ncrates/pav_tools/src/tools.rs:1358:fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\n178:                crate::game_lines(&ctx, hud_lines);\n","numLines":661,"startLine":50,"totalLines":710}},"tool_result_meta":[{"id":"toolu_019Tcmdf8XaC6CUW8R3yeJxf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
