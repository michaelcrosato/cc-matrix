{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019ratbpkxxduuu589a2WnD5","type":"tool_result","content":"1\t//! The game window: owns graphics, UI, input, the simulation thread and the camera.\n2\t\n3\tuse std::sync::Arc;\n4\t\n5\tuse web_time::Instant;\n6\t\n7\tuse anyhow::{Result, anyhow};\n8\tuse glam::{Mat4, Quat, Vec2, Vec3};\n9\tuse pav_core::params::{ParamVisitor, Tunable, nested};\n10\tuse pav_core::prop_preview::StudioMode;\n11\tuse pav_core::{InputFrame, Sim, SimConfig};\n12\tuse pav_render::gpu::BackendChoice;\n13\tuse pav_render::scene::{MeshInstance, MeshKey, Style, flags as rflags};\n14\tuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\n15\tuse winit::application::ApplicationHandler;\n16\tuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\n17\tuse winit::event_loop::{ActiveEventLoop, ControlFlow, EventLoop};\n18\tuse winit::keyboard::{KeyCode, PhysicalKey};\n19\tuse winit::window::{Fullscreen, Window, WindowId};\n20\t\n21\tuse crate::boot::{self, stage};\n22\tuse crate::edit::Editor;\n23\tuse crate::gfx::Gfx;\n24\tuse crate::hud::{CameraDirector, FeelOverlay, FeelSettings, HudCtx, Latency, LatencySample, PhysicsOverlay};\n25\tuse crate::input::{Device, Input};\n26\tuse crate::panel::{Panel, PanelAction};\n27\tuse crate::rooms::{RoomEntry, RoomHud, RoomWatcher, TeleportTarget};\n28\tuse crate::settings::Settings;\n29\tuse crate::simhost::SimHost;\n30\tuse crate::ui::{self, MenuAction};\n31\tuse crate::uiinput::UiInput;\n32\t\n33\t#[cfg(not(target_arch = \"wasm32\"))]\n34\tpub fn run(settings: Settings) -> Result<()> {\n35\t    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n36\t    event_loop.set_control_flow(ControlFlow::Poll);\n37\t    let mut app = App::new(settings);\n38\t    event_loop.run_app(&mut app)?;\n39\t    match app.fatal.take() {\n40\t        Some(e) => Err(anyhow!(e)),\n41\t        None => Ok(()),\n42\t    }\n43\t}\n44\t\n45\t/// In the browser the event loop runs from the page's animation frames; this returns at once.\n46\t#[cfg(target_arch = \"wasm32\")]\n47\tpub fn run(settings: Settings) -> Result<()> {\n48\t    use winit::platform::web::EventLoopExtWebSys;\n49\t    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n50\t    event_loop.set_control_flow(ControlFlow::Poll);\n51\t    event_loop.spawn_app(App::new(settings));\n52\t    Ok(())\n53\t}\n54\t\n55\t/// App-level tunables (the \"app\" group in the panel).\n56\t#[derive(Clone, Debug, PartialEq)]\n57\tpub struct AppSettings {\n58\t    pub vsync: bool,\n59\t    pub smoothing: bool,\n60\t    pub show_stats: bool,\n61\t    pub show_guide: bool,\n62\t    pub aim_marker: bool,\n63\t}\n64\t\n65\timpl Tunable for AppSettings {\n66\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n67\t        v.bool(\"vsync\", &mut self.vsync, \"Wait for the display refresh (off = lowest latency, may tear)\");\n68\t        v.bool(\"smoothing\", &mut self.smoothing, \"Interpolate between simulation ticks\");\n69\t        v.bool(\"show_stats\", &mut self.show_stats, \"FPS / tick overlay\");\n70\t        v.bool(\"show_guide\", &mut self.show_guide, \"Control guide overlay\");\n71\t        v.bool(\"aim_marker\", &mut self.aim_marker, \"Show where bombs will land\");\n72\t    }\n73\t}\n74\t\n75\t/// Sound settings (the \"audio\" group).\n76\t#[derive(Clone, Debug, PartialEq)]\n77\tpub struct AudioSettings {\n78\t    pub master: f32,\n79\t    pub sfx: f32,\n80\t    pub footsteps: bool,\n81\t}\n82\t\n83\timpl Tunable for AudioSettings {\n84\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n85\t        v.float(\"master\", &mut self.master, 0.0, 2.0, \"Master volume\");\n86\t        v.float(\"sfx\", &mut self.sfx, 0.0, 2.0, \"Sound effects volume\");\n87\t        v.bool(\"footsteps\", &mut self.footsteps, \"Footstep sounds\");\n88\t    }\n89\t}\n90\t\n91\tstruct Root<'a> {\n92\t    sim: &'a mut SimConfig,\n93\t    camera: &'a mut CameraParams,\n94\t    view: &'a mut ViewSettings,\n95\t    app: &'a mut AppSettings,\n96\t    audio: &'a mut AudioSettings,\n97\t}\n98\t\n99\timpl Tunable for Root<'_> {\n100\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n101\t        self.sim.visit_groups(v);\n102\t        nested(v, \"camera\", self.camera);\n103\t        nested(v, \"view\", self.view);\n104\t        nested(v, \"audio\", self.audio);\n105\t        nested(v, \"app\", self.app);\n106\t    }\n107\t}\n108\t\n109\t#[derive(Default)]\n110\tstruct Mouse {\n111\t    right_down: bool,\n112\t    pos: Vec2,\n113\t}\n114\t\n115\tstruct Fps {\n116\t    frames: u32,\n117\t    since: Instant,\n118\t    fps: f32,\n119\t    frame_ms: f32,\n120\t}\n121\t\n122\tpub struct App {\n123\t    settings: Settings,\n124\t    gfx: Option<Gfx>,\n125\t    egui_ctx: egui::Context,\n126\t    egui_state: Option<UiInput>,\n127\t    host: Option<SimHost>,\n128\t    rig: CameraRig,\n129\t    view: ViewSettings,\n130\t    /// View settings before the room's `[view]` table and pad overrides were applied, and\n131\t    /// which room / pad state they belong to.\n132\t    view_base: Option<ViewSettings>,\n133\t    view_key: (Option<u16>, u64),\n134\t    sim_config: SimConfig,\n135\t    app_settings: AppSettings,\n136\t    builder: ViewBuilder,\n137\t    input: Input,\n138\t    panel: Panel,\n139\t    menu_open: bool,\n140\t    paused_before_menu: bool,\n141\t    show_boot: bool,\n142\t    boot_done_at: Option<Instant>,\n143\t    started: Instant,\n144\t    last: Instant,\n145\t    fps: Fps,\n146\t    mouse: Mouse,\n147\t    screenshot_requested: bool,\n148\t    scene_name: String,\n149\t    toast: Option<(String, Instant)>,\n150\t    hud: RoomHud,\n151\t    watcher: Option<RoomWatcher>,\n152\t    editor: Editor,\n153\t    audio: Option<pav_audio::AudioOut>,\n154\t    audio_settings: AudioSettings,\n155\t    /// Tick at which the app last pushed its config (the sim's copy is adopted after that).\n156\t    config_push_tick: u64,\n157\t    latency: Latency,\n158\t    director: CameraDirector,\n159\t    feel: FeelOverlay,\n160\t    physics: PhysicsOverlay,\n161\t    quit: bool,\n162\t    /// Camera and look from before the game started (restored when leaving it).\n163\t    game_saved: Option<(CameraParams, ViewSettings)>,\n164\t    /// The Look & Filters window and the look layer over `view`.\n165\t    look_ui: crate::look_ui::LookUi,\n166\t    animation_ui: crate::animation_ui::AnimationUi,\n167\t    studio_mode: StudioMode,\n168\t    studio_navigation: bool,\n169\t    asset_ui: crate::asset_ui::AssetUi,\n170\t    asset_watcher: crate::asset_watch::AssetWatcher,\n171\t    creature_ui: crate::creature_ui::CreatureUi,\n172\t    creature_watcher: crate::creature_watch::CreatureWatcher,\n173\t    animation_watcher: Option<crate::animation_watch::AnimationWatcher>,\n174\t    animation_watch_attempted: bool,\n175\t    /// Station guide (H) and field guide.\n176\t    guide: crate::guide_ui::GuideUi,\n177\t    /// When the player last arrived somewhere new (another place, a teleport): the screen\n178\t    /// transition opens from then.\n179\t    arrival: Option<Instant>,\n180\t    /// Shardfall windows (inventory, vendor...), the latest game frame and the place whose\n181\t    /// look is applied.\n182\t    game_ui: crate::arpg_items::GameUi,\n183\t    /// When the hero was last saved.\n184\t    last_save: Instant,\n185\t    /// The gamepad's menu cursor (egui points) and the pointer events it makes this frame.\n186\t    pad_cursor: Option<Vec2>,\n187\t    pad_events: Vec<egui::Event>,\n188\t    pad_buttons: (bool, bool, bool),\n189\t    game_frame: Option<std::sync::Arc<pav_core::arpg::GameFrame>>,\n190\t    game_place: Option<pav_core::arpg::Place>,\n191\t    /// Phones and tablets: fingers, the on-screen controls and swipes (touch.rs).\n192\t    touch: crate::touch::Touch,\n193\t    /// The browser says this is a touch screen (or a finger has touched it).\n194\t    touch_screen: bool,\n195\t    /// The egui style has the touch sizes.\n196\t    touch_styled: bool,\n197\t    /// Touch screens draw at most 60 frames a second: when the next one is due.\n198\t    next_draw: Instant,\n199\t    /// Auto-attack, graphics quality, tips seen (saved).\n200\t    prefs: crate::save::Prefs,\n201\t    scaler: crate::quality::Scaler,\n202\t    #[cfg(not(target_arch = \"wasm32\"))]\n203\t    bridge: Option<crate::bridge::Bridge>,\n204\t    #[cfg(target_arch = \"wasm32\")]\n205\t    pending_gfx: Option<std::rc::Rc<std::cell::RefCell<Option<Result<Gfx>>>>>,\n206\t    #[cfg(target_arch = \"wasm32\")]\n207\t    audio_resumed: bool,\n208\t    init_started: bool,\n209\t    pub fatal: Option<String>,\n210\t}\n211\t\n212\timpl App {\n213\t    fn new(settings: Settings) -> Self {\n214\t        let scene_name = settings.scene.clone();\n215\t        let touch_screen = crate::platform::touch_screen();\n216\t        let mut app = Self {\n217\t            gfx: None,\n218\t            egui_ctx: egui::Context::default(),\n219\t            egui_state: None,\n220\t            host: None,\n221\t            rig: CameraRig::default(),\n222\t            view: ViewSettings::default(),\n223\t            view_base: None,\n224\t            view_key: (None, 0),\n225\t            sim_config: SimConfig::default(),\n226\t            app_settings: AppSettings {\n227\t                vsync: settings.vsync,\n228\t                smoothing: true,\n229\t                show_stats: true,\n230\t                show_guide: true,\n231\t                aim_marker: true,\n232\t            },\n233\t            builder: ViewBuilder::new(),\n234\t            input: Input::new(),\n235\t            panel: Panel::new(),\n236\t            menu_open: false,\n237\t            paused_before_menu: false,\n238\t            show_boot: true,\n239\t            boot_done_at: None,\n240\t            started: Instant::now(),\n241\t            last: Instant::now(),\n242\t            fps: Fps { frames: 0, since: Instant::now(), fps: 0.0, frame_ms: 0.0 },\n243\t            mouse: Mouse::default(),\n244\t            screenshot_requested: false,\n245\t            scene_name,\n246\t            toast: None,\n247\t            hud: RoomHud::default(),\n248\t            watcher: None,\n249\t            editor: Editor::default(),\n250\t            audio: None,\n251\t            audio_settings: AudioSettings { master: 0.8, sfx: 1.0, footsteps: true },\n252\t            config_push_tick: 0,\n253\t            latency: Latency::default(),\n254\t            director: CameraDirector::default(),\n255\t            feel: FeelOverlay::default(),\n256\t            physics: PhysicsOverlay::default(),\n257\t            quit: false,\n258\t            game_saved: None,\n259\t            look_ui: crate::look_ui::LookUi::load(),\n260\t            animation_ui: crate::animation_ui::AnimationUi::new(settings.animation_studio),\n261\t            studio_mode: StudioMode::World,\n262\t            studio_navigation: settings.animation_studio || settings.asset_studio || settings.creature_studio,\n263\t            asset_ui: crate::asset_ui::AssetUi::new(settings.asset_studio),\n264\t            asset_watcher: crate::asset_watch::AssetWatcher::new(),\n265\t            creature_ui: crate::creature_ui::CreatureUi::new(settings.creature_studio),\n266\t            creature_watcher: crate::creature_watch::CreatureWatcher::new(),\n267\t            animation_watcher: None,\n268\t            animation_watch_attempted: false,\n269\t            guide: Default::default(),\n270\t            arrival: None,\n271\t            game_ui: Default::default(),\n272\t            last_save: Instant::now(),\n273\t            pad_cursor: None,\n274\t            pad_events: Vec::new(),\n275\t            pad_buttons: (false, false, false),\n276\t            game_frame: None,\n277\t            game_place: None,\n278\t            touch: Default::default(),\n279\t            touch_screen,\n280\t            touch_styled: false,\n281\t            next_draw: Instant::now(),\n282\t            prefs: crate::save::load_prefs(),\n283\t            scaler: Default::default(),\n284\t            #[cfg(not(target_arch = \"wasm32\"))]\n285\t            bridge: None,\n286\t            #[cfg(target_arch = \"wasm32\")]\n287\t            pending_gfx: None,\n288\t            #[cfg(target_arch = \"wasm32\")]\n289\t            audio_resumed: false,\n290\t            init_started: false,\n291\t            fatal: None,\n292\t            settings,\n293\t        };\n294\t        if touch_screen {\n295\t            // Phones: touch controls from the start, none of the desktop's diagnostics.\n296\t            app.input.last_device = Device::Touch;\n297\t            app.show_boot = false;\n298\t            app.app_settings.show_stats = false;\n299\t        }\n300\t        app\n301\t    }\n302\t\n303\t    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n304\t    /// swipe or egui's (and then egui gets the event).\n305\t    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n306\t        #[cfg(target_arch = \"wasm32\")]\n307\t        self.resume_audio();\n308\t        let Some(g) = &self.gfx else { return };\n309\t        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n310\t        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n311\t        self.input.last_device = Device::Touch;\n312\t        self.touch_screen = true;\n313\t        use winit::event::TouchPhase as P;\n314\t        let to_egui = match t.phase {\n315\t            P::Started => {\n316\t                // (The root layer is everywhere; only windows and labels over the game count.)\n317\t                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n318\t                self.touch.down(t.id, pos, under)\n319\t            }\n320\t            P::Moved => self.touch.moved(t.id, pos),\n321\t            P::Ended => self.touch.up(t.id, pos, false),\n322\t            P::Cancelled => self.touch.up(t.id, pos, true),\n323\t        };\n324\t        if to_egui {\n325\t            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n326\t                st.on_window_event(&g.window, event);\n327\t            }\n328\t        }\n329\t    }\n330\t\n331\t    /// A tap on the open game closes what is open over it, one thing at a time.\n332\t    fn close_on_tap(&mut self) {\n333\t        if self.menu_open {\n334\t            self.set_menu(false);\n335\t        } else if self.game_ui.any_open() {\n336\t            self.game_ui.close_all();\n337\t        } else if self.game_ui.map {\n338\t            self.game_ui.map = false;\n339\t        } else if self.look_ui.open {\n340\t            self.look_ui.open = false;\n341\t            self.look_ui.save_if_dirty(true);\n342\t        } else if self.guide.station || self.guide.field {\n343\t            self.guide.station = false;\n344\t            self.guide.field = false;\n345\t        } else if self.hud.teleport_open {\n346\t            self.hud.teleport_open = false;\n347\t        } else if self.hud.card_visible() {\n348\t            self.hud.hide_card();\n349\t        }\n350\t    }\n351\t\n352\t    fn init(&mut self, el: &ActiveEventLoop) -> Result<()> {\n353\t        let s = self.settings.clone();\n354\t        let window = stage(\"window\", || {\n355\t            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");\n356\t            #[cfg(not(target_arch = \"wasm32\"))]\n357\t            {\n358\t                attrs = attrs.with_inner_size(winit::dpi::LogicalSize::new(s.width, s.height));\n359\t            }\n360\t            // In the browser the window is a canvas filling the page (sized by the page's CSS).\n361\t            #[cfg(target_arch = \"wasm32\")]\n362\t            {\n363\t                use winit::platform::web::WindowAttributesExtWebSys;\n364\t                attrs = attrs.with_append(true);\n365\t            }\n366\t            if s.fullscreen {\n367\t                attrs = attrs.with_fullscreen(Some(Fullscreen::Borderless(None)));\n368\t            }\n369\t            let w = Arc::new(el.create_window(attrs)?);\n370\t            let sz = w.inner_size();\n371\t            let d = format!(\"{}x{} px, scale {:.2}\", sz.width, sz.height, w.scale_factor());\n372\t            Ok((w, d))\n373\t        })?;\n374\t        let backend = BackendChoice::parse(&s.backend)\n375\t            .ok_or_else(|| anyhow!(\"unknown backend '{}' in settings (use vulkan or dx12)\", s.backend))?;\n376\t        #[cfg(not(target_arch = \"wasm32\"))]\n377\t        {\n378\t            let gfx = Gfx::new(window, backend, s.vsync)?;\n379\t            self.finish_init(gfx)\n380\t        }\n381\t        // The browser hands out the GPU asynchronously: `about_to_wait` finishes the start.\n382\t        #[cfg(target_arch = \"wasm32\")]\n383\t        {\n384\t            let slot = std::rc::Rc::new(std::cell::RefCell::new(None));\n385\t            let fill = slot.clone();\n386\t            wasm_bindgen_futures::spawn_local(async move {\n387\t                *fill.borrow_mut() = Some(Gfx::create(window, backend, s.vsync).await);\n388\t            });\n389\t            self.pending_gfx = Some(slot);\n390\t            Ok(())\n391\t        }\n392\t    }\n393\t\n394\t    /// The rest of the start, once graphics exist.\n395\t    fn finish_init(&mut self, gfx: Gfx) -> Result<()> {\n396\t        let s = self.settings.clone();\n397\t        let window = gfx.window.clone();\n398\t        let egui_state = stage(\"ui\", || {\n399\t            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n400\t            Ok((st, String::new()))\n401\t        })?;\n402\t        self.audio = stage(\"audio\", || match pav_audio::AudioOut::start() {\n403\t            Ok(a) => {\n404\t                let d = format!(\"{} @ {} Hz\", a.device, a.sample_rate);\n405\t                Ok((Some(a), d))\n406\t            }\n407\t            Err(e) => Ok((None, format!(\"no sound ({e}); continuing silently\"))),\n408\t        })?;\n409\t        // Rooms can name saved objects. Load the library before constructing the scene, and\n410\t        // the workshop materials before the objects that wear them.\n411\t        #[cfg(not(target_arch = \"wasm32\"))]\n412\t        if let Err(error) = pav_tools::material_tools::initialize_authored() {\n413\t            self.asset_ui.report(Err(format!(\"Could not load saved materials: {error:#}\")));\n414\t        }\n415\t        #[cfg(not(target_arch = \"wasm32\"))]\n416\t        if let Err(error) = pav_tools::asset_tools::initialize_authored() {\n417\t            self.asset_ui.report(Err(format!(\"Could not load saved objects: {error:#}\")));\n418\t        }\n419\t        #[cfg(not(target_arch = \"wasm32\"))]\n420\t        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n421\t            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n422\t        }\n423\t        let mut sim = stage(\"simulation\", || {\n424\t            let mut sim = Sim::new(&s.scene, s.seed)?;\n425\t            let mut d = format!(\n426\t                \"scene '{}', seed {}, {} entities, {} blocks\",\n427\t                s.scene,\n428\t                s.seed,\n429\t                sim.state.entities.len(),\n430\t                sim.state.statics.block_count()\n431\t            );\n432\t            if let Some(level) = crate::save::restore_into(&mut sim) {\n433\t                d += &format!(\", saved hero (level {level})\");\n434\t            }\n435\t            Ok((sim, d))\n436\t        })?;\n437\t        if s.animation_studio {\n438\t            // Read authored sets before selecting a clip. Keep the embedded library if a\n439\t            // file is invalid, so the studio can still open and report the error.\n440\t            #[cfg(not(target_arch = \"wasm32\"))]\n441\t            {\n442\t                let _ = pav_core::clips::library();\n443\t                if pav_core::anim::disk_dir().is_some() {\n444\t                    if let Err(e) = pav_core::anim::reload(true) {\n445\t                        self.animation_ui.report(Err(e));\n446\t                    }\n447\t                }\n448\t                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n449\t                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n450\t                }\n451\t            }\n452\t            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n453\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n454\t            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n455\t            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n456\t            let (live, rig, view, _) = session.into_live();\n457\t            sim = live;\n458\t            self.rig = rig;\n459\t            self.view = view;\n460\t            self.show_boot = false;\n461\t            self.app_settings.show_stats = false;\n462\t            self.app_settings.show_guide = false;\n463\t        }\n464\t        if s.asset_studio {\n465\t            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n466\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n467\t            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n468\t            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n469\t            let (live, rig, view, _) = session.into_live();\n470\t            sim = live;\n471\t            self.rig = rig;\n472\t            self.view = view;\n473\t            self.show_boot = false;\n474\t            self.app_settings.show_stats = false;\n475\t            self.app_settings.show_guide = false;\n476\t        }\n477\t        if s.creature_studio {\n478\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n479\t            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n480\t            if !s.creature_name.is_empty() {\n481\t                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n482\t            }\n483\t            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n484\t                .map(|output| match output {\n485\t                    pav_tools::Output::Json(v) => v,\n486\t                    pav_tools::Output::Image { meta, .. } => meta,\n487\t                })\n488\t                .map_err(|error| format!(\"{error:#}\"));\n489\t            self.creature_ui.report(result);\n490\t            let (live, rig, view, _) = session.into_live();\n491\t            sim = live;\n492\t            self.rig = rig;\n493\t            self.view = view;\n494\t            self.show_boot = false;\n495\t            self.app_settings.show_stats = false;\n496\t            self.app_settings.show_guide = false;\n497\t        }\n498\t        self.sim_config = sim.config.clone();\n499\t        self.rig.snap(sim.frame().focus);\n500\t        self.hud.entries = room_entries(&sim);\n501\t        self.hud.errors = sim.state.world.errors.clone();\n502\t        self.watcher = RoomWatcher::start();\n503\t        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n504\t        if self.animation_watch_attempted {\n505\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n506\t        }\n507\t        #[cfg(not(target_arch = \"wasm32\"))]\n508\t        if !s.pad_script.is_empty() {\n509\t            match std::fs::read_to_string(&s.pad_script)\n510\t                .map_err(|e| e.to_string())\n511\t                .and_then(|t| crate::input::PadScript::parse(&t))\n512\t            {\n513\t                Ok(p) => {\n514\t                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n515\t                    self.input.pad_script = Some(p);\n516\t                }\n517\t                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n518\t            }\n519\t        }\n520\t        #[cfg(not(target_arch = \"wasm32\"))]\n521\t        if !s.bridge.is_empty() {\n522\t            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n523\t                Ok(b) => {\n524\t                    let d = format!(\"listening on {}\", b.addr);\n525\t                    Ok((Some(b), d))\n526\t                }\n527\t                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n528\t            })?;\n529\t        }\n530\t        self.host = Some(SimHost::start(sim));\n531\t        self.gfx = Some(gfx);\n532\t        self.egui_state = Some(egui_state);\n533\t        Ok(())\n534\t    }\n535\t\n536\t    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n537\t    fn pad_ui_active(&self) -> bool {\n538\t        self.input.last_device == Device::Gamepad\n539\t            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n540\t    }\n541\t\n542\t    /// Gamepad in menus: D-pad down opens the hero's panels (LB / RB switch them), B closes;\n543\t    /// while a window is open the left stick (or D-pad) moves a cursor, A and X click left and\n544\t    /// right, the right stick scrolls, and the game gets no pad input.\n545\t    fn pad_menus(&mut self, dt: f32) {\n546\t        use gilrs::Button as B;\n547\t        let taps = std::mem::take(&mut self.input.pad.taps);\n548\t        let game = self.game_frame.is_some();\n549\t        if self.input.last_device != Device::Gamepad {\n550\t            self.pad_cursor = None;\n551\t            return;\n552\t        }\n553\t        let ui = &mut self.game_ui;\n554\t        if game && !self.menu_open && taps.contains(&B::DPadDown) && !ui.any_open() {\n555\t            ui.inventory = true;\n556\t            return;\n557\t        }\n558\t        if !self.pad_ui_active() {\n559\t            self.pad_cursor = None;\n560\t            if self.pad_buttons.2 {\n561\t                self.pad_events.push(egui::Event::ModifiersChanged(Default::default()));\n562\t            }\n563\t            self.pad_buttons = (false, false, false);\n564\t            return;\n565\t        }\n566\t        let ui = &mut self.game_ui;\n567\t        // Switch between the hero's panels.\n568\t        let cycle = taps.contains(&B::RightTrigger) as i32 - taps.contains(&B::LeftTrigger) as i32;\n569\t        if cycle != 0 && game && !self.menu_open {\n570\t            let now = [ui.inventory, ui.character, ui.skills, ui.tree.open].iter().position(|x| *x).unwrap_or(0) as i32;\n571\t            let next = (now + cycle).rem_euclid(4);\n572\t            ui.inventory = next == 0;\n573\t            ui.character = next == 1;\n574\t            ui.skills = next == 2;\n575\t            ui.tree.open = next == 3;\n576\t        }\n577\t        if taps.contains(&B::East) {\n578\t            if ui.any_open() {\n579\t                ui.close_all();\n580\t            } else if self.look_ui.open && !self.menu_open {\n581\t                self.look_ui.open = false;\n582\t                self.look_ui.save_if_dirty(true);\n583\t            } else if (self.guide.station || self.guide.field) && !self.menu_open {\n584\t                self.guide.station = false;\n585\t                self.guide.field = false;\n586\t            } else {\n587\t                self.set_menu(false);\n588\t            }\n589\t        }\n590\t        // The cursor.\n591\t        let screen = self.egui_ctx.content_rect();\n592\t        let mut p = self.pad_cursor.unwrap_or(Vec2::new(screen.center().x, screen.center().y));\n593\t        let stick = self.input.pad.left;\n594\t        let speed = 260.0 + 900.0 * stick.length().powi(2);\n595\t        p += Vec2::new(stick.x, -stick.y) * speed * dt;\n596\t        for (b, d) in [(B::DPadLeft, Vec2::NEG_X), (B::DPadRight, Vec2::X), (B::DPadUp, Vec2::NEG_Y), (B::DPadDown, Vec2::Y)] {\n597\t            if taps.contains(&b) {\n598\t                p += d * 40.0;\n599\t            }\n600\t        }\n601\t        p = p.clamp(Vec2::new(screen.min.x, screen.min.y), Vec2::new(screen.max.x - 2.0, screen.max.y - 2.0));\n602\t        let pos = egui::pos2(p.x, p.y);\n603\t        self.pad_events.push(egui::Event::PointerMoved(pos));\n604\t        let (a, x) = (self.input.pad.a_held, self.input.pad.x_held);\n605\t        let modifiers = egui::Modifiers { shift: self.input.pad.y_held, ..Default::default() };\n606\t        if self.input.pad.y_held != self.pad_buttons.2 {\n607\t            self.pad_events.push(egui::Event::ModifiersChanged(modifiers));\n608\t        }\n609\t        for (now, was, button) in\n610\t            [(a, self.pad_buttons.0, egui::PointerButton::Primary), (x, self.pad_buttons.1, egui::PointerButton::Secondary)]\n611\t        {\n612\t            if now != was {\n613\t                self.pad_events.push(egui::Event::PointerButton { pos, button, pressed: now, modifiers });\n614\t            }\n615\t        }\n616\t        self.pad_buttons = (a, x, self.input.pad.y_held);\n617\t        let scroll = self.input.pad.right.y;\n618\t        if scroll.abs() > 0.1 {\n619\t            self.pad_events.push(egui::Event::MouseWheel {\n620\t                unit: egui::MouseWheelUnit::Point,\n621\t                phase: egui::TouchPhase::Move,\n622\t                delta: egui::vec2(0.0, scroll * 900.0 * dt),\n623\t                modifiers: Default::default(),\n624\t            });\n625\t        }\n626\t        self.pad_cursor = Some(p);\n627\t        // Menus have the pad: nothing reaches the game.\n628\t        let pad = &mut self.input.pad;\n629\t        pad.left = Vec2::ZERO;\n630\t        pad.right = Vec2::ZERO;\n631\t        pad.held = 0;\n632\t        pad.zoom = 0.0;\n633\t        pad.rotate = 0.0;\n634\t    }\n635\t\n636\t    fn toast(&mut self, msg: impl Into<String>) {\n637\t        let m = msg.into();\n638\t        log::info!(\"{m}\");\n639\t        self.toast = Some((m, Instant::now()));\n640\t    }\n641\t\n642\t    fn load_scene(&mut self, name: &str) {\n643\t        let Some(host) = &self.host else { return };\n644\t        let (scene, seed) = (name.to_string(), self.settings.seed);\n645\t        let cfg = self.sim_config.clone();\n646\t        host.exec(move |sim| {\n647\t            // Keep the hero: save, build the scene, put them back in.\n648\t            crate::save::save_from(sim);\n649\t            match Sim::new(&scene, seed) {\n650\t                Ok(mut fresh) => {\n651\t                    fresh.config = cfg;\n652\t                    crate::save::restore_into(&mut fresh);\n653\t                    *sim = fresh;\n654\t                }\n655\t                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n656\t            }\n657\t        });\n658\t        self.scene_name = name.to_string();\n659\t        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n660\t        self.toast(format!(\"loaded {}\", self.scene_name));\n661\t    }\n662\t\n663\t    /// Resets the whole scene (menu).\n664\t    fn reset(&mut self) {\n665\t        if let Some(host) = &self.host {\n666\t            let cfg = self.sim_config.clone();\n667\t            host.exec(move |sim| {\n668\t                sim.config = cfg;\n669\t                crate::save::save_from(sim);\n670\t                if let Err(e) = sim.reset() {\n671\t                    log::error!(\"reset failed: {e:#}\");\n672\t                }\n673\t                crate::save::restore_into(sim);\n674\t            });\n675\t        }\n676\t        self.toast(\"scene reset\");\n677\t    }\n678\t\n679\t    /// Resets the room the player is in (F5).\n680\t    fn reset_room(&mut self) {\n681\t        let Some(host) = &self.host else { return };\n682\t        match &self.hud.current {\n683\t            Some(r) => {\n684\t                let id = r.id;\n685\t                host.exec(move |sim| sim.reset_room(id));\n686\t                let name = r.def.name.clone();\n687\t                self.toast(format!(\"reset {name}\"));\n688\t            }\n689\t            None => self.toast(\"Not in a room (Esc, Reset scene resets everything)\"),\n690\t        }\n691\t    }\n692\t\n693\t    fn teleport(&mut self, t: TeleportTarget) {\n694\t        let Some(host) = &self.host else { return };\n695\t        self.arrival = Some(Instant::now());\n696\t        let msg = match t {\n697\t            TeleportTarget::Room(key) => {\n698\t                let k = key.clone();\n699\t                let ok = host.query(move |sim| sim.teleport_to_room(&k)).unwrap_or(false);\n700\t                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"c326616f-704b-4c16-bbc7-45b775f0a393","timestamp":"2026-11-05T13:31:53.429Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/app.rs","content":"//! The game window: owns graphics, UI, input, the simulation thread and the camera.\n\nuse std::sync::Arc;\n\nuse web_time::Instant;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Mat4, Quat, Vec2, Vec3};\nuse pav_core::params::{ParamVisitor, Tunable, nested};\nuse pav_core::prop_preview::StudioMode;\nuse pav_core::{InputFrame, Sim, SimConfig};\nuse pav_render::gpu::BackendChoice;\nuse pav_render::scene::{MeshInstance, MeshKey, Style, flags as rflags};\nuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\nuse winit::application::ApplicationHandler;\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::{ActiveEventLoop, ControlFlow, EventLoop};\nuse winit::keyboard::{KeyCode, PhysicalKey};\nuse winit::window::{Fullscreen, Window, WindowId};\n\nuse crate::boot::{self, stage};\nuse crate::edit::Editor;\nuse crate::gfx::Gfx;\nuse crate::hud::{CameraDirector, FeelOverlay, FeelSettings, HudCtx, Latency, LatencySample, PhysicsOverlay};\nuse crate::input::{Device, Input};\nuse crate::panel::{Panel, PanelAction};\nuse crate::rooms::{RoomEntry, RoomHud, RoomWatcher, TeleportTarget};\nuse crate::settings::Settings;\nuse crate::simhost::SimHost;\nuse crate::ui::{self, MenuAction};\nuse crate::uiinput::UiInput;\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn run(settings: Settings) -> Result<()> {\n    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n    event_loop.set_control_flow(ControlFlow::Poll);\n    let mut app = App::new(settings);\n    event_loop.run_app(&mut app)?;\n    match app.fatal.take() {\n        Some(e) => Err(anyhow!(e)),\n        None => Ok(()),\n    }\n}\n\n/// In the browser the event loop runs from the page's animation frames; this returns at once.\n#[cfg(target_arch = \"wasm32\")]\npub fn run(settings: Settings) -> Result<()> {\n    use winit::platform::web::EventLoopExtWebSys;\n    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n    event_loop.set_control_flow(ControlFlow::Poll);\n    event_loop.spawn_app(App::new(settings));\n    Ok(())\n}\n\n/// App-level tunables (the \"app\" group in the panel).\n#[derive(Clone, Debug, PartialEq)]\npub struct AppSettings {\n    pub vsync: bool,\n    pub smoothing: bool,\n    pub show_stats: bool,\n    pub show_guide: bool,\n    pub aim_marker: bool,\n}\n\nimpl Tunable for AppSettings {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.bool(\"vsync\", &mut self.vsync, \"Wait for the display refresh (off = lowest latency, may tear)\");\n        v.bool(\"smoothing\", &mut self.smoothing, \"Interpolate between simulation ticks\");\n        v.bool(\"show_stats\", &mut self.show_stats, \"FPS / tick overlay\");\n        v.bool(\"show_guide\", &mut self.show_guide, \"Control guide overlay\");\n        v.bool(\"aim_marker\", &mut self.aim_marker, \"Show where bombs will land\");\n    }\n}\n\n/// Sound settings (the \"audio\" group).\n#[derive(Clone, Debug, PartialEq)]\npub struct AudioSettings {\n    pub master: f32,\n    pub sfx: f32,\n    pub footsteps: bool,\n}\n\nimpl Tunable for AudioSettings {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"master\", &mut self.master, 0.0, 2.0, \"Master volume\");\n        v.float(\"sfx\", &mut self.sfx, 0.0, 2.0, \"Sound effects volume\");\n        v.bool(\"footsteps\", &mut self.footsteps, \"Footstep sounds\");\n    }\n}\n\nstruct Root<'a> {\n    sim: &'a mut SimConfig,\n    camera: &'a mut CameraParams,\n    view: &'a mut ViewSettings,\n    app: &'a mut AppSettings,\n    audio: &'a mut AudioSettings,\n}\n\nimpl Tunable for Root<'_> {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        self.sim.visit_groups(v);\n        nested(v, \"camera\", self.camera);\n        nested(v, \"view\", self.view);\n        nested(v, \"audio\", self.audio);\n        nested(v, \"app\", self.app);\n    }\n}\n\n#[derive(Default)]\nstruct Mouse {\n    right_down: bool,\n    pos: Vec2,\n}\n\nstruct Fps {\n    frames: u32,\n    since: Instant,\n    fps: f32,\n    frame_ms: f32,\n}\n\npub struct App {\n    settings: Settings,\n    gfx: Option<Gfx>,\n    egui_ctx: egui::Context,\n    egui_state: Option<UiInput>,\n    host: Option<SimHost>,\n    rig: CameraRig,\n    view: ViewSettings,\n    /// View settings before the room's `[view]` table and pad overrides were applied, and\n    /// which room / pad state they belong to.\n    view_base: Option<ViewSettings>,\n    view_key: (Option<u16>, u64),\n    sim_config: SimConfig,\n    app_settings: AppSettings,\n    builder: ViewBuilder,\n    input: Input,\n    panel: Panel,\n    menu_open: bool,\n    paused_before_menu: bool,\n    show_boot: bool,\n    boot_done_at: Option<Instant>,\n    started: Instant,\n    last: Instant,\n    fps: Fps,\n    mouse: Mouse,\n    screenshot_requested: bool,\n    scene_name: String,\n    toast: Option<(String, Instant)>,\n    hud: RoomHud,\n    watcher: Option<RoomWatcher>,\n    editor: Editor,\n    audio: Option<pav_audio::AudioOut>,\n    audio_settings: AudioSettings,\n    /// Tick at which the app last pushed its config (the sim's copy is adopted after that).\n    config_push_tick: u64,\n    latency: Latency,\n    director: CameraDirector,\n    feel: FeelOverlay,\n    physics: PhysicsOverlay,\n    quit: bool,\n    /// Camera and look from before the game started (restored when leaving it).\n    game_saved: Option<(CameraParams, ViewSettings)>,\n    /// The Look & Filters window and the look layer over `view`.\n    look_ui: crate::look_ui::LookUi,\n    animation_ui: crate::animation_ui::AnimationUi,\n    studio_mode: StudioMode,\n    studio_navigation: bool,\n    asset_ui: crate::asset_ui::AssetUi,\n    asset_watcher: crate::asset_watch::AssetWatcher,\n    creature_ui: crate::creature_ui::CreatureUi,\n    creature_watcher: crate::creature_watch::CreatureWatcher,\n    animation_watcher: Option<crate::animation_watch::AnimationWatcher>,\n    animation_watch_attempted: bool,\n    /// Station guide (H) and field guide.\n    guide: crate::guide_ui::GuideUi,\n    /// When the player last arrived somewhere new (another place, a teleport): the screen\n    /// transition opens from then.\n    arrival: Option<Instant>,\n    /// Shardfall windows (inventory, vendor...), the latest game frame and the place whose\n    /// look is applied.\n    game_ui: crate::arpg_items::GameUi,\n    /// When the hero was last saved.\n    last_save: Instant,\n    /// The gamepad's menu cursor (egui points) and the pointer events it makes this frame.\n    pad_cursor: Option<Vec2>,\n    pad_events: Vec<egui::Event>,\n    pad_buttons: (bool, bool, bool),\n    game_frame: Option<std::sync::Arc<pav_core::arpg::GameFrame>>,\n    game_place: Option<pav_core::arpg::Place>,\n    /// Phones and tablets: fingers, the on-screen controls and swipes (touch.rs).\n    touch: crate::touch::Touch,\n    /// The browser says this is a touch screen (or a finger has touched it).\n    touch_screen: bool,\n    /// The egui style has the touch sizes.\n    touch_styled: bool,\n    /// Touch screens draw at most 60 frames a second: when the next one is due.\n    next_draw: Instant,\n    /// Auto-attack, graphics quality, tips seen (saved).\n    prefs: crate::save::Prefs,\n    scaler: crate::quality::Scaler,\n    #[cfg(not(target_arch = \"wasm32\"))]\n    bridge: Option<crate::bridge::Bridge>,\n    #[cfg(target_arch = \"wasm32\")]\n    pending_gfx: Option<std::rc::Rc<std::cell::RefCell<Option<Result<Gfx>>>>>,\n    #[cfg(target_arch = \"wasm32\")]\n    audio_resumed: bool,\n    init_started: bool,\n    pub fatal: Option<String>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();\n        let touch_screen = crate::platform::touch_screen();\n        let mut app = Self {\n            gfx: None,\n            egui_ctx: egui::Context::default(),\n            egui_state: None,\n            host: None,\n            rig: CameraRig::default(),\n            view: ViewSettings::default(),\n            view_base: None,\n            view_key: (None, 0),\n            sim_config: SimConfig::default(),\n            app_settings: AppSettings {\n                vsync: settings.vsync,\n                smoothing: true,\n                show_stats: true,\n                show_guide: true,\n                aim_marker: true,\n            },\n            builder: ViewBuilder::new(),\n            input: Input::new(),\n            panel: Panel::new(),\n            menu_open: false,\n            paused_before_menu: false,\n            show_boot: true,\n            boot_done_at: None,\n            started: Instant::now(),\n            last: Instant::now(),\n            fps: Fps { frames: 0, since: Instant::now(), fps: 0.0, frame_ms: 0.0 },\n            mouse: Mouse::default(),\n            screenshot_requested: false,\n            scene_name,\n            toast: None,\n            hud: RoomHud::default(),\n            watcher: None,\n            editor: Editor::default(),\n            audio: None,\n            audio_settings: AudioSettings { master: 0.8, sfx: 1.0, footsteps: true },\n            config_push_tick: 0,\n            latency: Latency::default(),\n            director: CameraDirector::default(),\n            feel: FeelOverlay::default(),\n            physics: PhysicsOverlay::default(),\n            quit: false,\n            game_saved: None,\n            look_ui: crate::look_ui::LookUi::load(),\n            animation_ui: crate::animation_ui::AnimationUi::new(settings.animation_studio),\n            studio_mode: StudioMode::World,\n            studio_navigation: settings.animation_studio || settings.asset_studio || settings.creature_studio,\n            asset_ui: crate::asset_ui::AssetUi::new(settings.asset_studio),\n            asset_watcher: crate::asset_watch::AssetWatcher::new(),\n            creature_ui: crate::creature_ui::CreatureUi::new(settings.creature_studio),\n            creature_watcher: crate::creature_watch::CreatureWatcher::new(),\n            animation_watcher: None,\n            animation_watch_attempted: false,\n            guide: Default::default(),\n            arrival: None,\n            game_ui: Default::default(),\n            last_save: Instant::now(),\n            pad_cursor: None,\n            pad_events: Vec::new(),\n            pad_buttons: (false, false, false),\n            game_frame: None,\n            game_place: None,\n            touch: Default::default(),\n            touch_screen,\n            touch_styled: false,\n            next_draw: Instant::now(),\n            prefs: crate::save::load_prefs(),\n            scaler: Default::default(),\n            #[cfg(not(target_arch = \"wasm32\"))]\n            bridge: None,\n            #[cfg(target_arch = \"wasm32\")]\n            pending_gfx: None,\n            #[cfg(target_arch = \"wasm32\")]\n            audio_resumed: false,\n            init_started: false,\n            fatal: None,\n            settings,\n        };\n        if touch_screen {\n            // Phones: touch controls from the start, none of the desktop's diagnostics.\n            app.input.last_device = Device::Touch;\n            app.show_boot = false;\n            app.app_settings.show_stats = false;\n        }\n        app\n    }\n\n    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n    /// swipe or egui's (and then egui gets the event).\n    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n        #[cfg(target_arch = \"wasm32\")]\n        self.resume_audio();\n        let Some(g) = &self.gfx else { return };\n        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n        self.input.last_device = Device::Touch;\n        self.touch_screen = true;\n        use winit::event::TouchPhase as P;\n        let to_egui = match t.phase {\n            P::Started => {\n                // (The root layer is everywhere; only windows and labels over the game count.)\n                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n                self.touch.down(t.id, pos, under)\n            }\n            P::Moved => self.touch.moved(t.id, pos),\n            P::Ended => self.touch.up(t.id, pos, false),\n            P::Cancelled => self.touch.up(t.id, pos, true),\n        };\n        if to_egui {\n            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n                st.on_window_event(&g.window, event);\n            }\n        }\n    }\n\n    /// A tap on the open game closes what is open over it, one thing at a time.\n    fn close_on_tap(&mut self) {\n        if self.menu_open {\n            self.set_menu(false);\n        } else if self.game_ui.any_open() {\n            self.game_ui.close_all();\n        } else if self.game_ui.map {\n            self.game_ui.map = false;\n        } else if self.look_ui.open {\n            self.look_ui.open = false;\n            self.look_ui.save_if_dirty(true);\n        } else if self.guide.station || self.guide.field {\n            self.guide.station = false;\n            self.guide.field = false;\n        } else if self.hud.teleport_open {\n            self.hud.teleport_open = false;\n        } else if self.hud.card_visible() {\n            self.hud.hide_card();\n        }\n    }\n\n    fn init(&mut self, el: &ActiveEventLoop) -> Result<()> {\n        let s = self.settings.clone();\n        let window = stage(\"window\", || {\n            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                attrs = attrs.with_inner_size(winit::dpi::LogicalSize::new(s.width, s.height));\n            }\n            // In the browser the window is a canvas filling the page (sized by the page's CSS).\n            #[cfg(target_arch = \"wasm32\")]\n            {\n                use winit::platform::web::WindowAttributesExtWebSys;\n                attrs = attrs.with_append(true);\n            }\n            if s.fullscreen {\n                attrs = attrs.with_fullscreen(Some(Fullscreen::Borderless(None)));\n            }\n            let w = Arc::new(el.create_window(attrs)?);\n            let sz = w.inner_size();\n            let d = format!(\"{}x{} px, scale {:.2}\", sz.width, sz.height, w.scale_factor());\n            Ok((w, d))\n        })?;\n        let backend = BackendChoice::parse(&s.backend)\n            .ok_or_else(|| anyhow!(\"unknown backend '{}' in settings (use vulkan or dx12)\", s.backend))?;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        {\n            let gfx = Gfx::new(window, backend, s.vsync)?;\n            self.finish_init(gfx)\n        }\n        // The browser hands out the GPU asynchronously: `about_to_wait` finishes the start.\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            let slot = std::rc::Rc::new(std::cell::RefCell::new(None));\n            let fill = slot.clone();\n            wasm_bindgen_futures::spawn_local(async move {\n                *fill.borrow_mut() = Some(Gfx::create(window, backend, s.vsync).await);\n            });\n            self.pending_gfx = Some(slot);\n            Ok(())\n        }\n    }\n\n    /// The rest of the start, once graphics exist.\n    fn finish_init(&mut self, gfx: Gfx) -> Result<()> {\n        let s = self.settings.clone();\n        let window = gfx.window.clone();\n        let egui_state = stage(\"ui\", || {\n            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n            Ok((st, String::new()))\n        })?;\n        self.audio = stage(\"audio\", || match pav_audio::AudioOut::start() {\n            Ok(a) => {\n                let d = format!(\"{} @ {} Hz\", a.device, a.sample_rate);\n                Ok((Some(a), d))\n            }\n            Err(e) => Ok((None, format!(\"no sound ({e}); continuing silently\"))),\n        })?;\n        // Rooms can name saved objects. Load the library before constructing the scene, and\n        // the workshop materials before the objects that wear them.\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::material_tools::initialize_authored() {\n            self.asset_ui.report(Err(format!(\"Could not load saved materials: {error:#}\")));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::asset_tools::initialize_authored() {\n            self.asset_ui.report(Err(format!(\"Could not load saved objects: {error:#}\")));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n        }\n        let mut sim = stage(\"simulation\", || {\n            let mut sim = Sim::new(&s.scene, s.seed)?;\n            let mut d = format!(\n                \"scene '{}', seed {}, {} entities, {} blocks\",\n                s.scene,\n                s.seed,\n                sim.state.entities.len(),\n                sim.state.statics.block_count()\n            );\n            if let Some(level) = crate::save::restore_into(&mut sim) {\n                d += &format!(\", saved hero (level {level})\");\n            }\n            Ok((sim, d))\n        })?;\n        if s.animation_studio {\n            // Read authored sets before selecting a clip. Keep the embedded library if a\n            // file is invalid, so the studio can still open and report the error.\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                let _ = pav_core::clips::library();\n                if pav_core::anim::disk_dir().is_some() {\n                    if let Err(e) = pav_core::anim::reload(true) {\n                        self.animation_ui.report(Err(e));\n                    }\n                }\n                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n                }\n            }\n            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.asset_studio {\n            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.creature_studio {\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n            if !s.creature_name.is_empty() {\n                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n            }\n            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n                .map(|output| match output {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|error| format!(\"{error:#}\"));\n            self.creature_ui.report(result);\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        self.sim_config = sim.config.clone();\n        self.rig.snap(sim.frame().focus);\n        self.hud.entries = room_entries(&sim);\n        self.hud.errors = sim.state.world.errors.clone();\n        self.watcher = RoomWatcher::start();\n        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n        if self.animation_watch_attempted {\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.pad_script.is_empty() {\n            match std::fs::read_to_string(&s.pad_script)\n                .map_err(|e| e.to_string())\n                .and_then(|t| crate::input::PadScript::parse(&t))\n            {\n                Ok(p) => {\n                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n                    self.input.pad_script = Some(p);\n                }\n                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.bridge.is_empty() {\n            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n                Ok(b) => {\n                    let d = format!(\"listening on {}\", b.addr);\n                    Ok((Some(b), d))\n                }\n                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n            })?;\n        }\n        self.host = Some(SimHost::start(sim));\n        self.gfx = Some(gfx);\n        self.egui_state = Some(egui_state);\n        Ok(())\n    }\n\n    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n    fn pad_ui_active(&self) -> bool {\n        self.input.last_device == Device::Gamepad\n            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n    }\n\n    /// Gamepad in menus: D-pad down opens the hero's panels (LB / RB switch them), B closes;\n    /// while a window is open the left stick (or D-pad) moves a cursor, A and X click left and\n    /// right, the right stick scrolls, and the game gets no pad input.\n    fn pad_menus(&mut self, dt: f32) {\n        use gilrs::Button as B;\n        let taps = std::mem::take(&mut self.input.pad.taps);\n        let game = self.game_frame.is_some();\n        if self.input.last_device != Device::Gamepad {\n            self.pad_cursor = None;\n            return;\n        }\n        let ui = &mut self.game_ui;\n        if game && !self.menu_open && taps.contains(&B::DPadDown) && !ui.any_open() {\n            ui.inventory = true;\n            return;\n        }\n        if !self.pad_ui_active() {\n            self.pad_cursor = None;\n            if self.pad_buttons.2 {\n                self.pad_events.push(egui::Event::ModifiersChanged(Default::default()));\n            }\n            self.pad_buttons = (false, false, false);\n            return;\n        }\n        let ui = &mut self.game_ui;\n        // Switch between the hero's panels.\n        let cycle = taps.contains(&B::RightTrigger) as i32 - taps.contains(&B::LeftTrigger) as i32;\n        if cycle != 0 && game && !self.menu_open {\n            let now = [ui.inventory, ui.character, ui.skills, ui.tree.open].iter().position(|x| *x).unwrap_or(0) as i32;\n            let next = (now + cycle).rem_euclid(4);\n            ui.inventory = next == 0;\n            ui.character = next == 1;\n            ui.skills = next == 2;\n            ui.tree.open = next == 3;\n        }\n        if taps.contains(&B::East) {\n            if ui.any_open() {\n                ui.close_all();\n            } else if self.look_ui.open && !self.menu_open {\n                self.look_ui.open = false;\n                self.look_ui.save_if_dirty(true);\n            } else if (self.guide.station || self.guide.field) && !self.menu_open {\n                self.guide.station = false;\n                self.guide.field = false;\n            } else {\n                self.set_menu(false);\n            }\n        }\n        // The cursor.\n        let screen = self.egui_ctx.content_rect();\n        let mut p = self.pad_cursor.unwrap_or(Vec2::new(screen.center().x, screen.center().y));\n        let stick = self.input.pad.left;\n        let speed = 260.0 + 900.0 * stick.length().powi(2);\n        p += Vec2::new(stick.x, -stick.y) * speed * dt;\n        for (b, d) in [(B::DPadLeft, Vec2::NEG_X), (B::DPadRight, Vec2::X), (B::DPadUp, Vec2::NEG_Y), (B::DPadDown, Vec2::Y)] {\n            if taps.contains(&b) {\n                p += d * 40.0;\n            }\n        }\n        p = p.clamp(Vec2::new(screen.min.x, screen.min.y), Vec2::new(screen.max.x - 2.0, screen.max.y - 2.0));\n        let pos = egui::pos2(p.x, p.y);\n        self.pad_events.push(egui::Event::PointerMoved(pos));\n        let (a, x) = (self.input.pad.a_held, self.input.pad.x_held);\n        let modifiers = egui::Modifiers { shift: self.input.pad.y_held, ..Default::default() };\n        if self.input.pad.y_held != self.pad_buttons.2 {\n            self.pad_events.push(egui::Event::ModifiersChanged(modifiers));\n        }\n        for (now, was, button) in\n            [(a, self.pad_buttons.0, egui::PointerButton::Primary), (x, self.pad_buttons.1, egui::PointerButton::Secondary)]\n        {\n            if now != was {\n                self.pad_events.push(egui::Event::PointerButton { pos, button, pressed: now, modifiers });\n            }\n        }\n        self.pad_buttons = (a, x, self.input.pad.y_held);\n        let scroll = self.input.pad.right.y;\n        if scroll.abs() > 0.1 {\n            self.pad_events.push(egui::Event::MouseWheel {\n                unit: egui::MouseWheelUnit::Point,\n                phase: egui::TouchPhase::Move,\n                delta: egui::vec2(0.0, scroll * 900.0 * dt),\n                modifiers: Default::default(),\n            });\n        }\n        self.pad_cursor = Some(p);\n        // Menus have the pad: nothing reaches the game.\n        let pad = &mut self.input.pad;\n        pad.left = Vec2::ZERO;\n        pad.right = Vec2::ZERO;\n        pad.held = 0;\n        pad.zoom = 0.0;\n        pad.rotate = 0.0;\n    }\n\n    fn toast(&mut self, msg: impl Into<String>) {\n        let m = msg.into();\n        log::info!(\"{m}\");\n        self.toast = Some((m, Instant::now()));\n    }\n\n    fn load_scene(&mut self, name: &str) {\n        let Some(host) = &self.host else { return };\n        let (scene, seed) = (name.to_string(), self.settings.seed);\n        let cfg = self.sim_config.clone();\n        host.exec(move |sim| {\n            // Keep the hero: save, build the scene, put them back in.\n            crate::save::save_from(sim);\n            match Sim::new(&scene, seed) {\n                Ok(mut fresh) => {\n                    fresh.config = cfg;\n                    crate::save::restore_into(&mut fresh);\n                    *sim = fresh;\n                }\n                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n            }\n        });\n        self.scene_name = name.to_string();\n        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n        self.toast(format!(\"loaded {}\", self.scene_name));\n    }\n\n    /// Resets the whole scene (menu).\n    fn reset(&mut self) {\n        if let Some(host) = &self.host {\n            let cfg = self.sim_config.clone();\n            host.exec(move |sim| {\n                sim.config = cfg;\n                crate::save::save_from(sim);\n                if let Err(e) = sim.reset() {\n                    log::error!(\"reset failed: {e:#}\");\n                }\n                crate::save::restore_into(sim);\n            });\n        }\n        self.toast(\"scene reset\");\n    }\n\n    /// Resets the room the player is in (F5).\n    fn reset_room(&mut self) {\n        let Some(host) = &self.host else { return };\n        match &self.hud.current {\n            Some(r) => {\n                let id = r.id;\n                host.exec(move |sim| sim.reset_room(id));\n                let name = r.def.name.clone();\n                self.toast(format!(\"reset {name}\"));\n            }\n            None => self.toast(\"Not in a room (Esc, Reset scene resets everything)\"),\n        }\n    }\n\n    fn teleport(&mut self, t: TeleportTarget) {\n        let Some(host) = &self.host else { return };\n        self.arrival = Some(Instant::now());\n        let msg = match t {\n            TeleportTarget::Room(key) => {\n                let k = key.clone();\n                let ok = host.query(move |sim| sim.teleport_to_room(&k)).unwrap_or(false);\n                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }","numLines":700,"startLine":1,"totalLines":2267}},"tool_result_meta":[{"id":"toolu_019ratbpkxxduuu589a2WnD5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjs74XpcuWXhWxybgqAu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VkeY1qDQDwHPVZ47HYvt6H","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/app.rs","offset":700,"limit":1570,"allow_large":true},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":32944,"cache_read_input_tokens":92434,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":32944},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"1af2b3ad-9e45-4a1c-9053-5e7c3bfbd5a0","timestamp":"2026-11-05T13:31:57.157Z","request_id":"req_011Cgjs74EDK2yA1Cq8sfruD","wire_tool_inputs":{"toolu_01VkeY1qDQDwHPVZ47HYvt6H":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/app.rs","offset":700,"limit":1570,"allow_large":true}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VkeY1qDQDwHPVZ47HYvt6H","type":"tool_result","content":"700\t                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }\n701\t            }\n702\t            TeleportTarget::Hub => {\n703\t                host.exec(|sim| {\n704\t                    if let Some(pid) = sim.state.player {\n705\t                        sim.set_position(pid, Vec3::new(0.0, 0.0, 6.0));\n706\t                    }\n707\t                });\n708\t                \"went to the plaza\".into()\n709\t            }\n710\t            TeleportTarget::Wilderness => {\n711\t                let a = self.started.elapsed().as_secs_f32() * 7.3;\n712\t                let p = Vec3::new(a.cos(), 0.0, a.sin()) * 220.0 + Vec3::Y * 25.0;\n713\t                host.exec(move |sim| {\n714\t                    sim.state.world.interest.push(p);\n715\t                    sim.update_streaming(usize::MAX);\n716\t                    sim.state.world.interest.pop();\n717\t                    if let Some(pid) = sim.state.player {\n718\t                        sim.set_position(pid, p);\n719\t                    }\n720\t                });\n721\t                \"went to the wilderness\".into()\n722\t            }\n723\t        };\n724\t        self.toast(msg);\n725\t    }\n726\t\n727\t    fn open_teleport(&mut self) {\n728\t        if let Some(host) = &self.host {\n729\t            if let Some(e) = host.query(|sim| room_entries(sim)) {\n730\t                self.hud.entries = e;\n731\t            }\n732\t        }\n733\t        self.hud.teleport_open = true;\n734\t    }\n735\t\n736\t    /// Hot reload: re-read room files and rebuild what changed.\n737\t    fn reload_rooms(&mut self) {\n738\t        let Some(host) = &self.host else { return };\n739\t        let dir = self.watcher.as_ref().map(|w| w.dir.clone());\n740\t        let sources = pav_core::room::load_sources(dir.as_deref());\n741\t        let (defs, errors) = pav_core::room::parse_all(&sources);\n742\t        self.hud.errors = errors.iter().map(|(k, e)| format!(\"{k}: {e}\")).collect();\n743\t        for e in &self.hud.errors {\n744\t            log::error!(\"room file: {e}\");\n745\t        }\n746\t        let bad: Vec<String> = errors.into_iter().map(|(k, _)| k).collect();\n747\t        let changed = host\n748\t            .query(move |sim| {\n749\t                // Rooms whose file is broken keep their current definition.\n750\t                let mut defs = defs;\n751\t                for k in &bad {\n752\t                    if let Some(r) = sim.state.world.room(k) {\n753\t                        defs.push((k.clone(), (*r.def).clone()));\n754\t                    }\n755\t                }\n756\t                pav_tools::tools::reload_rooms(sim, defs)\n757\t            })\n758\t            .unwrap_or(0);\n759\t        if self.hud.errors.is_empty() {\n760\t            self.toast(format!(\"rooms reloaded ({changed} changed)\"));\n761\t        }\n762\t    }\n763\t\n764\t    fn set_menu(&mut self, open: bool) {\n765\t        let Some(host) = &self.host else { return };\n766\t        if open && !self.menu_open {\n767\t            self.paused_before_menu = host.control().paused;\n768\t            host.set_control(|c| c.paused = true);\n769\t        } else if !open && self.menu_open {\n770\t            let p = self.paused_before_menu;\n771\t            host.set_control(|c| c.paused = p);\n772\t        }\n773\t        self.menu_open = open;\n774\t        self.input.clear();\n775\t    }\n776\t\n777\t    /// The fixed system layer: never rebinds, works in every room.\n778\t    fn handle_key(&mut self, code: KeyCode) {\n779\t        let Some(host) = &self.host else { return };\n780\t        if self.studio_mode == StudioMode::Animation {\n781\t            if let Some(p) = host.frames().1.animation_preview.as_ref() {\n782\t                let args = match code {\n783\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n784\t                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n785\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n786\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n787\t                    _ => None,\n788\t                };\n789\t                if let Some(args) = args {\n790\t                    self.studio_command(crate::animation_ui::Command {\n791\t                        tool: \"anim_preview\",\n792\t                        args: args.as_object().unwrap().clone(),\n793\t                    });\n794\t                    return;\n795\t                }\n796\t            }\n797\t        }\n798\t        if self.studio_mode == StudioMode::Prop {\n799\t            if let Some(p) = host.frames().1.prop_preview.as_ref() {\n800\t                let args = match code {\n801\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n802\t                    KeyCode::F7 => Some(serde_json::json!({\"playing\": false, \"time\": p.time + 1.0 / 60.0})),\n803\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n804\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n805\t                    _ => None,\n806\t                };\n807\t                if let Some(args) = args {\n808\t                    self.studio_command(crate::animation_ui::Command {\n809\t                        tool: \"asset_preview\",\n810\t                        args: args.as_object().unwrap().clone(),\n811\t                    });\n812\t                    return;\n813\t                }\n814\t            }\n815\t        }\n816\t        if self.studio_mode == StudioMode::Creature {\n817\t            if let Some(p) = host.frames().1.creature_preview.as_ref() {\n818\t                let args = match code {\n819\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n820\t                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n821\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n822\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n823\t                    _ => None,\n824\t                };\n825\t                if let Some(args) = args {\n826\t                    self.studio_command(crate::animation_ui::Command {\n827\t                        tool: \"creature_preview\",\n828\t                        args: args.as_object().unwrap().clone(),\n829\t                    });\n830\t                    return;\n831\t                }\n832\t            }\n833\t        }\n834\t        // Shardfall's menu keys.\n835\t        if self.input.game && !self.menu_open && self.studio_mode == StudioMode::World {\n836\t            let ui = &mut self.game_ui;\n837\t            match code {\n838\t                KeyCode::KeyI | KeyCode::Tab => {\n839\t                    ui.inventory = !ui.inventory;\n840\t                    return;\n841\t                }\n842\t                KeyCode::KeyC => {\n843\t                    ui.character = !ui.character;\n844\t                    return;\n845\t                }\n846\t                KeyCode::KeyK => {\n847\t                    ui.skills = !ui.skills;\n848\t                    return;\n849\t                }\n850\t                KeyCode::KeyP => {\n851\t                    ui.tree.open = !ui.tree.open;\n852\t                    return;\n853\t                }\n854\t                KeyCode::KeyM => {\n855\t                    ui.map = !ui.map;\n856\t                    return;\n857\t                }\n858\t                KeyCode::KeyT => {\n859\t                    // Town portal: home from anywhere.\n860\t                    if self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town) {\n861\t                        host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n862\t                    }\n863\t                    return;\n864\t                }\n865\t                KeyCode::Escape if ui.any_open() => {\n866\t                    ui.close_all();\n867\t                    return;\n868\t                }\n869\t                _ => {}\n870\t            }\n871\t        }\n872\t        match code {\n873\t            KeyCode::Escape => {\n874\t                let open = !self.menu_open;\n875\t                self.set_menu(open);\n876\t            }\n877\t            KeyCode::F1 => self.panel.open = !self.panel.open,\n878\t            // How the room you are in works (outside the rooms: the field guide).\n879\t            KeyCode::KeyH if !self.input.game => {\n880\t                if self.hud.current.is_some() {\n881\t                    self.guide.station = !self.guide.station;\n882\t                } else {\n883\t                    self.guide.field = !self.guide.field;\n884\t                }\n885\t            }\n886\t            KeyCode::F2 => {\n887\t                if self.hud.teleport_open {\n888\t                    self.hud.teleport_open = false;\n889\t                } else {\n890\t                    self.open_teleport();\n891\t                }\n892\t            }\n893\t            KeyCode::F3 => self.show_boot = !self.show_boot,\n894\t            KeyCode::F4 => {\n895\t                host.exec(|sim| {\n896\t                    sim.leave_room();\n897\t                });\n898\t                self.toast(\"left the room\");\n899\t            }\n900\t            KeyCode::F5 => self.reset_room(),\n901\t            KeyCode::F6 => host.set_control(|c| c.paused = !c.paused),\n902\t            KeyCode::F7 => host.set_control(|c| {\n903\t                c.paused = true;\n904\t                c.step_requests += 1;\n905\t            }),\n906\t            KeyCode::F8 => host.set_control(|c| c.speed = (c.speed * 0.5).max(0.0625)),\n907\t            KeyCode::F9 => host.set_control(|c| c.speed = (c.speed * 2.0).min(8.0)),\n908\t            KeyCode::F10 if self.studio_mode == StudioMode::World => {\n909\t                self.editor.on = !self.editor.on;\n910\t                self.editor.dragging = None;\n911\t                let on = self.editor.on;\n912\t                self.toast(if on { \"edit mode on\" } else { \"edit mode off\" });\n913\t            }\n914\t            KeyCode::F11 => {\n915\t                if let Some(g) = &self.gfx {\n916\t                    let fs = g.window.fullscreen().is_some();\n917\t                    g.window.set_fullscreen(if fs { None } else { Some(Fullscreen::Borderless(None)) });\n918\t                }\n919\t            }\n920\t            KeyCode::F12 => self.screenshot_requested = true,\n921\t            _ => {\n922\t                let digits = [\n923\t                    KeyCode::Digit1,\n924\t                    KeyCode::Digit2,\n925\t                    KeyCode::Digit3,\n926\t                    KeyCode::Digit4,\n927\t                    KeyCode::Digit5,\n928\t                    KeyCode::Digit6,\n929\t                    KeyCode::Digit7,\n930\t                    KeyCode::Digit8,\n931\t                ];\n932\t                // (In Shardfall the number keys are potions and belt items.)\n933\t                let digit =\n934\t                    digits.iter().position(|k| *k == code).filter(|i| *i < CameraParams::PRESETS.len() && !self.input.game);\n935\t                if let Some(i) = digit {\n936\t                    let yaw = self.rig.params.yaw;\n937\t                    self.rig.params = (CameraParams::PRESETS[i].1)();\n938\t                    if CameraParams::PRESETS[i].0 != \"isometric\" {\n939\t                        self.rig.params.yaw = yaw;\n940\t                    }\n941\t                    self.toast(format!(\"camera: {}\", CameraParams::PRESETS[i].0));\n942\t                }\n943\t            }\n944\t        }\n945\t    }\n946\t\n947\t    fn frame(&mut self) {\n948\t        if self.gfx.is_none() || self.host.is_none() {\n949\t            return;\n950\t        }\n951\t        // Touch screens draw at most 60 frames a second (a phone with a faster screen would\n952\t        // spend battery and heat on the rest).\n953\t        if self.touch_screen {\n954\t            let now = Instant::now();\n955\t            let step = std::time::Duration::from_micros(16_667);\n956\t            if now + std::time::Duration::from_micros(2_500) < self.next_draw {\n957\t                return;\n958\t            }\n959\t            self.next_draw = if now > self.next_draw + step { now + step } else { self.next_draw + step };\n960\t        }\n961\t        let now = Instant::now();\n962\t        let dt = (now - self.last).as_secs_f32().min(0.1);\n963\t        self.last = now;\n964\t        self.fps.frames += 1;\n965\t        let since = self.fps.since.elapsed().as_secs_f32();\n966\t        if since >= 0.5 {\n967\t            self.fps.fps = self.fps.frames as f32 / since;\n968\t            self.fps.frame_ms = since * 1000.0 / self.fps.frames as f32;\n969\t            self.fps.frames = 0;\n970\t            self.fps.since = now;\n971\t        }\n972\t\n973\t        // Devices.\n974\t        self.input.poll_gamepad();\n975\t        if self.input.pad.start_pressed {\n976\t            let open = !self.menu_open;\n977\t            self.set_menu(open);\n978\t        }\n979\t        if self.input.pad.map_pressed {\n980\t            self.game_ui.map = !self.game_ui.map;\n981\t        }\n982\t        self.pad_menus(dt);\n983\t        let pad = self.input.last_device == Device::Gamepad;\n984\t        self.game_ui.pad = pad;\n985\t        self.game_ui.tree.pad = pad;\n986\t        self.rig.params.yaw = (self.rig.params.yaw + self.input.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n987\t        self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n988\t\n989\t        let host = self.host.as_ref().unwrap();\n990\t        host.pump();\n991\t        #[cfg(not(target_arch = \"wasm32\"))]\n992\t        if let Some(b) = &self.bridge {\n993\t            // Agent tools run on the simulation thread and can change the camera, view and look.\n994\t            if let Some(l) = b.poll(host, &mut self.rig, &mut self.view, self.look_ui.look()) {\n995\t                self.look_ui.set_look(l);\n996\t            }\n997\t        }\n998\t        let ui_wants_keys = self.egui_ctx.egui_wants_keyboard_input();\n999\t        let game_input = !self.menu_open && !ui_wants_keys;\n1000\t        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n1001\t        host.set_control(|c| c.rewinding = rewinding);\n1002\t\n1003\t        let (prev, curr, curr_at, tick_wall) = host.frames();\n1004\t        let studio_mode = curr.studio_mode();\n1005\t        let studio_active = curr.studio_active();\n1006\t        self.studio_navigation |= studio_active;\n1007\t        let snap_camera = studio_mode != self.studio_mode\n1008\t            || prev.studio_mode() != studio_mode\n1009\t            || prev.live_edit_ticket != curr.live_edit_ticket;\n1010\t        let game_input = game_input && !studio_active;\n1011\t        if studio_mode != self.studio_mode {\n1012\t            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n1013\t            let keep_creature_redo =\n1014\t                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n1015\t            self.builder = ViewBuilder::new();\n1016\t            if let Some(gfx) = &mut self.gfx {\n1017\t                gfx.renderer.clear_particles();\n1018\t            }\n1019\t            self.studio_mode = studio_mode;\n1020\t            self.animation_ui.open = studio_mode == StudioMode::Animation;\n1021\t            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n1022\t            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n1023\t        }\n1024\t        if !studio_active {\n1025\t            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n1026\t            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1027\t            self.director.update(&curr.hud, quarters, &mut self.rig);\n1028\t            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n1029\t            self.hud.update(&curr.room, &mut self.rig);\n1030\t            // Rooms and pads can change view settings (night lighting, bloom, filters).\n1031\t            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n1032\t            if key != self.view_key {\n1033\t                self.view_key = key;\n1034\t                if let Some(b) = self.view_base.take() {\n1035\t                    self.view = b;\n1036\t                }\n1037\t                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1038\t                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n1039\t                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n1040\t                if !room.is_empty() || !pads.is_empty() {\n1041\t                    self.view_base = Some(self.view.clone());\n1042\t                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n1043\t                        log::warn!(\"unknown view setting '{u}'\");\n1044\t                    }\n1045\t                }\n1046\t            }\n1047\t            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n1048\t                // Rooms can open HUD overlays (feel metrics) while you are inside.\n1049\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n1050\t                if wants && !self.feel.open {\n1051\t                    self.feel.open = true;\n1052\t                    self.feel.auto = true;\n1053\t                } else if !wants && self.feel.auto {\n1054\t                    self.feel.open = false;\n1055\t                    self.feel.auto = false;\n1056\t                }\n1057\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n1058\t                if wants && !self.physics.open {\n1059\t                    self.physics.open = true;\n1060\t                    self.physics.auto = true;\n1061\t                } else if !wants && self.physics.auto {\n1062\t                    self.physics.open = false;\n1063\t                    self.physics.auto = false;\n1064\t                }\n1065\t            }\n1066\t            self.feel.record(curr.tick, curr.hud.feel.speed);\n1067\t            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n1068\t                // Input switching: the room's key overrides apply while inside.\n1069\t                let (b, errs) = match &self.hud.current {\n1070\t                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n1071\t                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n1072\t                    None => (crate::input::Bindings::default(), Vec::new()),\n1073\t                };\n1074\t                self.input.bindings = b;\n1075\t                for e in errs {\n1076\t                    log::warn!(\"room keys: {e}\");\n1077\t                }\n1078\t            }\n1079\t            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n1080\t                // The simulation changed its configuration (room overrides): adopt it.\n1081\t                self.sim_config = (*curr.config).clone();\n1082\t            }\n1083\t            // Entering or leaving Shardfall: its controls, camera and look.\n1084\t            let game_mode = curr.game.is_some();\n1085\t            if game_mode != self.input.game {\n1086\t                self.input.game = game_mode;\n1087\t                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n1088\t                self.rig.blend_from_current(0.5);\n1089\t                if game_mode {\n1090\t                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n1091\t                    self.rig.params = CameraParams {\n1092\t                        tilt: 56.0,\n1093\t                        yaw: 0.0,\n1094\t                        distance: 15.5,\n1095\t                        fov: 40.0,\n1096\t                        ortho: false,\n1097\t                        follow_lag: 0.06,\n1098\t                        height_offset: 0.8,\n1099\t                    };\n1100\t                    let v = &mut self.view;\n1101\t                    v.bloom = 0.55;\n1102\t                    v.bloom_threshold = 1.0;\n1103\t                    v.sky = \"#14161c\".into();\n1104\t                    v.light.sun_elevation = 52.0;\n1105\t                    v.light.sun_azimuth = 35.0;\n1106\t                    v.light.sun_intensity = 0.95;\n1107\t                    v.light.ambient = 0.5;\n1108\t                    v.saturation = 1.08;\n1109\t                    v.fog = false;\n1110\t                } else if let Some((cam, view)) = self.game_saved.take() {\n1111\t                    self.rig.params = cam;\n1112\t                    self.view = view;\n1113\t                }\n1114\t            }\n1115\t            self.game_frame = curr.game.clone();\n1116\t            if !game_mode {\n1117\t                self.game_ui.close_all();\n1118\t                self.game_place = None;\n1119\t            }\n1120\t            if let Some(g) = &curr.game {\n1121\t                if self.game_place != Some(g.place) {\n1122\t                    self.game_place = Some(g.place);\n1123\t                    self.arrival = Some(Instant::now());\n1124\t                    self.game_ui.panel = None;\n1125\t                    pav_view::arpg::place_look(g, &mut self.view);\n1126\t                }\n1127\t            }\n1128\t        } else {\n1129\t            self.game_frame = None;\n1130\t        }\n1131\t        let alpha = if self.app_settings.smoothing && !snap_camera {\n1132\t            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n1133\t        } else {\n1134\t            1.0\n1135\t        };\n1136\t        if snap_camera {\n1137\t            // A submitted edit must contain its new framing as well as its new geometry.\n1138\t            self.rig = CameraRig::new(self.rig.params.clone());\n1139\t            self.rig.snap(curr.focus);\n1140\t        }\n1141\t        let focus = prev.focus.lerp(curr.focus, alpha);\n1142\t        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n1143\t        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n1144\t        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n1145\t\n1146\t        // Game input -> the simulation thread.\n1147\t        let (w, h) = self.gfx.as_ref().unwrap().size();\n1148\t        let size = Vec2::new(w as f32, h as f32);\n1149\t        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n1150\t        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n1151\t        if over_ui {\n1152\t            self.input.mouse_taps.clear();\n1153\t        }\n1154\t        let (mut held, mut pressed) = self.input.buttons();\n1155\t        // Touch: the stick, the buttons and auto-attack.\n1156\t        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n1157\t        let rig = &self.rig;\n1158\t        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n1159\t        if game_input {\n1160\t            held |= intent.held;\n1161\t            pressed |= intent.pressed;\n1162\t        }\n1163\t        if pressed & pav_core::input::buttons::INTERACT != 0 {\n1164\t            if let Some(g) = &curr.game {\n1165\t                if let Some(c) = self.game_ui.interact(g) {\n1166\t                    host.shared.command(c);\n1167\t                }\n1168\t            }\n1169\t        }\n1170\t        if pressed != 0 && self.input.last_device == Device::Gamepad {\n1171\t            // Gamepad presses are timed from when they were polled (gilrs queues them).\n1172\t            self.latency.press();\n1173\t        }\n1174\t        let room_id = self.hud.current.as_ref().map(|r| r.id);\n1175\t        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n1176\t        if left_tap && !self.editor.on && game_input {\n1177\t            pressed |= pav_core::input::buttons::PRIMARY;\n1178\t        }\n1179\t        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n1180\t            held &= !pav_core::input::buttons::PRIMARY;\n1181\t            pressed &= !pav_core::input::buttons::PRIMARY;\n1182\t        }\n1183\t        let aim = match self.input.last_device {\n1184\t            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n1185\t            Device::Gamepad => {\n1186\t                let r = self.input.pad.right;\n1187\t                if r.length() > 0.2 {\n1188\t                    let d = self.rig.relative_move(r);\n1189\t                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n1190\t                } else {\n1191\t                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n1192\t                }\n1193\t            }\n1194\t            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n1195\t        };\n1196\t        {\n1197\t            let mut i = host.shared.input.lock().unwrap();\n1198\t            if game_input {\n1199\t                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n1200\t                i.move_dir = match intent.move_world {\n1201\t                    // Auto-attack stepping in to a foe (only while the stick is still).\n1202\t                    Some(m) if axis == Vec2::ZERO => m,\n1203\t                    _ => self.rig.relative_move(axis),\n1204\t                };\n1205\t                i.held = held;\n1206\t                i.pressed |= pressed;\n1207\t                i.aim = aim;\n1208\t                if let Some(t) = self.latency.pending.take() {\n1209\t                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n1210\t                }\n1211\t            } else {\n1212\t                *i = InputFrame::default();\n1213\t            }\n1214\t        }\n1215\t\n1216\t        self.rig.update(focus, dt);\n1217\t        self.builder.now = self.started.elapsed().as_secs_f64();\n1218\t        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n1219\t        let events = if studio_active { Vec::new() } else { events };\n1220\t        self.builder.add_events(&events);\n1221\t        // Save the hero on every arrival somewhere, and once a minute while playing.\n1222\t        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n1223\t        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n1224\t            self.last_save = Instant::now();\n1225\t            host.exec(|sim| crate::save::save_from(sim));\n1226\t        }\n1227\t        if let Some(a) = &self.audio {\n1228\t            let (_, right) = self.rig.ground_axes();\n1229\t            let l = pav_audio::Listener { pos: self.rig.target, right };\n1230\t            for e in &events {\n1231\t                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n1232\t                    continue;\n1233\t                }\n1234\t                a.play_event(e, &l, self.audio_settings.sfx);\n1235\t            }\n1236\t        }\n1237\t        // The look layer (Look & Filters) over the scene's own settings.\n1238\t        let mut view = self.view.clone();\n1239\t        self.look_ui.apply(&mut view);\n1240\t        self.prefs.quality.trim(self.touch_screen, &mut view);\n1241\t        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n1242\t        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n1243\t        if let Some(t0) = self.arrival {\n1244\t            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n1245\t            match view.filter.transition.kind() {\n1246\t                Some(kind) if t < 1.0 => {\n1247\t                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n1248\t                    scene.filter.transition_kind = kind;\n1249\t                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n1250\t                }\n1251\t                _ => self.arrival = None,\n1252\t            }\n1253\t        }\n1254\t        if !studio_active {\n1255\t            self.editor.draw_preview(&mut scene);\n1256\t        }\n1257\t        if let Some(a) = intent.aiming.filter(|_| game_input) {\n1258\t            // A skill aimed by hand: a ring where it lands and dots on the way there.\n1259\t            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n1260\t                mesh: MeshKey::Cylinder,\n1261\t                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n1262\t                color,\n1263\t                emissive: 0.6,\n1264\t                style: Style::Unlit,\n1265\t                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1266\t                group: 0,\n1267\t                material: 0,\n1268\t                ext: Vec3::ZERO,\n1269\t            };\n1270\t            let a = Vec3::new(a.x, feet.y, a.z);\n1271\t            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n1272\t            let n = ((a - feet).length() / 0.8) as usize;\n1273\t            for k in 1..n {\n1274\t                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n1275\t            }\n1276\t        }\n1277\t        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n1278\t            if let Some(a) = aim {\n1279\t                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n1280\t                let a = if d.length() > self.sim_config.bombs.throw_range {\n1281\t                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n1282\t                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n1283\t                } else {\n1284\t                    a\n1285\t                };\n1286\t                scene.meshes.push(MeshInstance {\n1287\t                    mesh: MeshKey::Cylinder,\n1288\t                    transform: Mat4::from_scale_rotation_translation(\n1289\t                        Vec3::new(0.5, 0.02, 0.5),\n1290\t                        Quat::IDENTITY,\n1291\t                        a + Vec3::Y * 0.03,\n1292\t                    ),\n1293\t                    color: Vec3::new(1.0, 0.95, 0.7),\n1294\t                    emissive: 0.0,\n1295\t                    style: Style::Unlit,\n1296\t                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1297\t                    group: 0,\n1298\t                    material: 0,\n1299\t                    ext: Vec3::ZERO,\n1300\t                });\n1301\t            }\n1302\t        }\n1303\t\n1304\t        // UI.\n1305\t        let stats = *host.shared.stats.lock().unwrap();\n1306\t        let mut ctl = host.control();\n1307\t        let ctl_before = ctl;\n1308\t        let crash = host.shared.crashed.lock().unwrap().clone();\n1309\t        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n1310\t        let gfx = self.gfx.as_mut().unwrap();\n1311\t        let (render_scale, lights) =\n1312\t            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n1313\t        gfx.renderer.render_scale = render_scale;\n1314\t        gfx.renderer.max_shadow_lights = lights;\n1315\t        let info = ui::OverlayInfo {\n1316\t            fps: self.fps.fps,\n1317\t            frame_ms: self.fps.frame_ms,\n1318\t            tps: stats.tps,\n1319\t            tick_ms: stats.tick_ms,\n1320\t            tick: stats.tick,\n1321\t            entities: stats.entities,\n1322\t            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n1323\t            adapter: &gfx.adapter_name,\n1324\t            crash: crash.clone(),\n1325\t            paused: ctl.paused,\n1326\t            speed: ctl.speed,\n1327\t            rewinding,\n1328\t            render_scale,\n1329\t        };\n1330\t        if let Some(t) = self.boot_done_at {\n1331\t            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n1332\t                self.show_boot = false;\n1333\t                self.boot_done_at = None;\n1334\t            }\n1335\t        }\n1336\t        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n1337\t        let card_visible = !studio_active && self.hud.card_visible();\n1338\t        let guide_visible =\n1339\t            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n1340\t        let device = self.input.last_device;\n1341\t        let touch_ui = device == Device::Touch;\n1342\t        if touch_ui != self.touch_styled {\n1343\t            self.touch_styled = touch_ui;\n1344\t            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n1345\t        }\n1346\t        self.game_ui.touch = touch_ui;\n1347\t        self.game_ui.tree.touch = touch_ui;\n1348\t        self.touch.swipes.begin_frame();\n1349\t        let touch = &mut self.touch;\n1350\t        let auto_attack = self.prefs.auto_attack;\n1351\t        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n1352\t        let mut prefs = self.prefs.clone();\n1353\t        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n1354\t        let state = self.egui_state.as_mut().unwrap();\n1355\t        let mut raw = state.take(&gfx.window);\n1356\t        raw.events.append(&mut self.pad_events);\n1357\t        let pad_cursor = self.pad_cursor;\n1358\t        let mut show_boot = self.show_boot;\n1359\t        let menu_open = self.menu_open;\n1360\t        let scene_name = self.scene_name.clone();\n1361\t        let mut menu_action = None;\n1362\t        let mut panel_actions = Vec::new();\n1363\t        let mut teleport = None;\n1364\t        let mut save_room = false;\n1365\t        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n1366\t        let editor = &mut self.editor;\n1367\t        let hud = &mut self.hud;\n1368\t        let config_before = self.sim_config.clone();\n1369\t        let app_before = self.app_settings.clone();\n1370\t        let panel = &mut self.panel;\n1371\t        let master_before = self.audio_settings.master;\n1372\t        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n1373\t        let mut root = Root {\n1374\t            sim: &mut self.sim_config,\n1375\t            camera: &mut self.rig.params,\n1376\t            view: &mut self.view,\n1377\t            app: &mut self.app_settings,\n1378\t            audio: &mut self.audio_settings,\n1379\t        };\n1380\t        let show_stats = root.app.show_stats;\n1381\t        let feel = &mut self.feel;\n1382\t        let physics = &mut self.physics;\n1383\t        let latency = &self.latency;\n1384\t        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n1385\t        let game_frame = curr.game.clone();\n1386\t        let game_ui = &mut self.game_ui;\n1387\t        let look_ui = &mut self.look_ui;\n1388\t        let animation_ui = &mut self.animation_ui;\n1389\t        let asset_ui = &mut self.asset_ui;\n1390\t        let creature_ui = &mut self.creature_ui;\n1391\t        let studio_navigation = self.studio_navigation;\n1392\t        let mut creature_commands = Vec::new();\n1393\t        let mut animation_commands = Vec::new();\n1394\t        let mut asset_commands = Vec::new();\n1395\t        let mut studio_target = None;\n1396\t        #[cfg(not(target_arch = \"wasm32\"))]\n1397\t        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n1398\t        #[cfg(target_arch = \"wasm32\")]\n1399\t        let animation_bridge: Option<&str> = None;\n1400\t        #[cfg(not(target_arch = \"wasm32\"))]\n1401\t        let creature_feedback =\n1402\t            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n1403\t        #[cfg(target_arch = \"wasm32\")]\n1404\t        let creature_feedback: Option<serde_json::Value> = None;\n1405\t        let mut look_msg = None;\n1406\t        let guide = &mut self.guide;\n1407\t        let mut guide_out = Vec::new();\n1408\t        let mut game_cmds = Vec::new();\n1409\t        let out = self.egui_ctx.run_ui(raw, |ui| {\n1410\t            let ctx = ui.ctx().clone();\n1411\t            if let Some(c) = &info.crash {\n1412\t                ui::crash_banner(ui, c);\n1413\t            }\n1414\t            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n1415\t            let free = ui.available_rect_before_wrap();\n1416\t            ui::boot_panel(&ctx, &mut show_boot);\n1417\t            if show_stats {\n1418\t                ui::stats_panel(&ctx, &info, free, touch_ui);\n1419\t            }\n1420\t            if guide_visible && !menu_open && !touch_ui {\n1421\t                ui::guide_panel(&ctx, device, game_frame.is_some());\n1422\t            }\n1423\t            if let Some(g) = &game_frame {\n1424\t                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n1425\t                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n1426\t                if !menu_open {\n1427\t                    game_cmds = game_ui.ui(&ctx, g, &proj);\n1428\t                }\n1429\t            }\n1430\t            if touch_ui {\n1431\t                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n1432\t                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n1433\t                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n1434\t                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n1435\t                if tips && !covered {\n1436\t                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n1437\t                }\n1438\t            }\n1439\t            if card_visible && !menu_open && hud.card(&ctx, device) {\n1440\t                guide.station = true;\n1441\t            }\n1442\t            if !menu_open {\n1443\t                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n1444\t            }\n1445\t            crate::hud::course_hud(&ctx, &hud_ctx);\n1446\t            pav_ui::game_lines(&ctx, hud_ctx.hud);\n1447\t            if let Some(p) = pad_cursor {\n1448\t                // The gamepad's menu cursor, above everything.\n1449\t                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n1450\t                let tip = egui::Pos2::new(p.x, p.y);\n1451\t                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n1452\t                painter.add(egui::Shape::convex_polygon(\n1453\t                    pts,\n1454\t                    egui::Color32::from_rgb(255, 225, 150),\n1455\t                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n1456\t                ));\n1457\t            }\n1458\t            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n1459\t            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n1460\t            feel.ui(\n1461\t                &ctx,\n1462\t                &hud_ctx,\n1463\t                latency,\n1464\t                FeelSettings {\n1465\t                    model: &mut root.sim.movement.model,\n1466\t                    tick_rate: &mut root.sim.tick_rate,\n1467\t                    vsync: &mut root.app.vsync,\n1468\t                    smoothing: &mut root.app.smoothing,\n1469\t                },\n1470\t            );\n1471\t            teleport = hud.teleport_menu(&ctx);\n1472\t            hud.error_panel(&ctx);\n1473\t            if !studio_active {\n1474\t                save_room = editor.ui(&ctx, room_name.as_deref());\n1475\t            }\n1476\t            look_msg = look_ui.window(&ctx, root.view);\n1477\t            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n1478\t                egui::Window::new(\"Studio workspace\")\n1479\t                    .id(egui::Id::new(\"studio_navigation\"))\n1480\t                    .title_bar(false)\n1481\t                    .resizable(false)\n1482\t                    .fixed_pos([16.0, 8.0])\n1483\t                    .show(&ctx, |ui| {\n1484\t                        ui.horizontal(|ui| {\n1485\t                            ui.strong(\"SHARDFALL STUDIO\");\n1486\t                            for (mode, label) in [\n1487\t                                (StudioMode::Animation, \"Animations\"),\n1488\t                                (StudioMode::Prop, \"Objects\"),\n1489\t                                (StudioMode::Creature, \"Creatures\"),\n1490\t                                (StudioMode::World, \"Game\"),\n1491\t                            ] {\n1492\t                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n1493\t                                let reopen = match mode {\n1494\t                                    StudioMode::World => panel_open,\n1495\t                                    StudioMode::Animation => !animation_ui.open,\n1496\t                                    StudioMode::Prop => !asset_ui.open,\n1497\t                                    StudioMode::Creature => !creature_ui.open,\n1498\t                                };\n1499\t                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n1500\t                                    studio_target = Some(mode);\n1501\t                                }\n1502\t                            }\n1503\t                        });\n1504\t                    });\n1505\t            }\n1506\t            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n1507\t                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n1508\t            }\n1509\t            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n1510\t                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n1511\t            }\n1512\t            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n1513\t                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n1514\t            }\n1515\t            let here = hud.current.clone();\n1516\t            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n1517\t            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n1518\t            if menu_open {\n1519\t                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n1520\t                menu_action = if touch_ui {\n1521\t                    let show_fps = &mut root.app.show_stats;\n1522\t                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n1523\t                    ui::touch_menu(&ctx, &scene_name, m)\n1524\t                } else {\n1525\t                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n1526\t                };\n1527\t            }\n1528\t            if let Some(t) = &toast {\n1529\t                if touch_ui {\n1530\t                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n1531\t                } else {\n1532\t                    ui::toast(&ctx, t);\n1533\t                }\n1534\t            }\n1535\t            if !touch_ui {\n1536\t                const GAME_KEYS: &str =\n1537\t                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n1538\t                ui::hint_bar(\n1539\t                    &ctx,\n1540\t                    match (device, game_frame.is_some()) {\n1541\t                        (Device::Gamepad, _) => \"Start: menu\",\n1542\t                        (_, true) => GAME_KEYS,\n1543\t                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n1544\t                    },\n1545\t                );\n1546\t            }\n1547\t        });\n1548\t        if prefs != self.prefs {\n1549\t            self.prefs = prefs;\n1550\t            crate::save::save_prefs(&self.prefs);\n1551\t        }\n1552\t        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n1553\t        let sw = &mut self.touch.swipes;\n1554\t        if sw.take_tap(egui::Id::new(\"minimap\")) {\n1555\t            self.game_ui.map = true;\n1556\t        }\n1557\t        let big = egui::Id::new(\"big_map\");\n1558\t        if sw.take_tap(big) || sw.is_gone(big, 0) {\n1559\t            self.game_ui.map = false;\n1560\t            sw.restore(big);\n1561\t        }\n1562\t        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n1563\t            self.prefs.tips_seen = true;\n1564\t            crate::save::save_prefs(&self.prefs);\n1565\t        }\n1566\t        self.show_boot = show_boot;\n1567\t        for a in guide_out {\n1568\t            match a {\n1569\t                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n1570\t                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n1571\t            }\n1572\t        }\n1573\t        if let Some(m) = look_msg {\n1574\t            self.toast = Some((m, Instant::now()));\n1575\t        }\n1576\t        self.look_ui.save_if_dirty(false);\n1577\t        for c in game_cmds {\n1578\t            host.shared.command(c);\n1579\t        }\n1580\t        if ctl.paused != ctl_before.paused\n1581\t            || ctl.speed != ctl_before.speed\n1582\t            || ctl.step_requests != ctl_before.step_requests\n1583\t            || ctl.rewind_speed != ctl_before.rewind_speed\n1584\t        {\n1585\t            let c = ctl;\n1586\t            host.set_control(|x| {\n1587\t                x.paused = c.paused;\n1588\t                x.speed = c.speed;\n1589\t                x.step_requests = c.step_requests;\n1590\t                x.rewind_speed = c.rewind_speed;\n1591\t            });\n1592\t        }\n1593\t        if self.sim_config != config_before {\n1594\t            let cfg = self.sim_config.clone();\n1595\t            host.exec(move |sim| sim.config = cfg);\n1596\t            self.config_push_tick = stats.tick.max(curr.tick);\n1597\t        }\n1598\t        if self.app_settings.vsync != app_before.vsync {\n1599\t            gfx.set_vsync(self.app_settings.vsync);\n1600\t        }\n1601\t        if self.audio_settings.master != master_before {\n1602\t            if let Some(a) = &self.audio {\n1603\t                a.set_master(self.audio_settings.master);\n1604\t            }\n1605\t        }\n1606\t        state.platform_output(&gfx.window, out.platform_output);\n1607\t        let ppp = out.pixels_per_point;\n1608\t        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n1609\t        let mut textures = out.textures_delta;\n1610\t\n1611\t        #[cfg(target_arch = \"wasm32\")]\n1612\t        if self.screenshot_requested {\n1613\t            // Reading pixels back waits on the GPU, which the browser does not allow here.\n1614\t            self.screenshot_requested = false;\n1615\t            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n1616\t        }\n1617\t        #[cfg(not(target_arch = \"wasm32\"))]\n1618\t        if self.screenshot_requested {\n1619\t            self.screenshot_requested = false;\n1620\t            let (w, h) = gfx.size();\n1621\t            let dir = boot::exe_dir().join(\"screenshots\");\n1622\t            let path = dir.join(format!(\n1623\t                \"shardfall-{}.png\",\n1624\t                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n1625\t            ));\n1626\t            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n1627\t                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n1628\t            self.toast = Some((\n1629\t                match r {\n1630\t                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n1631\t                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n1632\t                },\n1633\t                Instant::now(),\n1634\t            ));\n1635\t        }\n1636\t\n1637\t        let first = self.boot_done_at.is_none()\n1638\t            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n1639\t        let submitted = if first {\n1640\t            let submitted = stage(\"first frame\", || {\n1641\t                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n1642\t                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n1643\t            });\n1644\t            self.boot_done_at = Some(Instant::now());\n1645\t            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n1646\t            submitted.unwrap_or(false)\n1647\t        } else {\n1648\t            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n1649\t        };\n1650\t        #[cfg(not(target_arch = \"wasm32\"))]\n1651\t        if submitted {\n1652\t            if let Some(bridge) = &self.bridge {\n1653\t                bridge.submitted(curr.live_edit_ticket);\n1654\t            }\n1655\t        }\n1656\t        // Input latency: the frame showing the tick that consumed a press is now submitted.\n1657\t        if submitted {\n1658\t            let mut probe = host.shared.latency_probe.lock().unwrap();\n1659\t            if let Some((pressed_at, ticked_at, tick)) = *probe {\n1660\t                if curr.tick >= tick {\n1661\t                    let now = Instant::now();\n1662\t                    self.latency.record(LatencySample {\n1663\t                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n1664\t                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n1665\t                    });\n1666\t                    *probe = None;\n1667\t                }\n1668\t            }\n1669\t        }\n1670\t\n1671\t        for a in panel_actions {\n1672\t            self.panel_action(a);\n1673\t        }\n1674\t        if let Some(t) = teleport {\n1675\t            self.teleport(t);\n1676\t        }\n1677\t        if save_room {\n1678\t            if let (Some(host), Some(id)) = (&self.host, room_id) {\n1679\t                let msg = match crate::edit::save_room(host, id) {\n1680\t                    Ok(p) => format!(\"saved {}\", p.display()),\n1681\t                    Err(e) => format!(\"save failed: {e:#}\"),\n1682\t                };\n1683\t                self.editor.status = msg.clone();\n1684\t                self.toast(msg);\n1685\t                if self.watcher.is_none() {\n1686\t                    self.watcher = RoomWatcher::start();\n1687\t                }\n1688\t            }\n1689\t        }\n1690\t        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n1691\t            self.reload_rooms();\n1692\t        }\n1693\t        if studio_active {\n1694\t            self.ensure_animation_watcher();\n1695\t        }\n1696\t        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n1697\t        for update in animation_updates {\n1698\t            match update {\n1699\t                Ok(message) => {\n1700\t                    log::info!(\"{message}\");\n1701\t                    self.animation_ui.status = message;\n1702\t                    self.animation_ui.error = false;\n1703\t                }\n1704\t                Err(error) => {\n1705\t                    log::warn!(\"animation reload: {error}\");\n1706\t                    self.animation_ui.report(Err(error));\n1707\t                }\n1708\t            }\n1709\t        }\n1710\t        for command in animation_commands {\n1711\t            self.studio_command(command);\n1712\t        }\n1713\t        for command in asset_commands {\n1714\t            self.studio_command(command);\n1715\t        }\n1716\t        for command in creature_commands {\n1717\t            self.studio_command(command);\n1718\t        }\n1719\t        for result in self.creature_watcher.poll() {\n1720\t            self.creature_ui.report(result);\n1721\t        }\n1722\t        self.poll_creature_updates();\n1723\t        for update in self.asset_watcher.poll() {\n1724\t            match update {\n1725\t                Ok((name, definition)) => {\n1726\t                    self.asset_ui.status = format!(\"Reloaded {name}\");\n1727\t                    self.asset_ui.error = false;\n1728\t                    #[cfg(not(target_arch = \"wasm32\"))]\n1729\t                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1730\t                    #[cfg(target_arch = \"wasm32\")]\n1731\t                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n1732\t                    if let Some(host) = &self.host {\n1733\t                        let _ticket = host.query(move |sim| {\n1734\t                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n1735\t                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n1736\t                                return None;\n1737\t                            }\n1738\t                            if let Some(feedback) = feedback {\n1739\t                                if let Ok(mut feedback) = feedback.lock() {\n1740\t                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n1741\t                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n1742\t                                }\n1743\t                            }\n1744\t                            Some(sim.live_edit_ticket)\n1745\t                        });\n1746\t                        #[cfg(not(target_arch = \"wasm32\"))]\n1747\t                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n1748\t                            bridge.adopted(ticket);\n1749\t                        }\n1750\t                    }\n1751\t                }\n1752\t                Err(error) => {\n1753\t                    log::warn!(\"object reload: {error}\");\n1754\t                    self.asset_ui.report(Err(error));\n1755\t                }\n1756\t            }\n1757\t        }\n1758\t        if let Some(mode) = studio_target {\n1759\t            self.switch_studio(mode);\n1760\t        }\n1761\t        if let Some(a) = menu_action {\n1762\t            self.menu_action(a);\n1763\t        }\n1764\t        // Touch: the bag, the menu, the map button, and taps on the open game.\n1765\t        for c in &intent.ui {\n1766\t            match c {\n1767\t                crate::touch::Control::Bag => {\n1768\t                    let ui = &mut self.game_ui;\n1769\t                    if ui.any_open() {\n1770\t                        ui.close_all();\n1771\t                    } else {\n1772\t                        ui.inventory = true;\n1773\t                    }\n1774\t                }\n1775\t                crate::touch::Control::Menu => {\n1776\t                    let open = !self.menu_open;\n1777\t                    self.set_menu(open);\n1778\t                }\n1779\t                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n1780\t                _ => {}\n1781\t            }\n1782\t        }\n1783\t        if intent.world_tap {\n1784\t            self.close_on_tap();\n1785\t        }\n1786\t    }\n1787\t\n1788\t    fn panel_action(&mut self, a: PanelAction) {\n1789\t        let Some(host) = &self.host else { return };\n1790\t        let dir = boot::exe_dir();\n1791\t        match a {\n1792\t            PanelAction::Reset => self.reset(),\n1793\t            PanelAction::Scrub(t) => host.set_control(|c| {\n1794\t                c.paused = true;\n1795\t                c.scrub = Some(t);\n1796\t            }),\n1797\t            PanelAction::SaveSnapshot => {\n1798\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1799\t                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n1800\t                match r {\n1801\t                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n1802\t                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n1803\t                    None => self.toast(\"snapshot timed out\"),\n1804\t                }\n1805\t            }\n1806\t            PanelAction::LoadSnapshot => {\n1807\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1808\t                let r = host.query(move |sim| sim.load_state(&path));\n1809\t                match r {\n1810\t                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n1811\t                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n1812\t                    None => self.toast(\"load timed out\"),\n1813\t                }\n1814\t            }\n1815\t            PanelAction::SaveReplay => {\n1816\t                let path = dir.join(\"replays\").join(\"last.replay.json\");\n1817\t                let r = host.query(move |sim| -> Result<String> {\n1818\t                    let mut rep = sim.recording.clone();\n1819\t                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n1820\t                    std::fs::create_dir_all(path.parent().unwrap())?;\n1821\t                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n1822\t                    Ok(path.display().to_string())\n1823\t                });\n1824\t                match r {\n1825\t                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n1826\t                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n1827\t                    None => self.toast(\"replay timed out\"),\n1828\t                }\n1829\t            }\n1830\t            PanelAction::Look => self.look_ui.open = true,\n1831\t            PanelAction::Status(s) => {\n1832\t                self.panel.status(s.clone());\n1833\t                self.toast(s);\n1834\t            }\n1835\t        }\n1836\t    }\n1837\t\n1838\t    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n1839\t    /// persistence identical for a user and an LLM.\n1840\t    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n1841\t        let Some(host) = &self.host else { return };\n1842\t        let asset = command.tool.starts_with(\"asset\");\n1843\t        let creature = command.tool.starts_with(\"creature\");\n1844\t        #[cfg(not(target_arch = \"wasm32\"))]\n1845\t        if let Some(bridge) = &self.bridge {\n1846\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1847\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1848\t                Ok(None) => {}\n1849\t                Err(error) => {\n1850\t                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n1851\t                    if creature {\n1852\t                        self.creature_ui.report(Err(message));\n1853\t                    } else if asset {\n1854\t                        self.asset_ui.report(Err(message));\n1855\t                    } else {\n1856\t                        self.animation_ui.report(Err(message));\n1857\t                    }\n1858\t                    return;\n1859\t                }\n1860\t            }\n1861\t        }\n1862\t        let rig = self.rig.clone();\n1863\t        let view = self.view.clone();\n1864\t        let look = self.look_ui.look().clone();\n1865\t        #[cfg(not(target_arch = \"wasm32\"))]\n1866\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1867\t        #[cfg(target_arch = \"wasm32\")]\n1868\t        let feedback = None;\n1869\t        let reply = host.query(move |sim| {\n1870\t            let live = std::mem::replace(sim, Sim::empty(1));\n1871\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1872\t            session.look = look;\n1873\t            session.feedback = feedback;\n1874\t            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n1875\t                .map(|out| match out {\n1876\t                    pav_tools::Output::Json(v) => v,\n1877\t                    pav_tools::Output::Image { meta, .. } => meta,\n1878\t                })\n1879\t                .map_err(|e| format!(\"{e:#}\"));\n1880\t            let (live, rig, view, _) = session.into_live();\n1881\t            let ticket = live.live_edit_ticket;\n1882\t            *sim = live;\n1883\t            (result, rig, view, ticket)\n1884\t        });\n1885\t        let result = match reply {\n1886\t            Some((result, rig, view, _ticket)) => {\n1887\t                self.rig = rig;\n1888\t                self.view = view;\n1889\t                #[cfg(not(target_arch = \"wasm32\"))]\n1890\t                if let Some(bridge) = &self.bridge {\n1891\t                    bridge.adopted(_ticket);\n1892\t                }\n1893\t                result\n1894\t            }\n1895\t            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n1896\t        };\n1897\t        if creature {\n1898\t            self.creature_ui.report_command(result);\n1899\t        } else if asset {\n1900\t            self.asset_ui.report(result);\n1901\t        } else {\n1902\t            self.animation_ui.report(result);\n1903\t        }\n1904\t        self.ensure_animation_watcher();\n1905\t    }\n1906\t\n1907\t    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n1908\t    fn poll_creature_updates(&mut self) {\n1909\t        if !pav_tools::creature_tools::has_updates() {\n1910\t            return;\n1911\t        }\n1912\t        let Some(host) = &self.host else { return };\n1913\t        #[cfg(not(target_arch = \"wasm32\"))]\n1914\t        if let Some(bridge) = &self.bridge {\n1915\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1916\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1917\t                Ok(None) => {}\n1918\t                Err(_) => return,\n1919\t            }\n1920\t        }\n1921\t        let rig = self.rig.clone();\n1922\t        let view = self.view.clone();\n1923\t        let look = self.look_ui.look().clone();\n1924\t        #[cfg(not(target_arch = \"wasm32\"))]\n1925\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1926\t        #[cfg(target_arch = \"wasm32\")]\n1927\t        let feedback = None;\n1928\t        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n1929\t            let live = std::mem::replace(sim, Sim::empty(1));\n1930\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1931\t            session.look = look;\n1932\t            session.feedback = feedback;\n1933\t            let reports = pav_tools::creature_tools::poll(&mut session);\n1934\t            let (live, rig, view, _) = session.into_live();\n1935\t            let ticket = live.live_edit_ticket;\n1936\t            *sim = live;\n1937\t            (reports, rig, view, ticket)\n1938\t        }) {\n1939\t            self.rig = rig;\n1940\t            self.view = view;\n1941\t            #[cfg(not(target_arch = \"wasm32\"))]\n1942\t            if let Some(bridge) = &self.bridge {\n1943\t                bridge.adopted(ticket);\n1944\t            }\n1945\t            #[cfg(target_arch = \"wasm32\")]\n1946\t            let _ = ticket;\n1947\t            for report in reports {\n1948\t                self.creature_ui.report(Ok(report));\n1949\t            }\n1950\t        }\n1951\t    }\n1952\t\n1953\t    fn switch_studio(&mut self, mode: StudioMode) {\n1954\t        self.studio_navigation = true;\n1955\t        self.set_menu(false);\n1956\t        #[cfg(not(target_arch = \"wasm32\"))]\n1957\t        if mode != StudioMode::World {\n1958\t            if mode == StudioMode::Animation {\n1959\t                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n1960\t                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n1961\t                }\n1962\t            }\n1963\t            if self.bridge.is_none() {\n1964\t                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n1965\t                    Ok(bridge) => self.bridge = Some(bridge),\n1966\t                    Err(error) => {\n1967\t                        let message = format!(\"Could not open the live bridge: {error}\");\n1968\t                        if mode == StudioMode::Creature {\n1969\t                            self.creature_ui.report(Err(message));\n1970\t                        } else if mode == StudioMode::Prop {\n1971\t                            self.asset_ui.report(Err(message));\n1972\t                        } else {\n1973\t                            self.animation_ui.report(Err(message));\n1974\t                        }\n1975\t                    }\n1976\t                }\n1977\t            }\n1978\t        }\n1979\t        self.animation_ui.open = mode == StudioMode::Animation;\n1980\t        self.asset_ui.open = mode == StudioMode::Prop;\n1981\t        self.creature_ui.open = mode == StudioMode::Creature;\n1982\t        let tool = match mode {\n1983\t            StudioMode::Animation => \"anim_preview\",\n1984\t            StudioMode::Prop => \"asset_preview\",\n1985\t            StudioMode::Creature => \"creature_preview\",\n1986\t            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n1987\t            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n1988\t            StudioMode::World => \"anim_preview\",\n1989\t        };\n1990\t        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n1991\t        self.studio_command(crate::animation_ui::Command {\n1992\t            tool,\n1993\t            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n1994\t        });\n1995\t    }\n1996\t\n1997\t    fn ensure_animation_watcher(&mut self) {\n1998\t        // An agent may create the first animation directory through the bridge. Attach\n1999\t        // then, but do not retry a failed native watcher on every frame.\n2000\t        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n2001\t            self.animation_watch_attempted = true;\n2002\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n2003\t        }\n2004\t    }\n2005\t\n2006\t    fn menu_action(&mut self, a: MenuAction) {\n2007\t        match a {\n2008\t            MenuAction::Resume => self.set_menu(false),\n2009\t            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n2010\t            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n2011\t            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n2012\t            MenuAction::Reset => {\n2013\t                self.set_menu(false);\n2014\t                self.reset();\n2015\t            }\n2016\t            MenuAction::LoadScene(name) => {\n2017\t                self.set_menu(false);\n2018\t                self.load_scene(&name);\n2019\t            }\n2020\t            MenuAction::NewHero => {\n2021\t                self.set_menu(false);\n2022\t                if let Some(host) = &self.host {\n2023\t                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n2024\t                    host.exec(move |sim| {\n2025\t                        crate::save::erase();\n2026\t                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n2027\t                            fresh.config = cfg;\n2028\t                            *sim = fresh;\n2029\t                        }\n2030\t                    });\n2031\t                }\n2032\t                self.scene_name = \"town\".into();\n2033\t                self.toast(\"a new hero arrives in Emberwatch\");\n2034\t            }\n2035\t            MenuAction::Tuning => {\n2036\t                self.set_menu(false);\n2037\t                self.panel.open = true;\n2038\t            }\n2039\t            MenuAction::Look => {\n2040\t                self.set_menu(false);\n2041\t                self.look_ui.open = true;\n2042\t            }\n2043\t            MenuAction::Guide => {\n2044\t                self.set_menu(false);\n2045\t                if self.hud.current.is_some() {\n2046\t                    self.guide.station = true;\n2047\t                } else {\n2048\t                    self.guide.field = true;\n2049\t                }\n2050\t            }\n2051\t            MenuAction::FieldGuide => {\n2052\t                self.set_menu(false);\n2053\t                self.guide.field = true;\n2054\t            }\n2055\t            MenuAction::Rooms => {\n2056\t                self.set_menu(false);\n2057\t                self.open_teleport();\n2058\t            }\n2059\t            MenuAction::RoomCard => {\n2060\t                self.set_menu(false);\n2061\t                self.hud.show_card();\n2062\t            }\n2063\t            MenuAction::Screenshot => {\n2064\t                self.set_menu(false);\n2065\t                self.screenshot_requested = true;\n2066\t            }\n2067\t            MenuAction::Feel => {\n2068\t                self.set_menu(false);\n2069\t                self.feel.open = !self.feel.open;\n2070\t                self.feel.auto = false;\n2071\t            }\n2072\t            MenuAction::Physics => {\n2073\t                self.set_menu(false);\n2074\t                self.physics.open = !self.physics.open;\n2075\t                self.physics.auto = false;\n2076\t            }\n2077\t            MenuAction::Quit => {\n2078\t                self.look_ui.save_if_dirty(true);\n2079\t                self.quit = true;\n2080\t            }\n2081\t            MenuAction::TownPortal => {\n2082\t                self.set_menu(false);\n2083\t                if let Some(host) = &self.host {\n2084\t                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n2085\t                }\n2086\t            }\n2087\t            MenuAction::Fullscreen => {\n2088\t                if let Some(g) = &self.gfx {\n2089\t                    crate::platform::toggle_fullscreen(&g.window);\n2090\t                }\n2091\t            }\n2092\t        }\n2093\t    }\n2094\t}\n2095\t\n2096\timpl App {\n2097\t    /// The browser only allows sound after the first click or key press.\n2098\t    #[cfg(target_arch = \"wasm32\")]\n2099\t    fn resume_audio(&mut self) {\n2100\t        if !self.audio_resumed {\n2101\t            self.audio_resumed = true;\n2102\t            if let Some(a) = &self.audio {\n2103\t                a.resume();\n2104\t            }\n2105\t        }\n2106\t    }\n2107\t\n2108\t    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n2109\t    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n2110\t        let msg = format!(\"{e:#}\");\n2111\t        #[cfg(target_arch = \"wasm32\")]\n2112\t        crate::platform::error_box(\"Shardfall could not start\", &msg);\n2113\t        self.fatal = Some(msg);\n2114\t        el.exit();\n2115\t    }\n2116\t}\n2117\t\n2118\timpl ApplicationHandler for App {\n2119\t    fn resumed(&mut self, el: &ActiveEventLoop) {\n2120\t        if self.init_started || self.fatal.is_some() {\n2121\t            return;\n2122\t        }\n2123\t        self.init_started = true;\n2124\t        if let Err(e) = self.init(el) {\n2125\t            self.fail(el, e);\n2126\t        }\n2127\t    }\n2128\t\n2129\t    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n2130\t        if let WindowEvent::Touch(t) = &event {\n2131\t            self.on_touch(t, &event);\n2132\t            return;\n2133\t        }\n2134\t        let consumed = match (&mut self.egui_state, &self.gfx) {\n2135\t            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n2136\t            _ => false,\n2137\t        };\n2138\t        match event {\n2139\t            WindowEvent::CloseRequested => {\n2140\t                if let Some(host) = &self.host {\n2141\t                    host.exec(|sim| crate::save::save_from(sim));\n2142\t                }\n2143\t                self.look_ui.save_if_dirty(true);\n2144\t                el.exit()\n2145\t            }\n2146\t            WindowEvent::Focused(false) => {\n2147\t                self.input.clear();\n2148\t                self.touch.clear();\n2149\t            }\n2150\t            WindowEvent::Resized(sz) => {\n2151\t                if let Some(g) = &mut self.gfx {\n2152\t                    g.resize(sz.width, sz.height);\n2153\t                }\n2154\t            }\n2155\t            WindowEvent::RedrawRequested => {\n2156\t                self.frame();\n2157\t                if self.quit {\n2158\t                    el.exit();\n2159\t                }\n2160\t            }\n2161\t            WindowEvent::KeyboardInput { event, .. } => {\n2162\t                #[cfg(target_arch = \"wasm32\")]\n2163\t                self.resume_audio();\n2164\t                if let PhysicalKey::Code(code) = event.physical_key {\n2165\t                    let system = matches!(\n2166\t                        code,\n2167\t                        KeyCode::Escape\n2168\t                            | KeyCode::F1\n2169\t                            | KeyCode::F2\n2170\t                            | KeyCode::F3\n2171\t                            | KeyCode::F4\n2172\t                            | KeyCode::F5\n2173\t                            | KeyCode::F6\n2174\t                            | KeyCode::F7\n2175\t                            | KeyCode::F8\n2176\t                            | KeyCode::F9\n2177\t                            | KeyCode::F10\n2178\t                            | KeyCode::F11\n2179\t                            | KeyCode::F12\n2180\t                    );\n2181\t                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n2182\t                        self.handle_key(code);\n2183\t                        if !system && !consumed {\n2184\t                            self.latency.press();\n2185\t                        }\n2186\t                    }\n2187\t                    if !consumed || event.state == ElementState::Released {\n2188\t                        self.input.key(code, event.state);\n2189\t                    }\n2190\t                }\n2191\t            }\n2192\t            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n2193\t                let lines = match delta {\n2194\t                    MouseScrollDelta::LineDelta(_, y) => y,\n2195\t                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n2196\t                };\n2197\t                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n2198\t            }\n2199\t            WindowEvent::MouseInput { state, button, .. } => {\n2200\t                #[cfg(target_arch = \"wasm32\")]\n2201\t                self.resume_audio();\n2202\t                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n2203\t                    self.latency.press();\n2204\t                }\n2205\t                // In the game the right button is a skill; the middle button turns the camera.\n2206\t                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n2207\t                    MouseButton::Middle\n2208\t                } else {\n2209\t                    MouseButton::Right\n2210\t                };\n2211\t                if button == turn {\n2212\t                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n2213\t                } else if !consumed || state == ElementState::Released {\n2214\t                    self.input.mouse_button(button, state);\n2215\t                }\n2216\t            }\n2217\t            WindowEvent::CursorMoved { position, .. } => {\n2218\t                let p = Vec2::new(position.x as f32, position.y as f32);\n2219\t                if self.mouse.right_down {\n2220\t                    let d = p - self.mouse.pos;\n2221\t                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n2222\t                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n2223\t                }\n2224\t                if (p - self.mouse.pos).length() > 2.0 {\n2225\t                    self.input.last_device = Device::KeyboardMouse;\n2226\t                }\n2227\t                self.mouse.pos = p;\n2228\t                self.input.cursor = p;\n2229\t            }\n2230\t            _ => {}\n2231\t        }\n2232\t    }\n2233\t\n2234\t    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n2235\t        #[cfg(target_arch = \"wasm32\")]\n2236\t        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n2237\t            self.pending_gfx = None;\n2238\t            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n2239\t                self.fail(el, e);\n2240\t            }\n2241\t        }\n2242\t        #[cfg(not(target_arch = \"wasm32\"))]\n2243\t        let _ = el;\n2244\t        if let Some(g) = &self.gfx {\n2245\t            g.window.request_redraw();\n2246\t        }\n2247\t    }\n2248\t}\n2249\t\n2250\tfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n2251\t    let mut v: Vec<RoomEntry> = sim\n2252\t        .state\n2253\t        .world\n2254\t        .rooms\n2255\t        .iter()\n2256\t        .map(|r| RoomEntry {\n2257\t            key: r.key.clone(),\n2258\t            name: if r.def.name.is_empty() { r.key.clone() } else { r.def.name.clone() },\n2259\t            wing: r.def.wing.clone(),\n2260\t            about: r.def.about.clone(),\n2261\t            ask: r.def.learn.ask.clone(),\n2262\t        })\n2263\t        .collect();\n2264\t    v.sort_by(|a, b| (&a.wing, &a.name).cmp(&(&b.wing, &b.name)));\n2265\t    v\n2266\t}\n2267\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"fac71215-51fb-45b8-a975-be572c3bd8a1","timestamp":"2026-11-05T13:31:57.328Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/app.rs","content":"                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }\n            }\n            TeleportTarget::Hub => {\n                host.exec(|sim| {\n                    if let Some(pid) = sim.state.player {\n                        sim.set_position(pid, Vec3::new(0.0, 0.0, 6.0));\n                    }\n                });\n                \"went to the plaza\".into()\n            }\n            TeleportTarget::Wilderness => {\n                let a = self.started.elapsed().as_secs_f32() * 7.3;\n                let p = Vec3::new(a.cos(), 0.0, a.sin()) * 220.0 + Vec3::Y * 25.0;\n                host.exec(move |sim| {\n                    sim.state.world.interest.push(p);\n                    sim.update_streaming(usize::MAX);\n                    sim.state.world.interest.pop();\n                    if let Some(pid) = sim.state.player {\n                        sim.set_position(pid, p);\n                    }\n                });\n                \"went to the wilderness\".into()\n            }\n        };\n        self.toast(msg);\n    }\n\n    fn open_teleport(&mut self) {\n        if let Some(host) = &self.host {\n            if let Some(e) = host.query(|sim| room_entries(sim)) {\n                self.hud.entries = e;\n            }\n        }\n        self.hud.teleport_open = true;\n    }\n\n    /// Hot reload: re-read room files and rebuild what changed.\n    fn reload_rooms(&mut self) {\n        let Some(host) = &self.host else { return };\n        let dir = self.watcher.as_ref().map(|w| w.dir.clone());\n        let sources = pav_core::room::load_sources(dir.as_deref());\n        let (defs, errors) = pav_core::room::parse_all(&sources);\n        self.hud.errors = errors.iter().map(|(k, e)| format!(\"{k}: {e}\")).collect();\n        for e in &self.hud.errors {\n            log::error!(\"room file: {e}\");\n        }\n        let bad: Vec<String> = errors.into_iter().map(|(k, _)| k).collect();\n        let changed = host\n            .query(move |sim| {\n                // Rooms whose file is broken keep their current definition.\n                let mut defs = defs;\n                for k in &bad {\n                    if let Some(r) = sim.state.world.room(k) {\n                        defs.push((k.clone(), (*r.def).clone()));\n                    }\n                }\n                pav_tools::tools::reload_rooms(sim, defs)\n            })\n            .unwrap_or(0);\n        if self.hud.errors.is_empty() {\n            self.toast(format!(\"rooms reloaded ({changed} changed)\"));\n        }\n    }\n\n    fn set_menu(&mut self, open: bool) {\n        let Some(host) = &self.host else { return };\n        if open && !self.menu_open {\n            self.paused_before_menu = host.control().paused;\n            host.set_control(|c| c.paused = true);\n        } else if !open && self.menu_open {\n            let p = self.paused_before_menu;\n            host.set_control(|c| c.paused = p);\n        }\n        self.menu_open = open;\n        self.input.clear();\n    }\n\n    /// The fixed system layer: never rebinds, works in every room.\n    fn handle_key(&mut self, code: KeyCode) {\n        let Some(host) = &self.host else { return };\n        if self.studio_mode == StudioMode::Animation {\n            if let Some(p) = host.frames().1.animation_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"anim_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        if self.studio_mode == StudioMode::Prop {\n            if let Some(p) = host.frames().1.prop_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"playing\": false, \"time\": p.time + 1.0 / 60.0})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"asset_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        if self.studio_mode == StudioMode::Creature {\n            if let Some(p) = host.frames().1.creature_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"creature_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        // Shardfall's menu keys.\n        if self.input.game && !self.menu_open && self.studio_mode == StudioMode::World {\n            let ui = &mut self.game_ui;\n            match code {\n                KeyCode::KeyI | KeyCode::Tab => {\n                    ui.inventory = !ui.inventory;\n                    return;\n                }\n                KeyCode::KeyC => {\n                    ui.character = !ui.character;\n                    return;\n                }\n                KeyCode::KeyK => {\n                    ui.skills = !ui.skills;\n                    return;\n                }\n                KeyCode::KeyP => {\n                    ui.tree.open = !ui.tree.open;\n                    return;\n                }\n                KeyCode::KeyM => {\n                    ui.map = !ui.map;\n                    return;\n                }\n                KeyCode::KeyT => {\n                    // Town portal: home from anywhere.\n                    if self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town) {\n                        host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                    }\n                    return;\n                }\n                KeyCode::Escape if ui.any_open() => {\n                    ui.close_all();\n                    return;\n                }\n                _ => {}\n            }\n        }\n        match code {\n            KeyCode::Escape => {\n                let open = !self.menu_open;\n                self.set_menu(open);\n            }\n            KeyCode::F1 => self.panel.open = !self.panel.open,\n            // How the room you are in works (outside the rooms: the field guide).\n            KeyCode::KeyH if !self.input.game => {\n                if self.hud.current.is_some() {\n                    self.guide.station = !self.guide.station;\n                } else {\n                    self.guide.field = !self.guide.field;\n                }\n            }\n            KeyCode::F2 => {\n                if self.hud.teleport_open {\n                    self.hud.teleport_open = false;\n                } else {\n                    self.open_teleport();\n                }\n            }\n            KeyCode::F3 => self.show_boot = !self.show_boot,\n            KeyCode::F4 => {\n                host.exec(|sim| {\n                    sim.leave_room();\n                });\n                self.toast(\"left the room\");\n            }\n            KeyCode::F5 => self.reset_room(),\n            KeyCode::F6 => host.set_control(|c| c.paused = !c.paused),\n            KeyCode::F7 => host.set_control(|c| {\n                c.paused = true;\n                c.step_requests += 1;\n            }),\n            KeyCode::F8 => host.set_control(|c| c.speed = (c.speed * 0.5).max(0.0625)),\n            KeyCode::F9 => host.set_control(|c| c.speed = (c.speed * 2.0).min(8.0)),\n            KeyCode::F10 if self.studio_mode == StudioMode::World => {\n                self.editor.on = !self.editor.on;\n                self.editor.dragging = None;\n                let on = self.editor.on;\n                self.toast(if on { \"edit mode on\" } else { \"edit mode off\" });\n            }\n            KeyCode::F11 => {\n                if let Some(g) = &self.gfx {\n                    let fs = g.window.fullscreen().is_some();\n                    g.window.set_fullscreen(if fs { None } else { Some(Fullscreen::Borderless(None)) });\n                }\n            }\n            KeyCode::F12 => self.screenshot_requested = true,\n            _ => {\n                let digits = [\n                    KeyCode::Digit1,\n                    KeyCode::Digit2,\n                    KeyCode::Digit3,\n                    KeyCode::Digit4,\n                    KeyCode::Digit5,\n                    KeyCode::Digit6,\n                    KeyCode::Digit7,\n                    KeyCode::Digit8,\n                ];\n                // (In Shardfall the number keys are potions and belt items.)\n                let digit =\n                    digits.iter().position(|k| *k == code).filter(|i| *i < CameraParams::PRESETS.len() && !self.input.game);\n                if let Some(i) = digit {\n                    let yaw = self.rig.params.yaw;\n                    self.rig.params = (CameraParams::PRESETS[i].1)();\n                    if CameraParams::PRESETS[i].0 != \"isometric\" {\n                        self.rig.params.yaw = yaw;\n                    }\n                    self.toast(format!(\"camera: {}\", CameraParams::PRESETS[i].0));\n                }\n            }\n        }\n    }\n\n    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        // Touch screens draw at most 60 frames a second (a phone with a faster screen would\n        // spend battery and heat on the rest).\n        if self.touch_screen {\n            let now = Instant::now();\n            let step = std::time::Duration::from_micros(16_667);\n            if now + std::time::Duration::from_micros(2_500) < self.next_draw {\n                return;\n            }\n            self.next_draw = if now > self.next_draw + step { now + step } else { self.next_draw + step };\n        }\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n        self.fps.frames += 1;\n        let since = self.fps.since.elapsed().as_secs_f32();\n        if since >= 0.5 {\n            self.fps.fps = self.fps.frames as f32 / since;\n            self.fps.frame_ms = since * 1000.0 / self.fps.frames as f32;\n            self.fps.frames = 0;\n            self.fps.since = now;\n        }\n\n        // Devices.\n        self.input.poll_gamepad();\n        if self.input.pad.start_pressed {\n            let open = !self.menu_open;\n            self.set_menu(open);\n        }\n        if self.input.pad.map_pressed {\n            self.game_ui.map = !self.game_ui.map;\n        }\n        self.pad_menus(dt);\n        let pad = self.input.last_device == Device::Gamepad;\n        self.game_ui.pad = pad;\n        self.game_ui.tree.pad = pad;\n        self.rig.params.yaw = (self.rig.params.yaw + self.input.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n        self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n\n        let host = self.host.as_ref().unwrap();\n        host.pump();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(b) = &self.bridge {\n            // Agent tools run on the simulation thread and can change the camera, view and look.\n            if let Some(l) = b.poll(host, &mut self.rig, &mut self.view, self.look_ui.look()) {\n                self.look_ui.set_look(l);\n            }\n        }\n        let ui_wants_keys = self.egui_ctx.egui_wants_keyboard_input();\n        let game_input = !self.menu_open && !ui_wants_keys;\n        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n        host.set_control(|c| c.rewinding = rewinding);\n\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\n        let studio_active = curr.studio_active();\n        self.studio_navigation |= studio_active;\n        let snap_camera = studio_mode != self.studio_mode\n            || prev.studio_mode() != studio_mode\n            || prev.live_edit_ticket != curr.live_edit_ticket;\n        let game_input = game_input && !studio_active;\n        if studio_mode != self.studio_mode {\n            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n            let keep_creature_redo =\n                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n            self.builder = ViewBuilder::new();\n            if let Some(gfx) = &mut self.gfx {\n                gfx.renderer.clear_particles();\n            }\n            self.studio_mode = studio_mode;\n            self.animation_ui.open = studio_mode == StudioMode::Animation;\n            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n        }\n        if !studio_active {\n            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n            self.director.update(&curr.hud, quarters, &mut self.rig);\n            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n            self.hud.update(&curr.room, &mut self.rig);\n            // Rooms and pads can change view settings (night lighting, bloom, filters).\n            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n            if key != self.view_key {\n                self.view_key = key;\n                if let Some(b) = self.view_base.take() {\n                    self.view = b;\n                }\n                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n                if !room.is_empty() || !pads.is_empty() {\n                    self.view_base = Some(self.view.clone());\n                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n                        log::warn!(\"unknown view setting '{u}'\");\n                    }\n                }\n            }\n            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n                // Rooms can open HUD overlays (feel metrics) while you are inside.\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n                if wants && !self.feel.open {\n                    self.feel.open = true;\n                    self.feel.auto = true;\n                } else if !wants && self.feel.auto {\n                    self.feel.open = false;\n                    self.feel.auto = false;\n                }\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n                if wants && !self.physics.open {\n                    self.physics.open = true;\n                    self.physics.auto = true;\n                } else if !wants && self.physics.auto {\n                    self.physics.open = false;\n                    self.physics.auto = false;\n                }\n            }\n            self.feel.record(curr.tick, curr.hud.feel.speed);\n            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n                // Input switching: the room's key overrides apply while inside.\n                let (b, errs) = match &self.hud.current {\n                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n                    None => (crate::input::Bindings::default(), Vec::new()),\n                };\n                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n            }\n            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n                // The simulation changed its configuration (room overrides): adopt it.\n                self.sim_config = (*curr.config).clone();\n            }\n            // Entering or leaving Shardfall: its controls, camera and look.\n            let game_mode = curr.game.is_some();\n            if game_mode != self.input.game {\n                self.input.game = game_mode;\n                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n                self.rig.blend_from_current(0.5);\n                if game_mode {\n                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n                    self.rig.params = CameraParams {\n                        tilt: 56.0,\n                        yaw: 0.0,\n                        distance: 15.5,\n                        fov: 40.0,\n                        ortho: false,\n                        follow_lag: 0.06,\n                        height_offset: 0.8,\n                    };\n                    let v = &mut self.view;\n                    v.bloom = 0.55;\n                    v.bloom_threshold = 1.0;\n                    v.sky = \"#14161c\".into();\n                    v.light.sun_elevation = 52.0;\n                    v.light.sun_azimuth = 35.0;\n                    v.light.sun_intensity = 0.95;\n                    v.light.ambient = 0.5;\n                    v.saturation = 1.08;\n                    v.fog = false;\n                } else if let Some((cam, view)) = self.game_saved.take() {\n                    self.rig.params = cam;\n                    self.view = view;\n                }\n            }\n            self.game_frame = curr.game.clone();\n            if !game_mode {\n                self.game_ui.close_all();\n                self.game_place = None;\n            }\n            if let Some(g) = &curr.game {\n                if self.game_place != Some(g.place) {\n                    self.game_place = Some(g.place);\n                    self.arrival = Some(Instant::now());\n                    self.game_ui.panel = None;\n                    pav_view::arpg::place_look(g, &mut self.view);\n                }\n            }\n        } else {\n            self.game_frame = None;\n        }\n        let alpha = if self.app_settings.smoothing && !snap_camera {\n            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n        } else {\n            1.0\n        };\n        if snap_camera {\n            // A submitted edit must contain its new framing as well as its new geometry.\n            self.rig = CameraRig::new(self.rig.params.clone());\n            self.rig.snap(curr.focus);\n        }\n        let focus = prev.focus.lerp(curr.focus, alpha);\n        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n\n        // Game input -> the simulation thread.\n        let (w, h) = self.gfx.as_ref().unwrap().size();\n        let size = Vec2::new(w as f32, h as f32);\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n        if over_ui {\n            self.input.mouse_taps.clear();\n        }\n        let (mut held, mut pressed) = self.input.buttons();\n        // Touch: the stick, the buttons and auto-attack.\n        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n        let rig = &self.rig;\n        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n        if game_input {\n            held |= intent.held;\n            pressed |= intent.pressed;\n        }\n        if pressed & pav_core::input::buttons::INTERACT != 0 {\n            if let Some(g) = &curr.game {\n                if let Some(c) = self.game_ui.interact(g) {\n                    host.shared.command(c);\n                }\n            }\n        }\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\n            self.latency.press();\n        }\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\n        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n            held &= !pav_core::input::buttons::PRIMARY;\n            pressed &= !pav_core::input::buttons::PRIMARY;\n        }\n        let aim = match self.input.last_device {\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n            Device::Gamepad => {\n                let r = self.input.pad.right;\n                if r.length() > 0.2 {\n                    let d = self.rig.relative_move(r);\n                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n                } else {\n                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n                }\n            }\n            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n        };\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            if game_input {\n                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n                i.move_dir = match intent.move_world {\n                    // Auto-attack stepping in to a foe (only while the stick is still).\n                    Some(m) if axis == Vec2::ZERO => m,\n                    _ => self.rig.relative_move(axis),\n                };\n                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\n                if let Some(t) = self.latency.pending.take() {\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n                }\n            } else {\n                *i = InputFrame::default();\n            }\n        }\n\n        self.rig.update(focus, dt);\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        let events = if studio_active { Vec::new() } else { events };\n        self.builder.add_events(&events);\n        // Save the hero on every arrival somewhere, and once a minute while playing.\n        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n            self.last_save = Instant::now();\n            host.exec(|sim| crate::save::save_from(sim));\n        }\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = pav_audio::Listener { pos: self.rig.target, right };\n            for e in &events {\n                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n                    continue;\n                }\n                a.play_event(e, &l, self.audio_settings.sfx);\n            }\n        }\n        // The look layer (Look & Filters) over the scene's own settings.\n        let mut view = self.view.clone();\n        self.look_ui.apply(&mut view);\n        self.prefs.quality.trim(self.touch_screen, &mut view);\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n        if let Some(t0) = self.arrival {\n            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n            match view.filter.transition.kind() {\n                Some(kind) if t < 1.0 => {\n                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n                    scene.filter.transition_kind = kind;\n                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n                }\n                _ => self.arrival = None,\n            }\n        }\n        if !studio_active {\n            self.editor.draw_preview(&mut scene);\n        }\n        if let Some(a) = intent.aiming.filter(|_| game_input) {\n            // A skill aimed by hand: a ring where it lands and dots on the way there.\n            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n                mesh: MeshKey::Cylinder,\n                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n                color,\n                emissive: 0.6,\n                style: Style::Unlit,\n                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                group: 0,\n                material: 0,\n                ext: Vec3::ZERO,\n            };\n            let a = Vec3::new(a.x, feet.y, a.z);\n            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n            let n = ((a - feet).length() / 0.8) as usize;\n            for k in 1..n {\n                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n            }\n        }\n        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n            if let Some(a) = aim {\n                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n                let a = if d.length() > self.sim_config.bombs.throw_range {\n                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n                } else {\n                    a\n                };\n                scene.meshes.push(MeshInstance {\n                    mesh: MeshKey::Cylinder,\n                    transform: Mat4::from_scale_rotation_translation(\n                        Vec3::new(0.5, 0.02, 0.5),\n                        Quat::IDENTITY,\n                        a + Vec3::Y * 0.03,\n                    ),\n                    color: Vec3::new(1.0, 0.95, 0.7),\n                    emissive: 0.0,\n                    style: Style::Unlit,\n                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                    group: 0,\n                    material: 0,\n                    ext: Vec3::ZERO,\n                });\n            }\n        }\n\n        // UI.\n        let stats = *host.shared.stats.lock().unwrap();\n        let mut ctl = host.control();\n        let ctl_before = ctl;\n        let crash = host.shared.crashed.lock().unwrap().clone();\n        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n        let gfx = self.gfx.as_mut().unwrap();\n        let (render_scale, lights) =\n            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n        gfx.renderer.render_scale = render_scale;\n        gfx.renderer.max_shadow_lights = lights;\n        let info = ui::OverlayInfo {\n            fps: self.fps.fps,\n            frame_ms: self.fps.frame_ms,\n            tps: stats.tps,\n            tick_ms: stats.tick_ms,\n            tick: stats.tick,\n            entities: stats.entities,\n            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n            adapter: &gfx.adapter_name,\n            crash: crash.clone(),\n            paused: ctl.paused,\n            speed: ctl.speed,\n            rewinding,\n            render_scale,\n        };\n        if let Some(t) = self.boot_done_at {\n            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n                self.show_boot = false;\n                self.boot_done_at = None;\n            }\n        }\n        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n        let card_visible = !studio_active && self.hud.card_visible();\n        let guide_visible =\n            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n        let device = self.input.last_device;\n        let touch_ui = device == Device::Touch;\n        if touch_ui != self.touch_styled {\n            self.touch_styled = touch_ui;\n            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n        }\n        self.game_ui.touch = touch_ui;\n        self.game_ui.tree.touch = touch_ui;\n        self.touch.swipes.begin_frame();\n        let touch = &mut self.touch;\n        let auto_attack = self.prefs.auto_attack;\n        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n        let mut prefs = self.prefs.clone();\n        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n        let state = self.egui_state.as_mut().unwrap();\n        let mut raw = state.take(&gfx.window);\n        raw.events.append(&mut self.pad_events);\n        let pad_cursor = self.pad_cursor;\n        let mut show_boot = self.show_boot;\n        let menu_open = self.menu_open;\n        let scene_name = self.scene_name.clone();\n        let mut menu_action = None;\n        let mut panel_actions = Vec::new();\n        let mut teleport = None;\n        let mut save_room = false;\n        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n        let editor = &mut self.editor;\n        let hud = &mut self.hud;\n        let config_before = self.sim_config.clone();\n        let app_before = self.app_settings.clone();\n        let panel = &mut self.panel;\n        let master_before = self.audio_settings.master;\n        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n        let mut root = Root {\n            sim: &mut self.sim_config,\n            camera: &mut self.rig.params,\n            view: &mut self.view,\n            app: &mut self.app_settings,\n            audio: &mut self.audio_settings,\n        };\n        let show_stats = root.app.show_stats;\n        let feel = &mut self.feel;\n        let physics = &mut self.physics;\n        let latency = &self.latency;\n        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n        let game_frame = curr.game.clone();\n        let game_ui = &mut self.game_ui;\n        let look_ui = &mut self.look_ui;\n        let animation_ui = &mut self.animation_ui;\n        let asset_ui = &mut self.asset_ui;\n        let creature_ui = &mut self.creature_ui;\n        let studio_navigation = self.studio_navigation;\n        let mut creature_commands = Vec::new();\n        let mut animation_commands = Vec::new();\n        let mut asset_commands = Vec::new();\n        let mut studio_target = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n        #[cfg(target_arch = \"wasm32\")]\n        let animation_bridge: Option<&str> = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let creature_feedback =\n            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n        #[cfg(target_arch = \"wasm32\")]\n        let creature_feedback: Option<serde_json::Value> = None;\n        let mut look_msg = None;\n        let guide = &mut self.guide;\n        let mut guide_out = Vec::new();\n        let mut game_cmds = Vec::new();\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            let ctx = ui.ctx().clone();\n            if let Some(c) = &info.crash {\n                ui::crash_banner(ui, c);\n            }\n            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n            let free = ui.available_rect_before_wrap();\n            ui::boot_panel(&ctx, &mut show_boot);\n            if show_stats {\n                ui::stats_panel(&ctx, &info, free, touch_ui);\n            }\n            if guide_visible && !menu_open && !touch_ui {\n                ui::guide_panel(&ctx, device, game_frame.is_some());\n            }\n            if let Some(g) = &game_frame {\n                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n                if !menu_open {\n                    game_cmds = game_ui.ui(&ctx, g, &proj);\n                }\n            }\n            if touch_ui {\n                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n                if tips && !covered {\n                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n                }\n            }\n            if card_visible && !menu_open && hud.card(&ctx, device) {\n                guide.station = true;\n            }\n            if !menu_open {\n                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n            }\n            crate::hud::course_hud(&ctx, &hud_ctx);\n            pav_ui::game_lines(&ctx, hud_ctx.hud);\n            if let Some(p) = pad_cursor {\n                // The gamepad's menu cursor, above everything.\n                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n                let tip = egui::Pos2::new(p.x, p.y);\n                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n                painter.add(egui::Shape::convex_polygon(\n                    pts,\n                    egui::Color32::from_rgb(255, 225, 150),\n                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n                ));\n            }\n            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n            feel.ui(\n                &ctx,\n                &hud_ctx,\n                latency,\n                FeelSettings {\n                    model: &mut root.sim.movement.model,\n                    tick_rate: &mut root.sim.tick_rate,\n                    vsync: &mut root.app.vsync,\n                    smoothing: &mut root.app.smoothing,\n                },\n            );\n            teleport = hud.teleport_menu(&ctx);\n            hud.error_panel(&ctx);\n            if !studio_active {\n                save_room = editor.ui(&ctx, room_name.as_deref());\n            }\n            look_msg = look_ui.window(&ctx, root.view);\n            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n                egui::Window::new(\"Studio workspace\")\n                    .id(egui::Id::new(\"studio_navigation\"))\n                    .title_bar(false)\n                    .resizable(false)\n                    .fixed_pos([16.0, 8.0])\n                    .show(&ctx, |ui| {\n                        ui.horizontal(|ui| {\n                            ui.strong(\"SHARDFALL STUDIO\");\n                            for (mode, label) in [\n                                (StudioMode::Animation, \"Animations\"),\n                                (StudioMode::Prop, \"Objects\"),\n                                (StudioMode::Creature, \"Creatures\"),\n                                (StudioMode::World, \"Game\"),\n                            ] {\n                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n                                let reopen = match mode {\n                                    StudioMode::World => panel_open,\n                                    StudioMode::Animation => !animation_ui.open,\n                                    StudioMode::Prop => !asset_ui.open,\n                                    StudioMode::Creature => !creature_ui.open,\n                                };\n                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n                                    studio_target = Some(mode);\n                                }\n                            }\n                        });\n                    });\n            }\n            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n            }\n            let here = hud.current.clone();\n            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n            if menu_open {\n                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n                menu_action = if touch_ui {\n                    let show_fps = &mut root.app.show_stats;\n                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n                    ui::touch_menu(&ctx, &scene_name, m)\n                } else {\n                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n                };\n            }\n            if let Some(t) = &toast {\n                if touch_ui {\n                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n                } else {\n                    ui::toast(&ctx, t);\n                }\n            }\n            if !touch_ui {\n                const GAME_KEYS: &str =\n                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n                ui::hint_bar(\n                    &ctx,\n                    match (device, game_frame.is_some()) {\n                        (Device::Gamepad, _) => \"Start: menu\",\n                        (_, true) => GAME_KEYS,\n                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n                    },\n                );\n            }\n        });\n        if prefs != self.prefs {\n            self.prefs = prefs;\n            crate::save::save_prefs(&self.prefs);\n        }\n        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n        let sw = &mut self.touch.swipes;\n        if sw.take_tap(egui::Id::new(\"minimap\")) {\n            self.game_ui.map = true;\n        }\n        let big = egui::Id::new(\"big_map\");\n        if sw.take_tap(big) || sw.is_gone(big, 0) {\n            self.game_ui.map = false;\n            sw.restore(big);\n        }\n        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n            self.prefs.tips_seen = true;\n            crate::save::save_prefs(&self.prefs);\n        }\n        self.show_boot = show_boot;\n        for a in guide_out {\n            match a {\n                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n            }\n        }\n        if let Some(m) = look_msg {\n            self.toast = Some((m, Instant::now()));\n        }\n        self.look_ui.save_if_dirty(false);\n        for c in game_cmds {\n            host.shared.command(c);\n        }\n        if ctl.paused != ctl_before.paused\n            || ctl.speed != ctl_before.speed\n            || ctl.step_requests != ctl_before.step_requests\n            || ctl.rewind_speed != ctl_before.rewind_speed\n        {\n            let c = ctl;\n            host.set_control(|x| {\n                x.paused = c.paused;\n                x.speed = c.speed;\n                x.step_requests = c.step_requests;\n                x.rewind_speed = c.rewind_speed;\n            });\n        }\n        if self.sim_config != config_before {\n            let cfg = self.sim_config.clone();\n            host.exec(move |sim| sim.config = cfg);\n            self.config_push_tick = stats.tick.max(curr.tick);\n        }\n        if self.app_settings.vsync != app_before.vsync {\n            gfx.set_vsync(self.app_settings.vsync);\n        }\n        if self.audio_settings.master != master_before {\n            if let Some(a) = &self.audio {\n                a.set_master(self.audio_settings.master);\n            }\n        }\n        state.platform_output(&gfx.window, out.platform_output);\n        let ppp = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n        let mut textures = out.textures_delta;\n\n        #[cfg(target_arch = \"wasm32\")]\n        if self.screenshot_requested {\n            // Reading pixels back waits on the GPU, which the browser does not allow here.\n            self.screenshot_requested = false;\n            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if self.screenshot_requested {\n            self.screenshot_requested = false;\n            let (w, h) = gfx.size();\n            let dir = boot::exe_dir().join(\"screenshots\");\n            let path = dir.join(format!(\n                \"shardfall-{}.png\",\n                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n            ));\n            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n            self.toast = Some((\n                match r {\n                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n                },\n                Instant::now(),\n            ));\n        }\n\n        let first = self.boot_done_at.is_none()\n            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n        let submitted = if first {\n            let submitted = stage(\"first frame\", || {\n                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n            });\n            self.boot_done_at = Some(Instant::now());\n            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n            submitted.unwrap_or(false)\n        } else {\n            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n        };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if submitted {\n            if let Some(bridge) = &self.bridge {\n                bridge.submitted(curr.live_edit_ticket);\n            }\n        }\n        // Input latency: the frame showing the tick that consumed a press is now submitted.\n        if submitted {\n            let mut probe = host.shared.latency_probe.lock().unwrap();\n            if let Some((pressed_at, ticked_at, tick)) = *probe {\n                if curr.tick >= tick {\n                    let now = Instant::now();\n                    self.latency.record(LatencySample {\n                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n                    });\n                    *probe = None;\n                }\n            }\n        }\n\n        for a in panel_actions {\n            self.panel_action(a);\n        }\n        if let Some(t) = teleport {\n            self.teleport(t);\n        }\n        if save_room {\n            if let (Some(host), Some(id)) = (&self.host, room_id) {\n                let msg = match crate::edit::save_room(host, id) {\n                    Ok(p) => format!(\"saved {}\", p.display()),\n                    Err(e) => format!(\"save failed: {e:#}\"),\n                };\n                self.editor.status = msg.clone();\n                self.toast(msg);\n                if self.watcher.is_none() {\n                    self.watcher = RoomWatcher::start();\n                }\n            }\n        }\n        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n            self.reload_rooms();\n        }\n        if studio_active {\n            self.ensure_animation_watcher();\n        }\n        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n        for update in animation_updates {\n            match update {\n                Ok(message) => {\n                    log::info!(\"{message}\");\n                    self.animation_ui.status = message;\n                    self.animation_ui.error = false;\n                }\n                Err(error) => {\n                    log::warn!(\"animation reload: {error}\");\n                    self.animation_ui.report(Err(error));\n                }\n            }\n        }\n        for command in animation_commands {\n            self.studio_command(command);\n        }\n        for command in asset_commands {\n            self.studio_command(command);\n        }\n        for command in creature_commands {\n            self.studio_command(command);\n        }\n        for result in self.creature_watcher.poll() {\n            self.creature_ui.report(result);\n        }\n        self.poll_creature_updates();\n        for update in self.asset_watcher.poll() {\n            match update {\n                Ok((name, definition)) => {\n                    self.asset_ui.status = format!(\"Reloaded {name}\");\n                    self.asset_ui.error = false;\n                    #[cfg(not(target_arch = \"wasm32\"))]\n                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n                    #[cfg(target_arch = \"wasm32\")]\n                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n                    if let Some(host) = &self.host {\n                        let _ticket = host.query(move |sim| {\n                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n                                return None;\n                            }\n                            if let Some(feedback) = feedback {\n                                if let Ok(mut feedback) = feedback.lock() {\n                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n                                }\n                            }\n                            Some(sim.live_edit_ticket)\n                        });\n                        #[cfg(not(target_arch = \"wasm32\"))]\n                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n                            bridge.adopted(ticket);\n                        }\n                    }\n                }\n                Err(error) => {\n                    log::warn!(\"object reload: {error}\");\n                    self.asset_ui.report(Err(error));\n                }\n            }\n        }\n        if let Some(mode) = studio_target {\n            self.switch_studio(mode);\n        }\n        if let Some(a) = menu_action {\n            self.menu_action(a);\n        }\n        // Touch: the bag, the menu, the map button, and taps on the open game.\n        for c in &intent.ui {\n            match c {\n                crate::touch::Control::Bag => {\n                    let ui = &mut self.game_ui;\n                    if ui.any_open() {\n                        ui.close_all();\n                    } else {\n                        ui.inventory = true;\n                    }\n                }\n                crate::touch::Control::Menu => {\n                    let open = !self.menu_open;\n                    self.set_menu(open);\n                }\n                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n                _ => {}\n            }\n        }\n        if intent.world_tap {\n            self.close_on_tap();\n        }\n    }\n\n    fn panel_action(&mut self, a: PanelAction) {\n        let Some(host) = &self.host else { return };\n        let dir = boot::exe_dir();\n        match a {\n            PanelAction::Reset => self.reset(),\n            PanelAction::Scrub(t) => host.set_control(|c| {\n                c.paused = true;\n                c.scrub = Some(t);\n            }),\n            PanelAction::SaveSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n                    None => self.toast(\"snapshot timed out\"),\n                }\n            }\n            PanelAction::LoadSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.load_state(&path));\n                match r {\n                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n                    None => self.toast(\"load timed out\"),\n                }\n            }\n            PanelAction::SaveReplay => {\n                let path = dir.join(\"replays\").join(\"last.replay.json\");\n                let r = host.query(move |sim| -> Result<String> {\n                    let mut rep = sim.recording.clone();\n                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n                    std::fs::create_dir_all(path.parent().unwrap())?;\n                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n                    Ok(path.display().to_string())\n                });\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n                    None => self.toast(\"replay timed out\"),\n                }\n            }\n            PanelAction::Look => self.look_ui.open = true,\n            PanelAction::Status(s) => {\n                self.panel.status(s.clone());\n                self.toast(s);\n            }\n        }\n    }\n\n    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n    /// persistence identical for a user and an LLM.\n    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n        let Some(host) = &self.host else { return };\n        let asset = command.tool.starts_with(\"asset\");\n        let creature = command.tool.starts_with(\"creature\");\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(error) => {\n                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n                    if creature {\n                        self.creature_ui.report(Err(message));\n                    } else if asset {\n                        self.asset_ui.report(Err(message));\n                    } else {\n                        self.animation_ui.report(Err(message));\n                    }\n                    return;\n                }\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        let reply = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n                .map(|out| match out {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|e| format!(\"{e:#}\"));\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (result, rig, view, ticket)\n        });\n        let result = match reply {\n            Some((result, rig, view, _ticket)) => {\n                self.rig = rig;\n                self.view = view;\n                #[cfg(not(target_arch = \"wasm32\"))]\n                if let Some(bridge) = &self.bridge {\n                    bridge.adopted(_ticket);\n                }\n                result\n            }\n            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n        };\n        if creature {\n            self.creature_ui.report_command(result);\n        } else if asset {\n            self.asset_ui.report(result);\n        } else {\n            self.animation_ui.report(result);\n        }\n        self.ensure_animation_watcher();\n    }\n\n    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n    fn poll_creature_updates(&mut self) {\n        if !pav_tools::creature_tools::has_updates() {\n            return;\n        }\n        let Some(host) = &self.host else { return };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(_) => return,\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let reports = pav_tools::creature_tools::poll(&mut session);\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (reports, rig, view, ticket)\n        }) {\n            self.rig = rig;\n            self.view = view;\n            #[cfg(not(target_arch = \"wasm32\"))]\n            if let Some(bridge) = &self.bridge {\n                bridge.adopted(ticket);\n            }\n            #[cfg(target_arch = \"wasm32\")]\n            let _ = ticket;\n            for report in reports {\n                self.creature_ui.report(Ok(report));\n            }\n        }\n    }\n\n    fn switch_studio(&mut self, mode: StudioMode) {\n        self.studio_navigation = true;\n        self.set_menu(false);\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if mode != StudioMode::World {\n            if mode == StudioMode::Animation {\n                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n                }\n            }\n            if self.bridge.is_none() {\n                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n                    Ok(bridge) => self.bridge = Some(bridge),\n                    Err(error) => {\n                        let message = format!(\"Could not open the live bridge: {error}\");\n                        if mode == StudioMode::Creature {\n                            self.creature_ui.report(Err(message));\n                        } else if mode == StudioMode::Prop {\n                            self.asset_ui.report(Err(message));\n                        } else {\n                            self.animation_ui.report(Err(message));\n                        }\n                    }\n                }\n            }\n        }\n        self.animation_ui.open = mode == StudioMode::Animation;\n        self.asset_ui.open = mode == StudioMode::Prop;\n        self.creature_ui.open = mode == StudioMode::Creature;\n        let tool = match mode {\n            StudioMode::Animation => \"anim_preview\",\n            StudioMode::Prop => \"asset_preview\",\n            StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n            StudioMode::World => \"anim_preview\",\n        };\n        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n        self.studio_command(crate::animation_ui::Command {\n            tool,\n            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n        });\n    }\n\n    fn ensure_animation_watcher(&mut self) {\n        // An agent may create the first animation directory through the bridge. Attach\n        // then, but do not retry a failed native watcher on every frame.\n        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n            self.animation_watch_attempted = true;\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n    }\n\n    fn menu_action(&mut self, a: MenuAction) {\n        match a {\n            MenuAction::Resume => self.set_menu(false),\n            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n            MenuAction::Reset => {\n                self.set_menu(false);\n                self.reset();\n            }\n            MenuAction::LoadScene(name) => {\n                self.set_menu(false);\n                self.load_scene(&name);\n            }\n            MenuAction::NewHero => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n                    host.exec(move |sim| {\n                        crate::save::erase();\n                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n                            fresh.config = cfg;\n                            *sim = fresh;\n                        }\n                    });\n                }\n                self.scene_name = \"town\".into();\n                self.toast(\"a new hero arrives in Emberwatch\");\n            }\n            MenuAction::Tuning => {\n                self.set_menu(false);\n                self.panel.open = true;\n            }\n            MenuAction::Look => {\n                self.set_menu(false);\n                self.look_ui.open = true;\n            }\n            MenuAction::Guide => {\n                self.set_menu(false);\n                if self.hud.current.is_some() {\n                    self.guide.station = true;\n                } else {\n                    self.guide.field = true;\n                }\n            }\n            MenuAction::FieldGuide => {\n                self.set_menu(false);\n                self.guide.field = true;\n            }\n            MenuAction::Rooms => {\n                self.set_menu(false);\n                self.open_teleport();\n            }\n            MenuAction::RoomCard => {\n                self.set_menu(false);\n                self.hud.show_card();\n            }\n            MenuAction::Screenshot => {\n                self.set_menu(false);\n                self.screenshot_requested = true;\n            }\n            MenuAction::Feel => {\n                self.set_menu(false);\n                self.feel.open = !self.feel.open;\n                self.feel.auto = false;\n            }\n            MenuAction::Physics => {\n                self.set_menu(false);\n                self.physics.open = !self.physics.open;\n                self.physics.auto = false;\n            }\n            MenuAction::Quit => {\n                self.look_ui.save_if_dirty(true);\n                self.quit = true;\n            }\n            MenuAction::TownPortal => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                }\n            }\n            MenuAction::Fullscreen => {\n                if let Some(g) = &self.gfx {\n                    crate::platform::toggle_fullscreen(&g.window);\n                }\n            }\n        }\n    }\n}\n\nimpl App {\n    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {\n        if !self.audio_resumed {\n            self.audio_resumed = true;\n            if let Some(a) = &self.audio {\n                a.resume();\n            }\n        }\n    }\n\n    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);\n        self.fatal = Some(msg);\n        el.exit();\n    }\n}\n\nimpl ApplicationHandler for App {\n    fn resumed(&mut self, el: &ActiveEventLoop) {\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\n                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n                        self.handle_key(code);\n                        if !system && !consumed {\n                            self.latency.press();\n                        }\n                    }\n                    if !consumed || event.state == ElementState::Released {\n                        self.input.key(code, event.state);\n                    }\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n                    self.latency.press();\n                }\n                // In the game the right button is a skill; the middle button turns the camera.\n                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if button == turn {\n                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n                } else if !consumed || state == ElementState::Released {\n                    self.input.mouse_button(button, state);\n                }\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                if self.mouse.right_down {\n                    let d = p - self.mouse.pos;\n                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n                }\n                if (p - self.mouse.pos).length() > 2.0 {\n                    self.input.last_device = Device::KeyboardMouse;\n                }\n                self.mouse.pos = p;\n                self.input.cursor = p;\n            }\n            _ => {}\n        }\n    }\n\n    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n        #[cfg(target_arch = \"wasm32\")]\n        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n            self.pending_gfx = None;\n            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n                self.fail(el, e);\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let _ = el;\n        if let Some(g) = &self.gfx {\n            g.window.request_redraw();\n        }\n    }\n}\n\nfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n    let mut v: Vec<RoomEntry> = sim\n        .state\n        .world\n        .rooms\n        .iter()\n        .map(|r| RoomEntry {\n            key: r.key.clone(),\n            name: if r.def.name.is_empty() { r.key.clone() } else { r.def.name.clone() },\n            wing: r.def.wing.clone(),\n            about: r.def.about.clone(),\n            ask: r.def.learn.ask.clone(),\n        })\n        .collect();\n    v.sort_by(|a, b| (&a.wing, &a.name).cmp(&(&b.wing, &b.name)));\n    v\n}\n","numLines":1568,"startLine":700,"totalLines":2267}},"tool_result_meta":[{"id":"toolu_01VkeY1qDQDwHPVZ47HYvt6H","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjs74XpcuWXhWxybgqAu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01V8eEK5j2kvSVCbysHptCEC","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/simhost.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":32944,"cache_read_input_tokens":92434,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":32944},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"c3ea27c2-f98c-4a6a-adbb-d8491737ee17","timestamp":"2026-11-05T13:31:59.499Z","request_id":"req_011Cgjs74EDK2yA1Cq8sfruD","wire_tool_inputs":{"toolu_01V8eEK5j2kvSVCbysHptCEC":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/simhost.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8eEK5j2kvSVCbysHptCEC","type":"tool_result","content":"1\t//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n2\t//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n3\t//! two most recent frames and interpolates between them.\n4\t\n5\tuse std::sync::{Arc, Mutex};\n6\tuse std::time::Duration;\n7\t\n8\tuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\n9\tuse web_time::Instant;\n10\t\n11\t#[cfg(not(target_arch = \"wasm32\"))]\n12\ttype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n13\t\n14\t#[cfg(not(target_arch = \"wasm32\"))]\n15\tenum Cmd {\n16\t    Run(Job),\n17\t    Quit,\n18\t}\n19\t\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct TimeControl {\n22\t    pub paused: bool,\n23\t    /// Simulation speed multiplier (0.05 .. 8).\n24\t    pub speed: f32,\n25\t    /// Ticks to advance while paused.\n26\t    pub step_requests: u32,\n27\t    /// Holding the rewind button.\n28\t    pub rewinding: bool,\n29\t    /// Ticks travelled back per tick while rewinding.\n30\t    pub rewind_speed: u32,\n31\t    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n32\t    pub scrub: Option<u64>,\n33\t}\n34\t\n35\timpl Default for TimeControl {\n36\t    fn default() -> Self {\n37\t        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n38\t    }\n39\t}\n40\t\n41\t#[derive(Clone, Copy, Debug, Default)]\n42\tpub struct SimStats {\n43\t    /// Measured ticks per second of wall time.\n44\t    pub tps: f32,\n45\t    /// Average CPU time per tick (ms).\n46\t    pub tick_ms: f32,\n47\t    pub tick: u64,\n48\t    pub entities: usize,\n49\t    /// Rewind range available (ticks).\n50\t    pub oldest: u64,\n51\t    pub newest: u64,\n52\t    pub history_mb: f32,\n53\t    pub rewound: bool,\n54\t}\n55\t\n56\tpub struct FramePair {\n57\t    pub prev: Arc<RenderFrame>,\n58\t    pub curr: Arc<RenderFrame>,\n59\t    /// When `curr` became current (wall clock).\n60\t    pub curr_at: Instant,\n61\t    /// Wall-clock length of one tick at the current speed.\n62\t    pub tick_wall: f32,\n63\t}\n64\t\n65\tpub struct Shared {\n66\t    pub frames: Mutex<FramePair>,\n67\t    pub input: Mutex<InputFrame>,\n68\t    pub control: Mutex<TimeControl>,\n69\t    pub stats: Mutex<SimStats>,\n70\t    pub crashed: Mutex<Option<String>>,\n71\t    /// Events for sound and effects, drained by the render thread.\n72\t    pub events: Mutex<Vec<SimEvent>>,\n73\t    /// When the input that is waiting for the next tick was pressed (latency measurement).\n74\t    pub input_stamp: Mutex<Option<Instant>>,\n75\t    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n76\t    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n77\t    /// Menu commands waiting for a tick (one rides along with each tick's input).\n78\t    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n79\t}\n80\t\n81\timpl Shared {\n82\t    /// Queues a game command for the next free tick.\n83\t    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n84\t        let mut q = self.cmds.lock().unwrap();\n85\t        if q.len() < 64 {\n86\t            q.push_back(c);\n87\t        }\n88\t    }\n89\t}\n90\t\n91\t#[cfg(not(target_arch = \"wasm32\"))]\n92\tpub struct SimHost {\n93\t    tx: std::sync::mpsc::Sender<Cmd>,\n94\t    pub shared: Arc<Shared>,\n95\t    thread: Option<std::thread::JoinHandle<()>>,\n96\t}\n97\t\n98\t/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n99\t#[cfg(target_arch = \"wasm32\")]\n100\tpub struct SimHost {\n101\t    sim: std::cell::RefCell<Sim>,\n102\t    clock: std::cell::RefCell<Clock>,\n103\t    pub shared: Arc<Shared>,\n104\t}\n105\t\n106\tfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n107\t    let f = Arc::new(sim.frame());\n108\t    Arc::new(Shared {\n109\t        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n110\t        input: Mutex::new(InputFrame::default()),\n111\t        control: Mutex::new(TimeControl::default()),\n112\t        stats: Mutex::new(SimStats::default()),\n113\t        crashed: Mutex::new(None),\n114\t        events: Mutex::new(Vec::new()),\n115\t        input_stamp: Mutex::new(None),\n116\t        latency_probe: Mutex::new(None),\n117\t        cmds: Mutex::new(Default::default()),\n118\t    })\n119\t}\n120\t\n121\t#[cfg(not(target_arch = \"wasm32\"))]\n122\timpl SimHost {\n123\t    pub fn start(mut sim: Sim) -> Self {\n124\t        let shared = shared_for(&mut sim);\n125\t        let (tx, rx) = std::sync::mpsc::channel();\n126\t        let sh = shared.clone();\n127\t        let thread = std::thread::Builder::new()\n128\t            .name(\"simulation\".into())\n129\t            .spawn(move || {\n130\t                let sh2 = sh.clone();\n131\t                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n132\t                if let Err(e) = r {\n133\t                    let msg = e\n134\t                        .downcast_ref::<&str>()\n135\t                        .map(|s| s.to_string())\n136\t                        .or_else(|| e.downcast_ref::<String>().cloned())\n137\t                        .unwrap_or_else(|| \"unknown panic\".into());\n138\t                    *sh.crashed.lock().unwrap() = Some(msg);\n139\t                }\n140\t            })\n141\t            .expect(\"spawn simulation thread\");\n142\t        Self { tx, shared, thread: Some(thread) }\n143\t    }\n144\t\n145\t    /// Runs `f` on the simulation thread (fire and forget).\n146\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n147\t        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n148\t    }\n149\t\n150\t    /// Runs `f` on the simulation thread and waits for its result.\n151\t    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n152\t        let (rtx, rrx) = std::sync::mpsc::channel();\n153\t        self.exec(move |sim| {\n154\t            let _ = rtx.send(f(sim));\n155\t        });\n156\t        rrx.recv_timeout(Duration::from_secs(5)).ok()\n157\t    }\n158\t\n159\t    /// Advances the simulation (the thread does this by itself natively).\n160\t    pub fn pump(&self) {}\n161\t}\n162\t\n163\t#[cfg(target_arch = \"wasm32\")]\n164\timpl SimHost {\n165\t    pub fn start(mut sim: Sim) -> Self {\n166\t        let shared = shared_for(&mut sim);\n167\t        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n168\t    }\n169\t\n170\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n171\t        let mut sim = self.sim.borrow_mut();\n172\t        f(&mut sim);\n173\t        let dt = sim.dt();\n174\t        publish(&mut sim, &self.shared, dt, Instant::now());\n175\t    }\n176\t\n177\t    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n178\t        let mut sim = self.sim.borrow_mut();\n179\t        let r = f(&mut sim);\n180\t        let dt = sim.dt();\n181\t        publish(&mut sim, &self.shared, dt, Instant::now());\n182\t        Some(r)\n183\t    }\n184\t\n185\t    /// Runs the ticks that are due (called once per frame).\n186\t    pub fn pump(&self) {\n187\t        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n188\t    }\n189\t}\n190\t\n191\timpl SimHost {\n192\t    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n193\t        let f = self.shared.frames.lock().unwrap();\n194\t        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n195\t    }\n196\t\n197\t    pub fn control(&self) -> TimeControl {\n198\t        *self.shared.control.lock().unwrap()\n199\t    }\n200\t\n201\t    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n202\t        f(&mut self.shared.control.lock().unwrap());\n203\t    }\n204\t}\n205\t\n206\t#[cfg(not(target_arch = \"wasm32\"))]\n207\timpl Drop for SimHost {\n208\t    fn drop(&mut self) {\n209\t        let _ = self.tx.send(Cmd::Quit);\n210\t        if let Some(t) = self.thread.take() {\n211\t            let _ = t.join();\n212\t        }\n213\t    }\n214\t}\n215\t\n216\tfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n217\t    let events = sim.drain_events();\n218\t    if !events.is_empty() {\n219\t        let mut q = sh.events.lock().unwrap();\n220\t        q.extend(events);\n221\t        let n = q.len();\n222\t        if n > 512 {\n223\t            q.drain(..n - 512);\n224\t        }\n225\t    }\n226\t    let frame = Arc::new(sim.frame());\n227\t    let mut f = sh.frames.lock().unwrap();\n228\t    f.prev = std::mem::replace(&mut f.curr, frame);\n229\t    f.curr_at = at;\n230\t    f.tick_wall = tick_wall;\n231\t}\n232\t\n233\t/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\n234\tstruct Clock {\n235\t    next: Instant,\n236\t    window_start: Instant,\n237\t    window_ticks: u32,\n238\t    busy: Duration,\n239\t    rewound: bool,\n240\t    studio_mode: pav_core::prop_preview::StudioMode,\n241\t}\n242\t\n243\timpl Clock {\n244\t    fn new() -> Self {\n245\t        Self {\n246\t            next: Instant::now(),\n247\t            window_start: Instant::now(),\n248\t            window_ticks: 0,\n249\t            busy: Duration::ZERO,\n250\t            rewound: false,\n251\t            studio_mode: pav_core::prop_preview::StudioMode::World,\n252\t        }\n253\t    }\n254\t\n255\t    /// Runs whatever is due now; returns how long until the next tick.\n256\t    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n257\t        let previewing = sim.studio_active();\n258\t        let mode = sim.studio_mode();\n259\t        if self.studio_mode != mode {\n260\t            self.studio_mode = mode;\n261\t            self.next = Instant::now();\n262\t        }\n263\t        let ctl = *sh.control.lock().unwrap();\n264\t        // The animation stage has its own play, pause and speed controls. The world's time\n265\t        // controls stay untouched, including a paused or rewound game behind the stage.\n266\t        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n267\t        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n268\t        let mut tick_once = |sim: &mut Sim, at: Instant| {\n269\t            let input = if previewing {\n270\t                InputFrame::default()\n271\t            } else {\n272\t                let mut i = sh.input.lock().unwrap();\n273\t                let mut frame = *i;\n274\t                i.pressed = 0;\n275\t                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n276\t                frame\n277\t            };\n278\t            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n279\t            let t = Instant::now();\n280\t            sim.step(&input);\n281\t            *busy += t.elapsed();\n282\t            if let Some(s) = stamp {\n283\t                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n284\t            }\n285\t            *window_ticks += 1;\n286\t            publish(sim, sh, tick_wall, at);\n287\t        };\n288\t\n289\t        let now = Instant::now();\n290\t        if previewing {\n291\t            let mut n = 0;\n292\t            while now >= self.next && n < 8 {\n293\t                self.next += Duration::from_secs_f32(tick_wall);\n294\t                tick_once(sim, self.next);\n295\t                n += 1;\n296\t            }\n297\t            if n == 8 && now > self.next {\n298\t                self.next = now;\n299\t            }\n300\t        } else if ctl.rewinding {\n301\t            if now >= self.next {\n302\t                self.next = now + Duration::from_secs_f32(sim.dt());\n303\t                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n304\t                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n305\t                if target < sim.state.tick && sim.rewind_to(target) {\n306\t                    self.rewound = true;\n307\t                }\n308\t                let dt = sim.dt();\n309\t                publish(sim, sh, dt, now);\n310\t            }\n311\t        } else if let Some(t) = ctl.scrub {\n312\t            sh.control.lock().unwrap().scrub = None;\n313\t            if sim.rewind_to(t) {\n314\t                self.rewound = true;\n315\t            }\n316\t            let dt = sim.dt();\n317\t            publish(sim, sh, dt, now);\n318\t            self.next = now;\n319\t        } else if ctl.paused {\n320\t            if ctl.step_requests > 0 {\n321\t                sh.control.lock().unwrap().step_requests -= 1;\n322\t                if self.rewound {\n323\t                    sim.commit_rewind();\n324\t                    self.rewound = false;\n325\t                }\n326\t                tick_once(sim, now);\n327\t            }\n328\t            self.next = now;\n329\t        } else {\n330\t            if self.rewound {\n331\t                // Acting after a rewind starts a new timeline.\n332\t                sim.commit_rewind();\n333\t                self.rewound = false;\n334\t                self.next = now;\n335\t            }\n336\t            let mut n = 0;\n337\t            while now >= self.next && n < 8 {\n338\t                self.next += Duration::from_secs_f32(tick_wall);\n339\t                tick_once(sim, self.next);\n340\t                n += 1;\n341\t            }\n342\t            if n == 8 && now > self.next {\n343\t                self.next = now; // too far behind: drop time instead of spiralling\n344\t            }\n345\t        }\n346\t\n347\t        let elapsed = self.window_start.elapsed();\n348\t        if elapsed >= Duration::from_millis(500) {\n349\t            let mut s = sh.stats.lock().unwrap();\n350\t            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n351\t            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n352\t            s.tick = sim.state.tick;\n353\t            s.entities = sim.state.entities.len();\n354\t            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n355\t            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n356\t            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n357\t            s.rewound = self.rewound;\n358\t            self.window_start = Instant::now();\n359\t            self.window_ticks = 0;\n360\t            self.busy = Duration::ZERO;\n361\t        }\n362\t        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n363\t    }\n364\t}\n365\t\n366\t#[cfg(not(target_arch = \"wasm32\"))]\n367\tfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n368\t    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n369\t    let mut clock = Clock::new();\n370\t    loop {\n371\t        // Commands first.\n372\t        loop {\n373\t            match rx.try_recv() {\n374\t                Ok(Cmd::Run(job)) => {\n375\t                    job(&mut sim);\n376\t                    let dt = sim.dt();\n377\t                    publish(&mut sim, &sh, dt, Instant::now());\n378\t                }\n379\t                Ok(Cmd::Quit) => return,\n380\t                Err(TryRecvError::Empty) => break,\n381\t                Err(TryRecvError::Disconnected) => return,\n382\t            }\n383\t        }\n384\t        let wait = clock.advance(&mut sim, &sh);\n385\t        match rx.recv_timeout(wait) {\n386\t            Ok(Cmd::Run(job)) => {\n387\t                job(&mut sim);\n388\t                let dt = sim.dt();\n389\t                publish(&mut sim, &sh, dt, Instant::now());\n390\t            }\n391\t            Ok(Cmd::Quit) => return,\n392\t            Err(RecvTimeoutError::Timeout) => {}\n393\t            Err(RecvTimeoutError::Disconnected) => return,\n394\t        }\n395\t    }\n396\t}\n397\t\n398\t#[cfg(test)]\n399\tmod tests {\n400\t    use super::*;\n401\t\n402\t    #[test]\n403\t    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n404\t        let mut sim = Sim::empty(1);\n405\t        let shared = shared_for(&mut sim);\n406\t        {\n407\t            let mut control = shared.control.lock().unwrap();\n408\t            control.paused = true;\n409\t            control.speed = 8.0;\n410\t        }\n411\t        let mut clock = Clock::new();\n412\t        clock.rewound = true;\n413\t        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n414\t        clock.advance(&mut sim, &shared);\n415\t        let time = sim.preview_info().unwrap().time;\n416\t        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n417\t        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n418\t        assert_eq!(sim.state.tick, 0);\n419\t        let control = *shared.control.lock().unwrap();\n420\t        assert!(control.paused);\n421\t        assert_eq!(control.speed, 8.0);\n422\t        sim.preview_close();\n423\t        clock.advance(&mut sim, &shared);\n424\t        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n425\t        assert!(clock.rewound);\n426\t    }\n427\t}\n428\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"d98e65bb-f3da-4668-8e1d-5ee921faf4b6","timestamp":"2026-11-05T13:31:59.545Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/simhost.rs","content":"//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n//! two most recent frames and interpolates between them.\n\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\nuse web_time::Instant;\n\n#[cfg(not(target_arch = \"wasm32\"))]\ntype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n\n#[cfg(not(target_arch = \"wasm32\"))]\nenum Cmd {\n    Run(Job),\n    Quit,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct TimeControl {\n    pub paused: bool,\n    /// Simulation speed multiplier (0.05 .. 8).\n    pub speed: f32,\n    /// Ticks to advance while paused.\n    pub step_requests: u32,\n    /// Holding the rewind button.\n    pub rewinding: bool,\n    /// Ticks travelled back per tick while rewinding.\n    pub rewind_speed: u32,\n    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n    pub scrub: Option<u64>,\n}\n\nimpl Default for TimeControl {\n    fn default() -> Self {\n        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default)]\npub struct SimStats {\n    /// Measured ticks per second of wall time.\n    pub tps: f32,\n    /// Average CPU time per tick (ms).\n    pub tick_ms: f32,\n    pub tick: u64,\n    pub entities: usize,\n    /// Rewind range available (ticks).\n    pub oldest: u64,\n    pub newest: u64,\n    pub history_mb: f32,\n    pub rewound: bool,\n}\n\npub struct FramePair {\n    pub prev: Arc<RenderFrame>,\n    pub curr: Arc<RenderFrame>,\n    /// When `curr` became current (wall clock).\n    pub curr_at: Instant,\n    /// Wall-clock length of one tick at the current speed.\n    pub tick_wall: f32,\n}\n\npub struct Shared {\n    pub frames: Mutex<FramePair>,\n    pub input: Mutex<InputFrame>,\n    pub control: Mutex<TimeControl>,\n    pub stats: Mutex<SimStats>,\n    pub crashed: Mutex<Option<String>>,\n    /// Events for sound and effects, drained by the render thread.\n    pub events: Mutex<Vec<SimEvent>>,\n    /// When the input that is waiting for the next tick was pressed (latency measurement).\n    pub input_stamp: Mutex<Option<Instant>>,\n    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n    /// Menu commands waiting for a tick (one rides along with each tick's input).\n    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n}\n\nimpl Shared {\n    /// Queues a game command for the next free tick.\n    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n        let mut q = self.cmds.lock().unwrap();\n        if q.len() < 64 {\n            q.push_back(c);\n        }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub struct SimHost {\n    tx: std::sync::mpsc::Sender<Cmd>,\n    pub shared: Arc<Shared>,\n    thread: Option<std::thread::JoinHandle<()>>,\n}\n\n/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n#[cfg(target_arch = \"wasm32\")]\npub struct SimHost {\n    sim: std::cell::RefCell<Sim>,\n    clock: std::cell::RefCell<Clock>,\n    pub shared: Arc<Shared>,\n}\n\nfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n    let f = Arc::new(sim.frame());\n    Arc::new(Shared {\n        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n        input: Mutex::new(InputFrame::default()),\n        control: Mutex::new(TimeControl::default()),\n        stats: Mutex::new(SimStats::default()),\n        crashed: Mutex::new(None),\n        events: Mutex::new(Vec::new()),\n        input_stamp: Mutex::new(None),\n        latency_probe: Mutex::new(None),\n        cmds: Mutex::new(Default::default()),\n    })\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        let (tx, rx) = std::sync::mpsc::channel();\n        let sh = shared.clone();\n        let thread = std::thread::Builder::new()\n            .name(\"simulation\".into())\n            .spawn(move || {\n                let sh2 = sh.clone();\n                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n                if let Err(e) = r {\n                    let msg = e\n                        .downcast_ref::<&str>()\n                        .map(|s| s.to_string())\n                        .or_else(|| e.downcast_ref::<String>().cloned())\n                        .unwrap_or_else(|| \"unknown panic\".into());\n                    *sh.crashed.lock().unwrap() = Some(msg);\n                }\n            })\n            .expect(\"spawn simulation thread\");\n        Self { tx, shared, thread: Some(thread) }\n    }\n\n    /// Runs `f` on the simulation thread (fire and forget).\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n    }\n\n    /// Runs `f` on the simulation thread and waits for its result.\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n        let (rtx, rrx) = std::sync::mpsc::channel();\n        self.exec(move |sim| {\n            let _ = rtx.send(f(sim));\n        });\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\n    }\n\n    /// Advances the simulation (the thread does this by itself natively).\n    pub fn pump(&self) {}\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n    }\n\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n        let mut sim = self.sim.borrow_mut();\n        f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n    }\n\n    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n        let mut sim = self.sim.borrow_mut();\n        let r = f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n        Some(r)\n    }\n\n    /// Runs the ticks that are due (called once per frame).\n    pub fn pump(&self) {\n        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n    }\n}\n\nimpl SimHost {\n    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n        let f = self.shared.frames.lock().unwrap();\n        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n    }\n\n    pub fn control(&self) -> TimeControl {\n        *self.shared.control.lock().unwrap()\n    }\n\n    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n        f(&mut self.shared.control.lock().unwrap());\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl Drop for SimHost {\n    fn drop(&mut self) {\n        let _ = self.tx.send(Cmd::Quit);\n        if let Some(t) = self.thread.take() {\n            let _ = t.join();\n        }\n    }\n}\n\nfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n    let events = sim.drain_events();\n    if !events.is_empty() {\n        let mut q = sh.events.lock().unwrap();\n        q.extend(events);\n        let n = q.len();\n        if n > 512 {\n            q.drain(..n - 512);\n        }\n    }\n    let frame = Arc::new(sim.frame());\n    let mut f = sh.frames.lock().unwrap();\n    f.prev = std::mem::replace(&mut f.curr, frame);\n    f.curr_at = at;\n    f.tick_wall = tick_wall;\n}\n\n/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\nstruct Clock {\n    next: Instant,\n    window_start: Instant,\n    window_ticks: u32,\n    busy: Duration,\n    rewound: bool,\n    studio_mode: pav_core::prop_preview::StudioMode,\n}\n\nimpl Clock {\n    fn new() -> Self {\n        Self {\n            next: Instant::now(),\n            window_start: Instant::now(),\n            window_ticks: 0,\n            busy: Duration::ZERO,\n            rewound: false,\n            studio_mode: pav_core::prop_preview::StudioMode::World,\n        }\n    }\n\n    /// Runs whatever is due now; returns how long until the next tick.\n    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n        let previewing = sim.studio_active();\n        let mode = sim.studio_mode();\n        if self.studio_mode != mode {\n            self.studio_mode = mode;\n            self.next = Instant::now();\n        }\n        let ctl = *sh.control.lock().unwrap();\n        // The animation stage has its own play, pause and speed controls. The world's time\n        // controls stay untouched, including a paused or rewound game behind the stage.\n        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n        let mut tick_once = |sim: &mut Sim, at: Instant| {\n            let input = if previewing {\n                InputFrame::default()\n            } else {\n                let mut i = sh.input.lock().unwrap();\n                let mut frame = *i;\n                i.pressed = 0;\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame\n            };\n            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n            let t = Instant::now();\n            sim.step(&input);\n            *busy += t.elapsed();\n            if let Some(s) = stamp {\n                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n            }\n            *window_ticks += 1;\n            publish(sim, sh, tick_wall, at);\n        };\n\n        let now = Instant::now();\n        if previewing {\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now;\n            }\n        } else if ctl.rewinding {\n            if now >= self.next {\n                self.next = now + Duration::from_secs_f32(sim.dt());\n                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n                if target < sim.state.tick && sim.rewind_to(target) {\n                    self.rewound = true;\n                }\n                let dt = sim.dt();\n                publish(sim, sh, dt, now);\n            }\n        } else if let Some(t) = ctl.scrub {\n            sh.control.lock().unwrap().scrub = None;\n            if sim.rewind_to(t) {\n                self.rewound = true;\n            }\n            let dt = sim.dt();\n            publish(sim, sh, dt, now);\n            self.next = now;\n        } else if ctl.paused {\n            if ctl.step_requests > 0 {\n                sh.control.lock().unwrap().step_requests -= 1;\n                if self.rewound {\n                    sim.commit_rewind();\n                    self.rewound = false;\n                }\n                tick_once(sim, now);\n            }\n            self.next = now;\n        } else {\n            if self.rewound {\n                // Acting after a rewind starts a new timeline.\n                sim.commit_rewind();\n                self.rewound = false;\n                self.next = now;\n            }\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now; // too far behind: drop time instead of spiralling\n            }\n        }\n\n        let elapsed = self.window_start.elapsed();\n        if elapsed >= Duration::from_millis(500) {\n            let mut s = sh.stats.lock().unwrap();\n            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n            s.tick = sim.state.tick;\n            s.entities = sim.state.entities.len();\n            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n            s.rewound = self.rewound;\n            self.window_start = Instant::now();\n            self.window_ticks = 0;\n            self.busy = Duration::ZERO;\n        }\n        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n    let mut clock = Clock::new();\n    loop {\n        // Commands first.\n        loop {\n            match rx.try_recv() {\n                Ok(Cmd::Run(job)) => {\n                    job(&mut sim);\n                    let dt = sim.dt();\n                    publish(&mut sim, &sh, dt, Instant::now());\n                }\n                Ok(Cmd::Quit) => return,\n                Err(TryRecvError::Empty) => break,\n                Err(TryRecvError::Disconnected) => return,\n            }\n        }\n        let wait = clock.advance(&mut sim, &sh);\n        match rx.recv_timeout(wait) {\n            Ok(Cmd::Run(job)) => {\n                job(&mut sim);\n                let dt = sim.dt();\n                publish(&mut sim, &sh, dt, Instant::now());\n            }\n            Ok(Cmd::Quit) => return,\n            Err(RecvTimeoutError::Timeout) => {}\n            Err(RecvTimeoutError::Disconnected) => return,\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n        let mut sim = Sim::empty(1);\n        let shared = shared_for(&mut sim);\n        {\n            let mut control = shared.control.lock().unwrap();\n            control.paused = true;\n            control.speed = 8.0;\n        }\n        let mut clock = Clock::new();\n        clock.rewound = true;\n        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n        clock.advance(&mut sim, &shared);\n        let time = sim.preview_info().unwrap().time;\n        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n        assert_eq!(sim.state.tick, 0);\n        let control = *shared.control.lock().unwrap();\n        assert!(control.paused);\n        assert_eq!(control.speed, 8.0);\n        sim.preview_close();\n        clock.advance(&mut sim, &shared);\n        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n        assert!(clock.rewound);\n    }\n}\n","numLines":428,"startLine":1,"totalLines":428}},"tool_result_meta":[{"id":"toolu_01V8eEK5j2kvSVCbysHptCEC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjs74XpcuWXhWxybgqAu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LQQcwoFWGPYC46oC1JDjcT","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/input.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":32944,"cache_read_input_tokens":92434,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":32944},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"78b51b56-d21c-419e-8cbc-b105b57c6fa1","timestamp":"2026-11-05T13:32:01.695Z","request_id":"req_011Cgjs74EDK2yA1Cq8sfruD","wire_tool_inputs":{"toolu_01LQQcwoFWGPYC46oC1JDjcT":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/input.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LQQcwoFWGPYC46oC1JDjcT","type":"tool_result","content":"1\t//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n2\t//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n3\t\n4\tuse std::collections::HashSet;\n5\t\n6\tuse glam::Vec2;\n7\tuse pav_core::input::buttons;\n8\tuse winit::event::{ElementState, MouseButton};\n9\tuse winit::keyboard::KeyCode;\n10\t\n11\tpub use pav_ui::Device;\n12\t\n13\t/// Game-action bindings (defaults; rooms may override in the future).\n14\tpub struct KeyBinds {\n15\t    pub up: &'static [KeyCode],\n16\t    pub down: &'static [KeyCode],\n17\t    pub left: &'static [KeyCode],\n18\t    pub right: &'static [KeyCode],\n19\t    pub buttons: &'static [(u32, &'static [KeyCode])],\n20\t}\n21\t\n22\tpub const KEYS: KeyBinds = KeyBinds {\n23\t    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n24\t    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n25\t    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n26\t    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n27\t    buttons: &[\n28\t        (buttons::JUMP, &[KeyCode::Space]),\n29\t        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n30\t        (buttons::CRAWL, &[KeyCode::KeyZ]),\n31\t        (buttons::USE, &[KeyCode::KeyF]),\n32\t        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n33\t        (buttons::INTERACT, &[KeyCode::KeyE]),\n34\t    ],\n35\t};\n36\t\n37\t/// Physical key names usable in room files (`[keys]`).\n38\tpub fn key_from_name(n: &str) -> Option<KeyCode> {\n39\t    use KeyCode::*;\n40\t    let letters = [\n41\t        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n42\t        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n43\t    ];\n44\t    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n45\t        return Some(letters[(c as u8 - b'A') as usize]);\n46\t    }\n47\t    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n48\t    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n49\t        return Some(digits[d]);\n50\t    }\n51\t    Some(match n {\n52\t        \"Space\" => Space,\n53\t        \"Enter\" => Enter,\n54\t        \"Tab\" => Tab,\n55\t        \"ShiftLeft\" => ShiftLeft,\n56\t        \"ShiftRight\" => ShiftRight,\n57\t        \"ControlLeft\" => ControlLeft,\n58\t        \"ControlRight\" => ControlRight,\n59\t        \"AltLeft\" => AltLeft,\n60\t        \"AltRight\" => AltRight,\n61\t        \"ArrowUp\" => ArrowUp,\n62\t        \"ArrowDown\" => ArrowDown,\n63\t        \"ArrowLeft\" => ArrowLeft,\n64\t        \"ArrowRight\" => ArrowRight,\n65\t        \"Comma\" => Comma,\n66\t        \"Period\" => Period,\n67\t        \"Slash\" => Slash,\n68\t        \"Semicolon\" => Semicolon,\n69\t        \"Quote\" => Quote,\n70\t        \"BracketLeft\" => BracketLeft,\n71\t        \"BracketRight\" => BracketRight,\n72\t        \"Minus\" => Minus,\n73\t        \"Equal\" => Equal,\n74\t        \"CapsLock\" => CapsLock,\n75\t        _ => return None,\n76\t    })\n77\t}\n78\t\n79\t/// Current keyboard bindings: defaults, optionally overridden by the room.\n80\t#[derive(Clone)]\n81\tpub struct Bindings {\n82\t    pub up: Vec<KeyCode>,\n83\t    pub down: Vec<KeyCode>,\n84\t    pub left: Vec<KeyCode>,\n85\t    pub right: Vec<KeyCode>,\n86\t    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n87\t}\n88\t\n89\timpl Default for Bindings {\n90\t    fn default() -> Self {\n91\t        Self {\n92\t            up: KEYS.up.to_vec(),\n93\t            down: KEYS.down.to_vec(),\n94\t            left: KEYS.left.to_vec(),\n95\t            right: KEYS.right.to_vec(),\n96\t            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n97\t        }\n98\t    }\n99\t}\n100\t\n101\timpl Bindings {\n102\t    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n103\t    /// dodge, 1 for a potion, Shift to attack in place.\n104\t    pub fn game() -> Self {\n105\t        use KeyCode::*;\n106\t        Self {\n107\t            up: vec![KeyW, ArrowUp],\n108\t            down: vec![KeyS, ArrowDown],\n109\t            left: vec![KeyA, ArrowLeft],\n110\t            right: vec![KeyD, ArrowRight],\n111\t            buttons: vec![\n112\t                (buttons::SKILL3, vec![KeyQ]),\n113\t                (buttons::SKILL4, vec![KeyE]),\n114\t                (buttons::SKILL5, vec![KeyR]),\n115\t                (buttons::SKILL6, vec![KeyF]),\n116\t                (buttons::DODGE, vec![Space]),\n117\t                (buttons::POTION, vec![Digit1]),\n118\t                (buttons::FOCUS, vec![ShiftLeft]),\n119\t                (buttons::INTERACT, vec![KeyG]),\n120\t            ],\n121\t        }\n122\t    }\n123\t\n124\t    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n125\t    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n126\t        let mut b = Self::default();\n127\t        let mut errs = Vec::new();\n128\t        for (action, names) in map {\n129\t            let keys: Vec<KeyCode> = names\n130\t                .iter()\n131\t                .filter_map(|n| {\n132\t                    let k = key_from_name(n);\n133\t                    if k.is_none() {\n134\t                        errs.push(format!(\"unknown key '{n}'\"));\n135\t                    }\n136\t                    k\n137\t                })\n138\t                .collect();\n139\t            match action.as_str() {\n140\t                \"move_up\" => b.up = keys,\n141\t                \"move_down\" => b.down = keys,\n142\t                \"move_left\" => b.left = keys,\n143\t                \"move_right\" => b.right = keys,\n144\t                other => match pav_core::input::buttons::from_name(other) {\n145\t                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n146\t                        Some(e) => e.1 = keys,\n147\t                        None => b.buttons.push((bit, keys)),\n148\t                    },\n149\t                    None => errs.push(format!(\"unknown action '{other}'\")),\n150\t                },\n151\t            }\n152\t        }\n153\t        (b, errs)\n154\t    }\n155\t}\n156\t\n157\t/// Shardfall's controls.\n158\tpub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n159\t    match device {\n160\t        Device::KeyboardMouse => &[\n161\t            (\"Move\", \"W A S D\"),\n162\t            (\"Aim\", \"mouse\"),\n163\t            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n164\t            (\"Dodge roll\", \"Space (cancels any attack)\"),\n165\t            (\"Potion\", \"1\"),\n166\t            (\"Attack in place\", \"hold Shift\"),\n167\t            (\"Use (trade, portal, way down, chests)\", \"G\"),\n168\t            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n169\t            (\"Town portal\", \"T\"),\n170\t            (\"Pick up\", \"walk over it, or click its name\"),\n171\t            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n172\t            (\"Rewind\", \"hold Backspace\"),\n173\t            (\"Menu / tuning\", \"Esc / F1\"),\n174\t        ],\n175\t        Device::Gamepad => &[\n176\t            (\"Move / aim\", \"left stick / right stick\"),\n177\t            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n178\t            (\"Dodge roll\", \"A\"),\n179\t            (\"Potion\", \"D-pad up\"),\n180\t            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n181\t            (\"Map\", \"D-pad left\"),\n182\t            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n183\t            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n184\t            (\"Menu\", \"Start\"),\n185\t        ],\n186\t        Device::Touch => &[\n187\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n188\t            (\"Attack\", \"automatic: the nearest foe in reach\"),\n189\t            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n190\t            (\"Dodge roll · potion\", \"the big button · the flask\"),\n191\t            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n192\t            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n193\t            (\"Messages and the minimap\", \"swipe them away\"),\n194\t            (\"Close a window\", \"tap the game outside it\"),\n195\t        ],\n196\t    }\n197\t}\n198\t\n199\t/// Human-readable control guide per device.\n200\tpub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n201\t    match device {\n202\t        Device::KeyboardMouse => &[\n203\t            (\"Move\", \"W A S D\"),\n204\t            (\"Jump\", \"Space (hold = higher)\"),\n205\t            (\"Crouch\", \"C / Ctrl (hold)\"),\n206\t            (\"Crawl\", \"Z (toggle)\"),\n207\t            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n208\t            (\"Walk slowly\", \"Shift (instant model)\"),\n209\t            (\"Climb ladder\", \"walk into it\"),\n210\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n211\t            (\"Swim\", \"Space up · C down\"),\n212\t            (\"Dodge roll\", \"C while running (committed model)\"),\n213\t            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n214\t            (\"Vehicles\", \"E get in / out\"),\n215\t            (\"Rewind\", \"hold Backspace\"),\n216\t            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n217\t            (\"Menu / tuning\", \"Esc / F1\"),\n218\t        ],\n219\t        Device::Gamepad => &[\n220\t            (\"Move\", \"left stick\"),\n221\t            (\"Aim\", \"right stick\"),\n222\t            (\"Jump\", \"A (hold = higher)\"),\n223\t            (\"Crouch\", \"B (hold)\"),\n224\t            (\"Crawl\", \"Y (toggle)\"),\n225\t            (\"Throw bomb\", \"X or right trigger\"),\n226\t            (\"Walk slowly\", \"left trigger (instant model)\"),\n227\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n228\t            (\"Swim\", \"A up · B down\"),\n229\t            (\"Dodge roll\", \"B while running (committed model)\"),\n230\t            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n231\t            (\"Vehicles\", \"D-pad right: get in / out\"),\n232\t            (\"Rewind\", \"hold Back/View\"),\n233\t            (\"Menu\", \"Start\"),\n234\t        ],\n235\t        Device::Touch => &[\n236\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n237\t            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n238\t            (\"Menu\", \"top right\"),\n239\t        ],\n240\t    }\n241\t}\n242\t\n243\t#[derive(Default)]\n244\tpub struct Pad {\n245\t    pub left: Vec2,\n246\t    pub right: Vec2,\n247\t    pub held: u32,\n248\t    pub rotate: f32,\n249\t    pub zoom: f32,\n250\t    pub start_pressed: bool,\n251\t    /// D-pad left (the game's map).\n252\t    pub map_pressed: bool,\n253\t    /// Buttons pressed since the last poll (menus read these as taps).\n254\t    pub taps: Vec<gilrs::Button>,\n255\t    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n256\t    pub a_held: bool,\n257\t    pub x_held: bool,\n258\t    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n259\t    pub y_held: bool,\n260\t    pub back_held: bool,\n261\t    pub any_activity: bool,\n262\t}\n263\t\n264\tpub struct Input {\n265\t    pub keys: HashSet<KeyCode>,\n266\t    pub mouse: HashSet<MouseButton>,\n267\t    pub cursor: Vec2,\n268\t    pub mouse_active: bool,\n269\t    pub gilrs: Option<gilrs::Gilrs>,\n270\t    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n271\t    pub pad_script: Option<PadScript>,\n272\t    pub pad: Pad,\n273\t    pub last_device: Device,\n274\t    prev_held: u32,\n275\t    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n276\t    key_taps: HashSet<KeyCode>,\n277\t    pub mouse_taps: HashSet<MouseButton>,\n278\t    pub bindings: Bindings,\n279\t    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n280\t    pub game: bool,\n281\t}\n282\t\n283\t/// A pad's raw state for one frame.\n284\tstruct PadState {\n285\t    left: Vec2,\n286\t    right: Vec2,\n287\t    held: Vec<gilrs::Button>,\n288\t    lt2: bool,\n289\t    rt2: bool,\n290\t}\n291\t\n292\t/// One line of a pad script: hold this for so many frames.\n293\t#[derive(Clone, Debug, Default)]\n294\tpub struct PadStep {\n295\t    pub frames: u32,\n296\t    pub left: Vec2,\n297\t    pub right: Vec2,\n298\t    pub hold: Vec<gilrs::Button>,\n299\t    pub tap: Vec<gilrs::Button>,\n300\t}\n301\t\n302\t/// A scripted gamepad, one step per line:\n303\t/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n304\t/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n305\t/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n306\t#[derive(Clone, Debug, Default)]\n307\tpub struct PadScript {\n308\t    pub steps: Vec<PadStep>,\n309\t    at: usize,\n310\t    frame: u32,\n311\t}\n312\t\n313\timpl PadScript {\n314\t    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n315\t    pub fn parse(text: &str) -> Result<PadScript, String> {\n316\t        let button = |n: &str| -> Result<gilrs::Button, String> {\n317\t            use gilrs::Button as B;\n318\t            Ok(match n {\n319\t                \"South\" | \"A\" => B::South,\n320\t                \"East\" | \"B\" => B::East,\n321\t                \"West\" | \"X\" => B::West,\n322\t                \"North\" | \"Y\" => B::North,\n323\t                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n324\t                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n325\t                \"Start\" => B::Start,\n326\t                \"Select\" => B::Select,\n327\t                \"DPadUp\" => B::DPadUp,\n328\t                \"DPadDown\" => B::DPadDown,\n329\t                \"DPadLeft\" => B::DPadLeft,\n330\t                \"DPadRight\" => B::DPadRight,\n331\t                o => return Err(format!(\"unknown button '{o}'\")),\n332\t            })\n333\t        };\n334\t        let vec = |v: &str| -> Result<Vec2, String> {\n335\t            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n336\t            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n337\t        };\n338\t        let mut steps = Vec::new();\n339\t        for (n, line) in text.lines().enumerate() {\n340\t            let line = line.split('#').next().unwrap_or(\"\").trim();\n341\t            if line.is_empty() {\n342\t                continue;\n343\t            }\n344\t            let mut words = line.split_whitespace();\n345\t            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n346\t            let mut st = PadStep { frames, ..Default::default() };\n347\t            for w in words {\n348\t                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n349\t                match k {\n350\t                    \"left\" => st.left = vec(v)?,\n351\t                    \"right\" => st.right = vec(v)?,\n352\t                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n353\t                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n354\t                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n355\t                }\n356\t            }\n357\t            steps.push(st);\n358\t        }\n359\t        Ok(PadScript { steps, at: 0, frame: 0 })\n360\t    }\n361\t\n362\t    /// This frame's step (and whether it's the step's first frame); None when done.\n363\t    fn next(&mut self) -> Option<(PadStep, bool)> {\n364\t        let st = self.steps.get(self.at)?.clone();\n365\t        let first = self.frame == 0;\n366\t        self.frame += 1;\n367\t        if self.frame >= st.frames.max(1) {\n368\t            self.at += 1;\n369\t            self.frame = 0;\n370\t        }\n371\t        Some((st, first))\n372\t    }\n373\t}\n374\t\n375\tfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n376\t    let l = v.length();\n377\t    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n378\t}\n379\t\n380\timpl Input {\n381\t    pub fn new() -> Self {\n382\t        let gilrs = match gilrs::Gilrs::new() {\n383\t            Ok(g) => {\n384\t                for (_, gp) in g.gamepads() {\n385\t                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n386\t                }\n387\t                Some(g)\n388\t            }\n389\t            Err(e) => {\n390\t                log::warn!(\"gamepads unavailable: {e}\");\n391\t                None\n392\t            }\n393\t        };\n394\t        Self {\n395\t            keys: HashSet::new(),\n396\t            mouse: HashSet::new(),\n397\t            cursor: Vec2::ZERO,\n398\t            mouse_active: false,\n399\t            gilrs,\n400\t            pad_script: None,\n401\t            pad: Pad::default(),\n402\t            last_device: Device::KeyboardMouse,\n403\t            prev_held: 0,\n404\t            key_taps: HashSet::new(),\n405\t            mouse_taps: HashSet::new(),\n406\t            bindings: Bindings::default(),\n407\t            game: false,\n408\t        }\n409\t    }\n410\t\n411\t    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n412\t        self.last_device = Device::KeyboardMouse;\n413\t        match state {\n414\t            ElementState::Pressed => {\n415\t                self.keys.insert(code);\n416\t                self.key_taps.insert(code);\n417\t            }\n418\t            ElementState::Released => {\n419\t                self.keys.remove(&code);\n420\t            }\n421\t        }\n422\t    }\n423\t\n424\t    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n425\t        self.last_device = Device::KeyboardMouse;\n426\t        self.mouse_active = true;\n427\t        match state {\n428\t            ElementState::Pressed => {\n429\t                self.mouse.insert(b);\n430\t                self.mouse_taps.insert(b);\n431\t            }\n432\t            ElementState::Released => {\n433\t                self.mouse.remove(&b);\n434\t            }\n435\t        }\n436\t    }\n437\t\n438\t    pub fn clear(&mut self) {\n439\t        self.keys.clear();\n440\t        self.mouse.clear();\n441\t    }\n442\t\n443\t    /// Reads gamepad events and state (first connected pad).\n444\t    pub fn poll_gamepad(&mut self) {\n445\t        use gilrs::{Axis, Button};\n446\t        let mut activity = false;\n447\t        let mut taps = Vec::new();\n448\t        // One pad state from the first connected pad, or from the pad script while it runs.\n449\t        let mut state: Option<PadState> = None;\n450\t        if let Some(g) = &mut self.gilrs {\n451\t            while let Some(ev) = g.next_event() {\n452\t                match ev.event {\n453\t                    gilrs::EventType::ButtonPressed(b, _) => {\n454\t                        taps.push(b);\n455\t                        activity = true;\n456\t                    }\n457\t                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n458\t                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n459\t                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n460\t                    _ => {}\n461\t                }\n462\t            }\n463\t            if let Some((_, gp)) = g.gamepads().next() {\n464\t                const ALL: [Button; 15] = [\n465\t                    Button::South,\n466\t                    Button::East,\n467\t                    Button::North,\n468\t                    Button::West,\n469\t                    Button::LeftTrigger,\n470\t                    Button::RightTrigger,\n471\t                    Button::Select,\n472\t                    Button::Start,\n473\t                    Button::DPadUp,\n474\t                    Button::DPadDown,\n475\t                    Button::DPadLeft,\n476\t                    Button::DPadRight,\n477\t                    Button::LeftThumb,\n478\t                    Button::RightThumb,\n479\t                    Button::Mode,\n480\t                ];\n481\t                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n482\t                state = Some(PadState {\n483\t                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n484\t                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n485\t                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n486\t                    lt2: trig(Button::LeftTrigger2),\n487\t                    rt2: trig(Button::RightTrigger2),\n488\t                });\n489\t            }\n490\t        }\n491\t        if let Some(script) = &mut self.pad_script {\n492\t            if let Some((st, first)) = script.next() {\n493\t                if first {\n494\t                    taps.extend(st.tap.iter().copied());\n495\t                }\n496\t                activity = true;\n497\t                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n498\t            }\n499\t        }\n500\t        let start = taps.contains(&Button::Start);\n501\t        let map = taps.contains(&Button::DPadLeft);\n502\t        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n503\t        if let Some(st) = state {\n504\t            let is = |b: Button| st.held.contains(&b);\n505\t            pad.left = deadzone(st.left, 0.18);\n506\t            pad.right = deadzone(st.right, 0.25);\n507\t            let mut held = 0;\n508\t            let layout: &[(Button, u32)] = if self.game {\n509\t                &[\n510\t                    (Button::West, buttons::PRIMARY),\n511\t                    (Button::North, buttons::SECONDARY),\n512\t                    (Button::East, buttons::SKILL3),\n513\t                    (Button::RightTrigger, buttons::SKILL4),\n514\t                    (Button::LeftTrigger, buttons::SKILL5),\n515\t                    (Button::South, buttons::DODGE),\n516\t                    (Button::DPadUp, buttons::POTION),\n517\t                    (Button::DPadRight, buttons::INTERACT),\n518\t                ]\n519\t            } else {\n520\t                &[\n521\t                    (Button::South, buttons::JUMP),\n522\t                    (Button::East, buttons::CROUCH),\n523\t                    (Button::North, buttons::CRAWL),\n524\t                    (Button::West, buttons::USE),\n525\t                    (Button::DPadRight, buttons::INTERACT),\n526\t                ]\n527\t            };\n528\t            for (btn, action) in layout {\n529\t                if is(*btn) {\n530\t                    held |= action;\n531\t                }\n532\t            }\n533\t            if st.rt2 {\n534\t                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n535\t            }\n536\t            if st.lt2 {\n537\t                held |= buttons::FOCUS;\n538\t            }\n539\t            pad.held = held;\n540\t            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n541\t            // In the game the D-pad is potion / use / map / panels, not zoom.\n542\t            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n543\t            pad.a_held = is(Button::South);\n544\t            pad.x_held = is(Button::West);\n545\t            pad.y_held = is(Button::North);\n546\t            pad.back_held = is(Button::Select);\n547\t            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n548\t                pad.any_activity = true;\n549\t            }\n550\t        }\n551\t        if pad.any_activity {\n552\t            self.last_device = Device::Gamepad;\n553\t        }\n554\t        self.pad = pad;\n555\t    }\n556\t\n557\t    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n558\t    pub fn move_axis(&self) -> Vec2 {\n559\t        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n560\t        let b = &self.bindings;\n561\t        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n562\t        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n563\t        v.clamp_length_max(1.0)\n564\t    }\n565\t\n566\t    /// Held game buttons from all devices.\n567\t    pub fn held(&self) -> u32 {\n568\t        let mut b = self.pad.held;\n569\t        for (bit, codes) in &self.bindings.buttons {\n570\t            if codes.iter().any(|c| self.keys.contains(c)) {\n571\t                b |= bit;\n572\t            }\n573\t        }\n574\t        if self.mouse.contains(&MouseButton::Left) {\n575\t            b |= buttons::PRIMARY;\n576\t        }\n577\t        if self.game && self.mouse.contains(&MouseButton::Right) {\n578\t            b |= buttons::SECONDARY;\n579\t        }\n580\t        b\n581\t    }\n582\t\n583\t    /// Returns (held, newly pressed since the last call).\n584\t    pub fn buttons(&mut self) -> (u32, u32) {\n585\t        let held = self.held();\n586\t        let mut pressed = held & !self.prev_held;\n587\t        for (bit, codes) in &self.bindings.buttons {\n588\t            if codes.iter().any(|c| self.key_taps.contains(c)) {\n589\t                pressed |= bit;\n590\t            }\n591\t        }\n592\t        if self.mouse_taps.contains(&MouseButton::Left) {\n593\t            pressed |= buttons::PRIMARY;\n594\t        }\n595\t        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n596\t            pressed |= buttons::SECONDARY;\n597\t        }\n598\t        self.key_taps.clear();\n599\t        self.mouse_taps.clear();\n600\t        self.prev_held = held;\n601\t        // A tap shorter than a frame still counts as held for that frame.\n602\t        (held | pressed, pressed)\n603\t    }\n604\t\n605\t    /// True if `b` was pressed since the last call (consumes the tap).\n606\t    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n607\t        self.mouse_taps.remove(&b)\n608\t    }\n609\t\n610\t    pub fn rewind_held(&self) -> bool {\n611\t        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n612\t    }\n613\t}\n614\t\n615\t#[cfg(test)]\n616\tmod pad_script_tests {\n617\t    use super::*;\n618\t\n619\t    #[test]\n620\t    fn pad_scripts_parse_and_play() {\n621\t        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n622\t        assert_eq!(p.steps.len(), 3);\n623\t        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n624\t        assert_eq!(frames.len(), 6);\n625\t        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n626\t        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n627\t        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n628\t        assert!(PadScript::parse(\"x tap=A\").is_err());\n629\t        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n630\t    }\n631\t}\n632\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"20942cbc-bf16-4ce0-a30a-fd711b39025f","timestamp":"2026-11-05T13:32:01.713Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_app/src/input.rs","content":"//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n\nuse std::collections::HashSet;\n\nuse glam::Vec2;\nuse pav_core::input::buttons;\nuse winit::event::{ElementState, MouseButton};\nuse winit::keyboard::KeyCode;\n\npub use pav_ui::Device;\n\n/// Game-action bindings (defaults; rooms may override in the future).\npub struct KeyBinds {\n    pub up: &'static [KeyCode],\n    pub down: &'static [KeyCode],\n    pub left: &'static [KeyCode],\n    pub right: &'static [KeyCode],\n    pub buttons: &'static [(u32, &'static [KeyCode])],\n}\n\npub const KEYS: KeyBinds = KeyBinds {\n    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n    buttons: &[\n        (buttons::JUMP, &[KeyCode::Space]),\n        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n        (buttons::CRAWL, &[KeyCode::KeyZ]),\n        (buttons::USE, &[KeyCode::KeyF]),\n        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n        (buttons::INTERACT, &[KeyCode::KeyE]),\n    ],\n};\n\n/// Physical key names usable in room files (`[keys]`).\npub fn key_from_name(n: &str) -> Option<KeyCode> {\n    use KeyCode::*;\n    let letters = [\n        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n    ];\n    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n        return Some(letters[(c as u8 - b'A') as usize]);\n    }\n    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n        return Some(digits[d]);\n    }\n    Some(match n {\n        \"Space\" => Space,\n        \"Enter\" => Enter,\n        \"Tab\" => Tab,\n        \"ShiftLeft\" => ShiftLeft,\n        \"ShiftRight\" => ShiftRight,\n        \"ControlLeft\" => ControlLeft,\n        \"ControlRight\" => ControlRight,\n        \"AltLeft\" => AltLeft,\n        \"AltRight\" => AltRight,\n        \"ArrowUp\" => ArrowUp,\n        \"ArrowDown\" => ArrowDown,\n        \"ArrowLeft\" => ArrowLeft,\n        \"ArrowRight\" => ArrowRight,\n        \"Comma\" => Comma,\n        \"Period\" => Period,\n        \"Slash\" => Slash,\n        \"Semicolon\" => Semicolon,\n        \"Quote\" => Quote,\n        \"BracketLeft\" => BracketLeft,\n        \"BracketRight\" => BracketRight,\n        \"Minus\" => Minus,\n        \"Equal\" => Equal,\n        \"CapsLock\" => CapsLock,\n        _ => return None,\n    })\n}\n\n/// Current keyboard bindings: defaults, optionally overridden by the room.\n#[derive(Clone)]\npub struct Bindings {\n    pub up: Vec<KeyCode>,\n    pub down: Vec<KeyCode>,\n    pub left: Vec<KeyCode>,\n    pub right: Vec<KeyCode>,\n    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n}\n\nimpl Default for Bindings {\n    fn default() -> Self {\n        Self {\n            up: KEYS.up.to_vec(),\n            down: KEYS.down.to_vec(),\n            left: KEYS.left.to_vec(),\n            right: KEYS.right.to_vec(),\n            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n        }\n    }\n}\n\nimpl Bindings {\n    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n    /// dodge, 1 for a potion, Shift to attack in place.\n    pub fn game() -> Self {\n        use KeyCode::*;\n        Self {\n            up: vec![KeyW, ArrowUp],\n            down: vec![KeyS, ArrowDown],\n            left: vec![KeyA, ArrowLeft],\n            right: vec![KeyD, ArrowRight],\n            buttons: vec![\n                (buttons::SKILL3, vec![KeyQ]),\n                (buttons::SKILL4, vec![KeyE]),\n                (buttons::SKILL5, vec![KeyR]),\n                (buttons::SKILL6, vec![KeyF]),\n                (buttons::DODGE, vec![Space]),\n                (buttons::POTION, vec![Digit1]),\n                (buttons::FOCUS, vec![ShiftLeft]),\n                (buttons::INTERACT, vec![KeyG]),\n            ],\n        }\n    }\n\n    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n        let mut b = Self::default();\n        let mut errs = Vec::new();\n        for (action, names) in map {\n            let keys: Vec<KeyCode> = names\n                .iter()\n                .filter_map(|n| {\n                    let k = key_from_name(n);\n                    if k.is_none() {\n                        errs.push(format!(\"unknown key '{n}'\"));\n                    }\n                    k\n                })\n                .collect();\n            match action.as_str() {\n                \"move_up\" => b.up = keys,\n                \"move_down\" => b.down = keys,\n                \"move_left\" => b.left = keys,\n                \"move_right\" => b.right = keys,\n                other => match pav_core::input::buttons::from_name(other) {\n                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n                        Some(e) => e.1 = keys,\n                        None => b.buttons.push((bit, keys)),\n                    },\n                    None => errs.push(format!(\"unknown action '{other}'\")),\n                },\n            }\n        }\n        (b, errs)\n    }\n}\n\n/// Shardfall's controls.\npub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Aim\", \"mouse\"),\n            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n            (\"Dodge roll\", \"Space (cancels any attack)\"),\n            (\"Potion\", \"1\"),\n            (\"Attack in place\", \"hold Shift\"),\n            (\"Use (trade, portal, way down, chests)\", \"G\"),\n            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n            (\"Town portal\", \"T\"),\n            (\"Pick up\", \"walk over it, or click its name\"),\n            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move / aim\", \"left stick / right stick\"),\n            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n            (\"Dodge roll\", \"A\"),\n            (\"Potion\", \"D-pad up\"),\n            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n            (\"Map\", \"D-pad left\"),\n            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Attack\", \"automatic: the nearest foe in reach\"),\n            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n            (\"Dodge roll · potion\", \"the big button · the flask\"),\n            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n            (\"Messages and the minimap\", \"swipe them away\"),\n            (\"Close a window\", \"tap the game outside it\"),\n        ],\n    }\n}\n\n/// Human-readable control guide per device.\npub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Jump\", \"Space (hold = higher)\"),\n            (\"Crouch\", \"C / Ctrl (hold)\"),\n            (\"Crawl\", \"Z (toggle)\"),\n            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n            (\"Walk slowly\", \"Shift (instant model)\"),\n            (\"Climb ladder\", \"walk into it\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"Space up · C down\"),\n            (\"Dodge roll\", \"C while running (committed model)\"),\n            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n            (\"Vehicles\", \"E get in / out\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move\", \"left stick\"),\n            (\"Aim\", \"right stick\"),\n            (\"Jump\", \"A (hold = higher)\"),\n            (\"Crouch\", \"B (hold)\"),\n            (\"Crawl\", \"Y (toggle)\"),\n            (\"Throw bomb\", \"X or right trigger\"),\n            (\"Walk slowly\", \"left trigger (instant model)\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"A up · B down\"),\n            (\"Dodge roll\", \"B while running (committed model)\"),\n            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n            (\"Vehicles\", \"D-pad right: get in / out\"),\n            (\"Rewind\", \"hold Back/View\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n            (\"Menu\", \"top right\"),\n        ],\n    }\n}\n\n#[derive(Default)]\npub struct Pad {\n    pub left: Vec2,\n    pub right: Vec2,\n    pub held: u32,\n    pub rotate: f32,\n    pub zoom: f32,\n    pub start_pressed: bool,\n    /// D-pad left (the game's map).\n    pub map_pressed: bool,\n    /// Buttons pressed since the last poll (menus read these as taps).\n    pub taps: Vec<gilrs::Button>,\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n    pub a_held: bool,\n    pub x_held: bool,\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n    pub y_held: bool,\n    pub back_held: bool,\n    pub any_activity: bool,\n}\n\npub struct Input {\n    pub keys: HashSet<KeyCode>,\n    pub mouse: HashSet<MouseButton>,\n    pub cursor: Vec2,\n    pub mouse_active: bool,\n    pub gilrs: Option<gilrs::Gilrs>,\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n    pub pad_script: Option<PadScript>,\n    pub pad: Pad,\n    pub last_device: Device,\n    prev_held: u32,\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n    key_taps: HashSet<KeyCode>,\n    pub mouse_taps: HashSet<MouseButton>,\n    pub bindings: Bindings,\n    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n}\n\n/// A pad's raw state for one frame.\nstruct PadState {\n    left: Vec2,\n    right: Vec2,\n    held: Vec<gilrs::Button>,\n    lt2: bool,\n    rt2: bool,\n}\n\n/// One line of a pad script: hold this for so many frames.\n#[derive(Clone, Debug, Default)]\npub struct PadStep {\n    pub frames: u32,\n    pub left: Vec2,\n    pub right: Vec2,\n    pub hold: Vec<gilrs::Button>,\n    pub tap: Vec<gilrs::Button>,\n}\n\n/// A scripted gamepad, one step per line:\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n#[derive(Clone, Debug, Default)]\npub struct PadScript {\n    pub steps: Vec<PadStep>,\n    at: usize,\n    frame: u32,\n}\n\nimpl PadScript {\n    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n    pub fn parse(text: &str) -> Result<PadScript, String> {\n        let button = |n: &str| -> Result<gilrs::Button, String> {\n            use gilrs::Button as B;\n            Ok(match n {\n                \"South\" | \"A\" => B::South,\n                \"East\" | \"B\" => B::East,\n                \"West\" | \"X\" => B::West,\n                \"North\" | \"Y\" => B::North,\n                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n                \"Start\" => B::Start,\n                \"Select\" => B::Select,\n                \"DPadUp\" => B::DPadUp,\n                \"DPadDown\" => B::DPadDown,\n                \"DPadLeft\" => B::DPadLeft,\n                \"DPadRight\" => B::DPadRight,\n                o => return Err(format!(\"unknown button '{o}'\")),\n            })\n        };\n        let vec = |v: &str| -> Result<Vec2, String> {\n            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n        };\n        let mut steps = Vec::new();\n        for (n, line) in text.lines().enumerate() {\n            let line = line.split('#').next().unwrap_or(\"\").trim();\n            if line.is_empty() {\n                continue;\n            }\n            let mut words = line.split_whitespace();\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n            let mut st = PadStep { frames, ..Default::default() };\n            for w in words {\n                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n                match k {\n                    \"left\" => st.left = vec(v)?,\n                    \"right\" => st.right = vec(v)?,\n                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n                }\n            }\n            steps.push(st);\n        }\n        Ok(PadScript { steps, at: 0, frame: 0 })\n    }\n\n    /// This frame's step (and whether it's the step's first frame); None when done.\n    fn next(&mut self) -> Option<(PadStep, bool)> {\n        let st = self.steps.get(self.at)?.clone();\n        let first = self.frame == 0;\n        self.frame += 1;\n        if self.frame >= st.frames.max(1) {\n            self.at += 1;\n            self.frame = 0;\n        }\n        Some((st, first))\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\nimpl Input {\n    pub fn new() -> Self {\n        let gilrs = match gilrs::Gilrs::new() {\n            Ok(g) => {\n                for (_, gp) in g.gamepads() {\n                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n                }\n                Some(g)\n            }\n            Err(e) => {\n                log::warn!(\"gamepads unavailable: {e}\");\n                None\n            }\n        };\n        Self {\n            keys: HashSet::new(),\n            mouse: HashSet::new(),\n            cursor: Vec2::ZERO,\n            mouse_active: false,\n            gilrs,\n            pad_script: None,\n            pad: Pad::default(),\n            last_device: Device::KeyboardMouse,\n            prev_held: 0,\n            key_taps: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            bindings: Bindings::default(),\n            game: false,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        match state {\n            ElementState::Pressed => {\n                self.keys.insert(code);\n                self.key_taps.insert(code);\n            }\n            ElementState::Released => {\n                self.keys.remove(&code);\n            }\n        }\n    }\n\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        match state {\n            ElementState::Pressed => {\n                self.mouse.insert(b);\n                self.mouse_taps.insert(b);\n            }\n            ElementState::Released => {\n                self.mouse.remove(&b);\n            }\n        }\n    }\n\n    pub fn clear(&mut self) {\n        self.keys.clear();\n        self.mouse.clear();\n    }\n\n    /// Reads gamepad events and state (first connected pad).\n    pub fn poll_gamepad(&mut self) {\n        use gilrs::{Axis, Button};\n        let mut activity = false;\n        let mut taps = Vec::new();\n        // One pad state from the first connected pad, or from the pad script while it runs.\n        let mut state: Option<PadState> = None;\n        if let Some(g) = &mut self.gilrs {\n            while let Some(ev) = g.next_event() {\n                match ev.event {\n                    gilrs::EventType::ButtonPressed(b, _) => {\n                        taps.push(b);\n                        activity = true;\n                    }\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n                    _ => {}\n                }\n            }\n            if let Some((_, gp)) = g.gamepads().next() {\n                const ALL: [Button; 15] = [\n                    Button::South,\n                    Button::East,\n                    Button::North,\n                    Button::West,\n                    Button::LeftTrigger,\n                    Button::RightTrigger,\n                    Button::Select,\n                    Button::Start,\n                    Button::DPadUp,\n                    Button::DPadDown,\n                    Button::DPadLeft,\n                    Button::DPadRight,\n                    Button::LeftThumb,\n                    Button::RightThumb,\n                    Button::Mode,\n                ];\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n                state = Some(PadState {\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n                    lt2: trig(Button::LeftTrigger2),\n                    rt2: trig(Button::RightTrigger2),\n                });\n            }\n        }\n        if let Some(script) = &mut self.pad_script {\n            if let Some((st, first)) = script.next() {\n                if first {\n                    taps.extend(st.tap.iter().copied());\n                }\n                activity = true;\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n            }\n        }\n        let start = taps.contains(&Button::Start);\n        let map = taps.contains(&Button::DPadLeft);\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n        if let Some(st) = state {\n            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\n                &[\n                    (Button::West, buttons::PRIMARY),\n                    (Button::North, buttons::SECONDARY),\n                    (Button::East, buttons::SKILL3),\n                    (Button::RightTrigger, buttons::SKILL4),\n                    (Button::LeftTrigger, buttons::SKILL5),\n                    (Button::South, buttons::DODGE),\n                    (Button::DPadUp, buttons::POTION),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            } else {\n                &[\n                    (Button::South, buttons::JUMP),\n                    (Button::East, buttons::CROUCH),\n                    (Button::North, buttons::CRAWL),\n                    (Button::West, buttons::USE),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            };\n            for (btn, action) in layout {\n                if is(*btn) {\n                    held |= action;\n                }\n            }\n            if st.rt2 {\n                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n            }\n            if st.lt2 {\n                held |= buttons::FOCUS;\n            }\n            pad.held = held;\n            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n            // In the game the D-pad is potion / use / map / panels, not zoom.\n            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n            pad.a_held = is(Button::South);\n            pad.x_held = is(Button::West);\n            pad.y_held = is(Button::North);\n            pad.back_held = is(Button::Select);\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n                pad.any_activity = true;\n            }\n        }\n        if pad.any_activity {\n            self.last_device = Device::Gamepad;\n        }\n        self.pad = pad;\n    }\n\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n    pub fn move_axis(&self) -> Vec2 {\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        let b = &self.bindings;\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n        v.clamp_length_max(1.0)\n    }\n\n    /// Held game buttons from all devices.\n    pub fn held(&self) -> u32 {\n        let mut b = self.pad.held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.keys.contains(c)) {\n                b |= bit;\n            }\n        }\n        if self.mouse.contains(&MouseButton::Left) {\n            b |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse.contains(&MouseButton::Right) {\n            b |= buttons::SECONDARY;\n        }\n        b\n    }\n\n    /// Returns (held, newly pressed since the last call).\n    pub fn buttons(&mut self) -> (u32, u32) {\n        let held = self.held();\n        let mut pressed = held & !self.prev_held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\n                pressed |= bit;\n            }\n        }\n        if self.mouse_taps.contains(&MouseButton::Left) {\n            pressed |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n            pressed |= buttons::SECONDARY;\n        }\n        self.key_taps.clear();\n        self.mouse_taps.clear();\n        self.prev_held = held;\n        // A tap shorter than a frame still counts as held for that frame.\n        (held | pressed, pressed)\n    }\n\n    /// True if `b` was pressed since the last call (consumes the tap).\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n        self.mouse_taps.remove(&b)\n    }\n\n    pub fn rewind_held(&self) -> bool {\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n    }\n}\n\n#[cfg(test)]\nmod pad_script_tests {\n    use super::*;\n\n    #[test]\n    fn pad_scripts_parse_and_play() {\n        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n        assert_eq!(p.steps.len(), 3);\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n        assert_eq!(frames.len(), 6);\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n        assert!(PadScript::parse(\"x tap=A\").is_err());\n        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n    }\n}\n","numLines":632,"startLine":1,"totalLines":632}},"tool_result_meta":[{"id":"toolu_01LQQcwoFWGPYC46oC1JDjcT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjs74XpcuWXhWxybgqAu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VdWMbMBKytMsoDY4B28Ech","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_audio/src/lib.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":32944,"cache_read_input_tokens":92434,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":32944},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"c7a5f011-9792-4a41-a776-574be733da8c","timestamp":"2026-11-05T13:32:03.783Z","request_id":"req_011Cgjs74EDK2yA1Cq8sfruD","wire_tool_inputs":{"toolu_01VdWMbMBKytMsoDY4B28Ech":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_audio/src/lib.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VdWMbMBKytMsoDY4B28Ech","type":"tool_result","content":"1\t//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n2\t//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n3\t//! runs fine without a sound device.\n4\t\n5\tuse std::sync::mpsc::{Receiver, Sender, channel};\n6\t\n7\tuse glam::Vec3;\n8\tuse pav_core::SimEvent;\n9\t\n10\t#[derive(Clone, Copy, Debug, PartialEq)]\n11\tpub enum Wave {\n12\t    Sine,\n13\t    Square,\n14\t    Saw,\n15\t    Triangle,\n16\t    Noise,\n17\t}\n18\t\n19\t/// One synthesized sound.\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct Patch {\n22\t    pub wave: Wave,\n23\t    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n24\t    pub freq: f32,\n25\t    pub freq_end: f32,\n26\t    pub glide: f32,\n27\t    pub attack: f32,\n28\t    pub decay: f32,\n29\t    pub sustain: f32,\n30\t    pub hold: f32,\n31\t    pub release: f32,\n32\t    pub volume: f32,\n33\t    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n34\t    pub cutoff: f32,\n35\t    pub cutoff_end: f32,\n36\t    /// Square-wave duty cycle.\n37\t    pub duty: f32,\n38\t}\n39\t\n40\timpl Patch {\n41\t    pub const fn new(wave: Wave, freq: f32) -> Self {\n42\t        Self {\n43\t            wave,\n44\t            freq,\n45\t            freq_end: freq,\n46\t            glide: 0.1,\n47\t            attack: 0.002,\n48\t            decay: 0.1,\n49\t            sustain: 0.0,\n50\t            hold: 0.0,\n51\t            release: 0.05,\n52\t            volume: 0.3,\n53\t            cutoff: 12000.0,\n54\t            cutoff_end: 12000.0,\n55\t            duty: 0.5,\n56\t        }\n57\t    }\n58\t    pub fn length(&self) -> f32 {\n59\t        self.attack + self.decay + self.hold + self.release\n60\t    }\n61\t}\n62\t\n63\tstruct Voice {\n64\t    p: Patch,\n65\t    t: f32,\n66\t    delay: f32,\n67\t    phase: f32,\n68\t    lp: f32,\n69\t    noise: u32,\n70\t    gain_l: f32,\n71\t    gain_r: f32,\n72\t}\n73\t\n74\timpl Voice {\n75\t    fn env(&self) -> f32 {\n76\t        let p = &self.p;\n77\t        let t = self.t;\n78\t        if t < p.attack {\n79\t            return t / p.attack.max(1e-5);\n80\t        }\n81\t        let t = t - p.attack;\n82\t        if t < p.decay {\n83\t            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n84\t        }\n85\t        let t = t - p.decay;\n86\t        if t < p.hold {\n87\t            return p.sustain;\n88\t        }\n89\t        let t = t - p.hold;\n90\t        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n91\t        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n92\t    }\n93\t\n94\t    fn done(&self) -> bool {\n95\t        self.t > self.p.length() + 0.01\n96\t    }\n97\t\n98\t    fn next(&mut self, dt: f32) -> f32 {\n99\t        if self.delay > 0.0 {\n100\t            self.delay -= dt;\n101\t            return 0.0;\n102\t        }\n103\t        let p = self.p;\n104\t        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n105\t        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n106\t        self.phase = (self.phase + freq * dt).fract();\n107\t        let ph = self.phase;\n108\t        let raw = match p.wave {\n109\t            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n110\t            Wave::Square => {\n111\t                if ph < p.duty {\n112\t                    1.0\n113\t                } else {\n114\t                    -1.0\n115\t                }\n116\t            }\n117\t            Wave::Saw => ph * 2.0 - 1.0,\n118\t            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n119\t            Wave::Noise => {\n120\t                self.noise ^= self.noise << 13;\n121\t                self.noise ^= self.noise >> 17;\n122\t                self.noise ^= self.noise << 5;\n123\t                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n124\t            }\n125\t        };\n126\t        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n127\t        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n128\t        self.lp += (raw - self.lp) * a;\n129\t        let s = self.lp * self.env() * p.volume;\n130\t        self.t += dt;\n131\t        s\n132\t    }\n133\t}\n134\t\n135\t/// Mixes voices into interleaved stereo.\n136\tpub struct Mixer {\n137\t    voices: Vec<Voice>,\n138\t    pub sample_rate: f32,\n139\t    pub master: f32,\n140\t    seed: u32,\n141\t}\n142\t\n143\tconst MAX_VOICES: usize = 64;\n144\t\n145\timpl Mixer {\n146\t    pub fn new(sample_rate: f32) -> Self {\n147\t        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n148\t    }\n149\t\n150\t    /// pan -1 (left) .. 1 (right); delay in seconds.\n151\t    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n152\t        if self.voices.len() >= MAX_VOICES {\n153\t            // Drop the oldest.\n154\t            self.voices.remove(0);\n155\t        }\n156\t        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n157\t        let pan = pan.clamp(-1.0, 1.0);\n158\t        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n159\t        self.voices.push(Voice {\n160\t            p,\n161\t            t: 0.0,\n162\t            delay,\n163\t            phase: 0.0,\n164\t            lp: 0.0,\n165\t            noise: self.seed | 1,\n166\t            gain_l: a.cos() * gain,\n167\t            gain_r: a.sin() * gain,\n168\t        });\n169\t    }\n170\t\n171\t    /// Renders into an interleaved stereo buffer (overwrites).\n172\t    pub fn render(&mut self, out: &mut [f32]) {\n173\t        let dt = 1.0 / self.sample_rate;\n174\t        for frame in out.chunks_mut(2) {\n175\t            let (mut l, mut r) = (0.0, 0.0);\n176\t            for v in &mut self.voices {\n177\t                let s = v.next(dt);\n178\t                l += s * v.gain_l;\n179\t                r += s * v.gain_r;\n180\t            }\n181\t            // Soft clip.\n182\t            let m = self.master;\n183\t            frame[0] = (l * m).tanh();\n184\t            if frame.len() > 1 {\n185\t                frame[1] = (r * m).tanh();\n186\t            }\n187\t        }\n188\t        self.voices.retain(|v| !v.done());\n189\t    }\n190\t\n191\t    pub fn active(&self) -> usize {\n192\t        self.voices.len()\n193\t    }\n194\t}\n195\t\n196\t/// Where the ears are: position and the camera's right vector (for panning).\n197\t#[derive(Clone, Copy, Debug)]\n198\tpub struct Listener {\n199\t    pub pos: Vec3,\n200\t    pub right: Vec3,\n201\t}\n202\t\n203\timpl Default for Listener {\n204\t    fn default() -> Self {\n205\t        Self { pos: Vec3::ZERO, right: Vec3::X }\n206\t    }\n207\t}\n208\t\n209\t/// The sound bank: which patches play for a simulation event.\n210\tpub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n211\t    use Wave::*;\n212\t    match ev {\n213\t        SimEvent::Jump { .. } => vec![(\n214\t            Patch {\n215\t                freq_end: 640.0,\n216\t                glide: 0.11,\n217\t                decay: 0.12,\n218\t                volume: 0.18,\n219\t                cutoff: 3500.0,\n220\t                cutoff_end: 2500.0,\n221\t                duty: 0.3,\n222\t                ..Patch::new(Square, 280.0)\n223\t            },\n224\t            0.0,\n225\t        )],\n226\t        SimEvent::Land { speed, .. } => {\n227\t            let v = (speed / 14.0).clamp(0.15, 1.0);\n228\t            vec![\n229\t                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n230\t                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n231\t            ]\n232\t        }\n233\t        SimEvent::Step { .. } => {\n234\t            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n235\t        }\n236\t        SimEvent::Throw { .. } => vec![(\n237\t            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n238\t            0.0,\n239\t        )],\n240\t        SimEvent::Explosion { radius, .. } => {\n241\t            let v = (radius / 1.35).clamp(0.5, 2.0);\n242\t            vec![\n243\t                (\n244\t                    Patch {\n245\t                        attack: 0.004,\n246\t                        decay: 0.25,\n247\t                        sustain: 0.35,\n248\t                        hold: 0.1,\n249\t                        release: 0.6,\n250\t                        volume: 0.6 * v,\n251\t                        cutoff: 4000.0,\n252\t                        cutoff_end: 120.0,\n253\t                        ..Patch::new(Noise, 1.0)\n254\t                    },\n255\t                    0.0,\n256\t                ),\n257\t                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n258\t            ]\n259\t        }\n260\t        SimEvent::EnterRoom { .. } => vec![\n261\t            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n262\t            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n263\t        ],\n264\t        SimEvent::Hit { strength, .. } => {\n265\t            let v = (strength / 8.0).clamp(0.4, 1.2);\n266\t            vec![\n267\t                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n268\t                (\n269\t                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n270\t                    0.0,\n271\t                ),\n272\t            ]\n273\t        }\n274\t        // Shardfall.\n275\t        SimEvent::Swing { heavy, .. } => {\n276\t            let h = if *heavy { 1.4 } else { 1.0 };\n277\t            vec![(\n278\t                Patch {\n279\t                    attack: 0.02,\n280\t                    decay: 0.12 * h,\n281\t                    volume: 0.16 * h,\n282\t                    cutoff: 1800.0,\n283\t                    cutoff_end: 5200.0,\n284\t                    ..Patch::new(Noise, 1.0)\n285\t                },\n286\t                0.0,\n287\t            )]\n288\t        }\n289\t        SimEvent::Strike { power, element, crit, .. } => {\n290\t            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n291\t            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n292\t            let mut out = vec![\n293\t                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n294\t                (\n295\t                    Patch {\n296\t                        freq_end: tone * 0.5,\n297\t                        glide: 0.08,\n298\t                        decay: 0.1,\n299\t                        volume: 0.2 * v,\n300\t                        duty: 0.35,\n301\t                        ..Patch::new(Square, tone)\n302\t                    },\n303\t                    0.0,\n304\t                ),\n305\t            ];\n306\t            if *crit {\n307\t                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n308\t            }\n309\t            out\n310\t        }\n311\t        SimEvent::Slain { size, .. } => {\n312\t            let k = size.clamp(0.3, 1.5);\n313\t            vec![\n314\t                (\n315\t                    Patch {\n316\t                        freq_end: 60.0,\n317\t                        glide: 0.3,\n318\t                        decay: 0.3,\n319\t                        volume: 0.22 * k,\n320\t                        duty: 0.5,\n321\t                        ..Patch::new(Square, 180.0 / k)\n322\t                    },\n323\t                    0.0,\n324\t                ),\n325\t                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n326\t            ]\n327\t        }\n328\t        SimEvent::Slam { radius, .. } => {\n329\t            let k = (radius / 2.5).clamp(0.6, 1.5);\n330\t            vec![\n331\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n332\t                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n333\t            ]\n334\t        }\n335\t        SimEvent::Blast { element, .. } => {\n336\t            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n337\t            vec![\n338\t                (\n339\t                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n340\t                    0.0,\n341\t                ),\n342\t                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n343\t            ]\n344\t        }\n345\t        SimEvent::Spell { element, .. } => {\n346\t            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n347\t            vec![(\n348\t                Patch {\n349\t                    freq_end: f * 1.8,\n350\t                    glide: 0.15,\n351\t                    attack: 0.02,\n352\t                    decay: 0.18,\n353\t                    volume: 0.12,\n354\t                    duty: 0.25,\n355\t                    ..Patch::new(Saw, f)\n356\t                },\n357\t                0.0,\n358\t            )]\n359\t        }\n360\t        SimEvent::Coin { .. } => vec![\n361\t            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n362\t            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n363\t        ],\n364\t        // Drops chime by rarity: rares ring, uniques ring a chord.\n365\t        SimEvent::Loot { rarity, .. } => match rarity {\n366\t            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n367\t            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n368\t            2 => vec![\n369\t                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n370\t                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n371\t            ],\n372\t            _ => vec![\n373\t                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n374\t                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n375\t                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n376\t                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n377\t            ],\n378\t        },\n379\t        SimEvent::Pickup { .. } => {\n380\t            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n381\t        }\n382\t        SimEvent::Travel { .. } => vec![\n383\t            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n384\t            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n385\t        ],\n386\t        SimEvent::Potion { .. } => {\n387\t            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n388\t        }\n389\t        SimEvent::Block { .. } => {\n390\t            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n391\t        }\n392\t        SimEvent::LevelUp { .. } => vec![\n393\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n394\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n395\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n396\t            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n397\t        ],\n398\t        SimEvent::Respawn { .. } => vec![\n399\t            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n400\t            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n401\t        ],\n402\t        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n403\t        SimEvent::Gate { ok, .. } => {\n404\t            if *ok {\n405\t                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n406\t            } else {\n407\t                vec![(\n408\t                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n409\t                    0.0,\n410\t                )]\n411\t            }\n412\t        }\n413\t        SimEvent::CourseFinish { new_best, .. } => {\n414\t            let mut v = vec![\n415\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n416\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n417\t                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n418\t            ];\n419\t            if *new_best {\n420\t                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n421\t            }\n422\t            v\n423\t        }\n424\t        SimEvent::Checkpoint { .. } => vec![\n425\t            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n426\t            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n427\t        ],\n428\t        SimEvent::Splash { .. } => vec![(\n429\t            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n430\t            0.0,\n431\t        )],\n432\t        SimEvent::Pad { .. } => {\n433\t            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n434\t        }\n435\t        SimEvent::Grab { .. } => {\n436\t            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n437\t        }\n438\t        SimEvent::Break { .. } => vec![\n439\t            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n440\t            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n441\t        ],\n442\t        SimEvent::Crack { .. } => {\n443\t            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n444\t        }\n445\t        SimEvent::Bounce { .. } => {\n446\t            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n447\t        }\n448\t        SimEvent::Roll { .. } => vec![(\n449\t            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n450\t            0.0,\n451\t        )],\n452\t        SimEvent::Spotted { .. } => vec![\n453\t            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n454\t            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n455\t        ],\n456\t        SimEvent::Shot { .. } => {\n457\t            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n458\t        }\n459\t        SimEvent::Damage { .. } => {\n460\t            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n461\t        }\n462\t        SimEvent::Destroyed { size, .. } => {\n463\t            let v = size.clamp(0.4, 2.0);\n464\t            vec![\n465\t                (\n466\t                    Patch {\n467\t                        attack: 0.003,\n468\t                        decay: 0.3,\n469\t                        volume: 0.35 * v,\n470\t                        cutoff: 5000.0,\n471\t                        cutoff_end: 200.0,\n472\t                        ..Patch::new(Noise, 1.0)\n473\t                    },\n474\t                    0.0,\n475\t                ),\n476\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n477\t            ]\n478\t        }\n479\t        _ => Vec::new(),\n480\t    }\n481\t}\n482\t\n483\t/// Position of an event (None = not spatial).\n484\tpub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n485\t    match ev {\n486\t        SimEvent::Jump { pos }\n487\t        | SimEvent::Land { pos, .. }\n488\t        | SimEvent::Step { pos }\n489\t        | SimEvent::Throw { pos }\n490\t        | SimEvent::Explosion { pos, .. }\n491\t        | SimEvent::Impact { pos, .. }\n492\t        | SimEvent::Hit { pos, .. }\n493\t        | SimEvent::Splash { pos }\n494\t        | SimEvent::Grab { pos }\n495\t        | SimEvent::Roll { pos }\n496\t        | SimEvent::Break { pos }\n497\t        | SimEvent::Crack { pos }\n498\t        | SimEvent::Bounce { pos }\n499\t        | SimEvent::Shot { pos }\n500\t        | SimEvent::Damage { pos }\n501\t        | SimEvent::Destroyed { pos, .. }\n502\t        | SimEvent::Swing { pos, .. }\n503\t        | SimEvent::Strike { pos, .. }\n504\t        | SimEvent::Slain { pos, .. }\n505\t        | SimEvent::Slam { pos, .. }\n506\t        | SimEvent::Blast { pos, .. }\n507\t        | SimEvent::Spell { pos, .. }\n508\t        | SimEvent::Coin { pos }\n509\t        | SimEvent::Loot { pos, .. }\n510\t        | SimEvent::Pickup { pos, .. }\n511\t        | SimEvent::Block { pos } => Some(*pos),\n512\t        _ => None,\n513\t    }\n514\t}\n515\t\n516\t/// Plays an event's sounds with distance attenuation and panning.\n517\tpub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n518\t    let (pan, gain) = match event_pos(ev) {\n519\t        Some(p) => {\n520\t            let d = p - l.pos;\n521\t            let dist = d.length();\n522\t            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n523\t        }\n524\t        None => (0.0, 1.0),\n525\t    };\n526\t    for (patch, delay) in sounds_for(ev) {\n527\t        mixer.play(patch, pan, gain * sfx, delay);\n528\t    }\n529\t}\n530\t\n531\t/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\n532\tpub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n533\t    let mut mixer = Mixer::new(sample_rate);\n534\t    let total = (duration * sample_rate) as usize;\n535\t    let mut out = vec![0.0f32; total * 2];\n536\t    let block = 256;\n537\t    let mut i = 0;\n538\t    let mut ev = events.iter().peekable();\n539\t    while i < total {\n540\t        let t = i as f32 / sample_rate;\n541\t        while let Some((et, e)) = ev.peek() {\n542\t            if *et > t {\n543\t                break;\n544\t            }\n545\t            play_event(&mut mixer, e, l, 1.0);\n546\t            ev.next();\n547\t        }\n548\t        let n = block.min(total - i);\n549\t        mixer.render(&mut out[i * 2..(i + n) * 2]);\n550\t        i += n;\n551\t    }\n552\t    out\n553\t}\n554\t\n555\t/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\n556\tpub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n557\t    let data_len = (samples.len() * 2) as u32;\n558\t    let mut b = Vec::with_capacity(44 + data_len as usize);\n559\t    b.extend_from_slice(b\"RIFF\");\n560\t    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n561\t    b.extend_from_slice(b\"WAVEfmt \");\n562\t    b.extend_from_slice(&16u32.to_le_bytes());\n563\t    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n564\t    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n565\t    b.extend_from_slice(&sample_rate.to_le_bytes());\n566\t    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n567\t    b.extend_from_slice(&4u16.to_le_bytes());\n568\t    b.extend_from_slice(&16u16.to_le_bytes());\n569\t    b.extend_from_slice(b\"data\");\n570\t    b.extend_from_slice(&data_len.to_le_bytes());\n571\t    for s in samples {\n572\t        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n573\t    }\n574\t    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n575\t        std::fs::create_dir_all(d)?;\n576\t    }\n577\t    std::fs::write(path, b)\n578\t}\n579\t\n580\tenum Cmd {\n581\t    Play(Patch, f32, f32, f32),\n582\t    Master(f32),\n583\t}\n584\t\n585\t/// Live output through the default sound device.\n586\tpub struct AudioOut {\n587\t    _stream: cpal::Stream,\n588\t    tx: Sender<Cmd>,\n589\t    pub sample_rate: u32,\n590\t    pub device: String,\n591\t}\n592\t\n593\timpl AudioOut {\n594\t    pub fn start() -> anyhow::Result<Self> {\n595\t        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n596\t        let host = cpal::default_host();\n597\t        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n598\t        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n599\t        let supported = device.default_output_config()?;\n600\t        let format = supported.sample_format();\n601\t        let config: cpal::StreamConfig = supported.config();\n602\t        let rate = config.sample_rate as u32;\n603\t        let channels = config.channels as usize;\n604\t        let (tx, rx) = channel::<Cmd>();\n605\t        let stream = match format {\n606\t            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n607\t            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n608\t            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n609\t            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n610\t        };\n611\t        stream.play()?;\n612\t        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n613\t    }\n614\t\n615\t    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n616\t        let (pan, gain) = match event_pos(ev) {\n617\t            Some(p) => {\n618\t                let d = p - l.pos;\n619\t                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n620\t            }\n621\t            None => (0.0, 1.0),\n622\t        };\n623\t        for (patch, delay) in sounds_for(ev) {\n624\t            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n625\t        }\n626\t    }\n627\t\n628\t    pub fn set_master(&self, v: f32) {\n629\t        let _ = self.tx.send(Cmd::Master(v));\n630\t    }\n631\t\n632\t    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n633\t    /// so the browser build calls this on the first input.\n634\t    pub fn resume(&self) {\n635\t        use cpal::traits::StreamTrait;\n636\t        let _ = self._stream.play();\n637\t    }\n638\t}\n639\t\n640\tfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\n641\twhere\n642\t    T: cpal::SizedSample + cpal::FromSample<f32>,\n643\t{\n644\t    use cpal::traits::DeviceTrait;\n645\t    let mut mixer = Mixer::new(config.sample_rate as f32);\n646\t    let mut buf: Vec<f32> = Vec::new();\n647\t    let stream = device.build_output_stream::<T, _, _>(\n648\t        config,\n649\t        move |data: &mut [T], _| {\n650\t            while let Ok(c) = rx.try_recv() {\n651\t                match c {\n652\t                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n653\t                    Cmd::Master(v) => mixer.master = v,\n654\t                }\n655\t            }\n656\t            let frames = data.len() / channels.max(1);\n657\t            buf.resize(frames * 2, 0.0);\n658\t            mixer.render(&mut buf);\n659\t            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n660\t                for (c, s) in frame.iter_mut().enumerate() {\n661\t                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n662\t                }\n663\t            }\n664\t        },\n665\t        |e| log::warn!(\"audio stream error: {e}\"),\n666\t        None,\n667\t    )?;\n668\t    Ok(stream)\n669\t}\n670\t\n671\t#[cfg(test)]\n672\tmod tests {\n673\t    use super::*;\n674\t\n675\t    #[test]\n676\t    fn explosion_is_loud_then_silent() {\n677\t        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n678\t        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n679\t        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n680\t        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n681\t        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n682\t        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n683\t    }\n684\t}\n685\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"57f5b5f0-7a61-42bb-b677-f68792042073","timestamp":"2026-11-05T13:32:03.953Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_audio/src/lib.rs","content":"//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n//! runs fine without a sound device.\n\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\nuse glam::Vec3;\nuse pav_core::SimEvent;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Wave {\n    Sine,\n    Square,\n    Saw,\n    Triangle,\n    Noise,\n}\n\n/// One synthesized sound.\n#[derive(Clone, Copy, Debug)]\npub struct Patch {\n    pub wave: Wave,\n    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n    pub freq: f32,\n    pub freq_end: f32,\n    pub glide: f32,\n    pub attack: f32,\n    pub decay: f32,\n    pub sustain: f32,\n    pub hold: f32,\n    pub release: f32,\n    pub volume: f32,\n    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n    pub cutoff: f32,\n    pub cutoff_end: f32,\n    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n\nimpl Patch {\n    pub const fn new(wave: Wave, freq: f32) -> Self {\n        Self {\n            wave,\n            freq,\n            freq_end: freq,\n            glide: 0.1,\n            attack: 0.002,\n            decay: 0.1,\n            sustain: 0.0,\n            hold: 0.0,\n            release: 0.05,\n            volume: 0.3,\n            cutoff: 12000.0,\n            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }\n    pub fn length(&self) -> f32 {\n        self.attack + self.decay + self.hold + self.release\n    }\n}\n\nstruct Voice {\n    p: Patch,\n    t: f32,\n    delay: f32,\n    phase: f32,\n    lp: f32,\n    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\n    fn env(&self) -> f32 {\n        let p = &self.p;\n        let t = self.t;\n        if t < p.attack {\n            return t / p.attack.max(1e-5);\n        }\n        let t = t - p.attack;\n        if t < p.decay {\n            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n        }\n        let t = t - p.decay;\n        if t < p.hold {\n            return p.sustain;\n        }\n        let t = t - p.hold;\n        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n    }\n\n    fn done(&self) -> bool {\n        self.t > self.p.length() + 0.01\n    }\n\n    fn next(&mut self, dt: f32) -> f32 {\n        if self.delay > 0.0 {\n            self.delay -= dt;\n            return 0.0;\n        }\n        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        self.phase = (self.phase + freq * dt).fract();\n        let ph = self.phase;\n        let raw = match p.wave {\n            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n            Wave::Square => {\n                if ph < p.duty {\n                    1.0\n                } else {\n                    -1.0\n                }\n            }\n            Wave::Saw => ph * 2.0 - 1.0,\n            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n            Wave::Noise => {\n                self.noise ^= self.noise << 13;\n                self.noise ^= self.noise >> 17;\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n        }\n        SimEvent::Slam { radius, .. } => {\n            let k = (radius / 2.5).clamp(0.6, 1.5);\n            vec![\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            ]\n        }\n        SimEvent::Blast { element, .. } => {\n            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n            vec![\n                (\n                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n                    0.0,\n                ),\n                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        SimEvent::Spell { element, .. } => {\n            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n            vec![(\n                Patch {\n                    freq_end: f * 1.8,\n                    glide: 0.15,\n                    attack: 0.02,\n                    decay: 0.18,\n                    volume: 0.12,\n                    duty: 0.25,\n                    ..Patch::new(Saw, f)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Coin { .. } => vec![\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n        ],\n        // Drops chime by rarity: rares ring, uniques ring a chord.\n        SimEvent::Loot { rarity, .. } => match rarity {\n            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n            2 => vec![\n                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n            ],\n            _ => vec![\n                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n            ],\n        },\n        SimEvent::Pickup { .. } => {\n            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n        }\n        SimEvent::Travel { .. } => vec![\n            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n        ],\n        SimEvent::Potion { .. } => {\n            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n        }\n        SimEvent::Block { .. } => {\n            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n        }\n        SimEvent::LevelUp { .. } => vec![\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n        ],\n        SimEvent::Respawn { .. } => vec![\n            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n        ],\n        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n        SimEvent::Gate { ok, .. } => {\n            if *ok {\n                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n            } else {\n                vec![(\n                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n                    0.0,\n                )]\n            }\n        }\n        SimEvent::CourseFinish { new_best, .. } => {\n            let mut v = vec![\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n            ];\n            if *new_best {\n                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n            }\n            v\n        }\n        SimEvent::Checkpoint { .. } => vec![\n            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n        ],\n        SimEvent::Splash { .. } => vec![(\n            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Pad { .. } => {\n            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n        }\n        SimEvent::Grab { .. } => {\n            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Break { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n        ],\n        SimEvent::Crack { .. } => {\n            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Bounce { .. } => {\n            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n        }\n        SimEvent::Roll { .. } => vec![(\n            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Spotted { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n        ],\n        SimEvent::Shot { .. } => {\n            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n        }\n        SimEvent::Damage { .. } => {\n            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.003,\n                        decay: 0.3,\n                        volume: 0.35 * v,\n                        cutoff: 5000.0,\n                        cutoff_end: 200.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\npub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n    match ev {\n        SimEvent::Jump { pos }\n        | SimEvent::Land { pos, .. }\n        | SimEvent::Step { pos }\n        | SimEvent::Throw { pos }\n        | SimEvent::Explosion { pos, .. }\n        | SimEvent::Impact { pos, .. }\n        | SimEvent::Hit { pos, .. }\n        | SimEvent::Splash { pos }\n        | SimEvent::Grab { pos }\n        | SimEvent::Roll { pos }\n        | SimEvent::Break { pos }\n        | SimEvent::Crack { pos }\n        | SimEvent::Bounce { pos }\n        | SimEvent::Shot { pos }\n        | SimEvent::Damage { pos }\n        | SimEvent::Destroyed { pos, .. }\n        | SimEvent::Swing { pos, .. }\n        | SimEvent::Strike { pos, .. }\n        | SimEvent::Slain { pos, .. }\n        | SimEvent::Slam { pos, .. }\n        | SimEvent::Blast { pos, .. }\n        | SimEvent::Spell { pos, .. }\n        | SimEvent::Coin { pos }\n        | SimEvent::Loot { pos, .. }\n        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),\n        _ => None,\n    }\n}\n\n/// Plays an event's sounds with distance attenuation and panning.\npub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain) = match event_pos(ev) {\n        Some(p) => {\n            let d = p - l.pos;\n            let dist = d.length();\n            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n        }\n        None => (0.0, 1.0),\n    };\n    for (patch, delay) in sounds_for(ev) {\n        mixer.play(patch, pan, gain * sfx, delay);\n    }\n}\n\n/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\npub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n    let mut mixer = Mixer::new(sample_rate);\n    let total = (duration * sample_rate) as usize;\n    let mut out = vec![0.0f32; total * 2];\n    let block = 256;\n    let mut i = 0;\n    let mut ev = events.iter().peekable();\n    while i < total {\n        let t = i as f32 / sample_rate;\n        while let Some((et, e)) = ev.peek() {\n            if *et > t {\n                break;\n            }\n            play_event(&mut mixer, e, l, 1.0);\n            ev.next();\n        }\n        let n = block.min(total - i);\n        mixer.render(&mut out[i * 2..(i + n) * 2]);\n        i += n;\n    }\n    out\n}\n\n/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\npub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n    let data_len = (samples.len() * 2) as u32;\n    let mut b = Vec::with_capacity(44 + data_len as usize);\n    b.extend_from_slice(b\"RIFF\");\n    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n    b.extend_from_slice(b\"WAVEfmt \");\n    b.extend_from_slice(&16u32.to_le_bytes());\n    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n    b.extend_from_slice(&sample_rate.to_le_bytes());\n    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n    b.extend_from_slice(&4u16.to_le_bytes());\n    b.extend_from_slice(&16u16.to_le_bytes());\n    b.extend_from_slice(b\"data\");\n    b.extend_from_slice(&data_len.to_le_bytes());\n    for s in samples {\n        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n    }\n    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n        std::fs::create_dir_all(d)?;\n    }\n    std::fs::write(path, b)\n}\n\nenum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n    }\n}\n","numLines":685,"startLine":1,"totalLines":685}},"tool_result_meta":[{"id":"toolu_01VdWMbMBKytMsoDY4B28Ech","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
