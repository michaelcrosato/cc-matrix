{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjvbshN8uF6cBZVwaXGy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0189nB5A4vKi6ZTzmg7o7jY9","name":"Bash","input":{"command":"cat > crates/pav_ui/src/surgery/mod.rs <<'EOF'\n//! The surgery game's screens: a state machine in plain Rust plus egui's painter, with its own\n//! focus lists. It takes an abstract input (nav, confirm, back, tabs, pointer, last device) and\n//! emits commands, so `cargo test` can drive it without a GPU and the tools draw the same thing the\n//! window does.\n\npub mod about;\npub mod card;\npub mod dev;\npub mod glyphs;\npub mod hud;\npub mod menus;\npub mod results;\npub mod save;\npub mod settings;\npub mod story;\npub mod style;\n\nuse std::collections::HashMap;\n\nuse egui::{Painter, Pos2, Rect};\nuse glam::Mat4;\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::tune::Tune;\nuse pav_core::input::SurgeryCmd;\nuse serde_json::json;\n\nuse crate::Device;\nuse glyphs::Glyphs;\nuse save::Save;\n\n/// The game's title, in one place: the title screen, the page title, the hub card, About.\npub const TITLE: &str = \"Diorama Center: Second Opinion\";\npub const TAGLINE: &str = \"You are the hands.\";\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Screen {\n    /// The title: any confirm goes to the menu.\n    Title,\n    Menu,\n    Difficulty,\n    CaseFiles,\n    Settings,\n    About,\n    Controls,\n    /// No menu: the game's own HUD, story, chart, results and death screens.\n    Playing,\n    Pause,\n    Dev,\n    Attract,\n    /// A hub session's board.\n    Card,\n    /// A hub session in play: no pause, no restart, no quit.\n    Session,\n}\n\n/// One frame's abstract input. Directions are held state; the shell makes the repeats.\n#[derive(Clone, Copy, Debug, Default)]\npub struct ShellInput {\n    pub up: bool,\n    pub down: bool,\n    pub left: bool,\n    pub right: bool,\n    pub confirm: bool,\n    pub confirm_held: bool,\n    pub back: bool,\n    pub tab_prev: bool,\n    pub tab_next: bool,\n    pub pause: bool,\n    /// Square or Tab.\n    pub chart: bool,\n    /// Triangle or A/M.\n    pub alt: bool,\n    /// The pointer in canvas points, when there is one.\n    pub pointer: Option<Pos2>,\n    pub pointer_moved: bool,\n    pub click: bool,\n    /// Pointer button held (sliders).\n    pub drag: bool,\n    /// Any key, button, stick, click, move or tap at all.\n    pub any: bool,\n    /// A finger's tap (touch-only: only the Settings button answers it).\n    pub tap: Option<Pos2>,\n    pub device: Device,\n    pub dt: f32,\n}\n\n/// What the shell asks of the app.\n#[derive(Clone, Debug, PartialEq)]\npub enum ShellCmd {\n    /// Load a scene (fresh sim).\n    Load(String),\n    /// A game command for the sim.\n    Sim(SurgeryCmd),\n    /// Sim time runs or stops.\n    Paused(bool),\n    /// A UI sound (a cue id).\n    Cue(u16),\n    /// Store this save text.\n    Save(String),\n    Fullscreen(bool),\n    /// Sound levels changed.\n    Mix { music: f32, effects: f32, voices: f32 },\n    /// Dev: one tick while paused.\n    FrameStep,\n    /// Dev: back five seconds.\n    Rewind,\n    SnapshotSave,\n    SnapshotLoad,\n    ReloadContent,\n    /// Hub card answers.\n    HubReady,\n    HubMore,\n}\n\n/// What the hub tells the card.\n#[derive(Clone, Debug, Default)]\npub struct HubCard {\n    /// (id, name, seat colour index)\n    pub players: Vec<(u32, String)>,\n    pub ready: Vec<u32>,\n    pub me: Option<u32>,\n    pub left_ms: Option<f64>,\n    pub paused: bool,\n    pub starting: bool,\n    pub asking: u32,\n    pub asked: bool,\n    pub countdown: Option<f32>,\n}\n\n/// The dev panel's state.\n#[derive(Clone, Debug)]\npub struct DevState {\n    pub page: usize,\n    pub live: bool,\n    pub bot_plays: bool,\n    pub immortal: bool,\n    pub freeze: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub time_scale: f32,\n    pub jump_case: u8,\n    pub jump_phase: u8,\n    pub spawn_kind: u8,\n    pub overlays: u32,\n    pub stats: bool,\n    pub tune: Tune,\n    pub status: String,\n    /// Frames and ticks per second, from the app.\n    pub fps: f32,\n    pub tps: f32,\n}\n\nimpl Default for DevState {\n    fn default() -> Self {\n        Self {\n            page: 0,\n            live: false,\n            bot_plays: false,\n            immortal: false,\n            freeze: false,\n            full_gift: false,\n            one_hit: false,\n            time_scale: 1.0,\n            jump_case: 0,\n            jump_phase: 0,\n            spawn_kind: 4,\n            overlays: 0,\n            stats: false,\n            tune: Tune::default(),\n            status: String::new(),\n            fps: 0.0,\n            tps: 0.0,\n        }\n    }\n}\n\npub struct Shell {\n    pub screen: Screen,\n    /// Where Back returns from Settings, Controls, About.\n    pub came_from: Screen,\n    pub focus: usize,\n    pub page: usize,\n    pub idle: f32,\n    pub time: f32,\n    pub save: Save,\n    pub about: about::About,\n    pub dev: DevState,\n    pub device: Device,\n    /// Touch-only: no fine pointer, no key or pad so far.\n    pub touch_only: bool,\n    pub hub_active: bool,\n    pub hub_card: Option<HubCard>,\n    /// Text the page wants on the title about sound.\n    pub sound_note: bool,\n    pub chart_open: bool,\n    pub backlog: bool,\n    pub auto_advance: bool,\n    /// Hold-to-skip progress.\n    pub hold: f32,\n    /// The scene in the sim, as the shell last asked.\n    pub scene: String,\n    pub prompts: Vec<&'static str>,\n    pub cmds: Vec<ShellCmd>,\n    pub started_case: Option<u8>,\n    pub case_files_mode: bool,\n    /// How long since the last line advanced by itself.\n    pub auto_t: f32,\n    nav_t: [f32; 4],\n    nav_edge: [bool; 4],\n    pub hud: hud::HudState,\n    cameos: HashMap<String, story::Cameo>,\n    pub saved_this_results: bool,\n    pub last_stage: Stage,\n    pub is_native: bool,\n    pub clicked_hint: bool,\n}\n\nimpl Default for Shell {\n    fn default() -> Self {\n        Self::new(Save::default())\n    }\n}\n\n/// Seconds without input on a menu before attract starts.\npub const ATTRACT_AFTER: f32 = 10.0;\n\nimpl Shell {\n    pub fn new(save: Save) -> Self {\n        Self {\n            screen: Screen::Title,\n            came_from: Screen::Menu,\n            focus: 0,\n            page: 0,\n            idle: 0.0,\n            time: 0.0,\n            save,\n            about: about::About::built_in(),\n            dev: DevState::default(),\n            device: Device::KeyboardMouse,\n            touch_only: false,\n            hub_active: false,\n            hub_card: None,\n            sound_note: false,\n            chart_open: false,\n            backlog: false,\n            auto_advance: false,\n            hold: 0.0,\n            scene: \"surgery/title\".into(),\n            prompts: Vec::new(),\n            cmds: Vec::new(),\n            started_case: None,\n            case_files_mode: false,\n            auto_t: 0.0,\n            nav_t: [0.0; 4],\n            nav_edge: [false; 4],\n            hud: hud::HudState::default(),\n            cameos: HashMap::new(),\n            saved_this_results: false,\n            last_stage: Stage::Title,\n            is_native: !cfg!(target_arch = \"wasm32\"),\n            clicked_hint: false,\n        }\n    }\n\n    pub fn glyphs(&self) -> Glyphs {\n        Glyphs { device: self.device, xbox: self.save.settings.xbox }\n    }\n\n    /// Records a prompt: what the tests read to see what's on screen.\n    pub fn prompted(&mut self, g: Glyphs, a: glyphs::Action) {\n        let id = glyphs::glyph_id(g, a);\n        if !self.prompts.contains(&id) {\n            self.prompts.push(id);\n        }\n    }\n\n    pub fn load(&mut self, scene: &str) {\n        self.scene = scene.to_string();\n        self.cmds.push(ShellCmd::Load(scene.to_string()));\n    }\n\n    pub fn sim(&mut self, c: SurgeryCmd) {\n        self.cmds.push(ShellCmd::Sim(c));\n    }\n\n    pub fn cue(&mut self, id: u16) {\n        self.cmds.push(ShellCmd::Cue(id));\n    }\n\n    pub fn persist(&mut self) {\n        self.cmds.push(ShellCmd::Save(self.save.to_text()));\n    }\n\n    pub fn go(&mut self, s: Screen) {\n        self.screen = s;\n        self.focus = 0;\n        self.page = 0;\n    }\n\n    /// Edges with auto-repeat for held directions: 0 up, 1 down, 2 left, 3 right.\n    fn update_nav(&mut self, i: &ShellInput) {\n        for (k, held) in [i.up, i.down, i.left, i.right].into_iter().enumerate() {\n            self.nav_edge[k] = false;\n            if held {\n                if self.nav_t[k] <= 0.0 {\n                    self.nav_edge[k] = true;\n                    self.nav_t[k] = 0.32;\n                } else {\n                    self.nav_t[k] -= i.dt;\n                    if self.nav_t[k] <= 0.0 {\n                        self.nav_edge[k] = true;\n                        self.nav_t[k] = 0.11;\n                    }\n                }\n            } else {\n                self.nav_t[k] = 0.0;\n            }\n        }\n    }\n\n    pub fn nav(&self, k: usize) -> bool {\n        self.nav_edge[k]\n    }\n\n    /// The JSON the test hook reads.\n    pub fn status(&self) -> serde_json::Value {\n        json!({\n            \"screen\": format!(\"{:?}\", self.screen),\n            \"focus\": self.focus,\n            \"page\": self.page,\n            \"device\": match self.device { Device::Gamepad => \"pad\", Device::KeyboardMouse => \"mouse\", Device::Touch => \"touch\" },\n            \"prompts\": self.prompts,\n            \"idle\": self.idle,\n            \"scene\": self.scene,\n            \"touch_only\": self.touch_only,\n            \"music\": self.save.settings.music,\n            \"effects\": self.save.settings.effects,\n            \"voices\": self.save.settings.voices,\n            \"xbox\": self.save.settings.xbox,\n            \"dev_page\": self.dev.page,\n            \"chart_open\": self.chart_open,\n            \"backlog\": self.backlog,\n            \"hub\": self.hub_active,\n        })\n    }\n\n    /// One frame: reads input, draws the screen over the game, and leaves commands in `self.cmds`.\n    pub fn frame(&mut self, ctx: &egui::Context, input: &ShellInput, frame: Option<&SurgeryFrame>, vp: Mat4) {\n        self.time += input.dt;\n        self.prompts.clear();\n        self.device = input.device;\n        self.update_nav(input);\n        if input.any {\n            self.idle = 0.0;\n        } else {\n            self.idle += input.dt;\n        }\n        let screen_rect = ctx.content_rect();\n        let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Middle, egui::Id::new(\"surgery_shell\")));\n        let rect = screen_rect;\n        // A new stage clears what a screen opened over the old one.\n        if let Some(f) = frame {\n            if f.stage != self.last_stage {\n                self.on_stage(f);\n            }\n        }\n        match self.screen {\n            Screen::Title => self.title(&painter, rect, input, frame),\n            Screen::Menu => self.main_menu(&painter, rect, input),\n            Screen::Difficulty => self.difficulty(&painter, rect, input),\n            Screen::CaseFiles => self.case_files(&painter, rect, input),\n            Screen::Settings => settings::screen(self, &painter, rect, input),\n            Screen::About => about::screen(self, &painter, rect, input),\n            Screen::Controls => self.controls(&painter, rect, input),\n            Screen::Playing | Screen::Session => self.playing(&painter, rect, input, frame, vp),\n            Screen::Pause => {\n                if let Some(f) = frame {\n                    hud::draw(self, &painter, rect, f, vp, input);\n                }\n                self.pause_menu(&painter, rect, input);\n            }\n            Screen::Dev => {\n                if let Some(f) = frame {\n                    hud::draw(self, &painter, rect, f, vp, input);\n                }\n                dev::screen(self, &painter, rect, input, frame);\n            }\n            Screen::Attract => self.attract(&painter, rect, input, frame, vp),\n            Screen::Card => card::screen(self, &painter, rect, input),\n        }\n        // Idle on the title or a main-menu screen: attract.\n        let idle_screen = matches!(self.screen, Screen::Title | Screen::Menu | Screen::Difficulty | Screen::CaseFiles | Screen::Settings | Screen::About | Screen::Controls);\n        if idle_screen && !self.hub_active && self.idle > ATTRACT_AFTER && self.came_from != Screen::Pause {\n            self.screen = Screen::Attract;\n            self.idle = 0.0;\n            self.load(\"surgery/attract\");\n        }\n    }\n\n    fn on_stage(&mut self, f: &SurgeryFrame) {\n        self.last_stage = f.stage;\n        self.chart_open = false;\n        self.backlog = false;\n        self.hold = 0.0;\n        self.saved_this_results = false;\n    }\n\n    /// Draws the game's own screens and runs their input.\n    fn playing(&mut self, p: &Painter, rect: Rect, i: &ShellInput, frame: Option<&SurgeryFrame>, vp: Mat4) {\n        let Some(f) = frame else { return };\n        let session = self.screen == Screen::Session;\n        match f.stage {\n            Stage::Story => story::draw(self, p, rect, f, i),\n            Stage::Chart => results::chart(self, p, rect, f, i),\n            Stage::Results => results::results(self, p, rect, f, i),\n            Stage::Dead => results::death(self, p, rect, f, i),\n            Stage::Finished => results::finished(self, p, rect, f, i),\n            _ => hud::draw(self, p, rect, f, vp, i),\n        }\n        if i.pause && !session && !matches!(f.stage, Stage::Finished) {\n            self.cue(pav_core::games::surgery::cue::NAV);\n            self.go(Screen::Pause);\n            self.cmds.push(ShellCmd::Paused(true));\n        }\n    }\n\n    /// Back to the title, from wherever.\n    pub fn quit_to_title(&mut self) {\n        self.cmds.push(ShellCmd::Paused(false));\n        self.load(\"surgery/title\");\n        self.go(Screen::Title);\n    }\n}\n\n#[cfg(test)]\nmod tests;\nEOF\ncat > crates/pav_ui/src/surgery/menus.rs <<'EOF'\n//! The focus-list screens: title, main menu, difficulty, case files, pause, controls, attract.\n\nuse egui::{Align2, Color32, Painter, Pos2, Rect, StrokeKind, pos2, vec2};\nuse glam::Mat4;\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::tune::{DIFFICULTIES, cheat};\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Screen, Shell, ShellCmd, ShellInput, TAGLINE, TITLE};\nuse crate::Device;\n\nimpl Shell {\n    /// A focus list: nav moves the focus, hover moves the focus, a click or confirm activates.\n    pub fn list(&mut self, p: &Painter, i: &ShellInput, items: &[String], at: Pos2, width: f32, step: f32, size: f32) -> Option<usize> {\n        if items.is_empty() {\n            return None;\n        }\n        let n = items.len();\n        self.focus = self.focus.min(n - 1);\n        if self.nav(0) {\n            self.focus = (self.focus + n - 1) % n;\n            self.cue(cue::NAV);\n        }\n        if self.nav(1) {\n            self.focus = (self.focus + 1) % n;\n            self.cue(cue::NAV);\n        }\n        let mut chosen = None;\n        for (k, text) in items.iter().enumerate() {\n            let r = Rect::from_min_size(at + vec2(0.0, step * k as f32), vec2(width, step - 8.0));\n            let over = i.pointer.is_some_and(|q| r.contains(q));\n            if over && i.pointer_moved && self.focus != k {\n                self.focus = k;\n                self.cue(cue::NAV);\n            }\n            if over && i.click {\n                chosen = Some(k);\n            }\n        }\n        for (k, text) in items.iter().enumerate() {\n            let r = Rect::from_min_size(at + vec2(0.0, step * k as f32), vec2(width, step - 8.0));\n            let f = k == self.focus;\n            if f {\n                let pulse = (self.time * 3.0).sin() * 0.1 + 0.9;\n                p.rect_filled(r, 10.0, style::with_alpha(TEAL, 0.24 * pulse));\n                p.rect_stroke(r, 10.0, egui::Stroke::new(3.0, style::with_alpha(TEAL, pulse)), StrokeKind::Inside);\n                p.rect_filled(Rect::from_min_size(r.min, vec2(8.0, r.height())), 4.0, GOLD);\n            }\n            style::outlined(p, r.left_center() + vec2(30.0, 0.0), Align2::LEFT_CENTER, text, size, if f { Color32::WHITE } else { INK });\n        }\n        if i.confirm {\n            chosen = Some(self.focus);\n        }\n        if chosen.is_some() {\n            self.cue(cue::CONFIRM);\n        }\n        chosen\n    }\n\n    /// The bottom prompt row.\n    pub fn hints(&mut self, p: &Painter, rect: Rect, list: &[(Action, &str)]) {\n        let g = self.glyphs();\n        let mut x = rect.min.x + 60.0;\n        let y = rect.max.y - 52.0;\n        for (a, label) in list {\n            self.prompted(g, *a);\n            x = glyphs::labeled(p, pos2(x, y), 38.0, g, *a, label, INK);\n        }\n    }\n\n    pub fn backdrop(&self, p: &Painter, rect: Rect, a: f32) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, a));\n    }\n\n    pub fn title(&mut self, p: &Painter, rect: Rect, i: &ShellInput, f: Option<&SurgeryFrame>) {\n        let c = rect.center();\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.28));\n        let y = rect.min.y + 330.0;\n        let t = style::outlined(p, pos2(c.x, y), Align2::CENTER_CENTER, TITLE, 104.0, Color32::WHITE);\n        style::outlined(p, pos2(c.x, y + 78.0), Align2::CENTER_CENTER, TAGLINE, 44.0, TEAL);\n        // The ECG line draws the title's underline.\n        let (x0, x1) = (t.min.x, t.max.x);\n        let yy = y + 44.0;\n        let beat = f.map(|f| f.beat).unwrap_or(0.0);\n        let beats = f.map(|f| f.beats).unwrap_or(0) as f32 + beat;\n        let n = 180;\n        let pts: Vec<Pos2> = (0..=n)\n            .map(|k| {\n                let t = k as f32 / n as f32;\n                let x = x0 + (x1 - x0) * t;\n                let ph = (beats * 0.4 + t * 2.0).fract();\n                pos2(x, yy - hud::ecg_wave(ph) * 22.0)\n            })\n            .collect();\n        p.add(egui::Shape::line(pts, egui::Stroke::new(3.0, style::GREEN)));\n        if self.touch_only {\n            style::outlined(p, pos2(c.x, c.y + 150.0), Align2::CENTER_CENTER, \"Controller or keyboard required\", 54.0, GOLD);\n            // Touch-only: one button a tap can use.\n            let r = Rect::from_center_size(pos2(c.x, c.y + 260.0), vec2(360.0, 90.0));\n            p.rect_filled(r, 12.0, style::with_alpha(TEAL, 0.3));\n            p.rect_stroke(r, 12.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n            style::outlined(p, r.center(), Align2::CENTER_CENTER, \"Settings\", 48.0, Color32::WHITE);\n            if i.tap.is_some_and(|q| r.contains(q)) {\n                self.came_from = Screen::Title;\n                self.go(Screen::Settings);\n            }\n            return;\n        }\n        let pulse = ((self.time * 2.4).sin() * 0.5 + 0.5) * 0.5 + 0.5;\n        let g = self.glyphs();\n        self.prompted(g, Action::Confirm);\n        let w = glyphs::draw(p, pos2(c.x - 170.0, c.y + 190.0), 54.0, g, Action::Confirm);\n        style::outlined(p, pos2(c.x - 170.0 + w + 14.0, c.y + 190.0), Align2::LEFT_CENTER, \"Press to scrub in\", 50.0, style::with_alpha(INK, pulse));\n        if self.sound_note {\n            style::outlined(p, pos2(c.x, rect.max.y - 70.0), Align2::CENTER_CENTER, \"Press a key or click for sound\", 32.0, style::DIM);\n        }\n        if i.confirm || i.click {\n            self.cue(cue::CONFIRM);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn main_menu(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.5));\n        style::outlined(p, rect.min + vec2(120.0, 96.0), Align2::LEFT_CENTER, TITLE, 62.0, Color32::WHITE);\n        let can_continue = self.save.started;\n        let mut items = Vec::new();\n        if can_continue {\n            items.push(\"Continue\".to_string());\n        }\n        items.extend([\"New Game\", \"Case Files\", \"Code Blue\", \"Settings\", \"About\"].map(String::from));\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 240.0), 620.0, 104.0, 60.0);\n        self.hints(p, rect, &[(Action::Nav, \"Choose\"), (Action::Confirm, \"Select\"), (Action::Back, \"Title\")]);\n        if let Some(k) = chosen {\n            let name = items[k].as_str();\n            match name {\n                \"Continue\" => {\n                    self.sim_diff();\n                    let scene = format!(\"surgery/campaign/{}\", self.save.last_case);\n                    self.load(&scene);\n                    self.go(Screen::Playing);\n                    self.case_files_mode = false;\n                }\n                \"New Game\" => self.go(Screen::Difficulty),\n                \"Case Files\" => self.go(Screen::CaseFiles),\n                \"Code Blue\" => {\n                    self.sim_diff();\n                    self.load(\"surgery/codeblue\");\n                    self.go(Screen::Playing);\n                    self.case_files_mode = true;\n                }\n                \"Settings\" => {\n                    self.came_from = Screen::Menu;\n                    self.go(Screen::Settings);\n                }\n                _ => {\n                    self.came_from = Screen::Menu;\n                    self.go(Screen::About);\n                }\n            }\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Title);\n        }\n    }\n\n    /// The difficulty rides on a command right after a scene loads.\n    pub fn sim_diff(&mut self) {\n        let d = self.save.difficulty;\n        self.cmds.push(ShellCmd::Sim(SurgeryCmd::Difficulty(d)));\n    }\n\n    pub fn difficulty(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.6));\n        style::outlined(p, rect.min + vec2(120.0, 110.0), Align2::LEFT_CENTER, \"How is your nerve, Doctor?\", 66.0, Color32::WHITE);\n        let items: Vec<String> = DIFFICULTIES.iter().map(|d| d.name.to_string()).collect();\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 260.0), 620.0, 110.0, 62.0);\n        let notes = [\"Two Codes per case. The patient forgives a good deal.\", \"One Code per case. As it is meant to be played.\", \"No Codes. Faster strains. A tighter clock.\"];\n        let f = self.focus.min(2);\n        style::outlined(p, rect.min + vec2(120.0, 640.0), Align2::LEFT_CENTER, notes[f], 40.0, TEAL);\n        self.hints(p, rect, &[(Action::Confirm, \"Begin\"), (Action::Back, \"Back\")]);\n        if let Some(k) = chosen {\n            self.save.difficulty = k as u8;\n            self.save.started = true;\n            self.save.last_case = 0;\n            self.persist();\n            self.sim_diff();\n            self.load(\"surgery/campaign/0\");\n            self.case_files_mode = false;\n            self.go(Screen::Playing);\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn case_files(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n        style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Case Files\", 66.0, Color32::WHITE);\n        let content = content::get();\n        let n = content.cases.len();\n        self.focus = self.focus.min(n - 1);\n        if self.nav(2) || self.nav(0) {\n            self.focus = (self.focus + n - 1) % n;\n            self.cue(cue::NAV);\n        }\n        if self.nav(3) || self.nav(1) {\n            self.focus = (self.focus + 1) % n;\n            self.cue(cue::NAV);\n        }\n        // Three big cards, the focused in the middle. Click a side one to bring it here.\n        let c = rect.center() + vec2(0.0, 30.0);\n        let mut clicked = None;\n        for off in [-1i32, 1, 0] {\n            let k = (self.focus as i32 + off).rem_euclid(n as i32) as usize;\n            let size = if off == 0 { vec2(760.0, 610.0) } else { vec2(420.0, 480.0) };\n            let r = Rect::from_center_size(c + vec2(off as f32 * 660.0, 0.0), size);\n            let over = i.pointer.is_some_and(|q| r.contains(q));\n            if over && i.click {\n                clicked = Some(k);\n            }\n            let unlocked = k as u8 <= self.save.furthest;\n            let fill = if unlocked { style::PAPER } else { Color32::from_rgb(40, 52, 56) };\n            let ink = if unlocked { style::PAPER_INK } else { Color32::from_rgb(120, 136, 140) };\n            p.rect_filled(r.translate(vec2(6.0, 8.0)), 10.0, Color32::from_black_alpha(120));\n            p.rect_filled(r, 10.0, fill);\n            if off == 0 {\n                p.rect_stroke(r, 10.0, egui::Stroke::new(4.0, GOLD), StrokeKind::Outside);\n            }\n            let def = &content.cases[k];\n            let tx = r.left_top() + vec2(36.0, 30.0);\n            let big = if off == 0 { 62.0 } else { 40.0 };\n            style::plain(p, tx, Align2::LEFT_TOP, &format!(\"Case {k}\"), if off == 0 { 40.0 } else { 32.0 }, ink);\n            if unlocked {\n                style::plain(p, tx + vec2(0.0, 52.0), Align2::LEFT_TOP, &def.name, big, ink);\n                if off == 0 {\n                    style::wrapped(p, tx + vec2(0.0, 140.0), r.width() - 72.0, &format!(\"{}\\n{}\", def.patient, def.life), 34.0, ink);\n                }\n                let rank = &self.save.ranks[k];\n                if !rank.is_empty() {\n                    let rr = r.right_bottom() - vec2(50.0, 44.0);\n                    style::plain(p, rr, Align2::RIGHT_BOTTOM, rank, if off == 0 { 92.0 } else { 56.0 }, style::RED);\n                    if off == 0 {\n                        style::plain(p, rr - vec2(0.0, 92.0), Align2::RIGHT_BOTTOM, \"Best\", 30.0, ink);\n                    }\n                }\n            } else {\n                style::plain(p, tx + vec2(0.0, 52.0), Align2::LEFT_TOP, \"Sealed\", big, ink);\n            }\n        }\n        self.hints(p, rect, &[(Action::Adjust, \"Choose\"), (Action::Confirm, \"Operate\"), (Action::Back, \"Back\")]);\n        if let Some(k) = clicked {\n            if k != self.focus {\n                self.focus = k;\n                self.cue(cue::NAV);\n                return;\n            }\n        }\n        if i.confirm || (clicked == Some(self.focus)) {\n            if (self.focus as u8) <= self.save.furthest {\n                self.cue(cue::CONFIRM);\n                self.sim_diff();\n                let scene = format!(\"surgery/case/{}\", self.focus);\n                self.load(&scene);\n                self.case_files_mode = true;\n                self.go(Screen::Playing);\n            } else {\n                self.cue(cue::CLINK);\n            }\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn pause_menu(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n        style::outlined(p, rect.min + vec2(120.0, 110.0), Align2::LEFT_CENTER, \"Paused\", 76.0, Color32::WHITE);\n        let items: Vec<String> = [\"Resume\", \"Restart\", \"Controls\", \"Settings\", \"Dev Mode\", \"Quit to Title\"].map(String::from).to_vec();\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 220.0), 620.0, 100.0, 58.0);\n        self.hints(p, rect, &[(Action::Confirm, \"Select\"), (Action::Back, \"Resume\")]);\n        if let Some(k) = chosen {\n            match k {\n                0 => self.resume(),\n                1 => {\n                    self.cmds.push(ShellCmd::Paused(false));\n                    self.sim_diff();\n                    let s = self.scene.clone();\n                    self.load(&s);\n                    self.go(Screen::Playing);\n                }\n                2 => {\n                    self.came_from = Screen::Pause;\n                    self.go(Screen::Controls);\n                }\n                3 => {\n                    self.came_from = Screen::Pause;\n                    self.go(Screen::Settings);\n                }\n                4 => self.go(Screen::Dev),\n                _ => self.quit_to_title(),\n            }\n        } else if i.back || i.pause {\n            self.cue(cue::BACK);\n            self.resume();\n        }\n    }\n\n    pub fn resume(&mut self) {\n        self.cmds.push(ShellCmd::Paused(false));\n        self.go(Screen::Playing);\n    }\n\n    pub fn controls(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n        style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Controls\", 66.0, Color32::WHITE);\n        let g = self.glyphs();\n        let lines: &[(Action, &str)] = if g.device == Device::Gamepad {\n            &[\n                (Action::Aim, \"Move the cursor\"),\n                (Action::Use, \"Use the instrument (R2 is analog)\"),\n                (Action::Pick, \"Flick to pick an instrument, instantly\"),\n                (Action::PickCycle, \"Cycle instruments. Turn a held bone\"),\n                (Action::Precision, \"Hold for precision\"),\n                (Action::Cancel, \"Let go\"),\n                (Action::Gift, \"Hold for your gift. Release on the beat\"),\n                (Action::Chart, \"The chart\"),\n                (Action::Defib, \"Hold both to charge the paddles\"),\n                (Action::Pause, \"Pause\"),\n            ]\n        } else {\n            &[\n                (Action::Aim, \"Move the cursor (WASD or arrows also move it)\"),\n                (Action::Use, \"Use the instrument (or hold E)\"),\n                (Action::Pick, \"Pick an instrument (or click it on the tray)\"),\n                (Action::PickCycle, \"Cycle instruments. Turn a held bone\"),\n                (Action::Precision, \"Hold for a precise keyboard cursor\"),\n                (Action::Cancel, \"Let go (or Q)\"),\n                (Action::Gift, \"Hold for your gift. Release on the beat\"),\n                (Action::Chart, \"The chart\"),\n                (Action::Defib, \"Hold both to charge the paddles (or F)\"),\n                (Action::Pause, \"Pause\"),\n            ]\n        };\n        if g.device == Device::Gamepad {\n            // A picture of the pad, big enough to read.\n            pad_picture(p, rect.max - vec2(600.0, 760.0));\n        } else {\n            keys_picture(p, rect.max - vec2(620.0, 760.0));\n        }\n        for (k, (a, text)) in lines.iter().enumerate() {\n            let y = rect.min.y + 190.0 + k as f32 * 72.0;\n            self.prompted(g, *a);\n            glyphs::draw(p, pos2(rect.min.x + 120.0, y), 46.0, g, *a);\n            style::outlined(p, pos2(rect.min.x + 300.0, y), Align2::LEFT_CENTER, text, 38.0, INK);\n        }\n        self.hints(p, rect, &[(Action::Back, \"Back\")]);\n        if i.back || i.confirm || i.click {\n            self.cue(cue::BACK);\n            let to = self.came_from;\n            self.go(to);\n        }\n    }\n\n    pub fn attract(&mut self, p: &Painter, rect: Rect, i: &ShellInput, f: Option<&SurgeryFrame>, vp: Mat4) {\n        if let Some(f) = f {\n            match f.stage {\n                pav_core::games::surgery::frame::Stage::Story => super::story::draw_attract(self, p, rect, f),\n                _ => super::hud::draw(self, p, rect, f, vp, i),\n            }\n        }\n        // The demo banner.\n        let top = rect.min + vec2(rect.width() * 0.5, rect.height() - 70.0);\n        let pulse = ((self.time * 2.0).sin() * 0.5 + 0.5) * 0.5 + 0.5;\n        style::outlined(p, rect.min + vec2(60.0, 1020.0 - 0.0), Align2::LEFT_CENTER, \"DEMO\", 66.0, style::with_alpha(style::RED, pulse));\n        let g = if self.touch_only { glyphs::Glyphs { device: Device::Touch, xbox: false } } else { self.glyphs() };\n        self.prompted(g, Action::Any);\n        if !self.touch_only {\n            let w = glyphs::draw(p, pos2(top.x - 200.0, top.y), 46.0, g, Action::Any);\n            style::outlined(p, pos2(top.x - 200.0 + w + 12.0, top.y), Align2::LEFT_CENTER, \"to play\", 42.0, style::with_alpha(INK, pulse));\n        } else {\n            style::outlined(p, top, Align2::CENTER_CENTER, \"Controller or keyboard required\", 42.0, GOLD);\n        }\n        // Any input returns to the title at once.\n        if i.any || i.tap.is_some() {\n            self.load(\"surgery/title\");\n            self.go(Screen::Title);\n            self.idle = 0.0;\n        }\n        let _ = cheat::IMMORTAL;\n    }\n}\n\n/// A picture of the pad.\nfn pad_picture(p: &Painter, at: Pos2) {\n    let body = Color32::from_rgb(226, 230, 234);\n    let dark = Color32::from_rgb(30, 34, 40);\n    let c = at + vec2(280.0, 150.0);\n    p.rect_filled(Rect::from_center_size(c, vec2(420.0, 190.0)), 90.0, body);\n    p.circle_filled(c + vec2(-170.0, 70.0), 76.0, body);\n    p.circle_filled(c + vec2(170.0, 70.0), 76.0, body);\n    p.rect_filled(Rect::from_center_size(c + vec2(-150.0, -96.0), vec2(90.0, 18.0)), 6.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(150.0, -96.0), vec2(90.0, 18.0)), 6.0, dark);\n    p.circle_filled(c + vec2(-70.0, 40.0), 28.0, dark);\n    p.circle_filled(c + vec2(70.0, 40.0), 28.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(-145.0, -24.0), vec2(56.0, 18.0)), 4.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(-145.0, -24.0), vec2(18.0, 56.0)), 4.0, dark);\n    for (dx, dy, col) in [(0.0, -30.0, Color32::from_rgb(64, 226, 160)), (30.0, 0.0, Color32::from_rgb(255, 102, 102)), (0.0, 30.0, Color32::from_rgb(124, 178, 232)), (-30.0, 0.0, Color32::from_rgb(214, 148, 214))] {\n        p.circle_filled(c + vec2(145.0 + dx, -24.0 + dy), 13.0, col);\n    }\n    p.rect_filled(Rect::from_center_size(c + vec2(0.0, -24.0), vec2(120.0, 60.0)), 8.0, Color32::from_rgb(190, 196, 202));\n}\n\n/// A picture of keys and a mouse.\nfn keys_picture(p: &Painter, at: Pos2) {\n    let cap = Color32::from_rgb(232, 236, 236);\n    let ink = Color32::from_rgb(24, 28, 32);\n    let keys: &[(f32, f32, &str)] = &[\n        (90.0, 40.0, \"W\"),\n        (30.0, 100.0, \"A\"),\n        (90.0, 100.0, \"S\"),\n        (150.0, 100.0, \"D\"),\n        (30.0, 40.0, \"Q\"),\n        (150.0, 40.0, \"E\"),\n        (210.0, 40.0, \"F\"),\n    ];\n    for (x, y, t) in keys {\n        let r = Rect::from_min_size(at + vec2(*x, *y), vec2(54.0, 54.0));\n        p.rect_filled(r, 8.0, cap);\n        p.text(r.center(), Align2::CENTER_CENTER, *t, style::font(34.0), ink);\n    }\n    let sp = Rect::from_min_size(at + vec2(30.0, 170.0), vec2(240.0, 50.0));\n    p.rect_filled(sp, 8.0, cap);\n    p.text(sp.center(), Align2::CENTER_CENTER, \"Space\", style::font(32.0), ink);\n    let m = Rect::from_min_size(at + vec2(360.0, 30.0), vec2(130.0, 200.0));\n    p.rect_filled(m, 60.0, cap);\n    p.line_segment([pos2(m.center().x, m.min.y), pos2(m.center().x, m.min.y + 80.0)], egui::Stroke::new(3.0, ink));\n    p.line_segment([pos2(m.min.x, m.min.y + 80.0), pos2(m.max.x, m.min.y + 80.0)], egui::Stroke::new(3.0, ink));\n    p.rect_filled(Rect::from_center_size(pos2(m.center().x, m.min.y + 40.0), vec2(16.0, 40.0)), 6.0, style::RED);\n}\nEOF\ncat > crates/pav_ui/src/surgery/settings.rs <<'EOF'\n//! Settings: three short pages. Sound, Controls, Display.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::cue;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Shell, ShellCmd, ShellInput};\n\npub const PAGES: [&str; 3] = [\"Sound\", \"Controls\", \"Display\"];\n\n#[derive(Clone, Copy)]\nenum Row {\n    Music,\n    Effects,\n    Voices,\n    Prompts,\n    CursorSpeed,\n    AimAssist,\n    Rumble,\n    Tremor,\n    Shake,\n    Flashes,\n    Palette,\n    TextSpeed,\n    Fullscreen,\n}\n\nfn rows(page: usize) -> &'static [Row] {\n    match page {\n        0 => &[Row::Music, Row::Effects, Row::Voices],\n        1 => &[Row::Prompts, Row::CursorSpeed, Row::AimAssist, Row::Rumble, Row::Tremor],\n        _ => &[Row::Shake, Row::Flashes, Row::Palette, Row::TextSpeed, Row::Fullscreen],\n    }\n}\n\n/// A row as (label, value text, fraction for a slider or none for a switch).\nfn describe(s: &super::save::Settings, r: Row) -> (&'static str, String, Option<f32>) {\n    let pct = |v: f32| format!(\"{}%\", (v * 100.0).round() as i32);\n    let on = |b: bool| if b { \"On\".to_string() } else { \"Off\".to_string() };\n    match r {\n        Row::Music => (\"Music\", pct(s.music), Some(s.music)),\n        Row::Effects => (\"Effects\", pct(s.effects), Some(s.effects)),\n        Row::Voices => (\"Voices\", pct(s.voices), Some(s.voices)),\n        Row::Prompts => (\"Button prompts\", if s.xbox { \"Xbox\".into() } else { \"PlayStation\".into() }, None),\n        Row::CursorSpeed => (\"Cursor speed\", format!(\"{:.0}\", s.cursor_speed), Some((s.cursor_speed - 5.0) / 25.0)),\n        Row::AimAssist => (\"Aim assist\", pct(s.aim_assist), Some(s.aim_assist)),\n        Row::Rumble => (\"Rumble\", on(s.rumble), None),\n        Row::Tremor => (\"Dr. Nwosu's tremor\", on(s.tremor), None),\n        Row::Shake => (\"Screen shake\", on(s.shake), None),\n        Row::Flashes => (\"Reduce flashes\", on(s.reduce_flashes), None),\n        Row::Palette => (\"Field palette\", if s.clinical { \"Clinical\".into() } else { \"Anatomical\".into() }, None),\n        Row::TextSpeed => (\"Text speed\", format!(\"{:.0}\", s.text_speed), Some((s.text_speed - 15.0) / 105.0)),\n        Row::Fullscreen => (\"Fullscreen\", on(s.fullscreen), None),\n    }\n}\n\nfn adjust(shell: &mut Shell, r: Row, delta: f32) {\n    let s = &mut shell.save.settings;\n    match r {\n        Row::Music => s.music = (s.music + delta * 0.05).clamp(0.0, 1.0),\n        Row::Effects => s.effects = (s.effects + delta * 0.05).clamp(0.0, 1.0),\n        Row::Voices => s.voices = (s.voices + delta * 0.05).clamp(0.0, 1.0),\n        Row::Prompts => s.xbox = !s.xbox,\n        Row::CursorSpeed => s.cursor_speed = (s.cursor_speed + delta).clamp(5.0, 30.0),\n        Row::AimAssist => s.aim_assist = (s.aim_assist + delta * 0.1).clamp(0.0, 1.0),\n        Row::Rumble => s.rumble = !s.rumble,\n        Row::Tremor => s.tremor = !s.tremor,\n        Row::Shake => s.shake = !s.shake,\n        Row::Flashes => s.reduce_flashes = !s.reduce_flashes,\n        Row::Palette => s.clinical = !s.clinical,\n        Row::TextSpeed => s.text_speed = (s.text_speed + delta * 5.0).clamp(15.0, 120.0),\n        Row::Fullscreen => s.fullscreen = !s.fullscreen,\n    }\n    apply(shell, r);\n}\n\nfn set_fraction(shell: &mut Shell, r: Row, k: f32) {\n    let k = k.clamp(0.0, 1.0);\n    let s = &mut shell.save.settings;\n    match r {\n        Row::Music => s.music = k,\n        Row::Effects => s.effects = k,\n        Row::Voices => s.voices = k,\n        Row::CursorSpeed => s.cursor_speed = 5.0 + k * 25.0,\n        Row::AimAssist => s.aim_assist = k,\n        Row::TextSpeed => s.text_speed = 15.0 + k * 105.0,\n        _ => {}\n    }\n    apply(shell, r);\n}\n\nfn apply(shell: &mut Shell, r: Row) {\n    let s = shell.save.settings.clone();\n    match r {\n        Row::Music | Row::Effects | Row::Voices => shell.cmds.push(ShellCmd::Mix { music: s.music, effects: s.effects, voices: s.voices }),\n        Row::TextSpeed => shell.cmds.push(ShellCmd::Sim(SurgeryCmd::TextSpeed(s.text_speed))),\n        Row::Tremor => shell.cmds.push(ShellCmd::Sim(SurgeryCmd::Tremor(s.tremor))),\n        Row::Fullscreen => shell.cmds.push(ShellCmd::Fullscreen(s.fullscreen)),\n        _ => {}\n    }\n    shell.persist();\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n    style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Settings\", 66.0, Color32::WHITE);\n    // Tabs.\n    let mut x = rect.min.x + 500.0;\n    let mut clicked_tab = None;\n    for (k, name) in PAGES.iter().enumerate() {\n        let r = Rect::from_min_size(pos2(x, rect.min.y + 58.0), vec2(250.0, 66.0));\n        let on = k == shell.page;\n        p.rect_filled(r, 10.0, if on { style::with_alpha(TEAL, 0.32) } else { style::with_alpha(Color32::BLACK, 0.3) });\n        if on {\n            p.rect_stroke(r, 10.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, name, 42.0, if on { Color32::WHITE } else { INK });\n        if i.pointer.is_some_and(|q| r.contains(q)) && i.click {\n            clicked_tab = Some(k);\n        }\n        x += 270.0;\n    }\n    if let Some(k) = clicked_tab {\n        shell.page = k;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_prev {\n        shell.page = (shell.page + PAGES.len() - 1) % PAGES.len();\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_next {\n        shell.page = (shell.page + 1) % PAGES.len();\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    let list = rows(shell.page);\n    let n = list.len();\n    shell.focus = shell.focus.min(n - 1);\n    if shell.nav(0) {\n        shell.focus = (shell.focus + n - 1) % n;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(1) {\n        shell.focus = (shell.focus + 1) % n;\n        shell.cue(cue::NAV);\n    }\n    let left = rect.min.x + 160.0;\n    for (k, r) in list.iter().enumerate() {\n        let y = rect.min.y + 210.0 + k as f32 * 124.0;\n        let row = Rect::from_min_size(pos2(left - 30.0, y), vec2(rect.width() - 260.0, 108.0));\n        let over = i.pointer.is_some_and(|q| row.contains(q));\n        if over && i.pointer_moved && shell.focus != k {\n            shell.focus = k;\n            shell.cue(cue::NAV);\n        }\n        let f = shell.focus == k;\n        if f {\n            p.rect_filled(row, 10.0, style::with_alpha(TEAL, 0.18));\n            p.rect_stroke(row, 10.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        let (label, value, frac) = describe(&shell.save.settings, *r);\n        style::outlined(p, pos2(left, row.center().y), Align2::LEFT_CENTER, label, 50.0, if f { Color32::WHITE } else { INK });\n        style::outlined(p, pos2(row.max.x - 30.0, row.center().y), Align2::RIGHT_CENTER, &value, 50.0, GOLD);\n        if let Some(fr) = frac {\n            let track = Rect::from_min_size(pos2(left + 560.0, row.center().y - 12.0), vec2(620.0, 24.0));\n            p.rect_filled(track, 12.0, Color32::from_black_alpha(160));\n            let fill = Rect::from_min_size(track.min, vec2(track.width() * fr.clamp(0.0, 1.0), 24.0));\n            p.rect_filled(fill, 12.0, TEAL);\n            p.circle_filled(pos2(fill.max.x, track.center().y), 20.0, Color32::WHITE);\n            if i.drag {\n                if let Some(q) = i.pointer {\n                    if track.expand2(vec2(10.0, 30.0)).contains(q) {\n                        set_fraction(shell, *r, (q.x - track.min.x) / track.width());\n                    }\n                }\n            }\n        } else if over && i.click {\n            adjust(shell, *r, 1.0);\n            shell.cue(cue::CONFIRM);\n        }\n        if i.tap.is_some_and(|q| row.contains(q)) {\n            shell.focus = k;\n            if frac.is_none() {\n                adjust(shell, *r, 1.0);\n            }\n        }\n    }\n    let r = list[shell.focus];\n    let is_slider = describe(&shell.save.settings, r).2.is_some();\n    if shell.nav(2) {\n        adjust(shell, r, -1.0);\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(3) {\n        adjust(shell, r, 1.0);\n        shell.cue(cue::NAV);\n    }\n    if i.confirm && !is_slider {\n        adjust(shell, r, 1.0);\n        shell.cue(cue::CONFIRM);\n    }\n    shell.hints(p, rect, &[(Action::TabPrev, \"Page\"), (Action::TabNext, \"Page\"), (Action::Adjust, \"Change\"), (Action::Back, \"Back\")]);\n    if shell.touch_only {\n        let back = Rect::from_center_size(pos2(rect.max.x - 190.0, rect.max.y - 70.0), vec2(280.0, 90.0));\n        p.rect_filled(back, 12.0, style::with_alpha(TEAL, 0.3));\n        style::outlined(p, back.center(), Align2::CENTER_CENTER, \"Back\", 46.0, Color32::WHITE);\n        if i.tap.is_some_and(|q| back.contains(q)) {\n            let to = shell.came_from;\n            shell.go(to);\n            return;\n        }\n    }\n    if i.back {\n        shell.cue(cue::BACK);\n        let to = shell.came_from;\n        shell.go(to);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/about.rs <<'EOF'\n//! About: paged, big text. The text comes from a JSON block (the page's `about-data`, generated\n//! from the exit interview), so an importing agent can add usage without rebuilding the wasm.\n\nuse egui::{Align2, Color32, Painter, Rect, vec2};\nuse pav_core::games::surgery::cue;\nuse serde::Deserialize;\n\nuse super::glyphs::Action;\nuse super::style::{self, INK};\nuse super::{Shell, ShellInput};\n\n#[derive(Clone, Debug, Default, Deserialize)]\npub struct AboutSection {\n    pub title: String,\n    pub lines: Vec<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\npub struct About {\n    pub sections: Vec<AboutSection>,\n}\n\nconst BUILT_IN: &str = include_str!(\"about.json\");\n\n/// Characters on a page at 34 points, about, before it runs to another.\nconst PAGE_LINES: f32 = 15.0;\nconst CHARS_PER_LINE: f32 = 88.0;\n\nimpl About {\n    pub fn built_in() -> Self {\n        Self::parse(BUILT_IN).unwrap_or_default()\n    }\n\n    pub fn parse(json: &str) -> Option<Self> {\n        serde_json::from_str(json).ok()\n    }\n\n    /// The text cut into screens: never a scrollbar.\n    pub fn pages(&self) -> Vec<(String, Vec<String>)> {\n        let mut out = Vec::new();\n        for s in &self.sections {\n            let (mut used, mut lines) = (0.0, Vec::new());\n            for l in &s.lines {\n                let need = (l.chars().count() as f32 / CHARS_PER_LINE).ceil().max(1.0) + 0.3;\n                if used + need > PAGE_LINES && !lines.is_empty() {\n                    out.push((s.title.clone(), std::mem::take(&mut lines)));\n                    used = 0.0;\n                }\n                lines.push(l.clone());\n                used += need;\n            }\n            if !lines.is_empty() {\n                out.push((s.title.clone(), lines));\n            }\n        }\n        if out.is_empty() {\n            out.push((\"About\".to_string(), vec![\"Nothing here yet.\".to_string()]));\n        }\n        out\n    }\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.96));\n    let pages = shell.about.pages();\n    let n = pages.len();\n    shell.page = shell.page.min(n - 1);\n    if shell.nav(2) || i.tab_prev {\n        shell.page = (shell.page + n - 1) % n;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(3) || i.tab_next || i.confirm || (i.click && !i.back) {\n        shell.page = (shell.page + 1) % n;\n        shell.cue(cue::NAV);\n    }\n    let (title, lines) = &pages[shell.page];\n    style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, title, 66.0, Color32::WHITE);\n    style::outlined(p, rect.right_top() + vec2(-120.0, 90.0), Align2::RIGHT_CENTER, &format!(\"{} / {}\", shell.page + 1, n), 42.0, style::DIM);\n    let mut y = rect.min.y + 170.0;\n    for l in lines {\n        y = style::wrapped(p, egui::pos2(rect.min.x + 120.0, y), rect.width() - 240.0, l, 34.0, INK) + 12.0;\n    }\n    shell.hints(p, rect, &[(Action::Adjust, \"Page\"), (Action::Back, \"Back\")]);\n    if i.back {\n        shell.cue(cue::BACK);\n        let to = shell.came_from;\n        shell.go(to);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/about.json <<'EOF'\n{\"sections\":[{\"title\":\"Credits\",\"lines\":[\"The first build of the About data: the packer replaces this.\"]}]}\nEOF\necho ok","description":"Write the shell, menus, settings and About screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15397,"cache_read_input_tokens":530954,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15397},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"a257a19f-d079-4b81-b042-362fd8d10e0b","timestamp":"2026-11-05T14:20:33.886Z","request_id":"req_011CgjvbsPFecFXwi4ZCYasK","wire_tool_inputs":{"toolu_0189nB5A4vKi6ZTzmg7o7jY9":{"command":"cat > crates/pav_ui/src/surgery/mod.rs <<'EOF'\n//! The surgery game's screens: a state machine in plain Rust plus egui's painter, with its own\n//! focus lists. It takes an abstract input (nav, confirm, back, tabs, pointer, last device) and\n//! emits commands, so `cargo test` can drive it without a GPU and the tools draw the same thing the\n//! window does.\n\npub mod about;\npub mod card;\npub mod dev;\npub mod glyphs;\npub mod hud;\npub mod menus;\npub mod results;\npub mod save;\npub mod settings;\npub mod story;\npub mod style;\n\nuse std::collections::HashMap;\n\nuse egui::{Painter, Pos2, Rect};\nuse glam::Mat4;\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::tune::Tune;\nuse pav_core::input::SurgeryCmd;\nuse serde_json::json;\n\nuse crate::Device;\nuse glyphs::Glyphs;\nuse save::Save;\n\n/// The game's title, in one place: the title screen, the page title, the hub card, About.\npub const TITLE: &str = \"Diorama Center: Second Opinion\";\npub const TAGLINE: &str = \"You are the hands.\";\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Screen {\n    /// The title: any confirm goes to the menu.\n    Title,\n    Menu,\n    Difficulty,\n    CaseFiles,\n    Settings,\n    About,\n    Controls,\n    /// No menu: the game's own HUD, story, chart, results and death screens.\n    Playing,\n    Pause,\n    Dev,\n    Attract,\n    /// A hub session's board.\n    Card,\n    /// A hub session in play: no pause, no restart, no quit.\n    Session,\n}\n\n/// One frame's abstract input. Directions are held state; the shell makes the repeats.\n#[derive(Clone, Copy, Debug, Default)]\npub struct ShellInput {\n    pub up: bool,\n    pub down: bool,\n    pub left: bool,\n    pub right: bool,\n    pub confirm: bool,\n    pub confirm_held: bool,\n    pub back: bool,\n    pub tab_prev: bool,\n    pub tab_next: bool,\n    pub pause: bool,\n    /// Square or Tab.\n    pub chart: bool,\n    /// Triangle or A/M.\n    pub alt: bool,\n    /// The pointer in canvas points, when there is one.\n    pub pointer: Option<Pos2>,\n    pub pointer_moved: bool,\n    pub click: bool,\n    /// Pointer button held (sliders).\n    pub drag: bool,\n    /// Any key, button, stick, click, move or tap at all.\n    pub any: bool,\n    /// A finger's tap (touch-only: only the Settings button answers it).\n    pub tap: Option<Pos2>,\n    pub device: Device,\n    pub dt: f32,\n}\n\n/// What the shell asks of the app.\n#[derive(Clone, Debug, PartialEq)]\npub enum ShellCmd {\n    /// Load a scene (fresh sim).\n    Load(String),\n    /// A game command for the sim.\n    Sim(SurgeryCmd),\n    /// Sim time runs or stops.\n    Paused(bool),\n    /// A UI sound (a cue id).\n    Cue(u16),\n    /// Store this save text.\n    Save(String),\n    Fullscreen(bool),\n    /// Sound levels changed.\n    Mix { music: f32, effects: f32, voices: f32 },\n    /// Dev: one tick while paused.\n    FrameStep,\n    /// Dev: back five seconds.\n    Rewind,\n    SnapshotSave,\n    SnapshotLoad,\n    ReloadContent,\n    /// Hub card answers.\n    HubReady,\n    HubMore,\n}\n\n/// What the hub tells the card.\n#[derive(Clone, Debug, Default)]\npub struct HubCard {\n    /// (id, name, seat colour index)\n    pub players: Vec<(u32, String)>,\n    pub ready: Vec<u32>,\n    pub me: Option<u32>,\n    pub left_ms: Option<f64>,\n    pub paused: bool,\n    pub starting: bool,\n    pub asking: u32,\n    pub asked: bool,\n    pub countdown: Option<f32>,\n}\n\n/// The dev panel's state.\n#[derive(Clone, Debug)]\npub struct DevState {\n    pub page: usize,\n    pub live: bool,\n    pub bot_plays: bool,\n    pub immortal: bool,\n    pub freeze: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub time_scale: f32,\n    pub jump_case: u8,\n    pub jump_phase: u8,\n    pub spawn_kind: u8,\n    pub overlays: u32,\n    pub stats: bool,\n    pub tune: Tune,\n    pub status: String,\n    /// Frames and ticks per second, from the app.\n    pub fps: f32,\n    pub tps: f32,\n}\n\nimpl Default for DevState {\n    fn default() -> Self {\n        Self {\n            page: 0,\n            live: false,\n            bot_plays: false,\n            immortal: false,\n            freeze: false,\n            full_gift: false,\n            one_hit: false,\n            time_scale: 1.0,\n            jump_case: 0,\n            jump_phase: 0,\n            spawn_kind: 4,\n            overlays: 0,\n            stats: false,\n            tune: Tune::default(),\n            status: String::new(),\n            fps: 0.0,\n            tps: 0.0,\n        }\n    }\n}\n\npub struct Shell {\n    pub screen: Screen,\n    /// Where Back returns from Settings, Controls, About.\n    pub came_from: Screen,\n    pub focus: usize,\n    pub page: usize,\n    pub idle: f32,\n    pub time: f32,\n    pub save: Save,\n    pub about: about::About,\n    pub dev: DevState,\n    pub device: Device,\n    /// Touch-only: no fine pointer, no key or pad so far.\n    pub touch_only: bool,\n    pub hub_active: bool,\n    pub hub_card: Option<HubCard>,\n    /// Text the page wants on the title about sound.\n    pub sound_note: bool,\n    pub chart_open: bool,\n    pub backlog: bool,\n    pub auto_advance: bool,\n    /// Hold-to-skip progress.\n    pub hold: f32,\n    /// The scene in the sim, as the shell last asked.\n    pub scene: String,\n    pub prompts: Vec<&'static str>,\n    pub cmds: Vec<ShellCmd>,\n    pub started_case: Option<u8>,\n    pub case_files_mode: bool,\n    /// How long since the last line advanced by itself.\n    pub auto_t: f32,\n    nav_t: [f32; 4],\n    nav_edge: [bool; 4],\n    pub hud: hud::HudState,\n    cameos: HashMap<String, story::Cameo>,\n    pub saved_this_results: bool,\n    pub last_stage: Stage,\n    pub is_native: bool,\n    pub clicked_hint: bool,\n}\n\nimpl Default for Shell {\n    fn default() -> Self {\n        Self::new(Save::default())\n    }\n}\n\n/// Seconds without input on a menu before attract starts.\npub const ATTRACT_AFTER: f32 = 10.0;\n\nimpl Shell {\n    pub fn new(save: Save) -> Self {\n        Self {\n            screen: Screen::Title,\n            came_from: Screen::Menu,\n            focus: 0,\n            page: 0,\n            idle: 0.0,\n            time: 0.0,\n            save,\n            about: about::About::built_in(),\n            dev: DevState::default(),\n            device: Device::KeyboardMouse,\n            touch_only: false,\n            hub_active: false,\n            hub_card: None,\n            sound_note: false,\n            chart_open: false,\n            backlog: false,\n            auto_advance: false,\n            hold: 0.0,\n            scene: \"surgery/title\".into(),\n            prompts: Vec::new(),\n            cmds: Vec::new(),\n            started_case: None,\n            case_files_mode: false,\n            auto_t: 0.0,\n            nav_t: [0.0; 4],\n            nav_edge: [false; 4],\n            hud: hud::HudState::default(),\n            cameos: HashMap::new(),\n            saved_this_results: false,\n            last_stage: Stage::Title,\n            is_native: !cfg!(target_arch = \"wasm32\"),\n            clicked_hint: false,\n        }\n    }\n\n    pub fn glyphs(&self) -> Glyphs {\n        Glyphs { device: self.device, xbox: self.save.settings.xbox }\n    }\n\n    /// Records a prompt: what the tests read to see what's on screen.\n    pub fn prompted(&mut self, g: Glyphs, a: glyphs::Action) {\n        let id = glyphs::glyph_id(g, a);\n        if !self.prompts.contains(&id) {\n            self.prompts.push(id);\n        }\n    }\n\n    pub fn load(&mut self, scene: &str) {\n        self.scene = scene.to_string();\n        self.cmds.push(ShellCmd::Load(scene.to_string()));\n    }\n\n    pub fn sim(&mut self, c: SurgeryCmd) {\n        self.cmds.push(ShellCmd::Sim(c));\n    }\n\n    pub fn cue(&mut self, id: u16) {\n        self.cmds.push(ShellCmd::Cue(id));\n    }\n\n    pub fn persist(&mut self) {\n        self.cmds.push(ShellCmd::Save(self.save.to_text()));\n    }\n\n    pub fn go(&mut self, s: Screen) {\n        self.screen = s;\n        self.focus = 0;\n        self.page = 0;\n    }\n\n    /// Edges with auto-repeat for held directions: 0 up, 1 down, 2 left, 3 right.\n    fn update_nav(&mut self, i: &ShellInput) {\n        for (k, held) in [i.up, i.down, i.left, i.right].into_iter().enumerate() {\n            self.nav_edge[k] = false;\n            if held {\n                if self.nav_t[k] <= 0.0 {\n                    self.nav_edge[k] = true;\n                    self.nav_t[k] = 0.32;\n                } else {\n                    self.nav_t[k] -= i.dt;\n                    if self.nav_t[k] <= 0.0 {\n                        self.nav_edge[k] = true;\n                        self.nav_t[k] = 0.11;\n                    }\n                }\n            } else {\n                self.nav_t[k] = 0.0;\n            }\n        }\n    }\n\n    pub fn nav(&self, k: usize) -> bool {\n        self.nav_edge[k]\n    }\n\n    /// The JSON the test hook reads.\n    pub fn status(&self) -> serde_json::Value {\n        json!({\n            \"screen\": format!(\"{:?}\", self.screen),\n            \"focus\": self.focus,\n            \"page\": self.page,\n            \"device\": match self.device { Device::Gamepad => \"pad\", Device::KeyboardMouse => \"mouse\", Device::Touch => \"touch\" },\n            \"prompts\": self.prompts,\n            \"idle\": self.idle,\n            \"scene\": self.scene,\n            \"touch_only\": self.touch_only,\n            \"music\": self.save.settings.music,\n            \"effects\": self.save.settings.effects,\n            \"voices\": self.save.settings.voices,\n            \"xbox\": self.save.settings.xbox,\n            \"dev_page\": self.dev.page,\n            \"chart_open\": self.chart_open,\n            \"backlog\": self.backlog,\n            \"hub\": self.hub_active,\n        })\n    }\n\n    /// One frame: reads input, draws the screen over the game, and leaves commands in `self.cmds`.\n    pub fn frame(&mut self, ctx: &egui::Context, input: &ShellInput, frame: Option<&SurgeryFrame>, vp: Mat4) {\n        self.time += input.dt;\n        self.prompts.clear();\n        self.device = input.device;\n        self.update_nav(input);\n        if input.any {\n            self.idle = 0.0;\n        } else {\n            self.idle += input.dt;\n        }\n        let screen_rect = ctx.content_rect();\n        let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Middle, egui::Id::new(\"surgery_shell\")));\n        let rect = screen_rect;\n        // A new stage clears what a screen opened over the old one.\n        if let Some(f) = frame {\n            if f.stage != self.last_stage {\n                self.on_stage(f);\n            }\n        }\n        match self.screen {\n            Screen::Title => self.title(&painter, rect, input, frame),\n            Screen::Menu => self.main_menu(&painter, rect, input),\n            Screen::Difficulty => self.difficulty(&painter, rect, input),\n            Screen::CaseFiles => self.case_files(&painter, rect, input),\n            Screen::Settings => settings::screen(self, &painter, rect, input),\n            Screen::About => about::screen(self, &painter, rect, input),\n            Screen::Controls => self.controls(&painter, rect, input),\n            Screen::Playing | Screen::Session => self.playing(&painter, rect, input, frame, vp),\n            Screen::Pause => {\n                if let Some(f) = frame {\n                    hud::draw(self, &painter, rect, f, vp, input);\n                }\n                self.pause_menu(&painter, rect, input);\n            }\n            Screen::Dev => {\n                if let Some(f) = frame {\n                    hud::draw(self, &painter, rect, f, vp, input);\n                }\n                dev::screen(self, &painter, rect, input, frame);\n            }\n            Screen::Attract => self.attract(&painter, rect, input, frame, vp),\n            Screen::Card => card::screen(self, &painter, rect, input),\n        }\n        // Idle on the title or a main-menu screen: attract.\n        let idle_screen = matches!(self.screen, Screen::Title | Screen::Menu | Screen::Difficulty | Screen::CaseFiles | Screen::Settings | Screen::About | Screen::Controls);\n        if idle_screen && !self.hub_active && self.idle > ATTRACT_AFTER && self.came_from != Screen::Pause {\n            self.screen = Screen::Attract;\n            self.idle = 0.0;\n            self.load(\"surgery/attract\");\n        }\n    }\n\n    fn on_stage(&mut self, f: &SurgeryFrame) {\n        self.last_stage = f.stage;\n        self.chart_open = false;\n        self.backlog = false;\n        self.hold = 0.0;\n        self.saved_this_results = false;\n    }\n\n    /// Draws the game's own screens and runs their input.\n    fn playing(&mut self, p: &Painter, rect: Rect, i: &ShellInput, frame: Option<&SurgeryFrame>, vp: Mat4) {\n        let Some(f) = frame else { return };\n        let session = self.screen == Screen::Session;\n        match f.stage {\n            Stage::Story => story::draw(self, p, rect, f, i),\n            Stage::Chart => results::chart(self, p, rect, f, i),\n            Stage::Results => results::results(self, p, rect, f, i),\n            Stage::Dead => results::death(self, p, rect, f, i),\n            Stage::Finished => results::finished(self, p, rect, f, i),\n            _ => hud::draw(self, p, rect, f, vp, i),\n        }\n        if i.pause && !session && !matches!(f.stage, Stage::Finished) {\n            self.cue(pav_core::games::surgery::cue::NAV);\n            self.go(Screen::Pause);\n            self.cmds.push(ShellCmd::Paused(true));\n        }\n    }\n\n    /// Back to the title, from wherever.\n    pub fn quit_to_title(&mut self) {\n        self.cmds.push(ShellCmd::Paused(false));\n        self.load(\"surgery/title\");\n        self.go(Screen::Title);\n    }\n}\n\n#[cfg(test)]\nmod tests;\nEOF\ncat > crates/pav_ui/src/surgery/menus.rs <<'EOF'\n//! The focus-list screens: title, main menu, difficulty, case files, pause, controls, attract.\n\nuse egui::{Align2, Color32, Painter, Pos2, Rect, StrokeKind, pos2, vec2};\nuse glam::Mat4;\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::tune::{DIFFICULTIES, cheat};\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Screen, Shell, ShellCmd, ShellInput, TAGLINE, TITLE};\nuse crate::Device;\n\nimpl Shell {\n    /// A focus list: nav moves the focus, hover moves the focus, a click or confirm activates.\n    pub fn list(&mut self, p: &Painter, i: &ShellInput, items: &[String], at: Pos2, width: f32, step: f32, size: f32) -> Option<usize> {\n        if items.is_empty() {\n            return None;\n        }\n        let n = items.len();\n        self.focus = self.focus.min(n - 1);\n        if self.nav(0) {\n            self.focus = (self.focus + n - 1) % n;\n            self.cue(cue::NAV);\n        }\n        if self.nav(1) {\n            self.focus = (self.focus + 1) % n;\n            self.cue(cue::NAV);\n        }\n        let mut chosen = None;\n        for (k, text) in items.iter().enumerate() {\n            let r = Rect::from_min_size(at + vec2(0.0, step * k as f32), vec2(width, step - 8.0));\n            let over = i.pointer.is_some_and(|q| r.contains(q));\n            if over && i.pointer_moved && self.focus != k {\n                self.focus = k;\n                self.cue(cue::NAV);\n            }\n            if over && i.click {\n                chosen = Some(k);\n            }\n        }\n        for (k, text) in items.iter().enumerate() {\n            let r = Rect::from_min_size(at + vec2(0.0, step * k as f32), vec2(width, step - 8.0));\n            let f = k == self.focus;\n            if f {\n                let pulse = (self.time * 3.0).sin() * 0.1 + 0.9;\n                p.rect_filled(r, 10.0, style::with_alpha(TEAL, 0.24 * pulse));\n                p.rect_stroke(r, 10.0, egui::Stroke::new(3.0, style::with_alpha(TEAL, pulse)), StrokeKind::Inside);\n                p.rect_filled(Rect::from_min_size(r.min, vec2(8.0, r.height())), 4.0, GOLD);\n            }\n            style::outlined(p, r.left_center() + vec2(30.0, 0.0), Align2::LEFT_CENTER, text, size, if f { Color32::WHITE } else { INK });\n        }\n        if i.confirm {\n            chosen = Some(self.focus);\n        }\n        if chosen.is_some() {\n            self.cue(cue::CONFIRM);\n        }\n        chosen\n    }\n\n    /// The bottom prompt row.\n    pub fn hints(&mut self, p: &Painter, rect: Rect, list: &[(Action, &str)]) {\n        let g = self.glyphs();\n        let mut x = rect.min.x + 60.0;\n        let y = rect.max.y - 52.0;\n        for (a, label) in list {\n            self.prompted(g, *a);\n            x = glyphs::labeled(p, pos2(x, y), 38.0, g, *a, label, INK);\n        }\n    }\n\n    pub fn backdrop(&self, p: &Painter, rect: Rect, a: f32) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, a));\n    }\n\n    pub fn title(&mut self, p: &Painter, rect: Rect, i: &ShellInput, f: Option<&SurgeryFrame>) {\n        let c = rect.center();\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.28));\n        let y = rect.min.y + 330.0;\n        let t = style::outlined(p, pos2(c.x, y), Align2::CENTER_CENTER, TITLE, 104.0, Color32::WHITE);\n        style::outlined(p, pos2(c.x, y + 78.0), Align2::CENTER_CENTER, TAGLINE, 44.0, TEAL);\n        // The ECG line draws the title's underline.\n        let (x0, x1) = (t.min.x, t.max.x);\n        let yy = y + 44.0;\n        let beat = f.map(|f| f.beat).unwrap_or(0.0);\n        let beats = f.map(|f| f.beats).unwrap_or(0) as f32 + beat;\n        let n = 180;\n        let pts: Vec<Pos2> = (0..=n)\n            .map(|k| {\n                let t = k as f32 / n as f32;\n                let x = x0 + (x1 - x0) * t;\n                let ph = (beats * 0.4 + t * 2.0).fract();\n                pos2(x, yy - hud::ecg_wave(ph) * 22.0)\n            })\n            .collect();\n        p.add(egui::Shape::line(pts, egui::Stroke::new(3.0, style::GREEN)));\n        if self.touch_only {\n            style::outlined(p, pos2(c.x, c.y + 150.0), Align2::CENTER_CENTER, \"Controller or keyboard required\", 54.0, GOLD);\n            // Touch-only: one button a tap can use.\n            let r = Rect::from_center_size(pos2(c.x, c.y + 260.0), vec2(360.0, 90.0));\n            p.rect_filled(r, 12.0, style::with_alpha(TEAL, 0.3));\n            p.rect_stroke(r, 12.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n            style::outlined(p, r.center(), Align2::CENTER_CENTER, \"Settings\", 48.0, Color32::WHITE);\n            if i.tap.is_some_and(|q| r.contains(q)) {\n                self.came_from = Screen::Title;\n                self.go(Screen::Settings);\n            }\n            return;\n        }\n        let pulse = ((self.time * 2.4).sin() * 0.5 + 0.5) * 0.5 + 0.5;\n        let g = self.glyphs();\n        self.prompted(g, Action::Confirm);\n        let w = glyphs::draw(p, pos2(c.x - 170.0, c.y + 190.0), 54.0, g, Action::Confirm);\n        style::outlined(p, pos2(c.x - 170.0 + w + 14.0, c.y + 190.0), Align2::LEFT_CENTER, \"Press to scrub in\", 50.0, style::with_alpha(INK, pulse));\n        if self.sound_note {\n            style::outlined(p, pos2(c.x, rect.max.y - 70.0), Align2::CENTER_CENTER, \"Press a key or click for sound\", 32.0, style::DIM);\n        }\n        if i.confirm || i.click {\n            self.cue(cue::CONFIRM);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn main_menu(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.5));\n        style::outlined(p, rect.min + vec2(120.0, 96.0), Align2::LEFT_CENTER, TITLE, 62.0, Color32::WHITE);\n        let can_continue = self.save.started;\n        let mut items = Vec::new();\n        if can_continue {\n            items.push(\"Continue\".to_string());\n        }\n        items.extend([\"New Game\", \"Case Files\", \"Code Blue\", \"Settings\", \"About\"].map(String::from));\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 240.0), 620.0, 104.0, 60.0);\n        self.hints(p, rect, &[(Action::Nav, \"Choose\"), (Action::Confirm, \"Select\"), (Action::Back, \"Title\")]);\n        if let Some(k) = chosen {\n            let name = items[k].as_str();\n            match name {\n                \"Continue\" => {\n                    self.sim_diff();\n                    let scene = format!(\"surgery/campaign/{}\", self.save.last_case);\n                    self.load(&scene);\n                    self.go(Screen::Playing);\n                    self.case_files_mode = false;\n                }\n                \"New Game\" => self.go(Screen::Difficulty),\n                \"Case Files\" => self.go(Screen::CaseFiles),\n                \"Code Blue\" => {\n                    self.sim_diff();\n                    self.load(\"surgery/codeblue\");\n                    self.go(Screen::Playing);\n                    self.case_files_mode = true;\n                }\n                \"Settings\" => {\n                    self.came_from = Screen::Menu;\n                    self.go(Screen::Settings);\n                }\n                _ => {\n                    self.came_from = Screen::Menu;\n                    self.go(Screen::About);\n                }\n            }\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Title);\n        }\n    }\n\n    /// The difficulty rides on a command right after a scene loads.\n    pub fn sim_diff(&mut self) {\n        let d = self.save.difficulty;\n        self.cmds.push(ShellCmd::Sim(SurgeryCmd::Difficulty(d)));\n    }\n\n    pub fn difficulty(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.6));\n        style::outlined(p, rect.min + vec2(120.0, 110.0), Align2::LEFT_CENTER, \"How is your nerve, Doctor?\", 66.0, Color32::WHITE);\n        let items: Vec<String> = DIFFICULTIES.iter().map(|d| d.name.to_string()).collect();\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 260.0), 620.0, 110.0, 62.0);\n        let notes = [\"Two Codes per case. The patient forgives a good deal.\", \"One Code per case. As it is meant to be played.\", \"No Codes. Faster strains. A tighter clock.\"];\n        let f = self.focus.min(2);\n        style::outlined(p, rect.min + vec2(120.0, 640.0), Align2::LEFT_CENTER, notes[f], 40.0, TEAL);\n        self.hints(p, rect, &[(Action::Confirm, \"Begin\"), (Action::Back, \"Back\")]);\n        if let Some(k) = chosen {\n            self.save.difficulty = k as u8;\n            self.save.started = true;\n            self.save.last_case = 0;\n            self.persist();\n            self.sim_diff();\n            self.load(\"surgery/campaign/0\");\n            self.case_files_mode = false;\n            self.go(Screen::Playing);\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn case_files(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n        style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Case Files\", 66.0, Color32::WHITE);\n        let content = content::get();\n        let n = content.cases.len();\n        self.focus = self.focus.min(n - 1);\n        if self.nav(2) || self.nav(0) {\n            self.focus = (self.focus + n - 1) % n;\n            self.cue(cue::NAV);\n        }\n        if self.nav(3) || self.nav(1) {\n            self.focus = (self.focus + 1) % n;\n            self.cue(cue::NAV);\n        }\n        // Three big cards, the focused in the middle. Click a side one to bring it here.\n        let c = rect.center() + vec2(0.0, 30.0);\n        let mut clicked = None;\n        for off in [-1i32, 1, 0] {\n            let k = (self.focus as i32 + off).rem_euclid(n as i32) as usize;\n            let size = if off == 0 { vec2(760.0, 610.0) } else { vec2(420.0, 480.0) };\n            let r = Rect::from_center_size(c + vec2(off as f32 * 660.0, 0.0), size);\n            let over = i.pointer.is_some_and(|q| r.contains(q));\n            if over && i.click {\n                clicked = Some(k);\n            }\n            let unlocked = k as u8 <= self.save.furthest;\n            let fill = if unlocked { style::PAPER } else { Color32::from_rgb(40, 52, 56) };\n            let ink = if unlocked { style::PAPER_INK } else { Color32::from_rgb(120, 136, 140) };\n            p.rect_filled(r.translate(vec2(6.0, 8.0)), 10.0, Color32::from_black_alpha(120));\n            p.rect_filled(r, 10.0, fill);\n            if off == 0 {\n                p.rect_stroke(r, 10.0, egui::Stroke::new(4.0, GOLD), StrokeKind::Outside);\n            }\n            let def = &content.cases[k];\n            let tx = r.left_top() + vec2(36.0, 30.0);\n            let big = if off == 0 { 62.0 } else { 40.0 };\n            style::plain(p, tx, Align2::LEFT_TOP, &format!(\"Case {k}\"), if off == 0 { 40.0 } else { 32.0 }, ink);\n            if unlocked {\n                style::plain(p, tx + vec2(0.0, 52.0), Align2::LEFT_TOP, &def.name, big, ink);\n                if off == 0 {\n                    style::wrapped(p, tx + vec2(0.0, 140.0), r.width() - 72.0, &format!(\"{}\\n{}\", def.patient, def.life), 34.0, ink);\n                }\n                let rank = &self.save.ranks[k];\n                if !rank.is_empty() {\n                    let rr = r.right_bottom() - vec2(50.0, 44.0);\n                    style::plain(p, rr, Align2::RIGHT_BOTTOM, rank, if off == 0 { 92.0 } else { 56.0 }, style::RED);\n                    if off == 0 {\n                        style::plain(p, rr - vec2(0.0, 92.0), Align2::RIGHT_BOTTOM, \"Best\", 30.0, ink);\n                    }\n                }\n            } else {\n                style::plain(p, tx + vec2(0.0, 52.0), Align2::LEFT_TOP, \"Sealed\", big, ink);\n            }\n        }\n        self.hints(p, rect, &[(Action::Adjust, \"Choose\"), (Action::Confirm, \"Operate\"), (Action::Back, \"Back\")]);\n        if let Some(k) = clicked {\n            if k != self.focus {\n                self.focus = k;\n                self.cue(cue::NAV);\n                return;\n            }\n        }\n        if i.confirm || (clicked == Some(self.focus)) {\n            if (self.focus as u8) <= self.save.furthest {\n                self.cue(cue::CONFIRM);\n                self.sim_diff();\n                let scene = format!(\"surgery/case/{}\", self.focus);\n                self.load(&scene);\n                self.case_files_mode = true;\n                self.go(Screen::Playing);\n            } else {\n                self.cue(cue::CLINK);\n            }\n        } else if i.back {\n            self.cue(cue::BACK);\n            self.go(Screen::Menu);\n        }\n    }\n\n    pub fn pause_menu(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n        style::outlined(p, rect.min + vec2(120.0, 110.0), Align2::LEFT_CENTER, \"Paused\", 76.0, Color32::WHITE);\n        let items: Vec<String> = [\"Resume\", \"Restart\", \"Controls\", \"Settings\", \"Dev Mode\", \"Quit to Title\"].map(String::from).to_vec();\n        let chosen = self.list(p, i, &items, rect.min + vec2(120.0, 220.0), 620.0, 100.0, 58.0);\n        self.hints(p, rect, &[(Action::Confirm, \"Select\"), (Action::Back, \"Resume\")]);\n        if let Some(k) = chosen {\n            match k {\n                0 => self.resume(),\n                1 => {\n                    self.cmds.push(ShellCmd::Paused(false));\n                    self.sim_diff();\n                    let s = self.scene.clone();\n                    self.load(&s);\n                    self.go(Screen::Playing);\n                }\n                2 => {\n                    self.came_from = Screen::Pause;\n                    self.go(Screen::Controls);\n                }\n                3 => {\n                    self.came_from = Screen::Pause;\n                    self.go(Screen::Settings);\n                }\n                4 => self.go(Screen::Dev),\n                _ => self.quit_to_title(),\n            }\n        } else if i.back || i.pause {\n            self.cue(cue::BACK);\n            self.resume();\n        }\n    }\n\n    pub fn resume(&mut self) {\n        self.cmds.push(ShellCmd::Paused(false));\n        self.go(Screen::Playing);\n    }\n\n    pub fn controls(&mut self, p: &Painter, rect: Rect, i: &ShellInput) {\n        p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n        style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Controls\", 66.0, Color32::WHITE);\n        let g = self.glyphs();\n        let lines: &[(Action, &str)] = if g.device == Device::Gamepad {\n            &[\n                (Action::Aim, \"Move the cursor\"),\n                (Action::Use, \"Use the instrument (R2 is analog)\"),\n                (Action::Pick, \"Flick to pick an instrument, instantly\"),\n                (Action::PickCycle, \"Cycle instruments. Turn a held bone\"),\n                (Action::Precision, \"Hold for precision\"),\n                (Action::Cancel, \"Let go\"),\n                (Action::Gift, \"Hold for your gift. Release on the beat\"),\n                (Action::Chart, \"The chart\"),\n                (Action::Defib, \"Hold both to charge the paddles\"),\n                (Action::Pause, \"Pause\"),\n            ]\n        } else {\n            &[\n                (Action::Aim, \"Move the cursor (WASD or arrows also move it)\"),\n                (Action::Use, \"Use the instrument (or hold E)\"),\n                (Action::Pick, \"Pick an instrument (or click it on the tray)\"),\n                (Action::PickCycle, \"Cycle instruments. Turn a held bone\"),\n                (Action::Precision, \"Hold for a precise keyboard cursor\"),\n                (Action::Cancel, \"Let go (or Q)\"),\n                (Action::Gift, \"Hold for your gift. Release on the beat\"),\n                (Action::Chart, \"The chart\"),\n                (Action::Defib, \"Hold both to charge the paddles (or F)\"),\n                (Action::Pause, \"Pause\"),\n            ]\n        };\n        if g.device == Device::Gamepad {\n            // A picture of the pad, big enough to read.\n            pad_picture(p, rect.max - vec2(600.0, 760.0));\n        } else {\n            keys_picture(p, rect.max - vec2(620.0, 760.0));\n        }\n        for (k, (a, text)) in lines.iter().enumerate() {\n            let y = rect.min.y + 190.0 + k as f32 * 72.0;\n            self.prompted(g, *a);\n            glyphs::draw(p, pos2(rect.min.x + 120.0, y), 46.0, g, *a);\n            style::outlined(p, pos2(rect.min.x + 300.0, y), Align2::LEFT_CENTER, text, 38.0, INK);\n        }\n        self.hints(p, rect, &[(Action::Back, \"Back\")]);\n        if i.back || i.confirm || i.click {\n            self.cue(cue::BACK);\n            let to = self.came_from;\n            self.go(to);\n        }\n    }\n\n    pub fn attract(&mut self, p: &Painter, rect: Rect, i: &ShellInput, f: Option<&SurgeryFrame>, vp: Mat4) {\n        if let Some(f) = f {\n            match f.stage {\n                pav_core::games::surgery::frame::Stage::Story => super::story::draw_attract(self, p, rect, f),\n                _ => super::hud::draw(self, p, rect, f, vp, i),\n            }\n        }\n        // The demo banner.\n        let top = rect.min + vec2(rect.width() * 0.5, rect.height() - 70.0);\n        let pulse = ((self.time * 2.0).sin() * 0.5 + 0.5) * 0.5 + 0.5;\n        style::outlined(p, rect.min + vec2(60.0, 1020.0 - 0.0), Align2::LEFT_CENTER, \"DEMO\", 66.0, style::with_alpha(style::RED, pulse));\n        let g = if self.touch_only { glyphs::Glyphs { device: Device::Touch, xbox: false } } else { self.glyphs() };\n        self.prompted(g, Action::Any);\n        if !self.touch_only {\n            let w = glyphs::draw(p, pos2(top.x - 200.0, top.y), 46.0, g, Action::Any);\n            style::outlined(p, pos2(top.x - 200.0 + w + 12.0, top.y), Align2::LEFT_CENTER, \"to play\", 42.0, style::with_alpha(INK, pulse));\n        } else {\n            style::outlined(p, top, Align2::CENTER_CENTER, \"Controller or keyboard required\", 42.0, GOLD);\n        }\n        // Any input returns to the title at once.\n        if i.any || i.tap.is_some() {\n            self.load(\"surgery/title\");\n            self.go(Screen::Title);\n            self.idle = 0.0;\n        }\n        let _ = cheat::IMMORTAL;\n    }\n}\n\n/// A picture of the pad.\nfn pad_picture(p: &Painter, at: Pos2) {\n    let body = Color32::from_rgb(226, 230, 234);\n    let dark = Color32::from_rgb(30, 34, 40);\n    let c = at + vec2(280.0, 150.0);\n    p.rect_filled(Rect::from_center_size(c, vec2(420.0, 190.0)), 90.0, body);\n    p.circle_filled(c + vec2(-170.0, 70.0), 76.0, body);\n    p.circle_filled(c + vec2(170.0, 70.0), 76.0, body);\n    p.rect_filled(Rect::from_center_size(c + vec2(-150.0, -96.0), vec2(90.0, 18.0)), 6.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(150.0, -96.0), vec2(90.0, 18.0)), 6.0, dark);\n    p.circle_filled(c + vec2(-70.0, 40.0), 28.0, dark);\n    p.circle_filled(c + vec2(70.0, 40.0), 28.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(-145.0, -24.0), vec2(56.0, 18.0)), 4.0, dark);\n    p.rect_filled(Rect::from_center_size(c + vec2(-145.0, -24.0), vec2(18.0, 56.0)), 4.0, dark);\n    for (dx, dy, col) in [(0.0, -30.0, Color32::from_rgb(64, 226, 160)), (30.0, 0.0, Color32::from_rgb(255, 102, 102)), (0.0, 30.0, Color32::from_rgb(124, 178, 232)), (-30.0, 0.0, Color32::from_rgb(214, 148, 214))] {\n        p.circle_filled(c + vec2(145.0 + dx, -24.0 + dy), 13.0, col);\n    }\n    p.rect_filled(Rect::from_center_size(c + vec2(0.0, -24.0), vec2(120.0, 60.0)), 8.0, Color32::from_rgb(190, 196, 202));\n}\n\n/// A picture of keys and a mouse.\nfn keys_picture(p: &Painter, at: Pos2) {\n    let cap = Color32::from_rgb(232, 236, 236);\n    let ink = Color32::from_rgb(24, 28, 32);\n    let keys: &[(f32, f32, &str)] = &[\n        (90.0, 40.0, \"W\"),\n        (30.0, 100.0, \"A\"),\n        (90.0, 100.0, \"S\"),\n        (150.0, 100.0, \"D\"),\n        (30.0, 40.0, \"Q\"),\n        (150.0, 40.0, \"E\"),\n        (210.0, 40.0, \"F\"),\n    ];\n    for (x, y, t) in keys {\n        let r = Rect::from_min_size(at + vec2(*x, *y), vec2(54.0, 54.0));\n        p.rect_filled(r, 8.0, cap);\n        p.text(r.center(), Align2::CENTER_CENTER, *t, style::font(34.0), ink);\n    }\n    let sp = Rect::from_min_size(at + vec2(30.0, 170.0), vec2(240.0, 50.0));\n    p.rect_filled(sp, 8.0, cap);\n    p.text(sp.center(), Align2::CENTER_CENTER, \"Space\", style::font(32.0), ink);\n    let m = Rect::from_min_size(at + vec2(360.0, 30.0), vec2(130.0, 200.0));\n    p.rect_filled(m, 60.0, cap);\n    p.line_segment([pos2(m.center().x, m.min.y), pos2(m.center().x, m.min.y + 80.0)], egui::Stroke::new(3.0, ink));\n    p.line_segment([pos2(m.min.x, m.min.y + 80.0), pos2(m.max.x, m.min.y + 80.0)], egui::Stroke::new(3.0, ink));\n    p.rect_filled(Rect::from_center_size(pos2(m.center().x, m.min.y + 40.0), vec2(16.0, 40.0)), 6.0, style::RED);\n}\nEOF\ncat > crates/pav_ui/src/surgery/settings.rs <<'EOF'\n//! Settings: three short pages. Sound, Controls, Display.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::cue;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Shell, ShellCmd, ShellInput};\n\npub const PAGES: [&str; 3] = [\"Sound\", \"Controls\", \"Display\"];\n\n#[derive(Clone, Copy)]\nenum Row {\n    Music,\n    Effects,\n    Voices,\n    Prompts,\n    CursorSpeed,\n    AimAssist,\n    Rumble,\n    Tremor,\n    Shake,\n    Flashes,\n    Palette,\n    TextSpeed,\n    Fullscreen,\n}\n\nfn rows(page: usize) -> &'static [Row] {\n    match page {\n        0 => &[Row::Music, Row::Effects, Row::Voices],\n        1 => &[Row::Prompts, Row::CursorSpeed, Row::AimAssist, Row::Rumble, Row::Tremor],\n        _ => &[Row::Shake, Row::Flashes, Row::Palette, Row::TextSpeed, Row::Fullscreen],\n    }\n}\n\n/// A row as (label, value text, fraction for a slider or none for a switch).\nfn describe(s: &super::save::Settings, r: Row) -> (&'static str, String, Option<f32>) {\n    let pct = |v: f32| format!(\"{}%\", (v * 100.0).round() as i32);\n    let on = |b: bool| if b { \"On\".to_string() } else { \"Off\".to_string() };\n    match r {\n        Row::Music => (\"Music\", pct(s.music), Some(s.music)),\n        Row::Effects => (\"Effects\", pct(s.effects), Some(s.effects)),\n        Row::Voices => (\"Voices\", pct(s.voices), Some(s.voices)),\n        Row::Prompts => (\"Button prompts\", if s.xbox { \"Xbox\".into() } else { \"PlayStation\".into() }, None),\n        Row::CursorSpeed => (\"Cursor speed\", format!(\"{:.0}\", s.cursor_speed), Some((s.cursor_speed - 5.0) / 25.0)),\n        Row::AimAssist => (\"Aim assist\", pct(s.aim_assist), Some(s.aim_assist)),\n        Row::Rumble => (\"Rumble\", on(s.rumble), None),\n        Row::Tremor => (\"Dr. Nwosu's tremor\", on(s.tremor), None),\n        Row::Shake => (\"Screen shake\", on(s.shake), None),\n        Row::Flashes => (\"Reduce flashes\", on(s.reduce_flashes), None),\n        Row::Palette => (\"Field palette\", if s.clinical { \"Clinical\".into() } else { \"Anatomical\".into() }, None),\n        Row::TextSpeed => (\"Text speed\", format!(\"{:.0}\", s.text_speed), Some((s.text_speed - 15.0) / 105.0)),\n        Row::Fullscreen => (\"Fullscreen\", on(s.fullscreen), None),\n    }\n}\n\nfn adjust(shell: &mut Shell, r: Row, delta: f32) {\n    let s = &mut shell.save.settings;\n    match r {\n        Row::Music => s.music = (s.music + delta * 0.05).clamp(0.0, 1.0),\n        Row::Effects => s.effects = (s.effects + delta * 0.05).clamp(0.0, 1.0),\n        Row::Voices => s.voices = (s.voices + delta * 0.05).clamp(0.0, 1.0),\n        Row::Prompts => s.xbox = !s.xbox,\n        Row::CursorSpeed => s.cursor_speed = (s.cursor_speed + delta).clamp(5.0, 30.0),\n        Row::AimAssist => s.aim_assist = (s.aim_assist + delta * 0.1).clamp(0.0, 1.0),\n        Row::Rumble => s.rumble = !s.rumble,\n        Row::Tremor => s.tremor = !s.tremor,\n        Row::Shake => s.shake = !s.shake,\n        Row::Flashes => s.reduce_flashes = !s.reduce_flashes,\n        Row::Palette => s.clinical = !s.clinical,\n        Row::TextSpeed => s.text_speed = (s.text_speed + delta * 5.0).clamp(15.0, 120.0),\n        Row::Fullscreen => s.fullscreen = !s.fullscreen,\n    }\n    apply(shell, r);\n}\n\nfn set_fraction(shell: &mut Shell, r: Row, k: f32) {\n    let k = k.clamp(0.0, 1.0);\n    let s = &mut shell.save.settings;\n    match r {\n        Row::Music => s.music = k,\n        Row::Effects => s.effects = k,\n        Row::Voices => s.voices = k,\n        Row::CursorSpeed => s.cursor_speed = 5.0 + k * 25.0,\n        Row::AimAssist => s.aim_assist = k,\n        Row::TextSpeed => s.text_speed = 15.0 + k * 105.0,\n        _ => {}\n    }\n    apply(shell, r);\n}\n\nfn apply(shell: &mut Shell, r: Row) {\n    let s = shell.save.settings.clone();\n    match r {\n        Row::Music | Row::Effects | Row::Voices => shell.cmds.push(ShellCmd::Mix { music: s.music, effects: s.effects, voices: s.voices }),\n        Row::TextSpeed => shell.cmds.push(ShellCmd::Sim(SurgeryCmd::TextSpeed(s.text_speed))),\n        Row::Tremor => shell.cmds.push(ShellCmd::Sim(SurgeryCmd::Tremor(s.tremor))),\n        Row::Fullscreen => shell.cmds.push(ShellCmd::Fullscreen(s.fullscreen)),\n        _ => {}\n    }\n    shell.persist();\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n    style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, \"Settings\", 66.0, Color32::WHITE);\n    // Tabs.\n    let mut x = rect.min.x + 500.0;\n    let mut clicked_tab = None;\n    for (k, name) in PAGES.iter().enumerate() {\n        let r = Rect::from_min_size(pos2(x, rect.min.y + 58.0), vec2(250.0, 66.0));\n        let on = k == shell.page;\n        p.rect_filled(r, 10.0, if on { style::with_alpha(TEAL, 0.32) } else { style::with_alpha(Color32::BLACK, 0.3) });\n        if on {\n            p.rect_stroke(r, 10.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, name, 42.0, if on { Color32::WHITE } else { INK });\n        if i.pointer.is_some_and(|q| r.contains(q)) && i.click {\n            clicked_tab = Some(k);\n        }\n        x += 270.0;\n    }\n    if let Some(k) = clicked_tab {\n        shell.page = k;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_prev {\n        shell.page = (shell.page + PAGES.len() - 1) % PAGES.len();\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_next {\n        shell.page = (shell.page + 1) % PAGES.len();\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    let list = rows(shell.page);\n    let n = list.len();\n    shell.focus = shell.focus.min(n - 1);\n    if shell.nav(0) {\n        shell.focus = (shell.focus + n - 1) % n;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(1) {\n        shell.focus = (shell.focus + 1) % n;\n        shell.cue(cue::NAV);\n    }\n    let left = rect.min.x + 160.0;\n    for (k, r) in list.iter().enumerate() {\n        let y = rect.min.y + 210.0 + k as f32 * 124.0;\n        let row = Rect::from_min_size(pos2(left - 30.0, y), vec2(rect.width() - 260.0, 108.0));\n        let over = i.pointer.is_some_and(|q| row.contains(q));\n        if over && i.pointer_moved && shell.focus != k {\n            shell.focus = k;\n            shell.cue(cue::NAV);\n        }\n        let f = shell.focus == k;\n        if f {\n            p.rect_filled(row, 10.0, style::with_alpha(TEAL, 0.18));\n            p.rect_stroke(row, 10.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        let (label, value, frac) = describe(&shell.save.settings, *r);\n        style::outlined(p, pos2(left, row.center().y), Align2::LEFT_CENTER, label, 50.0, if f { Color32::WHITE } else { INK });\n        style::outlined(p, pos2(row.max.x - 30.0, row.center().y), Align2::RIGHT_CENTER, &value, 50.0, GOLD);\n        if let Some(fr) = frac {\n            let track = Rect::from_min_size(pos2(left + 560.0, row.center().y - 12.0), vec2(620.0, 24.0));\n            p.rect_filled(track, 12.0, Color32::from_black_alpha(160));\n            let fill = Rect::from_min_size(track.min, vec2(track.width() * fr.clamp(0.0, 1.0), 24.0));\n            p.rect_filled(fill, 12.0, TEAL);\n            p.circle_filled(pos2(fill.max.x, track.center().y), 20.0, Color32::WHITE);\n            if i.drag {\n                if let Some(q) = i.pointer {\n                    if track.expand2(vec2(10.0, 30.0)).contains(q) {\n                        set_fraction(shell, *r, (q.x - track.min.x) / track.width());\n                    }\n                }\n            }\n        } else if over && i.click {\n            adjust(shell, *r, 1.0);\n            shell.cue(cue::CONFIRM);\n        }\n        if i.tap.is_some_and(|q| row.contains(q)) {\n            shell.focus = k;\n            if frac.is_none() {\n                adjust(shell, *r, 1.0);\n            }\n        }\n    }\n    let r = list[shell.focus];\n    let is_slider = describe(&shell.save.settings, r).2.is_some();\n    if shell.nav(2) {\n        adjust(shell, r, -1.0);\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(3) {\n        adjust(shell, r, 1.0);\n        shell.cue(cue::NAV);\n    }\n    if i.confirm && !is_slider {\n        adjust(shell, r, 1.0);\n        shell.cue(cue::CONFIRM);\n    }\n    shell.hints(p, rect, &[(Action::TabPrev, \"Page\"), (Action::TabNext, \"Page\"), (Action::Adjust, \"Change\"), (Action::Back, \"Back\")]);\n    if shell.touch_only {\n        let back = Rect::from_center_size(pos2(rect.max.x - 190.0, rect.max.y - 70.0), vec2(280.0, 90.0));\n        p.rect_filled(back, 12.0, style::with_alpha(TEAL, 0.3));\n        style::outlined(p, back.center(), Align2::CENTER_CENTER, \"Back\", 46.0, Color32::WHITE);\n        if i.tap.is_some_and(|q| back.contains(q)) {\n            let to = shell.came_from;\n            shell.go(to);\n            return;\n        }\n    }\n    if i.back {\n        shell.cue(cue::BACK);\n        let to = shell.came_from;\n        shell.go(to);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/about.rs <<'EOF'\n//! About: paged, big text. The text comes from a JSON block (the page's `about-data`, generated\n//! from the exit interview), so an importing agent can add usage without rebuilding the wasm.\n\nuse egui::{Align2, Color32, Painter, Rect, vec2};\nuse pav_core::games::surgery::cue;\nuse serde::Deserialize;\n\nuse super::glyphs::Action;\nuse super::style::{self, INK};\nuse super::{Shell, ShellInput};\n\n#[derive(Clone, Debug, Default, Deserialize)]\npub struct AboutSection {\n    pub title: String,\n    pub lines: Vec<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\npub struct About {\n    pub sections: Vec<AboutSection>,\n}\n\nconst BUILT_IN: &str = include_str!(\"about.json\");\n\n/// Characters on a page at 34 points, about, before it runs to another.\nconst PAGE_LINES: f32 = 15.0;\nconst CHARS_PER_LINE: f32 = 88.0;\n\nimpl About {\n    pub fn built_in() -> Self {\n        Self::parse(BUILT_IN).unwrap_or_default()\n    }\n\n    pub fn parse(json: &str) -> Option<Self> {\n        serde_json::from_str(json).ok()\n    }\n\n    /// The text cut into screens: never a scrollbar.\n    pub fn pages(&self) -> Vec<(String, Vec<String>)> {\n        let mut out = Vec::new();\n        for s in &self.sections {\n            let (mut used, mut lines) = (0.0, Vec::new());\n            for l in &s.lines {\n                let need = (l.chars().count() as f32 / CHARS_PER_LINE).ceil().max(1.0) + 0.3;\n                if used + need > PAGE_LINES && !lines.is_empty() {\n                    out.push((s.title.clone(), std::mem::take(&mut lines)));\n                    used = 0.0;\n                }\n                lines.push(l.clone());\n                used += need;\n            }\n            if !lines.is_empty() {\n                out.push((s.title.clone(), lines));\n            }\n        }\n        if out.is_empty() {\n            out.push((\"About\".to_string(), vec![\"Nothing here yet.\".to_string()]));\n        }\n        out\n    }\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.96));\n    let pages = shell.about.pages();\n    let n = pages.len();\n    shell.page = shell.page.min(n - 1);\n    if shell.nav(2) || i.tab_prev {\n        shell.page = (shell.page + n - 1) % n;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(3) || i.tab_next || i.confirm || (i.click && !i.back) {\n        shell.page = (shell.page + 1) % n;\n        shell.cue(cue::NAV);\n    }\n    let (title, lines) = &pages[shell.page];\n    style::outlined(p, rect.min + vec2(120.0, 90.0), Align2::LEFT_CENTER, title, 66.0, Color32::WHITE);\n    style::outlined(p, rect.right_top() + vec2(-120.0, 90.0), Align2::RIGHT_CENTER, &format!(\"{} / {}\", shell.page + 1, n), 42.0, style::DIM);\n    let mut y = rect.min.y + 170.0;\n    for l in lines {\n        y = style::wrapped(p, egui::pos2(rect.min.x + 120.0, y), rect.width() - 240.0, l, 34.0, INK) + 12.0;\n    }\n    shell.hints(p, rect, &[(Action::Adjust, \"Page\"), (Action::Back, \"Back\")]);\n    if i.back {\n        shell.cue(cue::BACK);\n        let to = shell.came_from;\n        shell.go(to);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/about.json <<'EOF'\n{\"sections\":[{\"title\":\"Credits\",\"lines\":[\"The first build of the About data: the packer replaces this.\"]}]}\nEOF\necho ok","description":"Write the shell, menus, settings and About screens"}}}
