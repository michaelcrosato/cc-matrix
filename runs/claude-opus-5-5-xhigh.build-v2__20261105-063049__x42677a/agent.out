.0 };\n                    h.heat_paid = true;\n                    let rating =\"\"\")\nsub(\"\"\"                    self.cue(events, snd, pos, 1.0, 1.0);\n                    self.award(slot, rating, tool, pos, false, events);\n                    self.finish_hazard(engaged, slot, rating, events);\"\"\", \"\"\"                    self.cue(events, snd, pos, 1.0, 1.0);\n                    self.award_share(slot, rating, tool, pos, false, share, events);\n                    self.finish_hazard(engaged, slot, rating, events);\"\"\")\n\n# The IV pays for what it healed, at a quarter.\nsub(\"\"\"            let heal = heal * self.tune.get(tune::IV_HEAL);\n            self.op.vitals = (self.op.vitals + heal).min(self.op.vitals_max);\n            self.cue(events, cue::IV, PORT, 1.0, 1.3);\n            self.award(slot, rating, Tool::Iv, PORT, false, events);\"\"\", \"\"\"            let heal = heal * self.tune.get(tune::IV_HEAL);\n            let before = self.op.vitals;\n            self.op.vitals = (before + heal).min(self.op.vitals_max);\n            let used = ((self.op.vitals - before) / heal.max(0.01)).clamp(0.0, 1.0);\n            self.cue(events, cue::IV, PORT, 1.0, 1.3);\n            self.award_share(slot, rating, Tool::Iv, PORT, false, REPEAT_SHARE * used, events);\"\"\")\n\n# award -> award_share.\nsub(\"\"\"    pub fn award(&mut self, slot: usize, rating: Rating, tool: Tool, pos: Vec2, ghost: bool, events: &mut Vec<SimEvent>) {\n\"\"\", \"\"\"    pub fn award(&mut self, slot: usize, rating: Rating, tool: Tool, pos: Vec2, ghost: bool, events: &mut Vec<SimEvent>) {\n        self.award_share(slot, rating, tool, pos, ghost, 1.0, events);\n    }\n\n    /// An award for work that doesn't advance the operation: a dose keeps the patient alive, a\n    /// repeated heat pass redoes what slipped away. It is still rated, but with a `share` below 1\n    /// it pays that part of the points and the gift and builds no chain, so stalling never pays.\n    #[allow(clippy::too_many_arguments)]\n    pub fn award_share(\n        &mut self,\n        slot: usize,\n        rating: Rating,\n        tool: Tool,\n        pos: Vec2,\n        ghost: bool,\n        share: f32,\n        events: &mut Vec<SimEvent>,\n    ) {\n\"\"\")\nsub(\"\"\"        match rating {\n            Rating::Immaculate | Rating::Clean => {\n                s.chain += 1;\n                s.chain_t = chain_window;\n                s.best_chain = s.best_chain.max(s.chain);\n            }\n            Rating::Sloppy => s.chain = 0,\n            Rating::Good => s.chain_t = s.chain_t.max(chain_window * 0.5),\n        }\n        let mult = if s.chain >= 20 {\"\"\", \"\"\"        match rating {\n            Rating::Immaculate | Rating::Clean if share >= 1.0 => {\n                s.chain += 1;\n                s.chain_t = chain_window;\n                s.best_chain = s.best_chain.max(s.chain);\n            }\n            Rating::Sloppy => s.chain = 0,\n            _ => s.chain_t = s.chain_t.max(chain_window * 0.5),\n        }\n        let mult = if share < 1.0 {\n            1.0\n        } else if s.chain >= 20 {\"\"\")\nsub(\"\"\"        let points = rating.points() * mult * if on_beat { 1.25 } else { 1.0 } * score_scale;\"\"\",\n    \"\"\"        let points = rating.points() * mult * if on_beat { 1.25 } else { 1.0 } * score_scale * share;\"\"\")\nsub(\"\"\"        s.gift = (s.gift + charge * gain).min(100.0);\"\"\", \"\"\"        s.gift = (s.gift + charge * gain * share).min(100.0);\"\"\")\n\n# The constant, before the Rating type.\nsub(\"\"\"/// How well an action went. Numbers are array indices.\"\"\", \"\"\"/// What a dose of the IV, or a heat pass on something that already took one, pays of a full award.\nconst REPEAT_SHARE: f32 = 0.25;\n\n/// How well an action went. Numbers are array indices.\"\"\")\np.write_text(t)\n\np = pathlib.Path(\"tests/surgery.rs\")\nt = p.read_text()\nsub(\"\"\"#[test]\nfn on_beat_action_pays_more_and_chains_multiply() {\"\"\", \"\"\"#[test]\nfn pumping_the_iv_never_pays() {\n    let dose = |vitals: f32| -> (i32, i32, f32) {\n        let mut s = sim(\"surgery/case/0\", 1);\n        into_op(&mut s);\n        let g = game_mut(&mut s);\n        g.op.vitals = vitals;\n        g.surgeons[0].chain = 3;\n        let iv = place(game(&s), Tool::Iv);\n        hold(&mut s, 0, Vec2::ZERO, iv, 0, 2);\n        hold(&mut s, 0, Vec2::ZERO, iv, hands::USE, 68);\n        hold(&mut s, 0, Vec2::ZERO, iv, 0, 2);\n        let g = game(&s);\n        (g.surgeons[0].score, g.surgeons[0].chain, g.surgeons[0].gift)\n    };\n    // A patient with nothing to heal: no points and no gift.\n    let (score, chain, gift) = dose(100.0);\n    assert_eq!((score, gift), (0, 0.0), \"a dose nobody needed\");\n    assert_eq!(chain, 3, \"it neither builds a chain nor breaks one\");\n    // A patient who needs it: rated, but a quarter of a full award at the very most.\n    let (score, chain, _) = dose(40.0);\n    assert!(score > 0, \"a needed dose still earns something\");\n    assert!(score as f32 <= 400.0 * 1.25 * 0.25, \"a dose pays less than surgery: {score}\");\n    assert_eq!(chain, 3);\n}\n\n#[test]\nfn better_hands_outscore_slower_ones() {\n    let total = |case: usize, seed: u64, skill: f32| -> Option<i32> {\n        let mut s = sim(&format!(\"surgery/case/{case}\"), seed);\n        game_mut(&mut s).bot_skill = skill;\n        let (o, _) = s.run_bot(MAX_TICKS);\n        (o == Outcome::Won).then(|| game(&s).results.as_ref().unwrap().total)\n    };\n    for case in 0..content::CASES {\n        for seed in 1..=2 {\n            let best = total(case, seed, 1.0).expect(\"skill 1.0 wins\");\n            for skill in [0.5, 0.3] {\n                if let Some(slow) = total(case, seed, skill) {\n                    assert!(slow <= best, \"case {case} seed {seed}: skill {skill} scored {slow} over skill 1.0's {best}\");\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn on_beat_action_pays_more_and_chains_multiply() {\"\"\")\np.write_text(t)\nEOF\ncd ../.. ; for i in $(seq 1 60); do a=$(free -m | awk 'NR==2{print $7}'); [ \"$a\" -gt 2500 ] && break; sleep 5; done; CARGO_BUILD_JOBS=4 cargo test --offline -p pav_core --test surgery -- --include-ignored score_sources pumping better_hands balance_targets 2>&1 | grep -E \"^case[0-9] skill(1.0|0.5|0.3)|^error|^test |test result|panicked|scored|ranked|should\" | cut -c1-150","description":"Apply the scoring fix and tests, then rerun the breakdown","timeout":590000}}}
