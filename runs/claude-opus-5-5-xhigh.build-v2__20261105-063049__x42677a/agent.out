{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjutE62T7BYczEdeHyKE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017EkgzKhWNeu9AxbxnQrreX","name":"Bash","input":{"command":"cat > crates/pav_view/src/surgery/strains.rs <<'EOF'\n//! Everything lying on the tissue: objects, parasites and the thread you left behind. SDF spheres\n//! and capsules with emissive parts.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::field::{Hazard, HazardKind as K, polyline_at};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::scene::{PointLight, Scene, SdfInstance, Style, flags, srgb};\n\nuse super::plate::PlateView;\n\nconst OBJ: u32 = flags::OBJECT | flags::NO_CUT;\n\nfn sd(scene: &mut Scene, a: Vec3, b: Vec3, ra: f32, rb: f32, color: Vec3, emissive: f32, style: Style, group: u32) {\n    scene.sdfs.push(SdfInstance { a, b, ra, rb, color, emissive, style, flags: OBJ, group, material: 0 });\n}\n\nfn on(p: Vec2, y: f32) -> Vec3 {\n    Vec3::new(p.x, y, p.y)\n}\n\nfn dir3(a: f32) -> Vec3 {\n    Vec3::new(a.cos(), 0.0, a.sin())\n}\n\npub fn emit(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, time: f32) {\n    let parasite = srgb(58, 26, 96);\n    let core = srgb(36, 18, 66);\n    let eye = srgb(255, 210, 70);\n    let sac = srgb(120, 255, 170);\n    let bone = srgb(238, 226, 200);\n    let metal = Vec3::new(0.56, 0.6, 0.64);\n    let rust = srgb(150, 94, 60);\n    let hook = srgb(210, 214, 220);\n    let frost = srgb(190, 230, 245);\n    let ember = srgb(255, 130, 40);\n    let thread = srgb(30, 44, 130);\n    let gauze = srgb(244, 242, 232);\n\n    // Thread stays on.\n    for s in &f.stains {\n        if s.kind == 1 && s.pts.len() >= 2 {\n            stitches(scene, plate, &s.pts, f32::MAX, thread);\n        }\n    }\n\n    for h in &f.hazards {\n        let g = 0x2000 + h.id;\n        let y = plate.height_at(h.pos);\n        let lift = h.drag.length() * 0.45;\n        let drag3 = Vec3::new(h.drag.x, lift, h.drag.y);\n        match h.kind {\n            K::Laceration | K::Bleeder => {\n                if h.progress > 0.0 {\n                    stitches(scene, plate, &h.pts, h.progress, thread);\n                }\n            }\n            K::Foreign => {\n                if h.hidden && h.reveal <= 0.0 {\n                    continue;\n                }\n                let d = dir3(h.axis);\n                let base = on(h.pos, y) + drag3;\n                let up = Vec3::Y;\n                match h.tag {\n                    0 => {\n                        // A barbed hook: a curve of steel with a barb.\n                        let mut last = base - d * 0.2 + up * 0.04;\n                        for i in 1..=5 {\n                            let t = i as f32 / 5.0;\n                            let p = base + d * (t * 0.55 - 0.2) + up * ((t * 2.6).sin() * 0.5 + 0.05);\n                            sd(scene, last, p, 0.055, 0.05, hook, 0.0, Style::Lit, g);\n                            last = p;\n                        }\n                        let tail = base + d * 0.5 + up * 0.75;\n                        sd(scene, last, tail, 0.05, 0.05, hook, 0.0, Style::Lit, g);\n                        sd(scene, base - d * 0.2 + up * 0.04, base - d * 0.02 + up * 0.28, 0.05, 0.012, hook, 0.0, Style::Lit, g);\n                        sd(scene, tail, tail + up * 0.06, 0.09, 0.09, rust, 0.0, Style::Cel, g);\n                    }\n                    1 => {\n                        // A shard of metal, standing proud.\n                        sd(scene, base - d * 0.1, base + d * 0.25 + up * 0.62, 0.17, 0.02, metal, 0.0, Style::Lit, g);\n                        sd(scene, base + d * 0.12, base + d * 0.46 + up * 0.32, 0.1, 0.015, rust, 0.0, Style::Lit, g);\n                    }\n                    2 => {\n                        // A cable splinter: twisted strands.\n                        for k in 0..3 {\n                            let off = dir3(h.axis + 1.57) * (k as f32 - 1.0) * 0.045;\n                            sd(scene, base + off - d * 0.05, base + off + d * 0.5 + up * 0.5, 0.032, 0.012, metal, 0.0, Style::Lit, g);\n                        }\n                    }\n                    3 => {\n                        // A piece of ember.\n                        sd(scene, base, base + d * 0.14 + up * 0.26, 0.2, 0.08, ember, 1.2, Style::Unlit, g);\n                    }\n                    4 => {\n                        // A cyst, or an appendix.\n                        sd(scene, base - d * 0.3 + up * 0.1, base + d * 0.3 + up * 0.32, h.r * 0.7, h.r, srgb(240, 170, 130), 0.0, Style::Cel, g);\n                    }\n                    _ => {\n                        // A seed: a violet pill.\n                        sd(scene, base - d * 0.12, base + d * 0.14 + up * 0.18, 0.13, 0.13, parasite, 0.0, Style::Cel, g);\n                        sd(scene, base + up * 0.18, base + up * 0.18, 0.06, 0.06, eye, 1.0, Style::Unlit, g);\n                    }\n                }\n            }\n            K::Polyp => {\n                let base = on(h.pos, y);\n                let (c, tip) = if h.tag == 4 { (srgb(250, 226, 170), srgb(255, 244, 210)) } else { (srgb(250, 150, 130), srgb(255, 200, 170)) };\n                let hot = h.heat.clamp(0.0, 1.3);\n                sd(scene, base, base + Vec3::Y * h.r * 0.5, h.r * 0.75, h.r * 0.55, c.lerp(ember, hot * 0.6), hot * 0.7, Style::Cel, g);\n                sd(scene, base + Vec3::Y * h.r * 0.75, base + Vec3::Y * h.r * 0.75, h.r * 0.44, h.r * 0.44, tip.lerp(ember, hot * 0.7), hot * 0.9, Style::Cel, g);\n            }\n            K::Tumor => {\n                if h.stage >= 2 {\n                    continue;\n                }\n                let base = on(h.pos, y) + drag3 * 1.6;\n                let lump = srgb(120, 56, 104);\n                let dark = srgb(84, 36, 84);\n                let beat = 1.0 + super::plate::beat_env(f.beat) * 0.03;\n                sd(scene, base, base + Vec3::Y * 0.18, h.r * 0.74 * beat, h.r * 0.66 * beat, lump, 0.0, Style::Cel, g);\n                for k in 0..5 {\n                    let a = k as f32 * 2.399 + h.id as f32;\n                    let p = base + dir3(a) * h.r * 0.56 + Vec3::Y * 0.26;\n                    sd(scene, p, p, h.r * 0.38 * beat, h.r * 0.38 * beat, dark, 0.0, Style::Cel, g + k);\n                }\n            }\n            K::Bone => {\n                let d = dir3(h.angle);\n                let at = on(h.pos, y + 0.25) + if h.by != 0 { Vec3::Y * 0.3 } else { Vec3::ZERO };\n                sd(scene, at - d * 0.72, at + d * 0.72, 0.3, 0.3, bone, 0.0, Style::Cel, g);\n                sd(scene, at + d * 0.72, at + d * 0.92 + Vec3::Y * 0.03, 0.26, 0.1, bone * 0.86, 0.0, Style::Cel, g);\n                sd(scene, at - d * 0.72, at - d * 0.92 + Vec3::Y * 0.02, 0.26, 0.1, bone * 0.86, 0.0, Style::Cel, g);\n                if h.stage == 1 && h.count > 0 {\n                    for k in 0..h.count {\n                        let off = d.cross(Vec3::Y).normalize() * (k as f32 - 0.5) * 0.28;\n                        sd(scene, at + off - d * 0.42 + Vec3::Y * 0.26, at + off + d * 0.42 + Vec3::Y * 0.26, 0.03, 0.03, metal, 0.0, Style::Lit, g);\n                    }\n                }\n            }\n            K::Nodule => {\n                if h.hidden && h.reveal <= 0.0 {\n                    continue;\n                }\n                let t_step = h.t;\n                let squash = 1.0 + h.dev * 0.2 * (time * 18.0).sin() - t_step * 0.25;\n                let base = on(h.pos, y + 0.05);\n                let r = h.r * squash.max(0.6);\n                let shake = if h.heat > 0.0 { (time * 40.0).sin() * 0.02 * h.heat } else { 0.0 };\n                let hot = h.heat.clamp(0.0, 1.3);\n                if h.stage == 0 {\n                    sd(scene, base + Vec3::X * shake, base + Vec3::X * shake + Vec3::Y * r * 0.25, r, r * 0.9, parasite.lerp(ember, hot * 0.7), hot * 0.8 + 0.08, Style::Cel, g);\n                    for k in 0..6 {\n                        let a = k as f32 * 1.047 + time * 0.7;\n                        let p = base + dir3(a) * r * 0.86 + Vec3::Y * r * 0.3;\n                        sd(scene, p, p + dir3(a) * r * 0.32 + Vec3::Y * 0.05, r * 0.2, 0.02, core, 0.0, Style::Cel, g);\n                    }\n                    if h.lit > 0.0 {\n                        scene.point_lights.push(PointLight { position: base + Vec3::Y, color: Vec3::new(0.55, 0.3, 1.0) * h.lit, radius: 3.0, shadows: false });\n                    }\n                    sd(scene, base + Vec3::Y * r, base + Vec3::Y * r, r * 0.26, r * 0.26, eye * 0.8, 0.4, Style::Unlit, g + 1);\n                } else {\n                    // Shell popped: the soft core, ready to pull.\n                    let lifted = base + drag3 * 1.6;\n                    sd(scene, lifted, lifted + Vec3::Y * 0.2, r * 0.8, r * 0.7, core, 0.0, Style::Cel, g);\n                    sd(scene, lifted + Vec3::Y * r * 0.72, lifted + Vec3::Y * r * 0.72, r * 0.46, r * 0.46, eye, 1.6, Style::Unlit, g + 1);\n                    for k in 0..4 {\n                        let a = k as f32 * 1.57 + 0.4;\n                        let p = base + dir3(a) * r * 1.2;\n                        sd(scene, p, p + Vec3::Y * 0.2, r * 0.3, 0.03, parasite, 0.0, Style::Cel, g + 2);\n                    }\n                }\n            }\n            K::Sac => {\n                let stem = on(h.to, plate.height_at(h.to) + 0.1);\n                let wob = (time * (7.0 + h.progress * 14.0) + h.id as f32).sin() * (0.02 + h.progress * 0.05);\n                let at = on(h.pos, y + 0.28) + Vec3::new(wob, 0.0, -wob);\n                let heat = h.heat.clamp(0.0, 1.0);\n                let stem_c = parasite.lerp(ember, if h.count == 0 { heat } else { 0.0 });\n                sd(scene, stem, at, 0.09, 0.07, stem_c, heat * 0.8, Style::Cel, g);\n                let r = h.r * (1.0 + wob * 2.0);\n                let col = sac.lerp(Vec3::new(1.0, 0.92, 0.3), (h.progress - 0.55).clamp(0.0, 0.45) * 2.0);\n                let d = (at - stem).normalize_or(Vec3::X);\n                sd(scene, at - d * r * 0.5, at + d * r * 0.55, r * 0.34, r, col, 0.75 + h.progress * 0.4, Style::Unlit, g + 1);\n            }\n            K::Crown => {\n                let base = on(h.pos, y + 0.05);\n                for k in 0..11 {\n                    let a = k as f32 * std::f32::consts::TAU / 11.0 + time * 0.25;\n                    let r0 = h.r * 0.86;\n                    let wave = (time * 2.0 + k as f32 * 1.3).sin() * 0.14;\n                    let p = base + Vec3::new(a.cos() * r0 * 1.3, 0.1, a.sin() * r0);\n                    let q = base + Vec3::new(a.cos() * (r0 + 0.55) * 1.3, 0.55 + wave, a.sin() * (r0 + 0.55));\n                    sd(scene, p, q, 0.2, 0.02, parasite, 0.05, Style::Cel, g);\n                    let n = base + Vec3::new(a.cos() * r0 * 0.7 * 1.3, 0.05, a.sin() * r0 * 0.7);\n                    sd(scene, n, p, 0.14, 0.2, core, 0.0, Style::Cel, g);\n                }\n            }\n            K::Eye => {\n                let base = on(h.pos, y + 0.2) + drag3 * 1.6;\n                match h.stage {\n                    0 => {\n                        sd(scene, base, base, h.r * 0.7, h.r * 0.7, core, 0.05, Style::Cel, g);\n                    }\n                    1 | 2 => {\n                        sd(scene, base, base, h.r * 0.9, h.r * 0.9, eye, 1.6, Style::Unlit, g);\n                        let look = Vec2::new((time * 0.9).sin(), (time * 0.7).cos()) * 0.2;\n                        let p = base + Vec3::new(look.x, h.r * 0.74, look.y);\n                        sd(scene, p, p, h.r * 0.34, h.r * 0.34, Vec3::new(0.02, 0.01, 0.03), 0.0, Style::Unlit, g + 1);\n                        let c = base + Vec3::Y * 0.5;\n                        scene.point_lights.push(PointLight { position: c, color: Vec3::new(1.0, 0.8, 0.3) * 0.7, radius: 4.0, shadows: false });\n                    }\n                    _ => {}\n                }\n            }\n            K::Ember => {\n                if h.stage >= 2 {\n                    continue;\n                }\n                let base = on(h.pos, y + 0.1);\n                let frozen = h.stage == 1 || h.heat > 0.4;\n                let color = if frozen { frost } else { ember };\n                let glow = if frozen { 0.2 } else { 1.0 + (time * 5.0 + h.id as f32).sin() * 0.3 };\n                let dark = if frozen { frost * 0.7 } else { srgb(90, 26, 18) };\n                sd(scene, base, base + Vec3::Y * 0.2, h.r, h.r * 0.74, dark, 0.0, Style::Cel, g);\n                for k in 0..5 {\n                    let a = k as f32 * 1.256 + h.id as f32;\n                    let p = base + dir3(a) * h.r * 0.62 + Vec3::Y * h.r * 0.5;\n                    sd(scene, p, p + Vec3::Y * 0.1, h.r * 0.32, h.r * 0.14, color, glow, Style::Unlit, g);\n                }\n                if !frozen {\n                    scene.point_lights.push(PointLight { position: base + Vec3::Y * 0.8, color: Vec3::new(1.0, 0.45, 0.15) * 0.8, radius: 3.4, shadows: false });\n                }\n            }\n            K::Tether => {\n                chain(scene, plate, &h.pts, h.progress, h.len(), 0.11, 0.07, parasite, 0.1, g, time, 0.05);\n            }\n            K::Tendril => {\n                chain(scene, plate, &h.pts, h.progress, h.len(), 0.2, 0.1, parasite, 0.12, g, time, 0.16);\n                let tip = polyline_at(&h.pts, h.progress).0;\n                let t3 = on(tip, plate.height_at(tip) + 0.35);\n                sd(scene, t3, t3, 0.42, 0.42, core, 0.0, Style::Cel, g);\n                sd(scene, t3 + Vec3::Y * 0.3, t3 + Vec3::Y * 0.3, 0.2, 0.2, eye, 1.6, Style::Unlit, g + 1);\n            }\n            K::Closure => {\n                // The gauze laid so far.\n                let mut s = 0.0;\n                while s < h.progress {\n                    let p = polyline_at(&h.pts, s).0;\n                    let q = polyline_at(&h.pts, (s + 0.3).min(h.progress)).0;\n                    sd(scene, on(p, plate.height_at(p) + 0.05), on(q, plate.height_at(q) + 0.05), 0.2, 0.2, gauze, 0.0, Style::Cel, g);\n                    s += 0.3;\n                }\n            }\n            K::Furnace => {\n                let base = on(h.pos, y + 0.1) + drag3;\n                let k = 1.0 - h.stage as f32 * 0.09;\n                let r = h.r * k;\n                let hot = if h.stage == 0 { 1.6 } else if h.stage < 4 { 0.9 } else { 0.25 };\n                sd(scene, base, base + Vec3::Y * 0.3, r, r * 0.84, srgb(40, 16, 24), 0.0, Style::Cel, g);\n                for i in 0..9 {\n                    let a = i as f32 * 2.399 + time * 0.2;\n                    let p = base + dir3(a) * r * 0.8 + Vec3::Y * r * 0.55;\n                    let q = base + dir3(a + 0.5) * r * 0.5 + Vec3::Y * r * 0.95;\n                    sd(scene, p, q, 0.07, 0.04, if h.stage == 0 { ember } else { frost.lerp(ember, 0.5) }, hot, Style::Unlit, g);\n                }\n                scene.point_lights.push(PointLight { position: base + Vec3::Y * 1.5, color: Vec3::new(1.0, 0.42, 0.14) * 1.2 * k, radius: 6.0, shadows: false });\n            }\n            _ => {}\n        }\n    }\n}\n\n/// A line of thread, up to `upto` along the wound: small crossing stitches.\nfn stitches(scene: &mut Scene, plate: &PlateView, pts: &[Vec2], upto: f32, color: Vec3) {\n    let len = pv_len(pts);\n    let end = upto.min(len);\n    let mut s = 0.1;\n    let mut flip = 1.0f32;\n    while s < end {\n        let (p, t) = polyline_at(pts, s);\n        let n = Vec2::new(-t.y, t.x) * 0.2 * flip;\n        let a = p - n + t * 0.05;\n        let b = p + n + t * 0.05;\n        let y = plate.height_at(p) + 0.05;\n        scene.sdfs.push(SdfInstance {\n            a: on(a, y),\n            b: on(b, y + 0.02),\n            ra: 0.024,\n            rb: 0.024,\n            color,\n            emissive: 0.0,\n            style: Style::Cel,\n            flags: flags::NO_SHADOW | OBJ,\n            group: 0x1F00,\n            material: 0,\n        });\n        flip = -flip;\n        s += 0.25;\n    }\n}\n\nfn pv_len(pts: &[Vec2]) -> f32 {\n    pts.windows(2).map(|w| w[0].distance(w[1])).sum()\n}\n\n/// A creeping chain of capsules along a polyline, from `from` to `to`.\nfn chain(scene: &mut Scene, plate: &PlateView, pts: &[Vec2], from: f32, to: f32, ra: f32, rb: f32, color: Vec3, glow: f32, g: u32, time: f32, wave: f32) {\n    let steps = (((to - from) / 0.4).ceil() as i32).max(1);\n    let mut last = None;\n    for i in 0..=steps {\n        let s = from + (to - from) * i as f32 / steps as f32;\n        let (p, t) = polyline_at(pts, s);\n        let n = Vec2::new(-t.y, t.x) * (time * 3.0 + s * 2.3).sin() * wave;\n        let at = p + n;\n        let q = on(at, plate.height_at(at) + 0.18);\n        if let Some(l) = last {\n            let k = i as f32 / steps as f32;\n            sd(scene, l, q, ra + (rb - ra) * k, ra + (rb - ra) * k, color, glow, Style::Cel, g);\n        }\n        last = Some(q);\n    }\n}\n\n/// Is a hazard something that should glow where the guide points?\npub fn touch3(h: &Hazard, plate: &PlateView) -> Vec3 {\n    let p = h.touch_point();\n    let extra = match h.kind {\n        K::Laceration | K::Incision | K::Closure => 0.05,\n        _ => 0.3,\n    };\n    on(p, plate.height_at(p) + extra)\n}\nEOF\ncat > crates/pav_view/src/surgery/paper.rs <<'EOF'\n//! The paper theatre: layered, extruded spline cards from the rig and set files, lit, shadowed and\n//! outlined by the engine.\n\nuse std::collections::HashMap;\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::content::{self, RigDef, SetDef};\nuse pav_core::games::surgery::frame::{ActorView, StoryView};\nuse pav_core::games::surgery::paper;\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{DynamicMesh, ParticleBurst, PointLight, Scene, Style, flags, srgb};\n\nconst LAYER: f32 = 0.035;\n\nstruct Card {\n    role: String,\n    name: String,\n    pts: Vec<Vec2>,\n    tris: Vec<[u32; 3]>,\n    z: f32,\n    depth: f32,\n    color: Vec3,\n    spring: f32,\n    sign: f32,\n    head: bool,\n    emissive: f32,\n    monitor: bool,\n}\n\nstruct RigMesh {\n    cards: Vec<Card>,\n}\n\nstruct SetMesh {\n    cards: Vec<Card>,\n}\n\nfn rgb(c: [u8; 3]) -> Vec3 {\n    srgb(c[0], c[1], c[2])\n}\n\nfn card_of(pts: Vec<Vec2>, role: &str, name: &str, z: f32, depth: f32, color: Vec3, spring: f32, sign: f32) -> Card {\n    let tris = paper::triangulate(&pts);\n    let is_head = !matches!(role, \"body\") && (z >= 2.9 || name.contains(\"hair\") || name.contains(\"chignon\"));\n    Card {\n        role: role.to_string(),\n        name: name.to_string(),\n        pts,\n        tris,\n        z,\n        depth,\n        color,\n        spring,\n        sign,\n        head: is_head,\n        emissive: 0.0,\n        monitor: false,\n    }\n}\n\nfn build_rig(r: &RigDef) -> RigMesh {\n    let mut cards = Vec::new();\n    for p in &r.part {\n        let outline = p.outline();\n        let color = r.palette.get(&p.color).map(|c| rgb(*c)).unwrap_or(Vec3::ONE);\n        if p.mirror {\n            cards.push(card_of(outline.clone(), &p.role, &p.name, p.z, p.depth, color, p.spring, 1.0));\n            let flipped: Vec<Vec2> = outline.iter().rev().map(|q| Vec2::new(-q.x, q.y)).collect();\n            cards.push(card_of(flipped, &p.role, &p.name, p.z, p.depth, color, p.spring, -1.0));\n        } else {\n            cards.push(card_of(outline, &p.role, &p.name, p.z, p.depth, color, p.spring, 1.0));\n        }\n    }\n    RigMesh { cards }\n}\n\nfn build_set(s: &SetDef) -> SetMesh {\n    let mut cards = Vec::new();\n    for l in &s.layer {\n        let n = l.repeat[0].max(1.0) as i32;\n        for k in 0..n {\n            let dx = l.repeat[1] * (k as f32 - (n - 1) as f32 * 0.5);\n            let pts: Vec<Vec2> = l.points.iter().map(|p| Vec2::new(p[0] + dx, p[1])).collect();\n            let pts = paper::chaikin(&pts, l.chaikin);\n            let mut c = card_of(pts, \"\", \"layer\", l.z, 0.08, rgb(l.color), 0.0, 1.0);\n            c.emissive = l.emissive;\n            c.monitor = l.monitor;\n            cards.push(c);\n        }\n    }\n    SetMesh { cards }\n}\n\n/// Emits a card: front face plus edge quads back to `z - depth`, so it casts shadows and takes\n/// outlines.\nfn push_card(\n    scene: &mut Scene,\n    pts: &[Vec2],\n    tris: &[[u32; 3]],\n    m: Mat4,\n    z: f32,\n    depth: f32,\n    color: Vec3,\n    emissive: f32,\n    group: u32,\n    style: Style,\n    flag: u32,\n) {\n    if pts.len() < 3 || tris.is_empty() {\n        return;\n    }\n    let normal = m.transform_vector3(Vec3::Z).normalize_or(Vec3::Z);\n    let mut data = MeshData { vertices: Vec::with_capacity(pts.len() * 5), indices: Vec::with_capacity(tris.len() * 3 + pts.len() * 6) };\n    for p in pts {\n        let v = m.transform_point3(Vec3::new(p.x, p.y, z));\n        data.vertices.push(Vertex { pos: v.to_array(), normal: normal.to_array(), uv: [0.0, 0.0], color: [1.0; 4] });\n    }\n    for t in tris {\n        data.indices.extend_from_slice(t);\n    }\n    // Edges. Outward: for a counter-clockwise outline, right of the walking direction.\n    let ccw = paper::signed_area(pts) >= 0.0;\n    for i in 0..pts.len() {\n        let (a, b) = (pts[i], pts[(i + 1) % pts.len()]);\n        let d = b - a;\n        if d.length_squared() < 1e-9 {\n            continue;\n        }\n        let out = if ccw { Vec3::new(d.y, -d.x, 0.0) } else { Vec3::new(-d.y, d.x, 0.0) }.normalize();\n        let nrm = m.transform_vector3(out).normalize_or(Vec3::X).to_array();\n        let base = data.vertices.len() as u32;\n        for (p, zz) in [(a, z), (b, z), (b, z - depth), (a, z - depth)] {\n            let v = m.transform_point3(Vec3::new(p.x, p.y, zz));\n            data.vertices.push(Vertex { pos: v.to_array(), normal: nrm, uv: [0.0, 0.0], color: [1.0; 4] });\n        }\n        if ccw {\n            data.indices.extend_from_slice(&[base, base + 3, base + 2, base, base + 2, base + 1]);\n        } else {\n            data.indices.extend_from_slice(&[base, base + 1, base + 2, base, base + 2, base + 3]);\n        }\n    }\n    scene.dynamic.push(DynamicMesh { data, color, emissive, style, flags: flag, group, material: 0 });\n}\n\nfn ease_out_back(t: f32) -> f32 {\n    let c1 = 1.70158;\n    let c3 = c1 + 1.0;\n    let x = t - 1.0;\n    1.0 + c3 * x * x * x + c1 * x * x\n}\n\n#[derive(Default)]\npub struct PaperView {\n    rigs: HashMap<String, RigMesh>,\n    sets: HashMap<String, SetMesh>,\n}\n\nimpl PaperView {\n    fn ensure(&mut self, story: &StoryView) {\n        let content = content::get();\n        for a in &story.actors {\n            if !self.rigs.contains_key(&*a.who) {\n                if let Some(r) = content.rigs.get(&*a.who) {\n                    self.rigs.insert(a.who.to_string(), build_rig(r));\n                }\n            }\n        }\n        if !self.sets.contains_key(&*story.set) {\n            if let Some(s) = content.sets.get(&*story.set) {\n                self.sets.insert(story.set.to_string(), build_set(s));\n            }\n        }\n    }\n\n    /// Forget meshes after a content reload.\n    pub fn clear(&mut self) {\n        self.rigs.clear();\n        self.sets.clear();\n    }\n\n    pub fn emit(&mut self, scene: &mut Scene, story: &StoryView, time: f32, dt: f32, beat: f32) {\n        self.ensure(story);\n        let content = content::get();\n        let set = content.sets.get(&*story.set);\n        // The stage, per set.\n        scene.ambient.sky = set.map(|s| Vec3::from(s.ambient_sky)).unwrap_or(Vec3::new(0.74, 0.74, 0.78));\n        scene.ambient.ground = set.map(|s| Vec3::from(s.ambient_ground)).unwrap_or(Vec3::new(0.6, 0.56, 0.56));\n        scene.sun.direction = Vec3::new(0.3, -0.45, -0.85).normalize();\n        scene.sun.color = Vec3::new(1.0, 0.97, 0.92) * 0.34;\n        scene.sun.shadows = true;\n        scene.sun.shadow_center = Vec3::new(0.0, 0.0, -2.0);\n        scene.sun.shadow_radius = 14.0;\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.05;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.32;\n        scene.post.outline_px = 1.4;\n        scene.post.gi = 0.4;\n        scene.post.bloom = 0.4;\n        scene.post.bloom_threshold = 1.1;\n        scene.filter.vignette = 0.32;\n        scene.clear_color = set.map(|s| rgb(s.sky)).unwrap_or(Vec3::ZERO);\n        if let Some(s) = set {\n            for l in &s.lamp {\n                scene.point_lights.push(PointLight {\n                    position: Vec3::new(l[0], l[1], l[2]),\n                    color: Vec3::new(l[3], l[4], l[5]) * 0.7,\n                    radius: l[6],\n                    shadows: false,\n                });\n            }\n            if s.rain {\n                let n = (dt * 90.0).ceil() as u32;\n                scene.particles.push(ParticleBurst {\n                    count: n,\n                    pos: Vec3::new(0.0, 7.0, -5.8),\n                    area: Vec3::new(16.0, 0.2, 0.5),\n                    vel: Vec3::new(-2.0, -16.0, 0.0),\n                    spread: 0.4,\n                    life: (0.7, 1.0),\n                    size: (0.016, 0.012),\n                    color0: glam::Vec4::new(0.5, 0.68, 0.95, 0.4),\n                    color1: glam::Vec4::new(0.5, 0.68, 0.95, 0.0),\n                    additive: true,\n                    stretch: true,\n                    ..Default::default()\n                });\n            }\n        }\n        // The set's cards.\n        if let Some(mesh) = self.sets.get(&*story.set) {\n            for (i, c) in mesh.cards.iter().enumerate() {\n                let style = if c.emissive > 0.5 { Style::Unlit } else { Style::Cel };\n                push_card(scene, &c.pts, &c.tris, Mat4::IDENTITY, c.z, c.depth, c.color, c.emissive, 2000 + i as u32, style, 0);\n                if c.monitor {\n                    monitor_trace(scene, c, beat, time);\n                }\n            }\n        }\n        // The cast.\n        let n = story.actors.len();\n        for (idx, a) in story.actors.iter().enumerate() {\n            if let Some(rig) = self.rigs.get(&*a.who) {\n                let r = content.rigs.get(&*a.who);\n                emit_actor(scene, rig, r, a, time, dt, idx, n, story);\n            }\n        }\n    }\n}\n\nfn monitor_trace(scene: &mut Scene, c: &Card, beat: f32, time: f32) {\n    let (mut x0, mut x1, mut y0, mut y1) = (f32::MAX, f32::MIN, f32::MAX, f32::MIN);\n    for p in &c.pts {\n        x0 = x0.min(p.x);\n        x1 = x1.max(p.x);\n        y0 = y0.min(p.y);\n        y1 = y1.max(p.y);\n    }\n    let segs = 32;\n    let wave = |t: f32| -> f32 {\n        let ph = (t * 3.0 - time * 1.2 + beat * 0.0).rem_euclid(1.0);\n        let g = |c: f32, w: f32| (-(ph - c) * (ph - c) / w).exp();\n        g(0.1, 0.0012) * 1.0 - g(0.14, 0.0006) * 0.3 + g(0.3, 0.004) * 0.25\n    };\n    let mid = (y0 + y1) * 0.5;\n    let amp = (y1 - y0) * 0.38;\n    let mut data = MeshData::default();\n    for i in 0..=segs {\n        let t = i as f32 / segs as f32;\n        let x = x0 + (x1 - x0) * t;\n        let y = mid + wave(t) * amp - amp * 0.2;\n        for dy in [-0.03f32, 0.03] {\n            data.vertices.push(Vertex { pos: [x, y + dy, c.z + 0.05], normal: [0.0, 0.0, 1.0], uv: [0.0, 0.0], color: [1.0; 4] });\n        }\n        if i < segs {\n            let b = (i * 2) as u32;\n            data.indices.extend_from_slice(&[b, b + 2, b + 1, b + 1, b + 2, b + 3]);\n        }\n    }\n    scene.dynamic.push(DynamicMesh {\n        data,\n        color: Vec3::new(0.3, 1.0, 0.6),\n        emissive: 1.3,\n        style: Style::Unlit,\n        flags: flags::NO_SHADOW,\n        group: 0,\n        material: 0,\n    });\n}\n\nfn emit_actor(scene: &mut Scene, rig: &RigMesh, def: Option<&RigDef>, a: &ActorView, time: f32, _dt: f32, idx: usize, _n: usize, story: &StoryView) {\n    let seed = a.who.bytes().fold(7u32, |h, b| h.wrapping_mul(31).wrapping_add(b as u32)) as f32 * 0.001;\n    // Slide in with overshoot; slide out; shake on shock.\n    let side = if a.x < 0.0 { -1.0 } else { 1.0 };\n    let k = if a.leaving { 1.0 - (a.t / 0.45).clamp(0.0, 1.0) } else { ease_out_back((a.t / 0.5).clamp(0.0, 1.0)) };\n    let mut x = a.x + side * (1.0 - k) * 9.0;\n    x += (story.shake * 30.0 + seed).sin() * 0.05 * story.shake;\n    let talking = a.talking;\n    let t = time + seed * 17.0;\n    let breathe = (t * 1.5).sin() * 0.012;\n    let sway = (t * 0.6).sin() * 2f32.to_radians();\n    let yaw = -side * 0.22 + sway;\n    let expr = def.and_then(|d| d.expr.get(&*a.expr).or_else(|| d.expr.get(\"neutral\")));\n    let is_speaker = a.who == story.who;\n    // Who isn't speaking steps back a little.\n    let (scale, z_off) = if is_speaker { (1.0, 0.0) } else { (0.97, -0.25) };\n    let root = Mat4::from_translation(Vec3::new(x, -0.7, z_off))\n        * Mat4::from_rotation_y(yaw)\n        * Mat4::from_scale(Vec3::splat(scale));\n    let body = root * Mat4::from_translation(Vec3::new(0.0, breathe, 0.0));\n    // Head: tilt, a nod on stressed words, a little look-around.\n    let nod = if talking { ((t * 7.5).sin() * 0.5 + 0.5).powi(3) * 0.03 } else { 0.0 };\n    let (tilt, drop) = expr.map(|e| (e.tilt, e.drop)).unwrap_or((0.0, 0.0));\n    let head = body\n        * Mat4::from_translation(Vec3::new(0.0, -0.3 - nod - drop, 0.0))\n        * Mat4::from_rotation_z((tilt + (t * 0.8).sin() * 0.8).to_radians())\n        * Mat4::from_translation(Vec3::new(0.0, 0.3, 0.0));\n    // Blink every few seconds.\n    let blink_t = (t * 0.27).fract();\n    let blink = if blink_t < 0.035 { 1.0 - (blink_t / 0.035 - 0.5).abs() * 2.0 } else { 0.0 };\n    let lid_e = expr.map(|e| e.lid).unwrap_or(0.0);\n    let closed = (blink + lid_e.max(0.0) * 0.35).clamp(0.0, 1.0);\n    let wide = (-lid_e).max(0.0);\n    let (bi, bo) = expr.map(|e| (e.brow_inner, e.brow_outer)).unwrap_or((0.0, 0.0));\n    let iris_k = expr.map(|e| if e.iris > 0.0 { e.iris } else { 1.0 }).unwrap_or(1.0);\n    let look = Vec2::new(-side * 0.012 + (t * 0.4).sin() * 0.006, 0.0);\n    let base = 100 + idx as u32 * 60;\n    for (i, c) in rig.cards.iter().enumerate() {\n        let m = if c.head { head } else { body };\n        let z = c.z * LAYER;\n        let mut pts = c.pts.clone();\n        let sign = c.sign;\n        match c.role.as_str() {\n            \"brow\" => {\n                for p in &mut pts {\n                    let along = ((p.x.abs() - 0.13) / 0.42).clamp(0.0, 1.0);\n                    p.y += bi + (bo - bi) * along;\n                }\n            }\n            \"lid\" => {\n                for p in &mut pts {\n                    p.y -= closed * 0.14;\n                    p.y += wide * 0.02;\n                }\n            }\n            \"eye\" => {\n                for p in &mut pts {\n                    p.y = 0.34 + (p.y - 0.34) * (1.0 - closed * 0.9 + wide * 0.25);\n                }\n            }\n            \"iris\" | \"pupil\" => {\n                let center = Vec2::new(0.34 * sign, 0.34);\n                for p in &mut pts {\n                    *p = center + (*p - center) * iris_k + look;\n                    p.y = 0.34 + (p.y - 0.34) * (1.0 - closed * 0.9);\n                }\n            }\n            \"hair\" => {\n                if c.spring > 0.0 {\n                    let wind = (t * 1.7).sin() * 0.018 * c.spring;\n                    for p in &mut pts {\n                        p.x += wind * (1.8 - p.y).max(0.0);\n                    }\n                }\n            }\n            _ => {\n                if c.spring > 0.0 {\n                    let wind = (t * 1.3).sin() * 0.014 * c.spring;\n                    for p in &mut pts {\n                        p.x += wind * (1.2 - p.y).max(0.0);\n                    }\n                }\n            }\n        }\n        let tris = &c.tris;\n        let style = if c.name == \"glint\" { Style::Unlit } else { Style::Cel };\n        let group = match c.name.as_str() {\n            \"cheek\" => base,\n            \"face\" => base,\n            _ => base + 1 + i as u32,\n        };\n        push_card(scene, &pts, tris, m, z, c.depth, c.color, 0.0, group, style, 0);\n    }\n    // The mouth: a frame for talk, a frame for rest.\n    if let Some(e) = expr {\n        let open = talking && (t * 11.0).sin() > -0.1;\n        let shape = if open && !e.open.is_empty() { &e.open } else { &e.closed };\n        if shape.len() >= 3 {\n            let pts: Vec<Vec2> = shape.iter().map(|p| Vec2::new(p[0], p[1])).collect();\n            let pts = paper::chaikin(&pts, 1);\n            let tris = paper::triangulate(&pts);\n            push_card(scene, &pts, &tris, head, 3.7 * LAYER, 0.01, srgb(92, 30, 40), 0.0, base + 59, Style::Cel, 0);\n        }\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/fx.rs <<'EOF'\n//! Effects: cue bursts and the continuous particles and distortions of the field.\n\nuse glam::{Vec2, Vec3, Vec4};\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::{HazardKind as K, Tool};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_render::scene::{DistortKind, Distortion, ParticleBurst, PointLight, Scene};\n\nuse super::plate::PlateView;\n\n/// A cue's burst of particles: stylised, like a medical illustration.\npub fn cue_bursts(id: u16, pos: Vec3, out: &mut Vec<ParticleBurst>) {\n    let at = pos + Vec3::Y * 0.5;\n    let blood = |n: u32, speed: f32| ParticleBurst {\n        count: n,\n        pos: at,\n        area: Vec3::splat(0.08),\n        vel: Vec3::new(0.0, speed, 0.0),\n        spread: speed * 0.7,\n        gravity: 11.0,\n        life: (0.35, 0.6),\n        size: (0.07, 0.03),\n        color0: Vec4::new(0.42, 0.015, 0.05, 1.0),\n        color1: Vec4::new(0.24, 0.01, 0.03, 1.0),\n        additive: false,\n        ..Default::default()\n    };\n    match id {\n        cue::SLICE | cue::TEAR => out.push(blood(14, 2.4)),\n        cue::POP | cue::SPURT => out.push(blood(22, 3.0)),\n        cue::BURST => {\n            out.push(ParticleBurst {\n                count: 42,\n                pos: at,\n                area: Vec3::splat(0.15),\n                vel: Vec3::Y * 3.0,\n                spread: 4.0,\n                gravity: 10.0,\n                life: (0.4, 0.8),\n                size: (0.1, 0.03),\n                color0: Vec4::new(0.45, 1.0, 0.55, 1.0),\n                color1: Vec4::new(0.2, 0.5, 0.2, 0.0),\n                additive: false,\n                ..Default::default()\n            });\n        }\n        cue::SIZZLE => {\n            out.push(ParticleBurst {\n                count: 18,\n                pos: at,\n                vel: Vec3::Y * 2.5,\n                spread: 3.4,\n                gravity: 7.0,\n                life: (0.2, 0.45),\n                size: (0.04, 0.0),\n                color0: Vec4::new(3.0, 1.4, 0.4, 1.0),\n                color1: Vec4::new(1.2, 0.2, 0.0, 0.0),\n                stretch: true,\n                ..Default::default()\n            });\n            out.push(smoke(at, 10));\n        }\n        cue::SCORCH => out.push(smoke(at, 18)),\n        cue::FROST => {\n            out.push(ParticleBurst {\n                count: 22,\n                pos: at,\n                area: Vec3::splat(0.2),\n                vel: Vec3::Y * 0.6,\n                spread: 1.2,\n                gravity: -0.2,\n                life: (0.4, 0.9),\n                size: (0.06, 0.0),\n                color0: Vec4::new(0.8, 1.0, 1.2, 0.9),\n                color1: Vec4::new(0.5, 0.8, 1.0, 0.0),\n                ..Default::default()\n            });\n        }\n        cue::GEL => {\n            out.push(ParticleBurst {\n                count: 6,\n                pos: at,\n                vel: Vec3::Y * 1.0,\n                spread: 1.0,\n                gravity: 9.0,\n                life: (0.25, 0.45),\n                size: (0.06, 0.04),\n                color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                color1: Vec4::new(0.55, 0.95, 0.8, 0.0),\n                additive: false,\n                ..Default::default()\n            });\n        }\n        cue::IMMACULATE => {\n            out.push(ParticleBurst {\n                count: 20,\n                pos: at,\n                vel: Vec3::Y * 2.0,\n                spread: 2.6,\n                gravity: 3.0,\n                life: (0.3, 0.6),\n                size: (0.05, 0.0),\n                color0: Vec4::new(2.0, 1.8, 1.0, 1.0),\n                color1: Vec4::new(1.0, 0.8, 0.3, 0.0),\n                ..Default::default()\n            });\n        }\n        cue::DEFIB_THUMP => {\n            out.push(ParticleBurst {\n                count: 60,\n                pos: Vec3::new(0.0, 1.0, 0.0),\n                area: Vec3::new(3.0, 0.2, 2.0),\n                vel: Vec3::Y * 1.5,\n                spread: 5.0,\n                gravity: 3.0,\n                life: (0.2, 0.5),\n                size: (0.04, 0.0),\n                color0: Vec4::new(1.0, 1.6, 2.4, 1.0),\n                color1: Vec4::new(0.4, 0.8, 1.6, 0.0),\n                stretch: true,\n                ..Default::default()\n            });\n        }\n        cue::PING | cue::RIPPLE | cue::GIFT_FIRE => {}\n        _ => {}\n    }\n}\n\nfn smoke(at: Vec3, n: u32) -> ParticleBurst {\n    ParticleBurst {\n        count: n,\n        pos: at,\n        area: Vec3::splat(0.1),\n        vel: Vec3::Y * 1.0,\n        spread: 0.5,\n        drag: 0.8,\n        life: (0.6, 1.2),\n        size: (0.1, 0.4),\n        color0: Vec4::new(0.5, 0.48, 0.46, 0.5),\n        color1: Vec4::new(0.3, 0.3, 0.3, 0.0),\n        additive: false,\n        turbulence: 1.0,\n        ..Default::default()\n    }\n}\n\n/// What burns and bleeds all the time, this frame.\npub fn continuous(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, time: f32, dt: f32, last_beats: &mut u32, carry: &mut f32) {\n    let beat = f.beats != *last_beats;\n    *last_beats = f.beats;\n    *carry += dt;\n    let tick = *carry > 0.05;\n    if tick {\n        *carry = 0.0;\n    }\n    let on_tissue = |p: Vec2, up: f32| Vec3::new(p.x, plate.height_at(p) + up, p.y);\n    for h in &f.hazards {\n        match h.kind {\n            K::Bleeder if beat && !f.flat => {\n                scene.particles.push(ParticleBurst {\n                    count: 26,\n                    pos: on_tissue(h.pos, 0.08),\n                    vel: Vec3::new(h.axis.cos() * 0.9, 3.6, h.axis.sin() * 0.9),\n                    spread: 1.0,\n                    gravity: 12.0,\n                    life: (0.35, 0.6),\n                    size: (0.075, 0.03),\n                    color0: Vec4::new(0.5, 0.02, 0.05, 1.0),\n                    color1: Vec4::new(0.3, 0.01, 0.03, 1.0),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            K::Ember if tick && h.stage == 0 => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: on_tissue(h.pos, 0.4),\n                    area: Vec3::splat(h.r * 0.5),\n                    vel: Vec3::Y * 1.1,\n                    spread: 0.5,\n                    gravity: -0.5,\n                    life: (0.5, 1.1),\n                    size: (0.035, 0.0),\n                    color0: Vec4::new(3.0, 1.4, 0.3, 1.0),\n                    color1: Vec4::new(1.4, 0.2, 0.0, 0.0),\n                    turbulence: 1.5,\n                    ..Default::default()\n                });\n                scene.distortions.push(Distortion {\n                    pos: on_tissue(h.pos, 0.7),\n                    radius: 1.3,\n                    strength: 0.06,\n                    kind: DistortKind::Haze,\n                    progress: (time * 0.3).fract(),\n                });\n            }\n            K::Furnace => {\n                scene.distortions.push(Distortion {\n                    pos: on_tissue(h.pos, 1.0),\n                    radius: 3.0,\n                    strength: 0.08,\n                    kind: DistortKind::Haze,\n                    progress: (time * 0.3).fract(),\n                });\n                if tick {\n                    scene.particles.push(ParticleBurst {\n                        count: 3,\n                        pos: on_tissue(h.pos, 0.5),\n                        area: Vec3::splat(h.r * 0.6),\n                        vel: Vec3::Y * 1.8,\n                        spread: 0.8,\n                        gravity: -0.5,\n                        life: (0.5, 1.2),\n                        size: (0.05, 0.0),\n                        color0: Vec4::new(3.0, 1.2, 0.3, 1.0),\n                        color1: Vec4::new(1.2, 0.1, 0.0, 0.0),\n                        turbulence: 1.5,\n                        ..Default::default()\n                    });\n                }\n            }\n            _ => {}\n        }\n    }\n    if let Some(r) = f.heat_ring {\n        scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.2), radius: r.max(0.5), strength: 0.14, kind: DistortKind::Ring, progress: 0.5 });\n        scene.point_lights.push(PointLight { position: Vec3::new(0.0, 2.0, 0.2), color: Vec3::new(1.0, 0.4, 0.1) * 0.6, radius: r + 3.0, shadows: false });\n    }\n    // Tools at work.\n    for s in &f.surgeons {\n        if !s.present || !s.using {\n            continue;\n        }\n        let at = on_tissue(s.cursor, 0.1);\n        match s.tool {\n            Tool::Laser if s.engaged != 0 && tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 3,\n                    pos: at,\n                    vel: Vec3::Y * 1.0,\n                    spread: 0.5,\n                    drag: 0.8,\n                    life: (0.4, 0.8),\n                    size: (0.06, 0.22),\n                    color0: Vec4::new(0.5, 0.48, 0.46, 0.4),\n                    color1: Vec4::new(0.3, 0.3, 0.3, 0.0),\n                    additive: false,\n                    turbulence: 1.0,\n                    ..Default::default()\n                });\n                scene.point_lights.push(PointLight { position: at + Vec3::Y * 0.5, color: Vec3::new(1.0, 0.4, 0.2) * 0.9, radius: 2.5, shadows: false });\n            }\n            Tool::Cryo if s.engaged != 0 && tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 4,\n                    pos: at,\n                    area: Vec3::splat(0.2),\n                    vel: Vec3::Y * 0.5,\n                    spread: 0.7,\n                    life: (0.3, 0.6),\n                    size: (0.05, 0.0),\n                    color0: Vec4::new(0.8, 1.0, 1.2, 0.9),\n                    color1: Vec4::new(0.5, 0.8, 1.0, 0.0),\n                    ..Default::default()\n                });\n            }\n            Tool::Gel if tick && s.flow > 0.02 => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: at + Vec3::Y * 0.4,\n                    vel: Vec3::ZERO,\n                    spread: 0.4,\n                    gravity: 8.0,\n                    life: (0.2, 0.3),\n                    size: (0.06, 0.04),\n                    color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                    color1: Vec4::new(0.55, 0.95, 0.8, 0.5),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            Tool::Suction if tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: at,\n                    area: Vec3::new(0.35, 0.02, 0.35),\n                    vel: Vec3::Y * 0.3,\n                    spread: 0.2,\n                    life: (0.15, 0.3),\n                    size: (0.04, 0.0),\n                    color0: Vec4::new(0.5, 0.03, 0.06, 1.0),\n                    color1: Vec4::new(0.3, 0.02, 0.03, 0.0),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            _ => {}\n        }\n    }\n    // The gifts.\n    if f.hush > 0.2 && tick {\n        scene.particles.push(ParticleBurst {\n            count: 4,\n            pos: Vec3::new(0.0, 2.0, 0.0),\n            area: Vec3::new(10.0, 1.5, 6.0),\n            vel: Vec3::ZERO,\n            spread: 0.08,\n            life: (1.2, 2.2),\n            size: (0.03, 0.0),\n            color0: Vec4::new(0.9, 0.92, 1.0, 0.9) * f.hush,\n            color1: Vec4::new(0.6, 0.7, 1.0, 0.0),\n            turbulence: 0.2,\n            ..Default::default()\n        });\n    }\n    if f.echo > 0.2 && tick {\n        for g in &f.ghosts {\n            let k = (g.t / pav_core::games::surgery::field::GHOST_TRAVEL).clamp(0.0, 1.0);\n            let to = f.hazards.iter().find(|h| h.id == g.target).map(|h| h.touch_point()).unwrap_or(g.from);\n            let at = g.from.lerp(to, k);\n            scene.particles.push(ParticleBurst {\n                count: 4,\n                pos: on_tissue(at, 0.8),\n                vel: Vec3::ZERO,\n                spread: 0.3,\n                life: (0.2, 0.45),\n                size: (0.09, 0.0),\n                color0: Vec4::new(0.7, 0.95, 1.4, 0.9),\n                color1: Vec4::new(0.4, 0.7, 1.2, 0.0),\n                ..Default::default()\n            });\n        }\n    }\n    // Title: rain on the glass.\n    if f.stage == Stage::Title && tick {\n        scene.particles.push(ParticleBurst {\n            count: 5,\n            pos: Vec3::new(0.0, 12.0, 0.0),\n            area: Vec3::new(14.0, 0.2, 7.0),\n            vel: Vec3::new(-0.8, -7.0, 1.0),\n            spread: 0.2,\n            life: (0.9, 1.3),\n            size: (0.012, 0.009),\n            color0: Vec4::new(0.55, 0.7, 0.95, 0.45),\n            color1: Vec4::new(0.55, 0.7, 0.95, 0.0),\n            stretch: true,\n            ..Default::default()\n        });\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/mod.rs <<'EOF'\n//! Draws the surgery game from `SurgeryFrame`: the field, the instruments, the tray, the parasites,\n//! the paper theatre. Everything here is called at the end of `ViewBuilder::build`, so the game's\n//! lighting and post settings win over `ViewSettings`.\n\npub mod fx;\npub mod instruments;\npub mod paper;\npub mod plate;\npub mod strains;\n\nuse glam::{Quat, Vec2, Vec3};\nuse pav_core::frame::SimEvent;\nuse pav_core::games::surgery::field::{GHOST_TRAVEL, Tool};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::surgeon::tray_x;\nuse pav_render::scene::{DistortKind, Distortion, DynamicMesh, MeshInstance, MeshKey, Part, PointLight, Scene, Style, Transition, flags, srgb};\n\nuse crate::camera::CameraRig;\n\n/// Seat colours, in linear light.\npub fn seat_color(slot: usize) -> Vec3 {\n    let c: [(u8, u8, u8); 4] = [(232, 68, 58), (59, 130, 246), (34, 197, 94), (245, 183, 0)];\n    let (r, g, b) = c[slot.min(3)];\n    srgb(r, g, b)\n}\n\n/// What the player's settings and the app's local state say about drawing.\n#[derive(Clone, Copy, Debug)]\npub struct Local {\n    /// This device's cursor right now, per slot, ahead of the tick.\n    pub aim: [Option<Vec2>; 4],\n    pub clinical: bool,\n    pub shake: bool,\n    pub reduce_flashes: bool,\n    /// A full-screen fade: 0 clear .. 1 covered.\n    pub fade: f32,\n    /// The tray place under the pointer.\n    pub hover_tray: Option<usize>,\n    /// Drawing paused (hub server, or not at all).\n    pub skip: bool,\n}\n\nimpl Default for Local {\n    fn default() -> Self {\n        Self { aim: [None; 4], clinical: false, shake: true, reduce_flashes: false, fade: 0.0, hover_tray: None, skip: false }\n    }\n}\n\n#[derive(Default)]\npub struct SurgeryView {\n    pub plate: plate::PlateView,\n    pub paper: paper::PaperView,\n    pub local: Local,\n    pending: Vec<pav_render::scene::ParticleBurst>,\n    ripples: Vec<(Vec3, f32, DistortKind, f32)>,\n    last_beats: u32,\n    carry: f32,\n    last_time: f32,\n    /// Seconds the current flash has left (defib, for the white-out).\n    flash: f32,\n}\n\nimpl SurgeryView {\n    /// Cues become particles and distortions.\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        use pav_core::games::surgery::cue;\n        for e in events {\n            if let SimEvent::Cue { id, pos, .. } = e {\n                fx::cue_bursts(*id, *pos, &mut self.pending);\n                match *id {\n                    cue::GIFT_FIRE => self.ripples.push((*pos + Vec3::Y, 7.0, DistortKind::Ripple, 0.0)),\n                    cue::DEFIB_THUMP => {\n                        self.ripples.push((Vec3::new(0.0, 0.5, 0.0), 11.0, DistortKind::Ring, 0.0));\n                        self.flash = 1.0;\n                    }\n                    cue::PING => self.ripples.push((*pos + Vec3::Y * 0.2, 3.2, DistortKind::Ripple, 0.0)),\n                    cue::BURST => self.ripples.push((*pos + Vec3::Y * 0.4, 2.0, DistortKind::Ring, 0.0)),\n                    _ => {}\n                }\n            }\n        }\n    }\n\n    /// Adds this frame's game to the scene.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, rig: &CameraRig, aspect: f32, wall: f32) {\n        let time = f.clock;\n        let dt = (wall - self.last_time).clamp(0.0, 0.1);\n        self.last_time = wall;\n        scene.particles.append(&mut self.pending);\n        self.flash = (self.flash - dt * 2.5).max(0.0);\n        for r in &mut self.ripples {\n            r.3 += dt / 0.7;\n        }\n        self.ripples.retain(|r| r.3 < 1.0);\n        for r in &self.ripples {\n            scene.distortions.push(Distortion { pos: r.0, radius: r.1, strength: 0.25, kind: r.2, progress: r.3 });\n        }\n\n        if let (Stage::Story, Some(story)) = (f.stage, &f.story) {\n            if story.camera_or {\n                self.or_wide(scene);\n            } else {\n                // A little camera drift: real parallax between the layers.\n                let mut r = rig.clone();\n                r.params.yaw = (wall * 0.27).sin() * 0.7;\n                r.params.tilt = (wall * 0.19).sin() * 0.25;\n                scene.camera = r.data(aspect);\n                self.paper.emit(scene, story, wall, dt, f.beat);\n                if story.shake > 0.0 && self.local.shake {\n                    let mut r2 = r.clone();\n                    r2.target += Vec3::new((wall * 41.0).sin(), (wall * 37.0).cos(), 0.0) * story.shake * 0.12;\n                    scene.camera = r2.data(aspect);\n                }\n            }\n            self.finish(scene, f);\n            return;\n        }\n\n        // The field.\n        let sun = Vec3::new(-0.25, -1.0, -0.35).normalize();\n        scene.sun.direction = sun;\n        scene.sun.color = Vec3::new(1.0, 0.97, 0.9) * 0.42;\n        scene.sun.shadows = true;\n        scene.sun.shadow_center = Vec3::ZERO;\n        scene.sun.shadow_radius = 16.0;\n        scene.ambient.sky = Vec3::new(0.5, 0.5, 0.54);\n        scene.ambient.ground = Vec3::new(0.3, 0.22, 0.22);\n        scene.point_lights.push(PointLight { position: Vec3::new(-1.0, 7.0, -1.0), color: Vec3::new(1.0, 0.97, 0.9) * 0.9, radius: 16.0, shadows: true });\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.12;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.45;\n        scene.post.outline_px = 1.0;\n        scene.post.bloom = 0.35;\n        scene.post.bloom_threshold = 1.15;\n        scene.post.gi = 0.6;\n        scene.filter.vignette = 0.35;\n        scene.clear_color = srgb(16, 40, 44);\n\n        // Shake and punch.\n        if f.shake > 0.0 && self.local.shake {\n            let mut r = rig.clone();\n            let k = f.shake * f.shake * 0.28;\n            r.target += Vec3::new((wall * 47.0).sin(), 0.0, (wall * 39.0).cos()) * k;\n            scene.camera = r.data(aspect);\n        }\n\n        let opts = plate::PlateOpts { clinical: self.local.clinical };\n        if let Some(data) = self.plate.build(f, time, opts) {\n            scene.dynamic.push(DynamicMesh { data, color: Vec3::ONE, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 });\n        }\n        retractors(scene);\n        if !f.hazards.is_empty() || !f.stains.is_empty() {\n            strains::emit(scene, f, &self.plate, time);\n        }\n        let in_op = matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete | Stage::Results | Stage::Chart | Stage::Dead);\n        if in_op {\n            self.tray(scene, f, wall);\n        }\n        if matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete) {\n            self.hands(scene, f, wall);\n        }\n        fx::continuous(scene, f, &self.plate, time, dt, &mut self.last_beats, &mut self.carry);\n\n        // Gift and crisis looks.\n        let hush = f.hush.clamp(0.0, 1.0);\n        if hush > 0.0 {\n            scene.filter.grade_part = Part::Objects;\n            scene.filter.saturation = 1.0 - hush * 0.9;\n            scene.filter.vignette = 0.35 + hush * 0.35;\n            scene.point_lights.push(PointLight { position: Vec3::new(0.0, 5.0, 0.0), color: Vec3::new(0.7, 0.75, 1.0) * hush * 0.5, radius: 14.0, shadows: false });\n        }\n        if matches!(f.stage, Stage::Op | Stage::Code) {\n            let crisis = (1.0 - f.vitals / 30.0).clamp(0.0, 1.0);\n            if crisis > 0.0 {\n                let beat = if self.local.reduce_flashes { 0.5 } else { plate::beat_env(f.beat).min(1.0) };\n                scene.filter.chroma += crisis * (0.0015 + beat * 0.002);\n                scene.filter.vignette += crisis * 0.2 * (0.6 + 0.4 * beat);\n            }\n        }\n        if f.stage == Stage::Code {\n            scene.filter.saturation *= 0.45;\n        }\n        if f.plate_blend < 1.0 && !self.local.reduce_flashes {\n            // The iris closes on the incision, and opens on the next layer down.\n            let k = (f.plate_blend * std::f32::consts::PI).sin();\n            scene.filter.transition = k * 0.5;\n            scene.filter.transition_kind = Transition::Iris;\n            scene.filter.transition_center = crate::build::screen_uv(&scene.camera, Vec3::new(f.plate_from.x, 0.4, f.plate_from.y));\n        }\n        self.finish(scene, f);\n    }\n\n    /// The 3D wide shot: the engine draws the level; this only lights it.\n    fn or_wide(&self, scene: &mut Scene) {\n        scene.sun.direction = Vec3::new(-0.3, -1.0, -0.2).normalize();\n        scene.sun.color = Vec3::new(1.0, 0.98, 0.92) * 0.5;\n        scene.sun.shadow_center = Vec3::new(94.0, 0.0, -3.0);\n        scene.sun.shadow_radius = 16.0;\n        scene.ambient.sky = Vec3::new(0.46, 0.56, 0.58);\n        scene.ambient.ground = Vec3::new(0.28, 0.32, 0.32);\n        scene.point_lights.push(PointLight { position: Vec3::new(94.0, 3.6, -3.2), color: Vec3::new(1.0, 0.98, 0.9) * 2.6, radius: 11.0, shadows: true });\n        scene.clear_color = srgb(16, 40, 44);\n        scene.style.cel_bands = 3.0;\n        scene.post.outline_darken = 0.4;\n        scene.post.bloom = 0.4;\n        scene.post.gi = 0.5;\n        scene.filter.vignette = 0.45;\n        scene.post.halos = 0.4;\n    }\n\n    fn finish(&mut self, scene: &mut Scene, f: &SurgeryFrame) {\n        let fade = self.local.fade.clamp(0.0, 1.0);\n        if fade > scene.filter.transition {\n            scene.filter.transition = fade;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n        if f.stage == Stage::Dead {\n            scene.filter.transition = 1.0;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n    }\n\n    fn hands(&mut self, scene: &mut Scene, f: &SurgeryFrame, wall: f32) {\n        for s in &f.surgeons {\n            if !s.present {\n                continue;\n            }\n            let slot = s.slot as usize;\n            let seat = seat_color(slot);\n            // This device's cursor is ahead of the tick; the sim's rail and tremor stay on it.\n            let mut at = s.cursor;\n            if let Some(l) = self.local.aim[slot] {\n                at += l - s.raw;\n            }\n            let ground = self.plate.height_at(at);\n            let pose = instruments::Pose {\n                using: s.using,\n                amount: match s.tool {\n                    Tool::Iv => s.dose,\n                    Tool::Gel => 1.0 - s.flow,\n                    Tool::Defib => s.charge,\n                    _ => 0.0,\n                },\n                time: wall,\n                seat,\n                glow: 0.0,\n                group: 0x900 + slot as u32,\n                ghost: false,\n            };\n            let lean = Vec3::new(0.3, 1.0, 0.62).normalize();\n            let side = Vec3::new(1.0, 0.0, -0.3).normalize();\n            let recoil = s.kick * s.kick * 0.5;\n            let hover = if s.using { 0.03 } else { 0.42 + (wall * 2.1).sin() * 0.03 };\n            // The IV goes to its port; the paddles to the field's middle.\n            let (tip, axis, sd) = match s.tool {\n                Tool::Iv => {\n                    let d = Vec3::new(-0.5, 0.6, -0.3).normalize();\n                    (Vec3::new(8.3, 0.6, 3.9), d, Vec3::new(0.6, 0.0, -1.0).normalize())\n                }\n                Tool::Defib => (Vec3::new(0.0, 1.2 - s.charge * 0.5 + recoil, 0.3), lean, side),\n                _ => (Vec3::new(at.x, ground + hover + recoil, at.y), lean, side),\n            };\n            instruments::model(&mut scene.sdfs, s.tool, tip, axis, sd, 1.15, &pose);\n            // The laser's beam.\n            if s.tool == Tool::Laser && s.using {\n                scene.sdfs.push(pav_render::SdfInstance {\n                    a: tip,\n                    b: Vec3::new(at.x, ground, at.y),\n                    ra: 0.022,\n                    rb: 0.035,\n                    color: Vec3::new(1.0, 0.25, 0.15),\n                    emissive: 2.2,\n                    style: Style::Unlit,\n                    flags: flags::NO_SHADOW | flags::OBJECT,\n                    group: 0,\n                    material: 0,\n                });\n            }\n        }\n        // The Echo's ghost hands.\n        for g in &f.ghosts {\n            let k = (g.t / GHOST_TRAVEL).clamp(0.0, 1.0);\n            let to = f.hazards.iter().find(|h| h.id == g.target).map(|h| h.touch_point()).unwrap_or(g.from);\n            let at = g.from.lerp(to, k * k * (3.0 - 2.0 * k));\n            let pose = instruments::Pose { using: k > 0.7, time: wall, seat: Vec3::ONE, group: 0xA00, ghost: true, ..Default::default() };\n            let tip = Vec3::new(at.x, self.plate.height_at(at) + 0.2, at.y);\n            instruments::model(&mut scene.sdfs, g.tool, tip, Vec3::new(-0.3, 1.0, 0.62).normalize(), Vec3::new(1.0, 0.0, 0.3).normalize(), 1.15, &pose);\n        }\n    }\n\n    /// The steel tray in the scene: the selected instrument lifts and glows.\n    fn tray(&mut self, scene: &mut Scene, f: &SurgeryFrame, wall: f32) {\n        let steel = Vec3::new(0.46, 0.5, 0.54);\n        let half = Vec3::new(8.25, 0.1, 0.72);\n        let at = Vec3::new(0.0, 0.92, 5.42);\n        scene.meshes.push(MeshInstance {\n            mesh: MeshKey::rounded_box(half, 0.08),\n            transform: glam::Mat4::from_scale_rotation_translation(Vec3::ONE, Quat::IDENTITY, at),\n            color: steel,\n            emissive: 0.0,\n            style: Style::Lit,\n            flags: flags::OBJECT | flags::NO_CUT,\n            group: 0x880,\n            material: 0,\n            ext: half,\n        });\n        let local = f.surgeons.first();\n        let selected = local.map(|s| s.tool);\n        for (i, tool) in f.ring.iter().enumerate() {\n            let x = tray_x(i);\n            let sel = selected == Some(*tool);\n            let hover = self.local.hover_tray == Some(i);\n            let lift = if sel { 0.34 + (wall * 3.0).sin() * 0.02 } else if hover { 0.16 } else { 0.0 };\n            let glow = if sel { 1.0 } else { 0.0 };\n            let mut pose = instruments::Pose { using: false, time: wall, seat: seat_color(0), glow, group: 0x800 + i as u32, ..Default::default() };\n            if let Some(s) = local {\n                match tool {\n                    Tool::Gel => pose.amount = 1.0 - s.flow,\n                    Tool::Iv => pose.amount = (s.iv_cool / 4.0).clamp(0.0, 1.0),\n                    _ => {}\n                }\n            }\n            // Pointing up the screen: tip away from the viewer.\n            let tip = Vec3::new(x, 1.14 + lift, 4.86);\n            instruments::model(&mut scene.sdfs, *tool, tip, Vec3::new(0.0, 0.05, 1.0).normalize(), Vec3::X, 0.56, &pose);\n            if sel {\n                scene.point_lights.push(PointLight { position: tip + Vec3::new(0.0, 0.8, 0.5), color: Vec3::new(1.0, 0.95, 0.75) * 0.5, radius: 2.0, shadows: false });\n            }\n        }\n    }\n}\n\nfn retractors(scene: &mut Scene) {\n    let steel = Vec3::new(0.62, 0.66, 0.7);\n    for (a, b) in [\n        (Vec3::new(-9.5, 0.55, -5.1), Vec3::new(-8.0, 0.3, -4.5)),\n        (Vec3::new(9.5, 0.55, -5.1), Vec3::new(8.0, 0.3, -4.5)),\n        (Vec3::new(-9.9, 0.55, 3.7), Vec3::new(-8.8, 0.25, 3.2)),\n        (Vec3::new(9.9, 0.55, 3.7), Vec3::new(9.3, 0.3, 3.3)),\n    ] {\n        scene.sdfs.push(pav_render::SdfInstance { a, b, ra: 0.13, rb: 0.08, color: steel, emissive: 0.0, style: Style::Lit, flags: flags::OBJECT, group: 0x8F0, material: 0 });\n    }\n    // The IV port, on its stand at the corner of the field.\n    scene.sdfs.push(pav_render::SdfInstance {\n        a: Vec3::new(8.6, 0.55, 3.75),\n        b: Vec3::new(8.1, 0.55, 4.05),\n        ra: 0.13,\n        rb: 0.13,\n        color: Vec3::new(0.86, 0.9, 0.96),\n        emissive: 0.0,\n        style: Style::Lit,\n        flags: flags::OBJECT,\n        group: 0x8F1,\n        material: 0,\n    });\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_view/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod materials;\\n','pub mod materials;\\npub mod surgery;\\n')\nopen(p,'w').write(s)\np='crates/pav_view/src/build.rs'\ns=open(p).read()\ns=s.replace('''    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n''','''    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n    /// The surgery game's drawing state.\n    pub surgery: crate::surgery::SurgeryView,\n''')\ns=s.replace('''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n''','''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        self.surgery.add_events(events);\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/surgeon.rs'\ns=open(p).read()\ns=s.replace('''pub fn clamp(p: Vec2) -> Vec2 {''','''/// Where a ring place's instrument lies on the tray, in field x.\npub fn tray_x(place: usize) -> f32 {\n    -7.0 + 2.0 * place as f32\n}\n\n/// The tray place at a field point, if the point is on the tray.\npub fn tray_place(p: Vec2) -> Option<usize> {\n    if p.y < 4.72 {\n        return None;\n    }\n    let i = ((p.x + 8.0) / 2.0).floor();\n    (0.0..8.0).contains(&i).then_some(i as usize)\n}\n\npub fn clamp(p: Vec2) -> Vec2 {''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/bot.rs'\ns=open(p).read()\ns=s.replace('let threshold = 25.0 + 30.0 * skill;','let threshold = 30.0 + 35.0 * skill;')\nopen(p,'w').write(s)\nEOF\nsed -i '0,/vitals = -22/s//vitals = -45/' crates/pav_core/src/games/surgery/content/cases/case1.toml\ngrep -n \"        scene$\\|^        scene\\b\" crates/pav_view/src/build.rs | head; awk 'NR>1445 && /^    }$/ {print NR; exit}' crates/pav_view/src/build.rs","description":"Write hazards, paper theatre, effects and the view entry point"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17614,"cache_read_input_tokens":468338,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17614},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"fafd0ecf-2783-4418-b664-dff88d344b56","timestamp":"2026-11-05T14:12:14.758Z","request_id":"req_011CgjutDnRhBayTU14FXLBs","wire_tool_inputs":{"toolu_017EkgzKhWNeu9AxbxnQrreX":{"command":"cat > crates/pav_view/src/surgery/strains.rs <<'EOF'\n//! Everything lying on the tissue: objects, parasites and the thread you left behind. SDF spheres\n//! and capsules with emissive parts.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::field::{Hazard, HazardKind as K, polyline_at};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::scene::{PointLight, Scene, SdfInstance, Style, flags, srgb};\n\nuse super::plate::PlateView;\n\nconst OBJ: u32 = flags::OBJECT | flags::NO_CUT;\n\nfn sd(scene: &mut Scene, a: Vec3, b: Vec3, ra: f32, rb: f32, color: Vec3, emissive: f32, style: Style, group: u32) {\n    scene.sdfs.push(SdfInstance { a, b, ra, rb, color, emissive, style, flags: OBJ, group, material: 0 });\n}\n\nfn on(p: Vec2, y: f32) -> Vec3 {\n    Vec3::new(p.x, y, p.y)\n}\n\nfn dir3(a: f32) -> Vec3 {\n    Vec3::new(a.cos(), 0.0, a.sin())\n}\n\npub fn emit(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, time: f32) {\n    let parasite = srgb(58, 26, 96);\n    let core = srgb(36, 18, 66);\n    let eye = srgb(255, 210, 70);\n    let sac = srgb(120, 255, 170);\n    let bone = srgb(238, 226, 200);\n    let metal = Vec3::new(0.56, 0.6, 0.64);\n    let rust = srgb(150, 94, 60);\n    let hook = srgb(210, 214, 220);\n    let frost = srgb(190, 230, 245);\n    let ember = srgb(255, 130, 40);\n    let thread = srgb(30, 44, 130);\n    let gauze = srgb(244, 242, 232);\n\n    // Thread stays on.\n    for s in &f.stains {\n        if s.kind == 1 && s.pts.len() >= 2 {\n            stitches(scene, plate, &s.pts, f32::MAX, thread);\n        }\n    }\n\n    for h in &f.hazards {\n        let g = 0x2000 + h.id;\n        let y = plate.height_at(h.pos);\n        let lift = h.drag.length() * 0.45;\n        let drag3 = Vec3::new(h.drag.x, lift, h.drag.y);\n        match h.kind {\n            K::Laceration | K::Bleeder => {\n                if h.progress > 0.0 {\n                    stitches(scene, plate, &h.pts, h.progress, thread);\n                }\n            }\n            K::Foreign => {\n                if h.hidden && h.reveal <= 0.0 {\n                    continue;\n                }\n                let d = dir3(h.axis);\n                let base = on(h.pos, y) + drag3;\n                let up = Vec3::Y;\n                match h.tag {\n                    0 => {\n                        // A barbed hook: a curve of steel with a barb.\n                        let mut last = base - d * 0.2 + up * 0.04;\n                        for i in 1..=5 {\n                            let t = i as f32 / 5.0;\n                            let p = base + d * (t * 0.55 - 0.2) + up * ((t * 2.6).sin() * 0.5 + 0.05);\n                            sd(scene, last, p, 0.055, 0.05, hook, 0.0, Style::Lit, g);\n                            last = p;\n                        }\n                        let tail = base + d * 0.5 + up * 0.75;\n                        sd(scene, last, tail, 0.05, 0.05, hook, 0.0, Style::Lit, g);\n                        sd(scene, base - d * 0.2 + up * 0.04, base - d * 0.02 + up * 0.28, 0.05, 0.012, hook, 0.0, Style::Lit, g);\n                        sd(scene, tail, tail + up * 0.06, 0.09, 0.09, rust, 0.0, Style::Cel, g);\n                    }\n                    1 => {\n                        // A shard of metal, standing proud.\n                        sd(scene, base - d * 0.1, base + d * 0.25 + up * 0.62, 0.17, 0.02, metal, 0.0, Style::Lit, g);\n                        sd(scene, base + d * 0.12, base + d * 0.46 + up * 0.32, 0.1, 0.015, rust, 0.0, Style::Lit, g);\n                    }\n                    2 => {\n                        // A cable splinter: twisted strands.\n                        for k in 0..3 {\n                            let off = dir3(h.axis + 1.57) * (k as f32 - 1.0) * 0.045;\n                            sd(scene, base + off - d * 0.05, base + off + d * 0.5 + up * 0.5, 0.032, 0.012, metal, 0.0, Style::Lit, g);\n                        }\n                    }\n                    3 => {\n                        // A piece of ember.\n                        sd(scene, base, base + d * 0.14 + up * 0.26, 0.2, 0.08, ember, 1.2, Style::Unlit, g);\n                    }\n                    4 => {\n                        // A cyst, or an appendix.\n                        sd(scene, base - d * 0.3 + up * 0.1, base + d * 0.3 + up * 0.32, h.r * 0.7, h.r, srgb(240, 170, 130), 0.0, Style::Cel, g);\n                    }\n                    _ => {\n                        // A seed: a violet pill.\n                        sd(scene, base - d * 0.12, base + d * 0.14 + up * 0.18, 0.13, 0.13, parasite, 0.0, Style::Cel, g);\n                        sd(scene, base + up * 0.18, base + up * 0.18, 0.06, 0.06, eye, 1.0, Style::Unlit, g);\n                    }\n                }\n            }\n            K::Polyp => {\n                let base = on(h.pos, y);\n                let (c, tip) = if h.tag == 4 { (srgb(250, 226, 170), srgb(255, 244, 210)) } else { (srgb(250, 150, 130), srgb(255, 200, 170)) };\n                let hot = h.heat.clamp(0.0, 1.3);\n                sd(scene, base, base + Vec3::Y * h.r * 0.5, h.r * 0.75, h.r * 0.55, c.lerp(ember, hot * 0.6), hot * 0.7, Style::Cel, g);\n                sd(scene, base + Vec3::Y * h.r * 0.75, base + Vec3::Y * h.r * 0.75, h.r * 0.44, h.r * 0.44, tip.lerp(ember, hot * 0.7), hot * 0.9, Style::Cel, g);\n            }\n            K::Tumor => {\n                if h.stage >= 2 {\n                    continue;\n                }\n                let base = on(h.pos, y) + drag3 * 1.6;\n                let lump = srgb(120, 56, 104);\n                let dark = srgb(84, 36, 84);\n                let beat = 1.0 + super::plate::beat_env(f.beat) * 0.03;\n                sd(scene, base, base + Vec3::Y * 0.18, h.r * 0.74 * beat, h.r * 0.66 * beat, lump, 0.0, Style::Cel, g);\n                for k in 0..5 {\n                    let a = k as f32 * 2.399 + h.id as f32;\n                    let p = base + dir3(a) * h.r * 0.56 + Vec3::Y * 0.26;\n                    sd(scene, p, p, h.r * 0.38 * beat, h.r * 0.38 * beat, dark, 0.0, Style::Cel, g + k);\n                }\n            }\n            K::Bone => {\n                let d = dir3(h.angle);\n                let at = on(h.pos, y + 0.25) + if h.by != 0 { Vec3::Y * 0.3 } else { Vec3::ZERO };\n                sd(scene, at - d * 0.72, at + d * 0.72, 0.3, 0.3, bone, 0.0, Style::Cel, g);\n                sd(scene, at + d * 0.72, at + d * 0.92 + Vec3::Y * 0.03, 0.26, 0.1, bone * 0.86, 0.0, Style::Cel, g);\n                sd(scene, at - d * 0.72, at - d * 0.92 + Vec3::Y * 0.02, 0.26, 0.1, bone * 0.86, 0.0, Style::Cel, g);\n                if h.stage == 1 && h.count > 0 {\n                    for k in 0..h.count {\n                        let off = d.cross(Vec3::Y).normalize() * (k as f32 - 0.5) * 0.28;\n                        sd(scene, at + off - d * 0.42 + Vec3::Y * 0.26, at + off + d * 0.42 + Vec3::Y * 0.26, 0.03, 0.03, metal, 0.0, Style::Lit, g);\n                    }\n                }\n            }\n            K::Nodule => {\n                if h.hidden && h.reveal <= 0.0 {\n                    continue;\n                }\n                let t_step = h.t;\n                let squash = 1.0 + h.dev * 0.2 * (time * 18.0).sin() - t_step * 0.25;\n                let base = on(h.pos, y + 0.05);\n                let r = h.r * squash.max(0.6);\n                let shake = if h.heat > 0.0 { (time * 40.0).sin() * 0.02 * h.heat } else { 0.0 };\n                let hot = h.heat.clamp(0.0, 1.3);\n                if h.stage == 0 {\n                    sd(scene, base + Vec3::X * shake, base + Vec3::X * shake + Vec3::Y * r * 0.25, r, r * 0.9, parasite.lerp(ember, hot * 0.7), hot * 0.8 + 0.08, Style::Cel, g);\n                    for k in 0..6 {\n                        let a = k as f32 * 1.047 + time * 0.7;\n                        let p = base + dir3(a) * r * 0.86 + Vec3::Y * r * 0.3;\n                        sd(scene, p, p + dir3(a) * r * 0.32 + Vec3::Y * 0.05, r * 0.2, 0.02, core, 0.0, Style::Cel, g);\n                    }\n                    if h.lit > 0.0 {\n                        scene.point_lights.push(PointLight { position: base + Vec3::Y, color: Vec3::new(0.55, 0.3, 1.0) * h.lit, radius: 3.0, shadows: false });\n                    }\n                    sd(scene, base + Vec3::Y * r, base + Vec3::Y * r, r * 0.26, r * 0.26, eye * 0.8, 0.4, Style::Unlit, g + 1);\n                } else {\n                    // Shell popped: the soft core, ready to pull.\n                    let lifted = base + drag3 * 1.6;\n                    sd(scene, lifted, lifted + Vec3::Y * 0.2, r * 0.8, r * 0.7, core, 0.0, Style::Cel, g);\n                    sd(scene, lifted + Vec3::Y * r * 0.72, lifted + Vec3::Y * r * 0.72, r * 0.46, r * 0.46, eye, 1.6, Style::Unlit, g + 1);\n                    for k in 0..4 {\n                        let a = k as f32 * 1.57 + 0.4;\n                        let p = base + dir3(a) * r * 1.2;\n                        sd(scene, p, p + Vec3::Y * 0.2, r * 0.3, 0.03, parasite, 0.0, Style::Cel, g + 2);\n                    }\n                }\n            }\n            K::Sac => {\n                let stem = on(h.to, plate.height_at(h.to) + 0.1);\n                let wob = (time * (7.0 + h.progress * 14.0) + h.id as f32).sin() * (0.02 + h.progress * 0.05);\n                let at = on(h.pos, y + 0.28) + Vec3::new(wob, 0.0, -wob);\n                let heat = h.heat.clamp(0.0, 1.0);\n                let stem_c = parasite.lerp(ember, if h.count == 0 { heat } else { 0.0 });\n                sd(scene, stem, at, 0.09, 0.07, stem_c, heat * 0.8, Style::Cel, g);\n                let r = h.r * (1.0 + wob * 2.0);\n                let col = sac.lerp(Vec3::new(1.0, 0.92, 0.3), (h.progress - 0.55).clamp(0.0, 0.45) * 2.0);\n                let d = (at - stem).normalize_or(Vec3::X);\n                sd(scene, at - d * r * 0.5, at + d * r * 0.55, r * 0.34, r, col, 0.75 + h.progress * 0.4, Style::Unlit, g + 1);\n            }\n            K::Crown => {\n                let base = on(h.pos, y + 0.05);\n                for k in 0..11 {\n                    let a = k as f32 * std::f32::consts::TAU / 11.0 + time * 0.25;\n                    let r0 = h.r * 0.86;\n                    let wave = (time * 2.0 + k as f32 * 1.3).sin() * 0.14;\n                    let p = base + Vec3::new(a.cos() * r0 * 1.3, 0.1, a.sin() * r0);\n                    let q = base + Vec3::new(a.cos() * (r0 + 0.55) * 1.3, 0.55 + wave, a.sin() * (r0 + 0.55));\n                    sd(scene, p, q, 0.2, 0.02, parasite, 0.05, Style::Cel, g);\n                    let n = base + Vec3::new(a.cos() * r0 * 0.7 * 1.3, 0.05, a.sin() * r0 * 0.7);\n                    sd(scene, n, p, 0.14, 0.2, core, 0.0, Style::Cel, g);\n                }\n            }\n            K::Eye => {\n                let base = on(h.pos, y + 0.2) + drag3 * 1.6;\n                match h.stage {\n                    0 => {\n                        sd(scene, base, base, h.r * 0.7, h.r * 0.7, core, 0.05, Style::Cel, g);\n                    }\n                    1 | 2 => {\n                        sd(scene, base, base, h.r * 0.9, h.r * 0.9, eye, 1.6, Style::Unlit, g);\n                        let look = Vec2::new((time * 0.9).sin(), (time * 0.7).cos()) * 0.2;\n                        let p = base + Vec3::new(look.x, h.r * 0.74, look.y);\n                        sd(scene, p, p, h.r * 0.34, h.r * 0.34, Vec3::new(0.02, 0.01, 0.03), 0.0, Style::Unlit, g + 1);\n                        let c = base + Vec3::Y * 0.5;\n                        scene.point_lights.push(PointLight { position: c, color: Vec3::new(1.0, 0.8, 0.3) * 0.7, radius: 4.0, shadows: false });\n                    }\n                    _ => {}\n                }\n            }\n            K::Ember => {\n                if h.stage >= 2 {\n                    continue;\n                }\n                let base = on(h.pos, y + 0.1);\n                let frozen = h.stage == 1 || h.heat > 0.4;\n                let color = if frozen { frost } else { ember };\n                let glow = if frozen { 0.2 } else { 1.0 + (time * 5.0 + h.id as f32).sin() * 0.3 };\n                let dark = if frozen { frost * 0.7 } else { srgb(90, 26, 18) };\n                sd(scene, base, base + Vec3::Y * 0.2, h.r, h.r * 0.74, dark, 0.0, Style::Cel, g);\n                for k in 0..5 {\n                    let a = k as f32 * 1.256 + h.id as f32;\n                    let p = base + dir3(a) * h.r * 0.62 + Vec3::Y * h.r * 0.5;\n                    sd(scene, p, p + Vec3::Y * 0.1, h.r * 0.32, h.r * 0.14, color, glow, Style::Unlit, g);\n                }\n                if !frozen {\n                    scene.point_lights.push(PointLight { position: base + Vec3::Y * 0.8, color: Vec3::new(1.0, 0.45, 0.15) * 0.8, radius: 3.4, shadows: false });\n                }\n            }\n            K::Tether => {\n                chain(scene, plate, &h.pts, h.progress, h.len(), 0.11, 0.07, parasite, 0.1, g, time, 0.05);\n            }\n            K::Tendril => {\n                chain(scene, plate, &h.pts, h.progress, h.len(), 0.2, 0.1, parasite, 0.12, g, time, 0.16);\n                let tip = polyline_at(&h.pts, h.progress).0;\n                let t3 = on(tip, plate.height_at(tip) + 0.35);\n                sd(scene, t3, t3, 0.42, 0.42, core, 0.0, Style::Cel, g);\n                sd(scene, t3 + Vec3::Y * 0.3, t3 + Vec3::Y * 0.3, 0.2, 0.2, eye, 1.6, Style::Unlit, g + 1);\n            }\n            K::Closure => {\n                // The gauze laid so far.\n                let mut s = 0.0;\n                while s < h.progress {\n                    let p = polyline_at(&h.pts, s).0;\n                    let q = polyline_at(&h.pts, (s + 0.3).min(h.progress)).0;\n                    sd(scene, on(p, plate.height_at(p) + 0.05), on(q, plate.height_at(q) + 0.05), 0.2, 0.2, gauze, 0.0, Style::Cel, g);\n                    s += 0.3;\n                }\n            }\n            K::Furnace => {\n                let base = on(h.pos, y + 0.1) + drag3;\n                let k = 1.0 - h.stage as f32 * 0.09;\n                let r = h.r * k;\n                let hot = if h.stage == 0 { 1.6 } else if h.stage < 4 { 0.9 } else { 0.25 };\n                sd(scene, base, base + Vec3::Y * 0.3, r, r * 0.84, srgb(40, 16, 24), 0.0, Style::Cel, g);\n                for i in 0..9 {\n                    let a = i as f32 * 2.399 + time * 0.2;\n                    let p = base + dir3(a) * r * 0.8 + Vec3::Y * r * 0.55;\n                    let q = base + dir3(a + 0.5) * r * 0.5 + Vec3::Y * r * 0.95;\n                    sd(scene, p, q, 0.07, 0.04, if h.stage == 0 { ember } else { frost.lerp(ember, 0.5) }, hot, Style::Unlit, g);\n                }\n                scene.point_lights.push(PointLight { position: base + Vec3::Y * 1.5, color: Vec3::new(1.0, 0.42, 0.14) * 1.2 * k, radius: 6.0, shadows: false });\n            }\n            _ => {}\n        }\n    }\n}\n\n/// A line of thread, up to `upto` along the wound: small crossing stitches.\nfn stitches(scene: &mut Scene, plate: &PlateView, pts: &[Vec2], upto: f32, color: Vec3) {\n    let len = pv_len(pts);\n    let end = upto.min(len);\n    let mut s = 0.1;\n    let mut flip = 1.0f32;\n    while s < end {\n        let (p, t) = polyline_at(pts, s);\n        let n = Vec2::new(-t.y, t.x) * 0.2 * flip;\n        let a = p - n + t * 0.05;\n        let b = p + n + t * 0.05;\n        let y = plate.height_at(p) + 0.05;\n        scene.sdfs.push(SdfInstance {\n            a: on(a, y),\n            b: on(b, y + 0.02),\n            ra: 0.024,\n            rb: 0.024,\n            color,\n            emissive: 0.0,\n            style: Style::Cel,\n            flags: flags::NO_SHADOW | OBJ,\n            group: 0x1F00,\n            material: 0,\n        });\n        flip = -flip;\n        s += 0.25;\n    }\n}\n\nfn pv_len(pts: &[Vec2]) -> f32 {\n    pts.windows(2).map(|w| w[0].distance(w[1])).sum()\n}\n\n/// A creeping chain of capsules along a polyline, from `from` to `to`.\nfn chain(scene: &mut Scene, plate: &PlateView, pts: &[Vec2], from: f32, to: f32, ra: f32, rb: f32, color: Vec3, glow: f32, g: u32, time: f32, wave: f32) {\n    let steps = (((to - from) / 0.4).ceil() as i32).max(1);\n    let mut last = None;\n    for i in 0..=steps {\n        let s = from + (to - from) * i as f32 / steps as f32;\n        let (p, t) = polyline_at(pts, s);\n        let n = Vec2::new(-t.y, t.x) * (time * 3.0 + s * 2.3).sin() * wave;\n        let at = p + n;\n        let q = on(at, plate.height_at(at) + 0.18);\n        if let Some(l) = last {\n            let k = i as f32 / steps as f32;\n            sd(scene, l, q, ra + (rb - ra) * k, ra + (rb - ra) * k, color, glow, Style::Cel, g);\n        }\n        last = Some(q);\n    }\n}\n\n/// Is a hazard something that should glow where the guide points?\npub fn touch3(h: &Hazard, plate: &PlateView) -> Vec3 {\n    let p = h.touch_point();\n    let extra = match h.kind {\n        K::Laceration | K::Incision | K::Closure => 0.05,\n        _ => 0.3,\n    };\n    on(p, plate.height_at(p) + extra)\n}\nEOF\ncat > crates/pav_view/src/surgery/paper.rs <<'EOF'\n//! The paper theatre: layered, extruded spline cards from the rig and set files, lit, shadowed and\n//! outlined by the engine.\n\nuse std::collections::HashMap;\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::content::{self, RigDef, SetDef};\nuse pav_core::games::surgery::frame::{ActorView, StoryView};\nuse pav_core::games::surgery::paper;\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{DynamicMesh, ParticleBurst, PointLight, Scene, Style, flags, srgb};\n\nconst LAYER: f32 = 0.035;\n\nstruct Card {\n    role: String,\n    name: String,\n    pts: Vec<Vec2>,\n    tris: Vec<[u32; 3]>,\n    z: f32,\n    depth: f32,\n    color: Vec3,\n    spring: f32,\n    sign: f32,\n    head: bool,\n    emissive: f32,\n    monitor: bool,\n}\n\nstruct RigMesh {\n    cards: Vec<Card>,\n}\n\nstruct SetMesh {\n    cards: Vec<Card>,\n}\n\nfn rgb(c: [u8; 3]) -> Vec3 {\n    srgb(c[0], c[1], c[2])\n}\n\nfn card_of(pts: Vec<Vec2>, role: &str, name: &str, z: f32, depth: f32, color: Vec3, spring: f32, sign: f32) -> Card {\n    let tris = paper::triangulate(&pts);\n    let is_head = !matches!(role, \"body\") && (z >= 2.9 || name.contains(\"hair\") || name.contains(\"chignon\"));\n    Card {\n        role: role.to_string(),\n        name: name.to_string(),\n        pts,\n        tris,\n        z,\n        depth,\n        color,\n        spring,\n        sign,\n        head: is_head,\n        emissive: 0.0,\n        monitor: false,\n    }\n}\n\nfn build_rig(r: &RigDef) -> RigMesh {\n    let mut cards = Vec::new();\n    for p in &r.part {\n        let outline = p.outline();\n        let color = r.palette.get(&p.color).map(|c| rgb(*c)).unwrap_or(Vec3::ONE);\n        if p.mirror {\n            cards.push(card_of(outline.clone(), &p.role, &p.name, p.z, p.depth, color, p.spring, 1.0));\n            let flipped: Vec<Vec2> = outline.iter().rev().map(|q| Vec2::new(-q.x, q.y)).collect();\n            cards.push(card_of(flipped, &p.role, &p.name, p.z, p.depth, color, p.spring, -1.0));\n        } else {\n            cards.push(card_of(outline, &p.role, &p.name, p.z, p.depth, color, p.spring, 1.0));\n        }\n    }\n    RigMesh { cards }\n}\n\nfn build_set(s: &SetDef) -> SetMesh {\n    let mut cards = Vec::new();\n    for l in &s.layer {\n        let n = l.repeat[0].max(1.0) as i32;\n        for k in 0..n {\n            let dx = l.repeat[1] * (k as f32 - (n - 1) as f32 * 0.5);\n            let pts: Vec<Vec2> = l.points.iter().map(|p| Vec2::new(p[0] + dx, p[1])).collect();\n            let pts = paper::chaikin(&pts, l.chaikin);\n            let mut c = card_of(pts, \"\", \"layer\", l.z, 0.08, rgb(l.color), 0.0, 1.0);\n            c.emissive = l.emissive;\n            c.monitor = l.monitor;\n            cards.push(c);\n        }\n    }\n    SetMesh { cards }\n}\n\n/// Emits a card: front face plus edge quads back to `z - depth`, so it casts shadows and takes\n/// outlines.\nfn push_card(\n    scene: &mut Scene,\n    pts: &[Vec2],\n    tris: &[[u32; 3]],\n    m: Mat4,\n    z: f32,\n    depth: f32,\n    color: Vec3,\n    emissive: f32,\n    group: u32,\n    style: Style,\n    flag: u32,\n) {\n    if pts.len() < 3 || tris.is_empty() {\n        return;\n    }\n    let normal = m.transform_vector3(Vec3::Z).normalize_or(Vec3::Z);\n    let mut data = MeshData { vertices: Vec::with_capacity(pts.len() * 5), indices: Vec::with_capacity(tris.len() * 3 + pts.len() * 6) };\n    for p in pts {\n        let v = m.transform_point3(Vec3::new(p.x, p.y, z));\n        data.vertices.push(Vertex { pos: v.to_array(), normal: normal.to_array(), uv: [0.0, 0.0], color: [1.0; 4] });\n    }\n    for t in tris {\n        data.indices.extend_from_slice(t);\n    }\n    // Edges. Outward: for a counter-clockwise outline, right of the walking direction.\n    let ccw = paper::signed_area(pts) >= 0.0;\n    for i in 0..pts.len() {\n        let (a, b) = (pts[i], pts[(i + 1) % pts.len()]);\n        let d = b - a;\n        if d.length_squared() < 1e-9 {\n            continue;\n        }\n        let out = if ccw { Vec3::new(d.y, -d.x, 0.0) } else { Vec3::new(-d.y, d.x, 0.0) }.normalize();\n        let nrm = m.transform_vector3(out).normalize_or(Vec3::X).to_array();\n        let base = data.vertices.len() as u32;\n        for (p, zz) in [(a, z), (b, z), (b, z - depth), (a, z - depth)] {\n            let v = m.transform_point3(Vec3::new(p.x, p.y, zz));\n            data.vertices.push(Vertex { pos: v.to_array(), normal: nrm, uv: [0.0, 0.0], color: [1.0; 4] });\n        }\n        if ccw {\n            data.indices.extend_from_slice(&[base, base + 3, base + 2, base, base + 2, base + 1]);\n        } else {\n            data.indices.extend_from_slice(&[base, base + 1, base + 2, base, base + 2, base + 3]);\n        }\n    }\n    scene.dynamic.push(DynamicMesh { data, color, emissive, style, flags: flag, group, material: 0 });\n}\n\nfn ease_out_back(t: f32) -> f32 {\n    let c1 = 1.70158;\n    let c3 = c1 + 1.0;\n    let x = t - 1.0;\n    1.0 + c3 * x * x * x + c1 * x * x\n}\n\n#[derive(Default)]\npub struct PaperView {\n    rigs: HashMap<String, RigMesh>,\n    sets: HashMap<String, SetMesh>,\n}\n\nimpl PaperView {\n    fn ensure(&mut self, story: &StoryView) {\n        let content = content::get();\n        for a in &story.actors {\n            if !self.rigs.contains_key(&*a.who) {\n                if let Some(r) = content.rigs.get(&*a.who) {\n                    self.rigs.insert(a.who.to_string(), build_rig(r));\n                }\n            }\n        }\n        if !self.sets.contains_key(&*story.set) {\n            if let Some(s) = content.sets.get(&*story.set) {\n                self.sets.insert(story.set.to_string(), build_set(s));\n            }\n        }\n    }\n\n    /// Forget meshes after a content reload.\n    pub fn clear(&mut self) {\n        self.rigs.clear();\n        self.sets.clear();\n    }\n\n    pub fn emit(&mut self, scene: &mut Scene, story: &StoryView, time: f32, dt: f32, beat: f32) {\n        self.ensure(story);\n        let content = content::get();\n        let set = content.sets.get(&*story.set);\n        // The stage, per set.\n        scene.ambient.sky = set.map(|s| Vec3::from(s.ambient_sky)).unwrap_or(Vec3::new(0.74, 0.74, 0.78));\n        scene.ambient.ground = set.map(|s| Vec3::from(s.ambient_ground)).unwrap_or(Vec3::new(0.6, 0.56, 0.56));\n        scene.sun.direction = Vec3::new(0.3, -0.45, -0.85).normalize();\n        scene.sun.color = Vec3::new(1.0, 0.97, 0.92) * 0.34;\n        scene.sun.shadows = true;\n        scene.sun.shadow_center = Vec3::new(0.0, 0.0, -2.0);\n        scene.sun.shadow_radius = 14.0;\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.05;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.32;\n        scene.post.outline_px = 1.4;\n        scene.post.gi = 0.4;\n        scene.post.bloom = 0.4;\n        scene.post.bloom_threshold = 1.1;\n        scene.filter.vignette = 0.32;\n        scene.clear_color = set.map(|s| rgb(s.sky)).unwrap_or(Vec3::ZERO);\n        if let Some(s) = set {\n            for l in &s.lamp {\n                scene.point_lights.push(PointLight {\n                    position: Vec3::new(l[0], l[1], l[2]),\n                    color: Vec3::new(l[3], l[4], l[5]) * 0.7,\n                    radius: l[6],\n                    shadows: false,\n                });\n            }\n            if s.rain {\n                let n = (dt * 90.0).ceil() as u32;\n                scene.particles.push(ParticleBurst {\n                    count: n,\n                    pos: Vec3::new(0.0, 7.0, -5.8),\n                    area: Vec3::new(16.0, 0.2, 0.5),\n                    vel: Vec3::new(-2.0, -16.0, 0.0),\n                    spread: 0.4,\n                    life: (0.7, 1.0),\n                    size: (0.016, 0.012),\n                    color0: glam::Vec4::new(0.5, 0.68, 0.95, 0.4),\n                    color1: glam::Vec4::new(0.5, 0.68, 0.95, 0.0),\n                    additive: true,\n                    stretch: true,\n                    ..Default::default()\n                });\n            }\n        }\n        // The set's cards.\n        if let Some(mesh) = self.sets.get(&*story.set) {\n            for (i, c) in mesh.cards.iter().enumerate() {\n                let style = if c.emissive > 0.5 { Style::Unlit } else { Style::Cel };\n                push_card(scene, &c.pts, &c.tris, Mat4::IDENTITY, c.z, c.depth, c.color, c.emissive, 2000 + i as u32, style, 0);\n                if c.monitor {\n                    monitor_trace(scene, c, beat, time);\n                }\n            }\n        }\n        // The cast.\n        let n = story.actors.len();\n        for (idx, a) in story.actors.iter().enumerate() {\n            if let Some(rig) = self.rigs.get(&*a.who) {\n                let r = content.rigs.get(&*a.who);\n                emit_actor(scene, rig, r, a, time, dt, idx, n, story);\n            }\n        }\n    }\n}\n\nfn monitor_trace(scene: &mut Scene, c: &Card, beat: f32, time: f32) {\n    let (mut x0, mut x1, mut y0, mut y1) = (f32::MAX, f32::MIN, f32::MAX, f32::MIN);\n    for p in &c.pts {\n        x0 = x0.min(p.x);\n        x1 = x1.max(p.x);\n        y0 = y0.min(p.y);\n        y1 = y1.max(p.y);\n    }\n    let segs = 32;\n    let wave = |t: f32| -> f32 {\n        let ph = (t * 3.0 - time * 1.2 + beat * 0.0).rem_euclid(1.0);\n        let g = |c: f32, w: f32| (-(ph - c) * (ph - c) / w).exp();\n        g(0.1, 0.0012) * 1.0 - g(0.14, 0.0006) * 0.3 + g(0.3, 0.004) * 0.25\n    };\n    let mid = (y0 + y1) * 0.5;\n    let amp = (y1 - y0) * 0.38;\n    let mut data = MeshData::default();\n    for i in 0..=segs {\n        let t = i as f32 / segs as f32;\n        let x = x0 + (x1 - x0) * t;\n        let y = mid + wave(t) * amp - amp * 0.2;\n        for dy in [-0.03f32, 0.03] {\n            data.vertices.push(Vertex { pos: [x, y + dy, c.z + 0.05], normal: [0.0, 0.0, 1.0], uv: [0.0, 0.0], color: [1.0; 4] });\n        }\n        if i < segs {\n            let b = (i * 2) as u32;\n            data.indices.extend_from_slice(&[b, b + 2, b + 1, b + 1, b + 2, b + 3]);\n        }\n    }\n    scene.dynamic.push(DynamicMesh {\n        data,\n        color: Vec3::new(0.3, 1.0, 0.6),\n        emissive: 1.3,\n        style: Style::Unlit,\n        flags: flags::NO_SHADOW,\n        group: 0,\n        material: 0,\n    });\n}\n\nfn emit_actor(scene: &mut Scene, rig: &RigMesh, def: Option<&RigDef>, a: &ActorView, time: f32, _dt: f32, idx: usize, _n: usize, story: &StoryView) {\n    let seed = a.who.bytes().fold(7u32, |h, b| h.wrapping_mul(31).wrapping_add(b as u32)) as f32 * 0.001;\n    // Slide in with overshoot; slide out; shake on shock.\n    let side = if a.x < 0.0 { -1.0 } else { 1.0 };\n    let k = if a.leaving { 1.0 - (a.t / 0.45).clamp(0.0, 1.0) } else { ease_out_back((a.t / 0.5).clamp(0.0, 1.0)) };\n    let mut x = a.x + side * (1.0 - k) * 9.0;\n    x += (story.shake * 30.0 + seed).sin() * 0.05 * story.shake;\n    let talking = a.talking;\n    let t = time + seed * 17.0;\n    let breathe = (t * 1.5).sin() * 0.012;\n    let sway = (t * 0.6).sin() * 2f32.to_radians();\n    let yaw = -side * 0.22 + sway;\n    let expr = def.and_then(|d| d.expr.get(&*a.expr).or_else(|| d.expr.get(\"neutral\")));\n    let is_speaker = a.who == story.who;\n    // Who isn't speaking steps back a little.\n    let (scale, z_off) = if is_speaker { (1.0, 0.0) } else { (0.97, -0.25) };\n    let root = Mat4::from_translation(Vec3::new(x, -0.7, z_off))\n        * Mat4::from_rotation_y(yaw)\n        * Mat4::from_scale(Vec3::splat(scale));\n    let body = root * Mat4::from_translation(Vec3::new(0.0, breathe, 0.0));\n    // Head: tilt, a nod on stressed words, a little look-around.\n    let nod = if talking { ((t * 7.5).sin() * 0.5 + 0.5).powi(3) * 0.03 } else { 0.0 };\n    let (tilt, drop) = expr.map(|e| (e.tilt, e.drop)).unwrap_or((0.0, 0.0));\n    let head = body\n        * Mat4::from_translation(Vec3::new(0.0, -0.3 - nod - drop, 0.0))\n        * Mat4::from_rotation_z((tilt + (t * 0.8).sin() * 0.8).to_radians())\n        * Mat4::from_translation(Vec3::new(0.0, 0.3, 0.0));\n    // Blink every few seconds.\n    let blink_t = (t * 0.27).fract();\n    let blink = if blink_t < 0.035 { 1.0 - (blink_t / 0.035 - 0.5).abs() * 2.0 } else { 0.0 };\n    let lid_e = expr.map(|e| e.lid).unwrap_or(0.0);\n    let closed = (blink + lid_e.max(0.0) * 0.35).clamp(0.0, 1.0);\n    let wide = (-lid_e).max(0.0);\n    let (bi, bo) = expr.map(|e| (e.brow_inner, e.brow_outer)).unwrap_or((0.0, 0.0));\n    let iris_k = expr.map(|e| if e.iris > 0.0 { e.iris } else { 1.0 }).unwrap_or(1.0);\n    let look = Vec2::new(-side * 0.012 + (t * 0.4).sin() * 0.006, 0.0);\n    let base = 100 + idx as u32 * 60;\n    for (i, c) in rig.cards.iter().enumerate() {\n        let m = if c.head { head } else { body };\n        let z = c.z * LAYER;\n        let mut pts = c.pts.clone();\n        let sign = c.sign;\n        match c.role.as_str() {\n            \"brow\" => {\n                for p in &mut pts {\n                    let along = ((p.x.abs() - 0.13) / 0.42).clamp(0.0, 1.0);\n                    p.y += bi + (bo - bi) * along;\n                }\n            }\n            \"lid\" => {\n                for p in &mut pts {\n                    p.y -= closed * 0.14;\n                    p.y += wide * 0.02;\n                }\n            }\n            \"eye\" => {\n                for p in &mut pts {\n                    p.y = 0.34 + (p.y - 0.34) * (1.0 - closed * 0.9 + wide * 0.25);\n                }\n            }\n            \"iris\" | \"pupil\" => {\n                let center = Vec2::new(0.34 * sign, 0.34);\n                for p in &mut pts {\n                    *p = center + (*p - center) * iris_k + look;\n                    p.y = 0.34 + (p.y - 0.34) * (1.0 - closed * 0.9);\n                }\n            }\n            \"hair\" => {\n                if c.spring > 0.0 {\n                    let wind = (t * 1.7).sin() * 0.018 * c.spring;\n                    for p in &mut pts {\n                        p.x += wind * (1.8 - p.y).max(0.0);\n                    }\n                }\n            }\n            _ => {\n                if c.spring > 0.0 {\n                    let wind = (t * 1.3).sin() * 0.014 * c.spring;\n                    for p in &mut pts {\n                        p.x += wind * (1.2 - p.y).max(0.0);\n                    }\n                }\n            }\n        }\n        let tris = &c.tris;\n        let style = if c.name == \"glint\" { Style::Unlit } else { Style::Cel };\n        let group = match c.name.as_str() {\n            \"cheek\" => base,\n            \"face\" => base,\n            _ => base + 1 + i as u32,\n        };\n        push_card(scene, &pts, tris, m, z, c.depth, c.color, 0.0, group, style, 0);\n    }\n    // The mouth: a frame for talk, a frame for rest.\n    if let Some(e) = expr {\n        let open = talking && (t * 11.0).sin() > -0.1;\n        let shape = if open && !e.open.is_empty() { &e.open } else { &e.closed };\n        if shape.len() >= 3 {\n            let pts: Vec<Vec2> = shape.iter().map(|p| Vec2::new(p[0], p[1])).collect();\n            let pts = paper::chaikin(&pts, 1);\n            let tris = paper::triangulate(&pts);\n            push_card(scene, &pts, &tris, head, 3.7 * LAYER, 0.01, srgb(92, 30, 40), 0.0, base + 59, Style::Cel, 0);\n        }\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/fx.rs <<'EOF'\n//! Effects: cue bursts and the continuous particles and distortions of the field.\n\nuse glam::{Vec2, Vec3, Vec4};\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::{HazardKind as K, Tool};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_render::scene::{DistortKind, Distortion, ParticleBurst, PointLight, Scene};\n\nuse super::plate::PlateView;\n\n/// A cue's burst of particles: stylised, like a medical illustration.\npub fn cue_bursts(id: u16, pos: Vec3, out: &mut Vec<ParticleBurst>) {\n    let at = pos + Vec3::Y * 0.5;\n    let blood = |n: u32, speed: f32| ParticleBurst {\n        count: n,\n        pos: at,\n        area: Vec3::splat(0.08),\n        vel: Vec3::new(0.0, speed, 0.0),\n        spread: speed * 0.7,\n        gravity: 11.0,\n        life: (0.35, 0.6),\n        size: (0.07, 0.03),\n        color0: Vec4::new(0.42, 0.015, 0.05, 1.0),\n        color1: Vec4::new(0.24, 0.01, 0.03, 1.0),\n        additive: false,\n        ..Default::default()\n    };\n    match id {\n        cue::SLICE | cue::TEAR => out.push(blood(14, 2.4)),\n        cue::POP | cue::SPURT => out.push(blood(22, 3.0)),\n        cue::BURST => {\n            out.push(ParticleBurst {\n                count: 42,\n                pos: at,\n                area: Vec3::splat(0.15),\n                vel: Vec3::Y * 3.0,\n                spread: 4.0,\n                gravity: 10.0,\n                life: (0.4, 0.8),\n                size: (0.1, 0.03),\n                color0: Vec4::new(0.45, 1.0, 0.55, 1.0),\n                color1: Vec4::new(0.2, 0.5, 0.2, 0.0),\n                additive: false,\n                ..Default::default()\n            });\n        }\n        cue::SIZZLE => {\n            out.push(ParticleBurst {\n                count: 18,\n                pos: at,\n                vel: Vec3::Y * 2.5,\n                spread: 3.4,\n                gravity: 7.0,\n                life: (0.2, 0.45),\n                size: (0.04, 0.0),\n                color0: Vec4::new(3.0, 1.4, 0.4, 1.0),\n                color1: Vec4::new(1.2, 0.2, 0.0, 0.0),\n                stretch: true,\n                ..Default::default()\n            });\n            out.push(smoke(at, 10));\n        }\n        cue::SCORCH => out.push(smoke(at, 18)),\n        cue::FROST => {\n            out.push(ParticleBurst {\n                count: 22,\n                pos: at,\n                area: Vec3::splat(0.2),\n                vel: Vec3::Y * 0.6,\n                spread: 1.2,\n                gravity: -0.2,\n                life: (0.4, 0.9),\n                size: (0.06, 0.0),\n                color0: Vec4::new(0.8, 1.0, 1.2, 0.9),\n                color1: Vec4::new(0.5, 0.8, 1.0, 0.0),\n                ..Default::default()\n            });\n        }\n        cue::GEL => {\n            out.push(ParticleBurst {\n                count: 6,\n                pos: at,\n                vel: Vec3::Y * 1.0,\n                spread: 1.0,\n                gravity: 9.0,\n                life: (0.25, 0.45),\n                size: (0.06, 0.04),\n                color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                color1: Vec4::new(0.55, 0.95, 0.8, 0.0),\n                additive: false,\n                ..Default::default()\n            });\n        }\n        cue::IMMACULATE => {\n            out.push(ParticleBurst {\n                count: 20,\n                pos: at,\n                vel: Vec3::Y * 2.0,\n                spread: 2.6,\n                gravity: 3.0,\n                life: (0.3, 0.6),\n                size: (0.05, 0.0),\n                color0: Vec4::new(2.0, 1.8, 1.0, 1.0),\n                color1: Vec4::new(1.0, 0.8, 0.3, 0.0),\n                ..Default::default()\n            });\n        }\n        cue::DEFIB_THUMP => {\n            out.push(ParticleBurst {\n                count: 60,\n                pos: Vec3::new(0.0, 1.0, 0.0),\n                area: Vec3::new(3.0, 0.2, 2.0),\n                vel: Vec3::Y * 1.5,\n                spread: 5.0,\n                gravity: 3.0,\n                life: (0.2, 0.5),\n                size: (0.04, 0.0),\n                color0: Vec4::new(1.0, 1.6, 2.4, 1.0),\n                color1: Vec4::new(0.4, 0.8, 1.6, 0.0),\n                stretch: true,\n                ..Default::default()\n            });\n        }\n        cue::PING | cue::RIPPLE | cue::GIFT_FIRE => {}\n        _ => {}\n    }\n}\n\nfn smoke(at: Vec3, n: u32) -> ParticleBurst {\n    ParticleBurst {\n        count: n,\n        pos: at,\n        area: Vec3::splat(0.1),\n        vel: Vec3::Y * 1.0,\n        spread: 0.5,\n        drag: 0.8,\n        life: (0.6, 1.2),\n        size: (0.1, 0.4),\n        color0: Vec4::new(0.5, 0.48, 0.46, 0.5),\n        color1: Vec4::new(0.3, 0.3, 0.3, 0.0),\n        additive: false,\n        turbulence: 1.0,\n        ..Default::default()\n    }\n}\n\n/// What burns and bleeds all the time, this frame.\npub fn continuous(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, time: f32, dt: f32, last_beats: &mut u32, carry: &mut f32) {\n    let beat = f.beats != *last_beats;\n    *last_beats = f.beats;\n    *carry += dt;\n    let tick = *carry > 0.05;\n    if tick {\n        *carry = 0.0;\n    }\n    let on_tissue = |p: Vec2, up: f32| Vec3::new(p.x, plate.height_at(p) + up, p.y);\n    for h in &f.hazards {\n        match h.kind {\n            K::Bleeder if beat && !f.flat => {\n                scene.particles.push(ParticleBurst {\n                    count: 26,\n                    pos: on_tissue(h.pos, 0.08),\n                    vel: Vec3::new(h.axis.cos() * 0.9, 3.6, h.axis.sin() * 0.9),\n                    spread: 1.0,\n                    gravity: 12.0,\n                    life: (0.35, 0.6),\n                    size: (0.075, 0.03),\n                    color0: Vec4::new(0.5, 0.02, 0.05, 1.0),\n                    color1: Vec4::new(0.3, 0.01, 0.03, 1.0),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            K::Ember if tick && h.stage == 0 => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: on_tissue(h.pos, 0.4),\n                    area: Vec3::splat(h.r * 0.5),\n                    vel: Vec3::Y * 1.1,\n                    spread: 0.5,\n                    gravity: -0.5,\n                    life: (0.5, 1.1),\n                    size: (0.035, 0.0),\n                    color0: Vec4::new(3.0, 1.4, 0.3, 1.0),\n                    color1: Vec4::new(1.4, 0.2, 0.0, 0.0),\n                    turbulence: 1.5,\n                    ..Default::default()\n                });\n                scene.distortions.push(Distortion {\n                    pos: on_tissue(h.pos, 0.7),\n                    radius: 1.3,\n                    strength: 0.06,\n                    kind: DistortKind::Haze,\n                    progress: (time * 0.3).fract(),\n                });\n            }\n            K::Furnace => {\n                scene.distortions.push(Distortion {\n                    pos: on_tissue(h.pos, 1.0),\n                    radius: 3.0,\n                    strength: 0.08,\n                    kind: DistortKind::Haze,\n                    progress: (time * 0.3).fract(),\n                });\n                if tick {\n                    scene.particles.push(ParticleBurst {\n                        count: 3,\n                        pos: on_tissue(h.pos, 0.5),\n                        area: Vec3::splat(h.r * 0.6),\n                        vel: Vec3::Y * 1.8,\n                        spread: 0.8,\n                        gravity: -0.5,\n                        life: (0.5, 1.2),\n                        size: (0.05, 0.0),\n                        color0: Vec4::new(3.0, 1.2, 0.3, 1.0),\n                        color1: Vec4::new(1.2, 0.1, 0.0, 0.0),\n                        turbulence: 1.5,\n                        ..Default::default()\n                    });\n                }\n            }\n            _ => {}\n        }\n    }\n    if let Some(r) = f.heat_ring {\n        scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.2), radius: r.max(0.5), strength: 0.14, kind: DistortKind::Ring, progress: 0.5 });\n        scene.point_lights.push(PointLight { position: Vec3::new(0.0, 2.0, 0.2), color: Vec3::new(1.0, 0.4, 0.1) * 0.6, radius: r + 3.0, shadows: false });\n    }\n    // Tools at work.\n    for s in &f.surgeons {\n        if !s.present || !s.using {\n            continue;\n        }\n        let at = on_tissue(s.cursor, 0.1);\n        match s.tool {\n            Tool::Laser if s.engaged != 0 && tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 3,\n                    pos: at,\n                    vel: Vec3::Y * 1.0,\n                    spread: 0.5,\n                    drag: 0.8,\n                    life: (0.4, 0.8),\n                    size: (0.06, 0.22),\n                    color0: Vec4::new(0.5, 0.48, 0.46, 0.4),\n                    color1: Vec4::new(0.3, 0.3, 0.3, 0.0),\n                    additive: false,\n                    turbulence: 1.0,\n                    ..Default::default()\n                });\n                scene.point_lights.push(PointLight { position: at + Vec3::Y * 0.5, color: Vec3::new(1.0, 0.4, 0.2) * 0.9, radius: 2.5, shadows: false });\n            }\n            Tool::Cryo if s.engaged != 0 && tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 4,\n                    pos: at,\n                    area: Vec3::splat(0.2),\n                    vel: Vec3::Y * 0.5,\n                    spread: 0.7,\n                    life: (0.3, 0.6),\n                    size: (0.05, 0.0),\n                    color0: Vec4::new(0.8, 1.0, 1.2, 0.9),\n                    color1: Vec4::new(0.5, 0.8, 1.0, 0.0),\n                    ..Default::default()\n                });\n            }\n            Tool::Gel if tick && s.flow > 0.02 => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: at + Vec3::Y * 0.4,\n                    vel: Vec3::ZERO,\n                    spread: 0.4,\n                    gravity: 8.0,\n                    life: (0.2, 0.3),\n                    size: (0.06, 0.04),\n                    color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                    color1: Vec4::new(0.55, 0.95, 0.8, 0.5),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            Tool::Suction if tick => {\n                scene.particles.push(ParticleBurst {\n                    count: 2,\n                    pos: at,\n                    area: Vec3::new(0.35, 0.02, 0.35),\n                    vel: Vec3::Y * 0.3,\n                    spread: 0.2,\n                    life: (0.15, 0.3),\n                    size: (0.04, 0.0),\n                    color0: Vec4::new(0.5, 0.03, 0.06, 1.0),\n                    color1: Vec4::new(0.3, 0.02, 0.03, 0.0),\n                    additive: false,\n                    ..Default::default()\n                });\n            }\n            _ => {}\n        }\n    }\n    // The gifts.\n    if f.hush > 0.2 && tick {\n        scene.particles.push(ParticleBurst {\n            count: 4,\n            pos: Vec3::new(0.0, 2.0, 0.0),\n            area: Vec3::new(10.0, 1.5, 6.0),\n            vel: Vec3::ZERO,\n            spread: 0.08,\n            life: (1.2, 2.2),\n            size: (0.03, 0.0),\n            color0: Vec4::new(0.9, 0.92, 1.0, 0.9) * f.hush,\n            color1: Vec4::new(0.6, 0.7, 1.0, 0.0),\n            turbulence: 0.2,\n            ..Default::default()\n        });\n    }\n    if f.echo > 0.2 && tick {\n        for g in &f.ghosts {\n            let k = (g.t / pav_core::games::surgery::field::GHOST_TRAVEL).clamp(0.0, 1.0);\n            let to = f.hazards.iter().find(|h| h.id == g.target).map(|h| h.touch_point()).unwrap_or(g.from);\n            let at = g.from.lerp(to, k);\n            scene.particles.push(ParticleBurst {\n                count: 4,\n                pos: on_tissue(at, 0.8),\n                vel: Vec3::ZERO,\n                spread: 0.3,\n                life: (0.2, 0.45),\n                size: (0.09, 0.0),\n                color0: Vec4::new(0.7, 0.95, 1.4, 0.9),\n                color1: Vec4::new(0.4, 0.7, 1.2, 0.0),\n                ..Default::default()\n            });\n        }\n    }\n    // Title: rain on the glass.\n    if f.stage == Stage::Title && tick {\n        scene.particles.push(ParticleBurst {\n            count: 5,\n            pos: Vec3::new(0.0, 12.0, 0.0),\n            area: Vec3::new(14.0, 0.2, 7.0),\n            vel: Vec3::new(-0.8, -7.0, 1.0),\n            spread: 0.2,\n            life: (0.9, 1.3),\n            size: (0.012, 0.009),\n            color0: Vec4::new(0.55, 0.7, 0.95, 0.45),\n            color1: Vec4::new(0.55, 0.7, 0.95, 0.0),\n            stretch: true,\n            ..Default::default()\n        });\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/mod.rs <<'EOF'\n//! Draws the surgery game from `SurgeryFrame`: the field, the instruments, the tray, the parasites,\n//! the paper theatre. Everything here is called at the end of `ViewBuilder::build`, so the game's\n//! lighting and post settings win over `ViewSettings`.\n\npub mod fx;\npub mod instruments;\npub mod paper;\npub mod plate;\npub mod strains;\n\nuse glam::{Quat, Vec2, Vec3};\nuse pav_core::frame::SimEvent;\nuse pav_core::games::surgery::field::{GHOST_TRAVEL, Tool};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::surgeon::tray_x;\nuse pav_render::scene::{DistortKind, Distortion, DynamicMesh, MeshInstance, MeshKey, Part, PointLight, Scene, Style, Transition, flags, srgb};\n\nuse crate::camera::CameraRig;\n\n/// Seat colours, in linear light.\npub fn seat_color(slot: usize) -> Vec3 {\n    let c: [(u8, u8, u8); 4] = [(232, 68, 58), (59, 130, 246), (34, 197, 94), (245, 183, 0)];\n    let (r, g, b) = c[slot.min(3)];\n    srgb(r, g, b)\n}\n\n/// What the player's settings and the app's local state say about drawing.\n#[derive(Clone, Copy, Debug)]\npub struct Local {\n    /// This device's cursor right now, per slot, ahead of the tick.\n    pub aim: [Option<Vec2>; 4],\n    pub clinical: bool,\n    pub shake: bool,\n    pub reduce_flashes: bool,\n    /// A full-screen fade: 0 clear .. 1 covered.\n    pub fade: f32,\n    /// The tray place under the pointer.\n    pub hover_tray: Option<usize>,\n    /// Drawing paused (hub server, or not at all).\n    pub skip: bool,\n}\n\nimpl Default for Local {\n    fn default() -> Self {\n        Self { aim: [None; 4], clinical: false, shake: true, reduce_flashes: false, fade: 0.0, hover_tray: None, skip: false }\n    }\n}\n\n#[derive(Default)]\npub struct SurgeryView {\n    pub plate: plate::PlateView,\n    pub paper: paper::PaperView,\n    pub local: Local,\n    pending: Vec<pav_render::scene::ParticleBurst>,\n    ripples: Vec<(Vec3, f32, DistortKind, f32)>,\n    last_beats: u32,\n    carry: f32,\n    last_time: f32,\n    /// Seconds the current flash has left (defib, for the white-out).\n    flash: f32,\n}\n\nimpl SurgeryView {\n    /// Cues become particles and distortions.\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        use pav_core::games::surgery::cue;\n        for e in events {\n            if let SimEvent::Cue { id, pos, .. } = e {\n                fx::cue_bursts(*id, *pos, &mut self.pending);\n                match *id {\n                    cue::GIFT_FIRE => self.ripples.push((*pos + Vec3::Y, 7.0, DistortKind::Ripple, 0.0)),\n                    cue::DEFIB_THUMP => {\n                        self.ripples.push((Vec3::new(0.0, 0.5, 0.0), 11.0, DistortKind::Ring, 0.0));\n                        self.flash = 1.0;\n                    }\n                    cue::PING => self.ripples.push((*pos + Vec3::Y * 0.2, 3.2, DistortKind::Ripple, 0.0)),\n                    cue::BURST => self.ripples.push((*pos + Vec3::Y * 0.4, 2.0, DistortKind::Ring, 0.0)),\n                    _ => {}\n                }\n            }\n        }\n    }\n\n    /// Adds this frame's game to the scene.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, rig: &CameraRig, aspect: f32, wall: f32) {\n        let time = f.clock;\n        let dt = (wall - self.last_time).clamp(0.0, 0.1);\n        self.last_time = wall;\n        scene.particles.append(&mut self.pending);\n        self.flash = (self.flash - dt * 2.5).max(0.0);\n        for r in &mut self.ripples {\n            r.3 += dt / 0.7;\n        }\n        self.ripples.retain(|r| r.3 < 1.0);\n        for r in &self.ripples {\n            scene.distortions.push(Distortion { pos: r.0, radius: r.1, strength: 0.25, kind: r.2, progress: r.3 });\n        }\n\n        if let (Stage::Story, Some(story)) = (f.stage, &f.story) {\n            if story.camera_or {\n                self.or_wide(scene);\n            } else {\n                // A little camera drift: real parallax between the layers.\n                let mut r = rig.clone();\n                r.params.yaw = (wall * 0.27).sin() * 0.7;\n                r.params.tilt = (wall * 0.19).sin() * 0.25;\n                scene.camera = r.data(aspect);\n                self.paper.emit(scene, story, wall, dt, f.beat);\n                if story.shake > 0.0 && self.local.shake {\n                    let mut r2 = r.clone();\n                    r2.target += Vec3::new((wall * 41.0).sin(), (wall * 37.0).cos(), 0.0) * story.shake * 0.12;\n                    scene.camera = r2.data(aspect);\n                }\n            }\n            self.finish(scene, f);\n            return;\n        }\n\n        // The field.\n        let sun = Vec3::new(-0.25, -1.0, -0.35).normalize();\n        scene.sun.direction = sun;\n        scene.sun.color = Vec3::new(1.0, 0.97, 0.9) * 0.42;\n        scene.sun.shadows = true;\n        scene.sun.shadow_center = Vec3::ZERO;\n        scene.sun.shadow_radius = 16.0;\n        scene.ambient.sky = Vec3::new(0.5, 0.5, 0.54);\n        scene.ambient.ground = Vec3::new(0.3, 0.22, 0.22);\n        scene.point_lights.push(PointLight { position: Vec3::new(-1.0, 7.0, -1.0), color: Vec3::new(1.0, 0.97, 0.9) * 0.9, radius: 16.0, shadows: true });\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.12;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.45;\n        scene.post.outline_px = 1.0;\n        scene.post.bloom = 0.35;\n        scene.post.bloom_threshold = 1.15;\n        scene.post.gi = 0.6;\n        scene.filter.vignette = 0.35;\n        scene.clear_color = srgb(16, 40, 44);\n\n        // Shake and punch.\n        if f.shake > 0.0 && self.local.shake {\n            let mut r = rig.clone();\n            let k = f.shake * f.shake * 0.28;\n            r.target += Vec3::new((wall * 47.0).sin(), 0.0, (wall * 39.0).cos()) * k;\n            scene.camera = r.data(aspect);\n        }\n\n        let opts = plate::PlateOpts { clinical: self.local.clinical };\n        if let Some(data) = self.plate.build(f, time, opts) {\n            scene.dynamic.push(DynamicMesh { data, color: Vec3::ONE, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 });\n        }\n        retractors(scene);\n        if !f.hazards.is_empty() || !f.stains.is_empty() {\n            strains::emit(scene, f, &self.plate, time);\n        }\n        let in_op = matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete | Stage::Results | Stage::Chart | Stage::Dead);\n        if in_op {\n            self.tray(scene, f, wall);\n        }\n        if matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete) {\n            self.hands(scene, f, wall);\n        }\n        fx::continuous(scene, f, &self.plate, time, dt, &mut self.last_beats, &mut self.carry);\n\n        // Gift and crisis looks.\n        let hush = f.hush.clamp(0.0, 1.0);\n        if hush > 0.0 {\n            scene.filter.grade_part = Part::Objects;\n            scene.filter.saturation = 1.0 - hush * 0.9;\n            scene.filter.vignette = 0.35 + hush * 0.35;\n            scene.point_lights.push(PointLight { position: Vec3::new(0.0, 5.0, 0.0), color: Vec3::new(0.7, 0.75, 1.0) * hush * 0.5, radius: 14.0, shadows: false });\n        }\n        if matches!(f.stage, Stage::Op | Stage::Code) {\n            let crisis = (1.0 - f.vitals / 30.0).clamp(0.0, 1.0);\n            if crisis > 0.0 {\n                let beat = if self.local.reduce_flashes { 0.5 } else { plate::beat_env(f.beat).min(1.0) };\n                scene.filter.chroma += crisis * (0.0015 + beat * 0.002);\n                scene.filter.vignette += crisis * 0.2 * (0.6 + 0.4 * beat);\n            }\n        }\n        if f.stage == Stage::Code {\n            scene.filter.saturation *= 0.45;\n        }\n        if f.plate_blend < 1.0 && !self.local.reduce_flashes {\n            // The iris closes on the incision, and opens on the next layer down.\n            let k = (f.plate_blend * std::f32::consts::PI).sin();\n            scene.filter.transition = k * 0.5;\n            scene.filter.transition_kind = Transition::Iris;\n            scene.filter.transition_center = crate::build::screen_uv(&scene.camera, Vec3::new(f.plate_from.x, 0.4, f.plate_from.y));\n        }\n        self.finish(scene, f);\n    }\n\n    /// The 3D wide shot: the engine draws the level; this only lights it.\n    fn or_wide(&self, scene: &mut Scene) {\n        scene.sun.direction = Vec3::new(-0.3, -1.0, -0.2).normalize();\n        scene.sun.color = Vec3::new(1.0, 0.98, 0.92) * 0.5;\n        scene.sun.shadow_center = Vec3::new(94.0, 0.0, -3.0);\n        scene.sun.shadow_radius = 16.0;\n        scene.ambient.sky = Vec3::new(0.46, 0.56, 0.58);\n        scene.ambient.ground = Vec3::new(0.28, 0.32, 0.32);\n        scene.point_lights.push(PointLight { position: Vec3::new(94.0, 3.6, -3.2), color: Vec3::new(1.0, 0.98, 0.9) * 2.6, radius: 11.0, shadows: true });\n        scene.clear_color = srgb(16, 40, 44);\n        scene.style.cel_bands = 3.0;\n        scene.post.outline_darken = 0.4;\n        scene.post.bloom = 0.4;\n        scene.post.gi = 0.5;\n        scene.filter.vignette = 0.45;\n        scene.post.halos = 0.4;\n    }\n\n    fn finish(&mut self, scene: &mut Scene, f: &SurgeryFrame) {\n        let fade = self.local.fade.clamp(0.0, 1.0);\n        if fade > scene.filter.transition {\n            scene.filter.transition = fade;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n        if f.stage == Stage::Dead {\n            scene.filter.transition = 1.0;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n    }\n\n    fn hands(&mut self, scene: &mut Scene, f: &SurgeryFrame, wall: f32) {\n        for s in &f.surgeons {\n            if !s.present {\n                continue;\n            }\n            let slot = s.slot as usize;\n            let seat = seat_color(slot);\n            // This device's cursor is ahead of the tick; the sim's rail and tremor stay on it.\n            let mut at = s.cursor;\n            if let Some(l) = self.local.aim[slot] {\n                at += l - s.raw;\n            }\n            let ground = self.plate.height_at(at);\n            let pose = instruments::Pose {\n                using: s.using,\n                amount: match s.tool {\n                    Tool::Iv => s.dose,\n                    Tool::Gel => 1.0 - s.flow,\n                    Tool::Defib => s.charge,\n                    _ => 0.0,\n                },\n                time: wall,\n                seat,\n                glow: 0.0,\n                group: 0x900 + slot as u32,\n                ghost: false,\n            };\n            let lean = Vec3::new(0.3, 1.0, 0.62).normalize();\n            let side = Vec3::new(1.0, 0.0, -0.3).normalize();\n            let recoil = s.kick * s.kick * 0.5;\n            let hover = if s.using { 0.03 } else { 0.42 + (wall * 2.1).sin() * 0.03 };\n            // The IV goes to its port; the paddles to the field's middle.\n            let (tip, axis, sd) = match s.tool {\n                Tool::Iv => {\n                    let d = Vec3::new(-0.5, 0.6, -0.3).normalize();\n                    (Vec3::new(8.3, 0.6, 3.9), d, Vec3::new(0.6, 0.0, -1.0).normalize())\n                }\n                Tool::Defib => (Vec3::new(0.0, 1.2 - s.charge * 0.5 + recoil, 0.3), lean, side),\n                _ => (Vec3::new(at.x, ground + hover + recoil, at.y), lean, side),\n            };\n            instruments::model(&mut scene.sdfs, s.tool, tip, axis, sd, 1.15, &pose);\n            // The laser's beam.\n            if s.tool == Tool::Laser && s.using {\n                scene.sdfs.push(pav_render::SdfInstance {\n                    a: tip,\n                    b: Vec3::new(at.x, ground, at.y),\n                    ra: 0.022,\n                    rb: 0.035,\n                    color: Vec3::new(1.0, 0.25, 0.15),\n                    emissive: 2.2,\n                    style: Style::Unlit,\n                    flags: flags::NO_SHADOW | flags::OBJECT,\n                    group: 0,\n                    material: 0,\n                });\n            }\n        }\n        // The Echo's ghost hands.\n        for g in &f.ghosts {\n            let k = (g.t / GHOST_TRAVEL).clamp(0.0, 1.0);\n            let to = f.hazards.iter().find(|h| h.id == g.target).map(|h| h.touch_point()).unwrap_or(g.from);\n            let at = g.from.lerp(to, k * k * (3.0 - 2.0 * k));\n            let pose = instruments::Pose { using: k > 0.7, time: wall, seat: Vec3::ONE, group: 0xA00, ghost: true, ..Default::default() };\n            let tip = Vec3::new(at.x, self.plate.height_at(at) + 0.2, at.y);\n            instruments::model(&mut scene.sdfs, g.tool, tip, Vec3::new(-0.3, 1.0, 0.62).normalize(), Vec3::new(1.0, 0.0, 0.3).normalize(), 1.15, &pose);\n        }\n    }\n\n    /// The steel tray in the scene: the selected instrument lifts and glows.\n    fn tray(&mut self, scene: &mut Scene, f: &SurgeryFrame, wall: f32) {\n        let steel = Vec3::new(0.46, 0.5, 0.54);\n        let half = Vec3::new(8.25, 0.1, 0.72);\n        let at = Vec3::new(0.0, 0.92, 5.42);\n        scene.meshes.push(MeshInstance {\n            mesh: MeshKey::rounded_box(half, 0.08),\n            transform: glam::Mat4::from_scale_rotation_translation(Vec3::ONE, Quat::IDENTITY, at),\n            color: steel,\n            emissive: 0.0,\n            style: Style::Lit,\n            flags: flags::OBJECT | flags::NO_CUT,\n            group: 0x880,\n            material: 0,\n            ext: half,\n        });\n        let local = f.surgeons.first();\n        let selected = local.map(|s| s.tool);\n        for (i, tool) in f.ring.iter().enumerate() {\n            let x = tray_x(i);\n            let sel = selected == Some(*tool);\n            let hover = self.local.hover_tray == Some(i);\n            let lift = if sel { 0.34 + (wall * 3.0).sin() * 0.02 } else if hover { 0.16 } else { 0.0 };\n            let glow = if sel { 1.0 } else { 0.0 };\n            let mut pose = instruments::Pose { using: false, time: wall, seat: seat_color(0), glow, group: 0x800 + i as u32, ..Default::default() };\n            if let Some(s) = local {\n                match tool {\n                    Tool::Gel => pose.amount = 1.0 - s.flow,\n                    Tool::Iv => pose.amount = (s.iv_cool / 4.0).clamp(0.0, 1.0),\n                    _ => {}\n                }\n            }\n            // Pointing up the screen: tip away from the viewer.\n            let tip = Vec3::new(x, 1.14 + lift, 4.86);\n            instruments::model(&mut scene.sdfs, *tool, tip, Vec3::new(0.0, 0.05, 1.0).normalize(), Vec3::X, 0.56, &pose);\n            if sel {\n                scene.point_lights.push(PointLight { position: tip + Vec3::new(0.0, 0.8, 0.5), color: Vec3::new(1.0, 0.95, 0.75) * 0.5, radius: 2.0, shadows: false });\n            }\n        }\n    }\n}\n\nfn retractors(scene: &mut Scene) {\n    let steel = Vec3::new(0.62, 0.66, 0.7);\n    for (a, b) in [\n        (Vec3::new(-9.5, 0.55, -5.1), Vec3::new(-8.0, 0.3, -4.5)),\n        (Vec3::new(9.5, 0.55, -5.1), Vec3::new(8.0, 0.3, -4.5)),\n        (Vec3::new(-9.9, 0.55, 3.7), Vec3::new(-8.8, 0.25, 3.2)),\n        (Vec3::new(9.9, 0.55, 3.7), Vec3::new(9.3, 0.3, 3.3)),\n    ] {\n        scene.sdfs.push(pav_render::SdfInstance { a, b, ra: 0.13, rb: 0.08, color: steel, emissive: 0.0, style: Style::Lit, flags: flags::OBJECT, group: 0x8F0, material: 0 });\n    }\n    // The IV port, on its stand at the corner of the field.\n    scene.sdfs.push(pav_render::SdfInstance {\n        a: Vec3::new(8.6, 0.55, 3.75),\n        b: Vec3::new(8.1, 0.55, 4.05),\n        ra: 0.13,\n        rb: 0.13,\n        color: Vec3::new(0.86, 0.9, 0.96),\n        emissive: 0.0,\n        style: Style::Lit,\n        flags: flags::OBJECT,\n        group: 0x8F1,\n        material: 0,\n    });\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_view/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod materials;\\n','pub mod materials;\\npub mod surgery;\\n')\nopen(p,'w').write(s)\np='crates/pav_view/src/build.rs'\ns=open(p).read()\ns=s.replace('''    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n''','''    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n    /// The surgery game's drawing state.\n    pub surgery: crate::surgery::SurgeryView,\n''')\ns=s.replace('''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n''','''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        self.surgery.add_events(events);\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/surgeon.rs'\ns=open(p).read()\ns=s.replace('''pub fn clamp(p: Vec2) -> Vec2 {''','''/// Where a ring place's instrument lies on the tray, in field x.\npub fn tray_x(place: usize) -> f32 {\n    -7.0 + 2.0 * place as f32\n}\n\n/// The tray place at a field point, if the point is on the tray.\npub fn tray_place(p: Vec2) -> Option<usize> {\n    if p.y < 4.72 {\n        return None;\n    }\n    let i = ((p.x + 8.0) / 2.0).floor();\n    (0.0..8.0).contains(&i).then_some(i as usize)\n}\n\npub fn clamp(p: Vec2) -> Vec2 {''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/bot.rs'\ns=open(p).read()\ns=s.replace('let threshold = 25.0 + 30.0 * skill;','let threshold = 30.0 + 35.0 * skill;')\nopen(p,'w').write(s)\nEOF\nsed -i '0,/vitals = -22/s//vitals = -45/' crates/pav_core/src/games/surgery/content/cases/case1.toml\ngrep -n \"        scene$\\|^        scene\\b\" crates/pav_view/src/build.rs | head; awk 'NR>1445 && /^    }$/ {print NR; exit}' crates/pav_view/src/build.rs","description":"Write hazards, paper theatre, effects and the view entry point"}}}
