s=1\nClinical palette                             files=4   hits=9\nreduce flashes                               files=5   hits=10\nscreen shake                                 files=2   hits=4\ntext speed                                   files=2   hits=6\nfullscreen                                   files=4   hits=11\ntremor setting                               files=1   hits=3\nAIHub.fail                                   files=1   hits=1\nControls screen                              files=1   hits=3\nbest rank saved                              files=1   hits=10\nHub awards Immaculate Hands                  files=1   hits=1\nHover highlight on field                     files=2   hits=9\nAIHub.rng card                               files=0   hits=0\nserver scenario                              files=2   hits=4\n--- content lint / tools\ncase_check                                   files=2   hits=4\n\"balance\"|fn balance                         files=2   hits=2\nsurgeon                                      files=2   hits=8\ncontent_text                                 files=1   hits=2\ntest: disk embedded                          files=2   hits=7\n--- rust test names\nthe_bot_wins_every_case() { the_bot_keeps_code_blue_alive() { the_whole_campaign_plays_through_and_covers_everything() { a_player_who_does_nothing_loses_every_case() { a_player_spamming_random_tools_loses_too() { snapshots_rewind_and_replays_are_exact() { forceps_rate_by_angle_and_tear_off_axis() { the_scalpel_rates_by_deviation_and_healthy_tissue_costs() { wrong_tool_clinks_and_resets_the_chain() { laser_rates_on_release_and_overheating_burns() { iv_green_band_heals_and_overdose_hurts() { on_beat_action_pays_more_and_chains_multiply() { a_code_needs_the_ghost_beat_and_retry_returns_to_the_checkpoint() { the_bot_lands_a_shock() { the_hush_slows_the_world_but_not_the_cursor() { the_echo_repeats_on_the_next_target_at_the_same_rating() { the_tremor_shakes_only_pets_hand_and_precision_stills_it() { slots_operate_independently_and_each_has_a_score() { a_snapshot_survives_the_wire_and_stays_small() { attract_loops_through_its_segments_with_nobody_at_the_table() { the_tune_table_resets_and_the_title_scene_builds() { an_unknown_scene_says_what_exists() { the_balance_targets_hold() { probe() { a_pad_with_aim_assist_can_finish_the_cases() { \nrun tick press music_defaults_to_ten_percent a_pad_walks_the_menus_and_prompts_follow_the_device hover_moves_the_focus_and_a_click_activates attract_starts_at_ten_seconds_and_any_input_exits touch_only_shows_the_message_and_a_settings_button_a_tap_can_use dev_sliders_apply_and_reset_and_the_default_is_kept about_shows_every_required_section_with_no_scrollbars a_save_round_trips_and_best_rank_holds every_screen_draws_without_a_panic_on_every_stage \n--- stories\n257\n--- source-world leaks\n\"\"\"Shared browser helpers: Chromium with software WebGPU, stand-ins for a pad and for ears.\"\"\"\nimport json\nimport pathlib\nimport time\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nGAME = ROOT / \"out\" / \"game.html\"\nOUT = ROOT / \"out\"\nOUT.mkdir(exist_ok=True)\nARGS = [\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--use-vulkan=swiftshader\", \"--use-angle=swiftshader\"]\n\nPAD = \"\"\"\n(() => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\n  const pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true,\n               mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons,\n               vibrationActuator: {playEffect: (...a) => { window.__rumbled = (window.__rumbled||0)+1; return Promise.resolve('complete'); }}};\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null];\n  window.__padHit = (i, v) => { pad.buttons[i].pressed = v > 0; pad.buttons[i].touched = v > 0; pad.buttons[i].value = v; pad.timestamp++; };\n  window.__padAxis = (i, v) => { pad.axes[i] = v; pad.timestamp++; };\n})();\n\"\"\"\n\nTAP = \"\"\"\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\n    return r; };\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\n\"\"\"\n\n\ndef wait_for_memory(gb=2.5, timeout=240):\n    \"\"\"Other agents share this machine, and the OOM killer ends the biggest browser.\"\"\"\n    end = time.time() + timeout\n    while time.time() < end:\n        for line in open(\"/proc/meminfo\"):\n            if line.startswith(\"MemAvailable\"):\n                if int(line.split()[1]) > gb * 1024 * 1024:\n                    return\n        time.sleep(3)\n\n\nCRASHED = (\"Target crashed\", \"Target closed\", \"has been closed\", \"ERR_ABORTED\", \"crashed\", \"Browser closed\")\n\n\ndef open_game(browser, width=960, height=540, pad=False, tap=False, query=\"\", storage=None, **ctx):\n    context = browser.new_context(viewport={\"width\": width, \"height\": height}, **ctx)\n    if pad:\n        context.add_init_script(PAD)\n    if tap:\n        context.add_init_script(TAP)\n    if storage is not None:\n        context.add_init_script(f\"localStorage.setItem('surgery-save', {json.dumps(storage)});\")\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda e: errors.append(str(e)))","is_error":false}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"5416ee21-33db-451d-b1ec-307271effa6a","timestamp":"2026-11-05T19:12:48.630Z","tool_use_result":{"std