e('''    if t >= stamp_at {\n        let k = ((t - stamp_at) / 0.14).clamp(0.0, 1.0);''','''    if t >= stamp_at {\n        if !shell.stamped {\n            shell.stamped = true;\n            shell.cue(cue::STAMP);\n        }\n        let k = ((t - stamp_at) / 0.14).clamp(0.0, 1.0);''')\ns=s.replace('''    if case_files {\n        shell.load(\"surgery/title\");\n        shell.go(Screen::CaseFiles);\n        return;\n    }''','''    if case_files {\n        let back = if shell.scene.contains(\"codeblue\") { Screen::Menu } else { Screen::CaseFiles };\n        shell.load(\"surgery/title\");\n        shell.go(back);\n        return;\n    }''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/hud.rs'\ns=open(p).read()\ns=s.replace('''    // Pings from the Scanner.\n    for (at, t) in &f.pings {''','''    // Dev overlays.\n    if f.overlays != 0 {\n        for h in &f.hazards {\n            let c = pr.field(h.touch_point());\n            let u = pr.scale(h.pos);\n            if f.overlays & 1 != 0 {\n                p.circle_stroke(pr.field(h.pos), h.r * u, Stroke::new(2.0, Color32::from_rgb(255, 90, 200)));\n            }\n            if f.overlays & 2 != 0 {\n                if let Some(t) = h.wants() {\n                    style::outlined(p, c + vec2(0.0, 24.0), Align2::CENTER_CENTER, t.name(), 26.0, Color32::from_rgb(255, 170, 240));\n                }\n            }\n            if f.overlays & 8 != 0 && h.accepts(tool) {\n                p.circle_stroke(c, 1.2 * u, Stroke::new(1.5, Color32::from_rgb(120, 200, 255)));\n            }\n        }\n        if f.overlays & 4 != 0 {\n            // The on-beat window, around the R wave.\n            let r = Rect::from_min_size(pr.rect.left_top() + vec2(520.0, 100.0), vec2(600.0, 16.0));\n            p.rect_filled(r, 2.0, Color32::from_black_alpha(180));\n            let w = 0.11 / (60.0 / f.bpm.max(20.0));\n            p.rect_filled(Rect::from_min_size(r.min, vec2(600.0 * w, 16.0)), 2.0, GREEN);\n            p.rect_filled(Rect::from_min_size(r.right_top() - vec2(600.0 * w, 0.0), vec2(600.0 * w, 16.0)), 2.0, GREEN);\n            let x = r.min.x + 600.0 * f.beat;\n            p.line_segment([pos2(x, r.min.y - 3.0), pos2(x, r.max.y + 3.0)], Stroke::new(3.0, Color32::WHITE));\n        }\n    }\n    // Pings from the Scanner.\n    for (at, t) in &f.pings {''')\ns=s.replace('''    if matches!(f.stage, Stage::Title | Stage::Card) {\n        return;\n    }\n    let time = f.clock;''','''    if matches!(f.stage, Stage::Title | Stage::Card) {\n        return;\n    }\n    let time = f.clock;\n    let _ = &shell.hud.stamp_t;''')\nopen(p,'w').write(s)\n# --- app\np='crates/pav_app/src/product.rs'\ns=open(p).read()\ns=s.replace('''        let assist = settings.aim_assist;\n        let speed = settings.cursor_speed;\n''','''        use pav_core::games::surgery::tune;\n        let assist = settings.aim_assist * p.shell.dev.tune.get(tune::AIM_ASSIST);\n        let speed = settings.cursor_speed * p.shell.dev.tune.get(tune::CURSOR_SPEED) / tune::SLIDERS[tune::CURSOR_SPEED].default;\n''')\ns=s.replace('''        let tune = p.shell.dev.tune.clone();\n        let Some(host) = &self.host else { return };\n        let mut q = host.shared.surgery_cmds.lock().unwrap();\n        q.push_back(SurgeryCmd::Difficulty(d));''','''        let tune = p.shell.dev.tune.clone();\n        let joined: Vec<u8> = p.pad_slot.iter().filter(|(_, s)| *s > 0).map(|(_, s)| *s as u8).collect();\n        let Some(host) = &self.host else { return };\n        let mut q = host.shared.surgery_cmds.lock().unwrap();\n        for slot in joined {\n            q.push_back(SurgeryCmd::Join { slot });\n        }\n        q.push_back(SurgeryCmd::Difficulty(d));''')\nopen(p,'w').write(s)\n# Story: one more wide shot\np='crates/pav_core/src/games/surgery/content/story/case1_before.toml'\ns=open(p).read()\ns=s.replace('''[[line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Because I am in it, Dr. Quill.\"''','''[[line]]\ncamera = \"or\"\n[[line]]\nwho = \"voss\"\nexpr = \"stern\"\ntext = \"Because I am in it, Dr. Quill.\"\n[[line]]\ncamera = \"paper\"''',1)\nopen(p,'w').write(s)\nEOF\ngrep -n 'camera' crates/pav_core/src/games/surgery/content/story/case1_before.toml | head; ./target/debug/pav assets find=stool 2>/dev/null | head -c 300; echo; ./target/debug/pav assets find=cabinet 2>/dev/null | head -c 300; echo; sed -n 1,30p crates/pav_core/src/games/starter.toml >/dev/null; grep -n \"\\[\\[object\\]\\]\" -A5 rooms/*.toml | grep -m3 -A5 \"asset\" | cut -c1-120 | head -14","description":"Apply the session, overlay, attract and sound fixes, and look up library props"}}}
