{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjvpMV2duxCjVZBcNYpE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RESAnDs2TWCxHb6kmJMQEH","name":"Bash","input":{"command":"cat > crates/pav_ui/src/surgery/hud.rs <<'EOF'\n//! The operation HUD: heart and vitals, the live ECG, the countdown, the tray's labels, the gift\n//! meter, the speaker cameo, the NOW line, and everything anchored to the field.\n\nuse std::f32::consts::TAU;\n\nuse egui::epaint::{Mesh, Vertex};\nuse egui::{Align2, Color32, Painter, Pos2, Rect, Stroke, StrokeKind, pos2, vec2};\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::field::{HazardKind as K, Rating, Tool, polyline_at};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::surgeon::tray_x;\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, DIM, GOLD, GREEN, INK, RED, SEATS, TEAL};\nuse super::{Shell, ShellInput};\nuse crate::Device;\n\n/// The trace's memory: value per sample.\n#[derive(Default)]\npub struct HudState {\n    trace: Vec<(f32, f32)>,\n    clock: f32,\n    last_time: f32,\n    pub stamp_t: f32,\n    pub stats: String,\n}\n\n/// One beat of ECG: P, QRS, T. Phase 0 is the R wave.\npub fn ecg_wave(phase: f32) -> f32 {\n    let g = |c: f32, w: f32, x: f32| (-(x - c) * (x - c) / w).exp();\n    let x = phase;\n    let x2 = if x > 0.5 { x - 1.0 } else { x };\n    g(0.0, 0.00022, x2) * 1.0 - g(-0.03, 0.0002, x2) * 0.14 - g(0.035, 0.0003, x2) * 0.26 + g(0.26, 0.0028, x2) * 0.26 + g(-0.18, 0.0014, x2) * 0.13\n}\n\npub struct Projector {\n    pub vp: Mat4,\n    pub rect: Rect,\n}\n\nimpl Projector {\n    pub fn at(&self, p: Vec3) -> Pos2 {\n        let c = self.vp.project_point3(p);\n        pos2(self.rect.min.x + (c.x * 0.5 + 0.5) * self.rect.width(), self.rect.min.y + (0.5 - c.y * 0.5) * self.rect.height())\n    }\n    pub fn field(&self, p: Vec2) -> Pos2 {\n        self.at(Vec3::new(p.x, 0.55, p.y))\n    }\n    /// About how many points one field unit is across here.\n    pub fn scale(&self, p: Vec2) -> f32 {\n        self.field(p).distance(self.field(p + Vec2::X))\n    }\n}\n\nfn rating_color(r: Rating) -> Color32 {\n    match r {\n        Rating::Immaculate => Color32::from_rgb(255, 224, 110),\n        Rating::Clean => Color32::from_rgb(120, 236, 200),\n        Rating::Good => Color32::from_rgb(190, 214, 230),\n        Rating::Sloppy => Color32::from_rgb(232, 110, 90),\n    }\n}\n\n/// A gauge ring around a screen point.\nfn arc(p: &Painter, c: Pos2, r: f32, from: f32, to: f32, w: f32, color: Color32) {\n    let n = (((to - from) * 40.0).ceil() as usize).clamp(2, 64);\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let a = -std::f32::consts::FRAC_PI_2 + (from + (to - from) * k as f32 / n as f32) * TAU;\n            c + vec2(a.cos(), a.sin()) * r\n        })\n        .collect();\n    p.add(egui::Shape::line(pts, Stroke::new(w, color)));\n}\n\nfn dashed(p: &Painter, pr: &Projector, pts: &[Vec2], from: f32, color: Color32, time: f32) {\n    let len: f32 = pts.windows(2).map(|w| w[0].distance(w[1])).sum();\n    let mut s = from;\n    let dash = 0.3;\n    let shift = (time * 0.6).fract() * dash * 2.0;\n    s += shift.min((len - s).max(0.0));\n    while s < len {\n        let a = polyline_at(pts, s).0;\n        let b = polyline_at(pts, (s + dash).min(len)).0;\n        p.line_segment([pr.field(a), pr.field(b)], Stroke::new(7.0, Color32::from_black_alpha(150)));\n        p.line_segment([pr.field(a), pr.field(b)], Stroke::new(3.5, color));\n        s += dash * 2.0;\n    }\n}\n\nfn arrow(p: &Painter, from: Pos2, to: Pos2, color: Color32, w: f32) {\n    let d = (to - from).normalized();\n    let n = vec2(-d.y, d.x);\n    for (a, b) in [(from, to), (to, to - d * 14.0 + n * 9.0), (to, to - d * 14.0 - n * 9.0)] {\n        p.line_segment([a, b], Stroke::new(w + 3.0, Color32::from_black_alpha(160)));\n    }\n    for (a, b) in [(from, to), (to, to - d * 14.0 + n * 9.0), (to, to - d * 14.0 - n * 9.0)] {\n        p.line_segment([a, b], Stroke::new(w, color));\n    }\n}\n\n/// A red edge that pulses on the beat.\nfn vignette(p: &Painter, rect: Rect, color: Color32, a: f32, depth: f32) {\n    if a <= 0.0 {\n        return;\n    }\n    let mut m = Mesh::default();\n    let edge = style::with_alpha(color, a);\n    let clear = style::with_alpha(color, 0.0);\n    let mut quad = |p0: Pos2, p1: Pos2, p2: Pos2, p3: Pos2, c0: Color32, c1: Color32| {\n        let b = m.vertices.len() as u32;\n        for (q, c) in [(p0, c0), (p1, c0), (p2, c1), (p3, c1)] {\n            m.vertices.push(Vertex { pos: q, uv: egui::epaint::WHITE_UV, color: c });\n        }\n        m.indices.extend_from_slice(&[b, b + 1, b + 2, b, b + 2, b + 3]);\n    };\n    let (a0, b0) = (rect.min, rect.max);\n    let d = depth;\n    quad(a0, pos2(b0.x, a0.y), pos2(b0.x, a0.y + d), pos2(a0.x, a0.y + d), edge, clear);\n    quad(pos2(a0.x, b0.y), b0, pos2(b0.x, b0.y - d), pos2(a0.x, b0.y - d), edge, clear);\n    quad(a0, pos2(a0.x, b0.y), pos2(a0.x + d, b0.y), pos2(a0.x + d, a0.y), edge, clear);\n    quad(pos2(b0.x, a0.y), b0, pos2(b0.x - d, b0.y), pos2(b0.x - d, a0.y), edge, clear);\n    p.add(m);\n}\n\npub fn draw(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, vp: Mat4, i: &ShellInput) {\n    let pr = Projector { vp, rect };\n    if matches!(f.stage, Stage::Title | Stage::Card) {\n        return;\n    }\n    let time = f.clock;\n    field_marks(shell, p, &pr, f, time, i);\n    popups(p, &pr, f);\n    hud_top(shell, p, rect, f, i.dt);\n    tray_labels(shell, p, &pr, rect, f);\n    cameo_line(shell, p, rect, f);\n    if f.fever.is_some() || f.ring_in > 0 || f.heat_ring.is_some() {\n        fever(p, rect, f);\n    }\n    // Low vitals: a red edge on the beat.\n    let low = (1.0 - f.vitals / 30.0).clamp(0.0, 1.0);\n    if low > 0.0 && matches!(f.stage, Stage::Op | Stage::Code) {\n        let beat = (-f.beat * 5.0).exp();\n        let k = if shell.save.settings.reduce_flashes { 0.5 } else { beat };\n        vignette(p, rect, RED, low * (0.25 + 0.55 * k), 240.0);\n    }\n    if f.hush > 0.0 {\n        vignette(p, rect, Color32::from_rgb(170, 190, 255), f.hush * 0.28, 300.0);\n        if f.hush > 0.5 {\n            style::outlined(p, rect.center_top() + vec2(0.0, 196.0), Align2::CENTER_CENTER, if f.duet { \"THE DUET\" } else { \"THE HUSH\" }, 48.0, style::with_alpha(Color32::WHITE, f.hush));\n        }\n    }\n    if f.echo > 0.5 && f.hush <= 0.5 {\n        style::outlined(p, rect.center_top() + vec2(0.0, 196.0), Align2::CENTER_CENTER, \"THE ECHO\", 48.0, style::with_alpha(Color32::from_rgb(160, 220, 255), f.echo));\n    }\n    if let Some(c) = &f.code {\n        code(shell, p, rect, f, c);\n    }\n    if let Some((text, age)) = &f.banner {\n        banner(p, rect, text, *age);\n    }\n    if shell.chart_open {\n        chart_overlay(shell, p, rect, f);\n    }\n    if i.chart && matches!(f.stage, Stage::Op | Stage::OpStart) {\n        shell.chart_open = !shell.chart_open;\n    }\n}\n\nfn field_marks(shell: &mut Shell, p: &Painter, pr: &Projector, f: &SurgeryFrame, time: f32, i: &ShellInput) {\n    let tool = f.surgeons.first().map(|s| s.tool).unwrap_or(Tool::Scalpel);\n    let hover = i.pointer.filter(|_| shell.device == Device::KeyboardMouse);\n    for h in &f.hazards {\n        if h.hidden && h.reveal <= 0.0 {\n            continue;\n        }\n        let c = pr.field(h.touch_point());\n        let u = pr.scale(h.pos).max(20.0);\n        let valid = h.accepts(tool);\n        let guide = f.guide == h.id;\n        let hovered = hover.is_some_and(|q| q.distance(c) < (h.r * u + 26.0));\n        match h.kind {\n            K::Incision | K::Tether | K::Closure => {\n                let color = if h.kind == K::Tether {\n                    Color32::from_rgb(210, 170, 255)\n                } else if h.kind == K::Closure {\n                    Color32::from_rgb(240, 240, 220)\n                } else {\n                    Color32::from_rgb(250, 250, 250)\n                };\n                if h.kind != K::Tether {\n                    dashed(p, pr, &h.pts, h.progress, color, time);\n                }\n                // Where the stroke starts, or resumes.\n                let pulse = (time * 5.0).sin() * 0.2 + 0.8;\n                p.circle_stroke(c, 12.0 + 3.0 * pulse, Stroke::new(3.5, style::with_alpha(color, pulse)));\n                if h.life > 0.0 {\n                    // A stroke with a deadline: the ring closes on it.\n                    let frac = (h.life / 3.0).clamp(0.0, 1.0);\n                    arc(p, c, 22.0, 0.0, frac, 4.0, GOLD);\n                }\n            }\n            K::Laceration | K::Bleeder => {\n                if tool == Tool::Suture || guide {\n                    let len: f32 = h.pts.windows(2).map(|w| w[0].distance(w[1])).sum();\n                    if h.progress < len {\n                        let (n, t) = polyline_at(&h.pts, h.progress);\n                        let side = Vec2::new(-t.y, t.x) * 0.5;\n                        let (a, b) = (pr.field(n + side), pr.field(n - side));\n                        p.line_segment([a, b], Stroke::new(3.0, style::with_alpha(TEAL, 0.9)));\n                        p.circle_filled(pr.field(n), 5.0, TEAL);\n                    }\n                }\n            }\n            K::Foreign | K::Tumor | K::Nodule | K::Eye | K::Furnace if h.accepts(Tool::Forceps) => {\n                if tool == Tool::Forceps || guide {\n                    let d = Vec2::from_angle(h.axis);\n                    let from = pr.field(h.pos + d * (h.r + 0.2));\n                    let to = pr.field(h.pos + d * (h.r + 1.1));\n                    arrow(p, from, to, GOLD, 4.0);\n                }\n                if h.kind == K::Nodule && h.life > 0.0 {\n                    let frac = (h.life / 1.6).clamp(0.0, 1.0);\n                    arc(p, c, h.r * u + 16.0, 0.0, frac, 5.0, RED);\n                }\n            }\n            K::Bone => {\n                if h.stage == 0 {\n                    // The home it wants: a ghost of the fragment at the right angle.\n                    let d = Vec2::from_angle(h.axis) * 0.9;\n                    let (a, b) = (pr.field(h.to - d), pr.field(h.to + d));\n                    p.line_segment([a, b], Stroke::new(14.0, Color32::from_rgba_unmultiplied(255, 255, 255, 60)));\n                    p.circle_stroke(pr.field(h.to), 0.35 * u, Stroke::new(2.5, style::with_alpha(GREEN, 0.8)));\n                    if h.by != 0 {\n                        let off = pav_core::games::surgery::field::angle_diff(h.angle, h.axis).to_degrees();\n                        let txt = format!(\"{off:+.0}°\");\n                        style::outlined(p, c + vec2(40.0, -40.0), Align2::LEFT_CENTER, &txt, 36.0, if off.abs() < 12.0 { GREEN } else { GOLD });\n                        shell_rotate_hint(shell, p, c + vec2(40.0, 0.0));\n                    }\n                }\n            }\n            _ => {}\n        }\n        // Rings: laser and probe heat, with the green band.\n        let heat_like = matches!(h.kind, K::Polyp | K::Ember | K::Nodule | K::Sac | K::Furnace);\n        if heat_like && h.heat > 0.01 && h.count == 0 {\n            let r = (h.r * u).max(26.0) + 16.0;\n            let frost = h.kind == K::Ember || (h.kind == K::Furnace && h.stage == 0);\n            p.circle_stroke(c, r, Stroke::new(8.0, Color32::from_black_alpha(150)));\n            arc(p, c, r, 0.0, 0.77, 7.0, Color32::from_gray(70));\n            arc(p, c, r, 0.615, 0.77, 7.0, GREEN);\n            let fill = (h.heat / 1.3).clamp(0.0, 1.0);\n            let col = if h.heat > 1.0 {\n                RED\n            } else if frost {\n                Color32::from_rgb(150, 220, 255)\n            } else {\n                Color32::from_rgb(255, 170, 70)\n            };\n            arc(p, c, r, 0.0, fill, 7.0, col);\n        }\n        // Gel coverage.\n        if h.accepts(Tool::Gel) {\n            let r = (h.r * u).max(20.0) + 10.0;\n            if h.progress > 0.0 {\n                arc(p, pr.field(h.pos), r, 0.0, h.progress.clamp(0.0, 1.0), 6.0, Color32::from_rgb(120, 240, 200));\n            }\n        }\n        // A sac swelling to burst.\n        if h.kind == K::Sac && h.progress > 0.62 {\n            let r = h.r * u + 10.0;\n            p.circle_stroke(pr.field(h.pos), r, Stroke::new(3.0, style::with_alpha(RED, (h.progress - 0.6) * 2.0)));\n        }\n        // Scanner: how long what it found stays lit.\n        if h.hidden && h.reveal > 0.0 {\n            arc(p, pr.field(h.pos), h.r * u + 18.0, 0.0, (h.reveal / 8.0).clamp(0.0, 1.0), 3.5, Color32::from_rgb(120, 220, 255));\n        }\n        if guide || (hovered && valid) || (valid && h.required && f.guided) {\n            let pulse = (time * 6.0).sin() * 0.25 + 0.75;\n            let r = (h.r * u).max(18.0) + 8.0 + pulse * 6.0;\n            let col = if guide { GOLD } else { Color32::WHITE };\n            let target = if h.kind == K::Bleeder { pr.field(h.pos) } else { c };\n            p.circle_stroke(target, r, Stroke::new(3.0, style::with_alpha(col, pulse)));\n        }\n    }\n    // Pings from the Scanner.\n    for (at, t) in &f.pings {\n        let k = (t / 0.8).clamp(0.0, 1.0);\n        let c = pr.field(*at);\n        let u = pr.scale(*at);\n        p.circle_stroke(c, k * 3.2 * u, Stroke::new(3.0, style::with_alpha(Color32::from_rgb(120, 220, 255), 1.0 - k)));\n    }\n    // Cursors: a small reticle, and names in co-op.\n    let many = f.surgeons.iter().filter(|s| s.present).count() > 1;\n    for s in &f.surgeons {\n        if !s.present || matches!(f.stage, Stage::Results | Stage::Dead) {\n            continue;\n        }\n        let at = pr.field(s.cursor);\n        let col = SEATS[s.slot as usize % 4];\n        p.circle_stroke(at, 10.0, Stroke::new(3.0, Color32::from_black_alpha(170)));\n        p.circle_stroke(at, 10.0, Stroke::new(2.0, col));\n        if s.chain >= 2 {\n            style::outlined(p, at + vec2(18.0, -26.0), Align2::LEFT_CENTER, &format!(\"{}×\", s.chain), 34.0, GOLD);\n        }\n        if many {\n            style::outlined(p, at + vec2(18.0, 20.0), Align2::LEFT_CENTER, &s.name, 28.0, col);\n        }\n        if s.tool == Tool::Gel {\n            let r = Rect::from_min_size(at + vec2(-24.0, 20.0), vec2(48.0, 7.0));\n            p.rect_filled(r, 3.0, Color32::from_black_alpha(170));\n            p.rect_filled(Rect::from_min_size(r.min, vec2(48.0 * s.flow.clamp(0.0, 1.0), 7.0)), 3.0, Color32::from_rgb(120, 240, 200));\n        }\n        if s.tool == Tool::Iv && (s.iv_on || s.iv_cool > 0.0) {\n            iv_gauge(p, pr, s);\n        }\n    }\n    // The Dies Irae's sweep: a big warning.\n    if let Some(r) = f.heat_ring {\n        let c = pr.field(Vec2::new(0.0, 0.2));\n        let u = pr.scale(Vec2::ZERO);\n        p.circle_stroke(c, r * u, Stroke::new(5.0, Color32::from_rgb(255, 170, 70)));\n    }\n}\n\nfn shell_rotate_hint(shell: &mut Shell, p: &Painter, at: Pos2) {\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Rotate);\n    glyphs::draw(p, at, 34.0, g, Action::Rotate);\n}\n\nfn iv_gauge(p: &Painter, pr: &Projector, s: &pav_core::games::surgery::frame::SurgeonView) {\n    let c = pr.field(Vec2::new(8.3, 3.9));\n    let r = Rect::from_min_size(c + vec2(-100.0, -86.0), vec2(200.0, 22.0));\n    p.rect_filled(r, 6.0, Color32::from_black_alpha(190));\n    // The green band: 75 to 100% of a dose.\n    let w = r.width() / 1.25;\n    p.rect_filled(Rect::from_min_size(r.min + vec2(w * 0.75, 0.0), vec2(w * 0.25, 22.0)), 2.0, style::with_alpha(GREEN, 0.7));\n    let col = if s.dose > 1.0 { RED } else { Color32::WHITE };\n    p.rect_filled(Rect::from_min_size(r.min, vec2(w * s.dose.clamp(0.0, 1.25), 22.0)), 4.0, style::with_alpha(col, 0.72));\n    if s.iv_cool > 0.0 && !s.iv_on {\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, &format!(\"{:.0}\", s.iv_cool.ceil()), 26.0, DIM);\n    } else {\n        style::outlined(p, r.center_top() - vec2(0.0, 18.0), Align2::CENTER_CENTER, \"IV\", 28.0, INK);\n    }\n}\n\nfn popups(p: &Painter, pr: &Projector, f: &SurgeryFrame) {\n    for q in &f.popups {\n        let at = pr.field(q.pos) + vec2(0.0, -40.0 - q.age * 70.0);\n        let a = (1.3 - q.age).clamp(0.0, 1.0);\n        let punch = 1.0 + ((0.12 - q.age).max(0.0) / 0.12) * 0.4;\n        let size = if q.rating == Rating::Immaculate { 58.0 } else { 46.0 } * punch;\n        style::outlined(p, at, Align2::CENTER_CENTER, q.rating.word(), size, style::with_alpha(rating_color(q.rating), a));\n        if q.on_beat {\n            style::outlined(p, at + vec2(0.0, 44.0), Align2::CENTER_CENTER, \"ON BEAT\", 34.0, style::with_alpha(Color32::from_rgb(140, 255, 220), a));\n        }\n        if q.points > 0 {\n            style::outlined(p, at + vec2(0.0, -40.0), Align2::CENTER_CENTER, &format!(\"+{}\", q.points), 30.0, style::with_alpha(INK, a));\n        }\n    }\n}\n\nfn hud_top(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, dt: f32) {\n    // Backing strip.\n    let strip = Rect::from_min_size(rect.min, vec2(rect.width(), 104.0));\n    p.rect_filled(strip, 0.0, Color32::from_rgba_unmultiplied(4, 14, 18, 190));\n    // Heart, pulsing on the beat, and the big number.\n    let beat = if f.flat { 0.0 } else { (-f.beat * 6.0).exp() };\n    let hc = rect.min + vec2(62.0, 52.0);\n    let s = 24.0 + beat * 7.0;\n    let color = if f.vitals < 25.0 { RED } else { Color32::from_rgb(240, 90, 90) };\n    heart(p, hc, s, color);\n    let v = f.vitals.max(0.0).ceil() as i32;\n    style::outlined(p, hc + vec2(48.0, -2.0), Align2::LEFT_CENTER, &format!(\"{v}\"), 76.0, if f.vitals < 25.0 { RED } else { Color32::WHITE });\n    let bar = Rect::from_min_size(rect.min + vec2(204.0, 34.0), vec2(290.0, 36.0));\n    p.rect_filled(bar, 8.0, Color32::from_black_alpha(190));\n    let frac = (f.vitals / f.vitals_max.max(1.0)).clamp(0.0, 1.0);\n    let bar_col = if f.vitals < 25.0 {\n        RED\n    } else if f.vitals < 50.0 {\n        GOLD\n    } else {\n        GREEN\n    };\n    p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * frac, 36.0)), 8.0, bar_col);\n    p.rect_stroke(bar, 8.0, Stroke::new(2.0, Color32::from_white_alpha(70)), StrokeKind::Inside);\n    // The ECG: a live sweep; samples in, oldest out.\n    ecg(shell, p, Rect::from_min_size(rect.min + vec2(520.0, 8.0), vec2(rect.width() - 520.0 - 280.0, 88.0)), f, dt);\n    // The countdown.\n    let t = f.timer.max(0.0);\n    let txt = format!(\"{}:{:02}\", (t / 60.0) as i32, (t as i32) % 60);\n    let low = t < 30.0;\n    style::outlined(p, rect.right_top() + vec2(-40.0, 52.0), Align2::RIGHT_CENTER, &txt, 76.0, if low { RED } else { Color32::WHITE });\n    // NOW: the one objective line.\n    if matches!(f.stage, Stage::Op | Stage::OpStart) && !f.objective.is_empty() {\n        let g = shell.glyphs();\n        let c = rect.center_top() + vec2(0.0, 134.0);\n        let w = (f.objective.chars().count() as f32 * 15.5 + 110.0).min(rect.width() - 200.0);\n        let r = Rect::from_center_size(c, vec2(w, 48.0));\n        p.rect_filled(r, 8.0, Color32::from_rgba_unmultiplied(4, 14, 18, 170));\n        style::outlined(p, r.left_center() + vec2(16.0, 0.0), Align2::LEFT_CENTER, \"NOW\", 34.0, GOLD);\n        style::outlined(p, r.left_center() + vec2(84.0, 0.0), Align2::LEFT_CENTER, &f.objective, 34.0, Color32::WHITE);\n        let _ = g;\n    }\n}\n\nfn heart(p: &Painter, c: Pos2, s: f32, color: Color32) {\n    p.circle_filled(c + vec2(-s * 0.45, -s * 0.28), s * 0.56, color);\n    p.circle_filled(c + vec2(s * 0.45, -s * 0.28), s * 0.56, color);\n    p.add(egui::Shape::convex_polygon(\n        vec![c + vec2(-s * 0.96, -s * 0.12), c + vec2(s * 0.96, -s * 0.12), c + vec2(0.0, s * 0.96)],\n        color,\n        Stroke::NONE,\n    ));\n}\n\nfn ecg(shell: &mut Shell, p: &Painter, r: Rect, f: &SurgeryFrame, dt: f32) {\n    let h = &mut shell.hud;\n    if f.clock < h.last_time {\n        h.trace.clear();\n    }\n    h.last_time = f.clock;\n    h.clock += dt.max(0.0);\n    let value = if f.flat { 0.0 } else { ecg_wave(f.beat) };\n    // In a strain's meter the accent beat runs tall: the eye can count it.\n    let accent = if f.meter > 0 && f.bar_beat == 0 { 1.22 } else { 1.0 };\n    h.trace.push((h.clock, value * accent));\n    let span = 3.2;\n    let cut = h.clock - span;\n    if h.trace.first().is_some_and(|s| s.0 < cut) {\n        let keep = h.trace.partition_point(|s| s.0 < cut);\n        h.trace.drain(..keep);\n    }\n    p.rect_filled(r, 8.0, Color32::from_rgba_unmultiplied(0, 24, 18, 200));\n    // Grid.\n    for k in 1..8 {\n        let x = r.min.x + r.width() * k as f32 / 8.0;\n        p.line_segment([pos2(x, r.min.y), pos2(x, r.max.y)], Stroke::new(1.0, Color32::from_rgba_unmultiplied(70, 180, 120, 26)));\n    }\n    let mid = r.center().y + r.height() * 0.18;\n    let amp = r.height() * 0.58;\n    let color = if f.flat { Color32::from_rgb(230, 80, 70) } else { GREEN };\n    let pts: Vec<Pos2> = h\n        .trace\n        .iter()\n        .map(|(t, v)| pos2(r.max.x - (h.clock - t) / span * r.width(), mid - v * amp))\n        .collect();\n    if pts.len() >= 2 {\n        p.add(egui::Shape::line(pts.clone(), Stroke::new(7.0, Color32::from_rgba_unmultiplied(60, 240, 150, 40))));\n        p.add(egui::Shape::line(pts, Stroke::new(3.0, color)));\n    }\n    // The bpm and the meter.\n    let label = if f.meter > 0 { format!(\"{} bpm · {}/{}\", f.bpm.round(), f.meter, if f.meter == 6 || f.meter == 7 { 8 } else { 4 }) } else { format!(\"{} bpm\", f.bpm.round()) };\n    style::outlined(p, r.left_top() + vec2(10.0, 24.0), Align2::LEFT_CENTER, &label, 32.0, if f.meter > 0 { GOLD } else { INK });\n}\n\nfn tray_labels(shell: &mut Shell, p: &Painter, pr: &Projector, rect: Rect, f: &SurgeryFrame) {\n    if !matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete) {\n        return;\n    }\n    let g = shell.glyphs();\n    let selected = f.surgeons.first().map(|s| s.tool);\n    let dirs: [Vec2; 8] = [\n        Vec2::new(0.0, -1.0),\n        Vec2::new(0.7, -0.7),\n        Vec2::new(1.0, 0.0),\n        Vec2::new(0.7, 0.7),\n        Vec2::new(0.0, 1.0),\n        Vec2::new(-0.7, 0.7),\n        Vec2::new(-1.0, 0.0),\n        Vec2::new(-0.7, -0.7),\n    ];\n    for (i, tool) in f.ring.iter().enumerate() {\n        let at = pr.at(Vec3::new(tray_x(i), 1.0, 6.05));\n        let sel = selected == Some(*tool);\n        // The hint: a flick direction on a pad, a digit on keys.\n        let hint = at + vec2(-58.0, -2.0);\n        if g.device == Device::Gamepad {\n            p.circle_filled(hint, 19.0, Color32::from_rgba_unmultiplied(0, 0, 0, 190));\n            let d = dirs[i];\n            arrow(p, hint - vec2(d.x, d.y) * 8.0, hint + vec2(d.x, d.y) * 12.0, if sel { GOLD } else { INK }, 3.0);\n        } else {\n            let k = Rect::from_center_size(hint, vec2(32.0, 32.0));\n            p.rect_filled(k, 6.0, Color32::from_rgb(232, 236, 236));\n            p.text(k.center(), Align2::CENTER_CENTER, format!(\"{}\", i + 1), style::font(26.0), Color32::from_rgb(24, 28, 32));\n        }\n        let name = short_name(*tool);\n        let c = if sel { GOLD } else { INK };\n        style::outlined(p, at + vec2(-32.0, -2.0), Align2::LEFT_CENTER, name, 30.0, c);\n        if sel {\n            p.rect_filled(Rect::from_center_size(at + vec2(10.0, 20.0), vec2(120.0, 5.0)), 2.0, GOLD);\n        }\n    }\n    // The gift meter, on the tray's right.\n    if let Some(s) = f.surgeons.first() {\n        if f.gift_awake {\n            gift_meter(shell, p, rect, f, s);\n        }\n    }\n    // One line of prompts, top of the tray.\n    let y = rect.max.y - 158.0;\n    if matches!(f.stage, Stage::Op) {\n        let mut x = rect.min.x + 280.0;\n        let tool = selected.unwrap_or(Tool::Scalpel);\n        let (label, a) = (use_word(tool), Action::Use);\n        shell.prompted(g, a);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, a, label, INK);\n        shell.prompted(g, Action::Pick);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Pick, \"Instrument\", INK);\n        shell.prompted(g, Action::Cancel);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Cancel, \"Let go\", INK);\n        shell.prompted(g, Action::Chart);\n        glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Chart, \"Chart\", INK);\n    }\n}\n\nfn use_word(t: Tool) -> &'static str {\n    match t {\n        Tool::Scalpel => \"Cut\",\n        Tool::Forceps => \"Grab and pull\",\n        Tool::Suture => \"Stitch\",\n        Tool::Suction => \"Suction\",\n        Tool::Laser => \"Burn\",\n        Tool::Gel => \"Paint\",\n        Tool::Scanner => \"Sweep\",\n        Tool::Iv => \"Push\",\n        Tool::Cryo => \"Freeze\",\n        Tool::Dressing => \"Dress\",\n        Tool::Defib => \"Charge\",\n    }\n}\n\nfn short_name(t: Tool) -> &'static str {\n    match t {\n        Tool::Iv => \"IV\",\n        Tool::Cryo => \"Cryo\",\n        other => other.name(),\n    }\n}\n\nfn gift_meter(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, s: &pav_core::games::surgery::frame::SurgeonView) {\n    let g = shell.glyphs();\n    let name = if f.duet || (f.case_no == 7) {\n        \"DUET\"\n    } else if s.gift_kind == 1 {\n        \"ECHO\"\n    } else {\n        \"HUSH\"\n    };\n    let c = rect.right_bottom() - vec2(150.0, 208.0);\n    let r = 62.0;\n    p.circle_filled(c, r + 6.0, Color32::from_black_alpha(190));\n    let frac = (s.gift / 100.0).clamp(0.0, 1.0);\n    let beat = (-f.beat * 5.0).exp();\n    arc(p, c, r, 0.0, 1.0, 11.0, Color32::from_gray(50));\n    let col = if s.gift_kind == 1 { Color32::from_rgb(150, 220, 255) } else { Color32::from_rgb(214, 200, 255) };\n    arc(p, c, r, 0.0, frac, 11.0, col);\n    style::outlined(p, c - vec2(0.0, 14.0), Align2::CENTER_CENTER, name, 34.0, if s.gift_ready { Color32::WHITE } else { DIM });\n    if s.gift_ready {\n        p.circle_stroke(c, r + 12.0 + beat * 10.0, Stroke::new(4.0, style::with_alpha(col, 0.4 + beat * 0.5)));\n        shell.prompted(g, Action::Gift);\n        glyphs::draw(p, c + vec2(-20.0, 24.0), 40.0, g, Action::Gift);\n        let msg = if s.gift_hold { \"Release on the beat!\" } else { \"Hold, then release on the beat\" };\n        style::outlined(p, c + vec2(-90.0, -92.0), Align2::RIGHT_CENTER, msg, 34.0, Color32::WHITE);\n    }\n}\n\nfn cameo_line(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let Some(sub) = &f.subtitle else { return };\n    let a = ((5.0 - sub.age) * 3.0).clamp(0.0, 1.0);\n    let box_r = Rect::from_min_size(rect.left_bottom() + vec2(30.0, -338.0), vec2(740.0, 134.0));\n    p.rect_filled(box_r, 10.0, style::with_alpha(Color32::from_rgb(4, 14, 18), 0.8 * a));\n    let cam = Rect::from_min_size(box_r.min + vec2(8.0, 8.0), vec2(118.0, 118.0));\n    super::story::cameo(shell, p, cam, &sub.who, \"neutral\", sub.age < 1.4 && (sub.age * 11.0).sin() > 0.0);\n    let content = pav_core::games::surgery::content::get();\n    let (title, accent) = content\n        .rigs\n        .get(&*sub.who)\n        .map(|r| (r.title.clone(), Color32::from_rgb(r.accent[0], r.accent[1], r.accent[2])))\n        .unwrap_or((sub.who.to_string(), INK));\n    style::outlined(p, box_r.min + vec2(140.0, 26.0), Align2::LEFT_CENTER, &title, 30.0, style::with_alpha(accent, a));\n    style::wrapped(p, box_r.min + vec2(140.0, 46.0), box_r.width() - 156.0, &sub.text, 32.0, style::with_alpha(Color32::WHITE, a));\n}\n\nfn fever(p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    if let Some(v) = f.fever {\n        let at = rect.min + vec2(30.0, 118.0);\n        style::outlined(p, at + vec2(0.0, 22.0), Align2::LEFT_CENTER, \"FEVER\", 34.0, Color32::from_rgb(255, 170, 70));\n        let bar = Rect::from_min_size(at + vec2(96.0, 6.0), vec2(366.0, 32.0));\n        p.rect_filled(bar, 8.0, Color32::from_black_alpha(190));\n        let col = if v > 100.0 { RED } else { Color32::from_rgb(255, 150, 60) };\n        p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * (v / 100.0).clamp(0.0, 1.0), 32.0)), 8.0, col);\n    }\n    // The count-in: \"lift off\" is a rhythm.\n    if f.ring_in > 0 && f.ring_in <= 2 {\n        let c = rect.center() + vec2(0.0, -200.0);\n        let beat = (-f.beat * 4.0).exp();\n        let text = if f.ring_in == 1 { \"LIFT OFF!\" } else { \"RING COMING\" };\n        style::outlined(p, c, Align2::CENTER_CENTER, text, 70.0 + beat * 16.0, Color32::from_rgb(255, 180, 90));\n    }\n}\n\nfn code(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, c: &pav_core::games::surgery::frame::CodeView) {\n    let g = shell.glyphs();\n    let center = rect.center();\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(40, 0, 0, 120));\n    if !c.scripted {\n        style::outlined(p, center + vec2(0.0, -330.0), Align2::CENTER_CENTER, &format!(\"{:.1}\", c.left.max(0.0)), 110.0, RED);\n    }\n    let track = Rect::from_center_size(center + vec2(0.0, -120.0), vec2(1100.0, 120.0));\n    p.rect_filled(track, 10.0, Color32::from_black_alpha(200));\n    // The flat line, the centre mark, the ghost beat crossing.\n    p.line_segment([track.left_center(), track.right_center()], Stroke::new(3.0, Color32::from_rgb(230, 80, 70)));\n    let mid_x = track.center().x;\n    p.line_segment([pos2(mid_x, track.min.y), pos2(mid_x, track.max.y)], Stroke::new(4.0, GOLD));\n    let zone = Rect::from_center_size(track.center(), vec2(track.width() * 0.25, track.height()));\n    p.rect_filled(zone, 0.0, style::with_alpha(GREEN, 0.12));\n    let x = track.min.x + track.width() * c.ghost;\n    let col = Color32::from_rgb(190, 235, 255);\n    let n = 40;\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let t = k as f32 / n as f32 - 0.5;\n            pos2(x + t * 200.0, track.center().y - ecg_wave(t * 0.6) * 48.0)\n        })\n        .filter(|q| q.x > track.min.x && q.x < track.max.x)\n        .collect();\n    if pts.len() > 1 {\n        p.add(egui::Shape::line(pts, Stroke::new(5.0, col)));\n    }\n    // Charge.\n    let charge = f.surgeons.iter().map(|s| s.charge).fold(0.0f32, f32::max);\n    let bar = Rect::from_center_size(center + vec2(0.0, 12.0), vec2(620.0, 40.0));\n    p.rect_filled(bar, 10.0, Color32::from_black_alpha(200));\n    p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * charge, 40.0)), 10.0, if charge >= 1.0 { GREEN } else { Color32::from_rgb(150, 210, 255) });\n    let msg = if charge >= 1.0 { \"CHARGED: release on the line\" } else { \"Hold to charge\" };\n    shell.prompted(g, Action::Defib);\n    let w = glyphs::draw(p, center + vec2(-280.0, 86.0), 56.0, g, Action::Defib);\n    style::outlined(p, center + vec2(-280.0 + w + 16.0, 86.0), Align2::LEFT_CENTER, msg, 50.0, Color32::WHITE);\n    if c.shocks > 1 {\n        style::outlined(p, center + vec2(0.0, 160.0), Align2::CENTER_CENTER, &format!(\"{} shocks to go\", c.shocks), 44.0, GOLD);\n    }\n}\n\nfn banner(p: &Painter, rect: Rect, text: &str, age: f32) {\n    let c = rect.center() + vec2(0.0, -40.0);\n    let in_t = (age / 0.18).clamp(0.0, 1.0);\n    let out = ((2.6 - age) / 0.5).clamp(0.0, 1.0);\n    let a = in_t * out;\n    let size = 110.0 + (1.0 - in_t) * 60.0;\n    let w = rect.width();\n    p.rect_filled(Rect::from_center_size(c, vec2(w, 160.0)), 0.0, Color32::from_rgba_unmultiplied(0, 0, 0, (150.0 * a) as u8));\n    style::outlined(p, c, Align2::CENTER_CENTER, text, size, style::with_alpha(Color32::WHITE, a));\n}\n\nfn chart_overlay(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let content = pav_core::games::surgery::content::get();\n    let Some(case) = content.case(f.case_no) else { return };\n    let r = Rect::from_center_size(rect.center(), vec2(980.0, 560.0));\n    p.rect_filled(r, 12.0, style::PAPER);\n    let ink = style::PAPER_INK;\n    let mut y = r.min.y + 28.0;\n    let x = r.min.x + 40.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"{}: {}\", case.name, case.patient), 48.0, ink);\n    y += 76.0;\n    y = style::wrapped(p, pos2(x, y), r.width() - 80.0, &case.diagnosis, 34.0, ink) + 18.0;\n    let phase = case.phase.get(f.phase as usize);\n    if let Some(ph) = phase {\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"Phase {} of {}: {}\", f.phase + 1, case.phase.len(), ph.name), 36.0, ink);\n        y += 56.0;\n    }\n    let left = f.hazards.iter().filter(|h| h.required && (!h.hidden || h.reveal > 0.0)).count();\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"Tasks in view: {left}\"), 36.0, ink);\n    y += 56.0;\n    let hidden = f.hazards.iter().any(|h| h.hidden && h.reveal <= 0.0);\n    if hidden {\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Something on the film is not in view. Scanner.\", 36.0, style::RED);\n    }\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Chart);\n    glyphs::labeled(p, r.left_bottom() + vec2(40.0, -40.0), 36.0, g, Action::Chart, \"Close\", ink);\n}\nEOF\ncat > crates/pav_ui/src/surgery/story.rs <<'EOF'\n//! The story player's screen: a large dialogue box, the backlog, the prompts. And the cameo: the\n//! same rig data, flattened into a mesh for the HUD.\n\nuse egui::epaint::{Mesh, Vertex};\nuse egui::{Align2, Color32, Painter, Pos2, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::paper;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, INK};\nuse super::{Shell, ShellInput};\n\n/// A rig, flattened: (colour, points, triangles), back to front.\npub struct Cameo {\n    parts: Vec<(Color32, Vec<Pos2>, Vec<[u32; 3]>)>,\n    open: Vec<Pos2>,\n    closed: Vec<Pos2>,\n    open_t: Vec<[u32; 3]>,\n    closed_t: Vec<[u32; 3]>,\n}\n\nfn build_cameo(who: &str) -> Option<Cameo> {\n    let content = content::get();\n    let r = content.rigs.get(who)?;\n    let mut order: Vec<&content::PartDef> = r.part.iter().collect();\n    order.sort_by(|a, b| a.z.total_cmp(&b.z));\n    let mut parts = Vec::new();\n    for pd in order {\n        let c = r.palette.get(&pd.color).copied().unwrap_or([255, 255, 255]);\n        let color = Color32::from_rgb(c[0], c[1], c[2]);\n        let out = pd.outline();\n        let mut push = |pts: Vec<glam::Vec2>| {\n            let t = paper::triangulate(&pts);\n            parts.push((color, pts.iter().map(|q| pos2(q.x, -q.y)).collect(), t));\n        };\n        push(out.clone());\n        if pd.mirror {\n            push(out.iter().rev().map(|q| glam::Vec2::new(-q.x, q.y)).collect());\n        }\n    }\n    let shape = |list: &[[f32; 2]]| {\n        let v: Vec<glam::Vec2> = list.iter().map(|q| glam::Vec2::new(q[0], q[1])).collect();\n        let v = paper::chaikin(&v, 1);\n        let t = paper::triangulate(&v);\n        (v.iter().map(|q| pos2(q.x, -q.y)).collect::<Vec<_>>(), t)\n    };\n    let e = r.expr.get(\"neutral\")?;\n    let (open, open_t) = shape(&e.open);\n    let (closed, closed_t) = shape(&e.closed);\n    Some(Cameo { parts, open, closed, open_t, closed_t })\n}\n\n/// Draws a character's head and shoulders in a rect.\npub fn cameo(shell: &mut Shell, p: &Painter, r: Rect, who: &str, _expr: &str, talking: bool) {\n    if !shell.cameos_ref().contains_key(who) {\n        if let Some(c) = build_cameo(who) {\n            shell.cameos_mut().insert(who.to_string(), c);\n        }\n    }\n    let content = content::get();\n    let accent = content.rigs.get(who).map(|x| x.accent).unwrap_or([60, 70, 80]);\n    p.rect_filled(r, 10.0, Color32::from_rgb(accent[0] / 3, accent[1] / 3, accent[2] / 3));\n    let Some(c) = shell.cameos_ref().get(who) else { return };\n    let scale = r.height() / 4.6;\n    let origin = r.center() + vec2(0.0, r.height() * 0.08);\n    let clip = p.with_clip_rect(r);\n    let mut m = Mesh::default();\n    let mut add = |pts: &[Pos2], tris: &[[u32; 3]], col: Color32| {\n        let b = m.vertices.len() as u32;\n        for q in pts {\n            let at = origin + vec2(q.x, q.y) * scale;\n            m.vertices.push(Vertex { pos: at, uv: egui::epaint::WHITE_UV, color: col });\n        }\n        for t in tris {\n            m.indices.extend_from_slice(&[b + t[0], b + t[1], b + t[2]]);\n        }\n    };\n    for (col, pts, tris) in &c.parts {\n        add(pts, tris, *col);\n    }\n    let dark = Color32::from_rgb(92, 30, 40);\n    if talking {\n        add(&c.open, &c.open_t, dark);\n    } else {\n        add(&c.closed, &c.closed_t, dark);\n    }\n    clip.add(m);\n}\n\nimpl Shell {\n    pub fn cameos_ref(&self) -> &std::collections::HashMap<String, Cameo> {\n        &self.cameos\n    }\n    pub fn cameos_mut(&mut self) -> &mut std::collections::HashMap<String, Cameo> {\n        &mut self.cameos\n    }\n}\n\n/// Draws the dialogue box; returns nothing. Shared with attract's story segment.\nfn dialogue(p: &Painter, rect: Rect, f: &SurgeryFrame) -> Rect {\n    let Some(s) = &f.story else { return rect };\n    let box_r = Rect::from_min_size(rect.left_bottom() + vec2(120.0, -320.0), vec2(rect.width() - 240.0, 240.0));\n    p.rect_filled(box_r.translate(vec2(6.0, 8.0)), 16.0, Color32::from_black_alpha(120));\n    p.rect_filled(box_r, 16.0, Color32::from_rgba_unmultiplied(8, 22, 26, 238));\n    let content = content::get();\n    let narrator = &*s.who == \"narrator\";\n    let (title, accent) = content\n        .rigs\n        .get(&*s.who)\n        .map(|r| (r.title.clone(), Color32::from_rgb(r.accent[0], r.accent[1], r.accent[2])))\n        .unwrap_or((String::new(), INK));\n    p.rect_stroke(box_r, 16.0, egui::Stroke::new(3.0, style::with_alpha(accent, 0.8)), StrokeKind::Inside);\n    if !title.is_empty() {\n        let tag = Rect::from_min_size(box_r.left_top() + vec2(40.0, -34.0), vec2(title.len() as f32 * 21.0 + 44.0, 62.0));\n        p.rect_filled(tag, 10.0, accent);\n        style::plain(p, tag.center(), Align2::CENTER_CENTER, &title, 44.0, Color32::from_rgb(8, 16, 20));\n    }\n    let shown: String = s.text.chars().take(s.chars as usize).collect();\n    let color = if narrator { Color32::from_rgb(206, 226, 226) } else { Color32::WHITE };\n    style::wrapped(p, box_r.left_top() + vec2(44.0, 44.0), box_r.width() - 110.0, &shown, 42.0, color);\n    box_r\n}\n\npub fn draw_attract(_shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    dialogue(p, rect, f);\n}\n\npub fn draw(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(s) = &f.story else { return };\n    if s.flash > 0.0 && !shell.save.settings.reduce_flashes {\n        p.rect_filled(rect, 0.0, style::with_alpha(Color32::WHITE, (s.flash * 0.9).min(0.9)));\n    }\n    let box_r = dialogue(p, rect, f);\n    // A mark when the line is done, and the click area: anywhere.\n    if s.typed {\n        let beat = (shell.time * 4.0).sin() * 6.0;\n        let g = shell.glyphs();\n        shell.prompted(g, Action::Confirm);\n        super::glyphs::draw(p, box_r.right_bottom() + vec2(-78.0, -42.0 + beat), 44.0, g, Action::Confirm);\n    }\n    let auto_label = if shell.auto_advance { \"Auto: on\" } else { \"Auto: off\" };\n    shell.hints(p, rect, &[(Action::Skip, \"Skip scene\"), (Action::Backlog, \"Backlog\"), (Action::Auto, auto_label), (Action::Pause, \"Pause\")]);\n    if shell.backlog {\n        backlog(p, rect, f);\n        if i.chart || i.back || i.click || i.confirm {\n            shell.backlog = false;\n        }\n        return;\n    }\n    if i.chart {\n        shell.backlog = true;\n        return;\n    }\n    if i.alt {\n        shell.auto_advance = !shell.auto_advance;\n        shell.cue(pav_core::games::surgery::cue::NAV);\n    }\n    // Hold to skip the scene.\n    if i.confirm_held {\n        shell.hold += i.dt;\n        if shell.hold > 0.25 {\n            let k = ((shell.hold - 0.25) / 0.8).clamp(0.0, 1.0);\n            let r = Rect::from_min_size(box_r.left_bottom() + vec2(0.0, 6.0), vec2(box_r.width() * k, 10.0));\n            p.rect_filled(r, 5.0, style::GOLD);\n        }\n        if shell.hold > 1.05 {\n            shell.hold = 0.0;\n            shell.sim(SurgeryCmd::SkipScene);\n            return;\n        }\n    } else {\n        shell.hold = 0.0;\n    }\n    if i.confirm || i.click {\n        shell.sim(SurgeryCmd::Advance);\n        shell.auto_t = 0.0;\n    } else if shell.auto_advance && s.typed {\n        shell.auto_t += i.dt;\n        if shell.auto_t > 1.6 {\n            shell.auto_t = 0.0;\n            shell.sim(SurgeryCmd::Advance);\n        }\n    }\n}\n\nfn backlog(p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let Some(s) = &f.story else { return };\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.96));\n    style::outlined(p, rect.min + vec2(120.0, 80.0), Align2::LEFT_CENTER, \"Backlog\", 60.0, Color32::WHITE);\n    let content = content::get();\n    let Some(def) = content.stories.get(&*s.key) else { return };\n    let upto = (s.line as usize + 1).min(def.line.len());\n    let spoken: Vec<&content::LineDef> = def.line[..upto].iter().filter(|l| !l.who.is_empty()).collect();\n    // The last few lines that fit: no scrollbars.\n    let mut y = rect.max.y - 110.0;\n    for l in spoken.iter().rev().take(7) {\n        let title = content.rigs.get(&l.who).map(|r| r.title.clone()).unwrap_or_default();\n        let text = if title.is_empty() { l.text.clone() } else { format!(\"{title}: {}\", l.text) };\n        let galley = p.layout(text, style::font(36.0), INK, rect.width() - 240.0);\n        y -= galley.size().y + 16.0;\n        if y < rect.min.y + 130.0 {\n            break;\n        }\n        p.galley(pos2(rect.min.x + 120.0, y), galley, INK);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/results.rs <<'EOF'\n//! The chart card, the results with the rank stamp, the death screen and the end of a run.\n\nuse egui::{Align2, Color32, Painter, Rect, pos2, vec2};\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, PAPER, PAPER_INK, RED};\nuse super::{Screen, Shell, ShellInput};\n\nfn ease(t: f32) -> f32 {\n    let t = t.clamp(0.0, 1.0);\n    1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t)\n}\n\npub fn chart(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(c) = &f.chart else { return };\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(6, 18, 20, 140));\n    let slide = ease(c.t / 0.45);\n    let r = Rect::from_center_size(rect.center() + vec2(0.0, (1.0 - slide) * 800.0 - 30.0), vec2(1180.0, 720.0));\n    p.rect_filled(r.translate(vec2(8.0, 10.0)), 10.0, Color32::from_black_alpha(130));\n    p.rect_filled(r, 10.0, PAPER);\n    let x = r.min.x + 60.0;\n    let mut y = r.min.y + 44.0;\n    let case_label = if c.case_no == 255 { \"CODE BLUE\".to_string() } else { format!(\"CASE {}\", c.case_no) };\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &case_label, 42.0, PAPER_INK);\n    style::plain(p, pos2(r.max.x - 60.0, y), Align2::RIGHT_TOP, \"MERCY HARBOR GENERAL\", 36.0, PAPER_INK);\n    y += 60.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &c.case_name, 84.0, PAPER_INK);\n    y += 118.0;\n    style::line(p, pos2(x, y), pos2(r.max.x - 60.0, y), 3.0, PAPER_INK);\n    y += 24.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Patient\", 34.0, Color32::from_rgb(120, 100, 90));\n    style::plain(p, pos2(x + 200.0, y - 8.0), Align2::LEFT_TOP, &c.patient, 54.0, PAPER_INK);\n    y += 70.0;\n    y = style::wrapped(p, pos2(x + 200.0, y), r.width() - 320.0, &c.life, 36.0, PAPER_INK) + 26.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Diagnosis\", 34.0, Color32::from_rgb(120, 100, 90));\n    style::wrapped(p, pos2(x + 200.0, y), r.width() - 320.0, &c.diagnosis, 36.0, PAPER_INK);\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Confirm);\n    super::glyphs::labeled(p, r.left_bottom() + vec2(60.0, -52.0), 46.0, g, Action::Confirm, \"Scrub in\", PAPER_INK);\n    if (i.confirm || i.click) && c.t > 0.2 {\n        shell.cue(cue::CONFIRM);\n        shell.sim(SurgeryCmd::Advance);\n    }\n}\n\npub fn results(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(r0) = &f.results else { return };\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(6, 18, 20, 170));\n    let t = r0.t;\n    if !shell.saved_this_results {\n        // The rank is the player's to keep.\n        shell.saved_this_results = true;\n        let n = r0.case_no;\n        let rank = r0.rank.to_string();\n        shell.save.record(n, &rank);\n        if n < 8 && !f.attract {\n            if n + 1 > shell.save.furthest {\n                shell.save.furthest = (n + 1).min(7);\n            }\n            if !shell.case_files_mode {\n                shell.save.last_case = (n + 1).min(7);\n            }\n        }\n        shell.persist();\n    }\n    let slide = ease(t / 0.4);\n    let card = Rect::from_center_size(rect.center() + vec2(0.0, (1.0 - slide) * 900.0 - 20.0), vec2(1240.0, 820.0));\n    p.rect_filled(card.translate(vec2(8.0, 10.0)), 10.0, Color32::from_black_alpha(130));\n    p.rect_filled(card, 10.0, PAPER);\n    let x = card.min.x + 70.0;\n    let mut y = card.min.y + 40.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &r0.case_name, 70.0, PAPER_INK);\n    y += 92.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &r0.patient, 40.0, Color32::from_rgb(120, 100, 90));\n    y += 66.0;\n    style::line(p, pos2(x, y), pos2(card.max.x - 70.0, y), 3.0, PAPER_INK);\n    y += 20.0;\n    // Lines appear one at a time.\n    let lines: Vec<(String, i32)> = vec![\n        (\"Technique\".into(), r0.action_points),\n        (\"Vitals left\".into(), r0.vitals_bonus),\n        (\"Seconds left\".into(), r0.time_bonus),\n        (format!(\"Mistakes ({})\", r0.mistakes), -r0.mistake_penalty),\n    ];\n    let w = 680.0;\n    let mut shown = 0;\n    let start = 0.55;\n    for (k, (name, v)) in lines.iter().enumerate() {\n        let at = start + k as f32 * 0.38;\n        if t < at {\n            break;\n        }\n        shown = k + 1;\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, name, 44.0, PAPER_INK);\n        style::plain(p, pos2(x + w, y), Align2::RIGHT_TOP, &format!(\"{v}\"), 44.0, PAPER_INK);\n        y += 62.0;\n    }\n    if shown == lines.len() {\n        style::line(p, pos2(x, y + 2.0), pos2(x + w, y + 2.0), 3.0, PAPER_INK);\n        y += 12.0;\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Total\", 56.0, PAPER_INK);\n        style::plain(p, pos2(x + w, y), Align2::RIGHT_TOP, &format!(\"{}\", r0.total), 56.0, PAPER_INK);\n        y += 80.0;\n    }\n    // The stamp slams.\n    let stamp_at = start + 0.38 * lines.len() as f32 + 0.3;\n    if t >= stamp_at {\n        let k = ((t - stamp_at) / 0.14).clamp(0.0, 1.0);\n        let scale = 2.2 - 1.2 * k;\n        let c = pos2(card.max.x - 240.0, card.min.y + 340.0);\n        let size = if r0.rank.len() > 1 { 96.0 } else { 220.0 };\n        let a = k;\n        let box_r = Rect::from_center_size(c, vec2(if r0.rank.len() > 1 { 390.0 } else { 240.0 }, 240.0) * scale);\n        p.rect_stroke(box_r, 16.0, egui::Stroke::new(10.0 * scale, style::with_alpha(RED, a)), egui::StrokeKind::Inside);\n        style::plain(p, c, Align2::CENTER_CENTER, &r0.rank, size * scale, style::with_alpha(RED, a));\n        // The patient's fate.\n        if t >= stamp_at + 0.4 {\n            style::wrapped(p, pos2(x, card.max.y - 180.0), card.width() - 140.0, &r0.fate, 40.0, PAPER_INK);\n        }\n        let g = shell.glyphs();\n        shell.prompted(g, Action::Confirm);\n        super::glyphs::labeled(p, card.left_bottom() + vec2(70.0, -50.0), 44.0, g, Action::Confirm, \"Go on\", PAPER_INK);\n        if (i.confirm || i.click) && t > stamp_at + 0.15 {\n            shell.cue(cue::CONFIRM);\n            shell.sim(SurgeryCmd::Advance);\n        }\n    } else if i.confirm || i.click {\n        // Don't make them wait for the arithmetic twice: skip ahead on the next frame by waiting.\n    }\n    let _ = y;\n    if r0.scores.len() > 1 {\n        let mut yy = card.min.y + 480.0;\n        for (slot, score) in &r0.scores {\n            let c = style::SEATS[*slot as usize % 4];\n            style::plain(p, pos2(card.max.x - 340.0, yy), Align2::LEFT_TOP, &format!(\"Surgeon {}\", slot + 1), 34.0, c);\n            style::plain(p, pos2(card.max.x - 70.0, yy), Align2::RIGHT_TOP, &format!(\"{score}\"), 34.0, PAPER_INK);\n            yy += 44.0;\n        }\n    }\n}\n\npub fn death(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(d) = &f.death else { return };\n    p.rect_filled(rect, 0.0, Color32::BLACK);\n    let c = rect.center();\n    style::plain(p, pos2(c.x, c.y - 280.0), Align2::CENTER_CENTER, &format!(\"Time of death: {}.\", d.time), 92.0, Color32::WHITE);\n    style::wrapped(p, pos2(c.x - 620.0, c.y - 190.0), 1240.0, &d.fate, 40.0, style::DIM);\n    let mut items: Vec<String> = Vec::new();\n    if d.checkpoint {\n        items.push(\"Retry from the checkpoint\".into());\n    }\n    items.push(\"Retry from the start\".into());\n    items.push(\"Quit to Title\".into());\n    let chosen = shell.list(p, i, &items, pos2(c.x - 420.0, c.y - 20.0), 840.0, 104.0, 56.0);\n    shell.hints(p, rect, &[(Action::Nav, \"Choose\"), (Action::Confirm, \"Select\")]);\n    if let Some(k) = chosen {\n        let name = items[k].as_str();\n        match name {\n            \"Retry from the checkpoint\" => shell.sim(SurgeryCmd::Retry { from_start: false }),\n            \"Retry from the start\" => shell.sim(SurgeryCmd::Retry { from_start: true }),\n            _ => shell.quit_to_title(),\n        }\n        shell.focus = 0;\n    }\n}\n\n/// The run is over: back where it started from.\npub fn finished(shell: &mut Shell, p: &Painter, rect: Rect, _f: &SurgeryFrame, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n    let c = rect.center();\n    let case_files = shell.case_files_mode;\n    if case_files {\n        shell.load(\"surgery/title\");\n        shell.go(Screen::CaseFiles);\n        return;\n    }\n    style::outlined(p, pos2(c.x, c.y - 180.0), Align2::CENTER_CENTER, \"End of the First Movement\", 96.0, Color32::WHITE);\n    style::outlined(p, pos2(c.x, c.y - 60.0), Align2::CENTER_CENTER, \"The orchestra is tuning somewhere.\", 48.0, GOLD);\n    let total = \"Thank you for scrubbing in.\";\n    style::outlined(p, pos2(c.x, c.y + 30.0), Align2::CENTER_CENTER, total, 44.0, INK);\n    shell.hints(p, rect, &[(Action::Confirm, \"Credits\")]);\n    if i.confirm || i.click {\n        shell.load(\"surgery/title\");\n        shell.came_from = Screen::Title;\n        shell.go(Screen::About);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/dev.rs <<'EOF'\n//! Dev mode, from the pause menu: a large paged panel docked at the left with the field visible.\n//! Live sliders with their defaults marked and Reset All, then the tools.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::HazardKind;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::tune::{SLIDERS, cheat};\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Shell, ShellCmd, ShellInput};\n\nconst PER_PAGE: usize = 7;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Item {\n    Live,\n    Bot,\n    Slider(usize),\n    Reset,\n    Immortal,\n    Freeze,\n    FullGift,\n    OneHit,\n    TimeScale,\n    FrameStep,\n    JumpCase,\n    JumpPhase,\n    JumpGo,\n    SkipPhase,\n    WinCase,\n    ForceCode,\n    KillPatient,\n    SpawnKind,\n    Spawn,\n    OverlayRadii,\n    OverlayTargets,\n    OverlayBeat,\n    OverlayAssist,\n    Stats,\n    Rewind,\n    SnapSave,\n    SnapLoad,\n    Reload,\n}\n\nfn pages() -> Vec<(&'static str, Vec<Item>)> {\n    let mut out = Vec::new();\n    let sliders: Vec<usize> = (0..SLIDERS.len()).collect();\n    for (k, chunk) in sliders.chunks(PER_PAGE - 2).enumerate() {\n        let mut v = vec![Item::Live, Item::Bot];\n        v.extend(chunk.iter().map(|i| Item::Slider(*i)));\n        let _ = k;\n        out.push((\"Balance\", v));\n    }\n    if let Some((_, last)) = out.last_mut() {\n        last.push(Item::Reset);\n    }\n    out.push((\"Time and patient\", vec![Item::Live, Item::Immortal, Item::Freeze, Item::FullGift, Item::OneHit, Item::TimeScale, Item::FrameStep]));\n    out.push((\"Jump\", vec![Item::JumpCase, Item::JumpPhase, Item::JumpGo, Item::SkipPhase, Item::WinCase, Item::ForceCode, Item::KillPatient]));\n    out.push((\"Spawn and see\", vec![Item::SpawnKind, Item::Spawn, Item::OverlayRadii, Item::OverlayTargets, Item::OverlayBeat, Item::OverlayAssist, Item::Stats]));\n    let mut last = vec![Item::Rewind, Item::SnapSave, Item::SnapLoad];\n    if !cfg!(target_arch = \"wasm32\") {\n        last.push(Item::Reload);\n    }\n    out.push((\"Time travel\", last));\n    out\n}\n\nfn onoff(b: bool) -> String {\n    if b { \"On\".into() } else { \"Off\".into() }\n}\n\nfn describe(shell: &Shell, it: Item, frame: Option<&SurgeryFrame>) -> (String, String, Option<f32>, Option<f32>) {\n    let d = &shell.dev;\n    match it {\n        Item::Live => (\"Live (run while tuning)\".into(), onoff(d.live), None, None),\n        Item::Bot => (\"Bot plays\".into(), onoff(d.bot_plays), None, None),\n        Item::Slider(i) => {\n            let s = &SLIDERS[i];\n            let v = d.tune.get(i);\n            let span = (s.max - s.min).max(0.001);\n            (s.label.into(), format!(\"{v:.2}\"), Some((v - s.min) / span), Some((s.default - s.min) / span))\n        }\n        Item::Reset => (\"Reset All to defaults\".into(), String::new(), None, None),\n        Item::Immortal => (\"Immortal patient\".into(), onoff(d.immortal), None, None),\n        Item::Freeze => (\"Freeze timer\".into(), onoff(d.freeze), None, None),\n        Item::FullGift => (\"Full gift\".into(), onoff(d.full_gift), None, None),\n        Item::OneHit => (\"One-hit strains\".into(), onoff(d.one_hit), None, None),\n        Item::TimeScale => (\"Time scale\".into(), format!(\"{:.2}\", d.time_scale), Some((d.time_scale - 0.05) / 3.95), Some((1.0 - 0.05) / 3.95)),\n        Item::FrameStep => (\"Frame step\".into(), String::new(), None, None),\n        Item::JumpCase => {\n            let name = content::get().cases.get(d.jump_case as usize).map(|c| c.name.clone()).unwrap_or_default();\n            (\"Case\".into(), format!(\"{}: {name}\", d.jump_case), None, None)\n        }\n        Item::JumpPhase => {\n            let n = content::get().cases.get(d.jump_case as usize).map(|c| c.phase.len()).unwrap_or(1);\n            (\"Phase\".into(), format!(\"{} of {n}\", d.jump_phase + 1), None, None)\n        }\n        Item::JumpGo => (\"Jump there\".into(), String::new(), None, None),\n        Item::SkipPhase => (\"Skip phase\".into(), String::new(), None, None),\n        Item::WinCase => (\"Win case\".into(), String::new(), None, None),\n        Item::ForceCode => (\"Force Code\".into(), String::new(), None, None),\n        Item::KillPatient => (\"Kill patient\".into(), String::new(), None, None),\n        Item::SpawnKind => (\"Hazard\".into(), HazardKind::ALL[d.spawn_kind as usize % HazardKind::ALL.len()].name().to_string(), None, None),\n        Item::Spawn => (\"Spawn at the cursor\".into(), String::new(), None, None),\n        Item::OverlayRadii => (\"Overlay: hit radii\".into(), onoff(d.overlays & 1 != 0), None, None),\n        Item::OverlayTargets => (\"Overlay: targets\".into(), onoff(d.overlays & 2 != 0), None, None),\n        Item::OverlayBeat => (\"Overlay: beat window\".into(), onoff(d.overlays & 4 != 0), None, None),\n        Item::OverlayAssist => (\"Overlay: assist radius\".into(), onoff(d.overlays & 8 != 0), None, None),\n        Item::Stats => (\"FPS and tick stats\".into(), onoff(d.stats), None, None),\n        Item::Rewind => (\"Rewind 5 s\".into(), String::new(), None, None),\n        Item::SnapSave => (\"Save snapshot\".into(), String::new(), None, None),\n        Item::SnapLoad => (\"Load snapshot\".into(), String::new(), None, None),\n        Item::Reload => {\n            let _ = frame;\n            (\"Reload content\".into(), String::new(), None, None)\n        }\n    }\n}\n\nfn sim(shell: &mut Shell, c: SurgeryCmd) {\n    shell.cmds.push(ShellCmd::Sim(c));\n}\n\n/// A change of value: `delta` is -1 or +1 for a nudge, 0 for pressing it.\nfn act(shell: &mut Shell, it: Item, delta: f32) {\n    let c = |id, v| SurgeryCmd::Cheat { id, value: v };\n    let press = delta == 0.0;\n    match it {\n        Item::Live => {\n            shell.dev.live = !shell.dev.live;\n            let live = shell.dev.live;\n            shell.cmds.push(ShellCmd::Paused(!live));\n        }\n        Item::Bot => {\n            shell.dev.bot_plays = !shell.dev.bot_plays;\n            let on = shell.dev.bot_plays;\n            sim(shell, SurgeryCmd::BotPlays { slot: 0, on });\n        }\n        Item::Slider(i) => {\n            let s = &SLIDERS[i];\n            let step = (s.max - s.min) / 40.0;\n            let d = if press { 0.0 } else { delta * step };\n            let v = (shell.dev.tune.get(i) + d).clamp(s.min, s.max);\n            set_slider(shell, i, v);\n        }\n        Item::Reset => {\n            shell.dev.tune = Default::default();\n            sim(shell, SurgeryCmd::ResetTune);\n            shell.dev.status = \"Everything back to its default.\".into();\n        }\n        Item::Immortal => {\n            shell.dev.immortal = !shell.dev.immortal;\n            let v = shell.dev.immortal as i32 as f32;\n            sim(shell, c(cheat::IMMORTAL, v));\n        }\n        Item::Freeze => {\n            shell.dev.freeze = !shell.dev.freeze;\n            let v = shell.dev.freeze as i32 as f32;\n            sim(shell, c(cheat::FREEZE_TIMER, v));\n        }\n        Item::FullGift => {\n            shell.dev.full_gift = !shell.dev.full_gift;\n            let v = shell.dev.full_gift as i32 as f32;\n            sim(shell, c(cheat::FULL_GIFT, v));\n        }\n        Item::OneHit => {\n            shell.dev.one_hit = !shell.dev.one_hit;\n            let v = shell.dev.one_hit as i32 as f32;\n            sim(shell, c(cheat::ONE_HIT, v));\n        }\n        Item::TimeScale => {\n            if !press {\n                shell.dev.time_scale = (shell.dev.time_scale + delta * 0.05).clamp(0.05, 4.0);\n                let v = shell.dev.time_scale;\n                sim(shell, c(cheat::TIME_SCALE, v));\n            }\n        }\n        Item::FrameStep => shell.cmds.push(ShellCmd::FrameStep),\n        Item::JumpCase => {\n            let d = if press { 1.0 } else { delta };\n            shell.dev.jump_case = ((shell.dev.jump_case as i32 + d as i32).rem_euclid(content::CASES as i32)) as u8;\n            shell.dev.jump_phase = 0;\n        }\n        Item::JumpPhase => {\n            let n = content::get().cases.get(shell.dev.jump_case as usize).map(|x| x.phase.len()).unwrap_or(1) as i32;\n            let d = if press { 1.0 } else { delta };\n            shell.dev.jump_phase = (shell.dev.jump_phase as i32 + d as i32).rem_euclid(n) as u8;\n        }\n        Item::JumpGo => {\n            let (case, phase) = (shell.dev.jump_case, shell.dev.jump_phase);\n            sim(shell, SurgeryCmd::Jump { case, phase });\n            shell.dev.status = format!(\"Case {case}, phase {}\", phase + 1);\n        }\n        Item::SkipPhase => sim(shell, c(cheat::SKIP_PHASE, 1.0)),\n        Item::WinCase => sim(shell, c(cheat::WIN_CASE, 1.0)),\n        Item::ForceCode => sim(shell, c(cheat::FORCE_CODE, 1.0)),\n        Item::KillPatient => sim(shell, c(cheat::KILL_PATIENT, 1.0)),\n        Item::SpawnKind => {\n            let n = HazardKind::ALL.len() as i32;\n            let d = if press { 1 } else { delta as i32 };\n            shell.dev.spawn_kind = (shell.dev.spawn_kind as i32 + d).rem_euclid(n) as u8;\n        }\n        Item::Spawn => shell.dev.status = \"spawn\".into(),\n        Item::OverlayRadii => overlay(shell, 1),\n        Item::OverlayTargets => overlay(shell, 2),\n        Item::OverlayBeat => overlay(shell, 4),\n        Item::OverlayAssist => overlay(shell, 8),\n        Item::Stats => shell.dev.stats = !shell.dev.stats,\n        Item::Rewind => shell.cmds.push(ShellCmd::Rewind),\n        Item::SnapSave => shell.cmds.push(ShellCmd::SnapshotSave),\n        Item::SnapLoad => shell.cmds.push(ShellCmd::SnapshotLoad),\n        Item::Reload => shell.cmds.push(ShellCmd::ReloadContent),\n    }\n}\n\nfn set_slider(shell: &mut Shell, i: usize, v: f32) {\n    shell.dev.tune.set(i, v);\n    sim(shell, SurgeryCmd::SetTune { id: i as u16, value: v });\n}\n\nfn overlay(shell: &mut Shell, bit: u32) {\n    shell.dev.overlays ^= bit;\n    let v = shell.dev.overlays as f32;\n    sim(shell, SurgeryCmd::Cheat { id: cheat::OVERLAYS, value: v });\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput, frame: Option<&SurgeryFrame>) {\n    let all = pages();\n    let n = all.len();\n    shell.dev.page = shell.dev.page.min(n - 1);\n    if i.tab_prev {\n        shell.dev.page = (shell.dev.page + n - 1) % n;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_next {\n        shell.dev.page = (shell.dev.page + 1) % n;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    let (title, items) = &all[shell.dev.page];\n    let panel = Rect::from_min_size(rect.min, vec2(800.0, rect.height()));\n    p.rect_filled(panel, 0.0, style::PANEL);\n    style::outlined(p, panel.min + vec2(36.0, 48.0), Align2::LEFT_CENTER, \"Dev Mode\", 50.0, Color32::WHITE);\n    style::outlined(p, panel.min + vec2(36.0, 104.0), Align2::LEFT_CENTER, &format!(\"{title}  {}/{n}\", shell.dev.page + 1), 36.0, GOLD);\n    // Prev and next, for a mouse.\n    for (dx, label, step) in [(560.0, \"<\", -1i32), (660.0, \">\", 1)] {\n        let r = Rect::from_min_size(panel.min + vec2(dx, 74.0), vec2(80.0, 60.0));\n        p.rect_filled(r, 8.0, style::with_alpha(TEAL, 0.3));\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, label, 44.0, Color32::WHITE);\n        if i.pointer.is_some_and(|q| r.contains(q)) && i.click {\n            shell.dev.page = (shell.dev.page as i32 + step).rem_euclid(n as i32) as usize;\n            shell.focus = 0;\n            shell.cue(cue::NAV);\n            return;\n        }\n    }\n    let count = items.len();\n    shell.focus = shell.focus.min(count - 1);\n    if shell.nav(0) {\n        shell.focus = (shell.focus + count - 1) % count;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(1) {\n        shell.focus = (shell.focus + 1) % count;\n        shell.cue(cue::NAV);\n    }\n    let step_h = 112.0;\n    let top = panel.min.y + 150.0;\n    for (k, it) in items.iter().enumerate() {\n        let r = Rect::from_min_size(pos2(panel.min.x + 20.0, top + k as f32 * step_h), vec2(760.0, step_h - 10.0));\n        let over = i.pointer.is_some_and(|q| r.contains(q));\n        if over && i.pointer_moved {\n            shell.focus = k;\n        }\n        let f = shell.focus == k;\n        if f {\n            p.rect_filled(r, 8.0, style::with_alpha(TEAL, 0.2));\n            p.rect_stroke(r, 8.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        let (label, value, frac, def) = describe(shell, *it, frame);\n        style::outlined(p, r.left_top() + vec2(18.0, 30.0), Align2::LEFT_CENTER, &label, 38.0, if f { Color32::WHITE } else { INK });\n        style::outlined(p, r.right_top() + vec2(-18.0, 30.0), Align2::RIGHT_CENTER, &value, 38.0, GOLD);\n        if let Some(fr) = frac {\n            let track = Rect::from_min_size(r.left_top() + vec2(18.0, 62.0), vec2(724.0, 20.0));\n            p.rect_filled(track, 10.0, Color32::from_black_alpha(170));\n            p.rect_filled(Rect::from_min_size(track.min, vec2(track.width() * fr.clamp(0.0, 1.0), 20.0)), 10.0, TEAL);\n            if let Some(d) = def {\n                // The default, marked.\n                let x = track.min.x + track.width() * d;\n                p.line_segment([pos2(x, track.min.y - 6.0), pos2(x, track.max.y + 6.0)], egui::Stroke::new(4.0, GOLD));\n            }\n            p.circle_filled(pos2(track.min.x + track.width() * fr.clamp(0.0, 1.0), track.center().y), 15.0, Color32::WHITE);\n            if i.drag && i.pointer.is_some_and(|q| track.expand2(vec2(14.0, 26.0)).contains(q)) {\n                if let (Item::Slider(si), Some(q)) = (it, i.pointer) {\n                    let k = ((q.x - track.min.x) / track.width()).clamp(0.0, 1.0);\n                    let s = &SLIDERS[*si];\n                    set_slider(shell, *si, s.min + (s.max - s.min) * k);\n                }\n            }\n        } else if over && i.click {\n            pressed(shell, *it, frame);\n            shell.cue(cue::CONFIRM);\n        }\n    }\n    let it = items[shell.focus];\n    if shell.nav(2) {\n        act(shell, it, -1.0);\n    }\n    if shell.nav(3) {\n        act(shell, it, 1.0);\n    }\n    if i.confirm {\n        pressed(shell, it, frame);\n        shell.cue(cue::CONFIRM);\n    }\n    if !shell.dev.status.is_empty() {\n        style::outlined(p, rect.max - vec2(40.0, 92.0), Align2::RIGHT_CENTER, &shell.dev.status.clone(), 34.0, TEAL);\n    }\n    if shell.dev.stats {\n        let text = format!(\"{:.0} fps   {:.0} ticks/s\", shell.dev.fps, shell.dev.tps);\n        style::outlined(p, panel.right_top() + vec2(30.0, 150.0), Align2::LEFT_CENTER, &text, 38.0, Color32::WHITE);\n    }\n    shell.hints(p, panel, &[(Action::TabNext, \"Page\"), (Action::Adjust, \"Nudge\"), (Action::Back, \"Back\")]);\n    if i.back || i.pause {\n        shell.cue(cue::BACK);\n        shell.dev.status.clear();\n        // Back to the pause menu, and time stops again.\n        shell.dev.live = false;\n        shell.cmds.push(ShellCmd::Paused(true));\n        shell.go(super::Screen::Pause);\n    }\n}\n\nfn pressed(shell: &mut Shell, it: Item, frame: Option<&SurgeryFrame>) {\n    if it == Item::Spawn {\n        let at = frame.and_then(|f| f.surgeons.first()).map(|s| s.cursor).unwrap_or_default();\n        let kind = shell.dev.spawn_kind;\n        sim(shell, SurgeryCmd::Spawn { kind, x: at.x, z: at.y });\n        shell.dev.status = format!(\"Spawned {} at the cursor\", HazardKind::ALL[kind as usize % HazardKind::ALL.len()].name());\n        return;\n    }\n    act(shell, it, 0.0);\n}\nEOF\ncat > crates/pav_ui/src/surgery/card.rs <<'EOF'\n//! A hub session's own card: a pre-op board with the title, the patient, each player in their\n//! colour with a ready mark, how to win, this player's controls, and the time left. It takes two\n//! answers, and no menus.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, GOLD, GREEN, INK, PAPER, PAPER_INK, SEATS};\nuse super::{Shell, ShellCmd, ShellInput, TITLE};\n\npub const GOAL: &str = \"Keep the patient alive until the bell.\";\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n    let board = Rect::from_center_size(rect.center(), vec2(1640.0, 900.0));\n    p.rect_filled(board.translate(vec2(8.0, 10.0)), 12.0, Color32::from_black_alpha(150));\n    p.rect_filled(board, 12.0, PAPER);\n    let x = board.min.x + 60.0;\n    style::plain(p, pos2(x, board.min.y + 34.0), Align2::LEFT_TOP, TITLE, 70.0, PAPER_INK);\n    style::plain(p, pos2(x, board.min.y + 118.0), Align2::LEFT_TOP, \"Tonight's board: CODE BLUE, one patient, every hand\", 40.0, PAPER_INK);\n    style::line(p, pos2(x, board.min.y + 176.0), pos2(board.max.x - 60.0, board.min.y + 176.0), 3.0, PAPER_INK);\n    let card = shell.hub_card.clone().unwrap_or_default();\n    style::plain(p, pos2(x, board.min.y + 198.0), Align2::LEFT_TOP, \"Patient: John Doe, Ward Nine\", 44.0, PAPER_INK);\n    style::plain(p, pos2(x, board.min.y + 258.0), Align2::LEFT_TOP, GOAL, 48.0, Color32::from_rgb(170, 30, 30));\n    // Who is on tonight.\n    let mut y = board.min.y + 340.0;\n    for (id, name) in &card.players {\n        let c = SEATS[*id as usize % 4];\n        let row = Rect::from_min_size(pos2(x, y), vec2(800.0, 74.0));\n        p.rect_filled(row, 8.0, style::with_alpha(c, 0.2));\n        p.rect_filled(Rect::from_min_size(row.min, vec2(14.0, 74.0)), 4.0, c);\n        let me = card.me == Some(*id);\n        // The name is the hub's: egui text only, never markup.\n        style::plain(p, row.left_center() + vec2(34.0, 0.0), Align2::LEFT_CENTER, name, 46.0, PAPER_INK);\n        if me {\n            style::plain(p, row.right_center() - vec2(150.0, 0.0), Align2::RIGHT_CENTER, \"you\", 36.0, PAPER_INK);\n        }\n        let ready = card.ready.contains(id);\n        let t = if ready { \"READY\" } else { \"scrubbing\" };\n        style::plain(p, row.right_center() - vec2(16.0, 0.0), Align2::RIGHT_CENTER, t, 38.0, if ready { Color32::from_rgb(20, 120, 70) } else { Color32::from_rgb(120, 110, 100) });\n        y += 86.0;\n    }\n    // This player's controls.\n    let g = shell.glyphs();\n    let cx = board.min.x + 900.0;\n    let mut cy = board.min.y + 348.0;\n    let rows: &[(Action, &str)] = &[(Action::Aim, \"Move the cursor\"), (Action::Use, \"Use the instrument\"), (Action::Pick, \"Pick an instrument\"), (Action::Gift, \"Your gift, on the beat\")];\n    for (a, label) in rows {\n        shell.prompted(g, *a);\n        glyphs::draw(p, pos2(cx, cy), 46.0, g, *a);\n        style::plain(p, pos2(cx + 150.0, cy), Align2::LEFT_CENTER, label, 40.0, PAPER_INK);\n        cy += 72.0;\n    }\n    // The clock and the two answers.\n    let left = card.left_ms.map(|ms| format!(\"{:.0}\", (ms / 1000.0).ceil()));\n    let status = if card.starting {\n        \"Starting...\".to_string()\n    } else if card.paused {\n        format!(\"Waiting: {} asked for more time\", card.asking)\n    } else if let Some(s) = left {\n        format!(\"Scrub in: {s} seconds\")\n    } else {\n        \"Waiting for the board...\".to_string()\n    };\n    style::plain(p, pos2(x, board.max.y - 150.0), Align2::LEFT_CENTER, &status, 50.0, PAPER_INK);\n    let ready_r = Rect::from_min_size(pos2(x, board.max.y - 110.0), vec2(520.0, 86.0));\n    let more_r = Rect::from_min_size(pos2(x + 560.0, board.max.y - 110.0), vec2(520.0, 86.0));\n    let i_ready = card.me.is_some_and(|m| card.ready.contains(&m));\n    p.rect_filled(ready_r, 12.0, if i_ready { GREEN } else { Color32::from_rgb(30, 110, 110) });\n    p.rect_stroke(ready_r, 12.0, egui::Stroke::new(3.0, PAPER_INK), StrokeKind::Inside);\n    shell.prompted(g, Action::Confirm);\n    glyphs::draw(p, ready_r.left_center() + vec2(24.0, 0.0), 50.0, g, Action::Confirm);\n    style::outlined(p, ready_r.left_center() + vec2(180.0, 0.0), Align2::LEFT_CENTER, \"Ready\", 52.0, Color32::WHITE);\n    p.rect_filled(more_r, 12.0, if card.asked { GOLD } else { Color32::from_rgb(80, 86, 96) });\n    p.rect_stroke(more_r, 12.0, egui::Stroke::new(3.0, PAPER_INK), StrokeKind::Inside);\n    shell.prompted(g, Action::More);\n    glyphs::draw(p, more_r.left_center() + vec2(24.0, 0.0), 50.0, g, Action::More);\n    style::outlined(p, more_r.left_center() + vec2(120.0, 0.0), Align2::LEFT_CENTER, \"More time\", 52.0, Color32::WHITE);\n    let tapped = i.tap.or(if i.click { i.pointer } else { None });\n    if i.confirm || tapped.is_some_and(|q| ready_r.contains(q)) {\n        shell.cmds.push(ShellCmd::HubReady);\n    }\n    if i.alt || tapped.is_some_and(|q| more_r.contains(q)) {\n        shell.cmds.push(ShellCmd::HubMore);\n    }\n    let _ = INK;\n}\nEOF\ncat > crates/pav_ui/src/surgery/tests.rs <<'EOF'\n//! The shell, driven with no GPU: pad, keyboard and mouse navigation through every screen.\n\nuse egui::{Context, RawInput};\nuse glam::Mat4;\n\nuse super::save::{Save, Settings};\nuse super::*;\nuse pav_core::games::surgery::frame::SurgeryFrame;\n\nfn run(shell: &mut Shell, ctx: &Context, input: ShellInput, f: Option<&SurgeryFrame>) -> Vec<ShellCmd> {\n    let raw = RawInput {\n        screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1920.0, 1080.0))),\n        predicted_dt: 1.0 / 60.0,\n        ..Default::default()\n    };\n    let _ = ctx.run_ui(raw, |ui| {\n        let ctx = ui.ctx().clone();\n        shell.frame(&ctx, &input, f, Mat4::IDENTITY);\n    });\n    std::mem::take(&mut shell.cmds)\n}\n\nfn tick(device: Device) -> ShellInput {\n    ShellInput { device, dt: 1.0 / 60.0, ..Default::default() }\n}\n\nfn press(device: Device, f: impl Fn(&mut ShellInput)) -> ShellInput {\n    let mut i = tick(device);\n    i.any = true;\n    f(&mut i);\n    i\n}\n\n#[test]\nfn music_defaults_to_ten_percent() {\n    assert_eq!(Settings::default().music, 0.10);\n    assert_eq!(Settings::default().effects, 0.80);\n    assert_eq!(Settings::default().voices, 0.70);\n}\n\n#[test]\nfn a_pad_walks_the_menus_and_prompts_follow_the_device() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert_eq!(s.screen, Screen::Menu, \"any confirm leaves the title\");\n    run(&mut s, &ctx, tick(Device::Gamepad), None);\n    assert!(s.prompts.contains(&\"Cross\"), \"pad glyphs: {:?}\", s.prompts);\n    // Down to Settings: New Game, Case Files, Code Blue, Settings.\n    for _ in 0..3 {\n        run(&mut s, &ctx, press(Device::Gamepad, |i| i.down = true), None);\n        run(&mut s, &ctx, tick(Device::Gamepad), None);\n    }\n    assert_eq!(s.focus, 3);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert_eq!(s.screen, Screen::Settings);\n    // Tabs, then back.\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.tab_next = true), None);\n    assert_eq!(s.page, 1);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert!(s.save.settings.xbox, \"the first switch on the Controls page\");\n    run(&mut s, &ctx, tick(Device::Gamepad), None);\n    assert!(s.prompts.contains(&\"LB\"), \"Xbox glyphs now: {:?}\", s.prompts);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.back = true), None);\n    assert_eq!(s.screen, Screen::Menu);\n    // The mouse takes over at once.\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    assert!(s.prompts.contains(&\"Enter\"), \"key glyphs: {:?}\", s.prompts);\n}\n\n#[test]\nfn hover_moves_the_focus_and_a_click_activates() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    s.go(Screen::Menu);\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    assert_eq!(s.focus, 0);\n    let on_third = egui::pos2(300.0, 240.0 + 104.0 * 2.0 + 40.0);\n    run(&mut s, &ctx, press(Device::KeyboardMouse, |i| {\n        i.pointer = Some(on_third);\n        i.pointer_moved = true;\n    }), None);\n    assert_eq!(s.focus, 2, \"hover moved the focus\");\n    let cmds = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| {\n        i.pointer = Some(on_third);\n        i.click = true;\n    }), None);\n    assert!(cmds.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/codeblue\")), \"{cmds:?}\");\n    assert_eq!(s.screen, Screen::Playing);\n}\n\n#[test]\nfn attract_starts_at_ten_seconds_and_any_input_exits() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    for _ in 0..(9.5 * 60.0) as usize {\n        run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    }\n    assert_eq!(s.screen, Screen::Title);\n    let mut started = false;\n    for _ in 0..60 {\n        let c = run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n        started |= c.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/attract\"));\n    }\n    assert!(started && s.screen == Screen::Attract);\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |_| {}), None);\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/title\")));\n    assert_eq!(s.screen, Screen::Title);\n}\n\n#[test]\nfn touch_only_shows_the_message_and_a_settings_button_a_tap_can_use() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    s.touch_only = true;\n    run(&mut s, &ctx, tick(Device::Touch), None);\n    assert_eq!(s.screen, Screen::Title);\n    // A tap anywhere else does nothing.\n    run(&mut s, &ctx, press(Device::Touch, |i| i.tap = Some(egui::pos2(100.0, 100.0))), None);\n    assert_eq!(s.screen, Screen::Title);\n    run(&mut s, &ctx, press(Device::Touch, |i| i.tap = Some(egui::pos2(960.0, 540.0 + 260.0))), None);\n    assert_eq!(s.screen, Screen::Settings);\n    run(&mut s, &ctx, tick(Device::Touch), None);\n    // Attract still runs.\n    let mut s2 = Shell::default();\n    s2.touch_only = true;\n    for _ in 0..(10.5 * 60.0) as usize {\n        run(&mut s2, &ctx, tick(Device::Touch), None);\n    }\n    assert_eq!(s2.screen, Screen::Attract);\n}\n\n#[test]\nfn dev_sliders_apply_and_reset_and_the_default_is_kept() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    let f = SurgeryFrame::default();\n    s.go(Screen::Dev);\n    s.focus = 2; // the first slider: Vitals drain\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), Some(&f));\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| i.right = true), Some(&f));\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Sim(SurgeryCmd::SetTune { id: 0, .. }))), \"{c:?}\");\n    assert!(s.dev.tune.get(0) > 1.0);\n    // Reset All lives on the last Balance page.\n    let pages = 4;\n    s.dev.page = pages - 1;\n    let reset_at = 2 + pav_core::games::surgery::tune::SLIDERS.len() % 5;\n    s.focus = if pav_core::games::surgery::tune::SLIDERS.len() % 5 == 0 { 7 } else { reset_at };\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| i.confirm = true), Some(&f));\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Sim(SurgeryCmd::ResetTune))), \"{c:?}\");\n    assert_eq!(s.dev.tune.get(0), 1.0);\n}\n\n#[test]\nfn about_shows_every_required_section_with_no_scrollbars() {\n    let a = super::about::About::parse(\n        r#\"{\"sections\":[{\"title\":\"Credits\",\"lines\":[\"x\"]},{\"title\":\"Source Information\",\"lines\":[\"y\"]},{\"title\":\"Testing Feedback\",\"lines\":[\"z\"]},{\"title\":\"Engine Feedback\",\"lines\":[\"w\"]},{\"title\":\"Prompt Feedback\",\"lines\":[\"v\"]}]}\"#,\n    )\n    .unwrap();\n    let titles: Vec<String> = a.pages().into_iter().map(|p| p.0).collect();\n    for need in [\"Credits\", \"Source Information\", \"Testing Feedback\", \"Engine Feedback\", \"Prompt Feedback\"] {\n        assert!(titles.iter().any(|t| t == need), \"{need} missing\");\n    }\n    // A long section runs to more screens rather than scrolling.\n    let long = super::about::About { sections: vec![super::about::AboutSection { title: \"L\".into(), lines: vec![\"word \".repeat(40); 30] }] };\n    assert!(long.pages().len() > 1);\n}\n\n#[test]\nfn a_save_round_trips_and_best_rank_holds() {\n    let mut s = Save::default();\n    assert!(s.record(2, \"B\"));\n    assert!(!s.record(2, \"C\"), \"a worse rank doesn't replace it\");\n    assert!(s.record(2, \"ENCORE\"));\n    assert!(s.record(255, \"S\"));\n    s.settings.music = 0.3;\n    let back = Save::parse(&s.to_text()).unwrap();\n    assert_eq!(back, s);\n    assert!(Save::parse(\"{\\\"version\\\":99}\").is_none());\n    assert!(Save::parse(\"nonsense\").is_none());\n}\n\n#[test]\nfn every_screen_draws_without_a_panic_on_every_stage() {\n    use pav_core::games::surgery::frame::Stage;\n    let ctx = Context::default();\n    let mut sim = pav_core::Sim::new(\"surgery/case/7\", 1).unwrap();\n    let mut s = Shell::default();\n    let screens = [Screen::Title, Screen::Menu, Screen::Difficulty, Screen::CaseFiles, Screen::Settings, Screen::About, Screen::Controls, Screen::Pause, Screen::Dev, Screen::Card, Screen::Attract, Screen::Playing, Screen::Session];\n    for t in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n        if t % 40 == 0 {\n            let fr = sim.frame().surgery.clone();\n            for sc in screens {\n                s.screen = sc;\n                run(&mut s, &ctx, tick(Device::Gamepad), fr.as_deref());\n                run(&mut s, &ctx, tick(Device::KeyboardMouse), fr.as_deref());\n            }\n        }\n    }\n    // A frame per stage, by hand.\n    for st in [Stage::Story, Stage::Chart, Stage::Results, Stage::Dead, Stage::Finished, Stage::Code] {\n        let f = SurgeryFrame { stage: st, ..Default::default() };\n        s.screen = Screen::Playing;\n        run(&mut s, &ctx, tick(Device::Gamepad), Some(&f));\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_ui/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod headless;\\n','pub mod headless;\\npub mod surgery;\\n')\nopen(p,'w').write(s)\np='crates/pav_ui/src/headless.rs'\ns=open(p).read()\ns=s.replace('''/// The UI's state between frames: which windows are open, the device, the touch controls.\n#[derive(Default)]\npub struct Headless {\n    pub game: GameUi,\n    pub touch: Touch,\n    pub device: Device,\n}\n''','''/// The UI's state between frames: which windows are open, the device, the touch controls.\n#[derive(Default)]\npub struct Headless {\n    pub game: GameUi,\n    pub touch: Touch,\n    pub device: Device,\n    /// The surgery game's shell, once its scene runs.\n    pub shell: Option<crate::surgery::Shell>,\n    shell_ctx: Option<egui::Context>,\n}\n''')\ns=s.replace('''    /// What `out` shows: the windows' text''','''    /// One frame of the surgery game's shell and HUD, as the window draws them. A persistent\n    /// context: the shell keeps its own state between frames.\n    pub fn frame_surgery(&mut self, f: &pav_core::games::surgery::frame::SurgeryFrame, vp: Mat4, width: u32, height: u32) -> Drawn {\n        let ctx = self.shell_ctx.get_or_insert_with(|| {\n            let c = egui::Context::default();\n            crate::surgery::style::install_font(&c);\n            c\n        });\n        crate::surgery::style::set_canvas(ctx, height as f32, 1.0);\n        let shell = self.shell.get_or_insert_with(|| {\n            let mut s = crate::surgery::Shell::default();\n            s.screen = crate::surgery::Screen::Playing;\n            s\n        });\n        // Fonts land on the second pass: a capture may be the first frame.\n        let mut output = None;\n        let mut textures = egui::TexturesDelta::default();\n        for pass in 0..2 {\n            let raw = egui::RawInput {\n                screen_rect: Some(Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32) / ctx.zoom_factor())),\n                time: Some(pass as f64 / 60.0),\n                predicted_dt: 1.0 / 60.0,\n                ..Default::default()\n            };\n            let input = crate::surgery::ShellInput { device: self.device, dt: if pass == 1 { 1.0 / 60.0 } else { 0.0 }, ..Default::default() };\n            let mut out = ctx.run_ui(raw, |ui| {\n                let c = ui.ctx().clone();\n                shell.frame(&c, &input, Some(f), vp);\n            });\n            textures.append(std::mem::take(&mut out.textures_delta));\n            output = Some(out);\n        }\n        shell.cmds.clear();\n        let output = output.unwrap();\n        let ctx = ctx.clone();\n        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\n        let reading = self.read(&output, screen, Vec::new());\n        let pixels_per_point = output.pixels_per_point;\n        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\n        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands: Vec::new() }\n    }\n\n    /// What `out` shows: the windows' text''')\nopen(p,'w').write(s)\np='crates/pav_tools/src/session.rs'\ns=open(p).read()\ns=s.replace('''        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));''','''        let drawn = if let Some(g) = &frame.surgery {\n            Some(self.ui.frame_surgery(g, vp, width, height))\n        } else {\n            has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n        };''')\ns=s.replace('''        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''','''        self.camera.snap(frame.focus);\n        if let Some(g) = &frame.surgery {\n            pav_view::surgery::apply_shot(&mut self.camera, &g.shot);\n            let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n            return Some(self.ui.frame_surgery(g, vp, width, height));\n        }\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''')\ns=s.replace('''    frame.game.is_some() || !frame.hud.lines.is_empty()\n''','''    frame.game.is_some() || !frame.hud.lines.is_empty() || frame.surgery.is_some()\n''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"render_ui\\|fn t_capture\" crates/pav_tools/src/tools.rs | head -5; CARGO_BUILD_JOBS=10 cargo check --locked -p pav_ui 2>&1 | grep -E \"^error|^warning: unused|^ +--> \" | head -50; CARGO_BUILD_JOBS=10 cargo check --locked -p pav_ui 2>&1 | tail -2","description":"Write the HUD, story, results, dev and card screens, then type-check","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22780,"cache_read_input_tokens":546351,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22780},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"06ba7942-f5c1-4ff3-9d37-cfe0f23f408c","timestamp":"2026-11-05T14:25:22.971Z","request_id":"req_011CgjvpLsaW6RSbwAD6XUoH","wire_tool_inputs":{"toolu_01RESAnDs2TWCxHb6kmJMQEH":{"command":"cat > crates/pav_ui/src/surgery/hud.rs <<'EOF'\n//! The operation HUD: heart and vitals, the live ECG, the countdown, the tray's labels, the gift\n//! meter, the speaker cameo, the NOW line, and everything anchored to the field.\n\nuse std::f32::consts::TAU;\n\nuse egui::epaint::{Mesh, Vertex};\nuse egui::{Align2, Color32, Painter, Pos2, Rect, Stroke, StrokeKind, pos2, vec2};\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::field::{HazardKind as K, Rating, Tool, polyline_at};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::surgeon::tray_x;\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, DIM, GOLD, GREEN, INK, RED, SEATS, TEAL};\nuse super::{Shell, ShellInput};\nuse crate::Device;\n\n/// The trace's memory: value per sample.\n#[derive(Default)]\npub struct HudState {\n    trace: Vec<(f32, f32)>,\n    clock: f32,\n    last_time: f32,\n    pub stamp_t: f32,\n    pub stats: String,\n}\n\n/// One beat of ECG: P, QRS, T. Phase 0 is the R wave.\npub fn ecg_wave(phase: f32) -> f32 {\n    let g = |c: f32, w: f32, x: f32| (-(x - c) * (x - c) / w).exp();\n    let x = phase;\n    let x2 = if x > 0.5 { x - 1.0 } else { x };\n    g(0.0, 0.00022, x2) * 1.0 - g(-0.03, 0.0002, x2) * 0.14 - g(0.035, 0.0003, x2) * 0.26 + g(0.26, 0.0028, x2) * 0.26 + g(-0.18, 0.0014, x2) * 0.13\n}\n\npub struct Projector {\n    pub vp: Mat4,\n    pub rect: Rect,\n}\n\nimpl Projector {\n    pub fn at(&self, p: Vec3) -> Pos2 {\n        let c = self.vp.project_point3(p);\n        pos2(self.rect.min.x + (c.x * 0.5 + 0.5) * self.rect.width(), self.rect.min.y + (0.5 - c.y * 0.5) * self.rect.height())\n    }\n    pub fn field(&self, p: Vec2) -> Pos2 {\n        self.at(Vec3::new(p.x, 0.55, p.y))\n    }\n    /// About how many points one field unit is across here.\n    pub fn scale(&self, p: Vec2) -> f32 {\n        self.field(p).distance(self.field(p + Vec2::X))\n    }\n}\n\nfn rating_color(r: Rating) -> Color32 {\n    match r {\n        Rating::Immaculate => Color32::from_rgb(255, 224, 110),\n        Rating::Clean => Color32::from_rgb(120, 236, 200),\n        Rating::Good => Color32::from_rgb(190, 214, 230),\n        Rating::Sloppy => Color32::from_rgb(232, 110, 90),\n    }\n}\n\n/// A gauge ring around a screen point.\nfn arc(p: &Painter, c: Pos2, r: f32, from: f32, to: f32, w: f32, color: Color32) {\n    let n = (((to - from) * 40.0).ceil() as usize).clamp(2, 64);\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let a = -std::f32::consts::FRAC_PI_2 + (from + (to - from) * k as f32 / n as f32) * TAU;\n            c + vec2(a.cos(), a.sin()) * r\n        })\n        .collect();\n    p.add(egui::Shape::line(pts, Stroke::new(w, color)));\n}\n\nfn dashed(p: &Painter, pr: &Projector, pts: &[Vec2], from: f32, color: Color32, time: f32) {\n    let len: f32 = pts.windows(2).map(|w| w[0].distance(w[1])).sum();\n    let mut s = from;\n    let dash = 0.3;\n    let shift = (time * 0.6).fract() * dash * 2.0;\n    s += shift.min((len - s).max(0.0));\n    while s < len {\n        let a = polyline_at(pts, s).0;\n        let b = polyline_at(pts, (s + dash).min(len)).0;\n        p.line_segment([pr.field(a), pr.field(b)], Stroke::new(7.0, Color32::from_black_alpha(150)));\n        p.line_segment([pr.field(a), pr.field(b)], Stroke::new(3.5, color));\n        s += dash * 2.0;\n    }\n}\n\nfn arrow(p: &Painter, from: Pos2, to: Pos2, color: Color32, w: f32) {\n    let d = (to - from).normalized();\n    let n = vec2(-d.y, d.x);\n    for (a, b) in [(from, to), (to, to - d * 14.0 + n * 9.0), (to, to - d * 14.0 - n * 9.0)] {\n        p.line_segment([a, b], Stroke::new(w + 3.0, Color32::from_black_alpha(160)));\n    }\n    for (a, b) in [(from, to), (to, to - d * 14.0 + n * 9.0), (to, to - d * 14.0 - n * 9.0)] {\n        p.line_segment([a, b], Stroke::new(w, color));\n    }\n}\n\n/// A red edge that pulses on the beat.\nfn vignette(p: &Painter, rect: Rect, color: Color32, a: f32, depth: f32) {\n    if a <= 0.0 {\n        return;\n    }\n    let mut m = Mesh::default();\n    let edge = style::with_alpha(color, a);\n    let clear = style::with_alpha(color, 0.0);\n    let mut quad = |p0: Pos2, p1: Pos2, p2: Pos2, p3: Pos2, c0: Color32, c1: Color32| {\n        let b = m.vertices.len() as u32;\n        for (q, c) in [(p0, c0), (p1, c0), (p2, c1), (p3, c1)] {\n            m.vertices.push(Vertex { pos: q, uv: egui::epaint::WHITE_UV, color: c });\n        }\n        m.indices.extend_from_slice(&[b, b + 1, b + 2, b, b + 2, b + 3]);\n    };\n    let (a0, b0) = (rect.min, rect.max);\n    let d = depth;\n    quad(a0, pos2(b0.x, a0.y), pos2(b0.x, a0.y + d), pos2(a0.x, a0.y + d), edge, clear);\n    quad(pos2(a0.x, b0.y), b0, pos2(b0.x, b0.y - d), pos2(a0.x, b0.y - d), edge, clear);\n    quad(a0, pos2(a0.x, b0.y), pos2(a0.x + d, b0.y), pos2(a0.x + d, a0.y), edge, clear);\n    quad(pos2(b0.x, a0.y), b0, pos2(b0.x - d, b0.y), pos2(b0.x - d, a0.y), edge, clear);\n    p.add(m);\n}\n\npub fn draw(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, vp: Mat4, i: &ShellInput) {\n    let pr = Projector { vp, rect };\n    if matches!(f.stage, Stage::Title | Stage::Card) {\n        return;\n    }\n    let time = f.clock;\n    field_marks(shell, p, &pr, f, time, i);\n    popups(p, &pr, f);\n    hud_top(shell, p, rect, f, i.dt);\n    tray_labels(shell, p, &pr, rect, f);\n    cameo_line(shell, p, rect, f);\n    if f.fever.is_some() || f.ring_in > 0 || f.heat_ring.is_some() {\n        fever(p, rect, f);\n    }\n    // Low vitals: a red edge on the beat.\n    let low = (1.0 - f.vitals / 30.0).clamp(0.0, 1.0);\n    if low > 0.0 && matches!(f.stage, Stage::Op | Stage::Code) {\n        let beat = (-f.beat * 5.0).exp();\n        let k = if shell.save.settings.reduce_flashes { 0.5 } else { beat };\n        vignette(p, rect, RED, low * (0.25 + 0.55 * k), 240.0);\n    }\n    if f.hush > 0.0 {\n        vignette(p, rect, Color32::from_rgb(170, 190, 255), f.hush * 0.28, 300.0);\n        if f.hush > 0.5 {\n            style::outlined(p, rect.center_top() + vec2(0.0, 196.0), Align2::CENTER_CENTER, if f.duet { \"THE DUET\" } else { \"THE HUSH\" }, 48.0, style::with_alpha(Color32::WHITE, f.hush));\n        }\n    }\n    if f.echo > 0.5 && f.hush <= 0.5 {\n        style::outlined(p, rect.center_top() + vec2(0.0, 196.0), Align2::CENTER_CENTER, \"THE ECHO\", 48.0, style::with_alpha(Color32::from_rgb(160, 220, 255), f.echo));\n    }\n    if let Some(c) = &f.code {\n        code(shell, p, rect, f, c);\n    }\n    if let Some((text, age)) = &f.banner {\n        banner(p, rect, text, *age);\n    }\n    if shell.chart_open {\n        chart_overlay(shell, p, rect, f);\n    }\n    if i.chart && matches!(f.stage, Stage::Op | Stage::OpStart) {\n        shell.chart_open = !shell.chart_open;\n    }\n}\n\nfn field_marks(shell: &mut Shell, p: &Painter, pr: &Projector, f: &SurgeryFrame, time: f32, i: &ShellInput) {\n    let tool = f.surgeons.first().map(|s| s.tool).unwrap_or(Tool::Scalpel);\n    let hover = i.pointer.filter(|_| shell.device == Device::KeyboardMouse);\n    for h in &f.hazards {\n        if h.hidden && h.reveal <= 0.0 {\n            continue;\n        }\n        let c = pr.field(h.touch_point());\n        let u = pr.scale(h.pos).max(20.0);\n        let valid = h.accepts(tool);\n        let guide = f.guide == h.id;\n        let hovered = hover.is_some_and(|q| q.distance(c) < (h.r * u + 26.0));\n        match h.kind {\n            K::Incision | K::Tether | K::Closure => {\n                let color = if h.kind == K::Tether {\n                    Color32::from_rgb(210, 170, 255)\n                } else if h.kind == K::Closure {\n                    Color32::from_rgb(240, 240, 220)\n                } else {\n                    Color32::from_rgb(250, 250, 250)\n                };\n                if h.kind != K::Tether {\n                    dashed(p, pr, &h.pts, h.progress, color, time);\n                }\n                // Where the stroke starts, or resumes.\n                let pulse = (time * 5.0).sin() * 0.2 + 0.8;\n                p.circle_stroke(c, 12.0 + 3.0 * pulse, Stroke::new(3.5, style::with_alpha(color, pulse)));\n                if h.life > 0.0 {\n                    // A stroke with a deadline: the ring closes on it.\n                    let frac = (h.life / 3.0).clamp(0.0, 1.0);\n                    arc(p, c, 22.0, 0.0, frac, 4.0, GOLD);\n                }\n            }\n            K::Laceration | K::Bleeder => {\n                if tool == Tool::Suture || guide {\n                    let len: f32 = h.pts.windows(2).map(|w| w[0].distance(w[1])).sum();\n                    if h.progress < len {\n                        let (n, t) = polyline_at(&h.pts, h.progress);\n                        let side = Vec2::new(-t.y, t.x) * 0.5;\n                        let (a, b) = (pr.field(n + side), pr.field(n - side));\n                        p.line_segment([a, b], Stroke::new(3.0, style::with_alpha(TEAL, 0.9)));\n                        p.circle_filled(pr.field(n), 5.0, TEAL);\n                    }\n                }\n            }\n            K::Foreign | K::Tumor | K::Nodule | K::Eye | K::Furnace if h.accepts(Tool::Forceps) => {\n                if tool == Tool::Forceps || guide {\n                    let d = Vec2::from_angle(h.axis);\n                    let from = pr.field(h.pos + d * (h.r + 0.2));\n                    let to = pr.field(h.pos + d * (h.r + 1.1));\n                    arrow(p, from, to, GOLD, 4.0);\n                }\n                if h.kind == K::Nodule && h.life > 0.0 {\n                    let frac = (h.life / 1.6).clamp(0.0, 1.0);\n                    arc(p, c, h.r * u + 16.0, 0.0, frac, 5.0, RED);\n                }\n            }\n            K::Bone => {\n                if h.stage == 0 {\n                    // The home it wants: a ghost of the fragment at the right angle.\n                    let d = Vec2::from_angle(h.axis) * 0.9;\n                    let (a, b) = (pr.field(h.to - d), pr.field(h.to + d));\n                    p.line_segment([a, b], Stroke::new(14.0, Color32::from_rgba_unmultiplied(255, 255, 255, 60)));\n                    p.circle_stroke(pr.field(h.to), 0.35 * u, Stroke::new(2.5, style::with_alpha(GREEN, 0.8)));\n                    if h.by != 0 {\n                        let off = pav_core::games::surgery::field::angle_diff(h.angle, h.axis).to_degrees();\n                        let txt = format!(\"{off:+.0}°\");\n                        style::outlined(p, c + vec2(40.0, -40.0), Align2::LEFT_CENTER, &txt, 36.0, if off.abs() < 12.0 { GREEN } else { GOLD });\n                        shell_rotate_hint(shell, p, c + vec2(40.0, 0.0));\n                    }\n                }\n            }\n            _ => {}\n        }\n        // Rings: laser and probe heat, with the green band.\n        let heat_like = matches!(h.kind, K::Polyp | K::Ember | K::Nodule | K::Sac | K::Furnace);\n        if heat_like && h.heat > 0.01 && h.count == 0 {\n            let r = (h.r * u).max(26.0) + 16.0;\n            let frost = h.kind == K::Ember || (h.kind == K::Furnace && h.stage == 0);\n            p.circle_stroke(c, r, Stroke::new(8.0, Color32::from_black_alpha(150)));\n            arc(p, c, r, 0.0, 0.77, 7.0, Color32::from_gray(70));\n            arc(p, c, r, 0.615, 0.77, 7.0, GREEN);\n            let fill = (h.heat / 1.3).clamp(0.0, 1.0);\n            let col = if h.heat > 1.0 {\n                RED\n            } else if frost {\n                Color32::from_rgb(150, 220, 255)\n            } else {\n                Color32::from_rgb(255, 170, 70)\n            };\n            arc(p, c, r, 0.0, fill, 7.0, col);\n        }\n        // Gel coverage.\n        if h.accepts(Tool::Gel) {\n            let r = (h.r * u).max(20.0) + 10.0;\n            if h.progress > 0.0 {\n                arc(p, pr.field(h.pos), r, 0.0, h.progress.clamp(0.0, 1.0), 6.0, Color32::from_rgb(120, 240, 200));\n            }\n        }\n        // A sac swelling to burst.\n        if h.kind == K::Sac && h.progress > 0.62 {\n            let r = h.r * u + 10.0;\n            p.circle_stroke(pr.field(h.pos), r, Stroke::new(3.0, style::with_alpha(RED, (h.progress - 0.6) * 2.0)));\n        }\n        // Scanner: how long what it found stays lit.\n        if h.hidden && h.reveal > 0.0 {\n            arc(p, pr.field(h.pos), h.r * u + 18.0, 0.0, (h.reveal / 8.0).clamp(0.0, 1.0), 3.5, Color32::from_rgb(120, 220, 255));\n        }\n        if guide || (hovered && valid) || (valid && h.required && f.guided) {\n            let pulse = (time * 6.0).sin() * 0.25 + 0.75;\n            let r = (h.r * u).max(18.0) + 8.0 + pulse * 6.0;\n            let col = if guide { GOLD } else { Color32::WHITE };\n            let target = if h.kind == K::Bleeder { pr.field(h.pos) } else { c };\n            p.circle_stroke(target, r, Stroke::new(3.0, style::with_alpha(col, pulse)));\n        }\n    }\n    // Pings from the Scanner.\n    for (at, t) in &f.pings {\n        let k = (t / 0.8).clamp(0.0, 1.0);\n        let c = pr.field(*at);\n        let u = pr.scale(*at);\n        p.circle_stroke(c, k * 3.2 * u, Stroke::new(3.0, style::with_alpha(Color32::from_rgb(120, 220, 255), 1.0 - k)));\n    }\n    // Cursors: a small reticle, and names in co-op.\n    let many = f.surgeons.iter().filter(|s| s.present).count() > 1;\n    for s in &f.surgeons {\n        if !s.present || matches!(f.stage, Stage::Results | Stage::Dead) {\n            continue;\n        }\n        let at = pr.field(s.cursor);\n        let col = SEATS[s.slot as usize % 4];\n        p.circle_stroke(at, 10.0, Stroke::new(3.0, Color32::from_black_alpha(170)));\n        p.circle_stroke(at, 10.0, Stroke::new(2.0, col));\n        if s.chain >= 2 {\n            style::outlined(p, at + vec2(18.0, -26.0), Align2::LEFT_CENTER, &format!(\"{}×\", s.chain), 34.0, GOLD);\n        }\n        if many {\n            style::outlined(p, at + vec2(18.0, 20.0), Align2::LEFT_CENTER, &s.name, 28.0, col);\n        }\n        if s.tool == Tool::Gel {\n            let r = Rect::from_min_size(at + vec2(-24.0, 20.0), vec2(48.0, 7.0));\n            p.rect_filled(r, 3.0, Color32::from_black_alpha(170));\n            p.rect_filled(Rect::from_min_size(r.min, vec2(48.0 * s.flow.clamp(0.0, 1.0), 7.0)), 3.0, Color32::from_rgb(120, 240, 200));\n        }\n        if s.tool == Tool::Iv && (s.iv_on || s.iv_cool > 0.0) {\n            iv_gauge(p, pr, s);\n        }\n    }\n    // The Dies Irae's sweep: a big warning.\n    if let Some(r) = f.heat_ring {\n        let c = pr.field(Vec2::new(0.0, 0.2));\n        let u = pr.scale(Vec2::ZERO);\n        p.circle_stroke(c, r * u, Stroke::new(5.0, Color32::from_rgb(255, 170, 70)));\n    }\n}\n\nfn shell_rotate_hint(shell: &mut Shell, p: &Painter, at: Pos2) {\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Rotate);\n    glyphs::draw(p, at, 34.0, g, Action::Rotate);\n}\n\nfn iv_gauge(p: &Painter, pr: &Projector, s: &pav_core::games::surgery::frame::SurgeonView) {\n    let c = pr.field(Vec2::new(8.3, 3.9));\n    let r = Rect::from_min_size(c + vec2(-100.0, -86.0), vec2(200.0, 22.0));\n    p.rect_filled(r, 6.0, Color32::from_black_alpha(190));\n    // The green band: 75 to 100% of a dose.\n    let w = r.width() / 1.25;\n    p.rect_filled(Rect::from_min_size(r.min + vec2(w * 0.75, 0.0), vec2(w * 0.25, 22.0)), 2.0, style::with_alpha(GREEN, 0.7));\n    let col = if s.dose > 1.0 { RED } else { Color32::WHITE };\n    p.rect_filled(Rect::from_min_size(r.min, vec2(w * s.dose.clamp(0.0, 1.25), 22.0)), 4.0, style::with_alpha(col, 0.72));\n    if s.iv_cool > 0.0 && !s.iv_on {\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, &format!(\"{:.0}\", s.iv_cool.ceil()), 26.0, DIM);\n    } else {\n        style::outlined(p, r.center_top() - vec2(0.0, 18.0), Align2::CENTER_CENTER, \"IV\", 28.0, INK);\n    }\n}\n\nfn popups(p: &Painter, pr: &Projector, f: &SurgeryFrame) {\n    for q in &f.popups {\n        let at = pr.field(q.pos) + vec2(0.0, -40.0 - q.age * 70.0);\n        let a = (1.3 - q.age).clamp(0.0, 1.0);\n        let punch = 1.0 + ((0.12 - q.age).max(0.0) / 0.12) * 0.4;\n        let size = if q.rating == Rating::Immaculate { 58.0 } else { 46.0 } * punch;\n        style::outlined(p, at, Align2::CENTER_CENTER, q.rating.word(), size, style::with_alpha(rating_color(q.rating), a));\n        if q.on_beat {\n            style::outlined(p, at + vec2(0.0, 44.0), Align2::CENTER_CENTER, \"ON BEAT\", 34.0, style::with_alpha(Color32::from_rgb(140, 255, 220), a));\n        }\n        if q.points > 0 {\n            style::outlined(p, at + vec2(0.0, -40.0), Align2::CENTER_CENTER, &format!(\"+{}\", q.points), 30.0, style::with_alpha(INK, a));\n        }\n    }\n}\n\nfn hud_top(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, dt: f32) {\n    // Backing strip.\n    let strip = Rect::from_min_size(rect.min, vec2(rect.width(), 104.0));\n    p.rect_filled(strip, 0.0, Color32::from_rgba_unmultiplied(4, 14, 18, 190));\n    // Heart, pulsing on the beat, and the big number.\n    let beat = if f.flat { 0.0 } else { (-f.beat * 6.0).exp() };\n    let hc = rect.min + vec2(62.0, 52.0);\n    let s = 24.0 + beat * 7.0;\n    let color = if f.vitals < 25.0 { RED } else { Color32::from_rgb(240, 90, 90) };\n    heart(p, hc, s, color);\n    let v = f.vitals.max(0.0).ceil() as i32;\n    style::outlined(p, hc + vec2(48.0, -2.0), Align2::LEFT_CENTER, &format!(\"{v}\"), 76.0, if f.vitals < 25.0 { RED } else { Color32::WHITE });\n    let bar = Rect::from_min_size(rect.min + vec2(204.0, 34.0), vec2(290.0, 36.0));\n    p.rect_filled(bar, 8.0, Color32::from_black_alpha(190));\n    let frac = (f.vitals / f.vitals_max.max(1.0)).clamp(0.0, 1.0);\n    let bar_col = if f.vitals < 25.0 {\n        RED\n    } else if f.vitals < 50.0 {\n        GOLD\n    } else {\n        GREEN\n    };\n    p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * frac, 36.0)), 8.0, bar_col);\n    p.rect_stroke(bar, 8.0, Stroke::new(2.0, Color32::from_white_alpha(70)), StrokeKind::Inside);\n    // The ECG: a live sweep; samples in, oldest out.\n    ecg(shell, p, Rect::from_min_size(rect.min + vec2(520.0, 8.0), vec2(rect.width() - 520.0 - 280.0, 88.0)), f, dt);\n    // The countdown.\n    let t = f.timer.max(0.0);\n    let txt = format!(\"{}:{:02}\", (t / 60.0) as i32, (t as i32) % 60);\n    let low = t < 30.0;\n    style::outlined(p, rect.right_top() + vec2(-40.0, 52.0), Align2::RIGHT_CENTER, &txt, 76.0, if low { RED } else { Color32::WHITE });\n    // NOW: the one objective line.\n    if matches!(f.stage, Stage::Op | Stage::OpStart) && !f.objective.is_empty() {\n        let g = shell.glyphs();\n        let c = rect.center_top() + vec2(0.0, 134.0);\n        let w = (f.objective.chars().count() as f32 * 15.5 + 110.0).min(rect.width() - 200.0);\n        let r = Rect::from_center_size(c, vec2(w, 48.0));\n        p.rect_filled(r, 8.0, Color32::from_rgba_unmultiplied(4, 14, 18, 170));\n        style::outlined(p, r.left_center() + vec2(16.0, 0.0), Align2::LEFT_CENTER, \"NOW\", 34.0, GOLD);\n        style::outlined(p, r.left_center() + vec2(84.0, 0.0), Align2::LEFT_CENTER, &f.objective, 34.0, Color32::WHITE);\n        let _ = g;\n    }\n}\n\nfn heart(p: &Painter, c: Pos2, s: f32, color: Color32) {\n    p.circle_filled(c + vec2(-s * 0.45, -s * 0.28), s * 0.56, color);\n    p.circle_filled(c + vec2(s * 0.45, -s * 0.28), s * 0.56, color);\n    p.add(egui::Shape::convex_polygon(\n        vec![c + vec2(-s * 0.96, -s * 0.12), c + vec2(s * 0.96, -s * 0.12), c + vec2(0.0, s * 0.96)],\n        color,\n        Stroke::NONE,\n    ));\n}\n\nfn ecg(shell: &mut Shell, p: &Painter, r: Rect, f: &SurgeryFrame, dt: f32) {\n    let h = &mut shell.hud;\n    if f.clock < h.last_time {\n        h.trace.clear();\n    }\n    h.last_time = f.clock;\n    h.clock += dt.max(0.0);\n    let value = if f.flat { 0.0 } else { ecg_wave(f.beat) };\n    // In a strain's meter the accent beat runs tall: the eye can count it.\n    let accent = if f.meter > 0 && f.bar_beat == 0 { 1.22 } else { 1.0 };\n    h.trace.push((h.clock, value * accent));\n    let span = 3.2;\n    let cut = h.clock - span;\n    if h.trace.first().is_some_and(|s| s.0 < cut) {\n        let keep = h.trace.partition_point(|s| s.0 < cut);\n        h.trace.drain(..keep);\n    }\n    p.rect_filled(r, 8.0, Color32::from_rgba_unmultiplied(0, 24, 18, 200));\n    // Grid.\n    for k in 1..8 {\n        let x = r.min.x + r.width() * k as f32 / 8.0;\n        p.line_segment([pos2(x, r.min.y), pos2(x, r.max.y)], Stroke::new(1.0, Color32::from_rgba_unmultiplied(70, 180, 120, 26)));\n    }\n    let mid = r.center().y + r.height() * 0.18;\n    let amp = r.height() * 0.58;\n    let color = if f.flat { Color32::from_rgb(230, 80, 70) } else { GREEN };\n    let pts: Vec<Pos2> = h\n        .trace\n        .iter()\n        .map(|(t, v)| pos2(r.max.x - (h.clock - t) / span * r.width(), mid - v * amp))\n        .collect();\n    if pts.len() >= 2 {\n        p.add(egui::Shape::line(pts.clone(), Stroke::new(7.0, Color32::from_rgba_unmultiplied(60, 240, 150, 40))));\n        p.add(egui::Shape::line(pts, Stroke::new(3.0, color)));\n    }\n    // The bpm and the meter.\n    let label = if f.meter > 0 { format!(\"{} bpm · {}/{}\", f.bpm.round(), f.meter, if f.meter == 6 || f.meter == 7 { 8 } else { 4 }) } else { format!(\"{} bpm\", f.bpm.round()) };\n    style::outlined(p, r.left_top() + vec2(10.0, 24.0), Align2::LEFT_CENTER, &label, 32.0, if f.meter > 0 { GOLD } else { INK });\n}\n\nfn tray_labels(shell: &mut Shell, p: &Painter, pr: &Projector, rect: Rect, f: &SurgeryFrame) {\n    if !matches!(f.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete) {\n        return;\n    }\n    let g = shell.glyphs();\n    let selected = f.surgeons.first().map(|s| s.tool);\n    let dirs: [Vec2; 8] = [\n        Vec2::new(0.0, -1.0),\n        Vec2::new(0.7, -0.7),\n        Vec2::new(1.0, 0.0),\n        Vec2::new(0.7, 0.7),\n        Vec2::new(0.0, 1.0),\n        Vec2::new(-0.7, 0.7),\n        Vec2::new(-1.0, 0.0),\n        Vec2::new(-0.7, -0.7),\n    ];\n    for (i, tool) in f.ring.iter().enumerate() {\n        let at = pr.at(Vec3::new(tray_x(i), 1.0, 6.05));\n        let sel = selected == Some(*tool);\n        // The hint: a flick direction on a pad, a digit on keys.\n        let hint = at + vec2(-58.0, -2.0);\n        if g.device == Device::Gamepad {\n            p.circle_filled(hint, 19.0, Color32::from_rgba_unmultiplied(0, 0, 0, 190));\n            let d = dirs[i];\n            arrow(p, hint - vec2(d.x, d.y) * 8.0, hint + vec2(d.x, d.y) * 12.0, if sel { GOLD } else { INK }, 3.0);\n        } else {\n            let k = Rect::from_center_size(hint, vec2(32.0, 32.0));\n            p.rect_filled(k, 6.0, Color32::from_rgb(232, 236, 236));\n            p.text(k.center(), Align2::CENTER_CENTER, format!(\"{}\", i + 1), style::font(26.0), Color32::from_rgb(24, 28, 32));\n        }\n        let name = short_name(*tool);\n        let c = if sel { GOLD } else { INK };\n        style::outlined(p, at + vec2(-32.0, -2.0), Align2::LEFT_CENTER, name, 30.0, c);\n        if sel {\n            p.rect_filled(Rect::from_center_size(at + vec2(10.0, 20.0), vec2(120.0, 5.0)), 2.0, GOLD);\n        }\n    }\n    // The gift meter, on the tray's right.\n    if let Some(s) = f.surgeons.first() {\n        if f.gift_awake {\n            gift_meter(shell, p, rect, f, s);\n        }\n    }\n    // One line of prompts, top of the tray.\n    let y = rect.max.y - 158.0;\n    if matches!(f.stage, Stage::Op) {\n        let mut x = rect.min.x + 280.0;\n        let tool = selected.unwrap_or(Tool::Scalpel);\n        let (label, a) = (use_word(tool), Action::Use);\n        shell.prompted(g, a);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, a, label, INK);\n        shell.prompted(g, Action::Pick);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Pick, \"Instrument\", INK);\n        shell.prompted(g, Action::Cancel);\n        x = glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Cancel, \"Let go\", INK);\n        shell.prompted(g, Action::Chart);\n        glyphs::labeled(p, pos2(x, y), 34.0, g, Action::Chart, \"Chart\", INK);\n    }\n}\n\nfn use_word(t: Tool) -> &'static str {\n    match t {\n        Tool::Scalpel => \"Cut\",\n        Tool::Forceps => \"Grab and pull\",\n        Tool::Suture => \"Stitch\",\n        Tool::Suction => \"Suction\",\n        Tool::Laser => \"Burn\",\n        Tool::Gel => \"Paint\",\n        Tool::Scanner => \"Sweep\",\n        Tool::Iv => \"Push\",\n        Tool::Cryo => \"Freeze\",\n        Tool::Dressing => \"Dress\",\n        Tool::Defib => \"Charge\",\n    }\n}\n\nfn short_name(t: Tool) -> &'static str {\n    match t {\n        Tool::Iv => \"IV\",\n        Tool::Cryo => \"Cryo\",\n        other => other.name(),\n    }\n}\n\nfn gift_meter(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, s: &pav_core::games::surgery::frame::SurgeonView) {\n    let g = shell.glyphs();\n    let name = if f.duet || (f.case_no == 7) {\n        \"DUET\"\n    } else if s.gift_kind == 1 {\n        \"ECHO\"\n    } else {\n        \"HUSH\"\n    };\n    let c = rect.right_bottom() - vec2(150.0, 208.0);\n    let r = 62.0;\n    p.circle_filled(c, r + 6.0, Color32::from_black_alpha(190));\n    let frac = (s.gift / 100.0).clamp(0.0, 1.0);\n    let beat = (-f.beat * 5.0).exp();\n    arc(p, c, r, 0.0, 1.0, 11.0, Color32::from_gray(50));\n    let col = if s.gift_kind == 1 { Color32::from_rgb(150, 220, 255) } else { Color32::from_rgb(214, 200, 255) };\n    arc(p, c, r, 0.0, frac, 11.0, col);\n    style::outlined(p, c - vec2(0.0, 14.0), Align2::CENTER_CENTER, name, 34.0, if s.gift_ready { Color32::WHITE } else { DIM });\n    if s.gift_ready {\n        p.circle_stroke(c, r + 12.0 + beat * 10.0, Stroke::new(4.0, style::with_alpha(col, 0.4 + beat * 0.5)));\n        shell.prompted(g, Action::Gift);\n        glyphs::draw(p, c + vec2(-20.0, 24.0), 40.0, g, Action::Gift);\n        let msg = if s.gift_hold { \"Release on the beat!\" } else { \"Hold, then release on the beat\" };\n        style::outlined(p, c + vec2(-90.0, -92.0), Align2::RIGHT_CENTER, msg, 34.0, Color32::WHITE);\n    }\n}\n\nfn cameo_line(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let Some(sub) = &f.subtitle else { return };\n    let a = ((5.0 - sub.age) * 3.0).clamp(0.0, 1.0);\n    let box_r = Rect::from_min_size(rect.left_bottom() + vec2(30.0, -338.0), vec2(740.0, 134.0));\n    p.rect_filled(box_r, 10.0, style::with_alpha(Color32::from_rgb(4, 14, 18), 0.8 * a));\n    let cam = Rect::from_min_size(box_r.min + vec2(8.0, 8.0), vec2(118.0, 118.0));\n    super::story::cameo(shell, p, cam, &sub.who, \"neutral\", sub.age < 1.4 && (sub.age * 11.0).sin() > 0.0);\n    let content = pav_core::games::surgery::content::get();\n    let (title, accent) = content\n        .rigs\n        .get(&*sub.who)\n        .map(|r| (r.title.clone(), Color32::from_rgb(r.accent[0], r.accent[1], r.accent[2])))\n        .unwrap_or((sub.who.to_string(), INK));\n    style::outlined(p, box_r.min + vec2(140.0, 26.0), Align2::LEFT_CENTER, &title, 30.0, style::with_alpha(accent, a));\n    style::wrapped(p, box_r.min + vec2(140.0, 46.0), box_r.width() - 156.0, &sub.text, 32.0, style::with_alpha(Color32::WHITE, a));\n}\n\nfn fever(p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    if let Some(v) = f.fever {\n        let at = rect.min + vec2(30.0, 118.0);\n        style::outlined(p, at + vec2(0.0, 22.0), Align2::LEFT_CENTER, \"FEVER\", 34.0, Color32::from_rgb(255, 170, 70));\n        let bar = Rect::from_min_size(at + vec2(96.0, 6.0), vec2(366.0, 32.0));\n        p.rect_filled(bar, 8.0, Color32::from_black_alpha(190));\n        let col = if v > 100.0 { RED } else { Color32::from_rgb(255, 150, 60) };\n        p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * (v / 100.0).clamp(0.0, 1.0), 32.0)), 8.0, col);\n    }\n    // The count-in: \"lift off\" is a rhythm.\n    if f.ring_in > 0 && f.ring_in <= 2 {\n        let c = rect.center() + vec2(0.0, -200.0);\n        let beat = (-f.beat * 4.0).exp();\n        let text = if f.ring_in == 1 { \"LIFT OFF!\" } else { \"RING COMING\" };\n        style::outlined(p, c, Align2::CENTER_CENTER, text, 70.0 + beat * 16.0, Color32::from_rgb(255, 180, 90));\n    }\n}\n\nfn code(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, c: &pav_core::games::surgery::frame::CodeView) {\n    let g = shell.glyphs();\n    let center = rect.center();\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(40, 0, 0, 120));\n    if !c.scripted {\n        style::outlined(p, center + vec2(0.0, -330.0), Align2::CENTER_CENTER, &format!(\"{:.1}\", c.left.max(0.0)), 110.0, RED);\n    }\n    let track = Rect::from_center_size(center + vec2(0.0, -120.0), vec2(1100.0, 120.0));\n    p.rect_filled(track, 10.0, Color32::from_black_alpha(200));\n    // The flat line, the centre mark, the ghost beat crossing.\n    p.line_segment([track.left_center(), track.right_center()], Stroke::new(3.0, Color32::from_rgb(230, 80, 70)));\n    let mid_x = track.center().x;\n    p.line_segment([pos2(mid_x, track.min.y), pos2(mid_x, track.max.y)], Stroke::new(4.0, GOLD));\n    let zone = Rect::from_center_size(track.center(), vec2(track.width() * 0.25, track.height()));\n    p.rect_filled(zone, 0.0, style::with_alpha(GREEN, 0.12));\n    let x = track.min.x + track.width() * c.ghost;\n    let col = Color32::from_rgb(190, 235, 255);\n    let n = 40;\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let t = k as f32 / n as f32 - 0.5;\n            pos2(x + t * 200.0, track.center().y - ecg_wave(t * 0.6) * 48.0)\n        })\n        .filter(|q| q.x > track.min.x && q.x < track.max.x)\n        .collect();\n    if pts.len() > 1 {\n        p.add(egui::Shape::line(pts, Stroke::new(5.0, col)));\n    }\n    // Charge.\n    let charge = f.surgeons.iter().map(|s| s.charge).fold(0.0f32, f32::max);\n    let bar = Rect::from_center_size(center + vec2(0.0, 12.0), vec2(620.0, 40.0));\n    p.rect_filled(bar, 10.0, Color32::from_black_alpha(200));\n    p.rect_filled(Rect::from_min_size(bar.min, vec2(bar.width() * charge, 40.0)), 10.0, if charge >= 1.0 { GREEN } else { Color32::from_rgb(150, 210, 255) });\n    let msg = if charge >= 1.0 { \"CHARGED: release on the line\" } else { \"Hold to charge\" };\n    shell.prompted(g, Action::Defib);\n    let w = glyphs::draw(p, center + vec2(-280.0, 86.0), 56.0, g, Action::Defib);\n    style::outlined(p, center + vec2(-280.0 + w + 16.0, 86.0), Align2::LEFT_CENTER, msg, 50.0, Color32::WHITE);\n    if c.shocks > 1 {\n        style::outlined(p, center + vec2(0.0, 160.0), Align2::CENTER_CENTER, &format!(\"{} shocks to go\", c.shocks), 44.0, GOLD);\n    }\n}\n\nfn banner(p: &Painter, rect: Rect, text: &str, age: f32) {\n    let c = rect.center() + vec2(0.0, -40.0);\n    let in_t = (age / 0.18).clamp(0.0, 1.0);\n    let out = ((2.6 - age) / 0.5).clamp(0.0, 1.0);\n    let a = in_t * out;\n    let size = 110.0 + (1.0 - in_t) * 60.0;\n    let w = rect.width();\n    p.rect_filled(Rect::from_center_size(c, vec2(w, 160.0)), 0.0, Color32::from_rgba_unmultiplied(0, 0, 0, (150.0 * a) as u8));\n    style::outlined(p, c, Align2::CENTER_CENTER, text, size, style::with_alpha(Color32::WHITE, a));\n}\n\nfn chart_overlay(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let content = pav_core::games::surgery::content::get();\n    let Some(case) = content.case(f.case_no) else { return };\n    let r = Rect::from_center_size(rect.center(), vec2(980.0, 560.0));\n    p.rect_filled(r, 12.0, style::PAPER);\n    let ink = style::PAPER_INK;\n    let mut y = r.min.y + 28.0;\n    let x = r.min.x + 40.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"{}: {}\", case.name, case.patient), 48.0, ink);\n    y += 76.0;\n    y = style::wrapped(p, pos2(x, y), r.width() - 80.0, &case.diagnosis, 34.0, ink) + 18.0;\n    let phase = case.phase.get(f.phase as usize);\n    if let Some(ph) = phase {\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"Phase {} of {}: {}\", f.phase + 1, case.phase.len(), ph.name), 36.0, ink);\n        y += 56.0;\n    }\n    let left = f.hazards.iter().filter(|h| h.required && (!h.hidden || h.reveal > 0.0)).count();\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &format!(\"Tasks in view: {left}\"), 36.0, ink);\n    y += 56.0;\n    let hidden = f.hazards.iter().any(|h| h.hidden && h.reveal <= 0.0);\n    if hidden {\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Something on the film is not in view. Scanner.\", 36.0, style::RED);\n    }\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Chart);\n    glyphs::labeled(p, r.left_bottom() + vec2(40.0, -40.0), 36.0, g, Action::Chart, \"Close\", ink);\n}\nEOF\ncat > crates/pav_ui/src/surgery/story.rs <<'EOF'\n//! The story player's screen: a large dialogue box, the backlog, the prompts. And the cameo: the\n//! same rig data, flattened into a mesh for the HUD.\n\nuse egui::epaint::{Mesh, Vertex};\nuse egui::{Align2, Color32, Painter, Pos2, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::paper;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, INK};\nuse super::{Shell, ShellInput};\n\n/// A rig, flattened: (colour, points, triangles), back to front.\npub struct Cameo {\n    parts: Vec<(Color32, Vec<Pos2>, Vec<[u32; 3]>)>,\n    open: Vec<Pos2>,\n    closed: Vec<Pos2>,\n    open_t: Vec<[u32; 3]>,\n    closed_t: Vec<[u32; 3]>,\n}\n\nfn build_cameo(who: &str) -> Option<Cameo> {\n    let content = content::get();\n    let r = content.rigs.get(who)?;\n    let mut order: Vec<&content::PartDef> = r.part.iter().collect();\n    order.sort_by(|a, b| a.z.total_cmp(&b.z));\n    let mut parts = Vec::new();\n    for pd in order {\n        let c = r.palette.get(&pd.color).copied().unwrap_or([255, 255, 255]);\n        let color = Color32::from_rgb(c[0], c[1], c[2]);\n        let out = pd.outline();\n        let mut push = |pts: Vec<glam::Vec2>| {\n            let t = paper::triangulate(&pts);\n            parts.push((color, pts.iter().map(|q| pos2(q.x, -q.y)).collect(), t));\n        };\n        push(out.clone());\n        if pd.mirror {\n            push(out.iter().rev().map(|q| glam::Vec2::new(-q.x, q.y)).collect());\n        }\n    }\n    let shape = |list: &[[f32; 2]]| {\n        let v: Vec<glam::Vec2> = list.iter().map(|q| glam::Vec2::new(q[0], q[1])).collect();\n        let v = paper::chaikin(&v, 1);\n        let t = paper::triangulate(&v);\n        (v.iter().map(|q| pos2(q.x, -q.y)).collect::<Vec<_>>(), t)\n    };\n    let e = r.expr.get(\"neutral\")?;\n    let (open, open_t) = shape(&e.open);\n    let (closed, closed_t) = shape(&e.closed);\n    Some(Cameo { parts, open, closed, open_t, closed_t })\n}\n\n/// Draws a character's head and shoulders in a rect.\npub fn cameo(shell: &mut Shell, p: &Painter, r: Rect, who: &str, _expr: &str, talking: bool) {\n    if !shell.cameos_ref().contains_key(who) {\n        if let Some(c) = build_cameo(who) {\n            shell.cameos_mut().insert(who.to_string(), c);\n        }\n    }\n    let content = content::get();\n    let accent = content.rigs.get(who).map(|x| x.accent).unwrap_or([60, 70, 80]);\n    p.rect_filled(r, 10.0, Color32::from_rgb(accent[0] / 3, accent[1] / 3, accent[2] / 3));\n    let Some(c) = shell.cameos_ref().get(who) else { return };\n    let scale = r.height() / 4.6;\n    let origin = r.center() + vec2(0.0, r.height() * 0.08);\n    let clip = p.with_clip_rect(r);\n    let mut m = Mesh::default();\n    let mut add = |pts: &[Pos2], tris: &[[u32; 3]], col: Color32| {\n        let b = m.vertices.len() as u32;\n        for q in pts {\n            let at = origin + vec2(q.x, q.y) * scale;\n            m.vertices.push(Vertex { pos: at, uv: egui::epaint::WHITE_UV, color: col });\n        }\n        for t in tris {\n            m.indices.extend_from_slice(&[b + t[0], b + t[1], b + t[2]]);\n        }\n    };\n    for (col, pts, tris) in &c.parts {\n        add(pts, tris, *col);\n    }\n    let dark = Color32::from_rgb(92, 30, 40);\n    if talking {\n        add(&c.open, &c.open_t, dark);\n    } else {\n        add(&c.closed, &c.closed_t, dark);\n    }\n    clip.add(m);\n}\n\nimpl Shell {\n    pub fn cameos_ref(&self) -> &std::collections::HashMap<String, Cameo> {\n        &self.cameos\n    }\n    pub fn cameos_mut(&mut self) -> &mut std::collections::HashMap<String, Cameo> {\n        &mut self.cameos\n    }\n}\n\n/// Draws the dialogue box; returns nothing. Shared with attract's story segment.\nfn dialogue(p: &Painter, rect: Rect, f: &SurgeryFrame) -> Rect {\n    let Some(s) = &f.story else { return rect };\n    let box_r = Rect::from_min_size(rect.left_bottom() + vec2(120.0, -320.0), vec2(rect.width() - 240.0, 240.0));\n    p.rect_filled(box_r.translate(vec2(6.0, 8.0)), 16.0, Color32::from_black_alpha(120));\n    p.rect_filled(box_r, 16.0, Color32::from_rgba_unmultiplied(8, 22, 26, 238));\n    let content = content::get();\n    let narrator = &*s.who == \"narrator\";\n    let (title, accent) = content\n        .rigs\n        .get(&*s.who)\n        .map(|r| (r.title.clone(), Color32::from_rgb(r.accent[0], r.accent[1], r.accent[2])))\n        .unwrap_or((String::new(), INK));\n    p.rect_stroke(box_r, 16.0, egui::Stroke::new(3.0, style::with_alpha(accent, 0.8)), StrokeKind::Inside);\n    if !title.is_empty() {\n        let tag = Rect::from_min_size(box_r.left_top() + vec2(40.0, -34.0), vec2(title.len() as f32 * 21.0 + 44.0, 62.0));\n        p.rect_filled(tag, 10.0, accent);\n        style::plain(p, tag.center(), Align2::CENTER_CENTER, &title, 44.0, Color32::from_rgb(8, 16, 20));\n    }\n    let shown: String = s.text.chars().take(s.chars as usize).collect();\n    let color = if narrator { Color32::from_rgb(206, 226, 226) } else { Color32::WHITE };\n    style::wrapped(p, box_r.left_top() + vec2(44.0, 44.0), box_r.width() - 110.0, &shown, 42.0, color);\n    box_r\n}\n\npub fn draw_attract(_shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    dialogue(p, rect, f);\n}\n\npub fn draw(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(s) = &f.story else { return };\n    if s.flash > 0.0 && !shell.save.settings.reduce_flashes {\n        p.rect_filled(rect, 0.0, style::with_alpha(Color32::WHITE, (s.flash * 0.9).min(0.9)));\n    }\n    let box_r = dialogue(p, rect, f);\n    // A mark when the line is done, and the click area: anywhere.\n    if s.typed {\n        let beat = (shell.time * 4.0).sin() * 6.0;\n        let g = shell.glyphs();\n        shell.prompted(g, Action::Confirm);\n        super::glyphs::draw(p, box_r.right_bottom() + vec2(-78.0, -42.0 + beat), 44.0, g, Action::Confirm);\n    }\n    let auto_label = if shell.auto_advance { \"Auto: on\" } else { \"Auto: off\" };\n    shell.hints(p, rect, &[(Action::Skip, \"Skip scene\"), (Action::Backlog, \"Backlog\"), (Action::Auto, auto_label), (Action::Pause, \"Pause\")]);\n    if shell.backlog {\n        backlog(p, rect, f);\n        if i.chart || i.back || i.click || i.confirm {\n            shell.backlog = false;\n        }\n        return;\n    }\n    if i.chart {\n        shell.backlog = true;\n        return;\n    }\n    if i.alt {\n        shell.auto_advance = !shell.auto_advance;\n        shell.cue(pav_core::games::surgery::cue::NAV);\n    }\n    // Hold to skip the scene.\n    if i.confirm_held {\n        shell.hold += i.dt;\n        if shell.hold > 0.25 {\n            let k = ((shell.hold - 0.25) / 0.8).clamp(0.0, 1.0);\n            let r = Rect::from_min_size(box_r.left_bottom() + vec2(0.0, 6.0), vec2(box_r.width() * k, 10.0));\n            p.rect_filled(r, 5.0, style::GOLD);\n        }\n        if shell.hold > 1.05 {\n            shell.hold = 0.0;\n            shell.sim(SurgeryCmd::SkipScene);\n            return;\n        }\n    } else {\n        shell.hold = 0.0;\n    }\n    if i.confirm || i.click {\n        shell.sim(SurgeryCmd::Advance);\n        shell.auto_t = 0.0;\n    } else if shell.auto_advance && s.typed {\n        shell.auto_t += i.dt;\n        if shell.auto_t > 1.6 {\n            shell.auto_t = 0.0;\n            shell.sim(SurgeryCmd::Advance);\n        }\n    }\n}\n\nfn backlog(p: &Painter, rect: Rect, f: &SurgeryFrame) {\n    let Some(s) = &f.story else { return };\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.96));\n    style::outlined(p, rect.min + vec2(120.0, 80.0), Align2::LEFT_CENTER, \"Backlog\", 60.0, Color32::WHITE);\n    let content = content::get();\n    let Some(def) = content.stories.get(&*s.key) else { return };\n    let upto = (s.line as usize + 1).min(def.line.len());\n    let spoken: Vec<&content::LineDef> = def.line[..upto].iter().filter(|l| !l.who.is_empty()).collect();\n    // The last few lines that fit: no scrollbars.\n    let mut y = rect.max.y - 110.0;\n    for l in spoken.iter().rev().take(7) {\n        let title = content.rigs.get(&l.who).map(|r| r.title.clone()).unwrap_or_default();\n        let text = if title.is_empty() { l.text.clone() } else { format!(\"{title}: {}\", l.text) };\n        let galley = p.layout(text, style::font(36.0), INK, rect.width() - 240.0);\n        y -= galley.size().y + 16.0;\n        if y < rect.min.y + 130.0 {\n            break;\n        }\n        p.galley(pos2(rect.min.x + 120.0, y), galley, INK);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/results.rs <<'EOF'\n//! The chart card, the results with the rank stamp, the death screen and the end of a run.\n\nuse egui::{Align2, Color32, Painter, Rect, pos2, vec2};\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, PAPER, PAPER_INK, RED};\nuse super::{Screen, Shell, ShellInput};\n\nfn ease(t: f32) -> f32 {\n    let t = t.clamp(0.0, 1.0);\n    1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t)\n}\n\npub fn chart(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(c) = &f.chart else { return };\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(6, 18, 20, 140));\n    let slide = ease(c.t / 0.45);\n    let r = Rect::from_center_size(rect.center() + vec2(0.0, (1.0 - slide) * 800.0 - 30.0), vec2(1180.0, 720.0));\n    p.rect_filled(r.translate(vec2(8.0, 10.0)), 10.0, Color32::from_black_alpha(130));\n    p.rect_filled(r, 10.0, PAPER);\n    let x = r.min.x + 60.0;\n    let mut y = r.min.y + 44.0;\n    let case_label = if c.case_no == 255 { \"CODE BLUE\".to_string() } else { format!(\"CASE {}\", c.case_no) };\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &case_label, 42.0, PAPER_INK);\n    style::plain(p, pos2(r.max.x - 60.0, y), Align2::RIGHT_TOP, \"MERCY HARBOR GENERAL\", 36.0, PAPER_INK);\n    y += 60.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &c.case_name, 84.0, PAPER_INK);\n    y += 118.0;\n    style::line(p, pos2(x, y), pos2(r.max.x - 60.0, y), 3.0, PAPER_INK);\n    y += 24.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Patient\", 34.0, Color32::from_rgb(120, 100, 90));\n    style::plain(p, pos2(x + 200.0, y - 8.0), Align2::LEFT_TOP, &c.patient, 54.0, PAPER_INK);\n    y += 70.0;\n    y = style::wrapped(p, pos2(x + 200.0, y), r.width() - 320.0, &c.life, 36.0, PAPER_INK) + 26.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Diagnosis\", 34.0, Color32::from_rgb(120, 100, 90));\n    style::wrapped(p, pos2(x + 200.0, y), r.width() - 320.0, &c.diagnosis, 36.0, PAPER_INK);\n    let g = shell.glyphs();\n    shell.prompted(g, Action::Confirm);\n    super::glyphs::labeled(p, r.left_bottom() + vec2(60.0, -52.0), 46.0, g, Action::Confirm, \"Scrub in\", PAPER_INK);\n    if (i.confirm || i.click) && c.t > 0.2 {\n        shell.cue(cue::CONFIRM);\n        shell.sim(SurgeryCmd::Advance);\n    }\n}\n\npub fn results(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(r0) = &f.results else { return };\n    p.rect_filled(rect, 0.0, Color32::from_rgba_unmultiplied(6, 18, 20, 170));\n    let t = r0.t;\n    if !shell.saved_this_results {\n        // The rank is the player's to keep.\n        shell.saved_this_results = true;\n        let n = r0.case_no;\n        let rank = r0.rank.to_string();\n        shell.save.record(n, &rank);\n        if n < 8 && !f.attract {\n            if n + 1 > shell.save.furthest {\n                shell.save.furthest = (n + 1).min(7);\n            }\n            if !shell.case_files_mode {\n                shell.save.last_case = (n + 1).min(7);\n            }\n        }\n        shell.persist();\n    }\n    let slide = ease(t / 0.4);\n    let card = Rect::from_center_size(rect.center() + vec2(0.0, (1.0 - slide) * 900.0 - 20.0), vec2(1240.0, 820.0));\n    p.rect_filled(card.translate(vec2(8.0, 10.0)), 10.0, Color32::from_black_alpha(130));\n    p.rect_filled(card, 10.0, PAPER);\n    let x = card.min.x + 70.0;\n    let mut y = card.min.y + 40.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &r0.case_name, 70.0, PAPER_INK);\n    y += 92.0;\n    style::plain(p, pos2(x, y), Align2::LEFT_TOP, &r0.patient, 40.0, Color32::from_rgb(120, 100, 90));\n    y += 66.0;\n    style::line(p, pos2(x, y), pos2(card.max.x - 70.0, y), 3.0, PAPER_INK);\n    y += 20.0;\n    // Lines appear one at a time.\n    let lines: Vec<(String, i32)> = vec![\n        (\"Technique\".into(), r0.action_points),\n        (\"Vitals left\".into(), r0.vitals_bonus),\n        (\"Seconds left\".into(), r0.time_bonus),\n        (format!(\"Mistakes ({})\", r0.mistakes), -r0.mistake_penalty),\n    ];\n    let w = 680.0;\n    let mut shown = 0;\n    let start = 0.55;\n    for (k, (name, v)) in lines.iter().enumerate() {\n        let at = start + k as f32 * 0.38;\n        if t < at {\n            break;\n        }\n        shown = k + 1;\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, name, 44.0, PAPER_INK);\n        style::plain(p, pos2(x + w, y), Align2::RIGHT_TOP, &format!(\"{v}\"), 44.0, PAPER_INK);\n        y += 62.0;\n    }\n    if shown == lines.len() {\n        style::line(p, pos2(x, y + 2.0), pos2(x + w, y + 2.0), 3.0, PAPER_INK);\n        y += 12.0;\n        style::plain(p, pos2(x, y), Align2::LEFT_TOP, \"Total\", 56.0, PAPER_INK);\n        style::plain(p, pos2(x + w, y), Align2::RIGHT_TOP, &format!(\"{}\", r0.total), 56.0, PAPER_INK);\n        y += 80.0;\n    }\n    // The stamp slams.\n    let stamp_at = start + 0.38 * lines.len() as f32 + 0.3;\n    if t >= stamp_at {\n        let k = ((t - stamp_at) / 0.14).clamp(0.0, 1.0);\n        let scale = 2.2 - 1.2 * k;\n        let c = pos2(card.max.x - 240.0, card.min.y + 340.0);\n        let size = if r0.rank.len() > 1 { 96.0 } else { 220.0 };\n        let a = k;\n        let box_r = Rect::from_center_size(c, vec2(if r0.rank.len() > 1 { 390.0 } else { 240.0 }, 240.0) * scale);\n        p.rect_stroke(box_r, 16.0, egui::Stroke::new(10.0 * scale, style::with_alpha(RED, a)), egui::StrokeKind::Inside);\n        style::plain(p, c, Align2::CENTER_CENTER, &r0.rank, size * scale, style::with_alpha(RED, a));\n        // The patient's fate.\n        if t >= stamp_at + 0.4 {\n            style::wrapped(p, pos2(x, card.max.y - 180.0), card.width() - 140.0, &r0.fate, 40.0, PAPER_INK);\n        }\n        let g = shell.glyphs();\n        shell.prompted(g, Action::Confirm);\n        super::glyphs::labeled(p, card.left_bottom() + vec2(70.0, -50.0), 44.0, g, Action::Confirm, \"Go on\", PAPER_INK);\n        if (i.confirm || i.click) && t > stamp_at + 0.15 {\n            shell.cue(cue::CONFIRM);\n            shell.sim(SurgeryCmd::Advance);\n        }\n    } else if i.confirm || i.click {\n        // Don't make them wait for the arithmetic twice: skip ahead on the next frame by waiting.\n    }\n    let _ = y;\n    if r0.scores.len() > 1 {\n        let mut yy = card.min.y + 480.0;\n        for (slot, score) in &r0.scores {\n            let c = style::SEATS[*slot as usize % 4];\n            style::plain(p, pos2(card.max.x - 340.0, yy), Align2::LEFT_TOP, &format!(\"Surgeon {}\", slot + 1), 34.0, c);\n            style::plain(p, pos2(card.max.x - 70.0, yy), Align2::RIGHT_TOP, &format!(\"{score}\"), 34.0, PAPER_INK);\n            yy += 44.0;\n        }\n    }\n}\n\npub fn death(shell: &mut Shell, p: &Painter, rect: Rect, f: &SurgeryFrame, i: &ShellInput) {\n    let Some(d) = &f.death else { return };\n    p.rect_filled(rect, 0.0, Color32::BLACK);\n    let c = rect.center();\n    style::plain(p, pos2(c.x, c.y - 280.0), Align2::CENTER_CENTER, &format!(\"Time of death: {}.\", d.time), 92.0, Color32::WHITE);\n    style::wrapped(p, pos2(c.x - 620.0, c.y - 190.0), 1240.0, &d.fate, 40.0, style::DIM);\n    let mut items: Vec<String> = Vec::new();\n    if d.checkpoint {\n        items.push(\"Retry from the checkpoint\".into());\n    }\n    items.push(\"Retry from the start\".into());\n    items.push(\"Quit to Title\".into());\n    let chosen = shell.list(p, i, &items, pos2(c.x - 420.0, c.y - 20.0), 840.0, 104.0, 56.0);\n    shell.hints(p, rect, &[(Action::Nav, \"Choose\"), (Action::Confirm, \"Select\")]);\n    if let Some(k) = chosen {\n        let name = items[k].as_str();\n        match name {\n            \"Retry from the checkpoint\" => shell.sim(SurgeryCmd::Retry { from_start: false }),\n            \"Retry from the start\" => shell.sim(SurgeryCmd::Retry { from_start: true }),\n            _ => shell.quit_to_title(),\n        }\n        shell.focus = 0;\n    }\n}\n\n/// The run is over: back where it started from.\npub fn finished(shell: &mut Shell, p: &Painter, rect: Rect, _f: &SurgeryFrame, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.9));\n    let c = rect.center();\n    let case_files = shell.case_files_mode;\n    if case_files {\n        shell.load(\"surgery/title\");\n        shell.go(Screen::CaseFiles);\n        return;\n    }\n    style::outlined(p, pos2(c.x, c.y - 180.0), Align2::CENTER_CENTER, \"End of the First Movement\", 96.0, Color32::WHITE);\n    style::outlined(p, pos2(c.x, c.y - 60.0), Align2::CENTER_CENTER, \"The orchestra is tuning somewhere.\", 48.0, GOLD);\n    let total = \"Thank you for scrubbing in.\";\n    style::outlined(p, pos2(c.x, c.y + 30.0), Align2::CENTER_CENTER, total, 44.0, INK);\n    shell.hints(p, rect, &[(Action::Confirm, \"Credits\")]);\n    if i.confirm || i.click {\n        shell.load(\"surgery/title\");\n        shell.came_from = Screen::Title;\n        shell.go(Screen::About);\n    }\n}\nEOF\ncat > crates/pav_ui/src/surgery/dev.rs <<'EOF'\n//! Dev mode, from the pause menu: a large paged panel docked at the left with the field visible.\n//! Live sliders with their defaults marked and Reset All, then the tools.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::HazardKind;\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_core::games::surgery::tune::{SLIDERS, cheat};\nuse pav_core::input::SurgeryCmd;\n\nuse super::glyphs::Action;\nuse super::style::{self, GOLD, INK, TEAL};\nuse super::{Shell, ShellCmd, ShellInput};\n\nconst PER_PAGE: usize = 7;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Item {\n    Live,\n    Bot,\n    Slider(usize),\n    Reset,\n    Immortal,\n    Freeze,\n    FullGift,\n    OneHit,\n    TimeScale,\n    FrameStep,\n    JumpCase,\n    JumpPhase,\n    JumpGo,\n    SkipPhase,\n    WinCase,\n    ForceCode,\n    KillPatient,\n    SpawnKind,\n    Spawn,\n    OverlayRadii,\n    OverlayTargets,\n    OverlayBeat,\n    OverlayAssist,\n    Stats,\n    Rewind,\n    SnapSave,\n    SnapLoad,\n    Reload,\n}\n\nfn pages() -> Vec<(&'static str, Vec<Item>)> {\n    let mut out = Vec::new();\n    let sliders: Vec<usize> = (0..SLIDERS.len()).collect();\n    for (k, chunk) in sliders.chunks(PER_PAGE - 2).enumerate() {\n        let mut v = vec![Item::Live, Item::Bot];\n        v.extend(chunk.iter().map(|i| Item::Slider(*i)));\n        let _ = k;\n        out.push((\"Balance\", v));\n    }\n    if let Some((_, last)) = out.last_mut() {\n        last.push(Item::Reset);\n    }\n    out.push((\"Time and patient\", vec![Item::Live, Item::Immortal, Item::Freeze, Item::FullGift, Item::OneHit, Item::TimeScale, Item::FrameStep]));\n    out.push((\"Jump\", vec![Item::JumpCase, Item::JumpPhase, Item::JumpGo, Item::SkipPhase, Item::WinCase, Item::ForceCode, Item::KillPatient]));\n    out.push((\"Spawn and see\", vec![Item::SpawnKind, Item::Spawn, Item::OverlayRadii, Item::OverlayTargets, Item::OverlayBeat, Item::OverlayAssist, Item::Stats]));\n    let mut last = vec![Item::Rewind, Item::SnapSave, Item::SnapLoad];\n    if !cfg!(target_arch = \"wasm32\") {\n        last.push(Item::Reload);\n    }\n    out.push((\"Time travel\", last));\n    out\n}\n\nfn onoff(b: bool) -> String {\n    if b { \"On\".into() } else { \"Off\".into() }\n}\n\nfn describe(shell: &Shell, it: Item, frame: Option<&SurgeryFrame>) -> (String, String, Option<f32>, Option<f32>) {\n    let d = &shell.dev;\n    match it {\n        Item::Live => (\"Live (run while tuning)\".into(), onoff(d.live), None, None),\n        Item::Bot => (\"Bot plays\".into(), onoff(d.bot_plays), None, None),\n        Item::Slider(i) => {\n            let s = &SLIDERS[i];\n            let v = d.tune.get(i);\n            let span = (s.max - s.min).max(0.001);\n            (s.label.into(), format!(\"{v:.2}\"), Some((v - s.min) / span), Some((s.default - s.min) / span))\n        }\n        Item::Reset => (\"Reset All to defaults\".into(), String::new(), None, None),\n        Item::Immortal => (\"Immortal patient\".into(), onoff(d.immortal), None, None),\n        Item::Freeze => (\"Freeze timer\".into(), onoff(d.freeze), None, None),\n        Item::FullGift => (\"Full gift\".into(), onoff(d.full_gift), None, None),\n        Item::OneHit => (\"One-hit strains\".into(), onoff(d.one_hit), None, None),\n        Item::TimeScale => (\"Time scale\".into(), format!(\"{:.2}\", d.time_scale), Some((d.time_scale - 0.05) / 3.95), Some((1.0 - 0.05) / 3.95)),\n        Item::FrameStep => (\"Frame step\".into(), String::new(), None, None),\n        Item::JumpCase => {\n            let name = content::get().cases.get(d.jump_case as usize).map(|c| c.name.clone()).unwrap_or_default();\n            (\"Case\".into(), format!(\"{}: {name}\", d.jump_case), None, None)\n        }\n        Item::JumpPhase => {\n            let n = content::get().cases.get(d.jump_case as usize).map(|c| c.phase.len()).unwrap_or(1);\n            (\"Phase\".into(), format!(\"{} of {n}\", d.jump_phase + 1), None, None)\n        }\n        Item::JumpGo => (\"Jump there\".into(), String::new(), None, None),\n        Item::SkipPhase => (\"Skip phase\".into(), String::new(), None, None),\n        Item::WinCase => (\"Win case\".into(), String::new(), None, None),\n        Item::ForceCode => (\"Force Code\".into(), String::new(), None, None),\n        Item::KillPatient => (\"Kill patient\".into(), String::new(), None, None),\n        Item::SpawnKind => (\"Hazard\".into(), HazardKind::ALL[d.spawn_kind as usize % HazardKind::ALL.len()].name().to_string(), None, None),\n        Item::Spawn => (\"Spawn at the cursor\".into(), String::new(), None, None),\n        Item::OverlayRadii => (\"Overlay: hit radii\".into(), onoff(d.overlays & 1 != 0), None, None),\n        Item::OverlayTargets => (\"Overlay: targets\".into(), onoff(d.overlays & 2 != 0), None, None),\n        Item::OverlayBeat => (\"Overlay: beat window\".into(), onoff(d.overlays & 4 != 0), None, None),\n        Item::OverlayAssist => (\"Overlay: assist radius\".into(), onoff(d.overlays & 8 != 0), None, None),\n        Item::Stats => (\"FPS and tick stats\".into(), onoff(d.stats), None, None),\n        Item::Rewind => (\"Rewind 5 s\".into(), String::new(), None, None),\n        Item::SnapSave => (\"Save snapshot\".into(), String::new(), None, None),\n        Item::SnapLoad => (\"Load snapshot\".into(), String::new(), None, None),\n        Item::Reload => {\n            let _ = frame;\n            (\"Reload content\".into(), String::new(), None, None)\n        }\n    }\n}\n\nfn sim(shell: &mut Shell, c: SurgeryCmd) {\n    shell.cmds.push(ShellCmd::Sim(c));\n}\n\n/// A change of value: `delta` is -1 or +1 for a nudge, 0 for pressing it.\nfn act(shell: &mut Shell, it: Item, delta: f32) {\n    let c = |id, v| SurgeryCmd::Cheat { id, value: v };\n    let press = delta == 0.0;\n    match it {\n        Item::Live => {\n            shell.dev.live = !shell.dev.live;\n            let live = shell.dev.live;\n            shell.cmds.push(ShellCmd::Paused(!live));\n        }\n        Item::Bot => {\n            shell.dev.bot_plays = !shell.dev.bot_plays;\n            let on = shell.dev.bot_plays;\n            sim(shell, SurgeryCmd::BotPlays { slot: 0, on });\n        }\n        Item::Slider(i) => {\n            let s = &SLIDERS[i];\n            let step = (s.max - s.min) / 40.0;\n            let d = if press { 0.0 } else { delta * step };\n            let v = (shell.dev.tune.get(i) + d).clamp(s.min, s.max);\n            set_slider(shell, i, v);\n        }\n        Item::Reset => {\n            shell.dev.tune = Default::default();\n            sim(shell, SurgeryCmd::ResetTune);\n            shell.dev.status = \"Everything back to its default.\".into();\n        }\n        Item::Immortal => {\n            shell.dev.immortal = !shell.dev.immortal;\n            let v = shell.dev.immortal as i32 as f32;\n            sim(shell, c(cheat::IMMORTAL, v));\n        }\n        Item::Freeze => {\n            shell.dev.freeze = !shell.dev.freeze;\n            let v = shell.dev.freeze as i32 as f32;\n            sim(shell, c(cheat::FREEZE_TIMER, v));\n        }\n        Item::FullGift => {\n            shell.dev.full_gift = !shell.dev.full_gift;\n            let v = shell.dev.full_gift as i32 as f32;\n            sim(shell, c(cheat::FULL_GIFT, v));\n        }\n        Item::OneHit => {\n            shell.dev.one_hit = !shell.dev.one_hit;\n            let v = shell.dev.one_hit as i32 as f32;\n            sim(shell, c(cheat::ONE_HIT, v));\n        }\n        Item::TimeScale => {\n            if !press {\n                shell.dev.time_scale = (shell.dev.time_scale + delta * 0.05).clamp(0.05, 4.0);\n                let v = shell.dev.time_scale;\n                sim(shell, c(cheat::TIME_SCALE, v));\n            }\n        }\n        Item::FrameStep => shell.cmds.push(ShellCmd::FrameStep),\n        Item::JumpCase => {\n            let d = if press { 1.0 } else { delta };\n            shell.dev.jump_case = ((shell.dev.jump_case as i32 + d as i32).rem_euclid(content::CASES as i32)) as u8;\n            shell.dev.jump_phase = 0;\n        }\n        Item::JumpPhase => {\n            let n = content::get().cases.get(shell.dev.jump_case as usize).map(|x| x.phase.len()).unwrap_or(1) as i32;\n            let d = if press { 1.0 } else { delta };\n            shell.dev.jump_phase = (shell.dev.jump_phase as i32 + d as i32).rem_euclid(n) as u8;\n        }\n        Item::JumpGo => {\n            let (case, phase) = (shell.dev.jump_case, shell.dev.jump_phase);\n            sim(shell, SurgeryCmd::Jump { case, phase });\n            shell.dev.status = format!(\"Case {case}, phase {}\", phase + 1);\n        }\n        Item::SkipPhase => sim(shell, c(cheat::SKIP_PHASE, 1.0)),\n        Item::WinCase => sim(shell, c(cheat::WIN_CASE, 1.0)),\n        Item::ForceCode => sim(shell, c(cheat::FORCE_CODE, 1.0)),\n        Item::KillPatient => sim(shell, c(cheat::KILL_PATIENT, 1.0)),\n        Item::SpawnKind => {\n            let n = HazardKind::ALL.len() as i32;\n            let d = if press { 1 } else { delta as i32 };\n            shell.dev.spawn_kind = (shell.dev.spawn_kind as i32 + d).rem_euclid(n) as u8;\n        }\n        Item::Spawn => shell.dev.status = \"spawn\".into(),\n        Item::OverlayRadii => overlay(shell, 1),\n        Item::OverlayTargets => overlay(shell, 2),\n        Item::OverlayBeat => overlay(shell, 4),\n        Item::OverlayAssist => overlay(shell, 8),\n        Item::Stats => shell.dev.stats = !shell.dev.stats,\n        Item::Rewind => shell.cmds.push(ShellCmd::Rewind),\n        Item::SnapSave => shell.cmds.push(ShellCmd::SnapshotSave),\n        Item::SnapLoad => shell.cmds.push(ShellCmd::SnapshotLoad),\n        Item::Reload => shell.cmds.push(ShellCmd::ReloadContent),\n    }\n}\n\nfn set_slider(shell: &mut Shell, i: usize, v: f32) {\n    shell.dev.tune.set(i, v);\n    sim(shell, SurgeryCmd::SetTune { id: i as u16, value: v });\n}\n\nfn overlay(shell: &mut Shell, bit: u32) {\n    shell.dev.overlays ^= bit;\n    let v = shell.dev.overlays as f32;\n    sim(shell, SurgeryCmd::Cheat { id: cheat::OVERLAYS, value: v });\n}\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput, frame: Option<&SurgeryFrame>) {\n    let all = pages();\n    let n = all.len();\n    shell.dev.page = shell.dev.page.min(n - 1);\n    if i.tab_prev {\n        shell.dev.page = (shell.dev.page + n - 1) % n;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    if i.tab_next {\n        shell.dev.page = (shell.dev.page + 1) % n;\n        shell.focus = 0;\n        shell.cue(cue::NAV);\n    }\n    let (title, items) = &all[shell.dev.page];\n    let panel = Rect::from_min_size(rect.min, vec2(800.0, rect.height()));\n    p.rect_filled(panel, 0.0, style::PANEL);\n    style::outlined(p, panel.min + vec2(36.0, 48.0), Align2::LEFT_CENTER, \"Dev Mode\", 50.0, Color32::WHITE);\n    style::outlined(p, panel.min + vec2(36.0, 104.0), Align2::LEFT_CENTER, &format!(\"{title}  {}/{n}\", shell.dev.page + 1), 36.0, GOLD);\n    // Prev and next, for a mouse.\n    for (dx, label, step) in [(560.0, \"<\", -1i32), (660.0, \">\", 1)] {\n        let r = Rect::from_min_size(panel.min + vec2(dx, 74.0), vec2(80.0, 60.0));\n        p.rect_filled(r, 8.0, style::with_alpha(TEAL, 0.3));\n        style::outlined(p, r.center(), Align2::CENTER_CENTER, label, 44.0, Color32::WHITE);\n        if i.pointer.is_some_and(|q| r.contains(q)) && i.click {\n            shell.dev.page = (shell.dev.page as i32 + step).rem_euclid(n as i32) as usize;\n            shell.focus = 0;\n            shell.cue(cue::NAV);\n            return;\n        }\n    }\n    let count = items.len();\n    shell.focus = shell.focus.min(count - 1);\n    if shell.nav(0) {\n        shell.focus = (shell.focus + count - 1) % count;\n        shell.cue(cue::NAV);\n    }\n    if shell.nav(1) {\n        shell.focus = (shell.focus + 1) % count;\n        shell.cue(cue::NAV);\n    }\n    let step_h = 112.0;\n    let top = panel.min.y + 150.0;\n    for (k, it) in items.iter().enumerate() {\n        let r = Rect::from_min_size(pos2(panel.min.x + 20.0, top + k as f32 * step_h), vec2(760.0, step_h - 10.0));\n        let over = i.pointer.is_some_and(|q| r.contains(q));\n        if over && i.pointer_moved {\n            shell.focus = k;\n        }\n        let f = shell.focus == k;\n        if f {\n            p.rect_filled(r, 8.0, style::with_alpha(TEAL, 0.2));\n            p.rect_stroke(r, 8.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n        }\n        let (label, value, frac, def) = describe(shell, *it, frame);\n        style::outlined(p, r.left_top() + vec2(18.0, 30.0), Align2::LEFT_CENTER, &label, 38.0, if f { Color32::WHITE } else { INK });\n        style::outlined(p, r.right_top() + vec2(-18.0, 30.0), Align2::RIGHT_CENTER, &value, 38.0, GOLD);\n        if let Some(fr) = frac {\n            let track = Rect::from_min_size(r.left_top() + vec2(18.0, 62.0), vec2(724.0, 20.0));\n            p.rect_filled(track, 10.0, Color32::from_black_alpha(170));\n            p.rect_filled(Rect::from_min_size(track.min, vec2(track.width() * fr.clamp(0.0, 1.0), 20.0)), 10.0, TEAL);\n            if let Some(d) = def {\n                // The default, marked.\n                let x = track.min.x + track.width() * d;\n                p.line_segment([pos2(x, track.min.y - 6.0), pos2(x, track.max.y + 6.0)], egui::Stroke::new(4.0, GOLD));\n            }\n            p.circle_filled(pos2(track.min.x + track.width() * fr.clamp(0.0, 1.0), track.center().y), 15.0, Color32::WHITE);\n            if i.drag && i.pointer.is_some_and(|q| track.expand2(vec2(14.0, 26.0)).contains(q)) {\n                if let (Item::Slider(si), Some(q)) = (it, i.pointer) {\n                    let k = ((q.x - track.min.x) / track.width()).clamp(0.0, 1.0);\n                    let s = &SLIDERS[*si];\n                    set_slider(shell, *si, s.min + (s.max - s.min) * k);\n                }\n            }\n        } else if over && i.click {\n            pressed(shell, *it, frame);\n            shell.cue(cue::CONFIRM);\n        }\n    }\n    let it = items[shell.focus];\n    if shell.nav(2) {\n        act(shell, it, -1.0);\n    }\n    if shell.nav(3) {\n        act(shell, it, 1.0);\n    }\n    if i.confirm {\n        pressed(shell, it, frame);\n        shell.cue(cue::CONFIRM);\n    }\n    if !shell.dev.status.is_empty() {\n        style::outlined(p, rect.max - vec2(40.0, 92.0), Align2::RIGHT_CENTER, &shell.dev.status.clone(), 34.0, TEAL);\n    }\n    if shell.dev.stats {\n        let text = format!(\"{:.0} fps   {:.0} ticks/s\", shell.dev.fps, shell.dev.tps);\n        style::outlined(p, panel.right_top() + vec2(30.0, 150.0), Align2::LEFT_CENTER, &text, 38.0, Color32::WHITE);\n    }\n    shell.hints(p, panel, &[(Action::TabNext, \"Page\"), (Action::Adjust, \"Nudge\"), (Action::Back, \"Back\")]);\n    if i.back || i.pause {\n        shell.cue(cue::BACK);\n        shell.dev.status.clear();\n        // Back to the pause menu, and time stops again.\n        shell.dev.live = false;\n        shell.cmds.push(ShellCmd::Paused(true));\n        shell.go(super::Screen::Pause);\n    }\n}\n\nfn pressed(shell: &mut Shell, it: Item, frame: Option<&SurgeryFrame>) {\n    if it == Item::Spawn {\n        let at = frame.and_then(|f| f.surgeons.first()).map(|s| s.cursor).unwrap_or_default();\n        let kind = shell.dev.spawn_kind;\n        sim(shell, SurgeryCmd::Spawn { kind, x: at.x, z: at.y });\n        shell.dev.status = format!(\"Spawned {} at the cursor\", HazardKind::ALL[kind as usize % HazardKind::ALL.len()].name());\n        return;\n    }\n    act(shell, it, 0.0);\n}\nEOF\ncat > crates/pav_ui/src/surgery/card.rs <<'EOF'\n//! A hub session's own card: a pre-op board with the title, the patient, each player in their\n//! colour with a ready mark, how to win, this player's controls, and the time left. It takes two\n//! answers, and no menus.\n\nuse egui::{Align2, Color32, Painter, Rect, StrokeKind, pos2, vec2};\n\nuse super::glyphs::{self, Action};\nuse super::style::{self, GOLD, GREEN, INK, PAPER, PAPER_INK, SEATS};\nuse super::{Shell, ShellCmd, ShellInput, TITLE};\n\npub const GOAL: &str = \"Keep the patient alive until the bell.\";\n\npub fn screen(shell: &mut Shell, p: &Painter, rect: Rect, i: &ShellInput) {\n    p.rect_filled(rect, 0.0, style::with_alpha(style::BG, 0.72));\n    let board = Rect::from_center_size(rect.center(), vec2(1640.0, 900.0));\n    p.rect_filled(board.translate(vec2(8.0, 10.0)), 12.0, Color32::from_black_alpha(150));\n    p.rect_filled(board, 12.0, PAPER);\n    let x = board.min.x + 60.0;\n    style::plain(p, pos2(x, board.min.y + 34.0), Align2::LEFT_TOP, TITLE, 70.0, PAPER_INK);\n    style::plain(p, pos2(x, board.min.y + 118.0), Align2::LEFT_TOP, \"Tonight's board: CODE BLUE, one patient, every hand\", 40.0, PAPER_INK);\n    style::line(p, pos2(x, board.min.y + 176.0), pos2(board.max.x - 60.0, board.min.y + 176.0), 3.0, PAPER_INK);\n    let card = shell.hub_card.clone().unwrap_or_default();\n    style::plain(p, pos2(x, board.min.y + 198.0), Align2::LEFT_TOP, \"Patient: John Doe, Ward Nine\", 44.0, PAPER_INK);\n    style::plain(p, pos2(x, board.min.y + 258.0), Align2::LEFT_TOP, GOAL, 48.0, Color32::from_rgb(170, 30, 30));\n    // Who is on tonight.\n    let mut y = board.min.y + 340.0;\n    for (id, name) in &card.players {\n        let c = SEATS[*id as usize % 4];\n        let row = Rect::from_min_size(pos2(x, y), vec2(800.0, 74.0));\n        p.rect_filled(row, 8.0, style::with_alpha(c, 0.2));\n        p.rect_filled(Rect::from_min_size(row.min, vec2(14.0, 74.0)), 4.0, c);\n        let me = card.me == Some(*id);\n        // The name is the hub's: egui text only, never markup.\n        style::plain(p, row.left_center() + vec2(34.0, 0.0), Align2::LEFT_CENTER, name, 46.0, PAPER_INK);\n        if me {\n            style::plain(p, row.right_center() - vec2(150.0, 0.0), Align2::RIGHT_CENTER, \"you\", 36.0, PAPER_INK);\n        }\n        let ready = card.ready.contains(id);\n        let t = if ready { \"READY\" } else { \"scrubbing\" };\n        style::plain(p, row.right_center() - vec2(16.0, 0.0), Align2::RIGHT_CENTER, t, 38.0, if ready { Color32::from_rgb(20, 120, 70) } else { Color32::from_rgb(120, 110, 100) });\n        y += 86.0;\n    }\n    // This player's controls.\n    let g = shell.glyphs();\n    let cx = board.min.x + 900.0;\n    let mut cy = board.min.y + 348.0;\n    let rows: &[(Action, &str)] = &[(Action::Aim, \"Move the cursor\"), (Action::Use, \"Use the instrument\"), (Action::Pick, \"Pick an instrument\"), (Action::Gift, \"Your gift, on the beat\")];\n    for (a, label) in rows {\n        shell.prompted(g, *a);\n        glyphs::draw(p, pos2(cx, cy), 46.0, g, *a);\n        style::plain(p, pos2(cx + 150.0, cy), Align2::LEFT_CENTER, label, 40.0, PAPER_INK);\n        cy += 72.0;\n    }\n    // The clock and the two answers.\n    let left = card.left_ms.map(|ms| format!(\"{:.0}\", (ms / 1000.0).ceil()));\n    let status = if card.starting {\n        \"Starting...\".to_string()\n    } else if card.paused {\n        format!(\"Waiting: {} asked for more time\", card.asking)\n    } else if let Some(s) = left {\n        format!(\"Scrub in: {s} seconds\")\n    } else {\n        \"Waiting for the board...\".to_string()\n    };\n    style::plain(p, pos2(x, board.max.y - 150.0), Align2::LEFT_CENTER, &status, 50.0, PAPER_INK);\n    let ready_r = Rect::from_min_size(pos2(x, board.max.y - 110.0), vec2(520.0, 86.0));\n    let more_r = Rect::from_min_size(pos2(x + 560.0, board.max.y - 110.0), vec2(520.0, 86.0));\n    let i_ready = card.me.is_some_and(|m| card.ready.contains(&m));\n    p.rect_filled(ready_r, 12.0, if i_ready { GREEN } else { Color32::from_rgb(30, 110, 110) });\n    p.rect_stroke(ready_r, 12.0, egui::Stroke::new(3.0, PAPER_INK), StrokeKind::Inside);\n    shell.prompted(g, Action::Confirm);\n    glyphs::draw(p, ready_r.left_center() + vec2(24.0, 0.0), 50.0, g, Action::Confirm);\n    style::outlined(p, ready_r.left_center() + vec2(180.0, 0.0), Align2::LEFT_CENTER, \"Ready\", 52.0, Color32::WHITE);\n    p.rect_filled(more_r, 12.0, if card.asked { GOLD } else { Color32::from_rgb(80, 86, 96) });\n    p.rect_stroke(more_r, 12.0, egui::Stroke::new(3.0, PAPER_INK), StrokeKind::Inside);\n    shell.prompted(g, Action::More);\n    glyphs::draw(p, more_r.left_center() + vec2(24.0, 0.0), 50.0, g, Action::More);\n    style::outlined(p, more_r.left_center() + vec2(120.0, 0.0), Align2::LEFT_CENTER, \"More time\", 52.0, Color32::WHITE);\n    let tapped = i.tap.or(if i.click { i.pointer } else { None });\n    if i.confirm || tapped.is_some_and(|q| ready_r.contains(q)) {\n        shell.cmds.push(ShellCmd::HubReady);\n    }\n    if i.alt || tapped.is_some_and(|q| more_r.contains(q)) {\n        shell.cmds.push(ShellCmd::HubMore);\n    }\n    let _ = INK;\n}\nEOF\ncat > crates/pav_ui/src/surgery/tests.rs <<'EOF'\n//! The shell, driven with no GPU: pad, keyboard and mouse navigation through every screen.\n\nuse egui::{Context, RawInput};\nuse glam::Mat4;\n\nuse super::save::{Save, Settings};\nuse super::*;\nuse pav_core::games::surgery::frame::SurgeryFrame;\n\nfn run(shell: &mut Shell, ctx: &Context, input: ShellInput, f: Option<&SurgeryFrame>) -> Vec<ShellCmd> {\n    let raw = RawInput {\n        screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1920.0, 1080.0))),\n        predicted_dt: 1.0 / 60.0,\n        ..Default::default()\n    };\n    let _ = ctx.run_ui(raw, |ui| {\n        let ctx = ui.ctx().clone();\n        shell.frame(&ctx, &input, f, Mat4::IDENTITY);\n    });\n    std::mem::take(&mut shell.cmds)\n}\n\nfn tick(device: Device) -> ShellInput {\n    ShellInput { device, dt: 1.0 / 60.0, ..Default::default() }\n}\n\nfn press(device: Device, f: impl Fn(&mut ShellInput)) -> ShellInput {\n    let mut i = tick(device);\n    i.any = true;\n    f(&mut i);\n    i\n}\n\n#[test]\nfn music_defaults_to_ten_percent() {\n    assert_eq!(Settings::default().music, 0.10);\n    assert_eq!(Settings::default().effects, 0.80);\n    assert_eq!(Settings::default().voices, 0.70);\n}\n\n#[test]\nfn a_pad_walks_the_menus_and_prompts_follow_the_device() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert_eq!(s.screen, Screen::Menu, \"any confirm leaves the title\");\n    run(&mut s, &ctx, tick(Device::Gamepad), None);\n    assert!(s.prompts.contains(&\"Cross\"), \"pad glyphs: {:?}\", s.prompts);\n    // Down to Settings: New Game, Case Files, Code Blue, Settings.\n    for _ in 0..3 {\n        run(&mut s, &ctx, press(Device::Gamepad, |i| i.down = true), None);\n        run(&mut s, &ctx, tick(Device::Gamepad), None);\n    }\n    assert_eq!(s.focus, 3);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert_eq!(s.screen, Screen::Settings);\n    // Tabs, then back.\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.tab_next = true), None);\n    assert_eq!(s.page, 1);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.confirm = true), None);\n    assert!(s.save.settings.xbox, \"the first switch on the Controls page\");\n    run(&mut s, &ctx, tick(Device::Gamepad), None);\n    assert!(s.prompts.contains(&\"LB\"), \"Xbox glyphs now: {:?}\", s.prompts);\n    run(&mut s, &ctx, press(Device::Gamepad, |i| i.back = true), None);\n    assert_eq!(s.screen, Screen::Menu);\n    // The mouse takes over at once.\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    assert!(s.prompts.contains(&\"Enter\"), \"key glyphs: {:?}\", s.prompts);\n}\n\n#[test]\nfn hover_moves_the_focus_and_a_click_activates() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    s.go(Screen::Menu);\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    assert_eq!(s.focus, 0);\n    let on_third = egui::pos2(300.0, 240.0 + 104.0 * 2.0 + 40.0);\n    run(&mut s, &ctx, press(Device::KeyboardMouse, |i| {\n        i.pointer = Some(on_third);\n        i.pointer_moved = true;\n    }), None);\n    assert_eq!(s.focus, 2, \"hover moved the focus\");\n    let cmds = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| {\n        i.pointer = Some(on_third);\n        i.click = true;\n    }), None);\n    assert!(cmds.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/codeblue\")), \"{cmds:?}\");\n    assert_eq!(s.screen, Screen::Playing);\n}\n\n#[test]\nfn attract_starts_at_ten_seconds_and_any_input_exits() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    for _ in 0..(9.5 * 60.0) as usize {\n        run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n    }\n    assert_eq!(s.screen, Screen::Title);\n    let mut started = false;\n    for _ in 0..60 {\n        let c = run(&mut s, &ctx, tick(Device::KeyboardMouse), None);\n        started |= c.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/attract\"));\n    }\n    assert!(started && s.screen == Screen::Attract);\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |_| {}), None);\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Load(x) if x == \"surgery/title\")));\n    assert_eq!(s.screen, Screen::Title);\n}\n\n#[test]\nfn touch_only_shows_the_message_and_a_settings_button_a_tap_can_use() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    s.touch_only = true;\n    run(&mut s, &ctx, tick(Device::Touch), None);\n    assert_eq!(s.screen, Screen::Title);\n    // A tap anywhere else does nothing.\n    run(&mut s, &ctx, press(Device::Touch, |i| i.tap = Some(egui::pos2(100.0, 100.0))), None);\n    assert_eq!(s.screen, Screen::Title);\n    run(&mut s, &ctx, press(Device::Touch, |i| i.tap = Some(egui::pos2(960.0, 540.0 + 260.0))), None);\n    assert_eq!(s.screen, Screen::Settings);\n    run(&mut s, &ctx, tick(Device::Touch), None);\n    // Attract still runs.\n    let mut s2 = Shell::default();\n    s2.touch_only = true;\n    for _ in 0..(10.5 * 60.0) as usize {\n        run(&mut s2, &ctx, tick(Device::Touch), None);\n    }\n    assert_eq!(s2.screen, Screen::Attract);\n}\n\n#[test]\nfn dev_sliders_apply_and_reset_and_the_default_is_kept() {\n    let ctx = Context::default();\n    let mut s = Shell::default();\n    let f = SurgeryFrame::default();\n    s.go(Screen::Dev);\n    s.focus = 2; // the first slider: Vitals drain\n    run(&mut s, &ctx, tick(Device::KeyboardMouse), Some(&f));\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| i.right = true), Some(&f));\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Sim(SurgeryCmd::SetTune { id: 0, .. }))), \"{c:?}\");\n    assert!(s.dev.tune.get(0) > 1.0);\n    // Reset All lives on the last Balance page.\n    let pages = 4;\n    s.dev.page = pages - 1;\n    let reset_at = 2 + pav_core::games::surgery::tune::SLIDERS.len() % 5;\n    s.focus = if pav_core::games::surgery::tune::SLIDERS.len() % 5 == 0 { 7 } else { reset_at };\n    let c = run(&mut s, &ctx, press(Device::KeyboardMouse, |i| i.confirm = true), Some(&f));\n    assert!(c.iter().any(|c| matches!(c, ShellCmd::Sim(SurgeryCmd::ResetTune))), \"{c:?}\");\n    assert_eq!(s.dev.tune.get(0), 1.0);\n}\n\n#[test]\nfn about_shows_every_required_section_with_no_scrollbars() {\n    let a = super::about::About::parse(\n        r#\"{\"sections\":[{\"title\":\"Credits\",\"lines\":[\"x\"]},{\"title\":\"Source Information\",\"lines\":[\"y\"]},{\"title\":\"Testing Feedback\",\"lines\":[\"z\"]},{\"title\":\"Engine Feedback\",\"lines\":[\"w\"]},{\"title\":\"Prompt Feedback\",\"lines\":[\"v\"]}]}\"#,\n    )\n    .unwrap();\n    let titles: Vec<String> = a.pages().into_iter().map(|p| p.0).collect();\n    for need in [\"Credits\", \"Source Information\", \"Testing Feedback\", \"Engine Feedback\", \"Prompt Feedback\"] {\n        assert!(titles.iter().any(|t| t == need), \"{need} missing\");\n    }\n    // A long section runs to more screens rather than scrolling.\n    let long = super::about::About { sections: vec![super::about::AboutSection { title: \"L\".into(), lines: vec![\"word \".repeat(40); 30] }] };\n    assert!(long.pages().len() > 1);\n}\n\n#[test]\nfn a_save_round_trips_and_best_rank_holds() {\n    let mut s = Save::default();\n    assert!(s.record(2, \"B\"));\n    assert!(!s.record(2, \"C\"), \"a worse rank doesn't replace it\");\n    assert!(s.record(2, \"ENCORE\"));\n    assert!(s.record(255, \"S\"));\n    s.settings.music = 0.3;\n    let back = Save::parse(&s.to_text()).unwrap();\n    assert_eq!(back, s);\n    assert!(Save::parse(\"{\\\"version\\\":99}\").is_none());\n    assert!(Save::parse(\"nonsense\").is_none());\n}\n\n#[test]\nfn every_screen_draws_without_a_panic_on_every_stage() {\n    use pav_core::games::surgery::frame::Stage;\n    let ctx = Context::default();\n    let mut sim = pav_core::Sim::new(\"surgery/case/7\", 1).unwrap();\n    let mut s = Shell::default();\n    let screens = [Screen::Title, Screen::Menu, Screen::Difficulty, Screen::CaseFiles, Screen::Settings, Screen::About, Screen::Controls, Screen::Pause, Screen::Dev, Screen::Card, Screen::Attract, Screen::Playing, Screen::Session];\n    for t in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n        if t % 40 == 0 {\n            let fr = sim.frame().surgery.clone();\n            for sc in screens {\n                s.screen = sc;\n                run(&mut s, &ctx, tick(Device::Gamepad), fr.as_deref());\n                run(&mut s, &ctx, tick(Device::KeyboardMouse), fr.as_deref());\n            }\n        }\n    }\n    // A frame per stage, by hand.\n    for st in [Stage::Story, Stage::Chart, Stage::Results, Stage::Dead, Stage::Finished, Stage::Code] {\n        let f = SurgeryFrame { stage: st, ..Default::default() };\n        s.screen = Screen::Playing;\n        run(&mut s, &ctx, tick(Device::Gamepad), Some(&f));\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_ui/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod headless;\\n','pub mod headless;\\npub mod surgery;\\n')\nopen(p,'w').write(s)\np='crates/pav_ui/src/headless.rs'\ns=open(p).read()\ns=s.replace('''/// The UI's state between frames: which windows are open, the device, the touch controls.\n#[derive(Default)]\npub struct Headless {\n    pub game: GameUi,\n    pub touch: Touch,\n    pub device: Device,\n}\n''','''/// The UI's state between frames: which windows are open, the device, the touch controls.\n#[derive(Default)]\npub struct Headless {\n    pub game: GameUi,\n    pub touch: Touch,\n    pub device: Device,\n    /// The surgery game's shell, once its scene runs.\n    pub shell: Option<crate::surgery::Shell>,\n    shell_ctx: Option<egui::Context>,\n}\n''')\ns=s.replace('''    /// What `out` shows: the windows' text''','''    /// One frame of the surgery game's shell and HUD, as the window draws them. A persistent\n    /// context: the shell keeps its own state between frames.\n    pub fn frame_surgery(&mut self, f: &pav_core::games::surgery::frame::SurgeryFrame, vp: Mat4, width: u32, height: u32) -> Drawn {\n        let ctx = self.shell_ctx.get_or_insert_with(|| {\n            let c = egui::Context::default();\n            crate::surgery::style::install_font(&c);\n            c\n        });\n        crate::surgery::style::set_canvas(ctx, height as f32, 1.0);\n        let shell = self.shell.get_or_insert_with(|| {\n            let mut s = crate::surgery::Shell::default();\n            s.screen = crate::surgery::Screen::Playing;\n            s\n        });\n        // Fonts land on the second pass: a capture may be the first frame.\n        let mut output = None;\n        let mut textures = egui::TexturesDelta::default();\n        for pass in 0..2 {\n            let raw = egui::RawInput {\n                screen_rect: Some(Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32) / ctx.zoom_factor())),\n                time: Some(pass as f64 / 60.0),\n                predicted_dt: 1.0 / 60.0,\n                ..Default::default()\n            };\n            let input = crate::surgery::ShellInput { device: self.device, dt: if pass == 1 { 1.0 / 60.0 } else { 0.0 }, ..Default::default() };\n            let mut out = ctx.run_ui(raw, |ui| {\n                let c = ui.ctx().clone();\n                shell.frame(&c, &input, Some(f), vp);\n            });\n            textures.append(std::mem::take(&mut out.textures_delta));\n            output = Some(out);\n        }\n        shell.cmds.clear();\n        let output = output.unwrap();\n        let ctx = ctx.clone();\n        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\n        let reading = self.read(&output, screen, Vec::new());\n        let pixels_per_point = output.pixels_per_point;\n        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\n        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands: Vec::new() }\n    }\n\n    /// What `out` shows: the windows' text''')\nopen(p,'w').write(s)\np='crates/pav_tools/src/session.rs'\ns=open(p).read()\ns=s.replace('''        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));''','''        let drawn = if let Some(g) = &frame.surgery {\n            Some(self.ui.frame_surgery(g, vp, width, height))\n        } else {\n            has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n        };''')\ns=s.replace('''        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''','''        self.camera.snap(frame.focus);\n        if let Some(g) = &frame.surgery {\n            pav_view::surgery::apply_shot(&mut self.camera, &g.shot);\n            let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n            return Some(self.ui.frame_surgery(g, vp, width, height));\n        }\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''')\ns=s.replace('''    frame.game.is_some() || !frame.hud.lines.is_empty()\n''','''    frame.game.is_some() || !frame.hud.lines.is_empty() || frame.surgery.is_some()\n''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"render_ui\\|fn t_capture\" crates/pav_tools/src/tools.rs | head -5; CARGO_BUILD_JOBS=10 cargo check --locked -p pav_ui 2>&1 | grep -E \"^error|^warning: unused|^ +--> \" | head -50; CARGO_BUILD_JOBS=10 cargo check --locked -p pav_ui 2>&1 | tail -2","description":"Write the HUD, story, results, dev and card screens, then type-check","timeout":400000}}}
