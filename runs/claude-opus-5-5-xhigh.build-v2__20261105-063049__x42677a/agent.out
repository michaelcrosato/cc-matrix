{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjt2zmMudwnVo7Sz9cX1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Saa5SS2hATcHEcJLs4BRkg","name":"Bash","input":{"command":"cat > crates/pav_core/src/games/surgery/frame.rs <<'EOF'\n//! `SurgeryFrame`: the single source of everything drawn. Built from the sim on the host and\n//! decoded from the network on a client.\n\nuse std::sync::Arc;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::field::{GhostHand, Hazard, Popup, Stain, Tool};\n\n/// Where the game is. Numbers go over the network.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Stage {\n    /// The title's idle plate.\n    #[default]\n    Title,\n    /// A story scene.\n    Story,\n    /// The chart card before an operation.\n    Chart,\n    /// \"OPERATION START\".\n    OpStart,\n    Op,\n    /// The heart stopped: 5 seconds to shock it.\n    Code,\n    /// \"OPERATION COMPLETE\".\n    Complete,\n    Results,\n    /// Time of death.\n    Dead,\n    /// The whole run is done.\n    Finished,\n    /// The hub's pre-op board.\n    Card,\n}\n\n/// The camera, set by the game: applied to the engine's `CameraRig` in the app and the tools.\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    /// Seconds to glide here from the last shot (0 = cut).\n    pub blend: f32,\n}\n\nimpl CameraShot {\n    /// The surgeon's-eye view of the field.\n    pub const FIELD: CameraShot = CameraShot { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9, fov: 36.0, blend: 0.0 };\n    /// The paper theatre, straight on.\n    pub const PAPER: CameraShot = CameraShot { target: [0.0, 0.0, 0.0], tilt: 0.0, yaw: 0.0, distance: 14.0, fov: 26.0, blend: 0.0 };\n    /// The 3D wide shot of the operating room.\n    pub const WIDE: CameraShot = CameraShot { target: [94.0, 1.1, -3.0], tilt: 16.0, yaw: 24.0, distance: 9.0, fov: 40.0, blend: 0.0 };\n}\n\nimpl Default for CameraShot {\n    fn default() -> Self {\n        Self::FIELD\n    }\n}\n\n/// A person at a stage position.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ActorView {\n    pub who: Arc<str>,\n    pub expr: Arc<str>,\n    /// Where they stand (x).\n    pub x: f32,\n    /// Seconds since they came on; negative: leaving.\n    pub t: f32,\n    pub leaving: bool,\n    pub talking: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StoryView {\n    pub key: Arc<str>,\n    pub line: u32,\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    /// Characters shown so far.\n    pub chars: u32,\n    pub typed: bool,\n    pub set: Arc<str>,\n    pub actors: Vec<ActorView>,\n    pub camera_or: bool,\n    pub flash: f32,\n    pub shake: f32,\n    /// Seconds on this line.\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ChartView {\n    pub case_no: u8,\n    pub case_name: Arc<str>,\n    pub patient: Arc<str>,\n    pub life: Arc<str>,\n    pub diagnosis: Arc<str>,\n    pub surgeon: Arc<str>,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ResultsView {\n    pub case_no: u8,\n    pub case_name: Arc<str>,\n    pub patient: Arc<str>,\n    pub fate: Arc<str>,\n    pub action_points: i32,\n    pub vitals_bonus: i32,\n    pub time_bonus: i32,\n    pub mistakes: u32,\n    pub mistake_penalty: i32,\n    pub total: i32,\n    pub par: i32,\n    pub rank: Arc<str>,\n    pub counts: [u32; 4],\n    pub best_chain: u32,\n    /// Each surgeon's own score, in co-op.\n    pub scores: Vec<(u8, i32)>,\n    pub t: f32,\n    /// More operations follow in this run.\n    pub won: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct DeathView {\n    pub time: Arc<str>,\n    pub patient: Arc<str>,\n    pub fate: Arc<str>,\n    pub checkpoint: bool,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CodeView {\n    /// Seconds left to shock it.\n    pub left: f32,\n    pub window: f32,\n    /// The ghost beat's place: 0 at the left, 0.5 on the centre line, 1 at the right.\n    pub ghost: f32,\n    /// Shocks this Code still needs.\n    pub shocks: u8,\n    /// Scripted stops don't count against the allowance.\n    pub scripted: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct SurgeonView {\n    pub slot: u8,\n    pub present: bool,\n    pub bot: bool,\n    pub cursor: Vec2,\n    pub raw: Vec2,\n    pub tool: Tool,\n    pub engaged: u32,\n    pub using: bool,\n    pub pressure: f32,\n    pub score: i32,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_ready: bool,\n    pub gift_hold: bool,\n    /// 0 Hush, 1 Echo.\n    pub gift_kind: u8,\n    pub flow: f32,\n    pub dose: f32,\n    pub iv_cool: f32,\n    pub iv_on: bool,\n    pub charge: f32,\n    pub charging: bool,\n    pub kick: f32,\n    /// The tool's progress on what it is on, for its ring (0..1.3).\n    pub meter: f32,\n    pub name: Arc<str>,\n}\n\n/// One line of an in-op voice.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Subtitle {\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    pub age: f32,\n    /// Counts up with every new line.\n    pub serial: u32,\n}\n\n/// What the music should be doing.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MusicView {\n    /// `title`, `tender`, `tense`, `or`, `codeblue`, `results`, or empty for silence.\n    pub track: Arc<str>,\n    pub crisis: f32,\n    pub hush: f32,\n    /// The strain's motif, by meter (0 = none).\n    pub motif: u8,\n}\n\n/// Everything drawn in one tick.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub stage: Stage,\n    pub tick: u64,\n    /// Rule seconds: what the tissue and the strains move by.\n    pub clock: f32,\n    pub shot: CameraShot,\n    pub case_no: u8,\n    pub phase: u8,\n    pub phases: u8,\n    pub case_name: Arc<str>,\n    pub attract: bool,\n    pub codeblue: bool,\n    pub mirror: bool,\n    pub plate: Arc<str>,\n    pub prev_plate: Option<Arc<str>>,\n    /// Cross-fade from the last plate, 0..1, spreading from `plate_from`.\n    pub plate_blend: f32,\n    pub plate_from: Vec2,\n    pub vitals: f32,\n    pub vitals_max: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub flat: bool,\n    pub meter: u8,\n    pub bar_beat: u8,\n    pub timer: f32,\n    pub timer_total: f32,\n    pub hazards: Vec<Hazard>,\n    pub stains: Vec<Stain>,\n    pub surgeons: Vec<SurgeonView>,\n    pub ring: [Tool; 8],\n    pub forced_tool: Option<Tool>,\n    pub objective: Arc<str>,\n    pub guided: bool,\n    /// The hazard the guide highlights.\n    pub guide: u32,\n    pub subtitle: Option<Subtitle>,\n    pub popups: Vec<Popup>,\n    pub ghosts: Vec<GhostHand>,\n    pub pings: Vec<(Vec2, f32)>,\n    /// Big centred text and how long it has been up.\n    pub banner: Option<(Arc<str>, f32)>,\n    pub hush: f32,\n    pub echo: f32,\n    pub gift_awake: bool,\n    pub duet: bool,\n    pub fever: Option<f32>,\n    /// A heat ring's radius as it sweeps.\n    pub heat_ring: Option<f32>,\n    /// Beats until the next ring (the count-in), 0 = none.\n    pub ring_in: u8,\n    pub code: Option<CodeView>,\n    pub story: Option<StoryView>,\n    pub chart: Option<ChartView>,\n    pub results: Option<ResultsView>,\n    pub death: Option<DeathView>,\n    pub music: MusicView,\n    pub shake: f32,\n    pub flash: f32,\n    /// A camera push's strength, 0..1, and where it looks.\n    pub push: f32,\n    pub push_at: Vec2,\n    /// Dev overlays bitmask.\n    pub overlays: u32,\n    pub tremor: bool,\n}\n\nimpl SurgeryFrame {\n    /// Screen-independent: the valid targets for this tool (aim assist's magnets).\n    pub fn targets(&self, tool: Tool) -> impl Iterator<Item = Vec2> + '_ {\n        self.hazards.iter().filter(move |h| h.accepts(tool)).map(|h| h.touch_point())\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/surgeon.rs <<'EOF'\n//! The cursor between devices and field: how a stick moves it, and aim assist. This runs on the\n//! render side (zero lag), on the same numbers the sim uses.\n\nuse glam::Vec2;\n\n/// Keep gameplay inside this; the cursor may reach the tray below it.\npub const FIELD_X: f32 = 10.6;\npub const FIELD_Z_MIN: f32 = -5.6;\npub const FIELD_Z_MAX: f32 = 6.1;\n\n/// Moves a pad's or the keyboard's cursor for one frame: `v = speed * s^2.2`; near a valid\n/// target speed falls by up to 50% and the cursor is pulled toward it at up to 3 u/s, only while\n/// the stick is moving.\npub fn integrate(\n    mut cursor: Vec2,\n    stick: Vec2,\n    speed: f32,\n    precision: bool,\n    assist: f32,\n    dt: f32,\n    targets: impl Iterator<Item = Vec2>,\n) -> Vec2 {\n    let s = stick.length().min(1.0);\n    if s <= 0.001 {\n        return cursor;\n    }\n    let dir = stick / stick.length();\n    let mut v = speed * s.powf(2.2);\n    if precision {\n        v *= 0.35;\n    }\n    let mut pull = Vec2::ZERO;\n    if assist > 0.0 {\n        let mut best: Option<(f32, Vec2)> = None;\n        for t in targets {\n            let d = t.distance(cursor);\n            if d < 1.2 && best.is_none_or(|b| d < b.0) {\n                best = Some((d, t));\n            }\n        }\n        if let Some((d, t)) = best {\n            let k = (1.0 - d / 1.2).clamp(0.0, 1.0) * assist.min(1.0);\n            v *= 1.0 - 0.5 * k;\n            if d > 0.02 {\n                pull = (t - cursor) / d * 3.0 * k.max(0.25 * assist);\n            }\n        }\n    }\n    cursor += (dir * v + pull) * dt;\n    clamp(cursor)\n}\n\npub fn clamp(p: Vec2) -> Vec2 {\n    Vec2::new(p.x.clamp(-FIELD_X, FIELD_X), p.y.clamp(FIELD_Z_MIN, FIELD_Z_MAX))\n}\n\n/// A flick of the left stick: which of 8 ring places it points at (0 = up, clockwise). `stick`\n/// has y up.\npub fn flick(stick: Vec2) -> Option<usize> {\n    if stick.length() < 0.55 {\n        return None;\n    }\n    let a = stick.x.atan2(stick.y).rem_euclid(std::f32::consts::TAU);\n    Some(((a / std::f32::consts::FRAC_PI_4 + 0.5).floor() as usize) % 8)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn flicks_land_on_the_eight_places() {\n        assert_eq!(flick(Vec2::new(0.0, 1.0)), Some(0));\n        assert_eq!(flick(Vec2::new(1.0, 1.0)), Some(1));\n        assert_eq!(flick(Vec2::new(1.0, 0.0)), Some(2));\n        assert_eq!(flick(Vec2::new(1.0, -1.0)), Some(3));\n        assert_eq!(flick(Vec2::new(0.0, -1.0)), Some(4));\n        assert_eq!(flick(Vec2::new(-1.0, -1.0)), Some(5));\n        assert_eq!(flick(Vec2::new(-1.0, 0.0)), Some(6));\n        assert_eq!(flick(Vec2::new(-1.0, 1.0)), Some(7));\n        assert_eq!(flick(Vec2::new(0.2, 0.2)), None);\n    }\n\n    #[test]\n    fn assist_slows_and_pulls_only_while_the_stick_moves() {\n        let at = Vec2::new(0.0, 0.0);\n        let target = Vec2::new(0.5, 0.0);\n        let still = integrate(at, Vec2::ZERO, 15.0, false, 1.0, 0.1, [target].into_iter());\n        assert_eq!(still, at);\n        let free = integrate(at, Vec2::new(0.0, 0.5), 15.0, false, 0.0, 0.1, [target].into_iter());\n        let helped = integrate(at, Vec2::new(0.0, 0.5), 15.0, false, 1.0, 0.1, [target].into_iter());\n        assert!(helped.x > 0.0 && free.x == 0.0, \"pulled toward the target\");\n        assert!(helped.y < free.y, \"slower near the target\");\n        let fine = integrate(at, Vec2::new(0.0, 1.0), 15.0, true, 0.0, 0.1, std::iter::empty());\n        let full = integrate(at, Vec2::new(0.0, 1.0), 15.0, false, 0.0, 0.1, std::iter::empty());\n        assert!((fine.y / full.y - 0.35).abs() < 1e-4);\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/mod.rs <<'EOF'\n//! The strains: each a state machine in code, its numbers in the case's data.\n\nmod dies_irae;\nmod introit;\nmod lacrimosa;\nmod libera;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::Surgery;\nuse super::content::StrainDef;\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::tune;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum StrainKind {\n    #[default]\n    Introit,\n    Lacrimosa,\n    DiesIrae,\n    Shocks,\n    Soloist,\n}\n\n/// A strain in play.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Strain {\n    pub kind: StrainKind,\n    pub wave: u32,\n    pub waves: u32,\n    pub speed: f32,\n    pub tough: f32,\n    pub beats: f32,\n    pub amen: bool,\n    pub count: u32,\n    pub rings: u32,\n    pub fever_rate: f32,\n    pub center: Vec2,\n    pub furnace: bool,\n    pub visible: bool,\n    /// Sub-state of the machine.\n    pub stage: u8,\n    pub kills: u32,\n    pub done: bool,\n    /// Beats since the stage or the last stroke.\n    pub beat_n: u32,\n    pub fever: Option<f32>,\n    pub ring: Option<f32>,\n    pub ring_beat: u32,\n    pub t: f32,\n    pub eye: u32,\n    pub burns_t: f32,\n}\n\nimpl Strain {\n    pub fn from_def(d: &StrainDef) -> Self {\n        Self {\n            kind: match d.kind.as_str() {\n                \"lacrimosa\" => StrainKind::Lacrimosa,\n                \"dies_irae\" => StrainKind::DiesIrae,\n                \"shocks\" => StrainKind::Shocks,\n                \"soloist\" => StrainKind::Soloist,\n                _ => StrainKind::Introit,\n            },\n            waves: d.waves.max(1),\n            speed: d.speed,\n            tough: d.tough,\n            beats: d.beats,\n            amen: d.amen,\n            count: d.count,\n            rings: d.rings,\n            fever_rate: d.fever,\n            center: Vec2::new(d.at[0], d.at[1]),\n            furnace: d.furnace,\n            visible: d.visible,\n            ..Default::default()\n        }\n    }\n}\n\nimpl Surgery {\n    /// How fast a strain runs this tick: its own number, the slider, the difficulty, the heart.\n    pub(in crate::games::surgery) fn strain_speed(&self, own: f32) -> f32 {\n        own * self.tune.get(tune::STRAIN_SPEED) * self.difficulty().strain * self.heart.strain_factor()\n    }\n\n    pub(super) fn strain_start(&mut self, def: &StrainDef, events: &mut Vec<SimEvent>) {\n        let mut st = Strain::from_def(def);\n        self.op.strain_tough = (def.tough * self.tune.get(tune::STRAIN_TOUGH)).max(0.05);\n        match st.kind {\n            StrainKind::Introit => self.introit_start(&mut st, events),\n            StrainKind::Lacrimosa => self.lacrimosa_start(&mut st, events),\n            StrainKind::DiesIrae => self.dies_irae_start(&mut st, events),\n            StrainKind::Shocks => st.t = 1.4,\n            StrainKind::Soloist => self.soloist_start(&mut st, events),\n        }\n        self.op.counters.bump(&format!(\"strain_{:?}\", st.kind));\n        self.op.strain = Some(st);\n    }\n\n    pub(super) fn strain_tick(&mut self, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        if !st.done {\n            match st.kind {\n                StrainKind::Introit => self.introit_tick(&mut st, dt, beat, events),\n                StrainKind::Lacrimosa => self.lacrimosa_tick(&mut st, dt, beat, events),\n                StrainKind::DiesIrae => self.dies_irae_tick(&mut st, dt, beat, events),\n                StrainKind::Shocks => self.shocks_tick(&mut st, dt, events),\n                StrainKind::Soloist => self.soloist_tick(&mut st, dt, beat, events),\n            }\n        }\n        self.op.strain = Some(st);\n    }\n\n    /// A strain's part was finished by a tool: the machine reacts.\n    pub(super) fn strain_killed(&mut self, h: &Hazard, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        match st.kind {\n            StrainKind::Introit => self.introit_killed(&mut st, h, events),\n            StrainKind::Lacrimosa => self.lacrimosa_killed(&mut st, h, events),\n            StrainKind::DiesIrae => self.dies_irae_killed(&mut st, h, events),\n            StrainKind::Soloist => self.soloist_killed(&mut st, h, events),\n            StrainKind::Shocks => {}\n        }\n        self.op.strain = Some(st);\n    }\n\n    /// Something timed out (a pull window, a stroke, an eye).\n    pub(super) fn hazard_expired(&mut self, id: u32, events: &mut Vec<SimEvent>) {\n        let Some(h) = self.hazard(id).cloned() else { return };\n        match h.kind {\n            HazardKind::Nodule if h.stage == 1 => {\n                // The shell grows back; it runs.\n                let hh = self.hazard_mut(id).unwrap();\n                hh.stage = 0;\n                hh.life = 0.0;\n                hh.count = 99;\n                self.callout(\"missed_pull\");\n            }\n            HazardKind::Incision => {\n                self.op.hazards.retain(|x| x.id != id);\n                for s in &mut self.surgeons {\n                    if s.engaged == id {\n                        s.engaged = 0;\n                    }\n                }\n                if let Some(p) = self.hazard(h.parent).cloned() {\n                    if p.kind == HazardKind::Eye {\n                        self.eye_missed(p.id, events);\n                        return;\n                    }\n                }\n                if h.tag == 7 {\n                    // A soloist stroke missed.\n                    self.hurt(3.0);\n                    if let Some(s) = self.op.strain.as_mut() {\n                        s.kills += 1;\n                    }\n                    self.surgeons.iter_mut().for_each(|s| s.chain = 0);\n                    self.cue_at(events, super::cue::TEAR, h.pos);\n                    self.op.counters.bump(\"stroke_missed\");\n                }\n            }\n            _ => {\n                self.op.hazards.retain(|x| x.id != id);\n            }\n        }\n    }\n\n    pub(super) fn tendril_pull(&mut self, slot: usize, id: u32, dt: f32, events: &mut Vec<SimEvent>) {\n        let cursor = self.surgeons[slot].cursor;\n        let diastole = self.heart.diastole();\n        let Some(h) = self.hazard(id) else { return };\n        let (len, from) = (h.len(), h.progress);\n        let (s_on, dist) = super::field::polyline_project(&h.pts, cursor, from, (from + 1.2).min(len));\n        if dist > 2.6 {\n            self.release(slot);\n            return;\n        }\n        let power = self.tune.get(super::tune::TOOL_POWER);\n        let forward = s_on > from + 0.02;\n        let pull_rate = 2.8 * power;\n        let h = self.hazard_mut(id).unwrap();\n        if diastole {\n            if forward {\n                h.progress = (from + pull_rate * dt).min(s_on);\n            }\n        } else if forward {\n            // Pulling against the pulse: it fights back.\n            h.progress = (from - 1.2 * dt).max(0.0);\n            h.t += dt;\n            if h.t > 0.25 {\n                h.t = 0.0;\n                h.err += 1.0;\n                self.hurt(1.2);\n                self.op.counters.bump(\"tendril_fought\");\n                let at = polyline_at_tip(self.hazard(id));\n                self.cue_at(events, super::cue::TEAR, at);\n                self.callout(\"diastole\");\n            }\n        }\n        let Some(h) = self.hazard(id) else { return };\n        if h.progress >= len - 0.1 {\n            let (err, pos) = (h.err, h.touch_point());\n            let strict = self.tune.get(tune::STRICT);\n            let rating = super::field::Rating::from_error(err, [0.5, 2.5, 6.0], strict);\n            self.surgeons[slot].engaged = 0;\n            self.cue_at(events, super::cue::POP, pos);\n            self.award(slot, rating, Tool::Forceps, pos, false, events);\n            let h = self.hazard(id).cloned().unwrap();\n            self.op.hazards.retain(|x| x.id != id);\n            self.op.counters.cleared(HazardKind::Tendril);\n            self.strain_killed(&h, events);\n        }\n    }\n\n    pub(super) fn eye_cut(&mut self, eye: u32, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        self.lacrimosa_eye_cut(&mut st, eye, events);\n        self.op.strain = Some(st);\n    }\n\n    fn eye_missed(&mut self, eye: u32, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        self.lacrimosa_eye_missed(&mut st, eye, events);\n        self.op.strain = Some(st);\n    }\n\n    pub(super) fn finish_ember(&mut self, id: u32, _slot: usize, events: &mut Vec<SimEvent>) {\n        let Some(h) = self.hazard(id).cloned() else { return };\n        self.op.hazards.retain(|x| x.id != id);\n        self.op.counters.cleared(HazardKind::Ember);\n        self.strain_killed(&h, events);\n    }\n\n    pub(super) fn furnace_step(&mut self, i: usize, events: &mut Vec<SimEvent>) {\n        let id = self.op.hazards[i].id;\n        let (stage, pos, r) = (self.op.hazards[i].stage, self.op.hazards[i].pos, self.op.hazards[i].r);\n        self.op.counters.bump(&format!(\"furnace_{stage}\"));\n        let h = &mut self.op.hazards[i];\n        h.progress = 0.0;\n        h.heat = 0.0;\n        h.by = 0;\n        h.drag = Vec2::ZERO;\n        match stage {\n            0 => {\n                h.stage = 1;\n                let d = Vec2::new(1.0, 0.25).normalize() * (r + 0.6);\n                self.add_hazard(Hazard {\n                    kind: HazardKind::Incision,\n                    pts: vec![pos - d, pos + d],\n                    pos,\n                    parent: id,\n                    required: true,\n                    tag: 3,\n                    ..Default::default()\n                });\n            }\n            1 => h.stage = 2,\n            2 => h.stage = 3,\n            3 => h.stage = 4,\n            4 => {\n                h.stage = 5;\n                let d = Vec2::new(0.3, 1.0).normalize() * 1.2;\n                h.pts = vec![pos - d, pos + d];\n                h.last_s = 0.0;\n                h.count = 0;\n                h.err = 0.0;\n            }\n            _ => {\n                let h = self.op.hazards.remove(i);\n                self.op.counters.cleared(HazardKind::Furnace);\n                self.strain_killed(&h, events);\n            }\n        }\n    }\n}\n\nfn polyline_at_tip(h: Option<&Hazard>) -> Vec2 {\n    h.map(|h| h.touch_point()).unwrap_or_default()\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/introit.rs <<'EOF'\n//! Introit, 3/4. A violet nodule moves under the tissue, seen as a bump. Every three beats it\n//! steps somewhere new (a ripple telegraphs on beat two) and leaves a wound behind. Scanner lights\n//! it; Laser at rest pops the shell; Forceps pull it within two beats. The first kill splits it in\n//! two, then four small quick ones, then the Amen: merged, held by three tethers.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\n/// Beats between steps, by wave.\nfn step_beats(wave: u32) -> u8 {\n    if wave >= 2 { 2 } else { 3 }\n}\n\nimpl Surgery {\n    pub(super) fn introit_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 3;\n        self.spawn_nodules(st, 1, 0.62, 1.0, events);\n    }\n\n    fn spawn_nodules(&mut self, st: &mut Strain, n: u32, r: f32, heat: f32, events: &mut Vec<SimEvent>) {\n        self.op.grace_beats = 1.0;\n        for k in 0..n {\n            let at = self.field_spot(st.center, k);\n            self.add_hazard(Hazard {\n                kind: HazardKind::Nodule,\n                pos: at,\n                to: at,\n                r,\n                hidden: !st.visible,\n                required: true,\n                group: st.wave as u16,\n                err: heat,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, st.center);\n    }\n\n    /// A random spot on the plate, away from the HUD.\n    pub(in crate::games::surgery) fn field_spot(&mut self, center: Vec2, k: u32) -> Vec2 {\n        let a = self.rand() * std::f32::consts::TAU + k as f32 * 2.1;\n        let d = 1.0 + self.rand() * 3.0;\n        let p = center + Vec2::new(a.cos() * d * 1.6, a.sin() * d * 0.8);\n        Vec2::new(p.x.clamp(-8.0, 8.0), p.y.clamp(-3.6, 3.8))\n    }\n\n    pub(super) fn introit_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        // The Hush wakes under pressure.\n        if self.op.vitals < 35.0 {\n            self.wake_gift(events);\n        }\n        let speed = self.strain_speed(st.speed);\n        let wave = st.wave;\n        let step = step_beats(wave);\n        let mut stepped: Vec<(u32, Vec2)> = Vec::new();\n        let mut telegraphs = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Nodule) {\n            h.dev = (h.dev - dt * 1.5).max(0.0);\n            if h.t > 0.0 {\n                // Stepping: anticipation, then a quick slide.\n                h.t = (h.t - dt * speed * 2.2).max(0.0);\n                let k = 1.0 - h.t;\n                h.pos = h.pos.lerp(h.to, (k * k).clamp(0.0, 1.0) * 0.35);\n                if h.t <= 0.0 {\n                    h.pos = h.to;\n                }\n            }\n            if h.locked || h.stage != 0 || h.by != 0 || h.t > 0.0 {\n                if beat && h.stage == 1 {\n                    h.count = 0;\n                }\n                continue;\n            }\n            if beat {\n                h.count = h.count.saturating_add(1);\n                if h.count + 1 == step {\n                    h.dev = 1.0;\n                    telegraphs.push(h.pos);\n                }\n                if h.count >= step {\n                    h.count = 0;\n                    stepped.push((h.id, h.pos));\n                }\n            }\n        }\n        for at in telegraphs {\n            self.cue_at(events, cue::RIPPLE, at);\n            self.op.counters.bump(\"nodule_telegraph\");\n        }\n        for (id, from) in stepped {\n            let to = self.field_spot(st.center, id);\n            let leave_wound = self.rand() < 0.55;\n            if let Some(h) = self.hazard_mut(id) {\n                h.to = to;\n                h.t = 1.0;\n            }\n            self.op.counters.bump(\"nodule_step\");\n            // It leaves a wound or a pool behind.\n            let wounds = self.op.hazards.iter().filter(|h| matches!(h.kind, HazardKind::Laceration | HazardKind::Pool)).count();\n            if wounds < 7 {\n                if leave_wound {\n                    let d = Vec2::from_angle(self.rand() * 6.28) * 0.75;\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Laceration,\n                        pts: vec![from - d, from + d],\n                        pos: from,\n                        required: false,\n                        ..Default::default()\n                    });\n                } else {\n                    self.add_hazard(Hazard { kind: HazardKind::Pool, pos: from, r: 0.65, ..Default::default() });\n                }\n            }\n        }\n    }\n\n    pub(super) fn introit_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        if h.kind != HazardKind::Nodule {\n            return;\n        }\n        st.kills += 1;\n        self.op.counters.bump(&format!(\"introit_wave_{}\", st.wave));\n        let left = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Nodule).count();\n        if left > 0 {\n            return;\n        }\n        st.wave += 1;\n        if st.wave >= st.waves {\n            st.done = true;\n            self.cue_at(events, cue::STINGER, h.pos);\n            return;\n        }\n        match st.wave {\n            1 => {\n                // It splits in two: 60% heat each.\n                self.spawn_nodules(st, 2, 0.5, 0.6, events);\n                self.op.strain_tough = self.op.strain_tough.min(0.6 * self.op.strain_tough.max(1.0));\n                self.say(\"mara\", \"It split. Bashir, it split!\");\n            }\n            2 => {\n                self.spawn_nodules(st, 4, 0.36, 0.5, events);\n                self.op.strain_tough *= 0.8;\n                self.say(\"teddy\", \"Four. There are four. I'd like to speak to whoever's in charge of counting.\");\n                self.wake_gift(events);\n            }\n            _ => {\n                // The Amen.\n                let at = st.center;\n                self.op.strain_tough = (self.op.strain_tough * 1.6).max(1.0);\n                let big = self.add_hazard(Hazard {\n                    kind: HazardKind::Nodule,\n                    pos: at,\n                    to: at,\n                    r: 1.0,\n                    locked: true,\n                    required: true,\n                    group: 9,\n                    ..Default::default()\n                });\n                for k in 0..3 {\n                    let a = k as f32 * std::f32::consts::TAU / 3.0 + 0.5;\n                    let far = at + Vec2::new(a.cos() * 3.8, a.sin() * 2.1);\n                    let near = at + Vec2::new(a.cos() * 1.4, a.sin() * 0.9);\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Tether,\n                        pts: vec![far, far.lerp(near, 0.5) + Vec2::new(0.25, -0.2), near],\n                        pos: far.lerp(near, 0.5),\n                        parent: big,\n                        required: true,\n                        ..Default::default()\n                    });\n                }\n                self.say(\"bashir\", \"Three tethers. Cut them. Then the shell.\");\n                self.op.shake = 1.0;\n                self.cue_at(events, cue::STINGER, at);\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/lacrimosa.rs <<'EOF'\n//! Lacrimosa, 6/8. A crown with six teardrop sacs on stems. They swell and burst into caustic\n//! pools. Laser a stem to drop a sac whole, or Suction it slowly for a lower rating. A cleared wave\n//! opens the crown's eye: Scalpel across it, twice. Three waves, each faster; then tear out the eye\n//! with Forceps and Gel the bed.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\n/// Beats the eye holds open for each stroke.\nconst EYE_BEATS: f32 = 7.0;\n\nimpl Surgery {\n    pub(super) fn lacrimosa_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 6;\n        let at = st.center;\n        self.add_hazard(Hazard { kind: HazardKind::Crown, pos: at, r: 1.25, ..Default::default() });\n        st.eye = self.add_hazard(Hazard { kind: HazardKind::Eye, pos: at, r: 0.75, required: true, ..Default::default() });\n        self.spawn_sacs(st, st.count, events);\n    }\n\n    fn spawn_sacs(&mut self, st: &mut Strain, n: u32, events: &mut Vec<SimEvent>) {\n        let at = st.center;\n        for k in 0..n {\n            let a = k as f32 * std::f32::consts::TAU / n as f32 + st.wave as f32 * 0.4 + 0.3;\n            let dir = Vec2::new(a.cos() * 1.5, a.sin());\n            let stem = at + dir * 1.15;\n            let sac = at + dir * 2.5;\n            let lag = self.rand() * 0.25;\n            self.add_hazard(Hazard {\n                kind: HazardKind::Sac,\n                pos: sac,\n                to: stem,\n                r: 0.3,\n                progress: lag,\n                axis: a,\n                required: true,\n                group: st.wave as u16,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, at);\n    }\n\n    pub(super) fn lacrimosa_tick(&mut self, st: &mut Strain, dt: f32, _beat: bool, events: &mut Vec<SimEvent>) {\n        // Each wave swells faster.\n        let speed = self.strain_speed(st.speed) * (1.0 + st.wave as f32 * 0.22);\n        let swell = dt * speed / (st.beats * 60.0 / 72.0);\n        let mut burst = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Sac) {\n            h.progress += swell;\n            h.r = 0.3 + h.progress.min(1.0) * 0.42;\n            h.t += dt;\n            if h.progress >= 1.0 {\n                burst.push(h.id);\n            }\n        }\n        for id in burst {\n            let Some(h) = self.hazard(id).cloned() else { continue };\n            self.op.hazards.retain(|x| x.id != id);\n            for s in &mut self.surgeons {\n                if s.engaged == id {\n                    s.engaged = 0;\n                }\n            }\n            self.add_hazard(Hazard { kind: HazardKind::Pool, pos: h.pos, r: 1.15, drain: 1.0, tag: 1, ..Default::default() });\n            self.add_hazard(Hazard { kind: HazardKind::Burn, pos: h.pos, r: 0.65, required: false, ..Default::default() });\n            self.cue_at(events, cue::BURST, h.pos);\n            self.op.counters.bump(\"sac_burst\");\n            self.op.shake = self.op.shake.max(0.6);\n            self.callout(\"burst\");\n            self.lacrimosa_killed(st, &h, events);\n        }\n    }\n\n    pub(super) fn lacrimosa_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        match h.kind {\n            HazardKind::Sac => {\n                st.kills += 1;\n                let left = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Sac).count();\n                if left == 0 {\n                    self.open_eye(st, events);\n                }\n            }\n            HazardKind::Eye => {\n                // Torn out and gelled: it's over.\n                st.done = true;\n                self.op.hazards.retain(|x| x.kind != HazardKind::Crown);\n                self.cue_at(events, cue::STINGER, h.pos);\n                self.op.counters.bump(\"eye_torn_out\");\n            }\n            _ => {}\n        }\n    }\n\n    fn open_eye(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        let eye = st.eye;\n        if let Some(h) = self.hazard_mut(eye) {\n            h.stage = 1;\n            h.count = 0;\n        }\n        self.op.counters.bump(\"eye_opened\");\n        self.cue_at(events, cue::RIPPLE, st.center);\n        self.callout(\"eye_open\");\n        self.spawn_eye_stroke(st);\n    }\n\n    fn spawn_eye_stroke(&mut self, st: &mut Strain) {\n        let eye = st.eye;\n        let n = self.hazard(eye).map(|h| h.count).unwrap_or(0);\n        let a = 0.6 + n as f32 * 1.4 + st.wave as f32;\n        let d = Vec2::new(a.cos() * 1.5, a.sin()) * 1.15;\n        let life = self.heart.period() * EYE_BEATS / self.difficulty().strain;\n        self.add_hazard(Hazard {\n            kind: HazardKind::Incision,\n            pts: vec![st.center - d, st.center + d],\n            pos: st.center,\n            parent: eye,\n            life,\n            required: true,\n            ..Default::default()\n        });\n    }\n\n    pub(super) fn lacrimosa_eye_cut(&mut self, st: &mut Strain, eye: u32, events: &mut Vec<SimEvent>) {\n        let n = {\n            let Some(h) = self.hazard_mut(eye) else { return };\n            h.count += 1;\n            h.count\n        };\n        self.op.counters.bump(\"eye_cut\");\n        if n < 2 {\n            self.spawn_eye_stroke(st);\n            return;\n        }\n        st.wave += 1;\n        if let Some(h) = self.hazard_mut(eye) {\n            h.count = 0;\n            h.stage = 0;\n        }\n        if st.wave >= st.waves {\n            if let Some(h) = self.hazard_mut(eye) {\n                h.stage = 2;\n                h.axis = -std::f32::consts::FRAC_PI_2;\n            }\n            self.say(\"bashir\", \"Forceps. Take the eye. All of it.\");\n            return;\n        }\n        self.op.shake = 0.7;\n        let count = st.count;\n        self.spawn_sacs(st, count, events);\n    }\n\n    pub(super) fn lacrimosa_eye_missed(&mut self, st: &mut Strain, eye: u32, events: &mut Vec<SimEvent>) {\n        // It closes, and weeps again.\n        if let Some(h) = self.hazard_mut(eye) {\n            h.stage = 0;\n            h.count = 0;\n        }\n        self.op.counters.bump(\"eye_missed\");\n        self.say(\"bashir\", \"It closed. Here they come again.\");\n        let n = (st.count / 2).max(2);\n        self.spawn_sacs(st, n, events);\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/dies_irae.rs <<'EOF'\n//! Dies Irae, 5/4. A Fever meter fills. Embers heat the tissue, and on every fifth beat a heat ring\n//! sweeps the field: a held trigger scorches. Cryoprobe an ember, Scalpel to crack it, Forceps the\n//! three pieces out; each removal cools the Fever. Midway two embers merge and roam. Last, an\n//! incision reveals the furnace beneath: all tools in sequence.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\nuse crate::input::hands;\n\nimpl Surgery {\n    pub(super) fn dies_irae_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = if st.rings == 7 { 7 } else { 5 };\n        if st.fever_rate > 0.0 {\n            st.fever = Some(self.op.fever_start);\n        }\n        let n = st.count;\n        for k in 0..n {\n            let a = k as f32 * std::f32::consts::TAU / n as f32 - 1.2;\n            let at = st.center + Vec2::new(a.cos() * 4.6, a.sin() * 2.5);\n            self.add_hazard(Hazard {\n                kind: HazardKind::Ember,\n                pos: at,\n                to: at,\n                r: 0.6,\n                required: true,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, st.center);\n    }\n\n    pub(super) fn dies_irae_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let speed = self.strain_speed(st.speed);\n        if let Some(f) = st.fever.as_mut() {\n            *f += st.fever_rate * dt * speed;\n            if *f > 100.0 {\n                let burn = 6.0 * dt * self.difficulty().drain;\n                *f = f.min(130.0);\n                self.hurt(burn);\n                self.op.counters.bump(\"fever_over\");\n            }\n        }\n        // The rings: a count-in, then a sweep.\n        if st.rings > 0 && st.ring.is_none() && beat {\n            st.ring_beat += 1;\n            let left = st.rings.saturating_sub(st.ring_beat);\n            if left == 2 || left == 1 {\n                self.cue_at(events, cue::TICK, Vec2::ZERO);\n                if left == 1 {\n                    self.say_short(\"lift_off\");\n                }\n            }\n            if left == 0 {\n                st.ring_beat = 0;\n                st.ring = Some(0.0);\n                self.cue_at(events, cue::RING, st.center);\n                self.op.counters.bump(\"ring_sweep\");\n            }\n        }\n        if let Some(r) = st.ring {\n            let next = r + dt * 15.0 * speed.max(0.6);\n            let center = st.center;\n            let crossing: Vec<usize> = (0..4)\n                .filter(|&i| {\n                    let s = &self.surgeons[i];\n                    let d = s.cursor.distance(center);\n                    s.present && !s.bot && s.using && self.last_held[i] & hands::USE != 0 && d >= r && d < next\n                })\n                .collect();\n            for slot in crossing {\n                let at = self.surgeons[slot].cursor;\n                self.add_hazard(Hazard { kind: HazardKind::Burn, pos: at, r: 0.75, required: false, ..Default::default() });\n                self.surgeons[slot].chain = 0;\n                self.mistake(slot);\n                self.hurt(2.5);\n                self.cue_at(events, cue::SCORCH, at);\n                self.op.counters.bump(\"ring_scorch\");\n                self.callout(\"scorched\");\n            }\n            st.ring = (next < 14.0).then_some(next);\n        }\n        // Embers heat the tissue, and the roaming one wanders.\n        st.burns_t += dt;\n        if st.burns_t > 14.0 {\n            st.burns_t = 0.0;\n            let burns = self.op.hazards.iter().filter(|h| h.kind == HazardKind::Burn).count();\n            let ember = self.op.hazards.iter().find(|h| h.kind == HazardKind::Ember && h.stage == 0).map(|h| h.pos);\n            if let (true, Some(at)) = (burns < 4, ember) {\n                let d = Vec2::from_angle(self.rand() * 6.28) * 1.1;\n                self.add_hazard(Hazard { kind: HazardKind::Burn, pos: at + d, r: 0.55, required: false, ..Default::default() });\n            }\n        }\n        let mut retarget = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Ember && h.tag == 8 && h.stage == 0 && h.by == 0) {\n            let step = 0.7 * dt * speed;\n            let d = h.to - h.pos;\n            if d.length() < 0.2 {\n                retarget.push(h.id);\n            } else {\n                h.pos += d.normalize() * step;\n            }\n        }\n        for id in retarget {\n            let to = self.field_spot(st.center, id);\n            if let Some(h) = self.hazard_mut(id) {\n                h.to = to;\n            }\n        }\n        // The furnace: when the opening incision is done.\n        if st.stage == 1 && self.op.incisions_done >= 1 {\n            st.stage = 2;\n            self.op.incisions_done = 0;\n            let at = st.center;\n            self.set_plate(\"furnace\", at);\n            self.add_hazard(Hazard { kind: HazardKind::Furnace, pos: at, r: 1.7, required: true, ..Default::default() });\n            self.op.shake = 1.0;\n            self.op.push = 1.0;\n            self.op.push_at = at;\n            self.say(\"pet\", \"There you are. Every instrument, young man. In order. Cold, cut, lift, burn, soothe, close.\");\n            self.cue_at(events, cue::STINGER, at);\n            self.op.counters.bump(\"furnace_revealed\");\n        }\n    }\n\n    pub(super) fn dies_irae_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        match h.kind {\n            HazardKind::Ember => {\n                st.kills += 1;\n                if let Some(f) = st.fever.as_mut() {\n                    *f = (*f - 22.0).max(0.0);\n                }\n                self.op.counters.bump(\"ember_out\");\n                let embers = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Ember).count();\n                // Midway: the next two left merge and roam.\n                if st.kills == 2 && st.count >= 4 && !self.op.embers_merged {\n                    self.op.embers_merged = true;\n                    let two: Vec<u32> =\n                        self.op.hazards.iter().filter(|x| x.kind == HazardKind::Ember && x.stage == 0).take(2).map(|x| x.id).collect();\n                    if two.len() == 2 {\n                        let (a, b) = (self.hazard(two[0]).unwrap().pos, self.hazard(two[1]).unwrap().pos);\n                        self.op.hazards.retain(|x| x.id != two[1]);\n                        let to = self.field_spot(st.center, 4);\n                        let m = self.hazard_mut(two[0]).unwrap();\n                        m.pos = a.lerp(b, 0.5);\n                        m.to = to;\n                        m.r = 0.9;\n                        m.tag = 8;\n                        self.op.counters.bump(\"embers_merged\");\n                        self.say(\"pet\", \"Two became one and it has learned to walk. Lovely. Keep your hands up.\");\n                        self.cue_at(events, cue::STINGER, h.pos);\n                    }\n                }\n                if embers == 0 && st.stage == 0 {\n                    if st.furnace {\n                        st.stage = 1;\n                        self.op.incisions_done = 0;\n                        let c = st.center;\n                        self.add_hazard(Hazard {\n                            kind: HazardKind::Incision,\n                            pts: vec![c + Vec2::new(-3.2, 0.5), c + Vec2::new(-1.0, -0.2), c + Vec2::new(1.2, 0.2), c + Vec2::new(3.2, -0.4)],\n                            pos: c,\n                            required: true,\n                            ..Default::default()\n                        });\n                        self.say(\"pet\", \"It's not the embers. It's what they were feeding. Open her up.\");\n                    } else {\n                        st.done = true;\n                    }\n                }\n            }\n            HazardKind::Furnace => {\n                st.done = true;\n                st.fever = st.fever.map(|f| f.min(10.0));\n                self.op.counters.bump(\"furnace_out\");\n                self.cue_at(events, cue::STINGER, h.pos);\n            }\n            _ => {}\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/libera.rs <<'EOF'\n//! Libera Me's own acts. The strain stops the heart on purpose: three shocks, each on a ghost beat.\n//! Then the Soloist surfaces: Scalpel strokes on the beat, nearly a rhythm game, and a long tendril\n//! pulled only in diastole, a tug-of-war with the pulse.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\nimpl Surgery {\n    pub(super) fn shocks_tick(&mut self, st: &mut Strain, dt: f32, _events: &mut Vec<SimEvent>) {\n        match st.stage {\n            0 => {\n                st.t -= dt;\n                if st.t <= 0.0 {\n                    st.stage = 1;\n                    self.start_code(true, st.count.min(9) as u8);\n                }\n            }\n            _ => st.done = true,\n        }\n    }\n\n    pub(super) fn soloist_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 4;\n        st.stage = 0;\n        st.kills = 0;\n        self.op.shake = 1.0;\n        self.cue_at(events, cue::STINGER, st.center);\n        self.op.counters.bump(\"soloist\");\n    }\n\n    pub(super) fn soloist_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let _ = dt;\n        match st.stage {\n            0 => {\n                // Strokes appear on the beat: every other beat.\n                if beat {\n                    st.beat_n += 1;\n                }\n                if beat && st.beat_n % 2 == 1 && st.wave < st.count {\n                    let k = st.wave;\n                    st.wave += 1;\n                    let a = k as f32 * 2.399;\n                    let at = st.center + Vec2::new(a.cos() * 4.8, a.sin() * 2.4) * (0.4 + 0.6 * ((k % 3) as f32 / 2.0));\n                    let dir = Vec2::from_angle(a + 1.2);\n                    let life = self.heart.period() * st.beats / self.difficulty().strain;\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Incision,\n                        pts: vec![at - dir * 1.1, at + dir * 1.1],\n                        pos: at,\n                        life,\n                        tag: 7,\n                        required: false,\n                        ..Default::default()\n                    });\n                    self.cue_at(events, cue::TICK, at);\n                }\n                if st.wave >= st.count && !self.op.hazards.iter().any(|h| h.kind == HazardKind::Incision && h.tag == 7) {\n                    st.stage = 1;\n                    let c = st.center;\n                    let mut pts = Vec::new();\n                    for i in 0..=14 {\n                        let t = i as f32 / 14.0;\n                        pts.push(\n                            c + Vec2::new(-6.2 + t * 12.4, (t * 9.0).sin() * 1.8 + (t - 0.5) * 2.5),\n                        );\n                    }\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Tendril,\n                        pos: c,\n                        pts,\n                        required: true,\n                        ..Default::default()\n                    });\n                    self.say(\"pet\", \"There's its spine. Forceps. Pull when the heart lets you and not one moment before.\");\n                    self.op.shake = 1.0;\n                    self.cue_at(events, cue::STINGER, c);\n                    self.op.counters.bump(\"tendril\");\n                }\n            }\n            _ => {}\n        }\n    }\n\n    pub(super) fn soloist_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        if h.kind == HazardKind::Tendril {\n            st.done = true;\n            self.cue_at(events, cue::STINGER, h.pos);\n            self.op.counters.bump(\"tendril_out\");\n        }\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/content.rs'\ns=open(p).read()\ns=s.replace('''    /// The furnace beneath, at the end of Dies Irae.\n    #[serde(default)]\n    pub furnace: bool,\n}''','''    /// The furnace beneath, at the end of Dies Irae.\n    #[serde(default)]\n    pub furnace: bool,\n    /// Nodules stay visible (Case 7): no Scanner needed.\n    #[serde(default)]\n    pub visible: bool,\n}''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/field.rs'\ns=open(p).read()\ns=s.replace('''                HazardKind::Pool => 0.2 * h.r * h.r,\n                _ => h.drain,''','''                HazardKind::Pool => 0.2 * h.r * h.r + h.drain,\n                _ => h.drain,''')\ns=s.replace('''        h.id = self.op.next_id;\n        self.op.next_id += 1;\n        h.drain = match h.kind {''','''        h.id = self.op.next_id;\n        self.op.next_id += 1;\n        let caustic = h.drain;\n        h.drain = match h.kind {\n            HazardKind::Pool => caustic,''')\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write the frame, cursor helpers and all strain state machines"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":34280,"cache_read_input_tokens":298585,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":34280},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"d26c4098-7bcc-49d8-9310-31bed7da6a09","timestamp":"2026-11-05T13:48:02.254Z","request_id":"req_011Cgjt2zNYosBWCcrS2X5TW","wire_tool_inputs":{"toolu_01Saa5SS2hATcHEcJLs4BRkg":{"command":"cat > crates/pav_core/src/games/surgery/frame.rs <<'EOF'\n//! `SurgeryFrame`: the single source of everything drawn. Built from the sim on the host and\n//! decoded from the network on a client.\n\nuse std::sync::Arc;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::field::{GhostHand, Hazard, Popup, Stain, Tool};\n\n/// Where the game is. Numbers go over the network.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Stage {\n    /// The title's idle plate.\n    #[default]\n    Title,\n    /// A story scene.\n    Story,\n    /// The chart card before an operation.\n    Chart,\n    /// \"OPERATION START\".\n    OpStart,\n    Op,\n    /// The heart stopped: 5 seconds to shock it.\n    Code,\n    /// \"OPERATION COMPLETE\".\n    Complete,\n    Results,\n    /// Time of death.\n    Dead,\n    /// The whole run is done.\n    Finished,\n    /// The hub's pre-op board.\n    Card,\n}\n\n/// The camera, set by the game: applied to the engine's `CameraRig` in the app and the tools.\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    /// Seconds to glide here from the last shot (0 = cut).\n    pub blend: f32,\n}\n\nimpl CameraShot {\n    /// The surgeon's-eye view of the field.\n    pub const FIELD: CameraShot = CameraShot { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9, fov: 36.0, blend: 0.0 };\n    /// The paper theatre, straight on.\n    pub const PAPER: CameraShot = CameraShot { target: [0.0, 0.0, 0.0], tilt: 0.0, yaw: 0.0, distance: 14.0, fov: 26.0, blend: 0.0 };\n    /// The 3D wide shot of the operating room.\n    pub const WIDE: CameraShot = CameraShot { target: [94.0, 1.1, -3.0], tilt: 16.0, yaw: 24.0, distance: 9.0, fov: 40.0, blend: 0.0 };\n}\n\nimpl Default for CameraShot {\n    fn default() -> Self {\n        Self::FIELD\n    }\n}\n\n/// A person at a stage position.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ActorView {\n    pub who: Arc<str>,\n    pub expr: Arc<str>,\n    /// Where they stand (x).\n    pub x: f32,\n    /// Seconds since they came on; negative: leaving.\n    pub t: f32,\n    pub leaving: bool,\n    pub talking: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StoryView {\n    pub key: Arc<str>,\n    pub line: u32,\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    /// Characters shown so far.\n    pub chars: u32,\n    pub typed: bool,\n    pub set: Arc<str>,\n    pub actors: Vec<ActorView>,\n    pub camera_or: bool,\n    pub flash: f32,\n    pub shake: f32,\n    /// Seconds on this line.\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ChartView {\n    pub case_no: u8,\n    pub case_name: Arc<str>,\n    pub patient: Arc<str>,\n    pub life: Arc<str>,\n    pub diagnosis: Arc<str>,\n    pub surgeon: Arc<str>,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ResultsView {\n    pub case_no: u8,\n    pub case_name: Arc<str>,\n    pub patient: Arc<str>,\n    pub fate: Arc<str>,\n    pub action_points: i32,\n    pub vitals_bonus: i32,\n    pub time_bonus: i32,\n    pub mistakes: u32,\n    pub mistake_penalty: i32,\n    pub total: i32,\n    pub par: i32,\n    pub rank: Arc<str>,\n    pub counts: [u32; 4],\n    pub best_chain: u32,\n    /// Each surgeon's own score, in co-op.\n    pub scores: Vec<(u8, i32)>,\n    pub t: f32,\n    /// More operations follow in this run.\n    pub won: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct DeathView {\n    pub time: Arc<str>,\n    pub patient: Arc<str>,\n    pub fate: Arc<str>,\n    pub checkpoint: bool,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CodeView {\n    /// Seconds left to shock it.\n    pub left: f32,\n    pub window: f32,\n    /// The ghost beat's place: 0 at the left, 0.5 on the centre line, 1 at the right.\n    pub ghost: f32,\n    /// Shocks this Code still needs.\n    pub shocks: u8,\n    /// Scripted stops don't count against the allowance.\n    pub scripted: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct SurgeonView {\n    pub slot: u8,\n    pub present: bool,\n    pub bot: bool,\n    pub cursor: Vec2,\n    pub raw: Vec2,\n    pub tool: Tool,\n    pub engaged: u32,\n    pub using: bool,\n    pub pressure: f32,\n    pub score: i32,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_ready: bool,\n    pub gift_hold: bool,\n    /// 0 Hush, 1 Echo.\n    pub gift_kind: u8,\n    pub flow: f32,\n    pub dose: f32,\n    pub iv_cool: f32,\n    pub iv_on: bool,\n    pub charge: f32,\n    pub charging: bool,\n    pub kick: f32,\n    /// The tool's progress on what it is on, for its ring (0..1.3).\n    pub meter: f32,\n    pub name: Arc<str>,\n}\n\n/// One line of an in-op voice.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Subtitle {\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    pub age: f32,\n    /// Counts up with every new line.\n    pub serial: u32,\n}\n\n/// What the music should be doing.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MusicView {\n    /// `title`, `tender`, `tense`, `or`, `codeblue`, `results`, or empty for silence.\n    pub track: Arc<str>,\n    pub crisis: f32,\n    pub hush: f32,\n    /// The strain's motif, by meter (0 = none).\n    pub motif: u8,\n}\n\n/// Everything drawn in one tick.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub stage: Stage,\n    pub tick: u64,\n    /// Rule seconds: what the tissue and the strains move by.\n    pub clock: f32,\n    pub shot: CameraShot,\n    pub case_no: u8,\n    pub phase: u8,\n    pub phases: u8,\n    pub case_name: Arc<str>,\n    pub attract: bool,\n    pub codeblue: bool,\n    pub mirror: bool,\n    pub plate: Arc<str>,\n    pub prev_plate: Option<Arc<str>>,\n    /// Cross-fade from the last plate, 0..1, spreading from `plate_from`.\n    pub plate_blend: f32,\n    pub plate_from: Vec2,\n    pub vitals: f32,\n    pub vitals_max: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub flat: bool,\n    pub meter: u8,\n    pub bar_beat: u8,\n    pub timer: f32,\n    pub timer_total: f32,\n    pub hazards: Vec<Hazard>,\n    pub stains: Vec<Stain>,\n    pub surgeons: Vec<SurgeonView>,\n    pub ring: [Tool; 8],\n    pub forced_tool: Option<Tool>,\n    pub objective: Arc<str>,\n    pub guided: bool,\n    /// The hazard the guide highlights.\n    pub guide: u32,\n    pub subtitle: Option<Subtitle>,\n    pub popups: Vec<Popup>,\n    pub ghosts: Vec<GhostHand>,\n    pub pings: Vec<(Vec2, f32)>,\n    /// Big centred text and how long it has been up.\n    pub banner: Option<(Arc<str>, f32)>,\n    pub hush: f32,\n    pub echo: f32,\n    pub gift_awake: bool,\n    pub duet: bool,\n    pub fever: Option<f32>,\n    /// A heat ring's radius as it sweeps.\n    pub heat_ring: Option<f32>,\n    /// Beats until the next ring (the count-in), 0 = none.\n    pub ring_in: u8,\n    pub code: Option<CodeView>,\n    pub story: Option<StoryView>,\n    pub chart: Option<ChartView>,\n    pub results: Option<ResultsView>,\n    pub death: Option<DeathView>,\n    pub music: MusicView,\n    pub shake: f32,\n    pub flash: f32,\n    /// A camera push's strength, 0..1, and where it looks.\n    pub push: f32,\n    pub push_at: Vec2,\n    /// Dev overlays bitmask.\n    pub overlays: u32,\n    pub tremor: bool,\n}\n\nimpl SurgeryFrame {\n    /// Screen-independent: the valid targets for this tool (aim assist's magnets).\n    pub fn targets(&self, tool: Tool) -> impl Iterator<Item = Vec2> + '_ {\n        self.hazards.iter().filter(move |h| h.accepts(tool)).map(|h| h.touch_point())\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/surgeon.rs <<'EOF'\n//! The cursor between devices and field: how a stick moves it, and aim assist. This runs on the\n//! render side (zero lag), on the same numbers the sim uses.\n\nuse glam::Vec2;\n\n/// Keep gameplay inside this; the cursor may reach the tray below it.\npub const FIELD_X: f32 = 10.6;\npub const FIELD_Z_MIN: f32 = -5.6;\npub const FIELD_Z_MAX: f32 = 6.1;\n\n/// Moves a pad's or the keyboard's cursor for one frame: `v = speed * s^2.2`; near a valid\n/// target speed falls by up to 50% and the cursor is pulled toward it at up to 3 u/s, only while\n/// the stick is moving.\npub fn integrate(\n    mut cursor: Vec2,\n    stick: Vec2,\n    speed: f32,\n    precision: bool,\n    assist: f32,\n    dt: f32,\n    targets: impl Iterator<Item = Vec2>,\n) -> Vec2 {\n    let s = stick.length().min(1.0);\n    if s <= 0.001 {\n        return cursor;\n    }\n    let dir = stick / stick.length();\n    let mut v = speed * s.powf(2.2);\n    if precision {\n        v *= 0.35;\n    }\n    let mut pull = Vec2::ZERO;\n    if assist > 0.0 {\n        let mut best: Option<(f32, Vec2)> = None;\n        for t in targets {\n            let d = t.distance(cursor);\n            if d < 1.2 && best.is_none_or(|b| d < b.0) {\n                best = Some((d, t));\n            }\n        }\n        if let Some((d, t)) = best {\n            let k = (1.0 - d / 1.2).clamp(0.0, 1.0) * assist.min(1.0);\n            v *= 1.0 - 0.5 * k;\n            if d > 0.02 {\n                pull = (t - cursor) / d * 3.0 * k.max(0.25 * assist);\n            }\n        }\n    }\n    cursor += (dir * v + pull) * dt;\n    clamp(cursor)\n}\n\npub fn clamp(p: Vec2) -> Vec2 {\n    Vec2::new(p.x.clamp(-FIELD_X, FIELD_X), p.y.clamp(FIELD_Z_MIN, FIELD_Z_MAX))\n}\n\n/// A flick of the left stick: which of 8 ring places it points at (0 = up, clockwise). `stick`\n/// has y up.\npub fn flick(stick: Vec2) -> Option<usize> {\n    if stick.length() < 0.55 {\n        return None;\n    }\n    let a = stick.x.atan2(stick.y).rem_euclid(std::f32::consts::TAU);\n    Some(((a / std::f32::consts::FRAC_PI_4 + 0.5).floor() as usize) % 8)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn flicks_land_on_the_eight_places() {\n        assert_eq!(flick(Vec2::new(0.0, 1.0)), Some(0));\n        assert_eq!(flick(Vec2::new(1.0, 1.0)), Some(1));\n        assert_eq!(flick(Vec2::new(1.0, 0.0)), Some(2));\n        assert_eq!(flick(Vec2::new(1.0, -1.0)), Some(3));\n        assert_eq!(flick(Vec2::new(0.0, -1.0)), Some(4));\n        assert_eq!(flick(Vec2::new(-1.0, -1.0)), Some(5));\n        assert_eq!(flick(Vec2::new(-1.0, 0.0)), Some(6));\n        assert_eq!(flick(Vec2::new(-1.0, 1.0)), Some(7));\n        assert_eq!(flick(Vec2::new(0.2, 0.2)), None);\n    }\n\n    #[test]\n    fn assist_slows_and_pulls_only_while_the_stick_moves() {\n        let at = Vec2::new(0.0, 0.0);\n        let target = Vec2::new(0.5, 0.0);\n        let still = integrate(at, Vec2::ZERO, 15.0, false, 1.0, 0.1, [target].into_iter());\n        assert_eq!(still, at);\n        let free = integrate(at, Vec2::new(0.0, 0.5), 15.0, false, 0.0, 0.1, [target].into_iter());\n        let helped = integrate(at, Vec2::new(0.0, 0.5), 15.0, false, 1.0, 0.1, [target].into_iter());\n        assert!(helped.x > 0.0 && free.x == 0.0, \"pulled toward the target\");\n        assert!(helped.y < free.y, \"slower near the target\");\n        let fine = integrate(at, Vec2::new(0.0, 1.0), 15.0, true, 0.0, 0.1, std::iter::empty());\n        let full = integrate(at, Vec2::new(0.0, 1.0), 15.0, false, 0.0, 0.1, std::iter::empty());\n        assert!((fine.y / full.y - 0.35).abs() < 1e-4);\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/mod.rs <<'EOF'\n//! The strains: each a state machine in code, its numbers in the case's data.\n\nmod dies_irae;\nmod introit;\nmod lacrimosa;\nmod libera;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::Surgery;\nuse super::content::StrainDef;\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::tune;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum StrainKind {\n    #[default]\n    Introit,\n    Lacrimosa,\n    DiesIrae,\n    Shocks,\n    Soloist,\n}\n\n/// A strain in play.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Strain {\n    pub kind: StrainKind,\n    pub wave: u32,\n    pub waves: u32,\n    pub speed: f32,\n    pub tough: f32,\n    pub beats: f32,\n    pub amen: bool,\n    pub count: u32,\n    pub rings: u32,\n    pub fever_rate: f32,\n    pub center: Vec2,\n    pub furnace: bool,\n    pub visible: bool,\n    /// Sub-state of the machine.\n    pub stage: u8,\n    pub kills: u32,\n    pub done: bool,\n    /// Beats since the stage or the last stroke.\n    pub beat_n: u32,\n    pub fever: Option<f32>,\n    pub ring: Option<f32>,\n    pub ring_beat: u32,\n    pub t: f32,\n    pub eye: u32,\n    pub burns_t: f32,\n}\n\nimpl Strain {\n    pub fn from_def(d: &StrainDef) -> Self {\n        Self {\n            kind: match d.kind.as_str() {\n                \"lacrimosa\" => StrainKind::Lacrimosa,\n                \"dies_irae\" => StrainKind::DiesIrae,\n                \"shocks\" => StrainKind::Shocks,\n                \"soloist\" => StrainKind::Soloist,\n                _ => StrainKind::Introit,\n            },\n            waves: d.waves.max(1),\n            speed: d.speed,\n            tough: d.tough,\n            beats: d.beats,\n            amen: d.amen,\n            count: d.count,\n            rings: d.rings,\n            fever_rate: d.fever,\n            center: Vec2::new(d.at[0], d.at[1]),\n            furnace: d.furnace,\n            visible: d.visible,\n            ..Default::default()\n        }\n    }\n}\n\nimpl Surgery {\n    /// How fast a strain runs this tick: its own number, the slider, the difficulty, the heart.\n    pub(in crate::games::surgery) fn strain_speed(&self, own: f32) -> f32 {\n        own * self.tune.get(tune::STRAIN_SPEED) * self.difficulty().strain * self.heart.strain_factor()\n    }\n\n    pub(super) fn strain_start(&mut self, def: &StrainDef, events: &mut Vec<SimEvent>) {\n        let mut st = Strain::from_def(def);\n        self.op.strain_tough = (def.tough * self.tune.get(tune::STRAIN_TOUGH)).max(0.05);\n        match st.kind {\n            StrainKind::Introit => self.introit_start(&mut st, events),\n            StrainKind::Lacrimosa => self.lacrimosa_start(&mut st, events),\n            StrainKind::DiesIrae => self.dies_irae_start(&mut st, events),\n            StrainKind::Shocks => st.t = 1.4,\n            StrainKind::Soloist => self.soloist_start(&mut st, events),\n        }\n        self.op.counters.bump(&format!(\"strain_{:?}\", st.kind));\n        self.op.strain = Some(st);\n    }\n\n    pub(super) fn strain_tick(&mut self, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        if !st.done {\n            match st.kind {\n                StrainKind::Introit => self.introit_tick(&mut st, dt, beat, events),\n                StrainKind::Lacrimosa => self.lacrimosa_tick(&mut st, dt, beat, events),\n                StrainKind::DiesIrae => self.dies_irae_tick(&mut st, dt, beat, events),\n                StrainKind::Shocks => self.shocks_tick(&mut st, dt, events),\n                StrainKind::Soloist => self.soloist_tick(&mut st, dt, beat, events),\n            }\n        }\n        self.op.strain = Some(st);\n    }\n\n    /// A strain's part was finished by a tool: the machine reacts.\n    pub(super) fn strain_killed(&mut self, h: &Hazard, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        match st.kind {\n            StrainKind::Introit => self.introit_killed(&mut st, h, events),\n            StrainKind::Lacrimosa => self.lacrimosa_killed(&mut st, h, events),\n            StrainKind::DiesIrae => self.dies_irae_killed(&mut st, h, events),\n            StrainKind::Soloist => self.soloist_killed(&mut st, h, events),\n            StrainKind::Shocks => {}\n        }\n        self.op.strain = Some(st);\n    }\n\n    /// Something timed out (a pull window, a stroke, an eye).\n    pub(super) fn hazard_expired(&mut self, id: u32, events: &mut Vec<SimEvent>) {\n        let Some(h) = self.hazard(id).cloned() else { return };\n        match h.kind {\n            HazardKind::Nodule if h.stage == 1 => {\n                // The shell grows back; it runs.\n                let hh = self.hazard_mut(id).unwrap();\n                hh.stage = 0;\n                hh.life = 0.0;\n                hh.count = 99;\n                self.callout(\"missed_pull\");\n            }\n            HazardKind::Incision => {\n                self.op.hazards.retain(|x| x.id != id);\n                for s in &mut self.surgeons {\n                    if s.engaged == id {\n                        s.engaged = 0;\n                    }\n                }\n                if let Some(p) = self.hazard(h.parent).cloned() {\n                    if p.kind == HazardKind::Eye {\n                        self.eye_missed(p.id, events);\n                        return;\n                    }\n                }\n                if h.tag == 7 {\n                    // A soloist stroke missed.\n                    self.hurt(3.0);\n                    if let Some(s) = self.op.strain.as_mut() {\n                        s.kills += 1;\n                    }\n                    self.surgeons.iter_mut().for_each(|s| s.chain = 0);\n                    self.cue_at(events, super::cue::TEAR, h.pos);\n                    self.op.counters.bump(\"stroke_missed\");\n                }\n            }\n            _ => {\n                self.op.hazards.retain(|x| x.id != id);\n            }\n        }\n    }\n\n    pub(super) fn tendril_pull(&mut self, slot: usize, id: u32, dt: f32, events: &mut Vec<SimEvent>) {\n        let cursor = self.surgeons[slot].cursor;\n        let diastole = self.heart.diastole();\n        let Some(h) = self.hazard(id) else { return };\n        let (len, from) = (h.len(), h.progress);\n        let (s_on, dist) = super::field::polyline_project(&h.pts, cursor, from, (from + 1.2).min(len));\n        if dist > 2.6 {\n            self.release(slot);\n            return;\n        }\n        let power = self.tune.get(super::tune::TOOL_POWER);\n        let forward = s_on > from + 0.02;\n        let pull_rate = 2.8 * power;\n        let h = self.hazard_mut(id).unwrap();\n        if diastole {\n            if forward {\n                h.progress = (from + pull_rate * dt).min(s_on);\n            }\n        } else if forward {\n            // Pulling against the pulse: it fights back.\n            h.progress = (from - 1.2 * dt).max(0.0);\n            h.t += dt;\n            if h.t > 0.25 {\n                h.t = 0.0;\n                h.err += 1.0;\n                self.hurt(1.2);\n                self.op.counters.bump(\"tendril_fought\");\n                let at = polyline_at_tip(self.hazard(id));\n                self.cue_at(events, super::cue::TEAR, at);\n                self.callout(\"diastole\");\n            }\n        }\n        let Some(h) = self.hazard(id) else { return };\n        if h.progress >= len - 0.1 {\n            let (err, pos) = (h.err, h.touch_point());\n            let strict = self.tune.get(tune::STRICT);\n            let rating = super::field::Rating::from_error(err, [0.5, 2.5, 6.0], strict);\n            self.surgeons[slot].engaged = 0;\n            self.cue_at(events, super::cue::POP, pos);\n            self.award(slot, rating, Tool::Forceps, pos, false, events);\n            let h = self.hazard(id).cloned().unwrap();\n            self.op.hazards.retain(|x| x.id != id);\n            self.op.counters.cleared(HazardKind::Tendril);\n            self.strain_killed(&h, events);\n        }\n    }\n\n    pub(super) fn eye_cut(&mut self, eye: u32, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        self.lacrimosa_eye_cut(&mut st, eye, events);\n        self.op.strain = Some(st);\n    }\n\n    fn eye_missed(&mut self, eye: u32, events: &mut Vec<SimEvent>) {\n        let Some(mut st) = self.op.strain.take() else { return };\n        self.lacrimosa_eye_missed(&mut st, eye, events);\n        self.op.strain = Some(st);\n    }\n\n    pub(super) fn finish_ember(&mut self, id: u32, _slot: usize, events: &mut Vec<SimEvent>) {\n        let Some(h) = self.hazard(id).cloned() else { return };\n        self.op.hazards.retain(|x| x.id != id);\n        self.op.counters.cleared(HazardKind::Ember);\n        self.strain_killed(&h, events);\n    }\n\n    pub(super) fn furnace_step(&mut self, i: usize, events: &mut Vec<SimEvent>) {\n        let id = self.op.hazards[i].id;\n        let (stage, pos, r) = (self.op.hazards[i].stage, self.op.hazards[i].pos, self.op.hazards[i].r);\n        self.op.counters.bump(&format!(\"furnace_{stage}\"));\n        let h = &mut self.op.hazards[i];\n        h.progress = 0.0;\n        h.heat = 0.0;\n        h.by = 0;\n        h.drag = Vec2::ZERO;\n        match stage {\n            0 => {\n                h.stage = 1;\n                let d = Vec2::new(1.0, 0.25).normalize() * (r + 0.6);\n                self.add_hazard(Hazard {\n                    kind: HazardKind::Incision,\n                    pts: vec![pos - d, pos + d],\n                    pos,\n                    parent: id,\n                    required: true,\n                    tag: 3,\n                    ..Default::default()\n                });\n            }\n            1 => h.stage = 2,\n            2 => h.stage = 3,\n            3 => h.stage = 4,\n            4 => {\n                h.stage = 5;\n                let d = Vec2::new(0.3, 1.0).normalize() * 1.2;\n                h.pts = vec![pos - d, pos + d];\n                h.last_s = 0.0;\n                h.count = 0;\n                h.err = 0.0;\n            }\n            _ => {\n                let h = self.op.hazards.remove(i);\n                self.op.counters.cleared(HazardKind::Furnace);\n                self.strain_killed(&h, events);\n            }\n        }\n    }\n}\n\nfn polyline_at_tip(h: Option<&Hazard>) -> Vec2 {\n    h.map(|h| h.touch_point()).unwrap_or_default()\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/introit.rs <<'EOF'\n//! Introit, 3/4. A violet nodule moves under the tissue, seen as a bump. Every three beats it\n//! steps somewhere new (a ripple telegraphs on beat two) and leaves a wound behind. Scanner lights\n//! it; Laser at rest pops the shell; Forceps pull it within two beats. The first kill splits it in\n//! two, then four small quick ones, then the Amen: merged, held by three tethers.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\n/// Beats between steps, by wave.\nfn step_beats(wave: u32) -> u8 {\n    if wave >= 2 { 2 } else { 3 }\n}\n\nimpl Surgery {\n    pub(super) fn introit_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 3;\n        self.spawn_nodules(st, 1, 0.62, 1.0, events);\n    }\n\n    fn spawn_nodules(&mut self, st: &mut Strain, n: u32, r: f32, heat: f32, events: &mut Vec<SimEvent>) {\n        self.op.grace_beats = 1.0;\n        for k in 0..n {\n            let at = self.field_spot(st.center, k);\n            self.add_hazard(Hazard {\n                kind: HazardKind::Nodule,\n                pos: at,\n                to: at,\n                r,\n                hidden: !st.visible,\n                required: true,\n                group: st.wave as u16,\n                err: heat,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, st.center);\n    }\n\n    /// A random spot on the plate, away from the HUD.\n    pub(in crate::games::surgery) fn field_spot(&mut self, center: Vec2, k: u32) -> Vec2 {\n        let a = self.rand() * std::f32::consts::TAU + k as f32 * 2.1;\n        let d = 1.0 + self.rand() * 3.0;\n        let p = center + Vec2::new(a.cos() * d * 1.6, a.sin() * d * 0.8);\n        Vec2::new(p.x.clamp(-8.0, 8.0), p.y.clamp(-3.6, 3.8))\n    }\n\n    pub(super) fn introit_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        // The Hush wakes under pressure.\n        if self.op.vitals < 35.0 {\n            self.wake_gift(events);\n        }\n        let speed = self.strain_speed(st.speed);\n        let wave = st.wave;\n        let step = step_beats(wave);\n        let mut stepped: Vec<(u32, Vec2)> = Vec::new();\n        let mut telegraphs = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Nodule) {\n            h.dev = (h.dev - dt * 1.5).max(0.0);\n            if h.t > 0.0 {\n                // Stepping: anticipation, then a quick slide.\n                h.t = (h.t - dt * speed * 2.2).max(0.0);\n                let k = 1.0 - h.t;\n                h.pos = h.pos.lerp(h.to, (k * k).clamp(0.0, 1.0) * 0.35);\n                if h.t <= 0.0 {\n                    h.pos = h.to;\n                }\n            }\n            if h.locked || h.stage != 0 || h.by != 0 || h.t > 0.0 {\n                if beat && h.stage == 1 {\n                    h.count = 0;\n                }\n                continue;\n            }\n            if beat {\n                h.count = h.count.saturating_add(1);\n                if h.count + 1 == step {\n                    h.dev = 1.0;\n                    telegraphs.push(h.pos);\n                }\n                if h.count >= step {\n                    h.count = 0;\n                    stepped.push((h.id, h.pos));\n                }\n            }\n        }\n        for at in telegraphs {\n            self.cue_at(events, cue::RIPPLE, at);\n            self.op.counters.bump(\"nodule_telegraph\");\n        }\n        for (id, from) in stepped {\n            let to = self.field_spot(st.center, id);\n            let leave_wound = self.rand() < 0.55;\n            if let Some(h) = self.hazard_mut(id) {\n                h.to = to;\n                h.t = 1.0;\n            }\n            self.op.counters.bump(\"nodule_step\");\n            // It leaves a wound or a pool behind.\n            let wounds = self.op.hazards.iter().filter(|h| matches!(h.kind, HazardKind::Laceration | HazardKind::Pool)).count();\n            if wounds < 7 {\n                if leave_wound {\n                    let d = Vec2::from_angle(self.rand() * 6.28) * 0.75;\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Laceration,\n                        pts: vec![from - d, from + d],\n                        pos: from,\n                        required: false,\n                        ..Default::default()\n                    });\n                } else {\n                    self.add_hazard(Hazard { kind: HazardKind::Pool, pos: from, r: 0.65, ..Default::default() });\n                }\n            }\n        }\n    }\n\n    pub(super) fn introit_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        if h.kind != HazardKind::Nodule {\n            return;\n        }\n        st.kills += 1;\n        self.op.counters.bump(&format!(\"introit_wave_{}\", st.wave));\n        let left = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Nodule).count();\n        if left > 0 {\n            return;\n        }\n        st.wave += 1;\n        if st.wave >= st.waves {\n            st.done = true;\n            self.cue_at(events, cue::STINGER, h.pos);\n            return;\n        }\n        match st.wave {\n            1 => {\n                // It splits in two: 60% heat each.\n                self.spawn_nodules(st, 2, 0.5, 0.6, events);\n                self.op.strain_tough = self.op.strain_tough.min(0.6 * self.op.strain_tough.max(1.0));\n                self.say(\"mara\", \"It split. Bashir, it split!\");\n            }\n            2 => {\n                self.spawn_nodules(st, 4, 0.36, 0.5, events);\n                self.op.strain_tough *= 0.8;\n                self.say(\"teddy\", \"Four. There are four. I'd like to speak to whoever's in charge of counting.\");\n                self.wake_gift(events);\n            }\n            _ => {\n                // The Amen.\n                let at = st.center;\n                self.op.strain_tough = (self.op.strain_tough * 1.6).max(1.0);\n                let big = self.add_hazard(Hazard {\n                    kind: HazardKind::Nodule,\n                    pos: at,\n                    to: at,\n                    r: 1.0,\n                    locked: true,\n                    required: true,\n                    group: 9,\n                    ..Default::default()\n                });\n                for k in 0..3 {\n                    let a = k as f32 * std::f32::consts::TAU / 3.0 + 0.5;\n                    let far = at + Vec2::new(a.cos() * 3.8, a.sin() * 2.1);\n                    let near = at + Vec2::new(a.cos() * 1.4, a.sin() * 0.9);\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Tether,\n                        pts: vec![far, far.lerp(near, 0.5) + Vec2::new(0.25, -0.2), near],\n                        pos: far.lerp(near, 0.5),\n                        parent: big,\n                        required: true,\n                        ..Default::default()\n                    });\n                }\n                self.say(\"bashir\", \"Three tethers. Cut them. Then the shell.\");\n                self.op.shake = 1.0;\n                self.cue_at(events, cue::STINGER, at);\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/lacrimosa.rs <<'EOF'\n//! Lacrimosa, 6/8. A crown with six teardrop sacs on stems. They swell and burst into caustic\n//! pools. Laser a stem to drop a sac whole, or Suction it slowly for a lower rating. A cleared wave\n//! opens the crown's eye: Scalpel across it, twice. Three waves, each faster; then tear out the eye\n//! with Forceps and Gel the bed.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\n/// Beats the eye holds open for each stroke.\nconst EYE_BEATS: f32 = 7.0;\n\nimpl Surgery {\n    pub(super) fn lacrimosa_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 6;\n        let at = st.center;\n        self.add_hazard(Hazard { kind: HazardKind::Crown, pos: at, r: 1.25, ..Default::default() });\n        st.eye = self.add_hazard(Hazard { kind: HazardKind::Eye, pos: at, r: 0.75, required: true, ..Default::default() });\n        self.spawn_sacs(st, st.count, events);\n    }\n\n    fn spawn_sacs(&mut self, st: &mut Strain, n: u32, events: &mut Vec<SimEvent>) {\n        let at = st.center;\n        for k in 0..n {\n            let a = k as f32 * std::f32::consts::TAU / n as f32 + st.wave as f32 * 0.4 + 0.3;\n            let dir = Vec2::new(a.cos() * 1.5, a.sin());\n            let stem = at + dir * 1.15;\n            let sac = at + dir * 2.5;\n            let lag = self.rand() * 0.25;\n            self.add_hazard(Hazard {\n                kind: HazardKind::Sac,\n                pos: sac,\n                to: stem,\n                r: 0.3,\n                progress: lag,\n                axis: a,\n                required: true,\n                group: st.wave as u16,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, at);\n    }\n\n    pub(super) fn lacrimosa_tick(&mut self, st: &mut Strain, dt: f32, _beat: bool, events: &mut Vec<SimEvent>) {\n        // Each wave swells faster.\n        let speed = self.strain_speed(st.speed) * (1.0 + st.wave as f32 * 0.22);\n        let swell = dt * speed / (st.beats * 60.0 / 72.0);\n        let mut burst = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Sac) {\n            h.progress += swell;\n            h.r = 0.3 + h.progress.min(1.0) * 0.42;\n            h.t += dt;\n            if h.progress >= 1.0 {\n                burst.push(h.id);\n            }\n        }\n        for id in burst {\n            let Some(h) = self.hazard(id).cloned() else { continue };\n            self.op.hazards.retain(|x| x.id != id);\n            for s in &mut self.surgeons {\n                if s.engaged == id {\n                    s.engaged = 0;\n                }\n            }\n            self.add_hazard(Hazard { kind: HazardKind::Pool, pos: h.pos, r: 1.15, drain: 1.0, tag: 1, ..Default::default() });\n            self.add_hazard(Hazard { kind: HazardKind::Burn, pos: h.pos, r: 0.65, required: false, ..Default::default() });\n            self.cue_at(events, cue::BURST, h.pos);\n            self.op.counters.bump(\"sac_burst\");\n            self.op.shake = self.op.shake.max(0.6);\n            self.callout(\"burst\");\n            self.lacrimosa_killed(st, &h, events);\n        }\n    }\n\n    pub(super) fn lacrimosa_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        match h.kind {\n            HazardKind::Sac => {\n                st.kills += 1;\n                let left = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Sac).count();\n                if left == 0 {\n                    self.open_eye(st, events);\n                }\n            }\n            HazardKind::Eye => {\n                // Torn out and gelled: it's over.\n                st.done = true;\n                self.op.hazards.retain(|x| x.kind != HazardKind::Crown);\n                self.cue_at(events, cue::STINGER, h.pos);\n                self.op.counters.bump(\"eye_torn_out\");\n            }\n            _ => {}\n        }\n    }\n\n    fn open_eye(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        let eye = st.eye;\n        if let Some(h) = self.hazard_mut(eye) {\n            h.stage = 1;\n            h.count = 0;\n        }\n        self.op.counters.bump(\"eye_opened\");\n        self.cue_at(events, cue::RIPPLE, st.center);\n        self.callout(\"eye_open\");\n        self.spawn_eye_stroke(st);\n    }\n\n    fn spawn_eye_stroke(&mut self, st: &mut Strain) {\n        let eye = st.eye;\n        let n = self.hazard(eye).map(|h| h.count).unwrap_or(0);\n        let a = 0.6 + n as f32 * 1.4 + st.wave as f32;\n        let d = Vec2::new(a.cos() * 1.5, a.sin()) * 1.15;\n        let life = self.heart.period() * EYE_BEATS / self.difficulty().strain;\n        self.add_hazard(Hazard {\n            kind: HazardKind::Incision,\n            pts: vec![st.center - d, st.center + d],\n            pos: st.center,\n            parent: eye,\n            life,\n            required: true,\n            ..Default::default()\n        });\n    }\n\n    pub(super) fn lacrimosa_eye_cut(&mut self, st: &mut Strain, eye: u32, events: &mut Vec<SimEvent>) {\n        let n = {\n            let Some(h) = self.hazard_mut(eye) else { return };\n            h.count += 1;\n            h.count\n        };\n        self.op.counters.bump(\"eye_cut\");\n        if n < 2 {\n            self.spawn_eye_stroke(st);\n            return;\n        }\n        st.wave += 1;\n        if let Some(h) = self.hazard_mut(eye) {\n            h.count = 0;\n            h.stage = 0;\n        }\n        if st.wave >= st.waves {\n            if let Some(h) = self.hazard_mut(eye) {\n                h.stage = 2;\n                h.axis = -std::f32::consts::FRAC_PI_2;\n            }\n            self.say(\"bashir\", \"Forceps. Take the eye. All of it.\");\n            return;\n        }\n        self.op.shake = 0.7;\n        let count = st.count;\n        self.spawn_sacs(st, count, events);\n    }\n\n    pub(super) fn lacrimosa_eye_missed(&mut self, st: &mut Strain, eye: u32, events: &mut Vec<SimEvent>) {\n        // It closes, and weeps again.\n        if let Some(h) = self.hazard_mut(eye) {\n            h.stage = 0;\n            h.count = 0;\n        }\n        self.op.counters.bump(\"eye_missed\");\n        self.say(\"bashir\", \"It closed. Here they come again.\");\n        let n = (st.count / 2).max(2);\n        self.spawn_sacs(st, n, events);\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/dies_irae.rs <<'EOF'\n//! Dies Irae, 5/4. A Fever meter fills. Embers heat the tissue, and on every fifth beat a heat ring\n//! sweeps the field: a held trigger scorches. Cryoprobe an ember, Scalpel to crack it, Forceps the\n//! three pieces out; each removal cools the Fever. Midway two embers merge and roam. Last, an\n//! incision reveals the furnace beneath: all tools in sequence.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\nuse crate::input::hands;\n\nimpl Surgery {\n    pub(super) fn dies_irae_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = if st.rings == 7 { 7 } else { 5 };\n        if st.fever_rate > 0.0 {\n            st.fever = Some(self.op.fever_start);\n        }\n        let n = st.count;\n        for k in 0..n {\n            let a = k as f32 * std::f32::consts::TAU / n as f32 - 1.2;\n            let at = st.center + Vec2::new(a.cos() * 4.6, a.sin() * 2.5);\n            self.add_hazard(Hazard {\n                kind: HazardKind::Ember,\n                pos: at,\n                to: at,\n                r: 0.6,\n                required: true,\n                ..Default::default()\n            });\n        }\n        self.cue_at(events, cue::STINGER, st.center);\n    }\n\n    pub(super) fn dies_irae_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let speed = self.strain_speed(st.speed);\n        if let Some(f) = st.fever.as_mut() {\n            *f += st.fever_rate * dt * speed;\n            if *f > 100.0 {\n                let burn = 6.0 * dt * self.difficulty().drain;\n                *f = f.min(130.0);\n                self.hurt(burn);\n                self.op.counters.bump(\"fever_over\");\n            }\n        }\n        // The rings: a count-in, then a sweep.\n        if st.rings > 0 && st.ring.is_none() && beat {\n            st.ring_beat += 1;\n            let left = st.rings.saturating_sub(st.ring_beat);\n            if left == 2 || left == 1 {\n                self.cue_at(events, cue::TICK, Vec2::ZERO);\n                if left == 1 {\n                    self.say_short(\"lift_off\");\n                }\n            }\n            if left == 0 {\n                st.ring_beat = 0;\n                st.ring = Some(0.0);\n                self.cue_at(events, cue::RING, st.center);\n                self.op.counters.bump(\"ring_sweep\");\n            }\n        }\n        if let Some(r) = st.ring {\n            let next = r + dt * 15.0 * speed.max(0.6);\n            let center = st.center;\n            let crossing: Vec<usize> = (0..4)\n                .filter(|&i| {\n                    let s = &self.surgeons[i];\n                    let d = s.cursor.distance(center);\n                    s.present && !s.bot && s.using && self.last_held[i] & hands::USE != 0 && d >= r && d < next\n                })\n                .collect();\n            for slot in crossing {\n                let at = self.surgeons[slot].cursor;\n                self.add_hazard(Hazard { kind: HazardKind::Burn, pos: at, r: 0.75, required: false, ..Default::default() });\n                self.surgeons[slot].chain = 0;\n                self.mistake(slot);\n                self.hurt(2.5);\n                self.cue_at(events, cue::SCORCH, at);\n                self.op.counters.bump(\"ring_scorch\");\n                self.callout(\"scorched\");\n            }\n            st.ring = (next < 14.0).then_some(next);\n        }\n        // Embers heat the tissue, and the roaming one wanders.\n        st.burns_t += dt;\n        if st.burns_t > 14.0 {\n            st.burns_t = 0.0;\n            let burns = self.op.hazards.iter().filter(|h| h.kind == HazardKind::Burn).count();\n            let ember = self.op.hazards.iter().find(|h| h.kind == HazardKind::Ember && h.stage == 0).map(|h| h.pos);\n            if let (true, Some(at)) = (burns < 4, ember) {\n                let d = Vec2::from_angle(self.rand() * 6.28) * 1.1;\n                self.add_hazard(Hazard { kind: HazardKind::Burn, pos: at + d, r: 0.55, required: false, ..Default::default() });\n            }\n        }\n        let mut retarget = Vec::new();\n        for h in self.op.hazards.iter_mut().filter(|h| h.kind == HazardKind::Ember && h.tag == 8 && h.stage == 0 && h.by == 0) {\n            let step = 0.7 * dt * speed;\n            let d = h.to - h.pos;\n            if d.length() < 0.2 {\n                retarget.push(h.id);\n            } else {\n                h.pos += d.normalize() * step;\n            }\n        }\n        for id in retarget {\n            let to = self.field_spot(st.center, id);\n            if let Some(h) = self.hazard_mut(id) {\n                h.to = to;\n            }\n        }\n        // The furnace: when the opening incision is done.\n        if st.stage == 1 && self.op.incisions_done >= 1 {\n            st.stage = 2;\n            self.op.incisions_done = 0;\n            let at = st.center;\n            self.set_plate(\"furnace\", at);\n            self.add_hazard(Hazard { kind: HazardKind::Furnace, pos: at, r: 1.7, required: true, ..Default::default() });\n            self.op.shake = 1.0;\n            self.op.push = 1.0;\n            self.op.push_at = at;\n            self.say(\"pet\", \"There you are. Every instrument, young man. In order. Cold, cut, lift, burn, soothe, close.\");\n            self.cue_at(events, cue::STINGER, at);\n            self.op.counters.bump(\"furnace_revealed\");\n        }\n    }\n\n    pub(super) fn dies_irae_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        match h.kind {\n            HazardKind::Ember => {\n                st.kills += 1;\n                if let Some(f) = st.fever.as_mut() {\n                    *f = (*f - 22.0).max(0.0);\n                }\n                self.op.counters.bump(\"ember_out\");\n                let embers = self.op.hazards.iter().filter(|x| x.kind == HazardKind::Ember).count();\n                // Midway: the next two left merge and roam.\n                if st.kills == 2 && st.count >= 4 && !self.op.embers_merged {\n                    self.op.embers_merged = true;\n                    let two: Vec<u32> =\n                        self.op.hazards.iter().filter(|x| x.kind == HazardKind::Ember && x.stage == 0).take(2).map(|x| x.id).collect();\n                    if two.len() == 2 {\n                        let (a, b) = (self.hazard(two[0]).unwrap().pos, self.hazard(two[1]).unwrap().pos);\n                        self.op.hazards.retain(|x| x.id != two[1]);\n                        let to = self.field_spot(st.center, 4);\n                        let m = self.hazard_mut(two[0]).unwrap();\n                        m.pos = a.lerp(b, 0.5);\n                        m.to = to;\n                        m.r = 0.9;\n                        m.tag = 8;\n                        self.op.counters.bump(\"embers_merged\");\n                        self.say(\"pet\", \"Two became one and it has learned to walk. Lovely. Keep your hands up.\");\n                        self.cue_at(events, cue::STINGER, h.pos);\n                    }\n                }\n                if embers == 0 && st.stage == 0 {\n                    if st.furnace {\n                        st.stage = 1;\n                        self.op.incisions_done = 0;\n                        let c = st.center;\n                        self.add_hazard(Hazard {\n                            kind: HazardKind::Incision,\n                            pts: vec![c + Vec2::new(-3.2, 0.5), c + Vec2::new(-1.0, -0.2), c + Vec2::new(1.2, 0.2), c + Vec2::new(3.2, -0.4)],\n                            pos: c,\n                            required: true,\n                            ..Default::default()\n                        });\n                        self.say(\"pet\", \"It's not the embers. It's what they were feeding. Open her up.\");\n                    } else {\n                        st.done = true;\n                    }\n                }\n            }\n            HazardKind::Furnace => {\n                st.done = true;\n                st.fever = st.fever.map(|f| f.min(10.0));\n                self.op.counters.bump(\"furnace_out\");\n                self.cue_at(events, cue::STINGER, h.pos);\n            }\n            _ => {}\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/strain/libera.rs <<'EOF'\n//! Libera Me's own acts. The strain stops the heart on purpose: three shocks, each on a ghost beat.\n//! Then the Soloist surfaces: Scalpel strokes on the beat, nearly a rhythm game, and a long tendril\n//! pulled only in diastole, a tug-of-war with the pulse.\n\nuse glam::Vec2;\n\nuse super::Strain;\nuse crate::frame::SimEvent;\nuse crate::games::surgery::Surgery;\nuse crate::games::surgery::cue;\nuse crate::games::surgery::field::{Hazard, HazardKind};\n\nimpl Surgery {\n    pub(super) fn shocks_tick(&mut self, st: &mut Strain, dt: f32, _events: &mut Vec<SimEvent>) {\n        match st.stage {\n            0 => {\n                st.t -= dt;\n                if st.t <= 0.0 {\n                    st.stage = 1;\n                    self.start_code(true, st.count.min(9) as u8);\n                }\n            }\n            _ => st.done = true,\n        }\n    }\n\n    pub(super) fn soloist_start(&mut self, st: &mut Strain, events: &mut Vec<SimEvent>) {\n        self.heart.meter = 4;\n        st.stage = 0;\n        st.kills = 0;\n        self.op.shake = 1.0;\n        self.cue_at(events, cue::STINGER, st.center);\n        self.op.counters.bump(\"soloist\");\n    }\n\n    pub(super) fn soloist_tick(&mut self, st: &mut Strain, dt: f32, beat: bool, events: &mut Vec<SimEvent>) {\n        let _ = dt;\n        match st.stage {\n            0 => {\n                // Strokes appear on the beat: every other beat.\n                if beat {\n                    st.beat_n += 1;\n                }\n                if beat && st.beat_n % 2 == 1 && st.wave < st.count {\n                    let k = st.wave;\n                    st.wave += 1;\n                    let a = k as f32 * 2.399;\n                    let at = st.center + Vec2::new(a.cos() * 4.8, a.sin() * 2.4) * (0.4 + 0.6 * ((k % 3) as f32 / 2.0));\n                    let dir = Vec2::from_angle(a + 1.2);\n                    let life = self.heart.period() * st.beats / self.difficulty().strain;\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Incision,\n                        pts: vec![at - dir * 1.1, at + dir * 1.1],\n                        pos: at,\n                        life,\n                        tag: 7,\n                        required: false,\n                        ..Default::default()\n                    });\n                    self.cue_at(events, cue::TICK, at);\n                }\n                if st.wave >= st.count && !self.op.hazards.iter().any(|h| h.kind == HazardKind::Incision && h.tag == 7) {\n                    st.stage = 1;\n                    let c = st.center;\n                    let mut pts = Vec::new();\n                    for i in 0..=14 {\n                        let t = i as f32 / 14.0;\n                        pts.push(\n                            c + Vec2::new(-6.2 + t * 12.4, (t * 9.0).sin() * 1.8 + (t - 0.5) * 2.5),\n                        );\n                    }\n                    self.add_hazard(Hazard {\n                        kind: HazardKind::Tendril,\n                        pos: c,\n                        pts,\n                        required: true,\n                        ..Default::default()\n                    });\n                    self.say(\"pet\", \"There's its spine. Forceps. Pull when the heart lets you and not one moment before.\");\n                    self.op.shake = 1.0;\n                    self.cue_at(events, cue::STINGER, c);\n                    self.op.counters.bump(\"tendril\");\n                }\n            }\n            _ => {}\n        }\n    }\n\n    pub(super) fn soloist_killed(&mut self, st: &mut Strain, h: &Hazard, events: &mut Vec<SimEvent>) {\n        if h.kind == HazardKind::Tendril {\n            st.done = true;\n            self.cue_at(events, cue::STINGER, h.pos);\n            self.op.counters.bump(\"tendril_out\");\n        }\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/content.rs'\ns=open(p).read()\ns=s.replace('''    /// The furnace beneath, at the end of Dies Irae.\n    #[serde(default)]\n    pub furnace: bool,\n}''','''    /// The furnace beneath, at the end of Dies Irae.\n    #[serde(default)]\n    pub furnace: bool,\n    /// Nodules stay visible (Case 7): no Scanner needed.\n    #[serde(default)]\n    pub visible: bool,\n}''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/field.rs'\ns=open(p).read()\ns=s.replace('''                HazardKind::Pool => 0.2 * h.r * h.r,\n                _ => h.drain,''','''                HazardKind::Pool => 0.2 * h.r * h.r + h.drain,\n                _ => h.drain,''')\ns=s.replace('''        h.id = self.op.next_id;\n        self.op.next_id += 1;\n        h.drain = match h.kind {''','''        h.id = self.op.next_id;\n        self.op.next_id += 1;\n        let caustic = h.drain;\n        h.drain = match h.kind {\n            HazardKind::Pool => caustic,''')\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write the frame, cursor helpers and all strain state machines"}}}
