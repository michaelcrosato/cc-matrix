0, 0.25, 3.5]\n214-yaw = 0\n215:look = { shirt = \"#e0a040\", pants = \"#2a2a3a\", skin = \"#d8a07a\" }\n216-\n217-[[npc]]\n218-name = \"cast_knight\"\n219-pos = [7.0, 0.25, 3.5]\n220-yaw = 0\n221-look = { figure = \"LIB/kaykit_adventurers/knight\" }\n{\"foundations\":{\"barrel\":[\"barrel 60x91x60 bands=iron/brass :brass\",\"cask 64x73x64 girth=18-48 height=40-120 :keg :tun\",\"tap_barrel 97x70x60 size=0.6-1.2 :hogshead :keg\",\"wash_tub 63x52x63 diameter=40-96 fill=water/empty :dry :small :wide\"],\"bed\":[\"cot 190x54x77 style=cot/bedroll/bed :bed :bedroll :cot\"],\"container\":[\"bucket 34x39x31 fill=water/empty height=20-45 style=wood/iron :pail :tall\",\"trough 180x54x64 fill=water/hay/empty length=100-240 material=wood/stone :feed :short :stone\",\"cooking_pot 34x42x30 fill=stew/empty hang=stand/hang size=25-70 :kettle :large\"],\"crate\":[\"crate_stack 122x167x122 stack=seed/no/yes :single\",\"chest 88x66x55 lid=closed/open width=50-160 :coffer :open\",\"slat_crate 56x31x38 fill=apples/oranges/cabbages/empty :empty :oranges\",\"basket 44x43x44 diameter=28-70 goods=apples/none :empty :large :small\"],\"fire\":[\"brazier 70x107x72\",\"campfire 89x52x93 fire=lit/embers ring=25-70 :embers :pit\",\"hearth 176x180x90 fire=lit/cold form=hearth/oven/forge :cold :forge :oven\"],\"gate\":[\"gate 130x222x20 bars=planks/iron/rails frame=lintel/torii/posts width=112-300 :barred :farm :shrine\"],\"light\":[\"candle_cluster 32x26x32 candles=1-8 tall=8-40 :altar :pair\",\"wall_torch 14x61x29 @wall_mount fire=lit/out reach=8-40 :long :out\",\"lamp_post 36x188x36 height=150-260 style=iron/stone/bracket :stone_lantern :wall\",\"hand_lantern 14x31x14 mount=stand/hang style=lantern/mine :hanging :mine\"],\"seat\":[\"chair 44x96x45 @sit back=slat/none/high :high_back :stool\",\"bench 180x45x40 @s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Gi5sgYU7wBhXEMkwZgmTcv","permission_decision":{"decision":"accept","source":