{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjtLV3BwxLbVBdM8cpG7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01278KxMrxpoSUgi6Q2AB2Sc","name":"Bash","input":{"command":"cat > crates/pav_core/src/games/surgery/mod.rs <<'EOF'\n//! The surgery game: a surgeon's-eye arcade of eight instruments, framed by a paper-theatre\n//! melodrama. Cases and story live in one phase machine, so `surgery/campaign` with the bot is the\n//! scripted playthrough of the whole game. `content/README.md` is the designer's guide.\n\npub mod bot;\npub mod content;\npub mod cue;\npub mod director;\npub mod field;\npub mod frame;\npub mod heart;\npub mod net;\npub mod paper;\npub mod story;\npub mod strain;\npub mod surgeon;\npub mod tune;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::content::{CODE_BLUE, CaseDef};\nuse self::field::{Counters, GhostHand, Hazard, Popup, Stain, Surgeon, Tool};\nuse self::frame::*;\nuse self::heart::Heart;\nuse self::story::StoryState;\nuse self::strain::Strain;\nuse self::tune::Tune;\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, SurgeryCmd, hands};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\n/// The run this scene plays.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Campaign,\n    Case,\n    CodeBlue,\n    Attract,\n    Card,\n    Mirror,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Cheats {\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub time_scale: f32,\n    pub overlays: u32,\n}\n\n/// The gifts in effect.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Gifts {\n    /// Heartbeats of the Hush left.\n    pub hush_beats: f32,\n    /// Seconds of the Echo left.\n    pub echo_t: f32,\n    pub hush_fx: f32,\n    pub echo_fx: f32,\n    /// Lines the Echo says once.\n    pub echo_said: bool,\n    pub duet: bool,\n}\n\n/// A heart stopped, and the seconds to do something about it.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CodeState {\n    pub left: f32,\n    pub window: f32,\n    pub ghost: f32,\n    pub shocks: u8,\n    pub scripted: bool,\n    pub flash: f32,\n}\n\n/// Everything about the operation in progress: one clone of this is a checkpoint.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Op {\n    pub case: u8,\n    pub phase: u8,\n    pub phase_t: f32,\n    pub phase_beats: u32,\n    /// Bits of the phase's events that have fired.\n    pub fired: u64,\n    pub clock: f32,\n    pub vitals: f32,\n    pub vitals_max: f32,\n    pub timer: f32,\n    pub timer_total: f32,\n    pub hazards: Vec<Hazard>,\n    pub next_id: u32,\n    pub stains: Vec<Stain>,\n    pub popups: Vec<Popup>,\n    pub pings: Vec<(Vec2, f32)>,\n    pub ghosts: Vec<GhostHand>,\n    pub ring: [Tool; 8],\n    pub forced_tool: Option<Tool>,\n    pub counters: Counters,\n    pub mistakes: u32,\n    pub incisions_done: u32,\n    pub strain: Option<Strain>,\n    pub strain_tough: f32,\n    pub grace_beats: f32,\n    pub fever_start: f32,\n    pub embers_merged: bool,\n    pub drain_now: f32,\n    pub drain_scale: f32,\n    pub overdose: f32,\n    pub since_callout: f32,\n    pub gift_awake: bool,\n    pub shake: f32,\n    pub push: f32,\n    pub push_at: Vec2,\n    pub plate: Arc<str>,\n    pub prev_plate: Option<Arc<str>>,\n    pub plate_blend: f32,\n    pub plate_from: Vec2,\n    pub objective: Arc<str>,\n    pub subtitle: Option<Subtitle>,\n    pub subtitle_serial: u32,\n    pub banner: Option<(Arc<str>, f32)>,\n    pub codes_left: u8,\n    pub code: Option<CodeState>,\n    pub critical: bool,\n    pub said_forty: bool,\n    pub director: Option<director::Director>,\n    pub guided: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Checkpoint {\n    pub op: Op,\n    pub surgeons: [Surgeon; 4],\n    pub heart: Heart,\n    pub gifts: Gifts,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub tick: u64,\n    pub outcome: Outcome,\n    pub tune: Tune,\n    pub diff: u8,\n    pub cheats: Cheats,\n    pub heart: Heart,\n    pub gifts: Gifts,\n    pub op: Op,\n    pub checkpoint: Option<Box<Checkpoint>>,\n    pub start_case_cp: Option<Box<Checkpoint>>,\n    pub surgeons: [Surgeon; 4],\n    /// Slots a person is at.\n    pub humans: [bool; 4],\n    pub last_held: [u8; 4],\n    pub story: StoryState,\n    pub results: Option<ResultsView>,\n    pub death: Option<DeathView>,\n    /// The bot's skill, 0..1 (`Game::bot`, the partner, attract).\n    pub bot_skill: f32,\n    pub seed: u32,\n    pub text_cps: f32,\n    pub tremor_setting: bool,\n    pub coverage: Counters,\n    pub attract_seg: u8,\n    pub attract_t: f32,\n    /// The whole run's score and cases won, for tests.\n    pub run_score: i32,\n    pub cases_won: u32,\n    pub shot: CameraShot,\n    /// A client's frame, from the host.\n    #[serde(skip)]\n    pub mirror_frame: Option<Arc<SurgeryFrame>>,\n}\n\n/// A mirror's or tools' starting point.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let content = content::get();\n    let def = RoomDef::parse(&content.level).map_err(|e| anyhow!(\"content/level.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, Surgery::KEY, def);\n    // No hero here: the surgeons are slots. The camera is the game's.\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n    }\n    sim.state.focus = glam::Vec3::new(0.0, 0.0, 0.2);\n    let seed = (sim.state.rng.below(1 << 30) as u32) | 1;\n    let mut g = Surgery::new(seed);\n    let rest = rest.unwrap_or(\"campaign\");\n    let (first, arg) = rest.split_once('/').unwrap_or((rest, \"\"));\n    let mut sink = Vec::new();\n    match first {\n        \"title\" => g.begin_title(),\n        \"campaign\" => {\n            g.mode = Mode::Campaign;\n            let from: u8 = arg.parse().unwrap_or(0);\n            g.begin_campaign_case(from, &mut sink);\n        }\n        \"case\" => {\n            g.mode = Mode::Case;\n            let n: u8 = arg.parse().map_err(|_| anyhow!(\"surgery/case/<n>: n is a case number, got '{arg}'\"))?;\n            if content.case(n).is_none() {\n                return Err(anyhow!(\"no case {n}: there are {} cases\", content.cases.len()));\n            }\n            g.begin_case(n);\n        }\n        \"codeblue\" => {\n            g.mode = Mode::CodeBlue;\n            g.begin_case(CODE_BLUE);\n        }\n        \"attract\" => {\n            g.mode = Mode::Attract;\n            g.attract_next(&mut sink);\n        }\n        \"card\" => {\n            g.mode = Mode::Card;\n            g.begin_title();\n            g.mode = Mode::Card;\n            g.stage = Stage::Card;\n            g.op.plate = \"torso\".into();\n        }\n        \"mirror\" => {\n            g.mode = Mode::Mirror;\n            g.begin_title();\n            g.mode = Mode::Mirror;\n            g.op.plate = \"torso\".into();\n        }\n        o => return Err(anyhow!(\"unknown surgery scene '{o}' (campaign, case/<n>, codeblue, attract, title, card, mirror)\")),\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl Surgery {\n    pub fn new(seed: u32) -> Self {\n        let mut surgeons: [Surgeon; 4] = Default::default();\n        surgeons[0].present = true;\n        for s in &mut surgeons {\n            s.flow = 1.0;\n        }\n        Self {\n            mode: Mode::Title,\n            stage: Stage::Title,\n            stage_t: 0.0,\n            tick: 0,\n            outcome: Outcome::Playing,\n            tune: Tune::default(),\n            diff: 1,\n            cheats: Cheats { time_scale: 1.0, ..Default::default() },\n            heart: Heart::default(),\n            gifts: Gifts::default(),\n            op: Op::default(),\n            checkpoint: None,\n            start_case_cp: None,\n            surgeons,\n            humans: [true, false, false, false],\n            last_held: [0; 4],\n            story: StoryState::default(),\n            results: None,\n            death: None,\n            bot_skill: 1.0,\n            seed,\n            text_cps: 45.0,\n            tremor_setting: true,\n            coverage: Counters::default(),\n            attract_seg: 0,\n            attract_t: 0.0,\n            run_score: 0,\n            cases_won: 0,\n            shot: CameraShot::FIELD,\n            mirror_frame: None,\n        }\n    }\n\n    /// A number in 0..1 from the game's own seeded stream.\n    pub fn rand(&mut self) -> f32 {\n        let mut x = self.seed;\n        x ^= x << 13;\n        x ^= x >> 17;\n        x ^= x << 5;\n        self.seed = x;\n        (x >> 8) as f32 / (1u32 << 24) as f32\n    }\n\n    pub fn difficulty(&self) -> tune::Difficulty {\n        tune::DIFFICULTIES[(self.diff as usize).min(2)]\n    }\n\n    pub fn case_def(&self) -> Option<CaseDef> {\n        content::get().case(self.op.case).cloned()\n    }\n\n    pub fn begin_title(&mut self) {\n        self.mode = Mode::Title;\n        self.stage = Stage::Title;\n        self.op = Op { plate: \"heart\".into(), vitals: 100.0, vitals_max: 100.0, drain_scale: 1.0, ..Default::default() };\n        self.shot = CameraShot::FIELD;\n    }\n\n    fn set_stage(&mut self, s: Stage) {\n        self.stage = s;\n        self.stage_t = 0.0;\n    }\n\n    /// Clears the table and reads the case in. The chart comes next.\n    pub fn begin_case(&mut self, n: u8) {\n        let content = content::get();\n        let Some(case) = content.case(n) else { return };\n        let ring = {\n            let mut r = [Tool::Scalpel; 8];\n            for (i, t) in case.ring.iter().enumerate().take(8) {\n                r[i] = Tool::parse(t).unwrap_or(Tool::Scalpel);\n            }\n            r\n        };\n        let d = self.difficulty();\n        let total = case.timer * d.timer * self.tune.get(tune::TIMER);\n        self.op = Op {\n            case: n,\n            vitals: case.vitals,\n            vitals_max: case.vitals.max(100.0),\n            timer: total,\n            timer_total: total,\n            ring,\n            plate: case.plate.as_str().into(),\n            plate_blend: 1.0,\n            drain_scale: 1.0,\n            strain_tough: self.tune.get(tune::STRAIN_TOUGH),\n            grace_beats: 1.0,\n            gift_awake: case.gift,\n            codes_left: d.codes,\n            next_id: 1,\n            guided: case.guided,\n            fever_start: 20.0,\n            ..Default::default()\n        };\n        let default_tool = ring[1];\n        let both = case.surgeon == \"both\";\n        for i in 0..4 {\n            let s = &mut self.surgeons[i];\n            let (present, bot, cursor) = (s.present, s.bot, s.raw);\n            *s = Surgeon { present, bot, cursor, raw: cursor, tool: default_tool, flow: 1.0, ..Default::default() };\n            s.gift = if self.cheats.full_gift { 100.0 } else { 0.0 };\n        }\n        if self.mode != Mode::Attract {\n            for i in 0..4 {\n                self.surgeons[i].bot = false;\n                self.surgeons[i].present = self.humans[i];\n            }\n            if both && !self.humans[1] {\n                self.surgeons[1].bot = true;\n                self.surgeons[1].present = true;\n            }\n        }\n        self.heart = Heart::default();\n        self.gifts = Gifts::default();\n        self.checkpoint = None;\n        self.start_case_cp = None;\n        self.results = None;\n        self.death = None;\n        self.outcome = Outcome::Playing;\n        self.shot = CameraShot::FIELD;\n        self.set_stage(Stage::Chart);\n    }\n\n    /// A campaign case: its story first.\n    pub fn begin_campaign_case(&mut self, n: u8, events: &mut Vec<SimEvent>) {\n        self.begin_case(n);\n        let before = content::get().case(n).map(|c| c.before.clone()).unwrap_or_default();\n        if !before.is_empty() {\n            self.begin_story(&before, events);\n        }\n    }\n\n    /// Spawns the case's first phase behind the banner.\n    fn start_operation(&mut self, events: &mut Vec<SimEvent>) {\n        self.set_stage(Stage::OpStart);\n        self.op.banner = Some((\"OPERATION START\".into(), 0.0));\n        self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        self.begin_phase(0, events);\n        self.start_case_cp = Some(Box::new(self.snapshot()));\n    }\n\n    fn snapshot(&self) -> Checkpoint {\n        Checkpoint { op: self.op.clone(), surgeons: self.surgeons.clone(), heart: self.heart.clone(), gifts: self.gifts.clone() }\n    }\n\n    fn restore(&mut self, cp: &Checkpoint) {\n        let counters = std::mem::take(&mut self.op.counters);\n        self.op = cp.op.clone();\n        self.op.counters = counters;\n        self.surgeons = cp.surgeons.clone();\n        self.heart = cp.heart.clone();\n        self.gifts = cp.gifts.clone();\n    }\n\n    /// Who speaks in this operation when \"nurse\" is called for: Bashir, unless he is the patient.\n    fn nurse(&self) -> &'static str {\n        if self.op.case == 7 { \"teddy\" } else { \"bashir\" }\n    }\n\n    /// An in-op line.\n    pub fn say(&mut self, who: &str, text: &str) {\n        let who = if who == \"nurse\" { self.nurse() } else { who };\n        self.op.subtitle_serial += 1;\n        self.op.subtitle = Some(Subtitle { who: who.into(), text: text.into(), age: 0.0, serial: self.op.subtitle_serial });\n        self.op.since_callout = 0.0;\n    }\n\n    /// A callout from the data, if the last line has had its time.\n    pub fn callout(&mut self, key: &str) {\n        let urgent = matches!(key, \"wrong_tool\" | \"healthy\" | \"lift_off\" | \"vitals_forty\" | \"code\");\n        if !urgent && self.op.since_callout < 2.5 {\n            return;\n        }\n        self.say_short(key);\n    }\n\n    /// A callout from the data, now.\n    pub fn say_short(&mut self, key: &str) {\n        let content = content::get();\n        let Some(lines) = content.callouts.get(key) else { return };\n        if lines.lines.is_empty() {\n            return;\n        }\n        let i = (self.rand() * lines.lines.len() as f32) as usize % lines.lines.len();\n        let (who, text) = (lines.lines[i][0].clone(), lines.lines[i][1].clone());\n        self.say(&who, &text);\n    }\n\n    pub fn set_plate(&mut self, name: &str, from: Vec2) {\n        self.op.prev_plate = Some(self.op.plate.clone());\n        self.op.plate = name.into();\n        self.op.plate_blend = 0.0;\n        self.op.plate_from = from;\n        self.op.counters.bump(&format!(\"plate_{name}\"));\n    }\n\n    /// The gift wakes: the meter fills and the prompt appears.\n    pub fn wake_gift(&mut self, events: &mut Vec<SimEvent>) {\n        if self.op.gift_awake {\n            return;\n        }\n        self.op.gift_awake = true;\n        for s in &mut self.surgeons {\n            s.gift = 100.0;\n        }\n        self.op.counters.bump(\"gift_woke\");\n        let case = self.op.case;\n        if case == 5 {\n            self.say(\"pet\", \"Hm. There you are, you old fool.\");\n        } else {\n            self.say(\"bashir\", \"Doctor... your hands.\");\n        }\n        self.cue_at(events, cue::GIFT_READY, Vec2::ZERO);\n    }\n\n    /// 0 Hush, 1 Echo.\n    pub fn gift_kind(&self, slot: usize) -> u8 {\n        if self.op.case == CODE_BLUE {\n            return (slot % 2) as u8;\n        }\n        match self.case_surgeon().as_str() {\n            \"pet\" => 1,\n            \"both\" => (slot % 2) as u8,\n            _ => 0,\n        }\n    }\n\n    fn case_surgeon(&self) -> String {\n        content::get().case(self.op.case).map(|c| c.surgeon.clone()).unwrap_or_default()\n    }\n\n    /// Does this slot's hand shake right now?\n    pub fn tremor_for(&self, slot: usize) -> bool {\n        self.tremor_setting\n            && self.gifts.echo_t <= 0.0\n            && self.gift_kind(slot) == 1\n            && content::get().case(self.op.case).is_some_and(|c| c.tremor)\n    }\n\n    fn gift_input(&mut self, slot: usize, inp: &SurgeonInput, events: &mut Vec<SimEvent>) {\n        if !self.op.gift_awake {\n            return;\n        }\n        let window = self.tune.get(tune::BEAT_WINDOW) * 1.8;\n        let ready = self.surgeons[slot].gift >= 100.0 || self.cheats.full_gift;\n        let down = inp.held & hands::GIFT != 0;\n        let s = &mut self.surgeons[slot];\n        if down && !s.gift_hold && ready {\n            s.gift_hold = true;\n            let at = s.cursor;\n            self.cue_at(events, cue::TICK, at);\n        } else if !down && s.gift_hold {\n            s.gift_hold = false;\n            if self.heart.on_beat(window) {\n                self.fire_gift(slot, events);\n            } else {\n                self.op.counters.bump(\"gift_missed\");\n            }\n        }\n    }\n\n    pub fn fire_gift(&mut self, slot: usize, events: &mut Vec<SimEvent>) {\n        let kind = self.gift_kind(slot);\n        let duration = self.tune.get(tune::GIFT_TIME);\n        let both = self.case_surgeon() == \"both\" && !self.humans[1];\n        self.surgeons[slot].gift = 0.0;\n        let at = self.surgeons[slot].cursor;\n        if kind == 0 || both {\n            self.gifts.hush_beats = 6.0 * duration;\n            self.op.counters.bump(\"hush\");\n        }\n        if kind == 1 || both {\n            self.gifts.echo_t = self.tune.get(tune::ECHO_TIME) * duration;\n            self.op.counters.bump(\"echo\");\n            if !self.gifts.echo_said && !both {\n                self.gifts.echo_said = true;\n                self.say(\"pet\", \"There. Steady as a girl of thirty. Don't tell anyone.\");\n            }\n        }\n        if both {\n            self.gifts.duet = true;\n            self.op.counters.bump(\"duet\");\n            self.say(\"pet\", \"Together, then, you frightened child. Hear it?\");\n        }\n        self.op.shake = self.op.shake.max(0.5);\n        self.cue_at(events, cue::GIFT_FIRE, at);\n    }\n\n    /// The heart stops.\n    pub fn start_code(&mut self, scripted: bool, shocks: u8) {\n        let window = self.tune.get(tune::CODE_WINDOW) * if scripted { 3.0 } else { 1.0 };\n        self.op.code = Some(CodeState { left: window, window, ghost: 0.0, shocks: shocks.max(1), scripted, flash: 0.0 });\n        self.heart.stopped = true;\n        self.op.banner = Some((\"CODE\".into(), 0.0));\n        self.set_stage(Stage::Code);\n        for i in 0..4 {\n            self.release(i);\n        }\n        self.op.forced_tool = None;\n        self.op.counters.bump(if scripted { \"code_scripted\" } else { \"code\" });\n    }\n\n    fn code_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut c) = self.op.code.take() else {\n            self.set_stage(Stage::Op);\n            return;\n        };\n        self.op.clock += dt;\n        c.left -= dt;\n        c.ghost = (c.ghost + dt / 1.1) % 1.0;\n        c.flash = (c.flash - dt * 3.0).max(0.0);\n        self.heart.tick(dt, self.op.vitals, 1.0);\n        if self.stage_t < dt * 1.5 {\n            self.cue_at(events, cue::FLATLINE, Vec2::ZERO);\n            self.callout(\"code\");\n        }\n        let mut success = None;\n        let mut cheat_win = false;\n        for slot in 0..4 {\n            let inp = if self.surgeons[slot].bot { self.bot_input(slot, self.bot_skill) } else { input.surgeons[slot] };\n            if !inp.active && !self.surgeons[slot].bot {\n                continue;\n            }\n            self.surgeons[slot].raw = inp.aim;\n            self.surgeons[slot].cursor = inp.aim;\n            let down = inp.held & hands::DEFIB != 0;\n            let s = &mut self.surgeons[slot];\n            if down {\n                if !s.charging {\n                    s.charging = true;\n                    s.charge = 0.0;\n                    self.cue_at(events, cue::DEFIB_WHINE, Vec2::ZERO);\n                }\n                let s = &mut self.surgeons[slot];\n                s.charge = (s.charge + dt / 1.2).min(1.0);\n            } else if s.charging {\n                s.charging = false;\n                let charge = s.charge;\n                s.charge = 0.0;\n                let off = (c.ghost - 0.5).abs() * 1.1;\n                if charge >= 1.0 && off <= 0.14 {\n                    success = Some((slot, off));\n                } else {\n                    self.cue_at(events, cue::SLOPPY, Vec2::ZERO);\n                    self.op.counters.bump(\"defib_miss\");\n                    self.callout(\"defib_miss\");\n                }\n            }\n        }\n        if self.cheats.immortal && c.left < 0.3 {\n            cheat_win = true;\n        }\n        if let Some((slot, off)) = success {\n            c.shocks -= 1;\n            c.flash = 1.0;\n            self.cue_at(events, cue::DEFIB_THUMP, Vec2::ZERO);\n            self.op.shake = 1.0;\n            self.op.counters.used(Tool::Defib);\n            let rating = field::Rating::from_error(off, [0.05, 0.1, 0.14], 1.0);\n            self.award(slot, rating, Tool::Defib, Vec2::ZERO, false, events);\n            if c.shocks > 0 {\n                c.left = c.window;\n                self.say_short(\"next_shock\");\n                self.op.code = Some(c);\n                return;\n            }\n        }\n        if success.is_some() || cheat_win {\n            if !c.scripted && !self.cheats.immortal {\n                self.op.codes_left = self.op.codes_left.saturating_sub(1);\n            }\n            self.op.vitals = self.op.vitals.max(30.0);\n            self.heart.stopped = false;\n            self.heart.phase = 0.0;\n            self.heart.since_r = 0.0;\n            self.op.banner = None;\n            self.set_stage(Stage::Op);\n            self.say_short(\"code_back\");\n            return;\n        }\n        if c.left <= 0.0 {\n            if c.scripted && self.op.case <= 2 {\n                // The teaching stop keeps waiting for the lesson.\n                c.left = c.window;\n                self.say_short(\"code_again\");\n            } else {\n                self.die(events);\n                return;\n            }\n        }\n        self.op.code = Some(c);\n    }\n\n    fn die(&mut self, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let case = content.case(self.op.case);\n        let minutes = (self.op.clock as u32) % 60;\n        self.death = Some(DeathView {\n            time: format!(\"03:{minutes:02}\").into(),\n            patient: case.map(|c| c.patient.as_str()).unwrap_or(\"\").into(),\n            fate: case.map(|c| c.fate_lost.as_str()).unwrap_or(\"\").into(),\n            checkpoint: self.checkpoint.is_some(),\n            t: 0.0,\n        });\n        self.heart.stopped = true;\n        self.op.code = None;\n        self.outcome = Outcome::Lost;\n        self.set_stage(Stage::Dead);\n        self.op.counters.bump(\"death\");\n        self.cue_at(events, cue::FLATLINE, Vec2::ZERO);\n    }\n\n    fn complete(&mut self, events: &mut Vec<SimEvent>) {\n        self.set_stage(Stage::Complete);\n        self.op.banner = Some((if self.mode == Mode::CodeBlue { \"PATIENT STABLE\".into() } else { \"OPERATION COMPLETE\".into() }, 0.0));\n        self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        for i in 0..4 {\n            self.release(i);\n        }\n        self.op.forced_tool = None;\n        self.op.counters.bump(\"complete\");\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let action: i32 = self.surgeons.iter().map(|s| s.score).sum();\n        let vitals_bonus = (self.op.vitals.max(0.0) * 20.0) as i32;\n        let time_bonus = (self.op.timer.max(0.0) * 5.0) as i32;\n        let penalty = self.op.mistakes as i32 * 100;\n        let total = action + vitals_bonus + time_bonus - penalty;\n        let par = (case.par * self.tune.get(tune::SCORE)).max(1.0);\n        let rank = rank_for(total as f32 / par);\n        let mut counts = [0; 4];\n        for s in &self.surgeons {\n            for i in 0..4 {\n                counts[i] += s.counts[i];\n            }\n        }\n        let scores =\n            self.surgeons.iter().enumerate().filter(|(_, s)| s.present).map(|(i, s)| (i as u8, s.score)).collect::<Vec<_>>();\n        self.run_score += total;\n        self.results = Some(ResultsView {\n            case_no: self.op.case,\n            case_name: case.name.as_str().into(),\n            patient: case.patient.as_str().into(),\n            fate: case.fate.as_str().into(),\n            action_points: action,\n            vitals_bonus,\n            time_bonus,\n            mistakes: self.op.mistakes,\n            mistake_penalty: penalty,\n            total,\n            par: par as i32,\n            rank: rank.into(),\n            counts,\n            best_chain: self.surgeons.iter().map(|s| s.best_chain).max().unwrap_or(0),\n            scores,\n            t: 0.0,\n            won: true,\n        });\n    }\n\n    /// Goes on from a finished results screen.\n    fn after_results(&mut self, events: &mut Vec<SimEvent>) {\n        self.cases_won += 1;\n        let counters = std::mem::take(&mut self.op.counters);\n        self.coverage.add(&counters);\n        match self.mode {\n            Mode::Campaign => {\n                let after = content::get().case(self.op.case).map(|c| c.after.clone()).unwrap_or_default();\n                if !after.is_empty() {\n                    self.begin_story(&after, events);\n                } else {\n                    self.next_campaign_case(events);\n                }\n            }\n            _ => {\n                self.outcome = Outcome::Won;\n                self.set_stage(Stage::Finished);\n            }\n        }\n    }\n\n    pub(crate) fn next_campaign_case(&mut self, events: &mut Vec<SimEvent>) {\n        let next = self.op.case + 1;\n        if (next as usize) < content::CASES {\n            self.begin_campaign_case(next, events);\n        } else {\n            self.outcome = Outcome::Won;\n            self.set_stage(Stage::Finished);\n        }\n    }\n\n    fn op_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let hush = self.gifts.hush_beats > 0.0;\n        let scale = if hush { self.tune.get(tune::HUSH_SCALE) } else { 1.0 } * self.cheats.time_scale.max(0.01);\n        let rule = dt * scale;\n        self.op.clock += rule;\n        self.op.since_callout += dt;\n        let coupling = self.tune.get(tune::COUPLING);\n        let beat = self.heart.tick(rule, self.op.vitals.max(0.0), coupling);\n        if beat {\n            self.op.phase_beats += 1;\n            self.cue_at(events, cue::LUB, Vec2::ZERO);\n            if hush {\n                self.gifts.hush_beats -= 1.0;\n            }\n        }\n        self.gifts.echo_t = (self.gifts.echo_t - rule).max(0.0);\n        let hush_target = if self.gifts.hush_beats > 0.0 { 1.0 } else { 0.0 };\n        self.gifts.hush_fx += (hush_target - self.gifts.hush_fx) * (1.0 - (-dt * 6.0).exp());\n        let echo_target = if self.gifts.echo_t > 0.0 { 1.0 } else { 0.0 };\n        self.gifts.echo_fx += (echo_target - self.gifts.echo_fx) * (1.0 - (-dt * 6.0).exp());\n        if self.gifts.hush_beats <= 0.0 && self.gifts.echo_t <= 0.0 {\n            self.gifts.duet = false;\n        }\n\n        let strict_players = self.stage == Stage::Op;\n        for slot in 0..4 {\n            let inp = if self.surgeons[slot].bot { self.bot_input(slot, self.bot_skill) } else { input.surgeons[slot] };\n            if inp.active && !self.surgeons[slot].bot {\n                self.humans[slot] = true;\n                self.surgeons[slot].present = true;\n            }\n            if !self.surgeons[slot].present {\n                continue;\n            }\n            if !(inp.active || self.surgeons[slot].bot) {\n                // Nobody is at this slot this tick: hands off.\n                self.last_held[slot] = 0;\n                self.surgeons[slot].using = false;\n                if self.surgeons[slot].engaged != 0 {\n                    self.release(slot);\n                }\n                continue;\n            }\n            self.hands(slot, &inp, rule, dt, events);\n            self.gift_input(slot, &inp, events);\n            self.last_held[slot] = inp.held;\n        }\n        self.ghosts_tick(dt, events);\n        self.hazards_tick(rule, events);\n        self.strain_tick(rule, beat, events);\n        if !strict_players {\n            return;\n        }\n        self.phase_tick(rule, events);\n        if self.stage != Stage::Op {\n            return;\n        }\n        // The clock and the patient.\n        if !self.cheats.freeze_timer {\n            self.op.timer -= rule;\n        }\n        for s in &mut self.surgeons {\n            if s.chain > 0 {\n                s.chain_t -= dt;\n                if s.chain_t <= 0.0 {\n                    s.chain = 0;\n                }\n            }\n        }\n        if self.cheats.full_gift {\n            for s in &mut self.surgeons {\n                s.gift = 100.0;\n            }\n        }\n        let v = self.op.vitals;\n        if v < 40.0 && !self.op.said_forty {\n            self.op.said_forty = true;\n            self.say_short(\"vitals_forty\");\n        }\n        if v > 55.0 {\n            self.op.said_forty = false;\n            self.op.critical = false;\n        }\n        if v < 25.0 && !self.op.critical {\n            self.op.critical = true;\n            self.op.banner = Some((\"VITALS CRITICAL\".into(), 0.0));\n            self.cue_at(events, cue::ALARM, Vec2::ZERO);\n        }\n        if self.op.vitals <= 0.0 {\n            self.op.vitals = 0.0;\n            if self.cheats.immortal {\n                self.op.vitals = 1.0;\n            } else if self.op.codes_left > 0 {\n                self.start_code(false, 1);\n            } else {\n                self.die(events);\n            }\n            return;\n        }\n        if self.op.timer <= 0.0 {\n            if self.mode == Mode::CodeBlue || self.op.case == CODE_BLUE {\n                // Alive at the end: the team wins.\n                self.complete(events);\n            } else {\n                self.say_short(\"time_up\");\n                self.die(events);\n            }\n        }\n    }\n\n    fn apply(&mut self, cmd: SurgeryCmd, events: &mut Vec<SimEvent>) {\n        match cmd {\n            SurgeryCmd::Advance => match self.stage {\n                Stage::Story => self.story_advance(events),\n                Stage::Chart => self.start_operation(events),\n                Stage::Results => {\n                    if self.results.as_ref().is_some_and(|r| r.t > 0.05) {\n                        self.after_results(events);\n                    }\n                }\n                _ => {}\n            },\n            SurgeryCmd::SkipScene => {\n                if self.stage == Stage::Story {\n                    self.story_skip(events);\n                }\n            }\n            SurgeryCmd::Retry { from_start } => {\n                if self.stage == Stage::Dead {\n                    let cp = if from_start { self.start_case_cp.clone() } else { self.checkpoint.clone().or(self.start_case_cp.clone()) };\n                    if let Some(cp) = cp {\n                        self.restore(&cp);\n                        self.outcome = Outcome::Playing;\n                        self.death = None;\n                        self.heart.stopped = false;\n                        self.set_stage(Stage::OpStart);\n                        self.op.banner = Some((\"OPERATION START\".into(), 0.0));\n                        self.op.counters.bump(\"retry\");\n                    }\n                }\n            }\n            SurgeryCmd::SetTune { id, value } => self.tune.set(id as usize, value),\n            SurgeryCmd::ResetTune => self.tune = Tune::default(),\n            SurgeryCmd::Cheat { id, value } => self.cheat(id, value, events),\n            SurgeryCmd::Jump { case, phase } => {\n                self.begin_case(case);\n                self.start_operation(events);\n                self.jump_phase(phase, events);\n            }\n            SurgeryCmd::Spawn { kind, x, z } => {\n                let k = field::HazardKind::ALL.get(kind as usize).copied().unwrap_or(field::HazardKind::Foreign);\n                self.spawn_kind(k, Vec2::new(x, z));\n            }\n            SurgeryCmd::Join { slot } => {\n                if let Some(h) = self.humans.get_mut(slot as usize) {\n                    *h = true;\n                    self.surgeons[slot as usize].present = true;\n                    self.surgeons[slot as usize].bot = false;\n                }\n            }\n            SurgeryCmd::Difficulty(d) => self.diff = d.min(2),\n            SurgeryCmd::TextSpeed(c) => self.text_cps = c.clamp(5.0, 400.0),\n            SurgeryCmd::Tremor(on) => self.tremor_setting = on,\n            SurgeryCmd::BotPlays { slot, on } => {\n                if let Some(s) = self.surgeons.get_mut(slot as usize) {\n                    s.bot = on;\n                    if on {\n                        s.present = true;\n                    }\n                }\n            }\n        }\n    }\n\n    fn cheat(&mut self, id: u16, value: f32, events: &mut Vec<SimEvent>) {\n        use tune::cheat as c;\n        let on = value != 0.0;\n        match id {\n            c::IMMORTAL => self.cheats.immortal = on,\n            c::FREEZE_TIMER => self.cheats.freeze_timer = on,\n            c::FULL_GIFT => {\n                self.cheats.full_gift = on;\n                if on {\n                    self.op.gift_awake = true;\n                }\n            }\n            c::ONE_HIT => self.cheats.one_hit = on,\n            c::TIME_SCALE => self.cheats.time_scale = value.clamp(0.05, 4.0),\n            c::SKIP_PHASE => {\n                if matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code) {\n                    self.heart.stopped = false;\n                    self.op.code = None;\n                    self.set_stage(Stage::Op);\n                    self.skip_phase(events);\n                }\n            }\n            c::WIN_CASE => {\n                if matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Chart | Stage::Dead) {\n                    self.heart.stopped = false;\n                    self.op.code = None;\n                    self.outcome = Outcome::Playing;\n                    self.death = None;\n                    self.op.hazards.clear();\n                    self.complete(events);\n                }\n            }\n            c::FORCE_CODE => {\n                if self.stage == Stage::Op {\n                    self.start_code(false, 1);\n                }\n            }\n            c::KILL_PATIENT => {\n                if matches!(self.stage, Stage::Op | Stage::Code) {\n                    self.die(events);\n                }\n            }\n            c::OVERLAYS => self.cheats.overlays = value as u32,\n            c::BOT_SKILL => self.bot_skill = value.clamp(0.0, 1.0),\n            _ => {}\n        }\n    }\n\n    /// Spawns one of a kind at a point (dev mode).\n    pub fn spawn_kind(&mut self, kind: field::HazardKind, at: Vec2) {\n        use field::HazardKind as K;\n        let d = Vec2::new(1.2, 0.3);\n        let mut h = Hazard { kind, pos: at, required: false, r: 0.0, ..Default::default() };\n        match kind {\n            K::Incision | K::Laceration | K::Closure | K::Tether => h.pts = vec![at - d, at + d],\n            K::Tendril => h.pts = vec![at - d * 2.0, at, at + d * 2.0],\n            K::Bone => {\n                h.to = at + Vec2::new(1.5, 0.0);\n                h.angle = 0.7;\n            }\n            K::Nodule => h.to = at,\n            K::Sac => h.to = at - Vec2::new(0.0, 1.0),\n            _ => {}\n        }\n        h.r = match kind {\n            K::Pool => 0.9,\n            K::Foreign => 0.3,\n            K::Polyp => 0.42,\n            K::Tumor => 1.1,\n            K::Burn => 0.8,\n            K::Bone => 0.8,\n            K::Nodule => 0.55,\n            K::Sac => 0.5,\n            K::Eye => 0.8,\n            K::Ember => 0.6,\n            K::Furnace => 1.7,\n            K::Crown => 1.2,\n            _ => 0.2,\n        };\n        self.add_hazard(h);\n    }\n\n    /// The whole game's next state, in a scene without a tick (dev reload).\n    pub fn frame(&self) -> SurgeryFrame {\n        if let Some(f) = &self.mirror_frame {\n            let mut f = (**f).clone();\n            f.mirror = true;\n            return f;\n        }\n        let op = &self.op;\n        let content = content::get();\n        let case = content.case(op.case);\n        let surgeons = self\n            .surgeons\n            .iter()\n            .enumerate()\n            .map(|(i, s)| {\n                let meter = self\n                    .hazard(s.engaged)\n                    .map(|h| match s.tool {\n                        Tool::Laser | Tool::Cryo => h.heat,\n                        Tool::Gel => h.progress,\n                        _ => h.progress,\n                    })\n                    .unwrap_or(0.0);\n                SurgeonView {\n                    slot: i as u8,\n                    present: s.present,\n                    bot: s.bot,\n                    cursor: s.cursor,\n                    raw: s.raw,\n                    tool: s.tool,\n                    engaged: s.engaged,\n                    using: s.using,\n                    pressure: s.pressure,\n                    score: s.score,\n                    chain: s.chain,\n                    gift: s.gift,\n                    gift_ready: op.gift_awake && s.gift >= 100.0,\n                    gift_hold: s.gift_hold,\n                    gift_kind: self.gift_kind(i),\n                    flow: s.flow,\n                    dose: s.dose,\n                    iv_cool: s.iv_cool,\n                    iv_on: s.iv_on,\n                    charge: s.charge,\n                    charging: s.charging,\n                    kick: s.kick,\n                    meter,\n                    name: self.slot_name(i).into(),\n                }\n            })\n            .collect();\n        let guide = if op.guided && self.stage == Stage::Op {\n            let tool = self.surgeons[0].tool;\n            op.hazards\n                .iter()\n                .filter(|h| h.required && !self.covered(h) && h.wants().is_some())\n                .min_by_key(|h| if h.accepts(tool) { 0 } else { 1 })\n                .map(|h| h.id)\n                .unwrap_or(0)\n        } else {\n            0\n        };\n        let code = op.code.as_ref().map(|c| CodeView {\n            left: c.left,\n            window: c.window,\n            ghost: c.ghost,\n            shocks: c.shocks,\n            scripted: c.scripted,\n        });\n        let story = (self.stage == Stage::Story).then(|| self.story.view(self.text_cps));\n        let chart = (self.stage == Stage::Chart).then(|| {\n            let c = case;\n            ChartView {\n                case_no: op.case,\n                case_name: c.map(|c| c.name.as_str()).unwrap_or(\"\").into(),\n                patient: c.map(|c| c.patient.as_str()).unwrap_or(\"\").into(),\n                life: c.map(|c| c.life.as_str()).unwrap_or(\"\").into(),\n                diagnosis: c.map(|c| c.diagnosis.as_str()).unwrap_or(\"\").into(),\n                surgeon: c.map(|c| c.surgeon.as_str()).unwrap_or(\"\").into(),\n                t: self.stage_t,\n            }\n        });\n        let results = self.results.clone().filter(|_| self.stage == Stage::Results).map(|mut r| {\n            r.t = self.stage_t;\n            r\n        });\n        let death = self.death.clone().filter(|_| self.stage == Stage::Dead).map(|mut d| {\n            d.t = self.stage_t;\n            d\n        });\n        let strain = op.strain.as_ref();\n        let in_op = matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete);\n        let crisis = if in_op { (1.0 - op.vitals / 55.0).clamp(0.0, 1.0) } else { 0.0 };\n        let track: Arc<str> = match self.stage {\n            Stage::Title | Stage::Card => \"title\".into(),\n            Stage::Story | Stage::Chart => {\n                if self.stage == Stage::Story {\n                    self.story.music.clone()\n                } else {\n                    \"tense\".into()\n                }\n            }\n            Stage::Op | Stage::OpStart | Stage::Complete => {\n                if op.case == CODE_BLUE {\n                    \"codeblue\".into()\n                } else {\n                    \"or\".into()\n                }\n            }\n            Stage::Results => \"results\".into(),\n            Stage::Code | Stage::Dead | Stage::Finished => \"\".into(),\n        };\n        let shot = if self.stage == Stage::Story && self.story.camera_or {\n            CameraShot::WIDE\n        } else if self.stage == Stage::Story {\n            CameraShot::PAPER\n        } else {\n            let mut s = CameraShot::FIELD;\n            let k = op.push.clamp(0.0, 1.0);\n            let k = k * k * (3.0 - 2.0 * k);\n            s.distance -= k * 3.2;\n            s.target[0] += op.push_at.x * k * 0.3;\n            s.target[2] += op.push_at.y * k * 0.3;\n            s\n        };\n        SurgeryFrame {\n            stage: self.stage,\n            tick: self.tick,\n            clock: op.clock,\n            shot,\n            case_no: op.case,\n            phase: op.phase,\n            phases: case.map(|c| c.phase.len() as u8).unwrap_or(0),\n            case_name: case.map(|c| c.name.as_str()).unwrap_or(\"\").into(),\n            attract: self.mode == Mode::Attract,\n            codeblue: op.case == CODE_BLUE,\n            mirror: self.mode == Mode::Mirror,\n            plate: op.plate.clone(),\n            prev_plate: op.prev_plate.clone(),\n            plate_blend: if op.prev_plate.is_some() { op.plate_blend } else { 1.0 },\n            plate_from: op.plate_from,\n            vitals: op.vitals,\n            vitals_max: op.vitals_max,\n            bpm: self.heart.bpm,\n            beat: self.heart.phase,\n            beats: self.heart.beats,\n            flat: self.heart.stopped || self.surgeons.iter().any(|s| s.gift_hold),\n            meter: self.heart.meter,\n            bar_beat: self.heart.bar_beat,\n            timer: op.timer,\n            timer_total: op.timer_total,\n            hazards: op.hazards.clone(),\n            stains: op.stains.clone(),\n            surgeons,\n            ring: op.ring,\n            forced_tool: op.forced_tool,\n            objective: op.objective.clone(),\n            guided: op.guided,\n            guide,\n            subtitle: op.subtitle.clone(),\n            popups: op.popups.clone(),\n            ghosts: op.ghosts.clone(),\n            pings: op.pings.clone(),\n            banner: op.banner.clone(),\n            hush: self.gifts.hush_fx,\n            echo: self.gifts.echo_fx,\n            gift_awake: op.gift_awake,\n            duet: self.gifts.duet,\n            fever: strain.and_then(|s| s.fever),\n            heat_ring: strain.and_then(|s| s.ring),\n            ring_in: strain\n                .filter(|s| s.rings > 0 && s.ring.is_none())\n                .map(|s| s.rings.saturating_sub(s.ring_beat).min(3) as u8)\n                .unwrap_or(0),\n            code,\n            story,\n            chart,\n            results,\n            death,\n            music: MusicView {\n                track,\n                crisis,\n                hush: self.gifts.hush_fx,\n                motif: if in_op && strain.is_some() { self.heart.meter } else { 0 },\n            },\n            shake: op.shake,\n            flash: op.code.as_ref().map(|c| c.flash).unwrap_or(0.0),\n            push: op.push,\n            push_at: op.push_at,\n            overlays: self.cheats.overlays,\n            tremor: self.tremor_for(0),\n        }\n    }\n\n    pub fn slot_name(&self, slot: usize) -> &'static str {\n        match self.case_surgeon().as_str() {\n            \"pet\" => [\"Pet\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            \"both\" => [\"Mara\", \"Pet\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            \"mara\" => [\"Mara\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            _ => [\"Surgeon 1\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n        }\n    }\n}\n\npub fn rank_for(fraction: f32) -> &'static str {\n    if fraction >= 1.15 {\n        \"ENCORE\"\n    } else if fraction >= 1.0 {\n        \"S\"\n    } else if fraction >= 0.85 {\n        \"A\"\n    } else if fraction >= 0.7 {\n        \"B\"\n    } else {\n        \"C\"\n    }\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n\n    fn pre(&mut self, _sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        self.stage_t += dt;\n        if let Some(cmd) = input.surgery {\n            self.apply(cmd, events);\n        }\n        if let Some(b) = &mut self.op.banner {\n            b.1 += dt;\n            if b.1 > 2.6 {\n                self.op.banner = None;\n            }\n        }\n        if let Some(s) = &mut self.op.subtitle {\n            s.age += dt;\n            if s.age > 5.0 {\n                self.op.subtitle = None;\n            }\n        }\n        self.op.shake = (self.op.shake - dt * 2.2).max(0.0);\n        self.op.push = (self.op.push - dt * 0.35).max(0.0);\n        if self.op.plate_blend < 1.0 {\n            self.op.plate_blend = (self.op.plate_blend + dt / 0.8).min(1.0);\n        }\n        match self.stage {\n            Stage::Title | Stage::Card => {\n                self.op.clock += dt;\n                self.heart.tick(dt, 100.0, 1.0);\n            }\n            Stage::Story => self.story_tick(dt, events),\n            Stage::Chart => {\n                self.op.clock += dt;\n                self.heart.tick(dt, 100.0, 1.0);\n            }\n            Stage::OpStart => {\n                self.op.clock += dt;\n                self.heart.tick(dt, self.op.vitals, 1.0);\n                if self.stage_t > 1.7 {\n                    self.set_stage(Stage::Op);\n                }\n            }\n            Stage::Op => self.op_tick(input, dt, events),\n            Stage::Code => self.code_tick(input, dt, events),\n            Stage::Complete => {\n                self.op.clock += dt;\n                self.heart.tick(dt, self.op.vitals, 1.0);\n                if self.stage_t > 2.2 {\n                    self.set_stage(Stage::Results);\n                    self.cue_at(events, cue::STAMP, Vec2::ZERO);\n                }\n            }\n            Stage::Results => {\n                if let Some(r) = &mut self.results {\n                    r.t += dt;\n                }\n            }\n            Stage::Dead | Stage::Finished => {}\n        }\n        if self.mode == Mode::Attract {\n            self.attract_tick(dt, events);\n        }\n        BTreeMap::new()\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        json!({\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"stage\": format!(\"{:?}\", self.stage),\n            \"outcome\": self.outcome,\n            \"case\": self.op.case,\n            \"phase\": self.op.phase,\n            \"vitals\": (self.op.vitals * 10.0).round() / 10.0,\n            \"timer\": self.op.timer.round(),\n            \"hazards\": self.op.hazards.len(),\n            \"score\": self.surgeons.iter().map(|s| s.score).sum::<i32>(),\n            \"run_score\": self.run_score,\n            \"cases_won\": self.cases_won,\n            \"beats\": self.heart.beats,\n            \"bpm\": self.heart.bpm.round(),\n            \"tools\": [self.surgeons[0].tool as u8, self.surgeons[1].tool as u8, self.surgeons[2].tool as u8, self.surgeons[3].tool as u8],\n            \"cursors\": self.surgeons.iter().map(|s| [s.cursor.x, s.cursor.y]).collect::<Vec<_>>(),\n            \"present\": self.surgeons.iter().map(|s| s.present).collect::<Vec<_>>(),\n            \"story\": if self.stage == Stage::Story { Some(self.story.key.to_string()) } else { None },\n            \"line\": self.story.i,\n            \"rank\": self.results.as_ref().map(|r| r.rank.to_string()),\n            \"total\": self.results.as_ref().map(|r| r.total),\n            \"attract_seg\": self.attract_seg,\n            \"gift\": self.surgeons[0].gift,\n            \"tune_score\": self.tune.get(tune::SCORE),\n            \"seed\": self.seed,\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        for slot in 0..4 {\n            if self.humans[slot] && !self.surgeons[slot].bot {\n                f.surgeons[slot] = self.bot_input(slot, self.bot_skill);\n                if slot > 0 {\n                    break;\n                }\n            }\n        }\n        match self.stage {\n            Stage::Story | Stage::Chart => f.surgery = Some(SurgeryCmd::Advance),\n            Stage::Results if self.stage_t > 0.1 => f.surgery = Some(SurgeryCmd::Advance),\n            _ => {}\n        }\n        f\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/director.rs <<'EOF'\n//! Runs a case's data: phases, spawns, triggers, checkpoints; and Code Blue's director, which\n//! spends a budget of hazards on one patient while the tempo rises.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::content::{self, EventDef};\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::{Checkpoint, Mode, Stage, Surgery, cue};\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Director {\n    /// Surgeons at the table when it started.\n    pub surgeons: u32,\n    pub next_wave: f32,\n    pub interval: f32,\n    pub tempo: f32,\n    pub tempo_t: f32,\n    pub waves: u32,\n    pub finale: bool,\n}\n\nimpl Surgery {\n    pub(super) fn begin_phase(&mut self, i: u8, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let Some(def) = case.phase.get(i as usize) else { return };\n        self.op.phase = i;\n        self.op.phase_t = 0.0;\n        self.op.phase_beats = 0;\n        self.op.fired = 0;\n        self.op.objective = def.objective.as_str().into();\n        self.op.strain = None;\n        self.heart.meter = def.meter.unwrap_or(0);\n        self.heart.bar_beat = 0;\n        if def.checkpoint && i > 0 {\n            self.checkpoint = Some(Box::new(Checkpoint {\n                op: self.op.clone(),\n                surgeons: self.surgeons.clone(),\n                heart: self.heart.clone(),\n                gifts: self.gifts.clone(),\n            }));\n            self.op.banner = Some((\"CHECKPOINT\".into(), 1.2));\n        }\n        if let Some(p) = &def.plate {\n            if p.as_str() != &*self.op.plate {\n                let from = def.spawn.first().map(|s| Vec2::new(s.at[0], s.at[1])).unwrap_or_default();\n                self.set_plate(p, self.last_cut().unwrap_or(from));\n                self.op.push = 1.0;\n                self.op.push_at = self.last_cut().unwrap_or(from);\n                self.cue_at(events, cue::SQUISH, self.op.push_at);\n            }\n        }\n        for s in &def.spawn {\n            self.spawn_def(s);\n        }\n        if let Some(st) = &def.strain {\n            self.strain_start(st, events);\n        }\n        if self.op.case == content::CODE_BLUE && i == 0 {\n            let n = self.surgeons.iter().filter(|s| s.present).count().max(1) as u32;\n            self.op.director = Some(Director { surgeons: n, next_wave: 0.5, interval: 11.0, tempo: 1.0, ..Default::default() });\n        }\n        self.op.counters.bump(&format!(\"phase_{}_{}\", self.op.case, i));\n    }\n\n    fn last_cut(&self) -> Option<Vec2> {\n        self.op.stains.iter().rev().find(|s| s.kind == 2).and_then(|s| s.pts.first().copied())\n    }\n\n    pub(super) fn jump_phase(&mut self, phase: u8, events: &mut Vec<SimEvent>) {\n        self.op.hazards.clear();\n        self.begin_phase(phase, events);\n    }\n\n    pub(super) fn skip_phase(&mut self, events: &mut Vec<SimEvent>) {\n        self.op.hazards.clear();\n        for s in &mut self.surgeons {\n            s.engaged = 0;\n        }\n        self.next_phase(events);\n    }\n\n    fn next_phase(&mut self, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let next = self.op.phase + 1;\n        if (next as usize) < case.phase.len() {\n            self.begin_phase(next, events);\n        } else {\n            self.complete(events);\n        }\n    }\n\n    pub(super) fn phase_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        self.op.phase_t += dt;\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let Some(def) = case.phase.get(self.op.phase as usize) else { return };\n\n        if self.op.director.is_some() {\n            self.director_tick(dt, events);\n        }\n\n        // Only the closure left: the dressing comes to hand by itself.\n        let required: Vec<&Hazard> = self.op.hazards.iter().filter(|h| h.required).collect();\n        let closure_only = !required.is_empty() && required.iter().all(|h| h.kind == HazardKind::Closure);\n        self.op.forced_tool = if closure_only { Some(Tool::Dressing) } else { None };\n        let remaining = required.len() as u32;\n        let strain_done = self.op.strain.as_ref().is_none_or(|s| s.done);\n        let clear = remaining == 0 && strain_done;\n\n        // Triggers.\n        for (i, e) in def.event.iter().enumerate() {\n            let bit = 1u64 << (i.min(63));\n            if self.op.fired & bit != 0 {\n                continue;\n            }\n            let fire = e.at_time.is_some_and(|t| self.op.phase_t >= t)\n                || e.vitals_below.is_some_and(|v| self.op.vitals < v)\n                || e.on_beat.is_some_and(|b| self.op.phase_beats >= b)\n                || e.remaining.is_some_and(|r| remaining <= r)\n                || (e.on_clear && clear);\n            if fire {\n                self.op.fired |= bit;\n                self.run_event(e, events);\n                if self.stage != Stage::Op {\n                    return;\n                }\n            }\n        }\n\n        // Anything still to come? On-clear events may have added work.\n        let required = self.op.hazards.iter().filter(|h| h.required).count();\n        let strain_done = self.op.strain.as_ref().is_none_or(|s| s.done);\n        let pending_time = def.event.iter().enumerate().any(|(i, e)| {\n            self.op.fired & (1u64 << i.min(63)) == 0 && (e.at_time.is_some() || e.on_clear || e.on_beat.is_some())\n        });\n        let director_busy = self.op.director.as_ref().is_some_and(|d| !d.finale);\n        if required == 0 && strain_done && !pending_time && self.op.phase_t >= def.hold && !director_busy {\n            if self.op.case == content::CODE_BLUE {\n                // Code Blue runs until the bell; the strain encounter is its last act.\n                return;\n            }\n            self.next_phase(events);\n        }\n    }\n\n    pub(super) fn run_event(&mut self, e: &EventDef, events: &mut Vec<SimEvent>) {\n        for s in &e.spawn {\n            self.spawn_def(s);\n        }\n        if e.say.len() == 2 {\n            self.say(&e.say[0].clone(), &e.say[1].clone());\n        }\n        if let Some(c) = &e.cue {\n            if let Some(id) = cue::id(c) {\n                self.cue_at(events, id, Vec2::ZERO);\n            }\n        }\n        if let Some(b) = &e.banner {\n            self.op.banner = Some((b.as_str().into(), 0.0));\n            self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        }\n        if e.shake > 0.0 {\n            self.op.shake = self.op.shake.max(e.shake);\n        }\n        if let Some(p) = &e.plate {\n            let from = self.last_cut().unwrap_or_default();\n            self.set_plate(p, from);\n        }\n        if e.push > 0.0 {\n            self.op.push = e.push;\n            self.op.push_at = e.spawn.first().map(|s| Vec2::new(s.at[0], s.at[1])).unwrap_or(Vec2::ZERO);\n        }\n        if e.vitals != 0.0 {\n            if e.vitals < 0.0 {\n                self.hurt(-e.vitals);\n            } else {\n                self.op.vitals = (self.op.vitals + e.vitals).min(self.op.vitals_max);\n            }\n        }\n        if e.gift {\n            self.wake_gift(events);\n        }\n        if e.code {\n            self.start_code(true, 1);\n        }\n    }\n\n    /// Code Blue: spends the budget on waves; tempo rises every 30 s; ends in a strain.\n    fn director_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut d) = self.op.director.take() else { return };\n        d.tempo_t += dt;\n        if d.tempo_t >= 30.0 {\n            d.tempo_t = 0.0;\n            d.tempo += 0.14;\n            self.say_short(\"codeblue_tempo\");\n            self.op.banner = Some((\"TEMPO UP\".into(), 1.0));\n            self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        }\n        self.op.drain_scale = 0.85 + (d.tempo - 1.0) * 0.5;\n        // The last minute: a small strain encounter on top of the waves.\n        if !d.finale && self.op.timer < 60.0 {\n            d.finale = true;\n            let def = content::StrainDef {\n                kind: \"introit\".into(),\n                waves: 2,\n                speed: 1.0,\n                tough: 0.8,\n                beats: 10.0,\n                amen: false,\n                count: 1,\n                rings: 0,\n                fever: 0.0,\n                at: [0.0, 0.0],\n                furnace: false,\n                visible: true,\n            };\n            self.strain_start(&def, events);\n            self.say_short(\"codeblue_finale\");\n        }\n        d.next_wave -= dt;\n        if d.next_wave <= 0.0 {\n            d.waves += 1;\n            d.next_wave = d.interval / d.tempo;\n            let budget = (3.0 * d.tempo * (0.6 + 0.4 * d.surgeons as f32)).round() as u32;\n            self.spawn_budget(budget, d.waves);\n        }\n        self.op.director = Some(d);\n    }\n\n    fn spawn_budget(&mut self, mut budget: u32, wave: u32) {\n        let busy = self.op.hazards.iter().filter(|h| h.required).count() as u32;\n        if busy > 14 {\n            return;\n        }\n        while budget > 0 {\n            let at = self.field_spot(Vec2::ZERO, budget + wave * 7);\n            let roll = self.rand();\n            let dir = Vec2::from_angle(self.rand() * 6.28);\n            let (kind, cost) = if roll < 0.24 {\n                (HazardKind::Laceration, 1)\n            } else if roll < 0.46 {\n                (HazardKind::Foreign, 1)\n            } else if roll < 0.6 {\n                (HazardKind::Polyp, 1)\n            } else if roll < 0.72 {\n                (HazardKind::Burn, 1)\n            } else if roll < 0.84 {\n                (HazardKind::Incision, 1)\n            } else if roll < 0.94 {\n                (HazardKind::Pool, 1)\n            } else {\n                (HazardKind::Bleeder, 2)\n            };\n            let mut h = Hazard { kind, pos: at, axis: self.rand() * 6.28, required: true, ..Default::default() };\n            match kind {\n                HazardKind::Laceration => {\n                    let len = 0.9 + self.rand() * 0.8;\n                    h.pts = vec![at - dir * len, at + dir.perp() * 0.25, at + dir * len];\n                }\n                HazardKind::Incision => {\n                    let len = 1.3 + self.rand();\n                    h.pts = vec![at - dir * len, at + dir * len];\n                }\n                HazardKind::Foreign => {\n                    h.r = 0.3;\n                    h.tag = (self.rand() * 3.0) as u8;\n                }\n                HazardKind::Polyp => h.r = 0.42,\n                HazardKind::Burn => h.r = 0.75,\n                HazardKind::Pool => h.r = 0.85,\n                HazardKind::Bleeder => h.r = 0.3,\n                _ => {}\n            }\n            self.add_hazard(h);\n            budget = budget.saturating_sub(cost);\n        }\n    }\n\n    /// Attract: the next 25-second segment of the loop.\n    pub(super) fn attract_next(&mut self, events: &mut Vec<SimEvent>) {\n        self.attract_t = 0.0;\n        self.cheats.immortal = true;\n        self.cheats.full_gift = true;\n        self.cheats.freeze_timer = true;\n        self.bot_skill = 1.0;\n        let seg = self.attract_seg;\n        self.attract_seg = (self.attract_seg + 1) % 6;\n        // Case, phase of it, bots at the table.\n        let (case, phase, bots) = match seg {\n            0 => (3u8, 1u8, 1usize),\n            1 => (4, 1, 1),\n            2 => (5, 1, 1),\n            3 => (7, 4, 2),\n            4 => (content::CODE_BLUE, 0, 4),\n            _ => (0, 0, 0),\n        };\n        for (i, s) in self.surgeons.iter_mut().enumerate() {\n            s.bot = i < bots;\n            s.present = i < bots;\n        }\n        self.humans = [false; 4];\n        self.begin_case(case);\n        if bots == 0 {\n            // One story exchange.\n            self.begin_story(\"case3_after\", events);\n            return;\n        }\n        self.begin_phase(phase, events);\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n        self.op.banner = None;\n        self.op.gift_awake = true;\n        if case == content::CODE_BLUE {\n            self.op.timer = 200.0;\n        }\n    }\n\n    pub(super) fn attract_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        self.attract_t += dt;\n        // The bot reads slowly on the story segment, so a passer-by can too.\n        if self.stage == Stage::Story {\n            let due = self.story.t > (0.8 + self.story.text.chars().count() as f32 * 0.03).min(3.0);\n            if due {\n                self.story.typed = true;\n                self.story_advance(events);\n            }\n        }\n        if self.stage == Stage::Op {\n            let done = self.op.hazards.iter().filter(|h| h.required).count() == 0\n                && self.op.strain.as_ref().is_none_or(|s| s.done);\n            if done && self.op.phase_t > 1.0 && self.mode == Mode::Attract {\n                self.attract_t = 99.0;\n            }\n        }\n        if self.attract_t > 25.0 || !matches!(self.stage, Stage::Op | Stage::Story) {\n            self.attract_next(events);\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/story.rs <<'EOF'\n//! The story scene player: stage commands and lines, read from the story files.\n\nuse std::sync::Arc;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::frame::{ActorView, StoryView};\nuse super::{Stage, Surgery, content, cue};\nuse crate::frame::SimEvent;\n\n/// Where a stage name puts a character.\npub fn stage_x(at: &str) -> f32 {\n    match at {\n        \"left\" => -3.1,\n        \"right\" => 3.1,\n        \"centre\" | \"center\" => 0.0,\n        \"farleft\" => -4.9,\n        \"farright\" => 4.9,\n        _ => 3.1,\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StoryState {\n    pub key: Arc<str>,\n    pub i: usize,\n    pub t: f32,\n    pub typed: bool,\n    pub set: Arc<str>,\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    pub actors: Vec<ActorView>,\n    pub music: Arc<str>,\n    pub camera_or: bool,\n    pub flash: f32,\n    pub shake: f32,\n}\n\nimpl StoryState {\n    pub fn view(&self, cps: f32) -> StoryView {\n        let total = self.text.chars().count() as f32;\n        let chars = if self.typed { total } else { (self.t * cps).min(total) };\n        let talking = !self.typed && chars < total;\n        let actors = self\n            .actors\n            .iter()\n            .map(|a| {\n                let mut a = a.clone();\n                a.talking = talking && a.who == self.who;\n                a\n            })\n            .collect();\n        StoryView {\n            key: self.key.clone(),\n            line: self.i as u32,\n            who: self.who.clone(),\n            text: self.text.clone(),\n            chars: chars as u32,\n            typed: self.typed || chars >= total,\n            set: self.set.clone(),\n            actors,\n            camera_or: self.camera_or,\n            flash: self.flash,\n            shake: self.shake,\n            t: self.t,\n        }\n    }\n}\n\nimpl Surgery {\n    pub fn begin_story(&mut self, key: &str, events: &mut Vec<SimEvent>) {\n        self.story = StoryState { key: key.into(), set: \"corridor\".into(), music: \"tense\".into(), ..Default::default() };\n        self.stage = Stage::Story;\n        self.stage_t = 0.0;\n        self.op.counters.bump(\"story\");\n        self.story_step(0, events);\n    }\n\n    /// Runs lines from `from`: commands until a spoken line stops it, or the end of the scene.\n    fn story_step(&mut self, from: usize, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(def) = content.stories.get(&*self.story.key) else {\n            self.story_done(events);\n            return;\n        };\n        let mut i = from;\n        while let Some(l) = def.line.get(i) {\n            let st = &mut self.story;\n            if !l.set.is_empty() {\n                st.set = l.set.as_str().into();\n            }\n            if !l.music.is_empty() {\n                st.music = l.music.as_str().into();\n            }\n            if !l.camera.is_empty() {\n                st.camera_or = l.camera == \"or\";\n            }\n            if l.flash > 0.0 {\n                st.flash = l.flash;\n            }\n            if l.shake > 0.0 {\n                st.shake = l.shake;\n            }\n            if !l.exit.is_empty() {\n                let who = l.exit.as_str();\n                for a in st.actors.iter_mut() {\n                    if who == \"all\" || &*a.who == who {\n                        a.leaving = true;\n                        a.t = 0.0;\n                    }\n                }\n            }\n            if !l.enter.is_empty() {\n                let x = stage_x(&l.at);\n                let who: Arc<str> = l.enter.as_str().into();\n                st.actors.retain(|a| a.who != who);\n                st.actors.push(ActorView { who, expr: \"neutral\".into(), x, t: 0.0, leaving: false, talking: false });\n            }\n            if !l.who.is_empty() {\n                let who: Arc<str> = l.who.as_str().into();\n                if !l.expr.is_empty() {\n                    if let Some(a) = st.actors.iter_mut().find(|a| a.who == who) {\n                        a.expr = l.expr.as_str().into();\n                    }\n                }\n            } else if !l.expr.is_empty() {\n                // An expression change with no line needs a who; there is none.\n            }\n            if !l.cue.is_empty() {\n                if let Some(id) = cue::id(&l.cue) {\n                    let at = glam::Vec2::ZERO;\n                    self.cue_at(events, id, at);\n                }\n            }\n            if !l.who.is_empty() && !l.text.is_empty() {\n                let st = &mut self.story;\n                st.i = i;\n                st.t = 0.0;\n                st.typed = false;\n                st.who = l.who.as_str().into();\n                st.text = l.text.as_str().into();\n                return;\n            }\n            i += 1;\n        }\n        self.story.i = i;\n        self.story_done(events);\n    }\n\n    pub(super) fn story_tick(&mut self, dt: f32, _events: &mut Vec<SimEvent>) {\n        let st = &mut self.story;\n        st.t += dt;\n        st.flash = (st.flash - dt * 2.0).max(0.0);\n        st.shake = (st.shake - dt * 2.5).max(0.0);\n        for a in &mut st.actors {\n            a.t += dt;\n        }\n        st.actors.retain(|a| !(a.leaving && a.t > 0.5));\n        self.op.clock += dt;\n        self.heart.tick(dt, 100.0, 1.0);\n    }\n\n    pub(super) fn story_advance(&mut self, events: &mut Vec<SimEvent>) {\n        let total = self.story.text.chars().count() as f32;\n        if !self.story.typed && self.story.t * self.text_cps < total {\n            self.story.typed = true;\n            return;\n        }\n        let next = self.story.i + 1;\n        self.story_step(next, events);\n    }\n\n    pub(super) fn story_skip(&mut self, events: &mut Vec<SimEvent>) {\n        self.story_done(events);\n    }\n\n    /// The scene is over: on to the chart, or the next case after an \"after\" scene.\n    fn story_done(&mut self, events: &mut Vec<SimEvent>) {\n        self.story.actors.clear();\n        if self.mode == super::Mode::Attract {\n            self.attract_t = 99.0;\n            self.stage = Stage::Title;\n            return;\n        }\n        let content = content::get();\n        let after = content.case(self.op.case).map(|c| c.after.clone()).unwrap_or_default();\n        if &*self.story.key == after.as_str() {\n            self.next_campaign_case(events);\n        } else {\n            self.stage = Stage::Chart;\n            self.stage_t = 0.0;\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/bot.rs <<'EOF'\n//! The bot: a task planner. It picks the most urgent valid task, selects the tool, moves at a human\n//! cursor speed and performs the gesture, with noise scaled by skill. It is a pure function of the\n//! game's state, so a replay of it is exact. It drives the tests, the balance tool, attract mode,\n//! the Case 7 partner.\n\nuse glam::Vec2;\n\nuse super::Surgery;\nuse super::field::{Hazard, HazardKind, Tool, polyline_at};\nuse super::frame::Stage;\nuse crate::input::{SurgeonInput, hands};\n\n/// A repeatable number in -1..1 from a seed.\nfn noise(seed: f32) -> f32 {\n    let x = (seed * 12.9898).sin() * 43758.547;\n    (x - x.floor()) * 2.0 - 1.0\n}\n\nimpl Surgery {\n    fn bot_noise(&self, slot: usize, k: f32) -> Vec2 {\n        let t = (self.op.clock * 3.0).floor() + slot as f32 * 31.0;\n        Vec2::new(noise(t + k), noise(t + k + 57.0))\n    }\n\n    /// What a player of this skill presses this tick for this slot.\n    pub fn bot_input(&self, slot: usize, skill: f32) -> SurgeonInput {\n        let s = &self.surgeons[slot];\n        let mut inp = SurgeonInput { active: true, aim: s.raw, tool: -1, pressure: 1.0, ..Default::default() };\n        if skill <= 0.0 {\n            return inp;\n        }\n        match self.stage {\n            Stage::Code => return self.bot_code(slot, inp),\n            Stage::Op => {}\n            _ => return inp,\n        }\n        // A slow player sits and thinks now and then.\n        let think = noise((self.op.clock * 1.5).floor() + slot as f32 * 7.0);\n        if skill < 0.95 && think > 0.2 + skill && s.engaged == 0 {\n            return inp;\n        }\n        self.bot_gift(slot, &mut inp);\n        if inp.held & hands::GIFT != 0 {\n            return inp;\n        }\n\n        // Engaged: finish the gesture first.\n        if s.engaged != 0 || s.iv_on {\n            if self.bot_gesture(slot, skill, &mut inp) {\n                return inp;\n            }\n        }\n        // Urgent: the patient is going.\n        let iv_ready = s.iv_cool <= 0.0;\n        let threshold = 25.0 + 30.0 * skill;\n        if iv_ready && self.op.vitals < threshold && self.ring_place(Tool::Iv).is_some() {\n            if s.tool != Tool::Iv {\n                inp.tool = self.ring_place(Tool::Iv).unwrap() as i8;\n                return inp;\n            }\n            inp.held |= hands::USE;\n            inp.pressed |= hands::USE;\n            return inp;\n        }\n\n        let Some((target, tool)) = self.bot_pick(slot) else {\n            // Nothing to do: drift back toward the middle.\n            inp.aim = self.bot_step(slot, skill, Vec2::new(0.0, 0.5));\n            return inp;\n        };\n        if s.tool != tool {\n            match self.ring_place(tool) {\n                Some(p) => inp.tool = p as i8,\n                None => {\n                    inp.aim = self.bot_step(slot, skill, Vec2::new(0.0, 0.5));\n                    return inp;\n                }\n            }\n            return inp;\n        }\n        let at = target.as_ref().map(|h| self.bot_touch(h, tool)).unwrap_or(Vec2::ZERO);\n        inp.aim = self.bot_step(slot, skill, at);\n        let dist = s.raw.distance(at);\n        let reach = match tool {\n            Tool::Suction | Tool::Gel => 0.8,\n            Tool::Scanner => 1.8,\n            _ => 0.28,\n        };\n        if dist < reach {\n            inp.aim = at;\n            inp.held |= hands::USE;\n            if !s.using {\n                inp.pressed |= hands::USE;\n            }\n            if tool == Tool::Gel && s.flow < 0.08 {\n                inp.held &= !hands::USE;\n                inp.pressed &= !hands::USE;\n            }\n            if tool == Tool::Laser || tool == Tool::Cryo {\n                if let Some(h) = &target {\n                    if h.by != 0 && h.by != slot as u8 + 1 {\n                        inp.held &= !hands::USE;\n                    }\n                }\n            }\n        }\n        inp\n    }\n\n    fn ring_place(&self, tool: Tool) -> Option<usize> {\n        self.op.ring.iter().position(|t| *t == tool)\n    }\n\n    /// One tick's travel toward a point, at a human cursor speed.\n    fn bot_step(&self, slot: usize, skill: f32, to: Vec2) -> Vec2 {\n        let from = self.surgeons[slot].raw;\n        let speed = (4.0 + 15.0 * skill) / 60.0;\n        let d = to - from;\n        if d.length() <= speed { to } else { from + d.normalize() * speed }\n    }\n\n    fn bot_touch(&self, h: &Hazard, tool: Tool) -> Vec2 {\n        match (h.kind, tool) {\n            (HazardKind::Sac, Tool::Laser) => h.pos.lerp(h.to, 0.5),\n            (HazardKind::Sac, _) => h.pos,\n            (HazardKind::Bleeder, _) => h.pts.first().copied().unwrap_or(h.pos),\n            _ => h.touch_point(),\n        }\n    }\n\n    /// The most urgent task for this slot, and the instrument for it.\n    fn bot_pick(&self, slot: usize) -> Option<(Option<Hazard>, Tool)> {\n        let cursor = self.surgeons[slot].raw;\n        let mut best: Option<(f32, Option<Hazard>, Tool)> = None;\n        let has = |t: Tool| self.ring_place(t).is_some();\n        // Something hidden that a task needs: look for it. The bot knows where to sweep.\n        for h in &self.op.hazards {\n            if h.hidden && h.reveal <= 0.0 && h.required && has(Tool::Scanner) {\n                let score = 40.0 - h.pos.distance(cursor);\n                if best.as_ref().is_none_or(|b| score > b.0) {\n                    best = Some((score, Some(h.clone()), Tool::Scanner));\n                }\n            }\n        }\n        // Forced: the closing dressing.\n        if self.op.forced_tool == Some(Tool::Dressing) {\n            let h = self.op.hazards.iter().find(|h| h.kind == HazardKind::Closure)?;\n            return Some((Some(h.clone()), Tool::Dressing));\n        }\n        for h in &self.op.hazards {\n            if h.by != 0 && h.by != slot as u8 + 1 {\n                continue;\n            }\n            if h.kind == HazardKind::Crown {\n                continue;\n            }\n            if self.covered(h) {\n                // Clear the pool over it first.\n                if let Some(p) = self.op.hazards.iter().find(|p| p.kind == HazardKind::Pool && p.pos.distance(h.pos) < p.r * 0.92) {\n                    let score = 34.0 - p.pos.distance(cursor);\n                    if best.as_ref().is_none_or(|b| score > b.0) {\n                        best = Some((score, Some(p.clone()), Tool::Suction));\n                    }\n                }\n                continue;\n            }\n            let Some(tool) = self.bot_tool_for(h) else { continue };\n            if !has(tool) {\n                continue;\n            }\n            let urgency = match h.kind {\n                HazardKind::Nodule if h.stage == 1 => 100.0,\n                HazardKind::Incision if h.life > 0.0 => 90.0,\n                HazardKind::Sac => 44.0 + h.progress * 40.0,\n                HazardKind::Bleeder => 60.0,\n                HazardKind::Nodule => 44.0,\n                HazardKind::Laceration => 30.0,\n                HazardKind::Pool if h.r > 1.25 => 26.0,\n                HazardKind::Pool => {\n                    if h.required {\n                        24.0\n                    } else {\n                        8.0\n                    }\n                }\n                HazardKind::Burn => 20.0,\n                _ => 28.0,\n            };\n            let score = urgency - h.touch_point().distance(cursor) * 1.2;\n            if best.as_ref().is_none_or(|b| score > b.0) {\n                best = Some((score, Some(h.clone()), tool));\n            }\n        }\n        best.map(|b| (b.1, b.2))\n    }\n\n    fn bot_tool_for(&self, h: &Hazard) -> Option<Tool> {\n        // Sacs: the stem, with the laser. The rest ask.\n        if h.kind == HazardKind::Sac {\n            return Some(if self.ring_place(Tool::Laser).is_some() { Tool::Laser } else { Tool::Suction });\n        }\n        h.wants()\n    }\n\n    /// Carries on what the hands are doing. False: nothing to carry on.\n    fn bot_gesture(&self, slot: usize, skill: f32, inp: &mut SurgeonInput) -> bool {\n        let s = &self.surgeons[slot];\n        let n = (1.0 - skill).max(0.0);\n        if s.iv_on {\n            let release = 0.88 + self.bot_noise(slot, 3.0).x * 0.12 * n;\n            if s.dose < release {\n                inp.held |= hands::USE;\n            }\n            inp.aim = s.raw;\n            return true;\n        }\n        let Some(h) = self.hazard(s.engaged) else { return false };\n        match s.tool {\n            Tool::Scalpel | Tool::Dressing => {\n                let (p, t) = polyline_at(&h.pts, h.progress + 0.3 + skill * 0.2);\n                let side = Vec2::new(-t.y, t.x) * self.bot_noise(slot, 1.0).x * (0.05 + n * 0.95);\n                inp.aim = p + side;\n                inp.held |= hands::USE;\n            }\n            Tool::Forceps => match h.kind {\n                HazardKind::Bone => {\n                    inp.aim = self.bot_step(slot, skill.max(0.6), h.to);\n                    inp.held |= hands::USE;\n                    let d = super::field::angle_diff(h.axis, h.angle);\n                    if d.abs() > 0.05 {\n                        inp.rotate = if d > 0.0 { 1 } else { -1 };\n                    }\n                }\n                HazardKind::Tendril => {\n                    let (p, _) = polyline_at(&h.pts, h.progress + 0.8);\n                    let wait = !self.heart.diastole() && n < 0.5;\n                    inp.aim = if wait { polyline_at(&h.pts, h.progress).0 } else { p };\n                    inp.held |= hands::USE;\n                }\n                _ => {\n                    let wobble = self.bot_noise(slot, 2.0).x * n * 1.2;\n                    let d = Vec2::from_angle(h.axis + wobble);\n                    inp.aim = self.bot_step(slot, skill.max(0.5), s.grab + d * 1.2);\n                    inp.held |= hands::USE;\n                }\n            },\n            Tool::Suture => {\n                let (needle, t) = polyline_at(&h.pts, h.progress);\n                let normal = Vec2::new(-t.y, t.x);\n                let go = if s.side >= 0 { -1.0 } else { 1.0 };\n                let along = 0.5 + self.bot_noise(slot, 4.0).x * n * 0.45;\n                let to = needle + t * along + normal * go * 0.55;\n                let v = (10.0 + 16.0 * skill) / 60.0;\n                let d = to - s.raw;\n                inp.aim = if d.length() <= v { to } else { s.raw + d.normalize() * v };\n                inp.held |= hands::USE;\n            }\n            Tool::Laser | Tool::Cryo => {\n                let release = 0.93 + self.bot_noise(slot, 5.0).x * 0.2 * n;\n                inp.aim = s.raw;\n                if h.heat < release {\n                    inp.held |= hands::USE;\n                }\n            }\n            _ => return false,\n        }\n        true\n    }\n\n    /// Hold the gift when it's ready; let go on the beat.\n    fn bot_gift(&self, slot: usize, inp: &mut SurgeonInput) {\n        let s = &self.surgeons[slot];\n        if !self.op.gift_awake || self.gifts.hush_beats > 0.0 || self.gifts.echo_t > 0.0 {\n            if s.gift_hold {\n                // Let go.\n            }\n            return;\n        }\n        if s.engaged != 0 {\n            return;\n        }\n        if s.gift >= 100.0 {\n            let hit = self.heart.on_beat(self.tune.get(super::tune::BEAT_WINDOW));\n            if s.gift_hold && hit {\n                return; // release now\n            }\n            if s.gift_hold || self.heart.phase > 0.45 {\n                inp.held |= hands::GIFT;\n                if !s.gift_hold {\n                    inp.pressed |= hands::GIFT;\n                }\n            }\n        }\n    }\n\n    fn bot_code(&self, slot: usize, mut inp: SurgeonInput) -> SurgeonInput {\n        let Some(c) = &self.op.code else { return inp };\n        let s = &self.surgeons[slot];\n        // Time the charge to end as the ghost crosses the line.\n        if s.charging {\n            if s.charge >= 1.0 && (c.ghost - 0.5).abs() < 0.03 {\n                return inp;\n            }\n            inp.held |= hands::DEFIB;\n        } else {\n            let until = (0.5 - c.ghost).rem_euclid(1.0) * 1.1;\n            if (until - 1.25).abs() < 0.03 || c.ghost > 0.5 && c.ghost < 0.53 {\n                inp.held |= hands::DEFIB;\n                inp.pressed |= hands::DEFIB;\n            }\n        }\n        inp\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/net.rs <<'EOF'\n//! The network's view of a Code Blue round: one compact JSON snapshot from the host about 15 times\n//! a second, and each client's hands going the other way. Keep a snapshot under 1,200 bytes when\n//! you can: an unreliable message bigger than that travels as several packets.\n\nuse std::sync::Arc;\n\nuse glam::Vec2;\nuse serde_json::{Value, json};\n\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::frame::{Stage, SurgeryFrame, SurgeonView};\nuse crate::input::SurgeonInput;\n\nfn q(v: f32) -> i32 {\n    (v * 20.0).round() as i32\n}\nfn uq(v: i64) -> f32 {\n    v as f32 / 20.0\n}\n\n/// The host's frame as a snapshot. `cues` are the last cue events: (serial, id, x, z).\npub fn encode_frame(f: &SurgeryFrame, cues: &[(u32, u16, f32, f32)]) -> Value {\n    let hz: Vec<Value> = f\n        .hazards\n        .iter()\n        .map(|h| {\n            let mut v = vec![\n                json!(h.id),\n                json!(h.kind as u8),\n                json!(q(h.pos.x)),\n                json!(q(h.pos.y)),\n                json!(q(h.r)),\n                json!(q(h.progress)),\n                json!((h.heat * 20.0) as i32),\n                json!(h.stage),\n                json!(q(h.axis)),\n                json!((h.hidden && h.reveal <= 0.0) as u8 | ((h.locked as u8) << 1) | ((h.required as u8) << 2)),\n                json!(h.tag),\n            ];\n            if h.pts.len() >= 2 {\n                let mut flat = Vec::with_capacity(h.pts.len() * 2);\n                for p in &h.pts {\n                    flat.push(json!(q(p.x)));\n                    flat.push(json!(q(p.y)));\n                }\n                v.push(Value::Array(flat));\n            }\n            Value::Array(v)\n        })\n        .collect();\n    let cur: Vec<Value> = f\n        .surgeons\n        .iter()\n        .map(|s| {\n            json!([\n                s.present as u8 | ((s.using as u8) << 1) | ((s.gift_ready as u8) << 2) | ((s.bot as u8) << 3),\n                q(s.cursor.x),\n                q(s.cursor.y),\n                s.tool as u8,\n                s.score,\n                s.chain,\n                s.gift as i32,\n                s.gift_kind\n            ])\n        })\n        .collect();\n    let stage = match f.stage {\n        Stage::Op => 0,\n        Stage::OpStart => 1,\n        Stage::Code => 2,\n        Stage::Complete => 3,\n        Stage::Results => 4,\n        Stage::Dead => 5,\n        _ => 6,\n    };\n    json!({\n        \"s\": stage,\n        \"v\": (f.vitals * 10.0) as i32,\n        \"b\": [f.bpm as i32, (f.beat * 100.0) as i32, f.beats],\n        \"t\": f.timer as i32,\n        \"h\": hz,\n        \"c\": cur,\n        \"e\": cues.iter().map(|c| json!([c.0, c.1, q(c.2), q(c.3)])).collect::<Vec<_>>(),\n        \"f\": f.heat_ring.map(|r| q(r)),\n        \"o\": f.hush > 0.5,\n        \"k\": f.echo > 0.5,\n        \"r\": f.ring,\n        \"x\": f.code.as_ref().map(|c| [q(c.left), (c.ghost * 100.0) as i32]),\n    })\n}\n\nfn get_i(v: &Value, i: usize) -> i64 {\n    v.get(i).and_then(|x| x.as_i64()).unwrap_or(0)\n}\n\n/// A snapshot back into the frame a client draws. `prev` keeps what doesn't travel.\npub fn decode_frame(v: &Value, prev: &SurgeryFrame) -> SurgeryFrame {\n    let mut f = prev.clone();\n    f.mirror = true;\n    f.codeblue = true;\n    f.case_no = super::content::CODE_BLUE;\n    f.plate = Arc::from(\"torso\");\n    f.plate_blend = 1.0;\n    f.stage = match v[\"s\"].as_i64().unwrap_or(0) {\n        0 => Stage::Op,\n        1 => Stage::OpStart,\n        2 => Stage::Code,\n        3 => Stage::Complete,\n        4 => Stage::Results,\n        5 => Stage::Dead,\n        _ => Stage::Card,\n    };\n    f.vitals = v[\"v\"].as_f64().unwrap_or(0.0) as f32 / 10.0;\n    f.vitals_max = 100.0;\n    f.bpm = get_i(&v[\"b\"], 0) as f32;\n    f.beat = get_i(&v[\"b\"], 1) as f32 / 100.0;\n    f.beats = get_i(&v[\"b\"], 2) as u32;\n    f.flat = f.stage == Stage::Code;\n    f.timer = v[\"t\"].as_f64().unwrap_or(0.0) as f32;\n    f.timer_total = 240.0;\n    f.heat_ring = v[\"f\"].as_i64().map(uq);\n    f.hush = if v[\"o\"].as_bool().unwrap_or(false) { 1.0 } else { 0.0 };\n    f.echo = if v[\"k\"].as_bool().unwrap_or(false) { 1.0 } else { 0.0 };\n    if let Some(r) = v[\"r\"].as_array() {\n        for (i, t) in r.iter().enumerate().take(8) {\n            let id = t.as_str().and_then(tool_from_debug);\n            if let Some(id) = id {\n                f.ring[i] = id;\n            }\n        }\n    }\n    f.code = v[\"x\"].as_array().map(|c| super::frame::CodeView {\n        left: uq(c.first().and_then(|x| x.as_i64()).unwrap_or(0)),\n        window: 5.0,\n        ghost: c.get(1).and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 100.0,\n        shocks: 1,\n        scripted: false,\n    });\n    f.hazards = v[\"h\"]\n        .as_array()\n        .map(|a| {\n            a.iter()\n                .map(|h| {\n                    let flags = get_i(h, 9);\n                    let mut out = Hazard {\n                        id: get_i(h, 0) as u32,\n                        kind: HazardKind::ALL.get(get_i(h, 1) as usize).copied().unwrap_or_default(),\n                        pos: Vec2::new(uq(get_i(h, 2)), uq(get_i(h, 3))),\n                        r: uq(get_i(h, 4)),\n                        progress: uq(get_i(h, 5)),\n                        heat: get_i(h, 6) as f32 / 20.0,\n                        stage: get_i(h, 7) as u8,\n                        axis: uq(get_i(h, 8)),\n                        hidden: flags & 1 != 0,\n                        locked: flags & 2 != 0,\n                        required: flags & 4 != 0,\n                        tag: get_i(h, 10) as u8,\n                        ..Default::default()\n                    };\n                    if let Some(p) = h.get(11).and_then(|p| p.as_array()) {\n                        out.pts =\n                            p.chunks(2).map(|c| Vec2::new(uq(c[0].as_i64().unwrap_or(0)), uq(c[1].as_i64().unwrap_or(0)))).collect();\n                    }\n                    out\n                })\n                .collect()\n        })\n        .unwrap_or_default();\n    f.surgeons = v[\"c\"]\n        .as_array()\n        .map(|a| {\n            a.iter()\n                .enumerate()\n                .map(|(i, c)| {\n                    let flags = get_i(c, 0);\n                    let at = Vec2::new(uq(get_i(c, 1)), uq(get_i(c, 2)));\n                    let mut s = SurgeonView {\n                        slot: i as u8,\n                        present: flags & 1 != 0,\n                        using: flags & 2 != 0,\n                        gift_ready: flags & 4 != 0,\n                        bot: flags & 8 != 0,\n                        cursor: at,\n                        raw: at,\n                        tool: Tool::ALL.get(get_i(c, 3) as usize).copied().unwrap_or_default(),\n                        score: get_i(c, 4) as i32,\n                        chain: get_i(c, 5) as u32,\n                        gift: get_i(c, 6) as f32,\n                        gift_kind: get_i(c, 7) as u8,\n                        ..Default::default()\n                    };\n                    s.flow = 1.0;\n                    s\n                })\n                .collect()\n        })\n        .unwrap_or_default();\n    f\n}\n\nfn tool_from_debug(s: &str) -> Option<Tool> {\n    Tool::ALL.iter().copied().find(|t| format!(\"{t:?}\") == s)\n}\n\n/// A client's hands, as sent to the host.\npub fn encode_input(i: &SurgeonInput, tool_serial: u32) -> Value {\n    json!([q(i.aim.x), q(i.aim.y), i.held, i.tool, (i.pressure * 20.0) as i32, i.rotate, tool_serial])\n}\n\n/// A client's hands, as the host reads them.\npub fn decode_input(v: &Value) -> SurgeonInput {\n    SurgeonInput {\n        active: true,\n        aim: Vec2::new(uq(get_i(v, 0)), uq(get_i(v, 1))),\n        held: get_i(v, 2) as u8,\n        pressed: 0,\n        tool: get_i(v, 3) as i8,\n        pressure: get_i(v, 4) as f32 / 20.0,\n        assist: 0.5,\n        rotate: get_i(v, 5) as i8,\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/content.rs'\ns=open(p).read()\ns=s.replace('''    (\"level.toml\", include_str!(\"content/level.toml\")),\n];''','''    (\"level.toml\", include_str!(\"content/level.toml\")),\n    (\"callouts.toml\", include_str!(\"content/callouts.toml\")),\n];''')\ns=s.replace('''    pub level: String,\n}\n''','''    pub level: String,\n    /// In-op callouts by trigger.\n    pub callouts: BTreeMap<String, CalloutDef>,\n}\n\n/// A trigger's lines: `[speaker, line]`, one picked at random. `nurse` is whoever is calling it.\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct CalloutDef {\n    pub lines: Vec<Vec<String>>,\n}\n''',1)\ns=s.replace('''                _ => c.level = text.into_owned(),\n''','''                _ if path.starts_with(\"callouts\") => c.callouts = parse(path, &text)?,\n                _ => c.level = text.into_owned(),\n''')\ns=s.replace('''        for (key, story) in &self.stories {\n            for (i, l) in story.line.iter().enumerate() {''','''        for (key, c) in &self.callouts {\n            for l in &c.lines {\n                if l.len() != 2 || l[1].trim().is_empty() {\n                    bad.push(format!(\"callouts {key}: each line is [speaker, text]\"));\n                } else if l[0] != \"nurse\" {\n                    speaker(&l[0], &mut bad, &format!(\"callouts {key}\"));\n                }\n            }\n        }\n        for (key, story) in &self.stories {\n            for (i, l) in story.line.iter().enumerate() {''')\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write the game struct, director, story player, bot and network snapshot"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28999,"cache_read_input_tokens":332865,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28999},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"1dfec9d8-ad6d-445d-9aad-ffa66039250d","timestamp":"2026-11-05T13:52:49.251Z","request_id":"req_011CgjtLUmpoH5UNGMREgTtd","wire_tool_inputs":{"toolu_01278KxMrxpoSUgi6Q2AB2Sc":{"command":"cat > crates/pav_core/src/games/surgery/mod.rs <<'EOF'\n//! The surgery game: a surgeon's-eye arcade of eight instruments, framed by a paper-theatre\n//! melodrama. Cases and story live in one phase machine, so `surgery/campaign` with the bot is the\n//! scripted playthrough of the whole game. `content/README.md` is the designer's guide.\n\npub mod bot;\npub mod content;\npub mod cue;\npub mod director;\npub mod field;\npub mod frame;\npub mod heart;\npub mod net;\npub mod paper;\npub mod story;\npub mod strain;\npub mod surgeon;\npub mod tune;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::content::{CODE_BLUE, CaseDef};\nuse self::field::{Counters, GhostHand, Hazard, Popup, Stain, Surgeon, Tool};\nuse self::frame::*;\nuse self::heart::Heart;\nuse self::story::StoryState;\nuse self::strain::Strain;\nuse self::tune::Tune;\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, SurgeryCmd, hands};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\n/// The run this scene plays.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Campaign,\n    Case,\n    CodeBlue,\n    Attract,\n    Card,\n    Mirror,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Cheats {\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub time_scale: f32,\n    pub overlays: u32,\n}\n\n/// The gifts in effect.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Gifts {\n    /// Heartbeats of the Hush left.\n    pub hush_beats: f32,\n    /// Seconds of the Echo left.\n    pub echo_t: f32,\n    pub hush_fx: f32,\n    pub echo_fx: f32,\n    /// Lines the Echo says once.\n    pub echo_said: bool,\n    pub duet: bool,\n}\n\n/// A heart stopped, and the seconds to do something about it.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CodeState {\n    pub left: f32,\n    pub window: f32,\n    pub ghost: f32,\n    pub shocks: u8,\n    pub scripted: bool,\n    pub flash: f32,\n}\n\n/// Everything about the operation in progress: one clone of this is a checkpoint.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Op {\n    pub case: u8,\n    pub phase: u8,\n    pub phase_t: f32,\n    pub phase_beats: u32,\n    /// Bits of the phase's events that have fired.\n    pub fired: u64,\n    pub clock: f32,\n    pub vitals: f32,\n    pub vitals_max: f32,\n    pub timer: f32,\n    pub timer_total: f32,\n    pub hazards: Vec<Hazard>,\n    pub next_id: u32,\n    pub stains: Vec<Stain>,\n    pub popups: Vec<Popup>,\n    pub pings: Vec<(Vec2, f32)>,\n    pub ghosts: Vec<GhostHand>,\n    pub ring: [Tool; 8],\n    pub forced_tool: Option<Tool>,\n    pub counters: Counters,\n    pub mistakes: u32,\n    pub incisions_done: u32,\n    pub strain: Option<Strain>,\n    pub strain_tough: f32,\n    pub grace_beats: f32,\n    pub fever_start: f32,\n    pub embers_merged: bool,\n    pub drain_now: f32,\n    pub drain_scale: f32,\n    pub overdose: f32,\n    pub since_callout: f32,\n    pub gift_awake: bool,\n    pub shake: f32,\n    pub push: f32,\n    pub push_at: Vec2,\n    pub plate: Arc<str>,\n    pub prev_plate: Option<Arc<str>>,\n    pub plate_blend: f32,\n    pub plate_from: Vec2,\n    pub objective: Arc<str>,\n    pub subtitle: Option<Subtitle>,\n    pub subtitle_serial: u32,\n    pub banner: Option<(Arc<str>, f32)>,\n    pub codes_left: u8,\n    pub code: Option<CodeState>,\n    pub critical: bool,\n    pub said_forty: bool,\n    pub director: Option<director::Director>,\n    pub guided: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Checkpoint {\n    pub op: Op,\n    pub surgeons: [Surgeon; 4],\n    pub heart: Heart,\n    pub gifts: Gifts,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub tick: u64,\n    pub outcome: Outcome,\n    pub tune: Tune,\n    pub diff: u8,\n    pub cheats: Cheats,\n    pub heart: Heart,\n    pub gifts: Gifts,\n    pub op: Op,\n    pub checkpoint: Option<Box<Checkpoint>>,\n    pub start_case_cp: Option<Box<Checkpoint>>,\n    pub surgeons: [Surgeon; 4],\n    /// Slots a person is at.\n    pub humans: [bool; 4],\n    pub last_held: [u8; 4],\n    pub story: StoryState,\n    pub results: Option<ResultsView>,\n    pub death: Option<DeathView>,\n    /// The bot's skill, 0..1 (`Game::bot`, the partner, attract).\n    pub bot_skill: f32,\n    pub seed: u32,\n    pub text_cps: f32,\n    pub tremor_setting: bool,\n    pub coverage: Counters,\n    pub attract_seg: u8,\n    pub attract_t: f32,\n    /// The whole run's score and cases won, for tests.\n    pub run_score: i32,\n    pub cases_won: u32,\n    pub shot: CameraShot,\n    /// A client's frame, from the host.\n    #[serde(skip)]\n    pub mirror_frame: Option<Arc<SurgeryFrame>>,\n}\n\n/// A mirror's or tools' starting point.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let content = content::get();\n    let def = RoomDef::parse(&content.level).map_err(|e| anyhow!(\"content/level.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, Surgery::KEY, def);\n    // No hero here: the surgeons are slots. The camera is the game's.\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n    }\n    sim.state.focus = glam::Vec3::new(0.0, 0.0, 0.2);\n    let seed = (sim.state.rng.below(1 << 30) as u32) | 1;\n    let mut g = Surgery::new(seed);\n    let rest = rest.unwrap_or(\"campaign\");\n    let (first, arg) = rest.split_once('/').unwrap_or((rest, \"\"));\n    let mut sink = Vec::new();\n    match first {\n        \"title\" => g.begin_title(),\n        \"campaign\" => {\n            g.mode = Mode::Campaign;\n            let from: u8 = arg.parse().unwrap_or(0);\n            g.begin_campaign_case(from, &mut sink);\n        }\n        \"case\" => {\n            g.mode = Mode::Case;\n            let n: u8 = arg.parse().map_err(|_| anyhow!(\"surgery/case/<n>: n is a case number, got '{arg}'\"))?;\n            if content.case(n).is_none() {\n                return Err(anyhow!(\"no case {n}: there are {} cases\", content.cases.len()));\n            }\n            g.begin_case(n);\n        }\n        \"codeblue\" => {\n            g.mode = Mode::CodeBlue;\n            g.begin_case(CODE_BLUE);\n        }\n        \"attract\" => {\n            g.mode = Mode::Attract;\n            g.attract_next(&mut sink);\n        }\n        \"card\" => {\n            g.mode = Mode::Card;\n            g.begin_title();\n            g.mode = Mode::Card;\n            g.stage = Stage::Card;\n            g.op.plate = \"torso\".into();\n        }\n        \"mirror\" => {\n            g.mode = Mode::Mirror;\n            g.begin_title();\n            g.mode = Mode::Mirror;\n            g.op.plate = \"torso\".into();\n        }\n        o => return Err(anyhow!(\"unknown surgery scene '{o}' (campaign, case/<n>, codeblue, attract, title, card, mirror)\")),\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl Surgery {\n    pub fn new(seed: u32) -> Self {\n        let mut surgeons: [Surgeon; 4] = Default::default();\n        surgeons[0].present = true;\n        for s in &mut surgeons {\n            s.flow = 1.0;\n        }\n        Self {\n            mode: Mode::Title,\n            stage: Stage::Title,\n            stage_t: 0.0,\n            tick: 0,\n            outcome: Outcome::Playing,\n            tune: Tune::default(),\n            diff: 1,\n            cheats: Cheats { time_scale: 1.0, ..Default::default() },\n            heart: Heart::default(),\n            gifts: Gifts::default(),\n            op: Op::default(),\n            checkpoint: None,\n            start_case_cp: None,\n            surgeons,\n            humans: [true, false, false, false],\n            last_held: [0; 4],\n            story: StoryState::default(),\n            results: None,\n            death: None,\n            bot_skill: 1.0,\n            seed,\n            text_cps: 45.0,\n            tremor_setting: true,\n            coverage: Counters::default(),\n            attract_seg: 0,\n            attract_t: 0.0,\n            run_score: 0,\n            cases_won: 0,\n            shot: CameraShot::FIELD,\n            mirror_frame: None,\n        }\n    }\n\n    /// A number in 0..1 from the game's own seeded stream.\n    pub fn rand(&mut self) -> f32 {\n        let mut x = self.seed;\n        x ^= x << 13;\n        x ^= x >> 17;\n        x ^= x << 5;\n        self.seed = x;\n        (x >> 8) as f32 / (1u32 << 24) as f32\n    }\n\n    pub fn difficulty(&self) -> tune::Difficulty {\n        tune::DIFFICULTIES[(self.diff as usize).min(2)]\n    }\n\n    pub fn case_def(&self) -> Option<CaseDef> {\n        content::get().case(self.op.case).cloned()\n    }\n\n    pub fn begin_title(&mut self) {\n        self.mode = Mode::Title;\n        self.stage = Stage::Title;\n        self.op = Op { plate: \"heart\".into(), vitals: 100.0, vitals_max: 100.0, drain_scale: 1.0, ..Default::default() };\n        self.shot = CameraShot::FIELD;\n    }\n\n    fn set_stage(&mut self, s: Stage) {\n        self.stage = s;\n        self.stage_t = 0.0;\n    }\n\n    /// Clears the table and reads the case in. The chart comes next.\n    pub fn begin_case(&mut self, n: u8) {\n        let content = content::get();\n        let Some(case) = content.case(n) else { return };\n        let ring = {\n            let mut r = [Tool::Scalpel; 8];\n            for (i, t) in case.ring.iter().enumerate().take(8) {\n                r[i] = Tool::parse(t).unwrap_or(Tool::Scalpel);\n            }\n            r\n        };\n        let d = self.difficulty();\n        let total = case.timer * d.timer * self.tune.get(tune::TIMER);\n        self.op = Op {\n            case: n,\n            vitals: case.vitals,\n            vitals_max: case.vitals.max(100.0),\n            timer: total,\n            timer_total: total,\n            ring,\n            plate: case.plate.as_str().into(),\n            plate_blend: 1.0,\n            drain_scale: 1.0,\n            strain_tough: self.tune.get(tune::STRAIN_TOUGH),\n            grace_beats: 1.0,\n            gift_awake: case.gift,\n            codes_left: d.codes,\n            next_id: 1,\n            guided: case.guided,\n            fever_start: 20.0,\n            ..Default::default()\n        };\n        let default_tool = ring[1];\n        let both = case.surgeon == \"both\";\n        for i in 0..4 {\n            let s = &mut self.surgeons[i];\n            let (present, bot, cursor) = (s.present, s.bot, s.raw);\n            *s = Surgeon { present, bot, cursor, raw: cursor, tool: default_tool, flow: 1.0, ..Default::default() };\n            s.gift = if self.cheats.full_gift { 100.0 } else { 0.0 };\n        }\n        if self.mode != Mode::Attract {\n            for i in 0..4 {\n                self.surgeons[i].bot = false;\n                self.surgeons[i].present = self.humans[i];\n            }\n            if both && !self.humans[1] {\n                self.surgeons[1].bot = true;\n                self.surgeons[1].present = true;\n            }\n        }\n        self.heart = Heart::default();\n        self.gifts = Gifts::default();\n        self.checkpoint = None;\n        self.start_case_cp = None;\n        self.results = None;\n        self.death = None;\n        self.outcome = Outcome::Playing;\n        self.shot = CameraShot::FIELD;\n        self.set_stage(Stage::Chart);\n    }\n\n    /// A campaign case: its story first.\n    pub fn begin_campaign_case(&mut self, n: u8, events: &mut Vec<SimEvent>) {\n        self.begin_case(n);\n        let before = content::get().case(n).map(|c| c.before.clone()).unwrap_or_default();\n        if !before.is_empty() {\n            self.begin_story(&before, events);\n        }\n    }\n\n    /// Spawns the case's first phase behind the banner.\n    fn start_operation(&mut self, events: &mut Vec<SimEvent>) {\n        self.set_stage(Stage::OpStart);\n        self.op.banner = Some((\"OPERATION START\".into(), 0.0));\n        self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        self.begin_phase(0, events);\n        self.start_case_cp = Some(Box::new(self.snapshot()));\n    }\n\n    fn snapshot(&self) -> Checkpoint {\n        Checkpoint { op: self.op.clone(), surgeons: self.surgeons.clone(), heart: self.heart.clone(), gifts: self.gifts.clone() }\n    }\n\n    fn restore(&mut self, cp: &Checkpoint) {\n        let counters = std::mem::take(&mut self.op.counters);\n        self.op = cp.op.clone();\n        self.op.counters = counters;\n        self.surgeons = cp.surgeons.clone();\n        self.heart = cp.heart.clone();\n        self.gifts = cp.gifts.clone();\n    }\n\n    /// Who speaks in this operation when \"nurse\" is called for: Bashir, unless he is the patient.\n    fn nurse(&self) -> &'static str {\n        if self.op.case == 7 { \"teddy\" } else { \"bashir\" }\n    }\n\n    /// An in-op line.\n    pub fn say(&mut self, who: &str, text: &str) {\n        let who = if who == \"nurse\" { self.nurse() } else { who };\n        self.op.subtitle_serial += 1;\n        self.op.subtitle = Some(Subtitle { who: who.into(), text: text.into(), age: 0.0, serial: self.op.subtitle_serial });\n        self.op.since_callout = 0.0;\n    }\n\n    /// A callout from the data, if the last line has had its time.\n    pub fn callout(&mut self, key: &str) {\n        let urgent = matches!(key, \"wrong_tool\" | \"healthy\" | \"lift_off\" | \"vitals_forty\" | \"code\");\n        if !urgent && self.op.since_callout < 2.5 {\n            return;\n        }\n        self.say_short(key);\n    }\n\n    /// A callout from the data, now.\n    pub fn say_short(&mut self, key: &str) {\n        let content = content::get();\n        let Some(lines) = content.callouts.get(key) else { return };\n        if lines.lines.is_empty() {\n            return;\n        }\n        let i = (self.rand() * lines.lines.len() as f32) as usize % lines.lines.len();\n        let (who, text) = (lines.lines[i][0].clone(), lines.lines[i][1].clone());\n        self.say(&who, &text);\n    }\n\n    pub fn set_plate(&mut self, name: &str, from: Vec2) {\n        self.op.prev_plate = Some(self.op.plate.clone());\n        self.op.plate = name.into();\n        self.op.plate_blend = 0.0;\n        self.op.plate_from = from;\n        self.op.counters.bump(&format!(\"plate_{name}\"));\n    }\n\n    /// The gift wakes: the meter fills and the prompt appears.\n    pub fn wake_gift(&mut self, events: &mut Vec<SimEvent>) {\n        if self.op.gift_awake {\n            return;\n        }\n        self.op.gift_awake = true;\n        for s in &mut self.surgeons {\n            s.gift = 100.0;\n        }\n        self.op.counters.bump(\"gift_woke\");\n        let case = self.op.case;\n        if case == 5 {\n            self.say(\"pet\", \"Hm. There you are, you old fool.\");\n        } else {\n            self.say(\"bashir\", \"Doctor... your hands.\");\n        }\n        self.cue_at(events, cue::GIFT_READY, Vec2::ZERO);\n    }\n\n    /// 0 Hush, 1 Echo.\n    pub fn gift_kind(&self, slot: usize) -> u8 {\n        if self.op.case == CODE_BLUE {\n            return (slot % 2) as u8;\n        }\n        match self.case_surgeon().as_str() {\n            \"pet\" => 1,\n            \"both\" => (slot % 2) as u8,\n            _ => 0,\n        }\n    }\n\n    fn case_surgeon(&self) -> String {\n        content::get().case(self.op.case).map(|c| c.surgeon.clone()).unwrap_or_default()\n    }\n\n    /// Does this slot's hand shake right now?\n    pub fn tremor_for(&self, slot: usize) -> bool {\n        self.tremor_setting\n            && self.gifts.echo_t <= 0.0\n            && self.gift_kind(slot) == 1\n            && content::get().case(self.op.case).is_some_and(|c| c.tremor)\n    }\n\n    fn gift_input(&mut self, slot: usize, inp: &SurgeonInput, events: &mut Vec<SimEvent>) {\n        if !self.op.gift_awake {\n            return;\n        }\n        let window = self.tune.get(tune::BEAT_WINDOW) * 1.8;\n        let ready = self.surgeons[slot].gift >= 100.0 || self.cheats.full_gift;\n        let down = inp.held & hands::GIFT != 0;\n        let s = &mut self.surgeons[slot];\n        if down && !s.gift_hold && ready {\n            s.gift_hold = true;\n            let at = s.cursor;\n            self.cue_at(events, cue::TICK, at);\n        } else if !down && s.gift_hold {\n            s.gift_hold = false;\n            if self.heart.on_beat(window) {\n                self.fire_gift(slot, events);\n            } else {\n                self.op.counters.bump(\"gift_missed\");\n            }\n        }\n    }\n\n    pub fn fire_gift(&mut self, slot: usize, events: &mut Vec<SimEvent>) {\n        let kind = self.gift_kind(slot);\n        let duration = self.tune.get(tune::GIFT_TIME);\n        let both = self.case_surgeon() == \"both\" && !self.humans[1];\n        self.surgeons[slot].gift = 0.0;\n        let at = self.surgeons[slot].cursor;\n        if kind == 0 || both {\n            self.gifts.hush_beats = 6.0 * duration;\n            self.op.counters.bump(\"hush\");\n        }\n        if kind == 1 || both {\n            self.gifts.echo_t = self.tune.get(tune::ECHO_TIME) * duration;\n            self.op.counters.bump(\"echo\");\n            if !self.gifts.echo_said && !both {\n                self.gifts.echo_said = true;\n                self.say(\"pet\", \"There. Steady as a girl of thirty. Don't tell anyone.\");\n            }\n        }\n        if both {\n            self.gifts.duet = true;\n            self.op.counters.bump(\"duet\");\n            self.say(\"pet\", \"Together, then, you frightened child. Hear it?\");\n        }\n        self.op.shake = self.op.shake.max(0.5);\n        self.cue_at(events, cue::GIFT_FIRE, at);\n    }\n\n    /// The heart stops.\n    pub fn start_code(&mut self, scripted: bool, shocks: u8) {\n        let window = self.tune.get(tune::CODE_WINDOW) * if scripted { 3.0 } else { 1.0 };\n        self.op.code = Some(CodeState { left: window, window, ghost: 0.0, shocks: shocks.max(1), scripted, flash: 0.0 });\n        self.heart.stopped = true;\n        self.op.banner = Some((\"CODE\".into(), 0.0));\n        self.set_stage(Stage::Code);\n        for i in 0..4 {\n            self.release(i);\n        }\n        self.op.forced_tool = None;\n        self.op.counters.bump(if scripted { \"code_scripted\" } else { \"code\" });\n    }\n\n    fn code_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut c) = self.op.code.take() else {\n            self.set_stage(Stage::Op);\n            return;\n        };\n        self.op.clock += dt;\n        c.left -= dt;\n        c.ghost = (c.ghost + dt / 1.1) % 1.0;\n        c.flash = (c.flash - dt * 3.0).max(0.0);\n        self.heart.tick(dt, self.op.vitals, 1.0);\n        if self.stage_t < dt * 1.5 {\n            self.cue_at(events, cue::FLATLINE, Vec2::ZERO);\n            self.callout(\"code\");\n        }\n        let mut success = None;\n        let mut cheat_win = false;\n        for slot in 0..4 {\n            let inp = if self.surgeons[slot].bot { self.bot_input(slot, self.bot_skill) } else { input.surgeons[slot] };\n            if !inp.active && !self.surgeons[slot].bot {\n                continue;\n            }\n            self.surgeons[slot].raw = inp.aim;\n            self.surgeons[slot].cursor = inp.aim;\n            let down = inp.held & hands::DEFIB != 0;\n            let s = &mut self.surgeons[slot];\n            if down {\n                if !s.charging {\n                    s.charging = true;\n                    s.charge = 0.0;\n                    self.cue_at(events, cue::DEFIB_WHINE, Vec2::ZERO);\n                }\n                let s = &mut self.surgeons[slot];\n                s.charge = (s.charge + dt / 1.2).min(1.0);\n            } else if s.charging {\n                s.charging = false;\n                let charge = s.charge;\n                s.charge = 0.0;\n                let off = (c.ghost - 0.5).abs() * 1.1;\n                if charge >= 1.0 && off <= 0.14 {\n                    success = Some((slot, off));\n                } else {\n                    self.cue_at(events, cue::SLOPPY, Vec2::ZERO);\n                    self.op.counters.bump(\"defib_miss\");\n                    self.callout(\"defib_miss\");\n                }\n            }\n        }\n        if self.cheats.immortal && c.left < 0.3 {\n            cheat_win = true;\n        }\n        if let Some((slot, off)) = success {\n            c.shocks -= 1;\n            c.flash = 1.0;\n            self.cue_at(events, cue::DEFIB_THUMP, Vec2::ZERO);\n            self.op.shake = 1.0;\n            self.op.counters.used(Tool::Defib);\n            let rating = field::Rating::from_error(off, [0.05, 0.1, 0.14], 1.0);\n            self.award(slot, rating, Tool::Defib, Vec2::ZERO, false, events);\n            if c.shocks > 0 {\n                c.left = c.window;\n                self.say_short(\"next_shock\");\n                self.op.code = Some(c);\n                return;\n            }\n        }\n        if success.is_some() || cheat_win {\n            if !c.scripted && !self.cheats.immortal {\n                self.op.codes_left = self.op.codes_left.saturating_sub(1);\n            }\n            self.op.vitals = self.op.vitals.max(30.0);\n            self.heart.stopped = false;\n            self.heart.phase = 0.0;\n            self.heart.since_r = 0.0;\n            self.op.banner = None;\n            self.set_stage(Stage::Op);\n            self.say_short(\"code_back\");\n            return;\n        }\n        if c.left <= 0.0 {\n            if c.scripted && self.op.case <= 2 {\n                // The teaching stop keeps waiting for the lesson.\n                c.left = c.window;\n                self.say_short(\"code_again\");\n            } else {\n                self.die(events);\n                return;\n            }\n        }\n        self.op.code = Some(c);\n    }\n\n    fn die(&mut self, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let case = content.case(self.op.case);\n        let minutes = (self.op.clock as u32) % 60;\n        self.death = Some(DeathView {\n            time: format!(\"03:{minutes:02}\").into(),\n            patient: case.map(|c| c.patient.as_str()).unwrap_or(\"\").into(),\n            fate: case.map(|c| c.fate_lost.as_str()).unwrap_or(\"\").into(),\n            checkpoint: self.checkpoint.is_some(),\n            t: 0.0,\n        });\n        self.heart.stopped = true;\n        self.op.code = None;\n        self.outcome = Outcome::Lost;\n        self.set_stage(Stage::Dead);\n        self.op.counters.bump(\"death\");\n        self.cue_at(events, cue::FLATLINE, Vec2::ZERO);\n    }\n\n    fn complete(&mut self, events: &mut Vec<SimEvent>) {\n        self.set_stage(Stage::Complete);\n        self.op.banner = Some((if self.mode == Mode::CodeBlue { \"PATIENT STABLE\".into() } else { \"OPERATION COMPLETE\".into() }, 0.0));\n        self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        for i in 0..4 {\n            self.release(i);\n        }\n        self.op.forced_tool = None;\n        self.op.counters.bump(\"complete\");\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let action: i32 = self.surgeons.iter().map(|s| s.score).sum();\n        let vitals_bonus = (self.op.vitals.max(0.0) * 20.0) as i32;\n        let time_bonus = (self.op.timer.max(0.0) * 5.0) as i32;\n        let penalty = self.op.mistakes as i32 * 100;\n        let total = action + vitals_bonus + time_bonus - penalty;\n        let par = (case.par * self.tune.get(tune::SCORE)).max(1.0);\n        let rank = rank_for(total as f32 / par);\n        let mut counts = [0; 4];\n        for s in &self.surgeons {\n            for i in 0..4 {\n                counts[i] += s.counts[i];\n            }\n        }\n        let scores =\n            self.surgeons.iter().enumerate().filter(|(_, s)| s.present).map(|(i, s)| (i as u8, s.score)).collect::<Vec<_>>();\n        self.run_score += total;\n        self.results = Some(ResultsView {\n            case_no: self.op.case,\n            case_name: case.name.as_str().into(),\n            patient: case.patient.as_str().into(),\n            fate: case.fate.as_str().into(),\n            action_points: action,\n            vitals_bonus,\n            time_bonus,\n            mistakes: self.op.mistakes,\n            mistake_penalty: penalty,\n            total,\n            par: par as i32,\n            rank: rank.into(),\n            counts,\n            best_chain: self.surgeons.iter().map(|s| s.best_chain).max().unwrap_or(0),\n            scores,\n            t: 0.0,\n            won: true,\n        });\n    }\n\n    /// Goes on from a finished results screen.\n    fn after_results(&mut self, events: &mut Vec<SimEvent>) {\n        self.cases_won += 1;\n        let counters = std::mem::take(&mut self.op.counters);\n        self.coverage.add(&counters);\n        match self.mode {\n            Mode::Campaign => {\n                let after = content::get().case(self.op.case).map(|c| c.after.clone()).unwrap_or_default();\n                if !after.is_empty() {\n                    self.begin_story(&after, events);\n                } else {\n                    self.next_campaign_case(events);\n                }\n            }\n            _ => {\n                self.outcome = Outcome::Won;\n                self.set_stage(Stage::Finished);\n            }\n        }\n    }\n\n    pub(crate) fn next_campaign_case(&mut self, events: &mut Vec<SimEvent>) {\n        let next = self.op.case + 1;\n        if (next as usize) < content::CASES {\n            self.begin_campaign_case(next, events);\n        } else {\n            self.outcome = Outcome::Won;\n            self.set_stage(Stage::Finished);\n        }\n    }\n\n    fn op_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let hush = self.gifts.hush_beats > 0.0;\n        let scale = if hush { self.tune.get(tune::HUSH_SCALE) } else { 1.0 } * self.cheats.time_scale.max(0.01);\n        let rule = dt * scale;\n        self.op.clock += rule;\n        self.op.since_callout += dt;\n        let coupling = self.tune.get(tune::COUPLING);\n        let beat = self.heart.tick(rule, self.op.vitals.max(0.0), coupling);\n        if beat {\n            self.op.phase_beats += 1;\n            self.cue_at(events, cue::LUB, Vec2::ZERO);\n            if hush {\n                self.gifts.hush_beats -= 1.0;\n            }\n        }\n        self.gifts.echo_t = (self.gifts.echo_t - rule).max(0.0);\n        let hush_target = if self.gifts.hush_beats > 0.0 { 1.0 } else { 0.0 };\n        self.gifts.hush_fx += (hush_target - self.gifts.hush_fx) * (1.0 - (-dt * 6.0).exp());\n        let echo_target = if self.gifts.echo_t > 0.0 { 1.0 } else { 0.0 };\n        self.gifts.echo_fx += (echo_target - self.gifts.echo_fx) * (1.0 - (-dt * 6.0).exp());\n        if self.gifts.hush_beats <= 0.0 && self.gifts.echo_t <= 0.0 {\n            self.gifts.duet = false;\n        }\n\n        let strict_players = self.stage == Stage::Op;\n        for slot in 0..4 {\n            let inp = if self.surgeons[slot].bot { self.bot_input(slot, self.bot_skill) } else { input.surgeons[slot] };\n            if inp.active && !self.surgeons[slot].bot {\n                self.humans[slot] = true;\n                self.surgeons[slot].present = true;\n            }\n            if !self.surgeons[slot].present {\n                continue;\n            }\n            if !(inp.active || self.surgeons[slot].bot) {\n                // Nobody is at this slot this tick: hands off.\n                self.last_held[slot] = 0;\n                self.surgeons[slot].using = false;\n                if self.surgeons[slot].engaged != 0 {\n                    self.release(slot);\n                }\n                continue;\n            }\n            self.hands(slot, &inp, rule, dt, events);\n            self.gift_input(slot, &inp, events);\n            self.last_held[slot] = inp.held;\n        }\n        self.ghosts_tick(dt, events);\n        self.hazards_tick(rule, events);\n        self.strain_tick(rule, beat, events);\n        if !strict_players {\n            return;\n        }\n        self.phase_tick(rule, events);\n        if self.stage != Stage::Op {\n            return;\n        }\n        // The clock and the patient.\n        if !self.cheats.freeze_timer {\n            self.op.timer -= rule;\n        }\n        for s in &mut self.surgeons {\n            if s.chain > 0 {\n                s.chain_t -= dt;\n                if s.chain_t <= 0.0 {\n                    s.chain = 0;\n                }\n            }\n        }\n        if self.cheats.full_gift {\n            for s in &mut self.surgeons {\n                s.gift = 100.0;\n            }\n        }\n        let v = self.op.vitals;\n        if v < 40.0 && !self.op.said_forty {\n            self.op.said_forty = true;\n            self.say_short(\"vitals_forty\");\n        }\n        if v > 55.0 {\n            self.op.said_forty = false;\n            self.op.critical = false;\n        }\n        if v < 25.0 && !self.op.critical {\n            self.op.critical = true;\n            self.op.banner = Some((\"VITALS CRITICAL\".into(), 0.0));\n            self.cue_at(events, cue::ALARM, Vec2::ZERO);\n        }\n        if self.op.vitals <= 0.0 {\n            self.op.vitals = 0.0;\n            if self.cheats.immortal {\n                self.op.vitals = 1.0;\n            } else if self.op.codes_left > 0 {\n                self.start_code(false, 1);\n            } else {\n                self.die(events);\n            }\n            return;\n        }\n        if self.op.timer <= 0.0 {\n            if self.mode == Mode::CodeBlue || self.op.case == CODE_BLUE {\n                // Alive at the end: the team wins.\n                self.complete(events);\n            } else {\n                self.say_short(\"time_up\");\n                self.die(events);\n            }\n        }\n    }\n\n    fn apply(&mut self, cmd: SurgeryCmd, events: &mut Vec<SimEvent>) {\n        match cmd {\n            SurgeryCmd::Advance => match self.stage {\n                Stage::Story => self.story_advance(events),\n                Stage::Chart => self.start_operation(events),\n                Stage::Results => {\n                    if self.results.as_ref().is_some_and(|r| r.t > 0.05) {\n                        self.after_results(events);\n                    }\n                }\n                _ => {}\n            },\n            SurgeryCmd::SkipScene => {\n                if self.stage == Stage::Story {\n                    self.story_skip(events);\n                }\n            }\n            SurgeryCmd::Retry { from_start } => {\n                if self.stage == Stage::Dead {\n                    let cp = if from_start { self.start_case_cp.clone() } else { self.checkpoint.clone().or(self.start_case_cp.clone()) };\n                    if let Some(cp) = cp {\n                        self.restore(&cp);\n                        self.outcome = Outcome::Playing;\n                        self.death = None;\n                        self.heart.stopped = false;\n                        self.set_stage(Stage::OpStart);\n                        self.op.banner = Some((\"OPERATION START\".into(), 0.0));\n                        self.op.counters.bump(\"retry\");\n                    }\n                }\n            }\n            SurgeryCmd::SetTune { id, value } => self.tune.set(id as usize, value),\n            SurgeryCmd::ResetTune => self.tune = Tune::default(),\n            SurgeryCmd::Cheat { id, value } => self.cheat(id, value, events),\n            SurgeryCmd::Jump { case, phase } => {\n                self.begin_case(case);\n                self.start_operation(events);\n                self.jump_phase(phase, events);\n            }\n            SurgeryCmd::Spawn { kind, x, z } => {\n                let k = field::HazardKind::ALL.get(kind as usize).copied().unwrap_or(field::HazardKind::Foreign);\n                self.spawn_kind(k, Vec2::new(x, z));\n            }\n            SurgeryCmd::Join { slot } => {\n                if let Some(h) = self.humans.get_mut(slot as usize) {\n                    *h = true;\n                    self.surgeons[slot as usize].present = true;\n                    self.surgeons[slot as usize].bot = false;\n                }\n            }\n            SurgeryCmd::Difficulty(d) => self.diff = d.min(2),\n            SurgeryCmd::TextSpeed(c) => self.text_cps = c.clamp(5.0, 400.0),\n            SurgeryCmd::Tremor(on) => self.tremor_setting = on,\n            SurgeryCmd::BotPlays { slot, on } => {\n                if let Some(s) = self.surgeons.get_mut(slot as usize) {\n                    s.bot = on;\n                    if on {\n                        s.present = true;\n                    }\n                }\n            }\n        }\n    }\n\n    fn cheat(&mut self, id: u16, value: f32, events: &mut Vec<SimEvent>) {\n        use tune::cheat as c;\n        let on = value != 0.0;\n        match id {\n            c::IMMORTAL => self.cheats.immortal = on,\n            c::FREEZE_TIMER => self.cheats.freeze_timer = on,\n            c::FULL_GIFT => {\n                self.cheats.full_gift = on;\n                if on {\n                    self.op.gift_awake = true;\n                }\n            }\n            c::ONE_HIT => self.cheats.one_hit = on,\n            c::TIME_SCALE => self.cheats.time_scale = value.clamp(0.05, 4.0),\n            c::SKIP_PHASE => {\n                if matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code) {\n                    self.heart.stopped = false;\n                    self.op.code = None;\n                    self.set_stage(Stage::Op);\n                    self.skip_phase(events);\n                }\n            }\n            c::WIN_CASE => {\n                if matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Chart | Stage::Dead) {\n                    self.heart.stopped = false;\n                    self.op.code = None;\n                    self.outcome = Outcome::Playing;\n                    self.death = None;\n                    self.op.hazards.clear();\n                    self.complete(events);\n                }\n            }\n            c::FORCE_CODE => {\n                if self.stage == Stage::Op {\n                    self.start_code(false, 1);\n                }\n            }\n            c::KILL_PATIENT => {\n                if matches!(self.stage, Stage::Op | Stage::Code) {\n                    self.die(events);\n                }\n            }\n            c::OVERLAYS => self.cheats.overlays = value as u32,\n            c::BOT_SKILL => self.bot_skill = value.clamp(0.0, 1.0),\n            _ => {}\n        }\n    }\n\n    /// Spawns one of a kind at a point (dev mode).\n    pub fn spawn_kind(&mut self, kind: field::HazardKind, at: Vec2) {\n        use field::HazardKind as K;\n        let d = Vec2::new(1.2, 0.3);\n        let mut h = Hazard { kind, pos: at, required: false, r: 0.0, ..Default::default() };\n        match kind {\n            K::Incision | K::Laceration | K::Closure | K::Tether => h.pts = vec![at - d, at + d],\n            K::Tendril => h.pts = vec![at - d * 2.0, at, at + d * 2.0],\n            K::Bone => {\n                h.to = at + Vec2::new(1.5, 0.0);\n                h.angle = 0.7;\n            }\n            K::Nodule => h.to = at,\n            K::Sac => h.to = at - Vec2::new(0.0, 1.0),\n            _ => {}\n        }\n        h.r = match kind {\n            K::Pool => 0.9,\n            K::Foreign => 0.3,\n            K::Polyp => 0.42,\n            K::Tumor => 1.1,\n            K::Burn => 0.8,\n            K::Bone => 0.8,\n            K::Nodule => 0.55,\n            K::Sac => 0.5,\n            K::Eye => 0.8,\n            K::Ember => 0.6,\n            K::Furnace => 1.7,\n            K::Crown => 1.2,\n            _ => 0.2,\n        };\n        self.add_hazard(h);\n    }\n\n    /// The whole game's next state, in a scene without a tick (dev reload).\n    pub fn frame(&self) -> SurgeryFrame {\n        if let Some(f) = &self.mirror_frame {\n            let mut f = (**f).clone();\n            f.mirror = true;\n            return f;\n        }\n        let op = &self.op;\n        let content = content::get();\n        let case = content.case(op.case);\n        let surgeons = self\n            .surgeons\n            .iter()\n            .enumerate()\n            .map(|(i, s)| {\n                let meter = self\n                    .hazard(s.engaged)\n                    .map(|h| match s.tool {\n                        Tool::Laser | Tool::Cryo => h.heat,\n                        Tool::Gel => h.progress,\n                        _ => h.progress,\n                    })\n                    .unwrap_or(0.0);\n                SurgeonView {\n                    slot: i as u8,\n                    present: s.present,\n                    bot: s.bot,\n                    cursor: s.cursor,\n                    raw: s.raw,\n                    tool: s.tool,\n                    engaged: s.engaged,\n                    using: s.using,\n                    pressure: s.pressure,\n                    score: s.score,\n                    chain: s.chain,\n                    gift: s.gift,\n                    gift_ready: op.gift_awake && s.gift >= 100.0,\n                    gift_hold: s.gift_hold,\n                    gift_kind: self.gift_kind(i),\n                    flow: s.flow,\n                    dose: s.dose,\n                    iv_cool: s.iv_cool,\n                    iv_on: s.iv_on,\n                    charge: s.charge,\n                    charging: s.charging,\n                    kick: s.kick,\n                    meter,\n                    name: self.slot_name(i).into(),\n                }\n            })\n            .collect();\n        let guide = if op.guided && self.stage == Stage::Op {\n            let tool = self.surgeons[0].tool;\n            op.hazards\n                .iter()\n                .filter(|h| h.required && !self.covered(h) && h.wants().is_some())\n                .min_by_key(|h| if h.accepts(tool) { 0 } else { 1 })\n                .map(|h| h.id)\n                .unwrap_or(0)\n        } else {\n            0\n        };\n        let code = op.code.as_ref().map(|c| CodeView {\n            left: c.left,\n            window: c.window,\n            ghost: c.ghost,\n            shocks: c.shocks,\n            scripted: c.scripted,\n        });\n        let story = (self.stage == Stage::Story).then(|| self.story.view(self.text_cps));\n        let chart = (self.stage == Stage::Chart).then(|| {\n            let c = case;\n            ChartView {\n                case_no: op.case,\n                case_name: c.map(|c| c.name.as_str()).unwrap_or(\"\").into(),\n                patient: c.map(|c| c.patient.as_str()).unwrap_or(\"\").into(),\n                life: c.map(|c| c.life.as_str()).unwrap_or(\"\").into(),\n                diagnosis: c.map(|c| c.diagnosis.as_str()).unwrap_or(\"\").into(),\n                surgeon: c.map(|c| c.surgeon.as_str()).unwrap_or(\"\").into(),\n                t: self.stage_t,\n            }\n        });\n        let results = self.results.clone().filter(|_| self.stage == Stage::Results).map(|mut r| {\n            r.t = self.stage_t;\n            r\n        });\n        let death = self.death.clone().filter(|_| self.stage == Stage::Dead).map(|mut d| {\n            d.t = self.stage_t;\n            d\n        });\n        let strain = op.strain.as_ref();\n        let in_op = matches!(self.stage, Stage::Op | Stage::OpStart | Stage::Code | Stage::Complete);\n        let crisis = if in_op { (1.0 - op.vitals / 55.0).clamp(0.0, 1.0) } else { 0.0 };\n        let track: Arc<str> = match self.stage {\n            Stage::Title | Stage::Card => \"title\".into(),\n            Stage::Story | Stage::Chart => {\n                if self.stage == Stage::Story {\n                    self.story.music.clone()\n                } else {\n                    \"tense\".into()\n                }\n            }\n            Stage::Op | Stage::OpStart | Stage::Complete => {\n                if op.case == CODE_BLUE {\n                    \"codeblue\".into()\n                } else {\n                    \"or\".into()\n                }\n            }\n            Stage::Results => \"results\".into(),\n            Stage::Code | Stage::Dead | Stage::Finished => \"\".into(),\n        };\n        let shot = if self.stage == Stage::Story && self.story.camera_or {\n            CameraShot::WIDE\n        } else if self.stage == Stage::Story {\n            CameraShot::PAPER\n        } else {\n            let mut s = CameraShot::FIELD;\n            let k = op.push.clamp(0.0, 1.0);\n            let k = k * k * (3.0 - 2.0 * k);\n            s.distance -= k * 3.2;\n            s.target[0] += op.push_at.x * k * 0.3;\n            s.target[2] += op.push_at.y * k * 0.3;\n            s\n        };\n        SurgeryFrame {\n            stage: self.stage,\n            tick: self.tick,\n            clock: op.clock,\n            shot,\n            case_no: op.case,\n            phase: op.phase,\n            phases: case.map(|c| c.phase.len() as u8).unwrap_or(0),\n            case_name: case.map(|c| c.name.as_str()).unwrap_or(\"\").into(),\n            attract: self.mode == Mode::Attract,\n            codeblue: op.case == CODE_BLUE,\n            mirror: self.mode == Mode::Mirror,\n            plate: op.plate.clone(),\n            prev_plate: op.prev_plate.clone(),\n            plate_blend: if op.prev_plate.is_some() { op.plate_blend } else { 1.0 },\n            plate_from: op.plate_from,\n            vitals: op.vitals,\n            vitals_max: op.vitals_max,\n            bpm: self.heart.bpm,\n            beat: self.heart.phase,\n            beats: self.heart.beats,\n            flat: self.heart.stopped || self.surgeons.iter().any(|s| s.gift_hold),\n            meter: self.heart.meter,\n            bar_beat: self.heart.bar_beat,\n            timer: op.timer,\n            timer_total: op.timer_total,\n            hazards: op.hazards.clone(),\n            stains: op.stains.clone(),\n            surgeons,\n            ring: op.ring,\n            forced_tool: op.forced_tool,\n            objective: op.objective.clone(),\n            guided: op.guided,\n            guide,\n            subtitle: op.subtitle.clone(),\n            popups: op.popups.clone(),\n            ghosts: op.ghosts.clone(),\n            pings: op.pings.clone(),\n            banner: op.banner.clone(),\n            hush: self.gifts.hush_fx,\n            echo: self.gifts.echo_fx,\n            gift_awake: op.gift_awake,\n            duet: self.gifts.duet,\n            fever: strain.and_then(|s| s.fever),\n            heat_ring: strain.and_then(|s| s.ring),\n            ring_in: strain\n                .filter(|s| s.rings > 0 && s.ring.is_none())\n                .map(|s| s.rings.saturating_sub(s.ring_beat).min(3) as u8)\n                .unwrap_or(0),\n            code,\n            story,\n            chart,\n            results,\n            death,\n            music: MusicView {\n                track,\n                crisis,\n                hush: self.gifts.hush_fx,\n                motif: if in_op && strain.is_some() { self.heart.meter } else { 0 },\n            },\n            shake: op.shake,\n            flash: op.code.as_ref().map(|c| c.flash).unwrap_or(0.0),\n            push: op.push,\n            push_at: op.push_at,\n            overlays: self.cheats.overlays,\n            tremor: self.tremor_for(0),\n        }\n    }\n\n    pub fn slot_name(&self, slot: usize) -> &'static str {\n        match self.case_surgeon().as_str() {\n            \"pet\" => [\"Pet\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            \"both\" => [\"Mara\", \"Pet\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            \"mara\" => [\"Mara\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n            _ => [\"Surgeon 1\", \"Surgeon 2\", \"Surgeon 3\", \"Surgeon 4\"][slot],\n        }\n    }\n}\n\npub fn rank_for(fraction: f32) -> &'static str {\n    if fraction >= 1.15 {\n        \"ENCORE\"\n    } else if fraction >= 1.0 {\n        \"S\"\n    } else if fraction >= 0.85 {\n        \"A\"\n    } else if fraction >= 0.7 {\n        \"B\"\n    } else {\n        \"C\"\n    }\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n\n    fn pre(&mut self, _sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        self.stage_t += dt;\n        if let Some(cmd) = input.surgery {\n            self.apply(cmd, events);\n        }\n        if let Some(b) = &mut self.op.banner {\n            b.1 += dt;\n            if b.1 > 2.6 {\n                self.op.banner = None;\n            }\n        }\n        if let Some(s) = &mut self.op.subtitle {\n            s.age += dt;\n            if s.age > 5.0 {\n                self.op.subtitle = None;\n            }\n        }\n        self.op.shake = (self.op.shake - dt * 2.2).max(0.0);\n        self.op.push = (self.op.push - dt * 0.35).max(0.0);\n        if self.op.plate_blend < 1.0 {\n            self.op.plate_blend = (self.op.plate_blend + dt / 0.8).min(1.0);\n        }\n        match self.stage {\n            Stage::Title | Stage::Card => {\n                self.op.clock += dt;\n                self.heart.tick(dt, 100.0, 1.0);\n            }\n            Stage::Story => self.story_tick(dt, events),\n            Stage::Chart => {\n                self.op.clock += dt;\n                self.heart.tick(dt, 100.0, 1.0);\n            }\n            Stage::OpStart => {\n                self.op.clock += dt;\n                self.heart.tick(dt, self.op.vitals, 1.0);\n                if self.stage_t > 1.7 {\n                    self.set_stage(Stage::Op);\n                }\n            }\n            Stage::Op => self.op_tick(input, dt, events),\n            Stage::Code => self.code_tick(input, dt, events),\n            Stage::Complete => {\n                self.op.clock += dt;\n                self.heart.tick(dt, self.op.vitals, 1.0);\n                if self.stage_t > 2.2 {\n                    self.set_stage(Stage::Results);\n                    self.cue_at(events, cue::STAMP, Vec2::ZERO);\n                }\n            }\n            Stage::Results => {\n                if let Some(r) = &mut self.results {\n                    r.t += dt;\n                }\n            }\n            Stage::Dead | Stage::Finished => {}\n        }\n        if self.mode == Mode::Attract {\n            self.attract_tick(dt, events);\n        }\n        BTreeMap::new()\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        json!({\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"stage\": format!(\"{:?}\", self.stage),\n            \"outcome\": self.outcome,\n            \"case\": self.op.case,\n            \"phase\": self.op.phase,\n            \"vitals\": (self.op.vitals * 10.0).round() / 10.0,\n            \"timer\": self.op.timer.round(),\n            \"hazards\": self.op.hazards.len(),\n            \"score\": self.surgeons.iter().map(|s| s.score).sum::<i32>(),\n            \"run_score\": self.run_score,\n            \"cases_won\": self.cases_won,\n            \"beats\": self.heart.beats,\n            \"bpm\": self.heart.bpm.round(),\n            \"tools\": [self.surgeons[0].tool as u8, self.surgeons[1].tool as u8, self.surgeons[2].tool as u8, self.surgeons[3].tool as u8],\n            \"cursors\": self.surgeons.iter().map(|s| [s.cursor.x, s.cursor.y]).collect::<Vec<_>>(),\n            \"present\": self.surgeons.iter().map(|s| s.present).collect::<Vec<_>>(),\n            \"story\": if self.stage == Stage::Story { Some(self.story.key.to_string()) } else { None },\n            \"line\": self.story.i,\n            \"rank\": self.results.as_ref().map(|r| r.rank.to_string()),\n            \"total\": self.results.as_ref().map(|r| r.total),\n            \"attract_seg\": self.attract_seg,\n            \"gift\": self.surgeons[0].gift,\n            \"tune_score\": self.tune.get(tune::SCORE),\n            \"seed\": self.seed,\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        for slot in 0..4 {\n            if self.humans[slot] && !self.surgeons[slot].bot {\n                f.surgeons[slot] = self.bot_input(slot, self.bot_skill);\n                if slot > 0 {\n                    break;\n                }\n            }\n        }\n        match self.stage {\n            Stage::Story | Stage::Chart => f.surgery = Some(SurgeryCmd::Advance),\n            Stage::Results if self.stage_t > 0.1 => f.surgery = Some(SurgeryCmd::Advance),\n            _ => {}\n        }\n        f\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/director.rs <<'EOF'\n//! Runs a case's data: phases, spawns, triggers, checkpoints; and Code Blue's director, which\n//! spends a budget of hazards on one patient while the tempo rises.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::content::{self, EventDef};\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::{Checkpoint, Mode, Stage, Surgery, cue};\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Director {\n    /// Surgeons at the table when it started.\n    pub surgeons: u32,\n    pub next_wave: f32,\n    pub interval: f32,\n    pub tempo: f32,\n    pub tempo_t: f32,\n    pub waves: u32,\n    pub finale: bool,\n}\n\nimpl Surgery {\n    pub(super) fn begin_phase(&mut self, i: u8, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let Some(def) = case.phase.get(i as usize) else { return };\n        self.op.phase = i;\n        self.op.phase_t = 0.0;\n        self.op.phase_beats = 0;\n        self.op.fired = 0;\n        self.op.objective = def.objective.as_str().into();\n        self.op.strain = None;\n        self.heart.meter = def.meter.unwrap_or(0);\n        self.heart.bar_beat = 0;\n        if def.checkpoint && i > 0 {\n            self.checkpoint = Some(Box::new(Checkpoint {\n                op: self.op.clone(),\n                surgeons: self.surgeons.clone(),\n                heart: self.heart.clone(),\n                gifts: self.gifts.clone(),\n            }));\n            self.op.banner = Some((\"CHECKPOINT\".into(), 1.2));\n        }\n        if let Some(p) = &def.plate {\n            if p.as_str() != &*self.op.plate {\n                let from = def.spawn.first().map(|s| Vec2::new(s.at[0], s.at[1])).unwrap_or_default();\n                self.set_plate(p, self.last_cut().unwrap_or(from));\n                self.op.push = 1.0;\n                self.op.push_at = self.last_cut().unwrap_or(from);\n                self.cue_at(events, cue::SQUISH, self.op.push_at);\n            }\n        }\n        for s in &def.spawn {\n            self.spawn_def(s);\n        }\n        if let Some(st) = &def.strain {\n            self.strain_start(st, events);\n        }\n        if self.op.case == content::CODE_BLUE && i == 0 {\n            let n = self.surgeons.iter().filter(|s| s.present).count().max(1) as u32;\n            self.op.director = Some(Director { surgeons: n, next_wave: 0.5, interval: 11.0, tempo: 1.0, ..Default::default() });\n        }\n        self.op.counters.bump(&format!(\"phase_{}_{}\", self.op.case, i));\n    }\n\n    fn last_cut(&self) -> Option<Vec2> {\n        self.op.stains.iter().rev().find(|s| s.kind == 2).and_then(|s| s.pts.first().copied())\n    }\n\n    pub(super) fn jump_phase(&mut self, phase: u8, events: &mut Vec<SimEvent>) {\n        self.op.hazards.clear();\n        self.begin_phase(phase, events);\n    }\n\n    pub(super) fn skip_phase(&mut self, events: &mut Vec<SimEvent>) {\n        self.op.hazards.clear();\n        for s in &mut self.surgeons {\n            s.engaged = 0;\n        }\n        self.next_phase(events);\n    }\n\n    fn next_phase(&mut self, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let next = self.op.phase + 1;\n        if (next as usize) < case.phase.len() {\n            self.begin_phase(next, events);\n        } else {\n            self.complete(events);\n        }\n    }\n\n    pub(super) fn phase_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        self.op.phase_t += dt;\n        let content = content::get();\n        let Some(case) = content.case(self.op.case) else { return };\n        let Some(def) = case.phase.get(self.op.phase as usize) else { return };\n\n        if self.op.director.is_some() {\n            self.director_tick(dt, events);\n        }\n\n        // Only the closure left: the dressing comes to hand by itself.\n        let required: Vec<&Hazard> = self.op.hazards.iter().filter(|h| h.required).collect();\n        let closure_only = !required.is_empty() && required.iter().all(|h| h.kind == HazardKind::Closure);\n        self.op.forced_tool = if closure_only { Some(Tool::Dressing) } else { None };\n        let remaining = required.len() as u32;\n        let strain_done = self.op.strain.as_ref().is_none_or(|s| s.done);\n        let clear = remaining == 0 && strain_done;\n\n        // Triggers.\n        for (i, e) in def.event.iter().enumerate() {\n            let bit = 1u64 << (i.min(63));\n            if self.op.fired & bit != 0 {\n                continue;\n            }\n            let fire = e.at_time.is_some_and(|t| self.op.phase_t >= t)\n                || e.vitals_below.is_some_and(|v| self.op.vitals < v)\n                || e.on_beat.is_some_and(|b| self.op.phase_beats >= b)\n                || e.remaining.is_some_and(|r| remaining <= r)\n                || (e.on_clear && clear);\n            if fire {\n                self.op.fired |= bit;\n                self.run_event(e, events);\n                if self.stage != Stage::Op {\n                    return;\n                }\n            }\n        }\n\n        // Anything still to come? On-clear events may have added work.\n        let required = self.op.hazards.iter().filter(|h| h.required).count();\n        let strain_done = self.op.strain.as_ref().is_none_or(|s| s.done);\n        let pending_time = def.event.iter().enumerate().any(|(i, e)| {\n            self.op.fired & (1u64 << i.min(63)) == 0 && (e.at_time.is_some() || e.on_clear || e.on_beat.is_some())\n        });\n        let director_busy = self.op.director.as_ref().is_some_and(|d| !d.finale);\n        if required == 0 && strain_done && !pending_time && self.op.phase_t >= def.hold && !director_busy {\n            if self.op.case == content::CODE_BLUE {\n                // Code Blue runs until the bell; the strain encounter is its last act.\n                return;\n            }\n            self.next_phase(events);\n        }\n    }\n\n    pub(super) fn run_event(&mut self, e: &EventDef, events: &mut Vec<SimEvent>) {\n        for s in &e.spawn {\n            self.spawn_def(s);\n        }\n        if e.say.len() == 2 {\n            self.say(&e.say[0].clone(), &e.say[1].clone());\n        }\n        if let Some(c) = &e.cue {\n            if let Some(id) = cue::id(c) {\n                self.cue_at(events, id, Vec2::ZERO);\n            }\n        }\n        if let Some(b) = &e.banner {\n            self.op.banner = Some((b.as_str().into(), 0.0));\n            self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        }\n        if e.shake > 0.0 {\n            self.op.shake = self.op.shake.max(e.shake);\n        }\n        if let Some(p) = &e.plate {\n            let from = self.last_cut().unwrap_or_default();\n            self.set_plate(p, from);\n        }\n        if e.push > 0.0 {\n            self.op.push = e.push;\n            self.op.push_at = e.spawn.first().map(|s| Vec2::new(s.at[0], s.at[1])).unwrap_or(Vec2::ZERO);\n        }\n        if e.vitals != 0.0 {\n            if e.vitals < 0.0 {\n                self.hurt(-e.vitals);\n            } else {\n                self.op.vitals = (self.op.vitals + e.vitals).min(self.op.vitals_max);\n            }\n        }\n        if e.gift {\n            self.wake_gift(events);\n        }\n        if e.code {\n            self.start_code(true, 1);\n        }\n    }\n\n    /// Code Blue: spends the budget on waves; tempo rises every 30 s; ends in a strain.\n    fn director_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut d) = self.op.director.take() else { return };\n        d.tempo_t += dt;\n        if d.tempo_t >= 30.0 {\n            d.tempo_t = 0.0;\n            d.tempo += 0.14;\n            self.say_short(\"codeblue_tempo\");\n            self.op.banner = Some((\"TEMPO UP\".into(), 1.0));\n            self.cue_at(events, cue::BANNER, Vec2::ZERO);\n        }\n        self.op.drain_scale = 0.85 + (d.tempo - 1.0) * 0.5;\n        // The last minute: a small strain encounter on top of the waves.\n        if !d.finale && self.op.timer < 60.0 {\n            d.finale = true;\n            let def = content::StrainDef {\n                kind: \"introit\".into(),\n                waves: 2,\n                speed: 1.0,\n                tough: 0.8,\n                beats: 10.0,\n                amen: false,\n                count: 1,\n                rings: 0,\n                fever: 0.0,\n                at: [0.0, 0.0],\n                furnace: false,\n                visible: true,\n            };\n            self.strain_start(&def, events);\n            self.say_short(\"codeblue_finale\");\n        }\n        d.next_wave -= dt;\n        if d.next_wave <= 0.0 {\n            d.waves += 1;\n            d.next_wave = d.interval / d.tempo;\n            let budget = (3.0 * d.tempo * (0.6 + 0.4 * d.surgeons as f32)).round() as u32;\n            self.spawn_budget(budget, d.waves);\n        }\n        self.op.director = Some(d);\n    }\n\n    fn spawn_budget(&mut self, mut budget: u32, wave: u32) {\n        let busy = self.op.hazards.iter().filter(|h| h.required).count() as u32;\n        if busy > 14 {\n            return;\n        }\n        while budget > 0 {\n            let at = self.field_spot(Vec2::ZERO, budget + wave * 7);\n            let roll = self.rand();\n            let dir = Vec2::from_angle(self.rand() * 6.28);\n            let (kind, cost) = if roll < 0.24 {\n                (HazardKind::Laceration, 1)\n            } else if roll < 0.46 {\n                (HazardKind::Foreign, 1)\n            } else if roll < 0.6 {\n                (HazardKind::Polyp, 1)\n            } else if roll < 0.72 {\n                (HazardKind::Burn, 1)\n            } else if roll < 0.84 {\n                (HazardKind::Incision, 1)\n            } else if roll < 0.94 {\n                (HazardKind::Pool, 1)\n            } else {\n                (HazardKind::Bleeder, 2)\n            };\n            let mut h = Hazard { kind, pos: at, axis: self.rand() * 6.28, required: true, ..Default::default() };\n            match kind {\n                HazardKind::Laceration => {\n                    let len = 0.9 + self.rand() * 0.8;\n                    h.pts = vec![at - dir * len, at + dir.perp() * 0.25, at + dir * len];\n                }\n                HazardKind::Incision => {\n                    let len = 1.3 + self.rand();\n                    h.pts = vec![at - dir * len, at + dir * len];\n                }\n                HazardKind::Foreign => {\n                    h.r = 0.3;\n                    h.tag = (self.rand() * 3.0) as u8;\n                }\n                HazardKind::Polyp => h.r = 0.42,\n                HazardKind::Burn => h.r = 0.75,\n                HazardKind::Pool => h.r = 0.85,\n                HazardKind::Bleeder => h.r = 0.3,\n                _ => {}\n            }\n            self.add_hazard(h);\n            budget = budget.saturating_sub(cost);\n        }\n    }\n\n    /// Attract: the next 25-second segment of the loop.\n    pub(super) fn attract_next(&mut self, events: &mut Vec<SimEvent>) {\n        self.attract_t = 0.0;\n        self.cheats.immortal = true;\n        self.cheats.full_gift = true;\n        self.cheats.freeze_timer = true;\n        self.bot_skill = 1.0;\n        let seg = self.attract_seg;\n        self.attract_seg = (self.attract_seg + 1) % 6;\n        // Case, phase of it, bots at the table.\n        let (case, phase, bots) = match seg {\n            0 => (3u8, 1u8, 1usize),\n            1 => (4, 1, 1),\n            2 => (5, 1, 1),\n            3 => (7, 4, 2),\n            4 => (content::CODE_BLUE, 0, 4),\n            _ => (0, 0, 0),\n        };\n        for (i, s) in self.surgeons.iter_mut().enumerate() {\n            s.bot = i < bots;\n            s.present = i < bots;\n        }\n        self.humans = [false; 4];\n        self.begin_case(case);\n        if bots == 0 {\n            // One story exchange.\n            self.begin_story(\"case3_after\", events);\n            return;\n        }\n        self.begin_phase(phase, events);\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n        self.op.banner = None;\n        self.op.gift_awake = true;\n        if case == content::CODE_BLUE {\n            self.op.timer = 200.0;\n        }\n    }\n\n    pub(super) fn attract_tick(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        self.attract_t += dt;\n        // The bot reads slowly on the story segment, so a passer-by can too.\n        if self.stage == Stage::Story {\n            let due = self.story.t > (0.8 + self.story.text.chars().count() as f32 * 0.03).min(3.0);\n            if due {\n                self.story.typed = true;\n                self.story_advance(events);\n            }\n        }\n        if self.stage == Stage::Op {\n            let done = self.op.hazards.iter().filter(|h| h.required).count() == 0\n                && self.op.strain.as_ref().is_none_or(|s| s.done);\n            if done && self.op.phase_t > 1.0 && self.mode == Mode::Attract {\n                self.attract_t = 99.0;\n            }\n        }\n        if self.attract_t > 25.0 || !matches!(self.stage, Stage::Op | Stage::Story) {\n            self.attract_next(events);\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/story.rs <<'EOF'\n//! The story scene player: stage commands and lines, read from the story files.\n\nuse std::sync::Arc;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::frame::{ActorView, StoryView};\nuse super::{Stage, Surgery, content, cue};\nuse crate::frame::SimEvent;\n\n/// Where a stage name puts a character.\npub fn stage_x(at: &str) -> f32 {\n    match at {\n        \"left\" => -3.1,\n        \"right\" => 3.1,\n        \"centre\" | \"center\" => 0.0,\n        \"farleft\" => -4.9,\n        \"farright\" => 4.9,\n        _ => 3.1,\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StoryState {\n    pub key: Arc<str>,\n    pub i: usize,\n    pub t: f32,\n    pub typed: bool,\n    pub set: Arc<str>,\n    pub who: Arc<str>,\n    pub text: Arc<str>,\n    pub actors: Vec<ActorView>,\n    pub music: Arc<str>,\n    pub camera_or: bool,\n    pub flash: f32,\n    pub shake: f32,\n}\n\nimpl StoryState {\n    pub fn view(&self, cps: f32) -> StoryView {\n        let total = self.text.chars().count() as f32;\n        let chars = if self.typed { total } else { (self.t * cps).min(total) };\n        let talking = !self.typed && chars < total;\n        let actors = self\n            .actors\n            .iter()\n            .map(|a| {\n                let mut a = a.clone();\n                a.talking = talking && a.who == self.who;\n                a\n            })\n            .collect();\n        StoryView {\n            key: self.key.clone(),\n            line: self.i as u32,\n            who: self.who.clone(),\n            text: self.text.clone(),\n            chars: chars as u32,\n            typed: self.typed || chars >= total,\n            set: self.set.clone(),\n            actors,\n            camera_or: self.camera_or,\n            flash: self.flash,\n            shake: self.shake,\n            t: self.t,\n        }\n    }\n}\n\nimpl Surgery {\n    pub fn begin_story(&mut self, key: &str, events: &mut Vec<SimEvent>) {\n        self.story = StoryState { key: key.into(), set: \"corridor\".into(), music: \"tense\".into(), ..Default::default() };\n        self.stage = Stage::Story;\n        self.stage_t = 0.0;\n        self.op.counters.bump(\"story\");\n        self.story_step(0, events);\n    }\n\n    /// Runs lines from `from`: commands until a spoken line stops it, or the end of the scene.\n    fn story_step(&mut self, from: usize, events: &mut Vec<SimEvent>) {\n        let content = content::get();\n        let Some(def) = content.stories.get(&*self.story.key) else {\n            self.story_done(events);\n            return;\n        };\n        let mut i = from;\n        while let Some(l) = def.line.get(i) {\n            let st = &mut self.story;\n            if !l.set.is_empty() {\n                st.set = l.set.as_str().into();\n            }\n            if !l.music.is_empty() {\n                st.music = l.music.as_str().into();\n            }\n            if !l.camera.is_empty() {\n                st.camera_or = l.camera == \"or\";\n            }\n            if l.flash > 0.0 {\n                st.flash = l.flash;\n            }\n            if l.shake > 0.0 {\n                st.shake = l.shake;\n            }\n            if !l.exit.is_empty() {\n                let who = l.exit.as_str();\n                for a in st.actors.iter_mut() {\n                    if who == \"all\" || &*a.who == who {\n                        a.leaving = true;\n                        a.t = 0.0;\n                    }\n                }\n            }\n            if !l.enter.is_empty() {\n                let x = stage_x(&l.at);\n                let who: Arc<str> = l.enter.as_str().into();\n                st.actors.retain(|a| a.who != who);\n                st.actors.push(ActorView { who, expr: \"neutral\".into(), x, t: 0.0, leaving: false, talking: false });\n            }\n            if !l.who.is_empty() {\n                let who: Arc<str> = l.who.as_str().into();\n                if !l.expr.is_empty() {\n                    if let Some(a) = st.actors.iter_mut().find(|a| a.who == who) {\n                        a.expr = l.expr.as_str().into();\n                    }\n                }\n            } else if !l.expr.is_empty() {\n                // An expression change with no line needs a who; there is none.\n            }\n            if !l.cue.is_empty() {\n                if let Some(id) = cue::id(&l.cue) {\n                    let at = glam::Vec2::ZERO;\n                    self.cue_at(events, id, at);\n                }\n            }\n            if !l.who.is_empty() && !l.text.is_empty() {\n                let st = &mut self.story;\n                st.i = i;\n                st.t = 0.0;\n                st.typed = false;\n                st.who = l.who.as_str().into();\n                st.text = l.text.as_str().into();\n                return;\n            }\n            i += 1;\n        }\n        self.story.i = i;\n        self.story_done(events);\n    }\n\n    pub(super) fn story_tick(&mut self, dt: f32, _events: &mut Vec<SimEvent>) {\n        let st = &mut self.story;\n        st.t += dt;\n        st.flash = (st.flash - dt * 2.0).max(0.0);\n        st.shake = (st.shake - dt * 2.5).max(0.0);\n        for a in &mut st.actors {\n            a.t += dt;\n        }\n        st.actors.retain(|a| !(a.leaving && a.t > 0.5));\n        self.op.clock += dt;\n        self.heart.tick(dt, 100.0, 1.0);\n    }\n\n    pub(super) fn story_advance(&mut self, events: &mut Vec<SimEvent>) {\n        let total = self.story.text.chars().count() as f32;\n        if !self.story.typed && self.story.t * self.text_cps < total {\n            self.story.typed = true;\n            return;\n        }\n        let next = self.story.i + 1;\n        self.story_step(next, events);\n    }\n\n    pub(super) fn story_skip(&mut self, events: &mut Vec<SimEvent>) {\n        self.story_done(events);\n    }\n\n    /// The scene is over: on to the chart, or the next case after an \"after\" scene.\n    fn story_done(&mut self, events: &mut Vec<SimEvent>) {\n        self.story.actors.clear();\n        if self.mode == super::Mode::Attract {\n            self.attract_t = 99.0;\n            self.stage = Stage::Title;\n            return;\n        }\n        let content = content::get();\n        let after = content.case(self.op.case).map(|c| c.after.clone()).unwrap_or_default();\n        if &*self.story.key == after.as_str() {\n            self.next_campaign_case(events);\n        } else {\n            self.stage = Stage::Chart;\n            self.stage_t = 0.0;\n        }\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/bot.rs <<'EOF'\n//! The bot: a task planner. It picks the most urgent valid task, selects the tool, moves at a human\n//! cursor speed and performs the gesture, with noise scaled by skill. It is a pure function of the\n//! game's state, so a replay of it is exact. It drives the tests, the balance tool, attract mode,\n//! the Case 7 partner.\n\nuse glam::Vec2;\n\nuse super::Surgery;\nuse super::field::{Hazard, HazardKind, Tool, polyline_at};\nuse super::frame::Stage;\nuse crate::input::{SurgeonInput, hands};\n\n/// A repeatable number in -1..1 from a seed.\nfn noise(seed: f32) -> f32 {\n    let x = (seed * 12.9898).sin() * 43758.547;\n    (x - x.floor()) * 2.0 - 1.0\n}\n\nimpl Surgery {\n    fn bot_noise(&self, slot: usize, k: f32) -> Vec2 {\n        let t = (self.op.clock * 3.0).floor() + slot as f32 * 31.0;\n        Vec2::new(noise(t + k), noise(t + k + 57.0))\n    }\n\n    /// What a player of this skill presses this tick for this slot.\n    pub fn bot_input(&self, slot: usize, skill: f32) -> SurgeonInput {\n        let s = &self.surgeons[slot];\n        let mut inp = SurgeonInput { active: true, aim: s.raw, tool: -1, pressure: 1.0, ..Default::default() };\n        if skill <= 0.0 {\n            return inp;\n        }\n        match self.stage {\n            Stage::Code => return self.bot_code(slot, inp),\n            Stage::Op => {}\n            _ => return inp,\n        }\n        // A slow player sits and thinks now and then.\n        let think = noise((self.op.clock * 1.5).floor() + slot as f32 * 7.0);\n        if skill < 0.95 && think > 0.2 + skill && s.engaged == 0 {\n            return inp;\n        }\n        self.bot_gift(slot, &mut inp);\n        if inp.held & hands::GIFT != 0 {\n            return inp;\n        }\n\n        // Engaged: finish the gesture first.\n        if s.engaged != 0 || s.iv_on {\n            if self.bot_gesture(slot, skill, &mut inp) {\n                return inp;\n            }\n        }\n        // Urgent: the patient is going.\n        let iv_ready = s.iv_cool <= 0.0;\n        let threshold = 25.0 + 30.0 * skill;\n        if iv_ready && self.op.vitals < threshold && self.ring_place(Tool::Iv).is_some() {\n            if s.tool != Tool::Iv {\n                inp.tool = self.ring_place(Tool::Iv).unwrap() as i8;\n                return inp;\n            }\n            inp.held |= hands::USE;\n            inp.pressed |= hands::USE;\n            return inp;\n        }\n\n        let Some((target, tool)) = self.bot_pick(slot) else {\n            // Nothing to do: drift back toward the middle.\n            inp.aim = self.bot_step(slot, skill, Vec2::new(0.0, 0.5));\n            return inp;\n        };\n        if s.tool != tool {\n            match self.ring_place(tool) {\n                Some(p) => inp.tool = p as i8,\n                None => {\n                    inp.aim = self.bot_step(slot, skill, Vec2::new(0.0, 0.5));\n                    return inp;\n                }\n            }\n            return inp;\n        }\n        let at = target.as_ref().map(|h| self.bot_touch(h, tool)).unwrap_or(Vec2::ZERO);\n        inp.aim = self.bot_step(slot, skill, at);\n        let dist = s.raw.distance(at);\n        let reach = match tool {\n            Tool::Suction | Tool::Gel => 0.8,\n            Tool::Scanner => 1.8,\n            _ => 0.28,\n        };\n        if dist < reach {\n            inp.aim = at;\n            inp.held |= hands::USE;\n            if !s.using {\n                inp.pressed |= hands::USE;\n            }\n            if tool == Tool::Gel && s.flow < 0.08 {\n                inp.held &= !hands::USE;\n                inp.pressed &= !hands::USE;\n            }\n            if tool == Tool::Laser || tool == Tool::Cryo {\n                if let Some(h) = &target {\n                    if h.by != 0 && h.by != slot as u8 + 1 {\n                        inp.held &= !hands::USE;\n                    }\n                }\n            }\n        }\n        inp\n    }\n\n    fn ring_place(&self, tool: Tool) -> Option<usize> {\n        self.op.ring.iter().position(|t| *t == tool)\n    }\n\n    /// One tick's travel toward a point, at a human cursor speed.\n    fn bot_step(&self, slot: usize, skill: f32, to: Vec2) -> Vec2 {\n        let from = self.surgeons[slot].raw;\n        let speed = (4.0 + 15.0 * skill) / 60.0;\n        let d = to - from;\n        if d.length() <= speed { to } else { from + d.normalize() * speed }\n    }\n\n    fn bot_touch(&self, h: &Hazard, tool: Tool) -> Vec2 {\n        match (h.kind, tool) {\n            (HazardKind::Sac, Tool::Laser) => h.pos.lerp(h.to, 0.5),\n            (HazardKind::Sac, _) => h.pos,\n            (HazardKind::Bleeder, _) => h.pts.first().copied().unwrap_or(h.pos),\n            _ => h.touch_point(),\n        }\n    }\n\n    /// The most urgent task for this slot, and the instrument for it.\n    fn bot_pick(&self, slot: usize) -> Option<(Option<Hazard>, Tool)> {\n        let cursor = self.surgeons[slot].raw;\n        let mut best: Option<(f32, Option<Hazard>, Tool)> = None;\n        let has = |t: Tool| self.ring_place(t).is_some();\n        // Something hidden that a task needs: look for it. The bot knows where to sweep.\n        for h in &self.op.hazards {\n            if h.hidden && h.reveal <= 0.0 && h.required && has(Tool::Scanner) {\n                let score = 40.0 - h.pos.distance(cursor);\n                if best.as_ref().is_none_or(|b| score > b.0) {\n                    best = Some((score, Some(h.clone()), Tool::Scanner));\n                }\n            }\n        }\n        // Forced: the closing dressing.\n        if self.op.forced_tool == Some(Tool::Dressing) {\n            let h = self.op.hazards.iter().find(|h| h.kind == HazardKind::Closure)?;\n            return Some((Some(h.clone()), Tool::Dressing));\n        }\n        for h in &self.op.hazards {\n            if h.by != 0 && h.by != slot as u8 + 1 {\n                continue;\n            }\n            if h.kind == HazardKind::Crown {\n                continue;\n            }\n            if self.covered(h) {\n                // Clear the pool over it first.\n                if let Some(p) = self.op.hazards.iter().find(|p| p.kind == HazardKind::Pool && p.pos.distance(h.pos) < p.r * 0.92) {\n                    let score = 34.0 - p.pos.distance(cursor);\n                    if best.as_ref().is_none_or(|b| score > b.0) {\n                        best = Some((score, Some(p.clone()), Tool::Suction));\n                    }\n                }\n                continue;\n            }\n            let Some(tool) = self.bot_tool_for(h) else { continue };\n            if !has(tool) {\n                continue;\n            }\n            let urgency = match h.kind {\n                HazardKind::Nodule if h.stage == 1 => 100.0,\n                HazardKind::Incision if h.life > 0.0 => 90.0,\n                HazardKind::Sac => 44.0 + h.progress * 40.0,\n                HazardKind::Bleeder => 60.0,\n                HazardKind::Nodule => 44.0,\n                HazardKind::Laceration => 30.0,\n                HazardKind::Pool if h.r > 1.25 => 26.0,\n                HazardKind::Pool => {\n                    if h.required {\n                        24.0\n                    } else {\n                        8.0\n                    }\n                }\n                HazardKind::Burn => 20.0,\n                _ => 28.0,\n            };\n            let score = urgency - h.touch_point().distance(cursor) * 1.2;\n            if best.as_ref().is_none_or(|b| score > b.0) {\n                best = Some((score, Some(h.clone()), tool));\n            }\n        }\n        best.map(|b| (b.1, b.2))\n    }\n\n    fn bot_tool_for(&self, h: &Hazard) -> Option<Tool> {\n        // Sacs: the stem, with the laser. The rest ask.\n        if h.kind == HazardKind::Sac {\n            return Some(if self.ring_place(Tool::Laser).is_some() { Tool::Laser } else { Tool::Suction });\n        }\n        h.wants()\n    }\n\n    /// Carries on what the hands are doing. False: nothing to carry on.\n    fn bot_gesture(&self, slot: usize, skill: f32, inp: &mut SurgeonInput) -> bool {\n        let s = &self.surgeons[slot];\n        let n = (1.0 - skill).max(0.0);\n        if s.iv_on {\n            let release = 0.88 + self.bot_noise(slot, 3.0).x * 0.12 * n;\n            if s.dose < release {\n                inp.held |= hands::USE;\n            }\n            inp.aim = s.raw;\n            return true;\n        }\n        let Some(h) = self.hazard(s.engaged) else { return false };\n        match s.tool {\n            Tool::Scalpel | Tool::Dressing => {\n                let (p, t) = polyline_at(&h.pts, h.progress + 0.3 + skill * 0.2);\n                let side = Vec2::new(-t.y, t.x) * self.bot_noise(slot, 1.0).x * (0.05 + n * 0.95);\n                inp.aim = p + side;\n                inp.held |= hands::USE;\n            }\n            Tool::Forceps => match h.kind {\n                HazardKind::Bone => {\n                    inp.aim = self.bot_step(slot, skill.max(0.6), h.to);\n                    inp.held |= hands::USE;\n                    let d = super::field::angle_diff(h.axis, h.angle);\n                    if d.abs() > 0.05 {\n                        inp.rotate = if d > 0.0 { 1 } else { -1 };\n                    }\n                }\n                HazardKind::Tendril => {\n                    let (p, _) = polyline_at(&h.pts, h.progress + 0.8);\n                    let wait = !self.heart.diastole() && n < 0.5;\n                    inp.aim = if wait { polyline_at(&h.pts, h.progress).0 } else { p };\n                    inp.held |= hands::USE;\n                }\n                _ => {\n                    let wobble = self.bot_noise(slot, 2.0).x * n * 1.2;\n                    let d = Vec2::from_angle(h.axis + wobble);\n                    inp.aim = self.bot_step(slot, skill.max(0.5), s.grab + d * 1.2);\n                    inp.held |= hands::USE;\n                }\n            },\n            Tool::Suture => {\n                let (needle, t) = polyline_at(&h.pts, h.progress);\n                let normal = Vec2::new(-t.y, t.x);\n                let go = if s.side >= 0 { -1.0 } else { 1.0 };\n                let along = 0.5 + self.bot_noise(slot, 4.0).x * n * 0.45;\n                let to = needle + t * along + normal * go * 0.55;\n                let v = (10.0 + 16.0 * skill) / 60.0;\n                let d = to - s.raw;\n                inp.aim = if d.length() <= v { to } else { s.raw + d.normalize() * v };\n                inp.held |= hands::USE;\n            }\n            Tool::Laser | Tool::Cryo => {\n                let release = 0.93 + self.bot_noise(slot, 5.0).x * 0.2 * n;\n                inp.aim = s.raw;\n                if h.heat < release {\n                    inp.held |= hands::USE;\n                }\n            }\n            _ => return false,\n        }\n        true\n    }\n\n    /// Hold the gift when it's ready; let go on the beat.\n    fn bot_gift(&self, slot: usize, inp: &mut SurgeonInput) {\n        let s = &self.surgeons[slot];\n        if !self.op.gift_awake || self.gifts.hush_beats > 0.0 || self.gifts.echo_t > 0.0 {\n            if s.gift_hold {\n                // Let go.\n            }\n            return;\n        }\n        if s.engaged != 0 {\n            return;\n        }\n        if s.gift >= 100.0 {\n            let hit = self.heart.on_beat(self.tune.get(super::tune::BEAT_WINDOW));\n            if s.gift_hold && hit {\n                return; // release now\n            }\n            if s.gift_hold || self.heart.phase > 0.45 {\n                inp.held |= hands::GIFT;\n                if !s.gift_hold {\n                    inp.pressed |= hands::GIFT;\n                }\n            }\n        }\n    }\n\n    fn bot_code(&self, slot: usize, mut inp: SurgeonInput) -> SurgeonInput {\n        let Some(c) = &self.op.code else { return inp };\n        let s = &self.surgeons[slot];\n        // Time the charge to end as the ghost crosses the line.\n        if s.charging {\n            if s.charge >= 1.0 && (c.ghost - 0.5).abs() < 0.03 {\n                return inp;\n            }\n            inp.held |= hands::DEFIB;\n        } else {\n            let until = (0.5 - c.ghost).rem_euclid(1.0) * 1.1;\n            if (until - 1.25).abs() < 0.03 || c.ghost > 0.5 && c.ghost < 0.53 {\n                inp.held |= hands::DEFIB;\n                inp.pressed |= hands::DEFIB;\n            }\n        }\n        inp\n    }\n}\nEOF\ncat > crates/pav_core/src/games/surgery/net.rs <<'EOF'\n//! The network's view of a Code Blue round: one compact JSON snapshot from the host about 15 times\n//! a second, and each client's hands going the other way. Keep a snapshot under 1,200 bytes when\n//! you can: an unreliable message bigger than that travels as several packets.\n\nuse std::sync::Arc;\n\nuse glam::Vec2;\nuse serde_json::{Value, json};\n\nuse super::field::{Hazard, HazardKind, Tool};\nuse super::frame::{Stage, SurgeryFrame, SurgeonView};\nuse crate::input::SurgeonInput;\n\nfn q(v: f32) -> i32 {\n    (v * 20.0).round() as i32\n}\nfn uq(v: i64) -> f32 {\n    v as f32 / 20.0\n}\n\n/// The host's frame as a snapshot. `cues` are the last cue events: (serial, id, x, z).\npub fn encode_frame(f: &SurgeryFrame, cues: &[(u32, u16, f32, f32)]) -> Value {\n    let hz: Vec<Value> = f\n        .hazards\n        .iter()\n        .map(|h| {\n            let mut v = vec![\n                json!(h.id),\n                json!(h.kind as u8),\n                json!(q(h.pos.x)),\n                json!(q(h.pos.y)),\n                json!(q(h.r)),\n                json!(q(h.progress)),\n                json!((h.heat * 20.0) as i32),\n                json!(h.stage),\n                json!(q(h.axis)),\n                json!((h.hidden && h.reveal <= 0.0) as u8 | ((h.locked as u8) << 1) | ((h.required as u8) << 2)),\n                json!(h.tag),\n            ];\n            if h.pts.len() >= 2 {\n                let mut flat = Vec::with_capacity(h.pts.len() * 2);\n                for p in &h.pts {\n                    flat.push(json!(q(p.x)));\n                    flat.push(json!(q(p.y)));\n                }\n                v.push(Value::Array(flat));\n            }\n            Value::Array(v)\n        })\n        .collect();\n    let cur: Vec<Value> = f\n        .surgeons\n        .iter()\n        .map(|s| {\n            json!([\n                s.present as u8 | ((s.using as u8) << 1) | ((s.gift_ready as u8) << 2) | ((s.bot as u8) << 3),\n                q(s.cursor.x),\n                q(s.cursor.y),\n                s.tool as u8,\n                s.score,\n                s.chain,\n                s.gift as i32,\n                s.gift_kind\n            ])\n        })\n        .collect();\n    let stage = match f.stage {\n        Stage::Op => 0,\n        Stage::OpStart => 1,\n        Stage::Code => 2,\n        Stage::Complete => 3,\n        Stage::Results => 4,\n        Stage::Dead => 5,\n        _ => 6,\n    };\n    json!({\n        \"s\": stage,\n        \"v\": (f.vitals * 10.0) as i32,\n        \"b\": [f.bpm as i32, (f.beat * 100.0) as i32, f.beats],\n        \"t\": f.timer as i32,\n        \"h\": hz,\n        \"c\": cur,\n        \"e\": cues.iter().map(|c| json!([c.0, c.1, q(c.2), q(c.3)])).collect::<Vec<_>>(),\n        \"f\": f.heat_ring.map(|r| q(r)),\n        \"o\": f.hush > 0.5,\n        \"k\": f.echo > 0.5,\n        \"r\": f.ring,\n        \"x\": f.code.as_ref().map(|c| [q(c.left), (c.ghost * 100.0) as i32]),\n    })\n}\n\nfn get_i(v: &Value, i: usize) -> i64 {\n    v.get(i).and_then(|x| x.as_i64()).unwrap_or(0)\n}\n\n/// A snapshot back into the frame a client draws. `prev` keeps what doesn't travel.\npub fn decode_frame(v: &Value, prev: &SurgeryFrame) -> SurgeryFrame {\n    let mut f = prev.clone();\n    f.mirror = true;\n    f.codeblue = true;\n    f.case_no = super::content::CODE_BLUE;\n    f.plate = Arc::from(\"torso\");\n    f.plate_blend = 1.0;\n    f.stage = match v[\"s\"].as_i64().unwrap_or(0) {\n        0 => Stage::Op,\n        1 => Stage::OpStart,\n        2 => Stage::Code,\n        3 => Stage::Complete,\n        4 => Stage::Results,\n        5 => Stage::Dead,\n        _ => Stage::Card,\n    };\n    f.vitals = v[\"v\"].as_f64().unwrap_or(0.0) as f32 / 10.0;\n    f.vitals_max = 100.0;\n    f.bpm = get_i(&v[\"b\"], 0) as f32;\n    f.beat = get_i(&v[\"b\"], 1) as f32 / 100.0;\n    f.beats = get_i(&v[\"b\"], 2) as u32;\n    f.flat = f.stage == Stage::Code;\n    f.timer = v[\"t\"].as_f64().unwrap_or(0.0) as f32;\n    f.timer_total = 240.0;\n    f.heat_ring = v[\"f\"].as_i64().map(uq);\n    f.hush = if v[\"o\"].as_bool().unwrap_or(false) { 1.0 } else { 0.0 };\n    f.echo = if v[\"k\"].as_bool().unwrap_or(false) { 1.0 } else { 0.0 };\n    if let Some(r) = v[\"r\"].as_array() {\n        for (i, t) in r.iter().enumerate().take(8) {\n            let id = t.as_str().and_then(tool_from_debug);\n            if let Some(id) = id {\n                f.ring[i] = id;\n            }\n        }\n    }\n    f.code = v[\"x\"].as_array().map(|c| super::frame::CodeView {\n        left: uq(c.first().and_then(|x| x.as_i64()).unwrap_or(0)),\n        window: 5.0,\n        ghost: c.get(1).and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 100.0,\n        shocks: 1,\n        scripted: false,\n    });\n    f.hazards = v[\"h\"]\n        .as_array()\n        .map(|a| {\n            a.iter()\n                .map(|h| {\n                    let flags = get_i(h, 9);\n                    let mut out = Hazard {\n                        id: get_i(h, 0) as u32,\n                        kind: HazardKind::ALL.get(get_i(h, 1) as usize).copied().unwrap_or_default(),\n                        pos: Vec2::new(uq(get_i(h, 2)), uq(get_i(h, 3))),\n                        r: uq(get_i(h, 4)),\n                        progress: uq(get_i(h, 5)),\n                        heat: get_i(h, 6) as f32 / 20.0,\n                        stage: get_i(h, 7) as u8,\n                        axis: uq(get_i(h, 8)),\n                        hidden: flags & 1 != 0,\n                        locked: flags & 2 != 0,\n                        required: flags & 4 != 0,\n                        tag: get_i(h, 10) as u8,\n                        ..Default::default()\n                    };\n                    if let Some(p) = h.get(11).and_then(|p| p.as_array()) {\n                        out.pts =\n                            p.chunks(2).map(|c| Vec2::new(uq(c[0].as_i64().unwrap_or(0)), uq(c[1].as_i64().unwrap_or(0)))).collect();\n                    }\n                    out\n                })\n                .collect()\n        })\n        .unwrap_or_default();\n    f.surgeons = v[\"c\"]\n        .as_array()\n        .map(|a| {\n            a.iter()\n                .enumerate()\n                .map(|(i, c)| {\n                    let flags = get_i(c, 0);\n                    let at = Vec2::new(uq(get_i(c, 1)), uq(get_i(c, 2)));\n                    let mut s = SurgeonView {\n                        slot: i as u8,\n                        present: flags & 1 != 0,\n                        using: flags & 2 != 0,\n                        gift_ready: flags & 4 != 0,\n                        bot: flags & 8 != 0,\n                        cursor: at,\n                        raw: at,\n                        tool: Tool::ALL.get(get_i(c, 3) as usize).copied().unwrap_or_default(),\n                        score: get_i(c, 4) as i32,\n                        chain: get_i(c, 5) as u32,\n                        gift: get_i(c, 6) as f32,\n                        gift_kind: get_i(c, 7) as u8,\n                        ..Default::default()\n                    };\n                    s.flow = 1.0;\n                    s\n                })\n                .collect()\n        })\n        .unwrap_or_default();\n    f\n}\n\nfn tool_from_debug(s: &str) -> Option<Tool> {\n    Tool::ALL.iter().copied().find(|t| format!(\"{t:?}\") == s)\n}\n\n/// A client's hands, as sent to the host.\npub fn encode_input(i: &SurgeonInput, tool_serial: u32) -> Value {\n    json!([q(i.aim.x), q(i.aim.y), i.held, i.tool, (i.pressure * 20.0) as i32, i.rotate, tool_serial])\n}\n\n/// A client's hands, as the host reads them.\npub fn decode_input(v: &Value) -> SurgeonInput {\n    SurgeonInput {\n        active: true,\n        aim: Vec2::new(uq(get_i(v, 0)), uq(get_i(v, 1))),\n        held: get_i(v, 2) as u8,\n        pressed: 0,\n        tool: get_i(v, 3) as i8,\n        pressure: get_i(v, 4) as f32 / 20.0,\n        assist: 0.5,\n        rotate: get_i(v, 5) as i8,\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/content.rs'\ns=open(p).read()\ns=s.replace('''    (\"level.toml\", include_str!(\"content/level.toml\")),\n];''','''    (\"level.toml\", include_str!(\"content/level.toml\")),\n    (\"callouts.toml\", include_str!(\"content/callouts.toml\")),\n];''')\ns=s.replace('''    pub level: String,\n}\n''','''    pub level: String,\n    /// In-op callouts by trigger.\n    pub callouts: BTreeMap<String, CalloutDef>,\n}\n\n/// A trigger's lines: `[speaker, line]`, one picked at random. `nurse` is whoever is calling it.\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct CalloutDef {\n    pub lines: Vec<Vec<String>>,\n}\n''',1)\ns=s.replace('''                _ => c.level = text.into_owned(),\n''','''                _ if path.starts_with(\"callouts\") => c.callouts = parse(path, &text)?,\n                _ => c.level = text.into_owned(),\n''')\ns=s.replace('''        for (key, story) in &self.stories {\n            for (i, l) in story.line.iter().enumerate() {''','''        for (key, c) in &self.callouts {\n            for l in &c.lines {\n                if l.len() != 2 || l[1].trim().is_empty() {\n                    bad.push(format!(\"callouts {key}: each line is [speaker, text]\"));\n                } else if l[0] != \"nurse\" {\n                    speaker(&l[0], &mut bad, &format!(\"callouts {key}\"));\n                }\n            }\n        }\n        for (key, story) in &self.stories {\n            for (i, l) in story.line.iter().enumerate() {''')\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write the game struct, director, story player, bot and network snapshot"}}}
