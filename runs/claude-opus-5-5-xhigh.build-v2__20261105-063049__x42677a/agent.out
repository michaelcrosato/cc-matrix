{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkVt44jfD6bXh8kGuL9M","type":"message","role":"assistant","content":[{"type":"text","text":"Now the hook and the driver. For Codes the driver uses its own timing, like a person watching the ghost beat, because the bot's frame-perfect timing doesn't transfer through the controls."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5745,"cache_read_input_tokens":372555,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5745},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"014ead0f-6796-48a8-9bc9-4c1e661a52c5","timestamp":"2026-11-05T21:34:29.359Z","request_id":"req_011CgkVt3Wk382Y23ymJDBvB"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkVt44jfD6bXh8kGuL9M","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0197ijVJRFBHLcbuwoaU1Fc8","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049; grep -n \"pub mod hands\" -A12 engine/crates/pav_core/src/input.rs | cut -c1-70; grep -n \"pub rotate\" engine/crates/pav_core/src/input.rs | cut -c1-70; python3 - <<'EOF'\nimport pathlib\n# ---- the sim's wish ----\np = pathlib.Path(\"engine/crates/pav_core/src/games/surgery/bot.rs\")\nt = p.read_text()\na = \"\"\"    fn ring_place(&self, tool: Tool) -> Option<usize> {\"\"\"\nb = \"\"\"    /// What slot 0's bot would press now: tests drive the real pad and mouse with this, so the\n    /// whole input path gets played through, not just the sim.\n    pub fn wish_json(&self) -> serde_json::Value {\n        let w = self.bot_input(0, self.bot_skill);\n        let s = &self.surgeons[0];\n        serde_json::json!({\n            \"aim\": [w.aim.x, w.aim.y],\n            \"held\": w.held,\n            \"tool\": w.tool,\n            \"rotate\": w.rotate,\n            \"place\": self.ring_place(s.tool),\n            \"ghost\": self.op.code.as_ref().map(|c| c.ghost),\n            \"charge\": s.charge,\n        })\n    }\n\n    fn ring_place(&self, tool: Tool) -> Option<usize> {\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\np = pathlib.Path(\"engine/crates/pav_core/src/games/surgery/mod.rs\")\nt = p.read_text()\na = \"\"\"            \"line\": self.story.i,\n\"\"\"\nb = \"\"\"            \"line\": self.story.i,\n            \"wish\": self.wish_json(),\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- where the wish lands on screen ----\np = pathlib.Path(\"engine/crates/pav_app/src/product.rs\")\nt = p.read_text()\na = \"\"\"    ptr_scale: Vec2,\n\"\"\"\nb = \"\"\"    ptr_scale: Vec2,\n    view_size: Vec2,\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"            ptr_scale: Vec2::ONE,\n\"\"\"\nb = \"\"\"            ptr_scale: Vec2::ONE,\n            view_size: Vec2::ONE,\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"            p.ptr_scale = size / page_size;\n\"\"\"\nb = \"\"\"            p.ptr_scale = size / page_size;\n            p.view_size = size;\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"        v[\"drain_tune\"] = sim[\"drain_tune\"].clone();\n\"\"\"\nb = \"\"\"        v[\"drain_tune\"] = sim[\"drain_tune\"].clone();\n        // Where the bot's wish lands on the canvas, 0..1: tests aim the real mouse there.\n        if let Some(aim) = sim[\"wish\"][\"aim\"].as_array() {\n            let at = |i: usize| aim.get(i).and_then(|x| x.as_f64()).unwrap_or(0.0) as f32;\n            let cam = self.rig.data(p.view_size.x / p.view_size.y.max(1.0));\n            let ndc = (cam.proj * cam.view).project_point3(glam::Vec3::new(at(0), 0.55, at(1)));\n            v[\"wish_px\"] = serde_json::json!([(ndc.x + 1.0) / 2.0, (1.0 - ndc.y) / 2.0]);\n        }\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- run_all: the long playthrough ----\np = pathlib.Path(\"tests/run_all.py\")\nt = p.read_text()\na = \"\"\"usage: python3 tests/run_all.py [--rust] [--web] [--hub]    (no flags: all of it)\n\"\"\"\nb = \"\"\"usage: python3 tests/run_all.py [--rust] [--web] [--hub] [--play]    (no flags: all but --play)\n--play plays the whole campaign in the browser through the real pad and the real mouse: about an hour.\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"if not args or \"--hub\" in args:\n    module(\"hub_tests\")\n\"\"\"\nb = \"\"\"if not args or \"--hub\" in args:\n    module(\"hub_tests\")\nif \"--play\" in args:\n    module(\"play_tests\")\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- hub: N copies ----\np = pathlib.Path(\"tests/browser/hub_tests.py\")\nt = p.read_text()\nstart = t.index(\"            # Two copies: a client's input moves its cursor on the host; both see the same vitals.\")\nend = t.index(\"            # Outside a session: the title appears, the game is unaffected.\")\nnew = '''            # Two copies, then four: every client's input moves its cursor on the host, and all of\n            # them see the same vitals, each drawing frames of its own.\n            for players in (2, 4):\n                try:\n                    copies(b, base, players)\n                    passed += 1\n                except Exception as e:\n                    failed += 1\n                    print(f\"FAIL {players} copies: {e}\")\n'''\nt = t[:start] + new + t[end:]\na = \"\"\"def main():\n    passed = failed = 0\n\"\"\"\nb = '''def copies(b, base, players):\n    \"\"\"A real round: a real mouse over each client's frame, read from every copy's own state.\"\"\"\n    wait_for_memory(3.0 if players == 2 else 4.0)\n    ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&players={players}&auto=1&limit=150&play=120000\")\n    deadline = time.time() + (400 if players == 2 else 560)\n    moved, first, seen = set(), None, []\n    same = drawn = seated = False\n    host, clients, turn, spread = None, [], 0, None\n    want = set(range(1, players))\n    while time.time() < deadline and not (moved == want and same and drawn and seated):\n        frames = [f for f in page.frames if \"/game.html\" in f.url]\n        st = []\n        for f in frames:\n            try:\n                st.append(f.evaluate(\"window.__game ? window.__game.status() : null\"))\n            except Exception:\n                st.append(None)\n        seen = [(s and s[\"screen\"], s and s[\"scene\"], s and s[\"stage\"]) for s in st]\n        pairs = [(f, s) for f, s in zip(frames, st) if s]\n        host = next((x for x in pairs if \"codeblue\" in x[1][\"scene\"]), None)\n        clients = [x for x in pairs if \"mirror\" in x[1][\"scene\"]]\n        if host and len(clients) == players - 1 and host[1][\"stage\"] == \"Op\" and all(c[1][\"stage\"] == \"Op\" for c in clients):\n            turn += 1\n            target = clients[turn % len(clients)]\n            box = target[0].frame_element().bounding_box()\n            tick = time.time() % 10\n            page.mouse.move(box[\"x\"] + box[\"width\"] * (0.3 + tick * 0.03), box[\"y\"] + box[\"height\"] * 0.45)\n            cur = host[1][\"sim\"][\"cursors\"]\n            first = first or cur\n            for slot in want:\n                if abs(cur[slot][0] - first[slot][0]) + abs(cur[slot][1] - first[slot][1]) > 0.01:\n                    moved.add(slot)\n            spread = max(abs(host[1][\"vitals\"] - c[1][\"vitals\"]) for c in clients)\n            same = spread < 8.0\n            drawn = all(s[\"frames\"] > 0 for _, s in pairs)\n            seated = sum(1 for x in host[1][\"sim\"][\"present\"] if x) == players\n        if page.evaluate(\"document.body.dataset.complete === 'true'\"):\n            break\n        time.sleep(0.4)\n    assert host and len(clients) == players - 1, f\"never reached play: {seen}\"\n    assert moved == want, f\"hands reached the host from slots {sorted(moved)} of {sorted(want)}: {host[1]['sim']['cursors']}\"\n    assert same, f\"vitals apart by {spread}\"\n    assert drawn, \"a copy never drew a frame\"\n    assert seated, f\"seats on the host: {host[1]['sim']['present']}\"\n    ctx.close()\n\n\ndef main():\n    passed = failed = 0\n'''\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- the long playthrough ----\npathlib.Path(\"tests/browser/play_tests.py\").write_text('''\"\"\"The whole campaign, New Game to the last line, through the real input path in the real page.\n\nEach frame reads what the bot would do (`wish`), then does it with the stub pad or with real mouse and\nkey events, so everything between gilrs or winit and the sim gets played: menus, story, flicks, the\nstick's curve and assist, the trigger, gifts, bones, Codes, results, deaths and retries. The bot's wish\nisn't a person, and frames here are slow, so this proves the controls can finish the game, not that the\ngame feels right. Prints only failures; progress goes to tests/out/play_<device>.log.\n\nusage: python3 play_tests.py [pad] [mouse] [case=<n>]\n\"\"\"\nimport json\nimport math\nimport sys\nimport time\n\nfrom common import ARGS, CRASHED, OUT, frames, open_game, status, sync_playwright, wait_for_memory\n\nUSE, CANCEL, PRECISION, GIFT, DEFIB = 0, 0, 0, 0, 0  # set below, from the engine's bits\nBITS = json.loads(\"\"\"HANDS_JSON\"\"\")\nUSE, CANCEL, PRECISION, GIFT, DEFIB = BITS[\"USE\"], BITS[\"CANCEL\"], BITS[\"PRECISION\"], BITS[\"GIFT\"], BITS[\"DEFIB\"]\nVIEW = (480, 270)\nLIMIT = 3 * 3600\n\n\nclass Pad:\n    \"\"\"A DualSense in the standard mapping.\"\"\"\n\n    name = \"pad\"\n    pad = True\n\n    def __init__(self, page):\n        self.page = page\n        self.sent = {}\n\n    def _set(self, js_key, js):\n        if self.sent.get(js_key) != js:\n            self.sent[js_key] = js\n            self.page.evaluate(js)\n\n    def confirm(self):\n        self.page.evaluate(\"__padHit(0,1)\")\n        frames(self.page, 2)\n        self.page.evaluate(\"__padHit(0,0)\")\n        frames(self.page, 2)\n\n    def aim(self, s, w):\n        cur, want = s[\"cursor\"], w[\"aim\"]\n        dx, dz = want[0] - cur[0], want[1] - cur[1]\n        d = math.hypot(dx, dz)\n        dt = min(0.25, 1.0 / max(s[\"fps\"], 1.0))\n        mag = 0.0 if d < 0.04 else min(1.0, max(0.25, (d / (15.0 * dt)) ** (1 / 2.2)))\n        ax = dx / d * mag if d > 0 else 0.0\n        az = dz / d * mag if d > 0 else 0.0\n        self._set(\"rs\", f\"__padAxis(2,{ax:.3f});__padAxis(3,{az:.3f})\")\n\n    def tool(self, w):\n        if w[\"tool\"] >= 0 and w[\"tool\"] != w[\"place\"]:\n            a = w[\"tool\"] * math.pi / 4\n            self._set(\"ls\", f\"__padAxis(0,{math.sin(a) * 0.95:.3f});__padAxis(1,{-math.cos(a) * 0.95:.3f})\")\n        else:\n            self._set(\"ls\", \"__padAxis(0,0);__padAxis(1,0)\")\n\n    def hands(self, held, rotate):\n        defib = held & DEFIB\n        self._set(\"r2\", f\"__padHit(7,{1 if held & USE or defib else 0})\")\n        self._set(\"l2\", f\"__padHit(6,{1 if held & PRECISION or defib else 0})\")\n        self._set(\"tri\", f\"__padHit(3,{1 if held & GIFT else 0})\")\n        self._set(\"l1\", f\"__padHit(4,{1 if rotate < 0 else 0})\")\n        self._set(\"r1\", f\"__padHit(5,{1 if rotate > 0 else 0})\")\n\n\nclass Mouse:\n    \"\"\"A mouse, and the keys a PC player expects.\"\"\"\n\n    name = \"mouse\"\n    pad = False\n\n    def __init__(self, page):\n        self.page = page\n        self.left = self.right = self.space = False\n\n    def confirm(self):\n        self.page.mouse.move(VIEW[0] * 0.5, VIEW[1] * 0.5)\n        self.page.mouse.down()\n        frames(self.page, 2)\n        self.page.mouse.up()\n        frames(self.page, 2)\n\n    def menu(self):\n        self.page.keyboard.press(\"Enter\", delay=250)\n        frames(self.page, 2)\n\n    def aim(self, s, w):\n        px = s.get(\"wish_px\")\n        if px:\n            self.page.mouse.move(px[0] * VIEW[0], px[1] * VIEW[1])\n\n    def tool(self, w):\n        if w[\"tool\"] >= 0 and w[\"tool\"] != w[\"place\"]:\n            self.page.keyboard.press(str(w[\"tool\"] + 1), delay=120)\n\n    def hands(self, held, rotate):\n        defib = held & DEFIB\n        left, right = bool(held & USE or defib), bool(defib)\n        if left != self.left:\n            (self.page.mouse.down if left else self.page.mouse.up)()\n            self.left = left\n        if right != self.right:\n            (self.page.mouse.down if right else self.page.mouse.up)(button=\"right\")\n            self.right = right\n        space = bool(held & GIFT)\n        if space != self.space:\n            (self.page.keyboard.down if space else self.page.keyboard.up)(\"Space\")\n            self.space = space\n        if rotate:\n            self.page.mouse.wheel(0, -40 if rotate > 0 else 40)\n\n\ndef code_hands(s, w):\n    \"\"\"A Code by eye: charge, then let go so the release lands as the ghost crosses the line.\"\"\"\n    ghost, charge = w[\"ghost\"], w[\"charge\"]\n    if ghost is None:\n        return 0\n    if charge < 1.0:\n        return DEFIB\n    ticks = 60.0 / max(s[\"fps\"], 7.5)\n    lead = 2.0 * ticks / 60.0\n    until = ((0.5 - ghost) % 1.0) * 1.1\n    return 0 if until <= lead + 0.04 else DEFIB\n\n\ndef play(b, device, case=None, saved=None):\n    \"\"\"Plays until the campaign is won. Returns (done, why, saved progress for a retry).\"\"\"\n    ctx, page, errs = open_game(b, VIEW[0], VIEW[1], pad=device.pad, storage=saved)\n    d = device(page)\n    log = open(OUT / f\"play_{d.name}.log\", \"a\")\n    started, last_log, deaths, last_stage, won = time.time(), 0.0, 0, None, 0\n    menu_mouse = d.name == \"mouse\"\n    try:\n        while time.time() - started < LIMIT:\n            s = status(page)\n            if not s or \"stage\" not in s:\n                time.sleep(0.2)\n                continue\n            if not saved and time.time() - last_log > 20:\n                saved_now = page.evaluate(\"localStorage.getItem('surgery-save')\")\n            sim, stage, screen = s.get(\"sim\") or {}, s[\"stage\"], s[\"screen\"]\n            now = time.time()\n            if now - last_log > 20:\n                last_log = now\n                saved = page.evaluate(\"localStorage.getItem('surgery-save')\") or saved\n                print(f\"{int(now - started):5}s {screen} {s.get('scene')} {stage} case {sim.get('case')} phase {sim.get('phase')} \"\n                      f\"vitals {s.get('vitals')} won {sim.get('cases_won')} deaths {deaths} fps {s.get('fps')}\", file=log, flush=True)\n            won = max(won, sim.get(\"cases_won\") or 0)\n            if sim.get(\"outcome\") == \"won\" or (case is not None and stage == \"Results\"):\n                assert not errs, errs[:3]\n                print(f\"{int(now - started):5}s DONE won {won} deaths {deaths}\", file=log, flush=True)\n                return True, \"\", saved\n            if stage != last_stage and stage == \"Dead\":\n                deaths += 1\n            last_stage = stage\n            if screen in (\"Title\", \"Menu\", \"Difficulty\"):\n                if case is not None and screen == \"Menu\":\n                    page.evaluate(f\"__game.do(JSON.stringify({{load:'surgery/case/{case}'}}));__game.do(JSON.stringify({{screen:'Playing'}}))\")\n                    frames(page, 2)\n                elif menu_mouse:\n                    d.menu()\n                else:\n                    d.confirm()\n                continue\n            if screen == \"Pause\":\n                page.keyboard.press(\"Escape\", delay=200)\n                continue\n            if stage in (\"Story\", \"Chart\", \"Results\"):\n                d.hands(0, 0)\n                d.confirm()\n                continue\n            if stage == \"Dead\":\n                d.hands(0, 0)\n                if menu_mouse:\n                    d.menu()\n                else:\n                    d.confirm()\n                continue\n            w = sim.get(\"wish\")\n            if not w:\n                continue\n            if stage == \"Code\":\n                d.hands(code_hands(s, w), 0)\n                continue\n            d.tool(w)\n            d.aim(s, w)\n            d.hands(w[\"held\"], w[\"rotate\"])\n        return False, f\"out of time: {status(page)}\", saved\n    except Exception as e:\n        return False, str(e), saved\n    finally:\n        log.close()\n        ctx.close()\n\n\ndef main():\n    args = sys.argv[1:] if __name__ == \"__main__\" else []\n    case = next((int(a[5:]) for a in args if a.startswith(\"case=\")), None)\n    devices = [c for c, n in ((Pad, \"pad\"), (Mouse, \"mouse\")) if n in args or not any(x in args for x in (\"pad\", \"mouse\"))]\n    passed = failed = 0\n    with sync_playwright() as p:\n        for device in devices:\n            saved, ok, why = None, False, \"\"\n            for attempt in range(12):\n                wait_for_memory(3.0)\n                b = p.chromium.launch(args=ARGS)\n                try:\n                    ok, why, saved = play(b, device, case, saved)\n                finally:\n                    try:\n                        b.close()\n                    except Exception:\n                        pass\n                # Out of memory ends the browser: that's the machine. Pick up from the save.\n                if ok or not any(c in why for c in CRASHED):\n                    break\n                time.sleep(20)\n            if ok:\n                passed += 1\n            else:\n                failed += 1\n                print(f\"FAIL the campaign with the {device.name}: {why[:800]}\")\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(main())\n''')\nEOF\n","description":"Add the wish hook, four-copy hub test, and campaign driver"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5745,"cache_read_input_tokens":372555,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5745},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"21897d1a-8282-4f8d-9bfd-cd40bd6f223a","timestamp":"2026-11-05T21:35:20.005Z","request_id":"req_011CgkVt3Wk382Y23ymJDBvB","wire_tool_inputs":{"toolu_0197ijVJRFBHLcbuwoaU1Fc8":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049; grep -n \"pub mod hands\" -A12 engine/crates/pav_core/src/input.rs | cut -c1-70; grep -n \"pub rotate\" engine/crates/pav_core/src/input.rs | cut -c1-70; python3 - <<'EOF'\nimport pathlib\n# ---- the sim's wish ----\np = pathlib.Path(\"engine/crates/pav_core/src/games/surgery/bot.rs\")\nt = p.read_text()\na = \"\"\"    fn ring_place(&self, tool: Tool) -> Option<usize> {\"\"\"\nb = \"\"\"    /// What slot 0's bot would press now: tests drive the real pad and mouse with this, so the\n    /// whole input path gets played through, not just the sim.\n    pub fn wish_json(&self) -> serde_json::Value {\n        let w = self.bot_input(0, self.bot_skill);\n        let s = &self.surgeons[0];\n        serde_json::json!({\n            \"aim\": [w.aim.x, w.aim.y],\n            \"held\": w.held,\n            \"tool\": w.tool,\n            \"rotate\": w.rotate,\n            \"place\": self.ring_place(s.tool),\n            \"ghost\": self.op.code.as_ref().map(|c| c.ghost),\n            \"charge\": s.charge,\n        })\n    }\n\n    fn ring_place(&self, tool: Tool) -> Option<usize> {\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\np = pathlib.Path(\"engine/crates/pav_core/src/games/surgery/mod.rs\")\nt = p.read_text()\na = \"\"\"            \"line\": self.story.i,\n\"\"\"\nb = \"\"\"            \"line\": self.story.i,\n            \"wish\": self.wish_json(),\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- where the wish lands on screen ----\np = pathlib.Path(\"engine/crates/pav_app/src/product.rs\")\nt = p.read_text()\na = \"\"\"    ptr_scale: Vec2,\n\"\"\"\nb = \"\"\"    ptr_scale: Vec2,\n    view_size: Vec2,\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"            ptr_scale: Vec2::ONE,\n\"\"\"\nb = \"\"\"            ptr_scale: Vec2::ONE,\n            view_size: Vec2::ONE,\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"            p.ptr_scale = size / page_size;\n\"\"\"\nb = \"\"\"            p.ptr_scale = size / page_size;\n            p.view_size = size;\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"        v[\"drain_tune\"] = sim[\"drain_tune\"].clone();\n\"\"\"\nb = \"\"\"        v[\"drain_tune\"] = sim[\"drain_tune\"].clone();\n        // Where the bot's wish lands on the canvas, 0..1: tests aim the real mouse there.\n        if let Some(aim) = sim[\"wish\"][\"aim\"].as_array() {\n            let at = |i: usize| aim.get(i).and_then(|x| x.as_f64()).unwrap_or(0.0) as f32;\n            let cam = self.rig.data(p.view_size.x / p.view_size.y.max(1.0));\n            let ndc = (cam.proj * cam.view).project_point3(glam::Vec3::new(at(0), 0.55, at(1)));\n            v[\"wish_px\"] = serde_json::json!([(ndc.x + 1.0) / 2.0, (1.0 - ndc.y) / 2.0]);\n        }\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- run_all: the long playthrough ----\np = pathlib.Path(\"tests/run_all.py\")\nt = p.read_text()\na = \"\"\"usage: python3 tests/run_all.py [--rust] [--web] [--hub]    (no flags: all of it)\n\"\"\"\nb = \"\"\"usage: python3 tests/run_all.py [--rust] [--web] [--hub] [--play]    (no flags: all but --play)\n--play plays the whole campaign in the browser through the real pad and the real mouse: about an hour.\n\"\"\"\nassert t.count(a)==1\nt = t.replace(a,b)\na = \"\"\"if not args or \"--hub\" in args:\n    module(\"hub_tests\")\n\"\"\"\nb = \"\"\"if not args or \"--hub\" in args:\n    module(\"hub_tests\")\nif \"--play\" in args:\n    module(\"play_tests\")\n\"\"\"\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- hub: N copies ----\np = pathlib.Path(\"tests/browser/hub_tests.py\")\nt = p.read_text()\nstart = t.index(\"            # Two copies: a client's input moves its cursor on the host; both see the same vitals.\")\nend = t.index(\"            # Outside a session: the title appears, the game is unaffected.\")\nnew = '''            # Two copies, then four: every client's input moves its cursor on the host, and all of\n            # them see the same vitals, each drawing frames of its own.\n            for players in (2, 4):\n                try:\n                    copies(b, base, players)\n                    passed += 1\n                except Exception as e:\n                    failed += 1\n                    print(f\"FAIL {players} copies: {e}\")\n'''\nt = t[:start] + new + t[end:]\na = \"\"\"def main():\n    passed = failed = 0\n\"\"\"\nb = '''def copies(b, base, players):\n    \"\"\"A real round: a real mouse over each client's frame, read from every copy's own state.\"\"\"\n    wait_for_memory(3.0 if players == 2 else 4.0)\n    ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&players={players}&auto=1&limit=150&play=120000\")\n    deadline = time.time() + (400 if players == 2 else 560)\n    moved, first, seen = set(), None, []\n    same = drawn = seated = False\n    host, clients, turn, spread = None, [], 0, None\n    want = set(range(1, players))\n    while time.time() < deadline and not (moved == want and same and drawn and seated):\n        frames = [f for f in page.frames if \"/game.html\" in f.url]\n        st = []\n        for f in frames:\n            try:\n                st.append(f.evaluate(\"window.__game ? window.__game.status() : null\"))\n            except Exception:\n                st.append(None)\n        seen = [(s and s[\"screen\"], s and s[\"scene\"], s and s[\"stage\"]) for s in st]\n        pairs = [(f, s) for f, s in zip(frames, st) if s]\n        host = next((x for x in pairs if \"codeblue\" in x[1][\"scene\"]), None)\n        clients = [x for x in pairs if \"mirror\" in x[1][\"scene\"]]\n        if host and len(clients) == players - 1 and host[1][\"stage\"] == \"Op\" and all(c[1][\"stage\"] == \"Op\" for c in clients):\n            turn += 1\n            target = clients[turn % len(clients)]\n            box = target[0].frame_element().bounding_box()\n            tick = time.time() % 10\n            page.mouse.move(box[\"x\"] + box[\"width\"] * (0.3 + tick * 0.03), box[\"y\"] + box[\"height\"] * 0.45)\n            cur = host[1][\"sim\"][\"cursors\"]\n            first = first or cur\n            for slot in want:\n                if abs(cur[slot][0] - first[slot][0]) + abs(cur[slot][1] - first[slot][1]) > 0.01:\n                    moved.add(slot)\n            spread = max(abs(host[1][\"vitals\"] - c[1][\"vitals\"]) for c in clients)\n            same = spread < 8.0\n            drawn = all(s[\"frames\"] > 0 for _, s in pairs)\n            seated = sum(1 for x in host[1][\"sim\"][\"present\"] if x) == players\n        if page.evaluate(\"document.body.dataset.complete === 'true'\"):\n            break\n        time.sleep(0.4)\n    assert host and len(clients) == players - 1, f\"never reached play: {seen}\"\n    assert moved == want, f\"hands reached the host from slots {sorted(moved)} of {sorted(want)}: {host[1]['sim']['cursors']}\"\n    assert same, f\"vitals apart by {spread}\"\n    assert drawn, \"a copy never drew a frame\"\n    assert seated, f\"seats on the host: {host[1]['sim']['present']}\"\n    ctx.close()\n\n\ndef main():\n    passed = failed = 0\n'''\nassert t.count(a)==1\np.write_text(t.replace(a,b))\n\n# ---- the long playthrough ----\npathlib.Path(\"tests/browser/play_tests.py\").write_text('''\"\"\"The whole campaign, New Game to the last line, through the real input path in the real page.\n\nEach frame reads what the bot would do (`wish`), then does it with the stub pad or with real mouse and\nkey events, so everything between gilrs or winit and the sim gets played: menus, story, flicks, the\nstick's curve and assist, the trigger, gifts, bones, Codes, results, deaths and retries. The bot's wish\nisn't a person, and frames here are slow, so this proves the controls can finish the game, not that the\ngame feels right. Prints only failures; progress goes to tests/out/play_<device>.log.\n\nusage: python3 play_tests.py [pad] [mouse] [case=<n>]\n\"\"\"\nimport json\nimport math\nimport sys\nimport time\n\nfrom common import ARGS, CRASHED, OUT, frames, open_game, status, sync_playwright, wait_for_memory\n\nUSE, CANCEL, PRECISION, GIFT, DEFIB = 0, 0, 0, 0, 0  # set below, from the engine's bits\nBITS = json.loads(\"\"\"HANDS_JSON\"\"\")\nUSE, CANCEL, PRECISION, GIFT, DEFIB = BITS[\"USE\"], BITS[\"CANCEL\"], BITS[\"PRECISION\"], BITS[\"GIFT\"], BITS[\"DEFIB\"]\nVIEW = (480, 270)\nLIMIT = 3 * 3600\n\n\nclass Pad:\n    \"\"\"A DualSense in the standard mapping.\"\"\"\n\n    name = \"pad\"\n    pad = True\n\n    def __init__(self, page):\n        self.page = page\n        self.sent = {}\n\n    def _set(self, js_key, js):\n        if self.sent.get(js_key) != js:\n            self.sent[js_key] = js\n            self.page.evaluate(js)\n\n    def confirm(self):\n        self.page.evaluate(\"__padHit(0,1)\")\n        frames(self.page, 2)\n        self.page.evaluate(\"__padHit(0,0)\")\n        frames(self.page, 2)\n\n    def aim(self, s, w):\n        cur, want = s[\"cursor\"], w[\"aim\"]\n        dx, dz = want[0] - cur[0], want[1] - cur[1]\n        d = math.hypot(dx, dz)\n        dt = min(0.25, 1.0 / max(s[\"fps\"], 1.0))\n        mag = 0.0 if d < 0.04 else min(1.0, max(0.25, (d / (15.0 * dt)) ** (1 / 2.2)))\n        ax = dx / d * mag if d > 0 else 0.0\n        az = dz / d * mag if d > 0 else 0.0\n        self._set(\"rs\", f\"__padAxis(2,{ax:.3f});__padAxis(3,{az:.3f})\")\n\n    def tool(self, w):\n        if w[\"tool\"] >= 0 and w[\"tool\"] != w[\"place\"]:\n            a = w[\"tool\"] * math.pi / 4\n            self._set(\"ls\", f\"__padAxis(0,{math.sin(a) * 0.95:.3f});__padAxis(1,{-math.cos(a) * 0.95:.3f})\")\n        else:\n            self._set(\"ls\", \"__padAxis(0,0);__padAxis(1,0)\")\n\n    def hands(self, held, rotate):\n        defib = held & DEFIB\n        self._set(\"r2\", f\"__padHit(7,{1 if held & USE or defib else 0})\")\n        self._set(\"l2\", f\"__padHit(6,{1 if held & PRECISION or defib else 0})\")\n        self._set(\"tri\", f\"__padHit(3,{1 if held & GIFT else 0})\")\n        self._set(\"l1\", f\"__padHit(4,{1 if rotate < 0 else 0})\")\n        self._set(\"r1\", f\"__padHit(5,{1 if rotate > 0 else 0})\")\n\n\nclass Mouse:\n    \"\"\"A mouse, and the keys a PC player expects.\"\"\"\n\n    name = \"mouse\"\n    pad = False\n\n    def __init__(self, page):\n        self.page = page\n        self.left = self.right = self.space = False\n\n    def confirm(self):\n        self.page.mouse.move(VIEW[0] * 0.5, VIEW[1] * 0.5)\n        self.page.mouse.down()\n        frames(self.page, 2)\n        self.page.mouse.up()\n        frames(self.page, 2)\n\n    def menu(self):\n        self.page.keyboard.press(\"Enter\", delay=250)\n        frames(self.page, 2)\n\n    def aim(self, s, w):\n        px = s.get(\"wish_px\")\n        if px:\n            self.page.mouse.move(px[0] * VIEW[0], px[1] * VIEW[1])\n\n    def tool(self, w):\n        if w[\"tool\"] >= 0 and w[\"tool\"] != w[\"place\"]:\n            self.page.keyboard.press(str(w[\"tool\"] + 1), delay=120)\n\n    def hands(self, held, rotate):\n        defib = held & DEFIB\n        left, right = bool(held & USE or defib), bool(defib)\n        if left != self.left:\n            (self.page.mouse.down if left else self.page.mouse.up)()\n            self.left = left\n        if right != self.right:\n            (self.page.mouse.down if right else self.page.mouse.up)(button=\"right\")\n            self.right = right\n        space = bool(held & GIFT)\n        if space != self.space:\n            (self.page.keyboard.down if space else self.page.keyboard.up)(\"Space\")\n            self.space = space\n        if rotate:\n            self.page.mouse.wheel(0, -40 if rotate > 0 else 40)\n\n\ndef code_hands(s, w):\n    \"\"\"A Code by eye: charge, then let go so the release lands as the ghost crosses the line.\"\"\"\n    ghost, charge = w[\"ghost\"], w[\"charge\"]\n    if ghost is None:\n        return 0\n    if charge < 1.0:\n        return DEFIB\n    ticks = 60.0 / max(s[\"fps\"], 7.5)\n    lead = 2.0 * ticks / 60.0\n    until = ((0.5 - ghost) % 1.0) * 1.1\n    return 0 if until <= lead + 0.04 else DEFIB\n\n\ndef play(b, device, case=None, saved=None):\n    \"\"\"Plays until the campaign is won. Returns (done, why, saved progress for a retry).\"\"\"\n    ctx, page, errs = open_game(b, VIEW[0], VIEW[1], pad=device.pad, storage=saved)\n    d = device(page)\n    log = open(OUT / f\"play_{d.name}.log\", \"a\")\n    started, last_log, deaths, last_stage, won = time.time(), 0.0, 0, None, 0\n    menu_mouse = d.name == \"mouse\"\n    try:\n        while time.time() - started < LIMIT:\n            s = status(page)\n            if not s or \"stage\" not in s:\n                time.sleep(0.2)\n                continue\n            if not saved and time.time() - last_log > 20:\n                saved_now = page.evaluate(\"localStorage.getItem('surgery-save')\")\n            sim, stage, screen = s.get(\"sim\") or {}, s[\"stage\"], s[\"screen\"]\n            now = time.time()\n            if now - last_log > 20:\n                last_log = now\n                saved = page.evaluate(\"localStorage.getItem('surgery-save')\") or saved\n                print(f\"{int(now - started):5}s {screen} {s.get('scene')} {stage} case {sim.get('case')} phase {sim.get('phase')} \"\n                      f\"vitals {s.get('vitals')} won {sim.get('cases_won')} deaths {deaths} fps {s.get('fps')}\", file=log, flush=True)\n            won = max(won, sim.get(\"cases_won\") or 0)\n            if sim.get(\"outcome\") == \"won\" or (case is not None and stage == \"Results\"):\n                assert not errs, errs[:3]\n                print(f\"{int(now - started):5}s DONE won {won} deaths {deaths}\", file=log, flush=True)\n                return True, \"\", saved\n            if stage != last_stage and stage == \"Dead\":\n                deaths += 1\n            last_stage = stage\n            if screen in (\"Title\", \"Menu\", \"Difficulty\"):\n                if case is not None and screen == \"Menu\":\n                    page.evaluate(f\"__game.do(JSON.stringify({{load:'surgery/case/{case}'}}));__game.do(JSON.stringify({{screen:'Playing'}}))\")\n                    frames(page, 2)\n                elif menu_mouse:\n                    d.menu()\n                else:\n                    d.confirm()\n                continue\n            if screen == \"Pause\":\n                page.keyboard.press(\"Escape\", delay=200)\n                continue\n            if stage in (\"Story\", \"Chart\", \"Results\"):\n                d.hands(0, 0)\n                d.confirm()\n                continue\n            if stage == \"Dead\":\n                d.hands(0, 0)\n                if menu_mouse:\n                    d.menu()\n                else:\n                    d.confirm()\n                continue\n            w = sim.get(\"wish\")\n            if not w:\n                continue\n            if stage == \"Code\":\n                d.hands(code_hands(s, w), 0)\n                continue\n            d.tool(w)\n            d.aim(s, w)\n            d.hands(w[\"held\"], w[\"rotate\"])\n        return False, f\"out of time: {status(page)}\", saved\n    except Exception as e:\n        return False, str(e), saved\n    finally:\n        log.close()\n        ctx.close()\n\n\ndef main():\n    args = sys.argv[1:] if __name__ == \"__main__\" else []\n    case = next((int(a[5:]) for a in args if a.startswith(\"case=\")), None)\n    devices = [c for c, n in ((Pad, \"pad\"), (Mouse, \"mouse\")) if n in args or not any(x in args for x in (\"pad\", \"mouse\"))]\n    passed = failed = 0\n    with sync_playwright() as p:\n        for device in devices:\n            saved, ok, why = None, False, \"\"\n            for attempt in range(12):\n                wait_for_memory(3.0)\n                b = p.chromium.launch(args=ARGS)\n                try:\n                    ok, why, saved = play(b, device, case, saved)\n                finally:\n                    try:\n                        b.close()\n                    except Exception:\n                        pass\n                # Out of memory ends the browser: that's the machine. Pick up from the save.\n                if ok or not any(c in why for c in CRASHED):\n                    break\n                time.sleep(20)\n            if ok:\n                passed += 1\n            else:\n                failed += 1\n                print(f\"FAIL the campaign with the {device.name}: {why[:800]}\")\n    return passed, failed\n\n\nif __name__ == \"__main__\":\n    print(main())\n''')\nEOF\n","description":"Add the wish hook, four-copy hub test, and campaign driver"}}}
