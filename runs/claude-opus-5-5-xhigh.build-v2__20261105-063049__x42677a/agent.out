rame = *i;\n                i.pressed = 0;\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame''','''                let mut frame = *i;\n                i.pressed = 0;\n                for s in &mut i.surgeons {\n                    s.pressed = 0;\n                }\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame.surgery = sh.surgery_cmds.lock().unwrap().pop_front();\n                frame''')\nopen(p,'w').write(s)\np='crates/pav_app/Cargo.toml'\ns=open(p).read()\ns=s.replace('''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\nweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n''','''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\njs-sys = \"0.3\"\nweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n''')\nopen(p,'w').write(s)\np='crates/pav_app/src/settings.rs'\ns=open(p).read()\ns=s.replace('''            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n            s.scene = \"town\".into();''','''            // The surgery game's title; other scenes are named with --scene.\n            s.scene = \"surgery/title\".into();''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/glyphs.rs'\ns=open(p).read()\ns=s.replace('''            Action::Auto => \"A\",\n            Action::More => \"M\",''','''            Action::Auto => \"M\",\n            Action::More => \"M\",''')\nopen(p,'w').write(s)\np='crates/pav_app/src/main.rs'\ns=open(p).read()\ns=s.replace('mod panel;\\n','mod hub;\\nmod panel;\\n')\ns=s.replace('mod platform;\\n','mod platform;\\nmod product;\\n')\ns=s.replace('platform::error_box(\"Shardfall could not start\"','platform::error_box(\"Diorama Center could not start\"')\nopen(p,'w').write(s)\np='crates/pav_app/src/app.rs'\ns=open(p).read()\ns=s.replace('''    init_started: bool,\n    pub fatal: Option<String>,\n}\n''','''    init_started: bool,\n    pub fatal: Option<String>,\n    /// The surgery game's own frame path.\n    pub(crate) product: Option<Box<crate::product::Product>>,\n}\n''')\ns=s.replace('''            init_started: false,\n            fatal: None,\n            settings,\n        };''','''            init_started: false,\n            fatal: None,\n            product: settings.scene.starts_with(\"surgery\").then(|| Box::new(crate::product::Product::new())),\n            settings,\n        };''')\ns=s.replace('''            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");''','''            let title = if self.product.is_some() { pav_ui::surgery::TITLE } else { \"Shardfall\" };\n            let mut attrs = Window::default_attributes().with_title(title);''')\ns=s.replace('''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n''','''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        if self.product.is_some() {\n            self.product_frame();\n            return;\n        }\n''')\ns=s.replace('''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {''','''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if self.product.is_some() {\n            self.product_event(el, event);\n            return;\n        }\n        if let WindowEvent::Touch(t) = &event {''')\ns=s.replace('''    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {''','''    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    pub(crate) fn resume_audio(&mut self) {''')\ns=s.replace('''pub struct App {\n    settings: Settings,\n    gfx: Option<Gfx>,\n    egui_ctx: egui::Context,\n    egui_state: Option<UiInput>,\n    host: Option<SimHost>,\n    rig: CameraRig,\n''','''pub struct App {\n    pub(crate) settings: Settings,\n    pub(crate) gfx: Option<Gfx>,\n    pub(crate) egui_ctx: egui::Context,\n    pub(crate) egui_state: Option<UiInput>,\n    pub(crate) host: Option<SimHost>,\n    pub(crate) rig: CameraRig,\n''')\ns=s.replace('''    app_settings: AppSettings,\n    builder: ViewBuilder,\n    input: Input,\n    panel: Panel,''','''    app_settings: AppSettings,\n    pub(crate) builder: ViewBuilder,\n    pub(crate) input: Input,\n    panel: Panel,''')\ns=s.replace('''    pub(crate) input: Input,\n    panel: Panel,\n    menu_open: bool,''','''    pub(crate) input: Input,\n    panel: Panel,\n    menu_open: bool,''')\ns=s.replace('''    editor: Editor,\n    audio: Option<pav_audio::AudioOut>,\n''','''    editor: Editor,\n    pub(crate) audio: Option<pav_audio::AudioOut>,\n''')\ns=s.replace('''    #[cfg(target_arch = \"wasm32\")]\n    audio_resumed: bool,\n    init_started: bool,''','''    #[cfg(target_arch = \"wasm32\")]\n    pub(crate) audio_resumed: bool,\n    init_started: bool,''')\ns=s.replace('''    started: Instant,\n    last: Instant,\n    fps: Fps,''','''    pub(crate) started: Instant,\n    pub(crate) last: Instant,\n    fps: Fps,''')\nopen(p,'w').write(s)\nEOF\ncat > crates/pav_app/src/product.rs <<'EOF'\n//! The surgery game's own frame path: when the scene is `surgery*`, `App::frame` and\n//! `App::window_event` branch here, past the demo's boot, panels, cards, hint bar, touch layer,\n//! F-keys, rewinding Backspace and bound keys. It reuses `Gfx`, `SimHost`, `ViewBuilder` and\n//! `CameraRig`.\n\nuse std::collections::HashSet;\n\nuse glam::{Vec2, Vec3};\nuse pav_audio::music::{MusicInput, Sequencer};\nuse pav_audio::voice::{self, Speaker, VoiceDef};\nuse pav_audio::{BUS_MUSIC, BUS_VOICES};\nuse pav_core::games::surgery::content;\nuse pav_core::games::surgery::field::{HazardKind, Tool};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::surgeon::{self, tray_place};\nuse pav_core::games::surgery::{Surgery, cue};\nuse pav_core::input::{SurgeonInput, SurgeryCmd, hands};\nuse pav_core::{Sim, SimEvent};\nuse pav_ui::Device;\nuse pav_ui::surgery::save::Save;\nuse pav_ui::surgery::{Screen, Shell, ShellCmd, ShellInput, style};\nuse web_time::Instant;\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::ActiveEventLoop;\nuse winit::keyboard::{KeyCode, PhysicalKey};\n\nuse crate::app::App;\n\n/// One pad's state this frame.\n#[derive(Clone, Copy, Debug, Default)]\npub struct PadState {\n    pub id: usize,\n    pub left: Vec2,\n    pub right: Vec2,\n    pub l2: f32,\n    pub r2: f32,\n    pub cross: bool,\n    pub circle: bool,\n    pub square: bool,\n    pub triangle: bool,\n    pub l1: bool,\n    pub r1: bool,\n    pub options: bool,\n    pub create: bool,\n    pub up: bool,\n    pub down: bool,\n    pub dleft: bool,\n    pub dright: bool,\n}\n\nimpl PadState {\n    fn any(&self) -> bool {\n        self.left.length() > 0.3\n            || self.right.length() > 0.3\n            || self.l2 > 0.1\n            || self.r2 > 0.1\n            || self.cross\n            || self.circle\n            || self.square\n            || self.triangle\n            || self.l1\n            || self.r1\n            || self.options\n            || self.up\n            || self.down\n            || self.dleft\n            || self.dright\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\n/// Reads every connected pad (up to four).\nfn read_pads(g: &mut gilrs::Gilrs) -> Vec<PadState> {\n    use gilrs::{Axis, Button};\n    while g.next_event().is_some() {}\n    let mut out = Vec::new();\n    for (id, gp) in g.gamepads().take(4) {\n        let val = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0);\n        out.push(PadState {\n            id: usize::from(id),\n            left: deadzone(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)), 0.18),\n            right: deadzone(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)), 0.16),\n            l2: val(Button::LeftTrigger2),\n            r2: val(Button::RightTrigger2),\n            cross: gp.is_pressed(Button::South),\n            circle: gp.is_pressed(Button::East),\n            square: gp.is_pressed(Button::West),\n            triangle: gp.is_pressed(Button::North),\n            l1: gp.is_pressed(Button::LeftTrigger),\n            r1: gp.is_pressed(Button::RightTrigger),\n            options: gp.is_pressed(Button::Start),\n            create: gp.is_pressed(Button::Select),\n            up: gp.is_pressed(Button::DPadUp),\n            down: gp.is_pressed(Button::DPadDown),\n            dleft: gp.is_pressed(Button::DPadLeft),\n            dright: gp.is_pressed(Button::DPadRight),\n        });\n    }\n    out\n}\n\n/// A slot's device-side state.\n#[derive(Clone, Copy, Debug, Default)]\nstruct Hands {\n    aim: Vec2,\n    assist: bool,\n    tool_hold: i8,\n    tool_left: u8,\n    ring: usize,\n    held: u8,\n    rotate_left: f32,\n    rotate: i8,\n}\n\npub struct Product {\n    pub shell: Shell,\n    keys: HashSet<KeyCode>,\n    key_edges: HashSet<KeyCode>,\n    mouse_pos: Vec2,\n    mouse_moved: bool,\n    mouse_left: bool,\n    mouse_right: bool,\n    left_edge: bool,\n    right_edge: bool,\n    wheel: f32,\n    tap: Option<Vec2>,\n    finger_used: bool,\n    key_used: bool,\n    pad_used: bool,\n    pads: Vec<PadState>,\n    prev_pads: Vec<PadState>,\n    /// The slot each pad is at, by pad id.\n    pad_slot: Vec<(usize, usize)>,\n    hands: [Hands; 4],\n    device: Device,\n    seq: Sequencer,\n    story_voice: Speaker,\n    op_voice: Speaker,\n    fade: f32,\n    last_stage: Stage,\n    last_story: String,\n    start: Instant,\n    rumble_t: f32,\n    last_beats: u32,\n    snapshot: Option<Box<pav_core::sim::SimState>>,\n    pub hook: crate::hub::Hook,\n    pub hub: crate::hub::Hub,\n    frames: u32,\n    fps_t: f32,\n    fps: f32,\n    last_tick: u64,\n    tps: f32,\n    settings_sent: bool,\n    fine_pointer: bool,\n    first_frame_done: bool,\n    last_cursor_visible: bool,\n    seed: u64,\n}\n\nfn load_save() -> Save {\n    crate::hub::load_text().and_then(|t| Save::parse(&t)).unwrap_or_default()\n}\n\nimpl Product {\n    pub fn new() -> Self {\n        let mut shell = Shell::new(load_save());\n        if let Some(a) = crate::hub::about_json().and_then(|t| pav_ui::surgery::about::About::parse(&t)) {\n            shell.about = a;\n        }\n        let fine = crate::hub::fine_pointer();\n        shell.touch_only = !fine;\n        Self {\n            shell,\n            keys: HashSet::new(),\n            key_edges: HashSet::new(),\n            mouse_pos: Vec2::ZERO,\n            mouse_moved: false,\n            mouse_left: false,\n            mouse_right: false,\n            left_edge: false,\n            right_edge: false,\n            wheel: 0.0,\n            tap: None,\n            finger_used: false,\n            key_used: false,\n            pad_used: false,\n            pads: Vec::new(),\n            prev_pads: Vec::new(),\n            pad_slot: Vec::new(),\n            hands: Default::default(),\n            device: if fine { Device::KeyboardMouse } else { Device::Touch },\n            seq: Sequencer::new(),\n            story_voice: Speaker::default(),\n            op_voice: Speaker::default(),\n            fade: 1.0,\n            last_stage: Stage::Title,\n            last_story: String::new(),\n            start: Instant::now(),\n            rumble_t: 0.0,\n            last_beats: 0,\n            snapshot: None,\n            hook: Default::default(),\n            hub: crate::hub::Hub::new(),\n            frames: 0,\n            fps_t: 0.0,\n            fps: 0.0,\n            last_tick: 0,\n            tps: 0.0,\n            settings_sent: false,\n            fine_pointer: fine,\n            first_frame_done: false,\n            last_cursor_visible: true,\n            seed: 1,\n        }\n    }\n\n    fn key(&self, k: KeyCode) -> bool {\n        self.keys.contains(&k)\n    }\n    fn tapped(&self, k: KeyCode) -> bool {\n        self.key_edges.contains(&k)\n    }\n\n    fn pad_edge(&self, f: impl Fn(&PadState) -> bool) -> bool {\n        self.pads.iter().any(|p| f(p) && !self.prev_pads.iter().find(|q| q.id == p.id).is_some_and(|q| f(q)))\n    }\n\n    /// The input for the shell's menus.\n    fn shell_input(&mut self, dt: f32, ppp: f32) -> ShellInput {\n        use KeyCode::*;\n        let k = |c: KeyCode| self.key(c);\n        let t = |c: KeyCode| self.tapped(c);\n        let stick = self.pads.iter().fold(Vec2::ZERO, |a, p| if p.left.length() > a.length() { p.left } else { a });\n        let confirm = t(Enter) || t(NumpadEnter) || self.pad_edge(|p| p.cross);\n        let pad_pause = self.pads.iter().any(|p| p.options && !p.create) && self.pad_edge(|p| p.options);\n        let any_pad = self.pads.iter().any(|p| p.any());\n        let any_key = !self.key_edges.is_empty();\n        let pointer = (self.mouse_pos.x >= 0.0).then(|| egui::pos2(self.mouse_pos.x / ppp, self.mouse_pos.y / ppp));\n        let story = self.shell.screen == Screen::Playing && self.last_stage == Stage::Story;\n        ShellInput {\n            up: k(ArrowUp) || k(KeyW) || stick.y > 0.5 || self.pads.iter().any(|p| p.up),\n            down: k(ArrowDown) || k(KeyS) || stick.y < -0.5 || self.pads.iter().any(|p| p.down),\n            left: k(ArrowLeft) || k(KeyA) || stick.x < -0.5 || self.pads.iter().any(|p| p.dleft),\n            right: k(ArrowRight) || k(KeyD) || stick.x > 0.5 || self.pads.iter().any(|p| p.dright),\n            confirm: confirm || (story && (t(Space) || t(KeyE))),\n            confirm_held: k(Enter) || k(NumpadEnter) || self.pads.iter().any(|p| p.cross) || (story && k(Space)),\n            back: t(Escape) || t(Backspace) || self.pad_edge(|p| p.circle),\n            tab_prev: t(KeyQ) || t(PageUp) || self.pad_edge(|p| p.l1),\n            tab_next: t(KeyE) || t(PageDown) || self.pad_edge(|p| p.r1),\n            pause: t(Escape) || pad_pause,\n            chart: t(Tab) || self.pad_edge(|p| p.square),\n            alt: t(KeyM) || self.pad_edge(|p| p.triangle),\n            pointer,\n            pointer_moved: self.mouse_moved,\n            click: self.left_edge,\n            drag: self.mouse_left,\n            any: any_pad || any_key || self.mouse_moved || self.left_edge || self.right_edge || self.wheel != 0.0,\n            tap: self.tap.map(|q| egui::pos2(q.x / ppp, q.y / ppp)),\n            device: self.device,\n            dt,\n        }\n    }\n}\n\nimpl App {\n    /// A window event, for the game's own input.\n    pub(crate) fn product_event(&mut self, el: &ActiveEventLoop, event: WindowEvent) {\n        match &event {\n            WindowEvent::CloseRequested => {\n                el.exit();\n                return;\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n                return;\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                return;\n            }\n            _ => {}\n        }\n        let Some(p) = self.product.as_mut() else { return };\n        let mut resume = false;\n        match event {\n            WindowEvent::Focused(false) => {\n                p.keys.clear();\n                p.mouse_left = false;\n                p.mouse_right = false;\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                resume = true;\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    match event.state {\n                        ElementState::Pressed => {\n                            if !event.repeat {\n                                p.key_edges.insert(code);\n                                p.key_used = true;\n                                p.device = Device::KeyboardMouse;\n                            }\n                            p.keys.insert(code);\n                        }\n                        ElementState::Released => {\n                            p.keys.remove(&code);\n                        }\n                    }\n                }\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                resume = true;\n                p.device = Device::KeyboardMouse;\n                p.key_used = true;\n                let down = state == ElementState::Pressed;\n                match button {\n                    MouseButton::Left => {\n                        p.mouse_left = down;\n                        p.left_edge |= down;\n                    }\n                    MouseButton::Right => {\n                        p.mouse_right = down;\n                        p.right_edge |= down;\n                    }\n                    _ => {}\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } => {\n                p.wheel += match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(q) => q.y as f32 / 40.0,\n                };\n                p.device = Device::KeyboardMouse;\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let q = Vec2::new(position.x as f32, position.y as f32);\n                if (q - p.mouse_pos).length() > 0.5 {\n                    p.mouse_moved = true;\n                    // A phone's emulated pointer isn't a mouse.\n                    if p.fine_pointer {\n                        p.device = Device::KeyboardMouse;\n                    }\n                }\n                p.mouse_pos = q;\n            }\n            WindowEvent::Touch(t) => {\n                // No touch controls at all: the shell only reads taps on its one button.\n                p.finger_used = true;\n                if t.phase == winit::event::TouchPhase::Ended {\n                    p.tap = Some(Vec2::new(t.location.x as f32, t.location.y as f32));\n                }\n                if !p.key_used && !p.pad_used {\n                    p.device = Device::Touch;\n                }\n            }\n            _ => {}\n        }\n        #[cfg(target_arch = \"wasm32\")]\n        if resume {\n            self.resume_audio();\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let _ = resume;\n    }\n\n    pub(crate) fn product_frame(&mut self) {\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n\n        // Devices.\n        let Some(p) = self.product.as_mut() else { return };\n        p.prev_pads = std::mem::take(&mut p.pads);\n        if let Some(g) = &mut self.input.gilrs {\n            p.pads = read_pads(g);\n        }\n        if p.pads.iter().any(|q| q.any()) {\n            p.device = Device::Gamepad;\n            if !p.pad_used {\n                p.pad_used = true;\n                #[cfg(target_arch = \"wasm32\")]\n                {\n                    // The browser may keep sound off until a key or click: try, and say so.\n                    self.audio_resumed = true;\n                    if let Some(a) = &self.audio {\n                        a.resume();\n                    }\n                }\n            }\n        }\n        let p = self.product.as_mut().unwrap();\n        if p.key_used || p.pad_used {\n            p.shell.touch_only = false;\n        }\n        p.shell.sound_note = cfg!(target_arch = \"wasm32\") && p.pad_used && !p.key_used;\n\n        // The game's frames.\n        let Some(host) = self.host.as_ref() else { return };\n        host.pump();\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let alpha = ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0);\n        let Some(frame) = curr.surgery.clone() else {\n            return;\n        };\n        let Some(gfx) = self.gfx.as_ref() else { return };\n        let (w, h) = gfx.size();\n        let scale = gfx.window.scale_factor() as f32;\n        style::set_canvas(&self.egui_ctx, h as f32, scale);\n        let ppp = self.egui_ctx.zoom_factor() * scale;\n        let size = Vec2::new(w as f32, h as f32);\n        pav_view::surgery::apply_shot(&mut self.rig, &frame.shot);\n\n        // Hands: pads, mouse, keys -> slots -> the simulation.\n        self.surgeon_input(&frame, dt, size);\n\n        // Sound and effects.\n        let events: Vec<SimEvent> = std::mem::take(&mut *self.host.as_ref().unwrap().shared.events.lock().unwrap());\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        self.builder.add_events(&events);\n        let p = self.product.as_mut().unwrap();\n        let view_opts = p.shell.save.settings.clone();\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = pav_audio::Listener { pos: Vec3::ZERO, right };\n            for e in &events {\n                a.play_event(e, &l, 1.0);\n            }\n        }\n        for e in &events {\n            if let SimEvent::Cue { id, pos, .. } = e {\n                p.hub.note_cue(*id, pos.x, pos.z);\n                if *id == cue::DEFIB_THUMP {\n                    crate::hub::rumble(&p.pads, 1.0, 1.0, 300, view_opts.rumble);\n                }\n            }\n        }\n        // Music and voices.\n        let wall = p.start.elapsed().as_secs_f32();\n        p.music_and_voices(&frame, dt, wall, self.audio.as_ref());\n        p.rumble(&frame, dt);\n\n        // The scene.\n        let mut local = pav_view::surgery::Local {\n            clinical: view_opts.clinical,\n            shake: view_opts.shake,\n            reduce_flashes: view_opts.reduce_flashes,\n            fade: p.fade,\n            ..Default::default()\n        };\n        for (i, h) in p.hands.iter().enumerate() {\n            if frame.surgeons.get(i).is_some_and(|s| s.present && !s.bot) && h.held != 0xFF && p.is_local(i) {\n                local.aim[i] = Some(h.aim);\n            }\n        }\n        if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 1.0) {\n            local.hover_tray = tray_place(Vec2::new(q.x, q.z)).filter(|_| p.device == Device::KeyboardMouse);\n        }\n        // Scene cuts fade through black.\n        let story_key = frame.story.as_ref().map(|s| s.set.to_string()).unwrap_or_default();\n        if frame.stage != p.last_stage || story_key != p.last_story {\n            let story_edge = (frame.stage == Stage::Story) != (p.last_stage == Stage::Story) || (story_key != p.last_story && !story_key.is_empty());\n            if story_edge {\n                p.fade = 1.0;\n            }\n            p.last_stage = frame.stage;\n            p.last_story = story_key;\n        }\n        p.fade = (p.fade - dt * 2.4).max(0.0);\n        local.fade = p.fade;\n        local.skip = p.hub.server();\n        self.builder.surgery.local = local;\n        let skip_draw = p.hub.server();\n        let view = pav_view::ViewSettings::default();\n        let aspect = w as f32 / h.max(1) as f32;\n        let scene = if skip_draw {\n            None\n        } else {\n            Some(self.builder.build(&prev, &curr, alpha, &self.rig, aspect, &view, frame.shot.target.into()))\n        };\n        let vp = scene.as_ref().map(|s| s.camera.proj * s.camera.view).unwrap_or_default();\n\n        // The shell.\n        let p = self.product.as_mut().unwrap();\n        let input = p.shell_input(dt, ppp);\n        let state = self.egui_state.as_mut().unwrap();\n        let gfx = self.gfx.as_mut().unwrap();\n        let raw = state.take(&gfx.window);\n        let ctx = self.egui_ctx.clone();\n        if !p.first_frame_done {\n            style::install_font(&ctx);\n        }\n        let shell = &mut p.shell;\n        let hub_screen = shell.hub_active;\n        let out = ctx.run_ui(raw, |ui| {\n            let c = ui.ctx().clone();\n            shell.frame(&c, &input, Some(&frame), vp);\n        });\n        let _ = hub_screen;\n        state.platform_output(&gfx.window, out.platform_output);\n        let pixels = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, pixels);\n        let mut textures = out.textures_delta;\n        if let Some(scene) = &scene {\n            gfx.draw(scene, Some((&prims, &mut textures, pixels)));\n        } else {\n            textures.clear();\n        }\n        // Hide the OS cursor in operations.\n        let want_visible = !matches!(frame.stage, Stage::Op | Stage::Code | Stage::OpStart) || !matches!(p.shell.screen, Screen::Playing | Screen::Session);\n        if want_visible != p.last_cursor_visible {\n            p.last_cursor_visible = want_visible;\n            gfx.window.set_cursor_visible(want_visible);\n        }\n\n        // Edges consumed.\n        p.key_edges.clear();\n        p.left_edge = false;\n        p.right_edge = false;\n        p.mouse_moved = false;\n        p.wheel = 0.0;\n        p.tap = None;\n        p.first_frame_done = true;\n\n        // Stats.\n        p.frames += 1;\n        p.fps_t += dt;\n        if p.fps_t >= 0.5 {\n            p.fps = p.frames as f32 / p.fps_t;\n            p.tps = (frame.tick.saturating_sub(p.last_tick)) as f32 / p.fps_t;\n            p.last_tick = frame.tick;\n            p.frames = 0;\n            p.fps_t = 0.0;\n            p.shell.dev.fps = p.fps;\n            p.shell.dev.tps = p.tps;\n        }\n\n        // Do what the shell asked.\n        let cmds = std::mem::take(&mut p.shell.cmds);\n        for c in cmds {\n            self.shell_cmd(c);\n        }\n        // First time through: what the player saved reaches the sim and the mixer.\n        let p = self.product.as_mut().unwrap();\n        if !p.settings_sent {\n            p.settings_sent = true;\n            let s = p.shell.save.settings.clone();\n            if let Some(a) = &self.audio {\n                a.set_bus(BUS_MUSIC, s.music);\n                a.set_bus(pav_audio::BUS_EFFECTS, s.effects);\n                a.set_bus(BUS_VOICES, s.voices);\n            }\n            self.send_settings();\n        }\n        self.hub_update(&frame);\n        self.hook_update(&frame);\n    }\n\n    /// Everything the settings tell the sim, after a scene loads.\n    fn send_settings(&mut self) {\n        let Some(p) = self.product.as_ref() else { return };\n        let s = p.shell.save.settings.clone();\n        let d = p.shell.save.difficulty;\n        let tune = p.shell.dev.tune.clone();\n        let Some(host) = &self.host else { return };\n        let mut q = host.shared.surgery_cmds.lock().unwrap();\n        q.push_back(SurgeryCmd::Difficulty(d));\n        q.push_back(SurgeryCmd::TextSpeed(s.text_speed));\n        q.push_back(SurgeryCmd::Tremor(s.tremor));\n        for (i, v) in tune.v.iter().enumerate() {\n            if *v != pav_core::games::surgery::tune::SLIDERS[i].default {\n                q.push_back(SurgeryCmd::SetTune { id: i as u16, value: *v });\n            }\n        }\n    }\n\n    /// Loads a scene: a fresh sim, and the settings again.\n    pub(crate) fn load_surgery_scene(&mut self, scene: &str, seed: u64) {\n        let Some(host) = &self.host else { return };\n        let scene2 = scene.to_string();\n        host.exec(move |sim| match Sim::new(&scene2, seed) {\n            Ok(fresh) => *sim = fresh,\n            Err(e) => log::error!(\"could not load scene: {e:#}\"),\n        });\n        host.shared.surgery_cmds.lock().unwrap().clear();\n        host.set_control(|c| {\n            c.paused = false;\n            c.speed = 1.0;\n        });\n        *host.shared.input.lock().unwrap() = Default::default();\n        host.shared.events.lock().unwrap().clear();\n        self.builder.clear_particles();\n        if let Some(g) = &mut self.gfx {\n            g.renderer.clear_particles();\n        }\n        self.send_settings();\n        if let Some(p) = self.product.as_mut() {\n            p.fade = 1.0;\n            p.shell.scene = scene.to_string();\n        }\n    }\n\n    fn shell_cmd(&mut self, c: ShellCmd) {\n        match c {\n            ShellCmd::Load(scene) => {\n                let p = self.product.as_mut().unwrap();\n                p.seed = p.seed.wrapping_mul(0x9E37_79B9).wrapping_add(p.start.elapsed().as_nanos() as u64 | 1);\n                let seed = p.seed;\n                self.load_surgery_scene(&scene, seed);\n            }\n            ShellCmd::Sim(cmd) => {\n                let Some(host) = &self.host else { return };\n                if host.control().paused {\n                    // Paused: it applies now, so menus and dev tools answer.\n                    host.exec(move |sim| {\n                        let f = pav_core::InputFrame { surgery: Some(cmd), ..Default::default() };\n                        apply_now(sim, &f);\n                    });\n                } else {\n                    host.shared.surgery_cmds.lock().unwrap().push_back(cmd);\n                }\n            }\n            ShellCmd::Paused(on) => {\n                if let Some(host) = &self.host {\n                    host.set_control(|c| c.paused = on);\n                    *host.shared.input.lock().unwrap() = Default::default();\n                }\n            }\n            ShellCmd::Cue(id) => {\n                if let Some(a) = &self.audio {\n                    for (patch, delay) in pav_audio::cues::sound(id, 1.0, 1.0) {\n                        a.play_on(pav_audio::BUS_EFFECTS, patch, 0.0, 1.0, delay);\n                    }\n                }\n            }\n            ShellCmd::Save(text) => crate::hub::save_text(&text),\n            ShellCmd::Fullscreen(on) => {\n                if let Some(g) = &self.gfx {\n                    let is = g.window.fullscreen().is_some();\n                    if is != on {\n                        crate::platform::toggle_fullscreen(&g.window);\n                    }\n                }\n            }\n            ShellCmd::Mix { music, effects, voices } => {\n                if let Some(a) = &self.audio {\n                    a.set_bus(BUS_MUSIC, music);\n                    a.set_bus(pav_audio::BUS_EFFECTS, effects);\n                    a.set_bus(BUS_VOICES, voices);\n                }\n            }\n            ShellCmd::FrameStep => {\n                if let Some(host) = &self.host {\n                    host.set_control(|c| {\n                        c.paused = true;\n                        c.step_requests += 1;\n                    });\n                }\n            }\n            ShellCmd::Rewind => {\n                if let Some(host) = &self.host {\n                    let ok = host.query(|sim| {\n                        let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n                        let target = sim.state.tick.saturating_sub(300).max(oldest);\n                        let ok = sim.rewind_to(target);\n                        sim.commit_rewind();\n                        ok\n                    });\n                    if let Some(p) = self.product.as_mut() {\n                        p.shell.dev.status = if ok == Some(true) { \"Back five seconds.\".into() } else { \"Nothing to rewind to yet.\".into() };\n                    }\n                }\n            }\n            ShellCmd::SnapshotSave => {\n                if let Some(host) = &self.host {\n                    let snap = host.query(|sim| Box::new(sim.state.clone()));\n                    if let Some(p) = self.product.as_mut() {\n                        p.snapshot = snap;\n                        p.shell.dev.status = \"Snapshot saved.\".into();\n                    }\n                }\n            }\n            ShellCmd::SnapshotLoad => {\n                let snap = self.product.as_ref().and_then(|p| p.snapshot.clone());\n                if let (Some(host), Some(snap)) = (&self.host, snap) {\n                    host.exec(move |sim| sim.state = *snap);\n                    if let Some(p) = self.product.as_mut() {\n                        p.shell.dev.status = \"Snapshot loaded.\".into();\n                    }\n                }\n            }\n            ShellCmd::ReloadContent => {\n                let r = content::reload();\n                if let Some(p) = self.product.as_mut() {\n                    p.shell.dev.status = match r {\n                        Ok(()) => \"Content reloaded.\".into(),\n                        Err(e) => format!(\"{e:#}\"),\n                    };\n                }\n                self.builder.surgery.paper.clear();\n            }\n            ShellCmd::HubReady => crate::hub::answer(\"ready\"),\n            ShellCmd::HubMore => crate::hub::answer(\"more\"),\n        }\n    }\n\n    /// Devices to slots. The local player's aim integrates here, ahead of the tick.\n    fn surgeon_input(&mut self, frame: &SurgeryFrame, dt: f32, size: Vec2) {\n        let live = matches!(frame.stage, Stage::Op | Stage::Code | Stage::OpStart) && !frame.attract;\n        let Some(p) = self.product.as_mut() else { return };\n        let on_menu = !matches!(p.shell.screen, Screen::Playing | Screen::Session | Screen::Dev);\n        // Attract and menus keep the hands off; hub clients hand this to the network.\n        let settings = p.shell.save.settings.clone();\n        let assist = settings.aim_assist;\n        let speed = settings.cursor_speed;\n        let mut out = [SurgeonInput { tool: -1, ..Default::default() }; 4];\n\n        // Joining: any unassigned pad joins with Cross.\n        let my_seat = p.hub.my_seat();\n        let default_slot = my_seat.unwrap_or(0);\n        let ids: Vec<usize> = p.pads.iter().map(|q| q.id).collect();\n        p.pad_slot.retain(|(id, _)| ids.contains(id));\n        if p.pad_slot.is_empty() {\n            if let Some(first) = ids.first() {\n                p.pad_slot.push((*first, default_slot));\n            }\n        }\n        let mut joins = Vec::new();\n        if my_seat.is_none() && !p.hub.active() {\n            for q in p.pads.clone() {\n                if !p.pad_slot.iter().any(|(id, _)| *id == q.id) && q.cross && !p.prev_pads.iter().any(|x| x.id == q.id && x.cross) {\n                    if let Some(free) = (1..4).find(|s| !p.pad_slot.iter().any(|(_, x)| x == s)) {\n                        p.pad_slot.push((q.id, free));\n                        joins.push(free as u8);\n                    }\n                }\n            }\n        }\n        for s in joins {\n            if let Some(host) = &self.host {\n                host.shared.surgery_cmds.lock().unwrap().push_back(SurgeryCmd::Join { slot: s });\n            }\n        }\n        let p = self.product.as_mut().unwrap();\n\n        if !live || on_menu {\n            // Keep the cursors where they are; nothing reaches the sim.\n            if let Some(host) = &self.host {\n                if !p.hub.active() {\n                    let mut i = host.shared.input.lock().unwrap();\n                    i.surgeons = [SurgeonInput::default(); 4];\n                }\n            }\n            return;\n        }\n\n        // Each pad's slot.\n        let pad_map: Vec<(PadState, usize)> = p\n            .pads\n            .iter()\n            .filter_map(|q| p.pad_slot.iter().find(|(id, _)| *id == q.id).map(|(_, s)| (*q, *s)))\n            .collect();\n        for (slot, o) in out.iter_mut().enumerate() {\n            let mine = pad_map.iter().find(|(_, s)| *s == slot).map(|(q, _)| *q);\n            let prev = mine.and_then(|m| p.prev_pads.iter().find(|x| x.id == m.id).copied()).unwrap_or_default();\n            let keyboard = slot == default_slot;\n            if mine.is_none() && !keyboard {\n                continue;\n            }\n            let surgeon = frame.surgeons.get(slot);\n            let tool = surgeon.map(|s| s.tool).unwrap_or(Tool::Forceps);\n            let on_bone = surgeon.is_some_and(|s| s.engaged != 0 && frame.hazards.iter().any(|h| h.id == s.engaged && h.kind == HazardKind::Bone));\n            let h = &mut p.hands[slot];\n            if let Some(sv) = surgeon {\n                if h.aim == Vec2::ZERO {\n                    h.aim = sv.raw;\n                }\n            }\n            o.active = true;\n            let mut held = 0u8;\n            let mut pressed = 0u8;\n            let mut pressure = 1.0f32;\n            let mut keyboard_stick = Vec2::ZERO;\n\n            // The mouse aims, absolutely.\n            if keyboard && p.mouse_moved && p.device == Device::KeyboardMouse {\n                if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 0.55) {\n                    h.aim = surgeon::clamp(Vec2::new(q.x, q.z));\n                    h.assist = false;\n                }\n            }\n            if keyboard {\n                use KeyCode::*;\n                let down = |k: KeyCode| p.keys.contains(&k);\n                let mut v = Vec2::ZERO;\n                if down(KeyW) || down(ArrowUp) {\n                    v.y -= 1.0;\n                }\n                if down(KeyS) || down(ArrowDown) {\n                    v.y += 1.0;\n                }\n                if down(KeyA) || down(ArrowLeft) {\n                    v.x -= 1.0;\n                }\n                if down(KeyD) || down(ArrowRight) {\n                    v.x += 1.0;\n                }\n                keyboard_stick = v.normalize_or_zero();\n                if down(KeyE) || p.mouse_left {\n                    held |= hands::USE;\n                }\n                if down(ShiftLeft) || down(ShiftRight) {\n                    held |= hands::PRECISION;\n                }\n                if down(Space) {\n                    held |= hands::GIFT;\n                }\n                if p.right_edge || p.key_edges.contains(&KeyQ) {\n                    pressed |= hands::CANCEL;\n                }\n                if (p.mouse_left && p.mouse_right) || down(KeyF) {\n                    held |= hands::DEFIB;\n                }\n                for (i, k) in [Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8].into_iter().enumerate() {\n                    if p.key_edges.contains(&k) {\n                        h.ring = i;\n                        h.tool_hold = i as i8;\n                        h.tool_left = 6;\n                    }\n                }\n                // Click an instrument on the tray.\n                if p.left_edge {\n                    if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 1.0) {\n                        if let Some(place) = tray_place(Vec2::new(q.x, q.z)) {\n                            h.ring = place;\n                            h.tool_hold = place as i8;\n                            h.tool_left = 6;\n                            held &= !hands::USE;\n                        }\n                    }\n                }\n                if p.wheel != 0.0 {\n                    if on_bone {\n                        h.rotate = if p.wheel > 0.0 { 1 } else { -1 };\n                        h.rotate_left = 0.18;\n                    } else {\n                        let step = if p.wheel > 0.0 { 7 } else { 1 };\n                        let cur = frame.ring.iter().position(|t| *t == tool).unwrap_or(h.ring);\n                        h.ring = (cur + step) % 8;\n                        h.tool_hold = h.ring as i8;\n                        h.tool_left = 6;\n                    }\n                }\n            }\n            if let Some(q) = mine {\n                // R2 is analog; Cross holds it fully.\n                if q.r2 > 0.08 {\n                    held |= hands::USE;\n                    pressure = q.r2;\n                }\n                if q.cross {\n                    held |= hands::USE;\n                    pressure = 1.0;\n                }\n                if q.l2 > 0.25 && frame.stage != Stage::Code {\n                    held |= hands::PRECISION;\n                }\n                if q.l2 > 0.5 && q.r2 > 0.5 {\n                    held |= hands::DEFIB;\n                }\n                if q.triangle {\n                    held |= hands::GIFT;\n                }\n                if q.circle && !prev.circle {\n                    pressed |= hands::CANCEL;\n                }\n                // The signature: a flick switches tools, with no menu and no slowdown.\n                if let Some(i) = surgeon::flick(q.left) {\n                    h.tool_hold = i as i8;\n                    h.tool_left = 3;\n                    h.ring = i;\n                }\n                if on_bone {\n                    if q.l1 {\n                        h.rotate = -1;\n                        h.rotate_left = dt.max(0.02);\n                    }\n                    if q.r1 {\n                        h.rotate = 1;\n                        h.rotate_left = dt.max(0.02);\n                    }\n                } else {\n                    let cur = frame.ring.iter().position(|t| *t == tool).unwrap_or(h.ring);\n                    if q.l1 && !prev.l1 {\n                        h.ring = (cur + 7) % 8;\n                        h.tool_hold = h.ring as i8;\n                        h.tool_left = 6;\n                    }\n                    if q.r1 && !prev.r1 {\n                        h.ring = (cur + 1) % 8;\n                        h.tool_hold = h.ring as i8;\n                        h.tool_left = 6;\n                    }\n                }\n            }\n            // A stick or keys move the cursor at the plan's speed curve, with aim assist.\n            let stick = mine.map(|q| q.right).unwrap_or(Vec2::ZERO);\n            let precise = held & hands::PRECISION != 0;\n            let targets: Vec<Vec2> = frame.targets(tool).collect();\n            if stick.length() > 0.0 {\n                let d = Vec2::new(stick.x, -stick.y);\n                h.aim = surgeon::integrate(h.aim, d, speed, precise, assist, dt, targets.iter().copied());\n                h.assist = assist > 0.0;\n            }\n            if keyboard_stick != Vec2::ZERO {\n                h.aim = surgeon::integrate(h.aim, keyboard_stick, speed * 0.85, precise, assist, dt, targets.iter().copied());\n                h.assist = assist > 0.0;\n            }\n            if h.rotate_left > 0.0 {\n                h.rotate_left -= dt;\n                o.rotate = h.rotate;\n            }\n            // Edges wait for the tick.\n            let edge = held & !h.held;\n            h.held = held;\n            o.aim = h.aim;\n            o.held = held;\n            o.pressed = pressed | edge;\n            o.pressure = pressure;\n            o.assist = if h.assist { assist } else { 0.0 };\n            if h.tool_left > 0 {\n                h.tool_left -= 1;\n                o.tool = h.tool_hold;\n            } else {\n                o.tool = -1;\n            }\n        }\n        // A person's slot is theirs only when in play: dev's Bot plays overrides in the sim.\n        if let Some(host) = &self.host {\n            let mut i = host.shared.input.lock().unwrap();\n            let carried: [u8; 4] = std::array::from_fn(|k| i.surgeons[k].pressed);\n            for k in 0..4 {\n                let mut o2 = out[k];\n                o2.pressed |= carried[k];\n                i.surgeons[k] = o2;\n            }\n            drop(i);\n            let p = self.product.as_mut().unwrap();\n            p.hub.local_input(&out);\n        }\n    }\n\n    fn hub_update(&mut self, frame: &SurgeryFrame) {\n        crate::hub::update(self, frame);\n    }\n\n    fn hook_update(&mut self, frame: &SurgeryFrame) {\n        crate::hub::hook_update(self, frame);\n    }\n\n    pub(crate) fn status_json(&self, frame: &SurgeryFrame) -> serde_json::Value {\n        let Some(p) = self.product.as_ref() else { return serde_json::Value::Null };\n        let mut v = p.shell.status();\n        let sim = self.host.as_ref().and_then(|h| h.query(|sim| sim.play().map(|g| g.status(sim))));\n        v[\"sim\"] = sim.flatten().unwrap_or(serde_json::Value::Null);\n        v[\"stage\"] = serde_json::json!(format!(\"{:?}\", frame.stage));\n        v[\"tick\"] = serde_json::json!(frame.tick);\n        v[\"fps\"] = serde_json::json!(p.fps);\n        if let Some(a) = &self.audio {\n            v[\"bus_gains\"] = serde_json::json!([a.bus_gain(0), a.bus_gain(1), a.bus_gain(2)]);\n            v[\"bus_peaks\"] = serde_json::json!([a.peak(0), a.peak(1), a.peak(2)]);\n        }\n        let hazards = frame.hazards.iter().filter(|h| h.required).count();\n        v[\"required\"] = serde_json::json!(hazards);\n        v[\"cursor\"] = serde_json::json!(frame.surgeons.first().map(|s| [s.cursor.x, s.cursor.y]));\n        v[\"tool\"] = serde_json::json!(frame.surgeons.first().map(|s| format!(\"{:?}\", s.tool)));\n        v[\"using\"] = serde_json::json!(frame.surgeons.first().map(|s| s.using));\n        v[\"pressure\"] = serde_json::json!(frame.surgeons.first().map(|s| s.pressure));\n        v[\"vitals\"] = serde_json::json!(frame.vitals);\n        v\n    }\n}\n\n/// A command on a paused sim: one step of `surgery` with no time passing.\nfn apply_now(sim: &mut Sim, f: &pav_core::InputFrame) {\n    if let Some(cmd) = f.surgery {\n        if let Some(g) = sim.state.play.as_mut().and_then(|g| g.get_mut::<Surgery>()) {\n            let mut ev = Vec::new();\n            g.apply_cmd(cmd, &mut ev);\n            sim.push_events(ev);\n        }\n    }\n}\n\nimpl Product {\n    /// Is this slot driven from this machine?\n    fn is_local(&self, slot: usize) -> bool {\n        let seat = self.hub.my_seat().unwrap_or(0);\n        slot == seat || self.pad_slot.iter().any(|(_, s)| *s == slot)\n    }\n\n    fn music_and_voices(&mut self, f: &SurgeryFrame, dt: f32, now: f32, audio: Option<&pav_audio::AudioOut>) {\n        let Some(a) = audio else { return };\n        if self.hub.ended() {\n            return;\n        }\n        let m = MusicInput {\n            track: f.music.track.to_string(),\n            bpm: f.bpm,\n            heart: f.beats as f64 + f.beat as f64,\n            crisis: f.music.crisis,\n            hush: f.music.hush,\n            motif: f.music.motif,\n            flat: f.flat && !matches!(f.stage, Stage::Story | Stage::Title | Stage::Chart | Stage::Results),\n        };\n        let mut notes = Vec::new();\n        self.seq.update(dt, &m, &mut notes);\n        for (patch, pan, gain, delay) in notes {\n            a.play_on(BUS_MUSIC, patch, pan, gain, delay);\n        }\n        // Voices: blips follow the text.\n        let content = content::get();\n        let mut blips = Vec::new();\n        let def = |who: &str| -> Option<VoiceDef> {\n            content.rigs.get(who).map(|r| VoiceDef { pitch: r.pitch, wave: voice::wave_named(&r.wave), pace: r.pace, jitter: r.jitter })\n        };\n        if let Some(s) = &f.story {\n            if let Some(v) = def(&s.who) {\n                let serial = hash_str(&s.key).wrapping_add(s.line as u64 * 1009);\n                self.story_voice.update(serial, &s.text, s.chars as usize, now, &v, &mut blips);\n            }\n        }\n        if let Some(sub) = &f.subtitle {\n            if let Some(v) = def(&sub.who) {\n                let shown = (sub.age * 34.0) as usize;\n                self.op_voice.update(sub.serial as u64 + 1, &sub.text, shown, now, &v, &mut blips);\n            }\n        }\n        for b in blips {\n            a.play_on(BUS_VOICES, b, 0.0, 1.0, 0.0);\n        }\n    }\n\n    fn rumble(&mut self, f: &SurgeryFrame, dt: f32) {\n        let on = self.shell.save.settings.rumble;\n        self.rumble_t -= dt;\n        if !matches!(f.stage, Stage::Op | Stage::Code) || f.attract {\n            return;\n        }\n        if f.beats != self.last_beats {\n            self.last_beats = f.beats;\n            let low = (1.0 - f.vitals / 45.0).clamp(0.0, 1.0);\n            if low > 0.0 {\n                crate::hub::rumble(&self.pads, low * 0.8, low * 0.3, 90, on);\n            }\n        }\n        let contact = f.surgeons.first().is_some_and(|s| s.using && s.engaged != 0);\n        if contact && self.rumble_t <= 0.0 {\n            self.rumble_t = 0.16;\n            crate::hub::rumble(&self.pads, 0.0, 0.22, 60, on);\n        }\n    }\n}\n\nfn hash_str(s: &str) -> u64 {\n    s.bytes().fold(1469598103934665603u64, |h, b| (h ^ b as u64).wrapping_mul(1099511628211))\n}\nEOF\ncat > crates/pav_app/src/hub.rs <<'EOF'\n//! The page's side of things: the AI Hub session, the test hook, storage, rumble. All JS goes\n//! through `js_sys::Reflect` on `window`: the packer rejects wasm-bindgen snippets.\n\nuse std::collections::BTreeMap;\n\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::net;\nuse pav_core::input::{SurgeonInput, SurgeryCmd, hands};\nuse pav_ui::surgery::{HubCard, Screen};\nuse serde_json::{Value, json};\n\nuse crate::app::App;\nuse crate::product::PadState;\n\n/// What the test hook has queued.\n#[derive(Default)]\npub struct Hook {\n    pub steps: u64,\n    pub bot: bool,\n    pub installed: bool,\n}\n\n/// A hub round as this copy sees it.\n#[derive(Default)]\npub struct Hub {\n    pub active: bool,\n    pub connected: bool,\n    pub me: Option<usize>,\n    pub host: bool,\n    pub server: bool,\n    pub players: Vec<(u32, String)>,\n    pub seed: u64,\n    pub started: bool,\n    pub advanced: bool,\n    pub ready_sent: bool,\n    pub first_frame: bool,\n    pub ended: bool,\n    pub finished: bool,\n    pub send_t: f32,\n    pub publish_t: f32,\n    pub cue_serial: u32,\n    pub cues: Vec<(u32, u16, f32, f32)>,\n    pub seen_cues: u32,\n    pub remote: BTreeMap<u32, SurgeonInput>,\n    pub local: SurgeonInput,\n    pub gone: Vec<u32>,\n    pub last: Option<std::time::Duration>,\n    pub mirror: SurgeryFrame,\n    pub last_time: Option<web_time::Instant>,\n}\n\nimpl Hub {\n    pub fn new() -> Self {\n        Self { active: js_active(), ..Default::default() }\n    }\n    pub fn active(&self) -> bool {\n        self.active\n    }\n    pub fn server(&self) -> bool {\n        self.server\n    }\n    pub fn ended(&self) -> bool {\n        self.ended\n    }\n    pub fn my_seat(&self) -> Option<usize> {\n        if self.active { self.me } else { None }\n    }\n    /// Remembers cue events for the snapshots, with serials so clients can de-duplicate.\n    pub fn note_cue(&mut self, id: u16, x: f32, z: f32) {\n        if !self.active || !self.host {\n            return;\n        }\n        self.cue_serial += 1;\n        self.cues.push((self.cue_serial, id, x, z));\n        if self.cues.len() > 8 {\n            self.cues.remove(0);\n        }\n    }\n    pub fn local_input(&mut self, out: &[SurgeonInput; 4]) {\n        if let Some(me) = self.me {\n            self.local = out[me.min(3)];\n        }\n    }\n}\n\n#[cfg(target_arch = \"wasm32\")]\nmod js {\n    use js_sys::{Function, JSON, Object, Reflect};\n    use wasm_bindgen::prelude::*;\n\n    fn window() -> Option<web_sys::Window> {\n        web_sys::window()\n    }\n    pub fn hub() -> Option<JsValue> {\n        let w = window()?;\n        let h = Reflect::get(&w, &\"__hub\".into()).ok()?;\n        (!h.is_undefined() && !h.is_null()).then_some(h)\n    }\n    pub fn get_bool(o: &JsValue, k: &str) -> bool {\n        Reflect::get(o, &k.into()).ok().and_then(|v| v.as_bool()).unwrap_or(false)\n    }\n    pub fn call0(o: &JsValue, k: &str) -> Option<JsValue> {\n        let f = Reflect::get(o, &k.into()).ok()?;\n        let f: Function = f.dyn_into().ok()?;\n        f.call0(o).ok()\n    }\n    pub fn call1(o: &JsValue, k: &str, a: &JsValue) -> Option<JsValue> {\n        let f = Reflect::get(o, &k.into()).ok()?;\n        let f: Function = f.dyn_into().ok()?;\n        f.call1(o, a).ok()\n    }\n    pub fn call2(o: &JsValue, k: &str, a: &JsValue, b: &JsValue) -> Option<JsValue> {\n        let f = Reflect::get(o, &k.into()).ok()?;\n        let f: Function = f.dyn_into().ok()?;\n        f.call2(o, a, b).ok()\n    }\n    pub fn json_of(v: &JsValue) -> Option<String> {\n        JSON::stringify(v).ok().and_then(|s| s.as_string())\n    }\n    pub fn make_object() -> Object {\n        Object::new()\n    }\n}\n\n#[cfg(target_arch = \"wasm32\")]\nfn js_active() -> bool {\n    js::hub().is_some_and(|h| js::get_bool(&h, \"active\"))\n}\n#[cfg(not(target_arch = \"wasm32\"))]\nfn js_active() -> bool {\n    false\n}\n\n/// The player's save.\n#[cfg(target_arch = \"wasm32\")]\npub fn load_text() -> Option<String> {\n    web_sys::window()?.local_storage().ok()??.get_item(\"surgery-save\").ok()?\n}\n#[cfg(target_arch = \"wasm32\")]\npub fn save_text(t: &str) {\n    if let Some(s) = web_sys::window().and_then(|w| w.local_storage().ok().flatten()) {\n        let _ = s.set_item(\"surgery-save\", t);\n    }\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn load_text() -> Option<String> {\n    std::fs::read_to_string(crate::boot::exe_dir().join(\"surgery-save.json\")).ok()\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn save_text(t: &str) {\n    let _ = std::fs::write(crate::boot::exe_dir().join(\"surgery-save.json\"), t);\n}\n\n/// The page's `about-data` block, if it has one.\n#[cfg(target_arch = \"wasm32\")]\npub fn about_json() -> Option<String> {\n    let d = web_sys::window()?.document()?;\n    d.get_element_by_id(\"about-data\")?.text_content()\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn about_json() -> Option<String> {\n    None\n}\n\n/// Does this device have a fine pointer (a mouse)?\n#[cfg(target_arch = \"wasm32\")]\npub fn fine_pointer() -> bool {\n    web_sys::window().and_then(|w| w.match_media(\"(any-pointer: fine)\").ok().flatten()).is_some_and(|m| m.matches())\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn fine_pointer() -> bool {\n    true\n}\n\n/// Rumble: the page's helper, on every pad.\n#[cfg(target_arch = \"wasm32\")]\npub fn rumble(pads: &[PadState], strong: f32, weak: f32, ms: u32, on: bool) {\n    if !on || pads.is_empty() {\n        return;\n    }\n    let Some(w) = web_sys::window() else { return };\n    let Ok(f) = js_sys::Reflect::get(&w, &\"__rumble\".into()) else { return };\n    let Ok(f) = wasm_bindgen::JsCast::dyn_into::<js_sys::Function>(f) else { return };\n    let _ = f.call3(&w, &strong.into(), &weak.into(), &ms.into());\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn rumble(_pads: &[PadState], _strong: f32, _weak: f32, _ms: u32, _on: bool) {}\n\n/// A card answer.\n#[cfg(target_arch = \"wasm32\")]\npub fn answer(what: &str) {\n    if let Some(h) = js::hub() {\n        js::call1(&h, \"answer\", &what.into());\n    }\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn answer(_what: &str) {}\n\n#[cfg(target_arch = \"wasm32\")]\nfn hub_time(h: &wasm_bindgen::JsValue) -> f64 {\n    js::call0(h, \"time\").and_then(|v| v.as_f64()).unwrap_or(f64::NEG_INFINITY)\n}\n\nfn parse_info(hub: &mut Hub, info: &Value) {\n    hub.me = info[\"me\"].as_u64().map(|v| v as usize);\n    hub.host = info[\"isHost\"].as_bool().unwrap_or(false);\n    hub.server = info[\"server\"].as_bool().unwrap_or(false);\n    hub.seed = info[\"seed\"].as_f64().unwrap_or(1.0) as u64;\n    hub.players = info[\"players\"]\n        .as_array()\n        .map(|a| a.iter().map(|p| (p[\"id\"].as_u64().unwrap_or(0) as u32, p[\"name\"].as_str().unwrap_or(\"\").to_string())).collect())\n        .unwrap_or_default();\n    if hub.server {\n        hub.me = None;\n    }\n}\n\nfn seat_mask(hub: &Hub) -> u8 {\n    let mut m = 0u8;\n    for (id, _) in &hub.players {\n        if !hub.gone.contains(id) && *id < 4 {\n            m |= 1 << id;\n        }\n    }\n    m\n}\n\n/// The standings as the hub wants them.\nfn standings(hub: &Hub, f: &SurgeryFrame) -> Value {\n    let mut list: Vec<(u32, i32)> = hub\n        .players\n        .iter()\n        .filter(|(id, _)| !hub.gone.contains(id))\n        .map(|(id, _)| (*id, f.surgeons.get(*id as usize).map(|s| s.score).unwrap_or(0)))\n        .collect();\n    list.sort_by_key(|x| -x.1);\n    let standings: Vec<Value> = list.iter().map(|(id, _)| json!([id])).collect();\n    let scores: serde_json::Map<String, Value> = list.iter().map(|(id, s)| (id.to_string(), json!(s))).collect();\n    let won = f.vitals > 0.0 && f.stage != Stage::Dead;\n    let best = list.first().copied();\n    let awards: Vec<Value> = best\n        .filter(|b| b.1 > 0)\n        .map(|b| json!({\"id\": b.0, \"title\": \"Immaculate Hands\", \"detail\": format!(\"{} points at the table\", b.1)}))\n        .into_iter()\n        .collect();\n    let mut stats = serde_json::Map::new();\n    for (id, _) in &list {\n        if let Some(s) = f.surgeons.get(*id as usize) {\n            stats.insert(id.to_string(), json!({\"Best chain\": s.chain, \"Score\": s.score}));\n        }\n    }\n    json!({\"standings\": standings, \"scores\": scores, \"won\": won, \"stats\": stats, \"awards\": awards})\n}\n\n/// Runs the session side of a frame.\n#[cfg(target_arch = \"wasm32\")]\npub fn update(app: &mut App, frame: &SurgeryFrame) {\n    use wasm_bindgen::JsValue;\n    let Some(p) = app.product.as_mut() else { return };\n    if !p.hub.active {\n        return;\n    }\n    let Some(h) = js::hub() else {\n        p.hub.active = false;\n        return;\n    };\n    if !js::get_bool(&h, \"active\") {\n        // `connect` answered null: run as on its own.\n        p.hub.active = false;\n        p.shell.hub_active = false;\n        return;\n    }\n    p.shell.hub_active = true;\n    // Connected?\n    if !p.hub.connected {\n        let info = js_sys::Reflect::get(&h, &\"info\".into()).unwrap_or(JsValue::NULL);\n        if info.is_null() || info.is_undefined() {\n            if p.shell.screen != Screen::Card {\n                p.shell.screen = Screen::Card;\n                p.shell.hub_card = Some(HubCard::default());\n            }\n            return;\n        }\n        let v: Value = js::json_of(&info).and_then(|t| serde_json::from_str(&t).ok()).unwrap_or(Value::Null);\n        parse_info(&mut p.hub, &v);\n        p.hub.connected = true;\n        let card = HubCard { players: p.hub.players.clone(), me: p.hub.me.map(|m| m as u32), ..Default::default() };\n        p.shell.hub_card = Some(card);\n        p.shell.screen = Screen::Card;\n        p.shell.load(\"surgery/card\");\n        return;\n    }\n    if !p.hub.ready_sent {\n        p.hub.ready_sent = true;\n        js::call0(&h, \"ready\");\n        if let Some(a) = &app.audio {\n            a.resume();\n        }\n    }\n    // Events.\n    let text = js::call0(&h, \"poll\").and_then(|v| v.as_string()).unwrap_or_default();\n    let events: Vec<Value> = serde_json::from_str(&text).unwrap_or_default();\n    let mut start = false;\n    let mut mirror_frames = Vec::new();\n    for e in &events {\n        match e[0].as_str().unwrap_or(\"\") {\n            \"card\" => {\n                let d = &e[1];\n                if let Some(c) = p.shell.hub_card.as_mut() {\n                    c.left_ms = d[\"left\"].as_f64();\n                    c.paused = d[\"paused\"].as_bool().unwrap_or(false);\n                    c.starting = d[\"starting\"].as_bool().unwrap_or(false);\n                    c.asking = d[\"asking\"].as_u64().unwrap_or(0) as u32;\n                    c.asked = d[\"asked\"].as_bool().unwrap_or(false);\n                    c.ready = d[\"ready\"].as_array().map(|a| a.iter().filter_map(|x| x.as_u64()).map(|x| x as u32).collect()).unwrap_or_default();\n                }\n            }\n            \"start\" => start = true,\n            \"leave\" => {\n                if let Some(id) = e[1][\"id\"].as_u64() {\n                    p.hub.gone.push(id as u32);\n                    p.hub.remote.remove(&(id as u32));\n                    if p.hub.host {\n                        let m = seat_mask(&p.hub);\n                        if let Some(host) = &app.host {\n                            host.shared.surgery_cmds.lock().unwrap().push_back(SurgeryCmd::Seats(m));\n                        }\n                    }\n                }\n            }\n            \"message\" => {\n                let from = e[2].as_u64().unwrap_or(0) as u32;\n                let d = &e[1];\n                if p.hub.host {\n                    if let Some(i) = d.get(\"i\") {\n                        let prev = p.hub.remote.get(&from).copied().unwrap_or_default();\n                        let mut inp = net::decode_input(i);\n                        inp.pressed = inp.held & !prev.held;\n                        if inp.held & hands::CANCEL != 0 {\n                            inp.pressed |= hands::CANCEL;\n                        }\n                        p.hub.remote.insert(from, inp);\n                    }\n                } else if d.get(\"s\").is_some() {\n                    mirror_frames.push(d.clone());\n                }\n            }\n            \"time-up\" => {}\n            \"end\" => {\n                p.hub.ended = true;\n                if let Some(a) = &app.audio {\n                    a.silence();\n                }\n            }\n            _ => {}\n        }\n    }\n    if p.hub.ended {\n        return;\n    }\n    if start && !p.hub.started {\n        p.hub.started = true;\n        let is_host = p.hub.host;\n        let seed = p.hub.seed.max(1);\n        let scene = if is_host { \"surgery/codeblue\" } else { \"surgery/mirror\" };\n        p.shell.screen = Screen::Session;\n        p.shell.scene = scene.to_string();\n        app.load_surgery_scene(scene, seed);\n        let p = app.product.as_mut().unwrap();\n        if is_host {\n            let mask = seat_mask(&p.hub);\n            if let Some(host) = &app.host {\n                host.shared.surgery_cmds.lock().unwrap().push_back(SurgeryCmd::Seats(mask));\n            }\n        }\n        return;\n    }\n    if !p.hub.started {\n        return;\n    }\n    let t = hub_time(&h);\n    if let Some(c) = p.shell.hub_card.as_mut() {\n        c.countdown = (t < 0.0 && t.is_finite()).then_some((-t / 1000.0) as f32);\n    }\n    let last_t = p.hub.last_time.replace(web_time::Instant::now());\n    let dt = last_t.map(|x| x.elapsed().as_secs_f32()).unwrap_or(0.016);\n    p.hub.send_t -= dt;\n    if p.hub.host {\n        // Start the operation so play begins on the hub's clock.\n        if !p.hub.advanced && t >= -1700.0 && frame.stage == Stage::Chart {\n            p.hub.advanced = true;\n            if let Some(host) = &app.host {\n                host.shared.surgery_cmds.lock().unwrap().push_back(SurgeryCmd::Advance);\n            }\n        }\n        // Remote hands go in the sim's input.\n        if let Some(host) = &app.host {\n            let mut i = host.shared.input.lock().unwrap();\n            for (id, inp) in &p.hub.remote {\n                let k = *id as usize;\n                if k < 4 && Some(k) != p.hub.me {\n                    let carry = i.surgeons[k].pressed;\n                    i.surgeons[k] = *inp;\n                    i.surgeons[k].pressed |= carry;\n                }\n            }\n        }\n        for v in p.hub.remote.values_mut() {\n            v.pressed = 0;\n        }\n        // One snapshot, about 15 a second.\n        if p.hub.send_t <= 0.0 {\n            p.hub.send_t = 1.0 / 15.0;\n            let snap = net::encode_frame(frame, &p.hub.cues);\n            let text = serde_json::to_string(&snap).unwrap_or_default();\n            js::call2(&h, \"send\", &text.into(), &JsValue::UNDEFINED);\n        }\n        // Standings about once a second, for time-up.\n        p.hub.publish_t -= dt;\n        if p.hub.publish_t <= 0.0 {\n            p.hub.publish_t = 1.0;\n            let s = serde_json::to_string(&standings(&p.hub, frame)).unwrap_or_default();\n            js::call1(&h, \"publish\", &s.into());\n        }\n        // The round's end.\n        let over = matches!(frame.stage, Stage::Complete | Stage::Results | Stage::Dead | Stage::Finished);\n        if over && !p.hub.finished && frame.tick > 10 {\n            p.hub.finished = true;\n            let s = serde_json::to_string(&standings(&p.hub, frame)).unwrap_or_default();\n            js::call1(&h, \"finish\", &s.into());\n        }\n    } else {\n        // A client: hands out at about 15 Hz; frames in.\n        if p.hub.send_t <= 0.0 && p.hub.me.is_some() {\n            p.hub.send_t = 1.0 / 15.0;\n            let msg = json!({\"i\": net::encode_input(&p.hub.local, 0)});\n            let host_id = js_sys::Reflect::get(&h, &\"host\".into()).unwrap_or(JsValue::UNDEFINED);\n            js::call2(&h, \"send\", &msg.to_string().into(), &host_id);\n        }\n        if let Some(last) = mirror_frames.pop() {\n            let f2 = net::decode_frame(&last, &p.hub.mirror);\n            p.hub.mirror = f2.clone();\n            // Cues the snapshot carries, once each.\n            let mut new_cues = Vec::new();\n            if let Some(list) = last[\"e\"].as_array() {\n                for c in list {\n                    let serial = c[0].as_u64().unwrap_or(0) as u32;\n                    if serial > p.hub.seen_cues {\n                        p.hub.seen_cues = serial;\n                        let (id, x, z) = (c[1].as_u64().unwrap_or(0) as u16, c[2].as_f64().unwrap_or(0.0) as f32 / 20.0, c[3].as_f64().unwrap_or(0.0) as f32 / 20.0);\n                        new_cues.push(pav_core::SimEvent::Cue { id, pos: glam::Vec3::new(x, 0.0, z), gain: 1.0, pitch: 1.0 });\n                    }\n                }\n            }\n            if let Some(host) = &app.host {\n                let f3 = std::sync::Arc::new(f2);\n                host.exec(move |sim| {\n                    if let Some(g) = sim.state.play.as_mut().and_then(|g| g.get_mut::<pav_core::games::surgery::Surgery>()) {\n                        g.mirror_frame = Some(f3.clone());\n                    }\n                    sim.push_events(new_cues);\n                });\n            }\n        }\n    }\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn update(_app: &mut App, _frame: &SurgeryFrame) {}\n\n/// The test hook: `window.__game`.\n#[cfg(target_arch = \"wasm32\")]\npub fn hook_update(app: &mut App, frame: &SurgeryFrame) {\n    use wasm_bindgen::prelude::*;\n    thread_local! {\n        static QUEUE: std::cell::RefCell<(u64, bool, Vec<String>, String)> = const { std::cell::RefCell::new((0, false, Vec::new(), String::new())) };\n    }\n    let Some(p) = app.product.as_mut() else { return };\n    if !p.hook.installed {\n        p.hook.installed = true;\n        let o = js::make_object();\n        let step = Closure::<dyn FnMut(f64, bool)>::new(|n: f64, bot: bool| {\n            QUEUE.with(|q| {\n                let mut q = q.borrow_mut();\n                q.0 += n as u64;\n                q.1 = bot;\n            });\n        });\n        let doit = Closure::<dyn FnMut(String)>::new(|s: String| {\n            QUEUE.with(|q| q.borrow_mut().2.push(s));\n        });\n        let status = Closure::<dyn FnMut() -> String>::new(|| QUEUE.with(|q| q.borrow().3.clone()));\n        let _ = js_sys::Reflect::set(&o, &\"step\".into(), step.as_ref());\n        let _ = js_sys::Reflect::set(&o, &\"do\".into(), doit.as_ref());\n        let _ = js_sys::Reflect::set(&o, &\"statusText\".into(), status.as_ref());\n        step.forget();\n        doit.forget();\n        status.forget();\n        if let Some(w) = web_sys::window() {\n            let _ = js_sys::Reflect::set(&w, &\"__game\".into(), &o);\n            let _ = js_sys::eval(\"window.__game.status = () => JSON.parse(window.__game.statusText() || 'null');\");\n        }\n    }\n    let (steps, bot, cmds) = QUEUE.with(|q| {\n        let mut q = q.borrow_mut();\n        let r = (q.0, q.1, std::mem::take(&mut q.2));\n        q.0 = 0;\n        r\n    });\n    for c in cmds {\n        let v: Value = serde_json::from_str(&c).unwrap_or(Value::Null);\n        if let Some(scene) = v[\"load\"].as_str() {\n            let scene = scene.to_string();\n            app.load_surgery_scene(&scene, 7);\n        }\n        if let Some(s) = v[\"screen\"].as_str() {\n            let p = app.product.as_mut().unwrap();\n            p.shell.screen = match s {\n                \"Title\" => Screen::Title,\n                \"Menu\" => Screen::Menu,\n                \"Playing\" => Screen::Playing,\n                \"Dev\" => Screen::Dev,\n                \"Pause\" => Screen::Pause,\n                \"About\" => Screen::About,\n                \"Settings\" => Screen::Settings,\n                _ => p.shell.screen,\n            };\n        }\n        if let Some(cmd) = v.get(\"sim\").and_then(|x| serde_json::from_value::<SurgeryCmd>(x.clone()).ok()) {\n            if let Some(host) = &app.host {\n                host.shared.surgery_cmds.lock().unwrap().push_back(cmd);\n            }\n        }\n    }\n    if steps > 0 {\n        if let Some(host) = &app.host {\n            host.exec(move |sim| {\n                for _ in 0..steps {\n                    let f = if bot { sim.bot_input() } else { Default::default() };\n                    sim.step(&f);\n                }\n            });\n        }\n    }\n    let status = app.status_json(frame);\n    QUEUE.with(|q| q.borrow_mut().3 = status.to_string());\n}\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn hook_update(_app: &mut App, _frame: &SurgeryFrame) {}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/mod.rs'\ns=open(p).read()\ns=s.replace('''    fn apply(&mut self, cmd: SurgeryCmd, events: &mut Vec<SimEvent>) {''','''    /// Applies a command now (the app's paused menus and dev tools).\n    pub fn apply_cmd(&mut self, cmd: SurgeryCmd, events: &mut Vec<SimEvent>) {\n        self.apply(cmd, events);\n    }\n\n    fn apply(&mut self, cmd: SurgeryCmd, events: &mut Vec<SimEvent>) {''')\nopen(p,'w').write(s)\np='crates/pav_core/src/sim.rs'\ns=open(p).read()\ns=s.replace('''    /// Hash of the gamepla