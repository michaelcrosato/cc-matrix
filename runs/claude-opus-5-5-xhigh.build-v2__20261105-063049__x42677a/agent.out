awn]]\nkind = \"polyp\"\nat = [-6.4, 1.6]\nr = 0.42\n[[phase.spawn]]\nkind = \"polyp\"\nat = [-3.6, 2.5]\nr = 0.34\n[[phase.spawn]]\nkind = \"polyp\"\n579:fn the_balance_targets_hold() {\n580-    for case in 0..content::CASES {\n581-        let scene = format!(\"surgery/case/{case}\");\n582-        // Skill 1.0 wins at S or above.\n583-        for seed in 1..=2 {\n584-            let (o, rank) = run_skill(&scene, seed, 1.0);\n585-            assert_eq!(o, Outcome::Won, \"{scene} at 1.0\");\n586-            let r = rank.unwrap();\n587-            assert!(r == \"S\" || r == \"ENCORE\", \"{scene} at 1.0 ranked {r}\");\n588-        }\n589-        // Skill 0 always loses.\n590-        assert_eq!(run_skill(&scene, 1, 0.0).0, Outcome::Lost, \"{scene} at 0\");\n591-    }\n592-    // Skill 0.7 wins most; 0.4 loses the later cases.\n593-    let wins = |skill: f32, cases: std::ops::Range<usize>| -> (usize, usize) {\n594-        let mut won = 0;\n595-        let mut all = 0;\n596-        for case in cases {\n597-            for seed in 1..=2 {\n598-                all += 1;\n599-                if run_skill(&format!(\"surgery/case/{case}\"), seed, skill).0 == Outcome::Won {\n600-                    won += 1;\n601-                }\n602-            }\n603-        }\n604-        (won, all)\n605-    };\n606-    let (w, n) = wins(0.7, 0..content::CASES);\n607-    assert!(w * 10 >= n * 6, \"0.7 should win most: {w}/{n}\");\n608-    let (w, n) = wins(0.4, 3..content::CASES);\n609-    assert!(w * 2 <= n, \"0.4 should lose the later cases: {w}/{n}\");\n610-}\n611-\n612-/// A balance probe: what happens over time in one case at one skill. `cargo test probe -- --ignored --nocapture`\n613-#[test]\n614-#[ignore]\n615-fn probe() {\n616-    let case: u8 = std::env::var(\"CASE\").ok().and_then(|v| v.parse().ok()).unwrap_or(6);\n617-    let skill: f32 = std::env::var(\"SKILL\").ok().and_then(|v| v.parse().ok()).unwrap_or(0.7);\n618-    for seed in 1..=2 {\n619-        let mut s = sim(&format!(