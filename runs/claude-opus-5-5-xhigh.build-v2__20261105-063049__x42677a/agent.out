0.0 * k), Align2::CENTER_CENTER, \"Controller or keyboard required\", 54.0 * k, GOLD);\n            // Touch-only: one button a tap can use.\n            let r = Rect::from_center_size(pos2(c.x, c.y + 260.0 * k), vec2(360.0, 90.0) * k);\n            p.rect_filled(r, 12.0, style::with_alpha(TEAL, 0.3));\n            p.rect_stroke(r, 12.0, egui::Stroke::new(3.0, TEAL), StrokeKind::Inside);\n            style::outlined(p, r.center(), Align2::CENTER_CENTER, \"Settings\", 48.0 * k, Color32::WHITE);''')\nopen(p,'w').write(s)\np='crates/pav_app/src/product.rs'\ns=open(p).read()\ns=s.replace('''        style::set_canvas(&self.egui_ctx, h as f32, scale);\n        let ppp = self.egui_ctx.zoom_factor() * scale;\n        let size = Vec2::new(w as f32, h as f32);''','''        style::set_canvas(&self.egui_ctx, w as f32, h as f32, scale);\n        let ppp = self.egui_ctx.zoom_factor() * scale;\n        let size = Vec2::new(w as f32, h as f32);\n        // Pointer positions come in device pixels of the page; the canvas may be sized otherwise.\n        #[cfg(target_arch = \"wasm32\")]\n        let page_size = {\n            use winit::platform::web::WindowExtWebSys;\n            gfx.window\n                .canvas()\n                .map(|c| Vec2::new(c.client_width() as f32, c.client_height() as f32) * scale)\n                .filter(|q| q.x > 0.0 && q.y > 0.0)\n                .unwrap_or(size)\n        };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let page_size = size;\n        if let Some(p) = self.product.as_mut() {\n            p.ptr_scale = size / page_size;\n        }''')\ns=s.replace('''    tap: Option<Vec2>,\n    finger_used: bool,''','''    tap: Option<Vec2>,\n    /// Surface pixels per pointer pixel.\n    ptr_scale: Vec2,\n    finger_used: bool,''')\ns=s.replace('''            tap: None,\n            finger_used: false,''','''            tap: None,\n            ptr_scale: Vec2::ONE,\n            finger_used: false,''')\ns=s.replace('''        let pointer = (self.mouse_pos.x >= 0.0).then(|| egui::pos2(self.mouse_pos.x / ppp, self.mouse_pos.y / ppp));''','''        let m = self.mouse_pos * self.ptr_scale;\n        let pointer = (m.x >= 0.0).then(|| egui::pos2(m.x / ppp, m.y / ppp));''')\ns=s.replace('''            tap: self.tap.map(|q| egui::pos2(q.x / ppp, q.y / ppp)),''','''            tap: self.tap.map(|q| q * self.ptr_scale).map(|q| egui::pos2(q.x / ppp, q.y / ppp)),''')\ns=s.replace('''        if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 1.0) {\n            local.hover_tray =''','''        if let Some(q) = self.rig.ground_point(p.mouse_pos * p.ptr_scale, size, 1.0) {\n            local.hover_tray =''')\ns=s.replace('''                if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 0.55) {''','''                if let Some(q) = self.rig.ground_point(p.mouse_pos * p.ptr_scale, size, 0.55) {''')\ns=s.replace('''                    if let Some(q) = self.rig.ground_point(p.mouse_pos, size, 1.0) {\n                        if let Some(place)''','''                    if let Some(q) = self.rig.ground_point(p.mouse_pos * p.ptr_scale, size, 1.0) {\n                        if let Some(place)''')\nopen(p,'w').write(s)\np='../tests/browser/common.py'\ns=open(p).read()\ns=s.replace('''    page.on(\"console\", lambda m: errors.append(m.text) if m.type == \"error\" else None)''','''    # Chromium's note about a touch it couldn't cancel is about the page's scrolling, not an error of ours.\n    page.on(\"console\", lambda m: errors.append(m.text) if m.type == \"error\" and \"Ignored attempt to cancel\" not in m.text else None)''')\nopen(p,'w').write(s)\np='../tests/browser/web_tests.py'\ns=open(p).read()\na=s.index('''    # The Settings button answers a tap: find it on the canvas''')\nb=s.index('''    s = wait(page, lambda s: s[\"screen\"] == \"Attract\", 40, \"attract on a phone\")''')\ns=s[:a]+'''    # The Settings button answers a tap. On a portrait phone the canvas is 1920 points wide, and\n    # the button