left button uses\")\n    page.mouse.up()\n    # Esc pauses.\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Esc pauses\")''','''    page.mouse.down()\n    wait(page, lambda s: s[\"using\"], 15, \"left button uses\")\n    page.mouse.up()\n    # Esc pauses.\n    key(page, \"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"Esc pauses\")''')\ns=s.replace('''    page.keyboard.press(\"Enter\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu by Enter\")''','''    key(page, \"Enter\")\n    s = wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu by Enter\")''')\ns=s.replace('''    page.evaluate(\"__padHit(12,1)\")\n    wait(page, lambda s: s[\"device\"] == \"pad\" and \"Cross\" in s[\"prompts\"], 15, \"prompts flip to pad\")\n    page.evaluate(\"__padHit(12,0)\")\n    page.keyboard.press(\"ArrowDown\")\n    wait(page, lambda s: s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], 15, \"prompts flip back\")''','''    page.evaluate(\"__padHit(12,1)\")\n    wait(page, lambda s: s[\"device\"] == \"pad\" and \"Cross\" in s[\"prompts\"], 15, \"prompts flip to pad\")\n    page.evaluate(\"__padHit(12,0)\")\n    frames(page, 2)\n    key(page, \"ArrowDown\")\n    wait(page, lambda s: s[\"device\"] == \"mouse\" and \"Enter\" in s[\"prompts\"], 15, \"prompts flip back\")''')\ns=s.replace('''        if how == \"key\":\n            page.keyboard.press(\"x\")\n        elif how == \"pad\":\n            page.evaluate(\"__padHit(0,1)\")\n            time.sleep(0.4)\n            page.evaluate(\"__padHit(0,0)\")\n        else:''','''        if how == \"key\":\n            key(page, \"x\")\n        elif how == \"pad\":\n            hit(page, 0)\n        else:''')\ns=s.replace('''    to_title(page)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Settings'}))\")''','''    to_title(page)\n    key(page, \"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Menu\", 20, \"menu\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Settings'}))\")''')\ns=s.replace('''    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 1, 30, \"case\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"pause\")\n    for _ in range(4):\n        key(page, \"ArrowDown\", 0.08)\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Dev\", 15, \"dev\")''','''    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"case\") == 1 and s[\"sim\"][\"stage\"] == \"Chart\", 30, \"case\")\n    press_until(page, \"Enter\", lambda s: s[\"sim\"][\"stage\"] in (\"OpStart\", \"Op\"), \"the operation\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")\n    key(page, \"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 10, \"pause\")\n    for _ in range(4):\n        key(page, \"ArrowDown\")\n    wait(page, lambda s: s[\"focus\"] == 4, 10, \"dev mode's row\")\n    key(page, \"Enter\")\n    wait(page, lambda s: s[\"screen\"] == \"Dev\", 15, \"dev\")\n    # A slider: the first page's third row is the vitals drain.\n    for _ in range(2):\n        key(page, \"ArrowDown\")\n    key(page, \"ArrowRight\")\n    wait(page, lambda s: s.get(\"drain_tune\", 1.0) > 1.0, 15, \"the slider reaches the sim\")''')\ns=s.replace('''    for _ in range(2):\n        key(page, \"ArrowRight\", 0.1)\n    s = wait(page, lambda s: s[\"music\"] > 0.11, 10, \"music up\")''','''    for _ in range(2):\n        key(page, \"ArrowRight\")\n    s = wait(page, lambda s: s[\"music\"] > 0.11, 10, \"music up\")''')\ns=s.replace('''    to_title(page)\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_title.png\"))\n    page.keyboard.press(\"Enter\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_menu.png\"))''','''    to_title(page)\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_title.png\"))\n    key(page, \"Enter\")\n    time.sleep(1)\n    page.screenshot(path=str(OUT / \"p_menu.png\"))''')\ns=s.replace('''    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"story\"), 30, \"story\")\n    page.keyboard.press(\"Enter\")\n    time.sleep(0.8)\n    page.keyboard.press(\"Enter\")\n    time.sleep(3)''','''    wait(page, lambda s: s.get(\"sim\") and s[\"sim\"].get(\"story\"), 30, \"story\")\n    key(page, \"Enter\")\n    key(page, \"Enter\")\n    key(page, \"Enter\")\n    time.sleep(3)''')\ns=s.replace('''    wait(page, lambda s: s[\"sim\"].get(\"case\") == 4, 20, \"op\")\n    page.keyboard.press(\"Enter\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")''','''    wait(page, lambda s: s[\"sim\"].get(\"case\") == 4 and s[\"sim\"][\"stage\"] == \"Chart\", 20, \"op\")\n    press_until(page, \"Enter\", lambda s: s[\"sim\"][\"stage\"] in (\"OpStart\", \"Op\"), \"the operation\")\n    wait(page, lambda s: s[\"sim\"][\"stage\"] == \"Op\", 40, \"op\")''')\ns=s.replace('''    page.screenshot(path=str(OUT / \"p_op.png\"))\n    page.keyboard.press(\"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 15, \"pause\")''','''    page.screenshot(path=str(OUT / \"p_op.png\"))\n    key(page, \"Escape\")\n    wait(page, lambda s: s[\"screen\"] == \"Pause\", 15, \"pause\")''')\ns=s.replace('''    time.sleep(1)\n    page.keyboard.press(\"Escape\")\n    time.sleep(0.5)\n    wait(page, lambda s: s[\"screen\"] in (\"Pause\", \"Playing\"), 5, \"any\")\n    page.evaluate(\"__game.do(JSON.stringify({screen:'Playing'}))\")\n    wait(page, lambda s: s[\"stage\"] == \"Results\", 40, \"results\")''','''    wait(page, lambda s: s[\"stage\"] == \"Results\", 60, \"results\")''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/mod.rs'\ns=open(p).read()\ns=s.replace('''            \"tune_score\": self.tune.get