{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkURQddPTwWzpQVEzUH2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GtPJ1QwqWWkgW3vxtP6esi","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_core/src/games/surgery/content/cases; python3 - <<'EOF'\nimport pathlib, json\n\ndef q(s): return json.dumps(s, ensure_ascii=False)\ndef S(kind, at, pts=None, r=None, axis=None, angle=None, to=None, hidden=False, tag=None):\n    o = [\"[[phase.spawn]]\", f'kind = \"{kind}\"', f\"at = [{at[0]}, {at[1]}]\"]\n    if pts: o.append(\"pts = [\" + \", \".join(f\"[{a}, {b}]\" for a,b in pts) + \"]\")\n    if r is not None: o.append(f\"r = {r}\")\n    if to: o.append(f\"to = [{to[0]}, {to[1]}]\")\n    if angle is not None: o.append(f\"angle = {angle}\")\n    if axis is not None: o.append(f\"axis = {axis}\")\n    if tag: o.append(f'tag = \"{tag}\"')\n    if hidden: o.append(\"hidden = true\")\n    return \"\\n\".join(o)\ndef Say(who, line, at=None, remaining=None):\n    o = [\"[[phase.event]]\"]\n    if at is not None: o.append(f\"at_time = {at}\")\n    if remaining is not None: o.append(f\"remaining = {remaining}\")\n    o.append(f\"say = [{q(who)}, {q(line)}]\")\n    return \"\\n\".join(o)\ndef Phase(name, objective, spawns=(), events=(), strain=None, meter=None):\n    o = [\"[[phase]]\", f\"name = {q(name)}\", f\"objective = {q(objective)}\", \"checkpoint = true\"]\n    if meter: o.append(f\"meter = {meter}\")\n    if strain: o.append(f\"strain = {strain}\")\n    return \"\\n\".join(o + list(spawns) + list(events)) + \"\\n\\n\"\ndef Lac(mid, dx=1.0, dz=0.3):\n    x,z = mid\n    return S(\"laceration\", mid, pts=[(round(x-dx,1), round(z-dz,1)), (x, round(z+dz,1)), (round(x+dx,1), round(z-dz,1))])\ndef Cut(a, b):\n    mid = (round((a[0]+b[0])/2,1), round((a[1]+b[1])/2,1))\n    return S(\"incision\", mid, pts=[a, mid, b])\n\ndef insert(case, before, block):\n    p = pathlib.Path(f\"{case}.toml\")\n    t = p.read_text()\n    marker = f'[[phase]]\\nname = \"{before}\"'\n    assert t.count(marker) == 1, (case, before)\n    p.write_text(t.replace(marker, block + marker))\n\n# ---- Case 0: Barbs ----\ninsert(\"case0\", \"Close\", Phase(\"Cable\", \"Steel cable, frayed. Pull each strand along its arrow.\", [\n    S(\"foreign\", (-6.2,-1.8), axis=150, tag=\"splinter\"), S(\"foreign\", (-3.2,1.9), axis=70, tag=\"splinter\"),\n    S(\"foreign\", (-0.6,-2.2), axis=-110, tag=\"splinter\"), S(\"foreign\", (2.8,1.4), axis=30, tag=\"splinter\"),\n    S(\"foreign\", (6,-0.6), axis=-30, tag=\"splinter\"), Lac((0.4,0.3)),\n  ], [Say(\"bashir\",\"Cable frays, Doctor. Every strand has a direction.\",at=0.3),\n      Say(\"bashir\",\"Two left. He's asked if he can keep them.\",remaining=2)])\n  + Phase(\"Salt\", \"Harbour water in the wound. Suction it, then gel what it touched.\", [\n    S(\"pool\",(-4.4,1.2),r=0.9), S(\"pool\",(3.8,-1.4),r=0.9),\n    S(\"burn\",(-1.4,-1.6),r=0.85,tag=\"inflammation\"), S(\"burn\",(1.2,2),r=0.85,tag=\"inflammation\"), S(\"burn\",(5.6,1.4),r=0.8,tag=\"inflammation\"),\n  ], [Say(\"bashir\",\"Nine days of harbour in that arm. Salt doesn't wait.\",at=0.3)]))\n\n# ---- Case 1: Routine ----\ninsert(\"case1\", \"Complication\", Phase(\"Adhesions\", \"Old scar bands. One stroke each. Laser what they were hiding.\", [\n    Cut((-6.2,-2.6),(-3,-1.6)), Cut((-1.6,2.6),(1.8,1.8)), Cut((3,-2.4),(6.2,-1.4)),\n    S(\"polyp\",(-5.2,0.8)), S(\"polyp\",(0.4,-1.2),r=0.36), S(\"polyp\",(5,1.2)),\n  ], [Say(\"voss\",\"Slower, Doctor. Nobody was ever promoted for a fast adhesion.\",at=0.4)]))\ninsert(\"case1\", \"Tidy Up\", Phase(\"Second Bleed\", \"That's not the same artery. Stitch it, clear it, IV if you must.\", [\n    S(\"bleeder\",(3.4,-1.2),axis=40), Lac((-4.6,1.8)), Lac((0.2,-2.6)),\n    S(\"pool\",(-1.6,1.2),r=0.9), S(\"pool\",(5.2,1.6),r=0.8),\n    S(\"foreign\",(-6,-1.2),axis=200,tag=\"splinter\"), S(\"foreign\",(1.8,2.6),axis=60,tag=\"splinter\"),\n  ], [Say(\"teddy\",\"That's two. Nobody said two. Is there a leaflet for two?\",at=0.3),\n      Say(\"bashir\",\"Nearly, Doctor. The gallery has stopped writing.\",remaining=2)]))\n\n# ---- Case 2: Shrapnel Night ----\ninsert(\"case2\", \"Second Sweep\", Phase(\"Conveyor\", \"Conveyor bolts, burned in. Laser the char, then pull the metal.\", [\n    S(\"polyp\",(-6,-1.4)), S(\"polyp\",(-2.4,2.2),r=0.36), S(\"polyp\",(2.6,-2.2)), S(\"polyp\",(6,1.2),r=0.36),\n    S(\"foreign\",(-4.2,0.6),axis=120,tag=\"shard\"), S(\"foreign\",(-0.4,-1.4),axis=-60,tag=\"shard\"),\n    S(\"foreign\",(0.8,1.6),axis=30,tag=\"shard\"), S(\"foreign\",(4.4,-0.4),axis=200,tag=\"shard\"),\n    S(\"pool\",(-1.8,-2.8),r=0.8),\n  ], [Say(\"teddy\",\"This one's got the terminal's logo on it. It's a nice logo, actually.\",at=0.3),\n      Say(\"bashir\",\"Bolts first, Doctor. Mr. Lark can wait.\",at=3.5)]))\ninsert(\"case2\", \"Close\", Phase(\"Rib Shards\", \"The rib let go. Two cuts to reach it, lift the pieces, gel the bed.\", [\n    Cut((-5.4,-2.4),(-1.8,-1.6)), Cut((1.6,1.8),(5.2,2.6)),\n    S(\"foreign\",(-3.6,0.4),axis=90,tag=\"shard\"), S(\"foreign\",(0,-0.6),axis=-120,tag=\"shard\"), S(\"foreign\",(3.6,-0.8),axis=20,tag=\"shard\"),\n    S(\"burn\",(-5.6,1.8),r=0.8), S(\"burn\",(5.8,-1.8),r=0.8), Lac((-0.6,2.6)),\n  ], [Say(\"bashir\",\"They're asking for you behind the curtain, Doctor. They can wait.\",at=0.4)]))\n\n# ---- Case 3: Something Moved ----\ninsert(\"case3\", \"The Mass\", Phase(\"Second Film\", \"The film said one mass. Clear the field and look again.\", [\n    S(\"polyp\",(-5.8,-1.2)), S(\"polyp\",(-2.6,2.4),r=0.36), S(\"polyp\",(3,-2.4)), S(\"polyp\",(5.8,1.4),r=0.36),\n    S(\"burn\",(-3.8,-2.6),r=0.8), S(\"burn\",(1.6,2.8),r=0.8), Lac((-0.4,-0.8)), S(\"pool\",(3.2,0.6),r=0.8),\n  ], [Say(\"bashir\",\"Forty minutes, the chart says. Home for breakfast.\",at=0.3),\n      Say(\"mara\",\"That's odd. She's a hair sharp, and she was flat when we opened.\",at=5)]))\ninsert(\"case3\", \"Close\", Phase(\"Trail\", \"It walked through her. Sweep its trail, pull what it dropped.\", [\n    S(\"foreign\",(-5.6,1.4),axis=140,tag=\"shard\",hidden=True), S(\"foreign\",(-2.2,-2.4),axis=-70,tag=\"shard\",hidden=True),\n    S(\"foreign\",(2.4,2),axis=40,tag=\"shard\",hidden=True), S(\"foreign\",(5.8,-1.4),axis=-30,tag=\"shard\",hidden=True),\n    S(\"pool\",(0,0.2),r=0.9), S(\"pool\",(-5.2,-1.8),r=0.8), Lac((3.2,-2.8)), Lac((-1.8,2.8)),\n  ], [Say(\"teddy\",\"It dropped things. Like, on purpose? Is that a thing it does?\",at=0.3),\n      Say(\"mara\",\"It isn't dropping them. It's marking the bars.\",at=3.5)]))\n\n# ---- Case 4: The Night Ward ----\ninsert(\"case4\", \"Lacrimosa\", Phase(\"Lower Lobe\", \"The lower lobe. It got there first. Burn out the buds, pull the seeds.\", [\n    S(\"polyp\",(-6,1.6)), S(\"polyp\",(-3.2,-2.4),r=0.36), S(\"polyp\",(-0.4,2.6)), S(\"polyp\",(3,-2.8),r=0.36), S(\"polyp\",(6,0.8)),\n    S(\"foreign\",(-1.8,-0.6),axis=70,tag=\"cyst\",hidden=True), S(\"foreign\",(2.8,1),axis=-40,tag=\"cyst\",hidden=True),\n    S(\"pool\",(5,-2),r=0.8), S(\"pool\",(-5,-1.2),r=0.8),\n  ], [Say(\"mara\",\"It's tuning. Can anyone else hear that?\",at=0.4), Say(\"voss\",\"No. Work.\",at=2.6)]))\ninsert(\"case4\", \"Repair\", Phase(\"Stems\", \"The stems are still rooted. Lift each one, gel the socket.\", [\n    S(\"foreign\",(-5.2,-1.4),axis=210,tag=\"splinter\"), S(\"foreign\",(-2.6,2.2),axis=110,tag=\"splinter\"),\n    S(\"foreign\",(0,-2.6),axis=-90,tag=\"splinter\"), S(\"foreign\",(2.8,2),axis=60,tag=\"splinter\"), S(\"foreign\",(5.4,-1.2),axis=-20,tag=\"splinter\"),\n    S(\"burn\",(-3.4,0.2),r=0.8), S(\"burn\",(-0.8,0.8),r=0.75), S(\"burn\",(1.6,-0.6),r=0.75), S(\"burn\",(4,0.6),r=0.8),\n  ], [Say(\"teddy\",\"Her numbers like that. Whatever that is. Keep doing it.\",at=0.3),\n      Say(\"bashir\",\"Twelve stems, Doctor. I counted. Nobody asked me to.\",remaining=4)]))\n\n# ---- Case 5: Second Opinion ----\ninsert(\"case5\", \"Second Growth\", Phase(\"Comminuted\", \"Smaller pieces, fewer places to put them. Set them, then the cysts.\", [\n    S(\"bone\",(-6.2,2.6),to=(-4.8,0.1),angle=-60,axis=0), S(\"bone\",(1.4,-2.6),to=(1.6,0.1),angle=55,axis=0), S(\"bone\",(6.4,2.4),to=(4.8,0.1),angle=-35,axis=0),\n    S(\"polyp\",(-2.8,-2.4),r=0.36), S(\"polyp\",(3.8,2.8),r=0.36),\n  ], [Say(\"pet\",\"Thirty years ago this was a morning. Hold still, leg.\",at=0.3)]))\ninsert(\"case5\", \"Close\", Phase(\"Periosteum\", \"Strip what grew along the bone. Stitch the sleeve behind you.\", [\n    S(\"foreign\",(-5.8,-2),axis=170,tag=\"cyst\"), S(\"foreign\",(-2.2,2.4),axis=100,tag=\"cyst\"),\n    S(\"foreign\",(2,-2.4),axis=-70,tag=\"cyst\"), S(\"foreign\",(5.6,2),axis=30,tag=\"cyst\"),\n    Lac((-4,1.6)), Lac((0,-1.6)), Lac((4,-1)), S(\"burn\",(-0.4,2.6),r=0.8), S(\"burn\",(-5.8,0.6),r=0.75),\n  ], [Say(\"pet\",\"I used to do this with a spoon. Don't write that down.\",at=0.3),\n      Say(\"bashir\",\"No, Doctor.\",at=3.1)]))\n\n# ---- Case 6: Dies Irae ----\ninsert(\"case6\", \"Embers\", Phase(\"Window\", \"Drain the sac. Free what's stuck to it.\", [\n    S(\"pool\",(-4.6,1.8),r=0.9), S(\"pool\",(4.2,-1.8),r=0.9), S(\"pool\",(0.4,2.8),r=0.8),\n    Cut((-6,-2.4),(-2.4,-1.4)), Cut((2,2.2),(5.8,1.4)), Lac((-1.4,0.4)), Lac((2.4,-0.4)),\n    S(\"polyp\",(-5.6,0.2)), S(\"polyp\",(5.8,-0.2),r=0.36),\n  ], [Say(\"voss\",\"Left of the phrenic. I put it there. Mind the old suture.\",at=0.4),\n      Say(\"pet\",\"You sutured this? It looks like a hem.\",at=3.4)]))\ninsert(\"case6\", \"Scorched Earth\", Phase(\"Ash\", \"Ash in the coronary bed. Lift it, gel it.\", [\n    S(\"foreign\",(-5,-1.8),axis=200,tag=\"ember\"), S(\"foreign\",(-2.2,2.2),axis=120,tag=\"ember\"), S(\"foreign\",(0.2,-2.6),axis=-80,tag=\"ember\"),\n    S(\"foreign\",(2.8,2.4),axis=50,tag=\"ember\"), S(\"foreign\",(5.4,-1.2),axis=-25,tag=\"ember\"),\n    S(\"burn\",(-3.4,0.2),r=0.85), S(\"burn\",(3,-0.2),r=0.85),\n  ], [Say(\"voss\",\"My notes say three fragments. My notes were optimistic.\",at=0.3)]))\ninsert(\"case6\", \"Close\", Phase(\"Coda\", \"Three more. It counts in fives, and it isn't finished. Lift on the ring.\", [],\n    [Say(\"teddy\",\"It's going up again. In fives. Why is it always fives?\",at=0.3),\n     Say(\"voss\",\"Because I thought it was elegant.\",at=3.2)],\n    strain='{ kind = \"dies_irae\", count = 3, rings = 5, fever = 0.6, at = [0, 0.2] }', meter=5))\n\n# ---- Case 7: Libera Me ----\ninsert(\"case7\", \"C: Dies Irae\", Phase(\"B: Interlude\", \"The coronaries are leaking. Stitch them, lift the stems.\", [\n    S(\"bleeder\",(-3.6,1.6),axis=60), Lac((3.4,-1.8)), Lac((-0.4,2.8)),\n    S(\"foreign\",(-5.6,-1.4),axis=190,tag=\"splinter\"), S(\"foreign\",(-1.8,-2.6),axis=-100,tag=\"splinter\"),\n    S(\"foreign\",(2,1.4),axis=40,tag=\"splinter\"), S(\"foreign\",(5.6,1.2),axis=-15,tag=\"splinter\"),\n    S(\"burn\",(0.6,-0.6),r=0.8), S(\"burn\",(5.4,-2.4),r=0.75),\n  ], [Say(\"teddy\",\"Scalpel. No. Sorry. That's a spoon. Why do we have a spoon?\",at=0.3), Say(\"pet\",\"Mine. Give it here.\",at=3.2)]))\ninsert(\"case7\", \"E: The Soloist\", Phase(\"D: Aftershock\", \"He's back, and so is the bleeding. Quickly. Something's coming up.\", [\n    S(\"pool\",(-4.8,1.6),r=0.9), S(\"pool\",(4.4,-1.8),r=0.9), S(\"pool\",(0.2,2.8),r=0.8), Lac((-2.2,-2.2)), Lac((2.6,1.4)),\n    S(\"polyp\",(-5.8,-1)), S(\"polyp\",(0,-0.2),r=0.36), S(\"polyp\",(5.8,0.8)), S(\"burn\",(-1.6,1),r=0.75),\n  ], [Say(\"pet\",\"Seventy-two, and climbing. Don't admire it.\",at=0.3),\n      Say(\"teddy\",\"It's gone quiet. I hate quiet. I have a joke. No. I don't. I don't have one.\",at=3.4)]))\ninsert(\"case7\", \"Close\", Phase(\"E: Coda\", \"It left its roots in him. Get them all.\", [\n    S(\"foreign\",(-5.6,-1.6),axis=200,tag=\"ember\"), S(\"foreign\",(-3,2.4),axis=115,tag=\"ember\"), S(\"foreign\",(-0.8,-2.6),axis=-95,tag=\"ember\"),\n    S(\"foreign\",(1.6,2.6),axis=70,tag=\"ember\"), S(\"foreign\",(3.6,-2.2),axis=-40,tag=\"ember\"), S(\"foreign\",(5.8,0.8),axis=10,tag=\"ember\"),\n    Lac((-3.2,0)), Lac((2.2,0.2)), S(\"burn\",(-5.6,1.6),r=0.8), S(\"burn\",(0,0.6),r=0.75), S(\"burn\",(5.6,-1.8),r=0.8),\n  ], [Say(\"mara\",\"Every one. He'd count.\",at=0.3), Say(\"pet\",\"He is counting. Look at his eyelids.\",at=2.8)]))\nEOF\ncd ../../../../../../..; until [ -f target/.rebuilt ]; do sleep 5; done; CARGO_BUILD_JOBS=4 cargo test --offline -p pav_core --test surgery difficulty_table -- --ignored --nocapture 2>&1 | grep -E \"^diff[01]|^error|test result|panicked\" -A1 | cut -c1-210","description":"Add the new operation phases and remeasure every case","timeout":590000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6176,"cache_read_input_tokens":330940,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6176},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"4e4e2a03-62bb-4a1a-8da5-b01bd254057d","timestamp":"2026-11-05T21:16:24.473Z","request_id":"req_011CgkURQDpnP6oxeC7cJ1JT","wire_tool_inputs":{"toolu_01GtPJ1QwqWWkgW3vxtP6esi":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_core/src/games/surgery/content/cases; python3 - <<'EOF'\nimport pathlib, json\n\ndef q(s): return json.dumps(s, ensure_ascii=False)\ndef S(kind, at, pts=None, r=None, axis=None, angle=None, to=None, hidden=False, tag=None):\n    o = [\"[[phase.spawn]]\", f'kind = \"{kind}\"', f\"at = [{at[0]}, {at[1]}]\"]\n    if pts: o.append(\"pts = [\" + \", \".join(f\"[{a}, {b}]\" for a,b in pts) + \"]\")\n    if r is not None: o.append(f\"r = {r}\")\n    if to: o.append(f\"to = [{to[0]}, {to[1]}]\")\n    if angle is not None: o.append(f\"angle = {angle}\")\n    if axis is not None: o.append(f\"axis = {axis}\")\n    if tag: o.append(f'tag = \"{tag}\"')\n    if hidden: o.append(\"hidden = true\")\n    return \"\\n\".join(o)\ndef Say(who, line, at=None, remaining=None):\n    o = [\"[[phase.event]]\"]\n    if at is not None: o.append(f\"at_time = {at}\")\n    if remaining is not None: o.append(f\"remaining = {remaining}\")\n    o.append(f\"say = [{q(who)}, {q(line)}]\")\n    return \"\\n\".join(o)\ndef Phase(name, objective, spawns=(), events=(), strain=None, meter=None):\n    o = [\"[[phase]]\", f\"name = {q(name)}\", f\"objective = {q(objective)}\", \"checkpoint = true\"]\n    if meter: o.append(f\"meter = {meter}\")\n    if strain: o.append(f\"strain = {strain}\")\n    return \"\\n\".join(o + list(spawns) + list(events)) + \"\\n\\n\"\ndef Lac(mid, dx=1.0, dz=0.3):\n    x,z = mid\n    return S(\"laceration\", mid, pts=[(round(x-dx,1), round(z-dz,1)), (x, round(z+dz,1)), (round(x+dx,1), round(z-dz,1))])\ndef Cut(a, b):\n    mid = (round((a[0]+b[0])/2,1), round((a[1]+b[1])/2,1))\n    return S(\"incision\", mid, pts=[a, mid, b])\n\ndef insert(case, before, block):\n    p = pathlib.Path(f\"{case}.toml\")\n    t = p.read_text()\n    marker = f'[[phase]]\\nname = \"{before}\"'\n    assert t.count(marker) == 1, (case, before)\n    p.write_text(t.replace(marker, block + marker))\n\n# ---- Case 0: Barbs ----\ninsert(\"case0\", \"Close\", Phase(\"Cable\", \"Steel cable, frayed. Pull each strand along its arrow.\", [\n    S(\"foreign\", (-6.2,-1.8), axis=150, tag=\"splinter\"), S(\"foreign\", (-3.2,1.9), axis=70, tag=\"splinter\"),\n    S(\"foreign\", (-0.6,-2.2), axis=-110, tag=\"splinter\"), S(\"foreign\", (2.8,1.4), axis=30, tag=\"splinter\"),\n    S(\"foreign\", (6,-0.6), axis=-30, tag=\"splinter\"), Lac((0.4,0.3)),\n  ], [Say(\"bashir\",\"Cable frays, Doctor. Every strand has a direction.\",at=0.3),\n      Say(\"bashir\",\"Two left. He's asked if he can keep them.\",remaining=2)])\n  + Phase(\"Salt\", \"Harbour water in the wound. Suction it, then gel what it touched.\", [\n    S(\"pool\",(-4.4,1.2),r=0.9), S(\"pool\",(3.8,-1.4),r=0.9),\n    S(\"burn\",(-1.4,-1.6),r=0.85,tag=\"inflammation\"), S(\"burn\",(1.2,2),r=0.85,tag=\"inflammation\"), S(\"burn\",(5.6,1.4),r=0.8,tag=\"inflammation\"),\n  ], [Say(\"bashir\",\"Nine days of harbour in that arm. Salt doesn't wait.\",at=0.3)]))\n\n# ---- Case 1: Routine ----\ninsert(\"case1\", \"Complication\", Phase(\"Adhesions\", \"Old scar bands. One stroke each. Laser what they were hiding.\", [\n    Cut((-6.2,-2.6),(-3,-1.6)), Cut((-1.6,2.6),(1.8,1.8)), Cut((3,-2.4),(6.2,-1.4)),\n    S(\"polyp\",(-5.2,0.8)), S(\"polyp\",(0.4,-1.2),r=0.36), S(\"polyp\",(5,1.2)),\n  ], [Say(\"voss\",\"Slower, Doctor. Nobody was ever promoted for a fast adhesion.\",at=0.4)]))\ninsert(\"case1\", \"Tidy Up\", Phase(\"Second Bleed\", \"That's not the same artery. Stitch it, clear it, IV if you must.\", [\n    S(\"bleeder\",(3.4,-1.2),axis=40), Lac((-4.6,1.8)), Lac((0.2,-2.6)),\n    S(\"pool\",(-1.6,1.2),r=0.9), S(\"pool\",(5.2,1.6),r=0.8),\n    S(\"foreign\",(-6,-1.2),axis=200,tag=\"splinter\"), S(\"foreign\",(1.8,2.6),axis=60,tag=\"splinter\"),\n  ], [Say(\"teddy\",\"That's two. Nobody said two. Is there a leaflet for two?\",at=0.3),\n      Say(\"bashir\",\"Nearly, Doctor. The gallery has stopped writing.\",remaining=2)]))\n\n# ---- Case 2: Shrapnel Night ----\ninsert(\"case2\", \"Second Sweep\", Phase(\"Conveyor\", \"Conveyor bolts, burned in. Laser the char, then pull the metal.\", [\n    S(\"polyp\",(-6,-1.4)), S(\"polyp\",(-2.4,2.2),r=0.36), S(\"polyp\",(2.6,-2.2)), S(\"polyp\",(6,1.2),r=0.36),\n    S(\"foreign\",(-4.2,0.6),axis=120,tag=\"shard\"), S(\"foreign\",(-0.4,-1.4),axis=-60,tag=\"shard\"),\n    S(\"foreign\",(0.8,1.6),axis=30,tag=\"shard\"), S(\"foreign\",(4.4,-0.4),axis=200,tag=\"shard\"),\n    S(\"pool\",(-1.8,-2.8),r=0.8),\n  ], [Say(\"teddy\",\"This one's got the terminal's logo on it. It's a nice logo, actually.\",at=0.3),\n      Say(\"bashir\",\"Bolts first, Doctor. Mr. Lark can wait.\",at=3.5)]))\ninsert(\"case2\", \"Close\", Phase(\"Rib Shards\", \"The rib let go. Two cuts to reach it, lift the pieces, gel the bed.\", [\n    Cut((-5.4,-2.4),(-1.8,-1.6)), Cut((1.6,1.8),(5.2,2.6)),\n    S(\"foreign\",(-3.6,0.4),axis=90,tag=\"shard\"), S(\"foreign\",(0,-0.6),axis=-120,tag=\"shard\"), S(\"foreign\",(3.6,-0.8),axis=20,tag=\"shard\"),\n    S(\"burn\",(-5.6,1.8),r=0.8), S(\"burn\",(5.8,-1.8),r=0.8), Lac((-0.6,2.6)),\n  ], [Say(\"bashir\",\"They're asking for you behind the curtain, Doctor. They can wait.\",at=0.4)]))\n\n# ---- Case 3: Something Moved ----\ninsert(\"case3\", \"The Mass\", Phase(\"Second Film\", \"The film said one mass. Clear the field and look again.\", [\n    S(\"polyp\",(-5.8,-1.2)), S(\"polyp\",(-2.6,2.4),r=0.36), S(\"polyp\",(3,-2.4)), S(\"polyp\",(5.8,1.4),r=0.36),\n    S(\"burn\",(-3.8,-2.6),r=0.8), S(\"burn\",(1.6,2.8),r=0.8), Lac((-0.4,-0.8)), S(\"pool\",(3.2,0.6),r=0.8),\n  ], [Say(\"bashir\",\"Forty minutes, the chart says. Home for breakfast.\",at=0.3),\n      Say(\"mara\",\"That's odd. She's a hair sharp, and she was flat when we opened.\",at=5)]))\ninsert(\"case3\", \"Close\", Phase(\"Trail\", \"It walked through her. Sweep its trail, pull what it dropped.\", [\n    S(\"foreign\",(-5.6,1.4),axis=140,tag=\"shard\",hidden=True), S(\"foreign\",(-2.2,-2.4),axis=-70,tag=\"shard\",hidden=True),\n    S(\"foreign\",(2.4,2),axis=40,tag=\"shard\",hidden=True), S(\"foreign\",(5.8,-1.4),axis=-30,tag=\"shard\",hidden=True),\n    S(\"pool\",(0,0.2),r=0.9), S(\"pool\",(-5.2,-1.8),r=0.8), Lac((3.2,-2.8)), Lac((-1.8,2.8)),\n  ], [Say(\"teddy\",\"It dropped things. Like, on purpose? Is that a thing it does?\",at=0.3),\n      Say(\"mara\",\"It isn't dropping them. It's marking the bars.\",at=3.5)]))\n\n# ---- Case 4: The Night Ward ----\ninsert(\"case4\", \"Lacrimosa\", Phase(\"Lower Lobe\", \"The lower lobe. It got there first. Burn out the buds, pull the seeds.\", [\n    S(\"polyp\",(-6,1.6)), S(\"polyp\",(-3.2,-2.4),r=0.36), S(\"polyp\",(-0.4,2.6)), S(\"polyp\",(3,-2.8),r=0.36), S(\"polyp\",(6,0.8)),\n    S(\"foreign\",(-1.8,-0.6),axis=70,tag=\"cyst\",hidden=True), S(\"foreign\",(2.8,1),axis=-40,tag=\"cyst\",hidden=True),\n    S(\"pool\",(5,-2),r=0.8), S(\"pool\",(-5,-1.2),r=0.8),\n  ], [Say(\"mara\",\"It's tuning. Can anyone else hear that?\",at=0.4), Say(\"voss\",\"No. Work.\",at=2.6)]))\ninsert(\"case4\", \"Repair\", Phase(\"Stems\", \"The stems are still rooted. Lift each one, gel the socket.\", [\n    S(\"foreign\",(-5.2,-1.4),axis=210,tag=\"splinter\"), S(\"foreign\",(-2.6,2.2),axis=110,tag=\"splinter\"),\n    S(\"foreign\",(0,-2.6),axis=-90,tag=\"splinter\"), S(\"foreign\",(2.8,2),axis=60,tag=\"splinter\"), S(\"foreign\",(5.4,-1.2),axis=-20,tag=\"splinter\"),\n    S(\"burn\",(-3.4,0.2),r=0.8), S(\"burn\",(-0.8,0.8),r=0.75), S(\"burn\",(1.6,-0.6),r=0.75), S(\"burn\",(4,0.6),r=0.8),\n  ], [Say(\"teddy\",\"Her numbers like that. Whatever that is. Keep doing it.\",at=0.3),\n      Say(\"bashir\",\"Twelve stems, Doctor. I counted. Nobody asked me to.\",remaining=4)]))\n\n# ---- Case 5: Second Opinion ----\ninsert(\"case5\", \"Second Growth\", Phase(\"Comminuted\", \"Smaller pieces, fewer places to put them. Set them, then the cysts.\", [\n    S(\"bone\",(-6.2,2.6),to=(-4.8,0.1),angle=-60,axis=0), S(\"bone\",(1.4,-2.6),to=(1.6,0.1),angle=55,axis=0), S(\"bone\",(6.4,2.4),to=(4.8,0.1),angle=-35,axis=0),\n    S(\"polyp\",(-2.8,-2.4),r=0.36), S(\"polyp\",(3.8,2.8),r=0.36),\n  ], [Say(\"pet\",\"Thirty years ago this was a morning. Hold still, leg.\",at=0.3)]))\ninsert(\"case5\", \"Close\", Phase(\"Periosteum\", \"Strip what grew along the bone. Stitch the sleeve behind you.\", [\n    S(\"foreign\",(-5.8,-2),axis=170,tag=\"cyst\"), S(\"foreign\",(-2.2,2.4),axis=100,tag=\"cyst\"),\n    S(\"foreign\",(2,-2.4),axis=-70,tag=\"cyst\"), S(\"foreign\",(5.6,2),axis=30,tag=\"cyst\"),\n    Lac((-4,1.6)), Lac((0,-1.6)), Lac((4,-1)), S(\"burn\",(-0.4,2.6),r=0.8), S(\"burn\",(-5.8,0.6),r=0.75),\n  ], [Say(\"pet\",\"I used to do this with a spoon. Don't write that down.\",at=0.3),\n      Say(\"bashir\",\"No, Doctor.\",at=3.1)]))\n\n# ---- Case 6: Dies Irae ----\ninsert(\"case6\", \"Embers\", Phase(\"Window\", \"Drain the sac. Free what's stuck to it.\", [\n    S(\"pool\",(-4.6,1.8),r=0.9), S(\"pool\",(4.2,-1.8),r=0.9), S(\"pool\",(0.4,2.8),r=0.8),\n    Cut((-6,-2.4),(-2.4,-1.4)), Cut((2,2.2),(5.8,1.4)), Lac((-1.4,0.4)), Lac((2.4,-0.4)),\n    S(\"polyp\",(-5.6,0.2)), S(\"polyp\",(5.8,-0.2),r=0.36),\n  ], [Say(\"voss\",\"Left of the phrenic. I put it there. Mind the old suture.\",at=0.4),\n      Say(\"pet\",\"You sutured this? It looks like a hem.\",at=3.4)]))\ninsert(\"case6\", \"Scorched Earth\", Phase(\"Ash\", \"Ash in the coronary bed. Lift it, gel it.\", [\n    S(\"foreign\",(-5,-1.8),axis=200,tag=\"ember\"), S(\"foreign\",(-2.2,2.2),axis=120,tag=\"ember\"), S(\"foreign\",(0.2,-2.6),axis=-80,tag=\"ember\"),\n    S(\"foreign\",(2.8,2.4),axis=50,tag=\"ember\"), S(\"foreign\",(5.4,-1.2),axis=-25,tag=\"ember\"),\n    S(\"burn\",(-3.4,0.2),r=0.85), S(\"burn\",(3,-0.2),r=0.85),\n  ], [Say(\"voss\",\"My notes say three fragments. My notes were optimistic.\",at=0.3)]))\ninsert(\"case6\", \"Close\", Phase(\"Coda\", \"Three more. It counts in fives, and it isn't finished. Lift on the ring.\", [],\n    [Say(\"teddy\",\"It's going up again. In fives. Why is it always fives?\",at=0.3),\n     Say(\"voss\",\"Because I thought it was elegant.\",at=3.2)],\n    strain='{ kind = \"dies_irae\", count = 3, rings = 5, fever = 0.6, at = [0, 0.2] }', meter=5))\n\n# ---- Case 7: Libera Me ----\ninsert(\"case7\", \"C: Dies Irae\", Phase(\"B: Interlude\", \"The coronaries are leaking. Stitch them, lift the stems.\", [\n    S(\"bleeder\",(-3.6,1.6),axis=60), Lac((3.4,-1.8)), Lac((-0.4,2.8)),\n    S(\"foreign\",(-5.6,-1.4),axis=190,tag=\"splinter\"), S(\"foreign\",(-1.8,-2.6),axis=-100,tag=\"splinter\"),\n    S(\"foreign\",(2,1.4),axis=40,tag=\"splinter\"), S(\"foreign\",(5.6,1.2),axis=-15,tag=\"splinter\"),\n    S(\"burn\",(0.6,-0.6),r=0.8), S(\"burn\",(5.4,-2.4),r=0.75),\n  ], [Say(\"teddy\",\"Scalpel. No. Sorry. That's a spoon. Why do we have a spoon?\",at=0.3), Say(\"pet\",\"Mine. Give it here.\",at=3.2)]))\ninsert(\"case7\", \"E: The Soloist\", Phase(\"D: Aftershock\", \"He's back, and so is the bleeding. Quickly. Something's coming up.\", [\n    S(\"pool\",(-4.8,1.6),r=0.9), S(\"pool\",(4.4,-1.8),r=0.9), S(\"pool\",(0.2,2.8),r=0.8), Lac((-2.2,-2.2)), Lac((2.6,1.4)),\n    S(\"polyp\",(-5.8,-1)), S(\"polyp\",(0,-0.2),r=0.36), S(\"polyp\",(5.8,0.8)), S(\"burn\",(-1.6,1),r=0.75),\n  ], [Say(\"pet\",\"Seventy-two, and climbing. Don't admire it.\",at=0.3),\n      Say(\"teddy\",\"It's gone quiet. I hate quiet. I have a joke. No. I don't. I don't have one.\",at=3.4)]))\ninsert(\"case7\", \"Close\", Phase(\"E: Coda\", \"It left its roots in him. Get them all.\", [\n    S(\"foreign\",(-5.6,-1.6),axis=200,tag=\"ember\"), S(\"foreign\",(-3,2.4),axis=115,tag=\"ember\"), S(\"foreign\",(-0.8,-2.6),axis=-95,tag=\"ember\"),\n    S(\"foreign\",(1.6,2.6),axis=70,tag=\"ember\"), S(\"foreign\",(3.6,-2.2),axis=-40,tag=\"ember\"), S(\"foreign\",(5.8,0.8),axis=10,tag=\"ember\"),\n    Lac((-3.2,0)), Lac((2.2,0.2)), S(\"burn\",(-5.6,1.6),r=0.8), S(\"burn\",(0,0.6),r=0.75), S(\"burn\",(5.6,-1.8),r=0.8),\n  ], [Say(\"mara\",\"Every one. He'd count.\",at=0.3), Say(\"pet\",\"He is counting. Look at his eyelids.\",at=2.8)]))\nEOF\ncd ../../../../../../..; until [ -f target/.rebuilt ]; do sleep 5; done; CARGO_BUILD_JOBS=4 cargo test --offline -p pav_core --test surgery difficulty_table -- --ignored --nocapture 2>&1 | grep -E \"^diff[01]|^error|test result|panicked\" -A1 | cut -c1-210","description":"Add the new operation phases and remeasure every case","timeout":590000}}}
