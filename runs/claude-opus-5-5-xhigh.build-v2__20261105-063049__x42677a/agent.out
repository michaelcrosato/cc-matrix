          try:\n                        ctx = b.new_context(viewport={\"width\": 1100, \"height\": 700})\n                        page = ctx.new_page()\n                        page.goto(f\"{base}/harness.html?game=game.html&{q}\")\n                        page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=480000)\n                        check = page.evaluate(\"window.__hubCheck\")\n                        if check and check.get(\"pass\"):\n                            passed += 1\n                        else:\n                            failed += 1\n                            bad = [c for c in (check or {}).get(\"checks\", []) if not c.get(\"ok\", c.get(\"pass\", True))]\n                            print(f\"FAIL harness {q}: {json.dumps(bad or check)[:1500]}\")\n                        ctx.close()\n                        break\n                    except Exception as e:\n                        if any(c in str(e) for c in CRASHED) and attempt < 2:\n                            try:\n                                b.close()\n                            except Exception:\n                                pass\n                            time.sleep(20)\n                            b = p.chromium.launch(args=ARGS)\n                            continue\n20:def serve():\n27:def main():\n84:                            st.append(f.evaluate(\"window.__game ? window.__game.status() : null\"))\n115:                page.wait_for_function(\"window.__game && window.__game.status() && window.__game.status().screen === 'Title'\",\n116:                assert page.evaluate(\"window.__game.status().hub\") is False","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015c98b8RST1XTLDnPqWAFhv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
