aracter Pack: Adventurers","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01ML6K5hVRNTgyFPURrsBn9D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
