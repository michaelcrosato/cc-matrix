220),rect(-3,5.3,3,5.6),emissive=1.2,repeat=(3,9)),\n card(-3.5,(150,160,160),rect(-7.8,-2.2,-3.6,-1.9)),\n card(-3.5,(70,90,110),rect(-7.6,-1.9,-3.8,-1.55),chaikin=1),\n card(-3.5,(60,66,70),rect(-7.4,-3.6,-7.2,-2.2)),\n card(-3.5,(60,66,70),rect(-4.2,-3.6,-4,-2.2)),\n card(-1.4,(36,58,62),rect(-12,-6,12,-3.1)),\n],rain=True,lamps=[(0,5,2,1,.97,.9,14)],amb_sky=(.6,.68,.72),amb_ground=(.46,.5,.5))\nset_('scrub','The scrub room',(30,52,56),[\n card(-7,(120,158,152),rect(-16,-8,16,8)),\n card(-6.8,(96,132,126),rect(-16,-8,16,-1.4)),\n card(-6.5,(200,214,210),rect(-8,1,-3.4,4.2)),\n card(-6.4,(150,190,200),rect(-7.7,1.3,-3.7,3.9),emissive=.1),\n card(-6.5,(200,214,210),rect(3.4,1,8,4.2)),\n card(-6.4,(150,190,200),rect(3.7,1.3,7.7,3.9),emissive=.1),\n card(-4,(190,200,204),rect(-9,-1.5,9,-1)),\n card(-4,(160,170,176),rect(-9,-3.8,9,-1.5)),\n card(-3.8,(130,140,146),rect(-5.8,-.9,-5.5,.2)),\n card(-3.8,(130,140,146),rect(5.5,-.9,5.8,.2)),\n card(-3.8,(240,244,230),rect(-3,5.2,3,5.5),emissive=1.1),\n],lamps=[(0,5,2,1,1,.95,14)])\nset_('office',\"Voss's office\",(18,22,30),[\n card(-7,(52,40,38),rect(-16,-8,16,8)),\n card(-6.8,(70,54,50),rect(-16,-8,16,-1.5)),\n card(-6.5,(14,26,44),rect(-5,-.8,5,5),emissive=.12),\n card(-6.4,(255,200,120),rect(-4.4,-.3,-4.1,0),emissive=2,repeat=(9,1)),\n card(-6.3,(50,38,36),rect(-5.2,-1,5.2,-.8)),\n card(-6.3,(50,38,36),rect(-.1,-.8,.1,5)),\n card(-3,(96,60,44),rect(-6.5,-2.1,6.5,-1.75)),\n card(-3,(76,48,36),rect(-6,-4,-5,-2.1)),\n card(-3,(76,48,36),rect(5,-4,6,-2.1)),\n card(-5,(110,42,36),rect(-9,0,-8.4,2.1),repeat=(4,.7)),\n card(-5,(40,70,90),rect(7,0,7.6,2.1),repeat=(3,.7)),\n],rain=True,lamps=[(0,3,3,1,.86,.66,10)],amb_sky=(.5,.48,.5),amb_ground=(.44,.38,.36))\nset_('atrium','The Vane Wing atrium',(60,44,30),[\n card(-7,(190,150,96),rect(-16,-8,16,8)),\n card(-6.8,(150,104,66),rect(-16,-8,16,-2)),\n card(-6.4,(236,214,170),rect(-1.3,-8,-.3,8),repeat=(5,5.6)),\n card(-6.2,(120,30,50),[(-3.6,5.4),(3.6,5.4),(3,1.8),(0,1),(-3,1.8)],