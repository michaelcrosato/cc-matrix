{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Put4pYy6sDWdBBxpdoqZ8","type":"tool_result","content":"1\t//! Plain-data description of one frame. The renderer knows nothing about the simulation;\n2\t//! a view layer turns game state into a `Scene` every frame.\n3\t\n4\tuse glam::{Mat4, Vec3};\n5\t\n6\tpub use crate::mesh::MeshKey;\n7\t\n8\t/// Surface style, per object.\n9\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n10\t#[repr(u32)]\n11\tpub enum Style {\n12\t    /// Albedo only (plus cast shadows as a darker tone): the clean 2D look.\n13\t    Flat = 0,\n14\t    /// Toon bands, rim light.\n15\t    #[default]\n16\t    Cel = 1,\n17\t    /// Smooth lighting with specular.\n18\t    Lit = 2,\n19\t    /// Pure albedo, ignores all lighting and shadows (UI-like markers, emissive signs).\n20\t    Unlit = 3,\n21\t}\n22\t\n23\timpl Style {\n24\t    pub const ALL: [Style; 4] = [Style::Flat, Style::Cel, Style::Lit, Style::Unlit];\n25\t    pub fn name(self) -> &'static str {\n26\t        match self {\n27\t            Style::Flat => \"flat\",\n28\t            Style::Cel => \"cel\",\n29\t            Style::Lit => \"lit\",\n30\t            Style::Unlit => \"unlit\",\n31\t        }\n32\t    }\n33\t}\n34\t\n35\tpub mod flags {\n36\t    /// Never removed by cutaway or occlusion fade (the player, markers).\n37\t    pub const NO_CUT: u32 = 1;\n38\t    /// Does not cast shadows.\n39\t    pub const NO_SHADOW: u32 = 2;\n40\t    /// Does not receive shadows.\n41\t    pub const NO_RECEIVE_SHADOW: u32 = 4;\n42\t    /// Cutaway lowers individual vertices near the player (for big meshes like terrain).\n43\t    pub const CUT_VERTEX: u32 = 8;\n44\t    /// Both sides are real surfaces (cloth), not the inside of a solid.\n45\t    pub const TWO_SIDED: u32 = 16;\n46\t    /// Drawn as pixel art (in blocks of `FilterSettings::pixel_art` pixels) when that is\n47\t    /// above 1; the rest of the screen stays sharp.\n48\t    pub const PIXEL: u32 = 32;\n49\t    /// Part of the characters and objects (not the environment): filters aimed at one part\n50\t    /// of the scene (`Part`) tell the two apart by this flag.\n51\t    pub const OBJECT: u32 = 64;\n52\t    /// Sways in the wind like leaves (canopies, bushes, banners): vertices move more the\n53\t    /// higher they are above the bottom of the instance.\n54\t    pub const SWAY: u32 = 128;\n55\t    /// Bends like grass: far in gusts, and away from the wind's pusher (the player).\n56\t    pub const GRASS: u32 = 256;\n57\t}\n58\t\n59\t/// Wind for swaying foliage and grass (vertex shader).\n60\t#[derive(Clone, Copy, Debug, Default)]\n61\tpub struct Wind {\n62\t    /// Horizontal direction the wind blows toward (x, z).\n63\t    pub direction: glam::Vec2,\n64\t    /// 0 = still air.\n65\t    pub strength: f32,\n66\t    /// How quickly gusts roll across (1 = normal).\n67\t    pub gusts: f32,\n68\t    /// Grass bends away from this point (the player's feet) within `push_radius` (0 = off).\n69\t    pub pusher: Vec3,\n70\t    pub push_radius: f32,\n71\t}\n72\t\n73\t/// Which part of the scene a filter applies to.\n74\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n75\t#[repr(u32)]\n76\tpub enum Part {\n77\t    /// Everything on screen.\n78\t    #[default]\n79\t    All = 0,\n80\t    /// Instances flagged `flags::OBJECT` (characters, props, loot, projectiles, effects).\n81\t    Objects = 1,\n82\t    /// Everything else: level geometry, fixed scenery and the sky.\n83\t    Environment = 2,\n84\t}\n85\t\n86\t/// Painterly and print looks redrawn from the finished picture.\n87\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n88\t#[repr(u32)]\n89\tpub enum Stylize {\n90\t    #[default]\n91\t    Off = 0,\n92\t    /// Oil paint: a generalized Kuwahara filter (flat strokes that keep their edges) on canvas.\n93\t    Paint = 1,\n94\t    /// Print: rotated dot screens (CMYK comics, or black dots for newsprint).\n95\t    Halftone = 2,\n96\t    /// Text mode: each cell becomes a character picked by its brightness.\n97\t    Ascii = 3,\n98\t    /// Pencil on paper: hatching that thickens with darkness, plus contour lines.\n99\t    Sketch = 4,\n100\t}\n101\t\n102\t/// How a screen transition covers the picture.\n103\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n104\t#[repr(u32)]\n105\tpub enum Transition {\n106\t    #[default]\n107\t    Fade = 0,\n108\t    /// A circle closing on `transition_center`.\n109\t    Iris = 1,\n110\t    /// Diamonds growing in a wave across the screen.\n111\t    Diamonds = 2,\n112\t    /// Random blocks.\n113\t    Dissolve = 3,\n114\t    /// Pixels growing into big blocks, then black.\n115\t    Mosaic = 4,\n116\t    /// Horizontal blinds.\n117\t    Blinds = 5,\n118\t}\n119\t\n120\t/// A mesh rebuilt every frame (soft bodies), in world space.\n121\t#[derive(Clone, Debug)]\n122\tpub struct DynamicMesh {\n123\t    pub data: crate::mesh::MeshData,\n124\t    pub color: Vec3,\n125\t    pub emissive: f32,\n126\t    pub style: Style,\n127\t    pub flags: u32,\n128\t    pub group: u32,\n129\t    /// Procedural material: `slot | seed << 12` (see `MeshInstance::material`; its local\n130\t    /// frame is the world's).\n131\t    pub material: u32,\n132\t}\n133\t\n134\t#[derive(Clone, Copy, Debug)]\n135\tpub struct MeshInstance {\n136\t    pub mesh: MeshKey,\n137\t    pub transform: Mat4,\n138\t    /// Linear RGB albedo.\n139\t    pub color: Vec3,\n140\t    /// Emissive strength (0 = none). Adds `color * emissive` on top of lighting.\n141\t    pub emissive: f32,\n142\t    pub style: Style,\n143\t    pub flags: u32,\n144\t    /// Outline group: edges are drawn where the group changes. 0 = background, use 1 for\n145\t    /// static level geometry and unique ids for objects.\n146\t    pub group: u32,\n147\t    /// Procedural material: a row of `Scene::materials` in bits 0-11 (0 = none, the plain\n148\t    /// colour) and a per-instance seed in bits 12-31 (`material_param`). `color` and\n149\t    /// `emissive` are the material's base colour and glow, so one row serves every tint.\n150\t    pub material: u32,\n151\t    /// Half extents of the part in its own frame, for the material's axis map and gradients.\n152\t    /// ZERO derives them from the transform's columns (meshes that fill the unit cube);\n153\t    /// meshes built at their real size, like rounded boxes, set them.\n154\t    pub ext: Vec3,\n155\t}\n156\t\n157\t/// Analytic SDF primitive, ray-traced per pixel: a rounded cone between `a` and `b` with\n158\t/// radii `ra`/`rb`. Equal radii give a capsule; `a == b` gives a sphere.\n159\t#[derive(Clone, Copy, Debug)]\n160\tpub struct SdfInstance {\n161\t    pub a: Vec3,\n162\t    pub b: Vec3,\n163\t    pub ra: f32,\n164\t    pub rb: f32,\n165\t    pub color: Vec3,\n166\t    pub emissive: f32,\n167\t    pub style: Style,\n168\t    pub flags: u32,\n169\t    pub group: u32,\n170\t    /// Procedural material, as `MeshInstance::material`; the local frame runs along a→b.\n171\t    pub material: u32,\n172\t}\n173\t\n174\timpl SdfInstance {\n175\t    pub fn sphere(center: Vec3, r: f32, color: Vec3) -> Self {\n176\t        Self { a: center, b: center, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n177\t    }\n178\t    pub fn capsule(a: Vec3, b: Vec3, r: f32, color: Vec3) -> Self {\n179\t        Self { a, b, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n180\t    }\n181\t}\n182\t\n183\t/// Material slots per scene (bits 0-11 of an instance's `material`; slot 0 is none).\n184\tpub const MATERIAL_SLOTS: u32 = 4096;\n185\t\n186\t/// An instance's `material` word: the table row `slot` and a per-instance `seed` (20 bits).\n187\tpub fn material_param(slot: u32, seed: u32) -> u32 {\n188\t    (slot & (MATERIAL_SLOTS - 1)) | (seed & 0xfffff) << 12\n189\t}\n190\t\n191\t/// One pattern layer of a material row, laid out as `MatLayer` in `shaders/materials.wgsl`.\n192\t#[repr(C)]\n193\t#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\n194\tpub struct GpuLayer {\n195\t    /// x: kernel | variant<<8 | axis<<12 | facing<<16 | mask<<20 | paint<<24 | ncells<<28;\n196\t    /// y: salt.\n197\t    pub head: [u32; 4],\n198\t    /// rgb linear colour (paint 0) or r the linear shade factor (paint 1); a strength.\n199\t    pub paint: [f32; 4],\n200\t    pub a: [f32; 4],\n201\t    pub b: [f32; 4],\n202\t    /// x vary, y cavity, z glow, w bevel.\n203\t    pub c: [f32; 4],\n204\t    /// Up to four sRGB8 cell colours (r in the low byte).\n205\t    pub cells: [u32; 4],\n206\t    /// xyz: unit axis for 1D patterns.\n207\t    pub dir: [f32; 4],\n208\t}\n209\t\n210\t/// One row of the material table (368 bytes), laid out as `Material` in\n211\t/// `shaders/materials.wgsl`. `pav_core::material` packs it; the renderer only uploads it.\n212\t#[repr(C)]\n213\t#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\n214\tpub struct GpuMaterial {\n215\t    /// x layer count, y map (0 object, 1 world, 2 axis), z bit 0: turn.\n216\t    pub head: [u32; 4],\n217\t    /// x roughness (< 0 = the legacy shading), y metallic, z 1/scale.\n218\t    pub pbr: [f32; 4],\n219\t    pub layers: [GpuLayer; 3],\n220\t}\n221\t\n222\timpl GpuMaterial {\n223\t    /// u32 words in a row.\n224\t    pub const WORDS: usize = 92;\n225\t\n226\t    /// A row from its words as packed (`pav_core::material::GpuMaterial::words`).\n227\t    pub fn from_words(words: &[u32; Self::WORDS]) -> Self {\n228\t        bytemuck::pod_read_unaligned(bytemuck::cast_slice(words))\n229\t    }\n230\t}\n231\t\n232\tconst _: () = assert!(std::mem::size_of::<GpuMaterial>() == GpuMaterial::WORDS * 4);\n233\t\n234\t#[derive(Clone, Copy, Debug)]\n235\tpub struct CameraData {\n236\t    pub view: Mat4,\n237\t    pub proj: Mat4,\n238\t    pub eye: Vec3,\n239\t    pub forward: Vec3,\n240\t    pub ortho: bool,\n241\t}\n242\t\n243\timpl Default for CameraData {\n244\t    fn default() -> Self {\n245\t        let eye = Vec3::new(0.0, 10.0, 10.0);\n246\t        let forward = (-eye).normalize();\n247\t        Self {\n248\t            view: glam::camera::rh::view::look_to_mat4(eye, forward, Vec3::Y),\n249\t            proj: glam::camera::rh::proj::directx::perspective(45f32.to_radians(), 16.0 / 9.0, 0.1, 500.0),\n250\t            eye,\n251\t            forward,\n252\t            ortho: false,\n253\t        }\n254\t    }\n255\t}\n256\t\n257\t#[derive(Clone, Copy, Debug)]\n258\tpub struct Sun {\n259\t    /// Direction the light travels (from the sun toward the ground).\n260\t    pub direction: Vec3,\n261\t    /// Linear RGB, already multiplied by intensity.\n262\t    pub color: Vec3,\n263\t    pub shadows: bool,\n264\t    /// Shadows are computed in a square region around this point.\n265\t    pub shadow_center: Vec3,\n266\t    pub shadow_radius: f32,\n267\t}\n268\t\n269\timpl Default for Sun {\n270\t    fn default() -> Self {\n271\t        Self {\n272\t            direction: Vec3::new(-0.35, -1.0, -0.55).normalize(),\n273\t            color: Vec3::new(1.0, 0.95, 0.85) * 0.55,\n274\t            shadows: true,\n275\t            shadow_center: Vec3::ZERO,\n276\t            shadow_radius: 30.0,\n277\t        }\n278\t    }\n279\t}\n280\t\n281\t#[derive(Clone, Copy, Debug)]\n282\tpub struct PointLight {\n283\t    pub position: Vec3,\n284\t    /// Linear RGB times intensity.\n285\t    pub color: Vec3,\n286\t    pub radius: f32,\n287\t    /// Casts shadows (the brightest few such lights get shadow maps).\n288\t    pub shadows: bool,\n289\t}\n290\t\n291\t#[derive(Clone, Copy, Debug)]\n292\tpub struct Ambient {\n293\t    pub sky: Vec3,\n294\t    pub ground: Vec3,\n295\t}\n296\t\n297\timpl Default for Ambient {\n298\t    fn default() -> Self {\n299\t        Self { sky: Vec3::new(0.52, 0.56, 0.66), ground: Vec3::new(0.36, 0.33, 0.30) }\n300\t    }\n301\t}\n302\t\n303\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n304\tpub enum Tonemap {\n305\t    Clamp = 0,\n306\t    /// Identity below 0.8, smooth roll-off above: keeps authored colors exact.\n307\t    SoftKnee = 1,\n308\t    Aces = 2,\n309\t}\n310\t\n311\t#[derive(Clone, Copy, Debug)]\n312\tpub struct StyleSettings {\n313\t    /// Brightness of shadowed areas in the flat style (0..1).\n314\t    pub flat_shadow: f32,\n315\t    /// Number of light bands in the cel style.\n316\t    pub cel_bands: f32,\n317\t    pub rim: f32,\n318\t    pub specular: f32,\n319\t}\n320\t\n321\timpl Default for StyleSettings {\n322\t    fn default() -> Self {\n323\t        Self { flat_shadow: 0.62, cel_bands: 2.0, rim: 0.25, specular: 0.35 }\n324\t    }\n325\t}\n326\t\n327\t#[derive(Clone, Copy, Debug)]\n328\tpub struct PostSettings {\n329\t    pub outlines: bool,\n330\t    /// Outline thickness in pixels.\n331\t    pub outline_px: f32,\n332\t    /// Relative depth jump that counts as an edge.\n333\t    pub outline_depth: f32,\n334\t    /// Normal dot product below which a crease counts as an edge.\n335\t    pub outline_normal: f32,\n336\t    /// Outline = pixel color * darken (when `outline_color` is None).\n337\t    pub outline_darken: f32,\n338\t    pub outline_color: Option<Vec3>,\n339\t    pub exposure: f32,\n340\t    pub tonemap: Tonemap,\n341\t    pub saturation: f32,\n342\t    /// Bloom strength (0 = off) and the HDR brightness where glow starts.\n343\t    pub bloom: f32,\n344\t    pub bloom_threshold: f32,\n345\t    /// Screen distortion (shockwaves, haze) on/off.\n346\t    pub distortion: bool,\n347\t    /// Screen-space global illumination: bounce light and ambient occlusion (0 = off).\n348\t    pub gi: f32,\n349\t    /// Which part of the scene gets outlines.\n350\t    pub outline_part: Part,\n351\t    /// Hazy air (volumetric light): density at the haze's base height (0 = off), the height\n352\t    /// (m) over which it thins out and the base height itself; sunlight scattered toward the\n353\t    /// camera where the sun's shadow map lets it through (light shafts), how strongly that\n354\t    /// light scatters forward (0 = evenly .. 0.9 = mostly toward the sun) and lamp halos (point\n355\t    /// lights glowing in the air, 0 = off).\n356\t    pub haze: f32,\n357\t    pub haze_height: f32,\n358\t    pub haze_base: f32,\n359\t    pub shafts: f32,\n360\t    pub shafts_forward: f32,\n361\t    pub halos: f32,\n362\t}\n363\t\n364\timpl Default for PostSettings {\n365\t    fn default() -> Self {\n366\t        Self {\n367\t            outlines: true,\n368\t            outline_px: 1.0,\n369\t            outline_depth: 0.02,\n370\t            outline_normal: 0.6,\n371\t            outline_darken: 0.35,\n372\t            outline_color: None,\n373\t            exposure: 1.0,\n374\t            tonemap: Tonemap::SoftKnee,\n375\t            saturation: 1.0,\n376\t            bloom: 0.35,\n377\t            bloom_threshold: 1.2,\n378\t            distortion: true,\n379\t            gi: 0.0,\n380\t            outline_part: Part::All,\n381\t            haze: 0.0,\n382\t            haze_height: 4.0,\n383\t            haze_base: 0.0,\n384\t            shafts: 1.0,\n385\t            shafts_forward: 0.5,\n386\t            halos: 0.0,\n387\t        }\n388\t    }\n389\t}\n390\t\n391\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n392\tpub enum DistortKind {\n393\t    /// Shockwave ring pushing outward (`progress` 0..1 = ring radius / fade).\n394\t    Ring = 0,\n395\t    /// Heat haze wobble.\n396\t    Haze = 1,\n397\t    /// Magnifying lens (negative strength shrinks).\n398\t    Lens = 2,\n399\t    /// Rings travelling outward.\n400\t    Ripple = 3,\n401\t}\n402\t\n403\t/// A screen distortion source, drawn as a camera-facing disc.\n404\t#[derive(Clone, Copy, Debug)]\n405\tpub struct Distortion {\n406\t    pub pos: Vec3,\n407\t    pub radius: f32,\n408\t    /// Offset as a fraction of the disc's screen radius (0.05-0.3 typical).\n409\t    pub strength: f32,\n410\t    pub kind: DistortKind,\n411\t    pub progress: f32,\n412\t}\n413\t\n414\t/// New particles to emit this frame (they live on the GPU afterwards).\n415\t#[derive(Clone, Copy, Debug)]\n416\tpub struct ParticleBurst {\n417\t    pub count: u32,\n418\t    pub pos: Vec3,\n419\t    /// Spawn inside this box (half extents) around `pos`.\n420\t    pub area: Vec3,\n421\t    pub vel: Vec3,\n422\t    /// Random extra speed in any direction (m/s).\n423\t    pub spread: f32,\n424\t    pub gravity: f32,\n425\t    pub drag: f32,\n426\t    /// Life range (s).\n427\t    pub life: (f32, f32),\n428\t    /// Size at birth and at death (m, radius).\n429\t    pub size: (f32, f32),\n430\t    /// Linear RGB (may exceed 1 for glow) + alpha, at birth and at death.\n431\t    pub color0: glam::Vec4,\n432\t    pub color1: glam::Vec4,\n433\t    /// Adds light instead of covering (fire, sparks, magic).\n434\t    pub additive: bool,\n435\t    /// Streaks along the velocity (sparks, rain).\n436\t    pub stretch: bool,\n437\t    /// Bounce off this height (None = fall forever).\n438\t    pub floor: Option<f32>,\n439\t    pub bounce: f32,\n440\t    /// Swirling noise strength (smoke, fireflies).\n441\t    pub turbulence: f32,\n442\t    /// Born as if emitted over the last `prewarm` seconds (spread-out ages), so a new\n443\t    /// emitter starts in full swing.\n444\t    pub prewarm: f32,\n445\t}\n446\t\n447\timpl Default for ParticleBurst {\n448\t    fn default() -> Self {\n449\t        Self {\n450\t            count: 0,\n451\t            pos: Vec3::ZERO,\n452\t            area: Vec3::ZERO,\n453\t            vel: Vec3::ZERO,\n454\t            spread: 1.0,\n455\t            gravity: 0.0,\n456\t            drag: 0.0,\n457\t            life: (1.0, 1.5),\n458\t            size: (0.1, 0.0),\n459\t            color0: glam::Vec4::ONE,\n460\t            color1: glam::Vec4::new(1.0, 1.0, 1.0, 0.0),\n461\t            additive: true,\n462\t            stretch: false,\n463\t            floor: None,\n464\t            bounce: 0.3,\n465\t            turbulence: 0.0,\n466\t            prewarm: 0.0,\n467\t        }\n468\t    }\n469\t}\n470\t\n471\t/// Screen filters applied after tonemapping (retro looks and grading).\n472\t#[derive(Clone, Copy, Debug)]\n473\tpub struct FilterSettings {\n474\t    /// Pixel block size (1 = off).\n475\t    pub pixelate: f32,\n476\t    /// CRT tube curvature (0 = flat).\n477\t    pub curvature: f32,\n478\t    /// Scanline darkness (0 = off) and period in pixels.\n479\t    pub scanlines: f32,\n480\t    pub scanline_px: f32,\n481\t    /// Ordered dithering amount, colour levels per channel (< 2 = off), palette (0 = none,\n482\t    /// 1 Game Boy, 2 PICO-8, 3 CGA, 4 1-bit, 5 amber).\n483\t    pub dither: f32,\n484\t    pub levels: f32,\n485\t    pub palette: u32,\n486\t    /// Filters only right of this screen fraction (0 = whole screen): side-by-side comparisons.\n487\t    pub split: f32,\n488\t    pub temperature: f32,\n489\t    pub tint: f32,\n490\t    pub contrast: f32,\n491\t    pub brightness: f32,\n492\t    pub vignette: f32,\n493\t    pub grain: f32,\n494\t    /// Chromatic aberration.\n495\t    pub chroma: f32,\n496\t    /// Saturation of the filtered side (1 = unchanged, 0 = grey).\n497\t    pub saturation: f32,\n498\t    /// Pixel-art block size for objects with `flags::PIXEL` (1 = off), their colour levels\n499\t    /// per channel (below 2 = unchanged) and a dark one-block outline around them.\n500\t    pub pixel_art: f32,\n501\t    pub pixel_levels: f32,\n502\t    pub pixel_outline: bool,\n503\t    /// The part of the scene each filter applies to: colour reduction (palette, levels,\n504\t    /// dither), grading (temperature, tint, contrast, brightness, saturation), scanlines,\n505\t    /// grain and chromatic aberration. Curvature, vignette and `pixelate` are whole-screen.\n506\t    pub color_part: Part,\n507\t    pub grade_part: Part,\n508\t    pub scanline_part: Part,\n509\t    pub grain_part: Part,\n510\t    pub chroma_part: Part,\n511\t    /// A painterly or print look over the picture, its size in pixels (brush radius, dot\n512\t    /// cell, character width, hatching spacing), how much of it shows (0..1), how much of the\n513\t    /// scene's colour it keeps (0 = ink only, 1 = full colour) and the part it applies to.\n514\t    pub stylize: Stylize,\n515\t    pub stylize_size: f32,\n516\t    pub stylize_mix: f32,\n517\t    pub stylize_color: f32,\n518\t    pub stylize_part: Part,\n519\t    /// Screen transition: how covered the screen is (0 = clear, 1 = covered), its kind and\n520\t    /// its centre (screen fraction, 0..1 from the top left; the iris closes on it).\n521\t    pub transition: f32,\n522\t    pub transition_kind: Transition,\n523\t    pub transition_center: glam::Vec2,\n524\t}\n525\t\n526\timpl Default for FilterSettings {\n527\t    fn default() -> Self {\n528\t        Self {\n529\t            pixelate: 1.0,\n530\t            curvature: 0.0,\n531\t            scanlines: 0.0,\n532\t            scanline_px: 3.0,\n533\t            dither: 0.0,\n534\t            levels: 0.0,\n535\t            palette: 0,\n536\t            split: 0.0,\n537\t            temperature: 0.0,\n538\t            tint: 0.0,\n539\t            contrast: 1.0,\n540\t            brightness: 1.0,\n541\t            vignette: 0.0,\n542\t            grain: 0.0,\n543\t            chroma: 0.0,\n544\t            saturation: 1.0,\n545\t            pixel_art: 1.0,\n546\t            pixel_levels: 0.0,\n547\t            pixel_outline: true,\n548\t            color_part: Part::All,\n549\t            grade_part: Part::All,\n550\t            scanline_part: Part::All,\n551\t            grain_part: Part::All,\n552\t            chroma_part: Part::All,\n553\t            stylize: Stylize::Off,\n554\t            stylize_size: 4.0,\n555\t            stylize_mix: 1.0,\n556\t            stylize_color: 1.0,\n557\t            stylize_part: Part::All,\n558\t            transition: 0.0,\n559\t            transition_kind: Transition::Fade,\n560\t            transition_center: glam::Vec2::splat(0.5),\n561\t        }\n562\t    }\n563\t}\n564\t\n565\t/// Distance fog around a centre point (usually the camera target), blending into `color`.\n566\t#[derive(Clone, Copy, Debug)]\n567\tpub struct Fog {\n568\t    pub enabled: bool,\n569\t    pub center: Vec3,\n570\t    /// Horizontal distance where fog starts / is complete (m).\n571\t    pub start: f32,\n572\t    pub end: f32,\n573\t    /// Linear RGB (usually the sky colour).\n574\t    pub color: Vec3,\n575\t}\n576\t\n577\timpl Default for Fog {\n578\t    fn default() -> Self {\n579\t        Self { enabled: false, center: Vec3::ZERO, start: 60.0, end: 90.0, color: Vec3::ONE }\n580\t    }\n581\t}\n582\t\n583\t/// Camera helpers that remove geometry hiding the player.\n584\t#[derive(Clone, Copy, Debug, Default)]\n585\tpub struct Cutaway {\n586\t    /// Point of interest (usually the player's head).\n587\t    pub focus: Vec3,\n588\t    /// Remove geometry above `cut_height` within `cut_radius` (horizontal) of the focus.\n589\t    pub height_cut: bool,\n590\t    pub cut_height: f32,\n591\t    pub cut_radius: f32,\n592\t    /// Dither out geometry between the camera and the focus.\n593\t    pub fade: bool,\n594\t    pub fade_radius: f32,\n595\t    /// Remove everything closer to the camera than this distance in front of the focus\n596\t    /// (side views, where walls between camera and player hide everything). 0 = off.\n597\t    pub front_cut: f32,\n598\t}\n599\t\n600\t#[derive(Clone, Debug)]\n601\tpub struct Scene {\n602\t    pub camera: CameraData,\n603\t    pub sun: Sun,\n604\t    pub ambient: Ambient,\n605\t    pub point_lights: Vec<PointLight>,\n606\t    pub meshes: Vec<MeshInstance>,\n607\t    pub sdfs: Vec<SdfInstance>,\n608\t    /// Linear RGB.\n609\t    pub clear_color: Vec3,\n610\t    pub style: StyleSettings,\n611\t    pub post: PostSettings,\n612\t    pub filter: FilterSettings,\n613\t    pub cutaway: Cutaway,\n614\t    pub fog: Fog,\n615\t    /// Data for every `MeshKey::Custom` referenced this frame (uploaded when missing).\n616\t    pub custom_meshes: Vec<(MeshKey, std::sync::Arc<crate::mesh::MeshData>)>,\n617\t    /// Text in the world.\n618\t    pub texts: Vec<crate::text::Text3d>,\n619\t    /// Meshes rebuilt every frame (soft bodies).\n620\t    pub dynamic: Vec<DynamicMesh>,\n621\t    /// Particles born this frame.\n622\t    pub particles: Vec<ParticleBurst>,\n623\t    pub distortions: Vec<Distortion>,\n624\t    pub wind: Wind,\n625\t    pub time: f32,\n626\t    /// The procedural material table: row 0 is none (instances with material 0 draw exactly\n627\t    /// as before materials existed). Uploaded when `materials_version` changes, so keep the\n628\t    /// same `Arc` and version while the rows are unchanged.\n629\t    pub materials: std::sync::Arc<Vec<GpuMaterial>>,\n630\t    pub materials_version: u64,\n631\t}\n632\t\n633\timpl Default for Scene {\n634\t    fn default() -> Self {\n635\t        Self {\n636\t            camera: CameraData::default(),\n637\t            sun: Sun::default(),\n638\t            ambient: Ambient::default(),\n639\t            point_lights: Vec::new(),\n640\t            meshes: Vec::new(),\n641\t            sdfs: Vec::new(),\n642\t            clear_color: srgb(0x8f, 0xb8, 0xd8),\n643\t            style: StyleSettings::default(),\n644\t            post: PostSettings::default(),\n645\t            filter: FilterSettings::default(),\n646\t            cutaway: Cutaway::default(),\n647\t            fog: Fog::default(),\n648\t            custom_meshes: Vec::new(),\n649\t            texts: Vec::new(),\n650\t            dynamic: Vec::new(),\n651\t            particles: Vec::new(),\n652\t            distortions: Vec::new(),\n653\t            wind: Wind::default(),\n654\t            time: 0.0,\n655\t            materials: std::sync::Arc::default(),\n656\t            materials_version: 0,\n657\t        }\n658\t    }\n659\t}\n660\t\n661\t/// Converts an 8-bit sRGB color to linear RGB.\n662\tpub fn srgb(r: u8, g: u8, b: u8) -> Vec3 {\n663\t    Vec3::new(srgb_to_linear(r as f32 / 255.0), srgb_to_linear(g as f32 / 255.0), srgb_to_linear(b as f32 / 255.0))\n664\t}\n665\t\n666\t/// Parses \"#rrggbb\" (or \"rrggbb\") into linear RGB.\n667\tpub fn hex(s: &str) -> Option<Vec3> {\n668\t    let s = s.trim_start_matches('#');\n669\t    if s.len() != 6 {\n670\t        return None;\n671\t    }\n672\t    let v = u32::from_str_radix(s, 16).ok()?;\n673\t    Some(srgb((v >> 16) as u8, (v >> 8) as u8, v as u8))\n674\t}\n675\t\n676\tpub fn srgb_to_linear(c: f32) -> f32 {\n677\t    if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) }\n678\t}\n679\t\n680\tpub fn linear_to_srgb(c: f32) -> f32 {\n681\t    if c <= 0.0031308 { c * 12.92 } else { 1.055 * c.powf(1.0 / 2.4) - 0.055 }\n682\t}\n683\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"775cd486-49b0-4959-9f91-ae2a9c955838","timestamp":"2026-11-05T13:32:10.290Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_render/src/scene.rs","content":"//! Plain-data description of one frame. The renderer knows nothing about the simulation;\n//! a view layer turns game state into a `Scene` every frame.\n\nuse glam::{Mat4, Vec3};\n\npub use crate::mesh::MeshKey;\n\n/// Surface style, per object.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Style {\n    /// Albedo only (plus cast shadows as a darker tone): the clean 2D look.\n    Flat = 0,\n    /// Toon bands, rim light.\n    #[default]\n    Cel = 1,\n    /// Smooth lighting with specular.\n    Lit = 2,\n    /// Pure albedo, ignores all lighting and shadows (UI-like markers, emissive signs).\n    Unlit = 3,\n}\n\nimpl Style {\n    pub const ALL: [Style; 4] = [Style::Flat, Style::Cel, Style::Lit, Style::Unlit];\n    pub fn name(self) -> &'static str {\n        match self {\n            Style::Flat => \"flat\",\n            Style::Cel => \"cel\",\n            Style::Lit => \"lit\",\n            Style::Unlit => \"unlit\",\n        }\n    }\n}\n\npub mod flags {\n    /// Never removed by cutaway or occlusion fade (the player, markers).\n    pub const NO_CUT: u32 = 1;\n    /// Does not cast shadows.\n    pub const NO_SHADOW: u32 = 2;\n    /// Does not receive shadows.\n    pub const NO_RECEIVE_SHADOW: u32 = 4;\n    /// Cutaway lowers individual vertices near the player (for big meshes like terrain).\n    pub const CUT_VERTEX: u32 = 8;\n    /// Both sides are real surfaces (cloth), not the inside of a solid.\n    pub const TWO_SIDED: u32 = 16;\n    /// Drawn as pixel art (in blocks of `FilterSettings::pixel_art` pixels) when that is\n    /// above 1; the rest of the screen stays sharp.\n    pub const PIXEL: u32 = 32;\n    /// Part of the characters and objects (not the environment): filters aimed at one part\n    /// of the scene (`Part`) tell the two apart by this flag.\n    pub const OBJECT: u32 = 64;\n    /// Sways in the wind like leaves (canopies, bushes, banners): vertices move more the\n    /// higher they are above the bottom of the instance.\n    pub const SWAY: u32 = 128;\n    /// Bends like grass: far in gusts, and away from the wind's pusher (the player).\n    pub const GRASS: u32 = 256;\n}\n\n/// Wind for swaying foliage and grass (vertex shader).\n#[derive(Clone, Copy, Debug, Default)]\npub struct Wind {\n    /// Horizontal direction the wind blows toward (x, z).\n    pub direction: glam::Vec2,\n    /// 0 = still air.\n    pub strength: f32,\n    /// How quickly gusts roll across (1 = normal).\n    pub gusts: f32,\n    /// Grass bends away from this point (the player's feet) within `push_radius` (0 = off).\n    pub pusher: Vec3,\n    pub push_radius: f32,\n}\n\n/// Which part of the scene a filter applies to.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Part {\n    /// Everything on screen.\n    #[default]\n    All = 0,\n    /// Instances flagged `flags::OBJECT` (characters, props, loot, projectiles, effects).\n    Objects = 1,\n    /// Everything else: level geometry, fixed scenery and the sky.\n    Environment = 2,\n}\n\n/// Painterly and print looks redrawn from the finished picture.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Stylize {\n    #[default]\n    Off = 0,\n    /// Oil paint: a generalized Kuwahara filter (flat strokes that keep their edges) on canvas.\n    Paint = 1,\n    /// Print: rotated dot screens (CMYK comics, or black dots for newsprint).\n    Halftone = 2,\n    /// Text mode: each cell becomes a character picked by its brightness.\n    Ascii = 3,\n    /// Pencil on paper: hatching that thickens with darkness, plus contour lines.\n    Sketch = 4,\n}\n\n/// How a screen transition covers the picture.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Transition {\n    #[default]\n    Fade = 0,\n    /// A circle closing on `transition_center`.\n    Iris = 1,\n    /// Diamonds growing in a wave across the screen.\n    Diamonds = 2,\n    /// Random blocks.\n    Dissolve = 3,\n    /// Pixels growing into big blocks, then black.\n    Mosaic = 4,\n    /// Horizontal blinds.\n    Blinds = 5,\n}\n\n/// A mesh rebuilt every frame (soft bodies), in world space.\n#[derive(Clone, Debug)]\npub struct DynamicMesh {\n    pub data: crate::mesh::MeshData,\n    pub color: Vec3,\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    pub group: u32,\n    /// Procedural material: `slot | seed << 12` (see `MeshInstance::material`; its local\n    /// frame is the world's).\n    pub material: u32,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct MeshInstance {\n    pub mesh: MeshKey,\n    pub transform: Mat4,\n    /// Linear RGB albedo.\n    pub color: Vec3,\n    /// Emissive strength (0 = none). Adds `color * emissive` on top of lighting.\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    /// Outline group: edges are drawn where the group changes. 0 = background, use 1 for\n    /// static level geometry and unique ids for objects.\n    pub group: u32,\n    /// Procedural material: a row of `Scene::materials` in bits 0-11 (0 = none, the plain\n    /// colour) and a per-instance seed in bits 12-31 (`material_param`). `color` and\n    /// `emissive` are the material's base colour and glow, so one row serves every tint.\n    pub material: u32,\n    /// Half extents of the part in its own frame, for the material's axis map and gradients.\n    /// ZERO derives them from the transform's columns (meshes that fill the unit cube);\n    /// meshes built at their real size, like rounded boxes, set them.\n    pub ext: Vec3,\n}\n\n/// Analytic SDF primitive, ray-traced per pixel: a rounded cone between `a` and `b` with\n/// radii `ra`/`rb`. Equal radii give a capsule; `a == b` gives a sphere.\n#[derive(Clone, Copy, Debug)]\npub struct SdfInstance {\n    pub a: Vec3,\n    pub b: Vec3,\n    pub ra: f32,\n    pub rb: f32,\n    pub color: Vec3,\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    pub group: u32,\n    /// Procedural material, as `MeshInstance::material`; the local frame runs along a→b.\n    pub material: u32,\n}\n\nimpl SdfInstance {\n    pub fn sphere(center: Vec3, r: f32, color: Vec3) -> Self {\n        Self { a: center, b: center, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n    }\n    pub fn capsule(a: Vec3, b: Vec3, r: f32, color: Vec3) -> Self {\n        Self { a, b, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n    }\n}\n\n/// Material slots per scene (bits 0-11 of an instance's `material`; slot 0 is none).\npub const MATERIAL_SLOTS: u32 = 4096;\n\n/// An instance's `material` word: the table row `slot` and a per-instance `seed` (20 bits).\npub fn material_param(slot: u32, seed: u32) -> u32 {\n    (slot & (MATERIAL_SLOTS - 1)) | (seed & 0xfffff) << 12\n}\n\n/// One pattern layer of a material row, laid out as `MatLayer` in `shaders/materials.wgsl`.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\npub struct GpuLayer {\n    /// x: kernel | variant<<8 | axis<<12 | facing<<16 | mask<<20 | paint<<24 | ncells<<28;\n    /// y: salt.\n    pub head: [u32; 4],\n    /// rgb linear colour (paint 0) or r the linear shade factor (paint 1); a strength.\n    pub paint: [f32; 4],\n    pub a: [f32; 4],\n    pub b: [f32; 4],\n    /// x vary, y cavity, z glow, w bevel.\n    pub c: [f32; 4],\n    /// Up to four sRGB8 cell colours (r in the low byte).\n    pub cells: [u32; 4],\n    /// xyz: unit axis for 1D patterns.\n    pub dir: [f32; 4],\n}\n\n/// One row of the material table (368 bytes), laid out as `Material` in\n/// `shaders/materials.wgsl`. `pav_core::material` packs it; the renderer only uploads it.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\npub struct GpuMaterial {\n    /// x layer count, y map (0 object, 1 world, 2 axis), z bit 0: turn.\n    pub head: [u32; 4],\n    /// x roughness (< 0 = the legacy shading), y metallic, z 1/scale.\n    pub pbr: [f32; 4],\n    pub layers: [GpuLayer; 3],\n}\n\nimpl GpuMaterial {\n    /// u32 words in a row.\n    pub const WORDS: usize = 92;\n\n    /// A row from its words as packed (`pav_core::material::GpuMaterial::words`).\n    pub fn from_words(words: &[u32; Self::WORDS]) -> Self {\n        bytemuck::pod_read_unaligned(bytemuck::cast_slice(words))\n    }\n}\n\nconst _: () = assert!(std::mem::size_of::<GpuMaterial>() == GpuMaterial::WORDS * 4);\n\n#[derive(Clone, Copy, Debug)]\npub struct CameraData {\n    pub view: Mat4,\n    pub proj: Mat4,\n    pub eye: Vec3,\n    pub forward: Vec3,\n    pub ortho: bool,\n}\n\nimpl Default for CameraData {\n    fn default() -> Self {\n        let eye = Vec3::new(0.0, 10.0, 10.0);\n        let forward = (-eye).normalize();\n        Self {\n            view: glam::camera::rh::view::look_to_mat4(eye, forward, Vec3::Y),\n            proj: glam::camera::rh::proj::directx::perspective(45f32.to_radians(), 16.0 / 9.0, 0.1, 500.0),\n            eye,\n            forward,\n            ortho: false,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Sun {\n    /// Direction the light travels (from the sun toward the ground).\n    pub direction: Vec3,\n    /// Linear RGB, already multiplied by intensity.\n    pub color: Vec3,\n    pub shadows: bool,\n    /// Shadows are computed in a square region around this point.\n    pub shadow_center: Vec3,\n    pub shadow_radius: f32,\n}\n\nimpl Default for Sun {\n    fn default() -> Self {\n        Self {\n            direction: Vec3::new(-0.35, -1.0, -0.55).normalize(),\n            color: Vec3::new(1.0, 0.95, 0.85) * 0.55,\n            shadows: true,\n            shadow_center: Vec3::ZERO,\n            shadow_radius: 30.0,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct PointLight {\n    pub position: Vec3,\n    /// Linear RGB times intensity.\n    pub color: Vec3,\n    pub radius: f32,\n    /// Casts shadows (the brightest few such lights get shadow maps).\n    pub shadows: bool,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Ambient {\n    pub sky: Vec3,\n    pub ground: Vec3,\n}\n\nimpl Default for Ambient {\n    fn default() -> Self {\n        Self { sky: Vec3::new(0.52, 0.56, 0.66), ground: Vec3::new(0.36, 0.33, 0.30) }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Tonemap {\n    Clamp = 0,\n    /// Identity below 0.8, smooth roll-off above: keeps authored colors exact.\n    SoftKnee = 1,\n    Aces = 2,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct StyleSettings {\n    /// Brightness of shadowed areas in the flat style (0..1).\n    pub flat_shadow: f32,\n    /// Number of light bands in the cel style.\n    pub cel_bands: f32,\n    pub rim: f32,\n    pub specular: f32,\n}\n\nimpl Default for StyleSettings {\n    fn default() -> Self {\n        Self { flat_shadow: 0.62, cel_bands: 2.0, rim: 0.25, specular: 0.35 }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct PostSettings {\n    pub outlines: bool,\n    /// Outline thickness in pixels.\n    pub outline_px: f32,\n    /// Relative depth jump that counts as an edge.\n    pub outline_depth: f32,\n    /// Normal dot product below which a crease counts as an edge.\n    pub outline_normal: f32,\n    /// Outline = pixel color * darken (when `outline_color` is None).\n    pub outline_darken: f32,\n    pub outline_color: Option<Vec3>,\n    pub exposure: f32,\n    pub tonemap: Tonemap,\n    pub saturation: f32,\n    /// Bloom strength (0 = off) and the HDR brightness where glow starts.\n    pub bloom: f32,\n    pub bloom_threshold: f32,\n    /// Screen distortion (shockwaves, haze) on/off.\n    pub distortion: bool,\n    /// Screen-space global illumination: bounce light and ambient occlusion (0 = off).\n    pub gi: f32,\n    /// Which part of the scene gets outlines.\n    pub outline_part: Part,\n    /// Hazy air (volumetric light): density at the haze's base height (0 = off), the height\n    /// (m) over which it thins out and the base height itself; sunlight scattered toward the\n    /// camera where the sun's shadow map lets it through (light shafts), how strongly that\n    /// light scatters forward (0 = evenly .. 0.9 = mostly toward the sun) and lamp halos (point\n    /// lights glowing in the air, 0 = off).\n    pub haze: f32,\n    pub haze_height: f32,\n    pub haze_base: f32,\n    pub shafts: f32,\n    pub shafts_forward: f32,\n    pub halos: f32,\n}\n\nimpl Default for PostSettings {\n    fn default() -> Self {\n        Self {\n            outlines: true,\n            outline_px: 1.0,\n            outline_depth: 0.02,\n            outline_normal: 0.6,\n            outline_darken: 0.35,\n            outline_color: None,\n            exposure: 1.0,\n            tonemap: Tonemap::SoftKnee,\n            saturation: 1.0,\n            bloom: 0.35,\n            bloom_threshold: 1.2,\n            distortion: true,\n            gi: 0.0,\n            outline_part: Part::All,\n            haze: 0.0,\n            haze_height: 4.0,\n            haze_base: 0.0,\n            shafts: 1.0,\n            shafts_forward: 0.5,\n            halos: 0.0,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DistortKind {\n    /// Shockwave ring pushing outward (`progress` 0..1 = ring radius / fade).\n    Ring = 0,\n    /// Heat haze wobble.\n    Haze = 1,\n    /// Magnifying lens (negative strength shrinks).\n    Lens = 2,\n    /// Rings travelling outward.\n    Ripple = 3,\n}\n\n/// A screen distortion source, drawn as a camera-facing disc.\n#[derive(Clone, Copy, Debug)]\npub struct Distortion {\n    pub pos: Vec3,\n    pub radius: f32,\n    /// Offset as a fraction of the disc's screen radius (0.05-0.3 typical).\n    pub strength: f32,\n    pub kind: DistortKind,\n    pub progress: f32,\n}\n\n/// New particles to emit this frame (they live on the GPU afterwards).\n#[derive(Clone, Copy, Debug)]\npub struct ParticleBurst {\n    pub count: u32,\n    pub pos: Vec3,\n    /// Spawn inside this box (half extents) around `pos`.\n    pub area: Vec3,\n    pub vel: Vec3,\n    /// Random extra speed in any direction (m/s).\n    pub spread: f32,\n    pub gravity: f32,\n    pub drag: f32,\n    /// Life range (s).\n    pub life: (f32, f32),\n    /// Size at birth and at death (m, radius).\n    pub size: (f32, f32),\n    /// Linear RGB (may exceed 1 for glow) + alpha, at birth and at death.\n    pub color0: glam::Vec4,\n    pub color1: glam::Vec4,\n    /// Adds light instead of covering (fire, sparks, magic).\n    pub additive: bool,\n    /// Streaks along the velocity (sparks, rain).\n    pub stretch: bool,\n    /// Bounce off this height (None = fall forever).\n    pub floor: Option<f32>,\n    pub bounce: f32,\n    /// Swirling noise strength (smoke, fireflies).\n    pub turbulence: f32,\n    /// Born as if emitted over the last `prewarm` seconds (spread-out ages), so a new\n    /// emitter starts in full swing.\n    pub prewarm: f32,\n}\n\nimpl Default for ParticleBurst {\n    fn default() -> Self {\n        Self {\n            count: 0,\n            pos: Vec3::ZERO,\n            area: Vec3::ZERO,\n            vel: Vec3::ZERO,\n            spread: 1.0,\n            gravity: 0.0,\n            drag: 0.0,\n            life: (1.0, 1.5),\n            size: (0.1, 0.0),\n            color0: glam::Vec4::ONE,\n            color1: glam::Vec4::new(1.0, 1.0, 1.0, 0.0),\n            additive: true,\n            stretch: false,\n            floor: None,\n            bounce: 0.3,\n            turbulence: 0.0,\n            prewarm: 0.0,\n        }\n    }\n}\n\n/// Screen filters applied after tonemapping (retro looks and grading).\n#[derive(Clone, Copy, Debug)]\npub struct FilterSettings {\n    /// Pixel block size (1 = off).\n    pub pixelate: f32,\n    /// CRT tube curvature (0 = flat).\n    pub curvature: f32,\n    /// Scanline darkness (0 = off) and period in pixels.\n    pub scanlines: f32,\n    pub scanline_px: f32,\n    /// Ordered dithering amount, colour levels per channel (< 2 = off), palette (0 = none,\n    /// 1 Game Boy, 2 PICO-8, 3 CGA, 4 1-bit, 5 amber).\n    pub dither: f32,\n    pub levels: f32,\n    pub palette: u32,\n    /// Filters only right of this screen fraction (0 = whole screen): side-by-side comparisons.\n    pub split: f32,\n    pub temperature: f32,\n    pub tint: f32,\n    pub contrast: f32,\n    pub brightness: f32,\n    pub vignette: f32,\n    pub grain: f32,\n    /// Chromatic aberration.\n    pub chroma: f32,\n    /// Saturation of the filtered side (1 = unchanged, 0 = grey).\n    pub saturation: f32,\n    /// Pixel-art block size for objects with `flags::PIXEL` (1 = off), their colour levels\n    /// per channel (below 2 = unchanged) and a dark one-block outline around them.\n    pub pixel_art: f32,\n    pub pixel_levels: f32,\n    pub pixel_outline: bool,\n    /// The part of the scene each filter applies to: colour reduction (palette, levels,\n    /// dither), grading (temperature, tint, contrast, brightness, saturation), scanlines,\n    /// grain and chromatic aberration. Curvature, vignette and `pixelate` are whole-screen.\n    pub color_part: Part,\n    pub grade_part: Part,\n    pub scanline_part: Part,\n    pub grain_part: Part,\n    pub chroma_part: Part,\n    /// A painterly or print look over the picture, its size in pixels (brush radius, dot\n    /// cell, character width, hatching spacing), how much of it shows (0..1), how much of the\n    /// scene's colour it keeps (0 = ink only, 1 = full colour) and the part it applies to.\n    pub stylize: Stylize,\n    pub stylize_size: f32,\n    pub stylize_mix: f32,\n    pub stylize_color: f32,\n    pub stylize_part: Part,\n    /// Screen transition: how covered the screen is (0 = clear, 1 = covered), its kind and\n    /// its centre (screen fraction, 0..1 from the top left; the iris closes on it).\n    pub transition: f32,\n    pub transition_kind: Transition,\n    pub transition_center: glam::Vec2,\n}\n\nimpl Default for FilterSettings {\n    fn default() -> Self {\n        Self {\n            pixelate: 1.0,\n            curvature: 0.0,\n            scanlines: 0.0,\n            scanline_px: 3.0,\n            dither: 0.0,\n            levels: 0.0,\n            palette: 0,\n            split: 0.0,\n            temperature: 0.0,\n            tint: 0.0,\n            contrast: 1.0,\n            brightness: 1.0,\n            vignette: 0.0,\n            grain: 0.0,\n            chroma: 0.0,\n            saturation: 1.0,\n            pixel_art: 1.0,\n            pixel_levels: 0.0,\n            pixel_outline: true,\n            color_part: Part::All,\n            grade_part: Part::All,\n            scanline_part: Part::All,\n            grain_part: Part::All,\n            chroma_part: Part::All,\n            stylize: Stylize::Off,\n            stylize_size: 4.0,\n            stylize_mix: 1.0,\n            stylize_color: 1.0,\n            stylize_part: Part::All,\n            transition: 0.0,\n            transition_kind: Transition::Fade,\n            transition_center: glam::Vec2::splat(0.5),\n        }\n    }\n}\n\n/// Distance fog around a centre point (usually the camera target), blending into `color`.\n#[derive(Clone, Copy, Debug)]\npub struct Fog {\n    pub enabled: bool,\n    pub center: Vec3,\n    /// Horizontal distance where fog starts / is complete (m).\n    pub start: f32,\n    pub end: f32,\n    /// Linear RGB (usually the sky colour).\n    pub color: Vec3,\n}\n\nimpl Default for Fog {\n    fn default() -> Self {\n        Self { enabled: false, center: Vec3::ZERO, start: 60.0, end: 90.0, color: Vec3::ONE }\n    }\n}\n\n/// Camera helpers that remove geometry hiding the player.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Cutaway {\n    /// Point of interest (usually the player's head).\n    pub focus: Vec3,\n    /// Remove geometry above `cut_height` within `cut_radius` (horizontal) of the focus.\n    pub height_cut: bool,\n    pub cut_height: f32,\n    pub cut_radius: f32,\n    /// Dither out geometry between the camera and the focus.\n    pub fade: bool,\n    pub fade_radius: f32,\n    /// Remove everything closer to the camera than this distance in front of the focus\n    /// (side views, where walls between camera and player hide everything). 0 = off.\n    pub front_cut: f32,\n}\n\n#[derive(Clone, Debug)]\npub struct Scene {\n    pub camera: CameraData,\n    pub sun: Sun,\n    pub ambient: Ambient,\n    pub point_lights: Vec<PointLight>,\n    pub meshes: Vec<MeshInstance>,\n    pub sdfs: Vec<SdfInstance>,\n    /// Linear RGB.\n    pub clear_color: Vec3,\n    pub style: StyleSettings,\n    pub post: PostSettings,\n    pub filter: FilterSettings,\n    pub cutaway: Cutaway,\n    pub fog: Fog,\n    /// Data for every `MeshKey::Custom` referenced this frame (uploaded when missing).\n    pub custom_meshes: Vec<(MeshKey, std::sync::Arc<crate::mesh::MeshData>)>,\n    /// Text in the world.\n    pub texts: Vec<crate::text::Text3d>,\n    /// Meshes rebuilt every frame (soft bodies).\n    pub dynamic: Vec<DynamicMesh>,\n    /// Particles born this frame.\n    pub particles: Vec<ParticleBurst>,\n    pub distortions: Vec<Distortion>,\n    pub wind: Wind,\n    pub time: f32,\n    /// The procedural material table: row 0 is none (instances with material 0 draw exactly\n    /// as before materials existed). Uploaded when `materials_version` changes, so keep the\n    /// same `Arc` and version while the rows are unchanged.\n    pub materials: std::sync::Arc<Vec<GpuMaterial>>,\n    pub materials_version: u64,\n}\n\nimpl Default for Scene {\n    fn default() -> Self {\n        Self {\n            camera: CameraData::default(),\n            sun: Sun::default(),\n            ambient: Ambient::default(),\n            point_lights: Vec::new(),\n            meshes: Vec::new(),\n            sdfs: Vec::new(),\n            clear_color: srgb(0x8f, 0xb8, 0xd8),\n            style: StyleSettings::default(),\n            post: PostSettings::default(),\n            filter: FilterSettings::default(),\n            cutaway: Cutaway::default(),\n            fog: Fog::default(),\n            custom_meshes: Vec::new(),\n            texts: Vec::new(),\n            dynamic: Vec::new(),\n            particles: Vec::new(),\n            distortions: Vec::new(),\n            wind: Wind::default(),\n            time: 0.0,\n            materials: std::sync::Arc::default(),\n            materials_version: 0,\n        }\n    }\n}\n\n/// Converts an 8-bit sRGB color to linear RGB.\npub fn srgb(r: u8, g: u8, b: u8) -> Vec3 {\n    Vec3::new(srgb_to_linear(r as f32 / 255.0), srgb_to_linear(g as f32 / 255.0), srgb_to_linear(b as f32 / 255.0))\n}\n\n/// Parses \"#rrggbb\" (or \"rrggbb\") into linear RGB.\npub fn hex(s: &str) -> Option<Vec3> {\n    let s = s.trim_start_matches('#');\n    if s.len() != 6 {\n        return None;\n    }\n    let v = u32::from_str_radix(s, 16).ok()?;\n    Some(srgb((v >> 16) as u8, (v >> 8) as u8, v as u8))\n}\n\npub fn srgb_to_linear(c: f32) -> f32 {\n    if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) }\n}\n\npub fn linear_to_srgb(c: f32) -> f32 {\n    if c <= 0.0031308 { c * 12.92 } else { 1.055 * c.powf(1.0 / 2.4) - 0.055 }\n}\n","numLines":683,"startLine":1,"totalLines":683}},"tool_result_meta":[{"id":"toolu_018Put4pYy6sDWdBBxpdoqZ8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjs7qZEzhuqAyuw9QDiY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QVd5CDnXUh8MpAx6zqwsYM","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_view/src/camera.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":61799,"cache_read_input_tokens":125378,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":61799},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"fc99bc18-b5b3-4780-a9a3-167173d73a73","timestamp":"2026-11-05T13:32:12.470Z","request_id":"req_011Cgjs7qFPvKpx1kG7uojrK","wire_tool_inputs":{"toolu_01QVd5CDnXUh8MpAx6zqwsYM":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_view/src/camera.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QVd5CDnXUh8MpAx6zqwsYM","type":"tool_result","content":"1\t//! The camera rig: every parameter is live. \"2D top-down\" is just tilt 90 + orthographic.\n2\t\n3\tuse glam::{Mat4, Vec2, Vec3};\n4\tuse pav_core::params::{ParamVisitor, Tunable};\n5\tuse pav_render::CameraData;\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n9\t#[serde(default)]\n10\tpub struct CameraParams {\n11\t    /// Degrees above the horizon: 90 = straight down, 0 = side view.\n12\t    pub tilt: f32,\n13\t    /// Degrees; 0 = looking north (-Z).\n14\t    pub yaw: f32,\n15\t    /// Distance from the focus point (metres). In orthographic mode it sets the zoom.\n16\t    pub distance: f32,\n17\t    /// Vertical field of view (degrees). Orthographic uses it to match framing.\n18\t    pub fov: f32,\n19\t    pub ortho: bool,\n20\t    /// Seconds for the camera to catch up with the focus (0 = locked).\n21\t    pub follow_lag: f32,\n22\t    /// Look slightly above the focus point (metres).\n23\t    pub height_offset: f32,\n24\t}\n25\t\n26\timpl Default for CameraParams {\n27\t    fn default() -> Self {\n28\t        Self { tilt: 62.0, yaw: 0.0, distance: 18.0, fov: 40.0, ortho: false, follow_lag: 0.12, height_offset: 0.8 }\n29\t    }\n30\t}\n31\t\n32\timpl Tunable for CameraParams {\n33\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n34\t        v.float(\"tilt\", &mut self.tilt, 0.0, 90.0, \"Degrees above the horizon (90 = top-down, 0 = side view)\");\n35\t        v.float(\"yaw\", &mut self.yaw, -180.0, 180.0, \"Camera rotation around the focus (degrees)\");\n36\t        v.float(\"distance\", &mut self.distance, 2.0, 120.0, \"Distance / zoom (m)\");\n37\t        v.float(\"fov\", &mut self.fov, 5.0, 100.0, \"Vertical field of view (degrees)\");\n38\t        v.bool(\"ortho\", &mut self.ortho, \"Orthographic projection (flat 2D look)\");\n39\t        v.float(\"follow_lag\", &mut self.follow_lag, 0.0, 1.0, \"Seconds to catch up with the target\");\n40\t        v.float(\"height_offset\", &mut self.height_offset, -2.0, 4.0, \"Aim above the target (m)\");\n41\t    }\n42\t}\n43\t\n44\timpl CameraParams {\n45\t    pub const PRESETS: &'static [(&'static str, fn() -> CameraParams)] = &[\n46\t        (\"classic 62°\", || CameraParams::default()),\n47\t        (\"top-down 90° ortho\", || CameraParams { tilt: 90.0, ortho: true, distance: 22.0, ..Default::default() }),\n48\t        (\"high 80°\", || CameraParams { tilt: 80.0, ..Default::default() }),\n49\t        (\"70°\", || CameraParams { tilt: 70.0, ..Default::default() }),\n50\t        (\"45°\", || CameraParams { tilt: 45.0, distance: 16.0, ..Default::default() }),\n51\t        (\"isometric\", || CameraParams { tilt: 35.264, yaw: 45.0, ortho: true, distance: 24.0, ..Default::default() }),\n52\t        (\"side view\", || CameraParams { tilt: 0.0, ortho: true, distance: 20.0, height_offset: 2.0, ..Default::default() }),\n53\t        (\"close 3rd person\", || CameraParams { tilt: 25.0, distance: 7.0, fov: 60.0, height_offset: 1.4, ..Default::default() }),\n54\t    ];\n55\t}\n56\t\n57\timpl CameraParams {\n58\t    /// Blend between two camera setups (yaw takes the short way round; projection switches\n59\t    /// halfway).\n60\t    pub fn lerp(&self, o: &CameraParams, t: f32) -> CameraParams {\n61\t        let l = |a: f32, b: f32| a + (b - a) * t;\n62\t        let dyaw = ((o.yaw - self.yaw + 540.0).rem_euclid(360.0)) - 180.0;\n63\t        CameraParams {\n64\t            tilt: l(self.tilt, o.tilt),\n65\t            yaw: ((self.yaw + dyaw * t + 540.0).rem_euclid(360.0)) - 180.0,\n66\t            distance: l(self.distance, o.distance),\n67\t            fov: l(self.fov, o.fov),\n68\t            ortho: if t < 0.5 { self.ortho } else { o.ortho },\n69\t            follow_lag: l(self.follow_lag, o.follow_lag),\n70\t            height_offset: l(self.height_offset, o.height_offset),\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t#[derive(Clone, Debug)]\n76\tpub struct CameraRig {\n77\t    /// Target parameters (what the panel edits).\n78\t    pub params: CameraParams,\n79\t    /// Smoothed focus point.\n80\t    pub target: Vec3,\n81\t    initialized: bool,\n82\t    /// Blending from earlier parameters: (from, elapsed, duration).\n83\t    blend: Option<(CameraParams, f32, f32)>,\n84\t}\n85\t\n86\timpl Default for CameraRig {\n87\t    fn default() -> Self {\n88\t        Self::new(CameraParams::default())\n89\t    }\n90\t}\n91\t\n92\timpl CameraRig {\n93\t    pub fn new(params: CameraParams) -> Self {\n94\t        Self { params, target: Vec3::ZERO, initialized: false, blend: None }\n95\t    }\n96\t\n97\t    /// Parameters in effect right now (blended while a transition runs).\n98\t    pub fn current(&self) -> CameraParams {\n99\t        match &self.blend {\n100\t            Some((from, e, d)) => {\n101\t                let t = (e / d.max(1e-3)).clamp(0.0, 1.0);\n102\t                from.lerp(&self.params, t * t * (3.0 - 2.0 * t))\n103\t            }\n104\t            None => self.params.clone(),\n105\t        }\n106\t    }\n107\t\n108\t    /// Call before changing `params` to glide there over `seconds` instead of cutting.\n109\t    pub fn blend_from_current(&mut self, seconds: f32) {\n110\t        self.blend = Some((self.current(), 0.0, seconds));\n111\t    }\n112\t\n113\t    /// Follows `focus` with exponential smoothing.\n114\t    pub fn update(&mut self, focus: Vec3, dt: f32) {\n115\t        if let Some(b) = &mut self.blend {\n116\t            b.1 += dt;\n117\t            if b.1 >= b.2 {\n118\t                self.blend = None;\n119\t            }\n120\t        }\n121\t        if !self.initialized || self.params.follow_lag <= 0.0 {\n122\t            self.target = focus;\n123\t            self.initialized = true;\n124\t            return;\n125\t        }\n126\t        let k = 1.0 - (-dt / self.current().follow_lag.max(1e-3)).exp();\n127\t        self.target += (focus - self.target) * k;\n128\t    }\n129\t\n130\t    pub fn snap(&mut self, focus: Vec3) {\n131\t        self.target = focus;\n132\t        self.initialized = true;\n133\t    }\n134\t\n135\t    /// Horizontal forward (camera looking direction flattened), and right.\n136\t    pub fn ground_axes(&self) -> (Vec3, Vec3) {\n137\t        let yaw = self.current().yaw.to_radians();\n138\t        let fwd = Vec3::new(yaw.sin(), 0.0, -yaw.cos());\n139\t        let right = Vec3::new(yaw.cos(), 0.0, yaw.sin());\n140\t        (fwd, right)\n141\t    }\n142\t\n143\t    pub fn forward(&self) -> Vec3 {\n144\t        let (fh, _) = self.ground_axes();\n145\t        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n146\t        (fh * t.cos() + Vec3::NEG_Y * t.sin()).normalize()\n147\t    }\n148\t\n149\t    pub fn up(&self) -> Vec3 {\n150\t        let (fh, _) = self.ground_axes();\n151\t        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n152\t        (fh * t.sin() + Vec3::Y * t.cos()).normalize()\n153\t    }\n154\t\n155\t    pub fn look_at(&self) -> Vec3 {\n156\t        self.target + Vec3::Y * self.current().height_offset\n157\t    }\n158\t\n159\t    pub fn eye(&self) -> Vec3 {\n160\t        self.look_at() - self.forward() * self.current().distance\n161\t    }\n162\t\n163\t    pub fn data(&self, aspect: f32) -> CameraData {\n164\t        let p = &self.current();\n165\t        let fwd = self.forward();\n166\t        let eye = self.eye();\n167\t        let view = glam::camera::rh::view::look_to_mat4(eye, fwd, self.up());\n168\t        let mut fov = p.fov.clamp(1.0, 170.0).to_radians();\n169\t        if aspect < 1.0 && aspect > 0.0 {\n170\t            // Taller than wide (a phone held upright): the field of view is the width's, so the\n171\t            // sides are not cut down to a sliver.\n172\t            fov = (2.0 * ((fov * 0.5).tan() / aspect).atan()).min(150f32.to_radians());\n173\t        }\n174\t        let far = (p.distance * 4.0 + 200.0).max(300.0);\n175\t        let proj = if p.ortho {\n176\t            let half_h = p.distance * (fov * 0.5).tan();\n177\t            let half_w = half_h * aspect;\n178\t            glam::camera::rh::proj::directx::orthographic(-half_w, half_w, -half_h, half_h, 0.05, far)\n179\t        } else {\n180\t            glam::camera::rh::proj::directx::perspective(fov, aspect, 0.1, far)\n181\t        };\n182\t        CameraData { view, proj, eye, forward: fwd, ortho: p.ortho }\n183\t    }\n184\t\n185\t    /// World-space ray through a pixel (origin, direction).\n186\t    pub fn screen_ray(&self, px: Vec2, size: Vec2) -> (Vec3, Vec3) {\n187\t        let cam = self.data(size.x / size.y.max(1.0));\n188\t        let inv = (cam.proj * cam.view).inverse();\n189\t        let ndc = Vec2::new(px.x / size.x * 2.0 - 1.0, 1.0 - px.y / size.y * 2.0);\n190\t        let near = inv.project_point3(ndc.extend(0.0));\n191\t        let far = inv.project_point3(ndc.extend(1.0));\n192\t        (near, (far - near).normalize())\n193\t    }\n194\t\n195\t    /// Where a pixel's ray hits the horizontal plane at `height`.\n196\t    pub fn ground_point(&self, px: Vec2, size: Vec2, height: f32) -> Option<Vec3> {\n197\t        let (o, d) = self.screen_ray(px, size);\n198\t        if d.y.abs() < 1e-5 {\n199\t            return None;\n200\t        }\n201\t        let t = (height - o.y) / d.y;\n202\t        (t > 0.0).then(|| o + d * t)\n203\t    }\n204\t\n205\t    /// Converts stick/WASD input (x right, y up) into a world direction on the ground plane.\n206\t    pub fn relative_move(&self, input: Vec2) -> Vec2 {\n207\t        let (f, r) = self.ground_axes();\n208\t        let w = r * input.x + f * input.y;\n209\t        Vec2::new(w.x, w.z)\n210\t    }\n211\t\n212\t    pub fn view_proj(&self, aspect: f32) -> Mat4 {\n213\t        let d = self.data(aspect);\n214\t        d.proj * d.view\n215\t    }\n216\t}\n217\t"}]},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"583c8741-cff8-4f1f-bd02-451ac6b46a15","timestamp":"2026-11-05T13:32:12.491Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-063049__x42677a/work/DioramaCenterSecondOpinion-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-063049/engine/crates/pav_view/src/camera.rs","content":"//! The camera rig: every parameter is live. \"2D top-down\" is just tilt 90 + orthographic.\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::params::{ParamVisitor, Tunable};\nuse pav_render::CameraData;\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct CameraParams {\n    /// Degrees above the horizon: 90 = straight down, 0 = side view.\n    pub tilt: f32,\n    /// Degrees; 0 = looking north (-Z).\n    pub yaw: f32,\n    /// Distance from the focus point (metres). In orthographic mode it sets the zoom.\n    pub distance: f32,\n    /// Vertical field of view (degrees). Orthographic uses it to match framing.\n    pub fov: f32,\n    pub ortho: bool,\n    /// Seconds for the camera to catch up with the focus (0 = locked).\n    pub follow_lag: f32,\n    /// Look slightly above the focus point (metres).\n    pub height_offset: f32,\n}\n\nimpl Default for CameraParams {\n    fn default() -> Self {\n        Self { tilt: 62.0, yaw: 0.0, distance: 18.0, fov: 40.0, ortho: false, follow_lag: 0.12, height_offset: 0.8 }\n    }\n}\n\nimpl Tunable for CameraParams {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"tilt\", &mut self.tilt, 0.0, 90.0, \"Degrees above the horizon (90 = top-down, 0 = side view)\");\n        v.float(\"yaw\", &mut self.yaw, -180.0, 180.0, \"Camera rotation around the focus (degrees)\");\n        v.float(\"distance\", &mut self.distance, 2.0, 120.0, \"Distance / zoom (m)\");\n        v.float(\"fov\", &mut self.fov, 5.0, 100.0, \"Vertical field of view (degrees)\");\n        v.bool(\"ortho\", &mut self.ortho, \"Orthographic projection (flat 2D look)\");\n        v.float(\"follow_lag\", &mut self.follow_lag, 0.0, 1.0, \"Seconds to catch up with the target\");\n        v.float(\"height_offset\", &mut self.height_offset, -2.0, 4.0, \"Aim above the target (m)\");\n    }\n}\n\nimpl CameraParams {\n    pub const PRESETS: &'static [(&'static str, fn() -> CameraParams)] = &[\n        (\"classic 62°\", || CameraParams::default()),\n        (\"top-down 90° ortho\", || CameraParams { tilt: 90.0, ortho: true, distance: 22.0, ..Default::default() }),\n        (\"high 80°\", || CameraParams { tilt: 80.0, ..Default::default() }),\n        (\"70°\", || CameraParams { tilt: 70.0, ..Default::default() }),\n        (\"45°\", || CameraParams { tilt: 45.0, distance: 16.0, ..Default::default() }),\n        (\"isometric\", || CameraParams { tilt: 35.264, yaw: 45.0, ortho: true, distance: 24.0, ..Default::default() }),\n        (\"side view\", || CameraParams { tilt: 0.0, ortho: true, distance: 20.0, height_offset: 2.0, ..Default::default() }),\n        (\"close 3rd person\", || CameraParams { tilt: 25.0, distance: 7.0, fov: 60.0, height_offset: 1.4, ..Default::default() }),\n    ];\n}\n\nimpl CameraParams {\n    /// Blend between two camera setups (yaw takes the short way round; projection switches\n    /// halfway).\n    pub fn lerp(&self, o: &CameraParams, t: f32) -> CameraParams {\n        let l = |a: f32, b: f32| a + (b - a) * t;\n        let dyaw = ((o.yaw - self.yaw + 540.0).rem_euclid(360.0)) - 180.0;\n        CameraParams {\n            tilt: l(self.tilt, o.tilt),\n            yaw: ((self.yaw + dyaw * t + 540.0).rem_euclid(360.0)) - 180.0,\n            distance: l(self.distance, o.distance),\n            fov: l(self.fov, o.fov),\n            ortho: if t < 0.5 { self.ortho } else { o.ortho },\n            follow_lag: l(self.follow_lag, o.follow_lag),\n            height_offset: l(self.height_offset, o.height_offset),\n        }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct CameraRig {\n    /// Target parameters (what the panel edits).\n    pub params: CameraParams,\n    /// Smoothed focus point.\n    pub target: Vec3,\n    initialized: bool,\n    /// Blending from earlier parameters: (from, elapsed, duration).\n    blend: Option<(CameraParams, f32, f32)>,\n}\n\nimpl Default for CameraRig {\n    fn default() -> Self {\n        Self::new(CameraParams::default())\n    }\n}\n\nimpl CameraRig {\n    pub fn new(params: CameraParams) -> Self {\n        Self { params, target: Vec3::ZERO, initialized: false, blend: None }\n    }\n\n    /// Parameters in effect right now (blended while a transition runs).\n    pub fn current(&self) -> CameraParams {\n        match &self.blend {\n            Some((from, e, d)) => {\n                let t = (e / d.max(1e-3)).clamp(0.0, 1.0);\n                from.lerp(&self.params, t * t * (3.0 - 2.0 * t))\n            }\n            None => self.params.clone(),\n        }\n    }\n\n    /// Call before changing `params` to glide there over `seconds` instead of cutting.\n    pub fn blend_from_current(&mut self, seconds: f32) {\n        self.blend = Some((self.current(), 0.0, seconds));\n    }\n\n    /// Follows `focus` with exponential smoothing.\n    pub fn update(&mut self, focus: Vec3, dt: f32) {\n        if let Some(b) = &mut self.blend {\n            b.1 += dt;\n            if b.1 >= b.2 {\n                self.blend = None;\n            }\n        }\n        if !self.initialized || self.params.follow_lag <= 0.0 {\n            self.target = focus;\n            self.initialized = true;\n            return;\n        }\n        let k = 1.0 - (-dt / self.current().follow_lag.max(1e-3)).exp();\n        self.target += (focus - self.target) * k;\n    }\n\n    pub fn snap(&mut self, focus: Vec3) {\n        self.target = focus;\n        self.initialized = true;\n    }\n\n    /// Horizontal forward (camera looking direction flattened), and right.\n    pub fn ground_axes(&self) -> (Vec3, Vec3) {\n        let yaw = self.current().yaw.to_radians();\n        let fwd = Vec3::new(yaw.sin(), 0.0, -yaw.cos());\n        let right = Vec3::new(yaw.cos(), 0.0, yaw.sin());\n        (fwd, right)\n    }\n\n    pub fn forward(&self) -> Vec3 {\n        let (fh, _) = self.ground_axes();\n        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n        (fh * t.cos() + Vec3::NEG_Y * t.sin()).normalize()\n    }\n\n    pub fn up(&self) -> Vec3 {\n        let (fh, _) = self.ground_axes();\n        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n        (fh * t.sin() + Vec3::Y * t.cos()).normalize()\n    }\n\n    pub fn look_at(&self) -> Vec3 {\n        self.target + Vec3::Y * self.current().height_offset\n    }\n\n    pub fn eye(&self) -> Vec3 {\n        self.look_at() - self.forward() * self.current().distance\n    }\n\n    pub fn data(&self, aspect: f32) -> CameraData {\n        let p = &self.current();\n        let fwd = self.forward();\n        let eye = self.eye();\n        let view = glam::camera::rh::view::look_to_mat4(eye, fwd, self.up());\n        let mut fov = p.fov.clamp(1.0, 170.0).to_radians();\n        if aspect < 1.0 && aspect > 0.0 {\n            // Taller than wide (a phone held upright): the field of view is the width's, so the\n            // sides are not cut down to a sliver.\n            fov = (2.0 * ((fov * 0.5).tan() / aspect).atan()).min(150f32.to_radians());\n        }\n        let far = (p.distance * 4.0 + 200.0).max(300.0);\n        let proj = if p.ortho {\n            let half_h = p.distance * (fov * 0.5).tan();\n            let half_w = half_h * aspect;\n            glam::camera::rh::proj::directx::orthographic(-half_w, half_w, -half_h, half_h, 0.05, far)\n        } else {\n            glam::camera::rh::proj::directx::perspective(fov, aspect, 0.1, far)\n        };\n        CameraData { view, proj, eye, forward: fwd, ortho: p.ortho }\n    }\n\n    /// World-space ray through a pixel (origin, direction).\n    pub fn screen_ray(&self, px: Vec2, size: Vec2) -> (Vec3, Vec3) {\n        let cam = self.data(size.x / size.y.max(1.0));\n        let inv = (cam.proj * cam.view).inverse();\n        let ndc = Vec2::new(px.x / size.x * 2.0 - 1.0, 1.0 - px.y / size.y * 2.0);\n        let near = inv.project_point3(ndc.extend(0.0));\n        let far = inv.project_point3(ndc.extend(1.0));\n        (near, (far - near).normalize())\n    }\n\n    /// Where a pixel's ray hits the horizontal plane at `height`.\n    pub fn ground_point(&self, px: Vec2, size: Vec2, height: f32) -> Option<Vec3> {\n        let (o, d) = self.screen_ray(px, size);\n        if d.y.abs() < 1e-5 {\n            return None;\n        }\n        let t = (height - o.y) / d.y;\n        (t > 0.0).then(|| o + d * t)\n    }\n\n    /// Converts stick/WASD input (x right, y up) into a world direction on the ground plane.\n    pub fn relative_move(&self, input: Vec2) -> Vec2 {\n        let (f, r) = self.ground_axes();\n        let w = r * input.x + f * input.y;\n        Vec2::new(w.x, w.z)\n    }\n\n    pub fn view_proj(&self, aspect: f32) -> Mat4 {\n        let d = self.data(aspect);\n        d.proj * d.view\n    }\n}\n","numLines":217,"startLine":1,"totalLines":217}},"tool_result_meta":[{"id":"toolu_01QVd5CDnXUh8MpAx6zqwsYM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
