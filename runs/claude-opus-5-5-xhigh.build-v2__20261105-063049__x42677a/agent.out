   772 crates/pav_core/src/material/schema.rs\n    808 crates/pav_core/src/rig.rs\n    814 crates/pav_core/src/props/doc.rs\n    816 crates/pav_core/src/arpg/items.rs\n    839 crates/pav_tools/src/import/gltf.rs\n    888 crates/pav_core/src/figure.rs\n    921 crates/pav_tools/src/material_tools.rs\n    951 crates/pav_core/src/material/eval.rs\n    984 crates/pav_tools/src/anim_tools.rs\n   1004 crates/pav_ui/src/touch.rs\n   1052 crates/pav_core/src/arpg/mechanics.rs\n   1065 crates/pav_tools/src/mocap/readable.rs\n   1073 crates/pav_core/src/arpg/skills.rs\n   1088 crates/pav_core/src/arpg/scene.rs\n   1093 crates/pav_core/src/clips.rs\n   1147 crates/pav_core/src/props/geom.rs\n   1187 crates/pav_core/src/sim.rs\n   1227 crates/pav_core/src/props/patch/v2.rs\n   1228 crates/pav_ui/src/arpg_items.rs\n   1244 crates/pav_core/src/props/mod.rs\n   1281 crates/pav_core/src/character.rs\n   1311 crates/pav_tools/src/asset_tools.rs\n   1333 crates/pav_tools/src/creature_tools.rs\n   1365 crates/pav_tools/src/asset_import.rs\n   1434 crates/pav_core/src/world.rs\n   1479 crates/pav_core/src/props/compile.rs\n   1517 crates/pav_tools/src/game_tools.rs\n   1521 crates/pav_render/src/renderer.rs\n   1632 crates/pav_core/src/puppet.rs\n   1678 crates/pav_core/src/arpg/world.rs\n   1755 crates/pav_core/src/arpg/mod.rs\n   1861 crates/pav_tools/src/tools.rs\n   2266 crates/pav_app/src/app.rs\n   2405 crates/pav_view/src/build.rs\n   3066 crates/pav_core/src/props/read/v2.rs\n 112171 total\ncrates/pav_app:\nCargo.toml\nsrc\n\ncrates/pav_audio:\nCargo.toml\nsrc\n\ncrates/pav_core:\nCargo.toml\nbuild.rs\nsrc\ntests\n\ncrates/pav_render:\nCargo.toml\nexamples\nsrc\n\ncrates/pav_tools:\nCargo.toml\nsrc\ntests\n\ncrates/pav_ui:\nCargo.toml\nsrc\n\ncrates/pav_view:\nCargo.toml\nsrc\ntests\n[workspace]\nresolver = \"3\"\nmembers = [\"crates/*\"]\n\n[workspace.package]\nversion = \"0.1.0\"\nedition = \"2024\"\npublish = false\n\n[workspace.dependencies]\nab_glyph = \"0.2\"\nepaint_defau