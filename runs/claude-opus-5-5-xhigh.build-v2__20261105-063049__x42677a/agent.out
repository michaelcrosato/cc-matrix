.03, freq_end: f(220.0), glide: 0.3, decay: 0.34, volume: 0.13 * g, ..Patch::new(Sine, f(420.0)) }, 0.0)],\n        cue::GIFT_READY => vec![(t(Sine, 1318.5, 0.3, 0.1), 0.0), (t(Sine, 1760.0, 0.3, 0.1), 0.1), (t(Sine, 2637.0, 0.6, 0.1), 0.2)],\n        cue::GIFT_FIRE => vec![\n            (Patch { attack: 0.01, freq_end: f(55.0), glide: 0.5, decay: 0.9, volume: 0.42 * g, ..Patch::new(Sine, f(330.0)) }, 0.0),\n            (Patch { attack: 0.05, decay: 1.2, volume: 0.13 * g, ..Patch::new(Sine, f(1760.0)) }, 0.05),\n            (Patch { attack: 0.05, decay: 1.2, volume: 0.1 * g, ..Patch::new(Sine, f(2637.0)) }, 0.1),\n        ],\n        cue::RING => vec![(Patch { attack: 0.05, freq_end: f(900.0), glide: 0.6, decay: 0.7, volume: 0.16 * g, cutoff: 5000.0, ..Patch::new(Saw, f(120.0)) }, 0.0), (n(0.1, 0.5, 0.16, 3000.0, 800.0), 0.0)],\n        cue::TICK => vec![(t(Square, 1760.0, 0.03, 0.14), 0.0)],\n        cue::SPURT => vec![(n(0.005, 0.1, 0.18, 1600.0, 500.0), 0.0)],\n        cue::TEAR => vec![(n(0.003, 0.18, 0.3, 3200.0, 700.0), 0.0), (Patch { freq_end: f(110.0), glide: 0.14, decay: 0.16, volume: 0.15 * g, duty: 0.3, ..Patch::new(Square, f(320.0)) }, 0.0)],\n        cue::THUNDER => vec![(n(0.02, 1.6, 0.42, 700.0, 90.0), 0.0), (Patch { freq_end: f(30.0), glide: 1.0, decay: 1.2, volume: 0.42 * g, ..Patch::new(Sine, f(70.0)) }, 0.05)],\n        cue::STAMP => vec![(Patch { freq_end: f(50.0), glide: 0.08, decay: 0.2, volume: 0.62 * g, ..Patch::new(Sine, f(180.0)) }, 0.0), (n(0.001, 0.08, 0.34, 3400.0, 600.0), 0.0)],\n        _ => Vec::new(),\n    }\n}\nEOF\ncat > crates/pav_audio/src/voice.rs <<'EOF'\n//! Animalese-style voices: each syllable of the text is a short pitched blip through two resonant\n//! formant filters chosen from the vowel. Per-character base pitch, waveform and speed; falling\n//! pitch at full stops, rising at question marks.\n\nuse crate::{Patch, Wave};\n\n/// How a character sounds.\n#[derive(Clone, Copy, Debug)]\npub struct VoiceDef {\n    pub pitch: f32,\n    pub wave: Wave,\n    pub pace: f32,\n    /// Random wobble, in semitones.\n    pub jitter: f32,\n}\n\npub fn wave_named(s: &str) -> Wave {\n    match s {\n        \"square\" => Wave::Square,\n        \"saw\" => Wave::Saw,\n        \"sine\" => Wave::Sine,\n        _ => Wave::Triangle,\n    }\n}\n\nfn formants(v: char) -> [(f32, f32); 2] {\n    match v {\n        'a' => [(800.0, 7.0), (1250.0, 8.0)],\n        'e' => [(520.0, 7.0), (1900.0, 9.0)],\n        'i' => [(320.0, 7.0), (2300.0, 10.0)],\n        'o' => [(520.0, 7.0), (900.0, 8.0)],\n        'u' => [(340.0, 7.0), (800.0, 8.0)],\n        _ => [(500.0, 6.0), (1500.0, 7.0)],\n    }\n}\n\nfn is_vowel(c: char) -> bool {\n    matches!(c, 'a' | 'e' | 'i' | 'o' | 'u' | 'y')\n}\n\n/// The syllables of a text: (character index, vowel, inflection).\npub fn syllables(text: &str) -> Vec<(usize, char, f32)> {\n    let chars: Vec<char> = text.chars().map(|c| c.to_ascii_lowercase()).collect();\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < chars.len() {\n        if is_vowel(chars[i]) {\n            let at = i;\n            let v = chars[i];\n            while i < chars.len() && is_vowel(chars[i]) {\n                i += 1;\n            }\n            // How the sentence turns: look ahead to its end.\n            let mut j = i;\n            while j < chars.len() && !matches!(chars[j], '.' | '?' | '!') {\n                j += 1;\n            }\n            let near = j.saturating_sub(i) < 7;\n            let turn = if near {\n                match chars.get(j) {\n                    Some('.') => -2.5,\n                    Some('?') => 3.0,\n                    Some('!') => 1.2,\n                    _ => 0.0,\n                }\n            } else {\n                0.0\n            };\n            out.push((at, v, turn));\n        } else {\n            i += 1;\n        }\n    }\n    out\n}\n\nfn hash(x: usize) -> f32 {\n    let n = (x as u32).wrapping_mul(2_654_435_761);\n    ((n >> 16) & 0xffff) as f32 / 65535.0\n}\n\n/// The blip for one syllable.\npub fn blip(v: &VoiceDef, vowel: char, turn: f32, seed: usize) -> Patch {\n    let wob = (hash(seed) - 0.5) * 2.0 * (v.jitter + 0.5);\n    let semis = wob + turn;\n    let freq = v.pitch * 2f32.powf(semis / 12.0);\n    Patch {\n        attack: 0.006,\n        decay: 0.05,\n        sustain: 0.35,\n        hold: 0.012,\n        release: 0.02,\n        volume: 0.75,\n        duty: 0.34,\n        cutoff: 7000.0,\n        cutoff_end: 5000.0,\n        formants: formants(vowel),\n        ..Patch::new(v.wave, freq)\n    }\n}\n\n/// Follows a line as it reveals and says the syllables it passes.\n#[derive(Default)]\npub struct Speaker {\n    serial: u64,\n    said: usize,\n    syl: Vec<(usize, char, f32)>,\n    last_at: f32,\n}\n\nimpl Speaker {\n    /// New text starts over. `shown` is how many characters are on screen; returns blips due.\n    pub fn update(&mut self, serial: u64, text: &str, shown: usize, now: f32, v: &VoiceDef, out: &mut Vec<Patch>) {\n        if serial != self.serial {\n            self.serial = serial;\n            self.said = 0;\n            self.syl = syllables(text);\n        }\n        while self.said < self.syl.len() && self.syl[self.said].0 < shown {\n            let (at, vowel, turn) = self.syl[self.said];\n            self.said += 1;\n            // Pace: a typed-through line doesn't machine-gun.\n            if now - self.last_at >= v.pace * 0.7 {\n                self.last_at = now;\n                out.push(blip(v, vowel, turn, at + serial as usize * 31));\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_audio/src/music.rs <<'EOF'\n//! A small note-event sequencer: it runs on the render thread and schedules ahead with `play`'s\n//! delay, so tempo can follow the heart. Composed in code: title theme, two story beds, the OR loop\n//! whose bass lands on the actual heartbeat, a crisis layer, a motif per strain in its own meter,\n//! the Hush, the results fanfare, Code Blue's drive.\n\nuse crate::{Patch, Wave};\n\n/// What the game wants from the music this frame.\n#[derive(Clone, Debug, Default)]\npub struct MusicInput {\n    pub track: String,\n    pub bpm: f32,\n    /// Heart position: beats so far plus the phase.\n    pub heart: f64,\n    pub crisis: f32,\n    pub hush: f32,\n    pub motif: u8,\n    pub flat: bool,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Inst {\n    Piano,\n    Bass,\n    Pad,\n    Pluck,\n    Strings,\n    Bell,\n    Kick,\n    Hat,\n    Brass,\n    Lead,\n}\n\nfn hz(midi: f32) -> f32 {\n    440.0 * 2f32.powf((midi - 69.0) / 12.0)\n}\n\n/// A note as patches: (patch, pan, gain).\nfn note(inst: Inst, midi: f32, secs: f32, vel: f32, out: &mut Vec<(Patch, f32, f32)>) {\n    let f = hz(midi);\n    match inst {\n        Inst::Piano => {\n            out.push((Patch { attack: 0.004, decay: 0.5 + secs * 0.6, sustain: 0.0, volume: 0.36, cutoff: 3200.0, cutoff_end: 900.0, ..Patch::new(Wave::Triangle, f) }, -0.1, vel));\n            out.push((Patch { attack: 0.003, decay: 0.22, volume: 0.12, ..Patch::new(Wave::Sine, f * 2.0) }, 0.05, vel));\n            out.push((Patch { attack: 0.002, decay: 0.08, volume: 0.05, cutoff: 5000.0, ..Patch::new(Wave::Square, f * 3.0) }, 0.0, vel));\n        }\n        Inst::Bass => {\n            out.push((Patch { attack: 0.008, decay: secs.max(0.12), sustain: 0.0, volume: 0.6, ..Patch::new(Wave::Sine, f) }, 0.0, vel));\n            out.push((Patch { attack: 0.006, decay: secs.max(0.1) * 0.7, volume: 0.22, cutoff: 700.0, cutoff_end: 260.0, ..Patch::new(Wave::Saw, f) }, 0.0, vel));\n        }\n        Inst::Pad => {\n            let rel = (secs * 0.4).clamp(0.3, 1.6);\n            for (d, pan) in [(0.997, -0.5), (1.003, 0.5)] {\n                out.push((Patch { attack: (secs * 0.3).clamp(0.08, 1.2), decay: 0.2, sustain: 0.8, hold: secs * 0.6, release: rel, volume: 0.13, cutoff: 1100.0, cutoff_end: 800.0, vibrato: (6.0, 4.3), ..Patch::new(Wave::Saw, f * d) }, pan, vel));\n            }\n        }\n        Inst::Strings => {\n            for (d, pan) in [(0.996, -0.3), (1.004, 0.3)] {\n                out.push((Patch { attack: 0.03, decay: 0.05, sustain: 0.9, hold: secs * 0.8, release: 0.08, volume: 0.1, cutoff: 2600.0, vibrato: (12.0, 5.6), ..Patch::new(Wave::Saw, f * d) }, pan, vel));\n            }\n        }\n        Inst::Pluck => out.push((Patch { attack: 0.002, decay: 0.16, volume: 0.22, duty: 0.3, cutoff: 3200.0, cutoff_end: 700.0, ..Patch::new(Wave::Square, f) }, 0.25, vel)),\n        Inst::Bell => out.push((Patch { attack: 0.002, decay: 0.9, volume: 0.22, ..Patch::new(Wave::Sine, f) }, -0.2, vel)),\n        Inst::Kick => out.push((Patch { freq_end: 42.0, glide: 0.09, decay: 0.14, volume: 0.7, ..Patch::new(Wave::Sine, 130.0) }, 0.0, vel)),\n        Inst::Hat => out.push((Patch { decay: 0.035, volume: 0.1, cutoff: 12000.0, cutoff_end: 7000.0, ..Patch::new(Wave::Noise, 1.0) }, 0.3, vel)),\n        Inst::Brass => {\n            for d in [0.998, 1.002] {\n                out.push((Patch { attack: 0.03, decay: 0.15, sustain: 0.7, hold: secs * 0.7, release: 0.12, volume: 0.17, cutoff: 800.0, cutoff_end: 2600.0, ..Patch::new(Wave::Saw, f * d) }, 0.0, vel));\n            }\n        }\n        Inst::Lead => out.push((Patch { attack: 0.02, decay: 0.2, sustain: 0.6, hold: secs * 0.7, release: 0.16, volume: 0.17, cutoff: 2400.0, vibrato: (10.0, 5.0), ..Patch::new(Wave::Triangle, f) }, 0.15, vel)),\n    }\n}\n\n/// A melody, written as (step, midi, steps long), on a grid of `len` steps.\nstruct Line {\n    inst: Inst,\n    len: u32,\n    notes: &'static [(u32, f32, f32)],\n    vel: f32,\n}\n\n// A minor. A tune you could hum: the title theme, in 16 bars of 8 steps (eighth notes at 58 bpm).\nconst TITLE_MELODY: Line = Line {\n    inst: Inst::Piano,\n    len: 128,\n    vel: 1.0,\n    notes: &[\n        (0, 76.0, 3.0), (3, 72.0, 1.0), (4, 74.0, 2.0), (6, 71.0, 2.0),\n        (8, 72.0, 3.0), (11, 69.0, 1.0), (12, 69.0, 4.0),\n        (16, 77.0, 3.0), (19, 76.0, 1.0), (20, 74.0, 2.0), (22, 72.0, 2.0),\n        (24, 71.0, 3.0), (27, 74.0, 1.0), (28, 76.0, 4.0),\n        (32, 76.0, 3.0), (35, 72.0, 1.0), (36, 74.0, 2.0), (38, 71.0, 2.0),\n        (40, 72.0, 2.0), (42, 71.0, 1.0), (43, 69.0, 1.0), (44, 67.0, 4.0),\n        (48, 65.0, 2.0), (50, 69.0, 2.0), (52, 72.0, 2.0), (54, 77.0, 2.0),\n        (56, 76.0, 3.0), (59, 74.0, 1.0), (60, 76.0, 4.0),\n        (64, 81.0, 3.0), (67, 79.0, 1.0), (68, 77.0, 2.0), (70, 76.0, 2.0),\n        (72, 74.0, 3.0), (75, 72.0, 1.0), (76, 71.0, 4.0),\n        (80, 72.0, 2.0), (82, 74.0, 2.0), (84, 76.0, 2.0), (86, 77.0, 2.0),\n        (88, 79.0, 3.0), (91, 76.0, 1.0), (92, 72.0, 4.0),\n        (96, 74.0, 3.0), (99, 72.0, 1.0), (100, 71.0, 2.0), (102, 69.0, 2.0),\n        (104, 68.0, 3.0), (107, 71.0, 1.0), (108, 76.0, 4.0),\n        (112, 72.0, 2.0), (114, 71.0, 2.0), (116, 69.0, 4.0),\n        (120, 69.0, 8.0),\n    ],\n};\nconst TITLE_LEFT: Line = Line {\n    inst: Inst::Piano,\n    len: 64,\n    vel: 0.55,\n    notes: &[\n        (0, 45.0, 2.0), (2, 52.0, 2.0), (4, 57.0, 2.0), (6, 60.0, 2.0),\n        (8, 41.0, 2.0), (10, 48.0, 2.0), (12, 53.0, 2.0), (14, 57.0, 2.0),\n        (16, 38.0, 2.0), (18, 45.0, 2.0), (20, 50.0, 2.0), (22, 53.0, 2.0),\n        (24, 40.0, 2.0), (26, 47.0, 2.0), (28, 52.0, 2.0), (30, 56.0, 2.0),\n        (32, 45.0, 2.0), (34, 52.0, 2.0), (36, 57.0, 2.0), (38, 60.0, 2.0),\n        (40, 43.0, 2.0), (42, 50.0, 2.0), (44, 55.0, 2.0), (46, 59.0, 2.0),\n        (48, 41.0, 2.0), (50, 48.0, 2.0), (52, 53.0, 2.0), (54, 57.0, 2.0),\n        (56, 40.0, 2.0), (58, 47.0, 2.0), (60, 52.0, 2.0), (62, 56.0, 2.0),\n    ],\n};\nconst TENDER_PAD: Line = Line {\n    inst: Inst::Pad,\n    len: 64,\n    vel: 1.0,\n    notes: &[\n        (0, 53.0, 16.0), (0, 60.0, 16.0), (0, 65.0, 16.0),\n        (16, 50.0, 16.0), (16, 57.0, 16.0), (16, 65.0, 16.0),\n        (32, 46.0, 16.0), (32, 58.0, 16.0), (32, 62.0, 16.0),\n        (48, 48.0, 16.0), (48, 55.0, 16.0), (48, 64.0, 16.0),\n    ],\n};\nconst TENDER_TUNE: Line = Line {\n    inst: Inst::Piano,\n    len: 128,\n    vel: 0.8,\n    notes: &[\n        (0, 72.0, 4.0), (4, 74.0, 2.0), (6, 76.0, 2.0), (8, 77.0, 6.0), (14, 76.0, 2.0),\n        (16, 74.0, 6.0), (22, 72.0, 2.0), (24, 69.0, 8.0),\n        (32, 70.0, 4.0), (36, 72.0, 2.0), (38, 74.0, 2.0), (40, 77.0, 6.0), (46, 74.0, 2.0),\n        (48, 72.0, 8.0), (56, 67.0, 8.0),\n        (64, 72.0, 4.0), (68, 74.0, 2.0), (70, 76.0, 2.0), (72, 77.0, 4.0), (76, 79.0, 4.0),\n        (80, 81.0, 8.0), (88, 77.0, 8.0),\n        (96, 79.0, 4.0), (100, 77.0, 2.0), (102, 74.0, 2.0), (104, 76.0, 8.0),\n        (112, 72.0, 16.0),\n    ],\n};\nconst TENSE_BASS: Line = Line {\n    inst: Inst::Bass,\n    len: 32,\n    vel: 0.8,\n    notes: &[\n        (0, 38.0, 1.5), (3, 38.0, 1.0), (6, 38.0, 1.0), (8, 38.0, 1.5), (11, 41.0, 1.0), (14, 40.0, 1.0),\n        (16, 37.0, 1.5), (19, 37.0, 1.0), (22, 37.0, 1.0), (24, 37.0, 1.5), (27, 40.0, 1.0), (30, 38.0, 1.0),\n    ],\n};\nconst TENSE_STRINGS: Line = Line {\n    inst: Inst::Strings,\n    len: 64,\n    vel: 0.65,\n    notes: &[\n        (0, 62.0, 8.0), (8, 65.0, 8.0), (16, 64.0, 8.0), (24, 61.0, 8.0),\n        (32, 62.0, 4.0), (36, 69.0, 4.0), (40, 70.0, 8.0), (48, 69.0, 8.0), (56, 61.0, 8.0),\n    ],\n};\nconst TENSE_DROPS: Line = Line {\n    inst: Inst::Bell,\n    len: 64,\n    vel: 0.25,\n    notes: &[(6, 86.0, 1.0), (22, 89.0, 1.0), (30, 85.0, 1.0), (46, 82.0, 1.0), (54, 86.0, 1.0)],\n};\n\n// The OR loop runs at 4 steps per heartbeat: what you hear is literally the patient.\nconst OR_PLUCK: Line = Line {\n    inst: Inst::Pluck,\n    len: 32,\n    vel: 0.42,\n    notes: &[\n        (0, 69.0, 1.0), (2, 72.0, 1.0), (4, 76.0, 1.0), (6, 72.0, 1.0),\n        (8, 69.0, 1.0), (10, 72.0, 1.0), (12, 77.0, 1.0), (14, 72.0, 1.0),\n        (16, 67.0, 1.0), (18, 71.0, 1.0), (20, 74.0, 1.0), (22, 71.0, 1.0),\n        (24, 68.0, 1.0), (26, 71.0, 1.0), (28, 76.0, 1.0), (30, 74.0, 1.0),\n    ],\n};\nconst OR_PAD: Line = Line {\n    inst: Inst::Pad,\n    len: 64,\n    vel: 0.62,\n    notes: &[\n        (0, 57.0, 8.0), (0, 64.0, 8.0), (8, 53.0, 8.0), (8, 60.0, 8.0), (16, 55.0, 8.0), (16, 62.0, 8.0), (24, 52.0, 8.0), (24, 59.0, 8.0),\n        (32, 57.0, 8.0), (32, 64.0, 8.0), (40, 50.0, 8.0), (40, 60.0, 8.0), (48, 52.0, 16.0), (48, 59.0, 16.0),\n    ],\n};\nconst OR_TUNE: Line = Line {\n    inst: Inst::Lead,\n    len: 64,\n    vel: 0.5,\n    notes: &[\n        (8, 76.0, 4.0), (12, 77.0, 2.0), (14, 76.0, 2.0), (16, 74.0, 6.0), (22, 71.0, 2.0),\n        (24, 72.0, 8.0), (40, 69.0, 2.0), (42, 72.0, 2.0), (44, 76.0, 4.0), (48, 74.0, 2.0),\n        (50, 72.0, 2.0), (52, 71.0, 4.0), (56, 68.0, 8.0),\n    ],\n};\nconst CRISIS_STRINGS: Line = Line {\n    inst: Inst::Strings,\n    len: 16,\n    vel: 0.8,\n    notes: &[\n        (0, 81.0, 1.0), (1, 80.0, 1.0), (2, 81.0, 1.0), (3, 80.0, 1.0), (4, 81.0, 1.0), (5, 80.0, 1.0), (6, 81.0, 1.0), (7, 80.0, 1.0),\n        (8, 82.0, 1.0), (9, 81.0, 1.0), (10, 82.0, 1.0), (11, 81.0, 1.0), (12, 82.0, 1.0), (13, 81.0, 1.0), (14, 82.0, 1.0), (15, 81.0, 1.0),\n    ],\n};\n\n// The strains' motifs, one heartbeat to the beat, four steps to the heartbeat: each loops in its own meter.\nconst WALTZ_3_4: Line = Line {\n    inst: Inst::Bell,\n    len: 48,\n    vel: 0.7,\n    notes: &[\n        (0, 76.0, 4.0), (4, 81.0, 4.0), (8, 80.0, 4.0),\n        (12, 76.0, 4.0), (16, 84.0, 4.0), (20, 83.0, 4.0),\n        (24, 81.0, 4.0), (28, 77.0, 4.0), (32, 76.0, 4.0),\n        (36, 74.0, 6.0), (42, 68.0, 2.0), (44, 69.0, 4.0),\n    ],\n};\nconst LULLABY_6_8: Line = Line {\n    inst: Inst::Bell,\n    len: 48,\n    vel: 0.7,\n    notes: &[\n        (0, 72.0, 4.0), (4, 75.0, 2.0), (6, 79.0, 2.0), (8, 77.0, 4.0), (12, 75.0, 4.0), (16, 74.0, 2.0), (18, 72.0, 2.0), (20, 71.0, 4.0),\n        (24, 72.0, 4.0), (28, 79.0, 2.0), (30, 84.0, 2.0), (32, 83.0, 4.0), (36, 79.0, 4.0), (40, 75.0, 8.0),\n    ],\n};\nconst FIVE_4: Line = Line {\n    inst: Inst::Brass,\n    len: 40,\n    vel: 0.55,\n    notes: &[\n        (0, 50.0, 3.0), (3, 50.0, 1.0), (4, 53.0, 4.0), (8, 50.0, 3.0), (11, 50.0, 1.0), (12, 56.0, 4.0), (16, 55.0, 4.0),\n        (20, 50.0, 3.0), (23, 50.0, 1.0), (24, 53.0, 4.0), (28, 58.0, 4.0), (32, 57.0, 4.0), (36, 49.0, 4.0),\n    ],\n};\nconst SEVEN_8: Line = Line {\n    inst: Inst::Lead,\n    len: 28,\n    vel: 0.62,\n    notes: &[\n        (0, 74.0, 2.0), (2, 77.0, 2.0), (4, 81.0, 2.0), (6, 80.0, 2.0), (8, 77.0, 2.0), (10, 74.0, 2.0), (12, 73.0, 2.0),\n        (14, 74.0, 2.0), (16, 77.0, 2.0), (18, 82.0, 2.0), (20, 81.0, 2.0), (22, 77.0, 2.0), (24, 76.0, 2.0), (26, 73.0, 2.0),\n    ],\n};\nconst RESULTS_FANFARE: Line = Line {\n    inst: Inst::Brass,\n    len: 64,\n    vel: 0.8,\n    notes: &[\n        (0, 57.0, 2.0), (0, 64.0, 2.0), (2, 60.0, 2.0), (2, 69.0, 2.0), (4, 64.0, 4.0), (4, 72.0, 4.0),\n        (8, 62.0, 2.0), (8, 71.0, 2.0), (10, 64.0, 2.0), (10, 72.0, 2.0), (12, 65.0, 2.0), (12, 74.0, 2.0), (14, 67.0, 2.0), (14, 76.0, 2.0),\n        (16, 69.0, 8.0), (16, 72.0, 8.0), (16, 81.0, 8.0),\n    ],\n};\nconst RESULTS_PIANO: Line = Line {\n    inst: Inst::Piano,\n    len: 64,\n    vel: 0.65,\n    notes: &[\n        (24, 69.0, 2.0), (26, 72.0, 2.0), (28, 76.0, 2.0), (30, 81.0, 2.0), (32, 79.0, 4.0), (36, 77.0, 4.0),\n        (40, 76.0, 2.0), (42, 74.0, 2.0), (44, 72.0, 4.0), (48, 71.0, 4.0), (52, 72.0, 4.0), (56, 69.0, 8.0),\n    ],\n};\nconst DRIVE_BASS: Line = Line {\n    inst: Inst::Bass,\n    len: 32,\n    vel: 0.8,\n    notes: &[\n        (0, 45.0, 1.0), (2, 45.0, 1.0), (4, 45.0, 1.0), (6, 48.0, 1.0), (8, 45.0, 1.0), (10, 45.0, 1.0), (12, 43.0, 1.0), (14, 44.0, 1.0),\n        (16, 41.0, 1.0), (18, 41.0, 1.0), (20, 41.0, 1.0), (22, 44.0, 1.0), (24, 40.0, 1.0), (26, 40.0, 1.0), (28, 43.0, 1.0), (30, 44.0, 1.0),\n    ],\n};\nconst DRIVE_LEAD: Line = Line {\n    inst: Inst::Lead,\n    len: 64,\n    vel: 0.6,\n    notes: &[\n        (0, 69.0, 3.0), (3, 72.0, 3.0), (6, 76.0, 2.0), (8, 77.0, 3.0), (11, 76.0, 3.0), (14, 72.0, 2.0),\n        (16, 74.0, 3.0), (19, 72.0, 3.0), (22, 71.0, 2.0), (24, 68.0, 8.0),\n        (32, 69.0, 3.0), (35, 72.0, 3.0), (38, 76.0, 2.0), (40, 81.0, 3.0), (43, 79.0, 3.0), (46, 76.0, 2.0),\n        (48, 77.0, 3.0), (51, 76.0, 3.0), (54, 74.0, 2.0), (56, 76.0, 8.0),\n    ],\n};\nconst DRIVE_KICK: Line = Line { inst: Inst::Kick, len: 8, vel: 0.6, notes: &[(0, 0.0, 1.0), (4, 0.0, 1.0)] };\nconst DRIVE_HAT: Line = Line { inst: Inst::Hat, len: 2, vel: 0.4, notes: &[(1, 0.0, 1.0)] };\n\n/// A track's lines and its own tempo (None = the heart's).\nfn track_lines(name: &str) -> (&'static [&'static Line], Option<f32>) {\n    match name {\n        \"title\" => (&[&TITLE_MELODY, &TITLE_LEFT], Some(116.0)),\n        \"tender\" => (&[&TENDER_PAD, &TENDER_TUNE], Some(120.0)),\n        \"tense\" => (&[&TENSE_BASS, &TENSE_STRINGS, &TENSE_DROPS], Some(170.0)),\n        \"or\" => (&[&OR_PLUCK, &OR_PAD, &OR_TUNE], None),\n        \"codeblue\" => (&[&DRIVE_BASS, &DRIVE_LEAD, &DRIVE_KICK, &DRIVE_HAT, &OR_PAD], None),\n        \"results\" => (&[&RESULTS_FANFARE, &RESULTS_PIANO, &TENDER_PAD], Some(200.0)),\n        _ => (&[], None),\n    }\n}\n\n/// How the mix sits at its default level: music defaults to 10%, so the writing is forward.\nconst LOUD: f32 = 3.0;\n\n#[derive(Default)]\npub struct Sequencer {\n    track: String,\n    /// Grid position in steps, for tracks with their own tempo.\n    pos: f64,\n    /// Heart-driven position last scheduled.\n    sched: f64,\n    /// Step scheduled up to.\n    next_step: i64,\n    motif_step: i64,\n    last_hush: bool,\n    drone_t: f32,\n    last_beat: i64,\n}\n\nimpl Sequencer {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Runs one frame: appends notes due in the next moments as (patch, pan, gain, delay).\n    pub fn update(&mut self, dt: f32, m: &MusicInput, out: &mut Vec<(Patch, f32, f32, f32)>) {\n        const AHEAD: f64 = 0.28;\n        if m.track != self.track {\n            self.track = m.track.clone();\n            self.pos = 0.0;\n            self.next_step = i64::MIN;\n            self.motif_step = i64::MIN;\n            self.last_beat = i64::MIN;\n        }\n        let (lines, own_tempo) = track_lines(&self.track);\n        let mut notes: Vec<(Patch, f32, f32)> = Vec::new();\n        // The Hush: everything low, one held note and the heart.\n        let hush = m.hush > 0.5;\n        if hush {\n            self.drone_t -= dt;\n            if self.drone_t <= 0.0 {\n                self.drone_t = 2.4;\n                note(Inst::Pad, 57.0, 3.0, 1.2, &mut notes);\n                note(Inst::Bell, 81.0, 1.0, 0.14, &mut notes);\n                for (p, pan, g) in notes.drain(..) {\n                    out.push((p, pan, g * LOUD, 0.0));\n                }\n            }\n        } else {\n            self.drone_t = 0.0;\n        }\n        self.last_hush = hush;\n        if m.flat || (lines.is_empty() && m.motif == 0) {\n            return;\n        }\n        // Where we are on the grid, and how long a step is.\n        let (pos, step_secs) = match own_tempo {\n            Some(bpm) => {\n                self.pos += dt as f64 * bpm as f64 / 60.0;\n                (self.pos, 60.0 / bpm)\n            }\n            None => {\n                let bpm = m.bpm.max(30.0);\n                (m.heart * 4.0, 60.0 / bpm / 4.0)\n            }\n        };\n        if self.next_step == i64::MIN {\n            self.next_step = pos.ceil() as i64;\n        }\n        // A rewind or a jump in position: don't try to catch up.\n        if (self.next_step as f64 - pos).abs() > 64.0 {\n            self.next_step = pos.ceil() as i64;\n        }\n        let horizon = pos + AHEAD / step_secs as f64;\n        let quiet = if hush { 0.0 } else { 1.0 };\n        while (self.next_step as f64) < horizon {\n            let step = self.next_step;\n            let delay = ((step as f64 - pos) * step_secs as f64).max(0.0) as f32;\n            for line in lines {\n                let s = step.rem_euclid(line.len as i64) as u32;\n                for (at, midi, len) in line.notes {\n                    if *at == s {\n                        note(line.inst, *midi, *len * step_secs, line.vel * quiet, &mut notes);\n                    }\n                }\n            }\n            // The bass lands on the actual heartbeat.\n            if own_tempo.is_none() && step.rem_euclid(4) == 0 && self.track == \"or\" {\n                let bar = step.div_euclid(4).rem_euclid(8);\n                let root = [33.0, 33.0, 29.0, 29.0, 31.0, 31.0, 28.0, 28.0][bar as usize];\n                note(Inst::Bass, root + 12.0, step_secs * 1.6, if hush { 0.7 } else { 0.9 }, &mut notes);\n            }\n            // The crisis layer fades in as vitals fall.\n            if m.crisis > 0.02 && own_tempo.is_none() {\n                let s = step.rem_euclid(CRISIS_STRINGS.len as i64) as u32;\n                for (at, midi, len) in CRISIS_STRINGS.notes {\n                    if *at == s {\n                        note(Inst::Strings, *midi, *len * step_secs, 0.8 * m.crisis * quiet, &mut notes);\n                    }\n                }\n                if step.rem_euclid(2) == 0 {\n                    note(Inst::Hat, 0.0, 0.1, m.crisis * quiet, &mut notes);\n                }\n            }\n            // A strain's motif, in its own meter.\n            let motif = match m.motif {\n                3 => Some(&WALTZ_3_4),\n                6 => Some(&LULLABY_6_8),\n                5 => Some(&FIVE_4),\n                7 => Some(&SEVEN_8),\n                _ => None,\n            };\n            if let (Some(line), true) = (motif, own_tempo.is_none()) {\n                let s = step.rem_euclid(line.len as i64) as u32;\n                for (at, midi, len) in line.notes {\n                    if *at == s {\n                        note(line.inst, *midi, *len * step_secs, line.vel * quiet, &mut notes);\n                    }\n                }\n            }\n            for (p, pan, g) in notes.drain(..) {\n                if g > 0.001 {\n                    out.push((p, pan, g * LOUD, delay));\n                }\n            }\n            self.next_step += 1;\n        }\n    }\n}\n\n/// Renders a track offline for `secs`, on the music bus at unity: for tests.\npub fn render_track(track: &str, secs: f32, rate: f32) -> Vec<f32> {\n    let mut mixer = crate::Mixer::new(rate);\n    mixer.buses = [1.0, 1.0, 1.0];\n    let mut seq = Sequencer::new();\n    let frames = (secs * rate) as usize;\n    let mut out = vec![0.0f32; frames * 2];\n    let block = 512usize;\n    let dt = block as f32 / rate;\n    let mut notes = Vec::new();\n    let mut i = 0;\n    let mut heart = 0.0f64;\n    let mut buf = vec![0.0f32; block * 2];\n    while i < frames {\n        heart += dt as f64 * 80.0 / 60.0;\n        let m = MusicInput { track: track.to_string(), bpm: 80.0, heart, ..Default::default() };\n        notes.clear();\n        seq.update(dt, &m, &mut notes);\n        for (p, pan, g, d) in notes.drain(..) {\n            mixer.play_on(crate::BUS_MUSIC, p, pan, g, d);\n        }\n        let n = block.min(frames - i);\n        mixer.render(&mut buf[..n * 2]);\n        out[i * 2..(i + n) * 2].copy_from_slice(&buf[..n * 2]);\n        i += n;\n    }\n    out\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn peak(b: &[f32]) -> f32 {\n        b.iter().fold(0.0, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn every_track_renders_sound() {\n        for t in [\"title\", \"tender\", \"tense\", \"or\", \"codeblue\", \"results\"] {\n            let b = render_track(t, 6.0, 22050.0);\n            assert!(peak(&b) > 0.02, \"{t} is silent: {}\", peak(&b));\n        }\n    }\n\n    #[test]\n    fn the_motifs_play_in_their_own_meters() {\n        for meter in [3u8, 5, 6, 7] {\n            let mut seq = Sequencer::new();\n            let mut out = Vec::new();\n            let mut heart = 0.0;\n            for _ in 0..600 {\n                heart += 1.0 / 60.0 * 80.0 / 60.0;\n                let m = MusicInput { track: \"or\".into(), bpm: 80.0, heart, motif: meter, ..Default::default() };\n                seq.update(1.0 / 60.0, &m, &mut out);\n            }\n            let plain = {\n                let mut seq = Sequencer::new();\n                let mut o = Vec::new();\n                let mut heart = 0.0;\n                for _ in 0..600 {\n                    heart += 1.0 / 60.0 * 80.0 / 60.0;\n                    let m = MusicInput { track: \"or\".into(), bpm: 80.0, heart, ..Default::default() };\n                    seq.update(1.0 / 60.0, &m, &mut o);\n                }\n                o.len()\n            };\n            assert!(out.len() > plain, \"meter {meter} added no notes\");\n        }\n    }\n\n    #[test]\n    fn the_heart_sets_the_tempo_and_a_stopped_heart_stops_it() {\n        let count = |bpm: f32| {\n            let mut seq = Sequencer::new();\n            let mut out = Vec::new();\n            let mut heart = 0.0;\n            for _ in 0..1200 {\n                heart += 1.0 / 60.0 * bpm as f64 / 60.0;\n                let m = MusicInput { track: \"or\".into(), bpm, heart, ..Default::default() };\n                seq.update(1.0 / 60.0, &m, &mut out);\n            }\n            out.len()\n        };\n        assert!(count(140.0) > count(72.0), \"a faster heart plays faster\");\n        let mut seq = Sequencer::new();\n        let mut out = Vec::new();\n        seq.update(0.1, &MusicInput { track: \"or\".into(), bpm: 80.0, heart: 0.0, flat: true, ..Default::default() }, &mut out);\n        assert!(out.is_empty());\n    }\n}\nEOF\ncat >> crates/pav_audio/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod surgery_tests {\n    use super::*;\n    use pav_core::games::surgery::cue;\n\n    fn peak(b: &[f32]) -> f32 {\n        b.iter().fold(0.0, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn music_starts_at_ten_percent() {\n        assert_eq!(DEFAULT_BUSES[BUS_MUSIC], 0.10);\n        assert_eq!(Mixer::new(48000.0).buses[BUS_MUSIC], 0.10);\n    }\n\n    #[test]\n    fn every_cue_renders_non_silent() {\n        for (id, name) in cue::ALL {\n            let mut m = Mixer::new(22050.0);\n            for (p, d) in cues::sound(*id, 1.0, 1.0) {\n                m.play(p, 0.0, 1.0, d);\n            }\n            let mut b = vec![0.0; 22050 * 2];\n            m.render(&mut b);\n            assert!(peak(&b) > 0.005, \"cue {name} is silent: {}\", peak(&b));\n        }\n    }\n\n    #[test]\n    fn every_vowel_of_every_voice_renders_non_silent() {\n        for wave in [Wave::Square, Wave::Saw, Wave::Triangle] {\n            for v in ['a', 'e', 'i', 'o', 'u'] {\n                let def = voice::VoiceDef { pitch: 300.0, wave, pace: 0.07, jitter: 1.0 };\n                let mut m = Mixer::new(22050.0);\n                m.play_on(BUS_VOICES, voice::blip(&def, v, 0.0, 1), 0.0, 1.0, 0.0);\n                let mut b = vec![0.0; 4410 * 2];\n                m.render(&mut b);\n                assert!(peak(&b) > 0.005, \"{wave:?} {v}: {}\", peak(&b));\n                assert!(m.peaks[BUS_VOICES] >= 0.0);\n            }\n        }\n    }\n\n    #[test]\n    fn speech_inflects_at_the_ends_of_sentences() {\n        let s = voice::syllables(\"Is it now? It is now.\");\n        assert!(s.len() >= 6);\n        assert!(s.iter().any(|x| x.2 > 0.0), \"rising at the question\");\n        assert!(s.iter().any(|x| x.2 < 0.0), \"falling at the stop\");\n    }\n\n    #[test]\n    fn the_buses_scale_only_their_own_voices() {\n        let render = |bus: usize, gain: f32| {\n            let mut m = Mixer::new(22050.0);\n            m.buses = [1.0, 1.0, 1.0];\n            m.buses[bus] = gain;\n            m.play_on(BUS_MUSIC, Patch { decay: 0.2, volume: 0.3, ..Patch::new(Wave::Sine, 440.0) }, 0.0, 1.0, 0.0);\n            let mut b = vec![0.0; 4410 * 2];\n            m.render(&mut b);\n            peak(&b)\n        };\n        assert!(render(BUS_MUSIC, 0.1) < render(BUS_MUSIC, 1.0) * 0.3);\n        assert_eq!(render(BUS_VOICES, 0.0), render(BUS_EFFECTS, 0.0));\n    }\n}\nEOF\nCARGO_BUILD_JOBS=10 timeout 500 cargo test --offline -p pav_audio 2>&1 | grep -E \"^error|^warning: unused|^ +--> |^test .*FAILED|panicked|test result\" -A2 | head -50","description":"Add audio buses, cue table, voices and the music sequencer, then test","timeout":560000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":612,"cache_read_input_tokens":612388,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":612},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"092dc2e9-85ec-49f9-8a5e-82413bbc454c","uuid":"9a9623e8-6bb3-456c-ad5a-67758575e122","timestamp":"2026-11-05T14:30:05.409Z","request_id":"req_011CgjwHX323n5bpLJaJmYbj","wire_tool_inputs":{"toolu_01SJ22eExVDeXSqLD8S8gsXj":{"command":"python3 - <<'EOF'\np='crates/pav_audio/src/lib.rs'\ns=open(p).read()\ns=s.replace('''use std::sync::mpsc::{Receiver, Sender, channel};\n''','''pub mod cues;\npub mod music;\npub mod voice;\n\nuse std::sync::Arc;\nuse std::sync::atomic::{AtomicU32, Ordering};\nuse std::sync::mpsc::{Receiver, Sender, channel};\n''')\ns=s.replace('''    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n''','''    /// Square-wave duty cycle.\n    pub duty: f32,\n    /// Two resonant band-pass formants: frequency (Hz, 0 = off) and Q. Used for voices.\n    pub formants: [(f32, f32); 2],\n    /// Vibrato: depth in cents and rate in Hz (strings, the sustained note).\n    pub vibrato: (f32, f32),\n}\n''')\ns=s.replace('''            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }''','''            cutoff_end: 12000.0,\n            duty: 0.5,\n            formants: [(0.0, 1.0), (0.0, 1.0)],\n            vibrato: (0.0, 0.0),\n        }\n    }''')\ns=s.replace('''    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n''','''    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n    bus: usize,\n    /// Formant filter state: (low, band) per formant.\n    svf: [(f32, f32); 2],\n}\n''')\ns=s.replace('''        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n''','''        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let mut freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        if p.vibrato.0 > 0.0 {\n            let v = (self.t * p.vibrato.1 * std::f32::consts::TAU).sin() * p.vibrato.0 / 1200.0;\n            freq *= 2f32.powf(v);\n        }\n''')\ns=s.replace('''        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n''','''        self.lp += (raw - self.lp) * a;\n        let mut out = self.lp;\n        if p.formants[0].0 > 0.0 {\n            // Chamberlin state-variable band-passes: the vowel.\n            let mut sum = 0.0;\n            for (i, (fc, q)) in p.formants.iter().enumerate() {\n                if *fc <= 0.0 {\n                    continue;\n                }\n                let f = (2.0 * (std::f32::consts::PI * (*fc).min(0.2 / dt) * dt).sin()).min(1.2);\n                let (low, band) = &mut self.svf[i];\n                *low += f * *band;\n                let high = self.lp - *low - *band / q.max(0.5);\n                *band += f * high;\n                sum += *band;\n            }\n            out = sum * 0.5;\n        }\n        let s = out * self.env() * p.volume;\n        self.t += dt;\n        s\n''')\ns=s.replace('''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n''','''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    /// Bus gains: music, effects, voices.\n    pub buses: [f32; 3],\n    /// The loudest sample each bus put out in the last block, before its gain.\n    pub peaks: [f32; 3],\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 320;\n\n/// The buses.\npub const BUS_MUSIC: usize = 0;\npub const BUS_EFFECTS: usize = 1;\npub const BUS_VOICES: usize = 2;\n/// Music starts at 10%, effects at 80%, voices at 70%.\npub const DEFAULT_BUSES: [f32; 3] = [0.10, 0.80, 0.70];\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, buses: DEFAULT_BUSES, peaks: [0.0; 3], seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds. On the effects bus.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        self.play_on(BUS_EFFECTS, p, pan, gain, delay);\n    }\n\n    /// Plays on a bus.\n    pub fn play_on(&mut self, bus: usize, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n''')\ns=s.replace('''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n''','''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n            bus: bus.min(2),\n            svf: [(0.0, 0.0); 2],\n        });\n    }\n''')\ns=s.replace('''        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n''','''        self.peaks = [0.0; 3];\n        for frame in out.chunks_mut(2) {\n            let mut bl = [0.0f32; 3];\n            let mut br = [0.0f32; 3];\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                bl[v.bus] += s * v.gain_l;\n                br[v.bus] += s * v.gain_r;\n            }\n            let (mut l, mut r) = (0.0, 0.0);\n            for b in 0..3 {\n                self.peaks[b] = self.peaks[b].max(bl[b].abs()).max(br[b].abs());\n                l += bl[b] * self.buses[b];\n                r += br[b] * self.buses[b];\n            }\n            // Soft clip.\n            let m = self.master;\n''')\ns=s.replace('''        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).''','''        SimEvent::Cue { id, gain, pitch, .. } => cues::sound(*id, *gain, *pitch),\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).''')\ns=s.replace('''        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),''','''        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Cue { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),''')\ns=s.replace('''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n''','''enum Cmd {\n    Play(usize, Patch, f32, f32, f32),\n    Master(f32),\n    Bus(usize, f32),\n    Silence,\n}\n\n/// What the callback last did, for the test hook and the meters.\n#[derive(Default)]\npub struct Meters {\n    pub peaks: [AtomicU32; 3],\n    pub out: AtomicU32,\n    pub gains: [AtomicU32; 3],\n}\n''')\ns=s.replace('''pub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n''','''pub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n    pub meters: Arc<Meters>,\n}\n''')\ns=s.replace('''        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n''','''        let (tx, rx) = channel::<Cmd>();\n        let meters = Arc::new(Meters::default());\n        for b in 0..3 {\n            meters.gains[b].store(DEFAULT_BUSES[b].to_bits(), Ordering::Relaxed);\n        }\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, meters.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, meters.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, meters.clone())?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, meters })\n    }\n\n    /// Plays a patch on a bus.\n    pub fn play_on(&self, bus: usize, p: Patch, pan: f32, gain: f32, delay: f32) {\n        let _ = self.tx.send(Cmd::Play(bus, p, pan, gain, delay));\n    }\n\n    /// Sets a bus's gain.\n    pub fn set_bus(&self, bus: usize, gain: f32) {\n        self.meters.gains[bus.min(2)].store(gain.to_bits(), Ordering::Relaxed);\n        let _ = self.tx.send(Cmd::Bus(bus, gain));\n    }\n\n    /// Stops everything now (a round's end).\n    pub fn silence(&self) {\n        let _ = self.tx.send(Cmd::Silence);\n    }\n\n    /// A bus's gain, as the mixer has it.\n    pub fn bus_gain(&self, bus: usize) -> f32 {\n        f32::from_bits(self.meters.gains[bus.min(2)].load(Ordering::Relaxed))\n    }\n\n    pub fn peak(&self, bus: usize) -> f32 {\n        f32::from_bits(self.meters.peaks[bus.min(2)].load(Ordering::Relaxed))\n    }\n''')\ns=s.replace('''            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));''','''            let _ = self.tx.send(Cmd::Play(BUS_EFFECTS, patch, pan, gain * sfx, delay));''')\ns=s.replace('''fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\n''','''fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize, meters: Arc<Meters>) -> anyhow::Result<cpal::Stream>\n''')\ns=s.replace('''                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n''','''                    Cmd::Play(bus, p, pan, gain, delay) => mixer.play_on(bus, p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Bus(b, v) => mixer.buses[b.min(2)] = v,\n                    Cmd::Silence => mixer.clear(),\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for b in 0..3 {\n                meters.peaks[b].store(mixer.peaks[b].to_bits(), Ordering::Relaxed);\n            }\n            let out = buf.iter().fold(0.0f32, |m, s| m.max(s.abs()));\n            meters.out.store(out.to_bits(), Ordering::Relaxed);\n''')\ns=s.replace('''    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n''','''    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n\n    /// Stops every voice.\n    pub fn clear(&mut self) {\n        self.voices.clear();\n    }\n''')\nopen(p,'w').write(s)\nEOF\ncat > crates/pav_audio/src/cues.rs <<'EOF'\n//! The cue table: about forty sounds the surgery game names by id (`pav_core::games::surgery::cue`).\n\nuse pav_core::games::surgery::cue;\n\nuse crate::{Patch, Wave};\n\n/// A cue's patches and delays.\npub fn sound(id: u16, gain: f32, pitch: f32) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    let g = gain.max(0.0);\n    let f = |hz: f32| hz * pitch.max(0.05);\n    let n = |attack: f32, decay: f32, vol: f32, c0: f32, c1: f32| Patch {\n        attack,\n        decay,\n        volume: vol * g,\n        cutoff: c0,\n        cutoff_end: c1,\n        ..Patch::new(Noise, 1.0)\n    };\n    let t = |w: Wave, hz: f32, decay: f32, vol: f32| Patch { decay, volume: vol * g, ..Patch::new(w, f(hz)) };\n    match id {\n        cue::PICK => vec![\n            (Patch { decay: 0.03, volume: 0.1 * g, cutoff: 7000.0, ..Patch::new(Square, f(2400.0)) }, 0.0),\n            (Patch { decay: 0.06, volume: 0.08 * g, ..Patch::new(Triangle, f(3600.0)) }, 0.012),\n        ],\n        cue::SLICE => vec![(n(0.005, 0.12, 0.2, 7000.0, 2500.0), 0.0), (Patch { freq_end: f(900.0), glide: 0.1, decay: 0.1, volume: 0.05 * g, ..Patch::new(Sine, f(2400.0)) }, 0.0)],\n        cue::SQUISH => vec![(n(0.01, 0.16, 0.3, 900.0, 240.0), 0.0), (Patch { freq_end: f(70.0), glide: 0.14, decay: 0.16, volume: 0.2 * g, ..Patch::new(Sine, f(190.0)) }, 0.0)],\n        cue::GRAB => vec![(t(Square, 1500.0, 0.03, 0.09), 0.0), (t(Triangle, 950.0, 0.05, 0.1), 0.02)],\n        cue::POP => vec![(Patch { freq_end: f(900.0), glide: 0.05, decay: 0.08, volume: 0.24 * g, ..Patch::new(Sine, f(240.0)) }, 0.0), (n(0.002, 0.05, 0.12, 2800.0, 900.0), 0.0)],\n        cue::ZIP => vec![(Patch { attack: 0.004, decay: 0.05, volume: 0.12 * g, cutoff: 5000.0, cutoff_end: 1800.0, freq_end: f(2400.0), glide: 0.05, ..Patch::new(Saw, f(900.0)) }, 0.0)],\n        cue::GURGLE => vec![\n            (Patch { freq_end: f(160.0), glide: 0.1, attack: 0.01, decay: 0.11, volume: 0.14 * g, cutoff: 1200.0, ..Patch::new(Sine, f(260.0)) }, 0.0),\n            (n(0.01, 0.1, 0.1, 900.0, 300.0), 0.02),\n            (Patch { freq_end: f(220.0), glide: 0.06, decay: 0.07, volume: 0.1 * g, ..Patch::new(Sine, f(340.0)) }, 0.07),\n        ],\n        cue::LASER => vec![(Patch { attack: 0.02, decay: 0.3, sustain: 0.5, hold: 0.4, release: 0.2, volume: 0.09 * g, duty: 0.3, cutoff: 3000.0, ..Patch::new(Square, f(420.0)) }, 0.0), (Patch { attack: 0.02, decay: 0.5, volume: 0.05 * g, ..Patch::new(Sine, f(1680.0)) }, 0.0)],\n        cue::SIZZLE => vec![(n(0.005, 0.3, 0.22, 9000.0, 3000.0), 0.0), (t(Sine, 1760.0, 0.1, 0.08), 0.0)],\n        cue::GEL => vec![(Patch { attack: 0.015, decay: 0.16, volume: 0.1 * g, cutoff: 1400.0, cutoff_end: 2600.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        cue::IV => vec![(Patch { attack: 0.03, decay: 0.3, volume: 0.09 * g, cutoff: 3800.0, cutoff_end: 6500.0, ..Patch::new(Noise, 1.0) }, 0.0), (Patch { freq_end: f(990.0), glide: 0.25, decay: 0.26, volume: 0.05 * g, ..Patch::new(Sine, f(660.0)) }, 0.0)],\n        cue::PING => vec![(Patch { freq_end: f(1320.0), glide: 0.03, decay: 0.26, volume: 0.13 * g, ..Patch::new(Sine, f(1760.0)) }, 0.0), (Patch { decay: 0.18, volume: 0.04 * g, ..Patch::new(Sine, f(1760.0)) }, 0.14)],\n        cue::DEFIB_WHINE => vec![(Patch { attack: 0.05, freq_end: f(2600.0), glide: 1.2, decay: 1.2, sustain: 0.6, hold: 0.2, release: 0.1, volume: 0.09 * g, cutoff: 6000.0, ..Patch::new(Saw, f(300.0)) }, 0.0)],\n        cue::DEFIB_THUMP => vec![(Patch { freq_end: f(30.0), glide: 0.2, decay: 0.42, volume: 0.9 * g, ..Patch::new(Sine, f(120.0)) }, 0.0), (n(0.002, 0.22, 0.5, 3800.0, 200.0), 0.0)],\n        cue::LUB => vec![\n            (Patch { freq_end: f(42.0), glide: 0.1, decay: 0.13, volume: 0.42 * g, cutoff: 400.0, ..Patch::new(Sine, f(78.0)) }, 0.0),\n            (Patch { freq_end: f(50.0), glide: 0.08, decay: 0.1, volume: 0.3 * g, cutoff: 500.0, ..Patch::new(Sine, f(92.0)) }, 0.17),\n        ],\n        cue::BEEP => vec![(t(Sine, 1046.5, 0.08, 0.1), 0.0)],\n        cue::ALARM => vec![(t(Square, 880.0, 0.14, 0.1), 0.0), (t(Square, 660.0, 0.14, 0.1), 0.17), (t(Square, 880.0, 0.14, 0.1), 0.34)],\n        cue::IMMACULATE => vec![(t(Triangle, 1318.5, 0.12, 0.16), 0.0), (t(Triangle, 1760.0, 0.14, 0.16), 0.06), (t(Triangle, 2637.0, 0.3, 0.14), 0.12)],\n        cue::CLEAN => vec![(t(Triangle, 1046.5, 0.1, 0.14), 0.0), (t(Triangle, 1568.0, 0.18, 0.13), 0.06)],\n        cue::GOOD => vec![(t(Triangle, 784.0, 0.13, 0.11), 0.0)],\n        cue::SLOPPY => vec![(Patch { freq_end: f(180.0), glide: 0.2, decay: 0.22, volume: 0.13 * g, duty: 0.3, ..Patch::new(Square, f(300.0)) }, 0.0)],\n        cue::CHAIN => vec![(t(Triangle, 1760.0, 0.1, 0.13), 0.0), (t(Triangle, 2093.0, 0.1, 0.13), 0.05), (t(Triangle, 2637.0, 0.1, 0.13), 0.1), (t(Sine, 3520.0, 0.24, 0.1), 0.15)],\n        cue::ON_BEAT => vec![(t(Sine, 2093.0, 0.1, 0.12), 0.0)],\n        cue::STINGER => vec![\n            (Patch { attack: 0.01, decay: 0.7, volume: 0.22 * g, cutoff: 2200.0, cutoff_end: 500.0, ..Patch::new(Saw, f(110.0)) }, 0.0),\n            (Patch { attack: 0.01, decay: 0.7, volume: 0.18 * g, cutoff: 2200.0, cutoff_end: 500.0, ..Patch::new(Saw, f(116.5)) }, 0.0),\n            (Patch { attack: 0.01, decay: 0.6, volume: 0.12 * g, cutoff: 3000.0, ..Patch::new(Saw, f(622.3)) }, 0.0),\n        ],\n        cue::BURST => vec![(n(0.002, 0.24, 0.42, 2600.0, 280.0), 0.0), (Patch { freq_end: f(60.0), glide: 0.14, decay: 0.2, volume: 0.36 * g, ..Patch::new(Sine, f(220.0)) }, 0.0)],\n        cue::NAV => vec![(Patch { decay: 0.04, volume: 0.09 * g, cutoff: 6000.0, ..Patch::new(Triangle, f(1400.0)) }, 0.0)],\n        cue::CONFIRM => vec![(t(Triangle, 880.0, 0.08, 0.14), 0.0), (t(Triangle, 1318.5, 0.14, 0.14), 0.06)],\n        cue::BACK => vec![(t(Triangle, 880.0, 0.07, 0.11), 0.0), (t(Triangle, 587.0, 0.1, 0.11), 0.05)],\n        cue::BANNER => vec![(Patch { freq_end: f(55.0), glide: 0.2, decay: 0.4, volume: 0.42 * g, ..Patch::new(Sine, f(130.0)) }, 0.0), (t(Saw, 220.0, 0.3, 0.06), 0.0)],\n        cue::FLATLINE => vec![(Patch { attack: 0.01, decay: 0.1, sustain: 0.8, hold: 2.2, release: 0.4, volume: 0.13 * g, ..Patch::new(Sine, f(987.8)) }, 0.0)],\n        cue::CLINK => vec![(t(Square, 2600.0, 0.03, 0.12), 0.0), (t(Triangle, 3400.0, 0.1, 0.11), 0.015), (n(0.002, 0.03, 0.1, 9000.0, 5000.0), 0.0)],\n        cue::FROST => vec![(n(0.02, 0.36, 0.13, 8000.0, 6000.0), 0.0), (t(Sine, 3136.0, 0.3, 0.05), 0.04)],\n        cue::SCORCH => vec![(n(0.005, 0.5, 0.34, 6000.0, 700.0), 0.0), (Patch { freq_end: f(70.0), glide: 0.3, decay: 0.3, volume: 0.2 * g, ..Patch::new(Saw, f(180.0)) }, 0.0)],\n        cue::SNAP => vec![(n(0.001, 0.03, 0.34, 9000.0, 3000.0), 0.0), (t(Sine, 1200.0, 0.05, 0.14), 0.0)],\n        cue::RIPPLE => vec![(Patch { attack: 0.03, freq_end: f(220.0), glide: 0.3, decay: 0.34, volume: 0.13 * g, ..Patch::new(Sine, f(420.0)) }, 0.0)],\n        cue::GIFT_READY => vec![(t(Sine, 1318.5, 0.3, 0.1), 0.0), (t(Sine, 1760.0, 0.3, 0.1), 0.1), (t(Sine, 2637.0, 0.6, 0.1), 0.2)],\n        cue::GIFT_FIRE => vec![\n            (Patch { attack: 0.01, freq_end: f(55.0), glide: 0.5, decay: 0.9, volume: 0.42 * g, ..Patch::new(Sine, f(330.0)) }, 0.0),\n            (Patch { attack: 0.05, decay: 1.2, volume: 0.13 * g, ..Patch::new(Sine, f(1760.0)) }, 0.05),\n            (Patch { attack: 0.05, decay: 1.2, volume: 0.1 * g, ..Patch::new(Sine, f(2637.0)) }, 0.1),\n        ],\n        cue::RING => vec![(Patch { attack: 0.05, freq_end: f(900.0), glide: 0.6, decay: 0.7, volume: 0.16 * g, cutoff: 5000.0, ..Patch::new(Saw, f(120.0)) }, 0.0), (n(0.1, 0.5, 0.16, 3000.0, 800.0), 0.0)],\n        cue::TICK => vec![(t(Square, 1760.0, 0.03, 0.14), 0.0)],\n        cue::SPURT => vec![(n(0.005, 0.1, 0.18, 1600.0, 500.0), 0.0)],\n        cue::TEAR => vec![(n(0.003, 0.18, 0.3, 3200.0, 700.0), 0.0), (Patch { freq_end: f(110.0), glide: 0.14, decay: 0.16, volume: 0.15 * g, duty: 0.3, ..Patch::new(Square, f(320.0)) }, 0.0)],\n        cue::THUNDER => vec![(n(0.02, 1.6, 0.42, 700.0, 90.0), 0.0), (Patch { freq_end: f(30.0), glide: 1.0, decay: 1.2, volume: 0.42 * g, ..Patch::new(Sine, f(70.0)) }, 0.05)],\n        cue::STAMP => vec![(Patch { freq_end: f(50.0), glide: 0.08, decay: 0.2, volume: 0.62 * g, ..Patch::new(Sine, f(180.0)) }, 0.0), (n(0.001, 0.08, 0.34, 3400.0, 600.0), 0.0)],\n        _ => Vec::new(),\n    }\n}\nEOF\ncat > crates/pav_audio/src/voice.rs <<'EOF'\n//! Animalese-style voices: each syllable of the text is a short pitched blip through two resonant\n//! formant filters chosen from the vowel. Per-character base pitch, waveform and speed; falling\n//! pitch at full stops, rising at question marks.\n\nuse crate::{Patch, Wave};\n\n/// How a character sounds.\n#[derive(Clone, Copy, Debug)]\npub struct VoiceDef {\n    pub pitch: f32,\n    pub wave: Wave,\n    pub pace: f32,\n    /// Random wobble, in semitones.\n    pub jitter: f32,\n}\n\npub fn wave_named(s: &str) -> Wave {\n    match s {\n        \"square\" => Wave::Square,\n        \"saw\" => Wave::Saw,\n        \"sine\" => Wave::Sine,\n        _ => Wave::Triangle,\n    }\n}\n\nfn formants(v: char) -> [(f32, f32); 2] {\n    match v {\n        'a' => [(800.0, 7.0), (1250.0, 8.0)],\n        'e' => [(520.0, 7.0), (1900.0, 9.0)],\n        'i' => [(320.0, 7.0), (2300.0, 10.0)],\n        'o' => [(520.0, 7.0), (900.0, 8.0)],\n        'u' => [(340.0, 7.0), (800.0, 8.0)],\n        _ => [(500.0, 6.0), (1500.0, 7.0)],\n    }\n}\n\nfn is_vowel(c: char) -> bool {\n    matches!(c, 'a' | 'e' | 'i' | 'o' | 'u' | 'y')\n}\n\n/// The syllables of a text: (character index, vowel, inflection).\npub fn syllables(text: &str) -> Vec<(usize, char, f32)> {\n    let chars: Vec<char> = text.chars().map(|c| c.to_ascii_lowercase()).collect();\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < chars.len() {\n        if is_vowel(chars[i]) {\n            let at = i;\n            let v = chars[i];\n            while i < chars.len() && is_vowel(chars[i]) {\n                i += 1;\n            }\n            // How the sentence turns: look ahead to its end.\n            let mut j = i;\n            while j < chars.len() && !matches!(chars[j], '.' | '?' | '!') {\n                j += 1;\n            }\n            let near = j.saturating_sub(i) < 7;\n            let turn = if near {\n                match chars.get(j) {\n                    Some('.') => -2.5,\n                    Some('?') => 3.0,\n                    Some('!') => 1.2,\n                    _ => 0.0,\n                }\n            } else {\n                0.0\n            };\n            out.push((at, v, turn));\n        } else {\n            i += 1;\n        }\n    }\n    out\n}\n\nfn hash(x: usize) -> f32 {\n    let n = (x as u32).wrapping_mul(2_654_435_761);\n    ((n >> 16) & 0xffff) as f32 / 65535.0\n}\n\n/// The blip for one syllable.\npub fn blip(v: &VoiceDef, vowel: char, turn: f32, seed: usize) -> Patch {\n    let wob = (hash(seed) - 0.5) * 2.0 * (v.jitter + 0.5);\n    let semis = wob + turn;\n    let freq = v.pitch * 2f32.powf(semis / 12.0);\n    Patch {\n        attack: 0.006,\n        decay: 0.05,\n        sustain: 0.35,\n        hold: 0.012,\n        release: 0.02,\n        volume: 0.75,\n        duty: 0.34,\n        cutoff: 7000.0,\n        cutoff_end: 5000.0,\n        formants: formants(vowel),\n        ..Patch::new(v.wave, freq)\n    }\n}\n\n/// Follows a line as it reveals and says the syllables it passes.\n#[derive(Default)]\npub struct Speaker {\n    serial: u64,\n    said: usize,\n    syl: Vec<(usize, char, f32)>,\n    last_at: f32,\n}\n\nimpl Speaker {\n    /// New text starts over. `shown` is how many characters are on screen; returns blips due.\n    pub fn update(&mut self, serial: u64, text: &str, shown: usize, now: f32, v: &VoiceDef, out: &mut Vec<Patch>) {\n        if serial != self.serial {\n            self.serial = serial;\n            self.said = 0;\n            self.syl = syllables(text);\n        }\n        while self.said < self.syl.len() && self.syl[self.said].0 < shown {\n            let (at, vowel, turn) = self.syl[self.said];\n            self.said += 1;\n            // Pace: a typed-through line doesn't machine-gun.\n            if now - self.last_at >= v.pace * 0.7 {\n                self.last_at = now;\n                out.push(blip(v, vowel, turn, at + serial as usize * 31));\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_audio/src/music.rs <<'EOF'\n//! A small note-event sequencer: it runs on the render thread and schedules ahead with `play`'s\n//! delay, so tempo can follow the heart. Composed in code: title theme, two story beds, the OR loop\n//! whose bass lands on the actual heartbeat, a crisis layer, a motif per strain in its own meter,\n//! the Hush, the results fanfare, Code Blue's drive.\n\nuse crate::{Patch, Wave};\n\n/// What the game wants from the music this frame.\n#[derive(Clone, Debug, Default)]\npub struct MusicInput {\n    pub track: String,\n    pub bpm: f32,\n    /// Heart position: beats so far plus the phase.\n    pub heart: f64,\n    pub crisis: f32,\n    pub hush: f32,\n    pub motif: u8,\n    pub flat: bool,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Inst {\n    Piano,\n    Bass,\n    Pad,\n    Pluck,\n    Strings,\n    Bell,\n    Kick,\n    Hat,\n    Brass,\n    Lead,\n}\n\nfn hz(midi: f32) -> f32 {\n    440.0 * 2f32.powf((midi - 69.0) / 12.0)\n}\n\n/// A note as patches: (patch, pan, gain).\nfn note(inst: Inst, midi: f32, secs: f32, vel: f32, out: &mut Vec<(Patch, f32, f32)>) {\n    let f = hz(midi);\n    match inst {\n        Inst::Piano => {\n            out.push((Patch { attack: 0.004, decay: 0.5 + secs * 0.6, sustain: 0.0, volume: 0.36, cutoff: 3200.0, cutoff_end: 900.0, ..Patch::new(Wave::Triangle, f) }, -0.1, vel));\n            out.push((Patch { attack: 0.003, decay: 0.22, volume: 0.12, ..Patch::new(Wave::Sine, f * 2.0) }, 0.05, vel));\n            out.push((Patch { attack: 0.002, decay: 0.08, volume: 0.05, cutoff: 5000.0, ..Patch::new(Wave::Square, f * 3.0) }, 0.0, vel));\n        }\n        Inst::Bass => {\n            out.push((Patch { attack: 0.008, decay: secs.max(0.12), sustain: 0.0, volume: 0.6, ..Patch::new(Wave::Sine, f) }, 0.0, vel));\n            out.push((Patch { attack: 0.006, decay: secs.max(0.1) * 0.7, volume: 0.22, cutoff: 700.0, cutoff_end: 260.0, ..Patch::new(Wave::Saw, f) }, 0.0, vel));\n        }\n        Inst::Pad => {\n            let rel = (secs * 0.4).clamp(0.3, 1.6);\n            for (d, pan) in [(0.997, -0.5), (1.003, 0.5)] {\n                out.push((Patch { attack: (secs * 0.3).clamp(0.08, 1.2), decay: 0.2, sustain: 0.8, hold: secs * 0.6, release: rel, volume: 0.13, cutoff: 1100.0, cutoff_end: 800.0, vibrato: (6.0, 4.3), ..Patch::new(Wave::Saw, f * d) }, pan, vel));\n            }\n        }\n        Inst::Strings => {\n            for (d, pan) in [(0.996, -0.3), (1.004, 0.3)] {\n                out.push((Patch { attack: 0.03, decay: 0.05, sustain: 0.9, hold: secs * 0.8, release: 0.08, volume: 0.1, cutoff: 2600.0, vibrato: (12.0, 5.6), ..Patch::new(Wave::Saw, f * d) }, pan, vel));\n            }\n        }\n        Inst::Pluck => out.push((Patch { attack: 0.002, decay: 0.16, volume: 0.22, duty: 0.3, cutoff: 3200.0, cutoff_end: 700.0, ..Patch::new(Wave::Square, f) }, 0.25, vel)),\n        Inst::Bell => out.push((Patch { attack: 0.002, decay: 0.9, volume: 0.22, ..Patch::new(Wave::Sine, f) }, -0.2, vel)),\n        Inst::Kick => out.push((Patch { freq_end: 42.0, glide: 0.09, decay: 0.14, volume: 0.7, ..Patch::new(Wave::Sine, 130.0) }, 0.0, vel)),\n        Inst::Hat => out.push((Patch { decay: 0.035, volume: 0.1, cutoff: 12000.0, cutoff_end: 7000.0, ..Patch::new(Wave::Noise, 1.0) }, 0.3, vel)),\n        Inst::Brass => {\n            for d in [0.998, 1.002] {\n                out.push((Patch { attack: 0.03, decay: 0.15, sustain: 0.7, hold: secs * 0.7, release: 0.12, volume: 0.17, cutoff: 800.0, cutoff_end: 2600.0, ..Patch::new(Wave::Saw, f * d) }, 0.0, vel));\n            }\n        }\n        Inst::Lead => out.push((Patch { attack: 0.02, decay: 0.2, sustain: 0.6, hold: secs * 0.7, release: 0.16, volume: 0.17, cutoff: 2400.0, vibrato: (10.0, 5.0), ..Patch::new(Wave::Triangle, f) }, 0.15, vel)),\n    }\n}\n\n/// A melody, written as (step, midi, steps long), on a grid of `len` steps.\nstruct Line {\n    inst: Inst,\n    len: u32,\n    notes: &'static [(u32, f32, f32)],\n    vel: f32,\n}\n\n// A minor. A tune you could hum: the title theme, in 16 bars of 8 steps (eighth notes at 58 bpm).\nconst TITLE_MELODY: Line = Line {\n    inst: Inst::Piano,\n    len: 128,\n    vel: 1.0,\n    notes: &[\n        (0, 76.0, 3.0), (3, 72.0, 1.0), (4, 74.0, 2.0), (6, 71.0, 2.0),\n        (8, 72.0, 3.0), (11, 69.0, 1.0), (12, 69.0, 4.0),\n        (16, 77.0, 3.0), (19, 76.0, 1.0), (20, 74.0, 2.0), (22, 72.0, 2.0),\n        (24, 71.0, 3.0), (27, 74.0, 1.0), (28, 76.0, 4.0),\n        (32, 76.0, 3.0), (35, 72.0, 1.0), (36, 74.0, 2.0), (38, 71.0, 2.0),\n        (40, 72.0, 2.0), (42, 71.0, 1.0), (43, 69.0, 1.0), (44, 67.0, 4.0),\n        (48, 65.0, 2.0), (50, 69.0, 2.0), (52, 72.0, 2.0), (54, 77.0, 2.0),\n        (56, 76.0, 3.0), (59, 74.0, 1.0), (60, 76.0, 4.0),\n        (64, 81.0, 3.0), (67, 79.0, 1.0), (68, 77.0, 2.0), (70, 76.0, 2.0),\n        (72, 74.0, 3.0), (75, 72.0, 1.0), (76, 71.0, 4.0),\n        (80, 72.0, 2.0), (82, 74.0, 2.0), (84, 76.0, 2.0), (86, 77.0, 2.0),\n        (88, 79.0, 3.0), (91, 76.0, 1.0), (92, 72.0, 4.0),\n        (96, 74.0, 3.0), (99, 72.0, 1.0), (100, 71.0, 2.0), (102, 69.0, 2.0),\n        (104, 68.0, 3.0), (107, 71.0, 1.0), (108, 76.0, 4.0),\n        (112, 72.0, 2.0), (114, 71.0, 2.0), (116, 69.0, 4.0),\n        (120, 69.0, 8.0),\n    ],\n};\nconst TITLE_LEFT: Line = Line {\n    inst: Inst::Piano,\n    len: 64,\n    vel: 0.55,\n    notes: &[\n        (0, 45.0, 2.0), (2, 52.0, 2.0), (4, 57.0, 2.0), (6, 60.0, 2.0),\n        (8, 41.0, 2.0), (10, 48.0, 2.0), (12, 53.0, 2.0), (14, 57.0, 2.0),\n        (16, 38.0, 2.0), (18, 45.0, 2.0), (20, 50.0, 2.0), (22, 53.0, 2.0),\n        (24, 40.0, 2.0), (26, 47.0, 2.0), (28, 52.0, 2.0), (30, 56.0, 2.0),\n        (32, 45.0, 2.0), (34, 52.0, 2.0), (36, 57.0, 2.0), (38, 60.0, 2.0),\n        (40, 43.0, 2.0), (42, 50.0, 2.0), (44, 55.0, 2.0), (46, 59.0, 2.0),\n        (48, 41.0, 2.0), (50, 48.0, 2.0), (52, 53.0, 2.0), (54, 57.0, 2.0),\n        (56, 40.0, 2.0), (58, 47.0, 2.0), (60, 52.0, 2.0), (62, 56.0, 2.0),\n    ],\n};\nconst TENDER_PAD: Line = Line {\n    inst: Inst::Pad,\n    len: 64,\n    vel: 1.0,\n    notes: &[\n        (0, 53.0, 16.0), (0, 60.0, 16.0), (0, 65.0, 16.0),\n        (16, 50.0, 16.0), (16, 57.0, 16.0), (16, 65.0, 16.0),\n        (32, 46.0, 16.0), (32, 58.0, 16.0), (32, 62.0, 16.0),\n        (48, 48.0, 16.0), (48, 55.0, 16.0), (48, 64.0, 16.0),\n    ],\n};\nconst TENDER_TUNE: Line = Line {\n    inst: Inst::Piano,\n    len: 128,\n    vel: 0.8,\n    notes: &[\n        (0, 72.0, 4.0), (4, 74.0, 2.0), (6, 76.0, 2.0), (8, 77.0, 6.0), (14, 76.0, 2.0),\n        (16, 74.0, 6.0), (22, 72.0, 2.0), (24, 69.0, 8.0),\n        (32, 70.0, 4.0), (36, 72.0, 2.0), (38, 74.0, 2.0), (40, 77.0, 6.0), (46, 74.0, 2.0),\n        (48, 72.0, 8.0), (56, 67.0, 8.0),\n        (64, 72.0, 4.0), (68, 74.0, 2.0), (70, 76.0, 2.0), (72, 77.0, 4.0), (76, 79.0, 4.0),\n        (80, 81.0, 8.0), (88, 77.0, 8.0),\n        (96, 79.0, 4.0), (100, 77.0, 2.0), (102, 74.0, 2.0), (104, 76.0, 8.0),\n        (112, 72.0, 16.0),\n    ],\n};\nconst TENSE_BASS: Line = Line {\n    inst: Inst::Bass,\n    len: 32,\n    vel: 0.8,\n    notes: &[\n        (0, 38.0, 1.5), (3, 38.0, 1.0), (6, 38.0, 1.0), (8, 38.0, 1.5), (11, 41.0, 1.0), (14, 40.0, 1.0),\n        (16, 37.0, 1.5), (19, 37.0, 1.0), (22, 37.0, 1.0), (24, 37.0, 1.5), (27, 40.0, 1.0), (30, 38.0, 1.0),\n    ],\n};\nconst TENSE_STRINGS: Line = Line {\n    inst: Inst::Strings,\n    len: 64,\n    vel: 0.65,\n    notes: &[\n        (0, 62.0, 8.0), (8, 65.0, 8.0), (16, 64.0, 8.0), (24, 61.0, 8.0),\n        (32, 62.0, 4.0), (36, 69.0, 4.0), (40, 70.0, 8.0), (48, 69.0, 8.0), (56, 61.0, 8.0),\n    ],\n};\nconst TENSE_DROPS: Line = Line {\n    inst: Inst::Bell,\n    len: 64,\n    vel: 0.25,\n    notes: &[(6, 86.0, 1.0), (22, 89.0, 1.0), (30, 85.0, 1.0), (46, 82.0, 1.0), (54, 86.0, 1.0)],\n};\n\n// The OR loop runs at 4 steps per heartbeat: what you hear is literally the patient.\nconst OR_PLUCK: Line = Line {\n    inst: Inst::Pluck,\n    len: 32,\n    vel: 0.42,\n    notes: &[\n        (0, 69.0, 1.0), (2, 72.0, 1.0), (4, 76.0, 1.0), (6, 72.0, 1.0),\n        (8, 69.0, 1.0), (10, 72.0, 1.0), (12, 77.0, 1.0), (14, 72.0, 1.0),\n        (16, 67.0, 1.0), (18, 71.0, 1.0), (20, 74.0, 1.0), (22, 71.0, 1.0),\n        (24, 68.0, 1.0), (26, 71.0, 1.0), (28, 76.0, 1.0), (30, 74.0, 1.0),\n    ],\n};\nconst OR_PAD: Line = Line {\n    inst: Inst::Pad,\n    len: 64,\n    vel: 0.62,\n    notes: &[\n        (0, 57.0, 8.0), (0, 64.0, 8.0), (8, 53.0, 8.0), (8, 60.0, 8.0), (16, 55.0, 8.0), (16, 62.0, 8.0), (24, 52.0, 8.0), (24, 59.0, 8.0),\n        (32, 57.0, 8.0), (32, 64.0, 8.0), (40, 50.0, 8.0), (40, 60.0, 8.0), (48, 52.0, 16.0), (48, 59.0, 16.0),\n    ],\n};\nconst OR_TUNE: Line = Line {\n    inst: Inst::Lead,\n    len: 64,\n    vel: 0.5,\n    notes: &[\n        (8, 76.0, 4.0), (12, 77.0, 2.0), (14, 76.0, 2.0), (16, 74.0, 6.0), (22, 71.0, 2.0),\n        (24, 72.0, 8.0), (40, 69.0, 2.0), (42, 72.0, 2.0), (44, 76.0, 4.0), (48, 74.0, 2.0),\n        (50, 72.0, 2.0), (52, 71.0, 4.0), (56, 68.0, 8.0),\n    ],\n};\nconst CRISIS_STRINGS: Line = Line {\n    inst: Inst::Strings,\n    len: 16,\n    vel: 0.8,\n    notes: &[\n        (0, 81.0, 1.0), (1, 80.0, 1.0), (2, 81.0, 1.0), (3, 80.0, 1.0), (4, 81.0, 1.0), (5, 80.0, 1.0), (6, 81.0, 1.0), (7, 80.0, 1.0),\n        (8, 82.0, 1.0), (9, 81.0, 1.0), (10, 82.0, 1.0), (11, 81.0, 1.0), (12, 82.0, 1.0), (13, 81.0, 1.0), (14, 82.0, 1.0), (15, 81.0, 1.0),\n    ],\n};\n\n// The strains' motifs, one heartbeat to the beat, four steps to the heartbeat: each loops in its own meter.\nconst WALTZ_3_4: Line = Line {\n    inst: Inst::Bell,\n    len: 48,\n    vel: 0.7,\n    notes: &[\n        (0, 76.0, 4.0), (4, 81.0, 4.0), (8, 80.0, 4.0),\n        (12, 76.0, 4.0), (16, 84.0, 4.0), (20, 83.0, 4.0),\n        (24, 81.0, 4.0), (28, 77.0, 4.0), (32, 76.0, 4.0),\n        (36, 74.0, 6.0), (42, 68.0, 2.0), (44, 69.0, 4.0),\n    ],\n};\nconst LULLABY_6_8: Line = Line {\n    inst: Inst::Bell,\n    len: 48,\n    vel: 0.7,\n    notes: &[\n        (0, 72.0, 4.0), (4, 75.0, 2.0), (6, 79.0, 2.0), (8, 77.0, 4.0), (12, 75.0, 4.0), (16, 74.0, 2.0), (18, 72.0, 2.0), (20, 71.0, 4.0),\n        (24, 72.0, 4.0), (28, 79.0, 2.0), (30, 84.0, 2.0), (32, 83.0, 4.0), (36, 79.0, 4.0), (40, 75.0, 8.0),\n    ],\n};\nconst FIVE_4: Line = Line {\n    inst: Inst::Brass,\n    len: 40,\n    vel: 0.55,\n    notes: &[\n        (0, 50.0, 3.0), (3, 50.0, 1.0), (4, 53.0, 4.0), (8, 50.0, 3.0), (11, 50.0, 1.0), (12, 56.0, 4.0), (16, 55.0, 4.0),\n        (20, 50.0, 3.0), (23, 50.0, 1.0), (24, 53.0, 4.0), (28, 58.0, 4.0), (32, 57.0, 4.0), (36, 49.0, 4.0),\n    ],\n};\nconst SEVEN_8: Line = Line {\n    inst: Inst::Lead,\n    len: 28,\n    vel: 0.62,\n    notes: &[\n        (0, 74.0, 2.0), (2, 77.0, 2.0), (4, 81.0, 2.0), (6, 80.0, 2.0), (8, 77.0, 2.0), (10, 74.0, 2.0), (12, 73.0, 2.0),\n        (14, 74.0, 2.0), (16, 77.0, 2.0), (18, 82.0, 2.0), (20, 81.0, 2.0), (22, 77.0, 2.0), (24, 76.0, 2.0), (26, 73.0, 2.0),\n    ],\n};\nconst RESULTS_FANFARE: Line = Line {\n    inst: Inst::Brass,\n    len: 64,\n    vel: 0.8,\n    notes: &[\n        (0, 57.0, 2.0), (0, 64.0, 2.0), (2, 60.0, 2.0), (2, 69.0, 2.0), (4, 64.0, 4.0), (4, 72.0, 4.0),\n        (8, 62.0, 2.0), (8, 71.0, 2.0), (10, 64.0, 2.0), (10, 72.0, 2.0), (12, 65.0, 2.0), (12, 74.0, 2.0), (14, 67.0, 2.0), (14, 76.0, 2.0),\n        (16, 69.0, 8.0), (16, 72.0, 8.0), (16, 81.0, 8.0),\n    ],\n};\nconst RESULTS_PIANO: Line = Line {\n    inst: Inst::Piano,\n    len: 64,\n    vel: 0.65,\n    notes: &[\n        (24, 69.0, 2.0), (26, 72.0, 2.0), (28, 76.0, 2.0), (30, 81.0, 2.0), (32, 79.0, 4.0), (36, 77.0, 4.0),\n        (40, 76.0, 2.0), (42, 74.0, 2.0), (44, 72.0, 4.0), (48, 71.0, 4.0), (52, 72.0, 4.0), (56, 69.0, 8.0),\n    ],\n};\nconst DRIVE_BASS: Line = Line {\n    inst: Inst::Bass,\n    len: 32,\n    vel: 0.8,\n    notes: &[\n        (0, 45.0, 1.0), (2, 45.0, 1.0), (4, 45.0, 1.0), (6, 48.0, 1.0), (8, 45.0, 1.0), (10, 45.0, 1.0), (12, 43.0, 1.0), (14, 44.0, 1.0),\n        (16, 41.0, 1.0), (18, 41.0, 1.0), (20, 41.0, 1.0), (22, 44.0, 1.0), (24, 40.0, 1.0), (26, 40.0, 1.0), (28, 43.0, 1.0), (30, 44.0, 1.0),\n    ],\n};\nconst DRIVE_LEAD: Line = Line {\n    inst: Inst::Lead,\n    len: 64,\n    vel: 0.6,\n    notes: &[\n        (0, 69.0, 3.0), (3, 72.0, 3.0), (6, 76.0, 2.0), (8, 77.0, 3.0), (11, 76.0, 3.0), (14, 72.0, 2.0),\n        (16, 74.0, 3.0), (19, 72.0, 3.0), (22, 71.0, 2.0), (24, 68.0, 8.0),\n        (32, 69.0, 3.0), (35, 72.0, 3.0), (38, 76.0, 2.0), (40, 81.0, 3.0), (43, 79.0, 3.0), (46, 76.0, 2.0),\n        (48, 77.0, 3.0), (51, 76.0, 3.0), (54, 74.0, 2.0), (56, 76.0, 8.0),\n    ],\n};\nconst DRIVE_KICK: Line = Line { inst: Inst::Kick, len: 8, vel: 0.6, notes: &[(0, 0.0, 1.0), (4, 0.0, 1.0)] };\nconst DRIVE_HAT: Line = Line { inst: Inst::Hat, len: 2, vel: 0.4, notes: &[(1, 0.0, 1.0)] };\n\n/// A track's lines and its own tempo (None = the heart's).\nfn track_lines(name: &str) -> (&'static [&'static Line], Option<f32>) {\n    match name {\n        \"title\" => (&[&TITLE_MELODY, &TITLE_LEFT], Some(116.0)),\n        \"tender\" => (&[&TENDER_PAD, &TENDER_TUNE], Some(120.0)),\n        \"tense\" => (&[&TENSE_BASS, &TENSE_STRINGS, &TENSE_DROPS], Some(170.0)),\n        \"or\" => (&[&OR_PLUCK, &OR_PAD, &OR_TUNE], None),\n        \"codeblue\" => (&[&DRIVE_BASS, &DRIVE_LEAD, &DRIVE_KICK, &DRIVE_HAT, &OR_PAD], None),\n        \"results\" => (&[&RESULTS_FANFARE, &RESULTS_PIANO, &TENDER_PAD], Some(200.0)),\n        _ => (&[], None),\n    }\n}\n\n/// How the mix sits at its default level: music defaults to 10%, so the writing is forward.\nconst LOUD: f32 = 3.0;\n\n#[derive(Default)]\npub struct Sequencer {\n    track: String,\n    /// Grid position in steps, for tracks with their own tempo.\n    pos: f64,\n    /// Heart-driven position last scheduled.\n    sched: f64,\n    /// Step scheduled up to.\n    next_step: i64,\n    motif_step: i64,\n    last_hush: bool,\n    drone_t: f32,\n    last_beat: i64,\n}\n\nimpl Sequencer {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Runs one frame: appends notes due in the next moments as (patch, pan, gain, delay).\n    pub fn update(&mut self, dt: f32, m: &MusicInput, out: &mut Vec<(Patch, f32, f32, f32)>) {\n        const AHEAD: f64 = 0.28;\n        if m.track != self.track {\n            self.track = m.track.clone();\n            self.pos = 0.0;\n            self.next_step = i64::MIN;\n            self.motif_step = i64::MIN;\n            self.last_beat = i64::MIN;\n        }\n        let (lines, own_tempo) = track_lines(&self.track);\n        let mut notes: Vec<(Patch, f32, f32)> = Vec::new();\n        // The Hush: everything low, one held note and the heart.\n        let hush = m.hush > 0.5;\n        if hush {\n            self.drone_t -= dt;\n            if self.drone_t <= 0.0 {\n                self.drone_t = 2.4;\n                note(Inst::Pad, 57.0, 3.0, 1.2, &mut notes);\n                note(Inst::Bell, 81.0, 1.0, 0.14, &mut notes);\n                for (p, pan, g) in notes.drain(..) {\n                    out.push((p, pan, g * LOUD, 0.0));\n                }\n            }\n        } else {\n            self.drone_t = 0.0;\n        }\n        self.last_hush = hush;\n        if m.flat || (lines.is_empty() && m.motif == 0) {\n            return;\n        }\n        // Where we are on the grid, and how long a step is.\n        let (pos, step_secs) = match own_tempo {\n            Some(bpm) => {\n                self.pos += dt as f64 * bpm as f64 / 60.0;\n                (self.pos, 60.0 / bpm)\n            }\n            None => {\n                let bpm = m.bpm.max(30.0);\n                (m.heart * 4.0, 60.0 / bpm / 4.0)\n            }\n        };\n        if self.next_step == i64::MIN {\n            self.next_step = pos.ceil() as i64;\n        }\n        // A rewind or a jump in position: don't try to catch up.\n        if (self.next_step as f64 - pos).abs() > 64.0 {\n            self.next_step = pos.ceil() as i64;\n        }\n        let horizon = pos + AHEAD / step_secs as f64;\n        let quiet = if hush { 0.0 } else { 1.0 };\n        while (self.next_step as f64) < horizon {\n            let step = self.next_step;\n            let delay = ((step as f64 - pos) * step_secs as f64).max(0.0) as f32;\n            for line in lines {\n                let s = step.rem_euclid(line.len as i64) as u32;\n                for (at, midi, len) in line.notes {\n                    if *at == s {\n                        note(line.inst, *midi, *len * step_secs, line.vel * quiet, &mut notes);\n                    }\n                }\n            }\n            // The bass lands on the actual heartbeat.\n            if own_tempo.is_none() && step.rem_euclid(4) == 0 && self.track == \"or\" {\n                let bar = step.div_euclid(4).rem_euclid(8);\n                let root = [33.0, 33.0, 29.0, 29.0, 31.0, 31.0, 28.0, 28.0][bar as usize];\n                note(Inst::Bass, root + 12.0, step_secs * 1.6, if hush { 0.7 } else { 0.9 }, &mut notes);\n            }\n            // The crisis layer fades in as vitals fall.\n            if m.crisis > 0.02 && own_tempo.is_none() {\n                let s = step.rem_euclid(CRISIS_STRINGS.len as i64) as u32;\n                for (at, midi, len) in CRISIS_STRINGS.notes {\n                    if *at == s {\n                        note(Inst::Strings, *midi, *len * step_secs, 0.8 * m.crisis * quiet, &mut notes);\n                    }\n                }\n                if step.rem_euclid(2) == 0 {\n                    note(Inst::Hat, 0.0, 0.1, m.crisis * quiet, &mut notes);\n                }\n            }\n            // A strain's motif, in its own meter.\n            let motif = match m.motif {\n                3 => Some(&WALTZ_3_4),\n                6 => Some(&LULLABY_6_8),\n                5 => Some(&FIVE_4),\n                7 => Some(&SEVEN_8),\n                _ => None,\n            };\n            if let (Some(line), true) = (motif, own_tempo.is_none()) {\n                let s = step.rem_euclid(line.len as i64) as u32;\n                for (at, midi, len) in line.notes {\n                    if *at == s {\n                        note(line.inst, *midi, *len * step_secs, line.vel * quiet, &mut notes);\n                    }\n                }\n            }\n            for (p, pan, g) in notes.drain(..) {\n                if g > 0.001 {\n                    out.push((p, pan, g * LOUD, delay));\n                }\n            }\n            self.next_step += 1;\n        }\n    }\n}\n\n/// Renders a track offline for `secs`, on the music bus at unity: for tests.\npub fn render_track(track: &str, secs: f32, rate: f32) -> Vec<f32> {\n    let mut mixer = crate::Mixer::new(rate);\n    mixer.buses = [1.0, 1.0, 1.0];\n    let mut seq = Sequencer::new();\n    let frames = (secs * rate) as usize;\n    let mut out = vec![0.0f32; frames * 2];\n    let block = 512usize;\n    let dt = block as f32 / rate;\n    let mut notes = Vec::new();\n    let mut i = 0;\n    let mut heart = 0.0f64;\n    let mut buf = vec![0.0f32; block * 2];\n    while i < frames {\n        heart += dt as f64 * 80.0 / 60.0;\n        let m = MusicInput { track: track.to_string(), bpm: 80.0, heart, ..Default::default() };\n        notes.clear();\n        seq.update(dt, &m, &mut notes);\n        for (p, pan, g, d) in notes.drain(..) {\n            mixer.play_on(crate::BUS_MUSIC, p, pan, g, d);\n        }\n        let n = block.min(frames - i);\n        mixer.render(&mut buf[..n * 2]);\n        out[i * 2..(i + n) * 2].copy_from_slice(&buf[..n * 2]);\n        i += n;\n    }\n    out\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn peak(b: &[f32]) -> f32 {\n        b.iter().fold(0.0, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn every_track_renders_sound() {\n        for t in [\"title\", \"tender\", \"tense\", \"or\", \"codeblue\", \"results\"] {\n            let b = render_track(t, 6.0, 22050.0);\n            assert!(peak(&b) > 0.02, \"{t} is silent: {}\", peak(&b));\n        }\n    }\n\n    #[test]\n    fn the_motifs_play_in_their_own_meters() {\n        for meter in [3u8, 5, 6, 7] {\n            let mut seq = Sequencer::new();\n            let mut out = Vec::new();\n            let mut heart = 0.0;\n            for _ in 0..600 {\n                heart += 1.0 / 60.0 * 80.0 / 60.0;\n                let m = MusicInput { track: \"or\".into(), bpm: 80.0, heart, motif: meter, ..Default::default() };\n                seq.update(1.0 / 60.0, &m, &mut out);\n            }\n            let plain = {\n                let mut seq = Sequencer::new();\n                let mut o = Vec::new();\n                let mut heart = 0.0;\n                for _ in 0..600 {\n                    heart += 1.0 / 60.0 * 80.0 / 60.0;\n                    let m = MusicInput { track: \"or\".into(), bpm: 80.0, heart, ..Default::default() };\n                    seq.update(1.0 / 60.0, &m, &mut o);\n                }\n                o.len()\n            };\n            assert!(out.len() > plain, \"meter {meter} added no notes\");\n        }\n    }\n\n    #[test]\n    fn the_heart_sets_the_tempo_and_a_stopped_heart_stops_it() {\n        let count = |bpm: f32| {\n            let mut seq = Sequencer::new();\n            let mut out = Vec::new();\n            let mut heart = 0.0;\n            for _ in 0..1200 {\n                heart += 1.0 / 60.0 * bpm as f64 / 60.0;\n                let m = MusicInput { track: \"or\".into(), bpm, heart, ..Default::default() };\n                seq.update(1.0 / 60.0, &m, &mut out);\n            }\n            out.len()\n        };\n        assert!(count(140.0) > count(72.0), \"a faster heart plays faster\");\n        let mut seq = Sequencer::new();\n        let mut out = Vec::new();\n        seq.update(0.1, &MusicInput { track: \"or\".into(), bpm: 80.0, heart: 0.0, flat: true, ..Default::default() }, &mut out);\n        assert!(out.is_empty());\n    }\n}\nEOF\ncat >> crates/pav_audio/src/lib.rs <<'EOF'\n\n#[cfg(test)]\nmod surgery_tests {\n    use super::*;\n    use pav_core::games::surgery::cue;\n\n    fn peak(b: &[f32]) -> f32 {\n        b.iter().fold(0.0, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn music_starts_at_ten_percent() {\n        assert_eq!(DEFAULT_BUSES[BUS_MUSIC], 0.10);\n        assert_eq!(Mixer::new(48000.0).buses[BUS_MUSIC], 0.10);\n    }\n\n    #[test]\n    fn every_cue_renders_non_silent() {\n        for (id, name) in cue::ALL {\n            let mut m = Mixer::new(22050.0);\n            for (p, d) in cues::sound(*id, 1.0, 1.0) {\n                m.play(p, 0.0, 1.0, d);\n            }\n            let mut b = vec![0.0; 22050 * 2];\n            m.render(&mut b);\n            assert!(peak(&b) > 0.005, \"cue {name} is silent: {}\", peak(&b));\n        }\n    }\n\n    #[test]\n    fn every_vowel_of_every_voice_renders_non_silent() {\n        for wave in [Wave::Square, Wave::Saw, Wave::Triangle] {\n            for v in ['a', 'e', 'i', 'o', 'u'] {\n                let def = voice::VoiceDef { pitch: 300.0, wave, pace: 0.07, jitter: 1.0 };\n                let mut m = Mixer::new(22050.0);\n                m.play_on(BUS_VOICES, voice::blip(&def, v, 0.0, 1), 0.0, 1.0, 0.0);\n                let mut b = vec![0.0; 4410 * 2];\n                m.render(&mut b);\n                assert!(peak(&b) > 0.005, \"{wave:?} {v}: {}\", peak(&b));\n                assert!(m.peaks[BUS_VOICES] >= 0.0);\n            }\n        }\n    }\n\n    #[test]\n    fn speech_inflects_at_the_ends_of_sentences() {\n        let s = voice::syllables(\"Is it now? It is now.\");\n        assert!(s.len() >= 6);\n        assert!(s.iter().any(|x| x.2 > 0.0), \"rising at the question\");\n        assert!(s.iter().any(|x| x.2 < 0.0), \"falling at the stop\");\n    }\n\n    #[test]\n    fn the_buses_scale_only_their_own_voices() {\n        let render = |bus: usize, gain: f32| {\n            let mut m = Mixer::new(22050.0);\n            m.buses = [1.0, 1.0, 1.0];\n            m.buses[bus] = gain;\n            m.play_on(BUS_MUSIC, Patch { decay: 0.2, volume: 0.3, ..Patch::new(Wave::Sine, 440.0) }, 0.0, 1.0, 0.0);\n            let mut b = vec![0.0; 4410 * 2];\n            m.render(&mut b);\n            peak(&b)\n        };\n        assert!(render(BUS_MUSIC, 0.1) < render(BUS_MUSIC, 1.0) * 0.3);\n        assert_eq!(render(BUS_VOICES, 0.0), render(BUS_EFFECTS, 0.0));\n    }\n}\nEOF\nCARGO_BUILD_JOBS=10 timeout 500 cargo test --offline -p pav_audio 2>&1 | grep -E \"^error|^warning: unused|^ +--> |^test .*FAILED|panicked|test result\" -A2 | head -50","description":"Add audio buses, cue table, voices and the music sequencer, then test","timeout":560000}}}
