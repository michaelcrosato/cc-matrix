{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {ALL_OPS} from './src/content/ops.js';import {createOp,step,drainEvents,results} from './src/sim/op.js';import {botInput} from './src/sim/bot.js';\nfor(const d of ALL_OPS){const s=createOp(d);for(let t=0;t<40000&&s.status==='operating';t++){step(s,s.seats.map((_,i)=>botInput(s,i,.7)));drainEvents(s);}console.log(d.id,s.status,s.stage,s.elapsed.toFixed(1),s.vitals.map(x=>x.toFixed(0)),s.mistakes,s.cause,results(s));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
