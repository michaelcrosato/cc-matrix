{"type":"item.started","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess\nbase=Path('tests/results/screens')\nfor group,pat,cols,size in [('arenas','arena-*',2,'640x360'),('cast','cast-*',2,'640x360'),('viewport','viewport-*',4,'350x300'),('sets','set-*',2,'480x270')]:\n files=sorted(base.glob(pat+'.png'));n=(len(files)+cols-1)//cols;args=['magick']\n for c in range(cols):\n  chunk=files[c*n:(c+1)*n]\n  if chunk: args+=['(',*map(str,chunk),'-thumbnail',size,'-background','#101d2c','-append',')']\n subprocess.run(args+['+append','tests/results/'+group+'-contact.png'],check=True)\nfiles=sorted(base.glob('*.png'))\nbase.joinpath('index.html').write_text('<\"'!doctype html><meta charset=\"utf-8\"><title>Critical Opinion — Visual Checks</title><style>body{margin:24px;background:#101d2c;color:#f3e7c7;font:16px monospace}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}img{width:100%;height:220px;object-fit:contain;background:#162c35}a{color:#76d7c3}figure{margin:0}</style><h1>Critical Opinion / visual checks</h1><main>'\"'+''.join('<figure><a href=\\\"'+f.name+'\\\"><img loading=\\\"lazy\\\" src=\\\"'+f.name+'\\\"><figcaption>'+f.stem+'</figcaption></a></figure>' for f in files)+'</main>')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
