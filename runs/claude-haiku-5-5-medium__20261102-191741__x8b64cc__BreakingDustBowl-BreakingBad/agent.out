lash.state : null, hurt: H.inv > .5, dash: H.dash > 0 });","+  game.focus(H.body.x, H.body.y, 10);"," }","+// attract mode's AI: walk to the nearest thing that matters (the next batch, the RV, the arena, the boss), wiggle when stuck"," function aiDir(s, boss) {","-  // the AI: walk to the next thing (the nearest foe in reach, else the next objective), wiggle when stuck","-  const H = s.hero;","   let tx, ty;","-  if (boss) { tx = s.boss.body.x; ty = s.boss.body.y; }","-  else if (s.batches) {","-    const next = s.batches.find(b => !b.taken);","-    if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }","-    else if (next) { tx = next.x; ty = next.y; }","-    else { tx = s.arena.x; ty = s.arena.y; }","-  }","-  if (!tx) return [0, 0];","-  const dx = tx - H.body.x, dy = ty - H.body.y, d = Math.hypot(dx, dy) || 1;","-  if (H.body.hitWall) s.aiWander = .6;","-  if ((s.aiWander = Math.max(0, (s.aiWander || 0) - .016)) > 0) return s.aiDir || [dx / d, dy / d];","+  if (boss) { tx = boss.body.x; ty = boss.body.y; }","+  else if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }","+  else { const b = s.batches && s.batches.find(q => !q.taken); if (b) { tx = b.x; ty = b.y; } else { tx = s.arena.x; ty = s.arena.y; } }","+  if (tx === undefined) return [0, 0];","+  const dx = tx - s.hero.body.x, dy = ty - s.hero.body.y, d = Math.hypot(dx, dy) || 1;","+  if (s.hero.body.hitWall) s.aiWander = .5;","+  if (s.aiWander > 0) { s.aiWander -= dt_ai; return s.aiDir; }","   s.aiDir = [dx / d, dy / d];","   return s.aiDir;"," }","+const dt_ai = 1 / 120;"," function aiWantsSwing(s, boss) {","   const H = s.hero;","-  if (boss) return Math.hypot(s.boss.body.x - H.body.x, s.boss.body.y - H.body.y) < 26 && H.slash.busy === false;","-  return s.grunts.some(f => !f.dead && Math.hypot(f.body.x - H.body.x, f.body.y - H.body.y) < 22 && H.slash.busy === false);","+  if (boss) return dist(boss.body, H.body) < 26 && !H.slash.busy;","+  return s.grunts.some(f => !f.dead && dist(f.body, H.body) < 22) && !