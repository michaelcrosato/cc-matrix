{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCRLSUvwcj8m4T4GWN4","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11247,"cache_read_input_tokens":136369,"cache_creation":{"ephemeral_5m_input_tokens":11247,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"a652040a-7275-4eeb-82a3-148a47ebcc5f","timestamp":"2026-11-03T02:22:14.031Z","request_id":"req_011CgfCRL4uwHKNSrjfj35VR","thinking_duration_ms":575,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCRLSUvwcj8m4T4GWN4","type":"message","role":"assistant","content":[{"type":"text","text":"Now the game itself: title, a cook minigame lab, a desert run, a boss showdown, an about/credits screen, the attract demo, the hub round, and the settings."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11247,"cache_read_input_tokens":136369,"cache_creation":{"ephemeral_5m_input_tokens":11247,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"2638e530-1aab-41f7-af83-cccbb1a8b9eb","timestamp":"2026-11-03T02:22:14.396Z","request_id":"req_011CgfCRL4uwHKNSrjfj35VR"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCRLSUvwcj8m4T4GWN4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Agvg5NoHtaWr7jnKHn3GXR","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (a timed cook), a desert run (sneak past Vail's men, pick up three batches, deliver them to the\n// RV), and a showdown in a chapel ruin. Built on my-3D2dge (the ADVENTURE kit's engine, v0.85.1, with its modules).\n// Controls: WASD / arrows or a pad's stick move; J, X or click swings; Space, Shift or the dash button dashes; Enter,\n// Space or confirm talks and cooks; V changes the view; Escape or Start opens the pause menu (Settings holds the\n// gamepad axis inversion and the button symbols). Attract mode: 10 seconds on the title, then an AI plays (it cheats).\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nconst rgbHex = c => E.toHex ? E.toHex(c) : c;\nconst label = a => game.input.label(a);\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\n\n/* ---- settings: the gamepad's axis inversion (the common fix for a stick that flips), the button symbols ---- */\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts when a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\n/* ---- keys every scene shares ---- */\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the screen, with the gamepad's inversion applied (keyboard and mouse are never inverted)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// a world point under the mouse, or null (aiming)\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction aimAt(body, pt) { return E.angleTo(body, pt); }\n// a one-line prompt in the player's own controls: \"E Talk\" on a keyboard, \"A Talk\" on a pad (PlayStation or Xbox symbols)\nconst prompt = (a, word) => label(a) + ' ' + word;\n// the view toggle and the camera zoom are the player's own; the scene's camera: { zoom: [min, max], start }\nconst camFor = () => (game.scene && game.scene.camera) || {};\nfunction textPrompt(r, s, y) { r.text(s, r.W / 2, y || r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n\n/* ---- the shared rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: (c) => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: c || '#b02a2a' }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: '#b02a2a', pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } }),\n  clerk: () => new E.Humanoid({ size: 1.15, outfit: 'robe', hair: 'ponytail', sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .8 },\n    colors: { skin: '#e8c0a0', hair: '#4a2a1a', cloth: '#7a6aa0', trim: '#f0d0a0', pants: '#7a6aa0', boot: '#4a3a2a', eye: '#2a2a4a' } })\n};\n\n/* ---- the title: a ledge of heroes under a desert sky ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt(), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n\n/* ---- DIALOG helper: talk lines wait for the player; in attract mode they turn themselves ---- */\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: scenes.demo ? 1.8 : 0 }, o || {})); }\n\n/* ========================================================================================= *\n *  TITLE and the menus                                                                        *\n * ========================================================================================= */\nlet titleMenu = null, idle = 0, titleNote = '', noteT = 0;\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    L.enabled = false; game.weather = null; idle = 0; scenes.demo = false; titleNote = ''; game.cam.snap = true;\n    titleMenu = titleMenu || new E.Menu(game, ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'], {\n      y: 0, title: null, box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: (i, item) => titleAction(i),\n      onCancel: () => {}\n    });\n    titleMenu.i = 0;\n    titleMenu.items = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\n    titleMenu.items = titleMenu.items.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() }));\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed() && !(I.pressed('confirm') || I.pressed('start'))) { idle = 0; }\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (titleNote && (noteT -= dt) < 0) titleNote = '';\n    if (!titleMenu.update(dt)) { /* the menu owns the input */ }\n    if (idle > 10) { idle = 0; startDemo(); return; }\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    r.overlay(g => {\n      const touch = game.input.lastDevice === 'touch';\n      const warn = touchOnly() && game.input.lastDevice !== 'gamepad' && game.input.lastDevice !== 'keyboard' ? 'Controller or keyboard required' : '';\n      E.font.text(g, warn || titleNote, r.W / 2, r.H - 44, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if (i !== 3 && touchOnly() && game.input.lastDevice === 'touch') { titleNote = 'Controller or keyboard required'; noteT = 2.5; return; }\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', { demo: false }, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { scenes.demo = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nlet lab = null;   // the lab's state, while in it\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    const demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'lab';\n    A.music('adventure');\n    L.enabled = true; L.ambient = .55;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    lab = { map, demo, phase: 'intro', cook: null, cookDone: 0, talk: new E.Dialog(game),\n      hero: makeHero(h.x, h.y, 'hollis'), tomas: { rig: RIG.tomas(), x: t.x, y: t.y, facing: Math.PI / 2, t: 0 },\n      station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(lab.hero.body.x, lab.hero.body.y, 10); game.follow(null);\n    if (demo) { lab.talk.auto = 1.6; }\n    if (!demo) {\n      const tomas = lab.tomas;\n      say(lab.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n        'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two promises, Tomas.',\n        () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three timed presses: a green band, the sweet spot.'],\n        { name: 'TOMAS', portrait: tomas.rig, onDone: () => { lab.phase = 'free'; } });\n    } else { lab.phase = 'free'; }\n  },\n  update(dt) {\n    if (!lab) return;\n    const I = game.input;\n    if (!scenes.demo && I.anyPressed() === false) { /* idle */ }\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    lab.tomas.t += dt;\n    if (lab.talk.update(dt)) { if (scenes.demo) demoTalk(lab); return; }\n    if (lab.phase === 'cook') return cookStep(dt);\n    if (lab.phase === 'free' || lab.phase === 'after') {\n      const dir = scenes.demo ? aiLabDir() : moveDir();\n      stepHero(dt, dir, { lab: true });\n      const near = (p, r) => Math.hypot(lab.hero.body.x - p.x, lab.hero.body.y - p.y) < r;\n      if (lab.phase === 'free' && !scenes.demo && near(lab.station, 22) && (I.pressed('confirm') || I.clicked()) && lab.cookDone < 3) { I.consumeAll(); startCook(); }\n      if (lab.phase === 'free' && !scenes.demo && near(lab.tomas, 26) && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); tomasTalk(); }\n      if (lab.phase === 'free' && scenes.demo && near(lab.station, 22) && lab.cookDone < 3) startCook();\n      if (lab.cookDone >= 3 && near(lab.exit, 14)) {\n        if (scenes.demo || I.pressed('confirm')) { I.consumeAll(); progress.scene = 'desert'; sfx('door'); game.go('desert', { demo: !!scenes.demo }, { fade: 'iris', seconds: .5 }); }\n      }\n    }\n    if (lab.phase === 'intro') return;\n    if (!scenes.demo && I.pressed('cancel') && lab.phase === 'free') { /* cancel: pause menu handles it */ }\n  },\n  draw(r) {\n    if (!lab) return;\n    lab.map.drawFloor(r);\n    for (const b of lab.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, lab.station.x, lab.station.y);\n    r.shadow(lab.hero.body.x, lab.hero.body.y, 5);\n    lab.map.queueWalls(r);\n    r.prop('barrel', lab.exit.x - 22, lab.exit.y - 16, 0, { size: .9, light: false });\n    r.actor(lab.tomas.x, lab.tomas.y, 0, (g, ox, oy) => lab.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, lab.hero);\n    L.add(lab.station.x, lab.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(lab.exit.x, lab.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (lab.phase === 'cook') cookOverlay(r);\n    lab.talk.draw(r);\n    hud(r, lab.phase === 'free' ? (lab.cookDone < 3 ? 'COOK ' + lab.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT') : '');\n    if (lab.phase === 'free' && !scenes.demo) {\n      const near = Math.hypot(lab.hero.body.x - lab.station.x, lab.hero.body.y - lab.station.y) < 22;\n      if (near && lab.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (lab.cookDone + 1)));\n      else if (Math.hypot(lab.hero.body.x - lab.tomas.x, lab.hero.body.y - lab.tomas.y) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n    }\n  }\n};\nfunction tomasTalk() {\n  const L1 = lab.cookDone >= 3 ? ['Three batches. Mr. Rook, I think the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : lab.cookDone ? ['Batch ' + lab.cookDone + ' is in the bag. Cook the next one when you want the money.'] : ['The station is hot. Press ' + label('confirm') + ' when the band lines up.'];\n  say(lab.talk, L1, { name: 'TOMAS', portrait: lab.tomas.rig });\n}\nfunction demoTalk(l) { /* attract mode closes the box by itself */ }\nfunction startCook() {\n  lab.phase = 'cook';\n  lab.cook = { stage: 0, pos: 0, dir: 1, speed: 1.1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(lab.cook);\n  sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt) {\n  const c = lab.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * c.speed * dt * (1 + c.stage * .25);\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !scenes.demo && (I.pressed('confirm') || I.clicked());\n  if (scenes.demo && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (press) {\n    I.consumeAll();\n    const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n    c.results.push(miss ? .45 : .6 + .4 * acc);\n    c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n    if (++c.stage >= 3) { finishCook(); return; }\n    newZone(c);\n  }\n}\nfunction finishCook() {\n  const pur = lab.cook.results.reduce((a, b) => a + b, 0) / lab.cook.results.length;\n  progress.purity.push(+pur.toFixed(3)); lab.cookDone++; progress.batches = lab.cookDone;\n  lab.phase = 'free'; lab.cook = null;\n  sfx('coin');\n  const lines = pur > .9 ? ['That color. That is the actual color.'] : pur > .75 ? ['Clean enough. Clean enough is what we sell.'] : ['Cloudy. Cloudy is a problem for a man with a lab coat.'];\n  if (!scenes.demo) say(lab.talk, lines.concat(lab.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: lab.hero.rig });\n  game.hitFx && 0;\n}\nfunction cookOverlay(r) {\n  const c = lab.cook;\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = (r.W - W) / 2, y0 = r.H * .3;\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    const zx = x0 + c.zone * W - c.half * W, zw = c.half * 2 * W;\n    E.px.rect(g, Math.round(zx), y0 + 1, Math.round(zw), 12, '#3aa050');\n    const mx = Math.round(x0 + c.pos * W);\n    E.px.rect(g, mx - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, the chapel to go to.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scatter of rocks and cacti, away from the road and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .075) g[y][x] = 'c';\n  }\n  // the road along rows 12-13, the chapel's path north at x 19-21\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }\n  for (let y = 1; y < 12; y++) { put(20, y, ','); }\n  // the RV's compound: adobe walls, a gap at the south gate, the RV inside\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');\n  // the chapel's arena at the north end of the path\n  put(20, 1, 'E');\n  // the start, the three batches, the patrol points (kept clear of rocks and cacti)\n  put(3, 12, 'h');\n  for (const [x, y] of [[9, 20], [15, 6], [36, 17]]) put(x, y, 'b');\n  const PAT = [[12, 12], [18, 12], [22, 18], [22, 22], [35, 20], [35, 15], [21, 7], [21, 11]];\n  for (const [x, y] of PAT) put(x, y, 'g');\n  for (const [x, y] of PAT) { for (const [dx, dy] of [[0, 0]]) if (g[y + dy][x + dx] === 'c' || g[y + dy][x + dx] === '#') put(x + dx, y + dy, '.'); }\n  return g.map(r => r.map(c => c === 'g' ? 'g' : c).join(''));\n}\nconst DESERT_ROWS = buildDesert();\nconst GRUNT_PATROLS = [\n  [[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]\n];\nconst BATCH_SPAWNS = [];\nlet ds = null;\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round), demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'desert';\n    if (round) { progress = Object.assign(freshProgress(), { purity: [.8, .8, .8], batches: 3, scene: 'desert' }); }\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'c': { floor: 'sand', spawn: 'cactus' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const batches = map.findAll('batch').slice(progress.delivered || 0);\n    const cacti = map.findAll('cactus');\n    const grunts = map.findAll('grunt').map((c, i) => makeGrunt(c.x, c.y, GRUNT_PATROLS[i] || [[c.x, c.y]], i));\n    ds = { map, round, demo, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y, 'hollis'), grunts, cacti,\n      batches: batches.map(b => ({ x: b.x, y: b.y, taken: false })), carry: 0,\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: 'run', t: 0, delivering: 0,\n      objective: 'PICK UP THE BATCHES', hubT: 0, hubDone: false, aiTarget: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(ds.hero.body.x, ds.hero.body.y, 10);\n    if (!demo && !round && progress.delivered === 0) {\n      say(ds.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Move with the stick or WASD. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it.'],\n        { name: 'HOLLIS', portrait: ds.hero.rig });\n    }\n    if (round) { ds.phase = 'wait'; }\n    if (HUB && round) { HUB.progress && HUB.progress({ score: 0, label: '0/3 batches' }); }\n  },\n  update(dt) {\n    if (!ds) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (ds.phase === 'wait') { roundWait(dt); return; }\n    if (ds.phase === 'over' || ds.phase === 'won') { ds.t += dt; return; }\n    if (ds.talk.update(dt)) return;\n    ds.t += dt;\n    updateHeroControls(dt, ds);\n    // a foe's sight, attacks, patrols\n    for (const f of ds.grunts) stepFoe(dt, f, ds.hero, ds.map, ds);\n    // the batches: walk over one to pick it up\n    for (const b of ds.batches) if (!b.taken && near(ds.hero.body, b, 12)) { b.taken = true; ds.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    // the drop: deliver every batch carried\n    if (ds.carry > 0 && near(ds.hero.body, ds.drop, 18)) deliver();\n    // the arena: the chapel path, once the batches are gone\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && !scenes.demo) { ds.phase = 'won'; game.go('showdown', {}, { fade: 'iris', seconds: .6 }); }\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && scenes.demo) { ds.phase = 'won'; game.go('showdown', { demo: true }, { fade: 'iris', seconds: .6 }); }\n    ds.objective = progress.delivered < 3 ? (ds.carry ? 'TAKE THEM TO THE RV' : 'PICK UP THE BATCHES  ' + (3 - progress.delivered - ds.carry) + ' LEFT') : 'THE CHAPEL, NORTH';\n    if (ds.round && HUB) hubTick(dt);\n    if (game.time && ds.hero.dead) return;\n    if (ds.hero.dead) return;\n  },\n  draw(r) {\n    if (!ds) return;\n    ds.map.drawFloor(r);\n    for (const c of ds.cacti) r.prop('cactus', c.x, c.y, 0, { size: 1.15 });\n    for (const b of ds.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, ds.drop.x, ds.drop.y);\n    drawArena(r, ds.arena.x, ds.arena.y);\n    r.shadow(ds.hero.body.x, ds.hero.body.y, 5);\n    for (const f of ds.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    ds.map.queueWalls(r);\n    drawHero(r, ds.hero);\n    for (const f of ds.grunts) drawFoe(r, f);\n    ds.talk.draw(r);\n    hud(r, ds.objective);\n    if (ds.phase === 'wait') r.overlay(g => { E.font.text(g, 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }); });\n    if (ds.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (ds.phase === 'over' && !ds.hero.dead) deathCard(r, '');\n    if (ds.roundOver) r.overlay(g => E.font.text(g, ds.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (!ds.talk.open && !ds.hero.dead) {\n      const d = Math.hypot(ds.hero.body.x - ds.drop.x, ds.hero.body.y - ds.drop.y);\n      if (ds.carry > 0 && d < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n    }\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction near(a, b, r) { return Math.hypot(a.body ? a.body.x - b.x : a.x - b.x, a.body ? a.body.y - b.y : a.y - b.y) < r; }\nfunction deliver() {\n  const k = ds.carry; ds.carry = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; progress.cash += Math.round(pur * 100);\n  }\n  sfx('coin');\n  game.note('DELIVERED ' + k + '  $' + progress.cash);\n  if (!scenes.demo && !ds.round) say(ds.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: ds.hero.rig });\n  if (ds.round) roundCheck();\n}\nfunction roundCheck() {\n  if (progress.delivered >= 3) {\n    ds.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n    if (HUB && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); }\n  }\n}\nfunction hubTick(dt) {\n  ds.hubT += dt;\n  if (ds.hubT > 1 && HUB) { ds.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n  if (HUB && HUB.time && HUB.time() >= 0 && ds.phase === 'wait') ds.phase = 'run';\n}\nfunction roundWait(dt) {\n  // the round starts on the hub's clock: a countdown until time reaches 0\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -Infinity) ds.roundOver = 'GO IN ' + Math.ceil(-t);\n  else if (ds.phase === 'wait' && t >= 0) { ds.phase = 'run'; ds.roundOver = null; }\n  if (ds.phase === 'wait' && !HUB) ds.phase = 'run';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers and sweeps; a second phase when he's hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nlet sh = null;\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    scenes.demo = !!(data && data.demo); progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), v = map.find('vail');\n    sh = { map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y, 'hollis'),\n      boss: makeBoss(v.x, v.y), phase: 'intro', t: 0, won: false, lights: [] };\n    game.focus(sh.hero.body.x, sh.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    say(sh.talk, lines, { name: 'VAIL', portrait: sh.boss.rig, onDone: () => { sh.phase = 'fight'; } });\n    if (scenes.demo) sh.phase = 'fight';\n  },\n  update(dt) {\n    if (!sh) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (sh.talk.update(dt)) return;\n    sh.t += dt;\n    if (sh.phase === 'fight') {\n      updateHeroControls(dt, sh, true);\n      stepBoss(dt, sh);\n      if (sh.boss.dead && !sh.won) { sh.won = true; sh.phase = 'won'; A.music('victory'); sh.t = 0; }\n    }\n    if (sh.phase === 'won' && sh.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n    if (sh.hero.dead) return;\n  },\n  draw(r) {\n    if (!sh) return;\n    sh.map.drawFloor(r);\n    r.shadow(sh.hero.body.x, sh.hero.body.y, 5);\n    r.shadow(sh.boss.body.x, sh.boss.body.y, 10, .5);\n    sh.map.queueWalls(r);\n    r.prop('torch', 16, 16, 0, { size: 1.1, light: true });\n    r.prop('torch', 256, 16, 0, { size: 1.1, light: true });\n    L.add(sh.boss.body.x, sh.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, sh.boss);\n    drawHero(r, sh.hero);\n    sh.talk.draw(r);\n    hud(r, sh.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (sh.phase === 'fight' && !sh.boss.dead) r.overlay(g => { E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, sh.boss.hp / sh.boss.maxHp), '#c83a2a'); });\n    if (sh.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (sh.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  Shared things: the hero, foes, the boss, the HUD, the death card, the hub's countdown\n * ========================================================================================= */\nfunction makeHero(x, y, who) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol, i) {\n  const body = new E.Body({ x, y, r: 5 });\n  const f = { body, rig: RIG.grunt(['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'][i % 4]), atk: new E.Attack(i % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt' };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0, patrol: [], idx: 0, state: 'fight', alert: 0, cool: 1.5, seenT: 0, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's control this step: a stick or WASD for a player; the AI in attract mode\nfunction updateHeroControls(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  let dir = [0, 0];\n  if (scenes.demo) dir = aiDir(s, boss);\n  else dir = moveDir();\n  // the dash\n  if (!scenes.demo && I.pressed('dash') && H.dashCool <= 0 && H.dash <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  // aiming: the mouse points the blade at the cursor; the stick and keys aim with the walk\n  if (!scenes.demo && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = aimAt(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  // swing\n  if (!scenes.demo && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (scenes.demo && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [s.boss] : s.grunts;\n  const targets = live(foes).map(f => f.body);\n  H.slash.hits(targets, b => E.inArc(H.body || H, H.facing, b, 24, 1.3, 16) || (boss ? false : false), b => {\n    const f = b.foe; hurtFoe(f, 14, b);\n  });\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s ? s.hero : null;\n  const hero = H || lab.hero;\n  const sp = o && o.speed ? o.speed : 78;\n  if (hero.dead) return;\n  const d = dir || [0, 0];\n  hero.body.vx = d[0] * sp; hero.body.vy = d[1] * sp;\n  hero.body.update(dt, (s && s.map) || (lab && lab.map));\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !scenes.demo)) hero.facing = Math.atan2(d[1], d[0]);\n  hero.rig.update(dt, { x: hero.body.x, y: hero.body.y, z: hero.body.z, vx: hero.body.vx, vy: hero.body.vy, facing: hero.facing,\n    attack: hero.slash ? hero.slash.state : null, hurt: hero.inv > .5, dash: hero.dash > 0 });\n}\nfunction aiDir(s, boss) {\n  // the AI: walk to the next thing (the nearest foe in reach, else the next objective), wiggle when stuck\n  const H = s.hero;\n  let tx, ty;\n  if (boss) { tx = s.boss.body.x; ty = s.boss.body.y; }\n  else if (s.batches) {\n    const next = s.batches.find(b => !b.taken);\n    if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n    else if (next) { tx = next.x; ty = next.y; }\n    else { tx = s.arena.x; ty = s.arena.y; }\n  }\n  if (!tx) return [0, 0];\n  const dx = tx - H.body.x, dy = ty - H.body.y, d = Math.hypot(dx, dy) || 1;\n  if (H.body.hitWall) s.aiWander = .6;\n  if ((s.aiWander = Math.max(0, (s.aiWander || 0) - .016)) > 0) return s.aiDir || [dx / d, dy / d];\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return Math.hypot(s.boss.body.x - H.body.x, s.boss.body.y - H.body.y) < 26 && H.slash.busy === false;\n  return s.grunts.some(f => !f.dead && Math.hypot(f.body.x - H.body.x, f.body.y - H.body.y) < 22 && H.slash.busy === false);\n}\nfunction aiLabDir() {\n  const b = lab.hero.body;\n  const tx = lab.cookDone < 3 ? lab.station.x : lab.exit.x, ty = lab.cookDone < 3 ? lab.station.y : lab.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy) || 1;\n  if (d < 14) return [0, 0];\n  return [dx / d, dy / d];\n}\nfunction hurtFoe(f, dmg, body) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  const H = scenes.hero || null;\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(body, { x: body.x, y: body.y }), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(lab ? lab.hero.body : (ds ? ds.hero.body : sh.hero.body), body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); if (f.name === 'boss') { sh.boss.dead = true; } }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || scenes.demo || H.dead) return;\n  H.hp -= dmg; H.inv = 1.0;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; H.rig.update(0, {}); sfx('die'); }\n}\nfunction stepFoe(dt, f, hero, map, s) {\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const H = hero, dist = Math.hypot(H.body.x - f.body.x, H.body.y - f.body.y);\n  const seen = !scenes.demo && dist < 110 && map.los(f.body.x, f.body.y, H.body.x, H.body.y) && !H.dead && Math.abs(E.angleDiff ? E.angleDiff(f.facing, E.angleTo(f.body, H.body)) : 0) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; f.seenT = 0; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : f.seenT + dt; if (!seen && f.seenT > 3) { f.state = 'patrol'; } }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length];\n    const dx = p.x !== undefined ? p.x : p[0], dy = p.y !== undefined ? p.y : p[1];\n    const tx = dx * 16 + 8, ty = dy * 16 + 8;\n    const ddx = tx - f.body.x, ddy = ty - f.body.y, dd = Math.hypot(ddx, ddy);\n    if (dd < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ddx / dd * 26; vy = ddy / dd * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') {\n    f.facing = E.angleTo(f.body, H.body);\n  } else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (dist > 22) { vx = (H.body.x - f.body.x) / dist * 58; vy = (H.body.y - f.body.y) / dist * 58; }\n    if (dist <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead) { if (f.atk.start()) { f.cool = 1.4; } }\n  }\n  f.body.vx = vx; f.body.vy = vy;\n  f.body.update(dt, map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') {\n    f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg || 1, f.body));\n  }\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx: f.body.vx, vy: f.body.vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0,\n    run: vx || vy ? .6 : 0, pose: f.state === 'alert' ? 'guard' : undefined });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const dist = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n  const rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (dist > 22 && !b.atk.busy) { vx = (H.body.x - b.body.x) / dist * 36 * rush; vy = (H.body.y - b.body.y) / dist * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && dist < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = (rush > 1 ? .9 : 1.4);\n  }\n  b.atk.update(dt);\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, 2, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  // the swing wakes the boss's shadow zone on the ground: the telegraph\n  if (b.atk.state && b.atk.state.phase === 'wind') {\n    b.tele = 1;\n  } else b.tele = 0;\n  hurtHeroByTouch(s);\n  // the hero's blade on the boss\n  if (!b.dead) {\n    const d = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n    void d;\n  }\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction hurtHeroByTouch(s) { /* the boss's hits land through its attack; a touch is not a hit */ }\nfunction drawHero(r, H) {\n  const hr = H;\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => hr.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, objective) {\n  const H = (lab && !scenes.demo && lab.hero && game.scene && game.scene.name === 'lab') ? lab.hero : (ds && ds.hero) || (sh && sh.hero) || null;\n  r.overlay(g => {\n    if (H) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (scenes.demo) E.font.text(g, 'ATTRACT: ANY BUTTON', r.W / 2, 8, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    if (msg) E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER: the game over, with a retry. ABOUT: how to play, the source information, the feedback.\n * ========================================================================================= */\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music(null); },\n  update(dt) { if (titleMenu2 && titleMenu2.update(dt)) return; },\n  draw(r) { r.sky(['#2a0c08', '#0c0606']); r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] })); titleMenu2 && titleMenu2.draw(r); }\n};\nlet titleMenu2 = null;\nscenes.over.enter = function () {\n  A.music(null);\n  titleMenu2 = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { y: r => r ? r : 110, onPick: i => {\n    if (i === 0) game.go(progress.scene, { demo: false }, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n  } });\n  titleMenu2.y = (game.H / 2 | 0) + 20;\n};\nconst ABOUT = {\n  pages: ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'],\n  lines: null\n};\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); this.page = (data && data.page) || 0; this.scroll = 0; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || I.pressed('confirm') && this.page === ABOUT.pages.length - 1) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && this.page > 0) { this.page--; this.scroll = 0; }\n    if (I.pressed('right') && this.page < ABOUT.pages.length - 1) { this.page++; this.scroll = 0; }\n    this.scroll = clamp(this.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const pageTitle = ABOUT.pages[this.page];\n    r.overlay(g => {\n      E.font.title(g, pageTitle, r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (this.page + 1) + ' / ' + ABOUT.pages.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n      const body = aboutBody(this.page, r.W - 24);\n      let y = 40 + this.scroll;\n      for (const ln of body) { if (y > 20 && y < r.H - 20) E.font.text(g, ln, 12, y, ln.startsWith('  ') ? '#ffe7a8' : '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen: the engine's font.wrap\nfunction aboutBody(page, w) {\n  const out = [];\n  const add = (s) => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space or the confirm button.');\n    add('Cook: a green band slides across the bar; press at the right moment. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones: stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Dodge, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox symbols.');\n    add('Touch-only screens need a controller or keyboard.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    for (const [k, v] of Object.entries({ Date: s.date, Source: s.source, 'Genre and Perspective': [s.genre, s.perspective].filter(Boolean).join(' · '), Tech: s.tech, 'Art Direction': s.artDirection, Animation: s.animation, Audio: s.audio, Online: s.online, Testing: s.testing, Research: s.research, Environment: s.environment, Model: s.model, Usage: s.usage })) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) {\n    for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  } else if (page === 3) {\n    for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  } else {\n    for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  }\n  return out;\n}\n\n/* ========================================================================================= *\n *  ENDING: Vail is down. The chapel's quiet; the money is in the wall.\n * ========================================================================================= */\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); this.t = 0; if (HUB && HUB.end) {} },\n  update(dt) {\n    this.t += dt;\n    const I = game.input;\n    if (this.t > 2 && (I.anyPressed())) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet, and the rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false, wrap: r.W - 40 });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\n\n/* ========================================================================================= *\n *  WAIT: an AI Hub round, before the hub's start. The round is the desert run, from the same start for everyone.\n * ========================================================================================= */\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; },\n  update() { if (roundStarted) return game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB · GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (ds && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (ds) { ds.phase = 'over'; } });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => { HUB.ready(); });\n}\nconst first = HUB ? 'wait' : 'title';\ngame.start({ scene: first, scenes, debug: { snapshot: () => ({ scene: game.scene && game.scene.name, progress: JSON.parse(JSON.stringify(progress)) }) } });\n// the scene name, for the HUD and tests\nObject.defineProperty(game, 'sceneName', { get() { return game.scene && game.scene.name; }, configurable: true });\nwindow.__breakingDustBowl = { game, scenes, get progress() { return progress; } };\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11247,"cache_read_input_tokens":136369,"cache_creation":{"ephemeral_5m_input_tokens":11247,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"2f83affe-864a-414d-973a-6fd15f6c6b10","timestamp":"2026-11-03T02:23:43.148Z","request_id":"req_011CgfCRL4uwHKNSrjfj35VR","wire_tool_inputs":{"toolu_01Agvg5NoHtaWr7jnKHn3GXR":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (a timed cook), a desert run (sneak past Vail's men, pick up three batches, deliver them to the\n// RV), and a showdown in a chapel ruin. Built on my-3D2dge (the ADVENTURE kit's engine, v0.85.1, with its modules).\n// Controls: WASD / arrows or a pad's stick move; J, X or click swings; Space, Shift or the dash button dashes; Enter,\n// Space or confirm talks and cooks; V changes the view; Escape or Start opens the pause menu (Settings holds the\n// gamepad axis inversion and the button symbols). Attract mode: 10 seconds on the title, then an AI plays (it cheats).\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nconst rgbHex = c => E.toHex ? E.toHex(c) : c;\nconst label = a => game.input.label(a);\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\n\n/* ---- settings: the gamepad's axis inversion (the common fix for a stick that flips), the button symbols ---- */\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts when a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\n/* ---- keys every scene shares ---- */\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the screen, with the gamepad's inversion applied (keyboard and mouse are never inverted)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// a world point under the mouse, or null (aiming)\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction aimAt(body, pt) { return E.angleTo(body, pt); }\n// a one-line prompt in the player's own controls: \"E Talk\" on a keyboard, \"A Talk\" on a pad (PlayStation or Xbox symbols)\nconst prompt = (a, word) => label(a) + ' ' + word;\n// the view toggle and the camera zoom are the player's own; the scene's camera: { zoom: [min, max], start }\nconst camFor = () => (game.scene && game.scene.camera) || {};\nfunction textPrompt(r, s, y) { r.text(s, r.W / 2, y || r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n\n/* ---- the shared rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: (c) => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: c || '#b02a2a' }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: '#b02a2a', pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } }),\n  clerk: () => new E.Humanoid({ size: 1.15, outfit: 'robe', hair: 'ponytail', sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .8 },\n    colors: { skin: '#e8c0a0', hair: '#4a2a1a', cloth: '#7a6aa0', trim: '#f0d0a0', pants: '#7a6aa0', boot: '#4a3a2a', eye: '#2a2a4a' } })\n};\n\n/* ---- the title: a ledge of heroes under a desert sky ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt(), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n\n/* ---- DIALOG helper: talk lines wait for the player; in attract mode they turn themselves ---- */\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: scenes.demo ? 1.8 : 0 }, o || {})); }\n\n/* ========================================================================================= *\n *  TITLE and the menus                                                                        *\n * ========================================================================================= */\nlet titleMenu = null, idle = 0, titleNote = '', noteT = 0;\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    L.enabled = false; game.weather = null; idle = 0; scenes.demo = false; titleNote = ''; game.cam.snap = true;\n    titleMenu = titleMenu || new E.Menu(game, ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'], {\n      y: 0, title: null, box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: (i, item) => titleAction(i),\n      onCancel: () => {}\n    });\n    titleMenu.i = 0;\n    titleMenu.items = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\n    titleMenu.items = titleMenu.items.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() }));\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed() && !(I.pressed('confirm') || I.pressed('start'))) { idle = 0; }\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (titleNote && (noteT -= dt) < 0) titleNote = '';\n    if (!titleMenu.update(dt)) { /* the menu owns the input */ }\n    if (idle > 10) { idle = 0; startDemo(); return; }\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    r.overlay(g => {\n      const touch = game.input.lastDevice === 'touch';\n      const warn = touchOnly() && game.input.lastDevice !== 'gamepad' && game.input.lastDevice !== 'keyboard' ? 'Controller or keyboard required' : '';\n      E.font.text(g, warn || titleNote, r.W / 2, r.H - 44, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if (i !== 3 && touchOnly() && game.input.lastDevice === 'touch') { titleNote = 'Controller or keyboard required'; noteT = 2.5; return; }\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', { demo: false }, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { scenes.demo = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nlet lab = null;   // the lab's state, while in it\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    const demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'lab';\n    A.music('adventure');\n    L.enabled = true; L.ambient = .55;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    lab = { map, demo, phase: 'intro', cook: null, cookDone: 0, talk: new E.Dialog(game),\n      hero: makeHero(h.x, h.y, 'hollis'), tomas: { rig: RIG.tomas(), x: t.x, y: t.y, facing: Math.PI / 2, t: 0 },\n      station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(lab.hero.body.x, lab.hero.body.y, 10); game.follow(null);\n    if (demo) { lab.talk.auto = 1.6; }\n    if (!demo) {\n      const tomas = lab.tomas;\n      say(lab.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n        'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two promises, Tomas.',\n        () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three timed presses: a green band, the sweet spot.'],\n        { name: 'TOMAS', portrait: tomas.rig, onDone: () => { lab.phase = 'free'; } });\n    } else { lab.phase = 'free'; }\n  },\n  update(dt) {\n    if (!lab) return;\n    const I = game.input;\n    if (!scenes.demo && I.anyPressed() === false) { /* idle */ }\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    lab.tomas.t += dt;\n    if (lab.talk.update(dt)) { if (scenes.demo) demoTalk(lab); return; }\n    if (lab.phase === 'cook') return cookStep(dt);\n    if (lab.phase === 'free' || lab.phase === 'after') {\n      const dir = scenes.demo ? aiLabDir() : moveDir();\n      stepHero(dt, dir, { lab: true });\n      const near = (p, r) => Math.hypot(lab.hero.body.x - p.x, lab.hero.body.y - p.y) < r;\n      if (lab.phase === 'free' && !scenes.demo && near(lab.station, 22) && (I.pressed('confirm') || I.clicked()) && lab.cookDone < 3) { I.consumeAll(); startCook(); }\n      if (lab.phase === 'free' && !scenes.demo && near(lab.tomas, 26) && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); tomasTalk(); }\n      if (lab.phase === 'free' && scenes.demo && near(lab.station, 22) && lab.cookDone < 3) startCook();\n      if (lab.cookDone >= 3 && near(lab.exit, 14)) {\n        if (scenes.demo || I.pressed('confirm')) { I.consumeAll(); progress.scene = 'desert'; sfx('door'); game.go('desert', { demo: !!scenes.demo }, { fade: 'iris', seconds: .5 }); }\n      }\n    }\n    if (lab.phase === 'intro') return;\n    if (!scenes.demo && I.pressed('cancel') && lab.phase === 'free') { /* cancel: pause menu handles it */ }\n  },\n  draw(r) {\n    if (!lab) return;\n    lab.map.drawFloor(r);\n    for (const b of lab.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, lab.station.x, lab.station.y);\n    r.shadow(lab.hero.body.x, lab.hero.body.y, 5);\n    lab.map.queueWalls(r);\n    r.prop('barrel', lab.exit.x - 22, lab.exit.y - 16, 0, { size: .9, light: false });\n    r.actor(lab.tomas.x, lab.tomas.y, 0, (g, ox, oy) => lab.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, lab.hero);\n    L.add(lab.station.x, lab.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(lab.exit.x, lab.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (lab.phase === 'cook') cookOverlay(r);\n    lab.talk.draw(r);\n    hud(r, lab.phase === 'free' ? (lab.cookDone < 3 ? 'COOK ' + lab.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT') : '');\n    if (lab.phase === 'free' && !scenes.demo) {\n      const near = Math.hypot(lab.hero.body.x - lab.station.x, lab.hero.body.y - lab.station.y) < 22;\n      if (near && lab.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (lab.cookDone + 1)));\n      else if (Math.hypot(lab.hero.body.x - lab.tomas.x, lab.hero.body.y - lab.tomas.y) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n    }\n  }\n};\nfunction tomasTalk() {\n  const L1 = lab.cookDone >= 3 ? ['Three batches. Mr. Rook, I think the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : lab.cookDone ? ['Batch ' + lab.cookDone + ' is in the bag. Cook the next one when you want the money.'] : ['The station is hot. Press ' + label('confirm') + ' when the band lines up.'];\n  say(lab.talk, L1, { name: 'TOMAS', portrait: lab.tomas.rig });\n}\nfunction demoTalk(l) { /* attract mode closes the box by itself */ }\nfunction startCook() {\n  lab.phase = 'cook';\n  lab.cook = { stage: 0, pos: 0, dir: 1, speed: 1.1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(lab.cook);\n  sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt) {\n  const c = lab.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * c.speed * dt * (1 + c.stage * .25);\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !scenes.demo && (I.pressed('confirm') || I.clicked());\n  if (scenes.demo && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (press) {\n    I.consumeAll();\n    const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n    c.results.push(miss ? .45 : .6 + .4 * acc);\n    c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n    if (++c.stage >= 3) { finishCook(); return; }\n    newZone(c);\n  }\n}\nfunction finishCook() {\n  const pur = lab.cook.results.reduce((a, b) => a + b, 0) / lab.cook.results.length;\n  progress.purity.push(+pur.toFixed(3)); lab.cookDone++; progress.batches = lab.cookDone;\n  lab.phase = 'free'; lab.cook = null;\n  sfx('coin');\n  const lines = pur > .9 ? ['That color. That is the actual color.'] : pur > .75 ? ['Clean enough. Clean enough is what we sell.'] : ['Cloudy. Cloudy is a problem for a man with a lab coat.'];\n  if (!scenes.demo) say(lab.talk, lines.concat(lab.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: lab.hero.rig });\n  game.hitFx && 0;\n}\nfunction cookOverlay(r) {\n  const c = lab.cook;\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = (r.W - W) / 2, y0 = r.H * .3;\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    const zx = x0 + c.zone * W - c.half * W, zw = c.half * 2 * W;\n    E.px.rect(g, Math.round(zx), y0 + 1, Math.round(zw), 12, '#3aa050');\n    const mx = Math.round(x0 + c.pos * W);\n    E.px.rect(g, mx - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, the chapel to go to.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scatter of rocks and cacti, away from the road and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .075) g[y][x] = 'c';\n  }\n  // the road along rows 12-13, the chapel's path north at x 19-21\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }\n  for (let y = 1; y < 12; y++) { put(20, y, ','); }\n  // the RV's compound: adobe walls, a gap at the south gate, the RV inside\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');\n  // the chapel's arena at the north end of the path\n  put(20, 1, 'E');\n  // the start, the three batches, the patrol points (kept clear of rocks and cacti)\n  put(3, 12, 'h');\n  for (const [x, y] of [[9, 20], [15, 6], [36, 17]]) put(x, y, 'b');\n  const PAT = [[12, 12], [18, 12], [22, 18], [22, 22], [35, 20], [35, 15], [21, 7], [21, 11]];\n  for (const [x, y] of PAT) put(x, y, 'g');\n  for (const [x, y] of PAT) { for (const [dx, dy] of [[0, 0]]) if (g[y + dy][x + dx] === 'c' || g[y + dy][x + dx] === '#') put(x + dx, y + dy, '.'); }\n  return g.map(r => r.map(c => c === 'g' ? 'g' : c).join(''));\n}\nconst DESERT_ROWS = buildDesert();\nconst GRUNT_PATROLS = [\n  [[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]\n];\nconst BATCH_SPAWNS = [];\nlet ds = null;\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round), demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'desert';\n    if (round) { progress = Object.assign(freshProgress(), { purity: [.8, .8, .8], batches: 3, scene: 'desert' }); }\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'c': { floor: 'sand', spawn: 'cactus' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const batches = map.findAll('batch').slice(progress.delivered || 0);\n    const cacti = map.findAll('cactus');\n    const grunts = map.findAll('grunt').map((c, i) => makeGrunt(c.x, c.y, GRUNT_PATROLS[i] || [[c.x, c.y]], i));\n    ds = { map, round, demo, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y, 'hollis'), grunts, cacti,\n      batches: batches.map(b => ({ x: b.x, y: b.y, taken: false })), carry: 0,\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: 'run', t: 0, delivering: 0,\n      objective: 'PICK UP THE BATCHES', hubT: 0, hubDone: false, aiTarget: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(ds.hero.body.x, ds.hero.body.y, 10);\n    if (!demo && !round && progress.delivered === 0) {\n      say(ds.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Move with the stick or WASD. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it.'],\n        { name: 'HOLLIS', portrait: ds.hero.rig });\n    }\n    if (round) { ds.phase = 'wait'; }\n    if (HUB && round) { HUB.progress && HUB.progress({ score: 0, label: '0/3 batches' }); }\n  },\n  update(dt) {\n    if (!ds) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (ds.phase === 'wait') { roundWait(dt); return; }\n    if (ds.phase === 'over' || ds.phase === 'won') { ds.t += dt; return; }\n    if (ds.talk.update(dt)) return;\n    ds.t += dt;\n    updateHeroControls(dt, ds);\n    // a foe's sight, attacks, patrols\n    for (const f of ds.grunts) stepFoe(dt, f, ds.hero, ds.map, ds);\n    // the batches: walk over one to pick it up\n    for (const b of ds.batches) if (!b.taken && near(ds.hero.body, b, 12)) { b.taken = true; ds.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    // the drop: deliver every batch carried\n    if (ds.carry > 0 && near(ds.hero.body, ds.drop, 18)) deliver();\n    // the arena: the chapel path, once the batches are gone\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && !scenes.demo) { ds.phase = 'won'; game.go('showdown', {}, { fade: 'iris', seconds: .6 }); }\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && scenes.demo) { ds.phase = 'won'; game.go('showdown', { demo: true }, { fade: 'iris', seconds: .6 }); }\n    ds.objective = progress.delivered < 3 ? (ds.carry ? 'TAKE THEM TO THE RV' : 'PICK UP THE BATCHES  ' + (3 - progress.delivered - ds.carry) + ' LEFT') : 'THE CHAPEL, NORTH';\n    if (ds.round && HUB) hubTick(dt);\n    if (game.time && ds.hero.dead) return;\n    if (ds.hero.dead) return;\n  },\n  draw(r) {\n    if (!ds) return;\n    ds.map.drawFloor(r);\n    for (const c of ds.cacti) r.prop('cactus', c.x, c.y, 0, { size: 1.15 });\n    for (const b of ds.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, ds.drop.x, ds.drop.y);\n    drawArena(r, ds.arena.x, ds.arena.y);\n    r.shadow(ds.hero.body.x, ds.hero.body.y, 5);\n    for (const f of ds.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    ds.map.queueWalls(r);\n    drawHero(r, ds.hero);\n    for (const f of ds.grunts) drawFoe(r, f);\n    ds.talk.draw(r);\n    hud(r, ds.objective);\n    if (ds.phase === 'wait') r.overlay(g => { E.font.text(g, 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }); });\n    if (ds.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (ds.phase === 'over' && !ds.hero.dead) deathCard(r, '');\n    if (ds.roundOver) r.overlay(g => E.font.text(g, ds.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (!ds.talk.open && !ds.hero.dead) {\n      const d = Math.hypot(ds.hero.body.x - ds.drop.x, ds.hero.body.y - ds.drop.y);\n      if (ds.carry > 0 && d < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n    }\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction near(a, b, r) { return Math.hypot(a.body ? a.body.x - b.x : a.x - b.x, a.body ? a.body.y - b.y : a.y - b.y) < r; }\nfunction deliver() {\n  const k = ds.carry; ds.carry = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; progress.cash += Math.round(pur * 100);\n  }\n  sfx('coin');\n  game.note('DELIVERED ' + k + '  $' + progress.cash);\n  if (!scenes.demo && !ds.round) say(ds.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: ds.hero.rig });\n  if (ds.round) roundCheck();\n}\nfunction roundCheck() {\n  if (progress.delivered >= 3) {\n    ds.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n    if (HUB && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); }\n  }\n}\nfunction hubTick(dt) {\n  ds.hubT += dt;\n  if (ds.hubT > 1 && HUB) { ds.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n  if (HUB && HUB.time && HUB.time() >= 0 && ds.phase === 'wait') ds.phase = 'run';\n}\nfunction roundWait(dt) {\n  // the round starts on the hub's clock: a countdown until time reaches 0\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -Infinity) ds.roundOver = 'GO IN ' + Math.ceil(-t);\n  else if (ds.phase === 'wait' && t >= 0) { ds.phase = 'run'; ds.roundOver = null; }\n  if (ds.phase === 'wait' && !HUB) ds.phase = 'run';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers and sweeps; a second phase when he's hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nlet sh = null;\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    scenes.demo = !!(data && data.demo); progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), v = map.find('vail');\n    sh = { map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y, 'hollis'),\n      boss: makeBoss(v.x, v.y), phase: 'intro', t: 0, won: false, lights: [] };\n    game.focus(sh.hero.body.x, sh.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    say(sh.talk, lines, { name: 'VAIL', portrait: sh.boss.rig, onDone: () => { sh.phase = 'fight'; } });\n    if (scenes.demo) sh.phase = 'fight';\n  },\n  update(dt) {\n    if (!sh) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (sh.talk.update(dt)) return;\n    sh.t += dt;\n    if (sh.phase === 'fight') {\n      updateHeroControls(dt, sh, true);\n      stepBoss(dt, sh);\n      if (sh.boss.dead && !sh.won) { sh.won = true; sh.phase = 'won'; A.music('victory'); sh.t = 0; }\n    }\n    if (sh.phase === 'won' && sh.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n    if (sh.hero.dead) return;\n  },\n  draw(r) {\n    if (!sh) return;\n    sh.map.drawFloor(r);\n    r.shadow(sh.hero.body.x, sh.hero.body.y, 5);\n    r.shadow(sh.boss.body.x, sh.boss.body.y, 10, .5);\n    sh.map.queueWalls(r);\n    r.prop('torch', 16, 16, 0, { size: 1.1, light: true });\n    r.prop('torch', 256, 16, 0, { size: 1.1, light: true });\n    L.add(sh.boss.body.x, sh.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, sh.boss);\n    drawHero(r, sh.hero);\n    sh.talk.draw(r);\n    hud(r, sh.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (sh.phase === 'fight' && !sh.boss.dead) r.overlay(g => { E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, sh.boss.hp / sh.boss.maxHp), '#c83a2a'); });\n    if (sh.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (sh.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  Shared things: the hero, foes, the boss, the HUD, the death card, the hub's countdown\n * ========================================================================================= */\nfunction makeHero(x, y, who) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol, i) {\n  const body = new E.Body({ x, y, r: 5 });\n  const f = { body, rig: RIG.grunt(['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'][i % 4]), atk: new E.Attack(i % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt' };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0, patrol: [], idx: 0, state: 'fight', alert: 0, cool: 1.5, seenT: 0, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's control this step: a stick or WASD for a player; the AI in attract mode\nfunction updateHeroControls(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  let dir = [0, 0];\n  if (scenes.demo) dir = aiDir(s, boss);\n  else dir = moveDir();\n  // the dash\n  if (!scenes.demo && I.pressed('dash') && H.dashCool <= 0 && H.dash <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  // aiming: the mouse points the blade at the cursor; the stick and keys aim with the walk\n  if (!scenes.demo && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = aimAt(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  // swing\n  if (!scenes.demo && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (scenes.demo && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [s.boss] : s.grunts;\n  const targets = live(foes).map(f => f.body);\n  H.slash.hits(targets, b => E.inArc(H.body || H, H.facing, b, 24, 1.3, 16) || (boss ? false : false), b => {\n    const f = b.foe; hurtFoe(f, 14, b);\n  });\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s ? s.hero : null;\n  const hero = H || lab.hero;\n  const sp = o && o.speed ? o.speed : 78;\n  if (hero.dead) return;\n  const d = dir || [0, 0];\n  hero.body.vx = d[0] * sp; hero.body.vy = d[1] * sp;\n  hero.body.update(dt, (s && s.map) || (lab && lab.map));\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !scenes.demo)) hero.facing = Math.atan2(d[1], d[0]);\n  hero.rig.update(dt, { x: hero.body.x, y: hero.body.y, z: hero.body.z, vx: hero.body.vx, vy: hero.body.vy, facing: hero.facing,\n    attack: hero.slash ? hero.slash.state : null, hurt: hero.inv > .5, dash: hero.dash > 0 });\n}\nfunction aiDir(s, boss) {\n  // the AI: walk to the next thing (the nearest foe in reach, else the next objective), wiggle when stuck\n  const H = s.hero;\n  let tx, ty;\n  if (boss) { tx = s.boss.body.x; ty = s.boss.body.y; }\n  else if (s.batches) {\n    const next = s.batches.find(b => !b.taken);\n    if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n    else if (next) { tx = next.x; ty = next.y; }\n    else { tx = s.arena.x; ty = s.arena.y; }\n  }\n  if (!tx) return [0, 0];\n  const dx = tx - H.body.x, dy = ty - H.body.y, d = Math.hypot(dx, dy) || 1;\n  if (H.body.hitWall) s.aiWander = .6;\n  if ((s.aiWander = Math.max(0, (s.aiWander || 0) - .016)) > 0) return s.aiDir || [dx / d, dy / d];\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return Math.hypot(s.boss.body.x - H.body.x, s.boss.body.y - H.body.y) < 26 && H.slash.busy === false;\n  return s.grunts.some(f => !f.dead && Math.hypot(f.body.x - H.body.x, f.body.y - H.body.y) < 22 && H.slash.busy === false);\n}\nfunction aiLabDir() {\n  const b = lab.hero.body;\n  const tx = lab.cookDone < 3 ? lab.station.x : lab.exit.x, ty = lab.cookDone < 3 ? lab.station.y : lab.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy) || 1;\n  if (d < 14) return [0, 0];\n  return [dx / d, dy / d];\n}\nfunction hurtFoe(f, dmg, body) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  const H = scenes.hero || null;\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(body, { x: body.x, y: body.y }), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(lab ? lab.hero.body : (ds ? ds.hero.body : sh.hero.body), body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); if (f.name === 'boss') { sh.boss.dead = true; } }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || scenes.demo || H.dead) return;\n  H.hp -= dmg; H.inv = 1.0;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; H.rig.update(0, {}); sfx('die'); }\n}\nfunction stepFoe(dt, f, hero, map, s) {\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const H = hero, dist = Math.hypot(H.body.x - f.body.x, H.body.y - f.body.y);\n  const seen = !scenes.demo && dist < 110 && map.los(f.body.x, f.body.y, H.body.x, H.body.y) && !H.dead && Math.abs(E.angleDiff ? E.angleDiff(f.facing, E.angleTo(f.body, H.body)) : 0) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; f.seenT = 0; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : f.seenT + dt; if (!seen && f.seenT > 3) { f.state = 'patrol'; } }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length];\n    const dx = p.x !== undefined ? p.x : p[0], dy = p.y !== undefined ? p.y : p[1];\n    const tx = dx * 16 + 8, ty = dy * 16 + 8;\n    const ddx = tx - f.body.x, ddy = ty - f.body.y, dd = Math.hypot(ddx, ddy);\n    if (dd < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ddx / dd * 26; vy = ddy / dd * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') {\n    f.facing = E.angleTo(f.body, H.body);\n  } else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (dist > 22) { vx = (H.body.x - f.body.x) / dist * 58; vy = (H.body.y - f.body.y) / dist * 58; }\n    if (dist <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead) { if (f.atk.start()) { f.cool = 1.4; } }\n  }\n  f.body.vx = vx; f.body.vy = vy;\n  f.body.update(dt, map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') {\n    f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg || 1, f.body));\n  }\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx: f.body.vx, vy: f.body.vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0,\n    run: vx || vy ? .6 : 0, pose: f.state === 'alert' ? 'guard' : undefined });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const dist = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n  const rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (dist > 22 && !b.atk.busy) { vx = (H.body.x - b.body.x) / dist * 36 * rush; vy = (H.body.y - b.body.y) / dist * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && dist < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = (rush > 1 ? .9 : 1.4);\n  }\n  b.atk.update(dt);\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, 2, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  // the swing wakes the boss's shadow zone on the ground: the telegraph\n  if (b.atk.state && b.atk.state.phase === 'wind') {\n    b.tele = 1;\n  } else b.tele = 0;\n  hurtHeroByTouch(s);\n  // the hero's blade on the boss\n  if (!b.dead) {\n    const d = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n    void d;\n  }\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction hurtHeroByTouch(s) { /* the boss's hits land through its attack; a touch is not a hit */ }\nfunction drawHero(r, H) {\n  const hr = H;\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => hr.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, objective) {\n  const H = (lab && !scenes.demo && lab.hero && game.scene && game.scene.name === 'lab') ? lab.hero : (ds && ds.hero) || (sh && sh.hero) || null;\n  r.overlay(g => {\n    if (H) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (scenes.demo) E.font.text(g, 'ATTRACT: ANY BUTTON', r.W / 2, 8, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    if (msg) E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER: the game over, with a retry. ABOUT: how to play, the source information, the feedback.\n * ========================================================================================= */\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music(null); },\n  update(dt) { if (titleMenu2 && titleMenu2.update(dt)) return; },\n  draw(r) { r.sky(['#2a0c08', '#0c0606']); r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] })); titleMenu2 && titleMenu2.draw(r); }\n};\nlet titleMenu2 = null;\nscenes.over.enter = function () {\n  A.music(null);\n  titleMenu2 = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { y: r => r ? r : 110, onPick: i => {\n    if (i === 0) game.go(progress.scene, { demo: false }, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n  } });\n  titleMenu2.y = (game.H / 2 | 0) + 20;\n};\nconst ABOUT = {\n  pages: ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'],\n  lines: null\n};\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); this.page = (data && data.page) || 0; this.scroll = 0; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || I.pressed('confirm') && this.page === ABOUT.pages.length - 1) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && this.page > 0) { this.page--; this.scroll = 0; }\n    if (I.pressed('right') && this.page < ABOUT.pages.length - 1) { this.page++; this.scroll = 0; }\n    this.scroll = clamp(this.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const pageTitle = ABOUT.pages[this.page];\n    r.overlay(g => {\n      E.font.title(g, pageTitle, r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (this.page + 1) + ' / ' + ABOUT.pages.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n      const body = aboutBody(this.page, r.W - 24);\n      let y = 40 + this.scroll;\n      for (const ln of body) { if (y > 20 && y < r.H - 20) E.font.text(g, ln, 12, y, ln.startsWith('  ') ? '#ffe7a8' : '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen: the engine's font.wrap\nfunction aboutBody(page, w) {\n  const out = [];\n  const add = (s) => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space or the confirm button.');\n    add('Cook: a green band slides across the bar; press at the right moment. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones: stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Dodge, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox symbols.');\n    add('Touch-only screens need a controller or keyboard.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    for (const [k, v] of Object.entries({ Date: s.date, Source: s.source, 'Genre and Perspective': [s.genre, s.perspective].filter(Boolean).join(' · '), Tech: s.tech, 'Art Direction': s.artDirection, Animation: s.animation, Audio: s.audio, Online: s.online, Testing: s.testing, Research: s.research, Environment: s.environment, Model: s.model, Usage: s.usage })) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) {\n    for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  } else if (page === 3) {\n    for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  } else {\n    for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  }\n  return out;\n}\n\n/* ========================================================================================= *\n *  ENDING: Vail is down. The chapel's quiet; the money is in the wall.\n * ========================================================================================= */\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); this.t = 0; if (HUB && HUB.end) {} },\n  update(dt) {\n    this.t += dt;\n    const I = game.input;\n    if (this.t > 2 && (I.anyPressed())) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet, and the rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false, wrap: r.W - 40 });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\n\n/* ========================================================================================= *\n *  WAIT: an AI Hub round, before the hub's start. The round is the desert run, from the same start for everyone.\n * ========================================================================================= */\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; },\n  update() { if (roundStarted) return game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB · GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (ds && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (ds) { ds.phase = 'over'; } });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => { HUB.ready(); });\n}\nconst first = HUB ? 'wait' : 'title';\ngame.start({ scene: first, scenes, debug: { snapshot: () => ({ scene: game.scene && game.scene.name, progress: JSON.parse(JSON.stringify(progress)) }) } });\n// the scene name, for the HUD and tests\nObject.defineProperty(game, 'sceneName', { get() { return game.scene && game.scene.name; }, configurable: true });\nwindow.__breakingDustBowl = { game, scenes, get progress() { return progress; } };\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Agvg5NoHtaWr7jnKHn3GXR","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"e7bf73a6-90a9-494b-8290-0732acb665b8","timestamp":"2026-11-03T02:23:43.175Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (a timed cook), a desert run (sneak past Vail's men, pick up three batches, deliver them to the\n// RV), and a showdown in a chapel ruin. Built on my-3D2dge (the ADVENTURE kit's engine, v0.85.1, with its modules).\n// Controls: WASD / arrows or a pad's stick move; J, X or click swings; Space, Shift or the dash button dashes; Enter,\n// Space or confirm talks and cooks; V changes the view; Escape or Start opens the pause menu (Settings holds the\n// gamepad axis inversion and the button symbols). Attract mode: 10 seconds on the title, then an AI plays (it cheats).\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nconst rgbHex = c => E.toHex ? E.toHex(c) : c;\nconst label = a => game.input.label(a);\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\n\n/* ---- settings: the gamepad's axis inversion (the common fix for a stick that flips), the button symbols ---- */\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts when a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\n/* ---- keys every scene shares ---- */\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the screen, with the gamepad's inversion applied (keyboard and mouse are never inverted)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// a world point under the mouse, or null (aiming)\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction aimAt(body, pt) { return E.angleTo(body, pt); }\n// a one-line prompt in the player's own controls: \"E Talk\" on a keyboard, \"A Talk\" on a pad (PlayStation or Xbox symbols)\nconst prompt = (a, word) => label(a) + ' ' + word;\n// the view toggle and the camera zoom are the player's own; the scene's camera: { zoom: [min, max], start }\nconst camFor = () => (game.scene && game.scene.camera) || {};\nfunction textPrompt(r, s, y) { r.text(s, r.W / 2, y || r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n\n/* ---- the shared rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: (c) => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: c || '#b02a2a' }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: '#b02a2a', pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } }),\n  clerk: () => new E.Humanoid({ size: 1.15, outfit: 'robe', hair: 'ponytail', sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .8 },\n    colors: { skin: '#e8c0a0', hair: '#4a2a1a', cloth: '#7a6aa0', trim: '#f0d0a0', pants: '#7a6aa0', boot: '#4a3a2a', eye: '#2a2a4a' } })\n};\n\n/* ---- the title: a ledge of heroes under a desert sky ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt(), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n\n/* ---- DIALOG helper: talk lines wait for the player; in attract mode they turn themselves ---- */\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: scenes.demo ? 1.8 : 0 }, o || {})); }\n\n/* ========================================================================================= *\n *  TITLE and the menus                                                                        *\n * ========================================================================================= */\nlet titleMenu = null, idle = 0, titleNote = '', noteT = 0;\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    L.enabled = false; game.weather = null; idle = 0; scenes.demo = false; titleNote = ''; game.cam.snap = true;\n    titleMenu = titleMenu || new E.Menu(game, ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'], {\n      y: 0, title: null, box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: (i, item) => titleAction(i),\n      onCancel: () => {}\n    });\n    titleMenu.i = 0;\n    titleMenu.items = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\n    titleMenu.items = titleMenu.items.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() }));\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed() && !(I.pressed('confirm') || I.pressed('start'))) { idle = 0; }\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (titleNote && (noteT -= dt) < 0) titleNote = '';\n    if (!titleMenu.update(dt)) { /* the menu owns the input */ }\n    if (idle > 10) { idle = 0; startDemo(); return; }\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    r.overlay(g => {\n      const touch = game.input.lastDevice === 'touch';\n      const warn = touchOnly() && game.input.lastDevice !== 'gamepad' && game.input.lastDevice !== 'keyboard' ? 'Controller or keyboard required' : '';\n      E.font.text(g, warn || titleNote, r.W / 2, r.H - 44, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if (i !== 3 && touchOnly() && game.input.lastDevice === 'touch') { titleNote = 'Controller or keyboard required'; noteT = 2.5; return; }\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', { demo: false }, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { scenes.demo = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nlet lab = null;   // the lab's state, while in it\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    const demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'lab';\n    A.music('adventure');\n    L.enabled = true; L.ambient = .55;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    lab = { map, demo, phase: 'intro', cook: null, cookDone: 0, talk: new E.Dialog(game),\n      hero: makeHero(h.x, h.y, 'hollis'), tomas: { rig: RIG.tomas(), x: t.x, y: t.y, facing: Math.PI / 2, t: 0 },\n      station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(lab.hero.body.x, lab.hero.body.y, 10); game.follow(null);\n    if (demo) { lab.talk.auto = 1.6; }\n    if (!demo) {\n      const tomas = lab.tomas;\n      say(lab.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n        'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two promises, Tomas.',\n        () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three timed presses: a green band, the sweet spot.'],\n        { name: 'TOMAS', portrait: tomas.rig, onDone: () => { lab.phase = 'free'; } });\n    } else { lab.phase = 'free'; }\n  },\n  update(dt) {\n    if (!lab) return;\n    const I = game.input;\n    if (!scenes.demo && I.anyPressed() === false) { /* idle */ }\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    lab.tomas.t += dt;\n    if (lab.talk.update(dt)) { if (scenes.demo) demoTalk(lab); return; }\n    if (lab.phase === 'cook') return cookStep(dt);\n    if (lab.phase === 'free' || lab.phase === 'after') {\n      const dir = scenes.demo ? aiLabDir() : moveDir();\n      stepHero(dt, dir, { lab: true });\n      const near = (p, r) => Math.hypot(lab.hero.body.x - p.x, lab.hero.body.y - p.y) < r;\n      if (lab.phase === 'free' && !scenes.demo && near(lab.station, 22) && (I.pressed('confirm') || I.clicked()) && lab.cookDone < 3) { I.consumeAll(); startCook(); }\n      if (lab.phase === 'free' && !scenes.demo && near(lab.tomas, 26) && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); tomasTalk(); }\n      if (lab.phase === 'free' && scenes.demo && near(lab.station, 22) && lab.cookDone < 3) startCook();\n      if (lab.cookDone >= 3 && near(lab.exit, 14)) {\n        if (scenes.demo || I.pressed('confirm')) { I.consumeAll(); progress.scene = 'desert'; sfx('door'); game.go('desert', { demo: !!scenes.demo }, { fade: 'iris', seconds: .5 }); }\n      }\n    }\n    if (lab.phase === 'intro') return;\n    if (!scenes.demo && I.pressed('cancel') && lab.phase === 'free') { /* cancel: pause menu handles it */ }\n  },\n  draw(r) {\n    if (!lab) return;\n    lab.map.drawFloor(r);\n    for (const b of lab.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, lab.station.x, lab.station.y);\n    r.shadow(lab.hero.body.x, lab.hero.body.y, 5);\n    lab.map.queueWalls(r);\n    r.prop('barrel', lab.exit.x - 22, lab.exit.y - 16, 0, { size: .9, light: false });\n    r.actor(lab.tomas.x, lab.tomas.y, 0, (g, ox, oy) => lab.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, lab.hero);\n    L.add(lab.station.x, lab.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(lab.exit.x, lab.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (lab.phase === 'cook') cookOverlay(r);\n    lab.talk.draw(r);\n    hud(r, lab.phase === 'free' ? (lab.cookDone < 3 ? 'COOK ' + lab.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT') : '');\n    if (lab.phase === 'free' && !scenes.demo) {\n      const near = Math.hypot(lab.hero.body.x - lab.station.x, lab.hero.body.y - lab.station.y) < 22;\n      if (near && lab.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (lab.cookDone + 1)));\n      else if (Math.hypot(lab.hero.body.x - lab.tomas.x, lab.hero.body.y - lab.tomas.y) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n    }\n  }\n};\nfunction tomasTalk() {\n  const L1 = lab.cookDone >= 3 ? ['Three batches. Mr. Rook, I think the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : lab.cookDone ? ['Batch ' + lab.cookDone + ' is in the bag. Cook the next one when you want the money.'] : ['The station is hot. Press ' + label('confirm') + ' when the band lines up.'];\n  say(lab.talk, L1, { name: 'TOMAS', portrait: lab.tomas.rig });\n}\nfunction demoTalk(l) { /* attract mode closes the box by itself */ }\nfunction startCook() {\n  lab.phase = 'cook';\n  lab.cook = { stage: 0, pos: 0, dir: 1, speed: 1.1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(lab.cook);\n  sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt) {\n  const c = lab.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * c.speed * dt * (1 + c.stage * .25);\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !scenes.demo && (I.pressed('confirm') || I.clicked());\n  if (scenes.demo && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (press) {\n    I.consumeAll();\n    const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n    c.results.push(miss ? .45 : .6 + .4 * acc);\n    c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n    if (++c.stage >= 3) { finishCook(); return; }\n    newZone(c);\n  }\n}\nfunction finishCook() {\n  const pur = lab.cook.results.reduce((a, b) => a + b, 0) / lab.cook.results.length;\n  progress.purity.push(+pur.toFixed(3)); lab.cookDone++; progress.batches = lab.cookDone;\n  lab.phase = 'free'; lab.cook = null;\n  sfx('coin');\n  const lines = pur > .9 ? ['That color. That is the actual color.'] : pur > .75 ? ['Clean enough. Clean enough is what we sell.'] : ['Cloudy. Cloudy is a problem for a man with a lab coat.'];\n  if (!scenes.demo) say(lab.talk, lines.concat(lab.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: lab.hero.rig });\n  game.hitFx && 0;\n}\nfunction cookOverlay(r) {\n  const c = lab.cook;\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = (r.W - W) / 2, y0 = r.H * .3;\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    const zx = x0 + c.zone * W - c.half * W, zw = c.half * 2 * W;\n    E.px.rect(g, Math.round(zx), y0 + 1, Math.round(zw), 12, '#3aa050');\n    const mx = Math.round(x0 + c.pos * W);\n    E.px.rect(g, mx - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, the chapel to go to.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scatter of rocks and cacti, away from the road and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .075) g[y][x] = 'c';\n  }\n  // the road along rows 12-13, the chapel's path north at x 19-21\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }\n  for (let y = 1; y < 12; y++) { put(20, y, ','); }\n  // the RV's compound: adobe walls, a gap at the south gate, the RV inside\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');\n  // the chapel's arena at the north end of the path\n  put(20, 1, 'E');\n  // the start, the three batches, the patrol points (kept clear of rocks and cacti)\n  put(3, 12, 'h');\n  for (const [x, y] of [[9, 20], [15, 6], [36, 17]]) put(x, y, 'b');\n  const PAT = [[12, 12], [18, 12], [22, 18], [22, 22], [35, 20], [35, 15], [21, 7], [21, 11]];\n  for (const [x, y] of PAT) put(x, y, 'g');\n  for (const [x, y] of PAT) { for (const [dx, dy] of [[0, 0]]) if (g[y + dy][x + dx] === 'c' || g[y + dy][x + dx] === '#') put(x + dx, y + dy, '.'); }\n  return g.map(r => r.map(c => c === 'g' ? 'g' : c).join(''));\n}\nconst DESERT_ROWS = buildDesert();\nconst GRUNT_PATROLS = [\n  [[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]\n];\nconst BATCH_SPAWNS = [];\nlet ds = null;\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round), demo = !!(data && data.demo);\n    scenes.demo = demo; progress.scene = 'desert';\n    if (round) { progress = Object.assign(freshProgress(), { purity: [.8, .8, .8], batches: 3, scene: 'desert' }); }\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'c': { floor: 'sand', spawn: 'cactus' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const batches = map.findAll('batch').slice(progress.delivered || 0);\n    const cacti = map.findAll('cactus');\n    const grunts = map.findAll('grunt').map((c, i) => makeGrunt(c.x, c.y, GRUNT_PATROLS[i] || [[c.x, c.y]], i));\n    ds = { map, round, demo, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y, 'hollis'), grunts, cacti,\n      batches: batches.map(b => ({ x: b.x, y: b.y, taken: false })), carry: 0,\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: 'run', t: 0, delivering: 0,\n      objective: 'PICK UP THE BATCHES', hubT: 0, hubDone: false, aiTarget: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(ds.hero.body.x, ds.hero.body.y, 10);\n    if (!demo && !round && progress.delivered === 0) {\n      say(ds.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Move with the stick or WASD. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it.'],\n        { name: 'HOLLIS', portrait: ds.hero.rig });\n    }\n    if (round) { ds.phase = 'wait'; }\n    if (HUB && round) { HUB.progress && HUB.progress({ score: 0, label: '0/3 batches' }); }\n  },\n  update(dt) {\n    if (!ds) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (ds.phase === 'wait') { roundWait(dt); return; }\n    if (ds.phase === 'over' || ds.phase === 'won') { ds.t += dt; return; }\n    if (ds.talk.update(dt)) return;\n    ds.t += dt;\n    updateHeroControls(dt, ds);\n    // a foe's sight, attacks, patrols\n    for (const f of ds.grunts) stepFoe(dt, f, ds.hero, ds.map, ds);\n    // the batches: walk over one to pick it up\n    for (const b of ds.batches) if (!b.taken && near(ds.hero.body, b, 12)) { b.taken = true; ds.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    // the drop: deliver every batch carried\n    if (ds.carry > 0 && near(ds.hero.body, ds.drop, 18)) deliver();\n    // the arena: the chapel path, once the batches are gone\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && !scenes.demo) { ds.phase = 'won'; game.go('showdown', {}, { fade: 'iris', seconds: .6 }); }\n    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && scenes.demo) { ds.phase = 'won'; game.go('showdown', { demo: true }, { fade: 'iris', seconds: .6 }); }\n    ds.objective = progress.delivered < 3 ? (ds.carry ? 'TAKE THEM TO THE RV' : 'PICK UP THE BATCHES  ' + (3 - progress.delivered - ds.carry) + ' LEFT') : 'THE CHAPEL, NORTH';\n    if (ds.round && HUB) hubTick(dt);\n    if (game.time && ds.hero.dead) return;\n    if (ds.hero.dead) return;\n  },\n  draw(r) {\n    if (!ds) return;\n    ds.map.drawFloor(r);\n    for (const c of ds.cacti) r.prop('cactus', c.x, c.y, 0, { size: 1.15 });\n    for (const b of ds.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, ds.drop.x, ds.drop.y);\n    drawArena(r, ds.arena.x, ds.arena.y);\n    r.shadow(ds.hero.body.x, ds.hero.body.y, 5);\n    for (const f of ds.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    ds.map.queueWalls(r);\n    drawHero(r, ds.hero);\n    for (const f of ds.grunts) drawFoe(r, f);\n    ds.talk.draw(r);\n    hud(r, ds.objective);\n    if (ds.phase === 'wait') r.overlay(g => { E.font.text(g, 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }); });\n    if (ds.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (ds.phase === 'over' && !ds.hero.dead) deathCard(r, '');\n    if (ds.roundOver) r.overlay(g => E.font.text(g, ds.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (!ds.talk.open && !ds.hero.dead) {\n      const d = Math.hypot(ds.hero.body.x - ds.drop.x, ds.hero.body.y - ds.drop.y);\n      if (ds.carry > 0 && d < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n    }\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction near(a, b, r) { return Math.hypot(a.body ? a.body.x - b.x : a.x - b.x, a.body ? a.body.y - b.y : a.y - b.y) < r; }\nfunction deliver() {\n  const k = ds.carry; ds.carry = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; progress.cash += Math.round(pur * 100);\n  }\n  sfx('coin');\n  game.note('DELIVERED ' + k + '  $' + progress.cash);\n  if (!scenes.demo && !ds.round) say(ds.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: ds.hero.rig });\n  if (ds.round) roundCheck();\n}\nfunction roundCheck() {\n  if (progress.delivered >= 3) {\n    ds.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n    if (HUB && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); }\n  }\n}\nfunction hubTick(dt) {\n  ds.hubT += dt;\n  if (ds.hubT > 1 && HUB) { ds.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n  if (HUB && HUB.time && HUB.time() >= 0 && ds.phase === 'wait') ds.phase = 'run';\n}\nfunction roundWait(dt) {\n  // the round starts on the hub's clock: a countdown until time reaches 0\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -Infinity) ds.roundOver = 'GO IN ' + Math.ceil(-t);\n  else if (ds.phase === 'wait' && t >= 0) { ds.phase = 'run'; ds.roundOver = null; }\n  if (ds.phase === 'wait' && !HUB) ds.phase = 'run';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers and sweeps; a second phase when he's hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nlet sh = null;\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    scenes.demo = !!(data && data.demo); progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v);\n    const h = map.find('hero'), v = map.find('vail');\n    sh = { map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y, 'hollis'),\n      boss: makeBoss(v.x, v.y), phase: 'intro', t: 0, won: false, lights: [] };\n    game.focus(sh.hero.body.x, sh.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    say(sh.talk, lines, { name: 'VAIL', portrait: sh.boss.rig, onDone: () => { sh.phase = 'fight'; } });\n    if (scenes.demo) sh.phase = 'fight';\n  },\n  update(dt) {\n    if (!sh) return;\n    const I = game.input;\n    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (sh.talk.update(dt)) return;\n    sh.t += dt;\n    if (sh.phase === 'fight') {\n      updateHeroControls(dt, sh, true);\n      stepBoss(dt, sh);\n      if (sh.boss.dead && !sh.won) { sh.won = true; sh.phase = 'won'; A.music('victory'); sh.t = 0; }\n    }\n    if (sh.phase === 'won' && sh.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n    if (sh.hero.dead) return;\n  },\n  draw(r) {\n    if (!sh) return;\n    sh.map.drawFloor(r);\n    r.shadow(sh.hero.body.x, sh.hero.body.y, 5);\n    r.shadow(sh.boss.body.x, sh.boss.body.y, 10, .5);\n    sh.map.queueWalls(r);\n    r.prop('torch', 16, 16, 0, { size: 1.1, light: true });\n    r.prop('torch', 256, 16, 0, { size: 1.1, light: true });\n    L.add(sh.boss.body.x, sh.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, sh.boss);\n    drawHero(r, sh.hero);\n    sh.talk.draw(r);\n    hud(r, sh.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (sh.phase === 'fight' && !sh.boss.dead) r.overlay(g => { E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, sh.boss.hp / sh.boss.maxHp), '#c83a2a'); });\n    if (sh.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (sh.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  Shared things: the hero, foes, the boss, the HUD, the death card, the hub's countdown\n * ========================================================================================= */\nfunction makeHero(x, y, who) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol, i) {\n  const body = new E.Body({ x, y, r: 5 });\n  const f = { body, rig: RIG.grunt(['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'][i % 4]), atk: new E.Attack(i % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt' };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0, patrol: [], idx: 0, state: 'fight', alert: 0, cool: 1.5, seenT: 0, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's control this step: a stick or WASD for a player; the AI in attract mode\nfunction updateHeroControls(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  let dir = [0, 0];\n  if (scenes.demo) dir = aiDir(s, boss);\n  else dir = moveDir();\n  // the dash\n  if (!scenes.demo && I.pressed('dash') && H.dashCool <= 0 && H.dash <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  // aiming: the mouse points the blade at the cursor; the stick and keys aim with the walk\n  if (!scenes.demo && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = aimAt(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  // swing\n  if (!scenes.demo && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (scenes.demo && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [s.boss] : s.grunts;\n  const targets = live(foes).map(f => f.body);\n  H.slash.hits(targets, b => E.inArc(H.body || H, H.facing, b, 24, 1.3, 16) || (boss ? false : false), b => {\n    const f = b.foe; hurtFoe(f, 14, b);\n  });\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s ? s.hero : null;\n  const hero = H || lab.hero;\n  const sp = o && o.speed ? o.speed : 78;\n  if (hero.dead) return;\n  const d = dir || [0, 0];\n  hero.body.vx = d[0] * sp; hero.body.vy = d[1] * sp;\n  hero.body.update(dt, (s && s.map) || (lab && lab.map));\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !scenes.demo)) hero.facing = Math.atan2(d[1], d[0]);\n  hero.rig.update(dt, { x: hero.body.x, y: hero.body.y, z: hero.body.z, vx: hero.body.vx, vy: hero.body.vy, facing: hero.facing,\n    attack: hero.slash ? hero.slash.state : null, hurt: hero.inv > .5, dash: hero.dash > 0 });\n}\nfunction aiDir(s, boss) {\n  // the AI: walk to the next thing (the nearest foe in reach, else the next objective), wiggle when stuck\n  const H = s.hero;\n  let tx, ty;\n  if (boss) { tx = s.boss.body.x; ty = s.boss.body.y; }\n  else if (s.batches) {\n    const next = s.batches.find(b => !b.taken);\n    if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n    else if (next) { tx = next.x; ty = next.y; }\n    else { tx = s.arena.x; ty = s.arena.y; }\n  }\n  if (!tx) return [0, 0];\n  const dx = tx - H.body.x, dy = ty - H.body.y, d = Math.hypot(dx, dy) || 1;\n  if (H.body.hitWall) s.aiWander = .6;\n  if ((s.aiWander = Math.max(0, (s.aiWander || 0) - .016)) > 0) return s.aiDir || [dx / d, dy / d];\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return Math.hypot(s.boss.body.x - H.body.x, s.boss.body.y - H.body.y) < 26 && H.slash.busy === false;\n  return s.grunts.some(f => !f.dead && Math.hypot(f.body.x - H.body.x, f.body.y - H.body.y) < 22 && H.slash.busy === false);\n}\nfunction aiLabDir() {\n  const b = lab.hero.body;\n  const tx = lab.cookDone < 3 ? lab.station.x : lab.exit.x, ty = lab.cookDone < 3 ? lab.station.y : lab.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy) || 1;\n  if (d < 14) return [0, 0];\n  return [dx / d, dy / d];\n}\nfunction hurtFoe(f, dmg, body) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  const H = scenes.hero || null;\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(body, { x: body.x, y: body.y }), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(lab ? lab.hero.body : (ds ? ds.hero.body : sh.hero.body), body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); if (f.name === 'boss') { sh.boss.dead = true; } }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || scenes.demo || H.dead) return;\n  H.hp -= dmg; H.inv = 1.0;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; H.rig.update(0, {}); sfx('die'); }\n}\nfunction stepFoe(dt, f, hero, map, s) {\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const H = hero, dist = Math.hypot(H.body.x - f.body.x, H.body.y - f.body.y);\n  const seen = !scenes.demo && dist < 110 && map.los(f.body.x, f.body.y, H.body.x, H.body.y) && !H.dead && Math.abs(E.angleDiff ? E.angleDiff(f.facing, E.angleTo(f.body, H.body)) : 0) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; f.seenT = 0; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : f.seenT + dt; if (!seen && f.seenT > 3) { f.state = 'patrol'; } }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length];\n    const dx = p.x !== undefined ? p.x : p[0], dy = p.y !== undefined ? p.y : p[1];\n    const tx = dx * 16 + 8, ty = dy * 16 + 8;\n    const ddx = tx - f.body.x, ddy = ty - f.body.y, dd = Math.hypot(ddx, ddy);\n    if (dd < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ddx / dd * 26; vy = ddy / dd * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') {\n    f.facing = E.angleTo(f.body, H.body);\n  } else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (dist > 22) { vx = (H.body.x - f.body.x) / dist * 58; vy = (H.body.y - f.body.y) / dist * 58; }\n    if (dist <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead) { if (f.atk.start()) { f.cool = 1.4; } }\n  }\n  f.body.vx = vx; f.body.vy = vy;\n  f.body.update(dt, map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') {\n    f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg || 1, f.body));\n  }\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx: f.body.vx, vy: f.body.vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0,\n    run: vx || vy ? .6 : 0, pose: f.state === 'alert' ? 'guard' : undefined });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const dist = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n  const rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (dist > 22 && !b.atk.busy) { vx = (H.body.x - b.body.x) / dist * 36 * rush; vy = (H.body.y - b.body.y) / dist * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && dist < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = (rush > 1 ? .9 : 1.4);\n  }\n  b.atk.update(dt);\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, 2, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  // the swing wakes the boss's shadow zone on the ground: the telegraph\n  if (b.atk.state && b.atk.state.phase === 'wind') {\n    b.tele = 1;\n  } else b.tele = 0;\n  hurtHeroByTouch(s);\n  // the hero's blade on the boss\n  if (!b.dead) {\n    const d = Math.hypot(H.body.x - b.body.x, H.body.y - b.body.y);\n    void d;\n  }\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction hurtHeroByTouch(s) { /* the boss's hits land through its attack; a touch is not a hit */ }\nfunction drawHero(r, H) {\n  const hr = H;\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => hr.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, objective) {\n  const H = (lab && !scenes.demo && lab.hero && game.scene && game.scene.name === 'lab') ? lab.hero : (ds && ds.hero) || (sh && sh.hero) || null;\n  r.overlay(g => {\n    if (H) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (scenes.demo) E.font.text(g, 'ATTRACT: ANY BUTTON', r.W / 2, 8, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    if (msg) E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER: the game over, with a retry. ABOUT: how to play, the source information, the feedback.\n * ========================================================================================= */\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music(null); },\n  update(dt) { if (titleMenu2 && titleMenu2.update(dt)) return; },\n  draw(r) { r.sky(['#2a0c08', '#0c0606']); r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] })); titleMenu2 && titleMenu2.draw(r); }\n};\nlet titleMenu2 = null;\nscenes.over.enter = function () {\n  A.music(null);\n  titleMenu2 = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { y: r => r ? r : 110, onPick: i => {\n    if (i === 0) game.go(progress.scene, { demo: false }, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n  } });\n  titleMenu2.y = (game.H / 2 | 0) + 20;\n};\nconst ABOUT = {\n  pages: ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'],\n  lines: null\n};\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); this.page = (data && data.page) || 0; this.scroll = 0; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || I.pressed('confirm') && this.page === ABOUT.pages.length - 1) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && this.page > 0) { this.page--; this.scroll = 0; }\n    if (I.pressed('right') && this.page < ABOUT.pages.length - 1) { this.page++; this.scroll = 0; }\n    this.scroll = clamp(this.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const pageTitle = ABOUT.pages[this.page];\n    r.overlay(g => {\n      E.font.title(g, pageTitle, r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (this.page + 1) + ' / ' + ABOUT.pages.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n      const body = aboutBody(this.page, r.W - 24);\n      let y = 40 + this.scroll;\n      for (const ln of body) { if (y > 20 && y < r.H - 20) E.font.text(g, ln, 12, y, ln.startsWith('  ') ? '#ffe7a8' : '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen: the engine's font.wrap\nfunction aboutBody(page, w) {\n  const out = [];\n  const add = (s) => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space or the confirm button.');\n    add('Cook: a green band slides across the bar; press at the right moment. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones: stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Dodge, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox symbols.');\n    add('Touch-only screens need a controller or keyboard.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    for (const [k, v] of Object.entries({ Date: s.date, Source: s.source, 'Genre and Perspective': [s.genre, s.perspective].filter(Boolean).join(' · '), Tech: s.tech, 'Art Direction': s.artDirection, Animation: s.animation, Audio: s.audio, Online: s.online, Testing: s.testing, Research: s.research, Environment: s.environment, Model: s.model, Usage: s.usage })) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) {\n    for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  } else if (page === 3) {\n    for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  } else {\n    for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  }\n  return out;\n}\n\n/* ========================================================================================= *\n *  ENDING: Vail is down. The chapel's quiet; the money is in the wall.\n * ========================================================================================= */\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); this.t = 0; if (HUB && HUB.end) {} },\n  update(dt) {\n    this.t += dt;\n    const I = game.input;\n    if (this.t > 2 && (I.anyPressed())) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet, and the rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false, wrap: r.W - 40 });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\n\n/* ========================================================================================= *\n *  WAIT: an AI Hub round, before the hub's start. The round is the desert run, from the same start for everyone.\n * ========================================================================================= */\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; },\n  update() { if (roundStarted) return game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB · GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (ds && !ds.hubDone) { ds.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (ds) { ds.phase = 'over'; } });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => { HUB.ready(); });\n}\nconst first = HUB ? 'wait' : 'title';\ngame.start({ scene: first, scenes, debug: { snapshot: () => ({ scene: game.scene && game.scene.name, progress: JSON.parse(JSON.stringify(progress)) }) } });\n// the scene name, for the HUD and tests\nObject.defineProperty(game, 'sceneName', { get() { return game.scene && game.scene.name; }, configurable: true });\nwindow.__breakingDustBowl = { game, scenes, get progress() { return progress; } };\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Agvg5NoHtaWr7jnKHn3GXR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
