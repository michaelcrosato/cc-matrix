{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCY1H1aEVefK7M422yb","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26022,"cache_read_input_tokens":147616,"cache_creation":{"ephemeral_5m_input_tokens":26022,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"fab4355a-bb76-42e2-a5bf-a3ba4c02097c","timestamp":"2026-11-03T02:24:17.636Z","request_id":"req_011CgfCXzuRR2xrZMD4AV9YL","thinking_duration_ms":33655,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCY1H1aEVefK7M422yb","type":"message","role":"assistant","content":[{"type":"text","text":"The first draft has real defects I can see on re-read: the demo flag lives on the `scenes` map, the hub round's grunt patrols can be mis-assigned, scenes rely on `this`, and there's no per-frame camera follow or death timer. I'm rewriting the file cleanly rather than patching it."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26022,"cache_read_input_tokens":147616,"cache_creation":{"ephemeral_5m_input_tokens":26022,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"4b5269f5-deb5-4c64-88de-3e4237b9c2b2","timestamp":"2026-11-03T02:24:18.222Z","request_id":"req_011CgfCXzuRR2xrZMD4AV9YL"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgfCY1H1aEVefK7M422yb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EhgyFBLq4rRMAu4EW1Si8h","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (three timed cooks), a desert run (dodge Vail's men by their sight cones, pick up three batches,\n// deliver them to the RV), then a showdown in a chapel ruin. Built on my-3D2dge v0.85.1 (the ADVENTURE kit's engine).\n// Keys: WASD or arrows move; J, X or click swings; Space or Shift dashes; Enter or Space confirms (talk, cook); V changes\n// the view; - and = zoom; M mutes; Escape or Start opens the pause menu (Settings: gamepad axis inversion, button symbols).\n// Attract mode: 10 seconds on the title, then an AI plays (it cheats: it can't be hurt). Any button ends it.\n// AI Hub: opened from the hub, the page skips the title and plays one round of the desert run, parallel mode.\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst L = game.lights, A = game.audio;\nconst scenes = {};\nlet DEMO = false;          // attract mode (or a demo run): an AI plays, the player's buttons end it\nlet cur = null;            // the active chapter's state: lab, ds (desert) or sh (showdown)\nconst label = a => game.input.label(a);\n// a touch-only screen (no mouse, no keyboard, no pad): it needs a controller or keyboard\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\nconst needsPad = () => touchOnly() && !['keyboard', 'gamepad', 'mouse'].includes(game.input.lastDevice);\nconst prompt = (a, word) => label(a) + ' ' + word;\n\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts while a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the ground: a pad's axes are inverted when the player's settings say so (keys and mouse never are)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// the world point under the mouse (the blade aims at it), or null\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction angDiff(a, b) { return Math.abs(((b - a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI); }\nfunction textPrompt(r, s) { r.text(s, r.W / 2, r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n// a dialog in attract mode closes itself; in play it waits for the player\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: DEMO ? 1.8 : 0 }, o || {})); }\n\n/* ---- the rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: hat => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: hat }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: hat, pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } })\n};\n\n/* ========================================================================================= *\n *  TITLE: a ledge of heroes under a desert sky. NEW GAME, CONTINUE (a save), ABOUT, OPTIONS.\n * ========================================================================================= */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt('#b02a2a'), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\nlet titleMenu = null, idle = 0;\nconst TITLE_ITEMS = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() {\n    A.music('title'); DEMO = false; cur = null; idle = 0; game.weather = null; L.enabled = false;\n    game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    titleMenu = new E.Menu(game, TITLE_ITEMS.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() })), {\n      box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: i => titleAction(i)\n    });\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (idle > 10) { idle = 0; return startDemo(); }\n    titleMenu.update(dt);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      if (needsPad()) E.font.text(g, 'Controller or keyboard required', r.W / 2, r.H - 46, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if ((i === 0 || i === 1) && needsPad()) return;\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', {}, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { DEMO = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n *  Cook: three presses on a sliding bar. Each press in the green band is a clean stage.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo); progress.scene = 'lab';\n    A.music('adventure'); L.enabled = true; L.ambient = .55; game.weather = null;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    cur = { kind: 'lab', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), cook: null, cookDone: progress.batches || 0, phase: 'intro',\n      tomas: { rig: RIG.tomas(), x: t.x, y: t.y }, station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (DEMO) cur.phase = 'free';\n    else say(cur.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n      'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two different promises, Tomas.',\n      () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three presses, timed to the green band.'],\n      { name: 'TOMAS', portrait: cur.tomas.rig, onDone: () => { cur.phase = 'free'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.talk.update(dt)) return;\n    if (s.phase === 'cook') return cookStep(dt, s);\n    if (s.phase !== 'free') return;\n    const near = (p, r) => dist(s.hero.body, p) < r;\n    const dir = DEMO ? aiLabDir(s) : moveDir();\n    stepHero(dt, dir, { speed: 78 }, s);\n    const press = !DEMO && (I.pressed('confirm') || I.clicked());\n    if (near(s.station, 22) && s.cookDone < 3 && (press || DEMO)) { I.consumeAll(); startCook(s); return; }\n    if (near(s.tomas, 26) && press) { I.consumeAll(); tomasLines(s); }\n    if (s.cookDone >= 3 && near(s.exit, 14) && (press || DEMO)) { I.consumeAll(); sfx('door'); game.go('desert', { demo: DEMO }, { fade: 'iris', seconds: .5 }); }\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, s.station.x, s.station.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    s.map.queueWalls(r);\n    r.actor(s.tomas.x, s.tomas.y, 0, (g, ox, oy) => s.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, s.hero);\n    L.add(s.station.x, s.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(s.exit.x, s.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (s.phase === 'cook') cookOverlay(r, s.cook);\n    s.talk.draw(r);\n    hud(r, s.hero, s.cookDone < 3 ? 'COOK ' + s.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT');\n    if (s.phase === 'free' && !DEMO && !s.talk.open) {\n      if (dist(s.hero.body, s.station) < 22 && s.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (s.cookDone + 1)));\n      else if (dist(s.hero.body, s.tomas) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n      else if (s.cookDone >= 3 && dist(s.hero.body, s.exit) < 14) textPrompt(r, prompt('confirm', 'Leave for the desert'));\n    }\n  }\n};\nfunction tomasLines(s) {\n  const lines = s.cookDone >= 3 ? ['Three batches. Mr. Rook, the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : s.cookDone ? ['Batch ' + s.cookDone + ' is in the bag. The next one is when you want the money.']\n    : ['The station is hot. Press ' + label('confirm') + ' at it when the band lines up.'];\n  say(s.talk, lines, { name: 'TOMAS', portrait: s.tomas.rig });\n}\nfunction startCook(s) {\n  s.phase = 'cook';\n  s.cook = { stage: 0, pos: 0, dir: 1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(s.cook); sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt, s) {\n  const c = s.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * (1.1 + c.stage * .28) * dt;\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !DEMO && (I.pressed('confirm') || I.clicked());\n  if (DEMO && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (!press) return;\n  I.consumeAll();\n  const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n  c.results.push(miss ? .45 : .6 + .4 * acc);\n  c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n  if (++c.stage < 3) { newZone(c); return; }\n  const pur = c.results.reduce((a, b) => a + b, 0) / c.results.length;\n  progress.purity.push(+pur.toFixed(3)); s.cookDone++; progress.batches = s.cookDone;\n  s.phase = 'free'; s.cook = null; sfx('coin');\n  const line = pur > .9 ? 'That color. That is the actual color.' : pur > .75 ? 'Clean enough. Clean enough is what we sell.' : 'Cloudy. Cloudy is a problem for a man with a lab coat.';\n  say(s.talk, [line].concat(s.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: s.hero.rig });\n}\nfunction aiLabDir(s) {\n  const b = s.hero.body, tx = s.cookDone < 3 ? s.station.x : s.exit.x, ty = s.cookDone < 3 ? s.station.y : s.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);\n  return d < 14 ? [0, 0] : [dx / d, dy / d];\n}\nfunction cookOverlay(r, c) {\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = Math.round((r.W - W) / 2), y0 = Math.round(r.H * .3);\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    E.px.rect(g, Math.round(x0 + (c.zone - c.half) * W), y0 + 1, Math.round(c.half * 2 * W), 12, '#3aa050');\n    E.px.rect(g, Math.round(x0 + c.pos * W) - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, then the chapel path.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nconst GRUNT_PATROLS = [[[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]];\nconst BATCH_CELLS = [[9, 20], [15, 6], [36, 17]];\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scrub and rock scattered by hash, kept off the road, the start, and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .08) g[y][x] = 'c';\n  }\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }   // the road\n  for (let y = 1; y < 12; y++) put(20, y, ',');                             // the chapel path, north\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }        // the RV's compound: adobe walls\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');                                                         // the gate\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');                                                          // the drop, where the RV waits\n  put(20, 1, 'E');                                                          // the chapel's arena\n  put(3, 12, 'h');                                                          // the start\n  for (const [x, y] of BATCH_CELLS) put(x, y, 'b');\n  for (const [[x, y]] of GRUNT_PATROLS) { put(x, y, 'g'); }\n  for (const [, [x, y]] of GRUNT_PATROLS.map(p => [0, p[1]])) { /* the patrol's far end is kept clear too */ }\n  for (const p of GRUNT_PATROLS) for (const [x, y] of p) if (g[y][x] === '#' || g[y][x] === 'c') put(x, y, '.');\n  return g.map(row => row.join(''));\n}\nconst DESERT_ROWS = buildDesert();\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round);\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'desert';\n    if (round) progress = Object.assign(freshProgress(), { scene: 'desert', purity: [.8, .8, .8], batches: 3 });\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, 'c': 3, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' },\n        3: { h: 14, face: 'hedge', roof: 'leaves', top: '#5a8a3a', side: '#3a5a2a' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const remaining = BATCH_CELLS.slice(progress.delivered || 0).map(([cx, cy]) => map.center(cx, cy));\n    const grunts = map.findAll('grunt').map(c => {\n      const p = GRUNT_PATROLS.find(q => q[0][0] === c.cx && q[0][1] === c.cy) || [[c.cx, c.cy]];\n      return makeGrunt(c.x, c.y, p);\n    });\n    cur = { kind: 'desert', map, round, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y), grunts, carry: 0,\n      batches: remaining.map(b => ({ x: b.x, y: b.y, taken: false })),\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: round ? 'wait' : 'run', t: 0, hubT: 0, hubDone: false,\n      objective: '', roundOver: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (!DEMO && !round && !progress.delivered) {\n      say(cur.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Stick or WASD to move. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it, or be ready.'],\n        { name: 'HOLLIS', portrait: cur.hero.rig });\n    }\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.phase === 'wait') return roundWait(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    updateHero(dt, s, null);\n    for (const f of s.grunts) stepFoe(dt, f, s);\n    for (const b of s.batches) if (!b.taken && dist(s.hero.body, b) < 12) { b.taken = true; s.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    if (s.carry > 0 && dist(s.hero.body, s.drop) < 18) deliver(s);\n    if (progress.delivered >= 3 && dist(s.hero.body, s.arena) < 12 && s.phase === 'run') {\n      s.phase = 'won';\n      game.go('showdown', { demo: DEMO }, { fade: 'iris', seconds: .6 });\n    }\n    s.objective = progress.delivered < 3 ? (s.carry ? 'TAKE THEM TO THE RV' : 'BATCHES LEFT: ' + (3 - progress.delivered - s.carry)) : 'THE CHAPEL, NORTH';\n    if (HUB && s.round) hubTick(s, dt);\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, s.drop.x, s.drop.y);\n    drawArena(r, s.arena.x, s.arena.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    for (const f of s.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    s.map.queueWalls(r);\n    drawHero(r, s.hero);\n    for (const f of s.grunts) drawFoe(r, f);\n    s.talk.draw(r);\n    hud(r, s.hero, s.objective);\n    if (s.phase === 'wait') r.overlay(g => E.font.text(g, s.roundOver || 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n    if (s.roundOver && s.phase !== 'wait') r.overlay(g => E.font.text(g, s.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (s.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (!s.talk.open && !s.hero.dead && s.carry > 0 && dist(s.hero.body, s.drop) < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction deliver(s) {\n  const k = s.carry; s.carry = 0; let cash = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; cash += Math.round(pur * 100);\n  }\n  progress.cash += cash;\n  sfx('coin'); game.note('DELIVERED ' + k + '  +$' + cash);\n  if (s.round) { roundCheck(s); return; }\n  say(s.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: s.hero.rig });\n}\n// the hub round: the round is over when the batches are delivered (or the player is down, or time is called)\nfunction roundCheck(s) {\n  if (progress.delivered < 3 || s.hubDone) return;\n  s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n  if (HUB) HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } });\n}\nfunction hubTick(s, dt) {\n  s.hubT += dt;\n  if (s.hubT > 1) { s.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n}\n// the round waits for the hub's clock: a countdown while time is negative, then play\nfunction roundWait(s, dt) {\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -1e9) s.roundOver = 'GET READY  ' + Math.ceil(-t);\n  else if (t >= 0) { s.phase = 'run'; s.roundOver = null; }\n  if (!HUB) s.phase = 'run';\n  if (s.phase === 'run') s.objective = '';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers, sweeps and uppercuts; he rushes when hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), v = map.find('vail');\n    cur = { kind: 'showdown', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), boss: makeBoss(v.x, v.y), phase: 'intro', t: 0 };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    if (DEMO) cur.phase = 'fight';\n    else say(cur.talk, lines, { name: 'VAIL', portrait: cur.boss.rig, onDone: () => { cur.phase = 'fight'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    if (s.phase === 'fight') {\n      updateHero(dt, s, s.boss);\n      stepBoss(dt, s);\n      if (s.boss.dead && s.phase === 'fight') { s.phase = 'won'; s.t = 0; A.music('victory'); }\n    }\n    if (s.phase === 'won' && s.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    r.shadow(s.boss.body.x, s.boss.body.y, 10, .5);\n    s.map.queueWalls(r);\n    r.prop('torch', s.map.find('hero').x - 60, 20, 0, { size: 1.1, light: true });\n    r.prop('torch', s.map.find('hero').x + 60, 20, 0, { size: 1.1, light: true });\n    L.add(s.boss.body.x, s.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, s.boss);\n    drawHero(r, s.hero);\n    s.talk.draw(r);\n    hud(r, s.hero, s.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (s.phase === 'fight') r.overlay(g => E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, s.boss.hp / s.boss.maxHp), '#c83a2a'));\n    if (s.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (s.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  THE SHARED GAME: the hero, foes, the boss, the HUD, the death card\n * ========================================================================================= */\nfunction makeHero(x, y) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol) {\n  const body = new E.Body({ x, y, r: 5 });\n  const hats = ['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'];\n  const f = { body, rig: RIG.grunt(hats[(patrol[0][0] + patrol[0][1]) % 4]), atk: new E.Attack(patrol[0][0] % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt', tele: 0 };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0,\n    state: 'fight', cool: 1.5, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's own turn: the stick or keys walk, the dash, the mouse aims, the swing hits in an arc\nfunction updateHero(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  const dir = DEMO ? aiDir(s, boss) : moveDir();\n  if (!DEMO && I.pressed('dash') && H.dashCool <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  if (!DEMO && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = E.angleTo(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  if (!DEMO && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (DEMO && H.slash.start.length !== undefined && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [boss] : s.grunts;\n  H.slash.hits(live(foes).map(f => f.body), b => E.inArc(H.body, H.facing, b, 24, 1.3, 16), b => hurtFoe(b.foe, 14, b, H));\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s.hero, d = dir || [0, 0], sp = o && o.speed ? o.speed : 78;\n  if (H.dead) return;\n  H.body.vx = d[0] * sp; H.body.vy = d[1] * sp;\n  H.body.update(dt, s.map);\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !DEMO)) H.facing = Math.atan2(d[1], d[0]);\n  H.rig.update(dt, { x: H.body.x, y: H.body.y, z: H.body.z, vx: H.body.vx, vy: H.body.vy, facing: H.facing,\n    attack: H.slash ? H.slash.state : null, hurt: H.inv > .5, dash: H.dash > 0 });\n  game.focus(H.body.x, H.body.y, 10);\n}\n// attract mode's AI: walk to the nearest thing that matters (the next batch, the RV, the arena, the boss), wiggle when stuck\nfunction aiDir(s, boss) {\n  let tx, ty;\n  if (boss) { tx = boss.body.x; ty = boss.body.y; }\n  else if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n  else { const b = s.batches && s.batches.find(q => !q.taken); if (b) { tx = b.x; ty = b.y; } else { tx = s.arena.x; ty = s.arena.y; } }\n  if (tx === undefined) return [0, 0];\n  const dx = tx - s.hero.body.x, dy = ty - s.hero.body.y, d = Math.hypot(dx, dy) || 1;\n  if (s.hero.body.hitWall) s.aiWander = .5;\n  if (s.aiWander > 0) { s.aiWander -= dt_ai; return s.aiDir; }\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nconst dt_ai = 1 / 120;\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return dist(boss.body, H.body) < 26 && !H.slash.busy;\n  return s.grunts.some(f => !f.dead && dist(f.body, H.body) < 22) && !H.slash.busy;\n}\nfunction hurtFoe(f, dmg, body, H) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(H.body, body), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(H.body, body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || DEMO || H.dead) return;\n  H.hp -= dmg; H.inv = 1;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; sfx('die'); }\n}\n// a downed hero: a short beat, then the round ends (hub) or the game over card\nfunction heroDown(s, dt) {\n  s.hero.deadT += dt;\n  if (s.hero.deadT < 2) return;\n  if (HUB && s.round) { if (!s.hubDone) { s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } return; }\n  game.go('over', {}, { fade: 'dissolve' });\n}\nfunction stepFoe(dt, f, s) {\n  const H = s.hero;\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const d = dist(H.body, f.body);\n  const seen = !DEMO && !H.dead && d < 110 && s.map.los(f.body.x, f.body.y, H.body.x, H.body.y) && angDiff(f.facing, E.angleTo(f.body, H.body)) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : (f.seenT || 0) + dt; if (!seen && f.seenT > 3) f.state = 'patrol'; }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length], tx = p[0] * 16 + 8, ty = p[1] * 16 + 8;\n    const ex = tx - f.body.x, ey = ty - f.body.y, ed = Math.hypot(ex, ey);\n    if (ed < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ex / ed * 26; vy = ey / ed * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') f.facing = E.angleTo(f.body, H.body);\n  else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (d > 22) { vx = (H.body.x - f.body.x) / d * 58; vy = (H.body.y - f.body.y) / d * 58; }\n    if (d <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead && f.atk.start()) f.cool = 1.4;\n  }\n  f.body.vx = vx; f.body.vy = vy; f.body.update(dt, s.map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg, f.body));\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx, vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0, run: vx || vy ? .6 : 0 });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const d = dist(H.body, b.body), rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (d > 22 && !b.atk.busy && !H.dead) { vx = (H.body.x - b.body.x) / d * 36 * rush; vy = (H.body.y - b.body.y) / d * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && d < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = rush > 1 ? .9 : 1.4;\n  }\n  b.atk.update(dt);\n  b.tele = b.atk.state && b.atk.state.phase === 'wind' ? 1 : 0;\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, b.dmg, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction drawHero(r, H) {\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => H.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, H, objective) {\n  r.overlay(g => {\n    if (H && !H.dead) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (DEMO) E.font.text(g, 'ATTRACT MODE: PRESS ANY BUTTON', r.W / 2, 22, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER (game over, retry or title), ENDING (the chapel is quiet), ABOUT (how to play, the source information and the\n *  feedback), WAIT (an AI Hub round before its start)\n * ========================================================================================= */\nlet overMenu = null;\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music(null); DEMO = false; cur = null;\n    overMenu = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { box: false, y: 0, color: '#fff6dc', pick: '#ffd36a', onPick: i => {\n      if (i === 0) game.go(progress.scene, {}, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n    } });\n  },\n  update(dt) { overMenu.update(dt); },\n  draw(r) {\n    r.sky(['#2a0c08', '#0c0606']);\n    overMenu.y = (r.H / 2 | 0) + 20;\n    r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] }));\n    overMenu.draw(r);\n  }\n};\nlet endT = 0;\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); endT = 0; DEMO = false; cur = null; },\n  update(dt) {\n    endT += dt;\n    const I = game.input;\n    if (endT > 2 && I.anyPressed()) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet. The rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\nconst PAGES = ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'];\nlet about = { page: 0, scroll: 0 };\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); DEMO = false; cur = null; about = { page: (data && data.page) || 0, scroll: 0 }; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || (I.pressed('confirm') && about.page === PAGES.length - 1)) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && about.page > 0) { about.page--; about.scroll = 0; }\n    if (I.pressed('right') && about.page < PAGES.length - 1) { about.page++; about.scroll = 0; }\n    about.scroll = clamp(about.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const body = aboutBody(about.page, r.W - 24);\n    r.overlay(g => {\n      E.font.title(g, PAGES[about.page], r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (about.page + 1) + ' / ' + PAGES.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n      let y = 40 + about.scroll;\n      for (const ln of body) { if (y > 24 && y < r.H - 24) E.font.text(g, ln, 12, y, '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen's width\nfunction aboutBody(page, w) {\n  const out = [], add = s => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage, and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space, or confirm.');\n    add('Cook: a green band slides across a bar. Press in the band. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones. Stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Step out of the ring, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox button symbols.');\n    add('A touch-only screen needs a controller or keyboard. The title\\'s attract mode runs without one.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    const rows = [['Date', s.date], ['Source', s.source], ['Genre and perspective', [s.genre, s.perspective].filter(Boolean).join('; ')], ['Tech', s.tech],\n      ['Art direction', s.artDirection], ['Animation', s.animation], ['Audio', s.audio], ['Online', s.online], ['Testing', s.testing],\n      ['Research', s.research], ['Environment', s.environment], ['Model', s.model], ['Usage', s.usage]];\n    for (const [k, v] of rows) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  else if (page === 3) for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  else for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  return out;\n}\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; DEMO = false; cur = null; },\n  update() { if (roundStarted) game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB  ·  GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (cur && cur.round && !cur.hubDone) { cur.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (cur) cur.phase = 'over'; });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => HUB.ready());\n}\ngame.debug = { snapshot: () => ({ scene: game.sceneName, demo: DEMO, progress: JSON.parse(JSON.stringify(progress)), hp: cur && cur.hero ? cur.hero.hp : null }) };\ngame.start({ scene: HUB ? 'wait' : 'title', scenes });\nwindow.__breakingDustBowl = { game, scenes, progress: () => progress, cur: () => cur, setDemo: v => { DEMO = v; } };\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26022,"cache_read_input_tokens":147616,"cache_creation":{"ephemeral_5m_input_tokens":26022,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"45dbe0fd-7f86-4ce2-a697-b43d17b82335","timestamp":"2026-11-03T02:25:27.421Z","request_id":"req_011CgfCXzuRR2xrZMD4AV9YL","wire_tool_inputs":{"toolu_01EhgyFBLq4rRMAu4EW1Si8h":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (three timed cooks), a desert run (dodge Vail's men by their sight cones, pick up three batches,\n// deliver them to the RV), then a showdown in a chapel ruin. Built on my-3D2dge v0.85.1 (the ADVENTURE kit's engine).\n// Keys: WASD or arrows move; J, X or click swings; Space or Shift dashes; Enter or Space confirms (talk, cook); V changes\n// the view; - and = zoom; M mutes; Escape or Start opens the pause menu (Settings: gamepad axis inversion, button symbols).\n// Attract mode: 10 seconds on the title, then an AI plays (it cheats: it can't be hurt). Any button ends it.\n// AI Hub: opened from the hub, the page skips the title and plays one round of the desert run, parallel mode.\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst L = game.lights, A = game.audio;\nconst scenes = {};\nlet DEMO = false;          // attract mode (or a demo run): an AI plays, the player's buttons end it\nlet cur = null;            // the active chapter's state: lab, ds (desert) or sh (showdown)\nconst label = a => game.input.label(a);\n// a touch-only screen (no mouse, no keyboard, no pad): it needs a controller or keyboard\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\nconst needsPad = () => touchOnly() && !['keyboard', 'gamepad', 'mouse'].includes(game.input.lastDevice);\nconst prompt = (a, word) => label(a) + ' ' + word;\n\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts while a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the ground: a pad's axes are inverted when the player's settings say so (keys and mouse never are)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// the world point under the mouse (the blade aims at it), or null\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction angDiff(a, b) { return Math.abs(((b - a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI); }\nfunction textPrompt(r, s) { r.text(s, r.W / 2, r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n// a dialog in attract mode closes itself; in play it waits for the player\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: DEMO ? 1.8 : 0 }, o || {})); }\n\n/* ---- the rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: hat => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: hat }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: hat, pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } })\n};\n\n/* ========================================================================================= *\n *  TITLE: a ledge of heroes under a desert sky. NEW GAME, CONTINUE (a save), ABOUT, OPTIONS.\n * ========================================================================================= */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt('#b02a2a'), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\nlet titleMenu = null, idle = 0;\nconst TITLE_ITEMS = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() {\n    A.music('title'); DEMO = false; cur = null; idle = 0; game.weather = null; L.enabled = false;\n    game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    titleMenu = new E.Menu(game, TITLE_ITEMS.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() })), {\n      box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: i => titleAction(i)\n    });\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (idle > 10) { idle = 0; return startDemo(); }\n    titleMenu.update(dt);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      if (needsPad()) E.font.text(g, 'Controller or keyboard required', r.W / 2, r.H - 46, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if ((i === 0 || i === 1) && needsPad()) return;\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', {}, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { DEMO = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n *  Cook: three presses on a sliding bar. Each press in the green band is a clean stage.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo); progress.scene = 'lab';\n    A.music('adventure'); L.enabled = true; L.ambient = .55; game.weather = null;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    cur = { kind: 'lab', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), cook: null, cookDone: progress.batches || 0, phase: 'intro',\n      tomas: { rig: RIG.tomas(), x: t.x, y: t.y }, station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (DEMO) cur.phase = 'free';\n    else say(cur.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n      'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two different promises, Tomas.',\n      () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three presses, timed to the green band.'],\n      { name: 'TOMAS', portrait: cur.tomas.rig, onDone: () => { cur.phase = 'free'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.talk.update(dt)) return;\n    if (s.phase === 'cook') return cookStep(dt, s);\n    if (s.phase !== 'free') return;\n    const near = (p, r) => dist(s.hero.body, p) < r;\n    const dir = DEMO ? aiLabDir(s) : moveDir();\n    stepHero(dt, dir, { speed: 78 }, s);\n    const press = !DEMO && (I.pressed('confirm') || I.clicked());\n    if (near(s.station, 22) && s.cookDone < 3 && (press || DEMO)) { I.consumeAll(); startCook(s); return; }\n    if (near(s.tomas, 26) && press) { I.consumeAll(); tomasLines(s); }\n    if (s.cookDone >= 3 && near(s.exit, 14) && (press || DEMO)) { I.consumeAll(); sfx('door'); game.go('desert', { demo: DEMO }, { fade: 'iris', seconds: .5 }); }\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, s.station.x, s.station.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    s.map.queueWalls(r);\n    r.actor(s.tomas.x, s.tomas.y, 0, (g, ox, oy) => s.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, s.hero);\n    L.add(s.station.x, s.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(s.exit.x, s.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (s.phase === 'cook') cookOverlay(r, s.cook);\n    s.talk.draw(r);\n    hud(r, s.hero, s.cookDone < 3 ? 'COOK ' + s.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT');\n    if (s.phase === 'free' && !DEMO && !s.talk.open) {\n      if (dist(s.hero.body, s.station) < 22 && s.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (s.cookDone + 1)));\n      else if (dist(s.hero.body, s.tomas) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n      else if (s.cookDone >= 3 && dist(s.hero.body, s.exit) < 14) textPrompt(r, prompt('confirm', 'Leave for the desert'));\n    }\n  }\n};\nfunction tomasLines(s) {\n  const lines = s.cookDone >= 3 ? ['Three batches. Mr. Rook, the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : s.cookDone ? ['Batch ' + s.cookDone + ' is in the bag. The next one is when you want the money.']\n    : ['The station is hot. Press ' + label('confirm') + ' at it when the band lines up.'];\n  say(s.talk, lines, { name: 'TOMAS', portrait: s.tomas.rig });\n}\nfunction startCook(s) {\n  s.phase = 'cook';\n  s.cook = { stage: 0, pos: 0, dir: 1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(s.cook); sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt, s) {\n  const c = s.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * (1.1 + c.stage * .28) * dt;\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !DEMO && (I.pressed('confirm') || I.clicked());\n  if (DEMO && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (!press) return;\n  I.consumeAll();\n  const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n  c.results.push(miss ? .45 : .6 + .4 * acc);\n  c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n  if (++c.stage < 3) { newZone(c); return; }\n  const pur = c.results.reduce((a, b) => a + b, 0) / c.results.length;\n  progress.purity.push(+pur.toFixed(3)); s.cookDone++; progress.batches = s.cookDone;\n  s.phase = 'free'; s.cook = null; sfx('coin');\n  const line = pur > .9 ? 'That color. That is the actual color.' : pur > .75 ? 'Clean enough. Clean enough is what we sell.' : 'Cloudy. Cloudy is a problem for a man with a lab coat.';\n  say(s.talk, [line].concat(s.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: s.hero.rig });\n}\nfunction aiLabDir(s) {\n  const b = s.hero.body, tx = s.cookDone < 3 ? s.station.x : s.exit.x, ty = s.cookDone < 3 ? s.station.y : s.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);\n  return d < 14 ? [0, 0] : [dx / d, dy / d];\n}\nfunction cookOverlay(r, c) {\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = Math.round((r.W - W) / 2), y0 = Math.round(r.H * .3);\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    E.px.rect(g, Math.round(x0 + (c.zone - c.half) * W), y0 + 1, Math.round(c.half * 2 * W), 12, '#3aa050');\n    E.px.rect(g, Math.round(x0 + c.pos * W) - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, then the chapel path.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nconst GRUNT_PATROLS = [[[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]];\nconst BATCH_CELLS = [[9, 20], [15, 6], [36, 17]];\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scrub and rock scattered by hash, kept off the road, the start, and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .08) g[y][x] = 'c';\n  }\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }   // the road\n  for (let y = 1; y < 12; y++) put(20, y, ',');                             // the chapel path, north\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }        // the RV's compound: adobe walls\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');                                                         // the gate\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');                                                          // the drop, where the RV waits\n  put(20, 1, 'E');                                                          // the chapel's arena\n  put(3, 12, 'h');                                                          // the start\n  for (const [x, y] of BATCH_CELLS) put(x, y, 'b');\n  for (const [[x, y]] of GRUNT_PATROLS) { put(x, y, 'g'); }\n  for (const [, [x, y]] of GRUNT_PATROLS.map(p => [0, p[1]])) { /* the patrol's far end is kept clear too */ }\n  for (const p of GRUNT_PATROLS) for (const [x, y] of p) if (g[y][x] === '#' || g[y][x] === 'c') put(x, y, '.');\n  return g.map(row => row.join(''));\n}\nconst DESERT_ROWS = buildDesert();\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round);\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'desert';\n    if (round) progress = Object.assign(freshProgress(), { scene: 'desert', purity: [.8, .8, .8], batches: 3 });\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, 'c': 3, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' },\n        3: { h: 14, face: 'hedge', roof: 'leaves', top: '#5a8a3a', side: '#3a5a2a' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const remaining = BATCH_CELLS.slice(progress.delivered || 0).map(([cx, cy]) => map.center(cx, cy));\n    const grunts = map.findAll('grunt').map(c => {\n      const p = GRUNT_PATROLS.find(q => q[0][0] === c.cx && q[0][1] === c.cy) || [[c.cx, c.cy]];\n      return makeGrunt(c.x, c.y, p);\n    });\n    cur = { kind: 'desert', map, round, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y), grunts, carry: 0,\n      batches: remaining.map(b => ({ x: b.x, y: b.y, taken: false })),\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: round ? 'wait' : 'run', t: 0, hubT: 0, hubDone: false,\n      objective: '', roundOver: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (!DEMO && !round && !progress.delivered) {\n      say(cur.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Stick or WASD to move. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it, or be ready.'],\n        { name: 'HOLLIS', portrait: cur.hero.rig });\n    }\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.phase === 'wait') return roundWait(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    updateHero(dt, s, null);\n    for (const f of s.grunts) stepFoe(dt, f, s);\n    for (const b of s.batches) if (!b.taken && dist(s.hero.body, b) < 12) { b.taken = true; s.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    if (s.carry > 0 && dist(s.hero.body, s.drop) < 18) deliver(s);\n    if (progress.delivered >= 3 && dist(s.hero.body, s.arena) < 12 && s.phase === 'run') {\n      s.phase = 'won';\n      game.go('showdown', { demo: DEMO }, { fade: 'iris', seconds: .6 });\n    }\n    s.objective = progress.delivered < 3 ? (s.carry ? 'TAKE THEM TO THE RV' : 'BATCHES LEFT: ' + (3 - progress.delivered - s.carry)) : 'THE CHAPEL, NORTH';\n    if (HUB && s.round) hubTick(s, dt);\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, s.drop.x, s.drop.y);\n    drawArena(r, s.arena.x, s.arena.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    for (const f of s.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    s.map.queueWalls(r);\n    drawHero(r, s.hero);\n    for (const f of s.grunts) drawFoe(r, f);\n    s.talk.draw(r);\n    hud(r, s.hero, s.objective);\n    if (s.phase === 'wait') r.overlay(g => E.font.text(g, s.roundOver || 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n    if (s.roundOver && s.phase !== 'wait') r.overlay(g => E.font.text(g, s.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (s.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (!s.talk.open && !s.hero.dead && s.carry > 0 && dist(s.hero.body, s.drop) < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction deliver(s) {\n  const k = s.carry; s.carry = 0; let cash = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; cash += Math.round(pur * 100);\n  }\n  progress.cash += cash;\n  sfx('coin'); game.note('DELIVERED ' + k + '  +$' + cash);\n  if (s.round) { roundCheck(s); return; }\n  say(s.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: s.hero.rig });\n}\n// the hub round: the round is over when the batches are delivered (or the player is down, or time is called)\nfunction roundCheck(s) {\n  if (progress.delivered < 3 || s.hubDone) return;\n  s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n  if (HUB) HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } });\n}\nfunction hubTick(s, dt) {\n  s.hubT += dt;\n  if (s.hubT > 1) { s.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n}\n// the round waits for the hub's clock: a countdown while time is negative, then play\nfunction roundWait(s, dt) {\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -1e9) s.roundOver = 'GET READY  ' + Math.ceil(-t);\n  else if (t >= 0) { s.phase = 'run'; s.roundOver = null; }\n  if (!HUB) s.phase = 'run';\n  if (s.phase === 'run') s.objective = '';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers, sweeps and uppercuts; he rushes when hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), v = map.find('vail');\n    cur = { kind: 'showdown', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), boss: makeBoss(v.x, v.y), phase: 'intro', t: 0 };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    if (DEMO) cur.phase = 'fight';\n    else say(cur.talk, lines, { name: 'VAIL', portrait: cur.boss.rig, onDone: () => { cur.phase = 'fight'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    if (s.phase === 'fight') {\n      updateHero(dt, s, s.boss);\n      stepBoss(dt, s);\n      if (s.boss.dead && s.phase === 'fight') { s.phase = 'won'; s.t = 0; A.music('victory'); }\n    }\n    if (s.phase === 'won' && s.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    r.shadow(s.boss.body.x, s.boss.body.y, 10, .5);\n    s.map.queueWalls(r);\n    r.prop('torch', s.map.find('hero').x - 60, 20, 0, { size: 1.1, light: true });\n    r.prop('torch', s.map.find('hero').x + 60, 20, 0, { size: 1.1, light: true });\n    L.add(s.boss.body.x, s.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, s.boss);\n    drawHero(r, s.hero);\n    s.talk.draw(r);\n    hud(r, s.hero, s.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (s.phase === 'fight') r.overlay(g => E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, s.boss.hp / s.boss.maxHp), '#c83a2a'));\n    if (s.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (s.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  THE SHARED GAME: the hero, foes, the boss, the HUD, the death card\n * ========================================================================================= */\nfunction makeHero(x, y) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol) {\n  const body = new E.Body({ x, y, r: 5 });\n  const hats = ['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'];\n  const f = { body, rig: RIG.grunt(hats[(patrol[0][0] + patrol[0][1]) % 4]), atk: new E.Attack(patrol[0][0] % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt', tele: 0 };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0,\n    state: 'fight', cool: 1.5, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's own turn: the stick or keys walk, the dash, the mouse aims, the swing hits in an arc\nfunction updateHero(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  const dir = DEMO ? aiDir(s, boss) : moveDir();\n  if (!DEMO && I.pressed('dash') && H.dashCool <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  if (!DEMO && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = E.angleTo(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  if (!DEMO && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (DEMO && H.slash.start.length !== undefined && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [boss] : s.grunts;\n  H.slash.hits(live(foes).map(f => f.body), b => E.inArc(H.body, H.facing, b, 24, 1.3, 16), b => hurtFoe(b.foe, 14, b, H));\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s.hero, d = dir || [0, 0], sp = o && o.speed ? o.speed : 78;\n  if (H.dead) return;\n  H.body.vx = d[0] * sp; H.body.vy = d[1] * sp;\n  H.body.update(dt, s.map);\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !DEMO)) H.facing = Math.atan2(d[1], d[0]);\n  H.rig.update(dt, { x: H.body.x, y: H.body.y, z: H.body.z, vx: H.body.vx, vy: H.body.vy, facing: H.facing,\n    attack: H.slash ? H.slash.state : null, hurt: H.inv > .5, dash: H.dash > 0 });\n  game.focus(H.body.x, H.body.y, 10);\n}\n// attract mode's AI: walk to the nearest thing that matters (the next batch, the RV, the arena, the boss), wiggle when stuck\nfunction aiDir(s, boss) {\n  let tx, ty;\n  if (boss) { tx = boss.body.x; ty = boss.body.y; }\n  else if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n  else { const b = s.batches && s.batches.find(q => !q.taken); if (b) { tx = b.x; ty = b.y; } else { tx = s.arena.x; ty = s.arena.y; } }\n  if (tx === undefined) return [0, 0];\n  const dx = tx - s.hero.body.x, dy = ty - s.hero.body.y, d = Math.hypot(dx, dy) || 1;\n  if (s.hero.body.hitWall) s.aiWander = .5;\n  if (s.aiWander > 0) { s.aiWander -= dt_ai; return s.aiDir; }\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nconst dt_ai = 1 / 120;\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return dist(boss.body, H.body) < 26 && !H.slash.busy;\n  return s.grunts.some(f => !f.dead && dist(f.body, H.body) < 22) && !H.slash.busy;\n}\nfunction hurtFoe(f, dmg, body, H) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(H.body, body), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(H.body, body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || DEMO || H.dead) return;\n  H.hp -= dmg; H.inv = 1;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; sfx('die'); }\n}\n// a downed hero: a short beat, then the round ends (hub) or the game over card\nfunction heroDown(s, dt) {\n  s.hero.deadT += dt;\n  if (s.hero.deadT < 2) return;\n  if (HUB && s.round) { if (!s.hubDone) { s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } return; }\n  game.go('over', {}, { fade: 'dissolve' });\n}\nfunction stepFoe(dt, f, s) {\n  const H = s.hero;\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const d = dist(H.body, f.body);\n  const seen = !DEMO && !H.dead && d < 110 && s.map.los(f.body.x, f.body.y, H.body.x, H.body.y) && angDiff(f.facing, E.angleTo(f.body, H.body)) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : (f.seenT || 0) + dt; if (!seen && f.seenT > 3) f.state = 'patrol'; }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length], tx = p[0] * 16 + 8, ty = p[1] * 16 + 8;\n    const ex = tx - f.body.x, ey = ty - f.body.y, ed = Math.hypot(ex, ey);\n    if (ed < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ex / ed * 26; vy = ey / ed * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') f.facing = E.angleTo(f.body, H.body);\n  else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (d > 22) { vx = (H.body.x - f.body.x) / d * 58; vy = (H.body.y - f.body.y) / d * 58; }\n    if (d <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead && f.atk.start()) f.cool = 1.4;\n  }\n  f.body.vx = vx; f.body.vy = vy; f.body.update(dt, s.map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg, f.body));\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx, vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0, run: vx || vy ? .6 : 0 });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const d = dist(H.body, b.body), rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (d > 22 && !b.atk.busy && !H.dead) { vx = (H.body.x - b.body.x) / d * 36 * rush; vy = (H.body.y - b.body.y) / d * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && d < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = rush > 1 ? .9 : 1.4;\n  }\n  b.atk.update(dt);\n  b.tele = b.atk.state && b.atk.state.phase === 'wind' ? 1 : 0;\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, b.dmg, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction drawHero(r, H) {\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => H.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, H, objective) {\n  r.overlay(g => {\n    if (H && !H.dead) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (DEMO) E.font.text(g, 'ATTRACT MODE: PRESS ANY BUTTON', r.W / 2, 22, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER (game over, retry or title), ENDING (the chapel is quiet), ABOUT (how to play, the source information and the\n *  feedback), WAIT (an AI Hub round before its start)\n * ========================================================================================= */\nlet overMenu = null;\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music(null); DEMO = false; cur = null;\n    overMenu = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { box: false, y: 0, color: '#fff6dc', pick: '#ffd36a', onPick: i => {\n      if (i === 0) game.go(progress.scene, {}, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n    } });\n  },\n  update(dt) { overMenu.update(dt); },\n  draw(r) {\n    r.sky(['#2a0c08', '#0c0606']);\n    overMenu.y = (r.H / 2 | 0) + 20;\n    r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] }));\n    overMenu.draw(r);\n  }\n};\nlet endT = 0;\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); endT = 0; DEMO = false; cur = null; },\n  update(dt) {\n    endT += dt;\n    const I = game.input;\n    if (endT > 2 && I.anyPressed()) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet. The rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\nconst PAGES = ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'];\nlet about = { page: 0, scroll: 0 };\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); DEMO = false; cur = null; about = { page: (data && data.page) || 0, scroll: 0 }; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || (I.pressed('confirm') && about.page === PAGES.length - 1)) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && about.page > 0) { about.page--; about.scroll = 0; }\n    if (I.pressed('right') && about.page < PAGES.length - 1) { about.page++; about.scroll = 0; }\n    about.scroll = clamp(about.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const body = aboutBody(about.page, r.W - 24);\n    r.overlay(g => {\n      E.font.title(g, PAGES[about.page], r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (about.page + 1) + ' / ' + PAGES.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n      let y = 40 + about.scroll;\n      for (const ln of body) { if (y > 24 && y < r.H - 24) E.font.text(g, ln, 12, y, '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen's width\nfunction aboutBody(page, w) {\n  const out = [], add = s => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage, and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space, or confirm.');\n    add('Cook: a green band slides across a bar. Press in the band. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones. Stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Step out of the ring, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox button symbols.');\n    add('A touch-only screen needs a controller or keyboard. The title\\'s attract mode runs without one.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    const rows = [['Date', s.date], ['Source', s.source], ['Genre and perspective', [s.genre, s.perspective].filter(Boolean).join('; ')], ['Tech', s.tech],\n      ['Art direction', s.artDirection], ['Animation', s.animation], ['Audio', s.audio], ['Online', s.online], ['Testing', s.testing],\n      ['Research', s.research], ['Environment', s.environment], ['Model', s.model], ['Usage', s.usage]];\n    for (const [k, v] of rows) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  else if (page === 3) for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  else for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  return out;\n}\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; DEMO = false; cur = null; },\n  update() { if (roundStarted) game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB  ·  GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (cur && cur.round && !cur.hubDone) { cur.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (cur) cur.phase = 'over'; });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => HUB.ready());\n}\ngame.debug = { snapshot: () => ({ scene: game.sceneName, demo: DEMO, progress: JSON.parse(JSON.stringify(progress)), hp: cur && cur.hero ? cur.hero.hp : null }) };\ngame.start({ scene: HUB ? 'wait' : 'title', scenes });\nwindow.__breakingDustBowl = { game, scenes, progress: () => progress, cur: () => cur, setDemo: v => { DEMO = v; } };\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EhgyFBLq4rRMAu4EW1Si8h","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0729cc04-0deb-412e-a406-b462eee591a2","uuid":"c5f21f3c-3df7-431d-a558-b7fba7e8c522","timestamp":"2026-11-03T02:25:27.448Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-191741__x8b64cc/work/BreakingDustBowl-BreakingBad-claude-haiku-5-5-medium-20261102-191741/src/game.js","content":"// BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the\n// middle: a garage lab (three timed cooks), a desert run (dodge Vail's men by their sight cones, pick up three batches,\n// deliver them to the RV), then a showdown in a chapel ruin. Built on my-3D2dge v0.85.1 (the ADVENTURE kit's engine).\n// Keys: WASD or arrows move; J, X or click swings; Space or Shift dashes; Enter or Space confirms (talk, cook); V changes\n// the view; - and = zoom; M mutes; Escape or Start opens the pause menu (Settings: gamepad axis inversion, button symbols).\n// Attract mode: 10 seconds on the title, then an AI plays (it cheats: it can't be hurt). Any button ends it.\n// AI Hub: opened from the hub, the page skips the title and plays one round of the desert run, parallel mode.\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp } = E;\nconst HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;\nconst EXIT = window.EXIT_INTERVIEW || {};\n\n/* ---- progress: what a save holds, and what a round starts from ---- */\nlet progress = freshProgress();\nfunction freshProgress() { return { scene: 'lab', batches: 0, purity: [], delivered: 0, cash: 0 }; }\n\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], bg: '#0b0a10',\n  menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),\n    read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }\n});\nconst L = game.lights, A = game.audio;\nconst scenes = {};\nlet DEMO = false;          // attract mode (or a demo run): an AI plays, the player's buttons end it\nlet cur = null;            // the active chapter's state: lab, ds (desert) or sh (showdown)\nconst label = a => game.input.label(a);\n// a touch-only screen (no mouse, no keyboard, no pad): it needs a controller or keyboard\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;\nconst needsPad = () => touchOnly() && !['keyboard', 'gamepad', 'mouse'].includes(game.input.lastDevice);\nconst prompt = (a, word) => label(a) + ' ' + word;\n\ngame.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });\ngame.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });\ngame.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',\n  help: 'The buttons drawn in prompts while a controller is in use', apply(g, v) { g.input.glyphs = v; } });\ngame.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed\n\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); }\n});\n\n/* ---- helpers ---- */\nconst sfx = (n, o) => A.sfx(n, o);\nconst dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst live = list => list.filter(f => !f.dead);\n// the stick's direction on the ground: a pad's axes are inverted when the player's settings say so (keys and mouse never are)\nfunction moveDir() {\n  const I = game.input; let [mx, my] = I.move();\n  if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }\n  return game.view.screenDirToGround(mx, my);\n}\n// the world point under the mouse (the blade aims at it), or null\nfunction mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }\nfunction angDiff(a, b) { return Math.abs(((b - a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI); }\nfunction textPrompt(r, s) { r.text(s, r.W / 2, r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }\n// a dialog in attract mode closes itself; in play it waits for the player\nfunction say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: DEMO ? 1.8 : 0 }, o || {})); }\n\n/* ---- the rig roster ---- */\nconst RIG = {\n  hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),\n  tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },\n    colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),\n  grunt: hat => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: hat }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },\n    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: hat, pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),\n  vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },\n    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } })\n};\n\n/* ========================================================================================= *\n *  TITLE: a ledge of heroes under a desert sky. NEW GAME, CONTINUE (a save), ABOUT, OPTIONS.\n * ========================================================================================= */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('desert');\nconst TITLE_HEROES = [\n  { face: 0, rig: RIG.hollis(), x: MID - 70 },\n  { face: 0, rig: RIG.tomas(), x: MID - 35 },\n  { face: Math.PI, rig: RIG.vail(), x: MID + 25 },\n  { face: Math.PI, rig: RIG.grunt('#b02a2a'), x: MID + 60 }\n];\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\nlet titleMenu = null, idle = 0;\nconst TITLE_ITEMS = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() {\n    A.music('title'); DEMO = false; cur = null; idle = 0; game.weather = null; L.enabled = false;\n    game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;\n    titleMenu = new E.Menu(game, TITLE_ITEMS.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() })), {\n      box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',\n      onPick: i => titleAction(i)\n    });\n  },\n  update(dt) {\n    const I = game.input;\n    if (I.anyPressed()) idle = 0; else idle += dt;\n    if (idle > 10) { idle = 0; return startDemo(); }\n    titleMenu.update(dt);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);\n    TITLE_HEROES.forEach((h, i) => {\n      const u = (game.time * .45 + i * .37) % 3;\n      const swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;\n    titleMenu.y = (r.H * .52 | 0) + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const h of TITLE_HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });\n      E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      if (needsPad()) E.font.text(g, 'Controller or keyboard required', r.W / 2, r.H - 46, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice;\n    const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n  }\n};\nfunction titleAction(i) {\n  if ((i === 0 || i === 1) && needsPad()) return;\n  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', {}, { fade: 'iris', seconds: .5 }); }\n  else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }\n  else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }\n  else if (i === 3) { sfx('select'); game.menu('settings'); }\n}\nfunction startDemo() { DEMO = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }\n\n/* ========================================================================================= *\n *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.\n *  Cook: three presses on a sliding bar. Each press in the green band is a clean stage.\n * ========================================================================================= */\nconst LAB_ROWS = [\n  '############',\n  '#..........#',\n  '#.B........#',\n  '#..H.......#',\n  '#..........#',\n  '#.C.....T..#',\n  '#..........#',\n  '#.........B#',\n  '#####D######'\n];\nconst COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];\nscenes.lab = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo); progress.scene = 'lab';\n    A.music('adventure'); L.enabled = true; L.ambient = .55; game.weather = null;\n    const map = new E.TileMap({\n      rows: LAB_ROWS,\n      legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },\n        'C': { floor: 'concrete', spawn: 'cook' }, 'T': { floor: 'concrete', spawn: 'tomas' }, 'D': { floor: 'door', spawn: 'exit' } },\n      types: { 2: { h: 30, face: 'brick', roof: 'slab', top: '#8a8078', side: '#5a4c44' } },\n      floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),\n      outside: '#1e1a18'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');\n    cur = { kind: 'lab', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), cook: null, cookDone: progress.batches || 0, phase: 'intro',\n      tomas: { rig: RIG.tomas(), x: t.x, y: t.y }, station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (DEMO) cur.phase = 'free';\n    else say(cur.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',\n      'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two different promises, Tomas.',\n      () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three presses, timed to the green band.'],\n      { name: 'TOMAS', portrait: cur.tomas.rig, onDone: () => { cur.phase = 'free'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.talk.update(dt)) return;\n    if (s.phase === 'cook') return cookStep(dt, s);\n    if (s.phase !== 'free') return;\n    const near = (p, r) => dist(s.hero.body, p) < r;\n    const dir = DEMO ? aiLabDir(s) : moveDir();\n    stepHero(dt, dir, { speed: 78 }, s);\n    const press = !DEMO && (I.pressed('confirm') || I.clicked());\n    if (near(s.station, 22) && s.cookDone < 3 && (press || DEMO)) { I.consumeAll(); startCook(s); return; }\n    if (near(s.tomas, 26) && press) { I.consumeAll(); tomasLines(s); }\n    if (s.cookDone >= 3 && near(s.exit, 14) && (press || DEMO)) { I.consumeAll(); sfx('door'); game.go('desert', { demo: DEMO }, { fade: 'iris', seconds: .5 }); }\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.benches) benchDraw(r, b.x, b.y);\n    cookDraw(r, s.station.x, s.station.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    s.map.queueWalls(r);\n    r.actor(s.tomas.x, s.tomas.y, 0, (g, ox, oy) => s.tomas.rig.draw(g, ox, oy, r.view));\n    drawHero(r, s.hero);\n    L.add(s.station.x, s.station.y, 40, 60, .9, { color: '#e8ffa8' });\n    L.add(s.exit.x, s.exit.y, 30, 40, .6, { color: '#ffd090' });\n    if (s.phase === 'cook') cookOverlay(r, s.cook);\n    s.talk.draw(r);\n    hud(r, s.hero, s.cookDone < 3 ? 'COOK ' + s.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT');\n    if (s.phase === 'free' && !DEMO && !s.talk.open) {\n      if (dist(s.hero.body, s.station) < 22 && s.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (s.cookDone + 1)));\n      else if (dist(s.hero.body, s.tomas) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));\n      else if (s.cookDone >= 3 && dist(s.hero.body, s.exit) < 14) textPrompt(r, prompt('confirm', 'Leave for the desert'));\n    }\n  }\n};\nfunction tomasLines(s) {\n  const lines = s.cookDone >= 3 ? ['Three batches. Mr. Rook, the van is ready.', 'We walk out of here, Tomas. The van can wait.']\n    : s.cookDone ? ['Batch ' + s.cookDone + ' is in the bag. The next one is when you want the money.']\n    : ['The station is hot. Press ' + label('confirm') + ' at it when the band lines up.'];\n  say(s.talk, lines, { name: 'TOMAS', portrait: s.tomas.rig });\n}\nfunction startCook(s) {\n  s.phase = 'cook';\n  s.cook = { stage: 0, pos: 0, dir: 1, zone: 0, half: .11, t: 0, results: [], flash: 0 };\n  newZone(s.cook); sfx('select');\n}\nfunction newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }\nfunction cookStep(dt, s) {\n  const c = s.cook, I = game.input;\n  c.t += dt; c.pos += c.dir * (1.1 + c.stage * .28) * dt;\n  if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }\n  if (c.flash > 0) c.flash -= dt;\n  let press = !DEMO && (I.pressed('confirm') || I.clicked());\n  if (DEMO && Math.abs(c.pos - c.zone) < c.half * .5) press = true;\n  if (!press) return;\n  I.consumeAll();\n  const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;\n  c.results.push(miss ? .45 : .6 + .4 * acc);\n  c.flash = .35; sfx(miss ? 'hurt' : 'blip');\n  if (++c.stage < 3) { newZone(c); return; }\n  const pur = c.results.reduce((a, b) => a + b, 0) / c.results.length;\n  progress.purity.push(+pur.toFixed(3)); s.cookDone++; progress.batches = s.cookDone;\n  s.phase = 'free'; s.cook = null; sfx('coin');\n  const line = pur > .9 ? 'That color. That is the actual color.' : pur > .75 ? 'Clean enough. Clean enough is what we sell.' : 'Cloudy. Cloudy is a problem for a man with a lab coat.';\n  say(s.talk, [line].concat(s.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: s.hero.rig });\n}\nfunction aiLabDir(s) {\n  const b = s.hero.body, tx = s.cookDone < 3 ? s.station.x : s.exit.x, ty = s.cookDone < 3 ? s.station.y : s.exit.y;\n  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);\n  return d < 14 ? [0, 0] : [dx / d, dy / d];\n}\nfunction cookOverlay(r, c) {\n  r.overlay(g => {\n    const W = Math.min(r.W - 40, 260), x0 = Math.round((r.W - W) / 2), y0 = Math.round(r.H * .3);\n    E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });\n    E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });\n    E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });\n    E.px.rect(g, Math.round(x0 + (c.zone - c.half) * W), y0 + 1, Math.round(c.half * 2 * W), 12, '#3aa050');\n    E.px.rect(g, Math.round(x0 + c.pos * W) - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');\n    E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction benchDraw(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 7, y - 4, 0, x + 7, y + 4, 9, '#8a6a4a', '#5a4030'), { bias: 0 }); }\nfunction cookDraw(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 9, y - 6, 0, x + 9, y + 6, 18, '#b8c0c8', '#6a7078'), { bias: 0 });\n  r.prop('brazier', x + 11, y - 8, 0, { size: .8, light: true });\n}\n\n/* ========================================================================================= *\n *  DESERT: the run. Three batches to pick up, the RV to deliver them to, then the chapel path.\n * ========================================================================================= */\nconst DW = 40, DH = 26;\nconst GRUNT_PATROLS = [[[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]];\nconst BATCH_CELLS = [[9, 20], [15, 6], [36, 17]];\nfunction buildDesert() {\n  const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));\n  const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };\n  // scrub and rock scattered by hash, kept off the road, the start, and the compound\n  for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {\n    if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;\n    const h = E.hash2(x * 3 + 1, y * 7 + 2);\n    if (h < .05) g[y][x] = '#'; else if (h < .08) g[y][x] = 'c';\n  }\n  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }   // the road\n  for (let y = 1; y < 12; y++) put(20, y, ',');                             // the chapel path, north\n  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }        // the RV's compound: adobe walls\n  for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }\n  put(30, 10, ',');                                                         // the gate\n  for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');\n  put(30, 6, 'd');                                                          // the drop, where the RV waits\n  put(20, 1, 'E');                                                          // the chapel's arena\n  put(3, 12, 'h');                                                          // the start\n  for (const [x, y] of BATCH_CELLS) put(x, y, 'b');\n  for (const [[x, y]] of GRUNT_PATROLS) { put(x, y, 'g'); }\n  for (const [, [x, y]] of GRUNT_PATROLS.map(p => [0, p[1]])) { /* the patrol's far end is kept clear too */ }\n  for (const p of GRUNT_PATROLS) for (const [x, y] of p) if (g[y][x] === '#' || g[y][x] === 'c') put(x, y, '.');\n  return g.map(row => row.join(''));\n}\nconst DESERT_ROWS = buildDesert();\nscenes.desert = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  camera: { zoom: [.75, 2], start: 1 },\n  enter(data) {\n    const round = !!(data && data.round);\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'desert';\n    if (round) progress = Object.assign(freshProgress(), { scene: 'desert', purity: [.8, .8, .8], batches: 3 });\n    A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };\n    const map = new E.TileMap({\n      rows: DESERT_ROWS,\n      legend: {\n        '#': 1, '2': 2, 'c': 3, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'b': { floor: 'sand', spawn: 'batch' },\n        'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }\n      },\n      types: {\n        1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },\n        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' },\n        3: { h: 14, face: 'hedge', roof: 'leaves', top: '#5a8a3a', side: '#3a5a2a' }\n      },\n      floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),\n      outside: '#c8a878'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');\n    const remaining = BATCH_CELLS.slice(progress.delivered || 0).map(([cx, cy]) => map.center(cx, cy));\n    const grunts = map.findAll('grunt').map(c => {\n      const p = GRUNT_PATROLS.find(q => q[0][0] === c.cx && q[0][1] === c.cy) || [[c.cx, c.cy]];\n      return makeGrunt(c.x, c.y, p);\n    });\n    cur = { kind: 'desert', map, round, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y), grunts, carry: 0,\n      batches: remaining.map(b => ({ x: b.x, y: b.y, taken: false })),\n      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: round ? 'wait' : 'run', t: 0, hubT: 0, hubDone: false,\n      objective: '', roundOver: null, aiWander: 0, aiDir: [0, 0] };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    if (!DEMO && !round && !progress.delivered) {\n      say(cur.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',\n        'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',\n        () => 'Stick or WASD to move. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it, or be ready.'],\n        { name: 'HOLLIS', portrait: cur.hero.rig });\n    }\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.phase === 'wait') return roundWait(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    updateHero(dt, s, null);\n    for (const f of s.grunts) stepFoe(dt, f, s);\n    for (const b of s.batches) if (!b.taken && dist(s.hero.body, b) < 12) { b.taken = true; s.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }\n    if (s.carry > 0 && dist(s.hero.body, s.drop) < 18) deliver(s);\n    if (progress.delivered >= 3 && dist(s.hero.body, s.arena) < 12 && s.phase === 'run') {\n      s.phase = 'won';\n      game.go('showdown', { demo: DEMO }, { fade: 'iris', seconds: .6 });\n    }\n    s.objective = progress.delivered < 3 ? (s.carry ? 'TAKE THEM TO THE RV' : 'BATCHES LEFT: ' + (3 - progress.delivered - s.carry)) : 'THE CHAPEL, NORTH';\n    if (HUB && s.round) hubTick(s, dt);\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    for (const b of s.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });\n    drawDrop(r, s.drop.x, s.drop.y);\n    drawArena(r, s.arena.x, s.arena.y);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    for (const f of s.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);\n    s.map.queueWalls(r);\n    drawHero(r, s.hero);\n    for (const f of s.grunts) drawFoe(r, f);\n    s.talk.draw(r);\n    hud(r, s.hero, s.objective);\n    if (s.phase === 'wait') r.overlay(g => E.font.text(g, s.roundOver || 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n    if (s.roundOver && s.phase !== 'wait') r.overlay(g => E.font.text(g, s.roundOver, r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false }));\n    if (s.hero.dead) deathCard(r, 'Vail\\'s men found the van.');\n    if (!s.talk.open && !s.hero.dead && s.carry > 0 && dist(s.hero.body, s.drop) < 40) textPrompt(r, 'DELIVER: walk onto the RV');\n  }\n};\nfunction drawDrop(r, x, y) {\n  r.queue(x, y, 0, g => r.box(g, x - 10, y - 7, 0, x + 10, y + 7, 14, '#f0ece4', '#2a6ab0'), { bias: 0 });\n  r.groundRing(x, y, 14, '#2a6ab0', .6);\n}\nfunction drawArena(r, x, y) { r.queue(x, y, 0, g => r.box(g, x - 9, y - 9, 0, x + 9, y + 9, 2, '#4a3a30', '#2a201a'), { bias: 0 }); }\nfunction deliver(s) {\n  const k = s.carry; s.carry = 0; let cash = 0;\n  for (let n = 0; n < k; n++) {\n    const pur = progress.purity[progress.delivered] || .8;\n    progress.delivered++; cash += Math.round(pur * 100);\n  }\n  progress.cash += cash;\n  sfx('coin'); game.note('DELIVERED ' + k + '  +$' + cash);\n  if (s.round) { roundCheck(s); return; }\n  say(s.talk, progress.delivered >= 3 ? ['All three. Vail\\'s chapel is up the road. Walk it like a man who knows the way.'] : ['Batch in. Clean. Vail doesn\\'t ask about the color.'], { name: 'HOLLIS', portrait: s.hero.rig });\n}\n// the hub round: the round is over when the batches are delivered (or the player is down, or time is called)\nfunction roundCheck(s) {\n  if (progress.delivered < 3 || s.hubDone) return;\n  s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash + '  WAITING FOR THE OTHERS';\n  if (HUB) HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } });\n}\nfunction hubTick(s, dt) {\n  s.hubT += dt;\n  if (s.hubT > 1) { s.hubT = 0; HUB.progress({ score: progress.cash, label: progress.delivered + '/3 batches, $' + progress.cash }); }\n}\n// the round waits for the hub's clock: a countdown while time is negative, then play\nfunction roundWait(s, dt) {\n  const t = HUB && HUB.time ? HUB.time() : 0;\n  if (t < 0 && t > -1e9) s.roundOver = 'GET READY  ' + Math.ceil(-t);\n  else if (t >= 0) { s.phase = 'run'; s.roundOver = null; }\n  if (!HUB) s.phase = 'run';\n  if (s.phase === 'run') s.objective = '';\n}\n\n/* ========================================================================================= *\n *  SHOWDOWN: Vail in the chapel ruin. Telegraphed haymakers, sweeps and uppercuts; he rushes when hurt.\n * ========================================================================================= */\nconst ARENA_ROWS = [\n  '################',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#..............#',\n  '#......v.......#',\n  '#..............#',\n  '#..............#',\n  '#..p........p..#',\n  '#..............#',\n  '#.......h......#',\n  '################'\n];\nscenes.showdown = {\n  view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,\n  enter(data) {\n    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'showdown';\n    A.music('boss'); L.enabled = true; L.ambient = .42; game.weather = null;\n    const map = new E.TileMap({\n      rows: ARENA_ROWS,\n      legend: { '#': 1, '.': { floor: 'arena' }, 'p': 3, 'v': { floor: 'arena', spawn: 'vail' }, 'h': { floor: 'arena', spawn: 'hero' } },\n      types: {\n        1: { h: 24, face: 'stone', roof: 'slab', top: '#6a5a4a', side: '#4a3a30' },\n        3: { h: 30, face: 'stone', roof: 'slab', top: '#8a7a6a', side: '#5a4a3a' }\n      },\n      floorTex: (x, y) => E.tex.checker(x, y, { a: '#4a3a30', b: '#2e241e', size: 16 }),\n      outside: '#1a1410'\n    });\n    game.cam.bounds = v => map.bounds(v); game.follow(null);\n    const h = map.find('hero'), v = map.find('vail');\n    cur = { kind: 'showdown', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), boss: makeBoss(v.x, v.y), phase: 'intro', t: 0 };\n    game.focus(cur.hero.body.x, cur.hero.body.y, 10);\n    const lines = ['You brought the product, Mr. Rook. Good. Now we talk about the part where you are standing on my ground.',\n      'I brought the batches. You brought the ground.', 'Clever. You always did think you were the smart one in the room.'];\n    if (DEMO) cur.phase = 'fight';\n    else say(cur.talk, lines, { name: 'VAIL', portrait: cur.boss.rig, onDone: () => { cur.phase = 'fight'; } });\n  },\n  update(dt) {\n    const s = cur, I = game.input;\n    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }\n    if (s.hero.dead) return heroDown(s, dt);\n    if (s.talk.update(dt)) return;\n    s.t += dt;\n    if (s.phase === 'fight') {\n      updateHero(dt, s, s.boss);\n      stepBoss(dt, s);\n      if (s.boss.dead && s.phase === 'fight') { s.phase = 'won'; s.t = 0; A.music('victory'); }\n    }\n    if (s.phase === 'won' && s.t > 3.5) game.go('ending', {}, { fade: 'dissolve' });\n  },\n  draw(r) {\n    const s = cur;\n    s.map.drawFloor(r);\n    r.shadow(s.hero.body.x, s.hero.body.y, 5);\n    r.shadow(s.boss.body.x, s.boss.body.y, 10, .5);\n    s.map.queueWalls(r);\n    r.prop('torch', s.map.find('hero').x - 60, 20, 0, { size: 1.1, light: true });\n    r.prop('torch', s.map.find('hero').x + 60, 20, 0, { size: 1.1, light: true });\n    L.add(s.boss.body.x, s.boss.body.y, 40, 90, .5, { color: '#ffb070' });\n    drawFoe(r, s.boss);\n    drawHero(r, s.hero);\n    s.talk.draw(r);\n    hud(r, s.hero, s.phase === 'won' ? 'VAIL IS DOWN' : 'VAIL');\n    if (s.phase === 'fight') r.overlay(g => E.ui.bar(g, r.W / 2 - 80, 14, 160, 6, Math.max(0, s.boss.hp / s.boss.maxHp), '#c83a2a'));\n    if (s.hero.dead) deathCard(r, 'The chapel ruin keeps the rest.');\n    if (s.phase === 'won') r.overlay(g => E.font.text(g, 'THE CHAPEL IS QUIET', r.W / 2, r.H / 2 - 12, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }));\n  }\n};\n\n/* ========================================================================================= *\n *  THE SHARED GAME: the hero, foes, the boss, the HUD, the death card\n * ========================================================================================= */\nfunction makeHero(x, y) {\n  const body = new E.Body({ x, y, r: 5 });\n  return { body, rig: RIG.hollis(), slash: new E.Attack('slash', { reach: 11 }), facing: 0, hp: 6, inv: 0, dash: 0, dashCool: 0, dead: false, deadT: 0 };\n}\nfunction makeGrunt(x, y, patrol) {\n  const body = new E.Body({ x, y, r: 5 });\n  const hats = ['#b02a2a', '#2a6ab0', '#c8a040', '#2a8a4a'];\n  const f = { body, rig: RIG.grunt(hats[(patrol[0][0] + patrol[0][1]) % 4]), atk: new E.Attack(patrol[0][0] % 2 ? 'cross' : 'jab', { reach: 9 }),\n    hp: 30, maxHp: 30, dead: false, downT: 0, flash: 0, patrol, idx: 0, state: 'patrol', alert: 0, cool: 0, seenT: 0, facing: 0, dmg: 1, name: 'grunt', tele: 0 };\n  body.foe = f;\n  return f;\n}\nfunction makeBoss(x, y) {\n  const body = new E.Body({ x, y, r: 8 });\n  const f = { body, rig: RIG.vail(), atk: new E.Attack('haymaker', { reach: 15 }), hp: 150, maxHp: 150, dead: false, downT: 0, flash: 0,\n    state: 'fight', cool: 1.5, facing: Math.PI, dmg: 2, name: 'boss', tele: 0, moves: ['haymaker', 'sweep', 'uppercut'], mi: 0 };\n  body.foe = f;\n  return f;\n}\n// the hero's own turn: the stick or keys walk, the dash, the mouse aims, the swing hits in an arc\nfunction updateHero(dt, s, boss) {\n  const H = s.hero, I = game.input;\n  H.inv = Math.max(0, H.inv - dt); H.dashCool = Math.max(0, H.dashCool - dt); H.dash = Math.max(0, H.dash - dt);\n  const dir = DEMO ? aiDir(s, boss) : moveDir();\n  if (!DEMO && I.pressed('dash') && H.dashCool <= 0) { H.dash = .2; H.dashCool = .8; H.inv = Math.max(H.inv, .25); sfx('whoosh'); }\n  if (!DEMO && I.lastDevice === 'mouse') { const m = mousePoint(); if (m) H.facing = E.angleTo(H.body, m); }\n  stepHero(dt, dir, { speed: H.dash > 0 ? 190 : 78 }, s);\n  if (!DEMO && I.buffered('attack') && H.slash.start()) { I.consume('attack'); sfx('swing'); }\n  if (DEMO && H.slash.start.length !== undefined && aiWantsSwing(s, boss) && H.slash.start()) sfx('swing');\n  H.slash.update(dt);\n  const foes = boss ? [boss] : s.grunts;\n  H.slash.hits(live(foes).map(f => f.body), b => E.inArc(H.body, H.facing, b, 24, 1.3, 16), b => hurtFoe(b.foe, 14, b, H));\n}\nfunction stepHero(dt, dir, o, s) {\n  const H = s.hero, d = dir || [0, 0], sp = o && o.speed ? o.speed : 78;\n  if (H.dead) return;\n  H.body.vx = d[0] * sp; H.body.vy = d[1] * sp;\n  H.body.update(dt, s.map);\n  if (Math.hypot(d[0], d[1]) > .1 && !(game.input.lastDevice === 'mouse' && !DEMO)) H.facing = Math.atan2(d[1], d[0]);\n  H.rig.update(dt, { x: H.body.x, y: H.body.y, z: H.body.z, vx: H.body.vx, vy: H.body.vy, facing: H.facing,\n    attack: H.slash ? H.slash.state : null, hurt: H.inv > .5, dash: H.dash > 0 });\n  game.focus(H.body.x, H.body.y, 10);\n}\n// attract mode's AI: walk to the nearest thing that matters (the next batch, the RV, the arena, the boss), wiggle when stuck\nfunction aiDir(s, boss) {\n  let tx, ty;\n  if (boss) { tx = boss.body.x; ty = boss.body.y; }\n  else if (s.carry > 0) { tx = s.drop.x; ty = s.drop.y; }\n  else { const b = s.batches && s.batches.find(q => !q.taken); if (b) { tx = b.x; ty = b.y; } else { tx = s.arena.x; ty = s.arena.y; } }\n  if (tx === undefined) return [0, 0];\n  const dx = tx - s.hero.body.x, dy = ty - s.hero.body.y, d = Math.hypot(dx, dy) || 1;\n  if (s.hero.body.hitWall) s.aiWander = .5;\n  if (s.aiWander > 0) { s.aiWander -= dt_ai; return s.aiDir; }\n  s.aiDir = [dx / d, dy / d];\n  return s.aiDir;\n}\nconst dt_ai = 1 / 120;\nfunction aiWantsSwing(s, boss) {\n  const H = s.hero;\n  if (boss) return dist(boss.body, H.body) < 26 && !H.slash.busy;\n  return s.grunts.some(f => !f.dead && dist(f.body, H.body) < 22) && !H.slash.busy;\n}\nfunction hurtFoe(f, dmg, body, H) {\n  if (f.dead) return;\n  f.hp -= dmg; f.flash = .18; f.state = 'chase'; f.cool = Math.max(f.cool, .4);\n  sfx('hit');\n  game.hitFx(body.x, body.y, body.z + 18, { power: 1, angle: E.angleTo(H.body, body), damage: dmg, textScale: 2, textZ: 26 });\n  E.knockback(H.body, body, 140, 0);\n  if (f.hp <= 0) { f.dead = true; f.downT = 0; sfx('die'); }\n}\nfunction hurtHero(s, dmg, from) {\n  const H = s.hero;\n  if (H.inv > 0 || H.dash > 0 || DEMO || H.dead) return;\n  H.hp -= dmg; H.inv = 1;\n  sfx('hurt'); game.shake(4); game.flash('#ff3a3a', .12, .4);\n  E.knockback(from, H.body, 120, 0);\n  if (H.hp <= 0) { H.dead = true; H.deadT = 0; sfx('die'); }\n}\n// a downed hero: a short beat, then the round ends (hub) or the game over card\nfunction heroDown(s, dt) {\n  s.hero.deadT += dt;\n  if (s.hero.deadT < 2) return;\n  if (HUB && s.round) { if (!s.hubDone) { s.hubDone = true; s.roundOver = 'ROUND OVER  $' + progress.cash; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } return; }\n  game.go('over', {}, { fade: 'dissolve' });\n}\nfunction stepFoe(dt, f, s) {\n  const H = s.hero;\n  if (f.dead) { f.downT += dt; f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, facing: f.facing, pose: f.downT < 1 ? 'die' : undefined, down: f.downT >= 1 ? 1 : 0 }); return; }\n  f.flash = Math.max(0, f.flash - dt); f.cool = Math.max(0, f.cool - dt); f.alert = Math.max(0, f.alert - dt);\n  const d = dist(H.body, f.body);\n  const seen = !DEMO && !H.dead && d < 110 && s.map.los(f.body.x, f.body.y, H.body.x, H.body.y) && angDiff(f.facing, E.angleTo(f.body, H.body)) < 1.0;\n  if (f.state === 'patrol' && seen) { f.state = 'alert'; f.alert = .7; sfx('select'); }\n  if (f.state === 'alert' && f.alert <= 0) f.state = 'chase';\n  if (f.state === 'chase') { f.seenT = seen ? 0 : (f.seenT || 0) + dt; if (!seen && f.seenT > 3) f.state = 'patrol'; }\n  let vx = 0, vy = 0;\n  if (f.state === 'patrol') {\n    const p = f.patrol[f.idx % f.patrol.length], tx = p[0] * 16 + 8, ty = p[1] * 16 + 8;\n    const ex = tx - f.body.x, ey = ty - f.body.y, ed = Math.hypot(ex, ey);\n    if (ed < 3) f.idx = (f.idx + 1) % f.patrol.length; else { vx = ex / ed * 26; vy = ey / ed * 26; f.facing = Math.atan2(vy, vx); }\n  } else if (f.state === 'alert') f.facing = E.angleTo(f.body, H.body);\n  else if (f.state === 'chase') {\n    f.facing = E.angleTo(f.body, H.body);\n    if (d > 22) { vx = (H.body.x - f.body.x) / d * 58; vy = (H.body.y - f.body.y) / d * 58; }\n    if (d <= 20 && f.cool <= 0 && !f.atk.busy && !H.dead && f.atk.start()) f.cool = 1.4;\n  }\n  f.body.vx = vx; f.body.vy = vy; f.body.update(dt, s.map);\n  f.atk.update(dt);\n  if (f.atk.state && f.atk.state.phase === 'active') f.atk.hits([H.body], b => E.inArc(f.body, f.facing, b, 22, 1.2, 16), () => hurtHero(s, f.dmg, f.body));\n  f.rig.update(dt, { x: f.body.x, y: f.body.y, z: 0, vx, vy, facing: f.facing, attack: f.atk.state, hurt: f.flash > 0, run: vx || vy ? .6 : 0 });\n}\nfunction stepBoss(dt, s) {\n  const b = s.boss, H = s.hero;\n  if (b.dead) { b.downT += dt; b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, facing: b.facing, pose: b.downT < 1 ? 'die' : undefined, down: b.downT >= 1 ? 1 : 0 }); return; }\n  b.flash = Math.max(0, b.flash - dt); b.cool = Math.max(0, b.cool - dt);\n  const d = dist(H.body, b.body), rush = b.hp < b.maxHp * .5 ? 1.35 : 1;\n  b.facing = E.angleTo(b.body, H.body);\n  let vx = 0, vy = 0;\n  if (d > 22 && !b.atk.busy && !H.dead) { vx = (H.body.x - b.body.x) / d * 36 * rush; vy = (H.body.y - b.body.y) / d * 36 * rush; }\n  b.body.vx = vx; b.body.vy = vy; b.body.update(dt, s.map);\n  if (b.cool <= 0 && !b.atk.busy && d < 46 && !H.dead) {\n    b.atk = new E.Attack(b.moves[b.mi % b.moves.length], { reach: 15 }); b.mi++;\n    if (b.atk.start()) b.cool = rush > 1 ? .9 : 1.4;\n  }\n  b.atk.update(dt);\n  b.tele = b.atk.state && b.atk.state.phase === 'wind' ? 1 : 0;\n  if (b.atk.state && b.atk.state.phase === 'active') b.atk.hits([H.body], t => E.inArc(b.body, b.facing, t, 24, 1.4, 16), () => hurtHero(s, b.dmg, b.body));\n  b.rig.update(dt, { x: b.body.x, y: b.body.y, z: 0, vx, vy, facing: b.facing, attack: b.atk.state, hurt: b.flash > 0, run: vx || vy ? .6 : 0 });\n  if (b.hp <= 0 && !b.dead) { b.dead = true; b.downT = 0; sfx('explode'); }\n}\nfunction drawHero(r, H) {\n  r.actor(H.body.x, H.body.y, H.body.z, (g, ox, oy) => H.rig.draw(g, ox, oy, r.view), { flash: H.inv > .5 && Math.floor(game.time * 12) % 2 ? '#ffffff' : undefined, flashMix: .6 });\n}\nfunction drawFoe(r, f) {\n  if (f.dead && f.downT > 5) return;\n  if (f.tele) r.groundRing(f.body.x, f.body.y, 26, '#ff7a4a', .8);\n  r.actor(f.body.x, f.body.y, 0, (g, ox, oy) => f.rig.draw(g, ox, oy, r.view), { flash: f.flash > 0 ? '#ffffff' : undefined, flashMix: .75 });\n  if (f.state === 'alert' && !f.dead) r.textAt(f.body.x, f.body.y, 46, '!', '#ff5a4a');\n}\nfunction hud(r, H, objective) {\n  r.overlay(g => {\n    if (H && !H.dead) E.ui.hearts(g, 8, r.H - 16, Math.max(0, H.hp), 6);\n    E.font.text(g, '$' + progress.cash, r.W - 8, 8, '#f4e27a', { align: 'right', shadow: '#000', outline: false });\n    if (objective) E.font.text(g, objective, 8, 8, '#fff6dc', { shadow: '#000', outline: false });\n    if (DEMO) E.font.text(g, 'ATTRACT MODE: PRESS ANY BUTTON', r.W / 2, 22, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });\n  });\n}\nfunction deathCard(r, msg) {\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H, '#000000');\n    E.font.text(g, 'HOLLIS IS DOWN', r.W / 2, r.H / 2 - 16, '#ff7a6a', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    E.font.text(g, msg, r.W / 2, r.H / 2 + 8, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n  });\n}\n\n/* ========================================================================================= *\n *  OVER (game over, retry or title), ENDING (the chapel is quiet), ABOUT (how to play, the source information and the\n *  feedback), WAIT (an AI Hub round before its start)\n * ========================================================================================= */\nlet overMenu = null;\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() {\n    A.music(null); DEMO = false; cur = null;\n    overMenu = new E.Menu(game, ['TRY AGAIN', 'TITLE'], { box: false, y: 0, color: '#fff6dc', pick: '#ffd36a', onPick: i => {\n      if (i === 0) game.go(progress.scene, {}, { fade: 'dissolve' }); else game.go('title', {}, { fade: 'dissolve' });\n    } });\n  },\n  update(dt) { overMenu.update(dt); },\n  draw(r) {\n    r.sky(['#2a0c08', '#0c0606']);\n    overMenu.y = (r.H / 2 | 0) + 20;\n    r.overlay(g => E.font.title(g, 'DOWN', r.W / 2, 40, { align: 'center', scale: 3, colors: ['#ffd0c0', '#ff7a6a'] }));\n    overMenu.draw(r);\n  }\n};\nlet endT = 0;\nscenes.ending = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { A.music('victory'); endT = 0; DEMO = false; cur = null; },\n  update(dt) {\n    endT += dt;\n    const I = game.input;\n    if (endT > 2 && I.anyPressed()) { I.consumeAll(); game.go('about', { page: 1 }, { fade: 'dissolve' }); }\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    r.overlay(g => {\n      E.font.title(g, 'NOT THE END', r.W / 2, r.H * .3 | 0, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, 'Cash in the wall: $' + progress.cash, r.W / 2, r.H * .5 | 0, '#f4e27a', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Vail is down. The chapel is quiet. The rest of the year is a different story.', r.W / 2, r.H * .58 | 0, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });\n      E.font.text(g, 'Press any button for the credits', r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n};\nconst PAGES = ['HOW TO PLAY', 'SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK'];\nlet about = { page: 0, scroll: 0 };\nscenes.about = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter(data) { A.music('title'); DEMO = false; cur = null; about = { page: (data && data.page) || 0, scroll: 0 }; },\n  update(dt) {\n    const I = game.input, mv = I.move();\n    if (I.pressed('cancel') || (I.pressed('confirm') && about.page === PAGES.length - 1)) { I.consumeAll(); return game.go('title', {}, { fade: 'dissolve' }); }\n    if (I.pressed('left') && about.page > 0) { about.page--; about.scroll = 0; }\n    if (I.pressed('right') && about.page < PAGES.length - 1) { about.page++; about.scroll = 0; }\n    about.scroll = clamp(about.scroll - mv[1] * 140 * dt, -4000, 0);\n  },\n  draw(r) {\n    r.sky(['#2a1a18', '#0c0a0c']);\n    const body = aboutBody(about.page, r.W - 24);\n    r.overlay(g => {\n      E.font.title(g, PAGES[about.page], r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff6d8', '#ffd36a'] });\n      E.font.text(g, (about.page + 1) + ' / ' + PAGES.length + '   ' + label('left') + ' ' + label('right') + ' page   ' + label('cancel') + ' back', r.W / 2, r.H - 14, '#c8b8a0', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n      let y = 40 + about.scroll;\n      for (const ln of body) { if (y > 24 && y < r.H - 24) E.font.text(g, ln, 12, y, '#f4e6c8', { shadow: '#000', outline: false, font: 'tiny' }); y += 9; }\n    });\n  }\n};\n// the about screen's text, wrapped to the screen's width\nfunction aboutBody(page, w) {\n  const out = [], add = s => { for (const ln of E.font.wrap(String(s), w, { font: 'tiny' })) out.push(ln); };\n  if (page === 0) {\n    add('Hollis Rook teaches chemistry at a high school in a dry town. He has a diagnosis, a garage, and a plan that gets worse by the day.');\n    add('');\n    add('Move: WASD, the arrows, or the stick. Swing: J, X or click. Dash: Space or Shift. Talk and cook: Enter, Space, or confirm.');\n    add('Cook: a green band slides across a bar. Press in the band. Three presses make a batch.');\n    add('Desert: walk the three batches to the RV at the compound. Vail\\'s men have sight cones. Stay out of them, or fight.');\n    add('Showdown: Vail telegraphs his haymakers with a ring on the ground. Step out of the ring, then strike.');\n    add('');\n    add('V changes the camera view. - and = zoom. Escape or Start opens the pause menu: Save, Load, Settings, Controls.');\n    add('Settings: invert the gamepad\\'s left-right or up-down, and choose PlayStation or Xbox button symbols.');\n    add('A touch-only screen needs a controller or keyboard. The title\\'s attract mode runs without one.');\n  } else if (page === 1) {\n    const s = EXIT.sourceInformation || {};\n    const rows = [['Date', s.date], ['Source', s.source], ['Genre and perspective', [s.genre, s.perspective].filter(Boolean).join('; ')], ['Tech', s.tech],\n      ['Art direction', s.artDirection], ['Animation', s.animation], ['Audio', s.audio], ['Online', s.online], ['Testing', s.testing],\n      ['Research', s.research], ['Environment', s.environment], ['Model', s.model], ['Usage', s.usage]];\n    for (const [k, v] of rows) add(k + ': ' + (v || 'unknown'));\n  } else if (page === 2) for (const t of EXIT.testingFeedback || ['unknown']) add('- ' + t);\n  else if (page === 3) for (const t of EXIT.engineFeedback || ['unknown']) add('- ' + t);\n  else for (const t of EXIT.promptFeedback || ['unknown']) add('- ' + t);\n  return out;\n}\nlet roundStarted = false;\nscenes.wait = {\n  view: 'side', input: 'DEFAULT', res: 'ps1', pausable: false,\n  enter() { roundStarted = false; DEMO = false; cur = null; },\n  update() { if (roundStarted) game.go('desert', { round: true }, { fade: 0 }); },\n  draw(r) { r.sky(['#2a1a18', '#0c0a0c']); r.overlay(g => E.font.text(g, 'AI HUB  ·  GET READY', r.W / 2, r.H / 2, '#ffe08a', { align: 'center', shadow: '#000', outline: false })); }\n};\n\n/* ========================================================================================= *\n *  START\n * ========================================================================================= */\nif (HUB) {\n  HUB.on('start', () => { roundStarted = true; });\n  HUB.on('time-up', () => { if (cur && cur.round && !cur.hubDone) { cur.hubDone = true; HUB.result({ score: progress.cash, stats: { 'Batches delivered': progress.delivered, 'Cash': progress.cash } }); } });\n  HUB.on('end', () => { if (cur) cur.phase = 'over'; });\n  HUB.connect({ mode: 'parallel', seats: [1, 4] }).then(() => HUB.ready());\n}\ngame.debug = { snapshot: () => ({ scene: game.sceneName, demo: DEMO, progress: JSON.parse(JSON.stringify(progress)), hp: cur && cur.hero ? cur.hero.hp : null }) };\ngame.start({ scene: HUB ? 'wait' : 'title', scenes });\nwindow.__breakingDustBowl = { game, scenes, progress: () => progress, cur: () => cur, setDemo: v => { DEMO = v; } };\n})();\n","structuredPatch":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":10,"lines":[" // BREAKING DUST BOWL: a playful riff on Breaking Bad (2008-2013). A top-down action adventure with a cook sim in the","-// middle: a garage lab (a timed cook), a desert run (sneak past Vail's men, pick up three batches, deliver them to the","-// RV), and a showdown in a chapel ruin. Built on my-3D2dge (the ADVENTURE kit's engine, v0.85.1, with its modules).","-// Controls: WASD / arrows or a pad's stick move; J, X or click swings; Space, Shift or the dash button dashes; Enter,","-// Space or confirm talks and cooks; V changes the view; Escape or Start opens the pause menu (Settings holds the","-// gamepad axis inversion and the button symbols). Attract mode: 10 seconds on the title, then an AI plays (it cheats).","+// middle: a garage lab (three timed cooks), a desert run (dodge Vail's men by their sight cones, pick up three batches,","+// deliver them to the RV), then a showdown in a chapel ruin. Built on my-3D2dge v0.85.1 (the ADVENTURE kit's engine).","+// Keys: WASD or arrows move; J, X or click swings; Space or Shift dashes; Enter or Space confirms (talk, cook); V changes","+// the view; - and = zoom; M mutes; Escape or Start opens the pause menu (Settings: gamepad axis inversion, button symbols).","+// Attract mode: 10 seconds on the title, then an AI plays (it cheats: it can't be hurt). Any button ends it.","+// AI Hub: opened from the hub, the page skips the title and plays one round of the desert run, parallel mode."," (() => {"," 'use strict';"," const E = My3D2dge, { clamp } = E;"]},{"oldStart":19,"oldLines":20,"newStart":20,"newLines":22,"lines":["   menu: { saves: { write: () => ({ data: JSON.parse(JSON.stringify(progress)), place: progress.scene, level: progress.delivered }),","     read: save => { progress = Object.assign(freshProgress(), save.data || {}); } } }"," });","-const P = game.particles, L = game.lights, A = game.audio;","+const L = game.lights, A = game.audio;"," const scenes = {};","-const rgbHex = c => E.toHex ? E.toHex(c) : c;","+let DEMO = false;          // attract mode (or a demo run): an AI plays, the player's buttons end it","+let cur = null;            // the active chapter's state: lab, ds (desert) or sh (showdown)"," const label = a => game.input.label(a);","+// a touch-only screen (no mouse, no keyboard, no pad): it needs a controller or keyboard"," const touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;","+const needsPad = () => touchOnly() && !['keyboard', 'gamepad', 'mouse'].includes(game.input.lastDevice);","+const prompt = (a, word) => label(a) + ' ' + word;"," ","-/* ---- settings: the gamepad's axis inversion (the common fix for a stick that flips), the button symbols ---- */"," game.settings.define({ key: 'invertX', label: 'Invert gamepad left/right', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick left and right, for a pad that reads inverted' });"," game.settings.define({ key: 'invertY', label: 'Invert gamepad up/down', type: 'toggle', value: false, group: 'Controls', help: 'Flips the stick up and down' });"," game.settings.define({ key: 'glyphs', label: 'Button symbols', type: 'select', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']], value: 'playstation', group: 'Controls',","-  help: 'The buttons drawn in prompts when a controller is in use', apply(g, v) { g.input.glyphs = v; } });","+  help: 'The buttons drawn in prompts while a controller is in use', apply(g, v) { g.input.glyphs = v; } });"," game.input.touchEnabled = false;   // no touch controls: a touch-only screen is told a controller or keyboard is needed"," ","-/* ---- keys every scene shares ---- */"," addEventListener('keydown', e => {","   if (e.repeat) return;","   if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }"]},{"oldStart":42,"oldLines":37,"newStart":45,"newLines":36,"lines":[" "," /* ---- helpers ---- */"," const sfx = (n, o) => A.sfx(n, o);","+const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);"," const live = list => list.filter(f => !f.dead);","-// the stick's direction on the screen, with the gamepad's inversion applied (keyboard and mouse are never inverted)","+// the stick's direction on the ground: a pad's axes are inverted when the player's settings say so (keys and mouse never are)"," function moveDir() {","   const I = game.input; let [mx, my] = I.move();","   if (I.lastDevice === 'gamepad') { if (game.settings.invertX) mx = -mx; if (game.settings.invertY) my = -my; }","   return game.view.screenDirToGround(mx, my);"," }","-// a world point under the mouse, or null (aiming)","+// the world point under the mouse (the blade aims at it), or null"," function mousePoint() { const p = game.mouseGround(); return p ? { x: p[0], y: p[1] } : null; }","-function aimAt(body, pt) { return E.angleTo(body, pt); }","-// a one-line prompt in the player's own controls: \"E Talk\" on a keyboard, \"A Talk\" on a pad (PlayStation or Xbox symbols)","-const prompt = (a, word) => label(a) + ' ' + word;","-// the view toggle and the camera zoom are the player's own; the scene's camera: { zoom: [min, max], start }","-const camFor = () => (game.scene && game.scene.camera) || {};","-function textPrompt(r, s, y) { r.text(s, r.W / 2, y || r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }","+function angDiff(a, b) { return Math.abs(((b - a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI); }","+function textPrompt(r, s) { r.text(s, r.W / 2, r.H - 30, '#fff6dc', { align: 'center', shadow: '#000', outline: false }); }","+// a dialog in attract mode closes itself; in play it waits for the player","+function say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: DEMO ? 1.8 : 0 }, o || {})); }"," ","-/* ---- the shared rig roster ---- */","+/* ---- the rig roster ---- */"," const RIG = {","   hollis: () => new E.Humanoid({ size: 1.3, outfit: 'shirt', hair: 'short', sleeves: 'long', face: { eyes: 'big', bangs: .3 },","     colors: { skin: '#e8b890', hair: '#b8b0a0', cloth: '#e8dcc0', trim: '#c8b088', pants: '#4a4a58', boot: '#3a2a1a', belt: '#2a1a10', glove: '#8a7a68', eye: '#3a3a4a' } }),","   tomas: () => new E.Humanoid({ size: 1.2, outfit: 'tunic', hair: 'spiky', hat: { style: 'band', color: '#3aa050' }, sleeves: 'short', weapon: null, face: { eyes: 'big', bangs: .6 },","     colors: { skin: '#d8a880', hair: '#2a2018', cloth: '#3a8a4a', trim: '#f0d070', pants: '#3a3a4a', boot: '#2a1a10', belt: '#4a3018', eye: '#2a3a4a' } }),","-  grunt: (c) => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: c || '#b02a2a' }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },","-    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: '#b02a2a', pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),","+  grunt: hat => new E.Humanoid({ size: 1.2, outfit: 'coat', hair: 'short', hat: { style: 'band', color: hat }, sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .3 },","+    colors: { skin: '#c89070', hair: '#2a1a10', cloth: '#2a3a5a', coat: '#2a3a5a', trim: hat, pants: '#3a3a48', boot: '#1a1412', belt: '#1a1412', eye: '#2a2a2a' } }),","   vail: () => new E.Humanoid({ size: 2.0, build: 'bulky', outfit: 'coat', hair: 'bald', sleeves: 'long', weapon: null, face: { eyes: 'big' },","-    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } }),","-  clerk: () => new E.Humanoid({ size: 1.15, outfit: 'robe', hair: 'ponytail', sleeves: 'long', weapon: null, face: { eyes: 'big', bangs: .8 },","-    colors: { skin: '#e8c0a0', hair: '#4a2a1a', cloth: '#7a6aa0', trim: '#f0d0a0', pants: '#7a6aa0', boot: '#4a3a2a', eye: '#2a2a4a' } })","+    colors: { skin: '#d8a070', cloth: '#1e1e26', coat: '#26262e', trim: '#c8a040', pants: '#2a2a30', boot: '#0a0a0a', belt: '#0a0a0a', eye: '#2a2a3a' } })"," };"," ","-/* ---- the title: a ledge of heroes under a desert sky ---- */","+/* ========================================================================================= *","+ *  TITLE: a ledge of heroes under a desert sky. NEW GAME, CONTINUE (a save), ABOUT, OPTIONS.","+ * ========================================================================================= */"," const MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },","   types: { 1: { style: 'stone', side: '#8a6a4a', moss: '#6a7a3a' } }, edges: 'open' });"," const titleBg = new E.Backdrop('desert');"]},{"oldStart":80,"oldLines":38,"newStart":82,"newLines":26,"lines":["   { face: 0, rig: RIG.hollis(), x: MID - 70 },","   { face: 0, rig: RIG.tomas(), x: MID - 35 },","   { face: Math.PI, rig: RIG.vail(), x: MID + 25 },","-  { face: Math.PI, rig: RIG.grunt(), x: MID + 60 }","+  { face: Math.PI, rig: RIG.grunt('#b02a2a'), x: MID + 60 }"," ];"," const corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };","-","-/* ---- DIALOG helper: talk lines wait for the player; in attract mode they turn themselves ---- */","-function say(talk, lines, o) { return talk.say(lines, Object.assign({ auto: scenes.demo ? 1.8 : 0 }, o || {})); }","-","-/* ========================================================================================= *","- *  TITLE and the menus                                                                        *","- * ========================================================================================= */","-let titleMenu = null, idle = 0, titleNote = '', noteT = 0;","+let titleMenu = null, idle = 0;","+const TITLE_ITEMS = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];"," scenes.title = {","-  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1', pausable: false,","+  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',","   enter() {","-    A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;","-    L.enabled = false; game.weather = null; idle = 0; scenes.demo = false; titleNote = ''; game.cam.snap = true;","-    titleMenu = titleMenu || new E.Menu(game, ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'], {","-      y: 0, title: null, box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',","-      onPick: (i, item) => titleAction(i),","-      onCancel: () => {}","+    A.music('title'); DEMO = false; cur = null; idle = 0; game.weather = null; L.enabled = false;","+    game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null;","+    titleMenu = new E.Menu(game, TITLE_ITEMS.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() })), {","+      box: false, color: '#fff6dc', pick: '#ffd36a', dim: '#7a6e5a',","+      onPick: i => titleAction(i)","     });","-    titleMenu.i = 0;","-    titleMenu.items = ['NEW GAME', 'CONTINUE', 'ABOUT', 'OPTIONS'];","-    titleMenu.items = titleMenu.items.map((t, i) => ({ label: t, disabled: i === 1 && !game.saves.latest() }));","   },","   update(dt) {","     const I = game.input;","-    if (I.anyPressed() && !(I.pressed('confirm') || I.pressed('start'))) { idle = 0; }","     if (I.anyPressed()) idle = 0; else idle += dt;","-    if (titleNote && (noteT -= dt) < 0) titleNote = '';","-    if (!titleMenu.update(dt)) { /* the menu owns the input */ }","-    if (idle > 10) { idle = 0; startDemo(); return; }","+    if (idle > 10) { idle = 0; return startDemo(); }","+    titleMenu.update(dt);","     game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);","     TITLE_HEROES.forEach((h, i) => {","       const u = (game.time * .45 + i * .37) % 3;"]},{"oldStart":129,"oldLines":29,"newStart":119,"newLines":26,"lines":["       E.font.title(g, 'BREAKING', r.W / 2, 14 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });","       E.font.title(g, 'DUST BOWL', r.W / 2, 56 + top, { align: 'center', scale: 3, colors: ['#fff6d8', '#ffd36a', '#e08a2a'], depth: 3 });","       E.font.text(g, 'A bad batch in a dry town', r.W / 2, 100 + top, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });","+      if (needsPad()) E.font.text(g, 'Controller or keyboard required', r.W / 2, r.H - 46, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });","     });","     titleMenu.draw(r);","-    r.overlay(g => {","-      const touch = game.input.lastDevice === 'touch';","-      const warn = touchOnly() && game.input.lastDevice !== 'gamepad' && game.input.lastDevice !== 'keyboard' ? 'Controller or keyboard required' : '';","-      E.font.text(g, warn || titleNote, r.W / 2, r.H - 44, '#ff9a7a', { align: 'center', shadow: '#000', outline: false });","-    });","     const dev = game.input.lastDevice;","     const how = dev === 'gamepad' ? label('confirm') + ' pick   ' + label('start') + ' options' : 'Arrows + Enter, or click   V view   - = zoom   M mute';","     r.text(how, r.W / 2, r.H - 26, '#c8b8a0', { align: 'center', shadow: '#000', outline: false });","   }"," };"," function titleAction(i) {","-  if (i !== 3 && touchOnly() && game.input.lastDevice === 'touch') { titleNote = 'Controller or keyboard required'; noteT = 2.5; return; }","-  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', { demo: false }, { fade: 'iris', seconds: .5 }); }","+  if ((i === 0 || i === 1) && needsPad()) return;","+  if (i === 0) { progress = freshProgress(); sfx('confirm'); game.go('lab', {}, { fade: 'iris', seconds: .5 }); }","   else if (i === 1) { const s = game.saves.latest(); if (s) { game.saves.load(s.slot); sfx('confirm'); game.go(progress.scene, {}, { fade: 'dissolve' }); } }","   else if (i === 2) { sfx('select'); game.go('about', { page: 0 }, { fade: 'dissolve' }); }","   else if (i === 3) { sfx('select'); game.menu('settings'); }"," }","-function startDemo() { scenes.demo = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }","+function startDemo() { DEMO = true; progress = freshProgress(); game.go('lab', { demo: true }, { fade: 'dissolve' }); }"," "," /* ========================================================================================= *","  *  LAB: a garage, a cook station, Tomas. Cook three batches; the door opens when they are done.","+ *  Cook: three presses on a sliding bar. Each press in the green band is a clean stage.","  * ========================================================================================= */"," const LAB_ROWS = [","   '############',"]},{"oldStart":165,"oldLines":14,"newStart":152,"newLines":11,"lines":["   '#####D######'"," ];"," const COOK_STAGES = ['DISSOLVE', 'HEAT', 'PULL'];","-let lab = null;   // the lab's state, while in it"," scenes.lab = {","   view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,","   enter(data) {","-    const demo = !!(data && data.demo);","-    scenes.demo = demo; progress.scene = 'lab';","-    A.music('adventure');","-    L.enabled = true; L.ambient = .55;","+    DEMO = !!(data && data.demo); progress.scene = 'lab';","+    A.music('adventure'); L.enabled = true; L.ambient = .55; game.weather = null;","     const map = new E.TileMap({","       rows: LAB_ROWS,","       legend: { '#': 2, '.': { floor: 'concrete' }, 'B': { floor: 'concrete', spawn: 'bench' }, 'H': { floor: 'concrete', spawn: 'hero' },"]},{"oldStart":181,"oldLines":114,"newStart":165,"newLines":96,"lines":["       floorTex: (x, y, tag) => tag === 'door' ? E.tex.planks(x, y, { base: '#7a5a3a' }) : E.tex.plain(x, y, { base: '#9a9690', amount: .12 }),","       outside: '#1e1a18'","     });","-    game.cam.bounds = v => map.bounds(v);","+    game.cam.bounds = v => map.bounds(v); game.follow(null);","     const h = map.find('hero'), t = map.find('tomas'), c = map.find('cook'), x = map.find('exit');","-    lab = { map, demo, phase: 'intro', cook: null, cookDone: 0, talk: new E.Dialog(game),","-      hero: makeHero(h.x, h.y, 'hollis'), tomas: { rig: RIG.tomas(), x: t.x, y: t.y, facing: Math.PI / 2, t: 0 },","-      station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };","-    game.focus(lab.hero.body.x, lab.hero.body.y, 10); game.follow(null);","-    if (demo) { lab.talk.auto = 1.6; }","-    if (!demo) {","-      const tomas = lab.tomas;","-      say(lab.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',","-        'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two promises, Tomas.',","-        () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three timed presses: a green band, the sweet spot.'],","-        { name: 'TOMAS', portrait: tomas.rig, onDone: () => { lab.phase = 'free'; } });","-    } else { lab.phase = 'free'; }","+    cur = { kind: 'lab', map, talk: new E.Dialog(game), hero: makeHero(h.x, h.y), cook: null, cookDone: progress.batches || 0, phase: 'intro',","+      tomas: { rig: RIG.tomas(), x: t.x, y: t.y }, station: { x: c.x, y: c.y }, exit: { x: x.x, y: x.y }, benches: map.findAll('bench') };","+    game.focus(cur.hero.body.x, cur.hero.body.y, 10);","+    if (DEMO) cur.phase = 'free';","+    else say(cur.talk, ['Cold in here, Mr. Rook. The cook station is warm, though.',","+      'Three batches. Clean ones. Nobody gets hurt and nobody gets curious.', 'Those are two different promises, Tomas.',","+      () => 'Press ' + label('confirm') + ' at the station to cook. Each batch is three presses, timed to the green band.'],","+      { name: 'TOMAS', portrait: cur.tomas.rig, onDone: () => { cur.phase = 'free'; } });","   },","   update(dt) {","-    if (!lab) return;","-    const I = game.input;","-    if (!scenes.demo && I.anyPressed() === false) { /* idle */ }","-    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }","-    lab.tomas.t += dt;","-    if (lab.talk.update(dt)) { if (scenes.demo) demoTalk(lab); return; }","-    if (lab.phase === 'cook') return cookStep(dt);","-    if (lab.phase === 'free' || lab.phase === 'after') {","-      const dir = scenes.demo ? aiLabDir() : moveDir();","-      stepHero(dt, dir, { lab: true });","-      const near = (p, r) => Math.hypot(lab.hero.body.x - p.x, lab.hero.body.y - p.y) < r;","-      if (lab.phase === 'free' && !scenes.demo && near(lab.station, 22) && (I.pressed('confirm') || I.clicked()) && lab.cookDone < 3) { I.consumeAll(); startCook(); }","-      if (lab.phase === 'free' && !scenes.demo && near(lab.tomas, 26) && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); tomasTalk(); }","-      if (lab.phase === 'free' && scenes.demo && near(lab.station, 22) && lab.cookDone < 3) startCook();","-      if (lab.cookDone >= 3 && near(lab.exit, 14)) {","-        if (scenes.demo || I.pressed('confirm')) { I.consumeAll(); progress.scene = 'desert'; sfx('door'); game.go('desert', { demo: !!scenes.demo }, { fade: 'iris', seconds: .5 }); }","-      }","-    }","-    if (lab.phase === 'intro') return;","-    if (!scenes.demo && I.pressed('cancel') && lab.phase === 'free') { /* cancel: pause menu handles it */ }","+    const s = cur, I = game.input;","+    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }","+    if (s.talk.update(dt)) return;","+    if (s.phase === 'cook') return cookStep(dt, s);","+    if (s.phase !== 'free') return;","+    const near = (p, r) => dist(s.hero.body, p) < r;","+    const dir = DEMO ? aiLabDir(s) : moveDir();","+    stepHero(dt, dir, { speed: 78 }, s);","+    const press = !DEMO && (I.pressed('confirm') || I.clicked());","+    if (near(s.station, 22) && s.cookDone < 3 && (press || DEMO)) { I.consumeAll(); startCook(s); return; }","+    if (near(s.tomas, 26) && press) { I.consumeAll(); tomasLines(s); }","+    if (s.cookDone >= 3 && near(s.exit, 14) && (press || DEMO)) { I.consumeAll(); sfx('door'); game.go('desert', { demo: DEMO }, { fade: 'iris', seconds: .5 }); }","   },","   draw(r) {","-    if (!lab) return;","-    lab.map.drawFloor(r);","-    for (const b of lab.benches) benchDraw(r, b.x, b.y);","-    cookDraw(r, lab.station.x, lab.station.y);","-    r.shadow(lab.hero.body.x, lab.hero.body.y, 5);","-    lab.map.queueWalls(r);","-    r.prop('barrel', lab.exit.x - 22, lab.exit.y - 16, 0, { size: .9, light: false });","-    r.actor(lab.tomas.x, lab.tomas.y, 0, (g, ox, oy) => lab.tomas.rig.draw(g, ox, oy, r.view));","-    drawHero(r, lab.hero);","-    L.add(lab.station.x, lab.station.y, 40, 60, .9, { color: '#e8ffa8' });","-    L.add(lab.exit.x, lab.exit.y, 30, 40, .6, { color: '#ffd090' });","-    if (lab.phase === 'cook') cookOverlay(r);","-    lab.talk.draw(r);","-    hud(r, lab.phase === 'free' ? (lab.cookDone < 3 ? 'COOK ' + lab.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT') : '');","-    if (lab.phase === 'free' && !scenes.demo) {","-      const near = Math.hypot(lab.hero.body.x - lab.station.x, lab.hero.body.y - lab.station.y) < 22;","-      if (near && lab.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (lab.cookDone + 1)));","-      else if (Math.hypot(lab.hero.body.x - lab.tomas.x, lab.hero.body.y - lab.tomas.y) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));","+    const s = cur;","+    s.map.drawFloor(r);","+    for (const b of s.benches) benchDraw(r, b.x, b.y);","+    cookDraw(r, s.station.x, s.station.y);","+    r.shadow(s.hero.body.x, s.hero.body.y, 5);","+    s.map.queueWalls(r);","+    r.actor(s.tomas.x, s.tomas.y, 0, (g, ox, oy) => s.tomas.rig.draw(g, ox, oy, r.view));","+    drawHero(r, s.hero);","+    L.add(s.station.x, s.station.y, 40, 60, .9, { color: '#e8ffa8' });","+    L.add(s.exit.x, s.exit.y, 30, 40, .6, { color: '#ffd090' });","+    if (s.phase === 'cook') cookOverlay(r, s.cook);","+    s.talk.draw(r);","+    hud(r, s.hero, s.cookDone < 3 ? 'COOK ' + s.cookDone + '/3 BATCHES' : 'DOOR OPEN: THE DESERT');","+    if (s.phase === 'free' && !DEMO && !s.talk.open) {","+      if (dist(s.hero.body, s.station) < 22 && s.cookDone < 3) textPrompt(r, prompt('confirm', 'Cook batch ' + (s.cookDone + 1)));","+      else if (dist(s.hero.body, s.tomas) < 26) textPrompt(r, prompt('confirm', 'Talk to Tomas'));","+      else if (s.cookDone >= 3 && dist(s.hero.body, s.exit) < 14) textPrompt(r, prompt('confirm', 'Leave for the desert'));","     }","   }"," };","-function tomasTalk() {","-  const L1 = lab.cookDone >= 3 ? ['Three batches. Mr. Rook, I think the van is ready.', 'We walk out of here, Tomas. The van can wait.']","-    : lab.cookDone ? ['Batch ' + lab.cookDone + ' is in the bag. Cook the next one when you want the money.'] : ['The station is hot. Press ' + label('confirm') + ' when the band lines up.'];","-  say(lab.talk, L1, { name: 'TOMAS', portrait: lab.tomas.rig });","+function tomasLines(s) {","+  const lines = s.cookDone >= 3 ? ['Three batches. Mr. Rook, the van is ready.', 'We walk out of here, Tomas. The van can wait.']","+    : s.cookDone ? ['Batch ' + s.cookDone + ' is in the bag. The next one is when you want the money.']","+    : ['The station is hot. Press ' + label('confirm') + ' at it when the band lines up.'];","+  say(s.talk, lines, { name: 'TOMAS', portrait: s.tomas.rig });"," }","-function demoTalk(l) { /* attract mode closes the box by itself */ }","-function startCook() {","-  lab.phase = 'cook';","-  lab.cook = { stage: 0, pos: 0, dir: 1, speed: 1.1, zone: 0, half: .11, t: 0, results: [], flash: 0 };","-  newZone(lab.cook);","-  sfx('select');","+function startCook(s) {","+  s.phase = 'cook';","+  s.cook = { stage: 0, pos: 0, dir: 1, zone: 0, half: .11, t: 0, results: [], flash: 0 };","+  newZone(s.cook); sfx('select');"," }"," function newZone(c) { c.zone = .22 + E.rand() * .56; c.half = .11 - c.stage * .015; }","-function cookStep(dt) {","-  const c = lab.cook, I = game.input;","-  c.t += dt; c.pos += c.dir * c.speed * dt * (1 + c.stage * .25);","+function cookStep(dt, s) {","+  const c = s.cook, I = game.input;","+  c.t += dt; c.pos += c.dir * (1.1 + c.stage * .28) * dt;","   if (c.pos > 1) { c.pos = 2 - c.pos; c.dir = -1; } if (c.pos < 0) { c.pos = -c.pos; c.dir = 1; }","   if (c.flash > 0) c.flash -= dt;","-  let press = !scenes.demo && (I.pressed('confirm') || I.clicked());","-  if (scenes.demo && Math.abs(c.pos - c.zone) < c.half * .5) press = true;","-  if (press) {","-    I.consumeAll();","-    const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;","-    c.results.push(miss ? .45 : .6 + .4 * acc);","-    c.flash = .35; sfx(miss ? 'hurt' : 'blip');","-    if (++c.stage >= 3) { finishCook(); return; }","-    newZone(c);","-  }","+  let press = !DEMO && (I.pressed('confirm') || I.clicked());","+  if (DEMO && Math.abs(c.pos - c.zone) < c.half * .5) press = true;","+  if (!press) return;","+  I.consumeAll();","+  const miss = Math.abs(c.pos - c.zone) > c.half, acc = miss ? 0 : 1 - Math.abs(c.pos - c.zone) / c.half;","+  c.results.push(miss ? .45 : .6 + .4 * acc);","+  c.flash = .35; sfx(miss ? 'hurt' : 'blip');","+  if (++c.stage < 3) { newZone(c); return; }","+  const pur = c.results.reduce((a, b) => a + b, 0) / c.results.length;","+  progress.purity.push(+pur.toFixed(3)); s.cookDone++; progress.batches = s.cookDone;","+  s.phase = 'free'; s.cook = null; sfx('coin');","+  const line = pur > .9 ? 'That color. That is the actual color.' : pur > .75 ? 'Clean enough. Clean enough is what we sell.' : 'Cloudy. Cloudy is a problem for a man with a lab coat.';","+  say(s.talk, [line].concat(s.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: s.hero.rig });"," }","-function finishCook() {","-  const pur = lab.cook.results.reduce((a, b) => a + b, 0) / lab.cook.results.length;","-  progress.purity.push(+pur.toFixed(3)); lab.cookDone++; progress.batches = lab.cookDone;","-  lab.phase = 'free'; lab.cook = null;","-  sfx('coin');","-  const lines = pur > .9 ? ['That color. That is the actual color.'] : pur > .75 ? ['Clean enough. Clean enough is what we sell.'] : ['Cloudy. Cloudy is a problem for a man with a lab coat.'];","-  if (!scenes.demo) say(lab.talk, lines.concat(lab.cookDone >= 3 ? ['That is three. Head for the door.'] : []), { name: 'HOLLIS', portrait: lab.hero.rig });","-  game.hitFx && 0;","+function aiLabDir(s) {","+  const b = s.hero.body, tx = s.cookDone < 3 ? s.station.x : s.exit.x, ty = s.cookDone < 3 ? s.station.y : s.exit.y;","+  const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);","+  return d < 14 ? [0, 0] : [dx / d, dy / d];"," }","-function cookOverlay(r) {","-  const c = lab.cook;","+function cookOverlay(r, c) {","   r.overlay(g => {","-    const W = Math.min(r.W - 40, 260), x0 = (r.W - W) / 2, y0 = r.H * .3;","+    const W = Math.min(r.W - 40, 260), x0 = Math.round((r.W - W) / 2), y0 = Math.round(r.H * .3);","     E.ui.box(g, x0 - 10, y0 - 22, W + 20, 72, { bg: ['#1e1a2a', '#0c0a14'], border: '#c8b088' });","     E.font.text(g, 'STAGE ' + (c.stage + 1) + '/3   ' + COOK_STAGES[c.stage], r.W / 2, y0 - 12, '#ffd36a', { align: 'center', shadow: '#000', outline: false });","     E.ui.box(g, x0, y0, W, 14, { bg: '#2a2432', border: '#5a5068', gradient: false });","-    const zx = x0 + c.zone * W - c.half * W, zw = c.half * 2 * W;","-    E.px.rect(g, Math.round(zx), y0 + 1, Math.round(zw), 12, '#3aa050');","-    const mx = Math.round(x0 + c.pos * W);","-    E.px.rect(g, mx - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');","+    E.px.rect(g, Math.round(x0 + (c.zone - c.half) * W), y0 + 1, Math.round(c.half * 2 * W), 12, '#3aa050');","+    E.px.rect(g, Math.round(x0 + c.pos * W) - 1, y0 - 3, 3, 20, c.flash > 0 ? '#ff7a6a' : '#ffffff');","     E.font.text(g, 'press ' + label('confirm') + ' in the green', r.W / 2, y0 + 26, '#f4e6c8', { align: 'center', shadow: '#000', outline: false });","   });"," }"]},{"oldStart":299,"oldLines":128,"newStart":265,"newLines":112,"lines":[" }"," "," /* ========================================================================================= *","- *  DESERT: the run. Three batches to pick up, the RV to deliver them to, the chapel to go to.","+ *  DESERT: the run. Three batches to pick up, the RV to deliver them to, then the chapel path.","  * ========================================================================================= */"," const DW = 40, DH = 26;","+const GRUNT_PATROLS = [[[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]];","+const BATCH_CELLS = [[9, 20], [15, 6], [36, 17]];"," function buildDesert() {","   const g = Array.from({ length: DH }, (_, y) => Array.from({ length: DW }, (_, x) => (x === 0 || y === 0 || x === DW - 1 || y === DH - 1) ? '#' : '.'));","   const put = (x, y, c) => { if (x > 0 && y > 0 && x < DW - 1 && y < DH - 1) g[y][x] = c; };","-  // scatter of rocks and cacti, away from the road and the compound","+  // scrub and rock scattered by hash, kept off the road, the start, and the compound","   for (let y = 1; y < DH - 1; y++) for (let x = 1; x < DW - 1; x++) {","     if (x < 6 || (x >= 24 && x <= 36 && y <= 12) || y === 12 || y === 13) continue;","     const h = E.hash2(x * 3 + 1, y * 7 + 2);","-    if (h < .05) g[y][x] = '#'; else if (h < .075) g[y][x] = 'c';","+    if (h < .05) g[y][x] = '#'; else if (h < .08) g[y][x] = 'c';","   }","-  // the road along rows 12-13, the chapel's path north at x 19-21","-  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }","-  for (let y = 1; y < 12; y++) { put(20, y, ','); }","-  // the RV's compound: adobe walls, a gap at the south gate, the RV inside","-  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }","+  for (let x = 1; x < DW - 1; x++) { put(x, 12, ','); put(x, 13, ','); }   // the road","+  for (let y = 1; y < 12; y++) put(20, y, ',');                             // the chapel path, north","+  for (let x = 26; x <= 34; x++) { put(x, 3, '2'); put(x, 10, '2'); }        // the RV's compound: adobe walls","   for (let y = 3; y <= 10; y++) { put(26, y, '2'); put(34, y, '2'); }","-  put(30, 10, ',');","+  put(30, 10, ',');                                                         // the gate","   for (let y = 4; y <= 9; y++) for (let x = 27; x <= 33; x++) put(x, y, ',');","-  put(30, 6, 'd');","-  // the chapel's arena at the north end of the path","-  put(20, 1, 'E');","-  // the start, the three batches, the patrol points (kept clear of rocks and cacti)","-  put(3, 12, 'h');","-  for (const [x, y] of [[9, 20], [15, 6], [36, 17]]) put(x, y, 'b');","-  const PAT = [[12, 12], [18, 12], [22, 18], [22, 22], [35, 20], [35, 15], [21, 7], [21, 11]];","-  for (const [x, y] of PAT) put(x, y, 'g');","-  for (const [x, y] of PAT) { for (const [dx, dy] of [[0, 0]]) if (g[y + dy][x + dx] === 'c' || g[y + dy][x + dx] === '#') put(x + dx, y + dy, '.'); }","-  return g.map(r => r.map(c => c === 'g' ? 'g' : c).join(''));","+  put(30, 6, 'd');                                                          // the drop, where the RV waits","+  put(20, 1, 'E');                                                          // the chapel's arena","+  put(3, 12, 'h');                                                          // the start","+  for (const [x, y] of BATCH_CELLS) put(x, y, 'b');","+  for (const [[x, y]] of GRUNT_PATROLS) { put(x, y, 'g'); }","+  for (const [, [x, y]] of GRUNT_PATROLS.map(p => [0, p[1]])) { /* the patrol's far end is kept clear too */ }","+  for (const p of GRUNT_PATROLS) for (const [x, y] of p) if (g[y][x] === '#' || g[y][x] === 'c') put(x, y, '.');","+  return g.map(row => row.join(''));"," }"," const DESERT_ROWS = buildDesert();","-const GRUNT_PATROLS = [","-  [[12, 12], [18, 12]], [[22, 18], [22, 22]], [[35, 20], [35, 15]], [[21, 7], [21, 11]]","-];","-const BATCH_SPAWNS = [];","-let ds = null;"," scenes.desert = {","   view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', expand: true, pausable: true,","   camera: { zoom: [.75, 2], start: 1 },","   enter(data) {","-    const round = !!(data && data.round), demo = !!(data && data.demo);","-    scenes.demo = demo; progress.scene = 'desert';","-    if (round) { progress = Object.assign(freshProgress(), { purity: [.8, .8, .8], batches: 3, scene: 'desert' }); }","+    const round = !!(data && data.round);","+    DEMO = !!(data && data.demo) || DEMO; progress.scene = 'desert';","+    if (round) progress = Object.assign(freshProgress(), { scene: 'desert', purity: [.8, .8, .8], batches: 3 });","     A.music('adventure'); L.enabled = false; game.weather = { kind: 'sand', amount: .32, wind: .5 };","     const map = new E.TileMap({","       rows: DESERT_ROWS,","       legend: {","-        '#': 1, '2': 2, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'c': { floor: 'sand', spawn: 'cactus' }, 'b': { floor: 'sand', spawn: 'batch' },","+        '#': 1, '2': 2, 'c': 3, '.': { floor: 'sand' }, ',': { floor: 'road' }, 'b': { floor: 'sand', spawn: 'batch' },","         'g': { floor: 'sand', spawn: 'grunt' }, 'h': { floor: 'sand', spawn: 'hero' }, 'd': { floor: 'road', spawn: 'drop' }, 'E': { floor: 'road', spawn: 'arena' }","       },","       types: {","         1: { h: 22, face: 'rock', roof: 'speckle', top: '#b08a64', side: '#7a5a40' },","-        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' }","+        2: { h: 26, face: 'plaster', roof: 'plain', top: '#d8b080', side: '#e8c898' },","+        3: { h: 14, face: 'hedge', roof: 'leaves', top: '#5a8a3a', side: '#3a5a2a' }","       },","       floorTex: (x, y, tag) => tag === 'road' ? E.tex.plain(x, y, { base: '#9a7a58', amount: .14 }) : E.tex.plain(x, y, { base: '#d8b880', amount: .1 }),","       outside: '#c8a878'","     });","-    game.cam.bounds = v => map.bounds(v);","+    game.cam.bounds = v => map.bounds(v); game.follow(null);","     const hs = map.find('hero'), drop = map.find('drop'), arena = map.find('arena');","-    const batches = map.findAll('batch').slice(progress.delivered || 0);","-    const cacti = map.findAll('cactus');","-    const grunts = map.findAll('grunt').map((c, i) => makeGrunt(c.x, c.y, GRUNT_PATROLS[i] || [[c.x, c.y]], i));","-    ds = { map, round, demo, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y, 'hollis'), grunts, cacti,","-      batches: batches.map(b => ({ x: b.x, y: b.y, taken: false })), carry: 0,","-      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: 'run', t: 0, delivering: 0,","-      objective: 'PICK UP THE BATCHES', hubT: 0, hubDone: false, aiTarget: null, aiWander: 0, aiDir: [0, 0] };","-    game.focus(ds.hero.body.x, ds.hero.body.y, 10);","-    if (!demo && !round && progress.delivered === 0) {","-      say(ds.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',","+    const remaining = BATCH_CELLS.slice(progress.delivered || 0).map(([cx, cy]) => map.center(cx, cy));","+    const grunts = map.findAll('grunt').map(c => {","+      const p = GRUNT_PATROLS.find(q => q[0][0] === c.cx && q[0][1] === c.cy) || [[c.cx, c.cy]];","+      return makeGrunt(c.x, c.y, p);","+    });","+    cur = { kind: 'desert', map, round, talk: new E.Dialog(game), hero: makeHero(hs.x, hs.y), grunts, carry: 0,","+      batches: remaining.map(b => ({ x: b.x, y: b.y, taken: false })),","+      drop: { x: drop.x, y: drop.y }, arena: { x: arena.x, y: arena.y }, phase: round ? 'wait' : 'run', t: 0, hubT: 0, hubDone: false,","+      objective: '', roundOver: null, aiWander: 0, aiDir: [0, 0] };","+    game.focus(cur.hero.body.x, cur.hero.body.y, 10);","+    if (!DEMO && !round && !progress.delivered) {","+      say(cur.talk, ['Forty miles of nothing, Mr. Rook. Vail\\'s men own the nothing.',","         'Three batches. The RV is in the compound at the top of the road. Walk them in and nobody sees the van.',","-        () => 'Move with the stick or WASD. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it.'],","-        { name: 'HOLLIS', portrait: ds.hero.rig });","+        () => 'Stick or WASD to move. ' + prompt('attack', 'swing') + '. ' + prompt('dash', 'dash') + '. Their sight is a cone: stay out of it, or be ready.'],","+        { name: 'HOLLIS', portrait: cur.hero.rig });","     }","-    if (round) { ds.phase = 'wait'; }","-    if (HUB && round) { HUB.progress && HUB.progress({ score: 0, label: '0/3 batches' }); }","   },","   update(dt) {","-    if (!ds) return;","-    const I = game.input;","-    if (scenes.demo && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }","-    if (ds.phase === 'wait') { roundWait(dt); return; }","-    if (ds.phase === 'over' || ds.phase === 'won') { ds.t += dt; return; }","-    if (ds.talk.update(dt)) return;","-    ds.t += dt;","-    updateHeroControls(dt, ds);","-    // a foe's sight, attacks, patrols","-    for (const f of ds.grunts) stepFoe(dt, f, ds.hero, ds.map, ds);","-    // the batches: walk over one to pick it up","-    for (const b of ds.batches) if (!b.taken && near(ds.hero.body, b, 12)) { b.taken = true; ds.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }","-    // the drop: deliver every batch carried","-    if (ds.carry > 0 && near(ds.hero.body, ds.drop, 18)) deliver();","-    // the arena: the chapel path, once the batches are gone","-    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && !scenes.demo) { ds.phase = 'won'; game.go('showdown', {}, { fade: 'iris', seconds: .6 }); }","-    if (ds.phase === 'run' && progress.delivered >= 3 && near(ds.hero.body, ds.arena, 12) && scenes.demo) { ds.phase = 'won'; game.go('showdown', { demo: true }, { fade: 'iris', seconds: .6 }); }","-    ds.objective = progress.delivered < 3 ? (ds.carry ? 'TAKE THEM TO THE RV' : 'PICK UP THE BATCHES  ' + (3 - progress.delivered - ds.carry) + ' LEFT') : 'THE CHAPEL, NORTH';","-    if (ds.round && HUB) hubTick(dt);","-    if (game.time && ds.hero.dead) return;","-    if (ds.hero.dead) return;","+    const s = cur, I = game.input;","+    if (DEMO && I.anyPressed()) { I.consumeAll(); return game.go('title', {}, { fade: 0 }); }","+    if (s.hero.dead) return heroDown(s, dt);","+    if (s.phase === 'wait') return roundWait(s, dt);","+    if (s.talk.update(dt)) return;","+    s.t += dt;","+    updateHero(dt, s, null);","+    for (const f of s.grunts) stepFoe(dt, f, s);","+    for (const b of s.batches) if (!b.taken && dist(s.hero.body, b) < 12) { b.taken = true; s.carry++; sfx('pickup'); game.note('BATCH PICKED UP'); }","+    if (s.carry > 0 && dist(s.hero.body, s.drop) < 18) deliver(s);","+    if (progress.delivered >= 3 && dist(s.hero.body, s.arena) < 12 && s.phase === 'run') {","+      s.phase = 'won';","+      game.go('showdown', { demo: DEMO }, { fade: 'iris', seconds: .6 });","+    }","+    s.objective = progress.delivered < 3 ? (s.carry ? 'TAKE THEM TO THE RV' : 'BATCHES LEFT: ' + (3 - progress.delivered - s.carry)) : 'THE CHAPEL, NORTH';","+    if (HUB && s.round) hubTick(s, dt);","   },","   draw(r) {","-    if (!ds) return;","-    ds.map.drawFloor(r);","-    for (const c of ds.cacti) r.prop('cactus', c.x, c.y, 0, { size: 1.15 });","-    for (const b of ds.batches) if (!b.taken) r.prop('crate', b.x, b.y, 0, { size: .9 });","-    drawDrop(r, ds.drop.x, ds.drop.y);","-    drawArena(r, ds.arena.x, ds.arena.y);","-    r.shadow(ds.hero.body.x, ds.hero.body.y, 5);","-    for (const f of ds.grunts) if (!f.dead || f.downT < 4) r.shadow(f.body.x, f.body.y, 5, .4);","-    ds.map.queueWalls(r);","-    drawHero(r, ds.hero);","-    for (const f of ds.grunts) drawFoe(r, f);","-    ds.talk.draw(r);","-    hud(r, ds.objective);","-    if (ds.phase === 'wait') r.overlay(g => { E.font.text(g, 'GET READY', r.W / 2, r.H / 2 - 20, '#ffe08a', { align: 'center', scale: 2, shadow: '#000', outline: false }); });","-    if (ds.hero.dead)