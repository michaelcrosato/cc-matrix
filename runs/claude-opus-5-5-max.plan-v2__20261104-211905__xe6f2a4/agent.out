 uniform(camera.near), far = uniform(camera.far);\n  let scenePass;\n  if (inkMode === 'hull' || inkMode === 'both') scenePass = toonOutlinePass(scene, camera, color(0x1a1420), float(0.006), float(1));\n  else scenePass = pass(scene, camera);\n  if (inkMode === 'none') {\n    post.outputNode = scenePass;\n  } else if (inkMode === 'hull') {\n    post.outputNode = scenePass;\n  } else {\n    scenePass.setMRT(mrt({ output, normal: normalView }));\n    const colorTex = scenePass.getTextureNode('output');\n    const normalTex = scenePass.getTextureNode('normal');\n    const depthTex = scenePass.getTextureNode('depth');\n    const ink = Fn(() => {\n      const px = inkWidth.div(screenSize);\n      const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, near, far);\n      const n = (o) => normalTex.sample(uv().add(o)).xyz;\n      const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n      const z0 = viewZ(vec2(0, 0));\n      const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.abs().max(0.5));\n      const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n      const e = max(smoothstep(0.04, 0.09, dz), smoothstep(0.55, 0.95, dn));\n      return mix(colorTex, vec4(inkColor, 1), e);\n    });\n    post.outputNode = ink();\n  }\n  S.boot = 'post';\n\n  const clock = new THREE.Clock();\n  window.addEventListener('error', (e) => S.errors.push(String(e.message)));\n  window.__render = () => { post.render(); };\n  S.t0 = performance.now();\n  await renderer.setAnimationLoop(() => {\n    mixer.update(clock.getDelta());\n    post.render();\n    S.frames++;\n    S.elapsed = performance.now() - S.t0;\n  });\n  S.boot = 'running';\n  window.__capture = async () => {\n    post.render();\n    const url = renderer.domElement.toDataURL('image/png');\n    return url;\n  };\n}\nboot().catch((e) => { S.boot = 'failed'; S.errors.push(String(e && e.stack || e)); });\nEOF\ncat > build.mjs <<'EOF'\nimpor