esc.cylinder(0.06, 0.05).setMass(0.012).setFriction(0.9).setRestitution(0).setCollisionGroups(PROP), g); glasses.push(g); }\n  const on = () => glasses.filter((g) => { const p = g.translation(), fp = b.footBody.translation(); return p.y > 0.9 && Math.hypot(p.x - fp.x, p.z - fp.z - 0.3) < 1.0; }).length;\n  const r = rng(seed * 53), P = PLAYERS[skill], U = under[skill], brain = human(U.delay, U.gain, U.noise, seed), kb = input === 'stick' ? null : keyInput(input), hands = keyHands(skill);\n  let z = 0, x = 0, t = 0, side = 1, stepNext = 0.5, rockLeft = 0, nextGust = 4 + r() * every, gustIn = Infinity, gustLeft = 0, gustDir = 1, speed = 0, target = 0, lastStep = 0; const cadence = 0.42, stride = 0.55, dt = 1 / 120, brace = gust * 0.2, tele = 1;\n  while (z < length && t < 200) {\n    t += dt;\n    if (t > stepNext) { stepNext = t + cadence + (r() - 0.5) * P.lag * 0.2; side = -side; rockLeft = 0.18; target = stride / cadence; lastStep = t; x += b.leanX * 0.25 * stride; }\n    if (t - lastStep > cadence * 1.6) target = 0;\n    speed += (target - speed) * (1 - Math.exp(-dt / 0.5)); z += speed * dt; b.footBody.setNextKinematicTranslation(V(x, 0, z)); b.sway = 0.05;\n    if (t >= nextGust) { nextGust = t + every * (0.8 + r() * 0.4); gustIn = tele; gustDir = r() < 0.5 ? -1 : 1; }\n    if (gustIn < Infinity) { gustIn -= dt; if (gustIn <= 0) { gustIn = Infinity; gustLeft = 0.5; } }\n    if (gustLeft > 0) gustLeft -= dt;\n    b.extX = (gustLeft > 0 ? gust * gustDir : 0) + (rockLeft > 0 ? 0.2 * side : 0); rockLeft -= dt;\n    const dot = b.cob, goalX = Math.max(-0.5, Math.min(0.5, -x * 0.8)), reacted = gustIn < tele - P.lag;\n    const want = clampDisc((reacted && gustIn < Infinity) || gustLeft > 0 ? { x: -gustDir * brace, y: 0 } : brain(dot, { x: goalX, y: 0 }, dt));\n    if (kb) { const [px, pz] = hands(want, kb.wish, dt); const a = kb.step(px, pz, dt); b.wishX = a.x; b.wishZ = a.y; } else { b.wishX = want.x; b.wishZ = want.y; }\n    stepBal(b, dt); world.step();\n  }\n  cons