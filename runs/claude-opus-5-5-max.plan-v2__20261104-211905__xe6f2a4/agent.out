or (const f of [...l.fruit]) if (f.body.translation().y < 0.3) this.removeFruit(l, f);\n      l.pending = l.pending.filter((p) => this.t <= p.until);\n    }\n    if (this.t >= this.seconds && !this.done) { this.done = true; for (const l of this.lanes) if (l.kind !== 'ghost') { const h = this.held(l).length; l.raw += h * 0.5; } }\n  }\n  frame(dt) {\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') { if (l.ghostTo) { const k = 1 - Math.exp(-dt * 7), g = l.ghostTo; l.gx = (l.gx ?? l.x) + (g.x - (l.gx ?? l.x)) * k; l.glx = (l.glx ?? 0) + (g.lx - (l.glx ?? 0)) * k; l.glz = (l.glz ?? 0) + (g.lz - (l.glz ?? 0)) * k; const a = Math.hypot(l.glx, l.glz) || 1e-9, s = Math.sin(a / 2); l.doll.root.quaternion.set((l.glz / a) * s, 0, (-l.glx / a) * s, Math.cos(a / 2)); } l.doll.mixer.update(dt); continue; }\n      if (l.fallen > 0) continue;\n      l.doll.mixer.update(dt); const r = l.body.rotation(); l.doll.root.quaternion.set(r.x, r.y, r.z, r.w); l.hat.visible = true;\n      for (const f of l.fruit) { const t = f.body.translation(); f.mesh.position.set(t.x, t.y, t.z); }\n    }\n  }\n  form(l) { return Math.max(0, Math.min(100, (100 * l.raw) / this.par)); }\n  dispose() { for (const l of this.lanes) { if (l.doll.ragdoll) endRagdoll(this.world, l.doll); } scene.remove(this.group); this.world.free(); this.world = null; }\n}\n\n// ---- screens\nconst medal = (f) => (f >= 97 ? 'Suspicious' : f >= 85 ? 'Exemplary' : f >= 65 ? 'Pleasant' : f >= 40 ? 'Adequate' : 'Attended');\nlet menu = null;\nfunction div(cls, text, parent = ui) { const d = document.createElement('div'); d.className = cls; if (text !== undefined) d.textContent = text; parent.append(d); return d; }\nfunction makeMenu(items) {\n  const box = div('menu'); menu = { items, i: 0, els: [] };\n  items.forEach((it, idx) => { const el = div('item', undefined, box); const lab = document.createElement('span'); lab.textContent = it.label(); el.append(lab); if (it.slider) { const bar = document.createElement('span'); bar.className = 'bar'; const fill = document.createElement('i'); bar.append(fill); el.append(bar); it.fill = fill; it.lab = lab; fill.style.width = it.pct() + '%'; el.addEventListener('click', (e) => { const r = bar.getBoundingClientRect(); if (e.clientX >= r.left) { it.setPct(((e.clientX - r.left) / r.width) * 100); drawMenu(); } }); } else { el.addEventListener('click', () => { if (input.touchTap || !G.touchOnly) activate(idx); }); } el.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') { menu.i = idx; drawMenu(); } }); menu.els.push(el); });\n  drawMenu();\n}\nfunction drawMenu() { if (!menu) return; menu.els.forEach((el, i) => { el.classList.toggle('focus', i === menu.i); el.dataset.focused = i === menu.i ? '1' : '0'; const it = menu.items[i]; if (it.slider) { it.lab.textContent = it.label(); it.fill.style.width = it.pct() + '%'; } else el.firstChild.textContent = it.label(); }); }\nfunction activate(i) { const it = menu.items[i]; if (it && it.act) { sfx('ui'); it.act(); } }\nfunction menuInput() {\n  if (!menu) return; const e = input.edge;\n  if (e('up')) { menu.i = (menu.i + menu.items.length - 1) % menu.items.length; drawMenu(); } if (e('down')) { menu.i = (menu.i + 1) % menu.items.length; drawMenu(); }\n  const it = menu.items[menu.i]; if (it && it.slider) { if (e('left')) { it.nudge(-1); drawMenu(); } if (e('right')) { it.nudge(1); drawMenu(); } }\n  if (e('confirm')) activate(menu.i); if (e('back') && G.onBack) G.onBack();\n}\nfunction clearUI() { ui.textContent = ''; menu = null; G.onBack = null; promptList = []; }\nconst sliderItem = (label, get, set, min, max, stp) => ({ slider: true, label: () => `${label} ${(+get().toFixed(3))}`, pct: () => ((get() - min) / (max - min)) * 100, setPct: (p) => set(Math.max(min, Math.min(max, min + (p / 100) * (max - min)))), nudge: (d) => set(Math.max(min, Math.min(max, +(get() + d * stp).toFixed(5)))) });\nconst screens = {\n  title() { clearUI(); const t = div('title', TITLE); t.dataset.title = '1'; if (G.touchOnly) { div('msg', 'Controller or keyboard required'); const box = div('menu'); box.style.top = '62vh'; const el = div('item focus', 'Settings', box); el.dataset.settings = '1'; el.addEventListener('click', () => show('settings')); } else { const pr = div('press'); pr.append('Press '); promptHTML(pr, 'confirm'); pr.dataset.prompts2 = '1'; promptList = [['confirm', '']]; pr.dataset.prompts = '1'; } },\n  menu() { clearUI(); div('title', TITLE); makeMenu([{ label: () => 'Play Fruit Hat', act: () => startEvent([{ kind: 'local' }]) }, { label: () => 'Group Class', act: () => show('group') }, { label: () => 'Journal', act: () => show('journal') }, { label: () => 'Settings', act: () => show('settings') }, { label: () => 'About/Credits', act: () => show('about') }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('title'); },\n  journal() { clearUI(); const p = div('page'); const h = document.createElement('h2'); h.textContent = 'Journal'; p.append(h); const r = document.createElement('p'); r.textContent = `Classes: ${save.runs}. Best: ${save.best.toFixed(0)}.`; p.append(r); ui.append(promptsBar([['back', 'Back']])); G.onBack = () => show('menu'); },\n  group() { clearUI(); div('title', 'Group Class'); G.joined = []; const m = div('msg', 'Press to join'); m.dataset.join = '1'; G.groupTick = () => { input.players.forEach((p, i) => { if (p.confirm && !G.joined.includes(i)) G.joined.push(i); }); if (input.edge('confirm') && input.last === 'kbm' && !G.joined.includes('kbm')) G.joined.push('kbm'); m.textContent = `Joined: ${G.joined.length}`; if (G.joined.length && input.edge('pause')) startEvent(G.joined.map((j) => ({ kind: 'local', player: j }))); }; ui.append(promptsBar([['confirm', 'Join'], ['pause', 'Start'], ['back', 'Back']])); G.onBack = () => { G.groupTick = null; show('menu'); }; },\n  settings() { const back = G.settingsBack || (G.touchOnly ? 'title' : 'menu'); clearUI(); makeMenu([sliderItem('Music', () => settings.music, (v) => { settings.music = v; applyVolumes(); saveSettings(); }, 0, 100, 5), sliderItem('Sound', () => settings.sfx, (v) => { settings.sfx = v; applyVolumes(); saveSettings(); }, 0, 100, 5), sliderItem('Voice', () => settings.voice, (v) => { settings.voice = v; applyVolumes(); saveSettings(); }, 0, 100, 5), { label: () => `Glyphs: ${settings.glyphs === 'ps' ? 'PlayStation' : 'Xbox'}`, act: () => { settings.glyphs = settings.glyphs === 'ps' ? 'xb' : 'ps'; saveSettings(); drawMenu(); refreshPrompts(); } }, { label: () => 'Back', act: () => show(back) }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show(back); },\n  about() { clearUI(); const pages = aboutPages(); let i = 0; const p = div('page'); const draw = () => { p.textContent = ''; const h = document.createElement('h2'); h.textContent = pages[i].title; p.append(h); for (const line of pages[i].lines) { const r = document.createElement('p'); r.textContent = line; p.append(r); } }; draw(); G.aboutPage = () => i; G.aboutNext = () => { i = (i + 1) % pages.length; draw(); }; G.aboutAll = () => pages.map((x) => x.lines.join(' ')).join(' '); makeMenu([{ label: () => 'Next page', act: () => G.aboutNext() }, { label: () => 'Back', act: () => show('menu') }]); const b = ui.querySelector('.menu'); b.style.top = 'auto'; b.style.bottom = '12vh'; b.style.flexDirection = 'row'; ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('menu'); },\n  pause() { clearUI(); div('title', 'Paused'); makeMenu([{ label: () => 'Resume', act: () => show('event') }, { label: () => 'Restart', act: () => startEvent(G.lastSpec) }, { label: () => 'Settings', act: () => { G.settingsBack = 'pause'; show('settings'); G.settingsBack = null; } }, { label: () => 'Dev Mode', act: () => show('dev') }, { label: () => 'Leave Class', act: () => { endEvent(); show('menu'); } }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Resume']])); G.onBack = () => show('event'); },\n  dev() { clearUI(); makeMenu([...TUNING.slice(0, 3).map((t) => sliderItem(t.label, () => T[t.key], (v) => { T[t.key] = v; G.event && G.event.retune(); }, t.min, t.max, t.step)), { label: () => `God mode: ${G.god ? 'on' : 'off'}`, act: () => { G.god = !G.god; if (G.event) { G.event.god = G.god; G.event.retune(); } drawMenu(); } }, { label: () => 'Reset to Defaults', act: () => { resetTuning(); G.event && G.event.retune(); drawMenu(); } }, { label: () => 'Back', act: () => show('pause') }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('pause'); },\n  event() { clearUI(); div('score', '0').dataset.score = '1'; div('time', '60').dataset.time = '1'; ui.append(makeDisc()); ui.append(promptsBar([['weight', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail'], ['pause', 'Pause']])); },\n  results() { clearUI(); const f = G.lastForm; const t = div('tag'); const h = document.createElement('h2'); h.textContent = 'Fruit Hat'; t.append(h); const s = document.createElement('div'); s.className = 'stamp'; s.textContent = medal(f); s.dataset.medal = medal(f); t.append(s); const n = document.createElement('div'); n.textContent = `Form ${f.toFixed(0)}. Floor Exercises: ${G.lastFalls}.`; t.append(n); makeMenu([{ label: () => 'Continue', act: () => show('menu') }]); ui.querySelector('.menu').style.top = '60vh'; ui.append(promptsBar([['confirm', 'Continue']])); G.onBack = () => show('menu'); },\n  attract() { clearUI(); div('demo', 'DEMO · Press any button'); },\n};\nfunction aboutPages() { const s = ABOUT.sourceInformation, L = (k, v) => `${k}: ${v}`; return [{ title: 'Source Information', lines: [L('Date', s.date), L('Source', s.source), L('Plan', s.plan), L('Genre', s.genre), L('Perspective', s.perspective)] }, { title: 'Source Information', lines: [L('Tech', s.tech), L('Art Direction', s.artDirection), L('Animation', s.animation), L('Audio', s.audio), L('Online', s.online)] }, { title: 'Source Information', lines: [L('Testing', s.testing), L('Research', s.research), L('Environment', s.environment), L('Model', s.model), L('Usage', s.usage)] }, { title: 'Testing Feedback', lines: ABOUT.testingFeedback }, { title: 'Engine Feedback', lines: ABOUT.engineFeedback }, { title: 'Prompt Feedback', lines: ABOUT.promptFeedback }, { title: 'Credits', lines: ['Three.js, Rapier', 'Fredoka, SIL Open Font License'] }]; }\nfunction show(name) { G.screen = name; G.idle = 0; screens[name](); }\n// the Balance Disc, as inline SVG moved by transforms\nlet disc = null;\nfunction makeDisc() { const ns = 'http://www.w3.org/2000/svg', svg = document.createElementNS(ns, 'svg'); svg.setAttribute('viewBox', '-110 -110 220 220'); svg.setAttribute('class', 'disc'); svg.dataset.disc = '1'; const circle = (r, fill, stroke, w) => { const c = document.createElementNS(ns, 'circle'); c.setAttribute('r', r); c.setAttribute('fill', fill); c.setAttribute('stroke', stroke); c.setAttribute('stroke-width', w); svg.append(c); return c; }; circle(100, '#fdf3e0', '#1a1420', 8); circle(50, 'none', '#1a142055', 3); const ask = circle(14, 'none', '#1a1420aa', 4), dot = circle(16, '#e8443a', '#1a1420', 5); disc = { svg, ask, dot }; return svg; }\nfunction updateDisc(l) { if (!disc || !l.s) return; const c = { x: l.s.leanX / l.s.maxLean, y: l.s.leanZ / l.s.maxLean }; disc.dot.setAttribute('transform', `translate(${c.x * 100} ${c.y * 100})`); disc.ask.setAttribute('transform', `translate(${l.s.wishX * 100} ${l.s.wishZ * 100})`); }\n\n// ---- flow\nfunction endEvent() { if (G.event) { G.event.dispose(); G.event = null; } }\nfunction startEvent(spec, opts = {}) { endEvent(); G.lastSpec = spec; G.event = new FruitHat({ lanes: spec, god: G.god, ...opts }); G.event.retune(); show('event'); }\nfunction finishEvent() { const e = G.event, l = e.lanes.find((x) => x.kind !== 'ghost' && x.kind !== 'bot') || e.lanes[0]; G.lastForm = e.form(l); G.lastFalls = l.falls; G.lastRaw = l.raw; G.lastBanks = l.banks; save.runs++; save.best = Math.max(save.best, l.raw); writeSave(); endEvent(); show('results'); }\nconst ATTRACT = [{ lanes: [{ kind: 'bot', bankAt: 12 }] }, { lanes: [{ kind: 'bot', bankAt: 5 }, { kind: 'bot', bankAt: 7 }, { kind: 'bot', bankAt: 9 }, { kind: 'bot', bankAt: 4 }] }];\nfunction startAttract() { G.attract = true; G.attractI = 0; G.attractT = 0; G.attractSeen = 0; show('attract'); attractNext(); }\nfunction attractNext() { endEvent(); const v = ATTRACT[G.attractI % ATTRACT.length]; G.attractI++; G.attractSeen++; G.event = new FruitHat({ lanes: v.lanes, god: true, seconds: 600 }); G.event.retune(); G.attractT = 0; }\nfunction stopAttract() { G.attract = false; endEvent(); input.anyEvent = false; input.mouseMovedPx = 0; input.ignore = true; show('title'); }\nfunction fixed(dt) {\n  G.simT += dt; if (window.__botHook) window.__botHook(); pollInput(dt);\n  const s = G.session; if (s) { sessionFixed(s, dt); input.anyEvent = false; input.mouseMovedPx = 0; return; }\n  if (G.attract) { if (anyExitInput()) { stopAttract(); return; } G.attractT += dt; if (G.attractT > 18) { if (G.attractI % ATTRACT.length === 0) { endEvent(); G.attract = 'pause'; G.attractT = 0; show('title'); } else attractNext(); } if (G.event) G.event.fixed(dt); input.anyEvent = false; input.mouseMovedPx = 0; return; }\n  if (input.ignore) { if (!Object.keys(input.cur).some((k) => input.cur[k] === true) ) input.ignore = false; input.anyEvent = false; input.mouseMovedPx = 0; if (input.ignore) return; }\n  if (G.screen === 'title' || G.screen === 'menu') { if (anyExitInput()) G.idle = 0; else G.idle += dt; if (G.idle >= 10) { input.anyEvent = false; startAttract(); return; } }\n  input.anyEvent = false; input.mouseMovedPx = 0; input.touchTap = false;\n  switch (G.screen) {\n    case 'title': if (!G.touchOnly && (input.edge('confirm') || input.edge('clickL'))) show('menu'); break;\n    case 'event': { const e = G.event; if (!e) break; e.fixed(dt); if (input.edge('pause')) { show('pause'); break; } if (e.t >= e.seconds + 1.5) finishEvent(); break; }\n    case 'group': if (G.groupTick) G.groupTick(); menuInput(); if (input.edge('back') && G.onBack) G.onBack(); break;\n    case 'journal': case 'about': case 'settings': case 'menu': case 'pause': case 'dev': case 'results': menuInput(); if (!menu && input.edge('back') && G.onBack) G.onBack(); break;\n    default: break;\n  }\n}\nfunction frameLogic(dt) {\n  if (G.event) {\n    G.event.frame(dt); const e = G.event, l = e.lanes.find((x) => x.kind === 'local') || e.lanes[0]; if (G.screen === 'event') { updateDisc(l); const sc = ui.querySelector('[data-score]'), tm = ui.querySelector('[data-time]'); if (sc) sc.textContent = Math.round(l.raw); if (tm) tm.textContent = Math.max(0, Math.ceil(e.seconds - e.t)); }\n    const n = e.lanes.length; camera.position.set(0, 2.6, Math.max(8.5, ((n - 1) * 1.6 + 2.5) / Math.tan((38 * Math.PI) / 360) / (camera.aspect || 1.7))); camera.lookAt(0, 1.25, 0);\n  }\n  pumpMusic();\n}\nfunction frame() { const now = performance.now(), real = Math.min((now - (G.last || now)) / 1000, 0.1); G.last = now; G.acc = (G.acc || 0) + real; let n = 0; while (G.acc >= 1 / 120 && n < 12) { fixed(1 / 120); G.acc -= 1 / 120; n++; } if (n === 12) G.acc = 0; frameLogic(real); if (ink) { ink.post.render(); } G.frames++; }\n\n// ---- AI Hub session, per the plan\nconst SLOT = { intro: 6, play: 50, score: 6 }, SLOTLEN = 62, SLOTS = 3;\nfunction runSession(info) {\n  const s = (G.session = { info, slot: -1, total: 0, current: 0, reported: false, ended: false, lastSend: 0, lastProgress: -1, ghosts: new Map(), cardAsked: false, stats: { falls: 0 } });\n  for (const p of info.players) if (p.id !== info.me) s.ghosts.set(p.id, { ...p, area: -1, to: null });\n  clearUI(); G.screen = 'card';\n  const card = div('tag'); card.dataset.card = '1'; const h = document.createElement('h2'); h.textContent = TITLE; card.append(h); const goal = document.createElement('div'); goal.textContent = 'Stay balanced through the class: highest score wins'; card.append(goal); const ctr = document.createElement('div'); ctr.textContent = 'Lean: stick, WASD or mouse. Bank: Cross, Space.'; card.append(ctr); const left = document.createElement('div'); left.dataset.left = '1'; card.append(left); const names = div('names'); s.nameEls = {};\n  for (const p of info.players) { const el = document.createElement('span'); el.style.color = p.color; el.textContent = p.name; names.append(el); s.nameEls[p.id] = el; }\n  ui.append(promptsBar([['confirm', 'Ready'], ['more', 'More time']]));\n  card.addEventListener('click', () => AIHub.answer('ready'));\n  AIHub.on('card', (c) => { left.textContent = c.starting ? 'Starting...' : c.paused ? 'Paused' : c.left != null ? `Starting in ${Math.ceil(c.left / 1000)}` : ''; for (const p of info.players) if (s.nameEls[p.id]) s.nameEls[p.id].textContent = p.name + ((c.ready || []).includes(p.id) ? ' ✓' : ''); });\n  AIHub.on('start', () => { clearUI(); G.screen = 'session'; ui.append(makeDisc()); div('score', '0').dataset.score = '1'; const c = div('time', ''); c.dataset.time = '1'; ui.append(promptsBar([['weight', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail']])); });\n  AIHub.on('message', (data, from) => { const g = s.ghosts.get(from); if (!g || !data || data.t !== 'g') return; g.area = data.a; g.to = data; const e = G.event; if (e) { const l = e.lanes.find((x) => x.kind === 'ghost' && x.pid === from); if (l && data.a === s.slot) { l.ghostTo = { x: l.x, lx: data.lx, lz: data.lz }; l.doll.root.visible = true; } else if (l) l.doll.root.visible = false; } });\n  AIHub.on('leave', ({ id }) => { s.ghosts.delete(id); const e = G.event; if (e) { const l = e.lanes.find((x) => x.kind === 'ghost' && x.pid === id); if (l) l.doll.root.visible = false; } });\n  AIHub.on('time-up', () => sessionResult(s));\n  AIHub.on('end', () => { s.ended = true; if (audio.ctx) audio.ctx.suspend().catch(() => {}); });\n  addEventListener('keydown', (e) => { if (AIHub.time() === -Infinity) { if (e.key === 'Enter') AIHub.answer('ready'); if (e.key === 'm' || e.key === 'M') AIHub.answer('more'); } });\n  G.event = new FruitHat({ lanes: sessionLanes(s), seconds: SLOT.play, par: 28 }); G.event.running = false; G.event.retune();\n  AIHub.ready();\n}\nfunction sessionLanes(s) { const lanes = [{ kind: 'local', colour: parseInt((s.info.players.find((p) => p.id === s.info.me) || { color: '#e8443a' }).color.slice(1), 16) }]; for (const [id, g] of s.ghosts) lanes.push({ kind: 'ghost', pid: id, colour: parseInt(g.color.slice(1), 16) }); return lanes; }\nfunction sessionResult(s) { if (s.reported) return; s.reported = true; const score = Math.round(s.total + s.current); AIHub.result({ score, stats: { 'Floor Exercises': s.stats.falls }, awards: score > 0 ? [{ title: 'Suspiciously Still', detail: 'Barely moved' }] : [] }); }\nfunction sessionFixed(s, dt) {\n  if (s.ended) return; const T0 = AIHub.time();\n  if (T0 === -Infinity) { if (input.players[0] && input.edge('confirm')) AIHub.answer('ready'); if (input.players[0] && input.edge('tri')) AIHub.answer('more'); return; }\n  const tm = ui.querySelector('[data-time]'); if (T0 < 0) { if (tm) tm.textContent = Math.ceil(-T0 / 1000); return; }\n  const slot = Math.min(SLOTS - 1, Math.floor(T0 / 1000 / SLOTLEN)), inSlot = T0 / 1000 - slot * SLOTLEN;\n  if (slot !== s.slot) { if (s.slot >= 0 && G.event) { const l = G.event.lanes[0]; s.total += Math.round(G.event.form(l) * 10); s.stats.falls += l.falls; s.current = 0; G.event.dispose(); G.event = new FruitHat({ lanes: sessionLanes(s), seconds: SLOT.play, par: 28 }); G.event.retune(); } s.slot = slot; }\n  const e = G.event; e.running = inSlot >= SLOT.intro && inSlot < SLOT.intro + SLOT.play + 0.5; if (e.running) e.fixed(dt); const me = e.lanes[0]; s.current = Math.round(e.form(me) * 10);\n  if (tm) tm.textContent = inSlot < SLOT.intro ? 'Next class' : Math.max(0, Math.ceil(SLOT.intro + SLOT.play - inSlot));\n  const sc = ui.querySelector('[data-score]'); if (sc) sc.textContent = s.total + s.current;\n  if (T0 - s.lastSend > 100) { s.lastSend = T0; AIHub.send({ t: 'g', a: s.slot, x: +me.x.toFixed(2), z: 0, lx: +(me.s.leanX || 0).toFixed(3), lz: +(me.s.leanZ || 0).toFixed(3), c: 0, f: me.fallen > 0 ? 1 : 0, s: s.total + s.current }, { reliable: false }); }\n  if (T0 - s.lastProgress > 1000) { s.lastProgress = T0; AIHub.progress({ score: s.total + s.current, label: `Fruit Hat ${s.total + s.current}` }); }\n  if (!s.reported && T0 / 1000 >= SLOTS * SLOTLEN) sessionResult(s);\n}\n\n// ---- test hooks\nfunction installHooks() {\n  window.__GAME__ = TITLE;\n  window.__TEST__ = {\n    state() { const e = G.event; return { screen: G.screen, attract: !!G.attract, attractSeen: G.attractSeen || 0, idle: G.idle, simT: G.simT, save: { ...save }, event: e ? { t: e.t, seconds: e.seconds, baseline: e.baseline, bodies: e.world.bodies.len(), lanes: e.lanes.map((l) => ({ kind: l.kind, id: l.id, leanX: l.s ? l.s.leanX : 0, leanZ: l.s ? l.s.leanZ : 0, wishX: l.s ? l.s.wishX : 0, wishZ: l.s ? l.s.wishZ : 0, falls: l.falls, raw: l.raw, banks: l.banks, fallen: l.fallen, peak: l.peak, fruit: l.fruit.length, hx: l.body ? l.body.translation().x : 0, ankle: l.s ? l.s.ankleMax : 0, K: l.s ? l.s.K : 0, clip: l.doll.cur, mixerT: l.doll.mixer.time, ragdoll: !!l.doll.ragdoll, hipsParent: l.doll.J.hips.parent && l.doll.J.hips.parent.name, hipsY: l.doll.J.hips.position.y })) } : null, input: { lastDevice: input.last, glyphSet: glyphSet(), ring: { ...input.ring } }, audio: { state: audio.ctx ? audio.ctx.state : 'none', music: settings.music, musicGain: audio.ctx ? audio.music.gain.value : null }, render: { backend: G.backend, frames: G.frames, revision: THREE.REVISION, rapier: RAPIER.version() }, tuning: { ...T }, god: G.god, last: { form: G.lastForm, falls: G.lastFalls, raw: G.lastRaw, banks: G.lastBanks }, menu: menu ? { i: menu.i, n: menu.items.length, label: menu.items[menu.i].label() } : null, errors: G.errors, touchOnly: G.touchOnly }; },\n    advance(sec) { const n = Math.round(sec * 120); for (let i = 0; i < n; i++) { fixed(1 / 120); if (i % 2) frameLogic(1 / 60); } return this.state(); },\n    glyphs() { return [...document.querySelectorAll('[data-glyph]')].map((g) => g.dataset.glyph); },\n    bot(skill, bankAt) { if (!skill) { window.__botHook = null; return; } const lag = { sharp: 0.1, average: 0.2, clumsy: 0.35 }[skill]; let wasHop = false, cool = 0; window.__botHook = () => { const e = G.event; if (!e || G.screen !== 'event' || !window.__pads || !window.__pads[0]) return; const l = e.lanes[0]; l.botLag = lag; const w = e.want(l), pad = window.__pads[0]; pad.axes[0] = w.x; pad.axes[1] = w.y; const h = e.held(l).length >= (bankAt ?? 7); cool -= 1 / 120; const press = h && !wasHop && cool <= 0; pad.buttons[0] = { pressed: press, value: press ? 1 : 0 }; if (press) cool = 0.3; wasHop = press; const fl = Math.hypot(l.s.leanX, l.s.leanZ) > (32 * Math.PI) / 180; pad.buttons[2] = { pressed: fl, value: fl ? 1 : 0 }; }; },\n    forceFall(i = 0) { const l = G.event.lanes[i]; l.s.extX = 9; }, clearForce(i = 0) { G.event.lanes[i].s.extX = 0; },\n    musicLevel() { if (!audio.an) return -1; const d = new Float32Array(audio.an.fftSize); audio.an.getFloatTimeDomainData(d); let s = 0; for (const v of d) s += v * v; return Math.sqrt(s / d.length); },\n    aboutText() { return G.aboutAll ? G.aboutAll() : ''; }, aboutNext() { G.aboutNext && G.aboutNext(); }, seed(n) { runSeed = n; }, show,\n  };\n}\nfunction showBootFailure(err) { G.screen = 'failed'; G.errors.push(String(err && err.stack || err)); clearUI(); div('msg', 'This game needs WebGPU or WebGL2.'); if (window.AIHub && AIHub.active) AIHub.fail(String(err).slice(0, 200)); }\nasync function bootEngine() {\n  if (RENDER) { renderer = new THREE.WebGPURenderer({ antialias: true }); renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2)); renderer.setSize(innerWidth, innerHeight); renderer.toneMapping = THREE.NoToneMapping; renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFShadowMap; document.body.prepend(renderer.domElement); await renderer.init(); G.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : renderer.backend.isWebGLBackend ? 'webgl2' : 'other'; }\n  await RAPIER.init();\n  buildBackdrop();\n  if (RENDER) { ink = makeInk(renderer, scene, camera); addEventListener('resize', () => { camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); }); }\n  if (TEST || RENDER === false) installHooks(); else window.__GAME__ = TITLE;\n  G.loop = () => frame();\n}\nfunction startLoop() { if (TEST && q.get('manual') === '1') return; if (renderer) renderer.setAnimationLoop(G.loop); else { const r = () => { G.loop(); requestAnimationFrame(r); }; requestAnimationFrame(r); } }\nfunction runStandalone() { G.touchOnly = matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; show('title'); startLoop(); }\nasync function main() {\n  if (AIHub.active) {\n    const pConnect = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    await bootEngine();\n    const info = await pConnect;\n    if (info) { runSession(info); startLoop(); } else runStandalone();\n  } else { await bootEngine(); runStandalone(); }\n}\nmain().catch(showBootFailure);\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01DFLtmcJP9iPqkLCdVRPCrj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjFLvhV5YugzecteCSQZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JH28yfm5wQcvmVpjqH5mCn","name":"Bash","input":{"command":"cat > tools/test.mjs <<'EOF'\n// The plan's one command: prints only failures and a one-line count.\nimport { chromium, webkit, devices } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFile, readFileSync } from 'node:fs';\nimport { readFile as rf } from 'node:fs/promises';\nimport { join, extname, resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nconst groups = process.argv.slice(2); const want = (g) => !groups.length || groups.includes('full') || groups.includes(g);\nlet pass = 0; const fails = [];\nconst ok = (cond, name, detail = '') => { if (cond) pass++; else fails.push(`${name}${detail ? ' :: ' + detail : ''}`); };\nconst WEBGPU = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader'];\nconst SHOTS = [...WEBGPU, '--use-vulkan=swiftshader', '--use-angle=swiftshader'];\nconst GAME = pathToFileURL(resolve('out/game.html')).href;\nconst PADSTUB = (n = 1) => `window.__pads = Array.from({length:${n}}, (_, i) => ({ index: i, id: 'stub', connected: true, mapping: 'standard', axes: [0,0,0,0], buttons: Array.from({length:18}, () => ({pressed:false, value:0})), vibrationActuator: { playEffect() {} } })); navigator.getGamepads = () => window.__pads;`;\nconst logic = async (b, { pads = 1, q = '' } = {}) => { const c = await b.newContext({ viewport: { width: 1920, height: 1080 } }); const p = await c.newPage(); p.__errs = []; p.on('pageerror', (e) => p.__errs.push(String(e))); p.on('console', (m) => { if (m.type() === 'error' && !/Device Lost/.test(m.text())) p.__errs.push(m.text()); }); await p.addInitScript(PADSTUB(pads)); await p.goto(`${GAME}?test=1&render=0&manual=1${q}`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title', null, { timeout: 30000 }); return p; };\nconst adv = (p, s) => p.evaluate((x) => window.__TEST__.advance(x), s);\nconst st = (p) => p.evaluate(() => window.__TEST__.state());\nconst pad = (p, fn, arg) => p.evaluate(fn, arg);\nconst press = async (p, b, i = 0) => { await pad(p, ([b, i]) => { window.__pads[i].buttons[b] = { pressed: true, value: 1 }; }, [b, i]); await adv(p, 0.05); await pad(p, ([b, i]) => { window.__pads[i].buttons[b] = { pressed: false, value: 0 }; }, [b, i]); await adv(p, 0.05); };\nconst key = async (p, k) => { await p.keyboard.down(k); await adv(p, 0.05); await p.keyboard.up(k); await adv(p, 0.05); };\n\nif (want('unit')) {\n  const html = readFileSync('out/game.html', 'utf8');\n  ok(html.startsWith('<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>/*! aihub-session'), 'client directly after meta charset');\n  for (const n of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-goal', 'hub:session-howto']) ok(new RegExp(`<meta\\\\s+name=[\"']${n}[\"']\\\\s+content=[\"']([^\"']+)[\"']`).test(html), 'meta ' + n);\n  ok(html.match(/hub:session-goal\" content=\"([^\"]+)/)[1].length <= 60, 'goal under 60'); ok(html.match(/hub:session-howto\" content=\"([^\"]+)/)[1].length <= 80, 'howto under 80');\n  ok(!/https?:\\/\\/(?!www\\.w3\\.org)[a-z]+\\.[a-z]+\\/[^\"' ]+\\.(mp3|ogg|wav|m4a)/i.test(html), 'no audio urls');\n  const scripts = html.split('<script>').length - 1; ok(scripts === 2, 'two inline scripts', String(scripts));\n  const src = readFileSync('src/main.js', 'utf8');\n  ok(!/\\b(alert|confirm|prompt)\\(/.test(src.replace(/AIHub\\.|promptHTML|promptsBar/g, '')), 'no dialogs'); ok(!/WebSocket|RTCPeerConnection|window\\.open|location\\.href\\s*=/.test(src), 'no network or navigation');\n  ok(!/Math\\.random/.test(src), 'no Math.random'); ok(!/TODO|FIXME/.test(src), 'no TODO');\n}\nif (want('flow') || want('input') || want('events') || want('audio') || want('ui')) {\n  const b = await chromium.launch({ headless: true, args: ['--autoplay-policy=no-user-gesture-required'] });\n  if (want('flow')) {\n    const p = await logic(b);\n    let s = await st(p); ok(s.render.revision === '180', 'three R180', s.render.revision); ok(s.render.rapier === '0.19.3', 'rapier 0.19.3', s.render.rapier);\n    // attract at 10 s, any input exits, the press is swallowed\n    s = await adv(p, 9.5); ok(!s.attract, 'no attract before 10 s', String(s.idle)); s = await adv(p, 0.7); ok(s.attract && s.event, 'attract at 10 s');\n    s = await adv(p, 40); ok(s.attractSeen >= 2, 'attract visits vignettes', String(s.attractSeen));\n    await p.keyboard.down('Enter'); s = await adv(p, 0.05); ok(!s.attract && s.screen === 'title', 'a key exits attract to the title', s.screen); await p.keyboard.up('Enter'); s = await adv(p, 0.2); ok(s.screen === 'title', 'and that press is not acted on', s.screen);\n    s = await adv(p, 10.5); ok(s.attract, 'attract again'); await pad(p, () => { window.__pads[0].buttons[0] = { pressed: true, value: 1 }; }); s = await adv(p, 0.05); ok(!s.attract, 'a button exits attract'); await pad(p, () => { window.__pads[0].buttons[0] = { pressed: false, value: 0 }; }); s = await adv(p, 0.1); ok(s.screen === 'title', 'button swallowed', s.screen);\n    s = await adv(p, 10.5); ok(s.attract, 'attract third time'); await p.mouse.move(300, 300); await p.mouse.move(600, 500); s = await adv(p, 0.05); ok(!s.attract, 'mouse movement exits attract');\n    s = await adv(p, 10.5); await pad(p, () => { window.__pads[0].axes[0] = 0.9; }); s = await adv(p, 0.05); ok(!s.attract, 'a stick exits attract'); await pad(p, () => { window.__pads[0].axes[0] = 0; }); await adv(p, 0.1);\n    // a whole class through menus on the pad, with the bot on the real input path\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'title to menu', s.screen);\n    await press(p, 0); s = await st(p); ok(s.screen === 'event', 'menu to event', s.screen);\n    await p.evaluate(() => window.__TEST__.bot('sharp', 7));\n    s = await adv(p, 30); ok(s.event.lanes[0].banks > 0, 'bot banks through the pad path', JSON.stringify(s.event.lanes[0]));\n    await press(p, 9); s = await st(p); ok(s.screen === 'pause', 'Options pauses', s.screen); const t0 = s.simT;\n    await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(s.menu.label === 'Dev Mode', 'menu nav to Dev Mode', JSON.stringify(s.menu)); await press(p, 0); s = await st(p); ok(s.screen === 'dev', 'Dev Mode from Pause', s.screen);\n    const a0 = s.tuning.ankleMax; await press(p, 15); await press(p, 15); s = await st(p); ok(Math.abs(s.tuning.ankleMax - a0 - 0.2) < 1e-6, 'slider moves tuning live', String(s.tuning.ankleMax)); ok(Math.abs(s.event.lanes[0].ankle - s.tuning.ankleMax) < 1e-6, 'event reads tuning live', String(s.event.lanes[0].ankle));\n    await press(p, 13); await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(/Reset/.test(s.menu.label), 'menu nav to Reset', s.menu.label); await press(p, 0); s = await st(p); ok(Math.abs(s.tuning.ankleMax - 4.6) < 1e-6, 'reset to defaults', String(s.tuning.ankleMax));\n    await press(p, 1); s = await st(p); ok(s.screen === 'pause', 'back to pause', s.screen); await press(p, 1); s = await st(p); ok(s.screen === 'event', 'back to event', s.screen);\n    s = await adv(p, 40); ok(s.screen === 'results', 'event ends in results', s.screen); ok(s.last.raw > 10, 'bot scored', String(s.last.raw)); ok(s.last.falls === 0, 'sharp bot did not fall', String(s.last.falls));\n    await p.evaluate(() => window.__TEST__.bot(null)); await pad(p, () => { window.__pads[0].axes[0] = window.__pads[0].axes[1] = 0; window.__pads[0].buttons[0] = { pressed: false, value: 0 }; }); await adv(p, 0.1);\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'results to menu', s.screen); ok(s.save.runs === 1, 'save counted', JSON.stringify(s.save));\n    // save survives a reload\n    await p.reload(); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title'); s = await st(p); ok(s.save.runs === 1, 'save resumes after reload', JSON.stringify(s.save));\n    ok(p.__errs.length === 0, 'flow: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n    // real time: attract after 10 wall seconds with no help\n    const c = await b.newContext({ viewport: { width: 1280, height: 720 } }); const r = await c.newPage(); await r.addInitScript(PADSTUB(1)); await r.goto(`${GAME}?test=1&render=0`); await r.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title'); const t = Date.now(); await r.waitForFunction(() => window.__TEST__.state().attract, null, { timeout: 16000 }).catch(() => {}); const took = (Date.now() - t) / 1000; ok(took > 9 && took < 12.5, 'wall-clock attract near 10 s', took.toFixed(1)); await c.close();\n  }\n  if (want('input')) {\n    const p = await logic(b, { pads: 4 });\n    let s = await st(p); await p.keyboard.press('KeyW'); s = await adv(p, 0.01); ok(s.input.lastDevice === 'kbm', 'keyboard is last device'); let g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('key-enter'), 'title shows the key prompt', g.join());\n    await pad(p, () => { window.__pads[0].buttons[1] = { pressed: true, value: 1 }; }); s = await adv(p, 1 / 120); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(s.input.lastDevice === 'pad' && g.includes('ps-cross'), 'prompt switches to the pad in the same tick', g.join()); await pad(p, () => { window.__pads[0].buttons[1] = { pressed: false, value: 0 }; }); await adv(p, 0.05);\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'pad opens menu', s.screen);\n    // Settings: glyph option, music default\n    await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(s.menu.label === 'Settings', 'nav to Settings', s.menu.label); await press(p, 0); s = await st(p); ok(s.screen === 'settings', 'settings', s.screen);\n    ok(s.audio.music === 10, 'music defaults to 10', String(s.audio.music)); await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(/Glyphs/.test(s.menu.label), 'nav to glyphs', s.menu.label); await press(p, 0); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('xb-a'), 'Xbox glyphs', g.join()); await press(p, 0); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('ps-cross'), 'back to PlayStation glyphs', g.join()); await press(p, 1); s = await st(p); ok(s.screen === 'menu', 'back to menu', s.screen);\n    // mouse: hover moves the focus, click activates\n    const box = await p.evaluate(() => [...document.querySelectorAll('.item')].map((e) => { const r = e.getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; })); await p.mouse.move(box[2][0], box[2][1]); await p.mouse.move(box[2][0] + 3, box[2][1]); s = await st(p); ok(s.menu.i === 2, 'hover moves the focus', JSON.stringify(s.menu)); s = await adv(p, 0.01); ok(s.input.lastDevice === 'kbm', 'mouse counts as keyboard and mouse');\n    await p.mouse.move(box[0][0], box[0][1]); await p.mouse.click(box[0][0], box[0][1]); s = await adv(p, 0.05); ok(s.screen === 'event', 'click starts the class', s.screen);\n    // weight: mouse pointer\n    await p.mouse.move(960 + 0.33 * 1080 * 0.5, 540); s = await adv(p, 0.5); ok(Math.abs(s.event.lanes[0].wishX - 0.5) < 0.02, 'pointer sets weight', String(s.event.lanes[0].wishX));\n    // weight: keyboard ring holds where you leave it\n    await p.keyboard.down('KeyD'); s = await adv(p, 0.25); await p.keyboard.up('KeyD'); const held = s.event.lanes[0].wishX; s = await adv(p, 0.5); ok(Math.abs(s.event.lanes[0].wishX - held) < 0.01 && Math.abs(held - s.input.ring.x) < 0.01, 'keys move the ring and it stays', `${held} ${s.event.lanes[0].wishX}`); await p.keyboard.down('KeyC'); s = await adv(p, 0.05); await p.keyboard.up('KeyC'); ok(Math.abs(s.event.lanes[0].wishX) < 0.01, 'C recentres', String(s.event.lanes[0].wishX));\n    // weight: stick. Then flail on each device\n    await pad(p, () => { window.__pads[0].axes[0] = -0.7; }); s = await adv(p, 0.1); ok(Math.abs(s.event.lanes[0].wishX + 0.7) < 0.01 && s.input.lastDevice === 'pad', 'stick sets weight and takes over', String(s.event.lanes[0].wishX)); await pad(p, () => { window.__pads[0].axes[0] = 0; }); await adv(p, 0.1);\n    await press(p, 2); s = await st(p); ok(s.event.lanes[0].clip === 'flail', 'Square flails', s.event.lanes[0].clip); await adv(p, 2.2); await p.keyboard.down('KeyF'); s = await adv(p, 0.03); await p.keyboard.up('KeyF'); ok(s.event.lanes[0].clip === 'flail', 'F flails', s.event.lanes[0].clip); await adv(p, 2.2); await p.mouse.move(960, 540); await p.mouse.down({ button: 'middle' }); s = await adv(p, 0.03); await p.mouse.up({ button: 'middle' }); ok(s.event.lanes[0].clip === 'flail', 'middle button flails', s.event.lanes[0].clip);\n    // Options ignored while Create is held\n    await adv(p, 0.5); await pad(p, () => { window.__pads[0].buttons[8] = { pressed: true, value: 1 }; window.__pads[0].buttons[9] = { pressed: true, value: 1 }; }); s = await adv(p, 0.1); ok(s.screen === 'event', 'Create + Options does not pause', s.screen); await pad(p, () => { window.__pads[0].buttons[8] = { pressed: false, value: 0 }; window.__pads[0].buttons[9] = { pressed: false, value: 0 }; }); await adv(p, 0.1);\n    // Esc pauses\n    await p.keyboard.down('Escape'); s = await adv(p, 0.05); await p.keyboard.up('Escape'); ok(s.screen === 'pause', 'Esc pauses', s.screen); await adv(p, 0.05);\n    await p.evaluate(() => window.__TEST__.show('menu')); await adv(p, 0.05);\n    // Group Class: four pads, each its own lane\n    await p.evaluate(() => window.__TEST__.show('group')); await adv(p, 0.05); for (const i of [0, 1, 2, 3]) { await pad(p, (i) => { window.__pads[i].buttons[0] = { pressed: true, value: 1 }; }, i); await adv(p, 0.03); await pad(p, (i) => { window.__pads[i].buttons[0] = { pressed: false, value: 0 }; }, i); await adv(p, 0.03); }\n    await press(p, 9); s = await st(p); ok(s.screen === 'event' && s.event.lanes.length === 4, 'four pads make four lanes', `${s.screen} ${s.event && s.event.lanes.length}`);\n    await pad(p, () => { window.__pads[0].axes[0] = 0.9; window.__pads[1].axes[0] = -0.9; window.__pads[2].axes[1] = 0.8; }); s = await adv(p, 0.6); const L = s.event.lanes; ok(L[0].wishX > 0.8 && L[1].wishX < -0.8 && L[2].wishZ > 0.7 && Math.abs(L[3].wishX) < 0.01, 'each pad drives its own lane', JSON.stringify(L.map((x) => [x.wishX, x.wishZ])));\n    ok(p.__errs.length === 0, 'input: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n  }\n  if (want('events')) {\n    // the measured Fruit Hat numbers, through the whole stack with the bot on the stubbed pad\n    const run = async (skill, bankAt) => { const p = await logic(b); await p.evaluate(() => window.__TEST__.seed(4242)); await press(p, 0); await press(p, 0); await p.evaluate(([s, k]) => window.__TEST__.bot(s, k), [skill, bankAt]); const s = await adv(p, 62); await p.context().close(); return s.last; };\n    const a = await run('sharp', 7); ok(a.falls === 0 && a.banks >= 2, 'sharp at 7: no falls', JSON.stringify(a)); ok(a.raw >= 15, 'sharp at 7: banks a lot', JSON.stringify(a));\n    const c = await run('sharp', 99); ok(c.falls >= 1, 'never banking falls', JSON.stringify(c));\n    const d = await run('clumsy', 5); ok(d.falls <= 1, 'clumsy at 5 mostly stays up', JSON.stringify(d));\n    console.error(`[numbers] sharp@7 ${JSON.stringify(a)} sharp@never ${JSON.stringify(c)} clumsy@5 ${JSON.stringify(d)}`);\n    // ragdoll from the rig: three cycles, restored each time, no NaN, bodies back to baseline\n    const p = await logic(b); await press(p, 0); await press(p, 0); let s = await st(p); const base = s.event.baseline;\n    for (let i = 0; i < 3; i++) { await p.evaluate(() => window.__TEST__.forceFall(0)); s = await adv(p, 1.2); await p.evaluate(() => window.__TEST__.clearForce(0)); const l = s.event.lanes[0]; ok(l.ragdoll && l.falls === i + 1 && l.hipsParent !== 'root', `fall ${i}: ragdoll takes over`, JSON.stringify(l)); s = await adv(p, 3); const m = s.event.lanes[0]; ok(!m.ragdoll && m.hipsParent === 'root' && Math.abs(m.hipsY - 0.46) < 1e-6, `fall ${i}: rig restored`, JSON.stringify(m)); ok(Number.isFinite(m.leanX) && Math.abs(m.leanX) < 0.5, `fall ${i}: upright and finite`, String(m.leanX)); await adv(p, 2); }\n    const m0 = (await st(p)).event.lanes[0].mixerT; s = await adv(p, 1); ok(s.event.lanes[0].mixerT > m0, 'AnimationMixer is advancing', String(s.event.lanes[0].mixerT));\n    ok(p.__errs.length === 0, 'events: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n  }\n  if (want('audio')) {\n    const p = await logic(b); await press(p, 0); let s = await st(p); await p.evaluate(() => new Promise((r) => { const t0 = performance.now(); const f = () => { window.__TEST__.advance(0.02); if (performance.now() - t0 > 1800) r(); else setTimeout(f, 30); }; f(); })); s = await st(p); ok(s.audio.state === 'running', 'context running', s.audio.state); ok(Math.abs(s.audio.musicGain - 0.1) < 1e-6, 'music bus gain .10', String(s.audio.musicGain));\n    let lvl = 0; for (let i = 0; i < 15; i++) { lvl = Math.max(lvl, await p.evaluate(() => { window.__TEST__.advance(0.02); return window.__TEST__.musicLevel(); })); await p.waitForTimeout(100); } ok(lvl > 0.002, 'analyser hears the music bus', String(lvl)); await p.context().close();\n  }\n  if (want('ui')) {\n    const p = await logic(b); const audit = async (name) => { const r = await p.evaluate(() => { const W = innerWidth, H = innerHeight, small = [], out = [], items = document.querySelectorAll('.item'), focus = document.querySelectorAll('.item.focus'); const walk = document.createTreeWalker(document.getElementById('ui'), NodeFilter.SHOW_TEXT); let n; while ((n = walk.nextNode())) { const t = n.textContent.trim(); if (!t) continue; const el = n.parentElement, fs = parseFloat(getComputedStyle(el).fontSize); if (fs < 30) small.push(`${t.slice(0, 18)}:${fs.toFixed(1)}`); const rr = document.createRange(); rr.selectNodeContents(n); const b = rr.getBoundingClientRect(); if (b.left < W * 0.05 - 1 || b.right > W * 0.95 + 1 || b.top < H * 0.05 - 1 || b.bottom > H * 0.95 + 1) out.push(t.slice(0, 18)); } return { small, out, items: items.length, focus: focus.length }; }); ok(r.small.length === 0, `${name}: text at least 30 px`, r.small.join()); ok(r.out.length === 0, `${name}: inside the safe area`, r.out.join()); ok(r.items <= 6, `${name}: at most six choices`, String(r.items)); ok(r.items === 0 || r.focus === 1, `${name}: one visible focus`, String(r.focus)); };\n    await audit('title'); await press(p, 0); await audit('menu'); for (const sc of ['settings', 'journal', 'about', 'group']) { await p.evaluate((x) => window.__TEST__.show(x), sc); await adv(p, 0.05); await audit(sc); } await p.evaluate(() => window.__TEST__.show('menu')); await adv(p, 0.05); await press(p, 0); await audit('event'); await press(p, 9); await audit('pause'); await p.evaluate(() => window.__TEST__.show('dev')); await adv(p, 0.05); await audit('dev'); await p.evaluate(() => window.__TEST__.show('event')); await adv(p, 0.05); await adv(p, 62); await audit('results');\n    // About: every field and answer, parsed from the exit file\n    const ab = JSON.parse(readFileSync('tools/about.json', 'utf8')); await p.evaluate(() => window.__TEST__.show('about')); await adv(p, 0.05); const text = await p.evaluate(() => window.__TEST__.aboutText()); for (const [k, v] of Object.entries(ab.sourceInformation)) ok(text.includes(v), `About shows ${k}`); for (const a of ['testingFeedback', 'engineFeedback', 'promptFeedback']) ok(ab[a].every((x) => text.includes(x)), `About shows ${a}`); await p.context().close();\n    // touch-only profiles\n    for (const [name, type, dev] of [['Pixel 7', chromium, 'Pixel 7'], ['iPhone 15', webkit, 'iPhone 15'], ['iPad', webkit, 'iPad (gen 7)']]) {\n      const br = type === chromium ? b : await type.launch({ headless: true }); const c = await br.newContext({ ...devices[dev] }); const t = await c.newPage(); await t.goto(`${GAME}?test=1&render=0&manual=1`); await t.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title', null, { timeout: 30000 });\n      let s = await t.evaluate(() => window.__TEST__.state()); ok(s.touchOnly, `${name}: detected as touch-only`); const txt = await t.evaluate(() => document.getElementById('ui').innerText); ok(/Controller or keyboard required/.test(txt), `${name}: shows the message`, txt);\n      const set = await t.evaluate(() => { const r = document.querySelector('[data-settings]').getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; }); await t.touchscreen.tap(set[0], set[1]); await t.waitForTimeout(60); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'settings', `${name}: tap opens Settings`, s.screen);\n      const back = await t.evaluate(() => { const it = [...document.querySelectorAll('.item')].pop().getBoundingClientRect(); return [it.x + it.width / 2, it.y + it.height / 2]; }); await t.touchscreen.tap(back[0], back[1]); await t.waitForTimeout(60); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'title', `${name}: tap Back returns`, s.screen);\n      await t.touchscreen.tap(20, 20); await t.waitForTimeout(40); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'title', `${name}: other taps do nothing`, s.screen);\n      s = await t.evaluate(() => window.__TEST__.advance(10.5)); ok(s.attract, `${name}: attract runs`); await t.keyboard.press('Enter'); s = await t.evaluate(() => window.__TEST__.advance(0.2)); ok(!s.attract && !s.touchOnly, `${name}: a key clears touch-only`, JSON.stringify([s.attract, s.touchOnly]));\n      await c.close(); if (type !== chromium) await br.close();\n    }\n  }\n  await b.close();\n}\nif (want('render')) {\n  const b = await chromium.launch({ headless: true, args: WEBGPU }); const c = await b.newContext({ viewport: { width: 1280, height: 720 } }); const p = await c.newPage(); const errs = []; let closing = false; p.on('pageerror', (e) => errs.push(String(e))); p.on('console', (m) => { if (m.type() === 'error' && !closing) errs.push(m.text().slice(0, 200)); }); await p.addInitScript(PADSTUB(1)); await p.goto(`${GAME}?test=1`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 5, null, { timeout: 60000 });\n  let s = await p.evaluate(() => window.__TEST__.state()); ok(s.render.backend === 'webgpu', 'WebGPU backend', s.render.backend);\n  await p.keyboard.press('Enter'); await p.waitForTimeout(400); await p.keyboard.press('Enter'); await p.waitForTimeout(3000); s = await p.evaluate(() => window.__TEST__.state()); ok(s.screen === 'event' && s.event.t > 0.5, 'class runs in real time with rendering', `${s.screen} ${s.event && s.event.t}`); ok(s.render.frames > 20, 'frames rising', String(s.render.frames)); ok(errs.length === 0, 'render: no errors', errs.slice(0, 2).join(' | '));\n  closing = true; await b.close();\n  const w = await webkit.launch({ headless: true }); const pw = await w.newPage({ viewport: { width: 1280, height: 720 } }); const e2 = []; pw.on('pageerror', (e) => e2.push(String(e))); await pw.goto(`${GAME}?test=1`); await pw.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 3, null, { timeout: 60000 }); await pw.keyboard.press('Enter'); await pw.waitForTimeout(300); await pw.keyboard.press('Enter'); await pw.waitForTimeout(2500); s = await pw.evaluate(() => window.__TEST__.state()); ok(s.render.backend === 'webgl2', 'WebKit falls back to WebGL2', s.render.backend); ok(s.screen === 'event', 'class runs on WebGL2', s.screen); ok(e2.length === 0, 'webgl2: no errors', e2.slice(0, 2).join(' | ')); await w.close();\n}\nif (want('hub')) {\n  const root = resolve('tools/hub'); const server = createServer(async (req, res) => { const u = new URL(req.url, 'http://x'); try { const f = u.pathname === '/game.html' ? resolve('out/game.html') : join(root, decodeURIComponent(u.pathname)); const data = await rf(f); res.writeHead(200, { 'content-type': { '.html': 'text/html', '.js': 'text/javascript' }[extname(f)] || 'application/octet-stream' }); res.end(data); } catch { res.writeHead(404); res.end('nope'); } }); await new Promise((r) => server.listen(0, '127.0.0.1', r)); const port = server.address().port;\n  const b = await chromium.launch({ headless: true, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...WEBGPU] });\n  const check = await b.newPage(); await check.goto(`http://127.0.0.1:${port}/game.html`); await check.waitForTimeout(1200); ok((await check.evaluate(() => window.__GAME__)) === 'PROOF SLICE', 'the served page is my game'); await check.close();\n  for (const q of ['players=1', 'players=2', 'players=4&latency=150&jitter=50&loss=5', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave', 'players=2&latency=150&jitter=50&loss=5&limit=20']) {\n    const p = await b.newPage({ viewport: { width: 1600, height: 900 } }); await p.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${q}&auto=1`); const done = await p.waitForSelector('body[data-complete=\"true\"]', { timeout: 200000 }).then(() => true, () => false); ok(done, `harness finished ${q}`); if (done) { const r = await p.evaluate(() => ({ pass: window.__hubCheck.pass, bad: window.__hubCheck.checks.filter((c) => !c.pass).map((c) => `${c.name}: ${c.detail}`) })); ok(r.pass, `harness ${q}`, r.bad.join(' | ')); } await p.close();\n  }\n  await b.close();\n  // on its own: open, Enter, Space, Enter, Space, no errors, inactive client, untouched Math.random\n  const b2 = await chromium.launch({ headless: true, args: WEBGPU }); const t = await b2.newPage({ viewport: { width: 1280, height: 720 } }); const errs = []; let closing = false; t.on('pageerror', (e) => errs.push(String(e))); t.on('console', (m) => { if (m.type() === 'error' && !closing) errs.push(m.text().slice(0, 160)); }); await t.goto(GAME); await t.waitForTimeout(2500); for (const k of ['Enter', 'Space', 'Enter', 'Space']) { await t.keyboard.press(k); await t.waitForTimeout(500); } await t.waitForTimeout(1000); const h = await t.evaluate(() => ({ active: AIHub.active, seeded: AIHub.seeded, text: document.getElementById('ui').innerText.length })); ok(h.active === false && h.seeded !== true && h.text > 0, 'on its own: client inactive and something drawn', JSON.stringify(h)); ok(errs.length === 0, 'on its own: no errors', errs.slice(0, 2).join(' | ')); closing = true; await b2.close(); server.close();\n}\nif (want('shots')) {\n  const b = await chromium.launch({ headless: true, args: SHOTS }); const p = await b.newPage({ viewport: { width: 1920, height: 1080 } }); await p.addInitScript(PADSTUB(1)); await p.goto(`${GAME}?test=1`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 2, null, { timeout: 90000 }); await p.waitForTimeout(1500); await p.screenshot({ path: 'out/title.png' }); await p.keyboard.press('Enter'); await p.waitForTimeout(800); await p.screenshot({ path: 'out/menu.png' }); await p.keyboard.press('Enter'); await p.evaluate(() => window.__TEST__.bot('sharp', 9)); await p.waitForTimeout(14000); await p.screenshot({ path: 'out/event.png' }); await b.close();\n}\nfor (const f of fails) console.log('FAIL', f);\nconsole.log(`${pass} passed, ${fails.length} failed`);\nprocess.exit(fails.length ? 1 : 0);\nEOF\nnode tools/build.mjs && node tools/test.mjs unit 2>&1 | tail -12","description":"Build the integration prototype and run its unit checks","timeout":180000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11125,"cache_read_input_tokens":670979,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11125},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"19307802-7215-43fb-a84b-6c94bbc636c5","uuid":"e3575f1d-cafa-42a7-a639-ae93e000622b","timestamp":"2026-11-05T05:48:34.705Z","request_id":"req_011CgjFLv9yonSTnaisCR2Zn","wire_tool_inputs":{"toolu_01JH28yfm5wQcvmVpjqH5mCn":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/proof && cat > tools/test.mjs <<'EOF'\n// The plan's one command: prints only failures and a one-line count.\nimport { chromium, webkit, devices } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFile, readFileSync } from 'node:fs';\nimport { readFile as rf } from 'node:fs/promises';\nimport { join, extname, resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nconst groups = process.argv.slice(2); const want = (g) => !groups.length || groups.includes('full') || groups.includes(g);\nlet pass = 0; const fails = [];\nconst ok = (cond, name, detail = '') => { if (cond) pass++; else fails.push(`${name}${detail ? ' :: ' + detail : ''}`); };\nconst WEBGPU = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader'];\nconst SHOTS = [...WEBGPU, '--use-vulkan=swiftshader', '--use-angle=swiftshader'];\nconst GAME = pathToFileURL(resolve('out/game.html')).href;\nconst PADSTUB = (n = 1) => `window.__pads = Array.from({length:${n}}, (_, i) => ({ index: i, id: 'stub', connected: true, mapping: 'standard', axes: [0,0,0,0], buttons: Array.from({length:18}, () => ({pressed:false, value:0})), vibrationActuator: { playEffect() {} } })); navigator.getGamepads = () => window.__pads;`;\nconst logic = async (b, { pads = 1, q = '' } = {}) => { const c = await b.newContext({ viewport: { width: 1920, height: 1080 } }); const p = await c.newPage(); p.__errs = []; p.on('pageerror', (e) => p.__errs.push(String(e))); p.on('console', (m) => { if (m.type() === 'error' && !/Device Lost/.test(m.text())) p.__errs.push(m.text()); }); await p.addInitScript(PADSTUB(pads)); await p.goto(`${GAME}?test=1&render=0&manual=1${q}`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title', null, { timeout: 30000 }); return p; };\nconst adv = (p, s) => p.evaluate((x) => window.__TEST__.advance(x), s);\nconst st = (p) => p.evaluate(() => window.__TEST__.state());\nconst pad = (p, fn, arg) => p.evaluate(fn, arg);\nconst press = async (p, b, i = 0) => { await pad(p, ([b, i]) => { window.__pads[i].buttons[b] = { pressed: true, value: 1 }; }, [b, i]); await adv(p, 0.05); await pad(p, ([b, i]) => { window.__pads[i].buttons[b] = { pressed: false, value: 0 }; }, [b, i]); await adv(p, 0.05); };\nconst key = async (p, k) => { await p.keyboard.down(k); await adv(p, 0.05); await p.keyboard.up(k); await adv(p, 0.05); };\n\nif (want('unit')) {\n  const html = readFileSync('out/game.html', 'utf8');\n  ok(html.startsWith('<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>/*! aihub-session'), 'client directly after meta charset');\n  for (const n of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-goal', 'hub:session-howto']) ok(new RegExp(`<meta\\\\s+name=[\"']${n}[\"']\\\\s+content=[\"']([^\"']+)[\"']`).test(html), 'meta ' + n);\n  ok(html.match(/hub:session-goal\" content=\"([^\"]+)/)[1].length <= 60, 'goal under 60'); ok(html.match(/hub:session-howto\" content=\"([^\"]+)/)[1].length <= 80, 'howto under 80');\n  ok(!/https?:\\/\\/(?!www\\.w3\\.org)[a-z]+\\.[a-z]+\\/[^\"' ]+\\.(mp3|ogg|wav|m4a)/i.test(html), 'no audio urls');\n  const scripts = html.split('<script>').length - 1; ok(scripts === 2, 'two inline scripts', String(scripts));\n  const src = readFileSync('src/main.js', 'utf8');\n  ok(!/\\b(alert|confirm|prompt)\\(/.test(src.replace(/AIHub\\.|promptHTML|promptsBar/g, '')), 'no dialogs'); ok(!/WebSocket|RTCPeerConnection|window\\.open|location\\.href\\s*=/.test(src), 'no network or navigation');\n  ok(!/Math\\.random/.test(src), 'no Math.random'); ok(!/TODO|FIXME/.test(src), 'no TODO');\n}\nif (want('flow') || want('input') || want('events') || want('audio') || want('ui')) {\n  const b = await chromium.launch({ headless: true, args: ['--autoplay-policy=no-user-gesture-required'] });\n  if (want('flow')) {\n    const p = await logic(b);\n    let s = await st(p); ok(s.render.revision === '180', 'three R180', s.render.revision); ok(s.render.rapier === '0.19.3', 'rapier 0.19.3', s.render.rapier);\n    // attract at 10 s, any input exits, the press is swallowed\n    s = await adv(p, 9.5); ok(!s.attract, 'no attract before 10 s', String(s.idle)); s = await adv(p, 0.7); ok(s.attract && s.event, 'attract at 10 s');\n    s = await adv(p, 40); ok(s.attractSeen >= 2, 'attract visits vignettes', String(s.attractSeen));\n    await p.keyboard.down('Enter'); s = await adv(p, 0.05); ok(!s.attract && s.screen === 'title', 'a key exits attract to the title', s.screen); await p.keyboard.up('Enter'); s = await adv(p, 0.2); ok(s.screen === 'title', 'and that press is not acted on', s.screen);\n    s = await adv(p, 10.5); ok(s.attract, 'attract again'); await pad(p, () => { window.__pads[0].buttons[0] = { pressed: true, value: 1 }; }); s = await adv(p, 0.05); ok(!s.attract, 'a button exits attract'); await pad(p, () => { window.__pads[0].buttons[0] = { pressed: false, value: 0 }; }); s = await adv(p, 0.1); ok(s.screen === 'title', 'button swallowed', s.screen);\n    s = await adv(p, 10.5); ok(s.attract, 'attract third time'); await p.mouse.move(300, 300); await p.mouse.move(600, 500); s = await adv(p, 0.05); ok(!s.attract, 'mouse movement exits attract');\n    s = await adv(p, 10.5); await pad(p, () => { window.__pads[0].axes[0] = 0.9; }); s = await adv(p, 0.05); ok(!s.attract, 'a stick exits attract'); await pad(p, () => { window.__pads[0].axes[0] = 0; }); await adv(p, 0.1);\n    // a whole class through menus on the pad, with the bot on the real input path\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'title to menu', s.screen);\n    await press(p, 0); s = await st(p); ok(s.screen === 'event', 'menu to event', s.screen);\n    await p.evaluate(() => window.__TEST__.bot('sharp', 7));\n    s = await adv(p, 30); ok(s.event.lanes[0].banks > 0, 'bot banks through the pad path', JSON.stringify(s.event.lanes[0]));\n    await press(p, 9); s = await st(p); ok(s.screen === 'pause', 'Options pauses', s.screen); const t0 = s.simT;\n    await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(s.menu.label === 'Dev Mode', 'menu nav to Dev Mode', JSON.stringify(s.menu)); await press(p, 0); s = await st(p); ok(s.screen === 'dev', 'Dev Mode from Pause', s.screen);\n    const a0 = s.tuning.ankleMax; await press(p, 15); await press(p, 15); s = await st(p); ok(Math.abs(s.tuning.ankleMax - a0 - 0.2) < 1e-6, 'slider moves tuning live', String(s.tuning.ankleMax)); ok(Math.abs(s.event.lanes[0].ankle - s.tuning.ankleMax) < 1e-6, 'event reads tuning live', String(s.event.lanes[0].ankle));\n    await press(p, 13); await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(/Reset/.test(s.menu.label), 'menu nav to Reset', s.menu.label); await press(p, 0); s = await st(p); ok(Math.abs(s.tuning.ankleMax - 4.6) < 1e-6, 'reset to defaults', String(s.tuning.ankleMax));\n    await press(p, 1); s = await st(p); ok(s.screen === 'pause', 'back to pause', s.screen); await press(p, 1); s = await st(p); ok(s.screen === 'event', 'back to event', s.screen);\n    s = await adv(p, 40); ok(s.screen === 'results', 'event ends in results', s.screen); ok(s.last.raw > 10, 'bot scored', String(s.last.raw)); ok(s.last.falls === 0, 'sharp bot did not fall', String(s.last.falls));\n    await p.evaluate(() => window.__TEST__.bot(null)); await pad(p, () => { window.__pads[0].axes[0] = window.__pads[0].axes[1] = 0; window.__pads[0].buttons[0] = { pressed: false, value: 0 }; }); await adv(p, 0.1);\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'results to menu', s.screen); ok(s.save.runs === 1, 'save counted', JSON.stringify(s.save));\n    // save survives a reload\n    await p.reload(); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title'); s = await st(p); ok(s.save.runs === 1, 'save resumes after reload', JSON.stringify(s.save));\n    ok(p.__errs.length === 0, 'flow: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n    // real time: attract after 10 wall seconds with no help\n    const c = await b.newContext({ viewport: { width: 1280, height: 720 } }); const r = await c.newPage(); await r.addInitScript(PADSTUB(1)); await r.goto(`${GAME}?test=1&render=0`); await r.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title'); const t = Date.now(); await r.waitForFunction(() => window.__TEST__.state().attract, null, { timeout: 16000 }).catch(() => {}); const took = (Date.now() - t) / 1000; ok(took > 9 && took < 12.5, 'wall-clock attract near 10 s', took.toFixed(1)); await c.close();\n  }\n  if (want('input')) {\n    const p = await logic(b, { pads: 4 });\n    let s = await st(p); await p.keyboard.press('KeyW'); s = await adv(p, 0.01); ok(s.input.lastDevice === 'kbm', 'keyboard is last device'); let g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('key-enter'), 'title shows the key prompt', g.join());\n    await pad(p, () => { window.__pads[0].buttons[1] = { pressed: true, value: 1 }; }); s = await adv(p, 1 / 120); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(s.input.lastDevice === 'pad' && g.includes('ps-cross'), 'prompt switches to the pad in the same tick', g.join()); await pad(p, () => { window.__pads[0].buttons[1] = { pressed: false, value: 0 }; }); await adv(p, 0.05);\n    await press(p, 0); s = await st(p); ok(s.screen === 'menu', 'pad opens menu', s.screen);\n    // Settings: glyph option, music default\n    await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(s.menu.label === 'Settings', 'nav to Settings', s.menu.label); await press(p, 0); s = await st(p); ok(s.screen === 'settings', 'settings', s.screen);\n    ok(s.audio.music === 10, 'music defaults to 10', String(s.audio.music)); await press(p, 13); await press(p, 13); await press(p, 13); s = await st(p); ok(/Glyphs/.test(s.menu.label), 'nav to glyphs', s.menu.label); await press(p, 0); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('xb-a'), 'Xbox glyphs', g.join()); await press(p, 0); g = await p.evaluate(() => window.__TEST__.glyphs()); ok(g.includes('ps-cross'), 'back to PlayStation glyphs', g.join()); await press(p, 1); s = await st(p); ok(s.screen === 'menu', 'back to menu', s.screen);\n    // mouse: hover moves the focus, click activates\n    const box = await p.evaluate(() => [...document.querySelectorAll('.item')].map((e) => { const r = e.getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; })); await p.mouse.move(box[2][0], box[2][1]); await p.mouse.move(box[2][0] + 3, box[2][1]); s = await st(p); ok(s.menu.i === 2, 'hover moves the focus', JSON.stringify(s.menu)); s = await adv(p, 0.01); ok(s.input.lastDevice === 'kbm', 'mouse counts as keyboard and mouse');\n    await p.mouse.move(box[0][0], box[0][1]); await p.mouse.click(box[0][0], box[0][1]); s = await adv(p, 0.05); ok(s.screen === 'event', 'click starts the class', s.screen);\n    // weight: mouse pointer\n    await p.mouse.move(960 + 0.33 * 1080 * 0.5, 540); s = await adv(p, 0.5); ok(Math.abs(s.event.lanes[0].wishX - 0.5) < 0.02, 'pointer sets weight', String(s.event.lanes[0].wishX));\n    // weight: keyboard ring holds where you leave it\n    await p.keyboard.down('KeyD'); s = await adv(p, 0.25); await p.keyboard.up('KeyD'); const held = s.event.lanes[0].wishX; s = await adv(p, 0.5); ok(Math.abs(s.event.lanes[0].wishX - held) < 0.01 && Math.abs(held - s.input.ring.x) < 0.01, 'keys move the ring and it stays', `${held} ${s.event.lanes[0].wishX}`); await p.keyboard.down('KeyC'); s = await adv(p, 0.05); await p.keyboard.up('KeyC'); ok(Math.abs(s.event.lanes[0].wishX) < 0.01, 'C recentres', String(s.event.lanes[0].wishX));\n    // weight: stick. Then flail on each device\n    await pad(p, () => { window.__pads[0].axes[0] = -0.7; }); s = await adv(p, 0.1); ok(Math.abs(s.event.lanes[0].wishX + 0.7) < 0.01 && s.input.lastDevice === 'pad', 'stick sets weight and takes over', String(s.event.lanes[0].wishX)); await pad(p, () => { window.__pads[0].axes[0] = 0; }); await adv(p, 0.1);\n    await press(p, 2); s = await st(p); ok(s.event.lanes[0].clip === 'flail', 'Square flails', s.event.lanes[0].clip); await adv(p, 2.2); await p.keyboard.down('KeyF'); s = await adv(p, 0.03); await p.keyboard.up('KeyF'); ok(s.event.lanes[0].clip === 'flail', 'F flails', s.event.lanes[0].clip); await adv(p, 2.2); await p.mouse.move(960, 540); await p.mouse.down({ button: 'middle' }); s = await adv(p, 0.03); await p.mouse.up({ button: 'middle' }); ok(s.event.lanes[0].clip === 'flail', 'middle button flails', s.event.lanes[0].clip);\n    // Options ignored while Create is held\n    await adv(p, 0.5); await pad(p, () => { window.__pads[0].buttons[8] = { pressed: true, value: 1 }; window.__pads[0].buttons[9] = { pressed: true, value: 1 }; }); s = await adv(p, 0.1); ok(s.screen === 'event', 'Create + Options does not pause', s.screen); await pad(p, () => { window.__pads[0].buttons[8] = { pressed: false, value: 0 }; window.__pads[0].buttons[9] = { pressed: false, value: 0 }; }); await adv(p, 0.1);\n    // Esc pauses\n    await p.keyboard.down('Escape'); s = await adv(p, 0.05); await p.keyboard.up('Escape'); ok(s.screen === 'pause', 'Esc pauses', s.screen); await adv(p, 0.05);\n    await p.evaluate(() => window.__TEST__.show('menu')); await adv(p, 0.05);\n    // Group Class: four pads, each its own lane\n    await p.evaluate(() => window.__TEST__.show('group')); await adv(p, 0.05); for (const i of [0, 1, 2, 3]) { await pad(p, (i) => { window.__pads[i].buttons[0] = { pressed: true, value: 1 }; }, i); await adv(p, 0.03); await pad(p, (i) => { window.__pads[i].buttons[0] = { pressed: false, value: 0 }; }, i); await adv(p, 0.03); }\n    await press(p, 9); s = await st(p); ok(s.screen === 'event' && s.event.lanes.length === 4, 'four pads make four lanes', `${s.screen} ${s.event && s.event.lanes.length}`);\n    await pad(p, () => { window.__pads[0].axes[0] = 0.9; window.__pads[1].axes[0] = -0.9; window.__pads[2].axes[1] = 0.8; }); s = await adv(p, 0.6); const L = s.event.lanes; ok(L[0].wishX > 0.8 && L[1].wishX < -0.8 && L[2].wishZ > 0.7 && Math.abs(L[3].wishX) < 0.01, 'each pad drives its own lane', JSON.stringify(L.map((x) => [x.wishX, x.wishZ])));\n    ok(p.__errs.length === 0, 'input: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n  }\n  if (want('events')) {\n    // the measured Fruit Hat numbers, through the whole stack with the bot on the stubbed pad\n    const run = async (skill, bankAt) => { const p = await logic(b); await p.evaluate(() => window.__TEST__.seed(4242)); await press(p, 0); await press(p, 0); await p.evaluate(([s, k]) => window.__TEST__.bot(s, k), [skill, bankAt]); const s = await adv(p, 62); await p.context().close(); return s.last; };\n    const a = await run('sharp', 7); ok(a.falls === 0 && a.banks >= 2, 'sharp at 7: no falls', JSON.stringify(a)); ok(a.raw >= 15, 'sharp at 7: banks a lot', JSON.stringify(a));\n    const c = await run('sharp', 99); ok(c.falls >= 1, 'never banking falls', JSON.stringify(c));\n    const d = await run('clumsy', 5); ok(d.falls <= 1, 'clumsy at 5 mostly stays up', JSON.stringify(d));\n    console.error(`[numbers] sharp@7 ${JSON.stringify(a)} sharp@never ${JSON.stringify(c)} clumsy@5 ${JSON.stringify(d)}`);\n    // ragdoll from the rig: three cycles, restored each time, no NaN, bodies back to baseline\n    const p = await logic(b); await press(p, 0); await press(p, 0); let s = await st(p); const base = s.event.baseline;\n    for (let i = 0; i < 3; i++) { await p.evaluate(() => window.__TEST__.forceFall(0)); s = await adv(p, 1.2); await p.evaluate(() => window.__TEST__.clearForce(0)); const l = s.event.lanes[0]; ok(l.ragdoll && l.falls === i + 1 && l.hipsParent !== 'root', `fall ${i}: ragdoll takes over`, JSON.stringify(l)); s = await adv(p, 3); const m = s.event.lanes[0]; ok(!m.ragdoll && m.hipsParent === 'root' && Math.abs(m.hipsY - 0.46) < 1e-6, `fall ${i}: rig restored`, JSON.stringify(m)); ok(Number.isFinite(m.leanX) && Math.abs(m.leanX) < 0.5, `fall ${i}: upright and finite`, String(m.leanX)); await adv(p, 2); }\n    const m0 = (await st(p)).event.lanes[0].mixerT; s = await adv(p, 1); ok(s.event.lanes[0].mixerT > m0, 'AnimationMixer is advancing', String(s.event.lanes[0].mixerT));\n    ok(p.__errs.length === 0, 'events: no errors', p.__errs.slice(0, 2).join(' | ')); await p.context().close();\n  }\n  if (want('audio')) {\n    const p = await logic(b); await press(p, 0); let s = await st(p); await p.evaluate(() => new Promise((r) => { const t0 = performance.now(); const f = () => { window.__TEST__.advance(0.02); if (performance.now() - t0 > 1800) r(); else setTimeout(f, 30); }; f(); })); s = await st(p); ok(s.audio.state === 'running', 'context running', s.audio.state); ok(Math.abs(s.audio.musicGain - 0.1) < 1e-6, 'music bus gain .10', String(s.audio.musicGain));\n    let lvl = 0; for (let i = 0; i < 15; i++) { lvl = Math.max(lvl, await p.evaluate(() => { window.__TEST__.advance(0.02); return window.__TEST__.musicLevel(); })); await p.waitForTimeout(100); } ok(lvl > 0.002, 'analyser hears the music bus', String(lvl)); await p.context().close();\n  }\n  if (want('ui')) {\n    const p = await logic(b); const audit = async (name) => { const r = await p.evaluate(() => { const W = innerWidth, H = innerHeight, small = [], out = [], items = document.querySelectorAll('.item'), focus = document.querySelectorAll('.item.focus'); const walk = document.createTreeWalker(document.getElementById('ui'), NodeFilter.SHOW_TEXT); let n; while ((n = walk.nextNode())) { const t = n.textContent.trim(); if (!t) continue; const el = n.parentElement, fs = parseFloat(getComputedStyle(el).fontSize); if (fs < 30) small.push(`${t.slice(0, 18)}:${fs.toFixed(1)}`); const rr = document.createRange(); rr.selectNodeContents(n); const b = rr.getBoundingClientRect(); if (b.left < W * 0.05 - 1 || b.right > W * 0.95 + 1 || b.top < H * 0.05 - 1 || b.bottom > H * 0.95 + 1) out.push(t.slice(0, 18)); } return { small, out, items: items.length, focus: focus.length }; }); ok(r.small.length === 0, `${name}: text at least 30 px`, r.small.join()); ok(r.out.length === 0, `${name}: inside the safe area`, r.out.join()); ok(r.items <= 6, `${name}: at most six choices`, String(r.items)); ok(r.items === 0 || r.focus === 1, `${name}: one visible focus`, String(r.focus)); };\n    await audit('title'); await press(p, 0); await audit('menu'); for (const sc of ['settings', 'journal', 'about', 'group']) { await p.evaluate((x) => window.__TEST__.show(x), sc); await adv(p, 0.05); await audit(sc); } await p.evaluate(() => window.__TEST__.show('menu')); await adv(p, 0.05); await press(p, 0); await audit('event'); await press(p, 9); await audit('pause'); await p.evaluate(() => window.__TEST__.show('dev')); await adv(p, 0.05); await audit('dev'); await p.evaluate(() => window.__TEST__.show('event')); await adv(p, 0.05); await adv(p, 62); await audit('results');\n    // About: every field and answer, parsed from the exit file\n    const ab = JSON.parse(readFileSync('tools/about.json', 'utf8')); await p.evaluate(() => window.__TEST__.show('about')); await adv(p, 0.05); const text = await p.evaluate(() => window.__TEST__.aboutText()); for (const [k, v] of Object.entries(ab.sourceInformation)) ok(text.includes(v), `About shows ${k}`); for (const a of ['testingFeedback', 'engineFeedback', 'promptFeedback']) ok(ab[a].every((x) => text.includes(x)), `About shows ${a}`); await p.context().close();\n    // touch-only profiles\n    for (const [name, type, dev] of [['Pixel 7', chromium, 'Pixel 7'], ['iPhone 15', webkit, 'iPhone 15'], ['iPad', webkit, 'iPad (gen 7)']]) {\n      const br = type === chromium ? b : await type.launch({ headless: true }); const c = await br.newContext({ ...devices[dev] }); const t = await c.newPage(); await t.goto(`${GAME}?test=1&render=0&manual=1`); await t.waitForFunction(() => window.__TEST__ && window.__TEST__.state().screen === 'title', null, { timeout: 30000 });\n      let s = await t.evaluate(() => window.__TEST__.state()); ok(s.touchOnly, `${name}: detected as touch-only`); const txt = await t.evaluate(() => document.getElementById('ui').innerText); ok(/Controller or keyboard required/.test(txt), `${name}: shows the message`, txt);\n      const set = await t.evaluate(() => { const r = document.querySelector('[data-settings]').getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; }); await t.touchscreen.tap(set[0], set[1]); await t.waitForTimeout(60); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'settings', `${name}: tap opens Settings`, s.screen);\n      const back = await t.evaluate(() => { const it = [...document.querySelectorAll('.item')].pop().getBoundingClientRect(); return [it.x + it.width / 2, it.y + it.height / 2]; }); await t.touchscreen.tap(back[0], back[1]); await t.waitForTimeout(60); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'title', `${name}: tap Back returns`, s.screen);\n      await t.touchscreen.tap(20, 20); await t.waitForTimeout(40); s = await t.evaluate(() => window.__TEST__.advance(0.05)); ok(s.screen === 'title', `${name}: other taps do nothing`, s.screen);\n      s = await t.evaluate(() => window.__TEST__.advance(10.5)); ok(s.attract, `${name}: attract runs`); await t.keyboard.press('Enter'); s = await t.evaluate(() => window.__TEST__.advance(0.2)); ok(!s.attract && !s.touchOnly, `${name}: a key clears touch-only`, JSON.stringify([s.attract, s.touchOnly]));\n      await c.close(); if (type !== chromium) await br.close();\n    }\n  }\n  await b.close();\n}\nif (want('render')) {\n  const b = await chromium.launch({ headless: true, args: WEBGPU }); const c = await b.newContext({ viewport: { width: 1280, height: 720 } }); const p = await c.newPage(); const errs = []; let closing = false; p.on('pageerror', (e) => errs.push(String(e))); p.on('console', (m) => { if (m.type() === 'error' && !closing) errs.push(m.text().slice(0, 200)); }); await p.addInitScript(PADSTUB(1)); await p.goto(`${GAME}?test=1`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 5, null, { timeout: 60000 });\n  let s = await p.evaluate(() => window.__TEST__.state()); ok(s.render.backend === 'webgpu', 'WebGPU backend', s.render.backend);\n  await p.keyboard.press('Enter'); await p.waitForTimeout(400); await p.keyboard.press('Enter'); await p.waitForTimeout(3000); s = await p.evaluate(() => window.__TEST__.state()); ok(s.screen === 'event' && s.event.t > 0.5, 'class runs in real time with rendering', `${s.screen} ${s.event && s.event.t}`); ok(s.render.frames > 20, 'frames rising', String(s.render.frames)); ok(errs.length === 0, 'render: no errors', errs.slice(0, 2).join(' | '));\n  closing = true; await b.close();\n  const w = await webkit.launch({ headless: true }); const pw = await w.newPage({ viewport: { width: 1280, height: 720 } }); const e2 = []; pw.on('pageerror', (e) => e2.push(String(e))); await pw.goto(`${GAME}?test=1`); await pw.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 3, null, { timeout: 60000 }); await pw.keyboard.press('Enter'); await pw.waitForTimeout(300); await pw.keyboard.press('Enter'); await pw.waitForTimeout(2500); s = await pw.evaluate(() => window.__TEST__.state()); ok(s.render.backend === 'webgl2', 'WebKit falls back to WebGL2', s.render.backend); ok(s.screen === 'event', 'class runs on WebGL2', s.screen); ok(e2.length === 0, 'webgl2: no errors', e2.slice(0, 2).join(' | ')); await w.close();\n}\nif (want('hub')) {\n  const root = resolve('tools/hub'); const server = createServer(async (req, res) => { const u = new URL(req.url, 'http://x'); try { const f = u.pathname === '/game.html' ? resolve('out/game.html') : join(root, decodeURIComponent(u.pathname)); const data = await rf(f); res.writeHead(200, { 'content-type': { '.html': 'text/html', '.js': 'text/javascript' }[extname(f)] || 'application/octet-stream' }); res.end(data); } catch { res.writeHead(404); res.end('nope'); } }); await new Promise((r) => server.listen(0, '127.0.0.1', r)); const port = server.address().port;\n  const b = await chromium.launch({ headless: true, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...WEBGPU] });\n  const check = await b.newPage(); await check.goto(`http://127.0.0.1:${port}/game.html`); await check.waitForTimeout(1200); ok((await check.evaluate(() => window.__GAME__)) === 'PROOF SLICE', 'the served page is my game'); await check.close();\n  for (const q of ['players=1', 'players=2', 'players=4&latency=150&jitter=50&loss=5', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave', 'players=2&latency=150&jitter=50&loss=5&limit=20']) {\n    const p = await b.newPage({ viewport: { width: 1600, height: 900 } }); await p.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${q}&auto=1`); const done = await p.waitForSelector('body[data-complete=\"true\"]', { timeout: 200000 }).then(() => true, () => false); ok(done, `harness finished ${q}`); if (done) { const r = await p.evaluate(() => ({ pass: window.__hubCheck.pass, bad: window.__hubCheck.checks.filter((c) => !c.pass).map((c) => `${c.name}: ${c.detail}`) })); ok(r.pass, `harness ${q}`, r.bad.join(' | ')); } await p.close();\n  }\n  await b.close();\n  // on its own: open, Enter, Space, Enter, Space, no errors, inactive client, untouched Math.random\n  const b2 = await chromium.launch({ headless: true, args: WEBGPU }); const t = await b2.newPage({ viewport: { width: 1280, height: 720 } }); const errs = []; let closing = false; t.on('pageerror', (e) => errs.push(String(e))); t.on('console', (m) => { if (m.type() === 'error' && !closing) errs.push(m.text().slice(0, 160)); }); await t.goto(GAME); await t.waitForTimeout(2500); for (const k of ['Enter', 'Space', 'Enter', 'Space']) { await t.keyboard.press(k); await t.waitForTimeout(500); } await t.waitForTimeout(1000); const h = await t.evaluate(() => ({ active: AIHub.active, seeded: AIHub.seeded, text: document.getElementById('ui').innerText.length })); ok(h.active === false && h.seeded !== true && h.text > 0, 'on its own: client inactive and something drawn', JSON.stringify(h)); ok(errs.length === 0, 'on its own: no errors', errs.slice(0, 2).join(' | ')); closing = true; await b2.close(); server.close();\n}\nif (want('shots')) {\n  const b = await chromium.launch({ headless: true, args: SHOTS }); const p = await b.newPage({ viewport: { width: 1920, height: 1080 } }); await p.addInitScript(PADSTUB(1)); await p.goto(`${GAME}?test=1`); await p.waitForFunction(() => window.__TEST__ && window.__TEST__.state().render.frames > 2, null, { timeout: 90000 }); await p.waitForTimeout(1500); await p.screenshot({ path: 'out/title.png' }); await p.keyboard.press('Enter'); await p.waitForTimeout(800); await p.screenshot({ path: 'out/menu.png' }); await p.keyboard.press('Enter'); await p.evaluate(() => window.__TEST__.bot('sharp', 9)); await p.waitForTimeout(14000); await p.screenshot({ path: 'out/event.png' }); await b.close();\n}\nfor (const f of fails) console.log('FAIL', f);\nconsole.log(`${pass} passed, ${fails.length} failed`);\nprocess.exit(fails.length ? 1 : 0);\nEOF\nnode tools/build.mjs && node tools/test.mjs unit 2>&1 | tail -12","description":"Build the integration prototype and run its unit checks","timeout":180000}},"wire_ingest_context":{"toolu_01JH28yfm5wQcvmVpjqH5mCn":{"cwd":"/home/micha/dev/c