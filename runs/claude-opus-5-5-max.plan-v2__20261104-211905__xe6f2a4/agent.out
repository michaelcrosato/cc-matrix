95, 2.5]].map(([x, y]) => new THREE.Vector2(x, y)), 40), toon(0xcff3ff, { transparent: true, opacity: 0.22, side: THREE.DoubleSide, depthWrite: false }));\n  jar.add(jarGlass);\n  const N = 120, marbleColors = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700, 0xf28fb5, 0xffffff];\n  const inst = new THREE.InstancedMesh(new THREE.SphereGeometry(0.14, 14, 10), toon(0xffffff), N); inst.castShadow = true;\n  const m4 = new THREE.Matrix4(), c = new THREE.Color();\n  for (let i = 0; i < N; i++) { const a = i * 2.399, r = 0.86 * Math.sqrt((i % 24 + 0.5) / 24), y = 0.14 + Math.floor(i / 24) * 0.24; m4.makeTranslation(Math.cos(a) * r, y, Math.sin(a) * r); inst.setMatrixAt(i, m4); inst.setColorAt(i, c.setHex(marbleColors[i % 6])); }\n  jar.add(inst);\n  // hard-edged test props: box and plain cylinder\n  const crate = shadowed(new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.9, 0.9), toon(0xc98a4b))); crate.position.set(1.6, 0.45, 6.2); crate.rotation.y = 0.6; scene.add(crate);\n  const merged = new THREE.BoxGeometry(0.9, 0.9, 0.9); merged.deleteAttribute('normal'); merged.deleteAttribute('uv'); const smooth = mergeVertices(merged); smooth.computeVertexNormals();\n  const crate2 = shadowed(new THREE.Mesh(smooth, toon(0xc98a4b))); crate2.position.set(-2.6, 0.45, 6.4); crate2.rotation.y = -0.4; scene.add(crate2);\n\n  const post = new THREE.PostProcessing(renderer);\n  const INK = 0x1a1420;\n  const inkColor = uniform(new THREE.Color(INK)), inkWidth = uniform(1.4), boilAmt = uniform(0.5), fadeNear = uniform(30), fadeFar = uniform(90);\n  const nearU = uniform(camera.near), farU = uniform(camera.far);\n  const scenePass = toonOutlinePass(scene, camera, color(INK), float(0.0028), float(1));\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output'), normalTex = scenePass.getTextureNode('normal'), depthTex = scenePass.getTextureNode('depth');\n  post.outputNode = Fn(() => {\n    const cell = floor(uv().mul(vec2(40, 23)));\n    const boil = hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(0.5).mul(boilAmt);\n    const px = inkWidth.add(boil).div(screenSize);\n    const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, nearU, farU);\n    const n = (o) => normalTex.sample(uv().add(o)).xyz;\n    const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n    const z0 = viewZ(vec2(0, 0)).abs();\n    const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.max(0.5));\n    const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n    const e = max(smoothstep(0.05, 0.12, dz), smoothstep(0.7, 1.1, dn)).mul(oneMinus(smoothstep(fadeNear, fadeFar, z0)));\n    const c0 = mix(colorTex.rgb, inkColor, e);\n    const p = floor(uv().mul(screenSize));\n    const grain = hash(p.x.add(p.y.mul(1571))).sub(0.5).mul(0.03);\n    const vig = oneMinus(length(uv().sub(0.5)).mul(0.62).pow(2.2));\n    return vec4(c0.add(grain).mul(vig), 1);\n  })();\n  const clock = new THREE.Clock();\n  await renderer.setAnimationLoop(() => { post.render(); S.frames++; });\n  S.boot = 'running';\n}\nwindow.addEventListener('error', (e) => S.errors.push(String(e.message)));\nboot().catch((e) => { S.boot = 'failed'; S.errors.push(String(e && e.stack || e)); });\nEOF\ncat > buildlook.mjs <<'EOF'\nimport { build } from 'esbuild';\nimport { writeFileSync } from 'node:fs';\nconst r = await build({ entryPoints: ['src/look.js'], bundle: true, format: 'iife', target: 'es2022', minify: true, write: false, logLevel: 'warning', legalComments: 'none' });\nwriteFileSync('look.html', `<!doctype html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;overflow:hidden;background:#000}canvas{display:block}</style></head><body><script>${r.outputFiles[0].text.replace(/<\\/script/gi,'<\\\\/script')}</script></body></html>`);\nEOF\ncat > shot3.mjs <<'EOF'\nimport { chromium } from 'playwright';\nimport { pathToFileURL } from 'node:url';\nimport { resolve } from 'node:path';\nconst [,, pal = 'golden'] = process.argv;\nconst b = await chromium.launch({ headless: true, args: ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader'] });\nconst p = await b.newPage({ viewport: { width: 1600, height: 900 } });\nconst logs = [];\np.on('console', (m) => { if (m.type() === 'error' || m.type() === 'warning') logs.push(`[${m.type()}] ${m.text().slice(0, 300)}`); });\np.on('pageerror', (e) => logs.push(`[pageerror] ${String(e).slice(0, 400)}`));\nawait p.goto(pathToFileURL(resolve('look.html')).href + `?pal=${pal}`);\nawait p.waitForFunction(() => window.__spike && (window.__spike.frames > 3 || window.__spike.boot === 'failed'), null, { timeout: 90000 });\nawait p.waitForTimeout(1500);\nconsole.log(pal, JSON.stringify(await p.evaluate(() => window.__spike)));\nawait p.screenshot({ path: `look-${pal}.png` });\nconsole.log(logs.slice(0, 8).join('\\n'));\nawait b.close();\nEOF\nnode buildlook.mjs && node shot3.mjs golden 2>&1 | tail -6","description":"Render a look-development scene of the cast and props","timeout":180000}},"wire_ingest_context":{"toolu_01SFfQCkTrHGgrqc5wgEVmUj":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/spike"}}}
