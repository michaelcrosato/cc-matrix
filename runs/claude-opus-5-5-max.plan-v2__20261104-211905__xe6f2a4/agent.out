  later(t.countdownMs, () => {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:335:    later(t.countdownMs + limitMs, timeUp);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:342:    toPresent({ type: 'time-up', graceMs: t.graceMs });\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:343:    later(t.graceMs, () => {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:485:      later(t.helloMs, sitOut((s) => !s.hello));\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:76:const playMs = Number(params.get('play')) || 6000;\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:192:    limitMs,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:429:    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:456:    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:465:    await randomly(Math.min(1500, playMs / 4));\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:479:    await randomly(playMs / 2);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:497:    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n---\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:115: * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/harness.html:211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n---\n  }\n}\n```\n\nHere is the part worth knowing: **the filter rails are not declared anywhere.**\nThey are read off whatever the games actually carry. Fill in `model` on a few\ngames and a Model rail appears on the wall by itself; remove them and it goes.\nAny field works, including ones invented on the spot. A game can also carry its\nown, with `<meta name=\"hub:model\" content=\"…\">` in its head. A field whose\nvalues are nearly all different (a build id, a URL) is searchable but never\nbecomes a rail. Every field is searchable. `harness` is searched and shown in\nthe drawer but never gets a rail, and neither do `source` and `series`, which\nhave Original, Inspired and the stacks.\n\n`collection` comes from the folder a game sits in, but it is an ordinary field:\nan override, or a `hub:collection` meta, replaces it.\n\nThe library's own catalogue uses these fields, all in `data/overrides.json`:\n\n| Field | What it is | On the wall |\n|---|---|---|\n| `genre` | one of a fixed list (Racing, Platformer, Life Sim, Tech Demo…) | the Genre rail, and the cabinet's panel |\n| `type` | `Game`, `Tech demo` or `Tool` | the shelf: games, or tech demos & tools |\n| `tags` | 2–5 from a fixed vocabulary (`3d`, `retro`, `co-op`, `touch`…) | the Tags rail |\n| `players` | `1–2`, `1–4`… only when a game has co-op or versus | the Players rail: *Single player*, or *Multiplayer*, which drops a menu of head counts (*4 players* finds every game that seats four). A game with no `players` is single player |\n| `source` | the classic a game riffs on, as it is titled (`Dragon Quest IX`); none for an original | Original or Inspired, the stacks, the drawer, and search |\n| `series` | the franchise, only when it is not the source itself (`Dragon Quest` for `Dragon Quest IX`) | the stacks |\n| `controls` | a one-line summary | the drawer |\n| `description` | one or two plain sentences | the drawer |\n\nEvery game with the same `source` must have the same `series`; `pnpm test`\nchecks. A game can name its own source with `<meta name=\"hub:source\">`\n(`hub:inspired-by`, the older name, still works). Source leads the rail strip.\nGenre, Collection, Type and Players follow it when they exist; the\nrest follow by how many games carry them. `docs/curation-2026-09-24.md`\n---\n    const meta = (name) => html.match(new RegExp(`<meta\\\\s+name=[\"']${name}[\"']\\\\s+content=[\"']([^\"']+)[\"']`, 'i'))?.[1] ?? null;\n    const [least = 1, most = least] = (meta('hub:session-players')?.match(/\\d+/g) ?? []).map(Number);\n    return { mode: modeOf(meta('hub:session-mode')), seats: [least, most] };\n  } catch {\n    return { mode: null, seats: [1, 4] };\n  }\n}\n\nlet chromium;\ntry {\n  ({ chromium } = createRequire(import.meta.url)('playwright'));\n} catch {\n  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n  process.exit(2);\n}\n\n/**\n * Runs in every frame before its own scripts: it notes what the page asks of\n * the graphics stack, and session-mode pages are watched for dialogs and sockets.\n */\nfunction watch() {\n  // What the page asked of the graphics stack: a WebGPU adapter it never got, and\n  // no WebGL drawing instead, means this browser cannot run it (a title screen may still show).\n  const gfx = (window.__gfx = { askedForWebGPU: false, gotAdapter: false, webgl: false, twoD: false });\n  if (navigator.gpu?.requestAdapter) {\n    const ask = navigator.gpu.requestAdapter.bind(navigator.gpu);","is_error":false}]},"parent_tool_use_id":null,"session_id":"19307802-7215-43fb-a84b-6c94bbc636c5","uuid":"605eda0d-7699-45a5-943d-00e61fa78ffb","timestamp":"2026-11-05T04:30:03.412Z","tool_use_result":{"stdout":"bridge.js\ncheck3d.py\nexamples\nharness.html\nhub-check.mjs\nmultiplayer-plan.md\nroot-CLAUDE.md\nroot-README.md\nround.js\nsession.js\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:15:export const TIMINGS = Object.freeze({\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:16:  helloMs: 10_000,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:20:  countdownMs: 3_000,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:21:  graceMs: 5_000,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/hub/round.js:61:export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = 