()) scene.attach(d.J[name]);\n  made.head.applyImpulse({ x: 0.2 * Math.sign(vel.x || 1), y: 0, z: 0 }, true);\n  d.ragdoll = made;\n}\nfunction syncRagdoll(d) { for (const [name, b] of Object.entries(d.ragdoll)) { const t = b.translation(), r = b.rotation(); d.J[name].position.set(t.x, t.y, t.z); d.J[name].quaternion.set(r.x, r.y, r.z, r.w); } }\nfunction endRagdoll(world, d) { for (const b of Object.values(d.ragdoll)) world.removeRigidBody(b); d.ragdoll = null; for (const [name] of SEGS) { const g = d.J[name]; g.userData.parent.add(g); g.position.copy(g.userData.rest); g.quaternion.identity(); } }\n\n// ---- the event: Fruit Hat, written for lanes\nconst DOLLBITS = (i) => ((0x0100 << i) << 16) | (0x0010 << i), PROPBITS = (i) => ((0x0010 << i) << 16) | (0x0100 << i) | (0x0010 << i) | 0x0001, GROUNDBITS = (0x0001 << 16) | 0x10f0;\nconst SEATS = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700];\nconst up = (b) => { const q = b.rotation(); return { x: 2 * (q.x * q.y - q.w * q.z), y: 1 - 2 * (q.x * q.x + q.z * q.z), z: 2 * (q.y * q.z + q.w * q.x) }; };\nclass FruitHat {\n  constructor({ lanes, seconds = 60, god = false, par = 34 }) {\n    this.seconds = seconds; this.god = god; this.par = par; this.t = 0; this.done = false; this.running = true; this.group = new THREE.Group(); scene.add(this.group);\n    const w = (this.world = new RAPIER.World({ x: 0, y: -9.81, z: 0 })); w.timestep = 1 / 120; w.integrationParameters.numSolverIterations = 8;\n    w.createCollider(RAPIER.ColliderDesc.cuboid(40, 0.5, 40).setTranslation(0, -0.5, 0).setFriction(0.9).setCollisionGroups(GROUNDBITS));\n    this.lanes = lanes.map((spec, i) => this.makeLane(spec, i, lanes.length));\n    this.baseline = w.bodies.len();\n  }\n  makeLane(spec, i, n) {\n    const x = (i - (n - 1) / 2) * 3.2, lane = { ...spec, id: i, x, raw: 0, banks: 0, falls: 0, fruit: [], pending: [], busy: 0, flailLeft: 0, flailCd: 0, fallen: 0, wishX: 0, wishZ: 0, next: 0.5, peak: 0, ghostTo: null };\n    lane.doll = makeDoll(spec.colour ?? SEATS[i % 4]); lane.doll.root.position.set(x, 0, 0); this.group.add(lane.doll.root);\n    const hat = new THREE.Group(); hat.position.y = 1.5; hat.add(shadowed(new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.3, 0.05, 24), toon(0xd9a86c)))); const rim = shadowed(new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.035, 8, 28).rotateX(Math.PI / 2), toon(0xa8703f))); rim.position.y = 0.16; hat.add(rim); lane.doll.root.add(hat); lane.hat = hat;\n    if (spec.kind === 'ghost') return lane;\n    const w = this.world; lane.foot = w.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, 0, 0));\n    const c = createCore(RAPIER, w, lane.foot, x, 0, 0, i, DOLLBITS, T.margin, 0.4);\n    Object.assign(lane, { body: c.body, s: { body: c.body, G: c.G, K: c.K, D: c.D, I: c.I, wx: 0, wz: 0, reflex: 10, dt: 1 / 120, wishX: 0, wishZ: 0, maxLean: 18 * Math.PI / 180, leanX: 0, leanZ: 0, ankleMax: T.ankleMax, flailLeft: 0, flailBoost: 1.9, sway: 0.03, tremor: 0.02, t: 0, ph: 1 + i } });\n    w.createCollider(RAPIER.ColliderDesc.cylinder(0.02, 0.36).setTranslation(0, 0.75, 0).setMass(0.01).setFriction(0.9).setCollisionGroups(DOLLBITS(i)), c.body);\n    for (let k = 0; k < 8; k++) { const a = (k / 8) * Math.PI * 2; w.createCollider(RAPIER.ColliderDesc.cuboid(0.02, 0.1, 0.16).setTranslation(Math.cos(a) * 0.36, 0.85, Math.sin(a) * 0.36).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }).setMass(0.001).setCollisionGroups(DOLLBITS(i)), c.body); }\n    lane.r = rng('fruit');\n    return lane;\n  }\n  retune() { for (const l of this.lanes) if (l.s) { const G = l.s.G, I = l.s.I, K = G * (1 + T.margin), wn = Math.sqrt((K - G) / I); l.s.K = K; l.s.D = 2 * 0.4 * wn * I; l.s.ankleMax = T.ankleMax * (this.god ? 3 : 1); } }\n  held(l) { if (l.fallen > 0) return []; const b = l.body, bp = b.translation(), u = up(b), top = { x: bp.x + u.x * 0.75, y: bp.y + u.y * 0.75, z: bp.z + u.z * 0.75 }; return l.fruit.filter((f) => { const p = f.body.translation(), v = f.body.linvel(); return Math.hypot(p.x - top.x, p.z - top.z) < 0.36 && p.y > top.y - 0.05 && p.y < top.y + 0.6 && Math.hypot(v.x, v.y, v.z) < 2.5; }); }\n  removeFruit(l, f) { this.world.removeRigidBody(f.body); this.group.remove(f.mesh); l.fruit.splice(l.fruit.indexOf(f), 1); }\n  spawnFruit(l) { const r = l.r, a = r() * Math.PI * 2, rr = 0.45 * Math.sqrt(r()), lx = Math.cos(a) * rr, lz = Math.sin(a) * rr, TF = 1.5, sx = lx * 0.3, sz = -7, sy = 0.5, ey = 1.75; const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(l.x + sx, sy, sz).setCcdEnabled(true).setLinvel((lx - sx) / TF, (ey - sy + 0.5 * 9.81 * TF * TF) / TF, (lz - sz) / TF)); this.world.createCollider(RAPIER.ColliderDesc.ball(0.075).setMass(T.fruitMass).setRestitution(0.1).setFriction(0.8).setCollisionGroups(PROPBITS(l.id)), b); const mesh = shadowed(new THREE.Mesh(new THREE.SphereGeometry(0.075, 12, 10), toon(0xf08a24))); this.group.add(mesh); l.fruit.push({ body: b, mesh }); l.pending.push({ x: lx, z: lz, at: this.t + TF - 0.95, until: this.t + TF + 0.2 }); }\n  want(l) { const p = l.pending.find((q) => this.t >= q.at + (l.botLag || 0) && this.t <= q.until); return p ? { x: Math.max(-1, Math.min(1, Math.asin(Math.max(-1, Math.min(1, p.x / 1.5))) / l.s.maxLean)), y: Math.max(-1, Math.min(1, Math.asin(Math.max(-1, Math.min(1, p.z / 1.5))) / l.s.maxLean)) } : { x: 0, y: 0 }; }\n  control(l) {\n    if (l.kind === 'bot') { const w = this.want(l); return { wx: w.x, wy: w.y, hop: this.held(l).length >= (l.bankAt ?? 7), flail: l.s && Math.hypot(l.s.leanX, l.s.leanZ) > 32 * Math.PI / 180 }; }\n    if (l.player === 'kbm') return input.kbm; if (typeof l.player === 'number') return input.players[l.player] || {}; return input.cur || {};\n  }\n  fixed(dt) {\n    if (!this.running) return;\n    this.t += dt;\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      if (this.t < this.seconds && this.t >= l.next && l.fallen <= 0) { l.next = this.t + T.fruitEvery; this.spawnFruit(l); }\n      const c = this.control(l), was = l.was || {};\n      if (l.fallen > 0) { l.fallen -= dt; syncRagdoll(l.doll); if (l.fallen <= 0) { endRagdoll(this.world, l.doll); l.body.setEnabled(true); l.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true); l.body.setTranslation({ x: l.x, y: 0.75, z: 0 }, true); l.body.setLinvel({ x: 0, y: 0, z: 0 }, true); l.body.setAngvel({ x: 0, y: 0, z: 0 }, true); l.s.wx = l.s.wz = 0; l.next = this.t + 1; } l.was = c; continue; }\n      l.s.wishX = c.wx || 0; l.s.wishZ = c.wy || 0;\n      if (c.hop && !was.hop && l.busy <= 0) { const h = this.held(l); if (h.length) { l.raw += h.length * (1 + 0.1 * (h.length - 1)); l.banks++; for (const f of h) this.removeFruit(l, f); l.busy = 1; sfx('bank'); } }\n      if (c.flail && !was.flail && l.flailCd <= 0) { l.s.flailLeft = 0.35; l.flailCd = 2; playClip(l.doll, 'flail'); }\n      l.busy -= dt; l.flailCd -= dt; l.s.flailLeft = Math.max(0, l.s.flailLeft - dt); if (l.s.flailLeft <= 0 && l.doll.cur === 'flail') playClip(l.doll, 'idle');\n      l.s.ankleMax = T.ankleMax * (this.god ? 3 : 1);\n      stepCore(l.s); l.s.t += dt;\n      l.was = c;\n    }\n    this.world.step();\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost' || l.fallen > 0) continue;\n      const lean = Math.hypot(l.s.leanX, l.s.leanZ); l.peak = Math.max(l.peak, lean); if (!Number.isFinite(lean)) G.errors.push('NaN lean');\n      if (lean > (45 * Math.PI) / 180 && !this.god) { l.falls++; l.fallen = 2.2; const v = l.body.linvel(); l.body.setEnabled(false); spawnRagdoll(this.world, l.doll, v); for (const f of [...l.fruit]) this.removeFruit(l, f); l.pending.length = 0; sfx('clack'); }\n      for (const f of [...l.fruit]) if (f.body.translation().y < 0.3) this.removeFruit(l, f);\n      l.pending = l.pending.filter((p) => this.t <= p.until);\n    }\n    if (this.t >= this.seconds && !this.done) { this.done = true; for (const l of this.lanes) if (l.kind !== 'ghost') { const h = this.held(l).length; l.raw += h * 0.5; } }\n  }\n  frame(dt) {\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') { if (l.ghostTo) { const k = 1 - Math.exp(-dt * 7), g = l.ghostTo; l.gx = (l.gx ?? l.x) + (g.x - (l.gx ?? l.x)) * k; l.glx = (l.glx ?? 0) + (g.lx - (l.glx ?? 0)) * k; l.glz = (l.glz ?? 0) + (g.lz - (l.glz ?? 0)) * k; const a = Math.hypot(l.glx, l.glz) || 1e-9, s = Math.sin(a / 2); l.doll.root.quaternion.set((l.glz / a) * s, 0, (-l.glx / a) * s, Math.cos(a / 2)); } l.doll.mixer.update(dt); continue; }\n      if (l.fallen > 0) continue;\n      l.doll.mixer.update(dt); const r = l.body.rotation(); l.doll.root.quaternion.set(r.x, r.y, r.z, r.w); l.hat.visible = true;\n      for (const f of l.fruit) { const t = f.body.translation(); f.mesh.position.set(t.x, t.y, t.z); }\n    }\n  }\n  form(l) { return Math.max(0, Math.min(100, (100 * l.raw) / this.par)); }\n  dispose() { for (const l of this.lanes) { if (l.doll.ragdoll) endRagdoll(this.world, l.doll); } scene.remove(this.group); this.world.free(); this.world = null; }\n}\n\n// ---- screens\nconst medal = (f) => (f >= 97 ? 'Suspicious' : f >= 85 ? 'Exemplary' : f >= 65 ? 'Pleasant' : f >= 40 ? 'Adequate' : 'Attended');\nlet menu = null;\nfunction div(cls, text, parent = ui) { const d = document.createElement('div'); d.className = cls; if (text !== undefined) d.textContent = text; parent.append(d); return d; }\nfunction makeMenu(items) {\n  const box = div('menu'); menu = { items, i: 0, els: [] };\n  items.forEach((it, idx) => { const el = div('item', undefined, box); const lab = document.createElement('span'); lab.textContent = it.label(); el.append(lab); if (it.slider) { const bar = document.createElement('span'); bar.className = 'bar'; const fill = document.createElement('i'); bar.append(fill); el.append(bar); it.fill = fill; it.lab = lab; fill.style.width = it.pct() + '%'; el.addEventListener('click', (e) => { const r = bar.getBoundingClientRect(); if (e.clientX >= r.left) { it.setPct(((e.clientX - r.left) / r.width) * 100); drawMenu(); } }); } else { el.addEventListener('click', () => { if (input.touchTap || !G.touchOnly) activate(idx); }); } el.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') { menu.i = idx; drawMenu(); } }); menu.els.push(el); });\n  drawMenu();\n}\nfunction drawMenu() { if (!menu) return; menu.els.forEach((el, i) => { el.classList.toggle('focus', i === menu.i); el.dataset.focused = i === menu.i ? '1' : '0'; const it = menu.items[i]; if (it.slider) { it.lab.textContent = it.label(); it.fill.style.width = it.pct() + '%'; } else el.firstChild.textContent = it.label(); }); }\nfunction activate(i) { const it = menu.items[i]; if (it && it.act) { sfx('ui'); it.act(); } }\nfunction menuInput() {\n  if (!menu) return; const e = input.edge;\n  if (e('up')) { menu.i = (menu.i + menu.items.length - 1) % menu.items.length; drawMenu(); } if (e('down')) { menu.i = (menu.i + 1) % menu.items.length; drawMenu(); }\n  const it = menu.items[menu.i]; if (it && it.slider) { if (e('left')) { it.nudge(-1); drawMenu(); } if (e('right')) { it.nudge(1); drawMenu(); } }\n  if (e('confirm')) activate(menu.i); if (e('back') && G.onBack) G.onBack();\n}\nfunction clearUI() { ui.textContent = ''; menu = null; G.onBack = null; promptList = []; }\nconst sliderItem = (label, get, set, min, max, stp) => ({ slider: true, label: () => `${label} ${(+get().toFixed(3))}`, pct: () => ((get() - min) / (max - min)) * 100, setPct: (p) => set(Math.max(min, Math.min(max, min + (p / 100) * (max - min)))), nudge: (d) => set(Math.max(min, Math.min(max, +(get() + d * stp).toFixed(5)))) });\nconst screens = {\n  title() { clearUI(); const t = div('title', TITLE); t.dataset.title = '1'; if (G.touchOnly) { div('msg', 'Controller or keyboard required'); const box = div('menu'); box.style.top = '62vh'; const el = div('item focus', 'Settings', box); el.dataset.settings = '1'; el.addEventListener('click', () => show('settings')); } else { const pr = div('press'); pr.append('Press '); promptHTML(pr, 'confirm'); pr.dataset.prompts2 = '1'; promptList = [['confirm', '']]; pr.dataset.prompts = '1'; } },\n  menu() { clearUI(); div('title', TITLE); makeMenu([{ label: () => 'Play Fruit Hat', act: () => startEvent([{ kind: 'local' }]) }, { label: () => 'Group Class', act: () => show('group') }, { label: () => 'Journal', act: () => show('journal') }, { label: () => 'Settings', act: () => show('settings') }, { label: () => 'About/Credits', act: () => show('about') }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('title'); },\n  journal() { clearUI(); const p = div('page'); const h = document.createElement('h2'); h.textContent = 'Journal'; p.append(h); const r = document.createElement('p'); r.textContent = `Classes: ${save.runs}. Best: ${save.best.toFixed(0)}.`; p.append(r); ui.append(promptsBar([['back', 'Back']])); G.onBack = () => show('menu'); },\n  group() { clearUI(); div('title', 'Group Class'); G.joined = []; const m = div('msg', 'Press to join'); m.dataset.join = '1'; G.groupTick = () => { input.players.forEach((p, i) => { if (p.confirm && !G.joined.includes(i)) G.joined.push(i); }); if (input.edge('confirm') && input.last === 'kbm' && !G.joined.includes('kbm')) G.joined.push('kbm'); m.textContent = `Joined: ${G.joined.length}`; if (G.joined.length && input.edge('pause')) startEvent(G.joined.map((j) => ({ kind: 'local', player: j }))); }; ui.append(promptsBar([['confirm', 'Join'], ['pause', 'Start'], ['back', 'Back']])); G.onBack = () => { G.groupTick = null; show('menu'); }; },\n  settings() { const back = G.settingsBack || (G.touchOnly ? 'title' : 'menu'); clearUI(); makeMenu([sliderItem('Music', () => settings.music, (v) => { settings.music = v; applyVolumes(); saveSettings(); }, 0, 100, 5), sliderItem('Sound', () => settings.sfx, (v) => { settings.sfx = v; applyVolumes(); saveSettings(); }, 0, 100, 5), sliderItem('Voice', () => settings.voice, (v) => { settings.voice = v; applyVolumes(); saveSettings(); }, 0, 100, 5), { label: () => `Glyphs: ${settings.glyphs === 'ps' ? 'PlayStation' : 'Xbox'}`, act: () => { settings.glyphs = settings.glyphs === 'ps' ? 'xb' : 'ps'; saveSettings(); drawMenu(); refreshPrompts(); } }, { label: () => 'Back', act: () => show(back) }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show(back); },\n  about() { clearUI(); const pages = aboutPages(); let i = 0; const p = div('page'); const draw = () => { p.textContent = ''; const h = document.createElement('h2'); h.textContent = pages[i].title; p.append(h); for (const line of pages[i].lines) { const r = document.createElement('p'); r.textContent = line; p.append(r); } }; draw(); G.aboutPage = () => i; G.aboutNext = () => { i = (i + 1) % pages.length; draw(); }; G.aboutAll = () => pages.map((x) => x.lines.join(' ')).join(' '); makeMenu([{ label: () => 'Next page', act: () => G.aboutNext() }, { label: () => 'Back', act: () => show('menu') }]); const b = ui.querySelector('.menu'); b.style.top = 'auto'; b.style.bottom = '12vh'; b.style.flexDirection = 'row'; ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('menu'); },\n  pause() { clearUI(); div('title', 'Paused'); makeMenu([{ label: () => 'Resume', act: () => show('event') }, { label: () => 'Restart', act: () => startEvent(G.lastSpec) }, { label: () => 'Settings', act: () => { G.settingsBack = 'pause'; show('settings'); G.settingsBack = null; } }, { label: () => 'Dev Mode', act: () => show('dev') }, { label: () => 'Leave Class', act: () => { endEvent(); show('menu'); } }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Resume']])); G.onBack = () => show('event'); },\n  dev() { clearUI(); makeMenu([...TUNING.slice(0, 3).map((t) => sliderItem(t.label, () => T[t.key], (v) => { T[t.key] = v; G.event && G.event.retune(); }, t.min, t.max, t.step)), { label: () => `God mode: ${G.god ? 'on' : 'off'}`, act: () => { G.god = !G.god; if (G.event) { G.event.god = G.god; G.event.retune(); } drawMenu(); } }, { label: () => 'Reset to Defaults', act: () => { resetTuning(); G.event && G.event.retune(); drawMenu(); } }, { label: () => 'Back', act: () => show('pause') }]); ui.append(promptsBar([['confirm', 'Select'], ['back', 'Back']])); G.onBack = () => show('pause'); },\n  event() { clearUI(); div('score', '0').dataset.score = '1'; div('time', '60').dataset.time = '1'; ui.append(makeDisc()); ui.append(promptsBar([['weight', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail'], ['pause', 'Pause']])); },\n  results() { clearUI(); const f = G.lastForm; const t = div('tag'); const h = document.createElement('h2'); h.textContent = 'Fruit Hat'; t.append(h); const s = document.createElement('div'); s.className = 'stamp'; s.textContent = medal(f); s.dataset.medal = medal(f); t.append(s); const n = document.createElement('div'); n.textContent = `Form ${f.toFixed(0)}. Floor Exercises: ${G.lastFalls}.`; t.append(n); makeMenu([{ label: () => 'Continue', act: () => show('menu') }]); ui.querySelector('.menu').style.top = '60vh'; ui.append(promptsBar([['confirm', 'Continue']])); G.onBack = () => show('menu'); },\n  attract() { clearUI(); div('demo', 'DEMO · Press any button'); },\n};\nfunction aboutPages() { const s = ABOUT.sourceInformation, L = (k, v) => `${k}: ${v}`; return [{ title: 'Source Information', lines: [L('Date', s.date), L('Source', s.source), L('Plan', s.plan), L('Genre', s.genre), L('Perspective', s.perspective)] }, { title: 'Source Information', lines: [L('Tech', s.tech), L('Art Direction', s.artDirection), L('Animation', s.animation), L('Audio', s.audio), L('Online', s.online)] }, { title: 'Source Information', lines: [L('Testing', s.testing), L('Research', s.research), L('Environment', s.environment), L('Model', s.model), L('Usage', s.usage)] }, { title: 'Testing Feedback', lines: ABOUT.testingFeedback }, { title: 'Engine Feedback', lines: ABOUT.engineFeedback }, { title: 'Prompt Feedback', lines: ABOUT.promptFeedback }, { title: 'Credits', lines: ['Three.js, Rapier', 'Fredoka, SIL Open Font License'] }]; }\nfunction show(name) { G.screen = name; G.idle = 0; screens[name](); }\n// the Balance Disc, as inline SVG moved by transforms\nlet disc = null;\nfunction makeDisc() { const ns = 'http://www.w3.org/2000/svg', svg = document.createElementNS(ns, 'svg'); svg.setAttribute('viewBox', '-110 -110 220 220'); svg.setAttribute('class', 'disc'); svg.dataset.disc = '1'; const circle = (r, fill, stroke, w) => { const c = document.createElementNS(ns, 'circle'); c.setAttribute('r', r); c.setAttribute('fill', fill); c.setAttribute('stroke', stroke); c.setAttribute('stroke-width', w); svg.append(c); return c; }; circle(100, '#fdf3e0', '#1a1420', 8); circle(50, 'none', '#1a142055', 3); const ask = circle(14, 'none', '#1a1420aa', 4), dot = circle(16, '#e8443a', '#1a1420', 5); disc = { svg, ask, dot }; return svg; }\nfunction updateDisc(l) { if (!disc || !l.s) return; const c = { x: l.s.leanX / l.s.maxLean, y: l.s.leanZ / l.s.maxLean }; disc.dot.setAttribute('transform', `translate(${c.x * 100} ${c.y * 100})`); disc.ask.setAttribute('transform', `translate(${l.s.wishX * 100} ${l.s.wishZ * 100})`); }\n\n// ---- flow\nfunction endEvent() { if (G.event) { G.event.dispose(); G.event = null; } }\nfunction startEvent(spec, opts = {}) { endEvent(); G.lastSpec = spec; G.event = new FruitHat({ lanes: spec, god: G.god, ...opts }); G.event.retune(); show('event'); }\nfunction finishEvent() { const e = G.event, l = e.lanes.find((x) => x.kind !== 'ghost' && x.kind !== 'bot') || e.lanes[0]; G.lastForm = e.form(l); G.lastFalls = l.falls; G.lastRaw = l.raw; G.lastBanks = l.banks; save.runs++; save.best = Math.max(save.best, l.raw); writeSave(); endEvent(); show('results'); }\nconst ATTRACT = [{ lanes: [{ kind: 'bot', bankAt: 12 }] }, { lanes: [{ kind: 'bot', bankAt: 5 }, { kind: 'bot', bankAt: 7 }, { kind: 'bot', bankAt: 9 }, { kind: 'bot', bankAt: 4 }] }];\nfunction startAttract() { G.attract = true; G.attractI = 0; G.attractT = 0; G.attractSeen = 0; show('attract'); attractNext(); }\nfunction attractNext() { endEvent(); const v = ATTRACT[G.attractI % ATTRACT.length]; G.attractI++; G.attractSeen++; G.event = new FruitHat({ lanes: v.lanes, god: true, seconds: 600 }); G.event.retune(); G.attractT = 0; }\nfunction stopAttract() { G.attract = false; endEvent(); input.anyEvent = false; input.mouseMovedPx = 0; input.ignore = true; show('title'); }\nfunction fixed(dt) {\n  G.simT += dt; if (window.__botHook) window.__botHook(); pollInput(dt);\n  const s = G.session; if (s) { sessionFixed(s, dt); input.anyEvent = false; input.mouseMovedPx = 0; return; }\n  if (G.attract) { if (anyExitInput()) { stopAttract(); return; } G.attractT += dt; if (G.attractT > 18) { if (G.attractI % ATTRACT.length === 0) { endEvent(); G.attract = 'pause'; G.attractT = 0; show('title'); } else attractNext(); } if (G.event) G.event.fixed(dt); input.anyEvent = false; input.mouseMovedPx = 0; return; }\n  if (input.ignore) { if (!Object.keys(input.cur).some((k) => input.cur[k] === true) ) input.ignore = false; input.anyEvent = false; input.mouseMovedPx = 0; if (input.ignore) return; }\n  if (G.screen === 'title' || G.screen === 'menu') { if (anyExitInput()) G.idle = 0; else G.idle += dt; if (G.idle >= 10) { input.anyEvent = false; startAttract(); return; } }\n  input.anyEvent = false; input.mouseMovedPx = 0; input.touchTap = false;\n  switch (G.screen) {\n    case 'title': if (!G.touchOnly && (input.edge('confirm') || input.edge('clickL'))) show('menu'); break;\n    case 'event': { const e = G.event; if (!e) break; e.fixed(dt); if (input.edge('pause')) { show('pause'); break; } if (e.t >= e.seconds + 1.5) finishEvent(); break; }\n    case 'group': if (G.groupTick) G.groupTick(); menuInput(); if (input.edge('back') && G.onBack) G.onBack(); break;\n    case 'journal': case 'about': case 'settings': case 'menu': case 'pause': case 'dev': case 'results': menuInput(); if (!menu && input.edge('back') && G.onBack) G.onBack(); break;\n    default: break;\n  }\n}\nfunction frameLogic(dt) {\n  if (G.event) {\n    G.event.frame(dt); const e = G.event, l = e.lanes.find((x) => x.kind === 'local') || e.lanes[0]; if (G.screen === 'event') { updateDisc(l); const sc = ui.querySelector('[data-score]'), tm = ui.querySelector('[data-time]'); if (sc) sc.textContent = Math.round(l.raw); if (tm) tm.textContent = Math.max(0, Math.ceil(e.seconds - e.t)); }\n    const n = e.lanes.length; camera.position.set(0, 2.6, Math.max(8.5, ((n - 1) * 1.6 + 2.5) / Math.tan((38 * Math.PI) / 360) / (camera.aspect || 1.7))); camera.lookAt(0, 1.25, 0);\n  }\n  pumpMusic();\n}\nfunction frame() { const now = performance.now(), real = Math.min((now - (G.last || now)) / 1000, 0.1); G.last = now; G.acc = (G.acc || 0) + real; let n = 0; while (G.acc >= 1 / 120 && n < 12) { fixed(1 / 120); G.acc -= 1 / 120; n++; } if (n === 12) G.acc = 0; frameLogic(real); if (ink) { ink.post.render(); } G.frames++; }\n\n// ---- AI Hub session, per the plan\nconst SLOT = { intro: 6, play: 50, score: 6 }, SLOTLEN = 62, SLOTS = 3;\nfunction runSession(info) {\n  const s = (G.session = { info, slot: -1, total: 0, current: 0, reported: false, ended: false, lastSend: 0, lastProgress: -1, ghosts: new Map(), cardAsked: false, stats: { falls: 0 } });\n  for (const p of info.players) if (p.id !== info.me) s.ghosts.set(p.id, { ...p, area: -1, to: null });\n  clearUI(); G.screen = 'card';\n  const card = div('tag'); card.dataset.card = '1'; const h = document.createElement('h2'); h.textContent = TITLE; card.append(h); const goal = document.createElement('div'); goal.textContent = 'Stay balanced through the class: highest score wins'; card.append(goal); const ctr = document.createElement('div'); ctr.textContent = 'Lean: stick, WASD or mouse. Bank: Cross, Space.'; card.append(ctr); const left = document.createElement('div'); left.dataset.left = '1'; card.append(left); const names = div('names'); s.nameEls = {};\n  for (const p of info.players) { const el = document.createElement('span'); el.style.color = p.color; el.textContent = p.name; names.append(el); s.nameEls[p.id] = el; }\n  ui.append(promptsBar([['confirm', 'Ready'], ['more', 'More time']]));\n  card.addEventListener('click', () => AIHub.answer('ready'));\n  AIHub.on('card', (c) => { left.textContent = c.starting ? 'Starting...' : c.paused ? 'Paused' : c.left != null ? `Starting in ${Math.ceil(c.left / 1000)}` : ''; for (const p of info.players) if (s.nameEls[p.id]) s.nameEls[p.id].textContent = p.name + ((c.ready || []).includes(p.id) ? ' ✓' : ''); });\n  AIHub.on('start', () => { clearUI(); G.screen = 'session'; ui.append(makeDisc()); div('score', '0').dataset.score = '1'; const c = div('time', ''); c.dataset.time = '1'; ui.append(promptsBar([['weight', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail']])); });\n  AIHub.on('message', (data, from) => { const g = s.ghosts.get(from); if (!g || !data || data.t !== 'g') return; g.area = data.a; g.to = data; const e = G.event; if (e) { const l = e.lanes.find((x) => x.kind === 'ghost' && x.pid === from); if (l && data.a === s.slot) { l.ghostTo = { x: l.x, lx: data.lx, lz: data.lz }; l.doll.root.visible = true; } else if (l) l.doll.root.visible = false; } });\n  AIHub.on('leave', ({ id }) => { s.ghosts.delete(id); const e = G.event; if (e) { const l = e.lanes.find((x) => x.kind === 'ghost' && x.pid === id); if (l) l.doll.root.visible = false; } });\n  AIHub.on('time-up', () => sessionResult(s));\n  AIHub.on('end', () => { s.ended = true; if (audio.ctx) audio.ctx.suspend().catch(() => {}); });\n  addEventListener('keydown', (e) => { if (AIHub.time() === -Infinity) { if (e.key === 'Enter') AIHub.answer('ready'); if (e.key === 'm' || e.key === 'M') AIHub.answer('more'); } });\n  G.event = new FruitHat({ lanes: sessionLanes(s), seconds: SLOT.play, par: 28 }); G.event.running = false; G.event.retune();\n  AIHub.ready();\n}\nfunction sessionLanes(s) { const lanes = [{ kind: 'local', colour: parseInt((s.info.players.find((p) => p.id === s.info.me) || { color: '#e8443a' }).color.slice(1), 16) }]; for (const [id, g] of s.ghosts) lanes.push({ kind: 'ghost', pid: id, colour: parseInt(g.color.slice(1), 16) }); return lanes; }\nfunction sessionResult(s) { if (s.reported) return; s.reported = true; const score = Math.round(s.total + s.current); AIHub.result({ score, stats: { 'Floor Exercises': s.stats.falls }, awards: score > 0 ? [{ title: 'Suspiciously Still', detail: 'Barely moved' }] : [] }); }\nfunction sessionFixed(s, dt) {\n  if (s.ended) return; const T0 = AIHub.time();\n  if (T0 === -Infinity) { if (input.players[0] && input.edge('confirm')) AIHub.answer('ready'); if (input.players[0] && input.edge('tri')) AIHub.answer('more'); return; }\n  const tm = ui.querySelector('[data-time]'); if (T0 < 0) { if (tm) tm.textContent = Math.ceil(-T0 / 1000); return; }\n  const slot = Math.min(SLOTS - 1, Math.floor(T0 / 1000 / SLOTLEN)), inSlot = T0 / 1000 - slot * SLOTLEN;\n  if (slot !== s.slot) { if (s.slot >= 0 && G.event) { const l = G.event.lanes[0]; s.total += Math.round(G.event.form(l) * 10); s.stats.falls += l.falls; s.current = 0; G.event.dispose(); G.event = new FruitHat({ lanes: sessionLanes(s), seconds: SLOT.play, par: 28 }); G.event.retune(); } s.slot = slot; }\n  const e = G.event; e.running = inSlot >= SLOT.intro && inSlot < SLOT.intro + SLOT.play + 0.5; if (e.running) e.fixed(dt); const me = e.lanes[0]; s.current = Math.round(e.form(me) * 10);\n  if (tm) tm.textContent = inSlot < SLOT.intro ? 'Next class' : Math.max(0, Math.ceil(SLOT.intro + SLOT.play - inSlot));\n  const sc = ui.querySelector('[data-score]'); if (sc) sc.textContent = s.total + s.current;\n  if (T0 - s.lastSend > 100) { s.lastSend = T0; AIHub.send({ t: 'g', a: s.slot, x: +me.x.toFixed(2), z: 0, lx: +(me.s.leanX || 0).toFixed(3), lz: +(me.s.leanZ || 0).toFixed(3), c: 0, f: me.fallen > 0 ? 1 : 0, s: s.total + s.current }, { reliable: false }); }\n  if (T0 - s.lastProgress > 1000) { s.lastProgress = T0; AIHub.progress({ score: s.total + s.current, label: `Fruit Hat ${s.total + s.current}` }); }\n  if (!s.reported && T0 / 1000 >= SLOTS * SLOTLEN) sessionResult(s);\n}\n\n// ---- test hooks\nfunction installHooks() {\n  window.__GAME__ = TITLE;\n  window.__TEST__ = {\n    state() { const e = G.event; return { screen: G.screen, attract: !!G.attract, attractSeen: G.attractSeen || 0, idle: G.idle, simT: G.simT, save: { ...save }, event: e ? { t: e.t, seconds: e.seconds, baseline: e.baseline, bodies: e.world.bodies.len(), lanes: e.lanes.map((l) => ({ kind: l.kind, id: l.id, leanX: l.s ? l.s.leanX : 0, leanZ: l.s ? l.s.leanZ : 0, wishX: l.s ? l.s.wishX : 0, wishZ: l.s ? l.s.wishZ : 0, falls: l.falls, raw: l.raw, banks: l.banks, fallen: l.fallen, peak: l.peak, fruit: l.fruit.length, hx: l.body ? l.body.translation().x : 0, ankle: l.s ? l.s.ankleMax : 0, K: l.s ? l.s.K : 0, clip: l.doll.cur, mixerT: l.doll.mixer.time, ragdoll: !!l.doll.ragdoll, hipsParent: l.doll.J.hips.parent && l.doll.J.hips.parent.name, hipsY: l.doll.J.hips.position.y })) } : null, input: { lastDevice: input.last, glyphSet: glyphSet(), ring: { ...input.ring } }, audio: { state: audio.ctx ? audio.ctx.state : 'none', music: settings.music, musicGain: audio.ctx ? audio.music.gain.value : null }, render: { backend: G.backend, frames: G.frames, revision: THREE.REVISION, rapier: RAPIER.version() }, tuning: { ...T }, god: G.god, last: { form: G.lastForm, falls: G.lastFalls, raw: G.lastRaw, banks: G.lastBanks }, menu: menu ? { i: menu.i, n: menu.items.length, label: menu.items[menu.i].label() } : null, errors: G.errors, touchOnly: G.touchOnly }; },\n    advance(sec) { const n = Math.round(sec * 120); for (let i = 0; i < n; i++) { fixed(1 / 120); if (i % 2) frameLogic(1 / 60); } return this.state(); },\n    glyphs() { return [...document.querySelectorAll('[data-glyph]')].map((g) => g.dataset.glyph); },\n    bot(skill, bankAt) { if (!skill) { window.__botHook = null; return; } const lag = { sharp: 0.1, average: 0.2, clumsy: 0.35 }[skill]; let wasHop = false, cool = 0; window.__botHook = () => { const e = G.event; if (!e || G.screen !== 'event' || !window.__pads || !window.__pads[0]) return; const l = e.lanes[0]; l.botLag = lag; const w = e.want(l), pad = window.__pads[0]; pad.axes[0] = w.x; pad.axes[1] = w.y; const h = e.held(l).length >= (bankAt ?? 7); cool -= 1 / 120; const press = h && !wasHop && cool <= 0; pad.buttons[0] = { pressed: press, value: press ? 1 : 0 }; if (press) cool = 0.3; wasHop = press; const fl = Math.hypot(l.s.leanX, l.s.leanZ) > (32 * Math.PI) / 180; pad.buttons[2] = { pressed: fl, value: fl ? 1 : 0 }; }; },\n    forceFall(i = 0) { const l = G.event.lanes[i]; l.s.extX = 9; }, clearForce(i = 0) { G.event.lanes[i].s.extX = 0; },\n    musicLevel() { if (!audio.an) return -1; const d = new Float32Array(audio.an.fftSize); audio.an.getFloatTimeDomainData(d); let s = 0; for (const v of d) s += v * v; return Math.sqrt(s / d.length); },\n    aboutText() { return G.aboutAll ? G.aboutAll() : ''; }, aboutNext() { G.aboutNext && G.aboutNext(); }, seed(n) { runSeed = n; }, show,\n  };\n}\nfunction showBootFailure(err) { G.screen = 'failed'; G.errors.push(String(err && err.stack || err)); clearUI(); div('msg', 'This game needs WebGPU or WebGL2.'); if (window.AIHub && AIHub.active) AIHub.fail(String(err).slice(0, 200)); }\nasync function bootEngine() {\n  if (RENDER) { renderer = new THREE.WebGPURenderer({ antialias: true }); renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2)); renderer.setSize(innerWidth, innerHeight); renderer.toneMapping = THREE.NoToneMapping; renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFShadowMap; document.body.prepend(renderer.domElement); await renderer.init(); G.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : renderer.backend.isWebGLBackend ? 'webgl2' : 'other'; }\n  await RAPIER.init();\n  buildBackdrop();\n  if (RENDER) { ink = makeInk(renderer, scene, camera); addEventListener('resize', () => { camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); }); }\n  if (TEST || RENDER === false) installHooks(); else window.__GAME__ = TITLE;\n  G.loop = () => frame();\n}\nfunction startLoop() { if (TEST && q.get('manual') === '1') return; if (renderer) renderer.setAnimationLoop(G.loop); else { const r = () => { G.loop(); requestAnimationFrame(r); }; requestAnimationFrame(r); } }\nfunction runStandalone() { G.touchOnly = matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; show('title'); startLoop(); }\nasync function main() {\n  if (AIHub.active) {\n    const pConnect = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    await bootEngine();\n    const info = await pConnect;\n    if (info) { runSession(info); startLoop(); } else runStandalone();\n  } else { await bootEngine(); runStandalone(); }\n}\nmain().catch(showBootFailure);\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11125,"cache_read_input_tokens":670979,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11125},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"19307802-7215-43fb-a84b-6c94bbc636c5","uuid":"95e3b103-c97d-430c-83c6-28a752c91430","timestamp":"2026-11-05T05:47:01.220Z","request_id":"req_011CgjFLv9yonSTnaisCR2Zn","wire_tool_inputs":{"toolu_01DFLtmcJP9iPqkLCdVRPCrj":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/proof/src/main.js","content":"// Integration prototype: one event wired through everything the plan specifies. Throwaway.\nimport * as THREE from 'three/webgpu';\nimport { color, mix, smoothstep, step, sin, length, positionWorld, cameraPosition, normalize, time } from 'three/tsl';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport { makeInk } from './ink.gen.js';\nimport { createCore, stepCore } from './balance.gen.js';\nimport CSS from './ui.css';\nimport ABOUT from './about.gen.js';\n\nconst q = new URLSearchParams(location.search);\nconst TEST = q.get('test') === '1', RENDER = q.get('render') !== '0';\nconst TITLE = 'PROOF SLICE';\nconst G = { screen: 'boot', backend: 'none', frames: 0, errors: [], event: null, idle: 0, attract: false, simT: 0, session: null, touchOnly: false, god: false, resultsBack: 'menu', pad: { axes: [] } };\nwindow.addEventListener('error', (e) => G.errors.push(String(e.message)));\nwindow.addEventListener('unhandledrejection', (e) => G.errors.push(String(e.reason)));\nconst style = document.createElement('style'); style.textContent = CSS; document.head.appendChild(style);\nconst ui = document.createElement('div'); ui.id = 'ui'; document.body.appendChild(ui);\n\n// ---- randomness: the only place that makes streams\nfunction mul(a) { a >>>= 0; return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nconst hashStr = (s) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };\nlet runSeed = 12345;\nconst rng = (label) => (G.session ? AIHub.rng(label) : mul(runSeed ^ hashStr(label)));\nconst fx = mul(987);\n\n// ---- tuning: everything reads it live\nconst TUNING = [\n  { key: 'ankleMax', label: 'Ankle', min: 2, max: 12, step: 0.1, def: 4.6 }, { key: 'margin', label: 'Margin', min: 0.1, max: 1.5, step: 0.05, def: 0.45 },\n  { key: 'fruitMass', label: 'Fruit mass', min: 0.005, max: 0.06, step: 0.001, def: 0.015 }, { key: 'fruitEvery', label: 'Fruit every', min: 0.5, max: 3, step: 0.1, def: 1.6 },\n];\nconst T = {}; const resetTuning = () => TUNING.forEach((t) => (T[t.key] = t.def)); resetTuning();\nconst settings = { music: 10, sfx: 80, voice: 80, glyphs: 'ps' };\ntry { const s = JSON.parse(localStorage.getItem('proof-settings') || 'null'); if (s) Object.assign(settings, s); } catch {}\nconst saveSettings = () => { try { localStorage.setItem('proof-settings', JSON.stringify(settings)); } catch {} };\nconst save = { runs: 0, best: 0 };\ntry { const s = JSON.parse(localStorage.getItem('proof-save') || 'null'); if (s && s.v === 1) Object.assign(save, s); } catch {}\nconst writeSave = () => { try { localStorage.setItem('proof-save', JSON.stringify({ v: 1, ...save })); } catch {} };\n\n// ---- input: pads in standard mapping, keys, mouse. Last device decides prompts and weight source.\nconst B = { cross: 0, circle: 1, square: 2, triangle: 3, r1: 5, l2: 6, r2: 7, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\nconst input = {\n  keys: new Set(), pressedKeys: new Set(), mx: innerWidth / 2, my: innerHeight / 2, mouseUsed: false, mouseMovedPx: 0, mb: [false, false, false], clickedMb: [false, false, false],\n  last: 'kbm', anyEvent: false, ring: { x: 0, y: 0 }, padWas: {}, cur: null, prev: null, players: [], ignoreUntilRelease: false, lastPrompt: '',\n  padsConnected() { const list = navigator.getGamepads ? [...navigator.getGamepads()] : []; return list.filter((p) => p && p.connected && p.mapping === 'standard'); },\n};\nconst codeOf = (e) => (/^[a-z]$/i.test(e.code || '') ? 'Key' + e.code.toUpperCase() : e.code || e.key);\naddEventListener('keydown', (e) => { const c = codeOf(e); if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(c)) e.preventDefault(); if (!input.keys.has(c)) input.pressedKeys.add(c); input.keys.add(c); input.anyEvent = true; setLast('kbm'); G.touchOnly = false; ensureAudio(); });\naddEventListener('keyup', (e) => input.keys.delete(codeOf(e)));\naddEventListener('pointermove', (e) => { if (e.pointerType === 'touch') return; const d = Math.hypot(e.clientX - input.mx, e.clientY - input.my); input.mx = e.clientX; input.my = e.clientY; input.mouseMovedPx += d; if (d >= 4) { input.mouseUsed = true; setLast('kbm'); } });\naddEventListener('pointerdown', (e) => { if (e.pointerType === 'touch') { input.touchTap = true; ensureAudio(); return; } input.mb[e.button] = true; input.clickedMb[e.button] = true; input.anyEvent = true; setLast('kbm'); ensureAudio(); });\naddEventListener('pointerup', (e) => { if (e.pointerType !== 'touch') input.mb[e.button] = false; });\naddEventListener('contextmenu', (e) => e.preventDefault());\nfunction setLast(d) { if (input.last !== d) { input.last = d; refreshPrompts(); } }\nconst dz = (v, d = 0.08) => (Math.abs(v) < d ? 0 : v);\nfunction readPadState(p) {\n  const bv = (i) => (p.buttons[i] ? p.buttons[i].value || (p.buttons[i].pressed ? 1 : 0) : 0), bp = (i) => (p.buttons[i] ? !!p.buttons[i].pressed : false);\n  return { wx: dz(p.axes[0] || 0), wy: dz(p.axes[1] || 0), lx: dz(p.axes[2] || 0), ly: dz(p.axes[3] || 0), feetL: bv(B.l2), feetR: bv(B.r2), hop: bp(B.cross), flail: bp(B.square), breath: bp(B.r1), confirm: bp(B.cross), back: bp(B.circle), tri: bp(B.triangle), pause: bp(B.options) && !bp(B.create), up: bp(B.up), down: bp(B.down), left: bp(B.left), right: bp(B.right) };\n}\nfunction pollInput(dt) {\n  const pads = input.padsConnected();\n  input.players = pads.map(readPadState);\n  const k = (c) => input.keys.has(c), keyW = (k('KeyD') || k('ArrowRight') ? 1 : 0) - (k('KeyA') || k('ArrowLeft') ? 1 : 0), keyZ = (k('KeyS') || k('ArrowDown') ? 1 : 0) - (k('KeyW') || k('ArrowUp') ? 1 : 0);\n  // keyboard moves the asking ring, and it stays where you leave it; C recentres\n  if (keyW || keyZ) { input.ring.x += keyW * 1.6 * dt; input.ring.y += keyZ * 1.6 * dt; const L = Math.hypot(input.ring.x, input.ring.y); if (L > 1) { input.ring.x /= L; input.ring.y /= L; } input.mouseUsed = false; }\n  if (k('KeyC')) input.ring.x = input.ring.y = 0;\n  const h = Math.min(innerWidth, innerHeight) * 0.33 || 1; let mxw = (input.mx - innerWidth / 2) / h, myw = (input.my