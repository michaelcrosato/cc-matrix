 this.baseline = w.bodies.len();\n  }\n  makeLane(spec, i, n) {\n    const x = (i - (n - 1) / 2) * 3.2, lane = { ...spec, id: i, x, raw: 0, banks: 0, falls: 0, fruit: [], pending: [], busy: 0, flailLeft: 0, flailCd: 0, fallen: 0, wishX: 0, wishZ: 0, next: 0.5, peak: 0, ghostTo: null };\n    lane.doll = makeDoll(spec.colour ?? SEATS[i % 4]); lane.doll.root.position.set(x, 0, 0); this.group.add(lane.doll.root);\n    const hat = new THREE.Group(); hat.position.y = 1.5; hat.add(shadowed(new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.3, 0.05, 24), toon(0xd9a86c)))); const rim = shadowed(new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.035, 8, 28).rotateX(Math.PI / 2), toon(0xa8703f))); rim.position.y = 0.16; hat.add(rim); lane.doll.root.add(hat); lane.hat = hat;\n    if (spec.kind === 'ghost') return lane;\n    const w = this.world; lane.foot = w.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, 0, 0));\n    const c = createCore(RAPIER, w, lane.foot, x, 0, 0, i, DOLLBITS, T.margin, 0.4);\n    Object.assign(lane, { body: c.body, s: { body: c.body, G: c.G, K: c.K, D: c.D, I: c.I, wx: 0, wz: 0, reflex: 10, dt: 1 / 120, wishX: 0, wishZ: 0, maxLean: 18 * Math.PI / 180, leanX: 0, leanZ: 0, ankleMax: T.ankleMax, flailLeft: 0, flailBoost: 1.9, sway: 0.03, tremor: 0.02, t: 0, ph: 1 + i } });\n    w.createCollider(RAPIER.ColliderDesc.cylinder(0.02, 0.36).setTranslation(0, 0.75, 0).setMass(0.01).setFriction(0.9).setCollisionGroups(DOLLBITS(i)), c.body);\n    for (let k = 0; k < 8; k++) { const a = (k / 8) * Math.PI * 2; w.createCollider(RAPIER.ColliderDesc.cuboid(0.02, 0.1, 0.16).setTranslation(Math.cos(a) * 0.36, 0.85, Math.sin(a) * 0.36).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }).setMass(0.001).setCollisionGroups(DOLLBITS(i)), c.body); }\n    lane.r = rng('fruit');\n    return lane;\n  }\n  retune() { for (const l of this.lanes) if (l.s) { const G = l.s.G, I = l.s.I, K = G * (1 + T.margin), wn = Math.sqrt((K - G) / I); l.s