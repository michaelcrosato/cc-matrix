e flags.mjs 2>&1 | grep -v deprecated; echo ---; node run.mjs firefox both shot 9000 2>&1 | head -20; echo ---; node run.mjs webkit both shot 9000 2>&1 | head -20","description":"Find minimal screenshot flags and test WebGL2 fallback browsers","timeout":240000}},"wire_ingest_context":{"toolu_01Vt7YGx7SWwzK51ExQqCaNS":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/spike"}}}
