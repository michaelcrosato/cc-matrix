ta * wn * I;\n  return { body, joint, G, K, D, I, wn, target: { x: 0, z: 0 }, ext: { x: 0, z: 0 }, leanX: 0, leanZ: 0 };\n}\nfunction control(d) {\n  const q = d.body.rotation();\n  const u = up(q);\n  // lean expressed as small angles toward +x and +z\n  d.leanX = Math.atan2(u.x, u.y); d.leanZ = Math.atan2(u.z, u.y);\n  const w = d.body.angvel();\n  // rotation vector for a lean: toward +x is about -z; toward +z is about +x\n  const ex = d.leanX - d.target.x, ez = d.leanZ - d.target.z;\n  const torqueLeanX = d.G * Math.sin(d.target.x) * -1; // placeholder sign handled below\n  // gravity pushes further into the lean, control must push back toward the target\n  const txLean = -(d.G * Math.sin(d.target.x) + d.K * ex) + 0; // torque in \"lean x\" space\n  const tzLean = -(d.G * Math.sin(d.target.z) + d.K * ez);\n  const wLeanX = -w.z, wLeanZ = w.x; // angular velocity in lean space\n  const Tx = txLean - d.D * wLeanX + d.ext.x, Tz = tzLean - d.D * wLeanZ + d.ext.z;\n  d.body.resetTorques();\n  d.body.addTorque(V(Tz, -w.y * 0.6, -Tx), true);\n}\nfunction report(name, ...rest) { console.log(name.padEnd(30), ...rest); }\n\n// A. stand still, then step the target, measuring settle and overshoot\n{\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0, 0, 0));\n  const d = makeDoll(world, foot);\n  let maxStill = 0;\n  for (let i = 0; i < 1200; i++) { control(d); world.step(); maxStill = Math.max(maxStill, Math.abs(d.leanX), Math.abs(d.leanZ)); }\n  report('A1 still for 10 s', 'max lean deg', deg(maxStill).toFixed(4), 'wn', d.wn.toFixed(2), 'K', d.K.toFixed(2), 'D', d.D.toFixed(2));\n  d.target.x = (18 * Math.PI) / 180;\n  let peak = 0, t90 = null;\n  for (let i = 0; i < 720; i++) { control(d); world.step(); peak = Math.max(peak, d.leanX); if (t90 === null && d.leanX > 0.9 * d.target.x) t90 = i / 120; }\n  report('A2 step to 18 deg', 'final', deg(d.leanX).toFixed(2), 'peak', deg(peak).toFixed(2), 't90 s', t90);\n  d.target.x = 0;\n  d.ext.x = 6; for (let i = 0; i < 18; i++) { control(d); world.step(); } d.ext.x = 0;\n  let peak2 = 0; for (let i = 0; i < 360; i++) { control(d); world.step(); peak2 = Math.max(peak2, Math.abs(d.leanX)); }\n  report('A3 shove 6 Nm for 0.15 s', 'peak deg', deg(peak2).toFixed(2));\n  // lean far past the point of no return with no recovery: at what lean does it stop coming back?\n  world.free();\n}\n// point of no return: release from angle, with torque limited like a real ankle\nfor (const limit of [Infinity, 14, 11, 9.5]) {\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased());\n  const d = makeDoll(world, foot);\n  let back = null;\n  for (let a = 10; a <= 80; a += 5) {\n    const r = (a * Math.PI) / 180;\n    d.body.setRotation({ x: 0, y: 0, z: -Math.sin(r / 2), w: Math.cos(r / 2) }, true);\n    d.body.setTranslation(V(Math.sin(r) * 0.75, Math.cos(r) * 0.75, 0), true);\n    d.body.setLinvel(V(), true); d.body.setAngvel(V(), true);\n    let lean = r, ok = true;\n    for (let i = 0; i < 360; i++) {\n      control(d);\n      // clamp the torque\n      const t = d.body.userTorque ? d.body.userTorque() : null;\n      if (limit !== Infinity) {\n        const q = d.body.rotation(); const u = up(q); const lx = Math.atan2(u.x, u.y); const w = d.body.angvel();\n        let T = -(d.K * lx) - d.D * (-w.z); T = Math.max(-limit, Math.min(limit, T));\n        d.body.resetTorques(); d.body.addTorque(V(0, 0, -T), true);\n      }\n      world.step();\n      const u2 = up(d.body.rotation()); lean = Math.atan2(u2.x, u2.y);\n      if (Math.abs(lean) > 1.5) { ok = false; break; }\n    }\n    if (!ok || Math.abs(lean) > 0.1) { back = a; break; }\n  }\n  report(`A4 torque limit ${limit}`, 'first angle that does not recover (deg)', back);\n  world.free();\n}\n// B. top-heavy load: a basket on the head collects dynamic fruit, real forces on the body\n{\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  world.integrationParameters.numSolverIterations = 8;\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased());\n  const d = makeDoll(world, foot);\n  // basket: compound colliders on the doll body, in local space above the head\n  const by = 0.75, r = 0.36;\n  world.createCollider(RAPIER.ColliderDesc.cylinder(0.02, r).setTranslation(0, by, 0).setMass(0.01).setFriction(0.9), d.body);\n  for (let k = 0; k < 8; k++) {\n    const a = (k / 8) * Math.PI * 2;\n    const c = RAPIER.ColliderDesc.cuboid(0.02, 0.08, 0.14).setTranslation(Math.cos(a) * r, by + 0.08, Math.sin(a) * r).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }).setMass(0.001);\n    world.createCollider(c, d.body);\n  }\n  const fruit = [];\n  let i = 0, maxLean = 0, fallen = null, peaks = [];\n  for (let n = 0; n < 12; n++) {\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation((n % 3 - 1) * 0.05, 2.4, ((n * 7) % 3 - 1) * 0.05).setCcdEnabled(true));\n    world.createCollider(RAPIER.ColliderDesc.ball(0.08).setMass(0.06).setRestitution(0.1).setFriction(0.8), b);\n    fruit.push(b);\n    let peak = 0;\n    for (let s = 0; s < 180; s++) { control(d); world.step(); i++; const l = Math.hypot(d.leanX, d.leanZ); peak = Math.max(peak, l); maxLean = Math.max(maxLean, l); if (l > 1.2 && fallen === null) fallen = n; }\n    peaks.push(deg(peak).toFixed(1));\n  }\n  const inBasket = fruit.filter((b) => b.translation().y > 1.3).length;\n  report('B fruit 0.06 kg each', 'peak lean per catch', peaks.join(' '), 'in basket', inBasket, 'fell at', fallen);\n  world.free();\n}\n// C. tray with a stone cairn on the doll, tilted slowly by the player\n{\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  world.integrationParameters.numSolverIterations = 10;\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased());\n  const d = makeDoll(world, foot, { margin: 0.8 });\n  world.createCollider(RAPIER.ColliderDesc.cylinder(0.03, 0.55).setTranslation(0, 0.95, 0).setMass(0.05).setFriction(1.0), d.body);\n  const stones = [];\n  let y = 2.03;\n  const sizes = [[0.22, 0.09], [0.2, 0.08], [0.18, 0.075], [0.16, 0.07], [0.14, 0.065], [0.12, 0.06], [0.1, 0.055]];\n  let log = [];\n  for (const [rad, hh] of sizes) {\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0.01, 0, 0).setLinearDamping(0.05).setAngularDamping(0.4));\n    const topY = stones.length ? stones[stones.length - 1].translation().y + stones[stones.length - 1].hh : 1.75 + 0.03;\n    b.setTranslation(V(0.01, topY + hh + 0.01, 0), true);\n    world.createCollider(RAPIER.ColliderDesc.roundCylinder(hh - 0.02, rad - 0.02, 0.02).setMass(0.04).setFriction(0.9).setRestitution(0), b);\n    b.hh = hh;\n    stones.push(b);\n    for (let s = 0; s < 360; s++) { control(d); world.step(); }\n    log.push(deg(Math.hypot(d.leanX, d.leanZ)).toFixed(2));\n  }\n  const stayed0 = stones.filter((b) => b.translation().y > 1.7).length;\n  // now tilt 6 deg left and right slowly for 8 s\n  let t0 = performance.now();\n  for (let s = 0; s < 960; s++) { d.target.x = (6 * Math.PI / 180) * Math.sin(s / 120 * 1.2); control(d); world.step(); }\n  const ms = (performance.now() - t0) / 960;\n  const stayed = stones.filter((b) => b.translation().y > 1.7).length;\n  d.target.x = (16 * Math.PI / 180);\n  for (let s = 0; s < 360; s++) { control(d); world.step(); }\n  const stayedBig = stones.filter((b) => b.translation().y > 1.2).length;\n  report('C cairn of 7', 'lean each add', log.join(' '), 'on tray', stayed0, 'after 6 deg sway', stayed, 'after 16 deg lean', stayedBig, 'ms/step', ms.toFixed(3));\n  world.free();\n}\n// E. passive ragdoll, 11 bodies\n{\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  world.createCollider(RAPIER.ColliderDesc.cuboid(20, 0.5, 20).setTranslation(0, -0.5, 0).setFriction(0.9));\n  const parts = {};\n  const add = (name, x, y, z, hh, r, m) => { const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setLinearDamping(0.05).setAngularDamping(0.6)); world.createCollider(RAPIER.ColliderDesc.capsule(hh, r).setMass(m).setFriction(0.7).setRestitution(0.15).setCollisionGroups(0x00020001), b); parts[name] = b; return b; };\n  add('torso', 0, 1.0, 0, 0.2, 0.22, 0.45);\n  add('head', 0, 1.55, 0, 0.02, 0.2, 0.15);\n  add('uarmL', -0.42, 1.2, 0, 0.1, 0.07, 0.05); add('larmL', -0.7, 1.2, 0, 0.1, 0.07, 0.04);\n  add('uarmR', 0.42, 1.2, 0, 0.1, 0.07, 0.05); add('larmR', 0.7, 1.2, 0, 0.1, 0.07, 0.04);\n  add('ulegL', -0.14, 0.62, 0, 0.13, 0.09, 0.08); add('llegL', -0.14, 0.26, 0, 0.13, 0.08, 0.06);\n  add('ulegR', 0.14, 0.62, 0, 0.13, 0.09, 0.08); add('llegR', 0.14, 0.26, 0, 0.13, 0.08, 0.06);\n  const J = (a, b, pa, pb) => { const j = world.createImpulseJoint(RAPIER.JointData.spherical(pa, pb), parts[a], parts[b], true); j.setContactsEnabled(false); return j; };\n  J('torso', 'head', V(0, 0.42, 0), V(0, -0.13, 0));\n  J('torso', 'uarmL', V(-0.26, 0.2, 0), V(0, 0, 0)); J('uarmL', 'larmL', V(-0.14, 0, 0), V(0.14, 0, 0));\n  J('torso', 'uarmR', V(0.26, 0.2, 0), V(0, 0, 0)); J('uarmR', 'larmR', V(0.14, 0, 0), V(-0.14, 0, 0));\n  J('torso', 'ulegL', V(-0.14, -0.4, 0), V(0, 0.22, 0)); J('ulegL', 'llegL', V(0, -0.18, 0), V(0, 0.18, 0));\n  J('torso', 'ulegR', V(0.14, -0.4, 0), V(0, 0.22, 0)); J('ulegR', 'llegR', V(0, -0.18, 0), V(0, 0.18, 0));\n  parts.torso.applyImpulse(V(0.6, 0, 0.1), true);\n  parts.head.applyImpulse(V(0.25, 0, 0), true);\n  let maxSpeed = 0, nan = false, t0 = performance.now(), settled = null;\n  for (let s = 0; s < 720; s++) {\n    world.step();\n    let top = 0;\n    for (const b of Object.values(parts)) { const v = b.linvel(); const sp = Math.hypot(v.x, v.y, v.z); top = Math.max(top, sp); if (!isFinite(sp)) nan = true; }\n    maxSpeed = Math.max(maxSpeed, top);\n    if (settled === null && s > 120 && top < 0.1) settled = s / 120;\n  }\n  const hy = parts.head.translation().y, ty = parts.torso.translation().y;\n  report('E ragdoll 10 parts', 'max speed', maxSpeed.toFixed(2), 'nan', nan, 'settled at s', settled, 'torso y', ty.toFixed(2), 'head y', hy.toFixed(2), 'ms/step', ((performance.now() - t0) / 720).toFixed(3));\n  world.free();\n}\n// F. island: kinematic tilting disc, dynamic walker with locked rotations, loose props\n{\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  const island = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased());\n  world.createCollider(RAPIER.ColliderDesc.cylinder(0.5, 22).setTranslation(0, -0.5, 0).setFriction(0.9), island);\n  const walker = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 0.85, 0).lockRotations().setCanSleep(false).setLinearDamping(0.5));\n  world.createCollider(RAPIER.ColliderDesc.capsule(0.5, 0.3).setMass(1).setFriction(0.0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min), walker);\n  const props = [];\n  for (let i = 0; i < 40; i++) {\n    const a = i * 2.399, r = 3 + (i % 8) * 2;\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.5, Math.sin(a) * r));\n    world.createCollider(i % 2 ? RAPIER.ColliderDesc.ball(0.25).setMass(0.2).setFriction(0.6) : RAPIER.ColliderDesc.cuboid(0.2, 0.2, 0.2).setMass(0.3).setFriction(0.7), b);\n    props.push(b);\n  }\n  // tilt model: 2-axis damped spring, driven by the walker's position\n  let tx = 0, tz = 0, vx = 0, vz = 0;\n  const dt = 1 / 120;\n  let yMin = 9, yMax = -9, prevY = null, jitter = 0, t0 = performance.now(), maxTilt = 0;\n  for (let s = 0; s < 120 * 20; s++) {\n    const p = walker.translation();\n    // restoring spring, damper, driving torque from the walker's offset\n    const K = 2.2, C = 1.8, W = 0.0075;\n    vx += (W * p.x - K * tx - C * vx) * dt; vz += (W * p.z - K * tz - C * vz) * dt;\n    tx += vx * dt; tz += vz * dt; maxTilt = Math.max(maxTilt, Math.hypot(tx, tz));\n    // rotate the disc: tilt down toward +x is about -z, toward +z is about +x\n    const ang = Math.hypot(tx, tz) || 1e-9, ax = tz / ang, az = -tx / ang, sh = Math.sin(ang / 2);\n    island.setNextKinematicRotation({ x: ax * sh, y: 0, z: az * sh, w: Math.cos(ang / 2) });\n    // walker: wants to go in a big circle around the island, slope slides it a little\n    const t = s * dt, wx = Math.cos(t * 0.6) * 12 - p.x, wz = Math.sin(t * 0.6) * 12 - p.z;\n    const L = Math.hypot(wx, wz) || 1, speed = Math.min(4, L * 2);\n    const v = walker.linvel();\n    walker.setLinvel(V((wx / L) * speed + tx * 6, v.y, (wz / L) * speed + tz * 6), true);\n    world.step();\n    if (s > 240) { const y = walker.translation().y; yMin = Math.min(yMin, y); yMax = Math.max(yMax, y); if (prevY !== null) jitter = Math.max(jitter, Math.abs(y - prevY)); prevY = y; }\n  }\n  const fellOff = props.filter((b) => b.translation().y < -1).length;\n  report('F island + walker + 40 props', 'max tilt deg', deg(maxTilt).toFixed(2), 'walker y range', yMin.toFixed(3), yMax.toFixed(3), 'max dy/step', jitter.toFixed(4), 'props fell off', fellOff, 'ms/step', ((performance.now() - t0) / 2400).toFixed(3));\n  world.free();\n}\n// G. marble jar: N balls into a cylinder of cuboid walls\nfor (const N of [200, 500]) {\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120;\n  const jar = world.createRigidBody(RAPIER.RigidBodyDesc.fixed());\n  world.createCollider(RAPIER.ColliderDesc.cylinder(0.05, 0.8).setTranslation(0, 0, 0).setFriction(0.5), jar);\n  for (let k = 0; k < 16; k++) { const a = (k / 16) * Math.PI * 2; world.createCollider(RAPIER.ColliderDesc.cuboid(0.05, 1.2, 0.2).setTranslation(Math.cos(a) * 0.85, 1.2, Math.sin(a) * 0.85).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }), jar); }\n  const balls = [];\n  let t0 = performance.now(), steps = 0;\n  for (let i = 0; i < N; i++) {\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation((i % 5 - 2) * 0.04, 3, ((i * 3) % 5 - 2) * 0.04));\n    world.createCollider(RAPIER.ColliderDesc.ball(0.06).setMass(0.02).setRestitution(0.35).setFriction(0.3), b);\n    balls.push(b);\n    for (let s = 0; s < 2; s++) { world.step(); steps++; }\n  }\n  for (let s = 0; s < 240; s++) { world.step(); steps++; }\n  const inside = balls.filter((b) => { const p = b.translation(); return Math.hypot(p.x, p.z) < 0.85 && p.y > 0; }).length;\n  report(`G jar ${N} marbles`, 'inside', inside, 'ms/step avg', ((performance.now() - t0) / steps).toFixed(3), 'top y', Math.max(...balls.map((b) => b.translation().y)).toFixed(2));\n  world.free();\n}\nEOF\nnode phys.mjs 2>&1 | grep -v deprecated","description":"Spike the Rapier balance model and props in Node","timeout":180000}},"wire_ingest_context":{"toolu_017ubDJQN31YF4kmnQs24VKp":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/spike"}}}
