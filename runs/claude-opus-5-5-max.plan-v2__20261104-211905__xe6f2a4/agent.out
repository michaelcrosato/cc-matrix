dt); world.step();\n      const err = Math.hypot(dot.x - goal.x, dot.y - goal.y);\n      const weight = 0.30 / rr; // a tighter ring is worth more\n      if (t > glide * 0.5) { maxWeighted += weight; ticks++; if (err <= rr) { inTicks++; weighted += weight; } }\n      const lean = Math.hypot(b.lx, b.lz); peak = Math.max(peak, lean);\n      if (lean > rad(45)) { falls++; break; }\n    }\n  }\n  world.free();\n  return { form: Math.round((100 * weighted) / maxWeighted), inPct: Math.round((100 * inTicks) / ticks), peak: Math.round(deg(peak)), falls };\n}\nconst players = [['sharp', 0.16, 1.4, 0.0], ['average', 0.26, 1.0, 0.03], ['clumsy', 0.38, 0.8, 0.07], ['hands off', 0.2, 0, 0]];\nconst tiers = [\n  ['T1 ring .30->.16 tremor .15->.5', { ringEnd: 0.16, tremorStart: 0.15, tremorEnd: 0.5, poses: 3, hold: 8 }],\n  ['T2 ring .30->.13 tremor .2->.7', { ringEnd: 0.13, tremorStart: 0.2, tremorEnd: 0.7, poses: 4, hold: 10 }],\n  ['T3 ring .30->.10 tremor .25->1.0', { ringEnd: 0.10, tremorStart: 0.25, tremorEnd: 1.0, poses: 5, hold: 12 }],\n];\nfor (const [tname, cfg] of tiers) {\n  console.log(tname);\n  for (const [pname, delay, gain, noise] of players) {\n    const res = [1, 2].map((seed) => runPoses(cfg, human(delay, gain, noise, seed)));\n    console.log('   ', pname.padEnd(10), res.map((r) => `form ${r.form} in ${r.inPct}% peak ${r.peak} falls ${r.falls}`).join(' | '));\n  }\n}\n// Cairn under the final control law, with the same human model: goal is level (0,0)\nfunction runCairn({ margin, tau, stoneMass, interval, count, hold, tremorStart, tremorEnd, gain, delay, noise, seed }) {\n  const world = new RAPIER.World(V(0, -9.81, 0)); world.timestep = 1 / 120; world.integrationParameters.numSolverIterations = 10;\n  const b = makeBal(world, { margin, tau, maxLeanDeg: 18 });\n  world.createCollider(RAPIER.ColliderDesc.cuboid(0.55, 0.03, 0.55).setTranslation(0, 0.95, 0).setMass(0.05).setFriction(1.0).setCollisionGroups((2 << 16) | 4), b.body);\n  const stones = []; const dt = 1 / 120;\n  const hullOf = (rad, hh, rng) => { const pts = []; for (let i = 0; i < 10; i++) { const a = (i / 10) * Math.PI * 2, r1 = rad * (0.9 + 0.2 * rng()), r2 = r1 * 0.82; pts.push(Math.cos(a) * r1, hh, Math.sin(a) * r1, Math.cos(a) * r2, -hh, Math.sin(a) * r2); } return new Float32Array(pts); };\n  let a = seed >>> 0; const rng = () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n  const ctl = human(delay, gain, noise, seed);\n  const sizes = [[0.26, 0.09], [0.24, 0.085], [0.22, 0.08], [0.2, 0.078], [0.18, 0.074], [0.165, 0.07], [0.15, 0.066], [0.14, 0.062], [0.125, 0.058], [0.11, 0.054]];\n  let next = 1, placed = 0, s = 0, peak = 0, falls = 0;\n  const total = count * interval + hold + 1;\n  for (; s < total * 120; s++) {\n    const t = s / 120;\n    if (t >= next && placed < count) {\n      next += interval;\n      const [rad0, hh] = sizes[placed];\n      const u = up(b.body.rotation()), p = b.body.translation();\n      const slabTop = { x: p.x + u.x * 0.98, y: p.y + u.y * 0.98, z: p.z + u.z * 0.98 };\n      const live = stones.filter((st) => st.translation().y > 1.3);\n      const topY = live.length ? Math.max(...live.map((st) => st.translation().y + st.hh)) : slabTop.y;\n      const body = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(slabTop.x + (rng() - 0.5) * 0.06, topY + hh + 0.012, slabTop.z + (rng() - 0.5) * 0.06).setLinearDamping(0.1).setAngularDamping(0.6).setCanSleep(false));\n      world.createCollider(RAPIER.ColliderDesc.convexHull(hullOf(rad0, hh, rng)).setMass(stoneMass).setFriction(0.95).setRestitution(0).setCollisionGroups((4 << 16) | 0xffff), body);\n      body.hh = hh; stones.push(body); placed++;\n    }\n    const prog = Math.min(1, t / total);\n    b.tremor = tremorStart + (tremorEnd - tremorStart) * prog;\n    const dot = { x: b.lx / b.max, y: b.lz / b.max };\n    const d = ctl(dot, { x: 0, y: 0 }, dt);\n    const L = Math.hypot(d.x, d.y); b.wish.x = L > 1 ? d.x / L : d.x; b.wish.y = L > 1 ? d.y / L : d.y;\n    stepBal(b, dt); world.step();\n    const lean = Math.hypot(b.lx, b.lz); peak = Math.max(peak, lean);\n    if (lean > rad(45)) { falls++; break; }\n  }\n  const on = stones.filter((st) => st.translation().y > 1.3).length;\n  world.free();\n  return { placed, on, falls, peak: Math.round(deg(peak)) };\n}\nfor (const [name, base] of [['Cairn T1 6 stones', { margin: 0.8, tau: 6, stoneMass: 0.02, interval: 5.5, count: 6, hold: 8, tremorStart: 0.1, tremorEnd: 0.35 }], ['Cairn T2 8 stones', { margin: 0.8, tau: 6, stoneMass: 0.02, interval: 5, count: 8, hold: 10, tremorStart: 0.15, tremorEnd: 0.5 }], ['Cairn T3 10 stones', { margin: 0.8, tau: 6, stoneMass: 0.02, interval: 4.5, count: 10, hold: 10, tremorStart: 0.2, tremorEnd: 0.7 }]]) {\n  console.log(name);\n  for (const [pname, delay, gain, noise] of players) {\n    const res = [1, 2].map((seed) => runCairn({ ...base, delay, gain, noise, seed }));\n    console.log('   ', pname.padEnd(10), res.map((r) => `on ${r.on}/${r.placed} falls ${r.falls} peak ${r.peak}`).join(' | '));\n  }\n}\nEOF\nnode poses.mjs 2>&1 | grep -v deprecated","description":"Calibrate pose ring tremor and the Cairn with human-like bots","timeout":240000}},"wire_ingest_context":{"toolu_01BEKSc8yvEvS7or1q2ySqJE":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/spike"}}}
