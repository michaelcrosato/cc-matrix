k); }\n{\n  const d = fresh(); const p0 = tick(d, 600);\n  d.s.wishX = 1; let t90 = null; const pk = tick(d, 600, (t) => { if (t90 === null && d.s.leanX > rad(16.2)) t90 = t; });\n  console.log('plan balance, verbatim: still peak', p0.toFixed(3), 'full stick: t90', t90, 'peak', pk.toFixed(1), 'final', deg(d.s.leanX).toFixed(1));\n  d.world.free();\n}\nconsole.log('--- gusts at the default ankleMax 4.6, 0.5 s long, along +x');\nfor (const g of [2, 2.5, 3, 3.5, 4]) {\n  const row = [];\n  // no response\n  let d = fresh(); row.push('none ' + tick(d, 480, (t) => { d.s.extX = t < 0.5 ? g : 0; }).toFixed(0)); d.world.free();\n  // flail 0.35 s in\n  d = fresh(); row.push('flail ' + tick(d, 480, (t) => { d.s.extX = t < 0.5 ? g : 0; if (t > 0.35 && t < 0.36) d.s.flailLeft = 0.35; }).toFixed(0)); d.world.free();\n  // counter-lean: stick hard against the gust from 0.25 s in (a human seeing it)\n  d = fresh(); row.push('counter ' + tick(d, 480, (t) => { d.s.extX = t < 0.5 ? g : 0; d.s.wishX = t > 0.25 && t < 1.2 ? -1 : 0; }).toFixed(0)); d.world.free();\n  // telegraphed: counter-lean starts 0.5 s before the gust, as Room Service gives you\n  d = fresh(); row.push('braced ' + tick(d, 480, (t) => { const gt = t - 0.5; d.s.extX = gt > 0 && gt < 0.5 ? g : 0; d.s.wishX = t < 1.5 ? -0.6 : 0; }).toFixed(0)); d.world.free();\n  console.log(`gust ${g} Nm:`, row.join(' | '), '(peak lean deg; 70 = fell)');\n}\n// tumblers and log under the torque limit used in the plan's Cairn body (ankleMax 6, margin .8)\n{\n  for (const amp of [0, 6, 10, 14, 20]) {\n    const d = fresh({ margin: 0.8, ankleMax: 6 });\n    d.world.integrationParameters.numSolverIterations = 10;\n    const col = (0x0100 << 16) | 0x0010, prop = (0x0010 << 16) | 0xffff;\n    d.world.createCollider(RAPIER.ColliderDesc.cuboid(0.3, 0.02, 0.3).setTranslation(0, 0.5, 0.3).setMass(0.04).setFriction(1).setCollisionGroups(col), d.s.body);\n    const gl = [];\n    for (const [x, z] of [[0, 0.3], [0.16, 0.16], [-0.16, 0.16], [0.16, 0.44], [-0.16, 0.44]]) {\n      const b = d.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 0.75 + 0.5 + 0.02 + 0.06 + 0.005, z).setAngularDamping(0.5).setLinearDamping(0.1));\n      d.world.createCollider(RAPIER.ColliderDesc.cylinder(0.06, 0.05).setMass(0.012).setFriction(0.9).setRestitution(0).setCollisionGroups(prop), b); gl.push(b);\n    }\n    tick(d, 120);\n    let z = 0, t = 0;\n    tick(d, 120 * 20, (tt) => { t += 1 / 120; z += 1.2 * Math.min(1, t / 1.5) / 120; d.footBody.setNextKinematicTranslation({ x: 0, y: 0, z }); d.s.wishX = (amp / 18) * Math.sin(t * 1.3); });\n    const left = gl.filter((b) => b.translation().y > 1.0).length;\n    console.log(`tray ankle 6, sway ±${amp}: tumblers left ${left}/5`);\n    d.world.free();\n  }\n}\n// island block, verbatim\n{\n  const fn = new Function('world', 'islandGroup', 'p', 'K', 'C', 'W', 'restX', 'restZ', 'dt', 'state', `let { vx, vz, tx, tz } = state; ${island}; Object.assign(state, { vx, vz, tx, tz });`);\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 }); world.timestep = 1 / 120;\n  const q = { x: 0, y: 0, z: 0, w: 1, set(x, y, z, w) { Object.assign(this, { x, y, z, w }); } };\n  const st = { vx: 0, vz: 0, tx: 0, tz: 0 };\n  const K = 2.2, W = K * rad(4) / 22;\n  for (let i = 0; i < 120 * 20; i++) fn(world, { quaternion: q }, { x: 22, z: 0 }, K, 1.8, W, rad(9), 0, 1 / 120, st);\n  const g = world.gravity;\n  console.log('island verbatim: tilt deg', deg(st.tx).toFixed(2), '(9 rest + 4 weight = 13 expected), gravity', g.x.toFixed(2), g.y.toFixed(2), g.z.toFixed(2), 'quat', q.x.toFixed(3), q.z.toFixed(3), q.w.toFixed(3));\n  // +x side must go down: rotate (1,0,0) by q\n  const v = { x: 1, y: 0, z: 0 }; const u = { x: q.x, y: q.y, z: q.z }, w = q.w;\n  const cr = (a, b) => ({ x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x });\n  const c1 = cr(u, v), c2 = cr(u, c1); const yy = v.y + 2 * (w * c1.y + c2.y);\n  console.log('+x side y after rotation (must be negative):', yy.toFixed(3));\n  world.free();\n}\nEOF\nnode doctest.mjs 2>&1 | grep -v deprecated; cat > src/plantest.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { makeInk } from './planink.js';\nconst S = (window.__spike = { boot: 'start', frames: 0, errors: [] });\n(async () => {\n  const renderer = new THREE.WebGPURenderer({ antialias: true });\n  renderer.setSize(innerWidth, innerHeight); renderer.toneMapping = THREE.NoToneMapping; renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFShadowMap;\n  document.body.appendChild(renderer.domElement);\n  await renderer.init();\n  S.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n  const scene = new THREE.Scene(); scene.background = new THREE.Color(0xffd9b0);\n  const camera = new THREE.PerspectiveCamera(38, innerWidth / innerHeight, 0.3, 900); camera.position.set(0, 1.6, 6); camera.lookAt(0, 0.8, 0);\n  const sun = new THREE.DirectionalLight(0xfff0d0, 3.1); sun.position.set(-4, 8, 4); sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048); sun.shadow.bias = -0.0006; sun.shadow.normalBias = 0.035; scene.add(sun); scene.add(new THREE.HemisphereLight(0xfff4e0, 0x8a7fa0, 1.25));\n  const d = new Uint8Array(12); [96, 178, 255].forEach((v, i) => d.set([v, v, v, 255], i * 4)); const ramp = new THREE.DataTexture(d, 3, 1, THREE.RGBAFormat); ramp.minFilter = ramp.magFilter = THREE.NearestFilter; ramp.colorSpace = THREE.NoColorSpace; ramp.needsUpdate = true;\n  const m = new THREE.Mesh(new THREE.SphereGeometry(0.8, 32, 20), new THREE.MeshToonNodeMaterial({ color: 0xe8443a, gradientMap: ramp })); m.position.y = 0.8; m.castShadow = true; m.receiveShadow = true; scene.add(m);\n  const g = new THREE.Mesh(new THREE.CylinderGeometry(4, 4, 0.4, 48), new THREE.MeshToonNodeMaterial({ color: 0xf3d39b, gradientMap: ramp })); g.position.y = -0.2; g.receiveShadow = true; scene.add(g);\n  const { post, u } = makeInk(renderer, scene, camera);\n  S.uniforms = Object.keys(u).length;\n  await renderer.setAnimationLoop(() => { post.render(); S.frames++; });\n  S.boot = 'running';\n})().catch((e) => { S.boot = 'failed'; S.errors.push(String(e && e.stack || e)); });\nEOF\ncat > buildplan.mjs <<'EOF'\nimport { build } from 'esbuild';\nimport { writeFileSync } from 'node:fs';\nconst r = await build({ entryPoints: ['src/plantest.js'], bundle: true, format: 'iife', target: 'es2022', minify: true, write: false, logLevel: 'warning', legalComments: 'none' });\nwriteFileSync('plantest.html', `<!doctype html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;overflow:hidden}canvas{display:block}</style></head><body><script>${r.outputFiles[0].text.replace(/<\\/script/gi, '<\\\\/script')}</script></body></html>`);\nEOF\ncat > runplan.mjs <<'EOF'\nimport { chromium, webkit } from 'playwright';\nimport { pathToFileURL } from 'node:url';\nimport { resolve } from 'node:path';\nconst url = pathToFileURL(resolve('plantest.html')).href;\nfor (const [name, type, args] of [['webgpu', chromium, ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader']], ['webkit', webkit, []]]) {\n  const b = await type.launch({ headless: true, args });\n  const p = await b.newPage({ viewport: { width: 1280, height: 720 } });\n  const errs = []; p.on('console', (m) => { if (m.type() === 'error') errs.push(m.text().slice(0, 240)); }); p.on('pageerror', (e) => errs.push(String(e).slice(0, 300)));\n  await p.goto(url); await p.waitForTimeout(5000);\n  console.log('plan ink recipe, verbatim,', name, JSON.stringify(await p.evaluate(() => window.__spike)), errs.slice(0, 2));\n  await p.screenshot({ path: `plantest-${name}.png` });\n  await b.close();\n}\nEOF\nnode buildplan.mjs && node runplan.mjs 2>&1 | grep -v deprecated","description":"Run the plan's code blocks verbatim and re-check doubtful claims","timeout":280000}},"wire_ingest_context":{"toolu_0139pFjo8P2fsCrfQeZD21cC":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211905__xe6f2a4/work/_scratch/spike"}}}
