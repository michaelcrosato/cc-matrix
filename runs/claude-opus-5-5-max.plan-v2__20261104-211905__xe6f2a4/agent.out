dd(el, new THREE.SphereGeometry(0.07, 12, 10), 0xffffff, 0, -0.26, 0);\n    const hp = joint('hip' + s, 'hips', side * 0.13, -0.02, 0); add(hp, new THREE.CapsuleGeometry(0.08, 0.14, 6, 12), 0xf2d3a8, 0, -0.11, 0); const kn = joint('knee' + s, 'hip' + s, 0, -0.22, 0); add(kn, new THREE.CapsuleGeometry(0.08, 0.1, 6, 12), 0xf2d3a8, 0, -0.08, 0); add(kn, new THREE.SphereGeometry(0.1, 16, 12).scale(1, 0.55, 1.5), 0xffffff, 0, -0.19, 0.04); }\n  const mixer = new THREE.AnimationMixer(root);\n  const clips = { idle: poseClip('idle', 2, [{ t: 0, pose: { shoulderL: [0, 0, -25], shoulderR: [0, 0, 25] } }, { t: 1, pose: { shoulderL: [0, 0, -30], shoulderR: [0, 0, 30] } }, { t: 2, pose: { shoulderL: [0, 0, -25], shoulderR: [0, 0, 25] } }]), flail: poseClip('flail', 0.3, [{ t: 0, pose: { shoulderL: [0, 0, -120], shoulderR: [0, 0, 60] } }, { t: 0.15, pose: { shoulderL: [0, 0, -60], shoulderR: [0, 0, 120] } }, { t: 0.3, pose: { shoulderL: [0, 0, -120], shoulderR: [0, 0, 60] } }]) };\n  const acts = {}; for (const [n, c] of Object.entries(clips)) acts[n] = mixer.clipAction(c); acts.idle.play();\n  return { root, J, mixer, acts, cur: 'idle', ragdoll: null };\n}\nfunction playClip(d, name) { if (d.cur === name) return; d.acts[d.cur].fadeOut(0.1); d.acts[name].reset().fadeIn(0.1).play(); d.cur = name; }\nconst RAG = (0x1000 << 16) | 0x0001;\nfunction spawnRagdoll(world, d, vel) {\n  d.root.updateWorldMatrix(true, true); const made = {}, p = new THREE.Vector3(), r = new THREE.Quaternion();\n  for (const [name, , hh, rad, m, cy] of SEGS) { const g = d.J[name]; g.getWorldPosition(p); g.getWorldQuaternion(r); const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x, p.y, p.z).setRotation({ x: r.x, y: r.y, z: r.z, w: r.w }).setLinvel(vel.x, vel.y, vel.z).setLinearDamping(0.05).setAngularDamping(0.6).setCanSleep(false)); world.createCollider(RAPIER.ColliderDesc.capsule(hh, rad).setTranslation(0, cy, 0).setMass(m).setFriction(0.7).setRestitution(0.15).setCollisionGro