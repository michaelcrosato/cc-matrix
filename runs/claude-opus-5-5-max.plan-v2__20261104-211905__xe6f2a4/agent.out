], pause: ['xb-menu', 'Menu'], weight: ['xb-ls', 'L Stick'], more: ['xb-y', 'Y'] },\n  kbm: { confirm: ['key-enter', 'Enter'], back: ['key-esc', 'Esc'], hop: ['key-space', 'Space'], flail: ['key-f', 'F'], pause: ['key-esc', 'Esc'], weight: ['key-wasd', 'WASD'], more: ['key-m', 'M'] },\n};\nconst glyphSet = () => (input.last === 'pad' ? settings.glyphs : 'kbm');\nlet promptList = [];\nfunction promptHTML(el, action, label) { const [id, text] = GLYPHS[glyphSet()][action]; const wrap = document.createElement('span'); wrap.className = 'prompt'; const g = document.createElement('span'); g.className = 'glyph' + (glyphSet() === 'kbm' ? ' key' : ''); g.dataset.glyph = id; g.textContent = text; wrap.append(g); if (label) { const l = document.createElement('span'); l.textContent = label; wrap.append(l); } el.append(wrap); }\nfunction refreshPrompts() { document.querySelectorAll('[data-prompts]').forEach((el) => { el.textContent = ''; for (const [a, l] of promptList) promptHTML(el, a, l); }); }\nfunction promptsBar(list) { promptList = list; const el = document.createElement('div'); el.className = 'prompts'; el.dataset.prompts = '1'; for (const [a, l] of list) promptHTML(el, a, l); return el; }\n\n// ---- audio: in code, no files\nconst audio = { ctx: null, music: null, sfx: null, voice: null, an: null, nextNote: 0, bar: 0 };\nconst mtof = (m) => 440 * Math.pow(2, (m - 69) / 12);\nfunction ensureAudio() { try { if (!audio.ctx) { const ctx = new (window.AudioContext || window.webkitAudioContext)(); audio.ctx = ctx; const comp = ctx.createDynamicsCompressor(); comp.connect(ctx.destination); for (const n of ['music', 'sfx', 'voice']) { audio[n] = ctx.createGain(); audio[n].connect(comp); } audio.an = ctx.createAnalyser(); audio.an.fftSize = 2048; audio.music.connect(audio.an); applyVolumes(); } if (audio.ctx.state === 'suspended') audio.ctx.resume().catch(() => {}); } catch {} }\nfunction applyVolumes() { if (!audio.ctx) return; audio.music.gain.value = settings.music / 100; audio.sfx.gain.value = settings.sfx / 100; audio.voice.gain.value = settings.voice / 100; }\nfunction fmEpiano(ctx, dest, t, midi, dur, vel = 0.7) { const f = mtof(midi), car = ctx.createOscillator(), body = ctx.createOscillator(), tine = ctx.createOscillator(), bg = ctx.createGain(), tg = ctx.createGain(), amp = ctx.createGain(); car.frequency.value = f; body.frequency.value = f; tine.frequency.value = f * 14; bg.gain.setValueAtTime(f * 1.2 * vel, t); bg.gain.exponentialRampToValueAtTime(f * 0.15, t + Math.min(dur, 0.7)); tg.gain.setValueAtTime(f * 0.5 * vel, t); tg.gain.exponentialRampToValueAtTime(0.01, t + 0.12); body.connect(bg).connect(car.frequency); tine.connect(tg).connect(car.frequency); amp.gain.setValueAtTime(0, t); amp.gain.linearRampToValueAtTime(vel * 0.35, t + 0.005); amp.gain.exponentialRampToValueAtTime(0.001, t + dur + 0.25); car.connect(amp).connect(dest); for (const o of [car, body, tine]) { o.start(t); o.stop(t + dur + 0.3); } }\nconst MOTIF = [[[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]], [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]], [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]], [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]]];\nfunction pumpMusic() { if (!audio.ctx || audio.ctx.state !== 'running') return; const S16 = 60 / 92 / 4; if (audio.nextNote < audio.ctx.currentTime) audio.nextNote = audio.ctx.currentTime + 0.05; while (audio.nextNote < audio.ctx.currentTime + 0.15) { const b = audio.bar % 4; for (const [st, m, len] of MOTIF[b]) fmEpiano(audio.ctx, audio.music, audio.nextNote + st * S16, m, len * S16, 0.8); audio.nextNote += 16 * S16; audio.bar++; } }\nfunction sfx(kind) { if (!audio.ctx || audio.ctx.state !== 'running') return; const ctx = audio.ctx, t = ctx.currentTime; const o = ctx.createOscillator(), a = ctx.createGain(); o.frequency.value = kind === 'clack' ? 300 + fx() * 400 : kind === 'bank' ? 660 : 880; a.gain.setValueAtTime(0.4, t); a.gain.exponentialRa