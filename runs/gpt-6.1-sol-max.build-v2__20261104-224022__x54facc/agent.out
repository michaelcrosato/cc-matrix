{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/probe.ts <<'EOF'\n/** @file Prints objective activity pilot measurements while balancing the demo. */\nimport {ACTIVITIES} from '../scenes/data/days';\nimport {createRun,botFor,stepEvent} from '../scenes/events/registry';\nimport {makeWobble,DEFAULT_WOBBLE} from '../scenes/wobble';\nimport {TUNING} from '../scenes/settings';\nconst get=(key:string)=>TUNING.find(([k])=>k===key)?.[1]??1;\nfor(const a of ACTIVITIES){\n const results=[];\n for(const kind of ['perfect','human','sloppy','idle']){\n  let sum=0,min=10000,max=0;\n  for(let seed=1;seed<=3;seed++){\n   const r=createRun(a.id,seed),w=makeWobble([seed*.4,seed*.7,1,2,3,4]),c={wobble:{...DEFAULT_WOBBLE},get,auto:true,day:1,expert:false};\n   while(r.tick<r.length)stepEvent(r,w,botFor(r,w,c,kind),c);\n   const score=r.id==='group'?r.score/3:r.score;\n   sum+=score;min=Math.min(min,score);max=Math.max(max,score);\n  }\n  results.push(\"'`${kind}:${Math.round(sum/3)} [${Math.round(min)}-${Math.round(max)}]`);\n }\n console.log(a.id,results.join('\"' | '));\n}\nEOF\nnode --import tsx labs/game/tools/probe.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/probe.ts <<'EOF'\n/** @file Prints objective activity pilot measurements while balancing the demo. */\nimport {ACTIVITIES} from '../scenes/data/days';\nimport {createRun,botFor,stepEvent} from '../scenes/events/registry';\nimport {makeWobble,DEFAULT_WOBBLE} from '../scenes/wobble';\nimport {TUNING} from '../scenes/settings';\nconst get=(key:string)=>TUNING.find(([k])=>k===key)?.[1]??1;\nfor(const a of ACTIVITIES){\n const results=[];\n for(const kind of ['perfect','human','sloppy','idle']){\n  let sum=0,min=10000,max=0;\n  for(let seed=1;seed<=3;seed++){\n   const r=createRun(a.id,seed),w=makeWobble([seed*.4,seed*.7,1,2,3,4]),c={wobble:{...DEFAULT_WOBBLE},get,auto:true,day:1,expert:false};\n   while(r.tick<r.length)stepEvent(r,w,botFor(r,w,c,kind),c);\n   const score=r.id==='group'?r.score/3:r.score;\n   sum+=score;min=Math.min(min,score);max=Math.max(max,score);\n  }\n  results.push(\"'`${kind}:${Math.round(sum/3)} [${Math.round(min)}-${Math.round(max)}]`);\n }\n console.log(a.id,results.join('\"' | '));\n}\nEOF\nnode --import tsx labs/game/tools/probe.ts\"","aggregated_output":"check perfect:954 [953-956] | human:854 [849-863] | sloppy:786 [781-788] | idle:151 [119-179]\npose perfect:998 [998-998] | human:937 [925-943] | sloppy:822 [810-845] | idle:99 [73-121]\npond perfect:957 [957-957] | human:957 [957-957] | sloppy:957 [957-957] | idle:500 [500-500]\nreps perfect:1000 [1000-1000] | human:1000 [1000-1000] | sloppy:1000 [1000-1000] | idle:166 [166-166]\ngarden perfect:800 [800-800] | human:800 [800-800] | sloppy:800 [800-800] | idle:0 [0-0]\npaddle perfect:660 [600-690] | human:660 [600-690] | sloppy:660 [600-690] | idle:0 [0-0]\nline perfect:800 [800-800] | human:800 [800-800] | sloppy:800 [800-800] | idle:0 [0-0]\n/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-224022__x54facc/work/Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261