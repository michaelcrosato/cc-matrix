 Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments; p0: error: Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments; p0: error: Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments; p0: error: Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments; p0: error: Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments; p0: error: Uncaught EngineError: [DEV_BAD_ARGS] __engine.actions.run: args is an array; it must be a object: call it as actions.run(name, args?); __engine.help(\"actions.run\") lists its arguments'}]\n{\n  \"ready\": true,\n  \"errors\": [],\n  \"ghosts\": 0,\n  \"game\": {\n    \"title\": \"Wobble Fit\",\n    \"ready\": true,\n    \"uiTicks\": 420,\n    \"screen\": \"play\",\n    \"attract\": false,\n    \"lastDevice\": \"keyboard\",\n    \"glyphSet\": \"PlayStation\",\n    \"volumes\": {\n      \"music\": 0.1,\n      \"effects\": 0.8,\n      \"voices\": 0.7\n    },\n    \"day\": 1,\n    \"event\": \"group\",\n    \"focus\": 0,\n    \"mode\": \"event\",\n    \"tick\": 91,\n    \"phase\": 0,\n    \"score\": 0,\n    \"balance\": {\n      \"x\": 0,\n      \"y\": 0,\n      \"calm\": 0\n    },\n    \"progress\": {\n      \"day\": 1,\n      \"done\": [],\n      \"ages\": [],\n      \"pebbles\": 0,\n      \"finds\": [],\n      \"bests\": {},\n      \"complete\": false,\n      \"look\": 0,\n      \"colour\": 0\n    },\n    \"touchOnly\": false,\n    \"hubActive\": true\n  },\n  \"hub\": true\n}\n      this.app.ui.choices = [];\n    });\n    addEventListener('keydown', (event) => {\n      if (this.ended || this.started) return;\n      if (event.code === 'Enter' || event.key === 'Enter') client.answer('ready');\n      if (event.code === 'KeyT' || event.key === 't') client.answer('more');\n    });\n    this.drawCard();\n  }\n  ready(): void {\n    if (!this.info || this.ended) return;\n    const others = this.info.players.filter((p) => p.id !== this.info!.me);\n    this.app.run(\n      'round.ghosts',\n      others.map((_, i) => ({ seat: i + 1, x: 0, y: 0, phase: 0, active: true })),\n    );\n    this.app.run('round.colours', [this.info.me, ...others.map((p) => p.id)]);\n    this.client?.ready();\n  }\n  frame(): void {\n    if (!this.info || !this.client || this.ended) return;\n    if (this.started && !this.playing && this.client.time() >= 0 && this.app.engine?.ready) {\n      this.playing = true;\n      this.app.run('round.go');\n      this.app.ui.clear();\n      this.app.engine.inspector?.resume();\n    }\n    if (!this.playing) {\n      const pad = [...(navigator.getGamepads?.() ?? [])].find((p) => p?.connected);\n      if (!this.started && pad?.buttons[0]?.pressed) this.client.answer('ready');\n      if (!this.started && pad?.buttons[3]?.pressed) this.client.answer('more');\n      return;\n    }\n    const f = this.app.flow;\n    if (!f) return;\n    const r = f.event,\n      wobble = r.seats[0] ?? f.wobble;\n/** @file The walkable retreat: stations, coast paths, discoverable pebbles and creeping plaques. */\nimport { addTerrainBody, physicsOf, spawnProp, type World } from '../../../engine/sim-api';\nimport { heightAt, islandGround } from './terrain';\nimport { spawnGuest } from '../cast/guest';\nimport type { GameComponents } from './state';\nimport '../props/retreat';\nexport function put(w: World<GameComponents>, prop: string, x: number, z: number, y = heightAt(x, z), yaw = 0): number {\n  return spawnProp(w, { prop: `prop:${prop}`, at: [x, y, z], yaw });\n}\nexport function buildWorld(w: World<GameComponents>, small = false) {\n  if (small)\n    physicsOf(w).addBody({\n      type: 'fixed',\n      position: [-52, 7.5, 18],\n      colliders: [{ shape: { type: 'box', size: [40, 1, 36] } }],\n    });\n  else addTerrainBody(physicsOf(w), islandGround());\n  put(w, 'pavilion', -52, 18, 8);\n  for (let i = 0; i < 4; i++) put(w, i === 0 ? 'matCoral' : 'matMint', -57.4 + i * 3.6, 20, 8.02);\n  put(w, 'matMint', -52, 13, 8.02);\n  const me = w.settings.get<number>('game.sessionSeat'),\n    count = w.settings.get<number>('game.sessionCount');\n  const slots = Array.from({ length: count }, (_, i) => i).filter((i) => i !== me);\n  const hero = spawnGuest(\n    w,\n    -57.4,\n    8.2,\n    20,\n    0,\n    false,\n    small ? 'build:guest' : undefined,\n    small ? `body:seat${me}` : undefined,\n  );\n  const plumb = spawnGuest(w, -52, 8.2, 13, 0, true, small ? 'build:guest' : undefined);\n  const others = (small ? slots : [1, 2, 3]).map((seat, n) =>\n    spawnGuest(\n      w,\n      -53.8 + n * 3.6,\n      8.2,\n      20,\n      n + 1,\n      false,\n      small ? 'build:guest' : undefined,\n      small ? `body:seat${seat}` : undefined,\n    ),\n  );\n  const tare = put(w, 'tare', -60.5, 22, 8);\n  if (small) return { hero, plumb, others, tare };\n  put(w, 'sea', 0, 0, 1.8);\n  put(w, 'platform', 0, 34, 8.02);\n  put(w, 'notice', 8, 35, 8);\n  put(w, 'stone', 0, 0, 18.05);\n  put(w, 'pavilion', 52, 22, 8, Math.PI / 2);\n  for (let i = 0; i < 4; i++) put(w, 'stepRetreat', 47 + i * 3.3, 28, 8.02);\n  for (const [x, z] of [\n    if (hero?.puppet) hero.puppet.body = `body:guest${f.colour}look${f.look}`;\n    f.serial++;\n  },\n  'game.finale': (w: W, args: unknown) => {\n    startEvent(w, 'tilt');\n    flowOf(w).event.tick = Number((args as { tick: number }).tick ?? 0);\n  },\n  'game.expert': (w: W) => {\n    const f = flowOf(w);\n    f.expert = !f.expert;\n    f.serial++;\n  },\n  'round.colours': (w: W, args: unknown) => {\n    const f = flowOf(w),\n      colours = args as number[];\n    [f.hero, ...f.others].forEach((id, n) => {\n      const e = w.get(id);\n      if (e?.puppet && colours[n] !== undefined) e.puppet.body = `body:seat${colours[n]}`;\n    });\n  },\n  'round.go': (w: W) => startEvent(w, 'group'),\n  'round.ghosts': (w: W, args: unknown) => {\n    const f = flowOf(w),\n      list = args as { seat: number; x: number; y: number; phase: number; active: boolean }[];\n    for (const g of list) {\n      const id = f.others[g.seat - 1];\n      if (id) w.add(id, 'ghost', g);\n    }\n  },\n};\n","exit_code":0,"status":"completed"}}
