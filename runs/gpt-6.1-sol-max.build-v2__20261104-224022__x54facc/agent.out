{"type":"item.started","item":{"id":"item_217","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/dive-meter.ts <<'EOF'\n/** @file Compose power, release timing and the three gull judges in one readable instrument. */\nimport type {ActivityRun} from '../scenes/events/types';\nexport function diveMeter(r:ActivityRun):string{\n const local=r.tick%1080,swing=.5+.5*Math.sin(local/25);\n const value=r.phase===0?r.hold:r.phase===1?swing:1-Math.min(1,Math.abs(Math.sin(r.angle))+Math.abs(Math.sin(r.velocity)));\n const last=r.scores.at(-1),card=last===undefined?0:Math.round(Math.max(0,Math.min(10,(last*24/1000-4)/2)));\n const label=r.phase===0?'COMPOSE':r.phase===1?'RELEASE AT THE TOP':'ENTER STRAIGHT';\n const cards=last===undefined?'':'<div class=\\\"gull-cards\\\">'+[card,card,4].map(score=>'<span><svg viewBox=\\\"0 0 64 38\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 23Q17 8 30 21Q46 8 60 23M27 23q5-7 10 0l-5 8Z\\\"/></svg><strong>'+score+'</strong></span>').join('')+'</div><p>The third gull has considered a four.</p>';\n return '<div class=\\\"dive-meter\\\"><b>'+label+'</b><div class=\\\"dive-track\\\"><div class=\\\"dive-band\\\"></div><div class=\\\"dive-fill\\\" style=\\\"height:'+value*100+'%\\\"></div><div class=\\\"dive-needle\\\" style=\\\"bottom:'+value*94+'%\\\"></div></div>'+cards+'</div>';\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/terrain.ts');s=p.read_text().replace('  ].map((flat) => ({ ...flat, height: flat.height + 1 })),', \\\"  ].map(flat=>({...flat,height:flat.height+1})).concat([{rect:[-69,50,-60,80],height:0,margin:0}]),\\\");p.write_text(s)\np=Path('labs/game/scenes/data/days.ts');s=p.read_text();a=s.index(\\\"id: 'line'\\\");b=s.index(\\\"id: 'step'\\\",a);s=s[:a]+s[a:b].replace('z: 60','z: 42')+s[b:];p.write_text(s)\np=Path('labs/game/ui/hud.ts');s=p.read_text().replace(\\\"import { glyph,\\\", \\\"import {diveMeter} from './dive-meter';\\\\nimport { glyph,\\\").replace(\\\"  if (r.id === 'reps')\\\", \\\"  if(r.id==='dive')extra=diveMeter(r);\\\\n  if (r.id === 'reps')\\\");p.write_text(s)\np=Path('labs/game/scenes/events/motion.ts');s=p.read_text().replace(\\\"    const pace = Math.abs(input.x - g.x) < 0.4 && input.y > 0.1;\\\", \\\"    if(tap&&foot\"'!==r.lastFoot){r.hold=30;r.lastFoot=foot;}r.hold=Math.max(0,r.hold-1);'\"\\\\n    const pace=Math.abs(input.x-g.x)<.4&&input.y>.1&&r.hold>0;\\\");p.write_text(s)\np=Path('labs/game/scenes/flow.ts');s=p.read_text().replace(\\\"  f.event = createRun(id, w.rng('activity').int(1, 10000));\\\", \\\"  f.event=createRun(id,w.rng('activity').int(1,10000));\\\\n  if(f.demo&&id==='dive'){f.event.tick=360;f.event.hold=1;}\\\");p.write_text(s)\nPY\ncat >> labs/game/ui/theme.css <<'EOF'\n.dive-meter{position:absolute;top:26vh;right:5vw;width:28vw;background:#f6f3e8ed;padding:2vh 1.5vw;border-radius:1.4vh;text-align:center;font-size:2.6vh}.dive-meter b{font-weight:500;letter-spacing:.08em}.dive-track{height:21vh;width:6vh;background:#d9e0ca;border-radius:4vh;margin:2vh auto;position:relative;overflow:hidden}.dive-band{position:absolute;top:0;left:0;right:0;height:18%;background:#9eba98}.dive-fill{position:absolute;bottom:0;left:0;right:0;background:#7f9c7d88}.dive-needle{position:absolute;left:0;right:0;height:1vh;border-radius:2vh;background:#cf8468}.gull-cards{display:flex;justify-content:center;gap:1vw}.gull-cards span{background:#e3e8d7;border-radius:1vh;padding:.6vh 1vw}.gull-cards svg{display:block;width:6vh;height:4vh;stroke:#647b61;stroke-width:2;fill:#faf5e2}.gull-cards strong{font-size:4vh;font-weight:500}.dive-meter p{font-size:2.6vh;line-height:1.35;margin:1vh 0 0}@media(max-aspect-ratio:1/1){.dive-meter{top:31vh;right:10vw;width:75vw;font-size:2vh}.dive-track{height:14vh;margin:1vh auto}.dive-meter p{font-size:1.8vh}}\nEOF\nnpx prettier --write labs/game > out/game/format-final.log\nnpx tsc -b tsconfig.check.json --pretty false\nnpm test -- --maxWorkers=1 > out/game/tests.log 2>&1\"","aggregated_outpu