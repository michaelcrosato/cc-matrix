{"type":"item.started","item":{"id":"item_135","type":"command_execution","command":"/bin/bash -lc \"mkdir -p labs/game/emitters\ncat > labs/game/emitters/retreat.ts <<'EOF'\n/** @file Original ripple, splash, stamp and calm effects, built on the native emitter system. */\nimport {defineEmitter} from '../../../engine';\nfor(const [id,color,velocity,gravity,count] of [\n ['ripple','#b9e1d0',[0,.1,0],0,18],\n ['splash','#eef9e9',[0,5,0],-8,70],\n ['stamp','#dcc794',[0,1,0],-2,24],\n ['calm','#c8e6b3',[0,.4,0],-.1,36],\n] as const)defineEmitter(\"'`emitter:retreat.${id}`,{description:`Little Fulcrum ${id}.`,area:id==='\"'ripple'?[1,.02,1]:[.4,.1,.4],velocity:[...velocity],spread:id==='splash'?3:1.3,gravity,drag:.7,life:[.6,1.4],size:id==='ripple'?[.07,.24]:[.09,0],color:[color,color],alpha:[.8,0],count,events:[\"'`retreat.${id}`]});\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import './ui/input';\\\", \\\"import './ui/input';\\\\nimport './emitters/retreat';\\\");p.write_text(s)\np=Path('labs/game/app.ts');s=p.read_text().replace('  uiTicks = 0;', '  uiTicks = 0;\\\\n  ended=false;').replace('    this.ui.interaction = () => {', '    this.ui.interaction = () => {\\\\n      if(this.ended)return true;').replace('  private uiLoop = (now: number): void => {', '  private uiLoop = (now: number): void => {\\\\n    if(this.ended)return;')\ns=s.replace(\\\"      if (sound) this.audio.play\\\", \\\"      if(['topple','diveSplash','moved','result'].includes(event.type)){const id=event.type==='moved'?'ripple':event.type==='result'?'stamp':'splash';frame.emit(\"'`emitter:retreat.${id}`,[f.feet[0],event.type==='\"'diveSplash'?2.2:f.feet[1]+.2,f.feet[2]],\"'`retreat-${event.seq}`,8);}'\"\\\\n      if (sound) this.audio.play\\\")\np.write_text(s)\np=Path('labs/game/hub/session.ts');s=p.read_text().replace('      this.ended = true;', '      this.ended = true;\\\\n      this.app.ended=true;');p.write_text(s)\np=Path('labs/game/tools/browser-check.py');s=p.read_text().replace(\\\"page.keyboard.down('d');page.wait_for_timeout(700);page.keyboard.up('d')\\\", \\\"page.keyboard.down('d');page.wait_for_function('__game.balance.x>.2',timeout=20000);page.keyboard.up('d')\\\")\ns=s.replace(\\\"page.wait_for_function('document.querySelector(\\\\\\\"[data-action=\\\\\\\\\\\\\\\"game.wobble.gain\\\\\\\\\\\\\\\"]\\\\\\\")')\\\", \\\"page.wait_for_selector('[data-action=\\\\\\\"game.wobble.gain\\\\\\\"]')\\\")\ns=s.replace(\\\"page.evaluate('__pad.axes[0]=.7');page.wait_for_timeout(600);page.evaluate('__pad.axes[0]=0')\\\", \\\"page.evaluate('__pad.axes[0]=.7');page.wait_for_function('__game.balance.x>.15',timeout=20000);page.evaluate('__pad.axes[0]=0')\\\")\np.write_text(s)\nPY\nnpx tsc -b tsconfig.check.json --pretty false\npython3 - <<'PY'\nimport ast\nfrom pathlib import Path\nast.parse(Path('labs/game/tools/browser-check.py').read_text())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
