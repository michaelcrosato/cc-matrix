{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"rg -n 'defineBody|defineProp|defineTerrain|defineBuild|defineMaterial|defineSky|defineClipSet' engine/sim-api.ts; sed -n '110,135p' engine/world/props/prop.ts; sed -n '146,171p' engine/index.ts; sed -n '300,320p' engine/sim/scene.ts; cat labs/game/index.html\"","aggregated_output":"250:export { defineProp } from './world/props/prop';\n\n/** The fields of a prop's body: its type, its shape and its material (engine/physics/bodies.ts's PROP_MATERIAL). */\nconst BODY_FIELDS = {\n  type: {\n    type: 'string',\n    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n    default: 'none',\n    description:\n      \"'dynamic' falls, slides and is knocked; 'fixed' stands where it is placed and blocks; 'kinematic' moves only as the sim drives it (a door on its hinge, WP 13.16); 'none' has none.\",\n  },\n  shape: { type: 'string', enum: PROP_SHAPES, default: 'box', description: 'Its shape.' },\n  size: vec3([1, 1, 1], \"A box's width, height and depth.\"),\n  radius: metres(0.5, \"A cylinder's, ball's or capsule's radius.\"),\n  height: metres(1, \"A cylinder's height, or a capsule's straight middle.\"),\n  density: {\n    type: 'number',\n    default: 57,\n    minimum: 0,\n    unit: 'kg/m³',\n    description: \"A hollow crate's: 24 kg at 0.75 m.\",\n  },\n  friction: { type: 'number', default: 0.7, minimum: 0, description: 'Coulomb friction.' },\n  restitution: { type: 'number', default: 0.05, minimum: 0, maximum: 1, description: 'Bounciness, 0 to 1.' },\n  linearDamping: { type: 'number', default: 0.3, minimum: 0, unit: '1/s', description: 'Slows its sliding.' },\n  angularDamping: { type: 'number', default: 0.8, minimum: 0, unit: '1/s', description: 'Slows its rolling.' },\n} as const satisfies Schema;\nexport { getBody } from './gfx/puppets/grammar';\nexport type { Body } from './gfx/puppets/grammar';\nexport type { BodySpec } from './gfx/puppets/grammar';\nexport type { BodyPart } from './gfx/puppets/grammar';\nexport type { BodyPoint } from './gfx/puppets/grammar';\nexport type { BodyLength } from './gfx/puppets/grammar';\nexport type { PartOptions } from './gfx/puppets/grammar';\nexport { compileBody } from './gfx/puppets/compile';\nexport { recolor } from './gfx/puppets/compile';\nexport type { CompiledBody } from './gfx/puppets/compile';\nexport type { BodyPiece } from './gfx/puppets/compile';\nexport type { PieceShape } from './gfx/puppets/compile';\nexport { createPuppet } from './gfx/puppets/draw';\nexport type { Puppet } from './gfx/puppets/draw';\nexport type { PuppetMaterials } from './gfx/puppets/draw';\nexport { createPuppetBatches } from './gfx/puppets/batches';\nexport type { PuppetBatches } from './gfx/puppets/batches';\nexport { createBlobShadows } from './gfx/puppets/blobShadow';\nexport { blobScale } from './gfx/puppets/blobShadow';\nexport type { BlobShadows } from './gfx/puppets/blobShadow';\n// The HTML/CSS overlay (WP 6.5): world-anchored labels and damage numbers placed from projected coordinates each\n// frame (three.js's CSS2DRenderer pattern), HUD lines and a crosshair over the canvas; ui.state() for tests.\nexport { createOverlay } from './ui/overlay';\nexport type { Overlay } from './ui/overlay';\nexport type { OverlayOptions } from './ui/overlay';\nexport type { HudOptions } from './ui/overlay';\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n","exit_code":0,"status":"completed"}}
