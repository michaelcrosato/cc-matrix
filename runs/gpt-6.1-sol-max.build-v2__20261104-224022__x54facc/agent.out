{"type":"item.completed","item":{"id":"item_130","type":"command_execution","command":"/bin/bash -lc \"rg -n 'StepUpR|demoStart|retreatSession|game.expert|adjust:' labs/game/cast/clips.ts labs/game/scenes/{pilot,flow,state,island}.ts labs/game/ui/screens/programme.ts labs/game/app.ts; tail -6 out/game/browser.log; wc -l labs/game/app.ts; sed -n '29,54p' labs/game/ui/screens/programme.ts\"","aggregated_output":"labs/game/app.ts:284:      ? 'look:retreatSession'\nlabs/game/scenes/island.ts:24:    demoStart: 0,\nlabs/game/cast/clips.ts:85:    StepUpR: strip({ hips: [0, 0, 115], legR: [50, 8, -65, 60, 0], armL: [70, 15, -40, 80, 0] }),\nlabs/game/scenes/pilot.ts:128:    pose = input.r > 0.5 && input.l < 0.5 ? 'StepUpR' : 'Step';\nlabs/game/scenes/pilot.ts:291:  if (f.demo && f.clock - f.demoStart >= 900) {\nlabs/game/ui/screens/programme.ts:22:        adjust: () => {\nlabs/game/ui/screens/programme.ts:24:            a.run('game.expert');\nlabs/game/ui/screens/programme.ts:72:        adjust: () => {\nlabs/game/ui/screens/programme.ts:74:            a.run('game.expert');\nlabs/game/scenes/state.ts:47:  demoStart: number;\nlabs/game/scenes/flow.ts:17:  f.demoStart = f.clock;\nlabs/game/scenes/flow.ts:196:  'game.expert': (w: W) => {\n382 labs/game/app.ts\n      {\n        id: ready ? 'sleep' : 'board',\n        label: ready ? (f.day === 5 ? 'Stay a little longer' : 'Sleep at your hut') : 'The Noticeboard',\n        detail: ready ? EVENING[Math.min(4, f.day - 1)] : 'Every activity, at your own pace.',\n        action: () => {\n          if (ready) {\n            a.run('game.sleep');\n            a.resume();\n          } else a.show('board');\n        },\n      },\n      { id: 'back', label: 'Back to the island', detail: 'There is no hurry. There are pebbles.', action: a.resume },\n    ],\n    {\n      wide: true,\n      extra: `<div class=\"programme-meta\"><span>${f.pebbles} pebbles in your cairn</span><span>${f.finds.length} / 20 found</span><span>${f.pebbles >= 10 ? 'Expert classes available' : `${10 - f.pebbles} pebbles to Expert classes`}</span></div>`,\n    },\n  );\n  a.ui.back = a.resume;\n}\nexport function noticeboard(a: ScreenApp, page: number): void {\n  const f = a.flow ?? a.save;\n  const met = new Set(DAYS.slice(0, Math.min(5, f.day)).flatMap((d) => d.events));\n  met.add('group');\n  const available = f.complete ? ACTIVITIES : ACTIVITIES.filter((event) => met.has(event.id));\n  const pages = Math.ceil(available.length / 5);\n","exit_code":0,"status":"completed"}}
