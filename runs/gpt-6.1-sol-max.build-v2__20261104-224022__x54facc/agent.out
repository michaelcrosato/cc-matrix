{"type":"item.started","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/events/balance.ts');s=p.read_text()\ns=s.replace(\\\"  if (r.id === 'check') {\\\", \\\"  if (r.id === 'check') {\\\")\ns=s.replace(\\\"        instruction:\\\\n          t < 6\\\\n            ? 'Have you ever stood on one foot when nobody was looking? Either foot answers.'\\\\n            : 'Keep your dot inside the ring. There is no hurry.',\\\", \\\"        instruction:t<6?(r.offset?'Tare: I know. Thank you for your answer.':['Have you ever stood on one foot when nobody was looking? Either foot answers.','Did you sleep on your left side? Either foot answers.','Have you been leaning toward a decision? Either foot answers.','Have you noticed the marbles? Either foot answers.','Do you trust a small rock? Either foot answers.'][Math.min(4,c.day-1)]):t>=18?'Good. Six targets next. They will wait.':'Keep your dot inside the ring. There is no hurry.',\\\")\ns=s.replace('ring: t > 18 ? 0.16 : 0.22,', 'ring:t>=14&&t<18?.16:.22,')\ns=s.replace(\\\"    if (t < 56) {\\\", \\\"    if(t>=48&&t<56)return {x:0,y:0,ring:.22,title:'A short recalibration',instruction:'The targets have been noted. One foot next.',pose:'Stand',foot:0};\\\\n    if (t < 56) {\\\")\ns=s.replace(\\\"    return {\\\\n      x: 0,\\\\n      y: 0,\\\\n      ring: 0.3,\\\", \\\"    if(t>=64)return {x:0,y:0,ring:.3,title:'Recalibrating',instruction:'Both feet may return. Tare is preparing one large number.',pose:'Stand',foot:0};\\\\n    return {\\\\n      x: 0,\\\\n      y: 0,\\\\n      ring: 0.3,\\\")\na=s.index(\\\"  if (r.id === 'check' && r.tick >= 24 * 60\\\");b=s.index(\\\"  if (r.id === 'pose' && input.act\\\",a)\ns=s[:a]+'''  if(r.id==='check'&&\"'!r.short){\n    const t=r.tick/60;\n    if(t<6&&(input.l>.5||input.r>.5))r.offset=input.l>.5?1:-1;\n    if(t>=6&&t<18){r.total+=inRing?1:0;r.samples++;}\n    if(t>=24&&t<48&&r.count<6){r.hold