{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat engine/gfx/cameras/fixed.ts | head -95; sed -n '1,90p' engine/sound/song.ts 2>/dev/null; sed -n '91,134p' engine/app/store.ts; rg -n 'interface ClipsSpec|function playClip|ClipsSpec|placeActor' engine/sim/actorClips.ts engine/sim/*.ts | head -35\"","aggregated_output":"/**\n * @file The fixed camera (PLAN.md WP 2.5): a perspective camera that stays where it is put, the prototype's \"Fix\"\n * (F): the hero is the devices' again while the camera watches. `stepFixed` and `fixedPose` are the pure steps;\n * `createFixedCamera` wraps them in a `Camera`.\n *\n * It ignores every input but `input.zoom`, which narrows its lens by 5° a step (`FLY_FOV_RANGE`, as the fly camera).\n * Made from another camera's pose (`from`: fixing the camera on screen), it keeps that camera's place and lens; an\n * orthographic view becomes a camera on the same line of sight, as far from the target as its lens frames the same\n * picture (`perspectiveFrom`, engine/gfx/cameras/pose.ts). Fixing a classic view on the spot is the view's own\n * `target` instead (engine/gfx/cameras/presets.ts), which keeps its projection.\n *\n * Invariants: nothing but `zoom` moves it; its pitch stays within ±π/2. Pure: each step returns a new state.\n *\n * Carried from `my-3d2dge:src/stress-world/40-cameras.js:116-119, 251-258` (the fixed pose, `toggleFix`).\n *\n * @example\n * const fixed = createFixedCamera({ position: [0, 3, -6], yaw: 0, pitch: -0.3, fov: 60 });\n * fixed.update({ move: [0, 1, 0], look: [1, 1] }, 1).position; // [0, 3, -6]: it stays\n * fixed.update({ zoom: 2 }).fov; // 50\n * fixed.code(); // 'cam3=fixed,0,3,-6,0,-17.19,50'\n * @see engine/gfx/cameras/fixed.test.ts\n */\nimport { MathUtils } from '../../core/math';\nimport type { FreeSpec } from './codes';\nimport { FLY_FOV, FLY_FOV_RANGE } from './fly';\nimport {\n  cameraFrom,\n  makePose,\n  perspectiveFrom,\n  pointProblems,\n  rangeProblems,\n  refuse,\n  type Camera,\n  type CameraInput,\n  type CameraPose,\n  type Vec3,\n} from './pose';\n\n/** A fixed camera's state: plain data. */\nexport interface FixedState {\n  readonly position: Vec3;\n  readonly yaw: number;\n  readonly pitch: number;\n  readonly fov: number;\n}\n\n/** Options for a fixed camera: its code's data, and the pose to fix when the code has no position. */\nexport interface FixedOptions extends Omit<FreeSpec, 'type'> {\n  readonly from?: CameraPose;\n}\n\n/** A checked fixed state for `options`: the code's place, else `from`'s, else the origin at eye height. */\nexport function fixedState(options: FixedOptions = {}): FixedState {\n  const lens = options.from?.projection === 'perspective' ? options.from.fov : FLY_FOV;\n  const fov = options.fov ?? lens;\n  const start = options.position ? null : options.from ? perspectiveFrom(options.from, fov) : null;\n  const state: FixedState = {\n    position: [...(options.position ?? start?.position ?? [0, 1.7, 0])],\n    yaw: options.yaw ?? start?.yaw ?? 0,\n    pitch: options.pitch ?? start?.pitch ?? 0,\n    fov,\n  };\n  refuse('the fixed camera', [\n    ...pointProblems('position', state.position),\n    ...rangeProblems({\n      yaw: [state.yaw, -1e6, 1e6],\n      pitch: [state.pitch, -Math.PI / 2, Math.PI / 2],\n      fov: [fov, 1, 179],\n    }),\n  ]);\n  return state;\n}\n\n/** Steps a fixed camera: only `input.zoom` changes it (its lens). */\nexport function stepFixed(state: FixedState, input: CameraInput): FixedState {\n  return input.zoom ? { ...state, fov: MathUtils.clamp(state.fov - input.zoom * 5, ...FLY_FOV_RANGE) } : state;\n}\n\n/** The fixed camera's pose. */\nexport function fixedPose(state: FixedState): CameraPose {\n  return makePose({\n    position: state.position,\n    yaw: state.yaw,\n    pitch: state.pitch,\n    fov: state.fov,\n    near: 0.1,\n    far: 500,\n  });\n}\n\n/** The fixed camera's code data. */\nexport function fixedSpec(state: FixedState): FreeSpec {\n  return { type: 'fixed', position: state.position, yaw: state.yaw, pitch: state.pitch, fov: state.fov };\n}\n\nexport interface Store {\n  readonly prefix: string;\n  readonly version: number;\n  readonly mode: StoreMode;\n  /** Whether values outlive the page (`play` on a working `localStorage`). */\n  readonly persistent: boolean;\n  /** Where it writes. */\n  readonly backend: StoreBackend;\n  /** The value kept under `key`, copied, or `fallback` (none kept, unreadable, or of another version unmigrated). */\n  get<T>(key: string, fallback: T): T;\n  /** Keeps `value` (plain data) under `key`; false when storage refused it. Throws `APP_BAD_STORE` for a bad value. */\n  set(key: string, value: unknown): boolean;\n  remove(key: string): void;\n  /** This store's keys, prefix off, sorted. */\n  keys(): string[];\n  /** Removes every key under the prefix. */\n  clear(): void;\n}\n\n/** A backend in memory: what Node, refused storage and the isolated modes write to. */\nexport function memoryBackend(): StoreBackend {\n  const map = new Map<string, string>();\n  return {\n    getItem: (key) => map.get(key) ?? null,\n    setItem: (key, value) => void map.set(key, String(value)),\n    removeItem: (key) => void map.delete(key),\n    get length() {\n      return map.size;\n    },\n    key: (index) => [...map.keys()][index] ?? null,\n  };\n}\n\n/**\n * The store as the two string calls of `localStorage` (`getItem`, `setItem`), for a module that saves text of its own:\n * the bindings (engine/input/bindings.ts), which the engine saves through the page's store (`createEngine({ store })`).\n * Each text is kept as its JSON value in the store's envelope, so the store's prefix and mode hold for it; text that is\n * not JSON is not kept, as a refused write.\n */\nexport function textStorage(store: Store): {\n  getItem(key: string): string | null;\n  setItem(key: string, text: string): void;\n} {\n  return {\nengine/sim/actorClips.ts:51:export interface ClipsSpec {\nengine/sim/actorClips.ts:93:export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\nengine/sim/actorClips.ts:109:export function addClips<C extends object>(world: World<C>, id: number, spec: ClipsSpec): ClipsData {\nengine/sim/actorClips.ts:129:export function playClip<C extends object>(world: World<C>, id: number, clip: string, play?: ClipPlay): ClipLayerState {\nengine/sim/ragdolls.ts:46:import { placeActor } from './actors';\nengine/sim/ragdolls.ts:209:    placeActor(w, e.id, [rest.at.x, e.actor.y, rest.at.z], rest.yaw); // on the floor its pelvis lay over\nengine/sim/movementApi.ts:14: * // import { addZipline, placeActor } from '../../../engine/sim-api';\nengine/sim/movementApi.ts:38:export { placeActor } from './actors';\nengine/sim/actors.ts:66:import { clipsFor, defineClipKinds, type ClipsSpec } from './actorClips';\nengine/sim/actors.ts:209:  clips?: ClipsSpec;\nengine/sim/actors.ts:261:export function placeActor<C extends object>(\nengine/sim/actors.ts:270:  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\nengine/sim/actors.ts:272:  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no movement model`, expected: 'no crouch: only an actor on a movement model (its component motion) crouches' }); // prettier-ignore\nengine/sim/actors.ts:275:  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\nengine/sim/actors.ts:280:    const given = vec(at, 'placeActor(at)');\nengine/sim/actors.ts:283:    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crouch ? 'crouched' : 'standing'} hull, ${tall} m tall (it would sink through the floor)`, expected: motion && !options.crouch ? 'a place with headroom, or { crouch: true } under a low ceiling' : 'a place with headroom' }); // prettier-ignore\nengine/sim/devActions.ts:20: *   (`placeActor`, engine/sim/actors.ts);\nengine/sim/devActions.ts:45:import { placeActor, type ActorComponent } from './actors';\nengine/sim/devActions.ts:201:      placeActor(w, actorIn(w, 'travel', id).id, point as [number, number, number], yaw as number | undefined);\nengine/sim/actorClips.ts:51:export interface ClipsSpec {\nengine/sim/actorClips.ts:93:export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\nengine/sim/actorClips.ts:109:export function addClips<C extends object>(world: World<C>, id: number, spec: ClipsSpec): ClipsData {\nengine/sim/actorClips.ts:129:export function playClip<C extends object>(world: World<C>, id: number, clip: string, play?: ClipPlay): ClipLayerState {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"sed -n '20,105p' engine/gfx/puppets/grammar.ts; sed -n '1,125p' engine/gfx/puppets/bodies/actor.ts 2>/dev/null; sed -n '51,70p' engine/sim/actorClips.ts; sed -n '152,180p' engine/sim/props.ts; rg -n 'SceneAction|actions:' engine/sim/scene.ts; sed -n '1,85p' engine/audio/data/song.ts; sed -n '1,65p' engine/gfx/materials/material.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"sed -n '20,105p' engine/gfx/puppets/grammar.ts; sed -n '1,125p' engine/gfx/puppets/bodies/actor.ts 2>/dev/null; sed -n '51,70p' engine/sim/actorClips.ts; sed -n '152,180p' engine/sim/props.ts; rg -n 'SceneAction|actions:' engine/sim/scene.ts; sed -n '1,85p' engine/audio/data/song.ts; sed -n '1,65p' engine/gfx/materials/material.ts\"","aggregated_output":" * Points: a joint (`'shinL'`), a socket (`'eyeL'`, `'weaponR'`, `'back'`), `[f, r, u]` (forward, right and up from\n * the root), `['lerp', a, b, t]` or `['off', p, f, r, u]` (p moved forward, right and up). Every point is a rest\n * position: at rest every bone's frame is the character's (+Z forward, +Y up, right is −X). A part rides one bone,\n * rigidly: its `on`, else the bone of its first point that names a joint or socket, else the root.\n *\n * `mirror` lists parts written for the left side; each is drawn on the right too, its L and R names swapped and its\n * right offsets negated. `slots` maps slot names to hex colours; a palette overrides them per character. Eyes draw\n * with `glowMaterial` (unlit), the rest with `material`. `builds` gives a build's own `limbRadius` and `torsoRadius`\n * by its id: the builds' drawing fields (my-3d2dge's `limbW` / 2 and `torsoW`, in metres).\n *\n * Invariants: a body is checked when defined (`CORE_BAD_SPEC` names each problem, `bodyProblems`); a missing id\n * stands in as `body:humanoid`. Nothing here draws or reaches the sim.\n *\n * Carried from the lab3d grammar, `my-3d2dge:src/lab3d/40-characters.js:8-48`, in metres on bones.\n *\n * @example\n * mirrorPart(['limb', 'thighL', ['off', 'shinL', 0, 0.02, 0], 0.07, 0.06, 'pants']);\n * // ['limb', 'thighR', ['off', 'shinR', 0, -0.02, 0], 0.07, 0.06, 'pants']\n * getBody('body:humanoid').slots.skin; // '#f1c7a0'\n * @see engine/gfx/puppets/grammar.test.ts\n */\nimport { JOINTS, SOCKETS } from '../../anim/skeleton';\nimport { hex } from '../../core/color';\nimport { didYouMean } from '../../core/log';\nimport { galleryField, type Gallery } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { Schema } from '../../core/schema';\nimport { HUMANOID_BODY } from './bodies/humanoid';\n\n/** A size or an offset: metres, or `[k, ref]`, k times the head radius, the limb radius or the torso radius. */\nexport type BodyLength = number | readonly [number, 'head' | 'limb' | 'torso'];\n\n/** Where a part's end lies (see the file comment). */\nexport type BodyPoint =\n  | string\n  | readonly [BodyLength, BodyLength, BodyLength]\n  | readonly ['lerp', BodyPoint, BodyPoint, number]\n  | readonly ['off', BodyPoint, BodyLength, BodyLength, BodyLength];\n\n/** A part's options: the bone it rides (a joint, or `'root'`). */\nexport interface PartOptions {\n  on?: string;\n}\n\n/** One part, one line (see the file comment). */\nexport type BodyPart =\n  | readonly ['limb', BodyPoint, BodyPoint, BodyLength, BodyLength, string, PartOptions?]\n  | readonly ['curve', BodyPoint, BodyPoint, number, BodyLength, BodyLength, string, PartOptions?]\n  | readonly ['ball', BodyPoint, BodyLength | readonly [BodyLength, BodyLength, BodyLength], string, PartOptions?]\n  | readonly ['eye', BodyPoint, BodyLength, string, PartOptions?]\n  | readonly ['box', BodyPoint, BodyPoint, BodyLength, BodyLength, string, PartOptions?]\n  | readonly ['cone', BodyPoint, BodyPoint, BodyLength, string, PartOptions?]\n  | readonly ['blade', BodyPoint, BodyPoint, BodyLength, BodyLength, string, PartOptions?]\n  | readonly ['cape', BodyPoint, BodyPoint, BodyLength, string, PartOptions?]\n  | readonly ['hair', BodyPoint, BodyLength, number, BodyLength, BodyLength, string, PartOptions?];\n\n/**\n * Each part type's arguments after its name: `p` a point, `s` a size, `r` a size or three, `n` a number, `c` a count\n * (1–64), `k` the slot.\n */\nexport const PART_TYPES = {\n  limb: 'ppssk',\n  curve: 'ppnssk',\n  ball: 'prk',\n  eye: 'psk',\n  box: 'ppssk',\n  cone: 'ppsk',\n  blade: 'ppssk',\n  cape: 'ppsk',\n  hair: 'pscssk',\n} as const;\n\n/** A part type's name. */\nexport type PartType = keyof typeof PART_TYPES;\n\n/** A length field of the body schema, in metres. */\nconst metres = (value: number, description: string) =>\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\n\n/** The fields of a `body` entry. */\nexport const BODY_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the body is, in plain sentences.' },\n  slots: { type: 'object', default: {}, description: 'Material slots: each name with its hex colour (the palette).' },\n  parts: { type: 'array', default: [], description: 'The parts, one line each (engine/gfx/puppets/grammar.ts).' },\n  mirror: { type: 'array', default: [], description: 'Parts written for the left side, drawn on both sides.' },\n  limbRadius: metres(0.0625, \"A limb's radius, for sizes written [k, 'limb'] (my-3d2dge's limbW / 2).\"),\nexport interface ClipsSpec {\n  /** The clip sets it plays from, by id (`clipset:quaternius`): a bare clip name is the first set's. */\n  sets: readonly string[];\n  /** Contact IK and the lift when posed (true). */\n  ik?: boolean;\n  /** A blade held in the right hand, m, kept above the floor (0). */\n  blade?: number;\n  /** The clip it plays from the start (`SET/Clip`, or the clip and how it plays: the layer's `play`); none when absent. */\n  play?: string | ({ clip: string } & ClipPlay);\n}\n\n/** An entity with an animated actor and its clips. */\ntype ClipActor = Pick<ActorComponents, 'actor' | 'animator'> & { id: number; clips: ClipsData };\n\n/** The layers of each world (see the file comment). */\nconst pools = new WeakMap<World, ClipLayerPool>();\n\n/** The pool of `w`, pruned of the despawned. */\nfunction poolOf(w: World): ClipLayerPool {\n  let pool = pools.get(w);\nexport function spawnProp<C extends object, E extends EventMap>(\n  world: World<C, E>,\n  placement: PropPlacement,\n  options: SpawnPropOptions = {},\n): number {\n  const w = world as unknown as World;\n  const entry = getProp(placement.prop);\n  const prop = entry.id;\n  const spec = propBody({ ...placement, prop }, undefined, options.as);\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\n  const [x, y, z] = position;\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\n  const switchable = options.on !== undefined || options.group !== undefined;\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\n}\n\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\n  if (body < 0) return -1;\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\n}\n\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\nexport function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\n62:export type SceneAction<W> = (w: W, args: unknown) => void;\n97:  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\n129:  actions: {\n/**\n * @file The `song` kind (PLAN.md WP 9.2, I-23; doctrines: Assets, Agent-operable): a looping tune as data, written\n * in tracker notation, its tracks played on the DSP core's waves and its drums from a kit of `sfx` entries. The\n * engine's five songs (songs.ts) are its entries; a game adds its own with `defineSong`, and `x new song` scaffolds one.\n *\n * A song has a tempo (`bpm`), `steps` per beat and `beats` per bar, and tracks. A track's `notes` hold one token per\n * step: a note (`C4`, `F#3`, `Bb2`), `-` holding the note before it, `.` a rest, and `|` a bar line, which takes no\n * step. A `drums` track writes kit tokens instead (`k s h o c t`, engine/audio/data/drums.ts). Each track loops on its\n * own length; `intensity` is the music intensity from which a track joins (0: always), for the runtime's layers.\n *\n * Invariants:\n * - The checks (`songProblems`, run when a song is defined): every token is a note, a hold after a note, a rest or a\n *   kit token; a `|` falls on a bar line; each track fills whole bars or divides one; every track's length divides the\n *   song's (its longest track's), which is whole bars; a track's voice is one `render` accepts; ranges per field.\n * - A note plays from its step for its held steps times `gate`, on a held envelope with the track's attack, at the\n *   note's pitch times 2^octave. A drum token plays its kit entry's voices (engine/audio/data/sfx.ts), their gain\n *   times the track's `vol` / 0.18, so a track at the default 0.18 plays the kit as written. Holds never wrap round a\n *   track's end. `songVoices` lays out one pass of the song, track by track; `renderSong` renders it with the DSP,\n *   at least a pass long (passes played back to back keep time), so the same song, seed and rate give the same bits\n *   in Node and Chromium.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:3792-3836` (`music`, `_note`: the notation, the hold, the gate, the drum\n * scaling), as data rendered offline; the scheduling belongs to the runtime (WP 9.3).\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const registry = createRegistry();\n * const riff = defineSong('song:riff', { beats: 2, tracks: [{ notes: 'C4 - E4 - G4 - E4 -', wave: 'pluck' }] }, registry);\n * songTiming(riff); // { stepSeconds: 0.125, barSteps: 8, steps: 8, seconds: 1 }: 120 bpm, 2 beats a bar\n * renderSong('song:title').length > 0; // true\n * @see engine/audio/data/song.test.ts\n */\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\nimport type { Schema } from '../../core/schema';\nimport { TONAL_WAVES } from '../dsp/osc';\nimport { DEFAULT_RATE, render } from '../dsp/render';\nimport { MAX_SECONDS, normalizeSound, noteFreq, type Voice } from '../dsp/voice';\nimport { DRUM_KIT } from './drums';\nimport { sfxVoices } from './sfx';\nimport { SONGS } from './songs';\n\n/** The waves a track plays: the tonal ones, the pluck, and `drums` (kit tokens). */\nexport const TRACK_WAVES = [...TONAL_WAVES, 'pluck', 'drums'] as const;\n\n/** One of the track waves. */\nexport type TrackWave = (typeof TRACK_WAVES)[number];\n\n/** One track of a song. */\nexport interface SongTrack {\n  /** One token per step: a note, `-` (hold), `.` (rest) or a kit token; `|` marks a bar line. */\n  notes: string;\n  /** `square` by default; `drums` plays kit tokens. */\n  wave?: TrackWave;\n  /** The notes' gain; 0.18 by default (and a drum track's 0.18 plays the kit as written). */\n  vol?: number;\n  /** Octaves added to every note; 0 by default. */\n  octave?: number;\n  /** The share of its held steps a note sounds for; 0.9 by default. */\n  gate?: number;\n  /** Seconds from silence to full volume; 0.006 by default. */\n  attack?: number;\n  /** Vibrato: `[rate in Hz, depth as a fraction of the pitch]`. */\n  vib?: readonly [number, number];\n  /** The music intensity from which the track plays, from 0 (always) to 1; 0 by default. */\n  intensity?: number;\n}\n\n/** What `defineSong` takes: the tracks, and every other field optional. */\nexport interface SongSpec {\n  /** Beats per minute; 120 by default. */\n  bpm?: number;\n  /** Steps per beat; 4 (sixteenth notes) by default. */\n  steps?: number;\n  /** Beats per bar; 4 by default. */\n  beats?: number;\n  /** Loops when it ends; true by default. */\n  loop?: boolean;\n  /** The tracks, played together. */\n  tracks: readonly SongTrack[];\n  /** A drum track's tokens and the `sfx` ids they play; the engine's kit by default. */\n  kit?: Readonly<Record<string, string>>;\n}\n\n/** A `song` entry: the spec with its defaults filled, frozen. */\nexport interface Song {\n/**\n * @file The material registry (PLAN.md WP 2.3, §6.6, §6.7, I-49): the registry kind `material`, one entry per\n * material, as data with the parameters agents know from three.js's classic materials: `color`, `map`, `roughness`,\n * `metalness`, `emissive`, `emissiveIntensity`, `normalScale`, `opacity`, `transparent`, `alphaTest`, `side`,\n * `flatShading`, `vertexColors`, `fog`, `depthWrite`, plus `unlit` (glTF's word: drawn without lights). How a\n * material is drawn is the engine's business (engine/gfx/materials/compile.ts): v1 compiles the same data to\n * `MeshLambertMaterial` or `MeshBasicMaterial`, later WPs to better node materials and styles (WP 7.2), without the\n * data changing (doctrine: Common ground outside, Quality under the hood inside).\n *\n * `map` names a texture generator (engine/gfx/textures/texture.ts): an id (`'texture:brick'`) or\n * `{ texture, seed, params, size, look, repeat }`. One generator fills every slot: its colour is the `map`, its\n * height the normal map (scaled by `normalScale`), its roughness the roughness map (used by styles that shade with\n * roughness) and its emissive the emissive map.\n *\n * `defineMaterial(id, spec)` adds one (a game's own materials live with the game); `materialKind(registry)` declares\n * the kind with the engine's built-in materials (engine/gfx/materials/builtins.ts), and `material:default` stands in,\n * with a warning, for a missing id.\n *\n * Invariants: colours are hex strings; a map's texture exists when the material is defined (define textures\n * first), and its parameters, size, look and repeat are checked then, so a bad map fails at `defineMaterial`, never\n * at the first frame. Problems raise `CORE_BAD_SPEC` naming each, as every registry kind does.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const reg = createRegistry();\n * defineMaterial('material:mossyBrick', { color: '#c8d8b0', map: { texture: 'texture:brick', seed: 4 } }, reg);\n * reg.get('material', 'material:mossyBrick').roughness; // 1, the default\n * textureRefOf(reg.get('material', 'material:mossyBrick').map); // { texture: 'texture:brick', seed: 4, … }\n * @see engine/gfx/materials/material.test.ts\n */\nimport { hex } from '../../core/color';\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { isPlainObject, type Schema, type SpecOf } from '../../core/schema';\nimport { textureSampler, type TextureRef } from '../textures/bake';\nimport { textureKind } from '../textures/texture';\nimport type { TextureLook } from '../textures/types';\nimport { BUILT_IN_MATERIALS } from './builtins';\n\n/** The fields of a `material` entry: three.js's classic material parameters, as data. */\nexport const MATERIAL_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is for, in plain sentences.' },\n  color: {\n    type: 'string',\n    default: '#ffffff',\n    description: \"The base colour, hex; it multiplies the map (three.js's color).\",\n  },\n  map: {\n    type: 'any',\n    default: null,\n    description:\n      \"The texture generator that fills the maps: a texture id ('texture:brick'), or { texture, seed, params, size, look, repeat }; null for none. Its height becomes the normal map, its roughness the roughness map, its emissive the emissive map.\",\n  },\n  roughness: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 1,\n    description: 'Microfacet roughness, 0 (mirror) to 1 (matte), for the styles that shade with it (pbr, WP 7.2).',\n  },\n  metalness: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 1,\n","exit_code":0,"status":"completed"}}
