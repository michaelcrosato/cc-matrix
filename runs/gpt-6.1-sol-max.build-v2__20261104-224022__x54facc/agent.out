`${build}+${body}`);\nengine/gfx/puppets/actors.ts:237:        const body = (entity.puppet as { body?: string } | undefined)?.body ?? ACTOR_BODY;\nrg: engine/gfx/api.ts: No such file or directory (os error 2)\nengine/sim-api.ts:64:export { fromCamera } from './input/intents';\nengine/index.ts:108:export type { CameraInfo } from './app/view';\nengine/index.ts:115:export type { CameraPose } from './gfx/cameras/pose';\nengine/index.ts:178:export type { OverlayCamera } from './ui/labels';\n  voices: string[];\n  mixer: MixerInfo | null;\n  music: MusicPosition | null;\n  listener: ListenerPose | null;\n  /** Event type → the stinger it plays. */\n  bindings: Record<string, string>;\n}\n\n/** A page's sound (see the file comment). */\nexport interface Audio {\n  readonly state: AudioState;\n  /** The context, once there is one. */\n  readonly context: BaseAudioContext | null;\n  play(id: string, options?: PlayOptions): Sound | null;\n  footstep(surface: string, position?: Vec3, options?: PlayOptions): Sound | null;\n  event(type: string, payload?: unknown): Sound | null;\n  bind(type: string, id: string | null): void;\n  /** Plays a song (null stops), on the next bar line of the one playing (music.ts). */\n  music(id: string | null, options?: MusicChange & { intensity?: number }): void;\n  /** Sets the music's intensity, 0 to 1, on the next beat (music.ts). */\n  intensity(value: number, options?: MusicChange): void;\n  /** Plays an effect or a song once on the music bus, on the next beat (music.ts). */\n  stinger(id: string, options?: MusicChange & { vol?: number }): void;\n  /** Once per rendered frame: the listener follows `pose`, and placed sounds are occluded through `queries`. */\n  update(pose?: ListenerPose, queries?: QueryView): void;\n  volume(bus: AudioBus | 'master', value?: number): number;\n  mute(on?: boolean): boolean;\n  /** `true` holds a duck of the music and ambience, `false` lets it go, a number ducks for that many seconds. */\n  duck(on: boolean | number): void;\n  room(room: RoomName | RoomSpec): void;\n  info(): AudioInfo;\n  /** Stops listening and closes the context it made. */\n  close(): Promise<void>;\n}\n\n/** Makes a page's sound (see the file comment). */\nexport function createAudio(options: AudioOptions = {}): Audio {\n  const registry = options.registry ?? sharedRegistry;\n  const out = options.log ?? sharedLog;\n  sfxKind(registry);\n  songKind(registry);\ntools/templates/camera/camera.ts.tmpl\ntools/templates/camera/camera.test.ts.tmpl\ntools/templates/camera/template.json\ntools/templates/song/song.test.ts.tmpl\ntools/templates/sfx/sfx.test.ts.tmpl\ntools/templates/song/song.ts.tmpl\ntools/templates/song/template.json\ntools/templates/sfx/sfx.ts.tmpl\ntools/templates/sfx/template.json\ntools/templates/body/body.ts.tmpl\ntools/templates/rig/rig.ts.tmpl\ntools/templates/body/template.json\ntools/templates/body/body.test.ts.tmpl\ntools/templates/movement/movement.test.ts.tmpl\ntools/templates/movement/movement.ts.tmpl\ntools/templates/emitter/emitter.test.ts.tmpl\ntools/templates/emitter/template.json\ntools/templates/emitter/emitter.ts.tmpl\ntools/templates/movement/template.json\ntools/templates/prop/prop.ts.tmpl\ntools/templates/scene/scene.ts.tmpl\ntools/templates/scene/scene.test.ts.tmpl\ntools/templates/scene/template.json\ntools/templates/prop/prop.test.ts.tmpl\ntools/templates/prop/template.json\ntools/templates/move/move.test.ts.tmpl\ntools/templates/geometry/geometry.ts.tmpl\ntools/templates/geometry/geometry.test.ts.tmpl\ntools/templates/geometry/template.json\ntools/templates/rig/rig.test.ts.tmpl\ntools/templates/weapon/weapon.test.ts.tmpl\ntools/templates/weapon/weapon.ts.tmpl\ntools/templates/weapon/template.json\ntools/templates/rig/template.json\ntools/templates/module/module.ts.tmpl\n","exit_code":0,"status":"completed"}}
