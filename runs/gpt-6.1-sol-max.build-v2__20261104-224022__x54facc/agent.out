.clock++;', \\\"  f.clock++;\\\\n  for(const entity of w.query('actor'))entity.actor.intents={};\\\")\np.write_text(s)\np=Path('labs/game/ui/glyphs.ts');s=p.read_text().replace('    text =\\\\n      (', '    text = KEY_LABELS[action]??\\\\n      (');p.write_text(s)\nPY\ncat >> labs/game/scenes/game.test.ts <<'EOF'\n\nit('idle exploration remains plain data, and title/sit modes clear the last walking input',async()=>{\n const h=await createHeadless({scene:island,seed:43}) as GameInspector;h.actions.run('game.begin');h.step(30);expect(()=>h.hash()).not.toThrow();expect(()=>h.capture()).not.toThrow();\n h.step(30,{move:[1,0]});h.actions.run('game.front');h.step(60);const hero=flow(h).hero;const actor=h.get(hero)?.actor as {x:number;z:number};expect(Math.abs(actor.x+57.4)).toBeLessThan(.1);expect(Math.abs(actor.z-20)).toBeLessThan(.1);expect(h.errors).toHaveLength(0);\n});\nEOF\nnpx prettier --write labs/game > out/game/format-final.log\nnpx tsc -b tsconfig.check.json --pretty false\nnpm test -- --maxWorkers=1 > out/game/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
