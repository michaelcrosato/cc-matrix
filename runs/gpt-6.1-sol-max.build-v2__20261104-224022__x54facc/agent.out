ard.up('d')\\\")\ns=s.replace(\\\"page.keyboard.press('ArrowDown');page.keyboard.press('ArrowDown');page.keyboard.press('Enter')\\\", \\\"page.keyboard.press('ArrowDown',delay=80);page.keyboard.press('ArrowDown',delay=80);page.keyboard.press('Enter',delay=80)\\\")\ns=s.replace(\\\"  page.wait_for_timeout(240)\\\", \\\"  page.wait_for_function('__game.lastDevice===\\\\\\\"pad\\\\\\\"',timeout=10000)\\\\n  page.wait_for_timeout(120)\\\")\ns=s.replace(\\\"   page.wait_for_timeout(450)\\\", \\\"   page.wait_for_function('([id,tick])=>__game.screen===\\\\\\\"play\\\\\\\" && __game.event===id && __game.tick>=tick',[event,tick],timeout=20000)\\\\n   page.wait_for_timeout(200)\\\")\n# Playwright wait_for_function's arg is keyword-only.\ns=s.replace(\\\"',[event,tick],timeout\\\", \\\"',arg=[event,tick],timeout\\\")\np.write_text(s)\np=Path('labs/game/tools/flow-debug.py');s=p.read_text().replace(\\\"errors:__engine.errors\\\", \\\"errors:__engine.errors,pads:navigator.getGamepads(),fake:window.__pad,src:navigator.getGamepads.toString()\\\")\np.write_text(s)\nPY\ncat >> labs/game/ui/theme.css <<'EOF'\n.screen-pause .menu-panel{top:17vh;width:50vw}.screen-pause .description{max-width:50vw;line-height:1.4;margin:1.2vh 0}.screen-pause .menu-list{margin-top:2vh;gap:.2vh}.screen-pause .menu-choice{min-height:6.6vh;padding-top:1vh;padding-bottom:1vh}.screen-about .about-copy{max-height:40vh}.screen-about .menu-list{margin-top:1vh}.screen-about h1{font-size:5.4vh}\n@media(max-aspect-ratio:1/1){.screen-pause .menu-panel{width:84vw}.screen-pause .description{max-width:84vw}.screen-about .about-copy{max-height:43vh}}\nEOF\nnpx prettier --write labs/game > out/game/format.log\nnode labs/game/tools/onefile.mjs\npython3 -u labs/game/tools/flow-debug.py > out/game/flow-debug.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_126","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/hub-check.py <<'EOF'\n# @file Real upstream AI Hub harness on an ephemeral loopback server, with engine-state assertions too.\nimport http.server,threading,json,sys\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nROOT=Path.cwd();GAME=ROOT.parent/'Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261104-224022.html'\nclass Handler(http.server.SimpleHTTPRequestHandler):\n def translate_path(self,path):\n  name=path.split('?')[0].lstrip('/')\n  if name=='game.html':return str(GAME)\n  if name in ['harness.html','bridge.js','round.js']:return str(ROOT/'.cache/hub'/name)\n  return str(ROOT/'out'/'missing-resource')\n def log_message(self,*args):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler)\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nbase='http://127.0.0.1:'+str(server.server_port)\nfailures=[];passed=0;reports=[]\nFLAGS=['--no-sandbox','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader']\ntry:\n with sync_playwright() as p:\n  for n,scenario in [(2,''),(3,''),(4,''),(3,'host-leave')]:\n   browser=p.chromium.launch(headless=True,args=FLAGS)\n   page=browser.new_page(viewport={'width':1600,'height':1000})\n   errors=[];warnings=[]\n   page.on('pageerror',lambda e:errors.append(str(e)))\n   page.on('console',lambda e:warnings.append(e.text) if e.text.startswith('[AIHub]') else None)\n   label=f'{n} players'+(' / '+scenario if scenario else '')\n   try:\n    response=page.request.get(base+'/game.html')\n    assert 'Wobble Fit' in response.text(),'Server did not serve this game'\n    url=base+'/harness.html?game=game.html&players='+str(n)+'&latency=150&jitter=50&loss=5&auto=1&play=8000'+('&scenario='+scenario if scenario else '')\n    page.goto(url)\n    page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=150000)\n    report=page.evaluate('window.__hubCheck');report['case']=label\n    frames=[]\n    for frame in page.frames[1:]:\n     if 'game.html' not in frame.url:continue\n     state=frame.evaluate('({ready:__engine?.ready,errors:__engine?.errors,ghosts:__engine?.state?.(\\\"ghost\\\")?.entities?.length,game:window.__game,hub:AIHub.active})')\n     frames.append(state)\n     assert state['ready'] is True,'Protocol passed but engine is not ready'\n     assert not state['errors'],'Engine errors: '+str(state['errors'])\n     assert state['ghosts']>=1,'No ghost entity on neighbouring mat'\n    report['frames']=frames;reports.append(report)\n    assert report.get('pass') is True,'Harness checks: '+json.dumps(report)\n    assert not errors and not warnings,str(errors+warnings)\n    if n==2:page.screenshot(path='out/game/hub-two-players.png')\n    passed+=1\n   except Exception as e:\n    failures.append(label+': '+str(e).split('\\\\n')[0]);print('FAIL '+failures[-1],flush=True)\n    page.screenshot(path=f'out/game/hub-failure-{n}-{scenario or \\\"round\\\"}.png')\n   browser.close()\nfinally:server.shutdown();server.server_close()\nPath('out/game/hub-report.json').write_text(json.dumps({'passed':passed,'failures':failures,'reports':reports},indent=2)+'\\\\n')\nprint(f'{passed} hub checks passed; {len(failures)} failed')\nsys.exit(bool(failures))\nEOF\npython3 -m py_compile labs/game/tools/browser-check.py labs/game/tools/hub-check.py\nnpm test -- --maxWorkers=1 > out/game/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
