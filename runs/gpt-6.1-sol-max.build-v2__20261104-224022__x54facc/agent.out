{"type":"item.completed","item":{"id":"item_207","type":"command_execution","command":"/bin/bash -lc \"rg -n 'createStageProps|createPropMeshes|props =|props:' engine/gfx/stage.ts engine/gfx/*.ts | head -38; sed -n '165,212p' engine/gfx/stage.ts; sed -n '110,124p' engine/gfx/props.ts; sed -n '160,190p' engine/gfx/stageProps.ts 2>/dev/null; rg -n 'props:' engine/app/engine.ts engine/app/view.ts; sed -n '180,225p' engine/gfx/props.ts\"","aggregated_output":"engine/gfx/props.ts:2: * @file Props drawn (PLAN.md WP 4.5, §6.1): `createPropMeshes({ materials })` draws the `prop` entries\nengine/gfx/props.ts:30: * const props = createPropMeshes({ materials: createMaterialLibrary() });\nengine/gfx/props.ts:109:/** What `createPropMeshes` takes. */\nengine/gfx/props.ts:159:export function createPropMeshes(options: PropMeshesOptions): PropMeshes {\nengine/gfx/props.ts:220:  const props: PropMeshes = {\nengine/gfx/stage.ts:60:import { createStageProps, type StageProps } from './stageProps';\nengine/gfx/stage.ts:121:  readonly props: StageProps;\nengine/gfx/stage.ts:201:  const props = createStageProps({ scene, materials: options.materials, registry: options.registry });\nengine/gfx/stage.ts:60:import { createStageProps, type StageProps } from './stageProps';\nengine/gfx/stage.ts:121:  readonly props: StageProps;\nengine/gfx/stage.ts:201:  const props = createStageProps({ scene, materials: options.materials, registry: options.registry });\nengine/gfx/stageShells.ts:23: * // const shells = createStageShells({ props: stage.props, actors: stage.actors });\nengine/gfx/stageShells.ts:52:  count(): { props: number; bodies: number };\nengine/gfx/stageShells.ts:68:  props: Pick<StageProps, 'meshes'>;\nengine/gfx/stageShells.ts:85:      props: [...batches.values()].reduce((n, each) => n + each.shells.length, 0),\nengine/gfx/stageProps.ts:26: * // const props = createStageProps({ scene: stage.scene, materials: library });\nengine/gfx/stageProps.ts:34:import { createPropMeshes, type PropLight, type PropMeshes } from './props';\nengine/gfx/stageProps.ts:38:/** What `createStageProps` takes. */\nengine/gfx/stageProps.ts:67:  readonly props: ReadonlyMap<number, string>;\nengine/gfx/stageProps.ts:97:export function createStageProps(options: StagePropsOptions): StageProps {\nengine/gfx/stageProps.ts:114:    meshes = createPropMeshes({ materials: options.materials, registry });\nengine/gfx/stageProps.ts:120:  const props: StageProps = {\nengine/gfx/stageProps.ts:124:    props: ids,\n/** Builds a stage (see the file comment). */\nexport function createStage(options: StageOptions): Stage {\n  const scene = new Scene();\n  scene.name = options.level ? `stage:${options.level.name}` : 'stage';\n  scene.background = new Color(SKY);\n  const { level, site: placed = null } = options;\n  const land = options.terrain ?? placed?.terrain ?? null;\n  // Without a level, a terrain is the ground: its area places the sun and the stage's ground, at its origin's height.\n  const area = !level && land ? { corner: [land.origin[0], land.origin[2]] as const, size: [land.cols * land.cell, land.rows * land.cell] as const } : undefined; // prettier-ignore\n  const lights = createStageSky(scene, {\n    level,\n    area,\n    registry: options.registry,\n    background: SKY,\n    rng: () => options.fxRng?.('stage', 'lights'),\n  });\n  const [w, d] = level ? [level.cols * level.tile, level.rows * level.tile] : (area?.size ?? [16, 16]);\n  const [x0, z0] = area?.corner ?? [0, 0];\n  const centre = [x0 + w / 2, 0, z0 + d / 2] as const;\n\n  // Under a level written as storeys, under its lowest slab; round a terrain, a frame the terrain fills (stageGround.ts).\n  const y = level?.storeys ? level.bounds.min[1] : area ? land!.origin[1] : 0;\n  const ground = groundMesh([w, d], options.materials.get(GROUND_MATERIAL), { corner: [x0, z0], y, hole: !!area });\n  scene.add(ground);\n  const meshes = level ? runMeshes(level, options) : null;\n  if (meshes) scene.add(meshes.root);\n  const site = placed ? createStageSite(placed, { materials: options.materials, registry: options.registry, log: options.log }) : null; // prettier-ignore\n  if (site) scene.add(site.root);\n  const terrain = site ? site.terrain : land ? createTerrainMeshes(land, { materials: options.materials }) : null;\n  if (terrain && !site) scene.add(terrain.root);\n  let cutaway: Cutaway | null = null;\n  const storeys = meshes && level?.storeys ? createStoreyCut(meshes) : null;\n  const boxes = new Group();\n  boxes.name = 'stand-ins';\n  const actors = createActorPuppets({ materials: options.materials, registry: options.registry });\n  scene.add(boxes, actors.root);\n  const props = createStageProps({ scene, materials: options.materials, registry: options.registry });\n  const rides = createStageRides({ scene, materials: options.materials });\n  const crowd = createStageCrowd({ scene, materials: options.materials, level, registry: options.registry });\n  const shells = createStageShells({ props, actors });\n\n  const fx = createStageFx({\n    registry: options.registry,\n    trails: () => actors.trails(),\n    muzzle: (id) => actors.muzzle(id),\n    ...(options.fxRng ? { fxRng: options.fxRng } : {}),\n  });\n  scene.add(fx.effects.root);\nexport interface PropMeshesOptions {\n  /** Where the materials come from: the page's material library. */\n  materials: Pick<MaterialLibrary, 'get'>;\n  /** The registry of the props, geometries and materials; the shared one by default. */\n  registry?: Registry;\n  /** The props to make batches for at once, before a warm-up; every prop of the registry by default. */\n  props?: readonly string[];\n  /** The visual streams the phases are drawn from: the sim world's (`(...keys) => w.fxRng(...keys)`); seed 1's. */\n  fxRng?: (...keys: readonly (string | number)[]) => Rng;\n  /** Slots per page of each batch (1,024; above 1,000: engine/gfx/instancing.ts). */\n  pageSlots?: number;\n}\n\n/** The props of a scene, drawn: see the file comment. */\nexport interface PropMeshes {\n    },\n    carry(next) {\n      const list = [...next].filter(([, gun]) => gun.kind.prop !== '');\n      const changed = list.map(([id]) => id).join() !== guns.map(([id]) => id).join();\n      guns = list;\n      if (guns.length > 0) made();\n      return changed;\n    },\n    hide(test, key = '') {\n      const changed = key !== hiddenKey;\n      [hidden, hiddenKey] = [test, key];\n      return changed;\n    },\n    lights: () => meshes?.lights() ?? [],\n    register(warmup) {\n      warmups.add(warmup);\n      if (meshes) registrations.set(warmup, meshes.register(warmup));\n      const presence = warmup.keyPart('stage:props', () => (meshes ? 'props' : ''));\n      return {\n        dispose() {\n          warmups.delete(warmup);\n          registrations.get(warmup)?.dispose();\n          registrations.delete(warmup);\n          presence.dispose();\n        },\n      };\n    },\n    dispose() {\n      for (const registration of registrations.values()) registration.dispose();\n      registrations.clear();\n      warmups.clear();\n    const material: Material | Material[] = part.top\n      ? [materials.get(part.material), materials.get(part.top)]\n      : materials.get(part.material);\n    const batch = createInstancedBatch({\n      name: `${prop.id}/${part.name}`,\n      geometry,\n      material,\n      castShadow: part.shadow,\n      receiveShadow: true,\n      pageSlots: options.pageSlots,\n    });\n    root.add(batch.root);\n    for (const [warmup, held] of warmups) held.push(batch.register(warmup));\n    const local = new Matrix4().makeTranslation(0, -propCentre(prop), 0).multiply(partMatrix(part));\n    const tint = new Color(part.tint);\n    const off = part.lit ? tint.clone().multiplyScalar(OFF) : tint;\n    return { part, batch, geometry, local, tint, core: new Color(part.flame.core), off };\n  }\n\n  /** The draw of prop `id` (the fallback's for a missing id), its batches made on first use. */\n  function drawOf(id: string) {\n    const prop = getProp(id, registry);\n    let draw = draws.get(prop.id);\n    if (!draw) {\n      draw = { prop, parts: prop.parts.map((part) => partDraw(prop, part)), drawn: 0 };\n      draws.set(prop.id, draw);\n    }\n    return draw;\n  }\n\n  /** The phase (s) of the prop `id` named `key`: drawn once from its visual stream. */\n  function phaseOf(id: string, key: string | number): number {\n    const name = `${id}#${key}`;\n    let phase = phases.get(name);\n    if (phase === undefined) phases.set(name, (phase = fx('prop', id, key).range(0, 9)));\n    return phase;\n  }\n\n  for (const id of options.props ?? registry.list('prop').map((entry) => entry.id)) drawOf(id);\n\n  const props: PropMeshes = {\n    root,\n    batches: () => [...draws.values()].flatMap((draw) => draw.parts.map((part) => part.batch)),\n    begin(t) {\n      time = t;\n      lights = [];\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_208","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/scope-props.mjs <<'EOF'\n/** @file One-time conversion of original prop declarations to scene-scoped registration factories. */\nimport ts from 'typescript';\nimport {readFileSync,writeFileSync,readdirSync} from 'node:fs';\nconst dir='labs/game/props',groups=[];const builders=[];\nfor(const file of readdirSync(dir).filter(n=>/\"'^collection'\"\\\\d+\\\\.ts\"'$/.test(n)||['\"'finale.ts','story.ts'].includes(n))){\n const text=readFileSync(\"'`${dir}/${file}`,'\"'utf8'),source=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true),parts=[];\n const imports=source.statements.filter(ts.isImportDeclaration).map(n=>n.getText(source)).join('\\\\n');\n for(const statement of source.statements){if(\"'!ts.isExpressionStatement(statement)||!ts.isCallExpression(statement.expression)||statement.expression.expression.getText(source)!=='\"'prop')continue;\n const name=statement.expression.arguments[0].text,fn='make'+name[0].toUpperCase()+name.slice(1);builders.push([name,fn]);parts.push(\"'`export function ${fn}():void {'\"\\\\n\"'${statement.getText(source)}'\"\\\\n}\"'`);\n }\n groups.push(`import {${builders.slice(-parts.length).map(([,fn])=>fn).join('\"',')}} from './\"'${file.slice(0,-3)}'\"';\"'`);\n writeFileSync(`${dir}/${file}`,`/** @file Original retreat props, registered when their scene is built. */'\"\\\\n\"'${imports}'\"\\\\n\"'${parts.join('\"'\\\\n')}\\\\n\"'`);\n}\nwriteFileSync(`${dir}/retreat.ts`,`/** @file Scene-scoped prop registration keeps unplaced island assets out of the session warm-up. */'\"\\\\nimport {defineProp} from '../../../engine/sim-api';\\\\n\"'${groups.join('\"'\\\\n')}\\\\nconst makeSea=()=>defineProp('prop:sea',{description:'Open sea to every horizon.',parts:[{name:'water',geometry:'geometry:box',params:{width:1800,height:.08,depth:1800},material:'material:retreatSea',shadow:false}]});\\\\nconst builders:Record<string,()=>unknown>={\"'${builders.map(([name,fn])=>`${name}:${fn}`).join('\"',')},sea:makeSea};\\\\nconst registered=new Set<string>();\\\\nexport function registerRetreat(small=false):void{for(const name of small?['matMint','matCoral','pavilion','tare']:Object.keys(builders)){if(registered.has(name))continue;builders[name]();registered.add(name);}}\\\\n\"'`);\nEOF\nnode labs/game/tools/scope-props.mjs\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"import '../props/retreat';\\\", \\\"import {registerRetreat} from '../props/retreat';\\\").replace('export function buildWorld(w: World<GameComponents>, small = false) {', 'export function buildWorld(w:World<GameComponents>,small=false){\\\\n  registerRetreat(small);');p.write_text(s)\np=Path('labs/game/scenes/terrain.ts');s=p.read_text().replace(\\\"  ],\\\\n  materials:\\\", \\\"  ].map(flat=>({...flat,height:flat.height+1})),\\\\n  materials:\\\");p.write_text(s)\n# Add actual supports matching each original visible surface.\nfor file,names,size in [('collection1.ts',['matMint','matCoral'],[2.2,.11,3.4]),('collection1.ts',['pavilion'],[19,.06,15]),('collection8.ts',['stepRetreat'],[1.5,.25,.8])]:\n p=Path('labs/game/props')/file;s=p.read_text()\n for name in names:\n  a=s.index(\\\"prop('\\\"+name+\\\"'\\\");b=s.index('\\\\n}',a);block=s[a:b];last=block.rfind(']);')\n  if last<0:raise Exception(name)\n  block=block[:last]+\\\"],{body:{type:'fixed',shape:'box',size:\\\"+str(size)+\\\"}});\\\"+block[last+3:]\n  s=s[:a]+block+s[b:]\n p.write_text(s)\n# The pier appears in collection6 in the original grouped library.\nfor p in Path('labs/game/props').glob('collection*.ts'):\n s=p.read_text()\n if \\\"prop('pier'\\\" in s:\n  a=s.index(\\\"prop('pier'\\\");b=s.index('\\\\n}',a);block=s[a:b];last=block.rfind(']);');block=block[:last]+\\\"],{body:{type:'fixed',shape:'box',size:[5,.22,16]}});\\\"+block[last+3:];s=s[:a]+block+s[b:];p.write_text(s)\np=Path('labs/game/app.ts');s=p.read_text().replace(\\\"      ['title', 'settings', 'about', 'group', 'arrival'].includes(this.ui.screen) &&\\\", \\\"      this.flow?.mode==='front' && ['title','settings','about','group','arrival','board'].includes(this.ui.screen) &&\\\")\np.write_text(s)\np=Path('labs/game/tools/browser-check.py');s=p.read_text();s='\\\\n'.join(line for line in s.splitlines() if 'page.screenshot(' not in line)+'\\\\n';s=s.replace(\\\"  require(page.locator('#shell [data-glyph=left]').first.inner_text()=='Q'\\\", \\\"  page.keyboard.press('z')\\\\n  require(page.locator('#shell [data-glyph=left]').first.inner_text()=='Q'\\\")\na=s.index(\\\" def local_mixed():\\\")\ns=s[:a]+''' def pause_settings_idle():\n  page.evaluate('__engine.actions.run(\\\"game.start\\\",{event:\\\"pose\\\"});__engine.resume()');page.wait_for_function('__game.event===\\\"pose\\\"&&__game.screen===\\\"play\\\"')\n  page.keyboard.press('Escape');page.wait_for_function('__game.screen===\\\"pause\\\"');page.locator('[data-action=settings]').click()\n  page.wait_for_timeout(11200)\n  require(not page.evaluate('__game.attract') and page.evaluate('__game.event')=='pose','Attract interrupted a paused class')\n  page.locator('[data-action=back]').click();page.locator('[data-action=quit]').click()\n check('in-game settings preserve a paused class',pause_settings_idle)\n'''+s[a:]\np.write_text(s)\nPY\nnpx prettier --write labs/game > out/game/format-final.log\nnpx tsc -b tsconfig.check.json --pretty false\nnpm test -- --maxWorkers=1 > out/game/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
