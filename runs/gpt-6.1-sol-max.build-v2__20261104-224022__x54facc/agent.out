 action: a.begin,\\\", \\\"        action:a.flow?.mode==='front'?a.begin:a.resume,\\\")\nneedle=\\\"      { id: 'controls', label: 'A moment for the controls'\\\"\n# An earned accessory is placed after Begin so the initial arrival focus path stays the same.\nif needle in s:s=s.replace(needle,\\\"      ...(a.save.pebbles>=30?[{id:'headband',label:'Earned headband',value:a.save.headband?'On':'Off',action:()=>{a.save.headband=\"'!a.save.headband;a.run('\"'game.look',{headband:a.save.headband});if(\"'!a.sandbox)a.store.set('\"'progress',a.save);a.show('arrival');}}]:[]),\\\\n\\\"+needle)\np.write_text(s)\np=Path('labs/game/ui/screens/settings.ts');s=p.read_text().replace(\\\"            toggle('cpu', 'CPU guests'),\\\", \\\"            toggle('cpu', 'CPU guests'),\\\\n            {id:'outfit',label:'Your retreat outfit',action:()=>a.show('arrival')},\\\")\np.write_text(s)\np=Path('labs/game/ui/context.ts');s=p.read_text().replace('  touchOnly: boolean;', '  devScore:number;\\\\n  touchOnly: boolean;');p.write_text(s)\np=Path('labs/game/app.ts');s=p.read_text().replace('  uiTicks = 0;', '  uiTicks = 0;\\\\n  devScore=800;').replace('    this.show(\\\\'pause\\\\');\\\\n  }\\\\n  private credits', \\\"    this.ui.padOld[9]=true;\\\\n    this.show('pause');\\\\n  }\\\\n  private credits\\\")\np.write_text(s)\np=Path('labs/game/ui/screens/dev.ts');s=p.read_text().replace(\\\"import { ACTIVITIES }\\\", \\\"import { rank, ACTIVITIES }\\\")\ns=s.replace(\\\"label: 'Finish now · Serene',\\\", \\\"label:\"'`Finish now · ${rank(a.devScore)}`,\").replace(\"value: '\"'800',\\\", \\\"value:String(a.devScore),\\\").replace(\\\"{ score: 800 }\\\", \\\"{ score:a.devScore }\\\")\ns=s.replace(\\\"          a.run('game.finish', { score: n > 0 ? 1000 : 300 });\\\\n          a.resume();\\\", \\\"          a.devScore=Math.max(0,Math.min(1000,a.devScore+n*100));refresh();\\\")\ns=s.replace(\\\"label: 'Advance one frame',\\\", \\\"label:'Frame step / time scale',\\\\n        value:\"'`${e?.time