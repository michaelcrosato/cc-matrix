{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,82p' engine/gfx/resolution.ts; sed -n '120,145p' engine/ui/overlay.ts; sed -n '1,65p' labs/game/scenes/state.ts; sed -n '1,75p' labs/game/scenes/pilot.ts; sed -n '90,130p' labs/game/scenes/flow.ts; cat .prettierrc.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,82p' engine/gfx/resolution.ts; sed -n '120,145p' engine/ui/overlay.ts; sed -n '1,65p' labs/game/scenes/state.ts; sed -n '1,75p' labs/game/scenes/pilot.ts; sed -n '90,130p' labs/game/scenes/flow.ts; cat .prettierrc.json\"","aggregated_output":" * // resolution.prefer('full'); // the look's mode, drawn while gfx.resolution is 'auto'\n * @see engine/gfx/resolution.test.ts\n */\nimport type { Camera, PerspectiveCamera, WebGPURenderer } from 'three/webgpu';\nimport type { Field } from '../core/schema';\nimport { createSettings, defineSettings, type Settings } from '../core/settings';\n\n/** The resolution modes, chunkiest first. */\nexport const RESOLUTION_MODES = ['pixels', 'balanced', 'full'] as const;\n\n/** A resolution mode: the engine's pixels, half the screen's, or all of it. */\nexport type ResolutionMode = (typeof RESOLUTION_MODES)[number];\n\n/** What `gfx.resolution` takes: `auto` (the look's mode, else `pixels`), or a mode held whatever the look asks. */\nexport type ResolutionSetting = 'auto' | ResolutionMode;\n\n/** The most lines the `pixels` mode draws. */\nexport const PIXEL_LINES = 330;\n\n/** The highest device pixel ratio drawn at: beyond it, pixels are too small to see and cost the same. */\nexport const MAX_PIXEL_RATIO = 3;\n\n/** The resolution settings: view settings, never in the hash. */\nexport const RESOLUTION_SETTINGS = {\n  'gfx.resolution': {\n    type: 'string',\n    enum: ['auto', ...RESOLUTION_MODES],\n    default: 'auto',\n    view: true,\n    description:\n      \"How many pixels are drawn: 'auto' (the mode the look asks for, its resolution; 'pixels' if it names none), or one held whatever the look asks: 'pixels' (the engine's chunky pixels, at most 330 lines, each a whole number of screen pixels), 'balanced' (half the screen's resolution) or 'full'.\",\n  },\n} as const satisfies Record<string, Field>;\ndefineSettings(RESOLUTION_SETTINGS);\n\n/** A size in CSS or device pixels. */\nexport interface Size {\n  width: number;\n  height: number;\n}\n\n/** What a mode gives for a canvas: the drawing buffer's size and how it maps to the screen. */\nexport interface Fit {\n  mode: ResolutionMode;\n  /** The canvas's size in CSS pixels, as measured. */\n  css: Size;\n  /** The device pixel ratio used: the browser's, at most `MAX_PIXEL_RATIO`. */\n  pixelRatio: number;\n\n/** No touch controls: off touch screens. */\nconst NO_CIRCLES = { buttons: [] as number[][], menu: null };\n\n/** The overlay's stylesheet (see the file comment). */\nconst STYLE = `\n.ui-overlay { position: fixed; left: 0; top: 0; width: 0; height: 0; overflow: hidden; contain: strict;\n  pointer-events: none;\n  font: 600 16px/1.2 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #f0e3c6;\n  -webkit-user-select: none; user-select: none; }\n.touch .ui-overlay { font-size: calc(var(--touch-k, 1) * 16px); }\n.ui-overlay [hidden] { display: none !important; }\n.touch .ui-overlay [data-keyboard] { display: none !important; }\n.ui-layer { position: absolute; inset: 0; }\n.ui-at { position: absolute; left: 0; top: 0; white-space: nowrap;\n  transform: translate(-50%, -50%) translate(calc(var(--ui-x, 0) * 1px), calc(var(--ui-y, 0) * 1px)); }\n.ui-label { padding: 0.1em 0.4em; border-radius: 0.3em; background: rgba(11, 8, 20, 0.55); font-size: 0.8125em;\n  text-shadow: 0 1px 1px #0b0814; }\n.ui-damage { transform: translate(-50%, calc(-50% - var(--ui-slot, 0) * 100%))\n  translate(calc(var(--ui-x, 0) * 1px), calc(var(--ui-y, 0) * 1px));\n  font-size: calc(var(--ui-scale, 1) * 1.25em); font-weight: 800; line-height: 1; color: #fff2c4;\n  font-variant-numeric: tabular-nums; text-shadow: -1px -1px 0 #0b0814, 1px -1px 0 #0b0814, -1px 1px 0 #0b0814,\n  1px 1px 0 #0b0814, 0 2px 0 #0b0814; }\n.ui-damage > span { display: inline-block; animation-name: ui-damage-pop, ui-damage-blink;\n  animation-duration: calc(var(--ui-life, 0.8) * 1s); animation-timing-function: ease-out, step-end;\n  animation-delay: calc(var(--ui-age, 0) * -1s); animation-fill-mode: both; animation-play-state: paused; }\n/** @file Hashed flow data and component declarations, shared by the scene and its read-only page. */\nimport {\n  defineComponent,\n  type ActorComponent,\n  type ClipsData,\n  type ScenePropComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport type { ActivityRun } from './events/types';\nimport type { Wobble } from './wobble';\nexport type Progress = {\n  day: number;\n  done: string[];\n  ages: number[];\n  pebbles: number;\n  finds: number[];\n  bests: Record<string, number>;\n  complete: boolean;\n  look: number;\n  colour: number;\n};\nexport const freshProgress = (): Progress => ({\n  day: 1,\n  done: [],\n  ages: [],\n  pebbles: 0,\n  finds: [],\n  bests: {},\n  complete: false,\n  look: 0,\n  colour: 0,\n});\nexport type Flow = Progress & {\n  mode: string;\n  event: ActivityRun;\n  wobble: Wobble;\n  hero: number;\n  plumb: number;\n  others: number[];\n  tare: number;\n  clock: number;\n  serial: number;\n  message: string;\n  speaker: string;\n  focus: string;\n  demo: boolean;\n  roundOnly: boolean;\n  feet: number[];\n  topples: number;\n  lastMistakes: number;\n  lastBeat: number;\n  costume: number;\n  bank: number;\n  resultsTick: number;\n  props: number[];\n  expert: boolean;\n  ghostIds: number[];\n};\nexport type Guest = { seat: number; pose: string; initial: boolean };\nexport type GameComponents = {\n  retreat: { data: Flow };\n  guest: Guest;\n  actor: ActorComponent;\n  clips: ClipsData;\n  sceneProp: ScenePropComponent;\n/** @file One input owner for walk, balance, bots and the island-scale finale. */\nimport { held, pressed, placeActor, type Intents, type World } from '../../../engine/sim-api';\nimport { flowOf, type GameComponents } from './state';\nimport { stepEvent, botFor, guideFor } from './events/registry';\nimport { activity, ACTIVITIES, DAYS } from './data/days';\nimport { heightAt } from './terrain';\nimport { finishEvent, leaveEvent, sleep, startEvent } from './flow';\nimport { DEFAULT_WOBBLE, clamp, type Lean, type WobbleConfig } from './wobble';\nimport { poseGuest } from '../cast/guest';\nimport type { EventConfig } from './events/types';\ntype W = World<GameComponents>;\nexport function configOf(w: W): EventConfig {\n  const f = flowOf(w),\n    get = (key: string) => w.settings.get<number>(`game.${key}`);\n  const wobble = { ...DEFAULT_WOBBLE };\n  for (const key of ['gain', 'instability', 'damping', 'noise', 'noiseRate', 'reach'] as const)\n    wobble[key] = get(`wobble.${key}`);\n  wobble.period = get('breath.period');\n  wobble.calmEffect = get('breath.calmEffect');\n  if (w.settings.get<boolean>('game.assist')) wobble.noise *= 0.5;\n  if (f.expert) wobble.noise *= 1.2;\n  return { wobble, get, auto: w.settings.get<boolean>('game.auto') || f.demo, day: f.day, expert: f.expert };\n}\nfunction readLean(i: Intents): Lean {\n  const n = (key: string) => Number(i[`game:${key}`] ?? 0);\n  const mouse = i['game:mouse'] as number[] | undefined;\n  const gentle = held(i, 'gentle') ? 0.4 : 1;\n  return {\n    x: clamp((n('r') - n('l') + (mouse?.[0] ?? 0)) * gentle),\n    y: clamp((n('f') - n('b') + (mouse?.[1] ?? 0)) * gentle),\n    l: n('fl'),\n    r: n('fr'),\n    act: pressed(i, 'act'),\n  };\n}\nfunction walking(w: W, i: Intents): void {\n  const f = flowOf(w),\n    hero = w.get(f.hero);\n  if (!hero?.actor) return;\n  hero.actor.intents = { move: i.move, b: i.b, p: i.p, cam: i.cam };\n  const { x, z } = hero.actor;\n  if (Math.hypot(x, z) > 106 || hero.actor.y < 1.8)\n    placeActor(w, f.hero, [x * 0.92, heightAt(x * 0.92, z * 0.92) + 0.2, z * 0.92]);\n  let nearest = 10,\n    focus = '';\n  for (const a of ACTIVITIES) {\n    const d = Math.hypot(a.x - x, a.z - z);\n    if (d < nearest) {\n      nearest = d;\n      focus = a.id;\n    }\n  }\n  if (Math.hypot(x - 62, z - 52) < 7) focus = 'sleep';\n  if (Math.hypot(x - 8, z - 35) < 5) focus = 'board';\n  for (const e of w.query('find'))\n    if (Math.hypot(e.find.x - x, e.find.z - z) < 2 && !f.finds.includes(e.find.index)) {\n      f.finds.push(e.find.index);\n      f.pebbles++;\n      f.serial++;\n      w.despawn(e.id);\n      f.message = 'A pebble. It was waiting for someone to take responsibility.';\n      w.emit('pebble', {});\n    }\n  for (const e of w.query('plaque'))\n    if (Math.hypot(e.plaque.x - x, e.plaque.z - z) < 3) focus = `plaque${e.plaque.index}`;\n  f.focus = focus;\n  if (pressed(i, 'use') && focus) {\n    if (focus === 'sleep') sleep(w);\n    else if (focus === 'board') {\n      f.message = 'Every activity is available from the Noticeboard. Open the Programme.';\n      f.serial++;\n    } else if (focus.startsWith('plaque')) {\n      f.message = [\n        'Did you know? This plaque was four centimetres to the left on Tuesday.',\n        'Did you know? The sea has never been asked to stand still.',\n      f.complete = true;\n      startEvent(w, 'check');\n      f.message = 'The final Morning Check. Everything feels a little more level.';\n      return;\n    }\n  }\n  if (f.complete && f.event.id === 'check' && f.mode === 'results') {\n    f.mode = 'credits';\n    f.serial++;\n    return;\n  }\n  f.mode = 'roam';\n  f.serial++;\n  placeActor(w, f.hero, [0, 8.25, 40], Math.PI);\n  f.message = DAYS[Math.min(4, f.day - 1)].line;\n}\nexport function sleep(w: W): void {\n  const f = flowOf(w);\n  if (!DAYS[Math.min(4, f.day - 1)].events.every((id) => f.done.includes(id)) && !f.complete) {\n    f.message = 'Your programme has a little standing left in it.';\n    f.serial++;\n    return;\n  }\n  f.day = Math.min(6, f.day + 1);\n  f.done = [];\n  f.mode = 'roam';\n  f.serial++;\n  f.message =\n    f.day === 5\n      ? 'The sky has made a decision. Please begin your programme.'\n      : f.complete\n        ? 'You may stay as long as you like. The ferry does not return.'\n        : DAYS[Math.min(4, f.day - 1)].line;\n  placeActor(w, f.hero, [0, 8.25, 40], Math.PI);\n}\nexport function progressOf(f: Progress): Progress {\n  return {\n    day: f.day,\n    done: [...f.done],\n    ages: [...f.ages],\n    pebbles: f.pebbles,\n{\n  \"printWidth\": 120,\n  \"singleQuote\": true\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_89","type":"agent_message","text":"The game now boots in Chromium with WebGPU and no reported engine errors. Pilot tests have caught a rhythm timing crash, rewards decaying after an activity was complete, and a dive timing mismatch; those are fixed. The first screenshot also showed that the engine defaults to a pixelated resolution, so I’m switching this game to full resolution for the intended retreat look.\n"}}
