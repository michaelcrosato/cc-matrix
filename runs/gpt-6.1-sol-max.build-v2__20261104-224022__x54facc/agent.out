{"type":"item.completed","item":{"id":"item_69","type":"agent_message","text":"The main screens are written: daily programme, results and Wobble Age, free practice, settings, About, and live tuning in Dev Mode. The first type check caught several API mismatches in placement, audio buses, and bindings; I’ve corrected those. I’m wiring startup and the Hub round next, which will let me test the assembled game.\n"}}
{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/hub/session.ts <<'EOF'\n/** @file AI Hub ghost rounds: the game's own ready card, remote mats and one terminal result. */\nimport type { GameApp } from '../app';\nimport { safe, glyph } from '../ui/glyphs';\ntype Player = { id: number; name: string; color: string };\ntype Info = { me: number; players: Player[]; seed: number; limitMs: number };\ntype Card = { left: number | null; ready: number[]; paused: boolean; starting: boolean };\ntype Client = {\n  active: boolean; connect: (options: { mode: string; seats: number[]; card: boolean }) => Promise<Info | null>;\n  ready: () => void; answer: (answer: string) => void; time: () => number;\n  on: (event: string, callback: (...args: unknown[]) => void) => unknown;\n  progress: (data: { score: number; label: string }) => void;\n  result: (data: { score: number; stats: Record<string, string>; awards: { title: string; detail: string }[] }) => void;\n  send: (data: unknown, options?: { reliable: boolean }) => void; fail: (message: string) => void;\n};\nexport class HubSession {\n  client = (window as unknown as { AIHub?: Client }).AIHub;\n  info: Info | null = null;\n  ended = false; started = false; playing = false; sentResult = false;\n  private lastSend = 0; private lastScore = -1; private card: Card = { left: null, ready: [], paused: false, starting: false };\n  private ghosts = new Map<number, { seat: number; x: number; y: number; phase: number; active: boolean }>();\n  private app: GameApp;\n  constructor(app: GameApp) { this.app = app; }\n  async connect(): Promise<void> {\n    if (\"'!this.client?.active) return;\n    this.info = await this.client.connect({ mode: '\"'ghost', seats: [1, 4], card: true });\n    if (\"'!this.info) return;\n    this.app.hubActive = true;\n    const client = this.client;\n    client.on('\"'card', (value) => { this.card = value as Card; this.drawCard(); });\n    client.on('start', () => {\n      this.started = true; this.app.ui.clear('hub-countdown');\n      client.progress({ score: 0, label: 'Breathing in' });\n      client.send({ t: 'g', e: 0, x: 0, y: 0, p: 'Stand', s: 0 }, { reliable: false });\n    });\n    client.on('message', (value, from) => {\n      if (this.ended) return;\n      const data = value as { t?: string; x?: number; y?: number; e?: number };\n      if (data.t \"'!== '\"'g' || \"'!Number.isFinite(data.x) || !Number.isFinite(data.y)) return;\n      const remotes = this.info!.players.filter((p) => p.id !== this.info!.me), seat = remotes.findIndex((p) => p.id === from) + 1;\n      if (seat < 1) return;\n      this.ghosts.set(Number(from), { seat, x: Math.max(-1, Math.min(1, data.x!)), y: Math.max(-1, Math.min(1, data.y!)), phase: data.e ?? 0, active: true });\n      this.app.run('\"'round.ghosts', [...this.ghosts.values()]);\n    });\n    client.on('leave', (value) => { const { id } = value as { id: number }; const ghost = this.ghosts.get(id); if (ghost) { ghost.active = false; this.app.run('round.ghosts', [...this.ghosts.values()]); } });\n    client.on('time-up', () => this.result());\n    client.on('end', () => { this.ended = true; this.app.engine?.stop(); this.app.audio.mute(true); this.app.ui.choices = []; });\n    addEventListener('keydown', (event) => {\n      if (this.ended || this.started) return;\n      if (event.code === 'Enter' || event.key === 'Enter') client.answer('ready');\n      if (event.code === 'KeyT' || event.key === 't') client.answer('more');\n    });\n    this.drawCard();\n  }\n  ready(): void {\n    if (\"'!this.info || this.ended) return;\n    const others = this.info.players.filter((p) => p.id !== this.info!.me);\n    this.app.run('\"'round.ghosts', others.map((_, i) => ({ seat: i + 1, x: 0, y: 0, phase: 0, active: true })));\n    this.client?.ready();\n  }\n  frame(): void {\n    if (\"'!this.info || !this.client || this.ended) return;\n    if (this.started && !this.playing && this.client.time() >= 0 && this.app.engine?.ready) { this.playing = true; this.app.run('\"'round.go'); this.app.ui.clear(); this.app.engine.inspector?.resume(); }\n    if (\"'!this.playing) {\n      const pad = [...(navigator.getGamepads?.() ?? [])].find((p) => p?.connected);\n      if (!this.started && pad?.buttons[0]?.pressed) this.client.answer('\"'ready');\n      if (\"'!this.started && pad?.buttons[3]?.pressed) this.client.answer('\"'more');\n      return;\n    }\n    const f = this.app.flow; if (\"'!f) return;\n    const r = f.event, wobble = r.seats[0] ?? f.wobble;\n    if (r.score !== this.lastScore) { this.lastScore = r.score; this.client.progress({ score: Math.round(r.score), label: `Class ${r.phase + 1} · ${Math.round(r.score)}` }); }\n    if (performance.now() - this.lastSend >= 100) { this.lastSend = performance.now(); this.client.send({ t: '\"'g', e: r.phase, x: wobble.x, y: wobble.y, p: r.children[0]?.id ?? 'Stand', s: Math.round(r.score) }, { reliable: false }); }\n    if (f.mode === 'results') this.result();\n  }\n  private drawCard(): void {\n    if (\"'!this.info || this.started || this.ended) return;\n    const players = this.info.players.map((p) => `<span class=\"hub-player\"><i style=\"background:${safe(p.color)}\"></i>${safe(p.name)}${this.card.ready.includes(p.id) ? '\"' ✓' : ''}</span>\"'`).join('\"'');\n    this.app.ui.menu('hub', 'A CLASS, NOT A MATCH', 'Wobble Fit', 'Stay the steadiest across three classes. Your balance is your own. The neighbouring mats are company.', [], { hero: true, extra: \"'`<div class=\"hub-players\">${players}</div><p class=\"description\">Lean: stick or WASD<br>Feet: L2 / R2 or Q / E<br>Breathe: both or Space</p><p>${this.card.paused ? '\"'A little more time.' : this.card.left === null ? 'Finding your mats…' : \"'`${Math.ceil(this.card.left / 1000)} seconds to settle in.`}</p><div class=\"hub-buttons\"><button data-hub=\"ready\">${glyph('\"'accept', this.app.ui.device, this.app.options.xbox)} Ready</button><button data-hub=\\\"more\\\">△ / T · More time</button></div>\"'` });\n    this.app.ui.root.querySelector('\"'[data-hub=ready]')?.addEventListener('click', () => this.client?.answer('ready'));\n    this.app.ui.root.querySelector('[data-hub=more]')?.addEventListener('click', () => this.client?.answer('more'));\n  }\n  private result(): void {\n    if (this.sentResult || this.ended || \"'!this.info) return;\n    this.sentResult = true;\n    const score = Math.round(this.app.flow?.event.score ?? 0);\n    this.client?.result({ score, stats: { Composure: String(score), Classes: '\"'3', Retreat: 'Little Fulcrum' }, awards: [{ title: 'A Pleasant Presence', detail: 'You kept the neighbouring mat company.' }] });\n  }\n}\nEOF\ncat > labs/game/main.ts <<'EOF'\n/** @file Boots the self-contained retreat on the read-only my-3dge runtime. */\nimport { createEngine } from '../../engine';\nimport { GameApp } from './app';\nimport { startSound } from './audio/sound';\nimport { HubSession } from './hub/session';\nimport { island, round } from './scenes/island';\nimport { SHOT } from './cameras/retreat';\nimport type { GameEngine } from './ui/context';\nimport './looks/retreat';\nimport './bodies/retreat';\nimport './ui/input';\nimport './ui/theme.css';\nconst app = new GameApp(startSound());\nconst session = new HubSession(app);\nawait session.connect();\nconst search = new URLSearchParams(location.search);\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\nsearch.set('touch', 'off'); search.set('cam3', 'retreat'); search.set('post.look', 'look:retreat');\nif (session.info) { search.set('scene', round.id); search.set('seed', String(session.info.seed)); }\nif (\"'!('\"'gpu' in navigator)) {\n  document.querySelector('#msg')?.setAttribute('hidden', '');\n  app.ui.menu('unsupported', 'A SMALL TECHNICAL MATTER', 'A different browser.<br>The same little island.', 'This game needs a browser with WebGPU, such as current Chrome or Edge.', [{ id: 'settings', label: 'Settings', action: () => app.show('settings') }, { id: 'about', label: 'About the retreat', action: () => app.show('about') }]);\n  app.ui.root.classList.add('no-gpu');\n  if (session.info) session.client?.fail('WebGPU required');\n} else {\n  const watchdog = session.info ? setTimeout(() => session.client?.ready(), 14000) : 0;\n  const engine = await createEngine({ canvas: document.querySelector<HTMLCanvasElement>('#view')\"'!, scenes: [island.id, round.id], search: `?${search}`, hash: '\"'', store: app.store, modal: () => app.ui.choices.length > 0 || app.ui.screen === 'hub', cameraInput: () => ({ follow: SHOT.feet as [number, number, number] }), onFrame: (frame) => { app.frame(frame); session.frame(); } });\n  if (watchdog) clearTimeout(watchdog);\n  app.attach(engine as GameEngine);\n  if (engine.ready) { document.querySelector('#msg')?.setAttribute('hidden', ''); session.ready(); }\n  else if (session.info) session.client?.fail('WebGPU required');\n}\nEOF\ncat > labs/game/index.html <<'EOF'\n<\"'!doctype html>\n<!-- @file Wobble Fit: HTML first, procedural WebGPU world, code-written sound. -->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#f6f3e8\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>Wobble Fit · Little Fulcrum</title>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      addEventListener('\"'error', function(event) { var msg = document.getElementById('msg'); if (msg) { msg.hidden = false; msg.textContent = 'The retreat could not open. ' + event.message; } });\n    </script>\n  </head>\n  <body>\n    <canvas id=\\\"view\\\" aria-label=\\\"Little Fulcrum Wellness Retreat\\\"></canvas>\n    <div id=\\\"msg\\\" role=\\\"status\\\">Calibrating a small island…</div>\n    <script type=\\\"module\\\" src=\\\"./main.ts\\\"></script>\n  </body>\n</html>\nEOF\ncat > labs/game/hub/tags.html <<'EOF'\n<\"'!-- @file AI Hub catalogue and session protocol metadata. -->\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay the steadiest across three classes\">\n<meta name=\"hub:session-howto\" content=\"Lean: stick or WASD · Feet: L2 R2 or Q E · Breathe: both or Space\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-4\">\n<meta name=\"hub:source\" content=\"Wii Fit\">\nEOF\nmkdir -p labs/game/tools\ncat > labs/game/tools/onefile.mjs <<'\"'EOF'\n/** @file Bundles the full game and unmodified Hub client into one offline HTML file. */\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nimport { build } from 'vite';\nconst root = process.cwd();\nconst result = await build({ root, configFile: false, logLevel: 'warn', base: './', resolve: { alias: [{ find: /\"'^three$/, replacement: '\"'three/webgpu' }] }, build: { write: false, modulePreload: false, cssCodeSplit: false, assetsInlineLimit: () => true, chunkSizeWarningLimit: Infinity, rollupOptions: { input: { game: join(root, 'labs/game/index.html') }, output: { inlineDynamicImports: true } } } });\nconst files = {}; let html = '';\nfor (const item of (Array.isArray(result) ? result : [result]).flatMap((out) => out.output)) {\n  const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source);\n  if (item.fileName.endsWith('.html')) html = text; else files[item.fileName] = text;\n}\nconst find = (ref) => files[Object.keys(files).find((name) => ref.endsWith(name))];\nconst loaded = /<script type=\\\"module\\\" crossorigin src=\\\"([\"'^\"]+)\"><'\"\\\\/script>|<link rel=\\\"stylesheet\\\" crossorigin href=\\\"([\"'^\"]+)\">/g;\nconst inlined = html.replace(loaded, (_tag, script, style) => {\n  if (style) return `<style>${find(style)}</style>`;\n  const code = find(script).replaceAll('\"'</script', '<\\\\\\\\/script');\n  if (code.includes('<\"'!--'\"')) throw new Error('A script contains an HTML comment opener. Write its source apart.');\n  return \"'`<script type=\"module\">${code}</script>`;\n});\nconst client = readFileSync('\"'labs/game/hub/session-client.txt', 'utf8');\nconst tags = readFileSync('labs/game/hub/tags.html', 'utf8');\nconst target = resolve(process.argv[2] ?? '../Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261104-224022.html');\nwriteFileSync(target, inlined.replace('<meta charset=\\\"utf-8\\\" />', () => \"'`<meta charset=\"utf-8\" />'\"\\\\n<script>\\\\n\"'${client}</script>'\"\\\\n\"'${tags}`));\nconsole.log(`Built ${target}`);\nEOF\nnpx tsc -b tsconfig.check.json --pretty false'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
