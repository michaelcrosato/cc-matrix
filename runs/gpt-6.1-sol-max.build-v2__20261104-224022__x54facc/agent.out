{"type":"item.started","item":{"id":"item_175","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/seat-input.ts <<'EOF'\n/** @file Independent local seats: keyboard/mouse and up to four standard pads never drive one another's mats. */\nimport type {Device} from './glyphs';\nexport class SeatInput{\n private keys=new Set<string>();private buttons=0;private active=false;private keyboard:number|null=0;private pads=new Map<number,number>();\n constructor(){\n  addEventListener('keydown',e=>{this.keys.add(e.code);if(this.active&&this.keyboard===null&&e.code==='Space')this.keyboard=this.free();});\n  addEventListener('keyup',e=>this.keys.delete(e.code));\n  addEventListener('pointerdown',e=>this.buttons=e.buttons);addEventListener('pointerup',e=>this.buttons=e.buttons);\n  addEventListener('blur',()=>{this.keys.clear();this.buttons=0;});\n }\n private free():number|null{const used=new Set([...this.pads.values(),...(this.keyboard===null?[]:[this.keyboard])]);for(let i=0;i<4;i++)if(\"'!used.has(i))return i;return null;}\n begin(device:Device){this.active=true;this.pads.clear();this.keyboard=device==='\"'pad'?null:0;for(const pad of navigator.getGamepads?.()??[]){if(\"'!pad?.connected)continue;const seat=this.free();if(seat!==null)this.pads.set(pad.index,seat);}if(!this.pads.size)this.keyboard=0;}\n values(mouse:readonly number[],cpu:boolean):number[]{\n  const values=Array.from({length:20},()=>0),pads=[...(navigator.getGamepads?.()??[])].filter((pad):pad is Gamepad=>!!pad?.connected);\n  for(const [index]of this.pads)if(!pads.some(p=>p.index===index))this.pads.delete(index);\n  for(const pad of pads)if(!this.pads.has(pad.index)&&pad.buttons.some(b=>b.pressed)){const seat=this.free();if(seat!==null)this.pads.set(pad.index,seat);}\n  for(const pad of pads){const seat=this.pads.get(pad.index);if(seat===undefined)continue;const j=seat*5,mag=Math.hypot(pad.axes[0],pad.axes[1]),gain=mag>.18?Math.min(1,(mag-.18)/.82)/mag:0;values[j]=pad.axes[0]*gain;values[j+1]=-pad.axes[1]*gain;values[j+2]=Math.max(pad.buttons[6]?.value??0,pad.buttons[4]?.value??0);values[j+3]=Math.max(pad.buttons[7]?.value??0,pad.buttons[5]?.value??0);values[j+4]=pad.buttons.slice(0,4).some(b=>b.pressed)?2:1;}\n  if(this.keyboard===null&&!this.pads.size)this.keyboard=0;\n  if(this.keyboard!==null){const j=this.keyboard*5,has=(...keys:string[])=>keys.some(k=>this.keys.has(k))?1:0,gentle=has('\"'ShiftLeft','ShiftRight')?.4:1;values[j]=(has('KeyD','ArrowRight')-has('KeyA','ArrowLeft')+mouse[0])*gentle;values[j+1]=(has('KeyW','ArrowUp')-has('KeyS','ArrowDown')+mouse[1])*gentle;values[j+2]=has('KeyQ','Space')||this.buttons&1?1:0;values[j+3]=has('KeyE','Space')||this.buttons&2?1:0;values[j+4]=has('Enter','KeyF')?2:1;}\n  if(\"'!cpu)for(let seat=0;seat<4;seat++)if(!values[seat*5+4])values[seat*5+4]=1;\n  return values;\n }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/app.ts');s=p.read_text().replace(\\\"import { Shell }\\\", \\\"import {SeatInput} from './ui/seat-input';\\\\nimport { Shell }\\\")\ns=s.replace('  ui = new Shell();', '  ui = new Shell();\\\\n  seats=new SeatInput();')\ns=s.replace(\\\"    this.run('game.start', { event: id });\\\", \\\"    if(id==='group'&&\"'!this.hubActive)this.seats.begin(this.ui.device);'\"\\\\n    this.run('game.start', { event: id });\\\")\na=s.index(\\\"      if (this.flow.event.id === 'group') {\\\");b=s.index(\\\"    }\\\\n  };\\\",a)\ns=s[:a]+\\\"      if(this.flow.event.id==='group'&&\"'!this.hubActive)this.engine.input?.virtual.axis('\"'game:seats',this.seats.values(this.mouse,this.options.cpu));\\\\n\\\"+s[b:]\np.write_text(s)\np=Path('labs/game/scenes/events/types.ts');s=p.read_text().replace('inputs: Lean[];', 'inputs:(Lean|null)[];');p.write_text(s)\np=Path('labs/game/scenes/pilot.ts');s=p.read_text().replace('        act: false,\\\\n      };', '        act: seats[j+4]>1,\\\\n      };')\n# Explicitly clear disconnected local seats; null is serializable and hands an empty mat back to