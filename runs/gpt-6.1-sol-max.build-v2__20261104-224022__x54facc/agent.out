{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '135,195p' engine/world/props/prop.ts; sed -n '1,135p' engine/gfx/puppets/bodies/humanoid.ts; sed -n '261,291p' engine/sim/actors.ts; cat tools/templates/camera/camera.ts.tmpl; rg -n 'export.*(Camera|lookAt|makePose|defineLook|defineSky|defineMaterial|defineBody|defineTerrain)' engine/index.ts engine/gfx/public.ts engine/sim-api.ts engine/gfx/*api* 2>/dev/null\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '135,195p' engine/world/props/prop.ts; sed -n '1,135p' engine/gfx/puppets/bodies/humanoid.ts; sed -n '261,291p' engine/sim/actors.ts; cat tools/templates/camera/camera.ts.tmpl; rg -n 'export.*(Camera|lookAt|makePose|defineLook|defineSky|defineMaterial|defineBody|defineTerrain)' engine/index.ts engine/gfx/public.ts engine/sim-api.ts engine/gfx/*api* 2>/dev/null\"","aggregated_output":"} as const satisfies Schema;\n\n/** The fields of a prop's light spot, as three.js's `PointLight` takes them. */\nconst LIGHT_FIELDS = {\n  tag: { type: 'string', default: '', description: \"What kind of light it is ('torch'); '' for none.\" },\n  color: { type: 'string', default: '#ffffff', description: 'Its colour, hex.' },\n  intensity: { type: 'number', default: 1, minimum: 0, description: \"Its intensity, three.js's.\" },\n  distance: metres(0, 'Where it fades out; 0 for no limit.'),\n  decay: { type: 'number', default: 2, minimum: 0, description: 'How it dims with distance (2: physically).' },\n  position: vec3([0, 0, 0], \"Where it shines from, in the prop's frame.\"),\n  flicker: { type: 'boolean', default: false, description: \"Whether it flickers as a flame does (gfx's FLICKER).\" },\n} as const satisfies Schema;\n\n/** The fields of what breaking a prop leaves (WP 13.16). */\nconst BREAK_FIELDS = {\n  into: { type: 'string', default: '', description: \"The prop its pieces are ('prop:<id>', dynamic); '' none.\" },\n  pieces: { type: 'integer', default: 0, minimum: 0, maximum: 16, description: 'How many pieces it leaves.' },\n  shards: {\n    type: 'string',\n    default: '',\n    description: \"The event it breaks with, its look ('glass', 'splinters'); '' shatter.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of where a level places a prop. */\nconst PLACE_FIELDS = {\n  spawn: {\n    type: 'string',\n    default: '',\n    description: \"The spawn name whose points place it, on their floor (a glyph with spawn: 'crate'); '' none.\",\n  },\n  light: {\n    type: 'string',\n    default: '',\n    description: \"The light-spot tag whose spots place it, on the top of the spot's tile ('torch'); '' none.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of a `prop` entry. */\nexport const PROP_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is, in plain sentences.' },\n  parts: {\n    type: 'array',\n    items: { type: 'object', properties: PROP_PART_FIELDS },\n    default: [],\n    description: 'Its meshes: { name, geometry, params, material, top, tint, position, rotation, shadow, flame }.',\n  },\n  body: {\n    type: 'object',\n    default: defaultsOf(BODY_FIELDS),\n    description: 'Its body in the physics world, standing on its base: { type, shape, size, radius, height, … }.',\n    properties: BODY_FIELDS,\n  },\n  light: {\n    type: 'object',\n    default: defaultsOf(LIGHT_FIELDS),\n    description: \"Its light spot, for the light pool (WP 7.1): { tag, color, intensity, … }; tag '' for none.\",\n    properties: LIGHT_FIELDS,\n  },\n  place: {\n    type: 'object',\n/**\n * @file The neutral humanoid body (PLAN.md WP 3.8, I-21): `body:humanoid`, the body every humanoid wears until a\n * game gives it its own, in the body grammar (engine/gfx/puppets/grammar.ts), which registers it. Legs in trousers\n * and boots, a shirt with short sleeves, a belt, a neck, a face, hair (a mass behind, a cap and a fringe) and two\n * eyes on the eye sockets; no weapon, no cape: those are props and outfits a game adds.\n *\n * Sizes follow my-3d2dge's puppet (`humanParts` and lab3d's `humanBody`): limbs in multiples of the limb radius\n * (`limbW` / 2), the torso of the torso radius (`torsoW`), the head of the skeleton's head radius, all / 16 to metres.\n * The builds' drawing fields come with them: `build:bulky` draws thicker (`limbW` 2.6, `torsoW` 4.2) and\n * `build:skeleton` thinner (the HD floor of 0.55 units for a limb, `torsoW` 2.6); chibi and heroic keep the defaults.\n * The source's torso, one capsule from the hips to the shoulders, is two here, riding spine1 and the chest, so it\n * bends with the back; the hand is a ball on the grip socket, the fist's centre.\n *\n * Invariants: data only (no imports at run time, so the grammar can register it); every slot it names is in\n * `slots`; parts written for the left side are in `mirror`.\n *\n * Carried from `my-3d2dge:src/stress-world/30-crowd.js:98-138` (`humanParts`, the sizing) and\n * `my-3d2dge:src/lab3d/40-characters.js:24-41` (`humanBody`, the parts as lines), with the default colours of\n * `my-3d2dge:engine/my-3d2dge.js:1749-1752` (`HUMAN_COLORS`).\n *\n * @example\n * HUMANOID_BODY.mirror?.length; // 8: the parts each side wears\n * @see engine/gfx/puppets/compile.test.ts\n * @see tests/e2e/puppets.spec.ts\n */\nimport type { BodySpec } from '../grammar';\n\n/** The neutral humanoid (see the file comment). */\nexport const HUMANOID_BODY: BodySpec = {\n  description: 'The neutral humanoid: trousers and boots, a short-sleeved shirt, a belt, a face, hair and eyes.',\n  slots: {\n    skin: '#f1c7a0',\n    hair: '#3b2a2f',\n    cloth: '#2f8f86',\n    pants: '#3b3552',\n    boot: '#6a4128',\n    belt: '#e0a84a',\n    eye: '#1a1320',\n  },\n  parts: [\n    ['limb', 'thighL', 'thighR', [1.45, 'limb'], [1.45, 'limb'], 'pants', { on: 'pelvis' }],\n    ['limb', ['off', 'thighL', 0, -0.019, 0.044], ['off', 'thighR', 0, 0.019, 0.044], [0.66, 'torso'], [0.66, 'torso'], 'belt', { on: 'pelvis' }], // prettier-ignore\n    ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.62, 'torso'], [0.68, 'torso'], 'cloth', { on: 'spine1' }],\n    ['limb', 'chest', ['off', 'neck', 0, 0, -0.025], [0.68, 'torso'], [0.72, 'torso'], 'cloth'],\n    ['limb', 'upperArmL', 'upperArmR', [1.2, 'limb'], [1.2, 'limb'], 'cloth', { on: 'chest' }],\n    ['limb', 'neck', ['off', 'head', 0, 0, [0.4, 'head']], 0.047, 0.047, 'skin'],\n    ['ball', ['off', 'head', [0.1, 'head'], 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n    ['ball', ['off', 'head', [-0.32, 'head'], 0, [1.16, 'head']], [0.96, 'head'], 'hair'],\n    ['ball', ['off', 'head', [-0.1, 'head'], 0, [1.62, 'head']], [0.72, 'head'], 'hair'],\n    ['ball', ['off', 'head', [0.5, 'head'], 0, [1.5, 'head']], [0.42, 'head'], 'hair'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', [1.45, 'limb'], [1.2, 'limb'], 'pants'],\n    ['limb', 'shinL', ['lerp', 'shinL', 'footL', 0.62], [1.2, 'limb'], [1.05, 'limb'], 'pants'],\n    ['limb', ['lerp', 'shinL', 'footL', 0.62], 'footL', [1.15, 'limb'], [1.05, 'limb'], 'boot'],\n    ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'boot'],\n    ['limb', 'upperArmL', 'forearmL', [1.15, 'limb'], [1, 'limb'], 'cloth'],\n    ['limb', 'forearmL', 'handL', [1, 'limb'], [0.9, 'limb'], 'skin'],\n    ['ball', 'weaponL', [0.82, 'limb'], 'skin'],\n    ['eye', 'eyeL', [0.124, 'head'], 'eye'],\n  ],\n  builds: {\n    'build:bulky': { limbRadius: 0.08125, torsoRadius: 0.2625 },\n    'build:skeleton': { limbRadius: 0.034375, torsoRadius: 0.1625 },\n  },\n};\nexport function placeActor<C extends object>(\n  world: World<C>,\n  id: number,\n  at: Vec3Like,\n  yaw?: number,\n  options: { crouch?: boolean } = {},\n): void {\n  const w = world as unknown as World;\n  const e = w.get(id) as Partial<ActorComponents> | undefined;\n  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\n  const { actor, motion } = e;\n  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no movement model`, expected: 'no crouch: only an actor on a movement model (its component motion) crouches' }); // prettier-ignore\n  const physics = physicsOf(w);\n  const { offset, capsule } = actor.character;\n  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\n  const middle = motion && options.crouch ? hullFor(actor.character, { ...motion, stance: 'crouch' }) : capsule.height; // prettier-ignore\n  const up = { maxDistance: middle + capsule.radius, exclude: actor.body, groups: 'world' } as const;\n  const ceiling = physics.raycast([centre[0], centre[1] - capsule.height / 2, centre[2]], [0, 1, 0], up); // up its axis\n  if (ceiling && !oneWayOf(w).has(ceiling.body)) {\n    const given = vec(at, 'placeActor(at)');\n    const place = [given.x, given.y, given.z].map((v) => Math.round(v * 100) / 100).join(', ');\n    const [over, tall] = [(offset + capsule.radius + ceiling.distance).toFixed(2), (middle + 2 * capsule.radius).toFixed(2)]; // prettier-ignore\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crouch ? 'crouched' : 'standing'} hull, ${tall} m tall (it would sink through the floor)`, expected: motion && !options.crouch ? 'a place with headroom, or { crouch: true } under a low ceiling' : 'a place with headroom' }); // prettier-ignore\n  }\n  matchHull(physics, actor.body, actor.character, capsule.height, { air: false, tuck: false });\n  physics.setBody(actor.body, { position: centre, velocity: [0, 0, 0] });\n  const { x, y, z } = feetOf(physics, actor.body, actor.character);\n  Object.assign(actor, createCharacterState(), { yaw: yaw ?? actor.yaw, x, y, z });\n  if (motion) Object.assign(motion, createMotionState(), { holstered: motion.holstered }, options.crouch ? { stance: 'crouch', duck: 'ducked' } : {}); // prettier-ignore\n}\n\n/**\n * @file The camera mode `cam3={{name}}`: what it shows (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a side-scroller's dolly: it stands `distance` metres east of the player and `height` metres up, looks\n * west and down at a point a metre over his feet, and follows him with a lag (a time constant of 0.15 real seconds),\n * so a jump or a fall moves the picture smoothly and a stop settles it. Its code is\n * `cam3={{name}}[,<distance>,<height>]` in metres, 8 and 2.5 when left out.\n *\n * Invariants: view state, never the sim's: pure steps over plain data, which `followCamera` wraps in a camera; a\n * checked pose each frame (`makePose`: metres and radians, +Y up, its yaw the heading the intents' `cam` takes); `dt`\n * is real seconds since the last frame, so it frames alike at any frame rate. `defineCamera` adds the mode when the\n * page imports this module; from then `?cam3={{name}}`, `__engine.camera.set('cam3={{name}}', { blend: true })` and\n * the camera rig's blends reach it, and its name is a word no engine camera has.\n *\n * @example\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n\ndefineCamera('{{name}}', {\n  description: \"A side-scroller's dolly: east of the player, looking west, following him with a lag (replace).\",\n  create(code) {\n    const [distance = DEFAULTS.distance, height = DEFAULTS.height] = code.split(',').slice(1).map(Number);\n    if (!(distance > 0) || !Number.isFinite(height)) throw new Error(`${code} is no {{name}} camera: write ${FORM}`);\n    return {{name}}Camera({ distance, height });\n  },\n});\nengine/sim-api.ts:64:export { fromCamera } from './input/intents';\nengine/index.ts:35:export { defineMaterial } from './gfx/materials/material';\nengine/index.ts:108:export type { CameraInfo } from './app/view';\nengine/index.ts:115:export type { CameraPose } from './gfx/cameras/pose';\nengine/index.ts:145:export { defineBody } from './gfx/puppets/grammar';\nengine/index.ts:178:export type { OverlayCamera } from './ui/labels';\nengine/index.ts:207:export { defineSky } from './gfx/sky';\nengine/index.ts:239:export { defineLook } from './gfx/post/looks';\n","exit_code":2,"status":"failed"}}
