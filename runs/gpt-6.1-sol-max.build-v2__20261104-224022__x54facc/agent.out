{"type":"item.started","item":{"id":"item_137","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,105p' engine/sim/actorClips.ts; rg -n 'new ClipLibrary|bake|retarget|load' engine/anim/clip/pool.ts engine/anim/clip/library.ts engine/gfx/puppets/actors.ts | head -65; sed -n '185,237p' engine/gfx/puppets/actors.ts; sed -n '1,120p' engine/gfx/warmup.ts; tail -8 out/game/hub.log; tail -10 out/game/browser.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_137","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,105p' engine/sim/actorClips.ts; rg -n 'new ClipLibrary|bake|retarget|load' engine/anim/clip/pool.ts engine/anim/clip/library.ts engine/gfx/puppets/actors.ts | head -65; sed -n '185,237p' engine/gfx/puppets/actors.ts; sed -n '1,120p' engine/gfx/warmup.ts; tail -8 out/game/hub.log; tail -10 out/game/browser.log\"","aggregated_output":"/**\n * @file Clips on actors (PLAN.md §10.4, WP 8.9): the clip layer (engine/anim/clip/layer.ts) in an actor's animator,\n * as sim data. `spawnActor`'s `clips` (engine/sim/actors.ts), or `addClips(w, id, { sets })` for a live actor, gives\n * an animated actor the component `clips`\n * (clipsets.ts `CLIPS_FIELDS`: the clip sets it plays from, its contact IK and blade, and the layer's state), so the\n * sim hashes, captures and restores what it plays; `playClip(w, id, clip, play?)` and `stopClip(w, id, fade?)` play and\n * stop a clip on it (the layer's `play` and `stop`), `seekClip(w, id, t)` puts the clip on top at a moment (a frame\n * step), `locomoteClips(w, id, loops)` picks loops by ground speed, and `clipLayerOf(w, id)` is the layer itself,\n * loaded from the component, to read. The view poses the layer over the body (engine/gfx/puppets/actors.ts), from the\n * same data.\n *\n * The system `actors.clips` (phase `anim`, after `actors.anim`) steps each layer once a tick at the actor's ground\n * speed (its controller's horizontal velocity) and writes its state back; it emits each of the layer's events as\n * `clip` `{ id, type, clip, name?, side? }`: a clip's own events (`event`, with its name and side), an attack's\n * `hit`, a fall's `landed`, and a one-shot's `end`.\n *\n * Invariants: everything a layer is in the sim is the component; the layers are a pool per world (clipsets.ts\n * `ClipLayerPool`), loaded from the components at every use, so a bake made while the sim steps is the sim's own and\n * the view never shares one. The system is added once per world, with the first actor's clips. The clip sets come from the\n * registry (`defineClipSet`), registered before the scene starts.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the sets registered (defineClipSet):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:heroic' } });\n * // addClips(w, id, { sets: ['clipset:quaternius'] });\n * // playClip(w, id, 'QUATERNIUS/Wave', { mask: 'upper', walk: true });\n * // w.step(); w.get(id).clips.state.slots[0].clip; // 'QUATERNIUS/Wave'\n * @see engine/sim/actorClips.test.ts\n */\nimport { CLIPS_FIELDS, ClipLayerPool, emptyClipState, type ClipsData } from '../anim/clip/clipsets';\nimport type { Build } from '../anim/builds';\nimport { ClipLayer, type ClipLayerState, type ClipPlay } from '../anim/clip/layer';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** Declares the component `clips` on `registry`, once. */\nexport function defineClipKinds(registry: Registry = sharedRegistry): void {\n  if (registry.kinds().includes('component') && registry.has('component', 'clips')) return;\n  const description =\n    'An actor’s clip layer (engine/anim/clip/layer.ts) as plain data: the clip sets it plays from, its contact IK and blade, and what it plays.';\n  defineComponent('clips', { description, fields: CLIPS_FIELDS }, registry);\n}\ndefineClipKinds();\n\n/** What `spawnActor`'s `clips` and `addClips` take. */\nexport interface ClipsSpec {\n  /** The clip sets it plays from, by id (`clipset:quaternius`): a bare clip name is the first set's. */\n  sets: readonly string[];\n  /** Contact IK and the lift when posed (true). */\n  ik?: boolean;\n  /** A blade held in the right hand, m, kept above the floor (0). */\n  blade?: number;\n  /** The clip it plays from the start (`SET/Clip`, or the clip and how it plays: the layer's `play`); none when absent. */\n  play?: string | ({ clip: string } & ClipPlay);\n}\n\n/** An entity with an animated actor and its clips. */\ntype ClipActor = Pick<ActorComponents, 'actor' | 'animator'> & { id: number; clips: ClipsData };\n\n/** The layers of each world (see the file comment). */\nconst pools = new WeakMap<World, ClipLayerPool>();\n\n/** The pool of `w`, pruned of the despawned. */\nfunction poolOf(w: World): ClipLayerPool {\n  let pool = pools.get(w);\n  if (!pool) pools.set(w, (pool = new ClipLayerPool()));\n  pool.prune((id) => w.has(id));\n  return pool;\n}\n\n/** The entity `id`, an animated actor with clips; throws `SIM_BAD_ARGUMENT` naming `where` for another. */\nfunction clipActor(w: World, id: number, where: string): ClipActor {\n  const entity = w.get(id) as Partial<ClipActor> | undefined;\n  if (!entity?.actor || !entity.animator || !entity.clips)\n    throw codeError('SIM_BAD_ARGUMENT', {\n      where,\n      value: String(id),\n      expected: 'an animated actor given clips (addClips)',\n    });\n  return entity as ClipActor;\n}\n\n/**\n * The component `clips` for `spec` on an animator of `build` (its `play` playing, else nothing), the world given the\n * system `actors.clips`: what `spawnActor`'s `clips` spawns an actor with. Throws `CORE_NO_ENTRY` for a set not\n * registered, naming the closest, and `ANIM_UNKNOWN_CLIP` for a clip the sets lack.\n */\nexport function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\n  const w = world as unknown as World;\n  const pool = poolOf(w);\n  const library = spec.sets.map((set) => pool.library(set));\n  if (!w.systems.has('actors.clips')) w.systems.add('actors.clips', stepClips, { phase: 'anim' });\n  const data = { sets: [...spec.sets], ik: spec.ik ?? true, blade: spec.blade ?? 0, state: emptyClipState() };\n  if (spec.play === undefined) return data;\n  const { clip, ...play } = typeof spec.play === 'string' ? { clip: spec.play } : spec.play;\n  const layer = new ClipLayer({ library, build, dt: w.dt, ik: data.ik, blade: data.blade }).play(clip, play);\n  return { ...data, state: layer.save() };\n}\n\n/**\nrg: engine/anim/clip/pool.ts: No such file or directory (os error 2)\nengine/gfx/puppets/actors.ts:6: * actor with clips (`clips`, engine/sim/actorClips.ts) has its clip layer laid over the body, loaded from the same data\nengine/gfx/puppets/actors.ts:20: * animator, loaded at every pose (its flinch bends its spine; a body down on its face is drawn so), its `actions` (WP\nengine/gfx/puppets/actors.ts:27: * Invariants: presentation only (doctrine: WebGPU only): its animators and their layers are its own, loaded from the\nengine/gfx/puppets/actors.ts:295:          // its plants, as the feel kit lays them (engine/anim/bodyPlants.ts): a clip plants the feet it holds (retarget.ts's contact IK) // prettier-ignore\nengine/gfx/puppets/actors.ts:297:          if (own.reactions && actor.reactions) own.reactions.load(actor.reactions);\nengine/gfx/puppets/actors.ts:298:          if (own.actions && actor.actions) own.actions.load(actor.actions); // its effectors, flip and squash (WP 13.11)\nengine/anim/clip/library.ts:2: * @file The clip library (PLAN.md §10, WP 8.4; ADR-0010): a set of readable clips loaded for playing. It keeps\nengine/anim/clip/library.ts:3: * my-3d2dge's `Mocap.load` API (`my-3d2dge:src/mocap/mocap.js`: `clip`, `sample`, `moveAt`, `text`, `replace`,\nengine/anim/clip/library.ts:5: * as the clip layer crossfades) and adds what the runtime needs: `bake` (lazy, cached rotation tracks, bake.ts),\nengine/anim/clip/library.ts:19: * Invariants: a clip is decoded and baked on its own source's rest body (`set.sources[clip.src].rest`), as the\nengine/anim/clip/library.ts:20: * reference decodes are (ADR-0010 amendment 1). `replace` keeps the original for `restore`, and forgets the bakes;\nengine/anim/clip/library.ts:26: * const library = loadClipLibrary({ set: 'TEST', sources: { A: { rest: REST } },\nengine/anim/clip/library.ts:28: * library.bake('Stand').frames; // 31\nengine/anim/clip/library.ts:34:import { bakeClip, type BakedClip } from './bake';\nengine/anim/clip/library.ts:44:    fix: \"use one of its clips (library.names lists them; a page's library may need that set loaded)\",\nengine/anim/clip/library.ts:45:    doc: 'Raised by the clip library and the clip layer (engine/anim/clip/library.ts, layer.ts) for a clip name the loaded sets lack. The message names the closest names.',\nengine/anim/clip/library.ts:137:/** A loaded set (see the file comment). */\nengine/anim/clip/library.ts:139:  /** The set as loaded (edits through `replace` change only the library's own clips). */\nengine/anim/clip/library.ts:154:  /** Its rotation tracks, baked once (mirrored: the clip played on the other side). */\nengine/anim/clip/library.ts:155:  bake(name: string, mirror?: boolean): BakedClip;\nengine/anim/clip/library.ts:169:export function loadClipLibrary(input: ClipSet | string | object): ClipLibrary {\nengine/anim/clip/library.ts:173:  const bakes = new Map<string, BakedClip>();\nengine/anim/clip/library.ts:191:    for (const key of [name, `${name}|mirror`]) [bakes, strikes].forEach((cache) => cache.delete(key));\nengine/anim/clip/library.ts:202:    bake(name, mirror = false) {\nengine/anim/clip/library.ts:204:      let baked = bakes.get(key);\nengine/anim/clip/library.ts:205:      if (!baked) bakes.set(key, (baked = bakeClip(mirror ? mirrorClip(clip(name)) : clip(name), rest(name), name)));\nengine/anim/clip/library.ts:206:      return baked;\n  /** The guns the last draw put in the hands, by entity id, and the one first person drew last: whose, and its muzzle. */\n  const guns = new Map<number, HeldGun>();\n  let firstGun: { id: number; muzzle: Vector3 } | null = null;\n\n  /** Puppets no actor wears now, by the build and body they were made for (see the file comment). */\n  const spares = new Map<string, Puppet[]>();\n  const madeFor = new WeakMap<Puppet, string>();\n  /** Takes `puppet` off the stage, shown whole, into the spares. */\n  const retire = (puppet: Puppet) => {\n    puppet.hide([]);\n    viewmodels.get(puppet)?.update(null, null);\n    puppet.mesh.removeFromParent();\n    const key = madeFor.get(puppet)!;\n    spares.set(key, [...(spares.get(key) ?? []), puppet]);\n  };\n\n  const puppetFor = (id: number, data: AnimatorData, player: boolean, body: string): Puppet => {\n    let puppet = puppets.get(id);\n    if (puppet && puppet.compiled.skeleton.build.id === data.build && puppet.compiled.body.id === body) return puppet;\n    if (puppet) retire(puppet);\n    const key = `${data.build}|${body}`;\n    puppet = spares.get(key)?.pop() ?? createPuppet(compileBody(body, data.build, { registry }), { materials: options.materials, name: `actor#${id}` }); // prettier-ignore\n    madeFor.set(puppet, key);\n    puppet.mesh.name = `actor#${id}`;\n    Object.assign(puppet.mesh.userData, { entity: id, component: 'actor', protagonist: player });\n    root.add(puppet.mesh);\n    puppets.set(id, puppet);\n    return puppet;\n  };\n  /** Gives the player's `puppet` its first-person arms, once (see the file comment). */\n  const armsFor = (puppet: Puppet) => {\n    if (!viewmodels.has(puppet))\n      viewmodels.set(puppet, createViewmodel(puppet, { materials: options.materials, look, registry }));\n  };\n\n  return {\n    root,\n    puppets,\n    capture(entities, dt = step, queries = null) {\n      step = dt;\n      if (ground.of !== queries) ground = { of: queries, probe: queries && queryGround(queries) };\n      const seen = new Set<number>();\n      const drawn = new Set<number>();\n      const list = [...entities];\n      const byId = new Map(list.map((entity) => [entity.id, entity]));\n      for (const entity of list) {\n        const actor = entity.actor as (Place & { player?: boolean }) | undefined;\n        if (!actor || seen.has(entity.id)) continue;\n        seen.add(entity.id);\n        const place = { x: actor.x, y: actor.y, z: actor.z, yaw: actor.yaw };\n        const data = (entity.animator as AnimatorData | undefined) ?? null;\n        const clips = (entity.clips as ClipsData | undefined) ?? null;\n        const body = (entity.puppet as { body?: string } | undefined)?.body ?? ACTOR_BODY;\n/**\n * @file The warm-up registry (PLAN.md §8.7, I-18): every GPU pipeline is built before play needs it, so no frame\n * stalls on one. Pools and batches register the objects they will show (`register(id, { objects })`); `run(view)`\n * makes each drawable without showing it, compiles the scene with three.js's `compileAsync` one step per entry with\n * progress, then draws one warm frame through the view's own `draw`, which builds what `compileAsync` cannot reach\n * (the shadow, post and output passes). `key(scene)` is the scene's shader key: fog, environment, background, shadow\n * map, tone mapping, output colour space, the lights as r182's `LightsNode` keys them (id and `castShadow`), the\n * registered ids, and the parts other modules add (`keyPart`, the post filters of WP 7.4). The frame re-runs the\n * warm-up whenever the key changes (engine/gfx/renderer.ts), so toggling fog, shadows, a filter or a light rebuilds\n * at a moment of the engine's choosing, never in the middle of a frame.\n *\n * Measured on r182 (WP 2.1): `compileAsync` compiles for the render target set on the renderer, and `render()` draws\n * a scene into an internal half-float target whenever it converts colours for the screen, so a plain `compileAsync`\n * built 4 pipelines `render()` never used and missed 4 it did. The warm-up therefore compiles for each target the\n * frame really draws the scene into, its passes (`view.passes`): a post pass's `renderTarget`, set up by the pass's\n * `enter` (its MRT on), or, by default, what `render()` draws into: a 1 × 1 stand-in with the internal target's\n * attachments, which shares its render context. The warm frame catches the rest.\n *\n * Compile, never draw, what `compileAsync` reaches. Measured on SwiftShader (gate G6's review): a pipeline the warm\n * frame builds is built on its own, one after another, about 45 ms each, while `compileAsync` builds its pipelines\n * side by side, about 7 ms each; the Stress Box hall's warm-up through a post chain whose plain frames were left to\n * the warm frame built 155 of its pipelines there, and its warm frame took 6 to 7 s a camera.\n *\n * Drawable without showing: each registered object, and each hidden ancestor of it, is made visible, and the\n * topmost one made visible is scaled to nothing; an `InstancedMesh` with no instances gets one, at zero scale; every\n * object in the scene is drawn without frustum culling, so what is behind the camera is built too. All of it is put\n * back afterwards, in reverse order. Carried from `my-3d2dge:src/stress-world/50-frame.js:29-47` (`warmUp()`) as the\n * idea for a registry. What a page's warm-ups compile is the view setting `gfx.warmUp` (`WARMUP_SETTINGS`).\n *\n * Invariants: one warm-up runs at a time (a second `run` returns the first's promise); entries and key parts are kept\n * in id order; the report counts the pipelines this warm-up built (counted at the device, engine/gfx/pipelines.ts).\n *\n * @example\n * // const warmup = createWarmup({ renderer, counter: countPipelines(device) });\n * // warmup.register('pool:sparks', { objects: () => [sparks.mesh] });\n * // const report = await warmup.run({ scene, camera }, { onProgress: ({ done, total }) => bar(done / total) });\n * @see tests/e2e/renderer.spec.ts\n * @see engine/gfx/warmup.test.ts\n */\nimport {\n  ColorManagement,\n  Matrix4,\n  RenderTarget,\n  type Camera,\n  type ColorSpace,\n  type InstancedMesh,\n  type Object3D,\n  type Scene,\n  type WebGPURenderer,\n} from 'three/webgpu';\nimport { codeError, defineCodes } from '../core/log';\nimport type { Field } from '../core/schema';\nimport { defineSettings } from '../core/settings';\nimport { advanceFrame, type PipelineCounter } from './pipelines';\n\n/** The codes this module raises, with their fixes. */\nexport const WARMUP_CODES = defineCodes('gfx', {\n  GFX_DUPLICATE_WARMUP: {\n    template: 'the warm-up already has an entry {id}',\n    fix: 'dispose the first registration (register returns { dispose }), or register the second under another id',\n  },\n});\n\n/**\n * Its view setting `gfx.warmUp` (ADR-0008 amendment 11): what a page's warm-ups compile. r182 builds a shader for each\n * render object whose cache key differs, and the key holds the camera's id, the render target and an instanced mesh's\n * uuid, so a warm-up builds the same shader many times over (the playground's gym: 3,310 builds for 102 pipelines,\n * most of its start). `all` compiles both cameras, the plain frame's pass and the style set's own style, so no later\n * switch warms up; `asked` only what the page has drawn: the page's drawing, the post chain and the page's look\n * (engine/app/drawing.ts, engine/gfx/post/chain.ts, engine/app/look.ts) warm up a camera, the plain frame or a style\n * the first time a frame needs it, before that frame, never in it.\n */\nexport const WARMUP_SETTINGS = {\n  'gfx.warmUp': {\n    type: 'string',\n    enum: ['all', 'asked'],\n    default: 'all',\n    view: true,\n    description:\n      \"What a page's warm-ups compile: all (both cameras, the plain frame and the style set's own style, so no later switch warms up) or asked (only the cameras, the frame and the styles the page has drawn: a first frame of another warms up first, once; a faster start).\",\n  },\n} as const satisfies Record<string, Field>;\ndefineSettings(WARMUP_SETTINGS);\n\n/** Whether `settings` ask a page's warm-ups to compile only what it has drawn (`gfx.warmUp: asked`). */\nexport const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked';\n\n/** What a pool or batch registers: the objects it may show, each made drawable for the warm-up. */\nexport interface WarmupEntry {\n  objects(): readonly Object3D[];\n}\n\n/** One way a frame draws the scene: into a render target, with the renderer set up for it. */\nexport interface WarmupPass {\n  /** The render target (a post pass's `renderTarget`); what `render()` draws into when left out. */\n  target?: RenderTarget | null;\n  /** Sets the renderer up as the frame does for this target (a post pass turns its MRT on), once it is set. */\n  enter?(): void;\n  /** Puts back what `enter` set, after compiling for this target. */\n  leave?(): void;\n}\n\n/** What a warm-up draws: the scene, its camera, how the frame draws it, and every way it draws the scene. */\nexport interface WarmupView {\n  scene: Scene;\n  camera: Camera;\n  /** The frame's own drawing (a post pass's `render()`); `renderer.render(scene, camera)` by default. */\n  draw?: () => void;\n  /**\n   * Every way the frame draws the scene (a post chain's scene pass, then `render()`'s own target for its plain frames),\n   * each compiled for: the first step by step (the scene, then each entry), every other once, with every entry\n   * drawable. One pass into what `render()` draws into by default.\n   */\n  passes?: readonly WarmupPass[];\n}\n\n/** Progress, after each step: steps done of the total, and the step just done. */\nexport interface WarmupProgress {\n  done: number;\n  total: number;\nFAIL 2 players: Protocol passed but engine is not ready\nFAIL 3 players: Protocol passed but engine is not ready\nFAIL keyboard begins and leans: Right lean did not move balance {'title': 'Wobble Fit', 'ready': True, 'uiTicks': 561, 'screen': 'play', 'attract': False, 'lastDevice': 'keyboard', 'glyphSet': 'PlayStation', 'volumes': {'music': 0.1, 'effects': 0.8, 'voices': 0.7}, 'day': 1, 'event': 'check', 'focus': 0, 'mode': 'event', 'tick': 6, 'phase': 0, 'score': 700, 'balance': {'x': 0.015681298091257213, 'y': -0.0039410459797745, 'calm': 0}, 'progress': {'day': 1, 'done': [], 'ages': [], 'pebbles': 0, 'finds': [], 'bests': {}, 'complete': False, 'look': 0, 'colour': 0}, 'touchOnly': False, 'hubActive': False}\nFAIL pause dev slider and reset: Page.wait_for_function: SyntaxError: missing ) after argument list {'title': 'Wobble Fit', 'ready': True, 'uiTicks': 901, 'screen': 'dev', 'attract': False, 'lastDevice': 'mouse', 'glyphSet': 'PlayStation', 'volumes': {'music': 0.1, 'effects': 0.8, 'voices': 0.7}, 'day': 1, 'event': 'check', 'focus': 0, 'mode': 'event', 'tick': 6, 'phase': 0, 'score': 700, 'balance': {'x': 0.015681298091257213, 'y': -0.0039410459797745, 'calm': 0}, 'progress': {'day': 1, 'done': [], 'ages': [], 'pebbles': 0, 'finds': [], 'bests': {}, 'complete': False, 'look': 0, 'colour': 0}, 'touchOnly': False, 'hubActive': False}\nFAIL standard pad navigation and lean: Page.wait_for_function: Timeout 30000ms exceeded. {'title': 'Wobble Fit', 'ready': True, 'uiTicks': 2943, 'screen': 'play', 'attract': True, 'lastDevice': 'pad', 'glyphSet': 'Xbox', 'volumes': {'music': 0.23, 'effects': 0.8, 'voices': 0.7}, 'day': 1, 'event': 'pose', 'focus': 4, 'mode': 'event', 'tick': 168, 'phase': 0, 'score': 911, 'balance': {'x': -0.003934483812813153, 'y': 0.05396633375634833, 'calm': 0.6496482959769444}, 'progress': {'day': 1, 'done': [], 'ages': [], 'pebbles': 0, 'finds': [], 'bests': {}, 'complete': False, 'look': 1, 'colour': 0}, 'touchOnly': False, 'hubActive': False}\nFAIL activity views and finale render: Page.wait_for_function: Timeout 20000ms exceeded. {'title': 'Wobble Fit', 'ready': True, 'uiTicks': 4139, 'screen': 'pause', 'attract': False, 'lastDevice': 'keyboard', 'glyphSet': 'Xbox', 'volumes': {'music': 0.23, 'effects': 0.8, 'voices': 0.7}, 'day': 1, 'event': 'pose', 'focus': 5, 'mode': 'event', 'tick': 900, 'phase': 0, 'score': 223, 'balance': {'x': -0.06600187712884183, 'y': 0.07310557086056409, 'calm': 0}, 'progress': {'day': 1, 'done': [], 'ages': [], 'pebbles': 0, 'finds': [], 'bests': {}, 'complete': False, 'look': 1, 'colour': 0}, 'touchOnly': False, 'hubActive': False}\n","exit_code":0,"status":"completed"}}
