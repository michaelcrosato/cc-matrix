{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"cat >> labs/game/ui/theme.css <<'EOF'\n/* Explicitly reset the engine overlay's typography for the game's shell. */\n#shell,#game-hud,#demo-banner{font-family:ui-rounded,\\\"SF Pro Rounded\\\",\\\"Segoe UI Rounded\\\",system-ui,sans-serif;font-weight:400;color:var(--ink);line-height:1.35}#shell h1,#game-hud h2{color:var(--ink)}\nEOF\ncat > labs/game/scenes/ambience.ts <<'EOF'\n/** @file Persistent cairn, creeping plaques, Tare's hop and the finale's guest procession. */\nimport { placeActor, type World } from '../../../engine/sim-api';\nimport { flowOf, type GameComponents } from './state';\nimport { put } from './world';\nimport { spawnGuest } from '../cast/guest';\nimport { heightAt } from './terrain';\nexport function ambience(w: World<GameComponents>): void {\n const f=flowOf(w);\n if(\"'!f.roundOnly && !f.demo && f.cairn.length<Math.min(90,f.pebbles) && w.tick%8===0){\n  const i=f.cairn.length,level=Math.floor(i/3),angle=i*2.4;\n  f.cairn.push(put(w,'\"'pebble',-7+Math.sin(angle)*.22,34+Math.cos(angle)*.22,8+level*.16));\n }\n const tare=w.get(f.tare)?.sceneProp;\n if(tare){\n  const walking=f.mode==='roam';\n  tare.x=walking?f.feet[0]+1.4:-60.5;\n  tare.z=walking?f.feet[2]+1.4:22;\n  tare.y=(walking?heightAt(tare.x,tare.z):8)+Math.abs(Math.sin(w.tick/18))*.13;\n }\n if(w.tick%120===0 && \"'!f.roundOnly)for(const e of w.query('\"'plaque')){\n  e.sceneProp.x=e.plaque.x+(f.day-1)*.3;\n  e.sceneProp.z=e.plaque.z+(f.day-1)*.18;\n }\n const r=f.event;\n if(f.mode==='event' && r.id==='tilt'){\n  if(f.finaleGuests.length===0)for(let i=0;i<12;i++)f.finaleGuests.push(spawnGuest(w,-12+i*2,8.2,34+i%3*2,i%4));\n  if(r.phase===1 || r.phase===2)for(let i=0;i<f.finaleGuests.length;i++){\n   const id=f.finaleGuests[i],e=w.get(id);if(\"'!e?.actor)continue;\n   const delivered=i<r.guests;\n   const tx=delivered?74:Math.max(-30,10-r.tilt*3+i*2),tz=delivered?8+i%3*2:34+i%3*2;\n   const x=e.actor.x+(tx-e.actor.x)*.009,z=e.actor.z+(tz-e.actor.z)*.009;\n   placeActor(w,id,[x,heightAt(x,z)+.15,z],Math.PI/2);\n  }\n }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/pilot.ts');s=p.read_text().replace(\\\"import type { EventConfig } from './events/types';\\\", \\\"import type { EventConfig } from './events/types';\\\\nimport { ambience } from './ambience';\\\\nimport { dialogue, PLAQUES } from '../ui/lines/cast';\\\")\ns=s.replace(\\\"  f.focus = focus;\\\", \\\"  if (\"'!focus) for (const [id, name] of [[f.plumb,'\"'Plumb'], ...f.others.map((id, n) => [id, ['Gerald','Bex','Nan'][n]]), [f.tare,'Tare']] as [number,string][]) { const e=w.get(id); const pos=e?.actor??e?.sceneProp; if(pos && Math.hypot(pos.x-x,pos.z-z)<3) focus=\"'`cast:${name}`; }'\"\\\\n  if (\"'!focus) for (const e of w.query('\"'sceneProp')) if(e.sceneProp.prop==='prop:benchRetreat' && Math.hypot(e.sceneProp.x-x,e.sceneProp.z-z)<2) focus='bench';\\\\n  f.focus = focus;\\\")\na=s.index('      f.message = [',s.index(\\\"focus.startsWith('plaque')\\\"));b=s.index('      f.serial++;',a)\ns=s[:a]+\\\"      f.message = PLAQUES[Number(focus.slice(6)) % PLAQUES.length];\\\\n\\\"+s[b:]\ns=s.replace(\\\"    } else startEvent(w, activity(focus).id);\\\", \\\"    } else if(focus.startsWith('cast:')) { const speaker=focus.slice(5); f.message=dialogue(speaker,f.day,f.talks[speaker]??0); f.talks[speaker]=(f.talks[speaker]??0)+1; f.speaker=speaker; f.serial++; } else if(focus==='bench'){ f.mode='sit';f.message='A little time to do nothing. Use the bench again to stand.';f.serial++; } else startEvent(w, activity(focus).id);\\\")\ns=s.replace('  f.clock++;', '  f.clock++;\\\\n  ambience(w);\\\\n  if(f.mode===\\\\'sit\\\\'){poseGuest(w,f.hero,\\\\'Nothing\\\\',1,f.wobble);if(pressed(i,\\\\'use\\\\')||pressed(i,\\\\'jump\\\\')){f.mode=\\\\'roam\\\\';f.serial++;}return;}')\ns=s.replace(\\\"  if (f.mode === 'roam') {\\\\n    walking\\\", \\\"  if (f.mode === 'roam') {\\\\n    if(w.settings.get<boolean>('game.auto') && f.clock%60===0){const next=DAYS[Math.min(4,f.day-1)].events.find((id)=>\"'!f.done.includes(id));if(next)startEvent(w,next);else sleep(w);return;}'\"\\\\n    walking\\\")\ns=s.replace('    stepEvent(r, f.wobble, input, c);', \\\"    if(c.auto) input=botFor(r,f.wobble,c);\\\\n    if(r.id\"'!=='\"'group') r.inputs[0]=input;\\\\n    stepEvent(r, f.wobble, input, c);\\\")\np.write_text(s)\np=Path('labs/game/ui/hud.ts');s=p.read_text().replace(\\\"  if (f.mode === 'roam')\\\", \\\"  if (f.mode === 'sit') return '<div class=\\\\\\\"roam-message\\\\\\\">A little time to do nothing. Use the bench again to stand.</div>';\\\\n  if (f.mode === 'roam')\\\")\ns=s.replace(\\\"f.focus.startsWith('plaque')\\\\n                  ? 'Read plaque'\\\", \\\"f.focus.startsWith('plaque')\\\\n                  ? 'Read plaque'\\\\n                  : f.focus.startsWith('cast:') ? \"'`Talk to ${safe(f.focus.slice(5))}` : f.focus==='\"'bench'?'Sit a moment'\\\")\np.write_text(s)\nPY\nnpx tsc -b tsconfig.check.json --pretty false\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"cat >> labs/game/ui/theme.css <<'EOF'\n/* Explicitly reset the engine overlay's typography for the game's shell. */\n#shell,#game-hud,#demo-banner{font-family:ui-rounded,\\\"SF Pro Rounded\\\",\\\"Segoe UI Rounded\\\",system-ui,sans-serif;font-weight:400;color:var(--ink);line-height:1.35}#shell h1,#game-hud h2{color:var(--ink)}\nEOF\ncat > labs/game/scenes/ambience.ts <<'EOF'\n/** @file Persistent cairn, creeping plaques, Tare's hop and the finale's guest procession. */\nimport { placeActor, type World } from '../../../engine/sim-api';\nimport { flowOf, type GameComponents } from './state';\nimport { put } from './world';\nimport { spawnGuest } from '../cast/guest';\nimport { heightAt } from './terrain';\nexport function ambience(w: World<GameComponents>): void {\n const f=flowOf(w);\n if(\"'!f.roundOnly && !f.demo && f.cairn.length<Math.min(90,f.pebbles) && w.tick%8===0){\n  const i=f.cairn.length,level=Math.floor(i/3),angle=i*2.4;\n  f.cairn.push(put(w,'\"'pebble',-7+Math.sin(angle)*.22,34+Math.cos(angle)*.22,8+level*.16));\n }\n const tare=w.get(f.tare)?.sceneProp;\n if(tare){\n  const walking=f.mode==='roam';\n  tare.x=walking?f.feet[0]+1.4:-60.5;\n  tare.z=walking?f.feet[2]+1.4:22;\n  tare.y=(walking?heightAt(tare.x,tare.z):8)+Math.abs(Math.sin(w.tick/18))*.13;\n }\n if(w.tick%120===0 && \"'!f.roundOnly)for(const e of w.query('\"'plaque')){\n  e.sceneProp.x=e.plaque.x+(f.day-1)*.3;\n  e.sceneProp.z=e.plaque.z+(f.day-1)*.18;\n }\n const r=f.event;\n if(f.mode==='event' && r.id==='tilt'){\n  if(f.finaleGuests.length===0)for(let i=0;i<12;i++)f.finaleGuests.push(spawnGuest(w,-12+i*2,8.2,34+i%3*2,i%4));\n  if(r.phase===1 || r.phase===2)for(let i=0;i<f.finaleGuests.length;i++){\n   const id=f.finaleGuests[i],e=w.get(id);if(\"'!e?.actor)continue;\n   const delivered=i<r.guests;\n   const tx=delivered?74:Math.max(-30,10-r.tilt*3+i*2),tz=delivered?8+i%3*2:34+i%3*2;\n   const x=e.actor.x+(tx-e.actor.x)*.009,z=e.actor.z+(tz-e.actor.z)*.009;\n   placeActor(w,id,[x,heightAt(x,z)+.15,z],Math.PI/2);\n  }\n }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/pilot.ts');s=p.read_text().replace(\\\"import type { EventConfig } from './events/types';\\\", \\\"import type { EventConfig } from './events/types';\\\\nimport { ambience } from './ambience';\\\\nimport { dialogue, PLAQUES } from '../ui/lines/cast';\\\")\ns=s.replace(\\\"  f.focus = focus;\\\", \\\"  if (\"'!focus) for (const [id, name] of [[f.plumb,'\"'Plumb'], ...f.others.map((id, n) => [id, ['Gerald','Bex','Nan'][n]]), [f.tare,'Tare']] as [number,string][]) { const e=w.get(id); const pos=e?.actor??e?.sceneProp; if(pos && Math.hypot(pos.x-x,pos.z-z)<3) focus=\"'`cast:${name}`; }'\"\\\\n  if (\"'!focus) for (const e of w.query('\"'sceneProp')) if(e.sceneProp.prop==='prop:benchRetreat' && Math.hypot(e.sceneProp.x-x,e.sceneProp.z-z)<2) focus='bench';\\\\n  f.focus = focus;\\\")\na=s.index('      f.message = [',s.index(\\\"focus.startsWith('plaque')\\\"));b=s.index('      f.serial++;',a)\ns=s[:a]+\\\"      f.message = PLAQUES[Number(focus.slice(6)) % PLAQUES.length];\\\\n\\\"+s[b:]\ns=s.replace(\\\"    } else startEvent(w, activity(focus).id);\\\", \\\"    } else if(focus.startsWith('cast:')) { const speaker=focus.slice(5); f.message=dialogue(speaker,f.day,f.talks[speaker]??0); f.talks[speaker]=(f.talks[speaker]??0)+1; f.speaker=speaker; f.serial++; } else if(focus==='bench'){ f.mode='sit';f.message='A little time to do nothing. Use the bench again to stand.';f.serial++; } else startEvent(w, activity(focus).id);\\\")\ns=s.replace('  f.clock++;', '  f.clock++;\\\\n  ambience(w);\\\\n  if(f.mode===\\\\'sit\\\\'){poseGuest(w,f.hero,\\\\'Nothing\\\\',1,f.wobble);if(pressed(i,\\\\'use\\\\')||pressed(i,\\\\'jump\\\\')){f.mode=\\\\'roam\\\\';f.serial++;}return;}')\ns=s.replace(\\\"  if (f.mode === 'roam') {\\\\n    walking\\\", \\\"  if (f.mode === 'roam') {\\\\n    if(w.settings.get<boolean>('game.auto') && f.clock%60===0){const next=DAYS[Math.min(4,f.day-1)].events.find((id)=>\"'!f.done.includes(id));if(next)startEvent(w,next);else sleep(w);return;}'\"\\\\n    walking\\\")\ns=s.replace('    stepEvent(r, f.wobble, input, c);', \\\"    if(c.auto) input=botFor(r,f.wobble,c);\\\\n    if(r.id\"'!=='\"'group') r.inputs[0]=input;\\\\n    stepEvent(r, f.wobble, input, c);\\\")\np.write_text(s)\np=Path('labs/game/ui/hud.ts');s=p.read_text().replace(\\\"  if (f.mode === 'roam')\\\", \\\"  if (f.mode === 'sit') return '<div class=\\\\\\\"roam-message\\\\\\\">A little time to do nothing. Use the bench again to stand.</div>';\\\\n  if (f.mode === 'roam')\\\")\ns=s.replace(\\\"f.focus.startsWith('plaque')\\\\n                  ? 'Read plaque'\\\", \\\"f.focus.startsWith('plaque')\\\\n                  ? 'Read plaque'\\\\n                  : f.focus.startsWith('cast:') ? \"'`Talk to ${safe(f.focus.slice(5))}` : f.focus==='\"'bench'?'Sit a moment'\\\")\np.write_text(s)\nPY\nnpx tsc -b tsconfig.check.json --pretty false\"","aggregated_output":"labs/game/scenes/ambience.ts(21,3): error TS18048: 'e.sceneProp' is possibly 'undefined'.\nlabs/game/scenes/ambience.ts(22,3): error TS18048: 'e.sceneProp' is possibly 'undefined'.\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/game.test.ts <<'EOF'\n/** @file Objective balance, activity, persistence and complete-residency regression tests. */\nimport { describe, it, expect } from 'vitest';\nimport { createHeadless } from '../../../engine';\nimport { ACTIVITIES, ageFor, DAYS } from './data/days';\nimport { createRun, botFor, stepEvent, guideFor } from './events/registry';\nimport { DEFAULT_WOBBLE, makeWobble, stepWobble, emptyLean } from './wobble';\nimport { TUNING } from './settings';\nimport { island } from './island';\nimport type { Flow } from './state';\nimport type { GameInspector } from '../ui/context';\nconst config = (day=1) => ({ wobble: { ...DEFAULT_WOBBLE }, get: (key:string)=>TUNING.find(([k])=>k===key)?.[1]??1, auto: true, day, expert: false });\nconst flow = (h: GameInspector) => (h.state('retreat').entities[0].retreat as {data:Flow}).data;\ndescribe('Little Fulcrum model',()=>{\n it('makes a delayed thumb useful, a full held lean topple, and calm quieten the sway',()=>{\n  const counts: Record<string,number>={};\n  for(const kind of ['perfect','human','sloppy','idle']){\n   let inside=0,total=0;\n   for(let seed=1;seed<=10;seed++){\n    const r=createRun('check',seed,true), w=makeWobble([seed*.4,seed*.7,1,2,3,4]), c=config();\n    for(let i=0;i<1200;i++){stepEvent(r,w,botFor(r,w,c,kind),c);if(Math.hypot(w.x,w.y)<.22)inside++;total++;}\n   }\n   counts[kind]=inside/total;\n  }\n  expect(counts.perfect).toBeGreaterThan(.95);expect(counts.human).toBeGreaterThan(counts.idle+.15);expect(counts.sloppy).toBeGreaterThan(counts.idle);\n  const w=makeWobble([0,1,2,3,4,5]);for(let i=0;i<900;i++)stepWobble(w,{...emptyLean(),x:1},i,DEFAULT_WOBBLE);expect(w.topples).toBeGreaterThan(0);\n  expect(ageFor(1000)).toBe(18);expect(ageFor(0)).toBe(82);\n });\n for(const a of ACTIVITIES) it(\"'`${a.id}: four pilots on ten seeds and random input finish with finite scores`,()=>{\n  for(let seed=1;seed<=10;seed++){\n   const scores: Record<string,number>={};\n   for(const kind of ['\"'perfect','human','sloppy','idle','random']){\n    const r=createRun(a.id,seed),w=makeWobble([seed*.4,seed*.7,1,2,3,4]),c=config();\n    while(r.tick<r.length){\n     const input=kind==='random'?{x:Math.sin(r.tick*.19),y:Math.cos(r.tick*.13),l:r.tick%19<9?1:0,r:r.tick%23<10?1:0,act:r.tick%101===0}:botFor(r,w,c,kind);\n     stepEvent(r,w,input,c);\n    }\n    const score=a.id==='group'?r.score/3:r.score;scores[kind]=score;\n    expect(Number.isFinite(score),\"'`${a.id}/${seed}/${kind}`).toBe(true);expect(score).toBeGreaterThanOrEqual(0);expect(score).toBeLessThanOrEqual(1000);\n   }\n   expect(scores.perfect,`${a.id}/${seed} perfect`).toBeGreaterThanOrEqual(750);\n   expect(scores.human,`${a.id}/${seed} human`).toBeGreaterThanOrEqual(550);\n   expect(scores.sloppy,`${a.id}/${seed} sloppy`).toBeGreaterThanOrEqual(300);\n   expect(scores.idle,`${a.id}/${seed} idle`).toBeLessThanOrEqual(500);expect(scores.idle).toBeLessThan(scores.human);\n  }\n });\n it('\"'pond punishes a fake prompt, real breath improves it, and guides never mutate state',()=>{\n  const r=createRun('pond',7),w=makeWobble([0,1,2,3,4,5]),c=config();\n  for(let i=0;i<120;i++)stepEvent(r,w,emptyLean(),c);expect(r.score).toBe(500);\n  stepEvent(r,w,{...emptyLean(),act:true},c);expect(r.composure).toBe(920);\n  const before=JSON.stringify(r);guideFor(r,c);expect(JSON.stringify(r)).toBe(before);\n });\n it('all eight poses have safe guide seats and complete without input',()=>{\n  for(const day of [1,2,5]){const r=createRun('pose',3),w=makeWobble([0,1,2,3,4,5]),c=config(day);while(r.tick<r.length){const g=guideFor(r,c);expect(Math.hypot(g.x,g.y)).toBeLessThanOrEqual(.51);stepEvent(r,w,emptyLean(),c);}expect(r.tick).toBeGreaterThanOrEqual(r.length);}\n });\n});\ndescribe('the actual engine scene',()=>{\n it('capture and restore continues exactly with its physics and clip state',async()=>{\n  const h=await createHeadless({scene:island,seed:7}) as GameInspector;\n  h.actions.run('game.start',{event:'pose'});h.step(120,{'game:r':.2,'game:fl':1,'game:fr':1});\n  const capture=h.capture();h.step(90,{'game:l':.1});const expected=h.hash();h.restore(capture);h.step(90,{'game:l':.1});expect(h.hash()).toBe(expected);expect(h.errors).toHaveLength(0);\n });\n it('the complete five-day residency reaches credits on three seeds',async()=>{\n  for(const seed of [2,7,19]){\n   const h=await createHeadless({scene:island,seed,settings:{'game.auto':true,'game.pace':8}}) as GameInspector;\n   h.actions.run('game.begin');\n   let tick=0;const seen=new Set<string>();\n   while(flow(h).mode\"'!=='\"'credits' && tick<35000){h.step(60);tick+=60;const f=flow(h);if(f.mode==='event')seen.add(\"'`${f.day}:${f.event.id}`);}\n   expect(flow(h).mode,`seed ${seed}: ${flow(h).day}/${flow(h).event.id}`).toBe('\"'credits');\n   for(let d=0;d<5;d++)for(const id of DAYS[d].events)expect(seen.has(\"'`${d+1}:${id}`),`${d+1}:${id}`).toBe(true);\n   expect(flow(h).ages).toHaveLength(6);expect(h.errors).toHaveLength(0);\n  }\n },120000);\n});\nEOF\nnpx vitest run labs/game/scenes/game.test.ts --maxWorkers=1 > out/game/tests.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/game.test.ts <<'EOF'\n/** @file Objective balance, activity, persistence and complete-residency regression tests. */\nimport { describe, it, expect } from 'vitest';\nimport { createHeadless } from '../../../engine';\nimport { ACTIVITIES, ageFor, DAYS } from './data/days';\nimport { createRun, botFor, stepEvent, guideFor } from './events/registry';\nimport { DEFAULT_WOBBLE, makeWobble, stepWobble, emptyLean } from './wobble';\nimport { TUNING } from './settings';\nimport { island } from './island';\nimport type { Flow } from './state';\nimport type { GameInspector } from '../ui/context';\nconst config = (day=1) => ({ wobble: { ...DEFAULT_WOBBLE }, get: (key:string)=>TUNING.find(([k])=>k===key)?.[1]??1, auto: true, day, expert: false });\nconst flow = (h: GameInspector) => (h.state('retreat').entities[0].retreat as {data:Flow}).data;\ndescribe('Little Fulcrum model',()=>{\n it('makes a delayed thumb useful, a full held lean topple, and calm quieten the sway',()=>{\n  const counts: Record<string,number>={};\n  for(const kind of ['perfect','human','sloppy','idle']){\n   let inside=0,total=0;\n   for(let seed=1;seed<=10;seed++){\n    const r=createRun('check',seed,true), w=makeWobble([seed*.4,seed*.7,1,2,3,4]), c=config();\n    for(let i=0;i<1200;i++){stepEvent(r,w,botFor(r,w,c,kind),c);if(Math.hypot(w.x,w.y)<.22)inside++;total++;}\n   }\n   counts[kind]=inside/total;\n  }\n  expect(counts.perfect).toBeGreaterThan(.95);expect(counts.human).toBeGreaterThan(counts.idle+.15);expect(counts.sloppy).toBeGreaterThan(counts.idle);\n  const w=makeWobble([0,1,2,3,4,5]);for(let i=0;i<900;i++)stepWobble(w,{...emptyLean(),x:1},i,DEFAULT_WOBBLE);expect(w.topples).toBeGreaterThan(0);\n  expect(ageFor(1000)).toBe(18);expect(ageFor(0)).toBe(82);\n });\n for(const a of ACTIVITIES) it(\"'`${a.id}: four pilots on ten seeds and random input finish with finite scores`,(