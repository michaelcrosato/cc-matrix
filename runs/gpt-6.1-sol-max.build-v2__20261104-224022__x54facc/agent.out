{"type":"item.completed","item":{"id":"item_217","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/dive-meter.ts <<'EOF'\n/** @file Compose power, release timing and the three gull judges in one readable instrument. */\nimport type {ActivityRun} from '../scenes/events/types';\nexport function diveMeter(r:ActivityRun):string{\n const local=r.tick%1080,swing=.5+.5*Math.sin(local/25);\n const value=r.phase===0?r.hold:r.phase===1?swing:1-Math.min(1,Math.abs(Math.sin(r.angle))+Math.abs(Math.sin(r.velocity)));\n const last=r.scores.at(-1),card=last===undefined?0:Math.round(Math.max(0,Math.min(10,(last*24/1000-4)/2)));\n const label=r.phase===0?'COMPOSE':r.phase===1?'RELEASE AT THE TOP':'ENTER STRAIGHT';\n const cards=last===undefined?'':'<div class=\\\"gull-cards\\\">'+[card,card,4].map(score=>'<span><svg viewBox=\\\"0 0 64 38\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 23Q17 8 30 21Q46 8 60 23M27 23q5-7 10 0l-5 8Z\\\"/></svg><strong>'+score+'</strong></span>').join('')+'</div><p>The third gull has considered a four.</p>';\n return '<div class=\\\"dive-meter\\\"><b>'+label+'</b><div class=\\\"dive-track\\\"><div class=\\\"dive-band\\\"></div><div class=\\\"dive-fill\\\" style=\\\"height:'+value*100+'%\\\"></div><div class=\\\"dive-needle\\\" style=\\\"bottom:'+value*94+'%\\\"></div></div>'+cards+'</div>';\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/terrain.ts');s=p.read_text().replace('  ].map((flat) => ({ ...flat, height: flat.height + 1 })),', \\\"  ].map(flat=>({...flat,height:flat.height+1})).concat([{rect:[-69,50,-60,80],height:0,margin:0}]),\\\");p.write_text(s)\np=Path('labs/game/scenes/data/days.ts');s=p.read_text();a=s.index(\\\"id: 'line'\\\");b=s.index(\\\"id: 'step'\\\",a);s=s[:a]+s[a:b].replace('z: 60','z: 42')+s[b:];p.write_text(s)\np=Path('labs/game/ui/hud.ts');s=p.read_text().replace(\\\"import { glyph,\\\", \\\"import {diveMeter} from './dive-meter';\\\\nimport { glyph,\\\").replace(\\\"  if (r.id =