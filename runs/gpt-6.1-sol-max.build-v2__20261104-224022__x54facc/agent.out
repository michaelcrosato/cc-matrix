{"type":"item.started","item":{"id":"item_180","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/flow.ts');s=p.read_text().replace('(f.complete && f.ages.length < 6)', '(f.complete&&\"'!f.endingSeen&&f.ages.length<6)'\"');p.write_text(s)\np=Path('labs/game/scenes/ambience.ts');s=p.read_text().replace('(f.day - 1) * 0.14', '(f.complete?0:Math.min(4,f.day-1))*.14').replace('f.day >= 4)', 'f.day>=4&&\"'!f.complete)'\"').replace('(f.day - 1) * 0.3', 'Math.min(4,f.day-1)*.3').replace('(f.day - 1) * 0.18', 'Math.min(4,f.day-1)*.18');p.write_text(s)\nPY\ncat >> labs/game/scenes/game.test.ts <<'EOF'\n\nit('free practice checks return to the island, retakes replace today, and later mornings stay available',async()=>{\n const h=await createHeadless({scene:island,seed:31}) as GameInspector;h.actions.run('game.unlock');\n const check=()=>{h.actions.run('game.start',{event:'check'});h.actions.run('game.finish',{score:800});h.actions.run('game.leave');};\n check();expect(flow(h).mode).toBe('roam');expect(flow(h).ages).toHaveLength(1);check();expect(flow(h).ages).toHaveLength(1);\n h.actions.run('game.sleep');expect(flow(h).day).toBe(7);check();expect(flow(h).ages).toHaveLength(2);expect(flow(h).mode).toBe('roam');\n});\nEOF\nnpx prettier --write labs/game/scenes/{flow,ambience,game.test}.ts > out/game/format-final.log\nnpx tsc -b tsconfig.check.json --pretty false\nnode labs/game/tools/onefile.mjs\npython3 -u labs/game/tools/viewport-check.py > out/game/viewport.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
