{"type":"item.completed","item":{"id":"item_168","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,133p' engine/sim/crowdBodies.ts; sed -n '45,130p' engine/physics/crowd.ts; rg -n 'addAgent|crowdBody:' labs/box/scenes/crowd-1000.ts | head -15; sed -n '88,120p' labs/box/scenes/crowd-1000.ts; sed -n '128,204p' engine/sim/crowdBodies.ts; rg -n 'lean' engine/anim/character.ts engine/anim/humanoid.ts | head -14\"","aggregated_output":" */\nimport { AnimatorPool, ANIMATOR_FIELDS, type AnimatorData } from '../anim/character';\nimport { Blob, type BlobInput, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\nimport type { GaitProbe } from '../anim/proc/gait';\nimport { Quadruped, type QuadrupedState } from '../anim/quadruped';\nimport { STEP } from '../anim/humanoidRates';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { copyValue, defineSchema } from '../core/schema';\nimport { hasPhysics, physicsOf } from '../physics/binding';\nimport type { Vec3Like } from '../physics/queries';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The rigs a crowd body can have. */\nexport type CrowdRig = 'humanoid' | 'blob' | 'floater' | 'quadruped';\n\n/** A crowd body's fields, for the component `crowdBody`: its rig and look, where it stands, its rig's state. */\nexport const CROWD_BODY_FIELDS = defineSchema({\n  rig: {\n    type: 'string',\n    enum: ['humanoid', 'blob', 'floater', 'quadruped'],\n    default: 'humanoid',\n    description: 'Its rig: a humanoid (an animator), a blob, a floater or a quadruped.',\n  },\n  look: {\n    type: 'string',\n    default: '',\n    description:\n      'What it wears: a humanoid’s build id (build:chibi when empty), a blob’s features (horns, ears or wings; none when empty); a floater and a quadruped have none.',\n  },\n  size: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 100,\n    unit: 'm',\n    description: 'A blob’s radius at rest (BLOB.radius when 0); unused for the others.',\n  },\n  x: {\n    type: 'number',\n    default: 0,\n    unit: 'm',\n    description: 'Where it stands, east: a humanoid’s, blob’s or quadruped’s feet, a floater’s core.',\n  },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, south.' },\n  yaw: { type: 'number', default: 0, unit: 'rad', description: 'Where it faces: forward is (sin yaw, 0, cos yaw).' },\n  state: {\n    type: 'object',\n    default: {},\n    description:\n      'Its rig’s state as plain data, written by stepCrowdBody: the animator’s data, the blob’s state, the floater’s or the quadruped’s; empty until its first step.',\n  },\n});\n\n/** A crowd body: what `CROWD_BODY_FIELDS` holds. */\nexport interface CrowdBody {\n  rig: CrowdRig;\n  look: string;\n  size: number;\n  x: number;\n  y: number;\n  z: number;\n  yaw: number;\n  state: Record<string, unknown>;\n}\n\n/** The component `crowdBody`: an entity the stage draws through a crowd. */\nexport const CROWD_BODY = defineComponent('crowdBody', {\n  description:\n    'A crowd member’s look and rig: a humanoid, blob, floater or quadruped, where it stands, and its rig’s state, stepped by stepCrowdBody and drawn through a crowd.',\n  fields: CROWD_BODY_FIELDS,\n});\n\n/** What a crowd body's rig is told each step (see the file comment). */\nexport interface CrowdBodyInput {\n  /** Where it stands now (m): a humanoid's or a blob's feet, a floater's core. */\n  at: Vec3Like;\n  /** Its velocity (m/s): a humanoid walks at it, a blob looks along it (unless told), a floater turns and banks by it. */\n  velocity?: Vec3Like;\n  /** Where a humanoid faces (rad; the last when absent); a floater turns to it (else to its travel). */\n  yaw?: number;\n  /** A humanoid off its feet. */\n  air?: boolean;\n  /** A humanoid's other body states (engine/anim/states.ts: run, hurt, pose, stance…). */\n  states?: AnimatorInput;\n  /** A blob's input (engine/anim/blob.ts: squash, look, squint, flap, hang, a move) and a jolt to its squash (per s). */\n  blob?: Omit<BlobInput, 'position'> & { kick?: number };\n  /** A floater's swell, 0 to 1. */\n  swell?: number;\n  /** A quadruped's: sitting, a world point it looks at, how hard it wags (0 to 1); `air` tucks its feet. */\n  quadruped?: { sit?: boolean; look?: Vec3Like | null; wag?: number };\n}\nimport { groupBits } from './groups';\nimport { check, vec, type Vec3Like } from './queries';\nimport { rapierOf, type Physics } from './world';\n\n/**\n * The crowd's material: the prototype's density (1 a cubic unit: a walker weighs about 50 kg), no friction under the\n * min rule (an agent slides on everything), no bounce; a corpse's friction, averaged, so it slides to a stop.\n */\nexport const CROWD_MATERIAL = Object.freeze({\n  /** kg/m³. */\n  density: 115,\n  friction: 0,\n  restitution: 0,\n  /** A corpse's friction (the average with what it lies on). */\n  corpseFriction: 0.9,\n  /** How hard a grounded corpse brakes (m/s²): the prototype's 300 units/s². */\n  corpseBrake: 18.75,\n});\n\n/** The grounded heuristic's thresholds (m/s, m): the prototype's 6 units/s, 2 units and 1 unit/s. */\nexport const CROWD_GROUNDED = Object.freeze({ speed: 0.375, height: 0.125, settle: 0.0625 });\n\n/** What `updateCrowd` does at most each step by default: bodies added (shardfall's load ramps), corpses kept. */\nexport const CROWD_LIMITS = Object.freeze({ spawnLimit: 25, corpseCap: 300 });\n\n/** Below this speed (m/s), a wish does not wake a sleeping agent. */\nconst REST = 0.05;\n\n/** A crowd agent's fields, for a scene's component: `defineComponent('pusher', { description, fields: … })`. */\nexport const CROWD_AGENT_FIELDS = defineSchema({\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body; −1 while queued or gone.' },\n  state: {\n    type: 'string',\n    enum: ['queued', 'alive', 'corpse', 'leaving', 'gone'],\n    default: 'queued',\n    description: 'queued (waits for its body), alive, corpse, leaving (to be removed), gone (removed).',\n  },\n  shape: { type: 'string', enum: ['capsule', 'ball'], default: 'capsule', description: 'Its collider.' },\n  radius: { type: 'number', default: 0.3125, minimum: 0.01, maximum: 100, unit: 'm', description: 'Its radius.' },\n  height: {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 100,\n    unit: 'm',\n    description: 'A capsule’s straight middle (CapsuleGeometry’s height): 1.625 m tall in all by default.',\n  },\n  flyer: { type: 'boolean', default: false, description: 'Flies: group flyer, no gravity, steered up and down too.' },\n  gravityScale: {\n    type: 'number',\n    default: 3,\n    minimum: 0,\n    maximum: 100,\n    description:\n      'How much of physics.gravity it feels: 3 is 29.4 m/s² at 9.81, the prototype’s 30, near characters’ 32.',\n  },\n  density: { type: 'number', default: 115, minimum: 0.001, unit: 'kg/m³', description: 'Its density.' },\n  acceleration: {\n    type: 'number',\n    default: 31.25,\n    minimum: 0,\n    unit: 'm/s²',\n    description: 'How fast setVelocity changes its velocity (the prototype’s 500 units/s²).',\n  },\n  corpseTime: { type: 'number', default: 1.6, minimum: 0, unit: 's', description: 'How long its corpse lies.' },\n  x: { type: 'number', default: 0, unit: 'm', description: 'Its feet (its lowest point), east.' },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Its feet, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Its feet, south.' },\n  vx: { type: 'number', default: 0, unit: 'm/s', description: 'Its velocity, east.' },\n  vy: { type: 'number', default: 0, unit: 'm/s', description: 'Its velocity, up.' },\n  vz: { type: 'number', default: 0, unit: 'm/s', description: 'Its velocity, south.' },\n  grounded: { type: 'boolean', default: false, description: 'On its feet after the last step (a flyer: always).' },\n  dead: { type: 'integer', default: 0, minimum: 0, description: 'Steps since it died, as a corpse.' },\n});\n\n/** Where an agent is in its life: see `CROWD_AGENT_FIELDS.state`. */\nexport type AgentState = 'queued' | 'alive' | 'corpse' | 'leaving' | 'gone';\n\n/** A crowd agent: its body, its make and what the last readback saw (`CROWD_AGENT_FIELDS` says what each means). */\nexport interface CrowdAgent {\n  body: number;\n  state: AgentState;\n  shape: 'capsule' | 'ball';\n  radius: number;\n  height: number;\n  flyer: boolean;\n99:  crowdBody: CrowdBody;\n192:  for (const { id, crowdMember: a, crowdBody: body, crowdWalker, crowdSlime } of w.query('crowdMember', 'crowdBody')) {\n} as const);\n\n/** A member's crowd agent (engine/physics/crowd.ts): its body, its make and what the last readback saw. */\nexport const CROWD_MEMBER = defineComponent('crowdMember', {\n  description: 'A member of the box’s crowd: its crowd agent (CROWD_AGENT_FIELDS); its kind is its other component.',\n  fields: CROWD_AGENT_FIELDS,\n});\n\n/** The scene's components. */\nexport type CrowdComponents = {\n  crowdMember: CrowdAgent;\n  crowdBody: CrowdBody;\n  crowdWalker: WalkerData;\n  crowdSlime: SlimeData;\n  crowdWisp: WispData;\n};\n\n/**\n * The crowd's walkable grid: the hall under a climb of 6 cm, what a crowd body manages (Rapier 0.21 steps a capsule\n * up 7 cm and a ball 8.5 cm, measured in WP 5.2), so the stairs' gentle rise is walkable and their sides are not.\n */\nexport const CROWD_GRID = new NavGrid(HALL_LEVEL, { climb: 0.06 });\n\n/** The tiles a member may start on: the hall's open floor, at height 0 (no dais, stairs or gallery). */\nexport const CROWD_TILES: readonly number[] = [...CROWD_GRID.open.keys()].filter(\n  (i) => CROWD_GRID.open[i] && HALL_LEVEL.floor[i] === 0,\n);\n\n/** Where members start: at least `away` m from the hero (the prototype's 80 units), `tries` draws, `jitter` in a tile. */\nexport const SPAWN = Object.freeze({ away: 5, tries: 40, jitter: 0.3 });\n\n/** The floor's height under (x, z), m. */\nconst floor = (x: number, z: number) => floorHeight(HALL_LEVEL, x, z);\n  blob?: Omit<BlobInput, 'position'> & { kick?: number };\n  /** A floater's swell, 0 to 1. */\n  swell?: number;\n  /** A quadruped's: sitting, a world point it looks at, how hard it wags (0 to 1); `air` tucks its feet. */\n  quadruped?: { sit?: boolean; look?: Vec3Like | null; wag?: number };\n}\n\n/** A world's rigs: loaded from the components at every step, so they keep no state of their own. */\ninterface Rigs {\n  animators: AnimatorPool;\n  blobs: Map<number, Blob>;\n  floater: Floater;\n  quadruped: Quadruped;\n  ground: GaitProbe | null;\n  pruned: number;\n}\nconst pools = new WeakMap<World, Rigs>();\nconst [at, velocity, look, seen] = [new Vector3(), new Vector3(), new Vector3(), new Vector3()];\n\n/** The rigs of `w`; the animators of despawned entities forgotten once a step. */\nfunction rigsOf(w: World): Rigs {\n  let rigs = pools.get(w);\n  if (!rigs)\n    pools.set(\n      w,\n      (rigs = { animators: new AnimatorPool(), blobs: new Map(), floater: new Floater({ dt: w.dt }), quadruped: new Quadruped({ dt: w.dt }), ground: null, pruned: -1 }), // prettier-ignore\n    );\n  if (rigs.pruned !== w.tick) {\n    rigs.animators.prune((id) => w.has(id));\n    rigs.pruned = w.tick;\n  }\n  return rigs;\n}\n\n/** `value` as a point, into `out`; throws `CORE_BAD_SPEC` naming `what` unless it is three finite numbers. */\nfunction pointOf(value: Vec3Like | undefined, what: string, where: string, out: Vector3): Vector3 {\n  if (value === undefined) return out.set(0, 0, 0);\n  const p = value as Partial<{ x: number; y: number; z: number }>;\n  const [x, y, z] = Array.isArray(value) ? (value as readonly number[]) : [p?.x, p?.y, p?.z];\n  if ([x, y, z].every(Number.isFinite)) return out.set(x!, y!, z!);\n  const problems = `${what} is ${JSON.stringify(value)}: give three finite numbers, [x, y, z] or { x, y, z } in metres`;\n  throw codeError('CORE_BAD_SPEC', { where, problems });\n}\n\n/** A humanoid's animator data at rest, in its build (`look`). */\nfunction restingAnimator(body: CrowdBody): AnimatorData {\n  const data = copyValue(\n    Object.fromEntries(Object.entries(ANIMATOR_FIELDS).map(([key, field]) => [key, field.default])),\n  ) as unknown as AnimatorData;\n  data.build = body.look || 'build:chibi';\n  return data;\n}\n\n/**\n * The rig's sim step for the crowd body `body` of entity `id` (see the file comment): loads it from `body.state`\n * (filling an empty one with the rig at rest), steps it with `input`, saves it back and moves the body to `input.at`.\n * Throws `CORE_BAD_SPEC` for an entity that does not live, or a point or velocity that is not three finite numbers.\n */\nexport function stepCrowdBody<C extends object>(\n  world: World<C>,\n  id: number,\n  body: CrowdBody,\n  input: CrowdBodyInput,\n): void {\n  const w = world as unknown as World;\n  const where = `stepCrowdBody(w, ${id})`;\n  if (!w.has(id)) {\n    throw codeError('CORE_BAD_SPEC', { where, problems: `entity ${id} does not live: give the id of a live entity` });\n  }\n  pointOf(input.at ?? [Number.NaN, 0, 0], 'input.at', where, at);\n  pointOf(input.velocity, 'input.velocity', where, velocity);\n  const rigs = rigsOf(w);\n  const empty = Object.keys(body.state).length === 0;\n  if (body.rig === 'humanoid') {\n    if (empty) body.state = restingAnimator(body) as unknown as Record<string, unknown>;\n    const data = body.state as unknown as AnimatorData;\n    const rng = w.rng.entity(id, 'anim');\nengine/anim/humanoid.ts:5: * in order) and the solve stage (authoring.ts: the spine from lean and twist, the arms and legs through `twoBoneRot`\nengine/anim/humanoid.ts:91:  dash?: boolean;\nengine/anim/humanoid.ts:93:  hurt?: boolean;\nengine/anim/humanoid.ts:95:  air?: boolean;\nengine/anim/humanoid.ts:97:  climb?: boolean;\nengine/anim/humanoid.ts:99:  point?: boolean;\nengine/anim/humanoid.ts:174:   * slide, air, landing and lean, which the view eases (locomotion/motion.ts) and sets before each pose. Presentation\nengine/anim/humanoid.ts:206:      body: { lunge: 0, hop: 0, crouch: 0, lean: 0, twist: 0 },\nengine/anim/humanoid.ts:235:    const ease = (now: number, on: boolean | undefined, [up, down]: readonly [number, number]) =>\nengine/anim/humanoid.ts:265:    for (const channel of ['lunge', 'hop', 'crouch', 'lean', 'twist'] as const) {\nengine/anim/humanoid.ts:291:  stance(): [boolean, boolean] | null {\nengine/anim/character.ts:91:  preciseHits: { type: 'boolean', default: false, description: 'Posed in the sim every tick, so weapon sweeps hit.' },\nengine/anim/character.ts:92:  started: { type: 'boolean', default: false, description: 'Whether its breathing phase was drawn from its stream.' },\nengine/anim/character.ts:102:  preciseHits: boolean;\n","exit_code":0,"status":"completed"}}
