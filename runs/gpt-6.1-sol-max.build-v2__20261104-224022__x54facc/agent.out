{"type":"item.completed","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -lc \"sed -n '322,360p' labs/game/app.ts; sed -n '67,83p' labs/game/ui/hud.ts; tail -36 labs/game/scenes/flow.ts; tail -25 labs/game/bodies/retreat.ts; rg -n 'screen-footer|font-size' labs/game/ui/theme.css | tail -10; sha256sum labs/game/hub/session-client.txt\"","aggregated_output":"    }\n    if (f.mode === 'event' && f.event.id === 'tilt' && f.event.phase < 4)\n      frame.emit('emitter:rain', [f.feet[0], f.feet[1] + 10, f.feet[2]], 'retreat-rain', 2);\n    if (performance.now() - this.lastHud > 60 && !this.ui.choices.length && this.ui.screen !== 'hub') {\n      this.lastHud = performance.now();\n      const get = (key: string) => Number(frame.setting(`game.${key}`));\n      const config = {\n        wobble: { ...DEFAULT_WOBBLE, period: get('breath.period') },\n        get,\n        auto: false,\n        day: f.day,\n        expert: f.expert,\n      };\n      const overlay = this.overlay\n        ? `<div class=\"state-overlay\">CoB ${f.wobble.x.toFixed(2)}, ${f.wobble.y.toFixed(2)} · calm ${f.wobble.calm.toFixed(2)}<br>${safe(f.event.id)} / ${f.event.phase} / ${f.event.tick}<br>tilt ${f.event.tilt.toFixed(2)}° · ${this.engine.inspector?.hash()}</div>`\n        : '';\n      this.ui.hud.innerHTML = renderHud(f, config, this.ui.device, this.options.xbox, overlay);\n    }\n  }\n  private uiLoop = (now: number): void => {\n    const dt = Math.min(0.1, (now - this.lastTime) / 1000);\n    this.lastTime = now;\n    this.ui.updatePad(dt);\n    if (\n      !this.hubActive &&\n      this.engine?.ready &&\n      ['title', 'settings', 'about', 'group', 'arrival'].includes(this.ui.screen) &&\n      !this.attract &&\n      now - this.ui.lastInput >= 10000\n    ) {\n      this.attract = true;\n      this.returnScreen = this.ui.screen;\n      this.returnPage = this.page;\n      this.run('game.demo');\n      this.ui.clear('attract');\n      this.engine.inspector?.resume();\n    }\n    const banner = this.attract\n      ? `<div class=\"demo-pill\">Wobble Fit <b>DEMO</b> ${glyph('accept', this.ui.device, this.options.xbox)} Press any button</div>`\n    f.demo = true;\n    startEvent(w, 'pose');\n  },\n  'game.day': (w: W, args: unknown) => {\n    const f = flowOf(w);\n    f.day = Math.max(1, Math.min(5, Number((args as { day: number }).day)));\n    f.done = [];\n    f.mode = 'roam';\n    f.serial++;\n  },\n  'game.pebbles': (w: W) => {\n    const f = flowOf(w);\n    f.pebbles += 20;\n    f.serial++;\n  },\n  'game.look': (w: W, args: unknown) => {\n    const f = flowOf(w);\n    const data = args as { look?: number; colour?: number };\n    if (data.look !== undefined) f.look = data.look;\n    if (data.colour !== undefined) f.colour = data.colour;\n    f.serial++;\n  },\n  'game.finale': (w: W, args: unknown) => {\n    startEvent(w, 'tilt');\n    flowOf(w).event.tick = Number((args as { tick: number }).tick ?? 0);\n  },\n  'round.go': (w: W) => startEvent(w, 'group'),\n  'round.ghosts': (w: W, args: unknown) => {\n    const f = flowOf(w),\n      list = args as { seat: number; x: number; y: number; phase: number; active: boolean }[];\n    for (const g of list) {\n      const id = f.others[g.seat - 1];\n      if (id) w.add(id, 'ghost', g);\n    }\n  },\n};\n  ['limb', ['off', 'thighL', 0.075, 0.075, -0.04], ['off', 'shinL', 0.055, 0.055, 0], 0.009, 0.009, 'white'],\n];\nexport const COLORS = ['#e89172', '#5ba698', '#8996c9', '#d8b462', '#6d9dba'];\nfor (let i = 0; i < COLORS.length; i++)\n  defineBody(`body:guest${i}`, {\n    description: 'A guest in a zipped retreat tracksuit.',\n    slots: {\n      suit: COLORS[i],\n      white: '#fffaf0',\n      skin: ['#e8b997', '#ac7758', '#f3d3b4'][i % 3],\n      hair: ['#49382d', '#272e30', '#c6b398'][i % 3],\n      eye: '#2c443d',\n    },\n    parts,\n    mirror,\n  });\ndefineBody('body:plumb', {\n  description: 'Instructor Plumb, perfectly vertical, with a long untroubled plait.',\n  slots: { suit: '#bddbc6', white: '#f8fcf2', skin: '#d3ae8b', hair: '#3f5143', eye: '#3f5143' },\n  parts: [\n    ...parts,\n    ['limb', ['off', 'head', -0.14, 0, 0.2], ['off', 'head', -0.18, 0, -0.65], 0.04, 0.018, 'hair', { on: 'head' }],\n  ],\n  mirror,\n});\n1451:    font-size: 2.1vh;\n1455:    font-size: 2vh;\n1468:    font-size: 2vh;\n1473:    font-size: 1.8vh;\n1480:    font-size: 1.7vh;\n1487:    font-size: 2.8vh;\n1490:    font-size: 2.2vh;\n1493:    font-size: 2vh;\n1503:    font-size: 2.1vh;\n1506:    font-size: 2.2vh;\n6ab6be43898e2db069bc21a94757d77d9c3f2a0cb76f01186490d3bd88d8717a  labs/game/hub/session-client.txt\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"head -8 labs/game/hub/session-client.txt; tail -3 labs/game/hub/session-client.txt; sed -n '358,370p' labs/game/app.ts; rg -n 'const l|rr =' labs/game/ui/hud.ts; rg -n \\\"client|SHA|sha|529|slice\\\" .cache/hub/harness.html | head -35; sed -n '120,168p' .cache/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"head -8 labs/game/hub/session-client.txt; tail -3 labs/game/hub/session-client.txt; sed -n '358,370p' labs/game/app.ts; rg -n 'const l|rr =' labs/game/ui/hud.ts; rg -n \\\"client|SHA|sha|529|slice\\\" .cache/hub/harness.html | head -35; sed -n '120,168p' .cache/hub/harness.html\"","aggregated_output":"/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n    }\n    const banner = this.attract\n      ? `<div class=\"demo-pill\">Wobble Fit <b>DEMO</b> ${glyph('accept', this.ui.device, this.options.xbox)} Press any button</div>`\n      : '';\n    if(this.ui.banner.innerHTML!==banner)this.ui.banner.innerHTML=banner;\n    if (this.engine && this.flow?.mode === 'event' && !this.ui.choices.length) {\n      this.engine.input?.virtual.axis('game:mouse', this.mouse);\n      if (this.flow.event.id !== 'garden') this.mouse = this.mouse.map((v) => v * Math.exp(-dt / 0.6));\n      if (this.flow.event.id === 'group') {\n        const values = Array.from({ length: 20 }, () => 0),\n          pads = navigator.getGamepads?.() ?? [];\n        for (let i = 0; i < 4; i++) {\n          const p = pads[i];\n30:    const left = 20 + i * 16 - ((r.tick % 32) / 32) * 16;\n43:  const l = input?.l ?? r.inputs[0]?.l ?? 0,\n44:    rr = input?.r ?? r.inputs[0]?.r ?? 0;\n48:    const lure = LURES[Math.floor(r.tick / 480) % LURES.length];\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n113: * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n474:      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n500:      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n521:    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n","exit_code":0,"status":"completed"}}
