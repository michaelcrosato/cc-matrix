{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"tail -95 engine/sim-api.ts; cat engine/world/api.ts 2>/dev/null | head -65; sed -n '195,220p' engine/index.ts; cat engine/anim/api.ts | rg 'defineBuild|defineClipSet'\"","aggregated_output":"export { SpatialHash } from './world/spatial';\nexport { SPATIAL_HASH_FIELDS } from './world/spatial';\nexport type { SpatialHashOptions } from './world/spatial';\n\n// Bodies and props (WP 4.1): props of one shape in the prototype's material, torque impulses and the knock; movers,\n// kinematic bodies whose pose is a function of time, carrying riders; sensors and triggers; the lost-body rescue.\nexport { PROP_MATERIAL } from './physics/bodies';\nexport type { PropSpec } from './physics/bodies';\nexport { addProp } from './physics/bodies';\nexport { addBox } from './physics/bodies';\nexport { addBall } from './physics/bodies';\nexport { addCapsule } from './physics/bodies';\nexport { addCylinder } from './physics/bodies';\nexport { applyTorqueImpulse } from './physics/bodies';\nexport { knock } from './physics/bodies';\nexport type { KnockOptions } from './physics/bodies';\nexport { MOVER_FIELDS } from './physics/bodies';\nexport { MOVER } from './physics/bodies';\nexport type { Mover } from './physics/bodies';\nexport { moverPose } from './physics/bodies';\nexport { driveBody } from './physics/bodies';\nexport { driveMover } from './physics/bodies';\nexport { addSensor } from './physics/bodies';\nexport type { SensorSpec } from './physics/bodies';\nexport { sensorHits } from './physics/bodies';\nexport { TRIGGER_FIELDS } from './physics/bodies';\nexport type { Trigger } from './physics/bodies';\nexport { updateTrigger } from './physics/bodies';\nexport { rescueLost } from './physics/rescue';\nexport type { RescueLevel } from './physics/rescue';\n// Props as data (WP 4.5): the registry kind `prop` (meshes by geometry and material id, a body, a light spot, where a\n// level places it, the hit and use hooks), the engine's crate, barrel, brazier fire and pillar, the library's sconce,\n// banner, chest, door, table, bench, statue and lantern (WP 10.3), and their placement.\nexport { defineProp } from './world/props/prop';\nexport { getProp } from './world/props/prop';\nexport { propCentre } from './world/props/prop';\nexport type { Prop } from './world/props/prop';\nexport type { PropDefinition } from './world/props/prop';\nexport type { PropPart } from './world/props/prop';\nexport type { PropTouch } from './world/props/prop';\nexport type { PropKnock } from './world/props/prop';\nexport { levelProps } from './world/props/place';\nexport { propBody } from './world/props/place';\nexport { propPose } from './world/props/place';\nexport type { PropPlacement } from './world/props/place';\nexport type { PropBody } from './world/props/place';\nexport type { PropPose } from './world/props/place';\n// Props in a scene (WP 4.6): spawnProp stands a prop in a running scene (its body, and an entity with the component\n// sceneProp whose pose is read back after each step, which the view draws as the prop); hitProp calls its hit hook\n// with the means to knock it; removeProp.\nexport { spawnProp } from './sim/props';\nexport { removeProp } from './sim/props';\nexport { hitProp } from './sim/props';\nexport { SCENE_PROP_FIELDS } from './sim/props';\nexport type { ScenePropComponent } from './sim/props';\nexport type { ScenePropComponents } from './sim/props';\n\n// Crowds and combat (WPs 5.1 to 6.4): crowd bodies, the steering kit, crowd members' looks, telegraphs and the\n// combat helpers; listed in engine/sim/combatApi.ts, re-exported whole so this file stays under its line cap.\nexport * from './sim/combatApi';\n\n// Clips on actors (WP 8.9): the clip layer in an actor's animator as sim data, the component clips, stepped at the\n// actor's ground speed and drawn over its body by the view; its events come as `clip`. spawnActor's `body` names the\n// body it is drawn as (body:mannequin).\nexport { addClips } from './sim/actorClips';\nexport type { ClipsSpec } from './sim/actorClips';\nexport { playClip } from './sim/actorClips';\nexport { stopClip } from './sim/actorClips';\nexport { seekClip } from './sim/actorClips';\nexport { locomoteClips } from './sim/actorClips';\nexport { clipLayerOf } from './sim/actorClips';\nexport type { PuppetComponent } from './sim/actors';\n\n// Movement (Phase 13): movement profiles and the shooter model, its live tuning and placing (the feel kit), and the\n// rides; listed in engine/sim/movementApi.ts, re-exported whole so this file stays under its line cap.\nexport * from './sim/movementApi';\n\n// Storeys and sites (Phase 13): levels written as storeys and their 3D queries, terrain, its queries, its body and\n// its navigation; listed in engine/sim/siteApi.ts, re-exported whole so this file stays under its line cap.\nexport * from './sim/siteApi';\n\n// The house (Phase 13): using things, carrying and throwing, doors, windows and breakables, switches; listed in\n// engine/sim/houseApi.ts, re-exported whole so this file stays under its line cap.\nexport * from './sim/houseApi';\n// Gameplay kits (WP 10.4): things, projectile patterns, awareness; listed in engine/sim/kitsApi.ts, re-exported whole.\nexport * from './sim/kitsApi';\n// Procedural rigs (WP 10.1): the blocks a creature is built of and the rig contract it is checked by; listed in\n// engine/anim/proc/api.ts, re-exported whole.\nexport * from './anim/proc/api';\n// Footsteps (WP 13.22): which step a surface tag plays at a gait, sound data a scene's sound map reads sim-side.\nexport { footstepSound } from './world/footsteps';\nexport { stepGait } from './world/footsteps';\nexport { SURFACE_STEPS } from './world/footsteps';\nexport { STEP_GAITS } from './world/footsteps';\nexport type { StepGait } from './world/footsteps';\nexport type { Menu, MenuItem, MenuOptions, MenuPlace } from './ui/menu';\n// The store (WP 10.9): what a game keeps across sessions (high scores, progress, its settings) in the page's\n// localStorage under the game's prefix, versioned and checked on load; memory in Node and in the isolated modes.\nexport { createStore } from './app/store';\nexport { memoryBackend } from './app/store';\nexport type { Store, StoreOptions, StoreBackend, StoreMode } from './app/store';\n// Lights, shadows, atmosphere and sky (WP 7.1): light kinds for a level's light spots, a fixed pool of point lights\n// near the focus with a shadow budget by quality tier, and sky presets (background, dome, backdrop, sun, ambient\n// light, fog) that a sky puts on a scene.\nexport { defineLight } from './gfx/lights';\nexport type { LightEntry } from './gfx/lights';\nexport type { LightSource } from './gfx/lights';\nexport { defineSky } from './gfx/sky';\nexport type { SkyEntry } from './gfx/sky';\nexport type { SkySpec } from './gfx/sky';\nexport { createSky } from './gfx/sky';\nexport type { Sky } from './gfx/sky';\n// Materials v2 (WP 7.2): the same material data drawn in four styles (lambert, toon, flat, pbr), switched at run time\n// with every style warmed; the toon look (bands and rim) as uniforms; outline shells for meshes and instanced batches.\nexport { createStyleSet } from './gfx/materials/styles';\nexport { MATERIAL_STYLES } from './gfx/materials/styles';\nexport type { MaterialStyle } from './gfx/materials/styles';\nexport type { StyleSet } from './gfx/materials/styles';\nexport type { StyleSetOptions } from './gfx/materials/styles';\nexport { TOON_LOOK } from './gfx/materials/toon';\nexport type { ToonLook } from './gfx/materials/toon';\nexport { defineBuild } from './builds';\n// registers from data/anim/sets/ (defineClipSet), and the clip layer of an entity kept as plain data, loaded from it\nexport { defineClipSet } from './clip/clipsets';\n","exit_code":0,"status":"completed"}}
