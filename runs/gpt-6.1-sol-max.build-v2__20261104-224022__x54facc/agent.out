dow.__engine` has\n * (`step`, `hash`, `state`, `set`…; `help()` lists them all), minus a renderer. With `view: true` it also builds the\n * scene's view, for `scene.dump()` and `camera`. Throws `CORE_NO_ENTRY` for an unknown scene id, `CORE_BAD_SETTING`\n * for a bad setting, `SIM_BAD_SEED` for a seed a replay cannot hold, and with a view `APP_NO_LEVEL` for a level not\n * registered.\n */\nexport async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  options: HeadlessOptions<C, E>,\n): Promise<Headless> {\n  return createAppHost(options).inspector;\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/audio/sound.test.ts <<'EOF'\n/** @file Every original song, effect and gibberish syllable has finite non-silent PCM, without recordings. */\nimport {it,expect} from 'vitest';\nimport {renderSfx,renderSong} from '../../../engine';\nimport {SONG_IDS,EFFECTS} from './sound';\nimport {VOICE_IDS} from './voice';\nit('renders every sound and all five syllable banks without silence or invalid samples',()=>{\n for(const id of [...VOICE_IDS,...EFFECTS.map(name=>\"'`sfx:retreat.${name}`)]){\n  const pcm=renderSfx(id,{rate:16000});let peak=0;\n  for(const value of pcm){expect(Number.isFinite(value),id).toBe(true);peak=Math.max(peak,Math.abs(value));}\n  expect(peak,id).toBeGreaterThan(.0001);\n }\n for(const id of SONG_IDS){const pcm=renderSong(id,{rate:16000});let peak=0;for(const value of pcm){expect(Number.isFinite(value),id).toBe(true);peak=Math.max(peak,Math.abs(value));}expect(peak,id).toBeGreaterThan(.001);}\n});\nEOF\ncat > labs/game/tools/record-replays.ts <<'\"'EOF'\n/** @file Records initial goldens for the finished original activity rules and one entire day. */\nimport {writeFileSync} from 'node:fs';\nimport {createHeadless} from '../../../engine';\nimport {island} from '../scenes/island';\nimport {ACTIVITIES} from '../scenes/data/days';\nimport type {GameInspector} from '../ui/context';\ntype Recorder=GameInspector & {input:{record:()=>Record<string,unknown>}};\nfor(const event of ACTIVITIES){\n const h=await createHeadless({scene:island,seed:11,settings:{'game.auto':true}}) as Recorder;\n const zero=h.hash();h.actions.run('game.start',{event:event.id});h.step(300);\n const replay={...h.input.record(),description:\"'`Original ${event.title} rules, 5 seconds of the same balance pilot.`,hashes:{'\"'linux-x64':{'0':zero,'300':h.hash()}}};\n writeFileSync(\"'`labs/game/replays/${event.id}.replay.json`,JSON.stringify(replay,null,2)+'\"'\\\\n');\n}\nconst h=await createHeadless({scene:island,seed:23,settings:{'game.auto':true,'game.pace':8}}) as Recorder;\nconst hashes:Record<string,string>={'0':h.hash()};h.actions.run('game.begin');h.step(1200);hashes['1200']=h.hash();h.step(1400);hashes['2600']=h.hash();\nwriteFileSync('labs/game/replays/day.replay.json',JSON.stringify({...h.input.record(),description:'Day one: the check, every pose, Still Pond, sleep, and the next morning. Accelerated pilot; initial original-content golden.',hashes:{'linux-x64':hashes}},null,2)+'\\\\n');\nconsole.log('Recorded 14 original-content replays.');\nEOF\nnode --import tsx labs/game/tools/record-replays.ts\nCHROMIUM_PATH=/home/micha/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell timeout 180 node x replay labs/game/replays --browser sim --runs 2 > out/game/replays.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
