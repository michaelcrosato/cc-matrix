{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"rg -n 'invert|mouse' engine/input/settings.ts engine/core/*settings* engine/input/*.ts | head -35; sed -n '1,105p' labs/game/scenes/events/motion.ts; head -35 labs/game/scenes/events/tilt.ts; sed -n '85,125p' engine/sim/state.ts; rg -n 'interface TraceRecord|type TraceRecord' engine/core/events.ts\"","aggregated_output":"rg: engine/input/settings.ts: No such file or directory (os error 2)\nengine/input/look.ts:4: * frame's mouse counts and right stick into what the camera takes (engine/input/input.ts `camera()`).\nengine/input/look.ts:6: * The mouse turns the view `input.sensitivity` × 0.022° a count (`DEGREES_PER_COUNT`, Source's and Apex's `m_yaw`:\nengine/input/look.ts:9: * (`input.stickAdsSensitivity` aiming). Pushing the mouse away or the stick forward looks up; `input.invert` and\nengine/input/look.ts:18: * scaleLook({ counts: [0, 10], stick: [0, -1] }, { ...options, invert: true }, false); // look down, the stick up\nengine/input/look.ts:24:/** One mouse count at sensitivity 1, degrees: Source's and Apex's `m_yaw` and `m_pitch`. */\nengine/input/look.ts:43:    description: 'Times the mouse look while aiming down sights (the action aim held), as Apex’s ADS multiplier. A view setting: never in the hash.', // prettier-ignore\nengine/input/look.ts:45:  'input.invert': {\nengine/input/look.ts:49:    description: 'Mouse look upside down (flight style): pushing the mouse away looks down. A view setting: never in the hash.', // prettier-ignore\nengine/input/look.ts:82:  readonly invert: boolean;\nengine/input/look.ts:94:    invert: read('input.invert'),\nengine/input/look.ts:101:/** A frame's raw look: mouse counts `[right, up]` (up for a push away) and the right stick `[x, y]` (y down). */\nengine/input/look.ts:120:    look: [right * perCount, (options.invert ? 0 - up : up) * perCount], // 0 − v, never −0\nengine/input/input.ts:2: * @file The input (PLAN.md §6.4, WP 3.3, I-24; doctrine: Reproducible): the devices of a page (keyboard, mouse,\nengine/input/input.ts:15: * its poll, the virtual device's at the sample). `camera()` gives what the camera takes each frame (mouse look under\nengine/input/input.ts:49:import { attachMouse, type MouseDevice, type MouseTargets } from './devices/mouse';\nengine/input/input.ts:73:  /** The game's element, the canvas: mouse presses, wheel and pointer lock (`document.body`). */\nengine/input/input.ts:95:/** What the camera takes each frame: mouse look `[right, up]` rad, the right stick `[right, up]`, wheel notches. */\nengine/input/input.ts:112:  /** The mouse (pointer lock, pointer), when there is a page. */\nengine/input/input.ts:113:  readonly mouse: MouseDevice | undefined;\nengine/input/input.ts:133:  /** What the camera takes since the last call (mouse look, right stick, wheel); then zero. */\nengine/input/input.ts:243:  const mouse =\nengine/input/input.ts:255:    mouse?.clear();\nengine/input/input.ts:268:    const pointer = mouse?.pointer();\nengine/input/input.ts:291:    mouse,\nengine/input/input.ts:367:      const raw = { counts: mouse?.takeLook() ?? [0, 0], stick } as const;\nengine/input/input.ts:369:      return { look, turn, zoom: mouse?.takeZoom() ?? 0 };\nengine/input/input.ts:372:      const device = last === 'gamepad' || last === 'mouse' ? last : 'keyboard';\nengine/input/input.ts:383:      mouse?.detach();\nengine/input/codes.ts:4: * the layout, so WASD stays under the left hand on AZERTY; mouse buttons and the wheel are `MouseLeft`, `MouseRight`,\nengine/input/codes.ts:16: * Held bindings (WP 13.20, Apex's pad: X held reloads, Y held holsters): `Hold:<code>` (`holdCode`) is a key, mouse\nengine/input/codes.ts:20: * Invariants: `isCode` accepts exactly the codes above, touch codes aside; `deviceOf` is `gamepad` for `Pad…`, `mouse`\nengine/input/codes.ts:38:export type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\nengine/input/codes.ts:42:  /** A digital code went down (a key, a mouse button, a wheel notch): pressed at the next sample, even if up by then. */\nengine/input/codes.ts:48:  /** The device was used without a press (a stick pushed, the mouse moved): prompts follow it. */\nengine/input/codes.ts:119:/** The digital codes a held binding may wait on: keys, mouse buttons and pad buttons, never a notch or a stick. */\n/** @file Foot-driven water sports, direct-control reps, rhythm, hoops, dives and the coast jog. */\nimport { BPMS, CHARTS } from '../data/charts';\nimport { balanceBot, clamp, emptyLean } from '../wobble';\nimport type { Lean, Wobble } from '../wobble';\nimport type { ActivityRun, EventConfig, Guide } from './types';\nexport function motionGuide(r: ActivityRun, c: EventConfig): Guide {\n  const t = r.tick / 60;\n  if (r.id === 'reps') {\n    const phase = Math.min(2, Math.floor(t / 30));\n    const v = .5 - .5 * Math.cos(t * Math.PI * 2 / c.get('reps.tempo'));\n    return { x: phase === 2 ? Math.sin(t * Math.PI * 2 / c.get('reps.tempo')) * .75 : 0, y: phase === 2 ? 0 : -v * .8, ring: .2, title: ['Deep Knees', 'Polite Push-Ups', 'Side Lunges'][phase], instruction: `${r.count} repetitions · Follow the mint band. Four more. I may be lying.`, pose: ['DeepKnee', 'Pushup', 'SideLunge'][phase], foot: phase === 1 ? 3 : 0 };\n  }\n  if (r.id === 'line') return { x: 0, y: 0, ring: .28, title: `${Math.min(40, r.progress).toFixed(1)} / 40 m`, instruction: Math.floor(t) % 8 >= 6 ? 'A gust is coming. The flag is trying to tell you.' : r.progress > 15 && r.progress < 20 ? 'The gull is a guest too. A fast lean shakes it off.' : 'Left foot. Right foot. Keep the dot centred.', pose: 'Line', foot: 0 };\n  if (r.id === 'paddle') return { x: Math.sin((r.gate + 1) * 1.7 + r.seed) * .5, y: .35, ring: .3, title: `Gate ${Math.min(12, r.gate + 1)} / 12`, instruction: r.gate === 6 ? 'Ferry wake ahead. It has right of way.' : r.gate === 8 ? 'A turtle is considering the crossing.' : 'Steer into the mint channel. Alternate feet to paddle.', pose: 'Paddle', foot: 0 };\n  if (r.id === 'step') return { x: 0, y: 0, ring: .3, title: `${Math.round(BPMS[Math.min(2, Math.floor(t / 33.4))] * c.get('step.bpm'))} BPM`, instruction: `${r.combo} in a row · Q / left foot · E / right foot · Both to jump`, pose: 'Step', foot: 0 };\n  if (r.id === 'hoop') return { x: Math.cos(t * 7) * .7, y: Math.sin(t * 7) * .7, ring: .3, title: `${r.count} hoops aloft`, instruction: 'Circle the stick. Or alternate feet. Keep a pleasantly undignified rhythm.', pose: 'HipCircle', foot: 0 };\n  if (r.id === 'dive') {\n    const phase = Math.floor(t % 18 / 6);\n    return { x: 0, y: 0, ring: .25, title: `Dive ${Math.min(3, Math.floor(t / 18) + 1)} / 3 · ${['Compose', 'Go', 'Air'][phase]}`, instruction: ['Hold both feet. Breathe. The sea can wait.', 'Release both feet at the top of the swinging gauge.', 'Lean to spin and twist. Return to vertical for entry.'][phase], pose: phase === 2 ? 'Somersault' : 'Lighthouse', foot: 0 };\n  }\n  return { x: Math.sin(t * .13) * .4, y: .3, ring: .28, title: 'The Pace Ribbon', instruction: 'Stay near Gerald. Alternate feet to find his pace.', pose: 'Jog', foot: 0 };\n}\nexport function rhythmNote(r: ActivityRun, c: EventConfig, tick = r.tick): { note: string; beat: number; delta: number } {\n  const part = Math.min(2, Math.floor(tick / 2004)), bpm = BPMS[part] * c.get('step.bpm');\n  const interval = 3600 / bpm;\n  const beat = Math.round(tick / interval), delta = tick - beat * interval;\n  const chart = CHARTS[part].split(' ');\n  return { note: chart[(beat % chart.length + chart.length) % chart.length], beat, delta };\n}\nexport function stepMotion(r: ActivityRun, w: Wobble, input: Lean, c: EventConfig): void {\n  if (r.id === 'reps') r.phase = Math.min(2, Math.floor(r.tick / 1800));\n  if (r.id === 'dive') r.phase = Math.floor((r.tick / 60) % 18 / 6);\n  const g = motionGuide(r, c), left = input.l > .5, right = input.r > .5;\n  const tapL = left && !r.lastL, tapR = right && !r.lastR;\n  const tap = tapL || tapR, foot = tapL ? 1 : 2;\n  const stable = Math.hypot(w.x - g.x, w.y - g.y) < g.ring;\n  const t = r.tick / 60;\n  if (r.id === 'reps') {\n    const depth = r.phase === 2 ? input.x : input.y;\n    const target = r.phase === 2 ? g.x : g.y;\n    const good = Math.abs(depth - target) < .2 && (g.foot !== 3 || left && right);\n    r.total += good ? 1 : 0; r.samples++;\n    r.count = Math.floor(t / c.get('reps.tempo'));\n    r.score = Math.round(r.total / r.samples * 1000);\n  } else if (r.id === 'step') {\n    const n = rhythmNote(r, c);\n    if (tap) {\n      const valid = n.note === 'B' ? left && right : n.note === 'L' ? tapL && !right : n.note === 'R' ? tapR && !left : false;\n      if (valid && Math.abs(n.delta) <= c.get('step.good') && r.lastTap !== n.beat) {\n        r.lastTap = n.beat; r.count++; r.combo++; r.bestCombo = Math.max(r.combo, r.bestCombo);\n        r.total += Math.abs(n.delta) <= c.get('step.perfect') ? 1 : .7;\n      } else { r.combo = 0; r.mistakes++; }\n    }\n    if (Math.abs(n.delta - c.get('step.good') - 1) < .6 && n.note !== '.' && r.lastTap !== n.beat) r.combo = 0;\n    r.samples = Math.max(1, Math.floor(t / (60 / 112) * .66));\n    r.score = Math.round(clamp(r.total / r.samples, 0, 1) * 1000);\n  } else if (r.id === 'line') {\n    if (tap && !(left && right)) {\n      if (r.lastFoot === foot) { r.mistakes++; w.vx += foot === 1 ? -.3 : .3; }\n      else { r.progress = Math.min(40, r.progress + .75); w.vx += (foot === 1 ? -1 : 1) * c.get('line.stepKick'); }\n      r.lastFoot = foot;\n    }\n    if (r.tick % 480 > 420) w.vx += Math.sin(r.seed + Math.floor(t / 8)) * c.get('line.gust') / 60;\n    if (r.progress > 15 && r.progress < 20) w.vx += .008;\n    r.score = Math.round(clamp((1000 - w.topples * 150 - Math.max(0, t - 50) * 8) * r.progress / 40, 0, 1000));\n  } else if (r.id === 'paddle') {\n    const steering = Math.abs(input.x - g.x) < .28;\n    const speed = Math.max(0, input.y) * c.get('paddle.speed') * (tap ? 1.3 : 1);\n    r.progress += speed / 60 * (steering ? 1 : .1);\n    r.gate = Math.min(12, Math.floor(r.progress / 8));\n    if ((r.gate === 7 || r.gate === 9) && r.tick % 60 === 0) w.vx += .8;\n    r.score = Math.round(clamp(r.gate * 60 + (r.gate >= 12 ? Math.max(0, 1 - t / 75) * 280 : 0) - w.topples * 30, 0, 1000));\n  } else if (r.id === 'hoop') {\n    const a = Math.atan2(input.y, input.x), da = Math.atan2(Math.sin(a - r.previousAngle), Math.cos(a - r.previousAngle));\n    const omega = Math.abs(da * 60);\n    if (tap && foot !== r.lastFoot) { r.hold = 24; r.lastFoot = foot; }\n    r.hold = Math.max(0, r.hold - 1);\n    const spinning = (omega >= c.get('hoop.bandMin') && omega <= c.get('hoop.bandMax') && Math.hypot(input.x, input.y) > .3) || r.hold > 0;\n    r.previousAngle = a; r.angle += da;\n    r.velocity = clamp(r.velocity + (spinning ? .02 : -.012), 0, 1);\n    r.count = Math.min(8, Math.max(0, Math.floor(t / 8) + 1 - Math.floor((1 - r.velocity) * 2)));\n    r.total += spinning ? 1 : 0; r.samples++;\n    r.score = Math.round(r.total / r.samples * 1000);\n  } else if (r.id === 'dive') {\n    const local = r.tick % 1080;\n    if (r.phase === 0) r.hold = clamp(r.hold + (stable && left && right ? .004 : -.001), 0, 1);\n    if (r.phase === 1 && !left && !right && (r.lastL || r.lastR) && r.offset === 0) r.offset = .5 + .5 * Math.sin(local / 25);\n    if (r.phase === 2) { r.angle += input.y * .07; r.velocity += input.x * .04; }\n    if (local === 1079) {\n      const vertical = 1 - Math.min(1, Math.abs(Math.sin(r.angle)) + Math.abs(Math.sin(r.velocity)));\n      const dive = clamp((r.hold * .4 + r.offset * .3 + vertical * .3) * 1000, 0, 1000);\n      r.scores.push(dive); r.score = Math.round(r.scores.reduce((a, b) => a + b, 0) / r.scores.length);\n      r.hold = 0; r.offset = 0; r.angle = 0; r.velocity = 0;\n    }\n  } else if (r.id === 'jog') {\n    const pace = Math.abs(input.x - g.x) < .4 && input.y > .1;\n    r.total += pace ? 1 : 0; r.samples++; r.progress += (pace ? 1 : .2) / 60;\n    r.score = Math.round(r.total / r.samples * 1000);\n  }\n  r.lastL = left; r.lastR = right;\n}\nexport function motionBot(r: ActivityRun, w: Wobble, c: EventConfig, kind: string): Lean {\n  if (kind === 'idle') return emptyLean();\n  const g = motionGuide(r, c), input = balanceBot(w, r.tick, c.wobble, [g.x, g.y], kind);\n  const error = kind === 'human' ? 3 : kind === 'sloppy' ? 6 : 0;\n/** @file The five finale movements: storm, guests, carts, centre stone and dawn. */\nimport { balanceBot, clamp, emptyLean } from '../wobble';\nimport type { ActivityRun, EventConfig, Guide } from './types';\nimport type { Lean, Wobble } from '../wobble';\nexport const TILT_STEPS = [0, 20, 95, 140, 200, 240];\nexport function tiltGuide(r: ActivityRun): Guide {\n  const t = r.tick / 60;\n  const found = TILT_STEPS.findIndex((end, i) => i > 0 && t < end) - 1;\n  const phase = found < 0 ? 4 : Math.min(4, found);\n  return { x: phase === 1 ? .35 : 0, y: 0, ring: phase === 3 ? .22 - .07 * ((t - 140) / 60) : .3,\n    title: ['The Storm', 'Everyone East', 'A small counterweight', 'The Centre Stone', 'Dawn'][phase],\n    instruction: ['The island is six degrees out of true. Calm is mandatory.', 'Hold both feet for a calm call. Release. Lead the guests east with your lean.', 'Alternate feet to crank. Lean against the slope.', 'Your dot is the island. Keep it in the ring. Breathe through the storm.', 'Everything is balanced now. Please do not tell anyone about the rock.'][phase],\n    pose: phase === 1 ? 'CalmCall' : phase === 2 ? 'Crank' : 'Lighthouse', foot: 0 };\n}\nexport function stepTilt(r: ActivityRun, w: Wobble, input: Lean, c: EventConfig): void {\n  r.phase = Math.max(0, Math.min(4, TILT_STEPS.findIndex((end, i) => i > 0 && r.tick / 60 < end) - 1));\n  const g = tiltGuide(r), both = input.l > .5 && input.r > .5;\n  if (r.phase === 0) r.tilt = 6 + r.tick / 1200 * 2;\n  if (r.phase === 1) {\n    if (both) r.hold++;\n    if (!both && r.lastL && r.lastR && r.hold >= 120) { r.count = Math.min(12 - r.guests, r.count + 3); r.hold = 0; }\n    if (r.count > 0 && input.x > .15) { r.progress += input.x / 60; if (r.progress >= 3) { r.guests += r.count; r.count = 0; r.progress = 0; } }\n    r.tilt = 8 - r.guests * .5;\n  }\n  if (r.phase === 2 && (input.l > .5 && !r.lastL || input.r > .5 && !r.lastR)) r.tilt = Math.max(2, r.tilt - .015);\n  if (r.phase === 3) {\n    r.total += Math.hypot(w.x, w.y) < g.ring ? 1 : 0; r.samples++; r.breath += w.sync;\n    r.tilt = Math.max(.1, 4 * (1 - (r.tick / 60 - 140) / 60) + Math.hypot(w.x, w.y) * 7);\n  }\n  if (r.phase === 4) r.tilt *= .99;\n  r.lastL = input.l > .5; r.lastR = input.r > .5;\n  r.score = Math.round(clamp((r.guests / 12 * .25 + (r.samples ? r.total / r.samples : 0) * .55 + (r.samples ? r.breath / r.samples : 0) * .2) * 1000, 0, 1000));\n}\nexport function tiltBot(r: ActivityRun, w: Wobble, c: EventConfig, kind: string): Lean {\n  if (kind === 'idle') return emptyLean();\n  state(): Canonical;\n  /** The physics part of a capture: Rapier's snapshot bytes and what else restoring needs. Never hashed. */\n  capture(): unknown;\n  /** Puts back what `capture()` returned, so the next step continues exactly. */\n  restore(data: unknown): void;\n}\n\n/** A component kind as `defineComponent` stores it in the registry. */\nexport interface ComponentKind<S extends Schema = Schema> {\n  readonly id: string;\n  readonly kind: 'component';\n  readonly description: string;\n  readonly fields: S;\n}\n\n/** The data type of a component of kind fields `S`, as `make` returns it: writable, defaults filled. */\nexport type ComponentOf<S extends Schema> = { -readonly [K in keyof EntryOf<S>]: EntryOf<S>[K] };\n\n/**\n * What the hash reads, live or stored: the ids, entities (in id order), timers, settings, RNG states and the physics\n * hook's state. `state()` returns one; the world hashes its live parts the same way.\n */\nexport interface StateView {\n  readonly seed: number;\n  readonly nextId: number;\n  /** The world's step rate, fixed when it is made. */\n  readonly hz: number;\n  readonly entities: readonly EntityData[];\n  readonly timers: TimersState;\n  readonly settings: Readonly<Record<string, SettingValue>>;\n  readonly rng: Readonly<Record<string, number>>;\n  readonly physics?: Canonical;\n}\n\n/** The sim as plain data: what `world.state()` returns and the hash covers. */\nexport interface WorldState extends StateView {\n  readonly entities: EntityData[];\n}\n\n/** Per-part and per-entity digests, so a mismatch names the part and the entity (PLAN.md §6.5 item 6). */\nexport interface WorldTrace {\n61:export interface TraceRecord {\n","exit_code":0,"status":"completed"}}
