{"type":"item.started","item":{"id":"item_129","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/app.ts');s=p.read_text().replace('requestAnimationFrame(this.uiLoop);', 'setInterval(()=>this.uiLoop(performance.now()),16);',1)\n# Only the constructor schedules the UI poll; render pause must not suspend pad menus.\ns=s.replace('    requestAnimationFrame(this.uiLoop);\\\\n','')\np.write_text(s)\np=Path('labs/game/scenes/state.ts');s=p.read_text().replace('  demo: boolean;', '  demo: boolean;\\\\n  demoStart:number;');p.write_text(s)\np=Path('labs/game/scenes/island.ts');s=p.read_text().replace('    demo: false,', '    demo: false,\\\\n    demoStart:0,');p.write_text(s)\np=Path('labs/game/scenes/flow.ts');s=p.read_text().replace(\\\"import { put } from './world';\\\", \\\"import { put } from './world';\\\\nimport {REMARKS} from '../ui/lines/cast';\\\")\ns=s.replace('  f.event = createRun(id,', '  f.demoStart=f.clock;\\\\n  f.event = createRun(id,')\na=s.index('  f.message =\\\\n    normalized >=');b=s.index(\\\"  f.speaker = 'Plumb';\\\",a);s=s[:a]+\\\"  f.message=REMARKS[w.rng('remarks').int(0,REMARKS.length-1)];\\\\n\\\"+s[b:]\ns=s.replace(\\\"  if (id === 'paddle') f.props.push\\\", \\\"  if(id==='line')f.props.push(put(w,'board',-62,42,2.05));\\\\n  if (id === 'paddle') f.props.push\\\")\np.write_text(s)\np=Path('labs/game/cast/guest.ts');s=p.read_text().replace(\\\"components: { guest: { seat, pose: 'Stand', initial: false } },\\\", \\\"components: { guest: { seat, pose: 'Stand', initial: false },...(plumb?{secondary:{hair:'ponytail',color:'#3f5143'}}:{}) },\\\")\np.write_text(s)\np=Path('labs/game/scenes/pilot.ts');s=p.read_text().replace('if (f.demo && r.tick >= 900)', 'if (f.demo && f.clock-f.demoStart >= 900)')\ns=s.replace(\\\"if (r.id === 'dive') progress = clamp(((r.tick % 1080) - 720) / 360, 0, 1);\\\", \\\"if(r.id==='dive') progress=(((r.angle/(Math.PI*4))%1)+1)%1;\\\\n  if(r.id==='step'){pose=input.r>.5 && input.l<.5?'StepUpR':'Step';progress=input.l>.5||input.r>.5?1:0;}\\\")\ns=s.replace(\\\"placeActor(w, f.hero, [a.x, 14.2 + Math.sin(fall * Math.PI) * 2 - fall * fall * 12, a.z - fall * 26], 0);\\\", \\\"placeActor(w, f.hero, [a.x,14.2+Math.sin(fall*Math.PI)*2-fall*fall*12,a.z-fall*26],r.velocity);\\\")\ns=s.replace(\\\"  if (r.id === 'tilt' && r.phase === 3)\\\", \\\"  if(r.id==='tilt' && r.phase===1){\\\\n    if(r.offset===0){placeActor(w,f.hero,[-12,8.2,34]);r.offset=1;}\\\\n    hero.actor.intents={move:[input.x*.7-.08,-input.y*.6]};\\\\n    if(hero.actor.x>80 || hero.actor.x< -25 || hero.actor.z>45 || hero.actor.z< -10){const x=clamp(hero.actor.x,-25,80),z=clamp(hero.actor.z,-10,45);placeActor(w,f.hero,[x,heightAt(x,z)+.2,z]);}\\\\n  }\\\\n  if (r.id === 'tilt' && r.phase === 3)\\\")\ns=s.replace(\\\"    poseGuest(w, id, pose, 1,\\\", \\\"    if(ghost && r.id==='group'){if(\"'!ghost.active || ghost.phase!==r.phase){placeActor(w,id,[-150,8,18]);return;}placeActor(w,id,[-53.8+n*3.6,8.2,20]);}'\"\\\\n    poseGuest(w, id, pose, r.id==='step'?.5+.5*Math.sin(r.tick/12+n):1,\\\")\ns=s.replace(\\\"  if (r.tick % 30 === 0 && r.id === 'step')\\\", \\\"  if(r.id==='dive' && r.tick%1080===0)w.emit('diveSplash',{});\\\\n  if (r.tick % 30 === 0 && r.id === 'step')\\\")\np.write_text(s)\np=Path('labs/game/cast/clips.ts');s=p.read_text().replace(\\\"    Step: strip(\\\",\\\"    Step: strip(\\\")\n# Add a right-foot strip alongside the existing readable clip map.\ns=s.replace(\\\"    CalmCall: strip\\\", \\\"    StepUpR:strip({hips:[0,0,115],legR:[50,8,-65,60,0],armL:[70,15,-40,80,0]}),\\\\n    CalmCall: strip\\\")\np.write_text(s)\np=Path('labs/game/ui/hud.ts');s=p.read_text().replace(\\\"import { rhythmNote }\\\", \\\"import {BPMS} from '../scenes/data/charts';\\\\nimport { rhythmNote }\\\")\ns=s.replace('const tick = r.tick + i * 32,', \\\"const part=Math.min(2,Math.floor(r.tick/2004)),interval=3600/(BPMS[part]*c.get('step.bpm'));\\\\n    const tick = (Math.floor(r.tick/interval)+i)*interval,\\\")\ns=s.replace('const left = 20 + i * 16 - ((r.tick % 32) / 32) * 16;', 'const left=20+(tick-r.tick)/interval*16;')\np.write_text(s)\np=Path('labs/game/ui/screens/programme.ts');s=p.read_text().replace(\\\"import type { ScreenApp }\\\", \\\"import {EVENING} from '../lines/cast';\\\\nimport type { ScreenApp }\\\").replace(\\\"'Today you wobbled less than you might have. Goodnight.'\\\", \\\"EVENING[Math.min(4,f.day-1)]\\\")\ns=s.replace(\\\"  const list = ACTIVITIES.slice(page * 5, page * 5 + 5),\\\\n    f = a.flow ?? a.save;\\\", \\\"  const f=a.flow??a.save;\\\\n  const met=new Set(DAYS.slice(0,Math.min(5,f.day)).flatMap(d=>d.events));met.add('group');\\\\n  const available=f.complete?ACTIVITIES:ACTIVITIES.filter(event=>met.has(event.id));\\\\n  const pages=Math.ceil(available.length/5);page=((page%pages)+pages)%pages;\\\\n  const list=available.slice(page*5,page*5+5);\\\")\ns=s.replace('page + 1} / 3', 'page + 1} / \"'${pages}'\"').replace(\\\"a.show('board', (page + 1) % 3)\\\", \\\"a.show('board',(page+1)%pages)\\\")\np.write_text(s)\nPY\ncat > labs/game/props/finale.ts <<'EOF'\n/** @file Counterweight carts, rails and the lighthouse's sweeping storm beam. */\nimport {box,cone,prop} from './kit';\nprop('counterCart',[box('tray',[0,.45,0],[1.8,.35,2.4],'#b4c7ad'),...[-.8,.8].flatMap((x)=>[-.8,.8].map((z)=>({...cone(\"'`wheel${x}${z}`,[x,.22,z],.26,.26,.12,'\"'#687b69',12),rotation:[0,0,Math.PI/2]}))),...Array.from({length:6},(_,i)=>box(\"'`stone${i}`,[(i%2-.5)*.55,.8+Math.floor(i/2)*.17,0],[.7,.23,.8],'\"'#d5c7a5',.1))]);\nprop('counterRails',[-.8,.8].map((x)=>box(\"'`rail${x}`,[x,0,0],[.08,.08,20],'\"'#9cae99')));\nprop('beacon',[{name:'beam',geometry:'geometry:frustum',params:{radiusBottom:.06,radiusTop:7,height:100,radialSegments:16},material:'material:retreatBeam',rotation:[Math.PI/2,0,0],shadow:false}]);\nEOF\ncat >> labs/game/props/retreat.ts <<'EOF'\nimport './finale';\nEOF\ncat >> labs/game/looks/retreat.ts <<'EOF'\ndefineMaterial('material:retreatBeam',{color:'#ffefb3',unlit:true,transparent:true,opacity:.12,depthWrite:false});\ndefineLook('look:retreatSession',{description:'A clear, quick-to-prepare pavilion for the shared class.',sky:'sky:retreat',style:'toon'});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"  put(w, 'lighthouse', 84, -60);\\\", \\\"  put(w, 'lighthouse', 84, -60);\\\\n  put(w,'beacon',84,-60,heightAt(84,-60)+14);\\\");p.write_text(s)\np=Path('labs/game/scenes/ambience.ts');s=p.read_text();s=s.replace(\\\"import { placeActor, type World }\\\", \\\"import { placeActor, type World }\\\")\ns=s.replace(\\\"  const r = f.event;\\\", \\\"  const r = f.event;\\\\n  if(\"'!f.roundOnly)for(const e of w.query('\"'sceneProp'))if(e.sceneProp.prop==='prop:beacon'){const a=w.tick/140;e.sceneProp.q=[0,Math.sin(a/2),0,Math.cos(a/2)];}\\\\n  if(f.mode==='event' && r.id==='line' && tare){tare.x=-62;tare.z=42+r.progress;tare.y=2.25+Math.abs(Math.sin(w.tick/18))*.1;const board=w.get(f.props[0])?.sceneProp;if(board)board.z=tare.z;}\\\\n  if(f.mode==='event' && r.id==='pond'){if(r.tick>1440 && f.props.length===0)f.props.push(put(w,'frog',-69.65,-11.6,4.65));if(r.tick>1920 && f.props.length<2)f.props.push(put(w,'gull',-70,-12,5.4));}\\\\n  if(f.mode==='event' && r.id==='tilt' && r.phase===2){if(f.props.length===0){f.props.push(put(w,'counterRails',58,12),put(w,'counterRails',64,12),put(w,'counterCart',58,5),put(w,'counterCart',64,5));}for(const id of f.props.slice(2)){const prop=w.get(id)?.sceneProp;if(prop)prop.z=5+Math.min(1,r.count/80)*14;}}\\\")\np.write_text(s)\np=Path('labs/game/scenes/events/tilt.ts');s=p.read_text().replace(\\\"r.tilt = Math.max(2, r.tilt - 0.015);\\\", \\\"{r.tilt = Math.max(2, r.tilt - 0.015);r.count++;}\\\")\np.write_text(s)\np=Path('labs/game/app.ts');s=p.read_text().replace(\\\"        topple: 'splash',\\\", \\\"        topple: 'splash',\\\\n        diveSplash:'splash',\\\")\ns=s.replace(\\\"    const look =\\\\n      f.mode\\\", \\\"    const look = this.hubActive?'look:retreatSession':\\\\n      f.mode\\\")\np.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"search.set('post.look', 'look:retreat');\\\", \\\"search.set('post.look', session.info?'look:retreatSession':'look:retreat');\\\");p.write_text(s)\np=Path('labs/game/cameras/retreat.ts');s=p.read_text().replace(\\\"[-45.5 + Math.sin(time * 0.06) * 1.4, 12.8, 32], [-59, 9.2, 20]\\\", \\\"[-49.5+Math.sin(time*.06),11.5,31],[-62.5,8.9,20]\\\")\ns=s.replace(\\\"} else if (SHOT.event === 'garden')\\\", \\\"} else if(SHOT.event==='tilt' && SHOT.phase===0){pose=SHOT.tick<600?aim([-48,10.7,19],[-52,9.6,13],43):aim([90,100,140],[0,6,0],52);\\\\n      } else if (SHOT.event === 'garden')\\\")\np.write_text(s)\nPY\nnpx prettier --write labs/game > out/game/format.log\nnpx tsc -b tsconfig.check.json --pretty false\nnode labs/game/tools/onefile.mjs\npython3 -u labs/game/tools/browser-check.py > out/game/browser.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
