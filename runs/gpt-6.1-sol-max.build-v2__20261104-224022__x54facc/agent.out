=await createHeadless({scene:island,seed:7}) as GameInspector;\n  h.actions.run('game.start',{event:'pose'});h.step(120,{'game:r':.2,'game:fl':1,'game:fr':1});\n  const capture=h.capture();h.step(90,{'game:l':.1});const expected=h.hash();h.restore(capture);h.step(90,{'game:l':.1});expect(h.hash()).toBe(expected);expect(h.errors).toHaveLength(0);\n });\n it('the complete five-day residency reaches credits on three seeds',async()=>{\n  for(const seed of [2,7,19]){\n   const h=await createHeadless({scene:island,seed,settings:{'game.auto':true,'game.pace':8}}) as GameInspector;\n   h.actions.run('game.begin');\n   let tick=0;const seen=new Set<string>();\n   while(flow(h).mode\"'!=='\"'credits' && tick<35000){h.step(60);tick+=60;const f=flow(h);if(f.mode==='event')seen.add(\"'`${f.day}:${f.event.id}`);}\n   expect(flow(h).mode,`seed ${seed}: ${flow(h).day}/${flow(h).event.id}`).toBe('\"'credits');\n   for(let d=0;d<5;d++)for(const id of DAYS[d].events)expect(seen.has(\"'`${d+1}:${id}`),`${d+1}:${id}`).toBe(true);\n   expect(flow(h).ages).toHaveLength(6);expect(h.errors).toHaveLength(0);\n  }\n },120000);\n});\nEOF\nnpx vitest run labs/game/scenes/game.test.ts --maxWorkers=1 > out/game/tests.log 2>&1'","aggregated_output":"","exit_code":1,"status":"failed"}}
