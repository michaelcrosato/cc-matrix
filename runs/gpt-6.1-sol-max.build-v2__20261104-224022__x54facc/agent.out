{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '88,112p' engine/sim/actors.ts; sed -n '195,245p' engine/sim/actors.ts; sed -n '36,90p' engine/anim/builds.ts; sed -n '50,105p' engine/world/props/prop.ts; sed -n '259,283p' engine/world/props/prop.ts; sed -n '67,110p' engine/sim/props.ts; sed -n '1,130p' engine/gfx/materialKinds.ts 2>/dev/null; sed -n '1,150p' engine/audio/song.ts\"","aggregated_output":"export interface ActorComponent extends CharacterState {\n  body: number;\n  player: boolean;\n  character: Character;\n  intents: Partial<Intents>;\n  held: string[];\n  x: number;\n  y: number;\n  z: number;\n}\n\n/** The component `animator`: an actor's character animator as plain data, and what its game code tells its body. */\nexport interface AnimatorComponent extends AnimatorData {\n  /** The body states its game code holds on (a pose, a stance, a flinch…); the controller's join them each step. */\n  states: Partial<AnimatorInput>;\n}\n\n/** The component `puppet`: the body an actor is drawn as (engine/gfx/puppets/actors.ts), when not the humanoid. */\nexport interface PuppetComponent {\n  body: string;\n}\n\n/** The components this module reads: `actor`, `animator`, `puppet`, `motion` (the shooter model's) and `oneWay`. */\nexport type ActorComponents = {\n  actor: ActorComponent;\nexport interface ActorSpec {\n  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n  at: Vec3Like;\n  /** Its settings (createCharacter). */\n  character: Character;\n  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n  player?: boolean;\n  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n  yaw?: number;\n  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n  body?: string;\n  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n  clips?: ClipsSpec;\n  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n  holstered?: boolean;\n  /**\n   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n   * are there from its first step, and a page's first warm-up builds what they draw.\n   */\n  components?: Readonly<Record<string, object>>;\n}\n\n/**\n * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n */\nexport function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n  const w = world as unknown as World;\n  const physics = physicsOf(w);\n  const body = addCharacter(physics, spec.character, spec.at);\n  const { x, y, z } = feetOf(physics, body, spec.character);\n  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n  if (!w.systems.has('actors')) {\n    w.systems.add('actors', moveActors, { phase: 'anim' });\n    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n  }\n  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n  if (!w.systems.has('actors.anim')) {\n    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n  }\n  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n  size: { type: 'number', default: 1, minimum: 0.01, description: 'Scale applied to every length of the build.' },\n  legUpper: metres(0.375, 'Hip joint to knee: the thigh.'),\n  legLower: metres(0.375, 'Knee to sole: the shin plus the ankle height.'),\n  hipHeight: metres(0.725, 'Pelvis height in the relaxed stance, at most legUpper + legLower (the old hipZ).'),\n  hipHalf: metres(0.11875, 'Pelvis centre to each hip joint, sideways.'),\n  footSpread: metres(0.11875, 'Pelvis centre to each foot, sideways, in the stance.'),\n  torso: metres(0.5, 'Pelvis to the shoulder centre (the base of the neck).'),\n  shoulderHalf: metres(0.20625, 'Shoulder centre to each shoulder joint, sideways.'),\n  neck: metres(0.075, 'Base of the neck to the base of the skull.'),\n  headRadius: metres(0.2125, \"The head's radius; its centre is one radius above the base of the skull.\"),\n  armUpper: metres(0.2875, 'Shoulder to elbow.'),\n  armLower: metres(0.2875, 'Elbow to wrist.'),\n  ankleHeight: metres(0.08, 'Sole to ankle joint (new: the old rig stood its foot point on the floor).'),\n  footLength: metres(0.17, 'Heel to toe tip (new).'),\n  handLength: metres(0.15, 'Wrist to fingertip (new).'),\n  chestDepth: metres(0.2, 'Front to back through the chest, for the back socket (new).'),\n  lean: { type: 'number', default: 0, unit: 'rad', description: 'Forward lean of the torso in the stance.' },\n  hunch: { type: 'number', default: 0, minimum: 0, description: 'How far the head and hands slump forward (share).' },\n  stride: metres(0.40625, 'Half the foot travel of one walking step, at the reference speed.'),\n  lift: metres(0.2125, 'How high a foot lifts while walking.'),\n  swing: metres(0.25, 'How far the hands swing while walking.'),\n  speedRef: {\n    type: 'number',\n    default: 4.375,\n    minimum: 0.01,\n    unit: 'm/s',\n    description: 'The speed the stride is tuned for.',\n  },\n  plantedStride: {\n    type: 'boolean',\n    default: false,\n    description:\n      \"Whether the gait lowers the pelvis so a planted sole reaches its target at full stride (new: the source's builds keep its gait, whose soles hang at full stride, ADR-0009 amendment 4).\",\n  },\n} as const satisfies Schema;\n\n/** A `build` entry: one body's proportions, in metres before `size`. */\nexport type Build = Entry<typeof BUILD_FIELDS>;\n\n/** What `defineBuild` takes: any field; the others keep `build:chibi`'s values. */\nexport type BuildSpec = SpecOf<typeof BUILD_FIELDS>;\n\n/** The engine's builds: my-3d2dge's numbers / 16, plus the new fields' values. `build:chibi` is all defaults. */\nconst ENGINE_BUILDS: Record<string, BuildSpec> = {\n  'build:chibi': {},\n  'build:heroic': {\n    legUpper: 0.4625,\n    legLower: 0.4625,\n    hipHeight: 0.89375,\n    torso: 0.6,\n    shoulderHalf: 0.21875,\n    headRadius: 0.190625,\n    neck: 0.09375,\n    armUpper: 0.34375,\n    armLower: 0.3375,\nconst metres = (value: number, description: string) =>\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\n\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n\n/** The fields of a part's flame. */\nconst FLAME_FIELDS = {\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\n  ring: metres(0.1, 'How far from its origin the tongues stand.'),\n  height: metres(0.4375, \"A tongue's mean height; it dances about half of it either way.\"),\n  sway: metres(0.0875, 'How far a tongue sways sideways, leaning 3 rad per metre of sway.'),\n  core: { type: 'string', default: '#ffd36a', description: 'The colour of the core inside each tongue, hex.' },\n} as const satisfies Schema;\n\n/** The fields of one part: a mesh of the prop. */\nexport const PROP_PART_FIELDS = {\n  name: {\n    type: 'string',\n    default: 'mesh',\n    description: 'Its name, unique in the prop: the ID pass names its batch `<prop>/<name>` (prop:crate/mesh).',\n  },\n  geometry: {\n    type: 'string',\n    default: 'geometry:box',\n    description: 'Its geometry by id (engine/gfx/geometry), standing on the ground, in metres.',\n  },\n  params: { type: 'object', default: {}, description: \"The geometry's parameters; the rest keep their defaults.\" },\n  material: {\n    type: 'string',\n    default: 'material:default',\n    description: 'Its material by id (engine/gfx/materials): on every face, or on its sides when top names another.',\n  },\n  top: {\n    type: 'string',\n    default: '',\n    description: \"A material for its tops and bottoms (faces within 45° of up or down: a barrel's lids); '' for none.\",\n  },\n  tint: { type: 'string', default: '#ffffff', description: 'A colour multiplying the material, hex, per instance.' },\n  position: vec3([0, 0, 0], \"Where its origin stands in the prop's frame (the base at 0, +Y up).\"),\n  rotation: vec3([0, 0, 0], 'Its turn in the prop’s frame, Euler angles about X, Y then Z.', 'rad'),\n  shadow: { type: 'boolean', default: true, description: 'Whether it casts shadows (every part receives them).' },\n  lit: {\n    type: 'boolean',\n    default: false,\n    description:\n      'Drawn only while its prop is on: a lamp’s bulb, which its switch turns off with its light (WP 13.16).',\n  },\n  flame: {\n    type: 'object',\n    default: defaultsOf(FLAME_FIELDS),\n    description:\n      'Drawn as flame tongues dancing round its origin (its geometry a cone 1 m high), or still (tongues 0).',\n    properties: FLAME_FIELDS,\n  },\nexport type PropPart = Omit<EntryOf<typeof PROP_PART_FIELDS>, 'params' | 'position' | 'rotation'> & {\n  readonly params: Readonly<Record<string, unknown>>;\n  readonly position: readonly number[];\n  readonly rotation: readonly number[];\n};\n\n/** A `prop` entry: see the file comment. */\nexport type Prop = Omit<Entry<typeof PROP_FIELDS>, 'parts' | 'hit' | 'use'> & {\n  readonly parts: readonly PropPart[];\n  readonly hit: (touch: PropTouch) => void;\n  readonly use: (touch: PropTouch) => void;\n};\n\n/** Every key of `T` optional, and those of the plain objects in it (not arrays or functions). */\ntype Partly<T> = {\n  -readonly [K in keyof T]?: T[K] extends readonly unknown[] | ((...args: never[]) => unknown)\n    ? T[K]\n    : T[K] extends object\n      ? { -readonly [P in keyof T[K]]?: T[K][P] }\n      : T[K];\n};\n\n/** What `defineProp` takes: any field, and of its objects (body, light, place, each part and its flame) any key. */\nexport type PropDefinition = Partly<Omit<Prop, 'id' | 'kind' | 'parts'>> & { parts?: readonly Partly<PropPart>[] };\n\nexport interface ScenePropComponent {\n  prop: string;\n  body: number;\n  x: number;\n  y: number;\n  z: number;\n  q: [number, number, number, number];\n}\n\n/** The component `propHealth` (WP 13.16): the hit points a breakable prop has left, spawned only on one with health. */\nexport interface PropHealthComponent {\n  hp: number;\n}\n\n/** The component `propLight` (WP 13.16): a switchable prop's state, spawned only on one given a group or off. */\nexport interface PropLightComponent {\n  /** Whether it is on: its `lit` parts drawn and its light shining. */\n  on: boolean;\n  /** The light group a switch turns it on and off by (`'room:kitchen'`). */\n  group: string;\n}\n\n/** The components this module reads. */\nexport type ScenePropComponents = {\n  sceneProp: ScenePropComponent;\n  propHealth?: PropHealthComponent;\n  propLight?: PropLightComponent;\n};\n\n/** How `spawnProp` stands a prop beyond its placement (WP 13.16): a spawn inside a step or a setup joins the world at its end, so a door's or a switch's own component comes with it here. */ // prettier-ignore\nexport interface SpawnPropOptions {\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\n  as?: 'dynamic' | 'fixed' | 'kinematic';\n  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\n  on?: boolean;\n  group?: string;\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\n  components?: Readonly<Record<string, object>>;\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\n  knock?: PropKnock & { from: readonly [number, number, number] };\n}\n\n/** Declares the component `sceneProp` on `registry` (once). */\nexport function definePropKinds(registry: Registry = sharedRegistry): void {\nsed: can't read engine/audio/song.ts: No such file or directory\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '80,120p' engine/app/drawing.ts; sed -n '1,160p' engine/gfx/cameras/chase.ts; sed -n '1,160p' labs/game/scenes/play.test.ts; cat vite.config.ts; rg -n 'anim:|palette|colors|color' engine/sim/actors.ts engine/anim/builds.ts engine/gfx/characters/*.ts | head -50\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '80,120p' engine/app/drawing.ts; sed -n '1,160p' engine/gfx/cameras/chase.ts; sed -n '1,160p' labs/game/scenes/play.test.ts; cat vite.config.ts; rg -n 'anim:|palette|colors|color' engine/sim/actors.ts engine/anim/builds.ts engine/gfx/characters/*.ts | head -50\"","aggregated_output":"\n/**\n * What `onFrame` gets once per drawn frame: the run to read, never to change (presentation only: nothing reaches the\n * hash), the camera the frame was drawn from, and the emitters to run.\n */\nexport interface EngineFrame {\n  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n  readonly world: FrameWorld;\n  /** The running scene: its id, its level and whether it has physics. */\n  readonly scene: Scene;\n  /** The camera's pose this frame: where a listener goes. */\n  readonly camera: CameraPose;\n  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n  readonly queries: QueryView | null;\n  /** Real seconds since the last frame. */\n  readonly dt: number;\n  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n  setting(key: string): unknown;\n  /**\n   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n   */\n  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n}\n\n/** What `createPageDrawing` draws with besides the parts. */\nexport interface PageDrawingOptions {\n  /** The page's chrome: its touch class and top panel. */\n  chrome: Chrome;\n  /** The current run's settings (`quality`). */\n  settings: Settings;\n  /** The page's own presentation, after each drawn frame. */\n  onFrame?: (frame: EngineFrame) => void;\n}\n\n/** The page's drawing (see the file comment). */\nexport interface PageDrawing {\n  /** The rendering members' drawing. */\n  readonly drawing: Drawing;\n  /** Draws the view at `alpha`, `dt` real seconds after the last frame. */\n/**\n * @file The chase camera (PLAN.md WP 3.9, §6.1; doctrine: Common ground, Quality under the hood): a perspective camera\n * on a spring arm behind and above the hero, turned by the devices, that slides in front of a wall rather than through\n * it, as Unreal's spring arm and Cinemachine's third-person follow do. `stepChase` and `chasePose` are the pure steps;\n * `createChaseCamera` wraps them in a camera.\n *\n * The arm hangs from a pivot `CHASE_HEIGHT` above `input.follow` (the hero's feet), which follows with a time constant\n * of `CHASE_LAG` real seconds, and runs back against the view direction (`yaw`, `pitch`) for `distance`. `input.look`\n * and `input.turn` turn the view right and up; `input.zoom` steps the arm in by `ORBIT_ZOOM_STEP`.\n *\n * Walls (engine/gfx/cameras/collide.ts): through the sim's read-only `QueryView` (`input.queries`), a ball of\n * `CHASE_RADIUS` is swept from the hero's head (the pivot before its lag) to the pivot, then cast along the arm, and\n * stops short of the first surface of `input.groups` (`world` by default; `input.exclude` skips his own body). The arm\n * snaps in at once and eases back out with a time constant of `CHASE_RETURN`, never past what the casts left clear.\n * Without `queries` nothing shortens it.\n *\n * Invariants: with `queries`, and the hero's head at least `CHASE_RADIUS` from every wall (a character's capsule is\n * wider), the camera's ball, so its near plane, never ends inside a wall, and the line from the head to the camera is\n * clear (chase.test.ts walks fixtures/scenes/chase-walls/ to prove it). The pitch stays within `CHASE_LIMITS.pitch`,\n * the arm within `CHASE_LIMITS.distance`. Pure: each step returns a new state.\n *\n * Codes: `cam3=chase[,<yaw>,<pitch>,<distance>]` (degrees, metres; a bare one keeps the last camera's heading). Until\n * codes.ts reads WP 3.9's cameras, this file holds what they share: `readCode`, `codeNumber`, `followCamera`.\n *\n * Carried from `my-3d2dge:src/stress-world/40-cameras.js:84-94` (`chasePose`: the arm, its pitch, lens and lag, the\n * pull in front of a wall) and `:37` (its numbers), in metres and +Y up, the height-map march replaced by ball casts.\n *\n * @example\n * import { startScene } from '../../sim/scene';\n * import { queryViewOf } from '../../sim/queryView';\n * import chaseWalls from '../../../fixtures/scenes/chase-walls';\n * const chase = createChaseCamera();\n * const pose = chase.update({ follow: [2, 0, 3] }, 1 / 60); // the first follow snaps to the hero\n * pose.position; // [2, 3.44…, -2.15…]: 5.5 m back from 1.5 m above his feet, looking along +Z and 20.6° down\n * chase.code(); // 'cam3=chase,0,-20.63,5.5'\n * const { world } = startScene(chaseWalls);\n * world.step({}); // queries see the level from the first step\n * createChaseCamera().update({ follow: [1.5, 0, 1.5], queries: queryViewOf(world) }).distance; // 0.299…: a wall behind\n * @see engine/gfx/cameras/chase.test.ts\n */\nimport { codeError, didYouMean } from '../../core/log';\nimport { MathUtils } from '../../core/math';\nimport { COLLIDE_RADIUS, COLLIDE_RETURN, COLLIDE_SKIN, easeArm, reach, sweep, type Walls } from './collide';\nimport type { EffectWeights } from './effects';\nimport { ORBIT_ZOOM_STEP } from './orbit';\nimport {\n  approach,\n  makePose,\n  poseForward,\n  rangeProblems,\n  refuse,\n  wrapAngle,\n  type Camera,\n  type CameraInput,\n  type CameraPose,\n  type Vec3,\n} from './pose';\n\nconst DEG = MathUtils.DEG2RAD;\n\n/** The arm's starting pitch (rad, + up), length (m) and the lens (degrees, `PerspectiveCamera.fov`). */\nexport const CHASE_DEFAULTS = Object.freeze({ pitch: -0.36, distance: 5.5, fov: 60 });\n/** The range of the pitch (rad) and the arm's length (m). */\nexport const CHASE_LIMITS = Object.freeze({ pitch: [-1.4, 1] as const, distance: [0.5, 20] as const });\n/** The pivot's height above the followed point, m: the hero's head. */\nexport const CHASE_HEIGHT = 1.5;\n/** The time constant of the pivot's follow, real seconds. */\nexport const CHASE_LAG = 1 / 12;\n/** The time constant of the arm easing back out after a wall, real seconds: collide.ts's `COLLIDE_RETURN`. */\nexport const CHASE_RETURN = COLLIDE_RETURN;\n/** The radius of the ball cast along the arm, m: collide.ts's `COLLIDE_RADIUS`. */\nexport const CHASE_RADIUS = COLLIDE_RADIUS;\n/** How far short of a surface the ball stops, m: collide.ts's `COLLIDE_SKIN`. */\nexport const CHASE_SKIN = COLLIDE_SKIN;\n/** Turn rates at full `input.turn`, rad/s: `[right, up]` (the prototype's [ ] keys turn 2.2). */\nexport const CHASE_TURN_SPEED = Object.freeze([2.2, 1.2] as const);\n/** The chase camera's near plane, m. */\nconst NEAR = 0.05;\n\n/** A chase camera's input: the devices' and the hero's, and the walls it keeps out of (collide.ts). */\nexport interface ChaseInput extends CameraInput, Walls {}\n\n/** A chase camera's code as data: without the numbers it keeps the heading of the camera before it. */\nexport interface ChaseSpec {\n  readonly type: 'chase';\n  /** The heading, rad (the intents' `cam`). */\n  readonly yaw?: number;\n  /** Rad, + up. */\n  readonly pitch?: number;\n  /** The arm's length when nothing is in the way, m. */\n  readonly distance?: number;\n}\n\n/** A chase camera's state: plain data, replaced by each step. */\nexport interface ChaseState {\n  readonly yaw: number;\n  readonly pitch: number;\n  /** The arm's length when nothing is in the way, m. */\n  readonly distance: number;\n  /** The lens, degrees. */\n  readonly fov: number;\n  /** The pivot, m: `CHASE_HEIGHT` above the followed point, with its lag; null until the first follow. */\n  readonly pivot: Vec3 | null;\n  /** The arm after the walls, m: at most `distance`. */\n  readonly arm: number;\n}\n\n/** Options for a chase camera: its code's data, the lens, and the camera before it. */\nexport interface ChaseOptions extends Omit<ChaseSpec, 'type'> {\n  readonly fov?: number;\n  /** The camera before this one: a chase without a yaw keeps its heading. */\n  readonly from?: CameraPose;\n}\n\n/** A checked chase state for `options`. Throws `GFX_BAD_CAMERA`. */\nexport function chaseState(options: ChaseOptions = {}): ChaseState {\n  const distance = options.distance ?? CHASE_DEFAULTS.distance;\n  const state: ChaseState = {\n    yaw: options.yaw ?? options.from?.yaw ?? 0,\n    pitch: options.pitch ?? CHASE_DEFAULTS.pitch,\n    distance,\n    fov: options.fov ?? CHASE_DEFAULTS.fov,\n    pivot: null,\n    arm: distance,\n  };\n  refuse('the chase camera', [\n    ...rangeProblems({\n      yaw: [state.yaw, -1e6, 1e6],\n      pitch: [state.pitch, ...CHASE_LIMITS.pitch],\n      distance: [state.distance, ...CHASE_LIMITS.distance],\n      fov: [state.fov, 1, 179],\n    }),\n  ]);\n  return state;\n}\n\n/** Steps a chase camera by one rendered frame: turned by `look` and `turn`, `zoom` on the arm, following, walls. */\nexport function stepChase(state: ChaseState, input: ChaseInput, dt: number): ChaseState {\n  const right = (input.look?.[0] ?? 0) + (input.turn?.[0] ?? 0) * CHASE_TURN_SPEED[0] * dt;\n  const up = (input.look?.[1] ?? 0) + (input.turn?.[1] ?? 0) * CHASE_TURN_SPEED[1] * dt;\n  const yaw = wrapAngle(state.yaw - right);\n  const pitch = MathUtils.clamp(state.pitch + up, ...CHASE_LIMITS.pitch);\n  const zoomed = state.distance / Math.pow(ORBIT_ZOOM_STEP, input.zoom ?? 0);\n  const distance = MathUtils.clamp(zoomed, ...CHASE_LIMITS.distance);\n  const f = input.follow;\n  const head: Vec3 | null = f ? [f[0], f[1] + CHASE_HEIGHT, f[2]] : null;\n  let pivot = head && state.pivot ? approach(state.pivot, head, 1 - Math.exp(-dt / CHASE_LAG)) : (head ?? state.pivot);\n  let clear = distance;\n  if (input.queries && pivot) {\n    if (head) pivot = sweep(input, head, pivot); // the lag never takes the pivot through a wall\n    const [fx, fy, fz] = poseForward({ yaw, pitch });\n    clear = reach(input, pivot, [-fx, -fy, -fz], distance);\n  }\n  return { ...state, yaw, pitch, distance, pivot, arm: easeArm(state.arm, distance, clear, dt) };\n}\n\n/** The chase camera's pose: `arm` metres back from the pivot along its view direction, looking at the pivot. */\nexport function chasePose(state: ChaseState): CameraPose {\n  const [px, py, pz] = state.pivot ?? [0, CHASE_HEIGHT, 0];\n  const [fx, fy, fz] = poseForward(state);\n/**\n * @file The starter game's tests (labs/game/scenes/play.ts): what every game made from it starts with, and keeps as it\n * grows. They run headless in Node (`npm test`), in a few seconds:\n * - its golden replay (labs/game/replays/bot.replay.json, the bot's play) gives its golden hashes, as `x replay`\n *   checks it: on another platform than the one that recorded them, two runs agree instead;\n * - a run continues exactly after a capture and a restore;\n * - the bot (labs/game/bot.ts) wins on 10 seeds, so the game can be won, however the gems fall;\n * - the clock runs out on a player who stands still, and the settings change play;\n * - two actors that reach a gem in the same step take it once.\n *\n * When the game's play changes on purpose, record the goldens again: `node x replay labs/game/replays/bot.replay.json\n * --browser sim --update` (in Node and Chromium), and say why in the commit.\n * @see labs/game/scenes/play.ts\n */\nimport { readFileSync } from 'node:fs';\nimport { describe, expect, it } from 'vitest';\nimport { createHeadless } from '../../../engine';\nimport { defineScene, type World } from '../../../engine/sim-api';\nimport { botIntents, playBot, roundOf, viewOf } from '../bot';\nimport { spawnPlayer } from '../cast/player';\nimport { play, type GameComponents } from './play';\n\n/** The golden replay: the bot's play from seed 1, with the goldens `x replay --update` recorded. */\nconst REPLAY = readFileSync(new URL('../replays/bot.replay.json', import.meta.url), 'utf8');\n\n/** This platform's golden key, as replays write it. */\nconst PLATFORM = `${process.platform}-${process.arch}`;\n\n/** Plays `text` from step 0 in a fresh engine and returns its hashes at the replay's checkpoints. */\nasync function replayed(text: string): Promise<Record<string, string>> {\n  const engine = await createHeadless({ scene: play });\n  const result = await (engine.replay as (text: string) => Promise<{ hashes: Record<string, string> }>)(text);\n  return result.hashes;\n}\n\ndescribe('game:play', () => {\n  it('replays the bot’s play to its golden hashes', async () => {\n    const goldens = (JSON.parse(REPLAY) as { hashes: Record<string, Record<string, string>> }).hashes;\n    const first = await replayed(REPLAY);\n    if (goldens[PLATFORM]) expect(first).toEqual(goldens[PLATFORM]);\n    else expect(await replayed(REPLAY)).toEqual(first); // recorded elsewhere: the runs agree, as x replay judges it\n  });\n\n  it('continues exactly after a capture and a restore', async () => {\n    const engine = await createHeadless({ scene: play, seed: 4 });\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\n    const capture = engine.capture();\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\n    const straight = engine.hash();\n    engine.restore(capture);\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\n    expect(engine.hash()).toBe(straight);\n  });\n\n  it('is won by the bot on 10 seeds', async () => {\n    for (let seed = 1; seed <= 10; seed++) {\n      const engine = await createHeadless({ scene: play, seed });\n      expect({ seed, ...playBot(engine) }).toMatchObject({ seed, state: 'won' });\n      expect(roundOf(engine).collected).toBe(roundOf(engine).gems);\n    }\n  });\n\n  it('is lost when the clock runs out, and its settings change play', async () => {\n    const engine = await createHeadless({ scene: play, settings: { 'game.seconds': 5, 'game.gems': 3 } });\n    engine.step(5 * 60);\n    expect(roundOf(engine)).toMatchObject({ gems: 3, collected: 0, left: 0, state: 'lost' });\n    expect(viewOf(engine).gems).toHaveLength(3);\n  });\n\n  it('counts a gem once when two actors reach it in the same step', async () => {\n    const twin = defineScene<GameComponents>('game:twin', {\n      description: 'The starter, and two more players put on its gem in the first step: both reach it in the next.',\n      level: 'level:arena',\n      physics: true,\n      setup(w) {\n        play.setup(w);\n        const twins = (world: World<GameComponents>) => {\n          if ([...world.query('actor')].length > 1) return;\n          const [{ gem }] = world.query('gem');\n          for (const dx of [-0.3, 0.3]) spawnPlayer(world, [gem.x + dx, 0, gem.z], 6);\n        };\n        w.systems.add('test.twins', twins, { phase: 'rules' });\n      },\n    });\n    const engine = await createHeadless({ scene: twin, settings: { 'game.gems': 1 } }); // no neighbour within reach\n    engine.step(2);\n    expect([roundOf(engine).collected, roundOf(engine).state, engine.state('gem').entities.length]).toEqual([1, 'won', 0]); // prettier-ignore\n  });\n});\n/**\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\n * §6.10, WPs 0.2 and 0.12).\n *\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\n * tools/lib/tiers.ts's `T1_FULL` names.\n *\n * The build (`npm run build`) writes dist/ from the landing page (the root's\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\n * ships only what it imports, never a `fetch()` of a repository path (§6.3). Nothing here needs the network, a\n * browser, the source checkouts or an `x` command: the build and Vitest both read this file. The one-file\n * playground (playground.html, tools/lib/oneFile.ts) is built apart, with this file's alias. The reference to\n * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\n * the tests' project, which sees this file through it, knows `config.test` (Vitest 4's main types no longer add it).\n *\n * @see tools/lib/vite.test.ts\n */\n/// <reference types=\"vitest/config\" preserve=\"true\" />\nimport { existsSync, globSync } from 'node:fs';\nimport { availableParallelism } from 'node:os';\nimport { dirname, join } from 'node:path';\nimport { defineConfig } from 'vite';\nimport { vitestRerunTriggers } from './tools/lib/tiers';\n\n/** The dev server's port: `$PORT` (each ultracode lane sets its own), else 5173. */\nconst PORT = Number(process.env.PORT) || 5173;\n\n/** The repository root: this file's directory. */\nconst ROOT = import.meta.dirname;\n\n/** Whether this is a game made from the engine (tools/game/new-game.mjs), not the engine's own repository. */\nconst GAME = existsSync(join(ROOT, 'engine-lock.json'));\n\n/** The pages a build ships, as absolute paths by entry name: `index` (the landing page), then `labs/<name>`. */\nconst PAGES = Object.fromEntries(\n  ['index.html', ...globSync('labs/*/index.html', { cwd: ROOT }).sort()]\n    .filter((page) => !(GAME && page.startsWith('labs/box/')))\n    .map((page) => [dirname(page) === '.' ? 'index' : dirname(page), join(ROOT, page)]),\n);\n\nexport default defineConfig({\n  appType: 'mpa',\n  resolve: {\n    alias: [{ find: /^three$/, replacement: 'three/webgpu' }],\n  },\n  optimizeDeps: {\n    // The pages Vite scans for imports; the default (every *.html under the root) would crawl .cache/.\n    entries: ['index.html', 'labs/*/index.html', 'tests/pages/*.html'],\n    // Every runtime dependency of package.json, by the entry points pages import (tools/lib/vite.test.ts checks it).\n    include: [\n      'three/webgpu',\n      'three/tsl',\n      '@dimforge/rapier3d-simd-compat',\n      '@stdlib/math-base-special-sin',\n      '@stdlib/math-base-special-cos',\n      '@stdlib/math-base-special-pow',\n    ],\n  },\n  build: {\n    rollupOptions: { input: PAGES },\n    // In KB. Rapier passes its WASM to init() inline, as base64 (PLAN.md §4.8), so a page that imports it gets one\n    // large chunk (about 5.4 MB, 1.86 MB gzipped) and no .wasm file: the default 500 KB would warn on every build.\n    chunkSizeWarningLimit: 8000,\n  },\n  server: {\n    host: '127.0.0.1',\n    port: PORT,\n    strictPort: true,\n    watch: { ignored: ['**/.cache/**', '**/out/**', '**/dist/**', '**/test-results/**', '**/.claude/worktrees/**'] },\n  },\n  test: {\n    environment: 'node',\n    include: ['**/*.test.ts'],\n    exclude: [\n      '**/node_modules/**',\n      '.cache/**',\n      'out/**',\n      'dist/**',\n      'test-results/**',\n      'tests/e2e/**',\n      '.claude/worktrees/**',\n    ],\n    reporters: ['dot', 'json'],\n    outputFile: { json: 'out/test/report.json' },\n    setupFiles: ['tests/setup/adviceTrap.ts'],\n    // Many tool tests spawn node, tsx, git or Chromium; on the 4-core platform with parallel lanes a 5 s default\n    // times out under load while the test itself is sound. Timeouts bound hangs; they assert nothing.\n    testTimeout: 30_000,\n    hookTimeout: 60_000,\n    // One worker per core, not Vitest's default of one fewer: the tool tests wait on the children they spawn, and the\n    // spare core went idle. Measured on the 4-core platform: npm test 41 s with 3 workers, 36 s with 4, 36 s with 5\n    // (ADR-0014 amendment 7).\n    maxWorkers: availableParallelism(),\n    forceRerunTriggers: vitestRerunTriggers(),\n  },\n});\nrg: engine/gfx/characters/*.ts: No such file or directory (os error 2)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'defineBody|palette|body:mannequin' labs/box engine/gfx/puppets engine/anim | head -65; rg --files engine | rg '/(song|songs|materials|body|store)'; sed -n '1,125p' engine/gfx/puppets/body.ts 2>/dev/null; sed -n '1,110p' labs/box/sounds/boxHall.ts; rg -n 'export function placeActor|export function spawnProp|export function addTerrainBody|export function getTerrain|export interface Intents' engine/sim/*.ts engine/input/intents.ts engine/world/terrain.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'defineBody|palette|body:mannequin' labs/box engine/gfx/puppets engine/anim | head -65; rg --files engine | rg '/(song|songs|materials|body|store)'; sed -n '1,125p' engine/gfx/puppets/body.ts 2>/dev/null; sed -n '1,110p' labs/box/sounds/boxHall.ts; rg -n 'export function placeActor|export function spawnProp|export function addTerrainBody|export function getTerrain|export interface Intents' engine/sim/*.ts engine/input/intents.ts engine/world/terrain.ts\"","aggregated_output":"engine/gfx/puppets/actors.ts:4: * humanoid (`ACTOR_BODY`) or the body its component `puppet` names (`body:mannequin`, WP 8.9), in its animator's build,\nengine/gfx/puppets/bodies/mannequin.ts:24: * const { build, body } = defineMannequin(readSet('quaternius'), { registry }); // build:mannequin, body:mannequin\nengine/gfx/puppets/bodies/mannequin.ts:36:import { bodyKind, defineBody, getBody, type Body, type BodyPart, type BodyPoint, type BodySpec } from '../grammar';\nengine/gfx/puppets/bodies/mannequin.ts:125: * Registers `build:mannequin` (rest body `source` of `set`, its first by default) and `body:mannequin` (its `body`)\nengine/gfx/puppets/bodies/mannequin.ts:142:  const body = registry.has('body', 'body:mannequin')\nengine/gfx/puppets/bodies/mannequin.ts:143:    ? getBody('body:mannequin', registry)\nengine/gfx/puppets/bodies/mannequin.ts:144:    : defineBody('body:mannequin', mannequinBody(set.body as MannequinData, rest, build), registry);\nengine/gfx/puppets/compile.ts:308:/** `compiled` with its slots' colours replaced by `palette`'s (hex), the pieces shared. */\nengine/gfx/puppets/compile.ts:309:export function recolor(compiled: CompiledBody, palette: Readonly<Record<string, string>>): CompiledBody {\nengine/gfx/puppets/compile.ts:311:  for (const [slot, color] of Object.entries(palette)) colors[slot] = toLinear(color);\nengine/gfx/puppets/grammar.ts:4: * (the default palette) and the drawing sizes its lengths may name. `compileBody` (compile.ts) turns it into pieces\nengine/gfx/puppets/grammar.ts:26: * right offsets negated. `slots` maps slot names to hex colours; a palette overrides them per character. Eyes draw\nengine/gfx/puppets/grammar.ts:102:  slots: { type: 'object', default: {}, description: 'Material slots: each name with its hex colour (the palette).' },\nengine/gfx/puppets/grammar.ts:126:/** What `defineBody` takes: any field; absent ones keep their defaults. */\nengine/gfx/puppets/grammar.ts:280:    description: 'Puppet bodies: parts on the humanoid skeleton, one line each, with material slots (the palette).',\nengine/gfx/puppets/grammar.ts:284:      \"defineBody('<id>', { slots: { skin: '#…' }, parts: [['limb', 'thighL', 'shinL', 0.07, 0.06, 'skin']] })\",\nengine/gfx/puppets/grammar.ts:292:export function defineBody(id: string, spec: BodySpec, registry: Registry = sharedRegistry): Body {\nlabs/box/scenes/clips.ts:6: * (`body:mannequin` on `build:mannequin`); the hero plays the clip retargeted to his build, and stays the player: he\nlabs/box/scenes/clips.ts:207:      spawnActor(w, { at, character: createCharacter(), player: false, anim, body: 'body:mannequin', clips });\nlabs/box/looks/torch-pixel.ts:27:    palette: { scope: 'all', palette: 'none', levels: 8, dither: 0.35 },\nlabs/box/README.md:57:| `box:clips` (`labs/box/scenes/clips.ts`) | Clip mode, the Mocap Lab's: the room, the hero at its spawn and the mannequin 1.5 m east of him (`body:mannequin` on `build:mannequin`, the figure the Quaternius clips were measured on), both playing the clip `box.clips.clip` names through the clip layer in their animators, the hero's retargeted to his build. He stays the player and walks under it; masked to his upper body (`box.clips.mask`), his legs keep their own walk. A new clip crossfades in from the pose on screen; a one-shot holds its end 0.8 s, then plays again; clips that travel play in place. The page loads the library first: every set under `data/anim/sets`, registered as a `clipset` (`__engine.describe('clipset')`); `node x sim`, `node x replay` and the sim-only page register it too. | `tests/e2e/box-clips.spec.ts`, `tests/e2e/parity.spec.ts`, `tests/replays/box-8-clips.replay.json`, `labs/box/scenes/clips.test.ts` |\nengine/gfx/viewmodel/body.ts\nengine/gfx/materials/nodeCopy.ts\nengine/gfx/materials/compile.ts\nengine/gfx/materials/styles.ts\nengine/gfx/materials/builtins.ts\nengine/gfx/materials/outline.ts\nengine/gfx/materials/material.ts\nengine/gfx/materials/library.ts\nengine/gfx/materials/toon.ts\nengine/gfx/storeyCut.ts\nengine/app/store.ts\nengine/audio/data/songs.ts\nengine/world/level/storeys.ts\nengine/audio/data/song.ts\nengine/anim/bodyPlants.ts\n/**\n * @file The song `song:boxHall`: the box's demo song (PLAN.md WP 9.5), two bars in A minor at 100 bpm that loop in the\n * hall and the room, calm until a fight raises the intensity.\n *\n * Its layers (engine/audio/runtime/music.ts): a triangle bass and a square arpeggio from intensity 0, the calm; drums\n * and a pulse lead join from 0.5, which labs/box/sounds/page.ts reaches while blows land and leaves once they stop.\n *\n * Invariants: tracker notation, one token per step: a note (C4, F#3, Bb2), - holding the note before it, . a rest,\n * and | a bar line, which takes no step; a drums track writes the kit's tokens (k kick, s snare, h hat, o open hat,\n * c crash, t tom). At `steps` per beat and `beats` per bar, every track fills whole bars or divides one (node x\n * describe song lists the fields; engine/audio/data/song.ts gives the rules). `intensity` makes a track join only\n * when the music's intensity reaches it.\n *\n * @example\n * import { songTiming } from '../../../engine';\n * songTiming(boxHall).seconds; // 4.8: two bars of 4/4 at 100 bpm\n * @see labs/box/sounds/boxHall.test.ts\n */\nimport { defineSong } from '../../../engine';\n\n/** The song `song:boxHall`: the box's music, calm, with a fight's drums and lead from intensity 0.5. */\nexport const boxHall = defineSong('song:boxHall', {\n  bpm: 100,\n  tracks: [\n    {\n      wave: 'triangle',\n      vol: 0.22,\n      notes: 'A2 - - - - - - - E2 - - - - - - - | F2 - - - - - - - G2 - - - E2 - - -',\n    },\n    {\n      wave: 'square',\n      vol: 0.07,\n      notes: 'A4 . C5 . E5 . C5 . B4 . E5 . G#4 . B4 . | A4 . C5 . F5 . C5 . G4 . B4 . D5 . B4 .',\n    },\n    { wave: 'drums', vol: 0.14, intensity: 0.5, notes: 'k . h . s . h . k k h . s . h o' },\n    {\n      wave: 'pulse',\n      vol: 0.09,\n      intensity: 0.5,\n      notes: 'E5 - - - D5 - C5 - B4 - - - G#4 - - - | A4 - - - C5 - D5 - E5 - - - - - . .',\n    },\n  ],\n});\nengine/sim/actors.ts:261:export function placeActor<C extends object>(\nengine/world/terrain.ts:334:export function getTerrain(id: string, registry: Registry = sharedRegistry): Terrain {\nengine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\nengine/sim/levelBodies.ts:76:export function addTerrainBody(physics: Physics, terrain: Terrain, cut?: Uint8Array | null): number {\n","exit_code":0,"status":"completed"}}
