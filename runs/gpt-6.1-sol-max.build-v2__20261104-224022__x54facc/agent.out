{"type":"item.completed","item":{"id":"item_124","type":"command_execution","command":"/bin/bash -lc \"rg -n 'getGamepads|requestAnimationFrame\\\\s*=' engine | head -35; sed -n '70,110p' engine/app/loop.ts; sed -n '30,82p' labs/game/ui/runtime.ts; sed -n '16,42p' labs/game/ui/shell.ts; sed -n '100,140p' engine/input/devices/virtual.ts\"","aggregated_output":"engine/input/devices/gamepad.ts:37:/** Where pads come from: `navigator.getGamepads`, or a test's slots. */\nengine/input/input.ts:75:  /** Where pads come from (`navigator.getGamepads`). */\nengine/input/input.ts:157:  const nav = (globalThis as { navigator?: { getGamepads?(): readonly unknown[] } }).navigator;\nengine/input/input.ts:158:  const source = options.gamepads ?? (() => (nav?.getGamepads?.() ?? []) as ReturnType<GamepadSource>);\nengine/input/devices/padScript.ts:12: * Invariants: `gamepad` is one object whose fields `next()` rewrites, so a page's `navigator.getGamepads` can hand it\nconst union = (a: readonly string[], b: readonly string[]) => [...new Set([...a, ...b])].sort();\n\n/** Makes a frame loop (see the file comment). */\nexport function createLoop(options: LoopOptions): Loop {\n  const request = options.request ?? ((callback) => requestAnimationFrame(callback));\n  const cancel = options.cancel ?? ((id) => cancelAnimationFrame(id));\n  let id: number | null = null;\n  let frames = 0;\n  let steps = 0;\n  let waiting: string[] = []; // presses sampled in frames that ran no step\n  let slot = -Infinity; // the next capped frame's time\n  /** Whether a frame at `now` runs under the 60 fps cap (see the file comment); always without it. */\n  const due = (now: number) => {\n    if (!options.cap?.()) return true;\n    if (now + FRAME_SLACK_MS < slot) return false;\n    slot = now > slot + FRAME_SLOT_MS ? now + FRAME_SLOT_MS : slot + FRAME_SLOT_MS;\n    return true;\n  };\n  const loop: Loop = {\n    start() {\n      if (id !== null) return;\n      const tick = (now: number) => {\n        id = request(tick);\n        if (!due(now)) return;\n        try {\n          loop.frame(now);\n        } catch (error) {\n          loop.stop();\n          options.onError(error);\n        }\n      };\n      id = request(tick);\n    },\n    stop() {\n      if (id !== null) cancel(id);\n      id = null;\n    },\n    frame(now) {\n      const clock = options.clock();\n      if (options.hold?.()) return clock.advance(now);\n      const sampled = options.sample(now);\n    ? `<div class=\"demo-pill\">Wobble Fit <b>DEMO</b> ${glyph('accept', app.ui.device, app.options.xbox)} Press any button</div>${app.touchOnly ? '<div class=\"touch-guard\">Controller or keyboard required<button type=\"button\" data-touch-settings>Settings</button></div>' : ''}`\n    : '';\n  if (app.ui.banner.innerHTML === banner) return;\n  app.ui.banner.innerHTML = banner;\n  app.ui.banner.querySelector('[data-touch-settings]')?.addEventListener('click', () => {\n    app.exitAttract();\n    app.show('settings');\n  });\n}\n  screen = 'title';\n  focus = 0;\n  choices: Choice[] = [];\n  device: Device = 'keyboard';\n  xbox = false;\n  back: () => void = () => {};\n  interaction: () => boolean | void = () => {};\n  lastInput = performance.now();\n  padOld: boolean[] = [];\n  padRepeat = 0;\n  constructor() {\n    this.root.id = 'shell';\n    this.hud.id = 'game-hud';\n    this.banner.id = 'demo-banner';\n    document.body.append(this.root, this.hud, this.banner);\n    window.addEventListener('keydown', (event) => {\n      if (event.metaKey || event.ctrlKey || event.altKey) return;\n      if (this.note('keyboard')) {\n        event.preventDefault();\n        return;\n      }\n      if (!this.choices.length) return;\n      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter', 'Space', 'Escape', 'Tab'].includes(event.code))\n        event.preventDefault();\n      if (event.repeat && ['Enter', 'Space', 'Escape'].includes(event.code)) return;\n      if (event.code === 'ArrowUp') this.move(-1);\n      if (event.code === 'ArrowDown' || event.code === 'Tab') this.move(1);\n      if (value === null || value === undefined) delete axes[name];\n      else axes[name] = checkAxis(name, value, n);\n      touched = true;\n    },\n    peek,\n    take() {\n      const out = peek();\n      taps = new Set();\n      touched = false;\n      return out;\n    },\n    get touched() {\n      return touched;\n    },\n    clear() {\n      held.clear();\n      taps.clear();\n      for (const key of Object.keys(axes)) delete axes[key];\n    },\n  };\n}\n\n/** A checked copy of an axis value, or `INPUT_BAD_VIRTUAL`. */\nfunction checkAxis(name: string, value: unknown, n: number | undefined): IntentValue {\n  const finite = (v: unknown) => typeof v === 'number' && Number.isFinite(v);\n  if (n === 1 && finite(value)) return value as number;\n  if (n && n > 1 && Array.isArray(value) && value.length === n && value.every(finite)) return [...value] as number[];\n  if (n === undefined && (finite(value) || typeof value === 'string' || typeof value === 'boolean' || isPlainObject(value) || Array.isArray(value))) {\n    return structuredClone(value) as IntentValue; // the session checks it is plain data\n  } // prettier-ignore\n  const want = n === undefined ? 'plain data' : n === 1 ? 'a finite number' : `${n} finite numbers`;\n  throw codeError('INPUT_BAD_VIRTUAL', { what: `axis(${show(name)})`, problem: `${show(value)} is not ${want}` });\n}\n\n/** One step's intents from a virtual sample: `move` turned by the heading `yaw` (the `cam` axis when it holds one). */\nexport function virtualIntents(sample: VirtualSample, yaw = 0): Record<string, unknown> {\n  const { move, cam, ...rest } = sample.axes;\n  const heading = typeof cam === 'number' ? cam : yaw;\n  const out: Record<string, unknown> = { ...rest };\n  if (Array.isArray(move) && (move[0] !== 0 || move[1] !== 0)) {\n    out.move = fromCamera(heading, move as [number, number]);\n","exit_code":0,"status":"completed"}}
