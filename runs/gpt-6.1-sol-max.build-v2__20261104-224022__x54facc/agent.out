   if (input.bindings.map.lock && !started.clock.paused && !input.mouse?.locked) input.mouse?.lock();\n  });\n  parts.layer = createTouchLayer(document, layout);\n  attachSwipes(document);\n  connectVirtualDevice(started.host, input.virtual);\n  try {\n    parts.gfx = await createRenderer(options.canvas, { settings: currentSettings(() => started), registry, log });\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const gfx = parts.gfx;\n  parts.numbers = createDamageNumbers((parts.ui = createUi({ canvas: options.canvas })));\n  try {\n    gfx.renderer.shadowMap.enabled = true;\n    const styles = createStyleSet({ library: materials!, registry });\n    const post = (parts.post = createPost(gfx, { settings: currentSettings(() => started), registry, log, styles }));\n    const budget = () => parts.governor!.budget(settingsNow.get<QualitySetting>('quality'), input.touch?.active ?? false); // prettier-ignore\n    parts.look = createPageLook({ post, styles, warmup: gfx.warmup, resolution: gfx.resolution, library: materials!, quality: budget, asked: () => warmsAsked(settingsNow) }); // prettier-ignore\n    post.attach(gfx.warmup);\n    viewNow().stage.register(gfx.warmup, gfx.features);\n    await warmCameras();\n    await settle(1, 0);\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const step = (intents: Record<string, unknown>) => {\n    if (playback && !playback.done) {\n      playback.step(started.session);\n      started.stepped(); // its hit-stops reach the clock as in live play\n    } else {\n      playback = null;\n      started.stepOnce(intents);\n    }\n  };\n  loop = createLoop({\n    clock: () => started.clock,\n    sample,\n    step,\n    draw: ({ alpha, dt }) => {\n      // frozen in a reproducible run: a replay playing, or the governor turned off (engine/dev/governor.ts)\n      parts.governor!.freeze((playback !== null && !playback.done) || !settingsNow.get<boolean>('gfx.governor'));\n      if (warming) return;\n      const report = frame(alpha, dt);\n      if (!report.drawn && report.warming) warming = warmCameras().finally(() => (warming = null));\n    },\n    hold: () => started.playing,\n    cap: () => input.touch?.active ?? false,\n    onError: (error) => fail(error, 'APP_FRAME'),\n  });\n  parts.ready = true;\n  overlay.hide();\n  loop.start();\n  const replay = asked?.playback;\n  if (asked && !replay) fail(asked.error);\n  else if (replay) {\n    try {\n      started.begin(replay.replay);\n      playback = replay;\n    } catch (error) {\n      fail(error);\n    }\n  }\n  return engine;\n}\nengine/app/drawing.ts:6: * on the GPU, warming up again until one is), `warmCameras` (each camera warmed up through the chain under the shader\nengine/app/drawing.ts:7: * key now: both of the view's, so switching projection later builds nothing, or, with `gfx.warmUp: asked`, those\nengine/app/drawing.ts:23: * // const { drawing, frame, settle, warmCameras } = createPageDrawing(parts, { chrome, settings, onFrame });\nengine/app/drawing.ts:53: * The cameras a warm-up compiles for (`gfx.warmUp`, engine/gfx/warmup.ts): every one of the view's in `all`, else\nengine/app/drawing.ts:125:  warmCameras(): Promise<void>;\nengine/app/drawing.ts:161:  const warmCameras = async () => {\nengine/app/drawing.ts:207:      await warmCameras().catch(() => undefined);\nengine/app/drawing.ts:234:        await warmCameras();\nengine/app/drawing.ts:249:  return { drawing, frame, settle, warmCameras };\n      const view = viewNow().frame({ alpha: 1, dt: 0, aspect: aspect() });\n      keepWidth(view.camera, aspect());\n      if (warmsAsked(settings) && !warmedAt.has(view.camera)) {\n        drawn.add(view.camera);\n        await warmCameras();\n      }\n      return shotForJson(await shot(parts.gfx!, through(view), shotOptions));\n    },\n    async draw() {\n      const gfx = parts.gfx;\n      if (!gfx) return;\n      if (!frame(1, 1 / 60).drawn) await settle(1, 1 / 60);\n      if (++draws % DRAWING.drain === 0) await gfx.device.queue.onSubmittedWorkDone();\n    },\n    setView(path: string, value: SettingValue) {\n      parts.run!.session.set(path, value);\n    },\n    counts: () => parts.gfx?.stats() ?? null,\n  };\n  return { drawing, frame, settle, warmCameras };\n}\n  blendRagdollPoses(ragdoll.before, ragdoll.after, alpha, layer.poses);\n  const rising = ragdoll.rising >= 0;\n  const t = ((rising ? ragdoll.rising : ragdoll.age) + alpha) * dt;\n  layer.weight = rising ? Math.max(0, 1 - t / RAGDOLL_FADE.out) : Math.min(1, t / RAGDOLL_FADE.in);\n}\n\n/** The body every animated actor wears (engine/gfx/puppets/bodies/humanoid.ts). */\nexport const ACTOR_BODY = 'body:humanoid';\n\n/** A puppet's part of the warm-up's key: its build, and its body when not `ACTOR_BODY`. */\nconst worn = (build: string, body = ACTOR_BODY) => (body === ACTOR_BODY ? build : `${build}+${body}`);\n\n/** The player actor as the last draw put it. */\nexport interface PlayerView {\n  readonly id: number;\n  /** Its feet, m. */\n  readonly feet: Vec3;\n  /** With a puppet: its skeleton and world pose, and its eye (the head socket), m. */\n  readonly posed: { readonly skeleton: Skeleton; readonly world: WorldPose; readonly eye: Vec3 } | null;\n}\n\n/** Actors drawn as puppets (see the file comment). */\nexport interface ActorPuppets {\n  /** Every puppet, under one group. */\n  readonly root: Group;\n  /** The puppets, by entity id: each `actor#<id>` with `userData.entity`; the player's `userData.protagonist`, \"the hero\" to engine/gfx/idpass.ts. */ // prettier-ignore\n  readonly puppets: ReadonlyMap<number, Puppet>;\n  /**\n   * Reads the actors after a sim step (the sim's step `dt`, s) and the sim's read-only `queries`, whose ground the feet\n   * stand on (null without physics: a flat floor at each actor's feet); returns the ids it draws as puppets.\n   */\n  capture(entities: Iterable<EntityData>, dt?: number, queries?: QueryView | null): ReadonlySet<number>;\n  /** Poses every puppet `alpha` (0 to 1) of the way from its place a step ago to its last. */\n  draw(alpha: number): void;\n  /** The first player actor at the last draw, or null. */\n  player(): PlayerView | null;\n  /** Whether the last capture held a player actor. */\n  hasPlayer(): boolean;\n  /** Each puppet's trail as its last pose sampled it, by entity id (its animator's: oldest first, empty for none). */\n  trails(): ReadonlyMap<number, readonly TrailSample[]>;\n  /** The view's layers on each puppet's animator, by entity id: its `Reactions` and `Secondary`, when it has them, and its ragdoll's. */ // prettier-ignore\n  layers(): ReadonlyMap<number, { readonly reactions: Reactions | null; readonly secondary: Secondary | null; readonly ragdoll: RagdollLayer }>; // prettier-ignore\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n","exit_code":0,"status":"completed"}}
