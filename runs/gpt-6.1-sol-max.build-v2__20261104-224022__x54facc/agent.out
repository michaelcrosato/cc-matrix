{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface ClipPlay|fade|additive|speed' engine/anim/clip/layer.ts | head -40; rg -n 'export interface SceneSpec|terrain:' engine/sim/scene.ts engine/app/view*.ts; sed -n '60,97p' engine/sim/scene.ts; rg -n 'export type Intents|export interface Intents' engine/input/*.ts; rg -n 'chase|makePose|lookAt|followCamera|defineCamera' engine/index.ts | head -30; head -75 engine/anim/proc/api.ts\"","aggregated_output":"4: * full-body clip covers the clips under it: they play on until it is fully in, and fade out with it, by the same\n6: * masked or additive one lies over them, and they play on under it and after it. `locomote` picks an idle, a walk or\n7: * a run by ground speed, each loop at the character's ground speed (library.ts `walkRate`, `runOverWalk`).\n9: * Each play takes my-3d2dge's moment fields (`my-3d2dge:src/emberdeep/96-hero-clips.js`, `HCL_MOVES`): `speed`,\n10: * `fade` and `out`, a bone `mask` ('upper': the legs keep the body's own), `loop`, `additive` (the clip's change from\n13: * an action takes the body back at once (0.07 s); moving over 1.25 m/s, or a flinch, fades a clip without `walk`.\n15: * The two update paths (§6.4), as the animator's: `step` is the sim's, one fixed tick (times, fades, the walk–run\n21: * Invariants: `apply` writes only the pose (the animator fades the layer by its `weight` and runs FK); a slot's weight\n38: * clips.current?.w; // 1: faded in over 0.12 s\n63:const covers = (s: ClipSlot) => !s.play.additive && (!s.play.mask || s.play.mask === 'full');\n67:/** The fade out of `s`: `fade`, else its `out`. */\n68:const outOf = (s: ClipSlot, fade?: number) => Math.max(1e-6, fade ?? s.play.out ?? CLIP_LAYER.out);\n73:  /** The animator fades the whole layer by it. */\n133:   * Fades out the top clip not already fading, over `fade` seconds (its `out`), with the clips it covers: what lies\n136:  stop(fade?: number): this {\n139:    if (c) c.stopping = outOf(c, fade);\n143:  /** Plays `idle` below 0.1 m/s, else `walk`, or `run` past the switch, each at ground speed; null stops it. */\n166:    let [fade, covered, rooted] = [0, false, false];\n168:      if (fade && !s.stopping && !(s.loco && st.moving)) s.stopping = fade;\n171:      [covered, rooted, fade] = [covered || (whole && !s.stopping), rooted || whole, fade || (whole ? s.stopping : 0)];\n173:    // gone: the slots faded out, and every slot under a full-body clip fully in\n196:      if (!slot.play.additive) blendPoses(body.pose, clipPose, smooth(slot.w), body.pose, { mask });\n204:  /** The layer as plain JSON: each slot, bottom first, the locomotion loops, the ground speed, the root motion. */\n225:    const w = (play.fade ?? CLIP_LAYER.fade) > 0 ? 0 : 1;\n246:    // the loops not wanted fade out; the one wanted plays on, or starts under the clips laid over the top\n252:    this.#start(clip, { fade: CLIP_LAYER.loco }, true, at);\n255:  /** One tick of `slot`: its rate, time and fade; its events and end when `live` and not stopping, travel at `root`. */\n260:    slot.rate = (slot.play.speed ?? 1) * (pace ? walkRate(pace, this.state.ground) : 1);\n273:    // fades step linearly, and snap to their ends (sixths of a second do not add up to 1 in floats)\n274:    const step = this.dt / (slot.stopping || Math.max(1e-6, slot.play.fade ?? CLIP_LAYER.fade));\nengine/sim/scene.ts:79:export interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\nengine/sim/scene.ts:84:  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\nengine/sim/scene.ts:111:  terrain: { type: 'string', description: 'Its terrain (terrain:<name>, WP 10.5), when it has one.' },\n\n/** A dev action of a scene: runs between steps inside `w.run`, with plain-data `args`; recorded in replays. */\nexport type SceneAction<W> = (w: W, args: unknown) => void;\n\n/** A sound a sim event plays: an `sfx` entry, its gain (1 by default) and its variant (the effect's next by default). */\nexport interface SceneSound {\n  readonly sfx: string;\n  readonly vol?: number;\n  readonly variant?: number;\n}\n\n/** The sound a traced event names in its payload, `{ sfx, vol?, variant? }`, or null: a scene's default `sounds`. */\nexport function payloadSound(record: TraceRecord): SceneSound | null {\n  const payload = record.payload;\n  if (!isPlainObject(payload) || payload.sfx === undefined) return null;\n  return { sfx: payload.sfx, vol: payload.vol, variant: payload.variant } as SceneSound;\n}\n\n/** How a scene is written: `defineScene(id, spec)`. */\nexport interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  /** What the scene shows or tests, in plain sentences. */\n  description?: string;\n  /** The level it loads (`level:<name>`), when it has one (WP 2.2). */\n  level?: string;\n  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\n  terrain?: string;\n  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\n  site?: string;\n  /** Whether it has a physics world (WP 3.1): `physicsOf(w)` reaches it, the system `physics` steps it. */\n  physics?: boolean;\n  /** Setting values for its lifetime, path → value (schema-checked). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Runs once when it starts: spawns, systems, listeners. */\n  setup: (w: World<C, E>) => void;\n  /** Runs every step, first in the phase `intents`: reads the step's intents and components, writes components. */\n  step?: (w: World<C, E>, intents: Intents) => void;\n  /** Its dev actions, by name. */\n  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\nengine/input/intents.ts:58:export type Intents = {\n/**\n * @file The procedural rigs' part of the public sim API (PLAN.md §6.1, WP 10.1): the building blocks a creature beyond\n * the humanoid is made of (springs, eased weights and the pose stack, the digitigrade leg, sway chains and lagging\n * parts, the planted gait for N legs, path chains, looking and blinking, hovering, orbiters and detached parts, pose\n * history, extras on sockets, tip trails, the measured reach) and the contract its rig meets and is checked by,\n * re-exported whole by engine/sim-api.ts, so that file stays under its line cap, as engine/sim/kitsApi.ts does. Game\n * code imports these names from engine/sim-api.ts (or engine/index.ts), never from here: the public-API rule rejects\n * any other engine path. The verlet strand is engine/anim/chain.ts's `Chain` (WP 6.2), exported with the animator.\n *\n * Invariants: the same as engine/sim-api.ts's: a flat list of `export … from` lines, one name per line, grouped by\n * area and append-only. Only engine/anim/ modules are re-exported, and each name is documented where it is declared.\n *\n * @example\n * // fixtures/rigs/hexapod/index.ts\n * // import { LegGait, LagPart, rigCheck, type ProcRig } from '../../../engine/sim-api';\n * @see engine/sim-api.ts\n */\n\n// Springs and blends (WP 10.1): numbers, vectors and turns on exact damped springs with kicks; named weights eased up\n// and down; the pose stack, angles averaged round the circle, a pitch and a yaw as a direction.\nexport { Spring1 } from './springs';\nexport { Spring3 } from './springs';\nexport { SpringQuat } from './springs';\nexport type { SpringOptions } from './springs';\nexport { StateWeights } from './blend';\nexport type { BlendRates } from './blend';\nexport { layerPose } from './blend';\nexport type { PoseLayer } from './blend';\nexport { blendAngles } from './blend';\nexport { aimDirection } from './blend';\n// Legs and bodies (WP 10.1): the digitigrade leg's reverse knee; sway chains and lagging parts; the planted gait for N\n// legs in groups, its feet on raycast ground or gripping walls; path chains following their head.\nexport { digitigrade } from './digitigrade';\nexport type { DigitigradeLeg } from './digitigrade';\nexport type { DigitigradeFrame } from './digitigrade';\nexport type { DigitigradeSolve } from './digitigrade';\nexport { SwayChain } from './sway';\nexport type { SwayOptions } from './sway';\nexport { LagPart } from './sway';\nexport type { LagOptions } from './sway';\nexport { LegGait } from './gait';\nexport type { GaitLeg } from './gait';\nexport type { GaitOptions } from './gait';\nexport type { GaitFoot } from './gait';\nexport type { GaitProbe } from './gait';\nexport type { GaitBody } from './gait';\nexport { PathChain } from './path';\nexport type { PathOptions } from './path';\n// Faces and floating parts (WP 10.1): looking within bounds and blinking from a named stream; hovering, banking,\n// leaning and folding; orbiters and detached parts; pose history played back late; extras on sockets; tip trails.\nexport { LookAt } from './look';\nexport type { LookAtOptions } from './look';\nexport { Blink } from './look';\nexport type { BlinkOptions } from './look';\nexport { Hover } from './hover';\nexport type { HoveringOptions } from './hover';\nexport { Orbiters } from './orbit';\nexport type { OrbitOptions } from './orbit';\nexport { DetachedPart } from './orbit';\nexport type { DetachedOptions } from './orbit';\nexport { PoseHistory } from './history';\nexport type { HistoryOptions } from './history';\nexport { socketMatrix } from './sockets';\nexport { placeExtras } from './sockets';\nexport { along } from './sockets';\nexport { alongDirection } from './sockets';\nexport type { Socket } from './sockets';\nexport type { SocketJoints } from './sockets';\nexport { TipTrail } from './trails';\nexport type { TrailOptions } from './trails';\nexport type { TipSample } from './trails';\n// Reach and the rig contract (WP 10.1): an attack's reach measured off its animation; what a procedural rig names\n// (its points, bones, feet and states) and the check it passes, as anim.check holds the humanoid.\nexport { measureReach } from './reach';\nexport type { ReachPose } from './reach';\n","exit_code":0,"status":"completed"}}
