floor(r.tick/interval)+i)*interval,\\\")\ns=s.replace('const left = 20 + i * 16 - ((r.tick % 32) / 32) * 16;', 'const left=20+(tick-r.tick)/interval*16;')\np.write_text(s)\np=Path('labs/game/ui/screens/programme.ts');s=p.read_text().replace(\\\"import type { ScreenApp }\\\", \\\"import {EVENING} from '../lines/cast';\\\\nimport type { ScreenApp }\\\").replace(\\\"'Today you wobbled less than you might have. Goodnight.'\\\", \\\"EVENING[Math.min(4,f.day-1)]\\\")\ns=s.replace(\\\"  const list = ACTIVITIES.slice(page * 5, page * 5 + 5),\\\\n    f = a.flow ?? a.save;\\\", \\\"  const f=a.flow??a.save;\\\\n  const met=new Set(DAYS.slice(0,Math.min(5,f.day)).flatMap(d=>d.events));met.add('group');\\\\n  const available=f.complete?ACTIVITIES:ACTIVITIES.filter(event=>met.has(event.id));\\\\n  const pages=Math.ceil(available.length/5);page=((page%pages)+pages)%pages;\\\\n  const list=available.slice(page*5,page*5+5);\\\")\ns=s.replace('page + 1} / 3', 'page + 1} / \"'${pages}'\"').replace(\\\"a.show('board', (page + 1) % 3)\\\", \\\"a.show('board',(page+1)%pages)\\\")\np.write_text(s)\nPY\ncat > labs/game/props/finale.ts <<'EOF'\n/** @file Counterweight carts, rails and the lighthouse's sweeping storm beam. */\nimport {box,cone,prop} from './kit';\nprop('counterCart',[box('tray',[0,.45,0],[1.8,.35,2.4],'#b4c7ad'),...[-.8,.8].flatMap((x)=>[-.8,.8].map((z)=>({...cone(\"'`wheel${x}${z}`,[x,.22,z],.26,.26,.12,'\"'#687b69',12),rotation:[0,0,Math.PI/2]}))),...Array.from({length:6},(_,i)=>box(\"'`stone${i}`,[(i%2-.5)*.55,.8+Math.floor(i/2)*.17,0],[.7,.23,.8],'\"'#d5c7a5',.1))]);\nprop('counterRails',[-.8,.8].map((x)=>box(\"'`rail${x}`,[x,0,0],[.08,.08,20],'\"'#9cae99')));\nprop('beacon',[{name:'beam',geometry:'geometry:frustum',params:{radiusBottom:.06,radiusTop:7,height:100,radialSegments:16},material:'material:retreatBeam',rotation:[Math.PI/2,0,0],shadow:false}]);\nEOF\ncat >> labs/game/props/retreat.ts <<'EOF'\nimport './finale';\nEOF\ncat >> labs/game/looks/retreat.ts <<'EOF'\ndefineMaterial('material:retreatBeam',{color:'#ffefb3',unlit:true,transparent:true,opacity:.12,depthWrite:false});\ndefineLook('look:retreatSession',{description:'A clear, quick-to-prepare pavilion for the shared class.',sky:'sky:retreat',style:'toon'});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"  put(w, 'lighthouse', 84, -60);\\\", \\\"  put(w, 'lighthouse', 84, -60);\\\\n  put(w,'beacon',84,-60,heightAt(84,-60)+14);\\\");p.write_text(s)\np=Path('labs/game/scenes/ambience.ts');s=p.read_text();s=s.replace(\\\"import { placeActor, type World }\\\", \\\"import { placeActor, type World }\\\")\ns=s.replace(\\\"  const r = f.event;\\\", \\\"  const r = f.event;\\\\n  if(\"'!f.roundOnly)for(const e of w.query('\"'sceneProp'))if(e.sceneProp.prop==='prop:beacon'){const a=w.tick/140;e.sceneProp.q=[0,Math.sin(a/2),0,Math.cos(a/2)];}\\\\n  if(f.mode==='event' && r.id==='line' && tare){tare.x=-62;tare.z=42+r.progress;tare.y=2.25+Math.abs(Math.sin(w.tick/18))*.1;const board=w.get(f.props[0])?.sceneProp;if(board)board.z=tare.z;}\\\\n  if(f.mode==='event' && r.id==='pond'){if(r.tick>1440 && f.props.length===0)f.props.push(put(w,'frog',-69.65,-11.6,4.65));if(r.tick>1920 && f.props.length<2)f.props.push(put(w,'gull',-70,-12,5.4));}\\\\n  if(f.mode==='event' && r.id==='tilt' && r.phase===2){if(f.props.length===0){f.props.push(put(w,'counterRails',58,12),put(w,'counterRails',64,12),put(w,'counterCart',58,5),put(w,'counterCart',64,5));}for(const id of f.props.slice(2)){const prop=w.get(id)?.sceneProp;if(prop)prop.z=5+Math.min(1,r.count/80)*14;}}\\\")\np.write_text(s)\np=Path('labs/game/scenes/events/tilt.ts');s=p.read_text().replace(\\\"r.tilt = Math.max(2, r.tilt - 0.015);\\\", \\\"{r.tilt = Math.max(2, r.tilt - 0.015);r.count++;}\\\")\np.write_text(s)\np=Path('labs/game/app.ts');s=p.read_text().replace(\\\"        topple: 'splash',\\\", \\\"        topple: 'splash',\\\\n        diveSplash:'splash',\\\")\ns=s.repl