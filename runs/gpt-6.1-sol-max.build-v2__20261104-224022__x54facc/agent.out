{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"rg -n 'SECONDARY_FIELDS|hair:' engine/sim/reactions.ts | head -20; sed -n '85,117p' engine/sim/reactions.ts; sed -n '90,118p' labs/game/scenes/events/motion.ts; tail -25 out/game/browser.log; sed -n '125,158p' labs/game/scenes/pilot.ts; rg -n 'poseGuest\\\\(' labs/game/scenes/pilot.ts | head -10\"","aggregated_output":"12: * - **`secondary`** (`SECONDARY_FIELDS`): the secondary motion the view hangs on an actor's puppet (engine/anim/\n74:export const SECONDARY_FIELDS = defineSchema({\n75:  hair: {\n88:  hair: '' | 'long' | 'ponytail';\n104:  defineComponent('secondary', { description: secondary, fields: SECONDARY_FIELDS }, registry);\n\n/** The component `secondary`: the secondary motion the view hangs on an actor's puppet. */\nexport interface SecondaryComponent {\n  hair: '' | 'long' | 'ponytail';\n  cape: boolean;\n  tail: boolean;\n  color: string;\n}\n\n/** The components this module declares. */\nexport type ReactionComponents = { reactions: ReactionState; secondary: SecondaryComponent };\n\n/** Declares the components `reactions` and `secondary` on `registry` (the shared one by default), once. */\nexport function defineReactionKinds(registry: Registry = sharedRegistry): void {\n  if (registry.kinds().includes('component') && registry.has('component', 'reactions')) return;\n  const reactions =\n    'A body’s reactions (engine/anim/reactions.ts): its flinch, and the knockdown, death or get-up playing.';\n  defineComponent('reactions', { description: reactions, fields: REACTION_FIELDS }, registry);\n  const secondary = 'The secondary motion (hair, a cape, a tail) the view hangs on an actor’s puppet, and its colour.';\n  defineComponent('secondary', { description: secondary, fields: SECONDARY_FIELDS }, registry);\n}\ndefineReactionKinds();\n\n/** Scratch reactions, one per step length: loaded from a component at every call, so they keep nothing. */\nconst scratch = new Map<number, Reactions>();\nconst reactionsAt = (dt: number) => {\n  let reactions = scratch.get(dt);\n  if (!reactions) scratch.set(dt, (reactions = new Reactions({ dt })));\n  return reactions;\n};\nconst NONE: ReactionBody = Object.freeze({});\n\n/**\n    ring: 0.28,\n    title: 'The Pace Ribbon',\n    instruction: 'Stay near Gerald. Alternate feet to find his pace.',\n    pose: 'Jog',\n    foot: 0,\n  };\n}\nexport function rhythmNote(\n  r: ActivityRun,\n  c: EventConfig,\n  tick = r.tick,\n): { note: string; beat: number; delta: number } {\n  const part = Math.max(0, Math.min(2, Math.floor(tick / 2004))),\n    bpm = BPMS[part] * c.get('step.bpm');\n  const interval = 3600 / bpm;\n  const beat = Math.round(tick / interval),\n    delta = tick - beat * interval;\n  const chart = CHARTS[part].split(' ');\n  return { note: chart[((beat % chart.length) + chart.length) % chart.length], beat, delta };\n}\nexport function stepMotion(r: ActivityRun, w: Wobble, input: Lean, c: EventConfig): void {\n  if (r.id === 'reps') r.phase = Math.min(2, Math.floor(r.tick / 1800));\n  if (r.id === 'dive') r.phase = Math.floor(((r.tick / 60) % 18) / 6);\n  const g = motionGuide(r, c),\n    left = input.l > 0.5,\n    right = input.r > 0.5;\n  const tapL = left && !r.lastL,\n    tapR = right && !r.lastR;\n  const tap = tapL || tapR,\n  if (r.id === 'hoop') progress = (((r.angle / (Math.PI * 2)) % 1) + 1) % 1;\n  if (r.id === 'dive') progress = clamp(((r.tick % 1080) - 720) / 360, 0, 1);\n  if (r.id === 'paddle' || r.id === 'line' || r.id === 'jog') progress = 0.5 + 0.5 * Math.sin(r.tick / 15);\n  const wobble = r.id === 'group' ? r.seats[0] : f.wobble;\n  if (r.id === 'group') pose = guideFor(r.children[0], c).pose;\n  poseGuest(w, f.hero, pose, progress, wobble);\n  poseGuest(\n    w,\n    f.plumb,\n    r.id === 'pose' || r.id === 'group' ? pose : 'Stand',\n    r.id === 'pose' || r.id === 'group' ? 1 : 0,\n    { ...f.wobble, x: 0, y: 0 },\n  );\n  f.others.forEach((id, n) => {\n    const e = w.get(id),\n      ghost = e?.ghost;\n    const wob =\n      r.id === 'group'\n        ? r.seats[n + 1]\n        : { ...f.wobble, x: Math.sin(r.tick / 80 + n) * 0.1, y: Math.cos(r.tick / 90 + n) * 0.08 };\n    poseGuest(w, id, pose, 1, ghost?.active ? { ...wob, x: ghost.x, y: ghost.y } : wob);\n  });\n  const a = activity(r.id);\n  if (r.id === 'paddle') {\n    const angle = (r.progress / 96) * Math.PI * 2;\n    const x = -57 + Math.cos(angle) * 22,\n      z = 92 + Math.sin(angle) * 12;\n    placeActor(w, f.hero, [x, 2.25, z], -angle);\n    const board = w.get(f.props[0]);\n    if (board?.sceneProp) {\n      board.sceneProp.x = x;\n      board.sceneProp.z = z;\n    }\n  }\n112:  poseGuest(w, f.hero, 'Stand', 0, f.wobble);\n130:  poseGuest(w, f.hero, pose, progress, wobble);\n131:  poseGuest(\n145:    poseGuest(w, id, pose, 1, ghost?.active ? { ...wob, x: ghost.x, y: ghost.y } : wob);\n189:    poseGuest(w, f.hero, 'Nothing', 1, f.wobble);\n209:    poseGuest(w, f.hero, f.mode === 'credits' ? 'Heron' : 'Heron', 1, {\n213:    poseGuest(w, f.plumb, 'Nothing', 1, { ...f.wobble, x: 0, y: 0 });\n","exit_code":0,"status":"completed"}}
