s` does, and `APP_NO_LEVEL`. */\nengine/app/headless.ts:177:  const firstSeed = checkSeed(options.seed, 'createHeadless({ seed })');\nengine/app/headless.ts:346:export async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\nengine/app/view.ts:3: * without a GPU, so a page draws it and `createHeadless({ view: true })` dumps it in Node. `createRunView` makes the\nengine/app/view.ts:74:    fix: 'start it with createHeadless({ scene, view: true }) in Node; a page always has one',\n","exit_code":0,"status":"completed"}}
