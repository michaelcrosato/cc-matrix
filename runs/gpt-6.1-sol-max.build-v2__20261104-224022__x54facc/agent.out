{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'cat tools/game/new-game.mjs'","aggregated_output":"#!/usr/bin/env node\n/**\n * @file Makes a game from the my-3dge engine, and moves a game to a newer engine (PLAN.md WP 10.7, ADR-0024): the\n * one command an agent runs to start a game. Plain JavaScript for any Node from 18 with nothing installed, since it\n * runs straight after `git clone`, before setup. What a game gets, and whose each file is, is tools/game/files.mjs.\n *\n * Create: `node <engine>/tools/game/new-game.mjs <dir> [--name <name>]` writes a game into <dir> (made if missing;\n * an empty folder, or a fresh repository's root): the engine's files, copied as they are and pinned by\n * engine-lock.json; the starter game, labs/game/; the game's root files from tools/game/template/ (`TEMPLATES`); and\n * package.json and package-lock.json with the engine's pins (`gamePackage`, `gameLockfile`, from tools/game/files.mjs).\n * Then `git init` when the folder is in no repository. It never overwrites: a README.md or LICENSE already there is\n * kept, a .gitignore gains the lines it lacks, an AGENTS.md, CLAUDE.md or GEMINI.md gets the game's after its own\n * text, and any other file in the way stops it before it writes anything.\n *\n * Update: `node <newer engine>/tools/game/new-game.mjs --update <dir>` (what `node x engine --update` runs) puts this\n * checkout's engine files in place of the game's, removes those it dropped, moves package.json to its pins, brings\n * the root files the game never edited to its templates (`refreshTemplates`) and writes the new lock. Nothing of the\n * game's is replaced or removed: it stops, having written nothing, on an engine file the game changed without\n * declaring it under \"Local engine patches\" in ENGINE-FEEDBACK.md (a declared one is kept), on a file of the game's\n * where the newer engine adds one, and on a package.json entry of the game's that the newer engine sets otherwise\n * (`npmClashes`); `--force` lets the engine's replace them. It names the package.json entries it drops, or sets back\n * where the game had edited the engine's (`npmLost`): the engine's pins win, as its files do.\n *\n * `--verify <dir>` prints `verifyGame` (tools/game/files.mjs) as JSON. Exit codes: 0 done, 1 stopped (the message says\n * why and what to do), 2 a usage error.\n *\n * @example\n * // node /tmp/my-3dge/tools/game/new-game.mjs ../dragon-run → a game in ../dragon-run, named dragon-run\n * // node /tmp/my-3dge/tools/game/new-game.mjs . --name dragon-run → in the current folder (a fresh repository)\n * // node /tmp/my-3dge-new/tools/game/new-game.mjs --update . → the game in . on the newer engine\n * gameName('/tmp/Dragon Run!'); // 'dragon-run'\n * render('# {{name}}', { name: 'dragon-run' }); // '# dragon-run'\n * @see tools/game/new-game.test.ts\n */\nimport { execFileSync } from 'node:child_process';\nimport { copyFileSync, existsSync, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';\nimport { basename, dirname, join, relative, resolve, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport {\n  engineIdentity,\n  FEEDBACK_FILE,\n  gameLockfile,\n  gamePackage,\n  hashFile,\n  hashText,\n  LOCK_FILE,\n  lockFor,\n  npmClashes,\n  npmLost,\n  plan,\n  sameDependencies,\n  SOURCE,\n  verifyGame,\n} from './files.mjs';\n\nexport { gameLockfile, gamePackage, npmClashes };\n\n/** The game's root files: template (in tools/game/template/) → where it goes. */\nexport const TEMPLATES = Object.freeze([\n  ['AGENTS.md.tmpl', 'AGENTS.md'],\n  ['CLAUDE.md.tmpl', 'CLAUDE.md'],\n  ['GEMINI.md.tmpl', 'GEMINI.md'],\n  ['README.md.tmpl', 'README.md'],\n  ['ENGINE-FEEDBACK.md.tmpl', FEEDBACK_FILE],\n  ['gitignore.tmpl', '.gitignore'],\n  ['index.html.tmpl', 'index.html'],\n  ['claude-settings.json.tmpl', '.claude/settings.json'],\n]);\n\n/** Files a target may hold: a README.md or LICENSE is kept; a .gitignore gains the template's lines it lacks. */\nconst KEPT = new Set(['README.md', 'LICENSE', '.gitignore', 'AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n\n/** Instruction files the agents read: one already there keeps its text, and the game's follows it (`appendOnce`). */\nconst APPENDED = new Set(['AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n\n/** A game's name: an npm package name, from the folder's name by default (`Dragon Run!` → `dragon-run`). */\nexport function gameName(target, name) {\n  const folder = basename(resolve(target)).toLowerCase();\n  const chosen = name ?? folder.replace(/[^a-z0-9._-]+/g, '-').replace(/^[-._]+|[-._]+$/g, '');\n  if (!/^[a-z0-9][a-z0-9._-]{0,213}$/.test(chosen)) {\n    throw new Error(`\"${chosen}\" cannot name a game: give --name with lower-case letters, digits, '-', '.' or '_'`);\n  }\n  return chosen;\n}\n\n/** Fills a template's `{{name}}` and `{{engine.*}}`; any other placeholder is an error. */\nexport function render(text, values) {\n  return text.replace(/\\{\\{([a-z.]+)\\}\\}/g, (whole, key) => {\n    if (key in values) return values[key];\n    throw new Error(`the template's ${whole} has no value: new-game.mjs fills ${Object.keys(values).join(', ')}`);\n  });\n}\n\n/** The values of the templates' placeholders for the game `game` on the engine `identity`. */\nfunction templateValues(game, identity) {\n  return {\n    name: game,\n    'engine.repository': identity.repository,\n    'engine.commit': identity.commit,\n    'engine.short': identity.commit.slice(0, 7),\n    'engine.date': identity.date,\n  };\n}\n\n/** A template's text in the engine at `source`. */\nconst templateText = (source, template) => readFileSync(join(source, 'tools/game/template', template), 'utf8');\n\n/** Reads a JSON file. */\nconst readJson = (file) => JSON.parse(readFileSync(file, 'utf8'));\n\n/** Writes JSON with two spaces and a final newline (what Prettier keeps). */\nfunction writeJson(file, value) {\n  mkdirSync(dirname(file), { recursive: true });\n  writeFileSync(file, `${JSON.stringify(value, null, 2)}\\n`);\n}\n\n/** What writing `to` under `root` meets, if anything: the file itself, or a file where one of its folders goes. */\nfunction inTheWay(root, to) {\n  const parts = to.split('/');\n  for (let i = 1; i <= parts.length; i++) {\n    const path = join(root, ...parts.slice(0, i));\n    if (existsSync(path) && (i === parts.length || !statSync(path).isDirectory())) return path;\n  }\n  return undefined;\n}\n\n/** Copies one file, making its folder. */\nfunction copyInto(source, from, root, to) {\n  mkdirSync(dirname(join(root, to)), { recursive: true });\n  copyFileSync(join(source, from), join(root, to));\n}\n\n/** Makes a game in `target` from the engine at `source`; on a clash it throws, having written nothing. */\nexport function createGame({ target, name, source = SOURCE, git = true }) {\n  const root = resolve(target);\n  if (existsSync(root) && !statSync(root).isDirectory()) throw new Error(`${root} is a file: name a folder`);\n  const game = gameName(root, name);\n  const identity = engineIdentity(source);\n  const items = plan(source);\n  const writes = [\n    ...items.map((item) => item.to),\n    ...TEMPLATES.map(([, to]) => to),\n    'package.json',\n    'package-lock.json',\n  ];\n  const clashes = [...writes, LOCK_FILE].filter((to) => !KEPT.has(to) && inTheWay(root, to));\n  if (clashes.length > 0) {\n    const named = clashes.slice(0, 5).join(', ') + (clashes.length > 5 ? ` and ${clashes.length - 5} more` : '');\n    throw new Error(\n      `${root} already holds ${named}: make the game in an empty folder or a fresh repository's root (a README.md, ` +\n        'LICENSE or .gitignore may be there), or move a game to a newer engine with --update',\n    );\n  }\n  for (const { from, to } of items) copyInto(source, from, root, to);\n  const values = templateValues(game, identity);\n  const kept = [];\n  const templates = {};\n  for (const [template, to] of TEMPLATES) {\n    const text = render(templateText(source, template), values);\n    const file = join(root, to);\n    templates[to] = existsSync(file) ? null : hashText(text);\n    if (to === '.gitignore' && existsSync(file)) mergeLines(file, text);\n    else if (APPENDED.has(to) && existsSync(file)) appendOnce(file, text);\n    else if (existsSync(file)) kept.push(to);\n    else {\n      mkdirSync(dirname(file), { recursive: true });\n      writeFileSync(file, text);\n    }\n  }\n  const engine = readJson(join(source, 'package.json'));\n  writeJson(join(root, 'package.json'), gamePackage(engine, game));\n  writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), game));\n  const engineItems = items.filter((item) => item.owner === 'engine');\n  writeJson(join(root, LOCK_FILE), lockFor(source, engineItems, identity, game, engine, templates));\n  const initialized = git && initRepository(root);\n  const starterFiles = items.length - engineItems.length;\n  return { root, name: game, identity, engineFiles: engineItems.length, starterFiles, kept, initialized };\n}\n\n/**\n * Moves the game in `target` to the engine at `source`; returns what changed. Throws, having written nothing, on\n * anything of the game's the update would replace (the file comment says what), unless `force`.\n */\nexport function updateGame({ target, source = SOURCE, force = false }) {\n  const root = resolve(target);\n  const before = verifyGame(root);\n  if (before.undeclared.length > 0 && !force) throw new Error(undeclaredMessage(before));\n  const patched = [...before.changed, ...before.missing, ...before.added];\n  const keep = new Set(force ? [] : before.declared.filter((path) => patched.includes(path)));\n  const identity = engineIdentity(source);\n  const items = plan(source).filter((item) => item.owner === 'engine');\n  const old = before.lock.files;\n  const added = items.filter((item) => !(item.to in old)).map((item) => item.to);\n  const blocked = added.filter((path) => !keep.has(path) && inTheWay(root, path));\n  const engine = readJson(join(source, 'package.json'));\n  const previous = readJson(join(root, 'package.json'));\n  const clashes = npmClashes(previous, engine, before.lock.npm);\n  if (blocked.length + clashes.length > 0 && !force) throw new Error(clashMessage(blocked, clashes));\n  const next = new Set(items.map((item) => item.to));\n  const removed = Object.keys(old).filter((path) => !next.has(path) && !keep.has(path));\n  for (const path of removed) rmSync(join(root, path), { force: true });\n  for (const way of blocked.map((path) => inTheWay(root, path))) if (way) rmSync(way, { recursive: true, force: true });\n  const replaced = items\n    .filter((item) => item.to in old && !keep.has(item.to) && old[item.to] !== hashFile(join(source, item.from)))\n    .map((item) => item.to);\n  for (const { from, to } of items) if (!keep.has(to)) copyInto(source, from, root, to);\n  const pkg = gamePackage(engine, previous.name, previous, before.lock.npm);\n  writeJson(join(root, 'package.json'), pkg);\n  const npm = npmLost(previous, pkg, before.lock.npm);\n  const lockfileFits = sameDependencies(pkg, engine);\n  if (lockfileFits) {\n    writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), pkg.name));\n  }\n  const { templates, refreshed, diverged } = refreshTemplates(root, source, before.lock, identity);\n  writeJson(join(root, LOCK_FILE), lockFor(source, items, identity, before.lock.game, engine, templates));\n  const forced = [...blocked, ...clashes];\n  return { root, from: before.lock.engine, to: identity, added, removed, replaced, kept: [...keep], forced, npm, refreshed, diverged, lockfileFits }; // prettier-ignore\n}\n\n/** Why an update stops on engine files the game changed or added without declaring them, with the fixes. */\nfunction undeclaredMessage({ undeclared, added }) {\n  const declare = `list it under \"Local engine patches\" in ${FEEDBACK_FILE} to keep it`;\n  const edited = undeclared.filter((path) => !added.includes(path));\n  const own = undeclared.filter((path) => added.includes(path));\n  return [\n    edited.length > 0 &&\n      `the game changed engine files it does not declare: ${edited.join(', ')}. Undo each (git checkout -- <path>), ${declare}, or pass --force to replace it`, // prettier-ignore\n    own.length > 0 &&\n      `the game added files in the engine's folders: ${own.join(', ')}. Move each into labs/game/ (or delete it), or ${declare}`, // prettier-ignore\n  ]\n    .filter(Boolean)\n    .join('; ');\n}\n\n/** Why an update stops on the game's own files and package.json entries where the newer engine has its own. */\nfunction clashMessage(blocked, clashes) {\n  const parts = [\n    blocked.length > 0 &&\n      `the newer engine adds ${blocked.join(', ')}, where the game has files of its own: move or rename them`,\n    clashes.length > 0 &&\n      `the newer engine sets ${clashes.join(', ')} in package.json, where the game has its own: rename the game's (a script), or drop it (a dependency: the engine's pin then serves)`, // prettier-ignore\n  ];\n  return `${parts.filter(Boolean).join('; ')}; or pass --force to let the engine's replace them`;\n}\n\n/**\n * Brings the game's root files to the templates of the engine at `source` (`lock` is the game's, `identity` the new\n * engine's). A file the game never edited (its hash is the lock's) gets the new template; one it edited is named when\n * its template changed, to compare by hand; one it removed, or had before new-game.mjs, stays as it is; a template new\n * to the game is written where no file is. Returns the lock's new `templates` and the paths refreshed and named.\n */\nfunction refreshTemplates(root, source, lock, identity) {\n  const was = lock.templates ?? {};\n  const [then, now] = [templateValues(lock.game, lock.engine), templateValues(lock.game, identity)];\n  const templates = {};\n  const refreshed = [];\n  const diverged = [];\n  for (const [template, to] of TEMPLATES) {\n    const file = join(root, to);\n    const text = templateText(source, template);\n    const fresh = render(text, now);\n    templates[to] = hashText(fresh);\n    if (!(to in was) && !existsSync(file)) {\n      mkdirSync(dirname(file), { recursive: true });\n      writeFileSync(file, fresh);\n      refreshed.push(to);\n    } else if (!(to in was) || was[to] === null || !existsSync(file)) templates[to] = null;\n    else if (hashFile(file) !== was[to]) {\n      if (hashText(render(text, then)) !== was[to]) diverged.push(to);\n    } else if (templates[to] !== was[to]) {\n      writeFileSync(file, fresh);\n      refreshed.push(to);\n    }\n  }\n  return { templates, refreshed, diverged };\n}\n\n/** Appends `text` after a file's own, once: a repository's instructions stay first, and the game's follow them. */\nfunction appendOnce(file, text) {\n  const had = readFileSync(file, 'utf8');\n  if (!had.includes(text.trim())) writeFileSync(file, `${had.replace(/\\n*$/, '\\n\\n')}${text}`);\n}\n\n/** Appends the template's lines a file lacks. */\nfunction mergeLines(file, text) {\n  const had = readFileSync(file, 'utf8');\n  const have = new Set(had.split('\\n'));\n  const lacking = text.split('\\n').filter((line) => line.trim() && !line.startsWith('#') && !have.has(line));\n  if (lacking.length > 0) writeFileSync(file, `${had.replace(/\\n?$/, '\\n')}${lacking.join('\\n')}\\n`);\n}\n\n/** Runs `git init` when `root` is in no repository and git is there; returns whether it did. */\nfunction initRepository(root) {\n  try {\n    execFileSync('git', ['-C', root, 'rev-parse', '--is-inside-work-tree'], { stdio: 'ignore' });\n    return false;\n  } catch {\n    try {\n      execFileSync('git', ['init', '--quiet', root], { stdio: 'ignore' });\n      return true;\n    } catch {\n      return false;\n    }\n  }\n}\n\n/** The command line; returns the exit code. */\nexport function main(argv = process.argv.slice(2), out = console.log, err = console.error) {\n  const usage = 'usage: node tools/game/new-game.mjs <dir> [--name <name>] | --update <dir> [--force] | --verify <dir>';\n  const named = argv.indexOf('--name');\n  const flags = argv.filter((arg) => arg.startsWith('--'));\n  const positional = argv.filter((arg, i) => !arg.startsWith('--') && (named < 0 || i !== named + 1));\n  const unknown = flags.find((flag) => !['--name', '--update', '--force', '--verify', '--help'].includes(flag));\n  if (flags.includes('--help')) return (out(usage), 0);\n  if (unknown || positional.length !== 1 || (named >= 0 && !argv[named + 1])) {\n    return (err(`new-game: ${unknown ? `unknown flag ${unknown}` : 'name one folder'}\\n${usage}`), 2);\n  }\n  const [target] = positional;\n  try {\n    if (flags.includes('--verify')) return (out(JSON.stringify(verifyGame(target), null, 2)), 0);\n    if (flags.includes('--update')) {\n      const done = updateGame({ target, force: flags.includes('--force') });\n      const patches = done.kept.length > 0 ? `, the local patches kept (${done.kept.join(', ')})` : '';\n      const counts = `${done.replaced.length} engine files changed, ${done.added.length} added, ${done.removed.length} removed`; // prettier-ignore\n      out(`new-game: moved from my-3dge@${done.from.commit.slice(0, 7)} to my-3dge@${done.to.commit.slice(0, 7)}: ${counts}${patches}`); // prettier-ignore\n      if (done.forced.length > 0) out(`replaced the game's own (--force): ${done.forced.join(', ')}`);\n      if (done.npm.length > 0) out(`package.json: the engine's entries win, so these went or are the engine's again: ${done.npm.join(', ')}; put back what the game needs under a name of its own`); // prettier-ignore\n      if (done.refreshed.length > 0) out(`root files brought to the engine's templates: ${done.refreshed.join(', ')}`);\n      const template = (to) => `${to} (tools/game/template/${TEMPLATES.find(([, path]) => path === to)[0]})`;\n      if (done.diverged.length > 0) out(`the engine's templates changed for root files the game edited: compare ${done.diverged.map(template).join(', ')} and take what applies`); // prettier-ignore\n      out(`next: ${done.lockfileFits ? 'npm ci' : 'npm install (the game has dependencies of its own)'}, then npm run check && npm test`); // prettier-ignore\n      return 0;\n    }\n    const done = createGame({ target, name: named >= 0 ? argv[named + 1] : undefined });\n    const near = relative(process.cwd(), done.root);\n    const where = near.startsWith('..') ? done.root : (near || '.').split(sep).join('/');\n    const extra = `${done.kept.length > 0 ? `; kept your ${done.kept.join(', ')}` : ''}${done.initialized ? '; git init' : ''}`; // prettier-ignore\n    out(`new-game: made the game \"${done.name}\" in ${where}: the engine at my-3dge@${done.identity.commit.slice(0, 7)} (${done.engineFiles} files, read-only, pinned by ${LOCK_FILE}) and the starter game in labs/game/${extra}`); // prettier-ignore\n    out(`next: ${where === '.' ? '' : `cd ${where} && `}bash scripts/setup.sh && npm test`);\n    out('then: read AGENTS.md and docs/GAME-GUIDE.md, make the game in labs/game/, and commit as you go');\n    return 0;\n  } catch (error) {\n    err(`new-game: ${error instanceof Error ? error.message : String(error)}`);\n    return 1;\n  }\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) process.exitCode = main();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'cat docs/PROGRESS.md && cat labs/game/main.ts labs/game/scenes/play.ts labs/game/cast/player.ts'","aggregated_output":"# Progress\n\nRead this first: where things stand, what is next and the open issues, on one screen (`node x docs --check` fails it\npast 40 lines). The integrator rewrites it at each gate; every WP's status and notes are in the ledger, PLAN.md §14.\n\n## Next: nothing scheduled; the owner's playtest of the tech demo\n\n- Gate G13 (PR #34): Phase 13 is done, with every WP it fired: the front end (WP 13.25), the governor (7.5),\n  GPU-driven crowds' stage 1 (11.4), templates and skills (12.1), the usability evals and mutation testing (12.2),\n  `x mcp` (7.6), the tour with its attract mode and a film per look (13.26). What follows waits: upgrades U-2 to U-7\n  from their dates (`node x deps --qualify`), on-demand WPs for their triggers (§9.1), Phase H for a game to ship.\n- The owner's, all in the playground's Owner checks (start menu; WP 13.28), each in plain words with Go there: the\n  playtest (docs/PLAYGROUND.md §9.3), the looks to judge (the clean default, clean and cel at full resolution, the\n  accent weak from isometric, the cel look's dark night there, its near-black brick), the sound and a pad, and ESC-0002\n  to ESC-0006's calls (the Quaternius GLBs, model access for the live evals, the crowd's CPU render, the mutants outside\n  the sample), answered from Copy my answers. Their go-ahead (2026-10-22): a bot may play with infinite health and ammo.\n\n## Where things stand (2026-11-05)\n\n- Phases 0–9 and 13 are done (G10–G13: PR #22 to #34). The playground (`npm run dev`) is one map, the block, behind a\n  splash and a start menu (WP 13.33), shut doors walls to its cameras (13.34), no z-fighting (13.35–13.37), the audit's\n  gaps closed (13.38); the player moves as Apex in five cameras (doors, pickups, melee, guns, ragdolls, neighbours, a\n  dog, sound, day and night, GPU rain; clean, cel and pixel looks); Watch the tour plays it all. Agents drive it through\n  `node x`, `__engine` or `x mcp`. Games: lean/. Shipped as playground.html. Faster starts (ADR-0008 amendments 11, 12;\n  Owner: a move still re-keys lit pipelines); Style Lab's filters in Tune the look.\n\n## What waits, and the open issues\n\n- Amendment 22 proposes triangle-mesh terrain. QA baselines: the timelines' knockdown slide, WP 8.8's. Owner:\n  top-down's pixel look panned across a whole pixel changes 7–10 pixels of a soft shadow band (amendment 35). Clip\n  contacts: hands read as holds in walks, idles and more (WP 8.8's row); no foot lock reads a clip's foot contacts yet.\n  Not verifiable here: speakers, touch (ADR-0021), pads, real GPUs (`stats().gpuMs`: the rain's 1 ms; load times), the\n  pixel look's glide, how the filters read, a desktop MCP client. A key pressed in a warm-up is lost (amendment 48).\n- Mutation (WP 12.2, ESC-0006): the run's tenth catches 94.40%, the rest 74.3%; rotate its seed and redraw each gate.\n- Near the size cap (390–397 lines), split on the next change: sim/world.ts, anim/{quadruped,clip/validate}.ts,\n  tools/cmd/replay.ts, app/engine.ts; four tests at 399–400.\n- The quick gate is over its 5 min (CI_BUDGET), its long pole the playground's soak and site tests; under load\n  `npm test` can fail on RPC timeouts; audio.spec's spatial test hung once in an offline render on GitHub (e6f38ba).\n- The tour's page goldens come from its spec (amendment 41). Random play lost the shooter's chest in 4–5% of frames\n  (before WP 13.27). A shot's ID pass builds a pipeline again after each lambert–toon style switch (frames never do).\n/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n/**\n * @file The starter game's player: the character the keys move (the character controller's numbers: how it runs,\n * jumps and dashes) and the body it is drawn as, and `spawnPlayer`, which stands it in a scene. A game keeps its\n * cast here, one character a file, as the box keeps its hero, walkers, slimes and wisps (labs/box/cast/); its scenes\n * spawn them. `node x sim labs/game/scenes/play.ts --feel` measures how the player handles: response, top speed, the\n * jump's height and air time, the dash's reach.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter(6).speed; // 6: m/s\n * playerCharacter(6).jumpSpeed; // 9: m/s at take-off, about 1.27 m up, over the arena's 0.75 m low walls\n * @see labs/game/scenes/play.ts\n */\nimport { createCharacter, spawnActor, type Character, type World } from '../../../engine/sim-api';\n\n/** The player's take-off speed, m/s: about 1.27 m up under the controller's gravity, over a 0.75 m low wall. */\nexport const JUMP_SPEED = 9;\n\n/** The body the player is drawn as: the humanoid in the chibi build, empty-handed. */\nexport const PLAYER_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' });\n\n/** The player's character at `speed` m/s; createCharacter's defaults for the rest (its dash among them). */\nexport function playerCharacter(speed: number): Character {\n  return createCharacter({ speed, jumpSpeed: JUMP_SPEED });\n}\n\n/** Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move. */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  speed: number,\n  yaw = 0,\n): number {\n  const character = playerCharacter(speed);\n  return spawnActor(w, { at: [at[0], at[1], at[2]], character, player: true, yaw, anim: { ...PLAYER_BODY } });\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261104-224022'); temp=Path('.engine-source-setup')\np.rename(temp); p.mkdir(); temp.rename(p/'.engine-source')\nPY\nnode --input-type=module - <<'JS'\nimport { createGame } from './Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261104-224022/.engine-source/tools/game/new-game.mjs';\nconsole.log(createGame({target:'Wobble-Fit-Wii-Fit-gpt-6.1-sol-max-20261104-224022',name:'wobble-fit',git:false}));\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
