{"type":"item.started","item":{"id":"item_189","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/bindings.ts <<'EOF'\n/** @file Rebinding preserves mouse, breath and pad codes; prompts and local seats read the same native bindings. */\nimport type {GameEngine,ScreenApp} from './context';\nimport type {SeatInput} from './seat-input';\nimport {KEY_LABELS} from './glyphs';\nexport function syncBindings(input:GameEngine['input'],seats:SeatInput):void{\n if(\"'!input)return;const bindings=input.bindingsFor('\"'actionMap:balance');\n KEY_LABELS.left=bindings.label('footl','keyboard');KEY_LABELS.right=bindings.label('footr','keyboard');\n seats.setCodes(bindings.codes('footl'),bindings.codes('footr'));\n}\nexport async function rebindFeet(a:ScreenApp):Promise<void>{\n const input=a.engine?.input;if(\"'!input)return;a.ui.capturing=true;\n try{for(const [action,label]of [['\"'footl','left'],['footr','right']] as const){\n  for(;;){const heading=a.ui.root.querySelector('h1');if(heading)heading.textContent=\"'`Press a key for ${label} foot.`;\n   const code=await input.listen('\"'keyboard');if(\"'!code)return;\n   if(code==='\"'Space'){if(heading)heading.textContent='Space stays with both feet. Choose another key.';continue;}\n   const bindings=input.bindingsFor('actionMap:balance'),old=bindings.codes(action).find(c=>\"'!c.startsWith('\"'Pad')&&\"'!c.startsWith('\"'Mouse')&&c\"'!=='\"'Space');\n   const result=bindings.rebind(action,code,{replace:old});\n   if(\"'!result.ok){if(heading)heading.textContent=result.message;continue;}\n   const garden=input.bindingsFor('\"'actionMap:gardenRetreat'),oldGarden=garden.codes(action).find(c=>\"'!c.startsWith('\"'Pad')&&\"'!c.startsWith('\"'Mouse')&&c\"'!=='\"'Space');garden.rebind(action,code,{replace:oldGarden});break;\n  }\n }}finally{a.ui.capturing=false;a.syncBindings();a.show('controls');}\n}\nexport function resetFeet(a:ScreenApp):void{for(const map of ['actionMap:balance','actionMap:gardenRetreat']){a.engi