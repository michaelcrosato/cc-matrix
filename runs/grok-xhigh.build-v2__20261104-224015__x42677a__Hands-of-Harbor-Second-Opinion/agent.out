y/code\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 260);\\n        lines.push(format!(\\\"code {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    {\\n        let mut sim = Sim::new(\\\"surgery/campaign\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 2200);\\n        lines.push(format!(\\\"camp {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    let dump = lines.join(\\\"\\\\n\\\");\\n    eprintln!(\\\"{dump}\\\");\\n    assert!(lines.iter().all(|l| l.contains(\\\"Won\\\")), \\\"{dump}\\\");\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    let (outcome, ticks) = sim.run_bot(60 * 180);\\n    assert_eq!(outcome, Outcome::Won, \\\"{ticks} ticks {}\\\", status(&sim));\\n\",\"total_lines\":95}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0749ecbe-db3b-4477-9040-d5c04f5b6328-53","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,54,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,101,110,103,105,110,101,45,108,105,110,107,47,99,114,97,116,101,115,47,112,97,118,95,116,111,111,108,115,47,115,114,99,47,115,101,115,115,105,111,110,46,114,115,10,49,49,53,58,32,32,32,32,32,32,32,32,115,46,115,121,110,99,95,99,97,109,101,114,97,40,41,59,10,49,55,56,58,32,32,32,32,32