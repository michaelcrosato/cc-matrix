these roles.\"},{\"line_number\":184,\"content\":\"            let packed = entry.material.pack(entry.slot.map, roles);\"},{\"line_number\":194,\"content\":\"            let packed = material.pack(map, roles);\"},{\"line_number\":200,\"content\":\"        let roles: Vec<(String, String)> = roles.iter().map(|(role, hex)| (role.to_string(), hex.to_string())).collect();\"},{\"line_number\":202,\"content\":\"        let (row, mat_slot) = pack(material, map, &roles, slot as u32, self.detail);\"},{\"line_number\":203,\"content\":\"        self.entries.push(Entry { key: key.clone(), material: material.clone(), roles, slot: mat_slot });\"},{\"line_number\":244,\"content\":\"        let (row, slot) = pack(&entry.material, map, &entry.roles, entry.slot.slot, self.detail);\"},{\"line_number\":267,\"content\":\"    roles: &[(String, String)],\"},{\"line_number\":271,\"content\":\"    let roles: Vec<(&str, &str)> = roles.iter().map(|(role, hex)| (role.as_str(), hex.as_str())).collect();\"},{\"line_number\":272,\"content\":\"    let mut packed = material.pack(map, &roles);\"},{\"line_number\":285,\"content\":\"fn same_roles(stored: &[(String, String)], roles: &[(&str, &str)]) -> bool {\"},{\"line_number\":286,\"content\":\"    stored.len() == roles.len() && stored.iter().zip(roles).all(|((r, h), (r2, h2))| r == r2 && h == h2)\"},{\"line_number\":289,\"content\":\"/// Hash of the role colours a material's layers use, as `roles` resolves them (0 for none).\"},{\"line_number\":290,\"content\":\"fn palette_hash(material: &Material, roles: &[(&str, &str)]) -> u64 {\"},{\"line_number\":291,\"content\":\"    if !material.layers_use_roles() {\"},{\"line_number\":302,\"content\":\"    for role in used {\"},{\"line_number\":303,\"content\":\"        role.hash(&mut h);\"},{\"line_number\":304,\"content\":\"        roles.iter().find(|(r, _)| *r == role).map(|(_, hex)| *hex).hash(&mut h);\"},{\"line_number\":316,\"content\":\"        r##\\\"{\\\"format\\\":1,\\\"name\\\":\\\"roled\\\",\\\"unit\\\":\\\"cm\\\",\\\"color\\\":\\\"$wall\\\",\\\"layers\\\":[{\\\"type\\\":\\\"noise\\\",\\\"size\\\":50,\\\"color\\\":\\\"$accent\\\"}]}\\\"##;\"},{\"line_number\":320,\"content\":\"        let lib = Library::from_sources(&[(\\\"plain\\\", PLAIN), (\\\"roled\\\", ROLED)]);\"},{\"line_number\":325,\"content\":\"        assert_eq!(table.resolve(&lib, \\\"MAT/plain\\\", None, &[(\\\"$wall\\\", \\\"#000000\\\")]).unwrap().slot, 1, \\\"no roles: one row\\\");\"},{\"line_number\":326,\"content\":\"        // Roles in a layer: one row per palette; the base colour's role travels in the instance.\"},{\"line_number\":327,\"content\":\"        let r1 = table.resolve(&lib, \\\"MAT/roled\\\", None, &[(\\\"$accent\\\", \\\"#ff0000\\\")]).unwrap();\"},{\"line_number\":328,\"content\":\"        let r2 = table.resolve(&lib, \\\"MAT/roled\\\", None, &[(\\\"$accent\\\", \\\"#00ff00\\\")]).unwrap();\"},{\"line_number\":329,\"content\":\"        let r3 = table.resolve(&lib, \\\"MAT/roled\\\", None, &[(\\\"$accent\\\", \\\"#ff0000\\\"), (\\\"$wall\\\", \\\"#123456\\\")]).unwrap();\"},{\"line_number\":332,\"content\":\"        assert_ne!(r1.base, r3.base, \\\"the shared row's instance colour follows these roles\\\");\"},{\"line_number\":333,\"content\":\"        assert_eq!(table.resolve(&lib, \\\"MAT/roled\\\", None, &[(\\\"$accent\\\", \\\"#ff0000\\\")]).unwrap(), r1);\"},{\"line_number\":344,\"content\":\"        let lib2 = Library::from_sources(&[(\\\"plain\\\", &edited), (\\\"roled\\\", ROLED)]);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_tools/src/game_tools.rs\",\"matches\":[{\"line_number\":1048,\"content\":\"            [(\\\"mirror\\\", pav_core::clips::MIRROR), (\\\"upper\\\", pav_core::clips::UPPER), (\\\"travel\\\", pav_core::clips::TRAVEL)]\"},{\"line_number\":1197,\"content\":\"                json!({ \\\"i\\\