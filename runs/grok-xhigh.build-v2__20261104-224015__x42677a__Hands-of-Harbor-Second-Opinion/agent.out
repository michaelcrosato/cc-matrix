\"title\\\",\"},{\"line_number\":130,\"content\":\"            Screen::Menu => \\\"menu\\\",\"},{\"line_number\":131,\"content\":\"            Screen::Difficulty => \\\"difficulty\\\",\"},{\"line_number\":132,\"content\":\"            Screen::Files => \\\"files\\\",\"},{\"line_number\":133,\"content\":\"            Screen::Settings => \\\"settings\\\",\"},{\"line_number\":134,\"content\":\"            Screen::About => \\\"about\\\",\"},{\"line_number\":135,\"content\":\"            Screen::Controls => \\\"controls\\\",\"},{\"line_number\":136,\"content\":\"            Screen::Pause => \\\"pause\\\",\"},{\"line_number\":137,\"content\":\"            Screen::Dev => \\\"dev\\\",\"},{\"line_number\":138,\"content\":\"            Screen::Attract => \\\"attract\\\",\"},{\"line_number\":139,\"content\":\"            Screen::Hud => \\\"op\\\",\"},{\"line_number\":140,\"content\":\"            Screen::Story => \\\"story\\\",\"},{\"line_number\":141,\"content\":\"            Screen::Results => \\\"results\\\",\"},{\"line_number\":142,\"content\":\"            Screen::Dead => \\\"dead\\\",\"},{\"line_number\":143,\"content\":\"            Screen::Card => \\\"card\\\",\"},{\"line_number\":144,\"content\":\"            Screen::Chart => \\\"chart\\\",\"},{\"line_number\":156,\"content\":\"    pub fn note_mode(&mut self, mode: u8) {\"},{\"line_number\":159,\"content\":\"        if self.screen == Screen::Title && mode == 6 {\"},{\"line_number\":162,\"content\":\"        if matches!(self.screen, Screen::Story | Screen::Hud | Screen::Chart) && mode == 0 {\"},{\"line_number\":168,\"content\":\"                Screen::Menu\"},{\"line_number\":169,\"content\":\"                    | Screen::Difficulty\"},{\"line_number\":170,\"content\":\"                    | Screen::Files\"},{\"line_number\":171,\"content\":\"                    | Screen::Settings\"},{\"line_number\":172,\"content\":\"                    | Screen::About\"},{\"line_number\":173,\"content\":\"                    | Screen::Controls\"},{\"line_number\":174,\"content\":\"                    | Screen::Pause\"},{\"line_number\":175,\"content\":\"                    | Screen::Dev\"},{\"line_number\":176,\"content\":\"                    | Screen::Attract\"},{\"line_number\":182,\"content\":\"            1 => Screen::Story,\"},{\"line_number\":183,\"content\":\"            2 => Screen::Chart,\"},{\"line_number\":184,\"content\":\"            3 => Screen::Hud,\"},{\"line_number\":185,\"content\":\"            4 => Screen::Results,\"},{\"line_number\":186,\"content\":\"            5 => Screen::Dead,\"},{\"line_number\":187,\"content\":\"            6 => Screen::Attract,\"},{\"line_number\":188,\"content\":\"            7 => Screen::Card,\"},{\"line_number\":189,\"content\":\"            _ => Screen::Title,\"},{\"line_number\":193,\"content\":\"    pub fn prompt(&self, action: &str) -> &'static str {\"},{\"line_number\":252,\"content\":\"    pub fn lines(&self) -> Vec<String> {\"},{\"line_number\":256,\"content\":\"            Screen::Title => {\"},{\"line_number\":259,\"content\":\"                if self.touch_only && !self.ever_fine {\"},{\"line_number\":264,\"content\":\"            Screen::Menu => {\"},{\"line_number\":269,\"content\":\"            Screen::Difficulty => {\"},{\"line_number\":274,\"content\":\"            Screen::Files => {\"},{\"line_number\":280,\"content\":\"            Screen::Settings => {\"},{\"line_number\":299,\"content\":\"            Screen::About => {\"},{\"line_number\":303,\"content\":\"            Screen::Controls => {\"},{\"line_number\":310,\"content\":\"            Screen::Pause => {\"},{\"line_number\":315,\"content\":\"            Screen::Dev => {\"},{\"line_number\":329,\"content\":\"            Screen::Attract => {\"},{\"line_number\":333,\"content\":\"            Screen::Hud => {\"},{\"line_number\":336,\"content\":\"            Screen::Story => v.push(\\\"Advance\\\".into()),\"},{\"line_number\":337,\"content\":\"            Screen::Results => v.push(\\\"Results\\\".into()),\"},{\"line_number\":338,\"content\":\"            Screen::Dead => v.push(self.row(0, \\\"Retry\\\")),\"},{\"line_number\":339,\"content\":\"            Screen::Card => {\"},{\"line_number\":344,\"content\":\"            Screen::Chart => {\"},{\"line_number\":361,\"content\":\"    pub fn step(&mut self, input: Input) -> Vec<Cmd> {\"},{\"line_number\":369,\"content\":\"        if self.screen == Screen::Attract {\"},{\"line_number\":371,\"content\":\"                self.screen = Screen::Title;\"},{\"line_number\":381,\"content\":\"            Screen::Title | Screen::Menu | Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls\"},{\"line_number\":386,\"content\":\"                self.screen = Screen::Attract;\"},{\"line_number\":388,\"content\":\"                cmds.push(Cmd::LoadAttract);\"},{\"line_number\":394,\"content\":\"        if self.touch_only && !self.ever_fine && self.screen == Screen::Title {\"},{\"line_number\":396,\"content\":\"                self.screen = Screen::Settings;\"},{\"line_number\":430,\"content\":\"        if self.screen == Screen::Hud && input.back {\"},{\"line_number\":432,\"content\":\"            self.screen = Screen::Pause;\"},{\"line_number\":440,\"content\":\"            Screen::Menu | Screen::Pause => 6,\"},{\"line_number\":441,\"content\":\"            Screen::Difficulty => 3,\"},{\"line_number\":442,\"content\":\"            Screen::Files => 8,\"},{\"line_number\":443,\"content\":\"            Screen::Settings => 3,\"},{\"line_number\":444,\"content\":\"            Screen::Dev => 9,\"},{\"line_number\":445,\"content\":\"            Screen::Dead => 1,\"},{\"line_number\":446,\"content\":\"            Screen::Title => {\"},{\"line_number\":447,\"content\":\"                if self.touch_only && !self.ever_fine {\"},{\"line_number\":470,\"content\":\"            Screen::Settings => self.settings_page = (self.settings_page as i8 + d).rem_euclid(3) as u8,\"},{\"line_number\":471,\"content\":\"            Screen::About => self.about_page = (self.about_page as i8 + d).rem_euclid(5) as u8,\"},{\"line_number\":472,\"content\":\"            Screen::Dev => self.dev_page = (self.dev_page as i8 + d).rem_euclid(4) as u8,\"},{\"line_number\":479,\"content\":\"        if self.screen == Screen::Settings && self.settings_page == 0 {\"},{\"line_number\":489,\"content\":\"        if self.screen == Screen::Dev && (2..8).contains(&self.focus) {\"},{\"line_number\":502,\"content\":\"            Screen::Menu | Screen::Attract => self.screen = Screen::Title,\"},{\"line_number\":503,\"content\":\"            Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls => {\"},{\"line_number\":504,\"content\":\"                self.screen = if self.paused { Screen::Pause } else { Screen::Menu };\"},{\"line_number\":506,\"content\":\"            Screen::Pause => {\"},{\"line_number\":508,\"content\":\"                self.screen = Screen::Hud;\"},{\"line_number\":510,\"content\":\"            Screen::Dev => self.screen = Screen::Pause,\"},{\"line_number\":511,\"content\":\"            Screen::Hud => {\"},{\"line_number\":513,\"content\":\"                self.screen = Screen::Pause;\"},{\"line_number\":521,\"content\":\"    fn activate(&mut self, cmds: &mut Vec<Cmd>) {\"},{\"line_number\":523,\"content\":\"            Screen::Title => {\"},{\"line_number\":524,\"content\":\"                self.screen = Screen::Menu;\"},{\"line_number\":527,\"content\":\"            Screen::Menu => match self.focus {\"},{\"line_number\":531,\"content\":\"                    self.screen = Screen::Story;\"},{\"line_number\":534,\"content\":\"                    self.screen = Screen::Difficulty;\"},{\"line_number\":538,\"content\":\"                    self.screen = Screen::Files;\"},{\"line_number\":544,\"content\":\"                    self.screen = Screen::Hud;\"},{\"line_number\":547,\"content\":\"                    self.screen = Screen::Settings;\"},{\"line_number\":551,\"content\":\"                    self.screen = Screen::About;\"},{\"line_number\":555,\"content\":\"            Screen::Difficulty => {\"},{\"line_number\":560,\"content\":\"                self.screen = Screen::Story;\"},{\"line_number\":562,\"content\":\"            Screen::Files => {\"},{\"line_number\":566,\"content\":\"                self.screen = Screen::Hud;\"},{\"line_number\":568,\"content\":\"            Screen::Pause => match self.focus {\"},{\"line_number\":571,\"content\":\"                    self.screen = Screen::Hud;\"},{\"line_number\":574,\"content\":\"                2 => self.screen = Screen::Controls,\"},{\"line_number\":575,\"content\":\"                3 => self.screen = Screen::Settings,\"},{\"line_number\":577,\"content\":\"                    self.screen = Screen::Dev;\"},{\"line_number\":582,\"content\":\"                    self.screen = Screen::Title;\"},{\"line_number\":586,\"content\":\"            Screen::Dev => {\"},{\"line_number\":595,\"content\":\"            Screen::Settings if self.settings_page == 1 && self.focus == 0 => self.xbox = !self.xbox,\"},{\"line_number\":596,\"content\":\"            Screen::Dead => cmds.push(Cmd::Retry),\"},{\"line_number\":597,\"content\":\"            Screen::Story | Screen::Results | Screen::Card | Screen::Chart => cmds.push(Cmd::ConfirmSim),\"},{\"line_number\":598,\"content\":\"            Screen::About => self.about_page = (self.about_page + 1) % 5,\"},{\"line_number\":603,\"content\":\"    pub fn reset_sliders(&mut self) -> Cmd {\"},{\"line_number\":622,\"content\":\"    pub fn open_dev_for_test(&mut self) {\"},{\"line_number\":624,\"content\":\"        self.screen = Screen::Dev;\"},{\"line_number\":696,\"content\":\"            Screen::Hud => draw_hud(ui, op),\"},{\"line_number\":697,\"content\":\"            Screen::Chart => {\"},{\"line_number\":705,\"content\":\"            Screen::Story => {\"},{\"line_number\":717,\"content\":\"            Screen::Results => {\"},{\"line_number\":732,\"content\":\"                    if shell.screen == Screen::Title || shell.screen == Screen::Menu || shell.screen == Screen::Attract {\"},{\"line_number\":738,\"content\":\"                    if i == 0 && (shell.screen == Screen::Title || shell.screen == Screen::Menu) {\"},{\"line_number\":753,\"content\":\"                if shell.screen == Screen::Attract {\"},{\"line_number\":851,\"content\":\"    fn attract_waits_ten_seconds_and_any_device_leaves() {\"},{\"line_number\":856,\"content\":\"        assert_eq!(s.screen_name(), \\\"attract\\\");\"},{\"line_number\":857,\"content\":\"        assert!(cmds.contains(&Cmd::LoadAttract));\"},{\"line_number\":873,\"content\":\"    fn touch_only_asks_for_a_controller_and_opens_settings() {\"},{\"line_number\":875,\"content\":\"        s.touch_only = true;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"66a7b862-22a8-4167-ac43-6b2ca807669e"}
