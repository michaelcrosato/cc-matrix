t\":\"    if skill < 0.55 || game.heart.flat || game.surgeons[0].meter < 100.0 {\"},{\"line_number\":102,\"content\":\"fn defib(game: &Surgery, me: &Surgeon, skill: f32, mut inp: SurgeonInput) -> SurgeonInput {\"},{\"line_number\":105,\"content\":\"    let hold = if skill < 0.35 {\"},{\"line_number\":156,\"content\":\"fn release_at(skill: f32, kind: u8) -> f32 {\"},{\"line_number\":158,\"content\":\"        if skill < 0.2 { 1.25 } else { 0.90 }\"},{\"line_number\":160,\"content\":\"        0.90 + (1.0 - skill) * 0.28\"},{\"line_number\":177,\"content\":\"fn aim_toward(game: &Surgery, me: &Surgeon, slot: usize, skill: f32, tick: u64, mut tx: f32, mut tz: f32, inp: &mut SurgeonInput) {\"},{\"line_number\":178,\"content\":\"    let amp = (1.0 - skill) * (1.0 - skill) * 2.2;\"},{\"line_number\":184,\"content\":\"    let step = (3.0 + 12.0 * skill) * DT;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"4595a4a0-275e-4690-affa-fd832c211929"}
