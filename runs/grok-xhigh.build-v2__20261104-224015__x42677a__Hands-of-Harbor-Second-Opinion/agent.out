md::LoadAttract => SurgeryCmd::LoadAttract,\\n        Cmd::ToTitle => SurgeryCmd::ToTitle,\\n        Cmd::SetDifficulty(d) => SurgeryCmd::SetDifficulty(d),\\n        Cmd::Retry => SurgeryCmd::Retry,\\n        Cmd::SetTune { id, value } => SurgeryCmd::SetTune { id, value },\\n        Cmd::ResetTune => SurgeryCmd::ResetTune,\\n        Cmd::SetBus { which, value } => SurgeryCmd::SetBus { which, value },\\n        Cmd::Dev { what, extra } => SurgeryCmd::Dev { what, extra },\\n        Cmd::ConfirmSim => return None,\\n    })\\n}\\n\\nfn track_name(op: &SurgeryFrame) -> &'static str {\\n    if op.gift_hush > 0.0 {\\n        return \\\"hush\\\";\\n    }\\n    if op.flat || op.code_t >= 0.0 {\\n        return \\\"code\\\";\\n    }\\n    match op.mode {\\n        1 => {\\n            if op.case_id % 2 == 0 {\\n                \\\"story_ward\\\"\\n            } else {\\n                \\\"story_night\\\"\\n            }\\n        }\\n        3 | 6 => match op.strain {\\n            0..=3 => \\\"introit\\\",\\n            4..=7 => \\\"lacrimosa\\\",\\n            8..=10 => \\\"dies\\\",\\n            11..=17 => \\\"libera\\\",\\n            _ => {\\n                if op.case_id < 0 {\\n                    \\\"code\\\"\\n                } else {\\n                    \\\"or\\\"\\n                }\\n            }\\n        },\\n        4 => \\\"results\\\",\\n        5 => \\\"crisis\\\",\\n        7 => \\\"code\\\",\\n        _ => \\\"title\\\",\\n    }\\n}\\n\\npub fn surgery_frame(app: &mut App) {\\n    if app.gfx.is_none() || app.host.is_none() {\\n        return;\\n    }\\n    // The display callback and the timer below both enter here. One frame at a time.\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    if IN_FRAME.with(|f| f.replace(true)) {\\n        return;\\n    }\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    let _frame_guard = FrameGuard;\\n    let now = web_time::Instant::now();\\n    let dt = (now - app.last).as_secs_f32().min(0.1);\\n    app.last = now;\\n\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    drain_hook(app);\\n\",\"total_lines\":1000}}","is_error":false},{"type":"tool_result","tool_use_id":"call-df561144-fddb-4787-b05d-1ff298b27d33-32","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,50,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,72,97,110,100,115,32,111,102,32,72,97,114,98,111,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,84,114,97,117,109,97,32,67,101,110,116,101,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,99,111,114,101,47,115,114,99,47,103,97,109,101,115,47,115,117,114,103,101,114,121,47,104,97,122,97,114,100,46,114,115,10,53,54,48,58,102,110,32,104,101,97,116,95,116,111,111,108,40,104,58,32,38,109,117,116,32,72,97,122,97,114,100,44,32,110,101,97,114,58,32,98,111,111,108,44,32,117,115,101,95,104,101,108,100,58,32,98,111,111,108,44,32,106,117,115,116,95,114,101,108,101,97,115,101,58,32,98,111,111,108,44,32,100,116,58,32,102,51,50,44,32,112,58,32,102,51,50,44,32,115,116,114,105,99,116,58,32,102,51,50,44,32,104,105,116,58,32,38,109,117,116,32,72,105,116,44,32,99,117,101,58,32,117,4