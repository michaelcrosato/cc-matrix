"content\":\"/// A part's linear colour: its role resolved, then its tint.\"},{\"line_number\":1881,\"content\":\"pub(crate) fn part_color(color: &str, tint: f32, roles: &BTreeMap<String, String>) -> Vec3 {\"},{\"line_number\":1882,\"content\":\"    v3(Color::hex(role_hex(color, roles))) * tint\"},{\"line_number\":1914,\"content\":\"/// layers' roles take the place's palette (`roles`, else the defaults).\"},{\"line_number\":1921,\"content\":\"    roles: &[(&str, &str)],\"},{\"line_number\":1924,\"content\":\"        Some(material) if !material.is_plain() => table.intern(name, material, auto_map(material, auto), roles).param(seed),\"},{\"line_number\":1930,\"content\":\"fn palette_hash(roles: &[(&str, &str)]) -> u64 {\"},{\"line_number\":1932,\"content\":\"    if roles.is_empty() {\"},{\"line_number\":1936,\"content\":\"    roles.hash(&mut h);\"},{\"line_number\":1946,\"content\":\"    pub roles: &'a BTreeMap<String, String>,\"},{\"line_number\":1954,\"content\":\"            return (part_color(part.surface_color(), part.tint, self.roles), 0);\"},{\"line_number\":1960,\"content\":\"            return (part_color(color, part.tint, self.roles), 0);\"},{\"line_number\":1963,\"content\":\"        let color = part_color(part.color.as_deref().unwrap_or(&material.color), part.tint, self.roles);\"},{\"line_number\":1981,\"content\":\"        let roles: Vec<(&str, &str)> = self.roles.iter().map(|(role, hex)| (role.as_str(), hex.as_str())).collect();\"},{\"line_number\":1982,\"content\":\"        let slot = self.table.intern(name, material, auto_map(material, auto), &roles);\"},{\"line_number\":2027,\"content\":\"    let generated_mesh = Generated::of(&part.prim, part.mirrored);\"},{\"line_number\":2180,\"content\":\"                roles: Default::default(),\"},{\"line_number\":2357,\"content\":\"            include_str!(\\\"../../pav_core/tests/fixtures/props/format2/probe_mirror.json\\\"),\"},{\"line_number\":2376,\"content\":\"                .filter_map(|p| Generated::of(