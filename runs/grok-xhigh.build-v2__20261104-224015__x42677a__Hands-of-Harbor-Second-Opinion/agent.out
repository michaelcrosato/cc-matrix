          g.callout_i = 4;\\n            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\\n                tool,\\n                use_held,\\n                just_release,\\n                inp.pressure,\\n                rot,\\n                rules,\\n                g.tune.tool_power,\\n                g.heart.diastole() || g.duet_left > 0.0,\\n                g.tune.rating_strict,\\n            );\\n            if g.one_hit && hit.engaged && g.hazards[idx].accepts(tool) && tool != SCANNER {\\n                hit.done = true;\\n\",\"total_lines\":805}}","is_error":false},{"type":"tool_result","tool_use_id":"call-38f2b147-94d8-4b9b-becc-3f9d698c86fa-21","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Hands of Harbor: overhead surgical action in the Night Ward.\\n//!\\n//! Rules live here. The shell, the mesh and the speakers read [`frame::SurgeryFrame`].\\n\\nmod bot;\\nmod content;\\nmod hazard;\\nmod heart;\\nmod ops;\\n10→mod story;\\nmod tune;\\n\\npub mod frame;\\npub mod kinds;\\n\\npub use content::{case_def, CASES, SURGEON_NAMES};\\npub use frame::SurgeryFrame;\\npub use hazard::Hazard;\\npub use heart::Heart;\\n20→pub use kinds::*;\\npub use story::{all_lines, callout_who};\\npub use tune::Tune;\\n\\nuse std::sync::Arc;\\n\\nuse anyhow::Result;\\nuse glam::Vec3;\\nuse serde::{Deserialize, Seria