ch r {\\n        R_IMMACULATE => 400,\\n60→        R_CLEAN => 250,\\n        R_GOOD => 120,\\n        _ => 10,\\n    }\\n}\\n\\npub fn rate_error(err: f32, strict: f32) -> u8 {\\n    let e = err.max(0.0) * strict.max(0.25);\\n    if e <= 0.22 {\\n        R_IMMACULATE\\n70→    } else if e <= 0.42 {\\n        R_CLEAN\\n    } else if e <= 0.72 {\\n        R_GOOD\\n    } else {\\n        R_SLOPPY\\n    }\\n}\\n\\npub fn chain_mul(chain: u32) -> f32 {\",\"content_concise\":\"40→pub const K_IV: u8 = 17;\\npub const K_BURN: u8 = 18;\\n\\npub const N_KINDS: usize = 19;\\n\\npub const KIND_NAMES: [&str; N_KINDS] = [\\n    \\\"incision\\\", \\\"laceration\\\", \\\"pool\\\", \\\"bleeder\\\", \\\"foreign\\\", \\\"polyp\\\", \\\"tumor\\\", \\\"inflam\\\", \\\"bone\\\", \\\"nodule\\\", \\\"sac\\\", \\\"eye\\\",\\n    \\\"ember\\\", \\\"heat\\\", \\\"tether\\\", \\\"tendril\\\", \\\"dressing\\\", \\\"iv\\\", \\\"burn\\\",\\n];\\n\\n50→pub const R_IMMACULATE: u8 = 0;\\npub const R_CLEAN: u8 = 1;\\npub const R_GOOD: u8 = 2;\\npub const R_SLOPPY: u8 = 3;\\n\\npub const RATING_NAMES: [&str; 4] = [\\\"IMMACULATE\\\", \\\"CLEAN\\\", \\\"GOOD\\\", \\\"SLOPPY\\\"];\\n\\npub fn rating_points(r: u8) -> i32 {\\n    match r {\\n        R_IMMACULATE => 400,\\n60→        R_CLEAN => 250,\\n        R_GOOD => 120,\\n        _ => 10,\\n    }\\n}\\n\\npub fn rate_error(err: f32, strict: f32) -> u8 {\\n    let e = err.max(0.0) * strict.max(0.25);\\n    if e <= 0.22 {\\n        R_IMMACULATE\\n70→    } else if e <= 0.42 {\\n        R_CLEAN\\n    } else if e <= 0.72 {\\n        R_GOOD\\n    } else {\\n        R_SLOPPY\\n    }\\n}\\n\\npub fn chain_mul(chain: u32) -> f32 {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/kinds.rs\",\"offset\":40,\"limit\":40,\"raw_output\":\"pub const K_IV: u8 = 17;\\npub const K_BURN: