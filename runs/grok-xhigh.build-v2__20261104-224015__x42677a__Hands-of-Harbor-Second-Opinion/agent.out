y = true;\\n        self.phase_i = 0;\\n        self.codes_left = content::diff_codes(self.difficulty);\\n        self.code_t = -1.0;\\n480→        self.blue_t = 0.0;\\n        self.blue_wave = 0;\\n        self.blue_finale = false;\\n        self.elapsed = 0.0;\\n        self.mistakes = 0;\\n        self.rank = 0;\\n        self.shown_score = 0;\\n        self.heat_phase = false;\\n        self.reset_hands();\\n        self.spawn_kind_at(K_BLEEDER, -1.15, 0.05, 2.6);\\n490→        self.spawn_kind_at(K_BLEEDER, 1.25, 0.35, 2.6);\\n    }\\n\\n    fn boot_attract(&mut self) {\\n        self.boot_single(0);\\n        self.mode = M_ATTRACT;\\n        self.immortal = true;\\n        self.one_hit = true;\\n        self.skill = 1.0;\\n        self.outcome = Outcome::Playing;\\n500→    }\\n\\n    pub(crate) fn spawn_kind_at(&mut self, kind: u8, x: f32, z: f32, drain: f32) {\\n        let mut h = Hazard::make(kind, x, z);\\n        if drain >= 0.0 {\\n            h.drain = drain;\\n        }\\n        h.id = self.next_id;\\n        self.next_id = self.next_id.wrapping_add(1);\\n        self.hazards.push(h);\",\"content_concise\":\"420→        self.rank = 0;\\n        self.shown_score = 0;\\n        self.mistakes = 0;\\n        self.warned_40 = false;\\n        self.banner_t = 0.0;\\n        self.callout_t = 0.0;\\n        self.hush_beats = 0;\\n        self.echo_left = 0.0;\\n        self.duet_left = 0.0;\\n        self.echo_on = false;\\n430→        self.strain_phase = 255;\\n        self.blue_finale = false;\\n        self.reset_hands();\\n        self.outcome = Outcome::Playing;\\n    }\\n\\n    fn boot_single(&mut self, id: u8) {\\n        self.campaign = false;\\n        self.coverage = Coverage::default();\\n        self.gifts_unlocked = 0;\\n440→        self.gifts_used = 0;\\n        self.recent_unlock = 0;\\n        self.immortal = false;\\n        self.one_hit = false;\\n        self.prepare_case(id.min(7));\\n        self.mode = M_OP;\\n    }\\n\\n    fn boot_campaign(&mut self) {\\n        self.campaign = true;\\n450→        self.coverage = Coverage::default();\\n        self.gifts_unlocked = 0;\\n        self.gifts_used = 0;\\n        self.recent_unlock = 0;\\n        self.immortal = false;\\n        self.one_hit = false;\\n        self.prepare_case(0);\\n        self.mode = M_STORY;\\n        self.story_after = false;\\n        self.story_i = 0;\\n460→    }\\n\\n    fn boot_code(&mut self) {\\n        self.campaign = false;\\n        self.code_blue = true;\\n        self.case_id = -1;\\n        self.coverage = Coverage::default();\\n        self.mode = M_OP;\\n        self.outcome = Outcome::Playing;\\n        self.timer = 240.0 * content::diff_timer(self.difficulty);\\n470→        self.par = 1600;\\n        self.heart = Heart::new(70.0);\\n        self.plate = 9;\\n        self.plate_next = 9;\\n        self.plate_blend = 1.0;\\n        self.hazards.clear();\\n        self.phase_ready = true;\\n        self.phase_i = 0;\\n        self.codes_left = content::diff_codes(self.difficulty);\\n        self.code_t = -1.0;\\n480→        self.blue_t = 0.0;\\n        self.blue_wave = 0;\\n        self.blue_finale = false;\\n        self.elapsed = 0.0;\\n        self.mistakes = 0;\\n        self.rank = 0;\\n        self.shown_score = 0;\\n        self.heat_phase = false;\\n        self.reset_hands();\\n        self.spawn_kind_at(K_BLEEDER, -1.15, 0.05, 2.6);\\n490→        self.spawn_kind_at(K_BLEEDER, 1.25, 0.35, 2.6);\\n    }\\n\\n    fn boot_attract(&mut self) {\\n        self.boot_single(0);\\n        self.mode = M_ATTRACT;\\n        self.immortal = true;\\n        self.one_hit = true;\\n        self.skill = 1.0;\\n        self.outcome = Outcome::Playing;\\n500→    }\\n\\n    pub(crate) fn spawn_kind_at(&mut self, kind: u8, x: f32, z: f32, drain: f32) {\\n        let mut h = Hazard::make(kind, x, z);\\n        if drain >= 0.0 {\\n            h.drain = drain;\\n        }\\n        h.id = self.next_id;\\n        self.next_id = self.