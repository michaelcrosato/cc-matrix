    booted: false,\\n                slot: 0,\\n                seed: 1,\\n                names: Vec::new(),\\n                present: Vec::new(),\\n                ready_ids: Vec::new(),\\n140→                remote: [None, None, None, None],\\n                remote_age: [1.0; 4],\\n                remote_seq: [0; 4],\\n                card_lines: Vec::new(),\\n                pending_snap: None,\\n                send_acc: 0.0,\\n                seq: 1,\\n                prev_held: 0,\\n                prev_tool: 0,\\n                latch_pressed: 0,\\n150→                latch_left: 0,\\n                snap_acc: 0.0,\\n                frame_dt: 0.0,\\n                did_snap: false,\\n                did_input: false,\\n            }\\n        }\\n\\n        pub fn poll(&mut self, dt: f32) -> super::View {\\n            self.frame_dt = dt;\\n160→            let Some(hub) = hub_obj() else {\\n                return super::View::idle();\\n            };\\n            if !flag(&hub, \\\"active\\\") {\\n                return super::View::idle();\\n            }\\n            if !self.joined {\\n                if let Some(info) = json_field(&hub, \\\"info\\\") {\\n                    self.take_info(&info);\\n                }\",\"content_concise\":\"70→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\npub struct Link;\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl Link {\\n    pub fn new() -> Self {\\n        Self\\n    }\\n    pub fn poll(&mut self, _dt: f32) -> View {\\n80→        View::idle()\\n    }\\n    pub fn send_input(&mut self, _hand: &SurgeonInput) {}\\n    pub fn send_snap(&mut self, _body: &str) -> bool {\\n        false\\n    }\\n    pub fn publish(&mut self, _body: &str) {}\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\n90→mod js {\\n    use super::{Dom, Snap};\\n    use pav_core::input::{surg, SurgeonInput};\\n    use wasm_bindgen::JsCast;\\n\\n    pub struct Link {\\n        pub joined: bool,\\n        pub readied: bool,\\n        pub ser