et bid = bone.id;\\n    let up_right = octant(Vec2::new(1.0, 1.0)).unwrap();\\n    assert_eq!(up_right, FORCEPS);\\n    for _ in 0..90 {\\n420→        let Some(h) = alive_id(&sim, bid) else { break };\\n        if h.stage > 0 {\\n            break;\\n        }\\n        let extra = if h.aux > 12.0 {\\n            surg::ROT_L\\n        } else if h.aux < -12.0 {\\n            surg::ROT_R\\n        } else {\\n            0\\n430→        };\\n        mapped(&mut sim, h.x, h.z, up_right, true, extra);\\n    }\\n    {\\n        let h = alive_id(&sim, bid).unwrap_or_else(|| panic!(\\\"bone broke early {}\\\", status(&sim)));\\n        assert_eq!(h.stage, 1, \\\"bone aux {} {}\\\", h.aux, status(&sim));\\n    }\\n    let suture = cycle(FORCEPS, true);\\n    assert_eq!(suture, SUTURE);\\n    for _ in 0..12 {\\n440→        let Some(h) = alive_id(&sim, bid) else { break };\\n        let (dirx, dirz) = (h.axis.cos(), h.axis.sin());\\n        let span = h.need.max(0.4);\\n        let n = h.samples_need.max(1) as f32;\\n        let along = -span * 0.5 + (h.samples as f32 + 0.5) * (span / n);\\n        for side in [0.5_f32, -0.5] {\\n            let Some(h) = alive_id(&sim, bid) else { break };\\n            let x = h.x + dirx * along - dirz * side;\\n            let z = h.z + dirz * along + dirx * side;\\n            mapped(&mut sim, x, z, suture, true, 0);\\n450→        }\\n    }\\n    assert!(alive_id(&sim, bid).is_none(), \\\"bone still open {}\\\", status(&sim));\\n\\n    let tether = alive_kind(&sim, K_TETHER).unwrap_or_else(|| panic!(\\\"tether {}\\\", status(&sim)));\\n    let tid = tether.id;\\n    let up = octant(Vec2::new(0.0, 1.0)).unwrap();\\n    assert_eq!(up, SCALPEL);\\n    let mut along = 0.0;\\n    for _ in 0..24 {\\n460→        let Some(h) = alive_id(&sim, tid) else { break };\\n        let x = h.x + h.axis.cos() * along;\\n        let z = h.z + h.axis.sin() * along;\\n        mapped(&mut sim, x, z, up, true, 0);\\n        along = (along + 0.28).min(h.need + 0.25);\\n    }\\n    assert!(alive_id(&sim, tid).is_none(), \\\"tether still there {}\\\", status(&sim));\\n\\n    for _ in 0..4 {\\n        if alive_kind(&sim, K_DRESSING).is_some() {\\n470→            break;\\n        }\\n        wake(&mut sim);\\n    }\\n    let dressing = alive_kind(&sim, K_DRESSING).unwrap_or_else(|| panic!(\\\"no dressing {}\\\", status(&sim)));\\n    let did = dressing.id;\\n    let gel = octant(Vec2::new(-1.0, -1.0)).unwrap();\\n    assert_eq!(gel, GEL);\\n    assert_eq!(contextual_tool(gel, dressing.x, dressing.z, &game(&sim).hazards), DRESSING);\\n    assert_ne!(contextual_tool(gel, 8.0, 3.0, &game(&sim).hazards), DRESSING);\\n480→    place(&mut sim, dressing.x, dressing.z, gel, true, 0);\\n    assert_eq!(game(&sim).surgeons[0].tool, DRESSING, \\\"a closure must auto-select dressing\\\");\\n    let offsets = [(0.55_f32, 0.0), (0.0, 0.55), (-0.55, 0.0), (0.0, -0.55)];\\n    for _ in 0..4 {\\n        if alive_id(&sim, did).is_none() {\\n            break;\\n        }\\n        for (dx, dz) in offsets {\\n            let Some(h) = alive_id(&sim, did) else { break };\\n            for _ in 0..8 {\\n490→                if alive_id(&sim, did).is_none() {\\n                    break;\\n                }\\n                let sent = mapped(&mut sim, h.x + dx, h.z + dz, gel, true, 0);\\n                assert_eq!(sent, DRESSING);\\n            }\\n        }\\n    }\\n    let left = alive_id(&sim, did);\\n    assert!(left.is_none(), \\\"dressing {:?} {}\\\", left.map(|h| (h.bits, h.work)), status(&sim));\\n500→}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/tests/surgery.rs\",\"offset\":320,\"limit\":220,\"raw_output\":\"    let mut held = surg::AIM_ABSOLUTE | surg::SNAP | surg::PRECISION | extra;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    sim.step(&frame);\\n}\\n\\n/// Ring tools stay 0–7. Cryoprobe and Dressing are whatever `contextual_tool` returns.\\nfn mapped(sim: &mut Sim, x: f32, z: f32, ring: u8, use_on: bool, extra: u32) -> u8 {\\n    assert!(ring <= 7, \\\"ring {ring} is outside the eight-way\\\");\\n    let tool = contextual_tool(ring, x, z, &game(sim).hazards);\\n    place(sim, x, z, tool, use_on, extra);\\n    tool\\n}\\n\\nfn wake(sim: &mut Sim) {\\n    place(sim, -8.0, -3.0, TOOL_KEEP, false, 0);\\n}\\n\\nfn alive_id(sim: &Sim, id: u32) -> Option<Hazard> {\\n    game(sim).hazards.iter().find(|h| h.id == id && h.alive).cloned()\\n}\\n\\nfn alive_kind(sim: &Sim, kind: u8) -> Option<Hazard> {\\n    game(sim).hazards.iter().find(|h| h.kind == kind && h.alive).cloned()\\n}\\n\\n#[test]\\nfn shipped_mapping_clears_an_ember_and_a_dressing() {\\n    let mut sim = Sim::new(\\\"surgery/case/5\\\", 1).unwrap();\\n    wake(&mut sim);\\n    let ember = alive_kind(&sim, K_EMBER).expect(\\\"case 5 ember\\\");\\n    let id = ember.id;\\n    let down = octant(Vec2::new(0.0, -1.0)).expect(\\\"down\\\");\\n    let left = octant(Vec2::new(-1.0, 0.0)).expect(\\\"left\\\");\\n    assert_eq!(down, LASER);\\n    assert_eq!(left, SCANNER);\\n    assert!(octant(Vec2::new(0.2, 0.2)).is_none(), \\\"a short flick must not pick a tool\\\");\\n    assert_eq!(contextual_tool(down, ember.x, ember.z, &game(&sim).hazards), CRYO);\\n    assert_eq!(contextual_tool(left, ember.x, ember.z, &game(&sim).hazards), CRYO);\\n\\n    place(&mut sim, ember.x, ember.z, down, true, 0);\\n    assert_eq!(game(&sim).surgeons[0].tool, CRYO, \\\"laser on an ember must become the cryoprobe\\\");\\n    for _ in 0..80 {\\n        let Some(h) = alive_id(&sim, id) else {\\n            panic!(\\\"ember died during frost {}\\\", status(&sim));\\n        };\\n        if h.stage > 0 {\\n            break;\\n        }\\n        if h.aux >= 0.86 {\\n            let sent = mapped(&mut sim, h.x, h.z, down, false, 0);\\n            assert_eq!(sent, CRYO);\\n            break;\\n        }\\n        let sent = mapped(&mut sim, h.x, h.z, down, true, 0);\\n        assert_eq!(sent, CRYO);\\n    }\\n    let h = alive_id(&sim, id).unwrap_or_else(|| panic!(\\\"frost did not hold {}\\\", status(&sim)));\\n    assert!(h.stage >= 1, \\\"ember stage {} aux {} {}\\\", h.stage, h.aux, status(&sim));\\n\\n    let scalpel = cycle(cycle(SCANNER, true), true);\\n    assert_eq!(scalpel, SCALPEL);\\n    for _ in 0..90 {\\n        let Some(h) = alive_id(&sim, id) else { panic!(\\\"ember died under the scalpel {}\\\", status(&sim)) };\\n        if h.stage >= 2 {\\n            break;\\n        }\\n        mapped(&mut sim, h.x, h.z, scalpel, true, 0);\\n    }\\n    let h = alive_id(&sim, id).unwrap_or_else(|| panic!(\\\"scalpel missed {}\\\", status(&sim)));\\n    assert!(h.stage >= 2, \\\"stage {} {}\\\", h.stage, status(&sim));\\n\\n    let forceps = tray_tool(-3.5 + FORCEPS as f32, 5.4).expect(\\\"forceps slot\\\");\\n    assert_eq!(forceps, FORCEPS);\\n    assert!(tray_tool(0.0, 0.0).is_none());\\n    let h = alive_id(&sim, id).unwrap();\\n    mapped(&mut sim, h.x, h.z, forceps, true, 0);\\n    let h = alive_id(&sim, id).unwrap_or_else(|| panic!(\\\"grab lost the ember {}\\\", status(&sim)));\\n    assert!(h.grabbed, \\\"forceps did not grab {}\\\", status(&sim));\\n    let (dirx, dirz) = (h.axis.cos(), h.axis.sin());\\n    mapped(&mut sim, h.x + dirx * 0.9, h.z + dirz * 0.9, forceps, true, 0);\\n    assert!(alive_id(&sim, id).is_none(), \\\"ember still alive {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/2\\\", 2).unwrap();\\n    wake(&mut sim);\\n    let bone = alive_kind(&sim, K_BONE).expect(\\\"bone\\\");\\n    let bid = bone.id;\\n    let up_right = octant(Vec2::new(1.0, 1.0)).unwrap();\\n    assert_eq!(up_right, FORCEPS);\\n    for _ in 0..90 {\\n        let Some(h) = alive_id(&sim, bid) else { break };\\n        if h.stage > 0 {\\n            break;\\n        }\\n        let extra = if h.aux > 12.0 {\\n            surg::ROT_L\\n        } else if h.aux < -12.0 {\\n            surg::ROT_R\\n        } else {\\n            0\\n        };\\n        mapped(&mut sim, h.x, h.z, up_right, true, extra);\\n    }\\n    {\\n        let h = alive_id(&sim, bid).unwrap_or_else(|| panic!(\\\"bone broke early {}\\\", status(&sim)));\\n        assert_eq!(h.stage, 1, \\\"bone aux {} {}\\\", h.aux, status(&sim));\\n    }\\n    let suture = cycle(FORCEPS, true);\\n    assert_eq!(suture, SUTURE);\\n    for _ in 0..12 {\\n        let Some(h) = alive_id(&sim, bid) else { break };\\n        let (dirx, dirz) = (h.axis.cos(), h.axis.sin());\\n        let span = h.need.max(0.4);\\n        let n = h.samples_need.max(1) as f32;\\n        let along = -span * 0.5 + (h.samples as f32 + 0.5) * (span / n);\\n        for side in [0.5_f32, -0.5] {\\n            let Some(h) = alive_id(&sim, bid) else { break };\\n            let x = h.x + dirx * along - dirz * side;\\n            let z = h.z + dirz * along + dirx * side;\\n            mapped(&mut sim, x, z, suture, true, 0);\\n        }\\n    }\\n    assert!(alive_id(&sim, bid).is_none(), \\\"bone still open {}\\\", status(&sim));\\n\\n    let tether = alive_kind(&sim, K_TETHER).unwrap_or_else(|| panic!(\\\"tether {}\\\", status(&sim)));\\n    let tid = tether.id;\\n    let up = octant(Vec2::new(0.0, 1.0)).unwrap();\\n    assert_eq!(up, SCALPEL);\\n    let mut along = 0.0;\\n    for _ in 0..24 {\\n        let Some(h) = alive_id(&sim, tid) else { break };\\n        let x = h.x + h.axis.cos() * along;\\n        let z = h.z + h.axis.sin() * along;\\n        mapped(&mut sim, x, z, up, true, 0);\\n        along = (along + 0.28).min(h.need + 0.25);\\n    }\\n    assert!(alive_id(&sim, tid).is_none(), \\\"tether still there {}\\\", status(&sim));\\n\\n    for _ in 0..4 {\\n        if alive_kind(&sim, K_DRESSING).is_some() {\\n            break;\\n        }\\n        wake(&mut sim);\\n    }\\n    let dressing = alive_kind(&sim, K_DRESSING).unwrap_or_else(|| panic!(\\\"no dressing {}\\\", status(&sim)));\\n    let did = dressing.id;\\n    let gel = octant(Vec2::new(-1.0, -1.0)).unwrap();\\n    assert_eq!(gel, GEL);\\n    assert_eq!(contextual_tool(gel, dressing.x, dressing.z, &game(&sim).hazards), DRESSING);\\n    assert_ne!(contextual_tool(gel, 8.0, 3.0, &game(&sim).hazards), DRESSING);\\n    place(&mut sim, dressing.x, dressing.z, gel, true, 0);\\n    assert_eq!(game(&sim).surgeons[0].tool, DRESSING, \\\"a closure must auto-select dressing\\\");\\n    let offsets = [(0.55_f32, 0.0), (0.0, 0.55), (-0.55, 0.0), (0.0, -0.55)];\\n    for _ in 0..4 {\\n        if alive_id(&sim, did).is_none() {\\n            break;\\n        }\\n        for (dx, dz) in offsets {\\n            let Some(h) = alive_id(&sim, did) else { break };\\n            for _ in 0..8 {\\n                if alive_id(&sim, did).is_none() {\\n                    break;\\n                }\\n                let sent = mapped(&mut sim, h.x + dx, h.z + dz, gel, true, 0);\\n                assert_eq!(sent, DRESSING);\\n            }\\n        }\\n    }\\n    let left = alive_id(&sim, did);\\n    assert!(left.is_none(), \\\"dressing {:?} {}\\\", left.map(|h| (h.bits, h.work)), status(&sim));\\n}\\n\",\"total_lines\":500}}","is_error":false},{"type":"tool_result","tool_use_id":"call-537e20e6-6c63-469f-8ab0-8877ab6b7ac6-82","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"320→            if inp.tool != TOOL_KEEP {\\n                g.surgeons[i].tool = inp.tool.min(DEFIB);\\n            }\\n            steer(&mut g.surgeons[i], inp, dt, g.tune.cursor_speed);\\n        }\\n        g.surgeons[i].x = g.surgeons[i].x.clamp(X_MIN, X_MAX);\\n        g.surgeons[i].z = g.surgeons[i].z.clamp(Z_MIN, Z_MAX);\\n        g.surgeons[i].wrong_cd = (g.surgeons[i].wrong_cd - dt).max(0.0);\\n        g.surgeons[i].iv_cd = (g.surgeons[i].iv_cd - dt).max(0.0);\\n        g.surgeons[i].since_chain += dt;\\n330→\\n        let (mut x, mut z) = (g.surgeons[i].x, g.surgeons[i].z);\\n        let precise = inp.held & surg::PRECISION != 0;\\n        let echo = g.echo_left > 0.0;\\n        if i == 0 && !precise && !echo && g.tune.tremor > 0.0 {\\n            let w = 0.12 * g.tune.tremor;\\n            let t = tick as f32;\\n            x += (t * 0.73).sin() * w;\\n            z += (t * 0.51).cos() * w;\\n        }\\n340→        let use_held = inp.held & surg::USE != 0;\\n        let just_release = g.surgeons[i].was_use && !use_held;\\n        let ring = g.surgeons[i].tool;\\n        let tool = contextual_tool(ring, x, z, &g.hazards);\\n        g.surgeons[i].tool = tool;\\n        if g.heat_on && use_held && heat_hit(g.heat_angle, x, z) {\\n            g.heart.vitals = (g.heart.vitals - 8.0).max(0.0);\\n            g.surgeons[i].chain = 0;\\n            g.mistakes = g.mistakes.saturating_add(1);\\n            g.callout_i = 4;\\n350→            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n360→        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\",\"content_concise\":\"320→            if inp.tool != TOOL_KEEP {\\n                g.surgeons[i].tool = inp.tool.min(DEFIB);\\n            }\\n            steer(&mut g.surgeons[i], inp, dt, g.tune.cursor_speed);\\n        }\\n        g.surgeons[i].x = g.surgeons[i].x.clamp(X_MIN, X_MAX);\\n        g.surgeons[i].z = g.surgeons[i].z.clamp(Z_MIN, Z_MAX);\\n        g.surgeons[i].wrong_cd = (g.surgeons[i].wrong_cd - dt).max(0.0);\\n        g.surgeons[i].iv_cd = (g.surgeons[i].iv_cd - dt).max(0.0);\\n        g.surgeons[i].since_chain += dt;\\n330→\\n        let (mut x, mut z) = (g.surgeons[i].x, g.surgeons[i].z);\\n        let precise = inp.held & surg::PRECISION != 0;\\n        let echo = g.echo_left > 0.0;\\n        if i == 0 && !precise && !echo && g.tune.tremor > 0.0 {\\n            let w = 0.12 * g.tune.tremor;\\n            let t = tick as f32;\\n            x += (t * 0.73).sin() * w;\\n            z += (t * 0.51).cos() * w;\\n        }\\n340→        let use_held = inp.held & surg::USE != 0;\\n        let just_release = g.surgeons[i].was_use && !use_held;\\n        let ring = g.surgeons[i].tool;\\n        let tool = contextual_tool(ring, x, z, &g.hazards);\\n        g.surgeons[i].tool = tool;\\n        if g.heat_on && use_held && heat_hit(g.heat_angle, x, z) {\\n            g.heart.vitals = (g.heart.vitals - 8.0).max(0.0);\\n            g.surgeons[i].chain = 0;\\n            g.mistakes = g.mistakes.saturating_add(1);\\n            g.callout_i = 4;\\n350→            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n360→        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"offset\":320,\"limit\":50,\"raw_output\":\"            if inp.tool != TOOL_KEEP {\\n                g.surgeons[i].tool = inp.tool.min(DEFIB);\\n            }\\n            steer(&mut g.surgeons[i], inp, dt, g.tune.cursor_speed);\\n        }\\n        g.surgeons[i].x = g.surgeons[i].x.clamp(X_MIN, X_MAX);\\n        g.surgeons[i].z = g.surgeons[i].z.clamp(Z_MIN, Z_MAX);\\n        g.surgeons[i].wrong_cd = (g.surgeons[i].wrong_cd - dt).max(0.0);\\n        g.surgeons[i].iv_cd = (g.surgeons[i].iv_cd - dt).max(0.0);\\n        g.surgeons[i].since_chain += dt;\\n\\n        let (mut x, mut z) = (g.surgeons[i].x, g.surgeons[i].z);\\n        let precise = inp.held & surg::PRECISION != 0;\\n        let echo = g.echo_left > 0.0;\\n        if i == 0 && !precise && !echo && g.tune.tremor > 0.0 {\\n            let w = 0.12 * g.tune.tremor;\\n            let t = tick as f32;\\n            x += (t * 0.73).sin() * w;\\n            z += (t * 0.51).cos() * w;\\n        }\\n        let use_held = inp.held & surg::USE != 0;\\n        let just_release = g.surgeons[i].was_use && !use_held;\\n        let ring = g.surgeons[i].tool;\\n        let tool = contextual_tool(ring, x, z, &g.hazards);\\n        g.surgeons[i].tool = tool;\\n        if g.heat_on && use_held && heat_hit(g.heat_angle, x, z) {\\n            g.heart.vitals = (g.heart.vitals - 8.0).max(0.0);\\n            g.surgeons[i].chain = 0;\\n            g.mistakes = g.mistakes.saturating_add(1);\\n            g.callout_i = 4;\\n            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\\n\",\"total_lines\":811}}","is_error":false},{"type":"tool_result","tool_use_id":"call-537e20e6-6c63-469f-8ab0-8877ab6b7ac6-83","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"720→        }\\n        let dx = h.x - x;\\n        let dz = h.z - z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        if d < 1.2 && best.map(|(bd, _, _)| d < bd).unwrap_or(true) {\\n            best = Some((d, dx, dz));\\n        }\\n    }\\n    let Some((d, dx, dz)) = best else { return aim };\\n    let closeness = (1.0 - d / 1.2).clamp(0.0, 1.0) * scale.min(1.0);\\n730→    let mut aim = aim * (1.0 - 0.5 * closeness);\\n    if d > 0.02 {\\n        let inv = 1.0 / d;\\n        let pull = 3.0 * dt * closeness;\\n        let extra = pull / (g.tune.cursor_speed.max(1.0) * dt.max(1e-4));\\n        aim.x += dx * inv * extra;\\n        aim.y += dz * inv * extra;\\n    }\\n    aim\\n}\\n740→\\nfn mirror_predict(g: &mut Surgery, input: &InputFrame, dt: f32) {\\n    for (i, inp) in input.surgeons.iter().enumerate() {\\n        if !inp.active {\\n            continue;\\n        }\\n        let (tool, x, z) = {\\n            let s = &mut g.surgeons[i];\\n            s.active = true;\\n            if inp.tool != TOOL_KEEP {\\n750→                s.tool = inp.tool;\\n            }\\n            steer(s, *inp, dt, g.tune.cursor_speed);\\n            (s.tool, s.x, s.z)\\n        };\\n        g.surgeons[i].tool = contextual_tool(tool, x, z, &g.hazards);\\n    }\\n}\\n\\nfn steer(s: &mut Surgeon, inp: SurgeonInput, dt: f32, speed: f32) {\\n760→    let abs = inp.held