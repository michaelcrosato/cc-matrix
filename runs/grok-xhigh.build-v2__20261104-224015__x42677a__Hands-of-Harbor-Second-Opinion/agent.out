e pav_core::{Sim, SimState};\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n10→\\nfn set_skill(sim: &mut Sim, skill: f32) {\\n    sim.state.play.as_mut().unwrap().get_mut::<pav_core::games::surgery::Surgery>().unwrap().skill = skill;\\n}\\n\\n#[test]\\nfn debug_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    for n in [60, 180, 400, 800] {\\n        while sim.state.tick < n {\\n20→            let f = sim.bot_input();\\n            sim.step(&f);\\n        }\\n        let g = sim.play().unwrap().get::<pav_core::games::surgery::Surgery>().unwrap();\\n        let s = &g.surgeons[0];\\n        eprintln!(\\n            \\\"t={} cursor=({:.2},{:.2}) tool={} use={} focus_t={:.2} vitals={:.1}\\\",\\n            sim.state.tick, s.x, s.z, s.tool, s.was_use, s.focus_t, g.heart.vitals\\n        );\\n        for h in &g.hazards {\\n30→            eprintln!(\\n                \\\"  kind={} pos=({:.2},{:.2}) work={:.2} need={:.2} samples={}/{} aux={:.2} aux2={:.2} alive={} tool={} grab={}\\\",\\n                h.kind, h.x, h.z, h.work, h.need, h.samples, h.samples_need, h.aux, h.aux2, h.alive, h.tool, h.grabbed\\n            );\\n        }\\n    }\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n40→    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    let (outcome, ticks) = sim.run_bot(60 * 180);\\n    assert_eq!(outcome, Outcome::Won, \\\"{ticks} ticks {}\\\", status(&sim));\\n    let rank = sim.play().unwrap().status(&sim)[\\\"rank_n\\\"].as_u64().unwrap_or(0);\\n    assert!(rank >= 4, \\\"skill 1 should clear S, {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn idle_loses_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n50→    for _ in 0..(60 * 90) {\\n        if sim.outcome() == Outcome::Lost {\\n            break;\\n        }\\n        sim.step(&InputFrame::default());\\n    }\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n}\\n\",\"content_concise\":\"1→//! Hands of Harbor: the shipped sim, from a fresh scene, played by its own bot.\\n\\nuse pav_core::games::Outcome;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::{Sim, SimState};\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n10→\\nfn set_skill(sim: &mut Sim, skill: f32) {\\n    sim.state.play.as_mut().unwrap().get_mut::<pav_core::games::surgery::Surgery>().unwrap().skill = skill;\\n}\\n\\n#[test]\\nfn debug_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    for n in [60, 180, 400, 800] {\\n        while sim.state.tick < n {\\n20→            let f = sim.bot_input();\\n            sim.step(&f);\\n        }\\n        let g = sim.play().unwrap().get::<pav_core::games::surgery::Surgery>().unwrap();\\n        let s = &g.surgeons[0];\\n        eprintln!(\\n            \\\"t={} cursor=({:.2},{:.2}) tool={} use={} focus_t={:.2} vitals={:.1}\\\",\\n            sim.state.tick, s.x, s.z, s.tool, s.was_use, s.focus_t, g.heart.vitals\\n        );\\n        for h in &g.hazards {\\n30→            eprintln!(\\n                \\\"  kind={} pos=({:.2},{:.2}) work={:.2} need={:.2} samples={}/{} aux={:.2} aux2={:.2} alive={} tool={} grab={}\\\",\\n                h.kind, h.x, h.z, h.work, h.need, h.samples, h.samples_need, h.aux, h.aux2, h.alive, h.tool, h.grabbed\\n            );\\n        }\\n    }\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n40→    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    let (outcome, ticks) = sim.run_bot(60 * 180);\\n    assert_eq!(outcome, Outcome::Won, \\\"{ticks} ticks {}\\\", status(&sim));\\n    let rank = sim.play().unwrap().status(&sim)[\\\"rank_n\\\"].as_u64().unwrap_or(0);\\n    assert!(rank >= 4, \\\"skill 1 should clear S, {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn idle_loses_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n50→    for _ in 0..(60 * 90) {\\n        if sim.outcome() == Outcome::Lost {\\n            break;\\n        }\\n        sim.step(&InputFrame::default());\\n    }\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/tests/surgery.rs\",\"offset\":null,\"limit\":120,\"raw_output\":\"//! Hands of Harbor: the shipped sim, from a fresh scene, played by its own bot.\\n\\nuse pav_core::games::Outcome;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::{Sim, SimState};\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn set_skill(sim: &mut Sim, skill: f32) {\\n    sim.state.play.as_mut().unwrap().get_mut::<pav_core::games::surgery::Surgery>().unwrap().skill = skill;\\n}\\n\\n#[test]\\nfn debug_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    for n in [60, 180, 400, 800] {\\n        while sim.state.tick < n {\\n            let f = sim.bot_input();\\n            sim.step(&f);\\n        }\\n        let g = sim.play().unwrap().get::<pav_core::games::surgery::Surgery>().unwrap();\\n        let s = &g.surgeons[0];\\n        eprintln!(\\n            \\\"t={} cursor=({:.2},{:.2}) tool={} use={} focus_t={:.2} vitals={:.1}\\\",\\n            sim.state.tick, s.x, s.z, s.tool, s.was_use, s.focus_t, g.heart.vitals\\n        );\\n        for h in &g.hazards {\\n            eprintln!(\\n                \\\"  kind={} pos=({:.2},{:.2}) work={:.2} need={:.2} samples={}/{} aux={:.2} aux2={:.2} alive={} tool={} grab={}\\\",\\n                h.kind, h.x, h.z, h.work, h.need, h.samples, h.samples_need, h.aux, h.aux2, h.alive, h.tool, h.grabbed\\n            );\\n        }\\n    }\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwra