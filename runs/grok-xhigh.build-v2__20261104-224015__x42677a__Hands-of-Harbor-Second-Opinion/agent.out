ress + PROGRESS_EVERY_MS - now();\\n    if (wait <= 0) sendProgress();\\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\\n  };\\n\\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\\n  hub.probe = function (fn) {\\n    probeFn = typeof fn === 'function' ? fn : null;\\n  };\\n\\n  hub.inspect = function () {\\n    if (!probeFn) return null;\\n    try {\\n      return JSON.parse(JSON.stringify(probeFn()));\\n    } catch (e) {\\n      return { error: String((e && e.message) || e) };\\n    }\\n  };\\n\\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\\n  hub.fail = function (message) {\\n    if (!hub.active) return;\\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\\n  };\\n\\n  root.AIHub = hub;\\n})(typeof window !== 'undefined' ? window : globalThis);\\n\",\"total_lines\":488}}","is_error":false},{"type":"tool_result","tool_use_id":"call-14deea75-7a34-4224-93c3-1e87d5bd15a6-30","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,50,52,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,116,109,112,47,103,114,111,107,45,103,111,97,108,45,57,48,55,99,99,99,97,53,99,101,51,98,47,105,109,112,108,101,109,101,110,116,101,114,4