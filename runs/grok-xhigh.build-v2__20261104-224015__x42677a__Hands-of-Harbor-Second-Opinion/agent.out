se => match self.focus {\"},{\"line_number\":579,\"content\":\"                    self.screen = Screen::Hud;\"},{\"line_number\":582,\"content\":\"                2 => self.screen = Screen::Controls,\"},{\"line_number\":583,\"content\":\"                3 => self.screen = Screen::Settings,\"},{\"line_number\":585,\"content\":\"                    self.screen = Screen::Dev;\"},{\"line_number\":586,\"content\":\"                    self.focus = 0;\"},{\"line_number\":590,\"content\":\"                    self.screen = Screen::Title;\"},{\"line_number\":595,\"content\":\"                if self.focus == 0 {\"},{\"line_number\":597,\"content\":\"                } else if self.focus == 1 {\"},{\"line_number\":599,\"content\":\"                } else if self.focus >= 8 {\"},{\"line_number\":603,\"content\":\"            Screen::Settings if self.settings_page == 1 && self.focus == 0 => self.xbox = !self.xbox,\"},{\"line_number\":615,\"content\":\"        self.music = 0.10;\"},{\"line_number\":632,\"content\":\"        self.screen = Screen::Dev;\"},{\"line_number\":633,\"content\":\"        self.focus = 2;\"},{\"line_number\":703,\"content\":\"        match shell.screen {\"},{\"line_number\":740,\"content\":\"                    if shell.screen == Screen::Title || shell.screen == Screen::Menu || shell.screen == Screen::Attract {\"},{\"line_number\":746,\"content\":\"                    if i == 0 && (shell.screen == Screen::Title || shell.screen == Screen::Menu) {\"},{\"line_number\":749,\"content\":\"                    let y_focus = line.starts_with('>');\"},{\"line_number\":750,\"content\":\"                    let color = if y_focus {\"},{\"line_number\":757,\"content\":\"                        ui.label(egui::RichText::new(line).size(if y_focus { 48.0 } else { 40.0 }).color(color));\"},{\"line_number\":761,\"content\":\"                if shell.screen == Screen::Attract {\"},{\"line_number\":811,\"content\":\"        assert_eq!(s.screen_name(), \\\"title\\\");\"},{\"line_number\":814,\"content\":\"        assert_eq!(s.screen_name(), \\\"menu\\\");\"},{\"line_number\":824,\"content\":\"        assert_eq!(s.focus(), 2);\"},{\"line_number\":826,\"content\":\"        assert_eq!(s.screen_name(), \\\"files\\\");\"},{\"line_number\":828,\"content\":\"        assert_eq!(s.screen_name(), \\\"menu\\\");\"},{\"line_number\":829,\"content\":\"        s.focus = 1;\"},{\"line_number\":831,\"content\":\"        assert_eq!(s.screen_name(), \\\"difficulty\\\");\"},{\"line_number\":835,\"content\":\"        assert_eq!(s.screen_name(), \\\"story\\\");\"},{\"line_number\":838,\"content\":\"        assert_eq!(s.screen_name(), \\\"op\\\");\"},{\"line_number\":840,\"content\":\"        assert_eq!(s.screen_name(), \\\"pause\\\");\"},{\"line_number\":842,\"content\":\"        s.focus = 4;\"},{\"line_number\":844,\"content\":\"        assert_eq!(s.screen_name(), \\\"dev\\\");\"},{\"line_number\":846,\"content\":\"        assert_eq!(s.screen_name(), \\\"dev\\\");\"},{\"line_number\":849,\"content\":\"        assert_eq!(s.screen_name(), \\\"dead\\\");\"},{\"line_number\":851,\"content\":\"        assert_eq!(s.screen_name(), \\\"chart\\\");\"},{\"line_number\":853,\"content\":\"        assert_eq!(s.screen_name(), \\\"card\\\");\"},{\"line_number\":855,\"content\":\"        assert_eq!(s.screen_name(), \\\"story\\\");\"},{\"line_number\":857,\"content\":\"        assert_eq!(s.screen_name(), \\\"op\\\");\"},{\"line_number\":864,\"content\":\"        assert_eq!(s.screen_name(), \\\"title\\\");\"},{\"line_number\":866,\"content\":\"        assert_eq!(s.screen_name(), \\\"attract\\\");\"},{\"line_number\":869,\"content\":\"        assert_eq!(s.screen_name(), \\\"title\\\");\"},{\"line_number\":874,\"content\":\"        assert_eq!(s.screen_name(), \\\"title\\\");\"},{\"line_number\":879,\"content\":\"        assert_eq!(s.screen_name(), \\\"title\\\");\"},{\"line_number\":891,\"content\":\"        assert_eq!(s.screen_name(), \\\"settings\\\");\"},{\"line_number\":89