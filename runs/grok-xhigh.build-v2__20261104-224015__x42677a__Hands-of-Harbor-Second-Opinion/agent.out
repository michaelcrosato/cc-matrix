5,101,119,66,117,105,108,100,101,114,44,32,86,105,101,119,83,101,116,116,105,110,103,115,125,59,10,50,50,50,58,32,32,32,32,32,32,32,32,32,32,32,32,115,101,108,102,46,99,97,109,101,114,97,46,115,110,97,112,40,103,108,97,109,58,58,86,101,99,51,58,58,110,101,119,40,48,46,48,44,32,48,46,48,44,32,48,46,50,41,41,59,10,52,49,56,58,32,32,32,32,112,117,98,32,102,110,32,114,101,110,100,101,114,95,119,105,116,104,95,99,97,109,101,114,97,40,38,109,117,116,32,115,101,108,102,44,32,119,105,100,116,104,58,32,117,51,50,44,32,104,101,105,103,104,116,58,32,117,51,50,41,32,45,62,32,82,101,115,117,108,116,60,40,86,101,99,60,117,56,62,44,32,103,108,97,109,58,58,77,97,116,52,41,62,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":8,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_tools/src/session.rs\",\"matches\":[{\"line_number\":1,\"content\":\"use anyhow::Result;\"},{\"line_number\":2,\"content\":\"use glam::Vec3;\"},{\"line_number\":3,\"content\":\"use pav_core::params::{ParamVisitor, Tunable, nested};\"},{\"line_number\":4,\"content\":\"use pav_core::{InputFrame, RenderFrame, Sim, SimConfig};\"},{\"line_number\":5,\"content\":\"use pav_render::{Renderer, gpu::Headless};\"},{\"line_number\":6,\"content\":\"use pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\"},{\"line_number\":222,\"content\":\"            self.camera.snap(glam::Vec3::new(0.0, 0.0, 0.2));\"},{\"line_number\":418,\"content\":\"    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-b3439f6d-ce15-4728-86c7-d1febf46ce31-163","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,101,110,103,105,110,101,45,108,105,110,107,47,99,114,97,116,101,115,47,112,97,118,95,99,111,114,101,47,115,114,99,47,115,105,109,46,114,115,10,52,56,56,58,32,32,32,32,112,117,98,32,102,110,32,115,116,101,112,40,38,109,117,116,32,115,101,108,102,44,32,105,110,112,117,116,58,32,38,73,110,112,117,116,70,114,97,109,101,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":1,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/src/sim.rs\",\"matches\":[{\"line_number\":488,\"content\":\"    pub fn step(&mut self, input: &InputFrame) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"b5234db6-c449-4c24-bdbe-c6a8cd5b97ed"}
{"type":"assistant","message":{"id":"msg_276","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The session already uses `glam::Vec3`, so calling `glam::Vec3::new` is redundant but harmless.","signature":""},{"type":"text","text":"The sim now takes shell commands once and clears button edges after each tick. I’m adding the product frame that owns input, drawing, and sound for a surgery scene."},{"type":"tool_use","id":"call-a3fb30e0-fe89-407a-8679-2879dbd971fc-164","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_app/src/product.rs","new_string":"//! Hands of Harbor's frame. A surgery scene never enters the demo menu, camera, or touch layer.\n\nuse std::cell::{Cell, RefCell};\nuse std::collections::HashSet;\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::{self, Surgery, SurgeryFrame, TITLE, TOOL_KEEP};\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\nuse pav_ui::surgery::{Cmd, DeviceKind, Input as ShellIn, Shell};\nuse pav_view::{CameraParams, ViewSettings};\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::ActiveEventLoop;\nuse winit::keyboard::{KeyCode, PhysicalKey};\nuse winit::window::WindowId;\n\nuse super::App;\n\nstruct PadHand {\n    present: bool,\n    left: Vec2,\n    right: Vec2,\n    south: bool,\n    east: bool,\n    north: bool,\n    west: bool,\n    l1: bool,\n    r1: bool,\n    start: bool,\n    up: bool,\n    down: bool,\n    left_b: bool,\n    right_b: bool,\n    lt: f32,\n    rt: f32,\n}\n\nimpl Default for PadHand {\n    fn default() -> Self {\n        Self {\n            present: false,\n            left: Vec2::ZERO,\n            right: Vec2::ZERO,\n            south: false,\n            east: false,\n            north: false,\n            west: false,\n            l1: false,\n            r1: false,\n            start: false,\n            up: false,\n            down: false,\n            left_b: false,\n            right_b: false,\n            lt: 0.0,\n            rt: 0.0,\n        }\n    }\n}\n\npub struct Harbor {\n    pub shell: Shell,\n    keys: HashSet<KeyCode>,\n    just: Vec<KeyCode>,\n    mouse: Vec2,\n    mouse_left: bool,\n    mouse_right: bool,\n    mouse_click: bool,\n    mouse_moved: bool,\n    wheel: f32,\n    touch_click: bool,\n    pads: [PadHand; 4],\n    prev_oct: [Option<u8>; 4],\n    prev_l1: [bool; 4],\n    prev_r1: [bool; 4],\n    tool: [u8; 4],\n    font: bool,\n    music_name: String,\n    music_left: f32,\n    status: String,\n}\n\nimpl Harbor {\n    pub fn new(touch_only: bool) -> Self {\n        let mut shell = Shell::new();\n        shell.touch_only = touch_only;\n        Self {\n            shell,\n            keys: HashSet::new(),\n            just: Vec::new(),\n            mouse: Vec2::ZERO,\n            mouse_left: false,\n            mouse_right: false,\n            mouse_click: false,\n            mouse_moved: false,\n            wheel: 0.0,\n            touch_click: false,\n            pads: std::array::from_fn(|_| PadHand::default()),\n            prev_oct: [None; 4],\n            prev_l1: [false; 4],\n            prev_r1: [false; 4],\n            tool: [0; 4],\n            font: false,\n            music_name: String::new(),\n            music_left: 0.0,\n            status: String::new(),\n        }\n    }\n\n    fn key(&self, code: KeyCode) -> bool {\n        self.keys.contains(&code)\n    }\n\n    fn ate(&mut self, code: KeyCode) -> bool {\n        let hit = self.just.contains(&code);\n        if hit {\n            self.just.retain(|k| *k != code);\n        }\n        hit\n    }\n\n    fn poll_pads(&mut self, gilrs: Option<&mut gilrs::Gilrs>) {\n        for p in &mut self.pads {\n            p.present = false;\n        }\n        let Some(g) = gilrs else { return };\n        while g.next_event().is_some() {}\n        for (i, (_, gp)) in g.gamepads().take(4).enumerate() {\n            use gilrs::{Axis, Button};\n            let pressed = |b: Button| gp.is_pressed(b);\n            let analog = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0);\n            self.pads[i] = PadHand {\n                present: true,\n                left: dead(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY))),\n                right: dead(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY))),\n                south: pressed(Button::South),\n                east: pressed(Button::East),\n                north: pressed(Button::North),\n                west: pressed(Button::West),\n                l1: pressed(Button::LeftTrigger),\n                r1: pressed(Button::RightTrigger),\n                start: pressed(Button::Start),\n                up: pressed(Button::DPadUp),\n                down: pressed(Button::DPadDown),\n                left_b: pressed(Button::DPadLeft),\n                right_b: pressed(Button::DPadRight),\n                lt: analog(Button::LeftTrigger2),\n                rt: analog(Button::RightTrigger2),\n            };\n        }\n    }\n\n    /// Shell step plus one frame of surgeon hands. `aim` is the mouse on the field, if it hit.\n    fn compose(&mut self, dt: f32, aim: Option<[f32; 2]>) -> (Vec<Cmd>, [SurgeonInput; 4], bool) {\n        let op = self.shell.screen_name() == \"op\";\n        let pad0 = &self.pads[0];\n        let pad_nav = pad0.present && (pad0.up || pad0.down || pad0.south || pad0.east || pad0.start || pad0.left.length() > 0.2 || pad0.right.length() > 0.2);\n        let mouse_fine = self.mouse_moved || self.mouse_click || self.just.iter().any(|k| !matches!(k, KeyCode::F1 | KeyCode::F2 | KeyCode::F3));\n        let device = if pad_nav && !mouse_fine { Some(DeviceKind::Gamepad) } else if mouse_fine || !self.just.is_empty() { Some(DeviceKind::KeyboardMouse) } else { None };\n        let up = self.ate(KeyCode::ArrowUp) || edge_pad(pad0.up, false);\n        let down = self.ate(KeyCode::ArrowDown) || pad0.down && !op;\n        let left = self.ate(KeyCode::ArrowLeft) || pad0.left_b;\n        let right = self.ate(KeyCode::ArrowRight) || pad0.right_b;\n        let confirm = self.ate(KeyCode::Enter) || self.ate(KeyCode::NumpadEnter) || self.ate(KeyCode::Space) && !op || (pad0.south && !op);\n        let back = self.ate(KeyCode::Escape) || pad0.east && !op || pad0.start;\n        let any = device.is_some() || self.mouse_moved || self.touch_click || self.mouse_click || back || confirm || up || down;\n        let pointer = if op { None } else { Some([self.mouse.x, self.mouse.y]) };\n        let click = !op && (self.mouse_click || self.touch_click);\n        let cmds = self.shell.step(ShellIn {\n            up: !op && up,\n            down: !op && down,\n            left: !op && left,\n            right: !op && right,\n            confirm: !op && confirm,\n            back,\n            tab_l: self.ate(KeyCode::PageUp) || self.ate(KeyCode::BracketLeft),\n            tab_r: self.ate(KeyCode::PageDown) || self.ate(KeyCode::BracketRight),\n            pointer,\n            click,\n            any,\n            dt,\n            device,\n        });\n        let confirm_sim = cmds.iter().any(|c| matches!(c, Cmd::ConfirmSim));\n        self.tools_from_hands(op);\n        let mut surgeons = [SurgeonInput { tool: TOOL_KEEP, ..SurgeonInput::default() }; 4];\n        if op {\n            for i in 0..4 {\n                surgeons[i] = self.hand(i, aim, i == 0 && self.mouse_moved);\n            }\n        } else if confirm_sim {\n            surgeons[0].active = true;\n            surgeons[0].tool = TOOL_KEEP;\n            surgeons[0].held |= surg::CONFIRM;\n            surgeons[0].pressed |= surg::CONFIRM;\n        }\n        self.mouse_click = false;\n        self.mouse_moved = false;\n        self.touch_click = false;\n        self.wheel = 0.0;\n        self.just.clear();\n        (cmds, surgeons, confirm_sim)\n    }\n\n    fn tools_from_hands(&mut self, op: bool) {\n        if !op {\n            return;\n        }\n        for i in 0..4 {\n            let pad = &self.pads[i];\n            if !pad.present {\n                continue;\n            }\n            let using = pad.rt > 0.2 || pad.south;\n            if pad.l1 && !self.prev_l1[i] {\n                if using {\n                    // rotation is a hold, handled in hand()\n                } else {\n                    self.tool[i] = (self.tool[i] + 7) % 8;\n                }\n            }\n            if pad.r1 && !self.prev_r1[i] && !using {\n                self.tool[i] = (self.tool[i] + 1) % 8;\n            }\n            self.prev_l1[i] = pad.l1;\n            self.prev_r1[i] = pad.r1;\n            let oct = octant(pad.left);\n            if let Some(t) = oct {\n                if self.prev_oct[i] != Some(t) {\n                    self.tool[i] = t;\n                }\n            }\n            self.prev_oct[i] = oct;\n        }\n        if self.wheel.abs() > 0.01 && !(self.mouse_left) {\n            let dir = if self.wheel > 0.0 { 1 } else { 7 };\n            self.tool[0] = (self.tool[0] + dir) % 8;\n        }\n        for (code, tool) in DIGITS {\n            if self.ate(code) {\n                self.tool[0] = tool;\n            }\n        }\n    }\n\n    fn hand(&self, slot: usize, mouse_aim: Option<[f32; 2]>, mouse_owns: bool) -> SurgeonInput {\n        let pad = &self.pads[slot];\n        let mut held = 0;\n        let mut pressed = 0;\n        let mut aim = Vec2::ZERO;\n        let mut pressure = 0.85;\n        if slot == 0 && mouse_owns {\n            if let Some(p) = mouse_aim {\n                aim = Vec2::new(p[0], p[1]);\n                held |= surg::AIM_ABSOLUTE | surg::SNAP;\n            }\n        } else if pad.present && pad.right.length() > 0.12 {\n            aim = shape_stick(Vec2::new(pad.right.x, -pad.right.y));\n        } else if slot == 0 && !mouse_owns {\n            let mut v = Vec2::ZERO;\n            if self.key(KeyCode::KeyW) || self.key(KeyCode::ArrowUp) {\n                v.y += 1.0;\n            }\n            if self.key(KeyCode::KeyS) || self.key(KeyCode::ArrowDown) {\n                v.y -= 1.0;\n            }\n            if self.key(KeyCode::KeyD) || self.key(KeyCode::ArrowRight) {\n                v.x += 1.0;\n            }\n            if self.key(KeyCode::KeyA) || self.key(KeyCode::ArrowLeft) {\n                v.x -= 1.0;\n            }\n            if v.length_squared() > 0.0 {\n                aim = shape_stick(Vec2::new(v.x, -v.y));\n            }\n        }\n        let use_key = slot == 0 && (self.mouse_left || self.key(KeyCode::KeyE));\n        let use_pad = pad.present && (pad.rt > 0.08 || pad.south);\n        if use_key || use_pad {\n            held |= surg::USE;\n            pressure = if pad.rt > 0.08 { pad.rt.max(0.15) } else { 1.0 };\n        }\n        let precise = (slot == 0 && self.key(KeyCode::ShiftLeft) && !mouse_owns) || pad.lt > 0.35;\n        if precise {\n            held |= surg::PRECISION;\n        }\n        if slot == 0 && (self.mouse_right || self.key(KeyCode::KeyQ)) || pad.east {\n            held |= surg::CANCEL;\n        }\n        if slot == 0 && self.key(KeyCode::Space) || pad.north {\n            held |= surg::GIFT;\n        }\n        if slot == 0 && self.key(KeyCode::Tab) || pad.west {\n            held |= surg::CHART;\n        }\n        let both_mouse = slot == 0 && self.mouse_left && self.mouse_right;\n        let both_trig = pad.lt > 0.45 && pad.rt > 0.45;\n        if both_mouse || both_trig || self.tool[slot] == 10 && (use_key || use_pad) {\n            held |= surg::DEFIB;\n        }\n        let using = held & surg::USE != 0;\n        if using && pad.l1 {\n            held |= surg::ROT_L;\n        }\n        if using && pad.r1 {\n            held |= surg::ROT_R;\n        }\n        if slot == 0 && using && self.wheel > 0.1 {\n            held |= surg::ROT_R;\n        }\n        if slot == 0 && using && self.wheel < -0.1 {\n            held |= surg::ROT_L;\n        }\n        let active = slot == 0 || pad.present;\n        let _ = pressed;\n        SurgeonInput { active, aim, held, pressed, tool: self.tool[slot], pressure }\n    }\n}\n\nconst DIGITS: [(KeyCode, u8); 11] = [\n    (KeyCode::Digit1, 0),\n    (KeyCode::Digit2, 1),\n    (KeyCode::Digit3, 2),\n    (KeyCode::Digit4, 3),\n    (KeyCode::Digit5, 4),\n    (KeyCode::Digit6, 5),\n    (KeyCode::Digit7, 6),\n    (KeyCode::Digit8, 7),\n    (KeyCode::Digit9, 8),\n    (KeyCode::Digit0, 9),\n    (KeyCode::Minus, 10),\n];\n\nfn dead(v: Vec2) -> Vec2 {\n    if v.length() < 0.18 { Vec2::ZERO } else { v.clamp_length_max(1.0) }\n}\n\nfn shape_stick(v: Vec2) -> Vec2 {\n    let mag = v.length().min(1.0);\n    if mag < 0.001 {\n        return Vec2::ZERO;\n    }\n    v.normalize() * mag.powf(2.2)\n}\n\nfn octant(stick: Vec2) -> Option<u8> {\n    if stick.length() < 0.55 {\n        return None;\n    }\n    let ang = stick.x.atan2(stick.y);\n    Some((ang / std::f32::consts::FRAC_PI_4).round() as i32).map(|i| i.rem_euclid(8) as u8)\n}\n\nfn edge_pad(now: bool, _prev: bool) -> bool {\n    now\n}\n\nfn to_sim(c: Cmd) -> Option<SurgeryCmd> {\n    Some(match c {\n        Cmd::LoadCampaign => SurgeryCmd::LoadCampaign,\n        Cmd::LoadCase(n) => SurgeryCmd::LoadCase(n),\n        Cmd::LoadCode => SurgeryCmd::LoadCode,\n        Cmd::LoadAttract => SurgeryCmd::LoadAttract,\n        Cmd::ToTitle => SurgeryCmd::ToTitle,\n        Cmd::SetDifficulty(d) => SurgeryCmd::SetDifficulty(d),\n        Cmd::Retry => SurgeryCmd::Retry,\n        Cmd::SetTune { id, value } => SurgeryCmd::SetTune { id, value },\n        Cmd::ResetTune => SurgeryCmd::ResetTune,\n        Cmd::SetBus { which, value } => SurgeryCmd::SetBus { which, value },\n        Cmd::Dev { what, extra } => SurgeryCmd::Dev { what, extra },\n        Cmd::ConfirmSim => return None,\n    })\n}\n\nfn track_name(op: &SurgeryFrame) -> &'static str {\n    if op.gift_hush > 0.0 {\n        return \"hush\";\n    }\n    if op.flat || op.code_t >= 0.0 {\n        return \"code\";\n    }\n    match op.mode {\n        1 => {\n            if op.case_id % 2 == 0 {\n                \"story_ward\"\n            } else {\n                \"story_night\"\n            }\n        }\n        3 | 6 => match op.strain {\n            0..=3 => \"introit\",\n            4..=7 => \"lacrimosa\",\n            8..=10 => \"dies\",\n            11..=17 => \"libera\",\n            _ => {\n                if op.case_id < 0 {\n                    \"code\"\n                } else {\n                    \"or\"\n                }\n            }\n        },\n        4 => \"results\",\n        5 => \"crisis\",\n        7 => \"code\",\n        _ => \"title\",\n    }\n}\n\npub fn surgery_frame(app: &mut App) {\n    if app.gfx.is_none() || app.host.is_none() {\n        return;\n    }\n    let now = web_time::Instant::now();\n    let dt = (now - app.last).as_secs_f32().min(0.1);\n    app.last = now;\n\n    #[cfg(target_arch = \"wasm32\")]\n    drain_hook(app);\n\n    app.harbor.poll_pads(app.input.gilrs.as_mut());\n    aim_rig(app);\n    let (w, h) = app.gfx.as_ref().unwrap().size();\n    let size = Vec2::new(w as f32, h as f32);\n    let hit = app.rig.ground_point(app.harbor.mouse, size, 0.0).map(|p| [p.x, p.z]);\n    if app.harbor.mouse_click {\n        if let Some(p) = hit {\n            if let Some(tool) = tray_tool(p[0], p[1]) {\n                app.harbor.tool[0] = tool;\n            }\n        }\n    }\n    let (cmds, surgeons, _) = app.harbor.compose(dt, hit);\n    let host = app.host.as_ref().unwrap();\n    let paused = app.harbor.shell.paused();\n    host.set_control(|c| c.paused = paused);\n    for cmd in cmds {\n        if let Some(sim_cmd) = to_sim(cmd) {\n            host.exec(move |sim| {\n                if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\n                    g.apply_cmd(sim_cmd);\n                }\n            });\n        }\n    }\n    {\n        let mut input = host.shared.input.lock().unwrap();\n        *input = InputFrame::default();\n        input.surgeons = surgeons;\n    }\n    host.pump();\n\n    let (prev, curr, curr_at, tick_wall) = host.frames();\n    let _ = (curr_at, tick_wall);\n    let op = curr.surgery.clone();\n    if let Some(op) = &op {\n        app.harbor.shell.note_mode(op.mode);\n        if op.mode == 3 {\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(false);\n        } else {\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(true);\n        }\n    }\n    let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n    if let Some(a) = &app.audio {\n        let music = op.as_ref().map(|o| o.music).unwrap_or(0.10);\n        let effects = op.as_ref().map(|o| o.effects).unwrap_or(0.80);\n        let voices = op.as_ref().map(|o| o.voices).unwrap_or(0.70);\n        a.set_buses(music, effects, voices);\n        let l = pav_audio::Listener { pos: Vec3::new(0.0, 8.0, 12.0), right: Vec3::X };\n        for e in &events {\n            a.play_event(e, &l, effects);\n        }\n        let name = op.as_ref().map(|o| track_name(o)).unwrap_or(\"title\");\n        if app.harbor.music_name != name {\n            app.harbor.music_name = name.to_string();\n            app.harbor.music_left = 0.0;\n        }\n        app.harbor.music_left -= dt;\n        if app.harbor.music_left <= 0.0 {\n            let bpm = op.as_ref().map(|o| o.bpm).unwrap_or(72.0).clamp(60.0, 140.0);\n            let (dur, notes) = pav_audio::music::phrase(name, bpm);\n            for n in notes {\n                a.play_bus(n.patch, n.pan, n.gain, n.delay, pav_audio::BUS_MUSIC);\n            }\n            app.harbor.music_left = dur.max(0.5);\n        }\n    }\n    app.builder.add_events(&events);\n    app.builder.now = app.started.elapsed().as_secs_f64();\n    let view = ViewSettings::default();\n    let focus = curr.focus;\n    let mut scene = app.builder.build(&prev, &curr, 1.0, &app.rig, w as f32 / h.max(1) as f32, &view, focus);\n\n    let gfx = app.gfx.as_mut().unwrap();\n    let native = gfx.window.scale_factor() as f32;\n    let zoom = (h as f32 / 1080.0) / native.max(0.25);\n    app.egui_ctx.set_zoom_factor(zoom);\n    if !app.harbor.font {\n        pav_ui::surgery::install_font(&app.egui_ctx);\n        app.harbor.font = true;\n    }\n    let state = app.egui_state.as_mut().unwrap();\n    let raw = state.take(&gfx.window);\n    let shell = &app.harbor.shell;\n    let op_ref = op.as_deref();\n    let out = app.egui_ctx.run_ui(raw, |ui| {\n        pav_ui::surgery::draw(ui, shell, op_ref);\n    });\n    state.platform_output(&gfx.window, out.platform_output);\n    let ppp = out.pixels_per_point;\n    let prims = app.egui_ctx.tessellate(out.shapes, ppp);\n    let mut textures = out.textures_delta;\n    gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n    let _ = &mut scene;\n\n    let status = status_json(&app.harbor.shell, op.as_deref(), &curr);\n    app.harbor.status = status.clone();\n    publish_status(&status);\n    #[cfg(target_arch = \"wasm32\")]\n    install_hook(app);\n}\n\nfn aim_rig(app: &mut App) {\n    app.rig.params = CameraParams {\n        tilt: 73.0,\n        yaw: 0.0,\n        distance: 19.9,\n        fov: 36.0,\n        ortho: false,\n        follow_lag: 0.0,\n        height_offset: 0.0,\n    };\n    app.rig.snap(Vec3::new(0.0, 0.0, 0.2));\n}\n\nfn tray_tool(x: f32, z: f32) -> Option<u8> {\n    if (z - 5.4).abs() > 0.7 {\n        return None;\n    }\n    for t in 0..8 {\n        let tx = -3.5 + t as f32;\n        if (x - tx).abs() < 0.45 {\n            return Some(t as u8);\n        }\n    }\n    None\n}\n\nfn status_json(shell: &Shell, op: Option<&SurgeryFrame>, curr: &pav_core::RenderFrame) -> String {\n    let music = op.map(|o| o.music).unwrap_or(0.10);\n    let cursors: Vec<_> = op\n        .map(|o| {\n            o.cursors\n                .iter()\n                .map(|c| serde_json::json!({\"x\": c.x, \"z\": c.z, \"tool\": c.tool, \"active\": c.active}))\n                .collect()\n        })\n        .unwrap_or_default();\n    let sim = curr.play_status.clone().unwrap_or_else(|| serde_json::json!({}));\n    serde_json::json!({\n        \"screen\": shell.screen_name(),\n        \"focus\": shell.focus(),\n        \"device\": if shell.device == DeviceKind::Gamepad { \"gamepad\" } else { \"keyboard\" },\n        \"xbox\": shell.xbox,\n        \"music\": format!(\"{music:.2}\"),\n        \"title\": TITLE,\n        \"cursors\": cursors,\n        \"sim\": sim,\n        \"vitals\": op.map(|o| o.vitals),\n        \"bpm\": op.map(|o| o.bpm),\n        \"timer\": op.map(|o| o.timer),\n        \"mode\": op.map(|o| o.mode),\n    })\n    .to_string()\n}\n\nfn publish_status(s: &str) {\n    STATUS.with(|c| *c.borrow_mut() = s.to_string());\n}\n\nthread_local! {\n    static STATUS: RefCell<String> = const { RefCell::new(String::new()) };\n    static BURST: Cell<u32> = const { Cell::new(0) };\n    static HOOKED: Cell<bool> = const { Cell::new(false) };\n}\n\n#[cfg(target_arch = \"wasm32\")]\nfn drain_hook(app: &mut App) {\n    let n = BURST.with(|b| b.replace(0));\n    if n > 0 {\n        if let Some(host) = &app.host {\n            host.burst(n);\n        }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn drain_hook(_app: &mut App) {}\n\n#[cfg(target_arch = \"wasm32\")]\nfn install_hook(app: &App) {\n    if HOOKED.with(|h| h.get()) {\n        return;\n    }\n    use wasm_bindgen::JsCast;\n    let Some(win) = web_sys::window() else { return };\n    let obj = js_sys::Object::new();\n    let status = wasm_bindgen::closure::Closure::wrap(Box::new(|| {\n        STATUS.with(|s| wasm_bindgen::JsValue::from_str(&s.borrow()))\n    }) as Box<dyn Fn() -> wasm_bindgen::JsValue>);\n    let _ = js_sys::Reflect::set(&obj, &\"status\".into(), status.as_ref().unchecked_ref());\n    status.forget();\n    let step = wasm_bindgen::closure::Closure::wrap(Box::new(|n: u32| {\n        BURST.with(|b| b.set(b.get().saturating_add(n)));\n    }) as Box<dyn Fn(u32)>);\n    let _ = js_sys::Reflect::set(&obj, &\"step\".into(), step.as_ref().unchecked_ref());\n    step.forget();\n    let _ = js_sys::Reflect::set(&win, &\"__game\".into(), &obj);\n    HOOKED.with(|h| h.set(true));\n    let _ = app;\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn install_hook(_app: &App) {}\n\npub fn surgery_event(app: &mut App, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n    let consumed = match (&mut app.egui_state, &app.gfx) {\n        (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n        _ => false,\n    };\n    let _ = consumed;\n    match event {\n        WindowEvent::CloseRequested => el.exit(),\n        WindowEvent::Resized(sz) => {\n            if let Some(g) = &mut app.gfx {\n                g.resize(sz.width, sz.height);\n            }\n        }\n        WindowEvent::RedrawRequested => {\n            surgery_frame(app);\n            if app.quit {\n                el.exit();\n            }\n        }\n        WindowEvent::KeyboardInput { event, .. } => {\n            #[cfg(target_arch = \"wasm32\")]\n            app.resume_audio();\n            if let PhysicalKey::Code(code) = event.physical_key {\n                match event.state {\n                    ElementState::Pressed if !event.repeat => {\n                        app.harbor.keys.insert(code);\n                        app.harbor.just.push(code);\n                    }\n                    ElementState::Released => {\n                        app.harbor.keys.remove(&code);\n                    }\n                    _ => {}\n                }\n            }\n        }\n        WindowEvent::MouseInput { state, button, .. } => {\n            #[cfg(target_arch = \"wasm32\")]\n            app.resume_audio();\n            let down = state == ElementState::Pressed;\n            match button {\n                MouseButton::Left => {\n                    app.harbor.mouse_left = down;\n                    if down {\n                        app.harbor.mouse_click = true;\n                    }\n                }\n                MouseButton::Right => app.harbor.mouse_right = down,\n                _ => {}\n            }\n        }\n        WindowEvent::CursorMoved { position, .. } => {\n            let p = Vec2::new(position.x as f32, position.y as f32);\n            if (p - app.harbor.mouse).length() > 1.5 {\n                app.harbor.mouse_moved = true;\n            }\n            app.harbor.mouse = p;\n        }\n        WindowEvent::MouseWheel { delta, .. } => {\n            let lines = match delta {\n                MouseScrollDelta::LineDelta(_, y) => y,\n                MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n            };\n            app.harbor.wheel += lines;\n        }\n        WindowEvent::Touch(t) => {\n            app.harbor.shell.touch_only = true;\n            if t.phase == winit::event::TouchPhase::Started {\n                app.harbor.touch_click = true;\n                app.harbor.mouse = Vec2::new(t.location.x as f32, t.location.y as f32);\n            }\n        }\n        _ => {}\n    }\n}\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2439,"output_tokens":7425,"cache_read_input_tokens":178432,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"44ed859a-883d-487d-85f5-add9e9d938be"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-a3fb30e0-fe89-407a-8679-2879dbd971fc-164","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"//! Hands of Harbor's frame. A surgery scene never enters the demo menu, camera, or touch layer.\\n\\nuse std::cell::{Cell, RefCell};\\nuse std::collections::HashSet;\\n\\nuse glam::{Vec2, Vec3};\\nuse pav_core::games::surgery::{self, Surgery, SurgeryFrame, TITLE, TOOL_KEEP};\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_ui::surgery::{Cmd, DeviceKind, Input as ShellIn, Shell};\\nuse pav_view::{CameraParams, ViewSettings};\\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\\nuse winit::event_loop::ActiveEventLoop;\\nuse winit::keyboard::{KeyCode, PhysicalKey};\\nuse winit::window::WindowId;\\n\\nuse super::App;\\n\\nstruct PadHand {\\n    present: bool,\\n    left: Vec2,\\n    right: Vec2,\\n    south: bool,\\n    east: bool,\\n    north: bool,\\n    west: bool,\\n    l1: bool,\\n    r1: bool,\\n    start: bool,\\n    up: bool,\\n    down: bool,\\n    left_b: bool,\\n    right_b: bool,\\n    lt: f32,\\n    rt: f32,\\n}\\n\\nimpl Default for PadHand {\\n    fn default() -> Self {\\n        Self {\\n            present: false,\\n            left: Vec2::ZERO,\\n            right: Vec2::ZERO,\\n            south: false,\\n            east: false,\\n            north: false,\\n            west: false,\\n            l1: false,\\n            r1: false,\\n            start: false,\\n            up: false,\\n            down: false,\\n            left_b: false,\\n            right_b: false,\\n            lt: 0.0,\\n            rt: 0.0,\\n        }\\n    }\\n}\\n\\npub struct Harbor {\\n    pub shell: Shell,\\n    keys: HashSet<KeyCode>,\\n    just: Vec<KeyCode>,\\n    mouse: Vec2,\\n    mouse_left: bool,\\n    mouse_right: bool,\\n    mouse_click: bool,\\n    mouse_moved: bool,\\n    wheel: f32,\\n    touch_click: bool,\\n    pads: [PadHand; 4],\\n    prev_oct: [Option<u8>; 4],\\n    prev_l1: [bool; 4],\\n    prev_r1: [bool; 4],\\n    tool: [u8; 4],\\n    font: bool,\\n    music_name: String,\\n    music_left: f32,\\n    status: String,\\n}\\n\\nimpl Harbor {\\n    pub fn new(touch_only: bool) -> Self {\\n        let mut shell = Shell::new();\\n        shell.touch_only = touch_only;\\n        Self {\\n            shell,\\n            keys: HashSet::new(),\\n            just: Vec::new(),\\n            mouse: Vec2::ZERO,\\n            mouse_left: false,\\n            mouse_right: false,\\n            mouse_click: false,\\n            mouse_moved: false,\\n            wheel: 0.0,\\n            touch_click: false,\\n            pads: std::array::from_fn(|_| PadHand::default()),\\n            prev_oct: [None; 4],\\n            prev_l1: [false; 4],\\n            prev_r1: [false; 4],\\n            tool: [0; 4],\\n            font: false,\\n            music_name: String::new(),\\n            music_left: 0.0,\\n            status: String::new(),\\n        }\\n    }\\n\\n    fn key(&self, code: KeyCode) -> bool {\\n        self.keys.contains(&code)\\n    }\\n\\n    fn ate(&mut self, code: KeyCode) -> bool {\\n        let hit = self.just.contains(&code);\\n        if hit {\\n            self.just.retain(|k| *k != code);\\n        }\\n        hit\\n    }\\n\\n    fn poll_pads(&mut self, gilrs: Option<&mut gilrs::Gilrs>) {\\n        for p in &mut self.pads {\\n            p.present = false;\\n        }\\n        let Some(g) = gilrs else { return };\\n        while g.next_event().is_some() {}\\n        for (i, (_, gp)) in g.gamepads().take(4).enumerate() {\\n            use gilrs::{Axis, Button};\\n            let pressed = |b: Button| gp.is_pressed(b);\\n            let analog = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0);\\n            self.pads[i] = PadHand {\\n                present: true,\\n                left: dead(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY))),\\n                right: dead(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY))),\\n                south: pressed(Button::South),\\n                east: pressed(Button::East),\\n                north: pressed(Button::North),\\n                west: pressed(Button::West),\\n                l1: pressed(Button::LeftTrigger),\\n                r1: pressed(Button::RightTrigger),\\n                start: pressed(Button::Start),\\n                up: pressed(Button::DPadUp),\\n                down: pressed(Button::DPadDown),\\n                left_b: pressed(Button::DPadLeft),\\n                right_b: pressed(Button::DPadRight),\\n                lt: analog(Button::LeftTrigger2),\\n                rt: analog(Button::RightTrigger2),\\n            };\\n        }\\n    }\\n\\n    /// Shell step plus one frame of surgeon hands. `aim` is the mouse on the field, if it hit.\\n    fn compose(&mut self, dt: f32, aim: Option<[f32; 2]>) -> (Vec<Cmd>, [SurgeonInput; 4], bool) {\\n        let op = self.shell.screen_name() == \\\"op\\\";\\n        let pad0 = &self.pads[0];\\n        let pad_nav = pad0.present && (pad0.up || pad0.down || pad0.south || pad0.east || pad0.start || pad0.left.length() > 0.2 || pad0.right.length() > 0.2);\\n        let mouse_fine = self.mouse_moved || self.mouse_click || self.just.iter().any(|k| !matches!(k, KeyCode::F1 | KeyCode::F2 | KeyCode::F3));\\n        let device = if pad_nav && !mouse_fine { Some(DeviceKind::Gamepad) } else if mouse_fine || !self.just.is_empty() { Some(DeviceKind::KeyboardMouse) } else { None };\\n        let up = self.ate(KeyCode::ArrowUp) || edge_pad(pad0.up, false);\\n        let down = self.ate(KeyCode::ArrowDown) || pad0.down && !op;\\n        let left = self.ate(KeyCode::ArrowLeft) || pad0.left_b;\\n        let right = self.ate(KeyCode::ArrowRight) || pad0.right_b;\\n        let confirm = self.ate(KeyCode::Enter) || self.ate(KeyCode::NumpadEnter) || self.ate(KeyCode::Space) && !op || (pad0.south && !op);\\n        let back = self.ate(KeyCode::Escape) || pad0.east && !op || pad0.start;\\n        let any = device.is_some() || self.mouse_moved || self.touch_click || self.mouse_click || back || confirm || up || down;\\n        let pointer = if op { None } else { Some([self.mouse.x, self.mouse.y]) };\\n        let click = !op && (self.mouse_click || self.touch_click);\\n        let cmds = self.shell.step(ShellIn {\\n            up: !op && up,\\n            down: !op && down,\\n            left: !op && left,\\n            right: !op && right,\\n            confirm: !op && confirm,\\n            back,\\n            tab_l: self.ate(KeyCode::PageUp) || self.ate(KeyCode::BracketLeft),\\n            tab_r: self.ate(KeyCode::PageDown) || self.ate(KeyCode::BracketRight),\\n            pointer,\\n            click,\\n            any,\\n            dt,\\n            device,\\n        });\\n        let confirm_sim = cmds.iter().any(|c| matches!(c, Cmd::ConfirmSim));\\n        self.tools_from_hands(op);\\n        let mut surgeons = [SurgeonInput { tool: TOOL_KEEP, ..SurgeonInput::default() }; 4];\\n        if op {\\n            for i in 0..4 {\\n                surgeons[i] = self.hand(i, aim, i == 0 && self.mouse_moved);\\n            }\\n        } else if confirm_sim {\\n            surgeons[0].active = true;\\n            surgeons[0].tool = TOOL_KEEP;\\n            surgeons[0].held |= surg::CONFIRM;\\n            surgeons[0].pressed |= surg::CONFIRM;\\n        }\\n        self.mouse_click = false;\\n        self.mouse_moved = false;\\n        self.touch_click = false;\\n        self.wheel = 0.0;\\n        self.just.clear();\\n        (cmds, surgeons, confirm_sim)\\n    }\\n\\n    fn tools_from_hands(&mut self, op: bool) {\\n        if !op {\\n            return;\\n        }\\n        for i in 0..4 {\\n            let pad = &self.pads[i];\\n            if !pad.present {\\n                continue;\\n            }\\n            let using = pad.rt > 0.2 || pad.south;\\n            if pad.l1 && !self.prev_l1[i] {\\n                if using {\\n                    // rotation is a hold, handled in hand()\\n                } else {\\n                    self.tool[i] = (self.tool[i] + 7) % 8;\\n                }\\n            }\\n            if pad.r1 && !self.prev_r1[i] && !using {\\n                self.tool[i] = (self.tool[i] + 1) % 8;\\n            }\\n            self.prev_l1[i] = pad.l1;\\n            self.prev_r1[i] = pad.r1;\\n            let oct = octant(pad.left);\\n            if let Some(t) = oct {\\n                if self.prev_oct[i] != Some(t) {\\n                    self.tool[i] = t;\\n                }\\n            }\\n            self.prev_oct[i] = oct;\\n        }\\n        if self.wheel.abs() > 0.01 && !(self.mouse_left) {\\n            let dir = if self.wheel > 0.0 { 1 } else { 7 };\\n            self.tool[0] = (self.tool[0] + dir) % 8;\\n        }\\n        for (code, tool) in DIGITS {\\n            if self.ate(code) {\\n                self.tool[0] = tool;\\n            }\\n        }\\n    }\\n\\n    fn hand(&self, slot: usize, mouse_aim: Option<[f32; 2]>, mouse_owns: bool) -> SurgeonInput {\\n        let pad = &self.pads[slot];\\n        let mut held = 0;\\n        let mut pressed = 0;\\n        let mut aim = Vec2::ZERO;\\n        let mut pressure = 0.85;\\n        if slot == 0 && mouse_owns {\\n            if let Some(p) = mouse_aim {\\n                aim = Vec2::new(p[0], p[1]);\\n                held |= surg::AIM_ABSOLUTE | surg::SNAP;\\n            }\\n        } else if pad.present && pad.right.length() > 0.12 {\\n            aim = shape_stick(Vec2::new(pad.right.x, -pad.right.y));\\n        } else if slot == 0 && !mouse_owns {\\n            let mut v = Vec2::ZERO;\\n            if self.key(KeyCode::KeyW) || self.key(KeyCode::ArrowUp) {\\n                v.y += 1.0;\\n            }\\n            if self.key(KeyCode::KeyS) || self.key(KeyCode::ArrowDown) {\\n                v.y -= 1.0;\\n            }\\n            if self.key(KeyCode::KeyD) || self.key(KeyCode::ArrowRight) {\\n                v.x += 1.0;\\n            }\\n            if self.key(KeyCode::KeyA) || self.key(KeyCode::ArrowLeft) {\\n                v.x -= 1.0;\\n            }\\n            if v.length_squared() > 0.0 {\\n                aim = shape_stick(Vec2::new(v.x, -v.y));\\n            }\\n        }\\n        let use_key = slot == 0 && (self.mouse_left || self.key(KeyCode::KeyE));\\n        let use_pad = pad.present && (pad.rt > 0.08 || pad.south);\\n        if use_key || use_pad {\\n            held |= surg::USE;\\n            pressure = if pad.rt > 0.08 { pad.rt.max(0.15) } else { 1.0 };\\n        }\\n        let precise = (slot == 0 && self.key(KeyCode::ShiftLeft) && !mouse_owns) || pad.lt > 0.35;\\n        if precise {\\n            held |= surg::PRECISION;\\n        }\\n        if slot == 0 && (self.mouse_right || self.key(KeyCode::KeyQ)) || pad.east {\\n            held |= surg::CANCEL;\\n        }\\n        if slot == 0 && self.key(KeyCode::Space) || pad.north {\\n            held |= surg::GIFT;\\n        }\\n        if slot == 0 && self.key(KeyCode::Tab) || pad.west {\\n            held |= surg::CHART;\\n        }\\n        let both_mouse = slot == 0 && self.mouse_left && self.mouse_right;\\n        let both_trig = pad.lt > 0.45 && pad.rt > 0.45;\\n        if both_mouse || both_trig || self.tool[slot] == 10 && (use_key || use_pad) {\\n            held |= surg::DEFIB;\\n        }\\n        let using = held & surg::USE != 0;\\n        if using && pad.l1 {\\n            held |= surg::ROT_L;\\n        }\\n        if using && pad.r1 {\\n            held |= surg::ROT_R;\\n        }\\n        if slot == 0 && using && self.wheel > 0.1 {\\n            held |= surg::ROT_R;\\n        }\\n        if slot == 0 && using && self.wheel < -0.1 {\\n            held |= surg::ROT_L;\\n        }\\n        let active = slot == 0 || pad.present;\\n        let _ = pressed;\\n        SurgeonInput { active, aim, held, pressed, tool: self.tool[slot], pressure }\\n    }\\n}\\n\\nconst DIGITS: [(KeyCode, u8); 11] = [\\n    (KeyCode::Digit1, 0),\\n    (KeyCode::Digit2, 1),\\n    (KeyCode::Digit3, 2),\\n    (KeyCode::Digit4, 3),\\n    (KeyCode::Digit5, 4),\\n    (KeyCode::Digit6, 5),\\n    (KeyCode::Digit7, 6),\\n    (KeyCode::Digit8, 7),\\n    (KeyCode::Digit9, 8),\\n    (KeyCode::Digit0, 9),\\n    (KeyCode::Minus, 10),\\n];\\n\\nfn dead(v: Vec2) -> Vec2 {\\n    if v.length() < 0.18 { Vec2::ZERO } else { v.clamp_length_max(1.0) }\\n}\\n\\nfn shape_stick(v: Vec2) -> Vec2 {\\n    let mag = v.length().min(1.0);\\n    if mag < 0.001 {\\n        return Vec2::ZERO;\\n    }\\n    v.normalize() * mag.powf(2.2)\\n}\\n\\nfn octant(stick: Vec2) -> Option<u8> {\\n    if stick.length() < 0.55 {\\n        return None;\\n    }\\n    let ang = stick.x.atan2(stick.y);\\n    Some((ang / std::f32::consts::FRAC_PI_4).round() as i32).map(|i| i.rem_euclid(8) as u8)\\n}\\n\\nfn edge_pad(now: bool, _prev: bool) -> bool {\\n    now\\n}\\n\\nfn to_sim(c: Cmd) -> Option<SurgeryCmd> {\\n    Some(match c {\\n        Cmd::LoadCampaign => SurgeryCmd::LoadCampaign,\\n        Cmd::LoadCase(n) => SurgeryCmd::LoadCase(n),\\n        Cmd::LoadCode => SurgeryCmd::LoadCode,\\n        Cmd::LoadAttract => SurgeryCmd::LoadAttract,\\n        Cmd::ToTitle => SurgeryCmd::ToTitle,\\n        Cmd::SetDifficulty(d) => SurgeryCmd::SetDifficulty(d),\\n        Cmd::Retry => SurgeryCmd::Retry,\\n        Cmd::SetTune { id, value } => SurgeryCmd::SetTune { id, value },\\n        Cmd::ResetTune => SurgeryCmd::ResetTune,\\n        Cmd::SetBus { which, value } => SurgeryCmd::SetBus { which, value },\\n        Cmd::Dev { what, extra } => SurgeryCmd::Dev { what, extra },\\n        Cmd::ConfirmSim => return None,\\n    })\\n}\\n\\nfn track_name(op: &SurgeryFrame) -> &'static str {\\n    if op.gift_hush > 0.0 {\\n        return \\\"hush\\\";\\n    }\\n    if op.flat || op.code_t >= 0.0 {\\n        return \\\"code\\\";\\n    }\\n    match op.mode {\\n        1 => {\\n            if op.case_id % 2 == 0 {\\n                \\\"story_ward\\\"\\n            } else {\\n                \\\"story_night\\\"\\n            }\\n        }\\n        3 | 6 => match op.strain {\\n            0..=3 => \\\"introit\\\",\\n            4..=7 => \\\"lacrimosa\\\",\\n            8..=10 => \\\"dies\\\",\\n            11..=17 => \\\"libera\\\",\\n            _ => {\\n                if op.case_id < 0 {\\n                    \\\"code\\\"\\n                } else {\\n                    \\\"or\\\"\\n                }\\n            }\\n        },\\n        4 => \\\"results\\\",\\n        5 => \\\"crisis\\\",\\n        7 => \\\"code\\\",\\n        _ => \\\"title\\\",\\n    }\\n}\\n\\npub fn surgery_frame(app: &mut App) {\\n    if app.gfx.is_none() || app.host.is_none() {\\n        return;\\n    }\\n    let now = web_time::Instant::now();\\n    let dt = (now - app.last).as_secs_f32().min(0.1);\\n    app.last = now;\\n\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    drain_hook(app);\\n\\n    app.harbor.poll_pads(app.input.gilrs.as_mut());\\n    aim_rig(app);\\n    let (w, h) = app.gfx.as_ref().unwrap().size();\\n    let size = Vec2::new(w as f32, h as f32);\\n    let hit = app.rig.ground_point(app.harbor.mouse, size, 0.0).map(|p| [p.x, p.z]);\\n    if app.harbor.mouse_click {\\n        if let Some(p) = hit {\\n            if let Some(tool) = tray_tool(p[0], p[1]) {\\n                app.harbor.tool[0] = tool;\\n            }\\n        }\\n    }\\n    let (cmds, surgeons, _) = app.harbor.compose(dt, hit);\\n    let host = app.host.as_ref().unwrap();\\n    let paused = app.harbor.shell.paused();\\n    host.set_control(|c| c.paused = paused);\\n    for cmd in cmds {\\n        if let Some(sim_cmd) = to_sim(cmd) {\\n            host.exec(move |sim| {\\n                if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                    g.apply_cmd(sim_cmd);\\n                }\\n            });\\n        }\\n    }\\n    {\\n        let mut input = host.shared.input.lock().unwrap();\\n        *input = InputFrame::default();\\n        input.surgeons = surgeons;\\n    }\\n    host.pump();\\n\\n    let (prev, curr, curr_at, tick_wall) = host.frames();\\n    let _ = (curr_at, tick_wall);\\n    let op = curr.surgery.clone();\\n    if let Some(op) = &op {\\n        app.harbor.shell.note_mode(op.mode);\\n        if op.mode == 3 {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(false);\\n        } else {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(true);\\n        }\\n    }\\n    let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\\n    if let Some(a) = &app.audio {\\n        let music = op.as_ref().map(|o| o.music).unwrap_or(0.10);\\n        let effects = op.as_ref().map(|o| o.effects).unwrap_or(0.80);\\n        let voices = op.as_ref().map(|o| o.voices).unwrap_or(0.70);\\n        a.set_buses(music, effects, voices);\\n        let l = pav_audio::Listener { pos: Vec3::new(0.0, 8.0, 12.0), right: Vec3::X };\\n        for e in &events {\\n            a.play_event(e, &l, effects);\\n        }\\n        let name = op.as_ref().map(|o| track_name(o)).unwrap_or(\\\"title\\\");\\n        if app.harbor.music_name != name {\\n            app.harbor.music_name = name.to_string();\\n            app.harbor.music_left = 0.0;\\n        }\\n        app.harbor.music_left -= dt;\\n        if app.harbor.music_left <= 0.0 {\\n            let bpm = op.as_ref().map(|o| o.bpm).unwrap_or(72.0).clamp(60.0, 140.0);\\n            let (dur, notes) = pav_audio::music::phrase(name, bpm);\\n            for n in notes {\\n                a.play_bus(n.patch, n.pan, n.gain, n.delay, pav_audio::BUS_MUSIC);\\n            }\\n            app.harbor.music_left = dur.max(0.5);\\n        }\\n    }\\n    app.builder.add_events(&events);\\n    app.builder.now = app.started.elapsed().as_secs_f64();\\n    let view = ViewSettings::default();\\n    let focus = curr.focus;\\n    let mut scene = app.builder.build(&prev, &curr, 1.0, &app.rig, w as f32 / h.max(1) as f32, &view, focus);\\n\\n    let gfx = app.gfx.as_mut().unwrap();\\n    let native = gfx.window.scale_factor() as f32;\\n    let zoom = (h as f32 / 1080.0) / native.max(0.25);\\n    app.egui_ctx.set_zoom_factor(zoom);\\n    if !app.harbor.font {\\n        pav_ui::surgery::install_font(&app.egui_ctx);\\n        app.harbor.font = true;\\n    }\\n    let state = app.egui_state.as_mut().unwrap();\\n    let raw = state.take(&gfx.window);\\n    let shell = &app.harbor.shell;\\n    let op_ref = op.as_deref();\\n    let out = app.egui_ctx.run_ui(raw, |ui| {\\n        pav_ui::surgery::draw(ui, shell, op_ref);\\n    });\\n    state.platform_output(&gfx.window, out.platform_output);\\n    let ppp = out.pixels_per_point;\\n    let prims = app.egui_ctx.tessellate(out.shapes, ppp);\\n    let mut textures = out.textures_delta;\\n    gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\\n    let _ = &mut scene;\\n\\n    let status = status_json(&app.harbor.shell, op.as_deref(), &curr);\\n    app.harbor.status = status.clone();\\n    publish_status(&status);\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    install_hook(app);\\n}\\n\\nfn aim_rig(app: &mut App) {\\n    app.rig.params = CameraParams {\\n        tilt: 73.0,\\n        yaw: 0.0,\\n        distance: 19.9,\\n        fov: 36.0,\\n        ortho: false,\\n        follow_lag: 0.0,\\n        height_offset: 0.0,\\n    };\\n    app.rig.snap(Vec3::new(0.0, 0.0, 0.2));\\n}\\n\\nfn tray_tool(x: f32, z: f32) -> Option<u8> {\\n    if (z - 5.4).abs() > 0.7 {\\n        return None;\\n    }\\n    for t in 0..8 {\\n        let tx = -3.5 + t as f32;\\n        if (x - tx).abs() < 0.45 {\\n            return Some(t as u8);\\n        }\\n    }\\n    None\\n}\\n\\nfn status_json(shell: &Shell, op: Option<&SurgeryFrame>, curr: &pav_core::RenderFrame) -> String {\\n    let music = op.map(|o| o.music).unwrap_or(0.10);\\n    let cursors: Vec<_> = op\\n        .map(|o| {\\n            o.cursors\\n                .iter()\\n                .map(|c| serde_json::json!({\\\"x\\\": c.x, \\\"z\\\": c.z, \\\"tool\\\": c.tool, \\\"active\\\": c.active}))\\n                .collect()\\n        })\\n        .unwrap_or_default();\\n    let sim = curr.play_status.clone().unwrap_or_else(|| serde_json::json!({}));\\n    serde_json::json!({\\n        \\\"screen\\\": shell.screen_name(),\\n        \\\"focus\\\": shell.focus(),\\n        \\\"device\\\": if shell.device == DeviceKind::Gamepad { \\\"gamepad\\\" } else { \\\"keyboard\\\" },\\n        \\\"xbox\\\": shell.xbox,\\n        \\\"music\\\": format!(\\\"{music:.2}\\\"),\\n        \\\"title\\\": TITLE,\\n        \\\"cursors\\\": cursors,\\n        \\\"sim\\\": sim,\\n        \\\"vitals\\\": op.map(|o| o.vitals),\\n        \\\"bpm\\\": op.map(|o| o.bpm),\\n        \\\"timer\\\": op.map(|o| o.timer),\\n        \\\"mode\\\": op.map(|o| o.mode),\\n    })\\n    .to_string()\\n}\\n\\nfn publish_status(s: &str) {\\n    STATUS.with(|c| *c.borrow_mut() = s.to_string());\\n}\\n\\nthread_local! {\\n    static STATUS: RefCell<String> = const { RefCell::new(String::new()) };\\n    static BURST: Cell<u32> = const { Cell::new(0) };\\n    static HOOKED: Cell<bool> = const { Cell::new(false) };\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn drain_hook(app: &mut App) {\\n    let n = BURST.with(|b| b.replace(0));\\n    if n > 0 {\\n        if let Some(host) = &app.host {\\n            host.burst(n);\\n        }\\n    }\\n}\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nfn drain_hook(_app: &mut App) {}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn install_hook(app: &App) {\\n    if HOOKED.with(|h| h.get()) {\\n        return;\\n    }\\n    use wasm_bindgen::JsCast;\\n    let Some(win) = web_sys::window() else { return };\\n    let obj = js_sys::Object::new();\\n    let status = wasm_bindgen::closure::Closure::wrap(Box::new(|| {\\n        STATUS.with(|s| wasm_bindgen::JsValue::from_str(&s.borrow()))\\n    }) as Box<dyn Fn() -> wasm_bindgen::JsValue>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"status\\\".into(), status.as_ref().unchecked_ref());\\n    status.forget();\\n    let step = wasm_bindgen::closure::Closure::wrap(Box::new(|n: u32| {\\n        BURST.with(|b| b.set(b.get().saturating_add(n)));\\n    }) as Box<dyn Fn(u32)>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"step\\\".into(), step.as_ref().unchecked_ref());\\n    step.forget();\\n    let _ = js_sys::Reflect::set(&win, &\\\"__game\\\".into(), &obj);\\n    HOOKED.with(|h| h.set(true));\\n    let _ = app;\\n}\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nfn install_hook(_app: &App) {}\\n\\npub fn surgery_event(app: &mut App, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\\n    let consumed = match (&mut app.egui_state, &app.gfx) {\\n        (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\\n        _ => false,\\n    };\\n    let _ = consumed;\\n    match event {\\n        WindowEvent::CloseRequested => el.exit(),\\n        WindowEvent::Resized(sz) => {\\n            if let Some(g) = &mut app.gfx {\\n                g.resize(sz.width, sz.height);\\n            }\\n        }\\n        WindowEvent::RedrawRequested => {\\n            surgery_frame(app);\\n            if app.quit {\\n                el.exit();\\n            }\\n        }\\n        WindowEvent::KeyboardInput { event, .. } => {\\n            #[cfg(target_arch = \\\"wasm32\\\")]\\n            app.resume_audio();\\n            if let PhysicalKey::Code(code) = event.physical_key {\\n                match event.state {\\n                    ElementState::Pressed if !event.repeat => {\\n                        app.harbor.keys.insert(code);\\n                        app.harbor.just.push(code);\\n                    }\\n                    ElementState::Released => {\\n                        app.harbor.keys.remove(&code);\\n                    }\\n                    _ => {}\\n                }\\n            }\\n        }\\n        WindowEvent::MouseInput { state, button, .. } => {\\n            #[cfg(target_arch = \\\"wasm32\\\")]\\n            app.resume_audio();\\n            let down = state == ElementState::Pressed;\\n            match button {\\n                MouseButton::Left => {\\n                    app.harbor.mouse_left = down;\\n                    if down {\\n                        app.harbor.mouse_click = true;\\n                    }\\n                }\\n                MouseButton::Right => app.harbor.mouse_right = down,\\n                _ => {}\\n            }\\n        }\\n        WindowEvent::CursorMoved { position, .. } => {\\n            let p = Vec2::new(position.x as f32, position.y as f32);\\n            if (p - app.harbor.mouse).length() > 1.5 {\\n                app.harbor.mouse_moved = true;\\n            }\\n            app.harbor.mouse = p;\\n        }\\n        WindowEvent::MouseWheel { delta, .. } => {\\n            let lines = match delta {\\n                MouseScrollDelta::LineDelta(_, y) => y,\\n                MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\\n            };\\n            app.harbor.wheel += lines;\\n        }\\n        WindowEvent::Touch(t) => {\\n            app.harbor.shell.touch_only = true;\\n            if t.phase == winit::event::TouchPhase::Started {\\n                app.harbor.touch_click = true;\\n                app.harbor.mouse = Vec2::new(t.location.x as f32, t.location.y as f32);\\n            }\\n        }\\n        _ => {}\\n    }\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_app/src/product.rs has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_app/src/product.rs has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_app/src/product.rs\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"//! Hands of Harbor's frame. A surgery scene never enters the demo menu, camera, or touch layer.\\n\\nuse std::cell::{Cell, RefCell};\\nuse std::collections::HashSet;\\n\\nuse glam::{Vec2, Vec3};\\nuse pav_core::games::surgery::{self, Surgery, SurgeryFrame, TITLE, TOOL_KEEP};\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_ui::surgery::{Cmd, DeviceKind, Input as ShellIn, Shell};\\nuse pav_view::{CameraParams, ViewSettings};\\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\\nuse winit::event_loop::ActiveEventLoop;\\nuse winit::keyboard::{KeyCode, PhysicalKey};\\nuse winit::window::WindowId;\\n\\nuse super::App;\\n\\nstruct PadHand {\\n    present: bool,\\n    left: Vec2,\\n    right: Vec2,\\n    south: bool,\\n    east: bool,\\n    north: bool,\\n    west: bool,\\n    l1: bool,\\n    r1: bool,\\n    start: bool,\\n    up: bool,\\n    down: bool,\\n    left_b: bool,\\n    right_b: bool,\\n    lt: f32,\\n    rt: f32,\\n}\\n\\nimpl Default for PadHand {\\n    fn default() -> Self {\\n        Self {\\n            present: false,\\n            left: Vec2::ZERO,\\n            right: Vec2::ZERO,\\n            south: false,\\n            east: false,\\n            north: false,\\n            west: false,\\n            l1: false,\\n            r1: false,\\n            start: false,\\n            up: false,\\n            down: false,\\n            left_b: false,\\n            right_b: false,\\n            lt: 0.0,\\n            rt: 0.0,\\n        }\\n    }\\n}\\n\\npub struct Harbor {\\n    pub shell: Shell,\\n    keys: HashSet<KeyCode>,\\n    just: Vec<KeyCode>,\\n    mouse: Vec2,\\n    mouse_left: bool,\\n    mouse_right: bool,\\n    mouse_click: bool,\\n    mouse_moved: bool,\\n    wheel: f32,\\n    touch_click: bool,\\n    pads: [PadHand; 4],\\n    prev_oct: [Option<u8>; 4],\\n    prev_l1: [bool; 4],\\n    prev_r1: [bool; 4],\\n    tool: [u8; 4],\\n    font: bool,\\n    music_name: String,\\n    music_left: f32,\\n    status: String,\\n}\\n\\nimpl Harbor {\\n    pub fn new(touch_only: bool) -> Self {\\n        let mut shell = Shell::new();\\n        shell.touch_only = touch_only;\\n        Self {\\n            shell,\\n            keys: HashSet::new(),\\n            just: Vec::new(),\\n            mouse: Vec2::ZERO,\\n            mouse_left: false,\\n            mouse_right: false,\\n            mouse_click: false,\\n            mouse_moved: false,\\n            wheel: 0.0,\\n            touch_click: false,\\n            pads: std::array::from_fn(|_| PadHand::default()),\\n            prev_oct: [None; 4],\\n            prev_l1: [false; 4],\\n            prev_r1: [false; 4],\\n            tool: [0; 4],\\n            font: false,\\n            music_name: String::new(),\\n            music_left: 0.0,\\n            status: String::new(),\\n        }\\n    }\\n\\n    fn key(&self, code: KeyCode) -> bool {\\n        self.keys.contains(&code)\\n    }\\n\\n    fn ate(&mut self, code: KeyCode) -> bool {\\n        let hit = self.just.contains(&code);\\n        if hit {\\n            self.just.retain(|k| *k != code);\\n        }\\n        hit\\n    }\\n\\n    fn poll_pads(&mut self, gilrs: Option<&mut gilrs::Gilrs>) {\\n        for p in &mut self.pads {\\n            p.present = false;\\n        }\\n        let Some(g) = gilrs else { return };\\n        while g.next_event().is_some() {}\\n        for (i, (_, gp)) in g.gamepads().take(4).enumerate() {\\n            use gilrs::{Axis, Button};\\n            let pressed = |b: Button| gp.is_pressed(b);\\n            let analog = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0);\\n            self.pads[i] = PadHand {\\n                present: true,\\n                left: dead(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY))),\\n                right: dead(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY))),\\n                south: pressed(Button::South),\\n                east: pressed(Button::East),\\n                north: pressed(Button::North),\\n                west: pressed(Button::West),\\n                l1: pressed(Button::LeftTrigger),\\n                r1: pressed(Button::RightTrigger),\\n                start: pressed(Button::Start),\\n                up: pressed(Button::DPadUp),\\n                down: pressed(Button::DPadDown),\\n                left_b: pressed(Button::DPadLeft),\\n                right_b: pressed(Button::DPadRight),\\n                lt: analog(Button::LeftTrigger2),\\n                rt: analog(Button::RightTrigger2),\\n            };\\n        }\\n    }\\n\\n    /// Shell step plus one frame of surgeon hands. `aim` is the mouse on the field, if it hit.\\n    fn compose(&mut self, dt: f32, aim: Option<[f32; 2]>) -> (Vec<Cmd>, [SurgeonInput; 4], bool) {\\n        let op = self.shell.screen_name() == \\\"op\\\";\\n        let pad0 = &self.pads[0];\\n        let pad_nav = pad0.present && (pad0.up || pad0.down || pad0.south || pad0.east || pad0.start || pad0.left.length() > 0.2 || pad0.right.length() > 0.2);\\n        let mouse_fine = self.mouse_moved || self.mouse_click || self.just.iter().any(|k| !matches!(k, KeyCode::F1 | KeyCode::F2 | KeyCode::F3));\\n        let device = if pad_nav && !mouse_fine { Some(DeviceKind::Gamepad) } else if mouse_fine || !self.just.is_empty() { Some(DeviceKind::KeyboardMouse) } else { None };\\n        let up = self.ate(KeyCode::ArrowUp) || edge_pad(pad0.up, false);\\n        let down = self.ate(KeyCode::ArrowDown) || pad0.down && !op;\\n        let left = self.ate(KeyCode::ArrowLeft) || pad0.left_b;\\n        let right = self.ate(KeyCode::ArrowRight) || pad0.right_b;\\n        let confirm = self.ate(KeyCode::Enter) || self.ate(KeyCode::NumpadEnter) || self.ate(KeyCode::Space) && !op || (pad0.south && !op);\\n        let back = self.ate(KeyCode::Escape) || pad0.east && !op || pad0.start;\\n        let any = device.is_some() || self.mouse_moved || self.touch_click || self.mouse_click || back || confirm || up || down;\\n        let pointer = if op { None } else { Some([self.mouse.x, self.mouse.y]) };\\n        let click = !op && (self.mouse_click || self.touch_click);\\n        let cmds = self.shell.step(ShellIn {\\n            up: !op && up,\\n            down: !op && down,\\n            left: !op && left,\\n            right: !op && right,\\n            confirm: !op && confirm,\\n            back,\\n            tab_l: self.ate(KeyCode::PageUp) || self.ate(KeyCode::BracketLeft),\\n            tab_r: self.ate(KeyCode::PageDown) || self.ate(KeyCode::BracketRight),\\n            pointer,\\n            click,\\n            any,\\n            dt,\\n            device,\\n        });\\n        let confirm_sim = cmds.iter().any(|c| matches!(c, Cmd::ConfirmSim));\\n        self.tools_from_hands(op);\\n        let mut surgeons = [SurgeonInput { tool: TOOL_KEEP, ..SurgeonInput::default() }; 4];\\n        if op {\\n            for i in 0..4 {\\n                surgeons[i] = self.hand(i, aim, i == 0 && self.mouse_moved);\\n            }\\n        } else if confirm_sim {\\n            surgeons[0].active = true;\\n            surgeons[0].tool = TOOL_KEEP;\\n            surgeons[0].held |= surg::CONFIRM;\\n            surgeons[0].pressed |= surg::CONFIRM;\\n        }\\n        self.mouse_click = false;\\n        self.mouse_moved = false;\\n        self.touch_click = false;\\n        self.wheel = 0.0;\\n        self.just.clear();\\n        (cmds, surgeons, confirm_sim)\\n    }\\n\\n    fn tools_from_hands(&mut self, op: bool) {\\n        if !op {\\n            return;\\n        }\\n        for i in 0..4 {\\n            let pad = &self.pads[i];\\n            if !pad.present {\\n                continue;\\n            }\\n            let using = pad.rt > 0.2 || pad.south;\\n            if pad.l1 && !self.prev_l1[i] {\\n                if using {\\n                    // rotation is a hold, handled in hand()\\n                } else {\\n                    self.tool[i] = (self.tool[i] + 7) % 8;\\n                }\\n            }\\n            if pad.r1 && !self.prev_r1[i] && !using {\\n                self.tool[i] = (self.tool[i] + 1) % 8;\\n            }\\n            self.prev_l1[i] = pad.l1;\\n            self.prev_r1[i] = pad.r1;\\n            let oct = octant(pad.left);\\n            if let Some(t) = oct {\\n                if self.prev_oct[i] != Some(t) {\\n                    self.tool[i] = t;\\n                }\\n            }\\n            self.prev_oct[i] = oct;\\n        }\\n        if self.wheel.abs() > 0.01 && !(self.mouse_left) {\\n            let dir = if self.wheel > 0.0 { 1 } else { 7 };\\n            self.tool[0] = (self.tool[0] + dir) % 8;\\n        }\\n        for (code, tool) in DIGITS {\\n            if self.ate(code) {\\n                self.tool[0] = tool;\\n            }\\n        }\\n    }\\n\\n    fn hand(&self, slot: usize, mouse_aim: Option<[f32; 2]>, mouse_owns: bool) -> SurgeonInput {\\n        let pad = &self.pads[slot];\\n        let mut held = 0;\\n        let mut pressed = 0;\\n        let mut aim = Vec2::ZERO;\\n        let mut pressure = 0.85;\\n        if slot == 0 && mouse_owns {\\n            if let Some(p) = mouse_aim {\\n                aim = Vec2::new(p[0], p[1]);\\n                held |= surg::AIM_ABSOLUTE | surg::SNAP;\\n            }\\n        } else if pad.present && pad.right.length() > 0.12 {\\n            aim = shape_stick(Vec2::new(pad.right.x, -pad.right.y));\\n        } else if slot == 0 && !mouse_owns {\\n            let mut v = Vec2::ZERO;\\n            if self.key(KeyCode::KeyW) || self.key(KeyCode::ArrowUp) {\\n                v.y += 1.0;\\n            }\\n            if self.key(KeyCode::KeyS) || self.key(KeyCode::ArrowDown) {\\n                v.y -= 1.0;\\n            }\\n            if self.key(KeyCode::KeyD) || self.key(KeyCode::ArrowRight) {\\n                v.x += 1.0;\\n            }\\n            if self.key(KeyCode::KeyA) || self.key(KeyCode::ArrowLeft) {\\n                v.x -= 1.0;\\n            }\\n            if v.length_squared() > 0.0 {\\n                aim = shape_stick(Vec2::new(v.x, -v.y));\\n            }\\n        }\\n        let use_key = slot == 0 && (self.mouse_left || self.key(KeyCode::KeyE));\\n        let use_pad = pad.present && (pad.rt > 0.08 || pad.south);\\n        if use_key || use_pad {\\n            held |= surg::USE;\\n            pressure = if pad.rt > 0.08 { pad.rt.max(0.15) } else { 1.0 };\\n        }\\n        let precise = (slot == 0 && self.key(KeyCode::ShiftLeft) && !mouse_owns) || pad.lt > 0.35;\\n        if precise {\\n            held |= surg::PRECISION;\\n        }\\n        if slot == 0 && (self.mouse_right || self.key(KeyCode::KeyQ)) || pad.east {\\n            held |= surg::CANCEL;\\n        }\\n        if slot == 0 && self.key(KeyCode::Space) || pad.north {\\n            held |= surg::GIFT;\\n        }\\n        if slot == 0 && self.key(KeyCode::Tab) || pad.west {\\n            held |= surg::CHART;\\n        }\\n        let both_mouse = slot == 0 && self.mouse_left && self.mouse_right;\\n        let both_trig = pad.lt > 0.45 && pad.rt > 0.45;\\n        if both_mouse || both_trig || self.tool[slot] == 10 && (use_key || use_pad) {\\n            held |= surg::DEFIB;\\n        }\\n        let using = held & surg::USE != 0;\\n        if using && pad.l1 {\\n            held |= surg::ROT_L;\\n        }\\n        if using && pad.r1 {\\n            held |= surg::ROT_R;\\n        }\\n        if slot == 0 && using && self.wheel > 0.1 {\\n            held |= surg::ROT_R;\\n        }\\n        if slot == 0 && using && self.wheel < -0.1 {\\n            held |= surg::ROT_L;\\n        }\\n        let active = slot == 0 || pad.present;\\n        let _ = pressed;\\n        SurgeonInput { active, aim, held, pressed, tool: self.tool[slot], pressure }\\n    }\\n}\\n\\nconst DIGITS: [(KeyCode, u8); 11] = [\\n    (KeyCode::Digit1, 0),\\n    (KeyCode::Digit2, 1),\\n    (KeyCode::Digit3, 2),\\n    (KeyCode::Digit4, 3),\\n    (KeyCode::Digit5, 4),\\n    (KeyCode::Digit6, 5),\\n    (KeyCode::Digit7, 6),\\n    (KeyCode::Digit8, 7),\\n    (KeyCode::Digit9, 8),\\n    (KeyCode::Digit0, 9),\\n    (KeyCode::Minus, 10),\\n];\\n\\nfn dead(v: Vec2) -> Vec2 {\\n    if v.length() < 0.18 { Vec2::ZERO } else { v.clamp_length_max(1.0) }\\n}\\n\\nfn shape_stick(v: Vec2) -> Vec2 {\\n    let mag = v.length().min(1.0);\\n    if mag < 0.001 {\\n        return Vec2::ZERO;\\n    }\\n    v.normalize() * mag.powf(2.2)\\n}\\n\\nfn octant(stick: Vec2) -> Option<u8> {\\n    if stick.length() < 0.55 {\\n        return None;\\n    }\\n    let ang = stick.x.atan2(stick.y);\\n    Some((ang / std::f32::consts::FRAC_PI_4).round() as i32).map(|i| i.rem_euclid(8) as u8)\\n}\\n\\nfn edge_pad(now: bool, _prev: bool) -> bool {\\n    now\\n}\\n\\nfn to_sim(c: Cmd) -> Option<SurgeryCmd> {\\n    Some(match c {\\n        Cmd::LoadCampaign => SurgeryCmd::LoadCampaign,\\n        Cmd::LoadCase(n) => SurgeryCmd::LoadCase(n),\\n        Cmd::LoadCode => SurgeryCmd::LoadCode,\\n        Cmd::LoadAttract => SurgeryCmd::LoadAttract,\\n        Cmd::ToTitle => SurgeryCmd::ToTitle,\\n        Cmd::SetDifficulty(d) => SurgeryCmd::SetDifficulty(d),\\n        Cmd::Retry => SurgeryCmd::Retry,\\n        Cmd::SetTune { id, value } => SurgeryCmd::SetTune { id, value },\\n        Cmd::ResetTune => SurgeryCmd::ResetTune,\\n        Cmd::SetBus { which, value } => SurgeryCmd::SetBus { which, value },\\n        Cmd::Dev { what, extra } => SurgeryCmd::Dev { what, extra },\\n        Cmd::ConfirmSim => return None,\\n    })\\n}\\n\\nfn track_name(op: &SurgeryFrame) -> &'static str {\\n    if op.gift_hush > 0.0 {\\n        return \\\"hush\\\";\\n    }\\n    if op.flat || op.code_t >= 0.0 {\\n        return \\\"code\\\";\\n    }\\n    match op.mode {\\n        1 => {\\n            if op.case_id % 2 == 0 {\\n                \\\"story_ward\\\"\\n            } else {\\n                \\\"story_night\\\"\\n            }\\n        }\\n        3 | 6 => match op.strain {\\n            0..=3 => \\\"introit\\\",\\n            4..=7 => \\\"lacrimosa\\\",\\n            8..=10 => \\\"dies\\\",\\n            11..=17 => \\\"libera\\\",\\n            _ => {\\n                if op.case_id < 0 {\\n                    \\\"code\\\"\\n                } else {\\n                    \\\"or\\\"\\n                }\\n            }\\n        },\\n        4 => \\\"results\\\",\\n        5 => \\\"crisis\\\",\\n        7 => \\\"code\\\",\\n        _ => \\\"title\\\",\\n    }\\n}\\n\\npub fn surgery_frame(app: &mut App) {\\n    if app.gfx.is_none() || app.host.is_none() {\\n        return;\\n    }\\n    let now = web_time::Instant::now();\\n    let dt = (now - app.last).as_secs_f32().min(0.1);\\n    app.last = now;\\n\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    drain_hook(app);\\n\\n    app.harbor.poll_pads(app.input.gilrs.as_mut());\\n    aim_rig(app);\\n    let (w, h) = app.gfx.as_ref().unwrap().size();\\n    let size = Vec2::new(w as f32, h as f32);\\n    let hit = app.rig.ground_point(app.harbor.mouse, size, 0.0).map(|p| [p.x, p.z]);\\n    if app.harbor.mouse_click {\\n        if let Some(p) = hit {\\n            if let Some(tool) = tray_tool(p[0], p[1]) {\\n                app.harbor.tool[0] = tool;\\n            }\\n        }\\n    }\\n    let (cmds, surgeons, _) = app.harbor.compose(dt, hit);\\n    let host = app.host.as_ref().unwrap();\\n    let paused = app.harbor.shell.paused();\\n    host.set_control(|c| c.paused = paused);\\n    for cmd in cmds {\\n        if let Some(sim_cmd) = to_sim(cmd) {\\n            host.exec(move |sim| {\\n                if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                    g.apply_cmd(sim_cmd);\\n                }\\n            });\\n        }\\n    }\\n    {\\n        let mut input = host.shared.input.lock().unwrap();\\n        *input = InputFrame::default();\\n        input.surgeons = surgeons;\\n    }\\n    host.pump();\\n\\n    let (prev, curr, curr_at, tick_wall) = host.frames();\\n    let _ = (curr_at, tick_wall);\\n    let op = curr.surgery.clone();\\n    if let Some(op) = &op {\\n        app.harbor.shell.note_mode(op.mode);\\n        if op.mode == 3 {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(false);\\n        } else {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(true);\\n        }\\n    }\\n    let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\\n    if let Some(a) = &app.audio {\\n        let music = op.as_ref().map(|o| o.music).unwrap_or(0.10);\\n        let effects = op.as_ref().map(|o| o.effects).unwrap_or(0.80);\\n        let voices = op.as_ref().map(|o| o.voices).unwrap_or(0.70);\\n        a.set_buses(music, effects, voices);\\n        let l = pav_audio::Listener { pos: Vec3::new(0.0, 8.0, 12.0), right: Vec3::X };\\n        for e in &events {\\n            a.play_event(e, &l, effects);\\n        }\\n        let name = op.as_ref().map(|o| track_name(o)).unwrap_or(\\\"title\\\");\\n        if app.harbor.music_name != name {\\n            app.harbor.music_name = name.to_string();\\n            app.harbor.music_left = 0.0;\\n        }\\n        app.harbor.music_left -= dt;\\n        if app.harbor.music_left <= 0.0 {\\n            let bpm = op.as_ref().map(|o| o.bpm).unwrap_or(72.0).clamp(60.0, 140.0);\\n            let (dur, notes) = pav_audio::music::phrase(name, bpm);\\n            for n in notes {\\n                a.play_bus(n.patch, n.pan, n.gain, n.delay, pav_audio::BUS_MUSIC);\\n            }\\n            app.harbor.music_left = dur.max(0.5);\\n        }\\n    }\\n    app.builder.add_events(&events);\\n    app.builder.now = app.started.elapsed().as_secs_f64();\\n    let view = ViewSettings::default();\\n    let focus = curr.focus;\\n    let mut scene = app.builder.build(&prev, &curr, 1.0, &app.rig, w as f32 / h.max(1) as f32, &view, focus);\\n\\n    let gfx = app.gfx.as_mut().unwrap();\\n    let native = gfx.window.scale_factor() as f32;\\n    let zoom = (h as f32 / 1080.0) / native.max(0.25);\\n    app.egui_ctx.set_zoom_factor(zoom);\\n    if !app.harbor.font {\\n        pav_ui::surgery::install_font(&app.egui_ctx);\\n        app.harbor.font = true;\\n    }\\n    let state = app.egui_state.as_mut().unwrap();\\n    let raw = state.take(&gfx.window);\\n    let shell = &app.harbor.shell;\\n    let op_ref = op.as_deref();\\n    let out = app.egui_ctx.run_ui(raw, |ui| {\\n        pav_ui::surgery::draw(ui, shell, op_ref);\\n    });\\n    state.platform_output(&gfx.window, out.platform_output);\\n    let ppp = out.pixels_per_point;\\n    let prims = app.egui_ctx.tessellate(out.shapes, ppp);\\n    let mut textures = out.textures_delta;\\n    gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\\n    let _ = &mut scene;\\n\\n    let status = status_json(&app.harbor.shell, op.as_deref(), &curr);\\n    app.harbor.status = status.clone();\\n    publish_status(&status);\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    install_hook(app);\\n}\\n\\nfn aim_rig(app: &mut App) {\\n    app.rig.params = CameraParams {\\n        tilt: 73.0,\\n        yaw: 0.0,\\n        distance: 19.9,\\n        fov: 36.0,\\n        ortho: false,\\n        follow_lag: 0.0,\\n        height_offset: 0.0,\\n    };\\n    app.rig.snap(Vec3::new(0.0, 0.0, 0.2));\\n}\\n\\nfn tray_tool(x: f32, z: f32) -> Option<u8> {\\n    if (z - 5.4).abs() > 0.7 {\\n        return None;\\n    }\\n    for t in 0..8 {\\n        let tx = -3.5 + t as f32;\\n        if (x - tx).abs() < 0.45 {\\n            return Some(t as u8);\\n        }\\n    }\\n    None\\n}\\n\\nfn status_json(shell: &Shell, op: Option<&SurgeryFrame>, curr: &pav_core::RenderFrame) -> String {\\n    let music = op.map(|o| o.music).unwrap_or(0.10);\\n    let cursors: Vec<_> = op\\n        .map(|o| {\\n            o.cursors\\n                .iter()\\n                .map(|c| serde_json::json!({\\\"x\\\": c.x, \\\"z\\\": c.z, \\\"tool\\\": c.tool, \\\"active\\\": c.active}))\\n                .collect()\\n        })\\n        .unwrap_or_default();\\n    let sim = curr.play_status.clone().unwrap_or_else(|| serde_json::json!({}));\\n    serde_json::json!({\\n        \\\"screen\\\": shell.screen_name(),\\n        \\\"focus\\\": shell.focus(),\\n        \\\"device\\\": if shell.device == DeviceKind::Gamepad { \\\"gamepad\\\" } else { \\\"keyboard\\\" },\\n        \\\"xbox\\\": shell.xbox,\\n        \\\"music\\\": format!(\\\"{music:.2}\\\"),\\n        \\\"title\\\": TITLE,\\n        \\\"cursors\\\": cursors,\\n        \\\"sim\\\": sim,\\n        \\\"vitals\\\": op.map(|o| o.vitals),\\n        \\\"bpm\\\": op.map(|o| o.bpm),\\n        \\\"timer\\\": op.map(|o| o.timer),\\n        \\\"mode\\\": op.map(|o| o.mode),\\n    })\\n    .to_string()\\n}\\n\\nfn publish_status(s: &str) {\\n    STATUS.with(|c| *c.borrow_mut() = s.to_string());\\n}\\n\\nthread_local! {\\n    static STATUS: RefCell<String> = const { RefCell::new(String::new()) };\\n    static BURST: Cell<u32> = const { Cell::new(0) };\\n    static HOOKED: Cell<bool> = const { Cell::new(false) };\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn drain_hook(app: &mut App) {\\n    let n = BURST.with(|b| b.replace(0));\\n    if n > 0 {\\n        if let Some(host) = &app.host {\\n            host.burst(n);\\n        }\\n    }\\n}\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nfn drain_hook(_app: &mut App) {}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn install_hook(app: &App) {\\n    if HOOKED.with(|h| h.get()) {\\n        return;\\n    }\\n    use wasm_bindgen::JsCast;\\n    let Some(win) = web_sys::window() else { return };\\n    let obj = js_sys::Object::new();\\n    let status = wasm_bindgen::closure::Closure::wrap(Box::new(|| {\\n        STATUS.with(|s| wasm_bindgen::JsValue::from_str(&s.borrow()))\\n    }) as Box<dyn Fn() -> wasm_bindgen::JsValue>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"status\\\".into(), status.as_ref().unchecked_ref());\\n    status.forget();\\n    let step = wasm_bindgen::closure::Closure::wrap(Box::new(|n: u32| {\\n        BURST.with(|b| b.set(b.get().saturating_add(n)));\\n    }) as Box<dyn Fn(u32)>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"step\\\".into(), step.as_ref().unchecked_ref());\\n    step.forget();\\n    let _ = js_sys::Reflect::set(&win, &\\\"__game\\\".into(), &obj);\\n    HOOKED.with(|h| h.set(true));\\n    let _ = app;\\n}\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nfn install_hook(_app: &App) {}\\n\\npub fn surgery_event(app: &mut App, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\\n    let consumed = match (&mut app.egui_state, &app.gfx) {\\n        (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\\n        _ => false,\\n    };\\n    let _ = consumed;\\n    match event {\\n        WindowEvent::CloseRequested => el.exit(),\\n        WindowEvent::Resized(sz) => {\\n            if let Some(g) = &mut app.gfx {\\n                g.resize(sz.width, sz.height);\\n            }\\n        }\\n        WindowEvent::RedrawRequested => {\\n            surgery_frame(app);\\n            if app.quit {\\n                el.exit();\\n            }\\n        }\\n        WindowEvent::KeyboardInput { event, .. } => {\\n            #[cfg(target_arch = \\\"wasm32\\\")]\\n            app.resume_audio();\\n            if let PhysicalKey::Code(code) = event.physical_key {\\n                match event.state {\\n                    ElementState::Pressed if !event.repeat => {\\n                        app.harbor.keys.insert(code);\\n                        app.harbor.just.push(code);\\n                    }\\n                    ElementState::Released => {\\n                        app.harbor.keys.remove(&code);\\n                    }\\n                    _ => {}\\n                }\\n            }\\n        }\\n        WindowEvent::MouseInput { state, button, .. } => {\\n            #[cfg(target_arch = \\\"wasm32\\\")]\\n            app.resume_audio();\\n            let down = state == ElementState::Pressed;\\n            match button {\\n                MouseButton::Left => {\\n                    app.harbor.mouse_left = down;\\n                    if down {\\n                        app.harbor.mouse_click = true;\\n                    }\\n                }\\n                MouseButton::Right => app.harbor.mouse_right = down,\\n                _ => {}\\n            }\\n        }\\n        WindowEvent::CursorMoved { position, .. } => {\\n            let p = Vec2::new(position.x as f32, position.y as f32);\\n            if (p - app.harbor.mouse).length() > 1.5 {\\n                app.harbor.mouse_moved = true;\\n            }\\n            app.harbor.mouse = p;\\n        }\\n        WindowEvent::MouseWheel { delta, .. } => {\\n            let lines = match delta {\\n                MouseScrollDelta::LineDelta(_, y) => y,\\n                MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\\n            };\\n            app.harbor.wheel += lines;\\n        }\\n        WindowEvent::Touch(t) => {\\n            app.harbor.shell.touch_only = true;\\n            if t.phase == winit::event::TouchPhase::Started {\\n                app.harbor.touch_click = true;\\n                app.harbor.mouse = Vec2::new(t.location.x as f32, t.location.y as f32);\\n            }\\n        }\\n        _ => {}\\n    }\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"6f95928f-7342-47d4-9652-4ed33e94f563"}
