engine/crates/pav_view/src/surgery/mod.rs\",\"matches\":[{\"line_number\":241,\"content\":\"        LASER | CRYO => Vec3::new(0.0, 0.08, 0.42),\"},{\"line_number\":536,\"content\":\"            tool: CRYO,\"},{\"line_number\":552,\"content\":\"                tool: CRYO,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_app/src/product.rs\",\"matches\":[{\"line_number\":7,\"content\":\"use pav_core::games::surgery::{contextual_tool, cycle, octant, tray_tool, Surgery, SurgeryFrame, TITLE, TOOL_KEEP};\"},{\"line_number\":277,\"content\":\"                let oct = octant(pad.left);\"},{\"line_number\":479,\"content\":\"            if let Some(tool) = tray_tool(p[0], p[1]) {\"},{\"line_number\":499,\"content\":\"                    g.hub_quiet = true;\"},{\"line_number\":713,\"content\":\"        s.tool = contextual_tool(s.tool, x, z, &op.hazards);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/arpg/world.rs\",\"matches\":[{\"line_number\":28,\"content\":\"/// Level dressing: library props from `game/props.toml` sets.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/arpg/data.rs\",\"matches\":[{\"line_number\":406,\"content\":\"    /// Level dressing sets (game/props.toml), which themes name in `props`.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/arpg/world/dress.rs\",\"matches\":[{\"line_number\":1,\"content\":\"//! Level dressing (asset plan SF-2): every room gets 3-6 library props from the sets its theme\"},{\"line_number\":37,\"content\":\"/// A dressing set (`game/props.toml`); a theme's `props` lists set names.\"},{\"line_number\":181,\"content\":\"    /// What dressing keeps clear of beyond `taken`: the actors (monsters, the boss, kegs,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/statics.rs\",\"matches\":[{\"line_number\":239,\"content\":\"/// A library asset baked into a region (level dressing): the view's region cache draws its\"},{\"line_number\":335,\"content\":\"    /// Library assets baked in (level dressing).\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/bot.rs\",\"matches\":[{\"line_number\":145,\"content\":\"    let paint = matches!(h.tool, GEL | DRESSING) && matches!(h.kind, K_INFLAM | K_BURN | K_DRESSING | K_TUMOR);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/story.rs\",\"matches\":[{\"line_number\":70,\"content\":\"    \\\"Bashir Haddad\\\", \\\"He asked for Thursday. I told him Thursday is a rumor until the dressing comes off.\\\";\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/map.rs\",\"matches\":[{\"line_number\":2,\"content\":\"//! Cryoprobe and Dressing are contextual: the ring stays 0–7, and the hazard under the cursor promotes Laser or Scanner to the probe, or any ring tool to a dressing.\"},{\"line_number\":64,\"content\":\"pub fn octant(stick: Vec2) -> Option<u8> {\"},{\"line_number\":79,\"content\":\"pub fn tray_tool(x: f32, z: f32) -> Option<u8> {\"},{\"line_number\":95,\"content\":\"/// An already-resolved probe or dressing is folded back to its ring first, so leaving the wound puts the ring tool back.\"},{\"line_number\":96,\"content\":\"pub fn contextual_tool<T: ToolSite>(ring: u8, x: f32, z: f32, sites: &[T]) -> u8 {\"},{\"line_number\":101,\"content\":\"        CRYO => LASER,\"},{\"line_number\":102,\"content\":\"        DRESSING => GEL,\"},{\"line_number\":106,\"content\":\"    let mut only_dressing = true;\"},{\"line_number\":112,\"content\":\"        if site.site_kind() != K_DRESSING {\"},{\"line_number\":113,\"content\":\"            only_dressing = false;\"},{\"line_number\":116,\"content\":\"    if any && only_dressing {\"},{\"line_number\":117,\"content\":\"        return DRESSING;\"},{\"line_number\":134,\"content\":\"        if tool == DRESSING {\"},{\"line_number\":135,\"content\":\"            return DRESSING;\"},{\"line_number\":137,\"content\":\"        if tool == CRYO && (ring == LASER || ring == SCANNER) {\"},{\"line_number\":138,\"content\":\"            return CRYO;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs\",\"matches\":[{\"line_number\":185,\"content\":\"            K_DRESSING => {\"},{\"line_number\":410,\"content\":\"        K_POLYP | K_NODULE | K_EMBER if h.stage == 0 && (h.kind != K_EMBER || h.tool == CRYO) => {\"},{\"line_number\":411,\"content\":\"            let cue = if h.tool == CRYO { CUE_FROST } else { CUE_LASER };\"},{\"line_number\":412,\"content\":\"            let misuse = if h.tool == CRYO { 4 } else { 2 };\"},{\"line_number\":427,\"content\":\"        K_INFLAM | K_BURN | K_DRESSING | K_TUMOR if h.tool == GEL || h.tool == DRESSING => {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/kinds.rs\",\"matches\":[{\"line_number\":13,\"content\":\"pub const CRYO: u8 = 8;\"},{\"line_number\":14,\"content\":\"pub const DRESSING: u8 = 9;\"},{\"line_number\":39,\"content\":\"pub const K_DRESSING: u8 = 16;\"},{\"line_number\":47,\"content\":\"    \\\"ember\\\", \\\"heat\\\", \\\"tether\\\", \\\"tendril\\\", \\\"dressing\\\", \\\"iv\\\", \\\"burn\\\",\"},{\"line_number\":185,\"content\":\"            0 => CRYO,\"},{\"line_number\":189,\"content\":\"        K_DRESSING => DRESSING,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/content.rs\",\"matches\":[{\"line_number\":71,\"content\":\"    s(K_DRESSING, -0.15, -1.45, false, 0.2, 0.0),\"},{\"line_number\":168,\"content\":\"const C7_G: &[SpawnDef] = &[s(K_DRESSING, 0.0, -0.15, false, 0.1, 0.0)];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/mod.rs\",\"matches\":[{\"line_number\":22,\"content\":\"pub use map::{contextual_tool, cycle, octant, tray_tool};\"},{\"line_number\":222,\"content\":\"    pub hub_quiet: bool,\"},{\"line_number\":297,\"content\":\"            hub_quiet: false,\"},{\"line_number\":317,\"content\":\"        g.hub_quiet = quiet;\"},{\"line_number\":331,\"content\":\"        self.hub_quiet = true;\"},{\"line_number\":971,\"content\":\"        fr.quiet = self.hub_quiet;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"matches\":[{\"line_number\":343,\"content\":\"        let tool = contextual_tool(ring, x, z, &g.hazards);\"},{\"line_number\":639,\"content\":\"            g.spawn_kind_at(K_DRESSING, 0.6, -1.0, 0.1);\"},{\"line_number\":755,\"content\":\"        g.surgeons[i].tool = contextual_tool(tool, x, z, &g.hazards);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/tests/surgery.rs\",\"matches\":[{\"line_number\":4,\"content\":\"    all_lines, chain_mul, contextual_tool, cycle, octant, rank_of, tray_tool, Hazard, Heart, Surgery, CASES, CRYO, DRESSING,\"},{\"line_number\":5,\"content\":\"    FORCEPS, GEL, K_BONE, K_DRESSING, K_EMBER, K_POLYP, K_POOL, K_TETHER, LASER, R_SLOPPY, SCALPEL, SCANNER, SUCTION,\"},{\"line_number\":336,\"content\":\"/// Ring tools stay 0–7. Cryoprobe and Dressing are whatever `contextual_tool` returns.\"},{\"line_number\":339,\"content\":\"    let tool = contextual_tool(ring, x, z, &game(sim).hazards);\"},{\"line_number\":357,\"content\":\"fn shipped_mapping_clears_an_ember_and_a_dressing() {\"},{\"line_number\":362,\"content\":\"    let down = octant(Vec2::new(0.0, -1.0)).expect(\\\"down\\\");\"},{\"line_number\":363,\"content\":\"    let left = octant(Vec2::new(-1.0, 0.0)).expect(\\\"left\\\");\"},{\"line_number\":366,\"content\":\"    assert!(octant(Vec2::new(0.2, 0.2)).is_none(), \\\"a short flick must not pick a tool\\\");\"},{\"line_number\":367,\"content\":\"    assert_eq!(contextual_tool(down, ember.x, ember.z, &game(&sim).hazards), CRYO);\"},{\"line_number\":368,\"content\":\"    assert_eq!(contextual_tool(left, ember.x, ember.z, &game(&sim).hazards), CRYO);\"},{\"line_number\":371,\"content\":\"    assert_eq!(game(&sim).surgeons[0].tool, CRYO, \\\"laser on an ember must become the cryoprobe\\\");\"},{\"line_number\":381,\"content\":\"            assert_eq!(sent, CRYO);\"},{\"line_number\":385,\"content\":\"        assert_eq!(sent, CRYO);\"},{\"line_number\":402,\"content\":\"    let forceps = tray_tool(-3.5 + FORCEPS as f32, 5.4).expect(\\\"forceps slot\\\");\"},{\"line_number\":404,\"content\":\"    assert!(tray_tool(0.0, 0.0).is_none());\"},{\"line_number\":417,\"content\":\"    let up_right = octant(Vec2::new(1.0, 1.0)).unwrap();\"},{\"line_number\":456,\"content\":\"    let up = octant(Vec2::new(0.0, 1.0)).unwrap();\"},{\"line_number\":469,\"content\":\"        if alive_kind(&sim, K_DRESSING).is_some() {\"},{\"line_number\":474,\"content\":\"    let dressing = alive_kind(&sim, K_DRESSING).unwrap_or_else(|| panic!(\\\"no dressing {}\\\", status(&sim)));\"},{\"line_number\":475,\"content\":\"    let did = dressing.id;\"},{\"line_number\":476,\"content\":\"    let gel = octant(Vec2::new(-1.0, -1.0)).unwrap();\"},{\"line_number\":478,\"content\":\"    assert_eq!(contextual_tool(gel, dressing.x, dressing.z, &game(&sim).hazards), DRESSING);\"},{\"line_number\":479,\"content\":\"    assert_ne!(contextual_tool(gel, 8.0, 3.0, &game(&sim).hazards), DRESSING);\"},{\"line_number\":480,\"content\":\"    place(&mut sim, dressing.x, dressing.z, gel, true, 0);\"},{\"line_number\":481,\"content\":\"    assert_eq!(game(&sim).surgeons[0].tool, DRESSING, \\\"a closure must auto-select dressing\\\");\"},{\"line_number\":494,\"content\":\"                assert_eq!(sent, DRESSING);\"},{\"line_number\":499,\"content\":\"    assert!(left.is_none(), \\\"dressing {:?} {}\\\", left.map(|h| (h.bits, h.work)), status(&sim));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/tests/levels.rs\",\"matches\":[{\"line_number\":482,\"content\":\"// ------------------------------------------------- dressing (asset plan SF-1, SF-2)\"},{\"line_number\":484,\"content\":\"/// Depths the dressing checks cover: every designed level and three endless ones.\"},{\"line_number\":494,\"content\":\"/// What dressing must never change: the features, every actor (monsters, kegs, totems, the\"},{\"line_number\":509,\"content\":\"fn dressing_never_moves_mechanics_or_monsters() {\"},{\"line_number\":513,\"content\":\"        assert_eq!(mechanics_of(&dressed), mechanics_of(&bare), \\\"depth {depth}: dressing moved something\\\");\"},{\"line_number\":522,\"content\":\"fn dressing_is_reproducible() {\"},{\"line_number\":534,\"content\":\"/// The plan's budget is 16 KB of snapshot per level for the dressing, about 80 B a prop. The\"},{\"line_number\":536,\"content\":\"/// rapier's own ~530 B on top (the old hard-coded dressing cost 75-80 KB per level in all).\"},{\"line_number\":538,\"content\":\"fn dressing_snapshot_cost() {\"},{\"line_number\":560,\"content\":\"fn dressing_keeps_paths() {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"07db1504-9911-4c01-ad9b-6f8786e25641"}
