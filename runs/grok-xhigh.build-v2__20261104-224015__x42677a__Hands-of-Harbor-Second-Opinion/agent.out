 -C debuginfo=line-tables-only --allow=clippy::type_complexity --allow=clipp\\npav_core\\n\",\"exit_code\":0,\"command\":\"ps -eo pid,etime,rss,args | awk '/rustc/ && !/awk/ {print}' | head -c 400\\necho\\ntr '\\\\0' ' ' < /proc/$(pgrep -n rustc)/cmdline | tr ' ' '\\\\n' | awk '/--crate-name/{getline; print}'\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Name the crate rustc is compiling\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-224015__x42677a%2Fwork/01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2/terminal/call-1c83811c-0028-43e1-aa57-16ef7554ae5b-161.log\",\"total_bytes\":410}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"fb92c700-78ec-4f79-b194-1aae1af57f7e"}
