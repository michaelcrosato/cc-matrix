    self.last_device = Device::KeyboardMouse;\\n        match state {\\n            ElementState::Pressed => {\\n                self.keys.insert(code);\\n                self.key_taps.insert(code);\\n            }\\n            ElementState::Released => {\\n                self.keys.remove(&code);\\n420→            }\\n        }\\n    }\\n\\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.mouse_active = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.mouse.insert(b);\\n430→                self.mouse_taps.insert(b);\\n            }\\n            ElementState::Released => {\\n                self.mouse.remove(&b);\\n            }\\n        }\\n    }\\n\\n    pub fn clear(&mut self) {\\n        self.keys.clear();\\n440→        self.mouse.clear();\\n    }\\n\\n    /// Reads gamepad events and state (first connected pad).\\n    pub fn poll_gamepad(&mut self) {\\n        use gilrs::{Axis, Button};\\n        let mut activity = false;\\n        let mut taps = Vec::new();\\n        // One pad state from the first connected pad, or from the pad script while it runs.\\n        let mut state: Option<PadState> = None;\\n450→        if let Some(g) = &mut self.gilrs {\\n            while let Some(ev) = g.next_event() {\\n                match ev.event {\\n                    gilrs::EventType::ButtonPressed(b, _) => {\\n                        taps.push(b);\\n                        activity = true;\\n                    }\\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\\n                    gilrs::EventType::Connected => log::info!(\\\"gamepad connected\\\"),\\n                    gilrs::EventType::Disconnected => log::info!(\\\"gamepad disconnected\\\"),\\n460→                    _ => {}\\n                }\\n            }\\n            if let Some((_, gp)) = g.gamepads().next() {\\n                const ALL: [Button; 15] = [\\n                    Button::South,\\n                    Button::East,\\n                    Button::North,\\n                    Button::West,\\n                    Button::LeftTrigger,\\n470→                    Button::RightTrigger,\\n                    Button::Select,\\n                    Button::Start,\\n                    Button::DPadUp,\\n                    Button::DPadDown,\\n                    Button::DPadLeft,\\n                    Button::DPadRight,\\n                    Button::LeftThumb,\\n                    Button::RightThumb,\\n                    Button::Mode,\\n480→                ];\\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\\n                state = Some(PadState {\\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\\n                    lt2: trig(Button::LeftTrigger2),\\n                    rt2: trig(Button::RightTrigger2),\\n                });\\n            }\\n490→        }\\n        if let Some(script) = &mut self.pad_script {\\n            if let Some((st, first)) = script.next() {\\n                if first {\\n                    taps.extend(st.tap.iter().copied());\\n                }\\n                activity = true;\\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\\n            }\\n        }\\n500→        let start = taps.contains(&Button::Start);\\n        let map = taps.contains(&Button::DPadLeft);\\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\\n        if let Some(st) = state {\\n            let is = |b: Button| st.held.contains(&b);\\n            pad.left = deadzone(st.left, 0.18);\\n            pad.right = deadzone(st.right, 0.25);\\n            let mut held = 0;\\n            let layout: &[(Button, u32)] = if self.game {\\n                &[\\n510→                    (Button::West, buttons::PRIMARY),\\n                    (Button::North, buttons::SECONDARY),\\n                    (Button::East, buttons::SKILL3),\\n                    (Button::RightTrigger, buttons::SKILL4),\\n                    (Button::LeftTrigger, buttons::SKILL5),\\n                    (Button::South, buttons::DODGE),\\n                    (Button::DPadUp, buttons::POTION),\\n                    (Button::DPadRight, buttons::INTERACT),\\n                ]\\n            } else {\",\"content_concise\":\"400→            pad_script: None,\\n            pad: Pad::default(),\\n            last_device: Device::KeyboardMouse,\\n            prev_held: 0,\\n            key_taps: HashSet::new(),\\n            mouse_taps: HashSet::new(),\\n            bindings: Bindings::default(),\\n            game: false,\\n        }\\n    }\\n410→\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        match state {\\n            ElementState::Pressed => {\\n                self.keys.insert(code);\\n                self.key_taps.insert(code);\\n            }\\n            ElementState::Released => {\\n                self.keys.remove(&code);\\n420→            }\\n        }\\n    }\\n\\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.mouse_active = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.mouse.insert(b);\\n430→                self.mouse_taps.insert(b);\\n            }\\n            ElementState::Released => {\\n                self.mouse.remove(&b);\\n            }\\n        }\\n    }\\n\\n    pub fn clear(&mut self) {\\n        self.keys.clear();\\n440→        self.mouse.clear();\\n    }\\n\\n    /// Reads gamepad events and state (first connected pad).\\n    pub fn poll_gamepad(&mut self) {\\n        use gilrs::{Axis, Button};\\n        let mut activity = false;\\n        let mut taps = Vec::new();\\n        // One pad state from the first connected pad, or from the pad script while it runs.\\n        let mut state: Option<PadState> = None;\\n450→        if let Some(g) = &mut self.gilrs {\\n            while let Some(ev) = g.next_event() {\\n                match ev.event {\\n                    gilrs::EventType::ButtonPressed(b, _) => {\\n                        taps.push(b);\\n                        activity = true;\\n                    }\\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\\n                    gilrs::EventType::Connected => log::info!(\\\"gamepad connected\\\"),\\n                    gilrs::EventType::Disconnected => log::info!(\\\"gamepad disconnected\\\"),\\n460→                    _ => {}\\n                }\\n            }\\n            if let Some((_, gp)) = g.gamepads().next() {\\n                const ALL: [Button; 15] = [\\n                    Button::South,\\n                    Button::East,\\n                    Button::North,\\n                    Button::West,\\n                    Button::LeftTrigger,\\n470→                    Button::RightTrigger,\\n                    Button::Select,\\n                    Button::Start,\\n                    Button::DPadUp,\\n                    Button::DPadDown,\\n                    Button::DPadLeft,\\n                    Button::DPadRight,\\n                    Button::LeftThumb,\\n                    Button::RightThumb,\\n                    Button::Mode,\\n480→                ];\\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\\n                state = Some(PadState {\\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\\n                    lt2: trig(Button::LeftTrigger2),\\n                    rt2: trig(Button::RightTrigger2),\\n                });\\n            }\\n490→        }\\n        if let Some(script) = &mut self.pad_script {\\n            if let Some((st, first)) = script.next() {\\n                if first {\\n                    taps.extend(st.tap.iter().copied());\\n                }\\n                activity = true;\\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\\n            }\\n        }\\n500→        let start = taps.contains(&Button::Start);\\n        let map = taps.contains(&Button::DPadLeft);\\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\\n        if let Some(st) = state {\\n            let is = |b: Button| st.held.contains(&b);\\n            pad.left = deadzone(st.left, 0.18);\\n            pad.right = deadzone(st.right, 0.25);\\n            let mut held = 0;\\n            let layout: &[(Button, u32)] = if self.game {\\n                &[\\n510→                    (Button::West, buttons::PRIMARY),\\n                    (Button::North, buttons::SECONDARY),\\n                    (Button::East, buttons::SKILL3),\\n                    (Button::RightTrigger, buttons::SKILL4),\\n                    (Button::LeftTrigger, buttons::SKILL5),\\n                    (Button::South, buttons::DODGE),\\n                    (Button::DPadUp, buttons::POTION),\\n                    (Button::DPadRight, buttons::INTERACT),\\n                ]\\n            } else {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_app/src/input.rs\",\"offset\":400,\"limit\":120,\"raw_output\":\"            pad_script: None,\\n            pad: Pad::default(),\\n            last_device: Device::KeyboardMouse,\\n            prev_held: 0,\\n            key_taps: HashSet::new(),\\n            mouse_taps: HashSet::new(),\\n            bindings: Bindings::default(),\\n            game: false,\\n        }\\n    }\\n\\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        match state {\\n            ElementState::Pressed => {\\n                self.keys.insert(code);\\n                self.key_taps.insert(code);\\n            }\\n            ElementState::Released => {\\n                self.keys.remove(&code);\\n            }\\n        }\\n    }\\n\\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\\n        self.last_device = Device::KeyboardMouse;\\n        self.mouse_active = true;\\n        match state {\\n            ElementState::Pressed => {\\n                self.mouse.insert(b);\\n                self.mouse_taps.insert(b);\\n            }\\n            ElementState::Released => {\\n                self.mouse.remove(&b);\\n            }\\n        }\\n    }\\n\\n    pub fn clear(&mut self) {\\n        self.keys.clear();\\n        self.mouse.clear();\\n    }\\n\\n    /// Reads gamepad events and state (first connected pad).\\n    pub fn poll_gamepad(&mut self) {\\n        use gilrs::{Axis, Button};\\n        let mut activity = false;\\n        let mut taps = Vec::new();\\n        // One pad state from the first connected pad, or from the pad script while it runs.\\n        let mut state: Option<PadState> = None;\\n        if let Some(g) = &mut self.gilrs {\\n            while let Some(ev) = g.next_event() {\\n                match ev.event {\\n                    gilrs::EventType::ButtonPressed(b, _) => {\\n                        taps.push(b);\\n                        activity = true;\\n                    }\\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\\n                    gilrs::EventType::Connected => log::info!(\\\"gamepad connected\\\"),\\n                    gilrs::EventType::Disconnected => log::info!(\\\"gamepad disconnected\\\"),\\n                    _ => {}\\n                }\\n            }\\n            if let Some((_, gp)) = g.gamepads().next() {\\n                const ALL: [Button; 15] = [\\n                    Button::South,\\n                    Button::East,\\n                    Button::North,\\n                    Button::West,\\n                    Button::LeftTrigger,\\n                    Button::RightTrigger,\\n                    Button::Select,\\n                    Button::Start,\\n                    Button::DPadUp,\\n                    Button::DPadDown,\\n                    Button::DPadLeft,\\n                    Button::DPadRight,\\n                    Button::LeftThumb,\\n                    Button::RightThumb,\\n                    Button::Mode,\\n                ];\\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\\n                state = Some(PadState {\\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\\n                    lt2: trig(Button::LeftTrigger2),\\n                    rt2: trig(Button::RightTrigger2),\\n                });\\n            }\\n        }\\n        if let Some(script) = &mut self.pad_script {\\n            if let Some((st, first)) = script.next() {\\n                if first {\\n                    taps.extend(st.tap.iter().copied());\\n                }\\n                activity = true;\\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\\n            }\\n        }\\n        let start = taps.contains(&Button::Start);\\n        let map = taps.contains(&Button::DPadLeft);\\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\\n        if let Some(st) = state {\\n            let is = |b: Button| st.held.contains(&b);\\n            pad.left = deadzone(st.left, 0.18);\\n            pad.right = deadzone(st.right, 0.25);\\n            let mut held = 0;\\n            let layout: &[(Button, u32)] = if self.game {\\n                &[\\n                    (Button::West, buttons::PRIMARY),\\n                    (Button::North, buttons::SECONDARY),\\n                    (Button::East, buttons::SKILL3),\\n                    (Button::RightTrigger, buttons::SKILL4),\\n                    (Button::LeftTrigger, buttons::SKILL5),\\n                    (Button::South, buttons::DODGE),\\n                    (Button::DPadUp, buttons::POTION),\\n                    (Button::DPadRight, buttons::INTERACT),\\n                ]\\n            } else {\\n\",\"total_lines\":631}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3c7d77d8-8b81-496b-9511-372681ec7c55-65","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"740→[part.shoulders]  # chaikin 2, V neck\\nz = 1\\npoints = [[-1.72,-2.4],[-1.66,-1.36],[-1.2,-1.02],[-.52,-.82],[-.3,-.72],[0,-1.34],[.3,-.72],[.52,-.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.4]]\\n[mouth]  # talking frame vs closed\\nopen   = [[-.15,-.255],[0,-.2],[.15,-.255],[.08,-.36],[-.08,-.36]]\\nclosed = [[-.16,-.26],[0,-.235],[.16,-.26],[0,-.285]]\\n```\\nStage: eye (0, 0, 14), looking −Z, fov 26°; ambient sky (.74,.74,.78), ground (.6,.56,.56); sun direction (.3,-.45,-.85) × .34; cel_bands 3, rim .05; outline_darken .32, outline_px 1.4; gi .4; vignette .32; characters at x ≈ ±3.1, y ≈ −0.7. Colour samples, sRGB: Mara skin (242,200,172), shade (214,158,136), hair (46,36,60), scrubs (46,150,146). Pet skin (122,80,58), shade (92,58,44), silver hair (226,226,232), scrubs (98,70,136). Bashir skin (190,142,104), scrubs (60,104,164). Make the cheek shade subtler than a hard wedge: that was the one weak part of the test.\\n\\n## Appendix B: a hub shim skeleton ✔ (the protocol calls are tested)\\n750→\\n```js\\n// engine/web/hub_shim.js, inlined right after the session client\\n(function () {\\n  const H = window.__hub = { active: !!(window.AIHub && AIHub.active), info: null, events: [], last: null };\\n  if (!H.active) return;\\n  AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then((info) => {\\n    H.info = info;\\n    if (!info) { H.active = false; return; }      // no hub after all: run as on its own\\n    for (const ev of ['card', 'start', 'leave', 'end']) AIHub.on(ev, (d) => H.events.push([ev, d]));\\n760→    AIHub.on('message', (d, from) => H.events.push(['message', d, from]));\\n    AIHub.on('time-up', () => {                   // answer now: frames may be slow\\n      H.events.push(['time-up']);\\n      if (AIHub.isHost) AIHub.finish(H.last || { standings: [AIHub.players.map((p) => p.id)], won: false });\\n    });\\n  });\\n  addEventListener('keydown', (e) => { if (e.key === 'Enter') AIHub.answer('ready'); }, true);\\n  H.poll = () => { const a = H.events; H.events = []; return JSON.stringify(a); };   // Rust, every frame\\n  H.ready = () => AIHub.ready();                                                     // Rust, after first frame\\n  H.answer = (what) => AIHub.answer(what);                                           // the card: 'ready' or 'more'\\n770→  H.time = () => AIHub.time();\\n  H.finish = (json) => AIHub.finish(JSON.parse(json));                               // host, at the round's end\\n  H.send = (json, to) => AIHub.send(JSON.parse(json), { reliable: false, to });\\n  H.publish = (json) => { H.last = JSON.parse(json); };                              // Rust, about once a second\\n})();\\n```\\nThe harness pokes `Enter` with a synthetic `KeyboardEvent` inside each frame, so listen in JS, not only through winit.\\n\\n## Appendix C: the fragment for the page ✔\\n\\n780→In `pack_single_html.py`, after loading the page:\\n```python\\npage, n = re.subn(r'<meta charset=\\\"utf-8\\\">\\\\n',\\n    lambda m: m.group(0) + '<script>\\\\n' + client + '\\\\n</script>\\\\n' + tags + '<script>\\\\n' + shim + '\\\\n</script>\\\\n', page, count=1)\\n```\\n`client` is `session.js`, byte for byte (its `/*! aihub-session` banner lets the hub replace it). The packer already refuses JS glue holding `<script`, `</script` or `<!--`; apply the same check to the client and the shim. ✔ `session.js` holds none.\\n\\n## Appendix D: browser stand-ins ✔\\n\\n```python\\n790→PAD = \\\"\\\"\\\"\\n(() => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\\n  const pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true,\\n               mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons};\\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null]; })();\\n\\\"\\\"\\\"\\npage.add_init_script(PAD)                       # then: page.evaluate(\\\"__pad.axes[0]=1; __pad.timestamp++\\\")\\n```\\nStandard mapping: 0 Cross, 1 Circle, 2 Square, 3 Triangle, 4 L1, 5 R1, 6 L2, 7 R2, 8 Create, 9 Options, 10 L3, 11 R3, 12–15 D-pad, 16 PS; axes 0–1 left stick, 2–3 right. Set `value` as well as `pressed` for triggers. Add a second pad at index 1 for co-op.\\n\\n800→```python\\nTAP = \\\"\\\"\\\"\\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\\n    return r; };\\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\\n\\\"\\\"\\\"\\n810→```\\n✔ This read a peak of 0.65 from the engine's cpal output during play.\\n\",\"content_concise\":\"740→[part.shoulders]  # chaikin 2, V neck\\nz = 1\\npoints = [[-1.72,-2.4],[-1.66,-1.36],[-1.2,-1.02],[-.52,-.82],[-.3,-.72],[0,-1.34],[.3,-.72],[.52,-.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.4]]\\n[mouth]  # talking frame vs closed\\nopen   = [[-.15,-.255],[0,-.2],[.15,-.255],[.08,-.36],[-.08,-.36]]\\nclosed = [[-.16,-.26],[0,-.235],[.16,-.26],[0,-.285]]\\n```\\nStage: eye (0, 0, 14), looking −Z, fov 26°; ambient sky (.74,.74,.78), ground (.6,.56,.56); sun direction (.3,-.45,-.85) × .34; cel_bands 3, rim .05; outline_darken .32, outline_px 1.4; gi .4; vignette .32; characters at x ≈ ±3.1, y ≈ −0.7. Colour samples, sRGB: Mara skin (242,200,172), shade (214,158,136), hair (46,36,60), scrubs (46,150,146). Pet skin (122,80,58), shade (92,58,44), silver hair (226,226,232), scrubs (98,70,136). Bashir skin (190,142,104), scrubs (60,104,164). Make the cheek shade subtler than a hard wedge: that was the one weak part of the test.\\n\\n## Appendix B: a hub shim skeleton ✔ (the protocol calls are tested)\\n750→\\n```js\\n// engine/web/hub_shim.js, inlined right after the session client\\n(function () {\\n  const H = window.__hub = { active: !!(window.AIHub && AIHub.active), info: null, events: [], last: null };\\n  if (!H.active) return;\\n  AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then((info) => {\\n    H.info = info;\\n    if (!info) { H.active = false; return; }      // no hub after all: run as on its own\\n    for (const ev of ['card', 'start', 'leave', 'end']) AIHub.on(ev, (d) => H.events.push([ev, d]));\\n760→    AIHub.on('message', (d, from) => H.events.push(['message', d, from]));\\n    AIHub.on('time-up', () => {                   // answer now: frames may be slow\\n      H.events.push(['time-up']);\\n      if (AIHub.isHost) AIHub.finish(H.last || { standings: [AIHub.players.map((p) => p.id)], won: false });\\n    });\\n  });\\n  addEventListener('keydown', (e) => { if (e.key === 'Enter') AIHub.answer('ready'); }, true);\\n  H.poll = () => { const a = H.events; H.events = []; return JSON.stringify(a); };   // Rust, every frame\\n  H.ready = () => AIHub.ready();                                                     // Rust, after first frame\\n  H.answer = (what) => AIHub.answer(what);                                           // the card: 'ready' or 'more'\\n770→  H.time = () => AIHub.time();\\n  H.finish = (json) => AIHub.finish(JSON.parse(json));                               // host, at the round's end\\n  H.send = (json, to) => AIHub.send(JSON.parse(json), { reliable: false, to });\\n  H.publish = (json) => { H.last = JSON.parse(json); };                              // Rust, about once a second\\n})();\\n```\\nThe harness pokes `Enter` with a synthetic `KeyboardEvent` inside each frame, so listen in JS, not only through winit.\\n\\n## Appendix C: the fragment for the page ✔\\n\\n780→In `pack_single_html.py`, after loading the page:\\n```python\\npage, n = re.subn(r'<meta charset=\\\"utf-8\\\">\\\\n',\\n    lambda m: m.group(0) + '<script>\\\\n' + client + '\\\\n</script>\\\\n' + tags + '<script>\\\\n' + shim + '\\\\n</script>\\\\n', page, count=1)\\n```\\n`client` is `session.js`, byte for byte (its `/*! aihub-session` banner lets the hub replace it). The packer already refuses JS glue holding `<script`, `</script` or `<!--`; apply the same check to the client and the shim. ✔ `session.js` holds none.\\n\\n## Appendix D: browser stand-ins ✔\\n\\n```python\\n790→PAD = \\\"\\\"\\\"\\n(() => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\\n  const pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true,\\n               mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons};\\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null]; })();\\n\\\"\\\"\\\"\\npage.add_init_script(PAD)                       # then: page.evaluate(\\\"__pad.axes[0]=1; __pad.timestamp++\\\")\\n```\\nStandard mapping: 0 Cross, 1 Circle, 2 Square, 3 Triangle, 4 L1, 5 R1, 6 L2, 7 R2, 8 Create, 9 Options, 10 L3, 11 R3, 12–15 D-pad, 16 PS; axes 0–1 left stick, 2–3 right. Set `value` as well as `pressed` for triggers. Add a second pad at index 1 for co-op.\\n\\n800→```python\\nTAP = \\\"\\\"\\\"\\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\\n    return r; };\\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\\n\\\"\\\"\\\"\\n810→```\\n✔ This read a peak of 0.65 from the engine's cpal output during play.\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/PLAN.md\",\"offset\":740,\"limit\":80,\"raw_output\":\"[part.shoulders]  # chaikin 2, V neck\\nz = 1\\npoints = [[-1.72,-2.4],[-1.66,-1.36],[-1.2,-1.02],[-.52,-.82],[-.3,-.72],[0,-1.34],[.3,-.72],[.52,-.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.4]]\\n[mouth]  # talking frame vs closed\\nopen   = [[-.15,-.255],[0,-.2],[.15,-.255],[.08,-.36],[-.08,-.36]]\\nclosed = [[-.16,-.26],[0,-.235],[.16,-.26],[0,-.285]]\\n```\\nStage: eye (0, 0, 14), looking −Z, fov 26°; ambient sky (.74,.74,.78), ground (.6,.56,.56); sun direction (.3,-.45,-.85) × .34; cel_bands 