ontent\":\"        Cmd::ToTitle => SurgeryCmd::ToTitle,\"},{\"line_number\":405,\"content\":\"        Cmd::SetDifficulty(d) => SurgeryCmd::SetDifficulty(d),\"},{\"line_number\":406,\"content\":\"        Cmd::Retry => SurgeryCmd::Retry,\"},{\"line_number\":407,\"content\":\"        Cmd::SetTune { id, value } => SurgeryCmd::SetTune { id, value },\"},{\"line_number\":408,\"content\":\"        Cmd::ResetTune => SurgeryCmd::ResetTune,\"},{\"line_number\":409,\"content\":\"        Cmd::SetBus { which, value } => SurgeryCmd::SetBus { which, value },\"},{\"line_number\":410,\"content\":\"        Cmd::Dev { what, extra } => SurgeryCmd::Dev { what, extra },\"},{\"line_number\":626,\"content\":\"    let focus = curr.focus;\"},{\"line_number\":627,\"content\":\"    let mut scene = app.builder.build(&prev, &curr, 1.0, &app.rig, w as f32 / h.max(1) as f32, &view, focus);\"},{\"line_number\":744,\"content\":\"fn status_json(shell: &Shell, op: Option<&SurgeryFrame>) -> String {\"},{\"line_number\":756,\"content\":\"        \\\"focus\\\": shell.focus(),\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-e44cbf09-bb48-4d64-a65f-1611500b89f8-5","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,49,56,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,10