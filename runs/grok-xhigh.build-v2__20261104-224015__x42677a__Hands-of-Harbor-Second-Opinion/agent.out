ick in -1..1. `tool` 255 means \\\"leave the current tool\\\".\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct SurgeonInput {\\n    pub active: bool,\\n80→    pub aim: Vec2,\\n    pub held: u32,\\n    pub pressed: u32,\\n    pub tool: u8,\\n    pub pressure: f32,\\n}\\n\\npub mod surg {\\n    pub const USE: u32 = 1 << 0;\\n    pub const PRECISION: u32 = 1 << 1;\\n90→    pub const CANCEL: u32 = 1 << 2;\\n    pub const GIFT: u32 = 1 << 3;\\n    pub const CHART: u32 = 1 << 4;\\n    pub const DEFIB: u32 = 1 << 5;\\n    pub const AIM_ABSOLUTE: u32 = 1 << 6;\\n    /// Mouse: put the cursor on `aim` this tick. The stick and the bot slew instead.\\n    pub const SNAP: u32 = 1 << 7;\\n    pub const ROT_L: u32 = 1 << 8;\\n    pub const ROT_R: u32 = 1 << 9;\\n    pub const CONFIRM: u32 = 1 << 10;\\n100→    pub const BACK: u32 = 1 << 11;\\n    pub const NAV_UP: u32 = 1 << 12;\\n    pub const NAV_DOWN: u32 = 1 << 13;\\n}\\n\\n/// Commands from the surgery shell. Copy, so they ride in a recorded `InputFrame`.\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\npub enum SurgeryCmd {\\n    Retry,\\n    Skip,\",\"content_concise\":\"70→    /// A surgery-shell command (load a case, retry, set a slider). Ignored by other games.\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub surgery_cmd: Option<SurgeryCmd>,\\n}\\n\\n/// One surgeon's hands for a tick. `aim` is a world point when `AIM_ABSOLUTE` is set, otherwise\\n/// a stick in -1..1. `tool` 255 means \\\"leave the current tool\\\".\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct SurgeonInput {\\n    pub active: bool,\\n80→    pub aim: Vec2,\\n    pub held: u32,\\n    pub pressed: u32,\\n    pub tool: u8,\\n    pub pressure: f32,\\n}\\n\\npub mod surg {\\n    pub const USE: u32 = 1 << 0;\\n    pub const PRECISION: u32 = 1 << 1;\\n90→    pub const CANCEL: u32 = 1 << 2;\\n    pub const GIFT: u32 = 1 << 3;\\n    pub const CHART: u32 = 1 << 4;\\n    pub const DEFIB: u32 = 1 << 5;\\n    pub const AIM_ABSOLUTE: u32 = 1 << 6;\\n    /// Mouse: put the cursor on `aim` this tick. The stick and the bot slew instead.\\n    pub const SNAP: u32 = 1 << 7;\\n    pub const ROT_L: u32 = 1 << 8;\\n    pub const ROT_R: u32 = 1 << 9;\\n    pub const CONFIRM: u32 = 1 << 10;\\n100→    pub const BACK: u32 = 1 << 11;\\n    pub const NAV_UP: u32 = 1 << 12;\\n    pub const NAV_DOWN: u32 = 1 << 13;\\n}\\n\\n/// Commands from the surgery shell. Copy, so they ride in a recorded `InputFrame`.\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\npub enum SurgeryCmd {\\n    Retry,\\n    Skip,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/input.rs\",\"offset\":70,\"limit\":40,\"raw_output\":\"    /// A surgery-shell command (load a case, retry, set a slider). Ignored by other games.\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub surgery_cmd: Option<SurgeryCmd>,\\n}\\n\\n/// One surgeon's hands for a tick. `aim` is a world point when `AIM_ABSOLUTE` is set, otherwise\\n/// a stick in -1..1. `tool` 255 means \\\"leave the current tool\\\".\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\\npub struct SurgeonInput {\\n    pub active: bool,\\n    pub aim: Vec2,\\n    pub held: u32,\\n    pub pressed: u32,\\n    pub tool: u8,\\n    pub pressure: f32,\\n}\\n\\npub mod surg {\\n    pub const USE: u32 = 1 << 0;\\n    pub const PRECISION: u32 = 1 << 1;\\n    pub const CANCEL: u32 = 1 << 2;\\n    pub const GIFT: u32 = 1 << 3;\\n    pub const CHART: u32 = 1 << 4;\\n    pub const DEFIB: u32 = 1 << 5;\\n    pub const AIM_ABSOLUTE: u32 = 1 << 6;\\n    /// Mouse: put the cursor on `aim` this tick. The stick and the bot slew instead.\\n    pub const SNAP: u32 = 1 <<