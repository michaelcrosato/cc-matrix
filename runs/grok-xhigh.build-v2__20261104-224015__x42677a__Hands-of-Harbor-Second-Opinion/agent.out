dges drawing the ticket.\\n    pub live_edit_ticket: u64,\\n    pub objects: Vec<RenderObject>,\\n    pub statics: StaticWorld,\\n    /// Suggested camera focus (the player, or the scene centre).\\n    pub focus: Vec3,\\n    /// True when `focus` is a player character (enables cutaway/fade helpers).\\n    pub focus_is_player: bool,\\n    pub player: Option<EntityId>,\\n    pub puppet_def: PuppetDef,\\n    pub room: Option<RoomInfo>,\\n    /// The simulation's configuration (shared; changes when rooms override parameters).\\n    pub config: std::sync::Arc<crate::sim::SimConfig>,\\n    pub events: Vec<SimEvent>,\\n    pub projectiles: Vec<ProjectileView>,\\n    pub hud: HudFrame,\\n    /// Shardfall state for the view and HUD (None outside the game).\\n    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\\n    /// Agent-readable playback controls for the animation stage.\\n    pub animation_preview: Option<crate::animation_preview::PreviewInfo>,\\n    pub studio_mode: crate::prop_preview::StudioMode,\\n    pub prop_preview: Option<crate::prop_preview::PropPreviewInfo>,\\n    pub creature_preview: Option<crate::creature_preview::CreaturePreviewInfo>,\\n    /// The generated native stage subject, separate from simulation entity geometry.\\n    pub creature: Option<crate::creature_preview::CreatureFrame>,\\n}\\n\",\"total_lines\":302}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8f2a26e1-d780-4f34-81ce-21072e9a6ef9-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"90→                    let local = Vec3::new(l.at[0] as f32 + c as f32 + 0.5, l.y, l.at[1] as f32 + r as f32 + 0.5);\\n                    out.push(place.point(local));\\n                }\\n            }\\n        }\\n    }\\n    out\\n}\\n\\n/// Every cell of the current room's layout whose legend says `marker = \\\"<name>\\\"`, in map\\n100→/// order (row by row), as world positions on the floor. Games place their pieces this way.\\npub fn markers(sim: &Sim, name: &str) -> Vec<Vec3> {\\n    let w = &sim.state.world;\\n    match w.current_room.and_then(|i| w.rooms.get(i as usize)) {\\n        Some(slot) => all_markers(&slot.def, &slot.place, name),\\n        None => Vec::new(),\\n    }\\n}\\n\\npub fn build(sim: &mut Sim, name: &str) -> Result<()> {\\n110→    let (base, start_room) = match name.split_once('/') {\\n        Some((b, r)) => (b, Some(r)),\\n        None => (name, None),\\n    };\\n    if let Some(game) = crate::games::find(base) {\\n        return (game.build)(sim, start_room);\\n    }\\n    match base {\\n        \\\"world\\\" => {\\n            let sources = room::load_sources(room::rooms_dir().as_deref());\\n120→            let (defs, errors) = room::parse_all(&sources);\\n            for (k, e) in &errors {\\n                log::error!(\\\"room file '{k}': {e}\\\");\\n            }\\n            sim.build_world(defs, errors);\\n            if let Some(r) = start_room {\\n                if !sim.teleport_to_room(r) {\\n                    bail!(\\n                        \\\"unknown room '{r}' (known: {})\\\",\\n                        sim.state.world.rooms.iter().map(|r| r.key.as_str()).collect::<Vec<_>>().join(\\\", \\\")\\n130→                    );\\n                }\\n            }\\n        }\\n        \\\"test\\\" => test_scene(sim),\\n        \\\"arena\\\" => crate::arpg::scene::build_arena(sim),\\n        \\\"town\\\" => crate::arpg::scene::build_town(sim, None),\\n        \\\"lab\\\" => crate::arpg::scene::build_lab(sim, None),\\n        \\\"level\\\" => {\\n            let n: u32 = match start_room {\\n140→                Some(r) => r.parse().map_err(|_| anyhow!(\\\"level/<n>: '{r}' is not a depth\\\"))?,\\n                None => 1,\\n            };\\n            crate::arpg::world::build_level(sim, n.max(1), None);\\n        }\\n        \\\"empty\\\" => {\\n            floor(sim, 20);\\n            sim.state.spawn = Vec3::new(0.5, 0.0, 0.5);\\n            sim.spawn_player();\\n        }\\n150→  