6,32,61,32,109,117,115,105,99,58,58,114,101,110,100,101,114,95,116,114,97,99,107,40,110,97,109,101,44,32,49,46,50,44,32,57,48,46,48,41,59,10,56,49,56,58,32,32,32,32,32,32,32,32,108,101,116,32,118,111,105,99,101,32,61,32,118,111,105,99,101,58,58,114,101,110,100,101,114,95,108,105,110,101,40,34,77,97,114,97,32,81,117,105,108,108,34,44,32,34,72,111,108,100,32,116,104,101,32,108,105,110,101,46,34,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":8,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_audio/src/lib.rs\",\"matches\":[{\"line_number\":151,\"content\":\"pub const BUS_MUSIC: u8 = 0;\"},{\"line_number\":153,\"content\":\"pub const BUS_VOICES: u8 = 2;\"},{\"line_number\":179,\"content\":\"            BUS_MUSIC => self.music,\"},{\"line_number\":180,\"content\":\"            BUS_VOICES => self.voices_gain,\"},{\"line_number\":521,\"content\":\"fn cue_patch(id: u16, gain: f32, pitch: f32) -> Vec<(Patch, f32)> {\"},{\"line_number\":813,\"content\":\"        for name in music::TRACKS {\"},{\"line_number\":814,\"content\":\"            let out = music::render_track(name, 1.2, 90.0);\"},{\"line_number\":818,\"content\":\"        let voice = voice::render_line(\\\"Mara Quill\\\", \\\"Hold the line.\\\");\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"24e05d43-4b10-4bce-b52f-230b8c12d73f"}
