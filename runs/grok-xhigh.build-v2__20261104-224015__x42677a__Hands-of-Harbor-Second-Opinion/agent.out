d_ref());\\n    step.forget();\\n    let _ = js_sys::Reflect::set(&win, &\\\"__game\\\".into(), &obj);\\n    HOOKED.with(|h| h.set(true));\\n    let _ = app;\\n}\\n\\npub fn surgery_event(app: &mut App, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\\n    let consumed = match (&mut app.egui_state, &app.gfx) {\\n        (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\\n860→        _ => false,\\n    };\\n    let _ = consumed;\\n    match event {\\n        WindowEvent::CloseRequested => el.exit(),\\n        WindowEvent::Resized(sz) => {\\n            if let Some(g) = &mut app.gfx {\\n                g.resize(sz.width, sz.height);\\n            }\\n        }\\n870→        WindowEvent::RedrawRequested => {\\n            surgery_frame(app);\\n            if app.quit {\\n                el.exit();\\n            }\\n        }\\n        WindowEvent::KeyboardInput { event, .. } => {\\n            #[cfg(target_arch = \\\"wasm32\\\")]\\n            app.resume_audio();\\n            if let PhysicalKey::Code(code) = event.physical_key {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_app/src/product.rs\",\"offset\":790,\"limit\":90,\"raw_output\":\"    let cursors: Vec<serde_json::Value> = op\\n        .map(|o| {\\n            o.cursors\\n                .iter()\\n                .map(|c| serde_json::json!({ \\\"x\\\": c.x, \\\"z\\\": c.z, \\\"tool\\\": c.tool, \\\"active\\\": c.active }))\\n                .collect()\\n        })\\n        .unwrap_or_default();\\n    serde_json::json!({\\n        \\\"screen\\\": shell.screen_name(),\\n        \\\"focus\\\": shell.focus(),\\n        \\\"device\\\": if shell.device == DeviceKind::Gamepad { \\\"gamepad\\\" } else { \\\"keyboard\\\" },\\n        \\\"xbox\\\": shell.xbox,\\n        \\\"music\\\": format!(\\\"{music:.2}\\\"),\\n        \\\"title