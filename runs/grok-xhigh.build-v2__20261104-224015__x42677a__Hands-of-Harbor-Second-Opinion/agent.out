0,\\n            stages: 1,\\n            axis: 0.0,\\n            aux: 0.0,\\n            aux2: 0.0,\\n            samples: 0,\\n            samples_need: 1,\\n            quality: 0.0,\\n            grabbed: false,\\n            grab_x: 0.0,\\n            grab_z: 0.0,\\n            bits: 0,\\n            priority: 0,\\n            tag: 0,\\n            idle: 0.0,\\n        }\\n    }\\n\\n    pub fn make(kind: u8, x: f32, z: f32) -> Self {\\n        let mut h = Self::blank();\\n        h.kind = kind;\\n        h.x = x;\\n        h.z = z;\\n        h.stages = stages_for(kind);\\n        h.tool = tool_for_kind(kind, 0);\\n        match kind {\\n            K_INCISION => {\\n                h.need = 2.4;\\n                h.radius = 0.55;\\n                h.drain = 0.0;\\n                h.axis = 0.0;\\n            }\\n            K_LACERATION => {\\n                h.need = 1.8;\\n                h.radius = 0.7;\\n                h.drain = 0.7;\\n                h.samples_need = 4;\\n                h.axis = 0.4;\\n            }\\n            K_POOL => {\\n                h.need = 0.7;\\n                h.radius = 0.75;\\n                h.drain = 0.45;\\n            }\\n            K_BLEEDER => {\\n                h.need = 0.9;\\n                h.radius = 0.6;\\n                h.drain = 2.4;\\n                h.samples_need = 3;\\n            }\\n            K_FOREIGN => {\\n                h.need = 0.85;\\n                h.radius = 0.55;\\n                h.drain = 0.45;\\n                h.axis = 0.6;\\n            }\\n            K_POLYP => {\\n                h.need = 1.15;\\n                h.radius = 0.5;\\n                h.drain = 0.25;\\n            }\\n            K_TUMOR => {\\n                h.need = 6.2832;\\n                h.radius = 0.85;\\n                h.drain = 0.55;\\n            }\\n            K_INFLAM | K_BURN => {\\n                h.need = 0.7;\\n                h.radius = 0.8;\\n                h.drain = 0.35;\\n                h.sam