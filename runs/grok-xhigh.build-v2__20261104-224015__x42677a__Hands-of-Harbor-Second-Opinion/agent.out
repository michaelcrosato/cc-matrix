t\":\"    if skill < 0.2 {\"},{\"line_number\":50,\"content\":\"    // A skill of 0 still knew where the wound was, so the easy cases lived.\"},{\"line_number\":52,\"content\":\"    if skill < 0.15 {\"},{\"line_number\":60,\"content\":\"    if me.focus == Some(h.id) && me.focus_t > 2.2 && skill > 0.3 {\"},{\"line_number\":65,\"content\":\"    aim_toward(game, me, slot, skill, tick, tx, tz, &mut inp);\"},{\"line_number\":70,\"content\":\"    let release_at = release_at(skill, h.kind);\"},{\"line_number\":101,\"content\":\"fn want_gift(game: &Surgery, skill: f32) -> bool {\"},{\"line_number\":102,\"content\":\"    if skill < 0.55 || game.heart.flat || game.surgeons[0].meter < 100.0 {\"},{\"line_number\":108,\"content\":\"fn defib(game: &Surgery, me: &Surgeon, skill: f32, mut inp: SurgeonInput) -> SurgeonInput {\"},{\"line_number\":111,\"content\":\"    let hold = if skill < 0.35 {\"},{\"line_number\":162,\"content\":\"fn release_at(skill: f32, kind: u8) -> f32 {\"},{\"line_number\":164,\"content\":\"        if skill < 0.2 { 1.25 } else { 0.90 }\"},{\"line_number\":166,\"content\":\"        0.90 + (1.0 - skill) * 0.28\"},{\"line_number\":183,\"content\":\"fn aim_toward(game: &Surgery, me: &Surgeon, slot: usize, skill: f32, tick: u64, mut tx: f32, mut tz: f32, inp: &mut SurgeonInput) {\"},{\"line_number\":184,\"content\":\"    let amp = (1.0 - skill) * (1.0 - skill) * 2.2;\"},{\"line_number\":190,\"content\":\"    let step = (3.0 + 12.0 * skill) * DT;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/src/games/surgery/ops.rs\",\"matches\":[{\"line_number\":67,\"content\":\"        slots[0] = bot::decide(g, sim.state.tick, 0);\"},{\"line_number\":71,\"content\":\"        slots[1] = bot::decide(g, sim.state.tick, 1);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/src/games/surgery/frame.rs\",\"matches\":[{\"line_numbe