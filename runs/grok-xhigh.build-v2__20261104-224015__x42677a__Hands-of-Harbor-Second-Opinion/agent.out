turn 1;\\n    }\\n    let p = score as f32 / par as f32;\\n    if p >= 1.15 {\\n        5\\n    } else if p >= 1.0 {\\n100→        4\\n    } else if p >= 0.85 {\\n        3\\n    } else if p >= 0.70 {\\n        2\\n    } else if p >= 0.50 {\\n        1\\n    } else {\\n        0\\n    }\\n110→}\\n\\npub fn rank_name(r: u8) -> &'static str {\\n    match r {\\n        1 => \\\"C\\\",\\n        2 => \\\"B\\\",\\n        3 => \\\"A\\\",\\n        4 => \\\"S\\\",\\n        5 => \\\"ENCORE\\\",\\n        _ => \\\"\\\",\\n120→    }\\n}\\n\\npub const STRAIN_PHASES: [&str; 18] = [\\n    \\\"introit:wander\\\",\\n    \\\"introit:split\\\",\\n    \\\"introit:smalls\\\",\\n    \\\"introit:amen\\\",\\n    \\\"lacrimosa:wave1\\\",\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/kinds.rs\",\"offset\":79,\"limit\":50,\"raw_output\":\"pub fn chain_mul(chain: u32) -> f32 {\\n    if chain >= 20 {\\n        2.0\\n    } else if chain >= 10 {\\n        1.5\\n    } else if chain >= 5 {\\n        1.25\\n    } else {\\n        1.0\\n    }\\n}\\n\\n/// Ranks at 50 / 70 / 85 / 100 / 115 percent of par. 0 is below C.\\npub fn rank_of(score: i32, par: i32) -> u8 {\\n    if par <= 0 {\\n        return 1;\\n    }\\n    let p = score as f32 / par as f32;\\n    if p >= 1.15 {\\n        5\\n    } else if p >= 1.0 {\\n        4\\n    } else if p >= 0.85 {\\n        3\\n    } else if p >= 0.70 {\\n        2\\n    } else if p >= 0.50 {\\n        1\\n    } else {\\n        0\\n    }\\n}\\n\\npub fn rank_name(r: u8) -> &'static str {\\n    match r {\\n        1 => \\\"C\\\",\\n        2 => \\\"B\\\",\\n        3 => \\\"A\\\",\\n        4 => \\\"S\\\",\\n        5 => \\\"ENCORE\\\",\\n        _ => \\\"\\\",\\n    }\\n}\\n\\npub const STRAIN_PHASES: [&str; 18] = [\\n    \\\"introit:wander\\\",\\n    \\\"introit:split\\