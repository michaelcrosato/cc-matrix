\":67,\"content\":\"import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\"},{\"line_number\":126,\"content\":\"  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\"},{\"line_number\":169,\"content\":\"  const mode = modeOf(metas?.mode);\"},{\"line_number\":421,\"content\":\"    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\"},{\"line_number\":433,\"content\":\"    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\"},{\"line_number\":470,\"content\":\"    const own = SELF_REPORTED.includes(mode);\"},{\"line_number\":471,\"content\":\"    const legacyRace = own && !seedsRandom(m?.mode);\"},{\"line_number\":505,\"content\":\"    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"007b0f30-dfb8-4881-b4c5-002cd62955d5"}
