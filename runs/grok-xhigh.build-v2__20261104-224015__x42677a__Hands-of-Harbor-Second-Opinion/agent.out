5,58,32,32,102,117,110,99,116,105,111,110,32,111,117,116,99,111,109,101,79,102,40,111,117,116,99,111,109,101,41,32,123,10,52,50,51,58,32,32,104,117,98,46,114,101,115,117,108,116,32,61,32,102,117,110,99,116,105,111,110,32,40,111,117,116,99,111,109,101,41,32,123,10,52,51,57,58,32,32,104,117,98,46,102,105,110,105,115,104,32,61,32,102,117,110,99,116,105,111,110,32,40,111,117,116,99,111,109,101,41,32,123,10,52,52,57,58,32,32,102,117,110,99,116,105,111,110,32,115,101,110,100,80,114,111,103,114,101,115,115,40,41,32,123,10,52,53,56,58,32,32,104,117,98,46,112,114,111,103,114,101,115,115,32,61,32,102,117,110,99,116,105,111,110,32,40,112,41,32,123,10,52,54,56,58,32,32,104,117,98,46,112,114,111,98,101,32,61,32,102,117,110,99,116,105,111,110,32,40,102,110,41,32,123,10,52,55,50,58,32,32,104,117,98,46,105,110,115,112,101,99,116,32,61,32,102,117,110,99,116,105,111,110,32,40,41,32,123,10,52,56,50,58,32,32,104,117,98,46,102,97,105,108,32,61,32,102,117,110,99,116,105,111,110,32,40,109,101,115,115,97,103,101,41,32,123,10,52,56,55,58,32,32,114,111,111,116,46,65,73,72,117,98,32,61,32,104,117,98,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":54,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/web/session.js\",\"matches\":[{\"line_number\":2,\"content\":\"(function (root) {\"},{\"line_number\":4,\"content\":\"  if (root.AIHub) return;\"},{\"line_number\":43,\"content\":\"  function memoryStorage() {\"},{\"line_number\":46,\"content\":\"      getItem: function (k) {\"},{\"line_number\":50,\"content\":\"      setItem: function (k, v) {\"},{\"line_number\":53,\"content\":\"      removeItem: function (k) {\"},{\"line_number\":56,\"content\":\"      clear: function () {\"},{\"line_number\":59,\"content\":\"      key: function (i) {\"},{\"line_number\":66,\"content\":\"      get: function (t, k) {\"},{\"line_number\":71,\"content\":\"      set: function (t, k, v) {\"},{\"line_number\":75,\"content\":\"      has: function (t, k) {\"},{\"line_number\":78,\"content\":\"      deleteProperty: function (t, k) {\"},{\"line_number\":82,\"content\":\"      ownKeys: function () {\"},{\"line_number\":85,\"content\":\"      getOwnPropertyDescriptor: function (t, k) {\"},{\"line_number\":92,\"content\":\"  function generator(a) {\"},{\"line_number\":93,\"content\":\"    return function () {\"},{\"line_number\":130,\"content\":\"    var asks = function (on) {\"},{\"line_number\":131,\"content\":\"      return function () {\"},{\"line_number\":136,\"content\":\"    var proto = root.Element.prototype;\"},{\"line_number\":139,\"content\":\"    var shown = function () {\"},{\"line_number\":153,\"content\":\"  function standAlone() {\"},{\"line_number\":175,\"content\":\"  function now() {\"},{\"line_number\":179,\"content\":\"  function warn(text) {\"},{\"line_number\":180,\"content\":\"    if (root.console) root.console.warn('[AIHub] ' + text);\"},{\"line_number\":183,\"content\":\"  function own(o, k) {\"},{\"line_number\":184,\"content\":\"    return Object.prototype.hasOwnProperty.call(o, k);\"},{\"line_number\":191,\"content\":\"  function json(value) {\"},{\"line_number\":200,\"content\":\"  function post(type, fields) {\"},{\"line_number\":210,\"content\":\"  function emit(type, args) {\"},{\"line_number\":220,\"content\":\"        setTimeout(function () {\"},{\"line_number\":227,\"content\":\"  function onMessage(event) {\"},{\"line_number\":265,\"content\":\"      hub.players = hub.players.filter(function (p) {\"},{\"line_number\":283,\"content\":\"  function info() {\"},{\"line_number\":291,\"content\":\"  hub.connect = function (opts) {\"},{\"line_number\":294,\"content\":\"    var promise = new Promise(function (resolve) {\"},{\"line_number\":305,\"content\":\"    var hello = function () {\"},{\"line_number\":321,\"content\":\"  hub.ready = function () {\"},{\"line_number\":328,\"content\":\"  hub.answer = function (what) {\"},{\"line_number\":334,\"content\":\"  hub.on = function (type, fn) {\"},{\"line_number\":338,\"content\":\"      setTimeout(function () {\"},{\"line_number\":344,\"content\":\"    return function () {\"},{\"line_number\":352,\"content\":\"  hub.send = function (data, opts) {\"},{\"line_number\":382,\"content\":\"  hub.time = function () {\"},{\"line_number\":387,\"content\":\"  hub.rng = function (label) {\"},{\"line_number\":398,\"content\":\"  function finite(v) {\"},{\"line_number\":407,\"content\":\"  function outcomeOf(outcome) {\"},{\"line_number\":423,\"content\":\"  hub.result = function (outcome) {\"},{\"line_number\":439,\"content\":\"  hub.finish = function (outcome) {\"},{\"line_number\":449,\"content\":\"  function sendProgress() {\"},{\"line_number\":458,\"content\":\"  hub.progress = function (p) {\"},{\"line_number\":468,\"content\":\"  hub.probe = function (fn) {\"},{\"line_number\":472,\"content\":\"  hub.inspect = function () {\"},{\"line_number\":482,\"content\":\"  hub.fail = function (message) {\"},{\"line_number\":487,\"content\":\"  root.AIHub = hub;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"b9d24df7-2bb0-4666-b6e1-416a05a33104"}
{"type":"assistant","message":{"id":"msg_397","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I need to understand the harness checks thoroughly so the game passes them.","signature":""},{"type":"tool_use","id":"call-14deea75-7a34-4224-93c3-1e87d5bd15a6-28","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/tmp/grok-goal-907ccca5ce3b/implementer/harness.html","offset":300,"limit":280}},{"type":"tool_use","id":"call-14deea75-7a34-4224-93c3-1e87d5bd15a6-29","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/web/session.js","offset":250,"limit":250}},{"type":"tool_use","id":"call-14deea75-7a34-4224-93c3-1e87d5bd15a6-30","name":"grep","input":{"pattern":"hub:session|goal|howto|webgpu|card","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/tmp/grok-goal-907ccca5ce3b/implementer/harness.html"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":5667,"output_tokens":274,"cache_read_input_tokens":77824,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"50bb2309-5459-4c79-bf9b-b3e833c0eb79"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-14deea75-7a34-4224-93c3-1e87d5bd15a6-28","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→  log(`${cell.key} answers ${what} on the game's card`);\\n  const players = state.cells.filter((c) => !c.server && !c.gone);\\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\\n  tickCard(state);\\n}\\n\\nfunction endCurrent() {\\n  if (!current) return;\\n  current.coordinator.abort('session-ended');\\n  for (const cell of current.cells) removeCell(cell, false);\\n310→  current.hubEnd.close();\\n  current = null;\\n}\\n\\nfunction removeCell(cell, tellRound = true) {\\n  if (cell.gone) return;\\n  cell.gone = true;\\n  cell.detach();\\n  cell.endpoint.close();\\n  cell.frame.remove();\\n320→  cell.el.classList.add('is-out');\\n  if (tellRound) {\\n    log(`${cell.key} left`);\\n    current?.coordinator.leave(cell.key, 'left');\\n  }\\n}\\n\\nfunction renderWho(state) {\\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\\n}\\n330→\\nfunction render(state) {\\n  const s = state.status;\\n  if (!s) return;\\n  for (const cell of state.cells) {\\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\\n    if (!p) continue;\\n    const bits = [];\\n    if (p.out) bits.push(`out: ${p.out}`);\\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\\n340→    else if (p.ready) bits.push('ready');\\n    else if (p.hello) bits.push('welcomed');\\n    else bits.push('loading');\\n    const last = cell.progress.at(-1);\\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\\n  }\\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\\n350→  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\\n  if (state.record) {\\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\\n  }\\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\\n  $('round').textContent = lines.join('\\\\n');\\n}\\n\\n360→$('restart').onclick = () => newRound();\\n$('release').onclick = () => releaseRound();\\n$('timeup').onclick = () => current?.coordinator.timeUp();\\n$('remove').onclick = () => {\\n  const cell = current?.cells.find((c) => c.key === $('who').value);\\n  if (cell) removeCell(cell);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n420→    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\\n\\n    // Every copy: the players, and in a server round the server's copy.\\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\\n430→    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\\n    if (!helloed) return;\\n    const caps = state.coordinator.seats().map((s) => s.caps);\\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\\n      return;\\n    }\\n\\n440→    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\\n    if (caps.some((c) => c?.card)) {\\n      const players = state.cells.filter((c) => !c.server);\\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\\n      for (const cell of players) poke(cell, 'Enter');\\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n450→    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n460→      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n470→    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n480→    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\\n490→        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\\n    } else {\\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n500→      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n510→    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n520→    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\\n  } catch (error) {\\n    check('harness ran', false, String(error?.stack || error));\\n  } finally {\\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\\n    report.done = true;\\n    document.body.dataset.complete = 'true';\\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\\n  }\\n530→}\\n\\nfunction renderChecks(checks) {\\n  $('checklist').replaceChildren(\\n    ...checks.map((c) => {\\n      const li = document.createElement('li');\\n      li.className = c.pass ? 'ok' : 'bad';\\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\\n      li.title = c.detail;\\n      return li;\\n540→    }),\\n  );\\n}\\n\\nif (auto) conformance();\\nelse if ($('game').value) newRound();\\n</script>\\n</body>\\n</html>\\n\",\"content_concise\":\"300→  log(`${cell.key} answers ${what} on the game's card`);\\n  const players = state.cells.filter((c) => !c.server && !c.gone);\\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\\n  tickCard(state);\\n}\\n\\nfunction endCurrent() {\\n  if (!current) return;\\n  current.coordinator.abort('session-ended');\\n  for (const cell of current.cells) removeCell(cell, false);\\n310→  current.hubEnd.close();\\n  current = null;\\n}\\n\\nfunction removeCell(cell, tellRound = true) {\\n  if (cell.gone) return;\\n  cell.gone = true;\\n  cell.detach();\\n  cell.endpoint.close();\\n  cell.frame.remove();\\n320→  cell.el.classList.add('is-out');\\n  if (tellRound) {\\n    log(`${cell.key} left`);\\n    current?.coordinator.leave(cell.key, 'left');\\n  }\\n}\\n\\nfunction renderWho(state) {\\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\\n}\\n330→\\nfunction render(state) {\\n  const s = state.status;\\n  if (!s) return;\\n  for (const cell of state.cells) {\\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\\n    if (!p) continue;\\n    const bits = [];\\n    if (p.out) bits.push(`out: ${p.out}`);\\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\\n340→    else if (p.ready) bits.push('ready');\\n    else if (p.hello) bits.push('welcomed');\\n    else bits.push('loading');\\n    const last = cell.progress.at(-1);\\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\\n  }\\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\\n350→  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\\n  if (state.record) {\\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\\n  }\\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\\n  $('round').textContent = lines.join('\\\\n');\\n}\\n\\n360→$('restart').onclick = () => newRound();\\n$('release').onclick = () => releaseRound();\\n$('timeup').onclick = () => current?.coordinator.timeUp();\\n$('remove').onclick = () => {\\n  const cell = current?.cells.find((c) => c.key === $('who').value);\\n  if (cell) removeCell(cell);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  r