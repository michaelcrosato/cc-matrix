  if h.aux2 >= 1.12 {\\n                h.alive = false;\\n                bursts.push((h.x, h.z));\\n            }\\n290→        } else if h.tag == 1 {\\n            let w = (g.elapsed * 1.4 + h.id as f32).sin();\\n            h.x = (h.x + w * rules * 0.28).clamp(-8.2, 8.2);\\n        }\\n    }\\n    for (x, z) in bursts {\\n        note_kind(g, K_SAC);\\n        g.heart.vitals = (g.heart.vitals - 6.0).max(0.0);\\n        g.spawn_kind_at(K_POOL, x, z, 0.9);\\n        cue(events, CUE_BURST, x, z, 0.8, 0.9);\\n300→    }\\n}\\n\\nfn hands(g: &mut Surgery, slots: &[SurgeonInput; 4], rules: f32, dt: f32, tick: u64, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let mut inp = slots[i];\\n        if inp.held & surg::AIM_ABSOLUTE == 0 {\",\"content_concise\":\"277→fn swell_and_wander(g: &mut Surgery, rules: f32, events: &mut Vec<SimEvent>) {\\n    let mut bursts: Vec<(f32, f32)> = Vec::new();\\n    for h in &mut g.hazards {\\n280→        if !h.alive {\\n            continue;\\n        }\\n        if h.kind == K_SAC {\\n            // aux is the laser charge. Swell uses aux2 so a ripe sac can still be lased.\\n            h.aux2 = (h.aux2 + rules * 0.08).min(1.3);\\n            if h.aux2 >= 1.12 {\\n                h.alive = false;\\n                bursts.push((h.x, h.z));\\n            }\\n290→        } else if h.tag == 1 {\\n            let w = (g.elapsed * 1.4 + h.id as f32).sin();\\n            h.x = (h.x + w * rules * 0.28).clamp(-8.2, 8.2);\\n        }\\n    }\\n    for (x, z) in bursts {\\n        note_kind(g, K_SAC);\\n        g.heart.vitals = (g.heart.vitals - 6.0).max(0.0);\\n        g.spawn_kind_at(K_POOL, x, z, 0.9);\\n        cue(events, CUE_BURST, x, z, 0.8, 0.9);\\n300→    }\\n}\\n\\nfn hands(g: &mut Surgery, slots: &[SurgeonInput; 4], rules: f32, dt: f32, tick: u64, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let mut inp = slots[i];\\n        if inp.held & surg::AIM_ABSOLUTE == 0 {\",\"absolute_path\":\"/home/micha/dev/cc-ma