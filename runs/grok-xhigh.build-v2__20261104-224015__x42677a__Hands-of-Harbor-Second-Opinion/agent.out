,46,48,41,44,10,45,45,10,49,57,49,58,32,32,32,32,32,32,32,32,32,32,32,32,112,104,97,115,101,40,67,48,95,65,44,32,116,114,117,101,44,32,78,79,95,83,84,82,65,73,78,44,32,48,44,32,48,44,32,48,44,32,102,97,108,115,101,41,44,10,49,57,50,45,32,32,32,32,32,32,32,32,32,32,32,32,112,104,97,115,101,40,67,48,95,66,44,32,116,114,117,101,44,32,78,79,95,83,84,82,65,73,78,44,32,49,48,44,32,48,44,32,48,44,32,102,97,108,115,101,41,44,10,49,57,51,45,32,32,32,32,32,32,32,32,93,44,10,49,57,52,45,32,32,32,32,125,44,10,49,57,53,45,32,32,32,32,67,97,115,101,68,101,102,32,123,10,49,57,54,45,32,32,32,32,32,32,32,32,110,97,109,101,58,32,34,83,97,108,116,32,105,110,32,116,104,101,32,80,101,114,105,116,111,110,101,117,109,34,44,10,49,57,55,45,32,32,32,32,32,32,32,32,112,97,116,105,101,110,116,58,32,34,66,114,105,111,110,121,32,80,101,108,108,34,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":2,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/src/games/surgery/content.rs\",\"matches\":[{\"line_number\":49,\"content\":\"const C0_A: &[SpawnDef] = &[\"},{\"line_number\":191,\"content\":\"            phase(C0_A, true, NO_STRAIN, 0, 0, 0, false),\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"a3ce596b-bb54-464d-9500-ba933d9d6e48"}
{"type":"assistant","message":{"id":"msg_336","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A pool already exists at coordinates (1.5, -0...).\n\nThe nearest target is the polyp. Suctioning it will count as a chain link. Laser heat works on it. I will spawn five pools and aim only at the new ones. The existing pool will remain.\n\nSpawn positions are confirmed clear of the existing pool. I will write a clean test file and check compilation progress. I also need to verify whether `get` requires a type annotation.\n\nDefault difficulty gives about 27 seconds to drain vitals. A 90-second idle timeout is safe. The 400-second cap is also safe. Failing the code window kills the player even if defibrillators remain. Random tool usage cannot accidentally trigger a defibrillator.\n\nRandom tool use cannot finish a pool in one tick. Laceration suturing also needs more time. Mistakes from wrong tools might add damage, but the player should still lose unless they accidentally clear both wounds.","signature":""},{"type":"tool_use","id":"call-5a163196-50bb-4fc9-a03b-a2737825f31d-119","name":"get_command_or_subagent_output","input":{"task_ids":["903ac91a-16ab-4714-86e6-8be4107b7fca"],"timeout_ms":0}},{"type":"tool_use","id":"call-5a163196-50bb-4fc9-a03b-a2737825f31d-120","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/tests/surgery.rs","content":"//! Hands of Harbor: the shipped sim, from a fresh scene.\n\nuse pav_core::games::surgery::{\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\n    TOOL_NAMES,\n};\nuse pav_core::games::Outcome;\nuse pav_core::glam::Vec2;\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\nuse pav_core::Sim;\n\nfn status(sim: &Sim) -> String {\n    sim.play().unwrap().status(sim).to_string()\n}\n\nfn game(sim: &Sim) -> &Surgery {\n    sim.play().unwrap().get::<Surgery>().unwrap()\n}\n\nfn cmd(c: SurgeryCmd) -> InputFrame {\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\n}\n\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\n    if use_on {\n        held |= surg::USE;\n    }\n    let mut frame = InputFrame::default();\n    frame.surgeons[0] = SurgeonInput {\n        active: true,\n        aim: Vec2::new(x, z),\n        held,\n        pressed: 0,\n        tool,\n        pressure: 1.0,\n    };\n    frame\n}\n\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\n    for t in 0..cap {\n        if sim.outcome() != Outcome::Playing {\n            return t;\n        }\n        let frame = drive(t, sim);\n        sim.step(&frame);\n    }\n    cap\n}\n\n#[test]\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\n    for seed in 1..11 {\n        for case in 0..8 {\n            let scene = format!(\"surgery/case/{case}\");\n            let mut sim = Sim::new(&scene, seed).unwrap();\n            let (outcome, ticks) = sim.run_bot(60 * 420);\n            assert_eq!(outcome, Outcome::Won, \"seed {seed} {scene} t={ticks} {}\", status(&sim));\n            let g = game(&sim);\n            assert!(g.rank >= 4, \"seed {seed} case {case} rank {} {}\", g.rank, status(&sim));\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\n        }\n        {\n            let mut sim = Sim::new(\"surgery/code\", seed).unwrap();\n            let (outcome, ticks) = sim.run_bot(60 * 260);\n            assert_eq!(outcome, Outcome::Won, \"seed {seed} code t={ticks} {}\", status(&sim));\n            assert!(game(&sim).rank >= 4, \"seed {seed} code {}\", status(&sim));\n        }\n        {\n            let mut sim = Sim::new(\"surgery/campaign\", seed).unwrap();\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\n            assert_eq!(outcome, Outcome::Won, \"seed {seed} campaign t={ticks} {}\", status(&sim));\n            let g = game(&sim);\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \"tools {:?}\", g.coverage.tools);\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \"hazards {:?}\", g.coverage.hazards);\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \"strains {:?}\", g.coverage.strains);\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \"gifts {:?}\", g.coverage.gifts);\n            assert!(g.coverage.code > 0, \"code {}\", g.coverage.code);\n            assert!(g.best_chain() >= 5, \"chain {}\", g.best_chain());\n        }\n    }\n}\n\n#[test]\nfn idle_and_random_tool_lose_every_case() {\n    let scenes = [\n        \"surgery/case/0\",\n        \"surgery/case/1\",\n        \"surgery/case/2\",\n        \"surgery/case/3\",\n        \"surgery/case/4\",\n        \"surgery/case/5\",\n        \"surgery/case/6\",\n        \"surgery/case/7\",\n        \"surgery/code\",\n    ];\n    for scene in scenes {\n        let mut idle = Sim::new(scene, 1).unwrap();\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\n        assert_eq!(idle.outcome(), Outcome::Lost, \"idle {scene} {}\", status(&idle));\n\n        let mut messy = Sim::new(scene, 1).unwrap();\n        play_until(&mut messy, 60 * 400, |t, _| {\n            let ang = t as f32 * 0.37;\n            let tool = (t % 11) as u8;\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\n        });\n        assert_eq!(messy.outcome(), Outcome::Lost, \"random {scene} {}\", status(&messy));\n    }\n}\n\n#[test]\nfn snapshot_rewind_and_replay_match() {\n    let mut sim = Sim::new(\"surgery/case/0\", 4).unwrap();\n    sim.config.history_seconds = 8.0;\n    for _ in 0..240 {\n        let frame = sim.bot_input();\n        sim.step(&frame);\n    }\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"surgery/case/0\", 4).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..120 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90), \"rewind\");\n    assert!(sim.rewind_to(tick), \"replay rewind\");\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"surgery/case/0\", 4).unwrap();\n    for frame in sim.recording.iter() {\n        again.step(frame);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n\n#[test]\nfn overheat_is_sloppy_and_five_pools_chain() {\n    let mut sim = Sim::new(\"surgery/case/0\", 1).unwrap();\n    sim.step(&InputFrame::default());\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\n    let (x, z) = {\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\"polyp\");\n        (h.x, h.z)\n    };\n    for _ in 0..180 {\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\n            break;\n        }\n        sim.step(&hand(x, z, LASER, true));\n    }\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \"sloppy {}\", status(&sim));\n\n    let mut sim = Sim::new(\"surgery/case/0\", 1).unwrap();\n    sim.step(&InputFrame::default());\n    for _ in 0..5 {\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\n        let (x, z, id) = {\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\"pool\");\n            (h.x, h.z, h.id)\n        };\n        for _ in 0..120 {\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\n            if !alive {\n                break;\n            }\n            sim.step(&hand(x, z, SUCTION, true));\n        }\n        assert!(!game(&sim).hazards.iter().any(|h| h.id == id && h.alive), \"pool stayed {}\", status(&sim));\n    }\n    let chain = game(&sim).best_chain();\n    assert!(chain >= 5, \"chain {chain}\");\n    assert_eq!(chain_mul(5), 1.25);\n    assert_eq!(chain_mul(10), 1.5);\n    assert_eq!(chain_mul(20), 2.0);\n}\n\n#[test]\nfn beat_window_code_window_and_checkpoint_retry() {\n    let mut sim = Sim::new(\"surgery/case/0\", 2).unwrap();\n    sim.step(&InputFrame::default());\n    {\n        let g = game(&sim);\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\n        assert!((g.heart.bpm - expect).abs() < 0.05, \"bpm {} vs {expect}\", g.heart.bpm);\n    }\n    let mut saw_on = false;\n    let mut saw_off = false;\n    for _ in 0..240 {\n        sim.step(&InputFrame::default());\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\n        saw_on |= on;\n        saw_off |= !on;\n    }\n    assert!(saw_on && saw_off, \"on-beat window never changed\");\n    let _ = Heart::new(80.0);\n\n    let mut sim = Sim::new(\"surgery/case/0\", 2).unwrap();\n    sim.step(&InputFrame::default());\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\n    assert!(game(&sim).heart.flat, \"code did not start\");\n    assert!(game(&sim).code_t > 0.0);\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\n    assert_eq!(sim.outcome(), Outcome::Lost, \"missed code {}\", status(&sim));\n\n    let mut sim = Sim::new(\"surgery/case/0\", 2).unwrap();\n    for _ in 0..40 {\n        let frame = sim.bot_input();\n        sim.step(&frame);\n    }\n    let vitals = game(&sim).heart.vitals;\n    assert!(vitals > 20.0, \"already dead before the kill\");\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\n    assert_eq!(sim.outcome(), Outcome::Lost, \"{}\", status(&sim));\n    sim.step(&cmd(SurgeryCmd::Retry));\n    assert_eq!(sim.outcome(), Outcome::Playing, \"retry {}\", status(&sim));\n    assert_eq!(game(&sim).mode, 3, \"back in the operation\");\n    assert!(game(&sim).heart.vitals > 20.0, \"checkpoint vitals {}\", game(&sim).heart.vitals);\n}\n\n#[test]\nfn story_lines_are_filled_and_music_defaults_quiet() {\n    let lines = all_lines();\n    assert!(lines.len() >= 150, \"story lines {}\", lines.len());\n    let banned = [\"Hope Hospital\", \"Caduceus\", \"Stiles\", \"GUILT\", \"Healing Touch\"];\n    for line in &lines {\n        assert!(!line.text.trim().is_empty(), \"empty line from {}\", line.who);\n        assert!(!line.who.trim().is_empty());\n        let blob = format!(\"{} {}\", line.who, line.text);\n        assert!(!blob.contains(\"TODO\"), \"{blob}\");\n        for word in banned {\n            assert!(!blob.contains(word), \"{word} in {blob}\");\n        }\n    }\n    for name in TOOL_NAMES.iter().chain(SURGEON_NAMES.iter()).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\n        for word in banned {\n            assert!(!name.contains(word), \"{word} in {name}\");\n        }\n    }\n    assert_eq!(TITLE, \"Hands of Harbor: Second Opinion\");\n    let sim = Sim::new(\"surgery/title\", 1).unwrap();\n    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\n    assert_eq!(rank_of(900, 900), 4);\n    assert_eq!(rank_of(1035, 900), 5);\n    assert_eq!(rank_of(449, 900), 0);\n}\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":566,"output_tokens":4074,"cache_read_input_tokens":133504,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"5b7ddfd3-688d-4318-919a-d9304209843e"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-5a163196-50bb-4fc9-a03b-a2737825f31d-119","content":"{\"type\":\"TaskOutput\",\"Result\":{\"task_id\":\"903ac91a-16ab-4714-86e6-8be4107b7fca\",\"command\":\"cd /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link && CARGO_TARGET_DIR=/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/.harbor-target CARGO_BUILD_JOBS=6 cargo test -p pav_ui --lib surgery -- --test-threads=1\",\"status\":\"failed\",\"exit_code\":101,\"started\":\"2026-11-05T07:31:30Z\",\"ended\":\"2026-11-05T07:32:50Z\",\"duration_secs\":80.797190303,\"output\":\"\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-224015__x42677a%2Fwork/01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2/terminal/call-3bdffe2c-7b9f-4c33-bc55-1abb57a5d868-18.log\",\"truncated\":true,\"truncation_hint\":\"[truncated - use read_file on output_file for full content]\",\"raw_output_bytes\":11958}}","is_error":false},{"type":"tool_result","tool_use_id":"call-5a163196-50bb-4fc9-a03b-a2737825f31d-120","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"//! Hands of Harbor: the shipped sim, from a fresh scene, played by its own bot.\\n\\nuse pav_core::games::Outcome;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::{Sim, SimState};\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn set_skill(sim: &mut Sim, skill: f32) {\\n    sim.state.play.as_mut().unwrap().get_mut::<pav_core::games::surgery::Surgery>().unwrap().skill = skill;\\n}\\n\\n#[test]\\nfn probe_stuck() {\\n    for case in [4u8, 5, 6] {\\n        let mut sim = Sim::new(&format!(\\\"surgery/case/{case}\\\"), 1).unwrap();\\n        let mut last_m = 0u32;\\n        let mut last_phase = 99u16;\\n        eprintln!(\\\"--- case {case}\\\");\\n        for _ in 0..60 * 80 {\\n            if sim.outcome() != pav_core::games::Outcome::Playing {\\n                break;\\n            }\\n            let f = sim.bot_input();\\n            sim.step(&f);\\n            let g = sim.play().unwrap().get::<pav_core::games::surgery::Surgery>().unwrap();\\n            let interesting = g.mistakes != last_m || g.phase_i != last_phase || sim.state.tick % 120 == 0;\\n            if interesting && (g.phase_i >= 2 || case != 4) {\\n                last_m = g.mistakes;\\n                last_phase = g.phase_i;\\n                let s = &g.surgeons[0];\\n                eprint!(\\n                    \\\"t={} ph={} tool={} cur=({:.2},{:.2}) use={} mis={} vit={:.0} heat={} ang={:.2} \\\",\\n                    sim.state.tick, g.phase_i, s.tool, s.x, s.z, s.was_use, g.mistakes, g.heart.vitals, g.heat_on, g.heat_angle\\n                );\\n                for h in &g.hazards {\\n                    if h.alive && h.kind != 13 {\\n                        eprint!(\\n                            \\\"[k{} st{} tl{} w={:.2}/{:.2} ax={:.2} g={} aux={:.2} ({:.2},{:.2})] \\\",\\n                            h.kind, h.stage, h.tool, h.work, h.need, h.aux, h.grabbed, h.aux2, h.x, h.z\\n                        );\\n                    }\\n                }\\n                eprintln!();\\n            }\\n        }\\n        eprintln!(\\\"end {}\\\", status(&sim));\\n    }\\n}\\n\\n#[test]\\nfn survey_skill1() {\\n    let mut lines = Vec::new();\\n    for case in 0..8 {\\n        let mut sim = Sim::new(&format!(\\\"surgery/case/{case}\\\"), 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 420);\\n        lines.push(format!(\\\"case {case} {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    {\\n        let mut sim = Sim::new(\\\"surgery/code\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 260);\\n        lines.push(format!(\\\"code {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    {\\n        let mut sim = Sim::new(\\\"surgery/campaign\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 2200);\\n        lines.push(format!(\\\"camp {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    let dump = lines.join(\\\"\\\\n\\\");\\n    eprintln!(\\\"{dump}\\\");\\n    assert!(lines.iter().all(|l| l.contains(\\\"Won\\\")), \\\"{dump}\\\");\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    let (outcome, ticks) = sim.run_bot(60 * 180);\\n    assert_eq!(outcome, Outcome::Won, \\\"{ticks} ticks {}\\\", status(&sim));\\n    let rank = sim.play().unwrap().status(&sim)[\\\"rank_n\\\"].as_u64().unwrap_or(0);\\n    assert!(rank >= 4, \\\"skill 1 should clear S, {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn idle_loses_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    for _ in 0..(60 * 90) {\\n        if sim.outcome() == Outcome::Lost {\\n            break;\\n        }\\n        sim.step(&InputFrame::default());\\n    }\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n}\\n\",\"new_string\":\"//! Hands of Harbor: the shipped sim, from a fresh scene.\\n\\nuse pav_core::games::surgery::{\\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\\n    TOOL_NAMES,\\n};\\nuse pav_core::games::Outcome;\\nuse pav_core::glam::Vec2;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::Sim;\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn game(sim: &Sim) -> &Surgery {\\n    sim.play().unwrap().get::<Surgery>().unwrap()\\n}\\n\\nfn cmd(c: SurgeryCmd) -> InputFrame {\\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\\n}\\n\\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    frame\\n}\\n\\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\\n    for t in 0..cap {\\n        if sim.outcome() != Outcome::Playing {\\n            return t;\\n        }\\n        let frame = drive(t, sim);\\n        sim.step(&frame);\\n    }\\n    cap\\n}\\n\\n#[test]\\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\\n    for seed in 1..11 {\\n        for case in 0..8 {\\n            let scene = format!(\\\"surgery/case/{case}\\\");\\n            let mut sim = Sim::new(&scene, seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 420);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} {scene} t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.rank >= 4, \\\"seed {seed} case {case} rank {} {}\\\", g.rank, status(&sim));\\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/code\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 260);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} code t={ticks} {}\\\", status(&sim));\\n            assert!(game(&sim).rank >= 4, \\\"seed {seed} code {}\\\", status(&sim));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/campaign\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} campaign t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \\\"tools {:?}\\\", g.coverage.tools);\\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \\\"hazards {:?}\\\", g.coverage.hazards);\\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \\\"strains {:?}\\\", g.coverage.strains);\\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \\\"gifts {:?}\\\", g.coverage.gifts);\\n            assert!(g.coverage.code > 0, \\\"code {}\\\", g.coverage.code);\\n            assert!(g.best_chain() >= 5, \\\"chain {}\\\", g.best_chain());\\n        }\\n    }\\n}\\n\\n#[test]\\nfn idle_and_random_tool_lose_every_case() {\\n    let scenes = [\\n        \\\"surgery/case/0\\\",\\n        \\\"surgery/case/1\\\",\\n        \\\"surgery/case/2\\\",\\n        \\\"surgery/case/3\\\",\\n        \\\"surgery/case/4\\\",\\n        \\\"surgery/case/5\\\",\\n        \\\"surgery/case/6\\\",\\n        \\\"surgery/case/7\\\",\\n        \\\"surgery/code\\\",\\n    ];\\n    for scene in scenes {\\n        let mut idle = Sim::new(scene, 1).unwrap();\\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\\n        assert_eq!(idle.outcome(), Outcome::Lost, \\\"idle {scene} {}\\\", status(&idle));\\n\\n        let mut messy = Sim::new(scene, 1).unwrap();\\n        play_until(&mut messy, 60 * 400, |t, _| {\\n            let ang = t as f32 * 0.37;\\n            let tool = (t % 11) as u8;\\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\\n        });\\n        assert_eq!(messy.outcome(), Outcome::Lost, \\\"random {scene} {}\\\", status(&messy));\\n    }\\n}\\n\\n#[test]\\nfn snapshot_rewind_and_replay_match() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    sim.config.history_seconds = 8.0;\\n    for _ in 0..240 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let mut bytes = Vec::new();\\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\\n    let mut copy = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    copy.restore(state);\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n    for _ in 0..120 {\\n        let (a, b) = (sim.bot_input(), copy.bot_input());\\n        sim.step(&a);\\n        copy.step(&b);\\n    }\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n\\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90), \\\"rewind\\\");\\n    assert!(sim.rewind_to(tick), \\\"replay rewind\\\");\\n    assert_eq!(sim.state_hash(), hash);\\n\\n    let mut again = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    for frame in sim.recording.iter() {\\n        again.step(frame);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn overheat_is_sloppy_and_five_pools_chain() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\\n    let (x, z) = {\\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\\\"polyp\\\");\\n        (h.x, h.z)\\n    };\\n    for _ in 0..180 {\\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\\n            break;\\n        }\\n        sim.step(&hand(x, z, LASER, true));\\n    }\\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \\\"sloppy {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    for _ in 0..5 {\\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\\n        let (x, z, id) = {\\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\\\"pool\\\");\\n            (h.x, h.z, h.id)\\n        };\\n        for _ in 0..120 {\\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\\n            if !alive {\\n                break;\\n            }\\n            sim.step(&hand(x, z, SUCTION, true));\\n        }\\n        assert!(!game(&sim).hazards.iter().any(|h| h.id == id && h.alive), \\\"pool stayed {}\\\", status(&sim));\\n    }\\n    let chain = game(&sim).best_chain();\\n    assert!(chain >= 5, \\\"chain {chain}\\\");\\n    assert_eq!(chain_mul(5), 1.25);\\n    assert_eq!(chain_mul(10), 1.5);\\n    assert_eq!(chain_mul(20), 2.0);\\n}\\n\\n#[test]\\nfn beat_window_code_window_and_checkpoint_retry() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    {\\n        let g = game(&sim);\\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\\n        assert!((g.heart.bpm - expect).abs() < 0.05, \\\"bpm {} vs {expect}\\\", g.heart.bpm);\\n    }\\n    let mut saw_on = false;\\n    let mut saw_off = false;\\n    for _ in 0..240 {\\n        sim.step(&InputFrame::default());\\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\\n        saw_on |= on;\\n        saw_off |= !on;\\n    }\\n    assert!(saw_on && saw_off, \\\"on-beat window never changed\\\");\\n    let _ = Heart::new(80.0);\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\\n    assert!(game(&sim).heart.flat, \\\"code did not start\\\");\\n    assert!(game(&sim).code_t > 0.0);\\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"missed code {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    for _ in 0..40 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let vitals = game(&sim).heart.vitals;\\n    assert!(vitals > 20.0, \\\"already dead before the kill\\\");\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n    sim.step(&cmd(SurgeryCmd::Retry));\\n    assert_eq!(sim.outcome(), Outcome::Playing, \\\"retry {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 3, \\\"back in the operation\\\");\\n    assert!(game(&sim).heart.vitals > 20.0, \\\"checkpoint vitals {}\\\", game(&sim).heart.vitals);\\n}\\n\\n#[test]\\nfn story_lines_are_filled_and_music_defaults_quiet() {\\n    let lines = all_lines();\\n    assert!(lines.len() >= 150, \\\"story lines {}\\\", lines.len());\\n    let banned = [\\\"Hope Hospital\\\", \\\"Caduceus\\\", \\\"Stiles\\\", \\\"GUILT\\\", \\\"Healing Touch\\\"];\\n    for line in &lines {\\n        assert!(!line.text.trim().is_empty(), \\\"empty line from {}\\\", line.who);\\n        assert!(!line.who.trim().is_empty());\\n        let blob = format!(\\\"{} {}\\\", line.who, line.text);\\n        assert!(!blob.contains(\\\"TODO\\\"), \\\"{blob}\\\");\\n        for word in banned {\\n            assert!(!blob.contains(word), \\\"{word} in {blob}\\\");\\n        }\\n    }\\n    for name in TOOL_NAMES.iter().chain(SURGEON_NAMES.iter()).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\\n        for word in banned {\\n            assert!(!name.contains(word), \\\"{word} in {name}\\\");\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Hands of Harbor: Second Opinion\\\");\\n    let sim = Sim::new(\\\"surgery/title\\\", 1).unwrap();\\n    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\\n    assert_eq!(rank_of(900, 900), 4);\\n    assert_eq!(rank_of(1035, 900), 5);\\n    assert_eq!(rank_of(449, 900), 0);\\n}\\n\",\"tool_output_for_prompt\":\"Wrote file successfully to /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/tests/surgery.rs.\",\"tool_output_for_prompt_concise\":\"Wrote file successfully to /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/tests/surgery.rs.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_core/tests/surgery.rs\",\"edits\":{\"details\":[{\"old_string\":\"//! Hands of Harbor: the shipped sim, from a fresh scene, played by its own bot.\\n\\nuse pav_core::games::Outcome;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::{Sim, SimState};\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn set_skill(sim: &mut Sim, skill: f32) {\\n    sim.state.play.as_mut().unwrap().get_mut::<pav_core::games::surgery::Surgery>().unwrap().skill = skill;\\n}\\n\\n#[test]\\nfn probe_stuck() {\\n    for case in [4u8, 5, 6] {\\n        let mut sim = Sim::new(&format!(\\\"surgery/case/{case}\\\"), 1).unwrap();\\n        let mut last_m = 0u32;\\n        let mut last_phase = 99u16;\\n        eprintln!(\\\"--- case {case}\\\");\\n        for _ in 0..60 * 80 {\\n            if sim.outcome() != pav_core::games::Outcome::Playing {\\n                break;\\n            }\\n            let f = sim.bot_input();\\n            sim.step(&f);\\n            let g = sim.play().unwrap().get::<pav_core::games::surgery::Surgery>().unwrap();\\n            let interesting = g.mistakes != last_m || g.phase_i != last_phase || sim.state.tick % 120 == 0;\\n            if interesting && (g.phase_i >= 2 || case != 4) {\\n                last_m = g.mistakes;\\n                last_phase = g.phase_i;\\n                let s = &g.surgeons[0];\\n                eprint!(\\n                    \\\"t={} ph={} tool={} cur=({:.2},{:.2}) use={} mis={} vit={:.0} heat={} ang={:.2} \\\",\\n                    sim.state.tick, g.phase_i, s.tool, s.x, s.z, s.was_use, g.mistakes, g.heart.vitals, g.heat_on, g.heat_angle\\n                );\\n                for h in &g.hazards {\\n                    if h.alive && h.kind != 13 {\\n                        eprint!(\\n                            \\\"[k{} st{} tl{} w={:.2}/{:.2} ax={:.2} g={} aux={:.2} ({:.2},{:.2})] \\\",\\n                            h.kind, h.stage, h.tool, h.work, h.need, h.aux, h.grabbed, h.aux2, h.x, h.z\\n                        );\\n                    }\\n                }\\n                eprintln!();\\n            }\\n        }\\n        eprintln!(\\\"end {}\\\", status(&sim));\\n    }\\n}\\n\\n#[test]\\nfn survey_skill1() {\\n    let mut lines = Vec::new();\\n    for case in 0..8 {\\n        let mut sim = Sim::new(&format!(\\\"surgery/case/{case}\\\"), 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 420);\\n        lines.push(format!(\\\"case {case} {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    {\\n        let mut sim = Sim::new(\\\"surgery/code\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 260);\\n        lines.push(format!(\\\"code {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    {\\n        let mut sim = Sim::new(\\\"surgery/campaign\\\", 1).unwrap();\\n        let (o, t) = sim.run_bot(60 * 2200);\\n        lines.push(format!(\\\"camp {o:?} t={t} {}\\\", status(&sim)));\\n    }\\n    let dump = lines.join(\\\"\\\\n\\\");\\n    eprintln!(\\\"{dump}\\\");\\n    assert!(lines.iter().all(|l| l.contains(\\\"Won\\\")), \\\"{dump}\\\");\\n}\\n\\n#[test]\\nfn case0_bot_wins() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    let (outcome, ticks) = sim.run_bot(60 * 180);\\n    assert_eq!(outcome, Outcome::Won, \\\"{ticks} ticks {}\\\", status(&sim));\\n    let rank = sim.play().unwrap().status(&sim)[\\\"rank_n\\\"].as_u64().unwrap_or(0);\\n    assert!(rank >= 4, \\\"skill 1 should clear S, {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn idle_loses_case0() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    for _ in 0..(60 * 90) {\\n        if sim.outcome() == Outcome::Lost {\\n            break;\\n        }\\n        sim.step(&InputFrame::default());\\n    }\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n}\\n\",\"old_line\":1,\"new_string\":\"//! Hands of Harbor: the shipped sim, from a fresh scene.\\n\\nuse pav_core::games::surgery::{\\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\\n    TOOL_NAMES,\\n};\\nuse pav_core::games::Outcome;\\nuse pav_core::glam::Vec2;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::Sim;\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn game(sim: &Sim) -> &Surgery {\\n    sim.play().unwrap().get::<Surgery>().unwrap()\\n}\\n\\nfn cmd(c: SurgeryCmd) -> InputFrame {\\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\\n}\\n\\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    frame\\n}\\n\\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\\n    for t in 0..cap {\\n        if sim.outcome() != Outcome::Playing {\\n            return t;\\n        }\\n        let frame = drive(t, sim);\\n        sim.step(&frame);\\n    }\\n    cap\\n}\\n\\n#[test]\\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\\n    for seed in 1..11 {\\n        for case in 0..8 {\\n            let scene = format!(\\\"surgery/case/{case}\\\");\\n            let mut sim = Sim::new(&scene, seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 420);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} {scene} t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.rank >= 4, \\\"seed {seed} case {case} rank {} {}\\\", g.rank, status(&sim));\\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/code\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 260);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} code t={ticks} {}\\\", status(&sim));\\n            assert!(game(&sim).rank >= 4, \\\"seed {seed} code {}\\\", status(&sim));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/campaign\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} campaign t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \\\"tools {:?}\\\", g.coverage.tools);\\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \\\"hazards {:?}\\\", g.coverage.hazards);\\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \\\"strains {:?}\\\", g.coverage.strains);\\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \\\"gifts {:?}\\\", g.coverage.gifts);\\n            assert!(g.coverage.code > 0, \\\"code {}\\\", g.coverage.code);\\n            assert!(g.best_chain() >= 5, \\\"chain {}\\\", g.best_chain());\\n        }\\n    }\\n}\\n\\n#[test]\\nfn idle_and_random_tool_lose_every_case() {\\n    let scenes = [\\n        \\\"surgery/case/0\\\",\\n        \\\"surgery/case/1\\\",\\n        \\\"surgery/case/2\\\",\\n        \\\"surgery/case/3\\\",\\n        \\\"surgery/case/4\\\",\\n        \\\"surgery/case/5\\\",\\n        \\\"surgery/case/6\\\",\\n        \\\"surgery/case/7\\\",\\n        \\\"surgery/code\\\",\\n    ];\\n    for scene in scenes {\\n        let mut idle = Sim::new(scene, 1).unwrap();\\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\\n        assert_eq!(idle.outcome(), Outcome::Lost, \\\"idle {scene} {}\\\", status(&idle));\\n\\n        let mut messy = Sim::new(scene, 1).unwrap();\\n        play_until(&mut messy, 60 * 400, |t, _| {\\n            let ang = t as f32 * 0.37;\\n            let tool = (t % 11) as u8;\\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\\n        });\\n        assert_eq!(messy.outcome(), Outcome::Lost, \\\"random {scene} {}\\\", status(&messy));\\n    }\\n}\\n\\n#[test]\\nfn snapshot_rewind_and_replay_match() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    sim.config.history_seconds = 8.0;\\n    for _ in 0..240 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let mut bytes = Vec::new();\\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\\n    let mut copy = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    copy.restore(state);\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n    for _ in 0..120 {\\n        let (a, b) = (sim.bot_input(), copy.bot_input());\\n        sim.step(&a);\\n        copy.step(&b);\\n    }\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n\\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90), \\\"rewind\\\");\\n    assert!(sim.rewind_to(tick), \\\"replay rewind\\\");\\n    assert_eq!(sim.state_hash(), hash);\\n\\n    let mut again = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    for frame in sim.recording.iter() {\\n        again.step(frame);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn overheat_is_sloppy_and_five_pools_chain() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\\n    let (x, z) = {\\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\\\"polyp\\\");\\n        (h.x, h.z)\\n    };\\n    for _ in 0..180 {\\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\\n            break;\\n        }\\n        sim.step(&hand(x, z, LASER, true));\\n    }\\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \\\"sloppy {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    for _ in 0..5 {\\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\\n        let (x, z, id) = {\\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\\\"pool\\\");\\n            (h.x, h.z, h.id)\\n        };\\n        for _ in 0..120 {\\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\\n            if !alive {\\n                break;\\n            }\\n            sim.step(&hand(x, z, SUCTION, true));\\n        }\\n        assert!(!game(&sim).hazards.iter().any(|h| h.id == id && h.alive), \\\"pool stayed {}\\\", status(&sim));\\n    }\\n    let chain = game(&sim).best_chain();\\n    assert!(chain >= 5, \\\"chain {chain}\\\");\\n    assert_eq!(chain_mul(5), 1.25);\\n    assert_eq!(chain_mul(10), 1.5);\\n    assert_eq!(chain_mul(20), 2.0);\\n}\\n\\n#[test]\\nfn beat_window_code_window_and_checkpoint_retry() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    {\\n        let g = game(&sim);\\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\\n        assert!((g.heart.bpm - expect).abs() < 0.05, \\\"bpm {} vs {expect}\\\", g.heart.bpm);\\n    }\\n    let mut saw_on = false;\\n    let mut saw_off = false;\\n    for _ in 0..240 {\\n        sim.step(&InputFrame::default());\\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\\n        saw_on |= on;\\n        saw_off |= !on;\\n    }\\n    assert!(saw_on && saw_off, \\\"on-beat window never changed\\\");\\n    let _ = Heart::new(80.0);\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\\n    assert!(game(&sim).heart.flat, \\\"code did not start\\\");\\n    assert!(game(&sim).code_t > 0.0);\\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"missed code {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    for _ in 0..40 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let vitals = game(&sim).heart.vitals;\\n    assert!(vitals > 20.0, \\\"already dead before the kill\\\");\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n    sim.step(&cmd(SurgeryCmd::Retry));\\n    assert_eq!(sim.outcome(), Outcome::Playing, \\\"retry {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 3, \\\"back in the operation\\\");\\n    assert!(game(&sim).heart.vitals > 20.0, \\\"checkpoint vitals {}\\\", game(&sim).heart.vitals);\\n}\\n\\n#[test]\\nfn story_lines_are_filled_and_music_defaults_quiet() {\\n    let lines = all_lines();\\n    assert!(lines.len() >= 150, \\\"story lines {}\\\", lines.len());\\n    let banned = [\\\"Hope Hospital\\\", \\\"Caduceus\\\", \\\"Stiles\\\", \\\"GUILT\\\", \\\"Healing Touch\\\"];\\n    for line in &lines {\\n        assert!(!line.text.trim().is_empty(), \\\"empty line from {}\\\", line.who);\\n        assert!(!line.who.trim().is_empty());\\n        let blob = format!(\\\"{} {}\\\", line.who, line.text);\\n        assert!(!blob.contains(\\\"TODO\\\"), \\\"{blob}\\\");\\n        for word in banned {\\n            assert!(!blob.contains(word), \\\"{word} in {blob}\\\");\\n        }\\n    }\\n    for name in TOOL_NAMES.iter().chain(SURGEON_NAMES.iter()).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\\n        for word in banned {\\n            assert!(!name.contains(word), \\\"{word} in {name}\\\");\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Hands of Harbor: Second Opinion\\\");\\n    let sim = Sim::new(\\\"surgery/title\\\", 1).unwrap();\\n    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\\n    assert_eq!(rank_of(900, 900), 4);\\n    assert_eq!(rank_of(1035, 900), 5);\\n    assert_eq!(rank_of(449, 900), 0);\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"94513838-6b2a-40ff-97bd-73c2f1d79ac0"}
