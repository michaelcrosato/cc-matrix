t0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":188,\"content\":\"t=1409 ph=0 tool=1 cur=(1.33,0.20) use=true mis=24 vit=27 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":189,\"content\":\"t=1440 ph=0 tool=1 cur=(1.33,0.20) use=true mis=24 vit=26 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":190,\"content\":\"t=1458 ph=0 tool=1 cur=(1.33,0.20) use=true mis=25 vit=24 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":191,\"content\":\"t=1507 ph=0 tool=1 cur=(1.33,0.20) use=true mis=26 vit=21 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":192,\"content\":\"t=1556 ph=0 tool=1 cur=(1.33,0.20) use=true mis=27 vit=18 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":193,\"content\":\"t=1560 ph=0 tool=1 cur=(1.33,0.20) use=true mis=27 vit=18 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":194,\"content\":\"t=1605 ph=0 tool=1 cur=(1.33,0.20) use=true mis=28 vit=15 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":195,\"content\":\"t=1654 ph=0 tool=1 cur=(1.33,0.20) use=true mis=29 vit=12 heat=false ang=0.00 [k6 st1 tl1 w=0.00/0.80 ax=0.00 g=true aux=0.00 (0.01,0.10)] [k2 st0 tl3 w=0.00/0.70 ax=0.00 g=false aux=0.00 (1.65,0.90)] \"},{\"line_number\":19