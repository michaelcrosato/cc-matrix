       return super::View::idle();\\n            };\\n            if !flag(&hub, \\\"active\\\") {\\n                return super::View::idle();\\n            }\\n            if !self.joined {\\n                if let Some(info) = json_field(&hub, \\\"info\\\") {\\n                    self.take_info(&info);\\n                }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_app/src/hub.rs\",\"offset\":70,\"limit\":100,\"raw_output\":\"\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\npub struct Link;\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl Link {\\n    pub fn new() -> Self {\\n        Self\\n    }\\n    pub fn poll(&mut self, _dt: f32) -> View {\\n        View::idle()\\n    }\\n    pub fn send_input(&mut self, _hand: &SurgeonInput) {}\\n    pub fn send_snap(&mut self, _body: &str) -> bool {\\n        false\\n    }\\n    pub fn publish(&mut self, _body: &str) {}\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nmod js {\\n    use super::{Dom, Snap};\\n    use pav_core::input::{surg, SurgeonInput};\\n    use wasm_bindgen::JsCast;\\n\\n    pub struct Link {\\n        pub joined: bool,\\n        pub readied: bool,\\n        pub server: bool,\\n        pub host: bool,\\n        pub play: bool,\\n        pub ended: bool,\\n        pub booted: bool,\\n        pub slot: u8,\\n        pub seed: u32,\\n        pub names: Vec<(u8, String)>,\\n        pub present: Vec<u8>,\\n        pub ready_ids: Vec<u8>,\\n        pub remote: [Option<SurgeonInput>; 4],\\n        pub remote_age: [f32; 4],\\n        pub remote_seq: [u32; 4],\\n        pub card_lines: Vec<String>,\\n        pub pending_snap: Option<Snap>,\\n        pub send_acc: f32,\\n        pub seq: u32,\\n        pub prev_held: u32,\\n        pub prev_tool: u8,\\n        pub latch_pressed: u32,\\n        pub latch_left: u8,\\n        pub snap_acc: f32,