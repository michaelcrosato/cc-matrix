s {}\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n            Screen::Hud => {\\n                v.push(\\\"OPERATION\\\".into());\\n            }\\n            Screen::Story => v.push(\\\"Advance\\\".into()),\\n            Screen::Results => v.push(\\\"Results\\\".into()),\\n            Screen::Dead => v.push(self.row(0, \\\"Retry\\\")),\\n            Screen::Card => {\\n                v.push(\\\"Pre-op\\\".into());\\n                v.push(\\\"Keep the patient alive\\\".into());\\n                v.extend(self.card_lines.clone());\\n                v.push(format!(\\\"{} ready\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n            Screen::Chart => {\\n                v.push(\\\"Chart\\\".into());\\n                v.push(\\\"Begin the operation\\\".into());\\n                v.push(format!(\\\"{} begin\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n        }\\n        v\\n    }\\n\",\"total_lines\":950}}","is_error":false},{"type":"tool_result","tool_use_id":"call-b94eb7b3-fbe2-4bbd-9319-33a915aa06b6-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"800→    }) as Box<dyn Fn() -> wasm_bindgen::JsValue>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"status\\\".into(), status.as_ref().unchecked_ref());\\n    status.forget();\\n    let step = wasm_bindgen::closure::Closure::wrap(Box::new(|n: u32| {\\n        BURST.with(|b| b.set(b.get().saturating_add(n)));\\n    }) as Box<dyn Fn(u32)>);\\n    let _ = js_sys::Reflect::set(&obj, &\\\"step\\\".into(), step.as_ref().unchecked_ref());\\n    step.forget();\\n    let _ = js_sys::Reflect::set(&win, &\\\"__game\\\".into(), &obj);\\n    HOOKED.with(|h| h.set(true));\\n810→    let _ = app;\\n}\\n\\npub fn surgery_event(app: &mut App, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\\n    let consumed = match (&mut app.egui_state, &app.gfx) {\\n        (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\\n        _ => false,\\n    };\\n    let _ = consumed;\\n