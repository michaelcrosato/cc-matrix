ating_points(r: u8) -> i32 {\\n    match r {\\n        R_IMMACULATE => 400,\\n60→        R_CLEAN => 250,\\n        R_GOOD => 120,\\n        _ => 10,\\n    }\\n}\\n\\npub fn rate_error(err: f32, strict: f32) -> u8 {\\n    let e = err.max(0.0) * strict.max(0.25);\\n    if e <= 0.22 {\\n        R_IMMACULATE\\n70→    } else if e <= 0.42 {\\n        R_CLEAN\\n    } else if e <= 0.72 {\\n        R_GOOD\\n    } else {\\n        R_SLOPPY\\n    }\\n}\\n\\npub fn chain_mul(chain: u32) -> f32 {\\n80→    if chain >= 20 {\\n        2.0\\n    } else if chain >= 10 {\\n        1.5\\n    } else if chain >= 5 {\\n        1.25\\n    } else {\\n        1.0\\n    }\\n}\\n90→\\n/// Ranks at 50 / 70 / 85 / 100 / 115 percent of par. 0 is below C.\\npub fn rank_of(score: i32, par: i32) -> u8 {\\n    if par <= 0 {\\n        return 1;\\n    }\\n    let p = score as f32 / par as f32;\\n    if p >= 1.15 {\\n        5\\n    } else if p >= 1.0 {\\n100→        4\\n    } else if p >= 0.85 {\\n        3\\n    } else if p >= 0.70 {\\n        2\\n    } else if p >= 0.50 {\\n        1\\n    } else {\\n        0\\n    }\\n110→}\\n\\npub fn rank_name(r: u8) -> &'static str {\\n    match r {\\n        1 => \\\"C\\\",\\n        2 => \\\"B\\\",\\n        3 => \\\"A\\\",\\n        4 => \\\"S\\\",\\n        5 => \\\"ENCORE\\\",\\n        _ => \\\"\\\",\\n120→    }\\n}\\n\\npub const STRAIN_PHASES: [&str; 18] = [\\n    \\\"introit:wander\\\",\\n    \\\"introit:split\\\",\\n    \\\"introit:smalls\\\",\\n    \\\"introit:amen\\\",\\n    \\\"lacrimosa:wave1\\\",\\n    \\\"lacrimosa:wave2\\\",\\n130→    \\\"lacrimosa:wave3\\\",\\n    \\\"lacrimosa:eye\\\",\\n    \\\"dies:embers\\\",\\n    \\\"dies:merge\\\",\\n    \\\"dies:furnace\\\",\\n    \\\"libera:a\\\",\\n    \\\"libera:b\\\",\\n    \\\"libera:c\\\",\\n    \\\"libera:stop\\\",\\n    \\\"libera:soloist\\\",\\n140→    \\\"libera:tendril\\\",\\n    \\\"libera:close\\\",\\n];\\n\\npub fn strain_phase_index(name: &str) -> Option<usize> {\\n    STRAIN_PHASES.iter(