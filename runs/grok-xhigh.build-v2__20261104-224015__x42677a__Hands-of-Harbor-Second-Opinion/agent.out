at the player's feet (0 = off), the height over\\n    /// which it thins out, sunlight scattered in it (light shafts where shadows cut it), how\\n    /// much of that light heads on toward the sun's side, and lamp halos.\\n    pub haze: f32,\\n    pub haze_height: f32,\\n380→    pub shafts: f32,\\n    pub shafts_forward: f32,\\n    pub halos: f32,\\n    /// Wind for foliage and grass: strength (0 = still), the compass direction it blows\\n    /// toward (degrees), how fast gusts roll across, and grass parting around the player.\\n    pub wind: f32,\\n    pub wind_angle: f32,\\n    pub wind_gusts: f32,\\n    pub grass_push: bool,\\n    /// Rippling water: on, wave speed (m/s), seconds for a ripple to halve, raindrops per m²\\n390→    /// per second.\\n    pub water_ripples: bool,\\n    pub water_speed: f32,\\n    pub water_fade: f32,\\n    pub water_rain: f32,\\n    pub sky: String,\\n    pub fog: bool,\\n    pub fog_start: f32,\\n    pub fog_end: f32,\\n    pub light: LightSettings,\\n400→    pub cutaway: CutawaySettings,\\n    pub filter: FilterSettings,\\n    /// How much of each procedural material is drawn: every layer, the first only, or none.\\n    pub material_detail: crate::materials::MaterialDetail,\\n}\\n\\nimpl Default for ViewSettings {\\n    fn default() -> Self {\\n        Self {\\n            style: StyleOverride::PerObject,\\n410→            style_objects: StyleOverride::PerObject,\\n            style_environment: StyleOverride::PerObject,\\n            outlines: true,\\n            outlines_on: PartChoice::All,\\n            outline_px: 1.0,\\n            outline_darken: 0.35,\\n            cel_bands: 2.0,\\n            flat_shadow: 0.62,\\n            rim: 0.25,\\n            specular: 0.35,\\n420→            exposure: 1.0,\\n            tonemap: TonemapChoice::SoftKnee,\\n            saturation: 1.0,\\n            bloom: 0.35,\\n            bloom_threshold: 1.2,\\n            distortion: true,\\n            particles: true,\\n            gi: 0.0,\