 status(&sim)));\n    }\n    {\n        let mut sim = Sim::new(\"surgery/campaign\", 1).unwrap();\n        let (o, t) = sim.run_bot(60 * 2200);\n        lines.push(format!(\"camp {o:?} t={t} {}\", status(&sim)));\n    }\n    let dump = lines.join(\"\\n\");\n    eprintln!(\"{dump}\");\n    assert!(lines.iter().all(|l| l.contains(\"Won\")), \"{dump}\");\n}"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2330,"output_tokens":789,"cache_read_input_tokens":89472,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"fd311c48-21c3-4d5d-914b-eec374f9193c"}
