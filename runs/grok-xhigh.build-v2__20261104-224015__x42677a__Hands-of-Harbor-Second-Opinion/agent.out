   x: f32,\\n    z: f32,\\n    tool: u8,\\n    focus: Option<u32>,\\n    just_release: bool,\\n    use_held: bool,\\n660→) -> Option<usize> {\\n    if just_release || use_held {\\n        if let Some(id) = focus {\\n            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\\n                let h = &hazards[i];\\n                // A pull travels away from the wound. Keep the grabbed hazard, or the\\n                // one this tool is already working, so a neighbor does not steal it.\\n                if h.grabbed || (use_held && h.accepts(tool) && h.dist(x, z) < h.radius + 2.6) || just_release {\\n                    return Some(i);\\n                }\\n670→            }\\n        }\\n    }\\n    if tool == IV {\\n        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\\n            return Some(i);\\n        }\\n    }\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n680→    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\",\"content_concise\":\"620→            let mut h = Hazard::make(K_FOREIGN, -1.0, 0.9);\\n            h.hidden = true;\\n            h.drain = 0.4;\\n            h.id = g.next_id;\\n            g.next_id += 1;\\n            g.hazards.push(h);\\n        }\\n        3 => {\\n            g.spawn_kind_at(K_SAC, -0.6, 0.5, 0.25);\\n            g.spawn_kind_at(K_SAC, 1.1, 0.2, 0.25);\\n630→        }\\n        4 => {\\n            g.spawn_kind_at(K_EMBER, -0.3, 0.6, 0.3);\\n            g.spawn_kind_at(K_BURN, 1.2, -0.7, 0.3);\\n        }\\n        _ => {\\n            g.spawn_kind_at(K_INCISION, -1.8, 0.4, 0.0);\\n            g.spawn_kind_at(K_DRESSING, 0.6, -1.0, 0.1);\\n        }\\n    }\\n640→    if extra >= 1 {\\n        g.spawn_kind_at(K_POOL, -1.6, -1.1, 0.4);\\n    }\\n    if extra >= 2 {\\n        g.spawn_kind_at(K_LACERATION, 1.6, 1.0, 0.6);\\n    }\\n    if extra >= 3 {\\n        g.spawn_kind_at(K_BLEEDER, 0.0, 1.3, 1.4);\\n    }\\n    let _ = sim;\\n650→}\\n\\nfn select(\\n    hazards: &[Hazard],\\n    x: f32,\\n    z: f32,\\n    tool: u8,\\n    focus: Option<u32>,\\n    just_release: bool,\\n    use_held: bool,\\n660→) -> Option<usize> {\\n    if just_release || use_held {\\n        if let Some(id) = focus {\\n            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\\n                let h = &hazards[i];\\n                // A pull travels away from the wound. Keep the grabbed hazard, or the\\n                // one this tool is already working, so a neighbor does not steal it.\\n                if h.grabbed || (use_held && h.accepts(tool) && h.dist(x, z) < h.radius + 2.6) || just_release {\\n                    return Some(i);\\n                }\\n670→            }\\n        }\\n    }\\n    if tool == IV {\\n        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\\n            return Some(i);\\n        }\\n    }\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n680→    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"offset\":620,\"limit\":70,\"raw_output\":\"            let mut h = Hazard::make(K_FOREIGN, -1.0, 0.9);\\n            h.hidden = true;\\n            h.drain = 0.4;\\n            h.id = g.next_id;\\n            g.next_id += 1;\\n            g.hazards.push(h);\\n        }\\n        3 => {\\n            g.spawn_kind_at(K_SAC, -0.6, 0.5, 0.25);\\n            g.spawn_kind_at(K_SAC, 1.1, 0.2, 0.25);\\n        }\\n        4 => {\\n            g.spawn_kind_at(K_EMBER, -0.3, 0.6, 0.3);\\n            g.spawn_kind_at(K_BURN, 1.2, -0.7, 0.3);\\n        }\\n        _ => {\\n            g.spawn_kind_at(K_INCISION, -1.8, 0.4, 0.0);\\n            g.spawn_kind_at(K_DRESSING, 0.6, -1.0, 0.1);\\n        }\\n    }\\n    if extra >= 1 {\\n        g.spawn_kind_at(K_POOL, -1.6, -1.1, 0.4);\\n    }\\n    if extra >= 2 {\\n        g.spawn_kind_at(K_LACERATION, 1.6, 1.0, 0.6);\\n    }\\n    if extra >= 3 {\\n        g.spawn_kind_at(K_BLEEDER, 0.0, 1.3, 1.4);\\n    }\\n    let _ = sim;\\n}\\n\\nfn select(\\n    hazards: &[Hazard],\\n    x: f32,\\n    z: f32,\\n    tool: u8,\\n    focus: Option<u32>,\\n    just_release: bool,\\n    use_held: bool,\\n) -> Option<usize> {\\n    if just_release || use_held {\\n        if let Some(id) = focus {\\n            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\\n                let h = &hazards[i];\\n                // A pull travels away from the wound. Keep the grabbed hazard, or the\\n                // one this tool is already working, so a neighbor does not steal it.\\n                if h.grabbed || (use_held && h.accepts(tool) && h.dist(x, z) < h.radius + 2.6) || just_release {\\n                    return Some(i);\\n                }\\n            }\\n        }\\n    }\\n    if tool == IV {\\n        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\\n            return Some(i);\\n        }\\n    }\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n\",\"total_lines\":805}}","is_