i.saturating_add(1);\\n                    cue(events, CUE_VOICE, 0.0, 0.0, 0.7, 0.9 + (g.story_i as f32 % 5.0) * 0.04);\\n                }\\n30→            }\\n            return;\\n        }\\n        M_CHART if !had_cmd => {\\n            if confirmed(input) {\\n                g.mode = M_OP;\\n                g.phase_ready = false;\\n                cue(events, CUE_OK, 0.0, 0.0, 0.6, 1.0);\\n            }\\n            return;\",\"content_concise\":\"15→pub fn tick(g: &mut Surgery, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>, had_cmd: bool) {\\n    if g.outcome == Outcome::Lost && g.mode == M_DEAD {\\n        return;\\n    }\\n    let dt = dt.max(0.0);\\n20→    match g.mode {\\n        M_STORY if !had_cmd => {\\n            if confirmed(input) {\\n                let lines = story::block(g.case_id, g.story_after);\\n                if (g.story_i as usize) + 1 >= lines.len() {\\n                    g.end_story();\\n                } else {\\n                    g.story_i = g.story_i.saturating_add(1);\\n                    cue(events, CUE_VOICE, 0.0, 0.0, 0.7, 0.9 + (g.story_i as f32 % 5.0) * 0.04);\\n                }\\n30→            }\\n            return;\\n        }\\n        M_CHART if !had_cmd => {\\n            if confirmed(input) {\\n                g.mode = M_OP;\\n                g.phase_ready = false;\\n                cue(events, CUE_OK, 0.0, 0.0, 0.6, 1.0);\\n            }\\n            return;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"offset\":15,\"limit\":25,\"raw_output\":\"pub fn tick(g: &mut Surgery, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>, had_cmd: bool) {\\n    if g.outcome == Outcome::Lost && g.mode == M_DEAD {\\n        return;\\n    }\\n    let dt = dt.max(0.0);\\n    match g.mode {\\n        M_STORY if !had_cmd => {\\n            if confirmed(input) {\\n                let lines = story::block(g.case_id, g.story_after);\\n                if (g.story_i as usize) + 1 >= lines.len() {\\n                    g.end_story();\\n                } else {\\n                    g.story_i = g.story_i.saturating_add(1);\\n                    cue(events, CUE_VOICE, 0.0, 0.0, 0.7, 0.9 + (g.story_i as f32 % 5.0) * 0.04);\\n                }\\n            }\\n            return;\\n        }\\n        M_CHART if !had_cmd => {\\n            if confirmed(input) {\\n                g.mode = M_OP;\\n                g.phase_ready = false;\\n                cue(events, CUE_OK, 0.0, 0.0, 0.6, 1.0);\\n            }\\n            return;\\n\",\"total_lines\":747}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"1bd5dc01-3792-43bd-8cd8-089c006d04e1"}
