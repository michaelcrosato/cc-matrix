7,103,97,109,101,115,47,115,117,114,103,101,114,121,47,107,105,110,100,115,46,114,115,10,50,52,58,112,117,98,32,99,111,110,115,116,32,75,95,76,65,67,69,82,65,84,73,79,78,58,32,117,56,32,61,32,49,59,10,49,53,53,58,32,32,32,32,32,32,32,32,75,95,76,65,67,69,82,65,84,73,79,78,32,124,32,75,95,66,76,69,69,68,69,82,32,61,62,32,83,85,84,85,82,69,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":40,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/bot.rs\",\"matches\":[{\"line_number\":37,\"content\":\"    let avoid = if slot == 0 { None } else { game.surgeons[0].focus };\"},{\"line_number\":60,\"content\":\"    if me.focus == Some(h.id) && me.focus_t > 2.2 && skill > 0.3 {\"},{\"line_number\":61,\"content\":\"        let a = me.focus_t * 2.4;\"},{\"line_number\":79,\"content\":\"    } else if h.kind == K_BONE && h.stage == 0 && h.aux.abs() >= 12.0 {\"},{\"line_number\":90,\"content\":\"    if h.kind == K_BONE && h.stage == 0 && h.aux > 12.0 {\"},{\"line_number\":92,\"content\":\"    } else if h.kind == K_BONE && h.stage == 0 && h.aux < -12.0 {\"},{\"line_number\":157,\"content\":\"        K_NODULE | K_EMBER if h.stage == 0 => true,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"matches\":[{\"line_number\":358,\"content\":\"        let focus = g.surgeons[i].focus;\"},{\"line_number\":359,\"content\":\"        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\"},{\"line_number\":387,\"content\":\"            if g.surgeons[i].focus == Some(id) {\"},{\"line_number\":389,\"content\":\"                    g.surgeons[i].focus_t = 0.0;\"},{\"line_number\":391,\"content\":\"                    g.surgeons[i].focus_t += dt;\"},{\"line_number\":394,\"content\":\"                g.surgeons[i].focus = Some(id);\"},{\"line_number\":395,\"content\":\"                g.surgeons[i].focus_t = 0.0;\"},{\"line_number\":403,\"content\":\"                if let Some(w) = nearest_wrong(&g.hazards, x, z, tool) {\"},{\"line_number\":424,\"content\":\"        if let Some(id) = s.focus {\"},{\"line_number\":561,\"content\":\"    let skip = g.surgeons[0].focus;\"},{\"line_number\":611,\"content\":\"            g.spawn_kind_at(K_LACERATION, -1.2, 0.2, 0.8);\"},{\"line_number\":644,\"content\":\"        g.spawn_kind_at(K_LACERATION, 1.6, 1.0, 0.6);\"},{\"line_number\":657,\"content\":\"    focus: Option<u32>,\"},{\"line_number\":662,\"content\":\"        if let Some(id) = focus {\"},{\"line_number\":693,\"content\":\"fn nearest_wrong(hazards: &[Hazard], x: f32, z: f32, tool: u8) -> Option<usize> {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/mod.rs\",\"matches\":[{\"line_number\":71,\"content\":\"    pub focus: Option<u32>,\"},{\"line_number\":72,\"content\":\"    pub focus_t: f32,\"},{\"line_number\":96,\"content\":\"            focus: None,\"},{\"line_number\":97,\"content\":\"            focus_t: 0.0,\"},{\"line_number\":617,\"content\":\"            s.focus_t = 0.0;\"},{\"line_number\":998,\"content\":\"    sim.state.focus = Vec3::new(0.0, 0.0, 0.2);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/content.rs\",\"matches\":[{\"line_number\":50,\"content\":\"    s(K_LACERATION, -1.4, 0.2, false, 1.7, 0.3),\"},{\"line_number\":92,\"content\":\"    s(K_LACERATION, 0.0, 0.25, false, 0.85, 0.4),\"},{\"line_number\":142,\"content\":\"    s(K_LACERATION, -1.75, -0.75, false, 0.95, 0.5),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs\",\"matches\":[{\"line_number\":99,\"content\":\"            K_LACERATION => {\"},{\"line_number\":335,\"content\":\"        K_TUMOR if h.stage == 0 => {\"},{\"line_number\":367,\"content\":\"        K_LACERATION | K_BLEEDER => {\"},{\"line_number\":410,\"content\":\"        K_POLYP | K_NODULE | K_EMBER if h.stage == 0 && (h.kind != K_EMBER || h.tool == CRYO) => {\"},{\"line_number\":430,\"content\":\"        K_BONE if h.stage == 0 => {\"},{\"line_number\":616,\"content\":\"        K_TUMOR if h.stage == 0 => {\"},{\"line_number\":620,\"content\":\"        K_LACERATION | K_BLEEDER | K_BONE if h.stage >= 1 || h.kind != K_BONE => {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/kinds.rs\",\"matches\":[{\"line_number\":24,\"content\":\"pub const K_LACERATION: u8 = 1;\"},{\"line_number\":155,\"content\":\"        K_LACERATION | K_BLEEDER => SUTURE,\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-68018fc4-9d3d-46d4-bedb-20757181d5d5-39","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→    }\\n}\\n\\nfn hands(g: &mut Surgery, slots: &[SurgeonInput; 4], rules: f32, dt: f32, tick: u64, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let mut inp = slots[i];\\n        if inp.held & surg::AIM_ABSOLUTE == 0 {\\n            if inp.held & surg::PRECISION != 0 {\\n                inp.aim *= 0.35;\\n            }\\n310→            inp.aim = assist_aim(g, g.surgeons[i].x, g.surgeons[i].z, g.surgeons[i].tool, inp.aim, dt);\\n        }\\n        let lead = i == 0;\\n        if !inp.active && !lead {\\n            continue;\\n        }\\n        if lead {\\n            g.surgeons[0].active = true;\\n        }\\n        if inp.active {\\n320→            if inp.tool != TOOL_KEEP {\\n                g.surgeons[i].tool = inp.tool.min(DEFIB);\\n            }\\n            steer(&mut g.surgeons[i], inp, dt, g.tune.cursor_speed);\\n        }\\n        g.surgeons[i].x = g.surgeons[i].x.clamp(X_MIN, X_MAX);\\n        g.surgeons[i].z = g.surgeons[i].z.clamp(Z_MIN, Z_MAX);\\n        g.surgeons[i].wrong_cd = (g.surgeons[i].wrong_cd - dt).max(0.0);\\n        g.surgeons[i].iv_cd = (g.surgeons[i].iv_cd - dt).max(0.0);\\n        g.surgeons[i].since_chain += dt;\\n330→\\n        let (mut x, mut z) = (g.surgeons[i].x, g.surgeons[i].z);\\n        let precise = inp.held & surg::PRECISION != 0;\\n        let echo = g.echo_left > 0.0;\\n        if i == 0 && !precise && !echo && g.tune.tremor > 0.0 {\\n            let w = 0.12 * g.tune.tremor;\\n            let t = tick as f32;\\n            x += (t * 0.73).sin() * w;\\n            z += (t * 0.51).cos() * w;\\n        }\\n340→        let use_held = inp.held & surg::USE != 0;\\n        let just_release = g.surgeons[i].was_use && !use_held;\\n        let tool = g.surgeons[i].tool;\\n        if g.heat_on && use_held && heat_hit(g.heat_angle, x, z) {\\n            g.heart.vitals = (g.heart.vitals - 8.0).max(0.0);\\n            g.surgeons[i].chain = 0;\\n            g.mistakes = g.mistakes.saturating_add(1);\\n            g.callout_i = 4;\\n            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n350→        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n360→        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\\n                tool,\\n                use_held,\\n370→                just_release,\\n                inp.pressure,\\n                rot,\\n                rules,\\n                g.tune.tool_power,\\n                g.heart.diastole() || g.duet_left > 0.0,\\n                g.tune.rating_strict,\\n            );\\n            if g.one_hit && hit.engaged && g.hazards[idx].accepts(tool) && tool != SCANNER {\\n                hit.done = true;\\n380→                hit.rating = R_IMMACULATE;\\n                g.hazards[idx].alive = false;\\n            }\\n            if was_hidden && !g.hazards[idx].hidden {\\n                g.coverage.tools[SCANNER as usize] = g.coverage.tools[SCANNER as usize].saturating_add(1);\\n            }\\n            let grew = g.hazards[idx].work > before + 0.0001 || hit.done;\\n            if g.surgeons[i].focus == Some(id) {\\n                if grew {\\n                    g.surgeons[i].focus_t = 0.0;\\n390→                } else {\\n                    g.surgeons[i].focus_t += dt;\\n                }\\n            } else {\\n                g.surgeons[i].focus = Some(id);\\n                g.surgeons[i].focus_t = 0.0;\\n            }\\n            if hit.engaged {\\n                g.hazards[idx].idle = 0.0;\\n            }\\n400→            if hit.done {\\n                resolve_done(g, i, idx, hit, events);\\n            } else if use_held && !hit.engaged && g.surgeons[i].wrong_cd <= 0.0 && tool != SCANNER && tool != DEFIB {\\n                if let Some(w) = nearest_wrong(&g.hazards, x, z, tool) {\\n                    let _ = w;\\n                    g.surgeons[i].chain = 0;\\n                    g.surgeons[i].wrong_cd = 0.8;\\n                    g.mistakes = g.mistakes.saturating_add(1);\\n                    g.heart.vitals = (g.heart.vitals - 2.0 * g.tune.wrong_penalty).max(0.0);\\n                    g.callout_i = if tool == SCALPEL { 1 } else { 3 };\\n410→                    g.callout_t = 1.2;\\n                    cue(events, CUE_WRONG, x, z, 0.55, 1.0);\\n                }\\n            }\\n            if hit.cue != 0 && (hit.done || tick % 8 == 0) {\\n                cue(events, hit.cue, x, z, 0.45, 1.0);\\n            }\\n        }\\n        gift_edge(g, i, inp, dt);\\n        g.surgeons[i].was_use = use_held;\\n420→    }\\n    let mut busy = [0u32; 8];\\n    let mut n = 0;\\n    for s in &g.surgeons {\\n        if let Some(id) = s.focus {\\n            if n < busy.len() {\\n                busy[n] = id;\\n                n += 1;\\n            }\\n        }\\n430→    }\\n    for h in &mut g.hazards {\\n        if busy[..n].contains(&h.id) && h.idle == 0.0 {\\n            continue;\\n        }\\n        h.idle += rules;\\n        if h.idle > 0.4 && !matches!(h.kind, K_BONE | K_SAC | K_HEAT | K_IV) {\\n            h.work = (h.work - rules * 0.45).max(0.0);\\n        }\\n    }\\n440→}\\n\\nfn resolve_done(g: &mut Surgery, slot: usize, idx: usize, hit: Hit, events: &mut Vec<SimEvent>) {\\n    let kind = g.hazards[idx].kind;\\n    let hx = g.hazards[idx].x;\\n    let hz = g.hazards[idx].z;\\n    let tool = g.surgeons[slot].tool as usize;\\n    if kind == K_IV && hit.rating != R_SLOPPY {\\n        g.hazards[idx].alive = false;\\n    }\\n450→    if hit.heal != 0.0 && g.surgeons[slot].iv_cd <= 0.0 {\\n        g.heart.vitals = (g.heart.vitals + hit.heal * g.tune.iv_heal).clamp(0.0, 100.0);\\n        if hit.heal > 0.0 {\\n            g.surgeons[slot].iv_cd = 8.0;\\n        }\\n    }\\n    let rating = hit.rating.min(3);\\n    g.coverage.ratings[rating as usize] = g.coverage.ratings[rating as usize].saturating_add(1);\\n    if tool < N_TOOLS {\\n        g.coverage.tools[tool] = g.coverage.tools[tool].saturating_add(1);\\n460→    }\\n    g.last_tool = g.surgeons[slot].tool;\\n    g.last_rating = rating;\\n    g.last_id = g.hazards[idx].id;\\n    g.last_ok = true;\\n    if rating == R_SLOPPY || hit.misuse > 0 {\\n        g.surgeons[slot].chain = 0;\\n        g.mistakes = g.mistakes.saturating_add(1);\\n        g.surgeons[slot].score += rating_points(R_SLOPPY);\\n    } else {\\n470→        let chain = if g.surgeons[slot].since_chain <= g.tune.chain_window && g.surgeons[slot].chain > 0 {\\n            g.surgeons[slot].chain.saturating_add(1)\\n        } else {\\n            1\\n        };\\n        g.surgeons[slot].chain = chain;\\n        g.surgeons[slot].best_chain = g.surgeons[slot].best_chain.max(chain);\\n        g.surgeons[slot].since_chain = 0.0;\\n        let pts = (rating_points(rating) as f32 * chain_mul(chain) * g.tune.score_mul).round() as i32;\\n        g.surgeons[slot].score += pts;\\n480→        if chain == 5 || chain == 10 || chain == 20 {\\n            cue(events, CUE_CHAIN, hx, hz, 0.6, 1.0 + chain as f32 * 0.01);\\n        }\\n        let mut meter = match rating {\\n            R_IMMACULATE => 8.0,\\n            R_CLEAN => 4.0,\\n            _ => 0.0,\\n        };\\n        if g.heart.on_beat(g.tune.beat_window_ms) {\\n            meter += 2.0;\\n490→            cue(events, CUE_BEAT, hx, hz, 0.4, 1.2);\\n        }\\n        g.surgeons[slot].meter = (g.surgeons[slot].meter + meter * g.tune.gift_gain).min(100.0);\\n    }\\n    if !g.hazards[idx].alive {\\n        note_kind(g, kind);\\n    }\\n    push_popup(g, rating, hx, hz);\\n    cue(events, CUE_RATE, hx, hz, 0.5, 1.0 + (3 - rating) as f32 * 0.08);\\n    if rating == R_IMMACULATE {\\n500→        g.callout_i = 0;\\n        g.callout_t = g.callout_t.max(0.8);\\n    }\\n}\\n\\nfn gift_edge(g: &mut Surgery, slot: usize, inp: SurgeonInput, dt: f32) {\\n    if slot != 0 {\\n        return;\\n    }\\n    let held = inp.held & surg::GIFT != 0;\\n510→    if held {\\n        g.surgeons[0].gift_arm += dt;\\n    } else if g.surgeons[0].was_gift {\\n        let armed = g.surgeons[0].gift_arm >= 0.12;\\n        let on = g.heart.on_beat(g.tune.beat_window_ms);\\n        if armed && on && g.surgeons[0].meter >= 100.0 && !g.heart.flat {\\n            let bit = g.pending_gift();\\n            g.activate_gift(bit);\\n        }\\n        g.surgeons[0].gift_arm = 0.0;\\n520→    }\\n    g.surgeons[0].was_gift = held;\\n}\\n\\nfn defib_only(g: &mut Surgery, slots: &[SurgeonInput; 4], dt: f32, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let inp = slots[i];\\n        if !inp.active && i != 0 {\\n            continue;\\n        }\\n530→        if i == 0 {\\n            g.surgeons[0].active = true;\\n        }\\n        if inp.tool != TOOL_KEEP && inp.active {\\n            g.surgeons[i].tool = inp.tool.min(DEFIB);\\n        }\\n        let held = inp.held & surg::DEFIB != 0 || (g.surgeons[i].tool == DEFIB && inp.held & surg::USE != 0);\\n        if held {\\n            g.surgeons[i].defib += dt;\\n            if g.surgeons[i].defib > 0.2 && (g.surgeons[i].defib * 10.0) as u32 % 8 == 0 {\\n540→                cue(events, CUE_WHINE, g.surgeons[i].x, g.surgeons[i].z, 0.3, 0.8 + g.surgeons[i].defib);\\n            }\\n        } else if g.surgeons[i].was_defib {\\n            let c = g.surgeons[i].defib;\\n            if (1.12..=2.6).contains(&c) && g.heart.ghost_on_beat(g.tune.beat_window_ms) {\\n                cue(events, CUE_THUMP, 0.0, 0.0, 0.9, 1.0);\\n                g.resuscitate();\\n                return;\\n            }\\n            g.surgeons[i].defib = 0.0;\\n550→        }\\n        g.surgeons[i].was_defib = held;\\n    }\\n}\\n\\nfn echo_copy(g: &mut Surgery, events: &mut Vec<SimEvent>) {\\n    if g.echo_left <= 0.0 || g.echo_cool > 0.0 || !g.last_ok {\\n        return;\\n    }\\n    let tool = g.last_tool;\\n560→    let rating = g.last_rating;\\n    let skip = g.surgeons[0].focus;\\n    let found = g.hazards.iter().position(|h| {\\n        h.alive && h.kind != K_HEAT && h.tool == tool && Some(h.id) != skip && h.id != g.last_id\\n    });\\n    let Some(idx) = found else { return };\\n    let kind = g.hazards[idx].kind;\\n    let x = g.hazards[idx].x;\\n    let z = g.hazards[idx].z;\\n    g.hazards[idx].alive = false;\\n570→    g.echo_x = x;\\n    g.echo_z = z;\\n    g.echo_on = true;\\n    g.echo_cool = 1.15;\\n    g.last_id = g.hazards[idx].id;\\n    note_kind(g, kind);\\n    if (tool as usize) < N_TOOLS {\\n        g.coverage.tools[tool as usize] = g.coverage.tools[tool as usize].saturating_add(1);\\n    }\\n    g.coverage.ratings[rating as usize] = g.coverage.ratings[rating as usize].saturating_add(1);\\n580→    let pts = (rating_points(rating) as f32 * g.tune.score_mul) as i32;\\n    g.surgeons[0].score += pts;\\n    push_popup(g, rating, x, z);\\n    cue(events, CUE_PING, x, z, 0.45, 1.4);\\n}\\n\\nfn tick_blue(g: &mut Surgery, sim: &mut Sim, dt: f32) {\\n    if g.timer <= 32.0 && !g.blue_finale {\\n        g.blue_finale = true;\\n        g.spawn_kind_at(K_NODULE, -0.8, 0.4, 0.35);\\n590→        g.spawn_kind_at(K_NODULE, 0.9, -0.3, 0.35);\\n        g.spawn_kind_at(K_POOL, 0.1, 1.0, 0.6);\\n        return;\\n    }\\n    if g.timer <= 32.0 {\\n        return;\\n    }\\n    let quiet = g.hazards.iter().all(|h| !h.alive || h.kind == K_HEAT);\\n    if !quiet {\\n        return;\\n600→    }\\n    g.blue_t += dt;\\n    if g.blue_t < 18.0 {\\n        return;\\n    }\\n    g.blue_t = 0.0;\\n    g.blue_wave = g.blue_wave.wrapping_add(1);\\n    let wave = g.blue_wave;\\n    let extra = (g.players.saturating_sub(1)).min(3);\\n    match wave % 6 {\\n610→        0 => {\\n            g.spawn_kind_at(K_LACERATION, -1.2, 0.2, 0.8);\\n            g.spawn_kind_at(K_POOL, 1.3, -0.4, 0.55);\\n        }\\n        1 => {\\n            g.spawn_kind_at(K_POLYP, 0.4, 0.8, 0.3);\\n            g.spawn_kind_at(K_INFLAM, -1.4, -0.6, 0.35);\\n        }\\n        2 => {\\n            g.spawn_kind_at(K_BLEEDER, 0.2, -0.2, 1.8);\",\"content_concise\":\"300→    }\\n}\\n\\nfn hands(g: &mut Surgery, slots: &[SurgeonInput; 4], rules: f32, dt: f32, tick: u64, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let mut inp = slots[i];\\n        if inp.held & surg::AIM_ABSOLUTE == 0 {\\n            if inp.held & surg::PRECISION != 0 {\\n                inp.aim *= 0.35;\\n            }\\n310→            inp.aim = assist_aim(g, g.surgeons[i].x, g.surgeons[i].z, g.surgeons[i].tool, inp.aim, dt);\\n        }\\n        let lead = i == 0;\\n        if !inp.active && !lead {\\n            continue;\\n        }\\n        if lead {\\n            g.surgeons[0].active = true;\\n        }\\n        if inp.active {\\n320→            if inp.tool != TOOL_KEEP {\\n                g.surgeons[i].tool = inp.tool.min(DEFIB);\\n            }\\n            steer(&mut g.surgeons[i], inp, dt, g.tune.cursor_speed);\\n        }\\n        g.surgeons[i].x = g.surgeons[i].x.clamp(X_MIN, X_MAX);\\n        g.surgeons[i].z = g.surgeons[i].z.clamp(Z_MIN, Z_MAX);\\n        g.surgeons[i].wrong_cd = (g.surgeons[i].wrong_cd - dt).max(0.0);\\n        g.surgeons[i].iv_cd = (g.surgeons[i].iv_cd - dt).max(0.0);\\n        g.surgeons[i].since_chain += dt;\\n330→\\n        let (mut x, mut z) = (g.surgeons[i].x, g.surgeons[i].z);\\n        let precise = inp.held & surg::PRECISION != 0;\\n        let echo = g.echo_left > 0.0;\\n        if i == 0 && !precise && !echo && g.tune.tremor > 0.0 {\\n            let w = 0.12 * g.tune.tremor;\\n            let t = tick as f32;\\n            x += (t * 0.73).sin() * w;\\n            z += (t * 0.51).cos() * w;\\n        }\\n340→        let use_held = inp.held & surg::USE != 0;\\n        let just_release = g.surgeons[i].was_use && !use_held;\\n        let tool = g.surgeons[i].tool;\\n        if g.heat_on && use_held && heat_hit(g.heat_angle, x, z) {\\n            g.heart.vitals = (g.heart.vitals - 8.0).max(0.0);\\n            g.surgeons[i].chain = 0;\\n            g.mistakes = g.mistakes.saturating_add(1);\\n            g.callout_i = 4;\\n            g.callout_t = 1.4;\\n            cue(events, CUE_STING, x, z, 0.7, 1.0);\\n350→        }\\n        let rot = if inp.held & surg::ROT_L != 0 {\\n            1\\n        } else if inp.held & surg::ROT_R != 0 {\\n            -1\\n        } else {\\n            0\\n        };\\n        let focus = g.surgeons[i].focus;\\n        let idx = select(&g.hazards, x, z, tool, focus, just_release, use_held);\\n360→        if let Some(idx) = idx {\\n            let id = g.hazards[idx].id;\\n            let before = g.hazards[idx].work;\\n            let was_hidden = g.hazards[idx].hidden;\\n            let mut hit = hazard::apply(\\n                &mut g.hazards[idx],\\n                x,\\n                z,\\n                tool,\\n                use_held,\\n370→                just_release,\\n                inp.pressure,\\n                rot,\\n                rules,\\n                g.tune.tool_power,\\n                g.heart.diastole() || g.duet_left > 0.0,\\n                g.tune.rating_strict,\\n            );\\n            if g.one_hit && hit.engaged && g.hazards[idx].accepts(tool) && tool != SCANNER {\\n                hit.done = true;\\n380→                hit.rating = R_IMMACULATE;\\n                g.hazards[idx].alive = false;\\n            }\\n            if was_hidden && !g.hazards[idx].hidden {\\n                g.coverage.tools[SCANNER as usize] = g.coverage.tools[SCANNER as usize].saturating_add(1);\\n            }\\n            let grew = g.hazards[idx].work > before + 0.0001 || hit.done;\\n            if g.surgeons[i].focus == Some(id) {\\n                if grew {\\n                    g.surgeons[i].focus_t = 0.0;\\n390→                } else {\\n                    g.surgeons[i].focus_t += dt;\\n                }\\n            } else {\\n                g.surgeons[i].focus = Some(id);\\n                g.surgeons[i].focus_t = 0.0;\\n            }\\n            if hit.engaged {\\n                g.hazards[idx].idle = 0.0;\\n            }\\n400→            if hit.done {\\n                resolve_done(g, i, idx, hit, events);\\n            } else if use_held && !hit.engaged && g.surgeons[i].wrong_cd <= 0.0 && tool != SCANNER && tool != DEFIB {\\n                if let Some(w) = nearest_wrong(&g.hazards, x, z, tool) {\\n                    let _ = w;\\n                    g.surgeons[i].chain = 0;\\n                    g.surgeons[i].wrong_cd = 0.8;\\n                    g.mistakes = g.mistakes.saturating_add(1);\\n                    g.heart.vitals = (g.heart.vitals - 2.0 * g.tune.wrong_penalty).max(0.0);\\n                    g.callout_i = if tool == SCALPEL { 1 } else { 3 };\\n410→                    g.callout_t = 1.2;\\n                    cue(events, CUE_WRONG, x, z, 0.55, 1.0);\\n                }\\n            }\\n            if hit.cue != 0 && (hit.done || tick % 8 == 0) {\\n                cue(events, hit.cue, x, z, 0.45, 1.0);\\n            }\\n        }\\n        gift_edge(g, i, inp, dt);\\n        g.surgeons[i].was_use = use_held;\\n420→    }\\n    let mut busy = [0u32; 8];\\n    let mut n = 0;\\n    for s in &g.surgeons {\\n        if let Some(id) = s.focus {\\n            if n < busy.len() {\\n                busy[n] = id;\\n                n += 1;\\n            }\\n        }\\n430→    }\\n    for h in &mut g.hazards {\\n        if busy[..n].contains(&h.id) && h.idle == 0.0 {\\n            continue;\\n        }\\n        h.idle += rules;\\n        if h.idle > 0.4 && !matches!(h.kind, K_BONE | K_SAC | K_HEAT | K_IV) {\\n            h.work = (h.work - rules * 0.45).max(0.0);\\n        }\\n    }\\n440→}\\n\\nfn resolve_done(g: &mut Surgery, slot: usize, idx: usize, hit: Hit, events: &mut Vec<SimEvent>) {\\n    let kind = g.hazards[idx].kind;\\n    let hx = g.hazards[idx].x;\\n    let hz = g.hazards[idx].z;\\n    let tool = g.surgeons[slot].tool as usize;\\n    if kind == K_IV && hit.rating != R_SLOPPY {\\n        g.hazards[idx].alive = false;\\n    }\\n450→    if hit.heal != 0.0 && g.surgeons[slot].iv_cd <= 0.0 {\\n        g.heart.vitals = (g.heart.vitals + hit.heal * g.tune.iv_heal).clamp(0.0, 100.0);\\n        if hit.heal > 0.0 {\\n            g.surgeons[slot].iv_cd = 8.0;\\n        }\\n    }\\n    let rating = hit.rating.min(3);\\n    g.coverage.ratings[rating as usize] = g.coverage.ratings[rating as usize].saturating_add(1);\\n    if tool < N_TOOLS {\\n        g.coverage.tools[tool] = g.coverage.tools[tool].saturating_add(1);\\n460→    }\\n    g.last_tool = g.surgeons[slot].tool;\\n    g.last_rating = rating;\\n    g.last_id = g.hazards[idx].id;\\n    g.last_ok = true;\\n    if rating == R_SLOPPY || hit.misuse > 0 {\\n        g.surgeons[slot].chain = 0;\\n        g.mistakes = g.mistakes.saturating_add(1);\\n        g.surgeons[slot].score += rating_points(R_SLOPPY);\\n    } else {\\n470→        let chain = if g.surgeons[slot].since_chain <= g.tune.chain_window && g.surgeons[slot].chain > 0 {\\n            g.surgeons[slot].chain.saturating_add(1)\\n        } else {\\n            1\\n        };\\n        g.surgeons[slot].chain = chain;\\n        g.surgeons[slot].best_chain = g.surgeons[slot].best_chain.max(chain);\\n        g.surgeons[slot].since_chain = 0.0;\\n        let pts = (rating_points(rating) as f32 * chain_mul(chain) * g.tune.score_mul).round() as i32;\\n        g.surgeons[slot].score += pts;\\n480→        if chain == 5 || chain == 10 || chain == 20 {\\n            cue(events, CUE_CHAIN, hx, hz, 0.6, 1.0 + chain as f32 * 0.01);\\n        }\\n        let mut meter = match rating {\\n            R_IMMACULATE => 8.0,\\n            R_CLEAN => 4.0,\\n            _ => 0.0,\\n        };\\n        if g.heart.on_beat(g.tune.beat_window_ms) {\\n            meter += 2.0;\\n490→            cue(events, CUE_BEAT, hx, hz, 0.4, 1.2);\\n        }\\n        g.surgeons[slot].meter = (g.surgeons[slot].meter + meter * g.tune.gift_gain).min(100.0);\\n    }\\n    if !g.hazards[idx].alive {\\n        note_kind(g, kind);\\n    }\\n    push_popup(g, rating, hx, hz);\\n    cue(events, CUE_RATE, hx, hz, 0.5, 1.0 + (3 - rating) as f32 * 0.08);\\n    if rating == R_IMMACULATE {\\n500→        g.callout_i = 0;\\n        g.callout_t = g.callout_t.max(0.8);\\n    }\\n}\\n\\nfn gift_edge(g: &mut Surgery, slot: usize, inp: SurgeonInput, dt: f32) {\\n    if slot != 0 {\\n        return;\\n    }\\n    let held = inp.held & surg::GIFT != 0;\\n510→    if held {\\n        g.surgeons[0].gift_arm += dt;\\n    } else if g.surgeons[0].was_gift {\\n        let armed = g.surgeons[0].gift_arm >= 0.12;\\n        let on = g.heart.on_beat(g.tune.beat_window_ms);\\n        if armed && on && g.surgeons[0].meter >= 100.0 && !g.heart.flat {\\n            let bit = g.pending_gift();\\n            g.activate_gift(bit);\\n        }\\n        g.surgeons[0].gift_arm = 0.0;\\n520→    }\\n    g.surgeons[0].was_gift = held;\\n}\\n\\nfn defib_only(g: &mut Surgery, slots: &[SurgeonInput; 4], dt: f32, events: &mut Vec<SimEvent>) {\\n    for i in 0..4 {\\n        let inp = slots[i];\\n        if !inp.active && i != 0 {\\n            continue;\\n        }\\n530→        if i == 0 {\\n            g.surgeons[0].active = true;\\n        }\\n        if inp.tool != TOOL_KEEP && inp.active {\\n            g.surgeons[i].tool = inp.tool.min(DEFIB);\\n        }\\n        let held = inp.held & surg::DEFIB != 0 || (g.surgeons[i].tool == DEFIB && inp.held & surg::USE != 0);\\n        if held {\\n            g.surgeons[i].defib += dt;\\n            if g.surgeons[i].defib > 0.2 && (g.surgeons[i].defib * 10.0) as u32 % 8 == 0 {\\n540→                cue(events, CUE_WHINE, g.surgeons[i].x, g.surgeons[i].z, 0.3, 0.8 + g.surgeons[i].defib);\\n            }\\n        } else if g.surgeons[i].was_defib {\\n            let c = g.surgeons[i].defib;\\n            if (1.12..=2.6).contains(&c) && g.heart.ghost_on_beat(g.tune.beat_window_ms) {\\n                cue(events, CUE_THUMP, 0.0, 0.0, 0.