ent\":\"                self.focus = 0;\"},{\"line_number\":388,\"content\":\"            self.screen,\"},{\"line_number\":394,\"content\":\"                self.screen = Screen::Attract;\"},{\"line_number\":402,\"content\":\"        if self.touch_only && !self.ever_fine && self.screen == Screen::Title {\"},{\"line_number\":404,\"content\":\"                self.screen = Screen::Settings;\"},{\"line_number\":405,\"content\":\"                self.focus = 0;\"},{\"line_number\":412,\"content\":\"                self.focus = hit;\"},{\"line_number\":417,\"content\":\"            self.focus = self.focus.saturating_sub(1);\"},{\"line_number\":420,\"content\":\"            self.focus = (self.focus + 1).min(n - 1);\"},{\"line_number\":438,\"content\":\"        if self.screen == Screen::Hud && input.back {\"},{\"line_number\":440,\"content\":\"            self.screen = Screen::Pause;\"},{\"line_number\":441,\"content\":\"            self.focus = 0;\"},{\"line_number\":447,\"content\":\"        match self.screen {\"},{\"line_number\":477,\"content\":\"        match self.screen {\"},{\"line_number\":483,\"content\":\"        self.focus = 0;\"},{\"line_number\":487,\"content\":\"        if self.screen == Screen::Settings && self.settings_page == 0 {\"},{\"line_number\":488,\"content\":\"            let slot = match self.focus {\"},{\"line_number\":489,\"content\":\"                0 => &mut self.music,\"},{\"line_number\":495,\"content\":\"            cmds.push(Cmd::SetBus { which: self.focus as u8, value: *slot });\"},{\"line_number\":497,\"content\":\"        if self.screen == Screen::Dev && (2..8).contains(&self.focus) {\"},{\"line_number\":498,\"content\":\"            let id = self.dev_page as usize * 6 + (self.focus - 2);\"},{\"line_number\":509,\"content\":\"        match self.screen {\"},{\"line_number\":510,\"content\":\"            Screen::Menu | Screen::Attract => self.screen = Screen::Title,\"},{\"line_number\":512,\"content\":\"                self.screen = if se