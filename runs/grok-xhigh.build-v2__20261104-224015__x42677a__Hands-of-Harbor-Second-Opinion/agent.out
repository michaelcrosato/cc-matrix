   self.case_id = -1;\\n        self.code_blue = true;\\n        self.outcome = Outcome::Playing;\\n        self.timer = 240.0;\\n        self.heart = Heart::new(70.0);\\n        self.hazards.clear();\\n330→        // Coarse plate, no shadows. A 420×240 mesh stalls the software-GPU iframe.\\n        self.hub_quiet = true;\\n    }\\n\\n    /// Replace the drawn world with a host snapshot. Cursors included; the tick then predicts the local hand.\\n    pub fn apply_mirror(\\n        &mut self,\\n        vitals: f32,\\n        bpm: f32,\\n        phase: f32,\\n340→        flat: bool,\\n        timer: f32,\\n        code_t: f32,\\n        hazards: &[(u32, u8, f32, f32, bool, u8, f32)],\\n        cursors: &[(u8, f32, f32, u8, bool, i32)],\\n    ) {\\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.heart.vitals = vitals.clamp(0.0, 100.0);\\n350→        self.heart.bpm = bpm.max(1.0);\\n        self.heart.phase = phase;\\n        self.heart.flat = flat;\\n        self.timer = timer;\\n        self.code_t = code_t;\\n        self.hazards.clear();\\n        for &(id, kind, x, z, alive, stage, work) in hazards {\\n            let mut h = Hazard::make(kind.min(K_BURN), x, z);\\n            h.id = id;\\n            h.alive = alive;\\n360→            h.stage = stage;\\n            h.work = work;\\n            h.hidden = false;\\n            self.hazards.push(h);\\n        }\\n        for &(slot, x, z, tool, active, score) in cursors {\\n            let i = slot as usize;\\n            if i < 4 {\\n                let s = &mut self.surgeons[i];\\n                s.x = x;\\n370→                s.z = z;\\n                s.tool = tool;\\n                s.active = active;\\n                s.score = score;\\n            }\\n        }\\n    }\\n\\n    pub fn pending_gift(&self) -> u8 {\\n        let (u, d) = (self.gifts_unlocked, self.gifts_used);\\n380→        if self.recent_unlock != 0 && u & self.recent_unlock != 0 && d & self.recent_unlock == 0 {\\n            return self.recent_unlock;\\n        }\\n        for bit in [content::G_HUSH, content::G_ECHO, content::G_DUET] {\\n            if u & bit != 0 && d & bit == 0 {\\n                return bit;\\n            }\\n        }\\n        0\\n    }\",\"content_concise\":\"270→            recent_unlock: 0,\\n            hush_beats: 0,\\n            echo_left: 0.0,\\n            duet_left: 0.0,\\n            echo_x: 0.0,\\n            echo_z: 0.0,\\n            echo_on: false,\\n            last_tool: 0,\\n            last_rating: R_GOOD,\\n            last_id: 0,\\n280→            last_ok: false,\\n            echo_cool: 0.0,\\n            fever: 0.0,\\n            heat_on: false,\\n            heat_angle: 0.0,\\n            heat_phase: false,\\n            immortal: false,\\n            freeze: false,\\n            one_hit: false,\\n            warned_40: false,\\n290→            players: 1,\\n            blue_t: 0.0,\\n            blue_wave: 0,\\n            blue_finale: false,\\n            popups: [(0, 0.0, 0.0, 0.0); 4],\\n            card_t: 0.0,\\n            spawn_n: 0,\\n            hub_quiet: false,\\n            bot_drive: false,\\n        }\\n300→    }\\n\\n    /// Host or dedicated server: one Code Blue, seeded, with the given player slots active.\\n    pub fn boot_hub_round(sim: &mut Sim, seed: u64, slots: &[u8], quiet: bool) {\\n        sim.state.rng = crate::rng::Rng::new(seed);\\n        let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) else { return };\\n        g.boot_code();\\n        for s in &mut g.surgeons {\\n            s.active = false;\\n        }\\n310→        for &id in slots {\\n            let i = id as usize;\\n            if i < 4 {\\n                g.surgeons[i].active = true;\\n            }\\n        }\\n        g.players = slots.len().clamp(1, 4) as u8;\\n        g.hub_quiet = quiet;\\n        g.mode = M_OP;\\n    }\\n320→\\n    /// Client: draw from snapshots. The local hand