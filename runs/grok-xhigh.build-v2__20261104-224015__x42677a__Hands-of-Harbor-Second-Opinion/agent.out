99,107,95,114,97,116,101,46,104,122,40,41,32,97,115,32,102,51,50,10,53,49,50,58,32,32,32,32,32,32,32,32,32,32,32,32,115,101,108,102,46,104,105,115,116,111,114,121,46,119,105,110,100,111,119,32,61,32,40,115,101,108,102,46,99,111,110,102,105,103,46,104,105,115,116,111,114,121,95,115,101,99,111,110,100,115,32,42,32,115,101,108,102,46,99,111,110,102,105,103,46,116,105,99,107,95,114,97,116,101,46,104,122,40,41,32,97,115,32,102,51,50,41,32,97,115,32,117,54,52,59,10,55,55,51,58,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,108,101,116,32,108,105,102,101,32,61,32,40,114,110,103,46,114,97,110,103,101,40,50,46,53,44,32,52,46,48,41,32,42,32,115,101,108,102,46,99,111,110,102,105,103,46,116,105,99,107,95,114,97,116,101,46,104,122,40,41,32,97,115,32,102,51,50,41,32,97,115,32,117,51,50,59,10,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,72,97,110,100,115,32,111,102,32,72,97,114,98,111,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,84,114,97,117,109,97,32,67,101,110,116,101,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,99,111,114,101,47,115,114,99,47,97,114,112,103,47,109,111,100,46,114,115,10,49,50,57,53,58,32,32,32,32,32,32,32,32,108,101,116,32,104,122,32,61,32,115,105,109,46,99,111,110,102,105,103,46,116,105,99,107,95,114,97,116,101,46,104,122,40,41,32,97,115,32,102,51,50,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":12,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/destruct.rs\",\"matches\":[{\"line_number\":39,\"content\":\"            let life = (rng.range(2.5, 4.0) * self.config.tick_rate.hz() as f32) as u32;\"},{\"line_number\":109,\"content\":\"                        e.lifetime = Some((3.0 * self.config.tick_rate.hz() as f32) as u32);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/sim.rs\",\"matches\":[{\"line_number\":30,\"content\":\"    pub enum TickRate { Hz60 => \\\"60\\\", Hz120 => \\\"120\\\", Hz240 => \\\"240\\\" }\"},{\"line_number\":34,\"content\":\"    pub fn hz(self) -> u32 {\"},{\"line_number\":45,\"content\":\"    pub tick_rate: TickRate,\"},{\"line_number\":63,\"content\":\"            tick_rate: TickRate::Hz60,\"},{\"line_number\":79,\"content\":\"        self.tick_rate.visit_choice(v, \\\"tick_rate\\\", \\\"Simulation ticks per second\\\");\"},{\"line_number\":182,\"content\":\"        let dt = 1.0 / config.tick_rate.hz() as f32;\"},{\"line_number\":239,\"content\":\"        1.0 / self.config.tick_rate.hz() as f32\"},{\"line_number\":512,\"content\":\"            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\"},{\"line_number\":773,\"content\":\"                let life = (rng.range(2.5, 4.0) * self.config.tick_rate.hz() as f32) as u32;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/arpg/mod.rs\",\"matches\":[{\"line_number\":1295,\"content\":\"        let hz = sim.config.tick_rate.hz() as f32;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"58817126-f734-43ac-8022-ba7542d4baad"}
{"type":"assistant","message":{"id":"msg_62","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Default frame rate is 60 Hz. The bot can use 1/60.\n\nBot step and game slew both use 1/60, so timing stays aligned. The bot reads the surgeon's position at tick start and aims toward it. Noise is added to the target before clamping, but skill 1 noise is zero.\n\nSkill below 0.2 causes the bot to retarget its tool every 11 ticks, overriding the correct one and ensuring it never completes. Release logic is unaffected by this retargeting. Heat danger detection is also being reviewed.\n\nHeat danger triggers when the cursor is near the sweep ray and outside a 0.35 radius center zone. The sweep angle advances at 2.8 rad/s, completing a full cycle in about 2.2 seconds, and activates every fifth heartbeat.\n\nWhen the heat sweep completes, coverage.hazards[K_HEAT] increments. Surgeons who hold use while in the danger zone lose 6 vitals, reset their chain, and trigger a lift-off callout. The bot lift-off callout is index 5. I will track use_held this tick for scorch logic inside the surgeon loop. I also need to remove sac swell from apply in hazard.rs to avoid double application.\n\nI am now writing all the code and adding RenderFrame field patches. The story file will be reasonably sized. I noticed a bug in finish(): it sets hit.done to true for intermediate stages, then only clears that flag if advance_stage fully kills the hazard. If more stages remain, done stays true.\n\nThe `done` flag in `finish()` is always true, so the conditional check is redundant. Intermediate stage ratings correctly use error. Bone rotation applies even when the tool is not forceps, but the actual damage only triggers when forceps are held and the cursor is close.\n\nThe bot will apply hazard logic to the focused hazard every tick, even without use, so bone rotation and laser release remain active. It selects the focused hazard when available and alive; otherwise it falls back to the nearest one. Focus updates whenever use is held or the hazard is selected.\n\nFocus follows the highest-drain hazard, so laser release applies correctly. Bone rotation updates even without use held. I will write the code now and add a test file after compilation. The content file will include cases and a story module.\n\nThe build function initializes history, focus, and no player. Sim::new sets the scene name after build. All Surgery fields must be public for bot.rs access. Checkpoint will be placed in mod.rs. Colors and mode constants will also live there. The story module in content.rs is being drafted to reach roughly 192 lines.","signature":""},{"type":"tool_use","id":"call-3bf6ad49-71d1-4604-beda-a34a681a1023-50","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs","old_string":"    if h.kind == K_SAC {\n        h.aux = (h.aux + dt * 0.08).min(1.2);\n    }\n\n    if tool == SCANNER && use_held && d < h.radius + 0.35 {","new_string":"    if tool == SCANNER && use_held && d < h.radius + 0.35 {"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":11420,"output_tokens":1711,"cache_read_input_tokens":122752,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"5ccda6b5-2957-457e-a3fc-a893a8468723"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-3bf6ad49-71d1-4604-beda-a34a681a1023-50","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"    if h.kind == K_SAC {\\n        h.aux = (h.aux + dt * 0.08).min(1.2);\\n    }\\n\\n    if tool == SCANNER && use_held && d < h.radius + 0.35 {\",\"new_string\":\"    if tool == SCANNER && use_held && d < h.radius + 0.35 {\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/hazard.rs\",\"edits\":{\"details\":[{\"old_string\":\"    if h.kind == K_SAC {\\n        h.aux = (h.aux + dt * 0.08).min(1.2);\\n    }\\n\\n    if tool == SCANNER && use_held && d < h.radius + 0.35 {\",\"old_line\":302,\"new_string\":\"    if tool == SCANNER && use_held && d < h.radius + 0.35 {\",\"new_line\":302,\"context_before\":\"    let near = d <= h.radius + 0.08;\\n    let p = pressure.clamp(0.15, 1.0) * power.max(0.2);\\n\\n\",\"context_after\":\"        hit.engaged = true;\\n        hit.cue = CUE_PING;\\n        h.revealed = 8.0;\\n\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"090a4782-6b94-4564-a375-a253d8752681"}
{"type":"assistant","message":{"id":"msg_63","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Writing content.rs, bot.rs, mod.rs, and ops.rs.\n\nStory content will be compact and detailed. Paint mechanics are being mapped for gel stages, dressing, inflammation, and burns. The paint bit logic uses cursor quadrant relative to center. A potential issue with angular speed for circular paths is noted.\n\nThe paint cursor slews at 0.25 per tick. A full circle takes 28 ticks and accumulates enough work to satisfy the threshold. Strain toughness scales the requirement but defaults to one. Incision aim points will track the cut.\n\nBot aim logic is being structured. Gel and dressing tools will circle targets, while other tools use aim_point. Tumor stage 0 uses a scalpel and follows aim_point. Suture side alternates every eight ticks. Laser hold mechanics are next.\n\nLaser hold release is calculated as 0.90 plus a skill-dependent offset. Heat tools include polyp, sac, nodule stage zero, ember stage zero, and IV. The IV release window spans 0.75 to 1.05.\n\nSkill 0.4 cannot complete IV because the release threshold exceeds the success window. Case 2 is therefore lost at this skill level. The plan allows early wins but expects later cases to fail. A fix is being considered: clamp the IV release time into the valid window for skill 0.4 and above.\n\nIV release timing will stay fixed at 0.90 for skill 0.25 and above. The skill-dependent release formula applies only to laser tools, so IV still risks overdose at low skill. A `release_at` helper is being drafted.\n\nThe `release_at` helper is finalized. IV release is fixed at 0.90 for skill 0.25 and above, and at 1.2 for lower skills. The bot will use laser on sacs rather than suction, since laser allows immaculate completion while suction only yields Good. Forceps aim is handled by `aim_point`. Tendril pulling will be restricted to diastole.\n\nDuring systole the bot will hold use at the hazard center to keep along near zero and prevent work from resetting. It will then move to the pull point while holding during diastole to finish the task.\n\nDiastole lasts 44% of the cycle, so one tick at the pull point during that window should finish the task. Hidden hazards will be scanned with the scanner tool when they are not yet revealed. The bot's target selection must align with the game's cursor-based nearest-hazard logic, so hazards will be placed far enough apart to avoid overlap.\n\nSpawns are separated by roughly 1.5 units, well beyond the 0.6 radius. The bot will not hold use until it is close to its intended target, so passing near another hazard during approach cannot accidentally trigger it.\n\nThe bot will pick the nearest alive non-heat hazard within a generous range. If use is already held, it will prefer one that accepts the current tool within a slightly larger radius. This ensures the scalpel stays on an incision rather than switching to another nearby hazard. During laser release, use is not held, so the bot must apply to the hazard it was charging instead of any other nearest target.\n\nA focus ID will be set on every hazard the bot applies to while holding use or applying rot. During laser release, the bot will target that focused hazard instead of the nearest one. Bone rot can still be applied without holding use if the bone is the selected target and the tool is forceps. Idle decay will be limited to non-focused hazards.\n\nThe design is solid enough to begin coding. The story will be generated as a here document and kept near 180 lines. The code will be split into four files: content.rs for data and story, bot.rs, mod.rs for structs and game logic, and ops.rs as a submodule for tick handling.\n\nThe module tree now includes heart, kinds, ops, and tune. ops.rs will use super imports and expose private helpers as pub(super). Content.rs is being written with gift constants and strain indices 0 through 17.\n\nPhase tables are being written for the three surgical cases. Case 0 targets the forearm plate with laceration and pool hazards. Case 1 targets the abdomen plate with bleeder and foreign object hazards. Case 2 targets the lung plate with a bone hazard.\n\nCase 2 now includes an IV and dressing hazard. Case 3 targets the liver plate with three nodules in its first phase, splits into two groups in the second, adds small polyp spawns in the third, and ends with amenorrhea in the fourth.\n\nCase 3 phase four adds an eye hazard and an inflammation hazard. Case 4 targets the pericardium plate with six sacs in three waves, unlocking the ECHO gift at wave two. The sac positions are slightly offset per wave to avoid exact duplication. Case 5 is being considered for the chest plate.\n\nCase 5 is assigned to the chest plate with five ember spawns in its first phase, three closer together in the second, and two embers plus a burn in the third. Case 6 targets the bowel plate with a tumor, laceration, and pool in its first phase, then adds a burn and bleeder in the second.\n\nCase 7 targets the heart plate with a libera-a phase, a b phase with four sacs, a c phase with three embers, a stop script, a soloist incision, a tendril pull, and a dressing close. The bot will burst sacs before they burst naturally; six sequential sacs take about five seconds to burst without treatment.\n\nBursting sacs one by one keeps the total work under 1.12, and even a stuck wave of six stays manageable. If the bot fails to burst them, it can still survive by suctioning the resulting pools. Code blue waves will be hardcoded in ops.rs rather than content.rs: two bleeders spawn initially, vitals drop to 68 and die in about 13.6 seconds, and new pairs appear every 24 seconds.\n\nThe code blue wave sequence is now fully defined: pool and laceration, polyp and inflammation, hidden foreign object and suture bleeder, nodule and pool, sac and gel burn, ember and pool, incision and dressing. The finale requires clearing two nodules and a pool under thirty seconds. Between waves, any remaining hazard continues draining vitals until the next wave arrives. When multiple players are present, extra pools spawn based on player count.\n\nThe code blue timer is 240 multiplied by difficulty. Vitals start at 70. Opening bleeders will spawn first to force early targeting. A `content_text()` helper will join all dialogue for linting. Plate descriptions are deferred to the view layer. The next step is writing bot.rs, content.rs, and the two logic files.\n\nThe story will be 192 lines, written in a single pass. It will stay within the cast and avoid forbidden words. After writing, RenderFrame will be patched and the project compiled. Surgery snapshot fields are all present, so serde defaults are unnecessary. Negative zero floats will be clamped to zero.\n\nThe bot must not use `sim.rng` inside `bot()`. The partner decision is read before any mutable borrows in the tick, so it can be called safely. Slot 0 input comes from `InputFrame`, but partner actions are not recorded in the simulation log.\n\nPartner decisions are deterministic and derived from game state, so replay hashes match even though partner actions are not in the input log. The bot will avoid wall-clock time. A bug was spotted: `enter_phase` uses RNG to jitter hazard positions, which advances the random state before the checkpoint is saved, so the snapshot may not reflect the exact spawned layout.\n\nThe RNG state is not saved in the checkpoint because it lives in SimState rather than Surgery. On retry, the restored phase_ready flag prevents re-entering the current phase and re-rolling spawns, so the next phase uses the already-advanced RNG. This is acceptable for continuing; divergence from the original timeline only occurs if RNG was consumed between the checkpoint and death.\n\nA critical ordering bug was found in `run_bot`: the bot decision is computed before the tick, so it may act on an empty hazard set if the first tick spawns them. Snapshot and rewind correctly preserve the full `SimState` including RNG.","signature":""},{"type":"text","text":"The operation needs cases, dialogue, and a bot that can finish them. I’m adding those next."},{"type":"tool_use","id":"call-91811a7c-8971-4794-8084-0790eade4714-51","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/story.rs","content":"//! Paper-theatre lines. Indices, not copies, live in the sim.\n\n#[derive(Clone, Copy)]\npub struct Line {\n    pub who: &'static str,\n    pub text: &'static str,\n}\n\nmacro_rules! L {\n    ($($who:literal, $text:literal);* $(;)?) => {\n        &[ $(Line { who: $who, text: $text }),* ]\n    };\n}\n\npub fn block(case_id: i8, after: bool) -> &'static [Line] {\n    match (case_id, after) {\n        (0, false) => BEFORE_0,\n        (0, true) => AFTER_0,\n        (1, false) => BEFORE_1,\n        (1, true) => AFTER_1,\n        (2, false) => BEFORE_2,\n        (2, true) => AFTER_2,\n        (3, false) => BEFORE_3,\n        (3, true) => AFTER_3,\n        (4, false) => BEFORE_4,\n        (4, true) => AFTER_4,\n        (5, false) => BEFORE_5,\n        (5, true) => AFTER_5,\n        (6, false) => BEFORE_6,\n        (6, true) => AFTER_6,\n        (7, false) => BEFORE_7,\n        (7, true) => AFTER_7,\n        _ => AFTER_7,\n    }\n}\n\npub fn all_lines() -> Vec<Line> {\n    let mut v = Vec::new();\n    for case_id in 0..8 {\n        v.extend_from_slice(block(case_id, false));\n        v.extend_from_slice(block(case_id, true));\n    }\n    v.extend_from_slice(CALLOUTS);\n    v\n}\n\nconst BEFORE_0: &[Line] = L![\n    \"Ottoline Voss\", \"Night Ward, Mercy Harbor General. Port Verity is under a storm and the ferry is late.\";\n    \"Ottoline Voss\", \"Mara Quill, you lead tonight. I will be in the gallery, not in your light.\";\n    \"Mara Quill\", \"Understood, Chief. Who is on the table?\";\n    \"Bashir Haddad\", \"Anton Deverell, crane crew at the west dock. A cable walked off the drum and took the forearm.\";\n    \"Pet Nwosu\", \"I have the field set. My hands are noisy tonight. Say if you want them off the retractors.\";\n    \"Mara Quill\", \"Stay. I trust the work more than the tremor.\";\n    \"Teddy Lark\", \"I labeled the suction twice, because last time I labeled it once and Bashir looked at me like weather.\";\n    \"Bashir Haddad\", \"The look stands. Pressure is soft. He lost blood on the ramp.\";\n    \"Cordelia Vane\", \"Nothing in the smear but rope fiber and seawater. No strain. A plain wound, if any wound is plain.\";\n    \"Mara Quill\", \"Then we do a plain thing well. Pet, count me in.\";\n    \"Pet Nwosu\", \"On your word. Scalpel, then the bleed, then we close what the cable opened.\";\n    \"Anton Deverell\", \"Don't let them take the arm. I still have a shift on Thursday.\";\n];\n\nconst AFTER_0: &[Line] = L![\n    \"Bashir Haddad\", \"Pulse is a working pulse. He will keep the arm.\";\n    \"Pet Nwosu\", \"The last stitch sat down clean. I felt the tremor go quiet for it.\";\n    \"Teddy Lark\", \"I have decided surgery is just sewing, if sewing could file a complaint.\";\n    \"Mara Quill\", \"Write the chart. Cable injury, forearm, closure sound. No poetry.\";\n    \"Ottoline Voss\", \"Poetry is how this ward gets careless. Good work, Doctor Quill.\";\n    \"Cordelia Vane\", \"I kept the fiber. The harbor puts strange gifts in a wound. This one was only rope.\";\n    \"Mara Quill\", \"Only rope is enough for one night.\";\n    \"Bashir Haddad\", \"He asked for Thursday. I told him Thursday is a rumor until the dressing comes off.\";\n    \"Pet Nwosu\", \"I'll sit with the monitor. Go wash. Your shoulders are up by your ears.\";\n    \"Teddy Lark\", \"I will fetch coffee that tastes like a bandage. It is all the machine knows.\";\n    \"Ottoline Voss\", \"Drink it standing. The board wants the ward's numbers by dawn.\";\n    \"Mara Quill\", \"The ward's numbers are a man with a Thursday. They can wait until he wakes.\";\n];\n\nconst BEFORE_1: &[Line] = L![\n    \"Bashir Haddad\", \"Briony Pell, navigator on the evening ferry. Belly pain since the bar, then a faint on the stairs.\";\n    \"Mara Quill\", \"Any fever?\";\n    \"Bashir Haddad\", \"Low. She is guarding the right side. I do not like the silence in there.\";\n    \"Pet Nwosu\", \"Abdomen is prepped. There is a shadow on the scan I cannot name.\";\n    \"Cordelia Vane\", \"Name it after you see it. Shadows in this hospital have been earning worse names.\";\n    \"Teddy Lark\", \"I brought the scanner up from imaging. The orderly said it whistles when it is happy.\";\n    \"Mara Quill\", \"Then we will let it whistle. Hidden things first, then whatever is feeding the bleed.\";\n    \"Ottoline Voss\", \"The ferry company is already on the phone. They are not invited into this room.\";\n    \"Briony Pell\", \"Tell them the boat can leave without me. Tell my brother where I am.\";\n    \"Mara Quill\", \"Your brother will hear it from us, not from a clerk. Pet, lights.\";\n    \"Pet Nwosu\", \"Lights. I have the forceps warm.\";\n    \"Cordelia Vane\", \"If you find something that is not hers, do not put it in the bin. Bag it for me.\";\n];\n\nconst AFTER_1: &[Line] = L![\n    \"Mara Quill\", \"A shard of glass and a small feeder. Both out. The bowel wall held.\";\n    \"Cordelia Vane\", \"Glass from the harbor bar, not from a body that grew it. I am relieved and I resent the relief.\";\n    \"Bashir Haddad\", \"She is asking for water she cannot have yet. That is a good argument.\";\n    \"Pet Nwosu\", \"The scanner sang once and then behaved. I have decided to like it.\";\n    \"Teddy Lark\", \"I will write 'behaved' in the log. It is the nicest thing I have written all week.\";\n    \"Ottoline Voss\", \"The company will want a cause. Give them glass and a fall. Give them nothing else.\";\n    \"Mara Quill\", \"Nothing else is what we found. I want that to stay true.\";\n    \"Cordelia Vane\", \"Stay is not a promise the Night Ward knows how to keep.\";\n    \"Bashir Haddad\", \"Vitals are bored. Bored is my favorite vital sign.\";\n    \"Pet Nwosu\", \"Go speak to the brother. I will mind the drains.\";\n    \"Teddy Lark\", \"I can mind a drain. I have minded worse, including myself.\";\n    \"Mara Quill\", \"Mind it, then. And if the numbers change, you shout. You do not editorialize.\";\n];\n\nconst BEFORE_2: &[Line] = L![\n    \"Ottoline Voss\", \"Casper Lang. He conducts the civic choir. A rib gave way on the podium and something under it did not.\";\n    \"Bashir Haddad\", \"Airway is mine. He desaturated in the lift and came back angry, which I respect.\";\n    \"Mara Quill\", \"Bone, then the tear beneath, then we close the skin he conducts with.\";\n    \"Pet Nwosu\", \"If the rib is turned, I will turn it back before you stitch. Say the word and I will stop if my hands wander.\";\n    \"Teddy Lark\", \"The choir is in the lobby singing very quietly, which is somehow louder.\";\n    \"Cordelia Vane\", \"I looked at his blood because that is what I do when a room feels staged. It is only blood.\";\n    \"Mara Quill\", \"Then we treat the man, not the feeling.\";\n    \"Casper Lang\", \"If I go out, tell them the downbeat was late. It was not their fault.\";\n    \"Bashir Haddad\", \"Nobody is going out. You will hate the tube and then you will forget it.\";\n    \"Ottoline Voss\", \"Doctor Quill, if he arrests you have two attempts on a resident's budget. Use them like they are yours.\";\n    \"Mara Quill\", \"I would rather not use them at all.\";\n    \"Pet Nwosu\", \"On your word. The field is a small country. We know the roads.\";\n];\n\nconst AFTER_2: &[Line] = L![\n    \"Bashir Haddad\", \"He arrested and he came back on your shock. Sinus is sulking, but it is sinus.\";\n    \"Mara Quill\", \"The rib sits. The tear is closed. I do not want to feel that proud of a flatline.\";\n    \"Pet Nwosu\", \"Pride is not what that was. That was a hand on a paddle and a count you did not rush.\";\n    \"Teddy Lark\", \"I have never been so glad to hear a machine complain.\";\n    \"Ottoline Voss\", \"The lobby will want a hymn. They can have one when he can hear it.\";\n    \"Cordelia Vane\", \"I will say this once. His arrest looked like a body running out of blood, not like a body being played.\";\n    \"Mara Quill\", \"Played?\";\n    \"Cordelia Vane\", \"A word I am not ready to defend. Forget it if tomorrow is quiet.\";\n    \"Bashir Haddad\", \"Tomorrow is never the point. The next hour is the point.\";\n    \"Pet Nwosu\", \"I'll chart the shock as a single, successful, on the beat. They will ask.\";\n    \"Mara Quill\", \"Tell them the truth. The beat was there. We met it.\";\n    \"Teddy Lark\", \"I am going to go stand in the lobby and not sing. It will be my contribution.\";\n];\n\nconst BEFORE_3: &[Line] = L![\n    \"Cordelia Vane\", \"Idris Okonkwo, keeper at the north light. Liver lesion, and the lesion has daughters.\";\n    \"Mara Quill\", \"Daughters is not a clinical word.\";\n    \"Cordelia Vane\", \"Look at the film and choose a better one. They were not there at dusk. They are there now.\";\n    \"Ottoline Voss\", \"The board has a name they want used if this spreads. I have not agreed to their name.\";\n    \"Bashir Haddad\", \"His pressure is proud and his temperature is not. I can hold him. I cannot hold a rumor.\";\n    \"Pet Nwosu\", \"If they move, I need you to say so. My eyes are good. My hands will need a second.\";\n    \"Teddy Lark\", \"I read about a stillness some surgeons get when the room goes thin. I thought it was a story for interns.\";\n    \"Mara Quill\", \"If it is real, it will be a tool, not a story. What do you call it, Cordelia?\";\n    \"Cordelia Vane\", \"I call the stillness the Hush. I call the lesion's family by a case name: R.E.Q.U.I.E.M.\";\n    \"Ottoline Voss\", \"You will not put that on a form.\";\n    \"Cordelia Vane\", \"The form can say multifocal lesion. The room can know what it is fighting.\";\n    \"Mara Quill\", \"Then the room knows. Idris, we are going to take them out one voice at a time.\";\n];\n\nconst AFTER_3: &[Line] = L![\n    \"Mara Quill\", \"They split when the laser finished, and the children were smaller and meaner. They are gone.\";\n    \"Pet Nwosu\", \"When you called the Hush, my tremor stopped as if it had been asked. I want that written down as a fact.\";\n    \"Bashir Haddad\", \"His liver enzymes will be a letter we do not enjoy. He is alive to receive the letter.\";\n    \"Cordelia Vane\", \"Introit. That is the phase I will write in my book, which is not the chart.\";\n    \"Ottoline Voss\", \"Your book will stay in this building. I will not have the harbor papers naming a disease like a mass.\";\n    \"Teddy Lark\", \"I held a retractor and thought about my mother. I don't know why I'm saying that.\";\n    \"Mara Quill\", \"Because the room was quiet enough to hear yourself. That is the Hush, too.\";\n    \"Cordelia Vane\", \"It will not stay a kindness. A thing that slows a wound will want a price.\";\n    \"Bashir Haddad\", \"All of my drugs want a price. We still use them.\";\n    \"Pet Nwosu\", \"I can work under it. If it comes again, call it early.\";\n    \"Mara Quill\", \"I will call it when the vitals ask, not when I want to feel rare.\";\n    \"Ottoline Voss\", \"Good. Rarity is how a ward starts lying.\";\n];\n\nconst BEFORE_4: &[Line] = L![\n    \"Bashir Haddad\", \"June Harlow, glassblower. She coughed silver and then she stopped coughing, which I like less.\";\n    \"Mara Quill\", \"Where?\";\n    \"Cordelia Vane\", \"Sacs along the mediastinum, and behind them a lesion that looks back. I am not being figurative.\";\n    \"Pet Nwosu\", \"Pericardium is open on the plan. If a sac bursts we will be swimming.\";\n    \"Teddy Lark\", \"I have extra suction. I have so much suction. I am the god of suction and I am frightened.\";\n    \"Ottoline Voss\", \"Doctor Lark, you will be the intern of suction. Gods wait outside.\";\n    \"Mara Quill\", \"Laser on the stems, slow if the laser runs hot. If one opens, we clear the field before the next.\";\n    \"June Harlow\", \"I was making a bowl for my wife. Tell her the color was right even if I don't finish it.\";\n    \"Bashir Haddad\", \"You can tell her yourself. I am very stubborn about that.\";\n    \"Cordelia Vane\", \"This phase is Lacrimosa. If you finish a perfect pass, the next sac sometimes repeats it. I call that the Echo.\";\n    \"Mara Quill\", \"A copy of a good hand.\";\n    \"Pet Nwosu\", \"Then give it only a good hand. I will not have it learn my shake.\";\n];\n\nconst AFTER_4: &[Line] = L![\n    \"Mara Quill\", \"The eye is closed. I never want to say that about a person again and mean a lesion.\";\n    \"Cordelia Vane\", \"The Echo took your last clean pass and spent it on a sac you had not reached. It saved a second.\";\n    \"Pet Nwosu\", \"It also saved the mess. I was ready for the mess and I am glad to be wrong.\";\n    \"Bashir Haddad\", \"June is asking, in writing because the tube is still in, whether the bowl survived the annealer.\";\n    \"Teddy Lark\", \"I called the studio. The bowl survived. I did not cry. That is a lie. I did not cry on the phone.\";\n    \"Ottoline Voss\", \"Put the bowl in the chart as a personal effect, not as a miracle.\";\n    \"Mara Quill\", \"The miracle is a closed chest and a woman who wants a bowl. I will take it.\";\n    \"Cordelia Vane\", \"Three waves. It likes threes. Remember that when it stops being polite.\";\n    \"Bashir Haddad\", \"Polite is not the word I have for a chest full of sacs.\";\n    \"Pet Nwosu\", \"Go eat. I will watch the Echo wear off. It should be gone in minutes.\";\n    \"Mara Quill\", \"If it copies a mistake next time, we retire it.\";\n    \"Cordelia Vane\", \"Agreed. A gift that repeats a sin is just a faster sin.\";\n];\n\nconst BEFORE_5: &[Line] = L![\n    \"Ottoline Voss\", \"Nils Ferreira, night stoker at the foundry. He came in hot and the hot is not a fever we own.\";\n    \"Bashir Haddad\", \"Temperature is a number I do not say out loud near flammable interns.\";\n    \"Teddy Lark\", \"I am only a little flammable.\";\n    \"Cordelia Vane\", \"Embers. They want cold before steel, and steel before the pull. If you cut one early it seeds.\";\n    \"Mara Quill\", \"Cryoprobe first. Pet, you have used it on a wart and you will pretend this is a wart.\";\n    \"Pet Nwosu\", \"It is a wart. I am very convincing.\";\n    \"Mara Quill\", \"There will be heat rings across the field. When one passes, hands up. I would rather lose a second than a layer of him.\";\n    \"Nils Ferreira\", \"Don't let the fire have the last word. I have spent thirty years answering it.\";\n    \"Bashir Haddad\", \"The fire can file its complaint with me. Breathe when I tell you, and then stop arguing.\";\n    \"Cordelia Vane\", \"This is Dies Irae. It will try to make the embers into one animal.\";\n    \"Ottoline Voss\", \"Then we do not let it finish the sentence.\";\n    \"Mara Quill\", \"Cold, then cut, then out. Say it back to me.\";\n];\n\nconst AFTER_5: &[Line] = L![\n    \"Pet Nwosu\", \"The last ember came apart in the forceps like bad coal. Nothing seeded.\";\n    \"Mara Quill\", \"The ring crossed my knuckle and I lifted. The chart can say I was slow. The chart is welcome.\";\n    \"Bashir Haddad\", \"His temperature is a temperature again. I am writing it down with ordinary digits.\";\n    \"Teddy Lark\", \"I have never loved an ordinary digit more.\";\n    \"Cordelia Vane\", \"It merged once and you split the merge. That will make it angry or it will make it careful. I do not know which is worse.\";\n    \"Ottoline Voss\", \"Careful is worse. Angry I can staff for.\";\n    \"Mara Quill\", \"Staff for both. I want a second team sleeping in the call room, not at home.\";\n    \"Pet Nwosu\", \"I'll sleep here. The chair knows me.\";\n    \"Bashir Haddad\", \"Nils asked if the foundry called. They did. He is not fired. I told them he is busy not dying.\";\n    \"Teddy Lark\", \"I will be the one who brings that sentence to him. I want to see a stoker smile.\";\n    \"Mara Quill\", \"Then bring it, and come back. We are not done with the week.\";\n    \"Cordelia Vane\", \"No. The requiem has movements left.\";\n];\n\nconst BEFORE_6: &[Line] = L![\n    \"Bashir Haddad\", \"Petra Solano, cartographer. A mass at the root of the mesentery, and she still tried to finish a coastline in the waiting room.\";\n    \"Mara Quill\", \"Circle it, lift it, gel the bed. If I nick what feeds the bowel we will know immediately.\";\n    \"Pet Nwosu\", \"I have the field wide. There is room for your hands and mine and still a margin.\";\n    \"Cordelia Vane\", \"The mass is not a strain daughter. It is older. It has been drawing itself for years.\";\n    \"Ottoline Voss\", \"Good. I would like one enemy tonight that does not multiply when looked at.\";\n    \"Teddy Lark\", \"I put her maps in a folder so the blood can't have them. That is the most useful thing I have done.\";\n    \"Petra Solano\", \"The cape on sheet four is wrong. If I don't wake up, the cape is still wrong. Fix the cape.\";\n    \"Mara Quill\", \"You will fix your own cape. I am only fixing the thing under it.\";\n    \"Bashir Haddad\", \"She is a terrible patient and an excellent reason. Anesthesia is in.\";\n    \"Pet Nwosu\", \"Whenever you are ready. I will follow the circle with the suction, not across it.\";\n    \"Mara Quill\", \"Across it is how we lose the margin. Follow.\";\n    \"Ottoline Voss\", \"Bring her back with the cape unfixed. Let the living argue with the map.\";\n];\n\nconst AFTER_6: &[Line] = L![\n    \"Mara Quill\", \"The mass is out, in one piece, which felt like a vanity and was actually safer.\";\n    \"Cordelia Vane\", \"I will cut it in the lab and it will be dull under the lens. I am grateful for dull.\";\n    \"Bashir Haddad\", \"She wrote 'cape' on a pad before her eyes were fully open. The woman is a compass.\";\n    \"Teddy Lark\", \"I told her the cape can wait until soup. She looked at me like I had insulted a coastline.\";\n    \"Pet Nwosu\", \"Leave her the pen. A pen is a smaller risk than the argument.\";\n    \"Ottoline Voss\", \"The board meets in six hours. They will ask if the ward is under control.\";\n    \"Mara Quill\", \"Tell them we did six operations and told the truth after each.\";\n    \"Ottoline Voss\", \"They do not hear that as control.\";\n    \"Mara Quill\", \"Then they are asking the wrong question of a hospital.\";\n    \"Cordelia Vane\", \"There is one patient left on the night list. He came in without a name and then he had one. Soren Vale.\";\n    \"Pet Nwosu\", \"What is wrong with Soren Vale?\";\n    \"Cordelia Vane\", \"Everything we have already seen, and the part where a heart stops on purpose.\";\n];\n\nconst BEFORE_7: &[Line] = L![\n    \"Ottoline Voss\", \"Soren Vale. No next of kin on the card. The heart is the field. Cordelia, say the rest.\";\n    \"Cordelia Vane\", \"Libera Me. Nodules, sacs, embers, and then a stoppage that is written into him, not earned by blood loss.\";\n    \"Bashir Haddad\", \"If it is written, my drugs will not argue it out. You will have to meet it with the paddles.\";\n    \"Mara Quill\", \"How many stops?\";\n    \"Cordelia Vane\", \"Three, if it behaves like the page. Maybe it cannot count. Plan for three.\";\n    \"Pet Nwosu\", \"I will take the second pair of hands. When you are on the tendril I will be on whatever else is eating him.\";\n    \"Teddy Lark\", \"Tell me where to stand so I am a help and not a story you tell later.\";\n    \"Mara Quill\", \"Stand at the head with Bashir. If I ask for a clamp, you are already holding it.\";\n    \"Ottoline Voss\", \"There is a last gift in the notes. Cordelia calls it the Duet. Two surgeons, one count.\";\n    \"Cordelia Vane\", \"It is not magic. It is an agreement the tissue seems to honor when two instruments mean the same thing.\";\n    \"Mara Quill\", \"Then we will mean it. Pet, you have the right hand of the field. I have the left.\";\n    \"Soren Vale\", \"If there is a downbeat, don't miss it for my sake. I have missed enough of my own.\";\n];\n\nconst AFTER_7: &[Line] = L![\n    \"Bashir Haddad\", \"Three shocks. Sinus after the third, thin as paper, and then it thickened.\";\n    \"Mara Quill\", \"The tendril let go when both of us pulled on the quiet half of the beat. I will not pretend I understand it.\";\n    \"Pet Nwosu\", \"You don't have to understand a door to close it. It is closed.\";\n    \"Teddy Lark\", \"I did not drop the clamp. I am going to have that put on a cake.\";\n    \"Ottoline Voss\", \"The board can have their dawn meeting. I will tell them the Night Ward kept the night.\";\n    \"Cordelia Vane\", \"R.E.Q.U.I.E.M. is a case name, not a myth, as long as we write what we did and not what we felt.\";\n    \"Mara Quill\", \"What I felt was a room full of people who stayed. Write that if you need a cause.\";\n    \"Bashir Haddad\", \"Soren asked if the choir from Tuesday is still in the lobby. They went home. I said they left the lights.\";\n    \"Pet Nwosu\", \"My hands are shaking again. I am glad. It means the Hush went home too.\";\n    \"Ottoline Voss\", \"Go sleep in a real bed, Doctor Quill. The harbor will still be there at noon, making work.\";\n    \"Mara Quill\", \"Wake me if a vitals page is ugly. Wake me if it is only strange. I would rather be early than sung about.\";\n    \"Cordelia Vane\", \"No one is singing. That is the best result this building knows.\";\n];\n\npub const CALLOUTS: &[Line] = L![\n    \"Bashir Haddad\", \"Clean. Again.\";\n    \"Pet Nwosu\", \"Doctor, that's healthy tissue.\";\n    \"Bashir Haddad\", \"Vitals at forty. Push the IV. Now!\";\n    \"Pet Nwosu\", \"Wrong instrument, Doctor.\";\n    \"Mara Quill\", \"Lift off! Lift off!\";\n    \"Bashir Haddad\", \"Charge. On the ghost beat.\";\n    \"Bashir Haddad\", \"Sinus rhythm. Stay with me.\";\n    \"Cordelia Vane\", \"The Hush is yours.\";\n    \"Cordelia Vane\", \"Echo the last sure hand.\";\n    \"Ottoline Voss\", \"Together. The Duet.\";\n    \"Pet Nwosu\", \"Hemostasis.\";\n    \"Mara Quill\", \"The mass is ringed. Lift it.\";\n    \"Pet Nwosu\", \"Frost, then steel.\";\n    \"Bashir Haddad\", \"Three shocks. No more.\";\n    \"Mara Quill\", \"Close the field.\";\n    \"Teddy Lark\", \"Still with us. Still with us.\";\n];\n\npub fn callout(i: u8) -> &'static str {\n    CALLOUTS.get(i as usize).map(|l| l.text).unwrap_or(\"\")\n}\n\npub fn callout_who(i: u8) -> &'static str {\n    CALLOUTS.get(i as usize).map(|l| l.who).unwrap_or(\"\")\n}\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1838,"output_tokens":12552,"cache_read_input_tokens":134144,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"2fb957ea-22c6-4a8c-9e28-a5283abe924a"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-91811a7c-8971-4794-8084-0790eade4714-51","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"//! Paper-theatre lines. Indices, not copies, live in the sim.\\n\\n#[derive(Clone, Copy)]\\npub struct Line {\\n    pub who: &'static str,\\n    pub text: &'static str,\\n}\\n\\nmacro_rules! L {\\n    ($($who:literal, $text:literal);* $(;)?) => {\\n        &[ $(Line { who: $who, text: $text }),* ]\\n    };\\n}\\n\\npub fn block(case_id: i8, after: bool) -> &'static [Line] {\\n    match (case_id, after) {\\n        (0, false) => BEFORE_0,\\n        (0, true) => AFTER_0,\\n        (1, false) => BEFORE_1,\\n        (1, true) => AFTER_1,\\n        (2, false) => BEFORE_2,\\n        (2, true) => AFTER_2,\\n        (3, false) => BEFORE_3,\\n        (3, true) => AFTER_3,\\n        (4, false) => BEFORE_4,\\n        (4, true) => AFTER_4,\\n        (5, false) => BEFORE_5,\\n        (5, true) => AFTER_5,\\n        (6, false) => BEFORE_6,\\n        (6, true) => AFTER_6,\\n        (7, false) => BEFORE_7,\\n        (7, true) => AFTER_7,\\n        _ => AFTER_7,\\n    }\\n}\\n\\npub fn all_lines() -> Vec<Line> {\\n    let mut v = Vec::new();\\n    for case_id in 0..8 {\\n        v.extend_from_slice(block(case_id, false));\\n        v.extend_from_slice(block(case_id, true));\\n    }\\n    v.extend_from_slice(CALLOUTS);\\n    v\\n}\\n\\nconst BEFORE_0: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Night Ward, Mercy Harbor General. Port Verity is under a storm and the ferry is late.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Mara Quill, you lead tonight. I will be in the gallery, not in your light.\\\";\\n    \\\"Mara Quill\\\", \\\"Understood, Chief. Who is on the table?\\\";\\n    \\\"Bashir Haddad\\\", \\\"Anton Deverell, crane crew at the west dock. A cable walked off the drum and took the forearm.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I have the field set. My hands are noisy tonight. Say if you want them off the retractors.\\\";\\n    \\\"Mara Quill\\\", \\\"Stay. I trust the work more than the tremor.\\\";\\n    \\\"Teddy Lark\\\", \\\"I labeled the suction twice, because last time I labeled it once and Bashir looked at me like weather.\\\";\\n    \\\"Bashir Haddad\\\", \\\"The look stands. Pressure is soft. He lost blood on the ramp.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Nothing in the smear but rope fiber and seawater. No strain. A plain wound, if any wound is plain.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we do a plain thing well. Pet, count me in.\\\";\\n    \\\"Pet Nwosu\\\", \\\"On your word. Scalpel, then the bleed, then we close what the cable opened.\\\";\\n    \\\"Anton Deverell\\\", \\\"Don't let them take the arm. I still have a shift on Thursday.\\\";\\n];\\n\\nconst AFTER_0: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Pulse is a working pulse. He will keep the arm.\\\";\\n    \\\"Pet Nwosu\\\", \\\"The last stitch sat down clean. I felt the tremor go quiet for it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have decided surgery is just sewing, if sewing could file a complaint.\\\";\\n    \\\"Mara Quill\\\", \\\"Write the chart. Cable injury, forearm, closure sound. No poetry.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Poetry is how this ward gets careless. Good work, Doctor Quill.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I kept the fiber. The harbor puts strange gifts in a wound. This one was only rope.\\\";\\n    \\\"Mara Quill\\\", \\\"Only rope is enough for one night.\\\";\\n    \\\"Bashir Haddad\\\", \\\"He asked for Thursday. I told him Thursday is a rumor until the dressing comes off.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll sit with the monitor. Go wash. Your shoulders are up by your ears.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will fetch coffee that tastes like a bandage. It is all the machine knows.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Drink it standing. The board wants the ward's numbers by dawn.\\\";\\n    \\\"Mara Quill\\\", \\\"The ward's numbers are a man with a Thursday. They can wait until he wakes.\\\";\\n];\\n\\nconst BEFORE_1: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Briony Pell, navigator on the evening ferry. Belly pain since the bar, then a faint on the stairs.\\\";\\n    \\\"Mara Quill\\\", \\\"Any fever?\\\";\\n    \\\"Bashir Haddad\\\", \\\"Low. She is guarding the right side. I do not like the silence in there.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Abdomen is prepped. There is a shadow on the scan I cannot name.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Name it after you see it. Shadows in this hospital have been earning worse names.\\\";\\n    \\\"Teddy Lark\\\", \\\"I brought the scanner up from imaging. The orderly said it whistles when it is happy.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we will let it whistle. Hidden things first, then whatever is feeding the bleed.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The ferry company is already on the phone. They are not invited into this room.\\\";\\n    \\\"Briony Pell\\\", \\\"Tell them the boat can leave without me. Tell my brother where I am.\\\";\\n    \\\"Mara Quill\\\", \\\"Your brother will hear it from us, not from a clerk. Pet, lights.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Lights. I have the forceps warm.\\\";\\n    \\\"Cordelia Vane\\\", \\\"If you find something that is not hers, do not put it in the bin. Bag it for me.\\\";\\n];\\n\\nconst AFTER_1: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"A shard of glass and a small feeder. Both out. The bowel wall held.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Glass from the harbor bar, not from a body that grew it. I am relieved and I resent the relief.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She is asking for water she cannot have yet. That is a good argument.\\\";\\n    \\\"Pet Nwosu\\\", \\\"The scanner sang once and then behaved. I have decided to like it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will write 'behaved' in the log. It is the nicest thing I have written all week.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The company will want a cause. Give them glass and a fall. Give them nothing else.\\\";\\n    \\\"Mara Quill\\\", \\\"Nothing else is what we found. I want that to stay true.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Stay is not a promise the Night Ward knows how to keep.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Vitals are bored. Bored is my favorite vital sign.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Go speak to the brother. I will mind the drains.\\\";\\n    \\\"Teddy Lark\\\", \\\"I can mind a drain. I have minded worse, including myself.\\\";\\n    \\\"Mara Quill\\\", \\\"Mind it, then. And if the numbers change, you shout. You do not editorialize.\\\";\\n];\\n\\nconst BEFORE_2: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Casper Lang. He conducts the civic choir. A rib gave way on the podium and something under it did not.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Airway is mine. He desaturated in the lift and came back angry, which I respect.\\\";\\n    \\\"Mara Quill\\\", \\\"Bone, then the tear beneath, then we close the skin he conducts with.\\\";\\n    \\\"Pet Nwosu\\\", \\\"If the rib is turned, I will turn it back before you stitch. Say the word and I will stop if my hands wander.\\\";\\n    \\\"Teddy Lark\\\", \\\"The choir is in the lobby singing very quietly, which is somehow louder.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I looked at his blood because that is what I do when a room feels staged. It is only blood.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we treat the man, not the feeling.\\\";\\n    \\\"Casper Lang\\\", \\\"If I go out, tell them the downbeat was late. It was not their fault.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Nobody is going out. You will hate the tube and then you will forget it.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Doctor Quill, if he arrests you have two attempts on a resident's budget. Use them like they are yours.\\\";\\n    \\\"Mara Quill\\\", \\\"I would rather not use them at all.\\\";\\n    \\\"Pet Nwosu\\\", \\\"On your word. The field is a small country. We know the roads.\\\";\\n];\\n\\nconst AFTER_2: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"He arrested and he came back on your shock. Sinus is sulking, but it is sinus.\\\";\\n    \\\"Mara Quill\\\", \\\"The rib sits. The tear is closed. I do not want to feel that proud of a flatline.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Pride is not what that was. That was a hand on a paddle and a count you did not rush.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have never been so glad to hear a machine complain.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The lobby will want a hymn. They can have one when he can hear it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I will say this once. His arrest looked like a body running out of blood, not like a body being played.\\\";\\n    \\\"Mara Quill\\\", \\\"Played?\\\";\\n    \\\"Cordelia Vane\\\", \\\"A word I am not ready to defend. Forget it if tomorrow is quiet.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Tomorrow is never the point. The next hour is the point.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll chart the shock as a single, successful, on the beat. They will ask.\\\";\\n    \\\"Mara Quill\\\", \\\"Tell them the truth. The beat was there. We met it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I am going to go stand in the lobby and not sing. It will be my contribution.\\\";\\n];\\n\\nconst BEFORE_3: &[Line] = L![\\n    \\\"Cordelia Vane\\\", \\\"Idris Okonkwo, keeper at the north light. Liver lesion, and the lesion has daughters.\\\";\\n    \\\"Mara Quill\\\", \\\"Daughters is not a clinical word.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Look at the film and choose a better one. They were not there at dusk. They are there now.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board has a name they want used if this spreads. I have not agreed to their name.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His pressure is proud and his temperature is not. I can hold him. I cannot hold a rumor.\\\";\\n    \\\"Pet Nwosu\\\", \\\"If they move, I need you to say so. My eyes are good. My hands will need a second.\\\";\\n    \\\"Teddy Lark\\\", \\\"I read about a stillness some surgeons get when the room goes thin. I thought it was a story for interns.\\\";\\n    \\\"Mara Quill\\\", \\\"If it is real, it will be a tool, not a story. What do you call it, Cordelia?\\\";\\n    \\\"Cordelia Vane\\\", \\\"I call the stillness the Hush. I call the lesion's family by a case name: R.E.Q.U.I.E.M.\\\";\\n    \\\"Ottoline Voss\\\", \\\"You will not put that on a form.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The form can say multifocal lesion. The room can know what it is fighting.\\\";\\n    \\\"Mara Quill\\\", \\\"Then the room knows. Idris, we are going to take them out one voice at a time.\\\";\\n];\\n\\nconst AFTER_3: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"They split when the laser finished, and the children were smaller and meaner. They are gone.\\\";\\n    \\\"Pet Nwosu\\\", \\\"When you called the Hush, my tremor stopped as if it had been asked. I want that written down as a fact.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His liver enzymes will be a letter we do not enjoy. He is alive to receive the letter.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Introit. That is the phase I will write in my book, which is not the chart.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Your book will stay in this building. I will not have the harbor papers naming a disease like a mass.\\\";\\n    \\\"Teddy Lark\\\", \\\"I held a retractor and thought about my mother. I don't know why I'm saying that.\\\";\\n    \\\"Mara Quill\\\", \\\"Because the room was quiet enough to hear yourself. That is the Hush, too.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It will not stay a kindness. A thing that slows a wound will want a price.\\\";\\n    \\\"Bashir Haddad\\\", \\\"All of my drugs want a price. We still use them.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I can work under it. If it comes again, call it early.\\\";\\n    \\\"Mara Quill\\\", \\\"I will call it when the vitals ask, not when I want to feel rare.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Good. Rarity is how a ward starts lying.\\\";\\n];\\n\\nconst BEFORE_4: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"June Harlow, glassblower. She coughed silver and then she stopped coughing, which I like less.\\\";\\n    \\\"Mara Quill\\\", \\\"Where?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Sacs along the mediastinum, and behind them a lesion that looks back. I am not being figurative.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Pericardium is open on the plan. If a sac bursts we will be swimming.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have extra suction. I have so much suction. I am the god of suction and I am frightened.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Doctor Lark, you will be the intern of suction. Gods wait outside.\\\";\\n    \\\"Mara Quill\\\", \\\"Laser on the stems, slow if the laser runs hot. If one opens, we clear the field before the next.\\\";\\n    \\\"June Harlow\\\", \\\"I was making a bowl for my wife. Tell her the color was right even if I don't finish it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"You can tell her yourself. I am very stubborn about that.\\\";\\n    \\\"Cordelia Vane\\\", \\\"This phase is Lacrimosa. If you finish a perfect pass, the next sac sometimes repeats it. I call that the Echo.\\\";\\n    \\\"Mara Quill\\\", \\\"A copy of a good hand.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Then give it only a good hand. I will not have it learn my shake.\\\";\\n];\\n\\nconst AFTER_4: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"The eye is closed. I never want to say that about a person again and mean a lesion.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The Echo took your last clean pass and spent it on a sac you had not reached. It saved a second.\\\";\\n    \\\"Pet Nwosu\\\", \\\"It also saved the mess. I was ready for the mess and I am glad to be wrong.\\\";\\n    \\\"Bashir Haddad\\\", \\\"June is asking, in writing because the tube is still in, whether the bowl survived the annealer.\\\";\\n    \\\"Teddy Lark\\\", \\\"I called the studio. The bowl survived. I did not cry. That is a lie. I did not cry on the phone.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Put the bowl in the chart as a personal effect, not as a miracle.\\\";\\n    \\\"Mara Quill\\\", \\\"The miracle is a closed chest and a woman who wants a bowl. I will take it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Three waves. It likes threes. Remember that when it stops being polite.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Polite is not the word I have for a chest full of sacs.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Go eat. I will watch the Echo wear off. It should be gone in minutes.\\\";\\n    \\\"Mara Quill\\\", \\\"If it copies a mistake next time, we retire it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Agreed. A gift that repeats a sin is just a faster sin.\\\";\\n];\\n\\nconst BEFORE_5: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Nils Ferreira, night stoker at the foundry. He came in hot and the hot is not a fever we own.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Temperature is a number I do not say out loud near flammable interns.\\\";\\n    \\\"Teddy Lark\\\", \\\"I am only a little flammable.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Embers. They want cold before steel, and steel before the pull. If you cut one early it seeds.\\\";\\n    \\\"Mara Quill\\\", \\\"Cryoprobe first. Pet, you have used it on a wart and you will pretend this is a wart.\\\";\\n    \\\"Pet Nwosu\\\", \\\"It is a wart. I am very convincing.\\\";\\n    \\\"Mara Quill\\\", \\\"There will be heat rings across the field. When one passes, hands up. I would rather lose a second than a layer of him.\\\";\\n    \\\"Nils Ferreira\\\", \\\"Don't let the fire have the last word. I have spent thirty years answering it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"The fire can file its complaint with me. Breathe when I tell you, and then stop arguing.\\\";\\n    \\\"Cordelia Vane\\\", \\\"This is Dies Irae. It will try to make the embers into one animal.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Then we do not let it finish the sentence.\\\";\\n    \\\"Mara Quill\\\", \\\"Cold, then cut, then out. Say it back to me.\\\";\\n];\\n\\nconst AFTER_5: &[Line] = L![\\n    \\\"Pet Nwosu\\\", \\\"The last ember came apart in the forceps like bad coal. Nothing seeded.\\\";\\n    \\\"Mara Quill\\\", \\\"The ring crossed my knuckle and I lifted. The chart can say I was slow. The chart is welcome.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His temperature is a temperature again. I am writing it down with ordinary digits.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have never loved an ordinary digit more.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It merged once and you split the merge. That will make it angry or it will make it careful. I do not know which is worse.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Careful is worse. Angry I can staff for.\\\";\\n    \\\"Mara Quill\\\", \\\"Staff for both. I want a second team sleeping in the call room, not at home.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll sleep here. The chair knows me.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Nils asked if the foundry called. They did. He is not fired. I told them he is busy not dying.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will be the one who brings that sentence to him. I want to see a stoker smile.\\\";\\n    \\\"Mara Quill\\\", \\\"Then bring it, and come back. We are not done with the week.\\\";\\n    \\\"Cordelia Vane\\\", \\\"No. The requiem has movements left.\\\";\\n];\\n\\nconst BEFORE_6: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Petra Solano, cartographer. A mass at the root of the mesentery, and she still tried to finish a coastline in the waiting room.\\\";\\n    \\\"Mara Quill\\\", \\\"Circle it, lift it, gel the bed. If I nick what feeds the bowel we will know immediately.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I have the field wide. There is room for your hands and mine and still a margin.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The mass is not a strain daughter. It is older. It has been drawing itself for years.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Good. I would like one enemy tonight that does not multiply when looked at.\\\";\\n    \\\"Teddy Lark\\\", \\\"I put her maps in a folder so the blood can't have them. That is the most useful thing I have done.\\\";\\n    \\\"Petra Solano\\\", \\\"The cape on sheet four is wrong. If I don't wake up, the cape is still wrong. Fix the cape.\\\";\\n    \\\"Mara Quill\\\", \\\"You will fix your own cape. I am only fixing the thing under it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She is a terrible patient and an excellent reason. Anesthesia is in.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Whenever you are ready. I will follow the circle with the suction, not across it.\\\";\\n    \\\"Mara Quill\\\", \\\"Across it is how we lose the margin. Follow.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Bring her back with the cape unfixed. Let the living argue with the map.\\\";\\n];\\n\\nconst AFTER_6: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"The mass is out, in one piece, which felt like a vanity and was actually safer.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I will cut it in the lab and it will be dull under the lens. I am grateful for dull.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She wrote 'cape' on a pad before her eyes were fully open. The woman is a compass.\\\";\\n    \\\"Teddy Lark\\\", \\\"I told her the cape can wait until soup. She looked at me like I had insulted a coastline.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Leave her the pen. A pen is a smaller risk than the argument.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board meets in six hours. They will ask if the ward is under control.\\\";\\n    \\\"Mara Quill\\\", \\\"Tell them we did six operations and told the truth after each.\\\";\\n    \\\"Ottoline Voss\\\", \\\"They do not hear that as control.\\\";\\n    \\\"Mara Quill\\\", \\\"Then they are asking the wrong question of a hospital.\\\";\\n    \\\"Cordelia Vane\\\", \\\"There is one patient left on the night list. He came in without a name and then he had one. Soren Vale.\\\";\\n    \\\"Pet Nwosu\\\", \\\"What is wrong with Soren Vale?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Everything we have already seen, and the part where a heart stops on purpose.\\\";\\n];\\n\\nconst BEFORE_7: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Soren Vale. No next of kin on the card. The heart is the field. Cordelia, say the rest.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Libera Me. Nodules, sacs, embers, and then a stoppage that is written into him, not earned by blood loss.\\\";\\n    \\\"Bashir Haddad\\\", \\\"If it is written, my drugs will not argue it out. You will have to meet it with the paddles.\\\";\\n    \\\"Mara Quill\\\", \\\"How many stops?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Three, if it behaves like the page. Maybe it cannot count. Plan for three.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I will take the second pair of hands. When you are on the tendril I will be on whatever else is eating him.\\\";\\n    \\\"Teddy Lark\\\", \\\"Tell me where to stand so I am a help and not a story you tell later.\\\";\\n    \\\"Mara Quill\\\", \\\"Stand at the head with Bashir. If I ask for a clamp, you are already holding it.\\\";\\n    \\\"Ottoline Voss\\\", \\\"There is a last gift in the notes. Cordelia calls it the Duet. Two surgeons, one count.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It is not magic. It is an agreement the tissue seems to honor when two instruments mean the same thing.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we will mean it. Pet, you have the right hand of the field. I have the left.\\\";\\n    \\\"Soren Vale\\\", \\\"If there is a downbeat, don't miss it for my sake. I have missed enough of my own.\\\";\\n];\\n\\nconst AFTER_7: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Three shocks. Sinus after the third, thin as paper, and then it thickened.\\\";\\n    \\\"Mara Quill\\\", \\\"The tendril let go when both of us pulled on the quiet half of the beat. I will not pretend I understand it.\\\";\\n    \\\"Pet Nwosu\\\", \\\"You don't have to understand a door to close it. It is closed.\\\";\\n    \\\"Teddy Lark\\\", \\\"I did not drop the clamp. I am going to have that put on a cake.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board can have their dawn meeting. I will tell them the Night Ward kept the night.\\\";\\n    \\\"Cordelia Vane\\\", \\\"R.E.Q.U.I.E.M. is a case name, not a myth, as long as we write what we did and not what we felt.\\\";\\n    \\\"Mara Quill\\\", \\\"What I felt was a room full of people who stayed. Write that if you need a cause.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Soren asked if the choir from Tuesday is still in the lobby. They went home. I said they left the lights.\\\";\\n    \\\"Pet Nwosu\\\", \\\"My hands are shaking again. I am glad. It means the Hush went home too.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Go sleep in a real bed, Doctor Quill. The harbor will still be there at noon, making work.\\\";\\n    \\\"Mara Quill\\\", \\\"Wake me if a vitals page is ugly. Wake me if it is only strange. I would rather be early than sung about.\\\";\\n    \\\"Cordelia Vane\\\", \\\"No one is singing. That is the best result this building knows.\\\";\\n];\\n\\npub const CALLOUTS: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Clean. Again.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Doctor, that's healthy tissue.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Vitals at forty. Push the IV. Now!\\\";\\n    \\\"Pet Nwosu\\\", \\\"Wrong instrument, Doctor.\\\";\\n    \\\"Mara Quill\\\", \\\"Lift off! Lift off!\\\";\\n    \\\"Bashir Haddad\\\", \\\"Charge. On the ghost beat.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Sinus rhythm. Stay with me.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The Hush is yours.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Echo the last sure hand.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Together. The Duet.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Hemostasis.\\\";\\n    \\\"Mara Quill\\\", \\\"The mass is ringed. Lift it.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Frost, then steel.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Three shocks. No more.\\\";\\n    \\\"Mara Quill\\\", \\\"Close the field.\\\";\\n    \\\"Teddy Lark\\\", \\\"Still with us. Still with us.\\\";\\n];\\n\\npub fn callout(i: u8) -> &'static str {\\n    CALLOUTS.get(i as usize).map(|l| l.text).unwrap_or(\\\"\\\")\\n}\\n\\npub fn callout_who(i: u8) -> &'static str {\\n    CALLOUTS.get(i as usize).map(|l| l.who).unwrap_or(\\\"\\\")\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/story.rs has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/story.rs has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/story.rs\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"//! Paper-theatre lines. Indices, not copies, live in the sim.\\n\\n#[derive(Clone, Copy)]\\npub struct Line {\\n    pub who: &'static str,\\n    pub text: &'static str,\\n}\\n\\nmacro_rules! L {\\n    ($($who:literal, $text:literal);* $(;)?) => {\\n        &[ $(Line { who: $who, text: $text }),* ]\\n    };\\n}\\n\\npub fn block(case_id: i8, after: bool) -> &'static [Line] {\\n    match (case_id, after) {\\n        (0, false) => BEFORE_0,\\n        (0, true) => AFTER_0,\\n        (1, false) => BEFORE_1,\\n        (1, true) => AFTER_1,\\n        (2, false) => BEFORE_2,\\n        (2, true) => AFTER_2,\\n        (3, false) => BEFORE_3,\\n        (3, true) => AFTER_3,\\n        (4, false) => BEFORE_4,\\n        (4, true) => AFTER_4,\\n        (5, false) => BEFORE_5,\\n        (5, true) => AFTER_5,\\n        (6, false) => BEFORE_6,\\n        (6, true) => AFTER_6,\\n        (7, false) => BEFORE_7,\\n        (7, true) => AFTER_7,\\n        _ => AFTER_7,\\n    }\\n}\\n\\npub fn all_lines() -> Vec<Line> {\\n    let mut v = Vec::new();\\n    for case_id in 0..8 {\\n        v.extend_from_slice(block(case_id, false));\\n        v.extend_from_slice(block(case_id, true));\\n    }\\n    v.extend_from_slice(CALLOUTS);\\n    v\\n}\\n\\nconst BEFORE_0: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Night Ward, Mercy Harbor General. Port Verity is under a storm and the ferry is late.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Mara Quill, you lead tonight. I will be in the gallery, not in your light.\\\";\\n    \\\"Mara Quill\\\", \\\"Understood, Chief. Who is on the table?\\\";\\n    \\\"Bashir Haddad\\\", \\\"Anton Deverell, crane crew at the west dock. A cable walked off the drum and took the forearm.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I have the field set. My hands are noisy tonight. Say if you want them off the retractors.\\\";\\n    \\\"Mara Quill\\\", \\\"Stay. I trust the work more than the tremor.\\\";\\n    \\\"Teddy Lark\\\", \\\"I labeled the suction twice, because last time I labeled it once and Bashir looked at me like weather.\\\";\\n    \\\"Bashir Haddad\\\", \\\"The look stands. Pressure is soft. He lost blood on the ramp.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Nothing in the smear but rope fiber and seawater. No strain. A plain wound, if any wound is plain.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we do a plain thing well. Pet, count me in.\\\";\\n    \\\"Pet Nwosu\\\", \\\"On your word. Scalpel, then the bleed, then we close what the cable opened.\\\";\\n    \\\"Anton Deverell\\\", \\\"Don't let them take the arm. I still have a shift on Thursday.\\\";\\n];\\n\\nconst AFTER_0: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Pulse is a working pulse. He will keep the arm.\\\";\\n    \\\"Pet Nwosu\\\", \\\"The last stitch sat down clean. I felt the tremor go quiet for it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have decided surgery is just sewing, if sewing could file a complaint.\\\";\\n    \\\"Mara Quill\\\", \\\"Write the chart. Cable injury, forearm, closure sound. No poetry.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Poetry is how this ward gets careless. Good work, Doctor Quill.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I kept the fiber. The harbor puts strange gifts in a wound. This one was only rope.\\\";\\n    \\\"Mara Quill\\\", \\\"Only rope is enough for one night.\\\";\\n    \\\"Bashir Haddad\\\", \\\"He asked for Thursday. I told him Thursday is a rumor until the dressing comes off.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll sit with the monitor. Go wash. Your shoulders are up by your ears.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will fetch coffee that tastes like a bandage. It is all the machine knows.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Drink it standing. The board wants the ward's numbers by dawn.\\\";\\n    \\\"Mara Quill\\\", \\\"The ward's numbers are a man with a Thursday. They can wait until he wakes.\\\";\\n];\\n\\nconst BEFORE_1: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Briony Pell, navigator on the evening ferry. Belly pain since the bar, then a faint on the stairs.\\\";\\n    \\\"Mara Quill\\\", \\\"Any fever?\\\";\\n    \\\"Bashir Haddad\\\", \\\"Low. She is guarding the right side. I do not like the silence in there.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Abdomen is prepped. There is a shadow on the scan I cannot name.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Name it after you see it. Shadows in this hospital have been earning worse names.\\\";\\n    \\\"Teddy Lark\\\", \\\"I brought the scanner up from imaging. The orderly said it whistles when it is happy.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we will let it whistle. Hidden things first, then whatever is feeding the bleed.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The ferry company is already on the phone. They are not invited into this room.\\\";\\n    \\\"Briony Pell\\\", \\\"Tell them the boat can leave without me. Tell my brother where I am.\\\";\\n    \\\"Mara Quill\\\", \\\"Your brother will hear it from us, not from a clerk. Pet, lights.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Lights. I have the forceps warm.\\\";\\n    \\\"Cordelia Vane\\\", \\\"If you find something that is not hers, do not put it in the bin. Bag it for me.\\\";\\n];\\n\\nconst AFTER_1: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"A shard of glass and a small feeder. Both out. The bowel wall held.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Glass from the harbor bar, not from a body that grew it. I am relieved and I resent the relief.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She is asking for water she cannot have yet. That is a good argument.\\\";\\n    \\\"Pet Nwosu\\\", \\\"The scanner sang once and then behaved. I have decided to like it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will write 'behaved' in the log. It is the nicest thing I have written all week.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The company will want a cause. Give them glass and a fall. Give them nothing else.\\\";\\n    \\\"Mara Quill\\\", \\\"Nothing else is what we found. I want that to stay true.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Stay is not a promise the Night Ward knows how to keep.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Vitals are bored. Bored is my favorite vital sign.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Go speak to the brother. I will mind the drains.\\\";\\n    \\\"Teddy Lark\\\", \\\"I can mind a drain. I have minded worse, including myself.\\\";\\n    \\\"Mara Quill\\\", \\\"Mind it, then. And if the numbers change, you shout. You do not editorialize.\\\";\\n];\\n\\nconst BEFORE_2: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Casper Lang. He conducts the civic choir. A rib gave way on the podium and something under it did not.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Airway is mine. He desaturated in the lift and came back angry, which I respect.\\\";\\n    \\\"Mara Quill\\\", \\\"Bone, then the tear beneath, then we close the skin he conducts with.\\\";\\n    \\\"Pet Nwosu\\\", \\\"If the rib is turned, I will turn it back before you stitch. Say the word and I will stop if my hands wander.\\\";\\n    \\\"Teddy Lark\\\", \\\"The choir is in the lobby singing very quietly, which is somehow louder.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I looked at his blood because that is what I do when a room feels staged. It is only blood.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we treat the man, not the feeling.\\\";\\n    \\\"Casper Lang\\\", \\\"If I go out, tell them the downbeat was late. It was not their fault.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Nobody is going out. You will hate the tube and then you will forget it.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Doctor Quill, if he arrests you have two attempts on a resident's budget. Use them like they are yours.\\\";\\n    \\\"Mara Quill\\\", \\\"I would rather not use them at all.\\\";\\n    \\\"Pet Nwosu\\\", \\\"On your word. The field is a small country. We know the roads.\\\";\\n];\\n\\nconst AFTER_2: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"He arrested and he came back on your shock. Sinus is sulking, but it is sinus.\\\";\\n    \\\"Mara Quill\\\", \\\"The rib sits. The tear is closed. I do not want to feel that proud of a flatline.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Pride is not what that was. That was a hand on a paddle and a count you did not rush.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have never been so glad to hear a machine complain.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The lobby will want a hymn. They can have one when he can hear it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I will say this once. His arrest looked like a body running out of blood, not like a body being played.\\\";\\n    \\\"Mara Quill\\\", \\\"Played?\\\";\\n    \\\"Cordelia Vane\\\", \\\"A word I am not ready to defend. Forget it if tomorrow is quiet.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Tomorrow is never the point. The next hour is the point.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll chart the shock as a single, successful, on the beat. They will ask.\\\";\\n    \\\"Mara Quill\\\", \\\"Tell them the truth. The beat was there. We met it.\\\";\\n    \\\"Teddy Lark\\\", \\\"I am going to go stand in the lobby and not sing. It will be my contribution.\\\";\\n];\\n\\nconst BEFORE_3: &[Line] = L![\\n    \\\"Cordelia Vane\\\", \\\"Idris Okonkwo, keeper at the north light. Liver lesion, and the lesion has daughters.\\\";\\n    \\\"Mara Quill\\\", \\\"Daughters is not a clinical word.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Look at the film and choose a better one. They were not there at dusk. They are there now.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board has a name they want used if this spreads. I have not agreed to their name.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His pressure is proud and his temperature is not. I can hold him. I cannot hold a rumor.\\\";\\n    \\\"Pet Nwosu\\\", \\\"If they move, I need you to say so. My eyes are good. My hands will need a second.\\\";\\n    \\\"Teddy Lark\\\", \\\"I read about a stillness some surgeons get when the room goes thin. I thought it was a story for interns.\\\";\\n    \\\"Mara Quill\\\", \\\"If it is real, it will be a tool, not a story. What do you call it, Cordelia?\\\";\\n    \\\"Cordelia Vane\\\", \\\"I call the stillness the Hush. I call the lesion's family by a case name: R.E.Q.U.I.E.M.\\\";\\n    \\\"Ottoline Voss\\\", \\\"You will not put that on a form.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The form can say multifocal lesion. The room can know what it is fighting.\\\";\\n    \\\"Mara Quill\\\", \\\"Then the room knows. Idris, we are going to take them out one voice at a time.\\\";\\n];\\n\\nconst AFTER_3: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"They split when the laser finished, and the children were smaller and meaner. They are gone.\\\";\\n    \\\"Pet Nwosu\\\", \\\"When you called the Hush, my tremor stopped as if it had been asked. I want that written down as a fact.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His liver enzymes will be a letter we do not enjoy. He is alive to receive the letter.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Introit. That is the phase I will write in my book, which is not the chart.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Your book will stay in this building. I will not have the harbor papers naming a disease like a mass.\\\";\\n    \\\"Teddy Lark\\\", \\\"I held a retractor and thought about my mother. I don't know why I'm saying that.\\\";\\n    \\\"Mara Quill\\\", \\\"Because the room was quiet enough to hear yourself. That is the Hush, too.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It will not stay a kindness. A thing that slows a wound will want a price.\\\";\\n    \\\"Bashir Haddad\\\", \\\"All of my drugs want a price. We still use them.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I can work under it. If it comes again, call it early.\\\";\\n    \\\"Mara Quill\\\", \\\"I will call it when the vitals ask, not when I want to feel rare.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Good. Rarity is how a ward starts lying.\\\";\\n];\\n\\nconst BEFORE_4: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"June Harlow, glassblower. She coughed silver and then she stopped coughing, which I like less.\\\";\\n    \\\"Mara Quill\\\", \\\"Where?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Sacs along the mediastinum, and behind them a lesion that looks back. I am not being figurative.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Pericardium is open on the plan. If a sac bursts we will be swimming.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have extra suction. I have so much suction. I am the god of suction and I am frightened.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Doctor Lark, you will be the intern of suction. Gods wait outside.\\\";\\n    \\\"Mara Quill\\\", \\\"Laser on the stems, slow if the laser runs hot. If one opens, we clear the field before the next.\\\";\\n    \\\"June Harlow\\\", \\\"I was making a bowl for my wife. Tell her the color was right even if I don't finish it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"You can tell her yourself. I am very stubborn about that.\\\";\\n    \\\"Cordelia Vane\\\", \\\"This phase is Lacrimosa. If you finish a perfect pass, the next sac sometimes repeats it. I call that the Echo.\\\";\\n    \\\"Mara Quill\\\", \\\"A copy of a good hand.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Then give it only a good hand. I will not have it learn my shake.\\\";\\n];\\n\\nconst AFTER_4: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"The eye is closed. I never want to say that about a person again and mean a lesion.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The Echo took your last clean pass and spent it on a sac you had not reached. It saved a second.\\\";\\n    \\\"Pet Nwosu\\\", \\\"It also saved the mess. I was ready for the mess and I am glad to be wrong.\\\";\\n    \\\"Bashir Haddad\\\", \\\"June is asking, in writing because the tube is still in, whether the bowl survived the annealer.\\\";\\n    \\\"Teddy Lark\\\", \\\"I called the studio. The bowl survived. I did not cry. That is a lie. I did not cry on the phone.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Put the bowl in the chart as a personal effect, not as a miracle.\\\";\\n    \\\"Mara Quill\\\", \\\"The miracle is a closed chest and a woman who wants a bowl. I will take it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Three waves. It likes threes. Remember that when it stops being polite.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Polite is not the word I have for a chest full of sacs.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Go eat. I will watch the Echo wear off. It should be gone in minutes.\\\";\\n    \\\"Mara Quill\\\", \\\"If it copies a mistake next time, we retire it.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Agreed. A gift that repeats a sin is just a faster sin.\\\";\\n];\\n\\nconst BEFORE_5: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Nils Ferreira, night stoker at the foundry. He came in hot and the hot is not a fever we own.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Temperature is a number I do not say out loud near flammable interns.\\\";\\n    \\\"Teddy Lark\\\", \\\"I am only a little flammable.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Embers. They want cold before steel, and steel before the pull. If you cut one early it seeds.\\\";\\n    \\\"Mara Quill\\\", \\\"Cryoprobe first. Pet, you have used it on a wart and you will pretend this is a wart.\\\";\\n    \\\"Pet Nwosu\\\", \\\"It is a wart. I am very convincing.\\\";\\n    \\\"Mara Quill\\\", \\\"There will be heat rings across the field. When one passes, hands up. I would rather lose a second than a layer of him.\\\";\\n    \\\"Nils Ferreira\\\", \\\"Don't let the fire have the last word. I have spent thirty years answering it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"The fire can file its complaint with me. Breathe when I tell you, and then stop arguing.\\\";\\n    \\\"Cordelia Vane\\\", \\\"This is Dies Irae. It will try to make the embers into one animal.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Then we do not let it finish the sentence.\\\";\\n    \\\"Mara Quill\\\", \\\"Cold, then cut, then out. Say it back to me.\\\";\\n];\\n\\nconst AFTER_5: &[Line] = L![\\n    \\\"Pet Nwosu\\\", \\\"The last ember came apart in the forceps like bad coal. Nothing seeded.\\\";\\n    \\\"Mara Quill\\\", \\\"The ring crossed my knuckle and I lifted. The chart can say I was slow. The chart is welcome.\\\";\\n    \\\"Bashir Haddad\\\", \\\"His temperature is a temperature again. I am writing it down with ordinary digits.\\\";\\n    \\\"Teddy Lark\\\", \\\"I have never loved an ordinary digit more.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It merged once and you split the merge. That will make it angry or it will make it careful. I do not know which is worse.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Careful is worse. Angry I can staff for.\\\";\\n    \\\"Mara Quill\\\", \\\"Staff for both. I want a second team sleeping in the call room, not at home.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I'll sleep here. The chair knows me.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Nils asked if the foundry called. They did. He is not fired. I told them he is busy not dying.\\\";\\n    \\\"Teddy Lark\\\", \\\"I will be the one who brings that sentence to him. I want to see a stoker smile.\\\";\\n    \\\"Mara Quill\\\", \\\"Then bring it, and come back. We are not done with the week.\\\";\\n    \\\"Cordelia Vane\\\", \\\"No. The requiem has movements left.\\\";\\n];\\n\\nconst BEFORE_6: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Petra Solano, cartographer. A mass at the root of the mesentery, and she still tried to finish a coastline in the waiting room.\\\";\\n    \\\"Mara Quill\\\", \\\"Circle it, lift it, gel the bed. If I nick what feeds the bowel we will know immediately.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I have the field wide. There is room for your hands and mine and still a margin.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The mass is not a strain daughter. It is older. It has been drawing itself for years.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Good. I would like one enemy tonight that does not multiply when looked at.\\\";\\n    \\\"Teddy Lark\\\", \\\"I put her maps in a folder so the blood can't have them. That is the most useful thing I have done.\\\";\\n    \\\"Petra Solano\\\", \\\"The cape on sheet four is wrong. If I don't wake up, the cape is still wrong. Fix the cape.\\\";\\n    \\\"Mara Quill\\\", \\\"You will fix your own cape. I am only fixing the thing under it.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She is a terrible patient and an excellent reason. Anesthesia is in.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Whenever you are ready. I will follow the circle with the suction, not across it.\\\";\\n    \\\"Mara Quill\\\", \\\"Across it is how we lose the margin. Follow.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Bring her back with the cape unfixed. Let the living argue with the map.\\\";\\n];\\n\\nconst AFTER_6: &[Line] = L![\\n    \\\"Mara Quill\\\", \\\"The mass is out, in one piece, which felt like a vanity and was actually safer.\\\";\\n    \\\"Cordelia Vane\\\", \\\"I will cut it in the lab and it will be dull under the lens. I am grateful for dull.\\\";\\n    \\\"Bashir Haddad\\\", \\\"She wrote 'cape' on a pad before her eyes were fully open. The woman is a compass.\\\";\\n    \\\"Teddy Lark\\\", \\\"I told her the cape can wait until soup. She looked at me like I had insulted a coastline.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Leave her the pen. A pen is a smaller risk than the argument.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board meets in six hours. They will ask if the ward is under control.\\\";\\n    \\\"Mara Quill\\\", \\\"Tell them we did six operations and told the truth after each.\\\";\\n    \\\"Ottoline Voss\\\", \\\"They do not hear that as control.\\\";\\n    \\\"Mara Quill\\\", \\\"Then they are asking the wrong question of a hospital.\\\";\\n    \\\"Cordelia Vane\\\", \\\"There is one patient left on the night list. He came in without a name and then he had one. Soren Vale.\\\";\\n    \\\"Pet Nwosu\\\", \\\"What is wrong with Soren Vale?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Everything we have already seen, and the part where a heart stops on purpose.\\\";\\n];\\n\\nconst BEFORE_7: &[Line] = L![\\n    \\\"Ottoline Voss\\\", \\\"Soren Vale. No next of kin on the card. The heart is the field. Cordelia, say the rest.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Libera Me. Nodules, sacs, embers, and then a stoppage that is written into him, not earned by blood loss.\\\";\\n    \\\"Bashir Haddad\\\", \\\"If it is written, my drugs will not argue it out. You will have to meet it with the paddles.\\\";\\n    \\\"Mara Quill\\\", \\\"How many stops?\\\";\\n    \\\"Cordelia Vane\\\", \\\"Three, if it behaves like the page. Maybe it cannot count. Plan for three.\\\";\\n    \\\"Pet Nwosu\\\", \\\"I will take the second pair of hands. When you are on the tendril I will be on whatever else is eating him.\\\";\\n    \\\"Teddy Lark\\\", \\\"Tell me where to stand so I am a help and not a story you tell later.\\\";\\n    \\\"Mara Quill\\\", \\\"Stand at the head with Bashir. If I ask for a clamp, you are already holding it.\\\";\\n    \\\"Ottoline Voss\\\", \\\"There is a last gift in the notes. Cordelia calls it the Duet. Two surgeons, one count.\\\";\\n    \\\"Cordelia Vane\\\", \\\"It is not magic. It is an agreement the tissue seems to honor when two instruments mean the same thing.\\\";\\n    \\\"Mara Quill\\\", \\\"Then we will mean it. Pet, you have the right hand of the field. I have the left.\\\";\\n    \\\"Soren Vale\\\", \\\"If there is a downbeat, don't miss it for my sake. I have missed enough of my own.\\\";\\n];\\n\\nconst AFTER_7: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Three shocks. Sinus after the third, thin as paper, and then it thickened.\\\";\\n    \\\"Mara Quill\\\", \\\"The tendril let go when both of us pulled on the quiet half of the beat. I will not pretend I understand it.\\\";\\n    \\\"Pet Nwosu\\\", \\\"You don't have to understand a door to close it. It is closed.\\\";\\n    \\\"Teddy Lark\\\", \\\"I did not drop the clamp. I am going to have that put on a cake.\\\";\\n    \\\"Ottoline Voss\\\", \\\"The board can have their dawn meeting. I will tell them the Night Ward kept the night.\\\";\\n    \\\"Cordelia Vane\\\", \\\"R.E.Q.U.I.E.M. is a case name, not a myth, as long as we write what we did and not what we felt.\\\";\\n    \\\"Mara Quill\\\", \\\"What I felt was a room full of people who stayed. Write that if you need a cause.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Soren asked if the choir from Tuesday is still in the lobby. They went home. I said they left the lights.\\\";\\n    \\\"Pet Nwosu\\\", \\\"My hands are shaking again. I am glad. It means the Hush went home too.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Go sleep in a real bed, Doctor Quill. The harbor will still be there at noon, making work.\\\";\\n    \\\"Mara Quill\\\", \\\"Wake me if a vitals page is ugly. Wake me if it is only strange. I would rather be early than sung about.\\\";\\n    \\\"Cordelia Vane\\\", \\\"No one is singing. That is the best result this building knows.\\\";\\n];\\n\\npub const CALLOUTS: &[Line] = L![\\n    \\\"Bashir Haddad\\\", \\\"Clean. Again.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Doctor, that's healthy tissue.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Vitals at forty. Push the IV. Now!\\\";\\n    \\\"Pet Nwosu\\\", \\\"Wrong instrument, Doctor.\\\";\\n    \\\"Mara Quill\\\", \\\"Lift off! Lift off!\\\";\\n    \\\"Bashir Haddad\\\", \\\"Charge. On the ghost beat.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Sinus rhythm. Stay with me.\\\";\\n    \\\"Cordelia Vane\\\", \\\"The Hush is yours.\\\";\\n    \\\"Cordelia Vane\\\", \\\"Echo the last sure hand.\\\";\\n    \\\"Ottoline Voss\\\", \\\"Together. The Duet.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Hemostasis.\\\";\\n    \\\"Mara Quill\\\", \\\"The mass is ringed. Lift it.\\\";\\n    \\\"Pet Nwosu\\\", \\\"Frost, then steel.\\\";\\n    \\\"Bashir Haddad\\\", \\\"Three shocks. No more.\\\";\\n    \\\"Mara Quill\\\", \\\"Close the field.\\\";\\n    \\\"Teddy Lark\\\", \\\"Still with us. Still with us.\\\";\\n];\\n\\npub fn callout(i: u8) -> &'static str {\\n    CALLOUTS.get(i as usize).map(|l| l.text).unwrap_or(\\\"\\\")\\n}\\n\\npub fn callout_who(i: u8) -> &'static str {\\n    CALLOUTS.get(i as usize).map(|l| l.who).unwrap_or(\\\"\\\")\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"06fa750d-d7d0-4c0c-b942-3d0d31f17644"}
{"type":"assistant","message":{"id":"msg_64","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Counting lines in the document: 192 blocks plus 16 callouts equals 208.I will read STAGE.md and continue the implementation.","signature":""},{"type":"text","text":"The story is in. I’ll add the case table, the bot, and the sim, then compile."},{"type":"tool_use","id":"call-57a1de7b-1933-4b0e-b048-60f5c32047fc-52","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/content.rs","content":"//! Case tables. One source: the sim reads these, not a second handwritten copy.\n\nuse super::kinds::*;\n\npub const G_HUSH: u8 = 1;\npub const G_ECHO: u8 = 2;\npub const G_DUET: u8 = 4;\npub const NO_STRAIN: u8 = 255;\npub const KEEP_PLATE: u8 = 255;\n\n#[derive(Clone, Copy)]\npub struct SpawnDef {\n    pub kind: u8,\n    pub x: f32,\n    pub z: f32,\n    pub hidden: bool,\n    pub drain: f32,\n    pub axis: f32,\n}\n\n#[derive(Clone, Copy)]\npub struct PhaseDef {\n    pub spawns: &'static [SpawnDef],\n    pub checkpoint: bool,\n    pub strain: u8,\n    pub plate: u8,\n    pub callout: u8,\n    pub script_code: u8,\n    pub unlock: u8,\n    pub heat: bool,\n}\n\npub struct CaseDef {\n    pub name: &'static str,\n    pub patient: &'static str,\n    pub plate: u8,\n    pub timer: f32,\n    pub par: i32,\n    pub vitals: f32,\n    pub phases: &'static [PhaseDef],\n}\n\nfn s(kind: u8, x: f32, z: f32, hidden: bool, drain: f32, axis: f32) -> SpawnDef {\n    SpawnDef { kind, x, z, hidden, drain, axis }\n}\n\nconst C0_A: &[SpawnDef] = &[\n    s(K_LACERATION, -1.4, 0.2, false, 1.7, 0.3),\n    s(K_POOL, 1.5, -0.8, false, 1.1, 0.0),\n];\nconst C0_B: &[SpawnDef] = &[\n    s(K_INCISION, -2.4, 1.1, false, 0.0, 0.0),\n    s(K_INFLAM, 1.2, 1.15, false, 0.45, 0.0),\n];\nconst C1_A: &[SpawnDef] = &[\n    s(K_BLEEDER, -1.6, -0.2, false, 2.3, 0.2),\n    s(K_FOREIGN, 0.7, 0.9, true, 0.7, 0.5),\n];\nconst C1_B: &[SpawnDef] = &[\n    s(K_POLYP, 1.7, -1.0, false, 0.35, 0.0),\n    s(K_POOL, -0.3, 1.45, false, 0.55, 0.0),\n];\nconst C2_A: &[SpawnDef] = &[\n    s(K_BONE, 0.15, 0.15, false, 0.25, 0.0),\n    s(K_TETHER, -1.8, 1.05, false, 0.3, 0.15),\n];\nconst C2_B: &[SpawnDef] = &[\n    s(K_IV, 2.0, -1.4, false, 0.0, 0.0),\n    s(K_DRESSING, -0.15, -1.45, false, 0.2, 0.0),\n];\nconst C3_A: &[SpawnDef] = &[\n    s(K_NODULE, -1.5, 0.4, false, 0.4, 0.4),\n    s(K_NODULE, 0.3, 1.15, false, 0.4, 0.8),\n    s(K_NODULE, 1.55, -0.45, false, 0.4, 1.1),\n];\nconst C3_B: &[SpawnDef] = &[\n    s(K_NODULE, -1.15, -0.75, false, 0.45, 0.3),\n    s(K_NODULE, 1.2, 0.55, false, 0.45, 0.9),\n];\nconst C3_C: &[SpawnDef] = &[\n    s(K_NODULE, -0.35, 0.15, false, 0.4, 0.2),\n    s(K_NODULE, 1.35, -0.95, false, 0.4, 1.0),\n];\nconst C3_D: &[SpawnDef] = &[\n    s(K_POLYP, -1.55, 0.75, false, 0.25, 0.0),\n    s(K_POLYP, 0.05, -0.55, false, 0.25, 0.0),\n    s(K_POLYP, 1.5, 0.85, false, 0.25, 0.0),\n];\nconst C3_E: &[SpawnDef] = &[\n    s(K_LACERATION, 0.0, 0.25, false, 0.85, 0.4),\n    s(K_POOL, 1.55, 1.15, false, 0.45, 0.0),\n];\nconst C4_A: &[SpawnDef] = &[\n    s(K_SAC, 1.55, 0.25, false, 0.22, 0.0),\n    s(K_SAC, -1.55, 0.25, false, 0.22, 0.0),\n    s(K_SAC, 0.85, 1.3, false, 0.22, 0.0),\n    s(K_SAC, -0.85, 1.3, false, 0.22, 0.0),\n    s(K_SAC, 0.85, -1.1, false, 0.22, 0.0),\n    s(K_SAC, -0.85, -1.1, false, 0.22, 0.0),\n];\nconst C4_B: &[SpawnDef] = &[\n    s(K_SAC, 1.35, 0.55, false, 0.22, 0.0),\n    s(K_SAC, -1.7, 0.05, false, 0.22, 0.0),\n    s(K_SAC, 0.55, 1.4, false, 0.22, 0.0),\n    s(K_SAC, -0.6, 1.15, false, 0.22, 0.0),\n    s(K_SAC, 1.15, -0.95, false, 0.22, 0.0),\n    s(K_SAC, -1.05, -1.25, false, 0.22, 0.0),\n];\nconst C4_C: &[SpawnDef] = &[\n    s(K_SAC, 1.7, -0.15, false, 0.22, 0.0),\n    s(K_SAC, -1.3, 0.55, false, 0.22, 0.0),\n    s(K_SAC, 0.15, 1.45, false, 0.22, 0.0),\n    s(K_SAC, -0.95, 1.05, false, 0.22, 0.0),\n    s(K_SAC, 0.65, -1.25, false, 0.22, 0.0),\n    s(K_SAC, -1.45, -0.85, false, 0.22, 0.0),\n];\nconst C4_D: &[SpawnDef] = &[\n    s(K_EYE, 0.0, 0.15, false, 0.55, 0.0),\n    s(K_INFLAM, 1.75, -0.35, false, 0.3, 0.0),\n];\nconst C5_A: &[SpawnDef] = &[\n    s(K_EMBER, -1.65, 0.45, false, 0.35, 0.2),\n    s(K_EMBER, -0.45, 1.2, false, 0.35, 0.8),\n    s(K_EMBER, 0.7, 0.3, false, 0.35, 0.4),\n    s(K_EMBER, 1.55, 1.0, false, 0.35, 1.0),\n    s(K_EMBER, 0.05, -1.15, false, 0.35, 0.6),\n];\nconst C5_B: &[SpawnDef] = &[\n    s(K_EMBER, -0.8, 0.2, false, 0.4, 0.3),\n    s(K_EMBER, 0.15, 0.7, false, 0.4, 0.9),\n    s(K_EMBER, 0.9, -0.35, false, 0.4, 0.5),\n];\nconst C5_C: &[SpawnDef] = &[\n    s(K_EMBER, -0.4, 0.4, false, 0.45, 0.4),\n    s(K_EMBER, 0.85, 0.15, false, 0.45, 1.1),\n    s(K_BURN, 0.05, -1.25, false, 0.35, 0.0),\n];\nconst C6_A: &[SpawnDef] = &[\n    s(K_TUMOR, 0.0, 0.1, false, 0.7, 0.0),\n    s(K_LACERATION, -1.75, -0.75, false, 0.95, 0.5),\n    s(K_POOL, 1.65, 0.95, false, 0.5, 0.0),\n];\nconst C6_B: &[SpawnDef] = &[\n    s(K_BURN, -1.35, 1.15, false, 0.4, 0.0),\n    s(K_BLEEDER, 1.45, -1.05, false, 1.7, 1.2),\n];\nconst C7_A: &[SpawnDef] = &[\n    s(K_NODULE, -1.25, 0.55, false, 0.4, 0.4),\n    s(K_NODULE, 1.15, -0.35, false, 0.4, 0.9),\n    s(K_POOL, -0.15, 1.25, false, 0.75, 0.0),\n    s(K_POOL, 0.4, -1.15, false, 0.75, 0.0),\n];\nconst C7_B: &[SpawnDef] = &[\n    s(K_SAC, 1.4, 0.4, false, 0.25, 0.0),\n    s(K_SAC, -1.4, 0.15, false, 0.25, 0.0),\n    s(K_SAC, 0.2, 1.3, false, 0.25, 0.0),\n    s(K_SAC, -0.3, -1.2, false, 0.25, 0.0),\n];\nconst C7_C: &[SpawnDef] = &[\n    s(K_EMBER, -1.15, 0.35, false, 0.4, 0.3),\n    s(K_EMBER, 1.05, -0.25, false, 0.4, 0.8),\n    s(K_EMBER, 0.1, 1.15, false, 0.4, 1.2),\n];\nconst C7_E: &[SpawnDef] = &[s(K_INCISION, -1.5, 0.15, false, 0.0, 0.1)];\nconst C7_F: &[SpawnDef] = &[s(K_TENDRIL, 0.25, 0.15, false, 0.55, 0.45)];\nconst C7_G: &[SpawnDef] = &[s(K_DRESSING, 0.0, -0.15, false, 0.1, 0.0)];\n\nfn phase(\n    spawns: &'static [SpawnDef],\n    checkpoint: bool,\n    strain: u8,\n    callout: u8,\n    script_code: u8,\n    unlock: u8,\n    heat: bool,\n) -> PhaseDef {\n    PhaseDef { spawns, checkpoint, strain, plate: KEEP_PLATE, callout, script_code, unlock, heat }\n}\n\npub static CASES: [CaseDef; 8] = [\n    CaseDef {\n        name: \"The First Movement\",\n        patient: \"Anton Deverell\",\n        plate: 0,\n        timer: 170.0,\n        par: 900,\n        vitals: 76.0,\n        phases: &[\n            phase(C0_A, true, NO_STRAIN, 0, 0, 0, false),\n            phase(C0_B, true, NO_STRAIN, 11, 0, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"Salt in the Peritoneum\",\n        patient: \"Briony Pell\",\n        plate: 1,\n        timer: 180.0,\n        par: 900,\n        vitals: 72.0,\n        phases: &[\n            phase(C1_A, true, NO_STRAIN, 0, 0, 0, false),\n            phase(C1_B, true, NO_STRAIN, 0, 0, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"The Held Note\",\n        patient: \"Casper Lang\",\n        plate: 4,\n        timer: 190.0,\n        par: 900,\n        vitals: 70.0,\n        phases: &[\n            phase(C2_A, true, NO_STRAIN, 0, 0, 0, false),\n            phase(C2_B, true, NO_STRAIN, 3, 0, 0, false),\n            phase(&[], false, NO_STRAIN, 5, 1, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"Introit\",\n        patient: \"Idris Okonkwo\",\n        plate: 5,\n        timer: 240.0,\n        par: 1100,\n        vitals: 74.0,\n        phases: &[\n            phase(C3_A, true, 0, 0, 0, 0, false),\n            phase(C3_B, true, 1, 7, 0, G_HUSH, false),\n            phase(C3_C, false, NO_STRAIN, 0, 0, 0, false),\n            phase(C3_D, true, 2, 0, 0, 0, false),\n            phase(C3_E, true, 3, 11, 0, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"Lacrimosa\",\n        patient: \"June Harlow\",\n        plate: 7,\n        timer: 260.0,\n        par: 1200,\n        vitals: 70.0,\n        phases: &[\n            phase(C4_A, true, 4, 0, 0, 0, false),\n            phase(C4_B, true, 5, 8, 0, G_ECHO, false),\n            phase(C4_C, true, 6, 0, 0, 0, false),\n            phase(C4_D, true, 7, 0, 0, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"Dies Irae\",\n        patient: \"Nils Ferreira\",\n        plate: 3,\n        timer: 260.0,\n        par: 1200,\n        vitals: 68.0,\n        phases: &[\n            phase(C5_A, true, 8, 12, 0, 0, true),\n            phase(C5_B, true, 9, 4, 0, 0, true),\n            phase(C5_C, true, 10, 0, 0, 0, true),\n        ],\n    },\n    CaseDef {\n        name: \"Margin of the Map\",\n        patient: \"Petra Solano\",\n        plate: 2,\n        timer: 220.0,\n        par: 1100,\n        vitals: 72.0,\n        phases: &[\n            phase(C6_A, true, NO_STRAIN, 11, 0, 0, false),\n            phase(C6_B, true, NO_STRAIN, 0, 0, 0, false),\n        ],\n    },\n    CaseDef {\n        name: \"Libera Me\",\n        patient: \"Soren Vale\",\n        plate: 8,\n        timer: 280.0,\n        par: 1400,\n        vitals: 66.0,\n        phases: &[\n            phase(C7_A, true, 11, 0, 0, 0, false),\n            phase(C7_B, true, 12, 0, 0, 0, false),\n            phase(C7_C, true, 13, 12, 0, 0, true),\n            phase(&[], false, 14, 13, 3, 0, false),\n            phase(C7_E, true, 15, 9, 0, G_DUET, false),\n            phase(C7_F, true, 16, 0, 0, 0, false),\n            phase(C7_G, true, 17, 14, 0, 0, false),\n        ],\n    },\n];\n\npub fn case_def(id: u8) -> Option<&'static CaseDef> {\n    CASES.get(id as usize)\n}\n\npub const SURGEON_NAMES: [&str; 4] = [\"Mara Quill\", \"Pet Nwosu\", \"Bashir Haddad\", \"Teddy Lark\"];\n\npub const SEAT_COLOR: [[f32; 3]; 4] = [\n    [0.910, 0.267, 0.227],\n    [0.231, 0.510, 0.965],\n    [0.133, 0.773, 0.373],\n    [0.961, 0.718, 0.000],\n];\n\npub fn diff_drain(d: u8) -> f32 {\n    match d {\n       