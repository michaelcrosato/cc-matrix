{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-e08cbbf8-eec9-4cd7-b813-8d117746bf4f-19","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Hands of Harbor: the shipped sim, from a fresh scene.\\n\\nuse pav_core::games::surgery::{\\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\\n    TOOL_NAMES,\\n};\\nuse pav_core::games::Outcome;\\nuse pav_core::glam::Vec2;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\n10→use pav_core::Sim;\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn game(sim: &Sim) -> &Surgery {\\n    sim.play().unwrap().get::<Surgery>().unwrap()\\n}\\n\\n20→fn cmd(c: SurgeryCmd) -> InputFrame {\\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\\n}\\n\\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n30→    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    frame\\n}\\n40→\\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\\n    for t in 0..cap {\\n        if sim.outcome() != Outcome::Playing {\\n            return t;\\n        }\\n        let frame = drive(t, sim);\\n        sim.step(&frame);\\n    }\\n    cap\\n50→}\\n\\n#[test]\\nfn bot_drive_finishes_case_zero_from_empty_hands() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 8, extra: 1 }));\\n    assert!(game(&sim).bot_drive);\\n    assert!((game(&sim).skill - 1.0).abs() < 1e-6);\\n    let ticks = play_until(&mut sim, 60 * 30, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Won, \\\"t={ticks} {}\\\", status(&sim));\\n60→    assert_eq!(game(&sim).mode, 4, \\\"results mode {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\\n    for seed in 1..11 {\\n        for case in 0..8 {\\n            let scene = format!(\\\"surgery/case/{case}\\\");\\n            let mut sim = Sim::new(&scene, seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 420);\\n70→            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} {scene} t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.rank >= 4, \\\"seed {seed} case {case} rank {} {}\\\", g.rank, status(&sim));\\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/code\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 260);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} code t={ticks} {}\\\", status(&sim));\\n            assert!(game(&sim).rank >= 4, \\\"seed {seed} code {}\\\", status(&sim));\\n80→        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/campaign\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} campaign t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \\\"tools {:?}\\\", g.coverage.tools);\\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \\\"hazards {:?}\\\", g.coverage.hazards);\\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \\\"strains {:?}\\\", g.coverage.strains);\\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \\\"gifts {:?}\\\", g.coverage.gifts);\\n90→            assert!(g.coverage.code > 0, \\\"code {}\\\", g.coverage.code);\\n            assert!(g.best_chain() >= 5, \\\"chain {}\\\", g.best_chain());\\n        }\\n    }\\n}\\n\\n#[test]\\nfn idle_and_random_tool_lose_every_case() {\\n    let scenes = [\\n        \\\"surgery/case/0\\\",\\n100→        \\\"surgery/case/1\\\",\\n        \\\"surgery/case/2\\\",\\n        \\\"surgery/case/3\\\",\\n        \\\"surgery/case/4\\\",\\n        \\\"surgery/case/5\\\",\\n        \\\"surgery/case/6\\\",\\n        \\\"surgery/case/7\\\",\\n        \\\"surgery/code\\\",\\n    ];\\n    for scene in scenes {\\n110→        let mut idle = Sim::new(scene, 1).unwrap();\\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\\n        assert_eq!(idle.outcome(), Outcome::Lost, \\\"idle {scene} {}\\\", status(&idle));\\n\\n        let mut messy = Sim::new(scene, 1).unwrap();\\n        play_until(&mut messy, 60 * 400, |t, _| {\\n            let ang = t as f32 * 0.37;\\n            let tool = (t % 11) as u8;\\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\\n        });\\n120→        assert_eq!(messy.outcome(), Outcome::Lost, \\\"random {scene} {}\\\", status(&messy));\\n    }\\n}\\n\\n#[test]\\nfn snapshot_rewind_and_replay_match() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    sim.config.history_seconds = 8.0;\\n    for _ in 0..240 {\\n        let frame = sim.bot_input();\\n130→        sim.step(&frame);\\n    }\\n    let mut bytes = Vec::new();\\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\\n    let mut copy = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    copy.restore(state);\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n    for _ in 0..120 {\\n        let (a, b) = (sim.bot_input(), copy.bot_input());\\n140→        sim.step(&a);\\n        copy.step(&b);\\n    }\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n\\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90), \\\"rewind\\\");\\n    assert!(sim.rewind_to(tick), \\\"replay rewind\\\");\\n    assert_eq!(sim.state_hash(), hash);\\n\\n150→    let mut again = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    for frame in sim.recording.iter() {\\n        again.step(frame);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn overheat_is_sloppy_and_five_pools_chain() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n160→    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\\n    let (x, z) = {\\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\\\"polyp\\\");\\n        (h.x, h.z)\\n    };\\n    for _ in 0..180 {\\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\\n            break;\\n        }\\n170→        sim.step(&hand(x, z, LASER, true));\\n    }\\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \\\"sloppy {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    for _ in 0..5 {\\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\\n        let (x, z, id) = {\\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\\\"pool\\\");\\n180→            (h.x, h.z, h.id)\\n        };\\n        // A held tool keeps the last wound. Two idle frames let the cursor take the new pool.\\n        sim.step(&hand(x, z, SUCTION, false));\\n        sim.step(&hand(x, z, SUCTION, false));\\n        for _ in 0..120 {\\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\\n            if !alive {\\n                break;\\n            }\\n190→            sim.step(&hand(x, z, SUCTION, true));\\n        }\\n        assert!(\\n            !game(&sim).hazards.iter().any(|h| h.id == id && h.alive),\\n            \\\"pool {id} stayed {}\\\",\\n            status(&sim)\\n        );\\n    }\\n    let chain = game(&sim).best_chain();\\n    assert!(chain >= 5, \\\"chain {chain}\\\");\\n200→    assert_eq!(chain_mul(5), 1.25);\\n    assert_eq!(chain_mul(10), 1.5);\\n    assert_eq!(chain_mul(20), 2.0);\\n}\\n\\n#[test]\\nfn beat_window_code_window_and_checkpoint_retry() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    {\\n210→        let g = game(&sim);\\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\\n        assert!((g.heart.bpm - expect).abs() < 0.05, \\\"bpm {} vs {expect}\\\", g.heart.bpm);\\n    }\\n    let mut saw_on = false;\\n    let mut saw_off = false;\\n    for _ in 0..240 {\\n        sim.step(&InputFrame::default());\\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\\n220→        saw_on |= on;\\n        saw_off |= !on;\\n    }\\n    assert!(saw_on && saw_off, \\\"on-beat window never changed\\\");\\n    let _ = Heart::new(80.0);\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\\n    assert!(game(&sim).heart.flat, \\\"code did not start\\\");\\n230→    assert!(game(&sim).code_t > 0.0);\\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"missed code {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    for _ in 0..40 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let vitals = game(&sim).heart.vitals;\\n240→    assert!(vitals > 20.0, \\\"already dead before the kill\\\");\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n    sim.step(&cmd(SurgeryCmd::Retry));\\n    assert_eq!(sim.outcome(), Outcome::Playing, \\\"retry {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 3, \\\"back in the operation\\\");\\n    assert!(game(&sim).heart.vitals > 20.0, \\\"checkpoint vitals {}\\\", game(&sim).heart.vitals);\\n}\\n\\n#[test]\\n250→fn story_lines_are_filled_and_music_defaults_quiet() {\\n    let lines = all_lines();\\n    assert!(lines.len() >= 150, \\\"story lines {}\\\", lines.len());\\n    let banned = [\\\"Hope Hospital\\\", \\\"Caduceus\\\", \\\"Stiles\\\", \\\"GUILT\\\", \\\"Healing Touch\\\"];\\n    for line in &lines {\\n        assert!(!line.text.trim().is_empty(), \\\"empty line from {}\\\", line.who);\\n        assert!(!line.who.trim().is_empty());\\n        let blob = format!(\\\"{} {}\\\", line.who, line.text);\\n        assert!(!blob.contains(\\\"TODO\\\"), \\\"{blob}\\\");\\n        for word in banned {\\n260→            assert!(!blob.contains(word), \\\"{word} in {blob}\\\");\\n        }\\n    }\\n    for name in TOOL_NAMES.into_iter().chain(SURGEON_NAMES).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\\n        for word in banned {\\n            assert!(!name.contains(word), \\\"{word} in {name}\\\");\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Hands of Harbor: Second Opinion\\\");\\n    let sim = Sim::new(\\\"surgery/title\\\", 1).unwrap();\\n270→    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\\n    assert_eq!(rank_of(900, 900), 4);\\n    assert_eq!(rank_of(1035, 900), 5);\\n    assert_eq!(rank_of(449, 900), 0);\\n}\\n\\n/// `cargo test -p pav_core --test surgery -- --ignored --nocapture balance_sheet`\\n/// Prints wins, time, vitals left, and a par that would put the skill-1.0 mean on S.\\n280→#[test]\\n#[ignore]\\nfn balance_sheet() {\\n    let skills = [1.0_f32, 0.7, 0.4, 0.0];\\n    let scenes: Vec<String> = (0..8).map(|c| format!(\\\"surgery/case/{c}\\\")).chain([\\\"surgery/code\\\".into()]).collect();\\n    println!(\\\"skill case wins/5 time_s vitals score par suggested_par\\\");\\n    for skill in skills {\\n        for scene in &scenes {\\n            let mut wins = 0;\\n            let mut time = 0.0;\\n290→            let mut vitals = 0.0;\\n            let mut score = 0.0;\\n            let mut par = 0;\\n            for seed in 1..=5 {\\n                let mut sim = Sim::new(scene, seed).unwrap();\\n                sim.state.play.as_mut().unwrap().get_mut::<Surgery>().unwrap().skill = skill;\\n                let (outcome, _ticks) = sim.run_bot(60 * 420);\\n                let g = game(&sim);\\n                if outcome == Outcome::Won {\\n                    wins += 1;\\n300→                }\\n                time += g.elapsed;\\n                vitals += g.heart.vitals;\\n                score += g.total_score() as f32;\\n                par = g.par;\\n            }\\n            let mean_score = score / 5.0;\\n            let suggested = if skill == 1.0 { mean_score.round().max(1.0) as i32 } else { par };\\n            println!(\\n                \\\"{skill:.1} {scene} {wins}/5 {:.1} {:.1} {:.0} {par} {suggested}\\\",\\n310→                time / 5.0,\\n                vitals / 5.0,\\n                mean_score\\n            );\\n        }\\n    }\\n}\\n\",\"content_concise\":\"1→//! Hands of Harbor: the shipped sim, from a fresh scene.\\n\\nuse pav_core::games::surgery::{\\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\\n    TOOL_NAMES,\\n};\\nuse pav_core::games::Outcome;\\nuse pav_core::glam::Vec2;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\n10→use pav_core::Sim;\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn game(sim: &Sim) -> &Surgery {\\n    sim.play().unwrap().get::<Surgery>().unwrap()\\n}\\n\\n20→fn cmd(c: SurgeryCmd) -> InputFrame {\\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\\n}\\n\\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n30→    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    frame\\n}\\n40→\\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\\n    for t in 0..cap {\\n        if sim.outcome() != Outcome::Playing {\\n            return t;\\n        }\\n        let frame = drive(t, sim);\\n        sim.step(&frame);\\n    }\\n    cap\\n50→}\\n\\n#[test]\\nfn bot_drive_finishes_case_zero_from_empty_hands() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 8, extra: 1 }));\\n    assert!(game(&sim).bot_drive);\\n    assert!((game(&sim).skill - 1.0).abs() < 1e-6);\\n    let ticks = play_until(&mut sim, 60 * 30, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Won, \\\"t={ticks} {}\\\", status(&sim));\\n60→    assert_eq!(game(&sim).mode, 4, \\\"results mode {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\\n    for seed in 1..11 {\\n        for case in 0..8 {\\n            let scene = format!(\\\"surgery/case/{case}\\\");\\n            let mut sim = Sim::new(&scene, seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 420);\\n70→            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} {scene} t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.rank >= 4, \\\"seed {seed} case {case} rank {} {}\\\", g.rank, status(&sim));\\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/code\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 260);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} code t={ticks} {}\\\", status(&sim));\\n            assert!(game(&sim).rank >= 4, \\\"seed {seed} code {}\\\", status(&sim));\\n80→        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/campaign\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} campaign t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \\\"tools {:?}\\\", g.coverage.tools);\\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \\\"hazards {:?}\\\", g.coverage.hazards);\\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \\\"strains {:?}\\\", g.coverage.strains);\\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \\\"gifts {:?}\\\", g.coverage.gifts);\\n90→            assert!(g.coverage.code > 0, \\\"code {}\\\", g.coverage.code);\\n            assert!(g.best_chain() >= 5, \\\"chain {}\\\", g.best_chain());\\n        }\\n    }\\n}\\n\\n#[test]\\nfn idle_and_random_tool_lose_every_case() {\\n    let scenes = [\\n        \\\"surgery/case/0\\\",\\n100→        \\\"surgery/case/1\\\",\\n        \\\"surgery/case/2\\\",\\n        \\\"surgery/case/3\\\",\\n        \\\"surgery/case/4\\\",\\n        \\\"surgery/case/5\\\",\\n        \\\"surgery/case/6\\\",\\n        \\\"surgery/case/7\\\",\\n        \\\"surgery/code\\\",\\n    ];\\n    for scene in scenes {\\n110→        let mut idle = Sim::new(scene, 1).unwrap();\\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\\n        assert_eq!(idle.outcome(), Outcome::Lost, \\\"idle {scene} {}\\\", status(&idle));\\n\\n        let mut messy = Sim::new(scene, 1).unwrap();\\n        play_until(&mut messy, 60 * 400, |t, _| {\\n            let ang = t as f32 * 0.37;\\n            let tool = (t % 11) as u8;\\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\\n        });\\n120→        assert_eq!(messy.outcome(), Outcome::Lost, \\\"random {scene} {}\\\", status(&messy));\\n    }\\n}\\n\\n#[test]\\nfn snapshot_rewind_and_replay_match() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    sim.config.history_seconds = 8.0;\\n    for _ in 0..240 {\\n        let frame = sim.bot_input();\\n130→        sim.step(&frame);\\n    }\\n    let mut bytes = Vec::new();\\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\\n    let mut copy = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    copy.restore(state);\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n    for _ in 0..120 {\\n        let (a, b) = (sim.bot_input(), copy.bot_input());\\n140→        sim.step(&a);\\n        copy.step(&b);\\n    }\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n\\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90), \\\"rewind\\\");\\n    assert!(sim.rewind_to(tick), \\\"replay rewind\\\");\\n    assert_eq!(sim.state_hash(), hash);\\n\\n150→    let mut again = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    for frame in sim.recording.iter() {\\n        again.step(frame);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn overheat_is_sloppy_and_five_pools_chain() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n160→    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\\n    let (x, z) = {\\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\\\"polyp\\\");\\n        (h.x, h.z)\\n    };\\n    for _ in 0..180 {\\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\\n            break;\\n        }\\n170→        sim.step(&hand(x, z, LASER, true));\\n    }\\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \\\"sloppy {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    for _ in 0..5 {\\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\\n        let (x, z, id) = {\\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\\\"pool\\\");\\n180→            (h.x, h.z, h.id)\\n        };\\n        // A held tool keeps the last wound. Two idle frames let the cursor take the new pool.\\n        sim.step(&hand(x, z, SUCTION, false));\\n        sim.step(&hand(x, z, SUCTION, false));\\n        for _ in 0..120 {\\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\\n            if !alive {\\n                break;\\n            }\\n190→            sim.step(&hand(x, z, SUCTION, true));\\n        }\\n        assert!(\\n            !game(&sim).hazards.iter().any(|h| h.id == id && h.alive),\\n            \\\"pool {id} stayed {}\\\",\\n            status(&sim)\\n        );\\n    }\\n    let chain = game(&sim).best_chain();\\n    assert!(chain >= 5, \\\"chain {chain}\\\");\\n200→    assert_eq!(chain_mul(5), 1.25);\\n    assert_eq!(chain_mul(10), 1.5);\\n    assert_eq!(chain_mul(20), 2.0);\\n}\\n\\n#[test]\\nfn beat_window_code_window_and_checkpoint_retry() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    {\\n210→        let g = game(&sim);\\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\\n        assert!((g.heart.bpm - expect).abs() < 0.05, \\\"bpm {} vs {expect}\\\", g.heart.bpm);\\n    }\\n    let mut saw_on = false;\\n    let mut saw_off = false;\\n    for _ in 0..240 {\\n        sim.step(&InputFrame::default());\\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\\n220→        saw_on |= on;\\n        saw_off |= !on;\\n    }\\n    assert!(saw_on && saw_off, \\\"on-beat window never changed\\\");\\n    let _ = Heart::new(80.0);\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\\n    assert!(game(&sim).heart.flat, \\\"code did not start\\\");\\n230→    assert!(game(&sim).code_t > 0.0);\\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"missed code {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    for _ in 0..40 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let vitals = game(&sim).heart.vitals;\\n240→    assert!(vitals > 20.0, \\\"already dead before the kill\\\");\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n    sim.step(&cmd(SurgeryCmd::Retry));\\n    assert_eq!(sim.outcome(), Outcome::Playing, \\\"retry {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 3, \\\"back in the operation\\\");\\n    assert!(game(&sim).heart.vitals > 20.0, \\\"checkpoint vitals {}\\\", game(&sim).heart.vitals);\\n}\\n\\n#[test]\\n250→fn story_lines_are_filled_and_music_defaults_quiet() {\\n    let lines = all_lines();\\n    assert!(lines.len() >= 150, \\\"story lines {}\\\", lines.len());\\n    let banned = [\\\"Hope Hospital\\\", \\\"Caduceus\\\", \\\"Stiles\\\", \\\"GUILT\\\", \\\"Healing Touch\\\"];\\n    for line in &lines {\\n        assert!(!line.text.trim().is_empty(), \\\"empty line from {}\\\", line.who);\\n        assert!(!line.who.trim().is_empty());\\n        let blob = format!(\\\"{} {}\\\", line.who, line.text);\\n        assert!(!blob.contains(\\\"TODO\\\"), \\\"{blob}\\\");\\n        for word in banned {\\n260→            assert!(!blob.contains(word), \\\"{word} in {blob}\\\");\\n        }\\n    }\\n    for name in TOOL_NAMES.into_iter().chain(SURGEON_NAMES).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\\n        for word in banned {\\n            assert!(!name.contains(word), \\\"{word} in {name}\\\");\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Hands of Harbor: Second Opinion\\\");\\n    let sim = Sim::new(\\\"surgery/title\\\", 1).unwrap();\\n270→    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\\n    assert_eq!(rank_of(900, 900), 4);\\n    assert_eq!(rank_of(1035, 900), 5);\\n    assert_eq!(rank_of(449, 900), 0);\\n}\\n\\n/// `cargo test -p pav_core --test surgery -- --ignored --nocapture balance_sheet`\\n/// Prints wins, time, vitals left, and a par that would put the skill-1.0 mean on S.\\n280→#[test]\\n#[ignore]\\nfn balance_sheet() {\\n    let skills = [1.0_f32, 0.7, 0.4, 0.0];\\n    let scenes: Vec<String> = (0..8).map(|c| format!(\\\"surgery/case/{c}\\\")).chain([\\\"surgery/code\\\".into()]).collect();\\n    println!(\\\"skill case wins/5 time_s vitals score par suggested_par\\\");\\n    for skill in skills {\\n        for scene in &scenes {\\n            let mut wins = 0;\\n            let mut time = 0.0;\\n290→            let mut vitals = 0.0;\\n            let mut score = 0.0;\\n            let mut par = 0;\\n            for seed in 1..=5 {\\n                let mut sim = Sim::new(scene, seed).unwrap();\\n                sim.state.play.as_mut().unwrap().get_mut::<Surgery>().unwrap().skill = skill;\\n                let (outcome, _ticks) = sim.run_bot(60 * 420);\\n                let g = game(&sim);\\n                if outcome == Outcome::Won {\\n                    wins += 1;\\n300→                }\\n                time += g.elapsed;\\n                vitals += g.heart.vitals;\\n                score += g.total_score() as f32;\\n                par = g.par;\\n            }\\n            let mean_score = score / 5.0;\\n            let suggested = if skill == 1.0 { mean_score.round().max(1.0) as i32 } else { par };\\n            println!(\\n                \\\"{skill:.1} {scene} {wins}/5 {:.1} {:.1} {:.0} {par} {suggested}\\\",\\n310→                time / 5.0,\\n                vitals / 5.0,\\n                mean_score\\n            );\\n        }\\n    }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/tests/surgery.rs\",\"offset\":null,\"raw_output\":\"//! Hands of Harbor: the shipped sim, from a fresh scene.\\n\\nuse pav_core::games::surgery::{\\n    all_lines, rank_of, chain_mul, Heart, Surgery, CASES, K_POLYP, K_POOL, LASER, R_SLOPPY, SUCTION, SURGEON_NAMES, TITLE,\\n    TOOL_NAMES,\\n};\\nuse pav_core::games::Outcome;\\nuse pav_core::glam::Vec2;\\nuse pav_core::input::{surg, InputFrame, SurgeonInput, SurgeryCmd};\\nuse pav_core::Sim;\\n\\nfn status(sim: &Sim) -> String {\\n    sim.play().unwrap().status(sim).to_string()\\n}\\n\\nfn game(sim: &Sim) -> &Surgery {\\n    sim.play().unwrap().get::<Surgery>().unwrap()\\n}\\n\\nfn cmd(c: SurgeryCmd) -> InputFrame {\\n    InputFrame { surgery_cmd: Some(c), ..InputFrame::default() }\\n}\\n\\nfn hand(x: f32, z: f32, tool: u8, use_on: bool) -> InputFrame {\\n    let mut held = surg::AIM_ABSOLUTE | surg::SNAP;\\n    if use_on {\\n        held |= surg::USE;\\n    }\\n    let mut frame = InputFrame::default();\\n    frame.surgeons[0] = SurgeonInput {\\n        active: true,\\n        aim: Vec2::new(x, z),\\n        held,\\n        pressed: 0,\\n        tool,\\n        pressure: 1.0,\\n    };\\n    frame\\n}\\n\\nfn play_until(sim: &mut Sim, cap: u64, drive: impl Fn(u64, &Sim) -> InputFrame) -> u64 {\\n    for t in 0..cap {\\n        if sim.outcome() != Outcome::Playing {\\n            return t;\\n        }\\n        let frame = drive(t, sim);\\n        sim.step(&frame);\\n    }\\n    cap\\n}\\n\\n#[test]\\nfn bot_drive_finishes_case_zero_from_empty_hands() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 8, extra: 1 }));\\n    assert!(game(&sim).bot_drive);\\n    assert!((game(&sim).skill - 1.0).abs() < 1e-6);\\n    let ticks = play_until(&mut sim, 60 * 30, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Won, \\\"t={ticks} {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 4, \\\"results mode {}\\\", status(&sim));\\n}\\n\\n#[test]\\nfn skill1_bot_wins_every_case_code_and_campaign_on_ten_seeds() {\\n    for seed in 1..11 {\\n        for case in 0..8 {\\n            let scene = format!(\\\"surgery/case/{case}\\\");\\n            let mut sim = Sim::new(&scene, seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 420);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} {scene} t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.rank >= 4, \\\"seed {seed} case {case} rank {} {}\\\", g.rank, status(&sim));\\n            assert_eq!(g.rank, rank_of(g.total_score(), g.par));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/code\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 260);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} code t={ticks} {}\\\", status(&sim));\\n            assert!(game(&sim).rank >= 4, \\\"seed {seed} code {}\\\", status(&sim));\\n        }\\n        {\\n            let mut sim = Sim::new(\\\"surgery/campaign\\\", seed).unwrap();\\n            let (outcome, ticks) = sim.run_bot(60 * 2200);\\n            assert_eq!(outcome, Outcome::Won, \\\"seed {seed} campaign t={ticks} {}\\\", status(&sim));\\n            let g = game(&sim);\\n            assert!(g.coverage.tools.iter().all(|n| *n > 0), \\\"tools {:?}\\\", g.coverage.tools);\\n            assert!(g.coverage.hazards.iter().all(|n| *n > 0), \\\"hazards {:?}\\\", g.coverage.hazards);\\n            assert!(g.coverage.strains.iter().all(|n| *n > 0), \\\"strains {:?}\\\", g.coverage.strains);\\n            assert!(g.coverage.gifts.iter().all(|n| *n > 0), \\\"gifts {:?}\\\", g.coverage.gifts);\\n            assert!(g.coverage.code > 0, \\\"code {}\\\", g.coverage.code);\\n            assert!(g.best_chain() >= 5, \\\"chain {}\\\", g.best_chain());\\n        }\\n    }\\n}\\n\\n#[test]\\nfn idle_and_random_tool_lose_every_case() {\\n    let scenes = [\\n        \\\"surgery/case/0\\\",\\n        \\\"surgery/case/1\\\",\\n        \\\"surgery/case/2\\\",\\n        \\\"surgery/case/3\\\",\\n        \\\"surgery/case/4\\\",\\n        \\\"surgery/case/5\\\",\\n        \\\"surgery/case/6\\\",\\n        \\\"surgery/case/7\\\",\\n        \\\"surgery/code\\\",\\n    ];\\n    for scene in scenes {\\n        let mut idle = Sim::new(scene, 1).unwrap();\\n        play_until(&mut idle, 60 * 400, |_, _| InputFrame::default());\\n        assert_eq!(idle.outcome(), Outcome::Lost, \\\"idle {scene} {}\\\", status(&idle));\\n\\n        let mut messy = Sim::new(scene, 1).unwrap();\\n        play_until(&mut messy, 60 * 400, |t, _| {\\n            let ang = t as f32 * 0.37;\\n            let tool = (t % 11) as u8;\\n            hand(ang.cos() * 3.2, ang.sin() * 2.1, tool, true)\\n        });\\n        assert_eq!(messy.outcome(), Outcome::Lost, \\\"random {scene} {}\\\", status(&messy));\\n    }\\n}\\n\\n#[test]\\nfn snapshot_rewind_and_replay_match() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    sim.config.history_seconds = 8.0;\\n    for _ in 0..240 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let mut bytes = Vec::new();\\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\\n    let state = ciborium::from_reader(bytes.as_slice()).unwrap();\\n    let mut copy = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    copy.restore(state);\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n    for _ in 0..120 {\\n        let (a, b) = (sim.bot_input(), copy.bot_input());\\n        sim.step(&a);\\n        copy.step(&b);\\n    }\\n    assert_eq!(copy.state_hash(), sim.state_hash());\\n\\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\\n    assert!(sim.rewind_to(tick - 90), \\\"rewind\\\");\\n    assert!(sim.rewind_to(tick), \\\"replay rewind\\\");\\n    assert_eq!(sim.state_hash(), hash);\\n\\n    let mut again = Sim::new(\\\"surgery/case/0\\\", 4).unwrap();\\n    for frame in sim.recording.iter() {\\n        again.step(frame);\\n    }\\n    assert_eq!(again.state_hash(), hash);\\n}\\n\\n#[test]\\nfn overheat_is_sloppy_and_five_pools_chain() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POLYP)));\\n    let (x, z) = {\\n        let h = game(&sim).hazards.iter().find(|h| h.alive && h.kind == K_POLYP).expect(\\\"polyp\\\");\\n        (h.x, h.z)\\n    };\\n    for _ in 0..180 {\\n        if game(&sim).coverage.ratings[R_SLOPPY as usize] > 0 {\\n            break;\\n        }\\n        sim.step(&hand(x, z, LASER, true));\\n    }\\n    assert!(game(&sim).coverage.ratings[R_SLOPPY as usize] > 0, \\\"sloppy {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 1).unwrap();\\n    sim.step(&InputFrame::default());\\n    for _ in 0..5 {\\n        sim.step(&cmd(SurgeryCmd::SpawnHazard(K_POOL)));\\n        let (x, z, id) = {\\n            let h = game(&sim).hazards.iter().rev().find(|h| h.alive && h.kind == K_POOL).expect(\\\"pool\\\");\\n            (h.x, h.z, h.id)\\n        };\\n        // A held tool keeps the last wound. Two idle frames let the cursor take the new pool.\\n        sim.step(&hand(x, z, SUCTION, false));\\n        sim.step(&hand(x, z, SUCTION, false));\\n        for _ in 0..120 {\\n            let alive = game(&sim).hazards.iter().any(|h| h.id == id && h.alive);\\n            if !alive {\\n                break;\\n            }\\n            sim.step(&hand(x, z, SUCTION, true));\\n        }\\n        assert!(\\n            !game(&sim).hazards.iter().any(|h| h.id == id && h.alive),\\n            \\\"pool {id} stayed {}\\\",\\n            status(&sim)\\n        );\\n    }\\n    let chain = game(&sim).best_chain();\\n    assert!(chain >= 5, \\\"chain {chain}\\\");\\n    assert_eq!(chain_mul(5), 1.25);\\n    assert_eq!(chain_mul(10), 1.5);\\n    assert_eq!(chain_mul(20), 2.0);\\n}\\n\\n#[test]\\nfn beat_window_code_window_and_checkpoint_retry() {\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    {\\n        let g = game(&sim);\\n        let t = (1.0 - g.heart.vitals.clamp(0.0, 100.0) / 100.0).clamp(0.0, 1.0);\\n        let expect = (72.0 + 76.0 * t) * g.tune.heart_coupling.clamp(0.25, 2.0);\\n        assert!((g.heart.bpm - expect).abs() < 0.05, \\\"bpm {} vs {expect}\\\", g.heart.bpm);\\n    }\\n    let mut saw_on = false;\\n    let mut saw_off = false;\\n    for _ in 0..240 {\\n        sim.step(&InputFrame::default());\\n        let on = game(&sim).heart.on_beat(game(&sim).tune.beat_window_ms);\\n        saw_on |= on;\\n        saw_off |= !on;\\n    }\\n    assert!(saw_on && saw_off, \\\"on-beat window never changed\\\");\\n    let _ = Heart::new(80.0);\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    sim.step(&InputFrame::default());\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 4, extra: 0 }));\\n    assert!(game(&sim).heart.flat, \\\"code did not start\\\");\\n    assert!(game(&sim).code_t > 0.0);\\n    play_until(&mut sim, 60 * 8, |_, _| InputFrame::default());\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"missed code {}\\\", status(&sim));\\n\\n    let mut sim = Sim::new(\\\"surgery/case/0\\\", 2).unwrap();\\n    for _ in 0..40 {\\n        let frame = sim.bot_input();\\n        sim.step(&frame);\\n    }\\n    let vitals = game(&sim).heart.vitals;\\n    assert!(vitals > 20.0, \\\"already dead before the kill\\\");\\n    sim.step(&cmd(SurgeryCmd::Dev { what: 5, extra: 0 }));\\n    assert_eq!(sim.outcome(), Outcome::Lost, \\\"{}\\\", status(&sim));\\n    sim.step(&cmd(SurgeryCmd::Retry));\\n    assert_eq!(sim.outcome(), Outcome::Playing, \\\"retry {}\\\", status(&sim));\\n    assert_eq!(game(&sim).mode, 3, \\\"back in the operation\\\");\\n    assert!(game(&sim).heart.vitals > 20.0, \\\"checkpoint vitals {}\\\", game(&sim).heart.vitals);\\n}\\n\\n#[test]\\nfn story_lines_are_filled_and_music_defaults_quiet() {\\n    let lines = all_lines();\\n    assert!(lines.len() >= 150, \\\"story lines {}\\\", lines.len());\\n    let banned = [\\\"Hope Hospital\\\", \\\"Caduceus\\\", \\\"Stiles\\\", \\\"GUILT\\\", \\\"Healing Touch\\\"];\\n    for line in &lines {\\n        assert!(!line.text.trim().is_empty(), \\\"empty line from {}\\\", line.who);\\n        assert!(!line.who.trim().is_empty());\\n        let blob = format!(\\\"{} {}\\\", line.who, line.text);\\n        assert!(!blob.contains(\\\"TODO\\\"), \\\"{blob}\\\");\\n        for word in banned {\\n            assert!(!blob.contains(word), \\\"{word} in {blob}\\\");\\n        }\\n    }\\n    for name in TOOL_NAMES.into_iter().chain(SURGEON_NAMES).chain(CASES.iter().map(|c| c.name)).chain(CASES.iter().map(|c| c.patient)) {\\n        for word in banned {\\n            assert!(!name.contains(word), \\\"{word} in {name}\\\");\\n        }\\n    }\\n    assert_eq!(TITLE, \\\"Hands of Harbor: Second Opinion\\\");\\n    let sim = Sim::new(\\\"surgery/title\\\", 1).unwrap();\\n    assert!((game(&sim).tune.music - 0.10).abs() < 1e-6);\\n    assert!((game(&sim).tune.effects - 0.80).abs() < 1e-6);\\n    assert!((game(&sim).tune.voices - 0.70).abs() < 1e-6);\\n    assert_eq!(rank_of(900, 900), 4);\\n    assert_eq!(rank_of(1035, 900), 5);\\n    assert_eq!(rank_of(449, 900), 0);\\n}\\n\\n/// `cargo test -p pav_core --test surgery -- --ignored --nocapture balance_sheet`\\n/// Prints wins, time, vitals left, and a par that would put the skill-1.0 mean on S.\\n#[test]\\n#[ignore]\\nfn balance_sheet() {\\n    let skills = [1.0_f32, 0.7, 0.4, 0.0];\\n    let scenes: Vec<String> = (0..8).map(|c| format!(\\\"surgery/case/{c}\\\")).chain([\\\"surgery/code\\\".into()]).collect();\\n    println!(\\\"skill case wins/5 time_s vitals score par suggested_par\\\");\\n    for skill in skills {\\n        for scene in &scenes {\\n            let mut wins = 0;\\n            let mut time = 0.0;\\n            let mut vitals = 0.0;\\n            let mut score = 0.0;\\n            let mut par = 0;\\n            for seed in 1..=5 {\\n                let mut sim = Sim::new(scene, seed).unwrap();\\n                sim.state.play.as_mut().unwrap().get_mut::<Surgery>().unwrap().skill = skill;\\n                let (outcome, _ticks) = sim.run_bot(60 * 420);\\n                let g = game(&sim);\\n                if outcome == Outcome::Won {\\n                    wins += 1;\\n                }\\n                time += g.elapsed;\\n                vitals += g.heart.vitals;\\n                score += g.total_score() as f32;\\n                par = g.par;\\n            }\\n            let mean_score = score / 5.0;\\n            let suggested = if skill == 1.0 { mean_score.round().max(1.0) as i32 } else { par };\\n            println!(\\n                \\\"{skill:.1} {scene} {wins}/5 {:.1} {:.1} {:.0} {par} {suggested}\\\",\\n                time / 5.0,\\n                vitals / 5.0,\\n                mean_score\\n            );\\n        }\\n    }\\n}\\n\",\"total_lines\":316}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e08cbbf8-eec9-4cd7-b813-8d117746bf4f-20","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"750→                    let y_focus = line.starts_with('>');\\n                    let color = if y_focus {\\n                        egui::Color32::from_rgb(255, 214, 120)\\n                    } else {\\n                        egui::Color32::from_rgb(220, 226, 230)\\n                    };\\n                    ui.horizontal(|ui| {\\n                        ui.add_space(220.0);\\n                        ui.label(egui::RichText::new(line).size(if y_focus { 48.0 } else { 40.0 }).color(color));\\n                    });\\n760→                    ui.add_space(8.0);\\n                }\\n                if shell.screen == Screen::Attract {\\n                    ui.label(egui::RichText::new(\\\"DEMO\\\").size(64.0).strong().color(egui::Color32::from_rgb(255, 80, 70)));\\n                }\\n            }\\n        }\\n    });\\n}\\n\\n770→fn draw_hud(ui: &egui::Ui, op: Option<&SurgeryFrame>) {\\n    let Some(op) = op else { return };\\n    let ctx = ui.ctx();\\n    egui::Area::new(egui::Id::new(\\\"harbor_hud\\\")).anchor(egui::Align2::LEFT_TOP, egui::vec2(36.0, 24.0)).show(ctx, |ui| {\\n        let beat = if op.on_beat { \\\"♥\\\" } else { \\\"♡\\\" };\\n        ui.label(\\n            egui::RichText::new(format!(\\\"{beat}  {:.0}\\\", op.vitals)).size(64.0).strong().color(egui::Color32::from_rgb(230, 70, 70)),\\n        );\\n        ui.label(egui::RichText::new(format!(\\\"BPM {:.0}\\\", op.bpm)).size(32.0));\\n    });\\n780→    egui::Area::new(egui::Id::new(\\\"harbor_time\\\")).anchor(egui::Align2::RIGHT_TOP, egui::vec2(-36.0, 24.0)).show(ctx, |ui| {\\n        let t = op.timer.max(0.0) as i32;\\n        ui.label(egui::RichText::new(format!(\\\"{:02}:{:02}\\\", t / 60, t % 60)).size(64.0).strong());\\n    });\\n    if !op.callout.is_empty() {\\n        egui::Area::new(egui::Id::new(\\\"harbor_now\\\")).anchor(egui::Align2::CENTER_TOP, egui::vec2(0.0, 28.0)).show(ctx, |ui| {\\n            ui.label(egui::RichText::new(format!(\\\"NOW  {}\\\", op.callout)).size(32.0).color(egui::Color32::from_rgb(230, 220, 180)));\\n        });\\n    }\\n    if !op.banner.is_empty() {\\n790→        egui::Area::new(egui::Id::new(\\\"harbor_banner\\\")).anchor(egui::Align2::CENTER_CENTER, egui::vec2(0.0, -80.0)).show(ctx, |ui| {\\n            ui.label(egui::RichText::new(&op.banner).size(54.0).strong().color(egui::Color32::from_rgb(255, 230, 180)));\\n        });\\n    }\\n}\\n\\n/// Dev Reset All is a labelled row the step() path also exposes.\\npub fn dev_reset(shell: &mut Shell) -> Cmd {\\n    shell.reset_sliders()\\n}\\n800→\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    fn press(extra: Input) -> Input {\\n        Input { any: true, dt: 0.016, ..extra }\\n    }\\n\\n    #[test]\\n810→    fn keyboard_pad_and_mouse_walk_the_shell() {\\n        let mut s = Shell::new();\\n        assert_eq!(s.screen_name(), \\\"title\\\");\\n        assert_eq!(s.prompt(\\\"confirm\\\"), \\\"Enter\\\");\\n        s.step(press(Input { confirm: true, device: Some(DeviceKind::KeyboardMouse), ..Default::default() }));\\n        assert_eq!(s.screen_name(), \\\"menu\\\");\\n        assert_eq!(s.prompt(\\\"confirm\\\"), \\\"Enter\\\");\\n        s.step(press(Input { device: Some(DeviceKind::Gamepad), ..Default::default() }));\\n        assert_eq!(s.prompt(\\\"confirm\\\"), \\\"Cross\\\");\\n        assert_eq!(s.prompt(\\\"use\\\"), \\\"R2\\\");\\n820→        s.xbox = true;\\n        assert_eq!(s.prompt(\\\"confirm\\\"), \\\"A\\\");\\n        assert_eq!(s.prompt(\\\"back\\\"), \\\"B\\\");\\n        s.xbox = false;\\n        s.step(press(Input { pointer: Some([400.0, 280.0 + 2.0 * 72.0 + 8.0]), device: Some(DeviceKind::KeyboardMouse), ..Default::default() }));\\n        assert_eq!(s.focus(), 2);\\n        s.step(press(Input { click: true, ..Default::default() }));\\n        assert_eq!(s.screen_name(), \\\"files\\\");\\n        s.step(press(Input { back: true, ..Default::default() }));\\n        assert_eq!(s.screen_name(), \\\"menu\\\");\\n830→        s.focus = 1;\\n        s.step(press(Input { confirm: true, ..Default::default() }));\\n        assert_eq!(s.screen_name(), \\\"difficulty\\\");\\n        s.step(press(Input { down: true, ..Defau