e surgery shell. Copy, so they ride in a recorded `InputFrame`.\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\npub enum SurgeryCmd {\\n    Retry,\\n    Skip,\\n    SetTune { id: u8, value: f32 },\\n    ResetTune,\\n    LoadCase(u8),\\n    LoadCampaign,\\n    LoadCode,\\n    SetDifficulty(u8),\\n    /// 0 immortal, 1 freeze timer, 2 full gift, 3 one-hit, 4 force code, 5 kill, 6 win, 7 jump phase.\\n    Dev { what: u8, extra: u8 },\\n    SpawnHazard(u8),\\n}\\n\\nimpl InputFrame {\\n    pub fn down(&self, b: u32) -> bool {\\n        self.held & b != 0\\n    }\\n    pub fn just(&self, b: u32) -> bool {\\n        self.pressed & b != 0\\n    }\\n}\\n\",\"total_lines\":128}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"b6f00153-1f3b-4b5d-a999-3b57d7e25f4d"}
