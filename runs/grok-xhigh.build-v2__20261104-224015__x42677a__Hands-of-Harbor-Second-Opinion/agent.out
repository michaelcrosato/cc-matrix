   }\\n            let raw = egui::RawInput {\\n                screen_rect: Some(screen),\\n160→                time: Some(pass as f64 / 60.0),\\n                predicted_dt: 1.0 / 60.0,\\n                events,\\n                ..Default::default()\\n            };\\n            self.touch.swipes.begin_frame();\\n            let last = pass + 1 == PASSES + input.click.is_some() as usize;\\n            let out = ctx.run_ui(raw, |ui| {\\n                let root = ui.layer_id();\\n                let ctx = ui.ctx().clone();\\n170→                if let Some(g) = game {\\n                    let proj = Projector { vp, size: screen.size() };\\n                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\\n                    let given = self.game.ui(&ctx, g, &proj);\\n                    if pass == PASSES {\\n                        commands = given;\\n                    }\\n                }\\n                crate::game_lines(&ctx, hud_lines);\\n                if touch && game.is_some() {\\n180→                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\\\"minimap\\\"), 0);\\n                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\\n                    let covered = self.game.any_open();\\n                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\\n                }\\n                if last {\\n                    layers = window_layers(&ctx, root, screen);\\n                }\\n            });\\n            let mut out = out;\\n190→            textures.append(std::mem::take(&mut out.textures_delta));\\n            output = Some(out);\\n        }\\n        let output = output.unwrap();\\n        let reading = self.read(&output, screen, layers);\\n        let pixels_per_point = output.pixels_per_point;\\n        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\\n        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }\\n    }\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_ui/src/headless.rs\",\"offset\":110,\"limit\":90,\"raw_output\":\"    /// Opens or closes a window by name; false if there is no such window.\\n    pub fn set_open(&mut self, name: &str, open: bool) -> bool {\\n        self.flag(name).map(|f| *f = open).is_some()\\n    }\\n\\n    /// Draws one frame of the UI over a `width` x `height` view whose camera is `vp`: Shardfall's\\n    /// (`game`), or a `pav_core::games` game's HUD lines (`hud`).\\n    pub fn frame(\\n        &mut self,\\n        game: Option<&GameFrame>,\\n        hud_lines: &HudFrame,\\n        vp: Mat4,\\n        width: u32,\\n        height: u32,\\n        input: Input,\\n    ) -> Drawn {\\n        let ctx = egui::Context::default();\\n        let touch = self.device == Device::Touch;\\n        crate::touch_style(&ctx, touch);\\n        ctx.all_styles_mut(|s| {\\n            s.animation_time = 0.0;\\n            s.interaction.tooltip_delay = 0.0;\\n        });\\n        self.game.touch = touch;\\n        self.game.tree.touch = touch;\\n        self.game.pad = self.device == Device::Gamepad;\\n        self.game.tree.pad = self.game.pad;\\n        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\\n        let mut textures = egui::TexturesDelta::default();\\n        let mut commands = Vec::new();\\n        let mut output = None;\\n        let mut layers = Vec::new();\\n        for pass in 0..PASSES + input.click.is_some() as usize {\\n            let mut events = Vec::new();\\n            if let Some(p) = input.click.or(input.hover) {\\n                events.push(egui::Event::PointerMoved(p));\\n            }\\n            // The click lands in the last pass, once the windows are laid out.\\n            if let Some(p) = input.click.filter(|_| pass == PASSES) {\\n                for pressed in [true, false] {\\n                    events.push(egui::Event::PointerButton {\\n                        pos: p,\\n                        button: egui::PointerButton::Primary,\\n                        pressed,\\n                        modifiers: Default::default(),\\n                    });\\n                }\\n            }\\n            let raw = egui::RawInput {\\n                screen_rect: Some(screen),\\n                time: Some(pass as f64 / 60.0),\\n                predicted_dt: 1.0 / 60.0,\\n                events,\\n                ..Default::default()\\n            };\\n            self.touch.swipes.begin_frame();\\n            let last = pass + 1 == PASSES + input.click.is_some() as usize;\\n            let out = ctx.run_ui(raw, |ui| {\\n                let root = ui.layer_id();\\n                let ctx = ui.ctx().clone();\\n                if let Some(g) = game {\\n                    let proj = Projector { vp, size: screen.size() };\\n                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\\n                    let given = self.game.ui(&ctx, g, &proj);\\n                    if pass == PASSES {\\n                        commands = given;\\n                    }\\n                }\\n                crate::game_lines(&ctx, hud_lines);\\n                if touch && game.is_some() {\\n                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\\\"minimap\\\"), 0);\\n                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\\n                    let covered = self.game.any_open();\\n                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\\n                }\\n                if last {\\n                    layers = window_layers(&ctx, root, screen);\\n                }\\n            });\\n            let mut out = out;\\n            textures.append(std::mem::take(&mut out.textures_delta));\\n            output = Some(out);\\n        }\\n        let output = output.unwrap();\\n        let reading = self.read(&output, screen, layers);\\n        let pixels_per_point = output.pixels_per_point;\\n        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\\n        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }\\n    }\\n\\n\",\"total_lines\":369}}","is_error":false},{"type":"tool_result","tool_use_id":"call-6d464769-71e4-446e-82cb-4e7f143e545f-56","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"200→    pub fn clear_view_effects(&mut self) {\\n        self.events.clear();\\n        let _ = self.sim.drain_events();\\n        if let Some(gpu) = &mut self.gpu {\\n            gpu.builder = ViewBuilder::new();\\n            gpu.renderer.clear_particles();\\n            gpu.studio_mode = self.sim.studio_mode();\\n        }\\n    }\\n\\n210→    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\\n    /// cues, the way the game does (without blending). Called after every step.\\n    pub fn sync_camera(&mut self) {\\n        use pav_core::params::{ParamValue, apply_map};\\n        if self.live || self.sim.studio_active() {\\n            return;\\n        }\\n        let w = &self.sim.state.world;\\n        let now = w.current_room;\\n        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\\n220→        let c = &self.sim.state.courses;\\n        if c.cue_serial != self.cue_serial {\\n            self.cue_serial = c.cue_serial;\\n            // Like the game: each cue applies on top of the camera from before the first cue;\\n            // sweeps start at their `from` value (captures are single moments).\\n            match c.cue() {\\n                Some(cue) => {\\n                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\\n                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\\n                    let mut set = cue.set.clone();\\n230→                    for sw in &cue.sweep {\\n                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\\n                    }\\n                    if let Some(y) = set.get(\\\"yaw\\\").and_then(|v| v.as_f64()) {\\n                        set.insert(\\\"yaw\\\".into(), rot(y, q));\\n                    }\\n                    self.camera.params = base;\\n                    apply_map(&mut self.camera.params, &set);\\n                }\\n                None => {\\n240→                    if let Some(b) = self.cue_base.take() {\\n                        self.camera.params = b;\\n                    }\\n                }\\n            }\\n        }\\n        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\\n        if now != self.room_cam.as_ref().map(|r| r.0) {\\n            if let Some((_, saved)) = self.room_cam.take() {\\n                self.camera.params = saved;\",\"content_concise\":\"200→    pub fn clear_view_effects(&mut self) {\\n        self.events.clear();\\n        let _ = self.sim.drain_events();\\n        if let Some(gpu) = &mut self.gpu {\\n            gpu.builder = ViewBuilder::new();\\n            gpu.renderer.clear_particles();\\n            gpu.studio_mode = self.sim.studio_mode();\\n        }\\n    }\\n\\n210→    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\\n    /// cues, the way the game does (without blending). Called after every step.\\n    pub fn sync_camera(&mut self) {\\n        use pav_core::params::{ParamValue, apply_map};\\n        if self.live || self.sim.studio_active() {\\n            return;\\n        }\\n        let w = &self.sim.state.world;\\n        let now = w.current_room;\\n        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\\n220→        let c = &self.sim.state.courses;\\n        if c.cue_serial != self.cue_serial {\\n            self.cue_serial = c.cue_serial;\\n            // Like the game: each cue applies on top of the camera from before the first cue;\\n            // sweeps start at their `from` value (captures are single moments).\\n            match c.cue() {\\n                Some(cue) => {\\n                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\\n                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\\n                    let mut set = cue.set.clone();\\n230→                    for sw in &cue.sweep {\\n                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\\n                    }\\n                    if let Some(y) = set.get(\\\"yaw\\\").and_then(|v| v.as_f64()) {\\n                        set.insert(\\\"yaw\\\".into(), rot(y, q));\\n                    }\\n                    self.camera.params = base;\\n                    apply_map(&mut self.camera.params, &set);\\n                }\\n                None => {\\n240→                    if let Some(b) = self.cue_base.take() {\\n                        self.camera.params = b;\\n                    }\\n                }\\n            }\\n        }\\n        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\\n        if now != self.room_cam.as_ref().map(|r| r.0) {\\n            if let Some((_, saved)) = self.room_cam.take() {\\n                self.camera.params = saved;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_tools/src/session.rs\",\"offset\":200,\"limit\":50,\"raw_output\":\"    pu