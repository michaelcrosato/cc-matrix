abs() < 0.45 {\\n            return Some(t as u8);\\n        }\\n    }\\n    None\\n}\\n\\nfn snap_json(op: &SurgeryFrame, events: &[pav_core::SimEvent]) -> String {\\n    let mut hazards = Vec::new();\\n    for h in op.hazards.iter().filter(|h| h.alive).take(12) {\\n        hazards.push(serde_json::json!([\\n            h.id,\\n            h.kind,\\n            (h.x * 100.0).round() / 100.0,\\n            (h.z * 100.0).round() / 100.0,\\n            1,\\n            h.stage,\\n            (h.work * 100.0).round() / 100.0\\n        ]));\\n    }\\n    let mut cursors = Vec::new();\\n    for (i, c) in op.cursors.iter().enumerate() {\\n        cursors.push(serde_json::json!([\\n            i,\\n            (c.x * 100.0).round() / 100.0,\\n            (c.z * 100.0).round() / 100.0,\\n            c.tool,\\n            if c.active { 1 } else { 0 },\\n            c.score\\n        ]));\\n    }\\n    let mut cues = Vec::new();\\n    for e in events.iter().rev().take(8) {\\n        if let pav_core::SimEvent::Cue { id, .. } = e {\\n            cues.push(*id);\\n        }\\n    }\\n    serde_json::json!({\\n        \\\"k\\\": \\\"s\\\",\\n        \\\"v\\\": (op.vitals * 10.0).round() / 10.0,\\n        \\\"b\\\": op.bpm.round(),\\n        \\\"p\\\": (op.phase * 100.0).round() / 100.0,\\n        \\\"f\\\": if op.flat { 1 } else { 0 },\\n        \\\"tm\\\": (op.timer * 10.0).round() / 10.0,\\n        \\\"cd\\\": (op.code_t * 10.0).round() / 10.0,\\n        \\\"h\\\": hazards,\\n        \\\"u\\\": cursors,\\n        \\\"q\\\": cues,\\n    })\\n    .to_string()\\n}\\n\\nfn standings_json(present: &[u8], op: &SurgeryFrame) -> String {\\n    let ids: Vec<u8> = if present.is_empty() { vec![0] } else { present.to_vec() };\\n    let mut scores = serde_json::Map::new();\\n    for id in &ids {\\n        let score = op.cursors.get(*id as usize).map(|c| c.score).unwrap_or(0);\\n        scores.insert(id.to_string(), serde_json::json!(score));\\n    }\\n    serde_json::json!({\\n        \\\"standings\\\": [ids],\\n        \\\"won\\\": op.vitals > 0.0,\\n        \\\"scores\\\": scores,\\n    })\\n    .to_string()\\n}\\n\\nfn status_json(shell: &Shell, op: Option<&SurgeryFrame>) -> String {\\n    let music = op.map(|o| o.music).unwrap_or(0.10);\\n    let cursors: Vec<serde_json::Value> = op\\n        .map(|o| {\\n            o.cursors\\n                .iter()\\n                .map(|c| serde_json::json!({ \\\"x\\\": c.x, \\\"z\\\": c.z, \\\"tool\\\": c.tool, \\\"active\\\": c.active }))\\n                .collect()\\n        })\\n        .unwrap_or_default();\\n    serde_json::json!({\\n        \\\"screen\\\": shell.screen_name(),\\n        \\\"focus\\\": shell.focus(),\\n        \\\"device\\\": if shell.device == DeviceKind::Gamepad { \\\"gamepad\\\" } else { \\\"keyboard\\\" },\\n        \\\"xbox\\\": shell.xbox,\\n        \\\"music\\\": format!(\\\"{music:.2}\\\"),\\n        \\\"title\\\": TITLE,\\n        \\\"cursors\\\": cursors,\\n        \\\"vitals\\\": op.map(|o| o.vitals),\\n        \\\"bpm\\\": op.map(|o| o.bpm),\\n        \\\"timer\\\": op.map(|o| o.timer),\\n        \\\"mode\\\": op.map(|o| o.mode),\\n    })\\n    .to_string()\\n}\\n\\nfn publish_status(s: &str) {\\n    STATUS.with(|c| *c.borrow_mut() = s.to_string());\\n}\\n\\nthread_local! {\\n    static STATUS: RefCell<String> = const { RefCell::new(String::new()) };\\n    static BURST: Cell<u32> = const { Cell::new(0) };\\n    static HOOKED: Cell<bool> = const { Cell::new(false) };\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn drain_hook(app: &mut App) {\\n    let n = BURST.with(|b| b.replace(0));\\n    if n > 0 {\\n        if let Some(host) = &app.host {\\n            host.burst(n);\\n        }\\n    }\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nfn install_hook(app: &App) {\\n    if HOOKED.with(|h| h.get()) {\\n        return;\\n    }\\n    use wasm_bindgen::JsCast;\\n    let Some(win) = web_sys::window() else { return };\\n    let obj = js_sys::Object::new();\\n    let status = wasm_bindgen::closure::Closure::wrap(Box::new(|| {\\n        STATUS.with(|s| wasm_bindgen::JsValue::from_str(&s.borrow()))\\n\",\"total_lines\":886}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3f2d5f94-8fad-4ec8-a1e3-0dcb3286e877-22","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→    /// Host or dedicated server: one Code Blue, seeded, with the given player slots active.\\n    pub fn boot_hub_round(sim: &mut Sim, seed: u64, slots: &[u8], quiet: bool) {\\n        sim.state.rng = crate::rng::Rng::new(seed);\\n        let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) else { return };\\n        g.boot_code();\\n        for s in &mut g.surgeons {\\n            s.active = false;\\n        }\\n        for &id in slots {\\n            let i = id as usize;\\n310→            if i < 4 {\\n                g.surgeons[i].active = true;\\n            }\\n        }\\n        g.players = slots.len().clamp(1, 4) as u8;\\n        g.hub_quiet = quiet;\\n        g.mode = M_OP;\\n    }\\n\\n    /// Client: draw from snapshots. The local hand is predicted in the tick.\\n320→    pub fn boot_mirror(&mut self) {\\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.outcome = Outcome::Playing;\\n        self.timer = 240.0;\\n        self.heart = Heart::new(70.0);\\n        self.hazards.clear();\\n        // Hub copies skip the plate. A full operative mesh stalls the iframe after one frame.\\n        self.hub_quiet = true;\\n330→    }\\n\\n    /// Replace the drawn world with a host snapshot. Cursors included; the tick then predicts the local hand.\\n    pub fn apply_mirror(\\n        &mut self,\\n        vitals: f32,\\n        bpm: f32,\\n        phase: f32,\\n        flat: bool,\\n        timer: f32,\\n340→        code_t: f32,\\n        hazards: &[(u32, u8, f32, f32, bool, u8, f32)],\\n        cursors: &[(u8, f32, f32, u8, bool, i32)],\\n    ) {\\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.heart.vitals = vitals.clamp(0.0, 100.0);\\n        self.heart.bpm = bpm.max(1.0);\\n        self.heart.phase = phase;\\n350→        self.heart.flat = flat;\\n        self.timer = timer;\\n        self.code_t = code_t;\\n        self.hazards.clear();\\n        for &(id, kind, x, z, alive, stage, work) in hazards {\\n            let mut h = Hazard::make(kind.min(K_BURN), x, z);\\n            h.id = id;\\n            h.alive = alive;\\n            h.stage = stage;\\n            h.work = work;\\n360→            h.hidden = false;\\n            self.hazards.push(h);\\n        }\\n        for &(slot, x, z, tool, active, score) in cursors {\\n            let i = slot as usize;\\n            if i < 4 {\\n                let s = &mut self.surgeons[i];\\n                s.x = x;\\n                s.z = z;\\n                s.tool = tool;\\n370→                s.active = active;\\n                s.score = score;\\n            }\\n        }\\n    }\\n\\n    pub fn pending_gift(&self) -> u8 {\\n        let (u, d) = (self.gifts_unlocked, self.gifts_used);\\n        if self.recent_unlock != 0 && u & self.recent_unlock != 0 && d & self.recent_unlock == 0 {\\n            return self.recent_unlock;\\n380→        }\\n        for bit in [content::G_HUSH, content::G_ECHO, content::G_DUET] {\\n            if u & bit != 0 && d & bit == 0 {\\n                return bit;\\n            }\\n        }\\n        0\\n    }\\n\\n    fn reset_hands(&mut self) {\\n390→        for (i, s) in self.surgeons.iter_mut().enumerate() {\\n            let name = s.name_i;\\n            *s = Surgeon::new(name);\\n            s.active = i == 0;\\n        }\\n    }\\n\\n    fn prepare_case(&mut self, id: u8) {\\n        let Some(def) = case_def(id) else { return };\\n        self.case_id = id as i8;\\n400→        self.code_blue = false;\\n        self.plate = def.plate;\\n        self.plate_next = def.plate;\\n        self.plate_blend = 1.0;\\n        self.timer = def.timer * content::diff_timer(self.difficulty);\\n        self.par = def.par;\\n        self.heart = Heart::new(def.vitals);\\n        self.hazards.clear();\\n        self.phase_i = 0;\\n        self.phase_ready = false;\\n410→        self.codes_left = content::diff_codes(self.difficulty);\\n        self.code_t = -1.0;\\n        self.code_scripted = false;\\n        self.shocks_need = 0;\\n        self.shocks_done = 0;\\n        self.pending_script = false;\\n        self.heat_on = false;\\n        self.heat_phase = false;\\n        self.heat_angle = 0.0;\\n        self.elapsed = 0.0;\",\"content_concise\":\"300→    /// Host or dedicated server: one Code Blue, seeded, with the given player slots active.\\n    pub fn boot_hub_round(sim: &mut Sim, seed: u64, slots: &[u8], quiet: bool) {\\n        sim.state.rng = crate::rng::Rng::new(seed);\\n        let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) else { return };\\n        g.boot_code();\\n        for s in &mut g.surgeons {\\n            s.active = false;\\n        }\\n        for &id in slots {\\n            let i = id as usize;\\n310→            if i < 4 {\\n                g.surgeons[i].active = true;\\n            }\\n        }\\n        g.players = slots.len().clamp(1, 4) as u8;\\n        g.hub_quiet = quiet;\\n        g.mode = M_OP;\\n    }\\n\\n    /// Client: draw from snapshots. The local hand is predicted in the tick.\\n320→    pub fn boot_mirror(&mut self) {\\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.outcome = Outcome::Playing;\\n        self.timer = 240.0;\\n        self.heart = Heart::new(70.0);\\n        self.hazards.clear();\\n        // Hub copies skip the plate. A full operative mesh stalls the iframe after one frame.\\n        self.hub_quiet = true;\\n330→    }\\n\\n    /// Replace the drawn world with a host snapshot. Cursors included; the tick then predicts the local han