tool: u8) -> Option<usize> {\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT || h.accepts(tool) {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d <= h.radius + 0.12 && d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n    best\\n}\\n\\nfn assist_aim(g: &Surgery, x: f32, z: f32, tool: u8, aim: glam::Vec2, dt: f32) -> glam::Vec2 {\\n    let scale = g.tune.aim_assist.clamp(0.0, 2.0);\\n    if scale <= 0.0 || aim.length_squared() < 0.0004 {\\n        return aim;\\n    }\\n    let mut best: Option<(f32, f32, f32)> = None;\\n    for h in &g.hazards {\\n        if !h.alive || h.kind == K_HEAT || !h.accepts(tool) {\\n            continue;\\n        }\\n        let dx = h.x - x;\\n        let dz = h.z - z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        if d < 1.2 && best.map(|(bd, _, _)| d < bd).unwrap_or(true) {\\n            best = Some((d, dx, dz));\\n\",\"total_lines\":787}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3de75f0a-ea18-4364-a4b4-7baa466de72b-95","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"115→                h.samples_need = 3;\\n            }\\n            K_FOREIGN => {\\n                h.need = 0.85;\\n                h.radius = 0.55;\\n120→                h.drain = 0.45;\\n                h.axis = 0.6;\\n            }\\n            K_POLYP => {\\n                h.need = 1.15;\\n                h.radius = 0.5;\\n                h.drain = 0.25;\\n            }\\n            K_TUMOR => {\\n                h.need = 6.2832;\\n130→                h.radius = 0.85;\\n                h.drain = 0.55;\\n            }\\n            K_INFLAM | K_BURN => {\\n                h.need = 0.7;\",\"content_concise\":\"115→                h.samples_need = 3;\\n            }\\n            K_FOREIGN => {\\n                h.need = 0.85;\\n               