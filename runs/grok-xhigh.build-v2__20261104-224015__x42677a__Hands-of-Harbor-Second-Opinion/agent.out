String, String>) -> Result<(), String> {\"},{\"line_number\":65,\"content\":\"    for (role, color) in roles {\"},{\"line_number\":66,\"content\":\"        if !props::doc::ROLES.contains(&role.as_str()) {\"},{\"line_number\":68,\"content\":\"                issue::suggestion(role, props::doc::ROLES.iter().copied()).map(|fix| format!(\\\" — {fix}\\\")).unwrap_or_default();\"},{\"line_number\":69,\"content\":\"            return Err(format!(\\\"roles: unknown role \\\\\\\"{role}\\\\\\\" (expected {}){fix}\\\", props::doc::ROLES.join(\\\", \\\")));\"},{\"line_number\":72,\"content\":\"            return Err(format!(\\\"roles.{role}: \\\\\\\"{color}\\\\\\\" is not a #rrggbb colour\\\"));\"},{\"line_number\":108,\"content\":\"            roles: BTreeMap::new(),\"},{\"line_number\":120,\"content\":\"    /// Colours for the theme roles its parts name, e.g. `{\\\"$wall\\\":\\\"#5a6b7c\\\"}`.\"},{\"line_number\":121,\"content\":\"    pub fn with_roles(mut self, roles: BTreeMap<String, String>) -> Result<Self, String> {\"},{\"line_number\":122,\"content\":\"        validate_roles(&roles)?;\"},{\"line_number\":123,\"content\":\"        self.roles = roles;\"},{\"line_number\":162,\"content\":\"            roles: self.roles.clone(),\"},{\"line_number\":220,\"content\":\"            let flip = if part.mirrored { Vec3::new(-1.0, 1.0, 1.0) } else { Vec3::ONE };\"},{\"line_number\":287,\"content\":\"        roles: Option<BTreeMap<String, String>>,\"},{\"line_number\":290,\"content\":\"        if let Some(roles) = &roles {\"},{\"line_number\":291,\"content\":\"            validate_roles(roles)?;\"},{\"line_number\":300,\"content\":\"        prop.roles = roles.unwrap_or_else(|| prop.roles.clone());\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_view/src/build.rs\",\"matches\":[{\"line_number\":52,\"content\":\"        Self {