awns: &'static [SpawnDef],\\n    pub checkpoint: bool,\\n    pub strain: u8,\\n    pub plate: u8,\\n    pub callout: u8,\\n    pub script_code: u8,\\n    pub unlock: u8,\\n    pub heat: bool,\\n}\\n\\npub struct CaseDef {\\n    pub name: &'static str,\\n    pub patient: &'static str,\\n    pub plate: u8,\\n    pub timer: f32,\\n    pub par: i32,\\n    pub vitals: f32,\\n    pub phases: &'static [PhaseDef],\\n}\\n\\nconst NONE_SPAWN: &[SpawnDef] = &[];\\n\\nconst fn s(kind: u8, x: f32, z: f32, hidden: bool, drain: f32, axis: f32) -> SpawnDef {\\n    SpawnDef { kind, x, z, hidden, drain, axis }\\n}\\n\\nconst C0_A: &[SpawnDef] = &[\\n    s(K_LACERATION, -1.4, 0.2, false, 1.7, 0.3),\\n    s(K_POOL, 1.5, -0.8, false, 1.1, 0.0),\\n];\\nconst C0_B: &[SpawnDef] = &[\\n    s(K_INCISION, -2.4, 1.1, false, 0.0, 0.0),\\n    s(K_INFLAM, 1.2, 1.15, false, 0.45, 0.0),\\n];\\nconst C1_A: &[SpawnDef] = &[\\n    s(K_BLEEDER, -1.6, -0.2, false, 2.3, 0.2),\\n    s(K_FOREIGN, 0.7, 0.9, true, 0.7, 0.5),\\n];\\nconst C1_B: &[SpawnDef] = &[\\n    s(K_POLYP, 1.7, -1.0, false, 0.35, 0.0),\\n    s(K_POOL, -0.3, 1.45, false, 0.55, 0.0),\\n];\\nconst C2_A: &[SpawnDef] = &[\\n    s(K_BONE, 0.15, 0.15, false, 0.25, 0.0),\\n    s(K_TETHER, -1.8, 1.05, false, 0.3, 0.15),\\n];\\nconst C2_B: &[SpawnDef] = &[\\n    s(K_IV, 2.0, -1.4, false, 0.0, 0.0),\\n    s(K_DRESSING, -0.15, -1.45, false, 0.2, 0.0),\\n];\\nconst C3_A: &[SpawnDef] = &[\\n    s(K_NODULE, -1.5, 0.4, false, 0.4, 0.4),\\n    s(K_NODULE, 0.3, 1.15, false, 0.4, 0.8),\\n    s(K_NODULE, 1.55, -0.45, false, 0.4, 1.1),\\n];\\nconst C3_B: &[SpawnDef] = &[\\n    s(K_NODULE, -1.15, -0.75, false, 0.45, 0.3),\\n    s(K_NODULE, 1.2, 0.55, false, 0.45, 0.9),\\n];\\nconst C3_C: &[SpawnDef] = &[\\n    s(K_NODULE, -0.35, 0.15, false, 0.4, 0.2),\\n    s(K_NODULE, 1.35, -0.95, false, 0.4, 1.0),\\n];\\nconst C3_D: &[SpawnDef] = &[\\n    s(K_POLYP, -1.55, 0.75, false, 0.25, 0.0),\\n    s(K_POLYP, 0.05, -0.55, false, 0.25, 0.0),\\n    s(K_POLYP, 1.5, 0.85, false, 0.25, 0.0),\\n];\\nconst C3_E: &[SpawnDef] = &[\\n    s(K_LACERATION, 0.0, 0.25, false, 0.85, 0.4),\\n    s(K_POOL, 1.55, 1.15, false, 0.45, 0.0),\\n];\\nconst C4_A: &[SpawnDef] = &[\\n    s(K_SAC, 1.55, 0.25, false, 0.22, 0.0),\\n    s(K_SAC, -1.55, 0.25, false, 0.22, 0.0),\\n    s(K_SAC, 0.85, 1.3, false, 0.22, 0.0),\\n    s(K_SAC, -0.85, 1.3, false, 0.22, 0.0),\\n    s(K_SAC, 0.85, -1.1, false, 0.22, 0.0),\\n    s(K_SAC, -0.85, -1.1, false, 0.22, 0.0),\\n];\\nconst C4_B: &[SpawnDef] = &[\\n    s(K_SAC, 1.35, 0.55, false, 0.22, 0.0),\\n    s(K_SAC, -1.7, 0.05, false, 0.22, 0.0),\\n    s(K_SAC, 0.55, 1.4, false, 0.22, 0.0),\\n    s(K_SAC, -0.6, 1.15, false, 0.22, 0.0),\\n    s(K_SAC, 1.15, -0.95, false, 0.22, 0.0),\\n    s(K_SAC, -1.05, -1.25, false, 0.22, 0.0),\\n];\\nconst C4_C: &[SpawnDef] = &[\\n    s(K_SAC, 1.7, -0.15, false, 0.22, 0.0),\\n    s(K_SAC, -1.3, 0.55, false, 0.22, 0.0),\\n    s(K_SAC, 0.15, 1.45, false, 0.22, 0.0),\\n    s(K_SAC, -0.95, 1.05, false, 0.22, 0.0),\\n    s(K_SAC, 0.65, -1.25, false, 0.22, 0.0),\\n    s(K_SAC, -1.45, -0.85, false, 0.22, 0.0),\\n];\\nconst C4_D: &[SpawnDef] = &[\\n    s(K_EYE, 0.0, 0.15, false, 0.55, 0.0),\\n    s(K_INFLAM, 1.75, -0.35, false, 0.3, 0.0),\\n];\\nconst C5_A: &[SpawnDef] = &[\\n    s(K_EMBER, -1.65, 0.45, false, 0.35, 0.2),\\n    s(K_EMBER, -0.45, 1.2, false, 0.35, 0.8),\\n    s(K_EMBER, 0.7, 0.3, false, 0.35, 0.4),\\n    s(K_EMBER, 1.55, 1.0, false, 0.35, 1.0),\\n    s(K_EMBER, 0.05, -1.15, false, 0.35, 0.6),\\n];\\nconst C5_B: &[SpawnDef] = &[\\n    s(K_EMBER, -0.8, 0.2, false, 0.4, 0.3),\\n    s(K_EMBER, 0.15, 0.7, false, 0.4, 0.9),\\n    s(K_EMBER, 0.9, -0.35, false, 0.4, 0.5),\\n];\\nconst C5_C: &[SpawnDef] = &[\\n    s(K_EMBER, -0.4, 0.4, false, 0.45, 0.4),\\n    s(K_EMBER, 0.85, 0.15, false, 0.45, 1.1),\\n    s(K_BURN, 0.05, -1.25, false, 0.35, 0.0),\\n];\\nconst C6_A: &[SpawnDef] = &[\\n    s(K_TUMOR, 0.0, 0.1, false, 0.7, 0.0),\\n    s(K_LACERATION, -1.75, -0.75, false, 0.95, 0.5),\\n    s(K_POOL, 1.65, 0.95, false, 0.5, 0.0),\\n];\\nconst C6_B: &[SpawnDef] = &[\\n    s(K_BURN, -1.35, 1.15, false, 0.4, 0.0),\\n    s(K_BLEEDER, 1.45, -1.05, false, 1.7, 1.2),\\n];\\nconst C7_A: &[SpawnDef] = &[\\n    s(K_NODULE, -1.25, 0.55, false, 0.4, 0.4),\\n    s(K_NODULE, 1.15, -0.35, false, 0.4, 0.9),\\n    s(K_POOL, -0.15, 1.25, false, 0.75, 0.0),\\n    s(K_POOL, 0.4, -1.15, false, 0.75, 0.0),\\n];\\nconst C7_B: &[SpawnDef] = &[\\n    s(K_SAC, 1.4, 0.4, false, 0.25, 0.0),\\n    s(K_SAC, -1.4, 0.15, false, 0.25, 0.0),\\n    s(K_SAC, 0.2, 1.3, false, 0.25, 0.0),\\n    s(K_SAC, -0.3, -1.2, false, 0.25, 0.0),\\n];\\nconst C7_C: &[SpawnDef] = &[\\n    s(K_EMBER, -1.15, 0.35, false, 0.4, 0.3),\\n    s(K_EMBER, 1.05, -0.25, false, 0.4, 0.8),\\n    s(K_EMBER, 0.1, 1.15, false, 0.4, 1.2),\\n];\\nconst C7_E: &[SpawnDef] = &[s(K_INCISION, -1.5, 0.15, false, 0.0, 0.1)];\\nconst C7_F: &[SpawnDef] = &[s(K_TENDRIL, 0.25, 0.15, false, 0.55, 0.45)];\\nconst C7_G: &[SpawnDef] = &[s(K_DRESSING, 0.0, -0.15, false, 0.1, 0.0)];\\n\\nconst fn phase(\\n    spawns: &'static [SpawnDef],\\n    checkpoint: bool,\\n    strain: u8,\\n    callout: u8,\\n    script_code: u8,\\n    unlock: u8,\\n    heat: bool,\\n) -> PhaseDef {\\n    PhaseDef { spawns, checkpoint, strain, plate: KEEP_PLATE, callout, script_code, unlock, heat }\\n}\\n\\npub static CASES: [CaseDef; 8] = [\\n    CaseDef {\\n        name: \\\"The First Movement\\\",\\n        patient: \\\"Anton Deverell\\\",\\n        plate: 0,\\n        timer: 170.0,\\n        par: 900,\\n        vitals: 76.0,\\n        phases: &[\\n            phase(C0_A, true, NO_STRAIN, 0, 0, 0, false),\\n            phase(C0_B, true, NO_STRAIN, 10, 0, 0, false),\\n        ],\\n    },\\n    CaseDef {\\n        name: \\\"Salt in the Peritoneum\\\",\\n        patient: \\\"Briony Pell\\\",\\n        plate: 1,\\n        timer: 180.0,\\n        par: 900,\\n        vitals: 72.0,\\n        phases: &[\\n            phase(C1_A, true, NO_STRAIN, 0, 0, 0, false),\\n            phase(C1_B, true, NO_STRAIN, 0, 0, 0, false),\\n        ],\\n    },\\n    CaseDef {\\n        name: \\\"The Held Note\\\",\\n        patient: \\\"Casper Lang\\\",\\n        plate: 4,\\n        timer: 190.0,\\n        par: 900,\\n        vitals: 70.0,\\n        phases: &[\\n            phase(C2_A, true, NO_STRAIN, 0, 0, 0, false),\\n            phase(C2_B, true, NO_STRAIN, 2, 0, 0, false),\\n            phase(NONE_SPAWN, false, NO_STRAIN, 5, 1, 0, false),\\n        ],\\n    },\\n    CaseDef {\\n\",\"total_lines\":328}}","is_error":false},{"type":"tool_result","tool_use_id":"call-c659ec07-c0f6-4cb6-aa56-0cd627f1fc82-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"450→                } else {\\n                    \\\"or\\\"\\n                }\\n            }\\n        },\\n        4 => \\\"results\\\",\\n        5 => \\\"crisis\\\",\\n        7 => \\\"code\\\",\\n        _ => \\\"title\\\",\\n    }\\n460→}\\n\\npub fn surgery_frame(app: &mut App) {\\n    if app.gfx.is_none() || app.host.is_none() {\\n        return;\\n    }\\n    let now = web_time::Instant::now();\\n    let dt = (now - app.last).as_secs_f32().min(0.1);\\n    app.last = now;\\n\\n470→    #[cfg(target_arch = \\\"wasm32\\\")]\\n    drain_hook(app);\\n\\n    app.harbor.poll_pads(app.input.gilrs.as_mut());\\n    let hub = app.harbor.link.poll(dt);\\n    aim_rig(app);\\n    let (w, h) = app.gfx.as_ref().unwrap().size();\\n    let size = Vec2::new(w as f32, h as f32);\\n    let hit = app.rig.ground_point(app.harbor.mouse, size, 0.0).map(|p| [p.x, p.z]);\\n    if app.harbor.mouse_click {\\n480→        if let Some(p) = hit {\\n            if let Some(tool) = tray_tool(p[0], p[1]) {\\n                let me = if hub.active { hub.slot as usize } else { 0 };\\n                app.harbor.tool[me.min(3)] = tool;\\n            }\\n        }\\n    }\\n    let local = if hub.active && !hub.server { Some(hub.slot) } else { None };\\n    let (cmds, mut surgeons, _) = app.harbor.compose(dt, hit, local, hub.active);\\n    if hub.active {\\n490→        app.harbor.shell.card_lines = hub.card_lines.clone();\\n        if !app.harbor.saw_card {\\n            app.harbor.saw_card = true;\\n            let host = app.host.as_ref().unwrap();\\n            host.exec(|sim| {\\n                if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                    if g.mode == 0 || g.mode == 6 {\\n                        g.mode = 7;\\n                        g.case_id = -1;\\n                    }\\n500→                    // Skip the operative mesh from the first hub frame. Building it\\n                    // stalls the iframe before the round is allowed to start.\\n                    g.hub_quiet = true;\\n                }\\n            });\\n        }\\n        if let Some(boot) = hub.boot.clone() {\\n            let host = app.host.as_ref().unwrap();\\n            host.exec(move |sim| {\\n                if boot.mirror {\\n510→                    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                        g.boot_mirror();\\n                    }\\n                } else {\\n                    Surgery::boot_hub_round(sim, boot.seed as u64, &boot.slots, true);\\n                }\\n            });\\n        }\\n        if let Some(snap) = hub.snap.clone() {\\n            if snap.bucket >= app.harbor.applied_bucket {\\n520→                app.harbor.applied_bucket = snap.bucket;\\n                let host = app.host.as_ref().unwrap();\\n                host.exec(move |sim| {\\n                    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                        g.apply_mirror(snap.vitals, snap.bpm, snap.phase, snap.flat, snap.timer, snap.code_t, &snap.hazards, &snap.cursors);\\n                    }\\n                });\\n            }\\n        }\\n        if !hub.server {\\n530→            let me = hub.slot as usize;\\n            if me < 4 {\\n                if let Some(dom) = hub.dom {\\n                    if dom.x != 0.0 || dom.y != 0.0 {\\n                        surgeons[me].active = true;\\n                        surgeons[me].aim = shape_stick(Vec2::new(dom.x, -dom.y));\\n                        surgeons[me].held &= !(surg::AIM_ABSOLUTE | surg::SNAP);\\n                    }\\n                    if dom.use_on {\\n                        surgeons[me].held |= surg::USE;\\n540→                        surgeons[me].pressure = 1.0;\\n                    }\\n                }\\n            }\\n        } else {\\n            for s in &mut surgeons {\\n                *s = SurgeonInput { tool: TOOL_KEEP, ..SurgeonInput::default() };\\n            }\\n        }\\n        for (i, remote) in hub.remote.iter().enumerate() {\\n550→            if hub.server || i != hub.slot as usize {\\n                if let Some(hand) = remote {\\n                    surgeons[i] = *hand;\\n                }\\n            }\\n        }\\n    }\\n    let host = app.host.as_ref().unwrap();\\n    let paused = app.harbor.shell.paused();\\n    let hold = paused || hub.ended;\\n560→    host.set_control(|c| c.paused = hold);\\n    for cmd in cmds {\\n        if let Some(sim_cmd) = to_sim(cmd) {\\n            host.exec(move |sim| {\\n                if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                    g.apply_cmd(sim_cmd);\\n                }\\n            });\\n        }\\n    }\\n570→    {\\n        let mut input = host.shared.input.lock().unwrap();\\n        *input = InputFrame::default();\\n        input.surgeons = surgeons;\\n    }\\n    host.pump();\\n\\n    let (prev, curr, curr_at, tick_wall) = host.frames();\\n    let _ = (curr_at, tick_wall);\\n    let op = curr.surgery.clone();\\n580→    if let Some(op) = &op {\\n        app.harbor.shell.note_mode(op.mode);\\n        if op.mode == 3 || op.mode == 8 {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(false);\\n        } else {\\n            app.gfx.as_ref().unwrap().window.set_cursor_visible(true);\\n        }\\n    }\\n    let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\\n    if hub.active {\\n590→        // One stream per copy. Host and server send snapshots; clients send a hand.\\n        // Sending both blows the hub's 20 messages/second cap.\\n        if hub.host {\\n            if let Some(op) = op.as_ref() {\\n                let (vitals, timer, bucket) = latched_vitals(&app.harbor, op, hub.time_ms);\\n                let body = snap_json(op, &events, vitals, timer, bucket);\\n                if app.harbor.link.send_snap(&body) {\\n                    app.harbor.net_vitals = Some(vitals);\\n                    app.harbor.net_timer = Some(timer);\\n                    app.harbor.net_bucket = bucket;\\n600→                }\\n                if hub.play {\\n                    app.harbor.link.publish(&standings_json(&hub.present, op));\\n                }\\n            }\\n        } else if !hub.server {\\n            let me = hub.slot as usize;\\n            if me < 4 {\\n                app.harbor.link.send_input(&surgeons[me]);\\n            }\\n610→        }\\n    }\\n    let quiet_audio = hub.server || hub.ended;\\n    let music = if quiet_audio { 0.0 } else { op.as_ref().map(|o| o.music).unwrap_or(0.10) };\\n    let effects = if quiet_audio { 0.0 } else { op.as_ref().map(|o| o.effects).unwrap_or(0.80) };\\n    let voices = if quiet_audio { 0.0 } else { op.as_ref().map(|o| o.voices).unwrap_or(0.70) };\\n    let name = op.as_ref().map(|o| track_name(o)).unwrap_or(\\\"title\\\");\\n    if app.harbor.music_name != name {\\n        app.harbor.music_name = name.to_string();\\n        app.harbor.music_left = 0.0;\\n620→    }\\n    app.harbor.music_left -= dt;\\n    let schedule = if quiet_audio {\\n        None\\n    } else if app.harbor.music_left <= 0.0 {\\n        let bpm = op.as_ref().map(|o| o.bpm).unwrap_or(72.0).clamp(60.0, 140.0