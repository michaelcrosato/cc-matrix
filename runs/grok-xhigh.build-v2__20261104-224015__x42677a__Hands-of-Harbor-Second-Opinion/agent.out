rz = h.axis.sin();\\n            let along = (h.work + 0.22).min(h.need);\\n            (h.x + dirx * along, h.z + dirz * along)\\n        }\\n        K_TUMOR if h.stage == 0 => {\\n            let ang = h.work + 0.28;\\n            (h.x + ang.cos() * (h.radius * 0.75), h.z + ang.sin() * (h.radius * 0.75))\\n        }\\n        K_LACERATION | K_BLEEDER | K_BONE if h.stage >= 1 || h.kind != K_BONE => {\\n            let dirx = h.axis.cos();\\n            let dirz = h.axis.sin();\\n            let span = h.need.max(0.4);\\n            let n = h.samples_need.max(1) as f32;\\n            let needle = -span * 0.5 + (h.samples as f32 + 0.5) * (span / n);\\n            let across_x = -dirz;\\n            let across_z = dirx;\\n            let sign = if cursor_side >= 0.0 { -1.0 } else { 1.0 };\\n            (h.x + dirx * needle + across_x * 0.5 * sign, h.z + dirz * needle + across_z * 0.5 * sign)\\n        }\\n        K_FOREIGN | K_TENDRIL | K_NODULE | K_EYE | K_EMBER | K_TUMOR if h.grabbed || h.tool == FORCEPS && h.kind != K_TUMOR => {\\n            if h.grabbed || h.work > 0.05 {\\n                let dirx = h.axis.cos();\\n                let dirz = h.axis.sin();\\n                (h.grab_x + dirx * (h.need + 0.15), h.grab_z + dirz * (h.need + 0.15))\\n            } else {\\n                (h.x, h.z)\\n            }\\n        }\\n\",\"total_lines\":642}}","is_error":false},{"type":"tool_result","tool_use_id":"call-5e8b771f-a86c-4605-9d4f-371fabc67fe8-23","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"500→                }\\n            });\\n        }\\n        if let Some(boot) = hub.boot.clone() {\\n            let host = app.host.as_ref().unwrap();\\n            host.exec(move |sim| {\\n                if boot.mirror {\\n                    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                        g.boot_mirror();\\n                    }\\n510→                } else {\\n                    Surgery::boot_hub_round(sim, boot.seed as u64, &boot.slots, true);\\n                }\\n            });\\n        }\\n        if let Some(snap) = hub.snap.clone() {\\n            if snap.bucket >= app.harbor.applied_bucket {\\n                app.harbor.applied_bucket = snap.bucket;\\n                let host = app.host.as_ref().unwrap();\\n                host.exec(move |sim| {\\n520→                    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<Surgery>()) {\\n                        g.apply_mirror(snap.vitals, snap.bpm, snap.phase, snap.flat, snap.timer, snap.code_t, &snap.hazards, &snap.cursors);\\n                    }\\n                });\\n            }\\n        }\\n        if !hub.server {\\n            let me = hub.slot as usize;\\n            if me < 4 {\\n                if let Some(dom) = hub.dom {\\n530→                    if dom.x != 0.0 || dom.y != 0.0 {\\n                        surgeons[me].active = true;\\n                        surgeons[me].aim = shape_stick(Vec2::new(dom.x, -dom.y));\\n                        surgeons[me].held &= !(surg::AIM_ABSOLUTE | surg::SNAP);\\n                    }\\n                    if dom.use_on {\\n                        surgeons[me].held |= surg::USE;\\n                        surgeons[me].pressure = 1.0;\\n                    }\\n                }\\n540→            }\\n        } else {\\n            for s in &mut surgeons {\\n                *s = SurgeonInput { tool: TOOL_KEEP, ..SurgeonInput::default() };\\n            }\\n        }\\n        for (i, remote) in hub.remote.iter().enumerate() {\\n            if hub.server || i != hub.slot as usize {\\n                if let Some(hand) = remote {\\n                    surgeons[i] = *hand;\\n550→                }\\n            }\\n        }\\n    }\\n    let host = app.host.as_ref().unwrap();\\n    let shown = host.frames().1;\\n    if let Some(op) = shown.surgery.as_ref() {\\n        resolve_hands(&mut surgeons, op);\\n    }\\n    let paused = app.ha