     story_line: String::new(),\\n170→            difficulty: 0,\\n            players: 1,\\n            music: 0.10,\\n            effects: 0.80,\\n            voices: 0.70,\\n            camera: CameraShot::default(),\\n            hazards: Vec::new(),\\n            cursors: [CursorView {\\n                active: false,\\n                x: 0.0,\\n180→                z: 0.0,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/frame.rs\",\"offset\":null,\"limit\":180,\"raw_output\":\"//! What one draw of the operation needs. Built fresh each frame; not part of the saved state.\\n\\nuse glam::Vec3;\\n\\nuse super::kinds::TITLE;\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct CameraShot {\\n    pub tilt: f32,\\n    pub yaw: f32,\\n    pub distance: f32,\\n    pub fov_deg: f32,\\n    pub target: Vec3,\\n    pub follow_lag: f32,\\n    pub height_offset: f32,\\n}\\n\\nimpl Default for CameraShot {\\n    fn default() -> Self {\\n        Self {\\n            tilt: 73.0,\\n            yaw: 0.0,\\n            distance: 19.9,\\n            fov_deg: 36.0,\\n            target: Vec3::new(0.0, 0.0, 0.2),\\n            follow_lag: 0.0,\\n            height_offset: 0.0,\\n        }\\n    }\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct HazardView {\\n    pub id: u32,\\n    pub kind: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub radius: f32,\\n    pub work: f32,\\n    pub need: f32,\\n    pub alive: bool,\\n    pub hidden: bool,\\n    pub stage: u8,\\n    pub stages: u8,\\n    pub axis: f32,\\n    pub aux: f32,\\n    pub bits: u8,\\n    pub tool: u8,\\n    pub grabbed: bool,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct CursorView {\\n    pub active: bool,\\n    pub x: f32,\\n    pub z: f32,\\n    pub tool: u8,\\n    pub score: i32,\\n    pub chain: u32,\\n    pub meter: f32,\\n    pub color: [f32; 3],\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct PopupView {\\n    pub rating: u8,\\n    pub life: f32,\\n    pub x: f32,\\n    pub z: f32,\\n}\\n\\n/// Draw-only snapshot. The view reads this and does not consult the sim.\\n#[derive(Clone, Debug)]\\npub struct SurgeryFrame {\\n    pub title: &'static str,\\n    pub mode: u8,\\n    pub case_id: i8,\\n    pub op_name: String,\\n    pub patient: String,\\n    pub plate: u8,\\n    pub plate_next: u8,\\n    pub plate_blend: f32,\\n    pub vitals: f32,\\n    pub bpm: f32,\\n    pub phase: f32,\\n    pub flat: bool,\\n    pub on_beat: bool,\\n    pub timer: f32,\\n    pub elapsed: f32,\\n    pub score: i32,\\n    pub par: i32,\\n    pub rank: u8,\\n    pub chain: u32,\\n    pub mistakes: u32,\\n    pub code_t: f32,\\n    pub codes_left: u8,\\n    pub shocks_done: u8,\\n    pub shocks_need: u8,\\n    pub fever: f32,\\n    pub heat_on: bool,\\n    pub heat_angle: f32,\\n    pub gift_hush: f32,\\n    pub gift_echo: f32,\\n    pub gift_duet: f32,\\n    pub gifts_unlocked: u8,\\n    pub banner: String,\\n    pub callout: String,\\n    pub story_who: String,\\n    pub story_line: String,\\n    pub difficulty: u8,\\n    pub players: u8,\\n    pub music: f32,\\n    pub effects: f32,\\n    pub voices: f32,\\n    pub camera: CameraShot,\\n    pub hazards: Vec<HazardView>,\\n    pub cursors: [CursorView; 4],\\n    pub echo_x: f32,\\n    pub echo_z: f32,\\n    pub echo_on: bool,\\n    pub popups: Vec<PopupView>,\\n    pub coverage_tools: [u32; 11],\\n    pub coverage_hazards: [u32; 19],\\n    pub coverage_strains: [u32; 18],\\n    pub coverage_gifts: [u32; 3],\\n    pub coverage_code: u32,\\n    pub coverage_ratings: [u32; 4],\\n    pub attract: bool,\\n    pub card_ready: bool,\\n}\\n\\nimpl SurgeryFrame {\\n    pub fn empty() -> Self {\\n        Self {\\n            title: TITLE,\\n            mode: 0,\\n            case_id: 0,\\n            op_name: String::new(),\\n            patient: String::new(),\\n            plate: 0,\\n            plate_next: 0,\\n            plate_blend: 1.0,\\n            vitals: 100.0,\\n            bpm: 72.0,\\n            phase: 0.0,\\n            flat: false,\\n            on_beat: false,\\n            timer: 0.0,\\n            elapsed: 0.0,\\n            score: 0,\\n            par: 1,\\n            rank: 0,\\n            chain: 0,\\n            mistakes: 0,\\n            code_t: -1.0,\\n            codes_left: 0,\\n            shocks_done: 0,\\n            shocks_need: 0,\\n            fever: 0.0,\\n            heat_on: false,\\n            heat_angle: 0.0,\\n            gift_hush: 0.0,\\n            gift_echo: 0.0,\\n            gift_duet: 0.0,\\n            gifts_unlocked: 0,\\n            banner: String::new(),\\n            callout: String::new(),\\n            story_who: String::new(),\\n            story_line: String::new(),\\n            difficulty: 0,\\n            players: 1,\\n            music: 0.10,\\n            effects: 0.80,\\n            voices: 0.70,\\n            camera: CameraShot::default(),\\n            hazards: Vec::new(),\\n            cursors: [CursorView {\\n                active: false,\\n                x: 0.0,\\n                z: 0.0,\\n\",\"total_lines\":201}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"ecac56d7-a590-4958-85e4-c3b855416046"}
