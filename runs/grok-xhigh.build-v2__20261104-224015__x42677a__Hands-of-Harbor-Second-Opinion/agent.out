/surgery/ops.rs\",\"matches\":[{\"line_number\":137,\"content\":\"                if h.alive && h.kind != K_HEAT {\"},{\"line_number\":178,\"content\":\"        g.phase_i = g.phase_i.saturating_add(1);\"},{\"line_number\":181,\"content\":\"        if case_def(g.case_id.max(0) as u8).is_some_and(|c| g.phase_i as usize >= c.phases.len()) {\"},{\"line_number\":206,\"content\":\"    if g.phase_i as usize >= def.phases.len() {\"},{\"line_number\":210,\"content\":\"    let phase = def.phases[g.phase_i as usize];\"},{\"line_number\":263,\"content\":\"    if phase.checkpoint || g.phase_i == 0 {\"},{\"line_number\":274,\"content\":\"    !g.hazards.iter().any(|h| h.alive && h.kind != K_HEAT)\"},{\"line_number\":280,\"content\":\"        if !h.alive {\"},{\"line_number\":287,\"content\":\"                h.alive = false;\"},{\"line_number\":381,\"content\":\"                g.hazards[idx].alive = false;\"},{\"line_number\":448,\"content\":\"        g.hazards[idx].alive = false;\"},{\"line_number\":494,\"content\":\"    if !g.hazards[idx].alive {\"},{\"line_number\":563,\"content\":\"        h.alive && h.kind != K_HEAT && h.tool == tool && Some(h.id) != skip && h.id != g.last_id\"},{\"line_number\":569,\"content\":\"    g.hazards[idx].alive = false;\"},{\"line_number\":597,\"content\":\"    let quiet = g.hazards.iter().all(|h| !h.alive || h.kind == K_HEAT);\"},{\"line_number\":663,\"content\":\"            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\"},{\"line_number\":674,\"content\":\"        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\"},{\"line_number\":681,\"content\":\"        if !h.alive || h.kind == K_HEAT {\"},{\"line_number\":697,\"content\":\"        if !h.alive || h.kind == K_HEAT || h.accepts(tool) {\"},{\"line_number\":716,\"content\":\"        if !h.alive || h.kind == K_HEAT || !h.accepts(tool) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e