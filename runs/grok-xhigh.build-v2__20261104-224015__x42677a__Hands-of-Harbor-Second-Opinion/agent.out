                    }\\n310→                    let (name, def, _, _) = Tune::FIELDS[id];\\n                    v.push(self.row(i, &format!(\\\"{name}  {:.2}  default {def:.2}\\\", self.sliders[id])));\\n                }\\n                v.push(\\\"Reset All\\\".into());\\n            }\\n            Screen::Attract => {\\n                v.push(\\\"DEMO\\\".into());\\n                v.push(format!(\\\"Press {}\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n            Screen::Hud => {\\n320→                v.push(\\\"OPERATION\\\".into());\\n            }\\n            Screen::Story => v.push(\\\"Advance\\\".into()),\\n            Screen::Results => v.push(\\\"Results\\\".into()),\\n            Screen::Dead => v.push(self.row(0, \\\"Retry\\\")),\\n            Screen::Card => {\\n                v.push(\\\"Pre-op\\\".into());\\n                v.push(\\\"Keep the patient alive\\\".into());\\n                v.push(format!(\\\"{} ready\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n330→        }\\n        v\\n    }\\n\\n    fn row(&self, i: usize, label: &str) -> String {\\n        if i == self.focus {\\n            format!(\\\"> {label}\\\")\\n        } else {\\n            label.to_string()\\n        }\\n340→    }\\n\\n    pub fn step(&mut self, input: Input) -> Vec<Cmd> {\\n        if let Some(d) = input.device {\\n            self.device = d;\\n            if d == DeviceKind::KeyboardMouse || d == DeviceKind::Gamepad {\\n                self.ever_fine = true;\\n            }\\n        }\\n        let mut cmds = Vec::new();\\n350→        if self.screen == Screen::Attract {\\n            if input.any {\\n                self.screen = Screen::Title;\\n                self.paused = false;\\n                self.idle = 0.0;\\n                self.focus = 0;\\n                cmds.push(Cmd::ToTitle);\\n            }\\n            return cmds;\\n        }\\n360→        let menuish = matches!(\\n            self.screen,\\n            Screen::Title | Screen::Menu | Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls\\n        );\\n        if menuish && !input.any {\\n            self.idle += input.dt;\\n            if self.idle >= 10.0 {\\n                self.screen = Screen::Attract;\\n                self.idle = 0.0;\\n                cmds.push(Cmd::LoadAttract);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_ui/src/surgery/mod.rs\",\"offset\":90,\"limit\":280,\"raw_output\":\"impl Default for Shell {\\n    fn default() -> Self {\\n        Self::new()\\n    }\\n}\\n\\nimpl Shell {\\n    pub fn new() -> Self {\\n        let mut sliders = [0.0; 19];\\n        for (i, (_, v, _, _)) in Tune::FIELDS.iter().enumerate() {\\n            sliders[i] = *v;\\n        }\\n        Self {\\n            screen: Screen::Title,\\n            focus: 0,\\n            device: DeviceKind::KeyboardMouse,\\n            xbox: false,\\n            touch_only: false,\\n            ever_fine: false,\\n            idle: 0.0,\\n            settings_page: 0,\\n            about_page: 0,\\n            dev_page: 0,\\n            sliders,\\n            music: 0.10,\\n            effects: 0.80,\\n            voices: 0.70,\\n            difficulty: 1,\\n            best: [0; 8],\\n            sim_mode: 0,\\n            paused: false,\\n            live: true,\\n            bot_plays: false,\\n        }\\n    }\\n\\n    pub fn screen_name(&self) -> &'static str {\\n        match self.screen {\\n            Screen::Title => \\\"title\\\",\\n            Screen::Menu => \\\"menu\\\",\\n            Screen::Difficulty => \\\"difficulty\\\",\\n            Screen::Files => \\\"files\\\",\\n            Screen::Settings => \\\"settings\\\",\\n            Screen::About => \\\"about\\\",\\n            Screen::Controls => \\\"controls\\\",\\n            Screen::Pause => \\\"pause\\\",\\n            Screen::Dev => \\\"dev\\\",\\n            Screen::Attract => \\\"attract\\\",\\n            Screen::Hud => \\\"op\\\",\\n            Screen::Story => \\\"story\\\",\\n            Screen::Results => \\\"results\\\",\\n            Screen::Dead => \\\"dead\\\",\\n            Screen::Card => \\\"card\\\",\\n        }\\n    }\\n\\n    pub fn focus(&self) -> usize {\\n        self.focus\\n    }\\n\\n    pub fn note_mode(&mut self, mode: u8) {\\n        self.sim_mode = mode;\\n        if self.paused\\n            || matches!(\\n                self.screen,\\n                Screen::Menu\\n                    | Screen::Difficulty\\n                    | Screen::Files\\n                    | Screen::Settings\\n                    | Screen::About\\n                    | Screen::Controls\\n                    | Screen::Pause\\n                    | Screen::Dev\\n                    | Screen::Attract\\n            )\\n        {\\n            return;\\n        }\\n        self.screen = match mode {\\n            1 | 2 => Screen::Story,\\n            3 => Screen::Hud,\\n            4 => Screen::Results,\\n            5 => Screen::Dead,\\n            6 => Screen::Attract,\\n            7 => Screen::Card,\\n            _ => Screen::Title,\\n        };\\n    }\\n\\n    pub fn prompt(&self, action: &str) -> &'static str {\\n        let pad = self.device == DeviceKind::Gamepad;\\n        match action {\\n            \\\"confirm\\\" => {\\n                if !pad {\\n                    \\\"Enter\\\"\\n                } else if self.xbox {\\n                    \\\"A\\\"\\n                } else {\\n                    \\\"Cross\\\"\\n                }\\n            }\\n            \\\"back\\\" => {\\n                if !pad {\\n                    \\\"Esc\\\"\\n                } else if self.xbox {\\n                    \\\"B\\\"\\n                } else {\\n                    \\\"Circle\\\"\\n                }\\n            }\\n            \\\"use\\\" => {\\n                if !pad {\\n                    \\\"LMB\\\"\\n                } else if self.xbox {\\n                    \\\"RT\\\"\\n                } else {\\n                    \\\"R2\\\"\\n                }\\n            }\\n            \\\"gift\\\" => {\\n                if !pad {\\n                    \\\"G\\\"\\n                } else if self.xbox {\\n                    \\\"Y\\\"\\n                } else {\\n                    \\\"Triangle\\\"\\n                }\\n            }\\n            \\\"chart\\\" => {\\n                if !pad {\\n                    \\\"Tab\\\"\\n                } else if self.xbox {\\n                    \\\"X\\\"\\n                } else {\\n                    \\\"Square\\\"\\n                }\\n            }\\n            \\\"pause\\\" => {\\n                if pad {\\n                    \\\"Options\\\"\\n                } else {\\n                    \\\"Esc\\\"\\n                }\\n            }\\n            _ => \\\" \\\",\\n        }\\n    }\\n\\n    pub fn lines(&self) -> Vec<String> {\\n        let mut v = Vec::new();\\n        v.push(TITLE.to_string());\\n        match self.screen {\\n            Screen::Title => {\\n                v.push(\\\"Mercy Harbor General  ·  Night Ward\\\".into());\\n                v.push(format!(\\\"Press {} \\\", self.prompt(\\\"confirm\\\")));\\n                if self.touch_only && !self.ever_fine {\\n                    v.push(\\\"Controller or keyboard required\\\".into());\\n                    v.push(\\\"Settings\\\".into());\\n                }\\n            }\\n            Screen::Menu => {\\n                for (i, item) in [\\\"Continue\\\", \\\"New Game\\\", \\\"Case Files\\\", \\\"Code Blue\\\", \\\"Settings\\\", \\\"About\\\"].iter().enumerate() {\\n                    v.push(self.row(i, item));\\n                }\\n            }\\n            Screen::Difficulty => {\\n                for (i, item) in [\\\"Resident\\\", \\\"Attending\\\", \\\"Chief\\\"].iter().enumerate() {\\n                    v.push(self.row(i, item));\\n                }\\n            }\\n            Screen::Files => {\\n                for i in 0..8 {\\n                    let rank = [\\\"\\\", \\\"C\\\", \\\"B\\\", \\\"A\\\", \\\"S\\\", \\\"ENCORE\\\"][self.best[i] as usize];\\n                    v.push(self.row(i, &format!(\\\"Case {}  {rank}\\\", i + 1)));\\n                }\\n            }\\n            Screen::Settings => {\\n                v.push(format!(\\\"Page {}\\\", self.settings_page + 1));\\n                match self.settings_page {\\n                    0 => {\\n                        v.push(self.row(0, &format!(\\\"Music  {:.2}  default 0.10\\\", self.music)));\\n                        v.push(self.row(1, &format!(\\\"Effects  {:.2}  default 0.80\\\", self.effects)));\\n                        v.push(self.row(2, &format!(\\\"Voices  {:.2}  default 0.70\\\", self.voices)));\\n                    }\\n                    1 => {\\n                        v.push(self.row(0, if self.xbox { \\\"Prompts  Xbox\\\" } else { \\\"Prompts  PlayStation\\\" }));\\n                        v.push(self.row(1, &format!(\\\"Cursor speed  {:.0}\\\", self.sliders[8])));\\n                        v.push(self.row(2, \\\"Rumble\\\"));\\n                    }\\n                    _ => {\\n                        v.push(self.row(0, \\\"Field  Anatomical\\\"));\\n                        v.push(self.row(1, \\\"Fullscreen\\\"));\\n                    }\\n                }\\n            }\\n            Screen::About => {\\n                v.push(about_page_title(self.about_page).into());\\n                v.extend(about_lines(self.about_page));\\n            }\\n            Screen::Controls => {\\n                v.push(format!(\\\"Aim   right stick or mouse   {}\\\", self.prompt(\\\"use\\\")));\\n                v.push(\\\"Tools   left stick or 1-8\\\".into());\\n                v.push(format!(\\\"Operate   {}\\\", self.prompt(\\\"use\\\")));\\n                v.push(format!(\\\"Gift   {}\\\", self.prompt(\\\"gift\\\")));\\n                v.push(format!(\\\"Chart   {}\\\", self.prompt(\\\"chart\\\")));\\n            }\\n            Screen::Pause => {\\n                for (i, item) in [\\\"Resume\\\", \\\"Restart\\\", \\\"Controls\\\", \\\"Settings\\\", \\\"Dev Mode\\\", \\\"Quit to Title\\\"].iter().enumerate() {\\n                    v.push(self.row(i, item));\\n                }\\n            }\\n            Screen::Dev => {\\n                v.push(if self.live { \\\"Live  on\\\".into() } else { \\\"Live  off\\\".into() });\\n                v.push(if self.bot_plays { \\\"Bot plays  on\\\".into() } else { \\\"Bot plays  off\\\".into() });\\n                let start = self.dev_page as usize * 6;\\n                for i in 0..6 {\\n                    let id = start + i;\\n                    if id >= Tune::FIELDS.len() {\\n                        break;\\n                    }\\n                    let (name, def, _, _) = Tune::FIELDS[id];\\n                    v.push(self.row(i, &format!(\\\"{name}  {:.2}  default {def:.2}\\\", self.sliders[id])));\\n                }\\n                v.push(\\\"Reset All\\\".into());\\n            }\\n            Screen::Attract => {\\n                v.push(\\\"DEMO\\\".into());\\n                v.push(format!(\\\"Press {}\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n            Screen::Hud => {\\n                v.push(\\\"OPERATION\\\".into());\\n            }\\n            Screen::Story => v.push(\\\"Advance\\\".into()),\\n            Screen::Results => v.push(\\\"Results\\\".into()),\\n            Screen::Dead => v.push(self.row(0, \\\"Retry\\\")),\\n            Screen::Card => {\\n                v.push(\\\"Pre-op\\\".into());\\n                v.push(\\\"Keep the patient alive\\\".into());\\n                v.push(format!(\\\"{} ready\\\", self.prompt(\\\"confirm\\\")));\\n            }\\n        }\\n        v\\n    }\\n\\n    fn row(&self, i: usize, label: &str) -> String {\\n        if i == self.focus {\\n            format!(\\\"> {label}\\\")\\n        } else {\\n            label.to_string()\\n        }\\n    }\\n\\n    pub fn step(&mut self, input: Input) -> Vec<Cmd> {\\n        if let Some(d) = input.device {\\n            self.device = d;\\n            if d == DeviceKind::KeyboardMouse || d == DeviceKind::Gamepad {\\n                self.ever_fine = true;\\n            }\\n        }\\n        let mut cmds = Vec::new();\\n        if self.screen == Screen::Attract {\\n            if input.any {\\n                self.screen = Screen::Title;\\n                self.paused = false;\\n                self.idle = 0.0;\\n                self.focus = 0;\\n                cmds.push(Cmd::ToTitle);\\n            }\\n            return cmds;\\n        }\\n        let menuish = matches!(\\n            self.screen,\\n            Screen::Title | Screen::Menu | Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls\\n        );\\n        if menuish && !input.any {\\n            self.idle += input.dt;\\n            if self.idle >= 10.0 {\\n                self.screen = Screen::Attract;\\n                self.idle = 0.0;\\n                cmds.push(Cmd::LoadAttract);\\n\",\"total_lines\":763}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"dec4f10b-5c32-4ce4-bca1-777a23658e8e"}
{"type":"assistant","message":{"id":"msg_229","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Tune is a public item used from the surgery module.","signature":""},{"type":"tool_use","id":"call-492164f9-94b2-4517-a8ae-da635cbe5ccc-38","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/engine-link/crates/pav_ui/src/surgery/mod.rs","offset":360,"limit":280}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3658,"output_tokens":261,"cache_read_input_tokens":68992,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"803363b3-ab10-4842-b6ba-d0a45a550e4c"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-492164f9-94b2-4517-a8ae-da635cbe5ccc-38","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"360→        let menuish = matches!(\\n            self.screen,\\n            Screen::Title | Screen::Menu | Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls\\n        );\\n        if menuish && !input.any {\\n            self.idle += input.dt;\\n            if self.idle >= 10.0 {\\n                self.screen = Screen::Attract;\\n                self.idle = 0.0;\\n                cmds.push(Cmd::LoadAttract);\\n370→                return cmds;\\n            }\\n        } else if input.any {\\n            self.idle = 0.0;\\n        }\\n        if self.touch_only && !self.ever_fine && self.screen == Screen::Title {\\n            if input.confirm || input.click {\\n                self.screen = Screen::Settings;\\n                self.focus = 0;\\n            }\\n380→            return cmds;\\n        }\\n        let n = self.count();\\n        if let Some(p) = input.pointer {\\n            if let Some(hit) = self.hit(p) {\\n                self.focus = hit;\\n                self.device = DeviceKind::KeyboardMouse;\\n            }\\n        }\\n        if input.up {\\n390→            self.focus = self.focus.saturating_sub(1);\\n        }\\n        if input.down && n > 0 {\\n            self.focus = (self.focus + 1).min(n - 1);\\n        }\\n        if input.tab_l {\\n            self.page(-1);\\n        }\\n        if input.tab_r {\\n            self.page(1);\\n400→        }\\n        if input.left || input.right {\\n            let dir = if input.right { 1.0 } else { -1.0 };\\n            self.nudge(dir, &mut cmds);\\n        }\\n        if input.back {\\n            self.back();\\n        }\\n        if input.confirm || input.click {\\n            self.activate(&mut cmds);\\n410→        }\\n        if self.screen == Screen::Hud && input.back {\\n            self.paused = true;\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n        }\\n        cmds\\n    }\\n\\n    fn count(&self) -> usize {\\n420→        match self.screen {\\n            Screen::Menu | Screen::Pause => 6,\\n            Screen::Difficulty => 3,\\n            Screen::Files => 8,\\n            Screen::Settings => 3,\\n            Screen::Dev => 7,\\n            Screen::Dead => 1,\\n            Screen::Title => {\\n                if self.touch_only && !self.ever_fine {\\n                    1\\n430→                } else {\\n                    1\\n                }\\n            }\\n            _ => 1,\\n        }\\n    }\\n\\n    fn hit(&self, p: [f32; 2]) -> Option<usize> {\\n        let n = self.count();\\n440→        for i in 0..n {\\n            let y = 280.0 + i as f32 * 72.0;\\n            if p[0] >= 180.0 && p[0] <= 1100.0 && p[1] >= y && p[1] <= y + 60.0 {\\n                return Some(i);\\n            }\\n        }\\n        None\\n    }\\n\\n    fn page(&mut self, d: i8) {\\n450→        match self.screen {\\n            Screen::Settings => self.settings_page = (self.settings_page as i8 + d).rem_euclid(3) as u8,\\n            Screen::About => self.about_page = (self.about_page as i8 + d).rem_euclid(5) as u8,\\n            Screen::Dev => self.dev_page = (self.dev_page as i8 + d).rem_euclid(4) as u8,\\n            _ => {}\\n        }\\n        self.focus = 0;\\n    }\\n\\n    fn nudge(&mut self, dir: f32, cmds: &mut Vec<Cmd>) {\\n460→        if self.screen == Screen::Settings && self.settings_page == 0 {\\n            let slot = match self.focus {\\n                0 => &mut self.music,\\n                1 => &mut self.effects,\\n                2 => &mut self.voices,\\n                _ => return,\\n            };\\n            *slot = (*slot + dir * 0.05).clamp(0.0, 1.0);\\n            cmds.push(Cmd::SetBus { which: self.focus as u8, value: *slot });\\n        }\\n470→        if self.screen == Screen::Dev && self.focus < 6 {\\n            let id = self.dev_page as usize * 6 + self.focus;\\n            if id < Tune::FIELDS.len() {\\n                let (_, _, lo, hi) = Tune::FIELDS[id];\\n                let step = (hi - lo) / 20.0;\\n                self.sliders[id] = (self.sliders[id] + dir * step).clamp(lo, hi);\\n                cmds.push(Cmd::SetTune { id: id as u8, value: self.sliders[id] });\\n            }\\n        }\\n    }\\n480→\\n    fn back(&mut self) {\\n        match self.screen {\\n            Screen::Menu | Screen::Attract => self.screen = Screen::Title,\\n            Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls => {\\n                self.screen = if self.paused { Screen::Pause } else { Screen::Menu };\\n            }\\n            Screen::Pause => {\\n                self.paused = false;\\n                self.screen = Screen::Hud;\\n490→            }\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Hud => {\\n                self.paused = true;\\n                self.screen = Screen::Pause;\\n                self.focus = 0;\\n            }\\n            _ => {}\\n        }\\n        self.focus = 0;\\n500→    }\\n\\n    fn activate(&mut self, cmds: &mut Vec<Cmd>) {\\n        match self.screen {\\n            Screen::Title => {\\n                self.screen = Screen::Menu;\\n                self.focus = 0;\\n            }\\n            Screen::Menu => match self.focus {\\n                0 => {\\n510→                    self.paused = false;\\n                    cmds.push(Cmd::LoadCampaign);\\n                    self.screen = Screen::Story;\\n                }\\n                1 => {\\n                    self.screen = Screen::Difficulty;\\n                    self.focus = self.difficulty as usize;\\n                }\\n                2 => {\\n                    self.screen = Screen::Files;\\n520→                    self.focus = 0;\\n                }\\n                3 => {\\n                    self.paused = false;\\n                    cmds.push(Cmd::LoadCode);\\n                    self.screen = Screen::Hud;\\n                }\\n                4 => {\\n                    self.screen = Screen::Settings;\\n                    self.focus = 0;\\n530→                }\\n                _ => {\\n                    self.screen = Screen::About;\\n                    self.focus = 0;\\n                }\\n            },\\n            Screen::Difficulty => {\\n                self.difficulty = self.focus.min(2) as u8;\\n                cmds.push(Cmd::SetDifficulty(self.difficulty));\\n                cmds.push(Cmd::LoadCampaign);\\n540→                self.paused = false;\\n                self.screen = Screen::Story;\\n            }\\n            Screen::Files => {\\n                let n = self.focus.min(7) as u8;\\n                cmds.push(Cmd::LoadCase(n));\\n                self.paused = false;\\n                self.screen = Screen::Hud;\\n            }\\n            Screen::Pause => match self.focus {\\n550→                0 => {\\n                    self.paused = false;\\n                    self.screen = Screen::Hud;\\n                }\\n                1 => cmds.push(Cmd::Retry),\\n                2 => self.screen = Screen::Controls,\\n                3 => self.screen = Screen::Settings,\\n                4 => {\\n                    self.screen = Screen::Dev;\\n                    self.focus = 0;\\n560→                }\\n                _ => {\\n                    self.paused = false;\\n                    self.screen = Screen::Title;\\n                    cmds.push(Cmd::ToTitle);\\n                }\\n            },\\n            Screen::Dev => {\\n                if self.focus == 0 {\\n                    self.live = !self.live;\\n570→                } else if self.focus == 1 {\\n                    self.bot_plays = !self.bot_plays;\\n                } else if self.focus >= 6 {\\n                    cmds.push(self.reset_sliders());\\n                }\\n            }\\n            Screen::Settings if self.settings_page == 1 && self.focus == 0 => self.xbox = !self.xbox,\\n            Screen::Dead => cmds.push(Cmd::Retry),\\n            Screen::Story | Screen::Results | Screen::Card => cmds.push(Cmd::ConfirmSim),\\n            Screen::About => self.about_page = (self.about_page + 1) % 5,\\n580→            _ => {}\\n        }\\n    }\\n\\n    pub fn reset_sliders(&mut self) -> Cmd {\\n        for (i, (_, v, _, _)) in Tune::FIELDS.iter().enumerate() {\\n            self.sliders[i] = *v;\\n        }\\n        self.music = 0.10;\\n        self.effects = 0.80;\\n590→        self.voices = 0.70;\\n        Cmd::ResetTune\\n    }\\n\\n    pub fn mark_rank(&mut self, case_id: i8, rank: u8) {\\n        if (0..8).contains(&case_id) {\\n            let i = case_id as usize;\\n            if rank > self.best[i] {\\n                self.best[i] = rank;\\n            }\\n600→        }\\n    }\\n\\n    pub fn open_dev_for_test(&mut self) {\\n        self.paused = true;\\n        self.screen = Screen::Dev;\\n        self.focus = 2;\\n        self.dev_page = 0;\\n    }\\n}\\n610→\\nfn about_page_title(page: u8) -> &'static str {\\n    match page {\\n        0 => \\\"Credits\\\",\\n        1 => \\\"Source Information\\\",\\n        2 => \\\"Testing Feedback\\\",\\n        3 => \\\"Engine Feedback\\\",\\n        _ => \\\"Prompt Feedback\\\",\\n    }\\n}\\n620→\\nfn about_lines(page: u8) -> Vec<String> {\\n    let v: serde_json::Value = serde_json::from_str(ABOUT_JSON).unwrap_or(serde_json::json!({}));\\n    match page {\\n        0 => vec![\\n            \\\"Pavilion engine\\\".into(),\\n            \\\"Barlow Condensed, OFL\\\".into(),\\n            \\\"No audio files\\\".into(),\\n        ],\\n        1 => {\\n630→            let s = &v[\\\"sourceInformation\\\"];\\n            vec![\\n                format!(\\\"Date: {}\\\", s[\\\"date\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Source: {}\\\", s[\\\"source\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Plan: {}\\\", s[\\\"plan\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Genre: {}\\\", s[\\\"genre\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Perspective: {}\\\", s[\\\"perspective\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Tech: {}\\\", s[\\\"tech\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Art Direction: {}\\\", s[\\\"artDirection\\\"].as_str().unwrap_or(\\\"\\\")),\\n                format!(\\\"Animation: {}\\\", s[\\\"animation\\\"].as_str().unwrap_or(\\\"\\\")),\",\"content_concise\":\"360→        let menuish = matches!(\\n            self.screen,\\n            Screen::Title | Screen::Menu | Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls\\n        );\\n        if menuish && !input.any {\\n            self.idle += input.dt;\\n            if self.idle >= 10.0 {\\n                self.screen = Screen::Attract;\\n                self.idle = 0.0;\\n                cmds.push(Cmd::LoadAttract);\\n370→                return cmds;\\n            }\\n        } else if input.any {\\n            self.idle = 0.0;\\n        }\\n        if self.touch_only && !self.ever_fine && self.screen == Screen::Title {\\n            if input.confirm || input.click {\\n                self.screen = Screen::Settings;\\n                self.focus = 0;\\n            }\\n380→            return cmds;\\n        }\\n        let n = self.count();\\n        if let Some(p) = input.pointer {\\n            if let Some(hit) = self.hit(p) {\\n                self.focus = hit;\\n                self.device = DeviceKind::KeyboardMouse;\\n            }\\n        }\\n        if input.up {\\n390→            self.focus = self.focus.saturating_sub(1);\\n        }\\n        if input.down && n > 0 {\\n            self.focus = (self.focus + 1).min(n - 1);\\n        }\\n        if input.tab_l {\\n            self.page(-1);\\n        }\\n        if input.tab_r {\\n            self.page(1);\\n400→        }\\n        if input.left || input.right {\\n            let dir = if input.right { 1.0 } else { -1.0 };\\n            self.nudge(dir, &mut cmds);\\n        }\\n        if input.back {\\n            self.back();\\n        }\\n        if input.confirm || input.click {\\n            self.activate(&mut cmds);\\n410→        }\\n        if self.screen == Screen::Hud && input.back {\\n            self.paused = true;\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n        }\\n        cmds\\n    }\\n\\n    fn count(&self) -> usize {\\n420→        match self.screen {\\n            Screen::Menu | Screen::Pause => 6,\\n            Screen::Difficulty => 3,\\n            Screen::Files => 8,\\n            Screen::Settings => 3,\\n            Screen::Dev => 7,\\n            Screen::Dead => 1,\\n            Screen::Title => {\\n                if self.touch_only && !self.ever_fine {\\n                    1\\n430→                } else {\\n                    1\\n                }\\n            }\\n            _ => 1,\\n        }\\n    }\\n\\n    fn hit(&self, p: [f32; 2]) -> Option<usize> {\\n        let n = self.count();\\n440→        for i in 0..n {\\n            let y = 280.0 + i as f32 * 72.0;\\n            if p[0] >= 180.0 && p[0] <= 1100.0 && p[1] >= y && p[1] <= y + 60.0 {\\n                return Some(i);\\n            }\\n        }\\n        None\\n    }\\n\\n    fn page(&mut self, d: i8) {\\n450→        match self.screen {\\n            Screen::Settings => self.settings_page = (self.settings_page as i8 + d).rem_euclid(3) as u8,\\n            Screen::About => self.about_page = (self.about_page as i8 + d).rem_euclid(5) as u8,\\n            Screen::Dev => self.dev_page = (self.dev_page as i8 + d).rem_euclid(4) as u8,\\n            _ => {}\\n        }\\n        self.focus = 0;\\n    }\\n\\n    fn nudge(&mut self, dir: f32, cmds: &mut Vec<Cmd>) {\\n460→        if self.screen == Screen::Settings && self.settings_page == 0 {\\n            let slot = match self.focus {\\n                0 => &mut self.music,\\n                1 => &mut self.effects,\\n                2 => &mut self.voices,\\n                _ => return,\\n            };\\n            *slot = (*slot + dir * 0.05).clamp(0.0, 1.0);\\n            cmds.push(Cmd::SetBus { which: self.focus as u8, value: *slot });\\n        }\\n470→        if self.screen == Screen::Dev && self.focus < 6 {\\n            let id = self.dev_page as usize * 6 + self.focus;\\n            if id < Tune::FIELDS.len() {\\n                let (_, _, lo, hi) = Tune::FIELDS[id];\\n                let step = (hi - lo) / 20.0;\\n                self.sliders[id] = (self.sliders[id] + dir * step).clamp(lo, hi);\\n                cmds.push(Cmd::SetTune { id: id as u8, value: self.sliders[id] });\\n            }\\n        }\\n    }\\n480→\\n    fn back(&mut self) {\\n        match self.screen {\\n            Screen::Menu | Screen::Attract => self.screen = Screen::Title,\\n            Screen::Difficulty | Screen::Files | Screen::Settings | Screen::About | Screen::Controls => {\\n                self.screen = if self.paused { Screen::Pause } else { Screen::Menu };\\n            }\\n            Screen::Pause => {\\n                self.paused = false;\\n                self.screen = Screen::Hud;\\n490→            }\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Hud => {\\n                self.paused = true;\\n                self.screen = Screen::Pause;\\n                self.focus = 0;\\n            }\\n            _ => {}\\n        }\\n        self.focus = 0;\\n500→    }\\n\\n    fn activate(&mut self, cmds: &mut Vec<Cmd>) {\\n        match self.screen {\\n            Screen::Title => {\\n                self.screen = Screen::Menu;\\n                self.focus = 0;\\n            }\\n            Screen::Menu => match self.focus {