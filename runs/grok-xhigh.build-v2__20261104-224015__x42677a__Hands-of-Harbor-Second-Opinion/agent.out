crates/pav_render/src/capture.rs\",\"matches\":[{\"line_number\":10,\"content\":\"/// Renders `scene` at `width` x `height` and returns tightly packed RGBA8 pixels.\"},{\"line_number\":11,\"content\":\"pub fn render_to_rgba(renderer: &mut Renderer, scene: &Scene, width: u32, height: u32) -> Result<Vec<u8>> {\"},{\"line_number\":12,\"content\":\"    render_to_rgba_with(renderer, scene, width, height, |_, _, _, _| {})\"},{\"line_number\":22,\"content\":\"    height: u32,\"},{\"line_number\":29,\"content\":\"        size: wgpu::Extent3d { width, height, depth_or_array_layers: 1 },\"},{\"line_number\":39,\"content\":\"    renderer.render(&mut encoder, scene, &view, CAPTURE_FORMAT, (width, height));\"},{\"line_number\":41,\"content\":\"    read_texture(&device, &queue, encoder, &texture, width, height)\"},{\"line_number\":51,\"content\":\"    height: u32,\"},{\"line_number\":56,\"content\":\"        size: (padded * height) as u64,\"},{\"line_number\":64,\"content\":\"            layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(padded), rows_per_image: Some(height) },\"},{\"line_number\":66,\"content\":\"        wgpu::Extent3d { width, height, depth_or_array_layers: 1 },\"},{\"line_number\":77,\"content\":\"    let mut out = Vec::with_capacity((width * height * 4) as usize);\"},{\"line_number\":78,\"content\":\"    for row in 0..height as usize {\"},{\"line_number\":87,\"content\":\"pub fn encode_png(width: u32, height: u32, rgba: &[u8]) -> Result<Vec<u8>> {\"},{\"line_number\":90,\"content\":\"        let mut enc = png::Encoder::new(&mut out, width, height);\"},{\"line_number\":99,\"content\":\"pub fn save_png(path: &std::path::Path, width: u32, height: u32, rgba: &[u8]) -> Result<()> {\"},{\"line_number\":105,\"content\":\"    std::fs::write(path, encode_png(width, height, rgba)?).with_context(|| format!(\\\"writing {}\\\", path.display()))\"},{\"line_number\":109,\"content\":\"pub fn tile_frames(frames: &[Vec<u8>], width: u32, height: u32, columns: u32) -> (u32, u32, Vec<u8>) {\"},{\"line_number\":112,\"content\":\"    let (w, h) = (width * columns, height * rows);\"},{\"line_number\":116,\"content\":\"        for y in 0..height {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-93323ea4-2682-4054-a03a-a0f19a9a0a09-45","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,54,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,47,72,97,110,100,115,32,111,102,32,72,97,114,98,111,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,84,114,97,117,109,97,32,67,101,110,116,101,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,47,101,110,103,105,110,101,47,99,114,97,116,101,115,47,112,97,118,95,97,112,112,47,115,114,99,47,112,114,111,100,117,99,116,46,114,115,10,49,48,58,117,115,101,32,112,97,118,95,99,111,114,101,58,58,105,110,112,117,116,58,58,123,115,117,114,103,44,32,73,110,112,117,116,70,114,97,109,101,44,32,83,117,114,103,101,111,110,73,110,112,117,116,44,32,83,117,114,103,101,114,121,67,109,100,125,59,10,49,56,51,58,32,32,32,32,102,110,32,99,111,109,112,111,115,101,40,38,109,117,116,32,115,101,108,102,44,32,100,116,58,32,102,51,50,44,32,97,105,109,58,32,79,112