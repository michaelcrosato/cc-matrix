\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.outcome = Outcome::Playing;\\n        self.timer = 240.0;\\n        self.heart = Heart::new(70.0);\\n        self.hazards.clear();\\n        // Coarse plate, no shadows. A 420×240 mesh stalls the software-GPU iframe.\\n        self.hub_quiet = true;\\n    }\\n\\n    /// Replace the drawn world with a host snapshot. Cursors included; the tick then predicts the local hand.\\n    pub fn apply_mirror(\\n        &mut self,\\n        vitals: f32,\\n        bpm: f32,\\n        phase: f32,\\n        flat: bool,\\n        timer: f32,\\n        code_t: f32,\\n        hazards: &[(u32, u8, f32, f32, bool, u8, f32)],\\n        cursors: &[(u8, f32, f32, u8, bool, i32)],\\n    ) {\\n        self.mode = M_MIRROR;\\n        self.case_id = -1;\\n        self.code_blue = true;\\n        self.heart.vitals = vitals.clamp(0.0, 100.0);\\n        self.heart.bpm = bpm.max(1.0);\\n        self.heart.phase = phase;\\n        self.heart.flat = flat;\\n        self.timer = timer;\\n        self.code_t = code_t;\\n        self.hazards.clear();\\n        for &(id, kind, x, z, alive, stage, work) in hazards {\\n            let mut h = Hazard::make(kind.min(K_BURN), x, z);\\n            h.id = id;\\n            h.alive = alive;\\n            h.stage = stage;\\n            h.work = work;\\n            h.hidden = false;\\n            self.hazards.push(h);\\n        }\\n        for &(slot, x, z, tool, active, score) in cursors {\\n            let i = slot as usize;\\n            if i < 4 {\\n                let s = &mut self.surgeons[i];\\n                s.x = x;\\n                s.z = z;\\n                s.tool = tool;\\n                s.active = active;\\n                s.score = score;\\n            }\\n        }\\n    }\\n\\n    pub fn pending_gift(&self) -> u8 {\\n        let (u, d) = (self.gifts_unlocked, self.gifts_used);\\n        if self.recent_unlock != 0 && u & self.recent_unlock != 0 && d & self.recent_unlock == 0 {\\n            return self.recent_unlock;\\n        }\\n        for bit in [content::G_HUSH, content::G_ECHO, content::G_DUET] {\\n            if u & bit != 0 && d & bit == 0 {\\n                return bit;\\n            }\\n        }\\n        0\\n    }\\n\\n    fn reset_hands(&mut self) {\\n        for (i, s) in self.surgeons.iter_mut().enumerate() {\\n            let name = s.name_i;\\n            *s = Surgeon::new(name);\\n            s.active = i == 0;\\n        }\\n    }\\n\\n    fn prepare_case(&mut self, id: u8) {\\n        let Some(def) = case_def(id) else { return };\\n        self.case_id = id as i8;\\n        self.code_blue = false;\\n        self.plate = def.plate;\\n        self.plate_next = def.plate;\\n        self.plate_blend = 1.0;\\n        self.timer = def.timer * content::diff_timer(self.difficulty);\\n        self.par = def.par;\\n        self.heart = Heart::new(def.vitals);\\n        self.hazards.clear();\\n\",\"total_lines\":1119}}","is_error":false},{"type":"tool_result","tool_use_id":"call-20f4f22c-2ddc-4ae6-9265-8467c5e6f993-20","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,50,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,46,99,97,114,103,111,47,114,101,103,105,115,116,114,121,47,115,114,99,47,105,110,100,101,120,46,99,114,97,116,101,115,46,105,111,45,49,57,52,57,99,102,56,99,54,98,53,98,53,53,55,102,47,119,105,110,105,116,45,48,46,51,48,46,49,51,47,115,114,99,47,119,105,110,100,111,119,46,114,115,10,53,57,55,58,