y::apply_look(&mut scene, rig, aspect, &op.camera, true);\"},{\"line_number\":1438,\"content\":\"            if let Err(error) = crate::creatures::emit(&mut scene, &creature, style_of(Look::Lit, settings.style)) {\"},{\"line_number\":1444,\"content\":\"            self.arpg.emit(&mut scene, curr, g, alpha, time, dt, settings.particles, cam_fwd);\"},{\"line_number\":1477,\"content\":\"            crate::surgery::emit(&mut scene, op);\"},{\"line_number\":1478,\"content\":\"            crate::surgery::apply_look(&mut scene, rig, aspect, &op.camera, op.quiet);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_view/src/surgery/mod.rs\",\"matches\":[{\"line_number\":17,\"content\":\"    let (nx, nz) = if op.quiet { (QUIET_NX, QUIET_NZ) } else { (NX, NZ) };\"},{\"line_number\":21,\"content\":\"    if !op.quiet && (op.mode == 0 || op.mode == 1 || op.mode == 4 || op.mode == 6) {\"},{\"line_number\":26,\"content\":\"pub fn apply_look(scene: &mut Scene, _rig: &crate::camera::CameraRig, aspect: f32, shot: &CameraShot, quiet: bool) {\"},{\"line_number\":227,\"content\":\"    if !op.quiet && (op.mode == 3 || op.mode == 0 || op.mode == 6) {\"},{\"line_number\":545,\"content\":\"            op.quiet = true;\"},{\"line_number\":559,\"content\":\"            emit(&mut scene, &op);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/mod.rs\",\"matches\":[{\"line_number\":222,\"content\":\"    pub hub_quiet: bool,\"},{\"line_number\":297,\"content\":\"            hub_quiet: false,\"},{\"line_number\":317,\"content\":\"        g.hub_quiet = quiet;\"},{\"line_number\":331,\"content\":\"        self.hub_quiet = true;\"},{\"line_number\":971,\"content\":\