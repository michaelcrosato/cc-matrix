ne_number\":139,\"content\":\"  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\"},{\"line_number\":143,\"content\":\"  for (const group of standings) {\"},{\"line_number\":155,\"content\":\"  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\"},{\"line_number\":158,\"content\":\"  return { ok: true, standings: groups };\"},{\"line_number\":351,\"content\":\"  function finishResults() {\"},{\"line_number\":366,\"content\":\"  function finishPlayed(standings, extra = {}) {\"},{\"line_number\":367,\"content\":\"    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\"},{\"line_number\":370,\"content\":\"  function finishVoid(reason, endReason = 'void') {\"},{\"line_number\":371,\"content\":\"    end({ status: 'void', reason, endReason, standings: null });\"},{\"line_number\":380,\"content\":\"    if (outcome.standings) msg.standings = outcome.standings;\"},{\"line_number\":433,\"content\":\"        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\"},{\"line_number\":441,\"content\":\"        return finishPlayed(checked.standings, { scores, won, stats, awards });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"8411eeec-3278-4a69-b36f-42b159f81a51"}
