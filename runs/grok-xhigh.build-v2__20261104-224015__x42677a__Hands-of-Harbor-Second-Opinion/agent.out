rly}\\\");\\n        assert!(peak_late < 1e-3, \\\"decays: {peak_late}\\\");\\n    }\\n\\n    #[test]\\n    fn music_bus_defaults_quiet_and_every_cue_speaks() {\\n        let mixer = Mixer::new(48000.0);\\n        assert!((mixer.music - 0.10).abs() < 1e-6);\\n        assert!((mixer.effects - 0.80).abs() < 1e-6);\\n        assert!((mixer.voices_gain - 0.70).abs() < 1e-6);\\n        for id in 1..32 {\\n            let ev = SimEvent::Cue { id, pos: Vec3::ZERO, gain: 0.8, pitch: 1.0 };\\n            let out = render_events(&[(0.0, ev)], 0.4, 22050.0, &Listener::default());\\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\\n            assert!(peak > 0.001, \\\"cue {id} silent {peak}\\\");\\n        }\\n        for name in music::TRACKS {\\n            let out = music::render_track(name, 1.2, 90.0);\\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\\n            assert!(peak > 0.001, \\\"{name} silent {peak}\\\");\\n        }\\n        let voice = voice::render_line(\\\"Mara Quill\\\", \\\"Hold the line.\\\");\\n        let peak = voice.iter().fold(0.0f32, |m, s| m.max(s.abs()));\\n        assert!(peak > 0.001, \\\"voice silent {peak}\\\");\\n    }\\n}\\n\",\"total_lines\":822}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3368c53e-8d0a-4610-bcbd-ce5142293c1a-7","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,52,48,49,53,95,95,120,52,50,54,55,55,97,47,119,111,114,107,34,62,10,70,111,117,110,100,32,54,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,