{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-57a1de7b-1933-4b0e-b048-60f5c32047fc-52","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"//! Case tables. One source: the sim reads these, not a second handwritten copy.\\n\\nuse super::kinds::*;\\n\\npub const G_HUSH: u8 = 1;\\npub const G_ECHO: u8 = 2;\\npub const G_DUET: u8 = 4;\\npub const NO_STRAIN: u8 = 255;\\npub const KEEP_PLATE: u8 = 255;\\n\\n#[derive(Clone, Copy)]\\npub struct SpawnDef {\\n    pub kind: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub hidden: bool,\\n    pub drain: f32,\\n    pub axis: f32,\\n}\\n\\n#[derive(Clone, Copy)]\\npub struct PhaseDef {\\n    pub spawns: &'static [SpawnDef],\\n    pub checkpoint: bool,\\n    pub strain: u8,\\n    pub plate: u8,\\n    pub callout: u8,\\n    pub script_code: u8,\\n    pub unlock: u8,\\n    pub heat: bool,\\n}\\n\\npub struct CaseDef {\\n    pub name: &'static str,\\n    pub patient: &'static str,\\n    pub plate: u8,\\n    pub timer: f32,\\n    pub par: i32,\\n    pub vitals: f32,\\n    pub phases: &'static [PhaseDef],\\n}\\n\\nfn s(kind: u8, x: f32, z: f32, hidden: bool, drain: f32, axis: f32) -> SpawnDef {\\n    SpawnDef { kind, x, z, hidden, drain, axis }\\n}\\n\\nconst C0_A: &[SpawnDef] = &[\\n    s(K_LACERATION, -1.4, 0.2, false, 1.7, 0.3),\\n    s(K_POOL, 1.5, -0.8, false, 1.1, 0.0),\\n];\\nconst C0_B: &[SpawnDef] = &[\\n    s(K_INCISION, -2.4, 1.1, false, 0.0, 0.0),\\n    s(K_INFLAM, 1.2, 1.15, false, 0.45, 0.0),\\n];\\nconst C1_A: &[SpawnDef] = &[\\n    s(K_BLEEDER, -1.6, -0.2, false, 2.3, 0.2),\\n    s(K_FOREIGN, 0.7, 0.9, true, 0.7, 0.5),\\n];\\nconst C1_B: &[SpawnDef] = &[\\n    s(K_POLYP, 1.7, -1.0, false, 0.35, 0.0),\\n    s(K_POOL, -0.3, 1.45, false, 0.55, 0.0),\\n];\\nconst C2_A: &[SpawnDef] = &[\\n    s(K_BONE, 0.15, 0.15, false, 0.25, 0.0),\\n    s(K_TETHER, -1.8, 1.05, false, 0.3, 0.15),\\n];\\nconst C2_B: &[SpawnDef] = &[\\n    s(K_IV, 2.0, -