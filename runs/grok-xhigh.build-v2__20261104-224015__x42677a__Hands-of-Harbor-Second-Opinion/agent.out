n        }\n        let (x, z) = if s.held & surg::AIM_ABSOLUTE != 0 {\n            (s.aim.x, s.aim.y)\n        } else {\n            (op.cursors[i].x, op.cursors[i].z)\n        };\n        s.tool = contextual_tool(s.tool, x, z, &op.hazards);\n    }\n}\n\n/// Tenth-of-a-unit grid used on the wire. Both pages report this same f32."}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":9299,"output_tokens":1875,"cache_read_input_tokens":142336,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa38-de6f-7dc0-ae0d-e0f717ed75f2","uuid":"dcd7961a-dad1-4b88-b21b-e63d110e9d41"}
