7,40,97,112,112,58,32,38,65,112,112,41,32,123,10,54,51,57,58,32,32,32,32,108,101,116,32,95,32,61,32,106,115,95,115,121,115,58,58,82,101,102,108,101,99,116,58,58,115,101,116,40,38,119,105,110,44,32,38,34,95,95,103,97,109,101,34,46,105,110,116,111,40,41,44,32,38,111,98,106,41,59,10,54,52,52,58,112,117,98,32,102,110,32,115,117,114,103,101,114,121,95,101,118,101,110,116,40,97,112,112,58,32,38,109,117,116,32,65,112,112,44,32,101,108,58,32,38,65,99,116,105,118,101,69,118,101,110,116,76,111,111,112,44,32,95,105,100,58,32,87,105,110,100,111,119,73,100,44,32,101,118,101,110,116,58,32,87,105,110,100,111,119,69,118,101,110,116,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":15,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_app/src/product.rs\",\"matches\":[{\"line_number\":71,\"content\":\"    mouse_owns: bool,\"},{\"line_number\":99,\"content\":\"            mouse_owns: false,\"},{\"line_number\":132,\"content\":\"fn read_pads(gilrs: Option<&mut gilrs::Gilrs>) -> [PadHand; 4] {\"},{\"line_number\":176,\"content\":\"            self.mouse_owns = false;\"},{\"line_number\":178,\"content\":\"            self.mouse_owns = true;\"},{\"line_number\":215,\"content\":\"                surgeons[i] = self.hand(i, aim, i == 0 && self.mouse_owns);\"},{\"line_number\":272,\"content\":\"    fn hand(&self, slot: usize, mouse_aim: Option<[f32; 2]>, mouse_owns: bool) -> SurgeonInput {\"},{\"line_number\":277,\"content\":\"        if slot == 0 && mouse_owns {\"},{\"line_number\":284,\"content\":\"        } else if slot == 0 && !mouse_owns {\"},{\"line_number\":308,\"content\":\"        let precise = (slot == 0 && self.key(KeyCode::ShiftLeft) && !mouse_owns) || pad.lt > 0.35;\"},{\"line_number\":430,\"content\":\"pub fn surgery_frame(app: &m