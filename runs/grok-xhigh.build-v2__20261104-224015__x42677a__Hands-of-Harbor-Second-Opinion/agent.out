r-scalable=no\\\">\\n<title>Shardfall</title>\\n<meta name=\\\"description\\\" content=\\\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#15171c\\\">\\n<meta name=\\\"mobile-web-app-capable\\\" content=\\\"yes\\\">\\n10→<meta name=\\\"apple-mobile-web-app-capable\\\" content=\\\"yes\\\">\\n<meta name=\\\"apple-mobile-web-app-status-bar-style\\\" content=\\\"black-translucent\\\">\\n<link rel=\\\"manifest\\\" href=\\\"manifest.webmanifest\\\">\\n<link rel=\\\"icon\\\" href=\\\"data:,\\\">\\n<style>\\n  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\\n  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\\n               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\\n               -webkit-tap-highlight-color: transparent; }\\n  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\\n20→     dvh: the height that is visible while a phone's browser bars come and go. */\\n  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\\n           outline: none; touch-action: none; }\\n  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\\n         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\\n  /* Phones held upright: a hint to turn sideways that fades by itself. */\\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\\n          pointer-events: none; animation: fade 1s 5s forwards; }\\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\\