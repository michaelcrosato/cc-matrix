  1 => self.tune.effects = v,\\n                    2 => self.tune.voices = v,\\n                    _ => {}\\n                }\\n            }\\n        }\\n    }\\n\\n    fn skip(&mut self) {\\n        match self.mode {\\n820→            M_STORY => {\\n                self.story_i = u16::MAX / 2;\\n                self.end_story();\\n            }\\n            M_CHART => {\\n                self.mode = if self.mode == M_ATTRACT { M_ATTRACT } else { M_OP };\\n                self.phase_ready = false;\\n            }\\n            M_RESULTS if self.campaign => {\\n                self.mode = M_STORY;\\n830→                self.story_after = true;\\n                self.story_i = 0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn end_story(&mut self) {\\n        if self.story_after {\\n            if self.case_id >= 7 {\\n840→                self.outcome = Outcome::Won;\\n                self.mode = M_RESULTS;\\n            } else if self.case_id >= 0 {\\n                let next = self.case_id as u8 + 1;\\n                self.prepare_case(next);\\n                self.campaign = true;\\n                self.mode = M_STORY;\\n                self.story_after = false;\\n                self.story_i = 0;\\n            }\\n850→        } else {\\n            self.mode = M_CHART;\\n            self.story_i = 0;\\n        }\\n    }\\n\\n    fn to_frame(&self) -> SurgeryFrame {\\n        let mut fr = SurgeryFrame::empty();\\n        fr.mode = self.mode;\\n        fr.case_id = self.case_id;\\n860→        fr.attract = self.mode == M_ATTRACT;\\n        fr.card_ready = self.mode == M_CARD && self.card_t > 0.4;\\n        if self.case_id < 0 {\\n            fr.op_name = \\\"Code Blue\\\".to_string();\\n            fr.patient = \\\"Night Intake\\\".to_string();\\n        } else if let Some(def) = case_def(self.case_id as u8) {\\n            fr.op_name = def.name.to_string();\\n            fr.patient = def.patient.to_string();\\n        }\\n        fr.plate = self.plate;\\n870→        fr.plate_next = self.plate_next;\\n        fr.plate_blend = self.plate_blend;\\n        fr.vitals = self.heart.vitals;\\n        fr.bpm = self.heart.bpm;\\n        fr.phase = self.heart.phase;\\n        fr.flat = self.heart.flat;\\n        fr.on_beat = if self.heart.flat {\\n            self.heart.ghost_on_beat(self.tune.beat_window_ms)\\n        } else {\\n            self.heart.on_beat(self.tune.beat_window_ms)\\n880→        };\\n        fr.timer = self.timer;\\n        fr.elapsed = self.elapsed;\\n        fr.score = if self.mode == M_RESULTS || self.outcome != Outcome::Playing { self.shown_score } else { self.total_score() };\\n        fr.par = self.par;\\n        fr.rank = self.rank;\\n        fr.chain = self.best_chain();\\n        fr.mistakes = self.mistakes;\\n        fr.code_t = self.code_t;\\n        fr.codes_left = self.codes_left;\\n890→        fr.shocks_done = self.shocks_done;\\n        fr.shocks_need = self.shocks_need;\\n        fr.fever = self.fever;\\n        fr.heat_on = self.heat_on;\\n        fr.heat_angle = self.heat_angle;\\n        fr.strain = self.strain_phase;\\n        fr.gift_hush = if self.hush_beats > 0 { self.hush_beats as f32 } else { 0.0 };\\n        fr.gift_echo = self.echo_left;\\n        fr.gift_duet = self.duet_left;\\n        fr.gifts_unlocked = self.gifts_unlocked;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/mod.rs\",\"offset\":620,\"limit\":280,\"raw_output\":\"        self.mode = if self.mode == M_ATTRACT { M_ATTRACT } else { M_OP };\\n        self.outcome = Outcome::Playing;\\n    }\\n\\n    pub(crate) fn finish_op(&mut self) {\\n        self.shown_score = self.total_score();\\n        self.rank = rank_of(self.shown_score, self.par);\\n        self.banner_t = 3.0;\\n        if self.mode == M_ATTRACT {\\n            self.boot_attract();\\n            return;\\n        }\\n        self.mode = M_RESULTS;\\n        if !self.campaign {\\n            self.outcome = Outcome::Won;\\n        }\\n    }\\n\\n    pub(crate) fn die(&mut self) {\\n        if self.immortal {\\n            self.heart.vitals = 48.0;\\n            self.heart.flat = false;\\n            self.code_t = -1.0;\\n            return;\\n        }\\n        self.mode = M_DEAD;\\n        self.outcome = Outcome::Lost;\\n        self.heart.vitals = 0.0;\\n        self.heart.flat = true;\\n        self.code_t = -1.0;\\n    }\\n\\n    pub(crate) fn begin_code(&mut self, scripted: bool) {\\n        if self.heart.flat && self.code_t > 0.0 {\\n            return;\\n        }\\n        if !scripted && self.codes_left == 0 {\\n            self.die();\\n            return;\\n        }\\n        if !scripted {\\n            self.codes_left = self.codes_left.saturating_sub(1);\\n        }\\n        self.code_scripted = scripted;\\n        self.heart.vitals = 0.0;\\n        self.heart.flat = true;\\n        self.heart.ghost = 0.0;\\n        self.code_t = self.tune.code_window.max(1.0);\\n        self.coverage.code = self.coverage.code.saturating_add(1);\\n        self.callout_i = 5;\\n        self.callout_t = 2.4;\\n        for s in &mut self.surgeons {\\n            s.defib = 0.0;\\n            s.was_defib = false;\\n        }\\n    }\\n\\n    pub(crate) fn resuscitate(&mut self) {\\n        self.heart.vitals = 30.0;\\n        self.heart.flat = false;\\n        self.heart.phase = 0.0;\\n        self.heart.since_r = 0.0;\\n        self.heart.recompute(self.tune.heart_coupling);\\n        self.code_t = -1.0;\\n        self.callout_i = 6;\\n        self.callout_t = 2.2;\\n        self.coverage.tools[DEFIB as usize] = self.coverage.tools[DEFIB as usize].saturating_add(1);\\n        for s in &mut self.surgeons {\\n            s.defib = 0.0;\\n            s.was_defib = false;\\n        }\\n        if self.code_scripted && self.shocks_need > 0 {\\n            self.shocks_done = self.shocks_done.saturating_add(1);\\n            if self.shocks_done < self.shocks_need {\\n                self.begin_code(true);\\n            }\\n        }\\n    }\\n\\n    pub(crate) fn activate_gift(&mut self, bit: u8) {\\n        if bit == 0 {\\n            return;\\n        }\\n        let idx = match bit {\\n            content::G_HUSH => 0,\\n            content::G_ECHO => 1,\\n            content::G_DUET => 2,\\n            _ => return,\\n        };\\n        if self.gifts_used & bit == 0 {\\n            self.coverage.gifts[idx] = self.coverage.gifts[idx].saturating_add(1);\\n        }\\n        self.gifts_used |= bit;\\n        self.surgeons[0].meter = 0.0;\\n        self.callout_t = 2.4;\\n        match bit {\\n            content::G_HUSH => {\\n                self.hush_beats = ((6.0 * self.tune.gift_duration).round() as u8).max(1);\\n                self.callout_i = 7;\\n            }\\n            content::G_ECHO => {\\n                self.echo_left = self.tune.echo_duration * self.tune.gift_duration;\\n                self.echo_cool = 0.4;\\n                self.callout_i = 8;\\n            }\\n            content::G_DUET => {\\n                self.duet_left = 8.0 * self.tune.gift_duration;\\n                self.callout_i = 9;\\n                self.surgeons[1].active = true;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn total_score(&self) -> i32 {\\n        let hands: i32 = self.surgeons.iter().map(|s| s.score).sum();\\n        let bonus = (self.heart.vitals * 20.0) as i32 + (self.timer.max(0.0) * 5.0) as i32 - self.mistakes as i32 * 100;\\n        hands + bonus\\n    }\\n\\n    pub fn best_chain(&self) -> u32 {\\n        self.surgeons.iter().map(|s| s.best_chain).max().unwrap_or(0)\\n    }\\n\\n    pub fn apply_cmd(&mut self, cmd: SurgeryCmd) {\\n        self.command(cmd);\\n    }\\n\\n    fn command(&mut self, cmd: SurgeryCmd) {\\n        match cmd {\\n            SurgeryCmd::Retry => self.restore_checkpoint(),\\n            SurgeryCmd::Skip => self.skip(),\\n            SurgeryCmd::SetTune { id, value } => self.tune.set(id, value),\\n            SurgeryCmd::ResetTune => self.tune = Tune::default(),\\n            SurgeryCmd::LoadCase(n) => self.boot_single(n),\\n            SurgeryCmd::LoadCampaign => self.boot_campaign(),\\n            SurgeryCmd::LoadCode => self.boot_code(),\\n            SurgeryCmd::SetDifficulty(d) => {\\n                self.difficulty = d.min(2);\\n            }\\n            SurgeryCmd::Dev { what, extra } => match what {\\n                0 => self.immortal = !self.immortal,\\n                1 => self.freeze = !self.freeze,\\n                2 => {\\n                    self.gifts_unlocked |= content::G_HUSH | content::G_ECHO | content::G_DUET;\\n                    self.surgeons[0].meter = 100.0;\\n                    self.recent_unlock = content::G_HUSH;\\n                }\\n                3 => self.one_hit = !self.one_hit,\\n                4 => self.begin_code(true),\\n                5 => {\\n                    self.immortal = false;\\n                    self.codes_left = 0;\\n                    self.heart.vitals = 0.0;\\n                    self.die();\\n                }\\n                6 => {\\n                    self.shown_score = self.total_score().max(self.par);\\n                    self.rank = rank_of(self.shown_score, self.par);\\n                    self.mode = M_RESULTS;\\n                    self.outcome = Outcome::Won;\\n                }\\n                7 => {\\n                    self.hazards.clear();\\n                    self.phase_i = self.phase_i.saturating_add(1);\\n                    self.phase_ready = false;\\n                    self.heart.flat = false;\\n                    self.code_t = -1.0;\\n                }\\n                8 => self.bot_drive = extra != 0,\\n                _ => {}\\n            },\\n            SurgeryCmd::SpawnHazard(k) => {\\n                let n = self.spawn_n;\\n                self.spawn_n = self.spawn_n.wrapping_add(1);\\n                let ang = n as f32 * 0.9;\\n                self.spawn_kind_at(k.min(K_BURN), ang.cos() * 1.2, ang.sin() * 0.8, -1.0);\\n            }\\n            SurgeryCmd::LoadAttract => self.boot_attract(),\\n            SurgeryCmd::ToTitle => {\\n                self.mode = M_TITLE;\\n                self.outcome = Outcome::Playing;\\n                self.hazards.clear();\\n                self.code_t = -1.0;\\n                self.heart.flat = false;\\n            }\\n            SurgeryCmd::SetBus { which, value } => {\\n                let v = value.clamp(0.0, 1.0);\\n                match which {\\n                    0 => self.tune.music = v,\\n                    1 => self.tune.effects = v,\\n                    2 => self.tune.voices = v,\\n                    _ => {}\\n                }\\n            }\\n        }\\n    }\\n\\n    fn skip(&mut self) {\\n        match self.mode {\\n            M_STORY => {\\n                self.story_i = u16::MAX / 2;\\n                self.end_story();\\n            }\\n            M_CHART => {\\n                self.mode = if self.mode == M_ATTRACT { M_ATTRACT } else { M_OP };\\n                self.phase_ready = false;\\n            }\\n            M_RESULTS if self.campaign => {\\n                self.mode = M_STORY;\\n                self.story_after = true;\\n                self.story_i = 0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn end_story(&mut self) {\\n        if self.story_after {\\n            if self.case_id >= 7 {\\n                self.outcome = Outcome::Won;\\n                self.mode = M_RESULTS;\\n            } else if self.case_id >= 0 {\\n                let next = self.case_id as u8 + 1;\\n                self.prepare_case(next);\\n                self.campaign = true;\\n                self.mode = M_STORY;\\n                self.story_after = false;\\n                self.story_i = 0;\\n            }\\n        } else {\\n            self.mode = M_CHART;\\n            self.story_i = 0;\\n        }\\n    }\\n\\n    fn to_frame(&self) -> SurgeryFrame {\\n        let mut fr = SurgeryFrame::empty();\\n        fr.mode = self.mode;\\n        fr.case_id = self.case_id;\\n        fr.attract = self.mode == M_ATTRACT;\\n        fr.card_ready = self.mode == M_CARD && self.card_t > 0.4;\\n        if self.case_id < 0 {\\n            fr.op_name = \\\"Code Blue\\\".to_string();\\n            fr.patient = \\\"Night Intake\\\".to_string();\\n        } else if let Some(def) = case_def(self.case_id as u8) {\\n            fr.op_name = def.name.to_string();\\n            fr.patient = def.patient.to_string();\\n        }\\n        fr.plate = self.plate;\\n        fr.plate_next = self.plate_next;\\n        fr.plate_blend = self.plate_blend;\\n        fr.vitals = self.heart.vitals;\\n        fr.bpm = self.heart.bpm;\\n        fr.phase = self.heart.phase;\\n        fr.flat = self.heart.flat;\\n        fr.on_beat = if self.heart.flat {\\n            self.heart.ghost_on_beat(self.tune.beat_window_ms)\\n        } else {\\n            self.heart.on_beat(self.tune.beat_window_ms)\\n        };\\n        fr.timer = self.timer;\\n        fr.elapsed = self.elapsed;\\n        fr.score = if self.mode == M_RESULTS || self.outcome != Outcome::Playing { self.shown_score } else { self.total_score() };\\n        fr.par = self.par;\\n        fr.rank = self.rank;\\n        fr.chain = self.best_chain();\\n        fr.mistakes = self.mistakes;\\n        fr.code_t = self.code_t;\\n        fr.codes_left = self.codes_left;\\n        fr.shocks_done = self.shocks_done;\\n        fr.shocks_need = self.shocks_need;\\n        fr.fever = self.fever;\\n        fr.heat_on = self.heat_on;\\n        fr.heat_angle = self.heat_angle;\\n        fr.strain = self.strain_phase;\\n        fr.gift_hush = if self.hush_beats > 0 { self.hush_beats as f32 } else { 0.0 };\\n        fr.gift_echo = self.echo_left;\\n        fr.gift_duet = self.duet_left;\\n        fr.gifts_unlocked = self.gifts_unlocked;\\n\",\"total_lines\":1117}}","is_error":false},{"type":"tool_result","tool_use_id":"call-c7b90bd8-39ba-4d50-9fd9-2805153c8c5f-41","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"630→        }\\n        4 => {\\n            g.spawn_kind_at(K_EMBER, -0.3, 0.6, 0.3);\\n            g.spawn_kind_at(K_BURN, 1.2, -0.7, 0.3);\\n        }\\n        _ => {\\n            g.spawn_kind_at(K_INCISION, -1.8, 0.4, 0.0);\\n            g.spawn_kind_at(K_DRESSING, 0.6, -1.0, 0.1);\\n        }\\n    }\\n640→    if extra >= 1 {\\n        g.spawn_kind_at(K_POOL, -1.6, -1.1, 0.4);\\n    }\\n    if extra >= 2 {\\n        g.spawn_kind_at(K_LACERATION, 1.6, 1.0, 0.6);\\n    }\\n    if extra >= 3 {\\n        g.spawn_kind_at(K_BLEEDER, 0.0, 1.3, 1.4);\\n    }\\n    let _ = sim;\\n650→}\\n\\nfn select(\\n    hazards: &[Hazard],\\n    x: f32,\\n    z: f32,\\n    tool: u8,\\n    focus: Option<u32>,\\n    just_release: bool,\\n    use_held: bool,\\n660→) -> Option<usize> {\\n    if just_release || use_held {\\n        if let Some(id) = focus {\\n            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\\n                let h = &hazards[i];\\n                // A pull travels away from the wound. Keep the grabbed hazard, or the\\n                // one this tool is already working, so a neighbor does not steal it.\\n                if h.grabbed || (use_held && h.accepts(tool) && h.dist(x, z) < h.radius + 2.6) || just_release {\\n                    return Some(i);\\n                }\\n670→            }\\n        }\\n    }\\n    if tool == IV {\\n        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\\n            return Some(i);\\n        }\\n    }\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n680→    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n690→    best\\n}\\n\\nfn nearest_wrong(hazards: &[Hazard], x: f32, z: f32, tool: u8) -> Option<usize> {\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT || h.accepts(tool) {\\n            continue;\\n        }\\n700→        let d = h.dist(x, z);\\n        if d <= h.radius + 0.12 && d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n    best\\n}\\n\\nfn assist_aim(g: &Surgery, x: f32, z: f32, tool: u8, aim: glam::Vec2, dt: f32) -> glam::Vec2 {\\n710→    let scale = g.tune.aim_assist.clamp(0.0, 2.0);\\n    if scale <= 0.0 || aim.length_squared() < 0.0004 {\\n        return aim;\\n    }\\n    let mut best: Option<(f32, f32, f32)> = None;\\n    for h in &g.hazards {\\n        if !h.alive || h.kind == K_HEAT || !h.accepts(tool) {\\n            continue;\\n        }\\n        let dx = h.x - x;\\n720→        let dz = h.z - z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        if d < 1.2 && best.map(|(bd, _, _)| d < bd).unwrap_or(true) {\\n            best = Some((d, dx, dz));\\n        }\\n    }\\n    let Some((d, dx, dz)) = best else { return aim };\\n    let closeness = (1.0 - d / 1.2).clamp(0.0, 1.0) * scale.min(1.0);\\n    let mut aim = aim * (1.0 - 0.5 * closeness);\\n    if d > 0.02 {\\n730→        let inv = 1.0 / d;\\n        let pull = 3.0 * dt * closeness;\\n        let extra = pull / (g.tune.cursor_speed.max(1.0) * dt.max(1e-4));\\n        aim.x += dx * inv * extra;\\n        aim.y += dz * inv * extra;\\n    }\\n    aim\\n}\\n\\nfn mirror_predict(g: &mut Surgery, input: &InputFrame, dt: f32) {\\n740→    for (i, inp) in input.surgeons.iter().enumerate() {\\n        if !inp.active {\\n            continue;\\n        }\\n        let s = &mut g.surgeons[i];\\n        s.active = true;\\n        if inp.tool != TOOL_KEEP {\\n            s.tool = inp.tool;\\n        }\\n        steer(s, *inp, dt, g.tune.cursor_speed);\\n750→    }\\n}\\n\\nfn steer(s: &mut Surgeon, inp: SurgeonInput, dt: f32, speed: f32) {\\n    let abs = inp.held & surg::AIM_ABSOLUTE != 0;\\n    let snap = inp.held & surg::SNAP != 0;\\n    if abs && snap {\\n        s.x = inp.aim.x;\\n        s.z = inp.aim.y;\\n        return;\\n760→    }\\n    if abs {\\n        let dx = inp.aim.x - s.x;\\n        let dz = inp.aim.y - s.z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        let step = speed.max(1.0) * dt;\\n        if d <= step || d < 1e-5 {\\n            s.x = inp.aim.x;\\n            s.z = inp.aim.y;\\n        } else {\\n770→            s.x += dx / d * step;\\n            s.z += dz / d * step;\\n        }\\n    } else if inp.aim.length_squared() > 0.0004 {\\n        s.x += inp.aim.x * speed * dt;\\n        s.z += inp.aim.y * speed * dt;\\n    }\\n}\\n\\nfn heat_hit(angle: f32, x: f32, z: f32) -> bool {\\n780→    let ang = z.atan2(x);\\n    let mut d = (ang - angle).abs();\\n    if d > std::f32::consts::PI {\\n        d = std::f32::consts::TAU - d;\\n    }\\n    let r = (x * x + z * z).sqrt();\\n    d < 0.22 && r > 0.4\\n}\\n\\nfn note_kind(g: &mut Surgery, kind: u8) {\\n790→    let i = kind as usize;\\n    if i < g.coverage.hazards.len() {\\n        g.coverage.hazards[i] = g.coverage.hazards[i].saturating_add(1);\\n    }\\n}\\n\\nfn push_popup(g: &mut Surgery, rating: u8, x: f32, z: f32) {\\n    g.popups[0] = g.popups[1];\\n    g.popups[1] = g.popups[2];\\n    g.popups[2] = g.popups[3];\\n800→    g.popups[3] = (rating, 1.1, x, z);\\n}\\n\\nfn cue(events: &mut Vec<SimEvent>, id: u16, x: f32, z: f32, gain: f32, pitch: f32) {\\n    events.push(SimEvent::Cue { id, pos: Vec3::new(x, 0.2, z), gain, pitch });\\n}\\n\",\"content_concise\":\"630→        }\\n        4 => {\\n            g.spawn_kind_at(K_EMBER, -0.3, 0.6, 0.3);\\n            g.spawn_kind_at(K_BURN, 1.2, -0.7, 0.3);\\n        }\\n        _ => {\\n            g.spawn_kind_at(K_INCISION, -1.8, 0.4, 0.0);\\n            g.spawn_kind_at(K_DRESSING, 0.6, -1.0, 0.1);\\n        }\\n    }\\n640→    if extra >= 1 {\\n        g.spawn_kind_at(K_POOL, -1.6, -1.1, 0.4);\\n    }\\n    if extra >= 2 {\\n        g.spawn_kind_at(K_LACERATION, 1.6, 1.0, 0.6);\\n    }\\n    if extra >= 3 {\\n        g.spawn_kind_at(K_BLEEDER, 0.0, 1.3, 1.4);\\n    }\\n    let _ = sim;\\n650→}\\n\\nfn select(\\n    hazards: &[Hazard],\\n    x: f32,\\n    z: f32,\\n    tool: u8,\\n    focus: Option<u32>,\\n    just_release: bool,\\n    use_held: bool,\\n660→) -> Option<usize> {\\n    if just_release || use_held {\\n        if let Some(id) = focus {\\n            if let Some(i) = hazards.iter().position(|h| h.id == id && h.alive && h.kind != K_HEAT) {\\n                let h = &hazards[i];\\n                // A pull travels away from the wound. Keep the grabbed hazard, or the\\n                // one this tool is already working, so a neighbor does not steal it.\\n                if h.grabbed || (use_held && h.accepts(tool) && h.dist(x, z) < h.radius + 2.6) || just_release {\\n                    return Some(i);\\n                }\\n670→            }\\n        }\\n    }\\n    if tool == IV {\\n        if let Some(i) = hazards.iter().position(|h| h.alive && h.kind == K_IV) {\\n            return Some(i);\\n        }\\n    }\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n680→    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT {\\n            continue;\\n        }\\n        let d = h.dist(x, z);\\n        if d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n690→    best\\n}\\n\\nfn nearest_wrong(hazards: &[Hazard], x: f32, z: f32, tool: u8) -> Option<usize> {\\n    let mut best = None;\\n    let mut best_d = f32::MAX;\\n    for (i, h) in hazards.iter().enumerate() {\\n        if !h.alive || h.kind == K_HEAT || h.accepts(tool) {\\n            continue;\\n        }\\n700→        let d = h.dist(x, z);\\n        if d <= h.radius + 0.12 && d < best_d {\\n            best_d = d;\\n            best = Some(i);\\n        }\\n    }\\n    best\\n}\\n\\nfn assist_aim(g: &Surgery, x: f32, z: f32, tool: u8, aim: glam::Vec2, dt: f32) -> glam::Vec2 {\\n710→    let scale = g.tune.aim_assist.clamp(0.0, 2.0);\\n    if scale <= 0.0 || aim.length_squared() < 0.0004 {\\n        return aim;\\n    }\\n    let mut best: Option<(f32, f32, f32)> = None;\\n    for h in &g.hazards {\\n        if !h.alive || h.kind == K_HEAT || !h.accepts(tool) {\\n            continue;\\n        }\\n        let dx = h.x - x;\\n720→        let dz = h.z - z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        if d < 1.2 && best.map(|(bd, _, _)| d < bd).unwrap_or(true) {\\n            best = Some((d, dx, dz));\\n        }\\n    }\\n    let Some((d, dx, dz)) = best else { return aim };\\n    let closeness = (1.0 - d / 1.2).clamp(0.0, 1.0) * scale.min(1.0);\\n    let mut aim = aim * (1.0 - 0.5 * closeness);\\n    if d > 0.02 {\\n730→        let inv = 1.0 / d;\\n        let pull = 3.0 * dt * closeness;\\n        let extra = pull / (g.tune.cursor_speed.max(1.0) * dt.max(1e-4));\\n        aim.x += dx * inv * extra;\\n        aim.y += dz * inv * extra;\\n    }\\n    aim\\n}\\n\\nfn mirror_predict(g: &mut Surgery, input: &InputFrame, dt: f32) {\\n740→    for (i, inp) in input.surgeons.iter().enumerate() {\\n        if !inp.active {\\n            continue;\\n        }\\n        let s = &mut g.surgeons[i];\\n        s.active = true;\\n        if inp.tool != TOOL_KEEP {\\n            s.tool = inp.tool;\\n        }\\n        steer(s, *inp, dt, g.tune.cursor_speed);\\n750→    }\\n}\\n\\nfn steer(s: &mut Surgeon, inp: SurgeonInput, dt: f32, speed: f32) {\\n    let abs = inp.held & surg::AIM_ABSOLUTE != 0;\\n    let snap = inp.held & surg::SNAP != 0;\\n    if abs && snap {\\n        s.x = inp.aim.x;\\n        s.z = inp.aim.y;\\n        return;\\n760→    }\\n    if abs {\\n        let dx = inp.aim.x - s.x;\\n        let dz = inp.aim.y - s.z;\\n        let d = (dx * dx + dz * dz).sqrt();\\n        let step = speed.max(1.0) * dt;\\n        if d <= step || d < 1e-5 {\\n            s.x = inp.aim.x;\\n            s.z = inp.aim.y;\\n        } else {\\n770→            s.x += dx / d * step;\\n            s.z += dz / d * step;\\n        }\\n    } else if inp.aim.length_squared() > 0.0004 {\\n        s.x += inp.aim.x * speed * dt;\\n        s.z += inp.aim.y * speed * dt;\\n    }\\n}\\n\\nfn heat_hit(angle: f32, x: f32, z: f32) -> bool {\\n780→    let ang = z.atan2(x);\\n    let mut d = (ang - angle).abs();\\n    if d > std::f32::consts::PI {\\n        d = std::f32::consts::TAU - d;\\n    }\\n    let r = (x * x + z * z).sqrt();\\n    d < 0.22 && r > 0.4\\n}\\n\\nfn note_kind(g: &mut Surgery, kind: u8) {\\n790→    let i = kind as usize;\\n    if i < g.coverage.hazards.len() {\\n        g.coverage.hazards[i] = g.coverage.hazards[i].saturating_add(1);\\n    }\\n}\\n\\nfn push_popup(g: &mut Surgery, rating: u8, x: f32, z: f32) {\\n    g.popups[0] = g.popups[1];\\n    g.popups[1] = g.popups[2];\\n    g.popups[2] = g.popups[3];\\n800→    g.popups[3] = (rating, 1.1, x, z);\\n}\\n\\nfn cue(events: &mut Vec<SimEvent>, id: u16, x: f32, z: f32, gain: f32, pitch: f32) {\\n    events.push(SimEvent::Cue { id, pos: Vec3::new(x, 0.2, z), gain, pitch });\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-224015__x42677a/work/Hands of Harbor: Second Opinion-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-224015/engine/crates/pav_core/src/games/surgery/ops.rs\",\"offset\":630,\"limit\":200,\"raw_output\":\"        }\\n        4 => {\\n            g.spawn_kind_at(K_EMBER, -0.3, 0.6, 0.3);\\n            g.spawn_kind_at(K_BURN, 1.2, -0.7, 0.3);\\n        }\\n        _ => {\\n            g.spawn_kind_at(K_INCISION, -1.8, 0.4, 0.0);\\n            g.spawn_kind_at(K_DRESSING, 0.6, 