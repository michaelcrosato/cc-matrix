{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-60e1b839-00a0-4c6b-9502-30b410a9ea37-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→            \\\"Four were critical\\\",\\n            \\\"most helpful\\\",\\n            \\\"least helpful\\\",\\n            \\\"Scene actions\\\",\\n            \\\"playClip\\\",\\n            \\\"balance step\\\",\\n            \\\"hardest part\\\",\\n            \\\"None. The engine files were not changed.\\\",\\n            \\\"I would let a page add a mesh\\\",\\n            \\\"acceptance numbers\\\",\\n310→            \\\"group score\\\",\\n            \\\"one HTML file\\\",\\n            \\\"session client hash\\\",\\n        ):\\n            if needle not in about:\\n                fails.append(f\\\"about missing {needle}\\\")\\n        rows = page.locator(\\\"[data-ui=item]\\\").count()\\n        if rows > 6:\\n            fails.append(f\\\"menu has {rows} rows\\\")\\n        small = page.evaluate(\\n320→            \\\"\\\"\\\"() => {\\n              const found = [];\\n              const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\\n              while (walker.nextNode()) {\\n                const text = walker.currentNode.textContent.trim();\\n                if (!text) continue;\\n                const el = walker.currentNode.parentElement;\\n                if (!el) continue;\\n                const style = getComputedStyle(el);\\n                if (style.display === 'none' || style.visibility === 'hidden') continue;\\n330→                const rect = el.getBoundingClientRect();\\n                if (rect.width < 1 || rect.height < 1) continue;\\n                const size = parseFloat(style.fontSize);\\n                if (size < 28) found.push(text.slice(0, 48) + ' ' + size);\\n              }\\n              return found.slice(0, 8);\\n            }\\\"\\\"\\\"\\n        )\\n        if small:\\n            fails.append(f\\\"text under 28px {small}\\\")\\n340→        trace.append(f\\\"menu rows {rows}\\\")\\n        trace.append(\\\"font ok\\\" if not small else f\\\"font {small}\\\")\\n        trace.append(\\\"about ok\\\" if not any(item.startswith(\\\"about missing\\\") for item in fails) else \\\"about incomplete\\\")\\n    except Exception as error:\\n        fails.append(f\\\"shell {error}\\\")\\n        trace.append(f\\\"shell {error}\\\")\\n    finally:\\n        (out / \\\"browser.log\\\").write_text(\\\"\\\\n\\\".join(trace) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n        page.close()\\n\\n350→\\ndef touch(browser, playwright, html: Path, fails: list[str]) -> None:\\n    for name in (\\\"iPhone 13\\\", \\\"iPad (gen 7)\\\"):\\n        device = playwright.devices[name]\\n        context = browser.new_context(**device)\\n        page = context.new_page()\\n        try:\\n            page.goto(html.as_uri())\\n            page.wait_for_function(\\\"() => window.__engine && window.__engine.ready === true\\\", timeout=60000)\\n            text = page.locator(\\\"[data-ui=note]\\\").inner_text()\\n360→            if \\\"Controller or keyboard required\\\" not in text:\\n                fails.append(f\\\"{name} note {text}\\\")\\n            if page.locator(\\\".touch-stick\\\").count() != 0:\\n                fails.append(f\\\"{name} drew a touch stick\\\")\\n            box = page.locator(\\\"[data-ui=touch-settings]\\\").bounding_box()\\n            if not box:\\n                fails.append(f\\\"{name} has no Settings button\\\")\\n            else:\\n                page.touchscreen.tap(box[\\\"x\\\"] + box[\\\"width\\\"] / 2, box[\\\"y\\\"] + box[\\\"height\\\"] / 2)\\n                page.wait_for_function(\\\"() => window.__game && window.__game.screen === 'settings'\\\", timeout=15000)\\n370→            page.wait_for_timeout(11000)\\n            if page.evaluate(\\\"() => window.__game.attract\\\") is not True:\\n                fails.append(f\\\"{name} attract did not run\\\")\\n        except Exception as error:\\n            fails.append(f\\\"{name} {error}\\\")\\n        finally:\\n            context.close()\\n\\n\\ndef webkit(playwright, html: Path, fails: list[str]) -> None:\\n380→    try:\\n        browser = playwright.webkit.launch()\\n    except Exception as error:\\n        fails.append(f\\\"webkit did not launch {error}\\\")\\n        return\\n    page = browser.new_page()\\n    try:\\n        page.goto(html.as_uri())\\n        page.wait_for_timeout(1500)\\n        text = page.locator(\\\"#msg\\\").inner_text()\\n390→        if \\\"Chrome\\\" not in text or \\\"Edge\\\" not in text:\\n            fails.append(f\\\"webkit message {text}\\\")\\n    except Exception as error:\\n        fails.append(f\\\"webkit {error}\\\")\\n    finally:\\n        browser.close()\\n\\n\\ndef hub(browser, html: Path, out: Path, fails: list[str]) -> None:\\n    root = html.parent\\n400→    server = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), handler(root))\\n    port = server.server_address[1]\\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\\n    thread.start()\\n    (out / \\\"hub-port.txt\\\").write_text(str(port), encoding=\\\"utf-8\\\")\\n    game = \\\"/\\\" + quote(html.name)\\n    base = f\\\"http://127.0.0.1:{port}\\\"\\n    dev = next(path for path in root.iterdir() if path.is_dir() and (path / \\\"labs/game/hub/harness.html\\\").exists())\\n    client = (dev / \\\"labs/game/hub/session-client.txt\\\").read_bytes()\\n    digest = hashlib.sha256(client).hexdigest()\\n410→    (out / \\\"hub-client.sha\\\").write_text(digest + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n    if client not in html.read_bytes():\\n        fails.append(\\\"session client bytes are not in the html\\\")\\n    harness = f\\\"{base}/{quote(dev.name)}/labs/game/hub/harness.html\\\"\\n    lines: list[str] = []\\n    try:\\n        for query in (\\n            \\\"players=2&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=3&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=4&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\",\"content_concise\":\"300→            \\\"Four were critical\\\",\\n            \\\"most helpful\\\",\\n            \\\"least helpful\\\",\\n            \\\"Scene actions\\\",\\n            \\\"playClip\\\",\\n            \\\"balance step\\\",\\n            \\\"hardest part\\\",\\n            \\\"None. The engine files were not changed.\\\",\\n            \\\"I would let a page add a mesh\\\",\\n            \\\"acceptance numbers\\\",\\n310→            \\\"group score\\\",\\n            \\\"one HTML file\\\",\\n            \\\"session client hash\\\",\\n        ):\\n            if needle not in about:\\n                fails.append(f\\\"about missing {needle}\\\")\\n        rows = page.locator(\\\"[data-ui=item]\\\").count()\\n        if rows > 6:\\n            fails.append(f\\\"menu has {rows} rows\\\")\\n        small = page.evaluate(\\n320→            \\\"\\\"\\\"() => {\\n              const found = [];\\n              const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\\n              while (walker.nextNode()) {\\n                const text = walker.currentNode.textContent.trim();\\n                if (!text) continue;\\n                const el = walker.currentNode.parentElement;\\n                if (!el) continue;\\n                const style = getComputedStyle(el);\\n                if (style.display === 'none' || style.visibility === 'hidden') continue;\\n330→                const rect = el.getBoundingClientRect();\\n                if (rect.width < 1 || rect.height < 1) continue;\\n                const size = parseFloat(style.fontSize);\\n                if (size < 28) found.push(text.slice(0, 48) + ' ' + size);\\n              }\\n              return found.slice(0, 8);\\n            }\\\"\\\"\\\"\\n        )\\n        if small:\\n            fails.append(f\\\"text under 28px {small}\\\")\\n340→        trace.append(f\\\"menu rows {rows}\\\")\\n        trace.append(\\\"font ok\\\" if not small else f\\\"font {small}\\\")\\n        trace.append(\\\"about ok\\\" if not any(item.startswith(\\\"about missing\\\") for item in fails) else \\\"about incomplete\\\")\\n    except Exception as error:\\n        fails.append(f\\\"shell {error}\\\")\\n        trace.append(f\\\"shell {error}\\\")\\n    finally:\\n        (out / \\\"browser.log\\\").write_text(\\\"\\\\n\\\".join(trace) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n        page.close()\\n\\n350→\\ndef touch(browser, playwright, html: Path, fails: list[str]) -> None:\\n    for name in (\\\"iPhone 13\\\", \\\"iPad (gen 7)\\\"):\\n        device = playwright.devices[name]\\n        context = browser.new_context(**device)\\n        page = context.new_page()\\n        try:\\n            page.goto(html.as_uri())\\n            page.wait_for_function(\\\"() => window.__engine && window.__engine.ready === true\\\", timeout=60000)\\n            text = page.locator(\\\"[data-ui=note]\\\").inner_text()\\n360→            if \\\"Controller or keyboard required\\\" not in text:\\n                fails.append(f\\\"{name} note {text}\\\")\\n            if page.locator(\\\".touch-stick\\\").count() != 0:\\n                fails.append(f\\\"{name} drew a touch stick\\\")\\n            box = page.locator(\\\"[data-ui=touch-settings]\\\").bounding_box()\\n            if not box:\\n                fails.append(f\\\"{name} has no Settings button\\\")\\n            else:\\n                page.touchscreen.tap(box[\\\"x\\\"] + box[\\\"width\\\"] / 2, box[\\\"y\\\"] + box[\\\"height\\\"] / 2)\\n                page.wait_for_function(\\\"() => window.__game && window.__game.screen === 'settings'\\\", timeout=15000)\\n370→            page.wait_for_timeout(11000)\\n            if page.evaluate(\\\"() => window.__game.attract\\\") is not True:\\n                fails.append(f\\\"{name} attract did not run\\\")\\n        except Exception as error:\\n            fails.append(f\\\"{name} {error}\\\")\\n        finally:\\n            context.close()\\n\\n\\ndef webkit(playwright, html: Path, fails: list[str]) -> None:\\n380→    try:\\n        browser = playwright.webkit.launch()\\n    except Exception as error:\\n        fails.append(f\\\"webkit did not launch {error}\\\")\\n        return\\n    page = browser.new_page()\\n    try:\\n        page.goto(html.as_uri())\\n        page.wait_for_timeout(1500)\\n        text = page.locator(\\\"#msg\\\").inner_text()\\n390→        if \\\"Chrome\\\" not in text or \\\"Edge\\\" not in text:\\n            fails.append(f\\\"webkit message {text}\\\")\\n    except Exception as error:\\n        fails.append(f\\\"webkit {error}\\\")\\n    finally:\\n        browser.close()\\n\\n\\ndef hub(browser, html: Path, out: Path, fails: list[str]) -> None:\\n    root = html.parent\\n400→    server = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), handler(root))\\n    port = server.server_address[1]\\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\\n    thread.start()\\n    (out / \\\"hub-port.txt\\\").write_text(str(port), encoding=\\\"utf-8\\\")\\n    game = \\\"/\\\" + quote(html.name)\\n    base = f\\\"http://127.0.0.1:{port}\\\"\\n    dev = next(path for path in root.iterdir() if path.is_dir() and (path / \\\"labs/game/hub/harness.html\\\").exists())\\n    client = (dev / \\\"labs/game/hub/session-client.txt\\\").read_bytes()\\n    digest = hashlib.sha256(client).hexdigest()\\n410→    (out / \\\"hub-client.sha\\\").write_text(digest + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n    if client not in html.read_bytes():\\n        fails.append(\\\"session client bytes are not in the html\\\")\\n    harness = f\\\"{base}/{quote(dev.name)}/labs/game/hub/harness.html\\\"\\n    lines: list[str] = []\\n    try:\\n        for query in (\\n            \\\"players=2&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=3&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=4&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/browse.py\",\"offset\":300,\"limit\":120,\"raw_output\":\"            \\\"Four were critical\\\",\\n            \\\"most helpful\\\",\\n            \\\"least helpful\\\",\\n            \\\"Scene actions\\\",\\n            \\\"playClip\\\",\\n            \\\"balance step\\\",\\n            \\\"hardest part\\\",\\n            \\\"None. The engine files were not changed.\\\",\\n            \\\"I would let a page add a mesh\\\",\\n            \\\"acceptance numbers\\\",\\n            \\\"group score\\\",\\n            \\\"one HTML file\\\",\\n            \\\"session client hash\\\",\\n        ):\\n            if needle not in about:\\n                fails.append(f\\\"about missing {needle}\\\")\\n        rows = page.locator(\\\"[data-ui=item]\\\").count()\\n        if rows > 6:\\n            fails.append(f\\\"menu has {rows} rows\\\")\\n        small = page.evaluate(\\n            \\\"\\\"\\\"() => {\\n              const found = [];\\n              const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\\n              while (walker.nextNode()) {\\n                const text = walker.currentNode.textContent.trim();\\n                if (!text) continue;\\n                const el = walker.currentNode.parentElement;\\n                if (!el) continue;\\n                const style = getComputedStyle(el);\\n                if (style.display === 'none' || style.visibility === 'hidden') continue;\\n                const rect = el.getBoundingClientRect();\\n                if (rect.width < 1 || rect.height < 1) continue;\\n                const size = parseFloat(style.fontSize);\\n                if (size < 28) found.push(text.slice(0, 48) + ' ' + size);\\n              }\\n              return found.slice(0, 8);\\n            }\\\"\\\"\\\"\\n        )\\n        if small:\\n            fails.append(f\\\"text under 28px {small}\\\")\\n        trace.append(f\\\"menu rows {rows}\\\")\\n        trace.append(\\\"font ok\\\" if not small else f\\\"font {small}\\\")\\n        trace.append(\\\"about ok\\\" if not any(item.startswith(\\\"about missing\\\") for item in fails) else \\\"about incomplete\\\")\\n    except Exception as error:\\n        fails.append(f\\\"shell {error}\\\")\\n        trace.append(f\\\"shell {error}\\\")\\n    finally:\\n        (out / \\\"browser.log\\\").write_text(\\\"\\\\n\\\".join(trace) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n        page.close()\\n\\n\\ndef touch(browser, playwright, html: Path, fails: list[str]) -> None:\\n    for name in (\\\"iPhone 13\\\", \\\"iPad (gen 7)\\\"):\\n        device = playwright.devices[name]\\n        context = browser.new_context(**device)\\n        page = context.new_page()\\n        try:\\n            page.goto(html.as_uri())\\n            page.wait_for_function(\\\"() => window.__engine && window.__engine.ready === true\\\", timeout=60000)\\n            text = page.locator(\\\"[data-ui=note]\\\").inner_text()\\n            if \\\"Controller or keyboard required\\\" not in text:\\n                fails.append(f\\\"{name} note {text}\\\")\\n            if page.locator(\\\".touch-stick\\\").count() != 0:\\n                fails.append(f\\\"{name} drew a touch stick\\\")\\n            box = page.locator(\\\"[data-ui=touch-settings]\\\").bounding_box()\\n            if not box:\\n                fails.append(f\\\"{name} has no Settings button\\\")\\n            else:\\n                page.touchscreen.tap(box[\\\"x\\\"] + box[\\\"width\\\"] / 2, box[\\\"y\\\"] + box[\\\"height\\\"] / 2)\\n                page.wait_for_function(\\\"() => window.__game && window.__game.screen === 'settings'\\\", timeout=15000)\\n            page.wait_for_timeout(11000)\\n            if page.evaluate(\\\"() => window.__game.attract\\\") is not True:\\n                fails.append(f\\\"{name} attract did not run\\\")\\n        except Exception as error:\\n            fails.append(f\\\"{name} {error}\\\")\\n        finally:\\n            context.close()\\n\\n\\ndef webkit(playwright, html: Path, fails: list[str]) -> None:\\n    try:\\n        browser = playwright.webkit.launch()\\n    except Exception as error:\\n        fails.append(f\\\"webkit did not launch {error}\\\")\\n        return\\n    page = browser.new_page()\\n    try:\\n        page.goto(html.as_uri())\\n        page.wait_for_timeout(1500)\\n        text = page.locator(\\\"#msg\\\").inner_text()\\n        if \\\"Chrome\\\" not in text or \\\"Edge\\\" not in text:\\n            fails.append(f\\\"webkit message {text}\\\")\\n    except Exception as error:\\n        fails.append(f\\\"webkit {error}\\\")\\n    finally:\\n        browser.close()\\n\\n\\ndef hub(browser, html: Path, out: Path, fails: list[str]) -> None:\\n    root = html.parent\\n    server = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), handler(root))\\n    port = server.server_address[1]\\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\\n    thread.start()\\n    (out / \\\"hub-port.txt\\\").write_text(str(port), encoding=\\\"utf-8\\\")\\n    game = \\\"/\\\" + quote(html.name)\\n    base = f\\\"http://127.0.0.1:{port}\\\"\\n    dev = next(path for path in root.iterdir() if path.is_dir() and (path / \\\"labs/game/hub/harness.html\\\").exists())\\n    client = (dev / \\\"labs/game/hub/session-client.txt\\\").read_bytes()\\n    digest = hashlib.sha256(client).hexdigest()\\n    (out / \\\"hub-client.sha\\\").write_text(digest + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n    if client not in html.read_bytes():\\n        fails.append(\\\"session client bytes are not in the html\\\")\\n    harness = f\\\"{base}/{quote(dev.name)}/labs/game/hub/harness.html\\\"\\n    lines: list[str] = []\\n    try:\\n        for query in (\\n            \\\"players=2&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=3&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n            \\\"players=4&latency=150&jitter=50&loss=5&auto=1&play=8000\\\",\\n\",\"total_lines\":508}}","is_error":false},{"type":"tool_result","tool_use_id":"call-60e1b839-00a0-4c6b-9502-30b410a9ea37-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"150→  };\\n  const close = () => {\\n    menu?.remove();\\n    menu = null;\\n    menuCancel = undefined;\\n  };\\n  const open = (\\n    items: MenuItem[],\\n    title: string,\\n    id: string,\\n160→    onPick: (itemId: string) => void,\\n    onCancel?: () => void,\\n  ) => {\\n    const input = engine?.input;\\n    if (!input) return;\\n    close();\\n    menuCancel = onCancel;\\n    screen = id;\\n    menu = createMenu(root, items.slice(0, 6), {\\n      input,\\n170→      id,\\n      title,\\n      onCancel: () => onCancel?.(),\\n      onMove: (_index, item) => {\\n        focus = labelOf(item);\\n        publish();\\n      },\\n      onPick: (_index, item) => onPick(typeof item === 'string' ? item : (item.id ?? item.label)),\\n    });\\n    focus = labelOf(menu.selected);\\n180→    publish();\\n  };\\n  const resume = () => {\\n    if (!hub) inspector()?.resume();\\n    close();\\n    screen = hub && hubView && !hubView.playing ? 'card' : 'play';\\n    publish();\\n  };\\n  const described = (path: string, key: string): number => {\\n    const row = inspector()?.describe('setting', path) as { fields?: { key: string; value: unknown }[] } | undefined;\\n190→    const field = row?.fields?.find((item) => item.key === key);\\n    return typeof field?.value === 'number' ? field.value : 0;\\n  };\\n\\n  const host: Host = {\\n    hub,\\n    get attract() {\\n      return attract;\\n    },\\n    set attract(value) {\\n200→      attract = value;\\n    },\\n    get screen() {\\n      return screen;\\n    },\\n    set screen(value) {\\n      screen = value;\\n    },\\n    get icons() {\\n      return icons;\\n210→    },\\n    set icons(value) {\\n      icons = value;\\n    },\\n    get prefs() {\\n      return prefs;\\n    },\\n    set prefs(value) {\\n      prefs = value;\\n    },\\n220→    get save() {\\n      return save;\\n    },\\n    set save(value) {\\n      save = value;\\n    },\\n    live,\\n    note,\\n    about,\\n    sliders,\\n230→    store,\\n    devPage: 0,\\n    jumpPage: 0,\\n    bindPage: 0,\\n    pausePage: 0,\\n    aboutFrom: 'title',\\n    get lastDevice() {\\n      return lastDevice;\\n    },\\n    engine: () => engine,\\n240→    inspector,\\n    run,\\n    open,\\n    close,\\n    applyPrefs,\\n    persist,\\n    resume,\\n    publish,\\n    setting(path) {\\n      const value = shownFrame?.setting(path);\\n250→      return typeof value === 'number' && Number.isFinite(value) ? value : described(path, 'default');\\n    },\\n    settingDefault: (path) => described(path, 'default'),\\n  };\\n  const menus: Menus = createMenus(host);\\n  hubView =\\n    hub && client\\n      ? createHub(\\n          {\\n            audio,\\n260→            client,\\n            run,\\n            engine: () => engine,\\n            ended: () => ended,\\n            markEnded: () => {\\n              ended = true;\\n            },\\n          },\\n          root,\\n        )\\n270→      : null;\\n\\n  const noteDevice = (device: string) => {\\n    lastDevice = device;\\n    glyphSet = device === 'keyboard' ? 'keys' : device === 'mouse' ? 'mouse' : icons;\\n    lastInput = performance.now();\\n    if (screen !== 'touch') note.textContent = promptLine(glyphSet);\\n    publish();\\n  };\\n  const exitAttract = () => {\\n280→    if (!attract) return;\\n    exitPending = true;\\n    lastInput = performance.now();\\n  };\\n  /** Leaves the demo after this frame has decided not to store it. */\\n  const finishExit = () => {\\n    if (!exitPending) return;\\n    exitPending = false;\\n    attract = false;\\n    lastInput = performance.now();\\n290→    inspector()?.set('game.auto', 'off');\\n    const seed = inspector()?.seed() ?? 1;\\n    inspector()?.seed(seed);\\n    if (armed) menus.showTitle();\\n    else screen = 'touch';\\n  };\\n  const startAttract = () => {\\n    attract = true;\\n    inspector()?.set('game.auto', 'attract');\\n    const seed = inspector()?.seed() ?? 1;\\n300→    inspector()?.seed(seed);\\n    if (screen === 'title') close();\\n    if (screen === 'title') screen = 'attract';\\n    publish();\\n  };\\n\\n  touchBtn.addEventListener('click', () => {\\n    touchAt = performance.now();\\n    menus.showSettings(0);\\n  });\\n310→  window.addEventListener(\\n    'keydown',\\n    (event) => {\\n      if (event.metaKey || event.ctrlKey || event.altKey) return;\\n      armed = true;\\n      noteDevice('keyboard');\\n      if (attract) exitAttract();\\n      else if (screen === 'touch') menus.showTitle();\\n      if (hub && screen === 'card') {\\n        if (event.code === 'Enter' || event.code === 'NumpadEnter') client?.answer('ready');\\n320→        if (event.code === 'KeyT') client?.answer('more');\\n      }\\n    },\\n    true,\\n  );\\n  window.addEventListener(\\n    'pointerdown',\\n    (event) => {\\n      if (event.pointerType === 'touch') {\\n        touchAt = performance.now();\\n330→        return;\\n      }\\n      noteDevice('mouse');\\n      if (attract) exitAttract();\\n      else if (screen === 'touch') menus.showTitle();\\n      if ((screen === 'play' || screen === 'attract') && !menu) engine?.input?.mouse?.lock();\\n      if (hub && screen === 'card') client?.answer('ready');\\n    },\\n    true,\\n  );\\n340→  window.addEventListener(\\n    'pointermove',\\n    (event) => {\\n      if (event.pointerType === 'touch') return;\\n      if (Math.abs(event.movementX) + Math.abs(event.movementY) < 2) return;\\n      mouseDx += event.movementX;\\n      mouseDy += event.movementY;\\n      if (menu) return;\\n      if (performance.n