h\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/retreat.test.ts\",\"matches\":[{\"line_number\":38,\"content\":\"function open(seed: number, settings?: Record<string, unknown>) {\"},{\"line_number\":39,\"content\":\"  const run = createAppHost({ scene: bench, seed, settings });\"},{\"line_number\":44,\"content\":\"  const reseed = (next: number) => {\"},{\"line_number\":45,\"content\":\"    (run.inspector.seed as (n?: number) => number)(next);\"},{\"line_number\":47,\"content\":\"  return { run, w, menu, reseed };\"},{\"line_number\":66,\"content\":\"/** The world the run is on now. A reseed replaces it. */\"},{\"line_number\":94,\"content\":\"    for (let seed = 1; seed <= 10; seed++) {\"},{\"line_number\":95,\"content\":\"      const { w } = open(seed);\"},{\"line_number\":154,\"content\":\"      const { run, menu, reseed } = open(1);\"},{\"line_number\":156,\"content\":\"      for (let seed = 1; seed <= 10; seed++) {\"},{\"line_number\":159,\"content\":\"          reseed(seed);\"},{\"line_number\":162,\"content\":\"          if (!Number.isFinite(score)) failures.push(`${id} ${band} ${seed} did not finish`);\"},{\"line_number\":163,\"content\":\"          else if (score < 0 || score > 1000) failures.push(`${id} ${band} ${seed} ${score}`);\"},{\"line_number\":164,\"content\":\"          else if (band === 'perfect' && score < 750) failures.push(`${id} perfect ${seed} ${score.toFixed(1)}`);\"},{\"line_number\":165,\"content\":\"          else if (band === 'human' && score < 550) failures.push(`${id} human ${seed} ${score.toFixed(1)}`);\"},{\"line_number\":166,\"content\":\"          else if (band === 'sloppy' && score < 300) failures.push(`${id} sloppy ${seed} ${score.toFixed(1)}`);\"},{\"line_number\":167,\"content\":\"          else if (band === 'idle' && score > 500) failures.push(`${id} idle ${seed} ${score.toFixed(1)}`);\"},{\"line_number\":172,\"content\":\"          failures.push(`${id} idle ${idle.toFixed(1)} vs human ${human.toFixed(1)} seed ${seed}`);\"},{\"line_number\":230,\"content\":\"  it('walks three seeds to the credits', () => {\"},{\"line_number\":231,\"content\":\"    for (const seed of [1, 2, 3]) {\"},{\"line_number\":232,\"content\":\"      const { run, w } = open(seed, { 'game.auto': 'director' });\"},{\"line_number\":243,\"content\":\"      expect(flow.credits, `seed ${seed}`).toBe(1);\"},{\"line_number\":244,\"content\":\"      console.log(`seed ${seed} credits`);\"},{\"line_number\":246,\"content\":\"      for (const id of SEEN) expect(got, `seed ${seed} saw ${id}`).toContain(id);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/main.ts\",\"matches\":[{\"line_number\":38,\"content\":\"    search.set('seed', String(info.seed));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/looks/retreat.ts\",\"matches\":[{\"line_number\":22,\"content\":\"  map: { texture: 'texture:water', seed: 2, params: { base: '#6fd0e8' } },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/island.ts\",\"matches\":[{\"line_number\":29,\"content\":\"  seed: 4,\"},{\"line_number\":82,\"content\":\"/** A place a guest can walk up to and begin. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/about-data.ts\",\"matches\":[{\"line_number\":16,\"content\":\"  testing: 'Bot bands on ten seeds, a three-seed walk to the credits, and browser checks of the built file.',\"},{\"line_number\":27,\"content\":\"  'The most helpful test was the four bot bands on ten seeds for every shipped activity.',\"},{\"line_number\":44,\"content\":\"  'The group score is described as a sum to 3000 and also has to fit a rank from 0 to 1000. Several seed lines are longer than two sentences.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/hub.ts\",\"matches\":[{\"line_number\":20,\"content\":\"  seed: number;\"},{\"line_number\":35,\"content\":\"  seed: number;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"matches\":[{\"line_number\":75,\"content\":\"export function startEvent(w: World, id: string): void {\"},{\"line_number\":112,\"content\":\"    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\"},{\"line_number\":143,\"content\":\"  else startEvent(w, item.event);\"},{\"line_number\":182,\"content\":\"  else startEvent(w, next.event);\"},{\"line_number\":187,\"content\":\"  startEvent(w, 'tilt');\"},{\"line_number\":220,\"content\":\"function applySave(w: World, args: Record<string, unknown>): void {\"},{\"line_number\":261,\"content\":\"    startEvent(w, 'pose-a');\"},{\"line_number\":286,\"content\":\"  'game.begin': (w: World, args: unknown) => {\"},{\"line_number\":288,\"content\":\"    applySave(w, given);\"},{\"line_number\":303,\"content\":\"    else startEvent(w, event);\"},{\"line_number\":328,\"content\":\"      startEvent(w, event);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/menus.ts\",\"matches\":[{\"line_number\":77,\"content\":\"        { label: 'Begin', id: 'begin' },\"},{\"line_number\":91,\"content\":\"    if (id === 'begin') {\"},{\"line_number\":97,\"content\":\"      host.run('game.begin', {});\"},{\"line_number\":108,\"content\":\"      host.run('game.begin', { ...kept });\"},{\"line_number\":191,\"content\":\"          host.inspector()?.seed(1);\"},{\"line_number\":322,\"content\":\"      live?.seed(live.seed());\"},{\"line_number\":458,\"content\":\"        { label: 'New seed', id: 'seed' },\"},{\"line_number\":479,\"content\":\"        if (id === 'seed') live?.seed((live.seed() ?? 1) + 1);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/save.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The retreat save. The sim never reads the store. The page copies this in through game.begin.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/round.ts\",\"matches\":[{\"line_number\":69,\"content\":\"/** Starts the class. The page calls this when a hub round begins, and when a sofa picks Group Class. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/group.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * The deal is drawn so the seed matters. Empty seats can hold a CPU guest. Your score is your own.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts\",\"matches\":[{\"line_number\":287,\"content\":\"    const seed = inspector()?.seed() ?? 1;\"},{\"line_number\":288,\"content\":\"    inspector()?.seed(seed);\"},{\"line_number\":295,\"content\":\"    const seed = inspector()?.seed() ?? 1;\"},{\"line_number\":296,\"content\":\"    inspector()?.seed(seed);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/lines/book.ts\",\"matches\":[{\"line_number\":35,\"content\":\"  'plumb.both': 'We will both find out. Please begin.',\"},{\"line_number\":186,\"content\":\"  'seed.new': 'A new seed. The reaches and the gusts are strangers again.',\"},{\"line_number\":191,\"content\":\"  'begin.go': 'Begin the week. Morning is first, even if you are not.',\"},{\"line_number\":197,\"content\":\"  'near.go': 'You are near a start. Act, and it begins.',\"},{\"line_number\":198,\"content\":\"  'roam.help': 'Walk, and Act begins what you are standing on. The programme is the other way.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/island.test.ts\",\"matches\":[{\"line_number\":11,\"content\":\"    const run = createAppHost({ scene: island, seed: 1 });\"},{\"line_number\":21,\"content\":\"    const run = createAppHost({ scene: round, seed: 2 });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/replay.test.ts\",\"matches\":[{\"line_number\":13,\"content\":\"    const run = createAppHost({ scene: bench, seed: 1 });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/paddle.ts\",\"matches\":[{\"line_number\":12,\"content\":\"/** Where gate `i` sits. `jitter` is a few metres from the seed. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/tilt.ts\",\"matches\":[{\"line_number\":15,\"content\":\"/** Guests, the storm, and a still balance. Attract begins on the stone. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/data/lures.ts\",\"matches\":[{\"line_number\":12,\"content\":\"