,101,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":30,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/app/routes.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * what a page's query asks for. `parseRoutes(search, { scenes })` reads:\"},{\"line_number\":4,\"content\":\" * - `?scene=<name>`: one of the page's scenes (registered with engine/sim/scene.ts), by its id (`box:room`) or the\"},{\"line_number\":5,\"content\":\" *   name after its colon (`room`); the page's first scene when absent.\"},{\"line_number\":10,\"content\":\" *   `?scene`, the page starts the replay's own scene (engine/app/engine.ts).\"},{\"line_number\":15,\"content\":\" *   starts the gallery's scene (`dev:gallery`) on that entry on any page, whatever its scenes, a wrong name warning\"},{\"line_number\":24,\"content\":\" * import { defineScene } from '../sim/scene';\"},{\"line_number\":27,\"content\":\" * parseRoutes('?scene=room&seed=4&cam=topdown', { scenes: ['box:room'], registry }).scene; // 'box:room'\"},{\"line_number\":28,\"content\":\" * parseRoutes('?cam3=orbit', { scenes: ['box:room'], registry }).cam; // 'cam3=orbit'\"},{\"line_number\":29,\"content\":\" * routeQuery({ scene: 'room', settings: { 'time.scale': 0.5 } }); // '?scene=room&time.scale=0.5'\"},{\"line_number\":38,\"content\":\"import { getScene } from '../sim/scene';\"},{\"line_number\":49,\"content\":\"export const ROUTE_KEYS = ['scene', 'seed', 'cam', 'cam3', 'replay'] as const;\"},{\"line_number\":53,\"content\":\"  /** The scene id. */\"},{\"line_number\":54,\"content\":\"  scene: string;\"},{\"line_number\":66,\"content\":\"/** What the routes are checked against: the page's scenes and the registry that declares them and the settings. */\"},{\"line_number\":68,\"content\":\"  /** The page's scene ids; the first is the default. */\"},{\"line_number\":69,\"content\":\"  scenes: readonly string[];\"},{\"line_number\":71,\"content\":\"  /** The page's hash (`location.hash`): a gallery deep link opens the gallery's scene on its entry. */\"},{\"line_number\":82,\"content\":\"/** The scene `name` names among `scenes`: an id, or the name after its colon. */\"},{\"line_number\":83,\"content\":\"function sceneOf(name: string | null, scenes: readonly string[], registry: Registry): string {\"},{\"line_number\":84,\"content\":\"  if (!scenes.length)\"},{\"line_number\":85,\"content\":\"    bad('scene', name ?? '', 'has no scene to pick: the page offers none', 'pass createEngine its scenes');\"},{\"line_number\":86,\"content\":\"  if (name === null) return scenes[0];\"},{\"line_number\":87,\"content\":\"  const found = scenes.find((id) => id === name || id.slice(id.indexOf(':') + 1) === name);\"},{\"line_number\":89,\"content\":\"    const names = scenes.map((id) => id.slice(id.indexOf(':') + 1));\"},{\"line_number\":90,\"content\":\"    bad('scene', name, `names no scene of this page${didYouMean(name, names)}`, `use one of ${names.join(', ')}`);\"},{\"line_number\":92,\"content\":\"  getScene(found, registry); // CORE_NO_ENTRY when the page lists a scene it never registered\"},{\"line_number\":106,\"content\":\"  const scene = gallery ? GALLERY_SCENE : sceneOf(one('scene'), options.scenes, registry);\"},{\"line_number\":133,\"content\":\"  return { scene, seed, ...(code ? { cam: code } : {}), ...(replay ? { replay } : {}), settings, ...(gallery ? { gallery } : {}) }; // prettier-ignore\"},{\"line_number\":136,\"content\":\"/** A query for these routes: `?scene=room&cam=iso&time.scale=0.5` (keys in this order, settings last). */\"},{\"line_number\":139,\"content\":\"  if (routes.scene !== undefined) params.set('scene', routes.scene);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"bc1a60b7-5ca2-4a70-bb8e-56a7ce7d02a3"}
