ctors.player()!.id) as { motion?: { stance?: string } } | undefined)?.motion; // prettier-ignore\\n      const height = motion?.stance === 'crouch' ? CHEST.crouch : CHEST.stand; // where a level shot leaves\\n      return aimPoint(rule, { pose: { ...rig.aimPose(), ...lens }, aspect, feet, eye, height, ...devices, cast }); // the climb aside: the sim adds it\\n    },\\n    setCamera(code, setOptions = {}) {\\n      rig.set(code, { blend: setOptions.blend === true });\\n350→      drawn = pair.place(move(undefined, 0), aspect);\\n      drawCrowd();\\n      return info();\\n    },\\n    advance(frames) {\\n      for (let i = 0; i < frames; i++) drawn = pair.place(move(undefined, ADVANCE_FRAME), aspect);\\n      drawCrowd();\\n      return info();\\n    },\\n    carry() {\\n360→      drawn = pair.place(move(undefined, ADVANCE_FRAME), aspect);\\n      crowdStale = true; // posed by the next frame or dump, as after a step\\n    },\\n    dump: (dumpOptions) => {\\n      if (crowdStale) drawCrowd();\\n      return dumpScene(stage.scene, dumpOptions);\\n    },\\n    dispose: () => stage.dispose(),\\n  };\\n  view.restarted();\\n370→  view.frame({ alpha: 1, dt: 0, aspect });\\n  return view;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/app/view.ts\",\"offset\":280,\"limit\":100,\"raw_output\":\"    return pose;\\n  };\\n  const info = (): CameraInfo => ({\\n    code: rig.camera.code(),\\n    describe: rig.camera.describe(),\\n    type: rig.camera.type,\\n    yaw: rig.camera.yaw(),\\n    pose: rig.pose(),\\n    ...(rig.camera.type === 'first' ? { culled: [...parts.hidden], arms: [...parts.arms] } : {}),\\n  });\\n  const view: RunView = {\\n    stage,\\n    get camera() {\\n      return rig.camera;\\n    },\\n    cameras: [pair.perspective, pair.orthographic],\\n    get drawn() {\\n      return drawn;\\n    },\\n    stepped() {\\n      const run = options.r