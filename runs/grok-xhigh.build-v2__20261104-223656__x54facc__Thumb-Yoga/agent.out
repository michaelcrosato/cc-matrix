ber\":76,\"content\":\"  Date: CLOCK,\"},{\"line_number\":94,\"content\":\"  performance: CLOCK,\"},{\"line_number\":97,\"content\":\"/** Where code reaches a global by name: `globalThis.Date`, `self['Date']`, `const { Date } = globalThis`. */\"},{\"line_number\":110,\"content\":\"/** A `sim/no-restricted-imports` block: every Node built-in by its bare name, then `patterns`. */\"},{\"line_number\":120,\"content\":\"    rules: { 'sim/no-restricted-imports': ['error', { paths, patterns }] },\"},{\"line_number\":147,\"content\":\"        'sim/no-restricted-globals': [\"},{\"line_number\":151,\"content\":\"        'sim/no-restricted-properties': ['error', { object: 'Math', property: 'random', message: RANDOM }],\"},{\"line_number\":152,\"content\":\"        'sim/no-restricted-syntax': [\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"928e8c89-7353-4f1a-9025-6e1fa7cfab99"}
