"    for (const [bus, value] of Object.entries(volumes)) mixer.volume(bus as AudioBus | 'master', value);\"},{\"line_number\":163,\"content\":\"      sfx: (id, when, vol) => void play(id, { when, vol, bus: 'music' }),\"},{\"line_number\":165,\"content\":\"    if (pending) player.play(pending.id, { ...pending.options, at: 'now', intensity: level });\"},{\"line_number\":204,\"content\":\"  function play(id: string, opts: PlayOptions = {}): RuntimeSound | null {\"},{\"line_number\":247,\"content\":\"      return play(id, position ? { ...opts, position } : opts);\"},{\"line_number\":255,\"content\":\"      return play(sfx, { vol, variant, position } as PlayOptions);\"},{\"line_number\":264,\"content\":\"      if (player) player.play(id, opts);\"},{\"line_number\":287,\"content\":\"    volume(bus, value) {\"},{\"line_number\":288,\"content\":\"      if (value !== undefined) volumes[bus] = mixer ? mixer.volume(bus, value) : Math.min(1, Math.max(0, value));\"},{\"line_number\":317,\"content\":\"      player?.play(null, { at: 'now' });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"a0e66d93-086c-416c-9019-f0c9945b812f"}
