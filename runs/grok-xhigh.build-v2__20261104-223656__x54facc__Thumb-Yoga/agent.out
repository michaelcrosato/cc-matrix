mport { createMenus, type Host, type Live, type Menus } from './menus';\\nimport { freshPrefs, freshSave, readSave, writeSave, type Prefs } from './save';\\nimport { readSnap, runningScore, songFor, type Snap } from './snap';\\n\\n/** What tests read. The page fills it in the same frame as the input. */\\nexport interface GameHandle {\\n  title: 'Thumb Yoga';\\n  screen: string;\\n  attract: boolean;\\n  lastDevice: string;\\n30→  glyphSet: GlyphSet;\\n  volumes: { music: number; effects: number; voices: number };\\n  day: number;\\n  event: string;\\n  focus: string;\\n}\\n\\n/** How the page is built. */\\nexport interface PageOptions {\\n  audio: Audio;\\n40→  store: Store;\",\"content_concise\":\"1→/**\\n * @file The 10-foot shell. Attract, the touch gate, and the hub card sit over the sim.\\n * The sim stays in the scene. Menus and ghosts live in their own files.\\n */\\nimport {\\n  createMenu,\\n  type Audio,\\n  type Engine,\\n  type EngineFrame,\\n10→  type Inspector,\\n  type Menu,\\n  type MenuItem,\\n  type Store,\\n} from '../../../engine';\\nimport { say, speakerFor } from '../audio/voice';\\nimport { LURES } from '../scenes/data/lures';\\nimport { type GlyphSet, promptLine } from './glyphs';\\nimport { createHub, type HubClient, type HubView } from './hub';\\nimport { LINES } from './lines/book';\\n20→import { createMenus, type Host, type Live, type Menus } from './menus';\\nimport { freshPrefs, freshSave, readSave, writeSave, type Prefs } from './save';\\nimport { readSnap, runningScore, songFor, type Snap } from './snap';\\n\\n/** What tests read. The page fills it in the same frame as the input. */\\nexport interface GameHandle {\\n  title: 'Thumb Yoga';\\n  screen: string;\\n  attract: boolean;\\n  lastDevice: string;\\n30→  glyphSet: GlyphSet;\\n  volumes: { music: number; effects: number; voices: number };\\n  day: number;\\n  event: string;\\n  focus: string;\\n}\\n\\n/** How the page is built. */\\nexport interface PageOptions {\\n  audio: Aud