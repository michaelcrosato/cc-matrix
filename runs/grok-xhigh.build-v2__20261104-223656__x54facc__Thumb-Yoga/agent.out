: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\"},{\"line_number\":374,\"content\":\"for (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/hub/bridge.js\",\"matches\":[{\"line_number\":10,\"content\":\" * and anything from another round is dropped, so a slow packet can never land\"},{\"line_number\":31,\"content\":\"   * the later is dropped, and the next report, a second on, has the newest score.\"},{\"line_number\":92,\"content\":\"  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\"},{\"line_number\":153,\"content\":\"  function sendProgress(msg) {\"},{\"line_number\":159,\"content\":\"      stats.dropped++;\"},{\"line_number\":169,\"content\":\"  function sendGame(msg) {\"},{\"line_number\":179,\"content\":\"      stats.dropped++;\"},{\"line_number\":186,\"content\":\"      stats.dropped++;\"},{\"line_number\":225,\"content\":\"        stats.dropped++;\"},{\"line_number\":312,\"content\":\" * and loss for unreliable messages. Reliable messages stay in order per pair,\"},{\"line_number\":318,\"content\":\"  loss = 0,\"},{\"line_number\":325,\"content\":\"  const settings = { latency, jitter, loss };\"},{\"line_number\":349,\"content\":\"        if (!reliable && random() < settings.loss) return;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"7054544b-c051-4b65-9c28-36306f9c5885"}
