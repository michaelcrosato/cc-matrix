 0) + row.ghost.x;\"},{\"line_number\":63,\"content\":\"    const label = names[row.ghost.seat];\"},{\"line_number\":81,\"content\":\"    MATS.forEach((at, seat) => {\"},{\"line_number\":82,\"content\":\"      if (seat === 0) spawnProp(w, { prop: 'prop:round-mat', at: [at[0], 0, at[1]], yaw: 0 });\"},{\"line_number\":85,\"content\":\"          ghost: { on: 0, x: 0, y: 0, seat, pose: 0 },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/line.ts\",\"matches\":[{\"line_number\":36,\"content\":\"  const { body, seat } = apply(w, intents);\"},{\"line_number\":52,\"content\":\"  if (act.pose === 1 && act.px * seat.x < 0 && Math.abs(seat.x - act.px) > 0.75) {\"},{\"line_number\":56,\"content\":\"  act.px = seat.x;\"},{\"line_number\":63,\"content\":\"    const nowL = seat.fl > 0.5;\"},{\"line_number\":64,\"content\":\"    const nowR = seat.fr > 0.5;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/garden.ts\",\"matches\":[{\"line_number\":59,\"content\":\"  const { body, seat } = apply(w, intents, { noise: 0 });\"},{\"line_number\":67,\"content\":\"  const leanX = seat.pointer ? seat.px : body.x;\"},{\"line_number\":68,\"content\":\"  const leanY = seat.pointer ? seat.py : body.y;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/morning.ts\",\"matches\":[{\"line_number\":43,\"content\":\"  const { body, seat } = apply(w, intents, { inst });\"},{\"line_number\":86,\"content\":\"  const named = act.foot === 1 ? seat.fl > 0.5 : seat.fr > 0.5;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/pose.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file Pose Class. Enter along a guide, hold the seat, then rest. The enter does not score.\"},{\"line_number\":52,\"content\":\"function seatAt(pose: Pose, index: number): { x: number; y: number } {\"},{\"line_number\":53,\"content\":\"  return pose.seats[index] ?? pose.seats[0] ?? { x: 0, y: 0 };\"},{\"line_number\":76,\"content\":\"  const seatIndex = act.phase === 1 ? act.flags : 0;\"},{\"line_number\":77,\"content\":\"  const seat = seatAt(pose, seatIndex);\"},{\"line_number\":81,\"content\":\"  const { body, seat: input } = apply(w, intents, {\"},{\"line_number\":90,\"content\":\"    act.gx = seat.x * guideT;\"},{\"line_number\":91,\"content\":\"    act.gy = seat.y * guideT;\"},{\"line_number\":104,\"content\":\"    act.gx = seat.x;\"},{\"line_number\":105,\"content\":\"    act.gy = seat.y;\"},{\"line_number\":106,\"content\":\"    const inside = Math.hypot(body.x - seat.x, body.y - seat.y) <= ring && footDown(pose, input.fl, input.fr);\"},{\"line_number\":113,\"content\":\"      if (act.flags + 1 < pose.seats.length) {\"},{\"line_number\":144,\"content\":\"/** Follows the guide, then holds the seat, and breathes unless the chair forbids it. */\"},{\"line_number\":151,\"content\":\"  const seatIndex = act.phase === 1 ? act.flags : 0;\"},{\"line_number\":152,\"content\":\"  const seat = seatAt(pose, seatIndex);\"},{\"line_number\":154,\"content\":\"  const stick = seek(band, seat.x * guideT, seat.y * guideT, row.wobble, row.hist, cfg, w.tick, pose.instability);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/data/poses.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Changing a seat means editing a row, not the class.\"},{\"line_number\":10,\"content\":\"  /** One seat, or two for the comma. */\"},{\"line_number\":11,\"content\":\"  seats: readonly { x: number; y: number }[];\"},{\