label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\"},{\"line_number\":238,\"content\":\"      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\"},{\"line_number\":241,\"content\":\"        cell.progress.push({ at: performance.now(), ...report });\"},{\"line_number\":242,\"content\":\"        state.coordinator.progress(id, report.score);\"},{\"line_number\":254,\"content\":\"  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\"},{\"line_number\":272,\"content\":\"/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\"},{\"line_number\":278,\"content\":\"    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\"},{\"line_number\":279,\"content\":\"    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\"},{\"line_number\":280,\"content\":\"    if (cell.cardSent === id) continue;\"},{\"line_number\":281,\"content\":\"    cell.cardSent = id;\"},{\"line_number\":282,\"content\":\"    cell.bridge.card(card);\"},{\"line_number\":286,\"content\":\"/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\"},{\"line_number\":300,\"content\":\"  log(`${cell.key} answers ${what} on the game's card`);\"},{\"line_number\":343,\"content\":\"    const last = cell.progress.at(-1);\"},{\"line_number\":344,\"content\":\"    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\"},{\"line_number\":379,\"content\":\" * page's origin). Results land in window.__hubCheck, and body[data-complete]\"},{\"line_number\":412,\"content\":\"  window.__hubCheck = report;\"},{\"line_number\":440,\"content\":\"    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\"},{\"line_number\":442,\"content\":\"    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\"},{\"line_number\":443,\"content\":\"    // A game that shows its own card takes the players' answers on it: Enter is Ready.\"},{\"line_number\":444,\"content\":\"    if (caps.some((c) => c?.card)) {\"},{\"line_number\":446,\"content\":\"      const sent = await until(() => players.every((c) => c.cardSent), 2000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":453,\"content\":\"    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\"},{\"line_number\":468,\"content\":\"    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\"},{\"line_number\":469,\"content\":\"    // still tagged race was built to race's contract: no seeded start, and no progress asked.\"},{\"line_number\":486,\"content\":\"        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\"},{\"line_number\":489,\"content\":\"      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\"},{\"line_number\":490,\"content\":\"        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/hub/round.js\",\"matches\":[{\"line_number\":29,\"content\":\"export const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\"},{\"line_number\":32,\"content\":\"export const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\"},{\"line_number\":34,\"content\":\"/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\"},{\"line_number\":35,\"content\":\"const MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\"},{\"line_number\":44,\"content\":\"export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\"},{\"line_number\":49,\"content\":\" * parallel or ghost. A game still tagged race was built for an unseeded start\"},{\"line_number\":52,\"content\":\"export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\"},{\"line_number\":68,\"content\":\" * Parallel and ghost order: finishers by time, then the rest by score,\"},{\"line_number\":169,\"content\":\" * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\"},{\"line_number\":208,\"content\":\"      /** The last progress score the hub saw: the result of a player who never reports one. */\"},{\"line_number\":209,\"content\":\"      progress: null,\"},{\"line_number\":216,\"content\":\"    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\"},{\"line_number\":352,\"content\":\"    // A player still here who never reported is ranked by the last progress the hub saw from them.\"},{\"line_number\":354,\"content\":\"      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\"},{\"line_number\":401,\"content\":\"        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\"},{\"line_number\":416,\"content\":\"        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\"},{\"line_number\":510,\"content\":\"    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\"},{\"line_number\":511,\"content\":\"    progress(id, score) {\"},{\"line_number\":513,\"content\":\"      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/hub/bridge.js\",\"matches\":[{\"line_number\":8,\"content\":\" * game's answers on its own card to the page that holds it. What\"},{\"line_number\":19,\"content\":\" *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\"},{\"line_number\":29,\"content\":\"   * progress() reaches the hub about once a second. Two closer than this are a\"},{\"line_number\":33,\"content\":\"  progressMs: 250,\"},{\"line_number\":37,\"content\":\"const FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\"},{\"line_number\":39,\"content\":\"/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\"},{\"line_number\":58,\"content\":\" * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\"},{\"line_number\":59,\"content\":\" *        progress, this one's included, for the hub's scoreboard; it never reaches the games\"},{\"line_number\":61,\"content\":\" *        hub's page takes it, so the hub's own cards stay over the game\"},{\"line_number\":62,\"content\":\" * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\"},{\"line_number\":78,\"content\":\"  let progressAt = -Infinity;\"},{\"line_number\":99,\"content\":\"        ownsCard = msg.card === true;\"},{\"line_number\":100,\"content\":\"        return toHub({ type: 'hello', v: msg.v, client: String(msg.client || ''), mode: msg.mode ?? null, seats: msg.seats ?? null, card: ownsCard });\"},{\"line_number\":106,\"content\":\"        if (!ownsCard) return issue('answer without its own card: connect({ card: true })');\"},{\"line_number\":120,\"content\":\"      case 'progress':\"},{\"line_number\":127,\"content\":\"    if (!welcomed) return issue('progress before welcome');\"},{\"line_number\":129,\"content\":\"    if (!p) return issue('progress needs a finite score');\"},{\"line_number\":131,\"content\":\"    if (now - progressAt < LIMITS.progressMs) {\"},{\"line_number\":135,\"content\":\"    progressAt = now;\"},{\"line_number\":238,\"content\":\"    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \\\"The card\\\"). */\"},{\"line_number\":239,\"content\":\"    card(state) {\"},{\"line_number\":240,\"content\":\"      if (ownsCard && welcomed && !started && !ended) toGame({ type: 'card', ...state });\"},{\"line_number\":254,\"content\":\"    /** The game shows its own card, and has loaded: the hub's card steps aside for it. */\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"8e2072af-958e-4354-811c-d9599a80f8bd"}
