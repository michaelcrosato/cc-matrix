);\\n\",\"context_after\":\"  if (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\\n  const info = hubClient?.active ? await hubClient.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\\n  if (info) {\\n\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"dfee0ce8-8674-4170-b207-3b92712ea0bc"}
