{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-8ffa5631-cd8f-4354-ad32-e9ca67b07c6b-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\\n *\\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\\n10→ * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\\n * bot labs/game/bot.ts.\\n *\\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\\n * text for the view (labs/game/main.ts).\\n *\\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\\n *\\n * @example\\n20→ * // node x sim labs/game/scenes/play.ts --steps 600\\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\\n * @see labs/game/scenes/play.test.ts\\n */\\nimport {\\n  addLevelBodies,\\n  compileLevel,\\n  defineComponent,\\n  defineScene,\\n30→  defineSettings,\\n  physicsOf,\\n  type ActorComponent,\\n  type World,\\n} from '../../../engine/sim-api';\\nimport { spawnPlayer } from '../cast/player';\\n\\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\\nexport const ARENA_TEXT = `---\\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\\n40→---\\n##################\\n#................#\\n#..@.............#\\n#.......PP.......#\\n#.......PP.......#\\n#................#\\n#....w......w....#\\n#....w......w....#\\n#................#\\n50→#.......PP.......#\\n#.......PP.......#\\n#................#\\n#................#\\n##################\\n`;\\n\\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\\n\\n60→/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\\nexport const GAME_SETTINGS = defineSettings({\\n  'game.gems': {\\n    type: 'integer',\\n    default: 10,\\n    minimum: 1,\\n    maximum: 40,\\n    when: 'scene',\\n    description: 'How many gems the seed scatters.',\\n  },\\n70→  'game.seconds': {\\n    type: 'number',\\n    default: 30,\\n    minimum: 5,\\n    maximum: 600,\\n    unit: 's',\\n    when: 'scene',\\n    description: 'How long the player has to collect them all.',\\n  },\\n  'game.speed': {\\n80→    type: 'number',\\n    default: 6,\\n    minimum: 1,\\n    maximum: 20,\\n    unit: 'm/s',\\n    when: 'scene',\\n    description: 'How fast the player runs.',\\n  },\\n});\\n\\n90→/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\\nexport const GEM = defineComponent('gem', {\\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\\n  fields: {\\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\\n100→  },\\n});\\n\\n/** The round: the score, the clock and how it ended. One entity holds it. */\\nexport const ROUND = defineComponent('round', {\\n  description:\\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\\n  fields: {\\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\\n110→    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\\n    state: { type: 'string', default: 'playing', description: \\\"'playing', 'won' or 'lost'.\\\" },\\n  },\\n});\\n\\n/** The round, as the component holds it. */\\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\\n\\n/** The scene's components, typed. */\\nexport type GameComponents = {\\n120→  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\",\"content_concise\":\"1→/**\\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\\n *\\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\\n10→ * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\\n * bot labs/game/bot.ts.\\n *\\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\\n * text for the view (labs/game/main.ts).\\n *\\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\\n *\\n * @example\\n20→ * // node x sim labs/game/scenes/play.ts --steps 600\\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\\n * @see labs/game/scenes/play.test.ts\\n */\\nimport {\\n  addLevelBodies,\\n  compileLevel,\\n  defineComponent,\\n  defineScene,\\n30→  defineSettings,\\n  physicsOf,\\n  type ActorComponent,\\n  type World,\\n} from '../../../engine/sim-api';\\nimport { spawnPlayer } from '../cast/player';\\n\\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\\nexport const ARENA_TEXT = `---\\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\\n40→---\\n##################\\n#................#\\n#..@.............#\\n#.......PP.......#\\n#.......PP.......#\\n#................#\\n#....w......w....#\\n#....w......w....#\\n#................#\\n50→#.......PP.......#\\n#.......PP.......#\\n#................#\\n#................#\\n##################\\n`;\\n\\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\\n\\n60→/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\\nexport const GAME_SETTINGS = defineSettings({\\n  'game.gems': {\\n    type: 'integer',\\n    default: 10,\\n    minimum: 1,\\n    maximum: 40,\\n    when: 'scene',\\n    description: 'How many gems the seed scatters.',\\n  },\\n70→  'game.seconds': {\\n    type: 'number',\\n    default: 30,\\n    minimum: 5,\\n    maximum: 600,\\n    unit: 's',\\n    when: 'scene',\\n    description: 'How long the player has to collect them all.',\\n  },\\n  'game.speed': {\\n80→    type: 'number',\\n    default: 6,\\n    minimum: 1,\\n    maximum: 20,\\n    unit: 'm/s',\\n    when: 'scene',\\n    description: 'How fast the player runs.',\\n  },\\n});\\n\\n90→/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\\nexport const GEM = defineComponent('gem', {\\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\\n  fields: {\\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\\n100→  },\\n});\\n\\n/** The round: the score, the clock and how it ended. One entity holds it. */\\nexport const ROUND = defineComponent('round', {\\n  description:\\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\\n  fields: {\\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\\n110→    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\\n    state: { type: 'string', default: 'playing', description: \\\"'playing', 'won' or 'lost'.\\\" },\\n  },\\n});\\n\\n/** The round, as the component holds it. */\\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\\n\\n/** The scene's components, typed. */\\nexport type GameComponents = {\\n120→  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/play.ts\",\"offset\":null,\"limit\":120,\"raw_output\":\"/**\\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\\n *\\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\\n * bot labs/game/bot.ts.\\n *\\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\\n * text for the view (labs/game/main.ts).\\n *\\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\\n *\\n * @example\\n * // node x sim labs/game/scenes/play.ts --steps 600\\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\\n * @see labs/game/scenes/play.test.ts\\n */\\nimport {\\n  addLevelBodies,\\n  compileLevel,\\n  defineComponent,\\n  defineScene,\\n  defineSettings,\\n  physicsOf,\\n  type ActorComponent,\\n  type World,\\n} from '../../../engine/sim-api';\\nimport { spawnPlayer } from '../cast/player';\\n\\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\\nexport const ARENA_TEXT = `---\\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\\n---\\n##################\\n#................#\\n#..@.............#\\n#.......PP.......#\\n#.......PP.......#\\n#................#\\n#....w......w....#\\n#....w......w....#\\n#................#\\n#.......PP.......#\\n#.......PP.......#\\n#................#\\n#................#\\n##################\\n`;\\n\\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\\n\\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\\nexport const GAME_SETTINGS = defineSettings({\\n  'game.gems': {\\n    type: 'integer',\\n    default: 10,\\n    minimum: 1,\\n    maximum: 40,\\n    when: 'scene',\\n    description: 'How many gems the seed scatters.',\\n  },\\n  'game.seconds': {\\n    type: 'number',\\n    default: 30,\\n    minimum: 5,\\n    maximum: 600,\\n    unit: 's',\\n    when: 'scene',\\n    description: 'How long the player has to collect them all.',\\n  },\\n  'game.speed': {\\n    type: 'number',\\n    default: 6,\\n    minimum: 1,\\n    maximum: 20,\\n    unit: 'm/s',\\n    when: 'scene',\\n    description: 'How fast the player runs.',\\n  },\\n});\\n\\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\\nexport const GEM = defineComponent('gem', {\\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\\n  fields: {\\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\\n  },\\n});\\n\\n/** The round: the score, the clock and how it ended. One entity holds it. */\\nexport const ROUND = defineComponent('round', {\\n  description:\\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\\n  fields: {\\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\\n    state: { type: 'string', default: 'playing', description: \\\"'playing', 'won' or 'lost'.\\\" },\\n  },\\n});\\n\\n/** The round, as the component holds it. */\\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\\n\\n/** The scene's components, typed. */\\nexport type GameComponents = {\\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\\n\",\"total_lines\":212}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8ffa5631-cd8f-4354-ad32-e9ca67b07c6b-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The retreat's plain data: where the day is, what the activity is counting, and the island's tilt.\\n * Arrays are given fresh at spawn. Nothing here is remembered in a module variable.\\n */\\nimport { defineComponent, type World } from '../../../engine/sim-api';\\n\\n/** Where the guest is in the day. */\\nexport interface Flow {\\n  mode: string;\\n10→  event: string;\\n  day: number;\\n  cursor: number;\\n  seen: string;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n20→  prior: number;\\n}\\n\\n/** The activity blackboard. `goals` holds targets, lure times and marble holes. */\\nexport interface Act {\\n  phase: number;\\n  tick: number;\\n  left: number;\\n  done: number;\\n  a: number;\\n30→  b: number;\\n  c: number;\\n  n: number;\\n  m: number;\\n  hold: number;\\n  falls: number;\\n  dist: number;\\n  gx: number;\\n  gy: number;\\n  px: number;\\n40→  py: number;\\n  vx: number;\\n  vy: number;\\n  hx: number;\\n  hz: number;\\n  calm: number;\\n  wait: number;\\n  samples: number;\\n  acc: number;\\n  acc2: number;\\n50→  top0: number;\\n  pose: number;\\n  flags: number;\\n  foot: number;\\n  text: string;\\n  goals: number[];\\n}\\n\\n/** The island's lean, in degrees. The mesh never moves. The push does. */\\nexport interface Island {\\n60→  tiltX: number;\\n  tiltZ: number;\\n  base: number;\\n}\\n\\nconst num = (description: string) => ({ type: 'number' as const, default: 0, description });\\nconst str = (description: string) => ({ type: 'string' as const, default: '', description });\\n\\n/** The component `flow`. One entity holds the day. */\\nexport const FLOW = defineComponent('flow', {\\n70→  description: 'The day, the activity, the score on the table and whether the credits have rolled.',\\n  fields: {\\n    mode: str(\\\"title, roam, event, results, evening or credits.\\\"),\\n    event: str('The activity id while one is running.'),\\n    day: { type: 'integer', default: 1, description: 'The residency day, from 1.' },\\n    cursor: { type: 'integer', default: 0, description: 'The programme index.' },\\n    seen: str('Comma-separated ids already visited.'),\\n    credits: { type: 'integer', default: 0, description: '1 once the credits have started.' },\\n    line: str('The line id the page should say.'),\\n    result: num('The last score, 0 to 1000.'),\\n80→    age: num('The last Wobble Age.'),\\n    pebbles: num('Pebbles stacked so far. They are not spent.'),\\n    rank: str('The last rank word.'),\\n    prior: num(\\\"Yesterday's Wobble Age, or 0.\\\"),\\n  },\\n});\\n\\n/** The component `act`. One entity holds the activity. */\\nexport const ACT = defineComponent('act', {\\n  description: 'Counters for the activity that is running. Cleared when the next one starts.',\\n90→  fields: {\\n    phase: num('Which part of the activity is playing.'),\\n    tick: num('Steps since this activity started.'),\\n    left: num('Steps left in a box, or steps into the current part.'),\\n    done: num('1 when the activity has ended itself.'),\\n    a: num('Score part A, or a frozen class score.'),\\n    b: num('Score part B.'),\\n    c: num('Score part C.'),\\n    n: num('A count.'),\\n    m: num('Another count.'),\\n100→    hold: num('Steps the current target has been held.'),\\n    falls: num('Falls, topples or splashes the score counts.'),\\n    dist: num('Metres along a line, or a share.'),\\n    gx: num('Guide or goal, left to right.'),\\n    gy: num('Guide or goal, back to forward.'),\\n    px: num('A board, a marble or a guest, east.'),\\n    py: num('A board, a marble or a guest, south.'),\\n    vx: num('Speed east.'),\\n    vy: num('Speed south.'),\\n    hx: num('Lateral error, or a heading.'),\\n110→    hz: num('A second heading or a bias.'),\\n    calm: num('Composure, or a stored calm.'),\\n    wait: num('Steps until the next penalty or lure.'),\\n    samples: num('Steps counted toward a share.'),\\n    acc: num('Steps that counted, or a sum.'),\\n    acc2: num('A second sum, usually breath.'),\\n    top0: num('Topples at the start of a hold.'),\\n    pose: num('Which pose or tray is up.'),\\n    flags: num('Small bit flags for the activity.'),\\n    foot: num('The foot in use. 1 left, 2 right.'),\\n120→    text: str('A lure id, a pose id, or a short note.'),\\n    goals: { type: 'array', items: { type: 'number' }, default: [], description: 'Targets and schedules.' },\\n  },\\n});\\n\\n/** The component `island`. */\\nexport const ISLAND = defineComponent('island', {\\n  description: 'How far the island is leaning. Geometry stays. People and drinks do not.',\\n  fields: {\\n    tiltX: num('Lean toward the west, degrees.'),\\n130→    tiltZ: num('Lean toward the north, degrees.'),\\n    base: num('The story lean for this day, degrees.'),\\n  },\\n});\\n\\n/** Something an activity spawned and must remove. */\\nexport const MADE = defineComponent('made', {\\n  description: 'An entity an activity spawned. Teardown removes every one.',\\n  fields: { tag: str('What it was.') },\\n});\\n140→\\n/** A neighbour's lean, sent by the hub. It never moves the local guest. */\\nexport const GHOST = defineComponent('ghost', {\\n  description: 'Another player on the next mat. Drawn from hub messages. Local play ignores it.',\\n  fields: {\\n    on: num('1 while a message has arrived for this seat.'),\\n    x: num('Their centre, left to right.'),\\n    y: num('Their centre, back to forward.'),\\n    seat: { type: 'integer', default: 0, description: 'Their mat.' },\\n    pose: num('Which class they are in.'),\\n150→  },\\n});\\n\\n/** Who an actor is. The pilot reads it. */\\nexport const ROLE = defineComponent('role', {\\n  description: 'Which member of the retreat this actor is.',\\n  fields: { who: str('guest, plumb, tare, gerald, bex, nan, gull or frog.') },\\n});\\n\\n/** A guest drifting in the finale, or a plaque, drawn as a small box. */\\n160→export const MARK = defineComponent('mark', {\\n  description: 'A placed thing: a hidden pebble, a plaque, a drifting guest or a mat.',\\n  fields: {\\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\\n    y: { type: 'number', default: 0, unit: 'm', description: 'Up.' },\\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\\n    kind: str('pebble, plaque, guest, mat or cairn.'),\\n    text: str('A line id, when it has one.'),\\n    taken: num('1 once a pebble is picked up.'),\\n    follow: num('1 when a finale guest is walking with you.'),\\n170→  },\\n});\\n\\n/** A blank activity board with its own array. */\\nexport function emptyAct(): Act {\\n  return {\\n    phase: 0, tick: 0, left: 0, done: 0, a: 0, b: 0, c: 0, n: 0, m: 0, hold: 0, falls: 0,\\n    dist: 0, gx: 0, gy: 0, px: 0, py: 0, vx: 0, vy: 0, hx: 0, hz: 0, calm: 0, wait: 0,\\n    samples: 0, acc: 0, acc2: 0, top0: 0, pose: 0, flags: 0, foot: 0, text: '', goals: [],\\n  };\\n180→}\\n\\n/** The first entity's component, which boot always spawns. */\\nexport function part<T>(w: World, name: string): T {\\n  const rows = w.query(name as never) as unknown as Record<string, T>[];\\n  const row = rows[0];\\n  if (!row) throw new Error(`missing ${name}`);\\n  return row[name];\\n}\\n\\n190→/** Records `id` once on the comma list. */\\nexport function visit(flow: Flow, id: string): void {\\n  const parts = flow.seen ? flow.seen.split(',') : [];\\n  if (!parts.includes(id)) parts.push(id);\\n  flow.seen = parts.join(',');\\n}\\n\\n/** Clears the board and keeps the same array object only after replacing it. */\\nexport function resetAct(act: Act): void {\\n  const next = emptyAct();\\n200→  Object.assign(act, next);\",\"content_concise\":\"1→/**\\n * @file The retreat's plain data: where the day is, what the activity is counting, and the island's tilt.\\n * Arrays are given fresh at spawn. Nothing here is remembered in a module variable.\\n */\\nimport { defineComponent, type World } from '../../../engine/sim-api';\\n\\n/** Where the guest is in the day. */\\nexport interface Flow {\\n  mode: string;\\n10→  event: string;\\n  day: number;\\n  cursor: number;\\n  seen: string;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n20→  prior: number;\\n}\\n\\n/** The activity blackboard. `goals` holds targets, lure times and marble holes. */\\nexport interface Act {\\n  phase: number;\\n  tick: number;\\n  left: number;\\n  done: number;\\n  a: number;\\n30→  b: number;\\n  c: number;\\n  n: number;\\n  m: number;\\n  hold: number;\\n  falls: number;\\n  dist: number;\\n  gx: number;\\n  gy: number;\\n  px: number;\\n40→  py: number;\\n  vx: number;\\n  vy: number;\\n  hx: number;\\n  hz: number;\\n  calm: number;\\n  wait: number;\\n  samples: number;\\n  acc: number;\\n  acc2: number;\\n50→  top0: number;\\n  pose: number;\\n  flags: number;\\n  foot: number;\\n  text: string;\\n  goals: number[];\\n}\\n\\n/** The island's lean, in degrees. The mesh never moves. The push does. */\\nexport interface Island {\\n60→  tiltX: number;\\n  tiltZ: number;\\n  base: number;\\n}\\n\\nconst num = (description: string) => ({ type: 'number' as const, default: 0, description });\\nconst str = (description: string) => ({ type: 'string' as const, default: '', description });\\n\\n/** The component `flow`. One entity holds the day. */\\nexport const FLOW = defineComponent('flow', {\\n70→  description: 'The day, the activity, the score on the table and whether the credits have rolled.',\\n  fields: {\\n    mode: str(\\\"title, roam, event, results, evening or credits.\\\"),\\n    event: str('The activity id while one is running.'),\\n    day: { type: 'integer', default: 1, description: 'The residency day, from 1.' },\\n    cursor: { type: 'integer', default: 0, description: 'The programme index.' },\\n    seen: str('Comma-separated ids already visited.'),\\n    credits: { type: 'integer', default: 0, description: '1 once the credits have started.' },\\n    line: str('The line id the page should say.'),\\n    result: num('The last score, 0 to 1000.'),\\n80→    age: num('The last Wobble Age.'),\\n    pebbles: num('Pebbles stacked so far. They are not spent.'),\\n    rank: str('The last rank word.'),\\n    prior: num(\\\"Yesterday's Wobble Age, or 0.\\\"),\\n  },\\n});\\n\\n/** The component `act`. One entity holds the activity. */\\nexport const ACT = defineComponent('act', {\\n  description: 'Counters for the activity that is running. Cleared when the next one starts.',\\n90→  fields: {\\n    phase: num('Which part of the activity is playing.'),\\n    tick: num('Steps since this activity started.'),\\n    left: num('Steps left in a box, or steps into the current part.'),\\n    done: num('1 when the activity has ended itself.'),\\n    a: num('Score part A, or a frozen class score.'),\\n    b: num('Score part B.'),\\n    c: num('Score part C.'),\\n    n: num('A count.'),\\n    m: num('Another count.'),\\n100→    hold: num('Steps the current target has been held.'),\\n    falls: num('Falls, topples or splashes the score counts.'),\\n    dist: num('Metres along a line, or a share.'),\\n    gx: num('Guide or goal, left to right.'),\\n    gy: num('Guide or goal, back to forward.'),\\n    px: num('A bo