guest, mat or cairn.'),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/tilt.ts\",\"matches\":[{\"line_number\":59,\"content\":\"  for (const row of w.query('mark') as unknown as { mark: { kind: string; taken: number } }[]) {\"},{\"line_number\":100,\"content\":\"    for (const row of w.query('mark') as unknown as {\"},{\"line_number\":155,\"content\":\"  for (const row of w.query('mark') as unknown as { mark: { kind: string; x: number; z: number; follow: number } }[]) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/lines/book.ts\",\"matches\":[{\"line_number\":91,\"content\":\"  'plaque.want': 'Did you know. The average person leans two degrees toward the things they want.',\"},{\"line_number\":92,\"content\":\"  'plaque.moved': 'Did you know. This plaque was four centimetres to the left on Tuesday.',\"},{\"line_number\":93,\"content\":\"  'plaque.flamingo': 'Did you know. A flamingo stands on one leg because it has been told it is being watched.',\"},{\"line_number\":94,\"content\":\"  'plaque.gulls': 'Did you know that gulls have no Wobble Age. They have been asked.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/snap.ts\",\"matches\":[{\"line_number\":131,\"content\":\"  for (const row of frame.world.query('mark') as Record<string, unknown>[]) {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-e93d18de-467c-47fb-a2cb-32bf8a05c5bd-25","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"80→  /** The light spots of the last frame's props, in world space. */\\n  lights(): PropLight[];\\n  /** Registers the prop meshes with `warmup`, now or when they are made, and their presence in the shader key. */\\n  register(warmup: Pick<Warmup, 'register' | 'keyPart'>): { dispose(): void };\\n  /** Frees the prop meshes. */\\n  dispose(): void;\\n}\\n\\n/** The pose a `sceneProp` holds, or null for data that holds none. */\\nfunction poseOf(data: Record<string, unknown>): Pose | null {\\n90→  const { x, y, z, q } = data;\\n  if (typeof x !== 'number' || typeof y !== 'number' || typeof z !== 'number') return null;\\n  const turn = Array.isArray(q) && q.length === 4 && q.every(Number.isFinite) ? (q as Pose['q']) : [0, 0, 0, 1];\\n  return { p: [x, y, z], q: [turn[0], turn[1], turn[2], turn[3]] };\\n}\\n\\n/** Draws the scene's props (see the file comment). */\\nexport function createStageProps(options: StagePropsOptions): StageProps {\\n  const registry = options.registry ?? sharedRegistry;\\n  const held = new Map<number, Held>();\\n100→  const ids = new Map<number, string>();\\n  const warmups = new Set<Pick<Warmup, 'register' | 'keyPart'>>();\\n  const registrations = new Map<Pick<Warmup, 'register' | 'keyPart'>, { dispose(): void }>();\\n  const [a, b, at] = [new Quaternion(), new Quaternion(), new Vector3()];\\n  let meshes: PropMeshes | null = null;\\n  let [time, step] = [0, 1 / 60];\\n  let hidden: ((x: number, y: number, z: number) => boolean) | null = null;\\n  let guns: [number, HeldGun][] = [];\\n  /** What `hidden` hides, as its last `hide` named it. */\\n  let hiddenKey = '';\\n110→\\n  /** The prop meshes, made now if they are not yet, and registered with every warm-up so far. */\\n  function made(): PropMeshes {\\n    if (meshes) return meshes;\\n    meshes = createPropMeshes({ materials: options.materials, registry });\\n    options.scene.add(meshes.root);\\n    for (const warmup of warmups) registrations.set(warmup, meshes.register(warmup));\\n    return meshes;\\n  }\\n\\n120→  const props: StageProps = {\\n    get meshes() {\\n      return meshes;\\n    },\\n    props: ids,\\n    capture(entities, dt) {\\n      if (dt !== undefined && dt > 0) [time, step] = [time + dt, dt];\\n      const seen = new Set<number>();\\n      for (const entity of entities) {\\n        const data = entity.sceneProp as Record<string, unknown> | undefined;\\n130→        const pose = data && typeof data.prop === 'string' ? poseOf(data) : null;\\n        if (!data || !pose || seen.has(entity.id)) continue;\\n        seen.add(entity.id);\\n        const last = held.get(entity.id);\\n        const prop = data.prop as string;\\n        const on = (entity.propLight as { on?: unknown } | undefined)?.on !== false;\\n        held.set(entity.id, { prop, before: last && last.prop === prop ? last.after : pose, after: pose, on });\\n        ids.set(entity.id, prop);\\n      }\\n      for (const id of [...held.keys()]) {\\n140→        if (seen.has(id)) continue;\\n        held.delete(id);\\n        ids.delete(id);\\n      }\\n      if (held.size > 0) made();\\n      return seen;\\n    },\\n    draw(alpha) {\\n      if (!meshes) return;\\n      const k = Math.min(1, Math.max(0, alpha));\\n150→      meshes.begin(time - step + k * step);\\n      for (const [id, { prop, before, after, on }] of held) {\\n        const [p0, p1] = [before.p, after.p];\\n        at.set(p0[0] + (p1[0] - p0[0]) * k, p0[1] + (p1[1] - p0[1]) * k, p0[2] + (p1[2] - p0[2]) * k);\\n        if (hidden?.(at.x, at.y, at.z)) continue;\\n        a.fromArray(before.q).slerp(b.fromArray(after.q), k);\\n        meshes.add(prop, { position: at, rotation: a, on }, id);\\n      }\\n      for (const [id, gun] of guns) meshes.add(gun.kind.prop, { position: gun.position, rotation: gun.rotation }, id);\\n      meshes.end();\",\"content_concise\":\"80→  /** The light spots of the last frame's props, in world space. */\\n  lights(): PropLight[];\\n  /** Registers the prop meshes with `warmup`, now or when they are made, and their presence in the shader key. */\\n  register(warmup: Pick<Warmup, 'register' | 'keyPart'>): { dispose(): void };\\n  /** Frees the prop meshes. */\\n  dispose(): void;\\n}\\n\\n/** The pose a `sceneProp` holds, or null for data that holds none. */\\nfunction poseOf(data: Record<string, unknown>): Pose | null {\\n90→  const { x, y, z, q } = data;\\n  if (typeof x !== 'number' || typeof y !== 'number' || typeof z !== 'number') return null;\\n  const turn = Array.isArray(q) && q.length === 4 && q.every(Number.isFinite) ? (q as Pose['q']) : [0, 0, 0, 1];\\n  return { p: [x, y, z], q: [turn[0], turn[1], turn[2], turn[3]] };\\n}\\n\\n/** Draws the scene's props (see the file comment). */\\nexport function createStageProps(options: StagePropsOptions): StageProps {\\n  const registry = options.registry ?? sharedRegistry;\\n  const held = new Map<number, Held>();\\n100→  const ids = new Map<number, string>();\\n  const warmups = new Set<Pick<Warmup, 'register' | 'keyPart'>>();\\n  const registrations = new Map<Pick<Warmup, 'register' | 'keyPart'>, { dispose(): void }>();\\n  const [a, b, at] = [new Quaternion(), new Quaternion(), new Vector3()];\\n  let meshes: PropMeshes | null = null;\\n  let [time, step] = [0, 1 / 60];\\n  let hidden: ((x: number, y: number, z: number) => boolean) | null = null;\\n  let guns: [number, HeldGun][] = [];\\n  /** What `hidden` hides, as its last `hide` named it. */\\n  let hiddenKey = '';\\n110→\\n  /** The prop meshes, made now if they are not yet, and registered with every warm-up so far. */\\n  function made(): PropMeshes {\\n    if (meshes) return meshes;\\n    meshes = createPropMeshes({ materials: options.materials, registry });\\n    options.scene.add(meshes.root);\\n    for (const warmup of warmups) registrations.set(warmup, meshes.register(warmup));\\n    return meshes;\\n  }\\n\\n120→  const props: StageProps = {\\n    get meshes() {\\n      return meshes;\\n    },\\n    props: ids,\\n    capture(entities, dt) {\\n      if (dt !== undefined && dt > 0) [time, step] = [time + dt, dt];\\n      const seen = new Set<number>();\\n      for (const entity of entities) {\\n        const data = entity.sceneProp as Record<string, unknown> | undefined;\\n130→        const pose = data && typeof data.prop === 'string' ? poseOf(data) : null;\\n        if (!data || !pose || seen.has(entity.id)) continue;\\n        seen.add(entity.id);\\n        const last = held.get(entity.id);\\n        const prop = data.prop as string;\\n        const on = (entity.propLight as { on?: unknown } | undefined)?.on !== false;\\n        held.set(entity.id, { prop, before: last && last.prop === prop ? last.after : pose, after: pose, on });\\n        ids.set(entity.id, prop);\\n      }\\n      for (const id of [...held.keys()]) {\\n140→        if (seen.has(id)) continue;\\n        held.delete(id);\\n        ids.delete(id);\\n      }\\n      if (held.size > 0) made();\\n      return seen;\\n    },\\n    draw(alpha) {\\n      if (!meshes) return;\\n      const k = Math.min(1, Math.max(0, alpha));\\n150→      meshes.begin(time - step + k * step);\\n      for (const [id, { prop, before, after, on }] of held) {\\n        const [p0, p1] = [before.p, after.p];\\n        at.set(p0[0] + (p1[0] - p0[0]) * k, p0[1] + (p1[1] - p0[1]) * k, p0[2] + (p1[2] - p0[2]) * k);\\n        if (hidden?.(at.x, at.y, at.z)) continue;\\n        a.fromArray(before.q).slerp(b.fromArray(after.q), k);\\n        meshes.add(prop, { position: at, rotation: a, on }, id);\\n      }\\n      for (const [id, gun] of guns) meshes.add(gun.kind.prop, { position: gun.position, rotation: gun.rotation }, id);\\n      meshes.end();\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/gfx/stageProps.ts\",\"offset\":80,\"limit\":80,\"raw_output\":\"  /** The light spots of the last frame's props, in world space. */\\n  lights(): PropLight[];\\n  /** Registers the prop meshes with `warmup`, now or when they are made, and their presence in the shader key. */\\n  register(warmup: Pick<Warmup, 'register' | 'keyPart'>): { dispose(): void };\\n  /** Frees the prop meshes. */\\n  dispose(): void;\\n}\\n\\n/** The pose a `sceneProp` holds, or null for data that holds none. */\\nfunction poseOf(data: Record<string, unknown>): Pose | null {\\n  const { x, y, z, q } = data;\\n  if (typeof x !== 'number' || typeof y !== 'number' || typeof z !== 'number') return null;\\n  const turn = Array.isArray(q) && q.length === 4 && q.every(Number.isFinite) ? (q as Pose['q']) : [0, 0, 0, 1];\\n  return { p: [x, y, z], q: [turn[0], turn[1], turn[2], turn[3]] };\\n}\\n\\n/** Draws the scene's props (see the file comment). */\\nexport function createStageProps(options: StagePropsOptions): StageProps {\\n  const registry = options.registry ?? sharedRegistry;\\n  const held = new Map<number, Held>();\\n  const ids = new Map<number, string>();\\n  const warmups = new Set<Pick<Warmup, 'register' | 'keyPart'>>();\\n  const registrations = new Map<Pick<Warmup, 'register' | 'keyPart'>, { dispose(): void }>();\\n  const [a, b, at] = [new Quaternion(), new Quaternion(), new Vector3()];\\n  let meshes: PropMeshes | null = null;\\n  let [time, step] = [0, 1 / 60];\\n  let hidden: ((x: number, y: number, z: number) => boolean) | null = null;\\n  let guns: [number, HeldGun][] = [];\\n  /** What `hidden` hides, as its last `hide` named it. */\\n  let hiddenKey = '';\\n\\n  /** The prop meshes, made now if they are not yet, and registered with every warm-up so far. */\\n  function made(): PropMeshes {\\n    if (meshes) return meshes;\\n    meshes = createPropMeshes({ materials: options.materials, registry });\\n    options.scene.add(meshes.root);\\n    for (const warmup of warmups) registrations.set(warmup, meshes.register(warmup));\\n    return meshes;\\n  }\\n\\n  const props: StageProps = {\\n    get meshes() {\\n      return meshes;\\n    },\\n    props: ids,\\n    capture(entities, dt) {\\n      if (dt !== undefined && dt > 0) [time, step] = [time + dt, dt];\\n      const seen = new Set<number>();\\n      for (const entity of entities) {\\n        const data = entity.sceneProp as Record<string, unknown> | undefined;\\n        const pose = data && typeof data.prop === 'string' ? poseOf(data) : null;\\n        if (!data || !pose || seen.has(entity.id)) continue;\\n        seen.add(entity.id);\\n        const last = held.get(entity.id);\\n        const prop = data.prop as string;\\n        const on = (entity.propLight as { on?: unknown } | undefined)?.on !== false;\\n        held.set(entity.id, { prop, before: last && last.prop === prop ? last.after : pose, after: pose, on });\\n        ids.set(entity.id, prop);\\n      }\\n      for (const id of [...held.keys()]) {\\n        if (seen.has(id)) continue;\\n        held.delete(id);\\n        ids.delete(id);\\n      }\\n      if (held.size > 0) made();\\n      return seen;\\n    },\\n    draw(alpha) {\\n      if (!meshes) return;\\n      const k = Math.min(1, Math.max(0, alpha));\\n      meshes.begin(time - step + k * step);\\n      for (const [id, { prop, before, after, on }] of held) {\\n        const [p0, p1] = [before.p, after.p];\\n        at.set(p0[0] + (p1[0] - p0[0]) * k, p0[1] + (p1[1] - p0[1]) * k, p0[2] + (p1[2] - p0[2]) * k);\\n        if (hidden?.(at.x, at.y, at.z)) continue;\\n        a.fromArray(before.q).slerp(b.fromArray(after.q), k);\\n        meshes.add(prop, { position: at, rotation: a, on }, id);\\n      }\\n      for (const [id, gun] of guns) meshes.add(gun.kind.prop, { position: gun.position, rotation: gun.rotation }, id);\\n      meshes.end();\\n\",\"total_lines\":199}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e93d18de-467c-47fb-a2cb-32bf8a05c5bd-26","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"45→import { physicsOf } from '../physics/binding';\\nimport { propBody, propPose, type PropPlacement } from '../world/props/place';\\nimport { getProp, type PropKnock } from '../world/props/prop';\\nimport { defineComponent } from './state';\\nimport type { World } from './world';\\n50→\\n/** The component `sceneProp`'s fields. */\\nexport const SCENE_PROP_FIELDS = {\\n  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\\n  q: {\\n    type: 'array',\\n60→    items: { type: 'number' },\\n    default: [0, 0, 0, 1],\\n    description: 'Its turn, a unit quaternion [x, y, z, w].',\\n  },\\n} as const;\\n\\n/** The component `sceneProp`: a prop standing in a scene. */\\nexport interface ScenePropComponent {\\n  prop: string;\\n  body: number;\\n70→  x: number;\\n  y: number;\\n  z: number;\\n  q: [number, number, number, number];\\n}\\n\\n/** The component `propHealth` (WP 13.16): the hit points a breakable prop has left, spawned only on one with health. */\\nexport interface PropHealthComponent {\\n  hp: number;\\n}\\n80→\\n/** The component `propLight` (WP 13.16): a switchable prop's state, spawned only on one given a group or off. */\\nexport interface PropLightComponent {\\n  /** Whether it is on: its `lit` parts drawn and its light shining. */\\n  on: boolean;\\n  /** The light group a switch turns it on and off by (`'room:kitchen'`). */\\n  group: string;\\n}\\n\\n/** The components this module reads. */\\n90→export type ScenePropComponents = {\\n  sceneProp: ScenePropComponent;\\n  propHealth?: PropHealthComponent;\\n  propLight?: PropLightComponent;\\n};\\n\\n/** How `spawnProp` stands a prop beyond its placement (WP 13.16): a spawn inside a step or a setup joins the world at its end, so a door's or a switch's own component comes with it here. */ // prettier-ignore\\nexport interface SpawnPropOptions {\\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\\n  as?: 'dynamic' | 'fixed' | 'kinematic';\\n100→  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\\n  on?: boolean;\\n  group?: string;\\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\\n  components?: Readonly<Record<string, object>>;\\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\\n  knock?: PropKnock & { from: readonly [number, number, number] };\\n}\\n\\n/** Declares the component `sceneProp` on `registry` (once). */\\n110→export function definePropKinds(registry: Registry = sharedRegistry): void {\\n  if (registry.kinds().includes('component') && registry.has('component', 'sceneProp')) return;\\n  const description = 'A prop standing in a scene (spawnProp): its id, its body and its pose, its centre and turn.';\\n  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\\n  const hp = { type: 'number', default: 0, minimum: 0, description: 'Hit points left; at 0 it breaks.' } as const;\",\"content_concise\":\"45→import { physicsOf } from '../physics/binding';\\nimport { propBody, propPose, type PropPlacement } from '../world/props/place';\\nimport { getProp, type PropKnock } from '../world/props/prop';\\nimport { defineComponent } from './state';\\nimport type { World } from './world';\\n50→\\n/** The component `sceneProp`'s fields. */\\nexport const SCENE_PROP_FIELDS = {\\n  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\\n  q: {\\n    type: 'array',\\n60→    items: { type: 'number' },\\n    default: [0, 0, 0, 1],\\n    description: 'Its turn, a unit quaternion [x, y, z, w].',\\n  },\\n} as const;\\n\\n/** The component `sceneProp`: a prop standing in a scene. */\\nexport interface ScenePropComponent {\\n  prop: string;\\n  body: number;\\n70→  x: number;\\n  y: number;\\n  z: number;\\n  q: [number, number, number, number];\\n}\\n\\n/** The component `propHealth` (WP 13.16): the hit points a breakable prop has left, spawned only on one with health. */\\nexport interface PropHealthComponent {\\n  hp: number;\\n}\\n80→\\n/** The component `propLight` (WP 13.16): a switchable prop's state, spawned only on one given a group or off. */\\nexport interface PropLightComponent {\\n  /** Whether it is on: its `lit` parts drawn and its light shining. */\\n  on: boolean;\\n  /** The light group a switch turns it on and off by (`'room:kitchen'`). */\\n  group: string;\\n}\\n\\n/** The components this module reads. */\\n90→export type ScenePropComponents = {\\n  sceneProp: ScenePropComponent;\\n  propHealth?: PropHealthComponent;\\n  propLight?: PropLightComponent;\\n};\\n\\n/** How `spawnProp` stands a prop beyond its placement (WP 13.16): a spawn inside a step or a setup joins the world at its end, so a door's or a switch's own component comes with it here. */ // prettier-ignore\\nexport interface SpawnPropOptions {\\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\\n  as?: 'dynamic' | 'fixed' | 'kinematic';\\n100→  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\\n  on?: boolean;\\n  group?: string;\\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\\n  components?: Readonly<Record<string, object>>;\\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\\n  knock?: PropKnock & { from: readonly [number, number, number] };\\n}\\n\\n/** Declares the component `sceneProp` on `registry` (once). */\\n110→export function definePropKinds(registry: Registry = sharedRegistry): void {\\n  if (registry.kinds().includes('component') && registry.has('component', 'sceneProp')) return;\\n  const description = 'A prop standing in a scene (spawnProp): its id, its body and its pose, its centre and turn.';\\n  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\\n  const hp = { type: 'number', default: 0, minimum: 0, description: 'Hit points left; at 0 it breaks.' } as const;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/sim/props.ts\",\"offset\":45,\"limit\":70,\"raw_output\":\"import { physicsOf } from '../physics/binding';\\nimport { propBody, propPose, type PropPlacement } from '../world/props/place';\\nimport { getProp, type PropKnock } from '../world/props/prop';\\nimport { defineComponent } from './state';\\nimport type { World } from './world';\\n\\n/** The component `sceneProp`'s fields. */\\nexport const SCENE_PROP_FIELDS = {\\n  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\\n  q: {\\n    type: 'array',\\n    items: { type: 'number' },\\n    default: [0, 0, 0, 1],\\n    description: 'Its turn, a unit quaternion [x, y, z, w].',\\n  },\\n} as const;\\n\\n/** The component `sceneProp`: a prop standing in a scene. */\\nexport interface ScenePropComponent {\\n  prop: string;\\n  body: number;\\n  x: number;\\n  y: number;\\n  z: number;\\n  q: [number, number, number, number];\\n}\\n\\n/** The component `propHealth` (WP 13.16): the hit points a breakable prop has left, spawned only on one with health. */\\nexport interface PropHealthComponent {\\n  hp: number;\\n}\\n\\n/** The component `propLight` (WP 13.16): a switchable prop's state, spawned only on one given a group or off. */\\nexport interface PropLightComponent {\\n  /** Whether it is on: its `lit` parts drawn and its light shining. */\\n  on: boolean;\\n  /** The light group a switch turns it on and off by (`'room:kitchen'`). */\\n  group: string;\\n}\\n\\n/** The components this module reads. */\\nexport type ScenePropComponents = {\\n  sceneProp: ScenePropComponent;\\n  propHealth?: PropHealthComponent;\\n  propLight?: PropLightComponent;\\n};\\n\\n/** How `spawnProp` stands a prop beyond its placement (WP 13.16): a spawn inside a step or a setup joins the world at its end, so a door's or a switch's own component comes with it here. */ // prettier-ignore\\nexport interface SpawnPropOptions {\\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\\n  as?: 'dynamic' | 'fixed' | 'kinematic';\\n  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\\n  on?: boolean;\\n  group?: string;\\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\\n  components?: Readonly<Record<string, object>>;\\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\\n  knock?: PropKnock & { from: readonly [number, number, number] };\\n}\\n\\n/** Declares the component `sceneProp` on `registry` (once). */\\nexport function definePropKinds(registry: Registry = sharedRegistry): void {\\n  if (registry.kinds().includes('component') && registry.has('component', 'sceneProp')) return;\\n  const description = 'A prop standing in a scene (spawnProp): its id, its body and its pose, its centre and turn.';\\n  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\\n  const hp = { type: 'number', default: 0, minimum: 0, description: 'Hit points left; at 0 it breaks.' } as const;\\n\",\"total_lines\":222}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e93d18de-467c-47fb-a2cb-32bf8a05c5bd-27","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,95,95,120,53,52,102,97,99,99,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,56,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,95,95,120,53,52,102,97,99,99,47,119,111,114,107,47,84,104,117,109,98,32,89,111,103,97,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,47,108,97,98,115,47,103,97,109,101,47,117,105,47,109,101,110,117,115,46,116,115,10,57,55,58,32,32,32,32,32,32,104,111,115,116,46,114,117,110,40,39,103,97,109,101,46,98,101,103,105,110,39,44,32,123,125,41,59,10,49,48,56,58,32,32,32,32,32,32,104,111,115,116,46,114,117,110,40,39,103,97,109,101,46,98,101,103,105,110,39,44,32,123,32,46,46,46,107,101,112,116,32,125,41,59,10,53,50,54,58,32,32,32,32,32,32,32,32,125,32,101,108,115,101,32,105