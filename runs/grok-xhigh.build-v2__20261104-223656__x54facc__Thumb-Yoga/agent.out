.7-xhigh-20261104-223656/engine/input/intents.ts\",\"matches\":[{\"line_number\":30,\"content\":\" * pressed(step1, 'jump'); // true: an edge of b\"},{\"line_number\":32,\"content\":\" * [held(step2, 'jump'), pressed(step2, 'jump')]; // [true, false]\"},{\"line_number\":200,\"content\":\"export function pressed(intents: Intents, button: string): boolean {\"},{\"line_number\":264,\"content\":\"/** Steps between repeats after the first: 5, the prototype's 0.08 s at 60 Hz, rounded. */\"},{\"line_number\":327,\"content\":\"/** Uses up every pending press, so closing a menu does not also attack with the press that closed it. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/input/input.ts\",\"matches\":[{\"line_number\":22,\"content\":\" * Clearing: a page blur, the page going hidden and `clear()` let go of every held code and drop pending presses, so\"},{\"line_number\":25,\"content\":\" * Invariants: nothing here reads a clock; edges are counted per sample; a code is held only between its press and\"},{\"line_number\":35,\"content\":\" * ['KeyW', 'Space'].forEach((code) => key('keydown', code)), key('keyup', 'Space'); // a tap between two frames\"},{\"line_number\":130,\"content\":\"  pressed(action: string): boolean;\"},{\"line_number\":139,\"content\":\"  /** Lets go of everything held and drops pending presses. */\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"5f4948d3-9f24-4219-baf2-2b2f18be1eeb"}
