el)),\\n    });\\n    focus = labelOf(menu.selected);\\n    publish();\\n  };\\n  const resume = () => {\\n    if (!hub) inspector()?.resume();\\n180→    close();\\n    screen = hub && hubView && !hubView.playing ? 'card' : 'play';\\n    publish();\\n  };\\n  const described = (path: string, key: string): number => {\\n    const row = inspector()?.describe('setting', path) as { fields?: { key: string; value: unknown }[] } | undefined;\\n    const field = row?.fields?.find((item) => item.key === key);\\n    return typeof field?.value === 'number' ? field.value : 0;\\n  };\\n\\n190→  const host: Host = {\\n    hub,\\n    get attract() {\\n      return attract;\\n    },\\n    set attract(value) {\\n      attract = value;\\n    },\\n    get screen() {\\n      return screen;\\n200→    },\\n    set screen(value) {\\n      screen = value;\\n    },\\n    get icons() {\\n      return icons;\\n    },\\n    set icons(value) {\\n      icons = value;\\n    },\\n210→    get prefs() {\\n      return prefs;\\n    },\\n    set prefs(value) {\\n      prefs = value;\\n    },\\n    get save() {\\n      return save;\\n    },\\n    set save(value) {\\n220→      save = value;\\n    },\\n    live,\\n    note,\\n    about,\\n    sliders,\\n    store,\\n    devPage: 0,\\n    jumpPage: 0,\\n    bindPage: 0,\\n230→    pausePage: 0,\\n    aboutFrom: 'title',\\n    get lastDevice() {\\n      return lastDevice;\\n    },\\n    engine: () => engine,\\n    inspector,\\n    run,\\n    open,\\n    close,\\n240→    applyPrefs,\\n    persist,\\n    resume,\\n    publish,\\n    setting(path) {\\n      const value = shownFrame?.setting(path);\\n      return typeof value === 'number' && Number.isFinite(value) ? value : described(path, 'default');\\n    },\\n    settingDefault: (path) => described(path, 'default'),\\n  };\\n250→  const menus: Menus = createMenus(host);\\n  hubView =\\n    hub && client\\n      ? createHub(\\n          {\\n            audio,\\n            client,\\n            run,\\n       