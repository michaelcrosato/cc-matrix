4,45,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,47,101,110,103,105,110,101,47,97,117,100,105,111,47,97,112,105,46,116,115,10,52,57,58,101,120,112,111,114,116,32,116,121,112,101,32,123,32,65,117,100,105,111,32,125,32,102,114,111,109,32,39,46,47,114,117,110,116,105,109,101,47,97,117,100,105,111,39,59,10,53,48,58,101,120,112,111,114,116,32,116,121,112,101,32,123,32,65,117,100,105,111,79,112,116,105,111,110,115,32,125,32,102,114,111,109,32,39,46,47,114,117,110,116,105,109,101,47,97,117,100,105,111,39,59,10,53,49,58,101,120,112,111,114,116,32,116,121,112,101,32,123,32,65,117,100,105,111,83,116,97,116,101,32,125,32,102,114,111,109,32,39,46,47,114,117,110,116,105,109,101,47,97,117,100,105,111,39,59,10,53,50,58,101,120,112,111,114,116,32,116,121,112,101,32,123,32,65,117,100,105,111,73,110,102,111,32,125,32,102,114,111,109,32,39,46,47,114,117,110,116,105,109,101,47,97,117,100,105,111,39,59,10,53,55,58,101,120,112,111,114,116,32,116,121,112,101,32,123,32,65,117,100,105,111,66,117,115,32,125,32,102,114,111,109,32,39,46,47,114,117,110,116,105,109,101,47,109,105,120,101,114,39,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":8,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/audio/runtime/audio.ts\",\"matches\":[{\"line_number\":67,\"content\":\"export interface AudioOptions {\"},{\"line_number\":85,\"content\":\"export interface AudioInfo {\"},{\"line_number\":99,\"content\":\"export interface Audio {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/audio/api.ts\",\"matches\":[{\"line_number\":49,\"content\":\"export type { Audio } from './runtime/audio';\"},{\"line_number\":50,\"content\":\"export type { AudioOptions } from './runtime/audio';\"},{\"line_number\":51,\"content\":\"