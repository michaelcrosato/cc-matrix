live retreat, apart from the save. */\\nexport interface Live {\\n  event: string;\\n  mode: string;\\n  result: number;\\n  calm: number;\\n  rank: string;\\n  age: number;\\n  pebbles: number;\\n20→}\\n\\n/** What the menus may change. The frame loop owns the rest. */\\nexport interface Host {\\n  hub: boolean;\\n  attract: boolean;\\n  screen: string;\\n  icons: Prefs['icons'];\\n  prefs: Prefs;\\n  save: Save;\\n30→  live: Live;\\n  note: HTMLElement;\\n  about: HTMLElement;\\n  sliders: HTMLElement;\\n  devPage: number;\\n  jumpPage: number;\\n  bindPage: number;\\n  pausePage: number;\\n  aboutFrom: string;\\n  lastDevice: string;\\n40→  store: Store;\\n  engine(): Engine | null;\\n  inspector(): Inspector | null;\\n  run(name: string, args?: Record<string, unknown>): void;\\n  open(items: MenuItem[], title: string, id: string, onPick: (id: string) => void, onCancel?: () => void): void;\\n  close(): void;\\n  applyPrefs(): void;\\n  persist(): void;\\n  resume(): void;\\n  publish(): void;\\n50→  setting(path: string): number;\\n  settingDefault(path: string): number;\\n}\\n\\n/** The menus the frame loop opens. */\\nexport interface Menus {\\n  showTitle(): void;\\n  showSettings(page: number): void;\\n  showPause(page: number): void;\\n  showHubPause(): void;\\n60→  showResults(event: string, rank: string): void;\\n  showEvening(): void;\\n  showCredits(): void;\\n}\\n\\nconst RANKS = ['Present', 'Adequate', 'Composed', 'Serene', 'Unsettling'];\\nconst JUMPS = ['morning', 'pose-a', 'pose-b', 'pose-c', 'pond', 'garden', 'paddle', 'line', 'group', 'tilt'];\\nconst REBINDS = ['forward', 'back', 'left', 'right', 'footl', 'footr', 'breathe', 'act', 'gentle'];\\n\\n/** Builds every menu. They call each other, and the host for the sim. */\\n70→export function createMenus(host: Host): Menus {\\n  const pct = (n: number) => `${Math.round(n * 100)}%`;\\n\\n  const showTitle = () => {\\n    const kept = readSave(host.store);\\n    host.open(\\n      [\\n        { label: 'Begin', id: 'begin' },\\n        { label: 'Continue', id: 'continue', disabled: !kept },\\n        { label: 'Free Play', id: 'free', disabled: !kept || (kept.day <= 1 && !kept.credits) },\\n80→        { label: 'Group Class', id: 'group' },\",\"content_concise\":\"1→/**\\n * @file The 10-foot menus. Every one has at most six rows. The same rows serve a pad, keys, and a mouse.\\n */\\nimport type { Engine, Inspector, MenuItem, Store } from '../../../engine';\\nimport { DAYS } from '../scenes/data/days';\\nimport { TUNABLES } from '../scenes/settings';\\nimport { AI_HUB, CREDITS, ENGINE, PROMPT, SOURCE, TESTING } from './about-data';\\nimport { NAMES } from './snap';\\nimport { freshPrefs, freshSave, readSave, type Prefs, type Save } from './save';\\n10→\\n/** The live retreat, apart from the save. */\\nexport interface Live {\\n  event: string;\\n  mode: string;\\n  result: number;\\n  calm: number;\\n  rank: string;\\n  age: number;\\n  pebbles: number;\\n20→}\\n\\n/** What the menus may change. The frame loop owns the rest. */\\nexport interface Host {\\n  hub: boolean;\\n  attract: boolean;\\n  screen: string;\\n  icons: Prefs['icons'];\\n  prefs: Prefs;\\n  save: Save;\\n30→  live: Live;\\n  note: HTMLElement;\\n  about: HTMLElement;\\n  sliders: HTMLElement;\\n  devPage: number;\\n  jumpPage: number;\\n  bindPage: number;\\n  pausePage: number;\\n  aboutFrom: string;\\n  lastDevice: string;\\n40→  store: Store;\\n  engine(): Engine | null;\\n  inspector(): Inspector | null;\\n  run(name: string, args?: Record<string, unknown>): void;\\n  open(items: MenuItem[], title: string, id: string, onPick: (id: string) => void, onCancel?: () => void): void;\\n  close(): void;\\n  applyPrefs(): void;\\n  persist(): void;\\n  resume(): void;\\n  publish(): void;\\n50→  setting(path: string): number;\\n  settingDefault(path: string): number;\\n}\\n\\n/** The menus the frame loop opens. */\\nexport interface Menus {\\n  showTitle(): void;\\n  showSettings(page: number): void;\\n  showPause(page: number): void;\\n  showHubPause(): void;\\n60→  showResults(event: string, rank: string): void;\\n  showEvening(): void;\\n  showCredits(): void;\\n}\\n\\nconst RANKS = ['Present', 'Adequate', 'Composed', 'Serene', 'Unsettling'];\\nconst JUMPS = ['morning', 'pose-a', 'pose-b', 'pose-c', 'pond', 'garden', 'paddle', 'line', 'group', 'tilt'];\\nconst REBINDS = ['forward', 'back', 'left', 'right', 'footl', 'footr', 'breathe', 'act', 'gentle'];\\n\\n/** Builds every menu. They call each other, and the host for the sim. */\\n70→export function createMenus(host: Host): Menus {\\n  const pct = (n: number) => `${Math.round(n * 100)}%`;\\n\\n  const showTitle = () => {\\n    const kept = readSave(host.store);\\n    host.open(\\n      [\\n        { label: 'Begin', id: 'begin' },\\n        { label: 'Continue', id: 'continue', disabled: !kept },\\n        { label: 'Free Play', id: 'free', disabled: !kept || (kept.day <= 1 && !kept.credits) },\\n80→        { label: 'Group Class', id: 'group' },\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/menus.ts\",\"offset\":1,\"limit\":80,\"raw_output\":\"/**\\n * @file The 10-foot menus. Every one has at most six rows. The same rows serve a pad, keys, and a mouse.\\n */\\nimport type { Engine, Inspector, MenuItem, Store } from '../../../engine';\\nimport { DAYS } from '../scenes/data/days';\\nimport { TUNABLES } from '../scenes/settings';\\nimport { AI_HUB, CREDITS, ENGINE, PROMPT, SOURCE, TESTING } from './about-data';\\nimport { NAMES } from './snap';\\nimport { freshPrefs, freshSave, readSave, type Prefs, type Save } from './save';\\n\\n/** The live retreat, apart from the save. */\\nexport interface Live {\\n  event: string;\\n  mode: string;\\n  result: number;\\n  calm: number;\\n  rank: string;\\n  age: number;\\n  pebbles: number;\\n}\\n\\n/** What the menus may change. The frame loop owns the