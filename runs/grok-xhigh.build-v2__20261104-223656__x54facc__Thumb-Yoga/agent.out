ut = Path(sys.argv[2]).resolve()\\n    out.mkdir(parents=True, exist_ok=True)\\n    shots = out / \\\"shots\\\"\\n    shots.mkdir(exist_ok=True)\\n    fails: list[str] = []\\n    try:\\n        with sync_playwright() as p:\\n            try:\\n                browser = p.chromium.launch(executable_path=CHROME, args=FLAGS)\\n            except Exception as error:\\n                (out / \\\"launch-error.txt\\\").write_text(str(error), encoding=\\\"utf-8\\\")\\n                print(\\\"LAUNCH_ERROR\\\")\\n                return 0\\n            try:\\n                boot(browser, html, out, fails)\\n                if not any(item.startswith(\\\"boot\\\") for item in fails):\\n                    shell(browser, html, out, shots, fails)\\n                    touch(browser, p, html, fails)\\n                    hub(browser, html, out, fails)\\n            finally:\\n                browser.close()\\n            webkit(p, html, fails)\\n    except Exception as error:\\n        if \\\"launch-error\\\" not in str(error):\\n            fails.append(f\\\"browser crashed: {error}\\\")\\n    for item in fails:\\n        print(f\\\"FAIL {item}\\\")\\n    return 1 if fails else 0\\n\\n\\ndef boot(browser, html: Path, out: Path, fails: list[str]) -> None:\\n    marks = [once(browser, html, out, 1, fails), once(browser, html, out, 2, fails)]\\n    if marks[0] and marks[1] and marks[0] != marks[1]:\\n        fails.append(f\\\"boot paths disagree {marks[0]} vs {marks[1]}\\\")\\n\\n\\ndef once(browser, html: Path, out: Path, n: int, fails: list[str]) -> str:\\n    page = browser.new_page(viewport={\\\"width\\\": 1920, \\\"height\\\": 1080}, device_scale_factor=1)\\n    page.add_init_script(PAD + WATCH)\\n    logs: list[str] = []\\n    page.on(\\\"console\\\", lambda msg: logs.append(msg.text))\\n    page.on(\\\"pageerror\\\", lambda err: logs.append(f\\\"pageerror {err}\\\"))\\n    try:\\n        page.goto(html.as_uri())\\n        page.wait_for_function(\\\"() => window.__engine && window.__engine.ready === true\\\", timeout=60000)\\n        page.wait_for_timeout(300)\\n        state = page.evaluate(\\n            \\\"\\\"\\\"() => {\\n              const canvas = document.querySelector('canvas');\\n              const game = window.__game || {};\\n              return {\\n                ready: window.__engine.ready,\\n                errors: window.__engine.errors || [],\\n                game,\\n                canvas: { width: canvas ? canvas.width : 0, height: canvas ? canvas.height : 0 },\\n                view: { width: window.innerWidth, height: window.innerHeight },\\n              };\\n            }\\\"\\\"\\\"\\n        )\\n        (out / f\\\"boot-{n}.log\\\").write_text(json.dumps(state, indent=2) + \\\"\\\\n\\\" + \\\"\\\\n\\\".join(logs), encoding=\\\"utf-8\\\")\\n        page.screenshot(path=str(out / f\\\"boot-{n}.png\\\"))\\n        if n == 1:\\n            page.screenshot(path=str(out / \\\"shots\\\" / \\\"title.png\\\"))\\n        errors = state[\\\"errors\\\"]\\n        if state[\\\"ready\\\"] is not True:\\n            fails.append(f\\\"boot {n} ready is false\\\")\\n        if errors:\\n            fails.append(f\\\"boot {n} errors {errors}\\\")\\n        if any(\\\"webgl\\\" in json.dumps(errors).lower() or \\\"downgrade\\\" in json.dumps(errors).lower() for _ in [0]):\\n            fails.append(f\\\"boot {n} downgraded\\\")\\n        game = state[\\\"game\\\"]\\n        if game.get(\\\"title\\\") != \\\"Thumb Yoga\\\" or game.get(\\\"screen\\\") != \\\"title\\\":\\n            fails.append(f\\\"boot {n} title screen {game}\\\")\\n        if game.get(\\\"volumes\\\", {}).get(\\\"music\\\") != 0.1:\\n            fails.append(f\\\"boot {n} music {game.get('volumes')}\\\")\\n        canvas = state[\\\"canvas\\\"]\\n        view = state[\\\"view\\\"]\\n        if canvas[\\\"width\\\"] <= 0 or canvas[\\\"height\\\"] <= 0:\\n            fails.append(f\\\"boot {n} canvas is empty\\\")\\n        if canvas[\\\"width\\\"] != view[\\\"width\\\"] or canvas[\\\"height\\\"] != view[\\\"height\\\"]:\\n            note = out / \\\"webgpu-readback.txt\\\"\\n            note.write_text(\\n                f\\\"drawing {canvas['width']}x{canvas['height']} view {view['width']}x{view['height']}\\\\n\\\",\\n                encoding=\\\"utf-8\\\",\\n            )\\n            fails.append(\\n                f\\\"boot {n} canvas {canvas['width']}x{canvas['height']} is not the view {view['width']}x{view['height']}\\\"\\n            )\\n        # A short key tap can be sampled by a catch-up step and never reach the menu. Hold Cross.\\n        hold(page, 0, \\\"() => window.__game && window.__game.screen === 'play'\\\")\\n        page.wait_for_timeout(400)\\n        after = page.evaluate(\\\"() => ({ screen: window.__game.screen, event: window.__game.event, title: window.__game.title })\\\")\\n        if after.get(\\\"screen\\\") != \\\"play\\\":\\n            fails.append(f\\\"boot {n} did not leave the title\\\")\\n        return json.dumps(after, sort_keys=True)\\n    except Exception as error:\\n        fails.append(f\\\"boot {n} {error}\\\")\\n        return \\\"\\\"\\n    finally:\\n        page.close()\\n\\n\\ndef frames(page) -> None:\\n    page.evaluate(\\\"() => new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)))\\\")\\n\\n\\ndef hold(page, index: int, until: str) -> None:\\n    \\\"\\\"\\\"Holds one standard-mapping button until `until` is true, then lets it go for a frame.\\\"\\\"\\\"\\n    page.evaluate(\\\"(index) => { window.__buttons[index] = 1; }\\\", index)\\n    page.wait_for_function(until, timeout=30000)\\n    page.evaluate(\\\"(index) => { window.__buttons[index] = 0; }\\\", index)\\n    frames(page)\\n\\n\\ndef pad_down(page) -> str:\\n    before = page.evaluate(\\\"() => window.__game.focus\\\")\\n    hold(page, 13, f\\\"() => window.__game && window.__game.focus !== {json.dumps(before)}\\\")\\n    return page.evaluate(\\\"() => window.__game.focus\\\")\\n\\n\\ndef shell(browser, html: Path, out: Path, shots: Path, fails: list[str]) -> None:\\n    page = browser.new_page(viewport={\\\"width\\\": 1920, \\\"height\\\": 1080}, device_scale_factor=1)\\n    page.add_init_script(PAD)\\n    trace: list[str] = []\\n    try:\\n        page.goto(html.as_uri())\\n        page.wait_for_function(\\\"() => window.__engine && window.__engine.ready === true\\\", timeout=60000)\\n        page.wait_for_timeout(200)\\n        note = page.locator(\\\"[data-ui=note]\\\").inner_text()\\n        glyph = page.evaluate(\\\"() => window.__game.glyphSet\\\")\\n        trace.append(f\\\"start {glyph} {note}\\\")\\n        if glyph != \\\"playstation\\\" or \\\"Cross\\\" not in note:\\n            fails.append(f\\\"glyphs started as {glyph} {note}\\\")\\n        # Focus starts on Begin. Two downs skip the disabled rows and land on Settings.\\n        for _ in range(2):\\n            pad_down(page)\\n        focus = page.evaluate(\\\"() => window.__game.focus\\\")\\n        trace.append(f\\\"pad focus {focus}\\\")\\n        if focus != \\\"Settings\\\":\\n            fails.append(f\\\"pad did not reach Settings {focus}\\\")\\n        hold(page, 0, \\\"() => window.__game && window.__game.screen === 'settings'\\\")\\n        for _ in range(3):\\n            pad_down(page)\\n        focus = page.evaluate(\\\"() => window.__game.focus\\\")\\n        trace.append(f\\\"icons row {focus}\\\")\\n        if \\\"Icons\\\" not in focus:\\n\",\"total_lines\":508}}","is_error":false},{"type":"tool_result","tool_use_id":"call-413a9a4d-b404-4850-9367-2ad09f1e13df-30","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The hub card and the ghost mats. The card is HTML. Ghosts are sim leans.\\n * Numbers on the card come from the card event. This file never calls Math.random.\\n */\\nimport type { Audio, Engine } from '../../../engine';\\nimport { runningScore, type Snap } from './snap';\\n\\n/** A hub player, as the welcome message names them. */\\nexport interface HubPlayer {\\n10→  id: number;\\n  name?: string;\\n  color?: string;\\n}\\n\\n/** The session client, only the calls this page makes. */\\nexport interface HubClient {\\n  active: boolean;\\n  me: number | null;\\n  players: HubPlayer[];\\n20→  seed: number;\\n  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<HubInfo | null>;\\n  ready(): void;\\n  fail(message: string): void;\\n  answer(what: 'ready' | 'more'): void;\\n  on(type: string, fn: (...args: unknown[]) => void): void;\\n  time(): number;\\n  progress(body: { score: number; label: string }): void;\\n  send(data: unknown, opts?: { reliable: boolean }): void;\\n  result(body: Record<string, unknown>): void;\\n30→  rng(label: string): () => number;\\n}\\n\\n/** What connect resolves with, once the welcome has arrived. */\\nexport interface HubInfo {\\n  seed: number;\\n  players: HubPlayer[];\\n}\\n\\n/** One neighbour's last lean. */\\n40→interface GhostLean {\\n  x: number;\\n  y: number;\\n  p: number;\\n  e: number;\\n}\\n\\n/** What the card needs from the page. */\\nexport interface HubEnv {\\n  audio: Audio;\\n50→  client: HubClient;\\n  run(name: string, args?: Record<string, unknown>): void;\\n  engine(): Engine | null;\\n  ended(): boolean;\\n  markEnded(): void;\\n}\\n\\n/** The card and the ghost sender. */\\nexport interface HubView {\\n  playing: boolean;\\n60→  paint(screen: string, snap: Snap): void;\\n  tick(input: NonNullable<Engine['input']>, snap: Snap): void;\\n  answer(what: 'ready' | 'more'): void;\\n}\\n\\n/** Builds the card and listens for the round. Call this before the engine is ready. */\\nexport function createHub(env: HubEnv, root: HTMLElement): HubView {\\n  const { client } = env;\\n  const card = document.createElement('div');\\n  card.dataset.ui = 'card';\\n70→  card.hidden = true;\\n  const title = el('p');\\n  title.textContent = 'Thumb Yoga';\\n  const goal = el('p');\\n  goal.textContent = 'Stay the steadiest across three classes.';\\n  const players = el('div');\\n  const left = el('p');\\n  const how = el('p');\\n  how.textContent = 'Lean with the stick or WASD. L2 and R2, or Q and E, are the feet. Both or Space breathe.';\\n  const readyBtn = button('Ready', 'card-ready');\\n80→  const moreBtn = button('More time', 'card-more');\\n  card.append(title, goal, players, left, how, readyBtn, moreBtn);\\n  root.append(card);\\n\\n  const ghosts = new Map<number, GhostLean>();\\n  let cardLeft: number | null = null;\\n  let cardReady: number[] = [];\\n  let asked = false;\\n  let going = false;\\n  let playing = false;\\n90→  let reported = false;\\n  let began = false;\\n  let lastSend = 0;\\n  let lastScore = -1;\\n  let pump = 0;\\n  let lastLabel = '';\\n  let latest: Snap = {\\n    mode: 'title',\\n    event: '',\\n    day: 1,\\n100→    cursor: 0,\\n    credits: 0,\\n    line: '',\\n    result: 0,\\n    age: 0,\\n    pebbles: 0,\\n    rank: '',\\n    seen: '',\\n    phase: 0,\\n    text: '',\\n110→    calm: 0,\\n    a: 0,\\n    b: 0,\\n    c: 0,\\n    ax: 0,\\n    ay: 0,\\n    wx: 0,\\n    wy: 1,\\n    wz: 6,\\n    guest: false,\\n120→  };\\n\\n  readyBtn.addEventListener('click', () => client.answer('ready'));\\n  moreBtn.addEventListener('click', () => client.answer('more'));\\n\\n  client.on('card', (detail) => {\\n    const row =\\n      detail && typeof detail === 'object'\\n        ? (detail as { left?: number | null; ready?: unknown; asked?: boolean })\\n        : {};\\n130→    cardLeft = typeof row.left === 'number' ? row.left : null;\\n    cardReady = Array.isArray(row.ready) ? row.ready.filter((id): id is number => typeof id === 'number') : [];\\n    asked = row.asked === true;\\n  });\\n  client.on('start', () => {\\n    going = true;\\n    playing = true;\\n    if (pump) return;\\n    // The card can open the round while this copy is still compiling. Drawn frames are not\\n    // running yet, and the harness still counts a lean and a score from every copy that stays.\\n140→    const beat = () => {\\n      if (reported || env.ended()) {\\n        stopPump();\\n        return;\\n      }\\n      maybeGo(latest);\\n    };\\n    beat();\\n    pump = window.setInterval(beat, 120);\\n  });\\n150→  client.on('message', (data, from) => {\\n    if (!data || typeof data !== 'object' || typeof from !== 'number') return;\\n    const row = data as { t?: string; x?: number; y?: number; p?: number; e?: number };\\n    if (row.t !== 'g') return;\\n    ghosts.set(from, { x: row.x ?? 0, y: row.y ?? 0, p: row.p ?? 0, e: row.e ?? 0 });\\n  });\\n  client.on('leave', (detail) => {\\n    const id = detail && typeof detail === 'object' ? (detail as { id?: number }).id : undefined;\\n    if (typeof id === 'number') ghosts.delete(id);\\n  });\\n160→  client.on('time-up', () => finish(true));\\n  client.on('end', () => {\\n    stopPump();\\n    env.markEnded();\\n    reported = true;\\n    env.audio.mute(true);\\n    env.engine()?.stop();\\n  });\\n\\n  const answer = (what: 'ready' | 'more') => client.answer(what);\\n170→\\n  function finish(force: boolean): void {\\n    if (reported || env.ended()) return;\\n    if (!force && !playing) return;\\n    stopPump();\\n    reported = true;\\n    const snap = latest;\\n    const score = runningScore(snap);\\n    client.result({\\n      score,\\n180→      stats: [\\n        { name: 'Rank', value: snap.rank || 'Present' },\\n        { name: 'Wobble Age', value: String(Math.round(snap.age)) },\\n        { name: 'Breath', value: String(Math.round(snap.calm)) },\\n        { name: 'Pebbles', value: String(Math.round(snap.pebbles)) },\\n      ],\\n      awards: score >= 900 ? [{ title: 'Unnervingly still', detail: 'The dot barely left the middle.' }] : [],\\n    });\\n  }\\n\\n190→  function report(score: number, label: string): void {\\n    if (reported || env.ended()) return;\\n    if (score === lastScore && label === lastLabel) return;\\n    lastScore = score;\\n    lastLabel = label;\\n    client.progress({ score, label: label.slice(0, 24) });\\n  }\\n\\n  function sendLean(snap: Snap): void {\\n    if (reported || env.ended()) return;\\n200→    const now = performance.now();\\n    if (now - lastSend < 100) return;\\n    lastSend = now;\\n    const score = runningScore(snap);\\n    client.send({ t: 'g', e: snap.phase, x: snap.ax, y: snap.ay, p: snap.phase, s: score }, { reliable: false });\\n  }\\n\\n  function others(): HubPlayer[] {\\n    return client.players.filter((player) => player.id !== client.me).slice(0, 3);\\n  }\\n210→\\n  function lay(input: NonNullable<Engine['input']>, snap: Snap): void {\\n    const packed: number[] = [];\\n    const names = ['', '', '', ''];\\n    others().forEach((player, index) => {\\n      const seat = index + 1;\\n      const ghost = ghosts.get(player.id);\\n      const show = ghost && ghost.e === snap.phase ? 1 : 0;\\n      packed.push(seat, show, ghost?.x ?? 0, ghost?.y ?? 0, ghost?.p ?? 0);\\n      names[seat] = show ? (player.name ?? 'Guest') : '';\\n220→      const hud = show ? `${player.name ?? 'Guest'}` : null;\\n      env.engine()?.ui?.hud(`ghost-${seat}`, hud, { at: 'top-left', color: player.color ?? '#3A4A55' });\\n    });\\n    for (let seat = others().length + 1; seat <= 3; seat += 1) env.engine()?.ui?.hud(`ghost-${seat}`, null);\\n    input.virtual.axis('game:ghosts', packed.length > 0 ? packed : null);\\n    input.virtual.axis('game:names', names);\\n  }\\n\\n  function stopPump(): void {\\n    if (pump === 0) return;\\n230→    window.clearInterval(pump);\\n    pump = 0;\\n  }\\n\\n  function maybeGo(snap: Snap): void {\\n    if (!going || reported || env.ended()) return;\\n    if (client.time() < 0) return;\\n    if (!playing) playing = true;\\n    // run() does nothing until the inspector exists, so keep trying until the engine is bound.\\n    if (!began && env.engine()) {\\n240→      env.run('round.go');\\n      began = true;\\n    }\\n    if (lastScore < 0) report(0, 'Breathing in');\\n    sendLean(snap);\\n    const score = runningScore(snap);\\n    const label = snap.mode === 'results' ? 'Class done' : `Class ${snap.phase + 1} · ${score}`;\\n    report(score, label);\\n  }\\n\\n250→  return {\",\"content_concise\":\"1→/**\\n * @file The hub card and the ghost mats. The card is HTML. Ghosts are sim leans.\\n * Numbers on the card come from the card event. This file never calls Math.random.\\n */\\nimport type { Audio, Engine } from '../../../engine';\\nimport { runningScore, type Snap } from './snap';\\n\\n/** A hub player, as the welcome message names them. */\\nexport interface HubPlayer {\\n10→  id: number;\\n  name?: string;\\n  color?: string;\\n}\\n\\n/** The session client, only the calls this page makes. */\\nexport interface HubClient {\\n  active: boolean;\\n  me: number | null;\\n  players: HubPlayer[];\\n20→  seed: number;\\n  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<HubInfo | null>;\\n  ready(): void;\\n  fail(message: string): void;\\n  answer(what: 'ready' | 'more'): void;\\n  on(type: string, fn: (...args: unknown[]) => void): void;\\n  time(): number;\\n  progress(body: { score: number; label: string }): void;\\n  send(data: unknown, opts?: { reliable: boolean }): void;\\n  result(body: Record<string, unknown>): void;\\n30→  rng(label: string): () => number;\\n}\\n\\n/** What connect resolves with, once the welcome has arrived. */\\nexport interface HubInfo {\\n  seed: number;\\n  players: HubPlayer[];\\n}\\n\\n/** One neighbour's last lean. */\\n40→interface GhostLean {\\n  x: number;\\n  y: number;\\n  p: number;\\n  e: number;\\n}\\n\\n/** What the card needs from the page. */\\nexport interface HubEnv {\\n  audio: Audio;\\n50→  client: HubClient;\\n  run(name: string, args?: Record<string, unknown>): void;\\n  engine(): Engine | null;\\n  ended(): boolean;\\n  markEnded(): void;\\n}\\n\\n/** The card and the ghost sender. */\\nexport interface HubView {\\n  playing: boolean;\\n60→  paint(screen: string, snap: S