(spot(w, 'plaque', 'plaque.moved').x).toBeCloseTo(-6, 5);\"},{\"line_number\":171,\"content\":\"    expect(spot(w, 'plaque', 'plaque.want').x).toBeCloseTo(6 - 0.12, 5);\"},{\"line_number\":172,\"content\":\"    expect(spot(w, 'plaque', 'plaque.moved').x).toBeCloseTo(-6 - 0.12, 5);\"},{\"line_number\":174,\"content\":\"    expect(spot(w, 'plaque', 'plaque.want').x).toBeCloseTo(6 - 0.12, 5);\"},{\"line_number\":181,\"content\":\"    const first = spot(w, 'pebble', 'pebble:0');\"},{\"line_number\":190,\"content\":\"    expect(snap.finds).toContain('pebble:0');\"},{\"line_number\":191,\"content\":\"    expect(noteProgress(freshSave(), snap).finds).toEqual(['pebble:0']);\"},{\"line_number\":193,\"content\":\"    menu('game.begin', { day: 1, cursor: 0, pebbles: 1, finds: ['pebble:0'] });\"},{\"line_number\":202,\"content\":\"    const second = spot(w, 'pebble', 'pebble:1');\"},{\"line_number\":215,\"content\":\"    const flatIsland = flat.w.query('island') as unknown as { island: { tiltX: number } }[];\"},{\"line_number\":216,\"content\":\"    const tippedIsland = tipped.w.query('island') as unknown as { island: { tiltX: number } }[];\"},{\"line_number\":220,\"content\":\"    flatLean.tiltX = 0;\"},{\"line_number\":221,\"content\":\"    tippedLean.tiltX = 20;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/save.ts\",\"matches\":[{\"line_number\":30,\"content\":\"  finds: string[];\"},{\"line_number\":56,\"content\":\"    finds: [],\"},{\"line_number\":73,\"content\":\"    finds: Array.isArray(row.finds) ? row.finds.filter((id) => typeof id === 'string') : [],\"},{\"line_number\":97,\"content\":\"    finds: [...save.finds],\"},{\"line_number\":100,\"content\":\"  for (const id of snap.finds) {\"},{\"line_number\":101,\"content\":\"    if (!next.finds.includes(id)) next.finds.push(id);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104