dy\\\": true,\\n  \\\"errors\\\": [],\\n  \\\"game\\\": {\\n    \\\"title\\\": \\\"Thumb Yoga\\\",\\n    \\\"screen\\\": \\\"title\\\",\\n    \\\"attract\\\": false,\\n    \\\"lastDevice\\\": \\\"gamepad\\\",\\n    \\\"glyphSet\\\": \\\"playstation\\\",\\n10→    \\\"volumes\\\": {\\n      \\\"music\\\": 0.1,\\n      \\\"effects\\\": 1,\\n      \\\"voices\\\": 1\\n    },\\n    \\\"day\\\": 1,\\n    \\\"event\\\": \\\"\\\",\\n    \\\"focus\\\": \\\"Begin\\\"\\n  },\\n  \\\"canvas\\\": {\\n20→    \\\"width\\\": 1920,\\n    \\\"height\\\": 1080\\n  },\\n  \\\"view\\\": {\\n    \\\"width\\\": 1920,\\n    \\\"height\\\": 1080\\n  }\\n}\\n\",\"content_concise\":\"1→{\\n  \\\"ready\\\": true,\\n  \\\"errors\\\": [],\\n  \\\"game\\\": {\\n    \\\"title\\\": \\\"Thumb Yoga\\\",\\n    \\\"screen\\\": \\\"title\\\",\\n    \\\"attract\\\": false,\\n    \\\"lastDevice\\\": \\\"gamepad\\\",\\n    \\\"glyphSet\\\": \\\"playstation\\\",\\n10→    \\\"volumes\\\": {\\n      \\\"music\\\": 0.1,\\n      \\\"effects\\\": 1,\\n      \\\"voices\\\": 1\\n    },\\n    \\\"day\\\": 1,\\n    \\\"event\\\": \\\"\\\",\\n    \\\"focus\\\": \\\"Begin\\\"\\n  },\\n  \\\"canvas\\\": {\\n20→    \\\"width\\\": 1920,\\n    \\\"height\\\": 1080\\n  },\\n  \\\"view\\\": {\\n    \\\"width\\\": 1920,\\n    \\\"height\\\": 1080\\n  }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/tmp/grok-goal-ed8f613011b3/implementer/boot-1.log\",\"offset\":null,\"limit\":40,\"raw_output\":\"{\\n  \\\"ready\\\": true,\\n  \\\"errors\\\": [],\\n  \\\"game\\\": {\\n    \\\"title\\\": \\\"Thumb Yoga\\\",\\n    \\\"screen\\\": \\\"title\\\",\\n    \\\"attract\\\": false,\\n    \\\"lastDevice\\\": \\\"gamepad\\\",\\n    \\\"glyphSet\\\": \\\"playstation\\\",\\n    \\\"volumes\\\": {\\n      \\\"music\\\": 0.1,\\n      \\\"effects\\\": 1,\\n      \\\"voices\\\": 1\\n    },\\n    \\\"day\\\": 1,\\n    \\\"event\\\": \\\"\\\",\\n    \\\"focus\\\": \\\"Begin\\\"\\n  },\\n  