none in this runtime';\\n    const probe = '__my3dge_store_probe__';\\n    storage.setItem(probe, '1');\\n    storage.removeItem(probe);\\n    return storage;\\n  } catch (error) {\\n    return error instanceof Error ? error.name : String(error);\\n160→  }\\n}\\n\\n/** Makes a store (see the file comment). Throws `APP_BAD_STORE` for a bad option. */\\nexport function createStore(options: StoreOptions = {}): Store {\\n  const { prefix = 'my3dge:', version = 1, mode = 'play' } = options;\\n  const log = options.log ?? sharedLog;\\n  const bad = (where: string, problem: string) => codeError('APP_BAD_STORE', { where, problem });\\n  if (typeof prefix !== 'string' || !prefix) throw bad('createStore({ prefix })', `${show(prefix)} is not a non-empty string`); // prettier-ignore\\n  if (!Number.isInteger(version) || version < 1) throw bad('createStore({ version })', `${show(version)} is not a whole number from 1`); // prettier-ignore\\n170→  if (!STORE_MODES.includes(mode)) throw bad('createStore({ mode })', `${show(mode)} is not one of ${STORE_MODES.join(', ')}`); // prettier-ignore\\n  let backend: StoreBackend;\\n  let persistent = false;\\n  if (mode !== 'play') backend = memoryBackend();\\n  else if (options.backend) [backend, persistent] = [options.backend, true];\\n  else {\\n    const page = pageStorage();\\n    if (typeof page === 'string') {\\n      if (page !== 'none in this runtime') log.warnOnce('APP_STORE_BLOCKED', { reason: page, prefix }, prefix);\\n      backend = memoryBackend();\\n180→    } else [backend, persistent] = [page, true];\\n  }\\n  const checkKey = (where: string, key: unknown) => {\\n    if (typeof key !== 'string' || !key) throw bad(where, `the key ${show(key)} is not a non-empty string`);\\n  };\\n  /** Writes `data` in its envelope; false when storage refused it. */\\n  const write = (key: string, data: unknown) => {\\n    try {\\n      backend.setItem(prefix + key, JSON.stringify({ format: STORE_FORMAT, version, data }));\\n      return true;\",\"content_concise\":\"140→      try {\\n        store.set(key, JSON.parse(text));\\n      } catch {\\n        // not JSON: not kept\\n      }\\n    },\\n  };\\n}\\n\\n/** The page's `localStorage`, or why it cannot be had. */\\n150→function pageStorage(): StoreBackend | string {\\n  try {\\n    const storage = (globalThis as { localStorage?: StoreBackend }).localStorage;\\n    if (!storage) return 'none in this runtime';\\n    const probe = '__my3dge_store_probe__';\\n    storage.setItem(probe, '1');\\n    storage.removeItem(probe);\\n    return storage;\\n  } catch (error) {\\n    return error instanceof Error ? error.name : String(error);\\n160→  }\\n}\\n\\n/** Makes a store (see the file comment). Throws `APP_BAD_STORE` for a bad option. */\\nexport function createStore(options: StoreOptions = {}): Store {\\n  const { prefix = 'my3dge:', version = 1, mode = 'play' } = options;\\n  const log = options.log ?? sharedLog;\\n  const bad = (where: string, problem: string) => codeError('APP_BAD_STORE', { where, problem });\\n  if (typeof prefix !== 'string' || !prefix) throw bad('createStore({ prefix })', `${show(prefix)} is not a non-empty string`); // prettier-ignore\\n  if (!Number.isInteger(version) || version < 1) throw bad('createStore({ version })', `${show(version)} is not a whole number from 1`); // prettier-ignore\\n170→  if (!STORE_MODES.includes(mode)) throw bad('createStore({ mode })', `${show(mode)} is not one of ${STORE_MODES.join(', ')}`); // prettier-ignore\\n  let backend: StoreBackend;\\n  let persistent = false;\\n  if (mode !== 'play') backend = memoryBackend();\\n  else if (options.backend) [backend, persistent] = [options.backend, true];\\n  else {\\n    const page = pageStorage();\\n    if (typeof page === 'string') {\\n      if (page !== 'none in this runtime') log.warnOnce('APP_STORE_BLOCKED', { reason: page, prefix }, prefix);\\n      backend = memoryBackend();\\n180→    } else [backend, persistent] = [page, true];\\n  }\\n  const checkKey = (where: string, key: unknown) => {\\n    if (typeof key !== 'string' || !key) throw bad(where, `the key ${show(key)} is not a non-empty string`);\\n  };\\n  /** Writes `data` in its envelope; false when storage refused it. */\\n  const write = (key: string, data: unknown) => {\\n    try {\\n      backend.setItem(prefix + key, JSON.stringify({ format: STORE_FORMAT, version, data }));\\n      return true;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/app/store.ts\",\"offset\":140,\"limit\":50,\"raw_output\":\"      try {\\n        store.set(key, JSON.parse(text));\\n      } catch {\\n        // not JSON: not kept\\n      }\\n    },\\n  };\\n}\\n\\n/** The page's `localStorage`, or why it cannot be had. */\\nfunction pageStorage(): StoreBackend | string {\\n  try {\\n    const storage = (globalThis as { localStorage?: StoreBackend }).localStorage;\\n    if (!storage) return 'none in this runtime';\\n    const probe = '__my3dge_store_probe__';\\n    storage.setItem(probe, '1');\\n    storage.removeItem(probe);\\n    return storage;\\n  } catch (error) {\\n    return error instanceof Error ? error.name : String(error);\\n  }\\n}\\n\\n/** Makes a store (see the file comment). Throws `APP_BAD_STORE` for a bad option. */\\nexport function createStore(options: StoreOptions = {}): Store {\\n  const { prefix = 'my3dge:', version = 1, mode = 'play' } = options;\\n  const log = options.log ?? sharedLog;\\n  const bad = (where: string, problem: string) => codeError('APP_BAD_STORE', { where, problem });\\n  if (typeof prefix !== 'string' || !prefix) throw bad('createStore({ prefix })', `${show(prefix)} is not a non-empty string`); // prettier-ignore\\n  if (!Number.isInteger(version) || version < 1) throw bad('createStore({ version })', `${show(version)} is not a whole number from 1`); // prettier-ignore\\n  if (!STORE_MODES.includes(mode)) throw bad('createStore({ mode })', `${show(mode)} is not one of ${STORE_MODES.join(', ')}`); // prettier-ignore\\n  let backend: StoreBackend;\\n  let persistent = false;\\n  if (mode !== 'play') backend = memoryBackend();\\n  else if (options.backend) [backend, persistent] = [options.backend, true];\\n  else {\\n    const page = pageStorage();\\n    if (typeof page === 'string') {\\n      if (page !== 'none in this runtime') log.warnOnce('APP_STORE_BLOCKED', { reason: page, prefix }, prefix);\\n      backend = memoryBackend();\\n    } else [backend, persistent] = [page, true];\\n  }\\n  const checkKey = (where: string, key: unknown) => {\\n    if (typeof key !== 'string' || !key) throw bad(where, `the key ${show(key)} is not a non-empty string`);\\n  };\\n  /** Writes `data` in its envelope; false when storage refused it. */\\n  const write = (key: string, data: unknown) => {\\n    try {\\n      backend.setItem(prefix + key, JSON.stringify({ format: STORE_FORMAT, version, data }));\\n      return true;\\n\",\"total_lines\":258}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"fd156400-8d9b-4fc6-b26d-f1c0fd6df926"}
{"type":"assistant","message":{"id":"msg_219","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I will write clips using the plan's structure and test the import.\n\nI'll copy the plan's tested example closely, including LeanL, LeanF, LeanB, Chair, Comma, Napkin, Bridge, Lighthouse, and DeepKnee. The island terrain will be 120x120 with ~30k triangles. I'll spawn a sea prop at 0, 2, 0.","signature":""},{"type":"tool_use","id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-46","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/world/props/prop.ts","offset":1,"limit":80}},{"type":"tool_use","id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-47","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/sim/props.ts","offset":140,"limit":40}},{"type":"tool_use","id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-48","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/anim/clip/clipsets.ts","offset":50,"limit":40}},{"type":"tool_use","id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-49","name":"grep","input":{"pattern":"export function parseClip","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/anim"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4106,"output_tokens":563,"cache_read_input_tokens":91392,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"d11b6652-1346-4a31-b646-fe8b418eb6fd"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-46","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The prop registry (PLAN.md WP 4.5, §6.6): the registry kind `prop`, one entry per kind of thing that stands\\n * in a level, as data: the meshes it is drawn with (geometry and material by id, §6.1: `world` names them, `gfx`\\n * builds them, engine/gfx/props.ts), its body (a shape and a material for the physics world), an optional light\\n * spot, where a level places it, and its interaction hooks. The engine's props are the crate, the barrel, the\\n * brazier's fire and the pillar (engine/world/props/catalog.ts), the library's sconce, banner, chest, door, table,\\n * bench, statue, lantern and chair (library.ts, WP 10.3, the chair WP 13.16's) and the house's fittings, the pane,\\n * the switch, the lamp and the garage door (fittings.ts, WP 13.16); a game adds its own with `defineProp`\\n * (`x new prop`). WP 13.16's fields: a `kinematic` body the sim drives, `health` and what breaking leaves (`breaks`),\\n10→ * a `prompt` for its own `use`, and parts `lit` only while the prop is on; a hook's touch also names the world, the\\n * entity and its user.\\n *\\n * A prop's frame: its base, where it stands, is the origin, +Y up, and its parts stand on it as the geometry kit's\\n * shapes stand on the ground. Its body's shape stands on the base too, so the body's origin, the prop's centre, is\\n * `propCentre(prop)` above it: what a body's pose (`readBody`) and `propPose` give, and what the meshes are drawn\\n * at. A part with `flame.tongues` above 0 is drawn as that many flame tongues dancing round its origin (its geometry\\n * a cone one metre high, stretched each frame), the 2D hall's flames. The hooks: `hit` (a swing, a blast) knocks a\\n * dynamic prop away and leaves the others; `use` does nothing; shared code calls them and never compares ids.\\n *\\n20→ * Carried: the idea of my-3d2dge's 2D prop catalog (`src/starter/*`, `src/emberdeep/51-themes.js`): kinds of props\\n * as data with their light metadata (a colour, a reach and a flicker beside the drawing).\\n *\\n * Invariants: an entry is plain data plus its two hooks, every field filled with its default; a part's name is\\n * unique in its prop; colours are hex; vectors have three numbers; a body's shape has a size above 0; spawn names\\n * and light tags are words. Geometry and material ids are gfx's to resolve (a missing one draws its kind's fallback,\\n * and `node x qa geo tex --only prop:` reports it). Problems raise `CORE_BAD_SPEC` naming each; a missing id gets\\n * `prop:crate` after a warning (`CORE_UNKNOWN_ID`).\\n *\\n * @example\\n30→ * import { createRegistry } from '../../core/registry';\\n * const reg = createRegistry();\\n * defineProp('prop:stool', { parts: [{ geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.2, height: 0.45 }, material: 'material:planks' }], body: { type: 'dynamic', shape: 'cylinder', radius: 0.2, height: 0.45 } }, reg);\\n * propCentre(getProp('prop:stool', reg)); // 0.225: half its height\\n * getProp('prop:crate', reg).body.type; // 'dynamic': the engine's props come with the kind\\n * @see engine/world/props/prop.test.ts\\n */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\n40→import type { Point3 } from '../level/types';\\nimport { BUILT_IN_PROPS } from './catalog';\\nimport { FITTING_PROPS } from './fittings';\\nimport { LIBRARY_PROPS } from './library';\\n\\n/** A vector field in metres (or `unit`), three numbers. */\\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\\n\\n/** A length in metres, at least 0. */\\n50→const metres = (value: number, description: string) =>\\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\\n\\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\\n\\n/** The fields of a part's flame. */\\nconst FLAME_FIELDS = {\\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\\n60→  ring: metres(0.1, 'How far from its origin the tongues stand.'),\\n  height: metres(0.4375, \\\"A tongue's mean height; it dances about half of it either way.\\\"),\\n  sway: metres(0.0875, 'How far a tongue sways sideways, leaning 3 rad per metre of sway.'),\\n  core: { type: 'string', default: '#ffd36a', description: 'The colour of the core inside each tongue, hex.' },\\n} as const satisfies Schema;\\n\\n/** The fields of one part: a mesh of the prop. */\\nexport const PROP_PART_FIELDS = {\\n  name: {\\n    type: 'string',\\n70→    default: 'mesh',\\n    description: 'Its name, unique in the prop: the ID pass names its batch `<prop>/<name>` (prop:crate/mesh).',\\n  },\\n  geometry: {\\n    type: 'string',\\n    default: 'geometry:box',\\n    description: 'Its geometry by id (engine/gfx/geometry), standing on the ground, in metres.',\\n  },\\n  params: { type: 'object', default: {}, description: \\\"The geometry's parameters; the rest keep their defaults.\\\" },\\n  material: {\\n80→    type: 'string',\",\"content_concise\":\"1→/**\\n * @file The prop registry (PLAN.md WP 4.5, §6.6): the registry kind `prop`, one entry per kind of thing that stands\\n * in a level, as data: the meshes it is drawn with (geometry and material by id, §6.1: `world` names them, `gfx`\\n * builds them, engine/gfx/props.ts), its body (a shape and a material for the physics world), an optional light\\n * spot, where a level places it, and its interaction hooks. The engine's props are the crate, the barrel, the\\n * brazier's fire and the pillar (engine/world/props/catalog.ts), the library's sconce, banner, chest, door, table,\\n * bench, statue, lantern and chair (library.ts, WP 10.3, the chair WP 13.16's) and the house's fittings, the pane,\\n * the switch, the lamp and the garage door (fittings.ts, WP 13.16); a game adds its own with `defineProp`\\n * (`x new prop`). WP 13.16's fields: a `kinematic` body the sim drives, `health` and what breaking leaves (`breaks`),\\n10→ * a `prompt` for its own `use`, and parts `lit` only while the prop is on; a hook's touch also names the world, the\\n * entity and its user.\\n *\\n * A prop's frame: its base, where it stands, is the origin, +Y up, and its parts stand on it as the geometry kit's\\n * shapes stand on the ground. Its body's shape stands on the base too, so the body's origin, the prop's centre, is\\n * `propCentre(prop)` above it: what a body's pose (`readBody`) and `propPose` give, and what the meshes are drawn\\n * at. A part with `flame.tongues` above 0 is drawn as that many flame tongues dancing round its origin (its geometry\\n * a cone one metre high, stretched each frame), the 2D hall's flames. The hooks: `hit` (a swing, a blast) knocks a\\n * dynamic prop away and leaves the others; `use` does nothing; shared code calls them and never compares ids.\\n *\\n20→ * Carried: the idea of my-3d2dge's 2D prop catalog (`src/starter/*`, `src/emberdeep/51-themes.js`): kinds of props\\n * as data with their light metadata (a colour, a reach and a flicker beside the drawing).\\n *\\n * Invariants: an entry is plain data plus its two hooks, every field filled with its default; a part's name is\\n * unique in its prop; colours are hex; vectors have three numbers; a body's shape has a size above 0; spawn names\\n * and light tags are words. Geometry and material ids are gfx's to resolve (a missing one draws its kind's fallback,\\n * and `node x qa geo tex --only prop:` reports it). Problems raise `CORE_BAD_SPEC` naming each; a missing id gets\\n * `prop:crate` after a warning (`CORE_UNKNOWN_ID`).\\n *\\n * @example\\n30→ * import { createRegistry } from '../../core/registry';\\n * const reg = createRegistry();\\n * defineProp('prop:stool', { parts: [{ geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.2, height: 0.45 }, material: 'material:planks' }], body: { type: 'dynamic', shape: 'cylinder', radius: 0.2, height: 0.45 } }, reg);\\n * propCentre(getProp('prop:stool', reg)); // 0.225: half its height\\n * getProp('prop:crate', reg).body.type; // 'dynamic': the engine's props come with the kind\\n * @see engine/world/props/prop.test.ts\\n */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\n40→import type { Point3 } from '../level/types';\\nimport { BUILT_IN_PROPS } from './catalog';\\nimport { FITTING_PROPS } from './fittings';\\nimport { LIBRARY_PROPS } from './library';\\n\\n/** A vector field in metres (or `unit`), three numbers. */\\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\\n\\n/** A length in metres, at least 0. */\\n50→const metres = (value: number, description: string) =>\\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\\n\\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\\n\\n/** The fields of a part's flame. */\\nconst FLAME_FIELDS = {\\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\\n60→  ring: metres(0.1, 'How far from its origin the tongues stand.'),\\n  height: metres(0.4375, \\\"A tongue's mean height; it dances about half of it either way.\\\"),\\n  sway: metres(0.0875, 'How far a tongue sways sideways, leaning 3 rad per metre of sway.'),\\n  core: { type: 'string', default: '#ffd36a', description: 'The colour of the core inside each tongue, hex.' },\\n} as const satisfies Schema;\\n\\n/** The fields of one part: a mesh of the prop. */\\nexport const PROP_PART_FIELDS = {\\n  name: {\\n    type: 'string',\\n70→    default: 'mesh',\\n    description: 'Its name, unique in the prop: the ID pass names its batch `<prop>/<name>` (prop:crate/mesh).',\\n  },\\n  geometry: {\\n    type: 'string',\\n    default: 'geometry:box',\\n    description: 'Its geometry by id (engine/gfx/geometry), standing on the ground, in metres.',\\n  },\\n  params: { type: 'object', default: {}, description: \\\"The geometry's parameters; the rest keep their defaults.\\\" },\\n  material: {\\n80→    type: 'string',\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/world/props/prop.ts\",\"offset\":1,\"limit\":80,\"raw_output\":\"/**\\n * @file The prop registry (PLAN.md WP 4.5, §6.6): the registry kind `prop`, one entry per kind of thing that stands\\n * in a level, as data: the meshes it is drawn with (geometry and material by id, §6.1: `world` names them, `gfx`\\n * builds them, engine/gfx/props.ts), its body (a shape and a material for the physics world), an optional light\\n * spot, where a level places it, and its interaction hooks. The engine's props are the crate, the barrel, the\\n * brazier's fire and the pillar (engine/world/props/catalog.ts), the library's sconce, banner, chest, door, table,\\n * bench, statue, lantern and chair (library.ts, WP 10.3, the chair WP 13.16's) and the house's fittings, the pane,\\n * the switch, the lamp and the garage door (fittings.ts, WP 13.16); a game adds its own with `defineProp`\\n * (`x new prop`). WP 13.16's fields: a `kinematic` body the sim drives, `health` and what breaking leaves (`breaks`),\\n * a `prompt` for its own `use`, and parts `lit` only while the prop is on; a hook's touch also names the world, the\\n * entity and its user.\\n *\\n * A prop's frame: its base, where it stands, is the origin, +Y up, and its parts stand on it as the geometry kit's\\n * shapes stand on the ground. Its body's shape stands on the base too, so the body's origin, the prop's centre, is\\n * `propCentre(prop)` above it: what a body's pose (`readBody`) and `propPose` give, and what the meshes are drawn\\n * at. A part with `flame.tongues` above 0 is drawn as that many flame tongues dancing round its origin (its geometry\\n * a cone one metre high, stretched each frame), the 2D hall's flames. The hooks: `hit` (a swing, a blast) knocks a\\n * dynamic prop away and leaves the others; `use` does nothing; shared code calls them and never compares ids.\\n *\\n * Carried: the idea of my-3d2dge's 2D prop catalog (`src/starter/*`, `src/emberdeep/51-themes.js`): kinds of props\\n * as data with their light metadata (a colour, a reach and a flicker beside the drawing).\\n *\\n * Invariants: an entry is plain data plus its two hooks, every field filled with its default; a part's name is\\n * unique in its prop; colours are hex; vectors have three numbers; a body's shape has a size above 0; spawn names\\n * and light tags are words. Geometry and material ids are gfx's to resolve (a missing one draws its kind's fallback,\\n * and `node x qa geo tex --only prop:` reports it). Problems raise `CORE_BAD_SPEC` naming each; a missing id gets\\n * `prop:crate` after a warning (`CORE_UNKNOWN_ID`).\\n *\\n * @example\\n * import { createRegistry } from '../../core/registry';\\n * const reg = createRegistry();\\n * defineProp('prop:stool', { parts: [{ geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.2, height: 0.45 }, material: 'material:planks' }], body: { type: 'dynamic', shape: 'cylinder', radius: 0.2, height: 0.45 } }, reg);\\n * propCentre(getProp('prop:stool', reg)); // 0.225: half its height\\n * getProp('prop:crate', reg).body.type; // 'dynamic': the engine's props come with the kind\\n * @see engine/world/props/prop.test.ts\\n */\\nimport { galleryField } from '../../core/gallery';\\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\\nimport type { EntryOf, Schema } from '../../core/schema';\\nimport type { Point3 } from '../level/types';\\nimport { BUILT_IN_PROPS } from './catalog';\\nimport { FITTING_PROPS } from './fittings';\\nimport { LIBRARY_PROPS } from './library';\\n\\n/** A vector field in metres (or `unit`), three numbers. */\\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\\n\\n/** A length in metres, at least 0. */\\nconst metres = (value: number, description: string) =>\\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\\n\\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\\n\\n/** The fields of a part's flame. */\\nconst FLAME_FIELDS = {\\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\\n  ring: metres(0.1, 'How far from its origin the tongues stand.'),\\n  height: metres(0.4375, \\\"A tongue's mean height; it dances about half of it either way.\\\"),\\n  sway: metres(0.0875, 'How far a tongue sways sideways, leaning 3 rad per metre of sway.'),\\n  core: { type: 'string', default: '#ffd36a', description: 'The colour of the core inside each tongue, hex.' },\\n} as const satisfies Schema;\\n\\n/** The fields of one part: a mesh of the prop. */\\nexport const PROP_PART_FIELDS = {\\n  name: {\\n    type: 'string',\\n    default: 'mesh',\\n    description: 'Its name, unique in the prop: the ID pass names its batch `<prop>/<name>` (prop:crate/mesh).',\\n  },\\n  geometry: {\\n    type: 'string',\\n    default: 'geometry:box',\\n    description: 'Its geometry by id (engine/gfx/geometry), standing on the ground, in metres.',\\n  },\\n  params: { type: 'object', default: {}, description: \\\"The geometry's parameters; the rest keep their defaults.\\\" },\\n  material: {\\n    type: 'string',\\n\",\"total_lines\":373}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-47","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→}\\n\\n/**\\n * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\\n * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\\n * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\\n *\\n * @example\\n * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\\n * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\\n150→ * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\\n */\\nexport function spawnProp<C extends object, E extends EventMap>(\\n  world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n160→  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n170→}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\",\"content_concise\":\"140→}\\n\\n/**\\n * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\\n * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\\n * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\\n *\\n * @example\\n * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\\n * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\\n150→ * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\\n */\\nexport function spawnProp<C extends object, E extends EventMap>(\\n  world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n160→  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n170→}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/sim/props.ts\",\"offset\":140,\"limit\":40,\"raw_output\":\"}\\n\\n/**\\n * Stands a prop in the scene, `spawnProp(w, { prop: 'prop:<id>', at: [x, y, z], yaw })`: its base at `at` (m), turned\\n * `yaw` about +Y (rad). It makes the prop's body (when it has one; the scene needs `physics: true` then) and an entity\\n * with the component `sceneProp`, and returns the entity's id. A missing prop id warns and stands a crate (`getProp`).\\n *\\n * @example\\n * // in a scene's setup, with physics: true and its level's bodies added (addLevelBodies(physicsOf(w), level)):\\n * // const id = spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: Math.PI / 2 }); // on the floor at x 2, z 3\\n * // labs/box/scenes/hall-props.ts places the hall's props this way, from levelProps and its own spots.\\n */\\nexport function spawnProp<C extends object, E extends EventMap>(\\n  world: World<C, E>,\\n  placement: PropPlacement,\\n  options: SpawnPropOptions = {},\\n): number {\\n  const w = world as unknown as World;\\n  const entry = getProp(placement.prop);\\n  const prop = entry.id;\\n  const spec = propBody({ ...placement, prop }, undefined, options.as);\\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\\n  const [x, y, z] = position;\\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\\n  const switchable = options.on !== undefined || options.group !== undefined;\\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\\n}\\n\\n/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\\nexport function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\\n  if (body < 0) return -1;\\n  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\\n  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\\n}\\n\\n/** The entity whose body is `body` (a body id; −1 for none): a prop's (`propOfBody`), else an actor's; −1 for neither. */\\n\",\"total_lines\":222}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1f65ac33-d555-4cba-adf2-097cc5f0232c-48","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"50→const SET_FILE = '_set.json';\\n\\n/** The fields of a `clipset` entry: a set's header (validate.ts `ClipSet`) and its clips. */\\nexport const CLIPSET_FIELDS = defineSchema({\\n  set: {\\n    type: 'string',\\n    required: true,\\n    description: 'Its name, upper case (QUATERNIUS): its clips play as SET/Clip.',\\n  },\\n  title: { type: 'string', description: 'Its title, as shown.' },\\n60→  credit: {\\n    type: 'string',\\n    description: 'The credit its license asks for, shown on screen wherever its clips ship (data/anim/SOURCES.md).',\\n  },\\n  format: { type: 'integer', description: 'The readable format its clips are in: 1, or 2 (PLAN.md §10.2).' },\\n  legend: { type: 'array', description: 'How to read its clips, line by line (format 2).' },\\n  from: { type: 'array', description: 'The sets a picked set was taken from.' },\\n  fps: { type: 'number', unit: '1/s', description: 'The rate its captures were sampled at.' },\\n  sources: {\\n    type: 'object',\\n70→    description: 'The libraries its clips came from, by name: provenance, and the rest body each was measured on.',\\n  },\\n  body: { type: 'any', description: 'The mannequin’s segments and bands, or null (only the Quaternius set has them).' },\\n  fit: