t_code\":0,\"match_count\":36,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/core/time.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * 60 Hz sim steps plus an interpolation `alpha`, under a time scale, a stack of slowdowns, a hit-stop with a leaky\"},{\"line_number\":9,\"content\":\" * last, times the speed, and hands out the whole steps in it, at most `time.maxSteps`; after a stall the steps beyond\"},{\"line_number\":12,\"content\":\" * call them) that change how many steps a frame runs, never what a step does, so the clock is no part of the hash,\"},{\"line_number\":16,\"content\":\" * Invariants: the accumulator counts whole nanoseconds times `hz` (one step is 1e9), so at speed 1 the steps after T\"},{\"line_number\":20,\"content\":\" * settings `time.maxSteps`, `time.scale`, `time.paused` and `time.hitStop.*`. Ten frames in a row that drop steps\"},{\"line_number\":29,\"content\":\" * clock.advance(1000); // { steps: 0, alpha: 0, … }: the first frame sets the origin\"},{\"line_number\":30,\"content\":\" * const frame = clock.advance(1025); // 25 ms later: { steps: 1, alpha: 0.5, … }\"},{\"line_number\":40,\"content\":\"/** The sim's steps per second: gameplay time is counted in 60 Hz ticks (ADR-0005). */\"},{\"line_number\":58,\"content\":\"      'the sim is falling behind real time: {frames} frames in a row each needed more than time.maxSteps = {maxSteps} steps, and the rest were dropped',\"},{\"line_number\":59,\"content\":\"    fix: 'make each step cheaper (__engine.stats() shows where the time goes) or lighten the scene; raise time.maxSteps only when frames are long and steps cheap',\"},{\"line_number\":73,\"content\":\"    description: 'Sim steps per second. The engine is tuned at 60 (ADR-0005); the hash and replays record it.',\"},{\"line_number\":82,\"content\":\"      'The most steps one frame runs to catch up; a longer stall drops the rest (the spiral-of-death guard).',\"},{\"line_number\":91,\"content\":\"      'Sim seconds per real second: 0.5 is half speed. It changes how often steps come, never what one does.',\"},{\"line_number\":97,\"content\":\"    description: 'Stops sim time; clock.step(n) still runs single steps.',\"},{\"line_number\":139,\"content\":\"const MAX_FRAME_NS = 3600 * NS;\"},{\"line_number\":140,\"content\":\"/** Frames in a row that must drop steps before `CORE_CLOCK_BEHIND`. */\"},{\"line_number\":145,\"content\":\"  /** Fixed steps to run now, each `clock.dt` of sim time. */\"},{\"line_number\":146,\"content\":\"  steps: number;\"},{\"line_number\":153,\"content\":\"  /** Whole steps dropped after a stall, beyond `time.maxSteps`. */\"},{\"line_number\":164,\"content\":\"  /** Single steps waiting for the next frame. */\"},{\"line_number\":166,\"content\":\"  /** Whole steps dropped after stalls, in all. */\"},{\"line_number\":174,\"content\":\"/** Turns frame timestamps into fixed steps: the accumulator, the time scale, slowdowns, hit-stop and pause. */\"},{\"line_number\":176,\"content\":\"  /** Sim steps per second (`time.hz` when the clock was made or reset). */\"},{\"line_number\":192,\"content\":\"  /** Takes the frame's timestamp in milliseconds (default: `now()`) and returns the steps to run and alpha. */\"},{\"line_number\":198,\"content\":\"  /** Adds `n` steps to the next frame, paused or not, whatever the speed: `__engine.step(n)`. */\"},{\"line_number\":214,\"content\":\"  /** Sets `time.hz`: sim steps per second. */\"},{\"line_number\":216,\"content\":\"  /** Sets `time.maxSteps`: the most steps one frame runs. */\"},{\"line_number\":304,\"content\":\"      const ns = Math.min(MAX_FRAME_NS, Math.max(0, nowNs - lastNs));\"},{\"line_number\":306,\"content\":\"      let steps = 0;\"},{\"line_number\":310,\"content\":\"        steps = Math.floor(acc / NS);\"},{\"line_number\":311,\"content\":\"        acc -= steps * NS;\"},{\"line_number\":313,\"content\":\"        if (steps > maxSteps) [lost, steps] = [steps - maxSteps, maxSteps];\"},{\"line_number\":317,\"content\":\"      steps += pending;\"},{\"line_number\":319,\"content\":\"      ticks += steps;\"},{\"line_number\":321,\"content\":\"      return { steps, alpha: acc / NS, elapsed: ns / NS, speed: speed(), dropped: lost };\"},{\"line_number\":326,\"content\":\"      check(Number.isInteger(n) && n >= 0, 'clock.step(n)', n, 'a whole number of steps, 0 or more');\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-72802ff7-d068-4fed-8ac8-ebca19429d8d-119","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=8000)\\n        trace.append(\\\"attract left on a key\\\")\\n        page.wait_for_timeout(10500)\\n        page.mouse.click(420, 420)\\n        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=8000)\",\"new_string\":\"        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=15000)\\n        trace.append(\\\"attract left on a key\\\")\\n        page.wait_for_timeout(10500)\\n        page.mouse.click(420, 420)\\n        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=15000)\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/browse.py has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/browse.py has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/browse.py\",\"edits\":{\"details\":[{\"old_string\":\"        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=8000)\\n        trace.append(\\\"attract left on a key\\\")\\n        page.wait_for_timeout(10500)\\n        page.mouse.click(420, 420)\\n        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=8000)\",\"old_line\":242,\"new_string\":\"        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=15000)\\n        trace.append(\\\"attract left on a key\\\")\\n        page.wait_for_timeout(10500)\\n        page.mouse.click(420, 420)\\n        page.wait_for_function(\\\"() => window.__game && window.__game.attract === false\\\", timeout=15000)\",\"new_line\":242,\"context_before\":\"        if not attracted:\\n            fails.append(f\\\"attract did not start {page.evaluate('() => window.__game')}\\\")\\n        page.keyboard.press(\\\"f\\\")\\n\",\"context_after\":\"        trace.append(\\\"attract left on a click\\\")\\n        page.wait_for_timeout(10500)\\n        hold(page, 0, \\\"() => window.__game && window.__game.attract === false\\\")\\n\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-72802ff7-d068-4fed-8ac8-ebca19429d8d-120","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"                page.wait_for_function(\\\"() => window.__game && window.__game.screen === 'settings'\\\", timeout=8000)\",\"new_string\":\"                page.wait_for_function(\\\"() => window.__game && window.__game.screen === 'settings'\\\", timeout=15000)\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/browse.py has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__