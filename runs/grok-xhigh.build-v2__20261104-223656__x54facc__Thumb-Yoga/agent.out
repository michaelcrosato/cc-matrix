,32,105,115,32,110,111,116,32,100,101,101,112,32,119,104,101,114,101,32,121,111,117,32,119,97,108,107,46,32,73,116,32,119,111,117,108,100,32,108,105,107,101,32,121,111,117,32,116,111,32,115,116,97,121,32,116,104,97,116,32,119,97,121,46,39,44,10,49,52,55,58,32,32,39,99,108,97,115,115,46,101,110,116,101,114,39,58,32,39,70,105,110,100,32,116,104,101,32,115,101,97,116,46,32,84,104,101,32,108,105,110,101,32,116,111,32,105,116,32,100,111,101,115,32,110,111,116,32,115,99,111,114,101,46,39,44,10,49,57,51,58,32,32,39,103,114,111,117,112,46,103,111,39,58,32,39,71,114,111,117,112,32,67,108,97,115,115,32,116,97,107,101,115,32,117,112,32,116,111,32,102,111,117,114,46,32,84,104,101,32,114,101,115,116,32,111,102,32,116,104,101,32,115,101,97,116,115,32,99,97,110,32,98,101,32,115,116,97,102,102,46,39,44,10,50,49,48,58,32,32,39,99,111,109,109,97,46,115,105,100,101,39,58,32,39,84,104,101,32,111,116,104,101,114,32,115,101,97,116,44,32,98,101,99,97,117,115,101,32,99,111,109,109,97,115,32,108,101,97,110,46,32,83,111,32,100,111,32,121,111,117,46,39,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":195,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/looks/retreat.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Materials for the lawn, the shore, and the sea are defined here so the view can find them.\"},{\"line_number\":19,\"content\":\"defineMaterial('material:sea', {\"},{\"line_number\":20,\"content\":\"  description: 'The sea around the island. The texture is drifted by moving the prop.',\"},{\"line_number\":34,\"content\":\"  description: 'Brochure noon over an empty sea horizon.',\"},{\"line_number\":40,\"content\":\"  description: 'The last morning. The sun is low and the sea is pale.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/main.ts\",\"matches\":[{\"line_number\":29,\"content\":\"  const search = new URLSearchParams(location.search);\"},{\"line_number\":30,\"content\":\"  for (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\"},{\"line_number\":31,\"content\":\"  search.set('touch', 'off');\"},{\"line_number\":32,\"content\":\"  if (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\"},{\"line_number\":33,\"content\":\"  const info = hubClient?.active ? await hubClient.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\"},{\"line_number\":35,\"content\":\"    search.set('scene', round.id);\"},{\"line_number\":36,\"content\":\"    search.set('seed', String(info.seed));\"},{\"line_number\":38,\"content\":\"  search.set('post.look', info ? 'look:pavilion' : 'look:retreat');\"},{\"line_number\":44,\"content\":\"    search.set('gfx.resolution', 'pixels');\"},{\"line_number\":45,\"content\":\"    search.set('quality', 'low');\"},{\"line_number\":46,\"content\":\"    search.set('gfx.warmUp', 'asked');\"},{\"line_number\":47,\"content\":\"  } else search.set('gfx.resolution', 'full');\"},{\"line_number\":48,\"content\":\"  const store = createStore({ prefix: 'thumb-yoga:', mode: session || search.has('replay') ? 'demo' : 'play' });\"},{\"line_number\":66,\"content\":\"    search: `?${search}`,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\"},{\"line_number\":255,\"content\":\"/** One seat, the day, and the island. The first step starts a director or a demo. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/bot.ts\",\"matches\":[{\"line_number\":4,\"content\":\" * Off-centre seats need a feedforward term, or a late thumb settles short of the ring.\"},{\"line_number\":44,\"content\":\" * The stick that holds `desired` on this seat. `instScale` matches the activity's instability.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/island.test.ts\",\"matches\":[{\"line_number\":38,\"content\":\"/** The sea's turn. q[2] is the west-lean component. */\"},{\"line_number\":39,\"content\":\"function seaZ(w: World): number {\"},{\"line_number\":41,\"content\":\"  return rows.find((row) => row.sceneProp.prop === 'prop:sea')?.sceneProp.q[2] ?? 0;\"},{\"line_number\":44,\"content\":\"/** The island lean the sea is reading. */\"},{\"line_number\":79,\"content\":\"  it('boots the pavilion and keeps a ghost seat', () => {\"},{\"line_number\":83,\"content\":\"    const ghosts = world.query('ghost') as unknown as { ghost: { on: number; seat: number } }[];\"},{\"line_number\":85,\"content\":\"    expect(ghosts.some((row) => row.ghost.seat === 1 && row.ghost.on === 1)).toBe(true);\"},{\"line_number\":112,\"content\":\"  it('tips the sea with the centre of balance, and a delivered guest takes lean off', () => {\"},{\"line_number\":118,\"content\":\"    let seaGap = 0;\"},{\"line_number\":123,\"content\":\"      seaGap = Math.max(seaGap, Math.abs(seaZ(pushed.w) - seaZ(still.w)));\"},{\"line_number\":126,\"content\":\"    expect(seaGap).toBeGreaterThan(0.001);\"},{\"line_number\":127,\"content\":\"    expect(seaZ(still.w)).not.toBe(0);\"},{\"line_number\":133,\"content\":\"    const fastSea = seaZ(w);\"},{\"line_number\":141,\"content\":\"    expect(fastSea).toBeLessThan(seaZ(calm.w));\"},{\"line_number\":147,\"content\":\"    const beforeSea = seaZ(east.w);\"},{\"line_number\":158,\"content\":\"    expect(seaZ(east.w)).toBeGreaterThan(beforeSea);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/wobble.ts\",\"matches\":[{\"line_number\":35,\"content\":\"/** The centre of balance and the sway drawn once for the seat. */\"},{\"line_number\":37,\"content\":\"  seat: number;\"},{\"line_number\":79,\"content\":\"  description: 'A seat’s centre of balance, its breath and the sway drawn for it.',\"},{\"line_number\":81,\"content\":\"    seat: { type: 'integer', default: 0, description: 'Which mat this body stands on.' },\"},{\"line_number\":114,\"content\":\"  description: 'Recent centres of balance for one seat, oldest first in the ring.',\"},{\"line_number\":135,\"content\":\"/** The slow sway on one axis. Phases come from the seat, never from Math.random. */\"},{\"line_number\":152,\"content\":\"/** Draws the six ratios and phases for a seat from the stream `sway`. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/state.ts\",\"matches\":[{\"line_number\":145,\"content\":\"    on: num('1 while a message has arrived for this seat.'),\"},{\"line_number\":148,\"content\":\"    seat: { type: 'integer', default: 0, description: 'Their mat.' },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/island.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Activities still run on the balance step. The ground mesh stays put. The sea tips against the lean,\"},{\"line_number\":50,\"content\":\"defineProp('prop:sea', {\"},{\"line_number\":51,\"content\":\"  description: 'The sea. It is flat, and it pretends to breathe.',\"},{\"line_number\":57,\"content\":\"      material: 'material:sea',\"},{\"line_number\":150,\"content\":\"/** The sea's drawn position. `q` is the counter-rotation the dress writes. */\"},{\"line_number\":155,\"content\":\"/** The island lean the sea and the slope both read. */\"},{\"line_number\":177,\"content\":\"function seaTurn(tiltX: number, tiltZ: number): [number, number, number, number] {\"},{\"line_number\":220,\"content\":\"/** Puts the island, the sea, the cast and the hidden pebbles into the world. */\"},{\"line_number\":223,\"content\":\"  spawnProp(w, { prop: 'prop:sea', at: [0, 2, 0], yaw: 0 });\"},{\"line_number\":271,\"content\":\"  const q = seaTurn(lean?.tiltX ?? 0, lean?.tiltZ ?? 0);\"},{\"line_number\":273,\"content\":\"    if (row.sceneProp.prop !== 'prop:sea') continue;\"},{\"line_number\":316,\"content\":\"  const rows = w.query('wobble') as unknown as { wobble: { x: number; y: number; seat: number } }[];\"},{\"line_number\":317,\"content\":\"  const body = rows.find((row) => row.wobble.seat === 0)?.wobble;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/hub.ts\",\"matches\":[{\"line_number\":21,\"content\":\"  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<HubInfo | null>;\"},{\"line_number\":191,\"content\":\"      const seat = index + 1;\"},{\"line_number\":194,\"content\":\"      packed.push(seat, show, ghost?.x ?? 0, ghost?.y ?? 0, ghost?.p ?? 0);\"},{\"line_number\":195,\"content\":\"      names[seat] = show ? (player.name ?? 'Guest') : '';\"},{\"line_number\":197,\"content\":\"      env.engine()?.ui?.hud(`ghost-${seat}`, hud, { at: 'top-left', color: player.color ?? '#3A4A55' });\"},{\"line_number\":199,\"content\":\"    for (let seat = others().length + 1; seat <= 3; seat += 1) env.engine()?.ui?.hud(`ghost-${seat}`, null);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/tilt.ts\",\"matches\":[{\"line_number\":73,\"content\":\"  const { body, seat } = apply(w, intents, { dx: wave, inst, noise: phase === 2 ? 1 : 0.4 });\"},{\"line_number\":94,\"content\":\"    if (seat.both) act.hold += 1;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/settings.ts\",\"matches\":[{\"line_number\":62,\"content\":\"  'game.pose.ring': num(0.2, 0.08, 0.45, '1', 'The seat ring a pose is held inside.'),\"},{\"line_number\":74,\"content\":\"  'game.cpu': num(1, 0, 1, '1', 'Empty Group Class seats take a CPU guest when this is 1.'),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/kit.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file Shared reading of a seat, the live tunables, and one call into the balance step.\"},{\"line_number\":9,\"content\":\"/** What one seat did this step. */\"},{\"line_number\":45,\"content\":\"/** Seat 0 reads the balance map. Later seats read `game:seats` in groups of four: x, y, fl, fr. */\"},{\"line_number\":46,\"content\":\"export function readSeat(intents: Intents, seat = 0): Seat {\"},{\"line_number\":47,\"content\":\"  const packed = (intents as Record<string, unknown>)['game:seats'];\"},{\"line_number\":48,\"content\":\"  if (seat > 0 && Array.isArray(packed)) {\"},{\"line_number\":50,\"content\":\"      const v = packed[seat * 4 + k];\"},{\"line_number\":109,\"content\":\"/** The wobble and its history for a seat. */\"},{\"line_number\":110,\"content\":\"export function rowOf(w: World, seat: number): { wobble: Wobble; hist: Hist } {\"},{\"line_number\":112,\"content\":\"  for (const row of rows) if (row.wobble.seat === seat && row.hist) return row;\"},{\"line_number\":113,\"content\":\"  throw new Error(`no seat ${seat}`);\"},{\"line_number\":122,\"content\":\"  seat?: number;\"},{\"line_number\":125,\"content\":\"/** One balance step for a seat, then the centre is remembered for a late thumb. */\"},{\"line_number\":126,\"content\":\"export function apply(w: World, intents: Intents, push: Push = {}): { body: Wobble; seat: Seat } {\"},{\"line_number\":127,\"content\":\"  const seatIndex = push.seat ?? 0;\"},{\"line_number\":128,\"content\":\"  const row = rowOf(w, seatIndex);\"},{\"line_number\":129,\"content\":\"  const seat = readSeat(intents, seatIndex);\"},{\"line_number\":132,\"content\":\"    x: seat.x,\"},{\"line_number\":133,\"content\":\"    y: seat.y,\"},{\"line_number\":134,\"content\":\"    gentle: seat.gentle,\"},{\"line_number\":135,\"content\":\"    both: seat.both,\"},{\"line_number\":136,\"content\":\"    mdx: seat.mdx * cfg.sens,\"},{\"line_number\":137,\"content\":\"    mdy: seat.mdy * cfg.sens,\"},{\"line_number\":145,\"content\":\"  return { body: row.wobble, seat };\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/group.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * The deal is drawn so the seed matters. Empty seats can hold a CPU guest. Your score is your own.\"},{\"line_number\":30,\"content\":\"    for (let seat = 1; seat <= 3; seat++) {\"},{\"line_number\":37,\"content\":\"          seat,\"},{\"line_number\":56,\"content\":\"/** A seat a real pad has claimed this step. Tests leave this unset, so the CPU still plays. */\"},{\"line_number\":57,\"content\":\"function claimed(intents: Intents, seat: number): boolean {\"},{\"line_number\":59,\"content\":\"  return Array.isArray(raw) && raw[seat] === 1;\"},{\"line_number\":62,\"content\":\"/** Steps the other mats. A claimed seat uses the pad. The rest stay CPU. They do not change your score. */\"},{\"line_number\":65,\"content\":\"  const given = (intents as Record<string, unknown>)['game:seats'];\"},{\"line_number\":67,\"content\":\"  for (let seat = 0; seat <= 3; seat++) packed.push(0, 0, 0, 0);\"},{\"li