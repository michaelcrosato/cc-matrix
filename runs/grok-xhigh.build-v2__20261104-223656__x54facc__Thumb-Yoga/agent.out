      t.readyMs,\\n        sitOut((s) => !s.ready),\\n      );\\n    }\\n    status();\\n  }\\n\\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\\n550→  function release() {\\n    if (released || phase !== 'loading') return;\\n    released = true;\\n    later(\\n      t.loadGraceMs,\\n      sitOut((s) => !s.ready),\\n    );\\n    status();\\n    settle();\\n  }\\n560→\\n  startRound();\\n\\n  return {\\n    receive,\\n    leave,\\n    release,\\n    /** Call time now, as the cap would: the host pressed \\\"End round\\\". */\\n    timeUp() {\\n      if (phase === 'countdown' || phase === 'playing') timeUp();\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/hub/round.js\",\"offset\":430,\"limit\":140,\"raw_output\":\"      issues: issues.slice(),\\n    };\\n    status();\\n    onEnd(record);\\n  }\\n\\n  function receive(key, msg) {\\n    const seat = byKey.get(key);\\n    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\\n    switch (msg.type) {\\n      case 'hello': {\\n        if (seat.hello) return;\\n        seat.hello = true;\\n        seat.caps = {\\n          v: msg.v,\\n          client: msg.client,\\n          mode: msg.mode ?? null,\\n          seats: msg.seats ?? null,\\n          card: msg.card === true,\\n        };\\n        if (msg.v !== 1) issue(seat, `hello speaks protocol ${JSON.stringify(msg.v)}, not 1`);\\n        const said = modeOf(msg.mode);\\n        if (!mode && said) mode = said;\\n        else if (msg.mode && said !== mode) issue(seat, `hello says mode ${msg.mode}, the round is ${mode}`);\\n        welcome(seat);\\n        status();\\n        return;\\n      }\\n      case 'ready':\\n        if (!seat.hello || seat.ready || phase !== 'loading') return;\\n        seat.ready = true;\\n        status();\\n        return