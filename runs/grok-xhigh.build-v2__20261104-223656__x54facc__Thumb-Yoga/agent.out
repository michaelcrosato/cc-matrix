er\":320,\"content\":\"  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\"},{\"line_number\":321,\"content\":\"  hub.ready = function () {\"},{\"line_number\":324,\"content\":\"    post('ready', {});\"},{\"line_number\":327,\"content\":\"  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\"},{\"line_number\":330,\"content\":\"    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"cc0157a7-5b5b-41ba-8a61-0db787891201"}
