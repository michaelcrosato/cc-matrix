↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join(';