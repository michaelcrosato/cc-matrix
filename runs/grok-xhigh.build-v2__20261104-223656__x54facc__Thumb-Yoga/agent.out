104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,95,95,120,53,52,102,97,99,99,47,119,111,114,107,47,84,104,117,109,98,32,89,111,103,97,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,47,101,110,103,105,110,101,47,97,110,105,109,47,114,97,103,100,111,108,108,46,116,115,10,49,57,58,32,42,32,40,96,108,121,105,110,103,79,102,96,32,105,116,115,32,99,104,101,115,116,44,32,115,111,32,96,82,101,97,99,116,105,111,110,115,46,103,101,116,85,112,96,32,112,105,99,107,115,32,116,104,101,32,103,101,116,45,117,112,41,44,32,97,110,100,32,119,104,101,114,101,32,116,104,101,32,104,117,109,97,110,111,105,100,32,108,121,105,110,103,32,116,104,101,32,115,97,109,101,32,119,97,121,32,112,117,116,115,32,105,116,115,10,51,56,58,105,109,112,111,114,116,32,123,32,108,121,105,110,103,79,102,44,32,82,101,97,99,116,105,111,110,115,44,32,116,121,112,101,32,76,121,105,110,103,32,125,32,102,114,111,109,32,39,46,47,114,101,97,99,116,105,111,110,115,39,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":40,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/anim/actions-check.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file An action's check (PLAN.md WP 8.7): `actionCheck` turns an action's `check` (actions-data.ts `ACTION_FIELDS`)\"},{\"line_number\":5,\"content\":\" * action of data/anim/actions/ by it. Split from actions.ts to keep each under 400 lines (ADR-0014 amendment 16).\"},{\"line_number\":8,\"content\":\" * import { defineAction } from './actions-data';\"},{\"line_number\":14,\"content\":\" * @see engine/anim/actions.test.ts\"},{\"line_