t down (a key, a mouse button, a wheel notch): pressed at the next sample, even if up by then. */\\n  press(code: string, device: DeviceKind): void;\\n  /** A digital code went up. */\\n  release(code: string): void;\\n  /** An analog code's strength now, 0 to 1 (a trigger, a stick direction); `press` and `release` say when it is held. */\\n  analog(code: string, value: number): void;\\n  /** The device was used without a press (a stick pushed, the mouse moved): prompts follow it. */\\n  used(device: DeviceKind): void;\\n  /** Whether an action binds `code`: a bound key's default (Space scrolling the page) is prevented. */\\n  bound(code: string): boolean;\\n}\\n\\n/** A gamepad family, for labels. */\\nexport type PadStyle = 'xbox' | 'playstation' | 'nintendo';\\n\\n/** The W3C standard gamepad buttons by index, named by position. */\\nexport const PAD_BUTTONS = [\\n  'PadSouth',\\n  'PadEast',\\n  'PadWest',\\n  'PadNorth',\\n  'PadLeftShoulder',\\n  'PadRightShoulder',\\n  'PadLeftTrigger',\\n  'PadRightTrigger',\\n  'PadSelect',\\n  'PadStart',\\n  'PadLeftStick',\\n  'PadRightStick',\\n  'PadUp',\\n  'PadDown',\\n  'PadLeft',\\n  'PadRight',\\n  'PadHome',\\n] as const;\\n\\n/** The stick directions, each a code whose strength is how far the stick leans that way (after the deadzone). */\\nexport const PAD_STICKS = [\\n  'PadLeftStickUp',\\n  'PadLeftStickDown',\\n  'PadLeftStickLeft',\\n  'PadLeftStickRight',\\n  'PadRightStickUp',\\n  'PadRightStickDown',\\n  'PadRightStickLeft',\\n  'PadRightStickRight',\\n] as const;\\n\\n\",\"total_lines\":209}}","is_error":false},{"type":"tool_result","tool_use_id":"call-27450ea2-a8e9-4863-bff3-9717a69b4458-149","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,