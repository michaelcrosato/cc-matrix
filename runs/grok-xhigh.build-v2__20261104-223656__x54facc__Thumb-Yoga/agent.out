(5) });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/retreat.test.ts\",\"matches\":[{\"line_number\":17,\"content\":\"import { freshSave, noteProgress } from './ui/save';\"},{\"line_number\":242,\"content\":\"    const next = noteProgress(freshSave(), {\"},{\"line_number\":255,\"content\":\"    const kept = noteProgress(next, {\"},{\"line_number\":270,\"content\":\"    menu('game.finish');\"},{\"line_number\":276,\"content\":\"    expect(noteProgress(freshSave(), snap).prior).toBe(0);\"},{\"line_number\":278,\"content\":\"    menu('game.finish');\"},{\"line_number\":286,\"content\":\"    expect(noteProgress(freshSave(), again).prior).toBe(82);\"},{\"line_number\":287,\"content\":\"    menu('game.begin', { day: 1, cursor: 0, age: 40, prior: 82 });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts\",\"matches\":[{\"line_number\":21,\"content\":\"import { freshPrefs, freshSave, noteProgress, readSave, writeSave, type Prefs } from './save';\"},{\"line_number\":149,\"content\":\"    writeSave(store, save);\"},{\"line_number\":497,\"content\":\"    save = { ...noteProgress(save, snap), settings: { ...prefs, icons } };\"},{\"line_number\":504,\"content\":\"      writeSave(store, save);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"matches\":[{\"line_number\":299,\"content\":\"  'game.begin': (w: World, args: unknown) => {\"},{\"line_number\":324,\"content\":\"  'game.leave': (w: World) => {\"},{\"line_number\":331,\"content\":\"  'game.jump': (w: World, args: unknown) => {\"},{\"line_number\":354,\"content\":\"  'game.finish': (w: World, args: unknown) => {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-x