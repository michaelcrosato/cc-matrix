/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/ui/state.ts\",\"matches\":[{\"line_number\":82,\"content\":\"  return { size, touch: root.ownerDocument.documentElement.classList.contains('touch'), elements };\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/input/codes.ts\",\"matches\":[{\"line_number\":38,\"content\":\"export type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\"},{\"line_number\":142,\"content\":\"  if (code.startsWith(TOUCH_PREFIX)) return 'touch';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/ui/chrome.ts\",\"matches\":[{\"line_number\":75,\"content\":\"      document.documentElement.classList.toggle('touch', on);\"},{\"line_number\":92,\"content\":\"      document.documentElement.classList.remove('touch');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/input/input.ts\",\"matches\":[{\"line_number\":206,\"content\":\"      const family = kind === 'gamepad' ? 'gamepad' : kind === 'touch' ? 'touch' : 'keyboard';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/input/devices/touch.ts\",\"matches\":[{\"line_number\":211,\"content\":\"    if (owner === 'button' && !hold) sink.press(touchCode(finger.name), 'touch');\"},{\"line_number\":212,\"content\":\"    else sink.used('touch');\"},{\"line_number\":238,\"content\":\"    sink.used('touch');\"},{\"line_number\":255,\"content\":\"        sink.press(code, 'touch');\"},{\"line_number\":281,\"content\":\"          sink.press(touchCode(finger.name), 'touch');\"}]},{\"path\":\"/home/micha/dev/cc-matri