t.length || pending[type]) {\\n      (pending[type] = pending[type] || []).push(args);\\n      return;\\n    }\\n    for (var i = 0; i < list.length; i++) {\\n      try {\\n        list[i].apply(null, args);\\n      } catch (e) {\\n        setTimeout(function () {\\n          throw e;\\n        });\\n      }\\n    }\\n  }\\n\\n  function onMessage(event) {\\n    if (event.source !== root.parent) return;\\n    var m = event.data;\\n    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\\n    if (m.type === 'welcome') {\\n      if (welcomed) return;\\n      welcomed = true;\\n      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\\n      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\\n      for (var key in m) {\\n        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\\n        hub[key] = m[key];\\n      }\\n      hub.players = (m.players || []).slice();\\n      hub.seed = m.seed >>> 0;\\n      hub.isHost = m.me === m.host;\\n      hub.splash = m.splash === true;\\n      if (m.limits) {\\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\\n        tokens = limits.burst;\\n      }\\n      if (connecting) connecting.resolve(info());\\n      return;\\n    }\\n    if (m.type === 'fullscreen') {\\n      fullscreenOn = m.on === true;\\n      try {\\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\\n      } catch (e) {}\\n      return;\\n    }\\n    if (!welcomed || ended) return;\\n    if (m.type === 'start') {\\n      goAt = now() + Number(m.in || 0);\\n      emit('start', [{ in: Number(m.in || 0) }]);\\n    } else if (m.type === 'message') {\\n      emit('message', [m.data, m.from]);\\n    } else if (m.type === 'leave') {\\n      hub.players = hub.players.filter(function (p) {\\n        return p.id !== m.id;\\n      });\\n      emit('leave', [{ id: m.id, reason: m.reason }]);\\n    } else if (m.type === 'time-up') {\\n      emit('time-up', [{ graceMs: m.graceMs }]);\\n    } else if (m.type === 'end') {\\n      ended = true;\\n      if (progressTimer) clearTimeout(progressTimer);\\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\\n    } else {\\n      // An event this client has never heard of: hand it on as it came.\\n      var detail = {};\\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\\n      emit(m.type, [detail]);\\n    }\\n  }\\n\\n  function info() {\\n    var out = {};\\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\\n    out.players = hub.players.slice();\\n    return out;\\n  }\\n\\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\\n  hub.connect = function (opts) {\\n    if (connecting) return connecting.promise;\\n    var done;\\n    var promise = new Promise(function (resolve) {\\n      done = resolve;\\n    });\\n    connecting = { promise: promise, resolve: done };\\n    if (!hub.active) {\\n      done(null);\\n\",\"total_lines\":488}}","is_error":false},{"type":"tool_result","tool_use_id":"call-86b1cfbd-65ba-4eb6-89e8-304cd80ec8ce-86","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,95,95,120,53,52,102,97,99,99,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,95,95,120,53,52,102,97,99,99,47,119,111,114,107,47,84,104,117,109,98,32,89,111,103,97,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,51,54,53,54,47,108,97,98,115,47,103,97,109,101,47,97,117,100,105,111,47,118,111,105,99,101,46,116,115,10,49,49,50,58,101,120,112,111,114,116,32,102,117,110,99,116,105,111,110,32,115,112,101,97,107,101,114,70,111,114,40,105,100,58,32,115,116,114,105,110,103,41,58,32,83,112,101,97,107,101,114,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":1,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/audio/voice.ts\",\"matches\":[{\"line_number\":112,\"content\":\"export function speakerFor(id: string): Speaker {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-86b1cfbd-65ba-4eb6-89e8-304cd80ec8ce-87","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\\n * §6.10, WPs 0.2 and 0.12).\\n *\\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\\n10→ * tools/lib/tiers.ts's `T1_FULL` names.\\n *\\n * The build (`npm run build`) writes dist/ from the landing page (the root's\\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\\n * ships only what it imports, never a `fetch()` of a repository path (§6.3). Nothing here needs the network, a\\n * browser, the source checkouts or an `x` command: the build and Vitest both read this file. The one-file\\n * playground (playground.html, tools/lib/oneFile.ts) is built apart, with this file's alias. The reference to\\n * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\\n * the tests' project, which sees this file through it, knows `config.test` (Vitest 4's main types no longer add it).\\n20→ *\\n * @see tools/lib/vite.test.ts\\n */\\n/// <reference types=\\\"vitest/config\\\" preserve=\\\"true\\\" />\\nimport { existsSync, globSync } from 'node:fs';\\nimport { availableParallelism } from 'node:os';\\nimport { dirname, join } from 'node:path';\\nimport { defineConfig } from 'vite';\\nimport { vitestRerunTriggers } from './tools/lib/tiers';\\n\\n30→/** The dev server's port: `$PORT` (each ultracode lane sets its own), else 5173. */\\nconst PORT = Number(process.env.PORT) || 5173;\\n\\n/** The repository root: this file's directory. */\\nconst ROOT = import.meta.dirname;\\n\\n/** Whether this is a game made from the engine (tools/game/new-game.mjs), not the engine's own repository. */\\nconst GAME = existsSync(join(ROOT, 'engine-lock.json'));\\n\\n/** The pages a build ships, as absolute paths by entry name: `index` (the landing page), then `labs/<name>`. */\\n40→const PAGES = Object.fromEntries(\",\"content_concise\":\"1→/**\\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\\n * §6.10, WPs 0.2 and 0.12).\\n *\\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\\n10→ * tools/lib/tiers.ts's `T1_FULL` names.\\n *\\n * The build (`npm run build`) writes dist/ from the landing page (the root's\\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\\n * ships only what it imports, never a `fetch()` of a repository path (§6.3). Nothing here needs the network, a\\n * browser, the source checkouts or an `x` command: the build and Vitest both read this file. The one-file\\n * playground (playground.html, tools/lib/oneFile.ts) is built apart, with this file's alias. The reference to\\n * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\\n * the tests' project, which sees this file through it, knows `config.test` (Vitest 4's main types no longer add it).\\n20→ *\\n * @see tools/lib/vite.test.ts\\n */\\n/// <reference types=\\\"vitest/config\\\" preserve=\\\"true\\\" />\\nimport { existsSync, globSync } from 'node:fs';\\nimport { availableParallelism } from 'node:os';\\nimport { dirname, join } from 'node:path';\\nimport { defineConfig } from 'vite';\\nimport { vitestRerunTriggers } from './tools/lib/tiers';\\n\\n30→/** The dev server's port: `$PORT` (each ultracode lane sets its own), else 5173. */\\nconst PORT = Number(process.env.PORT) || 5173;\\n\\n/** The repository root: this file's directory. */\\nconst ROOT = import.meta.dirname;\\n\\n/** Whether this is a game made from the engine (tools/game/new-game.mjs), not the engine's own repository. */\\nconst GAME = existsSync(join(ROOT, 'engine-lock.json'));\\n\\n/** The pages a build ships, as absolute paths by entry name: `index` (the landing page), then `labs/<name>`. */\\n40→const PAGES = Object.fromEntries(\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/vite.config.ts\",\"offset\":null,\"limit\":40,\"raw_output\":\"/**\\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\\n * §6.10, WPs 0.2 and 0.12).\\n *\\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\\n * tools/lib/tiers.ts's `T1_FULL` names.\\n *\\n * The build (`npm run build`) writes dist/ from the landing page (the root's\\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\\n * ships only what it imports, never a `fetch()` of a repository path (§6.3). Nothing here needs the network, a\\n * browser, the source checkouts or an `x` command: the build and Vitest both read this file. The one-file\\n * playground (playground.html, tools/lib/oneFile.ts) is built apart, with this file's alias. The reference to\\n * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\\n * the tests' project, which sees this file through it, knows `config.test` (Vitest 4's main types no longer add it).\\n *\\n * @see tools/lib/vite.test.ts\\n */\\n/// <reference types=\\\"vitest/config\\\" preserve=\\\"true\\\" />\\nimport { existsSync, globSync } from 'node:fs';\\nimport { availableParallelism } from 'node:os';\\nimport { dirname, join } from 'node:path';\\nimport { defineConfig } from 'vite';\\nimport { vitestRerunTriggers } from './tools/lib/tiers';\\n\\n/** The dev server's port: `$PORT` (each ultracode lane sets its own), else 5173. */\\nconst PORT = Number(process.env.PORT) || 5173;\\n\\n/** The repository root: this file's directory. */\\nconst ROOT = import.meta.dirname;\\n\\n/** Whether this is a game made from the engine (tools/game/new-game.mjs), not the engine's own repository. */\\nconst GAME = existsSync(join(ROOT, 'engine-lock.json'));\\n\\n/** The pages a build ships, as absolute paths by entry name: `index` (the landing page), then `labs/<name>`. */\\nconst PAGES = Object.fromEntries(\\n\",\"total_lines\":101}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"f2e5b88f-4c14-44ed-b2cf-24109c0392c0"}
{"type":"assistant","message":{"id":"msg_406","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I have a clear implementation plan.\n\nI'll add a CSS override in index.html to force widget font sizes to at least 28px. Menus will be capped at six rows. About screen text must also remain readable.\n\nTouch settings button visibility is confirmed. Touch devices show the button when armed and not on touch screen. Tapping settings or attract mode keeps the button visible. Canvas taps will not exit attract mode.\n\nOpening settings during attract mode preserves the settings screen. The idle timeout also excludes settings, about, controls, programme, title, and touch from triggering attract mode.\n\nStarting attract mode while settings is open leaves the menu visible. The demo may run underneath it. I need to check how modal() drops intents and whether the scene step still runs with empty intents.\n\nThe engine drops intents when modal is true, but the driver replaces them with the attract bot before stepping. The demo therefore runs correctly even under an open menu. Title mode remains inactive until attract starts and sets auto.\n\nseed() restarts the scene and returns immediately, so the attract demo begins on the next frame. exitAttract reseeds back to title and shows the title screen. Save operations are blocked during attract mode.\n\nI found a bug in the music selection logic. The `songFor` function currently returns the lobby song for attract mode before checking event songs, which prevents activities from playing their own music during the demo. I need to reorder the checks so event songs take precedence over the attract flag.\n\nThe `songFor` function now checks event songs before the attract flag. Pose activities will play stillness music during attract mode. Tilt storm and dawn events are handled separately.\n\nI traced the driver attract logic. It starts pose-a and finishes the activity at tick 15*60. Then it advances to results and sleeps. The demo walks through the programme in sequence.","signature":""},{"type":"tool_use","id":"call-b38c5661-78ea-41c2-b5e5-517460f4ac57-88","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts","offset":1,"limit":250}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2414,"output_tokens":1481,"cache_read_input_tokens":125184,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"6fb8a689-2df7-4b1f-8b2f-212a97772466"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-b38c5661-78ea-41c2-b5e5-517460f4ac57-88","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\\n * that stands in for a player when `game.auto` is director or attract. Menus arrive as scene actions.\\n */\\nimport type { Intents, World } from '../../../engine/sim-api';\\nimport './settings';\\nimport { activityById, findActivity } from './catalog';\\nimport { programme, type ProgrammeItem } from './data/days';\\nimport { actOf, flowOf, rowOf } from './events/kit';\\n10→import { clampScore, pebblesOf, rankOf, wobbleAge } from './score';\\nimport { type Act, type Flow, type Island, emptyAct, part, resetAct, visit } from './state';\\nimport { drawSway, resetBalance } from './wobble';\\n\\n/** How long a result or an evening stays up when the director is walking. */\\nconst BEAT = 45;\\n\\n/** Attract shows each slice for about fifteen seconds, then the next. */\\nconst SLICE = 15 * 60;\\n\\n20→/** The demo loop. The Great Tilt slice opens on the centre stone. */\\nconst SLICES = ['pose-a', 'pond', 'line', 'paddle', 'garden', 'tilt'];\\n\\n/** A rank a dev jump can stamp without playing the hold. */\\nconst RANK_SCORE: Readonly<Record<string, number>> = {\\n  Present: 0,\\n  Adequate: 300,\\n  Composed: 550,\\n  Serene: 750,\\n  Unsettling: 900,\\n30→};\\n\\n/** The island lean. */\\nfunction islandOf(w: World): Island {\\n  return part<Island>(w, 'island');\\n}\\n\\n/** A plain object of action arguments, or an empty one. */\\nfunction rec(args: unknown): Record<string, unknown> {\\n  if (typeof args === 'object' && args !== null && !Array.isArray(args)) return args as Record<string, unknown>;\\n40→  return {};\\n}\\n\\n/** A finite number argument. */\\nfunction numArg(args: Record<string, unknown>, key: string): number | undefined {\\n  const value = args[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\\n}\\n\\n/** A string argument. */\\n50→function strArg(args: Record<string, unknown>, key: string): string | undefined {\\n  const value = args[key];\\n  return typeof value === 'string' ? value : undefined;\\n}\\n\\n/** Who is driving this step. */\\nfunction autoOf(w: World): string {\\n  return String(w.settings.get('game.auto'));\\n}\\n\\n60→/** Story lean for a residency day. Day 1 is 0.4 degrees, and each day adds half a degree. */\\nfunction leanFor(day: number): number {\\n  return 0.4 + 0.5 * (day - 1);\\n}\\n\\n/** Writes the day's lean onto the island. The mesh does not move. */\\nfunction applyLean(w: World, day: number): void {\\n  const island = islandOf(w);\\n  const base = leanFor(day);\\n  island.base = base;\\n70→  island.tiltX = base;\\n  island.tiltZ = 0;\\n}\\n\\n/** Starts one activity. Setup runs now, so its spawned guests exist before the next step. */\\nexport function startEvent(w: World, id: string): void {\\n  const flow = flowOf(w);\\n  const previous = findActivity(flow.event);\\n  if (previous && flow.mode === 'event') previous.teardown(w);\\n  const activity = activityById(id);\\n80→  const act = actOf(w);\\n  resetAct(act);\\n  const row = rowOf(w, 0);\\n  resetBalance(row.wobble, row.hist);\\n  flow.mode = 'event';\\n  flow.event = id;\\n  visit(flow, id);\\n  if (id.startsWith('pose')) visit(flow, 'pose');\\n  activity.setup(w);\\n}\\n90→\\n/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\\nfunction finishEvent(w: World, rank?: string): void {\\n  const flow = flowOf(w);\\n  const activity = activityById(flow.event);\\n  let value = activity.score(w);\\n  activity.teardown(w);\\n  if (rank !== undefined && Object.hasOwn(RANK_SCORE, rank)) value = RANK_SCORE[rank] ?? value;\\n  value = clampScore(value);\\n  flow.result = value;\\n100→  flow.rank = rank !== undefined && Object.hasOwn(RANK_SCORE, rank) ? rank : rankOf(value);\\n  const auto = autoOf(w);\\n  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\\n  if (flow.event === 'morning') {\\n    flow.prior = flow.age;\\n    flow.age = wobbleAge(value / 1000, Number(w.settings.get('game.age.k')));\\n  }\\n  const act = actOf(w);\\n  act.done = 0;\\n  act.wait = 0;\\n110→  if (auto === 'attract') {\\n    const at = SLICES.indexOf(flow.event);\\n    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\\n    return;\\n  }\\n  flow.mode = 'results';\\n}\\n\\n/** The next programme row, when the one that just finished is the row the cursor is on. */\\nfunction advance(w: World): void {\\n120→  const flow = flowOf(w);\\n  const list = programme();\\n  const here = list[flow.cursor];\\n  if (!here || here.event !== flow.event) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.cursor += 1;\\n  openItem(w, list[flow.cursor]);\\n130→}\\n\\n/** Opens a programme row: an activity, the evening, or the credits. */\\nfunction openItem(w: World, item: ProgrammeItem | undefined): void {\\n  const flow = flowOf(w);\\n  if (!item) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n140→  flow.day = item.day;\\n  if (item.event === 'evening') openEvening(w);\\n  else if (item.event === 'credits') openCredits(w);\\n  else startEvent(w, item.event);\\n}\\n\\n/** The stamp at the end of a day. */\\nfunction openEvening(w: World): void {\\n  const flow = flowOf(w);\\n  const act = actOf(w);\\n150→  resetAct(act);\\n  flow.mode = 'evening';\\n  flow.event = 'evening';\\n  flow.line = 'evening.close';\\n  visit(flow, 'evening');\\n}\\n\\n/** The credits. The ferry does not come back. Free play stays available. */\\nfunction openCredits(w: World): void {\\n  const flow = flowOf(w);\\n160→  resetAct(actOf(w));\\n  flow.mode = 'credits';\\n  flow.event = 'credits';\\n  flow.credits = 1;\\n  flow.line = 'credits.roll';\\n  visit(flow, 'credits');\\n}\\n\\n/** Leaves the evening for the next morning, and leans the island a little more. */\\nfunction sleep(w: World): void {\\n170→  const flow = flowOf(w);\\n  const list = programme();\\n  if (list[flow.cursor]?.event === 'evening') flow.cursor += 1;\\n  const next = list[flow.cursor];\\n  if (!next) {\\n    openCredits(w);\\n    return;\\n  }\\n  flow.day = next.day;\\n  applyLean(w, next.day);\\n180→  if (next.event === 'credits') openCredits(w);\\n  else if (next.event === 'evening') openEvening(w);\\n  else startEvent(w, next.event);\\n}\\n\\n/** Puts the finale on a named step. Storm is where the activity already starts. */\\nfunction jumpTilt(w: World, step: string): void {\\n  startEvent(w, 'tilt');\\n  const act: Act = actOf(w);\\n  const flow: Flow = flowOf(w);\\n190→  const name = step.startsWith('tilt:') ? step : `tilt:${step}`;\\n  if (name === 'tilt:east') {\\n    act.phase = 1;\\n    act.a = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.east';\\n    visit(flow, 'tilt:east');\\n  } else if (name === 'tilt:stone') {\\n    act.phase = 2;\\n    act.a = 1;\\n200→    act.b = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.stone';\\n    visit(flow, 'tilt:east');\\n    visit(flow, 'tilt:stone');\\n  } else if (name === 'tilt:dawn') {\\n    act.phase = 3;\\n    act.a = 1;\\n    act.b = 1;\\n    act.c = 1;\\n210→    act.hz = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.dawn';\\n    visit(flow, 'tilt:east');\\n    visit(flow, 'tilt:stone');\\n    visit(flow, 'tilt:dawn');\\n  }\\n}\\n\\n/** Copies a save the page handed in. The sim never reads the store itself. */\\n220→function applySave(w: World, args: Record<string, unknown>): void {\\n  const flow = flowOf(w);\\n  const day = numArg(args, 'day');\\n  const cursor = numArg(args, 'cursor');\\n  const pebbles = numArg(args, 'pebbles');\\n  const age = numArg(args, 'age');\\n  const prior = numArg(args, 'prior');\\n  const credits = numArg(args, 'credits');\\n  const result = numArg(args, 'result');\\n  const seen = strArg(args, 'seen');\\n230→  const rank = strArg(args, 'rank');\\n  if (day !== undefined) flow.day = day;\\n  if (cursor !== undefined) flow.cursor = cursor;\\n  if (pebbles !== undefined) flow.pebbles = pebbles;\\n  if (age !== undefined) flow.age = age;\\n  if (prior !== undefined) flow.prior = prior;\\n  if (credits !== undefined) flow.credits = credits;\\n  if (result !== undefined) flow.result = result;\\n  if (seen !== undefined) flow.seen = seen;\\n  if (rank !== undefined) flow.rank = rank;\\n240→}\\n\\n/** One seat, the day, and the island. The first step starts a director or a demo. */\\nexport function boot(w: World): void {\\n  drawSway(w);\\n  w.spawn({\\n    flow: { mode: 'title', day: 1 },\\n    act: emptyAct(),\\n    island: { tiltX: 0.4, tiltZ: 0, base: 0.4 },\\n  });\\n250→}\",\"content_concise\":\"1→/**\\n * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\\n * that stands in for a player when `game.auto` is director or attract. Menus arrive as scene actions.\\n */\\nimport type { Intents, World } from '../../../engine/sim-api';\\nimport './settings';\\nimport { activityById, findActivity } from './catalog';\\nimport { programme, type ProgrammeItem } from './data/days';\\nimport { actOf, flowOf, rowOf } from './events/kit';\\n10→import { clampScore, pebblesOf, rankOf, wobbleAge } from './score';\\nimport { type Act, type Flow, type Island, emptyAct, part, resetAct, visit } from './state';\\nimport { drawSway, resetBalance } from './wobble';\\n\\n/** How long a result or an evening stays up when the director is walking. */\\nconst BEAT = 45;\\n\\n/** Attract shows each slice for about fifteen seconds, then the next. */\\nconst SLICE = 15 * 60;\\n\\n20→/** The demo loop. The Great Tilt slice opens on the centre stone. */\\nconst SLICES = ['pose-a', 'pond', 'line', 'paddle', 'garden', 'tilt'];\\n\\n/** A rank a dev jump can stamp without playing the hold. */\\nconst RANK_SCORE: Readonly<Record<string, number>> = {\\n  Present: 0,\\n  Adequate: 300,\\n  Composed: 550,\\n  Serene: 750,\\n  Unsettling: 900,\\n30→};\\n\\n/** The island lean. */\\nfunction islandOf(w: World): Island {\\n  return part<Island>(w, 'island');\\n}\\n\\n/** A plain object of action arguments, or an empty one. */\\nfunction rec(args: unknown): Record<string, unknown> {\\n  if (typeof args === 'object' && args !== null && !Array.isArray(args)) return args as Record<string, unknown>;\\n40→  return {};\\n}\\n\\n/** A finite number argument. */\\nfunction numArg(args: Record<string, unknown>, key: string): number | undefined {\\n  const value = args[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\\n}\\n\\n/** A string argument. */\\n50→function strArg(args: Record<string, unknown>, key: string): string | undefined {\\n  const value = args[key];\\n  return typeof value === 'string' ? value : undefined;\\n}\\n\\n/** Who is driving this step. */\\nfunction autoOf(w: World): string {\\n  return String(w.settings.get('game.auto'));\\n}\\n\\n60→/** Story lean for a residency day. Day 1 is 0.4 degrees, and each day adds half a degree. */\\nfunction leanFor(day: number): number {\\n  return 0.4 + 0.5 * (day - 1);\\n}\\n\\n/** Writes the day's lean onto the island. The mesh does not move. */\\nfunction applyLean(w: World, day: number): void {\\n  const island = islandOf(w);\\n  const base = leanFor(day);\\n  island.base = base;\\n70→  island.tiltX = base;\\n  island.tiltZ = 0;\\n}\\n\\n/** Starts one activity. Setup runs now, so its spawned guests exist before the next step. */\\nexport function startEvent(w: World, id: string): void {\\n  const flow = flowOf(w);\\n  const previous = findActivity(flow.event);\\n  if (previous && flow.mode === 'event') previous.teardown(w);\\n  const activity = activityById(id);\\n80→  const act = actOf(w);\\n  resetAct(act);\\n  const row = rowOf(w, 0);\\n  resetBalance(row.wobble, row.hist);\\n  flow.mode = 'event';\\n  flow.event = id;\\n  visit(flow, id);\\n  if (id.startsWith('pose')) visit(flow, 'pose');\\n  activity.setup(w);\\n}\\n90→\\n/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\\nfunction finishEvent(w: World, rank?: string): void {\\n  const flow = flowOf(w);\\n  const activity = activityById(flow.event);\\n  let value = activity.score(w);\\n  activity.teardown(w);\\n  if (rank !== undefined && Object.hasOwn(RANK_SCORE, rank)) value = RANK_SCORE[rank] ?? value;\\n  value = clampScore(value);\\n  flow.result = value;\\n100→  flow.rank = rank !== undefined && Object.hasOwn(RANK_SCORE, rank) ? rank : rankOf(value);\\n  const auto = autoOf(w);\\n  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\\n  if (flow.event === 'morning') {\\n    flow.prior = flow.age;\\n    flow.age = wobbleAge(value / 1000, Number(w.settings.get('game.age.k')));\\n  }\\n  const act = actOf(w);\\n  act.done = 0;\\n  act.wait = 0;\\n110→  if (auto === 'attract') {\\n    const at = SLICES.indexOf(flow.event);\\n    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\\n    return;\\n  }\\n  flow.mode = 'results';\\n}\\n\\n/** The next programme row, when the one that just finished is the row the cursor is on. */\\nfunction advance(w: World): void {\\n120→  const flow = flowOf(w);\\n  const list = programme();\\n  const here = list[flow.cursor];\\n  if (!here || here.event !== flow.event) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.cursor += 1;\\n  openItem(w, list[flow.cursor]);\\n130→}\\n\\n/** Opens a programme row: an activity, the evening, or the credits. */\\nfunction openItem(w: World, item: ProgrammeItem | undefined): void {\\n  const flow = flowOf(w);\\n  if (!item) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n140→  flow.day = item.day;\\n  if (item.event === 'evening') openEvening(w);\\n  else if (item.event === 'credits') openCredits(w);\\n  else startEvent(w, item.event);\\n}\\n\\n/** The stamp at the end of a day. */\\nfunction openEvening(w: World): void {\\n  const flow = flowOf(w);\\n  const act = actOf(w);\\n150→  resetAct(act);\\n  flow.mode = 'evening';\\n  flow.event = 'evening';\\n  flow.line = 'evening.close';\\n  visit(flow, 'evening');\\n}\\n\\n/** The credits. The ferry does not come back. Free play stays available. */\\nfunction openCredits(w: World): void {\\n  const flow = flowOf(w);\\n160→  resetAct(actOf(w));\\n  flow.mode = 'credits';\\n  flow.event = 'credits';\\n  flow.credits = 1;\\n  flow.line = 'credits.roll';\\n  visit(flow, 'credits');\\n}\\n\\n/** Leaves the evening for the next morning, and leans the island a little more. */\\nfunction sleep(w: World): void {\\n170→  const flow = flowOf(w);\\n  const list = programme();\\n  if (list[flow.cursor]?.event === 'evening') flow.cursor += 1;\\n  const next = list[flow.cursor];\\n  if (!next) {\\n    openCredits(w);\\n    return;\\n  }\\n  flow.day = next.day;\\n  applyLean(w, next.day);\\n180→  if (next.event === 'credits') openCredits(w);\\n  else if (next.event === 'evening') openEvening(w);\\n  else startEvent(w, next.event);\\n}\\n\\n/** Puts the finale on a named step. Storm is where the activity already starts. */\\nfunction jumpTilt(w: World, step: string): void {\\n  startEvent(w, 'tilt');\\n  const act: Act = actOf(w);\\n  const flow: Flow = flowOf(w);\\n190→  const name = step.startsWith('tilt:') ? step : `tilt:${step}`;\\n  if (name === 'tilt:east') {\\n    act.phase = 1;\\n    act.a = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.east';\\n    visit(flow, 'tilt:east');\\n  } else if (name === 'tilt:stone') {\\n    act.phase = 2;\\n    act.a = 1;\\n200→    act.b = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.stone';\\n    visit(flow, 'tilt:east');\\n    visit(flow, 'tilt:stone');\\n  } else if (name === 'tilt:dawn') {\\n   