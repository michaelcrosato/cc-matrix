nst ghosts = new Map<number, GhostLean>();\"},{\"line_number\":140,\"content\":\"    ghosts.set(from, { x: row.x ?? 0, y: row.y ?? 0, p: row.p ?? 0, e: row.e ?? 0 });\"},{\"line_number\":144,\"content\":\"    if (typeof id === 'number') ghosts.delete(id);\"},{\"line_number\":200,\"content\":\"      const ghost = ghosts.get(player.id);\"},{\"line_number\":201,\"content\":\"      const show = ghost && ghost.e === snap.phase ? 1 : 0;\"},{\"line_number\":202,\"content\":\"      packed.push(seat, show, ghost?.x ?? 0, ghost?.y ?? 0, ghost?.p ?? 0);\"},{\"line_number\":205,\"content\":\"      env.engine()?.ui?.hud(`ghost-${seat}`, hud, { at: 'top-left', color: player.color ?? '#3A4A55' });\"},{\"line_number\":207,\"content\":\"    for (let seat = others().length + 1; seat <= 3; seat += 1) env.engine()?.ui?.hud(`ghost-${seat}`, null);\"},{\"line_number\":208,\"content\":\"    input.virtual.axis('game:ghosts', packed.length > 0 ? packed : null);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"47b53844-7c11-479d-91c7-ca983ae2df80"}
