erver.shutdown()\n    finally:\n        browser.close()\ndata = json.loads(lines[1])\nprint(\"pass\", data[\"pass\"])\nfor c in data[\"checks\"]:\n    if not c[\"pass\"]:\n        print(\"FAIL\", c[\"name\"], \"—\", str(c[\"detail\"])[:240])\nfor row in data[\"log\"]:\n    if \"ready\" in row or \"hello\" in row or \"card\" in row and \"answers\" in row:\n        print(row)\nfor i,g in enumerate(data[\"ghosts\"]):\n    print(\"iframe\", i, \"ready\", g[\"ready\"], \"errors\", g[\"errors\"], \"ghosts\", g[\"ghosts\"])\nprint(\"0 failures\" if not fails else f\"{len(fails)} failures\")\nPY","description":"Confirm 4-player ready arrives inside 20s","block_until_ms":120000}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":546,"output_tokens":695,"cache_read_input_tokens":174080,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"c52312b3-e74d-4299-a597-266042893070"}
