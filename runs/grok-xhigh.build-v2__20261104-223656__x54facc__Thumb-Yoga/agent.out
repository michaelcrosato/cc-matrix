ind(style)}</style>`;\\n  const code = find(script).replaceAll('</script', '<\\\\\\\\/script');\\n  if (code.includes('<!--')) throw new Error(`${script} holds \\\"<!--\\\": write it apart in the source`);\\n  return `<script type=\\\"module\\\">${code}</script>`;\\n});\\nconst client = readFileSync('labs/game/hub/session-client.txt', 'utf8');\\nconst tags = readFileSync('labs/game/hub/tags.html', 'utf8');\\nwriteFileSync(\\n  resolve(process.argv[2]),\\n  inlined.replace('<meta charset=\\\"utf-8\\\" />', () => `<meta charset=\\\"utf-8\\\" />\\\\n<script>\\\\n${client}</script>\\\\n${tags}`),\\n);\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/onefile.mjs has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/onefile.mjs has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/tools/onefile.mjs\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/**\\n * @file Inlines the game page, the session client, and the hub tags into one HTML file.\\n * The client is copied as text. A function replacement keeps `$` in the bundle intact.\\n */\\nimport { readFileSync, writeFileSync } from 'node:fs';\\nimport { join, resolve } from 'node:path';\\nimport { build } from 'vite';\\n\\nconst root = process.cwd();\\nconst result = await build({\\n  root,\\n  configFile: false,\\n  logLevel: 'warn',\\n  base: './',\\n  resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\\n  build: {\\n    write: false,\\n    modulePreload: false,\\n    cssCodeSplit: false,\\n    assetsInlineLimit: () => true,\\n    chunkSizeWarningLimi