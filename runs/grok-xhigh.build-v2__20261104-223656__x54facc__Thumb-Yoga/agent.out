ystems of the phases `intents` (read the step's intents into\"},{\"line_number\":42,\"content\":\"/** The phases systems run in, in order; the engine's `timers` stage runs between `readback` and `rules`. */\"},{\"line_number\":43,\"content\":\"export const PHASES = ['intents', 'ai', 'anim', 'physics', 'readback', 'rules'] as const;\"},{\"line_number\":46,\"content\":\"export type Phase = (typeof PHASES)[number];\"},{\"line_number\":61,\"content\":\"/** One step, in order: the phases, the engine's stages (`timers`, `spawns`, `despawns`, `events`) among them. */\"},{\"line_number\":110,\"content\":\"const PHASE_INDEX = new Map<string, number>(PHASES.map((phase, i) => [phase, i]));\"},{\"line_number\":131,\"content\":\"          `the phase ${show(phase)} is not one of ${PHASES.join(', ')}${didYouMean(String(phase), PHASES)}`,\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"90d94abe-f014-473b-9162-f4cf726b8353"}
