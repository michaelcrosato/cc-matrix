    for query in queries:\\n            before = len(fails)\\n            browse.run_hub(browser, f\\\"{harness}?game={quote(game, safe='/')}&{query}\\\", query, lines, fails)\\n            data = json.loads(lines[-1])\\n            bad = [c[\\\"name\\\"] for c in data.get(\\\"checks\\\", []) if not c[\\\"pass\\\"]]\\n            engines = [\\n                f\\\"ready={g['ready']} errors={g['errors']} ghosts={g['ghosts']}\\\"\\n                for g in data.get(\\\"ghosts\\\", [])\\n            ]\\n            print(f\\\"QUERY {query}\\\", flush=True)\\n            print(f\\\"  hubCheck.pass={data.get('pass')} newFails={len(fails)-before} bad={bad}\\\", flush=True)\\n            for row in engines:\\n                print(f\\\"  {row}\\\", flush=True)\\n        server.shutdown()\\n    finally:\\n        browser.close()\\nprint(\\\"ALL PASS\\\" if not fails else f\\\"{len(fails)} FAILURES\\\")\\nfor item in fails:\\n    print(\\\"FAIL\\\", str(item)[:300])\\nPY\\necho EXIT:$? >> \\\"$SCRATCH/hub-rerun.out\\\"\",\"status\":\"completed\",\"exit_code\":0,\"started\":\"2026-11-05T10:44:32Z\",\"ended\":\"2026-11-05T10:46:35Z\",\"duration_secs\":123.109611125,\"output\":\"\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-223656__x54facc%2Fwork/01a1aa35-d4ff-74f0-9f18-3308a1dd51dc/terminal/call-e65ad370-67a4-4a34-a034-112327dcad0e-161.log\",\"truncated\":false,\"truncation_hint\":\"[truncated - use read_file on output_file for full content]\",\"raw_output_bytes\":0}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"4672bab3-402f-42fa-a697-894a800eed29"}
