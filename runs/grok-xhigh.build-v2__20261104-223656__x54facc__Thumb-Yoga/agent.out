rn rig.camera;\\n    },\\n    cameras: [pair.perspective, pair.orthographic],\\n    get drawn() {\\n      return drawn;\\n    },\\n    stepped() {\\n300→      const run = options.run();\\n      syncEffects(); // off, the bolts this step reads draw as stand-ins at once\\n      stage.capture(placed(run, stage.kinds), run.world.dt, queries());\\n      stage.draw((alpha = 1)); // the latest state until a frame interpolates: what a headless dump shows\\n      crowdStale = true; // posed by the next frame or dump, not every step\\n      readPlayer();\\n    },\\n    restarted() {\\n      const run = options.run();\\n      // A new world is read from its first event. The same one (a restore, a dev action) keeps its trace read: the\\n310→      // trace is history, never restored, so reading it again would play its events twice. Bolts snap either way.\\n      if (run.world !== fxWorld) {\\n        stage.fx.reset();\\n        fxWorld = run.world;\\n      }\\n      syncEffects();\\n      reread();\\n      stage.draw((alpha = 1));\\n      crowdStale = true;\\n      readPlayer(true);\\n320→    },\\n    frame(frame) {\\n      aspect = frame.aspect;\\n      // Turned on or off since the last read (a paused page, a hit-stop, a shot): read the world again first, so a\\n      // flying bolt changes hands at once between the effects and its stand-in, and no frame draws it by neither.\\n      if (syncEffects()) reread();\\n      stage.draw((alpha = frame.alpha));\\n      drawn = pair.place(move(frame.input, frame.dt), aspect);\\n      time += frame.dt;\\n      const [hour, lamps] = [daytimeOf(options.run().world), stage.props.lights()]; // WP 13.23\",\"content_concise\":\"290→  const view: RunView = {\\n    stage,\\n    get camera() {\\n      return rig.camera;\\n    },\\n    cameras: [pair.perspective, pair.orthographic],\\n    get drawn() {\\n      return drawn;\\n    },\\n    stepped() {\\n300→      const run = options.run();\\n      syncEffects(); // off, the bolts this step reads draw as stand-ins at once\\n      stage.capture(placed(run, stage.kinds), run.world.dt, queries());\\n      stage.draw((alpha = 1)); // the latest state until a frame interpolates: what a headless dump shows\\n      crowdStale = true; // posed by the next frame or dump, not every step\\n      readPlayer();\\n    },\\n    restarted() {\\n      const run = options.run();\\n      // A new world is read from its first event. The same one (a restore, a dev action) keeps its trace read: the\\n310→      // trace is history, never restored, so reading it again would play its events twice. Bolts snap either way.\\n      if (run.world !== fxWorld) {\\n        stage.fx.reset();\\n        fxWorld = run.world;\\n      }\\n      syncEffects();\\n      reread();\\n      stage.draw((alpha = 1));\\n      crowdStale = true;\\n      readPlayer(true);\\n320→    },\\n    frame(frame) {\\n      aspect = frame.aspect;\\n      // Turned on or off since the last read (a paused page, a hit-stop, a shot): read the world again first, so a\\n      // flying bolt changes hands at once between the effects and its stand-in, and no frame draws it by neither.\\n      if (syncEffects()) reread();\\n      stage.draw((alpha = frame.alpha));\\n      drawn = pair.place(move(frame.input, frame.dt), aspect);\\n      time += frame.dt;\\n      const [hour, lamps] = [daytimeOf(options.run().world), stage.props.lights()]; // WP 13.23\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/app/view.ts\",\"offset\":290,\"limit\":40,\"raw_output\":\"  const view: RunView = {\\n    stage,\\n    get camera() {\\n      return rig.camera;\\n    },\\n    cameras: [pair.perspective, pair.orthographic],\\n    get drawn() {\\n      return drawn;\\n    },\\n    stepped() {\\n      const run = options.run();\\n      syncEffects(); // off, the bolts this step reads draw as stand-ins at once\\n      stage.capture(placed(ru