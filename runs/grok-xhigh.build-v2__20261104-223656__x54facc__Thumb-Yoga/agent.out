_number\":44,\"content\":\"/** The system layer: action → codes. Always active, never rebound, never in the intents. */\"},{\"line_number\":47,\"content\":\"  uiAccept: ['Enter', 'NumpadEnter', 'Space', 'PadSouth'],\"},{\"line_number\":55,\"content\":\"/** Codes no action map binds: the pause buttons, and keys the browser or the system keeps. */\"},{\"line_number\":143,\"content\":\"    if (Object.hasOwn(SYSTEM_ACTIONS, action)) problems.push(`${action} is a system action, never rebound: rename it`);\"},{\"line_number\":178,\"content\":\"    defineWith: \\\"defineActionMap('actionMap:<name>', { actions: { jump: ['Space', 'PadSouth'] } })\\\",\"},{\"line_number\":197,\"content\":\"export function defineActionMap(id: string, spec: ActionMapSpec, registry: Registry = sharedRegistry): ActionMap {\"},{\"line_number\":273,\"content\":\"    defineActionMap(id, spec);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"963fa47a-e4c0-4571-a144-2096d92045e7"}
