line_number\":188,\"content\":\"export { SECONDARY_FIELDS } from './sim/reactions';\"},{\"line_number\":189,\"content\":\"export type { SecondaryComponent } from './sim/reactions';\"},{\"line_number\":190,\"content\":\"export type { ReactionComponents } from './sim/reactions';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/world/level/level.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * by id (`defineScene('box:room', { level: 'level:room', … })`, engine/sim/scene.ts) and `x describe level` lists\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/gfx/quality.ts\",\"matches\":[{\"line_number\":25,\"content\":\"import { defineSettings } from '../core/settings';\"},{\"line_number\":47,\"content\":\"defineSettings(QUALITY_SETTINGS);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/gfx/features.ts\",\"matches\":[{\"line_number\":37,\"content\":\"import { createSettings, defineSettings, type Settings } from '../core/settings';\"},{\"line_number\":186,\"content\":\"  if (!declared) defineSettings(FEATURE_SETTINGS, registry);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/anim/footPlant.ts\",\"matches\":[{\"line_number\":5,\"content\":\" * solve (engine/anim/actions.ts), on a flat floor at the body's height or, given the view's `ground` (`queryGround`\"},{\"line_number\":15,\"content\":\" * without a rule for stepping out, locks held feet where actions had left them and flipped knees); for them it stands\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/engine/anim/ragdoll.ts\",\"matches\":[{\"line_number\":19,\"content\":\" * (`lyingOf` its chest, so `Reactions.getUp` picks the get-up), and where the humanoid lying the same way puts its\"},{\"line_number\":38,\"content\":\"import { lyingOf, Reactions, type Lying } from './reactions';\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"6674722b-20c1-44e3-9056-1b16af5929c7"}
