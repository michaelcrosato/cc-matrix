n;\\n    },\\n    draw(alpha) {\\n      if (!meshes) return;\\n      const k = Math.min(1, Math.max(0, alpha));\\n150→      meshes.begin(time - step + k * step);\\n      for (const [id, { prop, before, after, on }] of held) {\\n        const [p0, p1] = [before.p, after.p];\\n        at.set(p0[0] + (p1[0] - p0[0]) * k, p0[1] + (p1[1] - p0[1]) * k, p0[2] + (p1[2] - p0[2]) * k);\\n        if (hidden?.(at.x, at.y, at.z)) continue;\\n        a.fromArray(before.q).slerp(b.fromArray(after.q), k);\\n        meshes.add(prop, { position: at, rotation: a, on }, id);\\n      }\\n      for (const [id, gun] of guns) meshes.add(gun.kind.prop, { position: gun.position, rotation: gun.rotation }, id);\\n      meshes.end();\\n160→    },\\n    carry(next) {\\n      const list = [...next].filter(([, gun]) => gun.kind.prop !== '');\\n      const changed = list.map(([id]) => id).join() !== guns.map(([id]) => id).join();\\n      guns = list;\\n      if (guns.length > 0) made();\\n      return changed;\\n    },\\n    hide(test, key = '') {\\n      const changed = key !== hiddenKey;\\n170→      [hidden, hiddenKey] = [test, key];\\n      return changed;\\n    },\\n    lights: () => meshes?.lights() ?? [],\\n    register(warmup) {\\n      warmups.add(warmup);\\n      if (meshes) registrations.set(warmup, meshes.register(warmup));\\n      const presence = warmup.keyPart('stage:props', () => (meshes ? 'props' : ''));\\n      return {\\n        dispose() {\",\"content_concise\":\"120→  const props: StageProps = {\\n    get meshes() {\\n      return meshes;\\n    },\\n    props: ids,\\n    capture(entities, dt) {\\n      if (dt !== undefined && dt > 0) [time, step] = [time + dt, dt];\\n      const seen = new Set<number>();\\n      for (const entity of entities) {\\n        const data = entity.sceneProp as Record<string, unknown> | undefined;\\n130→        const pose = data && typeof data.prop === 'string' ? poseOf(data) : null;\\n        if (!data || !pose || seen.has(entity.id)) continue;\\n     