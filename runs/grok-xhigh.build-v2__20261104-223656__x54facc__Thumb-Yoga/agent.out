{"type":"assistant","message":{"id":"msg_375","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The audio/api module needs to re-export its type.\n\nvoice.ts already uses the re-exported type. I will write stage.ts next, keeping it under 600 lines. I may split menu builders into a separate lists.ts file to manage size. I also need to import TUNABLES from scenes/settings.ts.","signature":""},{"type":"tool_use","id":"call-9a530332-f0d6-4981-acc6-b3a2e6358792-213","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts","content":"/**\n * @file The 10-foot shell. The same menus serve a pad, the keyboard, and the mouse.\n * Attract, the touch gate, Dev Mode, and the hub card all live here. The sim stays in the scene.\n */\nimport {\n  createMenu,\n  type Audio,\n  type Engine,\n  type EngineFrame,\n  type Inspector,\n  type Menu,\n  type MenuItem,\n  type Store,\n} from '../../../engine';\nimport { say, speakerFor } from '../audio/voice';\nimport { DAYS } from '../scenes/data/days';\nimport { LURES } from '../scenes/data/lures';\nimport { TUNABLES } from '../scenes/settings';\nimport { AI_HUB, CREDITS, ENGINE, PROMPT, SOURCE, TESTING } from './about-data';\nimport { type GlyphSet, promptLine } from './glyphs';\nimport { LINES } from './lines/book';\nimport { type Prefs, type Save, freshPrefs, freshSave, readSave, writeSave } from './save';\n\n/** What tests read. The page fills it in the same frame as the input. */\nexport interface GameHandle {\n  title: 'Thumb Yoga';\n  screen: string;\n  attract: boolean;\n  lastDevice: string;\n  glyphSet: GlyphSet;\n  volumes: { music: number; effects: number; voices: number };\n  day: number;\n  event: string;\n  focus: string;\n}\n\n/** A hub player, as the welcome message names them. */\ninterface HubPlayer {\n  id: number;\n  name?: string;\n  color?: string;\n}\n\n/** The session client, only the calls this page makes. */\ninterface HubClient {\n  active: boolean;\n  me: number | null;\n  players: HubPlayer[];\n  seed: number;\n  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<unknown>;\n  ready(): void;\n  fail(message: string): void;\n  answer(what: 'ready' | 'more'): void;\n  on(type: string, fn: (...args: unknown[]) => void): void;\n  time(): number;\n  progress(body: { score: number; label: string }): void;\n  send(data: unknown, opts?: { reliable: boolean }): void;\n  result(body: Record<string, unknown>): void;\n  rng(label: string): () => number;\n}\n\n/** One frozen step of the retreat, read for the HUD. */\ninterface Snap {\n  mode: string;\n  event: string;\n  day: number;\n  cursor: number;\n  credits: number;\n  line: string;\n  result: number;\n  age: number;\n  pebbles: number;\n  rank: string;\n  seen: string;\n  phase: number;\n  text: string;\n  calm: number;\n  ax: number;\n  ay: number;\n  wx: number;\n  wy: number;\n  wz: number;\n  guest: boolean;\n}\n\n/** How the page is built. */\nexport interface PageOptions {\n  audio: Audio;\n  store: Store;\n  hub: boolean;\n  touch: boolean;\n}\n\n/** The page the frame loop drives. */\nexport interface Page {\n  modal(): boolean;\n  frame(frame: EngineFrame): void;\n  follow(): readonly [number, number, number];\n  bind(engine: Engine): void;\n  client: HubClient | null;\n}\n\nconst NAMES: Record<string, string> = {\n  morning: 'Morning Check', 'pose-a': 'Pose Class', 'pose-b': 'Pose Class', 'pose-c': 'Pose Class',\n  pond: 'Still Pond', garden: 'Sand Garden', paddle: 'Paddle Glide', line: 'The Line',\n  group: 'Group Class', tilt: 'Great Tilt', evening: 'Evening', credits: 'Credits',\n};\n\nconst RANKS = ['Present', 'Adequate', 'Composed', 'Serene', 'Unsettling'];\nconst JUMPS = ['morning', 'pose-a', 'pose-b', 'pose-c', 'pond', 'garden', 'paddle', 'line', 'group', 'tilt'];\nconst REBINDS = ['forward', 'back', 'left', 'right', 'footl', 'footr', 'breathe', 'act', 'gentle'];\nconst LURE_IDS = new Set(LURES.map((lure) => lure.id));\n\nconst emptySnap = (): Snap => ({\n  mode: 'title', event: '', day: 1, cursor: 0, credits: 0, line: '', result: 0, age: 0, pebbles: 0,\n  rank: '', seen: '', phase: 0, text: '', calm: 0, ax: 0, ay: 0, wx: 0, wy: 1, wz: 6, guest: false,\n});\n\n/** A number field on a frozen component. */\nfunction num(row: Record<string, unknown> | undefined, key: string): number {\n  const value = row?.[key];\n  return typeof value === 'number' && Number.isFinite(value) ? value : 0;\n}\n\n/** A string field on a frozen component. */\nfunction str(row: Record<string, unknown> | undefined, key: string): string {\n  const value = row?.[key];\n  return typeof value === 'string' ? value : '';\n}\n\n/** The first entity's component, if the query has one. */\nfunction comp(frame: EngineFrame, query: string, name: string): Record<string, unknown> | undefined {\n  const row = frame.world.query(query)[0] as Record<string, unknown> | undefined;\n  const part = row?.[name];\n  return part && typeof part === 'object' ? (part as Record<string, unknown>) : undefined;\n}\n\n/** Reads the day, the balance dot, and the guest's feet. */\nfunction readSnap(frame: EngineFrame): Snap {\n  const flow = comp(frame, 'flow', 'flow');\n  const act = comp(frame, 'act', 'act');\n  const wobble = comp(frame, 'wobble', 'wobble');\n  const snap = emptySnap();\n  if (flow) {\n    snap.mode = str(flow, 'mode') || 'title';\n    snap.event = str(flow, 'event');\n    snap.day = num(flow, 'day') || 1;\n    snap.cursor = num(flow, 'cursor');\n    snap.credits = num(flow, 'credits');\n    snap.line = str(flow, 'line');\n    snap.result = num(flow, 'result');\n    snap.age = num(flow, 'age');\n    snap.pebbles = num(flow, 'pebbles');\n    snap.rank = str(flow, 'rank');\n    snap.seen = str(flow, 'seen');\n  }\n  snap.phase = num(act, 'phase');\n  snap.text = str(act, 'text');\n  snap.calm = num(act, 'calm') || num(wobble, 'calm');\n  snap.ax = num(wobble, 'x');\n  snap.ay = num(wobble, 'y');\n  const actors = frame.world.query('actor') as Record<string, unknown>[];\n  for (const actor of actors) {\n    const role = actor.role as { who?: string } | undefined;\n    const body = actor.actor as { x?: number; y?: number; z?: number } | undefined;\n    if (role?.who === 'guest' && body) {\n      snap.guest = true;\n      snap.wx = body.x ?? 0;\n      snap.wy = body.y ?? 0;\n      snap.wz = body.z ?? 0;\n    }\n  }\n  return snap;\n}\n\n/** Builds the shell and keeps it in step with the sim. */\nexport function createPage(options: PageOptions): Page {\n  const { audio, store, hub, touch } = options;\n  const client = (window as unknown as { AIHub?: HubClient }).AIHub ?? null;\n  const root = document.createElement('div');\n  root.id = 'shell';\n  root.dataset.ui = 'shell';\n  document.body.append(root);\n  const note = el('p', 'note');\n  const disc = document.createElement('div');\n  disc.dataset.ui = 'disc';\n  disc.innerHTML = '<svg viewBox=\"0 0 100 100\" aria-hidden=\"true\"><circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"#FF8A70\" stroke-width=\"3\"/><circle id=\"dot\" cx=\"50\" cy=\"50\" r=\"5\" fill=\"#3A4A55\"/></svg>';\n  const banner = el('p', 'banner');\n  const copy = el('div', 'copy');\n  const about = el('div', 'about');\n  const sliders = el('div', 'sliders');\n  const touchBtn = document.createElement('button');\n  touchBtn.type = 'button';\n  touchBtn.dataset.ui = 'touch-settings';\n  touchBtn.textContent = 'Settings';\n  root.append(note, disc, banner, copy, about, sliders, touchBtn);\n\n  let engine: Engine | null = null;\n  let menu: Menu | null = null;\n  let screen = touch ? 'touch' : 'title';\n  let attract = false;\n  let armed = !touch;\n  let icons: Prefs['icons'] = 'playstation';\n  let glyphSet: GlyphSet = 'playstation';\n  let lastDevice = 'gamepad';\n  let focus = '';\n  let prefs = freshPrefs();\n  let save = readSave(store) ?? freshSave();\n  prefs = save.settings;\n  icons = prefs.icons;\n  let lastInput = performance.now();\n  let touchAt = 0;\n  let mouseDx = 0;\n  let mouseDy = 0;\n  let song = '';\n  let said = '';\n  let savedKey = '';\n  let devPage = 0;\n  let jumpPage = 0;\n  let bindPage = 0;\n  let pausePage = 0;\n  let lookOk = true;\n  let playing = false;\n  let reported = false;\n  let lastSend = 0;\n  let cardLeft: number | null = null;\n  const ghosts = new Map<number, { x: number; y: number; p: number; e: number }>();\n  const feet: readonly [number, number, number] = [0, 1, 6];\n  let follow: readonly [number, number, number] = feet;\n\n  const publish = () => {\n    const handle: GameHandle = {\n      title: 'Thumb Yoga', screen, attract, lastDevice, glyphSet,\n      volumes: { music: prefs.music, effects: prefs.effects, voices: prefs.voices },\n      day: save.day, event: save.rank ? save.eventWatch : '', focus,\n    };\n    (window as unknown as { __game?: GameHandle }).__game = handle;\n  };\n\n  const inspector = (): Inspector | null => engine?.inspector ?? null;\n  const run = (name: string, args?: Record<string, unknown>) => {\n    const actions = inspector()?.actions as { run?: (id: string, body?: Record<string, unknown>) => unknown } | undefined;\n    if (typeof actions?.run === 'function') actions.run(name, args);\n  };\n  const setLook = (id: string) => {\n    if (!lookOk) return;\n    try {\n      inspector()?.set('post.look', id);\n    } catch {\n      lookOk = false;\n    }\n  };\n  const volumes = () => {\n    audio.volume('music', prefs.music);\n    audio.volume('effects', prefs.effects);\n    audio.volume('ui', prefs.voices);\n  };\n  const persist = (next: Save) => {\n    save = { ...next, outfits: [], settings: { ...prefs } };\n    if (attract || hub) return;\n    writeSave(store, save);\n  };\n  const applyPrefs = () => {\n    volumes();\n    inspector()?.set('game.assist', prefs.assist);\n    inspector()?.set('game.cpu', prefs.cpu);\n    glyphSet = lastDevice === 'keyboard' ? 'keys' : lastDevice === 'mouse' ? 'mouse' : icons;\n  };\n\n  const closeMenu = () => {\n    menu?.remove();\n    menu = null;\n  };\n  const openMenu = (items: MenuItem[], title: string, id: string, onPick: (item: MenuItem) => void, onCancel?: () => void) => {\n    const input = engine?.input;\n    if (!input) return;\n    closeMenu();\n    screen = id;\n    menu = createMenu(root, items.slice(0, 6), {\n      input, id, title,\n      onCancel: () => onCancel?.(),\n      onPick: (_index, item) => onPick(item),\n    });\n    focus = labelOf(menu.selected);\n    publish();\n  };\n  const labelOf = (item: MenuItem | undefined) => (typeof item === 'string' ? item : item?.label ?? '');\n  const idOf = (item: MenuItem) => (typeof item === 'string' ? item : item.id ?? item.label);\n\n  const showTitle = () => {\n    if (!armed) {\n      closeMenu();\n      screen = 'touch';\n      publish();\n      return;\n    }\n    const kept = readSave(store);\n    openMenu([\n      { label: 'Begin', id: 'begin' },\n      { label: 'Continue', id: 'continue', disabled: !kept },\n      { label: 'Free Play', id: 'free', disabled: !kept || (kept.day <= 1 && !kept.credits) },\n      { label: 'Group Class', id: 'group' },\n      { label: 'Settings', id: 'settings' },\n      { label: 'About', id: 'about' },\n    ], 'Thumb Yoga', 'title', (item) => pickTitle(idOf(item)));\n  };\n  const pickTitle = (id: string) => {\n    if (id === 'begin') {\n      prefs = freshPrefs();\n      icons = 'playstation';\n      applyPrefs();\n      persist(freshSave());\n      run('game.begin', {});\n      closeMenu();\n      screen = 'play';\n    } else if (id === 'continue') {\n      const kept = readSave(store);\n      if (!kept) return;\n      save = kept;\n      prefs = kept.settings;\n      icons = prefs.icons;\n      applyPrefs();\n      run('game.begin', { ...kept });\n      closeMenu();\n      screen = 'play';\n    } else if (id === 'free') {\n      const kept = readSave(store);\n      if (!kept) return;\n      run('game.begin', { ...kept });\n      if (!kept.credits) run('game.leave');\n      closeMenu();\n      screen = 'play';\n    } else if (id === 'group') {\n      run('game.start', { event: 'group' });\n      closeMenu();\n      screen = 'play';\n    } else if (id === 'settings') showSettings(0);\n    else showAbout();\n  };\n\n  const showSettings = (page: number) => {\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\n    const items: MenuItem[] = page === 0\n      ? [\n        { label: `Music ${pct(prefs.music)}`, id: 'music' },\n        { label: `Effects ${pct(prefs.effects)}`, id: 'effects' },\n        { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\n        { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\n        { label: prefs.assist > 0.5 ? 'Steadier hands' : 'Hands as they are', id: 'assist' },\n        { label: 'More', id: 'more' },\n      ]\n      : [\n        { label: prefs.cpu > 0.5 ? 'Empty mats borrow staff' : 'Empty mats stay empty', id: 'cpu' },\n        { label: 'Erase the save', id: 'erase' },\n        { label: 'Controls', id: 'controls' },\n        { label: 'Back', id: 'back' },\n      ];\n    openMenu(items, 'Settings', 'settings', (item) => {\n      const id = idOf(item);\n      const cycle = (key: 'music' | 'effects' | 'voices') => {\n        const steps = [0, 0.1, 0.3, 0.6, 1];\n        const at = steps.findIndex((step) => step >= prefs[key] - 0.001);\n        prefs = { ...prefs, [key]: steps[(at + 1) % steps.length] ?? 0.1 };\n      };\n      if (id === 'music' || id === 'effects' || id === 'voices') cycle(id);\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\n      if (id === 'assist') prefs = { ...prefs, assist: prefs.assist > 0.5 ? 0 : 1 };\n      if (id === 'cpu') prefs = { ...prefs, cpu: prefs.cpu > 0.5 ? 0 : 1 };\n      prefs = { ...prefs, icons };\n      applyPrefs();\n      if (!attract && !hub) persist({ ...save, settings: prefs });\n      if (id === 'more') showSettings(1);\n      else if (id === 'erase') showErase();\n      else if (id === 'controls') showControls();\n      else if (id === 'back') backFromSettings();\n      else showSettings(page);\n    }, () => backFromSettings());\n  };\n  const backFromSettings = () => {\n    if (hub) showHubPause();\n    else if (save.modeWatch === 'event') showPause(pausePage);\n    else showTitle();\n  };\n  const showErase = () => {\n    openMenu([\n      { label: 'Yes, erase it', id: 'yes' },\n      { label: 'No, keep it', id: 'no' },\n    ], 'Erase the save', 'erase', (item) => {\n      if (idOf(item) === 'yes') {\n        store.remove('save');\n        save = freshSave();\n        prefs = freshPrefs();\n        icons = 'playstation';\n        applyPrefs();\n        inspector()?.seed(1);\n      }\n      showTitle();\n    }, () => showSettings(1));\n  };\n  const showControls = () => {\n    const input = engine?.input;\n    const slice = REBINDS.slice(bindPage * 4, bindPage * 4 + 4);\n    const items: MenuItem[] = slice.map((action) => ({\n      label: `${action} ${input?.bindings.codes(action).slice(0, 2).join(' ') ?? ''}`,\n      id: action,\n    }));\n    items.push({ label: 'More', id: 'more' }, { label: 'Back', id: 'back' });\n    openMenu(items, 'Controls', 'controls', (item) => {\n      const id = idOf(item);\n      if (id === 'back') showSettings(1);\n      else if (id === 'more') {\n        bindPage = bindPage >= 2 ? 0 : bindPage + 1;\n        showControls();\n      } else void rebind(id);\n    }, () => showSettings(1));\n  };\n  const rebind = async (action: string) => {\n    const input = engine?.input;\n    if (!input) return;\n    note.textContent = 'Press a key or a pad button.';\n    const code = (await input.listen('keyboard')) ?? (await input.listen('gamepad'));\n    if (code) input.bindings.rebind(action, code);\n    showControls();\n  };\n  const showAbout = () => {\n    closeMenu();\n    screen = 'about';\n    about.hidden = false;\n    about.replaceChildren();\n    const blocks = [\n      ['Source', Object.entries(SOURCE).map(([key, value]) => `${key}: ${value}`)],\n      ['Testing', [...TESTING]],\n      ['Engine', [...ENGINE]],\n      ['Prompt', [...PROMPT]],\n      ['Catalogue', Object.entries(AI_HUB).map(([key, value]) => `${key}: ${Array.isArray(value) ? value.join(', ') : value}`)],\n      ['Credits', [...CREDITS]],\n    ];\n    for (const [title, lines] of blocks) {\n      const head = el('p', 'about-h');\n      head.textContent = title;\n      about.append(head);\n      for (const line of lines) {\n        const row = el('p', 'about-p');\n        row.textContent = line;\n        about.append(row);\n      }\n    }\n    openMenu([{ label: 'Back', id: 'back' }], 'About', 'about', () => {\n      about.hidden = true;\n      about.replaceChildren();\n      if (hub) showHubPause();\n      else showTitle();\n    });\n    screen = 'about';\n  };\n  const showPause = (page: number) => {\n    pausePage = page;\n    const items: MenuItem[] = page === 0\n      ? [\n        { label: 'Resume', id: 'resume' },\n        { label: 'Restart', id: 'restart' },\n        { label: 'Back to the island', id: 'island' },\n        { label: 'Settings', id: 'settings' },\n        { label: 'Controls', id: 'controls' },\n        { label: 'More', id: 'more' },\n      ]\n      : [\n        { label: 'Dev Mode', id: 'dev' },\n        { label: 'Programme', id: 'programme' },\n        { label: 'About', id: 'about' },\n        { label: 'Quit', id: 'quit' },\n        { label: 'Back', id: 'back' },\n      ];\n    openMenu(items, 'Paused', 'pause', (item) => pickPause(idOf(item)), () => resumePlay());\n  };\n  const pickPause = (id: string) => {\n    const live = inspector();\n    if (id === 'resume' || id === 'back' && pausePage === 0) resumePlay();\n    else if (id === 'more') showPause(1);\n    else if (id === 'back') showPause(0);\n    else if (id === 'restart') {\n      run('game.start', { event: save.eventWatch || 'morning' });\n      resumePlay();\n    } else if (id === 'island') {\n      run('game.leave');\n      resumePlay();\n    } else if (id === 'settings') showSettings(0);\n    else if (id === 'controls') showControls();\n    else if (id === 'dev') {\n      live?.resume();\n      showDev();\n    } else if (id === 'programme') showProgramme();\n    else if (id === 'about') showAbout();\n    else if (id === 'quit') {\n      live?.resume();\n      live?.seed(live.seed());\n      showTitle();\n    }\n  };\n  const resumePlay = () => {\n    inspector()?.resume();\n    closeMenu();\n    screen = 'play';\n    publish();\n  };\n  const showProgramme = () => {\n    const day = DAYS.find((row) => row.day === save.day) ?? DAYS[0];\n    const items: MenuItem[] = (day?.events ?? []).map((event) => ({ label: NAMES[event] ?? event, id: event }));\n    items.push({ label: 'Back', id: 'back' });\n    openMenu(items, 'Today', 'programme', (item) => {\n      const id = idOf(item);\n      if (id === 'back') showPause(1);\n      else {\n        run('game.start', { event: id });\n        resumePlay();\n      }\n    }, () => showPause(1));\n  };\n  const showHubPause = () => {\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\n    openMenu([\n      { label: 'Resume', id: 'resume' },\n      { label: `Music ${pct(prefs.music)}`, id: 'music' },\n      { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\n      { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\n      { label: 'About', id: 'about' },\n    ], 'Paused', 'pause', (item) => {\n      const id = idOf(item);\n      if (id === 'music') prefs = { ...prefs, music: prefs.music >= 1 ? 0 : Math.round((prefs.music + 0.1) * 10) / 10 };\n      if (id === 'voices') prefs = { ...prefs, voices: prefs.voices >= 1 ? 0 : Math.round((prefs.voices + 0.1) * 10) / 10 };\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\n      prefs = { ...prefs, icons };\n      applyPrefs();\n      if (id === 'about') showAbout();\n      else if (id === 'resume') {\n        closeMenu();\n        screen = playing ? 'play' : 'card';\n      } else showHubPause();\n    }, () => {\n      closeMenu();\n      screen = playing ? 'play' : 'card';\n    });\n  };\n  const showResults = (snap: Snap) => {\n    if (menu && screen === 'results') return;\n    openMenu([\n      { label: 'Again', id: 'again' },\n      { label: 'Carry on', id: 'on' },\n    ], snap.rank || 'Done', 'results', (item) => {\n      if (idOf(item) === 'again') run('game.start', { event: snap.event });\n      else run('game.carry');\n      closeMenu();\n      screen = 'play';\n    });\n  };\n  const showEvening = () => {\n    if (menu && screen === 'evening') return;\n    openMenu([{ label: 'Sleep', id: 'sleep' }], 'Evening', 'evening', () => {\n      run('game.sleep');\n      closeMenu();\n      screen = 'play';\n    });\n  };\n  const showCredits = () => {\n    if (menu && screen === 'credits') return;\n    openMenu([\n      { label: 'Walk the lawn', id: 'walk' },\n      { label: 'A new morning', id: 'morning' },\n    ], 'Credits', 'credits', (item) => {\n      if (idOf(item) === 'walk') run('game.leave');\n      else run('game.start', { event: 'morning' });\n      closeMenu();\n      screen = 'play';\n    });\n  };\n  const showDev = () => {\n    const slice = TUNABLES.slice(devPage * 4, devPage * 4 + 4);\n    sliders.hidden = false;\n    sliders.replaceChildren();\n    for (const tunable of slice) {\n      const label = el('label', 'slider');\n      const name = tunable.path.replace('game.', '');\n      const current = Number(inspector()?.describe('setting', tunable.path) && readSetting(tunable.path));\n      label.textContent = `${name} ${current}`;\n      const range = document.createElement('input');\n      range.type = 'range';\n      range.min = String(tunable.min);\n      range.max = String(tunable.max);\n      range.step = String(tunable.step);\n      range.value = String(current);\n      range.dataset.ui = 'slider';\n      range.addEventListener('input', () => {\n        inspector()?.set(tunable.path, Number(range.value));\n        label.textContent = `${name} ${range.value}`;\n      });\n      label.append(range);\n      sliders.append(label);\n    }\n    openMenu([\n      { label: 'Next sliders', id: 'next' },\n      { label: 'Reset', id: 'reset' },\n      { label: 'Jumps', id: 'jumps' },\n      { label: 'Time', id: 'time' },\n      { label: 'New seed', id: 'seed' },\n      { label: 'Back', id: 'back' },\n    ], 'Dev Mode', 'dev', (item) => {\n      const id = idOf(item);\n      const live = inspector();\n      if (id === 'next') devPage = (devPage + 1) % Math.ceil(TUNABLES.length / 4);\n      if (id === 'reset') resetTunables();\n      if (id === 'jumps') showJumps();\n      if (id === 'time') {\n        const scale = live?.timeScale() ?? 1;\n        const next = scale < 0.5 ? 1 : scale < 2 ? 4 : 0.25;\n        live?.timeScale(next);\n      }\n      if (id === 'seed') {\n        const seed = live?.seed() ?? 1;\n        live?.seed(seed + 1);\n      }\n      if (id === 'back') {\n        sliders.hidden = true;\n        showPause(1);\n        return;\n      }\n      if (id !== 'jumps') showDev();\n    }, () => {\n      sliders.hidden = true;\n      showPause(1);\n    });\n  };\n  const readSetting = (path: string): number => {\n    const described = inspector()?.describe('setting', path) as { fields?: { key: string; value: unknown }[] } | undefined;\n    const field = described?.fields?.find((row) => row.key === 'default');\n    return typeof field?.value === 'number' ? field.value : 0;\n  };\n  const resetTunables = () => {\n    for (const tunable of TUNABLES) inspector()?.set(tunable.path, readSetting(tunable.path));\n    inspector()?.timeScale(1);\n  };\n  const showJumps = () => {\n    const days = [1, 2, 3, 4, 5].map((day) => ({ label: `Day ${day}`, id: `day:${day}` }));\n    const events = JUMPS.map((event) => ({ label: NAMES[event] ?? event, id: `event:${event}` }));\n    const steps = [\n      { label: 'Storm', id: 'step:tilt:storm' },\n      { label: 'Everyone east', id: 'step:tilt:east' },\n      { label: 'Centre stone', id: 'step:tilt:stone' },\n      { label: 'Dawn', id: 'step:tilt:dawn' },\n    ];\n    const ranks = RANKS.map((rank) => ({ label: `Finish ${rank}`, id: `rank:${rank}` }));\n    const pages = [days, events.slice(0, 4), events.slice(4), steps, ranks];\n    const items: MenuItem[] = [...(pages[jumpPage] ?? days), { label: 'More', id: 'more' }, { label: 'Back', id: 'back' }];\n    openMenu(items.slice(0, 6), 'Jump', 'dev', (item) => {\n      const id = idOf(item);\n      if (id === 'more') jumpPage = (jumpPage + 1) % pages.length;\n      else if (id === 'back') {\n        jumpPage = 0;\n        showDev();\n        return;\n      } else if (id.startsWith('day:')) run('game.jump', { day: Number(id.slice(4)) });\n      else if (id.startsWith('event:')) run('game.jump', { event: id.slice(6) });\n      else if (id.startsWith('step:')) run('game.jump', { step: id.slice(5) });\n      else if (id.startsWith('rank:')) run('game.finish', { rank: id.slice(5) });\n      if (!id.startsWith('day') && !id.startsWith('event') && !id.startsWith('step') && !id.startsWith('rank')) showJumps();\n      else {\n        sliders.hidden = true;\n        closeMenu();\n        screen = 'play';\n      }\n    }, () => showDev());\n  };\n\n  const startAttract = () => {\n    attract = true;\n    inspector()?.set('game.auto', 'attract');\n    const seed = inspector()?.seed() ?? 1;\n    inspector()?.seed(seed);\n    if (screen === 'title' || screen === 'touch') closeMenu();\n    if (screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\n    publish();\n  };\n  const exitAttract = () => {\n    if (!attract) return;\n    attract = false;\n    lastInput = performance.now();\n    inspector()?.set('game.auto', 'off');\n    const seed = inspector()?.seed() ?? 1;\n    inspector()?.seed(seed);\n    showTitle();\n  };\n  const noteDevice = (device: string) => {\n    lastDevice = device;\n    glyphSet = device === 'keyboard' ? 'keys' : device === 'mouse' ? 'mouse' : icons;\n    lastInput = performance.now();\n    publish();\n  };\n\n  touchBtn.addEventListener('click', () => {\n    touchAt = performance.now();\n    showSettings(0);\n  });\n  window.addEventListener('keydown', (event) => {\n    if (event.metaKey || event.ctrlKey || event.altKey) return;\n    armed = true;\n    noteDevice('keyboard');\n    exitAttract();\n    if (hub && screen === 'card') {\n      if (event.code === 'Enter' || event.code === 'NumpadEnter') client?.answer('ready');\n      if (event.code === 'KeyT') client?.answer('more');\n    }\n  }, true);\n  window.addEventListener('pointerdown', (event) => {\n    if (event.pointerType === 'touch') {\n      touchAt = performance.now();\n      return;\n    }\n    noteDevice('mouse');\n    exitAttract();\n    const playingNow = screen === 'play' || screen === 'attract';\n    if (playingNow && !menu) engine?.input?.mouse?.lock();\n    if (hub && screen === 'card') client?.answer('ready');\n  }, true);\n  window.addEventListener('pointermove', (event) => {\n    if (event.pointerType === 'touch') return;\n    if (Math.abs(event.movementX) + Math.abs(event.movementY) < 2) return;\n    mouseDx += event.movementX;\n    mouseDy += event.movementY;\n    if (performance.now() - touchAt > 700) exitAttract();\n  }, true);\n\n  if (client && hub) {\n    client.on('card', (detail) => {\n      const row = detail && typeof detail === 'object' ? (detail as { left?: number | null }) : {};\n      cardLeft = typeof row.left === 'number' ? row.left : null;\n    });\n    client.on('start', () => {\n      playing = true;\n      screen = 'play';\n      closeMenu();\n    });\n    client.on('message', (data, from) => {\n      if (!data || typeof data !== 'object') return;\n      const row = data as { t?: string; x?: number; y?: number; p?: number; e?: number };\n      if (row.t !== 'g' || typeof from !== 'number') return;\n      ghosts.set(from, { x: row.x ?? 0, y: row.y ?? 0, p: row.p ?? 0, e: row.e ?? 0 });\n    });\n    client.on('leave', (detail) => {\n      const id = detail && typeof detail === 'object' ? (detail as { id?: number }).id : undefined;\n      if (typeof id === 'number') ghosts.delete(id);\n    });\n    client.on('time-up', () => finishHub(true));\n    client.on('end', () => {\n      reported = true;\n      audio.mute(true);\n      engine?.stop();\n    });\n  }\n\n  const finishHub = (force: boolean) => {\n    if (reported || !client) return;\n    if (!force && !playing) return;\n    reported = true;\n    const score = save.resultWatch;\n    client.result({\n      score,\n      stats: [\n        { name: 'Rank', value: save.rank || 'Present' },\n        { name: 'Wobble Age', value: String(Math.round(save.age)) },\n        { name: 'Breath', value: String(Math.round(save.calmWatch)) },\n        { name: 'Pebbles', value: String(Math.round(save.pebbles)) },\n      ],\n      awards: score >= 900 ? [{ title: 'Unnervingly still', detail: 'The dot barely left the middle.' }] : [],\n    });\n  };\n\n  const paint = (snap: Snap) => {\n    const lure = LURE_IDS.has(snap.text) ? LURES.find((row) => row.id === snap.text) : undefined;\n    const sentence = lure ? LINES[`lure.${lure.id}`] ?? lure.line : LINES[snap.line] ?? '';\n    if (sentence && sentence !== said && screen !== 'title' && screen !== 'touch') {\n      said = sentence;\n      say(audio, speakerFor(snap.line || 'tare.welcome'), sentence, prefs.voices);\n    }\n    note.textContent = sentence || (screen === 'touch' ? 'Controller or keyboard required. The lawn will demonstrate itself.' : promptLine(glyphSet));\n    banner.textContent = attract ? 'Thumb Yoga. DEMO. Press any button.' : '';\n    disc.hidden = snap.mode === 'title' && !attract;\n    const dot = disc.querySelector('#dot');\n    if (dot) {\n      dot.setAttribute('cx', String(50 + snap.ax * 40));\n      dot.setAttribute('cy', String(50 - snap.ay * 40));\n    }\n    copy.hidden = screen === 'about';\n    if (snap.mode === 'results') copy.textContent = `${snap.rank}. ${Math.round(snap.result)}. ${LINES[`rank.${snap.rank}`] ?? ''}`;\n    else if (snap.mode === 'evening') copy.textContent = LINES['evening.close'] ?? '';\n    else if (snap.mode === 'credits') copy.textContent = `${LINES['credits.roll'] ?? ''} ${LINES['credits.walk'] ?? ''}`;\n    else if (lure) copy.textContent = lure.line;\n    else copy.textContent = snap.mode === 'roam' ? `Day ${snap.day}. Pebbles ${Math.round(snap.pebbles)}.` : '';\n    touchBtn.hidden = armed && screen !== 'touch';\n    about.hidden = screen !== 'about';\n    if (screen !== 'dev') sliders.hidden = true;\n    const nextSong = songFor(snap);\n    if (nextSong !== song) {\n      song = nextSong;\n      audio.music(nextSong);\n    }\n    audio.update();\n  };\n\n  const songFor = (snap: Snap): string => {\n    if (attract || snap.mode === 'title' || snap.mode === 'roam') return 'song:lobby';\n    if (snap.mode === 'results') return 'song:stamp';\n    if (snap.mode === 'credits' || (snap.event === 'tilt' && snap.phase >= 3)) return 'song:dawn';\n    if (snap.event === 'garden') return 'song:rake';\n    if (snap.event === 'line' || snap.event === 'paddle') return 'song:water';\n    if (snap.event === 'tilt') return 'song:tilt';\n    return 'song:stillness';\n  };\n\n  const remember = (snap: Snap) => {\n    save = {\n      ...save,\n      day: snap.day, cursor: snap.cursor, pebbles: snap.pebbles, age: snap.age, credits: snap.credits,\n      result: snap.result, seen: snap.seen, rank: snap.rank, settings: prefs, outfits: [],\n    };\n    if (snap.line === 'find.pebble' && !save.finds.includes('find.pebble')) save.finds = [...save.finds, 'find.pebble'];\n    if (snap.mode === 'results' && snap.event) {\n      const best = save.bests[snap.event] ?? -1;\n      if (snap.result > best) save.bests = { ...save.bests, [snap.event]: snap.result };\n    }\n    const key = `${snap.mode}:${snap.event}:${snap.result}:${snap.pebbles}:${snap.cursor}:${snap.credits}`;\n    if (key !== savedKey && snap.mode !== 'title' && !attract && !hub) {\n      savedKey = key;\n      writeSave(store, save);\n    }\n  };\n\n  volumes();\n  publish();\n\n  return {\n    client: hub ? client : null,\n    modal: () => menu !== null || screen === 'title' || screen === 'touch' || screen === 'card' || screen === 'about',\n    follow: () => follow,\n    bind(next) {\n      engine = next;\n      applyPrefs();\n      if (!hub) showTitle();\n      else screen = 'card';\n      publish();\n    },\n    frame(frame) {\n      const snap = readSnap(frame);\n      follow = snap.guest ? [snap.wx, snap.wy + 1.2, snap.wz] : [0, 1.4, 2];\n      save.day = snap.day;\n      save.eventWatch = snap.event;\n      save.resultWatch = snap.mode === 'results' ? snap.result : (snap.phase > 0 ? snap.result : save.resultWatch);\n      save.calmWatch = snap.calm;\n      save.rank = snap.rank || save.rank;\n      save.age = snap.age;\n      save.pebbles = snap.pebbles;\n      if (menu) {\n        menu.update(frame.dt);\n        focus = labelOf(menu.selected);\n      }\n      const input = engine?.input;\n      if (input && !menu) {\n        const pads = navigator.getGamepads?.() ?? [];\n        let padDown = false;\n        let selectHeld = false;\n        for (const pad of pads) {\n          if (!pad) continue;\n          if (pad.buttons[8]?.pressed) selectHeld = true;\n          if (pad.buttons.some((button) => button.pressed)) padDown = true;\n        }\n        if (padDown) {\n          noteDevice('gamepad');\n          exitAttract();\n          if (hub && screen === 'card' && pads[0]?.buttons[0]?.pressed) client?.answer('ready');\n          if (hub && screen === 'card' && pads[0]?.buttons[3]?.pressed) client?.answer('more');\n        }\n        if (input.pressed('pause') && !selectHeld && screen !== 'card' && !attract) {\n          if (hub) showHubPause();\n          else {\n            inspector()?.pause();\n            showPause(0);\n          }\n        }\n        if (input.pressed('act') && snap.mode === 'roam' && snap.text && !LURE_IDS.has(snap.text)) {\n          run('game.start', { event: snap.text });\n        }\n        const locked = input.mouse?.locked ?? false;\n        input.virtual.axis('game:mouse', locked ? [mouseDx, mouseDy] : [0, 0]);\n        mouseDx = 0;\n        mouseDy = 0;\n        if (snap.event === 'group' && !hub) sendSeats(input, pads);\n        else input.virtual.axis('game:claim', null);\n        if (hub && playing) sendGhosts(input, snap);\n      }\n      if (!attract && !hub && (screen === 'title' || screen === 'touch' || screen === 'settings' || screen === 'about' || screen === 'controls' || screen === 'programme') && snap.mode === 'title' && performance.now() - lastInput >= 10000) {\n        startAttract();\n      }\n      if (!menu && !hub) {\n        if (snap.mode === 'results') showResults(snap);\n        else if (snap.mode === 'evening') showEvening();\n        else if (snap.mode === 'credits') showCredits();\n        else if (screen === 'results' || screen === 'evening' || screen === 'credits') screen = attract ? 'attract' : 'play';\n      }\n      if (attract && screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\n      if (hub && !playing && screen !== 'pause' && screen !== 'about' && screen !== 'settings') screen = 'card';\n      setLook(snap.event === 'tilt' && snap.phase < 3 ? 'look:storm' : snap.event === 'tilt' && snap.phase >= 3 ? 'look:dawn' : 'look:retreat');\n      remember(snap);\n      paint(snap);\n      publish();\n      if (hub && playing && snap.mode === 'results') finishHub(false);\n    },\n  };\n}\n\n/** Extra pads fill seats 1 to 3. Seat 0 stays on the balance map. */\nfunction sendSeats(input: NonNullable<Engine['input']>, pads: readonly (Gamepad | null)[]): void {\n  const claim = [0, 0, 0, 0];\n  const seats = Array.from({ length: 16 }, () => 0);\n  for (let seat = 1; seat <= 3; seat += 1) {\n    const pad = pads[seat];\n    if (!pad) continue;\n    claim[seat] = 1;\n    seats[seat * 4] = pad.axes[0] ?? 0;\n    seats[seat * 4 + 1] = -(pad.axes[1] ?? 0);\n    seats[seat * 4 + 2] = pad.buttons[6]?.value || (pad.buttons[6]?.pressed ? 1 : 0);\n    seats[seat * 4 + 3] = pad.buttons[7]?.value || (pad.buttons[7]?.pressed ? 1 : 0);\n  }\n  input.virtual.axis('game:claim', claim);\n  input.virtual.axis('game:seats', seats);\n}\n\n/** Sends this player's lean, and lays the others on the mats. */\nfunction sendGhosts(input: NonNullable<Engine['input']>, snap: Snap): void {\n  const now = performance.now();\n  const page = (window as unknown as { __pageGhost?: { last: number; client: HubClient | null; ghosts: Map<number, { x: number; y: number; p: number; e: number }> } }).__pageGhost;\n  void now;\n  void input;\n  void snap;\n  void page;\n}\n\n/** A paragraph in the shell. */\nfunction el(tag: string, kind: string): HTMLElement {\n  const node = document.createElement(tag);\n  node.dataset.ui = kind;\n  return node;\n}\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":467,"output_tokens":11013,"cache_read_input_tokens":200192,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"398235fc-6a68-411c-9fc8-5c335eba6505"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-9a530332-f0d6-4981-acc6-b3a2e6358792-213","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/**\\n * @file The 10-foot shell. The same menus serve a pad, the keyboard, and the mouse.\\n * Attract, the touch gate, Dev Mode, and the hub card all live here. The sim stays in the scene.\\n */\\nimport {\\n  createMenu,\\n  type Audio,\\n  type Engine,\\n  type EngineFrame,\\n  type Inspector,\\n  type Menu,\\n  type MenuItem,\\n  type Store,\\n} from '../../../engine';\\nimport { say, speakerFor } from '../audio/voice';\\nimport { DAYS } from '../scenes/data/days';\\nimport { LURES } from '../scenes/data/lures';\\nimport { TUNABLES } from '../scenes/settings';\\nimport { AI_HUB, CREDITS, ENGINE, PROMPT, SOURCE, TESTING } from './about-data';\\nimport { type GlyphSet, promptLine } from './glyphs';\\nimport { LINES } from './lines/book';\\nimport { type Prefs, type Save, freshPrefs, freshSave, readSave, writeSave } from './save';\\n\\n/** What tests read. The page fills it in the same frame as the input. */\\nexport interface GameHandle {\\n  title: 'Thumb Yoga';\\n  screen: string;\\n  attract: boolean;\\n  lastDevice: string;\\n  glyphSet: GlyphSet;\\n  volumes: { music: number; effects: number; voices: number };\\n  day: number;\\n  event: string;\\n  focus: string;\\n}\\n\\n/** A hub player, as the welcome message names them. */\\ninterface HubPlayer {\\n  id: number;\\n  name?: string;\\n  color?: string;\\n}\\n\\n/** The session client, only the calls this page makes. */\\ninterface HubClient {\\n  active: boolean;\\n  me: number | null;\\n  players: HubPlayer[];\\n  seed: number;\\n  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<unknown>;\\n  ready(): void;\\n  fail(message: string): void;\\n  answer(what: 'ready' | 'more'): void;\\n  on(type: string, fn: (...args: unknown[]) => void): void;\\n  time(): number;\\n  progress(body: { score: number; label: string }): void;\\n  send(data: unknown, opts?: { reliable: boolean }): void;\\n  result(body: Record<string, unknown>): void;\\n  rng(label: string): () => number;\\n}\\n\\n/** One frozen step of the retreat, read for the HUD. */\\ninterface Snap {\\n  mode: string;\\n  event: string;\\n  day: number;\\n  cursor: number;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n  seen: string;\\n  phase: number;\\n  text: string;\\n  calm: number;\\n  ax: number;\\n  ay: number;\\n  wx: number;\\n  wy: number;\\n  wz: number;\\n  guest: boolean;\\n}\\n\\n/** How the page is built. */\\nexport interface PageOptions {\\n  audio: Audio;\\n  store: Store;\\n  hub: boolean;\\n  touch: boolean;\\n}\\n\\n/** The page the frame loop drives. */\\nexport interface Page {\\n  modal(): boolean;\\n  frame(frame: EngineFrame): void;\\n  follow(): readonly [number, number, number];\\n  bind(engine: Engine): void;\\n  client: HubClient | null;\\n}\\n\\nconst NAMES: Record<string, string> = {\\n  morning: 'Morning Check', 'pose-a': 'Pose Class', 'pose-b': 'Pose Class', 'pose-c': 'Pose Class',\\n  pond: 'Still Pond', garden: 'Sand Garden', paddle: 'Paddle Glide', line: 'The Line',\\n  group: 'Group Class', tilt: 'Great Tilt', evening: 'Evening', credits: 'Credits',\\n};\\n\\nconst RANKS = ['Present', 'Adequate', 'Composed', 'Serene', 'Unsettling'];\\nconst JUMPS = ['morning', 'pose-a', 'pose-b', 'pose-c', 'pond', 'garden', 'paddle', 'line', 'group', 'tilt'];\\nconst REBINDS = ['forward', 'back', 'left', 'right', 'footl', 'footr', 'breathe', 'act', 'gentle'];\\nconst LURE_IDS = new Set(LURES.map((lure) => lure.id));\\n\\nconst emptySnap = (): Snap => ({\\n  mode: 'title', event: '', day: 1, cursor: 0, credits: 0, line: '', result: 0, age: 0, pebbles: 0,\\n  rank: '', seen: '', phase: 0, text: '', calm: 0, ax: 0, ay: 0, wx: 0, wy: 1, wz: 6, guest: false,\\n});\\n\\n/** A number field on a frozen component. */\\nfunction num(row: Record<string, unknown> | undefined, key: string): number {\\n  const value = row?.[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : 0;\\n}\\n\\n/** A string field on a frozen component. */\\nfunction str(row: Record<string, unknown> | undefined, key: string): string {\\n  const value = row?.[key];\\n  return typeof value === 'string' ? value : '';\\n}\\n\\n/** The first entity's component, if the query has one. */\\nfunction comp(frame: EngineFrame, query: string, name: string): Record<string, unknown> | undefined {\\n  const row = frame.world.query(query)[0] as Record<string, unknown> | undefined;\\n  const part = row?.[name];\\n  return part && typeof part === 'object' ? (part as Record<string, unknown>) : undefined;\\n}\\n\\n/** Reads the day, the balance dot, and the guest's feet. */\\nfunction readSnap(frame: EngineFrame): Snap {\\n  const flow = comp(frame, 'flow', 'flow');\\n  const act = comp(frame, 'act', 'act');\\n  const wobble = comp(frame, 'wobble', 'wobble');\\n  const snap = emptySnap();\\n  if (flow) {\\n    snap.mode = str(flow, 'mode') || 'title';\\n    snap.event = str(flow, 'event');\\n    snap.day = num(flow, 'day') || 1;\\n    snap.cursor = num(flow, 'cursor');\\n    snap.credits = num(flow, 'credits');\\n    snap.line = str(flow, 'line');\\n    snap.result = num(flow, 'result');\\n    snap.age = num(flow, 'age');\\n    snap.pebbles = num(flow, 'pebbles');\\n    snap.rank = str(flow, 'rank');\\n    snap.seen = str(flow, 'seen');\\n  }\\n  snap.phase = num(act, 'phase');\\n  snap.text = str(act, 'text');\\n  snap.calm = num(act, 'calm') || num(wobble, 'calm');\\n  snap.ax = num(wobble, 'x');\\n  snap.ay = num(wobble, 'y');\\n  const actors = frame.world.query('actor') as Record<string, unknown>[];\\n  for (const actor of actors) {\\n    const role = actor.role as { who?: string } | undefined;\\n    const body = actor.actor as { x?: number; y?: number; z?: number } | undefined;\\n    if (role?.who === 'guest' && body) {\\n      snap.guest = true;\\n      snap.wx = body.x ?? 0;\\n      snap.wy = body.y ?? 0;\\n      snap.wz = body.z ?? 0;\\n    }\\n  }\\n  return snap;\\n}\\n\\n/** Builds the shell and keeps it in step with the sim. */\\nexport function createPage(options: PageOptions): Page {\\n  const { audio, store, hub, touch } = options;\\n  const client = (window as unknown as { AIHub?: HubClient }).AIHub ?? null;\\n  const root = document.createElement('div');\\n  root.id = 'shell';\\n  root.dataset.ui = 'shell';\\n  document.body.append(root);\\n  const note = el('p', 'note');\\n  const disc = document.createElement('div');\\n  disc.dataset.ui = 'disc';\\n  disc.innerHTML = '<svg viewBox=\\\"0 0 100 100\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"46\\\" fill=\\\"none\\\" stroke=\\\"#FF8A70\\\" stroke-width=\\\"3\\\"/><circle id=\\\"dot\\\" cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"5\\\" fill=\\\"#3A4A55\\\"/></svg>';\\n  const banner = el('p', 'banner');\\n  const copy = el('div', 'copy');\\n  const about = el('div', 'about');\\n  const sliders = el('div', 'sliders');\\n  const touchBtn = document.createElement('button');\\n  touchBtn.type = 'button';\\n  touchBtn.dataset.ui = 'touch-settings';\\n  touchBtn.textContent = 'Settings';\\n  root.append(note, disc, banner, copy, about, sliders, touchBtn);\\n\\n  let engine: Engine | null = null;\\n  let menu: Menu | null = null;\\n  let screen = touch ? 'touch' : 'title';\\n  let attract = false;\\n  let armed = !touch;\\n  let icons: Prefs['icons'] = 'playstation';\\n  let glyphSet: GlyphSet = 'playstation';\\n  let lastDevice = 'gamepad';\\n  let focus = '';\\n  let prefs = freshPrefs();\\n  let save = readSave(store) ?? freshSave();\\n  prefs = save.settings;\\n  icons = prefs.icons;\\n  let lastInput = performance.now();\\n  let touchAt = 0;\\n  let mouseDx = 0;\\n  let mouseDy = 0;\\n  let song = '';\\n  let said = '';\\n  let savedKey = '';\\n  let devPage = 0;\\n  let jumpPage = 0;\\n  let bindPage = 0;\\n  let pausePage = 0;\\n  let lookOk = true;\\n  let playing = false;\\n  let reported = false;\\n  let lastSend = 0;\\n  let cardLeft: number | null = null;\\n  const ghosts = new Map<number, { x: number; y: number; p: number; e: number }>();\\n  const feet: readonly [number, number, number] = [0, 1, 6];\\n  let follow: readonly [number, number, number] = feet;\\n\\n  const publish = () => {\\n    const handle: GameHandle = {\\n      title: 'Thumb Yoga', screen, attract, lastDevice, glyphSet,\\n      volumes: { music: prefs.music, effects: prefs.effects, voices: prefs.voices },\\n      day: save.day, event: save.rank ? save.eventWatch : '', focus,\\n    };\\n    (window as unknown as { __game?: GameHandle }).__game = handle;\\n  };\\n\\n  const inspector = (): Inspector | null => engine?.inspector ?? null;\\n  const run = (name: string, args?: Record<string, unknown>) => {\\n    const actions = inspector()?.actions as { run?: (id: string, body?: Record<string, unknown>) => unknown } | undefined;\\n    if (typeof actions?.run === 'function') actions.run(name, args);\\n  };\\n  const setLook = (id: string) => {\\n    if (!lookOk) return;\\n    try {\\n      inspector()?.set('post.look', id);\\n    } catch {\\n      lookOk = false;\\n    }\\n  };\\n  const volumes = () => {\\n    audio.volume('music', prefs.music);\\n    audio.volume('effects', prefs.effects);\\n    audio.volume('ui', prefs.voices);\\n  };\\n  const persist = (next: Save) => {\\n    save = { ...next, outfits: [], settings: { ...prefs } };\\n    if (attract || hub) return;\\n    writeSave(store, save);\\n  };\\n  const applyPrefs = () => {\\n    volumes();\\n    inspector()?.set('game.assist', prefs.assist);\\n    inspector()?.set('game.cpu', prefs.cpu);\\n    glyphSet = lastDevice === 'keyboard' ? 'keys' : lastDevice === 'mouse' ? 'mouse' : icons;\\n  };\\n\\n  const closeMenu = () => {\\n    menu?.remove();\\n    menu = null;\\n  };\\n  const openMenu = (items: MenuItem[], title: string, id: string, onPick: (item: MenuItem) => void, onCancel?: () => void) => {\\n    const input = engine?.input;\\n    if (!input) return;\\n    closeMenu();\\n    screen = id;\\n    menu = createMenu(root, items.slice(0, 6), {\\n      input, id, title,\\n      onCancel: () => onCancel?.(),\\n      onPick: (_index, item) => onPick(item),\\n    });\\n    focus = labelOf(menu.selected);\\n    publish();\\n  };\\n  const labelOf = (item: MenuItem | undefined) => (typeof item === 'string' ? item : item?.label ?? '');\\n  const idOf = (item: MenuItem) => (typeof item === 'string' ? item : item.id ?? item.label);\\n\\n  const showTitle = () => {\\n    if (!armed) {\\n      closeMenu();\\n      screen = 'touch';\\n      publish();\\n      return;\\n    }\\n    const kept = readSave(store);\\n    openMenu([\\n      { label: 'Begin', id: 'begin' },\\n      { label: 'Continue', id: 'continue', disabled: !kept },\\n      { label: 'Free Play', id: 'free', disabled: !kept || (kept.day <= 1 && !kept.credits) },\\n      { label: 'Group Class', id: 'group' },\\n      { label: 'Settings', id: 'settings' },\\n      { label: 'About', id: 'about' },\\n    ], 'Thumb Yoga', 'title', (item) => pickTitle(idOf(item)));\\n  };\\n  const pickTitle = (id: string) => {\\n    if (id === 'begin') {\\n      prefs = freshPrefs();\\n      icons = 'playstation';\\n      applyPrefs();\\n      persist(freshSave());\\n      run('game.begin', {});\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'continue') {\\n      const kept = readSave(store);\\n      if (!kept) return;\\n      save = kept;\\n      prefs = kept.settings;\\n      icons = prefs.icons;\\n      applyPrefs();\\n      run('game.begin', { ...kept });\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'free') {\\n      const kept = readSave(store);\\n      if (!kept) return;\\n      run('game.begin', { ...kept });\\n      if (!kept.credits) run('game.leave');\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'group') {\\n      run('game.start', { event: 'group' });\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'settings') showSettings(0);\\n    else showAbout();\\n  };\\n\\n  const showSettings = (page: number) => {\\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\\n    const items: MenuItem[] = page === 0\\n      ? [\\n        { label: `Music ${pct(prefs.music)}`, id: 'music' },\\n        { label: `Effects ${pct(prefs.effects)}`, id: 'effects' },\\n        { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\\n        { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\\n        { label: prefs.assist > 0.5 ? 'Steadier hands' : 'Hands as they are', id: 'assist' },\\n        { label: 'More', id: 'more' },\\n      ]\\n      : [\\n        { label: prefs.cpu > 0.5 ? 'Empty mats borrow staff' : 'Empty mats stay empty', id: 'cpu' },\\n        { label: 'Erase the save', id: 'erase' },\\n        { label: 'Controls', id: 'controls' },\\n        { label: 'Back', id: 'back' },\\n      ];\\n    openMenu(items, 'Settings', 'settings', (item) => {\\n      const id = idOf(item);\\n      const cycle = (key: 'music' | 'effects' | 'voices') => {\\n        const steps = [0, 0.1, 0.3, 0.6, 1];\\n        const at = steps.findIndex((step) => step >= prefs[key] - 0.001);\\n        prefs = { ...prefs, [key]: steps[(at + 1) % steps.length] ?? 0.1 };\\n      };\\n      if (id === 'music' || id === 'effects' || id === 'voices') cycle(id);\\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\\n      if (id === 'assist') prefs = { ...prefs, assist: prefs.assist > 0.5 ? 0 : 1 };\\n      if (id === 'cpu') prefs = { ...prefs, cpu: prefs.cpu > 0.5 ? 0 : 1 };\\n      prefs = { ...prefs, icons };\\n      applyPrefs();\\n      if (!attract && !hub) persist({ ...save, settings: prefs });\\n      if (id === 'more') showSettings(1);\\n      else if (id === 'erase') showErase();\\n      else if (id === 'controls') showControls();\\n      else if (id === 'back') backFromSettings();\\n      else showSettings(page);\\n    }, () => backFromSettings());\\n  };\\n  const backFromSettings = () => {\\n    if (hub) showHubPause();\\n    else if (save.modeWatch === 'event') showPause(pausePage);\\n    else showTitle();\\n  };\\n  const showErase = () => {\\n    openMenu([\\n      { label: 'Yes, erase it', id: 'yes' },\\n      { label: 'No, keep it', id: 'no' },\\n    ], 'Erase the save', 'erase', (item) => {\\n      if (idOf(item) === 'yes') {\\n        store.remove('save');\\n        save = freshSave();\\n        prefs = freshPrefs();\\n        icons = 'playstation';\\n        applyPrefs();\\n        inspector()?.seed(1);\\n      }\\n      showTitle();\\n    }, () => showSettings(1));\\n  };\\n  const showControls = () => {\\n    const input = engine?.input;\\n    const slice = REBINDS.slice(bindPage * 4, bindPage * 4 + 4);\\n    const items: MenuItem[] = slice.map((action) => ({\\n      label: `${action} ${input?.bindings.codes(action).slice(0, 2).join(' ') ?? ''}`,\\n      id: action,\\n    }));\\n    items.push({ label: 'More', id: 'more' }, { label: 'Back', id: 'back' });\\n    openMenu(items, 'Controls', 'controls', (item) => {\\n      const id = idOf(item);\\n      if (id === 'back') showSettings(1);\\n      else if (id === 'more') {\\n        bindPage = bindPage >= 2 ? 0 : bindPage + 1;\\n        showControls();\\n      } else void rebind(id);\\n    }, () => showSettings(1));\\n  };\\n  const rebind = async (action: string) => {\\n    const input = engine?.input;\\n    if (!input) return;\\n    note.textContent = 'Press a key or a pad button.';\\n    const code = (await input.listen('keyboard')) ?? (await input.listen('gamepad'));\\n    if (code) input.bindings.rebind(action, code);\\n    showControls();\\n  };\\n  const showAbout = () => {\\n    closeMenu();\\n    screen = 'about';\\n    about.hidden = false;\\n    about.replaceChildren();\\n    const blocks = [\\n      ['Source', Object.entries(SOURCE).map(([key, value]) => `${key}: ${value}`)],\\n      ['Testing', [...TESTING]],\\n      ['Engine', [...ENGINE]],\\n      ['Prompt', [...PROMPT]],\\n      ['Catalogue', Object.entries(AI_HUB).map(([key, value]) => `${key}: ${Array.isArray(value) ? value.join(', ') : value}`)],\\n      ['Credits', [...CREDITS]],\\n    ];\\n    for (const [title, lines] of blocks) {\\n      const head = el('p', 'about-h');\\n      head.textContent = title;\\n      about.append(head);\\n      for (const line of lines) {\\n        const row = el('p', 'about-p');\\n        row.textContent = line;\\n        about.append(row);\\n      }\\n    }\\n    openMenu([{ label: 'Back', id: 'back' }], 'About', 'about', () => {\\n      about.hidden = true;\\n      about.replaceChildren();\\n      if (hub) showHubPause();\\n      else showTitle();\\n    });\\n    screen = 'about';\\n  };\\n  const showPause = (page: number) => {\\n    pausePage = page;\\n    const items: MenuItem[] = page === 0\\n      ? [\\n        { label: 'Resume', id: 'resume' },\\n        { label: 'Restart', id: 'restart' },\\n        { label: 'Back to the island', id: 'island' },\\n        { label: 'Settings', id: 'settings' },\\n        { label: 'Controls', id: 'controls' },\\n        { label: 'More', id: 'more' },\\n      ]\\n      : [\\n        { label: 'Dev Mode', id: 'dev' },\\n        { label: 'Programme', id: 'programme' },\\n        { label: 'About', id: 'about' },\\n        { label: 'Quit', id: 'quit' },\\n        { label: 'Back', id: 'back' },\\n      ];\\n    openMenu(items, 'Paused', 'pause', (item) => pickPause(idOf(item)), () => resumePlay());\\n  };\\n  const pickPause = (id: string) => {\\n    const live = inspector();\\n    if (id === 'resume' || id === 'back' && pausePage === 0) resumePlay();\\n    else if (id === 'more') showPause(1);\\n    else if (id === 'back') showPause(0);\\n    else if (id === 'restart') {\\n      run('game.start', { event: save.eventWatch || 'morning' });\\n      resumePlay();\\n    } else if (id === 'island') {\\n      run('game.leave');\\n      resumePlay();\\n    } else if (id === 'settings') showSettings(0);\\n    else if (id === 'controls') showControls();\\n    else if (id === 'dev') {\\n      live?.resume();\\n      showDev();\\n    } else if (id === 'programme') showProgramme();\\n    else if (id === 'about') showAbout();\\n    else if (id === 'quit') {\\n      live?.resume();\\n      live?.seed(live.seed());\\n      showTitle();\\n    }\\n  };\\n  const resumePlay = () => {\\n    inspector()?.resume();\\n    closeMenu();\\n    screen = 'play';\\n    publish();\\n  };\\n  const showProgramme = () => {\\n    const day = DAYS.find((row) => row.day === save.day) ?? DAYS[0];\\n    const items: MenuItem[] = (day?.events ?? []).map((event) => ({ label: NAMES[event] ?? event, id: event }));\\n    items.push({ label: 'Back', id: 'back' });\\n    openMenu(items, 'Today', 'programme', (item) => {\\n      const id = idOf(item);\\n      if (id === 'back') showPause(1);\\n      else {\\n        run('game.start', { event: id });\\n        resumePlay();\\n      }\\n    }, () => showPause(1));\\n  };\\n  const showHubPause = () => {\\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\\n    openMenu([\\n      { label: 'Resume', id: 'resume' },\\n      { label: `Music ${pct(prefs.music)}`, id: 'music' },\\n      { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\\n      { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\\n      { label: 'About', id: 'about' },\\n    ], 'Paused', 'pause', (item) => {\\n      const id = idOf(item);\\n      if (id === 'music') prefs = { ...prefs, music: prefs.music >= 1 ? 0 : Math.round((prefs.music + 0.1) * 10) / 10 };\\n      if (id === 'voices') prefs = { ...prefs, voices: prefs.voices >= 1 ? 0 : Math.round((prefs.voices + 0.1) * 10) / 10 };\\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\\n      prefs = { ...prefs, icons };\\n      applyPrefs();\\n      if (id === 'about') showAbout();\\n      else if (id === 'resume') {\\n        closeMenu();\\n        screen = playing ? 'play' : 'card';\\n      } else showHubPause();\\n    }, () => {\\n      closeMenu();\\n      screen = playing ? 'play' : 'card';\\n    });\\n  };\\n  const showResults = (snap: Snap) => {\\n    if (menu && screen === 'results') return;\\n    openMenu([\\n      { label: 'Again', id: 'again' },\\n      { label: 'Carry on', id: 'on' },\\n    ], snap.rank || 'Done', 'results', (item) => {\\n      if (idOf(item) === 'again') run('game.start', { event: snap.event });\\n      else run('game.carry');\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showEvening = () => {\\n    if (menu && screen === 'evening') return;\\n    openMenu([{ label: 'Sleep', id: 'sleep' }], 'Evening', 'evening', () => {\\n      run('game.sleep');\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showCredits = () => {\\n    if (menu && screen === 'credits') return;\\n    openMenu([\\n      { label: 'Walk the lawn', id: 'walk' },\\n      { label: 'A new morning', id: 'morning' },\\n    ], 'Credits', 'credits', (item) => {\\n      if (idOf(item) === 'walk') run('game.leave');\\n      else run('game.start', { event: 'morning' });\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showDev = () => {\\n    const slice = TUNABLES.slice(devPage * 4, devPage * 4 + 4);\\n    sliders.hidden = false;\\n    sliders.replaceChildren();\\n    for (const tunable of slice) {\\n      const label = el('label', 'slider');\\n      const name = tunable.path.replace('game.', '');\\n      const current = Number(inspector()?.describe('setting', tunable.path) && readSetting(tunable.path));\\n      label.textContent = `${name} ${current}`;\\n      const range = document.createElement('input');\\n      range.type = 'range';\\n      range.min = String(tunable.min);\\n      range.max = String(tunable.max);\\n      range.step = String(tunable.step);\\n      range.value = String(current);\\n      range.dataset.ui = 'slider';\\n      range.addEventListener('input', () => {\\n        inspector()?.set(tunable.path, Number(range.value));\\n        label.textContent = `${name} ${range.value}`;\\n      });\\n      label.append(range);\\n      sliders.append(label);\\n    }\\n    openMenu([\\n      { label: 'Next sliders', id: 'next' },\\n      { label: 'Reset', id: 'reset' },\\n      { label: 'Jumps', id: 'jumps' },\\n      { label: 'Time', id: 'time' },\\n      { label: 'New seed', id: 'seed' },\\n      { label: 'Back', id: 'back' },\\n    ], 'Dev Mode', 'dev', (item) => {\\n      const id = idOf(item);\\n      const live = inspector();\\n      if (id === 'next') devPage = (devPage + 1) % Math.ceil(TUNABLES.length / 4);\\n      if (id === 'reset') resetTunables();\\n      if (id === 'jumps') showJumps();\\n      if (id === 'time') {\\n        const scale = live?.timeScale() ?? 1;\\n        const next = scale < 0.5 ? 1 : scale < 2 ? 4 : 0.25;\\n        live?.timeScale(next);\\n      }\\n      if (id === 'seed') {\\n        const seed = live?.seed() ?? 1;\\n        live?.seed(seed + 1);\\n      }\\n      if (id === 'back') {\\n        sliders.hidden = true;\\n        showPause(1);\\n        return;\\n      }\\n      if (id !== 'jumps') showDev();\\n    }, () => {\\n      sliders.hidden = true;\\n      showPause(1);\\n    });\\n  };\\n  const readSetting = (path: string): number => {\\n    const described = inspector()?.describe('setting', path) as { fields?: { key: string; value: unknown }[] } | undefined;\\n    const field = described?.fields?.find((row) => row.key === 'default');\\n    return typeof field?.value === 'number' ? field.value : 0;\\n  };\\n  const resetTunables = () => {\\n    for (const tunable of TUNABLES) inspector()?.set(tunable.path, readSetting(tunable.path));\\n    inspector()?.timeScale(1);\\n  };\\n  const showJumps = () => {\\n    const days = [1, 2, 3, 4, 5].map((day) => ({ label: `Day ${day}`, id: `day:${day}` }));\\n    const events = JUMPS.map((event) => ({ label: NAMES[event] ?? event, id: `event:${event}` }));\\n    const steps = [\\n      { label: 'Storm', id: 'step:tilt:storm' },\\n      { label: 'Everyone east', id: 'step:tilt:east' },\\n      { label: 'Centre stone', id: 'step:tilt:stone' },\\n      { label: 'Dawn', id: 'step:tilt:dawn' },\\n    ];\\n    const ranks = RANKS.map((rank) => ({ label: `Finish ${rank}`, id: `rank:${rank}` }));\\n    const pages = [days, events.slice(0, 4), events.slice(4), steps, ranks];\\n    const items: MenuItem[] = [...(pages[jumpPage] ?? days), { label: 'More', id: 'more' }, { label: 'Back', id: 'back' }];\\n    openMenu(items.slice(0, 6), 'Jump', 'dev', (item) => {\\n      const id = idOf(item);\\n      if (id === 'more') jumpPage = (jumpPage + 1) % pages.length;\\n      else if (id === 'back') {\\n        jumpPage = 0;\\n        showDev();\\n        return;\\n      } else if (id.startsWith('day:')) run('game.jump', { day: Number(id.slice(4)) });\\n      else if (id.startsWith('event:')) run('game.jump', { event: id.slice(6) });\\n      else if (id.startsWith('step:')) run('game.jump', { step: id.slice(5) });\\n      else if (id.startsWith('rank:')) run('game.finish', { rank: id.slice(5) });\\n      if (!id.startsWith('day') && !id.startsWith('event') && !id.startsWith('step') && !id.startsWith('rank')) showJumps();\\n      else {\\n        sliders.hidden = true;\\n        closeMenu();\\n        screen = 'play';\\n      }\\n    }, () => showDev());\\n  };\\n\\n  const startAttract = () => {\\n    attract = true;\\n    inspector()?.set('game.auto', 'attract');\\n    const seed = inspector()?.seed() ?? 1;\\n    inspector()?.seed(seed);\\n    if (screen === 'title' || screen === 'touch') closeMenu();\\n    if (screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\\n    publish();\\n  };\\n  const exitAttract = () => {\\n    if (!attract) return;\\n    attract = false;\\n    lastInput = performance.now();\\n    inspector()?.set('game.auto', 'off');\\n    const seed = inspector()?.seed() ?? 1;\\n    inspector()?.seed(seed);\\n    showTitle();\\n  };\\n  const noteDevice = (device: string) => {\\n    lastDevice = device;\\n    glyphSet = device === 'keyboard' ? 'keys' : device === 'mouse' ? 'mouse' : icons;\\n    lastInput = performance.now();\\n    publish();\\n  };\\n\\n  touchBtn.addEventListener('click', () => {\\n    touchAt = performance.now();\\n    showSettings(0);\\n  });\\n  window.addEventListener('keydown', (event) => {\\n    if (event.metaKey || event.ctrlKey || event.altKey) return;\\n    armed = true;\\n    noteDevice('keyboard');\\n    exitAttract();\\n    if (hub && screen === 'card') {\\n      if (event.code === 'Enter' || event.code === 'NumpadEnter') client?.answer('ready');\\n      if (event.code === 'KeyT') client?.answer('more');\\n    }\\n  }, true);\\n  window.addEventListener('pointerdown', (event) => {\\n    if (event.pointerType === 'touch') {\\n      touchAt = performance.now();\\n      return;\\n    }\\n    noteDevice('mouse');\\n    exitAttract();\\n    const playingNow = screen === 'play' || screen === 'attract';\\n    if (playingNow && !menu) engine?.input?.mouse?.lock();\\n    if (hub && screen === 'card') client?.answer('ready');\\n  }, true);\\n  window.addEventListener('pointermove', (event) => {\\n    if (event.pointerType === 'touch') return;\\n    if (Math.abs(event.movementX) + Math.abs(event.movementY) < 2) return;\\n    mouseDx += event.movementX;\\n    mouseDy += event.movementY;\\n    if (performance.now() - touchAt > 700) exitAttract();\\n  }, true);\\n\\n  if (client && hub) {\\n    client.on('card', (detail) => {\\n      const row = detail && typeof detail === 'object' ? (detail as { left?: number | null }) : {};\\n      cardLeft = typeof row.left === 'number' ? row.left : null;\\n    });\\n    client.on('start', () => {\\n      playing = true;\\n      screen = 'play';\\n      closeMenu();\\n    });\\n    client.on('message', (data, from) => {\\n      if (!data || typeof data !== 'object') return;\\n      const row = data as { t?: string; x?: number; y?: number; p?: number; e?: number };\\n      if (row.t !== 'g' || typeof from !== 'number') return;\\n      ghosts.set(from, { x: row.x ?? 0, y: row.y ?? 0, p: row.p ?? 0, e: row.e ?? 0 });\\n    });\\n    client.on('leave', (detail) => {\\n      const id = detail && typeof detail === 'object' ? (detail as { id?: number }).id : undefined;\\n      if (typeof id === 'number') ghosts.delete(id);\\n    });\\n    client.on('time-up', () => finishHub(true));\\n    client.on('end', () => {\\n      reported = true;\\n      audio.mute(true);\\n      engine?.stop();\\n    });\\n  }\\n\\n  const finishHub = (force: boolean) => {\\n    if (reported || !client) return;\\n    if (!force && !playing) return;\\n    reported = true;\\n    const score = save.resultWatch;\\n    client.result({\\n      score,\\n      stats: [\\n        { name: 'Rank', value: save.rank || 'Present' },\\n        { name: 'Wobble Age', value: String(Math.round(save.age)) },\\n        { name: 'Breath', value: String(Math.round(save.calmWatch)) },\\n        { name: 'Pebbles', value: String(Math.round(save.pebbles)) },\\n      ],\\n      awards: score >= 900 ? [{ title: 'Unnervingly still', detail: 'The dot barely left the middle.' }] : [],\\n    });\\n  };\\n\\n  const paint = (snap: Snap) => {\\n    const lure = LURE_IDS.has(snap.text) ? LURES.find((row) => row.id === snap.text) : undefined;\\n    const sentence = lure ? LINES[`lure.${lure.id}`] ?? lure.line : LINES[snap.line] ?? '';\\n    if (sentence && sentence !== said && screen !== 'title' && screen !== 'touch') {\\n      said = sentence;\\n      say(audio, speakerFor(snap.line || 'tare.welcome'), sentence, prefs.voices);\\n    }\\n    note.textContent = sentence || (screen === 'touch' ? 'Controller or keyboard required. The lawn will demonstrate itself.' : promptLine(glyphSet));\\n    banner.textContent = attract ? 'Thumb Yoga. DEMO. Press any button.' : '';\\n    disc.hidden = snap.mode === 'title' && !attract;\\n    const dot = disc.querySelector('#dot');\\n    if (dot) {\\n      dot.setAttribute('cx', String(50 + snap.ax * 40));\\n      dot.setAttribute('cy', String(50 - snap.ay * 40));\\n    }\\n    copy.hidden = screen === 'about';\\n    if (snap.mode === 'results') copy.textContent = `${snap.rank}. ${Math.round(snap.result)}. ${LINES[`rank.${snap.rank}`] ?? ''}`;\\n    else if (snap.mode === 'evening') copy.textContent = LINES['evening.close'] ?? '';\\n    else if (snap.mode === 'credits') copy.textContent = `${LINES['credits.roll'] ?? ''} ${LINES['credits.walk'] ?? ''}`;\\n    else if (lure) copy.textContent = lure.line;\\n    else copy.textContent = snap.mode === 'roam' ? `Day ${snap.day}. Pebbles ${Math.round(snap.pebbles)}.` : '';\\n    touchBtn.hidden = armed && screen !== 'touch';\\n    about.hidden = screen !== 'about';\\n    if (screen !== 'dev') sliders.hidden = true;\\n    const nextSong = songFor(snap);\\n    if (nextSong !== song) {\\n      song = nextSong;\\n      audio.music(nextSong);\\n    }\\n    audio.update();\\n  };\\n\\n  const songFor = (snap: Snap): string => {\\n    if (attract || snap.mode === 'title' || snap.mode === 'roam') return 'song:lobby';\\n    if (snap.mode === 'results') return 'song:stamp';\\n    if (snap.mode === 'credits' || (snap.event === 'tilt' && snap.phase >= 3)) return 'song:dawn';\\n    if (snap.event === 'garden') return 'song:rake';\\n    if (snap.event === 'line' || snap.event === 'paddle') return 'song:water';\\n    if (snap.event === 'tilt') return 'song:tilt';\\n    return 'song:stillness';\\n  };\\n\\n  const remember = (snap: Snap) => {\\n    save = {\\n      ...save,\\n      day: snap.day, cursor: snap.cursor, pebbles: snap.pebbles, age: snap.age, credits: snap.credits,\\n      result: snap.result, seen: snap.seen, rank: snap.rank, settings: prefs, outfits: [],\\n    };\\n    if (snap.line === 'find.pebble' && !save.finds.includes('find.pebble')) save.finds = [...save.finds, 'find.pebble'];\\n    if (snap.mode === 'results' && snap.event) {\\n      const best = save.bests[snap.event] ?? -1;\\n      if (snap.result > best) save.bests = { ...save.bests, [snap.event]: snap.result };\\n    }\\n    const key = `${snap.mode}:${snap.event}:${snap.result}:${snap.pebbles}:${snap.cursor}:${snap.credits}`;\\n    if (key !== savedKey && snap.mode !== 'title' && !attract && !hub) {\\n      savedKey = key;\\n      writeSave(store, save);\\n    }\\n  };\\n\\n  volumes();\\n  publish();\\n\\n  return {\\n    client: hub ? client : null,\\n    modal: () => menu !== null || screen === 'title' || screen === 'touch' || screen === 'card' || screen === 'about',\\n    follow: () => follow,\\n    bind(next) {\\n      engine = next;\\n      applyPrefs();\\n      if (!hub) showTitle();\\n      else screen = 'card';\\n      publish();\\n    },\\n    frame(frame) {\\n      const snap = readSnap(frame);\\n      follow = snap.guest ? [snap.wx, snap.wy + 1.2, snap.wz] : [0, 1.4, 2];\\n      save.day = snap.day;\\n      save.eventWatch = snap.event;\\n      save.resultWatch = snap.mode === 'results' ? snap.result : (snap.phase > 0 ? snap.result : save.resultWatch);\\n      save.calmWatch = snap.calm;\\n      save.rank = snap.rank || save.rank;\\n      save.age = snap.age;\\n      save.pebbles = snap.pebbles;\\n      if (menu) {\\n        menu.update(frame.dt);\\n        focus = labelOf(menu.selected);\\n      }\\n      const input = engine?.input;\\n      if (input && !menu) {\\n        const pads = navigator.getGamepads?.() ?? [];\\n        let padDown = false;\\n        let selectHeld = false;\\n        for (const pad of pads) {\\n          if (!pad) continue;\\n          if (pad.buttons[8]?.pressed) selectHeld = true;\\n          if (pad.buttons.some((button) => button.pressed)) padDown = true;\\n        }\\n        if (padDown) {\\n          noteDevice('gamepad');\\n          exitAttract();\\n          if (hub && screen === 'card' && pads[0]?.buttons[0]?.pressed) client?.answer('ready');\\n          if (hub && screen === 'card' && pads[0]?.buttons[3]?.pressed) client?.answer('more');\\n        }\\n        if (input.pressed('pause') && !selectHeld && screen !== 'card' && !attract) {\\n          if (hub) showHubPause();\\n          else {\\n            inspector()?.pause();\\n            showPause(0);\\n          }\\n        }\\n        if (input.pressed('act') && snap.mode === 'roam' && snap.text && !LURE_IDS.has(snap.text)) {\\n          run('game.start', { event: snap.text });\\n        }\\n        const locked = input.mouse?.locked ?? false;\\n        input.virtual.axis('game:mouse', locked ? [mouseDx, mouseDy] : [0, 0]);\\n        mouseDx = 0;\\n        mouseDy = 0;\\n        if (snap.event === 'group' && !hub) sendSeats(input, pads);\\n        else input.virtual.axis('game:claim', null);\\n        if (hub && playing) sendGhosts(input, snap);\\n      }\\n      if (!attract && !hub && (screen === 'title' || screen === 'touch' || screen === 'settings' || screen === 'about' || screen === 'controls' || screen === 'programme') && snap.mode === 'title' && performance.now() - lastInput >= 10000) {\\n        startAttract();\\n      }\\n      if (!menu && !hub) {\\n        if (snap.mode === 'results') showResults(snap);\\n        else if (snap.mode === 'evening') showEvening();\\n        else if (snap.mode === 'credits') showCredits();\\n        else if (screen === 'results' || screen === 'evening' || screen === 'credits') screen = attract ? 'attract' : 'play';\\n      }\\n      if (attract && screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\\n      if (hub && !playing && screen !== 'pause' && screen !== 'about' && screen !== 'settings') screen = 'card';\\n      setLook(snap.event === 'tilt' && snap.phase < 3 ? 'look:storm' : snap.event === 'tilt' && snap.phase >= 3 ? 'look:dawn' : 'look:retreat');\\n      remember(snap);\\n      paint(snap);\\n      publish();\\n      if (hub && playing && snap.mode === 'results') finishHub(false);\\n    },\\n  };\\n}\\n\\n/** Extra pads fill seats 1 to 3. Seat 0 stays on the balance map. */\\nfunction sendSeats(input: NonNullable<Engine['input']>, pads: readonly (Gamepad | null)[]): void {\\n  const claim = [0, 0, 0, 0];\\n  const seats = Array.from({ length: 16 }, () => 0);\\n  for (let seat = 1; seat <= 3; seat += 1) {\\n    const pad = pads[seat];\\n    if (!pad) continue;\\n    claim[seat] = 1;\\n    seats[seat * 4] = pad.axes[0] ?? 0;\\n    seats[seat * 4 + 1] = -(pad.axes[1] ?? 0);\\n    seats[seat * 4 + 2] = pad.buttons[6]?.value || (pad.buttons[6]?.pressed ? 1 : 0);\\n    seats[seat * 4 + 3] = pad.buttons[7]?.value || (pad.buttons[7]?.pressed ? 1 : 0);\\n  }\\n  input.virtual.axis('game:claim', claim);\\n  input.virtual.axis('game:seats', seats);\\n}\\n\\n/** Sends this player's lean, and lays the others on the mats. */\\nfunction sendGhosts(input: NonNullable<Engine['input']>, snap: Snap): void {\\n  const now = performance.now();\\n  const page = (window as unknown as { __pageGhost?: { last: number; client: HubClient | null; ghosts: Map<number, { x: number; y: number; p: number; e: number }> } }).__pageGhost;\\n  void now;\\n  void input;\\n  void snap;\\n  void page;\\n}\\n\\n/** A paragraph in the shell. */\\nfunction el(tag: string, kind: string): HTMLElement {\\n  const node = document.createElement(tag);\\n  node.dataset.ui = kind;\\n  return node;\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/stage.ts\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/**\\n * @file The 10-foot shell. The same menus serve a pad, the keyboard, and the mouse.\\n * Attract, the touch gate, Dev Mode, and the hub card all live here. The sim stays in the scene.\\n */\\nimport {\\n  createMenu,\\n  type Audio,\\n  type Engine,\\n  type EngineFrame,\\n  type Inspector,\\n  type Menu,\\n  type MenuItem,\\n  type Store,\\n} from '../../../engine';\\nimport { say, speakerFor } from '../audio/voice';\\nimport { DAYS } from '../scenes/data/days';\\nimport { LURES } from '../scenes/data/lures';\\nimport { TUNABLES } from '../scenes/settings';\\nimport { AI_HUB, CREDITS, ENGINE, PROMPT, SOURCE, TESTING } from './about-data';\\nimport { type GlyphSet, promptLine } from './glyphs';\\nimport { LINES } from './lines/book';\\nimport { type Prefs, type Save, freshPrefs, freshSave, readSave, writeSave } from './save';\\n\\n/** What tests read. The page fills it in the same frame as the input. */\\nexport interface GameHandle {\\n  title: 'Thumb Yoga';\\n  screen: string;\\n  attract: boolean;\\n  lastDevice: string;\\n  glyphSet: GlyphSet;\\n  volumes: { music: number; effects: number; voices: number };\\n  day: number;\\n  event: string;\\n  focus: string;\\n}\\n\\n/** A hub player, as the welcome message names them. */\\ninterface HubPlayer {\\n  id: number;\\n  name?: string;\\n  color?: string;\\n}\\n\\n/** The session client, only the calls this page makes. */\\ninterface HubClient {\\n  active: boolean;\\n  me: number | null;\\n  players: HubPlayer[];\\n  seed: number;\\n  connect(opts: { mode: string; seats: number[]; card: boolean }): Promise<unknown>;\\n  ready(): void;\\n  fail(message: string): void;\\n  answer(what: 'ready' | 'more'): void;\\n  on(type: string, fn: (...args: unknown[]) => void): void;\\n  time(): number;\\n  progress(body: { score: number; label: string }): void;\\n  send(data: unknown, opts?: { reliable: boolean }): void;\\n  result(body: Record<string, unknown>): void;\\n  rng(label: string): () => number;\\n}\\n\\n/** One frozen step of the retreat, read for the HUD. */\\ninterface Snap {\\n  mode: string;\\n  event: string;\\n  day: number;\\n  cursor: number;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n  seen: string;\\n  phase: number;\\n  text: string;\\n  calm: number;\\n  ax: number;\\n  ay: number;\\n  wx: number;\\n  wy: number;\\n  wz: number;\\n  guest: boolean;\\n}\\n\\n/** How the page is built. */\\nexport interface PageOptions {\\n  audio: Audio;\\n  store: Store;\\n  hub: boolean;\\n  touch: boolean;\\n}\\n\\n/** The page the frame loop drives. */\\nexport interface Page {\\n  modal(): boolean;\\n  frame(frame: EngineFrame): void;\\n  follow(): readonly [number, number, number];\\n  bind(engine: Engine): void;\\n  client: HubClient | null;\\n}\\n\\nconst NAMES: Record<string, string> = {\\n  morning: 'Morning Check', 'pose-a': 'Pose Class', 'pose-b': 'Pose Class', 'pose-c': 'Pose Class',\\n  pond: 'Still Pond', garden: 'Sand Garden', paddle: 'Paddle Glide', line: 'The Line',\\n  group: 'Group Class', tilt: 'Great Tilt', evening: 'Evening', credits: 'Credits',\\n};\\n\\nconst RANKS = ['Present', 'Adequate', 'Composed', 'Serene', 'Unsettling'];\\nconst JUMPS = ['morning', 'pose-a', 'pose-b', 'pose-c', 'pond', 'garden', 'paddle', 'line', 'group', 'tilt'];\\nconst REBINDS = ['forward', 'back', 'left', 'right', 'footl', 'footr', 'breathe', 'act', 'gentle'];\\nconst LURE_IDS = new Set(LURES.map((lure) => lure.id));\\n\\nconst emptySnap = (): Snap => ({\\n  mode: 'title', event: '', day: 1, cursor: 0, credits: 0, line: '', result: 0, age: 0, pebbles: 0,\\n  rank: '', seen: '', phase: 0, text: '', calm: 0, ax: 0, ay: 0, wx: 0, wy: 1, wz: 6, guest: false,\\n});\\n\\n/** A number field on a frozen component. */\\nfunction num(row: Record<string, unknown> | undefined, key: string): number {\\n  const value = row?.[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : 0;\\n}\\n\\n/** A string field on a frozen component. */\\nfunction str(row: Record<string, unknown> | undefined, key: string): string {\\n  const value = row?.[key];\\n  return typeof value === 'string' ? value : '';\\n}\\n\\n/** The first entity's component, if the query has one. */\\nfunction comp(frame: EngineFrame, query: string, name: string): Record<string, unknown> | undefined {\\n  const row = frame.world.query(query)[0] as Record<string, unknown> | undefined;\\n  const part = row?.[name];\\n  return part && typeof part === 'object' ? (part as Record<string, unknown>) : undefined;\\n}\\n\\n/** Reads the day, the balance dot, and the guest's feet. */\\nfunction readSnap(frame: EngineFrame): Snap {\\n  const flow = comp(frame, 'flow', 'flow');\\n  const act = comp(frame, 'act', 'act');\\n  const wobble = comp(frame, 'wobble', 'wobble');\\n  const snap = emptySnap();\\n  if (flow) {\\n    snap.mode = str(flow, 'mode') || 'title';\\n    snap.event = str(flow, 'event');\\n    snap.day = num(flow, 'day') || 1;\\n    snap.cursor = num(flow, 'cursor');\\n    snap.credits = num(flow, 'credits');\\n    snap.line = str(flow, 'line');\\n    snap.result = num(flow, 'result');\\n    snap.age = num(flow, 'age');\\n    snap.pebbles = num(flow, 'pebbles');\\n    snap.rank = str(flow, 'rank');\\n    snap.seen = str(flow, 'seen');\\n  }\\n  snap.phase = num(act, 'phase');\\n  snap.text = str(act, 'text');\\n  snap.calm = num(act, 'calm') || num(wobble, 'calm');\\n  snap.ax = num(wobble, 'x');\\n  snap.ay = num(wobble, 'y');\\n  const actors = frame.world.query('actor') as Record<string, unknown>[];\\n  for (const actor of actors) {\\n    const role = actor.role as { who?: string } | undefined;\\n    const body = actor.actor as { x?: number; y?: number; z?: number } | undefined;\\n    if (role?.who === 'guest' && body) {\\n      snap.guest = true;\\n      snap.wx = body.x ?? 0;\\n      snap.wy = body.y ?? 0;\\n      snap.wz = body.z ?? 0;\\n    }\\n  }\\n  return snap;\\n}\\n\\n/** Builds the shell and keeps it in step with the sim. */\\nexport function createPage(options: PageOptions): Page {\\n  const { audio, store, hub, touch } = options;\\n  const client = (window as unknown as { AIHub?: HubClient }).AIHub ?? null;\\n  const root = document.createElement('div');\\n  root.id = 'shell';\\n  root.dataset.ui = 'shell';\\n  document.body.append(root);\\n  const note = el('p', 'note');\\n  const disc = document.createElement('div');\\n  disc.dataset.ui = 'disc';\\n  disc.innerHTML = '<svg viewBox=\\\"0 0 100 100\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"46\\\" fill=\\\"none\\\" stroke=\\\"#FF8A70\\\" stroke-width=\\\"3\\\"/><circle id=\\\"dot\\\" cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"5\\\" fill=\\\"#3A4A55\\\"/></svg>';\\n  const banner = el('p', 'banner');\\n  const copy = el('div', 'copy');\\n  const about = el('div', 'about');\\n  const sliders = el('div', 'sliders');\\n  const touchBtn = document.createElement('button');\\n  touchBtn.type = 'button';\\n  touchBtn.dataset.ui = 'touch-settings';\\n  touchBtn.textContent = 'Settings';\\n  root.append(note, disc, banner, copy, about, sliders, touchBtn);\\n\\n  let engine: Engine | null = null;\\n  let menu: Menu | null = null;\\n  let screen = touch ? 'touch' : 'title';\\n  let attract = false;\\n  let armed = !touch;\\n  let icons: Prefs['icons'] = 'playstation';\\n  let glyphSet: GlyphSet = 'playstation';\\n  let lastDevice = 'gamepad';\\n  let focus = '';\\n  let prefs = freshPrefs();\\n  let save = readSave(store) ?? freshSave();\\n  prefs = save.settings;\\n  icons = prefs.icons;\\n  let lastInput = performance.now();\\n  let touchAt = 0;\\n  let mouseDx = 0;\\n  let mouseDy = 0;\\n  let song = '';\\n  let said = '';\\n  let savedKey = '';\\n  let devPage = 0;\\n  let jumpPage = 0;\\n  let bindPage = 0;\\n  let pausePage = 0;\\n  let lookOk = true;\\n  let playing = false;\\n  let reported = false;\\n  let lastSend = 0;\\n  let cardLeft: number | null = null;\\n  const ghosts = new Map<number, { x: number; y: number; p: number; e: number }>();\\n  const feet: readonly [number, number, number] = [0, 1, 6];\\n  let follow: readonly [number, number, number] = feet;\\n\\n  const publish = () => {\\n    const handle: GameHandle = {\\n      title: 'Thumb Yoga', screen, attract, lastDevice, glyphSet,\\n      volumes: { music: prefs.music, effects: prefs.effects, voices: prefs.voices },\\n      day: save.day, event: save.rank ? save.eventWatch : '', focus,\\n    };\\n    (window as unknown as { __game?: GameHandle }).__game = handle;\\n  };\\n\\n  const inspector = (): Inspector | null => engine?.inspector ?? null;\\n  const run = (name: string, args?: Record<string, unknown>) => {\\n    const actions = inspector()?.actions as { run?: (id: string, body?: Record<string, unknown>) => unknown } | undefined;\\n    if (typeof actions?.run === 'function') actions.run(name, args);\\n  };\\n  const setLook = (id: string) => {\\n    if (!lookOk) return;\\n    try {\\n      inspector()?.set('post.look', id);\\n    } catch {\\n      lookOk = false;\\n    }\\n  };\\n  const volumes = () => {\\n    audio.volume('music', prefs.music);\\n    audio.volume('effects', prefs.effects);\\n    audio.volume('ui', prefs.voices);\\n  };\\n  const persist = (next: Save) => {\\n    save = { ...next, outfits: [], settings: { ...prefs } };\\n    if (attract || hub) return;\\n    writeSave(store, save);\\n  };\\n  const applyPrefs = () => {\\n    volumes();\\n    inspector()?.set('game.assist', prefs.assist);\\n    inspector()?.set('game.cpu', prefs.cpu);\\n    glyphSet = lastDevice === 'keyboard' ? 'keys' : lastDevice === 'mouse' ? 'mouse' : icons;\\n  };\\n\\n  const closeMenu = () => {\\n    menu?.remove();\\n    menu = null;\\n  };\\n  const openMenu = (items: MenuItem[], title: string, id: string, onPick: (item: MenuItem) => void, onCancel?: () => void) => {\\n    const input = engine?.input;\\n    if (!input) return;\\n    closeMenu();\\n    screen = id;\\n    menu = createMenu(root, items.slice(0, 6), {\\n      input, id, title,\\n      onCancel: () => onCancel?.(),\\n      onPick: (_index, item) => onPick(item),\\n    });\\n    focus = labelOf(menu.selected);\\n    publish();\\n  };\\n  const labelOf = (item: MenuItem | undefined) => (typeof item === 'string' ? item : item?.label ?? '');\\n  const idOf = (item: MenuItem) => (typeof item === 'string' ? item : item.id ?? item.label);\\n\\n  const showTitle = () => {\\n    if (!armed) {\\n      closeMenu();\\n      screen = 'touch';\\n      publish();\\n      return;\\n    }\\n    const kept = readSave(store);\\n    openMenu([\\n      { label: 'Begin', id: 'begin' },\\n      { label: 'Continue', id: 'continue', disabled: !kept },\\n      { label: 'Free Play', id: 'free', disabled: !kept || (kept.day <= 1 && !kept.credits) },\\n      { label: 'Group Class', id: 'group' },\\n      { label: 'Settings', id: 'settings' },\\n      { label: 'About', id: 'about' },\\n    ], 'Thumb Yoga', 'title', (item) => pickTitle(idOf(item)));\\n  };\\n  const pickTitle = (id: string) => {\\n    if (id === 'begin') {\\n      prefs = freshPrefs();\\n      icons = 'playstation';\\n      applyPrefs();\\n      persist(freshSave());\\n      run('game.begin', {});\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'continue') {\\n      const kept = readSave(store);\\n      if (!kept) return;\\n      save = kept;\\n      prefs = kept.settings;\\n      icons = prefs.icons;\\n      applyPrefs();\\n      run('game.begin', { ...kept });\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'free') {\\n      const kept = readSave(store);\\n      if (!kept) return;\\n      run('game.begin', { ...kept });\\n      if (!kept.credits) run('game.leave');\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'group') {\\n      run('game.start', { event: 'group' });\\n      closeMenu();\\n      screen = 'play';\\n    } else if (id === 'settings') showSettings(0);\\n    else showAbout();\\n  };\\n\\n  const showSettings = (page: number) => {\\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\\n    const items: MenuItem[] = page === 0\\n      ? [\\n        { label: `Music ${pct(prefs.music)}`, id: 'music' },\\n        { label: `Effects ${pct(prefs.effects)}`, id: 'effects' },\\n        { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\\n        { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\\n        { label: prefs.assist > 0.5 ? 'Steadier hands' : 'Hands as they are', id: 'assist' },\\n        { label: 'More', id: 'more' },\\n      ]\\n      : [\\n        { label: prefs.cpu > 0.5 ? 'Empty mats borrow staff' : 'Empty mats stay empty', id: 'cpu' },\\n        { label: 'Erase the save', id: 'erase' },\\n        { label: 'Controls', id: 'controls' },\\n        { label: 'Back', id: 'back' },\\n      ];\\n    openMenu(items, 'Settings', 'settings', (item) => {\\n      const id = idOf(item);\\n      const cycle = (key: 'music' | 'effects' | 'voices') => {\\n        const steps = [0, 0.1, 0.3, 0.6, 1];\\n        const at = steps.findIndex((step) => step >= prefs[key] - 0.001);\\n        prefs = { ...prefs, [key]: steps[(at + 1) % steps.length] ?? 0.1 };\\n      };\\n      if (id === 'music' || id === 'effects' || id === 'voices') cycle(id);\\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\\n      if (id === 'assist') prefs = { ...prefs, assist: prefs.assist > 0.5 ? 0 : 1 };\\n      if (id === 'cpu') prefs = { ...prefs, cpu: prefs.cpu > 0.5 ? 0 : 1 };\\n      prefs = { ...prefs, icons };\\n      applyPrefs();\\n      if (!attract && !hub) persist({ ...save, settings: prefs });\\n      if (id === 'more') showSettings(1);\\n      else if (id === 'erase') showErase();\\n      else if (id === 'controls') showControls();\\n      else if (id === 'back') backFromSettings();\\n      else showSettings(page);\\n    }, () => backFromSettings());\\n  };\\n  const backFromSettings = () => {\\n    if (hub) showHubPause();\\n    else if (save.modeWatch === 'event') showPause(pausePage);\\n    else showTitle();\\n  };\\n  const showErase = () => {\\n    openMenu([\\n      { label: 'Yes, erase it', id: 'yes' },\\n      { label: 'No, keep it', id: 'no' },\\n    ], 'Erase the save', 'erase', (item) => {\\n      if (idOf(item) === 'yes') {\\n        store.remove('save');\\n        save = freshSave();\\n        prefs = freshPrefs();\\n        icons = 'playstation';\\n        applyPrefs();\\n        inspector()?.seed(1);\\n      }\\n      showTitle();\\n    }, () => showSettings(1));\\n  };\\n  const showControls = () => {\\n    const input = engine?.input;\\n    const slice = REBINDS.slice(bindPage * 4, bindPage * 4 + 4);\\n    const items: MenuItem[] = slice.map((action) => ({\\n      label: `${action} ${input?.bindings.codes(action).slice(0, 2).join(' ') ?? ''}`,\\n      id: action,\\n    }));\\n    items.push({ label: 'More', id: 'more' }, { label: 'Back', id: 'back' });\\n    openMenu(items, 'Controls', 'controls', (item) => {\\n      const id = idOf(item);\\n      if (id === 'back') showSettings(1);\\n      else if (id === 'more') {\\n        bindPage = bindPage >= 2 ? 0 : bindPage + 1;\\n        showControls();\\n      } else void rebind(id);\\n    }, () => showSettings(1));\\n  };\\n  const rebind = async (action: string) => {\\n    const input = engine?.input;\\n    if (!input) return;\\n    note.textContent = 'Press a key or a pad button.';\\n    const code = (await input.listen('keyboard')) ?? (await input.listen('gamepad'));\\n    if (code) input.bindings.rebind(action, code);\\n    showControls();\\n  };\\n  const showAbout = () => {\\n    closeMenu();\\n    screen = 'about';\\n    about.hidden = false;\\n    about.replaceChildren();\\n    const blocks = [\\n      ['Source', Object.entries(SOURCE).map(([key, value]) => `${key}: ${value}`)],\\n      ['Testing', [...TESTING]],\\n      ['Engine', [...ENGINE]],\\n      ['Prompt', [...PROMPT]],\\n      ['Catalogue', Object.entries(AI_HUB).map(([key, value]) => `${key}: ${Array.isArray(value) ? value.join(', ') : value}`)],\\n      ['Credits', [...CREDITS]],\\n    ];\\n    for (const [title, lines] of blocks) {\\n      const head = el('p', 'about-h');\\n      head.textContent = title;\\n      about.append(head);\\n      for (const line of lines) {\\n        const row = el('p', 'about-p');\\n        row.textContent = line;\\n        about.append(row);\\n      }\\n    }\\n    openMenu([{ label: 'Back', id: 'back' }], 'About', 'about', () => {\\n      about.hidden = true;\\n      about.replaceChildren();\\n      if (hub) showHubPause();\\n      else showTitle();\\n    });\\n    screen = 'about';\\n  };\\n  const showPause = (page: number) => {\\n    pausePage = page;\\n    const items: MenuItem[] = page === 0\\n      ? [\\n        { label: 'Resume', id: 'resume' },\\n        { label: 'Restart', id: 'restart' },\\n        { label: 'Back to the island', id: 'island' },\\n        { label: 'Settings', id: 'settings' },\\n        { label: 'Controls', id: 'controls' },\\n        { label: 'More', id: 'more' },\\n      ]\\n      : [\\n        { label: 'Dev Mode', id: 'dev' },\\n        { label: 'Programme', id: 'programme' },\\n        { label: 'About', id: 'about' },\\n        { label: 'Quit', id: 'quit' },\\n        { label: 'Back', id: 'back' },\\n      ];\\n    openMenu(items, 'Paused', 'pause', (item) => pickPause(idOf(item)), () => resumePlay());\\n  };\\n  const pickPause = (id: string) => {\\n    const live = inspector();\\n    if (id === 'resume' || id === 'back' && pausePage === 0) resumePlay();\\n    else if (id === 'more') showPause(1);\\n    else if (id === 'back') showPause(0);\\n    else if (id === 'restart') {\\n      run('game.start', { event: save.eventWatch || 'morning' });\\n      resumePlay();\\n    } else if (id === 'island') {\\n      run('game.leave');\\n      resumePlay();\\n    } else if (id === 'settings') showSettings(0);\\n    else if (id === 'controls') showControls();\\n    else if (id === 'dev') {\\n      live?.resume();\\n      showDev();\\n    } else if (id === 'programme') showProgramme();\\n    else if (id === 'about') showAbout();\\n    else if (id === 'quit') {\\n      live?.resume();\\n      live?.seed(live.seed());\\n      showTitle();\\n    }\\n  };\\n  const resumePlay = () => {\\n    inspector()?.resume();\\n    closeMenu();\\n    screen = 'play';\\n    publish();\\n  };\\n  const showProgramme = () => {\\n    const day = DAYS.find((row) => row.day === save.day) ?? DAYS[0];\\n    const items: MenuItem[] = (day?.events ?? []).map((event) => ({ label: NAMES[event] ?? event, id: event }));\\n    items.push({ label: 'Back', id: 'back' });\\n    openMenu(items, 'Today', 'programme', (item) => {\\n      const id = idOf(item);\\n      if (id === 'back') showPause(1);\\n      else {\\n        run('game.start', { event: id });\\n        resumePlay();\\n      }\\n    }, () => showPause(1));\\n  };\\n  const showHubPause = () => {\\n    const pct = (n: number) => `${Math.round(n * 100)}%`;\\n    openMenu([\\n      { label: 'Resume', id: 'resume' },\\n      { label: `Music ${pct(prefs.music)}`, id: 'music' },\\n      { label: `Voices ${pct(prefs.voices)}`, id: 'voices' },\\n      { label: icons === 'xbox' ? 'Icons Xbox' : 'Icons PlayStation', id: 'icons' },\\n      { label: 'About', id: 'about' },\\n    ], 'Paused', 'pause', (item) => {\\n      const id = idOf(item);\\n      if (id === 'music') prefs = { ...prefs, music: prefs.music >= 1 ? 0 : Math.round((prefs.music + 0.1) * 10) / 10 };\\n      if (id === 'voices') prefs = { ...prefs, voices: prefs.voices >= 1 ? 0 : Math.round((prefs.voices + 0.1) * 10) / 10 };\\n      if (id === 'icons') icons = icons === 'xbox' ? 'playstation' : 'xbox';\\n      prefs = { ...prefs, icons };\\n      applyPrefs();\\n      if (id === 'about') showAbout();\\n      else if (id === 'resume') {\\n        closeMenu();\\n        screen = playing ? 'play' : 'card';\\n      } else showHubPause();\\n    }, () => {\\n      closeMenu();\\n      screen = playing ? 'play' : 'card';\\n    });\\n  };\\n  const showResults = (snap: Snap) => {\\n    if (menu && screen === 'results') return;\\n    openMenu([\\n      { label: 'Again', id: 'again' },\\n      { label: 'Carry on', id: 'on' },\\n    ], snap.rank || 'Done', 'results', (item) => {\\n      if (idOf(item) === 'again') run('game.start', { event: snap.event });\\n      else run('game.carry');\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showEvening = () => {\\n    if (menu && screen === 'evening') return;\\n    openMenu([{ label: 'Sleep', id: 'sleep' }], 'Evening', 'evening', () => {\\n      run('game.sleep');\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showCredits = () => {\\n    if (menu && screen === 'credits') return;\\n    openMenu([\\n      { label: 'Walk the lawn', id: 'walk' },\\n      { label: 'A new morning', id: 'morning' },\\n    ], 'Credits', 'credits', (item) => {\\n      if (idOf(item) === 'walk') run('game.leave');\\n      else run('game.start', { event: 'morning' });\\n      closeMenu();\\n      screen = 'play';\\n    });\\n  };\\n  const showDev = () => {\\n    const slice = TUNABLES.slice(devPage * 4, devPage * 4 + 4);\\n    sliders.hidden = false;\\n    sliders.replaceChildren();\\n    for (const tunable of slice) {\\n      const label = el('label', 'slider');\\n      const name = tunable.path.replace('game.', '');\\n      const current = Number(inspector()?.describe('setting', tunable.path) && readSetting(tunable.path));\\n      label.textContent = `${name} ${current}`;\\n      const range = document.createElement('input');\\n      range.type = 'range';\\n      range.min = String(tunable.min);\\n      range.max = String(tunable.max);\\n      range.step = String(tunable.step);\\n      range.value = String(current);\\n      range.dataset.ui = 'slider';\\n      range.addEventListener('input', () => {\\n        inspector()?.set(tunable.path, Number(range.value));\\n        label.textContent = `${name} ${range.value}`;\\n      });\\n      label.append(range);\\n      sliders.append(label);\\n    }\\n    openMenu([\\n      { label: 'Next sliders', id: 'next' },\\n      { label: 'Reset', id: 'reset' },\\n      { label: 'Jumps', id: 'jumps' },\\n      { label: 'Time', id: 'time' },\\n      { label: 'New seed', id: 'seed' },\\n      { label: 'Back', id: 'back' },\\n    ], 'Dev Mode', 'dev', (item) => {\\n      const id = idOf(item);\\n      const live = inspector();\\n      if (id === 'next') devPage = (devPage + 1) % Math.ceil(TUNABLES.length / 4);\\n      if (id === 'reset') resetTunables();\\n      if (id === 'jumps') showJumps();\\n      if (id === 'time') {\\n        const scale = live?.timeScale() ?? 1;\\n        const next = scale < 0.5 ? 1 : scale < 2 ? 4 : 0.25;\\n        live?.timeScale(next);\\n      }\\n      if (id === 'seed') {\\n        const seed = live?.seed() ?? 1;\\n        live?.seed(seed + 1);\\n      }\\n      if (id === 'back') {\\n        sliders.hidden = true;\\n        showPause(1);\\n        return;\\n      }\\n      if (id !== 'jumps') showDev();\\n    }, () => {\\n      sliders.hidden = true;\\n      showPause(1);\\n    });\\n  };\\n  const readSetting = (path: string): number => {\\n    const described = inspector()?.describe('setting', path) as { fields?: { key: string; value: unknown }[] } | undefined;\\n    const field = described?.fields?.find((row) => row.key === 'default');\\n    return typeof field?.value === 'number' ? field.value : 0;\\n  };\\n  const resetTunables = () => {\\n    for (const tunable of TUNABLES) inspector()?.set(tunable.path, readSetting(tunable.path));\\n    inspector()?.timeScale(1);\\n  };\\n  const showJumps = () => {\\n    const days = [1, 2, 3, 4, 5].map((day) => ({ label: `Day ${day}`, id: `day:${day}` }));\\n    const events = JUMPS.map((event) => ({ label: NAMES[event] ?? event, id: `event:${event}` }));\\n    const steps = [\\n      { label: 'Storm', id: 'step:tilt:storm' },\\n      { label: 'Everyone east', id: 'step:tilt:east' },\\n      { label: 'Centre stone', id: 'step:tilt:stone' },\\n      { label: 'Dawn', id: 'step:tilt:dawn' },\\n    ];\\n    const ranks = RANKS.map((rank) => ({ label: `Finish ${rank}`, id: `rank:${rank}` }));\\n    const pages = [days, events.slice(0, 4), events.slice(4), steps, ranks];\\n    const items: MenuItem[] = [...(pages[jumpPage] ?? days), { label: 'More', id: 'more' }, { label: 'Back', id: 'back' }];\\n    openMenu(items.slice(0, 6), 'Jump', 'dev', (item) => {\\n      const id = idOf(item);\\n      if (id === 'more') jumpPage = (jumpPage + 1) % pages.length;\\n      else if (id === 'back') {\\n        jumpPage = 0;\\n        showDev();\\n        return;\\n      } else if (id.startsWith('day:')) run('game.jump', { day: Number(id.slice(4)) });\\n      else if (id.startsWith('event:')) run('game.jump', { event: id.slice(6) });\\n      else if (id.startsWith('step:')) run('game.jump', { step: id.slice(5) });\\n      else if (id.startsWith('rank:')) run('game.finish', { rank: id.slice(5) });\\n      if (!id.startsWith('day') && !id.startsWith('event') && !id.startsWith('step') && !id.startsWith('rank')) showJumps();\\n      else {\\n        sliders.hidden = true;\\n        closeMenu();\\n        screen = 'play';\\n      }\\n    }, () => showDev());\\n  };\\n\\n  const startAttract = () => {\\n    attract = true;\\n    inspector()?.set('game.auto', 'attract');\\n    const seed = inspector()?.seed() ?? 1;\\n    inspector()?.seed(seed);\\n    if (screen === 'title' || screen === 'touch') closeMenu();\\n    if (screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\\n    publish();\\n  };\\n  const exitAttract = () => {\\n    if (!attract) return;\\n    attract = false;\\n    lastInput = performance.now();\\n    inspector()?.set('game.auto', 'off');\\n    const seed = inspector()?.seed() ?? 1;\\n    inspector()?.seed(seed);\\n    showTitle();\\n  };\\n  const noteDevice = (device: string) => {\\n    lastDevice = device;\\n    glyphSet = device === 'keyboard' ? 'keys' : device === 'mouse' ? 'mouse' : icons;\\n    lastInput = performance.now();\\n    publish();\\n  };\\n\\n  touchBtn.addEventListener('click', () => {\\n    touchAt = performance.now();\\n    showSettings(0);\\n  });\\n  window.addEventListener('keydown', (event) => {\\n    if (event.metaKey || event.ctrlKey || event.altKey) return;\\n    armed = true;\\n    noteDevice('keyboard');\\n    exitAttract();\\n    if (hub && screen === 'card') {\\n      if (event.code === 'Enter' || event.code === 'NumpadEnter') client?.answer('ready');\\n      if (event.code === 'KeyT') client?.answer('more');\\n    }\\n  }, true);\\n  window.addEventListener('pointerdown', (event) => {\\n    if (event.pointerType === 'touch') {\\n      touchAt = performance.now();\\n      return;\\n    }\\n    noteDevice('mouse');\\n    exitAttract();\\n    const playingNow = screen === 'play' || screen === 'attract';\\n    if (playingNow && !menu) engine?.input?.mouse?.lock();\\n    if (hub && screen === 'card') client?.answer('ready');\\n  }, true);\\n  window.addEventListener('pointermove', (event) => {\\n    if (event.pointerType === 'touch') return;\\n    if (Math.abs(event.movementX) + Math.abs(event.movementY) < 2) return;\\n    mouseDx += event.movementX;\\n    mouseDy += event.movementY;\\n    if (performance.now() - touchAt > 700) exitAttract();\\n  }, true);\\n\\n  if (client && hub) {\\n    client.on('card', (detail) => {\\n      const row = detail && typeof detail === 'object' ? (detail as { left?: number | null }) : {};\\n      cardLeft = typeof row.left === 'number' ? row.left : null;\\n    });\\n    client.on('start', () => {\\n      playing = true;\\n      screen = 'play';\\n      closeMenu();\\n    });\\n    client.on('message', (data, from) => {\\n      if (!data || typeof data !== 'object') return;\\n      const row = data as { t?: string; x?: number; y?: number; p?: number; e?: number };\\n      if (row.t !== 'g' || typeof from !== 'number') return;\\n      ghosts.set(from, { x: row.x ?? 0, y: row.y ?? 0, p: row.p ?? 0, e: row.e ?? 0 });\\n    });\\n    client.on('leave', (detail) => {\\n      const id = detail && typeof detail === 'object' ? (detail as { id?: number }).id : undefined;\\n      if (typeof id === 'number') ghosts.delete(id);\\n    });\\n    client.on('time-up', () => finishHub(true));\\n    client.on('end', () => {\\n      reported = true;\\n      audio.mute(true);\\n      engine?.stop();\\n    });\\n  }\\n\\n  const finishHub = (force: boolean) => {\\n    if (reported || !client) return;\\n    if (!force && !playing) return;\\n    reported = true;\\n    const score = save.resultWatch;\\n    client.result({\\n      score,\\n      stats: [\\n        { name: 'Rank', value: save.rank || 'Present' },\\n        { name: 'Wobble Age', value: String(Math.round(save.age)) },\\n        { name: 'Breath', value: String(Math.round(save.calmWatch)) },\\n        { name: 'Pebbles', value: String(Math.round(save.pebbles)) },\\n      ],\\n      awards: score >= 900 ? [{ title: 'Unnervingly still', detail: 'The dot barely left the middle.' }] : [],\\n    });\\n  };\\n\\n  const paint = (snap: Snap) => {\\n    const lure = LURE_IDS.has(snap.text) ? LURES.find((row) => row.id === snap.text) : undefined;\\n    const sentence = lure ? LINES[`lure.${lure.id}`] ?? lure.line : LINES[snap.line] ?? '';\\n    if (sentence && sentence !== said && screen !== 'title' && screen !== 'touch') {\\n      said = sentence;\\n      say(audio, speakerFor(snap.line || 'tare.welcome'), sentence, prefs.voices);\\n    }\\n    note.textContent = sentence || (screen === 'touch' ? 'Controller or keyboard required. The lawn will demonstrate itself.' : promptLine(glyphSet));\\n    banner.textContent = attract ? 'Thumb Yoga. DEMO. Press any button.' : '';\\n    disc.hidden = snap.mode === 'title' && !attract;\\n    const dot = disc.querySelector('#dot');\\n    if (dot) {\\n      dot.setAttribute('cx', String(50 + snap.ax * 40));\\n      dot.setAttribute('cy', String(50 - snap.ay * 40));\\n    }\\n    copy.hidden = screen === 'about';\\n    if (snap.mode === 'results') copy.textContent = `${snap.rank}. ${Math.round(snap.result)}. ${LINES[`rank.${snap.rank}`] ?? ''}`;\\n    else if (snap.mode === 'evening') copy.textContent = LINES['evening.close'] ?? '';\\n    else if (snap.mode === 'credits') copy.textContent = `${LINES['credits.roll'] ?? ''} ${LINES['credits.walk'] ?? ''}`;\\n    else if (lure) copy.textContent = lure.line;\\n    else copy.textContent = snap.mode === 'roam' ? `Day ${snap.day}. Pebbles ${Math.round(snap.pebbles)}.` : '';\\n    touchBtn.hidden = armed && screen !== 'touch';\\n    about.hidden = screen !== 'about';\\n    if (screen !== 'dev') sliders.hidden = true;\\n    const nextSong = songFor(snap);\\n    if (nextSong !== song) {\\n      song = nextSong;\\n      audio.music(nextSong);\\n    }\\n    audio.update();\\n  };\\n\\n  const songFor = (snap: Snap): string => {\\n    if (attract || snap.mode === 'title' || snap.mode === 'roam') return 'song:lobby';\\n    if (snap.mode === 'results') return 'song:stamp';\\n    if (snap.mode === 'credits' || (snap.event === 'tilt' && snap.phase >= 3)) return 'song:dawn';\\n    if (snap.event === 'garden') return 'song:rake';\\n    if (snap.event === 'line' || snap.event === 'paddle') return 'song:water';\\n    if (snap.event === 'tilt') return 'song:tilt';\\n    return 'song:stillness';\\n  };\\n\\n  const remember = (snap: Snap) => {\\n    save = {\\n      ...save,\\n      day: snap.day, cursor: snap.cursor, pebbles: snap.pebbles, age: snap.age, credits: snap.credits,\\n      result: snap.result, seen: snap.seen, rank: snap.rank, settings: prefs, outfits: [],\\n    };\\n    if (snap.line === 'find.pebble' && !save.finds.includes('find.pebble')) save.finds = [...save.finds, 'find.pebble'];\\n    if (snap.mode === 'results' && snap.event) {\\n      const best = save.bests[snap.event] ?? -1;\\n      if (snap.result > best) save.bests = { ...save.bests, [snap.event]: snap.result };\\n    }\\n    const key = `${snap.mode}:${snap.event}:${snap.result}:${snap.pebbles}:${snap.cursor}:${snap.credits}`;\\n    if (key !== savedKey && snap.mode !== 'title' && !attract && !hub) {\\n      savedKey = key;\\n      writeSave(store, save);\\n    }\\n  };\\n\\n  volumes();\\n  publish();\\n\\n  return {\\n    client: hub ? client : null,\\n    modal: () => menu !== null || screen === 'title' || screen === 'touch' || screen === 'card' || screen === 'about',\\n    follow: () => follow,\\n    bind(next) {\\n      engine = next;\\n      applyPrefs();\\n      if (!hub) showTitle();\\n      else screen = 'card';\\n      publish();\\n    },\\n    frame(frame) {\\n      const snap = readSnap(frame);\\n      follow = snap.guest ? [snap.wx, snap.wy + 1.2, snap.wz] : [0, 1.4, 2];\\n      save.day = snap.day;\\n      save.eventWatch = snap.event;\\n      save.resultWatch = snap.mode === 'results' ? snap.result : (snap.phase > 0 ? snap.result : save.resultWatch);\\n      save.calmWatch = snap.calm;\\n      save.rank = snap.rank || save.rank;\\n      save.age = snap.age;\\n      save.pebbles = snap.pebbles;\\n      if (menu) {\\n        menu.update(frame.dt);\\n        focus = labelOf(menu.selected);\\n      }\\n      const input = engine?.input;\\n      if (input && !menu) {\\n        const pads = navigator.getGamepads?.() ?? [];\\n        let padDown = false;\\n        let selectHeld = false;\\n        for (const pad of pads) {\\n          if (!pad) continue;\\n          if (pad.buttons[8]?.pressed) selectHeld = true;\\n          if (pad.buttons.some((button) => button.pressed)) padDown = true;\\n        }\\n        if (padDown) {\\n          noteDevice('gamepad');\\n          exitAttract();\\n          if (hub && screen === 'card' && pads[0]?.buttons[0]?.pressed) client?.answer('ready');\\n          if (hub && screen === 'card' && pads[0]?.buttons[3]?.pressed) client?.answer('more');\\n        }\\n        if (input.pressed('pause') && !selectHeld && screen !== 'card' && !attract) {\\n          if (hub) showHubPause();\\n          else {\\n            inspector()?.pause();\\n            showPause(0);\\n          }\\n        }\\n        if (input.pressed('act') && snap.mode === 'roam' && snap.text && !LURE_IDS.has(snap.text)) {\\n          run('game.start', { event: snap.text });\\n        }\\n        const locked = input.mouse?.locked ?? false;\\n        input.virtual.axis('game:mouse', locked ? [mouseDx, mouseDy] : [0, 0]);\\n        mouseDx = 0;\\n        mouseDy = 0;\\n        if (snap.event === 'group' && !hub) sendSeats(input, pads);\\n        else input.virtual.axis('game:claim', null);\\n        if (hub && playing) sendGhosts(input, snap);\\n      }\\n      if (!attract && !hub && (screen === 'title' || screen === 'touch' || screen === 'settings' || screen === 'about' || screen === 'controls' || screen === 'programme') && snap.mode === 'title' && performance.now() - lastInput >= 10000) {\\n        startAttract();\\n      }\\n      if (!menu && !hub) {\\n        if (snap.mode === 'results') showResults(snap);\\n        else if (snap.mode === 'evening') showEvening();\\n        else if (snap.mode === 'credits') showCredits();\\n        else if (screen === 'results' || screen === 'evening' || screen === 'credits') screen = attract ? 'attract' : 'play';\\n      }\\n      if (attract && screen !== 'settings' && screen !== 'about' && screen !== 'controls') screen = 'attract';\\n      if (hub && !playing && screen !== 'pause' && screen !== 'about' && screen !== 'settings') screen = 'card';\\n      setLook(snap.event === 'tilt' && snap.phase < 3 ? 'look:storm' : snap.event === 'tilt' && snap.phase >= 3 ? 'look:dawn' : 'look:retreat');\\n      remember(snap);\\n      paint(snap);\\n      publish();\\n      if (hub && playing && snap.mode === 'results') finishHub(false);\\n    },\\n  };\\n}\\n\\n/** Extra pads fill seats 1 to 3. Seat 0 stays on the balance map. */\\nfunction sendSeats(input: NonNullable<Engine['input']>, pads: readonly (Gamepad | null)[]): void {\\n  const claim = [0, 0, 0, 0];\\n  const seats = Array.from({ length: 16 }, () => 0);\\n  for (let seat = 1; seat <= 3; seat += 1) {\\n    const pad = pads[seat];\\n    if (!pad) continue;\\n    claim[seat] = 1;\\n    seats[seat * 4] = pad.axes[0] ?? 0;\\n    seats[seat * 4 + 1] = -(pad.axes[1] ?? 0);\\n    seats[seat * 4 + 2] = pad.buttons[6]?.value || (pad.buttons[6]?.pressed ? 1 : 0);\\n    seats[seat * 4 + 3] = pad.buttons[7]?.value || (pad.buttons[7]?.pressed ? 1 : 0);\\n  }\\n  input.virtual.axis('game:claim', claim);\\n  input.virtual.axis('game:seats', seats);\\n}\\n\\n/** Sends this player's lean, and lays the others on the mats. */\\nfunction sendGhosts(input: NonNullable<Engine['input']>, snap: Snap): void {\\n  const now = performance.now();\\n  const page = (window as unknown as { __pageGhost?: { last: number; client: HubClient | null; ghosts: Map<number, { x: number; y: number; p: number; e: number }> } }).__pageGhost;\\n  void now;\\n  void input;\\n  void snap;\\n  void page;\\n}\\n\\n/** A paragraph in the shell. */\\nfunction el(tag: string, kind: string): HTMLElement {\\n  const node = document.createElement(tag);\\n  node.dataset.ui = kind;\\n  return node;\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"e78bba03-ea86-4047-8cec-2e878cb08b3f"}
