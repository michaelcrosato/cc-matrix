ine_number\":7183,\"content\":\"    \\\"node_modules/@typescript-eslint/eslint-plugin/node_modules/ignore\\\": {\"},{\"line_number\":7193,\"content\":\"    \\\"node_modules/@typescript-eslint/parser\\\": {\"},{\"line_number\":7195,\"content\":\"      \\\"resolved\\\": \\\"https://registry.npmjs.org/@typescript-eslint/parser/-/parser-8.72.1.tgz\\\",\"},{\"line_number\":7200,\"content\":\"        \\\"@typescript-eslint/scope-manager\\\": \\\"8.72.1\\\",\"},{\"line_number\":7201,\"content\":\"        \\\"@typescript-eslint/types\\\": \\\"8.72.1\\\",\"},{\"line_number\":7202,\"content\":\"        \\\"@typescript-eslint/typescript-estree\\\": \\\"8.72.1\\\",\"},{\"line_number\":7203,\"content\":\"        \\\"@typescript-eslint/visitor-keys\\\": \\\"8.72.1\\\",\"},{\"line_number\":7211,\"content\":\"        \\\"url\\\": \\\"https://opencollective.com/typescript-eslint\\\"\"},{\"line_number\":7214,\"content\":\"        \\\"eslint\\\": \\\"^8.57.0 || ^9.0.0 || ^10.0.0\\\",\"},{\"line_number\":7218,\"content\":\"    \\\"node_modules/@typescript-eslint/parser/node_modules/debug\\\": {\"},{\"line_number\":7236,\"content\":\"    \\\"node_modules/@typescript-eslint/parser/node_modules/ms\\\": {\"},{\"line_number\":7243,\"content\":\"    \\\"node_modules/@typescript-eslint/project-service\\\": {\"},{\"line_number\":7245,\"content\":\"      \\\"resolved\\\": \\\"https://registry.npmjs.org/@typescript-eslint/project-service/-/project-service-8.72.1.tgz\\\",\"},{\"line_number\":7250,\"content\":\"        \\\"@typescript-eslint/tsconfig-utils\\\": \\\"^8.72.1\\\",\"},{\"line_number\":7251,\"content\":\"        \\\"@typescript-eslint/types\\\": \\\"^8.72.1\\\",\"},{\"line_number\":7259,\"content\":\"        \\\"url\\\": \\\"https://opencollective.com/typescript-eslint\\\"\"},{\"line_number\":7265,\"content\":\"    \\\"node_modules/@typescript-eslint/project-service/node_modules/debug\\\": {\"},{\"line_number\":7283,\"content\":\"    \\\"node_modules/@typescript-eslint/project-service/