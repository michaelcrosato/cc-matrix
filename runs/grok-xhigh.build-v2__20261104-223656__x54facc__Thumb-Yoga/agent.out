 and what it faces from `aim` (else\\n * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\\n * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\\n * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\\n */\\nexport function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\\n  const w = world as unknown as World;\\n  const physics = physicsOf(w);\\n  const body = addCharacter(physics, spec.character, spec.at);\\n  const { x, y, z } = feetOf(physics, body, spec.character);\\n  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\\n  if (!w.systems.has('actors')) {\\n    w.systems.add('actors', moveActors, { phase: 'anim' });\\n    w.systems.add('actors.readback', readActors, { phase: 'readback' });\\n  }\\n  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\\n  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\\n  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\\n  if (!w.systems.has('actors.anim')) {\\n    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\\n    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\\n  }\\n  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\\n  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\\n  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\\n  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\\n  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\\n}\\n\\n/**\\n * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\\n * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\\n * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\\n * next step on and kept so until it has headroom, for a place no standing hull fits (a crawlspace). A place where the\\n * level (the queries' as of the last step, one-way platforms aside) stands over its feet lower than its hull's top, up\\n * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\\n * course places its player where it measures (engine/dev/feel/course.ts).\\n */\\nexport function placeActor<C extends object>(\\n  world: World<C>,\\n  id: number,\\n  at: Vec3Like,\\n  yaw?: number,\\n  options: { crouch?: boolean } = {},\\n): void {\\n  const w = world as unknown as World;\\n  const e = w.get(id) as Partial<ActorComponents> | undefined;\\n  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\\n  const { actor, motion } = e;\\n  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no movement model`, expected: 'no crouch: only an actor on a movement model (its component motion) crouches' }); // prettier-ignore\\n  const physics = physicsOf(w);\\n  const { offset, capsule } = actor.character;\\n  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\\n  const middle = motion && options.crouch ? hullFor(actor.character, { ...motion, stance: 'crouch' }) : capsule.height; // prettier-ignore\\n  const up = { maxDistance: middle + capsule.radius, exclude: actor.body, groups: 'world' } as const;\\n  const ceiling = physics.raycast([centre[0], centre[1] - capsule.height / 2, centre[2]], [0, 1, 0], up); // up its axis\\n  if (ceiling && !oneWayOf(w).has(ceiling.body)) {\\n    const given = vec(at, 'placeActor(at)');\\n    const place = [given.x, given.y, given.z].map((v) => Math.round(v * 100) / 100).join(', ');\\n    const [over, tall] = [(offset + capsule.radius + ceiling.distance).toFixed(2), (middle + 2 * capsule.radius).toFixed(2)]; // prettier-ignore\\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crouch ? 'crouched' : 'standing'} hull, ${tall} m tall (it would sink through the floor)`, expected: motion && !options.crouch ? 'a place with headroom, or { crouch: true } under a low ceiling' : 'a place with headroom' }); // prettier-ignore\\n  }\\n  matchHull(physics, actor.body, actor.character, capsule.height, { air: false, tuck: false });\\n  physics.setBody(actor.body, { position: centre, velocity: [0, 0, 0] });\\n  const { x, y, z } = feetOf(physics, actor.body, actor.character);\\n  Object.assign(actor, createCharacterState(), { yaw: yaw ?? actor.yaw, x, y, z });\\n  if (motion) Object.assign(motion, createMotionState(), { holstered: motion.holstered }, options.crouch ? { stance: 'crouch', duck: 'ducked' } : {}); // prettier-ignore\\n}\\n\\n/** The bodies of the one-way platforms (the component `oneWay`). */\\nconst oneWayOf = (w: World) => new Set((w.query('oneWay') as unknown as ActorComponents[]).map((e) => e.oneWay.body));\\n\\n/** Removes an actor and its body (its ragdoll's parts too, engine/sim/ragdolls.ts). */\\nexport function removeActor<C extends object>(world: World<C>, id: number): void {\\n  const w = world as unknown as World;\\n  const actor = (w.get(id) as Partial<ActorComponents> | undefined)?.actor;\\n  if (!actor)\\n\",\"total_lines\":346}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1f64a55d-c2ec-4f2d-9402-ed857f482274-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The starter game's tests (labs/game/scenes/play.ts): what every game made from it starts with, and keeps as it\\n * grows. They run headless in Node (`npm test`), in a few seconds:\\n * - its golden replay (labs/game/replays/bot.replay.json, the bot's play) gives its golden hashes, as `x replay`\\n *   checks it: on another platform than the one that recorded them, two runs agree instead;\\n * - a run continues exactly after a capture and a restore;\\n * - the bot (labs/game/bot.ts) wins on 10 seeds, so the game can be won, however the gems fall;\\n * - the clock runs out on a player who stands still, and the settings change play;\\n * - two actors that reach a gem in the same step take it once.\\n10→ *\\n * When the game's play changes on purpose, record the goldens again: `node x replay labs/game/replays/bot.replay.json\\n * --browser sim --update` (in Node and Chromium), and say why in the commit.\\n * @see labs/game/scenes/play.ts\\n */\\nimport { readFileSync } from 'node:fs';\\nimport { describe, expect, it } from 'vitest';\\nimport { createHeadless } from '../../../engine';\\nimport { defineScene, type World } from '../../../engine/sim-api';\\nimport { botIntents, playBot, roundOf, viewOf } from '../bot';\\n20→import { spawnPlayer } from '../cast/player';\\nimport { play, type GameComponents } from './play';\\n\\n/** The golden replay: the bot's play from seed 1, with the goldens `x replay --update` recorded. */\\nconst REPLAY = readFileSync(new URL('../replays/bot.replay.json', import.meta.url), 'utf8');\\n\\n/** This platform's golden key, as replays write it. */\\nconst PLATFORM = `${process.platform}-${process.arch}`;\\n\\n/** Plays `text` from step 0 in a fresh engine and returns its hashes at the replay's checkpoints. */\\n30→async function replayed(text: string): Promise<Record<string, string>> {\\n  const engine = await createHeadless({ scene: play });\\n  const result = await (engine.replay as (text: string) => Promise<{ hashes: Record<string, string> }>)(text);\\n  return result.hashes;\\n}\\n\\ndescribe('game:play', () => {\\n  it('replays the bot’s play to its golden hashes', async () => {\\n    const goldens = (JSON.parse(REPLAY) as { hashes: Record<string, Record<string, string>> }).hashes;\\n    const first = await replayed(REPLAY);\\n40→    if (goldens[PLATFORM]) expect(first).toEqual(goldens[PLATFORM]);\\n    else expect(await replayed(REPLAY)).toEqual(first); // recorded elsewhere: the runs agree, as x replay judges it\\n  });\\n\\n  it('continues exactly after a capture and a restore', async () => {\\n    const engine = await createHeadless({ scene: play, seed: 4 });\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const capture = engine.capture();\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const straight = engine.hash();\\n50→    engine.restore(capture);\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    expect(engine.hash()).toBe(straight);\\n  });\\n\\n  it('is won by the bot on 10 seeds', async () => {\\n    for (let seed = 1; seed <= 10; seed++) {\\n      const engine = await createHeadless({ scene: play, seed });\\n      expect({ seed, ...playBot(engine) }).toMatchObject({ seed, state: 'won' });\\n      expect(roundOf(engine).collected).toBe(roundOf(engine).gems);\\n60→    }\\n  });\\n\\n  it('is lost when the clock runs out, and its settings change play', async () => {\\n    const engine = await createHeadless({ scene: play, settings: { 'game.seconds': 5, 'game.gems': 3 } });\\n    engine.step(5 * 60);\\n    expect(roundOf(engine)).toMatchObject({ gems: 3, collected: 0, left: 0, state: 'lost' });\\n    expect(viewOf(engine).gems).toHaveLength(3);\\n  });\\n\\n70→  it('counts a gem once when two actors reach it in the same step', async () => {\\n    const twin = defineScene<GameComponents>('game:twin', {\\n      description: 'The starter, and two more players put on its gem in the first step: both reach it in the next.',\\n      level: 'level:arena',\\n      physics: true,\\n      setup(w) {\\n        play.setup(w);\\n        const twins = (world: World<GameComponents>) => {\\n          if ([...world.query('actor')].length > 1) return;\\n          const [{ gem }] = world.query('gem');\\n80→          for (const dx of [-0.3, 0.3]) spawnPlayer(world, [gem.x + dx, 0, gem.z], 6);\",\"content_concise\":\"1→/**\\n * @file The starter game's tests (labs/game/scenes/play.ts): what every game made from it starts with, and keeps as it\\n * grows. They run headless in Node (`npm test`), in a few seconds:\\n * - its golden replay (labs/game/replays/bot.replay.json, the bot's play) gives its golden hashes, as `x replay`\\n *   checks it: on another platform than the one that recorded them, two runs agree instead;\\n * - a run continues exactly after a capture and a restore;\\n * - the bot (labs/game/bot.ts) wins on 10 seeds, so the game can be won, however the gems fall;\\n * - the clock runs out on a player who stands still, and the settings change play;\\n * - two actors that reach a gem in the same step take it once.\\n10→ *\\n * When the game's play changes on purpose, record the goldens again: `node x replay labs/game/replays/bot.replay.json\\n * --browser sim --update` (in Node and Chromium), and say why in the commit.\\n * @see labs/game/scenes/play.ts\\n */\\nimport { readFileSync } from 'node:fs';\\nimport { describe, expect, it } from 'vitest';\\nimport { createHeadless } from '../../../engine';\\nimport { defineScene, type World } from '../../../engine/sim-api';\\nimport { botIntents, playBot, roundOf, viewOf } from '../bot';\\n20→import { spawnPlayer } from '../cast/player';\\nimport { play, type GameComponents } from './play';\\n\\n/** The golden replay: the bot's play from seed 1, with the goldens `x replay --update` recorded. */\\nconst REPLAY = readFileSync(new URL('../replays/bot.replay.json', import.meta.url), 'utf8');\\n\\n/** This platform's golden key, as replays write it. */\\nconst PLATFORM = `${process.platform}-${process.arch}`;\\n\\n/** Plays `text` from step 0 in a fresh engine and returns its hashes at the replay's checkpoints. */\\n30→async function replayed(text: string): Promise<Record<string, string>> {\\n  const engine = await createHeadless({ scene: play });\\n  const result = await (engine.replay as (text: string) => Promise<{ hashes: Record<string, string> }>)(text);\\n  return result.hashes;\\n}\\n\\ndescribe('game:play', () => {\\n  it('replays the bot’s play to its golden hashes', async () => {\\n    const goldens = (JSON.parse(REPLAY) as { hashes: Record<string, Record<string, string>> }).hashes;\\n    const first = await replayed(REPLAY);\\n40→    if (goldens[PLATFORM]) expect(first).toEqual(goldens[PLATFORM]);\\n    else expect(await replayed(REPLAY)).toEqual(first); // recorded elsewhere: the runs agree, as x replay judges it\\n  });\\n\\n  it('continues exactly after a capture and a restore', async () => {\\n    const engine = await createHeadless({ scene: play, seed: 4 });\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const capture = engine.capture();\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const straight = engine.hash();\\n50→    engine.restore(capture);\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    expect(engine.hash()).toBe(straight);\\n  });\\n\\n  it('is won by the bot on 10 seeds', async () => {\\n    for (let seed = 1; seed <= 10; seed++) {\\n      const engine = await createHeadless({ scene: play, seed });\\n      expect({ seed, ...playBot(engine) }).toMatchObject({ seed, state: 'won' });\\n      expect(roundOf(engine).collected).toBe(roundOf(engine).gems);\\n60→    }\\n  });\\n\\n  it('is lost when the clock runs out, and its settings change play', async () => {\\n    const engine = await createHeadless({ scene: play, settings: { 'game.seconds': 5, 'game.gems': 3 } });\\n    engine.step(5 * 60);\\n    expect(roundOf(engine)).toMatchObject({ gems: 3, collected: 0, left: 0, state: 'lost' });\\n    expect(viewOf(engine).gems).toHaveLength(3);\\n  });\\n\\n70→  it('counts a gem once when two actors reach it in the same step', async () => {\\n    const twin = defineScene<GameComponents>('game:twin', {\\n      description: 'The starter, and two more players put on its gem in the first step: both reach it in the next.',\\n      level: 'level:arena',\\n      physics: true,\\n      setup(w) {\\n        play.setup(w);\\n        const twins = (world: World<GameComponents>) => {\\n          if ([...world.query('actor')].length > 1) return;\\n          const [{ gem }] = world.query('gem');\\n80→          for (const dx of [-0.3, 0.3]) spawnPlayer(world, [gem.x + dx, 0, gem.z], 6);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/play.test.ts\",\"offset\":null,\"limit\":80,\"raw_output\":\"/**\\n * @file The starter game's tests (labs/game/scenes/play.ts): what every game made from it starts with, and keeps as it\\n * grows. They run headless in Node (`npm test`), in a few seconds:\\n * - its golden replay (labs/game/replays/bot.replay.json, the bot's play) gives its golden hashes, as `x replay`\\n *   checks it: on another platform than the one that recorded them, two runs agree instead;\\n * - a run continues exactly after a capture and a restore;\\n * - the bot (labs/game/bot.ts) wins on 10 seeds, so the game can be won, however the gems fall;\\n * - the clock runs out on a player who stands still, and the settings change play;\\n * - two actors that reach a gem in the same step take it once.\\n *\\n * When the game's play changes on purpose, record the goldens again: `node x replay labs/game/replays/bot.replay.json\\n * --browser sim --update` (in Node and Chromium), and say why in the commit.\\n * @see labs/game/scenes/play.ts\\n */\\nimport { readFileSync } from 'node:fs';\\nimport { describe, expect, it } from 'vitest';\\nimport { createHeadless } from '../../../engine';\\nimport { defineScene, type World } from '../../../engine/sim-api';\\nimport { botIntents, playBot, roundOf, viewOf } from '../bot';\\nimport { spawnPlayer } from '../cast/player';\\nimport { play, type GameComponents } from './play';\\n\\n/** The golden replay: the bot's play from seed 1, with the goldens `x replay --update` recorded. */\\nconst REPLAY = readFileSync(new URL('../replays/bot.replay.json', import.meta.url), 'utf8');\\n\\n/** This platform's golden key, as replays write it. */\\nconst PLATFORM = `${process.platform}-${process.arch}`;\\n\\n/** Plays `text` from step 0 in a fresh engine and returns its hashes at the replay's checkpoints. */\\nasync function replayed(text: string): Promise<Record<string, string>> {\\n  const engine = await createHeadless({ scene: play });\\n  const result = await (engine.replay as (text: string) => Promise<{ hashes: Record<string, string> }>)(text);\\n  return result.hashes;\\n}\\n\\ndescribe('game:play', () => {\\n  it('replays the bot’s play to its golden hashes', async () => {\\n    const goldens = (JSON.parse(REPLAY) as { hashes: Record<string, Record<string, string>> }).hashes;\\n    const first = await replayed(REPLAY);\\n    if (goldens[PLATFORM]) expect(first).toEqual(goldens[PLATFORM]);\\n    else expect(await replayed(REPLAY)).toEqual(first); // recorded elsewhere: the runs agree, as x replay judges it\\n  });\\n\\n  it('continues exactly after a capture and a restore', async () => {\\n    const engine = await createHeadless({ scene: play, seed: 4 });\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const capture = engine.capture();\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    const straight = engine.hash();\\n    engine.restore(capture);\\n    for (let k = 0; k < 120; k++) engine.step(1, botIntents(viewOf(engine)));\\n    expect(engine.hash()).toBe(straight);\\n  });\\n\\n  it('is won by the bot on 10 seeds', async () => {\\n    for (let seed = 1; seed <= 10; seed++) {\\n      const engine = await createHeadless({ scene: play, seed });\\n      expect({ seed, ...playBot(engine) }).toMatchObject({ seed, state: 'won' });\\n      expect(roundOf(engine).collected).toBe(roundOf(engine).gems);\\n    }\\n  });\\n\\n  it('is lost when the clock runs out, and its settings change play', async () => {\\n    const engine = await createHeadless({ scene: play, settings: { 'game.seconds': 5, 'game.gems': 3 } });\\n    engine.step(5 * 60);\\n    expect(roundOf(engine)).toMatchObject({ gems: 3, collected: 0, left: 0, state: 'lost' });\\n    expect(viewOf(engine).gems).toHaveLength(3);\\n  });\\n\\n  it('counts a gem once when two actors reach it in the same step', async () => {\\n    const twin = defineScene<GameComponents>('game:twin', {\\n      description: 'The starter, and two more players put on its gem in the first step: both reach it in the next.',\\n      level: 'level:arena',\\n      physics: true,\\n      setup(w) {\\n        play.setup(w);\\n        const twins = (world: World<GameComponents>) => {\\n          if ([...world.query('actor')].length > 1) return;\\n          const [{ gem }] = world.query('gem');\\n          for (const dx of [-0.3, 0.3]) spawnPlayer(world, [gem.x + dx, 0, gem.z], 6);\\n\",\"total_lines\":89}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1f64a55d-c2ec-4f2d-9402-ed857f482274-13","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,