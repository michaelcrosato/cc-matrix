     const best = save.bests[snap.event] ?? -1;\\n      if (snap.result > best) save.bests = { ...save.bests, [snap.event]: snap.result };\\n    }\\n    const key = `${snap.mode}:${snap.event}:${snap.result}:${snap.pebbles}:${snap.cursor}:${snap.credits}`;\\n    if (key !== savedKey && snap.mode !== 'title' && !attract && !hub) {\\n      savedKey = key;\\n      writeSave(store, save);\\n    }\\n520→  }\\n\\n  function paint(snap: Snap, drawn: EngineFrame): void {\\n    const lure = LURE_IDS.has(snap.text) ? LURES.find((row) => row.id === snap.text) : undefined;\\n    const sentence = lure ? (LINES[`lure.${lure.id}`] ?? lure.line) : (LINES[snap.line] ?? '');\",\"content_concise\":\"495→  function remember(snap: Snap): void {\\n    if (attract || exitPending || hub) return;\\n    save = {\\n      ...save,\\n      day: snap.day,\\n500→      cursor: snap.cursor,\\n      pebbles: snap.pebbles,\\n      age: snap.age,\\n      credits: snap.credits,\\n      result: snap.result,\\n      seen: snap.seen,\\n      rank: snap.rank,\\n      settings: { ...prefs, icons },\\n      outfits: [],\\n    };\\n510→    if (snap.line === 'find.pebble' && !save.finds.includes('find.pebble')) save.finds = [...save.finds, 'find.pebble'];\\n    if (snap.mode === 'results' && snap.event) {\\n      const best = save.bests[snap.event] ?? -1;\\n      if (snap.result > best) save.bests = { ...save.bests, [snap.event]: snap.result };\\n    }\\n    const key = `${snap.mode}:${snap.event}:${snap.result}:${snap.pebbles}:${snap.cursor}:${snap.credits}`;\\n    if (key !== savedKey && snap.mode !== 'title' && !attract && !hub) {\\n      savedKey = key;\\n      writeSave(store, save);\\n    }\\n520→  }\\n\\n  function paint(snap: Snap, drawn: EngineFrame): void {\\n    const lure = LURE_IDS.has(snap.text) ? LURES.find((row) => row.id === snap.text) : undefined;\\n    const sentence = lure ? (LINES[`lure.${lure.id}`] ?? lure.line) : (LINES[snap.line] ?? '');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/r