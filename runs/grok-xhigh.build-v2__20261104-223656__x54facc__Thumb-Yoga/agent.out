*\\n * @file The score scene. No terrain and no physics: the bot matrix is a balance problem, not a render.\\n */\\nimport { defineScene } from '../../../engine/sim-api';\\nimport { boot, frame, retreatActions } from './driver';\\nimport './settings';\\n\\n/** Headless play and the page's balance tests share this scene. */\\nexport const bench = defineScene('game:bench', {\\n10→  description: 'The retreat with no island mesh. Activities, the day, and the balance step.',\\n  physics: false,\\n  setup(w) {\\n    boot(w);\\n  },\\n  step(w, intents) {\\n    frame(w, intents);\\n  },\\n  actions: retreatActions,\\n});\\n20→\\nexport default bench;\\n\",\"content_concise\":\"1→/**\\n * @file The score scene. No terrain and no physics: the bot matrix is a balance problem, not a render.\\n */\\nimport { defineScene } from '../../../engine/sim-api';\\nimport { boot, frame, retreatActions } from './driver';\\nimport './settings';\\n\\n/** Headless play and the page's balance tests share this scene. */\\nexport const bench = defineScene('game:bench', {\\n10→  description: 'The retreat with no island mesh. Activities, the day, and the balance step.',\\n  physics: false,\\n  setup(w) {\\n    boot(w);\\n  },\\n  step(w, intents) {\\n    frame(w, intents);\\n  },\\n  actions: retreatActions,\\n});\\n20→\\nexport default bench;\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/bench.ts\",\"offset\":null,\"limit\":40,\"raw_output\":\"/**\\n * @file The score scene. No terrain and no physics: the bot matrix is a balance problem, not a render.\\n */\\nimport { defineScene } from '../../../engine/sim-api';\\nimport { boot, frame, retreatActions } from './driver';\\nimport './settings';\\n\\n/** Headless play and the page's balance tests share this scene. */\\nexport const bench = defineScene('game:bench', {\\n  description: 'The retreat with no island mesh. Activ