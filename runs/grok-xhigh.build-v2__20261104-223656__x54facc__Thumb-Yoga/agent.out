0, base: 0.4 },\\n  });\\n}\\n\\n/** One step of whatever the day is doing. */\\nexport function frame(w: World, intents: Intents): void {\\n  const flow = flowOf(w);\\n  const auto = autoOf(w);\\n  if (flow.mode === 'title' && auto === 'director') {\\n270→    openItem(w, programme()[flow.cursor]);\\n    return;\\n  }\\n  if (flow.mode === 'title' && auto === 'attract') {\\n    startEvent(w, 'pose-a');\\n    return;\\n  }\\n  if (flow.mode === 'event') {\\n    const activity = activityById(flow.event);\\n    let use = intents;\\n280→    if (auto === 'director') use = activity.bot(w, 'human');\\n    else if (auto === 'attract') use = activity.bot(w, 'perfect');\\n    activity.step(w, use);\\n    const act = actOf(w);\\n    if (act.done === 1 || (auto === 'attract' && act.tick >= SLICE)) finishEvent(w);\\n    return;\\n  }\\n  if ((flow.mode === 'results' || flow.mode === 'evening') && (auto === 'director' || auto === 'attract')) {\\n    const act = actOf(w);\\n    act.wait += 1;\\n290→    if (act.wait >= BEAT) {\\n      if (flow.mode === 'results') advance(w);\\n      else sleep(w);\\n    }\\n  }\\n}\\n\\n/** Menu picks. Each one runs between steps. */\\nexport const retreatActions = {\\n  'game.begin': (w: World, args: unknown) => {\\n300→    const given = rec(args);\\n    applySave(w, given);\\n    const flow = flowOf(w);\\n    applyLean(w, flow.day);\\n    if (flow.credits) {\\n      flow.mode = 'roam';\\n      flow.event = '';\\n      return;\\n    }\\n    openItem(w, programme()[flow.cursor]);\\n310→  },\\n  'game.start': (w: World, args: unknown) => {\\n    const event = strArg(rec(args), 'event');\\n    if (!event) return;\\n    if (event === 'evening') openEvening(w);\\n    else if (event === 'credits') openCredits(w);\\n    else startEvent(w, event);\\n  },\\n  'game.carry': (w: World) => {\\n    if (flowOf(w).mode === 'results') advance(w);\\n320→  },\\n  'game.sleep': (w: World) => {\\n    if (flowOf(w).mode === 'evening') sleep(w);\\n  },\\n  'game.leave': (w: World) => {\\n    const flow = flowOf(w);\\n    const activity = findActivity(flow.event);\\n    if (activity && flow.mode === 'event') activity.teardown(w);\\n    flow.mode = 'roam';\\n    flow.event = '';\\n330→  },\\n  'game.jump': (w: World, args: unknown) => {\\n    const given = rec(args);\\n    const step = strArg(given, 'step');\\n    const event = strArg(given, 'event');\\n    const day = numArg(given, 'day');\\n    if (step) {\\n      jumpTilt(w, step);\\n      return;\\n    }\\n340→    if (event) {\\n      startEvent(w, event);\\n      return;\\n    }\\n    if (day === undefined) return;\\n    const list = programme();\\n    const at = list.findIndex((item) => item.day === day);\\n    if (at < 0) return;\\n    const flow = flowOf(w);\\n    flow.cursor = at;\\n350→    flow.day = day;\\n    applyLean(w, day);\\n    openItem(w, list[at]);\\n  },\\n  'game.finish': (w: World, args: unknown) => {\\n    if (flowOf(w).mode !== 'event') return;\\n    finishEvent(w, strArg(rec(args), 'rank'));\\n  },\\n};\\n\",\"content_concise\":\"255→/** One seat, the day, and the island. The first step starts a director or a demo. */\\nexport function boot(w: World): void {\\n  drawSway(w);\\n  w.spawn({\\n    flow: { mode: 'title', day: 1 },\\n260→    act: emptyAct() as unknown as Record<string, unknown>,\\n    island: { tiltX: 0.4, tiltZ: 0, base: 0.4 },\\n  });\\n}\\n\\n/** One step of whatever the day is doing. */\\nexport function frame(w: World, intents: Intents): void {\\n  const flow = flowOf(w);\\n  const auto = autoOf(w);\\n  if (flow.mode === 'title' && auto === 'director') {\\n270→    openItem(w, programme()[flow.cursor]);\\n    return;\\n  }\\n  if (flow.mode === 'title' && auto === 'attract') {\\n    startEvent(w, 'pose-a');\\n    return;\\n  }\\n  if (flow.mode === 'event') {\\n    const activity = activityById(flow.event);\\n    let use = intents;\\n280→    if (auto === 'director') use = activity.bot(w, 'human');\\n    else if (auto === 'attract') use = activity.bot(w, 'perfect');\\n    activity.step(w, use);\\n    const act = actOf(w);\\n    if (act.done === 1 || (auto === 'attract' && act.tick >= SLICE)) finishEvent(w);\\n    return;\\n  }\\n  if ((flow.mode === 'results' || flow.mode === 'evening') && (auto === 'director' || auto === 'attract')) {\\n    const act = actOf(w);\\n    act.wait += 1;\\n290→    if (act.wait >= BEAT) {\\n      if (flow.mode === 'results') advance(w);\\n      else sleep(w);\\n    }\\n  }\\n}\\n\\n/** Menu picks. Each one runs between steps. */\\nexport const retreatActions = {\\n  'game.begin': (w: World, args: unknown) => {\\n300→    const given = rec(args);\\n    applySave(w, given);\\n    const flow = flowOf(w);\\n    applyLean(w, flow.day);\\n    if (flow.credits) {\\n      flow.mode = 'roam';\\n      flow.event = '';\\n      return;\\n    }\\n    openItem(w, programme()[flow.cursor]);\\n310→  },\\n  'game.start': (w: World, args: unknown) => {\\n    const event = strArg(rec(args), 'event');\\n    if (!event) return;\\n    if (event === 'evening') openEvening(w);\\n    else if (event === 'credits') openCredits(w);\\n    else startEvent(w, event);\\n  },\\n  'game.carry': (w: World) => {\\n    if (flowOf(w).mode === 'results') advance(w);\\n320→  },\\n  'game.sleep': (w: World) => {\\n    if (flowOf(w).mode === 'evening') sleep(w);\\n  },\\n  'game.leave': (w: World) => {\\n    const flow = flowOf(w);\\n    const activity = findActivity(flow.event);\\n    if (activity && flow.mode === 'event') activity.teardown(w);\\n    flow.mode = 'roam';\\n    flow.event = '';\\n330→  },\\n  'game.jump': (w: World, args: unknown) => {\\n    const given = rec(args);\\n    const step = strArg(given, 'step');\\n    const event = strArg(given, 'event');\\n    const day = numArg(given, 'day');\\n    if (step) {\\n      jumpTilt(w, step);\\n      return;\\n    }\\n340→    if (event) {\\n      startEvent(w, event);\\n      return;\\n    }\\n    if (day === undefined) return;\\n    const list = programme();\\n    const at = list.findIndex((item) => item.day === day);\\n    if (at < 0) return;\\n    const flow = flowOf(w);\\n    flow.cursor = at;\\n350→    flow.day = day;\\n    applyLean(w, day);\\n    openItem(w, list[at]);\\n  },\\n  'game.finish': (w: World, args: unknown) => {\\n    if (flowOf(w).mode !== 'event') return;\\n    finishEvent(w, strArg(rec(args), 'rank'));\\n  },\\n};\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"offset\":255,\"limit\":120,\"raw_output\":\"/** One seat, the day, and the island. The first step starts a director or a demo. */\\nexport function boot(w: World): void {\\n  drawSway(w);\\n  w.spawn({\\n    flow: { mode: 'title', day: 1 },\\n    act: emptyAct() as unknown as Record<string, unknown>,\\n    island: { tiltX: 0.4, tiltZ: 0, base: 0.4 },\\n  });\\n}\\n\\n/** One step of whatever the day is doing. */\\nexport function frame(w: World, intents: Intents): void {\\n  const flow = flowOf(w);\\n  const auto = autoOf(w);\\n  if (flow.mode === 'title' && auto === 'director') {\\n    openItem(w, programme()[flow.cursor]);\\n    return;\\n  }\\n  if (flow.mode === 'title' && auto === 'attract') {\\n    startEvent(w, 'pose-a');\\n    return;\\n  }\\n  if (flow.mode === 'event') {\\n    const activity = activityById(flow.event);\\n    let use = intents;\\n    if (auto === 'director') use = activity.bot(w, 'human');\\n    else if (auto === 'attract') use = activity.bot(w, 'perfect');\\n    activity.step(w, use);\\n    const act = actOf(w);\\n    if (act.done === 1 || (auto === 'attract' && act.tick >= SLICE)) finishEvent(w);\\n    return;\\n  }\\n  if ((flow.mode === 'results' || flow.mode === 'evening') && (auto === 'director' || auto === 'attract')) {\\n    const act = actOf(w);\\n    act.wait += 1;\\n    if (act.wait >= BEAT) {\\n      if (flow.mode === 'results') advance(w);\\n      else sleep(w);\\n    }\\n  }\\n}\\n\\n/** Menu picks. Each one runs between steps. */\\nexport const retreatActions = {\\n  'game.begin': (w: World, args: unknown) => {\\n    const given = rec(args);\\n    applySave(w, given);\\n    const flow = flowOf(w);\\n    applyLean(w, flow.day);\\n    if (flow.credits) {\\n      flow.mode = 'roam';\\n      flow.event = '';\\n      return;\\n    }\\n    openItem(w, programme()[flow.cursor]);\\n  },\\n  'game.start': (w: World, args: unknown) => {\\n    const event = strArg(rec(args), 'event');\\n    if (!event) return;\\n    if (event === 'evening') openEvening(w);\\n    else if (event === 'credits') openCredits(w);\\n    else startEvent(w, event);\\n  },\\n  'game.carry': (w: World) => {\\n    if (flowOf(w).mode === 'results') advance(w);\\n  },\\n  'game.sleep': (w: World) => {\\n    if (flowOf(w).mode === 'evening') sleep(w);\\n  },\\n  'game.leave': (w: World) => {\\n    const flow = flowOf(w);\\n    const activity = findActivity(flow.event);\\n    if (activity && flow.mode === 'event') activity.teardown(w);\\n    flow.mode = 'roam';\\n    flow.event = '';\\n  },\\n  'game.jump': (w: World, args: unknown) => {\\n    const given = rec(args);\\n    const step = strArg(given, 'step');\\n    const event = strArg(given, 'event');\\n    const day = numArg(given, 'day');\\n    if (step) {\\n      jumpTilt(w, step);\\n      return;\\n    }\\n    if (event) {\\n      startEvent(w, event);\\n      return;\\n    }\\n    if (day === undefined) return;\\n    const list = programme();\\n    const at = list.findIndex((item) => item.day === day);\\n    if (at < 0) return;\\n    const flow = flowOf(w);\\n    flow.cursor = at;\\n    flow.day = day;\\n    applyLean(w, day);\\n    openItem(w, list[at]);\\n  },\\n  'game.finish': (w: World, args: unknown) => {\\n    if (flowOf(w).mode !== 'event') return;\\n    finishEvent(w, strArg(rec(args), 'rank'));\\n  },\\n};\\n\",\"total_lines\":358}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35