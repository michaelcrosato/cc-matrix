{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-1c0b1d7e-4a96-497f-8587-70becb3a3e57-3","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\\n * that stands in for a player when `game.auto` is director or attract. Menus arrive as scene actions.\\n */\\nimport type { Intents, World } from '../../../engine/sim-api';\\nimport { activityById, findActivity } from './catalog';\\nimport { programme, type ProgrammeItem } from './data/days';\\nimport { actOf, flowOf, rowOf } from './events/kit';\\nimport { clampScore, pebblesOf, rankOf, wobbleAge } from './score';\\n10→import { type Act, type Flow, type Island, emptyAct, part, resetAct, visit } from './state';\\nimport { drawSway, resetBalance } from './wobble';\\n\\n/** How long a result or an evening stays up when the director is walking. */\\nconst BEAT = 45;\\n\\n/** Attract shows each slice for about fifteen seconds, then the next. */\\nconst SLICE = 15 * 60;\\n\\n/** The demo loop. The Great Tilt slice opens on the centre stone. */\\n20→const SLICES = ['pose-a', 'pond', 'line', 'paddle', 'garden', 'tilt'];\\n\\n/** A rank a dev jump can stamp without playing the hold. */\\nconst RANK_SCORE: Readonly<Record<string, number>> = {\\n  Present: 0,\\n  Adequate: 300,\\n  Composed: 550,\\n  Serene: 750,\\n  Unsettling: 900,\\n};\\n30→\\n/** The island lean. */\\nfunction islandOf(w: World): Island {\\n  return part<Island>(w, 'island');\\n}\\n\\n/** A plain object of action arguments, or an empty one. */\\nfunction rec(args: unknown): Record<string, unknown> {\\n  if (typeof args === 'object' && args !== null && !Array.isArray(args)) return args as Record<string, unknown>;\\n  return {};\\n40→}\\n\\n/** A finite number argument. */\\nfunction numArg(args: Record<string, unknown>, key: string): number | undefined {\\n  const value = args[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\\n}\\n\\n/** A string argument. */\\nfunction strArg(args: Record<string, unknown>, key: string): string | undefined {\\n50→  const value = args[key];\\n  return typeof value === 'string' ? value : undefined;\\n}\\n\\n/** Who is driving this step. */\\nfunction autoOf(w: World): string {\\n  return String(w.settings.get('game.auto'));\\n}\\n\\n/** Story lean for a residency day. Day 1 is 0.4 degrees, and each day adds half a degree. */\\n60→function leanFor(day: number): number {\\n  return 0.4 + 0.5 * (day - 1);\\n}\\n\\n/** Writes the day's lean onto the island. The mesh does not move. */\\nfunction applyLean(w: World, day: number): void {\\n  const island = islandOf(w);\\n  const base = leanFor(day);\\n  island.base = base;\\n  island.tiltX = base;\\n70→  island.tiltZ = 0;\\n}\\n\\n/** Starts one activity. Setup runs now, so its spawned guests exist before the next step. */\\nexport function startEvent(w: World, id: string): void {\\n  const flow = flowOf(w);\\n  const previous = findActivity(flow.event);\\n  if (previous && flow.mode === 'event') previous.teardown(w);\\n  const activity = activityById(id);\\n  const act = actOf(w);\\n80→  resetAct(act);\\n  const row = rowOf(w, 0);\\n  resetBalance(row.wobble, row.hist);\\n  flow.mode = 'event';\\n  flow.event = id;\\n  visit(flow, id);\\n  if (id.startsWith('pose')) visit(flow, 'pose');\\n  activity.setup(w);\\n}\\n\\n90→/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\\nfunction finishEvent(w: World, rank?: string): void {\\n  const flow = flowOf(w);\\n  const activity = activityById(flow.event);\\n  let value = activity.score(w);\\n  activity.teardown(w);\\n  if (rank !== undefined && Object.hasOwn(RANK_SCORE, rank)) value = RANK_SCORE[rank] ?? value;\\n  value = clampScore(value);\\n  flow.result = value;\\n  flow.rank = rank !== undefined && Object.hasOwn(RANK_SCORE, rank) ? rank : rankOf(value);\\n100→  const auto = autoOf(w);\\n  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\\n  if (flow.event === 'morning') {\\n    flow.prior = flow.age;\\n    flow.age = wobbleAge(value / 1000, Number(w.settings.get('game.age.k')));\\n  }\\n  const act = actOf(w);\\n  act.done = 0;\\n  act.wait = 0;\\n  if (auto === 'attract') {\\n110→    const at = SLICES.indexOf(flow.event);\\n    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\\n    return;\\n  }\\n  flow.mode = 'results';\\n}\\n\\n/** The next programme row, when the one that just finished is the row the cursor is on. */\\nfunction advance(w: World): void {\\n  const flow = flowOf(w);\\n120→  const list = programme();\\n  const here = list[flow.cursor];\\n  if (!here || here.event !== flow.event) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.cursor += 1;\\n  openItem(w, list[flow.cursor]);\\n}\\n130→\\n/** Opens a programme row: an activity, the evening, or the credits. */\\nfunction openItem(w: World, item: ProgrammeItem | undefined): void {\\n  const flow = flowOf(w);\\n  if (!item) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.day = item.day;\\n140→  if (item.event === 'evening') openEvening(w);\\n  else if (item.event === 'credits') openCredits(w);\\n  else startEvent(w, item.event);\\n}\\n\\n/** The stamp at the end of a day. */\\nfunction openEvening(w: World): void {\\n  const flow = flowOf(w);\\n  const act = actOf(w);\\n  resetAct(act);\\n150→  flow.mode = 'evening';\\n  flow.event = 'evening';\\n  flow.line = 'evening.close';\\n  visit(flow, 'evening');\\n}\\n\\n/** The credits. The ferry does not come back. Free play stays available. */\\nfunction openCredits(w: World): void {\\n  const flow = flowOf(w);\\n  resetAct(actOf(w));\\n160→  flow.mode = 'credits';\\n  flow.event = 'credits';\\n  flow.credits = 1;\\n  flow.line = 'credits.roll';\\n  visit(flow, 'credits');\\n}\\n\\n/** Leaves the evening for the next morning, and leans the island a little more. */\\nfunction sleep(w: World): void {\\n  const flow = flowOf(w);\\n170→  const list = programme();\\n  if (list[flow.cursor]?.event === 'evening') flow.cursor += 1;\\n  const next = list[flow.cursor];\\n  if (!next) {\\n    openCredits(w);\\n    return;\\n  }\\n  flow.day = next.day;\\n  applyLean(w, next.day);\\n  if (next.event === 'credits') openCredits(w);\\n180→  else if (next.event === 'evening') openEvening(w);\\n  else startEvent(w, next.event);\\n}\\n\\n/** Puts the finale on a named step. Storm is where the activity already starts. */\\nfunction jumpTilt(w: World, step: string): void {\\n  startEvent(w, 'tilt');\\n  const act: Act = actOf(w);\\n  const flow: Flow = flowOf(w);\\n  const name = step.startsWith('tilt:') ? step : `tilt:${step}`;\\n190→  if (name === 'tilt:east') {\\n    act.phase = 1;\\n    act.a = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.east';\\n    visit(flow, 'tilt:east');\\n  } else if (name === 'tilt:stone') {\\n    act.phase = 2;\\n    act.a = 1;\\n    act.b = 1;\\n200→    act.left = 0;\",\"content_concise\":\"1→/**\\n * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\\n * that stands in for a player when `game.auto` is director or attract. Menus arrive as scene actions.\\n */\\nimport type { Intents, World } from '../../../engine/sim-api';\\nimport { activityById, findActivity } from './catalog';\\nimport { programme, type ProgrammeItem } from './data/days';\\nimport { actOf, flowOf, rowOf } from './events/kit';\\nimport { clampScore, pebblesOf, rankOf, wobbleAge } from './score';\\n10→import { type Act, type Flow, type Island, emptyAct, part, resetAct, visit } from './state';\\nimport { drawSway, resetBalance } from './wobble';\\n\\n/** How long a result or an evening stays up when the director is walking. */\\nconst BEAT = 45;\\n\\n/** Attract shows each slice for about fifteen seconds, then the next. */\\nconst SLICE = 15 * 60;\\n\\n/** The demo loop. The Great Tilt slice opens on the centre stone. */\\n20→const SLICES = ['pose-a', 'pond', 'line', 'paddle', 'garden', 'tilt'];\\n\\n/** A rank a dev jump can stamp without playing the hold. */\\nconst RANK_SCORE: Readonly<Record<string, number>> = {\\n  Present: 0,\\n  Adequate: 300,\\n  Composed: 550,\\n  Serene: 750,\\n  Unsettling: 900,\\n};\\n30→\\n/** The island lean. */\\nfunction islandOf(w: World): Island {\\n  return part<Island>(w, 'island');\\n}\\n\\n/** A plain object of action arguments, or an empty one. */\\nfunction rec(args: unknown): Record<string, unknown> {\\n  if (typeof args === 'object' && args !== null && !Array.isArray(args)) return args as Record<string, unknown>;\\n  return {};\\n40→}\\n\\n/** A finite number argument. */\\nfunction numArg(args: Record<string, unknown>, key: string): number | undefined {\\n  const value = args[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\\n}\\n\\n/** A string argument. */\\nfunction strArg(args: Record<string, unknown>, key: string): string | undefined {\\n50→  const value = args[key];\\n  return typeof value === 'string' ? value : undefined;\\n}\\n\\n/** Who is driving this step. */\\nfunction autoOf(w: World): string {\\n  return String(w.settings.get('game.auto'));\\n}\\n\\n/** Story lean for a residency day. Day 1 is 0.4 degrees, and each day adds half a degree. */\\n60→function leanFor(day: number): number {\\n  return 0.4 + 0.5 * (day - 1);\\n}\\n\\n/** Writes the day's lean onto the island. The mesh does not move. */\\nfunction applyLean(w: World, day: number): void {\\n  const island = islandOf(w);\\n  const base = leanFor(day);\\n  island.base = base;\\n  island.tiltX = base;\\n70→  island.tiltZ = 0;\\n}\\n\\n/** Starts one activity. Setup runs now, so its spawned guests exist before the next step. */\\nexport function startEvent(w: World, id: string): void {\\n  const flow = flowOf(w);\\n  const previous = findActivity(flow.event);\\n  if (previous && flow.mode === 'event') previous.teardown(w);\\n  const activity = activityById(id);\\n  const act = actOf(w);\\n80→  resetAct(act);\\n  const row = rowOf(w, 0);\\n  resetBalance(row.wobble, row.hist);\\n  flow.mode = 'event';\\n  flow.event = id;\\n  visit(flow, id);\\n  if (id.startsWith('pose')) visit(flow, 'pose');\\n  activity.setup(w);\\n}\\n\\n90→/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\\nfunction finishEvent(w: World, rank?: string): void {\\n  const flow = flowOf(w);\\n  const activity = activityById(flow.event);\\n  let value = activity.score(w);\\n  activity.teardown(w);\\n  if (rank !== undefined && Object.hasOwn(RANK_SCORE, rank)) value = RANK_SCORE[rank] ?? value;\\n  value = clampScore(value);\\n  flow.result = value;\\n  flow.rank = rank !== undefined && Object.hasOwn(RANK_SCORE, rank) ? rank : rankOf(value);\\n100→  const auto = autoOf(w);\\n  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\\n  if (flow.event === 'morning') {\\n    flow.prior = flow.age;\\n    flow.age = wobbleAge(value / 1000, Number(w.settings.get('game.age.k')));\\n  }\\n  const act = actOf(w);\\n  act.done = 0;\\n  act.wait = 0;\\n  if (auto === 'attract') {\\n110→    const at = SLICES.indexOf(flow.event);\\n    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\\n    return;\\n  }\\n  flow.mode = 'results';\\n}\\n\\n/** The next programme row, when the one that just finished is the row the cursor is on. */\\nfunction advance(w: World): void {\\n  const flow = flowOf(w);\\n120→  const list = programme();\\n  const here = list[flow.cursor];\\n  if (!here || here.event !== flow.event) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.cursor += 1;\\n  openItem(w, list[flow.cursor]);\\n}\\n130→\\n/** Opens a programme row: an activity, the evening, or the credits. */\\nfunction openItem(w: World, item: ProgrammeItem | undefined): void {\\n  const flow = flowOf(w);\\n  if (!item) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.day = item.day;\\n140→  if (item.event === 'evening') openEvening(w);\\n  else if (item.event === 'credits') openCredits(w);\\n  else startEvent(w, item.event);\\n}\\n\\n/** The stamp at the end of a day. */\\nfunction openEvening(w: World): void {\\n  const flow = flowOf(w);\\n  const act = actOf(w);\\n  resetAct(act);\\n150→  flow.mode = 'evening';\\n  flow.event = 'evening';\\n  flow.line = 'evening.close';\\n  visit(flow, 'evening');\\n}\\n\\n/** The credits. The ferry does not come back. Free play stays available. */\\nfunction openCredits(w: World): void {\\n  const flow = flowOf(w);\\n  resetAct(actOf(w));\\n160→  flow.mode = 'credits';\\n  flow.event = 'credits';\\n  flow.credits = 1;\\n  flow.line = 'credits.roll';\\n  visit(flow, 'credits');\\n}\\n\\n/** Leaves the evening for the next morning, and leans the island a little more. */\\nfunction sleep(w: World): void {\\n  const flow = flowOf(w);\\n170→  const list = programme();\\n  if (list[flow.cursor]?.event === 'evening') flow.cursor += 1;\\n  const next = list[flow.cursor];\\n  if (!next) {\\n    openCredits(w);\\n    return;\\n  }\\n  flow.day = next.day;\\n  applyLean(w, next.day);\\n  if (next.event === 'credits') openCredits(w);\\n180→  else if (next.event === 'evening') openEvening(w);\\n  else startEvent(w, next.event);\\n}\\n\\n/** Puts the finale on a named step. Storm is where the activity already starts. */\\nfunction jumpTilt(w: World, step: string): void {\\n  startEvent(w, 'tilt');\\n  const act: Act = actOf(w);\\n  const flow: Flow = flowOf(w);\\n  const name = step.startsWith('tilt:') ? step : `tilt:${step}`;\\n190→  if (name === 'tilt:east') {\\n    act.phase = 1;\\n    act.a = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.east';\\n    visit(flow, 'tilt:east');\\n  } else if (name === 'tilt:stone') {\\n    act.phase = 2;\\n    act.a = 1;\\n    act.b = 1;\\n200→    act.left = 0;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"offset\":null,\"limit\":200,\"raw_output\":\"/**\\n * @file The day. Boot puts a seat and a programme on the world. Each step runs the activity, or the thumb\\n * that stands in for a player when `game.auto` is director or attract. Menus arrive as scene actions.\\n */\\nimport type { Intents, World } from '../../../engine/sim-api';\\nimport { activityById, findActivity } from './catalog';\\nimport { programme, type ProgrammeItem } from './data/days';\\nimport { actOf, flowOf, rowOf } from './events/kit';\\nimport { clampScore, pebblesOf, rankOf, wobbleAge } from './score';\\nimport { type Act, type Flow, type Island, emptyAct, part, resetAct, visit } from './state';\\nimport { drawSway, resetBalance } from './wobble';\\n\\n/** How long a result or an evening stays up when the director is walking. */\\nconst BEAT = 45;\\n\\n/** Attract shows each slice for about fifteen seconds, then the next. */\\nconst SLICE = 15 * 60;\\n\\n/** The demo loop. The Great Tilt slice opens on the centre stone. */\\nconst SLICES = ['pose-a', 'pond', 'line', 'paddle', 'garden', 'tilt'];\\n\\n/** A rank a dev jump can stamp without playing the hold. */\\nconst RANK_SCORE: Readonly<Record<string, number>> = {\\n  Present: 0,\\n  Adequate: 300,\\n  Composed: 550,\\n  Serene: 750,\\n  Unsettling: 900,\\n};\\n\\n/** The island lean. */\\nfunction islandOf(w: World): Island {\\n  return part<Island>(w, 'island');\\n}\\n\\n/** A plain object of action arguments, or an empty one. */\\nfunction rec(args: unknown): Record<string, unknown> {\\n  if (typeof args === 'object' && args !== null && !Array.isArray(args)) return args as Record<string, unknown>;\\n  return {};\\n}\\n\\n/** A finite number argument. */\\nfunction numArg(args: Record<string, unknown>, key: string): number | undefined {\\n  const value = args[key];\\n  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;\\n}\\n\\n/** A string argument. */\\nfunction strArg(args: Record<string, unknown>, key: string): string | undefined {\\n  const value = args[key];\\n  return typeof value === 'string' ? value : undefined;\\n}\\n\\n/** Who is driving this step. */\\nfunction autoOf(w: World): string {\\n  return String(w.settings.get('game.auto'));\\n}\\n\\n/** Story lean for a residency day. Day 1 is 0.4 degrees, and each day adds half a degree. */\\nfunction leanFor(day: number): number {\\n  return 0.4 + 0.5 * (day - 1);\\n}\\n\\n/** Writes the day's lean onto the island. The mesh does not move. */\\nfunction applyLean(w: World, day: number): void {\\n  const island = islandOf(w);\\n  const base = leanFor(day);\\n  island.base = base;\\n  island.tiltX = base;\\n  island.tiltZ = 0;\\n}\\n\\n/** Starts one activity. Setup runs now, so its spawned guests exist before the next step. */\\nexport function startEvent(w: World, id: string): void {\\n  const flow = flowOf(w);\\n  const previous = findActivity(flow.event);\\n  if (previous && flow.mode === 'event') previous.teardown(w);\\n  const activity = activityById(id);\\n  const act = actOf(w);\\n  resetAct(act);\\n  const row = rowOf(w, 0);\\n  resetBalance(row.wobble, row.hist);\\n  flow.mode = 'event';\\n  flow.event = id;\\n  visit(flow, id);\\n  if (id.startsWith('pose')) visit(flow, 'pose');\\n  activity.setup(w);\\n}\\n\\n/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\\nfunction finishEvent(w: World, rank?: string): void {\\n  const flow = flowOf(w);\\n  const activity = activityById(flow.event);\\n  let value = activity.score(w);\\n  activity.teardown(w);\\n  if (rank !== undefined && Object.hasOwn(RANK_SCORE, rank)) value = RANK_SCORE[rank] ?? value;\\n  value = clampScore(value);\\n  flow.result = value;\\n  flow.rank = rank !== undefined && Object.hasOwn(RANK_SCORE, rank) ? rank : rankOf(value);\\n  const auto = autoOf(w);\\n  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\\n  if (flow.event === 'morning') {\\n    flow.prior = flow.age;\\n    flow.age = wobbleAge(value / 1000, Number(w.settings.get('game.age.k')));\\n  }\\n  const act = actOf(w);\\n  act.done = 0;\\n  act.wait = 0;\\n  if (auto === 'attract') {\\n    const at = SLICES.indexOf(flow.event);\\n    startEvent(w, SLICES[(at + 1) % SLICES.length] ?? 'pose-a');\\n    return;\\n  }\\n  flow.mode = 'results';\\n}\\n\\n/** The next programme row, when the one that just finished is the row the cursor is on. */\\nfunction advance(w: World): void {\\n  const flow = flowOf(w);\\n  const list = programme();\\n  const here = list[flow.cursor];\\n  if (!here || here.event !== flow.event) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.cursor += 1;\\n  openItem(w, list[flow.cursor]);\\n}\\n\\n/** Opens a programme row: an activity, the evening, or the credits. */\\nfunction openItem(w: World, item: ProgrammeItem | undefined): void {\\n  const flow = flowOf(w);\\n  if (!item) {\\n    flow.mode = 'roam';\\n    flow.event = '';\\n    return;\\n  }\\n  flow.day = item.day;\\n  if (item.event === 'evening') openEvening(w);\\n  else if (item.event === 'credits') openCredits(w);\\n  else startEvent(w, item.event);\\n}\\n\\n/** The stamp at the end of a day. */\\nfunction openEvening(w: World): void {\\n  const flow = flowOf(w);\\n  const act = actOf(w);\\n  resetAct(act);\\n  flow.mode = 'evening';\\n  flow.event = 'evening';\\n  flow.line = 'evening.close';\\n  visit(flow, 'evening');\\n}\\n\\n/** The credits. The ferry does not come back. Free play stays available. */\\nfunction openCredits(w: World): void {\\n  const flow = flowOf(w);\\n  resetAct(actOf(w));\\n  flow.mode = 'credits';\\n  flow.event = 'credits';\\n  flow.credits = 1;\\n  flow.line = 'credits.roll';\\n  visit(flow, 'credits');\\n}\\n\\n/** Leaves the evening for the next morning, and leans the island a little more. */\\nfunction sleep(w: World): void {\\n  const flow = flowOf(w);\\n  const list = programme();\\n  if (list[flow.cursor]?.event === 'evening') flow.cursor += 1;\\n  const next = list[flow.cursor];\\n  if (!next) {\\n    openCredits(w);\\n    return;\\n  }\\n  flow.day = next.day;\\n  applyLean(w, next.day);\\n  if (next.event === 'credits') openCredits(w);\\n  else if (next.event === 'evening') openEvening(w);\\n  else startEvent(w, next.event);\\n}\\n\\n/** Puts the finale on a named step. Storm is where the activity already starts. */\\nfunction jumpTilt(w: World, step: string): void {\\n  startEvent(w, 'tilt');\\n  const act: Act = actOf(w);\\n  const flow: Flow = flowOf(w);\\n  const name = step.startsWith('tilt:') ? step : `tilt:${step}`;\\n  if (name === 'tilt:east') {\\n    act.phase = 1;\\n    act.a = 1;\\n    act.left = 0;\\n    flow.line = 'tilt.east';\\n    visit(flow, 'tilt:east');\\n  } else if (name === 'tilt:stone') {\\n    act.phase = 2;\\n    act.a = 1;\\n    act.b = 1;\\n    act.left = 0;\\n\",\"total_lines\":344}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1c0b1d7e-4a96-497f-8587-70becb3a3e57-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/**\\n * @file The retreat's plain data: where the day is, what the activity is counting, and the island's tilt.\\n * Arrays are given fresh at spawn. Nothing here is remembered in a module variable.\\n */\\nimport { defineComponent, type World } from '../../../engine/sim-api';\\n\\n/** Where the guest is in the day. */\\nexport interface Flow {\\n  mode: string;\\n10→  event: string;\\n  day: number;\\n  cursor: number;\\n  seen: string;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n20→  prior: number;\\n}\\n\\n/** The activity blackboard. `goals` holds targets, lure times and marble holes. */\\nexport interface Act {\\n  phase: number;\\n  tick: number;\\n  left: number;\\n  done: number;\\n  a: number;\\n30→  b: number;\\n  c: number;\\n  n: number;\\n  m: number;\\n  hold: number;\\n  falls: number;\\n  dist: number;\\n  gx: number;\\n  gy: number;\\n  px: number;\\n40→  py: number;\\n  vx: number;\\n  vy: number;\\n  hx: number;\\n  hz: number;\\n  calm: number;\\n  wait: number;\\n  samples: number;\\n  acc: number;\\n  acc2: number;\\n50→  top0: number;\\n  pose: number;\\n  flags: number;\\n  foot: number;\\n  text: string;\\n  goals: number[];\\n}\\n\\n/** The island's lean, in degrees. The mesh never moves. The push does. */\\nexport interface Island {\\n60→  tiltX: number;\\n  tiltZ: number;\\n  base: number;\\n}\\n\\nconst num = (description: string) => ({ type: 'number' as const, default: 0, description });\\nconst str = (description: string) => ({ type: 'string' as const, default: '', description });\\n\\n/** The component `flow`. One entity holds the day. */\\nexport const FLOW = defineComponent('flow', {\\n70→  description: 'The day, the activity, the score on the table and whether the credits have rolled.',\\n  fields: {\\n    mode: str(\\\"title, roam, event, results, evening or credits.\\\"),\\n    event: str('The activity id while one is running.'),\\n    day: { type: 'integer', default: 1, description: 'The residency day, from 1.' },\\n    cursor: { type: 'integer', default: 0, description: 'The programme index.' },\\n    seen: str('Comma-separated ids already visited.'),\\n    credits: { type: 'integer', default: 0, description: '1 once the credits have started.' },\\n    line: str('The line id the page should say.'),\\n    result: num('The last score, 0 to 1000.'),\\n80→    age: num('The last Wobble Age.'),\\n    pebbles: num('Pebbles stacked so far. They are not spent.'),\\n    rank: str('The last rank word.'),\\n    prior: num(\\\"Yesterday's Wobble Age, or 0.\\\"),\\n  },\\n});\\n\\n/** The component `act`. One entity holds the activity. */\\nexport const ACT = defineComponent('act', {\\n  description: 'Counters for the activity that is running. Cleared when the next one starts.',\\n90→  fields: {\\n    phase: num('Which part of the activity is playing.'),\\n    tick: num('Steps since this activity started.'),\\n    left: num('Steps left in a box, or steps into the current part.'),\\n    done: num('1 when the activity has ended itself.'),\\n    a: num('Score part A, or a frozen class score.'),\\n    b: num('Score part B.'),\\n    c: num('Score part C.'),\\n    n: num('A count.'),\\n    m: num('Another count.'),\\n100→    hold: num('Steps the current target has been held.'),\\n    falls: num('Falls, topples or splashes the score counts.'),\\n    dist: num('Metres along a line, or a share.'),\\n    gx: num('Guide or goal, left to right.'),\\n    gy: num('Guide or goal, back to forward.'),\\n    px: num('A board, a marble or a guest, east.'),\\n    py: num('A board, a marble or a guest, south.'),\\n    vx: num('Speed east.'),\\n    vy: num('Speed south.'),\\n    hx: num('Lateral error, or a heading.'),\\n110→    hz: num('A second heading or a bias.'),\\n    calm: num('Composure, or a stored calm.'),\\n    wait: num('Steps until the next penalty or lure.'),\\n    samples: num('Steps counted toward a share.'),\\n    acc: num('Steps that counted, or a sum.'),\\n    acc2: num('A second sum, usually breath.'),\\n    top0: num('Topples at the start of a hold.'),\\n    pose: num('Which pose or tray is up.'),\\n    flags: num('Small bit flags for the activity.'),\\n    foot: num('The foot in use. 1 left, 2 right.'),\\n120→    text: str('A lure id, a pose id, or a short note.'),\\n    goals: { type: 'array', items: { type: 'number' }, default: [], description: 'Targets and schedules.' },\\n  },\\n});\\n\\n/** The component `island`. */\\nexport const ISLAND = defineComponent('island', {\\n  description: 'How far the island is leaning. Geometry stays. People and drinks do not.',\\n  fields: {\\n    tiltX: num('Lean toward the west, degrees.'),\\n130→    tiltZ: num('Lean toward the north, degrees.'),\\n    base: num('The story lean for this day, degrees.'),\\n  },\\n});\\n\\n/** Something an activity spawned and must remove. */\\nexport const MADE = defineComponent('made', {\\n  description: 'An entity an activity spawned. Teardown removes every one.',\\n  fields: { tag: str('What it was.') },\\n});\\n140→\\n/** A neighbour's lean, sent by the hub. It never moves the local guest. */\\nexport const GHOST = defineComponent('ghost', {\\n  description: 'Another player on the next mat. Drawn from hub messages. Local play ignores it.',\\n  fields: {\\n    on: num('1 while a message has arrived for this seat.'),\\n    x: num('Their centre, left to right.'),\\n    y: num('Their centre, back to forward.'),\\n    seat: { type: 'integer', default: 0, description: 'Their mat.' },\\n    pose: num('Which class they are in.'),\\n150→  },\\n});\\n\\n/** Who an actor is. The pilot reads it. */\\nexport const ROLE = defineComponent('role', {\\n  description: 'Which member of the retreat this actor is.',\\n  fields: { who: str('guest, plumb, tare, gerald, bex, nan, gull or frog.') },\\n});\\n\\n/** A guest drifting in the finale, or a plaque, drawn as a small box. */\\n160→export const MARK = defineComponent('mark', {\\n  description: 'A placed thing: a hidden pebble, a plaque, a drifting guest or a mat.',\\n  fields: {\\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\\n    y: { type: 'number', default: 0, unit: 'm', description: 'Up.' },\\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\\n    kind: str('pebble, plaque, guest, mat or cairn.'),\\n    text: str('A line id, when it has one.'),\\n    taken: num('1 once a pebble is picked up.'),\\n    follow: num('1 when a finale guest is walking with you.'),\\n170→  },\\n});\\n\\n/** A blank activity board with its own array. */\\nexport function emptyAct(): Act {\\n  return {\\n    phase: 0, tick: 0, left: 0, done: 0, a: 0, b: 0, c: 0, n: 0, m: 0, hold: 0, falls: 0,\\n    dist: 0, gx: 0, gy: 0, px: 0, py: 0, vx: 0, vy: 0, hx: 0, hz: 0, calm: 0, wait: 0,\\n    samples: 0, acc: 0, acc2: 0, top0: 0, pose: 0, flags: 0, foot: 0, text: '', goals: [],\\n  };\\n180→}\",\"content_concise\":\"1→/**\\n * @file The retreat's plain data: where the day is, what the activity is counting, and the island's tilt.\\n * Arrays are given fresh at spawn. Nothing here is remembered in a module variable.\\n */\\nimport { defineComponent, type World } from '../../../engine/sim-api';\\n\\n/** Where the guest is in the day. */\\nexport interface Flow {\\n  mode: string;\\n10→  event: string;\\n  day: number;\\n  cursor: number;\\n  seen: string;\\n  credits: number;\\n  line: string;\\n  result: number;\\n  age: number;\\n  pebbles: number;\\n  rank: string;\\n20→  prior: number;\\n}\\n\\n/** The activity blackboard. `goals` holds targets, lure times and marble holes. */\\nexport interface Act {\\n  phase: number;\\n  tick: number;\\n  left: number;\\n  done: number;\\n  a: number;\\n30→  b: number;\\n  c: number;\\n  n: number;\\n  m: number;\\n  hold: number;\\n  falls: number;\\n  dist: number;\\n  gx: number;\\n  gy: number;\\n  px: number;\\n40→  py: number;\\n  vx: number;\\n  vy: number;\\n  hx: number;\\n  hz: number;\\n  calm: number;\\n  wait: number;\\n  samples: number;\\n  acc: number;\\n  acc2: number;\\n50→  top0: number;\\n  pose: number;\\n  flags: number;\\n  foot: number;\\n  text: string;\\n  goals: number[];\\n}\\n\\n/** The island's lean, in degrees. The mesh never moves. The push does. */\\nexport interface Island {\\n60→  tiltX: number;\\n  tiltZ: number;\\n  base: number;\\n}\\n\\nconst num = (description: string) => ({ type: 'number' as const, default: 0, description });\\nconst str = (description: string) => ({ type: 'string' as const, default: '', de