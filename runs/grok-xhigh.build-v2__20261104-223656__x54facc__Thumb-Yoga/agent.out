4,83,93,32,125,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":50,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/tools/eslint/simSide.ts\",\"matches\":[{\"line_number\":7,\"content\":\" * `engine/dev/bot.ts` and the gallery's scene (`engine/dev/galleryScene.ts`), every lab's scenes and cast (the box's,\"},{\"line_number\":9,\"content\":\" * labs/playground/sounds/{events,ground}.ts: the scenes' `sounds`), and the fixture scenes; `*.test.ts` files are\"},{\"line_number\":39,\"content\":\"  'no-restricted-imports',\"},{\"line_number\":54,\"content\":\"  'labs/*/scenes/**',\"},{\"line_number\":59,\"content\":\"  'fixtures/scenes/**',\"},{\"line_number\":105,\"content\":\"  \\\"sim-side code never imports three.js: take its math classes from engine/core/math (engine code) or engine/sim-api (game code); drawing is gfx/'s (PLAN.md §6.5)\\\";\"},{\"line_number\":110,\"content\":\"/** A `sim/no-restricted-imports` block: every Node built-in by its bare name, then `patterns`. */\"},{\"line_number\":120,\"content\":\"    rules: { 'sim/no-restricted-imports': ['error', { paths, patterns }] },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/tools/eslint/family.ts\",\"matches\":[{\"line_number\":6,\"content\":\" * `no-restricted-imports` on one file would silently lose one family's list. Each family therefore registers the core\"},{\"line_number\":7,\"content\":\" * rules it uses under its own plugin name (`layer/no-restricted-imports`, `sim/no-restricted-globals`): families never\"},{\"line_number\":9,\"content\":\" * except where `resolvingImports` wraps it: `no-restricted-imports` matches the raw source text, so the families\"},{\"line_number\":49,\"content\":\"/** `plugin` with its `no-restricted-imports` matching each relative source as resolved from the importing file. */\"},{\"line_number\":51,\"content\":\"  const rule = plugin.rules?.['no-restricted-imports'] as Rule.RuleModule | undefined;\"},{\"line_number\":52,\"content\":\"  if (!rule) throw new Error(`${plugin.meta?.name} has no no-restricted-imports to resolve`);\"},{\"line_number\":83,\"content\":\"  return { ...plugin, rules: { ...plugin.rules, 'no-restricted-imports': resolving } };\"},{\"line_number\":135,\"content\":\"/** Every `message` in a list of blocks' rule options, `no-restricted-imports`'s paths and patterns included. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/tools/eslint/layers.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file The layer rules (PLAN.md §6.1; doctrines: WebGPU only, Reproducible): one `no-restricted-imports` block per\"},{\"line_number\":11,\"content\":\" * module imports the public barrels (`../index`, `../sim-api`, `..`): they are for game code, and re-export the\"},{\"line_number\":16,\"content\":\" * `layer/no-restricted-imports`.\"},{\"line_number\":20,\"content\":\" * // → layer/no-restricted-imports: engine/core imports nothing from the other layers: …\"},{\"line_number\":26,\"content\":\"/** The plugin the layer blocks use: core's `no-restricted-imports`, resolving, as `layer/no-restricted-imports`. */\"},{\"line_number\":27,\"content\":\"export const layerPlugin: ESLint.Plugin = resolvingImports(family('layer', 'no-restricted-imports'));\"},{\"line_number\":78,\"content\":\"/** The public barrels from inside the engine: `../index`, `../sim-api`, or `..` (engine/ itself, its index). */\"},{\"line_number\":80,\"content\":\"  regex: '^(?:(?:\\\\\\\\.\\\\\\\\./)+(?:index|sim-api)(?:\\\\\\\\.ts)?|\\\\\\\\.\\\\\\\\.(?:/\\\\\\\\.\\\\\\\\.)*)$',\"},{\"line_number\":82,\"content\":\"    'engine code never imports the public barrels (engine/index.ts, engine/sim-api.ts): they re-export the engine, so the import makes a cycle; import the module that declares the name (PLAN.md §6.1)',\"},{\"line_number\":267,\"content\":\"    name: 'sim-api.ts',\"},{\"line_number\":268,\"content\":\"    files: ['engine/sim-api.ts'],\"},{\"line_number\":292,\"content\":\"      rules: { 'layer/no-restricted-imports': ['error', { paths: layer.paths ?? [], patterns }] },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/tools/eslint/publicApi.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * only through its barrels, `engine/index.ts` (pages) and `engine/sim-api.ts` (sim-side code), and never three.js or\"},{\"line_number\":6,\"content\":\" * Game code is `labs/` (the box's and the starter game's pages, scenes and cast; a game's own, made from the starter)\"},{\"line_number\":7,\"content\":\" * and `fixtures/scenes/`; `labs/hello/` is a harness page and is exempt, and so are `*.test.ts` files. Sim-side game\"},{\"line_number\":8,\"content\":\" * code (every lab's `scenes/` and `cast/`, `fixtures/scenes/`) takes only `engine/sim-api.ts`, so `x sim` runs it in\"},{\"line_number\":13,\"content\":\" * types (`type W = import('…').World`, `typeof import('…')`) never reach `no-restricted-imports`, so\"},{\"line_number\":22,\"content\":\" * // labs/box/scenes/room.ts: import { Vector3 } from '../../../engine/core/math';\"},{\"line_number\":23,\"content\":\" * // → public-api/no-restricted-imports: 'Vector3' import from … Import it from engine/sim-api.ts …\"},{\"line_number\":39,\"content\":\" * matched like `no-restricted-imports` matches named ones (options `{ patterns: [{ regex, message }] }`).\"},{\"line_number\":78,\"content\":\"/** The plugin the public-API blocks use: core's `no-restricted-imports` (resolving) and `no-unnamed-imports`. */\"},{\"line_number\":80,\"content\":\"  ...resolvingImports(family('public-api', 'no-restricted-imports')),\"},{\"line_number\":82,\"content\":\"    ...resolvingImports(family('public-api', 'no-restricted-imports')).rules,\"},{\"line_number\":88,\"content\":\"export const SIM_SIDE_GAME_CODE = ['labs/*/scenes/**', 'labs/*/cast/**', 'fixtures/scenes/**'];\"},{\"line_number\":94,\"content\":\"  message: `game code reaches three.js through the barrels: its math classes (${THREE_MATH.join(', ')}) from engine/sim-api.ts, AnimationClip and AnimationMixer from engine/index.ts; for anything else, the barrel gains a documented re-export (PLAN.md §6.1)`,\"},{\"line_number\":100,\"content\":\"    'game code reaches physics through engine/sim-api.ts (bodies, queries), never Rapier itself (PLAN.md §6.1, ADR-0020)',\"},{\"line_number\":114,\"content\":\"        message: `${where}: import it from ${allowed === 'sim-api' ? 'engine/sim-api.ts' : 'engine/index.ts (pages) or engine/sim-api.ts (sim-side code)'} under the same name; if the barrel lacks it, add the re-export there with its doc comment (PLAN.md §6.1, ADR-0020)`,\"},{\"line_number\":125,\"content\":\"        'public-api/no-restricted-imports': [severity, { patterns }],\"},{\"line_number\":138,\"content\":\"      'index|sim-api',\"},{\"line_number\":145,\"content\":\"      'sim-api',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/tools/eslint/banned.ts\",\"matches\":[{\"line_number\":26,\"content\":\"const restrictions = family('banned', 'no-restricted-imports', 'no-restricted-syntax', 'no-restricted-properties');\"},{\"line_number\":58,\"content\":\" * `no-restricted-imports`' `importNames`: those refuse every namespace import of `source` (`import * as TSL from\"},{\"line_number\":97,\"content\":\"/** `banned/no-restricted-imports`: the bare entry and the WebGL-only paths (banned names are `NAMES`). */\"},{\"line_number\":273,\"content\":\"      rules: { 'banned/no-restricted-imports': ['error', IMPORTS] },\"}]}]}