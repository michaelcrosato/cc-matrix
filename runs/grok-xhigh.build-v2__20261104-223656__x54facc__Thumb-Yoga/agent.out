aken: 0, follow: 0 } });\"},{\"line_number\":268,\"content\":\"/** Sea bob, plaque creep, pebble pickup, and the pose scrub. Runs after the clips have stepped. */\"},{\"line_number\":271,\"content\":\"  const q = seaTurn(lean?.tiltX ?? 0, lean?.tiltZ ?? 0);\"},{\"line_number\":280,\"content\":\"    if (spot.mark.kind !== 'plaque') continue;\"},{\"line_number\":281,\"content\":\"    const home = PLAQUES.find((plaque) => plaque.text === spot.mark.text);\"},{\"line_number\":344,\"content\":\"    const tiltX = leanOf(w)?.tiltX ?? 0;\"},{\"line_number\":345,\"content\":\"    mx -= Math.sin((tiltX * Math.PI) / 180);\"},{\"line_number\":369,\"content\":\"  description: 'Little Fulcrum. Walk the lawn. Begin the day from a mat, a plaque, or the programme.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"matches\":[{\"line_number\":70,\"content\":\"  island.tiltX = base;\"},{\"line_number\":71,\"content\":\"  island.tiltZ = 0;\"},{\"line_number\":222,\"content\":\"  const raw = args.finds;\"},{\"line_number\":261,\"content\":\"    island: { tiltX: 0.4, tiltZ: 0, base: 0.4 },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/score.ts\",\"matches\":[{\"line_number\":53,\"content\":\"export function ageRemark(today: number, yesterday: number): string {\"},{\"line_number\":64,\"content\":\"/** The book id for today's age beside yesterday. The page says the words. The number lives in `ageRemark`. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/state.ts\",\"matches\":[{\"line_number\":60,\"content\":\"  tiltX: number;\"},{\"line_number\":61,\"content\":\"  tiltZ: number;\"},{\"line_number\":129,\"content\":\"    tiltX: