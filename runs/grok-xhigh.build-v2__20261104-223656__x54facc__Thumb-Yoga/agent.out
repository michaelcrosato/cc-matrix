acc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/island.test.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Pose scrub, tilt, plaques and pebbles are asserted from the island step, not a stand-in.\"},{\"line_number\":90,\"content\":\"  it('scrubs the pose clip from the class the guest is actually in', () => {\"},{\"line_number\":94,\"content\":\"    const early = slotT(w, 'RETREAT/Nothing');\"},{\"line_number\":98,\"content\":\"    expect(slotT(w, 'RETREAT/Nothing')).toBeGreaterThan(early);\"},{\"line_number\":105,\"content\":\"    const held = slotT(w, 'RETREAT/Chair');\"},{\"line_number\":107,\"content\":\"    const later = slotT(w, 'RETREAT/Chair');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/sounds/songs.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file Original songs for the retreat. Tracker notation only. Nothing here is a recording.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/state.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Arrays are given fresh at spawn. Nothing here is remembered in a module variable.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/cast/clips.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file Pose strips for the retreat. Each clip stands, then arrives. The page scrubs the time.\"},{\"line_number\":53,\"content\":\"    Nothing: strip({\"},{\"line_number\":62,\"content\":\"    Chair: strip({\"},{\"line_number\":69,\"content\":\"    Heron: strip({\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/events/group.ts\",\"matches\":[{\"line_number\":2,\"content\":\" * @file Group Class. Three short classes on the mats: a still ring, the Heron, then the pond.\"},{\"line_number\":17,\"content\":\"/** Deals the middle class, then starts the still ring. The middle is the Heron. */\"},{\"line_number\":172,\"content\":\"/** Holds the centre, the Heron, or the breath, depending on the class. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/island.ts\",\"matches\":[{\"line_number\":15,\"content\":\"  playClip,\"},{\"line_number\":256,\"content\":\"      play: { clip: 'RETREAT/Nothing', speed: 0, hold: true, walk: true, loop: false },\"},{\"line_number\":268,\"content\":\"/** Sea bob, plaque creep, pebble pickup, and the pose scrub. Runs after the clips have stepped. */\"},{\"line_number\":297,\"content\":\"  scrub(w, who);\"},{\"line_number\":301,\"content\":\"function scrub(w: World, who: Body): void {\"},{\"line_number\":303,\"content\":\"    playClip(w, who.id, 'RETREAT/LeanR', { speed: 0, hold: true, walk: true, additive: true, loop: false });\"},{\"line_number\":304,\"content\":\"    playClip(w, who.id, 'RETREAT/LeanL', { speed: 0, hold: true, walk: true, additive: true, loop: false });\"},{\"line_number\":305,\"content\":\"    playClip(w, who.id, 'RETREAT/LeanF', { speed: 0, hold: true, walk: true, additive: true, loop: false });\"},{\"line_number\":306,\"content\":\"    playClip(w, who.id, 'RETREAT/LeanB', { speed: 0, hold: true, walk: true, additive: true, loop: false });\"},{\"line_number\":312,\"content\":\"    playClip(w, who.id, pose.clip, { speed: 0, hold: true, walk: true, loop: false });\"},{\"line_number\":321,\"content\":\"    if (slot.clip === 'RETREAT/LeanR') slot.t = Math.max(0, x);\"},{\"line_number\":322,\"content\":\"    if (slot.clip === 'RETREAT/LeanL') slot.t = Math.max(0, -x);\"},{\"line_number\":323,\"content\":\"    if (slot.clip === 'RETREAT/LeanF') slot.t = Math.max(0, y);\"},{\"line_number\":324,\"content\":\"    if (slot.clip === 'RETREAT/LeanB') slot.t = Math.max(0, -y);\"},{\"line_number\":325,\"content\":\"    if (pose && slot.clip === pose.clip) slot.t = pose.t;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/about-data.ts\",\"matches\":[{\"line_number\":13,\"content\":\"  animation: 'The engine clip layer. Original poses are scrubbed from the balance step. The rest pose is Mesh2Motion.',\"},{\"line_number\":34,\"content\":\"  'I got stuck on playClip during setup, props that need a yaw, a frozen recorded world, and hub query keys read as settings.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/ui/lines/book.ts\",\"matches\":[{\"line_number\":61,\"content\":\"  'pose.nothing': 'Seated Nothing. Sit as if the chair forgot its job.',\"},{\"line_number\":62,\"content\":\"  'pose.chair': 'The Patient Chair. Both feet stay, which is the hard part.',\"},{\"line_number\":63,\"content\":\"  'pose.heron': 'The Heron asks for one foot. The other foot is a rumour.',\"},{\"line_number\":64,\"content\":\"  'pose.archer': 'The Archer aims at nothing. Nothing is the target.',\"},{\"line_number\":79,\"content\":\"  'group.heron': 'The middle class is the Heron. We all pretend this was a surprise.',\"},{\"line_number\":122,\"content\":\"  'lure.disconnect': 'Nothing disconnected. Your hands are still yours.',\"},{\"line_number\":137,\"content\":\"  'hub.more': 'Three classes. A still ring, the Heron, then the pond.',\"},{\"line_number\":238,\"content\":\"  'world.no': 'Nothing here is about a body. The wobble is the whole subject.',\"},{\"line_number\":244,\"content\":\"  'no.keep': 'No. Nothing was erased.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/