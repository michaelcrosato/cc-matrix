tent\":\"  /** The root element (`.ui-overlay`), over the canvas. */\"},{\"line_number\":115,\"content\":\"const STYLE_ID = 'ui-overlay-style';\"},{\"line_number\":126,\"content\":\".ui-overlay { position: fixed; left: 0; top: 0; width: 0; height: 0; overflow: hidden; contain: strict;\"},{\"line_number\":130,\"content\":\".touch .ui-overlay { font-size: calc(var(--touch-k, 1) * 16px); }\"},{\"line_number\":131,\"content\":\".ui-overlay [hidden] { display: none !important; }\"},{\"line_number\":132,\"content\":\".touch .ui-overlay [data-keyboard] { display: none !important; }\"},{\"line_number\":205,\"content\":\"  const root = div(doc, 'ui-overlay');\"},{\"line_number\":306,\"content\":\"      if (!doc.querySelector('.ui-overlay')) doc.getElementById(STYLE_ID)?.remove();\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa35-d4ff-74f0-9f18-3308a1dd51dc","uuid":"575023c8-afd7-4150-8e37-9dfa8fee77e7"}
