nt: 'morning', age: 82, prior: 0, rank: 'Present', result: 0 },\"},{\"line_number\":248,\"content\":\"      prior: 82,\"},{\"line_number\":249,\"content\":\"      finds: ['pebble:1'],\"},{\"line_number\":251,\"content\":\"    expect(next.prior).toBe(82);\"},{\"line_number\":253,\"content\":\"    expect(next.finds).toEqual(['pebble:1']);\"},{\"line_number\":261,\"content\":\"      prior: 40,\"},{\"line_number\":262,\"content\":\"      finds: ['pebble:1', 'pebble:2'],\"},{\"line_number\":265,\"content\":\"    expect(kept.finds).toEqual(['pebble:1', 'pebble:2']);\"},{\"line_number\":266,\"content\":\"    expect(kept.prior).toBe(40);\"},{\"line_number\":271,\"content\":\"    expect(flowOf(w).prior).toBe(0);\"},{\"line_number\":276,\"content\":\"    expect(noteProgress(freshSave(), snap).prior).toBe(0);\"},{\"line_number\":279,\"content\":\"    expect(flowOf(w).prior).toBe(82);\"},{\"line_number\":286,\"content\":\"    expect(noteProgress(freshSave(), again).prior).toBe(82);\"},{\"line_number\":287,\"content\":\"    menu('game.begin', { day: 1, cursor: 0, age: 40, prior: 82 });\"},{\"line_number\":289,\"content\":\"    expect(flowOf(w).prior).toBe(82);\"},{\"line_number\":311,\"content\":\"      expect(flow.pebbles).toBeGreaterThan(0);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/settings.ts\",\"matches\":[{\"line_number\":35,\"content\":\"  { path: 'game.tilt.rate', min: 0, max: 2, step: 0.01 },\"},{\"line_number\":36,\"content\":\"  { path: 'game.pebbles.mult', min: 0.2, max: 3, step: 0.1 },\"},{\"line_number\":70,\"content\":\"  'game.tilt.rate': num(0.15, 0, 2, 'deg/s', 'How fast the storm leans the island before a deed takes some off.'),\"},{\"line_number\":71,\"content\":\"  'game.pebbles.mult': num(1, 0.2, 3, '1', 'Scales pebbles earned from a rank.'),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/island.ts\",\"matches\":[{\"line_number\":4,\"content\":\" * plaques creep west, and the guest walks downhill.\"},{\"line_number\":122,\"content\":\"/** Hidden pebbles. They join the cairn. They are not a shop. */\"},{\"line_number\":157,\"content\":\"  island: { tiltX: number; tiltZ: number; base: number };\"},{\"line_number\":174,\"content\":\" * Sea quaternion for a lean in degrees. tiltX rotates about Z (west), tiltZ about X.\"},{\"line_number\":175,\"content\":\" * q = qz * qx. tiltX > 0 and tiltZ = 0 leaves q[2] negative.\"},{\"line_number\":177,\"content\":\"function seaTurn(tiltX: number, tiltZ: number): [number, number, number, number] {\"},{\"line_number\":179,\"content\":\"  const az = (-tiltX * Math.PI) / 180;\"},{\"line_number\":220,\"content\":\"/** Puts the island, the sea, the cast and the hidden pebbles into the world. */\"},{\"line_number\":244,\"content\":\"    const pebble = PEBBLES[i];\"},{\"line_number\":245,\"content\":\"    if (!pebble) continue;\"},{\"line_number\":246,\"content\":\"    w.spawn({ mark: { x: pebble.x, y: 0.3, z: pebble.z, kind: 'pebble', text: `pebble:${i}`, taken: 0, follow: 0 } });\"},{\"line_number\":268,\"content\":\"/** Sea bob, plaque creep, pebble pickup, and the pose scrub. Runs after the clips have stepped. */\"},{\"line_number\":271,\"content\":\"  const q = seaTurn(lean?.tiltX ?? 0, lean?.tiltZ ?? 0);\"},{\"line_number\":289,\"content\":\"      if (spot.mark.kind !== 'pebble' || spot.mark.taken) continue;\"},{\"line_number\":292,\"content\":\"        flow.pebbles += 1;\"},{\"line_number\":293,\"content\":\"        flow.line = 'find.pebble';\"},{\"line_number\":344,\"content\":\"    const tiltX = leanOf(w)?.tiltX ?? 0;\"},{\"line_number\":345,\"content\":\"    mx -= Math.sin((tiltX * Math.PI) / 180);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/scenes/driver.ts\",\"matches\":[{\"line_number\":10,\"content\":\"import { ageLine, clampScore, pebblesOf, rankOf, wobbleAge } from './score';\"},{\"line_number\":70,\"content\":\"  island.tiltX = base;\"},{\"line_number\":91,\"content\":\"/** Scores the activity that just ended, then results, the next demo slice, or nothing for attract pebbles. */\"},{\"line_number\":102,\"content\":\"  if (auto !== 'attract') flow.pebbles += pebblesOf(flow.rank, Number(w.settings.get('game.pebbles.mult')));\"},{\"line_number\":104,\"content\":\"    flow.prior = flow.age;\"},{\"line_number\":106,\"content\":\"    flow.line = ageLine(flow.age, flow.prior);\"},{\"line_number\":220,\"content\":\"/** Marks pebbles the save already found. The count is restored separately, so this does not add any. */\"},{\"line_number\":222,\"content\":\"  const raw = args.finds;\"},{\"line_number\":227,\"content\":\"    if (row.mark.kind === 'pebble' && found.has(row.mark.text)) row.mark.taken = 1;\"},{\"line_number\":236,\"content\":\"  const pebbles = numArg(args, 'pebbles');\"},{\"line_number\":238,\"content\":\"  const prior = numArg(args, 'prior');\"},{\"line_number\":245,\"content\":\"  if (pebbles !== undefined) flow.pebbles = pebbles;\"},{\"line_number\":247,\"content\":\"  if (prior !== undefined) flow.prior = prior;\"},{\"line_number\":261,\"content\":\"    island: { tiltX: 0.4, tiltZ: 0, base: 0.4 },\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223656__x54facc/work/Thumb Yoga-Wii Fit-grok-4.7-xhigh-20261104-223656/labs/game/island.test.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * Pose scrub, tilt, plaques and pebbles are asserted from the island step, not a stand-in.\"},{\"line_number\":45,\"content\":\"function tiltX(w: World): number {\"},{\"line_number\":46,\"content\":\"  const rows = w.query('island') as unknown as { island: { tiltX: number } }[];\"},{\"line_number\":47,\"content\":\"  return rows[0]?.island.tiltX ?? 0;\"},{\"line_number\":122,\"content\":\"      leanGap = Math.max(leanGap, Math.abs(tiltX(pushed.w) - tiltX(still.w)));\"},{\"line_number\":129,\"content\":\"    const { run, w, menu } = boot(1, { 'game.tilt.rate': 1 });\"},{\"line_number\":132,\"content\":\"    const fast = tiltX(w);\"},{\"line_number\":137,\"content\":\"    const calm = boot(1, { 'game.tilt.rate': 0 });\"},{\"line_number\":140,\"content\":\"    expect(tiltX(calm.w)).toBeCloseTo(0.4, 2);\"},{\"line_number\":146,\"content\":\"    const before = tiltX(east.w);\"},{\"line_number\":157,\"content\":\"    expect(tiltX(east.w)).toBeCloseTo(before - 0.5, 3);\"},{\"line_number\":160,\"content\":\"    expect(tiltX(east.w)).toBeCloseTo(before - 0.5, 3);\"},{\"line_number\":177,\"content\":\"  it('keeps a found pebble taken when the save comes back', () => {\"},{\"line_number\":181,\"content\":\"    const first = spot(w, 'pebble', 'pebble:0');\"},{\"line_number\":187,\"content\":\"    expect(flowOf(w).pebbles).toBe(1);\"},{\"line_number\":188,\"content\":\"    expect(flowOf(w).line).toBe('find.pebble');\"},{\"line_number\":190,\"content\":\"    expect(snap.finds).toContain('pebble:0');\"},{\"line_number\":191,\"content\":\"    expect(noteProgress(freshSave(), snap).finds).toEqual(['pebble:0']);\"},{\"line_number\":193,\"content\":\"    menu('game.begin', { day: 1, cursor: 0, pebbles: 1, finds: ['pebble:0'] });\"},{\"line_number\":195,\"content\":\"    expect(flowOf(w).pebbles).toBe(1);\"},{\"line_number\":201,\"content\":\"    expect(flowOf(w).pebbles).toBe(1);\"},{\"line_number\":202,\"content\":\"    const second = spot(w, 'pebble', 'pebble:1');\"},{\"line_number\":207,\"content\":\"    expect(flowOf(w).pebbles).toBe(2);\"},{\"line_number\":215,\"content\":\"    const flatIsland = flat.w.query('island') as unknown as { island: { tiltX: number } }[];\"},{\"line_number\":216,\"content\":\"    const tippedIsland = tipped.w.query('island') as unknown as { island: { tiltX: number } }[];\"},{\"line_number\":220,\"content\":\"    