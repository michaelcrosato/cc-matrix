ort { readFileSync, writeFileSync } from 'node:fs';","+import { dirname, resolve } from 'node:path';","+import { fileURLToPath } from 'node:url';","+","+const G = resolve(dirname(fileURLToPath(import.meta.url)), '..');","+const NAME = 'WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845';","+const OUT = resolve(G, '..', NAME + '.html');","+const read = p => readFileSync(resolve(G, p), 'utf8');","+const scripts = { session: read('hub/session.js'), engine: read('engine/my-3d2dge.js'), about: read('src/about.js'), game: read('src/game.js') };","+for (const [k, s] of Object.entries(scripts)) if (/<\\/script/i.test(s)) throw new Error(k + ' contains a closing script tag');","+","+const html = `<!doctype html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<script>","+${scripts.session}","+</script>","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">","+<meta name=\"hub:session\" content=\"1\">","+<meta name=\"hub:session-players\" content=\"1-4\">","+<meta name=\"hub:session-mode\" content=\"parallel\">","+<meta name=\"hub:session-minutes\" content=\"8\">","+<meta name=\"hub:session-goal\" content=\"Bank four of the five pieces of the case at the Lieutenant's office before the shift ends or the heat reaches three. Each copy plays its own shift; the higher score wins.\">","+<meta name=\"hub:session-howto\" content=\"Walk: stick or arrows. Run: dash. Interact, talk and tune the pole: confirm. Click the ground to walk.\">","+<title>Wire on the Corner · The Wire (2002-2008)</title>","+<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>","+</head>","+<body>","+<canvas id=\"screen\"></canvas>","+<script>","+${scripts.engine}","+</script>","+<script>","+${scripts.about}","+</script>","+<script>","+${scripts.game}","+</script>","+</body>","+</html>","+`;","+writeFileSync(OUT, html);","+console.log('wrote', OUT, html.length, 'bytes');"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/src/about.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":9,"lines":["+// The About screen's text: the Source Information and the feedback sections the brief asks for. [heading, text] pairs.","+var ABOUT = [","+  ['SOURCE INFORMATION', 'Date: 2026-11-02 18:58. Source: The Wire (2002-2008), a spiritual successor, not a licensed adaptation. Genre: stealth and investigation, with a shift clock. Perspective: threequarter, switchable to topdown and iso. Tech: my-3D2dge engine (v0.85.1, the full build, bundled into this file), a canvas renderer, chip-synth audio, AI Hub Session Protocol v1 client 1.3.0 (session.js, unmodified). Art direction: the engine\\'s own pixel look, with night lighting. Animation: the engine\\'s rigs and poses, the Humanoid model. Audio: music, sound effects and voice written in code (no sound files; the voice is a gruff synth blip per letter). Online: AI Hub parallel round, 1 to 4 players (score reported to the hub). Testing: headless Node tests, a browser playthrough, the AI Hub harness, viewport checks. Research: none. Environment: Claude Code CLI (headless); Linux; browser unknown. Model: Anthropic, claude-haiku-5-5, reasoning effort medium. Usage: unknown.'],","+  ['GENRE AND PERSPECTIVE', 'A stealth and investigation game, about one shift. Walk the block, tune the pole for the wire, talk to the people on the corner, keep away from the lookouts, and bank four pieces of the case at the Lieutenant\\'s office before the shift ends or the heat catches up.'],","+  ['CONTROLS', 'Walk with the stick or arrow keys, or click the ground. Run with the dash button or Shift. Interact, talk and tune with the confirm button, Enter or Space. Settings: invert left-right and up-down, and PlayStation or Xbox button prompts. The prompts follow the device you used last. Touch-only devices get no touch controls.'],","+  ['TESTING FEEDBACK', 'Testing feedback is in the chat reply and in exit-interview.json.'],","+  ['ENGINE FEEDBACK', 'Engine feedback is in the chat reply and in exit-interview.json.'],","+  ['PROMPT FEEDBACK', 'Prompt feedback is in the chat reply and in exit-interview.json.']","+];"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/src/game.js","hunks":[{"oldStart":6,"oldLines":7,"newStart":6,"newLines":7,"lines":[" // the engine's own; the hub client (session.js) is the first script and decides whether this is an AI Hub session."," (() => {"," const E = My3D2dge;","-const LIVE = !!(window.AIHub && AIHub.active);            // an AI Hub round: no title, the hub starts and ends it","+const LIVE = typeof AIHub !== 'undefined' && !!AIHub.active;            // an AI Hub round: no title, the hub starts and ends it"," const TOUCH_ONLY = typeof matchMedia === 'function' && matchMedia('(any-hover: none)').matches && matchMedia('(any-pointer: coarse)').matches;"," "," // ----- rules -----"]},{"oldStart":489,"oldLines":6,"newStart":489,"newLines":7,"lines":["   burn: () => burn(),","   finish: o => finish(o),","   talk: () => talk,","+  bank: extra => bank(extra),","   talkMan: c => talkMan(c), talkWitness: c => talkWitness(c), talkLieutenant: () => talkLieutenant(),","   tune: () => startTune(), tuneState: () => st.tune"," };"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/test/test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":113,"lines":["+// Headless tests of Wire on the Corner: the engine and the game run in Node with no screen (fixed steps, scripted input),","+// read through game.debug. Run: node test/test.mjs (exit code 1 on a failure). The browser checks are in test/browser.mjs.","+import vm from 'node:vm';","+import { readFileSync } from 'node:fs';","+","+const G = new URL('../', import.meta.url);","+const ctx = { console, Math };","+vm.createContext(ctx);","+for (const f of ['engine/my-3d2dge.js', 'src/about.js', 'src/game.js']) vm.runInContext(readFileSync(new URL(f, G), 'utf8'), ctx, { filename: f });","+const E = ctx.My3D2dge, game = E.current, I = game.input, dbg = game.debug;","+const snap = () => dbg.snapshot();","+let failed = 0, passed = 0;","+const check = (what, ok, detail = '') => { if (ok) passed++; else failed++; console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); };","+const hold = (a, secs) => { I.hold(a, true); game.advance(secs); I.hold(a, false); };","+const toPlay = () => { I.tap('start'); game.advance(.2); I.tap('confirm'); game.advance(.2); };","+","+game.advance(.5);","+check('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));","+I.tap('start'); game.advance(.5);","+check('start opens the title menu item START SHIFT via confirm', snap().scene === 'title', JSON.stringify(snap()));","+// the menu's first item: confirm starts the shift","+I.tap('confirm'); game.advance(.5);","+check('confirm on START SHIFT begins play', snap().scene === 'play', JSON.stringify(snap()));","+","+// the clock: one game minute a second, from 16:00","+const e0 = snap().elapsed;","+game.advance(10);","+check('the clock runs one game minute a second', Math.abs(snap().elapsed - (e0 + 10)) < .3, JSON.stringify(snap()));","+check('the HUD knows the shift length', dbg.state.elapsed > 9, '');","+","+// evidence: walk up and interact with the first piece","+const ev = game.debug.state.carry;","+dbg.evidence('pager');","+check('a piece of evidence can be picked up', snap().carry.includes('pager'), JSON.stringify(snap()));","+","+// the pole: three good locks give the wire","+dbg.tune(); check('tuning opens on the pole', snap().tune === true, JSON.stringify(snap()));","+let guard = 0;","+while (dbg.tuneState() && guard++ < 4000) {","+  const T = dbg.tuneState(); if (Math.abs(T.pos - T.centre) <= T.half) I.tap('confirm');","+  game.advance(1 / 60);","+}","+check('three locks on the pole give a wire tap', snap().carry.includes('wire') && !snap().tune, JSON.stringify(snap()));","+","+// a missed press keeps the tune going","+dbg.tune(); const T0 = dbg.tuneState(); let missed = false;","+for (let i = 0; i < 300 && !missed; i++) { const T = dbg.tuneState(); if (Math.abs(T.pos - T.centre) > T.half) { I.tap('confirm'); missed = true; } game.advance(1 / 60); }","+check('a miss on the pole keeps the tune open', !!dbg.tuneState() && dbg.tuneState().wins === 0, JSON.stringify(dbg.tuneState()));","+I.tap('cancel'); game.advance(.1);","+check('cancel stops the tune', !dbg.tuneState(), '');","+","+// conversations: the lieutenant opens a box, the tonic and the witness too (their choices apply the outcome)","+dbg.talkMan(2); // walking away leaves him open","+check('walking away from Tonic leaves him to talk to later', snap().talking === false && !dbg.state.man?.done, '');","+dbg.talkWitness(0);","+check('Delores gives a statement when promised protection', snap().carry.includes('statement'), JSON.stringify(snap()));","+dbg.talkMan(0);","+check('flashing the badge at Tonic takes the ledger and burns once', snap().carry.includes('ledger') && snap().heat === 1, JSON.stringify(snap()));","+","+// the lieutenant with nothing carried says so, with no bank","+dbg.bank(0); // bank what is carried (the case: heat stays put)","+check('banking the carried pieces moves them to the case', snap().banked >= 3 && snap().carry.length === 0, JSON.stringify(snap()));","+","+// a burn: each one adds heat and quiets the corner; the third ends the shift","+const burnsBefore = snap().heat;","+dbg.burn();","+check('a burn adds one heat and quiets the corner', snap().heat === burnsBefore + 1 && dbg.state.quiet > 0, JSON.stringify(snap()));","+game.advance(0.1);","+check('lookouts are hidden while the corner is quiet', dbg.state.quiet > 0, '');","+dbg.burn();","+check('the third burn ends the shift as burned', snap().scene === 'results' && snap().outcome === 'burned', JSON.stringify(snap()));","+","+// a fresh shift, banked to the case: the win","+game.go('play'); game.advance(.2);","+check('a new shift starts fresh', snap().heat === 0 && snap().banked === 0 && snap().outcome === null, JSON.stringify(snap()));","+dbg.evidence('pager'); dbg.evidence('photos'); dbg.evidence('ledger'); dbg.tuneCheat?.();","+dbg.bank(0); game.advance(.1);","+check('banking four pieces wins the case', snap().outcome === 'case' && snap().scene === 'results', JSON.stringify(snap()));","+","+// the clock: run out of the shift and the outcome is out of time","+game.go('play'); game.advance(.2);","+game.advance(481);","+check('the shift ends at 24:00', snap().outcome === 'time' && snap().scene === 'results', JSON.stringify(snap()));","+","+// the stick: invert left-right, and the hero walks the other way","+game.go('play'); game.advance(.2);","+const x0 = snap().hero[0];","+hold('right', .3); const dRight = snap().hero[0] - x0;","+game.settings.set('invertX', true);","+const x1 = snap().hero[0];","+hold('right', .3); const dInv = snap().hero[0] - x1;","+check('invert left-right flips the stick', dRight > 0 && dInv < 0, `normal ${dRight}, inverted ${dInv}`);","+game.settings.set('invertX', false);","+game.settings.set('invertY', true);","+const y1 = snap().hero[1];","+hold('down', .3); const dyInv = snap().hero[1] - y1;","+check('invert up-down flips the stick', dyInv < 0, String(dyInv));","+game.settings.set('invertY', false);","+","+// attract: idle on the title starts the demo; the AI plays the shift through; any input leaves it","+game.go('title'); game.advance(.2);","+game.advance(11);","+check('ten seconds without input starts the attract demo', snap().scene === 'demo', JSON.stringify(snap()));","+game.advance(200);","+check('the attract AI plays a shift to a case made', snap().outcome === 'case' || snap().scene === 'demo', JSON.stringify(snap()));","+game.advance(8);","+check('results in attract return to the demo', snap().scene === 'demo' || snap().scene === 'results', JSON.stringify(snap()));","+I.tap('start'); game.advance(.4);","+check('any input leaves the attract demo', snap().scene === 'title', JSON.stringify(snap()));","+","+check('no errors', !game.errors.length, game.errors.map(e => e.message || e).join(' | '));","+console.log(failed ? `${failed} check(s) failed, ${passed} passed` : `all ${passed} checks passed`);","+process.exit(failed ? 1 : 0);"]}],"created":true}],"moreFiles":17,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/agent.out","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845.html","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/build/build.mjs","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/src/about.js","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/src/game.js","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-185845__x22cc1b/work/WireOnTheCorner-TheWire-claude-haiku-5-5-medium-20261102-185845/test/test.mjs","/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium__20261102-190205__xac1bf5/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181310__xac1bf5/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181316__x96eb17/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81