ck with results', snap().scene === 'results', JSON.stringify(snap()));","+check('the best shift is kept', E.store.get('rewired-shift-best', 0) >= 100);","+","+// ---- two players ----","+go('street', { mode: 'shift', seconds: 60 });","+try { game.addPlayer({ keys: 'right' }); } catch (e) {}","+adv(.5);","+check('a second player drops in as Briggs', ST.players.length === 2 && ST.players[1].id === 'BRIGGS', ST.players.length);","+if (ST.players.length === 2) { const P2 = ST.players[1], x0 = P2.mover.x; P2.input.hold('right'); adv(.5); P2.input.hold('right', false); check('player 2 moves on their own input', Math.abs(P2.mover.x - x0) > 5, P2.mover.x - x0); }","+try { for (const q of game.players.slice(1)) game.removePlayer(q); } catch (e) {}","+","+// ---- chase escape ----","+go('street', { mode: 'reup', stage: 2 }); drain();","+D.teleport(D.STREET.houseBack.x, D.STREET.houseBack.y + 10); adv(.5);","+check('chase begins', !!ST.chase);","+D.teleport(5 * T, 2 * T); adv(5); drain();","+check('too far behind: Squeak gets away', ST.chase && ST.chase.done && !ST.chase.caught, JSON.stringify(ST.chase));","+","+// ---- saves, Continue and chapter select ----","+D.seedCaseFor(3); game.saves.autosave(); go('title', {});","+check('chapter select unlocked after a tape', (E.store.get('rewired-unlocked', 1)) >= 2);","+{ const s = game.saves.latest(); check('Continue finds the autosave', !!s && s.level === 3, JSON.stringify(s && s.level)); }","+I.tap('down'); adv(.1); I.tap('confirm'); adv(1.5);","+check('Continue loads the saved tape', snap().scene === 'wire', JSON.stringify(snap()));","+go('title', {}); I.tap('down'); adv(.1); I.tap('down'); adv(.1); I.tap('confirm'); adv(.3);","+check('chapter select lists the tapes', D.TI.items && D.TI.items.some(i => i.ch === 5));","+I.tap('down'); adv(.1); I.tap('confirm'); adv(1);","+check('a chapter from the menu opens on its card', snap().scene === 'card' && snap().chapter === 2, JSON.stringify(snap()));","+","+// ---- touch-only notice fla