ending) setupInbound(M.inboundTeam, M.inboundKind);\"\nb=\"    if (M.phaseT > 1.1 && M.endAfterDead && !M.sponsorPending) { M.endAfterDead = false; quarterEnd(); }\\n    else if (M.phaseT > 1.1 && !M.sponsorPending) setupInbound(M.inboundTeam, M.inboundKind);\"\nassert a in s; s=s.replace(a,b)\na=\"    if (M.phaseT > 4.2) { ARENA.hoops[M.sponsorPending.rim].glass = true; M.sponsorPending = null; setupInbound(M.inboundTeam, M.inboundKind); }\"\nb=\"    if (M.phaseT > 4.2) { ARENA.hoops[M.sponsorPending.rim].glass = true; M.sponsorPending = null; if (M.endAfterDead) { M.endAfterDead = false; quarterEnd(); } else setupInbound(M.inboundTeam, M.inboundKind); }\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\np='src/30-ball.js'; s=open(p).read()\na=\"    if (b.y < BOARD_Y[0] - 2 || b.y > BOARD_Y[1] + 2 || b.z < BOARD_Z[0] - 3 || b.z > BOARD_Z[1] + 3 || !ARENA.hoops[i] || !ARENA.hoops[i].glass) continue;\"\nb=\"    if (ghost || b.y < BOARD_Y[0] - 2 || b.y > BOARD_Y[1] + 2 || b.z < BOARD_Z[0] - 3 || b.z > BOARD_Z[1] + 3 || !ARENA.hoops[i] || !ARENA.hoops[i].glass) continue;\"\nassert a in s; s=s.replace(a,b)\na=\"    // the net: inside the cone under the rim, it drags the ball and ripples\"\nb=\"\"\"    // a decided miss that would drop in rolls out instead (in and out)\n    if (shot && !shot.made && !shot.blocked && b.vz < 0 && b.z > RIM_Z - 1 && b.z < RIM_Z + 9 && d < RIM_R - .5 && b.state !== 'dead') { const a = d > .3 ? Math.atan2(dy, dx) : Math.atan2(b.y - shot.shooter.y, b.x - shot.shooter.x) + PI; b.vx = Math.cos(a) * 95; b.vy = Math.sin(a) * 95; b.vz = Math.max(b.vz, 30); if (b.rimT <= 0) rimContact(i, 60); }\n    // the net: inside the cone under the rim, it drags the ball and ripples\"\"\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\np='tests/core.test.mjs'; s=open(p).read()\na=\"  const fresh = (o = {}) => { quickMatch(h, Object.assign({ quarterLen: 600, powerups: false, twists: false }, o)); const M = S.match; M.phase = 'live'; M.practice = t