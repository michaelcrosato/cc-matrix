\"\nb=\"\"\"function screenFrame(r, title, prompts, o = {}) {\n  const arena = !o.noBg && !o.sky && menuBackdrop(r, o.dim);\n  r.overlay(g => {\n    if (!o.noBg && !arena) { r.sky(o.sky || ['#0a0618', '#1a0e30', '#2a1240']); }\"\"\"\nassert a in s; s=s.replace(a,b); open(p,'w').write(s)\np='src/43-tour.js'; s=open(p).read()\ns=s.replace(\"E.font.text(g, 'HOME', hx, hy + 7, '#fff', { align: 'center', font: 'tiny', outline: '#000' });\",\"E.font.text(g, 'HOME', hx, hy + 7, '#fff', { align: 'center', outline: '#000' });\")\ns=s.replace(\"if (res) E.font.text(g, res, x, y + 12, '#fff', { align: 'center', font: 'tiny', outline: '#000' }); }\",\"if (res) E.font.text(g, res, x, y + 12, '#fff', { align: 'center', outline: '#000' }); }\")\ns=s.replace(\"E.font.text(g, get('court', c).name.replace('THE ', ''), x, y - 20, next ? UIC.gold : '#e8f0ff', { align: 'center', font: 'tiny', outline: '#000' });\",\"E.font.text(g, get('court', c).name.replace('THE ', ''), x, y - 22, next ? UIC.gold : '#e8f0ff', { align: 'center', outline: '#000' });\")\n# d: the studio: monitor at the right, the camera closer\na=\"        const mx = Math.round(r.W / 2) - 60, my = 30; E.ui.box(g, mx, my, 120, 74, { bg: '#0a0a14', border: '#5a5a6a' });\"\nb=\"        const mx = r.W - 132, my = 22; E.ui.box(g, mx, my, 120, 74, { bg: '#0a0a14', border: '#5a5a6a' });\"\nassert a in s; s=s.replace(a,b)\na=\"    game.focus(CMX, CMY, 0); game.cam.offset = [0, Math.round(game.H * .05)];\"\nb=\"    game.focus(CMX, CMY, 0); game.cam.offset = [0, Math.round(game.H * (STORY.court ? .05 : .16))]; game.setZoom(STORY.court ? 1.3 : 2);\"\nassert a in s; s=s.replace(a,b)\ns=s.replace(\"  exit() { TALK.close(); musicLayer('villain', false); },\",\"  exit() { TALK.close(); musicLayer('villain', false); game.setZoom(1); },\")\nopen(p,'w').write(s)\np='src/44-camp.js'; s=open(p).read()\ns=s.replace(\"    promptLine(g, 'PAUSE: SKIP STEP / LESSON LIST', x + w / 2, r.H - 60, { align: 'center', color: UIC.dim });\",\"    if (!(A