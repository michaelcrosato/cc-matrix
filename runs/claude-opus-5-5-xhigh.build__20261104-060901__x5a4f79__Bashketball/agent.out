d') opens it from a game's own menu or title.\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\n * ============================================================================= */\nconst SAVE_FORMAT = 1;   // the record's own shape: { v, version, data, place, level, time, at }\nclass Saves {\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\n  constructor(game, o) {\n    o = o && typeof o === 'object' ? o : {};\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game's version of its data (1),\n     *  saved with each save; migrate(data, from): an older version's data brought up to this one (or null: kept as it\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\n     *  level, time, slot } */\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\n     *  refused a save (they last for the visit) */\n    this.canSave = true; this.played = 0; this.blocked = false;\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\n  }\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\n  _raw(slot) {\n    if (slot in this._mem) return this._mem[slot];\n    if (this.game.headless) return null;\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\n  }\n  _put