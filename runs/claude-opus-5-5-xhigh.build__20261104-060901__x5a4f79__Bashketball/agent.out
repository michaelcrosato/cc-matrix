t(g, A2.feature, 4 + w / 2, 63, UIC.gold, { align: 'center', outline: false }); }\"\nassert a in s; s=s.replace(a,b)\na=\"  else if (Math.floor(game.real * 2) % 2) promptLine(g, 'DEMO • PRESS ANY BUTTON', Math.round(r.W / 2), r.H - 14, { align: 'center' });\"\nb=\"  else if (Math.floor(game.real * 2) % 2) { const w = E.font.width('DEMO • PRESS ANY BUTTON') + 12; E.ui.box(g, r.W - w - 4, 44, w, 14, { bg: '#140c24', border: '#ffffff', gradient: false, alpha: .85 }); E.font.text(g, 'DEMO • PRESS ANY BUTTON', r.W - w / 2 - 4, 47, '#ffffff', { align: 'center', outline: false }); }\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs >/dev/null; echo built","description":"Move attract labels clear of the caption"}}}
