 point as it darkens\n    const W = r.bw, H = r.bh, [cx, cy] = _fadeAt(r, F), R = Math.hypot(W, H) / 2, img = g.getImageData(0, 0, W, H), src = img.data.slice(), d = img.data, tw = k * 5, fade = 1 - k * k;\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n      const dx = x - cx, dy = y - cy, l = Math.hypot(dx, dy), a = tw * Math.max(0, 1 - l / R) ** 2, c = Math.cos(a), s = Math.sin(a);\n      const sx = Math.round(cx + dx * c - dy * s), sy = Math.round(cy + dx * s + dy * c), o = (y * W + x) * 4, i = (clamp(sy, 0, H - 1) * W + clamp(sx, 0, W - 1)) * 4;\n      d[o] = src[i] * fade; d[o + 1] = src[i + 1] * fade; d[o + 2] = src[i + 2] * fade; d[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0);\n  },\n  dissolve(g, k, r) {   // pixel by pixel, in a fixed scattered order\n    const q = Math.round(k * 32), pat = r._stamp('dissolve' + q, () => { const c = mkCanvas(32, 32), cg = c.getContext('2d'); cg.fillStyle = '#000'; for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) if (hash2(x, y) < q / 32) cg.fillRect(x, y, 1, 1); return c; });\n    g.save(); g.fillStyle = g.createPattern(pat, 'repeat'); g.fillRect(0, 0, r.bw, r.bh); g.restore();\n  }\n});\n// where iris and swirl centre: go's at (a world point, or [x, y] on the screen), or the screen's centre\nconst _fadeAt = (r, F) => { const a = F.at; return Array.isArray(a) ? a : a ? r.w(a.x || 0, a.y || 0, a.z || 0) : [r.W / 2, r.H / 2]; };\n\n/* =============================================================================\n * 10g. WEATHER  game.weather = { kind: 'rain' | 'snow' | 'ash' | 'leaves' | 'sand', amount: 0..1 (.5), wind: -1..1,\n *    lightning: 0..1 } (null: clear skies). It falls through the world's height in ground views and in three layers in\n *    side and flat views, lands on the floor (particles.ground: a side view's platforms) and splashes or settles; with\n *    lightning, flashes (the player's Screen flashes) and thunder. Cosmetic: its own seeded stream (never Math.random,\n *    so replays and the game's randomness are untouched), its drops pooled, stepped on game time. It ends with the scene:\n *    set it in the scene's enter.\n * ============================================================================= */\n/** the kinds of weather: n drops at amount 1, fall speed (world units a second), colors, streak (seconds of motion a\n *  drop's line shows), sway, rest (seconds it lies where it lands), splash, wind (how hard the wind pushes it), size, big\n *  (the share a pixel bigger). Add your\n *  own: E.WEATHER.embers = { ... } */\nconst WEATHER = {\n  rain: { n: 260, fall: 300, colors: ['#9fb6dc', '#c8d8f0'], streak: .03, splash: true, wind: 1 },\n  snow: { n: 280, fall: 30, colors: ['#ffffff', '#e8f0fa'], sway: 10, rest: .6, wind: 1, big: .55 },\n  ash: { n: 200, fall: 20, colors: ['#d0c8c8', '#a09898', '#ff8a40'], sway: 6, wind: .8, big: .35 },\n  leaves: { n: 56, fall: 28, colors: ['#c8642a', '#e0a040', '#8a5a2a', '#a8b040'], sway: 24, rest: 1, size: 2, wind: 1.2 },\n  sand: { n: 220, fall: 12, colors: ['#d8b878', '#c8a060'], streak: .05, wind: 3 }\n};\nE.WEATHER = WEATHER;\nconst WX_TOP = 150, WX_LAYERS = [[.45, .6, 1], [1, 1, 1], [1.7, 1.5, 2]];   // the drops' height in ground views; side and flat views' layers: [parallax, speed, size]\nHOOKS.enter.push((g, old) => { if (old) g.weather = null; });\nHOOKS.step.push((g, dt) => {\n  const w = g.weather, S = g._wx; if (!w || !w.kind) { if (S) S.drops.length = 0; return; }\n  const K = WEATHER[w.kind]; if (!K) { warn('weather:' + w.kind, 'unknown weather \"' + w.kind + '\": ' + Object.keys(WEATHER).join(', ')); return; }\n  _wxStep(g, g._wx || (g._wx = { R: rng(0x5eed), drops: [], t: 0, bolt: 0, flick: 0, thunder: 0 }), w, K, dt);\n});\nHOOKS.draw.push((g, r, ctx) => { const w = g.weather, S = g._wx; if (w && w.kind && S && WEATHER[w.kind]) _wxDraw(g, r, ctx, S, w, WEATHER[w.kind]); });\n// the world box the screen shows: side views [x0, 0, x1, 0, z0, z1]; ground views the ground under the screen [x0, y0,\n// x1, y1]\nconst _wxBox = g => {\n  const v = g.view, c = g.cam, W = g.W, H = g.H;\n  if (v.isSide) return [(c.x - 20) / v.ax, 0, (c.x + W + 20) / v.ax, 0, (c.y + H) / v.bz, (c.y - 20) / v.bz];\n  const pts = [[0, 0], [W, 0], [0, H], [W, H]].map(([sx, sy]) => v.toGround(c.x + sx, c.y + sy) || [0, 0]);\n  return [Math.min(...pts.map(p => p[0])) - 16, Math.min(...pts.map(p => p[1])) - 16, Math.max(...pts.map(p => p[0])) + 16, Math.max(...pts.map(p => p[1])) + 16];\n};\nfunction _wxStep(g, S, w, K, dt) {\n  const R = S.R, v = g.view, mode = v.pitchDeg >= 70 ? 'flat' : v.isSide ? 'side' : 'world', n = Math.round(clamp(w.amount === undefined ? .5 : w.amount, 0, 1) * K.n), D = S.drops;\n  const box = _wxBox(g), wind = (w.wind || 0) * 60 * (K.wind || 1), ground = g.particles.ground, W = g.W, H = g.H;\n  const dcx = S.cx === undefined ? 0 : g.cam.x - S.cx; S.cx = g.cam.x; S.t += dt;\n  // a drop starting from the top, in the screen's box (or anywhere in its height: the first ones fill the sky at once)\n  const spawn = (d, any) => {\n    d.layer = mode === 'world' ? 1 : (R() * 3) | 0; d.c = K.colors[(R() * K.colors.length) | 0]; d.k = .8 + R() * .4; d.ph = R() * TAU; d.rest = 0; d.s = (K.size || 1) + (K.big && R() < K.big ? 1 : 0);\n    if (mode === 'world') { const q = v.toGround(g.cam.x + R() * W, g.cam.y + R() * H) || [0, 0]; d.x = q[0]; d.y = q[1]; }   // (it lands on a point of the screen)\n    if (mode === 'world' || (mode === 'side' && d.layer === 1)) {\n      if (mode === 'side') { d.x = lerp(box[0], box[2], R()); d.y = 0; }\n      d.fl = ground ? ground(d.x, d.y, mode === 'side' ? box[5] : WX_TOP) || 0 : 0;\n      const top = mode === 'side' ? box[5] : d.fl + WX_TOP; d.z = any ? lerp(d.fl, top, R()) : top;\n    } else { d.x = R() * W; d.y = any ? R() * H : -4; d.z = d.fl = undefined; }\n  };\n  while (D.length < n) { const d = {}; spawn(d, true); D.push(d); }\n  D.length = n;\n  for (const d of D) {\n    if (d.rest > 0) { if ((d.rest -= dt) <= 0) spawn(d, false); continue; }\n    const sway = K.sway ? Math.sin(S.t * 2 + d.ph) * K.sway : 0;\n    if (d.z !== undefined) {\n      d.x += (wind + sway) * dt; d.z -= K.fall * d.k * dt;\n      if (d.x < box[0] || d.x > box[2] || (mode === 'world' && (d.y < box[1] || d.y > box[3]))) { d.x = wrap(d.x, box[0], box[2]); if (mode === 'world') d.y = wrap(d.y, box[1], box[3]); d.fl = ground ? ground(d.x, d.y, d.z) || 0 : 0; }\n      if (mode === 'side' && d.z < box[4] - 16) spawn(d, false);   // (fell past the bottom of the screen: a pit)\n      else if (d.z <= d.fl) { d.z = d.fl; d.rest = K.splash ? .12 : K.rest || 0; if (!d.rest) spawn(d, false); }\n    } else {\n      const L = WX_LAYERS[d.layer];\n      d.x = wrap(d.x + ((wind + sway) * L[1] * dt) - dcx * L[0], -8, W + 8); d.y += K.fall * d.k * L[1] * dt;\n      if (d.y > H + 4) spawn(d, false);\n    }\n  }\n  // lightning: a flash, a second flicker, then thunder after the light\n  const L = w.lightning || 0;\n  if (L > 0) {\n    if (S.bolt <= 0) S.bolt = (3 + R() * 9) / L;\n    if ((S.bolt -= dt) <= 0) { g.flash('#e4ecff', .14, .9); S.flick = .12; S.thunder = .3 + R() * .9; S.bolt = (3 + R() * 9) / L; }\n    if (S.flick > 0 && (S.flick -= dt) <= 0) g.flash('#e4ecff', .1, .6);\n    if (S.thunder > 0 && (S.thunder -= dt) <= 0) g.audio.sfx('boom', { pitch: .45 + R() * .2, vol: .8 });\n  }\n}\nfunction _wxDraw(g, r, ctx, S, w, K) {\n  const draw = () => {\n    for (const d of S.drops) {\n      const L = WX_LAYERS[d.layer], sz = (d.s || 1) * (d.z !== undefined ? 1 : L[2]), wx = (w.wind || 0) * 60 * (K.wind || 1);\n      let x, y, x2, y2;\n      if (d.z !== undefined) { [x, y] = r.w(d.x, d.y, d.z); if (K.streak && !d.rest) [x2, y2] = r.w(d.x - wx * K.streak, d.y, d.z + K.fall * K.streak); }\n      else { x = d.x; y = d.y; if (K.streak) { x2 = x - wx * K.streak * L[1]; y2 = y - K.fall * K.streak * L[1]; } }\n      if (x < -12 || y < -40 || x > r.bw + 12 || y > r.bh + 12) continue;\n      if (d.rest > 0) { if (K.splash) { px.dot(ctx, x - 2, y - 1, d.c); px.dot(ctx, x + 2, y - 1, d.c); px.dot(ctx, x, y - 2, d.c); } else px.rect(ctx, x, y, sz, 1, d.c); continue; }\n      if (x2 !== undefined) px.line(ctx, x, y, x2, y2, d.c, sz > 1 ? 2 : 1);\n      else if (K.sway && sz > 1) { const f = Math.sin(S.t * 6 + d.ph) > 0; px.rect(ctx, x, y, f ? 2 : 1, f ? 1 : 2, d.c); }\n      else px.rect(ctx, x, y, sz, sz, d.c);\n    }\n  };\n  if (useAlpha(ctx) && K.streak) px.blend(ctx, .75, 'normal', draw); else draw();\n}\n\n/* =============================================================================\n * 10h. INPUT SEQUENCES  moves made of several inputs in a row (a fighter's special moves, a cheat code, a rhythm\n *    pattern), read from input.history: the last second of directions and presses, which an input display can draw too.\n *    Numpad notation names directions as the keys of a number pad, for a fighter facing right: 1 down-back, 2 down, 3\n *    down-forward, 4 back, 5 neutral, 6 forward, 7 up-back, 8 up, 9 up-forward; facing left mirrors them.\n * ============================================================================= */\nconst _DIRS = ['up', 'down', 'left', 'right'], _PAD = { 0: 5, 1: 8, 2: 2, 4: 4, 8: 6, 5: 7, 9: 9, 6: 1, 10: 3 };   // direction bits (up 1, down 2, left 4, right 8) -> numpad, facing right\nHOOKS.input.push(g => { for (const I of g._players || [g.input]) {   // (each player's own history: game.players)\n  const H = I._hist || (I._hist = []); let b = 0;\n  for (let i = 0; i < 4; i++) if (I.map[_DIRS[i]] && I.down(_DIRS[i])) b |= 1 << i;\n  if (b & 3) b = (b & 3) === 3 ? b & ~3 : b; if ((b & 12) === 12) b &= ~12;   // (both ways at once: neither)\n  const last = H[H.length - 1], pressed = [...I._now].filter(a => !_DIRS.includes(a));\n  if (!last || last._b !== b || pressed.length) H.push({ t: I.clock, dir: _PAD[b] || 5, pressed, _b: b });\n  while (H.length > 2 && H[1].t < I.clock - 1) H.shift();\n} });\n// one step of a sequence, 'down+right' or 'attack' or 'down+attack': the directions it holds (bits) and the buttons pressed\nconst _seqStep = s => { let b = 0, dirs = false; const btn = []; for (const p of String(s).split('+')) { const i = _DIRS.indexOf(p); if (i >= 0) { b |= 1 << i; dirs = true; } else if (p === 'neutral') dirs = true; else if (p) btn.push(p); } return { b, dirs, btn }; };\n/**\n * true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first:\n * input.sequence(['down', 'down+right', 'right', 'attack']). A step names actions joined by +: its directions are held\n * exactly as it says (up, down, left, right; 'neutral' for none) as they change to that, its buttons pressed. A cheat\n * code: input.sequence(['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'kick', 'attack'], { window: 3 })\n */\nInput.prototype.sequence = function (steps, o = {}) {\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\n  if (last.t !== now) return false;\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\n  return i < 0;\n};\n/**\n * a fighter's move in numpad notation, mirrored by facing: input.motion('236', 'attack', { facing: hero.facing, window })\n * is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); '623' a dragon punch, '41236'\n * a half circle. facing: 1 (right, the default) or -1. button: an action, 'attack+kick', or none (the motion alone)\n */\nInput.prototype.motion = function (digits, button, o = {}) {\n  const fw = (o.facing || 1) < 0 ? 'left' : 'right', bk = fw === 'left' ? 'right' : 'left';\n  const D = { 1: 'down+' + bk, 2: 'down', 3: 'down+' + fw, 4: bk, 5: 'neutral', 6: fw, 7: 'up+' + bk, 8: 'up', 9: 'up+' + fw };\n  const steps = String(digits).split('').map(c => D[c]).filter(Boolean);\n  if (button) steps.push(button);\n  return this.sequence(steps, Object.assign({ window: .45 }, o));\n};\n\n/* =============================================================================\n * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\n *    (several things kept in view): where the camera aims, from where it would aim (tx, ty: its top-left corner, in\n *    projected pixels). Game's _camStep asks it while one of them is set\n * ============================================================================= */\n// where the camera aims: framed between its targets (zooming to fit), its height held until a landing, kept still while\n// the focus stays in the window\nGame.prototype._camAim = function (tx, ty) {\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\n  if (fr) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\n    if (x1 >= x0) {\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\n      const Z = fr.zoom; if (Z) {   // out at once when they don't fit, back in once they would fit well\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n      }\n    }\n  }\n  const f = this._follow;\n  if (c.snapY) { const t = f && f.target, lim = H * .3; if (c.snap || c._ly === undefined || !t || t.onGround !== false) c._ly = ty; else c._ly = clamp(c._ly, ty - lim, ty + lim); ty = c._ly; }\n  if (c.window) { const [ww, wh] = c.window; if (c.snap || c._wx === undefined) { c._wx = tx; c._wy = ty; } c._wx = clamp(c._wx, tx - ww / 2, tx + ww / 2); c._wy = clamp(c._wy, ty - (wh || 0) / 2, ty + (wh || 0) / 2); tx = c._wx; ty = c._wy; }\n  return [tx, ty];\n};\n\n/* =============================================================================\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\n *    unchanged), each other an input of its own, with game.input's API, its device and its bindings: a gamepad each, or\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n *    right half's start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\n *    number), name ('P2') and color. A pause says who paused, a lost controller names its player, the Controls screen\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, out = {};\n  let k = 0;\n  for (const a in P) out[a] = (H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\n  _pClaim(this); return this;\n};\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\n *  left). Returns its input (null when four play already) */\nGame.prototype.addPlayer = function (o = {}) {\n  const P = this.players; if (P.length >= 4) return null;\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\n  Object.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e);