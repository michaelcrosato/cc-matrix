und it), the\")\ns=s.replace(\"      if (r >= 2 && r <= 5 && c >= 2 && c <= 45) s += String(r - 1);   // tiers 1 (back, tallest) .. 4 (front)\\n      else if (r < 2) s += ',';\\n      else s += '.';\",\"      if (r <= 2 && c >= 2 && c <= 45) s += String(r + 1);   // tiers 1 (back, tallest) .. 3 (front)\\n      else s += '.';\")\ns=s.replace(\"const types = {}; [48, 36, 24, 12].forEach(\",\"const types = {}; [30, 20, 10].forEach(\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"props:\" src/03-data-courts.js | head -2 | cut -c1-200; grep -n \"OY = \\|MAP_H\" src/00-core.js","description":"Shift arena layout to three-tier stands"}}}
