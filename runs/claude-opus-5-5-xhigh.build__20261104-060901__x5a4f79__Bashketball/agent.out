are', (tot.dunks / tot.baskets).toFixed(2), 'live s per basket', (tot.live / tot.baskets).toFixed(1), 'jumpers made/att', tot.jumpers + tot.threes + tot.layups, '/', tot.rel);\nEOF\nnode tools/build.mjs >/dev/null && node .tmp/soak2.mjs skybox 4 120","description":"Fix event id field and run a balance soak","timeout":600000}}}
