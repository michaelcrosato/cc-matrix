\nrep(`      seg(hip, knee, pc, lw); seg(knee, ank, pc, lw); seg(ank, foot, bc, lw);`,\n`      if (o.shorts) { const hm = lq(hip, knee, o.shorts.len === undefined ? .55 : o.shorts.len); seg(hip, hm, pc, lw + 1); seg(hm, knee, C.skin, lw); seg(knee, ank, C.skin, lw); }   /* BASKETBLAM: shorts in the classic style */\n      else { seg(hip, knee, pc, lw); seg(knee, ank, pc, lw); }\n      seg(ank, foot, bc, lw);`);\n// 2. hair styles: afro, flattop, mohawk (drawn after the hair cap, beside spiky)\nrep(`        px.dot(g, cap[0] - r * .35, cap[1] - r * .45, ht.hi); px.dot(g, cap[0] - r * .1, cap[1] - r * .55, ht.lt);\n      }`,\n`        if (hs === 'afro') {   /* BASKETBLAM: hair 'afro': a big shaded ball round the back and top of the head */\n          const c0 = Sp(J.head, -R * .3, 0, R * .45); px.disc(g, c0[0], c0[1], r * 1.45, ht.deep); px.disc(g, c0[0] - .7, c0[1] - .7, r * 1.32, ht.sh); px.disc(g, c0[0] - 1.2, c0[1] - 1.4, r * 1.05, ht.base);\n          for (let k = 0; k < 7; k++) { const a = k / 7 * TAU, q = [c0[0] + Math.cos(a) * r * .9, c0[1] + Math.sin(a) * r * .9]; px.dot(g, q[0], q[1], k % 2 ? ht.lt : ht.sh); }\n          const fr = Sp(J.head, R * .55, 0, R * .5); if (fr[2] > H[2]) { px.disc(g, fr[0], fr[1], r * .5, ht.sh); px.disc(g, fr[0] - .4, fr[1] - .4, Math.max(.4, r * .5 - .8), ht.base); }\n        }\n        if (hs === 'flattop') {   /* BASKETBLAM: hair 'flattop': a tall flat box on top */\n          const pts = [[-.95, -.8], [.75, -.8], [.75, .8], [-.95, .8]].map(([f, rr]) => Sp(J.head, f * R, rr * R, R * .55)), top = [[-.95, -.8], [.75, -.8], [.75, .8], [-.95, .8]].map(([f, rr]) => Sp(J.head, f * R, rr * R, R * 1.55));\n          const hull = pts.concat(top); let x0 = 1e9, x1 = -1e9; for (const q of hull) { x0 = Math.min(x0, q[0]); x1 = Math.max(x1, q[0]); }\n          const yTop = Math.min(...top.map(q => q[1])), yBot = Math.min(...pts.map(q => q[1])) + r * .4;\n          px.rect(g, x0, yTop, x1 - x0, yBot - yTop, ht.sh); px.rect(g, x0 + 1, yTop, x1 - x0 - 2, Math.max(1, (yBot - yTop) * .55), ht.base); px.rect(g, x0 + 1, yTop, x1 - x0 - 2, 1, ht.lt);\n        }\n        if (hs === 'mohawk') {   /* BASKETBLAM: hair 'mohawk': a ridge of spikes front to back */\n          for (let k = 0; k < 5; k++) { const f = .7 - k * .42, root = Sp(J.head, f * R, 0, R * .75 - Math.abs(k - 1.5) * R * .12), tip = Sp(J.head, f * R * 1.15, 0, R * 1.75 - Math.abs(k - 1.5) * R * .2);\n            px.poly(g, [[root[0] - r * .32, root[1]], [tip[0], tip[1]], [root[0] + r * .32, root[1]]], ht.sh); px.line(g, root[0], root[1], tip[0], tip[1], ht.base); }\n        }\n        px.dot(g, cap[0] - r * .35, cap[1] - r * .45, ht.hi); px.dot(g, cap[0] - r * .1, cap[1] - r * .55, ht.lt);\n      }`);\n// 3. Dialog.voice may be a function (letter, index, pageText)\nrep(`    if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);`,\n`    if (typeof this.voice === 'function') { const txt = this._page.join(' '); for (let k = prev; k < Math.floor(this.shown); k++) try { this.voice(txt[k] || ' ', k, txt); } catch (e) { this.game.fail('dialog voice', e); } }   /* BASKETBLAM: a voice function speaks each letter as it types */\n    else if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);`);\n// 4. public audio buses\nrep(`  applyVolume() { if (!this.ctx) return;`, `  /** BASKETBLAM: the effects and music buses, for sound made outside sfx() (voices, crowd) to follow the volume settings */\n  get sfxBus() { return this._sfxBus || null; }\n  get musicBus() { return this._musBus || null; }\n  applyVolume() { if (!this.ctx) return;`);\nwriteFileSync(f, s); console.log('patched', n);\nEOF\nnode .tmp/patch1.mjs engine/my-3d2dge.js && grep -n \"BASKETBLAM\" engine/my-3d2dge.js | cut -c1-120","description":"Apply engine patches for shorts, hair, voice, buses"}}}
