[[-.95, -.8], [.75, -.8], [.75, .8], [-.95, .8]].map(([f, rr]) => Sp(J.head, f * R, rr * R, R * 1.55));\",\"top = [[-.95, -.8], [.75, -.8], [.75, .8], [-.95, .8]].map(([f, rr]) => Sp(J.head, f * R, rr * R, R * 1.3));\")\nopen(p,'w').write(s)\np='src/21-court-draw.js'; s=open(p).read()\ns=s.replace(\"const nearX = bx + 12 * side, farX = bx - 12 * side, nearY = CMY + 20.8, farY = CMY - 20.8;\",\"const nearX = bx + 15 * side, farX = bx - 15 * side, nearY = CMY + 26, farY = CMY - 26, GZ0 = 69, GZ1 = 104;\")\ns=s.replace(\"const P = [[farX, farY, 72], [farX, farY, 100], [nearX, nearY, 100], [nearX, nearY, 72]].map(p => ppt(r, ...p));\",\"const P = [[farX, farY, GZ0], [farX, farY, GZ1], [nearX, nearY, GZ1], [nearX, nearY, GZ0]].map(p => ppt(r, ...p));\")\ns=s.replace(\"const a = ppt(r, farX + (nearX - farX) * .2, farY + (nearY - farY) * .2, 99), b = ppt(r, farX + (nearX - farX) * .45, farY + (nearY - farY) * .45, 73);\",\"const a = ppt(r, farX + (nearX - farX) * .2, farY + (nearY - farY) * .2, GZ1 - 1), b = ppt(r, farX + (nearX - farX) * .45, farY + (nearY - farY) * .45, GZ0 + 1);\")\ns=s.replace(\"r.queue(bx, CMY - 9, 72, g => {   // the glass\",\"r.queue(bx, CMY - 9, GZ0, g => {   // the glass\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"GZ0\" src/21-court-draw.js | head -3 | cut -c1-80","description":"Tweak hair sizes and enlarge drawn backboard"}}}
