'audio signal: car engine (music muted)', lv.engine > .005, JSON.stringify(lv)); check('audio signal: gibberish voice', lv.voice > .005, JSON.stringify(lv)); console.log('AUDIOLEVELS ' + JSON.stringify(lv));\n    const bab = await p.evaluate(\"\"\")\nopen(p,'w').write(s)\nEOF\nnode tools/browser.mjs 2>&1 | grep -v \"^D1AUTHOR\" | tail -4","description":"Measure real audio output levels in the browser","timeout":600000}}}
