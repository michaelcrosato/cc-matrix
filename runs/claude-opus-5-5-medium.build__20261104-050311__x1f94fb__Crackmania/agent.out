d headphones that lag (settings.audioOffset)\n- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\n- `game.audio.song = null`: the music playing (null for none)\n- `game.audio.volume = .7`: master volume 0..1\n\n## 21b. Backdrops\n\n7562:      this._master = c.createGain(); this._master.connect(c.destination);\n7563:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7564:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7596:    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n7611:      if (p.vib) { const lfo = c.createOscillator(), lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); lfo.stop(end + .05); }\n7746:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n7748:    for (const t of C.tracks) { t.gain = c.createGain(); t.gain.gain.value = C.vols[t.i]; t.gain.connect(bus); }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WGjtjWqwLRa9T3ciztXRVF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
