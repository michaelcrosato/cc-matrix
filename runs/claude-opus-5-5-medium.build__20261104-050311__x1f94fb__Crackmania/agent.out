{"type":"system","subtype":"init","cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-050311__x1f94fb/work","session_id":"71d84256-7fc9-49b2-a3c8-c6f9b5cc892b","tools":["Task","Bash","CronCreate","CronDelete","CronList","DesignSync","Edit","EnterWorktree","ExitWorktree","ListAgents","LSP","Monitor","NotebookEdit","PushNotification","Read","RemoteTrigger","ReportFindings","ScheduleWakeup","SendMessage","SendToProject","SendToProjectContext","Skill","TaskStop","ToolSearch","WebFetch","WebSearch","Workflow","Write"],"mcp_servers":[],"model":"claude-opus-5-5","permissionMode":"bypassPermissions","slash_commands":["deep-research","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","send-to-project","claude-api","workflow-authoring","run","run-skill-generator","plugin-authoring","advisor","agents","auto-mode-setup","autocompact","clear","color","compact","config","output-style","context","effort","fast","focus","heapdump","init","mcp","import","model","__remote-workflow","workflow-launch-exec","reload-plugins","reload-skills","rename","ultrareview","security-review","usage-credits","extra-usage","usage","insights","recap","skill-doctor","goal","design-consent","design-revoke","list-agents","team-onboarding","anthropic-skills:artifact-emulator"],"terminal_slash_commands":["doctor","send-to-project","color","focus","reload-plugins"],"apiKeySource":"none","claude_code_version":"2.1.317","output_style":"default","agents":["claude","Explore","general-purpose","Plan","statusline-setup"],"skills":["deep-research","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","send-to-project","claude-api","workflow-authoring","run","run-skill-generator","plugin-authoring","anthropic-skills:artifact-emulator"],"plugins":[{"name":"pyright-lsp","path":"/home/micha/.clau