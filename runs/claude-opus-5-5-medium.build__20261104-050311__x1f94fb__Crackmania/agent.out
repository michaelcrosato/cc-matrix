nge(cur, 1);\n    if (I.pressed('confirm')) {\n      if (cur === 'done') return leave();\n      if (cur === 'pattern' && !P().hasPattern(p.pattern)) { if (P().buyPattern(p.pattern, 100)) { game.audio.sfx('coin'); game.note(PATTERNS[p.pattern] + ' BOUGHT', 1.5); } else { game.audio.sfx('ui_err'); game.note('NOT ENOUGH COPPERS', 1.5); } }\n      else change(cur, 1);\n    }\n    if (I.pressed('alt')) S.lights = !S.lights;\n    if (I.pressed('cancel')) leave();\n    if (world) { const r = 70; world.camera.set('fixed'); world.camera.fixed = { x: 7 * 16 + Math.cos(S.ang * .3) * r, y: 4.5 * 16 + 30 + Math.sin(S.ang * .3) * 20, z: 34, yaw: Math.atan2(4.5 * 16 - (4.5 * 16 + 30 + Math.sin(S.ang * .3) * 20), 7 * 16 - (7 * 16 + Math.cos(S.ang * .3) * r)), pitch: -.28, fov: 50 }; world.step(dt); }\n  }\n  function leave() {\n    // a locked pattern isn't kept\n    const p = paint(); if (!P().hasPattern(p.pattern)) p.pattern = 0; if (!carOpen(S.car)) S.car = 'coyote';\n    P().save(); app.modes.toMenu('main');\n  }\n  function row(g, it, f) {\n    const p = paint(), id = it.id;\n    panel(g, it.x, it.y, it.w + 140, it.h, { accent: f ? '#ffffff' : '#3a4a7a', bg: f ? ['#34447a', '#1c2648'] : ['#1c2440', '#121830'] });\n    E.font.text(g, it.label, it.x + 6, it.y + 7, f ? '#ffffff' : COL.dim, { outline: '#10101a' });\n    const vx = it.x + 130;\n    if (id === 'car') E.font.text(g, '< ' + CARS[S.car].name + (carOpen(S.car) ? '' : ' (LOCKED)') + ' >', vx, it.y + 7, carOpen(S.car) ? '#ffd23a' : '#8a8aa0', { outline: '#10101a' });\n    else if (['body', 'accent', 'pcol', 'helmet', 'rims'].includes(id)) { px.rect(g, vx, it.y + 4, 40, 13, '#10101a'); px.rect(g, vx + 1, it.y + 5, 38, 11, p[id]); E.font.text(g, '< >', vx + 46, it.y + 7, '#ffffff', { outline: '#10101a' }); }\n    else if (id === 'pattern') { const own = P().hasPattern(p.pattern); E.font.text(g, '< ' + PATTERNS[p.pattern] + ' >', vx, it.y + 7, own ? '#ffffff' : '#ffb060', { outline: '#10101a' }); if (!own) { lockIcon(g, vx + 112, it.y + 3); } }\n    else if (id === 'number') E.font.text(g, '< ' + String(p.number).padStart(2, '0') + ' >', vx, it.y + 7, '#ffffff', { outline: '#10101a' });\n  }\n  function draw(r) {\n    if (world) {\n      const p = carOpen(S.car) ? paint() : Object.assign({}, paint(), { body: '#202024', accent: '#202024', pcol: '#202024', number: null });\n      const a = S.ang, f = [Math.cos(a), Math.sin(a), 0], rr = [-Math.sin(a), Math.cos(a), 0];\n      world.pen.at(7 * 16, 4.5 * 16, 0, 0, 16).tube(0, 0, 0, 0, 0, .15, 3.2, '#5a5a62').tube(0, 0, .15, 0, 0, .2, 3, '#ffd23a');\n      const C = CARS[S.car];\n      drawCar(world.pen, S.car, { p: [7, 4.5, C.ride + .2], f, r: rr, u: [0, 0, 1], wd: [C.ride, C.ride, C.ride, C.ride], lights: S.lights, brake: S.lights, time: S.t }, p);\n      world.draw(r);\n    }\n    r.overlay(g => {\n      const W = r.W, H = r.H;\n      big(g, 'GARAGE', W / 2 + 70, 8, '#ffffff', 2);\n      coinIcon(g, W - 90, H - 60); text(g, String(P().coppers), W - 74, H - 60, '#f0a050');\n      F.draw(g);\n      const p = paint(); if (F.cur && F.cur.id === 'pattern' && !P().hasPattern(p.pattern)) E.font.text(g, 'PRESS ' + (game.input.label('confirm') || 'ENTER') + ' TO BUY FOR 100 COPPERS', 12, H - 48, '#ffb060', { outline: '#10101a' });\n      if (!carOpen(S.car)) E.font.text(g, 'OPEN ' + (S.car === 'pebble' ? 'HEDGEROW' : 'FROSTPEAK') + ' IN RACE TO DRIVE THE ' + CARS[S.car].name, 12, H - 48, '#ffb060', { outline: '#10101a' });\n      promptBar(g, game, [['up', 'CHOOSE'], ['left', 'CHANGE'], ['alt', 'LIGHTS'], ['cancel', 'DONE']]);\n      if (app.devOpen) app.dev.draw(g, W, H);\n    });\n  }\n  return { pausable: true, input: null, touch: [], camera: false, build, enter, update, draw };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Ugnk9iCjWNziMzN4NXXfy2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
