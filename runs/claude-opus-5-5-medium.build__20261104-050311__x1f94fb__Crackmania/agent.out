(' | '));\",\"\"\"    // sound: after a key the audio context runs, music plays, the car engine builds its nodes, a voice babbles\n    await p.keyboard.press('KeyX'); await p.waitForTimeout(300);\n    const au = await p.evaluate(async () => { const g = __crack.game, A = g.audio; __crack.app.modes.campaign('D1'); await new Promise(r => setTimeout(r, 2500)); g.advance(.5); const R = __crack.app.race; const P = R && R.players[0]; const n = My3D2dge && A.ctx ? (await import('data:text/javascript,export default 1'), 1) : 0; const { babble } = { babble: null }; return { ctx: !!A.ctx, state: A.ctx && A.ctx.state, song: !!A.song, car: !!(P && P.sound.nodes) }; });\n    check('audio context running', au.ctx && au.state === 'running', JSON.stringify(au)); check('music playing', au.song); check('car engine synth built', au.car, JSON.stringify(au));\n    const bab = await p.evaluate(() => { const D = __crack.app.dialog; D.say([['coco', 'Bonjour, allez!']], { modal: false }); return D.open; }); check('a voice line opens and babbles', bab);\n    // clipboard: the editor's share code is copied (clipboard permission granted)\n    await p.evaluate(() => { __crack.app.modes.editor({ slot: 3, env: 'dustbowl' }); }); await p.waitForTimeout(2500);\n    const code = await p.evaluate(async () => { const ed = __crack.app.scenes.editor, S = ed.state; __crack.app.dialog.open = false; ed.api.place('ST', 4, 4, 0, 0); ed.api.place('S', 5, 4, 0, 0); const m = __crack.app.editorMenu().find(x => x[0] === 'Share code'); m[1](); await new Promise(r => setTimeout(r, 500)); return { modal: S.modal && S.modal.code, clip: await navigator.clipboard.readText() }; });\n    check('share code copied to the clipboard', code.modal && code.clip === code.modal, (code.clip || '').slice(0, 30));\n    check('no page errors', errs.length === 0, errs.slice(0, 3).join(' | '));\"\"\")\ns=s.replace(\"  const { p, ctx, errs, ok } = await open(FILE);\\n  check('boots from file://'\",\"  const { p, ctx, errs, ok } = await open(FILE, { permissions: ['clipboard-read', 'clipboard-write'] });\\n  check('boots from file://'\")\nopen(p,'w').write(s)\nEOF\nsed -i \"s/const n = My3D2dge \\&\\& A.ctx ? (await import('data:text\\/javascript,export default 1'), 1) : 0; const { babble } = { babble: null }; //\" tools/browser.mjs\nnode tools/test.mjs ui 2>&1 | tail -3; node tools/browser.mjs 2>&1 | tail -5","description":"Add audio, clipboard, glyph, flyover and dressing checks","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3599,"cache_read_input_tokens":673625,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3599},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71d84256-7fc9-49b2-a3c8-c6f9b5cc892b","uuid":"efc993bd-217c-44a3-a8f4-4031dde459ee","timestamp":"2026-11-04T13:32:49.925Z","request_id":"req_011CghyLo6DT8QJYoXRuvKmh","wire_tool_inputs":{"toolu_01RUpf77fEyQdoffm5Ro2nUt":{"command":"python3 - <<'EOF'\np='tools/test.mjs'; s=open(p).read()\ns=s.replace(\"  // every pause menu item set exists per scene\",\"\"\"  // the Xbox symbols setting changes what the prompts show\n  { game.settings.set('glyphs', 'xbox'); check('ui', 'Button symbols: Xbox selectable', game.input.padStyle() === 'xbox' && game.input.codeLabel('Pad0') === 'A', game.input.padStyle() + ' ' + game.input.codeLabel('Pad0')); game.settings.set('glyphs', 'playstation'); check('ui', 'Button symbols: PlayStation', game.input.padStyle() === 'playstation' && game.input.codeLabel('Pad0') === '✕', game.input.codeLabel('Pad0')); }\n  // the flyover intro plays before the countdown, and a press skips it\n  { app.modes.campaign('D2'); adv(.8); check('ui', 'flyover intro first', app.race.phase === 'intro'); adv(1); check('ui', 'sti