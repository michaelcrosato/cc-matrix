his.car, this.spawn); this.car.held = true;\")\ns=s.replace(\"    else placeCar(c, this.course.spawn);\",\"    else placeCar(c, this.spawn);\")\nopen(p,'w').write(s)\np='src/race.js'; s=open(p).read()\ns=s.replace(\"const run = new Run(S.course, pl.carId, { countdown: spec.countdown ?? 3 });\",\"const lane = spec.players.length > 1 ? (i - (spec.players.length - 1) / 2) * 3.2 : 0, run = new Run(S.course, pl.carId, { countdown: spec.countdown ?? 3, lane });\")\ns=s.replace(\"P.run = new Run(S.course, P.carId, { countdown: cd });\",\"P.run = new Run(S.course, P.carId, { countdown: cd, lane: P.run.o.lane || 0 });\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"lane\" src/race.js src/run.js | head","description":"Revert engine experiment; add grid lanes for split screen"}}}
