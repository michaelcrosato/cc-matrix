 - 2) * 8 + fn.t[1] * 20) * U, z = (fn.p[2] + 22 + (n % 3) * 5) * U, cols = [['#ff5a4a', '#ffd23a'], ['#5ab0ff', '#ffffff'], ['#5ae07a', '#ffd23a'], ['#e85ab8', '#ffffff'], ['#ff9a2a', '#fff0a0']][n];\n        game.particles.bits(x, y, z, 26, cols); game.particles.glints(x, y, z, 14, cols[1]); game.audio.sfx({ wave: 'noise', freq: 700, to: 90, dur: .3, vol: .12 }); }\n    }\"\"\")\n# draw skids\ns=s.replace(\"      if (app.dev) app.dev.draw3d(S, pen);\",\"\"\"      if (app.dev) app.dev.draw3d(S, pen);\n      pen.ghost = true; for (const k of S.skids) { const age = S.t - k.t; if (age > 8) continue; const sh = Math.round(20 + age * 8).toString(16).padStart(2, '0'); pen.at(0, 0, 0, 0, U).slab(k.a[0], k.a[1], k.a[2], k.b[0], k.b[1], k.b[2], k.u[0], k.u[1], k.u[2], .03, .26, '#' + sh + sh + sh); } pen.ghost = false;\n      S.skids = S.skids.filter(k => S.t - k.t <= 8);\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"pen.at(0, 0, 0, 0, U).slab(k.a\" src/race.js | head -2","description":"Add skid marks, fireworks and a larger flag man"}}}
