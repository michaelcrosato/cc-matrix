nce(.5);\\n  check('the title is the first scene', game.scene && (game.scene.name || game.sceneName) === 'title' || snap().scene === 'title', JSON.stringify(snap()).slice(0, 200));\",\n\"  check('the files load: scenes, data, the sim', !!FF.scenes.title && !!FF.scenes.play && !!FF.sim && !!FF.data);\\n  game.advance(.5);\\n  check('the title is the first scene', snap().scene === 'title', JSON.stringify(snap()).slice(0, 200));\")\ns=s.replace(\"  check('the title has six entries', true);\\n\",\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 300 node test/run.mjs boot 2>&1 | head -30","description":"Add debug handle and rerun boot suite"}},"wire_ingest_context":{"toolu_01HC2teRQWgMQqSbgLvryHbw":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-071627__xb697dc/work/AmericanFootballFiasco-AmericanFootball-claude-haiku-5-5-medium-20261104-071627"}}}
