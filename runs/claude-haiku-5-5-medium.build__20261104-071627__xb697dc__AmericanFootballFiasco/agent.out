rig.draw(g, ox, oy, view));\",\n  \"    r.shadow(p.x, p.y, 5, .35);\\n    r.actor(p.x, p.y, 0, (g, ox, oy) => p.rig.draw(g, ox, oy, view));\\n    // the jersey number: each man's own, on his back, in his team's trim color\\n    const num = String((p.slot * 11 + p.side * 37) % 98 + 1);\\n    r.queue(p.x, p.y, 30, g => { const [sx, sy] = r.w(p.x, p.y, 30); E.font.text(g, num, Math.round(sx), Math.round(sy), p.team.trim, { align: 'center', font: 'tiny', outline: '#000' }); });\"),\n])\nprint('ok')\nPYEOF\npython3 /tmp/e7.py && timeout 900 node test/run.mjs 2>&1 | tail -1 && node build.mjs | head -1 && timeout 200 node tools/shots.mjs 2>&1 | tail -1","description":"Add jersey numbers and dive/juke rig animation, then test"}}}
