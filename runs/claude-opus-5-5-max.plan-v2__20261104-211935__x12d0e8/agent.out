ime\nfrom playwright.sync_api import sync_playwright\nroot = sys.argv[1]\nFLAGS = ['--enable-unsafe-webgpu', '--use-webgpu-adapter=swiftshader', '--enable-features=Vulkan', '--use-angle=vulkan', '--use-vulkan=swiftshader', '--enable-unsafe-swiftshader']\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=FLAGS)\n    ctx = b.new_context(viewport={'width': 800, 'height': 500})\n    a = ctx.new_page(); c = ctx.new_page()\n    u = f'file://{root}/dist/bc.html'\n    a.goto(u); c.goto(u)\n    a.wait_for_timeout(200)\n    a.evaluate(\"window.__send({hello:1})\")\n    c.wait_for_timeout(300)\n    print('file:// BroadcastChannel same context: got', c.evaluate('window.__got'), 'localStorage', c.evaluate('window.__ls'))\n    # pointer lock in headless\n    a.bring_to_front()\n    a.mouse.move(100, 100); a.mouse.click(200, 200); a.wait_for_timeout(300)\n    a.mouse.move(250, 240); a.wait_for_timeout(100); a.mouse.move(300, 260); a.wait_for_timeout(200)\n    print('pointer lock events', json.dumps(a.evaluate('window.__events'))[:400])\n    print('audio', a.evaluate('window.__audio()'))\n    # touch-only profile\n    iphone = p.devices['iPhone 13']\n    b.close()\n    # WebGL2 fallback look in chromium & firefox\n    b = p.chromium.launch(headless=True, args=FLAGS)\n    pg = b.new_page(viewport={'width': 1280, 'height': 720})\n    logs=[]; pg.on('console', lambda m: logs.append(m.text[:200]) if m.type=='error' else None)\n    pg.goto(f'file://{root}/dist/spike.html?grass=30000&webgl=1')\n    pg.wait_for_function('window.__loaded === true || window.__error', timeout=120000)\n    pg.wait_for_timeout(3000)\n    print('forceWebGL', json.dumps(pg.evaluate('window.__state ? window.__state() : null'))[:200], 'err', pg.evaluate('window.__error||null'), logs[:3])\n    pg.screenshot(path=f'{root}/dist/s-webgl2.png')\n    b.close()\n    fx = p.firefox.launch(headless=True)\n    pg = fx.new_page(viewport={'width': 1280, 'height': 720})\n    logs=[]; pg.on('console', 