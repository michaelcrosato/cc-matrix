ntext('2d');c2.drawImage(document.getElementById('c'),0,0,2,2);return {len:u.length,px:[...c2.getImageData(0,0,1,1).data]}};\n  let f=0;const loop=()=>{draw();f++;window.__f=f;requestAnimationFrame(loop)};loop();\n  window.__ok=true;\n})().catch(e=>log.push('ERR '+e));\n</script></body></html>\nEOF\ncat > src/rawgpu.py <<'EOF'\nimport json, sys, time\nfrom playwright.sync_api import sync_playwright\nroot = sys.argv[1]\nFLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader']\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=FLAGS)\n    pg = b.new_page(viewport={'width': 800, 'height': 500})\n    pg.goto(f'file://{root}/src/rawgpu.html')\n    pg.wait_for_timeout(1500)\n    print(json.dumps(pg.evaluate('window.__log')))\n    print('frames', pg.evaluate('window.__f'))\n    print('toData', pg.evaluate('window.__toData ? window.__toData() : null'))\n    pg.wait_for_timeout(4000)\n    print(json.dumps(pg.evaluate('window.__log')), 'frames', pg.evaluate('window.__f'))\n    pg.screenshot(path=f'{root}/dist/raw-shot.png')\n    b.close()\nEOF\npython3 src/rawgpu.py $PWD 2>&1 | cut -c1-600; ls -la dist/raw-shot.png | cut -c24-; pgrep -af \"chrome|headless_shell\" | grep -c spike || true","description":"Test raw WebGPU on software adapter without three","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1881,"cache_read_input_tokens":158595,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1881},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c0178d0d-15a3-488a-af93-32cb0d078d37","uuid":"af4b9307-07b6-4e45-a31f-0c97efe3f57e","timestamp":"2026-11-05T04:33:10.040Z","request_id":"req_011Cgj9zo4TBkaBsSP5XeR28",