{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9gys6Xg58WirJ3t2aC","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5686,"cache_read_input_tokens":124231,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5686},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c0178d0d-15a3-488a-af93-32cb0d078d37","uuid":"d6920e2d-4aba-41ce-84a2-4bf90be8f252","timestamp":"2026-11-05T04:28:57.131Z","request_id":"req_011Cgj9gydSkaGY9hyZYfMaM","thinking_duration_ms":9148,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9gys6Xg58WirJ3t2aC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ReS5yGUJeFDHdGhw4AybQV","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211935__x12d0e8/tmp/spike/src/render.js","content":"// Planner's spike: R180 WebGPU + TSL ink/cel look + Rapier in one bundled HTML file.\nimport * as THREE from 'three/webgpu';\nimport {\n  pass, mrt, output, transformedNormalView, uniform, vec2, vec3, vec4, float, Fn, screenUV, screenSize, texture, positionLocal,\n  instanceIndex, attribute, time, sin, cos, mix, step, smoothstep, length, dot, abs, max, min, clamp, normalize, luminance, positionWorld, uv, hash, floor, fract,\n  add, viewportLinearDepth, color, normalLocal,\n} from 'three/tsl';\nimport RAPIER from '@dimforge/rapier3d-compat';\n\nconst log = (...a) => { (window.__log = window.__log || []).push(a.join(' ')); };\nconst params = new URLSearchParams(location.search);\nconst t0 = performance.now();\nconst marks = {};\nconst mark = (k) => { marks[k] = Math.round(performance.now() - t0); };\n\nasync function main() {\n  if (window.AIHub && AIHub.active) await hubBoot();\n  await RAPIER.init(); mark('rapier');\n  const renderer = new THREE.WebGPURenderer({ antialias: false, forceWebGL: params.get('webgl') === '1' });\n  renderer.setPixelRatio(1);\n  renderer.setSize(innerWidth, innerHeight);\n  renderer.shadowMap.enabled = true;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  document.body.appendChild(renderer.domElement);\n  await renderer.init(); mark('renderer');\n  window.__backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0xd9a35a);\n  scene.fog = new THREE.Fog(0xd9a35a, 60, 420);\n  const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.1, 1500);\n  camera.position.set(0, 7, 34);\n  camera.lookAt(0, 3, 0);\n\n  const sun = new THREE.DirectionalLight(0xfff0d0, 3.2);\n  sun.position.set(-60, 90, 40);\n  sun.castShadow = true;\n  sun.shadow.mapSize.set(2048, 2048);\n  Object.assign(sun.shadow.camera, { left: -60, right: 60, top: 60, bottom: -60, near: 1, far: 300 });\n  scene.add(sun);\n  scene.add(new THREE.HemisphereLight(0xbcd0e0, 0x6a4a28, 1.1));\n\n  // Toon ramp: 3 hard bands\n  const ramp = new THREE.DataTexture(new Uint8Array([70, 70, 70, 255, 150, 150, 150, 255, 255, 255, 255, 255]), 3, 1, THREE.RGBAFormat);\n  ramp.minFilter = ramp.magFilter = THREE.NearestFilter; ramp.needsUpdate = true;\n  window.__ramp = ramp;\n\n  // Burn grid: R = burnt 0..1, G = burning 0..1\n  const N = 64;\n  const burnData = new Uint8Array(N * N * 4);\n  const burnTex = new THREE.DataTexture(burnData, N, N, THREE.RGBAFormat);\n  burnTex.magFilter = THREE.LinearFilter; burnTex.needsUpdate = true;\n  const worldToBurn = (xz) => xz.div(256).add(0.5);\n\n  // Terrain\n  const tgeo = new THREE.PlaneGeometry(256, 256, 128, 128); tgeo.rotateX(-Math.PI / 2);\n  const pos = tgeo.attributes.position;\n  const hAt = (x, z) => 2.2 * Math.sin(x * 0.05) * Math.cos(z * 0.04) + 0.7 * Math.sin(x * 0.17 + z * 0.13);\n  for (let i = 0; i < pos.count; i++) pos.setY(i, hAt(pos.getX(i), pos.getZ(i)));\n  tgeo.computeVertexNormals();\n  const terrainMat = new THREE.MeshToonNodeMaterial({ color: 0xc48d4e, gradientMap: ramp });\n  const burnAtWorld = texture(burnTex, worldToBurn(positionWorld.xz));\n  terrainMat.colorNode = mix(color(0xc48d4e), color(0x1b1512), burnAtWorld.r);\n  const terrain = new THREE.Mesh(tgeo, terrainMat); terrain.receiveShadow = true; scene.add(terrain);\n\n  // Instanced grass with wind sway + burn collapse in the vertex stage\n  const windDir = uniform(new THREE.Vector2(1, 0.3));\n  const windStr = uniform(0.5);\n  const bladeGeo = new THREE.PlaneGeometry(0.5, 1.2, 1, 3); bladeGeo.translate(0, 0.6, 0);\n  const grassMat = new THREE.MeshToonNodeMaterial({ color: 0xd4b061, gradientMap: ramp, side: THREE.DoubleSide });\n  const instPos = attribute('instOffset', 'vec3');\n  const h = positionLocal.y.div(1.2);\n  const grassBurn = texture(burnTex, worldToBurn(instPos.xz));\n  const sway = sin(time.mul(2.1).add(instPos.x.mul(0.31)).add(instPos.z.mul(0.27))).mul(windStr).mul(h).mul(h).mul(0.5);\n  grassMat.positionNode = positionLocal.mul(vec3(1, float(1).sub(grassBurn.r.mul(0.85)), 1)).add(vec3(windDir.x.mul(sway), 0, windDir.y.mul(sway))).add(instPos);\n  grassMat.colorNode = mix(mix(color(0xa07f3a), color(0xe2c777), h), color(0x14100c), grassBurn.r);\n  const COUNT = Number(params.get('grass') || 60000);\n  const igeo = new THREE.InstancedBufferGeometry(); igeo.index = bladeGeo.index; igeo.attributes.position = bladeGeo.attributes.position; igeo.attributes.normal = bladeGeo.attributes.normal; igeo.attributes.uv = bladeGeo.attributes.uv;\n  const off = new Float32Array(COUNT * 3);\n  for (let i = 0; i < COUNT; i++) { const x = (Math.random() - 0.5) * 200, z = (Math.random() - 0.5) * 200; off[i * 3] = x; off[i * 3 + 1] = hAt(x, z); off[i * 3 + 2] = z; }\n  igeo.setAttribute('instOffset', new THREE.InstancedBufferAttribute(off, 3));\n  igeo.instanceCount = COUNT;\n  const grass = new THREE.Mesh(igeo, grassMat); grass.frustumCulled = false; scene.add(grass);\n\n  // Props + shadow\n  const propMat = new THREE.MeshToonNodeMaterial({ color: 0x6d7a55, gradientMap: ramp });\n  const rust = new THREE.MeshToonNodeMaterial({ color: 0x8a3e22, gradientMap: ramp });\n  for (let i = 0; i < 6; i++) {\n    const m = new THREE.Mesh(new THREE.BoxGeometry(4, 3, 8), i % 2 ? rust : propMat);\n    m.position.set(-22 + i * 9, 1.5 + hAt(-22 + i * 9, -4), -4); m.rotation.y = i * 0.5; m.castShadow = m.receiveShadow = true; scene.add(m);\n  }\n  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.8, 9, 7), new THREE.MeshToonNodeMaterial({ color: 0x43301f, gradientMap: ramp })); trunk.position.set(12, 4.5, 8); trunk.castShadow = true; scene.add(trunk);\n  const canopy = new THREE.Mesh(new THREE.CylinderGeometry(7, 5, 1.6, 9), new THREE.MeshToonNodeMaterial({ color: 0x59693a, gradientMap: ramp })); canopy.position.set(12, 9.5, 8); canopy.castShadow = true; scene.add(canopy);\n\n  // Skinned figure with an AnimationMixer clip, proves toon + skinning + shadow on the node pipeline\n  const sgeo = new THREE.CylinderGeometry(0.35, 0.35, 1.8, 8, 6); sgeo.translate(0, 0.9, 0);\n  const skinIdx = new Uint16Array(sgeo.attributes.position.count * 4), skinW = new Float32Array(sgeo.attributes.position.count * 4);\n  for (let i = 0; i < sgeo.attributes.position.count; i++) { const y = sgeo.attributes.position.getY(i) / 1.8; skinIdx[i * 4] = 0; skinIdx[i * 4 + 1] = 1; skinW[i * 4] = 1 - y; skinW[i * 4 + 1] = y; }\n  sgeo.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(skinIdx, 4)); sgeo.setAttribute('skinWeight', new THREE.Float32BufferAttribute(skinW, 4));\n  const b0 = new THREE.Bone(), b1 = new THREE.Bone(); b1.position.y = 0.9; b0.add(b1); b1.name = 'spine';\n  const sm = new THREE.SkinnedMesh(sgeo, new THREE.MeshToonNodeMaterial({ color: 0x2c4a6e, gradientMap: ramp })); sm.add(b0); sm.bind(new THREE.Skeleton([b0, b1])); sm.position.set(-3, hAt(-3, 14), 14); sm.castShadow = true; scene.add(sm);\n  const clip = new THREE.AnimationClip('sway', 2, [new THREE.QuaternionKeyframeTrack('spine.quaternion', [0, 1, 2], [0, 0, 0, 1, 0, 0, 0.38, 0.92, 0, 0, 0, 1])]);\n  const mixer = new THREE.AnimationMixer(sm); mixer.clipAction(clip).play();\n  window.__mixer = mixer;\n\n  // Post: ink lines from depth + normal, hatching in the darks, paper grain, fever warp\n  const fever = uniform(0), inkAmt = uniform(1), hatchAmt = uniform(1), grainAmt = uniform(0.05);\n  const scenePass = pass(scene, camera);\n  scenePass.setMRT(mrt({ output, nrm: transformedNormalView }));\n  const warp = Fn(() => {\n    const d = screenUV.sub(0.5);\n    const wob = vec2(sin(screenUV.y.mul(23).add(time.mul(2.3))), cos(screenUV.x.mul(19).add(time.mul(1.7)))).mul(0.006).mul(fever);\n    return screenUV.add(wob).add(d.mul(length(d)).mul(0.05).mul(fever));\n  })();\n  const colTex = scenePass.getTextureNode('output');\n  const nrmTex = scenePass.getTextureNode('nrm');\n  const depthNode = scenePass.getTextureNode('depth');\n  const linDepthAt = (u) => scenePass.getLinearDepthNode().sample ? scenePass.getLinearDepthNode().sample(u) : scenePass.getLinearDepthNode();\n  const ink = Fn(() => {\n    const px = vec2(1).div(screenSize).mul(1.5);\n    const dC = scenePass.getLinearDepthNode('depth').r;\n    const nC = nrmTex.sample(warp).xyz;\n    let edgeD = float(0), edgeN = float(0);\n    for (const [ox, oy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {\n      const u = warp.add(vec2(ox, oy).mul(px));\n      const n = nrmTex.sample(u).xyz;\n      edgeN = edgeN.add(float(1).sub(dot(n, nC).clamp(0, 1)));\n      const dd = depthNode.sample(u).r.sub(depthNode.sample(warp).r).abs();\n      edgeD = edgeD.add(dd);\n    }\n    return smoothstep(0.35, 0.7, edgeN).max(smoothstep(0.0006, 0.002, edgeD));\n  })();\n  const graded = Fn(() => {\n    const c = colTex.sample(warp).rgb;\n    const lum = luminance(c);\n    const p = screenUV.mul(screenSize);\n    // Hatching: two line sets fade in below luminance thresholds\n    const h1 = step(fract(p.x.add(p.y).mul(0.11)), 0.22).mul(smoothstep(0.42, 0.25, lum));\n    const h2 = step(fract(p.x.sub(p.y).mul(0.11)), 0.22).mul(smoothstep(0.24, 0.1, lum));\n    const hatch = max(h1, h2).mul(hatchAmt).mul(0.55);\n    const grain = hash(p.mul(0.5).add(time.mul(3).floor())).sub(0.5).mul(grainAmt);\n    const paper = vec3(1.0, 0.965, 0.89);\n    const inked = c.mul(float(1).sub(hatch)).mul(float(1).sub(ink.mul(inkAmt).mul(0.92))).mul(paper).add(grain);\n    return vec4(inked, 1);\n  })();\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = graded;\n  window.__post = post;\n  mark('built');\n\n  // Simple physics world to prove the bundle\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 });\n  const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 5, 0));\n  world.createCollider(RAPIER.ColliderDesc.ball(0.5), b);\n\n  await post.renderAsync(); mark('firstFrame');\n\n  // Start a fire scar so burn texture shows\n  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) { const d = Math.hypot(x - 22, y - 30); burnData[(y * N + x) * 4] = d < 9 ? 255 : 0; }\n  burnTex.needsUpdate = true;\n\n  let frames = 0; const c0 = performance.now(); let lastT = c0;\n  window.__state = () => ({ backend: window.__backend, marks, frames, fps: frames / ((performance.now() - c0) / 1000), physY: b.translation().y, canvas: [renderer.domElement.width, renderer.domElement.height], log: window.__log });\n  window.__capture = async () => {\n    // Render, then read the canvas in the same task.\n    await post.renderAsync();\n    return renderer.domElement.toDataURL('image/png');\n  };\n  window.__setFever = (v) => { fever.value = v; };\n  const loop = async () => {\n    const now = performance.now(); const dt = Math.min(0.1, (now - lastT) / 1000); lastT = now;\n    mixer.update(dt); world.step(); await post.renderAsync(); frames++;\n    if (!window.__stop) requestAnimationFrame(loop);\n  };\n  window.__loaded = true;\n  if (window.AIHub && AIHub.active && AIHub.server) { /* no picture on a server */ }\n  if (params.get('noloop') !== '1') requestAnimationFrame(loop);\n  if (window.AIHub && AIHub.active) hubGo();\n}\n\n// A minimal shared-world client: enough to pass the harness.\nlet hub = null;\nasync function hubBoot() {\n  mark('hubBoot');\n  hub = await AIHub.connect({ mode: 'shared-world', seats: [1, 4] });\n  mark('hubConnected');\n}\nfunction hubGo() {\n  if (!hub) return;\n  AIHub.ready(); mark('hubReady');\n  AIHub.on('time-up', () => { if (hub.isHost) doFinish(); });\n  AIHub.on('leave', () => {});\n  AIHub.on('end', () => { window.__stop = true; });\n  AIHub.on('message', () => {});\n  setInterval(() => {\n    if (AIHub.time() < 0) return;\n    if (hub.isHost) AIHub.send({ t: 's', at: Math.round(AIHub.time()) }, { reliable: false });\n    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()) }, { to: hub.host, reliable: false });\n  }, 100);\n  function doFinish() { AIHub.finish({ standings: [AIHub.players.map((p) => p.id)], won: true }); }\n}\n\nmain().catch((e) => { window.__error = String(e && e.stack || e); console.error(e); });\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5686,"cache_read_input_tokens":124231,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5686},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c0178d0d-15a3-488a-af93-32cb0d078d37","uuid":"f0e895bb-0ded-45bf-8a3d-7c344bf808f6","timestamp":"2026-11-05T04:29:45.743Z","request_id":"req_011Cgj9gydSkaGY9hyZYfMaM","wire_tool_inputs":{"toolu_01ReS5yGUJeFDHdGhw4AybQV":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211935__x12d0e8/tmp/spike/src/render.js","content":"// Planner's spike: R180 WebGPU + TSL ink/cel look + Rapier in one bundled HTML file.\nimport * as THREE from 'three/webgpu';\nimport {\n  pass, mrt, output, transformedNormalView, uniform, vec2, vec3, vec4, float, Fn, screenUV, screenSize, texture, positionLocal,\n  instanceIndex, attribute, time, sin, cos, mix, step, smoothstep, length, dot, abs, max, min, clamp, normalize, luminance, positionWorld, uv, hash, floor, fract,\n  add, viewportLinearDepth, color, normalLocal,\n} from 'three/tsl';\nimport RAPIER from '@dimforge/rapier3d-compat';\n\nconst log = (...a) => { (window.__log = window.__log || []).push(a.join(' ')); };\nconst params = new URLSearchParams(location.search);\nconst t0 = performance.now();\nconst marks = {};\nconst mark = (k) => { marks[k] = Math.round(performance.now() - t0); };\n\nasync function main() {\n  if (window.AIHub && AIHub.active) await hubBoot();\n  await RAPIER.init(); mark('rapier');\n  const renderer = new THREE.WebGPURenderer({ antialias: false, forceWebGL: params.get('webgl') === '1' });\n  renderer.setPixelRatio(1);\n  renderer.setSize(innerWidth, innerHeight);\n  renderer.shadowMap.enabled = true;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  document.body.appendChild(renderer.domElement);\n  await renderer.init(); mark('renderer');\n  window.__backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0xd9a35a);\n  scene.fog = new THREE.Fog(0xd9a35a, 60, 420);\n  const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.1, 1500);\n  camera.position.set(0, 7, 34);\n  camera.lookAt(0, 3, 0);\n\n  const sun = new THREE.DirectionalLight(0xfff0d0, 3.2);\n  sun.position.set(-60, 90, 40);\n  sun.castShadow = true;\n  sun.shadow.mapSize.set(2048, 2048);\n  Object.assign(sun.shadow.camera, { left: -60, right: 60, top: 60, bottom: -60, near: 1, far: 300 });\n  scene.add(sun);\n  scene.add(new THREE.HemisphereLight(0xbcd0e0, 0x6a4a28, 1.1));\n\n  // Toon ramp: 3 hard bands\n  const ramp = new THREE.DataTexture(new Uint8Array([70, 70, 70, 255, 150, 150, 150, 255, 255, 255, 255, 255]), 3, 1, THREE.RGBAFormat);\n  ramp.minFilter = ramp.magFilter = THREE.NearestFilter; ramp.needsUpdate = true;\n  window.__ramp = ramp;\n\n  // Burn grid: R = burnt 0..1, G = burning 0..1\n  const N = 64;\n  const burnData = new Uint8Array(N * N * 4);\n  const burnTex = new THREE.DataTexture(burnData, N, N, THREE.RGBAFormat);\n  burnTex.magFilter = THREE.LinearFilter; burnTex.needsUpdate = true;\n  const worldToBurn = (xz) => xz.div(256).add(0.5);\n\n  // Terrain\n  const tgeo = new THREE.PlaneGeometry(256, 256, 128, 128); tgeo.rotateX(-Math.PI / 2);\n  const pos = tgeo.attributes.position;\n  const hAt = (x, z) => 2.2 * Math.sin(x * 0.05) * Math.cos(z * 0.04) + 0.7 * Math.sin(x * 0.17 + z * 0.13);\n  for (let i = 0; i < pos.count; i++) pos.setY(i, hAt(pos.getX(i), pos.getZ(i)));\n  tgeo.computeVertexNormals();\n  const terrainMat = new THREE.MeshToonNodeMaterial({ color: 0xc48d4e, gradientMap: ramp });\n  const burnAtWorld = texture(burnTex, worldToBurn(positionWorld.xz));\n  terrainMat.colorNode = mix(color(0xc48d4e), color(0x1b1512), burnAtWorld.r);\n  const terrain = new THREE.Mesh(tgeo, terrainMat); terrain.receiveShadow = true; scene.add(terrain);\n\n  // Instanced grass with wind sway + burn collapse in the vertex stage\n  const windDir = uniform(new THREE.Vector2(1, 0.3));\n  const windStr = uniform(0.5);\n  const bladeGeo = new THREE.PlaneGeometry(0.5, 1.2, 1, 3); bladeGeo.translate(0, 0.6, 0);\n  const grassMat = new THREE.MeshToonNodeMaterial({ color: 0xd4b061, gradientMap: ramp, side: THREE.DoubleSide });\n  const instPos = attribute('instOffset', 'vec3');\n  const h = positionLocal.y.div(1.2);\n  const grassBurn = texture(burnTex, worldToBurn(instPos.xz));\n  const sway = sin(time.mul(2.1).add(instPos.x.mul(0.31)).add(instPos.z.mul(0.27))).mul(windStr).mul(h).mul(h).mul(0.5);\n  grassMat.positionNode = positionLocal.mul(vec3(1, float(1).sub(grassBurn.r.mul(0.85)), 1)).add(vec3(windDir.x.mul(sway), 0, windDir.y.mul(sway))).add(instPos);\n  grassMat.colorNode = mix(mix(color(0xa07f3a), color(0xe2c777), h), color(0x14100c), grassBurn.r);\n  const COUNT = Number(params.get('grass') || 60000);\n  const igeo = new THREE.InstancedBufferGeometry(); igeo.index = bladeGeo.index; igeo.attributes.position = bladeGeo.attributes.position; igeo.attributes.normal = bladeGeo.attributes.normal; igeo.attributes.uv = bladeGeo.attributes.uv;\n  const off = new Float32Array(COUNT * 3);\n  for (let i = 0; i < COUNT; i++) { const x = (Math.random() - 0.5) * 200, z = (Math.random() - 0.5) * 200; off[i * 3] = x; off[i * 3 + 1] = hAt(x, z); off[i * 3 + 2] = z; }\n  igeo.setAttribute('instOffset', new THREE.InstancedBufferAttribute(off, 3));\n  igeo.instanceCount = COUNT;\n  const grass = new THREE.Mesh(igeo, grassMat); grass.frustumCulled = false; scene.add(grass);\n\n  // Props + shadow\n  const propMat = new THREE.MeshToonNodeMaterial({ color: 0x6d7a55, gradientMap: ramp });\n  const rust = new THREE.MeshToonNodeMaterial({ color: 0x8a3e22, gradientMap: ramp });\n  for (let i = 0; i < 6; i++) {\n    const m = new THREE.Mesh(new THREE.BoxGeometry(4, 3, 8), i % 2 ? rust : propMat);\n    m.position.set(-22 + i * 9, 1.5 + hAt(-22 + i * 9, -4), -4); m.rotation.y = i * 0.5; m.castShadow = m.receiveShadow = true; scene.add(m);\n  }\n  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.8, 9, 7), new THREE.MeshToonNodeMaterial({ color: 0x43301f, gradientMap: ramp })); trunk.position.set(12, 4.5, 8); trunk.castShadow = true; scene.add(trunk);\n  const canopy = new THREE.Mesh(new THREE.CylinderGeometry(7, 5, 1.6, 9), new THREE.MeshToonNodeMaterial({ color: 0x59693a, gradientMap: ramp })); canopy.position.set(12, 9.5, 8); canopy.castShadow = true; scene.add(canopy);\n\n  // Skinned figure with an AnimationMixer clip, proves toon + skinning + shadow on the node pipeline\n  const sgeo = new THREE.CylinderGeometry(0.35, 0.35, 1.8, 8, 6); sgeo.translate(0, 0.9, 0);\n  const skinIdx = new Uint16Array(sgeo.attributes.position.count * 4), skinW = new Float32Array(sgeo.attributes.position.count * 4);\n  for (let i = 0; i < sgeo.attributes.position.count; i++) { const y = sgeo.attributes.position.getY(i) / 1.8; skinIdx[i * 4] = 0; skinIdx[i * 4 + 1] = 1; skinW[i * 4] = 1 - y; skinW[i * 4 + 1] = y; }\n  sgeo.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(skinIdx, 4)); sgeo.setAttribute('skinWeight', new THREE.Float32BufferAttribute(skinW, 4));\n  const b0 = new THREE.Bone(), b1 = new THREE.Bone(); b1.position.y = 0.9; b0.add(b1); b1.name = 'spine';\n  const sm = new THREE.SkinnedMesh(sgeo, new THREE.MeshToonNodeMaterial({ color: 0x2c4a6e, gradientMap: ramp })); sm.add(b0); sm.bind(new THREE.Skeleton([b0, b1])); sm.position.set(-3, hAt(-3, 14), 14); sm.castShadow = true; scene.add(sm);\n  const clip = new THREE.AnimationClip('sway', 2, [new THREE.QuaternionKeyframeTrack('spine.quaternion', [0, 1, 2], [0, 0, 0, 1, 0, 0, 0.38, 0.92, 0, 0, 0, 1])]);\n  const mixer = new THREE.AnimationMixer(sm); mixer.clipAction(clip).play();\n  window.__mixer = mixer;\n\n  // Post: ink lines from depth + normal, hatching in the darks, paper grain, fever warp\n  const fever = uniform(0), inkAmt = uniform(1), hatchAmt = uniform(1), grainAmt = uniform(0.05);\n  const scenePass = pass(scene, camera);\n  scenePass.setMRT(mrt({ output, nrm: transformedNormalView }));\n  const warp = Fn(() => {\n    const d = screenUV.sub(0.5);\n    const wob = vec2(sin(screenUV.y.mul(23).add(time.mul(2.3))), cos(screenUV.x.mul(19).add(time.mul(1.7)))).mul(0.006).mul(fever);\n    return screenUV.add(wob).add(d.mul(length(d)).mul(0.05).mul(fever));\n  })();\n  const colTex = scenePass.getTextureNode('output');\n  const nrmTex = scenePass.getTextureNode('nrm');\n  const depthNode = scenePass.getTextureNode('depth');\n  const linDepthAt = (u) => scenePass.getLinearDepthNode().sample ? scenePass.getLinearDepthNode().sample(u) : scenePass.getLinearDepthNode();\n  const ink = Fn(() => {\n    const px = vec2(1).div(screenSize).mul(1.5);\n    const dC = scenePass.getLinearDepthNode('depth').r;\n    const nC = nrmTex.sample(warp).xyz;\n    let edgeD = float(0), edgeN = float(0);\n    for (const [ox, oy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {\n      const u = warp.add(vec2(ox, oy).mul(px));\n      const n = nrmTex.sample(u).xyz;\n      edgeN = edgeN.add(float(1).sub(dot(n, nC).clamp(0, 1)));\n      const dd = depthNode.sample(u).r.sub(depthNode.sample(warp).r).abs();\n      edgeD = edgeD.add(dd);\n    }\n    return smoothstep(0.35, 0.7, edgeN).max(smoothstep(0.0006, 0.002, edgeD));\n  })();\n  const graded = Fn(() => {\n    const c = colTex.sample(warp).rgb;\n    const lum = luminance(c);\n    const p = screenUV.mul(screenSize);\n    // Hatching: two line sets fade in below luminance thresholds\n    const h1 = step(fract(p.x.add(p.y).mul(0.11)), 0.22).mul(smoothstep(0.42, 0.25, lum));\n    const h2 = step(fract(p.x.sub(p.y).mul(0.11)), 0.22).mul(smoothstep(0.24, 0.1, lum));\n    const hatch = max(h1, h2).mul(hatchAmt).mul(0.55);\n    const grain = hash(p.mul(0.5).add(time.mul(3).floor())).sub(0.5).mul(grainAmt);\n    const paper = vec3(1.0, 0.965, 0.89);\n    const inked = c.mul(float(1).sub(hatch)).mul(float(1).sub(ink.mul(inkAmt).mul(0.92))).mul(paper).add(grain);\n    return vec4(inked, 1);\n  })();\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = graded;\n  window.__post = post;\n  mark('built');\n\n  // Simple physics world to prove the bundle\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 });\n  const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 5, 0));\n  world.createCollider(RAPIER.ColliderDesc.ball(0.5), b);\n\n  await post.renderAsync(); mark('firstFrame');\n\n  // Start a fire scar so burn texture shows\n  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) { const d = Math.hypot(x - 22, y - 30); burnData[(y * N + x) * 4] = d < 9 ? 255 : 0; }\n  burnTex.needsUpdate = true;\n\n  let frames = 0; const c0 = performance.now(); let lastT = c0;\n  window.__state = () => ({ backend: window.__backend, marks, frames, fps: frames / ((performance.now() - c0) / 1000), physY: b.translation().y, canvas: [renderer.domElement.width, renderer.domElement.height], log: window.__log });\n  window.__capture = async () => {\n    // Render, then read the canvas in the same task.\n    await post.renderAsync();\n    return renderer.domElement.toDataURL('image/png');\n  };\n  window.__setFever = (v) => { fever.value = v; };\n  const loop = async () => {\n    const now = performance.now(); const dt = Math.min(0.1, (now - lastT) / 1000); lastT = now;\n    mixer.update(dt); world.step(); await post.renderAsync(); frames++;\n    if (!window.__stop) requestAnimationFrame(loop);\n  };\n  window.__loaded = true;\n  if (window.AIHub && AIHub.active && AIHub.server) { /* no picture on a server */ }\n  if (params.get('noloop') !== '1') requestAnimationFrame(loop);\n  if (window.AIHub && AIHub.active) hubGo();\n}\n\n// A minimal shared-world client: enough to pass the harness.\nlet hub = null;\nasync function hubBoot() {\n  mark('hubBoot');\n  hub = await AIHub.connect({ mode: 'shared-world', seats: [1, 4] });\n  mark('hubConnected');\n}\nfunction hubGo() {\n  if (!hub) return;\n  AIHub.ready(); mark('hubReady');\n  AIHub.on('time-up', () => { if (hub.isHost) doFinish(); });\n  AIHub.on('leave', () => {});\n  AIHub.on('end', () => { window.__stop = true; });\n  AIHub.on('message', () => {});\n  setInterval(() => {\n    if (AIHub.time() < 0) return;\n    if (hub.isHost) AIHub.send({ t: 's', at: Math.round(AIHub.time()) }, { reliable: false });\n    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()) }, { to: hub.host, reliable: false });\n  }, 100);\n  function doFinish() { AIHub.finish({ standings: [AIHub.players.map((p) => p.id)], won: true }); }\n}\n\nmain().catch((e) => { window.__error = String(e && e.stack || e); console.error(e); });\n"}}}
