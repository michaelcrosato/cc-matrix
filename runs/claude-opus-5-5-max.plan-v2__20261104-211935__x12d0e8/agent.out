\n                        print('   x', c['name'], '--', c['detail'][:200])\n            frames = pg.evaluate(\"\"\"[...document.querySelectorAll('iframe')].map(f => { try { const w = f.contentWindow; return {backend: w.__backend, marks: w.__state && w.__state().marks, frames: w.__state && w.__state().frames, err: w.__error||null}; } catch (e) { return String(e);} })\"\"\")\n            print('   copies', json.dumps(frames)[:600])\n            b.close()\nfinally:\n    srv.terminate()\n    srv.wait(timeout=5)\nEOF\ntimeout 590 python3 src/hubrun.py $PWD 2>&1 | cut -c1-700","description":"Run the hub harness against the WebGPU skeleton","timeout":595000}}}
