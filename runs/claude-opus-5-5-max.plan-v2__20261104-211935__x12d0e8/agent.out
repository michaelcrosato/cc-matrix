ts\nworld.d.ts\n32:    debugRenderPipeline: DebugRenderPipeline;\n49:     * the state when `.takeSnapshot()` is called.\n51:    takeSnapshot(): Uint8Array;\n65:    debugRender(filterFlags?: QueryFilterFlags, filterPredicate?: (collider: Collider) => boolean): DebugRenderBuffers;\n174:    createCharacterController(offset: number): KinematicCharacterController;\n210:    createVehicleController(chassis: RigidBody): DynamicRayCastVehicleController;\n330:    castRay(ray: Ray, maxToi: number, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExclud\n343:    castRayAndGetNormal(ray: Ray, maxToi: number, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, \n357:    intersectionsWithRay(ray: Ray, maxToi: number, solid: boolean, callback: (intersect: RayColliderIntersection) => boolean, filterFlags?: QueryFilterFlags, filterGr\n380:    projectPoint(point: Vector, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExcludeRigid\n388:    projectPointAndGetFeature(point: Vector, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExcludeRigidBod\n398:    intersectionsWithPoint(point: Vector, callback: (handle: Collider) => boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeColl\n418:    castShape(shapePos: Vector, shapeRot: Rotation, shapeVel: Vector, shape: Shape, targetDistance: number, maxToi: number, stopAtPenetration: boolean, filterFlags?: \n429:    intersectionsWithShape(shapePos: Vector, shapeRot: Rotation, shape: Shape, callback: (collider: Collider) => boolean, filterFlags?: QueryFilterFlags, filterGroups\n417:     * If this collider has a heightfield shape, this returns the heights buffer of\n418:     * the heightfield.\n421:    heightfieldHeights(): Float32Array;\n423:     * If this collider has a heightfield shape, this returns the scale\n426:    heightfieldScale(): Vector;\n428:     * If this collider has a heightfield shape, this returns the number of\n431:    heightfieldNRows(): number;\n433:     * If this collider has a heightfield shape, this returns the number of\n436:    heightfieldNCols(): number;\n659:     * Creates a new collider descriptor with a heightfield shape.\n/**\n * Initializes RAPIER.\n * Has to be called and awaited before using any library methods.\n */\nexport declare function init(): Promise<void>;\nusing deprecated parameters for the initialization function; pass a single object instead\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211935__x12d0e8/work","is_error":false}]},"parent_tool_use_id":null,"session_id":"c0178d0d-15a3-488a-af93-32cb0d078d37","uuid":"efd79f4d-0e66-4357-97c8-a5601cd630f1","timestamp":"2026-11-05T04:28:00.192Z","tool_use_result":{"stdout":"--- tsl names\nmrt                          2\noutput                       2\nemissive                     2\ntransformedNormalView        2\nnormalView                   2\nviewportDepthTexture         2\nscreenUV                     2\nscreenSize                   2\nuniform                      2\nattribute                    2\ninstanceIndex                2\nstorage                      2\nhash                         2\ntime                         2\ndFdx                         2\nfwidth                       2\ntoonOutlinePass              2\npass                         2\nperspectiveDepthToViewZ      2\nlinearDepth                  2\ndepth                        2\ntexture                      2\n\n82:\t\tconst sobel = Fn( () => {\n158:export default SobelOperatorNode;\n168:export const sobel = ( node ) => nodeObject( new SobelOperatorNode( convertToTexture( node ) ) );\n735:export default OutlineNode;\n751:export const outline = ( scene, camera, params ) => nodeObject( new OutlineNode( scene, camera, params ) );\n--- rapier\n@dimforge/rapier3d-compat/control:\ncharacter_controller.d.ts\nindex.d.ts\npid_controller.d.ts\nray_cast_vehicle_controller.d.ts\n\n@dimforge/rapier3d-compat/dynamics:\nccd_solver.d.ts\ncoefficient_combine_rule.d.ts\nimpulse_joint.d.ts\nimpulse_joint_set.d.ts\nindex.d.ts\nintegration_parameters.d.ts\nisland_manager.d.ts\nmultibody_joint.d.ts\nmultibody_joint_set.d.ts\nrigid_body.d.ts\nrigid_body_set.d.ts\n\n@dimforge/rapier3d-compat/geometry:\nbroad_phase.d.ts\ncollider.d.ts\ncollider_set.d.ts\ncontact.d.ts\nfeature.d.ts\nindex.d.ts\ninteraction_groups.d.ts\nnarrow_phase.d.ts\npoint.d.ts\nray.d.ts\nshape.d.ts\ntoi.d.ts\n\n@dimforge/rapier3d-compat/pipeline:\ndebug_render_pipeline.d.ts\nevent_queue.d.ts\nindex.d.ts\nphysics_hooks.d.ts\nphysics_pipeline.d.ts\nquery_pipeline.d.ts\nserialization_pipeline.d.ts\nworld.d.ts\n32:    debugRenderPipeline: DebugRenderPipeline;\n49:     * the state when `.takeSnapshot()` is called.\n51:    takeSnapshot(): Uint8Array;\n65:    debugRender(filterFlags?: QueryFilterFlags, filterPredicate?: (collider: Collider) => boolean): DebugRenderBuffers;\n174:    createCharacterController(offset: number): KinematicCharacterController;\n210:    createVehicleController(chassis: RigidBody): DynamicRayCastVehicleController;\n330:    castRay(ray: Ray, maxToi: number, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExclud\n343:    castRayAndGetNormal(ray: Ray, maxToi: number, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, \n357:    intersectionsWithRay(ray: Ray, maxToi: number, solid: boolean, callback: (intersect: RayColliderIntersection) => boolean, filterFlags?: QueryFilterFlags, filterGr\n380:    projectPoint(point: Vector, solid: boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExcludeRigid\n388:    projectPointAndGetFeature(point: Vector, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeCollider?: Collider, filterExcludeRigidBod\n398:    intersectionsWithPoint(point: Vector, callback: (handle: Collider) => boolean, filterFlags?: QueryFilterFlags, filterGroups?: InteractionGroups, filterExcludeColl\n418:    castShape(shapePos: Vector, shapeRot: Rotation, shapeVel: Vector, shape: Shape, targetDistance: number, maxToi: number, stopAtPenetration: boolean, filterFlags?: \n429:    intersectionsWithShape(shapePos: Vector, shapeRot: Rotation, shape: Shape, callback: (collider: Collider) => boolean, filterFlags?: QueryFilterFlags, filterGroups\n417:     * If this collider has a heightfield shape, this returns the heights buffer of\n418:     * the heightfield.\n421:    heightfieldHeights(): Float32Array;\n423:     * If this collider has a heightfield shape, this returns the scale\n426:    heightfieldScale(): Vector;\n428:     * If this collider has a heightfield shape, this returns the number of\n431:    heightfieldNRows(): number;\n433:     * If this collider has a heightfield shape, this returns the number of\n436:    heightfieldNCols(): number;\n659:     * Creates a new collider descriptor with a heightfield shape.\n/**\n * Initializes RAPIER.\n * Has to be called and awaited before using any library methods.\n */\nexport declare function init(): Promise<void>;\nusing deprecated parameters for the initialization function; pass a single object instead","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211935__x12d0e8/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LsBGEMZAa4csTzcxZbuJ3Z","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
