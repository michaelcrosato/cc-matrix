a.spherical({ x: 0, y: -0.3, z: 0 }, { x: 0, y: 0.3, z: 0 }), b, c, true);\nfor (let i = 0; i < 120; i++) world.step();\nconsole.log('ragdoll settled near ground', (a.translation().y - groundAt(-100, -100)).toFixed(2));\n\n// Stress: 200 kinematic capsule characters + 200 dynamic boxes against the heightfield.\nconst crowd = [];\nfor (let i = 0; i < 200; i++) {\n  const x = (i % 20) * 6 - 300, z = Math.floor(i / 20) * 6 + 300;\n  const rb = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, groundAt(x, z) + 1.2, z));\n  crowd.push([rb, world.createCollider(RAPIER.ColliderDesc.capsule(0.6, 0.35), rb)]);\n  const db = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x + 2, groundAt(x, z) + 3, z));\n  world.createCollider(RAPIER.ColliderDesc.cuboid(0.4, 0.4, 0.4), db);\n}\nworld.step();\nt0 = performance.now();\nconst N = 600;\nfor (let i = 0; i < N; i++) {\n  for (const [rb, col] of crowd) {\n    cc.computeColliderMovement(col, { x: 0.05, y: -0.16, z: 0 });\n    const m = cc.computedMovement(), q = rb.translation();\n    rb.setNextKinematicTranslation({ x: q.x + m.x, y: q.y + m.y, z: q.z + m.z });\n  }\n  world.step();\n}\nconsole.log(`200 KCC + 200 dynamic: ${(N / ((performance.now() - t0) / 1000)).toFixed(0)} steps/s (x${(N / ((performance.now() - t0) / 1000) / 60).toFixed(1)} realtime)`);\n\n// Determinism + snapshot.\nconst snap = world.takeSnapshot();\nconsole.log('snapshot bytes', snap.length);\nconst w2 = RAPIER.World.restoreSnapshot(snap);\nfor (let i = 0; i < 60; i++) { world.step(); w2.step(); }\nconst pa = world.bodies.getAll().map((b) => b.translation().y).reduce((s, v) => s + v, 0);\nconst pb = w2.bodies.getAll().map((b) => b.translation().y).reduce((s, v) => s + v, 0);\nconsole.log('snapshot replays identical', pa === pb, pa, pb);\nconsole.log('debugRender verts', world.debugRender().vertices.length / 3);\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"tool