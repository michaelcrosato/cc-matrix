{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FPaChgqFV5Kte8iLawex4J","type":"tool_result","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n\n  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n  current = state;\n  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n\n  state.coordinator = createRound({\n    round,\n    players,\n    hostKey: 'p0',\n    serverKey: serverMode ? 'server' : null,\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n\n/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nfunction tickCard(state) {\n  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\n  for (const cell of state.cells) {\n    if (cell.gone || !cell.bridge.showsCard) continue;\n    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\n    if (cell.cardSent === id) continue;\n    cell.cardSent = id;\n    cell.bridge.card(card);\n  }\n}\n\n/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\nfunction answerCard(state, cell, what) {\n  if (state !== current || state.coordinator.released || cell.server) return;\n  const { ready, more } = state.answers;\n  if (what === 'ready') {\n    ready.add(cell.key);\n    more.delete(cell.key);\n  } else if (more.has(cell.key)) {\n    more.delete(cell.key);\n  } else {\n    more.add(cell.key);\n    ready.delete(cell.key);\n    state.splashUntil += 10_000;\n  }\n  log(`${cell.key} answers ${what} on the game's card`);\n  const players = state.cells.filter((c) => !c.server && !c.gone);\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n  tickCard(state);\n}\n\nfunction endCurrent() {\n  if (!current) return;\n  current.coordinator.abort('session-ended');\n  for (const cell of current.cells) removeCell(cell, false);\n  current.hubEnd.close();\n  current = null;\n}\n\nfunction removeCell(cell, tellRound = true) {\n  if (cell.gone) return;\n  cell.gone = true;\n  cell.detach();\n  cell.endpoint.close();\n  cell.frame.remove();\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n    if (p.out) bits.push(`out: ${p.out}`);\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n    else if (p.ready) bits.push('ready');\n    else if (p.hello) bits.push('welcomed');\n    else bits.push('loading');\n    const last = cell.progress.at(-1);\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n  }\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n  if (state.record) {\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>","is_error":false}]},"parent_tool_use_id":null,"session_id":"c0178d0d-15a3-488a-af93-32cb0d078d37","uuid":"d1e05595-c2af-4728-bc21-1f01ad99f4e1","timestamp":"2026-11-05T04:21:06.826Z","tool_use_result":{"stdout":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n\n  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n  current = state;\n  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n\n  state.coordinator = createRound({\n    round,\n    players,\n    hostKey: 'p0',\n    serverKey: serverMode ? 'server' : null,\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n\n/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nfunction tickCard(state) {\n  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\n  for (const cell of state.cells) {\n    if (cell.gone || !cell.bridge.showsCard) continue;\n    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\n    if (cell.cardSent === id) continue;\n    cell.cardSent = id;\n    cell.bridge.card(card);\n  }\n}\n\n/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\nfunction answerCard(state, cell, what) {\n  if (state !== current || state.coordinator.released || cell.server) return;\n  const { ready, more } = state.answers;\n  if (what === 'ready') {\n    ready.add(cell.key);\n    more.delete(cell.key);\n  } else if (more.has(cell.key)) {\n    more.delete(cell.key);\n  } else {\n    more.add(cell.key);\n    ready.delete(cell.key);\n    state.splashUntil += 10_000;\n  }\n  log(`${cell.key} answers ${what} on the game's card`);\n  const players = state.cells.filter((c) => !c.server && !c.gone);\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n  tickCard(state);\n}\n\nfunction endCurrent() {\n  if (!current) return;\n  current.coordinator.abort('session-ended');\n  for (const cell of current.cells) removeCell(cell, false);\n  current.hubEnd.close();\n  current = null;\n}\n\nfunction removeCell(cell, tellRound = true) {\n  if (cell.gone) return;\n  cell.gone = true;\n  cell.detach();\n  cell.endpoint.close();\n  cell.frame.remove();\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n    if (p.out) bits.push(`out: ${p.out}`);\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n    else if (p.ready) bits.push('ready');\n    else if (p.hello) bits.push('welcomed');\n    else bits.push('loading');\n    const last = cell.progress.at(-1);\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n  }\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n  if (state.record) {\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FPaChgqFV5Kte8iLawex4J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
