n picks startup, active, recovery or max reach; left/right change it; start copies the JSON\n    const T0 = this.cur(); this.fld = this.fld || 0;\n    if (I.repeat('up', .4, .15)) this.fld = (this.fld + 3) % 4; if (I.repeat('down', .4, .15)) this.fld = (this.fld + 1) % 4;\n    const dx = I.repeat('left', .35, .08) ? -1 : I.repeat('right', .35, .08) ? 1 : 0;\n    if (dx) { if (this.fld < 3) T0.f[this.fld] = Math.max(1, T0.f[this.fld] + dx); else T0.reach[1] = Math.max(T0.reach[0] + 1, T0.reach[1] + dx); T0._spec = null; this.gaps[T0.id] = undefined; this.play(); }\n    if (I.pressed('start')) { try { navigator.clipboard.writeText(JSON.stringify({ id: T0.id, f: T0.f, reach: T0.reach, pts: T0.pts, travel: T0.travel })); this.note = 'COPIED JSON'; } catch (e) { this.note = 'CLIPBOARD BLOCKED'; } }\"\"\")\ns=s.replace(\"KC.text(g, 'POINTS ' + t.pts.join('-') + (t.full ? '  FULL' : '  HALF'), 12, 57, '#ffe8a0');\",\"KC.text(g, 'POINTS ' + t.pts.join('-') + (t.full ? '  FULL' : '  HALF') + '   EDIT: ' + ['STARTUP', 'ACTIVE', 'RECOVERY', 'MAX REACH'][this.fld || 0] + ' (UP/DOWN, LEFT/RIGHT)  START = COPY JSON ' + (this.note || ''), 12, 57, '#ffe8a0');\")\nopen(p,'w').write(s)\nEOF\ncat >> tests/lab.test.mjs <<'EOF'\nEOF\npython3 - <<'EOF'\np='tests/lab.test.mjs'\ns=open(p).read()\ns=s.replace(\"  game.go('fight'\",\"  { game.go('lab', { id: 'frontKick' }, { fade: 0 }); game.advance(.5); const T0 = KC.TECHS.frontKick, r0 = T0.reach[1]; game.input.tap('right'); game.advance(.1); game.scene.fld = 3; game.input.tap('right'); game.advance(.2); t.check('lab slider changes the technique live', T0.reach[1] === r0 + 1, T0.reach[1]); T0.reach[1] = r0; }\\n  game.go('fight'\")\nopen(p,'w').write(s)\nEOF\nnode tests/run.mjs 2>&1 | tail -3","timeout":1200000}},"wire_ingest_context":{"toolu_01C6gS5Y7oZLSbLYvsQDE6wB":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-184016__x1295cd/work/KarateChampon-KarateChamp1984-claude-sonnet-5-5-medium-20261103-184016"}}