 for (let i = 0; i < 120; i++) tick(S, 16.67, 1); t.check('after end nothing is sent', S.games.every((G, i) => (G.hub.sentAfterEnd || 0) === before[i] || (G.hub.sentAfterEnd || 0) === 0), S.games.map(G => G.hub.sentAfterEnd).join()); t.check('after end the game shows ROUND OVER and music stops', S.games.every(G => G.KC.net.ended && !G.game.audio.song)); }\n  t.check('no engine errors in any copy', S.games.every(G => G.game.errors.length === 0), S.games.map(G => G.game.errors.slice(0, 2).map(e => e.message).join('|')).join(' // '));\n  // time-up: the host finishes inside the grace with valid standings\n  { const T2 = await session({ roles: ['host', 'guest'], latency: 20 }); await new Promise(r => setTimeout(r, 20)); const [h] = T2.games; tick(T2, 16.67, 10); T2.bus.startAt = 0; T2.bus.now = -3000; for (const G of T2.games) G.hub.emit('start', { in: 3000 }); tick(T2, 16.67, 300); for (const G of T2.games) G.hub.emit('time-up', { graceMs: 3000 }); tick(T2, 16.67, 10); t.check('time-up: the host calls finish with standings, scores and stats', !!T2.bus.finished && T2.bus.finished.standings.flat().length === 2 && T2.bus.finished.scores && T2.bus.finished.stats, JSON.stringify(T2.bus.finished)); }\n  // the server role: a host with no player runs the world and still sends\n  { const T3 = await session({ roles: ['server', 'guest', 'guest'], latency: 20 }); await new Promise(r => setTimeout(r, 20)); tick(T3, 16.67, 10); T3.bus.startAt = 0; T3.bus.now = -3000; for (const G of T3.games) G.hub.emit('start', { in: 3000 }); tick(T3, 16.67, 400); const sv = T3.games[0]; t.check('the server runs the world with no local player', sv.KC.net.server && !!sv.KC.net.world && !!sv.KC.net.bout); t.check('the server sends snapshots', sv.hub.sent.length > 20, sv.hub.sent.length); t.check('guests send heartbeats to the server', T3.games[1].hub.sent.length > 5); }\n  // outside a session the title appears\n  { const { loadGame } = await import('./lib/load.mjs'); const G = loadGame(); G.game.advance(.5); t.check('with AIHub inactive the game runs normally (title)', G.game.scene.name === 'title'); }\n};\nEOF\nnode tests/run.mjs --only online 2>&1 | head -30","timeout":400000}},"wire_ingest_context":{"toolu_011uBngEtri7ZHMV3uSDJ4Wk":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-184016__x1295cd/work/KarateChampon-KarateChamp1984-claude-sonnet-5-5-medium-20261103-184016"}}}
