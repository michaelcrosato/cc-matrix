'#ffb347', '#e0662a'], depth: 3 }); E.font.title(g, 'CHAMPON', r.W / 2, 50, { scale: 4, align: 'center', colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 }); }); }\n    r.overlay(g => { if (Math.floor(KC.game.real * 1.6) % 2 === 0 || true) KC.text(g, 'DEMO - PRESS ' + (KC.family() === 'key' ? 'ENTER' : 'START'), r.W / 2, r.H - 14, Math.floor(KC.game.real * 2) % 2 ? '#ffd060' : '#fff6e8', { align: 'center', scale: 1 }); });\n  }\n};\nEOF\nnode --check src/51-attract.js && node tools/build.mjs | tail -1"}},"wire_ingest_context":{"toolu_01V5fvMKbDAu5F4kbM7JM4Fj":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-184016__x1295cd/work/KarateChampon-KarateChamp1984-claude-sonnet-5-5-medium-20261103-184016"}}}
