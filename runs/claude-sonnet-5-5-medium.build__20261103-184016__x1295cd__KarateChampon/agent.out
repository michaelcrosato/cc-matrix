 s + 3 }); b.ctrl = [null, (m, f, bo) => ai.intent(m, f, bo)]; b.f[0].x = 150; b.f[1].x = 150 + 18 + 30; b.f[0].frozen = b.f[1].frozen = false; run(b, 30); b.f[0].start('frontSweep', b.f[1], 'n', 'd'); let did = false; for (let i = 0; i < 90 && !b.pending; i++) { b.update(1 / 120); const t2 = b.f[1].tech; if (t2 && ['jump', 'jumpSide', 'frontFlip', 'backFlip', 'jumpBack', 'backRoll'].includes(t2.id)) did = true; } if (did) jumped++; } t.check(`L8 answers a sweep with a jump or flip in at least 50% (${jumped}/${N})`, jumped >= N * .5); }\n  // showcase mode cycles through all 15 scoring techniques inside one exhibition\n  { const ais = [new KarateAI({ id: 'taro', mode: 'showcase', seed: 1 }), new KarateAI({ id: 'ebi', mode: 'showcase', seed: 2, start: 7 })]; const b = new Bout({ ids: ['taro', 'ebi'], seed: 1, ctrl: ais.map(a => (m, f, bo) => a.intent(m, f, bo)), single: true }); b.start(); b.invincible = [true, true]; b.infiniteTime = true; const seen = new Set();\n    for (let i = 0; i < 120 * 600; i++) { b.update(1 / 120); for (const f of b.f) if (f.tech && f.t === 1) seen.add(f.tech.id); } const miss = KC.SCORING.filter(x => !seen.has(x.id)).map(x => x.id); t.check('showcase mode throws all 15 techniques (missing: ' + miss.join() + ')', miss.length === 0); }\n};\nEOF\nnode tests/run.mjs --only ai 2>&1 | head -20","is_backgrounded":false,"task_type":"local_bash","uuid":"80c4e7b3-d655-4b75-8712-76215150d43b","session_id":"92d1ba00-1a0f-4edd-bbd5-53c74c3ffc62"}
