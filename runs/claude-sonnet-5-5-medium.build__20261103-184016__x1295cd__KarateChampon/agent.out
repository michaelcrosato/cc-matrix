, seed: 2 }, { fade: 0 }), s); await page.waitForTimeout(5500);\n    const r = await page.evaluate(() => { const g = My3D2dge.current, d = g.screen.buf.getContext('2d').getImageData(0, 0, g.screen.W, g.screen.H).data, m = new Map(); for (let i = 0; i < d.length; i += 16) { const k = (d[i] >> 3) << 10 | (d[i + 1] >> 3) << 5 | (d[i + 2] >> 3); m.set(k, (m.get(k) || 0) + 1); } let top = 0, n = 0; for (const v of m.values()) { top = Math.max(top, v); n += v; } return { view: g.view.id, filled: 1 - top / n, phase: KC.current.bout.phase }; });\n    t.check(`Tatami 2.5D draws ${s} in the pitched view`, r.view === 'brawler' && r.filled > .3, JSON.stringify(r)); if (['harbor', 'ship', 'fuji'].includes(s)) await page.screenshot({ path: path.join(root, 'tests/out', 'tatami_' + s + '.png') });\n  }\n  t.check('no errors in the 2.5D view', errs.length === 0, errs.slice(0, 2).join('|')); await b.close();\n};\nEOF\nsed -i \"s/'page', 'hub'\\]/'page', 'tatami', 'hub']/\" tests/run.mjs; node tests/run.mjs --only lab,tatami 2>&1 | tail -5","is_backgrounded":false,"task_type":"local_bash","uuid":"fa734744-4b6e-4301-b1d9-b9e38c98290d","session_id":"92d1ba00-1a0f-4edd-bbd5-53c74c3ffc62"}
