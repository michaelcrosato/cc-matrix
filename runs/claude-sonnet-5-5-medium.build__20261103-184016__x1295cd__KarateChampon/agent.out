}); lines.push({ k, w }); } let page = { title: sec.title, rows: [], n: 0 }; for (const it of lines) { const h = it.w.length + 1; if (page.n + h > 11 && page.rows.length) { out.push(page); page = { title: sec.title + ' (CONT.)', rows: [], n: 0 }; } page.rows.push(it); page.n += h; } out.push(page); }\n    return out;\n  },\n  update(dt) {\n    this.stage.update(dt); KC.game.focus(200, 0, 50); const I = KC.game.input; if (!this.P) return;\n    if (I.repeat('right', .4, .15) || I.pressed('tRight')) { this.pi = (this.pi + 1) % this.P.length; KC.sfx('menuMove'); }\n    if (I.repeat('left', .4, .15) || I.pressed('tLeft')) { this.pi = (this.pi + this.P.length - 1) % this.P.length; KC.sfx('menuMove'); }\n    const c = I.clicked(); if (c) { this.pi = c[0] > this.W2 / 2 ? (this.pi + 1) % this.P.length : (this.pi + this.P.length - 1) % this.P.length; KC.sfx('menuMove'); }\n    if (I.pressed('cancel') || I.pressed('start')) { I.consumeAll(); KC.sfx('menuBack'); KC.game.go('title', { menu: true }); }\n  },\n  draw(r) {\n    this.W2 = r.W; if (!this.P) this.P = this.pages(r); backDrop(r, this); const pg = this.P[this.pi];\n    r.overlay(g => {\n      KC.panel(g, 10, 8, r.W - 20, r.H - 40, { alpha: .85 }); KC.title(g, pg.title, r.W / 2, 14, 1);\n      let y = 32; for (const row of pg.rows) { KC.text(g, row.k, 22, y, '#ffd060'); y += 10; for (const ln of row.w) { KC.text(g, ln, 28, y, '#e8e0ff'); y += 9; } y += 2; }\n      KC.text(g, 'PAGE ' + (this.pi + 1) + '/' + this.P.length + '   ◂ ▸', r.W / 2, r.H - 46, '#cfc8e8', { align: 'center' });\n    });\n    KC.promptBar(r, [['cancel', 'BACK']]);\n  }\n});\n/* ---- the move list: one posture at a time, around a big R-stick icon ---- */\nsimpleScene('moveList', {\n  enter(d) { this.d = d || {}; this.stage = new Stage('dojo'); this.stage.d = Object.assign({}, this.stage.d, { ambient: .4 }); this.post = 0; this.sel = 't'; this.me = new Karateka('taro', 0, {}); this.dum = new Karateka('negi', 1, {}); this.postures = ['n', 't', 'a', 'u', 'd']; this.t = 0; this.play = null; KC.game.follow(null); KC.current = this; this.rd = new Reader(KC.game.input); KC.music('practice'); },\n  update(dt) {\n    this.t += dt; this.stage.update(dt); KC.game.focus(200, 0, 50); const I = KC.game.input;\n    if (I.repeat('up', .4, .15)) { this.post = (this.post + 4) % 5; KC.sfx('menuMove'); } if (I.repeat('down', .4, .15)) { this.post = (this.post + 1) % 5; KC.sfx('menuMove'); }\n    const R = this.rd.read(); if (R.tech) { this.sel = ({ u: 'u', d: 'd', l: 'a', r: 't' })[R.tech]; this.preview(); }\n    const c = I.clicked(); if (c && this.hot) for (const h of this.hot) if (Math.hypot(c[0] - h.x, c[1] - h.y) < 14) { this.sel = h.s; this.preview(); }\n    if (c && this.rows) this.rows.forEach((x, i) => { if (Math.abs(c[1] - x.y) < 8 && c[0] < 120) { this.post = i; KC.sfx('menuMove'); } });\n    if (I.pressed('cancel') || I.pressed('start')) { I.consumeAll(); KC.sfx('menuBack'); KC.game.go(this.d.back && KC.registered[this.d.back] ? this.d.back : 'title', this.d.back === 'title' || !this.d.back ? { menu: true } : undefined); }\n    // run the preview: the live rig plays the technique against a dummy\n    this.me.x = 150; this.dum.x = 150 + PUSH + 28; this.me.frozen = false;\n    if (this.play) { this.play--; this.me.step(this.dum, null); if (!this.me.tech) this.play = 0; }\n    this.me.update(dt, this.dum); this.dum.update(dt, this.me);\n  },\n  preview() { const id = KC.MATRIX[this.postures[this.post] + this.sel]; if (!id) return; KC.sfx('menuMove'); this.me.reset(); this.dum.reset(); this.me.x = 150; this.dum.x = 150 + PUSH + 30; this.me.start(id, this.dum, 'n', null); this.play = 600; },\n  draw(r) {\n    backDrop(r, this); const P = this.postures[this.post], id = KC.MATRIX[P + this.sel], t = KC.TECHS[id];\n    r.actor(150, 0, 0, (g, ox, oy) => this.me.rig.draw(g, ox, oy, r.view)); r.actor(this.dum.x, 0, 0, (g, ox, oy) => this.dum.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      const W = r.W, H = r.H; KC.title(g, 'MOVE LIST', W / 2, 6, 2);\n      const names = { n: 'STAND', t: 'STEP IN', a: 'STEP BACK', u: 'JUMP', d: 'CROUCH' }; this.rows = [];\n      this.postures.forEach((p, i) => { const y = 36 + i * 22; this.rows[i] = { y: y + 6 }; if (i === this.post) { px.rect(g, 6, y - 3, 130, 19, '#4a2a3a'); } drawStick(g, 'L', p === 'n' ? null : p === 't' ? 'r' : p === 'a' ? 'l' : p, 10, y, 13); KC.text(g, names[p], 34, y + 2, i === this.post ? '#ffd060' : '#cfc8e8'); });\n      const cx = W - 90, cy = 90; this.hot = []; px.disc(g, cx, cy, 14, '#10101c'); px.disc(g, cx, cy, 12, '#3a3a52'); E.font.text(g, 'R', cx, cy - 3, '#ff9a6a', { align: 'center', outline: false });\n      const dirs = [['u', 0, -34], ['t', 46, 0], ['d', 0, 34], ['a', -46, 0]];\n      for (const [s, dx, dy] of dirs) { const tid = KC.MATRIX[P + s], tt = KC.TECHS[tid]; this.hot.push({ x: cx + dx, y: cy + dy, s }); px.rect(g, cx + dx - 34 + (dx < 0 ? -16 : dx > 0 ? 16 : 0) * 0, cy + dy - 6, 68, 12, s === this.sel ? '#8a3a1a' : '#201830'); KC.text(g, tt ? tt.name.replace('LUNGE ', '').slice(0, 17) : '-', cx + dx, cy + dy - 3, tt ? (s === this.sel ? '#fff6d0' : '#cfc8e8') : '#5a5478', { align: 'center' }); }\n      if (t) { KC.panel(g, 6, H - 76, W - 12, 34, { alpha: .8 }); KC.text(g, t.name + '  (' + t.jp + ')', 12, H - 72, '#ffd060'); KC.text(g, 'POINTS ' + t.pts.join('-') + (t.full ? '   ★ FULL POINT' : t.util ? '' : '   HALF POINT') + '   ' + up(t.height).replace('NONE', 'MOVE'), 12, H - 60, '#fff'); if (!t.util) KC.text(g, 'REACH ' + t.reach.join('-') + '  FRAMES ' + t.f.join('/') + (t.unblockable ? '  UNBLOCKABLE' : ''), 12, H - 49, '#9ad8ff'); }\n    });\n    r.overlay(g => { KC.glyphTech(g, id || 'frontKick', 10, r.H - 30, {}); }); KC.promptBar(r, [['cancel', 'BACK']]);\n  }\n});\nEOF\nnode --check src/55-scene-misc.js && node tools/build.mjs | tail -1"}},"wire_ingest_context":{"toolu_01MKL4VQ6ypXuo8fCtDphSa7":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-184016__x1295cd/wo