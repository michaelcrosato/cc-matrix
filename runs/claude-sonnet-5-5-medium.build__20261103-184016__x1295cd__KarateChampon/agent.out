tline: false });\n      const cur = this.items[this.i], sub = cur && (typeof cur.sub === 'function' ? cur.sub() : cur.sub); if (sub) E.font.text(g, sub, r.W / 2, Math.round(y + vis * lh + (top + vis < n ? 10 : 4)), '#ffd8a0', { align: 'center', shadow: '#000', outline: false });\n    });\n  }\n}\n\"\"\"\ns=s[:a]+new+s[b:]\nopen(p,'w').write(s)\n# prompt bar measure\np='src/10-input.js'\ns=open(p).read()\ns=s.replace(\"KC.glyphAction = (g, act, x, y, size = 13) => {\\n  const I = KC.game.input, fam = KC.family(I);\",\"KC.glyphAction = (g, act, x, y, size = 13, measure = false) => {\\n  const I = KC.game.input, fam = KC.family(I);\\n  if (measure) { if (fam === 'ps' || fam === 'xbox') return act === 'start' || act === 'pause' ? E.font.width('OPT') + 8 : size + 2; if (fam === 'mouse' && (act === 'confirm' || act === 'cancel')) return 12; const lab0 = { confirm: 'ENTER', cancel: 'ESC', start: 'ENTER', pause: 'ESC', alt: 'T' }[act] || I.label(act) || '?'; return Math.max(size - 2, E.font.width(lab0) + 6) + 2; }\")\ns=s.replace(\"const parts = items.map(([act, label]) => ({ act, label, w: 15 + E.font.width(label) + 8 }));\",\"const parts = items.map(([act, label]) => ({ act, label, w: KC.glyphAction(null, act, 0, 0, 13, true) + 2 + E.font.width(label) + 10 }));\")\nopen(p,'w').write(s)\np='src/00-core.js'\ns=open(p).read()\ns=s.replace(\"crowd: { n: 10, palette: ['#f2eee4'], seiza: true }\",\"crowd: { n: 8, palette: ['#f2eee4'], seiza: true, noSil: true }\")\nopen(p,'w').write(s)\np='src/35-stage.js'\ns=open(p).read()\ns=s.replace(\"    this.crowd = []; const cr = this.d.crowd || { n: 0 };\\n    for (let i = 0; i < (cr.n || 0); i++)\",\"    this.crowd = []; const cr = this.d.crowd || { n: 0 };\\n    for (let i = 0; i < (cr.noSil ? 0 : cr.n || 0); i++)\")\nopen(p,'w').write(s)\np='src/50-scene-title.js'\ns=open(p).read()\ns=s.replace(\"this.menu = new Menu(items, { y: r => Math.round(r.H * .46), scale: 2, onCancel\",\"this.menu = new Menu(items, { y: r => Math.round(r.H * 