{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"sed -n '2877,2902p' vendor/engine-repo/dist/handoff/my-3d2dge.js && sed -n '401,412p' vendor/hub-repo/lib/hub/harness.html\"","aggregated_output":"   * number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or\n   * 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each\n   * scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n   */\n  go(name, data, o = {}) {\n    if (this._booting) { this._bootGo = { name, data }; return; }   // (a boot step's go: that scene, when the boot ends)\n    if (!this.scenes) { warn('go:noscenes', 'game.go() needs game.start({ scenes: {...}, scene }) first'); return; }\n    if (!this.scenes[name]) { warn('go:' + name, 'game.go(\"' + name + '\"): no such scene. Scenes: ' + Object.keys(this.scenes).join(', ')); return; }\n    let fade = o.fade === undefined ? this.fadeTime : o.fade, kind = null;\n    if (typeof fade === 'string') {\n      kind = fade; fade = o.seconds === undefined ? .4 : +o.seconds || 0;\n      if (kind !== 'black' && kind !== 'white' && !FADES[kind]) warn('fade:' + kind, 'game.go: no transition \"' + kind + '\" here (black, white, wipe, iris, mosaic, swirl, dissolve; a kit may leave them out: the full engine has them): a fade through black');\n    }\n    if (fade > 0 && this.scene) this._fade = { t: 0, dur: fade, name, data, out: true, kind, at: o.at };\n    else { this._fade = null; this._next = { name, data }; }\n  }\n  _fadeStep(dt) {\n    const f = this._fade; f.t += dt;\n    if (f.out && f.t >= f.dur) { f.out = false; f.t = 0; this._enter(f.name, f.data); }\n    else if (!f.out && f.t >= f.dur) this._fade = null;\n  }\n  _fadeLevel() { const f = this._fade; return f ? clamp(f.out ? f.t / f.dur : 1 - f.t / f.dur, 0, 1) : 0; }\n  _enter(name, data) {\n    const s = this.scenes[name];\n    if (!s) throw new Error('scene \"' + name + '\" does not exist. Scenes: ' + Object.keys(this.scenes).join(', '));\n    const old = this.scene;\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"/home/micha/.local/share/pipx/venvs/playwright/bin/python -u - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nurl=(Path.cwd()/'game.html').as_uri()+'?backend=webgl'\nwith sync_playwright() as pw:\n b=pw.chromium.launch(headless=True,args=['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader'])\n ctx=b.new_context(viewport={'width':1280,'height':720});ctx.add_init_script('window.testPads=[];navigator.getGamepads=()=>testPads;window.pad=i=>testPads[i]={id:\\\"DualSense\\\",index:i,connected:true,mapping:\\\"standard\\\",axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))};')\n p=ctx.new_page();p.goto(url);p.wait_for_function('Bomber.ready',timeout=60000);p.evaluate('__game.stop();pad(0);pad(1);Bomber.coop=true;Bomber.startSortie();__game.advance(.5)')\n snap='({mode:Bomber.mode,scene:__game.sceneName,next:__game._next,paused:__game.paused,owner:__game.pausedBy,screen:Bomber.ui.screen,focus:document.activeElement.textContent,holds:__game.players.map(i=>[i.player,Array.from(i.held),i.padPrev]),audio:Bomber.sound.inspect()})'\n p.evaluate('testPads[1].buttons[9]={pressed:true,value:1};__game.advance(.1)');print('pause',p.evaluate(snap))\n p.evaluate('testPads[1].buttons[9]={pressed:false,value:0};__game.advance(.1)');print('release',p.evaluate(snap))\n p.evaluate('testPads[1].buttons[0]={pressed:true,value:1};__game.advance(.1)');print('confirm',p.evaluate(snap))\n p.evaluate('Bomber.toTitle();__game.advance(.1);testPads=[];Bomber.startSortie();__game.advance(.1)');p.keyboard.press('e');p.evaluate('__game.advance(.2)');p.wait_for_timeout(200);print('audio',p.evaluate(snap))\n ctx.close()\n ctx=b.new_context(**pw.devices['iPhone 13']);p=ctx.new_page();p.goto(url);p.wait_for_function('Bomber.ready',timeout=60000);p.evaluate('__game.stop()');p.get_by_role('button',name='Play',exact=True).tap();p.get_by_role('button',name='Launch sortie',exact=True).tap();p.evaluate('__game.advance(.4,{draw:true})');print('phone start',p.evaluate(snap))\n p.get_by_role('button',name='Station',exact=True).tap();p.get_by_role('button',name='Bombardier',exact=True).tap();p.evaluate('__game.advance(.4,{draw:true})');print('phone station',p.evaluate(snap));print(p.locator('#html-hud').inner_html());p.screenshot(path='docs/phone-debug.png');b.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
