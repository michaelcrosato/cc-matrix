ame, design, art, animation, music, effects and gibberish voices created in code. Inspired by B-17 Bomber (Mattel Electronics, 1982), unaffiliated. my-3D2dge v0.89.1: MIT. Three.js 0.182.0: MIT. Rapier 0.19.3: Apache-2.0. AI Hub client 1.4.0: upstream notices retained in this HTML. Usage: added on import.\",\n\t\t\t],\n\t\t];\n\t\tthis.ui.show(\"about\", {\n\t\t\tkicker: \"MADE OF GEOMETRY, MATH & FOUR ENGINES\",\n\t\t\ttitle: \"About / Credits\",\n\t\t\ttext: \"B-17 Bomber Buddy • A vulnerable aircraft and the people who keep it flying.\",\n\t\t\tsections,\n\t\t\tactions: [\n\t\t\t\t[\n\t\t\t\t\t\"License texts\",\n\t\t\t\t\t() =>\n\t\t\t\t\t\tthis.ui.show(\"licenses\", {\n\t\t\t\t\t\t\ttitle: \"Open-source licenses\",\n\t\t\t\t\t\t\tsections: Object.entries(globalThis.RELEASE_LICENSES || {}),\n\t\t\t\t\t\t\tactions: [[\"Back\", () => this.ui.back()]],\n\t\t\t\t\t\t}),\n\t\t\t\t],\n\t\t\t\t[\"Back\", () => this.ui.back()],\n\t\t\t],\n\t\t});\n\t\tif (this.ui.root)\n\t\t\tfor (const p of this.ui.root.querySelectorAll(\".esh-mod p\"))\n\t\t\t\tp.style.whiteSpace = \"pre-line\";\n\t}\n","exit_code":0,"status":"completed"}}
