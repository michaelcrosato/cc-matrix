(() => door.open) */\\nE.until = fn => ({ until: fn });\\n/** a script\\'s wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b]) */\\nE.all = list => ({ all: list });\\n/** a script\\'s wait for the first of its waits to be over: yield E.any([boss.script, 30]) */\\nE.any = list => ({ any: list });\\nObject.assign(E, { Tween, Script });\\n\\n/* =============================================================================\\n * 10e. PATHS  a line through points, measured by distance along it: moving platforms, enemy dives and waves, a race\\'s\\n *    racing line and its racers\\' progress, rails, camera tracks.\\n * ============================================================================= */\\nclass Path {\\n  /**\\n   * new E.Path(points, { closed: false, smooth: null }): points [x, y, z] (z optional) or { x, y, z } (a side view\\'s\\n   * height is z); closed runs back to the first; smooth: \\'catmull\\' curves through every point (Catmull-Rom).\\n   * length: its length in world units; at(d), nearest(x, y, z), draw(r) below\\n   */\\n  constructor(points, o = {}) {\\n    const P = points.map(p => Array.isArray(p) ? [+p[0] || 0, +p[1] || 0, +p[2] || 0] : [+p.x || 0, +p.y || 0, +p.z || 0]), n = P.length;\\n    /** points: the points it was made from, [x, y, z] each; closed: it runs back to the first */\\n    this.points = P; this.closed = !!o.closed && n > 2;\\n    const at = i => P[this.closed ? ((i % n) + n) % n : clamp(i, 0, n - 1)], S = [];\\n    for (let i = 0; i < (this.closed ? n : n - 1); i++) {\\n      const a = at(i), b = at(i + 1);\\n      if (o.smooth !== \\'catmull\\') { S.push(a); continue; }\\n      const p0 = at(i - 1), p3 = at(i + 2), m = Math.max(2, Math.ceil(Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]) / 4));\\n      for (let k = 0; k < m; k++) { const t = k / m, t2 = t * t, t3 = t2 * t; S.push([0, 1, 2].map(j => .5 * (2 * a[j] + (b[j] - p0[j]) * t + (2 * p0[j] - 5 * a[j] + 4 * b[j] - p3[j]) * t2 + (3 * a[j] - p0[j] - 3 * b[j] + p3[j]) * t3))); }\\n    }\\n    S.push(this.closed ? P[0] : P[n - 1] || [0, 0, 0]);\\n    const D = [0]; for (let i = 1; i < S.length; i++) D.push(D[i - 1] + Math.hypot(S[i][0] - S[i - 1][0], S[i][1] - S[i - 1][1], S[i][2] - S[i - 1][2]));\\n    /** length: world units from end to end (round, when closed) */\\n    this.length = D[D.length - 1]; this._pts = S; this._cum = D;\\n  }\\n  /** the point d along it: { x, y, z, angle (its heading on the ground, radians: 0 east), d } (closed: d wraps round;\\n   *  open: held at the ends) */\\n  at(d) {\\n    const L = this.length, S = this._pts, D = this._cum; d = this.closed && L > 0 ? wrap(d, 0, L) : clamp(d, 0, L);\\n    let lo = 0, hi = S.length - 1; while (hi - lo > 1) { const m = (lo + hi) >> 1; if (D[m] <= d) lo = m; else hi = m; }\\n    const a = S[lo], b = S[hi] || a, u = D[hi] > D[lo] ? (d - D[lo]) / (D[hi] - D[lo]) : 0;\\n    return { x: lerp(a[0], b[0], u), y: lerp(a[1], b[1], u), z: lerp(a[2], b[2], u), angle: Math.atan2(b[1] - a[1], b[0] - a[0]), d };\\n  }\\n  /** the distance along it of its point nearest (x, y) on the ground (and z, when given): a racer\\'s progress round a\\n   *  track, a rail\\'s grab point */\\n  nearest(x, y, z) {\\n    const S = this._pts, D = this._cum, h = z !== undefined; let best = Infinity, out = 0;\\n    for (let i = 0; i + 1 < S.length; i++) {\\n      const a = S[i], b = S[i + 1], dx = b[0] - a[0], dy = b[1] - a[1], dz = h ? b[2] - a[2] : 0, l2 = dx * dx + dy * dy + dz * dz;\\n      const t = l2 > 0 ? clamp(((x - a[0]) * dx + (y - a[1]) * dy + (h ? (z - a[2]) * dz : 0)) / l2, 0, 1) : 0;\\n      const e = (a[0] + dx * t - x) ** 2 + (a[1] + dy * t - y) ** 2 + (h ? (a[2] + dz * t - z) ** 2 : 0);\\n      if (e < best) { best = e; out = D[i] + (D[i + 1] - D[i]) * t; }\\n    }\\n    return out;\\n  }\\n  /** draw it over the scene to see it (debugging): a line, and a dot at each of its points */\\n  draw(r, color = \\'#ffe070\\') {\\n    r.overlay(g => { const S = this._pts; for (let i = 0; i + 1 < S.length; i++) px.line(g, ...r.w(...S[i]), ...r.w(...S[i + 1]), color); for (const p of this.points) px.rect(g, r.w(...p)[0] - 1, r.w(...p)[1] - 1, 3, 3, \\'#ffffff\\'); });\\n  }\\n}\\nE.Path = Path;\\n\\n/* =============================================================================\\n * 10f. TRANSITIONS  the ways from one scene to the next besides a fade: game.go(name, data, { fade: \\'wipe\\' | \\'iris\\' |\\n *    \\'mosaic\\' | \\'swirl\\' | \\'dissolve\\', seconds, at }). Each is drawn over the finished picture, out of the old scene and\\n *    into the new one (k: 0 clear .. 1 covered); reduce motion makes each a plain fade.\\n * ============================================================================= */\\nObject.assign(FADES, {\\n  wipe(g, k, r, F) {   // a band sweeping left to right, its edge dithered\\n    const W = r.bw, H = r.bh, e = 8, x = Math.round(F.out ? k * (W + e) - e : (1 - k) * (W + e));\\n    if (F.out) px.rect(g, 0, 0, Math.max(0, x), H, \\'#000000\\'); else px.rect(g, x, 0, Math.max(0, W - x), H, \\'#000000\\');\\n    g.save(); g.fillStyle = g.createPattern(r._fadePattern(.5), \\'repeat\\'); g.fillRect(F.out ? x : x - e, 0, e, H); g.restore();\\n  },\\n  iris(g, k, r, F) {   // a circle closing on a point (and opening from it)\\n    const [cx, cy] = _fadeAt(r, F), W = r.bw, H = r.bh, R = (1 - k) * Math.hypot(Math.max(cx, W - cx), Math.max(cy, H - cy));\\n    px.col(g, \\'#000000\\');\\n    for (let y = 0; y < H; y++) { const dy = y + .5 - cy, hw = R > Math.abs(dy) ? Math.sqrt(R * R - dy * dy) : -1, a = Math.round(cx - hw), b = Math.round(cx + hw); if (hw < 0) g.fillRect(0, y, W, 1); else { if (a > 0) g.fillRect(0, y, a, 1); if (b < W) g.fillRect(b, y, W - b, 1); } }\\n  },\\n  mosaic(g, k, r) {   // blocks growing to 16 pixels, darkening as they go\\n    const W = r.bw, H = r.bh, b = 1 + Math.round(k * 15), tw = Math.ceil(W / b), th = Math.ceil(H / b);\\n    const t = r._mosaic || (r._mosaic = mkCanvas(8, 8)); if (t.width < tw || t.height < th) { t.width = Math.max(t.width, tw); t.height = Math.max(t.height, th); }\\n    const tg = ctx2d(t); tg.clearRect(0, 0, t.width, t.height); tg.drawImage(g.canvas, 0, 0, W, H, 0, 0, tw, th);\\n    g.save(); g.imageSmoothingEnabled = false; g.drawImage(t, 0, 0, tw, th, 0, 0, tw * b, th * b); g.fillStyle = \\'#000000\\'; g.globalAlpha = qa(k * k); g.fillRect(0, 0, W, H); g.restore();\\n  },\\n  swirl(g, k, r, F) {   // the picture twisting round a point as it darkens\\n    const W = r.bw, H = r.bh, [cx, cy] = _fadeAt(r, F), R = Math.hypot(W, H) / 2, img = g.getImageData(0, 0, W, H), src = img.data.slice(), d = img.data, tw = k * 5, fade = 1 - k * k;\\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\\n      const dx = x - cx, dy = y - cy, l = Math.hypot(dx, dy), a = tw * Math.max(0, 1 - l / R) ** 2, c = Math.cos(a), s = Math.sin(a);\\n      const sx = Math.round(cx + dx * c - dy * s), sy = Math.round(cy + dx * s + dy * c), o = (y * W + x) * 4, i = (clamp(sy, 0, H - 1) * W + clamp(sx, 0, W - 1)) * 4;\\n      d[o] = src[i] * fade; d[o + 1] = src[i + 1] * fade; d[o + 2] = src[i + 2] * fade; d[o + 3] = 255;\\n    }\\n    g.putImageData(img, 0, 0);\\n  },\\n  dissolve(g, k, r) {   // pixel by pixel, in a fixed scattered order\\n    const q = Math.round(k * 32), pat = r._stamp(\\'dissolve\\' + q, () => { const c = mkCanvas(32, 32), cg = c.getContext(\\'2d\\'); cg.fillStyle = \\'#000\\'; for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) if (hash2(x, y) < q / 32) cg.fillRect(x, y, 1, 1); return c; });\\n    g.save(); g.fillStyle = g.createPattern(pat, \\'repeat\\'); g.fillRect(0, 0, r.bw, r.bh); g.restore();\\n  }\\n});\\n// where iris and swirl centre: go\\'s at (a world point, or [x, y] on the screen), or the screen\\'s centre\\nconst _fadeAt = (r, F) => { const a = F.at; return Array.isArray(a) ? a : a ? r.w(a.x || 0, a.y || 0, a.z || 0) : [r.W / 2, r.H / 2]; };\\n\\n/* =============================================================================\\n * 10g. WEATHER  game.weather = { kind: \\'rain\\' | \\'snow\\' | \\'ash\\' | \\'leaves\\' | \\'sand\\', amount: 0..1 (.5), wind: -1..1,\\n *    lightning: 0..1 } (null: clear skies). It falls through the world\\'s height in ground views and in three layers in\\n *    side and flat views, lands on the floor (particles.ground: a side view\\'s platforms) and splashes or settles; with\\n *    lightning, flashes (the player\\'s Screen flashes) and thunder. Cosmetic: its own seeded stream (never Math.random,\\n *    so replays and the game\\'s randomness are untouched), its drops pooled, stepped on game time. It ends with the scene:\\n *    set it in the scene\\'s enter.\\n * ============================================================================= */\\n/** the kinds of weather: n drops at amount 1, fall speed (world units a second), colors, streak (seconds of motion a\\n *  drop\\'s line shows), sway, rest (seconds it lies where it lands), splash, wind (how hard the wind pushes it), size, big\\n *  (the share a pixel bigger). Add your\\n *  own: E.WEATHER.embers = { ... } */\\nconst WEATHER = {\\n  rain: { n: 260, fall: 300, colors: [\\'#9fb6dc\\', \\'#c8d8f0\\'], streak: .03, splash: true, wind: 1 },\\n  snow: { n: 280, fall: 30, colors: [\\'#ffffff\\', \\'#e8f0fa\\'], sway: 10, rest: .6, wind: 1, big: .55 },\\n  ash: { n: 200, fall: 20, colors: [\\'#d0c8c8\\', \\'#a09898\\', \\'#ff8a40\\'], sway: 6, wind: .8, big: .35 },\\n  leaves: { n: 56, fall: 28, colors: [\\'#c8642a\\', \\'#e0a040\\', \\'#8a5a2a\\', \\'#a8b040\\'], sway: 24, rest: 1, size: 2, wind: 1.2 },\\n  sand: { n: 220, fall: 12, colors: [\\'#d8b878\\', \\'#c8a060\\'], streak: .05, wind: 3 }\\n};\\nE.WEATHER = WEATHER;\\nconst WX_TOP = 150, WX_LAYERS = [[.45, .6, 1], [1, 1, 1], [1.7, 1.5, 2]];   // the drops\\' height in ground views; side and flat views\\' layers: [parallax, speed, size]\\nHOOKS.enter.push((g, old) => { if (old) g.weather = null; });\\nHOOKS.step.push((g, dt) => {\\n  const w = g.weather, S = g._wx; if (!w || !w.kind) { if (S) S.drops.length = 0; return; }\\n  const K = WEATHER[w.kind]; if (!K) { warn(\\'weather:\\' + w.kind, \\'unknown weather \"\\' + w.kind + \\'\": \\' + Object.keys(WEATHER).join(\\', \\')); return; }\\n  _wxStep(g, g._wx || (g._wx = { R: rng(0x5eed), drops: [], t: 0, bolt: 0, flick: 0, thunder: 0 }), w, K, dt);\\n});\\nHOOKS.draw.push((g, r, ctx) => { const w = g.weather, S = g._wx; if (w && w.kind && S && WEATHER[w.kind]) _wxDraw(g, r, ctx, S, w, WEATHER[w.kind]); });\\n// the world box the screen shows: side views [x0, 0, x1, 0, z0, z1]; ground views the ground under the screen [x0, y0,\\n// x1, y1]\\nconst _wxBox = g => {\\n  const v = g.view, c = g.cam, W = g.W, H = g.H;\\n  if (v.isSide) return [(c.x - 20) / v.ax, 0, (c.x + W + 20) / v.ax, 0, (c.y + H) / v.bz, (c.y - 20) / v.bz];\\n  const pts = [[0, 0], [W, 0], [0, H], [W, H]].map(([sx, sy]) => v.toGround(c.x + sx, c.y + sy) || [0, 0]);\\n  return [Math.min(...pts.map(p => p[0])) - 16, Math.min(...pts.map(p => p[1])) - 16, Math.max(...pts.map(p => p[0])) + 16, Math.max(...pts.map(p => p[1])) + 16];\\n};\\nfunction _wxStep(g, S, w, K, dt) {\\n  const R = S.R, v = g.view, mode = v.pitchDeg >= 70 ? \\'flat\\' : v.isSide ? \\'side\\' : \\'world\\', n = Math.round(clamp(w.amount === undefined ? .5 : w.amount, 0, 1) * K.n), D = S.drops;\\n  const box = _wxBox(g), wind = (w.wind || 0) * 60 * (K.wind || 1), ground = g.particles.ground, W = g.W, H = g.H;\\n  const dcx = S.cx === undefined ? 0 : g.cam.x - S.cx; S.cx = g.cam.x; S.t += dt;\\n  // a drop starting from the top, in the screen\\'s box (or anywhere in its height: the first ones fill the sky at once)\\n  const spawn = (d, any) => {\\n    d.layer = mode === \\'world\\' ? 1 : (R() * 3) | 0; d.c = K.colors[(R() * K.colors.length) | 0]; d.k = .8 + R() * .4; d.ph = R() * TAU; d.rest = 0; d.s = (K.size || 1) + (K.big && R() < K.big ? 1 : 0);\\n    if (mode === \\'world\\') { const q = v.toGround(g.cam.x + R() * W, g.cam.y + R() * H) || [0, 0]; d.x = q[0]; d.y = q[1]; }   // (it lands on a point of the screen)\\n    if (mode === \\'world\\' || (mode === \\'side\\' && d.layer === 1)) {\\n      if (mode === \\'side\\') { d.x = lerp(box[0], box[2], R()); d.y = 0; }\\n      d.fl = ground ? ground(d.x, d.y, mode === \\'side\\' ? box[5] : WX_TOP) || 0 : 0;\\n      const top = mode === \\'side\\' ? box[5] : d.fl + WX_TOP; d.z = any ? lerp(d.fl, top, R()) : top;\\n    } else { d.x = R() * W; d.y = any ? R() * H : -4; d.z = d.fl = undefined; }\\n  };\\n  while (D.length < n) { const d = {}; spawn(d, true); D.push(d); }\\n  D.length = n;\\n  for (const d of D) {\\n    if (d.rest > 0) { if ((d.rest -= dt) <= 0) spawn(d, false); continue; }\\n    const sway = K.sway ? Math.sin(S.t * 2 + d.ph) * K.sway : 0;\\n    if (d.z !== undefined) {\\n      d.x += (wind + sway) * dt; d.z -= K.fall * d.k * dt;\\n      if (d.x < box[0] || d.x > box[2] || (mode === \\'world\\' && (d.y < box[1] || d.y > box[3]))) { d.x = wrap(d.x, box[0], box[2]); if (mode === \\'world\\') d.y = wrap(d.y, box[1], box[3]); d.fl = ground ? ground(d.x, d.y, d.z) || 0 : 0; }\\n      if (mode === \\'side\\' && d.z < box[4] - 16) spawn(d, false);   // (fell past the bottom of the screen: a pit)\\n      else if (d.z <= d.fl) { d.z = d.fl; d.rest = K.splash ? .12 : K.rest || 0; if (!d.rest) spawn(d, false); }\\n    } else {\\n      const L = WX_LAYERS[d.layer];\\n      d.x = wrap(d.x + ((wind + sway) * L[1] * dt) - dcx * L[0], -8, W + 8); d.y += K.fall * d.k * L[1] * dt;\\n      if (d.y > H + 4) spawn(d, false);\\n    }\\n  }\\n  // lightning: a flash, a second flicker, then thunder after the light\\n  const L = w.lightning || 0;\\n  if (L > 0) {\\n    if (S.bolt <= 0) S.bolt = (3 + R() * 9) / L;\\n    if ((S.bolt -= dt) <= 0) { g.flash(\\'#e4ecff\\', .14, .9); S.flick = .12; S.thunder = .3 + R() * .9; S.bolt = (3 + R() * 9) / L; }\\n    if (S.flick > 0 && (S.flick -= dt) <= 0) g.flash(\\'#e4ecff\\', .1, .6);\\n    if (S.thunder > 0 && (S.thunder -= dt) <= 0) g.audio.sfx(\\'boom\\', { pitch: .45 + R() * .2, vol: .8 });\\n  }\\n}\\nfunction _wxDraw(g, r, ctx, S, w, K) {\\n  const draw = () => {\\n    for (const d of S.drops) {\\n      const L = WX_LAYERS[d.layer], sz = (d.s || 1) * (d.z !== undefined ? 1 : L[2]), wx = (w.wind || 0) * 60 * (K.wind || 1);\\n      let x, y, x2, y2;\\n      if (d.z !== undefined) { [x, y] = r.w(d.x, d.y, d.z); if (K.streak && !d.rest) [x2, y2] = r.w(d.x - wx * K.streak, d.y, d.z + K.fall * K.streak); }\\n      else { x = d.x; y = d.y; if (K.streak) { x2 = x - wx * K.streak * L[1]; y2 = y - K.fall * K.streak * L[1]; } }\\n      if (x < -12 || y < -40 || x > r.bw + 12 || y > r.bh + 12) continue;\\n      if (d.rest > 0) { if (K.splash) { px.dot(ctx, x - 2, y - 1, d.c); px.dot(ctx, x + 2, y - 1, d.c); px.dot(ctx, x, y - 2, d.c); } else px.rect(ctx, x, y, sz, 1, d.c); continue; }\\n      if (x2 !== undefined) px.line(ctx, x, y, x2, y2, d.c, sz > 1 ? 2 : 1);\\n      else if (K.sway && sz > 1) { const f = Math.sin(S.t * 6 + d.ph) > 0; px.rect(ctx, x, y, f ? 2 : 1, f ? 1 : 2, d.c); }\\n      else px.rect(ctx, x, y, sz, sz, d.c);\\n    }\\n  };\\n  if (useAlpha(ctx) && K.streak) px.blend(ctx, .75, \\'normal\\', draw); else draw();\\n}\\n\\n/* =============================================================================\\n * 10h. INPUT SEQUENCES  moves made of several inputs in a row (a fighter\\'s special moves, a cheat code, a rhythm\\n *    pattern), read from input.history: the last second of directions and presses, which an input display can draw too.\\n *    Numpad notation names directions as the keys of a number pad, for a fighter facing right: 1 down-back, 2 down, 3\\n *    down-forward, 4 back, 5 neutral, 6 forward, 7 up-back, 8 up, 9 up-forward; facing left mirrors them.\\n * ============================================================================= */\\nconst _DIRS = [\\'up\\', \\'down\\', \\'left\\', \\'right\\'], _PAD = { 0: 5, 1: 8, 2: 2, 4: 4, 8: 6, 5: 7, 9: 9, 6: 1, 10: 3 };   // direction bits (up 1, down 2, left 4, right 8) -> numpad, facing right\\nHOOKS.input.push(g => { for (const I of g._players || [g.input]) {   // (each player\\'s own history: game.players)\\n  const H = I._hist || (I._hist = []); let b = 0;\\n  for (let i = 0; i < 4; i++) if (I.map[_DIRS[i]] && I.down(_DIRS[i])) b |= 1 << i;\\n  if (b & 3) b = (b & 3) === 3 ? b & ~3 : b; if ((b & 12) === 12) b &= ~12;   // (both ways at once: neither)\\n  const last = H[H.length - 1], pressed = [...I._now].filter(a => !_DIRS.includes(a));\\n  if (!last || last._b !== b || pressed.length) H.push({ t: I.clock, dir: _PAD[b] || 5, pressed, _b: b });\\n  while (H.length > 2 && H[1].t < I.clock - 1) H.shift();\\n} });\\n// one step of a sequence, \\'down+right\\' or \\'attack\\' or \\'down+attack\\': the directions it holds (bits) and the buttons pressed\\nconst _seqStep = s => { let b = 0, dirs = false; const btn = []; for (const p of String(s).split(\\'+\\')) { const i = _DIRS.indexOf(p); if (i >= 0) { b |= 1 << i; dirs = true; } else if (p === \\'neutral\\') dirs = true; else if (p) btn.push(p); } return { b, dirs, btn }; };\\n/**\\n * true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first:\\n * input.sequence([\\'down\\', \\'down+right\\', \\'right\\', \\'attack\\']). A step names actions joined by +: its directions are held\\n * exactly as it says (up, down, left, right; \\'neutral\\' for none) as they change to that, its buttons pressed. A cheat\\n * code: input.sequence([\\'up\\', \\'up\\', \\'down\\', \\'down\\', \\'left\\', \\'right\\', \\'left\\', \\'right\\', \\'kick\\', \\'attack\\'], { window: 3 })\\n */\\nInput.prototype.sequence = function (steps, o = {}) {\\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\\n  if (last.t !== now) return false;\\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\\n  return i < 0;\\n};\\n/**\\n * a fighter\\'s move in numpad notation, mirrored by facing: input.motion(\\'236\\', \\'attack\\', { facing: hero.facing, window })\\n * is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); \\'623\\' a dragon punch, \\'41236\\'\\n * a half circle. facing: 1 (right, the default) or -1. button: an action, \\'attack+kick\\', or none (the motion alone)\\n */\\nInput.prototype.motion = function (digits, button, o = {}) {\\n  const fw = (o.facing || 1) < 0 ? \\'left\\' : \\'right\\', bk = fw === \\'left\\' ? \\'right\\' : \\'left\\';\\n  const D = { 1: \\'down+\\' + bk, 2: \\'down\\', 3: \\'down+\\' + fw, 4: bk, 5: \\'neutral\\', 6: fw, 7: \\'up+\\' + bk, 8: \\'up\\', 9: \\'up+\\' + fw };\\n  const steps = String(digits).split(\\'\\').map(c => D[c]).filter(Boolean);\\n  if (button) steps.push(button);\\n  return this.sequence(steps, Object.assign({ window: .45 }, o));\\n};\\n\\n/* =============================================================================\\n * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\\n *    (several things kept in view): where the camera aims, from where it would aim (tx, ty: its top-left corner, in\\n *    projected pixels). Game\\'s _camStep asks it while one of them is set\\n * ============================================================================= */\\n// where the camera aims: framed between its targets (zooming to fit), its height held until a landing, kept still while\\n// the focus stays in the window\\nGame.prototype._camAim = function (tx, ty) {\\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\\n  if (fr) {\\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\\n    if (x1 >= x0) {\\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\\n      const Z = fr.zoom; if (Z) {   // out at once when they don\\'t fit, back in once they would fit well\\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\\n      }\\n    }\\n  }\\n  const f = this._follow;\\n  if (c.snapY) { const t = f && f.target, lim = H * .3; if (c.snap || c._ly === undefined || !t || t.onGround !== false) c._ly = ty; else c._ly = clamp(c._ly, ty - lim, ty + lim); ty = c._ly; }\\n  if (c.window) { const [ww, wh] = c.window; if (c.snap || c._wx === undefined) { c._wx = tx; c._wy = ty; } c._wx = clamp(c._wx, tx - ww / 2, tx + ww / 2); c._wy = clamp(c._wy, ty - (wh || 0) / 2, ty + (wh || 0) / 2); tx = c._wx; ty = c._wy; }\\n  return [tx, ty];\\n};\\n\\n/* =============================================================================\\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\\n *    unchanged), each other an input of its own, with game.input\\'s API, its device and its bindings: a gamepad each, or\\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; \\' and the\\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\\n *    right half\\'s start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\\n *    number), name (\\'P2\\') and color. A pause says who paused, a lost controller names its player, the Controls screen\\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\\n *    the whole screen; GPU lighting off while split. A scene\\'s start ends a split.\\n * ============================================================================= */\\nconst KEY_HALVES = {   // each half\\'s moves, its buttons in order (the preset\\'s other actions take them in turn) and its menu keys\\n  left: { up: [\\'KeyW\\'], down: [\\'KeyS\\'], left: [\\'KeyA\\'], right: [\\'KeyD\\'], buttons: [[\\'KeyF\\'], [\\'KeyG\\'], [\\'KeyH\\'], [\\'KeyR\\'], [\\'KeyT\\'], [\\'KeyY\\'], [\\'KeyV\\'], [\\'KeyB\\']], start: [\\'Digit1\\'], pause: [\\'Escape\\', \\'Digit1\\'], confirm: [\\'KeyF\\'], cancel: [\\'KeyG\\'] },\\n  right: { up: [\\'ArrowUp\\'], down: [\\'ArrowDown\\'], left: [\\'ArrowLeft\\'], right: [\\'ArrowRight\\'], buttons: [[\\'Period\\', \\'Numpad1\\'], [\\'Slash\\', \\'Numpad2\\'], [\\'Comma\\', \\'Numpad3\\'], [\\'KeyL\\', \\'Numpad4\\'], [\\'Semicolon\\', \\'Numpad5\\'], [\\'Quote\\', \\'Numpad6\\'], [\\'KeyK\\', \\'Numpad7\\'], [\\'KeyM\\', \\'Numpad8\\']],\\n    start: [\\'Digit2\\', \\'Enter\\', \\'NumpadEnter\\'], pause: [\\'Digit2\\', \\'Backspace\\'], confirm: [\\'Period\\', \\'Enter\\', \\'NumpadEnter\\'], cancel: [\\'Slash\\', \\'Backspace\\'] }\\n};\\n/** a preset for half a keyboard (\\'left\\' or \\'right\\'): its moves and menu keys, the preset\\'s other actions on its buttons\\n *  in order, and the preset\\'s gamepad codes (Input.halfKeys(Input.SHMUP, \\'right\\') -> fire on . and Numpad 1, bomb on /).\\n *  A preset\\'s own halves come first: preset.halves = { left: { pass: [\\'KeyR\\'] }, right: { pass: [\\'KeyL\\'] } } (an action\\n *  a menu reads beside confirm would take confirm\\'s F otherwise) */\\nInput.halfKeys = (preset, side) => {\\n  const P = typeof preset === \\'string\\' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\\n  let k = 0;\\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\\n  return out;\\n};\\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player\\'s input: the screen\\'s sizes, no listeners of its own)\\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard\\'s codes go to the players sharing it\\n  const P = game.players, I = P[0];\\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === \\'number\\').map(q => q.pad));\\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\\n  if (!I.keysTo.length) I.keysTo = null;\\n}\\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String\\'s and Array\\'s) */\\nGame.prototype.allowJoin = function (o = {}) {\\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: [\\'Digit2\\'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\\n  _pClaim(this); return this;\\n};\\n/** a player in now: { pad: index } (a gamepad) or { keys: \\'right\\' } (the keyboard\\'s right half; player 1 takes the\\n *  left). Returns its input (null when four play already) */\\nGame.prototype.addPlayer = function (o = {}) {\\n  const P = this.players; if (P.length >= 4) return null;\\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\\n  Object.assign(q, { player: n, name: \\'P\\' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === \\'number\\' ? o.pad : null, half: o.keys ? \\'right\\' : null, device: o.keys ? \\'keyboard\\' : \\'gamepad\\' });\\n  for (const k of [\\'glyphs\\', \\'deadzone\\', \\'invertAimY\\', \\'invertMoveX\\', \\'invertMoveY\\', \\'rumbleScale\\']) q[k] = this.input[k];   // (the player\\'s settings: button symbols, dead zone, aim, the move stick, vibration)\\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = \\'left\\'; I.use(Input.halfKeys(I._full, \\'left\\')); }   // player 1 moves to the left half\\n  q.use(_pPreset(this, q));\\n  if (!this.settings.spec(\\'playerBindings\\')) this.settings.define({ key: \\'playerBindings\\', group: \\'Controls\\', type: \\'bindings\\', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\\n  q._onBindings = b => this.settings.set(\\'playerBindings\\', Object.assign({}, this.settings.playerBindings, { [n]: b }));\\n  P.push(q); _pClaim(this);\\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail(\\'allowJoin onJoin\\', e); }\\n  this.note(q.name + \\' JOINED\\', 1.5); this.audio.sfx(\\'confirm\\');\\n  return q;\\n};\\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\\nGame.prototype.removePlayer = function (p) {\\n  const P = this.players, i = typeof p === \\'number\\' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = \\'P\\' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\\n  _pClaim(this);\\n};\\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: \\'auto\\' (side by side on a wide\\n *  screen, stacked on a tall one; a grid for 3 or 4) | \\'columns\\' | \\'rows\\' | \\'grid\\', follow: [targets], z: 16, gap: 1 } */\\nGame.prototype.splitScreen = function (n, o = {}) {\\n  if (!(n >= 2)) { this._split = null; return this; }\\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\\n  this._split = { layout: o.layout || \\'auto\\', gap: o.gap === undefined ? 1 : o.gap, vps };\\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\\n  _vpLayout(this); return this;\\n};\\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\\nfunction _vp(i) {\\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\\n  /** look at a world point */\\n  v.focus = (x, y, z = 0) => { v.target = null; Object.assign(v.cam, { tx: x, ty: y, tz: z }); };\\n  /** keep the camera on an object ({ x, y, z }); o.z: the height looked at (16) */\\n  v.follow = (t, o = {}) => { v.target = t || null; if (o.z !== undefined) v.z = o.z; v.cam.snap = true; };\\n  return v;\\n}\\nfunction _vpLayout(game) {\\n  const S = game._split, n = S.vps.length, W = game.screen.W, H = game.screen.H, g = S.gap;\\n  const mode = S.layout === \\'auto\\' ? (n > 2 ? \\'grid\\' : W >= H ? \\'columns\\' : \\'rows\\') : S.layout;\\n  S.vps.forEach((v, i) => {\\n    const [c, r, cols, rows] = mode === \\'grid\\' ? [i % 2, Math.floor(i / 2), 2, 2] : mode === \\'rows\\' ? [0, i, 1, n] : [i, 0, n, 1];\\n    const x0 = Math.round(c * W / cols), x1 = Math.round((c + 1) * W / cols), y0 = Math.round(r * H / rows), y1 = Math.round((r + 1) * H / rows);\\n    Object.assign(v, { x: x0 + (c ? g : 0), y: y0 + (r ? g : 0), w: x1 - x0 - (c ? g : 0), h: y1 - y0 - (r ? g : 0) });\\n  });\\n}\\nfunction _vpCam(game, v, dt) {   // (game.cam\\'s rules in the viewport\\'s size: centred on its focus, inside the bounds, eased)\\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\\n}\\n// each step: the other players\\' inputs, a pause by any of them, a lost controller, and joining\\nHOOKS.input.push((game, dt) => {\\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\\n  for (const q of P.slice(1)) {\\n    if (q.padLost) { game._autoPause(\\'controller\\'); game.note(q.name + \\': CONTROLLER DISCONNECTED\\', 2.5); }\\n    if (game.scene && game.scene.pausable && q.pressed(\\'pause\\')) { game.paused = !game.paused; game.pauseReason = game.paused ? \\'player\\' : null; game.pausedBy = q.player; game.audio.sfx(\\'pause\\'); q.consumeAll(); }\\n  }\\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\\n  if (I.pressed(\\'pause\\')) game.pausedBy = 1;\\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed(\\'join\\') && !P.some(q => q.half === \\'right\\') && I.lastDevice !== \\'gamepad\\') game.addPlayer({ keys: \\'right\\' }); }\\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\\n  for (const p of pads) {   // Start on a pad no one holds: player 1\\'s own once it plays on it (the press that just woke it joins)\\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === \\'gamepad\\' && was[1] === p.index)) continue;\\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host\\'s)\\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner\\'s: player 1 neither pauses nor turns to the pad)\\n    game.addPlayer({ pad: p.index });\\n  }\\n});\\nHOOKS.enter.push(game => {   // a scene\\'s start: the others take its keys too (a half each where they share the keyboard); a split ends\\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, \\'left\\')); }\\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\\n});\\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\\n// a split screen\\'s frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\\n// the dividers, the scene\\'s hud(r) over the whole screen and the frame\\'s own overlays (notes, pause, fades)\\nHOOKS.frame = (game, shx, shy) => {\\n  const r = game.r, sc = game.scene, S = game._split; _vpLayout(game);\\n  for (const v of S.vps) {\\n    if (v.cam.x === undefined) _vpCam(game, v, 0);\\n    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\\n    if (sc && sc.draw) sc.draw(r);\\n    r._finish();\\n  }\\n  r.viewport = null; r._items.length = 0; r._decals.length = 0; r._overlays.length = 0; r._only = true;\\n  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, \\'#05040a\\'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, \\'#05040a\\'); } });\\n  if (sc && sc.hud) sc.hud(r);\\n};\\n\\n/* =============================================================================\\n * 10k. SAVE SLOTS  game.saves: three slots and an autosave, each holding the game\\'s own data with its place, time\\n *    played and level, as Dragon Quest\\'s adventure log and Final Fantasy\\'s save screen do. A save is versioned (the\\n *    game\\'s version of its data, migrate for older ones); nothing here throws, and when storage is blocked play goes\\n *    on with the saves kept for the visit (a headless game keeps them in memory only).\\n *      game.saves.write = () => ({ data: { hero, flags }, place: \\'Brightwater\\', level: hero.lv });   // what a save holds\\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\\n *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\\n *      game.saves.list()   // the slots, autosave first: [{ slot: \\'auto\\' | 0 | 1 | 2, empty, place, level, time, at, damaged, newer }]\\n *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\\n *    the pause menu, each opening the standard screen (the slots with their place, level and time; save, load, copy and\\n *    erase, asking before a save is lost); game.saves.show(\\'save\\' | \\'load\\') opens it from a game\\'s own menu or title.\\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\\n * ============================================================================= */\\nconst SAVE_FORMAT = 1;   // the record\\'s own shape: { v, version, data, place, level, time, at }\\nclass Saves {\\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\\n  constructor(game, o) {\\n    o = o && typeof o === \\'object\\' ? o : {};\\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game\\'s version of its data (1),\\n     *  saved with each save; migrate(data, from): an older version\\'s data brought up to this one (or null: kept as it\\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\\n     *  level, time, slot } */\\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\\n     *  game\\'s scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\\n     *  refused a save (they last for the visit) */\\n    this.canSave = true; this.played = 0; this.blocked = false;\\n    this._mem = {};   // each slot\\'s record as text, this visit\\'s (what storage refused stays here)\\n  }\\n  _key(slot) { return \\'save:\\' + (this.game.o.id || (typeof location !== \\'undefined\\' && location.pathname) || \\'game\\') + \\':\\' + slot; }\\n  _ok(slot) { return slot === \\'auto\\' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\\n  _raw(slot) {\\n    if (slot in this._mem) return this._mem[slot];\\n    if (this.game.headless) return null;\\n    try { return localStorage.getItem(\\'my3d2dge:\\' + this._key(slot)); } catch (e) { return null; }\\n  }\\n  _put(slot, text) {\\n    this._mem[slot] = text; if (this.game.headless) return true;\\n    try { if (text === null) localStorage.removeItem(\\'my3d2dge:\\' + this._key(slot)); else localStorage.setItem(\\'my3d2dge:\\' + this._key(slot), text); return true; }\\n    catch (e) { if (!this.blocked) warn(\\'saves:blocked\\', \\'game.saves: storage is blocked or full: the saves last for this visit\\'); this.blocked = true; return false; }\\n  }\\n  /** a slot\\'s save as it is stored, checked: null when empty; { slot, damaged: true } when it can\\'t be read; { newer:\\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\\n  get(slot) {\\n    if (!this._ok(slot)) return null;\\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\\n    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\\n    if (!s || typeof s !== \\'object\\' || s.v !== SAVE_FORMAT || !(\\'data\\' in s)) return { slot, damaged: true };\\n    const out = { slot, data: s.data, place: typeof s.place === \\'string\\' ? s.place : \\'\\', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\\n    if (out.version > this.version) out.newer = true;\\n    return out;\\n  }\\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu\\'s rows) */\\n  list() { return [\\'auto\\'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\\n  /** save to a slot (0.., or \\'auto\\'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\\n  save(slot, o) {\\n    if (!this._ok(slot)) { warn(\\'saves:slot:\\' + slot, \\'game.saves: no slot \\' + slot + \\' (0 to \\' + (this.slots - 1) + \\', or \"auto\")\\'); return false; }\\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail(\\'saves.write\\', e); return false; }\\n    if (!o || !(\\'data\\' in o)) { warn(\\'saves:write\\', \\'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write\\'); return false; }\\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || \\'\\', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\\n    catch (e) { this.game.fail(\\'saves.save\\', e); return false; }\\n    this._put(slot, text); return true;\\n  }\\n  /** save to the autosave (what write() gives) */\\n  autosave(o) { return this.save(\\'auto\\', o); }\\n  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\\n  load(slot) {\\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail(\\'saves.migrate\\', e); return null; }\\n    this.played = s.time;\\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail(\\'saves.read\\', e); return null; }\\n    return s;\\n  }\\n  /** copy a slot\\'s save onto another (over what is there); false when the first is empty */\\n  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\\n  /** erase a slot */\\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\\n  /** is there any save to load (a title\\'s Continue)? */\\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\\n  /** the most recent save that loads, or null (a title\\'s Continue loads it) */\\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\\n  /** open the standard save screen over the game (E.Shell\\'s): \\'save\\' (to a slot) or \\'load\\'; done(save) after a load or\\n   *  a save. False without a menu (a headless game, menu: false) */\\n  show(mode = \\'load\\', done) {\\n    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + \\':\\' + String(m % 60).padStart(2, \\'0\\'); };\\n    const name = slot => slot === \\'auto\\' ? \\'Autosave\\' : \\'Slot \\' + (slot + 1);\\n    const about = s => s.empty ? \\'Empty\\' : s.damaged ? \\'Damaged: it cannot be read\\' : s.newer ? \\'From a newer version of the game\\' : [s.place, s.level !== null ? \\'Level \\' + s.level : \\'\\', T(s), s.at ? new Date(s.at).toLocaleDateString() : \\'\\'].filter(Boolean).join(\\' · \\');\\n    const page = () => sh.show(\\'saves\\', { kicker: mode === \\'save\\' ? \\'Save\\' : \\'Load\\', title: mode === \\'save\\' ? \\'Save your game\\' : \\'Load a game\\', text: this.blocked ? \\'Saving is blocked here: these saves last for this visit.\\' : \\'\\',\\n      actions: this.list().filter(s => mode === \\'load\\' || s.slot !== \\'auto\\').map(s => ({ label: name(s.slot) + \\' — \\' + about(s), fn: () => slot(s) })).concat([[\\'Back\\', () => sh.back()]]) });\\n    const ask = (title, text, label, fn) => sh.show(\\'confirm\\', { kicker: \\'Save\\', title, text, actions: [{ label: \\'Keep it\\', fn: () => sh.back() }, { label, fn: () => { sh.back(); fn(); } }] });\\n    const saved = () => { sh.toast(\\'Saved\\', name(this._last)); if (done) done(this.get(this._last)); };\\n    const slot = s => {\\n      const acts = [];\\n      if (mode === \\'save\\' && s.slot !== \\'auto\\') acts.push({ label: \\'Save here\\', primary: true, fn: () => {\\n        const go = () => { this._last = s.slot; this.save(s.slot); page(); saved(); };\\n        if (s.empty) { sh.back(); go(); } else ask(\\'Save over \\' + name(s.slot) + \\'?\\', about(s) + \\' is lost.\\', \\'Save over it\\', () => { sh.back(); go(); });\\n      } });\\n      if (mode === \\'load\\' && !s.empty) acts.push({ label: \\'Load\\', primary: true, disabled: s.damaged || s.newer, fn: () => { const r = this.load(s.slot); sh.hide(); if (r) { sh.toast(\\'Loaded\\', name(s.slot)); if (done) done(r); } } });\\n      if (!s.empty) acts.push({ label: \\'Copy to…\\', fn: () => sh.show(\\'saves-copy\\', { kicker: \\'Copy\\', title: \\'Copy \\' + name(s.slot) + \\' to\\', actions: this.list().filter(t => t.slot !== \\'auto\\' && t.slot !== s.slot).map(t => ({ label: name(t.slot) + \\' — \\' + about(t), fn: () => {\\n        const go = () => { this.copy(s.slot, t.slot); sh.back(); sh.back(); page(); };\\n        if (t.empty) go(); else ask(\\'Copy over \\' + name(t.slot) + \\'?\\', about(t) + \\' is lost.\\', \\'Copy over it\\', go);\\n      } })).concat([[\\'Back\\', () => sh.back()]]) }) });\\n      if (!s.empty) acts.push({ label: \\'Erase\\', fn: () => ask(\\'Erase \\' + name(s.slot) + \\'?\\', about(s) + \\' is lost.\\', \\'Erase it\\', () => { this.erase(s.slot); sh.back(); page(); }) });\\n      acts.push([\\'Back\\', () => sh.back()]);\\n      sh.show(\\'saves-slot\\', { kicker: mode === \\'save\\' ? \\'Save\\' : \\'Load\\', title: name(s.slot), text: about(s), actions: acts });\\n    };\\n    if (this.game.pause(\\'menu\\')) sh._ownPause = true;\\n    page(); return true;\\n  }\\n}\\n/** game.saves: the save slots (section 10k), made when first read */\\nObject.defineProperty(Game.prototype, \\'saves\\', { configurable: true, get() { return this._saves || (this._saves = new Saves(this, this.o.menu && this.o.menu.saves)); } });\\nE.Saves = Saves;\\nHOOKS.step.push((game, dt) => { const s = game._saves, sc = game.scene; if (s && sc && (sc.pausable || game.sceneName === \\'main\\')) s.played += dt; });   // time played: the game\\'s scenes, not its titles\\nHOOKS.pause = (sh, acts) => {   // the pause menu\\'s Save and Load, with menu: { saves }\\n  const g = sh._game; if (!(g.o.menu && g.o.menu.saves)) return;\\n  if (g.saves.canSave) acts.push([\\'Save\\', () => g.saves.show(\\'save\\')]);\\n  acts.push([\\'Load\\', () => g.saves.show(\\'load\\')]);\\n};\\n\\n/* =============================================================================\\n * 10l. MORE INPUT  input.value(a) (how far an action is pressed: a trigger\\'s travel, a stick\\'s push), game.hook (a\\n *    game\\'s own function on the engine\\'s clock), and the notice a game made with touch: \\'never\\' shows on a phone. In a\\n *    section of its own: a kit whose game calls none of them leaves it out\\n * ============================================================================= */\\n/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick\\'s\\n *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\\nInput.prototype.value = function (a) {\\n  const m = this.map[a]; if (!m) { this._check(a); return 0; } if (this._suppressed.has(a)) return 0;\\n  const PV = this.padValues || [], mv = this.padMove || [0, 0], st = this.stickOn ? this.stick : [0, 0], push = { up: [1, -1], down: [1, 1], left: [0, -1], right: [0, 1] };\\n  let v = 0;\\n  for (const c of m) {\\n    const k = /^Pad(\\\\d+)$/.exec(c), ax = /^Pad(R?)Axis(Up|Down|Left|Right)$/.exec(c), pv = k ? PV[+k[1]] || 0 : 0;\\n    if (k) v = Math.max(v, pv);\\n    if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1)); }\\n    else if (this.held.has(c)) v = Math.max(v, k && pv > 0 ? pv : 1);\\n  }\\n  if (push[a]) { const [i, s] = push[a]; v = Math.max(v, clamp(st[i] * s, 0, 1)); }\\n  return v;\\n};\\n/** a function of the game\\'s own on the engine\\'s clock: kind \\'input\\' fn(dt) every step, paused or not, after the input\\n *  is read (a host\\'s guard, an idle timer); \\'step\\' fn(dt) every update step in play, before the scene\\'s update (an\\n *  attract mode\\'s watcher); \\'enter\\' fn(name, data) as a scene starts. Returns a function that removes it */\\nGame.prototype.hook = function (kind, fn) {\\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\\n  if (!L) throw new Error(\\'game.hook(\"\\' + kind + \\'\"): the hooks are input, step and enter\\');\\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\\n};\\n/** touch: \\'never\\' on a device with touch alone: \"Controller or keyboard required\", with Settings, until a controller\\n *  is connected or a key pressed */\\nGame.prototype._needSync = function () {\\n  const fine = window.matchMedia && matchMedia(\\'(any-pointer: fine)\\').matches, coarse = window.matchMedia && matchMedia(\\'(pointer: coarse)\\').matches;\\n  const need = coarse && !fine && !this._keyed && this.input.padIndex === null, el = this._needEl;\\n  if (!need) { if (el) el.style.display = \\'none\\'; return; }\\n  if (!el) {\\n    const d = this._needEl = document.createElement(\\'div\\'); d.setAttribute(\\'data-sys\\', \\'need\\'); d.setAttribute(\\'role\\', \\'alert\\');\\n    d.style.cssText = \\'position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;background:rgba(5,3,12,.88);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif\\';\\n    d.innerHTML = \\'<div><div style=\"font-size:21px;margin-bottom:8px\">Controller or keyboard required</div><div style=\"opacity:.8;margin-bottom:18px\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\"button\" style=\"font:inherit;padding:10px 22px;border-radius:10px;border:2px solid #b8a8ff;background:#2a2050;color:#fff;min-width:44px;min-height:44px\">Settings</button></div>\\';\\n    d.querySelector(\\'button\\').onclick = () => this.menu(\\'settings\\');\\n    (this.screen.canvas.parentElement || document.body).appendChild(d);\\n  }\\n  this._needEl.style.display = this.shell && this.shell.screen ? \\'none\\' : \\'flex\\';   // (Settings open over it: hidden while it is)\\n};\\n/* =============================================================================\\n * 11. HUMANOID RIG\\n *    Local frame: f = forward, r = right, z = up. The rig poses itself every step\\n *    from movement, attacks and state, then projects through any view.\\n *    Attack specs (angles relative to facing, + = toward the right hand):\\n *      { a0, a1, z0, z1, reach, blade, spin }   e.g. horizontal slash a0: 1.7 -> a1: -1.9\\n *    Drive with rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, attack:{ spec, phase, u } })\\n *    where phase is \\'wind\\' | \\'active\\' | \\'recover\\' and u is 0..1 progress in that phase.\\n * ============================================================================= */\\nconst HUMAN_COLORS = {\\n  skin: \\'#f1c7a0\\', hair: \\'#3b2a2f\\', cloth: \\'#2f8f86\\', pants: \\'#3b3552\\', boot: \\'#6a4128\\', belt: \\'#e0a84a\\',\\n  cape: \\'#c8452f\\', capeIn: \\'#7a2622\\', metal: \\'#dce8f1\\', metalDk: \\'#7f93ab\\', hilt: \\'#e8b04e\\', eye: \\'#1a1320\\'\\n};\\nconst JOINT_KEYS = [\\'hipL\\', \\'hipR\\', \\'kneeL\\', \\'kneeR\\', \\'footL\\', \\'footR\\', \\'hipC\\', \\'shC\\', \\'shL\\', \\'shR\\', \\'head\\', \\'elbowL\\', \\'elbowR\\', \\'handL\\', \\'handR\\'];\\n/** body proportions: \\'chibi\\' (default, big head, Secret of Mana), \\'heroic\\' (tall, Symphony of the Night), \\'bulky\\' (brawlers, bosses) */\\nconst BUILDS = {\\n  chibi: {},\\n  heroic: { legUpper: 7.4, legLower: 7.4, hipZ: 14.3, torso: 9.6, shoulderHalf: 3.5, headR: 3.05, neck: 1.5, armUpper: 5.5, armLower: 5.4, hipHalf: 1.8, stride: 7.8, speedRef: 80 },\\n  bulky: { legUpper: 6.4, legLower: 6.2, hipZ: 12.2, torso: 9.4, shoulderHalf: 4.6, headR: 3.2, neck: .9, armUpper: 5.2, armLower: 5.2, hipHalf: 2.4, limbW: 2.6, torsoW: 4.2, footSpread: 2.4, stride: 6.6, speedRef: 60 },\\n  // bones: rib cage, skull with glowing sockets and a jaw (colors.bone to tint; outfit, cape, hat and weapons still work)\\n  skeleton: { legUpper: 7, legLower: 7, hipZ: 13.4, torso: 9, shoulderHalf: 3.2, headR: 3.1, neck: 1.6, armUpper: 5.3, armLower: 5.2, hipHalf: 1.5, limbW: .6, torsoW: 2.6, stride: 7, hunch: .2, skeleton: true, hair: \\'bald\\', sleeves: \\'none\\', eyeGlow: \\'#ff5a40\\' }\\n};\\nclass Humanoid {\\n  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\\n   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\\n   *  step, draw(g, ox, oy, view) inside r.actor. hat: \\'cap\\' | \\'band\\' | \\'crown\\' | \\'helmet\\' | \\'pointed\\' (or { style,\\n   *  color }; E.Humanoid.hat adds one); weapon: \\'sword\\' | \\'gun\\' | \\'staff\\' (E.Humanoid.weapon adds one); hood: true\\n   *  (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game\\'s own drawing before and after the body\\n   *  (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock) */\\n  constructor(o = {}) {\\n    if (o.build && !BUILDS[o.build]) warn(\\'build:\\' + o.build, \\'Humanoid build \"\\' + o.build + \\'\" is unknown (chibi, heroic, bulky, skeleton)\\');\\n    o = Object.assign({}, BUILDS[o.build] || {}, o);\\n    /** o: its options, with the build\\'s proportions and the defaults filled in (size, build, weapon, outfit, ...;\\n     *  legUpper, torso, headR and the other lengths are at size 1) */\\n    this.o = Object.assign({\\n      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\\n      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\\n      weapon: \\'sword\\', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\\n      style: \\'hd\\', size: 1, hair: \\'short\\', outfit: \\'shirt\\', sleeves: \\'short\\', armor: false, cheat: .5\\n    }, o);\\n    /** trail: recent points of the blade (or fist) tip, for the swing\\'s smear */\\n    this._cheat = 0; this.trail = [];\\n    if (typeof this.o.hair === \\'string\\' || !this.o.hair) this.o.hair = { style: this.o.hair || \\'short\\' };\\n    /** hairPts: the long hair\\'s simulated points (null until it has some) */\\n    this._hairPts = null;\\n    if (this.o.weapon && !HUMANOID_WEAPONS[this.o.weapon]) { warn(\\'weapon:\\' + this.o.weapon, \\'Humanoid weapon \"\\' + this.o.weapon + \\'\" is not on E.Humanoid.weapons (sword, gun, staff, a game\\\\\\'s own by E.Humanoid.weapon(id, spec), or null); drawing a sword\\'); this.o.weapon = \\'sword\\'; }\\n    if (typeof this.o.hat === \\'string\\') this.o.hat = { style: this.o.hat };\\n    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\\n     *  o.colors over them; change one and it shows at the next draw */\\n    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\\n    const C = this.C;\\n    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || \\'#e6dfc8\\';\\n    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\\n    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\\n    this._rnd = rng(o.seed !== undefined ? o.seed : Math.floor(Math.random() * 2147483647) + 1);   // (its own stream: o.seed, else one draw of Math.random; its blinks never draw from Math.random)\\n    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle\\'s phase, radians; mv: the last\\n     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\\n    this.t = this._rnd() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\\n    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body\\'s\\n     *  extra turn during a spinning move, radians */\\n    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\\n    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\\n     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\\n     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\\n     *  the world); smear: the swing\\'s smear arc, or null */\\n    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\\n    /** capeL: the cape\\'s left edge points (null until it has a cape and has moved) */\\n    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\\n    this.solvePose();\\n  }\\n  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\\n  kick(v) { this.sqV += v; }\\n  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\\n   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\\n  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\\n  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\\n  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\\n  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\\n   *  cape and hair for this step\\'s drawing only (the next update puts them back before they simulate, so they never\\n   *  jump or gain speed). Emberdeep\\'s dodge roll, moved into the rig */\\n  _roll(u) {\\n    const J = this.J, o = this.o, a = -ease.inOut(clamp(u, 0, 1)) * TAU, c = Math.cos(a), s = Math.sin(a), cz = o.hipZ * .55, tuck = Math.sin(clamp(u, 0, 1) * Math.PI);\\n    const T0 = p => { const f = p[0] * (1 - .35 * tuck), z = (p[2] - cz) * (1 - .45 * tuck); return [f * c - z * s, p[1] * (1 - .25 * tuck), f * s + z * c + cz * (1 - .55 * tuck)]; };\\n    let lift = 0; for (const k in J) { const p = J[k]; if (p && k !== \\'bladeDir\\') lift = Math.max(lift, -T0(p)[2] + (k === \\'head\\' ? o.headR : .5)); }   // rolls over on the shoulders: nothing goes through the floor\\n    const T = p => { const q = T0(p); q[2] += lift; return q; };\\n    for (const k in J) { const p = J[k]; if (p && k !== \\'bladeDir\\') J[k] = T(p); }\\n    const b = J.bladeDir; if (b) J.bladeDir = [b[0] * c - b[2] * s, b[1], b[0] * s + b[2] * c];\\n    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * o.size, kz = (1 + this.sq) * o.size, keep = this._unroll = [];\\n    for (const ch of [this.capeL, this.capeR, this._hairPts]) if (ch) for (const n of ch) {\\n      keep.push(n, n.x, n.y, n.z);\\n      const dx = n.x - this.x, dy = n.y - this.y, q = T([(dx * ca + dy * sa) / k, (-dx * sa + dy * ca) / k, (n.z - this.z) / kz]);\\n      n.x = this.x + (q[0] * ca - q[1] * sa) * k; n.y = this.y + (q[0] * sa + q[1] * ca) * k; n.z = this.z + q[2] * kz;\\n    }\\n  }\\n  /** world position of a hand (\\'R\\' holds the weapon): spawn bullets, sparks or thrown things here */\\n  hand(which = \\'R\\') { const w = this._w(this.J[\\'hand\\' + which] || this.J.handR); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\\n  /** world position of the weapon tip (sword tip, gun muzzle, staff orb) */\\n  tip() { const J = this.J, W = HUMANOID_WEAPONS[this.o.weapon], l = W ? W.length : this.o.bladeLen, L = typeof l === \\'function\\' ? l(this) : l, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\\n  /** where a point in the rig\\'s own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it)\\n   *  sits, in world units from the rig\\'s feet: add rig.x, y, z for the world point, or project it to draw at a joint */\\n  worldOffset(p) { return this._w(p); }\\n  /** local (f, r, z) -> world offset */\\n  _w(p) {\\n    const a = this.facing + this.spin + this._cheat, c = Math.cos(a), s = Math.sin(a), sz = this.o.size, k = (1 - this.sq * .4) * sz;\\n    return [(p[0] * c - p[1] * s) * k, (p[0] * s + p[1] * c) * k, p[2] * (1 + this.sq) * sz];\\n  }\\n  /**\\n   * s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point }\\n   *   air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun)\\n   *   attack: { spec, phase: \\'wind\\' | \\'active\\' | \\'recover\\', u: 0..1 }. spec.kick = true swings the right foot instead of the hand\\n   *   also aim (radians up), crouch, sprint, climb, hang (hangZ: the top it hangs from, above the feet), flip: 0..1 (a roll),\\n   *   pose: \\'cheer\\' | \\'cast\\' | \\'guard\\' | \\'kneel\\' | \\'crouch\\' | \\'wave\\' | \\'hips\\' | \\'down\\' | \\'die\\' | \\'block\\' or one of\\n   *   E.Humanoid.pose\\'s, tilt (radians: the whole body forward about the feet, a dive) and roll (sideways),\\n   *   stance: \\'guard\\' | \\'ready\\', down: 0..1, vz (with climb: the climbing speed), land: k (a heavy landing),\\n   *   expr: \\'smile\\' | \\'shout\\' | \\'angry\\' | \\'wince\\', run: 0..1 (run in place)\\n   */\\n  update(dt, s = {}) {\\n    const o = this.o;\\n    const un = this._unroll; if (un) { this._unroll = null; for (let i = 0; i < un.length; i += 4) { un[i].x = un[i + 1]; un[i].y = un[i + 2]; un[i].z = un[i + 3]; } }   // last step\\'s roll turned the cloth for drawing only\\n    if (this.t > 0 && Math.hypot((s.x || 0) - this.x, (s.y || 0) - this.y, (s.z || 0) - this.z) > 24 * o.size) { this.capeL = null; this._hairPts = null; this.trail.length = 0; }   // teleported: cloth and hair start fresh\\n    /** expr: the face shown (\\'smile\\', \\'shout\\', \\'angry\\', \\'wince\\'), or null */\\n    this.t += dt; this.x = s.x; this.y = s.y; this.z = s.z || 0; this.facing = s.facing || 0; this.expr = s.expr || null;\\n    const speed = s.run ? s.run * o.speedRef : Math.hypot(s.vx || 0, s.vy || 0);   // run: 0..1 runs in place (an RPG \\'run away\\', a treadmill)\\n    // traversal: hang from a ledge (hangZ: its top above the feet), a sneaking crouch while moving, a sprint\\'s lean, and a\\n    // heavy landing from land(); a roll (flip) turns the whole body after posing\\n    this._hangW = approach(this._hangW || 0, s.hang ? 1 : 0, dt * 14); if (s.hang) this._hangZ = s.hangZ;\\n    this._sneakW = approach(this._sneakW || 0, s.crouch ? 1 : 0, dt * 8); this._sprintW = approach(this._sprintW || 0, s.sprint ? 1 : 0, dt * 6);\\n    if (s.land > 0 && this._landT === undefined) this.land(s.land);   // (an action\\'s landing step)\\n    if (this._landT !== undefined) {\\n      const k = this._landK, lt = this._landT += dt, dur = .22 + .3 * Math.min(1, k);\\n      this._landW = lt < .05 ? lt / .05 * k : lt < dur ? k * (1 - ease.inOut((lt - .05) / (dur - .05))) : 0;\\n      if (lt >= dur) this._landT = undefined;\\n    }\\n    this._spW = approach(this._spW, clamp(speed / o.speedRef, 0, 1.25), dt * 7);\\n    if (speed > 3 && !s.run) {\\n      const c = Math.cos(this.facing), sn = Math.sin(this.facing), k = Math.min(1, dt * 10), vx = +s.vx || 0, vy = +s.vy || 0;   // (vx alone, or a NaN, is no move on that axis: never a NaN gait)\\n      this._mv[0] = lerp(this._mv[0], (vx * c + vy * sn) / speed, k); this._mv[1] = lerp(this._mv[1], (-vx * sn + vy * c) / speed, k);\\n    }\\n    this.phase += dt * speed / (o.stride * o.size * this._strideK() * Math.max(.4, Math.min(1, this._spW)));\\n    this._dashW = approach(this._dashW, s.dash ? 1 : 0, dt * (s.dash ? 24 : 8));\\n    this.hurtW = approach(this.hurtW, s.hurt ? 1 : 0, dt * 14);\\n    this._atkW = approach(this._atkW, s.attack ? 1 : 0, dt * (s.attack ? 30 : 7));\\n    this._airW = approach(this._airW, s.air ? 1 : 0, dt * (s.air ? 10 : 18));\\n    // held poses: \\'cheer\\' (item get, victory), \\'cast\\' (both hands forward), \\'guard\\' (fists up), \\'kneel\\', \\'crouch\\', \\'wave\\', \\'hips\\'\\n    // (hands on hips), and down: 0..1 (knocked flat). stance: \\'guard\\' (fists up while moving) | \\'ready\\' (weapon held forward)\\n    const pk = this.poseW || (this.poseW = { cheer: 0, cast: 0, guard: 0, kneel: 0, crouch: 0, wave: 0, hips: 0, block: 0 });\\n    for (const k in pk) pk[k] = approach(pk[k], s.pose === k ? 1 : 0, dt * 9);\\n    this._stW = approach(this._stW || 0, s.stance === \\'guard\\' ? 1 : 0, dt * 10); this._rdW = approach(this._rdW || 0, s.stance === \\'ready\\' ? 1 : 0, dt * 10);\\n    this._climbW = approach(this._climbW || 0, s.climb ? 1 : 0, dt * 12); if (s.climb) this._climbP = (this._climbP || 0) + dt * Math.hypot(s.vz || 0, s.vx || 0, s.vy || 0) / (.4 * (o.armUpper + o.armLower) * o.size) * Math.PI;   // hands keep pace with the climb   // climb: hand over hand on a ladder\\n    this.dieT = s.pose === \\'die\\' ? (this.dieT || 0) + dt : 0;   // pose \\'die\\': a stagger, the knees give, then the body topples\\n    const dT = s.down !== undefined ? clamp(+s.down, 0, 1) : s.pose === \\'down\\' || this.dieT > .45 ? 1 : 0;\\n    /** downW: how far down it is, 0..1 (state down, pose \\'down\\' or \\'die\\'): it falls faster and faster and gets up steadily */\\n    this.downW = approach(this.downW || 0, dT, dt * (dT > (this.downW || 0) ? 2.5 + 10 * (this.downW || 0) : 3.2));\\n    if (this.dieT > 0) { this.hurtW = approach(this.hurtW, this.dieT < .25 ? 1 : 0, dt * 14); pk.kneel = approach(pk.kneel, this.dieT > .2 && this.dieT < .6 ? 1 : 0, dt * 10); }\\n    this._pointW = approach(this._pointW, s.point ? 1 : 0, dt * (s.point ? 30 : 8));\\n    this._aimA = approach(this._aimA || 0, s.aim || 0, dt * 14);   // aim: radians above (+) or below (-) level while pointing\\n    if (s.attack) this._kicking = !!s.attack.spec.kick;\\n    this.blink -= dt; if (this.blink < -.12) this.blink = 2 + this._rnd() * 3;\\n    this.sqV += (-260 * this.sq - 15 * this.sqV) * dt; this.sq = clamp(this.sq + this.sqV * dt, -.3, .3);\\n\\n    const A = s.attack; let tLean = 0, tTwist = 0, tLunge = 0, tHop = 0, tCrouch = 0, armT = A ? 1 : 0;\\n    this.spin = 0;\\n    // side views swing weapons in the screen plane (an overhead chop), ground views in the ground plane.\\n    // spec.plane or the rig option swingPlane (\\'side\\' | \\'ground\\') choose it yourself.\\n    this._sidePlane = !!A && !A.spec.kick && (A.spec.plane ? A.spec.plane === \\'side\\' : o.swingPlane ? o.swingPlane === \\'side\\' : this._pitch !== undefined && this._pitch < 15 && !!o.weapon && A.spec.blade !== 0 && A.spec.hand !== \\'L\\');\\n    if (A) {\\n      // wind: anticipation (pull back, crouch). active: the strike, with a lunge, lead-foot step, lean, twist and hop.\\n      // recover: follow through, hold the end pose, then blend back to the stance by position (never swing backwards)\\n      const sp = A.spec, side = this._sidePlane, rest = side ? -.9 : 1.1, RS = sp.rel ? (o.armUpper + o.armLower) / 9.2 : 1, R = (sp.reach || 7.5) * RS, r0 = sp.r0 === undefined ? R : sp.r0 * RS, r1 = sp.r1 === undefined ? R : sp.r1 * RS;\\n      /** atkRel: the attack\\'s heights are relative to the shoulders (its spec\\'s rel) */\\n      this._atkRel = !!sp.rel; const zRest = sp.rel ? (sp.kick ? .1 : -7) : 9, z0 = sp.z0 === undefined ? zRest : sp.z0, z1 = sp.z1 === undefined ? z0 : sp.z1;   // side-plane moves have no heights\\n      // lunge / hop / crouch are body motion in local units, clamped so a game\\'s own \\'lunge\\' speed field can\\'t stretch the rig\\n      const hold = sp.hold === undefined ? .3 : sp.hold, lean = sp.lean === undefined ? (sp.kick ? -.22 : .3) : clamp(sp.lean, -.8, .8), lunge = sp.lunge === undefined ? (sp.kick ? .4 : 1.2) : clamp(sp.lunge, -4, 5);\\n      if (A.phase === \\'wind\\' && (this._aPh !== \\'wind\\' || this._aSp !== sp)) {   // a chained hit starts where the arm is\\n        const chain = (this._armW || 0) > .3 && this._theta !== undefined, fists = !o.weapon || sp.hand === \\'L\\' || sp.blade === 0;\\n        this._th0 = chain ? this._theta : rest; this._z0 = chain && this._atkRel === !!sp.rel && isFinite(this.atkZ) ? this.atkZ : fists ? z0 : zRest; this._r0 = chain ? this.reach : R * .75;\\n        const J = this.J; if (J.handR) this._from = { R: J.handR.slice(), L: J.handL.slice(), bd: J.bladeDir.slice() };   // the wind blends from the real pose: no snaps\\n      }\\n      this._aPh = A.phase; this._aSp = sp; this._atkHand = sp.hand || \\'R\\'; if (A.phase !== \\'wind\\') this._windK = 1;\\n      if (A.phase === \\'wind\\') {\\n        const k = ease.outQuad(A.u);\\n        this._theta = lerp(this._th0, sp.a0, k); this.atkZ = lerp(this._z0, z0, A.u); this.reach = lerp(this._r0, r0, k); this._windK = k;\\n        tLean = -Math.abs(lean) * .45; tLunge = -lunge * .3 * k; tCrouch = clamp(sp.crouch === undefined ? (sp.kick ? 0 : .15) : sp.crouch, 0, 1) * k;   // coil: lean back, draw back, dip\\n      } else if (A.phase === \\'active\\') {\\n        const k = ease.outCubic(A.u);\\n        this._theta = sp.spin ? sp.a0 : lerp(sp.a0, sp.a1, k); this.atkZ = lerp(z0, z1, k); this.reach = lerp(r0, r1, k);\\n        tLean = lean; tLunge = lunge * k; tH