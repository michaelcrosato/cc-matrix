 -> screen pixels [x, y] (the HUD\\'s space, with no camera), or null without a canvas */\\n  screenPoint(cx, cy) {\\n    const S = this.screen; if (!S.canvas) return null;\\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\\n  }\\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step\\'s pressed() and\\n   *  released() (the engine calls it every step) */\\n  tick(dt) {\\n    this._suppressed.clear();\\n    this.clock += dt;\\n    let pads = [];\\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === \\'any\\' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn\\'t)\\n    const p = this.pad === null ? null : Array.from(pads || []).find(p => ok(p) && p.index === this.padIndex) || Array.from(pads || []).find(ok);\\n    this.padLost = false;\\n    if (!p || p.index !== this.padIndex || p.id !== this.padId) {\\n      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === \\'gamepad\\'; this.stopRumble(); }   // unplugged while in use\\n      if (this.padIndex !== null) { this.padPrev.forEach((on, i) => { if (on) this.release(\\'Pad\\' + i); }); for (const c of [\\'PadAxisUp\\', \\'PadAxisDown\\', \\'PadAxisLeft\\', \\'PadAxisRight\\', \\'PadRAxisUp\\', \\'PadRAxisDown\\', \\'PadRAxisLeft\\', \\'PadRAxisRight\\']) this.release(c); }   // (a pad gone or changed lets go once; with none, a script\\'s pad codes stay held)\\n      this.padPrev = []; this.padMove = [0, 0]; this.padAim = null; this.padAxes = []; this.padValues = [];\\n      this.padIndex = p ? p.index : null; this.padId = p ? p.id : \\'\\';\\n      if (this.aimSource === \\'pad\\') this.aimSource = \\'move\\';\\n    }\\n    if (p) {\\n      const dz = (x, y) => { const l = Math.hyp