oices remain yours.\"],[\"Couch co-op\",\"Choose Co-op with two pads, or keyboard/mouse plus a pad. Each pane has independent stations. A busy station requests a handover: its owner presses T / Cross to accept. Flight-command permission follows the pilot. Options pauses both panes.\"],[\"Online\",\"AI Hub supplies remote 1\\\\u20132 player co-op. The host runs one bomber; guests send station/input commands. Local overlays leave the sortie running. Standalone co-op is local; internet room hosting is supplied by AI Hub.\"]]}pauseActions(){return[[\"Crew handbook\",()=>this.ui.show(\"help\")],[\"Dev Mode\",()=>this.dev()],...this.app.session.active?[]:[[\"Flight school\",()=>this.practiceMenu()],[\"Abort to debrief\",()=>{this.ui.hide(),this.app.sim.finish(\"abort\")}]],[\"About / Credits\",()=>this.about()]]}title(){let A=this.app;this.ui.hide(),this.ui.show(\"title\",{kicker:\"A FOUR-ENGINE ARCADE SORTIE\",name:`B-17\\nBOMBER BUDDY`,subtitle:\"Deliver the parcel. Bring the crew home.\",text:\"One aircraft. Six stations. Everyone counts.\",actions:[[\"Play\",()=>this.brief(!1)],[\"Co-op\",()=>this.coop()],[\"Flight school\",()=>this.practiceMenu()],[\"Settings\",()=>this.ui.show(\"settings\")],[\"About / Credits\",()=>this.about()]],meta:[\"1\\\\u20132 CREW\",\"12 MINUTES\",\"ORIGINAL PROCEDURAL ART\"],footer:\"Inspired by B-17 Bomber \\\\xB7 1982\",back:()=>this.title()}),A.resetIdle()}brief(A=this.app.coop){this.app.coop=A,this.app.mode=\"brief\",this.ui.hide(),this.ui.show(\"briefing\",{kicker:\"CHANNEL COMMAND / 06:40\",title:\"Operation Tidemark\",text:\"Disable two military components at Kestrel Shipyard. Return to Larkspur. The coastal battery and Cinder Works are optional.\",actions:[[\"Route: \"+this.app.setup.route.toUpperCase(),()=>{this.app.setup.route=this.app.setup.route===\"direct\"?\"dogleg\":\"direct\",this.app.sim.selectRoute(this.app.setup.route,!1),this.brief(A)}],[\"Payload: \"+MQ[this.app.setup.loadout].name,()=>{this.app.setup.loadout=(this.app.