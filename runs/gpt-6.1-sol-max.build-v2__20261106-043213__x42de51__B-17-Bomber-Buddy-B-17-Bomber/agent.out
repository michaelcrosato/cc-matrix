ject.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\n  for (const k of ['glyphs', 'deadzone', 'invertAimY', 'invertMoveX', 'invertMoveY', 'rumbleScale']) q[k] = this.input[k];   // (the player's settings: button symbols, dead zone, aim, the move stick, vibration)\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  _pClaim(this);\n};\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\n- `input.unbind(a, device)` †: take away action a's codes for one device ('keys' or 'pad'); the arrow keys and d-pad stay on the moves\n- `input.use(map)`: switch key layout at runtime: input.use(E.Input.PLATFORMER) or input.use('SHMUP'). The player's own bindings (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER, THIRDPERSON, SHMUP) has the moves (up, down, left, right) and the menu's actions (start, pause, confirm, cancel). The keys held stay held (down() in the new layout, not pressed() again), and a press no step has seen counts in it\n- `input.value(a)` †: how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1\n- `input.zoom()` †: the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy)\n- `input.zoomPoint()` †: [x, y] where the last zoom was asked for: the mouse pointer for the wheel, between the fingers for a pinch; null when the keys zoomed (about the screen's middle)\n- `input.aimSource = 'move'` †: what aims right now: 'move' | 'mouse' | 'pad'\n- `input.clock = 0`: seconds of input time (the steps' dt added up)\n- `input.deadzone = .18`: how far a gamepad stick moves before it counts (0..0.8)\n- `input.glyphs = 'auto'`: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' | 'nintendo' | 'generic' (positions)\n- `input.held`: the key and button codes down right now ('KeyD', 'Mouse0', 'Pad0', 'Act:jump')\n- `input.invertMoveX`, `input.invertMoveY = false` †: the move stick turned round (the Controller settings)\n- `input.keysTo = null` †: the other players' inputs the keyboard's codes go to as well (players sharing it, each with half its keys: game.players)\n- `input.lastDevice = 'keyboard'`: 'keyboard' | 'mouse' | 'gamepad' | 'touch', the last one used (show the right button prompts)\n- `input.map`: each action's codes ({ jump: ['Space', 'Pad0', 'Act:jump'] }); every action also answers to 'Act:<name>' (DOM buttons with data-act, tap, hold)\n- `input.mouse`: { cx, cy } its page position, active once it has moved over the canvas, t the input clock when it last moved\n- `input.names = null` †: the actions' names on the Controls screen ({ attack: 'Sword' }; false hides one from rebinding: the game's menu.controls); onBindings(b): called with the player's new bindings (the game saves and applies them)\n- `input.pad = 'any'` †: the gamepad this input reads: 'any' (the first connected one another player hasn't: player 1's), an index (a joined player's own), or null (none)\n- `input.padAim = null` †: its right stick, or null when centered\n- `input.padAxes = []` †: the gamepad's raw axes\n- `input.padId = ''`, `input.padIndex = null`: the gamepad in use (null and '' without one)\n- `input.padLost = false`: true for the step after the gamepad in use was unplugged (a pausable scene pauses)\n- `input.padMove = [0, 0]`: the gamepad's left stick after the dead zone\n- `input.padPrev = []`: which gamepad buttons were down at the last step\n- `input.padValues = []` †: each gamepad button's travel, 0 to 1 (the triggers; input.value reads them)\n- `input.preset` †: the layout last given to use() (E.Input.DEFAULT, PLATFORMER, SHMUP or your own)\n- `input.rumbleScale = .6` †: vibration strength 0..1 (0 = off; game.settings.rumble sets it)\n- `input.screen`: the game's screen (mouse positions are read through it)\n- `input.steer = 'stick'` †: 'stick' (a stick drawn under the thumb) or 'drag' (a finger anywhere on the screen but the buttons steers by drag(), with no stick drawn: a shooter's ship that follows the thumb)\n- `input.stick = [0, 0]` †: the touch stick's direction [x, y], length <= 1\n- `input.stickDeadzone = .12` †: the part of that radius a thumb moves before the stick counts (0..0.5)\n- `input.stickId` †: the pointer (finger) holding the touch stick\n    const sh = this.shell, s = this.scene, I = this.input, fs = this.fullscreen, open = !!(sh && sh.screen);\n    const main = !!s && (!!s.pausable || this.sceneName === 'main'), play = main && !this.paused, near = performance.now() - (this._mouseTop || -1e9) < 2500;\n    const touch = I._touched || !!(this._coarse || (this._coarse = window.matchMedia && matchMedia('(pointer: coarse)')) || {}).matches;   // (the query kept: this runs every frame)\n    const showM = !open && (this.o.menu !== false ? (!!(sh && sh._menu()) || main) && (!play || near || touch) : !!I._touchEl);   // (menu: false: the touch START alone)\n    const showF = this.o.fullscreen !== false && fs.supported && !fs.standalone && !open && (!play || near);\n    const key = (showM ? 1 : 0) + (showF ? 2 : 0) + (fs.on ? 4 : 0);\n    if (key === this._cornerKey) return; this._cornerKey = key;\n    const [m, f] = c.children; c.style.display = showM || showF ? 'flex' : 'none'; m.style.display = showM ? 'grid' : 'none'; f.style.display = showF ? 'grid' : 'none';\n    f.innerHTML = cornerIcon(fs.on ? CORNER_ICONS.exit : CORNER_ICONS.full); f.setAttribute('aria-label', fs.on ? 'Leave full screen' : 'Full screen'); f.title = f.getAttribute('aria-label');\n  }\n  _applyView() {\n    const b = this.baseView, z = this.zoom || 1, y = b.pitchDeg < 5 ? 0 : (this.yaw || 0);\n    if (z === 1 && !y) this.view = b;\n    else {\n      const key = b.id + ':' + b.yawDeg + ':' + b.pitchDeg + ':' + b.scale + ':' + b.zBoost + ':' + z + ':' + y, vc = this._vc || (this._vc = new Map());\n      let v = vc.get(key);\n      if (!v) { v = new View(b.id, b.label, b.yawDeg + y, b.pitchDeg, b.scale * z, b.zBoost); v.zoom = z; vc.set(key, v); }\n      this.view = v;\n    }\n    this.cam.snap = true;\n    for (const f of this._viewListeners) f(this.view);\n  }\n  /** cycle through game.views (or every view): bind it to a key for players who like to switch */\n  nextView(dir = 1) { const list = this.views || E.VIEW_ORDER, i = list.indexOf(this.baseView.id); this.setView(list[((i + dir) % list.length + list.length) % list.length]); }\n  /** call f(view) whenever the view changes (re-bake caches, move HUD) */\n  onView(f) { this._viewListeners.push(f); }\n  /** shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's\n   *  settings.shake */\n  shake(a) { if (!this.reduceMotion) this._shakeAmt = Math.min(10, this._shakeAmt + a * clamp(this.settings.shake, 0, 1)); }\n  /** how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own\n   *  (a 3D world's) shakes by it */\n  get shaking() { return this._shakeAmt; }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"sed -n '2838,2880p' vendor/engine-repo/dist/handoff/my-3d2dge.js && sed -n '2955,3008p' vendor/engine-repo/dist/handoff/my-3d2dge.js && rg -n 'isHost|me:|server' vendor/hub-repo/lib/hub/session.js | head -10\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"sed -n '2838,2880p' vendor/engine-repo/dist/handoff/my-3d2dge.js && sed -n '2955,3008p' vendor/engine-repo/dist/handoff/my-3d2dge.js && rg -n 'isHost|me:|server' vendor/hub-repo/lib/hub/session.js | head -10\"","aggregated_output":"   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    const step = this.o.step; let n = 0;\n    try {\n      while (this._acc > step - 1e-9) {   // (the tolerance absorbs the rounding in frame times: 1/60 s is two steps)\n        this._acc -= step; this._wall += step;   // (_wall: seconds stepped through, unscaled: slow motion or a stop doesn't hold up the player's zoom)\n        const k = this.timeScale > 1 ? Math.ceil(this.timeScale - 1e-9) : 1, h = step * Math.max(0, this.timeScale) / k;\n        for (let i = 0; i < k; i++, n++) this._step(h);\n      }\n      if (!n && !this._stepped) { n++; this._step(0); }   // the first frame updates before it draws, even when its time is short\n    } catch (e) { this._acc %= step; this.fail('update', e); }   // an error drops the frame's other steps, as before\n    if (n) this._stepped = true;\n    if (this._acc < 0) this._acc = 0;\n    this.alpha = this._acc / step;\n    return n;\n  }\n  /**\n   * switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another\n   * number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or\n   * 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each\n   * scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n   */\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n  }\n  // cam.free: the keys and a stick, the screen's edges, a drag, a zoom toward its point; the focus kept to bounds\n  _freeCam(dt) {\n    const c = this.cam, F = c.free === true ? {} : c.free, I = this.input, S = this.screen, z = this._zoomTo || this.zoom;\n    let dx = 0, dy = 0, moved = false;\n    if (F.keys !== false && !(this.shell && this.shell.screen) && !I.stickOn) { const m = I.move(), sp = (F.speed || 300) * dt; dx += m[0] * sp; dy += m[1] * sp; }   // (a finger pans by its drag, not as a stick)\n    const p = I.pointer(), e = F.edge === undefined ? 10 : F.edge;\n    if (e > 0 && p && I.lastDevice !== 'touch' && I.mouse.active && !I._fedAt) { const sp = (F.speed || 300) * dt; if (p[0] < e) dx -= sp; else if (p[0] > S.W - e) dx += sp; if (p[1] < e) dy -= sp; else if (p[1] > S.H - e) dy += sp; }\n    const pan = F.drag !== false && I.pan(); if (pan) { dx -= pan[0]; dy -= pan[1]; moved = true; }\n    if (dx || dy) { const [gx, gy] = this._screenToGround(dx, dy); c.tx += gx; c.ty += gy; moved = true; }\n    // a zoom keeps the world point under its pointer (or pinch) where it was: the focus moves toward it by (1 - 1/k) of the way\n    const was = c._freeZ || z; c._freeZ = z;\n    if (z !== was && F.zoomAt !== false) { const q = I.zoomPoint(); if (q) { const k = z / was, [gx, gy] = this._screenToGround((q[0] - S.W / 2) * (1 - 1 / k) * k, (q[1] - S.H / 2) * (1 - 1 / k) * k); c.tx += gx; c.ty += gy; moved = true; } }\n    const b = F.bounds; if (b) { c.tx = clamp(c.tx, b[0], b[2]); c.ty = clamp(c.ty, b[1], b[3]); }\n    if (moved) c.snap = true;\n  }\n  _frame() {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    const c = this.cam, s = this._shakeAmt;\n    const shx = s > .05 ? (Math.sin(this.real * 83) + Math.sin(this.real * 57.3)) * .5 * s : 0, shy = s > .05 ? (Math.sin(this.real * 71) + Math.sin(this.real * 49.7)) * .5 * s : 0;\n    const sc = this.scene;\n    if (this._split && HOOKS.frame) HOOKS.frame(this, shx, shy);   // a split screen: the scene drawn in each viewport (section 10j)\n    else { this.lights._clear(); this.r._begin(c.x + shx, c.y + shy); if (sc && sc.draw) sc.draw(this.r); }\n    if (this.shownNote && this.real < this.shownNote.end) { const n = this.shownNote; this.r.overlay(g => E.font.text(g, n.text, this.r.W / 2, 3, '#ffffff', { align: 'center', shadow: '#000', outline: false, font: 'tiny' })); }\n    if (this.settings.showFps) { const st = this.stats, t = this.fps + ' FPS  ' + this.hz + ' HZ' + (this.drawEvery > 1 ? ' (EVERY ' + this.drawEvery + ')' : '') + '  ' + (st.updateMs + st.renderMs).toFixed(1) + ' MS';   // Settings, Display\n      this.r.overlay(g => { const w = E.font.width(t, { font: 'tiny' }) + 6; g.fillStyle = '#000000b0'; g.fillRect(Math.round(this.r.W / 2 - w / 2), 0, w, 9); g._c = null; E.font.text(g, t, this.r.W / 2, 2, '#9cff9c', { align: 'center', outline: false, font: 'tiny' }); }); }\n    this._cornerSync();\n    if (this.paused && this.pauseOverlay && !(this.shell && this.shell._sys && this.shell.screen)) this.r.overlay(g => {\n      const r = this.r; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._checker, 'repeat'); else { g.fillStyle = '#05030c'; g.globalAlpha = .55; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null;\n      E.font.text(g, this._players && this._players.length > 1 && this.pausedBy ? 'P' + this.pausedBy + ' PAUSED' : 'PAUSED', r.W / 2, r.H / 2 - 8, '#ffffff', { align: 'center', scale: 2 });   // (several players: who)\n      E.font.text(g, 'PRESS ESC OR START', r.W / 2, r.H / 2 + 8, '#c9c0e0', { align: 'center' });\n    });\n    const fx = this._flash;\n28:    me: null,\n30:    isHost: false,\n242:      hub.isHost = m.me === m.host;\n422:  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n441:    if (!hub.isHost) return warn('finish is for the host only');\n","exit_code":0,"status":"completed"}}
