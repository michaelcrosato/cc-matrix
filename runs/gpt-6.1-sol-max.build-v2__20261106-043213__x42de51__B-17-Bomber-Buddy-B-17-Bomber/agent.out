ue when it picked or cancelled */\n  update() {\n    if (!this.active || !this.items.length) return false;\n    this._layout();\n    const P = this.input ? [this.input] : this.game._players || [this.game.input], inp = P[0], any = f => P.some(f), n = this.items.length, old = this.i, b = this._box;\n    const row = p => { if (!b || !p || p[0] < b.x || p[0] >= b.x + b.w) return -1; const r = Math.floor((p[1] - b.y) / b.rowH), k = b.first + r; return r >= 0 && r < b.vis && k < n && !this._off(this.items[k]) ? k : -1; };\n    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\n    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\n    if (inp.mouse.t !== this._mt) { this._mt = inp.mouse.t; const k = row(inp.pointer()); if (k >= 0) this.i = k; }   // the mouse moved over an entry\n    const tap = row(inp.clicked());   // a click or tap on an entry picks it\n    if (tap >= 0) this.i = tap;\n    if (this.i !== old) { if (this.sound) this.game.audio.sfx('select'); if (this.onMove) this.onMove(this.i, this.items[this.i]); }\n    if ((any(I => I.pressed('confirm')) || tap >= 0) && !this._off(this.items[this.i])) { if (this.sound) this.game.audio.sfx('confirm'); P.forEach(I => I.consumeAll()); if (this.onPick) this.onPick(this.i, this.items[this.i]); return true; }\n    if (any(I => I.pressed('cancel')) && this.onCancel) { if (this.sound) this.game.audio.sfx('cancel'); P.forEach(I => I.consumeAll()); this.onCancel(); return true; }\n    return false;\n  }\n  /** draw it to the overlay */\n  draw(r) {\n    r.overlay(g => {\n      const { labels, w, h, x, y, top: yy, rowH, k: K, first, vis } = this._layout(), T = { outline: false, shadow: '#05040a', scale: K };\n      if (this.box) E.ui.box(g, x, y, w, h, { bg: this.bg, border: this.border });\n      if (this.title) E.font.text(g, this.title, x + w / 2, y + 5 * K, this.pick, { align: 'center', outline: false, shadow: '#05040a', scale: K });\n      const blink = Math.floor(this.game.real * 3) % 2 === 0;\n      labels.slice(first, first + vis).forEach((l, r) => {\n        const k = first + r, sel = k === this.i && this.active, off = this._off(this.items[k]);\n        if (sel) px.rect(g, x + 3 * K, yy + r * rowH - 2 * K, w - 6 * K, rowH, shade(Array.isArray(this.bg) ? this.bg[0] : this.bg, .22));\n        E.font.text(g, l, x + 14 * K, yy + r * rowH, off ? this.dim : sel ? this.pick : this.color, T);\n        if (sel && blink) E.font.text(g, '▸', x + 6 * K, yy + r * rowH, this.pick, { scale: K, outline: false });\n      });\n      if (first > 0) E.font.text(g, '▲', x + w - 9 * K, yy, this.dim, T);   // (more above and below)\n      if (first + vis < labels.length) E.font.text(g, '▼', x + w - 9 * K, yy + (vis - 1) * rowH, this.dim, T);\n    });\n  }\n}\nE.Menu = Menu;\n","exit_code":0,"status":"completed"}}
