}\n sound.unlock();\n if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();\n if(e.code==='Escape'||e.code==='KeyP'){if(menu&&mode==='playing'){back();}else pause();return;}\n if(menu){if(e.code==='ArrowDown'||e.code==='KeyS')menuMove(1);if(e.code==='ArrowUp'||e.code==='KeyW')menuMove(-1);if(e.code==='ArrowLeft')menuAdjust(-1);if(e.code==='ArrowRight')menuAdjust(1);if(e.code==='Enter'||e.code==='Space'){document.activeElement?.click();}return;}\n if(\"'!keys.has(e.code))pressed.add(e.code);keys.add(e.code);\n});\ndocument.addEventListener('\"'keyup',e=>keys.delete(e.code));\nwindow.addEventListener('blur',()=>{keys.clear();mouse.down=false;if(\"'!network.active&&mode==='\"'playing'&&\"'!menu)pause();});\n$('\"'touch-menu').onclick=()=>pause();\"'$('\"'touch-action').addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();pressed.add('KeyE');sound.unlock();noteInput('touch');});\nwindow.addEventListener('contextmenu',e=>e.preventDefault());\nconst canvas=\"'$('\"'game');\ncanvas.addEventListener('pointerdown',e=>{\n if(noteInput(e.pointerType==='touch'?'touch':'keyboard'))return;sound.unlock();\n if(menu)return;\n if(e.pointerType==='touch'){\n canvas.setPointerCapture(e.pointerId);\n if(e.clientX<innerWidth*.53&&touch.id===null){Object.assign(touch,{id:e.pointerId,ox:e.clientX,oy:e.clientY,x:0,y:0});const ring=\"'$('\"'touch-ring');ring.style.left=\"'`${e.clientX-50}px`;ring.style.top=`${e.clientY-50}px`;ring.style.display='\"'block';}\n else{touch.fireId=e.pointerId;touch.aimX=e.clientX;touch.aimY=e.clientY;}\n }else{mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true;if(e.button===0)mouse.down=true;if(e.button===2)pressed.add('KeyE');}\n});\nwindow.addEventListener('pointermove',e=>{\n if(e.pointerType==='touch'){\n if(e.pointerId===touch.id){touch.x=clamp((e.clientX-touch.ox)/60,-1,1);touch.y=clamp((e.clientY-touch.oy)/60,-1,1);}\n if(e.pointerId===touch.fireId){touch.aimX=e.clientX;touch.aimY=e.clientY;}\n }else{if(Math.abs(mouse.x-e.clientX)+Math.abs(mouse.y-e.clientY)>3)noteInput('keyboard');mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true;}\n});\nwindow.addEventListener('pointerup',e=>{if(e.pointerId===touch.id){touch.id=null;touch.x=touch.y=0;\"'$('\"'touch-ring').style.display='none';}if(e.pointerId===touch.fireId)touch.fireId=null;if(e.button===0)mouse.down=false;});\nwindow.addEventListener('pointercancel',()=>{touch.id=touch.fireId=null;touch.x=touch.y=0;mouse.down=false;\"'$('\"'touch-ring').style.display='none';});\nwindow.addEventListener('gamepadconnected',()=>{noteInput('pad');toast('CONTROLLER CONNECTED','Left stick to fly. Cross to lift.');});\nfunction pollInput(){\n input={move:0,fly:0,down:0,fire:false,bomb:false,scan:false};\n const pads=navigator.getGamepads?.()||[];const pad=[...pads].find(p=>p?.connected);\n if(pad){\n const b=pad.buttons.map(x=>x.pressed),a=pad.axes||[];const dz=v=>Math.abs(v||0)>.16?v:0;\n const activity=b.some((v,i)=>v&&\"'!padPrevious[i])||Math.abs(dz(a[0]))+Math.abs(dz(a[1]))+Math.abs(dz(a[2]))+Math.abs(dz(a[3]))>.1;\n if(activity&&noteInput('\"'pad')){padPrevious=b;return;}\n const edge=i=>b[i]&&\"'!padPrevious[i];\n if(edge(9)&&!b[8]){if(menu&&mode==='\"'playing')resume();else pause();}\n if(menu){\n const now=performance.now();\n if((b[12]||dz(a[1])<-.55)&&now>padNavAt){menuMove(-1);padNavAt=now+200;}\n if((b[13]||dz(a[1])>.55)&&now>padNavAt){menuMove(1);padNavAt=now+200;}\n if((b[14]||dz(a[0])<-.55)&&now>padNavAt){menuAdjust(-5);padNavAt=now+140;}\n if((b[15]||dz(a[0])>.55)&&now>padNavAt){menuAdjust(5);padNavAt=now+140;}\n if(edge(0))document.activeElement?.click();if(edge(1)&&menu\"'!=='\"'title'&&menu\"'!=='\"'hub-wait')back();\n }else{\n input.move=dz(a[0]);input.fly=Math.max(b[0]?1:0,-dz(a[1]));input.down=Math.max(0,dz(a[1]));input.fire=b[7]||b[2];input.bomb=edge(5)||edge(1);input.scan=edge(3);\n if(Math.hypot(dz(a[2]),dz(a[3]))>.25){const l=Math.hypot(a[2],a[3]);aim={x:a[2]/l,y:-a[3]/l};}\n }\n padPrevious=b;\n }\n if(\"'!menu&&lastInput!=='\"'pad'){\n input.move=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0);\n input.fly=keys.has('Space')||keys.has('KeyW')||keys.has('ArrowUp')?1:0;input.down=keys.has('KeyS')||keys.has('ArrowDown')?1:0;\n input.fire=mouse.down||keys.has('KeyJ')||keys.has('KeyZ');input.bomb=pressed.has('KeyE')||pressed.has('KeyX');input.scan=pressed.has('KeyQ');\n if(touch.id\"'!==null){input.move=touch.x;input.fly=Math.max(0,-touch.y);input.down=Math.max(0,touch.y);}\n if(touch.fireId!==null)input.fire=true;\n if((mouse.active&&lastInput==='\"'keyboard')||touch.fireId\"'!==null){\n const mx=touch.fireId!==null?touch.aimX:mouse.x,my=touch.fireId!==null?touch.aimY:mouse.y;\n rayPoint.set(mx/innerWidth*2-1,-my/innerHeight*2+1,0).unproject(camera);const pos=playerBody?.translation();if(pos){const dx=rayPoint.x-pos.x,dy=rayPoint.y-pos.y,l=Math.hypot(dx,dy);if(l>.2)aim={x:dx/l,y:dy/l};}\n }else aim={x:facing,y:0};\n }\n pressed.clear();\n}\n\nfunction initSettings(){\n for(const id of ['\"'music','sfx','shake']){\"'$(id).value=settings[id];$(id).oninput=()=>{settings[id]=+$(id).value;$(`${id}-val`).value=`${settings[id]}%`;sound.setMusic(settings.music/100);sound.setSfx(settings.sfx/100);};}\n $('\"'glyph-toggle').onclick=()=>{settings.glyphs=settings.glyphs==='ps'?'xbox':'ps';\"'$('\"'glyph-toggle').textContent=settings.glyphs==='ps'?'PlayStation':'Xbox';updatePrompts();};\n \"'$('\"'assist-toggle').onclick=()=>{settings.assist=\"'!settings.assist;$('\"'assist-toggle').textContent=settings.assist?'On':'Off';};\n const sliders=[['flightSpeed','Flight speed',3,12,.1],['fuelDrain','Fuel drain / second',0,30,.5],['enemySpeed','Creature speed',.2,2.5,.1],['bombRadius','Charge blast radius',2,7,.1],['damage','Damage multiplier',0,2,.25],['gravity','Cave gravity',6,28,.5]];\n for(const [id,label,min,max,step] of sliders){const wrap=document.createElement('label');wrap.className='setting';wrap.innerHTML=\"'`${label}<output id=\"dev-${id}-val\">${tuning[id]}</output><input id=\"dev-${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[id]}\">`;$('\"'dev-sliders').append(wrap);wrap.querySelector('input').oninput=e=>{training=true;tuning[id]=+e.target.value;\"'$(`dev-${id}-val`).value=tuning[id];if(world)world.gravity.y=-tuning.gravity;};}\n $('\"'god-toggle').onclick=()=>{god=\"'!god;training=true;syncDev();};$('\"'fuel-toggle').onclick=()=>{infiniteFuel=\"'!infiniteFuel;training=true;syncDev();};$('\"'physics-toggle').onclick=()=>{physicsDebug=\"'!physicsDebug;syncDev();if(debugLines)debugLines.visible=physicsDebug;};\n}\nfunction syncDev(){for(const k in tuning){$(`dev-${k}`).value=tuning[k];$(`dev-${k}-val`).value=tuning[k];}$('\"'god-toggle').textContent=god?'On':'Off';\"'$('\"'fuel-toggle').textContent=infiniteFuel?'On':'Off';\"'$('\"'physics-toggle').textContent=physicsDebug?'On':'Off';}\nfunction fillAbout(){\n const names={date:'Date',source:'Source',plan:'Plan',genre:'Genre',perspective:'Perspective',tech:'Tech',artDirection:'Art direction',animation:'Animation',audio:'Audio',online:'Online',testing:'Testing',research:'Research',environment:'Environment',model:'Model',usage:'Usage'};\n const root=\"'$('\"'about-content');\n const p=document.createElement('p');p.textContent='An original tribute to the cave rescue spirit of H.E.R.O. (1984). H.E.R.O. was created by John Van Ryzin and published by Activision. This fan-made work is unaffiliated.';root.append(p);\n const d=document.createElement('div');for(const [key,val] of Object.entries(META.sourceInformation)){const row=document.createElement('p'),b=document.createElement('b');b.textContent=(names[key]||key)+': ';row.append(b,document.createTextNode(val));d.append(row);}root.append(d);\n const questionSets={testingFeedback:['Issues caught','Critical / game breaking issues','Most helpful test','Least helpful test'],engineFeedback:['Liked most','Stuck or wrong guesses','Most important custom system','Hardest engine task','Engine changes','One desired engine change'],promptFeedback:['Liked most','Confusing','Hardest task','Suggested prompt change']};\n for(const key of ['testingFeedback','engineFeedback','promptFeedback']){const h=document.createElement('h3');h.textContent=key.replace('Feedback',' Feedback').replace(/\"'^./,c=>c.toUpperCase());root.append(h);META[key].forEach((answer,i)=>{const row=document.createElement('\"'p');const b=document.createElement('b');b.textContent=questionSets[key][i]+': ';row.append(b,document.createTextNode(answer));root.append(row);});}\n const license=document.createElement('p');license.textContent='Three.js r180 (MIT) · Rapier 0.19.3 (Apache-2.0) · AI Hub Session Protocol v1 client 1.4.0. Code-built geometry, animation, music, sound effects and gibberish voices. No image or audio assets.';root.append(license);\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat >> main.js <<'EOF'\n\nfunction colliderRect(r){return world.createCollider(RAPIER.ColliderDesc.cuboid(r.w/2,r.h/2,1.4).setTranslation(r.x,r.y,0).setFriction(.2).setRestitution(0));}\nfunction loadLevel(index){\n sector=clamp(index,0,2);const level={...LEVELS[sector],index:sector};\n world?.free();world=new RAPIER.World({x:0,y:-tuning.gravity,z:0});\n for(const s of level.solids)colliderRect(s);\n objects.clear();scene.add(objects);art.clearEffects();\n levelArt=art.buildLevel(level);\n barriers=level.barriers.map(r=>({...r,collider:colliderRect(r),broken:false,group:levelArt.barriers.get(r.id)}));\n miners=level.miners.map((r,i)=>{const obj=art.createMiner(i);obj.group.position.set(r.x,r.y,0);objects.add(obj.group);return {...r,...obj,rescued:false,beam:0};});\n enemies=level.enemies.map((r,i)=>{const obj=art.createEnemy(r.type);obj.group.position.set(r.x,r.y,0);objects.add(obj.group);return {...r,...obj,originX:r.x,originY:r.y,phase:i*1.7,alive:true,hp:r.type==='jelly'?2:1};});\n crystals=level.crystals.map(r=>{const g=new THREE.Group(),m=new THREE.Mesh(new THREE.OctahedronGeometry(.30),makeMat(0x8cebd2,0x2b907d));g.add(m);const halo=new THREE.Mesh(new THREE.TorusGeometry(.46,.018,4,20),new THREE.MeshBasicMaterial({color:0x79e2cf,transparent:true,opacity:.45}));g.add(halo);g.position.set(r.x,r.y,.5);objects.add(g);return {...r,group:g,collected:false};});\n bombs=[];lasers=[];facing=1;aim={x:1,y:0};fuel=100;charges=3;health=3;checkpoint={...level.start};stageTimer=0;dockCooldown=2;invuln=1.5;scanTimer=5;scanCooldown=0;\n if(player){scene.remove(player.group);}player=art.createPilot(0xffba4f);scene.add(player.group);\n playerBody=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(level.start.x,level.start.y,0).lockRotations().setLinearDamping(.8).setCcdEnabled(true));\n playerBody.setEnabledTranslations(true,true,false,true);\n world.createCollider(RAPIER.ColliderDesc.capsule(.38,.34).setFriction(.1).setRestitution(0).setDensity(1),playerBody);\n player.group.position.set(level.start.x,level.start.y,0);\n cameraTarget.set(clamp(level.start.x,17,37),clamp(level.start.y,11.5,18.5),55);camera.position.copy(cameraTarget);camera.lookAt(cameraTarget.x,cameraTarget.y,0);\n for(const g of ghosts.values())g.group.visible=false;\n if(debugLines){scene.remove(debugLines);debugLines.geometry.dispose();debugLines.material.dispose();debugLines=null;}\n updateHUD();updateMap();\n}\nfunction startRun(demo=false){\n clearTimeout(transitionTimeout);stageChanging=false;\"'$('\"'sector-transition').style.opacity=0;\n mode=demo?'attract':'playing';elapsed=0;score=0;rescued=0;lives=3;health=3;training=false;\n god=infiniteFuel=physicsDebug=false;Object.assign(tuning,DEFAULTS);syncDev();\n statistics={shots:0,blasts:0,crystals:0,hits:0,replacements:0};tutorialFlags.clear();attractTime=0;\n loadLevel(0);titlePilot.group.visible=false;player.group.visible=true;accumulator=0;show(null);sound.suspend(false);\n toast('SHIFT STARTED','Find both miners. Bring everyone home.',4);\n}\nfunction refill(){health=3;fuel=100;charges=3;invuln=Math.max(invuln,.7);}\nfunction teleport(x,y){playerBody.setTranslation({x,y,z:0},true);playerBody.setLinvel({x:0,y:0,z:0},true);lastPosition={x,y};player.group.position.set(x,y,0);}\nfunction netState(){const p=playerBody?.translation()||lastPosition;return {x:p.x,y:p.y,sector,facing,flying,score:Math.round(score),rescued,time:elapsed};}\nfunction rescueMiner(m){\n if(m.rescued)return;\n m.rescued=true;m.beam=1.6;rescued++;score+=1000;fuel=Math.min(100,fuel+30);health=Math.min(3,health+1);sound.play('rescue');sound.voice('rescue');art.effect('rescue',m.x,m.y,0xffd675);shake=Math.max(shake,.2);\n const remaining=miners.filter(n=>\"'!n.rescued).length;\n toast(`${m.name.toUpperCase()} IS HEADING HOME`,remaining?'\"'One more signal in this sector.':'Sector clear. Reach the striped lift.');\n if(\"'!remaining){levelArt.exit.userData.unlocked=true;scanTimer=6;}\n}\nfunction hurt(amount=1,source='\"'hazard'){\n if(invuln>0||god||mode==='attract'||tuning.damage===0)return false;\n health-=amount*tuning.damage;statistics.hits++;invuln=1.6;shake=.65;sound.play('hit');\"'$('\"'damage').classList.add('danger-flash');setTimeout(()=>\"'$('\"'damage').classList.remove('danger-flash'),220);\n art.effect('hit',playerBody.translation().x,playerBody.translation().y,0xff765d);\n if(health<=0){\n lives--;statistics.replacements++;\n if(lives<=0){endRun(false);return true;}\n teleport(checkpoint.x,checkpoint.y);refill();toast('FRESH SUIT. SAME BRAVE PILOT.',\"'`${lives} replacement ${lives===1?'\"'suit':'suits'} remaining.\"'`,3);\n }else if(source==='\"'lava'||source==='water'){\n const p=playerBody.translation();playerBody.setLinvel({x:-facing*3,y:7,z:0},true);if(source==='lava'&&p.y<2)teleport(Math.max(16,p.x-3),5);\n }\n return true;\n}\nfunction destroyBarrier(b){\n if(b.broken)return;b.broken=true;b.group.visible=false;world.removeCollider(b.collider,true);score+=150;art.effect('explode',b.x,b.y,0xffbd61);\n}\nfunction killEnemy(e){if(\"'!e.alive)return;e.alive=false;e.group.visible=false;score+=150;art.effect('\"'hit',e.x,e.y,0xffc65c);sound.play('collect');}\nfunction rayBox(ox,oy,dx,dy,box,max){\n let near=0,far=max;\n for(const [o,d,mn,mx] of [[ox,dx,box.x-box.w/2,box.x+box.w/2],[oy,dy,box.y-box.h/2,box.y+box.h/2]]){\n if(Math.abs(d)<1e-7){if(o<mn||o>mx)return Infinity;}else{let a=(mn-o)/d,b=(mx-o)/d;if(a>b)[a,b]=[b,a];near=Math.max(near,a);far=Math.min(far,b);if(far<near)return Infinity;}\n }\n return near>=0&&near<=max?near:Infinity;\n}\nfunction fireLaser(){\n if(fireCooldown>0)return;fireCooldown=.18;statistics.shots++;sound.play('laser');\n const pos=playerBody.translation();let dir={...aim};\n if((settings.assist||lastInput==='touch')&&lastInput\"'!=='\"'keyboard'){\n let chosen=null,best=Infinity;for(const e of enemies){if(\"'!e.alive)continue;const dx=e.x-pos.x,dy=e.y-pos.y,d=Math.hypot(dx,dy);if(d>14)continue;const dot=(dx*dir.x+dy*dir.y)/d;if(dot>.82&&d<best){chosen=e;best=d;}}\n if(chosen){const l=dist(chosen,pos);dir={x:(chosen.x-pos.x)/l,y:(chosen.y-pos.y)/l};}\n }\n const ox=pos.x+dir.x*.5,oy=pos.y+.25+dir.y*.3;let length=17,target=null;\n const boxes=[...LEVELS[sector].solids,...barriers.filter(b=>!b.broken)];\n for(const b of boxes)length=Math.min(length,rayBox(ox,oy,dir.x,dir.y,b,17));\n for(const e of enemies){if(!e.alive)continue;const d=rayBox(ox,oy,dir.x,dir.y,{x:e.x,y:e.y,w:e.type==='\"'spider'?1.35:1.6,h:1.2},length);if(d<length){length=d;target=e;}}\n if(target){target.hp--;if(target.hp<=0)killEnemy(target);}\n const group=new THREE.Group();const core=new THREE.Mesh(new THREE.BoxGeometry(Math.max(.05,length),.065,.08),new THREE.MeshBasicMaterial({color:0xffef9a}));core.position.x=length/2;group.add(core);\n const glow=new THREE.Mesh(new THREE.BoxGeometry(Math.max(.05,length),.20,.06),new THREE.MeshBasicMaterial({color:0xffa957,transparent:true,opacity:.35}));glow.position.x=length/2;group.add(glow);\n group.position.set(ox,oy,1.3);group.rotation.z=Math.atan2(dir.y,dir.x);objects.add(group);lasers.push({group,life:.12});art.effect('spark',ox+dir.x*length,oy+dir.y*length,0xffd272);\n}\nfunction placeBomb(){\n if(bombCooldown>0)return;\n if(charges<=0){toast('NO CHARGES','A green service pad will restock you.',2);sound.play('fail');return;}\n const p=playerBody.translation();charges--;statistics.blasts++;bombCooldown=.5;sound.play('bomb');\n const g=new THREE.Group(),sticks=new THREE.Mesh(new THREE.BoxGeometry(.48,.58,.32),makeMat(0xf27344)),cap=new THREE.Mesh(new THREE.BoxGeometry(.52,.10,.36),makeMat(0xffd56b));g.add(sticks);cap.position.y=.23;g.add(cap);const light=new THREE.Mesh(new THREE.SphereGeometry(.09,6,4),new THREE.MeshBasicMaterial({color:0xfff1ab}));light.position.set(0,.38,.2);g.add(light);g.position.set(p.x,p.y-.3,0);objects.add(g);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x,p.y-.25,0).lockRotations().setCcdEnabled(true));body.setEnabledTranslations(true,true,false,true);world.createCollider(RAPIER.ColliderDesc.ball(.20).setRestitution(.1).setFriction(.8),body);body.setLinvel({x:0,y:-1,z:0},true);\n bombs.push({group:g,body,fuse:1.5,light});toast('CHARGE LIVE\"'!'\"','Clear the blast radius.',1.5);\n}\nfunction explodeBomb(b){\n const p=b.body.translation();art.effect('explode',p.x,p.y,0xffa54e);sound.play('explode');shake=1;world.removeRigidBody(b.body);\n for(const barrier of barriers){if(barrier.broken)continue;const dx=Math.max(0,Math.abs(p.x-barrier.x)-barrier.w/2),dy=Math.max(0,Math.abs(p.y-barrier.y)-barrier.h/2);if(Math.hypot(dx,dy)<tuning.bombRadius)destroyBarrier(barrier);}\n for(const e of enemies)if(e.alive&&dist(p,e)<tuning.bombRadius+1)killEnemy(e);\n if(dist(p,playerBody.translation())<tuning.bombRadius*.82)hurt(1,'blast');\n const ring=new THREE.Mesh(new THREE.RingGeometry(.92,1,48),new THREE.MeshBasicMaterial({color:0xffce6c,transparent:true,opacity:.8,side:THREE.DoubleSide}));ring.position.set(p.x,p.y,1.7);objects.add(ring);lasers.push({group:ring,life:.45,ring:true});\n disposeObject(b.group);\n}\nfunction disposeObject(obj){objects.remove(obj);obj.traverse(o=>{if(o.isMesh){o.geometry?.dispose();if(Array.isArray(o.material))o.material.forEach(m=>m.dispose());else o.material?.dispose();}});}\nfunction scan(){if(scanCooldown>0)return;scanTimer=5;scanCooldown=7;sound.play('checkpoint');toast('SIGNALS FOUND','Gold: miners  •  green: service pads',2);}\nfunction nextSector(){\n if(stageChanging||mode==='attract')return;stageChanging=true;score+=Math.max(100,Math.round(500-stageTimer));sound.play('checkpoint');\n if(sector===2){endRun(true);return;}\n const next=sector+1;\"'$('\"'transition-text').innerHTML=\"'`<small>RESCUE SECTOR 0${next+1}</small>${LEVELS[next].briefing.replace('\"'\\\\n','<br>')}\"'`;$('\"'sector-transition').style.opacity=1;\n transitionTimeout=setTimeout(()=>{loadLevel(next);stageChanging=false;show(null);\"'$('\"'sector-transition').style.opacity=0;toast(LEVELS[next].name.toUpperCase(),LEVELS[next].hint,5);},1300);\n}\nfunction endRun(success,timed=false){\n if(mode\"'!=='\"'playing')return;\n score=Math.round(score+(success?lives*500+Math.max(0,Math.round(1500-elapsed)):0));\n network.finish({...netState(),success});mode='result';show('result');sound.play(success?'win':'fail');sound.voice(success?'rescue':'hurt');\n \"'$('\"'result-eyebrow').textContent=training?'TRAINING SHIFT COMPLETE':success?'SHIFT COMPLETE':timed?'SHIFT WHISTLE':'END OF SHIFT';\n \"'$('\"'result-title').textContent=success?'Everybody’s coming home.':timed?'Tools down, pilot.':'Even heroes need a hand.';\n \"'$('\"'result-score').textContent=score.toString().padStart(6,'0');\"'$('\"'result-copy').textContent=success?'Six helmets. Six smiles. One well-earned break.':\"'`${rescued} of 6 miners made it out. The rescue division has your back.`;\n const bestKey='\"'blast-shift-best';let best=0;try{best=Number(localStorage.getItem(bestKey)||0);if(\"'!training&&score>best){best=score;localStorage.setItem(bestKey,String(score));}}catch{}\n $('\"'result-stats').innerHTML='';for(const [label,val]of [['Miners rescued',\"'`${rescued} / 6`],['\"'Shift time',fmtTime(elapsed)],['Crystal samples',\"'`${statistics.crystals} / 30`],['\"'Best shift',String(best).padStart(6,'0')]]){const row=document.createElement('div');row.className='statline';const span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=val;row.append(span,b);\"'$('\"'result-stats').append(row);}\n \"'$('\"'result').querySelectorAll('button').forEach(b=>b.disabled=network.active);\"'$('\"'map-wrap').classList.add('hidden');\n}\nfunction receiveGhost(state,id,meta){\n let ghost=ghosts.get(id);if(\"'!ghost){const pilot=art.createPilot(new THREE.Color(meta.color).getHex());ghost={...pilot,state,name:meta.name};ghost.group.traverse(o=>{if(o.isMesh&&o.material){o.material=o.material.clone();o.material.transparent=true;o.material.opacity=.42;o.material.depthWrite=false;}});scene.add(ghost.group);ghost.group.position.set(state.x,state.y,-.3);ghosts.set(id,ghost);}ghost.state=state;ghost.name=meta.name;\n}\nfunction removeGhost(id){const g=ghosts.get(id);if(g)scene.remove(g.group);ghosts.delete(id);}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat >> main.js <<'EOF'\n\nfunction colliderRect(r){return world.createCollider(RAPIER.ColliderDesc.cuboid(r.w/2,r.h/2,1.4).setTranslation(r.x,r.y,0).setFriction(.2).setRestitution(0));}\nfunction loadLevel(index){\n sector=clamp(index,0,2);const level={...LEVELS[sector],index:sector};\n world?.free();world=new RAPIER.World({x:0,y:-tuning.gravity,z:0});\n for(const s of level.solids)colliderRect(s);\n objects.clear();scene.add(objects);art.clearEffects();\n levelArt=art.buildLevel(level);\n barriers=level.barriers.map(r=>({...r,collider:colliderRect(r),broken:false,group:levelArt.barriers.get(r.id)}));\n miners=level.miners.map((r,i)=>{const obj=art.createMiner(i);obj.group.position.set(r.x,r.y,0);objects.add(obj.group);return {...r,...obj,rescued:false,beam:0};});\n enemies=level.enemies.map((r,i)=>{const obj=art.createEnemy(r.type);obj.group.position.set(r.x,r.y,0);objects.add(obj.group);return {...r,...obj,originX:r.x,originY:r.y,phase:i*1.7,alive:true,hp:r.type==='jelly'?2:1};});\n crystals=level.crystals.map(r=>{const g=new THREE.Group(),m=new THREE.Mesh(new THREE.OctahedronGeometry(.30),makeMat(0x8cebd2,0x2b907d));g.add(m);const halo=new THREE.Mesh(new THREE.TorusGeometry(.46,.018,4,20),new THREE.MeshBasicMaterial({color:0x79e2cf,transparent:true,opacity:.45}));g.add(halo);g.position.set(r.x,r.y,.5);objects.add(g);return {...r,group:g,collected:false};});\n bombs=[];lasers=[];facing=1;aim={x:1,y:0};fuel=100;charges=3;health=3;checkpoint={...level.start};stageTimer=0;dockCooldown=2;invuln=1.5;scanTimer=5;scanCooldown=0;\n if(player){scene.remove(player.group);}player=art.createPilot(0xffba4f);scene.add(player.group);\n playerBody=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(level.start.x,level.start.y,0).lockRotations().setLinearDamping(.8).setCcdEnabled(true));\n playerBody.setEnabledTranslations(true,true,false,true);\n world.createCollider(RAPIER.ColliderDesc.capsule(.38,.34).setFriction(.1).setRestitution(0).setDensity(1),playerBody);\n player.group.position.set(level.start.x,level.start.y,0);\n cameraTarget.set(clamp(level.start.x,17,37),clamp(level.start.y,11.5,18.5),55);camera.position.copy(cameraTarget);camera.lookAt(cameraTarget.x,cameraTarget.y,0);\n for(const g of ghosts.values())g.group.visible=false;\n if(debugLines){scene.remove(debugLines);debugLines.geometry.dispose();debugLines.material.dispose();debugLines=null;}\n updateHUD();updateMap();\n}\nfunction startRun(demo=false){\n clearTimeout(transitionTimeout);stageChanging=false;\"'$('\"'sector-transition').style.opacity=0;\n mode=demo?'attract':'playing';elapsed=0;score=0;rescued=0;lives=3;health=3;training=false;\n god=infiniteFuel=physicsDebug=false;Object.assign(tuning,DEFAULTS);syncDev();\n statistics={shots:0,blasts:0,crystals:0,hits:0,replacements:0};tutorialFlags.clear();attractTime=0;\n loadLevel(0);titlePilot.group.visible=false;player.group.visible=true;accumulator=0;show(null);sound.suspend(false);\n toast('SHIFT STARTED','Find both miners. Bring everyone home.',4);\n}\nfunction refill(){health=3;fuel=100;charges=3;invuln=Math.max(invuln,.7);}\nfunction teleport(x,y){playerBody.setTranslation({x,y,z:0},true);playerBody.setLinvel({x:0,y:0,z:0},true);lastPosition={x,y};player.group.position.set(x,y,0);}\nfunction netState(){const p=playerBody?.translation()||lastPosition;return {x:p.x,y:p.y,sector,facing,flying,score:Math.round(score),rescued,time:elapsed};}\nfunction rescueMiner(m){\n if(m.rescued)return;\n m.rescued=true;m.beam=1.6;rescued++;score+=1000;fuel=Math.min(100,fuel+30);health=Math.min(3,health+1);sound.play('rescue');sound.voice('rescue');art.effect('rescue',m.x,m.y,0xffd675);shake=Math.max(shake,.2);\n const remaining=miners.filter(n=>\"'!n.rescued).length;\n toast(`${m.name.toUpperCase()} IS HEADING HOME`,remaining?'\"'One more signal in this sector.':'Sector clear. Reach the striped lift.');\n if(\"'!remaining){levelArt.exit.userData.unlocked=true;scanTimer=6;}\n}\nfunction hurt(amount=1,source='\"'hazard'){\n if(invuln>0||god||mode==='attract'||tuning.damage===0)return false;\n health-=amount*tuning.damage;statistics.hits++;invuln=1.6;shake=.65;sound.play('hit');\"'$('\"'damage').classList.add('danger-flash');setTimeout(()=>\"'$('\"'damage').classList.remove('danger-flash'),220);\n art.effect('hit',playerBody.translation().x,playerBody.translation().y,0xff765d);\n if(health<=0){\n lives--;statistics.replacements++;\n if(lives<=0){endRun(false);return true;}\n teleport(checkpoint.x,checkpoint.y);refill();toast('FRESH SUIT. SAME BRAVE PILOT.',\"'`${lives} replacement ${lives===1?'\"'suit':'suits'} remaining.\"'`,3);\n }else if(source==='\"'lava'||source==='water'){\n const p=playerBody.translation();playerBody.setLinvel({x:-facing*3,y:7,z:0},true);if(source==='lava'&&p.y<2)teleport(Math.max(16,p.x-3),5);\n }\n return true;\n}\nfunction destroyBarrier(b){\n if(b.broken)return;b.broken=true;b.group.visible=false;world.removeCollider(b.collider,true);score+=150;art.effect('explode',b.x,b.y,0xffbd61);\n}\nfunction killEnemy(e){if(\"'!e.alive)return;e.alive=false;e.group.visible=false;score+=150;art.effect('\"'hit',e.x,e.y,0xffc65c);sound.play('collect');}\nfunction rayBox(ox,oy,dx,dy,box,max){\n let near=0,far=max;\n for(const [o,d,mn,mx] of [[ox,dx,box.x-box.w/2,box.x+box.w/2],[oy,dy,box.y-box.h/2,box.y+box.h/2]]){\n if(Math.abs(d)<1e-7){if(o<mn||o>mx)return Infinity;}else{let a=(mn-o)/d,b=(mx-o)/d;if(a>b)[a,b]=[b,a];near=Math.max(near,a);far=Math.min(far,b);if(far<near)return Infinity;}\n }\n return near>=0&&near<=max?near:Infinity;\n}\nfunction fireLaser(){\n if(fireCooldown>0)return;fireCooldown=.18;statistics.shots++;sound.play('laser');\n const pos=playerBody.translation();let dir={...aim};\n if((settings.assist||lastInput==='touch')&&lastInput\"'!=='\"'keyboard'){\n let chosen=null,best=Infinity;for(const e of enemies){if(\"'!e.alive)continue;const dx=e.x-pos.x,dy=e.y-pos.y,d=Math.hypot(dx,dy);if(d>14)continue;const dot=(dx*dir.x+dy*dir.y)/d;if(dot>.82&&d<best){chosen=e;best=d;}}\n if(chosen){const l=dist(chosen,pos);dir={x:(chosen.x-pos.x)/l,y:(chosen.y-pos.y)/l};}\n }\n const ox=pos.x+dir.x*.5,oy=pos.y+.25+dir.y*.3;let length=17,target=null;\n const boxes=[...LEVELS[sector].solids,...barriers.filter(b=>!b.broken)];\n for(const b of boxes)length=Math.min(length,rayBox(ox,oy,dir.x,dir.y,b,17));\n for(const e of enemies){if(!e.alive)continue;const d=rayBox(ox,oy,dir.x,dir.y,{x:e.x,y:e.y,w:e.type==='\"'spider'?1.35:1.6,h:1.2},length);if(d<length){length=d;target=e;}}\n if(target){target.hp--;if(target.hp<=0)killEnemy(target);}\n const group=new THREE.Group();const core=new THREE.Mesh(new THREE.BoxGeometry(Math.max(.05,length),.065,.08),new THREE.MeshBasicMaterial({color:0xffef9a}));core.position.x=length/2;group.add(core);\n const glow=new THREE.Mesh(new THREE.BoxGeometry(Math.max(.05,length),.20,.06),new THREE.MeshBasicMaterial({color:0xffa957,transparent:true,opacity:.35}));glow.position.x=length/2;group.add(glow);\n group.position.set(ox,oy,1.3);group.rotation.z=Math.atan2(dir.y,dir.x);objects.add(group);lasers.push({group,life:.12});art.effect('spark',ox+dir.x*length,oy+dir.y*length,0xffd272);\n}\nfunction placeBomb(){\n if(bombCooldown>0)return;\n if(charges<=0){toast('NO CHARGES','A green service pad will restock you.',2);sound.play('fail');return;}\n const p=playerBody.translation();charges--;statistics.blasts++;bombCooldown=.5;sound.play('bomb');\n const g=new THREE.Group(),sticks=new THREE.Mesh(new THREE.BoxGeometry(.48,.58,.32),makeMat(0xf27344)),cap=new THREE.Mesh(new THREE.BoxGeometry(.52,.10,.36),makeMat(0xffd56b));g.add(sticks);cap.position.y=.23;g.add(cap);const light=new THREE.Mesh(new THREE.SphereGeometry(.09,6,4),new THREE.MeshBasicMaterial({color:0xfff1ab}));light.position.set(0,.38,.2);g.add(light);g.position.set(p.x,p.y-.3,0);objects.add(g);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x,p.y-.25,0).lockRotations().setCcdEnabled(true));body.setEnabledTranslations(true,true,false,true);world.createCollider(RAPIER.ColliderDesc.ball(.20).setRestitution(.1).setFriction(.8),body);body.setLinvel({x:0,y:-1,z:0},true);\n bombs.push({group:g,body,fuse:1.5,light});toast('CHARGE LIVE\"'!'\"','Clear the blast radius.',1.5);\n}\nfunction explodeBomb(b){\n const p=b.body.translation();art.effect('explode',p.x,p.y,0xffa54e);sound.play('explode');shake=1;world.removeRigidBody(b.body);\n for(const barrier of barriers){if(barrier.broken)continue;const dx=Math.max(0,Math.abs(p.x-barrier.x)-barrier.w/2),dy=Math.max(0,Math.abs(p.y-barrier.y)-barrier.h/2);if(Math.hypot(dx,dy)<tuning.bombRadius)destroyBarrier(barrier);}\n for(const e of enemies)if(e.alive&&dist(p,e)<tuning.bombRadius+1)killEnemy(e);\n if(dist(p,playerBody.translation())<tuning.bombRadius*.82)hurt(1,'blast');\n const ring=new THREE.Mesh(new THREE.RingGeometry(.92,1,48),new THREE.MeshBasicMaterial({color:0xffce6c,transparent:true,opacity:.8,side:THREE.DoubleSide}));ring.position.set(p.x,p.y,1.7);objects.add(ring);lasers.push({group:ring,life:.45,ring:true});\n disposeObject(b.group);\n}\nfunction disposeObject(obj){objects.remove(obj);obj.traverse(o=>{if(o.isMesh){o.geometry?.dispose();if(Array.isArray(o.material))o.material.forEach(m=>m.dispose());else o.material?.dispose();}});}\nfunction scan(){if(scanCooldown>0)return;scanTimer=5;scanCooldown=7;sound.play('checkpoint');toast('SIGNALS FOUND','Gold: miners  •  green: service pads',2);}\nfunction nextSector(){\n if(stageChanging||mode==='attract')return;stageChanging=true;score+=Math.max(100,Math.round(500-stageTimer));sound.play('checkpoint');\n if(sector===2){endRun(true);return;}\n const next=sector+1;\"'$('\"'transition-text').innerHTML=\"'`<small>RESCUE SECTOR 0${next+1}</small>${LEVELS[next].briefing.replace('\"'\\\\n','<br>')}\"'`;$('\"'sector-transition').style.opacity=1;\n transitionTimeout=setTimeout(()=>{loadLevel(next);stageChanging=false;show(null);\"'$('\"'sector-transition').style.opacity=0;toast(LEVELS[next].name.toUpperCase(),LEVELS[next].hint,5);},1300);\n}\nfunction endRun(success,timed=false){\n if(mode\"'!=='\"'playing')return;\n score=Math.round(score+(success?lives*500+Math.max(0,Math.round(1500-elapsed)):0));\n network.finish({...netState(),success});mode='result';show('result');sound.play(success?'win':'fail');sound.voice(success?'rescue':'hurt');\n \"'$('\"'result-eyebrow').textContent=training?'TRAINING SHIFT COMPLETE':success?'SHIFT COMPLETE':timed?'SHIFT WHISTLE':'END OF SHIFT';\n \"'$('\"'result-title').textContent=success?'Everybody’s coming home.':timed?'Tools down, pilot.':'Even heroes need a hand.';\n \"'$('\"'result-score').textContent=score.toString().padStart(6,'0');\"'$('\"'result-copy').textContent=success?'Six helmets. Six smiles. One well-earned break.':\"'`${rescued} of 6 miners made it out. The rescue division has your back.`;\n const bestKey='\"'blast-shift-best';let best=0;try{best=Number(localStorage.getItem(bestKey)||0);if(\"'!training&&score>best){best=score;localStorage.setItem(bestKey,String(score));}}catch{}\n $('\"'result-stats').innerHTML='';for(const [label,val]of [['Miners rescued',\"'`${rescued} / 6`],['\"'Shift time',fmtTime(elapsed)],['Crystal samples',\"'`${statistics.crystals} / 30`],['\"'Best shift',String(best).padStart(6,'0')]]){const row=document.createElement('div');row.className='statline';const span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=val;row.append(span,b);\"'$('\"'result-stats').append(row);}\n \"'$('\"'result').querySelectorAll('button').forEach(b=>b.disabled=network.active);\"'$('\"'map-wrap').classList.add('hidden');\n}\nfunction receiveGhost(state,id,meta){\n let ghost=ghosts.get(id);if(\"'!ghost){const pilot=art.createPilot(new THREE.Color(meta.color).getHex());ghost={...pilot,state,name:meta.name};ghost.group.traverse(o=>{if(o.isMesh&&o.material){o.material=o.material.clone();o.material.transparent=true;o.material.opacity=.42;o.material.depthWrite=false;}});scene.add(ghost.group);ghost.group.position.set(state.x,state.y,-.3);ghosts.set(id,ghost);}ghost.state=state;ghost.name=meta.name;\n}\nfunction removeGhost(id){const g=ghosts.get(id);if(g)scene.remove(g.group);ghosts.delete(id);}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
