ean} [forceWebGL=false] - If set to `true`, the renderer uses a WebGL 2 backend no matter if WebGPU is supported or not.\nnode_modules/three/build/three.webgpu.js:75878:\t\tthis.addMaterial( MeshToonNodeMaterial, 'MeshToonMaterial' );\nnode_modules/three/build/three.webgpu.js:75944:\t * @property {boolean} [forceWebGL=false] - If set to `true`, the renderer uses a WebGL 2 backend no matter if WebGPU is supported or not.\nnode_modules/three/build/three.webgpu.js:75960:\t\tif ( parameters.forceWebGL ) {\nnode_modules/three/build/three.webgpu.js:77115:export { ACESFilmicToneMapping, AONode, AddEquation, AddOperation, AdditiveBlending, AgXToneMapping, AlphaFormat, AlwaysCompare, AlwaysDepth, AlwaysStencilFunc, AmbientLight, AmbientLightNode, Analyti [... omitted end of long line]\n/home/micha/.bun/bin/bun\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The core systems are taking shape: cel-shaded cave art, synthesized music and voices, and ghost races through AI Hub. The standalone race option will also support direct peer pairing. I’m building the campaign around two rescues per sector, with bulkheads, safe refuelling points, and room to learn each tool.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > levels.js <<'EOF'\nconst R=(x,y,w,h,type='rock')=>({x,y,w,h,type});\nexport const LEVELS=[\n {name:'The Lantern Hollow',subtitle:'Two miners. One very questionable elevator.',palette:0,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(8,23,16,1.8),R(47,23,14,1.8),R(6,13,12,1.8),R(36,13,36,1.8),R(28,20,6,1,'metal')],\n barriers:[{...R(13,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(28,1.15,10,.65,'lava')],miners:[{x:7,y:2.05,name:'Pip'},{x:49,y:14.95,name:'Dot'}],docks:[{x:4,y:24},{x:33,y:14}],\n enemies:[{x:20,y:21,type:'bat',range:5},{x:27,y:8,type:'bat',range:5},{x:38,y:15.4,type:'spider',range:3},{x:49,y:19.5,type:'bat',range:2}],\n crystals:[{x:18,y:21},{x:17,y:17},{x:17,y:9},{x:8,y:6},{x:22,y:4},{x:28,y:5},{x:34,y:5},{x:28,y:22},{x:37,y:17},{x:49,y:21}],\n briefing:'MINERS BELOW.\\\\nBRING THEM BACK.',hint:'Hold your jetpack to fly. Release to drop. Land to recharge.',tools:'JETPACK / LASER / CHARGES',par:150},\n {name:'The Cinder Works',subtitle:'The rocks are hot. The overtime is not.',palette:1,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(7,23,14,1.8),R(47,23,14,1.8),R(7,13,14,1.8),R(36.5,13,35,1.8),R(24,21,5,1,'metal'),R(34,7,4,1,'metal')],\n barriers:[{...R(15,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(27,1.2,18,.8,'lava'),R(38,14.2,4,.65,'vent')],miners:[{x:6,y:2.05,name:'Moe'},{x:49,y:14.95,name:'Bea'}],docks:[{x:4,y:24},{x:25,y:14}],\n enemies:[{x:19,y:23,type:'bat',range:3},{x:21,y:9,type:'bat',range:3},{x:32,y:18,type:'bat',range:4},{x:39,y:15.3,type:'spider',range:2},{x:49,y:19,type:'bat',range:3}],\n crystals:[{x:15.5,y:21},{x:17,y:16},{x:17,y:7},{x:8,y:7},{x:21,y:5},{x:27,y:5},{x:34,y:9},{x:24,y:23},{x:37,y:19},{x:49,y:21}],\n briefing:'HOT ROCKS.\\\\nCOOL HEAD.',hint:'Steam vents cycle on and off. Wait for the blue light.',tools:'HEAT / VENTS / NARROW LANDINGS',par:170},\n {name:'The Sunken Signal',subtitle:'Last call from the bottom of the world.',palette:2,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(8,23,16,1.8),R(47,23,14,1.8),R(6,13,12,1.8),R(36,13,36,1.8),R(25,21,4,1,'metal'),R(33,6,5,1,'metal')],\n barriers:[{...R(13,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(29,2,24,2,'water'),R(37,14.2,3,.65,'vent')],miners:[{x:6,y:2.05,name:'Lee'},{x:49,y:14.95,name:'Kit'}],docks:[{x:4,y:24},{x:25,y:14}],\n enemies:[{x:20,y:23,type:'bat',range:4},{x:24,y:9,type:'bat',range:4},{x:35,y:8,type:'jelly',range:4},{x:38,y:15.3,type:'spider',range:2},{x:49,y:19,type:'bat',range:3},{x:34,y:22,type:'bat',range:3}],\n crystals:[{x:18,y:21},{x:16,y:16},{x:16,y:8},{x:6,y:7},{x:21,y:5},{x:27,y:5},{x:34,y:8},{x:25,y:23},{x:37,y:18},{x:49,y:21}],\n briefing:'ONE LAST SIGNAL.\\\\nNO ONE LEFT BELOW.',hint:'Floodwater pulls you down. Short bursts keep your pack dry.',tools:'FLOOD / LAST RESCUE / EXTRACTION',par:190}\n];\nEOF\ncat > index.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#06191f\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Rescue six miners across three caves, then reach the extraction lift. Fastest complete rescue wins; otherwise score wins.\">\n<meta name=\"hub:session-howto\" content=\"Left stick move; Cross / left stick up fly; R2 laser; R1 charge; Triangle scanner. Keyboard: A/D move, Space/W fly, mouse aim + fire, E charge, Q scan.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>H.E.R.O. Blast Shift</title>\n<style>\n:root{--paper:#f5ecd6;--gold:#ffc652;--orange:#ff744c;--cyan:#79d8cb;--ink:#06191f;--muted:#97b4b5;--line:#355157;--ui:clamp(16px,1.5vw,24px)}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--paper);font-family:Arial,Helvetica,sans-serif;font-size:var(--ui)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:5px}button{touch-action:manipulation}canvas#game{position:absolute;inset:0;width:100%;height:100%;display:block}button,input,select{-webkit-tap-highlight-color:transparent}body::after{content:\"\";position:fixed;inset:0;pointer-events:none;box-shadow:inset 0 0 14vw #02121660;z-index:1}.hidden{display:none!important}.overlay{position:absolute;inset:0;z-index:5;display:flex;padding:clamp(28px,5vw,90px);background:linear-gradient(90deg,#03151ce8,#03151c9c 43%,#03151c05 79%);align-items:center}.panel{max-width:1050px;width:min(100%,1000px);margin:auto;background:#071c23ee;border:1px solid #557277;padding:clamp(24px,4vw,60px);box-shadow:12px 12px 0 #0005;max-height:91vh;overflow:auto;scrollbar-color:var(--gold) var(--ink)}.narrow{max-width:650px}.eyebrow{font:700 .65rem/1.4 monospace;letter-spacing:.23em;color:var(--cyan);text-transform:uppercase}.stamp{display:inline-block;padding:.35em .65em;border:1px solid var(--gold);color:var(--gold);font:700 .6rem monospace;letter-spacing:.15em;transform:rotate(-3deg);margin-left:.7em;vertical-align:middle}.hero-title{margin:18px 0 15px;font-size:clamp(55px,7.1vw,130px);line-height:.88;letter-spacing:-.06em;font-weight:950;text-shadow:5px 6px 0 #020e16;max-width:740px}.hero-title small{display:block;font-size:.28em;letter-spacing:.28em;line-height:1.5;color:var(--gold);margin-bottom:.25em}.hero-title em{font-style:normal;color:var(--gold)}.tagline{font-size:.88rem;line-height:1.5;color:#c3d2cf;max-width:400px;margin:22px 0}.title-content{width:47%;min-width:360px;max-width:740px}.menu{display:flex;flex-direction:column;gap:7px;align-items:stretch}.menu button,.action{border:1px solid transparent;background:transparent;color:var(--paper);padding:.65em .8em;text-align:left;font-size:.85rem;letter-spacing:.04em;position:relative;transition:background .15s,border .15s}.menu button:hover,.menu button:focus,.action:hover,.action:focus{background:#194046;border-color:#61938e;outline:none}.menu button:focus::before{content:\"\";position:absolute;left:-2px;top:0;bottom:0;width:5px;background:var(--gold)}.menu .primary,.primary{background:var(--gold);color:#11232a;font-weight:800;border-color:var(--gold)}.menu .primary:hover,.menu .primary:focus,.primary:hover,.primary:focus{background:#ffdb86;color:#071a22;border-color:#fff1ba}.action{display:inline-block;border-color:#4e7476;margin:.35em .4em .2em 0;padding:.65em .9em}.smallprint{font: .55rem/1.6 monospace;color:var(--muted);letter-spacing:.05em}.title-footer{position:absolute;left:5vw;right:5vw;bottom:3vh;display:flex;justify-content:space-between;gap:20px;font:.55rem monospace;letter-spacing:.12em;color:#b2c9c3}.title-note{position:absolute;right:5.5vw;bottom:20vh;text-align:right;max-width:290px;font:700 .68rem/1.6 monospace;letter-spacing:.06em}.title-note b{color:var(--gold)}h1,h2,h3,p{margin-top:0}h2{font-size:2.2rem;letter-spacing:-.045em;margin-bottom:.5em}h3{font-size:1rem;color:var(--gold)}.lead{font-size:.9rem;line-height:1.6;color:#becdc9}.split{display:grid;grid-template-columns:1fr 1fr;gap:24px}.setting{display:grid;grid-template-columns:1fr auto;gap:10px 20px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);font-size:.8rem}.setting input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--gold);height:24px}.setting button{background:#16383d;color:var(--paper);border:1px solid #4d7375;padding:.4em .7em;min-width:100px}.setting output{color:var(--gold);font-family:monospace}.help-row{display:flex;gap:16px;border-bottom:1px solid var(--line);padding:14px 0;align-items:center;font-size:.85rem}.help-row strong{min-width:35%;color:var(--gold)}.about-copy{font-size:.66rem;line-height:1.7;color:#c3d0c9}.about-copy b{color:var(--gold)}.about-copy p{margin-bottom:.7em}.about-copy h3{margin-top:1.5em;margin-bottom:.5em}.feedback{font-size:.62rem;line-height:1.5;color:#acc0bd}.feedback li{margin:8px 0}#hud{position:absolute;inset:0;z-index:2;pointer-events:none;padding:3vh 3.5vw;display:flex;flex-direction:column;justify-content:space-between}#hud::before{content:\"\";position:absolute;inset:0;background:linear-gradient(#04131b77,transparent 20%,transparent 78%,#04131bbb);z-index:-1}.hud-top,.hud-bottom{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.sector-name{font-size:1rem;font-weight:800;letter-spacing:.015em}.sector-small{font:.55rem monospace;color:var(--cyan);letter-spacing:.18em;margin-bottom:7px}.rescue-dots{display:flex;gap:8px;align-items:center;margin-top:10px;font:.6rem monospace}.rescue-dots i{display:inline-block;width:11px;height:14px;border:2px solid #738d88;transform:skew(-10deg)}.rescue-dots i.on{background:var(--gold);border-color:var(--gold)}.score{text-align:right}.score strong{font:800 1.4rem monospace;letter-spacing:.06em}.score .smallprint{display:block}.health{color:var(--orange);font-size:1rem;letter-spacing:.2em;margin-bottom:7px}.fuel{width:220px;height:8px;background:#183a42;border:1px solid #829b90;transform:skew(-13deg)}.fuel div{height:100%;width:100%;background:var(--gold);transition:width .1s}.fuel-label{font:700 .55rem monospace;display:flex;justify-content:space-between;color:var(--gold);margin-bottom:7px}.supplies{display:flex;gap:25px;align-items:center;margin-top:12px;font:.65rem monospace}.hud-controls{font:.56rem/1.9 monospace;color:#c0d2c6;text-align:right;align-self:flex-end}.glyph{color:var(--gold);font-weight:800}#objective{position:absolute;top:3vh;left:50%;transform:translateX(-50%);font:700 .6rem/1.5 monospace;text-align:center;color:var(--gold);letter-spacing:.1em;max-width:34%;padding:.5em 1em;background:#052028ad;border-bottom:1px solid #638775}#toast{position:absolute;left:50%;top:23%;transform:translateX(-50%);text-align:center;pointer-events:none;font-size:1rem;font-weight:800;letter-spacing:.03em;text-shadow:2px 2px #05171d;transition:opacity .3s;min-width:50%}#toast small{display:block;font:.6rem/1.8 monospace;color:var(--cyan);margin-top:6px}#context{position:absolute;left:50%;bottom:15%;transform:translateX(-50%);background:#081e26df;border-left:3px solid var(--gold);padding:.6em 1em;font:.65rem/1.5 monospace;color:var(--paper);text-align:center;max-width:70%;transition:opacity .2s}.pill{position:absolute;left:50%;bottom:5vh;transform:translateX(-50%);z-index:7;background:var(--gold);color:#082128;padding:12px 24px;font:800 .7rem monospace;letter-spacing:.12em;text-align:center}.pill small{display:block;font:.55rem monospace;margin-top:6px;letter-spacing:.03em}#touch-menu{position:absolute;right:4vw;top:3vh;z-index:8;display:none;border:1px solid #89a99a;color:var(--paper);background:#071c23b0;width:45px;height:42px;font-size:24px}#touch-action{position:absolute;right:6vw;bottom:13vh;z-index:8;border:1px solid var(--gold);background:#082028b0;color:var(--gold);border-radius:50%;width:80px;height:80px;font-size:.65rem;font-weight:700;display:none}#touch-hint{position:absolute;z-index:3;left:50%;bottom:5vh;transform:translateX(-50%);font:.55rem monospace;color:#c3d8c6;pointer-events:none;white-space:nowrap}.touch-ring{position:absolute;width:100px;height:100px;border:1px solid #b9e4c34a;border-radius:50%;z-index:4;pointer-events:none;background:#133e3c33;display:none}.touch-ring::after{content:\"\";position:absolute;width:22px;height:22px;border-radius:50%;background:#ffe0a077;left:39px;top:39px}#map-wrap{position:absolute;z-index:4;right:3.5vw;top:15vh;width:250px;background:#05212aeb;border:1px solid #487572;padding:15px;pointer-events:none}#map-wrap canvas{width:100%;height:auto}#map-wrap .smallprint{color:var(--cyan)}.result-score{font:800 3.5rem monospace;color:var(--gold);letter-spacing:-.06em;margin:.2em 0}.statline{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line);font:.75rem monospace}.statline b{color:var(--gold)}#link-code,#remote-code{display:block;width:100%;height:80px;resize:vertical;background:#03161d;border:1px solid #426b71;color:#d5dfd2;padding:10px;font:.55rem monospace;word-break:break-all;margin:10px 0}.network-status{color:var(--cyan);font:.65rem/1.5 monospace;min-height:1.6em}.loading{font:700 .7rem/2 monospace;letter-spacing:.15em;text-align:center}.loading-dot{display:block;margin:25px auto;width:40px;height:40px;border:3px solid #304d50;border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#damage{position:absolute;inset:0;pointer-events:none;z-index:3;border:0 solid #fb654d;box-shadow:inset 0 0 100px #ff553800;transition:box-shadow .15s}.danger-flash{box-shadow:inset 0 0 100px #ff553899!important}#sector-transition{position:absolute;inset:0;z-index:4;pointer-events:none;display:flex;align-items:center;justify-content:center;background:#04141e;opacity:0;transition:opacity .3s}.transition-text{text-align:center;font-size:3rem;font-weight:900;line-height:1.1;letter-spacing:-.04em;color:var(--gold)}.transition-text small{display:block;font:700 .65rem monospace;color:var(--cyan);letter-spacing:.2em;margin-bottom:20px}#ghosts{font:.55rem monospace;color:var(--cyan);margin-top:10px}.dev-note{font:.55rem monospace;color:var(--orange);line-height:1.5}.title-rail{position:absolute;right:5vw;top:5vh;font:.55rem monospace;letter-spacing:.1em;text-align:right;color:#b7c9c1}.title-rail b{color:var(--gold)}\n@media(max-width:900px){.title-content{min-width:290px;width:52%}.hero-title{font-size:70px}.panel{max-height:92vh}.hud-controls{max-width:42%;font-size:.5rem}#objective{top:12vh;max-width:65%;font-size:.5rem}.title-note{font-size:.55rem;right:4vw;max-width:190px}.sector-name{font-size:.85rem}.fuel{width:180px}.title-footer{font-size:.45rem}.title-rail{display:none}}\n@media(pointer:coarse){body.touch-playing #touch-menu{display:block}body.touch-playing #touch-action.available{display:block}.hud-controls{display:none}.hud-bottom .supplies{display:none}body.touch-playing #hud{padding:3vh 5vw}body.touch-playing #objective{top:11vh}body.touch-playing #hud .score{margin-right:48px}body.touch-playing .fuel{width:130px}body.touch-playing .fuel-label{display:none}body.touch-playing .hud-top .sector-small{display:none}}\n@media(max-width:600px){.overlay{padding:25px}.title-content{width:100%;min-width:0;max-width:300px}.hero-title{font-size:64px}.title-note{display:none}.tagline{font-size:.8rem;max-width:240px}.title-footer span:last-child{display:none}.split{grid-template-columns:1fr;gap:10px}.panel{padding:24px}.hero-title small{font-size:.27em}.menu{gap:2px}.menu button{padding:.65em}.hud-top .sector-name{max-width:165px}.score strong{font-size:1rem}.health{font-size:.8rem}.supplies{font-size:.55rem}.fuel{width:140px}.hud-controls{max-width:50%;font-size:.42rem}#map-wrap{width:185px;top:19vh}#context{font-size:.55rem;bottom:19%;max-width:85%;width:max-content}.title-footer{bottom:2vh}.title-content .eyebrow{font-size:.55rem}.help-row{font-size:.7rem}.help-row strong{min-width:36%}}\n@media(max-height:650px) and (min-width:700px){.hero-title{font-size:65px;margin:8px 0}.tagline{margin:12px 0}.menu button{padding:.4em .7em}.title-content .eyebrow{font-size:.55rem}.title-footer{bottom:2vh}.overlay{padding:4vh 6vw}.panel{padding:25px}h2{font-size:1.8rem}.setting{padding:8px 0}}\n</style></head><body>\n<canvas id=\"game\" aria-label=\"H.E.R.O. Blast Shift game world\"></canvas><div id=\"damage\"></div>\n<div id=\"boot\" class=\"overlay\"><div class=\"panel narrow loading\"><div class=\"eyebrow\">RESCUE DIVISION / EST. 1984</div><h2>Warming up the rotors.</h2><span class=\"loading-dot\"></span><div id=\"load-status\">Preparing cave systems…</div></div></div>\n<div id=\"title\" class=\"overlay hidden\"><div class=\"title-content\"><div class=\"eyebrow\">UNDERGROUND RESCUE DIVISION <span class=\"stamp\">NIGHT CREW</span></div><h1 class=\"hero-title\"><small>H.E.R.O.</small>BLAST<br><em>SHIFT</em></h1><p class=\"tagline\">Bad rocks. Good intentions.<br>Six miners are counting on you.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"start\">Start shift <span style=\"float:right\">→</span></button><button data-action=\"race\">Race a friend</button><button data-action=\"help\">Field manual</button><button data-action=\"settings\">Settings</button><button data-action=\"about\">About & credits</button></nav></div><div class=\"title-rail\">PERSONAL HELICOPTER EMERGENCY<br>RESPONSE OPERATIVE<br><br><b>SECTOR 07 • BELOW GROUND</b></div><div class=\"title-note\"><b>YOUR SHIFT, SHOULD YOU ACCEPT IT</b><br>Fly in. Blast through.<br>Bring everyone home.<br><br>3 CAVERNS / 6 RESCUES<br>ONE EXTREMELY SMALL ROTOR.</div><div class=\"title-footer\"><span id=\"title-input\">KEYBOARD + MOUSE READY</span><span>AN ORIGINAL CAVE RESCUE • INSPIRED BY H.E.R.O. (1984)</span></div></div>\n<div id=\"hud\" class=\"hidden\"><div class=\"hud-top\"><div><div class=\"sector-small\" id=\"sector-number\">RESCUE SECTOR 01 / 03</div><div class=\"sector-name\" id=\"sector-name\"></div><div class=\"rescue-dots\" id=\"rescue-dots\"></div><div id=\"ghosts\"></div></div><div class=\"score\"><span class=\"smallprint\">SHIFT SCORE</span><strong id=\"score\">000000</strong><span class=\"smallprint\" id=\"timer\">00:00</span></div></div><div id=\"objective\"></div><div class=\"hud-bottom\"><div><div class=\"health\" id=\"hearts\">♥ ♥ ♥</div><div class=\"fuel-label\"><span>ROTOR POWER</span><span id=\"fuel-number\">100%</span></div><div class=\"fuel\"><div id=\"fuel-bar\"></div></div><div class=\"supplies\"><span id=\"bomb-count\">▰ ▰ ▰</span><span id=\"lives\">03 SUITS</span></div></div><div class=\"hud-controls\" id=\"controls\"></div></div><div id=\"toast\"></div><div id=\"context\"></div></div>\n<div id=\"attract\" class=\"pill hidden\">RESCUE IN PROGRESS<small>Attract demo · press any button to return</small></div>\n<div id=\"pause\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\">ROTOR ON HOLD</div><h2>Catch your breath.</h2><p class=\"lead\" id=\"pause-caption\">Everyone still needs a lift.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"resume\">Back to the mine</button><button data-action=\"manual-pause\">Field manual</button><button data-action=\"settings-pause\">Settings</button><button data-action=\"dev\">Dev mode</button><button data-action=\"restart\">Restart shift</button><button data-action=\"quit\">End shift</button></nav></div></div>\n<div id=\"help\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">THE FIELD MANUAL / READ BEFORE DESCENT</div><h2>A little lift goes a long way.</h2><div class=\"split\"><div><div class=\"help-row\"><strong data-prompt=\"move\">A / D</strong><span>Move left / right</span></div><div class=\"help-row\"><strong data-prompt=\"fly\">SPACE / W</strong><span>Hold to fly. Release to descend.</span></div><div class=\"help-row\"><strong data-prompt=\"fire\">MOUSE / J</strong><span>Aim and fire your helmet laser.</span></div><div class=\"help-row\"><strong data-prompt=\"bomb\">E / RIGHT CLICK</strong><span>Drop a charge. Back away before it blows.</span></div><div class=\"help-row\"><strong data-prompt=\"scan\">Q</strong><span>Pulse the cave scanner.</span></div><div class=\"help-row\"><strong data-prompt=\"pause\">ESC / P</strong><span>Pause / settings / dev tools.</span></div></div><div><h3>Leave no miner behind.</h3><p class=\"lead\">Find both miners in each cavern. Get close to send them up the rescue tether. Then fly to the striped lift in the upper right.</p><p class=\"lead\">Orange bulkheads need a charge. Your laser clears creatures. Avoid lava and red steam vents; blue vents are safe.</p><p class=\"lead\">Land to recover rotor power. Green service pads restore your suit, charges and power, and set your checkpoint. You have three replacement suits for the whole shift.</p><p class=\"smallprint\">TOUCH: drag the left side to move and fly; hold the right side to aim and shoot. A charge button appears near bulkheads. Rescues and scanner assistance are automatic.</p></div></div><button class=\"action primary\" data-action=\"back\">Got it. Back to work.</button></div></div>\n<div id=\"settings\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\">PERSONAL EQUIPMENT</div><h2>Make yourself at home.</h2><label class=\"setting\">Music <output id=\"music-val\">10%</output><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"></label><label class=\"setting\">Sound effects & voices <output id=\"sfx-val\">65%</output><input id=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"></label><div class=\"setting\">Controller symbols<button id=\"glyph-toggle\">PlayStation</button></div><div class=\"setting\">Aim assistance<button id=\"assist-toggle\">On</button></div><label class=\"setting\">Screen shake <output id=\"shake-val\">60%</output><input id=\"shake\" type=\"range\" min=\"0\" max=\"100\" value=\"60\"></label><button class=\"action primary\" data-action=\"back\">Back</button></div></div>\n<div id=\"dev\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE DIVISION / ENGINEERING</div><h2>Dev mode.</h2><p class=\"dev-note\">Changes apply live. A shift using these tools is marked TRAINING.</p><div id=\"dev-sliders\" class=\"split\"></div><div class=\"split\"><div class=\"setting\">Invulnerable suit<button id=\"god-toggle\">Off</button></div><div class=\"setting\">Unlimited rotor power<button id=\"fuel-toggle\">Off</button></div><div class=\"setting\">Physics collision outlines<button id=\"physics-toggle\">Off</button></div></div><div><button class=\"action\" data-action=\"refill\">Refill equipment</button><button class=\"action\" data-action=\"teleport\">Return to checkpoint</button><button class=\"action\" data-action=\"rescue-dev\">Rescue this sector</button><button class=\"action\" data-action=\"next-dev\">Next sector</button><button class=\"action\" data-action=\"defaults\">Reset defaults</button></div><button class=\"action primary\" data-action=\"back\">Back to pause</button></div></div>\n<div id=\"race\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE RACE / UP TO FOUR VIA AI HUB</div><h2>Same mine. Friendly rivalry.</h2><p class=\"lead\">Race a ghost pilot. Each player has their own cave; fastest full rescue wins. For an online session, launch this game in AI Hub. Direct pairing below connects two copies.</p><div class=\"split\"><div><h3>On this computer</h3><p class=\"smallprint\">Open this same game in a second browser tab. Choose this option in both, then start the race.</p><button class=\"action\" data-action=\"local-link\">Connect local tabs</button><h3 style=\"margin-top:24px\">On different devices</h3><p class=\"smallprint\">One pilot creates an offer and sends the code to the other. The other pastes it and creates an answer. Send that answer back to the first pilot. A direct connection may depend on your network.</p><button class=\"action\" data-action=\"offer\">1 · Create offer</button><button class=\"action\" data-action=\"answer\">2 · Answer offer</button><button class=\"action\" data-action=\"accept\">3 · Accept answer</button></div><div><label class=\"smallprint\" for=\"remote-code\">PASTE THE OTHER PILOT’S CODE</label><textarea id=\"remote-code\" placeholder=\"Paste offer or answer code here\" spellcheck=\"false\"></textarea><label class=\"smallprint\" for=\"link-code\">YOUR CODE · COPY AND SHARE</label><textarea id=\"link-code\" readonly spellcheck=\"false\"></textarea><button class=\"action\" data-action=\"copy\">Copy my code</button><div class=\"network-status\" id=\"network-status\">Ready to link.</div><button class=\"action primary\" data-action=\"race-start\">Start race together</button><button class=\"action\" data-action=\"disconnect\">Disconnect</button></div></div><button class=\"action\" data-action=\"back\">Back</button></div></div>\n<div id=\"about\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE DIVISION / RECORDS OFFICE</div><h2>H.E.R.O. Blast Shift</h2><p class=\"lead\">A small rotor. A big responsibility.</p><div id=\"about-content\" class=\"about-copy\"></div><button class=\"action primary\" data-action=\"back\">Back</button></div></div>\n<div id=\"result\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\" id=\"result-eyebrow\">SHIFT COMPLETE</div><h2 id=\"result-title\">Everybody’s coming home.</h2><div class=\"result-score\" id=\"result-score\">000000</div><p class=\"lead\" id=\"result-copy\">Six helmets. Six smiles. One well-earned break.</p><div id=\"result-stats\"></div><nav class=\"menu\" style=\"margin-top:20px\"><button class=\"primary\" data-action=\"start\">Another shift</button><button data-action=\"quit\">Return to title</button></nav></div></div>\n<div id=\"hub-wait\" class=\"overlay hidden\"><div class=\"panel narrow loading\"><div class=\"eyebrow\">RESCUE RACE</div><h2>Standing by.</h2><p class=\"lead\">Waiting for the shift whistle.</p><div id=\"hub-countdown\"></div></div></div>\n<div id=\"sector-transition\"><div class=\"transition-text\" id=\"transition-text\"></div></div>\n<div id=\"map-wrap\" class=\"hidden\"><div class=\"smallprint\">CAVE SCANNER • LIVE</div><canvas id=\"map\" width=\"300\" height=\"175\"></canvas></div>\n<button id=\"touch-menu\" aria-label=\"Pause\">Ⅱ</button><button id=\"touch-action\" aria-label=\"Drop charge\">CHARGE</button><div id=\"touch-ring\" class=\"touch-ring\"></div><div id=\"touch-hint\" class=\"hidden\">LEFT THUMB · FLY & MOVE / RIGHT THUMB · AIM & FIRE</div>\n<script type=\"module\">/*GAME_CODE*/</script></body></html>\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > levels.js <<'EOF'\nconst R=(x,y,w,h,type='rock')=>({x,y,w,h,type});\nexport const LEVELS=[\n {name:'The Lantern Hollow',subtitle:'Two miners. One very questionable elevator.',palette:0,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(8,23,16,1.8),R(47,23,14,1.8),R(6,13,12,1.8),R(36,13,36,1.8),R(28,20,6,1,'metal')],\n barriers:[{...R(13,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(28,1.15,10,.65,'lava')],miners:[{x:7,y:2.05,name:'Pip'},{x:49,y:14.95,name:'Dot'}],docks:[{x:4,y:24},{x:33,y:14}],\n enemies:[{x:20,y:21,type:'bat',range:5},{x:27,y:8,type:'bat',range:5},{x:38,y:15.4,type:'spider',range:3},{x:49,y:19.5,type:'bat',range:2}],\n crystals:[{x:18,y:21},{x:17,y:17},{x:17,y:9},{x:8,y:6},{x:22,y:4},{x:28,y:5},{x:34,y:5},{x:28,y:22},{x:37,y:17},{x:49,y:21}],\n briefing:'MINERS BELOW.\\\\nBRING THEM BACK.',hint:'Hold your jetpack to fly. Release to drop. Land to recharge.',tools:'JETPACK / LASER / CHARGES',par:150},\n {name:'The Cinder Works',subtitle:'The rocks are hot. The overtime is not.',palette:1,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(7,23,14,1.8),R(47,23,14,1.8),R(7,13,14,1.8),R(36.5,13,35,1.8),R(24,21,5,1,'metal'),R(34,7,4,1,'metal')],\n barriers:[{...R(15,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(27,1.2,18,.8,'lava'),R(38,14.2,4,.65,'vent')],miners:[{x:6,y:2.05,name:'Moe'},{x:49,y:14.95,name:'Bea'}],docks:[{x:4,y:24},{x:25,y:14}],\n enemies:[{x:19,y:23,type:'bat',range:3},{x:21,y:9,type:'bat',range:3},{x:32,y:18,type:'bat',range:4},{x:39,y:15.3,type:'spider',range:2},{x:49,y:19,type:'bat',range:3}],\n crystals:[{x:15.5,y:21},{x:17,y:16},{x:17,y:7},{x:8,y:7},{x:21,y:5},{x:27,y:5},{x:34,y:9},{x:24,y:23},{x:37,y:19},{x:49,y:21}],\n briefing:'HOT ROCKS.\\\\nCOOL HEAD.',hint:'Steam vents cycle on and off. Wait for the blue light.',tools:'HEAT / VENTS / NARROW LANDINGS',par:170},\n {name:'The Sunken Signal',subtitle:'Last call from the bottom of the world.',palette:2,start:{x:4,y:25.4},exit:{x:50,y:25.5},width:54,height:30,\n solids:[R(-1,15,2,34),R(55,15,2,34),R(27,-.2,56,2.4),R(27,31,56,2),R(8,23,16,1.8),R(47,23,14,1.8),R(6,13,12,1.8),R(36,13,36,1.8),R(25,21,4,1,'metal'),R(33,6,5,1,'metal')],\n barriers:[{...R(13,6.6,1.4,11.2),id:'a'},{...R(43,18.45,1.4,9.1),id:'b'}],\n hazards:[R(29,2,24,2,'water'),R(37,14.2,3,.65,'vent')],miners:[{x:6,y:2.05,name:'Lee'},{x:49,y:14.95,name:'Kit'}],docks:[{x:4,y:24},{x:25,y:14}],\n enemies:[{x:20,y:23,type:'bat',range:4},{x:24,y:9,type:'bat',range:4},{x:35,y:8,type:'jelly',range:4},{x:38,y:15.3,type:'spider',range:2},{x:49,y:19,type:'bat',range:3},{x:34,y:22,type:'bat',range:3}],\n crystals:[{x:18,y:21},{x:16,y:16},{x:16,y:8},{x:6,y:7},{x:21,y:5},{x:27,y:5},{x:34,y:8},{x:25,y:23},{x:37,y:18},{x:49,y:21}],\n briefing:'ONE LAST SIGNAL.\\\\nNO ONE LEFT BELOW.',hint:'Floodwater pulls you down. Short bursts keep your pack dry.',tools:'FLOOD / LAST RESCUE / EXTRACTION',par:190}\n];\nEOF\ncat > index.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#06191f\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Rescue six miners across three caves, then reach the extraction lift. Fastest complete rescue wins; otherwise score wins.\">\n<meta name=\"hub:session-howto\" content=\"Left stick move; Cross / left stick up fly; R2 laser; R1 charge; Triangle scanner. Keyboard: A/D move, Space/W fly, mouse aim + fire, E charge, Q scan.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>H.E.R.O. Blast Shift</title>\n<style>\n:root{--paper:#f5ecd6;--gold:#ffc652;--orange:#ff744c;--cyan:#79d8cb;--ink:#06191f;--muted:#97b4b5;--line:#355157;--ui:clamp(16px,1.5vw,24px)}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--paper);font-family:Arial,Helvetica,sans-serif;font-size:var(--ui)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:5px}button{touch-action:manipulation}canvas#game{position:absolute;inset:0;width:100%;height:100%;display:block}button,input,select{-webkit-tap-highlight-color:transparent}body::after{content:\"\";position:fixed;inset:0;pointer-events:none;box-shadow:inset 0 0 14vw #02121660;z-index:1}.hidden{display:none!important}.overlay{position:absolute;inset:0;z-index:5;display:flex;padding:clamp(28px,5vw,90px);background:linear-gradient(90deg,#03151ce8,#03151c9c 43%,#03151c05 79%);align-items:center}.panel{max-width:1050px;width:min(100%,1000px);margin:auto;background:#071c23ee;border:1px solid #557277;padding:clamp(24px,4vw,60px);box-shadow:12px 12px 0 #0005;max-height:91vh;overflow:auto;scrollbar-color:var(--gold) var(--ink)}.narrow{max-width:650px}.eyebrow{font:700 .65rem/1.4 monospace;letter-spacing:.23em;color:var(--cyan);text-transform:uppercase}.stamp{display:inline-block;padding:.35em .65em;border:1px solid var(--gold);color:var(--gold);font:700 .6rem monospace;letter-spacing:.15em;transform:rotate(-3deg);margin-left:.7em;vertical-align:middle}.hero-title{margin:18px 0 15px;font-size:clamp(55px,7.1vw,130px);line-height:.88;letter-spacing:-.06em;font-weight:950;text-shadow:5px 6px 0 #020e16;max-width:740px}.hero-title small{display:block;font-size:.28em;letter-spacing:.28em;line-height:1.5;color:var(--gold);margin-bottom:.25em}.hero-title em{font-style:normal;color:var(--gold)}.tagline{font-size:.88rem;line-height:1.5;color:#c3d2cf;max-width:400px;margin:22px 0}.title-content{width:47%;min-width:360px;max-width:740px}.menu{display:flex;flex-direction:column;gap:7px;align-items:stretch}.menu button,.action{border:1px solid transparent;background:transparent;color:var(--paper);padding:.65em .8em;text-align:left;font-size:.85rem;letter-spacing:.04em;position:relative;transition:background .15s,border .15s}.menu button:hover,.menu button:focus,.action:hover,.action:focus{background:#194046;border-color:#61938e;outline:none}.menu button:focus::before{content:\"\";position:absolute;left:-2px;top:0;bottom:0;width:5px;background:var(--gold)}.menu .primary,.primary{background:var(--gold);color:#11232a;font-weight:800;border-color:var(--gold)}.menu .primary:hover,.menu .primary:focus,.primary:hover,.primary:focus{background:#ffdb86;color:#071a22;border-color:#fff1ba}.action{display:inline-block;border-color:#4e7476;margin:.35em .4em .2em 0;padding:.65em .9em}.smallprint{font: .55rem/1.6 monospace;color:var(--muted);letter-spacing:.05em}.title-footer{position:absolute;left:5vw;right:5vw;bottom:3vh;display:flex;justify-content:space-between;gap:20px;font:.55rem monospace;letter-spacing:.12em;color:#b2c9c3}.title-note{position:absolute;right:5.5vw;bottom:20vh;text-align:right;max-width:290px;font:700 .68rem/1.6 monospace;letter-spacing:.06em}.title-note b{color:var(--gold)}h1,h2,h3,p{margin-top:0}h2{font-size:2.2rem;letter-spacing:-.045em;margin-bottom:.5em}h3{font-size:1rem;color:var(--gold)}.lead{font-size:.9rem;line-height:1.6;color:#becdc9}.split{display:grid;grid-template-columns:1fr 1fr;gap:24px}.setting{display:grid;grid-template-columns:1fr auto;gap:10px 20px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);font-size:.8rem}.setting input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--gold);height:24px}.setting button{background:#16383d;color:var(--paper);border:1px solid #4d7375;padding:.4em .7em;min-width:100px}.setting output{color:var(--gold);font-family:monospace}.help-row{display:flex;gap:16px;border-bottom:1px solid var(--line);padding:14px 0;align-items:center;font-size:.85rem}.help-row strong{min-width:35%;color:var(--gold)}.about-copy{font-size:.66rem;line-height:1.7;color:#c3d0c9}.about-copy b{color:var(--gold)}.about-copy p{margin-bottom:.7em}.about-copy h3{margin-top:1.5em;margin-bottom:.5em}.feedback{font-size:.62rem;line-height:1.5;color:#acc0bd}.feedback li{margin:8px 0}#hud{position:absolute;inset:0;z-index:2;pointer-events:none;padding:3vh 3.5vw;display:flex;flex-direction:column;justify-content:space-between}#hud::before{content:\"\";position:absolute;inset:0;background:linear-gradient(#04131b77,transparent 20%,transparent 78%,#04131bbb);z-index:-1}.hud-top,.hud-bottom{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.sector-name{font-size:1rem;font-weight:800;letter-spacing:.015em}.sector-small{font:.55rem monospace;color:var(--cyan);letter-spacing:.18em;margin-bottom:7px}.rescue-dots{display:flex;gap:8px;align-items:center;margin-top:10px;font:.6rem monospace}.rescue-dots i{display:inline-block;width:11px;height:14px;border:2px solid #738d88;transform:skew(-10deg)}.rescue-dots i.on{background:var(--gold);border-color:var(--gold)}.score{text-align:right}.score strong{font:800 1.4rem monospace;letter-spacing:.06em}.score .smallprint{display:block}.health{color:var(--orange);font-size:1rem;letter-spacing:.2em;margin-bottom:7px}.fuel{width:220px;height:8px;background:#183a42;border:1px solid #829b90;transform:skew(-13deg)}.fuel div{height:100%;width:100%;background:var(--gold);transition:width .1s}.fuel-label{font:700 .55rem monospace;display:flex;justify-content:space-between;color:var(--gold);margin-bottom:7px}.supplies{display:flex;gap:25px;align-items:center;margin-top:12px;font:.65rem monospace}.hud-controls{font:.56rem/1.9 monospace;color:#c0d2c6;text-align:right;align-self:flex-end}.glyph{color:var(--gold);font-weight:800}#objective{position:absolute;top:3vh;left:50%;transform:translateX(-50%);font:700 .6rem/1.5 monospace;text-align:center;color:var(--gold);letter-spacing:.1em;max-width:34%;padding:.5em 1em;background:#052028ad;border-bottom:1px solid #638775}#toast{position:absolute;left:50%;top:23%;transform:translateX(-50%);text-align:center;pointer-events:none;font-size:1rem;font-weight:800;letter-spacing:.03em;text-shadow:2px 2px #05171d;transition:opacity .3s;min-width:50%}#toast small{display:block;font:.6rem/1.8 monospace;color:var(--cyan);margin-top:6px}#context{position:absolute;left:50%;bottom:15%;transform:translateX(-50%);background:#081e26df;border-left:3px solid var(--gold);padding:.6em 1em;font:.65rem/1.5 monospace;color:var(--paper);text-align:center;max-width:70%;transition:opacity .2s}.pill{position:absolute;left:50%;bottom:5vh;transform:translateX(-50%);z-index:7;background:var(--gold);color:#082128;padding:12px 24px;font:800 .7rem monospace;letter-spacing:.12em;text-align:center}.pill small{display:block;font:.55rem monospace;margin-top:6px;letter-spacing:.03em}#touch-menu{position:absolute;right:4vw;top:3vh;z-index:8;display:none;border:1px solid #89a99a;color:var(--paper);background:#071c23b0;width:45px;height:42px;font-size:24px}#touch-action{position:absolute;right:6vw;bottom:13vh;z-index:8;border:1px solid var(--gold);background:#082028b0;color:var(--gold);border-radius:50%;width:80px;height:80px;font-size:.65rem;font-weight:700;display:none}#touch-hint{position:absolute;z-index:3;left:50%;bottom:5vh;transform:translateX(-50%);font:.55rem monospace;color:#c3d8c6;pointer-events:none;white-space:nowrap}.touch-ring{position:absolute;width:100px;height:100px;border:1px solid #b9e4c34a;border-radius:50%;z-index:4;pointer-events:none;background:#133e3c33;display:none}.touch-ring::after{content:\"\";position:absolute;width:22px;height:22px;border-radius:50%;background:#ffe0a077;left:39px;top:39px}#map-wrap{position:absolute;z-index:4;right:3.5vw;top:15vh;width:250px;background:#05212aeb;border:1px solid #487572;padding:15px;pointer-events:none}#map-wrap canvas{width:100%;height:auto}#map-wrap .smallprint{color:var(--cyan)}.result-score{font:800 3.5rem monospace;color:var(--gold);letter-spacing:-.06em;margin:.2em 0}.statline{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line);font:.75rem monospace}.statline b{color:var(--gold)}#link-code,#remote-code{display:block;width:100%;height:80px;resize:vertical;background:#03161d;border:1px solid #426b71;color:#d5dfd2;padding:10px;font:.55rem monospace;word-break:break-all;margin:10px 0}.network-status{color:var(--cyan);font:.65rem/1.5 monospace;min-height:1.6em}.loading{font:700 .7rem/2 monospace;letter-spacing:.15em;text-align:center}.loading-dot{display:block;margin:25px auto;width:40px;height:40px;border:3px solid #304d50;border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#damage{position:absolute;inset:0;pointer-events:none;z-index:3;border:0 solid #fb654d;box-shadow:inset 0 0 100px #ff553800;transition:box-shadow .15s}.danger-flash{box-shadow:inset 0 0 100px #ff553899!important}#sector-transition{position:absolute;inset:0;z-index:4;pointer-events:none;display:flex;align-items:center;justify-content:center;background:#04141e;opacity:0;transition:opacity .3s}.transition-text{text-align:center;font-size:3rem;font-weight:900;line-height:1.1;letter-spacing:-.04em;color:var(--gold)}.transition-text small{display:block;font:700 .65rem monospace;color:var(--cyan);letter-spacing:.2em;margin-bottom:20px}#ghosts{font:.55rem monospace;color:var(--cyan);margin-top:10px}.dev-note{font:.55rem monospace;color:var(--orange);line-height:1.5}.title-rail{position:absolute;right:5vw;top:5vh;font:.55rem monospace;letter-spacing:.1em;text-align:right;color:#b7c9c1}.title-rail b{color:var(--gold)}\n@media(max-width:900px){.title-content{min-width:290px;width:52%}.hero-title{font-size:70px}.panel{max-height:92vh}.hud-controls{max-width:42%;font-size:.5rem}#objective{top:12vh;max-width:65%;font-size:.5rem}.title-note{font-size:.55rem;right:4vw;max-width:190px}.sector-name{font-size:.85rem}.fuel{width:180px}.title-footer{font-size:.45rem}.title-rail{display:none}}\n@media(pointer:coarse){body.touch-playing #touch-menu{display:block}body.touch-playing #touch-action.available{display:block}.hud-controls{display:none}.hud-bottom .supplies{display:none}body.touch-playing #hud{padding:3vh 5vw}body.touch-playing #objective{top:11vh}body.touch-playing #hud .score{margin-right:48px}body.touch-playing .fuel{width:130px}body.touch-playing .fuel-label{display:none}body.touch-playing .hud-top .sector-small{display:none}}\n@media(max-width:600px){.overlay{padding:25px}.title-content{width:100%;min-width:0;max-width:300px}.hero-title{font-size:64px}.title-note{display:none}.tagline{font-size:.8rem;max-width:240px}.title-footer span:last-child{display:none}.split{grid-template-columns:1fr;gap:10px}.panel{padding:24px}.hero-title small{font-size:.27em}.menu{gap:2px}.menu button{padding:.65em}.hud-top .sector-name{max-width:165px}.score strong{font-size:1rem}.health{font-size:.8rem}.supplies{font-size:.55rem}.fuel{width:140px}.hud-controls{max-width:50%;font-size:.42rem}#map-wrap{width:185px;top:19vh}#context{font-size:.55rem;bottom:19%;max-width:85%;width:max-content}.title-footer{bottom:2vh}.title-content .eyebrow{font-size:.55rem}.help-row{font-size:.7rem}.help-row strong{min-width:36%}}\n@media(max-height:650px) and (min-width:700px){.hero-title{font-size:65px;margin:8px 0}.tagline{margin:12px 0}.menu button{padding:.4em .7em}.title-content .eyebrow{font-size:.55rem}.title-footer{bottom:2vh}.overlay{padding:4vh 6vw}.panel{padding:25px}h2{font-size:1.8rem}.setting{padding:8px 0}}\n</style></head><body>\n<canvas id=\"game\" aria-label=\"H.E.R.O. Blast Shift game world\"></canvas><div id=\"damage\"></div>\n<div id=\"boot\" class=\"overlay\"><div class=\"panel narrow loading\"><div class=\"eyebrow\">RESCUE DIVISION / EST. 1984</div><h2>Warming up the rotors.</h2><span class=\"loading-dot\"></span><div id=\"load-status\">Preparing cave systems…</div></div></div>\n<div id=\"title\" class=\"overlay hidden\"><div class=\"title-content\"><div class=\"eyebrow\">UNDERGROUND RESCUE DIVISION <span class=\"stamp\">NIGHT CREW</span></div><h1 class=\"hero-title\"><small>H.E.R.O.</small>BLAST<br><em>SHIFT</em></h1><p class=\"tagline\">Bad rocks. Good intentions.<br>Six miners are counting on you.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"start\">Start shift <span style=\"float:right\">→</span></button><button data-action=\"race\">Race a friend</button><button data-action=\"help\">Field manual</button><button data-action=\"settings\">Settings</button><button data-action=\"about\">About & credits</button></nav></div><div class=\"title-rail\">PERSONAL HELICOPTER EMERGENCY<br>RESPONSE OPERATIVE<br><br><b>SECTOR 07 • BELOW GROUND</b></div><div class=\"title-note\"><b>YOUR SHIFT, SHOULD YOU ACCEPT IT</b><br>Fly in. Blast through.<br>Bring everyone home.<br><br>3 CAVERNS / 6 RESCUES<br>ONE EXTREMELY SMALL ROTOR.</div><div class=\"title-footer\"><span id=\"title-input\">KEYBOARD + MOUSE READY</span><span>AN ORIGINAL CAVE RESCUE • INSPIRED BY H.E.R.O. (1984)</span></div></div>\n<div id=\"hud\" class=\"hidden\"><div class=\"hud-top\"><div><div class=\"sector-small\" id=\"sector-number\">RESCUE SECTOR 01 / 03</div><div class=\"sector-name\" id=\"sector-name\"></div><div class=\"rescue-dots\" id=\"rescue-dots\"></div><div id=\"ghosts\"></div></div><div class=\"score\"><span class=\"smallprint\">SHIFT SCORE</span><strong id=\"score\">000000</strong><span class=\"smallprint\" id=\"timer\">00:00</span></div></div><div id=\"objective\"></div><div class=\"hud-bottom\"><div><div class=\"health\" id=\"hearts\">♥ ♥ ♥</div><div class=\"fuel-label\"><span>ROTOR POWER</span><span id=\"fuel-number\">100%</span></div><div class=\"fuel\"><div id=\"fuel-bar\"></div></div><div class=\"supplies\"><span id=\"bomb-count\">▰ ▰ ▰</span><span id=\"lives\">03 SUITS</span></div></div><div class=\"hud-controls\" id=\"controls\"></div></div><div id=\"toast\"></div><div id=\"context\"></div></div>\n<div id=\"attract\" class=\"pill hidden\">RESCUE IN PROGRESS<small>Attract demo · press any button to return</small></div>\n<div id=\"pause\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\">ROTOR ON HOLD</div><h2>Catch your breath.</h2><p class=\"lead\" id=\"pause-caption\">Everyone still needs a lift.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"resume\">Back to the mine</button><button data-action=\"manual-pause\">Field manual</button><button data-action=\"settings-pause\">Settings</button><button data-action=\"dev\">Dev mode</button><button data-action=\"restart\">Restart shift</button><button data-action=\"quit\">End shift</button></nav></div></div>\n<div id=\"help\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">THE FIELD MANUAL / READ BEFORE DESCENT</div><h2>A little lift goes a long way.</h2><div class=\"split\"><div><div class=\"help-row\"><strong data-prompt=\"move\">A / D</strong><span>Move left / right</span></div><div class=\"help-row\"><strong data-prompt=\"fly\">SPACE / W</strong><span>Hold to fly. Release to descend.</span></div><div class=\"help-row\"><strong data-prompt=\"fire\">MOUSE / J</strong><span>Aim and fire your helmet laser.</span></div><div class=\"help-row\"><strong data-prompt=\"bomb\">E / RIGHT CLICK</strong><span>Drop a charge. Back away before it blows.</span></div><div class=\"help-row\"><strong data-prompt=\"scan\">Q</strong><span>Pulse the cave scanner.</span></div><div class=\"help-row\"><strong data-prompt=\"pause\">ESC / P</strong><span>Pause / settings / dev tools.</span></div></div><div><h3>Leave no miner behind.</h3><p class=\"lead\">Find both miners in each cavern. Get close to send them up the rescue tether. Then fly to the striped lift in the upper right.</p><p class=\"lead\">Orange bulkheads need a charge. Your laser clears creatures. Avoid lava and red steam vents; blue vents are safe.</p><p class=\"lead\">Land to recover rotor power. Green service pads restore your suit, charges and power, and set your checkpoint. You have three replacement suits for the whole shift.</p><p class=\"smallprint\">TOUCH: drag the left side to move and fly; hold the right side to aim and shoot. A charge button appears near bulkheads. Rescues and scanner assistance are automatic.</p></div></div><button class=\"action primary\" data-action=\"back\">Got it. Back to work.</button></div></div>\n<div id=\"settings\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\">PERSONAL EQUIPMENT</div><h2>Make yourself at home.</h2><label class=\"setting\">Music <output id=\"music-val\">10%</output><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"></label><label class=\"setting\">Sound effects & voices <output id=\"sfx-val\">65%</output><input id=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"></label><div class=\"setting\">Controller symbols<button id=\"glyph-toggle\">PlayStation</button></div><div class=\"setting\">Aim assistance<button id=\"assist-toggle\">On</button></div><label class=\"setting\">Screen shake <output id=\"shake-val\">60%</output><input id=\"shake\" type=\"range\" min=\"0\" max=\"100\" value=\"60\"></label><button class=\"action primary\" data-action=\"back\">Back</button></div></div>\n<div id=\"dev\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE DIVISION / ENGINEERING</div><h2>Dev mode.</h2><p class=\"dev-note\">Changes apply live. A shift using these tools is marked TRAINING.</p><div id=\"dev-sliders\" class=\"split\"></div><div class=\"split\"><div class=\"setting\">Invulnerable suit<button id=\"god-toggle\">Off</button></div><div class=\"setting\">Unlimited rotor power<button id=\"fuel-toggle\">Off</button></div><div class=\"setting\">Physics collision outlines<button id=\"physics-toggle\">Off</button></div></div><div><button class=\"action\" data-action=\"refill\">Refill equipment</button><button class=\"action\" data-action=\"teleport\">Return to checkpoint</button><button class=\"action\" data-action=\"rescue-dev\">Rescue this sector</button><button class=\"action\" data-action=\"next-dev\">Next sector</button><button class=\"action\" data-action=\"defaults\">Reset defaults</button></div><button class=\"action primary\" data-action=\"back\">Back to pause</button></div></div>\n<div id=\"race\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE RACE / UP TO FOUR VIA AI HUB</div><h2>Same mine. Friendly rivalry.</h2><p class=\"lead\">Race a ghost pilot. Each player has their own cave; fastest full rescue wins. For an online session, launch this game in AI Hub. Direct pairing below connects two copies.</p><div class=\"split\"><div><h3>On this computer</h3><p class=\"smallprint\">Open this same game in a second browser tab. Choose this option in both, then start the race.</p><button class=\"action\" data-action=\"local-link\">Connect local tabs</button><h3 style=\"margin-top:24px\">On different devices</h3><p class=\"smallprint\">One pilot creates an offer and sends the code to the other. The other pastes it and creates an answer. Send that answer back to the first pilot. A direct connection may depend on your network.</p><button class=\"action\" data-action=\"offer\">1 · Create offer</button><button class=\"action\" data-action=\"answer\">2 · Answer offer</button><button class=\"action\" data-action=\"accept\">3 · Accept answer</button></div><div><label class=\"smallprint\" for=\"remote-code\">PASTE THE OTHER PILOT’S CODE</label><textarea id=\"remote-code\" placeholder=\"Paste offer or answer code here\" spellcheck=\"false\"></textarea><label class=\"smallprint\" for=\"link-code\">YOUR CODE · COPY AND SHARE</label><textarea id=\"link-code\" readonly spellcheck=\"false\"></textarea><button class=\"action\" data-action=\"copy\">Copy my code</button><div class=\"network-status\" id=\"network-status\">Ready to link.</div><button class=\"action primary\" data-action=\"race-start\">Start race together</button><button class=\"action\" data-action=\"disconnect\">Disconnect</button></div></div><button class=\"action\" data-action=\"back\">Back</button></div></div>\n<div id=\"about\" class=\"overlay hidden\"><div class=\"panel\"><div class=\"eyebrow\">RESCUE DIVISION / RECORDS OFFICE</div><h2>H.E.R.O. Blast Shift</h2><p class=\"lead\">A small rotor. A big responsibility.</p><div id=\"about-content\" class=\"about-copy\"></div><button class=\"action primary\" data-action=\"back\">Back</button></div></div>\n<div id=\"result\" class=\"overlay hidden\"><div class=\"panel narrow\"><div class=\"eyebrow\" id=\"result-eyebrow\">SHIFT COMPLETE</div><h2 id=\"result-title\">Everybody’s coming home.</h2><div class=\"result-score\" id=\"result-score\">000000</div><p class=\"lead\" id=\"result-copy\">Six helmets. Six smiles. One well-earned break.</p><div id=\"result-stats\"></div><nav class=\"menu\" style=\"margin-top:20px\"><button class=\"primary\" data-action=\"start\">Another shift</button><button data-action=\"quit\">Return to title</button></nav></div></div>\n<div id=\"hub-wait\" class=\"overlay hidden\"><div class=\"panel narrow loading\"><div class=\"eyebrow\">RESCUE RACE</div><h2>Standing by.</h2><p class=\"lead\">Waiting for the shift whistle.</p><div id=\"hub-countdown\"></div></div></div>\n<div id=\"sector-transition\"><div class=\"transition-text\" id=\"transition-text\"></div></div>\n<div id=\"map-wrap\" class=\"hidden\"><div class=\"smallprint\">CAVE SCANNER • LIVE</div><canvas id=\"map\" width=\"300\" height=\"175\"></canvas></div>\n<button id=\"touch-menu\" aria-label=\"Pause\">Ⅱ</button><button id=\"touch-action\" aria-label=\"Drop charge\">CHARGE</button><div id=\"touch-ring\" class=\"touch-ring\"></div><div id=\"touch-hint\" class=\"hidden\">LEFT THUMB · FLY & MOVE / RIGHT THUMB · AIM & FIRE</div>\n<script type=\"module\">/*GAME_CODE*/</script></body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' art.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' art.js\"","aggregated_output":"import * as THREE from 'three/webgpu';\n\n// All of the mine's art is geometry, ink contours, and three-band light.\nconst INK = 0x06141d;\nconst ramp = new THREE.DataTexture(new Uint8Array([62, 62, 62, 255, 144, 144, 144, 255, 255, 255, 255, 255]), 3, 1, THREE.RGBAFormat);\nramp.minFilter = THREE.NearestFilter;\nramp.magFilter = THREE.NearestFilter;\nramp.generateMipmaps = false;\nramp.needsUpdate = true;\n\nexport function makeMat(value, emissive = 0, transparent = false) {\n  return new THREE.MeshToonNodeMaterial({\n    color: value, gradientMap: ramp, emissive,\n    emissiveIntensity: emissive ? 0.65 : 0,\n    transparent, opacity: transparent ? 0.4 : 1,\n  });\n}\n\nconst ink = new THREE.MeshBasicMaterial({ color: INK, side: THREE.BackSide });\nconst edgeMat = new THREE.LineBasicMaterial({ color: INK, transparent: true, opacity: .82 });\nconst mats = {\n  ink: makeMat(INK), rock: makeMat(0x203b45), rockLight: makeMat(0x335760),\n  deep: makeMat(0x142c38), teal: makeMat(0x3b989a), steel: makeMat(0x586a73),\n  darkSteel: makeMat(0x243741), amber: makeMat(0xffc457), orange: makeMat(0xf28b42),\n  cream: makeMat(0xffedb3), white: makeMat(0xe9f6ec), red: makeMat(0xee6552),\n  glow: makeMat(0x88f7d1, 0x49c6b0), lamp: makeMat(0xffe4a0, 0xffb44e),\n  hot: makeMat(0xff6542, 0xe63f28), water: makeMat(0x246d8c, 0x143746, true),\n};\nconst boxGeo = new THREE.BoxGeometry(1, 1, 1);\nconst ballGeo = new THREE.IcosahedronGeometry(1, 1);\nconst lowBallGeo = new THREE.IcosahedronGeometry(1, 0);\nconst cylinderGeo = new THREE.CylinderGeometry(1, 1, 1, 10);\n\nfunction box(parent, x, y, z, w, h, d, material, outline = true) {\n  const obj = new THREE.Mesh(boxGeo, material);\n  obj.position.set(x, y, z); obj.scale.set(w, h, d);\n  obj.castShadow = obj.receiveShadow = true; parent.add(obj);\n  if (outline) {\n    const shell = new THREE.Mesh(boxGeo, ink); shell.scale.set(1.035, 1.035, 1.035); obj.add(shell);\n  }\n  return obj;\n}\nfunction ball(parent, x, y, z, r, material, stretch = [1, 1, 1], outline = true) {\n  const obj = new THREE.Mesh(ballGeo, material);\n  obj.position.set(x, y, z); obj.scale.set(r * stretch[0], r * stretch[1], r * stretch[2]);\n  obj.castShadow = obj.receiveShadow = true; parent.add(obj);\n  if (outline) { const shell = new THREE.Mesh(ballGeo, ink); shell.scale.setScalar(1.055); obj.add(shell); }\n  return obj;\n}\nfunction rod(parent, from, to, radius, material, outline = false) {\n  const a = new THREE.Vector3(...from), b = new THREE.Vector3(...to), delta = b.clone().sub(a);\n  const obj = new THREE.Mesh(cylinderGeo, material); obj.position.copy(a).add(b).multiplyScalar(.5);\n  obj.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), delta.clone().normalize());\n  obj.scale.set(radius, delta.length(), radius); parent.add(obj);\n  if (outline) { const s = new THREE.Mesh(cylinderGeo, ink); s.scale.set(1.16, 1.02, 1.16); obj.add(s); }\n  return obj;\n}\nfunction line(parent, pts, value = 0x4b7a80) {\n  const geom = new THREE.BufferGeometry().setFromPoints(pts.map(p => new THREE.Vector3(...p)));\n  const obj = new THREE.Line(geom, new THREE.LineBasicMaterial({ color: value })); parent.add(obj); return obj;\n}\nfunction panel(parent, text, x, y, z, w, h, style = {}) {\n  const canvas = document.createElement('canvas'); canvas.width = Math.ceil(w * 100); canvas.height = Math.ceil(h * 100);\n  const ctx = canvas.getContext('2d');\n  ctx.fillStyle = style.bg || '#102630'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.strokeStyle = style.border || '#a1beb6'; ctx.lineWidth = 5; ctx.strokeRect(4, 4, canvas.width - 8, canvas.height - 8);\n  ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = style.color || '#ffe5a4';\n  ctx.font = `900 ${Math.floor(canvas.height * .48)}px \"Arial Narrow\", sans-serif`;\n  ctx.fillText(text, canvas.width / 2, canvas.height / 2 + 2, canvas.width * .92);\n  const texture = new THREE.CanvasTexture(canvas); texture.colorSpace = THREE.SRGBColorSpace;\n  const obj = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: texture, transparent: false }));\n  obj.position.set(x, y, z); parent.add(obj); return obj;\n}\nfunction crystal(parent, x, y, z, size, material) {\n  const obj = new THREE.Mesh(new THREE.ConeGeometry(.33, 1.3, 5), material);\n  obj.position.set(x, y, z); obj.scale.setScalar(size); obj.rotation.z = (x % 1 - .5) * .8; parent.add(obj);\n  const shell = new THREE.Mesh(obj.geometry, ink); shell.scale.setScalar(1.07); obj.add(shell); return obj;\n}\nfunction seeded(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }\n\nexport function createArt(scene) {\n  let world = new THREE.Group(); world.name = 'mine_art'; scene.add(world);\n  const particles = [], pulses = [], currents = [];\n  const fill = new THREE.HemisphereLight(0xb9f4e5, 0x142233, 2.15); scene.add(fill);\n  const key = new THREE.DirectionalLight(0xffdeb0, 3.1); key.position.set(-10, 24, 25); scene.add(key);\n  const cool = new THREE.DirectionalLight(0x8fded7, 1.4); cool.position.set(30, 4, 8); scene.add(cool);\n\n  function buildLevel(level) {\n    scene.remove(world); world = new THREE.Group(); world.name = 'mine_art'; scene.add(world);\n    clearEffects(); pulses.length = currents.length = 0;\n    const rnd = seeded(751 + level.index * 884), palettes = [\n      [0x0e2632, 0x173b45, 0x244c54, 0x507a78],\n      [0x281d2b, 0x3b2c39, 0x51434d, 0x7b6b65],\n      [0x0c2534, 0x18384c, 0x244c61, 0x567b86],\n    ];\n    const pal = palettes[level.index % palettes.length];\n    const localRock = makeMat(pal[2]), localLight = makeMat(pal[3]), localDeep = makeMat(pal[1]);\n    scene.background = new THREE.Color(pal[0]);\n    box(world, 27, 15, -8, 70, 45, .4, new THREE.MeshBasicMaterial({ color: pal[0] }), false);\n\n    // A deep, broken rock wall: large silhouettes read first, smaller seams second.\n    for (let i = 0; i < 110; i++) {\n      const x = rnd() * 64 - 5, y = rnd() * 38 - 4;\n      const obj = new THREE.Mesh(lowBallGeo, i % 4 === 0 ? localRock : localDeep);\n      obj.position.set(x, y, -6 - rnd() * 2); obj.scale.set(2 + rnd() * 4, 1 + rnd() * 3.8, .3 + rnd() * 1.2);\n      obj.rotation.z = rnd() * 6; world.add(obj);\n    }\n    for (let x = -1; x < 57; x += 7) {\n      rod(world, [x, 2, -4.4], [x + .3, 29, -4.4], .1, mats.darkSteel);\n      for (let y = 5; y < 29; y += 7) {\n        rod(world, [x - 1, y - 1, -4.4], [x + 1.2, y + 1, -4.4], .055, mats.steel);\n        ball(world, x, y, -4.15, .13, mats.amber, [1, 1, .5], false);\n      }\n    }\n    for (let y of [9, 21, 28.8]) {\n      const pts = [];\n      for (let x = -2; x < 58; x += 1) pts.push([x, y - Math.sin((x + 2) / 8 * Math.PI) * .55, -3.6]);\n      line(world, pts, 0x091a25); const wire = pts.map(p => [p[0], p[1] + .08, p[2] + .02]); line(world, wire, 0x78908a);\n    }\n    panel(world, `DEEPWORKS / ${['LANTERN HOLLOW', 'MAGMA WORKS', 'THE DROWNED VAULT'][level.index % 3]}`, 27, 28.5, -3.8, 14, 1.3,\n      { color: '#839c96', border: '#304e53', bg: '#102731' });\n    panel(world, 'NO ONE LEFT BELOW.', 28, 17.7, -3.4, 9, 1.15, { color: '#67867f', border: '#29474e', bg: '#102731' });\n\n    // Mineral seams and stalactites remain behind the playable silhouettes.\n    for (let i = 0; i < 42; i++) {\n      const x = rnd() * 54, y = rnd() * 27 + 1, s = .2 + rnd() * .65;\n      crystal(world, x, y, -4, s, level.index === 1 ? mats.orange : mats.teal);\n      if (i % 3 === 0) crystal(world, x + .22, y - .1, -3.95, s * .6, mats.glow);\n    }\n    for (let i = 0; i < 30; i++) {\n      const x = i * 1.9, h = .7 + rnd() * 2.6;\n      const geo = new THREE.ConeGeometry(.3 + rnd() * .7, h, 5);\n      const stal = new THREE.Mesh(geo, localDeep); stal.position.set(x, 30 - h / 2, -2); stal.rotation.z = Math.PI; world.add(stal);\n    }\n\n    for (const s of level.solids) {\n      const metallic = s.type === 'metal', base = metallic ? mats.darkSteel : localRock;\n      box(world, s.x, s.y, -.1, s.w, s.h, 2.5, base);\n      const topY = s.y + s.h / 2;\n      box(world, s.x, topY - .1, 1.24, s.w, .2, .18, metallic ? mats.steel : localLight, false);\n      // Individual slabs, seams and faceted debris give every wall its own surface.\n      if (s.h > 1.8) {\n        const count = Math.min(32, Math.floor(s.w * s.h / 2));\n        for (let i = 0; i < count; i++) {\n          const tx = s.x + (rnd() - .5) * Math.max(.1, s.w - .4), ty = s.y + (rnd() - .5) * Math.max(.1, s.h - .4);\n          const facet = new THREE.Mesh(lowBallGeo, i % 3 ? localDeep : localLight);\n          facet.position.set(tx, ty, 1.22); facet.scale.set(.3 + rnd() * 1.4, .15 + rnd() * .7, .1); facet.rotation.z = rnd() * 4;\n          world.add(facet);\n          if (i % 3 === 0) line(world, [[tx - .4, ty + .1, 1.4], [tx, ty, 1.42], [tx + .4, ty + .3, 1.4]], pal[0]);\n        }\n      }\n      if (s.w > 5 && s.h < 3) {\n        for (let x = s.x - s.w / 2 + .55; x < s.x + s.w / 2; x += 2) {\n          box(world, x, topY - .2, 1.36, .65, .16, .08, mats.amber, false);\n          rod(world, [x, s.y - s.h / 2, -.6], [x + 1.2, s.y - s.h / 2 - 1.2, -.6], .09, mats.darkSteel);\n        }\n        rod(world, [s.x - s.w / 2, topY + .18, -.9], [s.x + s.w / 2, topY + .18, -.9], .07, mats.steel);\n      }\n    }\n\n","exit_code":0,"status":"completed"}}
