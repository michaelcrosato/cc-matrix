{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfor p in ['test.py','hub-tests.py','transport_tests.py']:\n s=open(p).read();s='# ruff: noqa: BLE001\\\\n# Collect each browser-check failure so the suite can report all independent failures.\\\\n'+s\n if p=='test.py':s=s.replace('capture_output=True, text=True', 'capture_output=True, text=True, check=False')\n if p=='transport_tests.py':\n  s=s.replace('except Exception:\\\\n            pass','except Exception:  # noqa: S110 — the context is closed immediately after cleanup.\\\\n            pass')\n open(p,'w').write(s)\nPY\nruff format test.py hub-tests.py transport_tests.py\nruff check test.py transport_tests.py hub-tests.py preview.py\nnpm test --silent\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
