{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"kill 663148\ncat > smoke.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nfolder=Path(__file__).resolve().parent\nport=folder.joinpath('server-port.txt').read_text()\nurl=f'http://127.0.0.1:{port}/HERO-Blast-Shift-HERO-1984-gpt-6.1-sol-ultra-20261105-214551.html'\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n page=browser.new_page(viewport={'width':1600,'height':900},device_scale_factor=1)\n errors=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:print(m.type,m.text[:500]) if m.type in ['error','warning'] else None)\n page.goto(url,wait_until='load')\n print('TITLE',page.title())\n try:page.wait_for_function('window.__gameReady===true',timeout=120000)\n except Exception as e:print('BOOT ERROR',e,page.locator('#load-status').inner_text())\n print('STATE',json.dumps(page.evaluate('window.__game.state')))\n page.screenshot(path=str(folder/'title.png'))\n page.evaluate('window.__game.start()')\n page.wait_for_timeout(1600)\n print('GAME',json.dumps(page.evaluate('window.__game.state')))\n page.screenshot(path=str(folder/'gameplay.png'))\n print('ERRORS',errors)\n browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
