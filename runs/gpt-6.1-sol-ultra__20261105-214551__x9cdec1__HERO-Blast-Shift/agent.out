{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '190,260p' art.js\nsed -n '1,220p' transport_tests.py\ncat hub-tests.py\"","aggregated_output":"        const strip = box(group, 0, y, 1.28, wall.w * .92, .2, .1, mats.ink, false); strip.rotation.z = -.35;\n      }\n      box(group, -wall.w / 2, 0, 1.3, .16, wall.h, .15, mats.steel);\n      box(group, wall.w / 2, 0, 1.3, .16, wall.h, .15, mats.steel);\n      if (wall.h > 2) panel(group, 'BLAST', 0, .25, 1.45, Math.max(.8, wall.w * .95), .7,\n        { color: '#172b30', bg: '#ffe0a1', border: '#172b30' });\n      box(group, 0, wall.h / 2 + .17, .6, .35, .25, .35, mats.red);\n      barriers.set(wall.id, group);\n    }\n\n    const docks = [];\n    for (const d of level.docks) {\n      const group = new THREE.Group(); group.position.set(d.x, d.y, 0); world.add(group);\n      box(group, 0, -.75, -.1, 2.7, .22, 2.2, mats.steel);\n      box(group, -.95, .1, -.6, .32, 1.65, .5, mats.orange);\n      box(group, .95, .1, -.6, .32, 1.65, .5, mats.orange);\n      box(group, 0, 1.03, -.6, 2.3, .28, .55, mats.darkSteel);\n      box(group, 0, -.56, .99, 2.1, .07, .12, mats.glow, false);\n      panel(group, 'REFUEL +', 0, .97, -.26, 2.1, .55, { bg: '#173c3e', color: '#a8f7d7', border: '#4eac99' });\n      for (const x of [-.95, .95]) {\n        const lamp = ball(group, x, .55, -.25, .13, mats.glow, [1, 1, .7], false); pulses.push({ obj: lamp, base: 1, speed: 2 });\n      }\n      docks.push(group);\n    }\n\n    for (const h of level.hazards) {\n      const liquid = h.type === 'water';\n      const group = new THREE.Group(); group.position.set(h.x, h.y, 0); world.add(group);\n      box(group, 0, 0, -.25, h.w, h.h, 1.8, liquid ? mats.water : mats.hot, false);\n      const surface = box(group, 0, h.h / 2, .7, h.w, .1, .45, liquid ? mats.glow : mats.lamp, false);\n      pulses.push({ obj: surface, base: 1, speed: liquid ? 1 : 3, axis: 'y' });\n      for (let x = -h.w / 2 + .3; x < h.w / 2; x += .8) {\n        if (liquid) {\n          line(group, [[x, h.h / 2 - .24, 1], [x + .5, h.h / 2 - .24, 1]], 0x84d8e2);\n        } else {\n          const bubble = ball(group, x, h.h / 2, .6, .12 + rnd() * .15, mats.lamp, [1, .7, 1], false);\n          pulses.push({ obj: bubble, base: 1, speed: 3 + rnd() * 4 });\n        }\n      }\n      if (liquid) currents.push({ group, y: h.y });\n      if (!liquid) {\n        const l = new THREE.PointLight(0xff4e26, 9, Math.max(h.w, 5), 1.5); l.position.set(h.x, h.y + .7, 3); world.add(l);\n      }\n    }\n\n    // Small work lamps cast warm islands into the cold excavation.\n    for (let i = 0; i < 9; i++) {\n      const x = 3 + i * 6, y = i % 2 ? 19.5 : 27;\n      rod(world, [x, y + .8, -2.3], [x, y, -2.3], .035, mats.steel);\n      box(world, x, y, -2, .8, .16, .5, mats.darkSteel);\n      ball(world, x, y - .13, -1.85, .18, mats.lamp, [1.4, .4, 1], false);\n      // A translucent polygon rather than a foggy bloom keeps the printed-ink look.\n      const shape = new THREE.Shape(); shape.moveTo(-.2, 0); shape.lineTo(.2, 0); shape.lineTo(2, -5); shape.lineTo(-2, -5); shape.closePath();\n      const beam = new THREE.Mesh(new THREE.ShapeGeometry(shape), new THREE.MeshBasicMaterial({ color: 0xffe2a0, transparent: true, opacity: .035, depthWrite: false }));\n      beam.position.set(x, y - .1, -2.7); world.add(beam);\n    }\n\n    // Hoses, drills, reels, supply boxes: visual evidence of the interrupted shift.\n    for (const d of level.docks) {\n      box(world, d.x - 2, d.y - .25, -.5, .8, .9, .8, mats.orange);\n      box(world, d.x - 2, d.y + .23, -.5, .9, .12, .9, mats.steel);\n      rod(world, [d.x - 2, d.y - .1, .08], [d.x - 2, d.y + .1, .08], .13, mats.cream);\n      const hose = [];\n      for (let t = 0; t < 31; t++) { const a = t / 30 * Math.PI * 3; hose.push([d.x - 1.7 + Math.cos(a) * .45, d.y - .6 + Math.sin(a) * .2, .35]); }\n      line(world, hose, 0x9fb8a4);\n    }\n    const exit = new THREE.Group(); exit.position.set(level.exit.x, level.exit.y, 0); world.add(exit);\n    box(exit, 0, -.82, -.4, 3.4, .35, 2.5, mats.darkSteel);\n    for (const x of [-1.35, 1.35]) {\n      box(exit, x, .4, -.9, .3, 2.5, .6, mats.steel);\n      box(exit, x, .6, -.56, .08, 1.75, .1, mats.glow, false);\n\"\"\"Two-copy standalone transport and procedural audio checks for the bundled game.\"\"\"\nfrom urllib.parse import urljoin\n\nGAME_FILE = 'HERO-Blast-Shift-HERO-1984-gpt-6.1-sol-ultra-20261105-214551.html'\n\n\ndef run_transport_tests(browser, base_url):\n    results = []\n    context = browser.new_context(viewport={'width': 960, 'height': 540}, device_scale_factor=1)\n    pages = []\n\n    def record(name, check):\n        try:\n            detail = check()\n            results.append((name, True, detail or ''))\n        except Exception as exc:\n            results.append((name, False, str(exc)))\n\n    def require(condition, detail):\n        if not condition:\n            raise AssertionError(detail)\n\n    def boot():\n        for _ in range(2):\n            page = context.new_page()\n            pages.append(page)\n            page.goto(urljoin(base_url.rstrip('/') + '/', GAME_FILE), wait_until='domcontentloaded', timeout=120000)\n            page.wait_for_function('window.__gameReady === true', timeout=120000)\n            page.evaluate(\"window.__game.set('idle', -1000000000)\")\n            state = page.evaluate('window.__game.state')\n            require(state['ready'] and state['mode'] == 'title', f'Wrong initial game state: {state}')\n            require(not state['errors'], f'Boot errors: {state[\"errors\"]}')\n        return 'Two standalone bundled copies booted.'\n\n    record('transport: two complete copies boot', boot)\n    if len(pages) != 2 or not results[-1][1]:\n        context.close()\n        return results\n    first, second = pages\n\n    def local_pair():\n        for page in pages:\n            page.evaluate('''() => {\n              __game.start(); __game.loadLevel(1);\n              __game.set('health', 1); __game.set('fuel', 17);\n              __game.network.enableLocal();\n            }''')\n        for page in pages:\n            page.wait_for_function('__game.state.network.remoteCount === 1', timeout=15000)\n            state = page.evaluate('__game.state.network')\n            require(state['transport'] == 'BroadcastChannel', f'Wrong transport: {state}')\n        return 'BroadcastChannel discovered both copies.'\n\n    record('transport: local race discovery', local_pair)\n\n    def local_start():\n        first.evaluate('__game.network.startRace()')\n        for page in pages:\n            page.wait_for_function('__game.state.network.started && __game.state.sector === 0', timeout=15000)\n            state = page.evaluate('''() => ({...__game.state, countdown:__game.network.countdown})''')\n            require(state['mode'] == 'playing', f'Race did not start: {state[\"mode\"]}')\n            require(state['health'] == 3 and state['fuel'] > 99, f'Race did not reset equipment: {state}')\n            require(state['rescued'] == 0 and state['score'] == 0, f'Race did not reset progress: {state}')\n            require(not state['network']['canPlay'] and 0 < state['countdown'] <= 3100,\n                    f'Race missed synchronized countdown: {state[\"network\"]}, {state[\"countdown\"]}')\n        for page in pages:\n            page.wait_for_function('__game.state.network.canPlay && __game.state.menu === null', timeout=20000)\n        return 'Both players reset into the same three-second countdown.'\n\n    record('transport: synchronized local race', local_start)\n\n    def ghosts_move():\n        for page in pages:\n            page.wait_for_function('''Array.from(__game.network.remote.values()).some(r => r.state && r.seq > 0)''', timeout=20000)\n        first.evaluate('__game.teleport(9, 23)')\n        second.wait_for_function('''Array.from(__game.network.remote.values()).some(r => r.state && Math.abs(r.state.x - 9) < .25 && r.seq > 0)''', timeout=15000)\n        for page in pages:\n            state = page.evaluate('__game.state')\n            remote = page.evaluate('Array.from(__game.network.remote.values()).map(r => ({state:r.state,seq:r.seq}))')\n            require(state['network']['remoteCount'] == 1, f'Lost rival: {state[\"network\"]}')\n            require(any(r.get('state', {}).get('sector') == state['sector'] for r in remote), f'No same-sector rival: {remote}')\n            require('RIVAL' in page.locator('#ghosts').inner_text(), 'Rival HUD is missing.')\n            require(not state['errors'], f'Race runtime errors: {state[\"errors\"]}')\n        return 'Position packets reached the other complete game and rival HUD.'\n\n    record('transport: live ghost movement', ghosts_move)\n\n    def local_leave():\n        first.evaluate('__game.network.disconnect()')\n        second.wait_for_function('__game.state.network.remoteCount === 0', timeout=10000)\n        second.evaluate('__game.network.disconnect()')\n        for page in pages:\n            state = page.evaluate('__game.state.network')\n            require(state['transport'] == 'none' and state['remoteCount'] == 0, f'Disconnect failed: {state}')\n        return 'Leaving removes the rival and closes local channels.'\n\n    record('transport: local leave cleanup', local_leave)\n\n    def rtc_pair():\n        # Actual browser ICE, SDP, SCTP, and data channel: no transport mocks.\n        offer = first.evaluate('__game.network.createOffer()')\n        require(isinstance(offer, str) and len(offer) > 100, 'Missing host connection code.')\n        answer = second.evaluate('code => __game.network.acceptOffer(code)', offer)\n        require(isinstance(answer, str) and len(answer) > 100, 'Missing reply connection code.')\n        first.evaluate('code => __game.network.acceptAnswer(code)', answer)\n        for page in pages:\n            page.wait_for_function('__game.network.dataChannel?.readyState === \"open\" && __game.state.network.remoteCount === 1', timeout=30000)\n            require(page.evaluate('__game.state.network.transport') == 'WebRTC', 'Wrong direct transport.')\n        return 'Native WebRTC connection codes established a data channel.'\n\n    record('transport: direct WebRTC offer and reply', rtc_pair)\n\n    def rtc_race():\n        first.evaluate('__game.network.startRace()')\n        for page in pages:\n            page.wait_for_function('__game.state.network.started && __game.state.network.canPlay && __game.state.menu === null', timeout=20000)\n            page.wait_for_function('''__game.network.remote.get('peer')?.state && __game.network.remote.get('peer').seq > 0''', timeout=20000)\n        second.evaluate('__game.teleport(11, 22)')\n        first.wait_for_function('''Math.abs((__game.network.remote.get('peer')?.state?.x ?? -100) - 11) < .25''', timeout=15000)\n        for page in pages:\n            require(not page.evaluate('__game.state.errors'), 'Runtime error during direct race.')\n        return 'Peer race reset, countdown, and live ghost replication passed.'\n\n    if results[-1][1]:\n        record('transport: direct WebRTC race', rtc_race)\n\n    def audio():\n        first.evaluate('__game.network.disconnect()')\n        second.evaluate('__game.network.disconnect()')\n        before = first.evaluate('__game.sound.diagnostics()')\n        require(before['music'] == .10 and before['sfx'] == .65, f'Incorrect default volumes: {before}')\n        rendered = first.evaluate('__game.renderAudioTest()')\n        require(rendered['finite'], f'Non-finite audio: {rendered}')\n        require(rendered['samples'] == 264600, f'Offline duration differs: {rendered}')\n        require(.005 < rendered['rms'] < .5, f'Silent or excessive audio RMS: {rendered}')\n        require(.1 < rendered['peak'] < 1, f'Silent or clipping audio: {rendered}')\n        first.evaluate('''async () => {\n          await __game.sound.unlock();\n          __game.sound.update(.1, {flying:true,sector:2,danger:true});\n          __game.sound.play('rescue'); __game.sound.voice('win');\n        }''')\n        first.wait_for_function('__game.sound.diagnostics().musicSteps > 0', timeout=10000)\n        require(first.evaluate('__game.sound.diagnostics().unlocked'), 'Audio did not unlock.')\n        return f'6-second synthesis: {rendered[\"samples\"]} finite samples, peak {rendered[\"peak\"]:.3f}, RMS {rendered[\"rms\"]:.4f}.'\n\n    record('audio: procedural render and defaults', audio)\n    for page in pages:\n        try:\n            page.evaluate('__game.network.disconnect(); __game.sound.suspend(true)')\n        except Exception:\n            pass\n    context.close()\n    return results\n\"\"\"Official AI Hub conformance scenarios, consumed by the project's single test command.\"\"\"\nfrom urllib.parse import urlencode\n\nGAME_DIR = 'HERO-Blast-Shift-HERO-1984-gpt-6.1-sol-ultra-20261105-214551'\nGAME_FILE = GAME_DIR + '.html'\n\n\ndef run_hub_tests(browser, base_url, scenarios=None):\n    \"\"\"Return (cases, errors); never print routine status or leak pages/contexts.\"\"\"\n    cases, errors = [], []\n    scenarios = scenarios or [\n        ('AI Hub two-player ghost race', {'players': 2}),\n        ('AI Hub four-player adverse network', {'players': 4, 'latency': 150, 'jitter': 50, 'loss': 5}),\n        ('AI Hub host leaves ghost race', {'players': 4, 'latency': 150, 'jitter': 50, 'loss': 5, 'scenario': 'host-leave'}),\n    ]\n    for label, options in scenarios:\n        context = browser.new_context(viewport={'width': 1280, 'height': 720})\n        page = context.new_page()\n        page_errors = []\n        page.on('pageerror', lambda error, sink=page_errors: sink.append(getattr(error, 'stack', str(error))))\n        try:\n            query = urlencode({'game': '../' + GAME_FILE, 'auto': 1, **options})\n            url = base_url.rstrip('/') + '/' + GAME_DIR + '/harness.html?' + query\n            page.goto(url, wait_until='domcontentloaded', timeout=30000)\n            if page.title() != 'AI Hub · session harness':\n                # The title changed between protocol revisions; the harness object identifies the page.\n                page.wait_for_function('window.__hubCheck !== undefined', timeout=10000)\n            page.wait_for_function('document.body.dataset.complete === \"true\"', timeout=120000)\n            report = page.evaluate('window.__hubCheck')\n            failures = [check for check in report.get('checks', []) if not check.get('pass')]\n            if report.get('pass') and not page_errors:\n                cases.append(label)\n            else:\n                details = '; '.join(f\"{item['name']}: {item.get('detail', '')}\" for item in failures)\n                frames = page.evaluate('Array.from(document.querySelectorAll(\"iframe\"), f=>({src:f.src,ready:f.contentWindow?.__gameReady,state:f.contentWindow?.__game?.state,loading:f.contentDocument?.querySelector(\"#load-status\")?.textContent}))')\n                errors.append(f'{label}: {details or \"incomplete report\"}; frames={frames}' + (f'; errors: {page_errors}' if page_errors else ''))\n        except Exception as exc:\n            try:\n                state = page.evaluate('({report:window.__hubCheck,log:document.querySelector(\"#log\")?.textContent})')\n            except Exception:\n                state = 'unavailable'\n            errors.append(f'{label}: {exc}; state={state}')\n        finally:\n            context.close()\n    return cases, errors\n\n\nif __name__ == '__main__':\n    import sys\n    from playwright.sync_api import sync_playwright\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(headless=True, args=[\n            '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader',\n        ])\n        cases, errors = run_hub_tests(browser, sys.argv[1] if len(sys.argv) > 1 else 'http://127.0.0.1:38507')\n        browser.close()\n    for error in errors:\n        print('FAIL:', error)\n    print(f'{len(cases)} hub scenarios passed; {len(errors)} failures')\n    raise SystemExit(bool(errors))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read()\ns=s.replace(\\\"const inside=Math.abs(p.x-h.x)<h.w/2+.2&&p.y<h.y+h.h/2+.45&&p.y>h.y-h.h/2-.7;\\\", \\\"const inside=Math.abs(p.x-h.x)<h.w/2+.2&&p.y<(h.type==='vent'?h.y+2.5:h.y+h.h/2+.45)&&p.y>h.y-h.h/2-.7;\\\")\ns=s.replace(\\\"art.update(dt,time);titlePilot\\\", \\\"art.update(dt,time,stageTimer);titlePilot\\\")\ns=s.replace(\\\"if(Math.hypot(dz(a[2]),dz(a[3]))>.25){const l=Math.hypot(a[2],a[3]);aim={x:a[2]/l,y:-a[3]/l};}\\\", \\\"if(Math.hypot(dz(a[2]),dz(a[3]))>.25){const l=Math.hypot(a[2],a[3]);aim={x:a[2]/l,y:-a[3]/l};}else aim={x:facing,y:0};\\\")\ns=s.replace(\\\"document.addEventListener('click',e=>\\\", \\\"document.addEventListener('pointerdown',e=>{if(e.target\"'!==canvas)noteInput(e.pointerType==='\"'touch'?'touch':'keyboard');});\\\\ndocument.addEventListener('click',e=>\\\")\n# Use a test-only deterministic clock while retaining the same physics and interactions.\ns=s.replace(\\\"let testErrors=[],ready=false\\\", \\\"let manualClock=false,testErrors=[],ready=false\\\")\ns=s.replace(\\\"if((mode==='playing'||mode==='attract')&&(\"'!menu||network.active||mode==='\"'attract'))\\\", \\\"if(\"'!manualClock&&(mode==='\"'playing'||mode==='attract')&&(\"'!menu||network.active||mode==='\"'attract'))\\\")\ns=s.replace(\\\"if(key==='fuel')fuel=value;\\\", \\\"if(key==='manualClock')manualClock=value;if(key==='fuel')fuel=value;\\\")\n# Retire the completed demo counters on each new attract loop.\ns=s.replace(\\\"if(t>35){loadLevel((sector+1)%3);return;}\\\", \\\"if(t>35){if(sector===2){rescued=0;score=0;}loadLevel((sector+1)%3);return;}\\\")\nopen(p,'w').write(s)\np='journey.py';s=open(p).read().replace('go(17,25);go(16,3);','go(18,25);go(16.8,3);');open(p,'w').write(s)\nPY\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python journey.py\"","aggregated_output":"","exit_code":null,"status":"in_pro