{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > test.py <<'EOF'\n\\\"\\\"\\\"One command: npm test --silent. Only failures and the final count are printed.\\\"\\\"\\\"\nfrom pathlib import Path\nfrom functools import partial\nimport http.server\nimport importlib.util\nimport json\nimport subprocess\nimport threading\nfrom playwright.sync_api import sync_playwright\nfrom transport_tests import run_transport_tests\n\nROOT=Path(__file__).resolve().parent\nGAME='HERO-Blast-Shift-HERO-1984-gpt-6.1-sol-ultra-20261105-214551.html'\nRESULTS=[]\n\ndef require(condition, message='Assertion failed'):\n    if not condition:\n        raise AssertionError(message)\n\ndef case(name, fn):\n    try:\n        fn()\n        RESULTS.append((name,True,''))\n    except Exception as exc:\n        RESULTS.append((name,False,str(exc)))\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef run_core(browser,base_url):\n    context=browser.new_context(viewport={'width':1600,'height':900},device_scale_factor=1)\n    context.add_init_script('''\n      window.testPad={id:'DualSense test',index:0,connected:false,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};\n      navigator.getGamepads=()=>[window.testPad];\n    ''')\n    page=context.new_page()\n    page_errors=[]\n    page.on('pageerror',lambda e:page_errors.append(str(e)))\n    def state():\n        return page.evaluate('__game.state')\n    def js(code):\n        return page.evaluate(code)\n    def boot():\n        page.goto((ROOT.parent/GAME).as_uri(),wait_until='domcontentloaded')\n        page.wait_for_function('__gameReady === true',timeout=120000)\n        require(page.title()=='H.E.R.O. Blast Shift','Wrong page served')\n        s=state()\n        require(s['mode']=='title' and s['ready'],'No title screen')\n        require(s['renderer']=='WebGPU','Primary renderer is not WebGPU')\n        require(s['settings']['music']==10 and s['audio']['music']==.1,'Music must default to 10%')\n        js(\\\"__game.set('manualClock',true);__game.set('idle',-1000000000)\\\")\n    case('single embedded file boots with native WebGPU over file://',boot)\n    if not page.evaluate('window.__gameReady || false'):\n        context.close();return\n\n    def menu_controls():\n        js(\\\"testPad.connected=true;testPad.buttons[13].pressed=true;__game.poll()\\\")\n        require(page.locator(':focus').inner_text()=='Race a friend','D-pad focus did not move')\n        js(\\\"testPad.buttons[13].pressed=false;__game.poll()\\\")\n        # Keyboard native activation must occur exactly once, including toggle buttons.\n        page.locator('[data-action=settings]').click()\n        page.locator('#glyph-toggle').focus()\n        page.keyboard.press('Enter')\n        require(page.locator('#glyph-toggle').inner_text()=='Xbox','Keyboard Enter toggled twice')\n        js(\\\"testPad.buttons[0].pressed=true;__game.poll()\\\")\n        js(\\\"testPad.buttons[0].pressed=false;testPad.connected=false;__game.poll();__game.action('back')\\\")\n        require(state()['mode']=='title','Back did not restore title')\n    case('keyboard activation and controller menu focus',menu_controls)\n\n    def keyboard_motion():\n        page.locator('#title [data-action=start]').click()\n        js('__game.tick(.6)')\n        start=state()\n        require(start['grounded'],'Spawn did not land on the platform')\n        page.keyboard.down('KeyD');page.keyboard.down('Space')\n        js('__game.poll();__game.tick(.6)')\n        end=state()\n        page.keyboard.up('KeyD');page.keyboard.up('Space')\n        js('__game.poll()')\n        require(end['position']['x']>start['position']['x']+1.5,'Keyboard horizontal movement failed')\n        require(end['position']['y']>start['position']['y']+.5,'Jetpack failed to lift')\n        require(end['fuel']<start['fuel'],'Flight did not consume fuel')\n    case('native keyboard flight and rotor power',keyboard_motion)\n\n    def pause_dev():\n        js('__game.pause()');before=state()['elapsed'];js('__game.tick(1)')\n        require(state()['elapsed']==before,'Paused solo game kept simulating')\n        page.locator('#pause [data-action=dev]').click()\n        page.locator('#dev-flightSpeed').fill('9')\n        page.locator('#dev-flightSpeed').dispatch_event('input')\n        require(state()['tuning']['flightSpeed']==9 and state()['training'],'Live tuning did not apply')\n        page.locator('#god-toggle').click();require(state()['god'],'Invulnerability toggle failed')\n        page.locator('[data-action=defaults]').click()\n        require(state()['tuning']['flightSpeed']==6.8 and not state()['god'],'Defaults did not restore')\n        page.locator('#dev [data-action=back]').click()\n        page.locator('#pause [data-action=resume]').click()\n        require(state()['menu'] is None,'Resume failed')\n    case('pause, live dev sliders, toggles and reset',pause_dev)\n\n    def pad_gameplay():\n        js(\\\"__game.start();__game.tick(.6);testPad.connected=true;testPad.axes=[.8,-.9,1,0];testPad.buttons[7].pressed=true;__game.poll();__game.tick(.7)\\\")\n        s=state()\n        require(s['position']['x']>6,'Left stick did not move')\n        require(s['flying'] and s['fuel']<100,'Left-stick flight failed')\n        require(s['statistics']['shots']>0,'R2 did not fire')\n        js(\\\"testPad.axes=[0,0,0,0];testPad.buttons[7].pressed=false;testPad.connected=false;__game.poll()\\\")\n        require('RT' in page.locator('#controls').inner_text(),'Xbox glyph setting did not update pad prompts')\n    case('standard-mapping controller flight, laser and glyphs',pad_gameplay)\n\n    def collisions_fuel():\n        js(\\\"__game.start();__game.teleport(17,8);__game.set('fuel',0);__game.setInput({move:0,fly:1,fire:false});__game.tick(.2)\\\")\n        s=state();require(s['position']['y']<8 and not s['flying'],'Empty pack still flew')\n        js('__game.setInput({move:0,fly:0,fire:false});__game.tick(2)')\n        s=state();require(1.5<s['position']['y']<2,'Rapier floor collision failed')\n        require(s['grounded'] and s['fuel']>0,'Ground recharge failed')\n        js('__game.teleport(4,25);__game.tick(1)')\n        require(24.4<state()['position']['y']<24.9,'Upper platform collision failed')\n    case('Rapier collision, gravity, empty pack and ground recharge',collisions_fuel)\n\n    def laser():\n        js('__game.start();__game.tick(2)')\n        result=js('''() => {\n          const e=__game.state.enemies[0];__game.teleport(e.x-3,e.y-.25);__game.setAim(1,0);__game.shoot();\n          return __game.state;\n        }''')\n        require(not result['enemies'][0]['alive'],'Laser did not hit bat')\n        require(not any(b['broken'] for b in result['barriers']),'Laser broke a bomb-only bulkhead')\n    case('laser creature hit and bulkhead protection',laser)\n\n    def charge():\n        js(\\\"__game.start();__game.teleport(16.2,2.2);__game.tick(.1);__game.charge();__game.teleport(19,6);__game.setInput({move:0,fly:0,fire:false});__game.tick(1.6)\\\")\n        s=state();require(s['barriers'][0]['broken'],'Timed charge did not destroy the nearby wall')\n        require(not s['barriers'][1]['broken'],'Distant wall incorrectly broke')\n        require(s['bombs']==0 and s['charges']==2,'Fuse or inventory is wrong')\n    case('timed charge, collision filtering and localized destruction',charge)\n\n    def miner_and_checkpoint():\n        js('__game.teleport(7,2.1);__game.tick(.1)')\n        s=state();require(s['rescued']==1 and s['miners'][0]['rescued'],'Proximity rescue failed')\n        before=s['score'];js('__game.tick(.4)');require(state()['score']==before,'Rescue scored twice')\n        js(\\\"__game.set('health',1);__game.set('fuel',10);__game.set('charges',0);__game.teleport(33,15);__game.tick(3.2)\\\")\n        s=state();require(s['health']==3 and s['fuel']>99 and s['charges']==3,'Service pad did not refill')\n        js(\\\"__game.set('health',1);__game.tick(2);__game.hurt(1)\\\")\n        s=state();require(s['lives']==2 and s['health']==3,'Replacement suit failed')\n        require(abs(s['position']['x']-33)<.1,'Replacement did not use service checkpoint')\n    case('rescue once, service pad refill and replacement checkpoint',miner_and_checkpoint)\n\n    def hazards():\n        js(\\\"__game.start();__game.tick(2);__game.teleport(28,1.8);__game.tick(.1)\\\")\n        require(state()['health']<3,'Lava did not hurt')\n        js('__game.loadLevel(1);__game.tick(1.6);__game.teleport(38,15.5);__game.tick(.1)')\n        require(state()['health']<3,'Hot steam did not hurt')\n        js('__game.loadLevel(1);__game.tick(4);__game.teleport(38,15.5);__game.tick(.05)')\n        require(state()['health']==3,'Blue safe vent caused damage')\n        js(\\\"__game.loadLevel(2);__game.tick(2);__game.set('fuel',50);__game.teleport(29,2.3);__game.tick(.3)\\\")\n        require(state()['fuel']<50,'Floodwater did not drain rotor power')\n    case('lava, hot/safe steam cycle and floodwater',hazards)\n\n    def scanner_collectibles():\n        js('__game.start();__game.scan();__game.teleport(17,9);__game.tick(.1)')\n        require(state()['statistics']['crystals']>0,'Crystal collection failed')\n        require(not page.locator('#map-wrap').evaluate('(el)=>el.classList.contains(\\\"hidden\\\")'),'Scanner did not display')\n    case('scanner and crystal collection',scanner_collectibles)\n\n    # This AI drives the same flight/laser/charge inputs as a player, without\n    # teleportation, extra health, free fuel, wall bypasses, or direct rescue calls.\n    route_js='''() => {\n      const g=__game,logs=[];\n      function go(x,y,seconds=10){\n        let reached=false;\n        for(let i=0;i<seconds*60;i++){\n          const s=g.state,dx=x-s.position.x,dy=y-s.position.y;\n          if(s.mode\"'!=='\"'playing'||s.stageChanging){reached=true;break;}\n          if(Math.abs(dx)<.34&&Math.abs(dy)<.5){reached=true;g.setInput({move:0,fly:0,fire:false});break;}\n          const targetVy=Math.max(-6,Math.min(5,dy*3));\n          g.setInput({move:Math.max(-1,Math.min(1,dx*2)),fly:dy>-.2&&s.velocity.y<targetVy+.15?1:0,fire:true});\n          const targets=s.enemies.filter(e=>e.alive).sort((a,b)=>Math.hypot(a.x-s.position.x,a.y-s.position.y)-Math.hypot(b.x-s.position.x,b.y-s.position.y));\n          if(targets.length){const e=targets[0];g.setAim(e.x-s.position.x,e.y-s.position.y);}\n          g.tick(1/60);\n        }\n        logs.push({target:[x,y],reached,position:g.state.position,fuel:g.state.fuel,mode:g.state.mode});\n      }\n      const sector=g.state.sector;\n      go(18,25);go(sector===1?17:16.2,2.2);g.charge();go(19,6,2);g.setInput({move:0,fly:0,fire:false});g.tick(1);\n      go(sector===0?7:6,2.1);go(16.5,3);go(16.5,15.5);go(25,14.7);g.setInput({move:0,fly:0,fire:false});g.tick(2);\n      go(40.5,17.7);g.charge();go(36,18,2);g.setInput({move:0,fly:0,fire:false});g.tick(1);\n      go(49,15);go(37,18);go(37,25.5);go(50,25.5);\n      g.setInput({move:0,fly:0,fire:false});\n      return {logs,state:g.state};\n    }'''\n    def campaign():\n        js('__game.start()')\n        for i in range(3):\n            result=js(route_js)\n            missed=[r for r in result['logs'] if not r['reached']]\n            require(not missed,f'Sector {i+1} AI route blocked: {missed}; rescued={result[\\\"state\\\"][\\\"rescued\\\"]}')\n            require(result['state']['rescued']==(i+1)*2,f'Sector {i+1} rescue count incorrect')\n            require(all(b['broken'] for b in result['state']['barriers']),f'Sector {i+1} bulkhead remained')\n            if i<2:\n                page.wait_for_function(f'__game.state.sector === {i+1} && \"'!__game.state.stageChanging'\"',timeout=10000)\n        s=state();require(s['mode']=='result' and s['rescued']==6,'Campaign did not reach victory')\n        require(s['statistics']['blasts']>=6 and s['statistics']['shots']>0,'Playthrough skipped core tools')\n        require(not s['training'] and s['lives']>0,'Playthrough used cheats or died')\n    case('full three-sector physical-input AI playthrough without cheats',campaign)\n\n    def lose_restart():\n        js(\\\"__game.start();__game.set('lives',1);__game.set('health',1);__game.tick(2);__game.hurt(1)\\\")\n        require(state()['mode']=='result' and state()['lives']==0,'Game-over flow failed')\n        page.locator('#result [data-action=start]').click()\n        require(state()['mode']=='playing' and state()['lives']==3 and state()['rescued']==0,'Restart failed')\n    case('game over and fresh campaign restart',lose_restart)\n\n    def attract():\n        js(\\\"__game.title();__game.set('manualClock',false);__game.set('idle',11000)\\\")\n        page.wait_for_function('__game.state.mode === \\\"attract\\\"',timeout=10000)\n        js(\\\"__game.set('manualClock',true);__game.tick(32)\\\")\n        s=state();require(s['rescued']>=2 and s['statistics']['blasts']>=2,'Attract did not demonstrate rescues and charges')\n        page.keyboard.press('Enter')\n        require(state()['mode']=='title','Input did not exit attract mode')\n    case('10-second attract replay, mechanics and input exit',attract)\n\n    def runtime():\n        require(not state()['errors'],f'Runtime errors: {state()[\\\"errors\\\"]}')\n        require(not page_errors,f'Browser errors: {page_errors}')\n        require(page.evaluate('__game.sceneStats.meshes')>500,'Detailed 3D scene is missing')\n    case('no uncaught runtime errors and detailed scene',runtime)\n    context.close()\n\n\ndef run_touch(browser,base_url):\n    context=browser.new_context(viewport={'width':844,'height':390},is_mobile=True,has_touch=True,device_scale_factor=1)\n    page=context.new_page()\n    def touch_controls():\n        page.goto(base_url+'/'+GAME,wait_until='domcontentloaded')\n        page.wait_for_function('__gameReady',timeout=120000)\n        page.locator('#title [data-action=start]').tap()\n        page.evaluate(\\\"__game.set('manualClock',true);__game.tick(.6)\\\")\n        before=page.evaluate('__game.state.position')\n        page.dispatch_event('#game','pointerdown',{'pointerType':'touch','pointerId':91,'clientX':140,'clientY':280,'bubbles':True})\n        page.dispatch_event('#game','pointermove',{'pointerType':'touch','pointerId':91,'clientX':195,'clientY':215,'bubbles':True})\n        page.dispatch_event('#game','pointerdown',{'pointerType':'touch','pointerId':92,'clientX':660,'clientY':180,'bubbles':True})\n        page.evaluate('__game.poll();__game.tick(.7)')\n        s=page.evaluate('__game.state')\n        require(s['position']['x']>before['x']+1 and s['flying'],'Invisible touch stick failed')\n        require(s['statistics']['shots']>0,'Multitouch laser failed')\n        page.dispatch_event('#game','pointerup',{'pointerType':'touch','pointerId':91,'button':0,'bubbles':True})\n        page.dispatch_event('#game','pointerup',{'pointerType':'touch','pointerId':92,'button':0,'bubbles':True})\n        page.locator('#touch-menu').tap()\n        require(page.evaluate('__game.state.menu')=='pause','Touch menu failed')\n        require(not page.evaluate('__game.state.errors'),'Touch runtime errors')\n    case('mobile multitouch flight, assisted firing and menu',touch_controls)\n    context.close()\n\n\ndef main():\n    build=subprocess.run(['node','build.mjs'],cwd=ROOT,capture_output=True,text=True)\n    if build.returncode:\n        RESULTS.append(('build',False,build.stderr));return\n    case('exit interview JSON shape and embedded credits',lambda:require(all(k in json.loads((ROOT.parent/'exit-interview.json').read_text()) for k in ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'])))\n    handler=partial(QuietHandler,directory=str(ROOT.parent))\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    base_url=f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as p:\n            browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n            run_core(browser,base_url)\n            run_touch(browser,base_url)\n            RESULTS.extend(run_transport_tests(browser,base_url))\n            spec=importlib.util.spec_from_file_location('hub_tests',ROOT/'hub-tests.py')\n            hub=importlib.util.module_from_spec(spec);spec.loader.exec_module(hub)\n            cases,errors=hub.run_hub_tests(browser,base_url)\n            RESULTS.extend((name,True,'') for name in cases)\n            RESULTS.extend(('official AI Hub conformance',False,error) for error in errors)\n            browser.close()\n    finally:\n        server.shutdown();server.server_close()\n\nif __name__=='__main__':\n    try:\n        main()\n    except Exception as error:\n        RESULTS.append(('test runner',False,str(error)))\n    failed=[r for r in RESULTS if not r[1]]\n    for name,_,detail in failed:\n        print(f'FAIL: {name}: {detail}')\n    print(f'{len(RESULTS)-len(failed)}/{len(RESULTS)} checks passed; {len(failed)} failures')\n    (ROOT/'test-results.json').write_text(json.dumps([{'name':n,'passed':p,'detail':d} for n,p,d in RESULTS],indent=2))\n    raise SystemExit(bool(failed))\nEOF\npython3 - <<'PY'\np='main.js';s=open(p).read().replace('stageTimer,score,rescued,health','stageTimer,stageChanging,score,rescued,health');open(p,'w').write(s)\nPY\nnpm test --silent\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > test.py <<'EOF'\n\\\"\\\"\\\"One command: npm test --silent. Only failures and the final count are printed.\\\"\\\"\\\"\nfrom pathlib import Path\nfrom functools import partial\nimport http.server\nimport importlib.util\nimport json\nimport subprocess\nimport threading\nfrom playwright.sync_api import sync_playwright\nfrom transport_tests import run_transport_tests\n\nROOT=Path(__file__).resolve().parent\nGAME='HERO-Blast-Shift-HERO-1984-gpt-6.1-sol-ultra-20261105-214551.html'\nRESULTS=[]\n\ndef require(condition, message='Assertion failed'):\n    if not condition:\n        raise AssertionError(message)\n\ndef case(name, fn):\n    try:\n        fn()\n        RESULTS.append((name,True,''))\n    except Exception as exc:\n        RESULTS.append((name,False,str(exc)))\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef run_core(browser,base_url):\n    context=browser.new_context(viewport={'width':1600,'height':900},device_scale_factor=1)\n    context.add_init_script('''\n      window.testPad={id:'DualSense test',index:0,connected:false,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};\n      navigator.getGamepads=()=>[window.testPad];\n    ''')\n    page=context.new_page()\n    page_errors=[]\n    page.on('pageerror',lambda e:page_errors.append(str(e)))\n    def state():\n        return page.evaluate('__game.state')\n    def js(code):\n        return page.evaluate(code)\n    def boot():\n        page.goto((ROOT.parent/GAME).as_uri(),wait_until='domcontentloaded')\n        page.wait_for_function('__gameReady === true',timeout=120000)\n        require(page.title()=='H.E.R.O. Blast Shift','Wrong page served')\n        s=state()\n        require(s['mode']=='title' and s['ready'],'No title screen')\n        require(s['renderer']=='WebGPU','Primary renderer is not WebGPU')\n        require(s['settings']['music']==10 and s['audio']['music']==.1,'Music must default to 10%')\n        js(\\\"__game.set('manualClock',true);__game.set('idle',-1000000000)\\\")\n    case('single embedded file boots with native WebGPU over file://',boot)\n    if not page.evaluate('window.__gameReady || false'):\n        context.close();return\n\n    def menu_controls():\n        js(\\\"testPad.connected=true;testPad.buttons[13].pressed=true;__game.poll()\\\")\n        require(page.locator(':focus').inner_text()=='Race a friend','D-pad focus did not move')\n        js(\\\"testPad.buttons[13].pressed=false;__game.poll()\\\")\n        # Keyboard native activation must occur exactly once, including toggle buttons.\n        page.locator('[data-action=settings]').click()\n        page.locator('#glyph-toggle').focus()\n        page.keyboard.press('Enter')\n        require(page.locator('#glyph-toggle').inner_text()=='Xbox','Keyboard Enter toggled twice')\n        js(\\\"testPad.buttons[0].pressed=true;__game.poll()\\\")\n        js(\\\"testPad.buttons[0].pressed=false;testPad.connected=false;__game.poll();__game.action('back')\\\")\n        require(state()['mode']=='title','Back did not restore title')\n    case('keyboard activation and controller menu focus',menu_controls)\n\n    def keyboard_motion():\n        page.locator('#title [data-action=start]').click()\n        js('__game.tick(.6)')\n        start=state()\n        require(start['grounded'],'Spawn did not land on the platform')\n        page.keyboard.down('KeyD');page.keyboard.down('Space')\n        js('__game.poll();__game.tick(.6)')\n        end=state()\n        page.keyboard.up('KeyD');page.keyboard.up('Space')\n        js('__game.poll()')\n        require(end['position']['x']>start['position']['x']+1.5,'Keyboard horizontal movement failed')\n        require(end['position']['y']>start['position']['y']+.5,'Jetpack failed to lift')\n        require(end['fuel']<start['fuel'],'Flight did not consume fuel')\n    case('native keyboard flight and rotor power',keyboard_motion)\n\n    def pause_dev():\n        js('__game.pause()');before=state()['elapsed'];js('__game.tick(1)')\n        require(state()['elapsed']==before,'Paused solo game kept simulating')\n        page.locator('#pause [data-action=dev]').click()\n        page.locator('#dev-flightSpeed').fill('9')\n        page.locator('#dev-flightSpeed').dispatch_event('input')\n        require(state()['tuning']['flightSpeed']==9 and state()['training'],'Live tuning did not apply')\n        page.locator('#god-toggle').click();require(state()['god'],'Invulnerability toggle failed')\n        page.locator('[data-action=defaults]').click()\n        require(state()['tuning']['flightSpeed']==6.8 and not state()['god'],'Defaults did not restore')\n        page.locator('#dev [data-action=back]').click()\n        page.locator('#pause [data-action=resume]').click()\n        require(state()['menu'] is None,'Resume failed')\n    case('pause, live dev sliders, toggles and reset',pause_dev)\n\n    def pad_gameplay():\n        js(\\\"__game.start();__game.tick(.6);testPad.connected=true;testPad.axes=[.8,-.9,1,0];testPad.buttons[7].pressed=true;__game.poll();__game.tick(.7)\\\")\n        s=state()\n        require(s['position']['x']>6,'Left stick did not move')\n        require(s['flying'] and s['fuel']<100,'Left-stick flight failed')\n        require(s['statistics']['shots']>0,'R2 did not fire')\n        js(\\\"testPad.axes=[0,0,0,0];testPad.buttons[7].pressed=false;testPad.connected=false;__game.poll()\\\")\n        require('RT' in page.locator('#controls').inner_text(),'Xbox glyph setting did not update pad prompts')\n    case('standard-mapping controller flight, laser and glyphs',pad_gameplay)\n\n    def collisions_fuel():\n        js(\\\"__game.start();__game.teleport(17,8);__game.set('fuel',0);__game.setInput({move:0,fly:1,fire:false});__game.tick(.2)\\\")\n        s=state();require(s['position']['y']<8 and not s['flying'],'Empty pack still flew')\n        js('__game.setInput({move:0,fly:0,fire:false});__game.tick(2)')\n        s=state();require(1.5<s['position']['y']<2,'Rapier floor collision failed')\n        require(s['grounded'] and s['fuel']>0,'Ground recharge failed')\n        js('__game.teleport(4,25);__game.tick(1)')\n        require(24.4<state()['position']['y']<24.9,'Upper platform collision failed')\n    case('Rapier collision, gravity, empty pack and ground recharge',collisions_fuel)\n\n    def laser():\n        js('__game.start();__game.tick(2)')\n        result=js('''() => {\n          const e=__game.state.enemies[0];__game.teleport(e.x-3,e.y-.25);__game.setAim(1,0);__game.shoot();\n          return __game.state;\n        }''')\n        require(not result['enemies'][0]['alive'],'Laser did not hit bat')\n        require(not any(b['broken'] for b in result['barriers']),'Laser broke a bomb-only bulkhead')\n    case('laser creature hit and bulkhead protection',laser)\n\n    def charge():\n        js(\\\"__game.start();__game.teleport(16.2,2.2);__game.tick(.1);__game.charge();__game.teleport(19,6);__game.setInput({move:0,fly:0,fire:false});__game.tick(1.6)\\\")\n        s=state();require(s['barriers'][0]['broken'],'Timed charge did not destroy the nearby wall')\n        require(not s['barriers'][1]['broken'],'Distant wall incorrectly broke')\n        require(s['bombs']==0 and s['charges']==2,'Fuse or inventory is wrong')\n    case('timed charge, collision filtering and localized destruction',charge)\n\n    def miner_and_checkpoint():\n        js('__game.teleport(7,2.1);__game.tick(.1)')\n        s=state();require(s['rescued']==1 and s['miners'][0]['rescued'],'Proximity rescue failed')\n        before=s['score'];js('__game.tick(.4)');require(state()['score']==before,'Rescue scored twice')\n        js(\\\"__game.set('health',1);__game.set('fuel',10);__game.set('charges',0);__game.teleport(33,15);__game.tick(3.2)\\\")\n        s=state();require(s['health']==3 and s['fuel']>99 and s['charges']==3,'Service pad did not refill')\n        js(\\\"__game.set('health',1);__game.tick(2);__game.hurt(1)\\\")\n        s=state();require(s['lives']==2 and s['health']==3,'Replacement suit failed')\n        require(abs(s['position']['x']-33)<.1,'Replacement did not use service checkpoint')\n    case('rescue once, service pad refill and replacement checkpoint',miner_and_checkpoint)\n\n    def hazards():\n        js(\\\"__game.start();__game.tick(2);__game.teleport(28,1.8);__game.tick(.1)\\\")\n        require(state()['health']<3,'Lava did not hurt')\n        js('__game.loadLevel(1);__game.tick(1.6);__game.teleport(38,15.5);__game.tick(.1)')\n        require(state()['health']<3,'Hot steam did not hurt')\n        js('__game.loadLevel(1);__game.tick(4);__game.teleport(38,15.5);__game.tick(.05)')\n        require(state()['health']==3,'Blue safe vent caused damage')\n        js(\\\"__game.loadLevel(2);__game.tick(2);__game.set('fuel',50);__game.teleport(29,2.3);__game.tick(.3)\\\")\n        require(state()['fuel']<50,'Floodwater did not drain rotor power')\n    case('lava, hot/safe steam cycle and floodwater',hazards)\n\n    def scanner_collectibles():\n        js('__game.start();__game.scan();__game.teleport(17,9);__game.tick(.1)')\n        require(state()['statistics']['crystals']>0,'Crystal collection failed')\n        require(not page.locator('#map-wrap').evaluate('(el)=>el.classList.contains(\\\"hidden\\\")'),'Scanner did not display')\n    case('scanner and crystal collection',scanner_collectibles)\n\n    # This AI drives the same flight/laser/charge inputs as a player, without\n    # teleportation, extra health, free fuel, wall bypasses, or direct rescue calls.\n    route_js='''() => {\n      const g=__game,logs=[];\n      function go(x,y,seconds=10){\n        let reached=false;\n        for(let i=0;i<seconds*60;i++){\n          const s=g.state,dx=x-s.position.x,dy=y-s.position.y;\n          if(s.mode\"'!=='\"'playing'||s.stageChanging){reached=true;break;}\n          if(Math.abs(dx)<.34&&Math.abs(dy)<.5){reached=true;g.setInput({move:0,fly:0,fire:false});break;}\n          const targetVy=Math.max(-6,Math.min(5,dy*3));\n          g.setInput({move:Math.max(-1,Math.min(1,dx*2)),fly:dy>-.2&&s.velocity.y<targetVy+.15?1:0,fire:true});\n          const targets=s.enemies.filter(e=>e.alive).sort((a,b)=>Math.hypot(a.x-s.position.x,a.y-s.position.y)-Math.hypot(b.x-s.position.x,b.y-s.position.y));\n          if(targets.length){const e=targets[0];g.setAim(e.x-s.position.x,e.y-s.position.y);}\n          g.tick(1/60);\n        }\n        logs.push({target:[x,y],reached,position:g.state.position,fuel:g.state.fuel,mode:g.state.mode});\n      }\n      const sector=g.state.sector;\n      go(18,25);go(sector===1?17:16.2,2.2);g.charge();go(19,6,2);g.setInput({move:0,fly:0,fire:false});g.tick(1);\n      go(sector===0?7:6,2.1);go(16.5,3);go(16.5,15.5);go(25,14.7);g.setInput({move:0,fly:0,fire:false});g.tick(2);\n      go(40.5,17.7);g.charge();go(36,18,2);g.setInput({move:0,fly:0,fire:false});g.tick(1);\n      go(49,15);go(37,18);go(37,25.5);go(50,25.5);\n      g.setInput({move:0,fly:0,fire:false});\n      return {logs,state:g.state};\n    }'''\n    def campaign():\n        js('__game.start()')\n        for i in range(3):\n            result=js(route_js)\n            missed=[r for r in result['logs'] if not r['reached']]\n            require(not missed,f'Sector {i+1} AI route blocked: {missed}; rescued={result[\\\"state\\\"][\\\"rescued\\\"]}')\n            require(result['state']['rescued']==(i+1)*2,f'Sector {i+1} rescue count incorrect')\n            require(all(b['broken'] for b in result['state']['barriers']),f'Sector {i+1} bulkhead remained')\n            if i<2:\n                page.wait_for_function(f'__game.state.sector === {i+1} && \"'!__game.state.stageChanging'\"',timeout=10000)\n        s=state();require(s['mode']=='result' and s['rescued']==6,'Campaign did not reach victory')\n        require(s['statistics']['blasts']>=6 and s['statistics']['shots']>0,'Playthrough skipped core tools')\n        require(not s['training'] and s['lives']>0,'Playthrough used cheats or died')\n    case('full three-sector physical-input AI playthrough without cheats',campaign)\n\n    def lose_restart():\n        js(\\\"__game.start();__game.set('lives',1);__game.set('health',1);__game.tick(2);__game.hurt(1)\\\")\n        require(state()['mode']=='result' and state()['lives']==0,'Game-over flow failed')\n        page.locator('#result [data-action=start]').click()\n        require(state()['mode']=='playing' and state()['lives']==3 and state()['rescued']==0,'Restart failed')\n    case('game over and fresh campaign restart',lose_restart)\n\n    def attract():\n        js(\\\"__game.title();__game.set('manualClock',false);__game.set('idle',11000)\\\")\n        page.wait_for_function('__game.state.mode === \\\"attract\\\"',timeout=10000)\n        js(\\\"__game.set('manualClock',true);__game.tick(32)\\\")\n        s=state();require(s['rescued']>=2 and s['statistics']['blasts']>=2,'Attract did not demonstrate rescues and charges')\n        page.keyboard.press('Enter')\n        require(state()['mode']=='title','Input did not exit attract mode')\n    case('10-second attract replay, mechanics and input exit',attract)\n\n    def runtime():\n        require(not state()['errors'],f'Runtime errors: {state()[\\\"errors\\\"]}')\n        require(not page_errors,f'Browser errors: {page_errors}')\n        require(page.evaluate('__game.sceneStats.meshes')>500,'Detailed 3D scene is missing')\n    case('no uncaught runtime errors and detailed scene',runtime)\n    context.close()\n\n\ndef run_touch(browser,base_url):\n    context=browser.new_context(viewport={'width':844,'height':390},is_mobile=True,has_touch=True,device_scale_factor=1)\n    page=context.new_page()\n    def touch_controls():\n        page.goto(base_url+'/'+GAME,wait_until='domcontentloaded')\n        page.wait_for_function('__gameReady',timeout=120000)\n        page.locator('#title [data-action=start]').tap()\n        page.evaluate(\\\"__game.set('manualClock',true);__game.tick(.6)\\\")\n        before=page.evaluate('__game.state.position')\n        page.dispatch_event('#game','pointerdown',{'pointerType':'touch','pointerId':91,'clientX':140,'clientY':280,'bubbles':True})\n        page.dispatch_event('#game','pointermove',{'pointerType':'touch','pointerId':91,'clientX':195,'clientY':215,'bubbles':True})\n        page.dispatch_event('#game','pointerdown',{'pointerType':'touch','pointerId':92,'clientX':660,'clientY':180,'bubbles':True})\n        page.evaluate('__game.poll();__game.tick(.7)')\n        s=page.evaluate('__game.state')\n        require(s['position']['x']>before['x']+1 and s['flying'],'Invisible touch stick failed')\n        require(s['statistics']['shots']>0,'Multitouch laser failed')\n        page.dispatch_event('#game','pointerup',{'pointerType':'touch','pointerId':91,'button':0,'bubbles':True})\n        page.dispatch_event('#game','pointerup',{'pointerType':'touch','pointerId':92,'button':0,'bubbles':True})\n        page.locator('#touch-menu').tap()\n        require(page.evaluate('__game.state.menu')=='pause','Touch menu failed')\n        require(not page.evaluate('__game.state.errors'),'Touch runtime errors')\n    case('mobile multitouch flight, assisted firing and menu',touch_controls)\n    context.close()\n\n\ndef main():\n    build=subprocess.run(['node','build.mjs'],cwd=ROOT,capture_output=True,text=True)\n    if build.returncode:\n        RESULTS.append(('build',False,build.stderr));return\n    case('exit interview JSON shape and embedded credits',lambda:require(all(k in json.loads((ROOT.parent/'exit-interview.json').read_text()) for k in ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'])))\n    handler=partial(QuietHandler,directory=str(ROOT.parent))\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    base_url=f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as p:\n            browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n            run_core(browser,base_url)\n            run_touch(browser,base_url)\n            RESULTS.extend(run_transport_tests(browser,base_url))\n            spec=importlib.util.spec_from_file_location('hub_tests',ROOT/'hub-tests.py')\n            hub=importlib.util.module_from_spec(spec);spec.loader.exec_module(hub)\n            cases,errors=hub.run_hub_tests(browser,base_url)\n            RESULTS.extend((name,True,'') for name in cases)\n            RESULTS.extend(('official AI Hub conformance',False,error) for error in errors)\n            browser.close()\n    finally:\n        server.shutdown();server.server_close()\n\nif __name__=='__main__':\n    try:\n        main()\n    except Exception as error:\n        RESULTS.append(('test runner',False,str(error)))\n    failed=[r for r in RESULTS if not r[1]]\n    for name,_,detail in failed:\n        print(f'FAIL: {name}: {detail}')\n    print(f'{len(RESULTS)-len(failed)}/{len(RESULTS)} checks passed; {len(failed)} failures')\n    (ROOT/'test-results.json').write_text(json.dumps([{'name':n,'passed':p,'detail':d} for n,p,d in RESULTS],indent=2))\n    raise SystemExit(bool(failed))\nEOF\npython3 - <<'PY'\np='main.js';s=open(p).read().replace('stageTimer,score,rescued,health','stageTimer,stageChanging,score,rescued,health');open(p,'w').write(s)\nPY\nnpm test --silent\"","aggregated_output":"FAIL: single embedded file boots with native WebGPU over file://: Page.wait_for_function: ReferenceError: __gameReady is not defined\n    at eval (eval at predicate (eval at evaluate (:311:30)), <anonymous>:1:1)\n    at eval (<anonymous>)\n    at predicate (eval at evaluate (:311:30), <anonymous>:4:60)\n    at next (eval at evaluate (:311:30), <anonymous>:29:33)\n    at eval (eval at evaluate (:311:30), <anonymous>:42:13)\n    at UtilityScript.evaluate (<anonymous>:313:16)\n    at UtilityScript.<anonymous> (<anonymous>:1:44)\nFAIL: mobile multitouch flight, assisted firing and menu: Page.wait_for_function: ReferenceError: __gameReady is not defined\n    at eval (eval at predicate (eval at evaluate (:311:30)), <anonymous>:1:1)\n    at eval (<anonymous>)\n    at predicate (eval at evaluate (:311:30), <anonymous>:4:60)\n    at next (eval at evaluate (:311:30), <anonymous>:29:33)\n    at eval (eval at evaluate (:311:30), <anonymous>:42:13)\n    at UtilityScript.evaluate (<anonymous>:313:16)\n    at UtilityScript.<anonymous> (<anonymous>:1:44)\n12/14 checks passed; 2 failures\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read()\ns=s.replace(\\\"let testErrors\\\", \\\"let testErrors\\\")\ns=s.replace(\\\"let mode='boot',menu='boot'\\\", \\\"let lastSuccess=false,mode='boot',menu='boot'\\\")\ns=s.replace(\\\"onGhost:receiveGhost,onLeave:removeGhost,\\\", \\\"onGhost:receiveGhost,onLeave:removeGhost,onRivalFinish:()=>{if(mode==='result')updateRaceResults();else if(mode==='playing')toast('RIVAL SHIFT COMPLETE','Keep going. Every rescue counts.',3);},\\\")\ns=s.replace(\\\"case 'start':if(\"'!network.active)startRun();break;\", \"case '\"'start':if(\"'!network.active){if(network.started&&network.remoteCount)network.startRace();else startRun();}break;\")\ns=s.replace(\"network.finish({...netState(),success});mode='\"'result';\\\", \\\"lastSuccess=success;network.finish({...netState(),success});mode='result';\\\")\ns=s.replace(\\\"\"'$('\"'result').querySelectorAll('button').forEach\\\", \\\"updateRaceResults();\\\\n \"'$('\"'result').querySelectorAll('button').forEach\\\")\ns=s.replace(\\\"\"'$('\"'ghosts').textContent=network.remoteCount?\"'`${network.remoteCount} RIVAL ${network.remoteCount===1?'\"'PILOT':'PILOTS'} IN THE MINE\"'`:'\"'';\\\", \\\"\"'$('\"'ghosts').textContent=network.remoteCount?[...network.remote.values()].map(r=>\"'`${r.name||'\"'Rival'} · \"'${r.state?.rescued||0}/6${r.finished?'\"' HOME':''}\"'`).join('\"'  /  '):'';\\\")\ns=s.replace(\\\"function receiveGhost(state,id,meta){\\\", \\\"\\\"\\\"function updateRaceResults(){\n \"'$('\"'race-results')?.remove();\n if(network.active||\"'!network.started||!network.remoteCount)return;\n const block=document.createElement('\"'div');block.id='race-results';block.className='smallprint';block.style.marginTop='20px';\n const rivals=[...network.remote.values()],allDone=rivals.every(r=>r.finished);\n if(\"'!allDone){block.textContent='\"'RACE STILL RUNNING · Waiting for the other pilots.';}\n else{\n  const entrants=[{name:'You',success:lastSuccess,state:{time:elapsed,score}},...rivals];\n  entrants.sort((a,b)=>a.success\"'!==b.success?(a.success?-1:1):a.success?a.state.time-b.state.time:b.state.score-a.state.score);\n  block.textContent=`RESCUE RACE · ${entrants[0].name==='\"'You'?'YOU LED THE RESCUE':entrants[0].name+' LED THE RESCUE'}\"'`;\n }\n $('\"'result-stats').append(block);\n}\nfunction receiveGhost(state,id,meta){\\\"\\\"\\\")\nopen(p,'w').write(s)\np='test.py';s=open(p).read().replace(\\\"js(\\\\\\\"testPad.buttons[0].pressed=true;__game.poll()\\\\\\\")\\\", \\\"page.locator('#settings [data-action=back]').focus()\\\\n        js(\\\\\\\"testPad.buttons[0].pressed=true;__game.poll()\\\\\\\")\\\")\ns=s.replace(\\\"require('RIVAL' in page.locator('#ghosts').inner_text()\\\", \\\"require('RIVAL' in page.locator('#ghosts').inner_text()\\\")\n# Native CDP touch points exercise real pointer capture and simultaneous thumbs.\nstart=s.index(\\\"        page.dispatch_event('#game','pointerdown',{'pointerType':'touch','pointerId':91\\\")\nend=s.index(\\\"        page.locator('#touch-menu').tap()\\\", start)\nnew=\\\"\\\"\\\"        cdp=context.new_cdp_session(page)\n        left={'x':140,'y':280,'id':1}\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[left]})\n        left={'x':195,'y':215,'id':1}\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[left]})\n        right={'x':660,'y':180,'id':2}\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[left,right]})\n        page.evaluate('__game.poll();__game.tick(.7)')\n        s=page.evaluate('__game.state')\n        require(s['position']['x']>before['x']+1 and s['flying'],'Invisible touch stick failed')\n        require(s['statistics']['shots']>0,'Multitouch laser failed')\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n\\\"\\\"\\\"\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\np='transport_tests.py';s=open(p).read().replace(\\\"require('RIVAL' in page.locator('#ghosts').inner_text(), 'Rival HUD is missing.')\\\", \\\"require('Local pilot' in page.locator('#ghosts').inner_text(), 'Rival HUD is missing.')\\\")\nopen(p,'w').write(s)\nPY\nnode --check main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
