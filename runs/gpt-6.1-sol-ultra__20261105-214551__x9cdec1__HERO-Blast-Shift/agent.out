{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat network.js'","aggregated_output":"const COLORS = ['#48ddcf', '#ffbb61', '#a795ff', '#ff789d'];\nconst CHANNEL = 'hero-blast-shift-standalone-v1';\nconst noop = () => {};\nconst finite = (v, fallback = 0) => Number.isFinite(Number(v)) ? Number(v) : fallback;\nconst pack = value => {\n  const bytes = new TextEncoder().encode(JSON.stringify(value));\n  let str = ''; for (const byte of bytes) str += String.fromCharCode(byte);\n  return btoa(str);\n};\nconst unpack = code => {\n  try {\n    const bytes = Uint8Array.from(atob(String(code).replace(/\\s/g, '')), c => c.charCodeAt(0));\n    const value = JSON.parse(new TextDecoder().decode(bytes));\n    if (!value || value.game !== 'blast-shift' || typeof value.sdp !== 'string' || !['offer', 'answer'].includes(value.type)) throw new Error();\n    return { type: value.type, sdp: value.sdp };\n  } catch { throw new Error('That is not a Blast Shift connection code. Paste the complete code.'); }\n};\nfunction safeState(s = {}) {\n  return {\n    x: finite(s.x), y: finite(s.y), sector: Math.max(0, Math.min(2, Math.floor(finite(s.sector)))),\n    facing: finite(s.facing, 1) < 0 ? -1 : 1, flying: !!s.flying,\n    score: Math.max(0, finite(s.score)), rescued: Math.max(0, finite(s.rescued)), time: Math.max(0, finite(s.time))\n  };\n}\n\n/** Ghost racing: AI Hub owns session transport; direct WebRTC and local tabs are standalone only. */\nexport class Network {\n  constructor(callbacks = {}) {\n    this.cb = { onStart: noop, onEnd: noop, onGhost: noop, onLeave: noop, onTimeUp: noop, onStatus: noop, ...callbacks };\n    this.hub = globalThis.AIHub || null;\n    this._active = !!this.hub?.active;\n    this._started = false;\n    this._ended = false;\n    this._resultDone = false;\n    this._ready = false;\n    this.info = null;\n    this.status = this._active ? 'Joining AI Hub…' : 'Solo rescue';\n    this.lastState = safeState();\n    this.remote = new Map();\n    this.sequence = 0;\n    this.sendClock = 0;\n    this.progressClock = 1;\n    this.localChannel = null;\n    this.peer = null;\n    this.dataChannel = null;\n    this.standaloneStart = 0;\n    this._unsubs = [];\n    this.id = this._active ? null : (globalThis.crypto?.randomUUID?.() || `pilot-${Date.now()}-${performance.now()}`);\n  }\n  get active() { return this._active; }\n  get started() { return this._started; }\n  get ended() { return this._ended; }\n  get remoteCount() { return this.remote.size; }\n  get canPlay() {\n    if (this._ended) return false;\n    if (this.active) return this._started && this.hub.time() >= 0;\n    return !this._started || performance.now() >= this.standaloneStart;\n  }\n  get countdown() {\n    if (this.active) return this._started ? Math.max(0, -this.hub.time()) : Infinity;\n    return Math.max(0, this.standaloneStart - performance.now());\n  }\n  _status(message) { this.status = message; this.cb.onStatus(message); }\n  async init() {\n    if (!this.hub) return null;\n    this._unsubs.push(this.hub.on('start', () => {\n      this._active = true; this._started = true; this._ended = false; this._resultDone = false;\n      this.sendClock = 0; this.progressClock = 1;\n      this._status('AI Hub rescue race');\n      this.cb.onStart({ hub: true, countdownMs: Math.max(0, -this.hub.time()) });\n    }));\n    this._unsubs.push(this.hub.on('message', (data, from) => {\n      if (this._ended || !data || data.kind !== 'pilot') return;\n      const player = this.info?.players?.find(p => p.id === from);\n      if (!player || from === this.info?.me) return;\n      this._receiveGhost(data, from, { name: player.name, color: player.color });\n    }));\n    this._unsubs.push(this.hub.on('leave', ({ id }) => this._remove(id)));\n    this._unsubs.push(this.hub.on('time-up', () => {\n      if (this._ended) return;\n      this.cb.onTimeUp();\n      if (!this._resultDone) this.finish({ ...this.lastState, success: false });\n    }));\n    this._unsubs.push(this.hub.on('end', event => {\n      this._ended = true; this._started = false;\n      for (const id of [...this.remote.keys()]) this._remove(id);\n      this._status('Round complete');\n      this.cb.onEnd(event?.reason || 'finished');\n    }));\n    this.info = await this.hub.connect({ mode: 'ghost', seats: [1, 4] });\n    this._active = !!this.info;\n    if (this.info) {\n      this.id = this.info.me;\n      this._status('Waiting for the rescue race');\n    } else this._status('Solo rescue');\n    return this.info;\n  }\n  ready() {\n    if (this.active && !this._ready) { this._ready = true; this.hub.ready(); }\n  }\n  _receiveGhost(data, id, meta = {}) {\n    if (!data.state || !Number.isFinite(data.state.x) || !Number.isFinite(data.state.y)) return;\n    const previous = this.remote.get(id);\n    if (previous && finite(data.seq) < previous.seq) return;\n    const state = safeState(data.state);\n    this.remote.set(id, { ...previous, ...meta, state, seq: finite(data.seq), seen: performance.now() });\n    this.cb.onGhost(state, id, { name: meta.name || previous?.name || 'Rescue rival', color: meta.color || previous?.color || COLORS[1] });\n  }\n  _remove(id) {\n    if (this.remote.delete(id)) this.cb.onLeave(id);\n  }\n  update(dt, state) {\n    this.lastState = safeState(state);\n    if (this._ended || !this._started || !this.canPlay) return;\n    this.sendClock += Math.max(0, finite(dt));\n    this.progressClock += Math.max(0, finite(dt));\n    if (this.active && this.progressClock >= 1) {\n      this.progressClock = 0;\n      this.hub.progress({ score: this.lastState.score, label: `${this.lastState.rescued}/6 rescued · sector ${this.lastState.sector + 1}` });\n    }\n    if (this.sendClock >= 0.12) {\n      this.sendClock = 0;\n      const data = { kind: 'pilot', seq: ++this.sequence, state: this.lastState };\n      if (this.active) this.hub.send(data, { reliable: false });\n      else this._send(data);\n    }\n  }\n  finish(state = {}) {\n    if (this._ended || this._resultDone) return;\n    this._resultDone = true;\n    const clean = safeState({ ...this.lastState, ...state });\n    if (this.active) {\n      const stats = { Rescued: `${clean.rescued}/6`, Score: Math.round(clean.score) };\n      if (state.success) this.hub.result({ time: Math.max(0, this.hub.time()), stats });\n      else this.hub.result({ score: clean.score, stats });\n    } else this._send({ kind: 'finish', state: clean, success: !!state.success });\n  }\n  _standaloneOnly() {\n    if (this.active) throw new Error('AI Hub manages this race. Direct pairing is available outside a session.');\n  }\n  enableLocal() {\n    this._standaloneOnly();\n    if (!globalThis.BroadcastChannel) throw new Error('Local tab racing is unavailable in this browser. Use a peer code.');\n    if (this.localChannel) return;\n    this.localChannel = new BroadcastChannel(CHANNEL);\n    this.localChannel.onmessage = event => this._localMessage(event.data);\n    this._heartbeat = setInterval(() => {\n      if (!this.localChannel) return;\n      this.localChannel.postMessage({ kind: 'hello', id: this.id });\n      const now = performance.now();\n      for (const [id, remote] of this.remote) if (String(id).startsWith('local:') && now - remote.seen > 10000) this._remove(id);\n    }, 1500);\n    this.localChannel.postMessage({ kind: 'hello', id: this.id });\n    this._status('Local race open · open Race in another copy');\n  }\n  _localMessage(data) {\n    if (this.active || !data || data.id === this.id) return;\n    const id = `local:${data.id}`;\n    if (data.kind === 'hello') {\n      if (!this.remote.has(id) && this.remote.size >= 3) return;\n      const first = !this.remote.has(id);\n      this.remote.set(id, { ...this.remote.get(id), seen: performance.now(), seq: this.remote.get(id)?.seq || 0, name: 'Local pilot', color: COLORS[1] });\n      if (first) {\n        this.localChannel?.postMessage({ kind: 'hello', id: this.id });\n        this._status(`${this.remote.size + 1} pilots linked · start the race`);\n      }\n      return;\n    }\n    if (!this.remote.has(id)) return;\n    this.remote.get(id).seen = performance.now();\n    if (data.kind === 'leave') { this._remove(id); return; }\n    if (data.kind === 'start') { this._beginStandalone(data.startAt); return; }\n    if (data.kind === 'pilot') this._receiveGhost(data, id, { name: 'Local pilot', color: COLORS[1] });\n    if (data.kind === 'finish') this._status(`Rival finished · ${finite(data.state?.rescued)}/6 rescued`);\n  }\n  _send(data) {\n    if (this.active || this._ended) return;\n    if (this.localChannel) this.localChannel.postMessage({ ...data, id: this.id });\n    if (this.dataChannel?.readyState === 'open') this.dataChannel.send(JSON.stringify(data));\n  }\n  _beginStandalone(startAt) {\n    this._started = true; this._ended = false; this._resultDone = false;\n    this.sequence = 0; this.sendClock = 0;\n    const delay = Math.max(0, Math.min(5000, finite(startAt, Date.now() + 3000) - Date.now()));\n    this.standaloneStart = performance.now() + delay;\n    for (const remote of this.remote.values()) remote.seq = 0;\n    this._status('Rescue race · first six miners home wins');\n    this.cb.onStart({ hub: false, countdownMs: delay });\n  }\n  startRace() {\n    this._standaloneOnly();\n    if (!this.remote.size) throw new Error('Link another pilot before starting a race.');\n    const startAt = Date.now() + 3000;\n    this._send({ kind: 'start', startAt });\n    this._beginStandalone(startAt);\n  }\n  async _createPeer() {\n    this._standaloneOnly();\n    if (!globalThis.RTCPeerConnection) throw new Error('Peer racing is unavailable in this browser. Try local tabs.');\n    this._closePeer();\n    this.peer = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n    this.peer.ondatachannel = event => this._attachChannel(event.channel);\n    this.peer.onconnectionstatechange = () => {\n      const state = this.peer?.connectionState;\n      if (state === 'failed') this._status('Direct connection failed · try the same network or AI Hub');\n      if (state === 'disconnected' || state === 'closed') {\n        this._remove('peer');\n        this._status('Peer disconnected');\n      }\n    };\n    return this.peer;\n  }\n  _attachChannel(channel) {\n    this.dataChannel = channel;\n    channel.onopen = () => {\n      this.remote.set('peer', { seen: performance.now(), seq: 0, name: 'Peer pilot', color: COLORS[2] });\n      this._status('Peer linked · either pilot can start the race');\n      channel.send(JSON.stringify({ kind: 'hello' }));\n    };\n    channel.onclose = () => { this._remove('peer'); this._status('Peer disconnected'); };\n    channel.onmessage = event => {\n      if (this.active || this._ended || typeof event.data !== 'string' || event.data.length > 16000) return;\n      let data; try { data = JSON.parse(event.data); } catch { return; }\n      if (data.kind === 'pilot') this._receiveGhost(data, 'peer', { name: 'Peer pilot', color: COLORS[2] });\n      if (data.kind === 'start') this._beginStandalone(data.startAt);\n      if (data.kind === 'finish') this._status(`Rival finished · ${finite(data.state?.rescued)}/6 rescued`);\n      if (data.kind === 'leave') this._remove('peer');\n    };\n  }\n  async _gather(peer) {\n    if (peer.iceGatheringState !== 'complete') await new Promise(resolve => {\n      const timer = setTimeout(done, 7000);\n      function done() { clearTimeout(timer); peer.removeEventListener('icegatheringstatechange', change); resolve(); }\n      function change() { if (peer.iceGatheringState === 'complete') done(); }\n      peer.addEventListener('icegatheringstatechange', change);\n    });\n    if (!peer.localDescription) throw new Error('Could not create a connection code.');\n    return pack({ game: 'blast-shift', type: peer.localDescription.type, sdp: peer.localDescription.sdp });\n  }\n  async createOffer() {\n    const peer = await this._createPeer();\n    this._attachChannel(peer.createDataChannel('blast-shift-race'));\n    this._status('Preparing host code…');\n    await peer.setLocalDescription(await peer.createOffer());\n    const code = await this._gather(peer);\n    this._status('Host code ready · send it to the other pilot');\n    return code;\n  }\n  async acceptOffer(code) {\n    const description = unpack(code);\n    if (description.type !== 'offer') throw new Error('Paste the host code in Join.');\n    const peer = await this._createPeer();\n    this._status('Preparing reply code…');\n    await peer.setRemoteDescription(description);\n    await peer.setLocalDescription(await peer.createAnswer());\n    const reply = await this._gather(peer);\n    this._status('Reply ready · send it back to the host');\n    return reply;\n  }\n  async acceptAnswer(code) {\n    this._standaloneOnly();\n    if (!this.peer || this.peer.signalingState !== 'have-local-offer') throw new Error('Create a host code first.');\n    const description = unpack(code);\n    if (description.type !== 'answer') throw new Error('The host needs the other pilot’s reply code.');\n    await this.peer.setRemoteDescription(description);\n    this._status('Connecting to peer…');\n  }\n  _closePeer() {\n    if (this.dataChannel) { this.dataChannel.onclose = null; this.dataChannel.close(); this.dataChannel = null; }\n    if (this.peer) { this.peer.onconnectionstatechange = null; this.peer.close(); this.peer = null; }\n    this._remove('peer');\n  }\n  disconnect() {\n    if (this.active) return;\n    this._send({ kind: 'leave' });\n    clearInterval(this._heartbeat);\n    this.localChannel?.close(); this.localChannel = null;\n    this._closePeer();\n    for (const id of [...this.remote.keys()]) this._remove(id);\n    this._started = false; this._ended = false; this._resultDone = false;\n    this._status('Solo rescue');\n  }\n  diagnostics() {\n    return { active: this.active, started: this.started, canPlay: this.canPlay, ended: this.ended, remoteCount: this.remoteCount, resultSent: this._resultDone, status: this.status, transport: this.active ? 'AI Hub' : this.peer ? 'WebRTC' : this.localChannel ? 'BroadcastChannel' : 'none' };\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createArt,makeMat} from './art.js';\nimport {Sound,renderAudioTest} from './audio.js';\nimport {Network} from './network.js';\nimport {LEVELS} from './levels.js';\nimport META from './metadata.json' with {type:'json'};\n\nconst \"'$=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), lerp=(a,b,t)=>a+(b-a)*t;\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y), isTouch=matchMedia('\"'(pointer:coarse)').matches;\nconst fmtTime=t=>\"'`${Math.floor(t/60).toString().padStart(2,'\"'0')}:\"'${Math.floor(t%60).toString().padStart(2,'\"'0')}\"'`;\nconst DEFAULTS={flightSpeed:6.8,fuelDrain:12,enemySpeed:1,bombRadius:4,damage:1,gravity:18};\nconst tuning={...DEFAULTS}, settings={music:10,sfx:65,shake:60,glyphs:'\"'ps',assist:true};\nconst sound=new Sound();\nlet scene,camera,renderer,art,world,player,playerBody,levelArt,objects=new THREE.Group(),titlePilot,debugLines;\nlet barriers=[],miners=[],enemies=[],crystals=[],bombs=[],lasers=[],ghosts=new Map(),sector=0;\nlet mode='boot',menu='boot',returnScreen='title',lastInput=isTouch?'touch':'keyboard',idleAt=performance.now(),time=0,elapsed=0;\nlet score=0,rescued=0,health=3,fuel=100,charges=3,lives=3,checkpoint={x:4,y:25.4};\nlet training=false,god=false,infiniteFuel=false,physicsDebug=false,attractTime=0,stageTimer=0,stageChanging=false;\nlet invuln=0,fireCooldown=0,bombCooldown=0,scanTimer=0,scanCooldown=0,toastTime=0,shake=0,dockCooldown=0;\nlet fuelEmpty=false,flying=false,grounded=false,facing=1,aim={x:1,y:0},accumulator=0,lastFrame=0,renderBusy=false,frameCount=0;\nlet mouse={x:0,y:0,down:false,active:false},keys=new Set(),pressed=new Set(),padPrevious=[],padNavAt=0;\nlet touch={id:null,ox:0,oy:0,x:0,y:0,fireId:null,aimX:0,aimY:0},input={move:0,fly:0,down:0,fire:false,bomb:false,scan:false};\nlet ctxMap=\"'$('\"'map').getContext('2d'), transitionTimeout=null,tutorialFlags=new Set(),statistics={shots:0,blasts:0,crystals:0,hits:0,replacements:0};\nlet testErrors=[],ready=false,rendererName='unknown',lastPosition={x:4,y:25.4},titleFocussed=false;\nconst cameraTarget=new THREE.Vector3(20,17,55), rayPoint=new THREE.Vector3();\nconst network=new Network({\n onStart:()=>{startRun(false);if(network.countdown>0){show('hub-wait');\"'$('\"'hub-countdown').textContent='3';}},\n onGhost:receiveGhost,onLeave:removeGhost,\n onEnd:()=>{mode='hub-ended';show('hub-wait');\"'$('\"'hub-wait').querySelector('h2').textContent='Shift complete.';\"'$('\"'hub-wait').querySelector('.lead').textContent='The rescue office is tallying the results.';sound.suspend(true);},\n onTimeUp:()=>{if(mode==='playing')endRun(false,true);},\n onStatus:text=>{\"'$('\"'network-status').textContent=text;}\n});\n\nfunction noteInput(type,exitDemo=true){\n if(type\"'!==lastInput){lastInput=type;updatePrompts();}\n idleAt=performance.now();\n if(exitDemo&&mode==='\"'attract'){showTitle();return true;}\n return false;\n}\nfunction visibleScreen(){return menu&&\"'$(menu)&&!$(menu).classList.contains('\"'hidden')?\"'$(menu):null;}\nfunction show(id,focus=true){\n for(const node of document.querySelectorAll('\"'.overlay'))node.classList.toggle('hidden',node.id\"'!==id);\n menu=id;\n const playing=mode==='\"'playing'||mode==='attract';\n \"'$('\"'hud').classList.toggle('hidden',\"'!playing);$('\"'attract').classList.toggle('hidden',mode\"'!=='\"'attract');\n document.body.classList.toggle('touch-playing',isTouch&&playing&&\"'!id);\n $('\"'touch-hint').classList.toggle('hidden',\"'!isTouch||!playing||!!id||elapsed>12);\n if(id){$('\"'map-wrap').classList.add('hidden');\"'$('\"'touch-action').classList.remove('available');keys.clear();mouse.down=false;touch.id=null;touch.fireId=null;}\n if(focus&&id){requestAnimationFrame(()=>{const el=\"'$(id).querySelector('\"'button:not([disabled]),input,textarea');el?.focus({preventScroll:true});});}\n}\nfunction showTitle(){\n clearTimeout(transitionTimeout);stageChanging=false;\"'$('\"'sector-transition').style.opacity=0;mode='title';idleAt=performance.now();\n sound.suspend(false);loadLevel(0);player.group.visible=false;titlePilot.group.visible=true;\n show('title');\"'$('\"'hud').classList.add('hidden');\"'$('\"'attract').classList.add('hidden');\"'$('\"'map-wrap').classList.add('hidden');\n network.active||network.disconnect();\n}\nfunction toast(text,sub='',duration=3){\"'$('\"'toast').innerHTML='';\"'$('\"'toast').append(document.createTextNode(text));if(sub){const s=document.createElement('small');s.textContent=sub;\"'$('\"'toast').append(s);}toastTime=duration;\"'$('\"'toast').style.opacity=1;}\nfunction changeMenu(id,back=menu){returnScreen=back;show(id);sound.play('click');}\nfunction pause(){\n if(mode==='attract'){showTitle();return;}\n if(mode\"'!=='\"'playing')return;\n sound.play('click');show('pause');\"'$('\"'pause-caption').textContent=network.active?'Your race keeps running while this menu is open.':'Everyone still needs a lift.';\n for(const action of ['restart','quit','dev'])\"'$('\"'pause').querySelector(\"'`[data-action=${action}]`).disabled=network.active;\n}\nfunction resume(){if(mode==='\"'playing'){show(null);sound.suspend(false);}}\nfunction back(){if(menu==='pause'){resume();return;}const target=returnScreen||'title';if(target==='pause'){show('pause');}else if(target==='title'){showTitle();}else show(target);sound.play('click');}\n\nfunction updatePrompts(){\n const pad=lastInput==='pad',xbox=settings.glyphs==='xbox';\n const p=pad?{move:'LEFT STICK',fly:xbox?'A / STICK ↑':'✕ / STICK ↑',fire:xbox?'RT / X':'R2 / □',bomb:xbox?'RB / B':'R1 / ○',scan:xbox?'Y':'△',pause:xbox?'MENU':'OPTIONS'}:{move:'A / D',fly:'SPACE / W',fire:'MOUSE / J',bomb:'E / RIGHT CLICK',scan:'Q',pause:'ESC / P'};\n if(lastInput==='touch')Object.assign(p,{move:'LEFT THUMB',fly:'DRAG UP',fire:'RIGHT THUMB',bomb:'CHARGE BUTTON',scan:'AUTOMATIC',pause:'Ⅱ'});\n document.querySelectorAll('[data-prompt]').forEach(e=>e.textContent=p[e.dataset.prompt]);\n \"'$('\"'controls').innerHTML=\"'`<span class=\"glyph\">${p.move}</span> MOVE &nbsp; <span class=\"glyph\">${p.fly}</span> FLY<br><span class=\"glyph\">${p.fire}</span> LASER &nbsp; <span class=\"glyph\">${p.bomb}</span> CHARGE<br><span class=\"glyph\">${p.scan}</span> SCAN &nbsp; <span class=\"glyph\">${p.pause}</span> MENU`;\n $('\"'title-input').textContent=lastInput==='pad'?\"'`${xbox?'\"'XBOX':'PLAYSTATION'} CONTROLLER READY\"'`:lastInput==='\"'touch'?'TOUCH CONTROLS READY':'KEYBOARD + MOUSE READY';\n}\nfunction menuMove(delta){\n const screen=visibleScreen();if(\"'!screen)return;\n const list=[...screen.querySelectorAll('\"'button:not([disabled]),input,textarea')].filter(e=>e.getClientRects().length);\n if(\"'!list.length)return;const index=list.indexOf(document.activeElement);const next=list[(index+delta+list.length)%list.length];next.focus({preventScroll:true});next.scrollIntoView({block:'\"'nearest'});sound.play('click');\n}\nfunction menuAdjust(delta){const el=document.activeElement;if(el?.type==='range'){el.value=clamp(+el.value+delta*(+el.step||1),+el.min,+el.max);el.dispatchEvent(new Event('input'));}}\nfunction action(name){\n sound.unlock();noteInput(lastInput,false);\n switch(name){\n case 'start':if(\"'!network.active)startRun();break;\n case '\"'race':changeMenu('race','title');break;\n case 'help':changeMenu('help','title');break;\n case 'manual-pause':changeMenu('help','pause');break;\n case 'settings':changeMenu('settings','title');break;\n case 'settings-pause':changeMenu('settings','pause');break;\n case 'about':changeMenu('about','title');break;\n case 'resume':resume();break;\n case 'dev':if(\"'!network.active)changeMenu('\"'dev','pause');break;\n case 'restart':if(\"'!network.active)startRun();break;\n case '\"'quit':if(\"'!network.active)showTitle();break;\n case '\"'back':back();break;\n case 'refill':training=true;refill();toast('EQUIPMENT REFILLED');break;\n case 'teleport':training=true;teleport(checkpoint.x,checkpoint.y);break;\n case 'rescue-dev':training=true;miners.forEach(rescueMiner);break;\n case 'next-dev':training=true;if(sector<2){loadLevel(sector+1);show('dev');}else{miners.forEach(rescueMiner);endRun(true);}break;\n case 'defaults':Object.assign(tuning,DEFAULTS);god=infiniteFuel=physicsDebug=false;syncDev();if(debugLines)debugLines.visible=false;world.gravity.y=-tuning.gravity;break;\n case 'local-link':try{network.enableLocal();}catch(e){\"'$('\"'network-status').textContent=e.message;}break;\n case 'race-start':try{network.startRace();}catch(e){\"'$('\"'network-status').textContent=e.message;}break;\n case 'disconnect':network.disconnect();break;\n case 'offer':pair(async()=>network.createOffer());break;\n case 'answer':pair(async()=>network.acceptOffer(\"'$('\"'remote-code').value));break;\n case 'accept':pair(async()=>{await network.acceptAnswer(\"'$('\"'remote-code').value);return null;});break;\n case 'copy':navigator.clipboard?.writeText(\"'$('\"'link-code').value).then(()=>\"'$('\"'network-status').textContent='Code copied.').catch(()=>{\"'$('\"'link-code').select();\"'$('\"'network-status').textContent='Code selected. Copy with your keyboard.';});break;\n }\n}\nasync function pair(fn){try{const code=await fn();if(code){\"'$('\"'link-code').value=code;\"'$('\"'link-code').focus();\"'$('\"'link-code').select();}}catch(e){\"'$('\"'network-status').textContent=e.message;}}\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)action(b.dataset.action);});\ndocument.addEventListener('pointerover',e=>{if(e.pointerType\"'!=='\"'touch'&&e.target.matches('button'))e.target.focus({preventScroll:true});});\ndocument.addEventListener('keydown',e=>{\n if(e.target.matches('textarea')){noteInput('keyboard');return;}\n if(e.repeat&&['KeyE','KeyQ','Escape','KeyP'].includes(e.code))return;\n if(noteInput('keyboard')){e.preventDefault();return;}\n sound.unlock();\n if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();\n if(e.code==='Escape'||e.code==='KeyP'){if(menu&&mode==='playing'){back();}else pause();return;}\n if(menu){if(e.code==='ArrowDown'||e.code==='KeyS')menuMove(1);if(e.code==='ArrowUp'||e.code==='KeyW')menuMove(-1);if(e.code==='ArrowLeft')menuAdjust(-1);if(e.code==='ArrowRight')menuAdjust(1);if(e.code==='Enter'||e.code==='Space'){document.activeElement?.click();}return;}\n if(\"'!keys.has(e.code))pressed.add(e.code);keys.add(e.code);\n});\ndocument.addEventListener('\"'keyup',e=>keys.delete(e.code));\nwindow.addEventListener('blur',()=>{keys.clear();mouse.down=false;if(\"'!network.active&&mode==='\"'playing'&&\"'!menu)pause();});\n$('\"'touch-menu').onclick=()=>pause();\"'$('\"'touch-action').addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();pressed.add('KeyE');sound.unlock();noteInput('touch');});\nwindow.addEventListener('contextmenu',e=>e.preventDefault());\nconst canvas=\"'$('\"'game');\ncanvas.addEventListener('pointerdown',e=>{\n if(noteInput(e.pointerType==='touch'?'touch':'keyboard'))return;sound.unlock();\n if(menu)return;\n if(e.pointerType==='touch'){\n canvas.setPointerCapture(e.pointerId);\n if(e.clientX<innerWidth*.53&&touch.id===null){Object.assign(touch,{id:e.pointerId,ox:e.clientX,oy:e.clientY,x:0,y:0});const ring=\"'$('\"'touch-ring');ring.style.left=\"'`${e.clientX-50}px`;ring.style.top=`${e.clientY-50}px`;ring.style.display='\"'block';}\n else{touch.fireId=e.pointerId;touch.aimX=e.clientX;touch.aimY=e.clientY;}\n }else{mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true;if(e.button===0)mouse.down=true;if(e.button===2)pressed.add('KeyE');}\n});\nwindow.addEventListener('pointermove',e=>{\n if(e.pointerType==='touch'){\n if(e.pointerId===touch.id){touch.x=clamp((e.clientX-touch.ox)/60,-1,1);touch.y=clamp((e.clientY-touch.oy)/60,-1,1);}\n if(e.pointerId===touch.fireId){touch.aimX=e.clientX;touch.aimY=e.clientY;}\n }else{if(Math.abs(mouse.x-e.clientX)+Math.abs(mouse.y-e.clientY)>3)noteInput('keyboard');mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true;}\n});\nwindow.addEventListener('pointerup',e=>{if(e.pointerId===touch.id){touch.id=null;touch.x=touch.y=0;\"'$('\"'touch-ring').style.display='none';}if(e.pointerId===touch.fireId)touch.fireId=null;if(e.button===0)mouse.down=false;});\nwindow.addEventListener('pointercancel',()=>{touch.id=touch.fireId=null;touch.x=touch.y=0;mouse.down=false;\"'$('\"'touch-ring').style.display='none';});\nwindow.addEventListener('gamepadconnected',()=>{noteInput('pad');toast('CONTROLLER CONNECTED','Left stick to fly. Cross to lift.');});\nfunction pollInput(){\n input={move:0,fly:0,down:0,fire:false,bomb:false,scan:false};\n const pads=navigator.getGamepads?.()||[];const pad=[...pads].find(p=>p?.connected);\n if(pad){\n const b=pad.buttons.map(x=>x.pressed),a=pad.axes||[];const dz=v=>Math.abs(v||0)>.16?v:0;\n const activity=b.some((v,i)=>v&&\"'!padPrevious[i])||Math.abs(dz(a[0]))+Math.abs(dz(a[1]))+Math.abs(dz(a[2]))+Math.abs(dz(a[3]))>.1;\n if(activity&&noteInput('\"'pad')){padPrevious=b;return;}\n const edge=i=>b[i]&&\"'!padPrevious[i];\n if(edge(9)&&!b[8]){if(menu&&mode==='\"'playing')resume();else pause();}\n if(menu){\n const now=performance.now();\n if((b[12]||dz(a[1])<-.55)&&now>padNavAt){menuMove(-1);padNavAt=now+200;}\n if((b[13]||dz(a[1])>.55)&&now>padNavAt){menuMove(1);padNavAt=now+200;}\n if((b[14]||dz(a[0])<-.55)&&now>padNavAt){menuAdjust(-5);padNavAt=now+140;}\n if((b[15]||dz(a[0])>.55)&&now>padNavAt){menuAdjust(5);padNavAt=now+140;}\n if(edge(0))document.activeElement?.click();if(edge(1)&&menu\"'!=='\"'title'&&menu\"'!=='\"'hub-wait')back();\n }else{\n input.move=dz(a[0]);input.fly=Math.max(b[0]?1:0,-dz(a[1]));input.down=Math.max(0,dz(a[1]));input.fire=b[7]||b[2];input.bomb=edge(5)||edge(1);input.scan=edge(3);\n if(Math.hypot(dz(a[2]),dz(a[3]))>.25){const l=Math.hypot(a[2],a[3]);aim={x:a[2]/l,y:-a[3]/l};}\n }\n padPrevious