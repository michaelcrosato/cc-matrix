iner, createEnemy, effect, update, clearEffects, disposeObject, materials: mats, makeMat, panel, box };\n      box(exit, x, .6, -.56, .08, 1.75, .1, mats.glow, false);\n    }\n    box(exit, 0, 1.7, -.9, 3.2, .35, .65, mats.orange);\n    panel(exit, level.index === 2 ? 'SURFACE ↑' : 'LIFT ↑', 0, 1.7, -.5, 2.8, .6,\n      { bg: '#14352f', color: '#bcf9be', border: '#569b81' });\n    const gate = box(exit, 0, .2, -.9, 2.3, 2.25, .08,\n      new THREE.MeshBasicMaterial({ color: 0x7ce6b5, transparent: true, opacity: .07, depthWrite: false }), false);\n    pulses.push({ obj: gate, base: 1, speed: 1.5 });\n    return { group: world, barriers, docks, exit };\n  }\n\n  function createPilot(color = 0xffc457) {\n    const group = new THREE.Group(), suit = makeMat(color), body = new THREE.Group(); body.name = 'pilot_body'; group.add(body);\n    box(body, 0, -.08, 0, .58, .73, .44, suit);\n    box(body, 0, -.1, .26, .36, .31, .12, mats.darkSteel);\n    box(body, .06, -.1, .335, .19, .065, .025, mats.glow, false);\n    box(body, -.37, -.01, -.05, .24, .63, .4, mats.steel);\n    box(body, -.39, -.11, .18, .12, .22, .08, mats.red);\n    rod(body, [-.37, .27, -.06], [-.16, .43, -.06], .065, mats.darkSteel);\n    const helmet = ball(body, 0, .55, .02, .38, suit, [1, .92, .9]);\n    box(body, .11, .55, .29, .55, .23, .14, mats.darkSteel);\n    box(body, .14, .58, .375, .33, .06, .025, mats.glow, false);\n    ball(body, .31, .75, .2, .11, mats.lamp, [.7, 1, .7]);\n    rod(body, [-.14, .83, -.02], [-.14, 1.05, -.02], .055, mats.steel);\n    const rotor = new THREE.Group(); rotor.name = 'rotor'; rotor.position.set(-.14, 1.05, -.02); body.add(rotor);\n    box(rotor, 0, 0, 0, 1.85, .065, .15, mats.cream);\n    box(rotor, 0, 0, 0, .14, .065, 1.35, mats.cream);\n    ball(rotor, 0, .03, 0, .12, mats.darkSteel);\n    for (const [name, x] of [['left_leg', -.19], ['right_leg', .18]]) {\n      const leg = new THREE.Group(); leg.name = name; leg.position.set(x, -.43, 0); body.add(leg);\n      box(leg, 0, -.16, 0, .22, .37, .25, mats.darkSteel);\n      box(leg, .07, -.36, .06, .32, .16, .4, mats.cream);\n    }\n    const arm = new THREE.Group(); arm.position.set(.29, .1, .12); body.add(arm);\n    rod(arm, [0, 0, 0], [.3, -.12, .12], .11, suit);\n    rod(arm, [.3, -.12, .12], [.5, -.08, .16], .095, mats.cream);\n    box(arm, .53, -.02, .14, .42, .19, .21, mats.darkSteel);\n    box(arm, .77, -.02, .14, .11, .12, .15, mats.glow);\n    const flame = new THREE.Group(); flame.position.set(-.35, -.55, -.05); body.add(flame); flame.visible = false;\n    const outer = new THREE.Mesh(new THREE.ConeGeometry(.16, .75, 5), mats.orange); outer.rotation.z = Math.PI; outer.position.y = -.25; flame.add(outer);\n    const inner = new THREE.Mesh(new THREE.ConeGeometry(.09, .48, 5), mats.lamp); inner.rotation.z = Math.PI; inner.position.set(0, -.13, .1); flame.add(inner);\n    const mixer = new THREE.AnimationMixer(group);\n    mixer.clipAction(new THREE.AnimationClip('rotor_flight', 1, [\n      new THREE.NumberKeyframeTrack('rotor.rotation[y]', [0, 1], [0, Math.PI * 18]),\n      new THREE.NumberKeyframeTrack('pilot_body.position[y]', [0, .5, 1], [0, .035, 0]),\n      new THREE.NumberKeyframeTrack('left_leg.rotation[z]', [0, .5, 1], [.06, -.08, .06]),\n      new THREE.NumberKeyframeTrack('right_leg.rotation[z]', [0, .5, 1], [-.06, .08, -.06]),\n    ])).play();\n    return { group, mixer, rotor, flame, body, helmet, face: helmet };\n  }\n\n  function createMiner(index = 0) {\n    const group = new THREE.Group(), inner = new THREE.Group(); inner.name = 'miner_body'; group.add(inner);\n    const clothing = [mats.teal, mats.red, mats.orange][index % 3];\n    box(inner, 0, -.1, 0, .56, .62, .42, clothing);\n    for (const x of [-.17, .17]) { box(inner, x, -.54, 0, .22, .35, .3, mats.darkSteel); box(inner, x + .04, -.75, .08, .3, .16, .4, mats.cream); }\n    ball(inner, 0, .4, 0, .32, mats.cream, [1, .95, 1]);\n    ball(inner, 0, .59, 0, .36, mats.amber, [1.12, .7, 1.1]);\n    box(inner, 0, .47, .15, .85, .09, .55, mats.amber);\n    ball(inner, 0, .6, .33, .12, mats.lamp, [1, .8, .45]);\n    box(inner, -.12, .4, .31, .045, .065, .04, mats.ink, false);\n    box(inner, .12, .4, .31, .045, .065, .04, mats.ink, false);\n    const arm = new THREE.Group(); arm.position.set(.32, .11, .03); arm.name = 'wave'; inner.add(arm);\n    rod(arm, [0, 0, 0], [0, .43, 0], .1, clothing); ball(arm, 0, .5, .02, .13, mats.cream);\n    rod(inner, [-.32, .06, 0], [-.42, -.25, .05], .1, clothing);\n    for (const x of [-.17, .17]) box(inner, x, -.1, .23, .045, .6, .06, mats.cream, false);\n    const mixer = new THREE.AnimationMixer(group);\n    mixer.clipAction(new THREE.AnimationClip('rescue_wave', 1.2, [\n      new THREE.NumberKeyframeTrack('wave.rotation[z]', [0, .3, .6, .9, 1.2], [-.5, .4, -.5, .4, -.5]),\n      new THREE.NumberKeyframeTrack('miner_body.position[y]', [0, .6, 1.2], [0, .08, 0]),\n    ])).play();\n    return { group, mixer };\n  }\n\n  function createEnemy(type = 'bat') {\n    const group = new THREE.Group(), isSpider = type === 'spider', body = new THREE.Group(); group.add(body); body.name = 'creature_body';\n    ball(body, 0, 0, 0, .35, isSpider ? mats.red : mats.deep, isSpider ? [1.2, .8, 1] : [1, 1.2, .9]);\n    ball(body, 0, -.15, .1, .2, mats.rockLight, [1, 1, .8]);\n    for (const x of [-.12, .12]) { ball(body, x, .06, .29, .09, mats.lamp, [1, .65, .6]); ball(body, x + .02, .05, .34, .035, mats.ink, [1, 1, .5], false); }\n    const tracks = [];\n    if (isSpider) {\n      for (const side of [-1, 1]) for (let j = 0; j < 4; j++) {\n        const leg = new THREE.Group(); leg.name = `leg_${side}_${j}`; body.add(leg); leg.position.set(side * .2, -.03 + j * .08, -.08 + j * .1);\n        rod(leg, [0, 0, 0], [side * .5, .15 - j * .09, 0], .045, mats.darkSteel);\n        rod(leg, [side * .5, .15 - j * .09, 0], [side * .7, -.35, .02], .04, mats.darkSteel);\n        tracks.push(new THREE.NumberKeyframeTrack(`${leg.name}.rotation[z]`, [0, .25, .5], [side * .12, -side * .13, side * .12]));\n      }\n    } else {\n      for (const side of [-1, 1]) {\n        const wing = new THREE.Group(); wing.name = side < 0 ? 'wing_left' : 'wing_right'; wing.position.x = side * .2; body.add(wing);\n        const shape = new THREE.Shape(); shape.moveTo(0, .1); shape.lineTo(side * .55, .55); shape.lineTo(side * 1.05, .22);\n        shape.lineTo(side * .73, -.08); shape.lineTo(side * .48, .02); shape.lineTo(side * .25, -.25); shape.lineTo(0, -.12); shape.closePath();\n        const mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), new THREE.MeshBasicMaterial({ color: type === 'moth' ? 0xf3b86b : 0x80989c, side: THREE.DoubleSide })); wing.add(mesh);\n        line(wing, [[0, .1, .02], [side * .55, .55, .02], [side * 1.05, .22, .02], [side * .73, -.08, .02], [side * .48, .02, .02], [side * .25, -.25, .02], [0, -.12, .02]], INK);\n        rod(wing, [0, .05, .01], [side * .65, .28, .01], .025, mats.ink);\n        tracks.push(new THREE.NumberKeyframeTrack(`${wing.name}.rotation[z]`, [0, .15, .3], [side * -.35, side * .45, side * -.35]));\n      }\n      for (const x of [-.18, .18]) { const ear = new THREE.Mesh(new THREE.ConeGeometry(.12, .35, 3), mats.deep); ear.position.set(x, .4, 0); body.add(ear); }\n    }\n    tracks.push(new THREE.NumberKeyframeTrack('creature_body.position[y]', [0, .25, .5], [0, .06, 0]));\n    const mixer = new THREE.AnimationMixer(group); mixer.clipAction(new THREE.AnimationClip('creature_locomotion', isSpider ? .5 : .3, tracks)).play();\n    return { group, mixer };\n  }\n\n  function effect(type, x, y, value) {\n    const parent = new THREE.Group(); parent.position.set(x, y, 1.8); scene.add(parent);\n    const rnd = seeded(Math.floor(x * 11231 + y * 4001 + particles.length * 71));\n    const count = type === 'explosion' ? 32 : type === 'rescue' ? 24 : type === 'hit' ? 10 : 7;\n    const material = new THREE.MeshBasicMaterial({ color: value || (type === 'rescue' ? 0xa4f7d1 : type === 'explosion' ? 0xffb44e : 0xffdf9a), transparent: true });\n    for (let i = 0; i < count; i++) {\n      const mesh = new THREE.Mesh(i % 3 ? boxGeo : lowBallGeo, material);\n      const angle = rnd() * Math.PI * 2, speed = type === 'explosion' ? 3 + rnd() * 7 : 1 + rnd() * 4;\n      const s = type === 'explosion' ? .12 + rnd() * .3 : .05 + rnd() * .12;\n      mesh.scale.setScalar(s); parent.add(mesh);\n      particles.push({ mesh, parent, material, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed + (type === 'rescue' ? 3 : 0), life: .4 + rnd() * .6, total: 1, type });\n    }\n    if (type === 'explosion' || type === 'rescue') {\n      const ring = new THREE.Mesh(new THREE.RingGeometry(.8, .93, 32), material); parent.add(ring);\n      particles.push({ mesh: ring, parent, material, vx: 0, vy: 0, life: .4, total: .4, type: 'ring' });\n    }\n    return parent;\n  }\n\n  function update(dt, time) {\n    for (const p of pulses) {\n      p.originalScale ||= p.obj.scale.clone();\n      const s = 1 + Math.sin(time * p.speed) * .08;\n      p.obj.scale.copy(p.originalScale);\n      if (p.axis === 'y') p.obj.scale.y *= s;\n      else p.obj.scale.multiplyScalar(s);\n    }\n    for (const c of currents) c.group.position.y = c.y + Math.sin(time * 1.3) * .035;\n    for (let i = particles.length - 1; i >= 0; i--) {\n      const p = particles[i]; p.life -= dt;\n      if (p.life <= 0) {\n        p.parent.remove(p.mesh);\n        if (!sharedGeometries.has(p.mesh.geometry)) p.mesh.geometry.dispose();\n        if (!p.parent.children.length) { scene.remove(p.parent); p.material.dispose(); }\n        particles.splice(i, 1); continue;\n      }\n      if (p.type === 'ring') p.mesh.scale.setScalar(1 + (1 - p.life / p.total) * 5);\n      else { p.mesh.position.x += p.vx * dt; p.mesh.position.y += p.vy * dt; p.vy -= dt * 3; p.mesh.rotation.z += dt * 6; p.mesh.scale.multiplyScalar(Math.max(.01, 1 - dt * 1.2)); }\n      p.material.opacity = Math.max(0, p.life);\n    }\n  }\n  function clearEffects() {\n    const parents = new Set(particles.map(p => p.parent));\n    for (const parent of parents) disposeObject(parent);\n    particles.length = 0;\n  }\n  return { buildLevel, createPilot, createMiner, createEnemy, effect, update, clearEffects, disposeObject, materials: mats, makeMat, panel, box };\n}\n/* H.E.R.O. Blast Shift — all sound is synthesized at runtime. */\nconst clamp = (v, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, Number(v) || 0));\nconst note = n => 440 * 2 ** ((n - 69) / 12);\nconst musicPattern = [0, 0, 7, 3, 0, 10, 7, 3, 5, 5, 12, 8, 5, 3, 7, 10];\nconst melody = [19, null, 15, 14, null, 12, 14, null, 19, 22, null, 19, 17, null, 15, 14];\nfunction makeNoise(ctx) {\n  const b = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * 2), ctx.sampleRate);\n  const d = b.getChannelData(0); let seed = 917314;\n  for (let i = 0; i < d.length; i++) { seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5; d[i] = ((seed >>> 0) / 2147483648 - 1); }\n  return b;\n}\nfunction tone(ctx, dest, t, freq, length = .18, gain = .1, type = 'triangle', endFreq = freq, cutoff = 6500) {\n  const o = ctx.createOscillator(), env = ctx.createGain(), filter = ctx.createBiquadFilter();\n  o.type = type; o.frequency.setValueAtTime(Math.max(15, freq), t); o.frequency.exponentialRampToValueAtTime(Math.max(15, endFreq), t + length);\n  filter.type = 'lowpass'; filter.frequency.setValueAtTime(cutoff, t); filter.Q.value = .5;\n  env.gain.setValueAtTime(0, t); env.gain.linearRampToValueAtTime(gain, t + Math.min(.009, length / 5));\n  env.gain.exponentialRampToValueAtTime(.0001, t + length);\n  o.connect(filter).connect(env).connect(dest); o.start(t); o.stop(t + length + .03);\n  o.onended = () => { o.disconnect(); filter.disconnect(); env.disconnect(); };\n}\nfunction noise(ctx, dest, buffer, t, length, gain, cutoff = 2000, highpass = 100) {\n  const s = ctx.createBufferSource(), env = ctx.createGain(), lo = ctx.createBiquadFilter(), hi = ctx.createBiquadFilter();\n  s.buffer = buffer; lo.type = 'lowpass'; lo.frequency.value = cutoff; hi.type = 'highpass'; hi.frequency.value = highpass;\n  env.gain.setValueAtTime(gain, t); env.gain.exponentialRampToValueAtTime(.0001, t + length);\n  s.connect(hi).connect(lo).connect(env).connect(dest); s.start(t); s.stop(t + length + .02);\n  s.onended = () => { s.disconnect(); hi.disconnect(); lo.disconnect(); env.disconnect(); };\n}\nfunction effect(ctx, dest, buffer, name, t) {\n  switch (name) {\n    case 'laser':\n      tone(ctx, dest, t, 1450, .12, .13, 'sawtooth', 220, 3800); tone(ctx, dest, t, 90, .08, .08, 'triangle', 40); break;\n    case 'bomb':\n      tone(ctx, dest, t, 510, .1, .15, 'square', 510, 1700); tone(ctx, dest, t + .12, 680, .08, .11, 'square', 680, 1900); break;\n    case 'explode':\n      noise(ctx, dest, buffer, t, .75, .75, 3200, 35); tone(ctx, dest, t, 125, .65, .65, 'sine', 22, 1500);\n      noise(ctx, dest, buffer, t + .08, .35, .25, 7600, 800); break;\n    case 'rescue':\n      [72, 76, 79, 84].forEach((n, i) => tone(ctx, dest, t + i * .09, note(n), .38, .14, 'triangle')); break;\n    case 'hit':\n      noise(ctx, dest, buffer, t, .22, .3, 1700, 300); tone(ctx, dest, t, 180, .23, .28, 'sawtooth', 47, 1600); break;\n    case 'collect':\n      tone(ctx, dest, t, note(88), .12, .12, 'sine'); tone(ctx, dest, t + .055, note(95), .2, .1, 'triangle'); break;\n    case 'checkpoint':\n      [55, 62, 67, 74].forEach((n, i) => tone(ctx, dest, t + i * .11, note(n), .48, .12, 'triangle')); break;\n    case 'win':\n","exit_code":0,"status":"completed"}}
