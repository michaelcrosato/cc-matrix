{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc 'cat src/content/campaign.js'","aggregated_output":"/* Authored expedition. All coordinates below are tiles; Geometry.compile owns conversion. */\n(() => {\n  'use strict';\n  const NM = (globalThis.NM = globalThis.NM || {});\n  const room = (id, name, x, y, w, h, clue, kind = 'encounter') => ({ id, name, x, y, w, h, clue, kind });\n  const link = (from, to, via) => ({ from, to, ...(via ? { via } : {}) });\n  const enemy = (id, type, x, y, roomId, extra = {}) => ({ id, type, x, y, room: roomId, ...extra });\n  const supply = (id, x, y, amount, kind = 'arrows') => ({ id, x, y, kind, amount });\n  const cue = (id, x, y, text, objective, radius = 3) => ({ id, x, y, radius, text, ...(objective ? { objective } : {}) });\n  const track = (id, x, y, type, angle = 0) => ({ id, x, y, type, angle });\n  const caves = [\n    {\n      id: 'chalk', name: 'The Chalk Burrows', subtitle: 'First delve · a bow, three arrows, and a little nerve',\n      width: 58, height: 51, reward: 'axe',\n      palette: { floor: '#776b56', wall: '#b4aa89', accent: '#f3c66e', ambient: '#171d23' },\n      spawn: [5.5, 8.5], exit: [6.5, 30.5], safeAnchors: [[5.5, 8.5], [24.5, 27.5]],\n      story: 'The Crown of Clear Skies lies broken above Hushvale. Bring its two lights home.',\n      exitText: 'The entry scree has fallen. Find the ladder and claim the forester’s axe before leaving.',\n      rooms: [\n        room('chalk-mouth', 'Fallen Mouth', 2, 3, 12, 10, 'Fresh scree seals the way behind. A ranger goes forward.', 'arrival'),\n        room('chalk-practice', 'Shaft Rest', 20, 3, 13, 10, 'A pale wall, an old quiver, and room to miss safely.', 'lesson'),\n        room('chalk-scratches', 'Scratch Bend', 38, 3, 12, 10, 'Small prints vanish beneath a ledge. Something is scratching.'),\n        room('chalk-coil', 'The Hissing Turn', 38, 21, 14, 12, 'A raised coil points along its lunge. Step across its path, then shoot.'),\n        room('chalk-fork', 'Three-Candle Fork', 20, 23, 12, 10, 'The candles point toward the ladder. A narrow trace leads below.', 'navigation'),\n        room('chalk-axe', 'Forester’s Watch', 3, 23, 12, 12, 'The axe waits beside the ladder. Its last keeper is smaller than expected.', 'reward'),\n        room('chalk-cache', 'The Unclaimed Lunch', 21, 39, 10, 8, 'Follow the chalk bootprints. The forester left more than lunch.', 'optional'),\n      ],\n      passages: [link('chalk-mouth', 'chalk-practice'), link('chalk-practice', 'chalk-scratches'), link('chalk-scratches', 'chalk-coil'), link('chalk-coil', 'chalk-fork'), link('chalk-fork', 'chalk-axe'), link('chalk-fork', 'chalk-cache'), link('chalk-scratches', 'chalk-coil', [[54.5, 8.5], [54.5, 26.5]])],\n      enemies: [enemy('chalk-rat-scratch', 'rat', 44.5, 8.5, 'chalk-scratches'), enemy('chalk-snake', 'snake', 46.5, 26.5, 'chalk-coil'), enemy('chalk-rat-watch', 'rat', 9.5, 28.5, 'chalk-axe')],\n      supplies: [supply('chalk-practice-quiver', 25.5, 6.5, 6), supply('chalk-turn-quiver', 42.5, 23.5, 4), supply('chalk-watch-quiver', 12.5, 31.5, 4), supply('chalk-fork-heart', 25.5, 29.5, 1, 'heart'), supply('chalk-cache-coins', 25.5, 43.5, 3, 'treasure'), supply('chalk-cache-arrows', 27.5, 42.5, 3)],\n      tools: [{ id: 'chalk-tool-axe', kind: 'axe', x: 6.5, y: 27.5 }],\n      banks: [{ id: 'chalk-bank', ax: 30, ay: 4.5, bx: 32, by: 6.5 }],\n      tracks: [track('chalk-foot-safe', 23.5, 9.5, 'ranger', 0), track('chalk-rat-trace', 37.5, 8.5, 'rat', 0), track('chalk-snake-trace', 45.5, 19.5, 'snake', Math.PI / 2), track('chalk-cache-trace', 25.5, 36.5, 'ranger', Math.PI / 2)],\n      triggers: [\n        cue('chalk-intro', 5.5, 8.5, 'Bring the two lights of the Crown home. First, find the axe.', 'Find the forester’s axe'),\n        cue('chalk-listen', 13.5, 8.5, 'Hold focus to walk softly and listen. The dark has a voice.'),\n        cue('chalk-shot', 23.5, 8.5, 'Try your bow against the pale wall. A missed shaft can be picked up.'),\n        cue('chalk-supply', 27.5, 8.5, 'A quiver. Take what fits; the rest will wait here.'),\n        cue('chalk-rat-cue', 37.5, 8.5, 'Scratching ahead. Place the shot; save the next arrow.'),\n        cue('chalk-snake-cue', 45.5, 20.5, 'A hiss, then a lunge. Sidestep its line and answer while it recoils.'),\n        cue('chalk-cache-cue', 25.5, 34.5, 'Chalk bootprints turn away from the ladder. A small detour may pay.'),\n        cue('chalk-exit-cue', 9.5, 30.5, 'The ladder is safe when its keepers are gone. Do not leave the axe behind.'),\n      ],\n      guardIds: ['chalk-snake', 'chalk-rat-watch'], criticalPath: ['chalk-mouth', 'chalk-practice', 'chalk-scratches', 'chalk-coil', 'chalk-fork', 'chalk-axe'],\n      checkpoints: [{ id: 'chalk-entry', x: 5.5, y: 8.5, remainingDamage: 4, reachableSupplyIds: ['chalk-practice-quiver', 'chalk-turn-quiver', 'chalk-watch-quiver'] }],\n    },\n    {\n      id: 'root', name: 'Rootbell Hollow', subtitle: 'Second delve · teach the stone to turn your shot',\n      width: 65, height: 49, reward: 'boat',\n      palette: { floor: '#475749', wall: '#66785b', accent: '#b4e09a', ambient: '#101f21' },\n      spawn: [5.5, 8.5], exit: [54.5, 37.5], safeAnchors: [[5.5, 8.5], [37.5, 32.5]],\n      story: 'Roots drink the daylight here. The ferryman’s folding boat never returned.',\n      exitText: 'A rootfall seals the entrance. The old ferry ladder opens toward the river.',\n      rooms: [\n        room('root-bell', 'The Crooked Bell', 2, 3, 16, 13, 'Stand on the arrow mark. Shoot east at the sloping stone; listen for the bell.', 'lesson'),\n        room('root-corner', 'The Bent Passage', 25, 3, 13, 12, 'A bat roosts beyond the turn. Stone carries an arrow where eyes cannot.'),\n        room('root-roost', 'Wingbeat Hall', 45, 3, 14, 12, 'Falling dust marks the wings. A hiss may hide beneath their clatter.'),\n        room('root-stash', 'The Silk Cupboard', 45, 22, 14, 11, 'White threads lead to a stolen quiver. The stash can be reclaimed without a fight.'),\n        room('root-crossing', 'Old Root Bridge', 25, 22, 13, 11, 'Two ways round the roots. One is quiet; one is short.', 'navigation'),\n        room('root-ferry', 'Ferryman’s Shelf', 46, 36, 14, 10, 'The boat folds small enough for a ranger’s pack. The ladder returns to daylight.', 'reward'),\n        room('root-cache', 'The Honey Vault', 4, 24, 12, 12, 'Amber gleams beside a sleeping coil. Keep the noise down.', 'optional'),\n      ],\n      passages: [link('root-bell', 'root-corner'), link('root-corner', 'root-roost'), link('root-roost', 'root-stash'), link('root-stash', 'root-crossing'), link('root-crossing', 'root-ferry', [[31.5, 40.5]]), link('root-stash', 'root-ferry'), link('root-crossing', 'root-cache')],\n      enemies: [enemy('root-bank-bell', 'target', 13.5, 12.5, 'root-bell', { lesson: 'bank' }), enemy('root-corner-bat', 'bat', 34.5, 11.5, 'root-corner'), enemy('root-roost-bat', 'bat', 50.5, 7.5, 'root-roost'), enemy('root-roost-snake', 'snake', 56.5, 10.5, 'root-roost'), enemy('root-spider', 'spider', 52.5, 27.5, 'root-stash', { stash: [56.5, 29.5] }), enemy('root-boat-snake', 'snake', 55.5, 40.5, 'root-ferry'), enemy('root-cache-snake', 'snake', 10.5, 30.5, 'root-cache')],\n      supplies: [supply('root-bell-quiver', 5.5, 5.5, 7), supply('root-roost-quiver', 47.5, 5.5, 5), supply('root-silk-stash', 56.5, 29.5, 4), supply('root-ferry-reserve', 48.5, 38.5, 5), supply('root-bridge-heart', 29.5, 29.5, 1, 'heart'), supply('root-honey-treasure', 7.5, 32.5, 5, 'treasure'), supply('root-honey-quiver', 6.5, 27.5, 4)],\n      tools: [{ id: 'root-tool-boat', kind: 'boat', x: 50.5, y: 41.5 }],\n      banks: [{ id: 'root-lesson-bank', ax: 11, ay: 6, bx: 14, by: 9 }, { id: 'root-corner-bank', ax: 33, ay: 5, bx: 36, by: 8 }, { id: 'root-roost-bank', ax: 46, ay: 12, bx: 49, by: 9 }],\n      tracks: [track('root-bank-floor-arrow', 6.5, 8.5, 'bank', 0), track('root-bat-dust', 41.5, 8.5, 'bat', 0), track('root-silk-trace', 52.5, 20.5, 'spider', Math.PI / 2), track('root-stash-thread', 56.5, 26.5, 'spider', Math.PI / 2), track('root-honey-trace', 20.5, 27.5, 'snake', Math.PI)],\n      triggers: [\n        cue('root-bank-lesson', 5.5, 8.5, 'The bell only answers a banked shaft. Aim east along the floor arrow.', 'Ring the Crooked Bell with a bank shot'),\n        cue('root-bank-return', 14.5, 10.5, 'Beware the return! A banked arrow can strike its archer.'),\n        cue('root-corner-cue', 25.5, 8.5, 'Pale stone at the turn. A bank shot can reach the roost.'),\n        cue('root-bat-cue', 44.5, 8.5, 'Wingbeats drown a softer hiss. Watch the dust and the floor.'),\n        cue('root-spider-cue', 52.5, 22.5, 'The spider gathers loose arrows. Follow the silk to reclaim them.'),\n        cue('root-shortcut-cue', 32.5, 28.5, 'The bridge curls back beneath the ferry. Remember this way.'),\n        cue('root-boat-cue', 50.5, 38.5, 'The river has kept the ferryman waiting. Take his boat and let him rest.'),\n      ],\n      guardIds: ['root-bank-bell', 'root-boat-snake'], criticalPath: ['root-bell', 'root-corner', 'root-roost', 'root-stash', 'root-crossing', 'root-ferry'],\n      checkpoints: [{ id: 'root-entry', x: 5.5, y: 8.5, remainingDamage: 10, reachableSupplyIds: ['root-bell-quiver', 'root-roost-quiver', 'root-silk-stash', 'root-ferry-reserve'] }],\n    },\n    {\n      id: 'cistern', name: 'The Sunken Ledger', subtitle: 'Third delve · noise finds a path through stone',\n      width: 68, height: 52, reward: 'key',\n      palette: { floor: '#3f5765', wall: '#687e8a', accent: '#83d9e3', ambient: '#0c1629' },\n      spawn: [6.5, 9.5], exit: [59.5, 40.5], safeAnchors: [[6.5, 9.5], [33.5, 28.5]],\n      story: 'The gatekeeper dropped his key below the river. Something still follows the splash.',\n      exitText: 'The current took the entrance steps. The gatekeeper’s ladder climbs above the flood.',\n      rooms: [\n        room('cistern-wharf', 'Dry Wharf', 2, 4, 13, 11, 'A spare quiver lies above the waterline. A wet scraping answers every step.', 'arrival'),\n        room('cistern-ooze', 'The Patient Guest', 23, 4, 15, 13, 'Arrows cannot kill this ooze. Strike a distant wall and take the other way.', 'lesson'),\n        room('cistern-loop', 'The Listening Loop', 23, 25, 14, 12, 'Water carries the echo round the wall. Watch which passage answers.', 'navigation'),\n        room('cistern-drake', 'The Snoring Sluice', 46, 4, 16, 13, 'Heavy prints, deep snoring. The drake commits to a long straight charge.'),\n        room('cistern-records', 'Drowned Records', 46, 25, 16, 12, 'A hiss behind the wingbeats. Read the tracks before you hurry.'),\n        room('cistern-key', 'Gatekeeper’s Rise', 48, 40, 16, 9, 'The brass key is above the flood. Carry it to the old wall.', 'reward'),\n        room('cistern-cache', 'The Toll Cup', 4, 29, 12, 12, 'The toll is long unpaid. A little silver still waits in the cup.', 'optional'),\n      ],\n      passages: [link('cistern-wharf', 'cistern-ooze'), link('cistern-ooze', 'cistern-drake'), link('cistern-wharf', 'cistern-loop', [[8.5, 20.5], [29.5, 20.5]]), link('cistern-ooze', 'cistern-loop'), link('cistern-loop', 'cistern-records'), link('cistern-drake', 'cistern-records'), link('cistern-records', 'cistern-key'), link('cistern-loop', 'cistern-cache')],\n      enemies: [enemy('cistern-ooze-listener', 'ooze', 32.5, 10.5, 'cistern-ooze'), enemy('cistern-drake-sluice', 'drake', 55.5, 10.5, 'cistern-drake'), enemy('cistern-record-bat', 'bat', 51.5, 29.5, 'cistern-records'), enemy('cistern-record-snake', 'snake', 59.5, 30.5, 'cistern-records'), enemy('cistern-key-drake', 'drake', 58.5, 44.5, 'cistern-key'), enemy('cistern-toll-spider', 'spider', 10.5, 35.5, 'cistern-cache', { stash: [7.5, 37.5] })],\n      supplies: [supply('cistern-wharf-quiver', 8.5, 7.5, 7), supply('cistern-loop-quiver', 31.5, 28.5, 5), supply('cistern-rise-reserve', 51.5, 42.5, 6), supply('cistern-record-heart', 48.5, 34.5, 1, 'heart'), supply('cistern-toll-silver', 7.5, 37.5, 7, 'treasure'), supply('cistern-toll-arrows', 6.5, 32.5, 4)],\n      tools: [{ id: 'cistern-tool-key', kind: 'key', x: 53.5, y: 45.5 }],\n      banks: [{ id: 'cistern-lure-bank', ax: 34, ay: 6, bx: 36, by: 8 }, { id: 'cistern-drake-bank', ax: 48, ay: 6, bx: 51, by: 9 }, { id: 'cistern-record-bank', ax: 58, ay: 27, bx: 61, by: 30 }],\n      tracks: [track('cistern-wet-drag', 20.5, 9.5, 'ooze', 0), track('cistern-loop-splash', 29.5, 20.5, 'ooze', Math.PI / 2), track('cistern-heavy-prints', 43.5, 10.5, 'drake', 0), track('cistern-record-scales', 53.5, 23.5, 'snake', Math.PI / 2), track('cistern-toll-silk', 20.5, 34.5, 'spider', Math.PI)],\n      triggers: [\n        cue('cistern-ooze-cue', 17.5, 9.5, 'That slow ooze sheds arrows. A loud bank can draw it aside.', 'Lure the ooze; find the gate key'),\n        cue('cistern-loop-cue', 9.5, 19.5, 'A dry side passage skirts the listener. Sound must travel this way too.'),\n        cue('cistern-drake-cue', 44.5, 10.5, 'Hear the snore? Wait for the lifted head, then leave its lane.'),\n        cue('cistern-layered-cue', 53.5, 24.5, 'Wingbeats above. Scales below. Quiet feet buy time to choose.'),\n        cue('cistern-key-cue', 52.5, 42.5, 'The gatekeeper’s key. The wall above has waited long enough.'),\n      ],\n      guardIds: ['cistern-drake-sluice', 'cistern-key-drake'], criticalPath: ['cistern-wharf', 'cistern-ooze', 'cistern-drake', 'cistern-records', 'cistern-key'],\n      checkpoints: [{ id: 'cistern-entry', x: 6.5, y: 9.5, remainingDamage: 8, reachableSupplyIds: ['cistern-wharf-quiver', 'cistern-loop-quiver', 'cistern-rise-reserve'] }],\n    },\n    {\n      id: 'dawn', name: 'The Amber Eyrie', subtitle: 'Summit · first light of the broken Crown',\n      width: 62, height: 39, reward: 'dawn',\n      palette: { floor: '#76523c', wall: '#a88765', accent: '#ffd38a', ambient: '#281a2a' },\n      spawn: [6.5, 21.5], exit: [54.5, 6.5], safeAnchors: [[6.5, 21.5], [25.5, 22.5]],\n      story: 'Brasswing keeps the dawn beneath an armored breast. Make it listen somewhere else.',\n      exitText: 'Wind has taken the old stairs. The Crown’s first light opens the saddle to the cold wing.',\n      rooms: [\n        room('dawn-shelter', 'Last Sheltered Step', 2, 17, 12, 13, 'Take the reserve quiver. A warm snore rolls down from the summit.', 'arrival'),\n        room('dawn-echo', 'The Turning Stones', 21, 17, 13, 13, 'The guardian listens to stone. Place a loud miss, then move to its flank.', 'lesson'),\n        room('dawn-arena', 'Brasswing’s Lantern', 39, 10, 19, 23, 'The amber lantern stands behind the armored guardian. Three honest wounds will free it.', 'guardian'),\n        room('dawn-saddle', 'The Wind Saddle', 45, 2, 13, 8, 'A second light answers from the cold wing. A fresh quiver waits before the crossing.', 'checkpoint'),\n      ],\n      passages: [link('dawn-shelter', 'dawn-echo'), link('dawn-echo', 'dawn-arena'), link('dawn-arena', 'dawn-saddle')],\n      enemies: [enemy('dawn-snake', 'snake', 29.5, 24.5, 'dawn-echo'), enemy('dawn-brasswing', 'guardian1', 49.5, 21.5, 'dawn-arena', { name: 'Brasswing', landmark: 'The Amber Lantern', signature: 'Three hollow brass notes' })],\n      supplies: [supply('dawn-shelter-reserve', 8.5, 20.5, 8), supply('dawn-turning-reserve', 25.5, 19.5, 8), supply('dawn-arena-heart', 41.5, 29.5, 1, 'heart'), supply('dawn-saddle-reserve', 49.5, 6.5, 12)],\n      tools: [{ id: 'dawn-crown-half', kind: 'dawn', x: 54.5, y: 17.5 }],\n      banks: [{ id: 'dawn-turning-bank', ax: 29, ay: 18.5, bx: 32, by: 21.5 }, { id: 'dawn-west-bank', ax: 41, ay: 14, bx: 44, by: 17 }, { id: 'dawn-east-bank', ax: 53, ay: 27, bx: 56, by: 24 }],\n      tracks: [track('dawn-snake-scales', 18.5, 23.5, 'snake', 0), track('dawn-claw-marks', 36.5, 21.5, 'guardian1', 0)],\n      triggers: [\n        cue('dawn-reserve-cue', 6.5, 21.5, 'Last camp before the wings. Refill here; a missed arrow is still yours.', 'Free the amber half of the Crown'),\n        cue('dawn-armor-cue', 35.5, 21.5, 'Brasswing’s breast turns arrows. Draw its ear, find its flank, or bank the shot.'),\n        cue('dawn-swoop-cue', 42.5, 21.5, 'A wounded wing loads before it sweeps. Step clear when the shadow stretches.'),\n        cue('dawn-saddle-cue', 50.5, 9.5, 'One light won. A safe crossing and a full reserve lie ahead.'),\n      ],\n      guardIds: ['dawn-brasswing'], criticalPath: ['dawn-shelter', 'dawn-echo', 'dawn-arena', 'dawn-saddle'],\n      checkpoints: [{ id: 'dawn-entry', x: 6.5, y: 21.5, remainingDamage: 5, reachableSupplyIds: ['dawn-shelter-reserve', 'dawn-turning-reserve'] }, { id: 'dawn-wing-complete', x: 49.5, y: 6.5, remainingDamage: 0, reachableSupplyIds: ['dawn-saddle-reserve'] }],\n    },\n    {\n      id: 'dusk', name: 'The Blue Hour Vault', subtitle: 'Summit · the last light waits beyond the breath',\n      width: 63, height: 40, reward: 'dusk',\n      palette: { floor: '#46506c', wall: '#7b8ba5', accent: '#b6d7ff', ambient: '#11152f' },\n      spawn: [6.5, 23.5], exit: [54.5, 6.5], safeAnchors: [[6.5, 23.5], [25.5, 22.5]],\n      story: 'Hushflame keeps the evening light. Let the breath pass; loose your shaft into the hush.',\n      exitText: 'Reunite dawn and dusk at the summit beacon. The valley is waiting.',\n      rooms: [\n        room('dusk-rest', 'The Blue Rest', 2, 18, 12, 12, 'A fresh reserve, a quiet moment, and the cold wing beyond.', 'checkpoint'),\n        room('dusk-vigil', 'Vigil of Small Wings', 21, 18, 13, 13, 'A bat and a silk trail stir before the last guardian. Keep a shaft for the silence after its breath.'),\n        room('dusk-arena', 'Hushflame’s Mirror', 39, 11, 20, 24, 'Blue fire marks a lane before it burns. Shelter by the banks; strike during the long exhale.', 'guardian'),\n        room('dusk-beacon', 'The Clear-Sky Beacon', 47, 2, 13, 9, 'Fit the two lights to the Crown. Let Hushvale see the morning.', 'resolution'),\n      ],\n      passages: [link('dusk-rest', 'dusk-vigil'), link('dusk-vigil', 'dusk-arena'), link('dusk-arena', 'dusk-beacon')],\n      enemies: [enemy('dusk-vigil-bat', 'bat', 27.5, 22.5, 'dusk-vigil'), enemy('dusk-vigil-spider', 'spider', 30.5, 27.5, 'dusk-vigil', { stash: [24.5, 27.5] }), enemy('dusk-hushflame', 'guardian2', 49.5, 23.5, 'dusk-arena', { name: 'Hushflame', landmark: 'The Moonwater Mirror', signature: 'A falling glass chord, then a breath' })],\n      supplies: [supply('dusk-rest-reserve', 8.5, 22.5, 12), supply('dusk-vigil-reserve', 23.5, 20.5, 8), supply('dusk-silk-stash', 24.5, 27.5, 3), supply('dusk-arena-heart', 41.5, 31.5, 1, 'heart')],\n      tools: [{ id: 'dusk-crown-half', kind: 'dusk', x: 55.5, y: 18.5 }],\n      banks: [{ id: 'dusk-west-bank', ax: 41, ay: 15, bx: 44, by: 18 }, { id: 'dusk-east-bank', ax: 54, ay: 28, bx: 57, by: 25 }, { id: 'dusk-vigil-bank', ax: 29, ay: 20, bx: 32, by: 23 }],\n      tracks: [track('dusk-bat-dust', 18.5, 23.5, 'bat', 0), track('dusk-spider-silk', 25.5, 27.5, 'spider', Math.PI), track('dusk-scorched-lane', 36.5, 23.5, 'guardian2', 0)],\n      triggers: [\n        cue('dusk-reserve-cue', 6.5, 23.5, 'A new checkpoint. The arrows here cover the final wing.', 'Free the blue half; reunite the Crown'),\n        cue('dusk-breath-cue', 35.5, 23.5, 'Hushflame marks the floor before breathing. Leave that lane, then shoot as it rests.'),\n        cue('dusk-bank-cue', 42.5, 16.5, 'The pale banks turn a shaft and shelter a patient ranger.'),\n        cue('dusk-beacon-cue', 52.5, 11.5, 'Dawn in one hand, dusk in the other. The Crown remembers the sky.'),\n      ],\n      guardIds: ['dusk-hushflame'], criticalPath: ['dusk-rest', 'dusk-vigil', 'dusk-arena', 'dusk-beacon'],\n      checkpoints: [{ id: 'dusk-entry', x: 6.5, y: 23.5, remainingDamage: 5, reachableSupplyIds: ['dusk-rest-reserve', 'dusk-vigil-reserve', 'dusk-silk-stash'] }],\n    },\n  ];\n\n  const landmarks = [\n    { id: 'camp', name: 'Hushvale Camp', x: 0.10, y: 0.78, kind: 'camp', clue: 'Two lights crown the summit. Three reserves carry us there.' },\n    { id: 'chalk', name: 'Chalk Burrows', x: 0.24, y: 0.66, kind: 'cave', cave: 0, clue: 'Small tracks. A forester’s axe. Find the ladder through.' },\n    { id: 'forest', name: 'Bramble Door', x: 0.36, y: 0.73, kind: 'forest', requires: 'axe', toolAction: 'The axe opens the bramble road.', clue: 'Thick old roots. An axe will open the way.' },\n    { id: 'root', name: 'Rootbell Hollow', x: 0.43, y: 0.53, kind: 'cave', cave: 1, clue: 'Pale banks, stolen arrows, and a folding boat.' },\n    { id: 'river', name: 'Murmur Ferry', x: 0.58, y: 0.62, kind: 'river', requires: 'boat', toolAction: 'The boat unfolds. The party crosses together.', clue: 'The river is too deep to ford. Bring the boat.' },\n    { id: 'cistern', name: 'Sunken Ledger', x: 0.64, y: 0.41, kind: 'cave', cave: 2, clue: 'Follow the splash, bypass the ooze, claim the key.' },\n    { id: 'wall', name: 'The Long-Shut Gate', x: 0.77, y: 0.47, kind: 'wall', requires: 'key', toolAction: 'The brass key wakes the old gate.', clue: 'A brass lock. Its key lies below the river.' },\n    { id: 'dawn', name: 'Amber Eyrie', x: 0.83, y: 0.26, kind: 'summit', cave: 3, clue: 'An armored listener keeps the dawn. Aim for its flank.' },\n    { id: 'dusk', name: 'Blue Hour Vault', x: 0.70, y: 0.15, kind: 'summit', cave: 4, requires: 'dawn', clue: 'A cold breath guards the second light. Wait for the hush.' },\n  ];\n  const routes = [\n    { from: 'camp', to: 'chalk' }, { from: 'chalk', to: 'forest', requires: 'axe' },\n    { from: 'forest', to: 'root' }, { from: 'root', to: 'river', requires: 'boat' },\n    { from: 'river', to: 'cistern' }, { from: 'cistern', to: 'wall', requires: 'key' },\n    { from: 'wall', to: 'dawn' }, { from: 'dawn', to: 'dusk', requires: 'dawn' },\n    { from: 'root', to: 'camp', requires: 'boat', shortcut: true },\n    { from: 'cistern', to: 'forest', requires: 'key', shortcut: true },\n  ];\n  const enemyDefs = {\n    rat: { hp: 1, speed: 31, hearing: 6, vision: 6, windup: 0.65, attackTime: 0.32, recovery: 1.2, damage: 1, cue: 'scratching', radius: 3.7 },\n    snake: { hp: 2, speed: 18, hearing: 5, vision: 6, windup: 0.95, attackTime: 0.42, recovery: 1.7, damage: 1, cue: 'a rising hiss', radius: 4.5 },\n    bat: { hp: 1, speed: 35, hearing: 8, vision: 7, windup: 0.75, attackTime: 0.35, recovery: 1.35, damage: 1, cue: 'wingbeats', radius: 4 },\n    spider: { hp: 1, speed: 26, hearing: 6, vision: 5, windup: 0.8, attackTime: 0.35, recovery: 1.4, damage: 1, cue: 'silken clicks', radius: 4 },\n    ooze: { hp: 999, indestructible: true, speed: 12, hearing: 13, vision: 0, windup: 1.2, attackTime: 0.4, recovery: 1.5, damage: 1, cue: 'a wet scrape', radius: 6 },\n    drake: { hp: 2, speed: 20, hearing: 8, vision: 7, windup: 1.25, attackTime: 0.65, recovery: 2.1, damage: 1, cue: 'a deep snore', radius: 6 },\n    guardian1: { hp: 3, speed: 20, hearing: 15, vision: 11, windup: 1.5, attackTime: 0.8, recovery: 2.4, damage: 1, cue: 'three brass notes', radius: 10, armor: 'front' },\n    guardian2: { hp: 3, speed: 17, hearing: 12, vision: 12, windup: 1.6, attackTime: 0.75, recovery: 2.8, damage: 1, cue: 'a falling glass chord', radius: 10, armor: 'breathing' },\n    target: { hp: 1, speed: 0, hearing: 0, vision: 0, windup: 0, attackTime: 0, recovery: 0, damage: 0, cue: 'a waiting bell', radius: 3, bankOnly: true },\n  };\n\n  /** Validator accepts a candidate campaign too, so authoring tools can reject edits before build. */\n  function validate(candidate = { caves, landmarks, routes, enemyDefs }) {\n    const errors = [];\n    const ids = new Set();\n    const unique = (id, scope) => { if (!id || ids.has(id)) errors.push(`${scope}: missing or duplicate stable ID ${id}`); else ids.add(id); };\n    const finite = value => typeof value === 'number' && Number.isFinite(value);\n    for (const cave of candidate.caves || []) {\n      unique(cave.id, 'cave');\n      const roomIds = new Set(cave.rooms.map(r => r.id));\n      const inBounds = ([x, y]) => finite(x) && finite(y) && x >= 1 && y >= 1 && x < cave.width - 1 && y < cave.height - 1;\n      for (const r of cave.rooms) {\n        unique(r.id, cave.id);\n        if (![r.x, r.y, r.w, r.h].every(finite) || r.w < 3 || r.h < 3 || !inBounds([r.x, r.y]) || !inBounds([r.x + r.w - 1, r.y + r.h - 1])) errors.push(`${r.id}: room outside map or too small`);\n        if (!r.clue || !r.kind) errors.push(`${r.id}: chamber lacks a meaningful purpose`);\n      }\n      const reached = new Set([cave.rooms[0]?.id]);\n      let changed = true;\n      while (changed) {\n        changed = false;\n        for (const passage of cave.passages) {\n          if (!roomIds.has(passage.from) || !roomIds.has(passage.to)) errors.push(`${cave.id}: unknown passage room`);\n          if (reached.has(passage.from) && !reached.has(passage.to)) { reached.add(passage.to); changed = true; }\n          if (reached.has(passage.to) && !reached.has(passage.from)) { reached.add(passage.from); changed = true; }\n          if ((passage.via || []).some(point => !inBounds(point))) errors.push(`${cave.id}: passage outside map`);\n        }\n      }\n      if (reached.size !== cave.rooms.length) errors.push(`${cave.id}: isolated chamber`);\n      for (const list of ['enemies', 'supplies', 'tools', 'tracks', 'triggers', 'banks', 'checkpoints']) for (const record of cave[list] || []) {\n        unique(record.id, cave.id);\n        if (list !== 'banks' && !inBounds([record.x, record.y])) errors.push(`${record.id}: invalid coordinate`);\n      }\n      const inRoom = ([x, y]) => cave.rooms.some(r => x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h);\n      for (const point of [cave.spawn, cave.exit, ...cave.safeAnchors]) if (!inRoom(point)) errors.push(`${cave.id}: spawn, exit, or safe anchor is not in a floor chamber`);\n      for (const record of [...cave.enemies, ...cave.supplies, ...cave.tools]) if (!inRoom([record.x, record.y])) errors.push(`${record.id}: entity is not on authored room floor`);\n      for (const bank of cave.banks) if (![bank.ax, bank.ay, bank.bx, bank.by].every(finite) || Math.hypot(bank.ax - bank.bx, bank.ay - bank.by) < 0.5 || !inRoom([bank.ax, bank.ay]) || !inRoom([bank.bx, bank.by])) errors.push(`${bank.id}: invalid bank segment`);\n      const enemyIds = new Set(cave.enemies.map(e => e.id));\n      for (const guardId of cave.guardIds) if (!enemyIds.has(guardId)) errors.push(`${cave.id}: unknown exit guard ${guardId}`);\n      if (!cave.tools.some(t => t.kind === cave.reward)) errors.push(`${cave.id}: required reward is missing`);\n      for (const e of cave.enemies) if (!candidate.enemyDefs[e.type] || !roomIds.has(e.room)) errors.push(`${e.id}: unknown archetype or room`);\n      for (const roomId of cave.criticalPath) if (!roomIds.has(roomId)) errors.push(`${cave.id}: unknown critical chamber ${roomId}`);\n      const supplyIds = new Map(cave.supplies.map(s => [s.id, s]));\n      for (const checkpoint of cave.checkpoints || []) {\n        const supplies = checkpoint.reachableSupplyIds.map(id => supplyIds.get(id));\n        if (supplies.some(s => !s || s.kind !== 'arrows')) errors.push(`${checkpoint.id}: unknown reserve supply`);\n        const arrows = supplies.reduce((sum, s) => sum + (s?.amount || 0), 0);\n        if (arrows < checkpoint.remainingDamage + 3) errors.push(`${checkpoint.id}: reserve supply lacks a three-arrow safety margin`);\n      }\n      const damageBudget = cave.enemies.reduce((sum, e) => sum + (candidate.enemyDefs[e.type]?.indestructible ? 0 : candidate.enemyDefs[e.type]?.hp || 0), 0);\n      const ammoBudget = cave.supplies.filter(s => s.kind === 'arrows').reduce((sum, s) => sum + s.amount, 0);\n      if (ammoBudget < damageBudget + 3) errors.push(`${cave.id}: whole-cave ammo budget is insufficient`);\n    }\n    const landmarkIds = new Set((candidate.landmarks || []).map(l => l.id));\n    for (const landmark of candidate.landmarks || []) {\n      // Cave and map-node identities intentionally match; these are separate namespaces.\n      if (!landmark.name || !landmark.clue || !finite(landmark.x) || !finite(landmark.y) || landmark.x < 0 || landmark.x > 1 || landmark.y < 0 || landmark.y > 1) errors.push(`${landmark.id}: invalid landmark`);\n      if (landmark.cave !== undefined && !candidate.caves[landmark.cave]) errors.push(`${landmark.id}: unknown cave`);\n    }\n    for (const route of candidate.routes || []) if (!landmarkIds.has(route.from) || !landmarkIds.has(route.to)) errors.push('Route references an unknown landmark');\n    const tools = new Set();\n    const reached = new Set(['camp']);\n    let changed = true;\n    while (changed) {\n      changed = false;\n      for (const landmark of candidate.landmarks || []) if (reached.has(landmark.id) && landmark.cave !== undefined) {\n        const reward = candidate.caves[landmark.cave]?.reward;\n        if (reward && !tools.has(reward)) { tools.add(reward); changed = true; }\n      }\n      for (const route of candidate.routes || []) {\n        if (route.requires && !tools.has(route.requires)) continue;\n        const a = (candidate.landmarks || []).find(l => l.id === route.from);\n        const b = (candidate.landmarks || []).find(l => l.id === route.to);\n        if (reached.has(route.from) && (!b.requires || tools.has(b.requires)) && !reached.has(route.to)) { reached.add(route.to); changed = true; }\n        if (reached.has(route.to) && (!a.requires || tools.has(a.requires)) && !reached.has(route.from)) { reached.add(route.from); changed = true; }\n      }\n    }\n    if (reached.size !== landmarkIds.size) errors.push('Tool chain contains an unreachable landmark or self-locked tool');\n    return { valid: errors.length === 0, errors, chambers: (candidate.caves || []).reduce((sum, c) => sum + c.rooms.length, 0), damageBudget: (candidate.caves || []).map(c => ({ cave: c.id, wounds: c.enemies.reduce((sum, e) => sum + (candidate.enemyDefs[e.type]?.indestructible ? 0 : candidate.enemyDefs[e.type]?.hp || 0), 0), arrows: c.supplies.filter(s => s.kind === 'arrows').reduce((sum, s) => sum + s.amount, 0) })) };\n  }\n  NM.Content = { version: 'near-misses-1', caves, landmarks, routes, enemyDefs, validate };\n})();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"sed -n '9360,9415p' vendor/engine/my-3d2dge.js\nsed -n '1,55p' tests/art.mjs\nsed -n '1,60p' src/render/art.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"sed -n '9360,9415p' vendor/engine/my-3d2dge.js\nsed -n '1,55p' tests/art.mjs\nsed -n '1,60p' src/render/art.js\"","aggregated_output":" *    defaults). new E.Game({ menu: { items: [['Restart', fn]], settings: [...], controls: { attack: 'Sword', skill:\n *    false }, quit: 'title' } }) adjusts it; menu: false, or new E.Shell(game, { standard: false }), leaves it out.\n * ============================================================================= */\nconst SHELL_CSS = `.esh{position:fixed;inset:0;pointer-events:none;z-index:20;font:14px/1.45 var(--font);color:var(--ink);--sat:env(safe-area-inset-top,0px);\n--pt:calc(14px + env(safe-area-inset-top,0px));--pr:calc(14px + env(safe-area-inset-right,0px));--pb:calc(14px + env(safe-area-inset-bottom,0px));--pl:calc(14px + env(safe-area-inset-left,0px))}\n.esh *{box-sizing:border-box}.esh [hidden]{display:none!important}.esh p{margin:4px 0 0;white-space:pre-line}\n.esh h1,.esh h2{font-family:var(--title);font-weight:600;margin:2px 0 0;line-height:1.05}.esh h2{font-size:26px}\n.esh-pan{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:10px 13px;box-shadow:0 8px 28px #0009}\n.esh-k{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}.esh-m{color:var(--muted);font-size:12px}\n.esh-obj{position:absolute;left:var(--pl);top:var(--pt);max-width:min(330px,58vw)}.esh-obj b{font:600 17px var(--title);display:block}\n.esh-dist{color:var(--accent);font-size:12px;margin-top:4px;letter-spacing:.06em}\n.esh-vit{text-align:right;min-width:120px}.esh-hb{display:flex;gap:6px;pointer-events:auto}.esh-hb button{padding:6px 10px;font-size:11px;background:var(--paper)}\n.esh-st{font-size:11px;letter-spacing:.16em}.esh-st i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:var(--c)}\n.esh-pips{margin-top:5px}.esh-pips i{display:inline-block;width:9px;height:9px;margin-left:4px;transform:rotate(45deg);background:var(--c,var(--danger))}.esh-pips i.off{opacity:.22}\n.esh-bar{height:4px;background:#ffffff1c;border-radius:2px;overflow:hidden;margin-top:6px}.esh-bar i{display:block;height:100%;background:var(--c,var(--accent));transition:width .2s}\n.esh-cnt{margin-top:6px;font-size:12px;color:var(--muted)}.esh-cnt b{color:var(--ink);margin-left:5px}\n.esh-toast{position:absolute;left:50%;top:var(--pt);transform:translate(-50%,calc(-100% - 30px));transition:transform .35s;max-width:min(420px,80vw);text-align:center}.esh-toast.on{transform:translate(-50%,0)}\n.esh-tut{position:absolute;left:var(--pl);bottom:var(--pb);max-width:min(330px,62vw);pointer-events:auto;padding-right:30px}\n.esh-x{position:absolute;right:6px;top:4px;background:none!important;border:0!important;color:var(--muted)!important;padding:2px 6px!important;font-size:16px!important}\n.esh-pr{position:absolute;left:50%;bottom:calc(var(--pb) + 44px);transform:translateX(-50%);display:flex;gap:10px;align-items:center;min-width:200px}\n.esh kbd{font:700 12px var(--font);border:1px solid var(--accent);border-bottom-width:2px;border-radius:4px;padding:2px 7px;color:var(--accent)}\n.esh-tip{position:absolute;left:50%;bottom:calc(var(--pb) + 100px);transform:translateX(-50%);text-align:center;border-color:var(--danger)}\n.esh-col{position:absolute;right:var(--pr);top:var(--pt);display:flex;flex-direction:column;align-items:flex-end;gap:8px}.esh-place{text-align:right;font:italic 13px var(--title);color:var(--muted)}\n.esh-mini{position:absolute;right:var(--pr);bottom:var(--pb);width:min(176px,28vw);border-radius:6px;border:1px solid var(--line);pointer-events:auto;cursor:pointer}\n.esh-keys{position:absolute;left:50%;bottom:var(--pb);transform:translateX(-50%);display:flex;gap:14px;font-size:12px;color:var(--muted);white-space:nowrap;background:rgba(8,6,14,.62);padding:5px 12px;border-radius:8px}.esh-keys kbd{margin-right:4px}\n@media (pointer:coarse){.esh-keys{display:none}}@media (max-width:640px){.esh-obj{max-width:calc(100vw - 214px)}.esh-toast{left:var(--pl);right:var(--pr);top:auto;bottom:calc(var(--pb) + 124px);max-width:none;transform:translateY(calc(100% + 160px))}.esh-toast.on{transform:none}\n.esh-pr{bottom:calc(var(--pb) + 196px)}.esh-tip{bottom:calc(var(--pb) + 262px)}}\n.esh-sh{position:absolute;inset:0;display:grid;place-items:center;background:#04060acc;pointer-events:auto;padding:calc(var(--pt) + 46px) var(--pr) var(--pb) var(--pl);animation:esh-in .25s;touch-action:pan-y}.esh-ttl{padding-top:var(--pt)}\n.esh-sh *{touch-action:pan-y}.esh-sh input{touch-action:auto}\n.esh .esh-nav{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));z-index:2;width:44px;height:44px;min-height:44px;display:grid;place-items:center;padding:0;border-radius:10px;background:rgba(8,8,18,.6);border-color:rgba(255,255,255,.3);pointer-events:auto}\n.esh-nav.x{right:calc(8px + env(safe-area-inset-right,0px))}.esh-nav.bk{left:calc(8px + env(safe-area-inset-left,0px))}.esh-sw{transition:transform .2s,opacity .2s}\n.esh-mod{width:min(460px,100%);max-height:100%;overflow:auto;padding:22px 24px}.esh-wide{width:min(760px,100%)}\n.esh-ttl{place-items:center start;background:linear-gradient(90deg,#04060aee,#04060a99 50%,#04060a00 85%)}.esh-ttl>div{max-width:min(520px,92vw);padding-left:4vw}\n.esh-ttl h1{font-size:clamp(44px,10vw,92px);letter-spacing:.07em}.esh-sub{font:italic 20px var(--title);color:var(--accent);margin-top:6px}\n.esh-btns{display:flex;flex-direction:column;gap:8px;margin-top:18px}.esh-tags{display:flex;gap:10px;margin-top:18px;font-size:11px;letter-spacing:.16em;color:var(--muted)}\n.esh button{font:600 13px var(--font);letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:#ffffff0f;border:1px solid #ffffff2c;border-radius:4px;padding:10px 14px;text-align:left;cursor:pointer}\n.esh button.pri{background:var(--accent);border-color:var(--accent);color:#16130e}.esh button:disabled{opacity:.4;cursor:default}\n.esh button:focus-visible,.esh input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.esh-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:7px 0;border-bottom:1px solid var(--line)}.esh-row button{min-width:64px;text-align:center}\n.esh input[type=range]{accent-color:var(--accent);width:140px}.esh-grid{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin-top:12px;align-items:center}\n.esh-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin:16px 0 8px}.esh-stats b{display:block;font:600 24px var(--title)}\n.esh-stats small{color:var(--muted);font-size:10px;letter-spacing:.14em}.esh-med{display:inline-block;margin:6px 6px 0 0;padding:3px 9px;border-radius:12px;border:1px solid var(--accent);font-size:12px}.esh-med.off{opacity:.35;border-color:var(--muted)}\n.esh-sec{margin-top:14px}.esh-emb{font-size:34px;color:var(--accent);text-align:center}.esh-map{width:100%;margin-top:12px;border-radius:4px;cursor:crosshair;display:block}\n.esh-still,.esh-still *{transition:none!important;animation:none!important}@media (prefers-reduced-motion:reduce){.esh *{transition:none!important;animation:none!important}}\n.esh-cornered .esh-col{top:calc(var(--pt) + 50px)}.esh-sh button{min-height:44px}.esh-row{flex-wrap:wrap}.esh-row>span{flex:1 1 150px}.esh-row small{display:block;color:var(--muted);font-size:11px;line-height:1.3}\n.esh-ctl{display:flex;align-items:center;gap:8px}.esh output{min-width:46px;text-align:right;color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}\n.esh-sel{min-width:136px;text-align:center!important}.esh input[type=range]{height:30px}.esh-status{min-height:20px;margin-top:8px;color:var(--accent);font-size:12px}\n.esh-bind{display:grid;grid-template-columns:1fr minmax(92px,auto) minmax(92px,auto);gap:6px 10px;align-items:center;margin-top:8px}.esh-bind small{color:var(--muted);font-size:10px;letter-spacing:.14em;text-transform:uppercase;text-align:center}\n.esh-bind button{text-align:center;text-transform:none;letter-spacing:.02em;font-size:12px;padding:8px 10px}.esh-bind button.cap{outline:2px dashed var(--accent);outline-offset:2px}\n@keyframes esh-in{from{opacity:0}}`;\nconst SHELL_THEME = { ink: '#f1e8d6', paper: 'rgba(14,18,22,.86)', accent: '#d9b77c', muted: '#a49d8c', danger: '#e8836a', line: 'rgba(217,183,124,.3)', font: 'system-ui, sans-serif', titleFont: 'Georgia, serif' };\n/** the settings screen's groups, in order (the standard ones; a game's own are 'Game' unless they name another) */\nconst SHELL_GROUPS = ['Display', 'Sound', 'Comfort'];\n/** 'menuUp' -> 'Menu up': an action's name on the controls screen when the game gives none */\nconst actionName = a => { const t = String(a).replace(/([a-z])([A-Z0-9])/g, '$1 $2').replace(/[_-]+/g, ' ').toLowerCase(); return t.charAt(0).toUpperCase() + t.slice(1); };\nclass Shell {\nimport vm from 'node:vm';\nimport {readFileSync} from 'node:fs';\nimport assert from 'node:assert/strict';\n\nexport function run() {\n  const context = vm.createContext({console});\n  for (const file of ['vendor/engine/my-3d2dge.js','src/render/art.js']) {\n    vm.runInContext(readFileSync(new URL('../'+file,import.meta.url),'utf8'),context,{filename:file});\n  }\n  const E=context.My3D2dge,A=context.NM.Art;\n  const game=new E.Game({headless:true,draw:true,res:'ps1',view:'threequarter',menu:false});\n  let actor, kind='creature', checked=0;\n  game.start({update(){},draw(){game.r.sky(['#213d3d','#324b44']);if(kind==='ranger')A.ranger(game,actor);else if(kind==='props')for(let i=0;i<12;i++)A.prop(game,['axe','key','boat','ladder','quiver','bank','relic','marker','target','heart','arrow','treasure'][i],120+i%4*23,80+Math.floor(i/4)*24);else A.creature(game,actor);}});\n  game.focus(160,110,0);\n  try {\n    for(const type of A.types)for(const state of ['dormant','alert','windup','attacking','recovering','investigating','defeated']) {\n      actor=Object.freeze({id:type,type,x:160,y:110,hp:state==='defeated'?0:3,maxHp:3,angle:.5,state,stateTime:.25,walk:8,animTime:1.5});\n      const before=JSON.stringify(actor);game.advance(1/120);assert.equal(JSON.stringify(actor),before,'render mutated actor');checked++;\n    }\n    kind='ranger';\n    for(const angle of [0,Math.PI*.25,Math.PI*.5,Math.PI,Math.PI*1.5])for(const state of ['idle','pickup','downed','reviving','climbing','celebrating']) {\n      actor=Object.freeze({id:'ranger',seat:1,x:160,y:110,angle,draw:.18,state,walk:8,animTime:1.5});\n      const before=JSON.stringify(actor);game.advance(1/120);assert.equal(JSON.stringify(actor),before);\n      const origin=A.bowOrigin(actor);assert.ok(Number.isFinite(origin.x+origin.y+origin.z));assert.ok(Math.abs(Math.hypot(origin.x-actor.x,origin.y-actor.y)-7.5)<1e-7);checked++;\n    }\n    kind='props';game.advance(1/120);checked++;\n    assert.equal(game.errors.length,0,game.errors.map(e=>e.message).join(' | '));checked++;\n  } finally {A.clear(game);game.dispose();}\n  return checked;\n}\n\nif(process.argv[1]===new URL(import.meta.url).pathname) {\n  try {console.log(`${run()} art checks passed`);} catch(error){console.error(error);process.exitCode=1;}\n}\n/* Original native rigs for Advanced Dungeons & Near Misses.\n * Rendering owns its rigs; all pose clocks come from the authoritative actor.\n */\n(() => {\n  'use strict';\n  const NM = globalThis.NM = globalThis.NM || {};\n  const E = globalThis.My3D2dge;\n  const {px} = E;\n  const TAU = Math.PI * 2;\n  const clamp = (x, a = 0, b = 1) => Math.max(a, Math.min(b, x));\n  const rigs = new WeakMap();\n  const size = 1;\n  const BOW = Object.freeze({forward: 7.5, right: 0, up: 15});\n\n  function bowOrigin(a) {\n    const angle = a.angle || 0;\n    return {x:a.x + Math.cos(angle) * BOW.forward, y:a.y + Math.sin(angle) * BOW.forward, z:(a.z || 0) + BOW.up};\n  }\n\n  // The two hands and the string use actual rig-local attachments. The projectile\n  // origin agrees with rig.hand('R') throughout anticipation and release.\n  E.Humanoid.pose('nm-bow', (J, weight, rig) => {\n    const w = clamp(weight), pull = rig.nmPull || 0;\n    const blend = (key, target) => { J[key] = J[key].map((v,i) => v + (target[i] - v) * w); };\n    blend('handR', [BOW.forward, BOW.right, BOW.up]);\n    blend('handL', [BOW.forward - pull - 1.5, -.4, BOW.up]);\n    blend('elbowR', [2.5, 3.5, 15]);\n    blend('elbowL', [-1.5 - pull*.25, -4, 17]);\n    J.bladeDir = [1,0,0];\n  });\n  E.Humanoid.pose('nm-listen', (J, w) => {\n    for (const [key,target] of [['handL',[-1,-5,22]],['elbowL',[-1,-7,17]]]) J[key] = J[key].map((v,i) => v + (target[i] - v)*w);\n    J.head[0] -= w;\n  });\n  E.Humanoid.weapon('nm-bow', {\n    length:0, rest:[1,0,0], blade:false,\n    draw(w) {\n      const pull = w.rig.nmPull || 0, top=w.at(1.2,0,0,7.7), upper=w.at(-.7,0,0,4.2), grip=w.at(0), lower=w.at(-.7,0,0,-4.2), bottom=w.at(1.2,0,0,-7.7), string=w.at(-pull);\n      const points=[top,upper,grip,lower,bottom];\n      w.push(w.hand[2]+.05, () => {\n        for(let i=1;i<points.length;i++) {\n          px.line(w.g,...points[i-1].slice(0,2),...points[i].slice(0,2),'#201b1c',3*w.u);\n          px.line(w.g,...points[i-1].slice(0,2),...points[i].slice(0,2),'#c79556',1.4*w.u);\n        }\n        px.line(w.g,...top.slice(0,2),...string.slice(0,2),'#f0e1b9',Math.max(.6,w.u*.6));\n        px.line(w.g,...string.slice(0,2),...bottom.slice(0,2),'#f0e1b9',Math.max(.6,w.u*.6));\n        if(w.rig.nmNocked) {\n          const tip=w.at(6), feather=w.at(-pull-.7);\n          px.line(w.g,...feather.slice(0,2),...tip.slice(0,2),'#eee1b7',Math.max(1,w.u*.75));\n          px.disc(w.g,tip[0],tip[1],1.2*w.u,'#fff6d5');\n          px.line(w.g,feather[0]-w.u,feather[1]-w.u,feather[0]+w.u,feather[1]+w.u,'#78cbb1',w.u);\n        }\n      });\n    }\n  });\n\n  E.SHAPES['nm-axe']={about:'Trail axe: ash haft and a broad steel crescent',mats:{w:'oak',s:'steel',b:'leather'},parts:[['cyl','w',[0,0,0],.9,19],['box','b',[0,0,4],[2,2,4]],['prism','s',[0,0,14],[[-1,-2],[7,-4],[9,0],[7,5],[-1,3]],2,{axis:'y'}]]};\n  E.SHAPES['nm-key']={about:'Long gate key with a hollow square bow',mats:{g:'gold'},parts:[['cyl','g',[0,0,0],1,13],['box','g',[3,0,1],[6,2,2]],['box','g',[5,0,4],[2,2,3]],['box','g',[0,0,13],[9,2,2]],['mirror','x',['box','g',[3.5,0,13],[2,2,7]]],['box','g',[0,0,18],[9,2,2]]]};\n  E.SHAPES['nm-boat']={about:'Folded cedar boat and travel oar',mats:{w:'oak',b:'walnut',c:'linen'},parts:[['prism','w',[0,0,0],[[-9,-4],[-5,-8],[7,-6],[11,0],[7,6],[-5,8],[-9,4]],5],['box','b',[0,0,5],[11,8,1]],['box','c',[-2,0,6],[7,9,2]],['box','w',[0,0,8],[23,1,1]],['box','w',[10,0,8],[5,4,.8]]]};\n  E.SHAPES['nm-ladder']={about:'A guarded ash ladder to daylight',mats:{w:'oak',i:'iron'},parts:[['mirror','x',['box','w',[6,0,0],[2,3,29]]],['row',6,[0,0,5],['box','w',[0,0,14],[13,2,1.5]]],['mirror','x',['box','i',[6,0,24],[3,4,2]]]]};\n","exit_code":0,"status":"completed"}}
