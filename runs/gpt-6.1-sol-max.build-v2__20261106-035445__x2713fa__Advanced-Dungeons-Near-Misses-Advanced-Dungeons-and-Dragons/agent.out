{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"this.game.live=false;this.mode=local?'local':'solo';\\\", \\\"this.game.live=false;this.game.o.autoPause=true;this.mode=local?'local':'solo';\\\")\ns=s.replace(\\\"      this.playing=true;this.ui.lastMode=null;\\\", \\\"      this.game.allowJoin({max:2,keys:false,onJoin:(input,seat)=>{this.sim.addPlayer(seat);input.use(N.BINDINGS);input.names=this.game.input.names;this.mode='local';}});\\\\n      this.playing=true;this.ui.lastMode=null;\\\")\ns=s.replace(\\\"this.game.live=true;this.game.o.menu.quit=false;\\\", \\\"this.game.live=true;this.game.o.autoPause=false;this.game.allowJoin(false);this.game.o.menu.quit=false;\\\")\nopen(p,'w').write(s)\np='src/ui/ui.js';s=open(p).read().replace(\\\"['Field map',()=>this.fieldMap()],['Developer tools'\\\", \\\"...(\"'!app.net.connected&&!hub?[app.sim.state.players.length>1?['\"'Companion leaves the trail',()=>{app.sim.removePlayer(2);this.game.removePlayer(2);this.mode='solo';this.shell.toast('One ranger continues','The party keeps its tools and shared arrows.');this.shell.hide();}]:['Add local companion',()=>{this.game.addPlayer({pad:this.game.input.lastDevice==='gamepad'?1:0});this.shell.toast('Companion joins','A free controller owns ranger2. The quiver is shared.');this.shell.hide();}]]:[]),\\\\n      ['Field map',()=>this.fieldMap()],['Developer tools'\\\")\nopen(p,'w').write(s)\nPY\nnode scripts/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
