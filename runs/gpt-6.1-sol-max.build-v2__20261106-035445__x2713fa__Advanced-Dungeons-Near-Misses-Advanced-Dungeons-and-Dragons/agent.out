1; }\nvendor/engine/kits/roguelike.js:336:  function update(dt) {\nvendor/engine/kits/roguelike.js:344:    if (tap && game.r) { const [wx, wy] = game.view.toGround(tap[0] + game.r.ix, tap[1] + game.r.iy) || [0, 0], c = map.toCell(wx, wy); if (fog.seen(c) && grid.walk(c)) { const p = grid.path([hero.cx, [... omitted end of long line]\nvendor/engine/kits/roguelike.js:367:    map.drawFloor(r); map.queueWalls(r);\nvendor/engine/kits/roguelike.js:370:    for (const [x, y] of braziers) if (fog.seen(map.toCell(x, y))) { r.prop('brazier', x, y, 0, { light: true }); }\nvendor/engine/kits/roguelike.js:372:      if (!fog.seen([t.cx, t.cy])) continue;\nvendor/engine/kits/roguelike.js:379:      if (!fog.visible([f.cx, f.cy]) || (f.dead && f.die > .5)) continue;\nvendor/engine/kits/roguelike.js:387:    fog.draw(r, T, { height: (x, y) => map.height(x, y) });\nvendor/engine/kits/roguelike.js:454:  return { view: 'threequarter', views: ['threequarter', 'iso'], input: 'DEFAULT', res: 'ps1', pausable: true, propSize: 1.1, touch: ['attack', 'skill', 'dash'],\nvendor/engine/kits/roguelike.js:471:game.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nvendor/engine/kits/adventure.js:21:const game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nvendor/engine/kits/adventure.js:110:const menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nvendor/engine/kits/adventure.js:145:const overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nvendor/engine/kits/adventure.js:461:  function update(dt) {\nvendor/engine/kits/adventure.js:621:    bg.draw(r); map.drawFloor(r); map.queueWalls(r);\nvendor/engine/kits/adventure.js:710:  return { view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', propSize: 1.25, pausable: