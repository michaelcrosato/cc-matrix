{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"sed -n '2835,2861p' vendor/engine/my-3d2dge.js\nsed -n '6252,6276p' vendor/engine/my-3d2dge.js\"","aggregated_output":"  }\n  /**\n   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    const step = this.o.step; let n = 0;\n  dirt(x, y, o = {}) {\n    // soft patches plus small pebbles (2-3 px clusters with a lit edge), no static\n    const n = noise2(x * .1, y * .1) * .7 + noise2(x * .3, y * .3) * .3, peb = noise2(x * .45 + 9, y * .45 + 3);\n    if (peb > .84) return hex(noise2(x * .45 + 9, (y - 1) * .45 + 3) > .84 ? (o.dark || '#6e4a2e') : (o.light || '#c9a276'));\n    return hex(n > .62 ? (o.light || '#b08a5e') : n < .3 ? (o.dark || '#7d5838') : (o.base || '#9a7048'));\n  },\n  /** water with static ripple lines (baked, so it does not move). o: { base, dark, light } */\n  water(x, y, o = {}) {\n    const w = Math.sin(x * .35 + Math.sin(y * .18) * 2.2 + y * .05);\n    if (w > .93 && ((Math.floor(x) + Math.floor(y)) & 1)) return hex(o.light || '#9fe3ff');\n    return hex(noise2(x * .05, y * .05) > .55 ? (o.base || '#2f7fd0') : (o.dark || '#2464b0'));\n  },\n  /** wooden floor boards running along x. o: { base, dark, line } */\n  planks(x, y, o = {}) {\n    const row = Math.floor(y / 6), ly = y - row * 6, len = 20 + Math.floor(hash2(row, 3) * 18), joint = (x + row * 13) % len;\n    if (ly < 1 || joint < 1) return hex(o.line || '#4a2e1c');\n    const g = hash2(Math.floor(x / 3), row); return hex(g > .7 ? (o.dark || '#8a5a34') : (o.base || '#9d6a3f'));\n  },\n  /** checkerboard tiles (castle floors, bonus rooms). o: { a, b, size } */\n  checker(x, y, o = {}) { const s = o.size || 16; return hex(((Math.floor(x / s) + Math.floor(y / s)) & 1) ? (o.a || '#d8d0e8') : (o.b || '#5a5270')); },\n  /** plain color with light noise, for roads, carpets and space floors. o: { base, amount } */\n  plain(x, y, o = {}) { const c = hex(o.base || '#4a4458'), k = 1 + (Math.round((noise2(x * .15, y * .15) - .5) * 4) / 4) * (o.amount === undefined ? .14 : o.amount); return c.map(v => v * k); }\n};\n\n// the floor textures as materials: floorMat: 'dirt' draws E.tex.dirt, and the same names work on every other surface\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/config.js';s=open(p).read().replace('const N = (globalThis.NM = globalThis.NM || {});','globalThis.NM = globalThis.NM || {};\\\\n\\\\tconst N = globalThis.NM;');open(p,'w').write(s)\np='src/main.js';s=open(p).read().replace('networkStart({ role, seats, localSeat, hub, seed })','networkStart({ role, seats, hub, seed })').replace('this.ui && (this.ui.lastMode = null);','if (this.ui) this.ui.lastMode = null;').replace('this.attractStage = -1;','this.attractStage = -1;\\\\n\\\\t\\\\t\\\\tthis.demoFireId = 100;').replace('++this.demoFireId || (this.demoFireId = 100)','++this.demoFireId');open(p,'w').write(s)\np='src/sim/simulation.js';s=open(p).read().replace('const ids = this.seenActions[seat] || (this.seenActions[seat] = {});','this.seenActions[seat] ||= {};\\\\n\\\\t\\\\t\\\\tconst ids = this.seenActions[seat];\\\\n\\\\t\\\\t\\\\tthis.pending[seat] ||= [];').replace('(this.pending[seat] ||= []).push','this.pending[seat].push').replace('s.players.forEach((p) => (p.hp = 3));','s.players.forEach((p) => { p.hp = 3; });');open(p,'w').write(s)\np='src/ui/ui.js';s=open(p).read().replace('const [group, key, label, min, max, step]','const [_group, key, label, min, max, step]');open(p,'w').write(s)\np='src/render/render.js';s=open(p).read().replace('worldDraw(sim, { title = false, attract = false } = {})','worldDraw(sim, { title = false } = {})');s=s.replace(\\\"color: E.hex(\\\\\\\"#326b7a\\\\\\\"),\\\",'base: \\\"#326b7a\\\",').replace('deep: E.hex(\\\"#1b485b\\\"),','dark: \\\"#1b485b\\\",').replace('foam: E.hex(\\\"#9cbeab\\\"),','light: \\\"#9cbeab\\\",').replace('color: E.hex(\\\"#8d8061\\\")','base: \\\"#8d8061\\\", dark: \\\"#6a634d\\\", light: \\\"#a99d76\\\"').replace('color: E.hex(\\\"#49644f\\\")','base: \\\"#49644f\\\", dark: \\\"#314e3d\\\", light: \\\"#617b50\\\", flower: \\\"#c6bb7b\\\", flower2: \\\"#aabca1\\\"');open(p,'w').write(s)\np='scripts/test.mjs';s=open(p).read().replace('.reduce((sum, [key, value]) => sum + value, 0)','.reduce((sum, [, value]) => sum + value, 0)');open(p,'w').write(s)\np='tests/browser.py';s=open(p).read().replace('__NM.game.advance(.2)\\\\'', '__NM.game.advance(.2,{draw:true})\\\\'').replace('__NM.game.advance(.1)\\\\'', '__NM.game.advance(.1,{draw:true})\\\\'');s=s.replace('__NM.sim.assist();__NM.sim.loadCave(3)', '__NM.sim.assist();__NM.sim.dev.infiniteHealth=true;__NM.sim.loadCave(3)');s=s.replace('__NM.sim.updateVisibility();__NM.ui.lastMode=null;', '__NM.sim.state.players[0].invuln=0;__NM.sim.updateVisibility();__NM.ui.lastMode=null;');open(p,'w').write(s)\nfor p in ['tests/art-preview.html','tests/audio-fixture.html','tests/network-fixture.html']:\n s=open(p).read().replace('<html>','<html lang=\\\"en\\\">').replace('<button id=\\\"unlock\\\">','<button type=\\\"button\\\" id=\\\"unlock\\\">').replace('const fixture = window.__fixture =','const fixture =')\n if p.endswith('network-fixture.html'):s=s.replace('fixture.net =','window.__fixture = fixture;\\\\nfixture.net =')\n open(p,'w').write(s)\nPY\ncat > biome.json <<'EOF'\n{\n  \\\"\"'$schema\": \"https://biomejs.dev/schemas/2.4.8/schema.json\",\n  \"files\": {\"includes\": [\"src/**\", \"scripts/**\", \"tests/**\", \"!vendor/**\"]},\n  \"linter\": {\"rules\": {\"complexity\": {\"noImportantStyles\": \"off\"}, \"style\": {\"noDescendingSpecificity\": \"off\"}}}\n}\nEOF\nbiome check --write src scripts tests --max-diagnostics=30 > docs/biome-output.log 2>&1\ncat docs/biome-output.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
