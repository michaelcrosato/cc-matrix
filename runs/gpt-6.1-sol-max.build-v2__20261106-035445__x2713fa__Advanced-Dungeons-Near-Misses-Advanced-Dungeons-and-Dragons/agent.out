{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"sed -n '919,1017p' src/content/campaign.js\nsed -n '1017,1132p' src/content/campaign.js\"","aggregated_output":"\n\tconst landmarks = [\n\t\t{\n\t\t\tid: \"camp\",\n\t\t\tname: \"Hushvale Camp\",\n\t\t\tx: 0.1,\n\t\t\ty: 0.78,\n\t\t\tkind: \"camp\",\n\t\t\tclue: \"Two lights crown the summit. Three reserves carry us there.\",\n\t\t},\n\t\t{\n\t\t\tid: \"chalk\",\n\t\t\tname: \"Chalk Burrows\",\n\t\t\tx: 0.24,\n\t\t\ty: 0.66,\n\t\t\tkind: \"cave\",\n\t\t\tcave: 0,\n\t\t\tclue: \"Small tracks. A forester’s axe. Find the ladder through.\",\n\t\t},\n\t\t{\n\t\t\tid: \"forest\",\n\t\t\tname: \"Bramble Door\",\n\t\t\tx: 0.36,\n\t\t\ty: 0.73,\n\t\t\tkind: \"forest\",\n\t\t\trequires: \"axe\",\n\t\t\ttoolAction: \"The axe opens the bramble road.\",\n\t\t\tclue: \"Thick old roots. An axe will open the way.\",\n\t\t},\n\t\t{\n\t\t\tid: \"root\",\n\t\t\tname: \"Rootbell Hollow\",\n\t\t\tx: 0.43,\n\t\t\ty: 0.53,\n\t\t\tkind: \"cave\",\n\t\t\tcave: 1,\n\t\t\tclue: \"Pale banks, stolen arrows, and a folding boat.\",\n\t\t},\n\t\t{\n\t\t\tid: \"river\",\n\t\t\tname: \"Murmur Ferry\",\n\t\t\tx: 0.58,\n\t\t\ty: 0.62,\n\t\t\tkind: \"river\",\n\t\t\trequires: \"boat\",\n\t\t\ttoolAction: \"The boat unfolds. The party crosses together.\",\n\t\t\tclue: \"The river is too deep to ford. Bring the boat.\",\n\t\t},\n\t\t{\n\t\t\tid: \"cistern\",\n\t\t\tname: \"Sunken Ledger\",\n\t\t\tx: 0.64,\n\t\t\ty: 0.41,\n\t\t\tkind: \"cave\",\n\t\t\tcave: 2,\n\t\t\tclue: \"Follow the splash, bypass the ooze, claim the key.\",\n\t\t},\n\t\t{\n\t\t\tid: \"wall\",\n\t\t\tname: \"The Long-Shut Gate\",\n\t\t\tx: 0.77,\n\t\t\ty: 0.47,\n\t\t\tkind: \"wall\",\n\t\t\trequires: \"key\",\n\t\t\ttoolAction: \"The brass key wakes the old gate.\",\n\t\t\tclue: \"A brass lock. Its key lies below the river.\",\n\t\t},\n\t\t{\n\t\t\tid: \"dawn\",\n\t\t\tname: \"Amber Eyrie\",\n\t\t\tx: 0.83,\n\t\t\ty: 0.26,\n\t\t\tkind: \"summit\",\n\t\t\tcave: 3,\n\t\t\tclue: \"An armored listener keeps the dawn. Aim for its flank.\",\n\t\t},\n\t\t{\n\t\t\tid: \"dusk\",\n\t\t\tname: \"Blue Hour Vault\",\n\t\t\tx: 0.7,\n\t\t\ty: 0.15,\n\t\t\tkind: \"summit\",\n\t\t\tcave: 4,\n\t\t\trequires: \"dawn\",\n\t\t\tclue: \"A cold breath guards the second light. Wait for the hush.\",\n\t\t},\n\t];\n\tconst routes = [\n\t\t{ from: \"camp\", to: \"chalk\" },\n\t\t{ from: \"chalk\", to: \"forest\", requires: \"axe\" },\n\t\t{ from: \"forest\", to: \"root\" },\n\t\t{ from: \"root\", to: \"river\", requires: \"boat\" },\n\t\t{ from: \"river\", to: \"cistern\" },\n\t\t{ from: \"cistern\", to: \"wall\", requires: \"key\" },\n\t\t{ from: \"wall\", to: \"dawn\" },\n\t\t{ from: \"dawn\", to: \"dusk\", requires: \"dawn\" },\n\t\t{ from: \"root\", to: \"camp\", requires: \"boat\", shortcut: true },\n\t\t{ from: \"cistern\", to: \"forest\", requires: \"key\", shortcut: true },\n\t];\n\t];\n\tconst enemyDefs = {\n\t\trat: {\n\t\t\thp: 1,\n\t\t\tspeed: 31,\n\t\t\thearing: 6,\n\t\t\tvision: 6,\n\t\t\twindup: 0.65,\n\t\t\tattackTime: 0.32,\n\t\t\trecovery: 1.2,\n\t\t\tdamage: 1,\n\t\t\tcue: \"scratching\",\n\t\t\tradius: 3.7,\n\t\t},\n\t\tsnake: {\n\t\t\thp: 2,\n\t\t\tspeed: 18,\n\t\t\thearing: 5,\n\t\t\tvision: 6,\n\t\t\twindup: 0.95,\n\t\t\tattackTime: 0.42,\n\t\t\trecovery: 1.7,\n\t\t\tdamage: 1,\n\t\t\tcue: \"a rising hiss\",\n\t\t\tradius: 4.5,\n\t\t},\n\t\tbat: {\n\t\t\thp: 1,\n\t\t\tspeed: 35,\n\t\t\thearing: 8,\n\t\t\tvision: 7,\n\t\t\twindup: 0.75,\n\t\t\tattackTime: 0.35,\n\t\t\trecovery: 1.35,\n\t\t\tdamage: 1,\n\t\t\tcue: \"wingbeats\",\n\t\t\tradius: 4,\n\t\t},\n\t\tspider: {\n\t\t\thp: 1,\n\t\t\tspeed: 26,\n\t\t\thearing: 6,\n\t\t\tvision: 5,\n\t\t\twindup: 0.8,\n\t\t\tattackTime: 0.35,\n\t\t\trecovery: 1.4,\n\t\t\tdamage: 1,\n\t\t\tcue: \"silken clicks\",\n\t\t\tradius: 4,\n\t\t},\n\t\tooze: {\n\t\t\thp: 999,\n\t\t\tindestructible: true,\n\t\t\tspeed: 12,\n\t\t\thearing: 13,\n\t\t\tvision: 0,\n\t\t\twindup