f (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n22:/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n42:  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n5:<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n7:<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n8:<meta name=\"theme-color\" content=\"#1b1530\">\n9:<meta name=\"hub:type\" content=\"Tech demo\">\n10:<meta name=\"hub:players\" content=\"1\">\n11:<meta name=\"hub:session\" content=\"1\">\n12:<meta name=\"hub:session-players\" content=\"2-4\">\n13:<meta name=\"hub:session-mode\" content=\"shared-world\">\n14:<meta name=\"hub:session-minutes\" content=\"2\">\n15:<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n16:<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n55:2. The game connects and calls `ready()`.\n111:- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n114:- `AIHub.ready()` is called once, when the game has loaded and the round can\n117:  Ready, and every game has called `ready()`. A game still loading then gets\n120:`info` (also on `AIHub` after `connect