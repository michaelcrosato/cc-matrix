Circle(sim.level, down.x, down.y),\n389-\t\t\t\"Respawn point is traversable\",\n390-\t\t);\n391-\t\tconst solo = fixture();\n--\n399-\t\t\t\"Last reserve resolves into a proper defeat state\",\n400-\t\t);\n401-\t\tequal(solo.state.party.reserves, 0, \"Last reserve never goes negative\");\n402-\t});\n403-\n404:\ttest(\"held-state heartbeat cleanup covers revival\", () => {\n405-\t\tconst sim = fixture([1, 2]);\n406-\t\tconst [down, helper] = sim.state.players;\n407-\t\thelper.x = down.x + 10;\n408-\t\tdown.invuln = 0;\n409:\t\tsim.damage(down, 3, \"stale helper\");\n410-\t\tsim.command(2, { interactHeld: true, epoch: 1, seq: 1 });\n411-\t\tstep(sim, 2.1);\n412-\t\tcheck(\n413-\t\t\tdown.downed,\n414:\t\t\t\"A single stale interact packet cannot continue a 1.8-second revival after held-state timeout\",\n415-\t\t);\n416-\t});\n417-\n418-\ttest(\"fog memory, occlusion, and transient arrow light\", () => {\n419-\t\tconst split = {\n--\n553-\t\t\tfirstDamage !== null && firstDamage >= 1.2,\n554-\t\t\t\"The first strike follows alert and windup with a meaningful reaction interval\",\n555-\t\t);\n556-\t});\n557-\n558:\ttest(\"save integrity, interrupted writes, and denied storage\", () => {\n559-\t\tconst memory = new Map();\n560:\t\tconst storage = {\n561-\t\t\tgetItem: (key) => memory.get(key) ?? null,\n562-\t\t\tsetItem: (key, value) => memory.set(key, value),\n563-\t\t\tremoveItem: (key) => memory.delete(key),\n564-\t\t};\n565:\t\tconst save = new N.Save(storage),\n566-\t\t\tsim = new N.Sim();\n567-\t\tsim.loadCave(0);\n568-\t\tconst valid = { state: sim.snapshot(), restart: sim.snapshot() };\n569-\t\tsave.write(valid);\n570-\t\tcheck(\n--\n589-\t\tmemory.set(`${save.key}.pending`, \"truncated\");\n590-\t\tcheck(\n591-\t\t\tsave.read()?.state.mode === \"cave\",\n592-\t\t\t\"Interrupted pending write preserves the previous committed save\",\n593-\t\t);\n594:\t\tconst denied = new N.Save({\n595-\t\t\tgetItem() {\n596-\t\t\t\tthrow Error(\"denied\");\n597-\t\t\t},\n598-\t