{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'PY'\n\\\"\\\"\\\"Final-file integration and presentation checks; mutations are isolated developer fixtures.\\\"\\\"\\\"\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nfrom audio_browser import run as audio_checks\n\nROOT = Path(__file__).resolve().parents[1]\nIDENTITY = json.loads((ROOT / 'identity.json').read_text())\nURL = (ROOT.parent / IDENTITY['html']).as_uri()\nPAD = \\\"\\\"\\\"window.__pad={on:false,axes:[0,0,0,0],buttons:Array(17).fill(false)};navigator.getGamepads=()=>window.__pad.on?[{index:0,id:'DualSense Wireless Controller',mapping:'standard',connected:true,axes:window.__pad.axes,buttons:window.__pad.buttons.map(pressed=>({pressed,value:pressed?1:0,touched:pressed}))}]:[];\\\"\\\"\\\"\n\ndef run():\n    count = 0\n    defects = []\n    def check(value, message):\n        nonlocal count\n        assert value, message\n        count += 1\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={'width': 1920, 'height': 1080})\n        context.add_init_script(PAD)\n        page = context.new_page()\n        errors = []\n        requests = []\n        page.on('pageerror', lambda error: errors.append(str(error)))\n        page.on('request', lambda request: requests.append(request.url))\n        page.goto(URL)\n        page.wait_for_function('window.__NM?.ready')\n        check(page.evaluate(\\\"document.body.dataset.game === 'near-misses-20261106-035445'\\\"), 'Final artifact identity')\n        check(page.title() == IDENTITY['title'], 'Exact random title')\n        check(page.evaluate('document.head.querySelectorAll(\\\"script\\\")[0].textContent.includes(\\\"aihub-session 1.4.0\\\")'), 'Unmodified session client first')\n        check(page.evaluate('document.querySelector(\\\"meta[name=\\\\\\\"hub:session-players\\\\\\\"]\\\").content') == '1-2', 'Declared two-player seats')\n        check(page.get_by_role('button', name='Continue expedition', exact=True).is_disabled(), 'No invented continue')\n        boxes = page.locator('.esh-btns button').evaluate_all('(buttons)=>buttons.map(b=>{let r=b.getBoundingClientRect();return {top:r.top,bottom:r.bottom,left:r.left,right:r.right}})')\n        check(all(b['top'] >= 0 and b['bottom'] <= 1080 and b['left'] >= 0 and b['right'] <= 1920 for b in boxes), 'TV title actions fit viewport')\n        page.screenshot(path=str(ROOT / 'tests/title-tv.png'))\n        page.get_by_role('button', name='New expedition', exact=True).click()\n        page.get_by_role('button', name='Chalk Burrows', exact=True).click()\n        page.wait_for_function('__NM.sim.state.mode === \\\"cave\\\" && \"'!__NM.ui.shell.screen'\"')\n        check(page.evaluate('__NM.sim.state.party.ammo') == 3, 'Three initial arrows')\n        initial_x = page.evaluate('__NM.sim.state.players[0].x')\n        page.keyboard.down('d')\n        page.wait_for_function(f'__NM.sim.state.players[0].x > {initial_x + 9}')\n        page.keyboard.up('d')\n        check(page.evaluate('__NM.sim.state.players[0].x') > initial_x, 'Expected WASD movement')\n        page.mouse.move(1450, 540)\n        page.wait_for_timeout(100)\n        page.mouse.down()\n        page.wait_for_timeout(700)\n        page.mouse.up()\n        check(page.evaluate('__NM.sim.state.stats.shots') == 1, 'Held mouse produces one intentional arrow')\n        check(page.evaluate('Math.abs(__NM.sim.state.players[0].angle) < .8'), 'Mouse aim projects to ground')\n        check(page.evaluate('__NM.sound.stats.effectiveMusic') in (None, .1), 'Music diagnostic remains finite/default')\n        page.screenshot(path=str(ROOT / 'tests/cave-tv.png'))\n        page.keyboard.press('Escape')\n        page.wait_for_function('__NM.game.paused && __NM.ui.shell.screen === \\\"pause\\\"')\n        tick = page.evaluate('__NM.sim.state.tick')\n        page.wait_for_timeout(180)\n        check(page.evaluate('__NM.sim.state.tick') == tick, 'Solo pause stops authoritative simulation')\n        page.get_by_role('button', name='Developer tools', exact=True).click()\n        check(page.get_by_role('button', name='Balance sliders', exact=True).is_visible(), 'Developer tools reachable from pause')\n        save_before_dev = page.evaluate('localStorage.getItem(__NM.save.key)')\n        page.get_by_role('button', name='Balance sliders', exact=True).click()\n        page.get_by_role('button', name='Movement', exact=True).click()\n        slider = page.get_by_role('slider', name='Walking speed', exact=True)\n        slider.fill('62')\n        slider.dispatch_event('input')\n        check(page.evaluate('__NM.sim.config.moveSpeed') == 62, 'Live tuning reaches existing simulation')\n        check(page.evaluate('__NM.sim.state.stats.assisted'), 'Developer changes mark assistance')\n        page.evaluate('__NM.saveNow()')\n        check(page.evaluate('localStorage.getItem(__NM.save.key)') == save_before_dev, 'Developer changes do not overwrite campaign')\n        page.evaluate('__NM.ui.tuning()')\n        page.get_by_role('button', name='Reset all to defaults', exact=True).click()\n        check(page.evaluate('JSON.stringify(__NM.sim.config) === JSON.stringify(NM.DEFAULTS)'), 'All live defaults reset together')\n        page.evaluate('__NM.game.input.rebind(\\\"dodge\\\",\\\"keys\\\",\\\"KeyQ\\\")')\n        check(page.evaluate('__NM.game.input.label(\\\"dodge\\\")') == 'Q', 'Rebinding updates prompt')\n        page.evaluate('__NM.game.input.resetBindings()')\n        page.evaluate('__NM.ui.shell.hide(); __NM.game.resume()')\n        page.evaluate('__pad.on=true;__pad.axes=[.7,0,0,0]')\n        old_x = page.evaluate('__NM.sim.state.players[0].x')\n        page.wait_for_function(f'__NM.sim.state.players[0].x > {old_x + 5}')\n        page.evaluate('__pad.axes=[0,0,0,0]')\n        check(page.evaluate('__NM.game.input.lastDevice