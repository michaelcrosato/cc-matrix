        cdp.send('Input.dispatchTouchEvent', {'type': 'touchEnd', 'touchPoints': [{'x': 122, 'y': 560, 'id': 1}]})\n        phone.wait_for_function('__NM.sim.state.stats.shots === 1')\n        check(phone.evaluate('__NM.controls.fingers.size') == 1, 'Right release retains left pointer ownership')\n        cdp.send('Input.dispatchTouchEvent', {'type': 'touchCancel', 'touchPoints': []})\n        phone.wait_for_timeout(70)\n        check(phone.evaluate('__NM.controls.touchMove.every(v=>v===0) && __NM.controls.fingers.size===0'), 'Pointer cancellation releases movement')\n        check(phone.evaluate('document.querySelectorAll(\\\".nm-pairtext\\\").length') == 0, 'Touch play has no permanent pairing or button panel')\n        phone.screenshot(path=str(ROOT / 'tests/touch-portrait.png'))\n        phone.set_viewport_size({'width': 844, 'height': 390})\n        phone.wait_for_timeout(120)\n        check(phone.evaluate('__NM.controls.fingers.size') == 0, 'Orientation change clears pointers')\n        check(phone.evaluate('__NM.game.errors.length') == 0, 'Touch layout draws without errors')\n        phone_context.close()\n        count += audio_checks(browser)\n        browser.close()\n        # Secondary renderer/storage path; no real iOS certification is claimed.\n        secondary = p.webkit.launch(headless=True)\n        web_page = secondary.new_page(viewport={'width': 1280, 'height': 720})\n        web_page.goto(URL)\n        web_page.wait_for_function('window.__NM?.ready')\n        check(web_page.evaluate('__NM.game.errors.length') == 0, 'WebKit file startup')\n        web_page.get_by_role('button', name='New expedition', exact=True).click()\n        web_page.get_by_role('button', name='Chalk Burrows', exact=True).click()\n        web_page.wait_for_function('__NM.sim.state.mode === \\\"cave\\\"')\n        check(web_page.evaluate('__NM.game.errors.length') == 0, 'WebKit native cave rendering')\n        secondary.close()\n    (ROOT / 'docs/browser-report.json').write_text(json.dumps({'checks': count, 'errors': errors, 'scope': 'Final file Chromium TV and touch emulation, WebKit, engine inputs, storage, attract, developer sliders, code audio'}, indent=2))\n    return count\n\nif __name__ == '__main__':\n    print(json.dumps({'checks': run()}))\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/browser.py\"","aggregated_output":"Traceback (most recent call last):\n  File \"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-035445__x2713fa/work/Advanced-Dungeons-Near-Misses-Advanced-Dungeons-and-Dragons-gpt-6.1-sol-max-20261106-035445/tests/browser.py\", line 185, in <module>\n    print(json.dumps({'checks': run()}))\n                                ~~~^^\n  File \"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-035445__x2713fa/work/Advanced-Dungeons-Near-Misses-Advanced-Dungeons-and-Dragons-gpt-6.1-sol-max-20261106-035445/tests/browser.py\", line 33, in run\n    check(page.evaluate('document.querySelector(\"meta[name=\\\"hub:session-players\\\"]\").content') == '1-2', 'Declared two-player seats')\n          ~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/sync_api/_generated.py\", line 9413, in evaluate\n    self._sync(\n    ~~~~~~~~~~^\n        self._impl_obj.evaluate(expression=expression, arg=mapping.to_impl(arg))\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n    )\n    ^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_sync_base.py\", line 115, in _sync\n    return task.result()\n           ~~~~~~~~~~~^^\n  File \"/home/micha/.local/share/pipx/venvs/playwright/lib/python3.14/site-packages/playwright/_impl/_page.py\", line 474, in evaluate\n    return await self._main_frame.evaluate(expression, arg)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^