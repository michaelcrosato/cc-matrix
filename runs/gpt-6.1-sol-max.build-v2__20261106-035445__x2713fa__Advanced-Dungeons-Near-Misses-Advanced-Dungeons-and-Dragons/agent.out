{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser_probe.py <<'PY'\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot = Path(__file__).resolve().parents[1]\nidentity = json.loads((root / 'identity.json').read_text())\nurl = (root.parent / identity['html']).as_uri()\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n page=browser.new_page(viewport={'width':1280,'height':720})\n errors=[]\n page.on('pageerror',lambda error:errors.append(str(error)))\n page.goto(url)\n page.wait_for_function('window.__NM?.ready')\n page.screenshot(path=str(root/'tests/title.png'))\n print(json.dumps({'errors':errors,'game':page.evaluate('window.__NM.game.errors'),'screen':page.evaluate('window.__NM.ui.shell.screen'),'buttons':page.get_by_role('button').all_text_contents()}))\n page.get_by_role('button',name='New expedition',exact=True).click()\n page.wait_for_timeout(400)\n print(json.dumps({'screen':page.evaluate('window.__NM.ui.shell.screen'),'errors':page.evaluate('window.__NM.game.errors')}))\n page.get_by_role('button',name='Chalk Burrows',exact=True).click()\n page.wait_for_timeout(500)\n page.screenshot(path=str(root/'tests/cave.png'))\n print(json.dumps({'errors':errors,'engine':page.evaluate('window.__NM.game.errors'),'state':page.evaluate('({mode:__NM.sim.state.mode,p:__NM.sim.state.players[0],s:__NM.ui.shell.screen})')}))\n browser.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/browser_probe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
