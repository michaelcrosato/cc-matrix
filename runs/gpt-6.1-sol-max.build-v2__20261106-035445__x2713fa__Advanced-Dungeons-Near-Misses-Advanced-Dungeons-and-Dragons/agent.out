3, \"maxHp\": 3, \"state\": \"idle\", \"stateTime\": 0.8333333333333328, \"invuln\": 1.1666666666666696, \"draw\": 0, \"recovery\": 0, \"focus\": false, \"downed\": false, \"downTime\": 0, \"revive\": 0, \"dodge\": 0, \"dodgeLeft\": 0, \"walk\": 0, \"stepTimer\": 0, \"vx\": 0, \"vy\": 0, \"hurt\": 0}, \"s\": null}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"cat >> src/style.css <<'EOF'\n.esh .esh-ttl>div{max-height:100%;overflow-y:auto;scrollbar-width:thin;padding-right:5px}.esh .esh-ttl h1{font-size:38px;margin:10px 0 14px}.esh .esh-ttl .esh-btns{display:grid;grid-template-columns:1fr 1fr;gap:6px}.esh .esh-ttl .esh-btns button:nth-child(-n+2){grid-column:1/-1}.esh .esh-ttl .esh-btns button{font-size:11px;padding:9px 12px}.esh .esh-ttl .esh-sub{font-size:16px}.esh .esh-ttl p{font-size:12px}.esh .esh-ttl .esh-tags{margin:12px 0 6px}\nEOF\npython3 - <<'PY'\np='src/sim/simulation.js'\ns=open(p).read().replace(\\\"r:e.type.startsWith('guardian')?13:e.type==='drake'?9:5\\\", \\\"r:def.radius||5\\\")\ns=s.replace(\\\"      for(const a of s.arrowLit)if(a.until>s.time)visible.add(a.cell);\\\", \\\"      for(const index of [...visible]){const x=index%l.w,y=Math.floor(index/l.w);if(\"'!l.walkCell(x,y))continue;for(const [a,b]of [[x+1,y],[x-1,y],[x,y+1],[x,y-1]])if(a>=0&&b>=0&&a<l.w&&b<l.h&&!l.walkCell(a,b)){visible.add(b*l.w+a);explored.add(b*l.w+a);}}'\"\\\\n      for(const a of s.arrowLit)if(a.until>s.time)visible.add(a.cell);\\\")\nopen(p,'w').write(s)\nPY\nnode scripts/build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
