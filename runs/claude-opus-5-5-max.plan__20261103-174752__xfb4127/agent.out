rge/rapier3d-simd-compat\": \"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-simd-compat@0.19.3/rapier.mjs\" } }</script>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden} #stage{position:relative;width:100%;height:100%}\n#view{position:absolute;left:0;top:0;pointer-events:none;z-index:0} #screen{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;z-index:1;background:transparent}</style>\n</head><body><div id=\"stage\"><canvas id=\"view\"></canvas><canvas id=\"screen\"></canvas></div>\n<script>${esc(e2d)}</script>\n<script type=\"module\">${esc(e3d)}</script>\n<script type=\"module\">${esc(game)}</script>\n</body></html>`;\nwriteFileSync('spike.html', html);\nconsole.log('spike.html', html.length);\nEOF\nnode build.mjs $R\ncat > run.mjs <<'EOF'\nimport { chromium } from 'playwright';\nimport { pathToFileURL } from 'node:url';\nconst backend = process.argv[2] || 'webgl';\nconst browser = await chromium.launch();\nconst page = await browser.newPage({ viewport: { width: 960, height: 540 } });\nconst errs = [];\npage.on('pageerror', e => errs.push('pageerror: ' + e.message));\npage.on('console', m => { if (m.type() === 'error') errs.push('console: ' + m.text()); });\nconst url = pathToFileURL(process.cwd() + '/spike.html').href + (backend === 'webgl' ? '?backend=webgl' : '');\nawait page.goto(url);\ntry { await page.waitForFunction(() => window.__spike && window.__spike.frames > 30, null, { timeout: 60000 }); } catch (e) { errs.push('timeout: ' + e.message.split('\\n')[0]); }\nconst st = await page.evaluate(() => ({ ...window.__spike, backend: My3D2dge.World3D && My3D2dge.World3D.backend, gameErrors: (My3D2dge.current && My3D2dge.current.errors || []).map(e => e.message) }));\nawait page.screenshot({ path: 'spike-' + backend + '.png' });\nconsole.log(JSON.stringify(st));\nconsole.log(errs.length ? errs.slice(0, 8).join('\\n') : 'no page errors');\nawait browser.close();\nEOF\nexport TMPDIR=$S/tmp\ntimeout 120 node run.mjs w