 - cx, hero.y - cy)), fov: 55 }; }|\" build.mjs\ngrep -c \"const cx = hero.x - 40\" build.mjs\nnode build.mjs $R >/dev/null\nexport TMPDIR=$S/tmp\ntimeout 150 node run.mjs default 2>&1 | tail -4","description":"Rerun the spike with an in-room camera on the default backend"}}}
