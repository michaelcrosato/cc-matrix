st.phase = f.prizeCar ? 'reveal' : ev.ending ? 'ending' : 'done'; App.mix?.sfx?.('confirm'); if (st.phase === 'reveal') { st.rv = 0; for (const pe of Object.values(sc.people)) pe.root.visible = false; sc.showroom.show(f.prizeCar, { parts: [], settings: {} }); sc.showroom.spin = 0.15; sc.person('fenn', sc.showroom.ox + 5, 3, -2.2, true, 'DealerPresent'); st.cover = new THREE.Mesh(new THREE.BoxGeometry(6, 2.2, 3), new THREE.MeshBasicMaterial({ color: 0x1a1c2c })); st.cover.position.set(sc.showroom.ox, 1.4, 0); ctx.scene.add(st.cover); st.lights = sc.showroom.lights; st.lights.forEach((l) => { l.intensity = 0.1; }); sc.say('Please. Do not look yet.', 'fenn'); } }\n    ui.prompts([['confirm', 'CONTINUE']]); return; }\n  if (st.phase === 'reveal') { const lit = Math.min(3, Math.floor(T / 1.2)); st.lights.forEach((l, i) => { l.intensity = i < lit ? 7 : 0.1; }); if (lit !== st.lit && lit > 0) { st.lit = lit; App.mix?.sfx?.('reveal'); } if (T > 4 && !st.slid) { st.slid = true; App.mix?.sfx?.('finish'); sc.say('The ' + CAR_INFO[f.prizeCar].name + '. It is yours. It is simply not for sale.', 'fenn'); ctx.tweens.to(st.cover.position, { y: 6 }, { duration: 1.4, ease: 'inOutQuad' }); ctx.particles.burst('confetti', new THREE.Vector3(sc.showroom.ox, 4, 0), { count: 50 }); } if (st.slid) { ui.center(40, 'PRIZE CAR', { scale: 3, color: 'sand' }); ui.center(68, CAR_INFO[f.prizeCar].name, { color: 'white' }); ui.item('ok', ui.W / 2 - 40, ui.H - 50, 80, 16); ui.button('ok', ui.W / 2 - 40, ui.H - 50, 80, 16, 'CONTINUE'); if (ui.press) { st.cover?.removeFromParent(); sc.showroom.lights.forEach((l) => { l.intensity = 6; }); st.t = 0; st.phase = ev.ending ? 'ending' : 'done'; if (st.phase === 'ending') for (const pe of Object.values(sc.people)) pe.root.visible = false; } } else { ui.item('ok', 0, 0, 1, 1); } ui.prompts([['confirm', 'CONTINUE']]); return; }\n  if (st.phase === 'ending') { sc.hidePeople(); sc.showroom.spin = 0.1; ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); const lines = ['THE HAL