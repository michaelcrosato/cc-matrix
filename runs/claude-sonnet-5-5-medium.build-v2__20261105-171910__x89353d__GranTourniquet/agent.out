(w - 1), v = Math.sin(Math.min(1, x / 0.85) * 1.45) * (1 - Math.max(0, x - 0.85) * 1.6); ui.hud.rect(x0 + i, Math.round(y0 - v * 50), 1, 2, 'mist'); ui.hud.rect(x0 + i, Math.round(y0 - v * 62), 1, 2, st.t > 2 ? 'lime' : 'night'); } ui.text(x0, 70, '205 PS', { color: 'mist' }); ui.text(x0 + 70, 70, '>', {}); ui.text(x0 + 90, 70, '246 PS', { color: 'lime' }); badge(ui, st.t, 'TUNING STREET'); ui.item('x', 0, 0, 1, 1); attractTick(ui.dt, st.t, t.args.dur); };\nSCREENS.attractPodium = (nav, t, ctx, ui, sc) => { const st = t.s; st.t = (st.t ?? 0) + ui.dt; sc.camShow({ r: 10, h: 3, lookY: 1.4 }); sc.showroom.set('podium'); App.music?.play('credits'); if (!st.init) { st.init = true; sc.hidePeople(); for (const [k, role] of [[-3, 'arai'], [0, 'dell'], [3, 'fenn']]) { const pe = sc.people[role]; pe.root.visible = true; pe.root.position.set(sc.showroom.ox + k, 1.0 + (k === 0 ? 0.6 : 0), 3); pe.root.rotation.y = Math.PI; pe.play(k === 0 ? 'PodiumCheer' : 'PodiumBow', { once: true }); } sc.showroom.show('type9', defaultInstall()); ctx.particles.burst('confetti', new THREE.Vector3(sc.showroom.ox, 4, 0), { count: 60 }); App.mix?.sfx?.('finish'); sc.say('The Type 9. It is not for sale. It is simply yours.', 'fenn'); } if (st.t > 2 && Math.floor(st.t) !== st.c) { st.c = Math.floor(st.t); ctx.particles.burst('confetti', new THREE.Vector3(sc.showroom.ox + (st.c % 2 ? 3 : -3), 5, 0), { count: 20 }); } ui.center(30, 'PRIZE CAR', { scale: 3, color: 'sand' }); ui.center(58, CAR_INFO.type9.name, { color: 'white' }); badge(ui, st.t, 'REWARDS'); ui.item('x', 0, 0, 1, 1); attractTick(ui.dt, st.t, t.args.dur); };\nSCREENS.attractCredits = (nav, t, ctx, ui, sc) => { const st = t.s; st.t = (st.t ?? 0) + ui.dt; sc.hidePeople(); sc.showroom.show(null); sc.camTitle(); sc.camMapMode(); ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); ui.center(60, TITLE, { scale: 3, color: 'sand' }); ui.center(92, 'INSPIRED BY GRAN TURISMO 3: A-SPEC', { color: 'mist' }); ui.center(130, 'PRESS ANY BUTTON', { scale: 2, color: Math.floor(st.t * 3) % 2 ? 'white' : 'sand' }); ui.item('x', 0, 0, 1, 1); attractTick(ui.dt, st.t, t.args.dur); };\nEOF\npython3 - <<'EOF'\np='src/game/scenes/race.js'; t=open(p).read()\n# attract hooks: camera schedule + end timer\nt=t.replace(\"import { makeTrialSim\",\"import { attractTick } from '../attract/director.js';\\nimport { Director } from '../render/director.js';\\nimport { makeTrialSim\")\nt=t.replace(\"    this.latch = { up: false\",\"    this.attractT = 0; if (this.mode === 'attract') { this.dir = new Director(sim.tr, 5); this.tvCamOn = false; this.hideHud = false; }\\n    this.latch = { up: false\")\nt=t.replace(\"  updateCamera(ctx, dt, c) {\",\"\"\"  updateCamera(ctx, dt, c) {\n    if (this.mode === 'attract' || (this.over && this.mode === 'race' && this.endT > 0.8)) { const cams = this.cfg.cams; let m = 0; if (cams) for (const [t0, mm] of cams) if (this.attractT >= t0) m = mm; if (this.over) m = 'tv'; if (m === 'tv') { const f = this.focus.c; this.dir ??= new Director(this.sim.tr, 5); this.dir.update(dt, { x: f.x, y: f.y, z: f.z, vx: f.vx, vz: f.vz, s: f.loc.s }, ctx.camera.camera, this.sim.cars.some((o) => o !== this.focus && Math.hypot(o.c.x - f.x, o.c.z - f.z) < 14)); return; } this.cam.mode = m; }\"\"\")\nt=t.replace(\"  handleFlow(ctx, ui, dt) {\\n    const A = App.actions, L = this.latch; if (this.mode === 'attract') return;\",\"  handleFlow(ctx, ui, dt) {\\n    const A = App.actions, L = this.latch; if (this.mode === 'attract' || this.cfg.attract) { this.attractT += dt; attractTick(dt, this.attractT, this.cfg.attractDur ?? 15); return; }\\n    const fp = this.focus.pitState; if (fp && fp.phase === 'service' && L.back) fp.skipTyres = true;\")\nopen(p,'w').write(t)\nEOF\nnode --check src/game/scenes/race.js && node --check src/game/attract/director.js && echo ok"}}}
