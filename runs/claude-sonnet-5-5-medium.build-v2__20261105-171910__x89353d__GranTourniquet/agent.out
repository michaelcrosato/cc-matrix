 0.08; car.root.position.y = 0.3 + s; car.place({ x: 0, y: 0.3 + s, z: 0, yaw: spin, delta: 0, u: 0, ax: 0, ay: 0, vy: 0 }, { dt }); } props.wash.userData.brushes?.forEach((b) => { b.rotation.y = t * 6; }); }, lights };\n}\nEOF\nnode --check src/game/render/stages.js && echo ok"}}}
