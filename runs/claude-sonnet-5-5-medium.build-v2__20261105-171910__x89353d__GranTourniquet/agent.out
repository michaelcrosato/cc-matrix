hile (rs.sim.state !== 'over' && n < 60 * 400) { e.step(60); n += 60; } t.check(rs.sim.state === 'over', 'race ends'); t.check(e.errors.length === 0, 'race renders without errors: ' + e.errors[0]); e.step(200); t.check(!!rs.ov && rs.ov.kind === 'results', 'results overlay opens'); t.check(rs.outcome.rows.length === 3 && rs.outcome.rows[0].pos === 1, 'results table');\n  const end = e.fingerprint(); const rec = e.recording(); await e.replay(rec, () => e.loadGame(new RaceScene(cfg))); t.check(typeof e.fingerprint() === 'string', 'engine replay runs');\n  const { ReplayScene } = await import('../../src/game/scenes/replay.js'); App.lastRace = { cfg, record: rs.sim.record, params: rs.sim.cars.map((c) => ({ carId: c.carId, name: c.name, spoiler: 0 })), track: 'proving', tr: rs.sim.tr, player: 0, laps: 1 }; await e.loadGame(new ReplayScene({ source: 'last' })); e.step(120); t.check(e.errors.length === 0 && st().name === 'replay', 'replay plays: ' + e.errors[0]);\n};\nEOF\nnode tools/test.mjs headless 2>&1 | tail -12","is_backgrounded":false,"task_type":"local_bash","uuid":"062213a3-d561-4927-8953-924597218c70","session_id":"83ee8bb7-9f1f-4db7-994e-0a6a2ece78a9"}
