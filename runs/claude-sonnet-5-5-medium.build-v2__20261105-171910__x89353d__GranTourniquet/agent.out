> ({ mode: 'attract', attract: true, track: 'saltline', title: 'SALTLINE SPEEDBOWL', sim: { laps: 3, contact: true, start: 'flying', startS: 100, startSpeed: 50, seed: 4, field: [ai('a0', 'heck', 0.97, 'ARAKI', 'red'), ai('a1', 'libeccio', 0.97, 'BELL', 'blue'), ai('a2', 'longhorn', 0.96, 'COSTA', 'orange')] } }) }),\n  C('menu', { screen: 'attractPodium', dur: 8 }), C('menu', { screen: 'attractCredits', dur: 4 }),\n];\nconst A = () => App.attract;\nApp.startAttract = (from) => { if (App.hubActive || App.attract) return; const top = from?.nav?.top?.type ?? 'title'; App.attract = { i: 0, back: top === 'map' ? 'map' : 'title', t: 0 }; App.actions.idle = 0; runClip(0); };\nApp.stopAttract = () => { if (!App.attract) return; const b = App.attract.back; App.attract = null; App.actions.idle = 0; App.mix?.clear?.(); goMenu(b, {}); };\nApp.attractNext = () => { if (!App.attract) return; App.attract.i = (App.attract.i + 1) % CLIPS.length; runClip(App.attract.i); };\nfunction runClip(i) { const c = CLIPS[i]; App.attract.clip = c; App.attract.t = 0; App.attract.lastIdle = 0; if (c.kind === 'menu') goMenu(c.screen, { attract: true, dur: c.dur }); else goRace({ ...c.cfg(), attractDur: c.dur, cams: c.cams }); }\n// Called each frame by the clip's scene: returns true when it should end (time up, or any input).\nexport function attractTick(dt, t, dur) { const a = App.actions, at = App.attract; if (!at) return false; if (a.idle < (at.lastIdle ?? 0) - 0.0001 && t > 0.4) { App.stopAttract(); return true; } at.lastIdle = a.idle; if (t >= dur) { App.attractNext(); return true; } return false; }\nconst badge = (ui, t, label) => { ui.text(8, 8, 'DEMO', { scale: 2, color: 'sand' }); ui.text(ui.W - 8 - ui.width(label), 8, label, { color: 'white' }); ui.center(ui.H - 14, 'PRESS ANY BUTTON', { color: 'sand' }); };\nSCREENS.attractCard = (nav, t, ctx, ui, sc) => { const st = t.s; st.t = (st.t ?? 0) + ui.dt; sc.camTitle(); sc.camMapMode(); sc.hidePeople(); App.music?.play('title'); ui.center(70