{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,295p' game.js && sed -n '105,130p' audio.js && sed -n '2520,2570p' game.js && sed -n '815,845p' visual.js && sed -n '210,280p' tests.py\"","aggregated_output":"\tif (input.last === mode) return;\n\tinput.last = mode;\n\tS.touch = mode === \"touch\";\n\tdocument.body.classList.toggle(\"touch-mode\", S.touch);\n\tupdatePrompts();\n}\nfunction activity(mode) {\n\tlastActivity = performance.now();\n\tif (mode) setInputMode(mode);\n\tif (S.attract) {\n\t\tS.attract = false;\n\t\tresetRun();\n\t\tshowTitle();\n\t\treturn true;\n\t}\n\treturn false;\n}\nfunction promptFor(which) {\n\tconst ps = settings.glyphs === \"ps\";\n\tconst p = {\n\t\tfire: \"R2\",\n\t\ttractor: \"L2\",\n\t\tpulse: \"L1\",\n\t\tboost: \"R1\",\n\t\tchart: ps ? \"△\" : \"Y\",\n\t\tconfirm: ps ? \"✕\" : \"A\",\n\t\tback: ps ? \"○\" : \"B\",\n\t\tpause: ps ? \"OPTIONS\" : \"MENU\",\n\t\tmove: \"L\",\n\t\taim: \"R\",\n\t};\n\tconst k = {\n\t\tfire: \"CLICK / SPACE\",\n\t\ttractor: \"E / RMB\",\n\t\tpulse: \"Q\",\n\t\tboost: \"SHIFT\",\n\t}\n\thit() {\n\t\tthis.events.hit++;\n\t\tthis.tone(130, 0.13, \"triangle\", 0.2, 0.3);\n\t\tthis.noiseBurst(0.11, 0.12, 1800);\n\t}\n\texplosion(big = false) {\n\t\tthis.noiseBurst(big ? 0.9 : 0.35, big ? 0.6 : 0.3, big ? 1800 : 2400);\n\t\tthis.tone(big ? 65 : 110, big ? 0.8 : 0.3, \"sine\", 0.35, 0.25);\n\t}\n\tpickup() {\n\t\t[440, 554.37, 659.25, 880].forEach((f, i) =>\n\t\t\tthis.tone(\n\t\t\t\tf,\n\t\t\t\t0.22,\n\t\t\t\t\"sine\",\n\t\t\t\t0.16,\n\t\t\t\t1,\n\t\t\t\tthis.ctx ? this.ctx.currentTime + i * 0.07 : 0,\n\t\t\t),\n\t\t);\n\t}\n\tpulse() {\n\t\tthis.tone(65, 0.8, \"sawtooth\", 0.15, 12);\n\t\tthis.noiseBurst(0.6, 0.24, 4000);\n\t}\n\t\t\tconst e = this.effects[i];\n\t\t\te.life -= dt;\n\t\t\tconst p = 1 - e.life / e.max;\n\t\t\te.mesh.scale.setScalar(0.5 + p * e.size);\n\t\t\te.mesh.material.opacity = Math.max(0, (1 - p) * 0.8);\n\t\t\tif (e.kind === \"pulse\") e.mesh.position.z -= dt * 100;\n\t\t\tif (e.life <= 0) {\n\t\t\t\tthis.actors.remove(e.mesh);\n\t\t\t\te.mesh.geometry.dispose();\n\t\t\t\te.mesh.material.dispose();\n\t\t\t\tthis.effects.splice(i, 1);\n\t\t\t}\n\t\t}\n\t\tconst p = state.player;\n\t\tthis.camera.position.lerp(\n\t\t\tnew T.Vector3(playing ? p.x : 0, playing ? p.y + 1 : 0, 12),\n\t\t\t1 - Math.exp(-dt * 12),\n\t\t);\n\t\tthis.camera.rotation.set(\n\t\t\t(playing && state.motion !== false ? state.aim.y : 0) * 0.018,\n\t\t\t(playing && state.motion !== false ? -state.aim.x : 0) * 0.018,\n\t\t\tplaying ? -state.moveX * 0.027 : 0,\n\t\t);\n\t\tthis.camera.fov = T.MathUtils.lerp(\n\t\t\tthis.camera.fov,\n\t\t\tplaying && state.boost ? 72 : 64,\n\t\t\tdt * 4,\n\t\t);\n\t\tthis.camera.updateProjectionMatrix();\n\t\tif (this.tractor) this.tractor.visible = !!state.tractoring;\n\t\tif (!this.recovering) this.renderer.render(this.scene, this.camera);\n\ndef direct_link_test(browser, url):\n    c1, p1 = open_game(browser, url)\n    c2, p2 = open_game(browser, url)\n    offer = p1.evaluate('window.__solar.link.host()')\n    answer = p2.evaluate('(s)=>window.__solar.link.join(s)', offer)\n    p1.evaluate('(s)=>window.__solar.link.accept(s)', answer)\n    p1.wait_for_function('window.__solar.snapshot().connected', timeout=20000)\n    p2.wait_for_function('window.__solar.snapshot().connected', timeout=20000)\n    check('standalone peer codes establish WebRTC', state(p1)['connected'] and state(p2)['connected'])\n    act(p1, 'net-launch')\n    p2.wait_for_function('window.__solar.snapshot().screen===\"playing\"', timeout=5000)\n    check('standalone launch synchronizes both flights', state(p1)['screen'] == 'playing' and state(p2)['screen'] == 'playing')\n    p1.wait_for_function('window.__solar.snapshot().wingCount===1', timeout=5000)\n    p2.wait_for_function('window.__solar.snapshot().wingCount===1', timeout=5000)\n    check('both standalone ships receive wing snapshots', state(p1)['wingCount'] == 1 and state(p2)['wingCount'] == 1)\n    p1.evaluate('window.__solar.link.close()')\n    c1.close()\n    c2.close()\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef hub_tests(browser, port):\n    for players, scenario, impair in [(2, 'standard', False), (4, 'standard', True), (4, 'host-leave', True)]:\n        context = browser.new_context(viewport={'width': 1280, 'height': 720})\n        page = context.new_page()\n        params = {'game': '../' + GAME.name + '?renderer=webgl', 'players': players, 'scenario': scenario, 'auto': 1, 'limit': 45}\n        if impair:\n            params.update(latency=150, jitter=50, loss=5)\n        page.goto(f'http://127.0.0.1:{port}/{HERE.name}/harness.html?' + urlencode(params), wait_until='load', timeout=60000)\n        page.wait_for_function('document.body.dataset.complete===\"true\"', timeout=100000)\n        result = page.evaluate('window.__hubCheck')\n        check(f'official AI Hub harness / {players} seats / {scenario}', result['pass'], [c for c in result['checks'] if not c['pass']])\n        (ARTIFACTS / f'hub-{players}-{scenario}.json').write_text(json.dumps(result, indent=2))\n        context.close()\n\n\ndef main():\n    interview = json.loads((ROOT / 'exit-interview.json').read_text())\n    check('exit interview parses with required feedback counts', len(interview['testingFeedback']) == 4 and len(interview['engineFeedback']) == 6 and len(interview['promptFeedback']) == 4 and interview['sourceInformation']['usage'] == 'added on import')\n    html = GAME.read_text()\n    client = (HERE / 'hub-session.js').read_text()\n    check('unmodified Hub client is embedded before game code', client.replace('</script', '<\\\\/script') in html and html.index(client[:90]) < html.index('hub:session-players'))\n    check('single HTML includes physics and has no asset fetch requirements', len(html) > 2500000 and '<script src=' not in html and '<link rel=\"stylesheet\"' not in html)\n    handler = functools.partial(QuietHandler, directory=str(ROOT))\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    port = server.server_address[1]\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--disable-vulkan-surface', '--no-sandbox'])\n            try:\n                # Check the required path by state and GPU readback; screenshots\n                # of WebGPU canvases can be blank in headless Chromium.\n                try:\n                    context, page = open_game(browser, GAME.as_uri() + '?test=1')\n                    pixels = page.evaluate('window.__solar.renderPixels()')\n                    check('WebGPU primary path renders real pixels', state(page)['renderer'] == 'WebGPU' and pixels['max'] > 150 and pixels['bright'] > 200, pixels)\n                    page.evaluate('window.__solar.loseGraphicsDevice()')\n                    page.wait_for_function('window.__solar.snapshot().renderer===\"WebGL2\"',timeout=15000)\n                    recovered=page.evaluate('window.__solar.renderPixels()')\n                    check('GPU device loss recovers to a populated fallback',recovered['bright']>200,recovered)\n                    context.close()\n                except Exception as e:\n                    check('WebGPU primary path renders real pixels', False, str(e).splitlines()[0])\n                url = GAME.as_uri() + '?test=1&renderer=webgl'\n","exit_code":0,"status":"completed"}}
