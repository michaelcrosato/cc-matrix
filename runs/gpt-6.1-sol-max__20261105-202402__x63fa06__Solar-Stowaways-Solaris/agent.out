{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"cat build.mjs && sed -n '450,480p' tests.py\"","aggregated_output":"import { readFile, writeFile } from \"node:fs/promises\";\nimport path from \"node:path\";\nimport { build } from \"esbuild\";\n\nconst dir = path.dirname(new URL(import.meta.url).pathname);\nconst name = path.basename(dir);\nawait build({\n\tentryPoints: [path.join(dir, \"game.js\")],\n\tbundle: true,\n\tformat: \"iife\",\n\ttarget: \"es2022\",\n\toutfile: path.join(dir, \"bundle.js\"),\n\tminify: true,\n\tlegalComments: \"none\",\n\tlogLevel: \"silent\",\n});\nlet html = await readFile(path.join(dir, \"template.html\"), \"utf8\");\nconst [hub, css, js, credits] = await Promise.all(\n\t[\"hub-session.js\", \"style.css\", \"bundle.js\", \"../exit-interview.json\"].map(\n\t\t(f) => readFile(path.join(dir, f), \"utf8\"),\n\t),\n);\nconst licenses = await readFile(\n\tpath.join(dir, \"THIRD-PARTY-LICENSES.txt\"),\n\t\"utf8\",\n);\nconst safe = (s) => s.replace(/<\\/script/gi, \"<\\\\/script\");\nhtml = html\n\t.replace(\"<!--HUB_CLIENT-->\", \"<script>\" + safe(hub) + \"</script>\")\n\t.replace(\"/*STYLE*/\", css)\n\t.replace(\"/*CREDITS*/\", \"window.GAME_CREDITS=\" + safe(credits) + \";\")\n\t.replace(\"/*GAME*/\", safe(js));\nhtml = html.replace(\n\t\"</body>\",\n\t'<script type=\"text/plain\" id=\"thirdPartyLicenses\">' +\n\t\tsafe(licenses) +\n\t\t\"</script>\\n</body>\",\n);\nawait writeFile(path.join(dir, \"..\", name + \".html\"), html);\nconsole.log(\n\t`Built ${name}.html (${(Buffer.byteLength(html) / 1048576).toFixed(2)} MB)`,\n);\n        (4, \"standard\", True),\n        (4, \"host-leave\", True),\n    ]:\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 720})\n        page = context.new_page()\n        params = {\n            \"game\": \"../\" + GAME.name + \"?renderer=webgl\",\n            \"players\": players,\n            \"scenario\": scenario,\n            \"auto\": 1,\n            \"limit\": 45,\n        }\n        if impair:\n            params.update(latency=150, jitter=50, loss=5)\n        page.goto(\n            f\"http://127.0.0.1:{port}/{HERE.name}/harness.html?\" + urlencode(params),\n            wait_until=\"load\",\n            timeout=60000,\n        )\n        page.wait_for_function(\n            'document.body.dataset.complete===\"true\"', timeout=100000\n        )\n        result = page.evaluate(\"window.__hubCheck\")\n        frames = [f for f in page.frames if f != page.main_frame]\n        identity = [\n            f.evaluate(\n                \"({url:location.href,title:document.title,name:window.GAME_CREDITS?.aiHub?.name})\"\n            )\n            for f in frames\n        ]\n        check(\n","exit_code":0,"status":"completed"}}
