lations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\nharness.html:6:<title>AI Hub Session Harness</title>\nharness.html:51:  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\nharness.html:212:    frame.title = p.name;\nharness.html:249:    frame.src = gameUrl(game, { tag: metas?.mode, seed });\nharness.html:319:  cell.frame.remove();\nharness.html:538:      li.title = c.detail;\n{\n  \"done\": true,\n  \"pass\": true,\n  \"game\": \"../Solar-Stowaways-Solaris-gpt-6.1-sol-max-20261105-202402.html?renderer=webgl\",\n  \"players\": 2,\n  \"scenario\": \"standard\",\n  \"checks\": [\n    {\n      \"name\": \"head metas\",\n      \"pass\": true,\n      \"detail\": \"hub:session=1 mode=ghost\"\n    },\n    {\n      \"name\": \"hub:session-players is a range within 1\\u20134\",\n      \"pass\": true,\n      \"detail\": \"hub:session-players=1-4\"\n    },\n    {\n      \"name\": \"hub:session-minute