{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'onFinish|finish\\\\(|onStart|startDirect' Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/network.js && tail -25 Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/render.js\"","aggregated_output":"290:\t\t\tthis.emit(\"onStart\", {\n305:\t\t\t\t\tthis.finish(this.latest?.score || this.latest?.scores || [0, 0]);\n319:\t\t\t\t\tthis.finish(this.latest?.score || this.latest?.scores || [0, 0]);\n459:\t\t\t\t\tthis.startDirect(this.directConfig);\n496:\t\t\t\tthis.emit(\"onStart\", { ...this.config, humans: 2, startClock: true });\n514:\t\t\t\tthis.emit(\"onStart\", { ...this.config, humans: 2, startClock: true });\n532:\t\t\t\t\t\"onFinish\",\n577:\t\tfinish(scores = [0, 0]) {\n598:\t\t\t\troot.AIHub.finish({\n603:\t\t\tthis.emit(\"onFinish\", scores);\n834:\t\tstartDirect(config = {}) {\n drawCar(r,c,index=0,ghost=false){if(!Number.isFinite(c.x+c.y))return;const angle=c.angle||0,profile=Math.max(0,Math.min(4,c.profile??index)),crashed=!!c.crashed;const bob=this.game.reduceMotion?0:crashed?Math.abs(Math.sin(this.time*14))*2:Math.sin(this.time*8+index)*Math.min(1,Math.abs(c.speed||0)/130)*.25;const alpha=ghost?.32:!this.game.reduceMotion&&c.immunity>0&&Math.floor(this.time*9)%2?.62:1;\n  const lean=Math.max(-1.3,Math.min(1.3,(c.slide||0)/25));\n  r.shadow(c.x,c.y,9,.35);\n  for(const side of [-1,1])for(const front of [-1,1]){const localx=front*7,localy=side*7,x=c.x+Math.cos(angle)*localx-Math.sin(angle)*localy,y=c.y+Math.sin(angle)*localx+Math.cos(angle)*localy;const steering=front>0?Math.max(-.45,Math.min(.45,c.steer??this.carMotion.get(c)?.steer??0))*.5:0;r.shape('happyWheel',x,y,0,{facing:angle+steering,charView:false,alpha,shadow:false});if(Math.abs(c.speed||0)>40&&Math.floor(this.time*Math.abs(c.speed)*.05)%2){const a=r.w(x,y,4.7),b=r.w(x+Math.cos(angle)*1.2,y+Math.sin(angle)*1.2,4.7);px.line(r.ctx,a[0],a[1],b[0],b[1],'#66757c');}}\n  r.shape('happyCar'+profile,c.x-Math.sin(angle)*lean,c.y+Math.cos(angle)*lean,1+bob,{facing:angle,charView:false,alpha,shadow:false,xray:true,flash:crashed&&!this.game.reduceMotion});\n  if(crashed){for(let j=0;j<4;j++){const a=this.time*3+j*TAU/4,p=r.w(c.x+Math.cos(a)*13,c.y+Math.sin(a)*10,15);px.line(r.ctx,p[0]-2,p[1],p[0]+2,p[1],'#ffe49c');px.line(r.ctx,p[0],p[1]-2,p[0],p[1]+2,'#ffe49c');}}\n  if(!ghost&&((this.game.__happyMode==='duel')||index>0))r.textAt(c.x,c.y,21,index===0?'1':'2',index===0?'#fff2c4':'#a3dcf4',{outline:'#253d48',scale:1});\n }\n draw(r,sim,o={}){this.ground(r);for(const s of this.skids){const a=r.w(s.a.x,s.a.y),b=r.w(s.b.x,s.b.y);px.line(r.ctx,a[0],a[1],b[0],b[1],'#53605e',2);}for(const p of this.dust)if(r.visible(p.x,p.y))r.groundDisc(p.x,p.y,p.r,p.color,p.t/p.max*.6);\n  const course=this.world.courses[sim.courseIndex||0];\n  // Direction arrows combine shape and colour; they survive colour-vision differences.\n  if(sim.mode!=='free'&&!o.menu){for(let d=32;d<course.length;d+=105){const p=course.path.at(d);if(!r.visible(p.x,p.y,0,15,15,15))continue;const a=p.angle,pts=[[6,0],[-4,-4],[-1,0],[-4,4]].map(([x,y])=>r.w(p.x+Math.cos(a)*x-Math.sin(a)*y,p.y+Math.sin(a)*x+Math.cos(a)*y));px.poly(r.ctx,pts,'#ddc77e');}}\n  const navigation=o.navigation||sim.navigation;\n  if(sim.mode==='free'&&navigation?.samples){for(let i=0;i<navigation.samples.length;i+=4){const p=navigation.samples[i];if(!r.visible(p.x,p.y,0,8,8,8))continue;r.groundDisc(p.x,p.y,2.3,'#f5dda1',.9);}const goal=navigation.destination||navigation.samples.at(-1);if(goal)r.marker(goal.x,goal.y,13,{label:'NEXT PADDOCK',color:'#f3d77c',offscreen:'arrow'});}\n  for(const p of this.world.props){if(!r.visible(p.x,p.y,0,80,120,80))continue;const id=shapeKinds[p.kind]||p.kind;r.shape(id,p.x,p.y,0,{facing:p.facing??Math.PI/2,scale:p.scale||1,params:{h:p.h||36,seed:p.seed||1},shadow:true});if(p.kind==='routeSign'){const col=this.world.courses[p.courseIndex].color;r.textAt(p.x,p.y,34,''+(p.courseIndex+1),col,{scale:1,outline:'#30494b'});}if(p.kind==='windmill'){const z=47*(p.scale||1),center=r.w(p.x,p.y+17,z);for(let j=0;j<4;j++){const a=this.time*.5+j*TAU/4,rr=30*r.ppu;px.line(r.ctx,center[0],center[1],center[0]+Math.cos(a)*rr,center[1]+Math.sin(a)*rr,'#e7d9aa',3);}}}\n  if(o.ghost)this.drawCar(r,o.ghost,0,true);\n  (sim.cars||[]).forEach((c,i)=>this.drawCar(r,c,i));\n  if(!o.menu){const next=sim.cars?.[0]?.route?.gate??sim.cars?.[0]?.route?.next??sim.gateIndex??1,g=course.gates[next%course.gates.length];if(g&&sim.mode!=='free'){r.marker(g.x,g.y,8,{label:'GATE '+(next||12),color:'#f7d77b',offscreen:'arrow'});if(r.visible(g.x,g.y,0,100,100,100)){for(const side of [-1,1]){const x=g.x-Math.sin(g.angle)*course.width*side,y=g.y+Math.cos(g.angle)*course.width*side;r.shape('happySign',x,y,0,{scale:.42,facing:g.angle,shadow:true});}}}}\n  // Paddock pennants: the native world supplies the title vignette and the finish celebration.\n  for(const c of this.world.courses){const p=c.gates[0],nx=-Math.sin(p.angle),ny=Math.cos(p.angle);for(const side of [-1,1]){const x=p.x+nx*(c.width+12)*side,y=p.y+ny*(c.width+12)*side;if(!r.visible(x,y,0,30,60,30))continue;r.queue(x,y,0,g=>{const a=r.w(x,y,0),b=r.w(x,y,34);px.line(g,a[0],a[1],b[0],b[1],'#e9dfbc',1);const wave=Math.sin(this.time*4+c.index)*2;px.poly(g,[b,[b[0]+13,b[1]+wave],[b[0]+12,b[1]+8+wave],[b[0],b[1]+7]],c.color);});}}\n  if(o.dev){for(const g of course.gates){const a=r.w(g.x-Math.sin(g.angle)*course.width,g.y+Math.cos(g.angle)*course.width),b=r.w(g.x+Math.sin(g.angle)*course.width,g.y-Math.cos(g.angle)*course.width);px.line(r.ctx,...a,...b,'#ffe98d',1);}for(const s of this.world.solids)if(r.visible(s.x,s.y))r.groundRing(s.x,s.y,s.r,'#ff8e7e',.7);}\n }\n}\nHappyRenderer.COLORS=COLORS;globalThis.HappyRenderer=HappyRenderer;\n})();\n","exit_code":0,"status":"completed"}}
