twork.createOffer();if(screen==='connection')\"'$('\"'#connection-output').value=connectionOut;}if(a==='create-answer'){network.stun=\"'$('\"'#stun')?.value.trim()||'';const input=\"'$('\"'#connection-input').value;connectionOut=await network.acceptOffer(input);if(screen==='connection')\"'$('\"'#connection-output').value=connectionOut;}if(a==='apply-answer')await network.acceptAnswer(\"'$('\"'#connection-input').value);if(a==='copy'){if(\"'!connectionOut)throw Error('\"'Create connection text first.');const ok=await network.copy(connectionOut);say(ok?'Complete text copied.':'Select and copy the text in the output field.');}if(a==='export'){if(\"'!connectionOut)throw Error('\"'Create connection text first.');network.exportText(connectionOut);}if(a==='paste'){try{\"'$('\"'#connection-input').value=await navigator.clipboard.readText();}catch{say('Clipboard access denied. Paste directly into the input field.');\"'$('\"'#connection-input')?.focus();}}if(a==='direct-start'){if(\"'!network.connected)throw Error('\"'Connect the second driver before starting.');network.startDirect({...setup,mode:'duel',cars:[3,4],target:10});}}\n catch(err){networkStatus=err.message;const el=\"'$('\"'#network-status');if(el)el.textContent=networkStatus;else say(networkStatus,5);}\n}\nui.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled){meaningful('\"'mouse');action(b.dataset.action);}});\nui.addEventListener('input',e=>{const el=e.target,k=el.dataset.setting;if(k){meaningful('mouse');settings[k]=el.type==='range'?Number(el.value):el.value==='true'?true:el.value==='false'?false:el.value;sim.settings=settings;audio.setVolumes(settings);store.write('settings',settings);el.parentElement.querySelector('output')?.replaceChildren(document.createTextNode(Math.round(settings[k]*100)+'%'));}if(el.dataset.tune&&\"'!network.active){sim.tuning[el.dataset.tune]=Number(el.value);sim.dev=true;el.parentElement.querySelector('\"'output').textContent=el.value;}});\nui.addEventListener('change',async e=>{if(e.target.id==='import-connection'&&e.target.files[0]){try{\"'$('\"'#connection-input').value=await network.importText(e.target.files[0]);}catch(err){say(err.message);}}});\nfunction meaningful(device){lastDevice=device;lastInputAt=performance.now();menuIdle=0;if(attracting){exitAttract();return true;}return false;}\nfunction menuMove(dx,dy){const all=focusables();if(\"'!all.length)return;let at=all.indexOf(document.activeElement);if(at<0)at=focusIndex;const cur=all[at];if(dx&&cur?.tagName==='\"'INPUT'&&cur.type==='range'){cur.stepUp(dx);cur.dispatchEvent(new Event('input',{bubbles:true}));return;}if(dx&&cur?.tagName==='SELECT'){cur.selectedIndex=clamp(cur.selectedIndex+dx,0,cur.options.length-1);cur.dispatchEvent(new Event('input',{bubbles:true}));return;}const box=cur?.getBoundingClientRect();if(\"'!box){focusAt(0);return;}let best=-1,bestCost=Infinity;for(let i=0;i<all.length;i++){if(i===at)continue;const b=all[i].getBoundingClientRect(),x=b.x+b.width/2-box.x-box.width/2,y=b.y+b.height/2-box.y-box.height/2;if(dx&&x*dx<5||dy&&y*dy<5)continue;const cost=Math.hypot(x,y)+(dx?Math.abs(y)*2:Math.abs(x)*2);if(cost<bestCost){best=i;bestCost=cost;}}if(best<0)best=(at+(dy||dx||1)+all.length)%all.length;focusAt(best);}\nconst driving=()=>active&&screen==='\"'driving'&&\"'!paused;\naddEventListener('\"'keydown',e=>{if(e.ctrlKey||e.metaKey||e.altKey)return;if(['TEXTAREA','INPUT'].includes(document.activeElement?.tagName)&&document.activeElement?.type\"'!=='\"'range'&&e.code\"'!=='\"'Escape')return;const relevant=['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','KeyW','KeyA','KeyS','KeyD','Space','Enter','Escape','KeyR','ShiftRight','KeyP','KeyM','Tab'];if(\"'!relevant.includes(e.code))return;if(meaningful('\"'keyboard')){e.preventDefault();return;}keys.add(e.code);audio.unlock();if(e.code\"'!=='\"'Tab')e.preventDefault();if(e.repeat)return;if(e.code==='KeyM'){settings.mute=\"'!settings.mute;audio.setVolumes(settings);store.write('\"'settings',settings);say(settings.mute?'Sound muted':'Sound on');return;}if(e.code==='Escape'||e.code==='KeyP'){if(screen==='driving')pause();else back();return;}if(\"'!driving()){if(e.code==='\"'ArrowUp'||e.code==='KeyW')menuMove(0,-1);if(e.code==='ArrowDown'||e.code==='KeyS')menuMove(0,1);if(e.code==='ArrowLeft'||e.code==='KeyA')menuMove(-1,0);if(e.code==='ArrowRight'||e.code==='KeyD')menuMove(1,0);if(e.code==='Enter'||e.code==='Space'){const el=document.activeElement;if(el?.dataset.action)action(el.dataset.action);}}\n});\naddEventListener('keyup',e=>keys.delete(e.code));\naddEventListener('blur',()=>{keys.clear();touches.clear();touchRecover=false;if(active&&\"'!network.active&&!paused&&screen==='\"'driving')pause();});\ndocument.addEventListener('visibilitychange',()=>{keys.clear();touches.clear();touchRecover=false;if(document.hidden&&active&&\"'!network.active&&!paused&&screen==='\"'driving')pause();});\naddEventListener('pointerdown',e=>{if(e.pointerType==='touch'){if(meaningful('touch')){e.preventDefault();return;}audio.unlock();if(e.target.id==='screen'&&driving()){touches.set(e.pointerId,{x:e.clientX,y:e.clientY,startX:e.clientX,left:e.clientX<innerWidth*.55});e.target.setPointerCapture?.(e.pointerId);e.preventDefault();}}else if(attracting){meaningful('mouse');e.preventDefault();e.stopImmediatePropagation();}},true);\naddEventListener('pointermove',e=>{const t=touches.get(e.pointerId);if(t){t.x=e.clientX;t.y=e.clientY;}if(e.pointerType\"'!=='\"'touch'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>3)){if(attracting)meaningful('mouse');else{lastDevice='mouse';menuIdle=0;}}});\nfor(const ev of ['pointerup','pointercancel','lostpointercapture'])addEventListener(ev,e=>{touches.delete(e.pointerId);touchRecover=false;});\nui.addEventListener('pointerdown',e=>{if(e.target.closest('[data-recover]')){touchRecover=true;e.preventDefault();}});\nfunction keyboardIntent(seat,shared){const left=seat===1?'ArrowLeft':'KeyA',right=seat===1?'ArrowRight':'KeyD',brake=seat===1?'Ar