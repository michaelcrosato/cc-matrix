to-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/rpg.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/metroidvania.html\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/sim.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/tavern.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/roguelike.html\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/kaykit-restaurant-bits.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/artillery.html\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/platformer.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/ambientcg.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/pinball.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/kenney-platformer.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/shooter.html\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/adventure.html\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/fighting.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/kenney-pirate.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/stealth.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/brawler.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/src/assets/sets/kenney-tiny-battle.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/shooter.js\nAuto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/vendor/engine/kits/pointclick.html\nAuto-Lap-Happy-Auto-Racing-gpt-