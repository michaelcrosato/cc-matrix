 button and a full-screen button at the top right, inside the safe area; on a touch screen the\n3193:  btn('Menu', () => { if (game.o.menu !== false) game.menu(); else game.input._tapCode('Act:menu'); }).innerHTML = cornerIcon(CORNER_ICONS.menu);   // (menu: false: the touch START)\n3826:    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n3827:    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.co [... omitted end of long line]\n3948:   *  a save. False without a menu (a headless game, menu: false) */\n3980:HOOKS.step.push((game, dt) => { const s = game._saves, sc = game.scene; if (s && sc && (sc.pausable || game.sceneName === 'main')) s.played += dt; });   // time played: the game's scenes, not its titl [... omitted end of long line]\n7469:    // an outer corner: round it onto the side face\n9361: *    false }, quit: 'title' } }) adjusts it; menu: false, or new E.Shell(game, { standard: false }), leaves it out.\n9439:    if (!this._sys && this._pauseSpec()) game.pauseOverlay = false;\n9467:  _pauseSpec() { const sc = this._o.screens; return sc && 'pause' in sc ? sc.pause || null : this._std ? {} : null; }\n9731:    if (name === 'pause') this._pauseActs(acts);\n9751:  _pauseActs(acts) {\n9806:    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n9807:    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Star Arena — AI Hub session example (shared world)</title>\n<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n<meta name=\"theme-color\" content=\"#1b1530\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"2\">\n<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #1b1530; color: #f3eef7; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n","exit_code":0,"status":"completed"}}
