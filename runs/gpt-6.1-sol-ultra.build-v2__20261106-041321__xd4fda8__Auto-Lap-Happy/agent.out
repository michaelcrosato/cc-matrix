{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/tools/core-test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nexport function runCoreTests(){\n const out=[],check=(name,fn)=>{try{const x=fn();out.push({name,pass:x\"'!==false,detail:x===false?'\"'Assertion returned false':''});}catch(e){out.push({name,pass:false,detail:e.stack});}},assert=(v,m)=>{if(\"'!v)throw Error(m);};\n for(const f of ['\"'vendor/engine/my-3d2dge.js','src/world.js','src/render.js','src/sim.js'])vm.runInThisContext(fs.readFileSync(path.join(root,f),'utf8'),{filename:f});\n const w=new HappyWorld(),newSim=c=>{const s=new HappySim(w);s.start({mode:'trial',course:0,profile:2,laps:1,...c});return s;},advance=(s,sec,input)=>{for(let i=0;i<Math.ceil(sec*120);i++)s.step(1/120,typeof input==='function'?input(s):input||[]);},driver=s=>[{...s.aiIntent(s.cars[0],1.24),ai:true}],evidence=[];\n check('World schema, five original circuits and safe restart anchors',()=>{assert(w.courses.length===5,'course count');assert(w.validate().length===0,w.validate().join(';'));assert(w.courses.every(c=>c.gates.length===12),'gate count');});\n check('Four handling profiles and exact matched tan/blue physics',()=>{const [a,b,c,d,e]=HappyRules.PROFILES;assert(new Set([a.top,b.top,c.top,d.top]).size===4,'four profiles');for(const key of ['top','accel','turn','grip'])assert(d[key]===e[key],\"'`matched ${key}`);assert(b.accel>c.accel&&c.accel>d.accel&&a.grip>c.grip&&c.grip>d.grip,'\"'handling ladder');});\n check('Countdown freezes every velocity and pose without reverse creep',()=>{const s=newSim(),c=s.cars[0],p=[c.x,c.y];advance(s,2.8,[{brake:1}]);assert(c.x===p[0]&&c.y===p[1]&&c.speed===0,'grid moved');});\n check('Long held brake stops at rest and release resumes acceleration',()=>{const s=newSim();advance(s,3.1);advance(s,2,[{steer:0,brake:0}]);advance(s,20,[{steer:0,brake:1}]);const c=s.cars[0],p=[c.x,c.y];advance(s,2,[{brake:1}]);assert(Math.abs(c.speed)<.001&&Math.hypot(c.x-p[0],c.y-p[1])<.01,'brake creeps');advance(s,1,[{brake:0}]);assert(c.speed>30,'release did not accelerate');});\n check('Partial throttle and brake pressure preserve analog magnitude',()=>{const run=gas=>{const s=newSim();s.settings.auto=false;s.state='running';advance(s,.8,[{gas}]);return s.cars[0].speed;};assert(run(.3)>run(0)+10&&run(1)>run(.3)+25,'throttle boolean');const brake=v=>{const s=newSim();s.state='running';const c=s.cars[0];c.speed=100;c.vx=Math.cos(c.angle)*100;c.vy=Math.sin(c.angle)*100;advance(s,.1,[{brake:v}]);return c.speed;};assert(brake(.3)>brake(1)+10,'brake boolean');});\n check('Road, grass, gravel and water have distinct motion/rules',()=>{const tags=new Set();for(let y=300;y<5700;y+=75)for(let x=300;x<5700;x+=75)tags.add(w.surface(x,y));assert(['road','grass','gravel','water'].every(t=>tags.has(t)),'surface absent');const run=tag=>{const s=newSim();s.state='running';s.world={...w,solids:[],surface:()=>tag};s.invulnerable=true;advance(s,4,[{}]);return s.cars[0].speed;};assert(run('road')>run('gravel')&&run('gravel')>run('grass'),'surfaces same speed');});\n check('Directed gate rejects reverse, outside/parallel and line oscillation',()=>{const g={x:0,y:0,angle:0};assert(HappyRules.crossGate(g,-5,0,5,0,40),'forward rejected');assert(\"'!HappyRules.crossGate(g,5,0,-5,0,40),'\"'reverse passed');assert(\"'!HappyRules.crossGate(g,-5,100,5,100,40),'\"'parallel passed');assert(\"'!HappyRules.crossGate(g,1,0,5,0,40),'\"'oscillation passed');});\n check('Skipping gates and start-line oscillation cannot create a lap',()=>{const s=newSim();s.state='running';const c=s.cars[0],g=s.course.gates[0];for(let i=0;i<20;i++){const old={x:g.x-Math.cos(g.angle),y:g.y-Math.sin(g.angle)};c.x=g.x+Math.cos(g.angle);c.y=g.y+Math.sin(g.angle);s.updateRoute(c,old,1/120);}assert(c.route.lap===0&&c.route.gate===1,'manufactured lap');});\n check('Teleport and off-route shortcuts cannot manufacture legal progress',()=>{const s=newSim();s.state='running';const c=s.cars[0],old={x:c.x,y:c.y},g=s.course.gates[4];c.x=g.x;c.y=g.y;s.updateRoute(c,old,1/120);assert(\"'!c.route.valid&&c.route.lap===0&&c.route.gate===1,'\"'teleport accepted');s.safeRestart(c);assert(c.route.gate===1&&c.route.lap===0,'reset awards gate');});\n for(let course=0;course<5;course++)for(let profile=0;profile<5;profile++)check(\"'`Legal AI lap course ${course+1}, car ${profile+1}`,()=>{const s=newSim({course,profile});s.aiAll=true;for(let i=0;i<120*210&&s.state!=='\"'finished';i++)s.step(1/120);evidence.push({course,profile,state:s.state,time:s.t,laps:s.cars[0].route.lap,valid:s.cars[0].route.valid});assert(s.state==='finished'&&s.cars[0].route.lap===1&&s.cars[0].route.valid,JSON.stringify(evidence.at(-1)));});\n check('Classic five-lap time trial finishes through actual driving',()=>{const s=newSim({laps:5});for(let i=0;i<120*350&&s.state\"'!=='\"'finished';i++)s.step(1/120,driver(s));assert(s.state==='finished'&&s.cars[0].route.splits.length===5,'five laps incomplete');assert(s.ghost.length>1000,'ghost not captured');});\n const duel=()=>{const s=newSim({mode:'duel',humans:2,target:10});s.state='running';return s;};\n check('Duel one crash gives exactly two and stages a safe exchange',()=>{const s=duel();s.resolveDuel([1]);assert(s.score[0]===2&&s.state==='exchange'&&s.exchange===1,'crash score');s.resolveDuel([1]);assert(s.score[0]===2,'duplicate award');assert(Math.hypot(s.cars[0].x-s.cars[1].x,s.cars[0].y-s.cars[1].y)>16,'restart overlap');});\n check('Duel simultaneous crashes tie with zero points',()=>{const s=duel();s.resolveDuel([0,1]);assert(s.score.every(n=>n===0)&&s.state==='exchange','simultaneous scoring');});\n check('Crash takes priority over a pending lead',()=>{const s=duel();s.cars[0].route.total=600;s.leadT=.34;s.resolveDuel([0]);assert(s.score[1]===2&&s.score[0]===0,'priority');});\n check('Lead threshold uses legal distance and awards only once',()=>{const s=duel();s.cars[0].route.total=400;for(let i=0;i<45;i++)s.resolveDuel([]);assert(s.score[0]===1&&s.exchange===1,'lead wrong');});\n check('Wrong-way/invalid route cannot qualify for lead',()=>{const s=duel();s.cars[0].route.total=900;s.cars[0].route.valid=false;for(let i=0;i<80;i++)s.resolveDuel([]);assert(s.score[0]===0,'invalid lead');});\n check('Winning point finishes before another exchange',()=>{const s=duel();s.score[0]=9;s.resolveDuel([1]);assert(s.state==='finished'&&s.exchange===0&&s.score[0]===11,'extra exchange');});\n check('Deadline tie produces draw and no invented winner',()=>{const s=duel();s.limit=.01;advance(s,.02,[{brake:1},{brake:1}]);assert(s.state==='finished'&&s.finishedResult.reason.includes('draw'),'tie wrong');});\n check('Manual recovery counts once as rival crash',()=>{const s=duel();advance(s,.7,[{recover:true,brake:1},{brake:1}]);assert(s.score[1]===2&&s.exchange===1,'recovery score');});\n check('Time trial recovery charges one visible penalty and keeps lap legal',()=>{const s=newSim();s.state='running';advance(s,1.6,[{brake:1,recover:true}]);assert(s.penalty===3&&s.cars[0].route.lap===0&&s.cars[0].route.gate===1,'penalty');});\n check('Coincident cars resolve finite contact without NaN',()=>{const s=duel(),a=s.cars[0],b=s.cars[1];b.x=a.x;b.y=a.y;advance(s,.01,[{brake:1},{brake:1}]);assert([a.x,a.y,b.x,b.y].every(Number.isFinite),'nonfinite contact');assert(Math.hypot(a.x-b.x,a.y-b.y)>=15.9,'unresolved contact');});\n check('Real scored AI pursuit reaches results and resets for rematch',()=>{const s=newSim({mode:'duel',profile:3,opponent:0,target:10,humans:1});for(let i=0;i<120*260&&s.state\"'!=='\"'finished';i++)s.step(1/120,driver(s));assert(s.state==='finished'&&s.score[0]>=10,'duel did not finish scored');s.start({mode:'duel',target:10});assert(s.score.every(v=>v===0)&&s.state==='countdown','rematch retained score');});\n check('Full guided tour completes by driving every stage and scenic connector',()=>{const s=newSim({mode:'tour',profile:2});const stages=[];for(let k=0;k<HappyRules.TOUR.length;k++){for(let i=0;i<120*260&&s.state\"'!=='\"'finished';i++)s.step(1/120,driver(s));stages.push({step:k,state:s.state,t:s.t,score:s.score.slice()});assert(s.state==='finished',\"'`stage ${k} stuck`);if(k===5)assert(Math.max(...s.score)>0,'\"'duel no scoring');s.continueTour();}assert(s.tourComplete&&s.state==='finished','tour ending');fs.writeFileSync(path.join(root,'evidence/tour-playthrough.json'),JSON.stringify(stages,null,2));});\n check('Connected navigation reaches all five paddocks and hidden straight on roads',()=>{const from=w.courses[0].gates[0];for(const to of [...w.courses.map(c=>c.gates[0]),w.drag.start]){const nav=w.routeBetween(from,to);assert(nav&&nav.length>=0,'unreachable paddock');assert(nav.samples.every(p=>w.surface(p.x,p.y)==='road'),'navigation leaves road');}});\n check('Free drive has no laps/score and discoveries use real approach',()=>{const s=newSim({mode:'free'});s.aiAll=true;advance(s,60);assert(s.cars[0].route.lap===0&&s.score.every(n=>n===0),'free has competition');assert(s.discovered.has(w.courses[0].id),'discovery missing');});\n check('Live tuning changes intended car values and reset restores defaults',()=>{const s=newSim(),c=s.cars[0],old=c.o.top;s.tuning.speed=1.5;s.tuning.acceleration=1.4;s.tuning.roadGrip=.8;s.applyProfile(c);assert(c.o.top===old*1.5&&c.o.accel===HappyRules.PROFILES[2].accel*1.4,'tune ignored');s.tuning={...HappyRules.DEFAULTS};s.applyProfile(c);assert(c.o.top===old,'reset wrong');});\n check('Snapshots restore both cars, route and authoritative score',()=>{const a=duel();advance(a,.3,[{},{}]);a.score=[3,5];const b=duel();assert(b.applySnapshot(a.snapshot()),'restore rejected');assert(JSON.stringify(a.snapshot())===JSON.stringify(b.snapshot()),'snapshot differs');assert(\"'!b.applySnapshot({...a.snapshot(),cars:[{x:NaN}]}),'\"'malformed accepted');});\n check('Native 80-degree overhead render and procedural shapes draw headlessly',()=>{const s=newSim(),g=new My3D2dge.Game({headless:true,draw:true,res:[640,360],view:'topdown',menu:false,autoPause:false}),r=new HappyRenderer(g,w);g.start({update(dt){s.step(dt,driver(s));r.update(dt,s);g.focus(s.cars[0].x,s.cars[0].y,0);},draw(v){r.draw(v,s,{dev:true});}});g.advance(.1);assert(\"'!g.errors.length,JSON.stringify(g.errors));g.dispose();});\n fs.mkdirSync(path.join(root,'\"'evidence'),{recursive:true});fs.writeFileSync(path.join(root,'evidence/core-playthrough.json'),JSON.stringify(evidence,null,2));\n return out;\n}\nEOF\ncat > Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/tools/test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'),filter=process.argv[2]||'all',results=[];\nconst take=r=>results.push(...r),python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfunction py(file,args=[],timeout=300000){const r=spawnSync(python,[path.join(root,'tools',file),...args],{encoding:'utf8',timeout,cwd:root});try{const data=JSON.parse(r.stdout);if(Array.isArray(data))take(data);else if(Array.isArray(data.results))take(data.results);else results.push({name:file,pass:false,detail:r.stdout});}catch{results.push({name:file,pass:false,detail:r.stderr||r.error?.message||r.stdout});}}\nif(['all','core'].includes(filter)){const {runCoreTests}=await import('./core-test.mjs');take(runCoreTests());}\nif(['all','audio'].includes(filter)){const {runAudioTests}=await import('./audio-test.mjs');take(runAudioTests());}\nif(['all','network'].includes(filter)){const {runNetworkUnitTests}=await import('./network-unit.mjs');take(await runNetworkUnitTests());py('network-test.py');py('network-test.py',['file']);}\nif(['all','hub'].includes(filter))py('hub-test.py',[],300000);\nif(['all','ui'].includes(filter)&&fs.existsSync(path.join(root,'tools/ui-test.py')))py('ui-test.py');\nif(['all','direct'].includes(filter)&&fs.existsSync(path.join(root,'tools/direct-ui-test.py')))py('direct-ui-test.py');\nif(['all','package'].includes(filter)){\n const info=JSON.parse(fs.readFileSync(path.join(root,'docs/build.json'))),file=fs.readFileSync(path.join(root,'..',info.stem+'.html'),'utf8'),client=fs.readFileSync(path.join(root,'vendor/hub/session.js'),'utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script');\n const check=(name,pass,detail='')=>results.push({name,pass,detail});\n check('Single HTML includes official unmodified client first after charset',file.indexOf('<script>'+client+'</script>')===file.indexOf('<script>')&&file.indexOf('<meta charset=')<file.indexOf('<script>'));\n check('All ordinary runtime scripts/assets are inline',\"'!/<script[''^>]+src=|<link[''^>]+href=|<audio'\"\\\\b|\\\\.mp3\\\\b|\\\\.wav\\\\b/.test(file));\n check('Final HTML has session metadata and every reporting section',['hub:session-mode','Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import'].every(x=>file.includes(x)));\n try{const r=JSON.parse(fs.readFileSync(path.join(root,'../exit-interview.json'),'utf8'));check('Exit interview exact top-level shape and complete values',Object.keys(r).sort().join(',')==='aiHub,engineFeedback,promptFeedback,sourceInformation,testingFeedback'&&r.testingFeedback.length===4&&r.engineFeedback.length===6&&r.promptFeedback.length===4&&Object.values(r.sourceInformation).every(x=>typeof x==='string'&&x.length)&&r.sourceInformation.usage==='added on import'&&r.aiHub.name===info.title&&r.aiHub.genre==='Racing');}catch(e){check('Exit interview parses',false,e.message);}\n}\nfs.mkdirSync(path.join(root,'evidence'),{recursive:true});fs.writeFileSync(path.join(root,'evidence/test-'+filter+'.json'),JSON.stringify(results,null,2));\nfor(const r of results)if(\"'!r.pass)console.error(`FAIL ${r.name}: ${r.detail||'\"'assertion failed'}\"'`);\nconsole.log(`${results.filter(r=>r.pass).length}/${results.length} checks passed`);\nprocess.exitCode=results.some(r=>!r.pass)?1:0;\nEOF\nnode Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/tools/test.mjs core'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
