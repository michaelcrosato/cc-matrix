nt:'';position:absolute;left:25px;top:4px;width:19px;height:14px;background:#142e38;border-radius:3px}.caricon i:after{content:'';position:absolute;left:13px;top:-7px;width:10px;height:6px;background:#091c22;box-shadow:31px 0 #091c22,0 29px #091c22,31px 29px #091c22}.bars{display:flex;gap:4px;margin:4px 0}.barlabel{font-size:11px;color:#bdd0bb;width:38px}.bar{height:5px;flex:1;align-self:center;background:#41615a}.bar.on{background:var(--car)}.setupbottom{display:flex;gap:1vw;align-items:center;margin-top:2vh}.setupbottom .flat:last-child{margin-left:auto;min-width:22vw}.pill{display:inline-block;border:1px solid #91a88b;padding:7px 14px;border-radius:100px;font-size:clamp(12px,.95vw,19px);color:#d1e2cb}.sectionlabel{font-size:clamp(13px,1vw,20px);color:var(--gold);font-weight:800;letter-spacing:.17em;margin:2vh 0 1vh}.settingsgrid{display:grid;grid-template-columns:1fr 1fr;gap:1.2vh 3vw;max-width:1400px}.setting{padding:1.3vh 1.2vw;background:#25464a;display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:clamp(16px,1.3vw,26px);min-height:7vh}.setting input[type=range]{width:46%;accent-color:var(--gold)}.setting select{padding:7px 12px;background:#17373b;color:var(--cream);border:1px solid #829579;max-width:58%}.setting output{font-variant-numeric:tabular-nums;min-width:45px;text-align:right;color:var(--gold)}.overlay{position:absolute;inset:0;display:grid;place-items:center;background:#091e2585;backdrop-filter:blur(5px)}.dialog{background:#142e32f5;border:1px solid #778f7b;padding:4vh 4vw;width:min(940px,88vw);max-height:94vh;overflow:auto;box-shadow:0 18px 80px #06191c75}.dialog h2{font-size:clamp(30px,3.5vw,65px);margin:0 0 2vh;letter-spacing:-.04em}.dialog p{font-size:clamp(17px,1.5vw,29px);color:#c8d8c2;line-height:1.45}.dialog .choice{margin:1vh 0;min-height:7.4vh}.hud{position:absolute;inset:0;pointer-events:none\"'!important;padding:3vh 3vw;color:var(--cream);text-shadow:0 2px 5px #15312c}.hudtop{display:flex;justify-content:space-b