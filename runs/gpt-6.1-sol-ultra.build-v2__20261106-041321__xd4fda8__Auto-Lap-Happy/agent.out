{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/app.js <<'EOF'\n/* Auto Lap Happy — screens, input, persistence, presentation. Original code, MIT. */\n(() => {\n'use strict';\nconst E=My3D2dge,{PROFILES,DEFAULTS,TOUR}=HappyRules,ui=document.getElementById('ui'),\"'$=s=>ui.querySelector(s),$$=s=>[...ui.querySelectorAll(s)],clamp=(x,a,b)=>Math.max(a,Math.min(b,x)),html=s=>String(s??'\"'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst defaults={auto:true,steering:'relative',glyphs:'ps',master:.72,music:.1,sfx:.7,voice:.45,mute:false,reduced:false,assist:.25,ghost:true};\nconst store={read(k,d){try{const v=JSON.parse(localStorage.getItem('happy:v1:'+k));return v&&v.version===1?v.data:d;}catch{return d;}},write(k,d){if(network?.kind==='hub'||attracting)return;try{localStorage.setItem('happy:v1:'+k,JSON.stringify({version:1,data:d}));}catch{} }};\nlet settings={...defaults},records={},passport=[],network=null,attracting=false;\nObject.assign(settings,store.read('settings',{}));for(const k of ['master','music','sfx','voice','assist'])settings[k]=Number.isFinite(settings[k])?clamp(settings[k],0,1):defaults[k];records=store.read('records',{});if(\"'!records||typeof records!=='\"'object'||Array.isArray(records))records={};passport=store.read('passport',[]);if(\"'!Array.isArray(passport))passport=[];\nconst world=new HappyWorld(),sim=new HappySim(world,settings),vignette=new HappySim(world,settings),audio=new HappyAudio(settings),game=new E.Game({canvas:'\"'screen',res:[640,360],expand:true,view:'topdown',views:['topdown'],menu:false,corner:false,fullscreen:false,autoPause:false,input:{unused:['F24']},bg:'#89a872'}),renderer=new HappyRenderer(game,world);\ngame.cam.smooth=.15;game.setZoom(.78);game.lights.enabled=true;game.lights.ambient=.94;\nsim.discovered=new Set(passport);vignette.start({mode:'trial',course:0,profile:2,laps:50});vignette.aiAll=true;vignette.attract=true;\nlet screen='title',previousScreen='title',mode='trial',setup={course:0,profile:2,opponent:4,laps:2,target:10,difficulty:'normal',humans:1,seats:'auto'},focusIndex=0,creditPage=0,lastDevice='keyboard',menuIdle=0,attractAge=0,attractIndex=0,attractReturn=null,attractSim=null,paused=false,devOpen=false,showMap=false,active=false,gameTime=0,hudAge=0,resultsShown=false,networkStatus='',connectionRole='host',connectionOut='',netInputs=[null,null],lastNetEventTick=-1,toast='',toastT=0,freeCamera=false;\nlet keys=new Set(),touches=new Map(),touchRecover=false,padState=new Map(),menuRepeat=0,lastPadCount=0,lastInputAt=performance.now(),testInputs=null;\nfunction say(text,seconds=3){toast=text;toastT=seconds;}\nfunction glyph(action){const xbox=settings.glyphs==='xbox';if(lastDevice==='pad')return {confirm:xbox?'A':'✕',back:xbox?'B':'○',recover:xbox?'Y':'△',brake:'L2',pause:'☰',steer:'L'}[action]||action;if(lastDevice==='touch')return {confirm:'Tap',back:'Back',recover:'Hold',brake:'Hold right',pause:'Ⅱ',steer:'Drag left'}[action]||action;return {confirm:'Enter',back:'Esc',recover:'R',brake:'Space',pause:'Esc',steer:'A / D'}[action]||action;}\nfunction footer(extra=''){return \"'`<div class=\"footer\"><span><b class=\"key\">${glyph('\"'confirm')}</b> Select</span><span><b class=\\\"key\\\">\"'${glyph('\"'back')}</b> Back</span><span class=\\\"push\\\">\"'${extra||'\"'AUTO ACCELERATE · BRAKE BEFORE THE BEND'}</span></div>\"'`;}\nfunction button(action,title,sub='\"'',num='',primary=false){return \"'`<button class=\"choice ${primary?'\"'primary':''}\\\" data-action=\\\"\"'${action}\">${num?`<span class=\"num\">${num}</span>`:'\"''}<span><strong>\"'${title}</strong>${sub?`<small>${sub}</small>`:'\"''}</span><span class=\\\"arrow\\\">↗</span></button>\"'`;}\nfunction top(title,back='\"'back'){return \"'`<div class=\"topbar\"><button class=\"back\" data-action=\"${back}\">← ${glyph('\"'back')}</button><h2>\"'${title}</h2></div>`;}\nfunction focusables(){return $$('\"'button:not(:disabled),input:not(:disabled),select,textarea');}\nfunction focusAt(i=0){const all=focusables();focusIndex=clamp(i,0,all.length-1);all[focusIndex]?.focus({preventScroll:true});}\nfunction markFocus(){focusables().forEach((b,i)=>b.addEventListener('pointerenter',()=>{focusIndex=i;if(document.activeElement?.tagName\"'!=='\"'TEXTAREA')b.focus({preventScroll:true});}));}\nfunction setUI(content,focus=0){ui.innerHTML=content;markFocus();requestAnimationFrame(()=>focusAt(focus));}\nfunction openScreen(name){previousScreen=screen;screen=name;menuIdle=0;resultsShown=false;renderMenu();}\nfunction renderMenu(){\n if(screen==='title'){\n  active=false;paused=false;audio.setScene('title');\n  setUI(\"'`<section class=\"screen title\"><div class=\"brandline\"><span class=\"brandmark\"></span>THE HAPPY VALLEY MOTOR CLUB</div><h1>AUTO<br><span>LAP HAPPY</span></h1><p class=\"tagline\">Little cars. Great country roads.</p><nav class=\"titlemenu\">${button('\"'tour','Take the road tour','A friendly first drive through Happy Valley','01',true)}\"'${button('\"'quick','Pick a road','Time trial, pursuit duel & free drive','02')}\"'${button('\"'multi','Bring a friend','Couch competition or a direct connection','03')}\"'${button('\"'settings','Make it yours','Handling, sound & accessibility','04')}\"'${button('\"'credits','About the journey','Source, credits & build notes','05')}</nav><aside class=\\\"titlebadge\\\"><span class=\\\"large\\\">EST. 1980 / REIMAGINED</span><span class=\\\"small\\\">FIVE ROADS · FIVE RIDES · ONE VALLEY</span></aside><div class=\\\"worldcaption\\\"><span class=\\\"eyebrow\\\">NOW DRIVING · 01</span><strong>Meadow Mile</strong><p>Follow the road. Find your rhythm.</p></div>\"'${footer('\"'1–2 PLAYERS · A NORTH-UP COUNTRY RACER')}</section>\"'`);\n }else if(screen==='\"'quick'){\n  setUI(\"'`<section class=\"screen full\">${top('\"'A road for every mood')}<p class=\\\"lead\\\">No unlocks. No hurry. Just choose your kind of drive.</p><div class=\\\"modes\\\"><button class=\\\"modecard\\\" data-action=\\\"choose-trial\\\"><span class=\\\"icon\\\">◷</span><strong>Time trial</strong><p>Find a clean line. Race two laps, or settle in for the classic five.</p><span class=\\\"pill\\\">SOLO · PERSONAL GHOST</span></button><button class=\\\"modecard\\\" data-action=\\\"choose-duel\\\"><span class=\\\"icon\\\">⇉</span><strong>Pursuit duel</strong><p>Pull ahead for 1. Rival crash for 2. First to ten takes the flag.</p><span class=\\\"pill\\\">SOLO vs AI · 1–2 FRIENDS</span></button><button class=\\\"modecard\\\" data-action=\\\"choose-free\\\"><span class=\\\"icon\\\">⌁</span><strong>Free drive</strong><p>Five connected circuits. A route passport. A secret straight to find.</p><span class=\\\"pill\\\">EXPLORE · NO CLOCK</span></button></div><p class=\\\"lead\\\">Automatic acceleration keeps your attention on the road. Brake before the turn, then release to go.</p>\"'${footer()}</section>`);\n }else if(screen==='\"'setup')renderSetup();\n else if(screen==='settings')renderSettings();\n else if(screen==='multi')setUI(\"'`<section class=\"screen full\">${top('\"'Good company. Close racing.')}<p class=\\\"lead\\\">Two cars. One shared countryside. The road decides who pulls away.</p><div class=\\\"modes\\\"><button class=\\\"modecard\\\" data-action=\\\"couch\\\"><span class=\\\"icon\\\">♟♟</span><strong>Couch duel</strong><p>Two pads, keyboard + pad, or a shared keyboard. One screen. First to ten.</p><span class=\\\"pill\\\">LOCAL · 2 DRIVERS</span></button><button class=\\\"modecard\\\" data-action=\\\"host\\\"><span class=\\\"icon\\\">↗</span><strong>Invite a driver</strong><p>Create a direct invitation. Exchange the complete connection text with a friend.</p><span class=\\\"pill\\\">WEBRTC · NO SIGN-IN</span></button><button class=\\\"modecard\\\" data-action=\\\"join\\\"><span class=\\\"icon\\\">↙</span><strong>Join a driver</strong><p>Paste a friend’s invitation. Send your reply, then meet them at the grid.</p><span class=\\\"pill\\\">DIRECT PEER CONNECTION</span></button></div><p class=\\\"lead\\\">Playing in AI Hub? Its session starts automatically and uses the Hub’s shared world connection.</p>\"'${footer()}</section>`);\n else if(screen==='\"'connection')renderConnection();\n else if(screen==='credits')renderCredits();\n else if(screen==='pause')renderPause();\n else if(screen==='dev')renderDev();\n else if(screen==='results')renderResults();\n else if(screen==='passport')renderPassport();\n}\nfunction routeSVG(c,stroke='#e7d5a2',full=false){const xs=c.samples.map(p=>p.x),ys=c.samples.map(p=>p.y),minx=Math.min(...xs),miny=Math.min(...ys),w=Math.max(...xs)-minx,h=Math.max(...ys)-miny;return \"'`<svg viewBox=\"${minx-130} ${miny-130} ${w+260} ${h+260}\" aria-hidden=\"true\"><path d=\"${c.samples.filter((_,i)=>i%3===0).map((p,i)=>(i?'\"'L':'M')+p.x.toFixed(0)+','+p.y.toFixed(0)).join(' ')} Z\\\" fill=\\\"none\\\" stroke=\\\"\"'${stroke}\" stroke-width=\"${full?38:48}\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"${c.gates[0].x}\" cy=\"${c.gates[0].y}\" r=\"70\" fill=\"#ef7659\"/></svg>`;}\nfunction carCard(p,i){return `<button class=\"car ${setup.profile===i?'\"'selected':''}\\\" data-action=\\\"car-\"'${i}\" style=\"--car:${p.color}\"><div class=\"caricon\"><i></i></div><strong>${html(p.name)}</strong><small>${html(p.about)}</small>${['\"'SPEED','PICKUP','GRIP'].map((n,j)=>\"'`<div class=\"bars\"><span class=\"barlabel\">${n}</span>${Array.from({length:5},(_,k)=>`<i class=\"bar ${k<p.bars[j]?'\"'on':''}\\\"></i>\"'`).join('\"'')}</div>\"'`).join('\"'')}</button>\"'`;}\nfunction renderSetup(){const names={trial:'\"'Find your best line',duel:'A friendly pursuit',free:'The whole valley is yours'},c=world.courses[setup.course];setUI(\"'`<section class=\"screen full\">${top(names[mode])}<div class=\"row spread\"><p class=\"lead\" style=\"margin:0\">${mode==='\"'duel'?'Crash +2 · clear lead +1 · checkpoint restarts':mode==='trial'?'Ordered gates. Honest laps. One more try.':'All roads connect. Follow signs and collect passport stamps.'}</p><span class=\\\"pill\\\">\"'${setup.humans===2?'\"'2 DRIVERS':mode==='duel'?'YOU vs AI':'SOLO DRIVE'}</span></div><div class=\\\"sectionlabel\\\">01 · CHOOSE YOUR ROAD</div><div class=\\\"tracks\\\">\"'${world.courses.map((c,i)=>`<button class=\"track ${setup.course===i?'\"'selected':''}\\\" data-action=\\\"course-\"'${i}\"><span class=\"number\">0${i+1}</span>${routeSVG(c)}<strong>${c.name}</strong><small>${c.subtitle}</small></button>`).join('\"'')}</div><div class=\\\"sectionlabel\\\">02 · PICK YOUR RIDE</div><div class=\\\"cars\\\">\"'${PROFILES.map(carCard).join('\"'')}</div><div class=\\\"setupbottom\\\">\"'${mode==='\"'trial'?\"'`<button class=\"flat\" data-action=\"laps\">${setup.laps} LAPS · ${setup.laps===2?'\"'SHORT':'CLASSIC'}</button>\"'`:mode==='\"'duel'?\"'`<button class=\"flat\" data-action=\"target\">${setup.target} POINTS · ${setup.target===10?'\"'SPRINT':'CLASSIC'}</button><button class=\\\"flat\\\" data-action=\\\"opponent\\\">RIVAL: \"'${PROFILES[setup.opponent].name.split('\"' · ')[0]}</button>\"'`:`<button class=\"flat\" data-action=\"passport\">ROUTE PASSPORT · ${passport.length}/6</button>`}${mode==='\"'duel'&&setup.humans===1?\"'`<button class=\"flat\" data-action=\"difficulty\">AI: ${setup.difficulty.toUpperCase()}</button>`:'\"''}\"'${setup.humans===2?`<button class=\"flat\" data-action=\"seats\">SEATS: ${setup.seats.toUpperCase()}</button>`:'\"''}<button class=\\\"flat accent\\\" data-action=\\\"start\\\">LET’S DRIVE ↗</button></div><p class=\\\"portraitnote\\\">Turn your device sideways for a bigger view of the road.</p></section>\"'`,1+setup.course);}\nfunction renderSettings(){const range=(key,name)=>`<label class=\"setting\"><span>${name}</span><input type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\"${settings[key]}\" data-setting=\"${key}\" aria-label=\"${name}\"><output>${Math.round(settings[key]*100)}%</output></label>`,select=(key,name,opts)=>`<label class=\"setting\"><span>${name}</span><select data-setting=\"${key}\" aria-label=\"${name}\">${opts.map(([v,n])=>`<option value=\"${v}\" ${String(settings[key])===v?'\"'selected':''}>\"'${n}</option>`).join('\"'')}</select></label>\"'`;setUI(`<section class=\"screen full\">${top('\"'Make it yours')}<div class=\\\"settingsgrid\\\">\"'${select('\"'auto','Acceleration',[['true','Automatic'],['false','Manual throttle']])}\"'${select('\"'steering','Steering',[['relative','Car-relative'],['screen','Screen direction']])}\"'${select('\"'glyphs','Controller symbols',[['ps','PlayStation'],['xbox','Xbox A B X Y']])}\"'${select('\"'ghost','Personal ghost',[['true','Show best run'],['false','Hide']])}\"'${range('\"'master','Master volume')}\"'${range('\"'music','Music')}\"'${range('\"'sfx','Road & effects')}\"'${range('\"'voice','Crew voices')}\"'${select('\"'mute','Sound',[['false','On'],['true','Muted']])}\"'${select('\"'reduced','Reduced motion',[['false','Off'],['true','On']])}\"'${range('\"'assist','Touch road assist')}</div><p class=\\\"lead\\\">\"'${settings.steering==='\"'screen'?'Screen direction: point the stick or press keys toward the screen edge you want to face.':'Car-relative: left turns the car left. Right turns it right.'} \"'${settings.auto?'\"'Brake to stop; release to accelerate.':'Hold R2 or W / ↑ to accelerate.'}</p><div class=\\\"row\\\"><button class=\\\"flat\\\" data-action=\\\"reset-settings\\\">Restore defaults</button><button class=\\\"flat\\\" data-action=\\\"fullscreen\\\">Full screen</button><button class=\\\"flat accent\\\" data-action=\\\"back\\\">All set ↗</button></div></section>\"'`);}\nfunction renderPause(){setUI(`<div class=\"overlay\"><section class=\"dialog\"><span class=\"eyebrow\">${network.active?'\"'LIVE CONNECTION · RACE CONTINUES':'A MOMENT IN THE PADDOCK'}</span><h2>\"'${network.active?'\"'Keep an eye on the road':'Take a breather.'}</h2>\"'${network.active?'\"'<p>Your car brakes safely while this menu is open. The shared clock keeps running.</p>':''}\"'${button('\"'resume','Back to the road','Resume the drive','01',true)}\"'${button('\"'settings','Settings','Sound, controls & accessibility','02')}\"'${button('\"'passport','Valley passport','See your discoveries and the connected roads','03')}\"'${button('\"'dev','Developer paddock',network.active?'Read-only online diagnostics':'Live tuning, route overlays & testing tools','04')}\"'${button('\"'restart','Restart this drive','A fresh grid and a clean clock','05')}\"'${button('\"'quit','Return to the club','End this drive','06')}</section></div>\"'`);}\nfunction renderDev(){const sliders=[['\"'speed','Top speed',.5,1.7,.05],['acceleration','Acceleration',.4,2,.05],['braking','Braking',.4,2,.05],['steering','Steering',.4,1.8,.05],['roadGrip','Road grip',.3,1.8,.05],['grassGrip','Grass grip',.2,1.3,.05],['gravelGrip','Gravel grip',.1,1.2,.05],['crash','Crash speed',40,180,5],['aiPace','AI pace',.45,1.05,.01],['lead','Lead distance',144,600,12],['target','Duel target',2,50,1]];setUI(\"'`<section class=\"screen full\">${top('\"'Developer paddock','dev-back')}<div class=\\\"row spread\\\"><span class=\\\"pill\\\">\"'${network.active?'\"'ONLINE · READ ONLY':'TUNING MARKS THIS RUN UNRANKED'}</span><span class=\\\"pill\\\">SEED \"'${sim.seed} · TICK ${sim.tick}</span></div><div class=\"settingsgrid\" style=\"margin-top:1.5vh\">${sliders.map(([k,n,min,max,step])=>`<label class=\"setting\"><span>${n}</span><input type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${sim.tuning[k]}\" data-tune=\"${k}\" aria-label=\"${n}\" ${network.active?'\"'disabled':''}><output>\"'${sim.tuning[k]}</output></label>`).join('\"'')}<button class=\\\"flat\\\" data-action=\\\"dev-reset\\\" \"'${network.active?'\"'disabled':''}>Reset tuning defaults</button></div><div class=\\\"row\\\" style=\\\"margin-top:1.5vh;flex-wrap:wrap\\\">\"'${[['\"'dev-ai',\"'`AI drive: ${sim.aiAll?'\"'ON':'OFF'}\"'`],['\"'dev-safe',\"'`Invulnerability: ${sim.invulnerable?'\"'ON':'OFF'}\"'`],['\"'dev-camera',\"'`Free camera: ${freeCamera?'\"'ON':'OFF'}\"'`],['\"'dev-overlay',\"'`Gate overlays: ${devOpen?'\"'ON':'OFF'}\"'`],['\"'dev-gate','Restart at gate'],['dev-course','Next course'],['dev-car','Next car'],['dev-stage','Finish tour step']].map(([a,l])=>\"'`<button class=\"flat\" data-action=\"${a}\" ${network.active&&!['\"'dev-overlay'].includes(a)?'disabled':''}>\"'${l}</button>`).join('\"'')}</div><pre class=\\\"devsnapshot\\\">\"'${html(JSON.stringify({state:sim.state,mode:sim.mode,course:sim.course.name,score:sim.score,cars:sim.cars.map(c=>({speed:+c.speed.toFixed(1),surface:c.surface,gate:c.route.gate,lap:c.route.lap,valid:c.route.valid}))},null,2))}</pre></section>`);}\nfunction recordKey(){return `physics1:${sim.course.id}:v${sim.course.version}:p${sim.cars[0].profile}:l${sim.laps}:${settings.auto?'\"'auto':'manual'}:\"'${settings.steering}:assist${lastDevice==='\"'touch'?settings.assist:0}\"'`;}\nfunction saveResult(){if(sim.mode!=='\"'trial'||\"'!sim.finishedResult?.ranked||sim.tourStep>=0||network.active)return;const key=recordKey(),old=records[key];if(!old||sim.t<old.time){records[key]={time:sim.t,ghost:sim.ghost,version:1};store.write('\"'records',records);sim.newBest=true;}else sim.newBest=false;}\nfunction renderResults(){const r=sim.finishedResult||{},tour=sim.tourStep>=0,done=sim.tourComplete;audio.setScene('results');setUI(\"'`<div class=\"overlay\"><section class=\"dialog\"><span class=\"eyebrow\">${done?'\"'HAPPY VALLEY MOTOR CLUB · ROAD TOUR COMPLETE':tour?TOUR[sim.tourStep]?.title:sim.course.name}</span><h2>\"'${done?'\"'Every road. A happy ending.':sim.mode==='duel'?'The flag is yours to share.':'That’s a fine drive\"'!'\"'}</h2><p>\"'${done?'\"'You found your line through the whole valley. There’s always another road, another ride, and another friendly rival. Thanks for the drive\"'!'\"':html(r.reason||'The paddock is waiting.')}</p><div class=\\\"resultstats\\\">\"'${sim.mode==='\"'duel'?\"'`<div><small>DRIVER 1</small><strong>${sim.score[0]}</strong></div><div><small>DRIVER 2</small><strong>${sim.score[1]}</strong></div>`:`<div><small>YOUR TIME</small><strong>${formatTime(r.time??sim.t)}</strong></div><div><small>${sim.newBest?'\"'PERSONAL BEST\"'!'\"':'RECOVERY PENALTY'}</small><strong>\"'${sim.newBest?'\"'★':\"'`+${sim.penalty.toFixed(0)}s`}</strong></div>`}</div>${r.splits?.length?`<p class=\"splits\">${r.splits.map((t,i)=>`Lap ${i+1} · ${formatTime(t)}`).join('\"'　')}</p>\"'`:'\"''}\"'${!r.ranked?'\"'<span class=\\\"pill\\\">PRACTICE / DEV RUN · NO PERSONAL RECORD</span>':''}\"'${tour&&!done?button('\"'tour-next',sim.tourStep===TOUR.length-1?'Finish the journey':'Next road','There’s more of the valley to see','01',true):button('retry',network.active?'Rematch':'One more drive','Same road, fresh start','01',true)}\"'${button('\"'quick','Pick another road','All five roads, all five rides','02')}\"'${button('\"'quit','Back to the club','Return to the title','03')}</section></div>\"'`);}\nfunction renderPassport(){const sx=6000,paths=world.roads.map(r=>`<path d=\"${r.samples.filter((_,i)=>i%4===0).map((p,i)=>(i?'\"'L':'M')+p.x+','+p.y).join(' ')}\\\" fill=\\\"none\\\" stroke=\\\"\"'${r.connector?'\"'#77866a':r.color||'#d8cdb0'}\\\" stroke-width=\\\"\"'${r.connector?18:35}\"/>`).join('\"''),c=sim.cars[0];setUI(\"'`<section class=\"screen full\">${top('\"'A valley worth knowing')}<div class=\\\"passportrow\\\"><svg class=\\\"mapfull\\\" viewBox=\\\"0 0 \"'${sx} ${sx}\" aria-label=\"Connected valley map\">${world.water.map(w=>`<ellipse cx=\"${w.x}\" cy=\"${w.y}\" rx=\"${w.rx}\" ry=\"${w.ry}\" fill=\"#608c91\"/>`).join('\"'')}\"'${paths}${world.courses.map((r,i)=>`<circle cx=\"${r.gates[0].x}\" cy=\"${r.gates[0].y}\" r=\"100\" fill=\"#efd078\"/><text x=\"${r.gates[0].x}\" y=\"${r.gates[0].y+50}\" font-family=\"sans-serif\" font-size=\"145\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#153336\">${i+1}</text>`).join('\"'')}\"'${c?`<circle cx=\"${c.x}\" cy=\"${c.y}\" r=\"65\" fill=\"#fff8df\" stroke=\"#e46f55\" stroke-width=\"28\"/>`:'\"''}</svg><div class=\\\"passportlist\\\"><p class=\\\"lead\\\">\"'${passport.length} / 6 stamps collected. Visit each paddock in Free Drive. A lane by the windmill leads to an old airfield…</p>${world.discoveries.map(d=>`<div class=\"stamp ${passport.includes(d.id)?'\"'found':''}\\\">\"'${passport.includes(d.id)?'\"'✓':'○'} \"'${d.secret&&!passport.includes(d.id)?'\"'An undiscovered straight':html(d.name)}</div>\"'`).join('\"'')}<button class=\\\"flat accent\\\" data-action=\\\"back\\\">Back to the journey ↗</button></div></div></section>\"'`);}\nfunction renderConnection(){setUI(`<section class=\"screen full\"><div class=\"network\">${top(connectionRole==='\"'host'?'Invite a driver':'Join a driver','connection-back')}<span class=\\\"eyebrow\\\">DIRECT CONNECTION · \"'${connectionRole.toUpperCase()}</span><p class=\"lead\">${connectionRole==='\"'host'?'1. Create an invitation and send it to your friend. 2. Paste their reply below. 3. When connected, start your duel.':'1. Paste the host’s invitation below. 2. Create your reply and send it back. 3. Wait for the host’s green flag.'}</p><textarea id=\\\"connection-input\\\" aria-label=\\\"Paste invitation or reply\\\" placeholder=\\\"Paste the complete connection text here\\\" spellcheck=\\\"false\\\"></textarea><div class=\\\"row\\\">\"'${connectionRole==='\"'host'?'<button class=\\\"flat accent\\\" data-action=\\\"create-offer\\\">Create invitation</button><button class=\\\"flat\\\" data-action=\\\"apply-answer\\\">Accept reply</button>':'<button class=\\\"flat accent\\\" data-action=\\\"create-answer\\\">Create reply</button>'}<button class=\\\"flat\\\" data-action=\\\"paste\\\">Paste from clipboard</button><label class=\\\"flat\\\" style=\\\"cursor:pointer\\\">Import text file<input type=\\\"file\\\" id=\\\"import-connection\\\" accept=\\\".txt,.json\\\" style=\\\"display:none\\\"></label></div><textarea id=\\\"connection-output\\\" aria-label=\\\"Your connection text\\\" readonly spellcheck=\\\"false\\\">\"'${html(connectionOut)}</textarea><div class=\"row\"><button class=\"flat\" data-action=\"copy\">Copy complete text</button><button class=\"flat\" data-action=\"export\">Save text file</button>${connectionRole==='\"'host'?'<button class=\\\"flat accent\\\" data-action=\\\"direct-start\\\">Start duel ↗</button>':''}</div><p class=\\\"status\\\" id=\\\"network-status\\\">\"'${html(networkStatus||'\"'Ready when you are.')}</p><label class=\\\"setting\\\"><span>Optional STUN URL</span><input id=\\\"stun\\\" aria-label=\\\"Optional STUN server URL\\\" value=\\\"\"'${html(network.stun)}\" placeholder=\"stun:your-server\" style=\"max-width:55%;padding:8px;background:#17373b;color:#f6efd9;border:1px solid #718c7d\"></label><p style=\"color:#b7cbba;font-size:clamp(12px,1vw,20px)\">Direct connectivity depends on your networks. Some routers require TURN, which this manual connection does not provide. If connection fails, retry, play on the couch, or use AI Hub. No invitation is uploaded by this game.</p></div></section>`);}\nconst fallbackReport={sourceInformation:{date:'\"'2026-11-06 04:13:21',source:'Auto Racing (Mattel Intellivision, 1980)',plan:'PLAN.md',genre:'Arcade racing and pursuit duels',perspective:'North-up overhead, native 80-degree pitch',tech:'my-3D2dge 0.89.1; AI Hub client 1.4.0; JavaScript, Canvas 2D, Web Audio, WebRTC',artDirection:'Original shaded pixel miniature countryside and native procedural shapes',animation:'Native shape groups, continuous wheel steering, lean, flags, dust and skids',audio:'Original synthesized music, engines, effects and gibberish crew; music defaults to 10%',online:'AI Hub shared-world and manual WebRTC direct peers; local two-player',testing:'Deterministic headless simulation; scripted input; Chromium/WebKit; pad/touch stand-ins; no physical hardware or listening',research:'Original manual and Blue Sky Rangers history; archival screenshot observed; exact original sounds unknown',environment:'Codex CLI (headless); Linux',model:'OpenAI, gpt-6.1-sol, reasoning effort ultra',usage:'added on import'},testingFeedback:['unknown','unknown','unknown','unknown'],engineFeedback:['Native shapes and headless simulation.','unknown','Directed race gates and pursuit rules.','unknown','none','More complete overhead racing starter.'],promptFeedback:['Clear source and deliverable requirements.','unknown','unknown','unknown']};\nfunction renderCredits(){const r=HAPPY_REPORT.sourceInformation?HAPPY_REPORT:fallbackReport,s=r.sourceInformation,pages=[{title:'Source Information',body:Object.entries(s).slice(0,8).map(([k,v])=>\"'`<p><b>${html(k.replace(/([A-Z])/g,'\"' \"'$1'\"'))}:</b> \"'${html(v)}</p>`).join('\"'')},{title:'Source Information · continued',body:Object.entries(s).slice(8).map(([k,v])=>\"'`<p><b>${html(k.replace(/([A-Z])/g,'\"' \"'$1'\"'))}:</b> \"'${html(v)}</p>`).join('\"'')},{title:'Testing Feedback',body:['Issues caught','Critical / game-breaking','Most helpful test','Least helpful test'].map((q,i)=>\"'`<p><b>${q}:</b> ${html(r.testingFeedback[i])}</p>`).join('\"'')},{title:'Engine Feedback',body:['Most liked','Stuck or guessed wrong','Most important self-built system','Hardest aspect','Engine changes','One desired change'].map((q,i)=>\"'`<p><b>${q}:</b> ${html(r.engineFeedback[i])}</p>`).join('\"'')},{title:'Prompt Feedback',body:['Most liked','Confusing aspects','Hardest part','Desired change'].map((q,i)=>\"'`<p><b>${q}:</b> ${html(r.promptFeedback[i])}</p>`).join('\"'')},{title:'A little club. A big thank-you.',body:'<p><b>Original design, code, vehicles, roads & music:</b> Auto Lap Happy build team.</p><p><b>Engine:</b> my-3D2dge 0.89.1 by Michael Crosato, MIT. Full native engine, shapes and driving foundation. Upstream notices are preserved in this file.</p><p><b>Online:</b> AI Hub Session Protocol v1, client 1.4.0. Official client included unchanged.</p><p><b>Historical reference:</b> Auto Racing © Mattel Electronics, 1980; Blue Sky Rangers instructions and history. This is an original inspired game with new maps and art.</p><p><b>Controls:</b> A/D or left stick steer · Space / S or L2 brake · hold R or Triangle recover · Escape / Options pause. Manual throttle: W or R2. Touch: drag left, hold right to brake.</p>'}];const p=pages[creditPage];setUI(\"'`<section class=\"screen full\">${top('\"'About the journey')}<span class=\\\"eyebrow\\\">BUILD NOTES · \"'${creditPage+1} / ${pages.length}</span><h3 style=\"font-size:clamp(24px,2.2vw,44px);margin:1.5vh 0\">${p.title}</h3><div class=\"creditbody\">${p.body}</div><div class=\"creditnav\"><button class=\"flat\" data-action=\"credit-prev\">← Previous page</button><button class=\"flat accent\" data-action=\"credit-next\">Next page →</button><button class=\"flat\" data-action=\"back\">Back to the club</button></div></section>`);}\nfunction formatTime(t){if(!Number.isFinite(t))return '\"'—';const min=Math.floor(t/60),sec=Math.floor(t%60),cs=Math.floor(t%1*100);return \"'`${min}:${String(sec).padStart(2,'\"'0')}.\"'${String(cs).padStart(2,'\"'0')}\"'`;}\nfunction createNetwork(){return new HappyNetwork({onStart(c){sim.settings=settings;sim.start({...c,profile:c.cars?.[0]??3,opponent:c.cars?.[1]??4});active=true;paused=false;screen='\"'driving';menuIdle=0;resultsShown=false;netInputs=[null,null];sim.dev=false;sim.aiAll=false;audio.setScene('driving');renderHUD();},onInput(seat,input){netInputs[seat]={steer:input.steer,gas:input.throttle,brake:input.brake,recover:input.recover,safe:input.brake===1&&input.throttle===0};},onSnapshot(s){if(\"'!network.authoritative&&sim.applySnapshot(s)){if(sim.state==='\"'finished'&&\"'!resultsShown&&network.kind!=='\"'hub'){resultsShown=true;screen='results';renderResults();}}},onEnd(reason){active=false;paused=false;audio.setScene('off');screen='connection-ended';setUI(\"'`<div class=\"overlay\"><section class=\"dialog\"><h2>That’s the connection.</h2><p>${html(reason||'\"'The round has ended.')}</p>\"'${network.kind==='\"'hub'?'<p>The Hub will take it from here.</p>':button('network-lobby','Return to multiplayer','Reconnect or invite another driver','01',true)}</section></div>\"'`);},onStatus(text){networkStatus=text;const el=$('\"'#network-status');if(el)el.textContent=text;},onTimeUp(){if(sim.state\"'!=='\"'finished')sim.finish(sim.score[0]===sim.score[1]?'Time\"'! A sporting draw.'\"':'The Hub flag is down.');},onLeave(seat){if(seat\"'!==null&&seat>=0)netInputs[seat]={steer:0,brake:1,gas:0,safe:true};}});}\nnetwork=createNetwork();\nfunction startDrive(tour=false){active=true;paused=false;screen='\"'driving';resultsShown=false;sim.settings=settings;sim.dev=false;sim.aiAll=false;sim.invulnerable=false;sim.tuning={...DEFAULTS};sim.start({...setup,mode:tour?'tour':mode,classic:mode==='duel'&&setup.target===50});sim.discovered=new Set(passport);const r=records[recordKey()];sim.bestGhost=settings.ghost&&r?.version===1&&Array.isArray(r.ghost)?r.ghost:[];audio.setScene('driving');renderHUD();say(lastDevice==='touch'?'Drag left to steer. Hold right to brake.':'Brake before the turn. Release to go.',4);}\nfunction quit(){if(network.kind==='direct'){network.destroy();network=createNetwork();}active=false;paused=false;devOpen=false;freeCamera=false;keys.clear();touches.clear();audio.setScene('title');openScreen('title');}\nfunction pause(){if(\"'!active||screen==='\"'results')return;paused=\"'!paused;keys.clear();touches.clear();touchRecover=false;if(paused){screen='\"'pause';renderPause();}else{screen='driving';renderHUD();}}\nfunction back(){if(screen==='settings'){screen=active?'pause':'title';renderMenu();}else if(screen==='pause'||screen==='dev'||screen==='passport'&&active){paused=false;screen='driving';renderHUD();}else if(screen==='setup')openScreen(setup.humans===2?'multi':'quick');else if(screen==='connection')action('connection-back');else if(screen==='title'){}else openScreen('title');}\nasync function action(a){audio.unlock();audio.cue('gate');if(a==='back'){back();return;}if(a==='tour'){startDrive(true);return;}if(a==='quick'){if(network.kind==='direct'){network.destroy();network=createNetwork();}active=false;paused=false;setup.humans=1;openScreen('quick');return;}if(a==='multi'||a==='network-lobby'){if(network.kind==='direct'){network.destroy();network=createNetwork();}active=false;openScreen('multi');return;}if(a==='settings'){previousScreen=screen;screen='settings';renderSettings();return;}if(a==='credits'){creditPage=0;openScreen('credits');return;}if(a.startsWith('choose-')){mode=a.slice(7);setup.humans=1;openScreen('setup');return;}if(a==='couch'){mode='duel';setup.humans=2;openScreen('setup');return;}if(a.startsWith('course-')){setup.course=Number(a.slice(7));renderSetup();return;}if(a.startsWith('car-')){setup.profile=Number(a.slice(4));renderSetup();return;}if(a==='laps'){setup.laps=setup.laps===2?5:2;renderSetup();return;}if(a==='target'){setup.target=setup.target===10?50:10;renderSetup();return;}if(a==='opponent'){setup.opponent=(setup.opponent+1)%5;renderSetup();return;}if(a==='difficulty'){setup.difficulty=['easy','normal','hard'][(['easy','normal','hard'].indexOf(setup.difficulty)+1)%3];renderSetup();return;}if(a==='seats'){setup.seats=['auto','two pads','keys + pad','shared keys'][(['auto','two pads','keys + pad','shared keys'].indexOf(setup.seats)+1)%4];renderSetup();return;}if(a==='start'){startDrive();return;}if(a==='pause'){pause();return;}if(a==='resume'){paused=false;screen='driving';renderHUD();return;}if(a==='quit'){quit();return;}if(a==='restart'||a==='retry'){if(network.active){if(network.kind==='direct'&&network.authoritative)network.startDirect({...setup,cars:[setup.profile,setup.opponent]});else say('The host starts the rematch.');}else{if(sim.tourStep>=0){sim.startTourStage();screen='driving';paused=false;resultsShown=false;renderHUD();}else startDrive();}return;}if(a==='tour-next'){sim.continueTour();resultsShown=false;if(sim.tourCompl