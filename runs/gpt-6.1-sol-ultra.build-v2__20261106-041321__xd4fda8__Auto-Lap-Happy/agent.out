{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,collections\nr=json.load(open('evidence/test-all.json'));print(len(r));print(collections.Counter(x['name'].split()[0] for x in r));print([x['name'] for x in r[50:75]])\nPY\nsed -n '1,160p' tools/ui-test.py\"","aggregated_output":"259\nCounter({'Legal': 25, 'Tour': 20, 'actual': 18, 'Hub': 17, 'touch': 14, 'direct': 6, 'pad': 5, 'real': 4, 'delayed': 4, 'keyboard': 4, 'Classic': 3, 'attract': 3, 'WebKit': 3, 'Final': 3, 'Duel': 2, 'Full': 2, 'music': 2, 'master': 2, 'pause': 2, 'Complete': 2, 'Actorless': 2, 'fixture': 2, 'offer': 2, 'answer': 2, 'matched': 2, 'guest': 2, 'host': 2, 'reordered': 2, 'stale': 2, 'authoritative': 2, 'late': 2, 'malformed': 2, 'truncated': 2, 'wrong': 2, 'incompatible': 2, 'duplicate': 2, 'peer': 2, 'standard': 2, 'Xbox': 2, 'dev': 2, 'credits': 2, 'clipboard': 2, 'invitation': 2, 'legitimate': 2, 'remote': 2, 'input-driven': 2, 'online': 2, 'authority': 2, 'common': 2, 'Couch': 2, 'World': 1, 'Four': 1, 'Countdown': 1, 'Long': 1, 'Partial': 1, 'Road,': 1, 'Directed': 1, 'Skipping': 1, 'Teleport': 1, 'Crash': 1, 'Lead': 1, 'Wrong-way/invalid': 1, 'Winning': 1, 'Deadline': 1, 'Manual': 1, 'Time': 1, 'Coincident': 1, 'Real': 1, 'Connected': 1, 'Free': 1, 'Live': 1, 'Snapshots': 1, 'Native': 1, 'original': 1, 'engine': 1, 'all': 1, 'gibberish': 1, 'stop': 1, 'retries': 1, 'retry': 1, 'destroy': 1, 'Compact': 1, 'file': 1, 'last': 1, 'quick': 1, 'setup': 1, 'Options': 1, 'local': 1, 'settings': 1, 'reconnected': 1, 'developer': 1, 'multiplayer': 1, 'TV': 1, 'stationary': 1, 'no': 1, 'portrait': 1, 'Title': 1, 'Six': 1, 'Five-lap': 1, 'Valid': 1, 'Retry': 1, 'Shared': 1, 'Two-human': 1, 'Local': 1, 'Every': 1, 'Single': 1, 'All': 1, 'Exit': 1})\n['Snapshots restore both cars, route and authoritative score', 'Native 80-degree overhead render and procedural shapes draw headlessly', 'music initial gain exactly .10', 'original score emits bounded samples', 'engine and tyre oscillators emit bounded samples', 'all effect cues render without clipping', 'gibberish voice emits distinct signal', 'master mute silences every bus', 'master zero silences loops and effects', 'music slider changes measured output', 'stop clears transient cues and silences old scene', 'pause silences engine and score', 'retries reuse engine and bound active notes', 'retry cleanup leaves no runaway signal', 'destroy disconnects all sources', 'Hub ready needs no gesture', 'Hub deterministic config', 'Hub authoritative seat', 'Hub host emits state', 'Hub validates sender and sequence', 'Hub stale input brakes', 'Complete two-car snapshot fits one unreliable envelope', 'Compact wire restores route legality and velocities', 'Hub time-up finishes once with actual scores', 'Hub best-first standings']\n\"\"\"UI/input checks on the actual bundled game; root test.mjs consumes JSON results.\"\"\"\nfrom pathlib import Path\nimport json\nimport os\nfrom playwright.sync_api import sync_playwright\n\nBASE=Path(__file__).resolve().parents[1]\nFINAL=BASE.parent/(BASE.name+'.html')\nURL=os.environ.get('HAPPY_UI_URL',FINAL.resolve().as_uri())\nEVIDENCE=BASE/'evidence'\nPAD=\"\"\"window.__pads=[{index:0,connected:true,id:'Playwright DualSense stand-in',mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))}];navigator.getGamepads=()=>window.__pads;\"\"\"\n\ndef run():\n    results=[]\n    errors=[]\n    def check(name,ok,detail=''):\n        results.append({'name':name,'pass':bool(ok),'detail':'' if ok else str(detail)})\n        (EVIDENCE/'ui-results.json').write_text(json.dumps(results,indent=2))\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True)\n        context=browser.new_context(viewport={'width':1920,'height':1080})\n        context.add_init_script(PAD)\n        page=context.new_page()\n        page.on('pageerror',lambda e:errors.append(str(e)))\n        page.goto(URL)\n        page.wait_for_function('window.__happy')\n        page.wait_for_timeout(80)\n        page.evaluate('__happy.game.stop()')\n        def step(t=.025): page.evaluate('(t)=>__happy.step(t)',t)\n        def press(button=None,axes=None):\n            page.evaluate('({button,axes})=>{let p=__pads[0];p.buttons.forEach((b,i)=>{b.pressed=i===button;b.value=i===button?1:0});p.axes=axes||[0,0,0,0]}',{'button':button,'axes':axes})\n            step(.25)\n            page.evaluate('__pads[0].buttons.forEach(b=>{b.pressed=false;b.value=0});__pads[0].axes=[0,0,0,0]')\n            step(.05)\n            page.wait_for_timeout(25)\n        def click(a): page.locator(f'[data-action=\"{a}\"]').first.click();page.wait_for_timeout(25)\n        def focus(): return page.evaluate('document.activeElement?.dataset.action||document.activeElement?.dataset.setting||document.activeElement?.dataset.tune||document.activeElement?.id')\n        def state(): return page.evaluate('__happy.snapshot()')\n        check('file bundle opens at title',page.evaluate('__happy.screen')=='title')\n        page.screenshot(path=str(EVIDENCE/'ui-title-tv.png'))\n        press(13)\n        check('standard pad moves title focus',focus()=='quick',focus())\n        check('last pad input updates visible menu glyphs','✕' in page.locator('.footer').inner_text(),page.locator('.footer').inner_text())\n        press(0)\n        check('standard pad confirms quick-play screen',page.evaluate('__happy.screen')=='quick')\n        press(15)\n        check('pad spatial focus reaches time trial',focus() in ('choose-trial','choose-duel','choose-free'),focus())\n        # Pad-only reachability checks for every enabled choice on each common screen.\n        def reachable(name):\n            selector='#ui button:not(:disabled),#ui input:not(:disabled):not([type=file]),#ui select,#ui textarea'\n            all_actions=page.evaluate('(sel)=>[...document.querySelectorAll(sel)].map(e=>e.dataset.action||e.dataset.setting||e.dataset.tune||e.id)',selector)\n            def current_index(): return page.evaluate('(sel)=>[...document.querySelectorAll(sel)].indexOf(document.activeElement)',selector)\n            seen={current_index()}; frontier=[current_index()]\n            while frontier:\n                current=frontier.pop()\n                for b in [12,13,14,15]:\n                    page.evaluate('({sel,i})=>document.querySelectorAll(sel)[i]?.focus()',{'sel':selector,'i':current})\n                    press(b)\n                    dest=current_index()\n                    if dest not in seen:seen.add(dest);frontier.append(dest)\n            missing=[name for i,name in enumerate(all_actions) if i not in seen]\n            check(name+' pad directional graph reaches every control',not missing,missing)\n        reachable('quick play')\n        click('choose-trial')\n        reachable('setup')\n        page.screenshot(path=str(EVIDENCE/'ui-setup-tv.png'))\n        click('start')\n        step(3.2)\n        page.keyboard.down('Space');step(1.5)\n        check('keyboard brake holds car at rest',abs(page.evaluate('__happy.sim.cars[0].speed'))<.1,page.evaluate('__happy.sim.cars[0].speed'))\n        page.keyboard.up('Space');step(.6)\n        check('keyboard release resumes auto acceleration',page.evaluate('__happy.sim.cars[0].speed')>1)\n        page.evaluate('__happy.game.advance(.01,{draw:true})');page.screenshot(path=str(EVIDENCE/'ui-race-tv.png'))\n        press(9)\n        check('Options opens local pause menu',page.evaluate('__happy.screen')=='pause')\n        before=page.evaluate('__happy.sim.t');step(2)\n        check('local pause freezes simulation',page.evaluate('__happy.sim.t')==before)\n        reachable('pause')\n        click('settings');reachable('settings')\n        page.locator('[data-setting=glyphs]').select_option('xbox')\n        check('Xbox glyph selection changes saved setting',page.evaluate('__happy.settings.glyphs')=='xbox')\n        page.keyboard.press('Escape');press(9);step(.15)\n        check('Xbox driving prompts follow pad input','Y' in page.locator('.controlhint').inner_text(),page.locator('.controlhint').inner_text())\n        page.evaluate('window.__savedPad=__pads[0];__pads=[]');step(.05)\n        check('pad disconnect pauses local round safely',page.evaluate('__happy.screen')=='pause')\n        page.evaluate('__pads=[__savedPad]');press(9)\n        check('reconnected pad can resume without seat reassignment',page.evaluate('__happy.screen')=='driving')\n        press(9);click('dev');reachable('developer')\n        slider=page.locator('[data-tune=speed]');old=page.evaluate('__happy.sim.tuning.speed')\n        slider.focus();press(15)\n        check('pad changes live dev slider',page.evaluate('__happy.sim.tuning.speed')>old)\n        check('dev tuning marks run unranked',page.evaluate('__happy.sim.dev'))\n        click('dev-reset');check('dev reset restores defaults',page.evaluate('__happy.sim.tuning.speed')==1)\n        click('dev-back');click('quit')\n        click('multi');reachable('multiplayer')\n        click('host');reachable('direct invitation')\n        if page.locator('[data-action=import]').count():\n            page.locator('[data-action=import]').focus()\n            with page.expect_file_chooser() as chooser:press(0)\n            chooser.value.set_files([])\n            check('pad import action opens real file chooser',True)\n        else:check('pad import action opens real file chooser',False,'No focusable import action')\n        click('connection-back');click('join');reachable('direct reply')\n        click('connection-back');click('back')\n        click('credits');reachable('credits')\n        check('TV credits use readable large text',page.evaluate('parseFloat(getComputedStyle(document.querySelector(\".creditbody\")).fontSize)')>=24)\n        page.screenshot(path=str(EVIDENCE/'ui-source-tv.png'))\n        for i in range(5):\n            click('credit-next')\n            if i in [1,2,3]: page.screenshot(path=str(EVIDENCE/f'ui-feedback-{i}-tv.png'))\n        check('credits expose source and every feedback category',page.evaluate('document.querySelector(\".eyebrow\").textContent').endswith('6 / 6'))\n        click('back')\n        # Deterministic inactivity boundary; stopped RAF keeps wall time out of assertions.\n        saves=page.evaluate('JSON.stringify({...localStorage})')\n        page.evaluate('__happy.setIdle(9.89)');step(.009)\n        check('attract absent before 9.9 seconds',not page.evaluate('__happy.attracting'))\n        step(.12)\n        check('attract begins after ten seconds',page.evaluate('__happy.attracting'))\n        step(15)\n        check('attract does not write player saves',page.evaluate('JSON.stringify({...localStorage})')==saves)\n        page.keyboard.press('Enter');step(.02)\n        check('keyboard exits attract and consumes confirm',page.evaluate('__happy.screen')=='title' and not page.evaluate('__happy.attracting'))\n        page.evaluate('__happy.setIdle(10)');step(.01);press(0)\n        check('pad exits attract and consumes confirm',page.evaluate('__happy.screen')=='title' and not page.evaluate('__happy.attracting'))\n        page.mouse.move(250,485);page.evaluate('__happy.setIdle(10)');step(.01)\n        page.mouse.click(250,485);step(.02)\n        check('stationary mouse click exits attract without activating a choice',page.evaluate('__happy.screen')=='title' and not page.evaluate('__happy.attracting'),page.evaluate('__happy.screen'))\n        if page.evaluate('__happy.screen')!='title':page.evaluate('__happy.action(\"quit\")')\n        # Confirm normal device changes restore keyboard prompts.\n        page.keyboard.press('ArrowDown');page.wait_for_timeout(30)\n        check('keyboard input restores visible keyboard menu prompts','Enter' in page.locator('.footer').inner_text(),page.locator('.footer').inner_text())\n        check('no uncaught UI runtime errors',not errors and not page.evaluate('__happy.errors'),errors or page.evaluate('__happy.errors'))\n        context.close()\n        for name,width,height in [('landscape',844,390),('portrait',390,844)]:\n            ctx=browser.new_context(viewport={'width':width,'height':height},is_mobile=True,has_touch=True,device_scale_factor=1)\n            pg=ctx.new_page();pg.on('pageerror',lambda e:errors.append(str(e)));pg.goto(URL);pg.wait_for_function('window.__happy');pg.wait_for_timeout(50);pg.evaluate('__happy.game.stop()')\n            pg.screenshot(path=str(EVIDENCE/f'ui-touch-{name}-title.png'))\n            pg.locator('[data-action=quick]').tap();pg.locator('[data-action=choose-trial]').tap();pg.screenshot(path=str(EVIDENCE/f'ui-touch-{name}-setup.png'))\n            box=pg.locator('[data-action=start]').bounding_box()\n            check(f'touch {name} setup has a reachable drive control',box and box['width']>100,box)\n            # Use physical touch gestures to check menu scrolling rather than locator auto-scroll.\n            if name=='portrait':\n                initial=pg.evaluate('document.querySelector(\".screen\").scrollTop')\n                client=ctx.new_cdp_session(pg)\n                client.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':width/2,'y':height*.8}]})\n                for fraction in [.7,.6,.5,.4,.3,.2]:client.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':width/2,'y':height*fraction}]})\n                client.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]});pg.wait_for_timeout(100)\n                after=pg.evaluate('document.querySelector(\".screen\").scrollTop')\n                check('portrait touch gesture scrolls setup to offscreen controls',after>initial,{'before':initial,'after':after})\n            pg.locator('[data-action=start]').tap();pg.evaluate('__happy.step(3.3);__happy.game.advance(.01,{draw:true})')\n            check(f'touch {name} driving prompts use touch gestures','Hold right' in pg.locator('.controlhint').inner_text(),pg.locator('.controlhint').inner_text())\n            angle_before=pg.evaluate('__happy.sim.cars[0].angle')\n            pg.screenshot(path=str(EVIDENCE/f'ui-touch-{name}-race.png'))\n            client=ctx.new_cdp_session(pg)\n            client.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'id':1,'x':width*.2,'y':height*.72},{'id':2,'x':width*.8,'y':height*.72}]})\n            client.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'id':1,'x':width*.2+70,'y':height*.72},{'id':2,'x':width*.8,'y':height*.72}]})\n            pg.evaluate('__happy.step(.5)')\n            c=pg.evaluate('({speed:__happy.sim.cars[0].speed,angle:__happy.sim.cars[0].angle})')\n            check(f'touch {name} simultaneous brake stops car',abs(c['speed'])<.1,c)\n            check(f'touch {name} simultaneous steering changes heading',abs(c['angle']-angle_before)>.03,c)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc 'head -35 tools/audio-test.py && tail -25 tools/audio-test.py && cat tools/audio-test.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc 'head -35 tools/audio-test.py && tail -25 tools/audio-test.py && cat tools/audio-test.mjs'","aggregated_output":"\"\"\"Actual Web Audio signal checks; called by the project's single test entry point.\"\"\"\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\n\nBASE = Path(__file__).resolve().parents[1]\nSCRIPT = (BASE / \"src/audio.js\").read_text()\n\ndef run(page):\n    page.add_script_tag(content=SCRIPT)\n    return page.evaluate(\"\"\"async () => {\n      const results = [];\n      function check(name, ok, detail='') { results.push({name, pass:!!ok, detail:ok?'':detail}); }\n      async function render(volumes, scene, action) {\n        const context = new OfflineAudioContext(1, 44100 * 2, 44100);\n        const audio = new HappyAudio(volumes, context);\n        await audio.unlock(); audio.setScene(scene);\n        audio.update(1/60, {speed:80,maxSpeed:100,slip:.7,surface:'gravel'});\n        if (action) action(audio);\n        const output = await context.startRendering();\n        const data = output.getChannelData(0);\n        let energy=0,peak=0,finite=true,tail=0;\n        for (let i=0;i<data.length;i++) {\n          finite &&= Number.isFinite(data[i]);\n          peak=Math.max(peak,Math.abs(data[i])); energy+=data[i]*data[i];\n          if (i>44100) tail+=data[i]*data[i];\n        }\n        return {audio, rms:Math.sqrt(energy/data.length), peak, finite, tail:Math.sqrt(tail/44100)};\n      }\n      const music = await render({sfx:0,voice:0},'title');\n      check('music initial gain exactly .10', music.audio.settings.music===.1 && Math.abs(music.audio.buses.music.gain.value-.1)<1e-7, music.audio.buses.music.gain.value);\n      check('original score emits bounded samples', music.rms>0.00001 && music.peak<.95 && music.finite, JSON.stringify(music));\n      const engine = await render({music:0,voice:0},'driving');\n      check('engine and tyre oscillators emit bounded samples',engine.rms>.001&&engine.peak<.95&&engine.finite,JSON.stringify({rms:engine.rms,peak:engine.peak}));\n      const effects = await render({music:0,voice:0},'off', a=>['countdown','go','gate','lap','crash','water','recover','point','finish','discovery'].forEach(n=>a.cue(n)));\n      const muted = await render({mute:true},'driving',a=>{a.cue('finish');a.gibberish();});\n      check('master mute silences every bus',muted.peak===0,muted.peak);\n      const zero = await render({master:0},'driving',a=>a.cue('crash'));\n      check('master zero silences loops and effects',zero.peak===0,zero.peak);\n      const quieter = await render({music:.025,sfx:0,voice:0},'title');\n      check('music slider changes measured output',quieter.rms<music.rms*.4&&quieter.rms>0,JSON.stringify({quiet:quieter.rms,normal:music.rms}));\n      const stopped = await render({},'driving',a=>{a.cue('finish');a.stop();});\n      check('stop clears transient cues and silences old scene',stopped.tail<.00001,stopped.tail);\n      const paused = await render({},'driving',a=>a.update(1/60,{paused:true}));\n      check('pause silences engine and score',paused.tail<.00001,paused.tail);\n      const retries = await render({},'title',a=>{const e=a.engineA;for(let i=0;i<30;i++){a.setScene('driving');a.update(.02,{speed:50});a.setScene('results');a.update(.02,{});a.setScene('title');}check('retries reuse engine and bound active notes',a.engineA===e&&a.sources.size<30,a.sources.size);a.stop();});\n      check('retry cleanup leaves no runaway signal',retries.tail<.00001,retries.tail);\n      const destroyed = await render({},'driving',a=>a.destroy());\n      check('destroy disconnects all sources',destroyed.peak===0,destroyed.peak);\n      return results;\n    }\"\"\")\n\nif __name__ == \"__main__\":\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n        page.set_content(\"<!doctype html><title>Auto Lap Happy audio verification</title>\")\n        results = run(page)\n        browser.close()\n    print(json.dumps(results))\nimport { spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nexport function runAudioTests() {\n\tconst script = fileURLToPath(new URL(\"./audio-test.py\", import.meta.url));\n\tconst out = spawnSync(\n\t\t\"/home/micha/.local/share/pipx/venvs/playwright/bin/python\",\n\t\t[script],\n\t\t{ encoding: \"utf8\", timeout: 60000 },\n\t);\n\tif (out.status !== 0)\n\t\treturn [\n\t\t\t{\n\t\t\t\tname: \"Web Audio rendering\",\n\t\t\t\tpass: false,\n\t\t\t\tdetail: out.stderr || out.error?.message || `Exited ${out.status}`,\n\t\t\t},\n\t\t];\n\ttry {\n\t\treturn JSON.parse(out.stdout);\n\t} catch (error) {\n\t\treturn [\n\t\t\t{ name: \"Web Audio test output\", pass: false, detail: error.message },\n\t\t];\n\t}\n}\nif (process.argv[1] === fileURLToPath(import.meta.url)) {\n\tconst results = runAudioTests();\n\tfor (const r of results)\n\t\tif (!r.pass) console.error(`FAIL ${r.name}: ${r.detail}`);\n\tconsole.log(\n\t\t`${results.filter((r) => r.pass).length}/${results.length} audio checks passed`,\n\t);\n\tprocess.exitCode = results.some((r) => !r.pass) ? 1 : 0;\n}\n","exit_code":0,"status":"completed"}}
