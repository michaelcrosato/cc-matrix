0,recover:false,safe:true};b={...a};}\n return [a,b];}\nfunction pollPads(dt){menuRepeat=Math.max(0,menuRepeat-dt);const pads=[...navigator.getGamepads?.()||[]].filter(Boolean);if(lastPadCount>pads.length&&active){keys.clear();if(\"'!network.active&&!paused){pause();say('\"'Controller disconnected. Reconnect or use the keyboard.',5);}else say('Controller disconnected. Your seat is braking safely.',5);}lastPadCount=pads.length;\n for(const p of pads){const prev=padState.get(p.index)||[],buttons=p.buttons.map(b=>b.pressed),axis=p.axes.map(v=>Math.abs(v)>.25?v:0),change=buttons.some((v,i)=>v&&\"'!prev[i]),moving=axis.some(v=>Math.abs(v)>.3);padState.set(p.index,buttons);if(!change&&!moving)continue;if(meaningful('\"'pad')){menuRepeat=.3;continue;}audio.unlock();if(buttons[9]&&\"'!prev[9]&&!buttons[8]){if(screen==='\"'driving')pause();else if(active&&paused){paused=false;screen='driving';renderHUD();}continue;}if(\"'!driving()&&menuRepeat<=0){const dx=buttons[14]?-1:buttons[15]?1:Math.abs(axis[0])>.5?Math.sign(axis[0]):0,dy=buttons[12]?-1:buttons[13]?1:Math.abs(axis[1])>.5?Math.sign(axis[1]):0;if(dx||dy){menuMove(dx,dy);menuRepeat=.2;}if(buttons[0]&&!prev[0]){const el=document.activeElement;if(el?.dataset.action)action(el.dataset.action);}if(buttons[1]&&!prev[1])back();}}\n}\nfunction renderHUD(){if(screen!=='\"'driving')return;const c=sim.cars[network.localSeat??0]||sim.cars[0];if(\"'!c)return;const duel=sim.mode==='\"'duel',tour=sim.tourStep>=0,r=c.route,points=sim.score,route=sim.course;const next=route.gates[r.gate],mini=\"'`<svg viewBox=\"${Math.min(...route.samples.map(p=>p.x))-160} ${Math.min(...route.samples.map(p=>p.y))-160} ${Math.max(...route.samples.map(p=>p.x))-Math.min(...route.samples.map(p=>p.x))+320} ${Math.max(...route.samples.map(p=>p.y))-Math.min(...route.samples.map(p=>p.y))+320}\"><path d=\"${route.samples.filter((_,i)=>i%4===0).map((p,i)=>(i?'\"'L':'M')+p.x+','+p.y).join(' ')} Z\\\" stroke=\\\"#a6bea1\\\" fill=\\\"none\\\" stroke-width=\\\"40\\\"/><circle cx=\\\"\"'${next.x}\" cy=\"${next.y}\" r=\"95\" fill=\"#e9c565\"/>${sim.cars.map((a,i)=>`<circle cx=\"${a.x}\" cy=\"${a.y}\" r=\"90\" fill=\"${PROFILES[a.profile].color}\" stroke=\"#142e32\" stroke-width=\"20\"/>`).join('\"'')}</svg>\"'`;let goal='\"'';if(tour){const step=TOUR[sim.tourStep];goal=\"'`<aside class=\"tourcue\"><strong>${step.title}</strong>${step.text}<small>${sim.t<8?step.tip:sim.tourStep===0?sim.tourDemonstrated.brake?'\"'Good braking\"'! Follow the numbered gates.'\"':'Hold the brake to settle your speed.':step.tip}</small></aside>\"'`;}else if(sim.mode==='\"'free')goal=\"'`<aside class=\"tourcue\"><strong>THE WHOLE VALLEY IS YOURS</strong>Visit the numbered paddocks. Follow the lanes between circuits.<small>${passport.length}/6 passport stamps · Pause to see the valley map.</small></aside>`;\n ui.innerHTML=`<div class=\"hud\"><div class=\"hudtop\"><div class=\"hudplate\"><div class=\"label\">${network.kind==='\"'hub'?'AI HUB · ':network.kind==='direct'?'DIRECT DUEL · ':''}\"'${route.name}</div><div class=\"big\">${duel?`${points[0]} <span style=\"color:#9eb89e\">:</span> ${points[1]}`:sim.mode==='\"'free'?'FREE DRIVE':\"'`LAP ${Math.min(r.lap+1,sim.laps)} <span style=\"color:#9eb89e\">/ ${sim.laps}</span>`}</div><div class=\"sub\">${duel?`FIRST TO ${sim.target} · CRASH +2 · LEAD +1`:sim.mode==='\"'free'?'NO RACE RULES · FIND YOUR OWN ROAD':\"'`GATE ${r.gate||12} / 12${sim.penalty?` · +${sim.penalty}s PENALTY`:'\"''}\"'`}</div></div><div class=\"hudright\"><div class=\"hudplate\"><div class=\"label\">${duel?'\"'TIME LEFT':'RUN TIME'}</div><div class=\\\"big\\\">\"'${formatTime(duel?Math.max(0,sim.limit-sim.t):sim.t)}</div><div class=\"sub\">${sim.dev?'\"'PRACTICE · UNRANKED':settings.auto?'AUTOMATIC ACCELERATION':'MANUAL THROTTLE'}</div></div><button class=\\\"pausebutton\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div>\"'${goal}<div class=\"minimap\">${mini}</div><div class=\"speedplate\"><span class=\"digits\">${Math.round(Math.abs(c.speed)*.58).toString().padStart(2,'\"'0')}</span><div class=\\\"unit\\\">KM/H<br>\"'${c.surface?.toUpperCase()||'\"'ROAD'}</div></div><div class=\\\"controlhint\\\"><span><b class=\\\"key\\\">\"'${glyph('\"'steer')}</b> Steer</span><span><b class=\\\"key\\\">\"'${glyph('\"'brake')}</b> Brake</span><span><b class=\\\"key\\\">\"'${glyph('\"'recover')}</b> Hold to recover</span>\"'${sim.humans===2&&!network.active?'\"'<span>2P: arrows · ↓ brake · RShift recover</span>':''}</div>\"'${sim.state==='\"'countdown'||sim.state==='exchange'?\"'`<div class=\"countdown\">${Math.ceil(sim.countdown)||'\"'GO'}</div>\"'`:'\"''}\"'${r.wrong?'\"'<div class=\\\"centerbanner\\\"><small>WRONG WAY</small>Turn back toward the next gate ↶</div>':\"'!r.valid?'\"'<div class=\\\"centerbanner\\\"><small>RETURN TO ROUTE</small>Hold Recover to return to the last gate.</div>':sim.messageT>0?\"'`<div class=\"centerbanner\"><small>HAPPY VALLEY RACE CONTROL</small>${html(sim.message)}</div>`:'\"''}\"'${c.crashed>0||c.stuck>2?'\"'<button class=\\\"recoverbutton\\\" data-recover=\\\"true\\\">Hold to recover ↺</button>':''}\"'${sim.dev?'\"'<div class=\\\"devbadge\\\">DEV PRACTICE · RECORDS DISABLED</div>':''}\"'${toastT>0?`<div class=\"toast\">${html(toast)}</div>`:'\"''}</div>\"'`;\n}\nfunction enterAttract(){if(network.active||active||screen==='\"'connection')return;attracting=true;attractAge=0;attractIndex=0;attractReturn={screen,focus:focusIndex};attractSim=new HappySim(world,settings);attractSim.attract=true;attractSim.aiAll=true;attractSim.start({mode:'trial',course:0,profile:2,laps:1});ui.innerHTML='<div class=\\\"demo\\\"><strong>DEMO · AUTO LAP HAPPY</strong>Any button brings you back to the club.</div>';audio.setScene('driving');}\nfunction exitAttract(){if(\"'!attracting)return;attracting=false;attractSim=null;menuIdle=0;screen=attractReturn?.screen||'\"'title';renderMenu();requestAnimationFrame(()=>focusAt(attractReturn?.focus||0));audio.setScene('title');keys.clear();}\nfunction currentGhost(){if(\"'!settings.ghost||sim.mode!=='\"'trial'||\"'!sim.bestGhost?.length)return null;const a=sim.bestGhost;let i=Math.floor(sim.t*10);i=clamp(i,0,a.length-1);if(a[i]?.length!==4)return null;return {x:a[i][1],y:a[i][2],angle:a[i][3],profile:sim.cars[0].profile};}\nsim.onEvent=e=>{if(e.type==='\"'countdown')audio.cue('countdown');if(['go','gate','lap','water','crash','recover','point','finish','discovery'].includes(e.type))audio.cue(e.type);if(['point','finish','discovery'].includes(e.type))audio.gibberish();if(e.type==='discovery'&&\"'!sim.dev&&!network.active){if(!passport.includes(e.id)){passport.push(e.id);store.write('\"'passport',passport);}}if(e.type==='finish'){saveResult();if(network.active&&network.authoritative)network.finish(sim.score);}};\nfunction update(dt){gameTime+=dt;toastT=Math.max(0,toastT-dt);pollPads(dt);const input=getInputs();\n if(attracting){attractAge+=dt;attractSim.step(dt);if(attractSim.state==='finished'||attractAge>115){attractAge=0;attractIndex=(attractIndex+1)%7;attractSim.start({mode:attractIndex===5?'free':attractIndex===6?'duel':'trial',course:attractIndex%5,profile:attractIndex%5,laps:1,target:2,humans:0});attractSim.aiAll=true;attractSim.attract=true;}if(attractIndex===5&&attractAge>25)attractAge=116;}\n else if(active){\n  if(network.active){const seat=network.localSeat,local=seat===null?{steer:0,brake:1,gas:0}:input[0];network.update(dt,network.authoritative?sim.snapshot():null,{steer:local.steer,brake:local.brake,throttle:settings.auto&&local.brake<.025&&\"'!local.safe?1:local.gas,recover:local.recover});if(network.authoritative&&network.clock()>=0){const controls=[...netInputs];if(seat!==null)controls[seat]=local;sim.step(dt,controls);}if(network.clock()<0){sim.countdown=Math.max(0,-network.clock());}}\n  else if(!paused)sim.step(dt,input);\n  if(sim.state==='\"'finished'&&\"'!resultsShown&&network.kind!=='\"'hub'){resultsShown=true;screen='results';renderResults();}\n  hudAge+=dt;if(screen==='driving'&&hudAge>.1){hudAge=0;renderHUD();}\n }else{vignette.step(dt);if(vignette.state==='finished')vignette.start({mode:'trial',course:0,profile:2,laps:50});if(\"'!['\"'connection','connection-ended'].includes(screen)){menuIdle+=dt;if(menuIdle>=10)enterAttract();}}\n const scene=attracting?attractSim:active?sim:vignette,cars=scene.cars,c=cars[0];if(c){if(freeCamera&&active){const m=keyboardIntent(0,false);game.focus((game.cam.tx||c.x)+m.steer*220*dt,(game.cam.ty||c.y)+((keys.has('KeyS')?1:0)-(keys.has('KeyW')?1:0))*220*dt,0);}else if(cars.length===2){game.focus((cars[0].x+cars[1].x)/2,(cars[0].y+cars[1].y)/2-35,0);}else{const lead=settings.reduced?40:70,x=c.x+Math.cos(c.angle)*lead,y=c.y+Math.sin(c.angle)*lead;game.focus(x-(\"'!active&&!attracting?game.W/game.view.scale*.20:0),y-35,0);}renderer.update(dt,scene);audio.update(dt,{speed:c.speed,maxSpeed:c.o.top,slip:c.slide,surface:c.surface,brake:input[0].brake,paused:paused&&!network.active});}\n}\nfunction draw(r){const scene=attracting?attractSim:active?sim:vignette;renderer.draw(r,scene,{menu:!active&&!attracting,dev:devOpen,ghost:currentGhost()});if(attracting)r.text(`${String(attractIndex%5+1).padStart(2,'\"'0')}  \"'${scene.course.name.toUpperCase()}`,r.W/2,14,'\"'#fff4cf',{align:'center',scale:2,shadow:'#17373b'});}\ngame.start({scene:'drive',scenes:{drive:{pausable:false,view:'topdown',update,draw}}});game.audio.set?.({music:0});game.debug={snapshot:()=>({screen,paused,attracting,network:{kind:network.kind,authority:network.authoritative,seat:network.localSeat},...sim.snapshot()} )};\nwindow.__happy={game,sim,world,audio,get network(){return network;},get screen(){return screen;},get attracting(){return attracting;},get settings(){return settings;},get passport(){return [...passport];},start(c){if(network.active)throw Error('Tests cannot change an online round.');Object.assign(setup,c);mode=c.mode||'trial';startDrive(c.mode==='tour');},action,step(seconds,inputs){if(network.active)throw Error('Tests cannot advance online authority.');testInputs=inputs||null;game.advance(seconds,{draw:false});testInputs=null;},input(inputs){if(network.active)throw Error('Tests cannot inject online inputs.');testInputs=inputs;},snapshot:()=>game.debug.snapshot(),setIdle(seconds){if(network.active)throw Error('Online idle is disabled.');menuIdle=seconds;},errors:game.errors};\nrenderMenu();network.connectHub().then(info=>{if(info){store.write=()=>{};settings={...defaults};sim.settings=settings;audio.setVolumes(settings);}}).catch(err=>say('Hub connection: '+err.message,8));\n})();\nEOF\nnode Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/tools/build.mjs\"","aggregated_output":"Built Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321.html (1398 KiB)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The five-course world is built, and scripted drivers have completed legal laps with all five cars. Testing caught a tight kink near Meadow Mile’s finish; that’s fixed. The menus, race HUD, settings, dev tools, synthesized audio, and single-file build are in place. I’m now checking the complete tour and multiplayer against the finished page.\n"}}
