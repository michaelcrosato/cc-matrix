{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"head -50 Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/render.js && tail -35 Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/world.js && sed -n '1,100p' Auto-Lap-Happy-Auto-Racing-gpt-6.1-sol-ultra-20261106-041321/src/network.js\"","aggregated_output":"/* Native shaded-pixel countryside, original vehicles and procedural animation. */\n(() => {\n'use strict';\nconst E=My3D2dge,px=E.px,TAU=Math.PI*2;\nconst COLORS=['#f4eed6','#62b978','#ed634e','#d5b17c','#639cd3'];\nconst plain=c=>({color:c,pattern:'none'});\nE.MATERIALS.happyAsphalt={color:'#666d6d',pattern:'speck',amount:.13,scale:3};\nE.SHAPES.happyWheel={about:'small racing tyre with silver hub',mats:{t:plain('#252d36'),h:plain('#aaaeb0')},parts:[['box','t',[0,0,0],[3.8,6.2,4.5]],['box','h',[0,0,4.5],[2,2.8,.5]]]};\nconst bodies=[\n[['box','paint',[0,-1,3],[9,21,3]],['wedge','paint',[0,8,3],[8,6,3]],['box','stripe',[0,6,6],[2.1,8,.4]],['box','dark',[0,-2,6],[6.2,8,2]],['box','glass',[0,1.5,7.7],[5.8,2.7,.5]],['box','paint',[0,-7.5,6],[8,5,1.5]],['box','stripe',[0,-7.5,7.6],[2,5,.4]]],\n[['box','paint',[0,0,3],[10.5,20,3.7]],['wedge','paint',[0,9,3],[8,5,3.7]],['box','glass',[0,0,6.8],[7.7,7.5,2.6]],['box','paint',[0,-1,9.5],[8,4,1]],['box','stripe',[-3.6,6,7],[1,7,.5]],['box','stripe',[3.6,6,7],[1,7,.5]],['box','dark',[0,-9,3],[11,2,2]]],\n[['box','paint',[0,0,3],[8.8,22,3.5]],['wedge','paint',[0,10,3],[7,5,3]],['box','dark',[0,-1,6.5],[6.6,8,2.4]],['box','stripe',[0,7,6.7],[2,7,.5]],['box','paint',[0,-7,6.5],[8.7,5,2]],['box','stripe',[0,-7,8.6],[2,5,.4]],['box','paint',[0,-10,6],[14,2,1.2]]],\n[['box','paint',[0,0,3],[8.5,22,3]],['wedge','paint',[0,9,3],[6.5,6,3]],['box','dark',[0,-1,6],[6.5,8,2]],['box','paint',[0,-7,6],[9,5,1.5]],['box','stripe',[0,7,6.5],[1.6,8,.5]],['box','paint',[0,-10,6],[14.5,2,1.5]]],\n[['box','paint',[0,0,3],[9.5,21,3.3]],['wedge','paint',[0,9,3],[7,6,3]],['box','glass',[0,-.5,6.5],[7,8,2.7]],['box','paint',[0,-1,9.3],[6,4,1]],['box','stripe',[-2.8,7,6.7],[1.5,7,.5]],['box','stripe',[2.8,7,6.7],[1.5,7,.5]],['box','paint',[0,-10,6],[14,2,1.5]]]\n];\nfor(let i=0;i<5;i++)E.SHAPES['happyCar'+i]={about:['Mallow club racer','Clover sprint coupe','Poppy Grand Prix car','Sandpiper fastback','Bluebird touring coupe'][i],mats:{paint:plain(COLORS[i]),stripe:plain(i===0?'#cc5949':'#f8efd8'),dark:plain('#263640'),glass:plain('#75bbc4')},parts:[...bodies[i],['ball','helmet',[0,-1,9],2.2,{sz:.8}],['box','black',[0,.4,9],[3.5,1,.6]],['mirror','x',['box','lamp',[3,10,4],[1.8,1.5,1]]]],};\n// Register material slots explicitly, preserving upstream native shading.\nfor(let i=0;i<5;i++)Object.assign(E.SHAPES['happyCar'+i].mats,{helmet:plain('#fff0cf'),black:plain('#29303a'),lamp:plain('#fff3ab')});\nE.SHAPES.happyBarn={about:'red apple barn with cream doors and slate roof',mats:{w:{color:'#b95744',pattern:'planks',dir:'v'},r:{color:'#56616c',pattern:'shingles'},d:plain('#f4dfb0'),g:plain('#5ba9b4')},parts:[['box','w',[0,0,0],[65,46,34]],['prism','r',[0,0,34],[[-34,0],[34,0],[0,21]],50,{axis:'y'}],['box','d',[0,23,0],[22,1,26]],['box','w',[0,24,0],[2,1,26]],['box','g',[-22,24,17],[9,1,9]],['box','g',[22,24,17],[9,1,9]]]};\nE.SHAPES.happyPaddock={about:'cream race club hut with striped awning',mats:{w:{color:'#ecddbd',pattern:'planks'},r:{color:'#6b8791',pattern:'shingles'},d:plain('#465967'),t:plain('#ef715a')},parts:[['box','w',[0,0,0],[52,33,25]],['prism','r',[0,0,25],[[-29,0],[29,0],[0,14]],39,{axis:'y'}],['box','d',[0,17,0],[10,1,20]],['box','d',[-17,17,10],[11,1,9]],['box','d',[17,17,10],[11,1,9]],['box','t',[0,22,22],[54,15,2]],['mirror','x',['box','w',[24,28,0],[2,2,22]]]]};\nE.SHAPES.happyBoathouse={about:'blue lakeside boathouse',mats:{w:{color:'#638f9a',pattern:'planks'},r:{color:'#baa77d',pattern:'shingles'},d:plain('#314f5c')},parts:[['box','w',[0,0,0],[46,37,25]],['prism','r',[0,0,25],[[-25,0],[25,0],[0,15]],41,{axis:'y'}],['box','d',[0,19,0],[25,1,21]],['box','wood',[0,28,0],[50,18,2]]]};\nE.SHAPES.happyTower={about:'timber fire lookout tower',mats:{w:{color:'#9b845e',pattern:'planks'},r:plain('#596d72'),d:plain('#29434c')},parts:[['mirror','xy',['box','w',[10,10,0],[3,3,59]]],['box','w',[0,0,47],[28,28,3]],['box','w',[0,0,50],[23,23,16]],['box','d',[0,12,56],[17,1,7]],['box','r',[0,0,66],[32,32,4]],['row',7,[0,0,7],['box','w',[0,13,3],[20,2,1.3]]]]};\nE.SHAPES.happyWindmill={about:'round plaster windmill with timber cap',mats:{w:{color:'#e1d6b0',pattern:'speck'},r:{color:'#9d6248',pattern:'shingles'},d:plain('#5e655d')},parts:[['cyl','w',[0,0,0],16,54,{r2:11}],['cyl','r',[0,0,54],17,20,{r2:0,seg:8}],['box','d',[0,16,0],[9,1,17]],['box','d',[0,13,33],[7,1,9]]]};\nE.SHAPES.happyHangar={about:'old airfield maintenance shed',mats:{w:{color:'#a6a398',pattern:'metal'},r:{color:'#6d817d',pattern:'planks'},d:plain('#3f5658')},parts:[['box','w',[0,0,0],[68,45,24]],['prism','r',[0,0,24],[[-36,0],[36,0],[29,14],[-29,14]],49,{axis:'y'}],['box','d',[0,23,0],[48,1,21]]]};\nE.SHAPES.happySign={about:'cream route sign on timber post',mats:{w:'oak',s:plain('#f1e4bd'),d:plain('#566e69')},parts:[['box','w',[0,0,0],[2,2,29]],['box','s',[0,0,20],[29,3,15]],['box','d',[0,1.7,23],[24,.6,1.5]],['box','d',[0,1.7,28],[24,.6,1.5]]]};\nE.SHAPES.happyApple={about:'round apple tree with bright fruit',mats:{t:'bark',l:{color:'#77a662',pattern:'foliage'},a:plain('#dc6951')},parts:[['cyl','t',[0,0,0],2.3,22,{r2:1.4}],['ball','l',[0,0,24],15,{sz:.85}],['ball','a',[7,4,30],2],['ball','a',[-6,7,25],2],['ball','a',[-5,-5,33],1.9]]};\nconst shapeKinds={apple:'happyApple',barn:'happyBarn',paddock:'happyPaddock',boathouse:'happyBoathouse',tower:'happyTower',windmill:'happyWindmill',hangar:'happyHangar',routeSign:'happySign'};\nconst hash=(x,y)=>((Math.imul(x|0,73856093)^Math.imul(y|0,19349663))>>>0);\nfunction quad(r,a,b,wa,wb,color){const ax=-Math.sin(a.angle)*wa,ay=Math.cos(a.angle)*wa,bx=-Math.sin(b.angle)*wb,by=Math.cos(b.angle)*wb;px.poly(r.ctx,[r.w(a.x+ax,a.y+ay),r.w(b.x+bx,b.y+by),r.w(b.x-bx,b.y-by),r.w(a.x-ax,a.y-ay)],color);}\nfunction band(r,a,b,w0,w1,side,color){const ax=-Math.sin(a.angle)*side,ay=Math.cos(a.angle)*side,bx=-Math.sin(b.angle)*side,by=Math.cos(b.angle)*side;px.poly(r.ctx,[r.w(a.x+ax*w0,a.y+ay*w0),r.w(b.x+bx*w0,b.y+by*w0),r.w(b.x+bx*w1,b.y+by*w1),r.w(a.x+ax*w1,a.y+ay*w1)],color);}\nclass HappyRenderer{\n constructor(game,world){this.game=game;this.world=world;this.time=0;this.dust=[];this.skids=[];this.previous=[];this.emit=0;this.rng=E.rng(2026);}\n update(dt,sim){this.time+=dt;this.emit+=dt;if(this.emit>.045){this.emit=0;for(let i=0;i<(sim.cars||[]).length;i++){const c=sim.cars[i],speed=Math.hypot(c.vx||0,c.vy||0),surface=c.surface||this.world.surface(c.x,c.y);if(speed>35&&(surface!=='road'||Math.abs(c.slide||0)>12)){const a=c.angle||0,back={x:c.x-Math.cos(a)*10,y:c.y-Math.sin(a)*10};this.dust.push({...back,vx:-Math.cos(a)*10+(this.rng()-.5)*12,vy:-Math.sin(a)*10+(this.rng()-.5)*12,t:.65,max:.65,r:1.5+this.rng()*2,color:surface==='water'?'#c2e6e0':surface==='grass'?'#becb87':'#d5c3a1'});if(surface==='road'&&this.previous[i])this.skids.push({a:this.previous[i],b:{x:c.x,y:c.y},t:6});}this.previous[i]={x:c.x,y:c.y};}}\n  for(const p of this.dust){p.x+=p.vx*dt;p.y+=p.vy*dt;p.t-=dt;p.r+=dt*3;}this.dust=this.dust.filter(p=>p.t>0).slice(-90);for(const p of this.skids)p.t-=dt;this.skids=this.skids.filter(p=>p.t>0).slice(-240);\n }\n ground(r){const world=this.world,g=r.ctx;px.rect(g,0,0,r.W+2,r.H+2,'#89a872');const focus=this.game.cam;const cx=focus.tx??world.courses[0].gates[0].x,cy=focus.ty??world.courses[0].gates[0].y;const spanX=r.W/r.ppu+130,spanY=r.H/r.ppu+160;\n  // Mown stripes, quiet field details and tiny daisies establish scale without cluttering the road.\n  const x0=Math.floor((cx-spanX)/64)*64,y0=Math.floor((cy-spanY)/64)*64;\n  for(let y=y0;y<cy+spanY;y+=64)for(let x=x0;x<cx+spanX;x+=64){const h=hash(x/64,y/64),col=((Math.floor(y/128)+Math.floor(x/512))&1)?'#8fae77':'#87a46f';px.poly(g,[r.w(x,y),r.w(x+64,y),r.w(x+64,y+64),r.w(x,y+64)],col);for(let j=0;j<3;j++){const xx=x+(h>>(j*5)&31)*2,yy=y+(h>>(j*3+7)&31)*2,p=r.w(xx,yy);px.rect(g,p[0],p[1],1,1,j===0&&h%11===0?'#e8dfb1':'#a0b582');}}\n  for(const w of world.water){if(!r.visible(w.x,w.y,0,w.rx*r.ppu+30,w.ry*r.ppu+30,w.ry*r.ppu+30))continue;for(let ring=0;ring<3;ring++){const rr=1-ring*.026,pts=[];for(let i=0;i<72;i++){const angle=i/72*TAU;pts.push(r.w(w.x+Math.cos(angle)*(w.rx+17)*rr,w.y+Math.sin(angle)*(w.ry+17)*rr));}px.poly(g,pts,['#b9c9a0','#668f91','#5a9da4'][ring]);}for(let y=w.y-w.ry;y<w.y+w.ry;y+=27)for(let x=w.x-w.rx;x<w.x+w.rx;x+=37){if(((x-w.x)/w.rx)**2+((y-w.y)/w.ry)**2>.93)continue;const p=r.w(x+Math.sin(this.time*.9+y)*3,y);px.line(g,p[0],p[1],p[0]+5,p[1],'#76b2b5');}}\n  for(const w of world.gravel){const pts=[];for(let i=0;i<40;i++){const a=i/40*TAU;pts.push(r.w(w.x+Math.cos(a)*w.rx,w.y+Math.sin(a)*w.ry));}px.poly(g,pts,'#b7ad8b');}\n  const visible=[];for(const road of world.roads)for(let i=0;i<road.samples.length-1;i++){const a=road.samples[i],b=road.samples[i+1];if(r.visible((a.x+b.x)/2,(a.y+b.y)/2,0,(road.width+25)*r.ppu,(road.width+25)*r.ppu,(road.width+25)*r.ppu))visible.push({road,a,b,i});}\n  for(const {road,a,b}of visible)quad(r,a,b,road.width+11,road.width+11,'#b7b697');\n  for(const {road,a,b}of visible)quad(r,a,b,road.width+2,road.width+2,road.connector?'#b7b3a0':'#dddcc8');\n  for(const {road,a,b}of visible)quad(r,a,b,road.width,road.width,road.connector?'#7a7e77':'#687578');\n  for(const {road,a,b,i}of visible){if(!road.connector&&i%2===0){for(const side of [-1,1]){const mx=(a.x+b.x)/2-Math.sin(a.angle)*(road.width+4)*side,my=(a.y+b.y)/2+Math.cos(a.angle)*(road.width+4)*side;const other=world.nearestRoad(mx,my);if(other.distance<other.road?.width-2)continue;band(r,a,b,road.width+2,road.width+7,side,(i/2|0)%2?'#e3dfc6':'#c9715b');}}if(i%5===0&&!road.drag){const p=r.w(a.x,a.y),q=r.w(b.x,b.y);px.line(g,p[0],p[1],q[0],q[1],road.connector?'#babdaa':'#b3bdaf',1);}\n    if(i%3===0){const h=hash(a.x|0,a.y|0),off=(h%45-22)/24*road.width,xx=a.x-Math.sin(a.angle)*off,yy=a.y+Math.cos(a.angle)*off,p=r.w(xx,yy);px.rect(g,p[0],p[1],1,1,'#748184');}}\n  // The original racing line has an unmistakable checked start, visible from every heading.\n  for(const c of world.courses){const p=c.gates[0];if(!r.visible(p.x,p.y,0,100,100,100))continue;for(let col=0;col<2;col++)for(let row=0;row<Math.floor(c.width*2/7);row++){const f=(col-.5)*7,s=-c.width+(row+.5)*7,x=p.x+Math.cos(p.angle)*f-Math.sin(p.angle)*s,y=p.y+Math.sin(p.angle)*f+Math.cos(p.angle)*s;const aa={x:x-Math.cos(p.angle)*3.5,y:y-Math.sin(p.angle)*3.5,angle:p.angle},bb={x:x+Math.cos(p.angle)*3.5,y:y+Math.sin(p.angle)*3.5,angle:p.angle};quad(r,aa,bb,3.5,3.5,(row+col)&1?'#e8e3c7':'#35434b');}}\n  const d=world.drag;for(const [i,p]of[d.start,d.finish].entries()){if(!r.visible(p.x,p.y,0,80,80,80))continue;px.poly(g,[r.w(p.x-3,p.y-d.width),r.w(p.x+3,p.y-d.width),r.w(p.x+3,p.y+d.width),r.w(p.x-3,p.y+d.width)],i?'#d6c45a':'#e5dfc5');}\n constructor(){\n  this.version=1;this.bounds=[180,180,5850,5850];this.courses=COURSE_DATA.map((data,i)=>{const path=new E.Path(data.points,{closed:true,smooth:'catmull'}),samples=samplesFor(path,true),length=path.length;return {...data,index:i,path,length,samples,gates:Array.from({length:12},(_,g)=>({...path.at(g*length/12),d:g*length/12,index:g})),restartAnchors:Array.from({length:12},(_,g)=>({...path.at(g*length/12),d:g*length/12})),medals:[length/110,length/90,length/72],version:1};});\n  this.roads=this.courses.map(c=>({...c,courseIndex:c.index,closed:true}));\n  for(const c of CONNECTOR_DATA){const path=new E.Path(c.points,{smooth:'catmull'});this.roads.push({...c,path,length:path.length,samples:samplesFor(path,false),connector:true,closed:false,color:'#d8c6a4'});}\n  const dragPath=new E.Path([[2850,2700],[4250,2700]]);this.drag={path:dragPath,start:{x:2900,y:2700,angle:0},finish:{x:4200,y:2700,angle:0},width:35,length:1300};\n  this.roads.push({name:'Old Airfield',path:dragPath,length:dragPath.length,samples:samplesFor(dragPath,false),width:35,connector:true,drag:true,closed:false,color:'#c6bfae'});\n  this.water=[{x:4390,y:4150,rx:850,ry:690}];this.gravel=[{x:1880,y:4300,rx:350,ry:220},{x:2780,y:2660,rx:170,ry:180}];\n  this.segments=[];this.segmentGrid=new Map();\n  for(const road of this.roads)for(let i=0;i<road.samples.length-1;i++){const a=road.samples[i],b=road.samples[i+1],seg={a,b,width:road.width,road,index:i},k=this.segments.push(seg)-1;const pad=road.width+30;for(let cy=Math.floor((Math.min(a.y,b.y)-pad)/128);cy<=Math.floor((Math.max(a.y,b.y)+pad)/128);cy++)for(let cx=Math.floor((Math.min(a.x,b.x)-pad)/128);cx<=Math.floor((Math.max(a.x,b.x)+pad)/128);cx++){const key=cx+','+cy;if(!this.segmentGrid.has(key))this.segmentGrid.set(key,[]);this.segmentGrid.get(key).push(k);}}\n  this.props=[];this.solids=[];this.buildScenery();\n  this.discoveries=this.courses.map(c=>({id:c.id,name:c.name,x:c.gates[0].x,y:c.gates[0].y,r:150,courseIndex:c.index}));this.discoveries.push({id:'airfield',name:'The Secret Straight',x:2900,y:2700,r:150,secret:true});\n }\n nearestRoad(x,y){const list=this.segmentGrid.get(Math.floor(x/128)+','+Math.floor(y/128))||[];let best={distance:Infinity,road:null,d:0};for(const i of list){const s=this.segments[i],p=closestOn(s.a,s.b,x,y),distance=Math.hypot(x-p.x,y-p.y);if(distance-s.width<best.distance-(best.road?.width||0))best={distance,road:s.road,d:s.a.d+(s.b.d-s.a.d)*p.t,x:p.x,y:p.y,angle:Math.atan2(s.b.y-s.a.y,s.b.x-s.a.x)};}return best;}\n surface(x,y){const n=this.nearestRoad(x,y);if(n.road&&n.distance<n.road.width)return 'road';if(n.road&&n.distance<n.road.width+13)return 'gravel';if(this.water.some(w=>((x-w.x)/w.rx)**2+((y-w.y)/w.ry)**2<1))return 'water';if(this.gravel.some(w=>((x-w.x)/w.rx)**2+((y-w.y)/w.ry)**2<1))return 'gravel';return 'grass';}\n addProp(kind,x,y,options={}){if(this.surface(x,y)==='water')return;const nearest=this.nearestRoad(x,y);if(nearest.road&&nearest.distance<nearest.road.width+30)return;const p={kind,x,y,seed:Math.floor(x*11+y*7),...options};this.props.push(p);if(options.solid!==false){const r=options.r||(['tree','pine'].includes(kind)?8:kind==='rock'?8:kind==='bush'?5:24);this.solids.push({kind,x,y,r,...(options.collision||{})});}}\n buildScenery(){\n  const rng=E.rng(19801113);\n  // Native trees and brush follow the road's outside, keeping the racing ribbon readable.\n  for(let k=0;k<4;k++){const c=this.courses[k];for(let d=85;d<c.length;d+=77+rng()*40){const p=c.path.at(d);for(const side of [-1,1]){if(rng()<.16)continue;const off=c.width+55+rng()*95,x=p.x-Math.sin(p.angle)*off*side,y=p.y+Math.cos(p.angle)*off*side;const kind=k===3?'pine':rng()<.68?'tree':rng()<.5?'bush':'rock';this.addProp(kind,x,y,{h:k===3?32+rng()*20:27+rng()*15,scale:.8+rng()*.4,r:kind==='tree'||kind==='pine'?8:6});}}}\n  // Background groves, hedges, orchard rows and gentle field textures.\n  for(let i=0;i<600;i++){const x=260+rng()*5400,y=260+rng()*5400,wood=x<2400&&y>3100;this.addProp(wood?'pine':rng()<.66?'tree':'bush',x,y,{h:28+rng()*20,scale:.8+rng()*.4,r:wood?8:7});}\n  for(let row=0;row<9;row++)for(let col=0;col<12;col++)this.addProp('apple',3650+col*100,930+row*85,{h:29,scale:.95,r:8});\n  this.addProp('paddock',830,1600,{r:38,scale:1});\n  this.addProp('barn',3780,1440,{r:47,scale:1.5});\n  this.addProp('boathouse',4540,5050,{r:30,scale:1.2});\n  this.addProp('tower',990,4380,{r:18,scale:1.2});\n  this.addProp('windmill',3050,2940,{r:28,scale:1.4});\n  this.addProp('hangar',3670,2820,{r:43,scale:1.35});\n  for(const c of this.courses){const p=c.gates[0],nx=-Math.sin(p.angle),ny=Math.cos(p.angle);this.props.push({kind:'routeSign',x:p.x+nx*(c.width+25),y:p.y+ny*(c.width+25),courseIndex:c.index,facing:p.angle});for(let j=0;j<5;j++)this.addProp('fence',p.x+nx*(c.width+58)+Math.cos(p.angle)*(j-2)*27,p.y+ny*(c.width+58)+Math.sin(p.angle)*(j-2)*27,{solid:false,facing:p.angle+Math.PI/2});}\n }\n validate(){const errors=[];for(const c of this.courses){if(c.width<25||c.length<1000||c.gates.length<4)errors.push('Invalid course '+c.id);if(c.samples.some(p=>!Number.isFinite(p.x+p.y+p.d)))errors.push('Non-finite samples '+c.id);for(const g of c.gates){if(this.surface(g.x,g.y)!=='road')errors.push('Unsafe gate '+c.id);if(this.solids.some(s=>Math.hypot(s.x-g.x,s.y-g.y)<s.r+c.width*.4+12))errors.push('Obstructed gate '+c.id);}}return errors;}\n}\nHappyWorld.COURSE_DATA=COURSE_DATA;HappyWorld.CONNECTOR_DATA=CONNECTOR_DATA;\nglobalThis.HappyWorld=HappyWorld;\n})();\n/* Auto Lap Happy: one host-authoritative transport for AI Hub and direct peers. */\n(function (root) {\n  'use strict';\n  const BUILD = 'auto-lap-happy-1';\n  const PROTOCOL = 1;\n  const SAFE = Object.freeze({ steer: 0, brake: 1, throttle: 0, recover: false });\n  const now = () => (root.performance ? root.performance.now() : Date.now());\n  const clamp = (x, a, b) => Math.max(a, Math.min(b, Number(x) || 0));\n  const validNumber = n => typeof n === 'number' && Number.isFinite(n);\n  const clone = obj => JSON.parse(JSON.stringify(obj));\n  const rounded = n => validNumber(n) ? Math.round(n * 1000) / 1000 : n;\n  function packSnapshot(s) {\n    if (!s || s.v !== 1 || !Array.isArray(s.cars) || !s.cars.every(c => c && !Array.isArray(c) && c.r)) return s;\n    return { w: 1, d: [s.mode, s.state, s.ci, s.t, s.tick, s.score, s.ex, s.cd, s.target, s.laps, s.penalty, s.message, rounded(s.messageT), s.finished, s.cars.map(c => {\n      const r = c.r;\n      return [c.x, c.y, c.a, c.vx, c.vy, c.s, c.p, rounded(c.cr), rounded(c.im), [r.index, rounded(r.d), rounded(r.total), r.gate, r.lap, r.lastGate, rounded(r.lapT), r.splits.map(rounded), r.valid ? 1 : 0, r.wrong ? 1 : 0]];\n    })] };\n  }\n  function unpackSnapshot(s) {\n    if (!s || s.w !== 1) return s;\n    const d = s.d;\n    if (!Array.isArray(d) || d.length !== 15 || !Array.isArray(d[14]) || d[14].length > 2) return null;\n    const cars = [];\n    for (const c of d[14]) {\n      if (!Array.isArray(c) || c.length !== 10 || !Array.isArray(c[9]) || c[9].length !== 10) return null;\n      const r = c[9];\n      cars.push({ x: c[0], y: c[1], a: c[2], vx: c[3], vy: c[4], s: c[5], p: c[6], cr: c[7], im: c[8], r: { index: r[0], d: r[1], total: r[2], gate: r[3], lap: r[4], lastGate: r[5], lapT: r[6], splits: r[7], valid: !!r[8], wrong: !!r[9] } });\n    }\n    return { v: 1, mode: d[0], state: d[1], ci: d[2], t: d[3], tick: d[4], score: d[5], ex: d[6], cd: d[7], target: d[8], laps: d[9], penalty: d[10], message: d[11], messageT: d[12], finished: d[13], cars };\n  }\n  const control = obj => {\n    if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return null;\n    if (!validNumber(obj.steer) || !validNumber(obj.brake) || !validNumber(obj.throttle)) return null;\n    return { steer: clamp(obj.steer, -1, 1), brake: clamp(obj.brake, 0, 1), throttle: clamp(obj.throttle, 0, 1), recover: obj.recover === true };\n  };\n  function invite(text, type) {\n    if (typeof text !== 'string' || text.length > 200000 || text.length < 20) throw Error('Paste the complete invitation or reply.');\n    let data;\n    try { data = JSON.parse(text); } catch { throw Error('This is incomplete or invalid connection text. Copy the whole text and try again.'); }\n    if (!data || data.build !== BUILD || data.v !== PROTOCOL) throw Error('This connection was made by a different game version. Both drivers need the same build.');\n    if (data.type !== type || !data.sdp || data.sdp.type !== type || typeof data.sdp.sdp !== 'string' || !data.sdp.sdp.startsWith('v=0')) throw Error(type === 'offer' ? 'Use the host’s invitation, not a reply.' : 'Use the joiner’s reply, not an invitation.');\n    if (typeof data.token !== 'string' || data.token.length < 8 || data.token.length > 80) throw Error('The connection token is invalid. Create a new invitation.');\n    return data;\n  }\n  function cleanConfig(config) {\n    config = config || {};\n    const difficulty = ['easy', 'normal', 'hard'].includes(config.difficulty) ? config.difficulty : ['easy', 'normal', 'hard'][Math.floor(clamp(config.difficulty ?? 1, 0, 2))];\n    return { mode: 'duel', course: Math.floor(clamp(config.course, 0, 4)), cars: Array.isArray(config.cars) ? config.cars.slice(0, 2).map(c => Math.floor(clamp(c, 0, 4))) : [3, 4], target: config.target === 50 ? 50 : 10, difficulty, online: true, seed: (Number(config.seed) || 1980) >>> 0 };\n  }\n  class HappyNetwork {\n    constructor(callbacks = {}) {\n      this.callbacks = callbacks;\n      this.kind = 'none'; this.authoritative = true; this.localSeat = 0;\n      this.connected = false; this.active = false; this.started = false;\n      this.info = null; this.pc = null; this.channels = {}; this.unsubs = [];\n      this.players = []; this.gone = new Set(); this.round = 0; this.seq = 0;\n      this.inputSeq = new Map(); this.inputAt = new Map(); this.snapshotSeq = -1;\n      this.lastSent = -Infinity; this.lastProgress = -Infinity; this.latest = null;\n      this.startAt = Infinity; this.finished = false; this.closed = false;\n      this.status = ''; this.token = ''; this.answerUsed = false;\n      this.directConfig = null; this.pendingStart = false; this.peerReady = false;\n      this.configSeq = 0; this.receivedConfigSeq = -1;\n      this.testDelay = 0; this.testLoss = 0; this.timers = new Set();\n      this.stun = ''; // Optional user-provided STUN URL; no external service is a boot requirement.\n    }\n    emit(name, ...args) { if (typeof this.callbacks[name] === 'function') this.callbacks[name](...args); }\n    say(text) { this.status = text; this.emit('onStatus', text); }\n    later(fn, ms) {\n      const id = setTimeout(() => { this.timers.delete(id); if (!this.closed) fn(); }, ms);\n      this.timers.add(id); return id;\n    }\n    clock() {\n      if (this.kind === 'hub') return root.AIHub.time() / 1000;\n      if (this.kind === 'direct') return (now() - this.startAt) / 1000;\n      return 0;\n    }\n    async connectHub() {\n      if (!root.AIHub) return null;\n      const info = await root.AIHub.connect({ mode: 'shared-world', seats: [1, 2] });\n      if (!info) return null;\n      if (this.pc) this.closePeer();\n      this.kind = 'hub'; this.active = true; this.connected = true; this.closed = false;\n      this.authoritative = !!info.isHost; this.info = info; this.players = info.players.slice();\n      this.localSeat = info.server ? null : this.players.findIndex(p => p.id === info.me);\n      if (this.localSeat < 0) this.localSeat = null;\n      this.round = info.round; this.finished = false;\n      const rng = root.AIHub.rng('auto-lap-happy-config');\n      this.config = cleanConfig({ course: Math.floor(rng() * 5), cars: [3, 4], seed: info.seed, target: 10 });\n      this.emit('onStart', { ...this.config, hub: true, humans: this.players.length, startClock: true });\n      const on = (name, fn) => this.unsubs.push(root.AIHub.on(name, fn));\n      on('start', () => { this.started = true; this.say('Green flag on the Hub clock.'); });\n      on('message', (data, from) => this.receive(data, from));\n      on('time-up', () => { if (this.authoritative && !this.finished) { this.emit('onTimeUp'); this.finish(this.latest?.score || this.latest?.scores || [0, 0]); } });\n      on('leave', ({ id, reason }) => {\n        this.gone.add(id);\n        const seat = this.players.findIndex(p => p.id === id);\n        if (seat >= 0) this.emit('onInput', seat, { ...SAFE });\n        this.emit('onLeave', seat, reason);\n        if (this.authoritative && !this.finished && this.players.filter(p => !this.gone.has(p.id)).length <= 1 && this.players.length > 1) this.finish(this.latest?.score || this.latest?.scores || [0, 0]);\n      });\n","exit_code":0,"status":"completed"}}
