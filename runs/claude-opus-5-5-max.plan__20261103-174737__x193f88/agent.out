            ok = cell in R\n        elif kind == 'face':      # stand here facing a wall feature\n            ok = cell in R and wallface(rows, cell, st[2]) == '#'\n        elif kind == 'open':      # open a door/gate/pit from a neighbouring cell\n            ok = rows[cell[1]][cell[0]] in CLOSED and any((cell[0] + dx, cell[1] + dy) in R for dx, dy in D)\n            opened.add(cell)\n        elif kind == 'drop':      # throw or drop onto a plate: it must be visible down a straight line or adjacent\n            ok = rows[cell[1]][cell[0]] == 'P'\n        print(('ok   ' if ok else 'FAIL ') + str(name) + ' ' + ' '.join(map(str, st)) + ('' if ok else '  <-- not reachable'))\n        fails += not ok\n    return fails\n\nF = 0\nF += run(1, [('at', (2, 13)), ('at', (2, 12)), ('face', (2, 11), 'E'), ('open', (2, 10)),\n             ('at', (3, 6)), ('face', (1, 6), 'W'), ('open', (2, 3)), ('at', (1, 1)), ('face', (5, 2), 'E'), ('open', (6, 1)), ('at', (7, 1)),\n             ('open', (4, 13)), ('at', (5, 13)), ('face', (6, 12), 'N'),\n             ('face', (9, 5), 'N'), ('open', (8, 4)), ('at', (8, 3)),\n             ('at', (10, 7)), ('drop', (14, 6)), ('open', (16, 6)), ('open', (17, 3)), ('at', (18, 1)),\n             ('face', (10, 8), 'S'), ('at', (9, 11)), ('face', (4, 5), 'N'),\n             ('face', (13, 10), 'N'), ('face', (18, 10), 'S'), ('open', (19, 11)), ('at', (16, 12)), ('open', (15, 14)), ('at', (15, 15))])\nF += run(2, [('at', (9, 1)), ('at', (12, 3)), ('face', (8, 3), 'S'), ('open', (13, 2)),\n             ('face', (16, 1), 'N'), ('face', (17, 1), 'N'), ('face', (18, 1), 'N'), ('face', (19, 1), 'N'), ('face', (20, 1), 'N'),\n             ('face', (19, 6), 'W'), ('face', (19, 8), 'E'), ('open', (19, 11)), ('at', (18, 14)), ('at', (20, 15)), ('open', (16, 14)),\n             ('face', (10, 15), 'S'), ('face', (11, 15), 'S'), ('face', (12, 15), 'S'), ('open', (11, 12)), ('at', (11, 11)),\n             ('at', (6, 13)), ('at', (6, 10)), ('at', (4, 12)), ('drop', (4, 9)), ('open', (4, 11)), ('at', (4, 9)), ('at', (3, 9)),\n             ('face', (3, 9), 'N'), ('face', (2, 9), 'W'), ('open', (2, 8)), ('at', (5, 7)), ('at', (1, 7)), ('drop', (2, 5)), ('drop', (4, 5)),\n             ('open', (6, 5)), ('open', (10, 6)), ('at', (12, 6)), ('face', (14, 6), 'E'), ('at', (14, 8))])\nF += run(3, [('at', (1, 8)), ('at', (5, 4)), ('at', (9, 7)), ('at', (13, 7)), ('at', (17, 7)), ('at', (19, 8)), ('open', (19, 6)),\n             ('face', (16, 1), 'N'), ('face', (18, 1), 'N'), ('face', (20, 1), 'N'), ('face', (16, 5), 'S'), ('face', (18, 5), 'S'), ('face', (20, 5), 'S'),\n             ('at', (14, 3)), ('face', (11, 4), 'S'),\n             ('at', (11, 9)), ('face', (13, 11), 'E'), ('open', (13, 12)), ('at', (13, 13)), ('open', (14, 13)), ('at', (19, 13)),\n             ('at', (19, 10)), ('face', (22, 10), 'N'), ('open', (21, 12)), ('face', (22, 14), 'E'),\n             ('at', (12, 4)), ('open', (12, 5)), ('at', (12, 6))])\nF += run(3, [('at', (2, 16)), ('at', (1, 16))], start=(2, 15))   # the Sump: the trapdoor's landing reaches its ladder\nF += run(4, [('at', (6, 9)), ('at', (5, 7)), ('at', (7, 7)), ('open', (6, 6)), ('face', (3, 3), 'W'), ('face', (9, 3), 'E'), ('face', (6, 1), 'N')])\nF += run('race', [('face', (1, 8), 'E'), ('open', (1, 6)), ('face', (1, 2), 'W'), ('at', (6, 8)), ('at', (4, 9)), ('open', (5, 1)), ('at', (11, 6)),\n                  ('drop', (9, 5)), ('open', (12, 4)), ('at', (12, 1))])\nprint('FAILURES', F)\nEOF\npython3 validate.py | grep -v '^ok' ; python3 floors.py | sed -n '/FLOOR race/,$p'","description":"Validate every floor's progression order by reachability"}}}
