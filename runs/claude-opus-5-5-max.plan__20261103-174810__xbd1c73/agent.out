50, z: 200 }, { x: 0, y: 0, z: -1 });\nconst hit = world.pw.castRayAndGetNormal(ray, 500, true, undefined, undefined, undefined, body);\nconsole.log('box z after 2s', body.translation().z.toFixed(2), 'ray toi', hit && hit.timeOfImpact.toFixed(2), 'normal', hit && JSON.stringify(hit.normal));\nconsole.log('hash', world.hash([body.translation().z]));\nEOF\ncd $S && timeout 120 node probe.mjs $R/engine 2>&1 | tail -20","description":"Probe loading and stepping the 3D engine headless in Node"}}}
