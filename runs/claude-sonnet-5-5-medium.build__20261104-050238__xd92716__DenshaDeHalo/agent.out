n// loads the engine + game sources headless into one vm context (draw is skipped without a screen)\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\nexport function load(files) {\n  const root = new URL('../', import.meta.url);\n  const ctx = { console, setTimeout, clearTimeout }; ctx.window = ctx; ctx.location = { hash: '' };\n  vm.createContext(ctx);\n  const run = (f) => vm.runInContext(readFileSync(new URL(f, root), 'utf8'), ctx, { filename: f });\n  run('engine/my-3d2dge.js');\n  const src = readdirSync(new URL('src/', root)).filter(f => f.endsWith('.js')).sort();\n  for (const f of src) if (!files || files.includes(f)) run('src/' + f);\n  return ctx;\n}\nEOF\ncat > ../test/sim.mjs <<'EOF'\nimport { load } from './lib.mjs';\nconst ctx = load(['00-core.js','10-route.js','20-sim.js']); const DH = ctx.DH;\nconsole.log('route', DH.route.length, DH.route.signals.length, 'signals');\nfor (const st of DH.STAGES) {\n  const run = new DH.Run(st, {}); const dt = 1/60; let i = 0;\n  for (; i < 60*900 && !run.finished && !run.failed; i++) { DH.autopilot(run); run.step(dt, {}); }\n  const r = run.results.map(q => q.grade + ' ' + q.e.toFixed(1) + 'm ' + q.timeGrade + ' ' + q.late.toFixed(0) + 's ' + q.smooth).join(' | ');\n  console.log(st.id, 'fin', run.finished, 'fail', run.failed, 't', run.t.toFixed(0), 'halo', run.halo.toFixed(0), 'score', Math.round(run.score), '\\n   ', r);\n}\nEOF\ncd ..; node test/sim.mjs 2>&1 | head -40"}}}
