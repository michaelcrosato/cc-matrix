ies 5', kind: 'Commuter', cars: 6, len: 120, pn: 5, accel: 2.7, maxKmh: 100, brake: 4.0, eb: 5.2, lag: .9, mass: 1, body: '#e9ecef', stripe: '#27b3c6', stripe2: '#0e6f86', blurb: 'Even-tempered. Brakes a touch late. The one everyone learns on.' },\n  X7: { id: 'X7', name: 'Comet X7', kind: 'Limited Express', cars: 8, len: 160, pn: 5, accel: 3.3, maxKmh: 120, brake: 3.5, eb: 4.8, lag: 1.5, mass: 1.5, body: '#f4f1e8', stripe: '#e0482e', stripe2: '#8a1f12', blurb: 'Fast and heavy. Starts braking early or not at all.' },\n  L3: { id: 'L3', name: 'Pocket L3', kind: 'Local', cars: 4, len: 80, pn: 4, accel: 3.4, maxKmh: 80, brake: 4.6, eb: 5.6, lag: .45, mass: .7, body: '#ffe9a6', stripe: '#f08a1c', stripe2: '#a04c08', blurb: 'Light and snappy. Brakes bite at once. Easy to stop short.' }\n};\n\n/* ---------- settings the player sees in the standard Settings screen ---------- */\nDH.SETTINGS = [\n  { key: 'leverDir', label: 'Lever direction', options: ['Up = Power', 'Up = Brake'], value: 'Up = Power' },\n  { key: 'difficulty', label: 'Difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal' },\n  { key: 'autoCall', label: 'Auto point-and-call', value: false },\n  { key: 'subtitles', label: 'Subtitles', value: true },\n  { key: 'cabSway', label: 'Cab sway', value: true }\n];\n\nDH.rngFor = label => {\n  if (window.AIHub && AIHub.active && AIHub.rng) return AIHub.rng(label);\n  let h = 2166136261; for (let i = 0; i < label.length; i++) h = Math.imul(h ^ label.charCodeAt(i), 16777619);\n  return E.rng(h >>> 0);\n};\n\nDH.kmh = ms => ms * 3.6;\nDH.fmtTime = secs => { secs = Math.floor(secs); const h = Math.floor(secs / 3600) % 24, m = Math.floor(secs / 60) % 60, s = secs % 60; return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0'); };\nDH.fmtClock = secs => DH.fmtTime(secs).slice(0, 5);\n\n/* ---------- save data ---------- */\nDH.save = {\n  get() { return Object.assign({ unlocked: 0, best: {}, stops: 0, perfect: 0, pla