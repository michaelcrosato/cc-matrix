{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghrXuxD64ZPJ6xvY49ie","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018P4ngVpfmhQb5buZqLwdJD","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-050238__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-sonnet-5-5-medium-20261104-050238/engine/kits/road.js","limit":260},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20912,"cache_read_input_tokens":46229,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20912},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0738416c-8908-4884-b93b-1b7b7f6ce2f9","uuid":"a1703712-c0ad-424f-8927-e7be6cd25201","timestamp":"2026-11-04T12:03:16.374Z","request_id":"req_011CghrXuerFU94q8iANhmXb","wire_tool_inputs":{"toolu_018P4ngVpfmhQb5buZqLwdJD":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-050238__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-sonnet-5-5-medium-20261104-050238/engine/kits/road.js","limit":260}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018P4ngVpfmhQb5buZqLwdJD","type":"tool_result","content":"1\t// The ROAD kit's game (a pseudo-3D coast road against the clock: curves, hills, a tunnel, traffic, checkpoints, a radio), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/66-road.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. road.html plays it; node kits/test.mjs road runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 14  ROAD  (OutRun, Pole Position, Hang-On, Road Rash). @modules road\n161\t * A convertible on a coast road: the beach, the hills, a tunnel through the cliffs, the desert at dusk, the city at\n162\t * night. Curves throw you outward, the shoulder slows you, palms and rocks and signs stop you dead, traffic weaves in\n163\t * its lanes. A clock counts down; each checkpoint's arch gives time back; reach the goal before it runs out. Pick a\n164\t * song on the radio first. Low gear pulls away hard but tops out early; high gear runs to 290.\n165\t * KEYS: left / right (A / D) steer, up / Z gas, down / X brake, Space / Shift the gear (low, high), left and right on\n166\t * the radio. A pad: the stick, A gas, X brake, R the gear. TOUCH: the stick steers, BRAKE and GEAR; it accelerates by\n167\t * itself. Deep link: #road/drive (the radio skipped).\n168\t * HOW IT WORKS: E.Road (the road module) draws the road, its hills, its tunnel, the scenery and the traffic far to near\n169\t * and says how hard it bends; this file the stage, the car (drawn by code from behind), the traffic, the clock and\n170\t * the radio.\n171\t * ===================================================================================== */\n172\tconst ROAD = (() => {\n173\t  const A = game.audio, SEG = 200, KEYS = Object.assign({}, E.Input.DEFAULT, { gas: ['ArrowUp', 'KeyW', 'KeyZ', 'Pad0'], brake: ['ArrowDown', 'KeyS', 'KeyX', 'Pad2'], gear: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyC', 'Pad5', 'Pad7'] });\n174\t  for (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n175\t  /* ---- THE STAGE: five stretches, each its colors and sky; checkpoints between them; the goal at the end ---- */\n176\t  const AREAS = [\n177\t    { name: 'COCONUT BEACH', sky: 'ocean', colors: { grass: ['#e8d8a0', '#dccb90'], rumble: ['#f0f0f0', '#d83030'] } },\n178\t    { name: 'GREEN HILLS', sky: 'day', colors: { grass: ['#4aa848', '#3e9a3e'], rumble: ['#f0f0f0', '#3050c0'] } },\n179\t    { name: 'CLIFF TUNNEL', sky: 'day', colors: { grass: ['#6a5a48', '#5e5040'], rumble: ['#f0f0f0', '#d83030'] } },\n180\t    { name: 'DESERT AT DUSK', sky: 'dusk', colors: { grass: ['#d8a060', '#c89050'], rumble: ['#f0e0c0', '#b04820'], road: ['#6a6070', '#625868'] } },\n181\t    { name: 'CITY NIGHTS', sky: 'city-night', colors: { grass: ['#2a2a3a', '#24243a'], rumble: ['#e0e0f0', '#e0b030'], road: ['#4a4a58', '#444452'], lane: '#e0d060' } }];\n182\t  const road = new E.Road({ segment: SEG, lanes: 3, draw: 200, fog: null });\n183\t  const AT = [];   // where each area starts (a segment)\n184\t  const stretch = (ai, parts) => { AT.push(road.segs.length); for (const [n, o] of parts) road.add(n, Object.assign({ colors: AREAS[ai].colors }, o)); };\n185\t  stretch(0, [[40, {}], [60, { curve: 3 }], [40, { hill: 2000 }], [60, { curve: -4, hill: -2000 }], [50, {}], [70, { curve: 5 }], [40, {}]]);\n186\t  stretch(1, [[50, { hill: 4000 }], [60, { curve: -3, hill: -3000 }], [40, { hill: 3000 }], [70, { curve: 4, hill: -4000 }], [50, { curve: -5 }], [40, { hill: 2000 }], [40, { hill: -2000 }]]);\n187\t  stretch(2, [[30, {}], [80, { tunnel: true, curve: 2, colors: Object.assign({}, AREAS[2].colors, { grass: ['#3a3430', '#34302c'] }) }], [30, {}], [60, { curve: -4 }], [40, { curve: 3, hill: 1500 }]]);\n188\t  stretch(3, [[60, { curve: -2 }], [50, { hill: 3000 }], [60, { curve: 5, hill: -3000 }], [80, {}], [60, { curve: -5 }], [50, { curve: 2 }]]);\n189\t  stretch(4, [[60, {}], [60, { curve: 4 }], [50, { curve: -4 }], [80, { hill: 1000 }], [60, {}], [40, {}]]);\n190\t  const GOAL = (road.segs.length - 30) * SEG, CHECKS = AT.slice(1).map(s => s * SEG);\n191\t  // the scenery: each area's own, both sides, a checkpoint arch at each area's start, the goal's\n192\t  const PALM = E.prop('palm').frames[0], ROCK = E.prop('rock', { size: 2 }).frames[0], CACTUS = E.prop('cactus').frames[0], TREE = E.prop('tree').frames[0];\n193\t  const bldg = (w, h, col, lit) => ({ w, draw(g, x, y, s) { const W = w * s, H = h * s; if (W < 1) return; E.px.rect(g, x - W / 2, y - H, W, H, col); if (W > 6) for (let yy = 4 * s; yy < H - 4 * s; yy += 10 * s * 4) for (let xx = -W / 2 + 4 * s * 4; xx < W / 2 - 4 * s * 4; xx += 12 * s * 4) E.px.rect(g, x + xx, y - H + yy, Math.max(1, 5 * s * 4), Math.max(1, 5 * s * 4), lit); } });\n194\t  const sign = text => ({ w: 600, draw(g, x, y, s) { const W = 600 * s, H = 300 * s; if (W < 2) return; E.px.rect(g, x - W * .04, y - H * 2, W * .08, H * 2, '#606068'); E.px.rect(g, x - W / 2, y - H * 2.4, W, H, '#f0e0a0'); if (W > 40) E.font.text(g, text, Math.round(x), Math.round(y - H * 2.1), '#c03020', { align: 'center', outline: false }); } });\n195\t  const arch = (text, col) => ({ w: 0, draw(g, x, y, s) { const W = 2600 * s, H = 1500 * s; if (W < 3) return; for (const sx of [-1, 1]) E.px.rect(g, x + sx * W - 40 * s, y - H, 80 * s, H, '#e0e0e8'); E.px.rect(g, x - W, y - H, W * 2, H * .2, col); if (W > 60) E.font.text(g, text, Math.round(x), Math.round(y - H * .93), '#ffffff', { align: 'center', outline: false, scale: W > 400 ? 2 : 1 }); } });\n196\t  for (let z = 0; z < road.length; z += SEG * 4) {\n197\t    const a = AREAS.findIndex((_, i) => i === AREAS.length - 1 || z < AT[i + 1] * SEG), side = (z / SEG / 4) % 2 ? 1 : -1, r = (z * 7919) % 100;\n198\t    if (road.seg(z).tunnel) continue;\n199\t    if (a === 0) road.place(z, side * (1.5 + r / 200), PALM, 50);\n200\t    else if (a === 1) road.place(z, side * (1.6 + r / 150), r < 50 ? TREE : ROCK, 60);\n201\t    else if (a === 2) road.place(z, side * 1.7, ROCK, 70);\n202\t    else if (a === 3) road.place(z, side * (1.5 + r / 120), r < 70 ? CACTUS : ROCK, 60);\n203\t    else road.place(z, side * (2 + r / 200), bldg(900 + r * 8, 1600 + r * 30, ['#2a2a4a', '#3a2a4a', '#2a3a4a'][r % 3], '#ffd870'), 1);\n204\t    if (r < 12) road.place(z + SEG * 2, -side * 1.4, sign(['SLOW', 'GOAL', 'TURN'][r % 3]), 1);\n205\t  }\n206\t  CHECKS.forEach((z, i) => road.place(z, 0, arch('CHECKPOINT', '#2a8a3a'), 1));\n207\t  road.place(GOAL, 0, arch('GOAL', '#d02a2a'), 1);\n208\t  const SONGS = [\n209\t    { name: 'SEA BREEZE', bpm: 132, steps: 4, tracks: [\n210\t      { wave: 'square', vol: .06, notes: 'E5 . G5 A5 . G5 E5 D5 | C5 . D5 E5 . . . . | E5 . G5 A5 . B5 A5 G5 | A5 . G5 E5 . . D5 .' },\n211\t      { wave: 'triangle', vol: .26, notes: 'A2 . A3 . A2 . A3 . | F2 . F3 . F2 . F3 . | C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 .' },\n212\t      { wave: 'drums', vol: .07, notes: 'k . h . s . h k k . h . s . h h' }] },\n213\t    { name: 'SUNSET DRIVE', bpm: 112, steps: 4, tracks: [\n214\t      { wave: 'pulse12', vol: .06, notes: 'D5 - - F5 E5 - D5 - | C5 - - - A4 - - - | D5 - - F5 A5 - G5 - | F5 - E5 - D5 - - -' },\n215\t      { wave: 'triangle', vol: .26, notes: 'D3 . . D3 . . A2 . | F2 . . F2 . . C3 . | G2 . . G2 . . D3 . | A2 . . A2 . . C3 .' },\n216\t      { wave: 'drums', vol: .06, notes: 'k . . h s . . h k . k h s . . h' }] },\n217\t    { name: 'NEON HIGHWAY', bpm: 150, steps: 4, tracks: [\n218\t      { wave: 'square', vol: .05, notes: 'A4 A5 E5 A4 G5 E5 C5 G4 | F4 F5 C5 F4 E5 C5 A4 E4 | G4 G5 D5 G4 F5 D5 B4 F4 | E4 E5 B4 E4 G#5 E5 B4 G#4' },\n219\t      { wave: 'triangle', vol: .26, notes: 'A1 A2 A1 A2 A1 A2 A1 A2 | F1 F2 F1 F2 F1 F2 F1 F2 | G1 G2 G1 G2 G1 G2 G1 G2 | E1 E2 E1 E2 E1 E2 E1 E2' },\n220\t      { wave: 'drums', vol: .07, notes: 'k h s h k h s h k h s h k k s h' }] }];\n221\t  const SKIES = {}; const skyOf = n => SKIES[n] || (SKIES[n] = new E.Backdrop(n));\n222\t\n223\t  /* ---- THE DRIVE ---- */\n224\t  const MAX = [190, 293], ACC = [130, 75], H = 1000;   // km/h by gear (low, high); the camera over the road\n225\t  let mode = 'radio', song = 0, z = 0, x = 0, speed = 0, gear = 0, clock = 60, turn = 0, crash = 0, bump = 0, banner = null, score = 0, reached = 0, traffic = [], t = 0, endT = 0, area = 0;\n226\t  const ahead = road.ahead(H), kmh = () => Math.round(speed);\n227\t  function begin() {\n228\t    mode = 'drive'; z = 0; x = 0; speed = 0; gear = 0; clock = 60; turn = 0; crash = 0; bump = 0; score = 0; reached = 0; t = 0; endT = 0; area = 0; banner = { text: AREAS[0].name, t: 0 };\n229\t    traffic = []; for (let i = 0; i < 26; i++) traffic.push({ z: 3000 + i * 4200 + (i * 977) % 1800, x: [-.66, 0, .66][i % 3], v: 80 + (i * 37) % 70, col: ['#3060d0', '#e0e0e0', '#30a050', '#e0b020', '#a03070'][i % 5], w: 380, draw: carBack });\n230\t    A.music(SONGS[song]); game.input.consumeAll();\n231\t  }\n232\t  // a car from behind: its body, rear window, tail lights and tyres, scale pixels a unit\n233\t  function carBack(g, sx, sy, s) {\n234\t    const W = this.w * s, Hh = W * .45; if (W < 2) return;\n235\t    E.px.rect(g, sx - W / 2, sy - Hh, W, Hh * .7, this.col); E.px.rect(g, sx - W * .35, sy - Hh * 1.25, W * .7, Hh * .55, E.shade(this.col, -.3));\n236\t    E.px.rect(g, sx - W * .3, sy - Hh * 1.15, W * .6, Hh * .35, '#a0c8e0'); E.px.rect(g, sx - W / 2, sy - Hh * .3, W * .18, Hh * .3, '#1a1a1a'); E.px.rect(g, sx + W * .32, sy - Hh * .3, W * .18, Hh * .3, '#1a1a1a');\n237\t    if (W > 8) { E.px.rect(g, sx - W * .45, sy - Hh * .6, W * .12, Hh * .12, '#ff3020'); E.px.rect(g, sx + W * .33, sy - Hh * .6, W * .12, Hh * .12, '#ff3020'); }\n238\t  }\n239\t  function update(dt) {\n240\t    const I = game.input; t += dt;\n241\t    for (const k of ['brake', 'gear']) I.touchSet(k, k === 'gear' ? (gear ? 'HIGH' : 'LOW') : null, mode === 'drive');\n242\t    if (mode === 'radio') {\n243\t      if (I.pressed('left') || I.pressed('right')) { song = (song + (I.pressed('left') ? 2 : 1)) % 3; A.music(SONGS[song]); A.sfx('select'); }\n244\t      const tap = I.clicked && I.clicked(); if (tap) { const k = Math.floor(tap[0] / (game.W / 3)); if (k === song) begin(); else { song = clamp(k, 0, 2); A.music(SONGS[song]); A.sfx('select'); } }\n245\t      if (I.pressed('confirm') || I.pressed('gas')) { A.sfx('confirm'); begin(); }\n246\t      return;\n247\t    }\n248\t    if (mode === 'over' || mode === 'goal') { endT += dt; if (endT > 1.5 && (I.pressed('confirm') || I.pressed('gas') || (I.clicked && I.clicked()))) { mode = 'radio'; A.sfx('confirm'); } speed = Math.max(0, speed - 120 * dt); z += speed * dt * 12; return; }\n249\t    if (banner) { banner.t += dt; if (banner.t > 2.5) banner = null; }\n250\t    // the clock: each checkpoint passed gives time; none left, the game is over\n251\t    clock -= dt; if (clock <= 0) { clock = 0; mode = 'over'; endT = 0; A.music(null); A.sfx('die'); }\n252\t    if (reached < CHECKS.length && z + ahead >= CHECKS[reached]) { reached++; clock += 40; area = reached; banner = { text: AREAS[area].name, t: 0, check: true }; A.sfx('oneup'); score += 5000; }\n253\t    if (z + ahead >= GOAL) { mode = 'goal'; endT = 0; score += Math.round(clock) * 1000; A.music(null); A.sfx('secret'); }\n254\t    if (I.pressed('gear')) { gear = 1 - gear; A.sfx('select', { vol: .5 }); }\n255\t    const auto = I.lastDevice === 'touch', gas = I.down('gas') || auto, brake = I.down('brake') || I.move()[1] > .7, off = Math.abs(x) > 1.05, steer = I.move()[0];\n256\t    // speed: the gear's pull and top, the shoulder's drag, a crash's stop\n257\t    if (crash > 0) { crash -= dt; speed = Math.max(0, speed - 400 * dt); x += (Math.sign(x) * .5 - x) * Math.min(1, dt * 3); }   // (a crash: it spins to a stop and is put back on the road)\n258\t    else {\n259\t      const top = MAX[gear] * (off ? .45 : 1);\n260\t      if (gas && speed < top) speed = Math.min(top, speed + ACC[gear] * (gear && speed < 100 ? .5 : 1) * dt);"}]},"parent_tool_use_id":null,"session_id":"0738416c-8908-4884-b93b-1b7b7f6ce2f9","uuid":"a650dc8d-f812-4ff7-8345-a2f32ec0cdb6","timestamp":"2026-11-04T12:03:16.499Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-050238__xd92716/work/DenshaDeHalo-DenshaDeGo-claude-sonnet-5-5-medium-20261104-050238/engine/kits/road.js","content":"// The ROAD kit's game (a pseudo-3D coast road against the clock: curves, hills, a tunnel, traffic, checkpoints, a radio), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/66-road.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. road.html plays it; node kits/test.mjs road runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 14  ROAD  (OutRun, Pole Position, Hang-On, Road Rash). @modules road\n * A convertible on a coast road: the beach, the hills, a tunnel through the cliffs, the desert at dusk, the city at\n * night. Curves throw you outward, the shoulder slows you, palms and rocks and signs stop you dead, traffic weaves in\n * its lanes. A clock counts down; each checkpoint's arch gives time back; reach the goal before it runs out. Pick a\n * song on the radio first. Low gear pulls away hard but tops out early; high gear runs to 290.\n * KEYS: left / right (A / D) steer, up / Z gas, down / X brake, Space / Shift the gear (low, high), left and right on\n * the radio. A pad: the stick, A gas, X brake, R the gear. TOUCH: the stick steers, BRAKE and GEAR; it accelerates by\n * itself. Deep link: #road/drive (the radio skipped).\n * HOW IT WORKS: E.Road (the road module) draws the road, its hills, its tunnel, the scenery and the traffic far to near\n * and says how hard it bends; this file the stage, the car (drawn by code from behind), the traffic, the clock and\n * the radio.\n * ===================================================================================== */\nconst ROAD = (() => {\n  const A = game.audio, SEG = 200, KEYS = Object.assign({}, E.Input.DEFAULT, { gas: ['ArrowUp', 'KeyW', 'KeyZ', 'Pad0'], brake: ['ArrowDown', 'KeyS', 'KeyX', 'Pad2'], gear: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyC', 'Pad5', 'Pad7'] });\n  for (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n  /* ---- THE STAGE: five stretches, each its colors and sky; checkpoints between them; the goal at the end ---- */\n  const AREAS = [\n    { name: 'COCONUT BEACH', sky: 'ocean', colors: { grass: ['#e8d8a0', '#dccb90'], rumble: ['#f0f0f0', '#d83030'] } },\n    { name: 'GREEN HILLS', sky: 'day', colors: { grass: ['#4aa848', '#3e9a3e'], rumble: ['#f0f0f0', '#3050c0'] } },\n    { name: 'CLIFF TUNNEL', sky: 'day', colors: { grass: ['#6a5a48', '#5e5040'], rumble: ['#f0f0f0', '#d83030'] } },\n    { name: 'DESERT AT DUSK', sky: 'dusk', colors: { grass: ['#d8a060', '#c89050'], rumble: ['#f0e0c0', '#b04820'], road: ['#6a6070', '#625868'] } },\n    { name: 'CITY NIGHTS', sky: 'city-night', colors: { grass: ['#2a2a3a', '#24243a'], rumble: ['#e0e0f0', '#e0b030'], road: ['#4a4a58', '#444452'], lane: '#e0d060' } }];\n  const road = new E.Road({ segment: SEG, lanes: 3, draw: 200, fog: null });\n  const AT = [];   // where each area starts (a segment)\n  const stretch = (ai, parts) => { AT.push(road.segs.length); for (const [n, o] of parts) road.add(n, Object.assign({ colors: AREAS[ai].colors }, o)); };\n  stretch(0, [[40, {}], [60, { curve: 3 }], [40, { hill: 2000 }], [60, { curve: -4, hill: -2000 }], [50, {}], [70, { curve: 5 }], [40, {}]]);\n  stretch(1, [[50, { hill: 4000 }], [60, { curve: -3, hill: -3000 }], [40, { hill: 3000 }], [70, { curve: 4, hill: -4000 }], [50, { curve: -5 }], [40, { hill: 2000 }], [40, { hill: -2000 }]]);\n  stretch(2, [[30, {}], [80, { tunnel: true, curve: 2, colors: Object.assign({}, AREAS[2].colors, { grass: ['#3a3430', '#34302c'] }) }], [30, {}], [60, { curve: -4 }], [40, { curve: 3, hill: 1500 }]]);\n  stretch(3, [[60, { curve: -2 }], [50, { hill: 3000 }], [60, { curve: 5, hill: -3000 }], [80, {}], [60, { curve: -5 }], [50, { curve: 2 }]]);\n  stretch(4, [[60, {}], [60, { curve: 4 }], [50, { curve: -4 }], [80, { hill: 1000 }], [60, {}], [40, {}]]);\n  const GOAL = (road.segs.length - 30) * SEG, CHECKS = AT.slice(1).map(s => s * SEG);\n  // the scenery: each area's own, both sides, a checkpoint arch at each area's start, the goal's\n  const PALM = E.prop('palm').frames[0], ROCK = E.prop('rock', { size: 2 }).frames[0], CACTUS = E.prop('cactus').frames[0], TREE = E.prop('tree').frames[0];\n  const bldg = (w, h, col, lit) => ({ w, draw(g, x, y, s) { const W = w * s, H = h * s; if (W < 1) return; E.px.rect(g, x - W / 2, y - H, W, H, col); if (W > 6) for (let yy = 4 * s; yy < H - 4 * s; yy += 10 * s * 4) for (let xx = -W / 2 + 4 * s * 4; xx < W / 2 - 4 * s * 4; xx += 12 * s * 4) E.px.rect(g, x + xx, y - H + yy, Math.max(1, 5 * s * 4), Math.max(1, 5 * s * 4), lit); } });\n  const sign = text => ({ w: 600, draw(g, x, y, s) { const W = 600 * s, H = 300 * s; if (W < 2) return; E.px.rect(g, x - W * .04, y - H * 2, W * .08, H * 2, '#606068'); E.px.rect(g, x - W / 2, y - H * 2.4, W, H, '#f0e0a0'); if (W > 40) E.font.text(g, text, Math.round(x), Math.round(y - H * 2.1), '#c03020', { align: 'center', outline: false }); } });\n  const arch = (text, col) => ({ w: 0, draw(g, x, y, s) { const W = 2600 * s, H = 1500 * s; if (W < 3) return; for (const sx of [-1, 1]) E.px.rect(g, x + sx * W - 40 * s, y - H, 80 * s, H, '#e0e0e8'); E.px.rect(g, x - W, y - H, W * 2, H * .2, col); if (W > 60) E.font.text(g, text, Math.round(x), Math.round(y - H * .93), '#ffffff', { align: 'center', outline: false, scale: W > 400 ? 2 : 1 }); } });\n  for (let z = 0; z < road.length; z += SEG * 4) {\n    const a = AREAS.findIndex((_, i) => i === AREAS.length - 1 || z < AT[i + 1] * SEG), side = (z / SEG / 4) % 2 ? 1 : -1, r = (z * 7919) % 100;\n    if (road.seg(z).tunnel) continue;\n    if (a === 0) road.place(z, side * (1.5 + r / 200), PALM, 50);\n    else if (a === 1) road.place(z, side * (1.6 + r / 150), r < 50 ? TREE : ROCK, 60);\n    else if (a === 2) road.place(z, side * 1.7, ROCK, 70);\n    else if (a === 3) road.place(z, side * (1.5 + r / 120), r < 70 ? CACTUS : ROCK, 60);\n    else road.place(z, side * (2 + r / 200), bldg(900 + r * 8, 1600 + r * 30, ['#2a2a4a', '#3a2a4a', '#2a3a4a'][r % 3], '#ffd870'), 1);\n    if (r < 12) road.place(z + SEG * 2, -side * 1.4, sign(['SLOW', 'GOAL', 'TURN'][r % 3]), 1);\n  }\n  CHECKS.forEach((z, i) => road.place(z, 0, arch('CHECKPOINT', '#2a8a3a'), 1));\n  road.place(GOAL, 0, arch('GOAL', '#d02a2a'), 1);\n  const SONGS = [\n    { name: 'SEA BREEZE', bpm: 132, steps: 4, tracks: [\n      { wave: 'square', vol: .06, notes: 'E5 . G5 A5 . G5 E5 D5 | C5 . D5 E5 . . . . | E5 . G5 A5 . B5 A5 G5 | A5 . G5 E5 . . D5 .' },\n      { wave: 'triangle', vol: .26, notes: 'A2 . A3 . A2 . A3 . | F2 . F3 . F2 . F3 . | C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 .' },\n      { wave: 'drums', vol: .07, notes: 'k . h . s . h k k . h . s . h h' }] },\n    { name: 'SUNSET DRIVE', bpm: 112, steps: 4, tracks: [\n      { wave: 'pulse12', vol: .06, notes: 'D5 - - F5 E5 - D5 - | C5 - - - A4 - - - | D5 - - F5 A5 - G5 - | F5 - E5 - D5 - - -' },\n      { wave: 'triangle', vol: .26, notes: 'D3 . . D3 . . A2 . | F2 . . F2 . . C3 . | G2 . . G2 . . D3 . | A2 . . A2 . . C3 .' },\n      { wave: 'drums', vol: .06, notes: 'k . . h s . . h k . k h s . . h' }] },\n    { name: 'NEON HIGHWAY', bpm: 150, steps: 4, tracks: [\n      { wave: 'square', vol: .05, notes: 'A4 A5 E5 A4 G5 E5 C5 G4 | F4 F5 C5 F4 E5 C5 A4 E4 | G4 G5 D5 G4 F5 D5 B4 F4 | E4 E5 B4 E4 G#5 E5 B4 G#4' },\n      { wave: 'triangle', vol: .26, notes: 'A1 A2 A1 A2 A1 A2 A1 A2 | F1 F2 F1 F2 F1 F2 F1 F2 | G1 G2 G1 G2 G1 G2 G1 G2 | E1 E2 E1 E2 E1 E2 E1 E2' },\n      { wave: 'drums', vol: .07, notes: 'k h s h k h s h k h s h k k s h' }] }];\n  const SKIES = {}; const skyOf = n => SKIES[n] || (SKIES[n] = new E.Backdrop(n));\n\n  /* ---- THE DRIVE ---- */\n  const MAX = [190, 293], ACC = [130, 75], H = 1000;   // km/h by gear (low, high); the camera over the road\n  let mode = 'radio', song = 0, z = 0, x = 0, speed = 0, gear = 0, clock = 60, turn = 0, crash = 0, bump = 0, banner = null, score = 0, reached = 0, traffic = [], t = 0, endT = 0, area = 0;\n  const ahead = road.ahead(H), kmh = () => Math.round(speed);\n  function begin() {\n    mode = 'drive'; z = 0; x = 0; speed = 0; gear = 0; clock = 60; turn = 0; crash = 0; bump = 0; score = 0; reached = 0; t = 0; endT = 0; area = 0; banner = { text: AREAS[0].name, t: 0 };\n    traffic = []; for (let i = 0; i < 26; i++) traffic.push({ z: 3000 + i * 4200 + (i * 977) % 1800, x: [-.66, 0, .66][i % 3], v: 80 + (i * 37) % 70, col: ['#3060d0', '#e0e0e0', '#30a050', '#e0b020', '#a03070'][i % 5], w: 380, draw: carBack });\n    A.music(SONGS[song]); game.input.consumeAll();\n  }\n  // a car from behind: its body, rear window, tail lights and tyres, scale pixels a unit\n  function carBack(g, sx, sy, s) {\n    const W = this.w * s, Hh = W * .45; if (W < 2) return;\n    E.px.rect(g, sx - W / 2, sy - Hh, W, Hh * .7, this.col); E.px.rect(g, sx - W * .35, sy - Hh * 1.25, W * .7, Hh * .55, E.shade(this.col, -.3));\n    E.px.rect(g, sx - W * .3, sy - Hh * 1.15, W * .6, Hh * .35, '#a0c8e0'); E.px.rect(g, sx - W / 2, sy - Hh * .3, W * .18, Hh * .3, '#1a1a1a'); E.px.rect(g, sx + W * .32, sy - Hh * .3, W * .18, Hh * .3, '#1a1a1a');\n    if (W > 8) { E.px.rect(g, sx - W * .45, sy - Hh * .6, W * .12, Hh * .12, '#ff3020'); E.px.rect(g, sx + W * .33, sy - Hh * .6, W * .12, Hh * .12, '#ff3020'); }\n  }\n  function update(dt) {\n    const I = game.input; t += dt;\n    for (const k of ['brake', 'gear']) I.touchSet(k, k === 'gear' ? (gear ? 'HIGH' : 'LOW') : null, mode === 'drive');\n    if (mode === 'radio') {\n      if (I.pressed('left') || I.pressed('right')) { song = (song + (I.pressed('left') ? 2 : 1)) % 3; A.music(SONGS[song]); A.sfx('select'); }\n      const tap = I.clicked && I.clicked(); if (tap) { const k = Math.floor(tap[0] / (game.W / 3)); if (k === song) begin(); else { song = clamp(k, 0, 2); A.music(SONGS[song]); A.sfx('select'); } }\n      if (I.pressed('confirm') || I.pressed('gas')) { A.sfx('confirm'); begin(); }\n      return;\n    }\n    if (mode === 'over' || mode === 'goal') { endT += dt; if (endT > 1.5 && (I.pressed('confirm') || I.pressed('gas') || (I.clicked && I.clicked()))) { mode = 'radio'; A.sfx('confirm'); } speed = Math.max(0, speed - 120 * dt); z += speed * dt * 12; return; }\n    if (banner) { banner.t += dt; if (banner.t > 2.5) banner = null; }\n    // the clock: each checkpoint passed gives time; none left, the game is over\n    clock -= dt; if (clock <= 0) { clock = 0; mode = 'over'; endT = 0; A.music(null); A.sfx('die'); }\n    if (reached < CHECKS.length && z + ahead >= CHECKS[reached]) { reached++; clock += 40; area = reached; banner = { text: AREAS[area].name, t: 0, check: true }; A.sfx('oneup'); score += 5000; }\n    if (z + ahead >= GOAL) { mode = 'goal'; endT = 0; score += Math.round(clock) * 1000; A.music(null); A.sfx('secret'); }\n    if (I.pressed('gear')) { gear = 1 - gear; A.sfx('select', { vol: .5 }); }\n    const auto = I.lastDevice === 'touch', gas = I.down('gas') || auto, brake = I.down('brake') || I.move()[1] > .7, off = Math.abs(x) > 1.05, steer = I.move()[0];\n    // speed: the gear's pull and top, the shoulder's drag, a crash's stop\n    if (crash > 0) { crash -= dt; speed = Math.max(0, speed - 400 * dt); x += (Math.sign(x) * .5 - x) * Math.min(1, dt * 3); }   // (a crash: it spins to a stop and is put back on the road)\n    else {\n      const top = MAX[gear] * (off ? .45 : 1);\n      if (gas && speed < top) speed = Math.min(top, speed + ACC[gear] * (gear && speed < 100 ? .5 : 1) * dt);","numLines":260,"startLine":1,"totalLines":369}},"tool_result_meta":[{"id":"toolu_018P4ngVpfmhQb5buZqLwdJD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
