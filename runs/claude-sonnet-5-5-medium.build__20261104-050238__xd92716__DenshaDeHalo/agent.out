));\n      const maxScroll = Math.max(0, rows.length * 8 - (H - 52)); this.scroll = Math.min(this.scroll, maxScroll);\n      txt(g, 'ABOUT & CREDITS', 12, 6, '#ffd36a'); txt(g, pg.title + '   (' + (this.page + 1) + '/5)', 12, 17, '#9fd8ff', { font: 'tiny' });\n      g.save(); g.beginPath(); g.rect(0, 28, W, H - 44); g.clip();\n      rows.forEach((q, i) => { const y = 30 + i * 8 - this.scroll; if (y < 22 || y > H - 12) return; if (pg.rows) { txt(g, q[0], 12, y, '#ffd36a', { font: 'tiny' }); txt(g, q[1], 12 + 56, y, '#fff', { font: 'tiny' }); } else txt(g, q[1], 12, y, '#e8ecf4', { font: 'tiny' }); });\n      g.restore(); if (maxScroll > 0) txt(g, this.scroll < maxScroll ? 'more below' : 'end', W - 8, H - 18, '#8a96b0', { font: 'tiny', align: 'right' });\n      DH.promptLine(g, [['left', 'PAGE'], ['down', 'SCROLL'], ['cancel', 'BACK']], W / 2, H - 8, 'center');\n    });\n  }\n};\n'''\ns=s[:a]+new+s[b:]; open(p,'w').write(s)\nEOF\ncat > tools/exit.mjs <<'EOF'\n// writes ../exit-interview.json from src/65-about.js (the same data the in-game About screen shows) and checks it parses\nimport vm from 'node:vm';\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst root = new URL('../', import.meta.url).pathname;\nconst ctx = { window: {} }; vm.createContext(ctx); vm.runInContext(readFileSync(root + 'src/65-about.js', 'utf8').replace('const DH = window.DH;', 'const DH = window.DH = {};'), ctx);\nconst A = ctx.window.DH.ABOUT, out = { sourceInformation: A.info, testingFeedback: A.testing, engineFeedback: A.engine, promptFeedback: A.prompt, aiHub: A.aiHub };\nconst json = JSON.stringify(out, null, 2); JSON.parse(json);\nconst missing = []; (function walk(o, p) { for (const k in o) { const v = o[k]; if (v === '' && !(p === 'aiHub' && k === 'series')) missing.push(p + '.' + k); else if (v && typeof v === 'object') walk(v, p + '.' + k); } })(out, '');\nif (missing.length) { console.log('EMPTY', missing); process.exit(1); }\nwriteFileSync(root + '../exit-interview.json', 