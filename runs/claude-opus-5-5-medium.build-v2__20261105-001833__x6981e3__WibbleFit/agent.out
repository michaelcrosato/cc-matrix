{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjP8HQVXLfw5ySD9UCxV","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5345,"cache_read_input_tokens":168978,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5345},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"75bfc12f-3fe4-40cb-9e5e-7f3eccecbd83","timestamp":"2026-11-05T07:25:09.027Z","request_id":"req_011CgjP8H9rwTXVW12JdireM","thinking_duration_ms":8943,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjP8HQVXLfw5ySD9UCxV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VvAaw1kJWeYo4aR4cru48x","name":"Bash","input":{"command":"cat > src/data/lines.js <<'E'\n// All the writing that is not a menu label. Short. Polite. Faintly wounding.\nexport const ACTIVITY_LINES = {\n  tree: { s0: 'A tree would have stayed. I am only mentioning it.', s1: 'You were a tree, briefly. A windy one.', s2: 'A good tree. I have seen better. They were trees.', s3: 'Still as a tree. I checked for roots.', first: 'You are a tree. A tree does not check its phone.', repeat: 'Back to being a tree. It missed you. Trees do not say.' },\n  heron: { s0: 'The heron has been informed. It is not surprised.', s1: 'One leg. Most of the time. Thank you for trying.', s2: 'A convincing bird. From a distance. In fog.', s3: 'I nearly fed you. That is high praise here.', first: 'Stand on one leg. Look startled. You have the look.', repeat: 'The heron again. It keeps asking about you.' },\n  warrior: { s0: 'The war is going badly. I have written that down.', s1: 'A reluctant warrior. The name was not a compliment.', s2: 'You would win a small argument. Well done.', s3: 'Fearsome. Your breathing has filed a complaint. Denied.', first: 'Breathe in on In. Breathe out on Out. It is that hard.', repeat: 'You came back to war. That is how it gets you.' },\n  chair: { s0: 'The chair is not there. You seemed to notice.', s1: 'You sat on nothing, badly. I have seen it done worse.', s2: 'The chair approves. It does not exist. Still.', s3: 'A lovely sit. No furniture was involved.', first: 'Sit down. There is no chair. Nobody asked for one.', repeat: 'The Chair again. You asked for it this time.' },\n  fold: { s0: 'Your paperwork has fallen out. So have you.', s1: 'You folded. Then you unfolded. It was not requested.', s2: 'A tidy fold. The auditor has stopped looking at you.', s3: 'Flawless. You may claim your knees as a deduction.', first: 'Fold in half. Hold it. This is what April feels like.', repeat: 'Tax Season returns. It always does. Please keep records.' },\n  plank: { s0: 'The plank has rejected your offer.', s1: 'Talks broke down at around twelve seconds.', s2: 'You reached terms. The plank is reviewing them.', s3: 'A firm plank. I would sign anything you put in front of me.', first: 'Be a plank. Negotiate with the floor. It has time.', repeat: 'Round two of talks. The floor has hired someone.' },\n  squats: { s0: 'Those were squats in the sense that time passed.', s1: 'Your knees have asked me to pass on their regret.', s2: 'Good depth. Your knees and I are still talking.', s3: 'Very clean. I regret nothing on your behalf.', first: 'Follow the marker. Down, hold, up. Regret is optional.', repeat: 'More squats. You keep coming here. I keep noting it.' },\n  lunges: { s0: 'I do not accept that apology.', s1: 'An apology was made. It was not a sincere one.', s2: 'A heartfelt lunge. The floor is prepared to move on.', s3: 'Forgiven, on both sides. Left and right both.', first: 'Lunge left. Lunge right. Say sorry with each knee.', repeat: 'Sorry again? Your left knee has not forgotten.' },\n  press: { s0: 'The mortgage stayed where it was. They often do.', s1: 'You lifted the interest. The principal remains.', s2: 'Solid repayments. The bank has sent a small card.', s3: 'Paid in full. I have never seen arms so solvent.', first: 'Push it overhead. It is heavy. It will be for years.', repeat: 'Another payment. Twenty-four years to go.' },\n  hoop: { s0: 'The hoop has resigned. It left a note.', s1: 'You went around. So did the hoop, on occasion.', s2: 'A healthy economy of hoop. Modest growth.', s3: 'A boom. Analysts are calling your hips stable.', first: 'Circle the stick. Stay in the band. Catch what June throws.', repeat: 'The markets reopened. Your hips were told.' },\n  step: { s0: 'The music continued without you. It was fine.', s1: 'You and the beat have met. You are not close.', s2: 'You kept time. Time has thanked you.', s3: 'Perfect feet. I would like a word with the other feet.', first: 'Left foot on left. Right foot on right. I can go slower.', repeat: 'Step Class again. Your feet have been warned.' },\n  header: { s0: 'The coconuts won. Dennis is not fine, but neither are you.', s1: 'You met some coconuts. Your head has their details.', s2: 'A strong head. I mean that structurally.', s3: 'Dennis has stopped waving. Well done, I think.', first: 'Head the coconuts. Not the flip-flops. Dennis means well.', repeat: 'More coconuts. Dennis has been restocking.' },\n  slackline: { s0: 'You visited the lagoon. It is cool this time of year.', s1: 'You crossed. The lagoon got some of you on the way.', s2: 'A tidy crossing. The line has stopped sagging in disbelief.', s3: 'You walked on nothing. Kevin was very nearly impressed.', first: 'Push forward to walk. Stop to recover. The wind is rude.', repeat: 'Back on the line. The lagoon saved your spot.' },\n  tray: { s0: 'The vitamins have gone their own way. As you do.', s1: 'Some went in the cups. Others went on with their lives.', s2: 'Nicely sorted. I am told that is half of nutrition. No.', s3: 'Every vitamin in its place. If only all of us.', first: 'Tilt the tray. Roll each vitamin to its colour. Gently.', repeat: 'The tray again. The vitamins remember you.' },\n  jog: { s0: 'Coach Plumb waited. She is eighty-one. She has time.', s1: 'You jogged. There is a scooter that disagrees.', s2: 'A respectable lap. The scooter nodded, I believe.', s3: 'Perfect pace. Coach very nearly looked around.', first: 'Left, right, left, right. Keep up with the scooter.', repeat: 'Another lap. The island has not got any shorter.' },\n  pier: { s0: 'That was more of a drop. The judges have put down their pens.', s1: 'You left the pier. That part went well.', s2: 'A handsome splash. Paddles were raised. Not very high.', s3: 'They felt that in the hills. The judges are drying off.', first: 'Tuck low. Press at the lip. Press again before the splash.', repeat: 'The pier is still there. So are the judges. So are you.' },\n  longstand: { s0: 'You stood. Sort of.', s1: 'You stood. Mostly. I shall call it standing.', s2: 'You stood very well. I have something to tell you.', s3: 'You did not move. I have something to tell you.', first: 'Stand.', repeat: 'Standing again. There is nothing left to confess.' },\n};\n\nexport const BARKS = {\n  ringIn: ['There you are.', 'Thank you.', 'Better.', 'Noted.', 'Hold that.', 'Good. Please continue being there.', 'You came back. I knew you would. It was logged.', 'That is the circle. Well found.'],\n  ringOut: ['You have left the circle.', 'That was not the circle.', 'Your dot has wandered off.', 'I saw that.', 'The circle misses you.', 'Please collect yourself.', 'A small excursion. I will allow it. No I won\\'t.', 'Your left knee has wandered off. Please collect it.'],\n  fall: ['That was a fall. I have a form for it.', 'The floor has been in touch.', 'The floor is your friend. It has never once let go.', 'Water, mostly. You will dry.', 'Gravity was within its rights.', 'Up you get. Nobody saw. I saw.'],\n  streak: ['Excellent! ...Compared to Dennis.', 'That is a streak. Please do not make it weird.', 'Very good. I have told no one.', 'You are doing well. It is unsettling.', 'Keep going. I am running out of forms.', 'Good. Again. That was also good. Again.'],\n  hub: ['Have you been stretching? Please don\\'t lie. I\\'m very sensitive.', 'Kevin has been with us eleven years. He has never once held a pose.', 'I\\'m not angry. Scales don\\'t get angry. We get accurate.', 'Your left side is doing very well. I\\'ll let your right side know.', 'Please do not walk like that. Or do. I record either way.', 'That is the Sweat Jar. It is only sweat. Please do not ask.', 'Coach Plumb is eighty-one. She says so often.', 'The volcano is dormant. Mostly. It has a kettlebell handle.', 'Marguerite has outlived three of me.', 'You are welcome to jump. It achieves nothing. It is lovely.', 'That hammock is for the end of the day. It knows.', 'Dennis is fine. Dennis says he is fine.', 'I would hop less if you walked less.', 'The tiles were cleaned this morning. By me. Please stay on them.', 'June has told me she is pacing herself. I believe the first part.', 'Everything here starts at zero. Except you. You came with history.'],\n  leavingEarly: ['You did nothing today. I have written nothing down. It took a while.', 'The hammock is for those who have done something.\\nI won\\'t stop you. I will simply know.', 'Rest is important. You have had a great deal of it.'],\n  morning: ['Good morning. You look rested. I can\\'t see. But you felt rested.', 'Today\\'s concern: your ankles. I\\'ve been concerned all night.', 'Good morning. Please step on me.', 'Another morning. I have kept your numbers warm.', 'Welcome back. Your knees got in before you did.', 'Good morning. I have prepared a small disappointment.', 'You came back. They don\\'t always. Well done.'],\n  ow: ['Ow.', 'Ow!', 'Ow. Thank you.', '...Ow.', 'Ow, as discussed.', 'Ooh. No. Ow.'],\n  reveal: ['Your Wobble Age is {age}. Is that close? No? I\\'m so sorry.', 'Wobble Age {age}. Thank you. I have written that down.', '{age}. I checked it twice. Then I sat with it.', 'Today you are {age}. Tomorrow we can look at this again.', 'That is a {age}. A lot of people are {age}. Some of them are very old.', 'You wobbled 14 times. I only counted the ones you noticed. {age}.'],\n  sameAge: ['No change since yesterday. Which is, in a way, consistent.'],\n  betterAge: ['A little younger. I will try not to make a fuss.', 'That is down. I have told the jar.'],\n  worseAge: ['A little older than yesterday. We all are. You more so.', 'That went up. Numbers do that. It is not personal. It is a little personal.'],\n  concern: ['Tomorrow\\'s concern: your ankles.', 'Tomorrow\\'s concern: the way you sit down.', 'Tomorrow\\'s concern: that noise your knee makes.', 'Tomorrow\\'s concern: your posture near vending machines.', 'Tomorrow\\'s concern: your confidence on stairs.', 'Tomorrow\\'s concern: everything left of your spine.', 'Tomorrow\\'s concern: I would rather not say. See you at seven.'],\n  jar: ['That is {n} Drips. The jar has noticed.', 'It is only sweat. It is mostly only sweat.', 'The jar is a very good listener. It has no choice.', 'Each drip is a moment of effort, kept in a jar. Please don\\'t think about it.'],\n  beat: { dennis: 'Dennis: \"I let you have that. It\\'s the leg.\"', june: 'June: \"Okay.\" She looked up. Briefly.', marguerite: 'Marguerite: \"Oh, well done, dear. Enjoy it.\"' },\n  goal: ['Prescription filled. Five Drips, as agreed.', 'You did what Coach said. She has not reacted. That is the reaction.'],\n  classmates: {\n    marguerite: ['Both hips, new. Knee, new. Opinions, original.', 'Has anyone ever checked that scale?', 'Lovely form, dear. You\\'ll get there. I shan\\'t wait.', 'I\\'ve been coming here for nineteen years. I am beginning to enjoy it.'],\n    dennis: ['I used to do this professionally. Not this. Something near it.', 'It\\'s fine. It\\'s just the one leg.', 'The deck chair started it. I won\\'t say more. Well. It folded.', 'Got a bit of a twinge. Good twinge. Healthy.'],\n    june: ['I\\'m pacing myself.', 'My gran says you\\'re doing your best. She said it very slowly.', 'This is fine.', 'I can do that with my eyes closed. I\\'m not going to.'],\n    coach: ['Stillness is a muscle. So is regret. We train both here.', 'I am eighty-one. I say this so that you feel something.', 'Hold. You may blink on Thursday.', 'Breathe in. Not like that.', 'The floor is your friend. It has never once let go.'],\n  },\n  attract: ['This is a recording. The person in it is doing better than you.', 'This is what it looks like. It is not always like this.', 'No one in this recording was harmed. Dennis signed something.', 'You could be doing this. I will wait.', 'Note the stillness. Note Kevin.'],\n  title: ['Press any button. Gently.'],\n  repCount: ['Last one.', 'Last one.', 'I lied. This is the last one.'],\n  session: ['Thank you for coming. Please stand on your mat.', 'Everyone wobbles. Some of you will be told.'],\n};\n\nexport const STORY = {\n  ferryIntro: [\n    { who: 'ounce', mood: 'up', text: 'Hello! I\\'m Ounce. Please step on me.' },\n    { who: 'ounce', mood: 'wince', text: 'Ow.' },\n    { who: 'ounce', mood: 'flat', text: 'That was a joke. I can\\'t feel pain. I can only keep records.' },\n    { who: 'ounce', mood: 'up', text: 'Welcome to Tare Island. Everything here starts at zero.' },\n    { who: 'ounce', mood: 'flat', text: 'This dot is you. Keep it in the circle.\\nThat\\'s it. That\\'s the game.\\nEverything else is decoration.' },\n  ],\n  howOld: { who: 'ounce', mood: 'flat', text: 'How old do you feel? This is not binding.' },\n  days: {\n    1: [{ who: 'coach', text: 'I am Coach Plumb. Today: Holding Still, and one other thing.' }, { who: 'coach', text: 'Hold. You may blink on Thursday.' }, { who: 'marguerite', text: 'Don\\'t mind her, dear. She has never once been wrong.' }],\n    2: [{ who: 'dennis', text: 'You\\'re probably wondering about the deck chair.' }, { who: 'ounce', mood: 'flat', text: 'Nobody asked, Dennis.' }, { who: 'dennis', text: 'It folded. With me in it. Sideways. On a Tuesday.' }, { who: 'dennis', text: 'It\\'s fine. It\\'s just the one leg.' }],\n    3: [{ who: 'marguerite', text: 'Has anyone ever checked that scale?' }, { who: 'ounce', mood: 'up', text: 'I\\'d like to weigh in on that. No.' }, { who: 'marguerite', text: 'Mm.' }],\n    4: [{ who: 'coach', text: 'I have hung my plumb line beside you, Ounce.' }, { who: 'coach', text: 'You are leaning.' }, { who: 'ounce', mood: 'wince', text: 'The island is leaning.' }, { who: 'coach', text: 'Mm.' }],\n    5: [{ who: 'kevin', text: 'Skraaa.' }, { who: 'ounce', mood: 'seven', text: '...Good morning, Kevin. Please get off me.' }, { who: 'ounce', mood: 'seven', text: 'The dial reads seven. That is Kevin\\'s business.' }, { who: 'june', text: 'Nobody say anything.' }],\n    6: [{ who: 'ounce', mood: 'wince', text: 'Ahem. \"I have something to tell you all.\" No.' }, { who: 'ounce', mood: 'wince', text: '\"It has come to my attention that I.\" No.' }, { who: 'ounce', mood: 'up', text: 'Oh! Hello. I was not behind the jar. Please carry on.' }],\n    7: [{ who: 'coach', text: 'Today there is one thing to do.' }, { who: 'coach', text: 'Stand.' }, { who: 'ounce', mood: 'wince', text: 'I will be there. On the plaza. We should all be there.' }],\n  },\n  confession: [\n    { who: 'ounce', mood: 'wince', text: 'I have something to tell you. All of you.' },\n    { who: 'ounce', mood: 'wince', text: 'Your numbers. The ones I gave you. In the mornings.' },\n    { who: 'ounce', mood: 'seven', text: 'I have been adding seven. To everyone. For years.' },\n    { who: 'ounce', mood: 'seven', text: 'It felt motivating.' },\n    { who: 'marguerite', text: 'I knew it. I\\'ve been sixty-seven this whole time.' },\n    { who: 'dennis', text: 'So the leg. Is the leg...' },\n    { who: 'ounce', mood: 'flat', text: 'The leg is still the leg, Dennis.' },\n    { who: 'coach', text: 'You may blink.' },\n  ],\n  afterChart: [\n    { who: 'ounce', mood: 'up', text: 'There. That is your real week. I have taken the seven back.' },\n    { who: 'ounce', mood: 'flat', text: 'You wobbled every day. You came back every day. I wrote it all down.' },\n    { who: 'ounce', mood: 'up', text: 'See you tomorrow. Bring your knees.' },\n  ],\n  week2: { who: 'ounce', mood: 'up', text: 'Week two. No sevens. I have only the truth now. I apologise in advance.' },\n};\n\nexport const NAMES = { ounce: 'Ounce', coach: 'Coach Plumb', marguerite: 'Marguerite', dennis: 'Dennis', june: 'June', kevin: 'Kevin', player: 'You' };\n\nexport const QUESTIONS = [\n  { q: 'When you stand up, what sound do you make?', a: ['Oof.', 'Hnng.', 'I have become the sound.'], r: ['Thank you. I have written that down.', 'I know that one. Your knees do the harmony.', 'That is what I thought. I can hear it from here.'] },\n  { q: 'Have you ever apologised to a chair?', a: ['Yes.', 'Not yet.', 'It started it.'], r: ['It was good of you. The chair has moved on.', 'You will. Thank you for your honesty.', 'Dennis said the same. Please see Dennis.'] },\n  { q: 'How many stairs is too many?', a: ['One.', 'All of them.', 'Depends who\\'s watching.'], r: ['One is a good number. I have noted your ambition.', 'A clear position. I respect it from down here.', 'I am always watching. So: fewer.'] },\n  { q: 'How do you feel about your ankles?', a: ['Fine.', 'We don\\'t speak.', 'Which ones?'], r: ['They say the same. They did not sound convinced.', 'Give them time. They have been through a lot, with you.', 'I will put \"several\".'] },\n  { q: 'What is your relationship with the floor?', a: ['Distant.', 'Improving.', 'It\\'s complicated.'], r: ['It speaks well of you. It would, it has to hold you up.', 'Good. Most people only visit when something goes wrong.', 'I will put \"seeing other surfaces\".'] },\n  { q: 'If your knees could talk, what would they say?', a: ['Please.', 'Why.', 'Nothing. They\\'ve given up.'], r: ['They were polite. You raised them well.', 'A fair question. I do not have the answer on file.', 'They haven\\'t. I hear them from here.'] },\n  { q: 'Are you happy?', a: ['Yes.', 'No.', 'Is this graded?'], r: ['It\\'s all graded.', 'It\\'s all graded.', 'It\\'s all graded.'] },\n];\nE\ncat > src/data/poses.js <<'E'\n// Holding Still poses. Plain data: a new pose needs no code.\nexport const POSES = {\n  tree: { clip: 'Tree', ring: 0.40, hold: 25, breath: 0 },\n  heron: { clip: 'Heron', ring: 0.36, hold: 25, breath: 0, wander: 0.12 },\n  warrior: { clip: 'Warrior', ring: 0.32, hold: 30, breath: 8, yNoise: 1.3 },\n  chair: { clip: 'Chair', ring: 0.30, hold: 30, breath: 8, noiseRamp: [1, 1.5] },\n  fold: { clip: 'Fold', ring: 0.28, hold: 30, breath: 6, wander: 0.18 },\n  plank: { clip: 'Plank', ring: 0.24, hold: 35, breath: 6, instScale: 1.2, tremorAfter: 20 },\n};\nexport const LONG_STAND = [\n  { t: 0, say: ['coach', 'Stand.'], ring: 0.40 },\n  { t: 10, say: ['ounce', 'Kevin has landed on you. He is staff.'], kevin: true, bias: 0.10 },\n  { t: 20, say: ['dennis', 'Ah... ah... ACHOO.'], sneeze: true, impulse: [0, -0.6] },\n  { t: 30, ring: 0.34 },\n  { t: 35, say: ['ounce', 'It is raining. This is not part of it. It may be part of it.'], rain: true, noise: 1.2 },\n  { t: 45, say: ['ounce', 'Ignore her.'], clap: true },\n  { t: 50, ring: 0.28 },\n  { t: 55, say: ['june', 'Are you nearly done?'], drift: true },\n  { t: 65, say: ['ounce', 'The volcano. Mostly dormant. Mostly.'], rumble: true, randomImpulse: 0.7 },\n  { t: 75, say: ['ounce', '...'], rain: false, noise: 1, ring: 0.24, swell: true },\n  { t: 85, say: ['ounce', 'Kevin is leaving. Thank you, Kevin.'], kevin: false, bias: 0, randomImpulse: 0.3 },\n  { t: 90, say: ['coach', 'You may blink.'], end: true },\n];\nE\ncat > src/data/reps.js <<'E'\n// The Rep Shed. axis: which way the stick goes; sides: alternating targets.\nexport const REPS = {\n  squats: { clip: 'SquatRep', axis: 'down', reps: 10, tempo: 3.2 },\n  lunges: { clip: 'LungeRepR', clipL: 'LungeRepL', axis: 'side', reps: 10, tempo: 3.2 },\n  press: { clip: 'Press', axis: 'up', reps: 8, tempo: 3.6, lagScale: 1.5 },\n};\nexport const REP_CURVE = { up: 0.4, hold: 0.15, down: 0.35, rest: 0.1 };\nexport const repTarget = (u) => {\n  const { up, hold, down } = REP_CURVE;\n  if (u < up) return u / up;\n  if (u < up + hold) return 1;\n  if (u < up + hold + down) return 1 - (u - up - hold) / down;\n  return 0;\n};\nexport const REP_GRADES = [[0.85, 'Perfect'], [0.65, 'Good'], [-9, 'Wobbly']];\nE\ncat > src/data/charts.js <<'E'\n// Step Class at 104 BPM: 32 bars, one string per bar, 8 slots. L, R or rest.\nconst verseA = 'L...R...', verseB = 'L.R.L.R.', verseC = 'L.R.L...', chorusA = 'L.R.L.R.', chorusB = 'L.RRL.R.', chorusC = 'LL.RL.R.';\nconst brk = ['L.......', '....R...', 'L...R...', 'L.R.L.R.'];\nexport const STEP_BPM = 104;\nexport const CHART_SECTIONS = [\n  { name: 'intro', bars: [verseA, verseA, verseA, verseC] },\n  { name: 'verse', bars: [verseB, verseB, verseC, verseB, verseB, verseC, verseB, chorusA] },\n  { name: 'chorus', bars: [chorusA, chorusB, chorusA, chorusC, chorusA, chorusB, chorusC, chorusA] },\n  { name: 'breakdown', bars: brk },\n  { name: 'final', bars: [chorusB, chorusC, chorusB, chorusC, chorusB, chorusC, chorusA, 'L.R.L.R.'] },\n];\nexport const STEP_HARD_FILL = 'LRLRLRLR';\nexport function chartNotes(sections = CHART_SECTIONS, { maxBars = Infinity, hard = false } = {}) {\n  const bar = (60 / STEP_BPM) * 4, slot = bar / 8; const notes = []; let b = 0;\n  for (const s of sections) for (let chartBar of s.bars) {\n    if (b >= maxBars) return { notes, bars: b, duration: b * bar };\n    if (hard && s.name === 'final' && b % 2 === 0) chartBar = STEP_HARD_FILL;\n    for (let i = 0; i < 8; i++) if (chartBar[i] === 'L' || chartBar[i] === 'R') notes.push({ t: b * bar + i * slot, foot: chartBar[i], bar: b });\n    b++;\n  }\n  return { notes, bars: b, duration: b * bar };\n}\nE\ncat > src/data/boards.js <<'E'\n// Vitamin Tray boards: # wall, . floor, o start, R/B/Y cups, _ a gap in the rail that drops a vitamin.\nexport const BOARDS = [\n  { name: 'Morning Dose', rows: [\n    '#############',\n    '#R....#....B#',\n    '#.....#.....#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#.....#.....#',\n    '#R....#....B#',\n    '#############'] },\n  { name: 'Afternoon Dose', rows: [\n    '#############',\n    '#R....#....Y#',\n    '#..###.###..#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#.....#.....#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#..###.###..#',\n    '#B....#....R#',\n    '#############'] },\n  { name: 'Evening Dose', rows: [\n    '#####___#####',\n    '#R....#....Y#',\n    '#..##...##..#',\n    '_....o.o...._',\n    '#..o.....o..#',\n    '#.....#.....#',\n    '#..o.....o..#',\n    '_....o.o...._',\n    '#..##...##..#',\n    '#B....#....Y#',\n    '#####___#####'] },\n];\nE\ncat > src/data/classmates.js <<'E'\n// Avatars: looks as palette names. Rival scores live with each activity.\nexport const CAST_LOOKS = {\n  coach: { skin: 'sand', top: 'cyan', bottom: 'cyan', shoe: 'white', hair: 'mist', bun: true, long: true },\n  marguerite: { skin: 'sand', top: 'plum', bottom: 'white', shoe: 'white', hair: 'white', style: 'curl', long: true },\n  dennis: { skin: 'orange', top: 'lime', bottom: 'navy', shoe: 'red', hair: 'slate', style: 'bald' },\n  june: { skin: 'orange', top: 'mist', bottom: 'slate', shoe: 'ink', hair: 'ink', style: 'long', long: true },\n};\nexport const AVATARS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'lime', bottom: 'teal', shoe: 'white', hair: 'plum', style: 'long' },\n  { skin: 'red', top: 'sand', bottom: 'navy', shoe: 'white', hair: 'ink', style: 'bun', bun: true },\n  { skin: 'plum', top: 'cyan', bottom: 'white', shoe: 'sky', hair: 'ink', style: 'spike' },\n  { skin: 'sand', top: 'orange', bottom: 'slate', shoe: 'ink', hair: 'red', style: 'curl' },\n  { skin: 'orange', top: 'sky', bottom: 'white', shoe: 'red', hair: 'sand', style: 'bald', headband: 'lime' },\n];\nexport const LOCKER = {\n  skin: ['sand', 'orange', 'red', 'plum'],\n  style: ['cap', 'long', 'bun', 'spike', 'curl', 'bald'],\n  hair: ['ink', 'plum', 'red', 'sand', 'white', 'mist'],\n  top: ['white', 'lime', 'sand', 'cyan', 'orange', 'sky', 'plum'],\n  bottom: ['sky', 'teal', 'navy', 'white', 'slate', 'ink'],\n  headband: ['none', 'red', 'lime', 'sky'],\n};\nexport const SEAT_COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport const SEAT_PALETTE = ['red', 'blue', 'green', 'sand'];\nexport const SEAT_LOOKS = [\n  { skin: 'sand', top: 'red', bottom: 'white', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'blue', bottom: 'white', shoe: 'white', hair: 'plum', style: 'long' },\n  { skin: 'red', top: 'green', bottom: 'white', shoe: 'white', hair: 'ink', style: 'spike' },\n  { skin: 'plum', top: 'sand', bottom: 'white', shoe: 'white', hair: 'ink', style: 'bun', bun: true },\n];\nexport const BOT_NAMES = ['Marguerite', 'Dennis', 'June', 'Kevin'];\nE\ncat > src/data/unlocks.js <<'E'\n// The Sweat Jar: drips -> Locker Room items and a remark each.\nexport const MILESTONES = [\n  { at: 10, item: 'band2', name: 'A second headband', remark: 'A second headband. In case the first one gives up.' },\n  { at: 25, item: 'cape', name: 'Towel cape', remark: 'A towel cape. It is a towel. You may call it a cape.' },\n  { at: 45, item: 'confidence', name: 'Confidence', remark: 'Confidence: no visible effect. Please wear it anyway.' },\n  { at: 70, item: 'whistle', name: 'Tiny whistle', remark: 'A tiny whistle. Coach would like it back. She will not ask.' },\n  { at: 100, item: 'visor', name: 'Sun visor', remark: 'A sun visor. It says you have given this some thought.' },\n  { at: 135, item: 'wristbands', name: 'Serious wristbands', remark: 'Serious wristbands. They take you seriously. They are alone.' },\n  { at: 175, item: 'plumbbob', name: 'Your own plumb bob', remark: 'Your own plumb bob. You may now tell people they are leaning.' },\n];\nexport const ITEM_SLOTS = { band2: 'Spare band', cape: 'Towel cape', confidence: 'Confidence', whistle: 'Whistle', visor: 'Visor', wristbands: 'Wristbands', plumbbob: 'Plumb bob' };\nE\ncat > src/data/stations.js <<'E'\nexport const STATIONS = {\n  terrace: { name: 'Weigh-In Terrace', at: [0, 3], kind: 'talk' },\n  pavilion: { name: 'Pavilion of Holding Still', at: [-11, 3], kind: 'menu', remark: 'Holding still. The hardest thing. Coach makes it look easy. It is rude.' },\n  shed: { name: 'The Rep Shed', at: [11, 3], kind: 'menu', remark: 'The Rep Shed. Every exercise here is two longer than it says.' },\n  beach: { name: 'Beat Beach', at: [12, -10], kind: 'menu', remark: 'Beat Beach. Bring your hips. Leave your dignity with the towels.' },\n  lagoon: { name: 'Lagoon Games', at: [-12, -10], kind: 'menu', remark: 'Lagoon Games. The water is warm. You will find that out.' },\n  gate: { name: 'Jogging Path', at: [0, 11], kind: 'menu', remark: 'One lap of the island. Coach has charged her scooter.' },\n  jar: { name: 'Sweat Jar', at: [4, -4], kind: 'scene', scene: 'jar' },\n  locker: { name: 'Locker Room', at: [-4, -4], kind: 'scene', scene: 'locker', unlockDay: 2 },\n  hall: { name: 'Hall of Numbers', at: [0, -8], kind: 'scene', scene: 'records' },\n  hammock: { name: 'Hammock', at: [14, 10], kind: 'hammock' },\n  stand: { name: 'The Long Stand', at: [0, 7], kind: 'menu', remark: 'Today there is one thing to do.', unlockDay: 7 },\n};\nE\ncat > src/data/medley.js <<'E'\n// The Medley: three events in fixed windows. Picks come from a seeded stream.\nexport const MEDLEY = {\n  eventSeconds: 55, gapSeconds: 10,\n  events: [\n    { name: 'Stillness', award: 'Stillest', picks: ['tree', 'heron', 'warrior', 'chair', 'fold'], norm: 100 },\n    { name: 'Beat', award: 'Most Apologetic', picks: ['squats', 'lunges', 'hoop', 'step'], norm: { squats: 100, lunges: 100, press: 100, hoop: 130, step: 100 } },\n    { name: 'Lean', award: 'Hardest Head', picks: ['header'], norm: 900 },\n  ],\n};\nexport const medleyWindow = (i) => { const s = i * (MEDLEY.eventSeconds + MEDLEY.gapSeconds); return { start: s, end: s + MEDLEY.eventSeconds }; };\nexport const MEDLEY_TOTAL = MEDLEY.events.length * MEDLEY.eventSeconds + (MEDLEY.events.length - 1) * MEDLEY.gapSeconds;\nE\ncat > src/data/week.js <<'E'\n// The week as data. A new day needs no code.\nexport const WEEK = [\n  { day: 1, test: 'stillness', goal: { kind: 'poseAndOther' }, goalText: 'Holding Still and one other', opens: ['tree', 'heron', 'squats', 'hoop'] },\n  { day: 2, test: 'lean', goal: { kind: 'stars', n: 2 }, goalText: '2 stars in anything', opens: ['header', 'lunges', 'warrior', 'locker'] },\n  { day: 3, test: 'chase', goal: { kind: 'first' }, goalText: 'Something you haven\\'t done', opens: ['step', 'slackline', 'chair'] },\n  { day: 4, test: 'stillness', goal: { kind: 'count', n: 3 }, goalText: '3 activities', opens: ['tray', 'press', 'fold'] },\n  { day: 5, test: 'lean', goal: { kind: 'beat', who: 'dennis' }, goalText: 'Beat Dennis at anything', opens: ['jog', 'pier', 'plank'] },\n  { day: 6, test: 'chase', goal: { kind: 'stars', n: 3 }, goalText: '3 stars anywhere', opens: [], hard: true },\n  { day: 7, test: 'stillness', goal: { kind: 'did', id: 'longstand' }, goalText: 'Stand.', opens: ['longstand'] },\n];\nexport const weekDay = (d) => WEEK[Math.min(WEEK.length, Math.max(1, d)) - 1];\nE\ncat > src/data/activities.js <<'E'\n// One entry per activity: everything a designer changes. Scene code reads it.\nconst rivals = ([a, b, c]) => ({ dennis: Math.round(a * 1.05), june: Math.round((b + c) / 2), marguerite: Math.round(c * 1.04) });\nconst POSE_STARS = [45, 70, 90], REP_STARS = [55, 75, 90];\nconst act = (id, name, station, scene, song, day, stars, extra = {}) => ({ id, name, station, scene, song, day, stars, rivals: extra.rivalScores ?? rivals(stars), lane: false, hard: {}, ...extra });\nexport const ACTIVITIES = [\n  act('tree', 'Apologetic Tree', 'pavilion', 'poses', 'still', 1, POSE_STARS, { lane: true, hard: { ring: 0.3 } }),\n  act('heron', 'Startled Heron', 'pavilion', 'poses', 'still', 1, POSE_STARS, { lane: true, hard: { ring: 0.27 } }),\n  act('warrior', 'Reluctant Warrior', 'pavilion', 'poses', 'still', 2, POSE_STARS, { lane: true, hard: { ring: 0.24 } }),\n  act('chair', 'The Chair Nobody Asked For', 'pavilion', 'poses', 'still', 3, POSE_STARS, { lane: true, hard: { ring: 0.23 } }),\n  act('fold', 'Tax Season', 'pavilion', 'poses', 'still', 4, POSE_STARS, { lane: true, hard: { ring: 0.22 } }),\n  act('plank', 'Plank Negotiation', 'pavilion', 'poses', 'still', 5, POSE_STARS, { lane: true, hard: { ring: 0.2 } }),\n  act('squats', 'Squats of Regret', 'shed', 'reps', 'shed', 1, REP_STARS, { lane: true, hard: { tempo: 2.6 } }),\n  act('lunges', 'Apology Lunges', 'shed', 'reps', 'shed', 2, REP_STARS, { lane: true, hard: { tempo: 2.6 } }),\n  act('press', 'Overhead Mortgage', 'shed', 'reps', 'shed', 4, REP_STARS, { lane: true, hard: { tempo: 3 } }),\n  act('hoop', 'Hoop Economics', 'beach', 'hoop', 'hoop', 1, [35, 70, 110], { lane: true, hard: { low: 1.3, high: 2.2 } }),\n  act('step', 'Step Class', 'beach', 'step', 'step', 3, [55, 75, 90], { lane: true, hard: { fill: true, window: 0.8 } }),\n  act('header', 'Coconut Header', 'lagoon', 'header', 'lagoon', 2, [150, 400, 800], { lane: true, hard: { interval: 0.75 } }),\n  act('slackline', 'Slackline', 'lagoon', 'slackline', 'lagoon', 3, [1, 2, 3], { starsFromSim: true, rivalScores: { dennis: 620, june: 830, marguerite: 930 }, hard: { walkInst: 1.2 } }),\n  act('tray', 'Vitamin Tray', 'lagoon', 'tray', 'lagoon', 4, [40, 60, 80], { percentStars: true, hard: { seconds: 45 } }),\n  act('jog', 'Island Jog', 'gate', 'jog', 'jog', 5, [55, 75, 90], { hard: { speed: 1.2 } }),\n  act('pier', 'Pier Jump', 'lagoon', 'pier', 'lagoon', 5, [18, 28, 38], { hard: { window: 0.7 } }),\n  act('longstand', 'The Long Stand', 'stand', 'longstand', 'stand', 7, POSE_STARS, { rivalScores: { dennis: 41, june: 80, marguerite: 96 } }),\n];\nexport const ACT = Object.fromEntries(ACTIVITIES.map((a) => [a.id, a]));\nexport const STATION_ACTS = (s) => ACTIVITIES.filter((a) => a.station === s);\nexport const COACH_LINES = {\n  poses: ['You are a tree. A tree does not check its phone.', 'Stillness is a muscle. So is regret. We train both here.', 'Hold. You may blink on Thursday.'],\n  reps: ['Good. Again. That was also good. Again.', 'I am eighty-one. I say this so that you feel something.'],\n  hoop: ['Your hips know what to do. Tell them I said so.'],\n  step: ['Left. Right. They are both yours. I checked.'],\n  header: ['Dennis has a catapult. I have stopped asking.'],\n  slackline: ['The line is not your enemy. The wind is. And you.'],\n  tray: ['Slowly. They are small, and they can sense fear.'],\n  jog: ['I shall be on the scooter. Try to keep up.'],\n  pier: ['Jump in the water. Do it correctly.'],\n  longstand: ['Stand.'],\n};\nE\necho \"- [x] core (dot,tunables,actions,device,clock,save) + data (lines,poses,reps,charts,boards,week,activities...)\" >> PROGRESS.md","description":"Write all game data files"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5345,"cache_read_input_tokens":168978,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5345},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"dcac3bbc-f4a8-48d8-b16d-88075bffb5a8","timestamp":"2026-11-05T07:27:22.111Z","request_id":"req_011CgjP8H9rwTXVW12JdireM","wire_tool_inputs":{"toolu_01VvAaw1kJWeYo4aR4cru48x":{"command":"cat > src/data/lines.js <<'E'\n// All the writing that is not a menu label. Short. Polite. Faintly wounding.\nexport const ACTIVITY_LINES = {\n  tree: { s0: 'A tree would have stayed. I am only mentioning it.', s1: 'You were a tree, briefly. A windy one.', s2: 'A good tree. I have seen better. They were trees.', s3: 'Still as a tree. I checked for roots.', first: 'You are a tree. A tree does not check its phone.', repeat: 'Back to being a tree. It missed you. Trees do not say.' },\n  heron: { s0: 'The heron has been informed. It is not surprised.', s1: 'One leg. Most of the time. Thank you for trying.', s2: 'A convincing bird. From a distance. In fog.', s3: 'I nearly fed you. That is high praise here.', first: 'Stand on one leg. Look startled. You have the look.', repeat: 'The heron again. It keeps asking about you.' },\n  warrior: { s0: 'The war is going badly. I have written that down.', s1: 'A reluctant warrior. The name was not a compliment.', s2: 'You would win a small argument. Well done.', s3: 'Fearsome. Your breathing has filed a complaint. Denied.', first: 'Breathe in on In. Breathe out on Out. It is that hard.', repeat: 'You came back to war. That is how it gets you.' },\n  chair: { s0: 'The chair is not there. You seemed to notice.', s1: 'You sat on nothing, badly. I have seen it done worse.', s2: 'The chair approves. It does not exist. Still.', s3: 'A lovely sit. No furniture was involved.', first: 'Sit down. There is no chair. Nobody asked for one.', repeat: 'The Chair again. You asked for it this time.' },\n  fold: { s0: 'Your paperwork has fallen out. So have you.', s1: 'You folded. Then you unfolded. It was not requested.', s2: 'A tidy fold. The auditor has stopped looking at you.', s3: 'Flawless. You may claim your knees as a deduction.', first: 'Fold in half. Hold it. This is what April feels like.', repeat: 'Tax Season returns. It always does. Please keep records.' },\n  plank: { s0: 'The plank has rejected your offer.', s1: 'Talks broke down at around twelve seconds.', s2: 'You reached terms. The plank is reviewing them.', s3: 'A firm plank. I would sign anything you put in front of me.', first: 'Be a plank. Negotiate with the floor. It has time.', repeat: 'Round two of talks. The floor has hired someone.' },\n  squats: { s0: 'Those were squats in the sense that time passed.', s1: 'Your knees have asked me to pass on their regret.', s2: 'Good depth. Your knees and I are still talking.', s3: 'Very clean. I regret nothing on your behalf.', first: 'Follow the marker. Down, hold, up. Regret is optional.', repeat: 'More squats. You keep coming here. I keep noting it.' },\n  lunges: { s0: 'I do not accept that apology.', s1: 'An apology was made. It was not a sincere one.', s2: 'A heartfelt lunge. The floor is prepared to move on.', s3: 'Forgiven, on both sides. Left and right both.', first: 'Lunge left. Lunge right. Say sorry with each knee.', repeat: 'Sorry again? Your left knee has not forgotten.' },\n  press: { s0: 'The mortgage stayed where it was. They often do.', s1: 'You lifted the interest. The principal remains.', s2: 'Solid repayments. The bank has sent a small card.', s3: 'Paid in full. I have never seen arms so solvent.', first: 'Push it overhead. It is heavy. It will be for years.', repeat: 'Another payment. Twenty-four years to go.' },\n  hoop: { s0: 'The hoop has resigned. It left a note.', s1: 'You went around. So did the hoop, on occasion.', s2: 'A healthy economy of hoop. Modest growth.', s3: 'A boom. Analysts are calling your hips stable.', first: 'Circle the stick. Stay in the band. Catch what June throws.', repeat: 'The markets reopened. Your hips were told.' },\n  step: { s0: 'The music continued without you. It was fine.', s1: 'You and the beat have met. You are not close.', s2: 'You kept time. Time has thanked you.', s3: 'Perfect feet. I would like a word with the other feet.', first: 'Left foot on left. Right foot on right. I can go slower.', repeat: 'Step Class again. Your feet have been warned.' },\n  header: { s0: 'The coconuts won. Dennis is not fine, but neither are you.', s1: 'You met some coconuts. Your head has their details.', s2: 'A strong head. I mean that structurally.', s3: 'Dennis has stopped waving. Well done, I think.', first: 'Head the coconuts. Not the flip-flops. Dennis means well.', repeat: 'More coconuts. Dennis has been restocking.' },\n  slackline: { s0: 'You visited the lagoon. It is cool this time of year.', s1: 'You crossed. The lagoon got some of you on the way.', s2: 'A tidy crossing. The line has stopped sagging in disbelief.', s3: 'You walked on nothing. Kevin was very nearly impressed.', first: 'Push forward to walk. Stop to recover. The wind is rude.', repeat: 'Back on the line. The lagoon saved your spot.' },\n  tray: { s0: 'The vitamins have gone their own way. As you do.', s1: 'Some went in the cups. Others went on with their lives.', s2: 'Nicely sorted. I am told that is half of nutrition. No.', s3: 'Every vitamin in its place. If only all of us.', first: 'Tilt the tray. Roll each vitamin to its colour. Gently.', repeat: 'The tray again. The vitamins remember you.' },\n  jog: { s0: 'Coach Plumb waited. She is eighty-one. She has time.', s1: 'You jogged. There is a scooter that disagrees.', s2: 'A respectable lap. The scooter nodded, I believe.', s3: 'Perfect pace. Coach very nearly looked around.', first: 'Left, right, left, right. Keep up with the scooter.', repeat: 'Another lap. The island has not got any shorter.' },\n  pier: { s0: 'That was more of a drop. The judges have put down their pens.', s1: 'You left the pier. That part went well.', s2: 'A handsome splash. Paddles were raised. Not very high.', s3: 'They felt that in the hills. The judges are drying off.', first: 'Tuck low. Press at the lip. Press again before the splash.', repeat: 'The pier is still there. So are the judges. So are you.' },\n  longstand: { s0: 'You stood. Sort of.', s1: 'You stood. Mostly. I shall call it standing.', s2: 'You stood very well. I have something to tell you.', s3: 'You did not move. I have something to tell you.', first: 'Stand.', repeat: 'Standing again. There is nothing left to confess.' },\n};\n\nexport const BARKS = {\n  ringIn: ['There you are.', 'Thank you.', 'Better.', 'Noted.', 'Hold that.', 'Good. Please continue being there.', 'You came back. I knew you would. It was logged.', 'That is the circle. Well found.'],\n  ringOut: ['You have left the circle.', 'That was not the circle.', 'Your dot has wandered off.', 'I saw that.', 'The circle misses you.', 'Please collect yourself.', 'A small excursion. I will allow it. No I won\\'t.', 'Your left knee has wandered off. Please collect it.'],\n  fall: ['That was a fall. I have a form for it.', 'The floor has been in touch.', 'The floor is your friend. It has never once let go.', 'Water, mostly. You will dry.', 'Gravity was within its rights.', 'Up you get. Nobody saw. I saw.'],\n  streak: ['Excellent! ...Compared to Dennis.', 'That is a streak. Please do not make it weird.', 'Very good. I have told no one.', 'You are doing well. It is unsettling.', 'Keep going. I am running out of forms.', 'Good. Again. That was also good. Again.'],\n  hub: ['Have you been stretching? Please don\\'t lie. I\\'m very sensitive.', 'Kevin has been with us eleven years. He has never once held a pose.', 'I\\'m not angry. Scales don\\'t get angry. We get accurate.', 'Your left side is doing very well. I\\'ll let your right side know.', 'Please do not walk like that. Or do. I record either way.', 'That is the Sweat Jar. It is only sweat. Please do not ask.', 'Coach Plumb is eighty-one. She says so often.', 'The volcano is dormant. Mostly. It has a kettlebell handle.', 'Marguerite has outlived three of me.', 'You are welcome to jump. It achieves nothing. It is lovely.', 'That hammock is for the end of the day. It knows.', 'Dennis is fine. Dennis says he is fine.', 'I would hop less if you walked less.', 'The tiles were cleaned this morning. By me. Please stay on them.', 'June has told me she is pacing herself. I believe the first part.', 'Everything here starts at zero. Except you. You came with history.'],\n  leavingEarly: ['You did nothing today. I have written nothing down. It took a while.', 'The hammock is for those who have done something.\\nI won\\'t stop you. I will simply know.', 'Rest is important. You have had a great deal of it.'],\n  morning: ['Good morning. You look rested. I can\\'t see. But you felt rested.', 'Today\\'s concern: your ankles. I\\'ve been concerned all night.', 'Good morning. Please step on me.', 'Another morning. I have kept your numbers warm.', 'Welcome back. Your knees got in before you did.', 'Good morning. I have prepared a small disappointment.', 'You came back. They don\\'t always. Well done.'],\n  ow: ['Ow.', 'Ow!', 'Ow. Thank you.', '...Ow.', 'Ow, as discussed.', 'Ooh. No. Ow.'],\n  reveal: ['Your Wobble Age is {age}. Is that close? No? I\\'m so sorry.', 'Wobble Age {age}. Thank you. I have written that down.', '{age}. I checked it twice. Then I sat with it.', 'Today you are {age}. Tomorrow we can look at this again.', 'That is a {age}. A lot of people are {age}. Some of them are very old.', 'You wobbled 14 times. I only counted the ones you noticed. {age}.'],\n  sameAge: ['No change since yesterday. Which is, in a way, consistent.'],\n  betterAge: ['A little younger. I will try not to make a fuss.', 'That is down. I have told the jar.'],\n  worseAge: ['A little older than yesterday. We all are. You more so.', 'That went up. Numbers do that. It is not personal. It is a little personal.'],\n  concern: ['Tomorrow\\'s concern: your ankles.', 'Tomorrow\\'s concern: the way you sit down.', 'Tomorrow\\'s concern: that noise your knee makes.', 'Tomorrow\\'s concern: your posture near vending machines.', 'Tomorrow\\'s concern: your confidence on stairs.', 'Tomorrow\\'s concern: everything left of your spine.', 'Tomorrow\\'s concern: I would rather not say. See you at seven.'],\n  jar: ['That is {n} Drips. The jar has noticed.', 'It is only sweat. It is mostly only sweat.', 'The jar is a very good listener. It has no choice.', 'Each drip is a moment of effort, kept in a jar. Please don\\'t think about it.'],\n  beat: { dennis: 'Dennis: \"I let you have that. It\\'s the leg.\"', june: 'June: \"Okay.\" She looked up. Briefly.', marguerite: 'Marguerite: \"Oh, well done, dear. Enjoy it.\"' },\n  goal: ['Prescription filled. Five Drips, as agreed.', 'You did what Coach said. She has not reacted. That is the reaction.'],\n  classmates: {\n    marguerite: ['Both hips, new. Knee, new. Opinions, original.', 'Has anyone ever checked that scale?', 'Lovely form, dear. You\\'ll get there. I shan\\'t wait.', 'I\\'ve been coming here for nineteen years. I am beginning to enjoy it.'],\n    dennis: ['I used to do this professionally. Not this. Something near it.', 'It\\'s fine. It\\'s just the one leg.', 'The deck chair started it. I won\\'t say more. Well. It folded.', 'Got a bit of a twinge. Good twinge. Healthy.'],\n    june: ['I\\'m pacing myself.', 'My gran says you\\'re doing your best. She said it very slowly.', 'This is fine.', 'I can do that with my eyes closed. I\\'m not going to.'],\n    coach: ['Stillness is a muscle. So is regret. We train both here.', 'I am eighty-one. I say this so that you feel something.', 'Hold. You may blink on Thursday.', 'Breathe in. Not like that.', 'The floor is your friend. It has never once let go.'],\n  },\n  attract: ['This is a recording. The person in it is doing better than you.', 'This is what it looks like. It is not always like this.', 'No one in this recording was harmed. Dennis signed something.', 'You could be doing this. I will wait.', 'Note the stillness. Note Kevin.'],\n  title: ['Press any button. Gently.'],\n  repCount: ['Last one.', 'Last one.', 'I lied. This is the last one.'],\n  session: ['Thank you for coming. Please stand on your mat.', 'Everyone wobbles. Some of you will be told.'],\n};\n\nexport const STORY = {\n  ferryIntro: [\n    { who: 'ounce', mood: 'up', text: 'Hello! I\\'m Ounce. Please step on me.' },\n    { who: 'ounce', mood: 'wince', text: 'Ow.' },\n    { who: 'ounce', mood: 'flat', text: 'That was a joke. I can\\'t feel pain. I can only keep records.' },\n    { who: 'ounce', mood: 'up', text: 'Welcome to Tare Island. Everything here starts at zero.' },\n    { who: 'ounce', mood: 'flat', text: 'This dot is you. Keep it in the circle.\\nThat\\'s it. That\\'s the game.\\nEverything else is decoration.' },\n  ],\n  howOld: { who: 'ounce', mood: 'flat', text: 'How old do you feel? This is not binding.' },\n  days: {\n    1: [{ who: 'coach', text: 'I am Coach Plumb. Today: Holding Still, and one other thing.' }, { who: 'coach', text: 'Hold. You may blink on Thursday.' }, { who: 'marguerite', text: 'Don\\'t mind her, dear. She has never once been wrong.' }],\n    2: [{ who: 'dennis', text: 'You\\'re probably wondering about the deck chair.' }, { who: 'ounce', mood: 'flat', text: 'Nobody asked, Dennis.' }, { who: 'dennis', text: 'It folded. With me in it. Sideways. On a Tuesday.' }, { who: 'dennis', text: 'It\\'s fine. It\\'s just the one leg.' }],\n    3: [{ who: 'marguerite', text: 'Has anyone ever checked that scale?' }, { who: 'ounce', mood: 'up', text: 'I\\'d like to weigh in on that. No.' }, { who: 'marguerite', text: 'Mm.' }],\n    4: [{ who: 'coach', text: 'I have hung my plumb line beside you, Ounce.' }, { who: 'coach', text: 'You are leaning.' }, { who: 'ounce', mood: 'wince', text: 'The island is leaning.' }, { who: 'coach', text: 'Mm.' }],\n    5: [{ who: 'kevin', text: 'Skraaa.' }, { who: 'ounce', mood: 'seven', text: '...Good morning, Kevin. Please get off me.' }, { who: 'ounce', mood: 'seven', text: 'The dial reads seven. That is Kevin\\'s business.' }, { who: 'june', text: 'Nobody say anything.' }],\n    6: [{ who: 'ounce', mood: 'wince', text: 'Ahem. \"I have something to tell you all.\" No.' }, { who: 'ounce', mood: 'wince', text: '\"It has come to my attention that I.\" No.' }, { who: 'ounce', mood: 'up', text: 'Oh! Hello. I was not behind the jar. Please carry on.' }],\n    7: [{ who: 'coach', text: 'Today there is one thing to do.' }, { who: 'coach', text: 'Stand.' }, { who: 'ounce', mood: 'wince', text: 'I will be there. On the plaza. We should all be there.' }],\n  },\n  confession: [\n    { who: 'ounce', mood: 'wince', text: 'I have something to tell you. All of you.' },\n    { who: 'ounce', mood: 'wince', text: 'Your numbers. The ones I gave you. In the mornings.' },\n    { who: 'ounce', mood: 'seven', text: 'I have been adding seven. To everyone. For years.' },\n    { who: 'ounce', mood: 'seven', text: 'It felt motivating.' },\n    { who: 'marguerite', text: 'I knew it. I\\'ve been sixty-seven this whole time.' },\n    { who: 'dennis', text: 'So the leg. Is the leg...' },\n    { who: 'ounce', mood: 'flat', text: 'The leg is still the leg, Dennis.' },\n    { who: 'coach', text: 'You may blink.' },\n  ],\n  afterChart: [\n    { who: 'ounce', mood: 'up', text: 'There. That is your real week. I have taken the seven back.' },\n    { who: 'ounce', mood: 'flat', text: 'You wobbled every day. You came back every day. I wrote it all down.' },\n    { who: 'ounce', mood: 'up', text: 'See you tomorrow. Bring your knees.' },\n  ],\n  week2: { who: 'ounce', mood: 'up', text: 'Week two. No sevens. I have only the truth now. I apologise in advance.' },\n};\n\nexport const NAMES = { ounce: 'Ounce', coach: 'Coach Plumb', marguerite: 'Marguerite', dennis: 'Dennis', june: 'June', kevin: 'Kevin', player: 'You' };\n\nexport const QUESTIONS = [\n  { q: 'When you stand up, what sound do you make?', a: ['Oof.', 'Hnng.', 'I have become the sound.'], r: ['Thank you. I have written that down.', 'I know that one. Your knees do the harmony.', 'That is what I thought. I can hear it from here.'] },\n  { q: 'Have you ever apologised to a chair?', a: ['Yes.', 'Not yet.', 'It started it.'], r: ['It was good of you. The chair has moved on.', 'You will. Thank you for your honesty.', 'Dennis said the same. Please see Dennis.'] },\n  { q: 'How many stairs is too many?', a: ['One.', 'All of them.', 'Depends who\\'s watching.'], r: ['One is a good number. I have noted your ambition.', 'A clear position. I respect it from down here.', 'I am always watching. So: fewer.'] },\n  { q: 'How do you feel about your ankles?', a: ['Fine.', 'We don\\'t speak.', 'Which ones?'], r: ['They say the same. They did not sound convinced.', 'Give them time. They have been through a lot, with you.', 'I will put \"several\".'] },\n  { q: 'What is your relationship with the floor?', a: ['Distant.', 'Improving.', 'It\\'s complicated.'], r: ['It speaks well of you. It would, it has to hold you up.', 'Good. Most people only visit when something goes wrong.', 'I will put \"seeing other surfaces\".'] },\n  { q: 'If your knees could talk, what would they say?', a: ['Please.', 'Why.', 'Nothing. They\\'ve given up.'], r: ['They were polite. You raised them well.', 'A fair question. I do not have the answer on file.', 'They haven\\'t. I hear them from here.'] },\n  { q: 'Are you happy?', a: ['Yes.', 'No.', 'Is this graded?'], r: ['It\\'s all graded.', 'It\\'s all graded.', 'It\\'s all graded.'] },\n];\nE\ncat > src/data/poses.js <<'E'\n// Holding Still poses. Plain data: a new pose needs no code.\nexport const POSES = {\n  tree: { clip: 'Tree', ring: 0.40, hold: 25, breath: 0 },\n  heron: { clip: 'Heron', ring: 0.36, hold: 25, breath: 0, wander: 0.12 },\n  warrior: { clip: 'Warrior', ring: 0.32, hold: 30, breath: 8, yNoise: 1.3 },\n  chair: { clip: 'Chair', ring: 0.30, hold: 30, breath: 8, noiseRamp: [1, 1.5] },\n  fold: { clip: 'Fold', ring: 0.28, hold: 30, breath: 6, wander: 0.18 },\n  plank: { clip: 'Plank', ring: 0.24, hold: 35, breath: 6, instScale: 1.2, tremorAfter: 20 },\n};\nexport const LONG_STAND = [\n  { t: 0, say: ['coach', 'Stand.'], ring: 0.40 },\n  { t: 10, say: ['ounce', 'Kevin has landed on you. He is staff.'], kevin: true, bias: 0.10 },\n  { t: 20, say: ['dennis', 'Ah... ah... ACHOO.'], sneeze: true, impulse: [0, -0.6] },\n  { t: 30, ring: 0.34 },\n  { t: 35, say: ['ounce', 'It is raining. This is not part of it. It may be part of it.'], rain: true, noise: 1.2 },\n  { t: 45, say: ['ounce', 'Ignore her.'], clap: true },\n  { t: 50, ring: 0.28 },\n  { t: 55, say: ['june', 'Are you nearly done?'], drift: true },\n  { t: 65, say: ['ounce', 'The volcano. Mostly dormant. Mostly.'], rumble: true, randomImpulse: 0.7 },\n  { t: 75, say: ['ounce', '...'], rain: false, noise: 1, ring: 0.24, swell: true },\n  { t: 85, say: ['ounce', 'Kevin is leaving. Thank you, Kevin.'], kevin: false, bias: 0, randomImpulse: 0.3 },\n  { t: 90, say: ['coach', 'You may blink.'], end: true },\n];\nE\ncat > src/data/reps.js <<'E'\n// The Rep Shed. axis: which way the stick goes; sides: alternating targets.\nexport const REPS = {\n  squats: { clip: 'SquatRep', axis: 'down', reps: 10, tempo: 3.2 },\n  lunges: { clip: 'LungeRepR', clipL: 'LungeRepL', axis: 'side', reps: 10, tempo: 3.2 },\n  press: { clip: 'Press', axis: 'up', reps: 8, tempo: 3.6, lagScale: 1.5 },\n};\nexport const REP_CURVE = { up: 0.4, hold: 0.15, down: 0.35, rest: 0.1 };\nexport const repTarget = (u) => {\n  const { up, hold, down } = REP_CURVE;\n  if (u < up) return u / up;\n  if (u < up + hold) return 1;\n  if (u < up + hold + down) return 1 - (u - up - hold) / down;\n  return 0;\n};\nexport const REP_GRADES = [[0.85, 'Perfect'], [0.65, 'Good'], [-9, 'Wobbly']];\nE\ncat > src/data/charts.js <<'E'\n// Step Class at 104 BPM: 32 bars, one string per bar, 8 slots. L, R or rest.\nconst verseA = 'L...R...', verseB = 'L.R.L.R.', verseC = 'L.R.L...', chorusA = 'L.R.L.R.', chorusB = 'L.RRL.R.', chorusC = 'LL.RL.R.';\nconst brk = ['L.......', '....R...', 'L...R...', 'L.R.L.R.'];\nexport const STEP_BPM = 104;\nexport const CHART_SECTIONS = [\n  { name: 'intro', bars: [verseA, verseA, verseA, verseC] },\n  { name: 'verse', bars: [verseB, verseB, verseC, verseB, verseB, verseC, verseB, chorusA] },\n  { name: 'chorus', bars: [chorusA, chorusB, chorusA, chorusC, chorusA, chorusB, chorusC, chorusA] },\n  { name: 'breakdown', bars: brk },\n  { name: 'final', bars: [chorusB, chorusC, chorusB, chorusC, chorusB, chorusC, chorusA, 'L.R.L.R.'] },\n];\nexport const STEP_HARD_FILL = 'LRLRLRLR';\nexport function chartNotes(sections = CHART_SECTIONS, { maxBars = Infinity, hard = false } = {}) {\n  const bar = (60 / STEP_BPM) * 4, slot = bar / 8; const notes = []; let b = 0;\n  for (const s of sections) for (let chartBar of s.bars) {\n    if (b >= maxBars) return { notes, bars: b, duration: b * bar };\n    if (hard && s.name === 'final' && b % 2 === 0) chartBar = STEP_HARD_FILL;\n    for (let i = 0; i < 8; i++) if (chartBar[i] === 'L' || chartBar[i] === 'R') notes.push({ t: b * bar + i * slot, foot: chartBar[i], bar: b });\n    b++;\n  }\n  return { notes, bars: b, duration: b * bar };\n}\nE\ncat > src/data/boards.js <<'E'\n// Vitamin Tray boards: # wall, . floor, o start, R/B/Y cups, _ a gap in the rail that drops a vitamin.\nexport const BOARDS = [\n  { name: 'Morning Dose', rows: [\n    '#############',\n    '#R....#....B#',\n    '#.....#.....#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#.....#.....#',\n    '#R....#....B#',\n    '#############'] },\n  { name: 'Afternoon Dose', rows: [\n    '#############',\n    '#R....#....Y#',\n    '#..###.###..#',\n    '#...........#',\n    '#..o.o.o.o..#',\n    '#.....#.....#',\n    '#..o.o.o.o..#',\n    '#...........#',\n    '#..###.###..#',\n    '#B....#....R#',\n    '#############'] },\n  { name: 'Evening Dose', rows: [\n    '#####___#####',\n    '#R....#....Y#',\n    '#..##...##..#',\n    '_....o.o...._',\n    '#..o.....o..#',\n    '#.....#.....#',\n    '#..o.....o..#',\n    '_....o.o...._',\n    '#..##...##..#',\n    '#B....#....Y#',\n    '#####___#####'] },\n];\nE\ncat > src/data/classmates.js <<'E'\n// Avatars: looks as palette names. Rival scores live with each activity.\nexport const CAST_LOOKS = {\n  coach: { skin: 'sand', top: 'cyan', bottom: 'cyan', shoe: 'white', hair: 'mist', bun: true, long: true },\n  marguerite: { skin: 'sand', top: 'plum', bottom: 'white', shoe: 'white', hair: 'white', style: 'curl', long: true },\n  dennis: { skin: 'orange', top: 'lime', bottom: 'navy', shoe: 'red', hair: 'slate', style: 'bald' },\n  june: { skin: 'orange', top: 'mist', bottom: 'slate', shoe: 'ink', hair: 'ink', style: 'long', long: true },\n};\nexport const AVATARS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'lime', bottom: 'teal', shoe: 'white', hair: 'plum', style: 'long' },\n  { skin: 'red', top: 'sand', bottom: 'navy', shoe: 'white', hair: 'ink', style: 'bun', bun: true },\n  { skin: 'plum', top: 'cyan', bottom: 'white', shoe: 'sky', hair: 'ink', style: 'spike' },\n  { skin: 'sand', top: 'orange', bottom: 'slate', shoe: 'ink', hair: 'red', style: 'curl' },\n  { skin: 'orange', top: 'sky', bottom: 'white', shoe: 'red', hair: 'sand', style: 'bald', headband: 'lime' },\n];\nexport const LOCKER = {\n  skin: ['sand', 'orange', 'red', 'plum'],\n  style: ['cap', 'long', 'bun', 'spike', 'curl', 'bald'],\n  hair: ['ink', 'plum', 'red', 'sand', 'white', 'mist'],\n  top: ['white', 'lime', 'sand', 'cyan', 'orange', 'sky', 'plum'],\n  bottom: ['sky', 'teal', 'navy', 'white', 'slate', 'ink'],\n  headband: ['none', 'red', 'lime', 'sky'],\n};\nexport const SEAT_COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport const SEAT_PALETTE = ['red', 'blue', 'green', 'sand'];\nexport const SEAT_LOOKS = [\n  { skin: 'sand', top: 'red', bottom: 'white', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'blue', bottom: 'white', shoe: 'white', hair: 'plum', style: 'long' },\n  { skin: 'red', top: 'green', bottom: 'white', shoe: 'white', hair: 'ink', style: 'spike' },\n  { skin: 'plum', top: 'sand', bottom: 'white', shoe: 'white', hair: 'ink', style: 'bun', bun: true },\n];\nexport const BOT_NAMES = ['Marguerite', 'Dennis', 'June', 'Kevin'];\nE\ncat > src/data/unlocks.js <<'E'\n// The Sweat Jar: drips -> Locker Room items and a remark each.\nexport const MILESTONES = [\n  { at: 10, item: 'band2', name: 'A second headband', remark: 'A second headband. In case the first one gives up.' },\n  { at: 25, item: 'cape', name: 'Towel cape', remark: 'A towel cape. It is a towel. You may call it a cape.' },\n  { at: 45, item: 'confidence', name: 'Confidence', remark: 'Confidence: no visible effect. Please wear it anyway.' },\n  { at: 70, item: 'whistle', name: 'Tiny whistle', remark: 'A tiny whistle. Coach would like it back. She will not ask.' },\n  { at: 100, item: 'visor', name: 'Sun visor', remark: 'A sun visor. It says you have given this some thought.' },\n  { at: 135, item: 'wristbands', name: 'Serious wristbands', remark: 'Serious wristbands. They take you seriously. They are alone.' },\n  { at: 175, item: 'plumbbob', name: 'Your own plumb bob', remark: 'Your own plumb bob. You may now tell people they are leaning.' },\n];\nexport const ITEM_SLOTS = { band2: 'Spare band', cape: 'Towel cape', confidence: 'Confidence', whistle: 'Whistle', visor: 'Visor', wristbands: 'Wristbands', plumbbob: 'Plumb bob' };\nE\ncat > src/data/stations.js <<'E'\nexport const STATIONS = {\n  terrace: { name: 'Weigh-In Terrace', at: [0, 3], kind: 'talk' },\n  pavilion: { name: 'Pavilion of Holding Still', at: [-11, 3], kind: 'menu', remark: 'Holding still. The hardest thing. Coach makes it look easy. It is rude.' },\n  shed: { name: 'The Rep Shed', at: [11, 3], kind: 'menu', remark: 'The Rep Shed. Every exercise here is two longer than it says.' },\n  beach: { name: 'Beat Beach', at: [12, -10], kind: 'menu', remark: 'Beat Beach. Bring your hips. Leave your dignity with the towels.' },\n  lagoon: { name: 'Lagoon Games', at: [-12, -10], kind: 'menu', remark: 'Lagoon Games. The water is warm. You will find that out.' },\n  gate: { name: 'Jogging Path', at: [0, 11], kind: 'menu', remark: 'One lap of the island. Coach has charged her scooter.' },\n  jar: { name: 'Sweat Jar', at: [4, -4], kind: 'scene', scene: 'jar' },\n  locker: { name: 'Locker Room', at: [-4, -4], kind: 'scene', scene: 'locker', unlockDay: 2 },\n  hall: { name: 'Hall of Numbers', at: [0, -8], kind: 'scene', scene: 'records' },\n  hammock: { name: 'Hammock', at: [14, 10], kind: 'hammock' },\n  stand: { name: 'The Long Stand', at: [0, 7], kind: 'menu', remark: 'Today there is one thing to do.', unlockDay: 7 },\n};\nE\ncat > src/data/medley.js <<'E'\n// The Medley: three events in fixed windows. Picks come from a seeded stream.\nexport const MEDLEY = {\n  eventSeconds: 55, gapSeconds: 10,\n  events: [\n    { name: 'Stillness', award: 'Stillest', picks: ['tree', 'heron', 'warrior', 'chair', 'fold'], norm: 100 },\n    { name: 'Beat', award: 'Most Apologetic', picks: ['squats', 'lunges', 'hoop', 'step'], norm: { squats: 100, lunges: 100, press: 100, hoop: 130, step: 100 } },\n    { name: 'Lean', award: 'Hardest Head', picks: ['header'], norm: 900 },\n  ],\n};\nexport const medleyWindow = (i) => { const s = i * (MEDLEY.eventSeconds + MEDLEY.gapSeconds); return { start: s, end: s + MEDLEY.eventSeconds }; };\nexport const MEDLEY_TOTAL = MEDLEY.events.length * MEDLEY.eventSeconds + (MEDLEY.events.length - 1) * MEDLEY.gapSeconds;\nE\ncat > src/data/week.js <<'E'\n// The week as data. A new day needs no code.\nexport const WEEK = [\n  { day: 1, test: 'stillness', goal: { kind: 'poseAndOther' }, goalText: 'Holding Still and one other', opens: ['tree', 'heron', 'squats', 'hoop'] },\n  { day: 2, test: 'lean', goal: { kind: 'stars', n: 2 }, goalText: '2 stars in anything', opens: ['header', 'lunges', 'warrior', 'locker'] },\n  { day: 3, test: 'chase', goal: { kind: 'first' }, goalText: 'Something you haven\\'t done', opens: ['step', 'slackline', 'chair'] },\n  { day: 4, test: 'stillness', goal: { kind: 'count', n: 3 }, goalText: '3 activities', opens: ['tray', 'press', 'fold'] },\n  { day: 5, test: 'lean', goal: { kind: 'beat', who: 'dennis' }, goalText: 'Beat Dennis at anything', opens: ['jog', 'pier', 'plank'] },\n  { day: 6, test: 'chase', goal: { kind: 'stars', n: 3 }, goalText: '3 stars anywhere', opens: [], hard: true },\n  { day: 7, test: 'stillness', goal: { kind: 'did', id: 'longstand' }, goalText: 'Stand.', opens: ['longstand'] },\n];\nexport const weekDay = (d) => WEEK[Math.min(WEEK.length, Math.max(1, d)) - 1];\nE\ncat > src/data/activities.js <<'E'\n// One entry per activity: everything a designer changes. Scene code reads it.\nconst rivals = ([a, b, c]) => ({ dennis: Math.round(a * 1.05), june: Math.round((b + c) / 2), marguerite: Math.round(c * 1.04) });\nconst POSE_STARS = [45, 70, 90], REP_STARS = [55, 75, 90];\nconst act = (id, name, station, scene, song, day, stars, extra = {}) => ({ id, name, station, scene, song, day, stars, rivals: extra.rivalScores ?? rivals(stars), lane: false, hard: {}, ...extra });\nexport const ACTIVITIES = [\n  act('tree', 'Apologetic Tree', 'pavilion', 'poses', 'still', 1, POSE_STARS, { lane: true, hard: { ring: 0.3 } }),\n  act('heron', 'Startled Heron', 'pavilion', 'poses', 'still', 1, POSE_STARS, { lane: true, hard: { ring: 0.27 } }),\n  act('warrior', 'Reluctant Warrior', 'pavilion', 'poses', 'still', 2, POSE_STARS, { lane: true, hard: { ring: 0.24 } }),\n  act('chair', 'The Chair Nobody Asked For', 'pavilion', 'poses', 'still', 3, POSE_STARS, { lane: true, hard: { ring: 0.23 } }),\n  act('fold', 'Tax Season', 'pavilion', 'poses', 'still', 4, POSE_STARS, { lane: true, hard: { ring: 0.22 } }),\n  act('plank', 'Plank Negotiation', 'pavilion', 'poses', 'still', 5, POSE_STARS, { lane: true, hard: { ring: 0.2 } }),\n  act('squats', 'Squats of Regret', 'shed', 'reps', 'shed', 1, REP_STARS, { lane: true, hard: { tempo: 2.6 } }),\n  act('lunges', 'Apology Lunges', 'shed', 'reps', 'shed', 2, REP_STARS, { lane: true, hard: { tempo: 2.6 } }),\n  act('press', 'Overhead Mortgage', 'shed', 'reps', 'shed', 4, REP_STARS, { lane: true, hard: { tempo: 3 } }),\n  act('hoop', 'Hoop Economics', 'beach', 'hoop', 'hoop', 1, [35, 70, 110], { lane: true, hard: { low: 1.3, high: 2.2 } }),\n  act('step', 'Step Class', 'beach', 'step', 'step', 3, [55, 75, 90], { lane: true, hard: { fill: true, window: 0.8 } }),\n  act('header', 'Coconut Header', 'lagoon', 'header', 'lagoon', 2, [150, 400, 800], { lane: true, hard: { interval: 0.75 } }),\n  act('slackline', 'Slackline', 'lagoon', 'slackline', 'lagoon', 3, [1, 2, 3], { starsFromSim: true, rivalScores: { dennis: 620, june: 830, marguerite: 930 }, hard: { walkInst: 1.2 } }),\n  act('tray', 'Vitamin Tray', 'lagoon', 'tray', 'lagoon', 4, [40, 60, 80], { percentStars: true, hard: { seconds: 45 } }),\n  act('jog', 'Island Jog', 'gate', 'jog', 'jog', 5, [55, 75, 90], { hard: { speed: 1.2 } }),\n  act('pier', 'Pier Jump', 'lagoon', 'pier', 'lagoon', 5, [18, 28, 38], { hard: { window: 0.7 } }),\n  act('longstand', 'The Long Stand', 'stand', 'longstand', 'stand', 7, POSE_STARS, { rivalScores: { dennis: 41, june: 80, marguerite: 96 } }),\n];\nexport const ACT = Object.fromEntries(ACTIVITIES.map((a) => [a.id, a]));\nexport const STATION_ACTS = (s) => ACTIVITIES.filter((a) => a.station === s);\nexport const COACH_LINES = {\n  poses: ['You are a tree. A tree does not check its phone.', 'Stillness is a muscle. So is regret. We train both here.', 'Hold. You may blink on Thursday.'],\n  reps: ['Good. Again. That was also good. Again.', 'I am eighty-one. I say this so that you feel something.'],\n  hoop: ['Your hips know what to do. Tell them I said so.'],\n  step: ['Left. Right. They are both yours. I checked.'],\n  header: ['Dennis has a catapult. I have stopped asking.'],\n  slackline: ['The line is not your enemy. The wind is. And you.'],\n  tray: ['Slowly. They are small, and they can sense fear.'],\n  jog: ['I shall be on the scooter. Try to keep up.'],\n  pier: ['Jump in the water. Do it correctly.'],\n  longstand: ['Stand.'],\n};\nE\necho \"- [x] core (dot,tunables,actions,device,clock,save) + data (lines,poses,reps,charts,boards,week,activities...)\" >> PROGRESS.md","description":"Write all game data files"}}}
