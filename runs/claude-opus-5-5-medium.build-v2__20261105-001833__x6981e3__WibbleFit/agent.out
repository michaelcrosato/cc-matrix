{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjQ6Ka2RtV5PW3bmoiim","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12987,"cache_read_input_tokens":260375,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12987},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"b304a4fe-82c4-4f55-a0c6-5ff9d69bb316","timestamp":"2026-11-05T07:37:41.558Z","request_id":"req_011CgjQ6Jwq2xqgseWvnivz1","thinking_duration_ms":1308,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjQ6Ka2RtV5PW3bmoiim","type":"message","role":"assistant","content":[{"type":"text","text":"I'm now writing the activities, starting with the five lane games: Holding Still, Reps, Hoop, Step and Header."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12987,"cache_read_input_tokens":260375,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12987},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"6459b537-a6fd-4217-bf29-76b2738d8b9d","timestamp":"2026-11-05T07:37:41.559Z","request_id":"req_011CgjQ6Jwq2xqgseWvnivz1"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjQ6Ka2RtV5PW3bmoiim","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019ywYWq2LEuE5E4HZB2zTSr","name":"Bash","input":{"command":"cat > src/scenes/activity/poses.js <<'E'\n// 5.1 Holding Still. Hold the pose by keeping the Dot in the ring.\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { BARKS } from '../../data/lines.js';\nimport { POSES } from '../../data/poses.js';\nimport { T } from '../../core/tunables.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\n\nexport class PoseSim {\n  t = 0; settle = 4; release = 2; inT = 0; holdT = 0; breathOk = 0; breathT = 0; s = 0.5; done = false; inside = false; wasInside = true; score = 0; events = []; wobbles = 0; bias = 0;\n  constructor(pose, env, rng, over = {}) {\n    this.pose = { ...pose, ...over }; this.env = env; this.rng = rng; this.hold = this.pose.hold;\n    this.dot = new Dot(() => rng.next()); this.ph = rng.next() * 6.28; this.ring = this.pose.ring;\n  }\n  get ringR() { return this.ring * this.env.ringMul; }\n  get phaseName() { return this.t < this.settle ? 'settle' : this.t < this.settle + this.hold ? 'hold' : 'release'; }\n  breathIn() { const p = this.pose.breath; return p ? (((this.t - this.settle) % p) + p) % p < p / 2 : false; }\n  mods() {\n    const p = this.pose, m = { noise: this.env.noiseMul };\n    const u = Math.max(0, Math.min(1, (this.t - this.settle) / this.hold));\n    if (p.wander) m.bx = p.wander * T.dotAuthority * Math.sin(0.37 * this.t + this.ph);\n    if (p.yNoise) m.by = (p.yNoise - 1) * T.dotNoise * Math.sin(2.9 * this.t + this.ph);\n    if (p.noiseRamp) m.noise *= p.noiseRamp[0] + (p.noiseRamp[1] - p.noiseRamp[0]) * u;\n    if (p.instScale) m.inst = p.instScale;\n    if (p.tremorAfter && this.t - this.settle > p.tremorAfter) m.bx = (m.bx ?? 0) + 0.9 * Math.sin(23 * this.t);\n    return m;\n  }\n  step(dt, u) {\n    this.t += dt;\n    const phase = this.phaseName, m = this.mods(), p = this.pose;\n    if (p.breath && phase === 'hold') {\n      const ok = !!u.breath === this.breathIn();\n      this.s += ((ok ? 1 : 0) - this.s) * Math.min(1, dt / 0.5);\n      m.noise *= 1.25 - T.breathBonus * this.s;\n      this.breathT += dt; if (ok) this.breathOk += dt;\n    }\n    this.dot.step(dt, u.x, u.y, T, m);\n    if (this.env.god) this.clampIn();\n    this.inside = this.dot.dist() <= this.ringR;\n    if (phase !== 'settle' && this.inside !== this.wasInside) {\n      this.events.push(this.inside ? 'in' : 'out');\n      if (!this.inside) this.wobbles++;\n    }\n    this.wasInside = this.inside;\n    if (phase === 'hold') { this.holdT += dt; if (this.inside) this.inT += dt; }\n    this.score = this.compute();\n    if (this.t >= this.settle + this.hold + this.release) this.done = true;\n  }\n  clampIn() { const d = this.dot.dist(), r = this.ringR * 0.9; if (d > r && d > 0) { const k = r / d; this.dot.x *= k; this.dot.y *= k; this.dot.vx *= 0.5; this.dot.vy *= 0.5; } }\n  compute() {\n    if (this.holdT <= 0) return 0;\n    const ring = this.inT / this.hold;\n    return this.pose.breath ? 100 * (0.8 * ring + 0.2 * (this.breathT > 0 ? this.breathOk / this.hold : 0)) : 100 * ring;\n  }\n  result() { return { score: Math.round(this.compute()), stats: { wobbles: this.wobbles } }; }\n  bot(driver, out, dt) {\n    driver.brain.lean(this.dot, 0, 0, dt, out);\n    const sk = driver.skill; let want = this.breathIn();\n    if (driver.rng.next() < sk.mistake * dt * 4) driver.breathFlip = (driver.breathFlip ?? 0) + 0.5;\n    if (driver.breathFlip > 0) { want = !want; driver.breathFlip -= dt; }\n    out.breath = want;\n  }\n}\nexport const poseView = {\n  kind: 'poses',\n  enter(scene, lane, data) { const clip = data.clip; lane.clipName = clip; lane.avatar.play(clip); },\n  update(scene, lane, dt) {\n    const s = lane.sim, a = lane.avatar; if (!s) return;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y;\n    const d = s.dot.dist(), over = d - s.ringR;\n    a.trem = over > 0 ? Math.min(1, over * 4) : 0;\n    if (over > 0.55 && a.current !== 'Teeter') a.play('Teeter');\n    else if (over <= 0.45 && a.current === 'Teeter') a.play(lane.clipName);\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    dial(hud, box.x, box.y, box.r, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.inside, glow: s.inT / Math.max(1, s.holdT + 1), seat: box.seat });\n    if (s.pose.breath && s.phaseName === 'hold') {\n      const p = s.pose.breath, ph = (((s.t - s.settle) % p) + p) % p / p, f = ph < 0.5 ? ph * 2 : 2 - ph * 2;\n      if (big) {\n        bar(hud, box.x + box.r + 10, box.y - 30, 12, 60, 0, 'cyan');\n        const fh = Math.round(58 * f); hud.rect(box.x + box.r + 11, box.y + 29 - fh, 10, fh, s.breathIn() ? 'cyan' : 'sky');\n        say(hud, box.x + box.r + 26, box.y - 3, s.breathIn() ? 'In...' : 'Out...', { color: 'white' });\n      } else bar(hud, box.x - box.r, box.y + box.r + 4, box.r * 2, 4, f, 'cyan');\n    }\n  },\n  score: (s) => s.compute(),\n};\nexport class PosesScene extends ActivityScene {\n  poseData() { const p = POSES[this.def.id]; return this.hard ? { ...p, ...this.def.hard } : p; }\n  makeSim(ctx, lane) { return new PoseSim(this.poseData(), App.simEnv(ctx, this.def), ctx.random.fork(`pose-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'pavilion');\n    const d = this.poseData();\n    for (const l of this.lanes) poseView.enter(this, l, d);\n    this.coach.play(d.clip);\n    this.kevinT = 0; this.cam = ctx.camera.camera; this.push = 0;\n    ctx.particles.register('zen', { count: [1, 1], life: [2, 4], speed: [0.05, 0.2], gravity: -0.04, size: [1, 1], colors: ['white', 'sand', 'white'], radius: 4 });\n    this.moteT = 0;\n  }\n  cardInfo() { const b = this.poseData().breath; return { goal: b ? 'Keep the dot in the circle. Breathe when told.' : 'Keep the dot in the circle.', prompts: b ? [['lean', 'Lean'], ['breath', 'Hold: breathe in']] : [['lean', 'Lean']] }; }\n  view(ctx, dt, rdt) {\n    for (const l of this.lanes) poseView.update(this, l, dt);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e === 'in') { App.sfx('chimeIn'); if (this.cosmetic.chance(0.25) && !App.bark) App.barkLine(this.cosmetic.pick(BARKS.ringIn), 'ounce', 1.8); }\n      else { App.sfx('chimeOut'); if (this.cosmetic.chance(0.35) && !App.bark) App.barkLine(this.cosmetic.pick(BARKS.ringOut), 'ounce', 2); }\n    }\n    this.moteT -= dt; if (this.moteT <= 0) { this.moteT = 0.25; ctx.particles.burst('zen', [this.cosmetic.range(-5, 5), this.cosmetic.range(0.4, 3), this.cosmetic.range(-2, 2)]); }\n    // A slow push-in while steady.\n    const steady = this.phase === 'play' && s.inside;\n    this.push += ((steady ? 1 : 0) - this.push) * Math.min(1, dt * 0.5);\n    const c = ctx.camera.camera;\n    if (c.isPerspectiveCamera) { c.fov = 30 - this.push * 3; c.updateProjectionMatrix(); }\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    poseView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 56, r: 44 }, true);\n    this.drawTopBar(hud, Math.round(s.score), s.phaseName === 'settle' ? 'Settle...' : s.phaseName === 'release' ? 'Release.' : `${Math.max(0, Math.ceil(s.settle + s.hold - s.t))} s`);\n    if (this.phase === 'play' && !App.attract) promptBar(hud, s.pose.breath ? [['lean', 'Lean'], ['breath', s.breathIn() ? 'Breathe in' : 'Let go'], ['pause', 'Pause']] : [['lean', 'Lean'], ['half', 'Half lean'], ['pause', 'Pause']]);\n    if (App.device.last === 'mouse' && App.top() == null && this.phase !== 'intro') {\n      const p = ctx.input.pointer, ax = ((p.x + 1) / 2) * hud.width, ay = ((1 - p.y) / 2) * hud.height;\n      hud.rect(ax - 3, ay, 7, 1, 'red'); hud.rect(ax, ay - 3, 1, 7, 'red');\n    }\n    void center;\n  }\n}\nE\ncat > src/scenes/activity/reps.js <<'E'\n// 5.2 The Rep Shed. You scrub the animation with the stick.\nimport { Mirror, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { REP_GRADES, REPS, repTarget } from '../../data/reps.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { panel } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\n\nexport class RepSim {\n  t = 0; r = 0; rep = 0; errSum = 0; errN = 0; repErr = 0; repN = 0; quals = []; done = false; score = 0; events = []; side = 1; target = 0; announced = 0; trem = 0;\n  constructor(ex, env, rng, over = {}) {\n    this.ex = { ...ex, ...over }; this.env = env; this.rng = rng; this.total = this.ex.reps + 2; this.announced = this.ex.reps; this.ph = rng.next() * 6.28;\n  }\n  get tempo() { return this.ex.tempo * T.repTempoScale; }\n  step(dt, u) {\n    this.t += dt;\n    const tempo = this.tempo; const rep = Math.floor(this.t / tempo);\n    if (rep !== this.rep) { this.finishRep(); this.rep = rep; if (rep >= this.total) { this.done = true; return; } this.side = this.ex.axis === 'side' ? (rep % 2 ? -1 : 1) : 1; this.events.push({ kind: 'rep', rep }); }\n    const uu = (this.t % tempo) / tempo; this.target = repTarget(uu);\n    const axis = this.ex.axis;\n    const raw = axis === 'down' ? -u.y : axis === 'up' ? u.y : u.x * this.side;\n    const lag = T.repLag * (this.ex.lagScale ?? 1);\n    if (u.digital) {\n      // Keys use rate control: S/W move r at the target speed, no key holds it.\n      const key = axis === 'down' ? -(u.keyY ?? 0) : axis === 'up' ? (u.keyY ?? 0) : (u.keyX ?? 0) * this.side;\n      this.r += key * (1 / (0.4 * tempo)) * dt;\n    } else this.r += (Math.max(0, raw) - this.r) * Math.min(1, dt / lag);\n    this.r = Math.max(0, Math.min(1, this.r));\n    const f = T.repFatigue * (this.rep / this.total) ** 2;\n    this.trem = f * Math.sin(this.t * 19 + this.ph);\n    const shown = Math.max(0, Math.min(1, this.r + this.trem));\n    this.shown = shown;\n    const err = Math.abs(shown - this.target);\n    if (this.env.god) this.r = this.target;\n    const e = this.env.god ? 0 : err;\n    this.repErr += e; this.repN++; this.errSum += e; this.errN++;\n    this.score = this.quals.length ? (100 * this.quals.reduce((a, b) => a + b, 0)) / Math.max(1, this.quals.length) : 0;\n  }\n  finishRep() {\n    if (!this.repN) return;\n    const q = Math.max(0, 1 - 1.6 * (this.repErr / this.repN));\n    this.quals.push(q); this.repErr = 0; this.repN = 0;\n    const grade = REP_GRADES.find(([min]) => q >= min)[1];\n    this.events.push({ kind: 'grade', grade, q });\n  }\n  final() { const all = this.quals.length ? this.quals : [0]; return 100 * all.reduce((a, b) => a + b, 0) / Math.max(this.total, all.length); }\n  result() { return { score: Math.round(this.done ? this.final() : this.score), stats: { reps: this.quals.length } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill, tempo = this.tempo;\n    const ahead = repTarget(((this.t + sk.repLead) % tempo) / tempo);\n    driver.wob = (driver.wob ?? 0) + (driver.rng.next() - 0.5) * sk.repErr * dt * 18; driver.wob *= 0.97;\n    const v = Math.max(0, Math.min(1, ahead + driver.wob));\n    const axis = this.ex.axis;\n    if (axis === 'down') out.y = -v; else if (axis === 'up') out.y = v; else out.x = v * this.side;\n  }\n}\nexport const repView = {\n  kind: 'reps',\n  enter(scene, lane) { lane.avatar.scrub(lane.sim.ex.clip, 0); },\n  update(scene, lane) {\n    const s = lane.sim; if (!s) return;\n    const clip = s.ex.axis === 'side' && s.side < 0 ? s.ex.clipL : s.ex.clip;\n    lane.avatar.scrub(clip, s.shown ?? s.r);\n    lane.avatar.lean.x = s.trem * 2; lane.avatar.trem = s.rep / s.total > 0.6 ? 0.5 : 0;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const h = big ? 110 : 44, w = big ? 22 : 10, x = Math.round(box.x - w / 2), y = Math.round(box.y - h / 2);\n    hud.rect(x - 2, y - 2, w + 4, h + 4, 'ink'); hud.rect(x, y, w, h, 'night');\n    const my = (v) => (s.ex.axis === 'up' ? y + h - 2 - (h - 4) * v : y + (h - 4) * v);\n    hud.rect(x, Math.round(my(s.target)), w, 4, 'lime');\n    hud.rect(x - (big ? 4 : 2), Math.round(my(s.shown ?? s.r)), w + (big ? 8 : 4), 3, Math.abs((s.shown ?? 0) - s.target) < 0.12 ? 'cyan' : 'red');\n  },\n  score: (s) => s.final(),\n};\nexport class RepsScene extends ActivityScene {\n  ex() { const e = REPS[this.def.id]; return this.hard ? { ...e, ...this.def.hard } : e; }\n  makeSim(ctx, lane) { return new RepSim(this.ex(), App.simEnv(ctx, this.def), ctx.random.fork(`rep-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'shed');\n    for (const l of this.lanes) repView.enter(this, l);\n    this.coach.setAt(-1.1, 0, -1.5); this.coach.play('Idle');\n    // A wall mirror showing your reps. Stopped in dispose.\n    if (ctx.engine.gpu) {\n      this.mirror = new Mirror({ size: [8.6, 3.2] }); this.mirror.mesh.position.set(0, 2.2, -4.05);\n      ctx.scene.add(this.mirror.mesh);\n      this.stopMirror = this.mirror.attach(ctx.engine.renderer, ctx.scene);\n    }\n    this.lastGrade = ''; this.gradeT = 0;\n  }\n  dispose() { this.stopMirror?.(); this.mirror?.dispose(); }\n  cardInfo() {\n    const e = this.ex(), verb = e.axis === 'down' ? 'Push down: go deeper' : e.axis === 'up' ? 'Push up: press' : 'Push left, right: lunge';\n    return { goal: `Match the green marker. ${e.reps} reps. It says ${e.reps}.`, prompts: [['lean', verb]] };\n  }\n  onPlayStart() { this.repSaid = -1; }\n  view(ctx, dt) {\n    for (const l of this.lanes) repView.update(this, l);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'grade') { this.lastGrade = e.grade; this.gradeT = 1.1; App.sfx(e.grade === 'Perfect' ? 'repPerfect' : 'repTick'); }\n      if (e.kind === 'rep' && this.phase === 'play') {\n        const over = e.rep - (s.announced - 1);\n        if (over >= 0 && over < BARKS.repCount.length) { App.barkLine(BARKS.repCount[over], 'coach', 2); this.coach.play('CoachPoint', { once: true }); }\n      }\n    }\n    this.gradeT -= dt;\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim, cx = Math.round(W / 2) + 90;\n    repView.draw(this, hud, this.lanes[1], { x: cx, y: 90, r: 40 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), `Rep ${Math.min(s.rep + 1, s.total)} / ${s.announced}`);\n    if (this.gradeT > 0) center(hud, 44, this.lastGrade, { scale: 2, color: this.lastGrade === 'Perfect' ? 'lime' : this.lastGrade === 'Good' ? 'cyan' : 'orange' });\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', s.ex.axis === 'down' ? 'Deeper' : s.ex.axis === 'up' ? 'Press' : (s.side > 0 ? 'Right' : 'Left')], ['pause', 'Pause']]);\n    void panel; void say;\n  }\n}\nE\ncat > src/scenes/activity/hoop.js <<'E'\n// 5.3 Hoop Economics. Circle the stick to keep hoops up.\nimport { App } from '../../app.js';\nimport { makeHoopMesh } from '../../art/avatar.js';\nimport { T } from '../../core/tunables.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, disc, line, ring } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst TAU = Math.PI * 2;\nexport class HoopSim {\n  t = 0; L = 0.5; speed = 0; last = null; rot = 0; score = 0; hoops = 1; mult = 1; dropped = 0; done = false; events = []; ang = 0; inBand = false; wrong = false; next = 9; throwAt = null; side = 0; caught = 0; flick = false;\n  constructor(cfg, env, rng, { seconds = 60 } = {}) { this.cfg = cfg; this.env = env; this.rng = rng; this.seconds = seconds; this.dirA = seconds * (25 / 60); this.dirB = seconds * (50 / 60); this.throwRng = rng.fork ? rng.fork('throw') : rng; }\n  dir() { return this.t < this.dirA ? 1 : this.t < this.dirB ? -1 : 0; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds) { this.done = true; return; }\n    const low = this.cfg.low ?? T.hoopLow, high = this.cfg.high ?? T.hoopHigh;\n    const mag = Math.hypot(u.x, u.y);\n    if (mag > 0.5) {\n      const a = Math.atan2(u.y, u.x);\n      if (this.last !== null) { let d = a - this.last; if (d > Math.PI) d -= TAU; if (d < -Math.PI) d += TAU; const inst = d / TAU / dt; this.speed += (inst - this.speed) * Math.min(1, dt / 0.25); }\n      this.last = a;\n    } else { this.speed += (0 - this.speed) * Math.min(1, dt / 0.25); this.last = null; }\n    const dir = this.dir(), s = dir === 0 ? Math.abs(this.speed) : this.speed * dir;\n    this.inBand = s >= low && s <= high; this.wrong = s < -0.2;\n    if (this.env.god) { this.inBand = true; this.wrong = false; this.speed = 1.6 * (dir || 1); }\n    if (this.dropped > 0) {\n      this.dropped -= dt;\n      if (this.dropped <= 0) { this.L = 0.35; this.events.push('pickup'); }\n    } else {\n      this.L += (this.inBand ? T.hoopLiftRate : this.wrong ? -0.5 : -0.25) * dt;\n      this.L = Math.min(1, this.L);\n      if (this.L <= 0) { this.L = 0; this.dropped = 1.5; this.hoops = Math.max(1, this.hoops - 1); this.mult = 1 + 0.5 * (this.hoops - 1); this.events.push('drop'); }\n      if (this.inBand) { const rev = Math.abs(this.speed) * dt; this.rot += rev; this.score += rev * this.mult; }\n    }\n    this.ang += this.speed * TAU * dt;\n    // June throws a hoop every ~9 s; flick toward it in the last .4 s to catch it.\n    if (this.throwAt === null && this.t >= this.next && this.hoops < 4 && this.t < this.seconds - 3) {\n      this.side = this.throwRng.next() < 0.5 ? -1 : 1; this.throwAt = this.t + 1.5; this.events.push('throw');\n    }\n    if (this.throwAt !== null) {\n      const left = this.throwAt - this.t;\n      if (left <= 0.4 && left > -0.05 && Math.abs(u.x) > 0.7 && Math.sign(u.x) === this.side) { this.hoops++; this.mult = 1 + 0.5 * (this.hoops - 1); this.caught++; this.throwAt = null; this.next = this.t + 7.5 + this.throwRng.next() * 3; this.events.push('catch'); }\n      else if (left <= -0.05) { this.throwAt = null; this.next = this.t + 7.5 + this.throwRng.next() * 3; this.events.push('miss'); }\n    }\n  }\n  final() { return this.score; }\n  result() { return { score: Math.round(this.score), stats: { rotations: Math.round(this.rot), caught: this.caught } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    driver.a = (driver.a ?? 0) + TAU * sk.circle * (this.dir() || 1) * dt * (1 + (driver.rng.next() - 0.5) * 0.3);\n    out.x = Math.cos(driver.a) * 0.95; out.y = Math.sin(driver.a) * 0.95;\n    if (this.throwAt !== null) {\n      const left = this.throwAt - this.t;\n      if (left <= 0.35 && left > 0) {\n        if (driver.decided !== this.throwAt) { driver.decided = this.throwAt; driver.willCatch = driver.rng.next() < sk.catch; }\n        if (driver.willCatch) { out.x = this.side; out.y = 0; }\n      }\n    }\n  }\n}\nexport const hoopView = {\n  kind: 'hoop',\n  enter(scene, lane) {\n    lane.avatar.play('HoopStance');\n    const ctx = scene.ctx; lane.hoops = [];\n    for (let i = 0; i < 4; i++) { const h = makeHoopMesh(0.5 + i * 0.03, ['orange', 'cyan', 'lime', 'red'][i]); h.visible = false; ctx.scene.add(h); lane.hoops.push(h); }\n    lane.thrown = makeHoopMesh(0.5, 'sand'); lane.thrown.visible = false; ctx.scene.add(lane.thrown);\n    (scene.viewObjects ??= []).push(...lane.hoops, lane.thrown);\n  },\n  update(scene, lane, dt) {\n    const s = lane.sim; if (!s) return;\n    const a = lane.avatar, base = a.root.position, wob = s.dropped > 0 ? 0 : 1;\n    const ang = s.ang;\n    if (a.pelvis) { a.pelvis.position.x += Math.cos(ang) * 0.05 * wob; a.pelvis.position.z += Math.sin(ang) * 0.04 * wob; }\n    lane.hoops.forEach((h, i) => {\n      h.visible = i < s.hoops && s.dropped <= 0;\n      const y = 0.72 + i * 0.06 + (s.L - 0.5) * 0.3, off = 0.14 + i * 0.03;\n      h.position.set(base.x + Math.cos(ang + i) * off, y, base.z + Math.sin(ang + i) * off);\n      h.rotation.x = Math.sin(ang) * (0.22 - s.L * 0.16); h.rotation.z = Math.cos(ang) * (0.22 - s.L * 0.16);\n    });\n    if (s.dropped > 0) { const h = lane.hoops[0]; h.visible = true; h.position.set(base.x, 0.06, base.z); h.rotation.set(0, 0, 0); }\n    if (s.throwAt !== null) {\n      const left = s.throwAt - s.t, f = 1 - left / 1.5;\n      lane.thrown.visible = true; lane.thrown.position.set(base.x + s.side * (2.6 - 2.6 * f), 0.8 + Math.sin(f * Math.PI) * 1.6, base.z); lane.thrown.rotation.z += dt * 4;\n    } else lane.thrown.visible = false;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const r = box.r;\n    disc(hud, box.x, box.y, r + 2, 'ink'); disc(hud, box.x, box.y, r, 'white');\n    ring(hud, box.x, box.y, r, s.inBand ? 'lime' : s.wrong ? 'red' : 'slate', 3);\n    const a = s.ang; line(hud, box.x, box.y, box.x + Math.cos(a) * (r - 4), box.y - Math.sin(a) * (r - 4), s.inBand ? 'green' : 'orange', 2);\n    disc(hud, box.x, box.y, Math.max(2, r / 10), 'ink');\n    bar(hud, box.x - r, box.y + r + 5, r * 2, big ? 7 : 4, s.L, s.L < 0.25 ? 'red' : 'cyan');\n    if (big) {\n      const d = s.dir(); const txt = d > 0 ? 'Anticlockwise' : d < 0 ? 'The other way' : 'Either way';\n      say(hud, box.x - txt.length * 3, box.y + r + 15, txt, { color: 'sand' });\n    }\n  },\n  score: (s) => s.final(),\n};\nexport class HoopScene extends ActivityScene {\n  makeSim(ctx, lane) { return new HoopSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`hoop-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'beach', { coach: false });\n    for (const l of this.lanes) hoopView.enter(this, l);\n    const { makeAvatar } = await import('../../art/avatar.js');\n    const { CAST_LOOKS } = await import('../../data/classmates.js');\n    this.june = await makeAvatar(ctx, CAST_LOOKS.june); this.june.setAt(-5.2, 0, -0.6, 0.9);\n    this.whirr = ctx.audio.loop('hoopWhirr', { volume: 0 });\n    ctx.particles.register('hoopspark', { count: [2, 3], life: [0.3, 0.6], speed: [1, 2], gravity: 2, size: [1, 1], colors: ['white', 'cyan', 'sand'] });\n    this.sparkT = 0;\n  }\n  cardInfo() { return { goal: 'Circle to spin. Flick toward a thrown hoop to catch it.', prompts: [['lean', 'Circle, then flick']] }; }\n  onPlayStart() { App.barkLine('Anticlockwise.', 'coach', 1.5); this.saidOther = false; }\n  view(ctx, dt) {\n    for (const l of this.lanes) hoopView.update(this, l, dt);\n    const s = this.lanes[1].sim;\n    this.june.update(dt);\n    for (const e of s.events.splice(0)) {\n      if (e === 'drop') { App.sfx('hoopDrop'); App.barkLine('You have dropped your hoop. I will not tell it.', 'ounce', 2); }\n      if (e === 'catch') { App.sfx('hoopCatch'); App.barkLine('Another hoop. The market is responding.', 'ounce', 1.6); }\n      if (e === 'throw') { this.june.play('Punch', { once: true }); App.barkLine('June: \"Catch.\"', 'june', 1.2); }\n    }\n    if (!this.saidOther && s.dir() < 0 && this.phase === 'play') { this.saidOther = true; App.barkLine('Now the other way.', 'coach', 1.5); }\n    if (this.whirr) this.whirr.set({ volume: this.phase === 'play' && s.inBand ? 0.5 : 0 });\n    this.sparkT -= dt;\n    if (s.inBand && this.sparkT <= 0 && this.phase === 'play') { this.sparkT = 0.2; ctx.particles.burst('hoopspark', [this.lanes[1].x, 1, 0.8]); }\n  }\n  updateAvatars(ctx, dt) { for (const l of this.lanes) { l.avatar.update(dt); hoopView.update(this, l, 0); } }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    hoopView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 52, r: 30 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = 52;\n    this.drawTopBar(hud, Math.round(s.score), `x${s.mult.toFixed(1)}  ${s.hoops} hoop${s.hoops > 1 ? 's' : ''}`);\n    if (s.throwAt !== null) { const p = s.side < 0 ? '< Flick' : 'Flick >'; center(hud, 100, p, { scale: 2, color: s.throwAt - s.t <= 0.4 ? 'lime' : 'orange' }); }\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', 'Circle'], ['pause', 'Pause']]);\n  }\n}\nE\ncat > src/scenes/activity/step.js <<'E'\n// 5.4 Step Class. Footprints scroll to a hit line. 104 BPM, 32 bars.\nimport { App } from '../../app.js';\nimport { place } from '../../art/stage.js';\nimport { BeatClock } from '../../core/clock.js';\nimport { T } from '../../core/tunables.js';\nimport { chartNotes, STEP_BPM } from '../../data/charts.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nexport const WINDOWS = { perfect: 0.055, good: 0.1, ok: 0.14 };\nconst FOOT = ['.oo.', 'oooo', 'oooo', 'oooo', '.oo.', '....', '.oo.', '.oo.'];\nexport class StepSim {\n  t = 0; idx = 0; P = 0; G = 0; O = 0; M = 0; combo = 0; best = 0; score = 0; done = false; events = []; last = null; flash = 0;\n  constructor(cfg, env, rng, { maxBars = Infinity } = {}) {\n    this.cfg = cfg; this.env = env; this.rng = rng;\n    const c = chartNotes(undefined, { maxBars, hard: !!cfg.fill }); this.notes = c.notes.map((n) => ({ ...n, judged: false })); this.duration = c.duration + 1.2; this.total = this.notes.length;\n  }\n  win(k) { return WINDOWS[k] * T.stepWindow * (this.cfg.window ?? 1); }\n  judge(foot, when) {\n    const off = T.stepOffsetMs / 1000; let best = null, bd = Infinity;\n    for (let i = this.idx; i < this.notes.length; i++) {\n      const n = this.notes[i]; if (n.t > when + 0.5) break;\n      if (n.judged || n.foot !== foot) continue;\n      const d = Math.abs(n.t - (when - off)); if (d < bd) { bd = d; best = n; }\n    }\n    if (!best || bd > this.win('ok')) { return; }\n    best.judged = true;\n    const g = bd <= this.win('perfect') ? 'P' : bd <= this.win('good') ? 'G' : 'O';\n    this[g]++; this.combo++; this.best = Math.max(this.best, this.combo);\n    this.events.push({ kind: g, foot, combo: this.combo }); this.last = { g, foot, at: this.t };\n  }\n  step(dt, u, clock) {\n    this.t = clock ? clock(dt) : this.t + dt;\n    if (u.stepL) this.judge('L', this.t);\n    if (u.stepR) this.judge('R', this.t);\n    if (this.env.god) for (const n of this.notes) if (!n.judged && n.t <= this.t) { n.judged = true; this.P++; this.combo++; this.events.push({ kind: 'P', foot: n.foot, combo: this.combo }); }\n    while (this.idx < this.notes.length) {\n      const n = this.notes[this.idx];\n      if (n.judged) { this.idx++; continue; }\n      if (this.t - n.t > this.win('ok')) { n.judged = true; this.M++; this.combo = 0; this.events.push({ kind: 'M', foot: n.foot }); this.idx++; continue; }\n      break;\n    }\n    this.score = this.accuracy() * 100;\n    if (this.t >= this.duration) this.done = true;\n  }\n  accuracy() { return this.total ? (this.P + 0.7 * this.G + 0.4 * this.O) / this.total : 0; }\n  final() { return this.accuracy() * 100; }\n  result() { return { score: Math.round(this.final()), stats: { perfect: this.P, good: this.G, ok: this.O, miss: this.M, combo: this.best } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    while (driver.ni === undefined || driver.plan?.n?.judged || driver.plan === null) {\n      driver.ni = driver.ni === undefined ? 0 : driver.ni + 1;\n      if (driver.ni >= this.notes.length) { driver.plan = { done: true }; break; }\n      const n = this.notes[driver.ni];\n      driver.plan = { n, at: n.t + (driver.rng.next() - 0.5) * 2 * sk.jitter, hit: driver.rng.next() < sk.hit };\n      break;\n    }\n    const p = driver.plan;\n    if (p && !p.done && this.t >= p.at) {\n      if (p.hit) { if (p.n.foot === 'L') out.stepL = true; else out.stepR = true; }\n      driver.plan = null;\n    } else if (p && !p.done && this.t - p.n.t > 0.2) driver.plan = null;\n  }\n}\nexport const stepView = {\n  kind: 'step',\n  enter(scene, lane) { lane.avatar.play('Idle'); place(scene.ctx, 'step-platform', lane.x, 0.001, lane.z + 0.25); lane.stepped = 0; },\n  update(scene, lane) {\n    const s = lane.sim; if (!s) return;\n    for (const e of s.events) {\n      if (e.foot && e.kind !== 'M') lane.avatar.play(e.foot === 'L' ? 'StepL' : 'StepR', { once: true, speed: 1.4, fade: 0.05 });\n      if (e.kind === 'M' && lane === scene.lanes[scene.playerLane]) lane.avatar.lean.x = 0.4;\n    }\n    if (lane !== scene.lanes[scene.playerLane]) s.events.length = 0;\n    lane.avatar.lean.x *= 0.9;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const w = big ? 80 : 40, h = big ? hud.height - 50 - 62 : 76, x = Math.round(box.x - w / 2), top = Math.round(big ? 26 : box.y - 38), hitY = top + h - 14, pxPerSec = big ? 62 : 34;\n    hud.rect(x - 2, top - 2, w + 4, h + 4, 'ink'); hud.rect(x, top, w, h, 'night');\n    hud.rect(x + w / 2, top, 1, h, 'slate');\n    hud.rect(x, hitY, w, 2, 'white');\n    for (const n of s.notes) {\n      const dy = (n.t - s.t) * pxPerSec; if (dy > hitY - top || dy < -14) continue;\n      const nx = n.foot === 'L' ? x + w * 0.25 : x + w * 0.75;\n      if (n.judged && dy < 0) continue;\n      hud.sprite(Math.round(nx - (big ? 8 : 4)), Math.round(hitY - dy - (big ? 8 : 4)), FOOT, { o: n.foot === 'L' ? 'sky' : 'orange' }, { scale: big ? 2 : 1, shadow: 'ink' });\n    }\n    if (s.last && s.t - s.last.at < 0.3) {\n      const nx = s.last.foot === 'L' ? x + 2 : x + w / 2 + 2;\n      hud.rect(nx, hitY - 3, w / 2 - 4, 8, s.last.g === 'P' ? 'lime' : s.last.g === 'G' ? 'cyan' : 'orange');\n    }\n    if (big) {\n      say(hud, x - 2, hitY + 6, 'L', { color: 'sky' }); say(hud, x + w - 6, hitY + 6, 'R', { color: 'orange' });\n    }\n  },\n  score: (s) => s.final(),\n};\nconst BAR = (60 / STEP_BPM) * 4;\nexport class StepScene extends ActivityScene {\n  beat = new BeatClock();\n  makeSim(ctx, lane) { return new StepSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`step-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'beach', { coach: false });\n    for (const l of this.lanes) stepView.enter(this, l);\n    ctx.particles.register('confetti', { count: [18, 26], life: [0.8, 1.6], speed: [2, 4], gravity: 5, size: [1, 2], colors: ['red', 'sand', 'cyan', 'lime', 'orange'], radius: 0.5 });\n    this.beat.attach(ctx.audio);\n    this.lastMile = 0;\n  }\n  cardInfo() { return { goal: 'Left foot on left. Right foot on right. On the line.', prompts: [['feet', 'Left, right']] }; }\n  // Audio context time lags frames; lanes all read one clock.\n  stepLanes(ctx, dt) {\n    this.beat.advance(dt);\n    const t = this.beat.read() + (this.clockOffset ?? 0);\n    if (Math.abs(t - this.beat.time) > 0.5 && !this.beat.synced) this.beat.sync(t);\n    if (this.beat.synced) this.beat.time = t;\n    for (const l of this.lanes) {\n      if (!l.sim || l.sim.done) continue;\n      l.driver.read(this.out, l.sim, dt);\n      l.sim.step(dt, this.out, () => t);\n    }\n  }\n  onPlayStart(ctx) { this.startSong(ctx, 0); }\n  startSong(ctx, fromBar) {\n    const { SONGS } = App.__songs;\n    const song = SONGS.step;\n    ctx.audio.playMusic({ ...song, order: song.order.slice(fromBar) }, 'step');\n    this.beat.barOffset = fromBar * BAR; this.clockOffset = 0; this.beat.time = fromBar * BAR;\n    for (const l of this.lanes) if (l.sim) l.sim.events.length = 0;\n  }\n  // On pause: stop the music. On resume: count in and restart at the current bar.\n  onPause(ctx) { ctx.audio.stopMusic?.(); this.pausedAt = this.lanes[1].sim.t; }\n  onResume(ctx) {\n    if (this.finished) { App.music('evening'); return; }\n    if (this.phase === 'play') {\n      const bar = Math.max(0, Math.floor(this.pausedAt / BAR));\n      this.resumeBar = bar; this.setPhase('resume'); this.resumeT = 2 * (60 / STEP_BPM) * 2;\n      for (const l of this.lanes) if (l.sim) l.sim.t = bar * BAR - this.resumeT;\n      this.beat.time = bar * BAR - this.resumeT;\n    } else App.music(this.def.song);\n  }\n  tick(ctx, dt) {\n    if (this.phase === 'resume') {\n      if (App.blocked()) return;\n      this.resumeT -= dt;\n      for (const l of this.lanes) if (l.sim) l.sim.t += dt;\n      this.beat.time += dt;\n      if (this.resumeT <= 0) { this.startSong(ctx, this.resumeBar); this.setPhase('play'); }\n      return;\n    }\n    super.tick(ctx, dt);\n  }\n  view(ctx, dt) {\n    for (const l of this.lanes) stepView.update(this, l);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'P') App.sfx('stepPerfect'); else if (e.kind === 'G' || e.kind === 'O') App.sfx('stepGood'); else if (e.kind === 'M') App.sfx('stepMiss');\n      if (e.combo && e.combo % 25 === 0 && e.combo !== this.lastMile) { this.lastMile = e.combo; App.sfx('combo'); ctx.particles.burst('confetti', [0, 2.2, 0.8]); }\n    }\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    stepView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 60, r: 30 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = 60;\n    this.drawTopBar(hud, Math.round(s.score), s.combo > 1 ? `Combo ${s.combo}` : '');\n    if (s.last && s.t - s.last.at < 0.5) { const g = { P: 'Perfect', G: 'Good', O: 'OK' }[s.last.g]; say(hud, Math.round(W / 2) + 48, 90, g, { scale: 2, color: s.last.g === 'P' ? 'lime' : s.last.g === 'G' ? 'cyan' : 'orange' }); }\n    if (this.phase === 'resume') center(hud, hud.height / 2 - 20, String(Math.ceil(this.resumeT / (60 / STEP_BPM))), { scale: 5, color: 'sand' });\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['feet', 'Left, right'], ['pause', 'Pause']]);\n  }\n}\nE\ncat > src/scenes/activity/header.js <<'E'\n// 5.5 Coconut Header. Lean along the sand. Dennis runs a catapult.\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nconst FLY = 1.4;\nexport class HeaderSim {\n  t = 0; x = 0; score = 0; combo = 0; best = 0; done = false; next = 0.6; objs = []; events = []; daze = 0; hits = 0; flips = 0; head = 0;\n  constructor(cfg, env, rng, { width = 2, seconds = 60 } = {}) { this.cfg = cfg; this.env = env; this.rng = rng; this.width = width; this.seconds = seconds; }\n  tier() { return this.combo >= 20 ? 4 : this.combo >= 10 ? 3 : this.combo >= 5 ? 2 : 1; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds) { this.done = true; return; }\n    this.daze = Math.max(0, this.daze - dt);\n    if (this.daze <= 0) this.x = Math.max(-this.width, Math.min(this.width, this.x + 4.5 * (this.width < 2 ? this.width / 2 + 0.2 : 1) * u.x * dt));\n    if (this.t >= this.next) {\n      const u2 = Math.min(1, this.t / this.seconds);\n      this.next = this.t + (1.3 - 0.6 * u2) * T.headerInterval * (this.cfg.interval ?? 1);\n      const r = this.rng.next();\n      const kind = r < 0.7 ? 'coconut' : r < 0.95 ? 'flipflop' : 'pineapple';\n      this.objs.push({ kind, x: (this.rng.next() * 2 - 1) * this.width, t0: this.t, done: false, id: Math.floor(this.t * 1000) });\n      this.events.push({ kind: 'launch' });\n    }\n    this.head = Math.max(0, this.head - dt);\n    for (const o of this.objs) {\n      if (o.done) continue;\n      if (this.t - o.t0 >= FLY) {\n        o.done = true; const hitR = 0.55 * (this.width < 2 ? 0.8 : 1);\n        const near = Math.abs(o.x - this.x) < hitR || (this.env.god && o.kind !== 'flipflop');\n        if (near && o.kind === 'coconut') { this.combo++; this.best = Math.max(this.best, this.combo); const pts = 10 * this.tier(); this.score += pts; this.hits++; this.head = 0.3; this.events.push({ kind: 'bonk', x: o.x, pts, o }); }\n        else if (near && o.kind === 'pineapple') { this.score += 30; this.combo++; this.head = 0.3; this.events.push({ kind: 'pine', x: o.x, o }); }\n        else if (near && o.kind === 'flipflop') { this.score = Math.max(0, this.score - 10); this.combo = 0; this.daze = 0.6; this.flips++; this.events.push({ kind: 'thwap', x: o.x, o }); }\n        else if (o.kind === 'coconut') { this.events.push({ kind: 'missed', x: o.x, o }); o.missed = true; }\n      }\n    }\n    if (this.objs.length > 12) this.objs = this.objs.filter((o) => !o.done || this.t - o.t0 < 2.5);\n  }\n  final() { return this.score; }\n  result() { return { score: Math.round(this.score), stats: { headers: this.hits, combo: this.best, flipflops: this.flips } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    let best = null, bestT = Infinity;\n    for (const o of this.objs) { if (o.done || o.kind === 'flipflop') continue; const left = o.t0 + FLY - this.t; if (left < bestT && left > 0) { bestT = left; best = o; } }\n    const hazard = this.objs.find((o) => !o.done && o.kind === 'flipflop' && o.t0 + FLY - this.t < 0.45 && Math.abs(o.x - this.x) < 0.65);\n    if (driver.aimFor !== best?.id) { driver.aimFor = best?.id; driver.aimErr = (driver.rng.next() - 0.5) * (1.2 - sk.hit) * 1.6; driver.ignore = driver.rng.next() > sk.hit; }\n    let tx = best && !driver.ignore ? best.x + driver.aimErr : this.x;\n    if (hazard && sk.hit > 0.6) tx = hazard.x + (hazard.x > 0 ? -1 : 1);\n    const d = tx - this.x; out.x = Math.max(-1, Math.min(1, d * 3.5));\n  }\n}\nexport const headerView = {\n  kind: 'header',\n  enter(scene, lane) {\n    lane.avatar.play('Idle'); lane.objs = new Map(); lane.pool = { coconut: [], flipflop: [], pineapple: [] };\n    const ctx = scene.ctx;\n    const scale = lane.small ? 0.75 : 1;\n    const models = { coconut: 'coconut', flipflop: 'flip-flop', pineapple: 'golden-pineapple' };\n    for (const k of Object.keys(lane.pool)) for (let i = 0; i < 6; i++) { const b = place(ctx, models[k], 0, -9, 0, { scale, actors: true }); lane.pool[k].push({ obj: b.object, used: null }); }\n    lane.shadows = [];\n    for (let i = 0; i < 18; i++) { const s = scene.makeShadow(ctx); s.visible = false; lane.shadows.push(s); }\n  },\n  update(scene, lane, dt) {\n    const s = lane.sim; if (!s) return;\n    const a = lane.avatar;\n    a.root.position.x = lane.x + s.x;\n    a.lean.x = Math.max(-1, Math.min(1, (s.x - (lane.px ?? s.x)) * 15)); lane.px = s.x;\n    if (s.daze > 0) a.play('Daze'); else if (a.current === 'Daze') a.play('Idle');\n    for (const p of Object.values(lane.pool)) for (const q of p) { q.obj.visible = false; }\n    let si = 0; const pools = { coconut: 0, flipflop: 0, pineapple: 0 };\n    for (const o of s.objs) {\n      const age = s.t - o.t0, f = age / FLY;\n      if (o.done && !o.missed && !o.bounced) { o.bounced = true; }\n      if (f > 1.7) continue;\n      const pl = lane.pool[o.kind][pools[o.kind]++]; if (!pl) continue;\n      const lx = lane.x + o.x, startZ = -7;\n      let y, z;\n      if (f <= 1) { y = 1.75 + Math.sin(f * Math.PI) * 3.6; z = startZ + (lane.z - startZ) * f; }\n      else if (o.missed || o.kind === 'flipflop') { const g = (f - 1) * FLY; y = Math.max(0.1, 1.75 - 6 * g - 8 * g * g); z = lane.z + g * 2; }\n      else { const g = f - 1; y = 1.75 + g * 3; z = lane.z - g * 9; } // It flies back at Dennis.\n      pl.obj.visible = true; pl.obj.position.set(lx, y, z); pl.obj.rotation.x = age * 6;\n      if (f <= 1 && si < lane.shadows.length) { const sh = lane.shadows[si++]; sh.visible = true; sh.position.set(lx, 0.03, lane.z); const sc = 0.5 + f * 0.8; sh.scale.set(sc, 1, sc); }\n    }\n    for (; si < lane.shadows.length; si++) lane.shadows[si].visible = false;\n    for (const e of s.events) if (e.kind === 'bonk' || e.kind === 'pine') { a.play('HeaderNod', { once: true, speed: 1.4, fade: 0.04 }); a.sq.kick(-3); }\n    if (lane !== scene.lanes[scene.playerLane]) s.events.length = 0;\n    if (a.current === 'HeaderNod' && a.action('HeaderNod').time >= a.action('HeaderNod').getClip().duration - 0.02) a.play('Idle');\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    if (!big) { say(hud, box.x - 12, box.y - 4, String(Math.round(s.score)), { scale: 1, color: 'sand' }); if (s.combo >= 5) say(hud, box.x - 8, box.y + 6, `x${s.tier()}`, { color: 'lime' }); }\n  },\n  score: (s) => s.final(),\n};\nexport class HeaderScene extends ActivityScene {\n  makeSim(ctx, lane) { return new HeaderSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`head-${lane.solo ? 'solo' : lane.i}-${this.simN = (this.simN ?? 0) + 1}`), { width: lane.who === 'player' ? 2 : 0.8 }); }\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.6, 8.8], target: [0, 1.45, 0], fov: 32 }; }\n  makeShadow(ctx) { return makeBlob(ctx); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'lagoon', { coach: false });\n    // Solo: you get the whole sand. Classmates stay on their own narrow lanes at the edge.\n    const [a, me, b] = this.lanes;\n    a.x = -3.6; b.x = 3.6; a.avatar.setAt(-3.6, 0, 0.8); b.avatar.setAt(3.6, 0, 0.8);\n    for (const l of this.lanes) headerView.enter(this, l);\n    this.dennis = await makeAvatar(ctx, CAST_LOOKS.dennis); this.dennis.setAt(0, 0, -7);\n    this.catapult = place(ctx, 'catapult', 1.4, 0, -7, { actors: true });\n    a.avatar.root.visible = true;\n    ctx.particles.register('coco', { count: [6, 9], life: [0.25, 0.5], speed: [2, 4], gravity: 10, size: [1, 2], colors: ['white', 'sand', 'plum'] });\n    ctx.particles.register('sweat', { count: [3, 5], life: [0.3, 0.5], speed: [1.5, 3], gravity: 8, size: [1, 1], colors: ['cyan', 'white'] });\n    void me;\n  }\n  cardInfo() { return { goal: 'Head the coconuts. Dodge the flip-flops.', prompts: [['lean', 'Lean left, right']] }; }\n  view(ctx, dt) {\n    const l = this.lanes[1], s = l.sim;\n    const evs = s.events.slice();\n    for (const q of this.lanes) headerView.update(this, q, dt);\n    s.events.length = 0;\n    for (const e of evs) {\n      if (e.kind === 'bonk') { App.sfx('bonk', { pitch: Math.min(12, s.tier() * 2) }); ctx.engine.hitstop(0.05); ctx.particles.burst('coco', [l.x + e.x, 1.8, l.z]); this.dennisHit = 0.5; if (s.combo === 5 || s.combo === 10 || s.combo === 20) App.sfx('combo'); }\n      if (e.kind === 'pine') { App.sfx('pineapple'); ctx.particles.burst('sparkle', [l.x + e.x, 1.8, l.z], { count: 18, colors: ['sand', 'white'] }); }\n      if (e.kind === 'thwap') { App.sfx('thwap'); ctx.engine.shake.add(0.25); if (!App.bark) App.barkLine('A flip-flop. It was not personal. It was Dennis.', 'ounce', 1.8); }\n      if (e.kind === 'launch') { App.sfx('catapult'); this.catT = 0.25; }\n    }\n    this.dennis.update(dt);\n    if (this.dennisHit > 0) { this.dennisHit -= dt; if (this.dennis.current !== 'Hurt') this.dennis.play('Hurt', { once: true, fade: 0.05 }); }\n    else if (this.dennis.current === 'Hurt') this.dennis.play('Idle');\n    const arm = this.catapult.object.getObjectByName('arm');\n    if (arm) { this.catT = Math.max(0, (this.catT ?? 0) - dt); arm.rotation.x = this.catT > 0 ? -1.2 : 0; }\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[1].sim;\n    App.dialCenter.x = hud.width / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), s.combo >= 5 ? `Combo x${s.tier()}` : `${Math.max(0, Math.ceil(s.seconds - s.t))} s`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Lean'], ['pause', 'Pause']]);\n    void center;\n  }\n}\nexport function makeBlob(ctx) {\n  const { THREE, ContactShadow } = App.__engine;\n  void THREE;\n  const s = new ContactShadow(0.35); ctx.scene.add(s); s.place = s.place.bind(s);\n  return s;\n}\nE\necho \"- [x] lane sims: poses reps hoop step header\" >> PROGRESS.md","description":"Write the five lane activities"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12987,"cache_read_input_tokens":260375,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12987},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"a564b82e-55db-4117-8337-273fe1fdd153","timestamp":"2026-11-05T07:40:17.866Z","request_id":"req_011CgjQ6Jwq2xqgseWvnivz1","wire_tool_inputs":{"toolu_019ywYWq2LEuE5E4HZB2zTSr":{"command":"cat > src/scenes/activity/poses.js <<'E'\n// 5.1 Holding Still. Hold the pose by keeping the Dot in the ring.\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { BARKS } from '../../data/lines.js';\nimport { POSES } from '../../data/poses.js';\nimport { T } from '../../core/tunables.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\n\nexport class PoseSim {\n  t = 0; settle = 4; release = 2; inT = 0; holdT = 0; breathOk = 0; breathT = 0; s = 0.5; done = false; inside = false; wasInside = true; score = 0; events = []; wobbles = 0; bias = 0;\n  constructor(pose, env, rng, over = {}) {\n    this.pose = { ...pose, ...over }; this.env = env; this.rng = rng; this.hold = this.pose.hold;\n    this.dot = new Dot(() => rng.next()); this.ph = rng.next() * 6.28; this.ring = this.pose.ring;\n  }\n  get ringR() { return this.ring * this.env.ringMul; }\n  get phaseName() { return this.t < this.settle ? 'settle' : this.t < this.settle + this.hold ? 'hold' : 'release'; }\n  breathIn() { const p = this.pose.breath; return p ? (((this.t - this.settle) % p) + p) % p < p / 2 : false; }\n  mods() {\n    const p = this.pose, m = { noise: this.env.noiseMul };\n    const u = Math.max(0, Math.min(1, (this.t - this.settle) / this.hold));\n    if (p.wander) m.bx = p.wander * T.dotAuthority * Math.sin(0.37 * this.t + this.ph);\n    if (p.yNoise) m.by = (p.yNoise - 1) * T.dotNoise * Math.sin(2.9 * this.t + this.ph);\n    if (p.noiseRamp) m.noise *= p.noiseRamp[0] + (p.noiseRamp[1] - p.noiseRamp[0]) * u;\n    if (p.instScale) m.inst = p.instScale;\n    if (p.tremorAfter && this.t - this.settle > p.tremorAfter) m.bx = (m.bx ?? 0) + 0.9 * Math.sin(23 * this.t);\n    return m;\n  }\n  step(dt, u) {\n    this.t += dt;\n    const phase = this.phaseName, m = this.mods(), p = this.pose;\n    if (p.breath && phase === 'hold') {\n      const ok = !!u.breath === this.breathIn();\n      this.s += ((ok ? 1 : 0) - this.s) * Math.min(1, dt / 0.5);\n      m.noise *= 1.25 - T.breathBonus * this.s;\n      this.breathT += dt; if (ok) this.breathOk += dt;\n    }\n    this.dot.step(dt, u.x, u.y, T, m);\n    if (this.env.god) this.clampIn();\n    this.inside = this.dot.dist() <= this.ringR;\n    if (phase !== 'settle' && this.inside !== this.wasInside) {\n      this.events.push(this.inside ? 'in' : 'out');\n      if (!this.inside) this.wobbles++;\n    }\n    this.wasInside = this.inside;\n    if (phase === 'hold') { this.holdT += dt; if (this.inside) this.inT += dt; }\n    this.score = this.compute();\n    if (this.t >= this.settle + this.hold + this.release) this.done = true;\n  }\n  clampIn() { const d = this.dot.dist(), r = this.ringR * 0.9; if (d > r && d > 0) { const k = r / d; this.dot.x *= k; this.dot.y *= k; this.dot.vx *= 0.5; this.dot.vy *= 0.5; } }\n  compute() {\n    if (this.holdT <= 0) return 0;\n    const ring = this.inT / this.hold;\n    return this.pose.breath ? 100 * (0.8 * ring + 0.2 * (this.breathT > 0 ? this.breathOk / this.hold : 0)) : 100 * ring;\n  }\n  result() { return { score: Math.round(this.compute()), stats: { wobbles: this.wobbles } }; }\n  bot(driver, out, dt) {\n    driver.brain.lean(this.dot, 0, 0, dt, out);\n    const sk = driver.skill; let want = this.breathIn();\n    if (driver.rng.next() < sk.mistake * dt * 4) driver.breathFlip = (driver.breathFlip ?? 0) + 0.5;\n    if (driver.breathFlip > 0) { want = !want; driver.breathFlip -= dt; }\n    out.breath = want;\n  }\n}\nexport const poseView = {\n  kind: 'poses',\n  enter(scene, lane, data) { const clip = data.clip; lane.clipName = clip; lane.avatar.play(clip); },\n  update(scene, lane, dt) {\n    const s = lane.sim, a = lane.avatar; if (!s) return;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y;\n    const d = s.dot.dist(), over = d - s.ringR;\n    a.trem = over > 0 ? Math.min(1, over * 4) : 0;\n    if (over > 0.55 && a.current !== 'Teeter') a.play('Teeter');\n    else if (over <= 0.45 && a.current === 'Teeter') a.play(lane.clipName);\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    dial(hud, box.x, box.y, box.r, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.inside, glow: s.inT / Math.max(1, s.holdT + 1), seat: box.seat });\n    if (s.pose.breath && s.phaseName === 'hold') {\n      const p = s.pose.breath, ph = (((s.t - s.settle) % p) + p) % p / p, f = ph < 0.5 ? ph * 2 : 2 - ph * 2;\n      if (big) {\n        bar(hud, box.x + box.r + 10, box.y - 30, 12, 60, 0, 'cyan');\n        const fh = Math.round(58 * f); hud.rect(box.x + box.r + 11, box.y + 29 - fh, 10, fh, s.breathIn() ? 'cyan' : 'sky');\n        say(hud, box.x + box.r + 26, box.y - 3, s.breathIn() ? 'In...' : 'Out...', { color: 'white' });\n      } else bar(hud, box.x - box.r, box.y + box.r + 4, box.r * 2, 4, f, 'cyan');\n    }\n  },\n  score: (s) => s.compute(),\n};\nexport class PosesScene extends ActivityScene {\n  poseData() { const p = POSES[this.def.id]; return this.hard ? { ...p, ...this.def.hard } : p; }\n  makeSim(ctx, lane) { return new PoseSim(this.poseData(), App.simEnv(ctx, this.def), ctx.random.fork(`pose-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'pavilion');\n    const d = this.poseData();\n    for (const l of this.lanes) poseView.enter(this, l, d);\n    this.coach.play(d.clip);\n    this.kevinT = 0; this.cam = ctx.camera.camera; this.push = 0;\n    ctx.particles.register('zen', { count: [1, 1], life: [2, 4], speed: [0.05, 0.2], gravity: -0.04, size: [1, 1], colors: ['white', 'sand', 'white'], radius: 4 });\n    this.moteT = 0;\n  }\n  cardInfo() { const b = this.poseData().breath; return { goal: b ? 'Keep the dot in the circle. Breathe when told.' : 'Keep the dot in the circle.', prompts: b ? [['lean', 'Lean'], ['breath', 'Hold: breathe in']] : [['lean', 'Lean']] }; }\n  view(ctx, dt, rdt) {\n    for (const l of this.lanes) poseView.update(this, l, dt);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e === 'in') { App.sfx('chimeIn'); if (this.cosmetic.chance(0.25) && !App.bark) App.barkLine(this.cosmetic.pick(BARKS.ringIn), 'ounce', 1.8); }\n      else { App.sfx('chimeOut'); if (this.cosmetic.chance(0.35) && !App.bark) App.barkLine(this.cosmetic.pick(BARKS.ringOut), 'ounce', 2); }\n    }\n    this.moteT -= dt; if (this.moteT <= 0) { this.moteT = 0.25; ctx.particles.burst('zen', [this.cosmetic.range(-5, 5), this.cosmetic.range(0.4, 3), this.cosmetic.range(-2, 2)]); }\n    // A slow push-in while steady.\n    const steady = this.phase === 'play' && s.inside;\n    this.push += ((steady ? 1 : 0) - this.push) * Math.min(1, dt * 0.5);\n    const c = ctx.camera.camera;\n    if (c.isPerspectiveCamera) { c.fov = 30 - this.push * 3; c.updateProjectionMatrix(); }\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    poseView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 56, r: 44 }, true);\n    this.drawTopBar(hud, Math.round(s.score), s.phaseName === 'settle' ? 'Settle...' : s.phaseName === 'release' ? 'Release.' : `${Math.max(0, Math.ceil(s.settle + s.hold - s.t))} s`);\n    if (this.phase === 'play' && !App.attract) promptBar(hud, s.pose.breath ? [['lean', 'Lean'], ['breath', s.breathIn() ? 'Breathe in' : 'Let go'], ['pause', 'Pause']] : [['lean', 'Lean'], ['half', 'Half lean'], ['pause', 'Pause']]);\n    if (App.device.last === 'mouse' && App.top() == null && this.phase !== 'intro') {\n      const p = ctx.input.pointer, ax = ((p.x + 1) / 2) * hud.width, ay = ((1 - p.y) / 2) * hud.height;\n      hud.rect(ax - 3, ay, 7, 1, 'red'); hud.rect(ax, ay - 3, 1, 7, 'red');\n    }\n    void center;\n  }\n}\nE\ncat > src/scenes/activity/reps.js <<'E'\n// 5.2 The Rep Shed. You scrub the animation with the stick.\nimport { Mirror, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { REP_GRADES, REPS, repTarget } from '../../data/reps.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { panel } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\n\nexport class RepSim {\n  t = 0; r = 0; rep = 0; errSum = 0; errN = 0; repErr = 0; repN = 0; quals = []; done = false; score = 0; events = []; side = 1; target = 0; announced = 0; trem = 0;\n  constructor(ex, env, rng, over = {}) {\n    this.ex = { ...ex, ...over }; this.env = env; this.rng = rng; this.total = this.ex.reps + 2; this.announced = this.ex.reps; this.ph = rng.next() * 6.28;\n  }\n  get tempo() { return this.ex.tempo * T.repTempoScale; }\n  step(dt, u) {\n    this.t += dt;\n    const tempo = this.tempo; const rep = Math.floor(this.t / tempo);\n    if (rep !== this.rep) { this.finishRep(); this.rep = rep; if (rep >= this.total) { this.done = true; return; } this.side = this.ex.axis === 'side' ? (rep % 2 ? -1 : 1) : 1; this.events.push({ kind: 'rep', rep }); }\n    const uu = (this.t % tempo) / tempo; this.target = repTarget(uu);\n    const axis = this.ex.axis;\n    const raw = axis === 'down' ? -u.y : axis === 'up' ? u.y : u.x * this.side;\n    const lag = T.repLag * (this.ex.lagScale ?? 1);\n    if (u.digital) {\n      // Keys use rate control: S/W move r at the target speed, no key holds it.\n      const key = axis === 'down' ? -(u.keyY ?? 0) : axis === 'up' ? (u.keyY ?? 0) : (u.keyX ?? 0) * this.side;\n      this.r += key * (1 / (0.4 * tempo)) * dt;\n    } else this.r += (Math.max(0, raw) - this.r) * Math.min(1, dt / lag);\n    this.r = Math.max(0, Math.min(1, this.r));\n    const f = T.repFatigue * (this.rep / this.total) ** 2;\n    this.trem = f * Math.sin(this.t * 19 + this.ph);\n    const shown = Math.max(0, Math.min(1, this.r + this.trem));\n    this.shown = shown;\n    const err = Math.abs(shown - this.target);\n    if (this.env.god) this.r = this.target;\n    const e = this.env.god ? 0 : err;\n    this.repErr += e; this.repN++; this.errSum += e; this.errN++;\n    this.score = this.quals.length ? (100 * this.quals.reduce((a, b) => a + b, 0)) / Math.max(1, this.quals.length) : 0;\n  }\n  finishRep() {\n    if (!this.repN) return;\n    const q = Math.max(0, 1 - 1.6 * (this.repErr / this.repN));\n    this.quals.push(q); this.repErr = 0; this.repN = 0;\n    const grade = REP_GRADES.find(([min]) => q >= min)[1];\n    this.events.push({ kind: 'grade', grade, q });\n  }\n  final() { const all = this.quals.length ? this.quals : [0]; return 100 * all.reduce((a, b) => a + b, 0) / Math.max(this.total, all.length); }\n  result() { return { score: Math.round(this.done ? this.final() : this.score), stats: { reps: this.quals.length } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill, tempo = this.tempo;\n    const ahead = repTarget(((this.t + sk.repLead) % tempo) / tempo);\n    driver.wob = (driver.wob ?? 0) + (driver.rng.next() - 0.5) * sk.repErr * dt * 18; driver.wob *= 0.97;\n    const v = Math.max(0, Math.min(1, ahead + driver.wob));\n    const axis = this.ex.axis;\n    if (axis === 'down') out.y = -v; else if (axis === 'up') out.y = v; else out.x = v * this.side;\n  }\n}\nexport const repView = {\n  kind: 'reps',\n  enter(scene, lane) { lane.avatar.scrub(lane.sim.ex.clip, 0); },\n  update(scene, lane) {\n    const s = lane.sim; if (!s) return;\n    const clip = s.ex.axis === 'side' && s.side < 0 ? s.ex.clipL : s.ex.clip;\n    lane.avatar.scrub(clip, s.shown ?? s.r);\n    lane.avatar.lean.x = s.trem * 2; lane.avatar.trem = s.rep / s.total > 0.6 ? 0.5 : 0;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const h = big ? 110 : 44, w = big ? 22 : 10, x = Math.round(box.x - w / 2), y = Math.round(box.y - h / 2);\n    hud.rect(x - 2, y - 2, w + 4, h + 4, 'ink'); hud.rect(x, y, w, h, 'night');\n    const my = (v) => (s.ex.axis === 'up' ? y + h - 2 - (h - 4) * v : y + (h - 4) * v);\n    hud.rect(x, Math.round(my(s.target)), w, 4, 'lime');\n    hud.rect(x - (big ? 4 : 2), Math.round(my(s.shown ?? s.r)), w + (big ? 8 : 4), 3, Math.abs((s.shown ?? 0) - s.target) < 0.12 ? 'cyan' : 'red');\n  },\n  score: (s) => s.final(),\n};\nexport class RepsScene extends ActivityScene {\n  ex() { const e = REPS[this.def.id]; return this.hard ? { ...e, ...this.def.hard } : e; }\n  makeSim(ctx, lane) { return new RepSim(this.ex(), App.simEnv(ctx, this.def), ctx.random.fork(`rep-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'shed');\n    for (const l of this.lanes) repView.enter(this, l);\n    this.coach.setAt(-1.1, 0, -1.5); this.coach.play('Idle');\n    // A wall mirror showing your reps. Stopped in dispose.\n    if (ctx.engine.gpu) {\n      this.mirror = new Mirror({ size: [8.6, 3.2] }); this.mirror.mesh.position.set(0, 2.2, -4.05);\n      ctx.scene.add(this.mirror.mesh);\n      this.stopMirror = this.mirror.attach(ctx.engine.renderer, ctx.scene);\n    }\n    this.lastGrade = ''; this.gradeT = 0;\n  }\n  dispose() { this.stopMirror?.(); this.mirror?.dispose(); }\n  cardInfo() {\n    const e = this.ex(), verb = e.axis === 'down' ? 'Push down: go deeper' : e.axis === 'up' ? 'Push up: press' : 'Push left, right: lunge';\n    return { goal: `Match the green marker. ${e.reps} reps. It says ${e.reps}.`, prompts: [['lean', verb]] };\n  }\n  onPlayStart() { this.repSaid = -1; }\n  view(ctx, dt) {\n    for (const l of this.lanes) repView.update(this, l);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'grade') { this.lastGrade = e.grade; this.gradeT = 1.1; App.sfx(e.grade === 'Perfect' ? 'repPerfect' : 'repTick'); }\n      if (e.kind === 'rep' && this.phase === 'play') {\n        const over = e.rep - (s.announced - 1);\n        if (over >= 0 && over < BARKS.repCount.length) { App.barkLine(BARKS.repCount[over], 'coach', 2); this.coach.play('CoachPoint', { once: true }); }\n      }\n    }\n    this.gradeT -= dt;\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim, cx = Math.round(W / 2) + 90;\n    repView.draw(this, hud, this.lanes[1], { x: cx, y: 90, r: 40 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), `Rep ${Math.min(s.rep + 1, s.total)} / ${s.announced}`);\n    if (this.gradeT > 0) center(hud, 44, this.lastGrade, { scale: 2, color: this.lastGrade === 'Perfect' ? 'lime' : this.lastGrade === 'Good' ? 'cyan' : 'orange' });\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', s.ex.axis === 'down' ? 'Deeper' : s.ex.axis === 'up' ? 'Press' : (s.side > 0 ? 'Right' : 'Left')], ['pause', 'Pause']]);\n    void panel; void say;\n  }\n}\nE\ncat > src/scenes/activity/hoop.js <<'E'\n// 5.3 Hoop Economics. Circle the stick to keep hoops up.\nimport { App } from '../../app.js';\nimport { makeHoopMesh } from '../../art/avatar.js';\nimport { T } from '../../core/tunables.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, disc, line, ring } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst TAU = Math.PI * 2;\nexport class HoopSim {\n  t = 0; L = 0.5; speed = 0; last = null; rot = 0; score = 0; hoops = 1; mult = 1; dropped = 0; done = false; events = []; ang = 0; inBand = false; wrong = false; next = 9; throwAt = null; side = 0; caught = 0; flick = false;\n  constructor(cfg, env, rng, { seconds = 60 } = {}) { this.cfg = cfg; this.env = env; this.rng = rng; this.seconds = seconds; this.dirA = seconds * (25 / 60); this.dirB = seconds * (50 / 60); this.throwRng = rng.fork ? rng.fork('throw') : rng; }\n  dir() { return this.t < this.dirA ? 1 : this.t < this.dirB ? -1 : 0; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds) { this.done = true; return; }\n    const low = this.cfg.low ?? T.hoopLow, high = this.cfg.high ?? T.hoopHigh;\n    const mag = Math.hypot(u.x, u.y);\n    if (mag > 0.5) {\n      const a = Math.atan2(u.y, u.x);\n      if (this.last !== null) { let d = a - this.last; if (d > Math.PI) d -= TAU; if (d < -Math.PI) d += TAU; const inst = d / TAU / dt; this.speed += (inst - this.speed) * Math.min(1, dt / 0.25); }\n      this.last = a;\n    } else { this.speed += (0 - this.speed) * Math.min(1, dt / 0.25); this.last = null; }\n    const dir = this.dir(), s = dir === 0 ? Math.abs(this.speed) : this.speed * dir;\n    this.inBand = s >= low && s <= high; this.wrong = s < -0.2;\n    if (this.env.god) { this.inBand = true; this.wrong = false; this.speed = 1.6 * (dir || 1); }\n    if (this.dropped > 0) {\n      this.dropped -= dt;\n      if (this.dropped <= 0) { this.L = 0.35; this.events.push('pickup'); }\n    } else {\n      this.L += (this.inBand ? T.hoopLiftRate : this.wrong ? -0.5 : -0.25) * dt;\n      this.L = Math.min(1, this.L);\n      if (this.L <= 0) { this.L = 0; this.dropped = 1.5; this.hoops = Math.max(1, this.hoops - 1); this.mult = 1 + 0.5 * (this.hoops - 1); this.events.push('drop'); }\n      if (this.inBand) { const rev = Math.abs(this.speed) * dt; this.rot += rev; this.score += rev * this.mult; }\n    }\n    this.ang += this.speed * TAU * dt;\n    // June throws a hoop every ~9 s; flick toward it in the last .4 s to catch it.\n    if (this.throwAt === null && this.t >= this.next && this.hoops < 4 && this.t < this.seconds - 3) {\n      this.side = this.throwRng.next() < 0.5 ? -1 : 1; this.throwAt = this.t + 1.5; this.events.push('throw');\n    }\n    if (this.throwAt !== null) {\n      const left = this.throwAt - this.t;\n      if (left <= 0.4 && left > -0.05 && Math.abs(u.x) > 0.7 && Math.sign(u.x) === this.side) { this.hoops++; this.mult = 1 + 0.5 * (this.hoops - 1); this.caught++; this.throwAt = null; this.next = this.t + 7.5 + this.throwRng.next() * 3; this.events.push('catch'); }\n      else if (left <= -0.05) { this.throwAt = null; this.next = this.t + 7.5 + this.throwRng.next() * 3; this.events.push('miss'); }\n    }\n  }\n  final() { return this.score; }\n  result() { return { score: Math.round(this.score), stats: { rotations: Math.round(this.rot), caught: this.caught } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    driver.a = (driver.a ?? 0) + TAU * sk.circle * (this.dir() || 1) * dt * (1 + (driver.rng.next() - 0.5) * 0.3);\n    out.x = Math.cos(driver.a) * 0.95; out.y = Math.sin(driver.a) * 0.95;\n    if (this.throwAt !== null) {\n      const left = this.throwAt - this.t;\n      if (left <= 0.35 && left > 0) {\n        if (driver.decided !== this.throwAt) { driver.decided = this.throwAt; driver.willCatch = driver.rng.next() < sk.catch; }\n        if (driver.willCatch) { out.x = this.side; out.y = 0; }\n      }\n    }\n  }\n}\nexport const hoopView = {\n  kind: 'hoop',\n  enter(scene, lane) {\n    lane.avatar.play('HoopStance');\n    const ctx = scene.ctx; lane.hoops = [];\n    for (let i = 0; i < 4; i++) { const h = makeHoopMesh(0.5 + i * 0.03, ['orange', 'cyan', 'lime', 'red'][i]); h.visible = false; ctx.scene.add(h); lane.hoops.push(h); }\n    lane.thrown = makeHoopMesh(0.5, 'sand'); lane.thrown.visible = false; ctx.scene.add(lane.thrown);\n    (scene.viewObjects ??= []).push(...lane.hoops, lane.thrown);\n  },\n  update(scene, lane, dt) {\n    const s = lane.sim; if (!s) return;\n    const a = lane.avatar, base = a.root.position, wob = s.dropped > 0 ? 0 : 1;\n    const ang = s.ang;\n    if (a.pelvis) { a.pelvis.position.x += Math.cos(ang) * 0.05 * wob; a.pelvis.position.z += Math.sin(ang) * 0.04 * wob; }\n    lane.hoops.forEach((h, i) => {\n      h.visible = i < s.hoops && s.dropped <= 0;\n      const y = 0.72 + i * 0.06 + (s.L - 0.5) * 0.3, off = 0.14 + i * 0.03;\n      h.position.set(base.x + Math.cos(ang + i) * off, y, base.z + Math.sin(ang + i) * off);\n      h.rotation.x = Math.sin(ang) * (0.22 - s.L * 0.16); h.rotation.z = Math.cos(ang) * (0.22 - s.L * 0.16);\n    });\n    if (s.dropped > 0) { const h = lane.hoops[0]; h.visible = true; h.position.set(base.x, 0.06, base.z); h.rotation.set(0, 0, 0); }\n    if (s.throwAt !== null) {\n      const left = s.throwAt - s.t, f = 1 - left / 1.5;\n      lane.thrown.visible = true; lane.thrown.position.set(base.x + s.side * (2.6 - 2.6 * f), 0.8 + Math.sin(f * Math.PI) * 1.6, base.z); lane.thrown.rotation.z += dt * 4;\n    } else lane.thrown.visible = false;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const r = box.r;\n    disc(hud, box.x, box.y, r + 2, 'ink'); disc(hud, box.x, box.y, r, 'white');\n    ring(hud, box.x, box.y, r, s.inBand ? 'lime' : s.wrong ? 'red' : 'slate', 3);\n    const a = s.ang; line(hud, box.x, box.y, box.x + Math.cos(a) * (r - 4), box.y - Math.sin(a) * (r - 4), s.inBand ? 'green' : 'orange', 2);\n    disc(hud, box.x, box.y, Math.max(2, r / 10), 'ink');\n    bar(hud, box.x - r, box.y + r + 5, r * 2, big ? 7 : 4, s.L, s.L < 0.25 ? 'red' : 'cyan');\n    if (big) {\n      const d = s.dir(); const txt = d > 0 ? 'Anticlockwise' : d < 0 ? 'The other way' : 'Either way';\n      say(hud, box.x - txt.length * 3, box.y + r + 15, txt, { color: 'sand' });\n    }\n  },\n  score: (s) => s.final(),\n};\nexport class HoopScene extends ActivityScene {\n  makeSim(ctx, lane) { return new HoopSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`hoop-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'beach', { coach: false });\n    for (const l of this.lanes) hoopView.enter(this, l);\n    const { makeAvatar } = await import('../../art/avatar.js');\n    const { CAST_LOOKS } = await import('../../data/classmates.js');\n    this.june = await makeAvatar(ctx, CAST_LOOKS.june); this.june.setAt(-5.2, 0, -0.6, 0.9);\n    this.whirr = ctx.audio.loop('hoopWhirr', { volume: 0 });\n    ctx.particles.register('hoopspark', { count: [2, 3], life: [0.3, 0.6], speed: [1, 2], gravity: 2, size: [1, 1], colors: ['white', 'cyan', 'sand'] });\n    this.sparkT = 0;\n  }\n  cardInfo() { return { goal: 'Circle to spin. Flick toward a thrown hoop to catch it.', prompts: [['lean', 'Circle, then flick']] }; }\n  onPlayStart() { App.barkLine('Anticlockwise.', 'coach', 1.5); this.saidOther = false; }\n  view(ctx, dt) {\n    for (const l of this.lanes) hoopView.update(this, l, dt);\n    const s = this.lanes[1].sim;\n    this.june.update(dt);\n    for (const e of s.events.splice(0)) {\n      if (e === 'drop') { App.sfx('hoopDrop'); App.barkLine('You have dropped your hoop. I will not tell it.', 'ounce', 2); }\n      if (e === 'catch') { App.sfx('hoopCatch'); App.barkLine('Another hoop. The market is responding.', 'ounce', 1.6); }\n      if (e === 'throw') { this.june.play('Punch', { once: true }); App.barkLine('June: \"Catch.\"', 'june', 1.2); }\n    }\n    if (!this.saidOther && s.dir() < 0 && this.phase === 'play') { this.saidOther = true; App.barkLine('Now the other way.', 'coach', 1.5); }\n    if (this.whirr) this.whirr.set({ volume: this.phase === 'play' && s.inBand ? 0.5 : 0 });\n    this.sparkT -= dt;\n    if (s.inBand && this.sparkT <= 0 && this.phase === 'play') { this.sparkT = 0.2; ctx.particles.burst('hoopspark', [this.lanes[1].x, 1, 0.8]); }\n  }\n  updateAvatars(ctx, dt) { for (const l of this.lanes) { l.avatar.update(dt); hoopView.update(this, l, 0); } }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    hoopView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 52, r: 30 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = 52;\n    this.drawTopBar(hud, Math.round(s.score), `x${s.mult.toFixed(1)}  ${s.hoops} hoop${s.hoops > 1 ? 's' : ''}`);\n    if (s.throwAt !== null) { const p = s.side < 0 ? '< Flick' : 'Flick >'; center(hud, 100, p, { scale: 2, color: s.throwAt - s.t <= 0.4 ? 'lime' : 'orange' }); }\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', 'Circle'], ['pause', 'Pause']]);\n  }\n}\nE\ncat > src/scenes/activity/step.js <<'E'\n// 5.4 Step Class. Footprints scroll to a hit line. 104 BPM, 32 bars.\nimport { App } from '../../app.js';\nimport { place } from '../../art/stage.js';\nimport { BeatClock } from '../../core/clock.js';\nimport { T } from '../../core/tunables.js';\nimport { chartNotes, STEP_BPM } from '../../data/charts.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nexport const WINDOWS = { perfect: 0.055, good: 0.1, ok: 0.14 };\nconst FOOT = ['.oo.', 'oooo', 'oooo', 'oooo', '.oo.', '....', '.oo.', '.oo.'];\nexport class StepSim {\n  t = 0; idx = 0; P = 0; G = 0; O = 0; M = 0; combo = 0; best = 0; score = 0; done = false; events = []; last = null; flash = 0;\n  constructor(cfg, env, rng, { maxBars = Infinity } = {}) {\n    this.cfg = cfg; this.env = env; this.rng = rng;\n    const c = chartNotes(undefined, { maxBars, hard: !!cfg.fill }); this.notes = c.notes.map((n) => ({ ...n, judged: false })); this.duration = c.duration + 1.2; this.total = this.notes.length;\n  }\n  win(k) { return WINDOWS[k] * T.stepWindow * (this.cfg.window ?? 1); }\n  judge(foot, when) {\n    const off = T.stepOffsetMs / 1000; let best = null, bd = Infinity;\n    for (let i = this.idx; i < this.notes.length; i++) {\n      const n = this.notes[i]; if (n.t > when + 0.5) break;\n      if (n.judged || n.foot !== foot) continue;\n      const d = Math.abs(n.t - (when - off)); if (d < bd) { bd = d; best = n; }\n    }\n    if (!best || bd > this.win('ok')) { return; }\n    best.judged = true;\n    const g = bd <= this.win('perfect') ? 'P' : bd <= this.win('good') ? 'G' : 'O';\n    this[g]++; this.combo++; this.best = Math.max(this.best, this.combo);\n    this.events.push({ kind: g, foot, combo: this.combo }); this.last = { g, foot, at: this.t };\n  }\n  step(dt, u, clock) {\n    this.t = clock ? clock(dt) : this.t + dt;\n    if (u.stepL) this.judge('L', this.t);\n    if (u.stepR) this.judge('R', this.t);\n    if (this.env.god) for (const n of this.notes) if (!n.judged && n.t <= this.t) { n.judged = true; this.P++; this.combo++; this.events.push({ kind: 'P', foot: n.foot, combo: this.combo }); }\n    while (this.idx < this.notes.length) {\n      const n = this.notes[this.idx];\n      if (n.judged) { this.idx++; continue; }\n      if (this.t - n.t > this.win('ok')) { n.judged = true; this.M++; this.combo = 0; this.events.push({ kind: 'M', foot: n.foot }); this.idx++; continue; }\n      break;\n    }\n    this.score = this.accuracy() * 100;\n    if (this.t >= this.duration) this.done = true;\n  }\n  accuracy() { return this.total ? (this.P + 0.7 * this.G + 0.4 * this.O) / this.total : 0; }\n  final() { return this.accuracy() * 100; }\n  result() { return { score: Math.round(this.final()), stats: { perfect: this.P, good: this.G, ok: this.O, miss: this.M, combo: this.best } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    while (driver.ni === undefined || driver.plan?.n?.judged || driver.plan === null) {\n      driver.ni = driver.ni === undefined ? 0 : driver.ni + 1;\n      if (driver.ni >= this.notes.length) { driver.plan = { done: true }; break; }\n      const n = this.notes[driver.ni];\n      driver.plan = { n, at: n.t + (driver.rng.next() - 0.5) * 2 * sk.jitter, hit: driver.rng.next() < sk.hit };\n      break;\n    }\n    const p = driver.plan;\n    if (p && !p.done && this.t >= p.at) {\n      if (p.hit) { if (p.n.foot === 'L') out.stepL = true; else out.stepR = true; }\n      driver.plan = null;\n    } else if (p && !p.done && this.t - p.n.t > 0.2) driver.plan = null;\n  }\n}\nexport const stepView = {\n  kind: 'step',\n  enter(scene, lane) { lane.avatar.play('Idle'); place(scene.ctx, 'step-platform', lane.x, 0.001, lane.z + 0.25); lane.stepped = 0; },\n  update(scene, lane) {\n    const s = lane.sim; if (!s) return;\n    for (const e of s.events) {\n      if (e.foot && e.kind !== 'M') lane.avatar.play(e.foot === 'L' ? 'StepL' : 'StepR', { once: true, speed: 1.4, fade: 0.05 });\n      if (e.kind === 'M' && lane === scene.lanes[scene.playerLane]) lane.avatar.lean.x = 0.4;\n    }\n    if (lane !== scene.lanes[scene.playerLane]) s.events.length = 0;\n    lane.avatar.lean.x *= 0.9;\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    const w = big ? 80 : 40, h = big ? hud.height - 50 - 62 : 76, x = Math.round(box.x - w / 2), top = Math.round(big ? 26 : box.y - 38), hitY = top + h - 14, pxPerSec = big ? 62 : 34;\n    hud.rect(x - 2, top - 2, w + 4, h + 4, 'ink'); hud.rect(x, top, w, h, 'night');\n    hud.rect(x + w / 2, top, 1, h, 'slate');\n    hud.rect(x, hitY, w, 2, 'white');\n    for (const n of s.notes) {\n      const dy = (n.t - s.t) * pxPerSec; if (dy > hitY - top || dy < -14) continue;\n      const nx = n.foot === 'L' ? x + w * 0.25 : x + w * 0.75;\n      if (n.judged && dy < 0) continue;\n      hud.sprite(Math.round(nx - (big ? 8 : 4)), Math.round(hitY - dy - (big ? 8 : 4)), FOOT, { o: n.foot === 'L' ? 'sky' : 'orange' }, { scale: big ? 2 : 1, shadow: 'ink' });\n    }\n    if (s.last && s.t - s.last.at < 0.3) {\n      const nx = s.last.foot === 'L' ? x + 2 : x + w / 2 + 2;\n      hud.rect(nx, hitY - 3, w / 2 - 4, 8, s.last.g === 'P' ? 'lime' : s.last.g === 'G' ? 'cyan' : 'orange');\n    }\n    if (big) {\n      say(hud, x - 2, hitY + 6, 'L', { color: 'sky' }); say(hud, x + w - 6, hitY + 6, 'R', { color: 'orange' });\n    }\n  },\n  score: (s) => s.final(),\n};\nconst BAR = (60 / STEP_BPM) * 4;\nexport class StepScene extends ActivityScene {\n  beat = new BeatClock();\n  makeSim(ctx, lane) { return new StepSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`step-${lane.i}-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'beach', { coach: false });\n    for (const l of this.lanes) stepView.enter(this, l);\n    ctx.particles.register('confetti', { count: [18, 26], life: [0.8, 1.6], speed: [2, 4], gravity: 5, size: [1, 2], colors: ['red', 'sand', 'cyan', 'lime', 'orange'], radius: 0.5 });\n    this.beat.attach(ctx.audio);\n    this.lastMile = 0;\n  }\n  cardInfo() { return { goal: 'Left foot on left. Right foot on right. On the line.', prompts: [['feet', 'Left, right']] }; }\n  // Audio context time lags frames; lanes all read one clock.\n  stepLanes(ctx, dt) {\n    this.beat.advance(dt);\n    const t = this.beat.read() + (this.clockOffset ?? 0);\n    if (Math.abs(t - this.beat.time) > 0.5 && !this.beat.synced) this.beat.sync(t);\n    if (this.beat.synced) this.beat.time = t;\n    for (const l of this.lanes) {\n      if (!l.sim || l.sim.done) continue;\n      l.driver.read(this.out, l.sim, dt);\n      l.sim.step(dt, this.out, () => t);\n    }\n  }\n  onPlayStart(ctx) { this.startSong(ctx, 0); }\n  startSong(ctx, fromBar) {\n    const { SONGS } = App.__songs;\n    const song = SONGS.step;\n    ctx.audio.playMusic({ ...song, order: song.order.slice(fromBar) }, 'step');\n    this.beat.barOffset = fromBar * BAR; this.clockOffset = 0; this.beat.time = fromBar * BAR;\n    for (const l of this.lanes) if (l.sim) l.sim.events.length = 0;\n  }\n  // On pause: stop the music. On resume: count in and restart at the current bar.\n  onPause(ctx) { ctx.audio.stopMusic?.(); this.pausedAt = this.lanes[1].sim.t; }\n  onResume(ctx) {\n    if (this.finished) { App.music('evening'); return; }\n    if (this.phase === 'play') {\n      const bar = Math.max(0, Math.floor(this.pausedAt / BAR));\n      this.resumeBar = bar; this.setPhase('resume'); this.resumeT = 2 * (60 / STEP_BPM) * 2;\n      for (const l of this.lanes) if (l.sim) l.sim.t = bar * BAR - this.resumeT;\n      this.beat.time = bar * BAR - this.resumeT;\n    } else App.music(this.def.song);\n  }\n  tick(ctx, dt) {\n    if (this.phase === 'resume') {\n      if (App.blocked()) return;\n      this.resumeT -= dt;\n      for (const l of this.lanes) if (l.sim) l.sim.t += dt;\n      this.beat.time += dt;\n      if (this.resumeT <= 0) { this.startSong(ctx, this.resumeBar); this.setPhase('play'); }\n      return;\n    }\n    super.tick(ctx, dt);\n  }\n  view(ctx, dt) {\n    for (const l of this.lanes) stepView.update(this, l);\n    const s = this.lanes[1].sim;\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'P') App.sfx('stepPerfect'); else if (e.kind === 'G' || e.kind === 'O') App.sfx('stepGood'); else if (e.kind === 'M') App.sfx('stepMiss');\n      if (e.combo && e.combo % 25 === 0 && e.combo !== this.lastMile) { this.lastMile = e.combo; App.sfx('combo'); ctx.particles.burst('confetti', [0, 2.2, 0.8]); }\n    }\n  }\n  drawPlay(ctx, hud) {\n    const W = hud.width, s = this.lanes[1].sim;\n    stepView.draw(this, hud, this.lanes[1], { x: Math.round(W / 2), y: 60, r: 30 }, true);\n    App.dialCenter.x = W / 2; App.dialCenter.y = 60;\n    this.drawTopBar(hud, Math.round(s.score), s.combo > 1 ? `Combo ${s.combo}` : '');\n    if (s.last && s.t - s.last.at < 0.5) { const g = { P: 'Perfect', G: 'Good', O: 'OK' }[s.last.g]; say(hud, Math.round(W / 2) + 48, 90, g, { scale: 2, color: s.last.g === 'P' ? 'lime' : s.last.g === 'G' ? 'cyan' : 'orange' }); }\n    if (this.phase === 'resume') center(hud, hud.height / 2 - 20, String(Math.ceil(this.resumeT / (60 / STEP_BPM))), { scale: 5, color: 'sand' });\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['feet', 'Left, right'], ['pause', 'Pause']]);\n  }\n}\nE\ncat > src/scenes/activity/header.js <<'E'\n// 5.5 Coconut Header. Lean along the sand. Dennis runs a catapult.\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nconst FLY = 1.4;\nexport class HeaderSim {\n  t = 0; x = 0; score = 0; combo = 0; best = 0; done = false; next = 0.6; objs = []; events = []; daze = 0; hits = 0; flips = 0; head = 0;\n  constructor(cfg, env, rng, { width = 2, seconds = 60 } = {}) { this.cfg = cfg; this.env = env; this.rng = rng; this.width = width; this.seconds = seconds; }\n  tier() { return this.combo >= 20 ? 4 : this.combo >= 10 ? 3 : this.combo >= 5 ? 2 : 1; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds) { this.done = true; return; }\n    this.daze = Math.max(0, this.daze - dt);\n    if (this.daze <= 0) this.x = Math.max(-this.width, Math.min(this.width, this.x + 4.5 * (this.width < 2 ? this.width / 2 + 0.2 : 1) * u.x * dt));\n    if (this.t >= this.next) {\n      const u2 = Math.min(1, this.t / this.seconds);\n      this.next = this.t + (1.3 - 0.6 * u2) * T.headerInterval * (this.cfg.interval ?? 1);\n      const r = this.rng.next();\n      const kind = r < 0.7 ? 'coconut' : r < 0.95 ? 'flipflop' : 'pineapple';\n      this.objs.push({ kind, x: (this.rng.next() * 2 - 1) * this.width, t0: this.t, done: false, id: Math.floor(this.t * 1000) });\n      this.events.push({ kind: 'launch' });\n    }\n    this.head = Math.max(0, this.head - dt);\n    for (const o of this.objs) {\n      if (o.done) continue;\n      if (this.t - o.t0 >= FLY) {\n        o.done = true; const hitR = 0.55 * (this.width < 2 ? 0.8 : 1);\n        const near = Math.abs(o.x - this.x) < hitR || (this.env.god && o.kind !== 'flipflop');\n        if (near && o.kind === 'coconut') { this.combo++; this.best = Math.max(this.best, this.combo); const pts = 10 * this.tier(); this.score += pts; this.hits++; this.head = 0.3; this.events.push({ kind: 'bonk', x: o.x, pts, o }); }\n        else if (near && o.kind === 'pineapple') { this.score += 30; this.combo++; this.head = 0.3; this.events.push({ kind: 'pine', x: o.x, o }); }\n        else if (near && o.kind === 'flipflop') { this.score = Math.max(0, this.score - 10); this.combo = 0; this.daze = 0.6; this.flips++; this.events.push({ kind: 'thwap', x: o.x, o }); }\n        else if (o.kind === 'coconut') { this.events.push({ kind: 'missed', x: o.x, o }); o.missed = true; }\n      }\n    }\n    if (this.objs.length > 12) this.objs = this.objs.filter((o) => !o.done || this.t - o.t0 < 2.5);\n  }\n  final() { return this.score; }\n  result() { return { score: Math.round(this.score), stats: { headers: this.hits, combo: this.best, flipflops: this.flips } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    let best = null, bestT = Infinity;\n    for (const o of this.objs) { if (o.done || o.kind === 'flipflop') continue; const left = o.t0 + FLY - this.t; if (left < bestT && left > 0) { bestT = left; best = o; } }\n    const hazard = this.objs.find((o) => !o.done && o.kind === 'flipflop' && o.t0 + FLY - this.t < 0.45 && Math.abs(o.x - this.x) < 0.65);\n    if (driver.aimFor !== best?.id) { driver.aimFor = best?.id; driver.aimErr = (driver.rng.next() - 0.5) * (1.2 - sk.hit) * 1.6; driver.ignore = driver.rng.next() > sk.hit; }\n    let tx = best && !driver.ignore ? best.x + driver.aimErr : this.x;\n    if (hazard && sk.hit > 0.6) tx = hazard.x + (hazard.x > 0 ? -1 : 1);\n    const d = tx - this.x; out.x = Math.max(-1, Math.min(1, d * 3.5));\n  }\n}\nexport const headerView = {\n  kind: 'header',\n  enter(scene, lane) {\n    lane.avatar.play('Idle'); lane.objs = new Map(); lane.pool = { coconut: [], flipflop: [], pineapple: [] };\n    const ctx = scene.ctx;\n    const scale = lane.small ? 0.75 : 1;\n    const models = { coconut: 'coconut', flipflop: 'flip-flop', pineapple: 'golden-pineapple' };\n    for (const k of Object.keys(lane.pool)) for (let i = 0; i < 6; i++) { const b = place(ctx, models[k], 0, -9, 0, { scale, actors: true }); lane.pool[k].push({ obj: b.object, used: null }); }\n    lane.shadows = [];\n    for (let i = 0; i < 18; i++) { const s = scene.makeShadow(ctx); s.visible = false; lane.shadows.push(s); }\n  },\n  update(scene, lane, dt) {\n    const s = lane.sim; if (!s) return;\n    const a = lane.avatar;\n    a.root.position.x = lane.x + s.x;\n    a.lean.x = Math.max(-1, Math.min(1, (s.x - (lane.px ?? s.x)) * 15)); lane.px = s.x;\n    if (s.daze > 0) a.play('Daze'); else if (a.current === 'Daze') a.play('Idle');\n    for (const p of Object.values(lane.pool)) for (const q of p) { q.obj.visible = false; }\n    let si = 0; const pools = { coconut: 0, flipflop: 0, pineapple: 0 };\n    for (const o of s.objs) {\n      const age = s.t - o.t0, f = age / FLY;\n      if (o.done && !o.missed && !o.bounced) { o.bounced = true; }\n      if (f > 1.7) continue;\n      const pl = lane.pool[o.kind][pools[o.kind]++]; if (!pl) continue;\n      const lx = lane.x + o.x, startZ = -7;\n      let y, z;\n      if (f <= 1) { y = 1.75 + Math.sin(f * Math.PI) * 3.6; z = startZ + (lane.z - startZ) * f; }\n      else if (o.missed || o.kind === 'flipflop') { const g = (f - 1) * FLY; y = Math.max(0.1, 1.75 - 6 * g - 8 * g * g); z = lane.z + g * 2; }\n      else { const g = f - 1; y = 1.75 + g * 3; z = lane.z - g * 9; } // It flies back at Dennis.\n      pl.obj.visible = true; pl.obj.position.set(lx, y, z); pl.obj.rotation.x = age * 6;\n      if (f <= 1 && si < lane.shadows.length) { const sh = lane.shadows[si++]; sh.visible = true; sh.position.set(lx, 0.03, lane.z); const sc = 0.5 + f * 0.8; sh.scale.set(sc, 1, sc); }\n    }\n    for (; si < lane.shadows.length; si++) lane.shadows[si].visible = false;\n    for (const e of s.events) if (e.kind === 'bonk' || e.kind === 'pine') { a.play('HeaderNod', { once: true, speed: 1.4, fade: 0.04 }); a.sq.kick(-3); }\n    if (lane !== scene.lanes[scene.playerLane]) s.events.length = 0;\n    if (a.current === 'HeaderNod' && a.action('HeaderNod').time >= a.action('HeaderNod').getClip().duration - 0.02) a.play('Idle');\n  },\n  draw(scene, hud, lane, box, big) {\n    const s = lane.sim; if (!s) return;\n    if (!big) { say(hud, box.x - 12, box.y - 4, String(Math.round(s.score)), { scale: 1, color: 'sand' }); if (s.combo >= 5) say(hud, box.x - 8, box.y + 6, `x${s.tier()}`, { color: 'lime' }); }\n  },\n  score: (s) => s.final(),\n};\nexport class HeaderScene extends ActivityScene {\n  makeSim(ctx, lane) { return new HeaderSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`head-${lane.solo ? 'solo' : lane.i}-${this.simN = (this.simN ?? 0) + 1}`), { width: lane.who === 'player' ? 2 : 0.8 }); }\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.6, 8.8], target: [0, 1.45, 0], fov: 32 }; }\n  makeShadow(ctx) { return makeBlob(ctx); }\n  async buildStage(ctx) {\n    await this.buildLanes(ctx, 'lagoon', { coach: false });\n    // Solo: you get the whole sand. Classmates stay on their own narrow lanes at the edge.\n    const [a, me, b] = this.lanes;\n    a.x = -3.6; b.x = 3.6; a.avatar.setAt(-3.6, 0, 0.8); b.avatar.setAt(3.6, 0, 0.8);\n    for (const l of this.lanes) headerView.enter(this, l);\n    this.dennis = await makeAvatar(ctx, CAST_LOOKS.dennis); this.dennis.setAt(0, 0, -7);\n    this.catapult = place(ctx, 'catapult', 1.4, 0, -7, { actors: true });\n    a.avatar.root.visible = true;\n    ctx.particles.register('coco', { count: [6, 9], life: [0.25, 0.5], speed: [2, 4], gravity: 10, size: [1, 2], colors: ['white', 'sand', 'plum'] });\n    ctx.particles.register('sweat', { count: [3, 5], life: [0.3, 0.5], speed: [1.5, 3], gravity: 8, size: [1, 1], colors: ['cyan', 'white'] });\n    void me;\n  }\n  cardInfo() { return { goal: 'Head the coconuts. Dodge the flip-flops.', prompts: [['lean', 'Lean left, right']] }; }\n  view(ctx, dt) {\n    const l = this.lanes[1], s = l.sim;\n    const evs = s.events.slice();\n    for (const q of this.lanes) headerView.update(this, q, dt);\n    s.events.length = 0;\n    for (const e of evs) {\n      if (e.kind === 'bonk') { App.sfx('bonk', { pitch: Math.min(12, s.tier() * 2) }); ctx.engine.hitstop(0.05); ctx.particles.burst('coco', [l.x + e.x, 1.8, l.z]); this.dennisHit = 0.5; if (s.combo === 5 || s.combo === 10 || s.combo === 20) App.sfx('combo'); }\n      if (e.kind === 'pine') { App.sfx('pineapple'); ctx.particles.burst('sparkle', [l.x + e.x, 1.8, l.z], { count: 18, colors: ['sand', 'white'] }); }\n      if (e.kind === 'thwap') { App.sfx('thwap'); ctx.engine.shake.add(0.25); if (!App.bark) App.barkLine('A flip-flop. It was not personal. It was Dennis.', 'ounce', 1.8); }\n      if (e.kind === 'launch') { App.sfx('catapult'); this.catT = 0.25; }\n    }\n    this.dennis.update(dt);\n    if (this.dennisHit > 0) { this.dennisHit -= dt; if (this.dennis.current !== 'Hurt') this.dennis.play('Hurt', { once: true, fade: 0.05 }); }\n    else if (this.dennis.current === 'Hurt') this.dennis.play('Idle');\n    const arm = this.catapult.object.getObjectByName('arm');\n    if (arm) { this.catT = Math.max(0, (this.catT ?? 0) - dt); arm.rotation.x = this.catT > 0 ? -1.2 : 0; }\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[1].sim;\n    App.dialCenter.x = hud.width / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), s.combo >= 5 ? `Combo x${s.tier()}` : `${Math.max(0, Math.ceil(s.seconds - s.t))} s`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Lean'], ['pause', 'Pause']]);\n    void center;\n  }\n}\nexport function makeBlob(ctx) {\n  const { THREE, ContactShadow } = App.__engine;\n  void THREE;\n  const s = new ContactShadow(0.35); ctx.scene.add(s); s.place = s.place.bind(s);\n  return s;\n}\nE\necho \"- [x] lane sims: poses reps hoop step header\" >> PROGRESS.md","description":"Write the five lane activities"}}}
