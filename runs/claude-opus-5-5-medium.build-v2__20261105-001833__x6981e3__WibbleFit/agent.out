{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjQJ2NkQB4vhvoQY3Pc9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PcaZGdFgje2yEUNqNTLPnw","name":"Bash","input":{"command":"python3 - <<'E'\nimport re\np='src/scenes/activity/step.js';s=open(p).read()\ns=s.replace(\"import { App } from '../../app.js';\\nimport { place }\",\"import { App } from '../../app.js';\\nimport { SONGS } from '../../audio/songs.js';\\nimport { place }\")\ns=s.replace(\"    const { SONGS } = App.__songs;\\n\",\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/header.js';s=open(p).read()\ns=s.replace(\"import { App } from '../../app.js';\\nimport { makeAvatar }\",\"import { ContactShadow } from '../../../pixel-engine.js';\\nimport { App } from '../../app.js';\\nimport { makeAvatar }\")\ns=s[:s.index(\"export function makeBlob\")]+\"export function makeBlob(ctx) { const s = new ContactShadow(0.35); ctx.scene.add(s); return s; }\\n\"\ns=s.replace(\"a.x = -3.6; b.x = 3.6; a.avatar.setAt(-3.6, 0, 0.8); b.avatar.setAt(3.6, 0, 0.8);\",\"a.x = -3.3; b.x = 3.3; a.avatar.setAt(-3.3, 0, 0.8); b.avatar.setAt(3.3, 0, 0.8);\")\nopen(p,'w').write(s)\nE\ncat > src/scenes/activity/slackline.js <<'E'\n// 5.6 Slackline. X is balance, forward is progress. Walking is less stable, so stopping is a choice.\nimport { PALETTE, RippleField, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, place, sea, sky } from '../../art/stage.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nexport const SLACK_LENGTH = 30, SLACK_LIMIT = 75;\nexport class SlackSim {\n  t = 0; z = 0; falls = 0; done = false; finished = false; fallT = 0; next = 6; gust = 0; gustDir = 0; warn = 0; warnDir = 0; events = []; walking = false; kevin = false; checkpoint = 0; score = 0;\n  constructor(cfg, env, rng) { this.cfg = cfg; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next()); }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= SLACK_LIMIT) { this.done = true; return; }\n    if (this.fallT > 0) {\n      this.fallT -= dt;\n      if (this.fallT <= 0) { this.z = this.checkpoint; this.dot.x = 0; this.dot.vx = 0; this.dot.ux = 0; this.gust = 0; this.warn = 0; this.next = this.z + 6; this.events.push('back'); }\n      return;\n    }\n    this.checkpoint = this.z >= 20 ? 20 : this.z >= 10 ? 10 : 0;\n    this.walking = u.y > 0.3;\n    if (this.walking) this.z += 1.1 * dt;\n    if (this.z >= this.next && this.warn <= 0 && this.gust <= 0) { this.warn = 1.5; this.warnDir = this.rng.next() < 0.5 ? -1 : 1; this.next += 6; this.events.push('warn'); }\n    if (this.warn > 0) { this.warn -= dt; if (this.warn <= 0) { this.gust = 1; this.gustDir = this.warnDir; this.events.push('gust'); } }\n    if (this.gust > 0) this.gust -= dt;\n    this.kevin = this.z >= 18 && this.z < 24;\n    if (this.kevin && !this.kevinSaid) { this.kevinSaid = true; this.events.push('kevin'); }\n    const instE = (this.walking ? T.slackWalkInst * (this.cfg.walkInst ?? 1) : 1.2) / T.dotInstability;\n    const m = { inst: instE, noise: 1.25 * this.env.noiseMul, bx: (this.gust > 0 ? this.gustDir * T.gustForce : 0) + (this.kevin ? 0.35 : 0) };\n    this.dot.step(dt, u.x, 0, T, m);\n    this.dot.y = 0; this.dot.vy = 0;\n    if (this.env.god) this.dot.x = Math.max(-0.6, Math.min(0.6, this.dot.x));\n    if (Math.abs(this.dot.x) > 1) { this.falls++; this.fallT = 1.2; this.events.push('fall'); }\n    if (this.z >= SLACK_LENGTH) { this.finished = true; this.done = true; this.events.push('finish'); }\n    this.score = this.compute();\n  }\n  compute() { return this.finished ? Math.max(0, Math.round(1000 - 60 * this.falls - 8 * (this.t - 27))) : Math.round((this.z / SLACK_LENGTH) * 300); }\n  result() {\n    const stars = !this.finished ? 0 : this.falls === 0 && this.t < 32 ? 3 : this.falls <= 1 && this.t < 45 ? 2 : 1;\n    return { score: this.compute(), stars, stats: { falls: this.falls, seconds: Math.round(this.t) } };\n  }\n  bot(driver, out, dt) {\n    const d = this.dot;\n    driver.brain.lean({ x: d.x, y: 0, vx: d.vx, vy: 0 }, 0, 0, dt, out);\n    out.y = Math.abs(d.x) < 0.45 && driver.skill.err < 1.2 ? 1 : driver.skill.err >= 1.2 ? (Math.abs(d.x) < 0.3 ? 1 : 0) : 0;\n    out.x = Math.max(-1, Math.min(1, out.x));\n  }\n}\nexport class SlacklineScene extends ActivityScene {\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.1, 5], target: [0, 2.2, -4], fov: 42 }; }\n  makeSim(ctx, lane) { return new SlackSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`slack-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    sky(ctx);\n    ctx.physics.addStaticBox({ position: [0, -3, -15], halfExtents: [20, 0.5, 40] });\n    this.ripples = new RippleField({ size: [30, 50], cells: [90, 150], at: [0, -15] });\n    this.water = sea(ctx, 160, 160, -0.25, 0, -30);\n    this.ripW = this.water;\n    place(ctx, 'slack-anchor', 0, -0.2, 2.2); place(ctx, 'slack-anchor', 0, -0.2, -SLACK_LENGTH - 1.5);\n    box(ctx, 0, -0.1, 7, 14, 0.4, 9, 'sand', { shadow: false });\n    box(ctx, 0, -0.1, -SLACK_LENGTH - 5, 18, 0.4, 7, 'sand', { shadow: false });\n    place(ctx, 'palm', -5, 0, -SLACK_LENGTH - 4); place(ctx, 'palm', 4.5, 0, -SLACK_LENGTH - 5, { turn: 70 });\n    place(ctx, 'kettlebell-volcano', -22, -1, -66, { scale: 1.2 }); place(ctx, 'foam-roller-hill', 24, -1, -58, { scale: 1.1 });\n    for (const z of [10, 20]) { box(ctx, 1.4, 0.4, -z, 0.3, 1.4, 0.3, 'orange'); box(ctx, 1.75, 0.9, -z, 0.5, 0.3, 0.06, 'lime'); box(ctx, -1.4, 0.4, -z, 0.3, 1.4, 0.3, 'orange'); }\n    // Flags: they telegraph the wind.\n    this.flags = [];\n    for (let z = 6; z < SLACK_LENGTH; z += 6) { box(ctx, -1.9, 1, -z, 0.14, 2.6, 0.14, 'white'); const f = new Mesh(new BoxGeometry(0.9, 0.5, 0.05), toonMaterial(PALETTE.red)); f.position.set(-1.45, 2.1, -z); ctx.scene.add(f); this.flags.push(f); }\n    const mat = toonMaterial(PALETTE.orange);\n    this.segs = Array.from({ length: 24 }, () => { const m = new Mesh(new BoxGeometry(0.1, 0.1, 1), mat); ctx.scene.add(m); return m; });\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    avatar.play('Balance');\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, x: 0, z: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.kevinB = place(ctx, 'kevin', 0, -9, 0, { actors: true, scale: 0.9 });\n    ctx.particles.register('splash', { count: [40, 60], life: [0.5, 1.1], speed: [3, 6], gravity: 12, size: [1, 3], colors: ['white', 'cyan', 'sky'], spread: 55, direction: [0, 1, 0], radius: 0.5 });\n    ctx.particles.register('gustline', { count: [1, 2], life: [0.4, 0.7], speed: [8, 12], direction: [1, 0, 0], spread: 8, size: [1, 1], colors: ['white', 'mist'] });\n    this.gl = new Vector3();\n  }\n  cardInfo() { return { goal: 'Push forward to walk. Balance left and right. Cross.', prompts: [['lean', 'Forward: walk. Sideways: balance']] }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const sag = (z, x = 0) => 2.1 - 0.5 * Math.exp(-((z - s.z) ** 2) / 7);\n    const y = sag(s.z);\n    const falling = s.fallT > 0;\n    if (!falling) {\n      a.root.position.set(s.dot.x * 0.3, y + 0.04, -s.z);\n      a.root.rotation.y = Math.PI;\n      a.lean.x = -s.dot.x; a.lean.y = 0; a.trem = Math.abs(s.dot.x) > 0.6 ? 1 : 0;\n      a.play(s.walking ? 'Walk' : 'Balance', { speed: 0.5 });\n      if (ctx.engine.timeScale !== App.devTimeScale && !App.top()) ctx.engine.timeScale = App.devTimeScale;\n    } else {\n      const f = 1.2 - s.fallT;\n      a.root.position.y = Math.max(-1, y - 2.2 * f * f * 2);\n      a.root.position.x += s.dot.x * dt * 0.4;\n      a.play('SkyFlail');\n      if (!this.splashed && a.root.position.y < 0) { this.splashed = true; App.sfx('splash'); ctx.particles.burst('splash', [a.root.position.x, 0, a.root.position.z]); ctx.engine.shake.add(0.2); }\n    }\n    a.groundY = -0.2;\n    // Sag the line under your feet.\n    this.segs.forEach((m, i) => {\n      const z0 = (i / 24) * (SLACK_LENGTH + 2) - 1, z1 = ((i + 1) / 24) * (SLACK_LENGTH + 2) - 1, y0 = sag(z0), y1 = sag(z1);\n      m.position.set(0, (y0 + y1) / 2, -(z0 + z1) / 2); m.scale.z = Math.hypot(z1 - z0, y1 - y0) + 0.02; m.rotation.x = Math.atan2(y1 - y0, z1 - z0);\n    });\n    // Camera low behind you.\n    const c = ctx.camera.camera; c.position.set(s.dot.x * 0.2, 2.5, -s.z + 5.2); c.lookAt(0, 2.2, -s.z - 6); this.target.set(0, 2, -s.z);\n    for (const f of this.flags) { f.scale.x = s.warn > 0 ? 1.2 : 0.8; f.position.x = -1.45 + (s.warn > 0 ? s.warnDir * 0.0 : 0); f.rotation.y = s.warn > 0 ? (s.warnDir > 0 ? 0 : Math.PI) : Math.sin(ctx.time * 3 + f.position.z) * 0.3; }\n    for (const e of s.events.splice(0)) {\n      if (e === 'warn' && !App.bark) App.barkLine(s.warnDir > 0 ? 'Wind from the left. It is rude.' : 'Wind from the right. It is rude.', 'coach', 1.4);\n      if (e === 'gust') App.sfx('gust');\n      if (e === 'fall') { ctx.engine.timeScale = 0.35; this.splashed = false; App.barkLine(this.cosmetic.pick(BARKS.fall), 'ounce', 2); }\n      if (e === 'kevin') { App.sfx('squawk'); App.barkLine('Kevin has landed on you. He is staff.', 'ounce', 2.2); }\n      if (e === 'finish') { App.sfx('fanfare'); a.play('Victory', { once: true }); }\n    }\n    if (s.warn > 0 || s.gust > 0) { this.gl.set(this.cosmetic.range(-5, 5), this.cosmetic.range(1, 3), -s.z - this.cosmetic.range(1, 8)); ctx.particles.burst('gustline', this.gl, { direction: [s.warnDir || s.gustDir, 0, 0] }); }\n    const k = this.kevinB.object;\n    if (s.kevin && !falling) { k.position.set(a.root.position.x, y + 1.64, -s.z); k.rotation.y = Math.PI; } else if (!s.kevin) k.position.y = -9;\n    this.water?.update(ctx.time);\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 54;\n    dial(hud, W / 2, 54, 38, { ringR: 1, x: s.dot.x, y: 0, inside: Math.abs(s.dot.x) < 0.45 });\n    bar(hud, 12, 34, W - 24, 6, s.z / SLACK_LENGTH, 'lime');\n    for (const m of [10, 20]) hud.rect(12 + (m / SLACK_LENGTH) * (W - 24), 32, 2, 10, 'sand');\n    this.drawTopBar(hud, `${s.z.toFixed(1)} m`, `${Math.max(0, Math.ceil(SLACK_LIMIT - s.t))} s  Falls ${s.falls}`);\n    if (s.warn > 0) center(hud, 100, s.warnDir > 0 ? 'Wind >>>' : '<<< Wind', { scale: 2, color: 'orange' });\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', s.walking ? 'Walking' : 'Forward to walk'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/tray.js <<'E'\n// 5.7 Vitamin Tray. Tilt gravity, not the tray. Colliders stay flat; a visual group tilts.\nimport { PALETTE, RAPIER, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, sea, sky } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { BOARDS } from '../../data/boards.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nconst { BoxGeometry, CylinderGeometry, Group, Mesh, SphereGeometry } = THREE;\nconst CELL = 0.72;\nconst COLORS = { R: 'red', B: 'blue', Y: 'sand' };\nconst RAD = Math.PI / 180;\nexport class TraySim {\n  t = 0; score = 0; done = false; events = []; ux = 0; uy = 0; sunk = 0; balls = []; cups = []; dropped = 0;\n  constructor(cfg, env, rng, scene, boardIndex) { this.cfg = cfg; this.env = env; this.rng = rng; this.scene = scene; this.board = BOARDS[boardIndex]; this.seconds = cfg.seconds ?? 60; this.maxS = 80; }\n  maxScore() { return this.maxS; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds || this.sunk >= this.balls.length) { this.done = true; return; }\n    const k = Math.min(1, dt / 0.12);\n    this.ux += (u.x - this.ux) * k; this.uy += (u.y - this.uy) * k;\n    const tilt = T.trayMaxTilt * RAD, g = T.trayGravity;\n    const w = this.scene.ctx.physics.world;\n    w.gravity = { x: Math.sin(tilt * this.ux) * g, y: -g * Math.cos(tilt * Math.hypot(this.ux, this.uy)), z: -Math.sin(tilt * this.uy) * g };\n    for (const b of this.balls) {\n      if (b.sunk) continue;\n      if (b.respawn > 0) { b.respawn -= dt; if (b.respawn <= 0) this.scene.respawn(b); continue; }\n      const p = b.body.translation(), v = b.body.linvel();\n      b.x = p.x; b.z = p.z; b.vx = v.x; b.vz = v.z;\n      if (p.y < -1.5) { this.score = Math.max(0, this.score - 1); this.dropped++; b.respawn = 3; this.scene.hideBall(b); this.events.push({ kind: 'drop', b }); continue; }\n      for (const c of this.cups) {\n        const d = Math.hypot(p.x - c.x, p.z - c.z), slow = Math.hypot(v.x, v.z) < 2.4;\n        if (d < CELL * 0.55 && slow) {\n          if (c.color === b.color) { b.sunk = true; this.sunk++; this.score += 10; this.scene.hideBall(b); this.events.push({ kind: 'good', b, c }); }\n          else { this.score = Math.max(0, this.score - 3); b.respawn = 1; this.scene.hideBall(b); this.events.push({ kind: 'bad', b, c }); }\n          break;\n        }\n      }\n    }\n  }\n  final() { return this.score; }\n  result() { return { score: this.score, max: this.maxS, stats: { sunk: this.sunk, dropped: this.dropped } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    let ball = this.balls.find((b) => b.id === driver.focus && !b.sunk && !(b.respawn > 0));\n    if (!ball) { ball = this.balls.find((b) => !b.sunk && !(b.respawn > 0) && b.x !== undefined); driver.focus = ball?.id; driver.since = this.t; }\n    if (!ball) return;\n    const cup = this.cups.filter((c) => c.color === ball.color).sort((a, b) => Math.hypot(a.x - ball.x, a.z - ball.z) - Math.hypot(b.x - ball.x, b.z - ball.z))[0];\n    if (!cup) return;\n    if (this.t - driver.since > 12) { driver.focus = null; }\n    const kp = 0.35 * (0.6 + sk.kp * 0.4), kd = 0.28;\n    const jx = Math.sin(this.t * 1.7) * (1.5 - sk.hit) * 0.6, jz = Math.cos(this.t * 2.3) * (1.5 - sk.hit) * 0.6;\n    out.x = Math.max(-1, Math.min(1, kp * (cup.x - ball.x) - kd * ball.vx + jx * 0.4));\n    out.y = Math.max(-1, Math.min(1, -(kp * (cup.z - ball.z) - kd * ball.vz + jz * 0.4)));\n  }\n}\nexport class TrayScene extends ActivityScene {\n  cameraConfig() { return { preset: 'fixed', position: [0, 11.5, 6.4], target: [0, 0, 0.2], fov: 34 }; }\n  makeSim(ctx, lane) {\n    if (this.boardIndex === undefined) { const plays = (App.slot?.records ?? App.save.data.dropIn).tray?.plays ?? 0; this.boardIndex = this.hard ? 2 : App.attract ? 1 : plays % BOARDS.length; }\n    const sim = new TraySim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`tray-${this.simN = (this.simN ?? 0) + 1}`), this, this.boardIndex);\n    if (this.laid) this.layBalls(ctx, sim);\n    return sim;\n  }\n  onResetSims() {}\n  async buildStage(ctx) {\n    sky(ctx); this.ctx = ctx;\n    sea(ctx, 80, 60, -2.2, 0, -14);\n    box(ctx, 0, -2.3, 3, 40, 0.2, 18, 'sand', { shadow: false });\n    this.group = new Group(); ctx.scene.add(this.group);\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', driver: this.localDriver(ctx), name: 'You' });\n    this.boardIndex = undefined;\n    this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.buildBoard(ctx, this.lanes[0].sim.board);\n    this.laid = true;\n    this.layBalls(ctx, this.lanes[0].sim);\n    ctx.physics.world.gravity = { x: 0, y: -T.trayGravity, z: 0 };\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.setAt(-6.4, -2.2, 0, 0.8); this.coach.groundY = -2.2;\n    ctx.particles.register('fizz', { count: [8, 12], life: [0.3, 0.6], speed: [1, 2.5], gravity: 4, size: [1, 1], colors: ['white', 'lime'] });\n  }\n  buildBoard(ctx, board) {\n    const rows = board.rows, R = rows.length, C = rows[0].length;\n    this.W = C * CELL; this.D = R * CELL;\n    const lac = toonMaterial(PALETTE.red), rail = toonMaterial(PALETTE.plum);\n    const floor = new Mesh(new BoxGeometry(this.W, 0.2, this.D), toonMaterial(PALETTE.white)); floor.position.y = -0.1; floor.receiveShadow = true; this.group.add(floor);\n    const under = new Mesh(new BoxGeometry(this.W + 0.6, 0.2, this.D + 0.6), lac); under.position.y = -0.3; this.group.add(under);\n    const addStatic = (x, y, z, hx, hy, hz) => { const b = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x, y, z)); ctx.physics.world.createCollider(RAPIER.ColliderDesc.cuboid(hx, hy, hz).setFriction(0.2).setRestitution(0.25), b); };\n    addStatic(0, -0.1, 0, this.W / 2, 0.1, this.D / 2);\n    const starts = []; const cups = [];\n    rows.forEach((row, j) => [...row].forEach((ch, i) => {\n      const x = (i - (C - 1) / 2) * CELL, z = (j - (R - 1) / 2) * CELL;\n      if (ch === '#') { addStatic(x, 0.25, z, CELL / 2, 0.25, CELL / 2); const m = new Mesh(new BoxGeometry(CELL, 0.5, CELL), rail); m.position.set(x, 0.25, z); m.castShadow = true; this.group.add(m); }\n      if (ch === 'o') starts.push([x, z]);\n      if (COLORS[ch]) {\n        cups.push({ x, z, color: ch });\n        const m = new Mesh(new CylinderGeometry(CELL * 0.52, CELL * 0.52, 0.04, 12), toonMaterial(PALETTE[COLORS[ch]])); m.position.set(x, 0.02, z); this.group.add(m);\n        const n = new Mesh(new CylinderGeometry(CELL * 0.34, CELL * 0.34, 0.05, 12), toonMaterial(PALETTE.ink)); n.position.set(x, 0.03, z); this.group.add(n);\n      }\n    }));\n    // A gap in the floor where the rail is missing: no collider, so a vitamin falls off the edge.\n    this.starts = starts; this.cupDefs = cups;\n    this.colours = [...new Set(cups.map((c) => c.color))];\n  }\n  layBalls(ctx, sim) {\n    sim.cups = this.cupDefs;\n    if (this.ballObjs) {\n      sim.balls = this.ballObjs; sim.balls.forEach((b, i) => { b.sunk = false; b.respawn = 0; b.mesh.visible = true; this.placeBall(b, i); });\n      return;\n    }\n    const geo = new SphereGeometry(0.24, 8, 6);\n    sim.balls = this.starts.slice(0, 8).map(([x, z], i) => {\n      const color = this.colours[i % this.colours.length];\n      const body = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 0.3, z).setLinearDamping(0.5).setAngularDamping(0.6).setCcdEnabled(true));\n      ctx.physics.world.createCollider(RAPIER.ColliderDesc.ball(0.24).setRestitution(0.2).setFriction(0.3).setDensity(2), body);\n      const mesh = new Mesh(geo, toonMaterial(PALETTE[COLORS[color]])); mesh.castShadow = true; this.group.add(mesh);\n      return { id: i, x, z, vx: 0, vz: 0, color, body, mesh, sunk: false, respawn: 0, home: [x, z] };\n    });\n    this.ballObjs = sim.balls;\n  }\n  placeBall(b) { b.body.setTranslation({ x: b.home[0], y: 0.3, z: b.home[1] }, true); b.body.setLinvel({ x: 0, y: 0, z: 0 }, true); b.body.setEnabled?.(true); }\n  hideBall(b) { b.mesh.visible = false; b.body.setEnabled?.(false); if (!b.body.setEnabled) b.body.setTranslation({ x: 0, y: -50, z: 0 }, true); }\n  respawn(b) { b.mesh.visible = true; b.body.setEnabled?.(true); this.placeBall(b); }\n  dispose(ctx) { if (ctx?.physics?.world) ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n  cardInfo() { return { goal: 'Tilt the tray. Roll each vitamin into its own colour.', prompts: [['lean', 'Tilt']] }; }\n  onOutro(ctx) { ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim;\n    if (this.phase === 'intro' || this.phase === 'countdown') ctx.physics.world.gravity = { x: 0, y: -T.trayGravity, z: 0 };\n    const tilt = T.trayMaxTilt * RAD;\n    this.group.rotation.z = -tilt * s.ux; this.group.rotation.x = -tilt * s.uy;\n    for (const b of s.balls) if (b.mesh.visible) { const p = b.body.translation(); b.mesh.position.set(p.x, p.y, p.z); }\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'good') { App.sfx('chimeIn'); ctx.particles.burst('fizz', [e.c.x, 0.3, e.c.z]); if (!App.bark && this.cosmetic.chance(0.3)) App.barkLine('Good. That one is where it belongs.', 'ounce', 1.6); }\n      if (e.kind === 'bad') { App.sfx('wobble'); App.barkLine('That is the wrong cup. It will have to go back.', 'ounce', 1.8); }\n      if (e.kind === 'drop') { App.sfx('thwap'); }\n    }\n    this.coach?.update(dt);\n  }\n  updateAvatars() {}\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim;\n    App.dialCenter.x = hud.width / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, s.score, `${s.board.name}  ${Math.max(0, Math.ceil(s.seconds - s.t))} s  ${s.sunk}/${s.balls.length}`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Tilt'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/jog.js <<'E'\n// 5.8 Island Jog. A rail run around the whole island. Alternate left and right.\nimport { THREE, Trail } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { buildIsland, JOG_POINTS } from '../../art/island.js';\nimport { place } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst { CatmullRomCurve3, Vector3 } = THREE;\nexport function makePath() {\n  const curve = new CatmullRomCurve3(JOG_POINTS.map(([x, z]) => new Vector3(x, 0, z)), true, 'catmullrom', 0.5);\n  curve.arcLengthDivisions = 800;\n  return { curve, length: curve.getLength() };\n}\nexport class JogSim {\n  s = 0; t = 0; lat = 0; cad = 0; speed = 0; side = null; stumble = 0; stitch = 0; over = 0; inBandT = 0; cups = 0; done = false; events = []; lastStep = -9; coachS = 4; limit = 120; score = 0;\n  constructor(cfg, env, rng, length) {\n    this.cfg = cfg; this.env = env; this.rng = rng; this.length = length;\n    this.cupList = Array.from({ length: 18 }, (_, i) => ({ s: ((i + 1) / 19) * length, lat: (rng.next() * 2 - 1) * 1.2, got: false }));\n    this.hazards = Array.from({ length: 12 }, (_, i) => ({ s: ((i + 0.5) / 12) * length + rng.next() * 3, lat: (rng.next() * 2 - 1) * 1.2, kind: ['sprinkler', 'picnic', 'dennis', 'kevin'][i % 4], hit: false }));\n  }\n  get target() { return 3 * (this.cfg.speed ?? 1); }\n  band() { const c = T.jogTargetCadence * (this.cfg.speed ?? 1); return [c * 0.8, c * 1.2]; }\n  step(dt, u) {\n    this.t += dt;\n    if (u.stepL || u.stepR) {\n      const f = u.stepL ? 'L' : 'R';\n      if (f === this.side) { this.stumble = 0.5; this.events.push('stumble'); }\n      else { const dtStep = this.t - this.lastStep; if (dtStep > 0.02) { const inst = 1 / dtStep; this.cad += (inst - this.cad) * 0.45; } this.lastStep = this.t; this.events.push('foot'); }\n      this.side = f;\n    }\n    if (this.t - this.lastStep > 0.6) this.cad = Math.max(0, this.cad - 4 * dt);\n    if (this.env.god) { this.cad = T.jogTargetCadence * (this.cfg.speed ?? 1); this.stumble = 0; this.stitch = 0; }\n    const [low, high] = this.band();\n    if (this.cad > high) { this.over += dt; if (this.over > 2 && this.stitch <= 0) { this.stitch = 3; this.over = 0; this.events.push('stitch'); } } else this.over = 0;\n    const mul = this.stitch > 0 ? 0.5 : 1;\n    this.stitch = Math.max(0, this.stitch - dt);\n    this.stumble = Math.max(0, this.stumble - dt);\n    const tgt = this.stumble > 0 ? 0 : this.target * (this.cad / (T.jogTargetCadence * (this.cfg.speed ?? 1))) * mul;\n    this.speed += (Math.min(tgt, this.target * 1.25) - this.speed) * Math.min(1, dt * 5);\n    this.s += this.speed * dt;\n    if (this.cad >= low && this.cad <= high && this.stumble <= 0) this.inBandT += dt;\n    this.lat = Math.max(-1.5, Math.min(1.5, this.lat + u.x * 3 * dt));\n    // Coach paces you at exactly target speed; more than 12 m behind, she waits.\n    if (this.coachS - this.s < 12) this.coachS += this.target * dt;\n    for (const c of this.cupList) if (!c.got && Math.abs(c.s - this.s) < 0.9 && Math.abs(c.lat - this.lat) < 0.8) { c.got = true; this.cups++; this.events.push('cup'); }\n    for (const h of this.hazards) if (!h.hit && Math.abs(h.s - this.s) < 0.7 && Math.abs(h.lat - this.lat) < 0.55 && !this.env.god) { h.hit = true; this.stumble = 0.5; this.events.push(`hit:${h.kind}`); }\n    this.score = this.compute();\n    if (this.s >= this.length || this.t >= this.limit) this.done = true;\n  }\n  compute() { const dur = Math.max(this.length / this.target, this.t); return 70 * Math.min(1, this.inBandT / dur) * (1 / 1) + 30 * (this.cups / 18); }\n  final() { return this.compute(); }\n  result() { return { score: Math.round(this.compute()), stats: { cups: this.cups, seconds: Math.round(this.t) } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    if (driver.nextStep === undefined) driver.nextStep = this.t + 0.3;\n    if (this.t >= driver.nextStep) {\n      const c = T.jogTargetCadence * (this.cfg.speed ?? 1);\n      const bad = driver.rng.next() < sk.mistake * 0.2;\n      const foot = (this.side === 'L') !== bad ? 'R' : 'L';\n      if (foot === 'L') out.stepL = true; else out.stepR = true;\n      driver.nextStep = this.t + (1 / c) * (1 + (driver.rng.next() - 0.5) * sk.jitter * 6) * (sk.name === 'sloppy' ? 1.35 : 1);\n    }\n    let tl = 0, best = 12;\n    for (const cu of this.cupList) { const d = cu.s - this.s; if (!cu.got && d > 0.3 && d < best) { best = d; tl = cu.lat; } }\n    for (const h of this.hazards) { const d = h.s - this.s; if (!h.hit && d > 0 && d < 5 && Math.abs(h.lat - tl) < 0.6) tl = h.lat > 0 ? h.lat - 0.9 : h.lat + 0.9; }\n    out.x = Math.max(-1, Math.min(1, (tl - this.lat) * 2.5 * (sk.hit)));\n  }\n}\nexport class JogScene extends ActivityScene {\n  cameraConfig() { return { preset: 'iso', zoom: 1.4 }; }\n  makeSim(ctx, lane) { return new JogSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`jog-${this.simN = (this.simN ?? 0) + 1}`), this.path.length); }\n  async buildStage(ctx) {\n    this.path = makePath();\n    this.world = await buildIsland(ctx, { jog: true });\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    const sim = this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.play('Sit');\n    this.scooter = place(ctx, 'mobility-scooter', 0, 0, 0, { actors: true });\n    this.trail = new Trail({ width: 0.3, life: 0.6, points: 32, color: 0x73eff7, tail: 0xf4f4f4 }); ctx.scene.add(this.trail);\n    this.cupObjs = sim.cupList.map((c) => { const b = place(ctx, 'water-cup', 0, 0, 0); this.putOn(b.object, c.s, c.lat); return b.object; });\n    this.hazObjs = sim.hazards.map((h) => {\n      const id = { sprinkler: 'sprinkler', picnic: 'picnic', dennis: null, kevin: 'kevin' }[h.kind];\n      if (id) { const b = place(ctx, id, 0, 0, 0); this.putOn(b.object, h.s, h.lat); return b.object; }\n      return null;\n    });\n    this.dennisA = await makeAvatar(ctx, CAST_LOOKS.dennis);\n    const dh = sim.hazards.find((h) => h.kind === 'dennis'); this.putOn(this.dennisA.root, dh.s, dh.lat); this.dennisA.play('Daze');\n    ctx.particles.register('sweat', { count: [2, 4], life: [0.25, 0.45], speed: [1, 2.5], gravity: 8, size: [1, 1], colors: ['cyan', 'white'] });\n    this.p = new Vector3(); this.tan = new Vector3();\n  }\n  putOn(obj, s, lat) {\n    const u = Math.min(0.9999, Math.max(0, (s % this.path.length) / this.path.length));\n    const p = this.path.curve.getPointAt(u), t = this.path.curve.getTangentAt(u);\n    obj.position.set(p.x + t.z * lat, 0.02, p.z - t.x * lat); obj.rotation.y = Math.atan2(t.x, t.z);\n    return { p, t };\n  }\n  cardInfo() { return { goal: 'Alternate your feet. Keep up with the scooter. Take the water.', prompts: [['feet', 'Left, right'], ['lean', 'Move across the path']] }; }\n  onResetSims(ctx) { const s = this.lanes[0].sim; this.cupObjs.forEach((o, i) => { o.visible = true; this.putOn(o, s.cupList[i].s, s.cupList[i].lat); }); }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const { p } = this.putOn(a.root, s.s, s.lat);\n    a.root.position.y = 0;\n    this.target.set(a.root.position.x, 1, a.root.position.z);\n    if (s.speed > 0.2) a.play('Jog', { speed: Math.max(0.3, s.speed / 3) }); else a.play(s.stumble > 0 ? 'Daze' : 'Idle');\n    this.putOn(this.scooter.object, s.coachS, 0); this.coach.root.position.copy(this.scooter.object.position); this.coach.root.position.y = 0.32; this.coach.root.rotation.y = this.scooter.object.rotation.y;\n    s.cupList.forEach((c, i) => { if (c.got) this.cupObjs[i].visible = false; });\n    this.coach.update(dt); this.dennisA.update(dt);\n    this.trail.push(this.v.set(a.root.position.x, 0.25, a.root.position.z), ctx.time); this.trail.update(ctx.time, ctx.camera.camera);\n    this.world.update(ctx, dt);\n    for (const e of s.events.splice(0)) {\n      if (e === 'foot') App.sfx('repTick', { volume: 0.4 });\n      if (e === 'cup') { App.sfx('jarDrip'); ctx.particles.burst('sparkle', [a.root.position.x, 1, a.root.position.z], { count: 6, colors: ['cyan', 'white'] }); }\n      if (e === 'stumble') { App.sfx('wobble'); ctx.particles.burst('dust', [a.root.position.x, 0.1, a.root.position.z]); }\n      if (e === 'stitch') App.barkLine('That is a stitch. You were told. I was going to tell you.', 'ounce', 2.4);\n      if (e.startsWith('hit:')) { App.sfx('thwap'); App.barkLine({ 'hit:sprinkler': 'A sprinkler. It was not hiding.', 'hit:picnic': 'That was someone\\'s lunch.', 'hit:dennis': 'Dennis: \"It\\'s fine. It\\'s just the one leg.\"', 'hit:kevin': 'Kevin would like a word. He has only the one.' }[e], e === 'hit:dennis' ? 'dennis' : 'ounce', 2); ctx.engine.shake.add(0.2); }\n    }\n    void p;\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width, [low, high] = s.band();\n    App.dialCenter.x = W / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), `Cups ${s.cups}/18`);\n    const gx = W / 2 - 70, gy = 28, gw = 140, mx = 5.5;\n    bar(hud, gx, gy, gw, 9, 0, 'lime');\n    hud.rect(gx + (low / mx) * gw, gy + 1, ((high - low) / mx) * gw, 7, 'green');\n    hud.rect(gx + (Math.min(mx, s.cad) / mx) * gw - 1, gy - 1, 3, 11, s.cad > high ? 'red' : 'white');\n    center(hud, gy + 12, s.stitch > 0 ? 'Stitch.' : s.stumble > 0 ? 'Stumble.' : s.coachS - s.s >= 12 ? 'She is waiting.' : 'Pace', { color: s.stitch > 0 ? 'red' : 'white' });\n    bar(hud, 12, hud.height - 26, W - 24, 5, s.s / s.length, 'lime');\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['feet', 'Left, right'], ['lean', 'Move'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/pier.js <<'E'\n// 5.9 Pier Jump. Side-on. Three attempts. Three judges with paddles.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, place, sea, sky } from '../../art/stage.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst RUN = 5, LIP_AT = 5, WIN = 0.25;\nexport class PierSim {\n  attempt = 0; t = 0; part = 'run'; speed = 6; p = 0; pressAt = null; flightT = 0; ringT = 0; cannon = false; distance = 0; best = 0; style = 0; bestStyle = 0; score = 0; done = false; events = []; scores = []; ringR = 0.45; flightLen = 3.5; waitT = 0;\n  constructor(cfg, env, rng) { this.cfg = cfg; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next()); }\n  winW() { return WIN * (this.cfg.window ?? 1); }\n  step(dt, u) {\n    this.t += dt; const d = this.dot;\n    const pressed = u.confirm;\n    if (this.part === 'run') {\n      d.step(dt, u.x, u.y, T, { noise: this.env.noiseMul });\n      if (this.env.god) { d.y = -0.6; d.x = 0; }\n      if (d.y >= -0.8 && d.y <= -0.4) this.speed = Math.min(14, this.speed + (8 / (RUN * 0.8)) * dt);\n      if (pressed && this.pressAt === null && this.t >= LIP_AT - this.winW()) { this.pressAt = this.t; }\n      if (this.env.god && this.pressAt === null && this.t >= LIP_AT) this.pressAt = LIP_AT;\n      if (this.t >= LIP_AT + this.winW() || this.pressAt !== null && this.t >= LIP_AT) {\n        this.p = this.pressAt === null ? 0 : Math.max(0, 1 - Math.abs(this.pressAt - LIP_AT) / this.winW());\n        this.part = 'flight'; this.flightT = 0; this.ringT = 0; this.cannon = false; this.flightLen = 3 + this.p;\n        d.x = 0; d.y = 0; d.vx = 0; d.vy = 0;\n        this.events.push({ kind: 'lip', p: this.p });\n      }\n    } else if (this.part === 'flight') {\n      this.flightT += dt;\n      d.step(dt, u.x, u.y, T, { inst: 3 / T.dotInstability, noise: this.env.noiseMul });\n      if (this.env.god) { d.x *= 0.5; d.y *= 0.5; }\n      if (d.dist() <= this.ringR * this.env.ringMul / T.ringScale * T.ringScale) this.ringT += dt;\n      const left = this.flightLen - this.flightT;\n      if (pressed && left <= 0.5 && !this.cannon) { this.cannon = true; this.events.push({ kind: 'cannon' }); }\n      if (this.env.god && left <= 0.3) this.cannon = true;\n      if (left <= 0) {\n        const ring = this.ringT / this.flightLen;\n        this.distance = this.speed * (0.8 + 0.6 * this.p) * (0.6 + 0.4 * ring) * T.pierBoost;\n        this.style = (this.cannon ? 30 : 0) + Math.round(40 * ring) + Math.round(30 * this.p);\n        if (this.distance > this.best) { this.best = this.distance; this.bestStyle = this.style; }\n        this.scores.push(this.distance);\n        this.part = 'splash'; this.waitT = 2.8;\n        this.events.push({ kind: 'splash', distance: this.distance, cannon: this.cannon, style: this.style });\n      }\n    } else if (this.part === 'splash') {\n      this.waitT -= dt;\n      if (this.waitT <= 0) {\n        this.attempt++;\n        if (this.attempt >= 3) { this.done = true; return; }\n        this.part = 'run'; this.t = 0; this.speed = 6; this.pressAt = null; d.x = 0; d.y = 0; d.vx = 0; d.vy = 0;\n        this.events.push({ kind: 'again' });\n      }\n    }\n    this.score = this.best;\n  }\n  final() { return this.best; }\n  result() { return { score: +this.best.toFixed(1), stats: { style: this.bestStyle } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    const ty = this.part === 'run' ? -0.6 : 0;\n    driver.brain.lean(this.dot, 0, ty, dt, out);\n    if (this.part === 'run') {\n      if (driver.pressWhen === undefined || driver.pressAttempt !== this.attempt) { driver.pressAttempt = this.attempt; driver.pressWhen = LIP_AT + (driver.rng.next() - 0.5) * sk.jitter * 3; }\n      if (this.t >= driver.pressWhen && this.pressAt === null) out.confirm = true;\n    } else if (this.part === 'flight' && this.flightLen - this.flightT <= 0.3 && driver.rng.next() < sk.hit) out.confirm = true;\n  }\n}\nconst JUDGES = [['marguerite', -4], ['june', -2.4], ['dennis', -0.8]];\nexport class PierScene extends ActivityScene {\n  cameraConfig() { return { preset: 'side', zoom: 0.9 }; }\n  makeSim(ctx) { return new PierSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`pier-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    sky(ctx);\n    ctx.physics.addStaticBox({ position: [0, -3, 0], halfExtents: [60, 0.5, 20] });\n    this.water = sea(ctx, 220, 40, -0.25, 20, -4);\n    box(ctx, -26, -0.1, 0, 30, 1.2, 20, 'sand', { shadow: false });\n    place(ctx, 'pier', -2, 0.1, 0, { turn: 90, params: { len: 26 } });\n    box(ctx, -15, 1.4, -3, 0.3, 3, 0.3, 'white'); box(ctx, -15, 3, -3, 2.6, 0.5, 0.1, 'orange');\n    place(ctx, 'palm', -22, 0.4, -3); place(ctx, 'kettlebell-volcano', 12, -1, -26, { scale: 1.1 });\n    place(ctx, 'foam-roller-hill', -42, -1, -18);\n    place(ctx, 'judge-table', 12, 0.4, -2.4, { scale: 0.9 });\n    box(ctx, 12, -0.1, -2.4, 6, 0.6, 2.6, 'orange');\n    this.judges = [];\n    for (let i = 0; i < 3; i++) {\n      const [who] = JUDGES[i];\n      const a = await makeAvatar(ctx, CAST_LOOKS[who]); a.setAt(10.6 + i * 1.4, 0.2, -2.9, 0); a.groundY = 0.2;\n      const paddle = place(ctx, 'judge-paddle', 10.6 + i * 1.4, -9, -2.2, { actors: true });\n      this.judges.push({ a, paddle: paddle.object, who, raised: 0 });\n    }\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx);\n    ctx.particles.register('splash', { count: [80, 120], life: [0.6, 1.3], speed: [4, 9], gravity: 12, size: [1, 3], colors: ['white', 'cyan', 'sky'], spread: 50, direction: [0, 1, 0], radius: 0.8, max: 400 });\n    this.px = -14; this.py = 1.25;\n  }\n  cardInfo() { return { goal: 'Run up tucked low. Press at the lip. Stay in the ring. Press before the splash.', prompts: [['lean', 'Lean: tuck, then balance'], ['press', 'Jump, then cannonball']] }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const lipX = 11 - 22;\n    if (s.part === 'run') {\n      const f = Math.min(1, s.t / LIP_AT);\n      this.px = -14 + (lipX + 22 - 11 + 11) * 0 + (11 - (-14)) * f * 0.8; this.py = 1.25;\n      a.play(s.dot.y <= -0.4 ? 'Tuck' : 'Run');\n      a.groundY = 1.2;\n    } else if (s.part === 'flight') {\n      const f = s.flightT / s.flightLen, D = s.speed * (0.8 + 0.6 * s.p) * (0.6 + 0.4 * (s.ringT / Math.max(0.1, s.flightT))) * T.pierBoost;\n      this.px = 6 + D * 0.55 * f; this.py = 1.25 + Math.sin(f * Math.PI) * (2.6 + s.p * 1.6) - f * 1.2;\n      a.play(s.cannon ? 'Cannonball' : 'SkyFlail');\n      a.groundY = -0.2;\n    } else if (s.part === 'splash') { this.py = Math.max(-1.6, this.py - dt * 3.5); }\n    a.root.position.set(this.px, this.py, 0); a.root.rotation.y = Math.PI / 2;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y;\n    this.target.set(Math.max(-6, this.px * 0.7 + 2), 3, 0);\n    for (const j of this.judges) { j.a.update(dt); if (j.raised > 0) { j.raised -= dt; j.paddle.position.y = 2.1; } else { j.paddle.position.y = -9; } }\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'lip') { App.sfx(e.p > 0.7 ? 'go' : 'countdown'); App.barkLine(e.p > 0.8 ? 'A clean take-off. I am as surprised as you.' : e.p > 0 ? 'You left the pier. Near enough.' : 'You missed the lip. You went anyway. Brave.', 'ounce', 1.6); }\n      if (e.kind === 'cannon') { App.sfx('hop'); a.sq.kick(-3); }\n      if (e.kind === 'splash') {\n        App.sfx('splash', { volume: e.cannon ? 1 : 0.6 }); ctx.engine.hitstop(0.1); ctx.engine.timeScale = 0.25; this.slow = 0.8 * 0.25;\n        ctx.particles.burst('splash', [this.px, 0, 0], { count: e.cannon ? 130 : 60 }); ctx.engine.shake.add(e.cannon ? 0.6 : 0.3);\n        if (!App.settings.reduceFlashes) ctx.engine.screen.shockwave(this.v.set(this.px, 0, 0), { radius: 0.3 });\n        for (const j of this.judges) { j.a.play('PaddleRaise', { once: true }); j.raised = 2.4; App.sfx('paddle', { pitch: 3 }); }\n        this.lastSplash = e;\n      }\n      if (e.kind === 'again') { this.px = -14; a.play('Run'); for (const j of this.judges) j.a.play('Idle'); if (!App.bark) App.barkLine(this.cosmetic.pick(BARKS.streak), 'ounce', 1.6); }\n    }\n    if (this.slow > 0) { this.slow -= dt; if (this.slow <= 0 && !App.top()) ctx.engine.timeScale = App.devTimeScale; }\n    this.water.update(ctx.time);\n    a.update(dt);\n  }\n  updateAvatars() {}\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    if (s.part === 'run') {\n      dial(hud, W / 2, 56, 34, { x: s.dot.x, y: s.dot.y, hideRing: true, target: { x: 0, y: -0.6, r: 0.24 } });\n      center(hud, 96, s.dot.y <= -0.4 && s.dot.y >= -0.8 ? 'Tucked. Speed up.' : 'Lean down to tuck.', { color: 'white' });\n      bar(hud, W / 2 - 70, 108, 140, 8, (s.speed - 6) / 8, 'lime');\n      const lf = Math.max(0, LIP_AT - s.t);\n      if (lf < 0.6) center(hud, 122, 'Press!', { scale: 2, color: 'lime' });\n    } else if (s.part === 'flight') {\n      dial(hud, W / 2, 56, 34, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.dot.dist() <= s.ringR });\n      if (s.flightLen - s.flightT <= 0.5) center(hud, 98, s.cannon ? 'Tucked!' : 'Press!', { scale: 2, color: 'lime' });\n    } else if (s.part === 'splash' && this.lastSplash) {\n      center(hud, 54, `${this.lastSplash.distance.toFixed(1)} m`, { scale: 3, color: 'sand' });\n      center(hud, 82, `Style ${this.lastSplash.style}`, { color: 'cyan' });\n    }\n    this.drawTopBar(hud, `${s.best.toFixed(1)} m`, `Jump ${Math.min(3, s.attempt + 1)} of 3`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Lean'], ['press', s.part === 'flight' ? 'Cannonball' : 'Jump'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/longstand.js <<'E'\n// 5.10 The Long Stand. Stillness scoring with a data timeline. No way to fail.\nimport { Precipitation, THREE, applySky, skyAt } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar, PlumbBob } from '../../art/avatar.js';\nimport { buildPlaza } from '../../art/island.js';\nimport { place } from '../../art/stage.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { LONG_STAND } from '../../data/poses.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nimport { PoseSim } from './poses.js';\nimport { T } from '../../core/tunables.js';\nexport class LongStandSim extends PoseSim {\n  idx = 0; kevin = false; rain = false; drift = 0; biasX = 0; noiseK = 1; fired = [];\n  constructor(env, rng, from = 0) { super({ clip: 'StandTall', ring: 0.4, hold: 90 }, env, rng); this.settle = 0; this.release = 0; this.hold = 90; this.t = from; this.from = from; this.rng2 = rng; while (this.idx < LONG_STAND.length && LONG_STAND[this.idx].t <= from && from > 0) this.apply(LONG_STAND[this.idx++], true); }\n  apply(ev, silent = false) {\n    if (ev.ring !== undefined) this.ring = ev.ring;\n    if (ev.bias !== undefined) this.biasX = ev.bias;\n    if (ev.noise !== undefined) this.noiseK = ev.noise;\n    if (ev.kevin !== undefined) this.kevin = ev.kevin;\n    if (ev.rain !== undefined) this.rain = ev.rain;\n    if (ev.impulse && !silent) this.dot.impulse(ev.impulse[0], ev.impulse[1]);\n    if (ev.randomImpulse && !silent) { const a = this.rng2.next() * 6.283; this.dot.impulse(Math.cos(a) * ev.randomImpulse, Math.sin(a) * ev.randomImpulse); }\n    if (ev.drift) this.drift = 8;\n    if (!silent) this.fired.push(ev);\n  }\n  mods() { return { noise: this.noiseK * this.env.noiseMul, bx: this.biasX * T.dotAuthority }; }\n  step(dt, u) {\n    while (this.idx < LONG_STAND.length && LONG_STAND[this.idx].t <= this.t) { const ev = LONG_STAND[this.idx++]; this.apply(ev); if (ev.end) { this.done = true; this.score = this.compute(); return; } }\n    this.drift = Math.max(0, this.drift - dt);\n    super.step(dt, u);\n    this.done = false;\n  }\n  compute() { return this.holdT > 0 ? 100 * (this.inT / Math.max(this.holdT, this.from > 0 ? this.holdT : 90)) : 0; }\n}\nexport class LongStandScene extends ActivityScene {\n  makeSim(ctx) { return new LongStandSim(App.simEnv(ctx, this.def), ctx.random.fork(`stand-${this.simN = (this.simN ?? 0) + 1}`), this.args.from ?? 0); }\n  async buildStage(ctx) {\n    this.hasPractice = false;\n    this.world = await buildPlaza(ctx);\n    applySky(ctx.engine, skyAt(17.6));\n    this.playerLane = 0;\n    const avatar = await makeAvatar(ctx, this.playerLook()); avatar.setAt(0, 0, 0.8); avatar.play('StandTall');\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx);\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.setAt(1.2, 0, -1.3); this.coach.play('StandTall'); this.bob = new PlumbBob(ctx, this.coach);\n    this.marg = await makeAvatar(ctx, CAST_LOOKS.marguerite); this.marg.setAt(-3.2, 0, -0.5, 0.5);\n    this.dennis = await makeAvatar(ctx, CAST_LOOKS.dennis); this.dennis.setAt(3.1, 0, -0.2, -0.5);\n    this.june = await makeAvatar(ctx, CAST_LOOKS.june); this.june.setAt(-1.7, 0, -1.8, 0.2); this.june.play('Sit');\n    this.ounceB = place(ctx, 'ounce', -1.3, 0, 1.6, { actors: true, scale: 1.1 }); this.ounceB.object.rotation.y = 0.4;\n    this.kevinB = place(ctx, 'kevin', 0, -9, 0, { actors: true });\n    this.rain = new Precipitation({ kind: 'rain', count: 2400, area: [24, 12, 14] }); ctx.scene.add(this.rain); this.rain.intensity = 0; this.rainGoal = 0;\n  }\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.2, 8.4], target: [0, 1.2, 0], fov: 28 }; }\n  cardInfo() { return { goal: 'Stand. Ninety seconds. Keep the dot in the circle.', prompts: [['lean', 'Lean']] }; }\n  onPlayStart(ctx) { App.music('stand'); }\n  resumeMusic() { App.music(this.lanes[0].sim.t > 75 ? 'swell' : 'stand'); return true; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y; const over = s.dot.dist() - s.ringR; a.trem = over > 0 ? Math.min(1, over * 4) : 0;\n    this.world.update(ctx, dt);\n    for (const ev of s.fired.splice(0)) {\n      if (ev.say) App.barkLine(ev.say[1], ev.say[0], 3);\n      if (ev.kevin === true) { App.sfx('squawk'); }\n      if (ev.sneeze) { this.dennis.play('Sneeze', { once: true }); App.sfx('sneeze'); }\n      if (ev.clap) { this.marg.play('SlowClap'); this.clapT = 8; }\n      if (ev.rumble) { ctx.engine.shake.add(0.7); App.sfx('rumble'); }\n      if (ev.swell) { App.music('swell'); applySky(ctx.engine, skyAt(17)); App.flash('sand', { duration: 0.4 }); }\n      if (ev.end) { App.sfx('fanfare'); this.coach.play('Bow', { once: true }); }\n    }\n    if (this.clapT > 0) { this.clapT -= dt; this.clapTick = (this.clapTick ?? 0) - dt; if (this.clapTick <= 0) { this.clapTick = 1.33; App.sfx('clap'); } if (this.clapT <= 0) this.marg.play('Idle'); }\n    this.rainGoal = s.rain ? 0.8 : 0; this.rain.intensity += (this.rainGoal - this.rain.intensity) * Math.min(1, dt); this.rain.update(dt, this.target);\n    const k = this.kevinB.object;\n    if (s.kevin) { k.position.set(a.root.position.x, 1.62, 0.8); const w = Math.sin(ctx.time * 3) > 0.9 ? 0.6 : 0; k.getObjectByName('wingL') && (k.getObjectByName('wingL').rotation.z = w); k.getObjectByName('wingR') && (k.getObjectByName('wingR').rotation.z = -w); } else k.position.y = -9;\n    const needle = this.ounceB.object.getObjectByName('needle'); if (needle) needle.rotation.y = Math.PI + Math.sin(ctx.time * 7) * (s.t > 75 ? 0.4 : 0.1);\n    const c = ctx.camera.camera; if (c.isPerspectiveCamera) { c.fov = 28 - Math.min(8, s.t * 0.09); c.updateProjectionMatrix(); }\n    this.marg.update(dt); this.dennis.update(dt); this.june.update(dt);\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    dial(hud, W / 2, 56, 44, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.inside, glow: s.t / 90 });\n    if (s.drift > 0) { const x = W / 2 + 60 - (8 - s.drift) * 16; say(hud, x, 52, 'Are you nearly done?', { color: 'plum', shadow: 'white' }); }\n    this.drawTopBar(hud, Math.round(s.score), `${Math.max(0, Math.ceil(90 - s.t))} s`);\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', 'Stand'], ['pause', 'Pause']]);\n    void center;\n  }\n}\nE\necho \"- [x] single-player activities: slackline tray jog pier longstand\" >> PROGRESS.md","description":"Write remaining five activities"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21838,"cache_read_input_tokens":273362,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21838},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"de02c50a-b4b4-44ea-9ae3-a0d74f9ff345","timestamp":"2026-11-05T07:44:00.759Z","request_id":"req_011CgjQJ2695ZmpPu9asQVer","wire_tool_inputs":{"toolu_01PcaZGdFgje2yEUNqNTLPnw":{"command":"python3 - <<'E'\nimport re\np='src/scenes/activity/step.js';s=open(p).read()\ns=s.replace(\"import { App } from '../../app.js';\\nimport { place }\",\"import { App } from '../../app.js';\\nimport { SONGS } from '../../audio/songs.js';\\nimport { place }\")\ns=s.replace(\"    const { SONGS } = App.__songs;\\n\",\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/header.js';s=open(p).read()\ns=s.replace(\"import { App } from '../../app.js';\\nimport { makeAvatar }\",\"import { ContactShadow } from '../../../pixel-engine.js';\\nimport { App } from '../../app.js';\\nimport { makeAvatar }\")\ns=s[:s.index(\"export function makeBlob\")]+\"export function makeBlob(ctx) { const s = new ContactShadow(0.35); ctx.scene.add(s); return s; }\\n\"\ns=s.replace(\"a.x = -3.6; b.x = 3.6; a.avatar.setAt(-3.6, 0, 0.8); b.avatar.setAt(3.6, 0, 0.8);\",\"a.x = -3.3; b.x = 3.3; a.avatar.setAt(-3.3, 0, 0.8); b.avatar.setAt(3.3, 0, 0.8);\")\nopen(p,'w').write(s)\nE\ncat > src/scenes/activity/slackline.js <<'E'\n// 5.6 Slackline. X is balance, forward is progress. Walking is less stable, so stopping is a choice.\nimport { PALETTE, RippleField, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, place, sea, sky } from '../../art/stage.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nexport const SLACK_LENGTH = 30, SLACK_LIMIT = 75;\nexport class SlackSim {\n  t = 0; z = 0; falls = 0; done = false; finished = false; fallT = 0; next = 6; gust = 0; gustDir = 0; warn = 0; warnDir = 0; events = []; walking = false; kevin = false; checkpoint = 0; score = 0;\n  constructor(cfg, env, rng) { this.cfg = cfg; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next()); }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= SLACK_LIMIT) { this.done = true; return; }\n    if (this.fallT > 0) {\n      this.fallT -= dt;\n      if (this.fallT <= 0) { this.z = this.checkpoint; this.dot.x = 0; this.dot.vx = 0; this.dot.ux = 0; this.gust = 0; this.warn = 0; this.next = this.z + 6; this.events.push('back'); }\n      return;\n    }\n    this.checkpoint = this.z >= 20 ? 20 : this.z >= 10 ? 10 : 0;\n    this.walking = u.y > 0.3;\n    if (this.walking) this.z += 1.1 * dt;\n    if (this.z >= this.next && this.warn <= 0 && this.gust <= 0) { this.warn = 1.5; this.warnDir = this.rng.next() < 0.5 ? -1 : 1; this.next += 6; this.events.push('warn'); }\n    if (this.warn > 0) { this.warn -= dt; if (this.warn <= 0) { this.gust = 1; this.gustDir = this.warnDir; this.events.push('gust'); } }\n    if (this.gust > 0) this.gust -= dt;\n    this.kevin = this.z >= 18 && this.z < 24;\n    if (this.kevin && !this.kevinSaid) { this.kevinSaid = true; this.events.push('kevin'); }\n    const instE = (this.walking ? T.slackWalkInst * (this.cfg.walkInst ?? 1) : 1.2) / T.dotInstability;\n    const m = { inst: instE, noise: 1.25 * this.env.noiseMul, bx: (this.gust > 0 ? this.gustDir * T.gustForce : 0) + (this.kevin ? 0.35 : 0) };\n    this.dot.step(dt, u.x, 0, T, m);\n    this.dot.y = 0; this.dot.vy = 0;\n    if (this.env.god) this.dot.x = Math.max(-0.6, Math.min(0.6, this.dot.x));\n    if (Math.abs(this.dot.x) > 1) { this.falls++; this.fallT = 1.2; this.events.push('fall'); }\n    if (this.z >= SLACK_LENGTH) { this.finished = true; this.done = true; this.events.push('finish'); }\n    this.score = this.compute();\n  }\n  compute() { return this.finished ? Math.max(0, Math.round(1000 - 60 * this.falls - 8 * (this.t - 27))) : Math.round((this.z / SLACK_LENGTH) * 300); }\n  result() {\n    const stars = !this.finished ? 0 : this.falls === 0 && this.t < 32 ? 3 : this.falls <= 1 && this.t < 45 ? 2 : 1;\n    return { score: this.compute(), stars, stats: { falls: this.falls, seconds: Math.round(this.t) } };\n  }\n  bot(driver, out, dt) {\n    const d = this.dot;\n    driver.brain.lean({ x: d.x, y: 0, vx: d.vx, vy: 0 }, 0, 0, dt, out);\n    out.y = Math.abs(d.x) < 0.45 && driver.skill.err < 1.2 ? 1 : driver.skill.err >= 1.2 ? (Math.abs(d.x) < 0.3 ? 1 : 0) : 0;\n    out.x = Math.max(-1, Math.min(1, out.x));\n  }\n}\nexport class SlacklineScene extends ActivityScene {\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.1, 5], target: [0, 2.2, -4], fov: 42 }; }\n  makeSim(ctx, lane) { return new SlackSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`slack-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    sky(ctx);\n    ctx.physics.addStaticBox({ position: [0, -3, -15], halfExtents: [20, 0.5, 40] });\n    this.ripples = new RippleField({ size: [30, 50], cells: [90, 150], at: [0, -15] });\n    this.water = sea(ctx, 160, 160, -0.25, 0, -30);\n    this.ripW = this.water;\n    place(ctx, 'slack-anchor', 0, -0.2, 2.2); place(ctx, 'slack-anchor', 0, -0.2, -SLACK_LENGTH - 1.5);\n    box(ctx, 0, -0.1, 7, 14, 0.4, 9, 'sand', { shadow: false });\n    box(ctx, 0, -0.1, -SLACK_LENGTH - 5, 18, 0.4, 7, 'sand', { shadow: false });\n    place(ctx, 'palm', -5, 0, -SLACK_LENGTH - 4); place(ctx, 'palm', 4.5, 0, -SLACK_LENGTH - 5, { turn: 70 });\n    place(ctx, 'kettlebell-volcano', -22, -1, -66, { scale: 1.2 }); place(ctx, 'foam-roller-hill', 24, -1, -58, { scale: 1.1 });\n    for (const z of [10, 20]) { box(ctx, 1.4, 0.4, -z, 0.3, 1.4, 0.3, 'orange'); box(ctx, 1.75, 0.9, -z, 0.5, 0.3, 0.06, 'lime'); box(ctx, -1.4, 0.4, -z, 0.3, 1.4, 0.3, 'orange'); }\n    // Flags: they telegraph the wind.\n    this.flags = [];\n    for (let z = 6; z < SLACK_LENGTH; z += 6) { box(ctx, -1.9, 1, -z, 0.14, 2.6, 0.14, 'white'); const f = new Mesh(new BoxGeometry(0.9, 0.5, 0.05), toonMaterial(PALETTE.red)); f.position.set(-1.45, 2.1, -z); ctx.scene.add(f); this.flags.push(f); }\n    const mat = toonMaterial(PALETTE.orange);\n    this.segs = Array.from({ length: 24 }, () => { const m = new Mesh(new BoxGeometry(0.1, 0.1, 1), mat); ctx.scene.add(m); return m; });\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    avatar.play('Balance');\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, x: 0, z: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.kevinB = place(ctx, 'kevin', 0, -9, 0, { actors: true, scale: 0.9 });\n    ctx.particles.register('splash', { count: [40, 60], life: [0.5, 1.1], speed: [3, 6], gravity: 12, size: [1, 3], colors: ['white', 'cyan', 'sky'], spread: 55, direction: [0, 1, 0], radius: 0.5 });\n    ctx.particles.register('gustline', { count: [1, 2], life: [0.4, 0.7], speed: [8, 12], direction: [1, 0, 0], spread: 8, size: [1, 1], colors: ['white', 'mist'] });\n    this.gl = new Vector3();\n  }\n  cardInfo() { return { goal: 'Push forward to walk. Balance left and right. Cross.', prompts: [['lean', 'Forward: walk. Sideways: balance']] }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const sag = (z, x = 0) => 2.1 - 0.5 * Math.exp(-((z - s.z) ** 2) / 7);\n    const y = sag(s.z);\n    const falling = s.fallT > 0;\n    if (!falling) {\n      a.root.position.set(s.dot.x * 0.3, y + 0.04, -s.z);\n      a.root.rotation.y = Math.PI;\n      a.lean.x = -s.dot.x; a.lean.y = 0; a.trem = Math.abs(s.dot.x) > 0.6 ? 1 : 0;\n      a.play(s.walking ? 'Walk' : 'Balance', { speed: 0.5 });\n      if (ctx.engine.timeScale !== App.devTimeScale && !App.top()) ctx.engine.timeScale = App.devTimeScale;\n    } else {\n      const f = 1.2 - s.fallT;\n      a.root.position.y = Math.max(-1, y - 2.2 * f * f * 2);\n      a.root.position.x += s.dot.x * dt * 0.4;\n      a.play('SkyFlail');\n      if (!this.splashed && a.root.position.y < 0) { this.splashed = true; App.sfx('splash'); ctx.particles.burst('splash', [a.root.position.x, 0, a.root.position.z]); ctx.engine.shake.add(0.2); }\n    }\n    a.groundY = -0.2;\n    // Sag the line under your feet.\n    this.segs.forEach((m, i) => {\n      const z0 = (i / 24) * (SLACK_LENGTH + 2) - 1, z1 = ((i + 1) / 24) * (SLACK_LENGTH + 2) - 1, y0 = sag(z0), y1 = sag(z1);\n      m.position.set(0, (y0 + y1) / 2, -(z0 + z1) / 2); m.scale.z = Math.hypot(z1 - z0, y1 - y0) + 0.02; m.rotation.x = Math.atan2(y1 - y0, z1 - z0);\n    });\n    // Camera low behind you.\n    const c = ctx.camera.camera; c.position.set(s.dot.x * 0.2, 2.5, -s.z + 5.2); c.lookAt(0, 2.2, -s.z - 6); this.target.set(0, 2, -s.z);\n    for (const f of this.flags) { f.scale.x = s.warn > 0 ? 1.2 : 0.8; f.position.x = -1.45 + (s.warn > 0 ? s.warnDir * 0.0 : 0); f.rotation.y = s.warn > 0 ? (s.warnDir > 0 ? 0 : Math.PI) : Math.sin(ctx.time * 3 + f.position.z) * 0.3; }\n    for (const e of s.events.splice(0)) {\n      if (e === 'warn' && !App.bark) App.barkLine(s.warnDir > 0 ? 'Wind from the left. It is rude.' : 'Wind from the right. It is rude.', 'coach', 1.4);\n      if (e === 'gust') App.sfx('gust');\n      if (e === 'fall') { ctx.engine.timeScale = 0.35; this.splashed = false; App.barkLine(this.cosmetic.pick(BARKS.fall), 'ounce', 2); }\n      if (e === 'kevin') { App.sfx('squawk'); App.barkLine('Kevin has landed on you. He is staff.', 'ounce', 2.2); }\n      if (e === 'finish') { App.sfx('fanfare'); a.play('Victory', { once: true }); }\n    }\n    if (s.warn > 0 || s.gust > 0) { this.gl.set(this.cosmetic.range(-5, 5), this.cosmetic.range(1, 3), -s.z - this.cosmetic.range(1, 8)); ctx.particles.burst('gustline', this.gl, { direction: [s.warnDir || s.gustDir, 0, 0] }); }\n    const k = this.kevinB.object;\n    if (s.kevin && !falling) { k.position.set(a.root.position.x, y + 1.64, -s.z); k.rotation.y = Math.PI; } else if (!s.kevin) k.position.y = -9;\n    this.water?.update(ctx.time);\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 54;\n    dial(hud, W / 2, 54, 38, { ringR: 1, x: s.dot.x, y: 0, inside: Math.abs(s.dot.x) < 0.45 });\n    bar(hud, 12, 34, W - 24, 6, s.z / SLACK_LENGTH, 'lime');\n    for (const m of [10, 20]) hud.rect(12 + (m / SLACK_LENGTH) * (W - 24), 32, 2, 10, 'sand');\n    this.drawTopBar(hud, `${s.z.toFixed(1)} m`, `${Math.max(0, Math.ceil(SLACK_LIMIT - s.t))} s  Falls ${s.falls}`);\n    if (s.warn > 0) center(hud, 100, s.warnDir > 0 ? 'Wind >>>' : '<<< Wind', { scale: 2, color: 'orange' });\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', s.walking ? 'Walking' : 'Forward to walk'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/tray.js <<'E'\n// 5.7 Vitamin Tray. Tilt gravity, not the tray. Colliders stay flat; a visual group tilts.\nimport { PALETTE, RAPIER, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, sea, sky } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { BOARDS } from '../../data/boards.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nconst { BoxGeometry, CylinderGeometry, Group, Mesh, SphereGeometry } = THREE;\nconst CELL = 0.72;\nconst COLORS = { R: 'red', B: 'blue', Y: 'sand' };\nconst RAD = Math.PI / 180;\nexport class TraySim {\n  t = 0; score = 0; done = false; events = []; ux = 0; uy = 0; sunk = 0; balls = []; cups = []; dropped = 0;\n  constructor(cfg, env, rng, scene, boardIndex) { this.cfg = cfg; this.env = env; this.rng = rng; this.scene = scene; this.board = BOARDS[boardIndex]; this.seconds = cfg.seconds ?? 60; this.maxS = 80; }\n  maxScore() { return this.maxS; }\n  step(dt, u) {\n    this.t += dt;\n    if (this.t >= this.seconds || this.sunk >= this.balls.length) { this.done = true; return; }\n    const k = Math.min(1, dt / 0.12);\n    this.ux += (u.x - this.ux) * k; this.uy += (u.y - this.uy) * k;\n    const tilt = T.trayMaxTilt * RAD, g = T.trayGravity;\n    const w = this.scene.ctx.physics.world;\n    w.gravity = { x: Math.sin(tilt * this.ux) * g, y: -g * Math.cos(tilt * Math.hypot(this.ux, this.uy)), z: -Math.sin(tilt * this.uy) * g };\n    for (const b of this.balls) {\n      if (b.sunk) continue;\n      if (b.respawn > 0) { b.respawn -= dt; if (b.respawn <= 0) this.scene.respawn(b); continue; }\n      const p = b.body.translation(), v = b.body.linvel();\n      b.x = p.x; b.z = p.z; b.vx = v.x; b.vz = v.z;\n      if (p.y < -1.5) { this.score = Math.max(0, this.score - 1); this.dropped++; b.respawn = 3; this.scene.hideBall(b); this.events.push({ kind: 'drop', b }); continue; }\n      for (const c of this.cups) {\n        const d = Math.hypot(p.x - c.x, p.z - c.z), slow = Math.hypot(v.x, v.z) < 2.4;\n        if (d < CELL * 0.55 && slow) {\n          if (c.color === b.color) { b.sunk = true; this.sunk++; this.score += 10; this.scene.hideBall(b); this.events.push({ kind: 'good', b, c }); }\n          else { this.score = Math.max(0, this.score - 3); b.respawn = 1; this.scene.hideBall(b); this.events.push({ kind: 'bad', b, c }); }\n          break;\n        }\n      }\n    }\n  }\n  final() { return this.score; }\n  result() { return { score: this.score, max: this.maxS, stats: { sunk: this.sunk, dropped: this.dropped } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    let ball = this.balls.find((b) => b.id === driver.focus && !b.sunk && !(b.respawn > 0));\n    if (!ball) { ball = this.balls.find((b) => !b.sunk && !(b.respawn > 0) && b.x !== undefined); driver.focus = ball?.id; driver.since = this.t; }\n    if (!ball) return;\n    const cup = this.cups.filter((c) => c.color === ball.color).sort((a, b) => Math.hypot(a.x - ball.x, a.z - ball.z) - Math.hypot(b.x - ball.x, b.z - ball.z))[0];\n    if (!cup) return;\n    if (this.t - driver.since > 12) { driver.focus = null; }\n    const kp = 0.35 * (0.6 + sk.kp * 0.4), kd = 0.28;\n    const jx = Math.sin(this.t * 1.7) * (1.5 - sk.hit) * 0.6, jz = Math.cos(this.t * 2.3) * (1.5 - sk.hit) * 0.6;\n    out.x = Math.max(-1, Math.min(1, kp * (cup.x - ball.x) - kd * ball.vx + jx * 0.4));\n    out.y = Math.max(-1, Math.min(1, -(kp * (cup.z - ball.z) - kd * ball.vz + jz * 0.4)));\n  }\n}\nexport class TrayScene extends ActivityScene {\n  cameraConfig() { return { preset: 'fixed', position: [0, 11.5, 6.4], target: [0, 0, 0.2], fov: 34 }; }\n  makeSim(ctx, lane) {\n    if (this.boardIndex === undefined) { const plays = (App.slot?.records ?? App.save.data.dropIn).tray?.plays ?? 0; this.boardIndex = this.hard ? 2 : App.attract ? 1 : plays % BOARDS.length; }\n    const sim = new TraySim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`tray-${this.simN = (this.simN ?? 0) + 1}`), this, this.boardIndex);\n    if (this.laid) this.layBalls(ctx, sim);\n    return sim;\n  }\n  onResetSims() {}\n  async buildStage(ctx) {\n    sky(ctx); this.ctx = ctx;\n    sea(ctx, 80, 60, -2.2, 0, -14);\n    box(ctx, 0, -2.3, 3, 40, 0.2, 18, 'sand', { shadow: false });\n    this.group = new Group(); ctx.scene.add(this.group);\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', driver: this.localDriver(ctx), name: 'You' });\n    this.boardIndex = undefined;\n    this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.buildBoard(ctx, this.lanes[0].sim.board);\n    this.laid = true;\n    this.layBalls(ctx, this.lanes[0].sim);\n    ctx.physics.world.gravity = { x: 0, y: -T.trayGravity, z: 0 };\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.setAt(-6.4, -2.2, 0, 0.8); this.coach.groundY = -2.2;\n    ctx.particles.register('fizz', { count: [8, 12], life: [0.3, 0.6], speed: [1, 2.5], gravity: 4, size: [1, 1], colors: ['white', 'lime'] });\n  }\n  buildBoard(ctx, board) {\n    const rows = board.rows, R = rows.length, C = rows[0].length;\n    this.W = C * CELL; this.D = R * CELL;\n    const lac = toonMaterial(PALETTE.red), rail = toonMaterial(PALETTE.plum);\n    const floor = new Mesh(new BoxGeometry(this.W, 0.2, this.D), toonMaterial(PALETTE.white)); floor.position.y = -0.1; floor.receiveShadow = true; this.group.add(floor);\n    const under = new Mesh(new BoxGeometry(this.W + 0.6, 0.2, this.D + 0.6), lac); under.position.y = -0.3; this.group.add(under);\n    const addStatic = (x, y, z, hx, hy, hz) => { const b = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x, y, z)); ctx.physics.world.createCollider(RAPIER.ColliderDesc.cuboid(hx, hy, hz).setFriction(0.2).setRestitution(0.25), b); };\n    addStatic(0, -0.1, 0, this.W / 2, 0.1, this.D / 2);\n    const starts = []; const cups = [];\n    rows.forEach((row, j) => [...row].forEach((ch, i) => {\n      const x = (i - (C - 1) / 2) * CELL, z = (j - (R - 1) / 2) * CELL;\n      if (ch === '#') { addStatic(x, 0.25, z, CELL / 2, 0.25, CELL / 2); const m = new Mesh(new BoxGeometry(CELL, 0.5, CELL), rail); m.position.set(x, 0.25, z); m.castShadow = true; this.group.add(m); }\n      if (ch === 'o') starts.push([x, z]);\n      if (COLORS[ch]) {\n        cups.push({ x, z, color: ch });\n        const m = new Mesh(new CylinderGeometry(CELL * 0.52, CELL * 0.52, 0.04, 12), toonMaterial(PALETTE[COLORS[ch]])); m.position.set(x, 0.02, z); this.group.add(m);\n        const n = new Mesh(new CylinderGeometry(CELL * 0.34, CELL * 0.34, 0.05, 12), toonMaterial(PALETTE.ink)); n.position.set(x, 0.03, z); this.group.add(n);\n      }\n    }));\n    // A gap in the floor where the rail is missing: no collider, so a vitamin falls off the edge.\n    this.starts = starts; this.cupDefs = cups;\n    this.colours = [...new Set(cups.map((c) => c.color))];\n  }\n  layBalls(ctx, sim) {\n    sim.cups = this.cupDefs;\n    if (this.ballObjs) {\n      sim.balls = this.ballObjs; sim.balls.forEach((b, i) => { b.sunk = false; b.respawn = 0; b.mesh.visible = true; this.placeBall(b, i); });\n      return;\n    }\n    const geo = new SphereGeometry(0.24, 8, 6);\n    sim.balls = this.starts.slice(0, 8).map(([x, z], i) => {\n      const color = this.colours[i % this.colours.length];\n      const body = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 0.3, z).setLinearDamping(0.5).setAngularDamping(0.6).setCcdEnabled(true));\n      ctx.physics.world.createCollider(RAPIER.ColliderDesc.ball(0.24).setRestitution(0.2).setFriction(0.3).setDensity(2), body);\n      const mesh = new Mesh(geo, toonMaterial(PALETTE[COLORS[color]])); mesh.castShadow = true; this.group.add(mesh);\n      return { id: i, x, z, vx: 0, vz: 0, color, body, mesh, sunk: false, respawn: 0, home: [x, z] };\n    });\n    this.ballObjs = sim.balls;\n  }\n  placeBall(b) { b.body.setTranslation({ x: b.home[0], y: 0.3, z: b.home[1] }, true); b.body.setLinvel({ x: 0, y: 0, z: 0 }, true); b.body.setEnabled?.(true); }\n  hideBall(b) { b.mesh.visible = false; b.body.setEnabled?.(false); if (!b.body.setEnabled) b.body.setTranslation({ x: 0, y: -50, z: 0 }, true); }\n  respawn(b) { b.mesh.visible = true; b.body.setEnabled?.(true); this.placeBall(b); }\n  dispose(ctx) { if (ctx?.physics?.world) ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n  cardInfo() { return { goal: 'Tilt the tray. Roll each vitamin into its own colour.', prompts: [['lean', 'Tilt']] }; }\n  onOutro(ctx) { ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim;\n    if (this.phase === 'intro' || this.phase === 'countdown') ctx.physics.world.gravity = { x: 0, y: -T.trayGravity, z: 0 };\n    const tilt = T.trayMaxTilt * RAD;\n    this.group.rotation.z = -tilt * s.ux; this.group.rotation.x = -tilt * s.uy;\n    for (const b of s.balls) if (b.mesh.visible) { const p = b.body.translation(); b.mesh.position.set(p.x, p.y, p.z); }\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'good') { App.sfx('chimeIn'); ctx.particles.burst('fizz', [e.c.x, 0.3, e.c.z]); if (!App.bark && this.cosmetic.chance(0.3)) App.barkLine('Good. That one is where it belongs.', 'ounce', 1.6); }\n      if (e.kind === 'bad') { App.sfx('wobble'); App.barkLine('That is the wrong cup. It will have to go back.', 'ounce', 1.8); }\n      if (e.kind === 'drop') { App.sfx('thwap'); }\n    }\n    this.coach?.update(dt);\n  }\n  updateAvatars() {}\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim;\n    App.dialCenter.x = hud.width / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, s.score, `${s.board.name}  ${Math.max(0, Math.ceil(s.seconds - s.t))} s  ${s.sunk}/${s.balls.length}`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Tilt'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/jog.js <<'E'\n// 5.8 Island Jog. A rail run around the whole island. Alternate left and right.\nimport { THREE, Trail } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { buildIsland, JOG_POINTS } from '../../art/island.js';\nimport { place } from '../../art/stage.js';\nimport { T } from '../../core/tunables.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst { CatmullRomCurve3, Vector3 } = THREE;\nexport function makePath() {\n  const curve = new CatmullRomCurve3(JOG_POINTS.map(([x, z]) => new Vector3(x, 0, z)), true, 'catmullrom', 0.5);\n  curve.arcLengthDivisions = 800;\n  return { curve, length: curve.getLength() };\n}\nexport class JogSim {\n  s = 0; t = 0; lat = 0; cad = 0; speed = 0; side = null; stumble = 0; stitch = 0; over = 0; inBandT = 0; cups = 0; done = false; events = []; lastStep = -9; coachS = 4; limit = 120; score = 0;\n  constructor(cfg, env, rng, length) {\n    this.cfg = cfg; this.env = env; this.rng = rng; this.length = length;\n    this.cupList = Array.from({ length: 18 }, (_, i) => ({ s: ((i + 1) / 19) * length, lat: (rng.next() * 2 - 1) * 1.2, got: false }));\n    this.hazards = Array.from({ length: 12 }, (_, i) => ({ s: ((i + 0.5) / 12) * length + rng.next() * 3, lat: (rng.next() * 2 - 1) * 1.2, kind: ['sprinkler', 'picnic', 'dennis', 'kevin'][i % 4], hit: false }));\n  }\n  get target() { return 3 * (this.cfg.speed ?? 1); }\n  band() { const c = T.jogTargetCadence * (this.cfg.speed ?? 1); return [c * 0.8, c * 1.2]; }\n  step(dt, u) {\n    this.t += dt;\n    if (u.stepL || u.stepR) {\n      const f = u.stepL ? 'L' : 'R';\n      if (f === this.side) { this.stumble = 0.5; this.events.push('stumble'); }\n      else { const dtStep = this.t - this.lastStep; if (dtStep > 0.02) { const inst = 1 / dtStep; this.cad += (inst - this.cad) * 0.45; } this.lastStep = this.t; this.events.push('foot'); }\n      this.side = f;\n    }\n    if (this.t - this.lastStep > 0.6) this.cad = Math.max(0, this.cad - 4 * dt);\n    if (this.env.god) { this.cad = T.jogTargetCadence * (this.cfg.speed ?? 1); this.stumble = 0; this.stitch = 0; }\n    const [low, high] = this.band();\n    if (this.cad > high) { this.over += dt; if (this.over > 2 && this.stitch <= 0) { this.stitch = 3; this.over = 0; this.events.push('stitch'); } } else this.over = 0;\n    const mul = this.stitch > 0 ? 0.5 : 1;\n    this.stitch = Math.max(0, this.stitch - dt);\n    this.stumble = Math.max(0, this.stumble - dt);\n    const tgt = this.stumble > 0 ? 0 : this.target * (this.cad / (T.jogTargetCadence * (this.cfg.speed ?? 1))) * mul;\n    this.speed += (Math.min(tgt, this.target * 1.25) - this.speed) * Math.min(1, dt * 5);\n    this.s += this.speed * dt;\n    if (this.cad >= low && this.cad <= high && this.stumble <= 0) this.inBandT += dt;\n    this.lat = Math.max(-1.5, Math.min(1.5, this.lat + u.x * 3 * dt));\n    // Coach paces you at exactly target speed; more than 12 m behind, she waits.\n    if (this.coachS - this.s < 12) this.coachS += this.target * dt;\n    for (const c of this.cupList) if (!c.got && Math.abs(c.s - this.s) < 0.9 && Math.abs(c.lat - this.lat) < 0.8) { c.got = true; this.cups++; this.events.push('cup'); }\n    for (const h of this.hazards) if (!h.hit && Math.abs(h.s - this.s) < 0.7 && Math.abs(h.lat - this.lat) < 0.55 && !this.env.god) { h.hit = true; this.stumble = 0.5; this.events.push(`hit:${h.kind}`); }\n    this.score = this.compute();\n    if (this.s >= this.length || this.t >= this.limit) this.done = true;\n  }\n  compute() { const dur = Math.max(this.length / this.target, this.t); return 70 * Math.min(1, this.inBandT / dur) * (1 / 1) + 30 * (this.cups / 18); }\n  final() { return this.compute(); }\n  result() { return { score: Math.round(this.compute()), stats: { cups: this.cups, seconds: Math.round(this.t) } }; }\n  bot(driver, out) {\n    const sk = driver.skill;\n    if (driver.nextStep === undefined) driver.nextStep = this.t + 0.3;\n    if (this.t >= driver.nextStep) {\n      const c = T.jogTargetCadence * (this.cfg.speed ?? 1);\n      const bad = driver.rng.next() < sk.mistake * 0.2;\n      const foot = (this.side === 'L') !== bad ? 'R' : 'L';\n      if (foot === 'L') out.stepL = true; else out.stepR = true;\n      driver.nextStep = this.t + (1 / c) * (1 + (driver.rng.next() - 0.5) * sk.jitter * 6) * (sk.name === 'sloppy' ? 1.35 : 1);\n    }\n    let tl = 0, best = 12;\n    for (const cu of this.cupList) { const d = cu.s - this.s; if (!cu.got && d > 0.3 && d < best) { best = d; tl = cu.lat; } }\n    for (const h of this.hazards) { const d = h.s - this.s; if (!h.hit && d > 0 && d < 5 && Math.abs(h.lat - tl) < 0.6) tl = h.lat > 0 ? h.lat - 0.9 : h.lat + 0.9; }\n    out.x = Math.max(-1, Math.min(1, (tl - this.lat) * 2.5 * (sk.hit)));\n  }\n}\nexport class JogScene extends ActivityScene {\n  cameraConfig() { return { preset: 'iso', zoom: 1.4 }; }\n  makeSim(ctx, lane) { return new JogSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`jog-${this.simN = (this.simN ?? 0) + 1}`), this.path.length); }\n  async buildStage(ctx) {\n    this.path = makePath();\n    this.world = await buildIsland(ctx, { jog: true });\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    const sim = this.lanes[0].sim = this.makeSim(ctx, this.lanes[0]);\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.play('Sit');\n    this.scooter = place(ctx, 'mobility-scooter', 0, 0, 0, { actors: true });\n    this.trail = new Trail({ width: 0.3, life: 0.6, points: 32, color: 0x73eff7, tail: 0xf4f4f4 }); ctx.scene.add(this.trail);\n    this.cupObjs = sim.cupList.map((c) => { const b = place(ctx, 'water-cup', 0, 0, 0); this.putOn(b.object, c.s, c.lat); return b.object; });\n    this.hazObjs = sim.hazards.map((h) => {\n      const id = { sprinkler: 'sprinkler', picnic: 'picnic', dennis: null, kevin: 'kevin' }[h.kind];\n      if (id) { const b = place(ctx, id, 0, 0, 0); this.putOn(b.object, h.s, h.lat); return b.object; }\n      return null;\n    });\n    this.dennisA = await makeAvatar(ctx, CAST_LOOKS.dennis);\n    const dh = sim.hazards.find((h) => h.kind === 'dennis'); this.putOn(this.dennisA.root, dh.s, dh.lat); this.dennisA.play('Daze');\n    ctx.particles.register('sweat', { count: [2, 4], life: [0.25, 0.45], speed: [1, 2.5], gravity: 8, size: [1, 1], colors: ['cyan', 'white'] });\n    this.p = new Vector3(); this.tan = new Vector3();\n  }\n  putOn(obj, s, lat) {\n    const u = Math.min(0.9999, Math.max(0, (s % this.path.length) / this.path.length));\n    const p = this.path.curve.getPointAt(u), t = this.path.curve.getTangentAt(u);\n    obj.position.set(p.x + t.z * lat, 0.02, p.z - t.x * lat); obj.rotation.y = Math.atan2(t.x, t.z);\n    return { p, t };\n  }\n  cardInfo() { return { goal: 'Alternate your feet. Keep up with the scooter. Take the water.', prompts: [['feet', 'Left, right'], ['lean', 'Move across the path']] }; }\n  onResetSims(ctx) { const s = this.lanes[0].sim; this.cupObjs.forEach((o, i) => { o.visible = true; this.putOn(o, s.cupList[i].s, s.cupList[i].lat); }); }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const { p } = this.putOn(a.root, s.s, s.lat);\n    a.root.position.y = 0;\n    this.target.set(a.root.position.x, 1, a.root.position.z);\n    if (s.speed > 0.2) a.play('Jog', { speed: Math.max(0.3, s.speed / 3) }); else a.play(s.stumble > 0 ? 'Daze' : 'Idle');\n    this.putOn(this.scooter.object, s.coachS, 0); this.coach.root.position.copy(this.scooter.object.position); this.coach.root.position.y = 0.32; this.coach.root.rotation.y = this.scooter.object.rotation.y;\n    s.cupList.forEach((c, i) => { if (c.got) this.cupObjs[i].visible = false; });\n    this.coach.update(dt); this.dennisA.update(dt);\n    this.trail.push(this.v.set(a.root.position.x, 0.25, a.root.position.z), ctx.time); this.trail.update(ctx.time, ctx.camera.camera);\n    this.world.update(ctx, dt);\n    for (const e of s.events.splice(0)) {\n      if (e === 'foot') App.sfx('repTick', { volume: 0.4 });\n      if (e === 'cup') { App.sfx('jarDrip'); ctx.particles.burst('sparkle', [a.root.position.x, 1, a.root.position.z], { count: 6, colors: ['cyan', 'white'] }); }\n      if (e === 'stumble') { App.sfx('wobble'); ctx.particles.burst('dust', [a.root.position.x, 0.1, a.root.position.z]); }\n      if (e === 'stitch') App.barkLine('That is a stitch. You were told. I was going to tell you.', 'ounce', 2.4);\n      if (e.startsWith('hit:')) { App.sfx('thwap'); App.barkLine({ 'hit:sprinkler': 'A sprinkler. It was not hiding.', 'hit:picnic': 'That was someone\\'s lunch.', 'hit:dennis': 'Dennis: \"It\\'s fine. It\\'s just the one leg.\"', 'hit:kevin': 'Kevin would like a word. He has only the one.' }[e], e === 'hit:dennis' ? 'dennis' : 'ounce', 2); ctx.engine.shake.add(0.2); }\n    }\n    void p;\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width, [low, high] = s.band();\n    App.dialCenter.x = W / 2; App.dialCenter.y = hud.height / 2;\n    this.drawTopBar(hud, Math.round(s.score), `Cups ${s.cups}/18`);\n    const gx = W / 2 - 70, gy = 28, gw = 140, mx = 5.5;\n    bar(hud, gx, gy, gw, 9, 0, 'lime');\n    hud.rect(gx + (low / mx) * gw, gy + 1, ((high - low) / mx) * gw, 7, 'green');\n    hud.rect(gx + (Math.min(mx, s.cad) / mx) * gw - 1, gy - 1, 3, 11, s.cad > high ? 'red' : 'white');\n    center(hud, gy + 12, s.stitch > 0 ? 'Stitch.' : s.stumble > 0 ? 'Stumble.' : s.coachS - s.s >= 12 ? 'She is waiting.' : 'Pace', { color: s.stitch > 0 ? 'red' : 'white' });\n    bar(hud, 12, hud.height - 26, W - 24, 5, s.s / s.length, 'lime');\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['feet', 'Left, right'], ['lean', 'Move'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/pier.js <<'E'\n// 5.9 Pier Jump. Side-on. Three attempts. Three judges with paddles.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { box, place, sea, sky } from '../../art/stage.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { BARKS } from '../../data/lines.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { bar, dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nconst RUN = 5, LIP_AT = 5, WIN = 0.25;\nexport class PierSim {\n  attempt = 0; t = 0; part = 'run'; speed = 6; p = 0; pressAt = null; flightT = 0; ringT = 0; cannon = false; distance = 0; best = 0; style = 0; bestStyle = 0; score = 0; done = false; events = []; scores = []; ringR = 0.45; flightLen = 3.5; waitT = 0;\n  constructor(cfg, env, rng) { this.cfg = cfg; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next()); }\n  winW() { return WIN * (this.cfg.window ?? 1); }\n  step(dt, u) {\n    this.t += dt; const d = this.dot;\n    const pressed = u.confirm;\n    if (this.part === 'run') {\n      d.step(dt, u.x, u.y, T, { noise: this.env.noiseMul });\n      if (this.env.god) { d.y = -0.6; d.x = 0; }\n      if (d.y >= -0.8 && d.y <= -0.4) this.speed = Math.min(14, this.speed + (8 / (RUN * 0.8)) * dt);\n      if (pressed && this.pressAt === null && this.t >= LIP_AT - this.winW()) { this.pressAt = this.t; }\n      if (this.env.god && this.pressAt === null && this.t >= LIP_AT) this.pressAt = LIP_AT;\n      if (this.t >= LIP_AT + this.winW() || this.pressAt !== null && this.t >= LIP_AT) {\n        this.p = this.pressAt === null ? 0 : Math.max(0, 1 - Math.abs(this.pressAt - LIP_AT) / this.winW());\n        this.part = 'flight'; this.flightT = 0; this.ringT = 0; this.cannon = false; this.flightLen = 3 + this.p;\n        d.x = 0; d.y = 0; d.vx = 0; d.vy = 0;\n        this.events.push({ kind: 'lip', p: this.p });\n      }\n    } else if (this.part === 'flight') {\n      this.flightT += dt;\n      d.step(dt, u.x, u.y, T, { inst: 3 / T.dotInstability, noise: this.env.noiseMul });\n      if (this.env.god) { d.x *= 0.5; d.y *= 0.5; }\n      if (d.dist() <= this.ringR * this.env.ringMul / T.ringScale * T.ringScale) this.ringT += dt;\n      const left = this.flightLen - this.flightT;\n      if (pressed && left <= 0.5 && !this.cannon) { this.cannon = true; this.events.push({ kind: 'cannon' }); }\n      if (this.env.god && left <= 0.3) this.cannon = true;\n      if (left <= 0) {\n        const ring = this.ringT / this.flightLen;\n        this.distance = this.speed * (0.8 + 0.6 * this.p) * (0.6 + 0.4 * ring) * T.pierBoost;\n        this.style = (this.cannon ? 30 : 0) + Math.round(40 * ring) + Math.round(30 * this.p);\n        if (this.distance > this.best) { this.best = this.distance; this.bestStyle = this.style; }\n        this.scores.push(this.distance);\n        this.part = 'splash'; this.waitT = 2.8;\n        this.events.push({ kind: 'splash', distance: this.distance, cannon: this.cannon, style: this.style });\n      }\n    } else if (this.part === 'splash') {\n      this.waitT -= dt;\n      if (this.waitT <= 0) {\n        this.attempt++;\n        if (this.attempt >= 3) { this.done = true; return; }\n        this.part = 'run'; this.t = 0; this.speed = 6; this.pressAt = null; d.x = 0; d.y = 0; d.vx = 0; d.vy = 0;\n        this.events.push({ kind: 'again' });\n      }\n    }\n    this.score = this.best;\n  }\n  final() { return this.best; }\n  result() { return { score: +this.best.toFixed(1), stats: { style: this.bestStyle } }; }\n  bot(driver, out, dt) {\n    const sk = driver.skill;\n    const ty = this.part === 'run' ? -0.6 : 0;\n    driver.brain.lean(this.dot, 0, ty, dt, out);\n    if (this.part === 'run') {\n      if (driver.pressWhen === undefined || driver.pressAttempt !== this.attempt) { driver.pressAttempt = this.attempt; driver.pressWhen = LIP_AT + (driver.rng.next() - 0.5) * sk.jitter * 3; }\n      if (this.t >= driver.pressWhen && this.pressAt === null) out.confirm = true;\n    } else if (this.part === 'flight' && this.flightLen - this.flightT <= 0.3 && driver.rng.next() < sk.hit) out.confirm = true;\n  }\n}\nconst JUDGES = [['marguerite', -4], ['june', -2.4], ['dennis', -0.8]];\nexport class PierScene extends ActivityScene {\n  cameraConfig() { return { preset: 'side', zoom: 0.9 }; }\n  makeSim(ctx) { return new PierSim(this.cfg(), App.simEnv(ctx, this.def), ctx.random.fork(`pier-${this.simN = (this.simN ?? 0) + 1}`)); }\n  async buildStage(ctx) {\n    sky(ctx);\n    ctx.physics.addStaticBox({ position: [0, -3, 0], halfExtents: [60, 0.5, 20] });\n    this.water = sea(ctx, 220, 40, -0.25, 20, -4);\n    box(ctx, -26, -0.1, 0, 30, 1.2, 20, 'sand', { shadow: false });\n    place(ctx, 'pier', -2, 0.1, 0, { turn: 90, params: { len: 26 } });\n    box(ctx, -15, 1.4, -3, 0.3, 3, 0.3, 'white'); box(ctx, -15, 3, -3, 2.6, 0.5, 0.1, 'orange');\n    place(ctx, 'palm', -22, 0.4, -3); place(ctx, 'kettlebell-volcano', 12, -1, -26, { scale: 1.1 });\n    place(ctx, 'foam-roller-hill', -42, -1, -18);\n    place(ctx, 'judge-table', 12, 0.4, -2.4, { scale: 0.9 });\n    box(ctx, 12, -0.1, -2.4, 6, 0.6, 2.6, 'orange');\n    this.judges = [];\n    for (let i = 0; i < 3; i++) {\n      const [who] = JUDGES[i];\n      const a = await makeAvatar(ctx, CAST_LOOKS[who]); a.setAt(10.6 + i * 1.4, 0.2, -2.9, 0); a.groundY = 0.2;\n      const paddle = place(ctx, 'judge-paddle', 10.6 + i * 1.4, -9, -2.2, { actors: true });\n      this.judges.push({ a, paddle: paddle.object, who, raised: 0 });\n    }\n    const avatar = await makeAvatar(ctx, this.playerLook());\n    this.playerLane = 0;\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx);\n    ctx.particles.register('splash', { count: [80, 120], life: [0.6, 1.3], speed: [4, 9], gravity: 12, size: [1, 3], colors: ['white', 'cyan', 'sky'], spread: 50, direction: [0, 1, 0], radius: 0.8, max: 400 });\n    this.px = -14; this.py = 1.25;\n  }\n  cardInfo() { return { goal: 'Run up tucked low. Press at the lip. Stay in the ring. Press before the splash.', prompts: [['lean', 'Lean: tuck, then balance'], ['press', 'Jump, then cannonball']] }; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    const lipX = 11 - 22;\n    if (s.part === 'run') {\n      const f = Math.min(1, s.t / LIP_AT);\n      this.px = -14 + (lipX + 22 - 11 + 11) * 0 + (11 - (-14)) * f * 0.8; this.py = 1.25;\n      a.play(s.dot.y <= -0.4 ? 'Tuck' : 'Run');\n      a.groundY = 1.2;\n    } else if (s.part === 'flight') {\n      const f = s.flightT / s.flightLen, D = s.speed * (0.8 + 0.6 * s.p) * (0.6 + 0.4 * (s.ringT / Math.max(0.1, s.flightT))) * T.pierBoost;\n      this.px = 6 + D * 0.55 * f; this.py = 1.25 + Math.sin(f * Math.PI) * (2.6 + s.p * 1.6) - f * 1.2;\n      a.play(s.cannon ? 'Cannonball' : 'SkyFlail');\n      a.groundY = -0.2;\n    } else if (s.part === 'splash') { this.py = Math.max(-1.6, this.py - dt * 3.5); }\n    a.root.position.set(this.px, this.py, 0); a.root.rotation.y = Math.PI / 2;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y;\n    this.target.set(Math.max(-6, this.px * 0.7 + 2), 3, 0);\n    for (const j of this.judges) { j.a.update(dt); if (j.raised > 0) { j.raised -= dt; j.paddle.position.y = 2.1; } else { j.paddle.position.y = -9; } }\n    for (const e of s.events.splice(0)) {\n      if (e.kind === 'lip') { App.sfx(e.p > 0.7 ? 'go' : 'countdown'); App.barkLine(e.p > 0.8 ? 'A clean take-off. I am as surprised as you.' : e.p > 0 ? 'You left the pier. Near enough.' : 'You missed the lip. You went anyway. Brave.', 'ounce', 1.6); }\n      if (e.kind === 'cannon') { App.sfx('hop'); a.sq.kick(-3); }\n      if (e.kind === 'splash') {\n        App.sfx('splash', { volume: e.cannon ? 1 : 0.6 }); ctx.engine.hitstop(0.1); ctx.engine.timeScale = 0.25; this.slow = 0.8 * 0.25;\n        ctx.particles.burst('splash', [this.px, 0, 0], { count: e.cannon ? 130 : 60 }); ctx.engine.shake.add(e.cannon ? 0.6 : 0.3);\n        if (!App.settings.reduceFlashes) ctx.engine.screen.shockwave(this.v.set(this.px, 0, 0), { radius: 0.3 });\n        for (const j of this.judges) { j.a.play('PaddleRaise', { once: true }); j.raised = 2.4; App.sfx('paddle', { pitch: 3 }); }\n        this.lastSplash = e;\n      }\n      if (e.kind === 'again') { this.px = -14; a.play('Run'); for (const j of this.judges) j.a.play('Idle'); if (!App.bark) App.barkLine(this.cosmetic.pick(BARKS.streak), 'ounce', 1.6); }\n    }\n    if (this.slow > 0) { this.slow -= dt; if (this.slow <= 0 && !App.top()) ctx.engine.timeScale = App.devTimeScale; }\n    this.water.update(ctx.time);\n    a.update(dt);\n  }\n  updateAvatars() {}\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    if (s.part === 'run') {\n      dial(hud, W / 2, 56, 34, { x: s.dot.x, y: s.dot.y, hideRing: true, target: { x: 0, y: -0.6, r: 0.24 } });\n      center(hud, 96, s.dot.y <= -0.4 && s.dot.y >= -0.8 ? 'Tucked. Speed up.' : 'Lean down to tuck.', { color: 'white' });\n      bar(hud, W / 2 - 70, 108, 140, 8, (s.speed - 6) / 8, 'lime');\n      const lf = Math.max(0, LIP_AT - s.t);\n      if (lf < 0.6) center(hud, 122, 'Press!', { scale: 2, color: 'lime' });\n    } else if (s.part === 'flight') {\n      dial(hud, W / 2, 56, 34, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.dot.dist() <= s.ringR });\n      if (s.flightLen - s.flightT <= 0.5) center(hud, 98, s.cannon ? 'Tucked!' : 'Press!', { scale: 2, color: 'lime' });\n    } else if (s.part === 'splash' && this.lastSplash) {\n      center(hud, 54, `${this.lastSplash.distance.toFixed(1)} m`, { scale: 3, color: 'sand' });\n      center(hud, 82, `Style ${this.lastSplash.style}`, { color: 'cyan' });\n    }\n    this.drawTopBar(hud, `${s.best.toFixed(1)} m`, `Jump ${Math.min(3, s.attempt + 1)} of 3`);\n    if ((this.phase === 'play' || this.phase === 'practice') && !App.attract) promptBar(hud, [['lean', 'Lean'], ['press', s.part === 'flight' ? 'Cannonball' : 'Jump'], ['pause', 'Pause']]);\n    void say;\n  }\n}\nE\ncat > src/scenes/activity/longstand.js <<'E'\n// 5.10 The Long Stand. Stillness scoring with a data timeline. No way to fail.\nimport { Precipitation, THREE, applySky, skyAt } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar, PlumbBob } from '../../art/avatar.js';\nimport { buildPlaza } from '../../art/island.js';\nimport { place } from '../../art/stage.js';\nimport { CAST_LOOKS } from '../../data/classmates.js';\nimport { LONG_STAND } from '../../data/poses.js';\nimport { center, say } from '../../ui/font.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { dial } from '../../ui/widgets.js';\nimport { ActivityScene } from './base.js';\nimport { PoseSim } from './poses.js';\nimport { T } from '../../core/tunables.js';\nexport class LongStandSim extends PoseSim {\n  idx = 0; kevin = false; rain = false; drift = 0; biasX = 0; noiseK = 1; fired = [];\n  constructor(env, rng, from = 0) { super({ clip: 'StandTall', ring: 0.4, hold: 90 }, env, rng); this.settle = 0; this.release = 0; this.hold = 90; this.t = from; this.from = from; this.rng2 = rng; while (this.idx < LONG_STAND.length && LONG_STAND[this.idx].t <= from && from > 0) this.apply(LONG_STAND[this.idx++], true); }\n  apply(ev, silent = false) {\n    if (ev.ring !== undefined) this.ring = ev.ring;\n    if (ev.bias !== undefined) this.biasX = ev.bias;\n    if (ev.noise !== undefined) this.noiseK = ev.noise;\n    if (ev.kevin !== undefined) this.kevin = ev.kevin;\n    if (ev.rain !== undefined) this.rain = ev.rain;\n    if (ev.impulse && !silent) this.dot.impulse(ev.impulse[0], ev.impulse[1]);\n    if (ev.randomImpulse && !silent) { const a = this.rng2.next() * 6.283; this.dot.impulse(Math.cos(a) * ev.randomImpulse, Math.sin(a) * ev.randomImpulse); }\n    if (ev.drift) this.drift = 8;\n    if (!silent) this.fired.push(ev);\n  }\n  mods() { return { noise: this.noiseK * this.env.noiseMul, bx: this.biasX * T.dotAuthority }; }\n  step(dt, u) {\n    while (this.idx < LONG_STAND.length && LONG_STAND[this.idx].t <= this.t) { const ev = LONG_STAND[this.idx++]; this.apply(ev); if (ev.end) { this.done = true; this.score = this.compute(); return; } }\n    this.drift = Math.max(0, this.drift - dt);\n    super.step(dt, u);\n    this.done = false;\n  }\n  compute() { return this.holdT > 0 ? 100 * (this.inT / Math.max(this.holdT, this.from > 0 ? this.holdT : 90)) : 0; }\n}\nexport class LongStandScene extends ActivityScene {\n  makeSim(ctx) { return new LongStandSim(App.simEnv(ctx, this.def), ctx.random.fork(`stand-${this.simN = (this.simN ?? 0) + 1}`), this.args.from ?? 0); }\n  async buildStage(ctx) {\n    this.hasPractice = false;\n    this.world = await buildPlaza(ctx);\n    applySky(ctx.engine, skyAt(17.6));\n    this.playerLane = 0;\n    const avatar = await makeAvatar(ctx, this.playerLook()); avatar.setAt(0, 0, 0.8); avatar.play('StandTall');\n    this.lanes.push({ i: 0, who: 'player', avatar, driver: this.localDriver(ctx), name: 'You' });\n    this.lanes[0].sim = this.makeSim(ctx);\n    this.coach = await makeAvatar(ctx, CAST_LOOKS.coach); this.coach.setAt(1.2, 0, -1.3); this.coach.play('StandTall'); this.bob = new PlumbBob(ctx, this.coach);\n    this.marg = await makeAvatar(ctx, CAST_LOOKS.marguerite); this.marg.setAt(-3.2, 0, -0.5, 0.5);\n    this.dennis = await makeAvatar(ctx, CAST_LOOKS.dennis); this.dennis.setAt(3.1, 0, -0.2, -0.5);\n    this.june = await makeAvatar(ctx, CAST_LOOKS.june); this.june.setAt(-1.7, 0, -1.8, 0.2); this.june.play('Sit');\n    this.ounceB = place(ctx, 'ounce', -1.3, 0, 1.6, { actors: true, scale: 1.1 }); this.ounceB.object.rotation.y = 0.4;\n    this.kevinB = place(ctx, 'kevin', 0, -9, 0, { actors: true });\n    this.rain = new Precipitation({ kind: 'rain', count: 2400, area: [24, 12, 14] }); ctx.scene.add(this.rain); this.rain.intensity = 0; this.rainGoal = 0;\n  }\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.2, 8.4], target: [0, 1.2, 0], fov: 28 }; }\n  cardInfo() { return { goal: 'Stand. Ninety seconds. Keep the dot in the circle.', prompts: [['lean', 'Lean']] }; }\n  onPlayStart(ctx) { App.music('stand'); }\n  resumeMusic() { App.music(this.lanes[0].sim.t > 75 ? 'swell' : 'stand'); return true; }\n  view(ctx, dt) {\n    const s = this.lanes[0].sim, a = this.lanes[0].avatar;\n    a.lean.x = s.dot.x; a.lean.y = s.dot.y; const over = s.dot.dist() - s.ringR; a.trem = over > 0 ? Math.min(1, over * 4) : 0;\n    this.world.update(ctx, dt);\n    for (const ev of s.fired.splice(0)) {\n      if (ev.say) App.barkLine(ev.say[1], ev.say[0], 3);\n      if (ev.kevin === true) { App.sfx('squawk'); }\n      if (ev.sneeze) { this.dennis.play('Sneeze', { once: true }); App.sfx('sneeze'); }\n      if (ev.clap) { this.marg.play('SlowClap'); this.clapT = 8; }\n      if (ev.rumble) { ctx.engine.shake.add(0.7); App.sfx('rumble'); }\n      if (ev.swell) { App.music('swell'); applySky(ctx.engine, skyAt(17)); App.flash('sand', { duration: 0.4 }); }\n      if (ev.end) { App.sfx('fanfare'); this.coach.play('Bow', { once: true }); }\n    }\n    if (this.clapT > 0) { this.clapT -= dt; this.clapTick = (this.clapTick ?? 0) - dt; if (this.clapTick <= 0) { this.clapTick = 1.33; App.sfx('clap'); } if (this.clapT <= 0) this.marg.play('Idle'); }\n    this.rainGoal = s.rain ? 0.8 : 0; this.rain.intensity += (this.rainGoal - this.rain.intensity) * Math.min(1, dt); this.rain.update(dt, this.target);\n    const k = this.kevinB.object;\n    if (s.kevin) { k.position.set(a.root.position.x, 1.62, 0.8); const w = Math.sin(ctx.time * 3) > 0.9 ? 0.6 : 0; k.getObjectByName('wingL') && (k.getObjectByName('wingL').rotation.z = w); k.getObjectByName('wingR') && (k.getObjectByName('wingR').rotation.z = -w); } else k.position.y = -9;\n    const needle = this.ounceB.object.getObjectByName('needle'); if (needle) needle.rotation.y = Math.PI + Math.sin(ctx.time * 7) * (s.t > 75 ? 0.4 : 0.1);\n    const c = ctx.camera.camera; if (c.isPerspectiveCamera) { c.fov = 28 - Math.min(8, s.t * 0.09); c.updateProjectionMatrix(); }\n    this.marg.update(dt); this.dennis.update(dt); this.june.update(dt);\n  }\n  drawPlay(ctx, hud) {\n    const s = this.lanes[0].sim, W = hud.width;\n    App.dialCenter.x = W / 2; App.dialCenter.y = 56;\n    dial(hud, W / 2, 56, 44, { ringR: s.ringR, x: s.dot.x, y: s.dot.y, inside: s.inside, glow: s.t / 90 });\n    if (s.drift > 0) { const x = W / 2 + 60 - (8 - s.drift) * 16; say(hud, x, 52, 'Are you nearly done?', { color: 'plum', shadow: 'white' }); }\n    this.drawTopBar(hud, Math.round(s.score), `${Math.max(0, Math.ceil(90 - s.t))} s`);\n    if (this.phase === 'play' && !App.attract) promptBar(hud, [['lean', 'Stand'], ['pause', 'Pause']]);\n    void center;\n  }\n}\nE\necho \"- [x] single-player activities: slackline tray jog pier longstand\" >> PROGRESS.md","description":"Write remaining five activities"}}}
