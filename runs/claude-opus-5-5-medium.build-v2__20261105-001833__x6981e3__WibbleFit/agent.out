{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjPxesAqBxJrscz6REmo","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10211,"cache_read_input_tokens":250164,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10211},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"5dc4305a-7f6b-4e88-92a8-cc8e543d062d","timestamp":"2026-11-05T07:36:20.691Z","request_id":"req_011CgjPxeUbmU6C69zDnmBCh","thinking_duration_ms":24419,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjPxesAqBxJrscz6REmo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016HPhx9DrNbHDVLemX5P8UK","name":"Bash","input":{"command":"cat > src/art/stage.js <<'E'\n// Shared set dressing: floors, sea, mats, and the small build helpers every scene uses.\nimport { addModelColliders, buildModel, GrassField, PALETTE, setLookLayer, THREE, toonMaterial, WaterSurface, WAVES_CALM } from '../../pixel-engine.js';\nimport { MODELS } from './models.js';\nimport { tiledPlane } from './textures.js';\nconst { BoxGeometry, Color, CylinderGeometry, Mesh, MeshBasicMaterial, PlaneGeometry } = THREE;\n\nexport const place = (ctx, id, x, y, z, { turn = 0, scale = 1, palette, params, collide = false, actors = false, seed } = {}) => {\n  const b = buildModel(id, { catalog: MODELS, palette, params, seed });\n  b.object.position.set(x, y, z); b.object.rotation.y = (turn * Math.PI) / 180; b.object.scale.setScalar(scale);\n  b.object.updateMatrixWorld(true);\n  if (actors) setLookLayer(b.object, 'actors');\n  ctx.scene.add(b.object);\n  if (collide && scale === 1) addModelColliders(ctx.physics, b, [x, y, z], b.object.rotation.y);\n  return b;\n};\nexport const box = (ctx, x, y, z, w, h, d, color, { collide = false, shadow = true } = {}) => {\n  const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[color]));\n  m.position.set(x, y, z); m.castShadow = shadow; m.receiveShadow = true; ctx.scene.add(m);\n  if (collide) ctx.physics.addStaticBox({ position: [x, y, z], halfExtents: [w / 2, h / 2, d / 2] });\n  return m;\n};\nexport const sky = (ctx, color = PALETTE.sky) => { ctx.scene.background = new Color(color); };\nexport function sea(ctx, w = 120, d = 120, y = -0.25, x = 0, z = 0, ripples = null) {\n  const water = new WaterSurface({ size: [w, d], at: [x, y, z], segments: [Math.min(160, w * 2), Math.min(160, d * 2)], waves: WAVES_CALM, ripples, deep: PALETTE.blue, shallow: PALETTE.sky, foam: PALETTE.white });\n  ctx.scene.add(water); return water;\n}\nexport function tileFloor(ctx, w, d, x = 0, z = 0, y = 0) {\n  const f = tiledPlane(w, d, 'clinic-tile'); f.position.set(x, y, z); ctx.scene.add(f);\n  ctx.physics.addStaticBox({ position: [x, y - 0.5, z], halfExtents: [w / 2, 0.5, d / 2] });\n  return f;\n}\nexport const laneXs = (n) => (n <= 3 ? [-2.2, 0, 2.2] : [-3, -1, 1, 3]);\nexport function laneCamera(n, aspect = 16 / 9) {\n  const k = Math.max(1, (16 / 9) / aspect);\n  if (n <= 3) return { preset: 'fixed', position: [0, 2.3 + (k - 1) * 0.8, 8.2 * k], target: [0, 1.15, 0], fov: 30 };\n  return { preset: 'fixed', position: [0, 3 + (k - 1) * 0.8, 9.5 * k], target: [0, 1, 0], fov: 32 };\n}\nexport function backdrop(ctx, kind) {\n  sky(ctx);\n  ctx.physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [40, 0.5, 40] });\n  const horizon = () => {\n    place(ctx, 'kettlebell-volcano', -14, -1, -34, { scale: 1.4 });\n    place(ctx, 'foam-roller-hill', 16, -1, -30, { scale: 1.2 });\n  };\n  if (kind === 'pavilion' || kind === 'plaza') {\n    const f = tiledPlane(40, 18, 'clinic-tile'); f.position.set(0, 0, -2); ctx.scene.add(f);\n    box(ctx, 0, -0.05, -14, 60, 0.1, 8, 'green', { shadow: false });\n    sea(ctx, 160, 60, -0.25, 0, -40);\n    horizon();\n    if (kind === 'pavilion') {\n      box(ctx, 0, 0.12, -1.8, 4.4, 0.24, 2.2, 'mist');\n      for (const x of [-6.4, 6.4]) { box(ctx, x, 2.3, -3, 0.5, 4.6, 0.5, 'white'); box(ctx, x, 2.3, 1.2, 0.5, 4.6, 0.5, 'white'); }\n      for (const x of [-3.2, 0, 3.2]) box(ctx, x, 4.9, -3, 3, 0.3, 0.4, 'sky');\n      box(ctx, 0, 5.2, -3, 14, 0.25, 0.6, 'sky');\n      box(ctx, -6.4, 5.2, -1, 0.5, 0.25, 5, 'sky'); box(ctx, 6.4, 5.2, -1, 0.5, 0.25, 5, 'sky');\n      box(ctx, -5, 0.9, -3, 2.6, 0.08, 0.08, 'mist'); box(ctx, 5, 0.9, -3, 2.6, 0.08, 0.08, 'mist');\n      for (const [x, z] of [[-6, 2.2], [6, 2.2]]) place(ctx, 'bush', x, 0, z);\n      place(ctx, 'lamp-post', -7.4, 0, -2);\n      place(ctx, 'lamp-post', 7.4, 0, -2);\n    }\n  } else if (kind === 'shed') {\n    const wood = box(ctx, 0, -0.05, 0, 30, 0.1, 16, 'orange', { shadow: false });\n    wood.receiveShadow = true;\n    for (let i = -7; i <= 7; i++) box(ctx, i * 2, 0.002, 0, 0.05, 0.02, 16, 'plum', { shadow: false });\n    box(ctx, 0, 2.6, -4.3, 30, 5.2, 0.4, 'white');\n    box(ctx, 0, 0.4, -4.05, 30, 0.8, 0.1, 'mist');\n    box(ctx, 0, 5.3, -3, 30, 0.4, 3, 'orange');\n    for (const x of [-7.4, 7.4]) { box(ctx, x, 2.6, -2, 0.5, 5.2, 8, 'white'); }\n    for (const [x, c] of [[-6, 'slate'], [-4.9, 'night'], [5, 'night'], [6, 'slate']]) { box(ctx, x, 0.5, -3.3, 0.5, 1, 0.5, c); box(ctx, x, 0.5, -2.5, 0.5, 1, 0.5, c); box(ctx, x, 0.5, -2.9, 0.16, 0.16, 0.8, 'ink'); }\n    place(ctx, 'med-ball', -6, 0, 1.5, { scale: 0.5 }); place(ctx, 'med-ball', 6, 0, 1.4, { scale: 0.42 });\n  } else if (kind === 'beach' || kind === 'lagoon') {\n    box(ctx, 0, -0.1, 0, 44, 0.2, 18, 'sand', { shadow: false });\n    box(ctx, 0, -0.12, -11, 60, 0.2, 6, 'sand', { shadow: false });\n    sea(ctx, 160, 60, -0.25, 0, -38);\n    horizon();\n    if (kind === 'beach') {\n      place(ctx, 'beat-stage', 0, 0, -4.8);\n      place(ctx, 'palm', -7, 0, -3); place(ctx, 'palm', 7.5, 0, -2.2, { turn: 120 }); place(ctx, 'palm', -8.4, 0, 1.4, { turn: 200 });\n      box(ctx, -5.8, 0.03, 2.2, 1.4, 0.05, 0.9, 'red', { shadow: false }); box(ctx, 5.8, 0.03, 1.8, 1.4, 0.05, 0.9, 'sky', { shadow: false });\n    } else {\n      place(ctx, 'palm', -8, 0, -3); place(ctx, 'palm', 7.5, 0, -3.5, { turn: 80 });\n      place(ctx, 'med-ball', 8.2, 0, 0.6, { scale: 0.5 });\n    }\n  }\n}\nexport function grass(ctx, opts) { const g = new GrassField({ base: PALETTE.green, tip: PALETTE.lime, ...opts }); ctx.scene.add(g); return g; }\nexport function needleOf(build) { return build.object.getObjectByName('needle'); }\nexport const makeFlat = (w, d, color) => { const m = new Mesh(new PlaneGeometry(w, d).rotateX(-Math.PI / 2), new MeshBasicMaterial({ color: PALETTE[color] })); return m; };\nexport const cyl = (ctx, r, h, color) => { const m = new Mesh(new CylinderGeometry(r, r, h, 12), toonMaterial(PALETTE[color])); ctx.scene.add(m); return m; };\nE\ncat > src/ui/screens/results.js 2>/dev/null <<'E' || true\nE\nmkdir -p src/ui/screens\ncat > src/scenes/activity/base.js <<'E'\n// The shared flow: intro, practice (first time), countdown, play, outro, Results.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar, PlumbBob } from '../../art/avatar.js';\nimport { backdrop, laneCamera, laneXs, place } from '../../art/stage.js';\nimport { ACTIONS } from '../../core/actions.js';\nimport { blankInput, LocalDriver, makeDriver, BotDriver } from '../../core/drivers.js';\nimport { scoreForStars, starsFor } from '../../core/progress.js';\nimport { ACT, COACH_LINES } from '../../data/activities.js';\nimport { CAST_LOOKS, AVATARS } from '../../data/classmates.js';\nimport { ACTIVITY_LINES } from '../../data/lines.js';\nimport { BaseScene } from '../base.js';\nimport { center, say, textWidth, wrap } from '../../ui/font.js';\nimport { promptBar, promptWidth, prompt } from '../../ui/prompts.js';\nimport { note, panel, stars as drawStars } from '../../ui/widgets.js';\nimport { Results } from '../../ui/screens/results.js';\nconst { Vector3 } = THREE;\n\nexport class ActivityScene extends BaseScene {\n  id = 'activity'; canPause = true; phase = 'intro'; phaseT = 0; lanes = []; playT = 0; mode = 'dropin'; introSeconds = 2.6; practiceSeconds = 8; countdown = 3; outroSeconds = 1.6; finished = false; forced = null; out = blankInput(); v = new Vector3();\n  constructor(args = {}) {\n    super(args);\n    this.def = ACT[args.id ?? 'tree']; this.hard = !!args.hard; this.mode = args.mode ?? (App.slot ? 'week' : 'dropin');\n    this.fp = { hash: 0 };\n  }\n  camera() { return this.cameraConfig?.() ?? laneCamera(3); }\n  // Merged data: activity entry + hard overrides.\n  cfg() { return { ...this.def, ...(this.hard ? this.def.hard : {}) }; }\n  playerLook() { const s = App.slot; if (s?.look) return { ...s.look, items: s.items?.length ? s.look.equipped ?? [] : [] }; return AVATARS[0]; }\n  localDriver(ctx) {\n    this.playerRng = ctx.random.fork('player-bot');\n    return App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(ctx));\n  }\n  onDriverChange() { const l = this.lanes[this.playerLane ?? 0]; if (l) l.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(this.ctx)); }\n  async build(ctx) {\n    this.ctx = ctx;\n    await this.buildStage(ctx);\n    App.music(this.def.song);\n    const rec = (App.slot?.records ?? App.save.data.dropIn)[this.def.id];\n    this.firstTime = !rec || rec.plays === 0;\n    if (this.attract) { this.setPhase('play'); this.onPlayStart?.(ctx); }\n    else this.setPhase('intro');\n    App.dialOwner = this;\n  }\n  setPhase(p) { this.phase = p; this.phaseT = 0; }\n  skipPressed(ctx) { return ctx.input.wasPressed(...ACTIONS.menuConfirm, 'MouseLeft'); }\n  tick(ctx, dt) {\n    if (App.blocked()) return;\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro': break;\n      case 'practice':\n        this.stepLanes(ctx, dt);\n        if (this.phaseT >= this.practiceSeconds || this.practiceSkip) { this.practiceSkip = false; this.resetSims(ctx); this.setPhase('countdown'); this.lastCount = 4; }\n        break;\n      case 'countdown': {\n        const c = Math.ceil(this.countdown - this.phaseT);\n        if (c !== this.lastCount) { this.lastCount = c; App.sfx(c > 0 ? 'countdown' : 'go'); }\n        if (this.phaseT >= this.countdown) { this.setPhase('play'); this.onPlayStart?.(ctx); }\n        break;\n      }\n      case 'play':\n        this.playT += dt;\n        this.stepLanes(ctx, dt);\n        if (this.lanes[this.playerLane ?? 0].sim.done) {\n          if (this.attract) { this.resetSims(ctx); this.playT = 0; this.onPlayStart?.(ctx); break; }\n          this.setPhase('outro'); this.onOutro?.(ctx);\n        }\n        break;\n      case 'outro':\n        if (this.phaseT >= this.outroSeconds && !this.finished) this.finish(ctx);\n        break;\n      default:\n    }\n  }\n  stepLanes(ctx, dt) {\n    for (const l of this.lanes) {\n      if (!l.sim || l.sim.done) continue;\n      l.driver.read(this.out, l.sim, dt);\n      l.sim.step(dt, this.out);\n    }\n  }\n  resetSims(ctx) { for (const l of this.lanes) l.sim = this.makeSim(ctx, l); this.onResetSims?.(ctx); }\n  result() {\n    const s = this.lanes[this.playerLane ?? 0].sim;\n    if (this.forced !== null) return { score: scoreForStars(this.def, this.forced), stars: this.forced, max: s.maxScore?.() ?? 0, forced: true };\n    const r = s.result();\n    const stars = r.stars ?? starsFor(this.cfg(), r.score, r.max ?? 0);\n    return { ...r, stars };\n  }\n  // Dev Tools: finish now with n stars.\n  forceFinish(n) { this.forced = n; const l = this.lanes[this.playerLane ?? 0]; if (l.sim) l.sim.done = true; this.finish(this.ctx); }\n  finish(ctx) {\n    if (this.finished) return; this.finished = true;\n    const r = this.result();\n    const rec = App.recordActivity(this.def, r.score, r.stars, Math.max(1, this.playT), this.mode === 'week' ? 'week' : 'dropin');\n    this.resultData = { ...r, ...rec };\n    App.music('evening');\n    App.open(new Results(this));\n  }\n  // Called by Results.\n  retry() { App.go('activity', { ...this.args, mode: this.mode }); }\n  leave() {\n    if (this.mode === 'week') {\n      if (this.def.id === 'longstand' && App.slot && !App.slot.confessed) App.go('ending');\n      else App.go('hub');\n    } else App.go('title', { page: 'dropin' });\n  }\n  frame(ctx, dt, rdt, free) {\n    if (this.phase === 'intro' && free) {\n      if (this.phaseT >= this.introSeconds * 0.4 && this.skipPressed(ctx)) this.afterIntro();\n      else if (this.phaseT >= 9) this.afterIntro();\n    }\n    if (this.phase === 'practice' && free && this.phaseT > 1 && ctx.input.wasPressed('PadTriangle', 'KeyM')) this.practiceSkip = true;\n    this.view?.(ctx, dt, rdt);\n    this.updateAvatars?.(ctx, dt);\n  }\n  afterIntro() {\n    if (this.firstTime && this.hasPractice !== false) { this.setPhase('practice'); App.barkLine('Try it.', 'coach', 2); }\n    else { this.setPhase('countdown'); this.lastCount = 4; }\n  }\n  // Mats: solo is the centre mat with two classmates; a lane has an avatar, a driver and a sim.\n  async buildLanes(ctx, kind, { coach = true } = {}) {\n    backdrop(ctx, kind);\n    const xs = laneXs(3), rng = ctx.random.fork('classmates');\n    const defs = [{ who: 'dennis', skill: 'average', look: CAST_LOOKS.dennis }, { who: 'player' }, { who: 'marguerite', skill: 'expert', look: CAST_LOOKS.marguerite }];\n    this.playerLane = 1;\n    for (let i = 0; i < 3; i++) {\n      const d = defs[i];\n      const avatar = await makeAvatar(ctx, d.who === 'player' ? this.playerLook() : d.look);\n      avatar.setAt(xs[i], 0, 0.8);\n      place(ctx, 'yoga-mat', xs[i], 0.001, 0.8, { palette: { mat: i === 1 ? 'sky' : 'mist', stripe: 'white' } });\n      const driver = d.who === 'player' ? this.localDriver(ctx) : new BotDriver(this.attract ? 'expert' : d.skill, rng.fork(i));\n      const lane = { i, x: xs[i], z: 0.8, who: d.who, avatar, driver, name: d.who === 'player' ? (App.slot?.name ?? 'You') : d.who };\n      lane.sim = this.makeSim(ctx, lane);\n      this.lanes.push(lane);\n    }\n    if (coach) {\n      this.coach = await makeAvatar(ctx, CAST_LOOKS.coach);\n      this.coach.setAt(1.15, 0.24, -1.7, 0);\n      this.coach.play('Idle');\n      this.bob = new PlumbBob(ctx, this.coach);\n      setTimeout0(() => this.bob?.update(0));\n    }\n  }\n  updateAvatars(ctx, dt) {\n    for (const l of this.lanes) l.avatar?.update(dt);\n    this.coach?.update(dt); this.bob?.update(dt);\n  }\n  screenOf(x, y, z) {\n    const v = this.v.set(x, y, z).project(this.ctx.camera.camera), h = this.ctx.hud;\n    return { x: ((v.x + 1) / 2) * h.width, y: ((1 - v.y) / 2) * h.height };\n  }\n  card() { return this.cardInfo?.() ?? { goal: 'Do your best.', prompts: [] }; }\n  draw(ctx, hud) {\n    const W = hud.width, H = hud.height;\n    if (this.phase === 'intro') {\n      const c = this.card(), lines = wrap(ACTIVITY_LINES[this.def.id]?.[this.firstTime ? 'first' : 'repeat'] ?? '', 40), goal = wrap(c.goal, 44);\n      const h = 40 + lines.length * 10 + goal.length * 10 + c.prompts.length * 14 + 10, w = Math.min(W - 24, 320), x = (W - w) / 2, y = Math.max(12, (H - 16 - h) / 2);\n      panel(hud, x, y, w, h, 'white', 'teal');\n      say(hud, x + 10, y + 6, this.def.name, { color: 'teal', shadow: false, scale: this.def.name.length * 12 > w - 20 ? 1 : 2 });\n      if (this.hard) say(hud, x + w - 40, y + 8, 'Hard', { color: 'red', shadow: false });\n      let yy = y + 26;\n      for (const l of goal) { say(hud, x + 10, yy, l, { color: 'ink', shadow: false }); yy += 10; }\n      yy += 2;\n      for (const [a, v] of c.prompts) { prompt(hud, x + 10, yy, a, v, { color: 'ink', shadow: false }); yy += 14; }\n      yy += 2;\n      for (const l of lines) { say(hud, x + 10, yy, l, { color: 'slate', shadow: false }); yy += 10; }\n      promptBar(hud, [['confirm', 'Begin'], ['pause', 'Pause']]);\n      note(x, y, w, h, 'card');\n      return;\n    }\n    this.drawPlay?.(ctx, hud);\n    if (this.phase === 'practice') {\n      center(hud, H - 44, 'Practice. Nothing counts yet.', { color: 'sand' });\n      promptBar(hud, [['more', 'Skip practice'], ['pause', 'Pause']]);\n    } else if (this.phase === 'countdown') {\n      const n = Math.ceil(this.countdown - this.phaseT);\n      center(hud, H / 2 - 20, String(Math.max(1, n)), { scale: 5, color: 'sand' });\n    } else if (this.phase === 'outro') {\n      center(hud, H / 2 - 8, 'Thank you.', { scale: 2, color: 'white' });\n    } else if (this.phase === 'play' && this.phaseT < 0.8 && !this.attract) {\n      center(hud, H / 2 - 12, 'Go.', { scale: 3, color: 'lime' });\n    }\n  }\n  drawTopBar(hud, score, extra = '') {\n    if (!App.attract) say(hud, 12, 12, this.def.name, { color: 'white' });\n    const s = String(score), w = textWidth(s, 2);\n    say(hud, hud.width - 26 - w, App.attract ? 18 : 12, s, { scale: 2, color: 'sand' });\n    if (extra) say(hud, 12, App.attract ? 18 : 22, extra, { color: 'cyan' });\n  }\n  status(ctx) { const s = this.lanes[this.playerLane ?? 0]?.sim; return `activity ${this.def?.id} | ${this.phase} | t ${(this.playT).toFixed(1)} | score ${s ? Math.round(s.score ?? 0) : 0}`; }\n  debugDot() { const d = this.lanes[this.playerLane ?? 0]?.sim?.dot; return d ? `${d.x.toFixed(2)},${d.y.toFixed(2)}` : '-'; }\n  fingerprint() {\n    return this.lanes.map((l) => { const s = l.sim; return s ? `${(s.score ?? 0).toFixed?.(3) ?? s.score}|${s.dot ? `${s.dot.x.toFixed(4)},${s.dot.y.toFixed(4)}` : ''}|${s.t?.toFixed?.(3) ?? ''}` : ''; }).join(';');\n  }\n  onPause(ctx) { App.ctx.audio.stopMusic?.(); this.pausedMusic = true; }\n  onResume(ctx) { if (this.pausedMusic) { this.pausedMusic = false; if (!this.finished) this.resumeMusic?.(ctx) ?? App.music(this.def.song); else App.music('evening'); } }\n}\nconst setTimeout0 = (fn) => { Promise.resolve().then(fn); };\nexport const coachLine = (scene) => COACH_LINES[scene] ?? [];\nexport const makeBot = (name, rng) => makeDriver(name, rng);\nE\ncat > src/ui/screens/results.js <<'E'\n// Results: stars pop in one by one, score, Drips, a line, classmates. Retry / Next / Back.\nimport { ACTIONS } from '../../core/actions.js';\nimport { App } from '../../app.js';\nimport { ACT, ACTIVITIES, STATION_ACTS } from '../../data/activities.js';\nimport { isOpen } from '../../core/progress.js';\nimport { ACTIVITY_LINES, BARKS } from '../../data/lines.js';\nimport { center, say, textWidth, wrap } from '../font.js';\nimport { Menu } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { panel, star, note } from '../widgets.js';\n\nexport class Results {\n  id = 'results'; t = 0; shown = 0; attractable = false;\n  constructor(scene) {\n    this.scene = scene; this.data = scene.resultData; this.def = scene.def;\n    const lines = ACTIVITY_LINES[this.def.id] ?? ACTIVITY_LINES.tree;\n    this.line = lines[`s${this.data.stars}`] ?? lines.s0;\n    this.extra = [];\n    for (const who of this.data.beat ?? []) this.extra.push(BARKS.beat[who]);\n    if (this.data.goalNow) this.extra.push(BARKS.goal[0]);\n    for (const m of this.data.milestones ?? []) this.extra.push(m.remark);\n    const items = [{ label: 'Retry', on: () => scene.retry() }];\n    const next = this.nextAct();\n    if (next) items.push({ label: `Next: ${next.name}`, on: () => App.go('activity', { id: next.id, mode: scene.mode, hard: scene.hard }) });\n    items.push({ label: scene.mode === 'week' ? (this.def.id === 'longstand' && App.slot && !App.slot.confessed ? 'Continue' : 'Back to the island') : 'Back', on: () => scene.leave() });\n    if (this.def.id === 'longstand' && scene.mode === 'week' && App.slot && !App.slot.confessed) items.splice(0, items.length - 1);\n    this.menu = new Menu({ items, scale: 1, rowH: 14, onBack: () => scene.leave() });\n    App.say(this.line, 'ounce');\n  }\n  nextAct() {\n    if (this.scene.mode !== 'week') { const i = ACTIVITIES.indexOf(this.def); return ACTIVITIES[(i + 1) % ACTIVITIES.length]; }\n    const list = STATION_ACTS(this.def.station), i = list.indexOf(this.def);\n    for (let k = i + 1; k < list.length; k++) if (isOpen(App.slot, list[k].id)) return list[k];\n    return null;\n  }\n  update(ctx, dt) {\n    this.t += dt;\n    const want = Math.min(this.data.stars, Math.floor(this.t / 0.45));\n    if (want > this.shown) { this.shown = want; App.sfx('starPop', { pitch: this.shown * 2 }); }\n    if (this.t > 0.2) this.menu.update(ctx, dt);\n  }\n  draw(hud) {\n    const W = hud.width, H = hud.height, w = Math.min(W - 24, 340), x = Math.round((W - w) / 2), y = 12, h = H - 40 - 12;\n    panel(hud, x, y, w, h, 'white', 'teal');\n    say(hud, x + 10, y + 6, this.def.name, { color: 'teal', shadow: false, scale: this.def.name.length * 12 > w - 20 ? 1 : 2 });\n    // Stars, the one focal element.\n    const sc = 2, sw = 33 * sc, sx = Math.round(W / 2 - sw / 2), sy = y + 26;\n    for (let i = 0; i < 3; i++) star(hud, sx + i * 11 * sc, sy, i < this.shown, sc);\n    const sv = String(Math.round(this.data.score));\n    center(hud, sy + 22, sv, { scale: 2, color: 'ink', shadow: false });\n    let ty = sy + 42;\n    for (const l of wrap(this.line, 52)) { center(hud, ty, l, { color: 'slate', shadow: false }); ty += 10; }\n    ty += 2;\n    if (this.data.drips > 0) { center(hud, ty, `+${this.data.drips} Drips`, { color: 'teal', shadow: false }); ty += 11; }\n    const r = this.def.rivals;\n    center(hud, ty, `Dennis ${r.dennis}  June ${r.june}  Marguerite ${r.marguerite}`, { color: 'slate', shadow: false }); ty += 11;\n    for (const e of this.extra.slice(0, 2)) for (const l of wrap(e, 52).slice(0, 2)) { center(hud, ty, l, { color: 'plum', shadow: false }); ty += 10; }\n    this.menu.y = Math.max(ty + 2, H - 40 - 6 - this.menu.items.length * 14 - 12);\n    this.menu.draw(hud);\n    promptBar(hud, [['confirm', 'Select'], ['back', 'Back']]);\n    note(x, y, w, h, 'results');\n  }\n}\nE\necho \"- [x] activity base, stage helpers, results\" >> PROGRESS.md","description":"Write activity flow, staging helpers, results"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10211,"cache_read_input_tokens":250164,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10211},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"8d7f4e44-0bf1-4d6c-873e-b79786d42562","timestamp":"2026-11-05T07:37:39.035Z","request_id":"req_011CgjPxeUbmU6C69zDnmBCh","wire_tool_inputs":{"toolu_016HPhx9DrNbHDVLemX5P8UK":{"command":"cat > src/art/stage.js <<'E'\n// Shared set dressing: floors, sea, mats, and the small build helpers every scene uses.\nimport { addModelColliders, buildModel, GrassField, PALETTE, setLookLayer, THREE, toonMaterial, WaterSurface, WAVES_CALM } from '../../pixel-engine.js';\nimport { MODELS } from './models.js';\nimport { tiledPlane } from './textures.js';\nconst { BoxGeometry, Color, CylinderGeometry, Mesh, MeshBasicMaterial, PlaneGeometry } = THREE;\n\nexport const place = (ctx, id, x, y, z, { turn = 0, scale = 1, palette, params, collide = false, actors = false, seed } = {}) => {\n  const b = buildModel(id, { catalog: MODELS, palette, params, seed });\n  b.object.position.set(x, y, z); b.object.rotation.y = (turn * Math.PI) / 180; b.object.scale.setScalar(scale);\n  b.object.updateMatrixWorld(true);\n  if (actors) setLookLayer(b.object, 'actors');\n  ctx.scene.add(b.object);\n  if (collide && scale === 1) addModelColliders(ctx.physics, b, [x, y, z], b.object.rotation.y);\n  return b;\n};\nexport const box = (ctx, x, y, z, w, h, d, color, { collide = false, shadow = true } = {}) => {\n  const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[color]));\n  m.position.set(x, y, z); m.castShadow = shadow; m.receiveShadow = true; ctx.scene.add(m);\n  if (collide) ctx.physics.addStaticBox({ position: [x, y, z], halfExtents: [w / 2, h / 2, d / 2] });\n  return m;\n};\nexport const sky = (ctx, color = PALETTE.sky) => { ctx.scene.background = new Color(color); };\nexport function sea(ctx, w = 120, d = 120, y = -0.25, x = 0, z = 0, ripples = null) {\n  const water = new WaterSurface({ size: [w, d], at: [x, y, z], segments: [Math.min(160, w * 2), Math.min(160, d * 2)], waves: WAVES_CALM, ripples, deep: PALETTE.blue, shallow: PALETTE.sky, foam: PALETTE.white });\n  ctx.scene.add(water); return water;\n}\nexport function tileFloor(ctx, w, d, x = 0, z = 0, y = 0) {\n  const f = tiledPlane(w, d, 'clinic-tile'); f.position.set(x, y, z); ctx.scene.add(f);\n  ctx.physics.addStaticBox({ position: [x, y - 0.5, z], halfExtents: [w / 2, 0.5, d / 2] });\n  return f;\n}\nexport const laneXs = (n) => (n <= 3 ? [-2.2, 0, 2.2] : [-3, -1, 1, 3]);\nexport function laneCamera(n, aspect = 16 / 9) {\n  const k = Math.max(1, (16 / 9) / aspect);\n  if (n <= 3) return { preset: 'fixed', position: [0, 2.3 + (k - 1) * 0.8, 8.2 * k], target: [0, 1.15, 0], fov: 30 };\n  return { preset: 'fixed', position: [0, 3 + (k - 1) * 0.8, 9.5 * k], target: [0, 1, 0], fov: 32 };\n}\nexport function backdrop(ctx, kind) {\n  sky(ctx);\n  ctx.physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [40, 0.5, 40] });\n  const horizon = () => {\n    place(ctx, 'kettlebell-volcano', -14, -1, -34, { scale: 1.4 });\n    place(ctx, 'foam-roller-hill', 16, -1, -30, { scale: 1.2 });\n  };\n  if (kind === 'pavilion' || kind === 'plaza') {\n    const f = tiledPlane(40, 18, 'clinic-tile'); f.position.set(0, 0, -2); ctx.scene.add(f);\n    box(ctx, 0, -0.05, -14, 60, 0.1, 8, 'green', { shadow: false });\n    sea(ctx, 160, 60, -0.25, 0, -40);\n    horizon();\n    if (kind === 'pavilion') {\n      box(ctx, 0, 0.12, -1.8, 4.4, 0.24, 2.2, 'mist');\n      for (const x of [-6.4, 6.4]) { box(ctx, x, 2.3, -3, 0.5, 4.6, 0.5, 'white'); box(ctx, x, 2.3, 1.2, 0.5, 4.6, 0.5, 'white'); }\n      for (const x of [-3.2, 0, 3.2]) box(ctx, x, 4.9, -3, 3, 0.3, 0.4, 'sky');\n      box(ctx, 0, 5.2, -3, 14, 0.25, 0.6, 'sky');\n      box(ctx, -6.4, 5.2, -1, 0.5, 0.25, 5, 'sky'); box(ctx, 6.4, 5.2, -1, 0.5, 0.25, 5, 'sky');\n      box(ctx, -5, 0.9, -3, 2.6, 0.08, 0.08, 'mist'); box(ctx, 5, 0.9, -3, 2.6, 0.08, 0.08, 'mist');\n      for (const [x, z] of [[-6, 2.2], [6, 2.2]]) place(ctx, 'bush', x, 0, z);\n      place(ctx, 'lamp-post', -7.4, 0, -2);\n      place(ctx, 'lamp-post', 7.4, 0, -2);\n    }\n  } else if (kind === 'shed') {\n    const wood = box(ctx, 0, -0.05, 0, 30, 0.1, 16, 'orange', { shadow: false });\n    wood.receiveShadow = true;\n    for (let i = -7; i <= 7; i++) box(ctx, i * 2, 0.002, 0, 0.05, 0.02, 16, 'plum', { shadow: false });\n    box(ctx, 0, 2.6, -4.3, 30, 5.2, 0.4, 'white');\n    box(ctx, 0, 0.4, -4.05, 30, 0.8, 0.1, 'mist');\n    box(ctx, 0, 5.3, -3, 30, 0.4, 3, 'orange');\n    for (const x of [-7.4, 7.4]) { box(ctx, x, 2.6, -2, 0.5, 5.2, 8, 'white'); }\n    for (const [x, c] of [[-6, 'slate'], [-4.9, 'night'], [5, 'night'], [6, 'slate']]) { box(ctx, x, 0.5, -3.3, 0.5, 1, 0.5, c); box(ctx, x, 0.5, -2.5, 0.5, 1, 0.5, c); box(ctx, x, 0.5, -2.9, 0.16, 0.16, 0.8, 'ink'); }\n    place(ctx, 'med-ball', -6, 0, 1.5, { scale: 0.5 }); place(ctx, 'med-ball', 6, 0, 1.4, { scale: 0.42 });\n  } else if (kind === 'beach' || kind === 'lagoon') {\n    box(ctx, 0, -0.1, 0, 44, 0.2, 18, 'sand', { shadow: false });\n    box(ctx, 0, -0.12, -11, 60, 0.2, 6, 'sand', { shadow: false });\n    sea(ctx, 160, 60, -0.25, 0, -38);\n    horizon();\n    if (kind === 'beach') {\n      place(ctx, 'beat-stage', 0, 0, -4.8);\n      place(ctx, 'palm', -7, 0, -3); place(ctx, 'palm', 7.5, 0, -2.2, { turn: 120 }); place(ctx, 'palm', -8.4, 0, 1.4, { turn: 200 });\n      box(ctx, -5.8, 0.03, 2.2, 1.4, 0.05, 0.9, 'red', { shadow: false }); box(ctx, 5.8, 0.03, 1.8, 1.4, 0.05, 0.9, 'sky', { shadow: false });\n    } else {\n      place(ctx, 'palm', -8, 0, -3); place(ctx, 'palm', 7.5, 0, -3.5, { turn: 80 });\n      place(ctx, 'med-ball', 8.2, 0, 0.6, { scale: 0.5 });\n    }\n  }\n}\nexport function grass(ctx, opts) { const g = new GrassField({ base: PALETTE.green, tip: PALETTE.lime, ...opts }); ctx.scene.add(g); return g; }\nexport function needleOf(build) { return build.object.getObjectByName('needle'); }\nexport const makeFlat = (w, d, color) => { const m = new Mesh(new PlaneGeometry(w, d).rotateX(-Math.PI / 2), new MeshBasicMaterial({ color: PALETTE[color] })); return m; };\nexport const cyl = (ctx, r, h, color) => { const m = new Mesh(new CylinderGeometry(r, r, h, 12), toonMaterial(PALETTE[color])); ctx.scene.add(m); return m; };\nE\ncat > src/ui/screens/results.js 2>/dev/null <<'E' || true\nE\nmkdir -p src/ui/screens\ncat > src/scenes/activity/base.js <<'E'\n// The shared flow: intro, practice (first time), countdown, play, outro, Results.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { makeAvatar, PlumbBob } from '../../art/avatar.js';\nimport { backdrop, laneCamera, laneXs, place } from '../../art/stage.js';\nimport { ACTIONS } from '../../core/actions.js';\nimport { blankInput, LocalDriver, makeDriver, BotDriver } from '../../core/drivers.js';\nimport { scoreForStars, starsFor } from '../../core/progress.js';\nimport { ACT, COACH_LINES } from '../../data/activities.js';\nimport { CAST_LOOKS, AVATARS } from '../../data/classmates.js';\nimport { ACTIVITY_LINES } from '../../data/lines.js';\nimport { BaseScene } from '../base.js';\nimport { center, say, textWidth, wrap } from '../../ui/font.js';\nimport { promptBar, promptWidth, prompt } from '../../ui/prompts.js';\nimport { note, panel, stars as drawStars } from '../../ui/widgets.js';\nimport { Results } from '../../ui/screens/results.js';\nconst { Vector3 } = THREE;\n\nexport class ActivityScene extends BaseScene {\n  id = 'activity'; canPause = true; phase = 'intro'; phaseT = 0; lanes = []; playT = 0; mode = 'dropin'; introSeconds = 2.6; practiceSeconds = 8; countdown = 3; outroSeconds = 1.6; finished = false; forced = null; out = blankInput(); v = new Vector3();\n  constructor(args = {}) {\n    super(args);\n    this.def = ACT[args.id ?? 'tree']; this.hard = !!args.hard; this.mode = args.mode ?? (App.slot ? 'week' : 'dropin');\n    this.fp = { hash: 0 };\n  }\n  camera() { return this.cameraConfig?.() ?? laneCamera(3); }\n  // Merged data: activity entry + hard overrides.\n  cfg() { return { ...this.def, ...(this.hard ? this.def.hard : {}) }; }\n  playerLook() { const s = App.slot; if (s?.look) return { ...s.look, items: s.items?.length ? s.look.equipped ?? [] : [] }; return AVATARS[0]; }\n  localDriver(ctx) {\n    this.playerRng = ctx.random.fork('player-bot');\n    return App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(ctx));\n  }\n  onDriverChange() { const l = this.lanes[this.playerLane ?? 0]; if (l) l.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(this.ctx)); }\n  async build(ctx) {\n    this.ctx = ctx;\n    await this.buildStage(ctx);\n    App.music(this.def.song);\n    const rec = (App.slot?.records ?? App.save.data.dropIn)[this.def.id];\n    this.firstTime = !rec || rec.plays === 0;\n    if (this.attract) { this.setPhase('play'); this.onPlayStart?.(ctx); }\n    else this.setPhase('intro');\n    App.dialOwner = this;\n  }\n  setPhase(p) { this.phase = p; this.phaseT = 0; }\n  skipPressed(ctx) { return ctx.input.wasPressed(...ACTIONS.menuConfirm, 'MouseLeft'); }\n  tick(ctx, dt) {\n    if (App.blocked()) return;\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro': break;\n      case 'practice':\n        this.stepLanes(ctx, dt);\n        if (this.phaseT >= this.practiceSeconds || this.practiceSkip) { this.practiceSkip = false; this.resetSims(ctx); this.setPhase('countdown'); this.lastCount = 4; }\n        break;\n      case 'countdown': {\n        const c = Math.ceil(this.countdown - this.phaseT);\n        if (c !== this.lastCount) { this.lastCount = c; App.sfx(c > 0 ? 'countdown' : 'go'); }\n        if (this.phaseT >= this.countdown) { this.setPhase('play'); this.onPlayStart?.(ctx); }\n        break;\n      }\n      case 'play':\n        this.playT += dt;\n        this.stepLanes(ctx, dt);\n        if (this.lanes[this.playerLane ?? 0].sim.done) {\n          if (this.attract) { this.resetSims(ctx); this.playT = 0; this.onPlayStart?.(ctx); break; }\n          this.setPhase('outro'); this.onOutro?.(ctx);\n        }\n        break;\n      case 'outro':\n        if (this.phaseT >= this.outroSeconds && !this.finished) this.finish(ctx);\n        break;\n      default:\n    }\n  }\n  stepLanes(ctx, dt) {\n    for (const l of this.lanes) {\n      if (!l.sim || l.sim.done) continue;\n      l.driver.read(this.out, l.sim, dt);\n      l.sim.step(dt, this.out);\n    }\n  }\n  resetSims(ctx) { for (const l of this.lanes) l.sim = this.makeSim(ctx, l); this.onResetSims?.(ctx); }\n  result() {\n    const s = this.lanes[this.playerLane ?? 0].sim;\n    if (this.forced !== null) return { score: scoreForStars(this.def, this.forced), stars: this.forced, max: s.maxScore?.() ?? 0, forced: true };\n    const r = s.result();\n    const stars = r.stars ?? starsFor(this.cfg(), r.score, r.max ?? 0);\n    return { ...r, stars };\n  }\n  // Dev Tools: finish now with n stars.\n  forceFinish(n) { this.forced = n; const l = this.lanes[this.playerLane ?? 0]; if (l.sim) l.sim.done = true; this.finish(this.ctx); }\n  finish(ctx) {\n    if (this.finished) return; this.finished = true;\n    const r = this.result();\n    const rec = App.recordActivity(this.def, r.score, r.stars, Math.max(1, this.playT), this.mode === 'week' ? 'week' : 'dropin');\n    this.resultData = { ...r, ...rec };\n    App.music('evening');\n    App.open(new Results(this));\n  }\n  // Called by Results.\n  retry() { App.go('activity', { ...this.args, mode: this.mode }); }\n  leave() {\n    if (this.mode === 'week') {\n      if (this.def.id === 'longstand' && App.slot && !App.slot.confessed) App.go('ending');\n      else App.go('hub');\n    } else App.go('title', { page: 'dropin' });\n  }\n  frame(ctx, dt, rdt, free) {\n    if (this.phase === 'intro' && free) {\n      if (this.phaseT >= this.introSeconds * 0.4 && this.skipPressed(ctx)) this.afterIntro();\n      else if (this.phaseT >= 9) this.afterIntro();\n    }\n    if (this.phase === 'practice' && free && this.phaseT > 1 && ctx.input.wasPressed('PadTriangle', 'KeyM')) this.practiceSkip = true;\n    this.view?.(ctx, dt, rdt);\n    this.updateAvatars?.(ctx, dt);\n  }\n  afterIntro() {\n    if (this.firstTime && this.hasPractice !== false) { this.setPhase('practice'); App.barkLine('Try it.', 'coach', 2); }\n    else { this.setPhase('countdown'); this.lastCount = 4; }\n  }\n  // Mats: solo is the centre mat with two classmates; a lane has an avatar, a driver and a sim.\n  async buildLanes(ctx, kind, { coach = true } = {}) {\n    backdrop(ctx, kind);\n    const xs = laneXs(3), rng = ctx.random.fork('classmates');\n    const defs = [{ who: 'dennis', skill: 'average', look: CAST_LOOKS.dennis }, { who: 'player' }, { who: 'marguerite', skill: 'expert', look: CAST_LOOKS.marguerite }];\n    this.playerLane = 1;\n    for (let i = 0; i < 3; i++) {\n      const d = defs[i];\n      const avatar = await makeAvatar(ctx, d.who === 'player' ? this.playerLook() : d.look);\n      avatar.setAt(xs[i], 0, 0.8);\n      place(ctx, 'yoga-mat', xs[i], 0.001, 0.8, { palette: { mat: i === 1 ? 'sky' : 'mist', stripe: 'white' } });\n      const driver = d.who === 'player' ? this.localDriver(ctx) : new BotDriver(this.attract ? 'expert' : d.skill, rng.fork(i));\n      const lane = { i, x: xs[i], z: 0.8, who: d.who, avatar, driver, name: d.who === 'player' ? (App.slot?.name ?? 'You') : d.who };\n      lane.sim = this.makeSim(ctx, lane);\n      this.lanes.push(lane);\n    }\n    if (coach) {\n      this.coach = await makeAvatar(ctx, CAST_LOOKS.coach);\n      this.coach.setAt(1.15, 0.24, -1.7, 0);\n      this.coach.play('Idle');\n      this.bob = new PlumbBob(ctx, this.coach);\n      setTimeout0(() => this.bob?.update(0));\n    }\n  }\n  updateAvatars(ctx, dt) {\n    for (const l of this.lanes) l.avatar?.update(dt);\n    this.coach?.update(dt); this.bob?.update(dt);\n  }\n  screenOf(x, y, z) {\n    const v = this.v.set(x, y, z).project(this.ctx.camera.camera), h = this.ctx.hud;\n    return { x: ((v.x + 1) / 2) * h.width, y: ((1 - v.y) / 2) * h.height };\n  }\n  card() { return this.cardInfo?.() ?? { goal: 'Do your best.', prompts: [] }; }\n  draw(ctx, hud) {\n    const W = hud.width, H = hud.height;\n    if (this.phase === 'intro') {\n      const c = this.card(), lines = wrap(ACTIVITY_LINES[this.def.id]?.[this.firstTime ? 'first' : 'repeat'] ?? '', 40), goal = wrap(c.goal, 44);\n      const h = 40 + lines.length * 10 + goal.length * 10 + c.prompts.length * 14 + 10, w = Math.min(W - 24, 320), x = (W - w) / 2, y = Math.max(12, (H - 16 - h) / 2);\n      panel(hud, x, y, w, h, 'white', 'teal');\n      say(hud, x + 10, y + 6, this.def.name, { color: 'teal', shadow: false, scale: this.def.name.length * 12 > w - 20 ? 1 : 2 });\n      if (this.hard) say(hud, x + w - 40, y + 8, 'Hard', { color: 'red', shadow: false });\n      let yy = y + 26;\n      for (const l of goal) { say(hud, x + 10, yy, l, { color: 'ink', shadow: false }); yy += 10; }\n      yy += 2;\n      for (const [a, v] of c.prompts) { prompt(hud, x + 10, yy, a, v, { color: 'ink', shadow: false }); yy += 14; }\n      yy += 2;\n      for (const l of lines) { say(hud, x + 10, yy, l, { color: 'slate', shadow: false }); yy += 10; }\n      promptBar(hud, [['confirm', 'Begin'], ['pause', 'Pause']]);\n      note(x, y, w, h, 'card');\n      return;\n    }\n    this.drawPlay?.(ctx, hud);\n    if (this.phase === 'practice') {\n      center(hud, H - 44, 'Practice. Nothing counts yet.', { color: 'sand' });\n      promptBar(hud, [['more', 'Skip practice'], ['pause', 'Pause']]);\n    } else if (this.phase === 'countdown') {\n      const n = Math.ceil(this.countdown - this.phaseT);\n      center(hud, H / 2 - 20, String(Math.max(1, n)), { scale: 5, color: 'sand' });\n    } else if (this.phase === 'outro') {\n      center(hud, H / 2 - 8, 'Thank you.', { scale: 2, color: 'white' });\n    } else if (this.phase === 'play' && this.phaseT < 0.8 && !this.attract) {\n      center(hud, H / 2 - 12, 'Go.', { scale: 3, color: 'lime' });\n    }\n  }\n  drawTopBar(hud, score, extra = '') {\n    if (!App.attract) say(hud, 12, 12, this.def.name, { color: 'white' });\n    const s = String(score), w = textWidth(s, 2);\n    say(hud, hud.width - 26 - w, App.attract ? 18 : 12, s, { scale: 2, color: 'sand' });\n    if (extra) say(hud, 12, App.attract ? 18 : 22, extra, { color: 'cyan' });\n  }\n  status(ctx) { const s = this.lanes[this.playerLane ?? 0]?.sim; return `activity ${this.def?.id} | ${this.phase} | t ${(this.playT).toFixed(1)} | score ${s ? Math.round(s.score ?? 0) : 0}`; }\n  debugDot() { const d = this.lanes[this.playerLane ?? 0]?.sim?.dot; return d ? `${d.x.toFixed(2)},${d.y.toFixed(2)}` : '-'; }\n  fingerprint() {\n    return this.lanes.map((l) => { const s = l.sim; return s ? `${(s.score ?? 0).toFixed?.(3) ?? s.score}|${s.dot ? `${s.dot.x.toFixed(4)},${s.dot.y.toFixed(4)}` : ''}|${s.t?.toFixed?.(3) ?? ''}` : ''; }).join(';');\n  }\n  onPause(ctx) { App.ctx.audio.stopMusic?.(); this.pausedMusic = true; }\n  onResume(ctx) { if (this.pausedMusic) { this.pausedMusic = false; if (!this.finished) this.resumeMusic?.(ctx) ?? App.music(this.def.song); else App.music('evening'); } }\n}\nconst setTimeout0 = (fn) => { Promise.resolve().then(fn); };\nexport const coachLine = (scene) => COACH_LINES[scene] ?? [];\nexport const makeBot = (name, rng) => makeDriver(name, rng);\nE\ncat > src/ui/screens/results.js <<'E'\n// Results: stars pop in one by one, score, Drips, a line, classmates. Retry / Next / Back.\nimport { ACTIONS } from '../../core/actions.js';\nimport { App } from '../../app.js';\nimport { ACT, ACTIVITIES, STATION_ACTS } from '../../data/activities.js';\nimport { isOpen } from '../../core/progress.js';\nimport { ACTIVITY_LINES, BARKS } from '../../data/lines.js';\nimport { center, say, textWidth, wrap } from '../font.js';\nimport { Menu } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { panel, star, note } from '../widgets.js';\n\nexport class Results {\n  id = 'results'; t = 0; shown = 0; attractable = false;\n  constructor(scene) {\n    this.scene = scene; this.data = scene.resultData; this.def = scene.def;\n    const lines = ACTIVITY_LINES[this.def.id] ?? ACTIVITY_LINES.tree;\n    this.line = lines[`s${this.data.stars}`] ?? lines.s0;\n    this.extra = [];\n    for (const who of this.data.beat ?? []) this.extra.push(BARKS.beat[who]);\n    if (this.data.goalNow) this.extra.push(BARKS.goal[0]);\n    for (const m of this.data.milestones ?? []) this.extra.push(m.remark);\n    const items = [{ label: 'Retry', on: () => scene.retry() }];\n    const next = this.nextAct();\n    if (next) items.push({ label: `Next: ${next.name}`, on: () => App.go('activity', { id: next.id, mode: scene.mode, hard: scene.hard }) });\n    items.push({ label: scene.mode === 'week' ? (this.def.id === 'longstand' && App.slot && !App.slot.confessed ? 'Continue' : 'Back to the island') : 'Back', on: () => scene.leave() });\n    if (this.def.id === 'longstand' && scene.mode === 'week' && App.slot && !App.slot.confessed) items.splice(0, items.length - 1);\n    this.menu = new Menu({ items, scale: 1, rowH: 14, onBack: () => scene.leave() });\n    App.say(this.line, 'ounce');\n  }\n  nextAct() {\n    if (this.scene.mode !== 'week') { const i = ACTIVITIES.indexOf(this.def); return ACTIVITIES[(i + 1) % ACTIVITIES.length]; }\n    const list = STATION_ACTS(this.def.station), i = list.indexOf(this.def);\n    for (let k = i + 1; k < list.length; k++) if (isOpen(App.slot, list[k].id)) return list[k];\n    return null;\n  }\n  update(ctx, dt) {\n    this.t += dt;\n    const want = Math.min(this.data.stars, Math.floor(this.t / 0.45));\n    if (want > this.shown) { this.shown = want; App.sfx('starPop', { pitch: this.shown * 2 }); }\n    if (this.t > 0.2) this.menu.update(ctx, dt);\n  }\n  draw(hud) {\n    const W = hud.width, H = hud.height, w = Math.min(W - 24, 340), x = Math.round((W - w) / 2), y = 12, h = H - 40 - 12;\n    panel(hud, x, y, w, h, 'white', 'teal');\n    say(hud, x + 10, y + 6, this.def.name, { color: 'teal', shadow: false, scale: this.def.name.length * 12 > w - 20 ? 1 : 2 });\n    // Stars, the one focal element.\n    const sc = 2, sw = 33 * sc, sx = Math.round(W / 2 - sw / 2), sy = y + 26;\n    for (let i = 0; i < 3; i++) star(hud, sx + i * 11 * sc, sy, i < this.shown, sc);\n    const sv = String(Math.round(this.data.score));\n    center(hud, sy + 22, sv, { scale: 2, color: 'ink', shadow: false });\n    let ty = sy + 42;\n    for (const l of wrap(this.line, 52)) { center(hud, ty, l, { color: 'slate', shadow: false }); ty += 10; }\n    ty += 2;\n    if (this.data.drips > 0) { center(hud, ty, `+${this.data.drips} Drips`, { color: 'teal', shadow: false }); ty += 11; }\n    const r = this.def.rivals;\n    center(hud, ty, `Dennis ${r.dennis}  June ${r.june}  Marguerite ${r.marguerite}`, { color: 'slate', shadow: false }); ty += 11;\n    for (const e of this.extra.slice(0, 2)) for (const l of wrap(e, 52).slice(0, 2)) { center(hud, ty, l, { color: 'plum', shadow: false }); ty += 10; }\n    this.menu.y = Math.max(ty + 2, H - 40 - 6 - this.menu.items.length * 14 - 12);\n    this.menu.draw(hud);\n    promptBar(hud, [['confirm', 'Select'], ['back', 'Back']]);\n    note(x, y, w, h, 'results');\n  }\n}\nE\necho \"- [x] activity base, stage helpers, results\" >> PROGRESS.md","description":"Write activity flow, staging helpers, results"}}}
