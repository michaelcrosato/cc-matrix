 - - - - - A2 - - - - - - -', bell: '. . A4 . . . . . . E5 . . . . . .' },\n    b: { pad: 'G2 - - - - - - - D3 - - - - - - -', bell: '. . . . D5 . . . . . A4 . . . . .' },\n  }, order: ['a', 'b'] },\n  shed: { bpm: 110, tracks: { bass: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.6 }, stab: { wave: 'triangle', decay: 0.1, volume: 0.5 }, hat, kick, snare }, patterns: {\n    a: { bass: 'E2 . . E2 . G2 . A2 . . E2 . D2 . E2 .', stab: '. . B3 . . . . . . . D4 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . . . . C2 . . C2 . . . . .', snare: '. . . . C6 . . . . . . . C6 . . .' },\n    b: { bass: 'A2 . . A2 . C3 . D3 . . A2 . G2 . E2 .', stab: '. . E4 . . . . . . . G4 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 .', kick: 'C2 . . . . . . C2 . . C2 . . . . .', snare: '. . . . C6 . . . . . . . C6 . C6 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  hoop: { bpm: 124, tracks: { lead, bass: { wave: 'triangle', decay: 0.14, volume: 0.7 }, kick, hat }, patterns: {\n    a: { lead: 'C5 . E5 . G5 . E5 . A5 . G5 . E5 . C5 .', bass: 'C3 . C3 . C3 . C3 . A2 . A2 . A2 . A2 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n    b: { lead: 'F5 . A5 . G5 . E5 . D5 . E5 . G5 . . .', bass: 'F2 . F2 . F2 . F2 . G2 . G2 . G2 . G2 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', hat: '. . C8 . . . C8 . . . C8 . C8 C8 C8 .' },\n  }, order: ['a', 'a', 'b', 'a', 'a', 'b'] },\n  step: (() => { const kk = 'C2 . . . C2 . . . C2 . . . C2 . . .', hh = '. . C8 . . . C8 . . . C8 . . . C8 .';\n    const P = {\n      i: { lead: '. . . . . . . . . . . . . . . .', bass: 'G2 . . . G2 . . . G2 . . . G2 . . .', kick: kk, hat: hh },\n      v1: { lead: 'B4 . . D5 . . G5 . . F#5 . D5 . . B4 .', bass: 'G2 . G2 . G2 . G2 . G2 . G2 . G2 . G2 .', kick: kk, hat: hh },\n      v2: { lead: 'C5 . . E5 . . A5 . . G5 . E5 . . C5 .', bass: 'A2 . A2 . A2 . A2 . D3 . D3 . D3 . D3 .', kick: kk, hat: hh },\n      c1: { lead: 'G5 . G5 . A5 . G5 . E5 . D5 . E5 . G5 .', bass: 'C3 . C3 . C3 . C3 . D3 . D3 . D3 . D3 .', kick: kk, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n      c2: { lead: 'B5 . A5 . G5 . E5 . D5 . E5 . G5 . . .', bass: 'E3 . E3 . E3 . E3 . G2 . G2 . G2 . G2 .', kick: kk, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n      br: { lead: 'D5 . . . . . . . A4 . . . . . . .', bass: 'D3 . . . . . . . D3 . . . . . . .', kick: 'C2 . . . . . . . C2 . . . . . . .', hat: '. . . . . . . . . . . . C8 . C8 .' },\n    };\n    return { bpm: 104, tracks: { lead, bass: { wave: 'triangle', decay: 0.13, volume: 0.7 }, kick, hat }, patterns: P,\n      order: ['i', 'i', 'i', 'i', 'v1', 'v2', 'v1', 'v2', 'v1', 'v2', 'v1', 'v2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'br', 'br', 'br', 'br', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2'] }; })(),\n  lagoon: { bpm: 120, tracks: { uke: { wave: 'triangle', decay: 0.09, volume: 0.66 }, bass: { wave: 'triangle', decay: 0.16, volume: 0.56 }, tick: { ...hat, volume: 0.2 } }, patterns: {\n    a: { uke: 'C5 . E5 G5 . E5 C5 . F5 . A5 C6 . A5 F5 .', bass: 'C3 . . . G2 . . . F2 . . . C3 . . .', tick: 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .' },\n    b: { uke: 'G4 . B4 D5 . B4 G4 . C5 . E5 G5 . E5 C5 .', bass: 'G2 . . . D3 . . . C3 . . . G2 . . .', tick: 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  jog: { bpm: 112, tracks: { lead: { ...lead, volume: 0.36 }, pluck: { ...pluck, volume: 0.42, decay: 0.12 }, bass: { wave: 'triangle', decay: 0.12, volume: 0.6 }, hat }, patterns: {\n    a: { lead: 'E5 . . . G5 . . . A5 . G5 . E5 . . .', pluck: 'C4 . E4 . G4 . E4 . C4 . E4 . G4 . E4 .', bass: 'C3 . . . C3 . . . G2 . . . G2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n    b: { lead: 'F5 . . . A5 . . . G5 . E5 . D5 . . .', pluck: 'F3 . A3 . C4 . A3 . G3 . B3 . D4 . B3 .', bass: 'F2 . . . F2 . . . G2 . . . G2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  evening: { bpm: 70, tracks: { box, low: { wave: 'triangle', decay: 0.9, volume: 0.5 } }, patterns: {\n    a: { box: 'E5 . G5 . B5 . . . A5 . F5 . D5 . . .', low: 'C3 . . . . . . . F2 . . . . . . .' },\n    b: { box: 'D5 . F5 . A5 . . . G5 . E5 . C5 . . .', low: 'G2 . . . . . . . C3 . . . . . . .' },\n  }, order: ['a', 'b'] },\n  stand: { bpm: 40, stepsPerBeat: 1, tracks: { air: { wave: 'triangle', attack: 1.2, decay: 2.4, volume: 0.42 } }, patterns: { a: { air: 'D2 . . . . . . .' }, b: { air: 'A1 . . . . . . .' } }, order: ['a', 'b'] },\n  swell: { bpm: 44, stepsPerBeat: 1, tracks: { a: { wave: 'triangle', attack: 1.8, decay: 3.2, volume: 0.62 }, b: { wave: 'triangle', attack: 2.4, decay: 3.2, volume: 0.5 }, c: { wave: 'triangle', attack: 3, decay: 3.2, volume: 0.44 } }, patterns: { a: { a: 'D3 - - - G3 - - -', b: 'F#4 - - - B4 - - -', c: 'A4 - - - D5 - - -' } }, order: ['a'] },\n};\nexport const songLevel = (s) => Object.values(s.tracks).reduce((a, t) => a + (t.volume ?? 0.5), 0) * 0.1 * 0.8;\nE\ncat > src/audio/sfx.js <<'E'\n// Sound effects as data.\nexport const SFX_DEFS = {\n  needleTick: { wave: 'square', duty: 0.125, freq: 2400, decay: 0.012, volume: 0.25 },\n  chimeIn: { wave: 'triangle', freq: 880, decay: 0.35, volume: 0.35, arp: [0, 7, 12], arpRate: 0.05 },\n  chimeOut: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.28, volume: 0.25 },\n  wobble: { wave: 'triangle', freq: 300, freqEnd: 240, decay: 0.2, volume: 0.3, vibrato: { depth: 1.2, rate: 14 } },\n  repTick: { wave: 'square', duty: 0.25, freq: 1000, decay: 0.05, volume: 0.25 },\n  repPerfect: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.35, arp: [0, 4, 7], arpRate: 0.04 },\n  stepPerfect: { wave: 'triangle', freq: 1318, decay: 0.09, volume: 0.28 },\n  stepGood: { wave: 'triangle', freq: 988, decay: 0.07, volume: 0.22 },\n  stepMiss: { wave: 'noise', freq: 400, decay: 0.05, volume: 0.14 },\n  combo: { wave: 'square', duty: 0.25, freq: 660, decay: 0.3, volume: 0.28, arp: [0, 4, 7, 12], arpRate: 0.05 },\n  bonk: { wave: 'triangle', freq: 300, freqEnd: 120, decay: 0.11, volume: 0.6, layers: [{ wave: 'noise', freq: 3000, decay: 0.03, volume: 0.25 }] },\n  thwap: { wave: 'noise', freq: 2200, decay: 0.08, volume: 0.45, layers: [{ wave: 'square', freq: 180, freqEnd: 90, decay: 0.08, volume: 0.25 }] },\n  pineapple: { wave: 'triangle', freq: 784, decay: 0.45, volume: 0.4, arp: [0, 4, 7, 12, 16], arpRate: 0.05 },\n  hoopWhirr: { wave: 'triangle', freq: 220, decay: 0.4, sustain: 0.4, volume: 0.1, vibrato: { depth: 3, rate: 9 } },\n  hoopCatch: { wave: 'triangle', freq: 660, freqEnd: 990, decay: 0.15, volume: 0.35 },\n  hoopDrop: { wave: 'triangle', freq: 500, freqEnd: 110, decay: 0.45, volume: 0.35 },\n  splash: { wave: 'noise', freq: 1800, freqEnd: 500, decay: 0.7, volume: 0.6 },\n  gust: { wave: 'noise', freq: 700, freqEnd: 1500, attack: 0.3, decay: 0.8, volume: 0.25 },\n  squawk: { wave: 'square', duty: 0.125, freq: 1250, freqEnd: 720, decay: 0.2, volume: 0.28, vibrato: { depth: 3, rate: 30 }, crush: 6 },\n  jarDrip: { wave: 'triangle', freq: 1200, freqEnd: 500, decay: 0.09, volume: 0.35 },\n  starPop: { wave: 'triangle', freq: 880, freqEnd: 1760, decay: 0.2, volume: 0.42 },\n  menuMove: { wave: 'triangle', freq: 660, decay: 0.03, volume: 0.2 },\n  menuConfirm: { wave: 'triangle', freq: 784, decay: 0.09, volume: 0.28, arp: [0, 7], arpRate: 0.04 },\n  menuBack: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.08, volume: 0.24 },\n  ow: { wave: 'square', duty: 0.25, freq: 660, freqEnd: 330, decay: 0.16, volume: 0.32 },\n  countdown: { wave: 'square', duty: 0.25, freq: 660, decay: 0.08, volume: 0.28 },\n  go: { wave: 'square', duty: 0.25, freq: 1320, decay: 0.3, volume: 0.32 },\n  sneeze: { wave: 'noise', freq: 3000, freqEnd: 1000, decay: 0.3, volume: 0.45 },\n  rumble: { wave: 'noise', freq: 120, decay: 1.4, volume: 0.6 },\n  clap: { wave: 'noise', freq: 4000, decay: 0.03, volume: 0.28 },\n  paddle: { wave: 'square', duty: 0.25, freq: 440, decay: 0.05, volume: 0.22 },\n  catapult: { wave: 'triangle', freq: 140, freqEnd: 420, decay: 0.16, volume: 0.32 },\n  hop: { wave: 'triangle', freq: 300, freqEnd: 520, decay: 0.07, volume: 0.2 },\n  fanfare: { wave: 'square', duty: 0.25, freq: 523, decay: 0.7, volume: 0.32, arp: [0, 4, 7, 12, 7, 12], arpRate: 0.09 },\n};\nE\ncat > src/audio/voice.js <<'E'\n// Animalese/Simlish gibberish. No words are ever spoken: syllables come from a hash of each word.\nexport const SPEAKERS = {\n  ounce: { f0: 340, rate: 13, formant: 1.25, contour: 1, tick: true },\n  coach: { f0: 165, rate: 7.5, formant: 0.9, contour: 0, pause: 0.34 },\n  marguerite: { f0: 230, rate: 9, formant: 1, contour: 1, vibrato: 7 },\n  dennis: { f0: 120, rate: 11, formant: 0.95, contour: 1, lastUp: 1.2 },\n  june: { f0: 300, rate: 10, formant: 1.15, contour: 0 },\n  player: { f0: 200, rate: 10, formant: 1, contour: 1 },\n  kevin: { squawk: true },\n};\nconst VOWELS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800] };\nconst VKEYS = Object.keys(VOWELS);\nconst PLOSIVE = ['b', 'd', 'g', 'k', 'p', 't'], FRIC = ['f', 's', 'h', 'z'], NASAL = ['m', 'n', 'l', 'r', 'w', 'y'];\nconst CONS = [...PLOSIVE, ...FRIC, ...NASAL];\nexport const hashWord = (w) => { let h = 2166136261; for (const c of w) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };\nconst consClass = (c) => (PLOSIVE.includes(c) ? 'plosive' : FRIC.includes(c) ? 'fricative' : 'voiced');\n\nexport function syllabify(text, speakerName = 'ounce') {\n  const sp = SPEAKERS[speakerName] ?? SPEAKERS.ounce;\n  if (sp.squawk) return [];\n  const out = []; const period = 1 / sp.rate;\n  // A sentence runs up to its punctuation; pitch declines across it.\n  const re = /[A-Za-z0-9'’]+|[.!?,;:]+|\\.\\.\\./g;\n  const tokens = [...String(text).matchAll(re)].map((m) => ({ s: m[0], i: m.index }));\n  let t = 0;\n  let sentence = [];\n  const flush = (ending) => {\n    const words = sentence; sentence = [];\n    const total = words.reduce((a, w) => a + w.n, 0) || 1; let k = 0;\n    words.forEach((w, wi) => {\n      const lower = w.s.toLowerCase(); let h = hashWord(lower);\n      for (let s = 0; s < w.n; s++) {\n        const p = total > 1 ? k / (total - 1) : 0;\n        let f = sp.f0 * (sp.contour ? 1 - 0.15 * p : 1);\n        if (sp.contour && ending === '?' && p > 0.7) f *= 1 + 0.25 * ((p - 0.7) / 0.3);\n        if (sp.contour && ending === '!') f *= 1.15;\n        if (sp.lastUp && wi === words.length - 1) f *= sp.lastUp;\n        h = Math.imul(h ^ (s + 1), 2654435761) >>> 0;\n        const cons = CONS[h % CONS.length], vowel = VKEYS[(h >>> 8) % VKEYS.length];\n        const dur = period * (ending === '...' ? 1.4 : 1);\n        out.push({ t, dur, f0: f, vowel, cons, consClass: consClass(cons), charIndex: w.i + Math.floor((s / w.n) * w.s.length), wordEnd: s === w.n - 1 ? w.i + w.s.length : 0 });\n        t += dur; k++;\n      }\n    });\n  };\n  for (const tok of tokens) {\n    if (/^[.!?,;:]+$/.test(tok.s)) {\n      const end = tok.s.includes('...') ? '...' : tok.s[tok.s.length - 1];\n      flush(end);\n      const pause = (sp.pause ?? 0.12) * (end === ',' ? 0.6 : 1) * (end === '...' ? 2 : 1);\n      if (sp.tick && out.length) out[out.length - 1].tick = true;\n      t += pause;\n    } else {\n      const groups = tok.s.toLowerCase().match(/[aeiouy]+/g);\n      sentence.push({ s: tok.s, i: tok.i, n: Math.max(1, groups ? groups.length : Math.ceil(tok.s.length / 3)) });\n    }\n  }\n  flush('.');\n  return out;\n}\nexport const voiceDuration = (syl) => (syl.length ? syl[syl.length - 1].t + syl[syl.length - 1].dur : 0);\n\nconst noiseBuffers = new WeakMap();\nfunction noise(ctx) {\n  let b = noiseBuffers.get(ctx);\n  if (!b) { b = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.25), ctx.sampleRate); const d = b.getChannelData(0); let s = 12345; for (let i = 0; i < d.length; i++) { s = (Math.imul(s, 1103515245) + 12345) >>> 0; d[i] = (s / 2147483648) - 1; } noiseBuffers.set(ctx, b); }\n  return b;\n}\n// Works on any BaseAudioContext, so it renders offline for tests.\nexport function renderVoice(ctx, destination, syllables, when = 0, speakerName = 'ounce', level = 1) {\n  const sp = SPEAKERS[speakerName] ?? SPEAKERS.ounce;\n  const shift = sp.formant ?? 1; const nodes = [];\n  for (const s of syllables) {\n    const t0 = when + s.t;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, t0);\n    gain.gain.linearRampToValueAtTime(0.55 * level, t0 + 0.006);\n    gain.gain.setValueAtTime(0.55 * level, t0 + Math.max(0.007, s.dur - 0.03));\n    gain.gain.linearRampToValueAtTime(0, t0 + s.dur);\n    gain.connect(destination);\n    const osc = ctx.createOscillator(); osc.type = 'sawtooth'; osc.frequency.setValueAtTime(s.f0, t0);\n    if (sp.vibrato) { osc.frequency.linearRampToValueAtTime(s.f0 * 1.02, t0 + s.dur * 0.5); osc.frequency.linearRampToValueAtTime(s.f0 * 0.98, t0 + s.dur); }\n    const [a, b] = VOWELS[s.vowel];\n    for (const [f, q, g] of [[a * shift, 7, 1.6], [b * shift, 9, 1.1]]) {\n      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = q;\n      const fg = ctx.createGain(); fg.gain.value = g;\n      osc.connect(bp); bp.connect(fg); fg.connect(gain);\n    }\n    osc.start(t0); osc.stop(t0 + s.dur + 0.01);\n    nodes.push(osc);\n    if (s.consClass !== 'voiced') {\n      const dur = s.consClass === 'plosive' ? 0.008 : 0.04;\n      const src = ctx.createBufferSource(); src.buffer = noise(ctx);\n      const ng = ctx.createGain(); ng.gain.setValueAtTime(0.28 * level, t0); ng.gain.linearRampToValueAtTime(0, t0 + dur);\n      const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = s.consClass === 'plosive' ? 1200 : 3200;\n      src.connect(hp); hp.connect(ng); ng.connect(destination);\n      src.start(t0); src.stop(t0 + dur + 0.005);\n    }\n    if (s.tick && sp.tick) {\n      const o2 = ctx.createOscillator(); o2.type = 'square'; o2.frequency.value = 2400;\n      const g2 = ctx.createGain(); const t1 = t0 + s.dur + 0.02;\n      g2.gain.setValueAtTime(0.1 * level, t1); g2.gain.linearRampToValueAtTime(0, t1 + 0.012);\n      o2.connect(g2); g2.connect(destination); o2.start(t1); o2.stop(t1 + 0.015);\n    }\n  }\n  return nodes;\n}\n// The live voice: its own gain, through the engine's sfx bus so master and mute apply.\nexport class VoicePlayer {\n  log = []; gain = null; active = []; level = 0.8;\n  speak(audio, text, who) {\n    const syl = syllabify(text, who);\n    this.log.push({ who, text: String(text).slice(0, 40) }); if (this.log.length > 30) this.log.shift();\n    const c = audio.context;\n    if (!c || c.state !== 'running') return syl; // headless, or before the first input\n    if (who === 'kevin') { audio.play('squawk'); return syl; }\n    const bus = audio.buses?.sfx ?? c.destination;\n    if (!this.gain || this.gain.context !== c) { this.gain = c.createGain(); this.gain.connect(bus); }\n    this.gain.gain.value = this.level;\n    this.stop();\n    this.active = renderVoice(c, this.gain, syl, c.currentTime + 0.01, who);\n    return syl;\n  }\n  stop() { for (const o of this.active) { try { o.stop(); } catch { /* already done */ } } this.active = []; }\n}\nE\ncat > src/art/avatar.js <<'E'\n// Avatars: the kit's hero re-dressed. Same rig, softer shapes. Clips compiled once and shared.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, SpringChain, Squash, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { ALL_CLIPS, clipIndex, CLIP_NAMES } from './clips.js';\nconst { AnimationMixer, BoxGeometry, ConeGeometry, CylinderGeometry, LoopOnce, LoopRepeat, Mesh, SphereGeometry, TorusGeometry, Vector3 } = THREE;\n\nfunction soften(mesh, kind = 'prism') { // same bounding box, softer shape\n  mesh.geometry.computeBoundingBox();\n  const b = mesh.geometry.boundingBox, s = b.getSize(new Vector3()), c = b.getCenter(new Vector3());\n  const g = kind === 'egg' ? new SphereGeometry(0.5, 10, 8) : new CylinderGeometry(0.5, 0.5, 1, 8);\n  g.scale(s.x, s.y, s.z); g.translate(c.x, c.y, c.z); mesh.geometry = g;\n}\nconst mat = (n) => toonMaterial(PALETTE[n]);\nexport function dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', 'Eyes', 'Nose']);\n  const SLOT = { Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: look.long ? 'bottom' : 'skin', ShinL_Mesh: look.long ? 'bottom' : 'skin',\n    Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: look.long ? 'top' : 'skin', ForearmL_Mesh: look.long ? 'top' : 'skin',\n    GloveR: 'skin', GloveL: 'skin', Face: 'skin', ShoeR: 'shoe', ShoeL: 'shoe' };\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    if (SLOT[o.name]) o.material = mat(look[SLOT[o.name]]);\n    if (o.name === 'Face') soften(o, 'egg'); else if (/Sleeve|Forearm|Thigh|Shin|Glove/.test(o.name)) soften(o);\n  });\n  const face = root.getObjectByName('Face'); face.geometry.computeBoundingBox();\n  const fb = face.geometry.boundingBox, size = fb.getSize(new Vector3()), c = fb.getCenter(new Vector3());\n  const add = (m, x, y, z) => { m.position.set(x, y, z); face.parent.add(m); return m; };\n  for (const sx of [-1, 1]) add(new Mesh(new BoxGeometry(0.055, 0.09, 0.03), mat('ink')), c.x + sx * size.x * 0.2, c.y + 0.02, c.z + size.z * 0.48);\n  add(new Mesh(new BoxGeometry(0.1, 0.022, 0.03), mat('ink')), c.x, c.y - size.y * 0.2, c.z + size.z * 0.47);\n  const style = look.style ?? 'cap';\n  const hairMat = mat(look.hair);\n  if (style !== 'bald') {\n    const hair = add(new Mesh(new SphereGeometry(0.5, 10, 6, 0, Math.PI * 2, 0, Math.PI * 0.55), hairMat), c.x, c.y + size.y * 0.04, c.z - size.z * 0.05);\n    hair.scale.set(size.x * 1.08, size.y * 1.04, size.z * 1.08);\n  }\n  if (look.bun || style === 'bun') add(new Mesh(new SphereGeometry(0.1, 8, 6), hairMat), c.x, c.y + size.y * 0.6, c.z - size.z * 0.2);\n  if (style === 'long') { const l = add(new Mesh(new BoxGeometry(size.x * 0.95, size.y * 0.9, 0.08), hairMat), c.x, c.y - size.y * 0.32, c.z - size.z * 0.44); l.name = 'hairLong'; }\n  if (style === 'spike') for (const a of [-1, 0, 1]) { const m = add(new Mesh(new ConeGeometry(0.05, 0.16, 5), hairMat), c.x + a * size.x * 0.2, c.y + size.y * 0.58, c.z); m.rotation.z = -a * 0.3; }\n  if (style === 'curl') for (const [dx, dz] of [[-0.3, 0], [0.3, 0], [0, -0.3], [-0.2, -0.2], [0.2, -0.2], [0, 0.15]]) add(new Mesh(new SphereGeometry(0.07, 6, 5), hairMat), c.x + dx * size.x, c.y + size.y * 0.42, c.z + dz * size.z);\n  if (look.headband && look.headband !== 'none') { const b2 = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), mat(look.headband)), c.x, c.y + size.y * 0.16, c.z); b2.scale.set(size.x * 1.06, 0.06, size.z * 1.06); }\n  if (look.items) dressItems(root, look, { add, c, size });\n}\nfunction dressItems(root, look, { add, c, size }) {\n  const it = new Set(look.items);\n  if (it.has('band2')) { const b = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), mat('lime')), c.x, c.y + size.y * 0.3, c.z); b.scale.set(size.x * 1.04, 0.05, size.z * 1.04); }\n  if (it.has('visor')) add(new Mesh(new BoxGeometry(size.x * 0.9, 0.03, 0.18), mat('sky')), c.x, c.y + size.y * 0.3, c.z + size.z * 0.55);\n  const torso = root.getObjectByName('Torso');\n  if (torso && it.has('cape')) { const m = new Mesh(new BoxGeometry(0.42, 0.62, 0.05), mat('white')); m.position.set(0, 0.05, -0.2); m.rotation.x = 0.12; torso.add(m); }\n  if (torso && it.has('confidence')) { /* Confidence: no visible effect. That is the item. */ }\n  if (torso && it.has('whistle')) { const m = new Mesh(new BoxGeometry(0.07, 0.07, 0.07), mat('sand')); m.position.set(0, 0.12, 0.2); torso.add(m); }\n  for (const h of ['ForearmR', 'ForearmL']) { const f = root.getObjectByName(h); if (f && it.has('wristbands')) { const m = new Mesh(new CylinderGeometry(0.075, 0.075, 0.07, 8), mat('red')); m.position.set(0, -0.2, 0); f.add(m); } }\n  const hand = root.getObjectByName('HandL');\n  if (hand && it.has('plumbbob')) { const m = new Mesh(new ConeGeometry(0.05, 0.12, 6), mat('sand')); m.rotation.x = Math.PI; m.position.set(0, -0.28, 0); hand.add(m); }\n}\n\nlet CLIPS = null;\nexport const compiledClips = (root) => (CLIPS ??= compileClips(ALL_CLIPS, HERO_RIG, root));\n\nexport class Avatar {\n  fade = 0.18; current = ''; shadowR = 0.42; sq = new Squash(); lean = { x: 0, y: 0 }; trem = 0; outside = 0; time = 0; extraPelvisY = 0;\n  constructor(root, ctx) {\n    this.root = root; this.ctx = ctx;\n    this.mixer = new AnimationMixer(root); this.actions = {};\n    this.clips = compiledClips(root);\n    this.pelvis = root.getObjectByName('Pelvis'); this.torso = root.getObjectByName('Torso'); this.head = root.getObjectByName('Head');\n    this.shadow = new ContactShadow(this.shadowR);\n    setLookLayer(root, 'actors');\n    ctx.scene.add(root, this.shadow);\n    this.play('Idle');\n  }\n  action(name) { return this.actions[name] ??= this.mixer.clipAction(this.clips[clipIndex[name]]); }\n  play(name, { fade = this.fade, once = false, speed = 1 } = {}) {\n    if (this.current === name && !once) { this.action(name).timeScale = speed; return this.action(name); }\n    const a = this.action(name), prev = this.current && this.actions[this.current];\n    a.reset(); a.paused = false; a.enabled = true; a.timeScale = speed;\n    a.setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once;\n    a.play();\n    if (prev && prev !== a) { prev.crossFadeTo(a, fade, false); } else a.setEffectiveWeight(1);\n    this.current = name;\n    return a;\n  }\n  // You scrub the animation with the stick.\n  scrub(name, r) {\n    const a = this.play(name, { fade: 0.1 });\n    a.paused = true; a.time = Math.max(0, Math.min(0.9999, r)) * a.getClip().duration;\n  }\n  setAt(x, y, z, yaw = 0) { this.root.position.set(x, y, z); this.root.rotation.y = yaw; this.baseY = y; }\n  clipState() { const a = this.actions[this.current]; return { c: clipIndex[this.current] ?? 0, t: a ? +a.time.toFixed(2) : 0 }; }\n  setClipState(c, t) { const n = CLIP_NAMES[c]; if (!n) return; const a = this.play(n); if (Math.abs(a.time - t) > 0.3) a.time = t; }\n  update(dt) {\n    this.time += dt;\n    this.mixer.update(dt);\n    this.sq.update(dt);\n    const [h, v] = this.sq.scale(); this.root.scale.set(h, v, h);\n    // Body language: the Dot goes on top of whatever the clip says.\n    if (this.torso && (this.lean.x || this.lean.y)) {\n      this.torso.rotateZ(-this.lean.x * 0.18); this.torso.rotateX(-this.lean.y * 0.12);\n      if (this.pelvis) this.pelvis.position.x += this.lean.x * 0.05;\n      if (this.trem > 0) { this.torso.rotateZ(Math.sin(this.time * 41) * 0.03 * this.trem); this.head?.rotateZ(Math.sin(this.time * 37) * 0.04 * this.trem); }\n    }\n    this.shadow.place(this.root.position.x, this.groundY ?? 0, this.root.position.z, Math.max(0, this.root.position.y - (this.groundY ?? 0)));\n  }\n}\nexport async function makeAvatar(ctx, look) {\n  const m = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n  dress(m.scene, look);\n  return new Avatar(m.scene, ctx);\n}\n// Coach's plumb bob: a string from her wrist, on a spring chain.\nexport class PlumbBob {\n  constructor(ctx, avatar) {\n    this.a = avatar;\n    this.chain = new SpringChain({ segments: 4, length: 0.09, rest: [0, -1, 0], stiffness: 6, gravity: 8 });\n    this.links = this.chain.points.slice(1).map((_, i) => { const m = new Mesh(new BoxGeometry(0.03, 0.09, 0.03), mat('slate')); ctx.scene.add(m); return m; });\n    this.bob = new Mesh(new ConeGeometry(0.07, 0.17, 6), mat('sand')); this.bob.rotation.x = Math.PI; ctx.scene.add(this.bob);\n    this.hand = avatar.root.getObjectByName('HandR'); this.v = new Vector3(); this.q = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];\n    if (this.hand) { this.hand.updateWorldMatrix(true, false); this.hand.getWorldPosition(this.v); this.chain.reset([this.v.x, this.v.y, this.v.z], this.q); }\n  }\n  update(dt) {\n    if (!this.hand) return;\n    this.hand.updateWorldMatrix(true, false); this.hand.getWorldPosition(this.v);\n    this.chain.update(dt, [this.v.x, this.v.y - 0.08, this.v.z], this.q);\n    this.chain.points.slice(1).forEach((p, i) => this.links[i].position.set(p[0], p[1], p[2]));\n    const e = this.chain.points[this.chain.points.length - 1]; this.bob.position.set(e[0], e[1] - 0.09, e[2]);\n  }\n}\nexport const makeHoopMesh = (r, color) => new Mesh(new TorusGeometry(r, 0.035, 5, 18).rotateX(Math.PI / 2), mat(color));\nE\necho \"- [x] audio (songs,sfx,voice), clips (validated), avatar\" >> PROGRESS.md","description":"Write audio and avatar modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":567,"cache_read_input_tokens":220783,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":567},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"a0487c6d-0170-43d0-856f-f6fcbdee488f","timestamp":"2026-11-05T07:32:59.612Z","request_id":"req_011CgjPbiYLkfXhPkunJeFhs","wire_tool_inputs":{"toolu_01YD2ckMgycYGeTAkaw5TrPk":{"command":"cat > src/audio/songs.js <<'E'\n// Every song is data, original, and written loud for a 10% music bus.\nconst pluck = { wave: 'triangle', decay: 0.28, volume: 0.62 };\nconst softBass = { wave: 'triangle', decay: 0.3, volume: 0.7 };\nconst lead = { wave: 'square', duty: 0.25, decay: 0.18, volume: 0.42 };\nconst box = { wave: 'triangle', decay: 0.55, volume: 0.72, vibrato: { depth: 0.08, rate: 5 } };\nconst hat = { wave: 'noise', decay: 0.03, volume: 0.28 };\nconst snare = { wave: 'noise', decay: 0.09, volume: 0.36 };\nconst kick = { wave: 'triangle', decay: 0.12, volume: 0.8 };\n\nexport const SONGS = {\n  plaza: { bpm: 92, tracks: { pluck, bass: softBass, shaker: { ...hat, volume: 0.2 } }, patterns: {\n    a: { pluck: '. . F4 . A4 . . C5 . . A4 . F4 . . . . . E4 . G4 . . B4 . . G4 . E4 . . .', bass: 'D3 . . . . . A2 . D3 . . . . . A2 . G2 . . . . . D3 . G2 . . . . . D3 .', shaker: 'C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8' },\n    b: { pluck: '. . E4 . G4 . . C5 . . G4 . E4 . . . . . C#4 . E4 . . A4 . . G4 . E4 . . .', bass: 'C3 . . . . . G2 . C3 . . . . . G2 . A2 . . . . . E3 . A2 . . . . . E3 .', shaker: 'C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8' },\n    c: { pluck: 'D5 . . C5 . . A4 . . . F4 . . A4 . . G4 . . F4 . . E4 . . . D4 . . E4 . .', bass: 'F2 . . . . . C3 . F2 . . . . . C3 . E2 . . . . . B2 . A2 . . . . . E3 .', shaker: 'C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8' },\n  }, order: ['a', 'b', 'a', 'c'] },\n  still: { bpm: 60, stepsPerBeat: 2, tracks: { pad: { wave: 'triangle', attack: 0.5, decay: 1.4, volume: 0.6 }, bell: { ...box, decay: 1.2, volume: 0.5 } }, patterns: {\n    a: { pad: 'D3 - - - - - - - A2 - - - - - - -', bell: '. . A4 . . . . . . E5 . . . . . .' },\n    b: { pad: 'G2 - - - - - - - D3 - - - - - - -', bell: '. . . . D5 . . . . . A4 . . . . .' },\n  }, order: ['a', 'b'] },\n  shed: { bpm: 110, tracks: { bass: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.6 }, stab: { wave: 'triangle', decay: 0.1, volume: 0.5 }, hat, kick, snare }, patterns: {\n    a: { bass: 'E2 . . E2 . G2 . A2 . . E2 . D2 . E2 .', stab: '. . B3 . . . . . . . D4 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . . . . C2 . . C2 . . . . .', snare: '. . . . C6 . . . . . . . C6 . . .' },\n    b: { bass: 'A2 . . A2 . C3 . D3 . . A2 . G2 . E2 .', stab: '. . E4 . . . . . . . G4 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 .', kick: 'C2 . . . . . . C2 . . C2 . . . . .', snare: '. . . . C6 . . . . . . . C6 . C6 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  hoop: { bpm: 124, tracks: { lead, bass: { wave: 'triangle', decay: 0.14, volume: 0.7 }, kick, hat }, patterns: {\n    a: { lead: 'C5 . E5 . G5 . E5 . A5 . G5 . E5 . C5 .', bass: 'C3 . C3 . C3 . C3 . A2 . A2 . A2 . A2 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n    b: { lead: 'F5 . A5 . G5 . E5 . D5 . E5 . G5 . . .', bass: 'F2 . F2 . F2 . F2 . G2 . G2 . G2 . G2 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', hat: '. . C8 . . . C8 . . . C8 . C8 C8 C8 .' },\n  }, order: ['a', 'a', 'b', 'a', 'a', 'b'] },\n  step: (() => { const kk = 'C2 . . . C2 . . . C2 . . . C2 . . .', hh = '. . C8 . . . C8 . . . C8 . . . C8 .';\n    const P = {\n      i: { lead: '. . . . . . . . . . . . . . . .', bass: 'G2 . . . G2 . . . G2 . . . G2 . . .', kick: kk, hat: hh },\n      v1: { lead: 'B4 . . D5 . . G5 . . F#5 . D5 . . B4 .', bass: 'G2 . G2 . G2 . G2 . G2 . G2 . G2 . G2 .', kick: kk, hat: hh },\n      v2: { lead: 'C5 . . E5 . . A5 . . G5 . E5 . . C5 .', bass: 'A2 . A2 . A2 . A2 . D3 . D3 . D3 . D3 .', kick: kk, hat: hh },\n      c1: { lead: 'G5 . G5 . A5 . G5 . E5 . D5 . E5 . G5 .', bass: 'C3 . C3 . C3 . C3 . D3 . D3 . D3 . D3 .', kick: kk, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n      c2: { lead: 'B5 . A5 . G5 . E5 . D5 . E5 . G5 . . .', bass: 'E3 . E3 . E3 . E3 . G2 . G2 . G2 . G2 .', kick: kk, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n      br: { lead: 'D5 . . . . . . . A4 . . . . . . .', bass: 'D3 . . . . . . . D3 . . . . . . .', kick: 'C2 . . . . . . . C2 . . . . . . .', hat: '. . . . . . . . . . . . C8 . C8 .' },\n    };\n    return { bpm: 104, tracks: { lead, bass: { wave: 'triangle', decay: 0.13, volume: 0.7 }, kick, hat }, patterns: P,\n      order: ['i', 'i', 'i', 'i', 'v1', 'v2', 'v1', 'v2', 'v1', 'v2', 'v1', 'v2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'br', 'br', 'br', 'br', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2', 'c1', 'c2'] }; })(),\n  lagoon: { bpm: 120, tracks: { uke: { wave: 'triangle', decay: 0.09, volume: 0.66 }, bass: { wave: 'triangle', decay: 0.16, volume: 0.56 }, tick: { ...hat, volume: 0.2 } }, patterns: {\n    a: { uke: 'C5 . E5 G5 . E5 C5 . F5 . A5 C6 . A5 F5 .', bass: 'C3 . . . G2 . . . F2 . . . C3 . . .', tick: 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .' },\n    b: { uke: 'G4 . B4 D5 . B4 G4 . C5 . E5 G5 . E5 C5 .', bass: 'G2 . . . D3 . . . C3 . . . G2 . . .', tick: 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  jog: { bpm: 112, tracks: { lead: { ...lead, volume: 0.36 }, pluck: { ...pluck, volume: 0.42, decay: 0.12 }, bass: { wave: 'triangle', decay: 0.12, volume: 0.6 }, hat }, patterns: {\n    a: { lead: 'E5 . . . G5 . . . A5 . G5 . E5 . . .', pluck: 'C4 . E4 . G4 . E4 . C4 . E4 . G4 . E4 .', bass: 'C3 . . . C3 . . . G2 . . . G2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n    b: { lead: 'F5 . . . A5 . . . G5 . E5 . D5 . . .', pluck: 'F3 . A3 . C4 . A3 . G3 . B3 . D4 . B3 .', bass: 'F2 . . . F2 . . . G2 . . . G2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 .' },\n  }, order: ['a', 'a', 'b', 'a'] },\n  evening: { bpm: 70, tracks: { box, low: { wave: 'triangle', decay: 0.9, volume: 0.5 } }, patterns: {\n    a: { box: 'E5 . G5 . B5 . . . A5 . F5 . D5 . . .', low: 'C3 . . . . . . . F2 . . . . . . .' },\n    b: { box: 'D5 . F5 . A5 . . . G5 . E5 . C5 . . .', low: 'G2 . . . . . . . C3 . . . . . . .' },\n  }, order: ['a', 'b'] },\n  stand: { bpm: 40, stepsPerBeat: 1, tracks: { air: { wave: 'triangle', attack: 1.2, decay: 2.4, volume: 0.42 } }, patterns: { a: { air: 'D2 . . . . . . .' }, b: { air: 'A1 . . . . . . .' } }, order: ['a', 'b'] },\n  swell: { bpm: 44, stepsPerBeat: 1, tracks: { a: { wave: 'triangle', attack: 1.8, decay: 3.2, volume: 0.62 }, b: { wave: 'triangle', attack: 2.4, decay: 3.2, volume: 0.5 }, c: { wave: 'triangle', attack: 3, decay: 3.2, volume: 0.44 } }, patterns: { a: { a: 'D3 - - - G3 - - -', b: 'F#4 - - - B4 - - -', c: 'A4 - - - D5 - - -' } }, order: ['a'] },\n};\nexport const songLevel = (s) => Object.values(s.tracks).reduce((a, t) => a + (t.volume ?? 0.5), 0) * 0.1 * 0.8;\nE\ncat > src/audio/sfx.js <<'E'\n// Sound effects as data.\nexport const SFX_DEFS = {\n  needleTick: { wave: 'square', duty: 0.125, freq: 2400, decay: 0.012, volume: 0.25 },\n  chimeIn: { wave: 'triangle', freq: 880, decay: 0.35, volume: 0.35, arp: [0, 7, 12], arpRate: 0.05 },\n  chimeOut: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.28, volume: 0.25 },\n  wobble: { wave: 'triangle', freq: 300, freqEnd: 240, decay: 0.2, volume: 0.3, vibrato: { depth: 1.2, rate: 14 } },\n  repTick: { wave: 'square', duty: 0.25, freq: 1000, decay: 0.05, volume: 0.25 },\n  repPerfect: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.35, arp: [0, 4, 7], arpRate: 0.04 },\n  stepPerfect: { wave: 'triangle', freq: 1318, decay: 0.09, volume: 0.28 },\n  stepGood: { wave: 'triangle', freq: 988, decay: 0.07, volume: 0.22 },\n  stepMiss: { wave: 'noise', freq: 400, decay: 0.05, volume: 0.14 },\n  combo: { wave: 'square', duty: 0.25, freq: 660, decay: 0.3, volume: 0.28, arp: [0, 4, 7, 12], arpRate: 0.05 },\n  bonk: { wave: 'triangle', freq: 300, freqEnd: 120, decay: 0.11, volume: 0.6, layers: [{ wave: 'noise', freq: 3000, decay: 0.03, volume: 0.25 }] },\n  thwap: { wave: 'noise', freq: 2200, decay: 0.08, volume: 0.45, layers: [{ wave: 'square', freq: 180, freqEnd: 90, decay: 0.08, volume: 0.25 }] },\n  pineapple: { wave: 'triangle', freq: 784, decay: 0.45, volume: 0.4, arp: [0, 4, 7, 12, 16], arpRate: 0.05 },\n  hoopWhirr: { wave: 'triangle', freq: 220, decay: 0.4, sustain: 0.4, volume: 0.1, vibrato: { depth: 3, rate: 9 } },\n  hoopCatch: { wave: 'triangle', freq: 660, freqEnd: 990, decay: 0.15, volume: 0.35 },\n  hoopDrop: { wave: 'triangle', freq: 500, freqEnd: 110, decay: 0.45, volume: 0.35 },\n  splash: { wave: 'noise', freq: 1800, freqEnd: 500, decay: 0.7, volume: 0.6 },\n  gust: { wave: 'noise', freq: 700, freqEnd: 1500, attack: 0.3, decay: 0.8, volume: 0.25 },\n  squawk: { wave: 'square', duty: 0.125, freq: 1250, freqEnd: 720, decay: 0.2, volume: 0.28, vibrato: { depth: 3, rate: 30 }, crush: 6 },\n  jarDrip: { wave: 'triangle', freq: 1200, freqEnd: 500, decay: 0.09, volume: 0.35 },\n  starPop: { wave: 'triangle', freq: 880, freqEnd: 1760, decay: 0.2, volume: 0.42 },\n  menuMove: { wave: 'triangle', freq: 660, decay: 0.03, volume: 0.2 },\n  menuConfirm: { wave: 'triangle', freq: 784, decay: 0.09, volume: 0.28, arp: [0, 7], arpRate: 0.04 },\n  menuBack: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.08, volume: 0.24 },\n  ow: { wave: 'square', duty: 0.25, freq: 660, freqEnd: 330, decay: 0.16, volume: 0.32 },\n  countdown: { wave: 'square', duty: 0.25, freq: 660, decay: 0.08, volume: 0.28 },\n  go: { wave: 'square', duty: 0.25, freq: 1320, decay: 0.3, volume: 0.32 },\n  sneeze: { wave: 'noise', freq: 3000, freqEnd: 1000, decay: 0.3, volume: 0.45 },\n  rumble: { wave: 'noise', freq: 120, decay: 1.4, volume: 0.6 },\n  clap: { wave: 'noise', freq: 4000, decay: 0.03, volume: 0.28 },\n  paddle: { wave: 'square', duty: 0.25, freq: 440, decay: 0.05, volume: 0.22 },\n  catapult: { wave: 'triangle', freq: 140, freqEnd: 420, decay: 0.16, volume: 0.32 },\n  hop: { wave: 'triangle', freq: 300, freqEnd: 520, decay: 0.07, volume: 0.2 },\n  fanfare: { wave: 'square', duty: 0.25, freq: 523, decay: 0.7, volume: 0.32, arp: [0, 4, 7, 12, 7, 12], arpRate: 0.09 },\n};\nE\ncat > src/audio/voice.js <<'E'\n// Animalese/Simlish gibberish. No words are ever spoken: syllables come from a hash of each word.\nexport const SPEAKERS = {\n  ounce: { f0: 340, rate: 13, formant: 1.25, contour: 1, tick: true },\n  coach: { f0: 165, rate: 7.5, formant: 0.9, contour: 0, pause: 0.34 },\n  marguerite: { f0: 230, rate: 9, formant: 1, contour: 1, vibrato: 7 },\n  dennis: { f0: 120, rate: 11, formant: 0.95, contour: 1, lastUp: 1.2 },\n  june: { f0: 300, rate: 10, formant: 1.15, contour: 0 },\n  player: { f0: 200, rate: 10, formant: 1, contour: 1 },\n  kevin: { squawk: true },\n};\nconst VOWELS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800] };\nconst VKEYS = Object.keys(VOWELS);\nconst PLOSIVE = ['b', 'd', 'g', 'k', 'p', 't'], FRIC = ['f', 's', 'h', 'z'], NASAL = ['m', 'n', 'l', 'r', 'w', 'y'];\nconst CONS = [...PLOSIVE, ...FRIC, ...NASAL];\nexport const hashWord = (w) => { let h = 2166136261; for (const c of w) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };\nconst consClass = (c) => (PLOSIVE.includes(c) ? 'plosive' : FRIC.includes(c) ? 'fricative' : 'voiced');\n\nexport function syllabify(text, speakerName = 'ounce') {\n  const sp = SPEAKERS[speakerName] ?? SPEAKERS.ounce;\n  if (sp.squawk) return [];\n  const out = []; const period = 1 / sp.rate;\n  // A sentence runs up to its punctuation; pitch declines across it.\n  const re = /[A-Za-z0-9'’]+|[.!?,;:]+|\\.\\.\\./g;\n  const tokens = [...String(text).matchAll(re)].map((m) => ({ s: m[0], i: m.index }));\n  let t = 0;\n  let sentence = [];\n  const flush = (ending) => {\n    const words = sentence; sentence = [];\n    const total = words.reduce((a, w) => a + w.n, 0) || 1; let k = 0;\n    words.forEach((w, wi) => {\n      const lower = w.s.toLowerCase(); let h = hashWord(lower);\n      for (let s = 0; s < w.n; s++) {\n        const p = total > 1 ? k / (total - 1) : 0;\n        let f = sp.f0 * (sp.contour ? 1 - 0.15 * p : 1);\n        if (sp.contour && ending === '?' && p > 0.7) f *= 1 + 0.25 * ((p - 0.7) / 0.3);\n        if (sp.contour && ending === '!') f *= 1.15;\n        if (sp.lastUp && wi === words.length - 1) f *= sp.lastUp;\n        h = Math.imul(h ^ (s + 1), 2654435761) >>> 0;\n        const cons = CONS[h % CONS.length], vowel = VKEYS[(h >>> 8) % VKEYS.length];\n        const dur = period * (ending === '...' ? 1.4 : 1);\n        out.push({ t, dur, f0: f, vowel, cons, consClass: consClass(cons), charIndex: w.i + Math.floor((s / w.n) * w.s.length), wordEnd: s === w.n - 1 ? w.i + w.s.length : 0 });\n        t += dur; k++;\n      }\n    });\n  };\n  for (const tok of tokens) {\n    if (/^[.!?,;:]+$/.test(tok.s)) {\n      const end = tok.s.includes('...') ? '...' : tok.s[tok.s.length - 1];\n      flush(end);\n      const pause = (sp.pause ?? 0.12) * (end === ',' ? 0.6 : 1) * (end === '...' ? 2 : 1);\n      if (sp.tick && out.length) out[out.length - 1].tick = true;\n      t += pause;\n    } else {\n      const groups = tok.s.toLowerCase().match(/[aeiouy]+/g);\n      sentence.push({ s: tok.s, i: tok.i, n: Math.max(1, groups ? groups.length : Math.ceil(tok.s.length / 3)) });\n    }\n  }\n  flush('.');\n  return out;\n}\nexport const voiceDuration = (syl) => (syl.length ? syl[syl.length - 1].t + syl[syl.length - 1].dur : 0);\n\nconst noiseBuffers = new WeakMap();\nfunction noise(ctx) {\n  let b = noiseBuffers.get(ctx);\n  if (!b) { b = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.25), ctx.sampleRate); const d = b.getChannelData(0); let s = 12345; for (let i = 0; i < d.length; i++) { s = (Math.imul(s, 1103515245) + 12345) >>> 0; d[i] = (s / 2147483648) - 1; } noiseBuffers.set(ctx, b); }\n  return b;\n}\n// Works on any BaseAudioContext, so it renders offline for tests.\nexport function renderVoice(ctx, destination, syllables, when = 0, speakerName = 'ounce', level = 1) {\n  const sp = SPEAKERS[speakerName] ?? SPEAKERS.ounce;\n  const shift = sp.formant ?? 1; const nodes = [];\n  for (const s of syllables) {\n    const t0 = when + s.t;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, t0);\n    gain.gain.linearRampToValueAtTime(0.55 * level, t0 + 0.006);\n    gain.gain.setValueAtTime(0.55 * level, t0 + Math.max(0.007, s.dur - 0.03));\n    gain.gain.linearRampToValueAtTime(0, t0 + s.dur);\n    gain.connect(destination);\n    const osc = ctx.createOscillator(); osc.type = 'sawtooth'; osc.frequency.setValueAtTime(s.f0, t0);\n    if (sp.vibrato) { osc.frequency.linearRampToValueAtTime(s.f0 * 1.02, t0 + s.dur * 0.5); osc.frequency.linearRampToValueAtTime(s.f0 * 0.98, t0 + s.dur); }\n    const [a, b] = VOWELS[s.vowel];\n    for (const [f, q, g] of [[a * shift, 7, 1.6], [b * shift, 9, 1.1]]) {\n      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = q;\n      const fg = ctx.createGain(); fg.gain.value = g;\n      osc.connect(bp); bp.connect(fg); fg.connect(gain);\n    }\n    osc.start(t0); osc.stop(t0 + s.dur + 0.01);\n    nodes.push(osc);\n    if (s.consClass !== 'voiced') {\n      const dur = s.consClass === 'plosive' ? 0.008 : 0.04;\n      const src = ctx.createBufferSource(); src.buffer = noise(ctx);\n      const ng = ctx.createGain(); ng.gain.setValueAtTime(0.28 * level, t0); ng.gain.linearRampToValueAtTime(0, t0 + dur);\n      const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = s.consClass === 'plosive' ? 1200 : 3200;\n      src.connect(hp); hp.connect(ng); ng.connect(destination);\n      src.start(t0); src.stop(t0 + dur + 0.005);\n    }\n    if (s.tick && sp.tick) {\n      const o2 = ctx.createOscillator(); o2.type = 'square'; o2.frequency.value = 2400;\n      const g2 = ctx.createGain(); const t1 = t0 + s.dur + 0.02;\n      g2.gain.setValueAtTime(0.1 * level, t1); g2.gain.linearRampToValueAtTime(0, t1 + 0.012);\n      o2.connect(g2); g2.connect(destination); o2.start(t1); o2.stop(t1 + 0.015);\n    }\n  }\n  return nodes;\n}\n// The live voice: its own gain, through the engine's sfx bus so master and mute apply.\nexport class VoicePlayer {\n  log = []; gain = null; active = []; level = 0.8;\n  speak(audio, text, who) {\n    const syl = syllabify(text, who);\n    this.log.push({ who, text: String(text).slice(0, 40) }); if (this.log.length > 30) this.log.shift();\n    const c = audio.context;\n    if (!c || c.state !== 'running') return syl; // headless, or before the first input\n    if (who === 'kevin') { audio.play('squawk'); return syl; }\n    const bus = audio.buses?.sfx ?? c.destination;\n    if (!this.gain || this.gain.context !== c) { this.gain = c.createGain(); this.gain.connect(bus); }\n    this.gain.gain.value = this.level;\n    this.stop();\n    this.active = renderVoice(c, this.gain, syl, c.currentTime + 0.01, who);\n    return syl;\n  }\n  stop() { for (const o of this.active) { try { o.stop(); } catch { /* already done */ } } this.active = []; }\n}\nE\ncat > src/art/avatar.js <<'E'\n// Avatars: the kit's hero re-dressed. Same rig, softer shapes. Clips compiled once and shared.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, SpringChain, Squash, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { ALL_CLIPS, clipIndex, CLIP_NAMES } from './clips.js';\nconst { AnimationMixer, BoxGeometry, ConeGeometry, CylinderGeometry, LoopOnce, LoopRepeat, Mesh, SphereGeometry, TorusGeometry, Vector3 } = THREE;\n\nfunction soften(mesh, kind = 'prism') { // same bounding box, softer shape\n  mesh.geometry.computeBoundingBox();\n  const b = mesh.geometry.boundingBox, s = b.getSize(new Vector3()), c = b.getCenter(new Vector3());\n  const g = kind === 'egg' ? new SphereGeometry(0.5, 10, 8) : new CylinderGeometry(0.5, 0.5, 1, 8);\n  g.scale(s.x, s.y, s.z); g.translate(c.x, c.y, c.z); mesh.geometry = g;\n}\nconst mat = (n) => toonMaterial(PALETTE[n]);\nexport function dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', 'Eyes', 'Nose']);\n  const SLOT = { Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: look.long ? 'bottom' : 'skin', ShinL_Mesh: look.long ? 'bottom' : 'skin',\n    Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: look.long ? 'top' : 'skin', ForearmL_Mesh: look.long ? 'top' : 'skin',\n    GloveR: 'skin', GloveL: 'skin', Face: 'skin', ShoeR: 'shoe', ShoeL: 'shoe' };\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    if (SLOT[o.name]) o.material = mat(look[SLOT[o.name]]);\n    if (o.name === 'Face') soften(o, 'egg'); else if (/Sleeve|Forearm|Thigh|Shin|Glove/.test(o.name)) soften(o);\n  });\n  const face = root.getObjectByName('Face'); face.geometry.computeBoundingBox();\n  const fb = face.geometry.boundingBox, size = fb.getSize(new Vector3()), c = fb.getCenter(new Vector3());\n  const add = (m, x, y, z) => { m.position.set(x, y, z); face.parent.add(m); return m; };\n  for (const sx of [-1, 1]) add(new Mesh(new BoxGeometry(0.055, 0.09, 0.03), mat('ink')), c.x + sx * size.x * 0.2, c.y + 0.02, c.z + size.z * 0.48);\n  add(new Mesh(new BoxGeometry(0.1, 0.022, 0.03), mat('ink')), c.x, c.y - size.y * 0.2, c.z + size.z * 0.47);\n  const style = look.style ?? 'cap';\n  const hairMat = mat(look.hair);\n  if (style !== 'bald') {\n    const hair = add(new Mesh(new SphereGeometry(0.5, 10, 6, 0, Math.PI * 2, 0, Math.PI * 0.55), hairMat), c.x, c.y + size.y * 0.04, c.z - size.z * 0.05);\n    hair.scale.set(size.x * 1.08, size.y * 1.04, size.z * 1.08);\n  }\n  if (look.bun || style === 'bun') add(new Mesh(new SphereGeometry(0.1, 8, 6), hairMat), c.x, c.y + size.y * 0.6, c.z - size.z * 0.2);\n  if (style === 'long') { const l = add(new Mesh(new BoxGeometry(size.x * 0.95, size.y * 0.9, 0.08), hairMat), c.x, c.y - size.y * 0.32, c.z - size.z * 0.44); l.name = 'hairLong'; }\n  if (style === 'spike') for (const a of [-1, 0, 1]) { const m = add(new Mesh(new ConeGeometry(0.05, 0.16, 5), hairMat), c.x + a * size.x * 0.2, c.y + size.y * 0.58, c.z); m.rotation.z = -a * 0.3; }\n  if (style === 'curl') for (const [dx, dz] of [[-0.3, 0], [0.3, 0], [0, -0.3], [-0.2, -0.2], [0.2, -0.2], [0, 0.15]]) add(new Mesh(new SphereGeometry(0.07, 6, 5), hairMat), c.x + dx * size.x, c.y + size.y * 0.42, c.z + dz * size.z);\n  if (look.headband && look.headband !== 'none') { const b2 = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), mat(look.headband)), c.x, c.y + size.y * 0.16, c.z); b2.scale.set(size.x * 1.06, 0.06, size.z * 1.06); }\n  if (look.items) dressItems(root, look, { add, c, size });\n}\nfunction dressItems(root, look, { add, c, size }) {\n  const it = new Set(look.items);\n  if (it.has('band2')) { const b = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), mat('lime')), c.x, c.y + size.y * 0.3, c.z); b.scale.set(size.x * 1.04, 0.05, size.z * 1.04); }\n  if (it.has('visor')) add(new Mesh(new BoxGeometry(size.x * 0.9, 0.03, 0.18), mat('sky')), c.x, c.y + size.y * 0.3, c.z + size.z * 0.55);\n  const torso = root.getObjectByName('Torso');\n  if (torso && it.has('cape')) { const m = new Mesh(new BoxGeometry(0.42, 0.62, 0.05), mat('white')); m.position.set(0, 0.05, -0.2); m.rotation.x = 0.12; torso.add(m); }\n  if (torso && it.has('confidence')) { /* Confidence: no visible effect. That is the item. */ }\n  if (torso && it.has('whistle')) { const m = new Mesh(new BoxGeometry(0.07, 0.07, 0.07), mat('sand')); m.position.set(0, 0.12, 0.2); torso.add(m); }\n  for (const h of ['ForearmR', 'ForearmL']) { const f = root.getObjectByName(h); if (f && it.has('wristbands')) { const m = new Mesh(new CylinderGeometry(0.075, 0.075, 0.07, 8), mat('red')); m.position.set(0, -0.2, 0); f.add(m); } }\n  const hand = root.getObjectByName('HandL');\n  if (hand && it.has('plumbbob')) { const m = new Mesh(new ConeGeometry(0.05, 0.12, 6), mat('sand')); m.rotation.x = Math.PI; m.position.set(0, -0.28, 0); hand.add(m); }\n}\n\nlet CLIPS = null;\nexport const compiledClips = (root) => (CLIPS ??= compileClips(ALL_CLIPS, HERO_RIG, root));\n\nexport class Avatar {\n  fade = 0.18; current = ''; shadowR = 0.42; sq = new Squash(); lean = { x: 0, y: 0 }; trem = 0; outside = 0; time = 0; extraPelvisY = 0;\n  constructor(root, ctx) {\n    this.root = root; this.ctx = ctx;\n    this.mixer = new AnimationMixer(root); this.actions = {};\n    this.clips = compiledClips(root);\n    this.pelvis = root.getObjectByName('Pelvis'); this.torso = root.getObjectByName('Torso'); this.head = root.getObjectByName('Head');\n    this.shadow = new ContactShadow(this.shadowR);\n    setLookLayer(root, 'actors');\n    ctx.scene.add(root, this.shadow);\n    this.play('Idle');\n  }\n  action(name) { return this.actions[name] ??= this.mixer.clipAction(this.clips[clipIndex[name]]); }\n  play(name, { fade = this.fade, once = false, speed = 1 } = {}) {\n    if (this.current === name && !once) { this.action(name).timeScale = speed; return this.action(name); }\n    const a = this.action(name), prev = this.current && this.actions[this.current];\n    a.reset(); a.paused = false; a.enabled = true; a.timeScale = speed;\n    a.setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once;\n    a.play();\n    if (prev && prev !== a) { prev.crossFadeTo(a, fade, false); } else a.setEffectiveWeight(1);\n    this.current = name;\n    return a;\n  }\n  // You scrub the animation with the stick.\n  scrub(name, r) {\n    const a = this.play(name, { fade: 0.1 });\n    a.paused = true; a.time = Math.max(0, Math.min(0.9999, r)) * a.getClip().duration;\n  }\n  setAt(x, y, z, yaw = 0) { this.root.position.set(x, y, z); this.root.rotation.y = yaw; this.baseY = y; }\n  clipState() { const a = this.actions[this.current]; return { c: clipIndex[this.current] ?? 0, t: a ? +a.time.toFixed(2) : 0 }; }\n  setClipState(c, t) { const n = CLIP_NAMES[c]; if (!n) return; const a = this.play(n); if (Math.abs(a.time - t) > 0.3) a.time = t; }\n  update(dt) {\n    this.time += dt;\n    this.mixer.update(dt);\n    this.sq.update(dt);\n    const [h, v] = this.sq.scale(); this.root.scale.set(h, v, h);\n    // Body language: the Dot goes on top of whatever the clip says.\n    if (this.torso && (this.lean.x || this.lean.y)) {\n      this.torso.rotateZ(-this.lean.x * 0.18); this.torso.rotateX(-this.lean.y * 0.12);\n      if (this.pelvis) this.pelvis.position.x += this.lean.x * 0.05;\n      if (this.trem > 0) { this.torso.rotateZ(Math.sin(this.time * 41) * 0.03 * this.trem); this.head?.rotateZ(Math.sin(this.time * 37) * 0.04 * this.trem); }\n    }\n    this.shadow.place(this.root.position.x, this.groundY ?? 0, this.root.position.z, Math.max(0, this.root.position.y - (this.groundY ?? 0)));\n  }\n}\nexport async function makeAvatar(ctx, look) {\n  const m = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n  dress(m.scene, look);\n  return new Avatar(m.scene, ctx);\n}\n// Coach's plumb bob: a string from her wrist, on a spring chain.\nexport class PlumbBob {\n  constructor(ctx, avatar) {\n    this.a = avatar;\n    this.chain = new SpringChain({ segments: 4, length: 0.09, rest: [0, -1, 0], stiffness: 6, gravity: 8 });\n    this.links = this.chain.points.slice(1).map((_, i) => { const m = new Mesh(new BoxGeometry(0.03, 0.09, 0.03), mat('slate')); ctx.scene.add(m); return m; });\n    this.bob = new Mesh(new ConeGeometry(0.07, 0.17, 6), mat('sand')); this.bob.rotation.x = Math.PI; ctx.scene.add(this.bob);\n    this.hand = avatar.root.getObjectByName('HandR'); this.v = new Vector3(); this.q = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];\n    if (this.hand) { this.hand.updateWorldMatrix(true, false); this.hand.getWorldPosition(this.v); this.chain.reset([this.v.x, this.v.y, this.v.z], this.q); }\n  }\n  update(dt) {\n    if (!this.hand) return;\n    this.hand.updateWorldMatrix(true, false); this.hand.getWorldPosition(this.v);\n    this.chain.update(dt, [this.v.x, this.v.y - 0.08, this.v.z], this.q);\n    this.chain.points.slice(1).forEach((p, i) => this.links[i].position.set(p[0], p[1], p[2]));\n    const e = this.chain.points[this.chain.points.length - 1]; this.bob.position.set(e[0], e[1] - 0.09, e[2]);\n  }\n}\nexport const makeHoopMesh = (r, color) => new Mesh(new TorusGeometry(r, 0.035, 5, 18).rotateX(Math.PI / 2), mat(color));\nE\necho \"- [x] audio (songs,sfx,voice), clips (validated), avatar\" >> PROGRESS.md","description":"Write audio and avatar modules"}}}
