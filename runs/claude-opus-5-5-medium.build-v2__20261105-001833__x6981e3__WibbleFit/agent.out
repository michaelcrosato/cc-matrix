{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjQaTQLf7Tq9AuVUKPuS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JTGdiUSmPVwC4EXyFdktrS","name":"Bash","input":{"command":"cat > src/art/island.js <<'E'\n// Tare Island. Tall things stay in the -x -z quadrant, so they never hide the player.\nimport { Boids, buildModel, PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { box, grass, place, sea, sky, tileFloor } from './stage.js';\nimport { Decals } from '../../pixel-engine.js';\nconst { BoxGeometry, InstancedMesh, Matrix4, Mesh, Quaternion, Vector3 } = THREE;\n\nexport const JOG_POINTS = [[0, 12], [7, 15], [15, 15], [20, 11], [20.5, 4], [16, 0], [19.5, -5], [20.5, -12], [15, -15.5], [8, -15], [5, -11], [0, -12.5], [-5, -11], [-8, -15], [-15, -15.5], [-20.5, -13], [-20, -6], [-15.5, -2], [-20, 3], [-20.5, 10], [-14, 11], [-9, 9], [-6, 14]];\n\nexport async function buildPlaza(ctx) {\n  sky(ctx);\n  tileFloor(ctx, 18, 16, 0, 1, 0);\n  box(ctx, 0, -0.06, 0, 60, 0.1, 50, 'green', { shadow: false });\n  ctx.physics.addStaticBox({ position: [0, -0.6, 0], halfExtents: [40, 0.5, 40] });\n  const water = sea(ctx, 200, 60, -0.25, 0, -44);\n  place(ctx, 'kettlebell-volcano', -14, -0.5, -22, { scale: 1.2 });\n  place(ctx, 'foam-roller-hill', 15, -0.5, -20);\n  place(ctx, 'fountain', -7, 0, -5); place(ctx, 'bench', 6.4, 0, -4); place(ctx, 'bench', -6.4, 0, 4, { turn: 90 });\n  place(ctx, 'palm', 8.8, 0, -6, { turn: 40 }); place(ctx, 'palm', -9.2, 0, -7, { turn: 200 });\n  place(ctx, 'sweat-jar', 4.5, 0, -6);\n  return { water, update(c, dt) { water.update(c.time); } };\n}\n\nexport async function buildIsland(ctx, { jog = false, collide = true } = {}) {\n  sky(ctx);\n  const add = collide ? { collide: true } : {};\n  // Land: lawn, sand, and the white plaza at the heart of it.\n  box(ctx, 0, -0.2, 0, 46, 0.4, 36, 'green', { shadow: false });\n  box(ctx, 12.5, -0.14, -11, 20, 0.3, 13, 'sand', { shadow: false });\n  box(ctx, -12.5, -0.14, -11, 20, 0.3, 13, 'sand', { shadow: false });\n  box(ctx, 0, -0.17, 17.5, 48, 0.3, 3, 'sand', { shadow: false });\n  box(ctx, 0, -0.17, -17.5, 48, 0.3, 3, 'sand', { shadow: false });\n  box(ctx, 23.5, -0.17, 0, 3, 0.3, 38, 'sand', { shadow: false }); box(ctx, -23.5, -0.17, 0, 3, 0.3, 38, 'sand', { shadow: false });\n  ctx.physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [30, 0.5, 26] });\n  const water = sea(ctx, 240, 200, -0.25, 0, 0);\n  const plaza = tileFloor(ctx, 15, 16, 0, 0.5, 0.005);\n  void plaza;\n  // Paths from the plaza to everything.\n  for (const [x, z, w, d] of [[-9.5, 3, 5, 2.4], [9.5, 3, 5, 2.4], [0, 10, 3, 3.6]]) box(ctx, x, 0.002, z, w, 0.01, d, 'white', { shadow: false });\n  // Jog path.\n  if (jog) {\n    const { CatmullRomCurve3 } = THREE;\n    const curve = new CatmullRomCurve3(JOG_POINTS.map(([x, z]) => new Vector3(x, 0, z)), true, 'catmullrom', 0.5);\n    const n = 280, g = new BoxGeometry(3.6, 0.02, 1.1), m = new InstancedMesh(g, toonMaterial(PALETTE.sand), n), mat = new Matrix4(), q = new Quaternion(), up = new Vector3(0, 1, 0);\n    for (let i = 0; i < n; i++) { const p = curve.getPointAt(i / n), t = curve.getTangentAt(i / n); q.setFromAxisAngle(up, Math.atan2(t.x, t.z)); mat.compose(new Vector3(p.x, 0.03, p.z), q, new Vector3(1, 1, 1)); m.setMatrixAt(i, mat); }\n    m.receiveShadow = true; ctx.scene.add(m);\n  }\n  // Stations.\n  const st = {};\n  st.ounceDais = place(ctx, 'fountain', 0, 0, -3.4, { ...add });\n  box(ctx, 0, 0.14, 3, 3.4, 0.28, 3.4, 'mist'); box(ctx, 0, 0.3, 3, 2.6, 0.08, 2.6, 'white');\n  if (collide) ctx.physics.addStaticBox({ position: [0, 0.14, 3], halfExtents: [1.7, 0.14, 1.7] });\n  st.pavilion = place(ctx, 'pavilion', -11, 0, 3);\n  st.pavilionRoof = st.pavilion;\n  if (collide) ctx.physics.addStaticCylinder([-11, 1, 3], 1, 3.6);\n  st.shed = place(ctx, 'rep-shed', 11, 0, 3, { turn: -90, ...add });\n  st.stage = place(ctx, 'beat-stage', 12, 0, -10, { turn: 0, ...add });\n  st.gate = place(ctx, 'jog-gate', 0, 0, 11);\n  st.jar = place(ctx, 'sweat-jar', 4, 0, -4, { ...add });\n  st.lockers = place(ctx, 'lockers', -4, 0, -4.4, { ...add });\n  st.hall = place(ctx, 'hall-board', 0, 0, -8, { ...add });\n  st.hammock = place(ctx, 'hammock', 14, 0, 10);\n  place(ctx, 'palm', 12.2, 0, 10, { ...add }); place(ctx, 'palm', 15.8, 0, 10, { turn: 180, ...add });\n  // Lagoon with a pier.\n  place(ctx, 'pier', -13, 0.1, -13.2, { params: { len: 14 } });\n  place(ctx, 'slack-anchor', -18.5, 0, -8.5, { ...add }); place(ctx, 'catapult', -8.5, 0, -11, { turn: 20, ...add });\n  place(ctx, 'yoga-mat', -11, 0.4, 3); place(ctx, 'yoga-mat', 8, 0.01, -8, { turn: 15 });\n  // Scenery.\n  place(ctx, 'kettlebell-volcano', -15, -0.2, -14 - 8, {});\n  place(ctx, 'foam-roller-hill', 15, -0.1, -22, {});\n  place(ctx, 'dumbbell-bridge', -18, -0.8, 13, { turn: 90 });\n  box(ctx, -18, -0.1, 13, 5, 0.3, 6, 'sky', { shadow: false });\n  if (collide) ctx.physics.addStaticBox({ position: [-18, 0.5, 13], halfExtents: [3, 1, 3.4] });\n  for (const [x, z, s] of [[-21, 3, 0.8], [-20.5, -3, 1], [21, 2, 0.9], [21, 8, 0.6], [6, 15, 0.8], [-7, 15, 1], [-3, -16, 0.7], [8, -16, 0.9]]) place(ctx, 'med-ball', x, 0, z, { scale: s });\n  for (const [x, z, t] of [[-20, 8, 30], [20, -3, 100], [17, 14, 200], [-13, 15, 300], [-3, -14, 50], [8, 13, 160]]) place(ctx, 'palm', x, 0, z, { turn: t });\n  for (const [id, x, z, t] of [['bench', 7, -1, -90], ['bench', -7, -1, 90], ['bench', 5.5, 7, 180], ['bush', -7.5, 8, 0], ['bush', 7.5, 8, 0], ['flowers', -5, 9, 0], ['flowers', 5, 9, 0], ['lamp-post', -7.2, 7.5, 0], ['lamp-post', 7.2, 7.5, 0], ['lamp-post', -7.2, -6.5, 0], ['lamp-post', 7.2, -6.5, 0], ['signpost', 2.4, 9.6, 0], ['bush', 16, 7, 0], ['flowers', 12, 12, 0], ['oak', -19, -2, 0]]) place(ctx, id, x, 0, z, { turn: t });\n  // Edge walls so nobody walks into the sea.\n  if (collide) for (const [x, z, hx, hz] of [[0, 19.2, 26, 0.5], [0, -19.2, 26, 0.5], [24.5, 0, 0.5, 20], [-24.5, 0, 0.5, 20]]) ctx.physics.addStaticBox({ position: [x, 1.5, z], halfExtents: [hx, 2, hz] });\n  // Grass and gulls.\n  const onPath = (x, z) => (Math.abs(x) < 8.4 && z > -8.5 && z < 9.5) || (z < -4.5 && Math.abs(x) > 2.5) || (Math.abs(z - 3) < 1.6 && Math.abs(x) < 14);\n  const g = grass(ctx, { area: [44, 32], at: [0, 0, 0], count: 4800, height: [0.22, 0.42], width: 0.08, mask: (x, z) => !onPath(x, z), seed: 5 });\n  const gulls = new Boids(12, { bounds: { min: [-22, 7, -18], max: [22, 12, 16] }, seed: 3 });\n  const gullMeshes = Array.from({ length: gulls.count }, () => { const b = new Mesh(new BoxGeometry(0.7, 0.08, 0.26), toonMaterial(PALETTE.white)); ctx.scene.add(b); return b; });\n  const decals = new Decals(ctx.scene);\n  let gt = 0;\n  return { water, grass: g, gulls, decals, st, update(c, dt) {\n    water.update(c.time); g.update(c.time); decals.update(dt);\n    gt += dt; if (gt > 0.03) { gulls.step(gt); gt = 0; }\n    for (let i = 0; i < gullMeshes.length; i++) { gullMeshes[i].position.set(gulls.pos[i * 3], gulls.pos[i * 3 + 1], gulls.pos[i * 3 + 2]); gullMeshes[i].scale.x = 0.8 + Math.sin(c.time * 7 + i) * 0.3; gullMeshes[i].rotation.y = Math.atan2(gulls.vel[i * 3], gulls.vel[i * 3 + 2]); }\n  } };\n}\nexport const needle = (b) => b.object.getObjectByName('needle');\nvoid buildModel;\nE\ncat > src/scenes/hub.js <<'E'\n// The island: walk between stations. Jumping and waving have no purpose and are still here.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, applySky, skyAt } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { dress, makeAvatar } from '../art/avatar.js';\nimport { ALL_CLIPS } from '../art/clips.js';\nimport { buildIsland } from '../art/island.js';\nimport { place } from '../art/stage.js';\nimport { ACTIONS } from '../core/actions.js';\nimport { isOpen, hardOpen, openedToday, scheduleDay } from '../core/progress.js';\nimport { ACT, STATION_ACTS } from '../data/activities.js';\nimport { AVATARS, CAST_LOOKS } from '../data/classmates.js';\nimport { BARKS, STORY } from '../data/lines.js';\nimport { STATIONS } from '../data/stations.js';\nimport { weekDay } from '../data/week.js';\nimport { say, textWidth, wrap } from '../ui/font.js';\nimport { talk } from '../ui/dialogue.js';\nimport { Menu, pointerArt } from '../ui/menu.js';\nimport { prompt, promptBar, promptWidth } from '../ui/prompts.js';\nimport { note, panel, stars } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nconst { Vector3 } = THREE;\n\nexport class StationMenu {\n  id = 'station'; attractable = false;\n  constructor(scene, key) {\n    this.scene = scene; this.key = key;\n    const st = STATIONS[key], slot = App.slot; this.remark = st.remark;\n    const acts = STATION_ACTS(key); this.hard = false; this.hardOk = hardOpen(slot);\n    const items = acts.map((a) => {\n      const open = isOpen(slot, a.id);\n      const r = slot?.records[a.id];\n      return { label: open ? a.name : `Opens day ${a.day}`, disabled: !open, on: () => App.go('activity', { id: a.id, mode: 'week', hard: this.hard }),\n        value: () => (open && r ? String(Math.round(r.best)) : ''), rstars: r?.stars ?? 0, draw: (hud, x, ry, w) => { if (open && r) stars(hud, x + w - 100, ry + 2, r.stars, 1); } };\n    });\n    if (this.hardOk) items.push({ label: 'Version', value: () => (this.hard ? 'Hard' : 'Normal'), adjust: () => { this.hard = !this.hard; }, on: () => { this.hard = !this.hard; } });\n    items.push({ label: 'Back', on: () => App.close(this) });\n    this.menu = new Menu({ title: st.name, items, onBack: () => App.close(this), scale: 1, rowH: 15, w: Math.min(App.ctx.hud.width - 24, 340), maxRows: 8 });\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(hud) {\n    const r = this.menu.draw(hud);\n    const lines = wrap(this.remark, 52);\n    lines.forEach((l, i) => say(hud, r.x + 8, r.y + r.h + 4 + i * 10, l, { color: 'white' }));\n    promptBar(hud, [['confirm', 'Select'], ['back', 'Back']]);\n  }\n}\nexport class HubScene extends BaseScene {\n  id = 'hub'; canPause = true; near = null; barkIn = 4; nav = null; ounceHop = 0; npc = [];\n  camera() { return { preset: 'iso', zoom: 1.15 }; }\n  async build(ctx) {\n    this.ctx = ctx;\n    this.world = await buildIsland(ctx);\n    App.music('plaza');\n    const slot = App.slot, look = slot?.look ?? AVATARS[0];\n    const m = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n    dress(m.scene, { ...look, items: slot?.look?.equipped });\n    this.model = m.scene; setLookLayer(this.model, 'actors');\n    this.shadow = new ContactShadow(0.42);\n    ctx.scene.add(this.model, this.shadow);\n    const start = this.args.at ?? [0, 0.1, 6.5];\n    this.hero = new PlatformerCharacter(ctx.physics, { position: start, lockDepth: false });\n    this.hero.attachModel(this.model, compileClips(ALL_CLIPS, HERO_RIG, this.model), HERO_RIG);\n    this.input = null; this.f = new Vector3(); this.tmp = new Vector3(); this.ro = new Vector3(); this.rd = new Vector3();\n    this.ounce = place(ctx, 'ounce', start[0] + 1.6, 0, start[2] + 1, { actors: true, scale: 1.4 }); this.oSq = new Squash();\n    this.needle = this.ounce.object.getObjectByName('needle');\n    this.ox = start[0] + 1.6; this.oz = start[2] + 1; this.oy = 0; this.ovy = 0; this.oFacing = 0;\n    // Life: classmates on small loops.\n    for (const [who, x, z, clip, r] of [['coach', -11, 6.8, 'Tree', 0], ['marguerite', -6, 6, 'Idle', 1.2], ['dennis', 8.6, -2, 'Teeter', 0.6], ['june', 10, -8, 'Sit', 0]]) {\n      const a = await makeAvatar(ctx, CAST_LOOKS[who]); a.setAt(x, 0, z, 0); a.play(clip);\n      this.npc.push({ who, a, x, z, r, clip, ph: this.cosmetic.next() * 6 });\n    }\n    this.kevin = place(ctx, 'kevin', 7, 1.0, -1, { actors: true });\n    this.jarFluid();\n    if (slot?.phase === 'free' && !this.args.attract && !this.args.silent) this.dayIntro();\n    this.highlight = null;\n    this.walkT = 0;\n    applySky(ctx.engine, skyAt(this.args.sky ?? 11));\n  }\n  jarFluid() {\n    const slot = App.slot, { MILESTONES } = App._unlocks ?? {};\n    void MILESTONES;\n    const f = Math.min(1, (slot?.drips ?? 0) / 175);\n    const THREEm = THREE;\n    const m = new THREEm.Mesh(new THREEm.CylinderGeometry(0.96, 0.96, 1, 12), App._toon('sky'));\n    m.scale.y = Math.max(0.02, f * 2.2); m.position.set(4, 0.4 + m.scale.y / 2, -4); this.ctx.scene.add(m);\n    const s = new THREEm.Mesh(new THREEm.BoxGeometry(0.1, 1, 0.04), App._toon('white')); s.scale.y = m.scale.y * 0.8; s.position.set(3.55, m.position.y, -3.05); this.ctx.scene.add(s);\n  }\n  dayIntro() {\n    const slot = App.slot; if (slot.dayIntroDone === slot.day) return;\n    slot.dayIntroDone = slot.day; App.writeSave();\n    const d = scheduleDay(slot.day);\n    if (slot.week === 1) talk(STORY.days[d], () => {\n      const opened = openedToday(slot).map((id) => ACT[id].name);\n      if (opened.length) App.barkLine(`Open today: ${opened.slice(0, 2).join(', ')}${opened.length > 2 ? '...' : '.'}`, 'ounce', 3.4);\n    });\n  }\n  // Stations you can use right now.\n  stationKeys() {\n    const slot = App.slot, out = [];\n    for (const [k, s] of Object.entries(STATIONS)) {\n      if (k === 'terrace') continue;\n      if (s.unlockDay && slot && slot.week === 1 && slot.day < s.unlockDay) continue;\n      out.push(k);\n    }\n    return out;\n  }\n  frame(ctx, dt, rdt, free) {\n    const feet = this.model.position;\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const g = ctx.physics.groundBelow(this.tmp.set(feet.x, feet.y + 0.1, feet.z), 20, this.hero.body);\n    if (g) this.shadow.place(feet.x, g.y, feet.z, feet.y - g.y);\n    this.target.set(feet.x, feet.y + 0.9, feet.z);\n    this.world.update(ctx, dt);\n    this.world.grass.push?.(0, feet, 0.8);\n    // Near a station?\n    this.near = null; let bd = 3.6;\n    for (const k of this.stationKeys()) { const s = STATIONS[k], d = Math.hypot(s.at[0] - feet.x, s.at[1] - feet.z), r = k === 'pavilion' || k === 'beach' || k === 'shed' || k === 'lagoon' ? 5.6 : 3; if (d < r && d - r < bd - 3.6 + 0 && d < bd + 2) { bd = d; this.near = k; } }\n    // Mouse: hovering a station names it; clicking walks there and enters.\n    this.hover = null;\n    if (App.device.last === 'mouse' && !App.top()) {\n      const p = ctx.input.pointer; ctx.camera.rayAt(p.x, p.y, this.ro, this.rd);\n      const t = this.rd.y < 0 ? -this.ro.y / this.rd.y : null;\n      if (t !== null) {\n        const hx = this.ro.x + this.rd.x * t, hz = this.ro.z + this.rd.z * t;\n        let best = 4; for (const k of this.stationKeys()) { const s = STATIONS[k], d = Math.hypot(s.at[0] - hx, s.at[1] - hz); if (d < best) { best = d; this.hover = k; } }\n        if (ctx.input.wasPressed('MouseLeft') && free && !(pointerArt(ctx).x > ctx.hud.width - 22 && pointerArt(ctx).y < 22)) {\n          if (this.hover) { const s = STATIONS[this.hover]; this.nav = { x: s.at[0], z: s.at[1], enter: this.hover }; } else this.nav = { x: hx, z: hz };\n        }\n      }\n    }\n    if (free && !this.attract) {\n      const i = ctx.input;\n      if (this.near && i.wasPressed('PadCross', 'Enter', 'Space', 'KeyE')) { i.clearQueued('Space', 'PadCross'); this.interact(this.near); this.jumpBlock = 8; }\n    }\n    this.updateOunce(ctx, dt, free);\n    this.updateNpcs(ctx, dt);\n    if (App.settings) {\n      this.barkIn -= dt;\n      if (this.barkIn <= 0 && free && !App.bark) { this.barkIn = 8 + this.cosmetic.next() * 6; App.barkLine(this.cosmetic.pick(BARKS.hub), 'ounce', 3.4); }\n    }\n    this.footT = (this.footT ?? 0) + dt * (this.hero.speed > 0.5 ? this.hero.speed : 0);\n    if (this.footT > 1.6) { this.footT = 0; if (feet.y < 0.2 && Math.abs(feet.x) > 8 && feet.z < -5) this.world.decals.add('footprint', [feet.x, 0.02, feet.z], [0, 1, 0], { size: 0.5 }); }\n  }\n  tick(ctx, dt) {\n    if (!this.hero) return;\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    const i = this.input;\n    // Hero wrapper: pad buttons, on top of the kit's keys.\n    if (ctx.input.consumePress('PadCross')) i.jump = true;\n    if (ctx.input.isDown('PadCross')) i.jumpHeld = true;\n    if (ctx.input.consumeAny(ACTIONS.wave)) i.wave = true;\n    if (ctx.input.consumeAny(ACTIONS.sit)) i.sit = true;\n    // These kit keys mean something else here.\n    if (App.device.last === 'pad' || true) { i.attack = false; i.grab = false; }\n    if (this.jumpBlock > 0) { this.jumpBlock--; i.jump = false; i.jumpHeld = false; }\n    if (App.blocked()) { i.move.set(0, 0, 0); i.jump = false; i.jumpHeld = false; i.wave = false; i.sit = false; i.crouch = false; }\n    else if (this.attract) this.attractWalk(ctx, i);\n    else if (this.nav) {\n      const f = this.hero.feetInto(this.f), dx = this.nav.x - f.x, dz = this.nav.z - f.z, d = Math.hypot(dx, dz);\n      const manual = Math.hypot(i.move.x, i.move.z) > 0.05;\n      const reach = this.nav.enter ? 3 : 0.4;\n      if (manual) this.nav = null;\n      else if (d < reach) { const e = this.nav.enter; this.nav = null; if (e) this.interact(e); }\n      else i.move.set(dx / d, 0, dz / d);\n    }\n    this.hero.fixedUpdate(dt, i);\n  }\n  attractWalk(ctx, i) {\n    const route = [[-8, 3], [-7, -6], [7, -6], [8, 3], [0, 8]];\n    this.wp = this.wp ?? 0;\n    const f = this.hero.feetInto(this.f), [x, z] = route[this.wp], dx = x - f.x, dz = z - f.z, d = Math.hypot(dx, dz);\n    if (d < 1) this.wp = (this.wp + 1) % route.length; else i.move.set(dx / d, 0, dz / d);\n    this.attractJ = (this.attractJ ?? 0) + 1;\n    i.jump = this.attractJ % 200 === 0; i.jumpHeld = i.jump;\n  }\n  updateOunce(ctx, dt, free) {\n    const feet = this.model.position, o = this.ounce.object;\n    const dx = feet.x + 1.3 - this.ox, dz = feet.z + 0.9 - this.oz, d = Math.hypot(dx, dz);\n    this.oFacing = Math.atan2(feet.x - this.ox, feet.z - this.oz);\n    this.ovy -= 22 * dt; this.oy += this.ovy * dt;\n    if (this.oy <= 0) {\n      if (this.ovy < -1) { this.oSq.kick(-2.4); }\n      this.oy = 0; this.ovy = 0;\n      if (d > 1.2) { this.ovy = 4.6; this.oSq.kick(2); if (d < 12) App.sfx('hop', { volume: 0.25 }); this.hopVx = (dx / d) * Math.min(5.2, d * 2); this.hopVz = (dz / d) * Math.min(5.2, d * 2); } else { this.hopVx = 0; this.hopVz = 0; }\n    }\n    this.ox += (this.hopVx ?? 0) * dt; this.oz += (this.hopVz ?? 0) * dt;\n    this.oSq.update(dt); const [h, v] = this.oSq.scale();\n    o.position.set(this.ox, this.oy, this.oz); o.rotation.y = this.oFacing; o.scale.set(1.4 * h, 1.4 * v, 1.4 * h);\n    if (this.needle) this.needle.rotation.y = Math.PI + Math.sin(ctx.time * 2.3) * 0.5;\n  }\n  updateNpcs(ctx, dt) {\n    for (const n of this.npc) {\n      if (n.r > 0 && n.clip === 'Idle') {\n        n.ph += dt * 0.4; const x = n.x + Math.cos(n.ph) * n.r, z = n.z + Math.sin(n.ph) * n.r;\n        n.a.root.rotation.y = Math.atan2(x - n.a.root.position.x, z - n.a.root.position.z);\n        n.a.root.position.set(x, 0, z); n.a.play('Walk', { speed: 0.5 });\n      }\n      n.a.update(dt);\n    }\n    const k = this.kevin.object, w = Math.sin(ctx.time * 11) > 0.6 && Math.sin(ctx.time * 0.5) > 0.5 ? 0.7 : 0;\n    const wl = k.getObjectByName('wingL'), wr = k.getObjectByName('wingR'); if (wl) wl.rotation.z = w; if (wr) wr.rotation.z = -w;\n  }\n  interact(k) {\n    const st = STATIONS[k];\n    if (k === 'hammock') return this.hammock();\n    if (st.kind === 'scene') { App.go(st.scene, {}); return; }\n    App.open(new StationMenu(this, k));\n  }\n  hammock() {\n    const slot = App.slot;\n    const confirm = () => {\n      App.open(new class extends Object {\n        id = 'hammock'; menu = new Menu({ title: 'End the day?', items: [{ label: 'Lie down', on: () => { App.close(this.self); App.go('report'); } }, { label: 'Not yet', on: () => App.close(this.self) }], onBack: () => App.close(this.self), scale: 2 });\n        constructor() { super(); this.self = this; }\n        update(c, d) { this.menu.update(c, d); }\n        draw(h) { this.menu.draw(h); promptBar(h, [['confirm', 'Select'], ['back', 'Back']]); }\n      }());\n    };\n    if (!slot) { App.go('title'); return; }\n    if (slot.today.length === 0) talk(wrapLines(this.cosmetic.pick(BARKS.leavingEarly)), confirm);\n    else confirm();\n  }\n  draw(ctx, hud) {\n    const slot = App.slot, W = hud.width, H = hud.height;\n    if (slot && !App.attract) {\n      const d = slot.week > 1 ? `Week ${slot.week}, day ${scheduleDay(slot.day)}` : `Day ${slot.day}`;\n      say(hud, 12, 12, d, { scale: 2, color: 'white' }); note(12, 12, textWidth(d, 2), 14, 'hud-day');\n      const dr = `${slot.drips} Drips`; say(hud, W - 12 - 22 - textWidth(dr, 2), 12, dr, { scale: 2, color: 'cyan' }); note(W - 34 - textWidth(dr, 2), 12, textWidth(dr, 2), 14, 'hud-drips');\n      const g = weekDay(scheduleDay(slot.day)).goalText;\n      say(hud, 12, 30, `${slot.goalDone ? 'Done: ' : 'Prescription: '}${g}`, { color: slot.goalDone ? 'lime' : 'sand' });\n    }\n    if (App.top() || App.attract) return;\n    const show = this.near ?? this.hover;\n    const list = [];\n    if (show) {\n      const s = STATIONS[show], text = show === 'hammock' ? `End the day: ${s.name}` : `Enter: ${s.name}`;\n      list.push(['confirm', text]);\n    }\n    if (App.device.last !== 'mouse') list.push(['jump', 'Jump'], ['wave', 'Wave'], ['sit', 'Sit']); else list.push(['walk', 'Click to walk']);\n    list.push(['pause', 'Pause']);\n    promptBar(hud, W < 420 ? list.slice(0, 3) : list);\n  }\n  barkY(hud) { return 46; }\n  status() { return `hub | day ${App.slot?.day ?? '-'} | near ${this.near ?? '-'} | hero ${this.model ? `${this.model.position.x.toFixed(1)},${this.model.position.z.toFixed(1)}` : ''}`; }\n  fingerprint() { return this.status(); }\n  ready(ctx) { /* attract keeps walking */ }\n}\nconst wrapLines = (t) => [{ who: 'ounce', mood: 'wince', text: t }];\nexport { promptWidth, prompt, panel, isOpen };\nE\ncat > src/scenes/weighin.js <<'E'\n// The Morning Weigh-In: \"Ow.\", a balance test, one absurd question, today's Wobble Age.\nimport { applySky, skyAt, THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { buildPlaza } from '../art/island.js';\nimport { place } from '../art/stage.js';\nimport { makeDriver } from '../core/drivers.js';\nimport { Dot } from '../core/dot.js';\nimport { blankInput, LocalDriver } from '../core/drivers.js';\nimport { recordTest, scheduleDay, shownAge } from '../core/progress.js';\nimport { T } from '../core/tunables.js';\nimport { AVATARS } from '../data/classmates.js';\nimport { BARKS, QUESTIONS, STORY } from '../data/lines.js';\nimport { weekDay } from '../data/week.js';\nimport { talk } from '../ui/dialogue.js';\nimport { center, say, wrap } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { chart, dial, panel } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\n\n// The three tests. Pure, so tests can run them with bots.\nexport class WeighTest {\n  t = 0; done = false; T01 = 0; inT = 0; dist = 0; n = 0; idx = 0; holdT = 0; lean = []; started = 0;\n  constructor(kind, env, rng) {\n    this.kind = kind; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next());\n    this.seconds = kind === 'stillness' ? 14 : kind === 'chase' ? 14 : 15;\n    if (kind === 'lean') {\n      const pct = (p) => (p / 100) * 1.0;\n      this.targets = [{ x: -pct(50), y: 0, label: '50% left' }, { x: pct(70), y: 0, label: '70% right' }, { x: 0, y: pct(60), label: '60% forward' }];\n    }\n    this.ring = 0.3;\n  }\n  tx() { if (this.kind === 'chase') return { x: Math.sin(this.t * 0.7) * 0.5, y: Math.sin(this.t * 1.05 + 0.6) * 0.42 }; if (this.kind === 'lean') return this.targets[Math.min(this.idx, 2)]; return { x: 0, y: 0 }; }\n  step(dt, u) {\n    this.t += dt;\n    this.dot.step(dt, u.x, u.y, T, { noise: this.env.noiseMul });\n    if (this.env.god) { const t = this.tx(); this.dot.x = t.x; this.dot.y = t.y; }\n    if (this.kind === 'stillness') { if (this.dot.dist() <= this.ring * this.env.ringMul) this.inT += dt; this.T01 = this.inT / Math.max(this.t, 0.001); }\n    if (this.kind === 'chase') { const t = this.tx(); this.dist += Math.hypot(this.dot.x - t.x, this.dot.y - t.y) * dt; this.T01 = Math.max(0, 1 - (this.dist / this.t) * 2); }\n    if (this.kind === 'lean') {\n      const t = this.targets[this.idx];\n      if (t) {\n        const dd = Math.hypot(this.dot.x - t.x, this.dot.y - t.y);\n        if (dd <= 0.1 * this.env.ringMul / T.ringScale + 0.0) this.holdT += dt; else this.holdT = Math.max(0, this.holdT - dt * 0.5);\n        if (this.holdT >= 1.5) { this.idx++; this.holdT = 0; this.lean.push(this.t); }\n      }\n      this.T01 = this.idx >= 3 ? Math.max(0.2, 1 - (this.t - 4.5) / this.seconds) : (this.idx / 3) * 0.4;\n    }\n    if (this.t >= this.seconds || (this.kind === 'lean' && this.idx >= 3)) this.done = true;\n  }\n  bot(driver, out, dt) { const t = this.tx(); driver.brain.lean(this.dot, t.x, t.y, dt, out); }\n}\nexport class WeighInScene extends BaseScene {\n  id = 'weighin'; canPause = true; part = 'arrive'; partT = 0; age = 0; shownRoll = 0; out = blankInput(); spin = 0;\n  camera() { return { preset: 'fixed', position: [0, 2.0, 5.2], target: [0, 1.15, 0], fov: 34 }; }\n  async build(ctx) {\n    this.ctx = ctx;\n    this.world = await buildPlaza(ctx);\n    applySky(ctx.engine, skyAt(this.args.attract ? 9 : 8));\n    App.music('plaza');\n    this.b = place(ctx, 'ounce', 0, 0, 0, { actors: true, scale: 1.6 });\n    this.needle = this.b.object.getObjectByName('needle');\n    this.av = await makeAvatar(ctx, App.slot?.look ?? AVATARS[0]);\n    this.av.setAt(0, 0, 1.75, Math.PI); this.av.play('Walk');\n    const slot = App.slot;\n    this.day = slot ? scheduleDay(slot.day) : 1;\n    this.kind = this.args.attract ? ['stillness', 'lean', 'chase'][App.attractLoops % 3] : weekDay(this.day).test;\n    this.test = new WeighTest(this.kind, App.simEnv(ctx), ctx.random.fork('test'));\n    this.playerRng = ctx.random.fork('bot');\n    this.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(ctx));\n    this.first = slot && slot.tests.length === 0;\n    if (slot && !this.first) App.barkLine(this.cosmetic.pick(BARKS.morning), 'ounce', 3);\n  }\n  onDriverChange() { this.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(this.ctx)); }\n  setPart(p) { this.part = p; this.partT = 0; }\n  tick(ctx, dt) {\n    if (App.blocked()) return;\n    this.partT += dt;\n    if (this.part === 'test') {\n      this.driver.read(this.out, this.test, dt);\n      this.test.step(dt, this.out);\n      if (this.test.done) { App.sfx('chimeIn'); this.afterTest(ctx); }\n    }\n  }\n  frame(ctx, dt, rdt, free) {\n    this.av.update(dt); this.world.update(ctx, dt);\n    const a = this.av;\n    const needleTo = (r) => { if (this.needle) this.needle.rotation.y = Math.PI + r; };\n    if (this.part === 'arrive') {\n      a.root.position.z = Math.max(0.95, 1.75 - this.partT * 0.5);\n      if (this.partT > 1.2) { a.play('StepOn', { once: true }); this.setPart('stepon'); }\n    } else if (this.part === 'stepon') {\n      if (this.partT > 0.75) {\n        a.play('StandOn'); a.setAt(0, 0.08, 0.15, Math.PI); App.sfx('ow');\n        this.b.object.scale.y = 1.6 * 0.86; this.setPart('ow');\n        const line = this.cosmetic.pick(BARKS.ow);\n        if (this.first && !this.args.attract) talk(STORY.ferryIntro.slice(0, 3).concat({ who: 'ounce', mood: 'wince', text: line }).concat(STORY.ferryIntro.slice(3)), () => this.startTest());\n        else App.barkLine(line, 'ounce', 1.2);\n      }\n    } else if (this.part === 'ow') {\n      this.b.object.scale.y += (1.6 - this.b.object.scale.y) * Math.min(1, dt * 6);\n      if (this.partT > 1.1 && !App.top()) this.startTest();\n    } else if (this.part === 'test') {\n      a.lean.x = this.test.dot.x; a.lean.y = this.test.dot.y;\n      needleTo(this.test.dot.x * 1.2);\n    } else if (this.part === 'reveal') {\n      const k = Math.min(1, this.partT / 2.2);\n      this.spin += dt * (30 * (1 - k) + 0.5);\n      needleTo(this.spin);\n      if (Math.floor(this.partT * 18) !== this.tickN && k < 1) { this.tickN = Math.floor(this.partT * 18); App.sfx('needleTick'); }\n      const shown = this.shownAge;\n      this.roll = k < 1 ? Math.round(this.cosmetic.range(18, 96)) : shown;\n      if (k >= 1 && !this.revealed) {\n        this.revealed = true; App.sfx('chimeIn');\n        App.barkLine(this.revealLine(), 'ounce', 4);\n      }\n      if (this.revealed && (this.partT > 8 || (free && this.partT > 2.6 && ctx.input.wasPressed('PadCross', 'Enter', 'Space', 'MouseLeft')))) this.leave();\n    }\n    if (this.args.attract && this.part === 'question') this.afterQuestion(0);\n  }\n  startTest() {\n    if (this.part === 'test') return;\n    this.setPart('test');\n    App.barkLine(this.kind === 'stillness' ? 'Stand still. I will close my eyes. You will, too.' : this.kind === 'lean' ? 'Lean to each mark. Hold it there.' : 'Follow the orange circle. It knows where it is going.', 'ounce', 2.6);\n  }\n  afterTest(ctx) {\n    this.T01 = this.test.T01;\n    this.setPart('question');\n    const slot = App.slot;\n    if (this.args.attract) return;\n    const q = QUESTIONS[(this.day - 1) % QUESTIONS.length];\n    if (slot && slot.tests.length === 0 && !this.askedOld) this.askOld(() => this.ask(q)); else this.ask(q);\n  }\n  askOld(next) {\n    this.askedOld = true;\n    App.open(new OldPicker((v) => { this.felt = v; next(); }));\n  }\n  ask(q) {\n    App.say(q.q, 'ounce');\n    const items = q.a.map((label, i) => ({ label, on: () => { App.close(this.qo); this.answered(q, i); } }));\n    this.qo = { id: 'question', menu: new Menu({ title: null, subtitle: null, items, scale: 2, y: 104 }), q: q.q, update(c, d) { this.menu.update(c, d); }, draw(h) {\n      const ls = wrap(this.q, 52); const w = Math.min(h.width - 24, 330), x = (h.width - w) / 2;\n      panel(h, x, 64, w, 12 + ls.length * 10, 'white', 'teal'); ls.forEach((l, i) => say(h, x + 8, 70 + i * 10, l, { color: 'ink', shadow: false }));\n      this.menu.draw(h); promptBar(h, [['confirm', 'Answer']]);\n    } };\n    App.open(this.qo);\n  }\n  answered(q, i) {\n    if (App.slot) { App.slot.answers[this.day] = i; }\n    talk([{ who: 'ounce', mood: 'flat', text: q.r[i] }], () => this.afterQuestion());\n  }\n  afterQuestion() {\n    const slot = App.slot;\n    let age = 40;\n    if (this.args.attract) age = 31; else if (slot) { const prev = slot.chart[slot.chart.length - 1]; age = recordTest(slot, this.T01); this.prev = prev; slot.phase = 'free'; App.writeSave(); }\n    this.age = age; this.shownAge = slot && !this.args.attract ? shownAge(slot, age) : age + 7;\n    this.setPart('reveal'); this.revealed = false; this.spin = 0;\n  }\n  revealLine() {\n    const age = this.shownAge, slot = App.slot;\n    if (this.felt !== undefined) { const f = this.felt; this.felt = undefined; return `You said ${f}. Your Wobble Age is ${age}. Is that close? No? I'm so sorry.`; }\n    if (this.prev !== undefined && slot) { if (this.age === this.prev) return `${age}. ${BARKS.sameAge[0]}`; if (this.age < this.prev) return `${age}. ${BARKS.betterAge[this.day % 2]}`; return `${age}. ${BARKS.worseAge[this.day % 2]}`; }\n    return this.cosmetic.pick(BARKS.reveal).replace('{age}', age);\n  }\n  leave() { if (this.leaving) return; this.leaving = true; App.go('hub', { at: [0, 0.1, 6.5] }); }\n  draw(ctx, hud) {\n    const W = hud.width, H = hud.height;\n    if (App.top() && App.top().id !== 'pause') { /* dialogue over the scene */ }\n    if (this.part === 'test') {\n      const s = this.test, eyes = this.kind === 'stillness' && s.t > 3;\n      const r = Math.min(70, Math.floor(H * 0.26));\n      App.dialCenter.x = W / 2; App.dialCenter.y = 16 + r;\n      const t = this.kind === 'stillness' ? null : { ...s.tx(), r: this.kind === 'lean' ? 0.12 : 0.14 };\n      dial(hud, W / 2, 16 + r, r, { ringR: 0.3 * App.simEnv(ctx).ringMul, x: s.dot.x, y: s.dot.y, inside: s.dot.dist() <= 0.3, hideRing: eyes || this.kind !== 'stillness', hideDot: eyes, target: t });\n      const label = eyes ? 'Eyes closed.' : this.kind === 'stillness' ? 'Keep it in the circle.' : this.kind === 'lean' ? (s.targets[s.idx]?.label ?? 'Thank you.') : 'Follow the orange circle.';\n      center(hud, 22 + 2 * r, label, { color: 'white', scale: 1 });\n      if (!App.top() && !App.attract) promptBar(hud, [['lean', 'Lean'], ['pause', 'Pause']]);\n    } else if (this.part === 'reveal') {\n      panel(hud, W / 2 - 100, 18, 200, 62, 'white', 'teal');\n      center(hud, 24, 'Wobble Age', { color: 'teal', shadow: false, scale: 2 });\n      center(hud, 44, String(this.roll ?? '?'), { color: this.revealed ? 'red' : 'slate', shadow: false, scale: 4 });\n      if (this.revealed && !App.attract) {\n        const c = App.slot?.chart ?? [];\n        if (c.length > 1 && H > 260) chart(hud, W / 2 - 90, 84, 180, 70, c.map((v) => shownAge(App.slot, v)));\n        promptBar(hud, [['confirm', 'Thank you']]);\n      }\n    }\n  }\n  barkY(hud) { return this.part === 'test' ? hud.height - 72 : 150; }\n  status() { return `weighin | ${this.part} | ${this.kind} | T ${(this.test?.T01 ?? 0).toFixed(2)}`; }\n  fingerprint() { return `${this.part}|${(this.test?.t ?? 0).toFixed(3)}`; }\n  debugDot() { return this.test ? `${this.test.dot.x.toFixed(2)},${this.test.dot.y.toFixed(2)}` : '-'; }\n}\nclass OldPicker {\n  id = 'howold'; v = 38; t = 0;\n  constructor(done) {\n    this.done = done; App.say(STORY.howOld.text, 'ounce');\n    this.menu = new Menu({ items: [{ label: 'I feel', value: () => this.v, adjust: (d) => { this.v = Math.max(5, Math.min(120, this.v + d)); } }, { label: 'That\\'s it', on: () => { App.close(this); this.done(this.v); } }], scale: 2, y: 104 });\n  }\n  update(ctx, dt) { this.t += dt; this.menu.update(ctx, dt); }\n  draw(h) {\n    const w = Math.min(h.width - 24, 330), x = (h.width - w) / 2;\n    panel(h, x, 64, w, 24, 'white', 'teal'); say(h, x + 8, 72, STORY.howOld.text, { color: 'ink', shadow: false });\n    this.menu.draw(h); promptBar(h, [['adjust', 'Change'], ['confirm', 'Confirm']]);\n  }\n}\nvoid makeDriver; void THREE;\nE\nsed -i \"s/App._unlocks ?? {}/{}/; s/App._toon('sky')/toonMaterial(PALETTE.sky)/; s/App._toon('white')/toonMaterial(PALETTE.white)/\" src/scenes/hub.js\nsed -i \"s/import { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, applySky, skyAt } from/import { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, toonMaterial, applySky, skyAt } from/\" src/scenes/hub.js\necho \"- [x] island, hub, weighin\" >> PROGRESS.md","description":"Write island, hub, and Weigh-In scenes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28622,"cache_read_input_tokens":295200,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28622},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"49f0a26d-94e7-45e6-b88c-2c7ec51e4bc7","timestamp":"2026-11-05T07:46:17.359Z","request_id":"req_011CgjQaT5FsjwQ63iRNt19a","wire_tool_inputs":{"toolu_01JTGdiUSmPVwC4EXyFdktrS":{"command":"cat > src/art/island.js <<'E'\n// Tare Island. Tall things stay in the -x -z quadrant, so they never hide the player.\nimport { Boids, buildModel, PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { box, grass, place, sea, sky, tileFloor } from './stage.js';\nimport { Decals } from '../../pixel-engine.js';\nconst { BoxGeometry, InstancedMesh, Matrix4, Mesh, Quaternion, Vector3 } = THREE;\n\nexport const JOG_POINTS = [[0, 12], [7, 15], [15, 15], [20, 11], [20.5, 4], [16, 0], [19.5, -5], [20.5, -12], [15, -15.5], [8, -15], [5, -11], [0, -12.5], [-5, -11], [-8, -15], [-15, -15.5], [-20.5, -13], [-20, -6], [-15.5, -2], [-20, 3], [-20.5, 10], [-14, 11], [-9, 9], [-6, 14]];\n\nexport async function buildPlaza(ctx) {\n  sky(ctx);\n  tileFloor(ctx, 18, 16, 0, 1, 0);\n  box(ctx, 0, -0.06, 0, 60, 0.1, 50, 'green', { shadow: false });\n  ctx.physics.addStaticBox({ position: [0, -0.6, 0], halfExtents: [40, 0.5, 40] });\n  const water = sea(ctx, 200, 60, -0.25, 0, -44);\n  place(ctx, 'kettlebell-volcano', -14, -0.5, -22, { scale: 1.2 });\n  place(ctx, 'foam-roller-hill', 15, -0.5, -20);\n  place(ctx, 'fountain', -7, 0, -5); place(ctx, 'bench', 6.4, 0, -4); place(ctx, 'bench', -6.4, 0, 4, { turn: 90 });\n  place(ctx, 'palm', 8.8, 0, -6, { turn: 40 }); place(ctx, 'palm', -9.2, 0, -7, { turn: 200 });\n  place(ctx, 'sweat-jar', 4.5, 0, -6);\n  return { water, update(c, dt) { water.update(c.time); } };\n}\n\nexport async function buildIsland(ctx, { jog = false, collide = true } = {}) {\n  sky(ctx);\n  const add = collide ? { collide: true } : {};\n  // Land: lawn, sand, and the white plaza at the heart of it.\n  box(ctx, 0, -0.2, 0, 46, 0.4, 36, 'green', { shadow: false });\n  box(ctx, 12.5, -0.14, -11, 20, 0.3, 13, 'sand', { shadow: false });\n  box(ctx, -12.5, -0.14, -11, 20, 0.3, 13, 'sand', { shadow: false });\n  box(ctx, 0, -0.17, 17.5, 48, 0.3, 3, 'sand', { shadow: false });\n  box(ctx, 0, -0.17, -17.5, 48, 0.3, 3, 'sand', { shadow: false });\n  box(ctx, 23.5, -0.17, 0, 3, 0.3, 38, 'sand', { shadow: false }); box(ctx, -23.5, -0.17, 0, 3, 0.3, 38, 'sand', { shadow: false });\n  ctx.physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [30, 0.5, 26] });\n  const water = sea(ctx, 240, 200, -0.25, 0, 0);\n  const plaza = tileFloor(ctx, 15, 16, 0, 0.5, 0.005);\n  void plaza;\n  // Paths from the plaza to everything.\n  for (const [x, z, w, d] of [[-9.5, 3, 5, 2.4], [9.5, 3, 5, 2.4], [0, 10, 3, 3.6]]) box(ctx, x, 0.002, z, w, 0.01, d, 'white', { shadow: false });\n  // Jog path.\n  if (jog) {\n    const { CatmullRomCurve3 } = THREE;\n    const curve = new CatmullRomCurve3(JOG_POINTS.map(([x, z]) => new Vector3(x, 0, z)), true, 'catmullrom', 0.5);\n    const n = 280, g = new BoxGeometry(3.6, 0.02, 1.1), m = new InstancedMesh(g, toonMaterial(PALETTE.sand), n), mat = new Matrix4(), q = new Quaternion(), up = new Vector3(0, 1, 0);\n    for (let i = 0; i < n; i++) { const p = curve.getPointAt(i / n), t = curve.getTangentAt(i / n); q.setFromAxisAngle(up, Math.atan2(t.x, t.z)); mat.compose(new Vector3(p.x, 0.03, p.z), q, new Vector3(1, 1, 1)); m.setMatrixAt(i, mat); }\n    m.receiveShadow = true; ctx.scene.add(m);\n  }\n  // Stations.\n  const st = {};\n  st.ounceDais = place(ctx, 'fountain', 0, 0, -3.4, { ...add });\n  box(ctx, 0, 0.14, 3, 3.4, 0.28, 3.4, 'mist'); box(ctx, 0, 0.3, 3, 2.6, 0.08, 2.6, 'white');\n  if (collide) ctx.physics.addStaticBox({ position: [0, 0.14, 3], halfExtents: [1.7, 0.14, 1.7] });\n  st.pavilion = place(ctx, 'pavilion', -11, 0, 3);\n  st.pavilionRoof = st.pavilion;\n  if (collide) ctx.physics.addStaticCylinder([-11, 1, 3], 1, 3.6);\n  st.shed = place(ctx, 'rep-shed', 11, 0, 3, { turn: -90, ...add });\n  st.stage = place(ctx, 'beat-stage', 12, 0, -10, { turn: 0, ...add });\n  st.gate = place(ctx, 'jog-gate', 0, 0, 11);\n  st.jar = place(ctx, 'sweat-jar', 4, 0, -4, { ...add });\n  st.lockers = place(ctx, 'lockers', -4, 0, -4.4, { ...add });\n  st.hall = place(ctx, 'hall-board', 0, 0, -8, { ...add });\n  st.hammock = place(ctx, 'hammock', 14, 0, 10);\n  place(ctx, 'palm', 12.2, 0, 10, { ...add }); place(ctx, 'palm', 15.8, 0, 10, { turn: 180, ...add });\n  // Lagoon with a pier.\n  place(ctx, 'pier', -13, 0.1, -13.2, { params: { len: 14 } });\n  place(ctx, 'slack-anchor', -18.5, 0, -8.5, { ...add }); place(ctx, 'catapult', -8.5, 0, -11, { turn: 20, ...add });\n  place(ctx, 'yoga-mat', -11, 0.4, 3); place(ctx, 'yoga-mat', 8, 0.01, -8, { turn: 15 });\n  // Scenery.\n  place(ctx, 'kettlebell-volcano', -15, -0.2, -14 - 8, {});\n  place(ctx, 'foam-roller-hill', 15, -0.1, -22, {});\n  place(ctx, 'dumbbell-bridge', -18, -0.8, 13, { turn: 90 });\n  box(ctx, -18, -0.1, 13, 5, 0.3, 6, 'sky', { shadow: false });\n  if (collide) ctx.physics.addStaticBox({ position: [-18, 0.5, 13], halfExtents: [3, 1, 3.4] });\n  for (const [x, z, s] of [[-21, 3, 0.8], [-20.5, -3, 1], [21, 2, 0.9], [21, 8, 0.6], [6, 15, 0.8], [-7, 15, 1], [-3, -16, 0.7], [8, -16, 0.9]]) place(ctx, 'med-ball', x, 0, z, { scale: s });\n  for (const [x, z, t] of [[-20, 8, 30], [20, -3, 100], [17, 14, 200], [-13, 15, 300], [-3, -14, 50], [8, 13, 160]]) place(ctx, 'palm', x, 0, z, { turn: t });\n  for (const [id, x, z, t] of [['bench', 7, -1, -90], ['bench', -7, -1, 90], ['bench', 5.5, 7, 180], ['bush', -7.5, 8, 0], ['bush', 7.5, 8, 0], ['flowers', -5, 9, 0], ['flowers', 5, 9, 0], ['lamp-post', -7.2, 7.5, 0], ['lamp-post', 7.2, 7.5, 0], ['lamp-post', -7.2, -6.5, 0], ['lamp-post', 7.2, -6.5, 0], ['signpost', 2.4, 9.6, 0], ['bush', 16, 7, 0], ['flowers', 12, 12, 0], ['oak', -19, -2, 0]]) place(ctx, id, x, 0, z, { turn: t });\n  // Edge walls so nobody walks into the sea.\n  if (collide) for (const [x, z, hx, hz] of [[0, 19.2, 26, 0.5], [0, -19.2, 26, 0.5], [24.5, 0, 0.5, 20], [-24.5, 0, 0.5, 20]]) ctx.physics.addStaticBox({ position: [x, 1.5, z], halfExtents: [hx, 2, hz] });\n  // Grass and gulls.\n  const onPath = (x, z) => (Math.abs(x) < 8.4 && z > -8.5 && z < 9.5) || (z < -4.5 && Math.abs(x) > 2.5) || (Math.abs(z - 3) < 1.6 && Math.abs(x) < 14);\n  const g = grass(ctx, { area: [44, 32], at: [0, 0, 0], count: 4800, height: [0.22, 0.42], width: 0.08, mask: (x, z) => !onPath(x, z), seed: 5 });\n  const gulls = new Boids(12, { bounds: { min: [-22, 7, -18], max: [22, 12, 16] }, seed: 3 });\n  const gullMeshes = Array.from({ length: gulls.count }, () => { const b = new Mesh(new BoxGeometry(0.7, 0.08, 0.26), toonMaterial(PALETTE.white)); ctx.scene.add(b); return b; });\n  const decals = new Decals(ctx.scene);\n  let gt = 0;\n  return { water, grass: g, gulls, decals, st, update(c, dt) {\n    water.update(c.time); g.update(c.time); decals.update(dt);\n    gt += dt; if (gt > 0.03) { gulls.step(gt); gt = 0; }\n    for (let i = 0; i < gullMeshes.length; i++) { gullMeshes[i].position.set(gulls.pos[i * 3], gulls.pos[i * 3 + 1], gulls.pos[i * 3 + 2]); gullMeshes[i].scale.x = 0.8 + Math.sin(c.time * 7 + i) * 0.3; gullMeshes[i].rotation.y = Math.atan2(gulls.vel[i * 3], gulls.vel[i * 3 + 2]); }\n  } };\n}\nexport const needle = (b) => b.object.getObjectByName('needle');\nvoid buildModel;\nE\ncat > src/scenes/hub.js <<'E'\n// The island: walk between stations. Jumping and waving have no purpose and are still here.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, applySky, skyAt } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { dress, makeAvatar } from '../art/avatar.js';\nimport { ALL_CLIPS } from '../art/clips.js';\nimport { buildIsland } from '../art/island.js';\nimport { place } from '../art/stage.js';\nimport { ACTIONS } from '../core/actions.js';\nimport { isOpen, hardOpen, openedToday, scheduleDay } from '../core/progress.js';\nimport { ACT, STATION_ACTS } from '../data/activities.js';\nimport { AVATARS, CAST_LOOKS } from '../data/classmates.js';\nimport { BARKS, STORY } from '../data/lines.js';\nimport { STATIONS } from '../data/stations.js';\nimport { weekDay } from '../data/week.js';\nimport { say, textWidth, wrap } from '../ui/font.js';\nimport { talk } from '../ui/dialogue.js';\nimport { Menu, pointerArt } from '../ui/menu.js';\nimport { prompt, promptBar, promptWidth } from '../ui/prompts.js';\nimport { note, panel, stars } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nconst { Vector3 } = THREE;\n\nexport class StationMenu {\n  id = 'station'; attractable = false;\n  constructor(scene, key) {\n    this.scene = scene; this.key = key;\n    const st = STATIONS[key], slot = App.slot; this.remark = st.remark;\n    const acts = STATION_ACTS(key); this.hard = false; this.hardOk = hardOpen(slot);\n    const items = acts.map((a) => {\n      const open = isOpen(slot, a.id);\n      const r = slot?.records[a.id];\n      return { label: open ? a.name : `Opens day ${a.day}`, disabled: !open, on: () => App.go('activity', { id: a.id, mode: 'week', hard: this.hard }),\n        value: () => (open && r ? String(Math.round(r.best)) : ''), rstars: r?.stars ?? 0, draw: (hud, x, ry, w) => { if (open && r) stars(hud, x + w - 100, ry + 2, r.stars, 1); } };\n    });\n    if (this.hardOk) items.push({ label: 'Version', value: () => (this.hard ? 'Hard' : 'Normal'), adjust: () => { this.hard = !this.hard; }, on: () => { this.hard = !this.hard; } });\n    items.push({ label: 'Back', on: () => App.close(this) });\n    this.menu = new Menu({ title: st.name, items, onBack: () => App.close(this), scale: 1, rowH: 15, w: Math.min(App.ctx.hud.width - 24, 340), maxRows: 8 });\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(hud) {\n    const r = this.menu.draw(hud);\n    const lines = wrap(this.remark, 52);\n    lines.forEach((l, i) => say(hud, r.x + 8, r.y + r.h + 4 + i * 10, l, { color: 'white' }));\n    promptBar(hud, [['confirm', 'Select'], ['back', 'Back']]);\n  }\n}\nexport class HubScene extends BaseScene {\n  id = 'hub'; canPause = true; near = null; barkIn = 4; nav = null; ounceHop = 0; npc = [];\n  camera() { return { preset: 'iso', zoom: 1.15 }; }\n  async build(ctx) {\n    this.ctx = ctx;\n    this.world = await buildIsland(ctx);\n    App.music('plaza');\n    const slot = App.slot, look = slot?.look ?? AVATARS[0];\n    const m = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n    dress(m.scene, { ...look, items: slot?.look?.equipped });\n    this.model = m.scene; setLookLayer(this.model, 'actors');\n    this.shadow = new ContactShadow(0.42);\n    ctx.scene.add(this.model, this.shadow);\n    const start = this.args.at ?? [0, 0.1, 6.5];\n    this.hero = new PlatformerCharacter(ctx.physics, { position: start, lockDepth: false });\n    this.hero.attachModel(this.model, compileClips(ALL_CLIPS, HERO_RIG, this.model), HERO_RIG);\n    this.input = null; this.f = new Vector3(); this.tmp = new Vector3(); this.ro = new Vector3(); this.rd = new Vector3();\n    this.ounce = place(ctx, 'ounce', start[0] + 1.6, 0, start[2] + 1, { actors: true, scale: 1.4 }); this.oSq = new Squash();\n    this.needle = this.ounce.object.getObjectByName('needle');\n    this.ox = start[0] + 1.6; this.oz = start[2] + 1; this.oy = 0; this.ovy = 0; this.oFacing = 0;\n    // Life: classmates on small loops.\n    for (const [who, x, z, clip, r] of [['coach', -11, 6.8, 'Tree', 0], ['marguerite', -6, 6, 'Idle', 1.2], ['dennis', 8.6, -2, 'Teeter', 0.6], ['june', 10, -8, 'Sit', 0]]) {\n      const a = await makeAvatar(ctx, CAST_LOOKS[who]); a.setAt(x, 0, z, 0); a.play(clip);\n      this.npc.push({ who, a, x, z, r, clip, ph: this.cosmetic.next() * 6 });\n    }\n    this.kevin = place(ctx, 'kevin', 7, 1.0, -1, { actors: true });\n    this.jarFluid();\n    if (slot?.phase === 'free' && !this.args.attract && !this.args.silent) this.dayIntro();\n    this.highlight = null;\n    this.walkT = 0;\n    applySky(ctx.engine, skyAt(this.args.sky ?? 11));\n  }\n  jarFluid() {\n    const slot = App.slot, { MILESTONES } = App._unlocks ?? {};\n    void MILESTONES;\n    const f = Math.min(1, (slot?.drips ?? 0) / 175);\n    const THREEm = THREE;\n    const m = new THREEm.Mesh(new THREEm.CylinderGeometry(0.96, 0.96, 1, 12), App._toon('sky'));\n    m.scale.y = Math.max(0.02, f * 2.2); m.position.set(4, 0.4 + m.scale.y / 2, -4); this.ctx.scene.add(m);\n    const s = new THREEm.Mesh(new THREEm.BoxGeometry(0.1, 1, 0.04), App._toon('white')); s.scale.y = m.scale.y * 0.8; s.position.set(3.55, m.position.y, -3.05); this.ctx.scene.add(s);\n  }\n  dayIntro() {\n    const slot = App.slot; if (slot.dayIntroDone === slot.day) return;\n    slot.dayIntroDone = slot.day; App.writeSave();\n    const d = scheduleDay(slot.day);\n    if (slot.week === 1) talk(STORY.days[d], () => {\n      const opened = openedToday(slot).map((id) => ACT[id].name);\n      if (opened.length) App.barkLine(`Open today: ${opened.slice(0, 2).join(', ')}${opened.length > 2 ? '...' : '.'}`, 'ounce', 3.4);\n    });\n  }\n  // Stations you can use right now.\n  stationKeys() {\n    const slot = App.slot, out = [];\n    for (const [k, s] of Object.entries(STATIONS)) {\n      if (k === 'terrace') continue;\n      if (s.unlockDay && slot && slot.week === 1 && slot.day < s.unlockDay) continue;\n      out.push(k);\n    }\n    return out;\n  }\n  frame(ctx, dt, rdt, free) {\n    const feet = this.model.position;\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const g = ctx.physics.groundBelow(this.tmp.set(feet.x, feet.y + 0.1, feet.z), 20, this.hero.body);\n    if (g) this.shadow.place(feet.x, g.y, feet.z, feet.y - g.y);\n    this.target.set(feet.x, feet.y + 0.9, feet.z);\n    this.world.update(ctx, dt);\n    this.world.grass.push?.(0, feet, 0.8);\n    // Near a station?\n    this.near = null; let bd = 3.6;\n    for (const k of this.stationKeys()) { const s = STATIONS[k], d = Math.hypot(s.at[0] - feet.x, s.at[1] - feet.z), r = k === 'pavilion' || k === 'beach' || k === 'shed' || k === 'lagoon' ? 5.6 : 3; if (d < r && d - r < bd - 3.6 + 0 && d < bd + 2) { bd = d; this.near = k; } }\n    // Mouse: hovering a station names it; clicking walks there and enters.\n    this.hover = null;\n    if (App.device.last === 'mouse' && !App.top()) {\n      const p = ctx.input.pointer; ctx.camera.rayAt(p.x, p.y, this.ro, this.rd);\n      const t = this.rd.y < 0 ? -this.ro.y / this.rd.y : null;\n      if (t !== null) {\n        const hx = this.ro.x + this.rd.x * t, hz = this.ro.z + this.rd.z * t;\n        let best = 4; for (const k of this.stationKeys()) { const s = STATIONS[k], d = Math.hypot(s.at[0] - hx, s.at[1] - hz); if (d < best) { best = d; this.hover = k; } }\n        if (ctx.input.wasPressed('MouseLeft') && free && !(pointerArt(ctx).x > ctx.hud.width - 22 && pointerArt(ctx).y < 22)) {\n          if (this.hover) { const s = STATIONS[this.hover]; this.nav = { x: s.at[0], z: s.at[1], enter: this.hover }; } else this.nav = { x: hx, z: hz };\n        }\n      }\n    }\n    if (free && !this.attract) {\n      const i = ctx.input;\n      if (this.near && i.wasPressed('PadCross', 'Enter', 'Space', 'KeyE')) { i.clearQueued('Space', 'PadCross'); this.interact(this.near); this.jumpBlock = 8; }\n    }\n    this.updateOunce(ctx, dt, free);\n    this.updateNpcs(ctx, dt);\n    if (App.settings) {\n      this.barkIn -= dt;\n      if (this.barkIn <= 0 && free && !App.bark) { this.barkIn = 8 + this.cosmetic.next() * 6; App.barkLine(this.cosmetic.pick(BARKS.hub), 'ounce', 3.4); }\n    }\n    this.footT = (this.footT ?? 0) + dt * (this.hero.speed > 0.5 ? this.hero.speed : 0);\n    if (this.footT > 1.6) { this.footT = 0; if (feet.y < 0.2 && Math.abs(feet.x) > 8 && feet.z < -5) this.world.decals.add('footprint', [feet.x, 0.02, feet.z], [0, 1, 0], { size: 0.5 }); }\n  }\n  tick(ctx, dt) {\n    if (!this.hero) return;\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    const i = this.input;\n    // Hero wrapper: pad buttons, on top of the kit's keys.\n    if (ctx.input.consumePress('PadCross')) i.jump = true;\n    if (ctx.input.isDown('PadCross')) i.jumpHeld = true;\n    if (ctx.input.consumeAny(ACTIONS.wave)) i.wave = true;\n    if (ctx.input.consumeAny(ACTIONS.sit)) i.sit = true;\n    // These kit keys mean something else here.\n    if (App.device.last === 'pad' || true) { i.attack = false; i.grab = false; }\n    if (this.jumpBlock > 0) { this.jumpBlock--; i.jump = false; i.jumpHeld = false; }\n    if (App.blocked()) { i.move.set(0, 0, 0); i.jump = false; i.jumpHeld = false; i.wave = false; i.sit = false; i.crouch = false; }\n    else if (this.attract) this.attractWalk(ctx, i);\n    else if (this.nav) {\n      const f = this.hero.feetInto(this.f), dx = this.nav.x - f.x, dz = this.nav.z - f.z, d = Math.hypot(dx, dz);\n      const manual = Math.hypot(i.move.x, i.move.z) > 0.05;\n      const reach = this.nav.enter ? 3 : 0.4;\n      if (manual) this.nav = null;\n      else if (d < reach) { const e = this.nav.enter; this.nav = null; if (e) this.interact(e); }\n      else i.move.set(dx / d, 0, dz / d);\n    }\n    this.hero.fixedUpdate(dt, i);\n  }\n  attractWalk(ctx, i) {\n    const route = [[-8, 3], [-7, -6], [7, -6], [8, 3], [0, 8]];\n    this.wp = this.wp ?? 0;\n    const f = this.hero.feetInto(this.f), [x, z] = route[this.wp], dx = x - f.x, dz = z - f.z, d = Math.hypot(dx, dz);\n    if (d < 1) this.wp = (this.wp + 1) % route.length; else i.move.set(dx / d, 0, dz / d);\n    this.attractJ = (this.attractJ ?? 0) + 1;\n    i.jump = this.attractJ % 200 === 0; i.jumpHeld = i.jump;\n  }\n  updateOunce(ctx, dt, free) {\n    const feet = this.model.position, o = this.ounce.object;\n    const dx = feet.x + 1.3 - this.ox, dz = feet.z + 0.9 - this.oz, d = Math.hypot(dx, dz);\n    this.oFacing = Math.atan2(feet.x - this.ox, feet.z - this.oz);\n    this.ovy -= 22 * dt; this.oy += this.ovy * dt;\n    if (this.oy <= 0) {\n      if (this.ovy < -1) { this.oSq.kick(-2.4); }\n      this.oy = 0; this.ovy = 0;\n      if (d > 1.2) { this.ovy = 4.6; this.oSq.kick(2); if (d < 12) App.sfx('hop', { volume: 0.25 }); this.hopVx = (dx / d) * Math.min(5.2, d * 2); this.hopVz = (dz / d) * Math.min(5.2, d * 2); } else { this.hopVx = 0; this.hopVz = 0; }\n    }\n    this.ox += (this.hopVx ?? 0) * dt; this.oz += (this.hopVz ?? 0) * dt;\n    this.oSq.update(dt); const [h, v] = this.oSq.scale();\n    o.position.set(this.ox, this.oy, this.oz); o.rotation.y = this.oFacing; o.scale.set(1.4 * h, 1.4 * v, 1.4 * h);\n    if (this.needle) this.needle.rotation.y = Math.PI + Math.sin(ctx.time * 2.3) * 0.5;\n  }\n  updateNpcs(ctx, dt) {\n    for (const n of this.npc) {\n      if (n.r > 0 && n.clip === 'Idle') {\n        n.ph += dt * 0.4; const x = n.x + Math.cos(n.ph) * n.r, z = n.z + Math.sin(n.ph) * n.r;\n        n.a.root.rotation.y = Math.atan2(x - n.a.root.position.x, z - n.a.root.position.z);\n        n.a.root.position.set(x, 0, z); n.a.play('Walk', { speed: 0.5 });\n      }\n      n.a.update(dt);\n    }\n    const k = this.kevin.object, w = Math.sin(ctx.time * 11) > 0.6 && Math.sin(ctx.time * 0.5) > 0.5 ? 0.7 : 0;\n    const wl = k.getObjectByName('wingL'), wr = k.getObjectByName('wingR'); if (wl) wl.rotation.z = w; if (wr) wr.rotation.z = -w;\n  }\n  interact(k) {\n    const st = STATIONS[k];\n    if (k === 'hammock') return this.hammock();\n    if (st.kind === 'scene') { App.go(st.scene, {}); return; }\n    App.open(new StationMenu(this, k));\n  }\n  hammock() {\n    const slot = App.slot;\n    const confirm = () => {\n      App.open(new class extends Object {\n        id = 'hammock'; menu = new Menu({ title: 'End the day?', items: [{ label: 'Lie down', on: () => { App.close(this.self); App.go('report'); } }, { label: 'Not yet', on: () => App.close(this.self) }], onBack: () => App.close(this.self), scale: 2 });\n        constructor() { super(); this.self = this; }\n        update(c, d) { this.menu.update(c, d); }\n        draw(h) { this.menu.draw(h); promptBar(h, [['confirm', 'Select'], ['back', 'Back']]); }\n      }());\n    };\n    if (!slot) { App.go('title'); return; }\n    if (slot.today.length === 0) talk(wrapLines(this.cosmetic.pick(BARKS.leavingEarly)), confirm);\n    else confirm();\n  }\n  draw(ctx, hud) {\n    const slot = App.slot, W = hud.width, H = hud.height;\n    if (slot && !App.attract) {\n      const d = slot.week > 1 ? `Week ${slot.week}, day ${scheduleDay(slot.day)}` : `Day ${slot.day}`;\n      say(hud, 12, 12, d, { scale: 2, color: 'white' }); note(12, 12, textWidth(d, 2), 14, 'hud-day');\n      const dr = `${slot.drips} Drips`; say(hud, W - 12 - 22 - textWidth(dr, 2), 12, dr, { scale: 2, color: 'cyan' }); note(W - 34 - textWidth(dr, 2), 12, textWidth(dr, 2), 14, 'hud-drips');\n      const g = weekDay(scheduleDay(slot.day)).goalText;\n      say(hud, 12, 30, `${slot.goalDone ? 'Done: ' : 'Prescription: '}${g}`, { color: slot.goalDone ? 'lime' : 'sand' });\n    }\n    if (App.top() || App.attract) return;\n    const show = this.near ?? this.hover;\n    const list = [];\n    if (show) {\n      const s = STATIONS[show], text = show === 'hammock' ? `End the day: ${s.name}` : `Enter: ${s.name}`;\n      list.push(['confirm', text]);\n    }\n    if (App.device.last !== 'mouse') list.push(['jump', 'Jump'], ['wave', 'Wave'], ['sit', 'Sit']); else list.push(['walk', 'Click to walk']);\n    list.push(['pause', 'Pause']);\n    promptBar(hud, W < 420 ? list.slice(0, 3) : list);\n  }\n  barkY(hud) { return 46; }\n  status() { return `hub | day ${App.slot?.day ?? '-'} | near ${this.near ?? '-'} | hero ${this.model ? `${this.model.position.x.toFixed(1)},${this.model.position.z.toFixed(1)}` : ''}`; }\n  fingerprint() { return this.status(); }\n  ready(ctx) { /* attract keeps walking */ }\n}\nconst wrapLines = (t) => [{ who: 'ounce', mood: 'wince', text: t }];\nexport { promptWidth, prompt, panel, isOpen };\nE\ncat > src/scenes/weighin.js <<'E'\n// The Morning Weigh-In: \"Ow.\", a balance test, one absurd question, today's Wobble Age.\nimport { applySky, skyAt, THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { buildPlaza } from '../art/island.js';\nimport { place } from '../art/stage.js';\nimport { makeDriver } from '../core/drivers.js';\nimport { Dot } from '../core/dot.js';\nimport { blankInput, LocalDriver } from '../core/drivers.js';\nimport { recordTest, scheduleDay, shownAge } from '../core/progress.js';\nimport { T } from '../core/tunables.js';\nimport { AVATARS } from '../data/classmates.js';\nimport { BARKS, QUESTIONS, STORY } from '../data/lines.js';\nimport { weekDay } from '../data/week.js';\nimport { talk } from '../ui/dialogue.js';\nimport { center, say, wrap } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { chart, dial, panel } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\n\n// The three tests. Pure, so tests can run them with bots.\nexport class WeighTest {\n  t = 0; done = false; T01 = 0; inT = 0; dist = 0; n = 0; idx = 0; holdT = 0; lean = []; started = 0;\n  constructor(kind, env, rng) {\n    this.kind = kind; this.env = env; this.rng = rng; this.dot = new Dot(() => rng.next());\n    this.seconds = kind === 'stillness' ? 14 : kind === 'chase' ? 14 : 15;\n    if (kind === 'lean') {\n      const pct = (p) => (p / 100) * 1.0;\n      this.targets = [{ x: -pct(50), y: 0, label: '50% left' }, { x: pct(70), y: 0, label: '70% right' }, { x: 0, y: pct(60), label: '60% forward' }];\n    }\n    this.ring = 0.3;\n  }\n  tx() { if (this.kind === 'chase') return { x: Math.sin(this.t * 0.7) * 0.5, y: Math.sin(this.t * 1.05 + 0.6) * 0.42 }; if (this.kind === 'lean') return this.targets[Math.min(this.idx, 2)]; return { x: 0, y: 0 }; }\n  step(dt, u) {\n    this.t += dt;\n    this.dot.step(dt, u.x, u.y, T, { noise: this.env.noiseMul });\n    if (this.env.god) { const t = this.tx(); this.dot.x = t.x; this.dot.y = t.y; }\n    if (this.kind === 'stillness') { if (this.dot.dist() <= this.ring * this.env.ringMul) this.inT += dt; this.T01 = this.inT / Math.max(this.t, 0.001); }\n    if (this.kind === 'chase') { const t = this.tx(); this.dist += Math.hypot(this.dot.x - t.x, this.dot.y - t.y) * dt; this.T01 = Math.max(0, 1 - (this.dist / this.t) * 2); }\n    if (this.kind === 'lean') {\n      const t = this.targets[this.idx];\n      if (t) {\n        const dd = Math.hypot(this.dot.x - t.x, this.dot.y - t.y);\n        if (dd <= 0.1 * this.env.ringMul / T.ringScale + 0.0) this.holdT += dt; else this.holdT = Math.max(0, this.holdT - dt * 0.5);\n        if (this.holdT >= 1.5) { this.idx++; this.holdT = 0; this.lean.push(this.t); }\n      }\n      this.T01 = this.idx >= 3 ? Math.max(0.2, 1 - (this.t - 4.5) / this.seconds) : (this.idx / 3) * 0.4;\n    }\n    if (this.t >= this.seconds || (this.kind === 'lean' && this.idx >= 3)) this.done = true;\n  }\n  bot(driver, out, dt) { const t = this.tx(); driver.brain.lean(this.dot, t.x, t.y, dt, out); }\n}\nexport class WeighInScene extends BaseScene {\n  id = 'weighin'; canPause = true; part = 'arrive'; partT = 0; age = 0; shownRoll = 0; out = blankInput(); spin = 0;\n  camera() { return { preset: 'fixed', position: [0, 2.0, 5.2], target: [0, 1.15, 0], fov: 34 }; }\n  async build(ctx) {\n    this.ctx = ctx;\n    this.world = await buildPlaza(ctx);\n    applySky(ctx.engine, skyAt(this.args.attract ? 9 : 8));\n    App.music('plaza');\n    this.b = place(ctx, 'ounce', 0, 0, 0, { actors: true, scale: 1.6 });\n    this.needle = this.b.object.getObjectByName('needle');\n    this.av = await makeAvatar(ctx, App.slot?.look ?? AVATARS[0]);\n    this.av.setAt(0, 0, 1.75, Math.PI); this.av.play('Walk');\n    const slot = App.slot;\n    this.day = slot ? scheduleDay(slot.day) : 1;\n    this.kind = this.args.attract ? ['stillness', 'lean', 'chase'][App.attractLoops % 3] : weekDay(this.day).test;\n    this.test = new WeighTest(this.kind, App.simEnv(ctx), ctx.random.fork('test'));\n    this.playerRng = ctx.random.fork('bot');\n    this.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(ctx));\n    this.first = slot && slot.tests.length === 0;\n    if (slot && !this.first) App.barkLine(this.cosmetic.pick(BARKS.morning), 'ounce', 3);\n  }\n  onDriverChange() { this.driver = App.playerDriver(this.playerRng) ?? new LocalDriver(App.lanesEnv(this.ctx)); }\n  setPart(p) { this.part = p; this.partT = 0; }\n  tick(ctx, dt) {\n    if (App.blocked()) return;\n    this.partT += dt;\n    if (this.part === 'test') {\n      this.driver.read(this.out, this.test, dt);\n      this.test.step(dt, this.out);\n      if (this.test.done) { App.sfx('chimeIn'); this.afterTest(ctx); }\n    }\n  }\n  frame(ctx, dt, rdt, free) {\n    this.av.update(dt); this.world.update(ctx, dt);\n    const a = this.av;\n    const needleTo = (r) => { if (this.needle) this.needle.rotation.y = Math.PI + r; };\n    if (this.part === 'arrive') {\n      a.root.position.z = Math.max(0.95, 1.75 - this.partT * 0.5);\n      if (this.partT > 1.2) { a.play('StepOn', { once: true }); this.setPart('stepon'); }\n    } else if (this.part === 'stepon') {\n      if (this.partT > 0.75) {\n        a.play('StandOn'); a.setAt(0, 0.08, 0.15, Math.PI); App.sfx('ow');\n        this.b.object.scale.y = 1.6 * 0.86; this.setPart('ow');\n        const line = this.cosmetic.pick(BARKS.ow);\n        if (this.first && !this.args.attract) talk(STORY.ferryIntro.slice(0, 3).concat({ who: 'ounce', mood: 'wince', text: line }).concat(STORY.ferryIntro.slice(3)), () => this.startTest());\n        else App.barkLine(line, 'ounce', 1.2);\n      }\n    } else if (this.part === 'ow') {\n      this.b.object.scale.y += (1.6 - this.b.object.scale.y) * Math.min(1, dt * 6);\n      if (this.partT > 1.1 && !App.top()) this.startTest();\n    } else if (this.part === 'test') {\n      a.lean.x = this.test.dot.x; a.lean.y = this.test.dot.y;\n      needleTo(this.test.dot.x * 1.2);\n    } else if (this.part === 'reveal') {\n      const k = Math.min(1, this.partT / 2.2);\n      this.spin += dt * (30 * (1 - k) + 0.5);\n      needleTo(this.spin);\n      if (Math.floor(this.partT * 18) !== this.tickN && k < 1) { this.tickN = Math.floor(this.partT * 18); App.sfx('needleTick'); }\n      const shown = this.shownAge;\n      this.roll = k < 1 ? Math.round(this.cosmetic.range(18, 96)) : shown;\n      if (k >= 1 && !this.revealed) {\n        this.revealed = true; App.sfx('chimeIn');\n        App.barkLine(this.revealLine(), 'ounce', 4);\n      }\n      if (this.revealed && (this.partT > 8 || (free && this.partT > 2.6 && ctx.input.wasPressed('PadCross', 'Enter', 'Space', 'MouseLeft')))) this.leave();\n    }\n    if (this.args.attract && this.part === 'question') this.afterQuestion(0);\n  }\n  startTest() {\n    if (this.part === 'test') return;\n    this.setPart('test');\n    App.barkLine(this.kind === 'stillness' ? 'Stand still. I will close my eyes. You will, too.' : this.kind === 'lean' ? 'Lean to each mark. Hold it there.' : 'Follow the orange circle. It knows where it is going.', 'ounce', 2.6);\n  }\n  afterTest(ctx) {\n    this.T01 = this.test.T01;\n    this.setPart('question');\n    const slot = App.slot;\n    if (this.args.attract) return;\n    const q = QUESTIONS[(this.day - 1) % QUESTIONS.length];\n    if (slot && slot.tests.length === 0 && !this.askedOld) this.askOld(() => this.ask(q)); else this.ask(q);\n  }\n  askOld(next) {\n    this.askedOld = true;\n    App.open(new OldPicker((v) => { this.felt = v; next(); }));\n  }\n  ask(q) {\n    App.say(q.q, 'ounce');\n    const items = q.a.map((label, i) => ({ label, on: () => { App.close(this.qo); this.answered(q, i); } }));\n    this.qo = { id: 'question', menu: new Menu({ title: null, subtitle: null, items, scale: 2, y: 104 }), q: q.q, update(c, d) { this.menu.update(c, d); }, draw(h) {\n      const ls = wrap(this.q, 52); const w = Math.min(h.width - 24, 330), x = (h.width - w) / 2;\n      panel(h, x, 64, w, 12 + ls.length * 10, 'white', 'teal'); ls.forEach((l, i) => say(h, x + 8, 70 + i * 10, l, { color: 'ink', shadow: false }));\n      this.menu.draw(h); promptBar(h, [['confirm', 'Answer']]);\n    } };\n    App.open(this.qo);\n  }\n  answered(q, i) {\n    if (App.slot) { App.slot.answers[this.day] = i; }\n    talk([{ who: 'ounce', mood: 'flat', text: q.r[i] }], () => this.afterQuestion());\n  }\n  afterQuestion() {\n    const slot = App.slot;\n    let age = 40;\n    if (this.args.attract) age = 31; else if (slot) { const prev = slot.chart[slot.chart.length - 1]; age = recordTest(slot, this.T01); this.prev = prev; slot.phase = 'free'; App.writeSave(); }\n    this.age = age; this.shownAge = slot && !this.args.attract ? shownAge(slot, age) : age + 7;\n    this.setPart('reveal'); this.revealed = false; this.spin = 0;\n  }\n  revealLine() {\n    const age = this.shownAge, slot = App.slot;\n    if (this.felt !== undefined) { const f = this.felt; this.felt = undefined; return `You said ${f}. Your Wobble Age is ${age}. Is that close? No? I'm so sorry.`; }\n    if (this.prev !== undefined && slot) { if (this.age === this.prev) return `${age}. ${BARKS.sameAge[0]}`; if (this.age < this.prev) return `${age}. ${BARKS.betterAge[this.day % 2]}`; return `${age}. ${BARKS.worseAge[this.day % 2]}`; }\n    return this.cosmetic.pick(BARKS.reveal).replace('{age}', age);\n  }\n  leave() { if (this.leaving) return; this.leaving = true; App.go('hub', { at: [0, 0.1, 6.5] }); }\n  draw(ctx, hud) {\n    const W = hud.width, H = hud.height;\n    if (App.top() && App.top().id !== 'pause') { /* dialogue over the scene */ }\n    if (this.part === 'test') {\n      const s = this.test, eyes = this.kind === 'stillness' && s.t > 3;\n      const r = Math.min(70, Math.floor(H * 0.26));\n      App.dialCenter.x = W / 2; App.dialCenter.y = 16 + r;\n      const t = this.kind === 'stillness' ? null : { ...s.tx(), r: this.kind === 'lean' ? 0.12 : 0.14 };\n      dial(hud, W / 2, 16 + r, r, { ringR: 0.3 * App.simEnv(ctx).ringMul, x: s.dot.x, y: s.dot.y, inside: s.dot.dist() <= 0.3, hideRing: eyes || this.kind !== 'stillness', hideDot: eyes, target: t });\n      const label = eyes ? 'Eyes closed.' : this.kind === 'stillness' ? 'Keep it in the circle.' : this.kind === 'lean' ? (s.targets[s.idx]?.label ?? 'Thank you.') : 'Follow the orange circle.';\n      center(hud, 22 + 2 * r, label, { color: 'white', scale: 1 });\n      if (!App.top() && !App.attract) promptBar(hud, [['lean', 'Lean'], ['pause', 'Pause']]);\n    } else if (this.part === 'reveal') {\n      panel(hud, W / 2 - 100, 18, 200, 62, 'white', 'teal');\n      center(hud, 24, 'Wobble Age', { color: 'teal', shadow: false, scale: 2 });\n      center(hud, 44, String(this.roll ?? '?'), { color: this.revealed ? 'red' : 'slate', shadow: false, scale: 4 });\n      if (this.revealed && !App.attract) {\n        const c = App.slot?.chart ?? [];\n        if (c.length > 1 && H > 260) chart(hud, W / 2 - 90, 84, 180, 70, c.map((v) => shownAge(App.slot, v)));\n        promptBar(hud, [['confirm', 'Thank you']]);\n      }\n    }\n  }\n  barkY(hud) { return this.part === 'test' ? hud.height - 72 : 150; }\n  status() { return `weighin | ${this.part} | ${this.kind} | T ${(this.test?.T01 ?? 0).toFixed(2)}`; }\n  fingerprint() { return `${this.part}|${(this.test?.t ?? 0).toFixed(3)}`; }\n  debugDot() { return this.test ? `${this.test.dot.x.toFixed(2)},${this.test.dot.y.toFixed(2)}` : '-'; }\n}\nclass OldPicker {\n  id = 'howold'; v = 38; t = 0;\n  constructor(done) {\n    this.done = done; App.say(STORY.howOld.text, 'ounce');\n    this.menu = new Menu({ items: [{ label: 'I feel', value: () => this.v, adjust: (d) => { this.v = Math.max(5, Math.min(120, this.v + d)); } }, { label: 'That\\'s it', on: () => { App.close(this); this.done(this.v); } }], scale: 2, y: 104 });\n  }\n  update(ctx, dt) { this.t += dt; this.menu.update(ctx, dt); }\n  draw(h) {\n    const w = Math.min(h.width - 24, 330), x = (h.width - w) / 2;\n    panel(h, x, 64, w, 24, 'white', 'teal'); say(h, x + 8, 72, STORY.howOld.text, { color: 'ink', shadow: false });\n    this.menu.draw(h); promptBar(h, [['adjust', 'Change'], ['confirm', 'Confirm']]);\n  }\n}\nvoid makeDriver; void THREE;\nE\nsed -i \"s/App._unlocks ?? {}/{}/; s/App._toon('sky')/toonMaterial(PALETTE.sky)/; s/App._toon('white')/toonMaterial(PALETTE.white)/\" src/scenes/hub.js\nsed -i \"s/import { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, applySky, skyAt } from/import { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, PlatformerCharacter, readMoveInput, setLookLayer, Squash, THREE, toonMaterial, applySky, skyAt } from/\" src/scenes/hub.js\necho \"- [x] island, hub, weighin\" >> PROGRESS.md","description":"Write island, hub, and Weigh-In scenes"}}}
