p().menu.items.find((i) => i.label === 'About & Credits').on(); }); await sleep(200); await over('about');\n  await page.evaluate(() => { window.__GAME__.close(); window.__GAME__.close(); window.__GAME__.engine.timeScale = 1; window.__GAME__.scene.forceFinish(2); }); await sleep(300); await over('results');\n  check(`${w}x${h} no errors`, errs.length === 0, errs.slice(0, 2).join('|'));\n  await ctx.close();\n}\nawait browser.close();\n// 20. No WebGPU browsers fail politely.\nfor (const [name, type, opts] of [['firefox', firefox, {}], ['webkit', webkit, { ...devices['iPhone 14'] }]]) {\n  let b; try { b = await type.launch(); } catch (e) { check(`${name} launches`, false, e.message); continue; }\n  const ctx = await b.newContext(opts); const page = await ctx.newPage(); const errs = []; page.on('pageerror', (e) => errs.push(String(e)));\n  await page.goto(url); await sleep(2500);\n  const text = await page.evaluate(() => document.body.innerText);\n  const hasGpu = await page.evaluate(() => !!navigator.gpu);\n  if (!hasGpu) { check(`${name} says WebGPU unavailable`, /WebGPU unavailable/i.test(text), text.slice(0, 200)); check(`${name} no page error`, errs.length === 0, errs.join('|')); }\n  await b.close();\n}\nconsole.log(`${n - fail}/${n} passed`); process.exit(fail ? 1 : 0);\nvoid copyFileSync;\nE\ncat > tests/browser/hub.mjs <<'E'\n// 21. The four harness runs, on an OS-chosen port. 22. Outside a session.\nimport { chromium } from 'playwright';\nimport { copyFileSync, mkdirSync, rmSync } from 'node:fs';\nimport { spawn } from 'node:child_process';\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nconst root = new URL('../../', import.meta.url).pathname, dir = `${root}.build/hubtest`;\nrmSync(dir, { recursive: true, force: true }); mkdirSync(dir, { recursive: true });\ncopyFileSync(`${root}.build/game.html`, `${dir}/game.html`); for (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(`${root}vendor/hub/${f}`, `${dir}/${f}`);\nconst server = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\nconst port = await new Promise((res, rej) => { let out = ''; const on = (d) => { out += d; const m = out.match(/port (\\d+)/); if (m) res(+m[1]); }; server.stdout.on('data', on); server.stderr.on('data', on); setTimeout(() => rej(new Error('no port')), 8000); });\nlet n = 0, fail = 0; const check = (name, c, d = '') => { n++; if (!c) { fail++; console.log(`FAIL ${name} ${String(d).slice(0, 700)}`); } };\nconst browser = await chromium.launch({ args: FLAGS });\ntry {\n  for (const q of (process.argv[2] ? [process.argv[2]] : ['auto=1&players=1', 'auto=1&players=2', 'auto=1&players=4&latency=150&jitter=50&loss=5', 'auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave'])) {\n    const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });\n    await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${q}`);\n    check(`served page is the harness ${q}`, /harness|hub/i.test(await page.title() + (await page.content()).slice(0, 2000)));\n    try { await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 150000 }); } catch { check(`complete ${q}`, false, 'timed out'); }\n    const r = await page.evaluate(() => window.__hubCheck);\n    check(`harness ${q}`, r?.pass === true, JSON.stringify((r?.checks ?? []).filter((c) => !c.pass && !c.ok).map((c) => [c.name, c.detail])));\n    await page.close();\n  }\n  const page = await browser.newPage(); const errs = []; page.on('pageerror', (e) => errs.push(String(e)));\n  await page.goto(`http://127.0.0.1:${port}/game.html`); await page.evaluate(() => window.__PIXEL_READY__); await new Promise((r) => setTimeout(r, 600));\n  check('title is the game', (await page.title()) === 'Wibble Fit'); check('AIHub.active false outside', await page.evaluate(() => window.AIHub?.active === false || !window.AIHub?.active)); check('normal boot', await page.evaluate(() => window.__GAME__.scene.id === 'title')); check('no errors outside', errs.length === 0, errs.join('|'));\n} finally { await browser.close(); server.kill(); rmSync(dir, { recursive: true, force: true }); }\nconsole.log(`${n - fail}/${n} passed`); process.exit(fail ? 1 : 0);\nE\ncat > tools/test.mjs <<'E'\n// One command. Prints only failures and one count line. --fast: Node tests only.\nimport { spawnSync } from 'node:child_process';\nconst fast = process.argv.includes('--fast'); const root = new URL('..', import.meta.url).pathname;\nconst run = [['tests/headless/core.mjs'], ['tests/headless/activities.mjs'], ['tests/headless/flow.mjs']];\nif (!fast) { spawnSync('node', ['tools/build.mjs'], { cwd: root, stdio: 'ignore' }); run.push(['tests/browser/browser.mjs'], ['tests/browser/hub.mjs']); }\nlet ok = 0, all = 0, failed = false;\nfor (const [f] of run) {\n  const r = spawnSync('node', [f], { cwd: root, encoding: 'utf8', maxBuffer: 1 << 28 });\n  const lines = (r.stdout + r.stderr).split('\\n').filter(Boolean), m = lines.map((l) => l.match(/^(\\d+)\\/(\\d+) passed$/)).filter(Boolean).pop();\n  for (const l of lines) if (l.startsWith('FAIL')) console.log(l.slice(0, 400));\n  if (m) { ok += +m[1]; all += +m[2]; if (m[1] !== m[2]) failed = true; } else { failed = true; console.log(`FAIL ${f} crashed: ${lines.slice(-3).join(' ').slice(0, 400)}`); }\n}\nconsole.log(`${ok}/${all} passed`); process.exit(failed ? 1 : 0);\nE\ncat >> src/app.js <<'E'\n// Test hook: voice rendered offline, so the check needs no ears.\nApp.voiceTest = async function voiceTest() {\n  const { renderVoice, syllabify, voiceDuration } = await import('./audio/voice.js');\n  const render = async (who) => {\n    const syl = syllabify('Thank you. I have written that down.', who), len = voiceDuration(syl) + 0.2, sr = 22050;\n    const c = new OfflineAudioContext(1, Math.ceil(len * sr), sr);\n    renderVoice(c, c.destination, syl, 0, who);\n    const b = await c.startRendering(), d = b.getChannelData(0);\n    let rms = 0; for (const v of d) rms += v * v; rms = Math.sqrt(rms / d.length);\n    return { rms, pitch: syl.reduce((a, s) => a + s.f0, 0) / syl.length };\n  };\n  const o = await render('ounce'), k = await render('coach');\n  return { rms: Math.min(o.rms, k.rms), ounce: o.pitch, coach: k.pitch };\n};\nE\nnode tools/build.mjs | cut -c1-120; timeout 400 node tests/browser/browser.mjs > .dl/br.txt 2>&1; echo exit $?; cut -c1-500 .dl/br.txt | tail -24","description":"Write browser tests and run them","timeout":420000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2172,"cache_read_input_tokens":434744,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2172},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"5d617e0d-029e-4f6c-9ca1-e79203195f58","timestamp":"2026-11-05T07:59:44.413Z","request_id":"req_011CgjRhQ6ijddQNKPh7dgQ3","wire_tool_inputs":{"toolu_0177csCuMT9ys5RsMzQSocEp":{"command":"cat >> PROGRESS.md <<'E'\n- [x] tests/headless: core, activities, flow (playthrough) pass. replay deterministic. Next: tests/browser + hub harness + tools/test.mjs, then visual pass of every screen, fill about.js feedback.\nE\ncat > tests/browser/browser.mjs <<'E'\n// Browser checks on the built html via file://. Prints only failures and a count.\nimport { chromium, firefox, webkit, devices } from 'playwright';\nimport { copyFileSync } from 'node:fs';\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nconst url = new 