get.\n    if (App.device.last === 'mouse' && !App.top() && !App.attract && this.leansWithMouse !== false && (this.phase === 'play' || this.phase === 'practice')) {\n      const p = ctx.input.pointer, ax = Math.round(((p.x + 1) / 2) * W), ay = Math.round(((1 - p.y) / 2) * H), c = App.dialCenter;\n      line(hud, c.x, c.y, ax, ay, 'red', 1);\n      hud.rect(ax - 4, ay, 9, 2, 'red'); hud.rect(ax, ay - 4, 2, 9, 'red');\n    }\n    if (this.phase === 'practice') {\"\"\")\ns=s.replace(\"import { note, panel, stars as drawStars } from '../../ui/widgets.js';\",\"import { line, note, panel } from '../../ui/widgets.js';\")\nopen(p,'w').write(s)\n\np='src/scenes/activity/poses.js';s=open(p).read()\ns=s.replace(\"\"\"    if (App.device.last === 'mouse' && App.top() == null && this.phase !== 'intro') {\n      const p = ctx.input.pointer, ax = ((p.x + 1) / 2) * hud.width, ay = ((1 - p.y) / 2) * hud.height;\n      hud.rect(ax - 3, ay, 7, 1, 'red'); hud.rect(ax, ay - 3, 1, 7, 'red');\n    }\n    void center;\n\"\"\",\"    void center;\\n\")\ns=s.replace(\"[['lean', 'Lean'], ['half', 'Half lean'], ['pause', 'Pause']]\",\"(App.device.last === 'keyboard' ? [['lean', 'Lean'], ['half', 'Half lean'], ['pause', 'Pause']] : [['lean', 'Lean'], ['pause', 'Pause']])\")\ns=s.replace(\"\"\"    this.moteT = 0;\n  }\"\"\",\"\"\"    this.moteT = 0;\n    this.kevinB = place(ctx, 'kevin', 5, 0.94, -3, { actors: true, turn: -20 });\n    // Sunbeams: pale slanted shafts through the pavilion.\n    for (const [x, w] of [[-4.2, 0.9], [-1.2, 0.6], [3.4, 1.1]]) { const b = new Mesh(new BoxGeometry(w, 7, 0.06), new MeshBasicMaterial({ color: PALETTE.sand, transparent: true, opacity: 0.16, depthWrite: false })); b.position.set(x, 2.6, -1.6); b.rotation.z = 0.32; ctx.scene.add(b); }\n  }\"\"\")\ns=s.replace(\"import { App } from '../../app.js';\\nimport { Dot }\",\"import { PALETTE, THREE } from '../../../pixel-engine.js';\\nimport { App } from '../../app.js';\\nimport { place } from '../../art/stage.js';\\nimport { Dot }\")\ns=s.replace(\"export class PoseSim {\",\"const { BoxGeometry, Mesh, MeshBasicMaterial } = THREE;\\nexport class PoseSim {\")\ns=s.replace(\"    this.moteT -= dt; if (this.moteT <= 0)\",\"    { const k = this.kevinB.object, f = Math.sin(ctx.time * 0.7) > 0.93 ? 0.7 : 0, wl = k.getObjectByName('wingL'), wr = k.getObjectByName('wingR'); if (wl) wl.rotation.z = f; if (wr) wr.rotation.z = -f; }\\n    this.moteT -= dt; if (this.moteT <= 0)\")\nopen(p,'w').write(s)\n\np='src/scenes/activity/slackline.js';s=open(p).read()\ns=s.replace(\"\"\"    this.ripples = new RippleField({ size: [30, 50], cells: [90, 150], at: [0, -15] });\n    this.water = sea(ctx, 160, 160, -0.25, 0, -30);\n    this.ripW = this.water;\"\"\",\"\"\"    this.ripples = new RippleField({ size: [30, 48], cells: [75, 120], center: [0, -15] });\n    this.water = sea(ctx, 160, 160, -0.32, 0, -30);\n    this.ripW = sea(ctx, 30, 48, -0.25, 0, -15, this.ripples);\"\"\")\ns=s.replace(\"if (!this.splashed && a.root.position.y < 0) { this.splashed = true; App.sfx('splash'); ctx.particles.burst('splash', [a.root.position.x, 0, a.root.position.z]); ctx.engine.shake.add(0.2); }\",\"if (!this.splashed && a.root.position.y < 0) { this.splashed = true; App.sfx('splash'); ctx.particles.burst('splash', [a.root.position.x, 0, a.root.position.z]); ctx.engine.shake.add(0.2); this.ripples.splash(a.root.position.x, a.root.position.z, 1, 0.5); }\")\ns=s.replace(\"    this.water?.update(ctx.time);\\n\",\"    this.water?.update(ctx.time); this.ripW?.update(ctx.time); this.ripples.step(dt);\\n\")\ns=s.replace(\"a.play(s.walking ? 'Walk' : 'Balance', { speed: 0.5 });\",\"a.play(Math.abs(s.dot.x) > 0.8 ? 'Flail' : s.walking ? 'Walk' : 'Balance', { speed: 0.5 });\")\nopen(p,'w').write(s)\n\np='src/scenes/activity/pier.js';s=open(p).read()\ns=s.replace(\"    this.water = sea(ctx, 220, 40, -0.25, 20, -4);\\n\",\"    this.water = sea(ctx, 220, 40, -0.32, 20, -4);\\n    this.ripples = new RippleField({ size: [48, 20], cells: [120, 50], center: [36, 0] });\\n    this.ripW = sea(ctx, 48, 20, -0.25, 36, 0, this.ripples);\\n\")\ns=s.replace(\"import { THREE } from '../../../pixel-engine.js';\",\"import { RippleField } from '../../../pixel-engine.js';\")\ns=s.replace(\"ctx.engine.shake.add(e.cannon ? 0.6 : 0.3);\",\"ctx.engine.shake.add(e.cannon ? 0.6 : 0.3); this.ripples.splash(this.px, 0, e.cannon ? 2 : 1, e.cannon ? 1 : 0.5);\")\ns=s.replace(\"    this.water.update(ctx.time);\\n    a.update(dt);\",\"    this.water.update(ctx.time); this.ripW.update(ctx.time); this.ripples.step(dt);\\n    a.update(dt);\")\nopen(p,'w').write(s)\nE\ngrep -n \"ripples.step\\|step(dt)\" src/art/stage.js | head -2\ncat >> tests/headless/activities.mjs <<'E'\nE\npython3 - <<'E'\np='tests/headless/flow.mjs';s=open(p).read()\ns=s.replace(\"// ---------- 7. Pause ----------\",\"\"\"// ---------- Mouse on the island: click walks; click a station walks there and enters ----------\n{ App.save.wipe(); const { newSlot } = await import('../../src/core/save.js'); const { AVATARS } = await import('../../src/data/classmates.js');\n  App.save.data.slots[0] = newSlot('Mouse', { ...AVATARS[0], equipped: [] }, 0); App.slotIndex = 0; App.slot.phase = 'free'; App.slot.dayIntroDone = 1;\n  await go('hub', { silent: true }); await steps(10);\n  const hub = App.scene, x0 = hub.model.position.x;\n  e.input.setPointer(0.35, -0.25, false); await steps(3);\n  check('mouse device on the island', App.device.last === 'mouse', App.device.last);\n  e.input.setPointer(0.35, -0.25, true); await steps(2); e.input.setPointer(0.35, -0.25, false); await steps(60);\n  check('click walks', Math.abs(hub.model.position.x - x0) > 0.5 || hub.nav, `${x0} ${hub.model.position.x}`);\n  // Hover a station.\n  const v = new App.THREE.Vector3(4, 0, -4).project(App.ctx.camera.camera);\n  e.input.setPointer(v.x, v.y, false); await steps(4); check('hover names a station', hub.hover === 'jar', hub.hover);\n  e.input.setPointer(v.x, v.y, true); await steps(2);