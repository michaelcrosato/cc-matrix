{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjPJqnviXYPJRYTmAVZU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K4cJsL66YMdvhuB2fXoXyZ","name":"Bash","input":{"command":"cat > src/core/drivers.js <<'E'\n// One seam for who is moving a lane: the local player, a pad by index, a bot, or a ghost.\nimport { applyDeadzone } from '../../pixel-engine.js';\nimport { ACTIONS } from './actions.js';\nimport { T } from './tunables.js';\n\nexport const SKILLS = {\n  sloppy: { tau: 0.42, kp: 0.7, kd: 0.12, err: 1.3, name: 'sloppy', hit: 0.45, jitter: 0.11, circle: 0.72, repErr: 0.34, repLead: 0, catch: 0.15, mistake: 0.3 },\n  average: { tau: 0.30, kp: 1.1, kd: 0.35, err: 0.8, name: 'average', hit: 0.8, jitter: 0.07, circle: 1.15, repErr: 0.2, repLead: 0.05, catch: 0.45, mistake: 0.15 },\n  good: { tau: 0.22, kp: 1.5, kd: 0.55, err: 0.45, name: 'good', hit: 0.95, jitter: 0.04, circle: 1.5, repErr: 0.09, repLead: 0.12, catch: 0.75, mistake: 0.05 },\n  expert: { tau: 0.17, kp: 1.9, kd: 0.7, err: 0.2, name: 'expert', hit: 1, jitter: 0.018, circle: 1.75, repErr: 0.035, repLead: 0.18, catch: 0.97, mistake: 0 },\n};\nexport const blankInput = () => ({ x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, digital: false, axisKeys: 0 });\nexport const clear = (o) => { o.x = 0; o.y = 0; o.breath = false; o.stepL = false; o.stepR = false; o.confirm = false; o.digital = false; return o; };\nexport const clampDisc = (o) => { const d = Math.hypot(o.x, o.y); if (d > 1) { o.x /= d; o.y /= d; } return o; };\n\n// The delayed PD controller: the same brain for classmates, attract and tests.\nexport class BotBrain {\n  hist = []; dx = 0; dy = 0;\n  constructor(skill, rng) { this.skill = skill; this.rng = rng; }\n  lean(state, tx, ty, dt, out) {\n    const s = this.skill;\n    this.hist.push({ x: state.x, y: state.y, vx: state.vx, vy: state.vy });\n    const lag = Math.max(1, Math.round(s.tau / dt));\n    while (this.hist.length > lag + 1) this.hist.shift();\n    const seen = this.hist[0];\n    this.dx += (this.rng.next() - 0.5) * s.err * dt * 6; this.dx *= 0.995;\n    this.dy += (this.rng.next() - 0.5) * s.err * dt * 6; this.dy *= 0.995;\n    out.x = -s.kp * (seen.x - tx) - s.kd * seen.vx + this.dx;\n    out.y = -s.kp * (seen.y - ty) - s.kd * seen.vy + this.dy;\n    return clampDisc(out);\n  }\n}\nexport class IdleDriver { kind = 'idle'; read(o) { return clear(o); } }\nexport class BotDriver {\n  kind = 'bot';\n  constructor(skillName, rng) { this.skillName = skillName; this.skill = SKILLS[skillName]; this.rng = rng; this.brain = new BotBrain(this.skill, rng); }\n  read(o, sim, dt) { clear(o); sim?.bot?.(this, o, dt); return o; }\n}\nexport function makeDriver(name, rng) { return name === 'idle' ? new IdleDriver() : new BotDriver(name, rng); }\n\n// Keyboard smoothing state plus the mouse: the same game on the same screens.\nexport class LocalDriver {\n  kind = 'local'; sx = 0; sy = 0;\n  constructor(env, { kbOnly = false, noPad = false } = {}) { this.env = env; this.kbOnly = kbOnly; this.noPad = noPad; }\n  read(o, sim, dt) {\n    const { input, device } = this.env; clear(o);\n    if (this.env.blocked?.()) return o;\n    const pad = this.noPad || this.kbOnly ? { x: 0, y: 0 } : input.padAxis;\n    const padOn = Math.hypot(pad.x, pad.y) > 0.02;\n    const kx = (input.anyDown(['KeyD', 'ArrowRight']) ? 1 : 0) - (input.anyDown(['KeyA', 'ArrowLeft']) ? 1 : 0);\n    const ky = (input.anyDown(['KeyW', 'ArrowUp']) ? 1 : 0) - (input.anyDown(['KeyS', 'ArrowDown']) ? 1 : 0);\n    const half = input.anyDown(['ShiftLeft', 'ShiftRight']) ? 0.5 : 1;\n    const norm = kx && ky ? Math.SQRT1_2 : 1;\n    const gx = kx * norm * half, gy = ky * norm * half;\n    const rate = (g, s) => Math.min(1, dt / (Math.abs(g) > Math.abs(s) ? 0.10 : 0.06));\n    this.sx += (gx - this.sx) * rate(gx, this.sx); this.sy += (gy - this.sy) * rate(gy, this.sy);\n    if (padOn) { o.x = pad.x; o.y = pad.y; }\n    else if (kx || ky || Math.abs(this.sx) > 0.02 || Math.abs(this.sy) > 0.02) { o.x = this.sx; o.y = this.sy; o.digital = !!(kx || ky); o.axisKeys = ky; o.keyX = kx; o.keyY = ky; o.isKeys = true; }\n    else if (!this.kbOnly && device.last === 'mouse') {\n      const m = this.env.mouseLean?.(); if (m) { o.x = m.x; o.y = m.y; }\n    }\n    if (!o.isKeys) { o.keyX = 0; o.keyY = 0; }\n    o.isKeys = !!(kx || ky);\n    const pads = this.kbOnly ? (c) => !c.startsWith('Pad') && !c.startsWith('Mouse') : () => true;\n    o.breath = input.anyDown(ACTIONS.breath.filter(pads));\n    o.stepL = input.consumeAny(ACTIONS.stepL.filter(pads));\n    o.stepR = input.consumeAny(ACTIONS.stepR.filter(pads));\n    o.confirm = input.consumeAny(ACTIONS.confirm.filter(pads).concat(this.kbOnly ? [] : ['MouseLeft']));\n    return clampDisc(o);\n  }\n}\n// One physical pad, for Family Hour. The engine merges pads, so lanes read them by index.\nexport class PadDriver {\n  kind = 'pad'; prev = [];\n  constructor(index) { this.index = index; }\n  read(o) {\n    clear(o);\n    const p = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads()[this.index] : null;\n    if (!p) return o;\n    const a = applyDeadzone(p.axes[0] ?? 0, -(p.axes[1] ?? 0), 0.12);\n    o.x = a.x; o.y = a.y;\n    const down = (i) => !!p.buttons[i]?.pressed;\n    const edge = (i) => down(i) && !this.prev[i];\n    o.breath = down(7) || down(0);\n    o.stepL = edge(4) || edge(6); o.stepR = edge(5) || edge(7);\n    o.confirm = edge(0);\n    this.prev = p.buttons.map((b) => !!b.pressed);\n    return clampDisc(o);\n  }\n}\n// Display only: never simulates. Receivers lerp toward what was last sent.\nexport class GhostDriver {\n  kind = 'ghost'; x = 0; y = 0; tx = 0; ty = 0; c = 0; t = 0; s = 0; a = -1; seen = false;\n  receive(d) { this.tx = d.x ?? 0; this.ty = d.y ?? 0; this.c = d.c ?? 0; this.t = d.t ?? 0; this.s = d.s ?? 0; this.a = d.a ?? -1; this.seen = true; }\n  lerp(dt) { const k = Math.min(1, dt * 12); this.x += (this.tx - this.x) * k; this.y += (this.ty - this.y) * k; }\n  read(o) { return clear(o); }\n}\nexport { T };\nE\ncat > src/core/progress.js <<'E'\n// The rules of progress as pure functions: stars, Drips, the Wobble Age, goals, unlocks.\nimport { ACT, ACTIVITIES } from '../data/activities.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { weekDay, WEEK } from '../data/week.js';\nimport { T } from './tunables.js';\n\nexport function starsFor(def, score, maxScore = 0) {\n  const th = def.stars.map((s) => s * T.starThresholdScale);\n  if (def.percentStars) { const pct = maxScore > 0 ? (100 * score) / maxScore : 0; return th.filter((t) => pct >= t).length; }\n  return th.filter((t) => score >= t).length;\n}\nexport const scoreForStars = (def, n) => (n <= 0 ? 0 : Math.ceil(def.stars[n - 1] * T.starThresholdScale));\nexport const dripsFor = (stars, playSeconds) => Math.floor((2 + 3 * stars + Math.floor(playSeconds / 30)) * T.dripRate);\n\nexport function trueAge(tests, totalStars) {\n  const last = tests.slice(-3);\n  const mean = last.length ? last.reduce((a, b) => a + b, 0) / last.length : 0;\n  const age = Math.round(20 + 60 * (1 - mean)) - Math.min(20, totalStars * T.ageTrainingWeight);\n  return Math.round(Math.min(95, Math.max(18, age)));\n}\nexport const shownAge = (slot, age) => (slot.confessed ? age : age + 7);\nexport const totalStars = (slot) => Object.values(slot.records).reduce((a, r) => a + (r.stars ?? 0), 0);\nexport const scheduleDay = (day) => ((day - 1) % WEEK.length) + 1;\nexport function isOpen(slot, id) {\n  if (!slot) return true;\n  if (slot.week > 1) return true;\n  const def = ACT[id]; const d = def ? def.day : WEEK.find((w) => w.opens.includes(id))?.day ?? 1;\n  return slot.day >= d;\n}\nexport const hardOpen = (slot) => !slot || slot.week > 1 || slot.day >= 6;\nexport const openedToday = (slot) => (slot.week > 1 ? [] : weekDay(slot.day).opens.filter((id) => ACT[id]));\n\nexport function goalMet(goal, slot) {\n  switch (goal.kind) {\n    case 'poseAndOther': { const pose = slot.today.some((id) => ACT[id]?.station === 'pavilion'); return pose && new Set(slot.today).size >= 2; }\n    case 'stars': return slot.todayStars.some((s) => s >= goal.n);\n    case 'first': return slot.todayFirst > 0;\n    case 'count': return slot.today.length >= goal.n;\n    case 'beat': return slot.todayBeat === goal.who || slot.todayBeat === true;\n    case 'did': return slot.today.includes(goal.id);\n    default: return false;\n  }\n}\n// Applies one finished activity to a guest slot and says what happened.\nexport function applyResult(slot, def, score, stars, playSeconds) {\n  const out = { drips: 0, first: false, goalNow: false, beat: [], milestones: [], newBest: false, stars, score };\n  const rec = slot.records[def.id] ?? { best: -Infinity, stars: 0, plays: 0 };\n  out.first = rec.plays === 0;\n  out.newBest = score > rec.best;\n  for (const who of ['dennis', 'june', 'marguerite']) if (score > def.rivals[who] && !(rec.best > def.rivals[who])) out.beat.push(who);\n  rec.best = Math.max(rec.best, score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n  slot.records[def.id] = rec;\n  slot.today.push(def.id); slot.todayStars.push(stars);\n  if (out.first) slot.todayFirst++;\n  if (score > def.rivals.dennis) slot.todayBeat = 'dennis';\n  slot.plays++; slot.seconds += playSeconds;\n  out.drips = dripsFor(stars, playSeconds);\n  if (!slot.goalDone && goalMet(weekDay(scheduleDay(slot.day)).goal, slot)) { slot.goalDone = true; out.goalNow = true; out.drips += Math.floor(5 * T.dripRate); }\n  slot.drips += out.drips;\n  out.milestones = checkMilestones(slot);\n  return out;\n}\nexport function checkMilestones(slot) {\n  const got = [];\n  while (slot.milestones < MILESTONES.length && slot.drips >= MILESTONES[slot.milestones].at) {\n    const m = MILESTONES[slot.milestones++]; slot.items.push(m.item); got.push(m);\n  }\n  return got;\n}\nexport function startNewDay(slot) {\n  slot.today = []; slot.todayStars = []; slot.todayFirst = 0; slot.todayBeat = false; slot.goalDone = false; slot.wobbleToday = null;\n}\nexport function recordTest(slot, t) {\n  slot.tests.push(Math.max(0, Math.min(1, t)));\n  const age = trueAge(slot.tests, totalStars(slot));\n  slot.wobbleToday = age; slot.chart.push(age);\n  return age;\n}\nexport function dropInRecord(records, def, score, stars) {\n  const rec = records[def.id] ?? { best: -Infinity, stars: 0, plays: 0 };\n  const newBest = score > rec.best;\n  rec.best = Math.max(rec.best, score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n  records[def.id] = rec; return newBest;\n}\nexport { ACTIVITIES };\nE\ncat > src/ui/font.js <<'E'\n// src/ui/font.js. Rows top to bottom, 5 bits, bit 4 = left. Rows 7-8 are descenders.\nconst H = {\na:'00 00 0e 01 0f 11 0f 00 00', b:'10 10 1e 11 11 11 1e 00 00', c:'00 00 0e 11 10 11 0e 00 00', d:'01 01 0f 11 11 11 0f 00 00',\ne:'00 00 0e 11 1f 10 0e 00 00', f:'06 09 08 1c 08 08 08 00 00', g:'00 00 0f 11 11 11 0f 01 0e', h:'10 10 1e 11 11 11 11 00 00',\ni:'04 00 0c 04 04 04 0e 00 00', j:'02 00 06 02 02 02 02 12 0c', k:'10 10 12 14 18 14 12 00 00', l:'0c 04 04 04 04 04 0e 00 00',\nm:'00 00 1a 15 15 15 15 00 00', n:'00 00 1e 11 11 11 11 00 00', o:'00 00 0e 11 11 11 0e 00 00', p:'00 00 1e 11 11 11 1e 10 10',\nq:'00 00 0f 11 11 11 0f 01 01', r:'00 00 16 19 10 10 10 00 00', s:'00 00 0f 10 0e 01 1e 00 00', t:'08 08 1c 08 08 09 06 00 00',\nu:'00 00 11 11 11 13 0d 00 00', v:'00 00 11 11 11 0a 04 00 00', w:'00 00 11 11 15 15 0a 00 00', x:'00 00 11 0a 04 0a 11 00 00',\ny:'00 00 11 11 11 11 0f 01 0e', z:'00 00 1f 02 04 08 1f 00 00' };\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\nexport const ENGINE_CHARS = \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`{|}~°·‘’“”\";\nexport const hasGlyph = (ch) => !!GLYPHS[ch] || ENGINE_CHARS.includes(ch);\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1 } = {}) {\n  x = Math.round(x); y = Math.round(y);\n  for (const ch of String(text)) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, hasGlyph(ch) ? ch : '?', { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\nexport const textWidth = (text, scale = 1) => Math.max(0, String(text).length * 6 - 1) * scale;\nexport const center = (hud, y, text, o = {}) => say(hud, (hud.width - textWidth(text, o.scale ?? 1)) / 2, y, text, o);\nexport function wrap(text, cols) {\n  const out = [];\n  for (const para of String(text).split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      if (line && (line + ' ' + word).length > cols) { out.push(line); line = word; }\n      else line = line ? line + ' ' + word : word;\n      while (line.length > cols) { out.push(line.slice(0, cols)); line = line.slice(cols); }\n    }\n    out.push(line);\n  }\n  return out;\n}\nexport const sanitize = (s) => [...String(s)].map((c) => (hasGlyph(c) ? c : '?')).join('');\nE\ncat > src/ui/widgets.js <<'E'\n// Pixel drawing helpers for the HUD. Everything records its rect, so a test can assert it fits.\nimport { say, textWidth } from './font.js';\n\nexport const rects = { list: [], on: true };\nexport const note = (x, y, w, h, tag = '') => { if (rects.on) rects.list.push({ x, y, w, h, tag }); };\nexport const clearRects = () => { rects.list.length = 0; };\n\nconst cache = new Map();\nexport function discRows(r, inner = -1) {\n  const key = `${r}|${inner}`; let rows = cache.get(key);\n  if (rows) return rows;\n  rows = []; const n = r * 2 + 1;\n  for (let j = 0; j < n; j++) {\n    let s = '';\n    for (let i = 0; i < n; i++) { const d = Math.hypot(i - r, j - r); s += d <= r + 0.3 && (inner < 0 || d >= inner - 0.3) ? 'o' : '.'; }\n    rows.push(s);\n  }\n  cache.set(key, rows); return rows;\n}\nexport const disc = (hud, cx, cy, r, color) => hud.sprite(Math.round(cx - r), Math.round(cy - r), discRows(Math.round(r)), { o: color }, { shadow: false });\nexport const ring = (hud, cx, cy, r, color, th = 2) => hud.sprite(Math.round(cx - r), Math.round(cy - r), discRows(Math.round(r), Math.round(r - th + 1)), { o: color }, { shadow: false });\nexport function line(hud, x0, y0, x1, y1, color, th = 2) {\n  const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0), 1);\n  for (let i = 0; i <= n; i++) hud.rect(Math.round(x0 + ((x1 - x0) * i) / n), Math.round(y0 + ((y1 - y0) * i) / n), th, th, color);\n}\nexport function panel(hud, x, y, w, h, fill = 'white', edge = 'mist') {\n  x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h);\n  hud.rect(x + 2, y, w - 4, h, edge); hud.rect(x, y + 2, w, h - 4, edge); hud.rect(x + 1, y + 1, w - 2, h - 2, edge);\n  hud.rect(x + 2, y + 2, w - 4, h - 4, fill);\n  note(x, y, w, h, 'panel');\n}\nexport function bar(hud, x, y, w, h, frac, fill = 'cyan', back = 'night') {\n  x = Math.round(x); y = Math.round(y); w = Math.round(w);\n  hud.rect(x, y, w, h, 'ink'); hud.rect(x + 1, y + 1, w - 2, h - 2, back);\n  const f = Math.round((w - 2) * Math.max(0, Math.min(1, frac)));\n  if (f > 0) hud.rect(x + 1, y + 1, f, h - 2, fill);\n  note(x, y, w, h, 'bar');\n}\nconst STAR = ['....o....', '....o....', '...ooo...', 'ooooooooo', '.ooooooo.', '..ooooo..', '..ooooo..', '.ooo.ooo.', '.o.....o.'];\nexport function star(hud, x, y, on, scale = 1) { hud.sprite(Math.round(x), Math.round(y), STAR, { o: on ? 'sand' : 'night' }, { scale, shadow: 'ink' }); }\nexport function stars(hud, x, y, n, scale = 1, max = 3) { for (let i = 0; i < max; i++) star(hud, x + i * 11 * scale, y, i < n, scale); return max * 11 * scale; }\nexport const starsWidth = (scale = 1, max = 3) => max * 11 * scale;\nexport function label(hud, x, y, text, o = {}) { const end = say(hud, x, y, text, o); note(x, y, textWidth(text, o.scale ?? 1), 7 * (o.scale ?? 1), 'text'); return end; }\nexport const dropCaps = (s) => s;\n// The ring-and-dot dial. r is its pixel radius. p maps -1.2..1.2 onto the dial.\nexport function dial(hud, cx, cy, r, { ringR = 0.3, x = 0, y = 0, inside = false, glow = 0, face = 'white', hideDot = false, hideRing = false, target = null, seat = null } = {}) {\n  disc(hud, cx, cy, r + 2, 'ink'); disc(hud, cx, cy, r, face);\n  ring(hud, cx, cy, r, seat ?? 'slate', 2);\n  for (let a = 0; a < 12; a++) { const c = Math.cos((a / 12) * 6.283), s = Math.sin((a / 12) * 6.283); hud.rect(Math.round(cx + c * (r - 5)), Math.round(cy + s * (r - 5)), 2, 2, 'mist'); }\n  const rp = Math.max(3, (ringR / 1.2) * r);\n  if (!hideRing) {\n    if (inside) disc(hud, cx, cy, rp, glow > 0.5 ? 'cyan' : 'lime');\n    ring(hud, cx, cy, rp, inside ? 'green' : 'sky', 3);\n  }\n  if (target) { const tx = cx + (target.x / 1.2) * r, ty = cy - (target.y / 1.2) * r; ring(hud, tx, ty, Math.max(3, target.r ? (target.r / 1.2) * r : 4), 'orange', 2); }\n  if (!hideDot) {\n    const dx = cx + (x / 1.2) * r, dy = cy - (y / 1.2) * r;\n    disc(hud, dx, dy, Math.max(2, Math.round(r / 11)) + 1, 'ink');\n    disc(hud, dx, dy, Math.max(2, Math.round(r / 11)), 'red');\n  }\n  note(cx - r - 2, cy - r - 2, 2 * r + 4, 2 * r + 4, 'dial');\n}\n// The chart: a line of up to seven points, with labels.\nexport function chart(hud, x, y, w, h, values, { min = 15, max = 100, color = 'red', slide = 0, days = 7 } = {}) {\n  panel(hud, x, y, w, h, 'white', 'mist');\n  const ix = x + 16, iy = y + 8, iw = w - 26, ih = h - 22;\n  for (const v of [30, 60, 90]) { const gy = iy + ih - ((v - min) / (max - min)) * ih; hud.rect(ix, Math.round(gy), iw, 1, 'mist'); say(hud, x + 3, gy - 3, String(v), { color: 'slate', shadow: false }); }\n  let px = null, py = null;\n  values.forEach((v, i) => {\n    const gx = ix + (iw * i) / Math.max(1, days - 1), gy = iy + ih - ((v - slide - min) / (max - min)) * ih;\n    if (px !== null) line(hud, px, py, gx, gy, color, 2);\n    px = gx; py = gy;\n  });\n  values.forEach((v, i) => {\n    const gx = ix + (iw * i) / Math.max(1, days - 1), gy = iy + ih - ((v - slide - min) / (max - min)) * ih;\n    disc(hud, gx, gy, 3, color); hud.rect(Math.round(gx) - 1, Math.round(gy) - 1, 2, 2, 'white');\n  });\n  for (let i = 0; i < days; i++) say(hud, ix + (iw * i) / Math.max(1, days - 1) - 2, y + h - 11, String(i + 1), { color: 'slate', shadow: false });\n}\nE\ncat > src/art/glyphs.js <<'E'\n// Button glyphs, drawn here. PlayStation shapes, Xbox letters, keycaps and a mouse.\nimport { say, textWidth } from '../ui/font.js';\nconst CIRCLE11 = ['...ooooo...', '..ooooooo..', '.ooooooooo.', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', '.ooooooooo.', '..ooooooo..', '...ooooo...'];\nconst CROSS = ['x.....x', '.x...x.', '..x.x..', '...x...', '..x.x..', '.x...x.', 'x.....x'];\nconst RING = ['..xxx..', '.x...x.', 'x.....x', 'x.....x', 'x.....x', '.x...x.', '..xxx..'];\nconst SQUARE = ['xxxxxxx', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'xxxxxxx'];\nconst TRI = ['...x...', '...x...', '..x.x..', '..x.x..', '.x...x.', '.x...x.', 'xxxxxxx'];\nconst shapes = { cross: [CROSS, 'sky'], circle: [RING, 'red'], square: [SQUARE, 'orange'], triangle: [TRI, 'lime'] };\nconst MOUSE = (l, r) => ['..ooooo..', '.o' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + 'o.', 'o.' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + '.o', 'o.' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + '.o', 'ooooooooo', 'o.......o', 'o.......o', 'o.......o', 'o.......o', '.o.....o.', '..ooooo..'];\nconst STICK = ['...ooooo...', '..o.....o..', '.o..ooo..o.', 'o..ooooo..o', 'o.ooooooo.o', 'o.ooooooo.o', 'o.ooooooo.o', 'o..ooooo..o', '.o..ooo..o.', '..o.....o..', '...ooooo...'];\nconst XB = { cross: ['A', 'green'], circle: ['B', 'red'], square: ['X', 'blue'], triangle: ['Y', 'sand'] };\nexport const XB_NAMES = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', Options: 'Menu', Create: 'View' };\n\nconst round = (hud, x, y, c) => hud.sprite(x, y, CIRCLE11, { o: c }, { shadow: 'ink' });\nfunction cap(hud, x, y, text, fill = 'white', ink = 'ink') {\n  const w = Math.max(11, textWidth(text) + 6);\n  hud.rect(x + 1, y + 1, w - 1, 11, 'ink');\n  hud.rect(x, y, w - 1, 10, fill); hud.rect(x, y + 10, w - 1, 1, 'mist');\n  say(hud, x + 3, y + 1, text, { color: ink, shadow: false });\n  return w;\n}\n// Draws a glyph; returns its width. kind: pad buttons by PlayStation name, 'key:Enter', 'mouse:L'.\nexport function drawGlyph(hud, x, y, kind, glyphSet = 'ps') {\n  x = Math.round(x); y = Math.round(y);\n  if (kind.startsWith('key:')) return cap(hud, x, y, kind.slice(4));\n  if (kind.startsWith('mouse:')) {\n    const b = kind.slice(6);\n    hud.sprite(x, y, MOUSE(b === 'L', b === 'R'), { o: 'white', L: 'red', R: 'red' }, { shadow: 'ink' });\n    if (b === 'wheel') hud.rect(x + 4, y + 2, 1, 3, 'red');\n    return 9;\n  }\n  if (kind === 'stick') { hud.sprite(x, y, STICK, { o: 'white' }, { shadow: 'ink' }); return 11; }\n  if (shapes[kind]) {\n    if (glyphSet === 'xb') { const [l, c] = XB[kind]; round(hud, x, y, c); say(hud, x + 3, y + 2, l, { color: 'white', shadow: false }); return 11; }\n    const [rows, c] = shapes[kind]; round(hud, x, y, 'ink');\n    hud.sprite(x + 2, y + 2, rows, { x: c }, { shadow: false }); return 11;\n  }\n  const name = glyphSet === 'xb' ? XB_NAMES[kind] ?? kind : kind;\n  return cap(hud, x, y, name, 'night', 'white');\n}\nconst A = (pad, key, mouse) => ({ pad, key, mouse: mouse ?? key });\nexport const PROMPTS = {\n  confirm: A(['cross'], ['key:Enter'], ['mouse:L']),\n  back: A(['circle'], ['key:Esc'], ['mouse:R']),\n  pause: A(['Options'], ['key:Esc']),\n  lean: A(['stick'], ['key:WASD'], ['mouse:move']),\n  breath: A(['R2'], ['key:Space'], ['mouse:L']),\n  stepL: A(['L1'], ['key:F'], ['mouse:L']),\n  stepR: A(['R1'], ['key:J'], ['mouse:R']),\n  feet: A(['L1', 'R1'], ['key:F', 'key:J'], ['mouse:L', 'mouse:R']),\n  tabs: A(['L1', 'R1'], ['key:Q', 'key:E'], ['mouse:wheel']),\n  jump: A(['cross'], ['key:Space'], ['key:Space']),\n  wave: A(['triangle'], ['key:V'], ['key:V']),\n  sit: A(['square'], ['key:B'], ['key:B']),\n  press: A(['cross'], ['key:Space'], ['mouse:L']),\n  more: A(['triangle'], ['key:M'], ['key:M']),\n  alt: A(['square'], ['key:R'], ['key:R']),\n  walk: A(['stick'], ['key:WASD'], ['mouse:L']),\n  adjust: A(['stick'], ['key:A', 'key:D'], ['mouse:L']),\n  half: A(['stick'], ['key:Shift'], ['mouse:move']),\n};\nexport const glyphsFor = (action, device) => { const p = PROMPTS[action]; return device === 'pad' ? p.pad : device === 'mouse' ? p.mouse : p.key; };\nE\nsed -i \"s/if (kind.startsWith('mouse:')) {/if (kind === 'mouse:move') { hud.sprite(x, y, MOUSE(false, false), { o: 'white' }, { shadow: 'ink' }); return 9; }\\n  if (kind.startsWith('mouse:')) {/\" src/art/glyphs.js\ncat > src/ui/prompts.js <<'E'\n// [glyph] verb prompts. They follow the last device used.\nimport { drawGlyph, glyphsFor } from '../art/glyphs.js';\nimport { App } from '../app.js';\nimport { say, textWidth } from './font.js';\nimport { note } from './widgets.js';\n\nexport function promptWidth(action, verb) {\n  const gs = glyphsFor(action, App.device.last);\n  let w = 0;\n  for (const g of gs) w += (g.startsWith('key:') ? Math.max(11, textWidth(g.slice(4)) + 6) : g.startsWith('mouse') ? 9 : g === 'stick' || ['cross', 'circle', 'square', 'triangle'].includes(g) ? 11 : Math.max(11, textWidth(App.glyphSet() === 'xb' && g === 'Options' ? 'Menu' : g) + 6)) + 2;\n  return w + 2 + textWidth(verb);\n}\nexport function prompt(hud, x, y, action, verb, o = {}) {\n  const gs = glyphsFor(action, App.device.last);\n  const set = App.glyphSet();\n  let cx = x; const start = x;\n  for (const g of gs) cx += drawGlyph(hud, cx, y, g, set) + 2;\n  App.lastPrompts[action] = `${App.device.last === 'pad' ? `pad-${set}` : App.device.last}:${gs.join('+')}`;\n  const end = say(hud, cx + 2, y + 2, verb, { color: o.color ?? 'white', shadow: o.shadow ?? 'ink' });\n  note(start, y, end - start, 11, 'prompt');\n  return end;\n}\nexport function promptBar(hud, list, y = null) {\n  const h = hud.height, by = y ?? h - 16;\n  const widths = list.map(([a, v]) => promptWidth(a, v));\n  const total = widths.reduce((a, b) => a + b + 10, -10);\n  hud.rect(0, by - 2, hud.width, 16, 'ink');\n  let x = Math.max(12, (hud.width - total) / 2);\n  list.forEach(([a, v], i) => { prompt(hud, x, by, a, v); x += widths[i] + 10; });\n  note(Math.max(12, (hud.width - total) / 2), by, total, 11, 'promptbar');\n}\nE\ncat > src/ui/menu.js <<'E'\n// The menu widget: one UI for pad, keyboard and mouse.\nimport { ACTIONS } from '../core/actions.js';\nimport { App } from '../app.js';\nimport { say, textWidth } from './font.js';\nimport { note, panel, bar } from './widgets.js';\n\nexport class Nav {\n  rx = 0; ry = 0; ax = 0; ay = 0; mouseWheelAcc = 0;\n  read(ctx, dt) {\n    const i = ctx.input, out = { up: false, down: false, left: false, right: false };\n    out.up = i.wasPressed(...ACTIONS.up); out.down = i.wasPressed(...ACTIONS.down);\n    out.left = i.wasPressed(...ACTIONS.left); out.right = i.wasPressed(...ACTIONS.right);\n    const s = i.padAxis ?? { x: 0, y: 0 };\n    const hold = (dirNow, key, fire) => {\n      if (dirNow) { this[key] += dt; if (this[key] > 0.4) { this[key] -= 0.12; fire(); } } else if (key === 'ry' ? !out.up && !out.down : !out.left && !out.right) this[key] = 0;\n    };\n    const vKeys = i.anyDown(ACTIONS.up) ? 1 : i.anyDown(ACTIONS.down) ? -1 : 0, hKeys = i.anyDown(ACTIONS.right) ? 1 : i.anyDown(ACTIONS.left) ? -1 : 0;\n    const sy = s.y > 0.5 ? 1 : s.y < -0.5 ? -1 : 0, sx = s.x > 0.5 ? 1 : s.x < -0.5 ? -1 : 0;\n    if (sy && !this.ay) { if (sy > 0) out.up = true; else out.down = true; }\n    if (sx && !this.ax) { if (sx > 0) out.right = true; else out.left = true; }\n    this.ay = sy; this.ax = sx;\n    const v = vKeys || sy, h = hKeys || sx;\n    hold(!!v, 'ry', () => { if (v > 0) out.up = true; else out.down = true; });\n    hold(!!h, 'rx', () => { if (h > 0) out.right = true; else out.left = true; });\n    return out;\n  }\n}\nexport const pointerArt = (ctx) => { const p = ctx.input.pointer, h = ctx.hud; return { x: ((p.x + 1) / 2) * h.width, y: ((1 - p.y) / 2) * h.height }; };\n\n// items: { label, on, value(), adjust(dir), disabled, slider: {get, min, max}, remark, right }\nexport class Menu {\n  index = 0; top = 0; nav = new Nav(); rows = []; grab = false;\n  constructor({ items = [], title = null, subtitle = null, onBack = null, w = null, maxRows = 8, y = null, scale = 2, x = null, rowH = null, fill = 'white' } = {}) {\n    Object.assign(this, { items, title, subtitle, onBack, w, maxRows, y, scale, x, rowH, fill });\n    this.index = Math.max(0, items.findIndex((it) => !it.disabled));\n  }\n  setItems(items) { this.items = items; if (this.index >= items.length) this.index = Math.max(0, items.length - 1); }\n  move(d) {\n    const n = this.items.length; if (!n) return;\n    let i = this.index;\n    for (let k = 0; k < n; k++) { i = (i + d + n) % n; if (!this.items[i].skip) break; }\n    if (i !== this.index) { this.index = i; App.sfx('menuMove'); }\n    this.scrollTo();\n  }\n  scrollTo() { if (this.index < this.top) this.top = this.index; if (this.index >= this.top + this.maxRows) this.top = this.index - this.maxRows + 1; }\n  update(ctx, dt) {\n    const input = ctx.input, n = this.nav.read(ctx, dt);\n    if (n.up) this.move(-1);\n    if (n.down) this.move(1);\n    const cur = this.items[this.index];\n    if (cur?.adjust) { if (n.left) { cur.adjust(-1); App.sfx('menuMove'); } if (n.right) { cur.adjust(1); App.sfx('menuMove'); } }\n    // Mouse: hover moves focus, wheel scrolls, click confirms, sliders drag.\n    const moved = App.device.moved > 0;\n    const m = pointerArt(ctx);\n    const hover = this.rows.find((r) => m.x >= r.x && m.x < r.x + r.w && m.y >= r.y && m.y < r.y + r.h);\n    if (App.device.last === 'mouse') {\n      if (hover && moved && hover.i !== this.index && !this.items[hover.i].skip) { this.index = hover.i; App.sfx('menuMove'); }\n      if (input.wheel) this.top = Math.max(0, Math.min(Math.max(0, this.items.length - this.maxRows), this.top + Math.sign(input.wheel)));\n    }\n    const c = this.items[this.index];\n    if (hover && input.wasPressed('MouseLeft')) {\n      const it = this.items[hover.i];\n      if (it.slider && hover.sx != null && m.x >= hover.sx) this.grab = hover.i;\n      else if (it.adjust && !it.on) it.adjust(m.x > hover.x + hover.w / 2 ? 1 : -1);\n      else this.activate(it);\n      return;\n    }\n    if (this.grab !== false) {\n      const it = this.items[this.grab], r = this.rows.find((q) => q.i === this.grab);\n      if (!input.isDown('MouseLeft') || !r) this.grab = false;\n      else if (it?.slider) { const f = Math.max(0, Math.min(1, (m.x - r.sx) / r.sw)); it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min)); }\n    }\n    if (input.wasPressed(...ACTIONS.menuConfirm) && c) this.activate(c);\n    else if (input.wasPressed(...ACTIONS.back) && this.onBack) { App.sfx('menuBack'); this.onBack(); }\n  }\n  activate(it) {\n    if (it.disabled) { App.sfx('wobble'); return; }\n    if (it.on) { App.sfx('menuConfirm'); it.on(); } else if (it.adjust) { it.adjust(1); App.sfx('menuMove'); }\n  }\n  draw(hud) {\n    const s = this.scale, rowH = this.rowH ?? (s === 2 ? 19 : 13), vis = Math.min(this.maxRows, this.items.length);\n    const longest = this.items.reduce((a, it) => Math.max(a, it.label.length + (it.value ? 1 + String(it.value()).length : 0) + (it.slider ? 12 : 0)), 8);\n    const needW = Math.max(longest * 6 * s + 24, this.title ? textWidth(this.title, s) + 24 : 0);\n    const w = Math.min(hud.width - 24, this.w ?? needW);\n    const titleH = (this.title ? 20 : 0) + (this.subtitle ? 12 : 0);\n    const h = vis * rowH + titleH + 12;\n    const x = Math.round(this.x ?? (hud.width - w) / 2), y = Math.round(this.y ?? Math.max(12, (hud.height - 16 - h) / 2));\n    panel(hud, x, y, w, h, this.fill, 'mist');\n    let ty = y + 6;\n    if (this.title) { say(hud, x + 10, ty, this.title, { color: 'teal', shadow: false, scale: s }); ty += 20; }\n    if (this.subtitle) { say(hud, x + 10, ty, this.subtitle, { color: 'slate', shadow: false }); ty += 12; }\n    this.rows = [];\n    for (let k = 0; k < vis; k++) {\n      const i = k + this.top, it = this.items[i]; if (!it) break;\n      const ry = ty + k * rowH, on = i === this.index, tcolor = it.disabled ? 'mist' : on ? 'white' : 'ink';\n      if (on) hud.rect(x + 4, ry - 1, w - 8, rowH - 2, it.disabled ? 'slate' : 'teal');\n      const row = { i, x: x + 4, y: ry - 1, w: w - 8, h: rowH - 1 };\n      let sc = s;\n      const val = it.value ? String(it.value()) : '';\n      if ((it.label.length + val.length + 1) * 6 * sc + 20 + (it.slider ? 60 : 0) > w) sc = 1;\n      const ly = ry + Math.floor((rowH - 2 - 7 * sc) / 2);\n      say(hud, x + 10, ly, it.label, { color: tcolor, shadow: false, scale: sc });\n      note(x + 10, ly, textWidth(it.label, sc), 7 * sc, 'menu-label');\n      if (it.slider) {\n        const sw = Math.min(90, Math.floor(w * 0.28)), sx = x + w - sw - 12 - (val ? textWidth(val) + 6 : 0);\n        bar(hud, sx, ry + 3, sw, 8, (it.slider.get() - it.slider.min) / (it.slider.max - it.slider.min), on ? 'cyan' : 'sky', 'night');\n        row.sx = sx; row.sw = sw;\n        if (val) say(hud, x + w - 10 - textWidth(val), ry + 3, val, { color: tcolor, shadow: false });\n      } else if (val) {\n        const vx = x + w - 10 - textWidth(val, sc);\n        say(hud, vx, ly, val, { color: on ? 'sand' : 'slate', shadow: false, scale: sc });\n      }\n      if (it.draw) it.draw(hud, x, ry, w, on, rowH);\n      this.rows.push(row);\n    }\n    if (this.top > 0) hud.rect(x + w - 8, y + 4, 4, 4, 'slate');\n    if (this.top + vis < this.items.length) hud.rect(x + w - 8, y + h - 8, 4, 4, 'slate');\n    note(x, y, w, h, 'menu');\n    return { x, y, w, h };\n  }\n}\nexport const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nE\necho \"- [x] drivers, progress, ui font/widgets/menu/prompts, glyphs\" >> PROGRESS.md","description":"Write drivers, progress rules, and UI kit"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15834,"cache_read_input_tokens":174323,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15834},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c1a9a6e-6f1f-4c91-a925-8ef76c3e492e","uuid":"df9f276e-df48-4a53-8a4f-ad5873a29856","timestamp":"2026-11-05T07:30:00.307Z","request_id":"req_011CgjPJqQMkKP3kBZvqByVN","wire_tool_inputs":{"toolu_01K4cJsL66YMdvhuB2fXoXyZ":{"command":"cat > src/core/drivers.js <<'E'\n// One seam for who is moving a lane: the local player, a pad by index, a bot, or a ghost.\nimport { applyDeadzone } from '../../pixel-engine.js';\nimport { ACTIONS } from './actions.js';\nimport { T } from './tunables.js';\n\nexport const SKILLS = {\n  sloppy: { tau: 0.42, kp: 0.7, kd: 0.12, err: 1.3, name: 'sloppy', hit: 0.45, jitter: 0.11, circle: 0.72, repErr: 0.34, repLead: 0, catch: 0.15, mistake: 0.3 },\n  average: { tau: 0.30, kp: 1.1, kd: 0.35, err: 0.8, name: 'average', hit: 0.8, jitter: 0.07, circle: 1.15, repErr: 0.2, repLead: 0.05, catch: 0.45, mistake: 0.15 },\n  good: { tau: 0.22, kp: 1.5, kd: 0.55, err: 0.45, name: 'good', hit: 0.95, jitter: 0.04, circle: 1.5, repErr: 0.09, repLead: 0.12, catch: 0.75, mistake: 0.05 },\n  expert: { tau: 0.17, kp: 1.9, kd: 0.7, err: 0.2, name: 'expert', hit: 1, jitter: 0.018, circle: 1.75, repErr: 0.035, repLead: 0.18, catch: 0.97, mistake: 0 },\n};\nexport const blankInput = () => ({ x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, digital: false, axisKeys: 0 });\nexport const clear = (o) => { o.x = 0; o.y = 0; o.breath = false; o.stepL = false; o.stepR = false; o.confirm = false; o.digital = false; return o; };\nexport const clampDisc = (o) => { const d = Math.hypot(o.x, o.y); if (d > 1) { o.x /= d; o.y /= d; } return o; };\n\n// The delayed PD controller: the same brain for classmates, attract and tests.\nexport class BotBrain {\n  hist = []; dx = 0; dy = 0;\n  constructor(skill, rng) { this.skill = skill; this.rng = rng; }\n  lean(state, tx, ty, dt, out) {\n    const s = this.skill;\n    this.hist.push({ x: state.x, y: state.y, vx: state.vx, vy: state.vy });\n    const lag = Math.max(1, Math.round(s.tau / dt));\n    while (this.hist.length > lag + 1) this.hist.shift();\n    const seen = this.hist[0];\n    this.dx += (this.rng.next() - 0.5) * s.err * dt * 6; this.dx *= 0.995;\n    this.dy += (this.rng.next() - 0.5) * s.err * dt * 6; this.dy *= 0.995;\n    out.x = -s.kp * (seen.x - tx) - s.kd * seen.vx + this.dx;\n    out.y = -s.kp * (seen.y - ty) - s.kd * seen.vy + this.dy;\n    return clampDisc(out);\n  }\n}\nexport class IdleDriver { kind = 'idle'; read(o) { return clear(o); } }\nexport class BotDriver {\n  kind = 'bot';\n  constructor(skillName, rng) { this.skillName = skillName; this.skill = SKILLS[skillName]; this.rng = rng; this.brain = new BotBrain(this.skill, rng); }\n  read(o, sim, dt) { clear(o); sim?.bot?.(this, o, dt); return o; }\n}\nexport function makeDriver(name, rng) { return name === 'idle' ? new IdleDriver() : new BotDriver(name, rng); }\n\n// Keyboard smoothing state plus the mouse: the same game on the same screens.\nexport class LocalDriver {\n  kind = 'local'; sx = 0; sy = 0;\n  constructor(env, { kbOnly = false, noPad = false } = {}) { this.env = env; this.kbOnly = kbOnly; this.noPad = noPad; }\n  read(o, sim, dt) {\n    const { input, device } = this.env; clear(o);\n    if (this.env.blocked?.()) return o;\n    const pad = this.noPad || this.kbOnly ? { x: 0, y: 0 } : input.padAxis;\n    const padOn = Math.hypot(pad.x, pad.y) > 0.02;\n    const kx = (input.anyDown(['KeyD', 'ArrowRight']) ? 1 : 0) - (input.anyDown(['KeyA', 'ArrowLeft']) ? 1 : 0);\n    const ky = (input.anyDown(['KeyW', 'ArrowUp']) ? 1 : 0) - (input.anyDown(['KeyS', 'ArrowDown']) ? 1 : 0);\n    const half = input.anyDown(['ShiftLeft', 'ShiftRight']) ? 0.5 : 1;\n    const norm = kx && ky ? Math.SQRT1_2 : 1;\n    const gx = kx * norm * half, gy = ky * norm * half;\n    const rate = (g, s) => Math.min(1, dt / (Math.abs(g) > Math.abs(s) ? 0.10 : 0.06));\n    this.sx += (gx - this.sx) * rate(gx, this.sx); this.sy += (gy - this.sy) * rate(gy, this.sy);\n    if (padOn) { o.x = pad.x; o.y = pad.y; }\n    else if (kx || ky || Math.abs(this.sx) > 0.02 || Math.abs(this.sy) > 0.02) { o.x = this.sx; o.y = this.sy; o.digital = !!(kx || ky); o.axisKeys = ky; o.keyX = kx; o.keyY = ky; o.isKeys = true; }\n    else if (!this.kbOnly && device.last === 'mouse') {\n      const m = this.env.mouseLean?.(); if (m) { o.x = m.x; o.y = m.y; }\n    }\n    if (!o.isKeys) { o.keyX = 0; o.keyY = 0; }\n    o.isKeys = !!(kx || ky);\n    const pads = this.kbOnly ? (c) => !c.startsWith('Pad') && !c.startsWith('Mouse') : () => true;\n    o.breath = input.anyDown(ACTIONS.breath.filter(pads));\n    o.stepL = input.consumeAny(ACTIONS.stepL.filter(pads));\n    o.stepR = input.consumeAny(ACTIONS.stepR.filter(pads));\n    o.confirm = input.consumeAny(ACTIONS.confirm.filter(pads).concat(this.kbOnly ? [] : ['MouseLeft']));\n    return clampDisc(o);\n  }\n}\n// One physical pad, for Family Hour. The engine merges pads, so lanes read them by index.\nexport class PadDriver {\n  kind = 'pad'; prev = [];\n  constructor(index) { this.index = index; }\n  read(o) {\n    clear(o);\n    const p = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads()[this.index] : null;\n    if (!p) return o;\n    const a = applyDeadzone(p.axes[0] ?? 0, -(p.axes[1] ?? 0), 0.12);\n    o.x = a.x; o.y = a.y;\n    const down = (i) => !!p.buttons[i]?.pressed;\n    const edge = (i) => down(i) && !this.prev[i];\n    o.breath = down(7) || down(0);\n    o.stepL = edge(4) || edge(6); o.stepR = edge(5) || edge(7);\n    o.confirm = edge(0);\n    this.prev = p.buttons.map((b) => !!b.pressed);\n    return clampDisc(o);\n  }\n}\n// Display only: never simulates. Receivers lerp toward what was last sent.\nexport class GhostDriver {\n  kind = 'ghost'; x = 0; y = 0; tx = 0; ty = 0; c = 0; t = 0; s = 0; a = -1; seen = false;\n  receive(d) { this.tx = d.x ?? 0; this.ty = d.y ?? 0; this.c = d.c ?? 0; this.t = d.t ?? 0; this.s = d.s ?? 0; this.a = d.a ?? -1; this.seen = true; }\n  lerp(dt) { const k = Math.min(1, dt * 12); this.x += (this.tx - this.x) * k; this.y += (this.ty - this.y) * k; }\n  read(o) { return clear(o); }\n}\nexport { T };\nE\ncat > src/core/progress.js <<'E'\n// The rules of progress as pure functions: stars, Drips, the Wobble Age, goals, unlocks.\nimport { ACT, ACTIVITIES } from '../data/activities.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { weekDay, WEEK } from '../data/week.js';\nimport { T } from './tunables.js';\n\nexport function starsFor(def, score, maxScore = 0) {\n  const th = def.stars.map((s) => s * T.starThresholdScale);\n  if (def.percentStars) { const pct = maxScore > 0 ? (100 * score) / maxScore : 0; return th.filter((t) => pct >= t).length; }\n  return th.filter((t) => score >= t).length;\n}\nexport const scoreForStars = (def, n) => (n <= 0 ? 0 : Math.ceil(def.stars[n - 1] * T.starThresholdScale));\nexport const dripsFor = (stars, playSeconds) => Math.floor((2 + 3 * stars + Math.floor(playSeconds / 30)) * T.dripRate);\n\nexport function trueAge(tests, totalStars) {\n  const last = tests.slice(-3);\n  const mean = last.length ? last.reduce((a, b) => a + b, 0) / last.length : 0;\n  const age = Math.round(20 + 60 * (1 - mean)) - Math.min(20, totalStars * T.ageTrainingWeight);\n  return Math.round(Math.min(95, Math.max(18, age)));\n}\nexport const shownAge = (slot, age) => (slot.confessed ? age : age + 7);\nexport const totalStars = (slot) => Object.values(slot.records).reduce((a, r) => a + (r.stars ?? 0), 0);\nexport const scheduleDay = (day) => ((day - 1) % WEEK.length) + 1;\nexport function isOpen(slot, id) {\n  if (!slot) return true;\n  if (slot.week > 1) return true;\n  const def = ACT[id]; const d = def ? def.day : WEEK.find((w) => w.opens.includes(id))?.day ?? 1;\n  return slot.day >= d;\n}\nexport const hardOpen = (slot) => !slot || slot.week > 1 || slot.day >= 6;\nexport const openedToday = (slot) => (slot.week > 1 ? [] : weekDay(slot.day).opens.filter((id) => ACT[id]));\n\nexport function goalMet(goal, slot) {\n  switch (goal.kind) {\n    case 'poseAndOther': { const pose = slot.today.some((id) => ACT[id]?.station === 'pavilion'); return pose && new Set(slot.today).size >= 2; }\n    case 'stars': return slot.todayStars.some((s) => s >= goal.n);\n    case 'first': return slot.todayFirst > 0;\n    case 'count': return slot.today.length >= goal.n;\n    case 'beat': return slot.todayBeat === goal.who || slot.todayBeat === true;\n    case 'did': return slot.today.includes(goal.id);\n    default: return false;\n  }\n}\n// Applies one finished activity to a guest slot and says what happened.\nexport function applyResult(slot, def, score, stars, playSeconds) {\n  const out = { drips: 0, first: false, goalNow: false, beat: [], milestones: [], newBest: false, stars, score };\n  const rec = slot.records[def.id] ?? { best: -Infinity, stars: 0, plays: 0 };\n  out.first = rec.plays === 0;\n  out.newBest = score > rec.best;\n  for (const who of ['dennis', 'june', 'marguerite']) if (score > def.rivals[who] && !(rec.best > def.rivals[who])) out.beat.push(who);\n  rec.best = Math.max(rec.best, score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n  slot.records[def.id] = rec;\n  slot.today.push(def.id); slot.todayStars.push(stars);\n  if (out.first) slot.todayFirst++;\n  if (score > def.rivals.dennis) slot.todayBeat = 'dennis';\n  slot.plays++; slot.seconds += playSeconds;\n  out.drips = dripsFor(stars, playSeconds);\n  if (!slot.goalDone && goalMet(weekDay(scheduleDay(slot.day)).goal, slot)) { slot.goalDone = true; out.goalNow = true; out.drips += Math.floor(5 * T.dripRate); }\n  slot.drips += out.drips;\n  out.milestones = checkMilestones(slot);\n  return out;\n}\nexport function checkMilestones(slot) {\n  const got = [];\n  while (slot.milestones < MILESTONES.length && slot.drips >= MILESTONES[slot.milestones].at) {\n    const m = MILESTONES[slot.milestones++]; slot.items.push(m.item); got.push(m);\n  }\n  return got;\n}\nexport function startNewDay(slot) {\n  slot.today = []; slot.todayStars = []; slot.todayFirst = 0; slot.todayBeat = false; slot.goalDone = false; slot.wobbleToday = null;\n}\nexport function recordTest(slot, t) {\n  slot.tests.push(Math.max(0, Math.min(1, t)));\n  const age = trueAge(slot.tests, totalStars(slot));\n  slot.wobbleToday = age; slot.chart.push(age);\n  return age;\n}\nexport function dropInRecord(records, def, score, stars) {\n  const rec = records[def.id] ?? { best: -Infinity, stars: 0, plays: 0 };\n  const newBest = score > rec.best;\n  rec.best = Math.max(rec.best, score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n  records[def.id] = rec; return newBest;\n}\nexport { ACTIVITIES };\nE\ncat > src/ui/font.js <<'E'\n// src/ui/font.js. Rows top to bottom, 5 bits, bit 4 = left. Rows 7-8 are descenders.\nconst H = {\na:'00 00 0e 01 0f 11 0f 00 00', b:'10 10 1e 11 11 11 1e 00 00', c:'00 00 0e 11 10 11 0e 00 00', d:'01 01 0f 11 11 11 0f 00 00',\ne:'00 00 0e 11 1f 10 0e 00 00', f:'06 09 08 1c 08 08 08 00 00', g:'00 00 0f 11 11 11 0f 01 0e', h:'10 10 1e 11 11 11 11 00 00',\ni:'04 00 0c 04 04 04 0e 00 00', j:'02 00 06 02 02 02 02 12 0c', k:'10 10 12 14 18 14 12 00 00', l:'0c 04 04 04 04 04 0e 00 00',\nm:'00 00 1a 15 15 15 15 00 00', n:'00 00 1e 11 11 11 11 00 00', o:'00 00 0e 11 11 11 0e 00 00', p:'00 00 1e 11 11 11 1e 10 10',\nq:'00 00 0f 11 11 11 0f 01 01', r:'00 00 16 19 10 10 10 00 00', s:'00 00 0f 10 0e 01 1e 00 00', t:'08 08 1c 08 08 09 06 00 00',\nu:'00 00 11 11 11 13 0d 00 00', v:'00 00 11 11 11 0a 04 00 00', w:'00 00 11 11 15 15 0a 00 00', x:'00 00 11 0a 04 0a 11 00 00',\ny:'00 00 11 11 11 11 0f 01 0e', z:'00 00 1f 02 04 08 1f 00 00' };\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\nexport const ENGINE_CHARS = \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`{|}~°·‘’“”\";\nexport const hasGlyph = (ch) => !!GLYPHS[ch] || ENGINE_CHARS.includes(ch);\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1 } = {}) {\n  x = Math.round(x); y = Math.round(y);\n  for (const ch of String(text)) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, hasGlyph(ch) ? ch : '?', { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\nexport const textWidth = (text, scale = 1) => Math.max(0, String(text).length * 6 - 1) * scale;\nexport const center = (hud, y, text, o = {}) => say(hud, (hud.width - textWidth(text, o.scale ?? 1)) / 2, y, text, o);\nexport function wrap(text, cols) {\n  const out = [];\n  for (const para of String(text).split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      if (line && (line + ' ' + word).length > cols) { out.push(line); line = word; }\n      else line = line ? line + ' ' + word : word;\n      while (line.length > cols) { out.push(line.slice(0, cols)); line = line.slice(cols); }\n    }\n    out.push(line);\n  }\n  return out;\n}\nexport const sanitize = (s) => [...String(s)].map((c) => (hasGlyph(c) ? c : '?')).join('');\nE\ncat > src/ui/widgets.js <<'E'\n// Pixel drawing helpers for the HUD. Everything records its rect, so a test can assert it fits.\nimport { say, textWidth } from './font.js';\n\nexport const rects = { list: [], on: true };\nexport const note = (x, y, w, h, tag = '') => { if (rects.on) rects.list.push({ x, y, w, h, tag }); };\nexport const clearRects = () => { rects.list.length = 0; };\n\nconst cache = new Map();\nexport function discRows(r, inner = -1) {\n  const key = `${r}|${inner}`; let rows = cache.get(key);\n  if (rows) return rows;\n  rows = []; const n = r * 2 + 1;\n  for (let j = 0; j < n; j++) {\n    let s = '';\n    for (let i = 0; i < n; i++) { const d = Math.hypot(i - r, j - r); s += d <= r + 0.3 && (inner < 0 || d >= inner - 0.3) ? 'o' : '.'; }\n    rows.push(s);\n  }\n  cache.set(key, rows); return rows;\n}\nexport const disc = (hud, cx, cy, r, color) => hud.sprite(Math.round(cx - r), Math.round(cy - r), discRows(Math.round(r)), { o: color }, { shadow: false });\nexport const ring = (hud, cx, cy, r, color, th = 2) => hud.sprite(Math.round(cx - r), Math.round(cy - r), discRows(Math.round(r), Math.round(r - th + 1)), { o: color }, { shadow: false });\nexport function line(hud, x0, y0, x1, y1, color, th = 2) {\n  const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0), 1);\n  for (let i = 0; i <= n; i++) hud.rect(Math.round(x0 + ((x1 - x0) * i) / n), Math.round(y0 + ((y1 - y0) * i) / n), th, th, color);\n}\nexport function panel(hud, x, y, w, h, fill = 'white', edge = 'mist') {\n  x = Math.round(x); y = Math.round(y); w = Math.round(w); h = Math.round(h);\n  hud.rect(x + 2, y, w - 4, h, edge); hud.rect(x, y + 2, w, h - 4, edge); hud.rect(x + 1, y + 1, w - 2, h - 2, edge);\n  hud.rect(x + 2, y + 2, w - 4, h - 4, fill);\n  note(x, y, w, h, 'panel');\n}\nexport function bar(hud, x, y, w, h, frac, fill = 'cyan', back = 'night') {\n  x = Math.round(x); y = Math.round(y); w = Math.round(w);\n  hud.rect(x, y, w, h, 'ink'); hud.rect(x + 1, y + 1, w - 2, h - 2, back);\n  const f = Math.round((w - 2) * Math.max(0, Math.min(1, frac)));\n  if (f > 0) hud.rect(x + 1, y + 1, f, h - 2, fill);\n  note(x, y, w, h, 'bar');\n}\nconst STAR = ['....o....', '....o....', '...ooo...', 'ooooooooo', '.ooooooo.', '..ooooo..', '..ooooo..', '.ooo.ooo.', '.o.....o.'];\nexport function star(hud, x, y, on, scale = 1) { hud.sprite(Math.round(x), Math.round(y), STAR, { o: on ? 'sand' : 'night' }, { scale, shadow: 'ink' }); }\nexport function stars(hud, x, y, n, scale = 1, max = 3) { for (let i = 0; i < max; i++) star(hud, x + i * 11 * scale, y, i < n, scale); return max * 11 * scale; }\nexport const starsWidth = (scale = 1, max = 3) => max * 11 * scale;\nexport function label(hud, x, y, text, o = {}) { const end = say(hud, x, y, text, o); note(x, y, textWidth(text, o.scale ?? 1), 7 * (o.scale ?? 1), 'text'); return end; }\nexport const dropCaps = (s) => s;\n// The ring-and-dot dial. r is its pixel radius. p maps -1.2..1.2 onto the dial.\nexport function dial(hud, cx, cy, r, { ringR = 0.3, x = 0, y = 0, inside = false, glow = 0, face = 'white', hideDot = false, hideRing = false, target = null, seat = null } = {}) {\n  disc(hud, cx, cy, r + 2, 'ink'); disc(hud, cx, cy, r, face);\n  ring(hud, cx, cy, r, seat ?? 'slate', 2);\n  for (let a = 0; a < 12; a++) { const c = Math.cos((a / 12) * 6.283), s = Math.sin((a / 12) * 6.283); hud.rect(Math.round(cx + c * (r - 5)), Math.round(cy + s * (r - 5)), 2, 2, 'mist'); }\n  const rp = Math.max(3, (ringR / 1.2) * r);\n  if (!hideRing) {\n    if (inside) disc(hud, cx, cy, rp, glow > 0.5 ? 'cyan' : 'lime');\n    ring(hud, cx, cy, rp, inside ? 'green' : 'sky', 3);\n  }\n  if (target) { const tx = cx + (target.x / 1.2) * r, ty = cy - (target.y / 1.2) * r; ring(hud, tx, ty, Math.max(3, target.r ? (target.r / 1.2) * r : 4), 'orange', 2); }\n  if (!hideDot) {\n    const dx = cx + (x / 1.2) * r, dy = cy - (y / 1.2) * r;\n    disc(hud, dx, dy, Math.max(2, Math.round(r / 11)) + 1, 'ink');\n    disc(hud, dx, dy, Math.max(2, Math.round(r / 11)), 'red');\n  }\n  note(cx - r - 2, cy - r - 2, 2 * r + 4, 2 * r + 4, 'dial');\n}\n// The chart: a line of up to seven points, with labels.\nexport function chart(hud, x, y, w, h, values, { min = 15, max = 100, color = 'red', slide = 0, days = 7 } = {}) {\n  panel(hud, x, y, w, h, 'white', 'mist');\n  const ix = x + 16, iy = y + 8, iw = w - 26, ih = h - 22;\n  for (const v of [30, 60, 90]) { const gy = iy + ih - ((v - min) / (max - min)) * ih; hud.rect(ix, Math.round(gy), iw, 1, 'mist'); say(hud, x + 3, gy - 3, String(v), { color: 'slate', shadow: false }); }\n  let px = null, py = null;\n  values.forEach((v, i) => {\n    const gx = ix + (iw * i) / Math.max(1, days - 1), gy = iy + ih - ((v - slide - min) / (max - min)) * ih;\n    if (px !== null) line(hud, px, py, gx, gy, color, 2);\n    px = gx; py = gy;\n  });\n  values.forEach((v, i) => {\n    const gx = ix + (iw * i) / Math.max(1, days - 1), gy = iy + ih - ((v - slide - min) / (max - min)) * ih;\n    disc(hud, gx, gy, 3, color); hud.rect(Math.round(gx) - 1, Math.round(gy) - 1, 2, 2, 'white');\n  });\n  for (let i = 0; i < days; i++) say(hud, ix + (iw * i) / Math.max(1, days - 1) - 2, y + h - 11, String(i + 1), { color: 'slate', shadow: false });\n}\nE\ncat > src/art/glyphs.js <<'E'\n// Button glyphs, drawn here. PlayStation shapes, Xbox letters, keycaps and a mouse.\nimport { say, textWidth } from '../ui/font.js';\nconst CIRCLE11 = ['...ooooo...', '..ooooooo..', '.ooooooooo.', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', 'ooooooooooo', '.ooooooooo.', '..ooooooo..', '...ooooo...'];\nconst CROSS = ['x.....x', '.x...x.', '..x.x..', '...x...', '..x.x..', '.x...x.', 'x.....x'];\nconst RING = ['..xxx..', '.x...x.', 'x.....x', 'x.....x', 'x.....x', '.x...x.', '..xxx..'];\nconst SQUARE = ['xxxxxxx', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'xxxxxxx'];\nconst TRI = ['...x...', '...x...', '..x.x..', '..x.x..', '.x...x.', '.x...x.', 'xxxxxxx'];\nconst shapes = { cross: [CROSS, 'sky'], circle: [RING, 'red'], square: [SQUARE, 'orange'], triangle: [TRI, 'lime'] };\nconst MOUSE = (l, r) => ['..ooooo..', '.o' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + 'o.', 'o.' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + '.o', 'o.' + (l ? 'LLL' : '...') + 'o' + (r ? 'RR' : '..') + '.o', 'ooooooooo', 'o.......o', 'o.......o', 'o.......o', 'o.......o', '.o.....o.', '..ooooo..'];\nconst STICK = ['...ooooo...', '..o.....o..', '.o..ooo..o.', 'o..ooooo..o', 'o.ooooooo.o', 'o.ooooooo.o', 'o.ooooooo.o', 'o..ooooo..o', '.o..ooo..o.', '..o.....o..', '...ooooo...'];\nconst XB = { cross: ['A', 'green'], circle: ['B', 'red'], square: ['X', 'blue'], triangle: ['Y', 'sand'] };\nexport const XB_NAMES = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', Options: 'Menu', Create: 'View' };\n\nconst round = (hud, x, y, c) => hud.sprite(x, y, CIRCLE11, { o: c }, { shadow: 'ink' });\nfunction cap(hud, x, y, text, fill = 'white', ink = 'ink') {\n  const w = Math.max(11, textWidth(text) + 6);\n  hud.rect(x + 1, y + 1, w - 1, 11, 'ink');\n  hud.rect(x, y, w - 1, 10, fill); hud.rect(x, y + 10, w - 1, 1, 'mist');\n  say(hud, x + 3, y + 1, text, { color: ink, shadow: false });\n  return w;\n}\n// Draws a glyph; returns its width. kind: pad buttons by PlayStation name, 'key:Enter', 'mouse:L'.\nexport function drawGlyph(hud, x, y, kind, glyphSet = 'ps') {\n  x = Math.round(x); y = Math.round(y);\n  if (kind.startsWith('key:')) return cap(hud, x, y, kind.slice(4));\n  if (kind.startsWith('mouse:')) {\n    const b = kind.slice(6);\n    hud.sprite(x, y, MOUSE(b === 'L', b === 'R'), { o: 'white', L: 'red', R: 'red' }, { shadow: 'ink' });\n    if (b === 'wheel') hud.rect(x + 4, y + 2, 1, 3, 'red');\n    return 9;\n  }\n  if (kind === 'stick') { hud.sprite(x, y, STICK, { o: 'white' }, { shadow: 'ink' }); return 11; }\n  if (shapes[kind]) {\n    if (glyphSet === 'xb') { const [l, c] = XB[kind]; round(hud, x, y, c); say(hud, x + 3, y + 2, l, { color: 'white', shadow: false }); return 11; }\n    const [rows, c] = shapes[kind]; round(hud, x, y, 'ink');\n    hud.sprite(x + 2, y + 2, rows, { x: c }, { shadow: false }); return 11;\n  }\n  const name = glyphSet === 'xb' ? XB_NAMES[kind] ?? kind : kind;\n  return cap(hud, x, y, name, 'night', 'white');\n}\nconst A = (pad, key, mouse) => ({ pad, key, mouse: mouse ?? key });\nexport const PROMPTS = {\n  confirm: A(['cross'], ['key:Enter'], ['mouse:L']),\n  back: A(['circle'], ['key:Esc'], ['mouse:R']),\n  pause: A(['Options'], ['key:Esc']),\n  lean: A(['stick'], ['key:WASD'], ['mouse:move']),\n  breath: A(['R2'], ['key:Space'], ['mouse:L']),\n  stepL: A(['L1'], ['key:F'], ['mouse:L']),\n  stepR: A(['R1'], ['key:J'], ['mouse:R']),\n  feet: A(['L1', 'R1'], ['key:F', 'key:J'], ['mouse:L', 'mouse:R']),\n  tabs: A(['L1', 'R1'], ['key:Q', 'key:E'], ['mouse:wheel']),\n  jump: A(['cross'], ['key:Space'], ['key:Space']),\n  wave: A(['triangle'], ['key:V'], ['key:V']),\n  sit: A(['square'], ['key:B'], ['key:B']),\n  press: A(['cross'], ['key:Space'], ['mouse:L']),\n  more: A(['triangle'], ['key:M'], ['key:M']),\n  alt: A(['square'], ['key:R'], ['key:R']),\n  walk: A(['stick'], ['key:WASD'], ['mouse:L']),\n  adjust: A(['stick'], ['key:A', 'key:D'], ['mouse:L']),\n  half: A(['stick'], ['key:Shift'], ['mouse:move']),\n};\nexport const glyphsFor = (action, device) => { const p = PROMPTS[action]; return device === 'pad' ? p.pad : device === 'mouse' ? p.mouse : p.key; };\nE\nsed -i \"s/if (kind.startsWith('mouse:')) {/if (kind === 'mouse:move') { hud.sprite(x, y, MOUSE(false, false), { o: 'white' }, { shadow: 'ink' }); return 9; }\\n  if (kind.startsWith('mouse:')) {/\" src/art/glyphs.js\ncat > src/ui/prompts.js <<'E'\n// [glyph] verb prompts. They follow the last device used.\nimport { drawGlyph, glyphsFor } from '../art/glyphs.js';\nimport { App } from '../app.js';\nimport { say, textWidth } from './font.js';\nimport { note } from './widgets.js';\n\nexport function promptWidth(action, verb) {\n  const gs = glyphsFor(action, App.device.last);\n  let w = 0;\n  for (const g of gs) w += (g.startsWith('key:') ? Math.max(11, textWidth(g.slice(4)) + 6) : g.startsWith('mouse') ? 9 : g === 'stick' || ['cross', 'circle', 'square', 'triangle'].includes(g) ? 11 : Math.max(11, textWidth(App.glyphSet() === 'xb' && g === 'Options' ? 'Menu' : g) + 6)) + 2;\n  return w + 2 + textWidth(verb);\n}\nexport function prompt(hud, x, y, action, verb, o = {}) {\n  const gs = glyphsFor(action, App.device.last);\n  const set = App.glyphSet();\n  let cx = x; const start = x;\n  for (const g of gs) cx += drawGlyph(hud, cx, y, g, set) + 2;\n  App.lastPrompts[action] = `${App.device.last === 'pad' ? `pad-${set}` : App.device.last}:${gs.join('+')}`;\n  const end = say(hud, cx + 2, y + 2, verb, { color: o.color ?? 'white', shadow: o.shadow ?? 'ink' });\n  note(start, y, end - start, 11, 'prompt');\n  return end;\n}\nexport function promptBar(hud, list, y = null) {\n  const h = hud.height, by = y ?? h - 16;\n  const widths = list.map(([a, v]) => promptWidth(a, v));\n  const total = widths.reduce((a, b) => a + b + 10, -10);\n  hud.rect(0, by - 2, hud.width, 16, 'ink');\n  let x = Math.max(12, (hud.width - total) / 2);\n  list.forEach(([a, v], i) => { prompt(hud, x, by, a, v); x += widths[i] + 10; });\n  note(Math.max(12, (hud.width - total) / 2), by, total, 11, 'promptbar');\n}\nE\ncat > src/ui/menu.js <<'E'\n// The menu widget: one UI for pad, keyboard and mouse.\nimport { ACTIONS } from '../core/actions.js';\nimport { App } from '../app.js';\nimport { say, textWidth } from './font.js';\nimport { note, panel, bar } from './widgets.js';\n\nexport class Nav {\n  rx = 0; ry = 0; ax = 0; ay = 0; mouseWheelAcc = 0;\n  read(ctx, dt) {\n    const i = ctx.input, out = { up: false, down: false, left: false, right: false };\n    out.up = i.wasPressed(...ACTIONS.up); out.down = i.wasPressed(...ACTIONS.down);\n    out.left = i.wasPressed(...ACTIONS.left); out.right = i.wasPressed(...ACTIONS.right);\n    const s = i.padAxis ?? { x: 0, y: 0 };\n    const hold = (dirNow, key, fire) => {\n      if (dirNow) { this[key] += dt; if (this[key] > 0.4) { this[key] -= 0.12; fire(); } } else if (key === 'ry' ? !out.up && !out.down : !out.left && !out.right) this[key] = 0;\n    };\n    const vKeys = i.anyDown(ACTIONS.up) ? 1 : i.anyDown(ACTIONS.down) ? -1 : 0, hKeys = i.anyDown(ACTIONS.right) ? 1 : i.anyDown(ACTIONS.left) ? -1 : 0;\n    const sy = s.y > 0.5 ? 1 : s.y < -0.5 ? -1 : 0, sx = s.x > 0.5 ? 1 : s.x < -0.5 ? -1 : 0;\n    if (sy && !this.ay) { if (sy > 0) out.up = true; else out.down = true; }\n    if (sx && !this.ax) { if (sx > 0) out.right = true; else out.left = true; }\n    this.ay = sy; this.ax = sx;\n    const v = vKeys || sy, h = hKeys || sx;\n    hold(!!v, 'ry', () => { if (v > 0) out.up = true; else out.down = true; });\n    hold(!!h, 'rx', () => { if (h > 0) out.right = true; else out.left = true; });\n    return out;\n  }\n}\nexport const pointerArt = (ctx) => { const p = ctx.input.pointer, h = ctx.hud; return { x: ((p.x + 1) / 2) * h.width, y: ((1 - p.y) / 2) * h.height }; };\n\n// items: { label, on, value(), adjust(dir), disabled, slider: {get, min, max}, remark, right }\nexport class Menu {\n  index = 0; top = 0; nav = new Nav(); rows = []; grab = false;\n  constructor({ items = [], title = null, subtitle = null, onBack = null, w = null, maxRows = 8, y = null, scale = 2, x = null, rowH = null, fill = 'white' } = {}) {\n    Object.assign(this, { items, title, subtitle, onBack, w, maxRows, y, scale, x, rowH, fill });\n    this.index = Math.max(0, items.findIndex((it) => !it.disabled));\n  }\n  setItems(items) { this.items = items; if (this.index >= items.length) this.index = Math.max(0, items.length - 1); }\n  move(d) {\n    const n = this.items.length; if (!n) return;\n    let i = this.index;\n    for (let k = 0; k < n; k++) { i = (i + d + n) % n; if (!this.items[i].skip) break; }\n    if (i !== this.index) { this.index = i; App.sfx('menuMove'); }\n    this.scrollTo();\n  }\n  scrollTo() { if (this.index < this.top) this.top = this.index; if (this.index >= this.top + this.maxRows) this.top = this.index - this.maxRows + 1; }\n  update(ctx, dt) {\n    const input = ctx.input, n = this.nav.read(ctx, dt);\n    if (n.up) this.move(-1);\n    if (n.down) this.move(1);\n    const cur = this.items[this.index];\n    if (cur?.adjust) { if (n.left) { cur.adjust(-1); App.sfx('menuMove'); } if (n.right) { cur.adjust(1); App.sfx('menuMove'); } }\n    // Mouse: hover moves focus, wheel scrolls, click confirms, sliders drag.\n    const moved = App.device.moved > 0;\n    const m = pointerArt(ctx);\n    const hover = this.rows.find((r) => m.x >= r.x && m.x < r.x + r.w && m.y >= r.y && m.y < r.y + r.h);\n    if (App.device.last === 'mouse') {\n      if (hover && moved && hover.i !== this.index && !this.items[hover.i].skip) { this.index = hover.i; App.sfx('menuMove'); }\n      if (input.wheel) this.top = Math.max(0, Math.min(Math.max(0, this.items.length - this.maxRows), this.top + Math.sign(input.wheel)));\n    }\n    const c = this.items[this.index];\n    if (hover && input.wasPressed('MouseLeft')) {\n      const it = this.items[hover.i];\n      if (it.slider && hover.sx != null && m.x >= hover.sx) this.grab = hover.i;\n      else if (it.adjust && !it.on) it.adjust(m.x > hover.x + hover.w / 2 ? 1 : -1);\n      else this.activate(it);\n      return;\n    }\n    if (this.grab !== false) {\n      const it = this.items[this.grab], r = this.rows.find((q) => q.i === this.grab);\n      if (!input.isDown('MouseLeft') || !r) this.grab = false;\n      else if (it?.slider) { const f = Math.max(0, Math.min(1, (m.x - r.sx) / r.sw)); it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min)); }\n    }\n    if (input.wasPressed(...ACTIONS.menuConfirm) && c) this.activate(c);\n    else if (input.wasPressed(...ACTIONS.back) && this.onBack) { App.sfx('menuBack'); this.onBack(); }\n  }\n  activate(it) {\n    if (it.disabled) { App.sfx('wobble'); return; }\n    if (it.on) { App.sfx('menuConfirm'); it.on(); } else if (it.adjust) { it.adjust(1); App.sfx('menuMove'); }\n  }\n  draw(hud) {\n    const s = this.scale, rowH = this.rowH ?? (s === 2 ? 19 : 13), vis = Math.min(this.maxRows, this.items.length);\n    const longest = this.items.reduce((a, it) => Math.max(a, it.label.length + (it.value ? 1 + String(it.value()).length : 0) + (it.slider ? 12 : 0)), 8);\n    const needW = Math.max(longest * 6 * s + 24, this.title ? textWidth(this.title, s) + 24 : 0);\n    const w = Math.min(hud.width - 24, this.w ?? needW);\n    const titleH = (this.title ? 20 : 0) + (this.subtitle ? 12 : 0);\n    const h = vis * rowH + titleH + 12;\n    const x = Math.round(this.x ?? (hud.width - w) / 2), y = Math.round(this.y ?? Math.max(12, (hud.height - 16 - h) / 2));\n    panel(hud, x, y, w, h, this.fill, 'mist');\n    let ty = y + 6;\n    if (this.title) { say(hud, x + 10, ty, this.title, { color: 'teal', shadow: false, scale: s }); ty += 20; }\n    if (this.subtitle) { say(hud, x + 10, ty, this.subtitle, { color: 'slate', shadow: false }); ty += 12; }\n    this.rows = [];\n    for (let k = 0; k < vis; k++) {\n      const i = k + this.top, it = this.items[i]; if (!it) break;\n      const ry = ty + k * rowH, on = i === this.index, tcolor = it.disabled ? 'mist' : on ? 'white' : 'ink';\n      if (on) hud.rect(x + 4, ry - 1, w - 8, rowH - 2, it.disabled ? 'slate' : 'teal');\n      const row = { i, x: x + 4, y: ry - 1, w: w - 8, h: rowH - 1 };\n      let sc = s;\n      const val = it.value ? String(it.value()) : '';\n      if ((it.label.length + val.length + 1) * 6 * sc + 20 + (it.slider ? 60 : 0) > w) sc = 1;\n      const ly = ry + Math.floor((rowH - 2 - 7 * sc) / 2);\n      say(hud, x + 10, ly, it.label, { color: tcolor, shadow: false, scale: sc });\n      note(x + 10, ly, textWidth(it.label, sc), 7 * sc, 'menu-label');\n      if (it.slider) {\n        const sw = Math.min(90, Math.floor(w * 0.28)), sx = x + w - sw - 12 - (val ? textWidth(val) + 6 : 0);\n        bar(hud, sx, ry + 3, sw, 8, (it.slider.get() - it.slider.min) / (it.slider.max - it.slider.min), on ? 'cyan' : 'sky', 'night');\n        row.sx = sx; row.sw = sw;\n        if (val) say(hud, x + w - 10 - textWidth(val), ry + 3, val, { color: tcolor, shadow: false });\n      } else if (val) {\n        const vx = x + w - 10 - textWidth(val, sc);\n        say(hud, vx, ly, val, { color: on ? 'sand' : 'slate', shadow: false, scale: sc });\n      }\n      if (it.draw) it.draw(hud, x, ry, w, on, rowH);\n      this.rows.push(row);\n    }\n    if (this.top > 0) hud.rect(x + w - 8, y + 4, 4, 4, 'slate');\n    if (this.top + vis < this.items.length) hud.rect(x + w - 8, y + h - 8, 4, 4, 'slate');\n    note(x, y, w, h, 'menu');\n    return { x, y, w, h };\n  }\n}\nexport const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\nE\necho \"- [x] drivers, progress, ui font/widgets/menu/prompts, glyphs\" >> PROGRESS.md","description":"Write drivers, progress rules, and UI kit"}}}
