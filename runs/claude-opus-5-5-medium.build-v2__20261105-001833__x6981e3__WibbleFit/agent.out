7, 0.14], at: [1.5, 0.35, -0.3], c: 'leg' }], axis: 'x' }] });\nexport const gate = model({ id: 'jog-gate', about: 'A gate arch over the jogging path, with a pennant', tags: ['prop'], palette: { post: 'white', arch: 'orange', band: 'mist' }, collider: 'none', parts: [{ mirror: [{ box: [0.4, 3.2, 0.4], at: [2, 1.6, 0], c: 'post' }], axis: 'x' }, { box: [4.8, 0.6, 0.5], at: [0, 3.4, 0], c: 'arch' }, { box: [2.4, 0.16, 0.54], at: [0, 3.4, 0], c: 'band' }] });\n\nexport const MODEL_DEFS = [ounce, kettlebellVolcano, foamRoller, dumbbellBridge, medBall, pavilion, repShed, beatStage, pier, palm, yogaMat, stepPlatform, coconut, flipflop, pineapple, catapult, trayModel, vitamin, anchor, hammock, lockers, hallBoard, paddle, scooter, ferry, waterCup, sprinkler, picnic, kevin, sweatJar, judgeTable, gate];\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ...MODEL_DEFS]);\nE\ncat > src/art/textures.js <<'E'\n// Surfaces. A plane with UVs in tiles, never a stretched map.\nimport { DEFAULT_TEXEL, PALETTE, TEXTURE_LIBRARY, textureDef, textureMap, THREE, toonMaterial } from '../../pixel-engine.js';\nconst { Mesh, PlaneGeometry } = THREE;\nexport const clinicTile = textureDef({ id: 'clinic-tile', about: 'Clean white clinic tile with pale grout', tags: ['floor', 'surface'], size: [16, 16], tile: true, palette: { grout: 'mist', a: 'white', b: 'white' }, layers: [{ pattern: 'tiles', colors: ['grout', 'a', 'b'], w: 16, h: 16, mortar: 1, seed: 3 }] });\nif (!TEXTURE_LIBRARY.has?.('clinic-tile') && !safeGet('clinic-tile')) TEXTURE_LIBRARY.add(clinicTile);\nfunction safeGet(id) { try { return TEXTURE_LIBRARY.get(id); } catch { return null; } }\nexport const TEXTURE_DEFS = [clinicTile];\nexport function tiledPlane(w, d, id, color = PALETTE.white) {\n  const tile = safeGet(id).size[0] / DEFAULT_TEXEL;\n  const g = new PlaneGeometry(w, d).rotateX(-Math.PI / 2);\n  const uv = g.attributes.uv.array;\n  for (let i = 0; i < uv.length; i += 2) { uv[i] = (uv[i] * w) / tile; uv[i + 1] = (uv[i + 1] * d) / tile; }\n  const m = new Mesh(g, toonMaterial(color, { map: textureMap(id) }));\n  m.receiveShadow = true; return m;\n}\nE\nmkdir -p .dl; node check.mjs --sheets src/art/models.js > .dl/sheets.txt 2>&1; echo exit $?; cut -c1-180 .dl/sheets.txt | grep -v -i '^ *$' | tail -60","description":"Write models and textures, run sheet check","timeout":240000}}}
