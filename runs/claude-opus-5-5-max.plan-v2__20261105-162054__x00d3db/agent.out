{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EAPx3XBYyZRc8VUxpAz5eM","type":"tool_result","content":"1\t=================== animation/types\n2\t/**\n3\t * Animation authoring format — designed to be written and edited by AI agents (and\n4\t * humans) as plain data. See docs/ANIMATION.md for the workflow.\n5\t *\n6\t * - Time is in FRAMES at 30 fps (Mario 64's rate). `frames: 24` = 0.8 s.\n7\t * - Rotations are Euler XYZ in DEGREES, relative to the joint's rest orientation.\n8\t *   Values interpolate per axis, so a full flip is simply `[360, 0, 0]`.\n9\t * - A key's pose is a FULL pose: any joint not listed is at rest (0,0,0). Build poses by\n10\t *   spreading shared poses: `{ ...CROUCH, Head: [10, 0, 0] }`.\n11\t * - Root motion lives in the Pelvis: `p` is an OFFSET from its rest position (metres),\n12\t *   `s` is scale (squash & stretch). Only Pelvis and Head may scale.\n13\t */\n14\texport type Euler = [number, number, number];\n15\texport type Vec3 = [number, number, number];\n16\texport interface JointPose {\n17\t    /** Rotation, degrees XYZ. */\n18\t    r?: Euler;\n19\t    /** Position offset from rest, metres (Pelvis only in practice). */\n20\t    p?: Vec3;\n21\t    /** Scale: uniform number or per-axis. 1 = rest. */\n22\t    s?: number | Vec3;\n23\t}\n24\t/** Joint name → rotation (degrees) or full joint pose. Missing joints are at rest. */\n25\texport type Pose = Readonly<Record<string, Euler | JointPose>>;\n26\texport type Ease = 'linear'\n27\t/** accelerate */\n28\t | 'in'\n29\t/** decelerate */\n30\t | 'out'\n31\t/** smooth start and stop (default) */\n32\t | 'inOut'\n33\t/** hold this pose until the next key, then snap */\n34\t | 'hold'\n35\t/** pull back before moving (anticipation) */\n36\t | 'inBack'\n37\t/** overshoot and settle (follow-through) */\n38\t | 'outBack';\n39\t/** `[frame, pose, easeToNextKey?]` */\n40\texport type Key = readonly [number, Pose, Ease?];\n41\t/** Additive sine wave on one channel — breathing, bobbing, idle sway. */\n42\texport interface Layer {\n43\t    joint: string;\n44\t    /** rx/ry/rz in degrees, px/py/pz in metres, s = uniform scale delta. */\n45\t    channel: 'rx' | 'ry' | 'rz' | 'px' | 'py' | 'pz' | 's';\n46\t    amplitude: number;\n47\t    /** Frames per cycle. For looping clips it must divide `frames`. */\n48\t    period: number;\n49\t    /** 0..1 fraction of a cycle. */\n50\t    phase?: number;\n51\t}\n52\t/** Where the feet should be (foot IK goals; see ik.ts). A missing side is left as keyed. */\n53\texport interface FeetGoals {\n54\t    R?: FootGoalDef;\n55\t    L?: FootGoalDef;\n56\t}\n57\t/** Same shape as ik.ts `FootGoal` (kept here so types.ts has no imports). */\n58\texport interface FootGoalDef {\n59\t    z: number;\n60\t    x?: number;\n61\t    y?: number;\n62\t    pitch?: number;\n63\t    pivot?: 'heel' | 'ball' | 'ankle';\n64\t    follow?: number;\n65\t    relax?: number;\n66\t}\n67\t/** `[frame, goals, easeToNextKey?]` */\n68\texport type FeetKey = readonly [number, FeetGoals, Ease?];\n69\texport interface ClipDef {\n70\t    name: string;\n71\t    /** Length in frames at 30 fps. */\n72\t    frames: number;\n73\t    loop?: boolean;\n74\t    keys: readonly Key[];\n75\t    layers?: readonly Layer[];\n76\t    /**\n77\t     * Feet track: foot goals interpolated between its own keys and solved with IK every\n78\t     * frame, overriding the keyed leg rotations. Use it whenever feet touch the floor\n79\t     * through a transition (kneel → stand, sit → lie) so they roll instead of sinking.\n80\t     */\n81\t    feet?: readonly FeetKey[];\n82\t    /**\n83\t     * Ground speed (m/s) the clip is authored for at playback rate 1. Locomotion clips set\n84\t     * this; metrics then measure foot sliding against it and the runtime can scale playback.\n85\t     */\n86\t    speed?: number;\n87\t    /**\n88\t     * Gait cycles (gaitClip): the share of the cycle each foot is planted. The right heel\n89\t     * strikes at phase 0, the left at 0.5, so the right foot is mid-stance at `stance / 2`.\n90\t     */\n91\t    stance?: number;\n92\t    /** Gaits: how far ahead of the hips (m) the middle of the stance is (feet touch down `reach` + half a stance's ground ahead). */\n93\t    reach?: number;\n94\t    /** Grounded clip: soles should rest on y = 0 (metrics flag floating / penetration). */\n95\t    grounded?: boolean;\n96\t    /** Intentionally snappy (flips, punches, launches): skip the angular-speed warning. */\n97\t    fast?: boolean;\n98\t    notes?: string;\n99\t}\n100\texport interface JointLimit {\n101\t    x?: [number, number];\n102\t    y?: [number, number];\n103\t    z?: [number, number];\n104\t}\n105\t/** One leg's joints, hip → knee → ankle, bending about X (knee forward). */\n106\texport interface LegJoints {\n107\t    upper: string;\n108\t    lower: string;\n109\t    foot: string;\n110\t    /** Hip joint position in the root (pelvis) joint's space. */\n111\t    hip: Vec3;\n112\t}\n113\t/** Leg geometry for foot-placement IK (`placeFeet`, `gaitClip`). Lengths in metres. */\n114\texport interface LegRig {\n115\t    R: LegJoints;\n116\t    L: LegJoints;\n117\t    /** Root (pelvis) joint height above the ground at rest. */\n118\t    rootHeight: number;\n119\t    /** Hip → knee. */\n120\t    upper: number;\n121\t    /** Knee → ankle. */\n122\t    lower: number;\n123\t    /** Ankle height above the sole when the foot is flat. */\n124\t    ankle: number;\n125\t    /** Heel contact point, metres behind the ankle. */\n126\t    heel: number;\n127\t    /** Toe tip contact point, metres ahead of the ankle. */\n128\t    ball: number;\n129\t    /** Top of the shoe above the ankle (m), for swing clearance when the foot tips over. */\n130\t    top?: number;\n131\t}\n132\t/** Everything the tools need to know about a rig beyond its hierarchy. */\n133\texport interface RigSpec {\n134\t    /** Joint names in hierarchy order (root first). */\n135\t    joints: readonly string[];\n136\t    root: string;\n137\t    /** Left/right counterparts for mirroring. */\n138\t    mirror: Readonly<Record<string, string>>;\n139\t    /** Mesh names that touch the ground (soles). */\n140\t    soles: readonly string[];\n141\t    /** Points to trace in contact sheets (joint or mesh names). */\n142\t    trace: readonly string[];\n143\t    /** Human-plausible rotation ranges, degrees. */\n144\t    limits: Readonly<Record<string, JointLimit>>;\n145\t    /** Frame rate of the authoring format. */\n146\t    fps: number;\n147\t    /** Leg geometry, enabling foot IK and the gait generator. */\n148\t    legs?: LegRig;\n149\t    /**\n150\t     * Joints the runtime procedural layers turn (PoseLayers): the torso and head look where\n151\t     * the character is going; `cap` is an optional springy joint (not animated by clips).\n152\t     */\n153\t    spine?: {\n154\t        torso?: string;\n155\t        head?: string;\n156\t        cap?: string;\n157\t    };\n158\t}\n159\t=================== animation/compile\n160\timport { AnimationClip, type Object3D, Quaternion } from 'three/webgpu';\n161\timport type { ClipDef, RigSpec } from './types';\n162\t/** Rest transforms of a model's joints (from the GLB), used as the base for poses. */\n163\texport interface RestPose {\n164\t    position: Record<string, [number, number, number]>;\n165\t    quaternion: Record<string, Quaternion>;\n166\t    scale: Record<string, [number, number, number]>;\n167\t}\n168\texport declare function restPoseOf(model: Object3D, rig: RigSpec): RestPose;\n169\t/**\n170\t * Bake a ClipDef into a three.js AnimationClip (quaternion + position + scale tracks,\n171\t * sampled at 60 Hz so easing and per-axis Euler interpolation — including 360° flips —\n172\t * survive exactly).\n173\t */\n174\texport declare function compileClip(def: ClipDef, rig: RigSpec, rest: RestPose): AnimationClip;\n175\texport declare function compileClips(defs: readonly ClipDef[], rig: RigSpec, model: Object3D): AnimationClip[];\n176\t=================== animation/sheet\n177\timport { type AnimationClip, type Object3D } from 'three/webgpu';\n178\timport { type SheetImage } from './raster';\n179\texport type { SheetImage } from './raster';\n180\timport type { ClipReport } from './metrics';\n181\timport type { ClipDef, RigSpec } from './types';\n182\t/**\n183\t * Contact sheets: render a clip to an RGBA image with a tiny software rasterizer — no\n184\t * GPU, no DOM, so it runs in Node (the `npm run anim` CLI) and in the browser alike.\n185\t *\n186\t *   rows     views (side / front / top / three-quarter), columns = frames\n187\t *   overlay  skeleton (right side orange, left cyan, centre yellow) and ground contacts\n188\t *            (green bar = sole on the floor, red = through it)\n189\t *   trails   one wide side-view panel with onion-skinned stick figures and the paths of\n190\t *            the hands, feet and head; locomotion clips are drawn travelling at their\n191\t *            authored speed, so a planted foot shows as a single point (sliding = smear)\n192\t *\n193\t * This is the main way an agent \"looks\" at an animation: render, read the PNG, adjust\n194\t * numbers, repeat.\n195\t */\n196\texport type ViewName = 'side' | 'front' | 'top' | 'three';\n197\texport interface SheetOptions {\n198\t    /** Authoring frames to show (default: the key frames, or 12 evenly spaced). */\n199\t    frames?: number[];\n200\t    views?: ViewName[];\n201\t    /** Pixels per metre (default 64). */\n202\t    scale?: number;\n203\t    skeleton?: boolean;\n204\t    trails?: boolean;\n205\t    /** Metrics to print under the sheet. */\n206\t    report?: ClipReport;\n207\t    /** A previous version of the clip: its skeleton and paths are drawn in magenta. */\n208\t    ghost?: AnimationClip;\n209\t    /**\n210\t     * Called after the model is posed at each frame, before it is drawn: for parts the game\n211\t     * moves at runtime from the pose (a bow's string drawn to the hand).\n212\t     */\n213\t    onPose?: (model: Object3D, frame: number) => void;\n214\t}\n215\texport declare function defaultFrames(def: ClipDef, max?: number): number[];\n216\t/** Render a contact sheet for one clip. */\n217\texport declare function renderSheet(model: Object3D, rig: RigSpec, def: ClipDef, clip: AnimationClip, options?: SheetOptions): SheetImage;\n218\t=================== animation/pose\n219\timport { type ResolvedJoint } from './joint';\n220\timport type { ClipDef, Ease, Pose, RigSpec } from './types';\n221\texport { applyEase } from './ease';\n222\texport { REST_JOINT, resolveJoint, type ResolvedJoint } from './joint';\n223\t/** Mirror a pose left ↔ right (rig.mirror pairs; Y/Z rotations and X offsets flip). */\n224\texport declare function mirror(pose: Pose, rig: Pick<RigSpec, 'mirror'>): Pose;\n225\t/** A whole clip mirrored left ↔ right (e.g. ShimmyLeft from ShimmyRight). */\n226\texport declare function mirrorClip(clip: ClipDef, name: string, rig: Pick<RigSpec, 'mirror'>): ClipDef;\n227\t/** Linear blend of two poses (0 = a, 1 = b). */\n228\texport declare function blend(a: Pose, b: Pose, t: number): Pose;\n229\t/** Add rotation offsets (degrees) on top of a pose — handy for variations. */\n230\texport declare function offset(pose: Pose, deltas: Pose): Pose;\n231\t/**\n232\t * Evaluate a clip's pose at `frame` (keys + layers + feet track), fully resolved for every\n233\t * joint of `rig` (or the listed joints — then the feet track needs a rig and is skipped).\n234\t */\n235\texport declare function sampleClip(clip: ClipDef, frame: number, rig: RigSpec | readonly string[]): Record<string, ResolvedJoint>;\n236\t/** The keys around frame `f` and the eased 0..1 position between them. */\n237\texport declare function bracket<T extends readonly [number, unknown, Ease?]>(keys: readonly T[], f: number): [T, T, number];\n238\t/** Problems with a clip definition itself (unknown joints, bad key order, loop mismatch). */\n239\texport declare function validateClip(clip: ClipDef, rig: RigSpec): string[];\n240\t=================== animation/poseLayers\n241\timport { type Object3D, Quaternion } from 'three/webgpu';\n242\timport type { RigSpec } from './types';\n243\t/**\n244\t * Procedural layers on top of the clips: small, physically motivated offsets that clips\n245\t * can't know about because they depend on how the character is moving right now. Apply\n246\t * them every render frame after the mixer (and RotationBlend), before foot placement, which\n247\t * then puts the feet back on the ground.\n248\t *\n249\t * - **lean**: the whole body tips about the feet. `roll` (degrees, + = to its right) leans\n250\t *   into turns; `pitch` (+ = forward) leans into acceleration and back when braking.\n251\t * - **look**: the head (and a little of the torso) turns toward where the character is\n252\t *   going, or toward something worth looking at. `yaw` in degrees, + = to its left.\n253\t * - **impact**: 0..1, a landing squash: hips drop, body squashes and tips forward.\n254\t * - **cap**: an optional springy joint (a hat): it lags behind the head's motion and settles.\n255\t *\n256\t * Every joint stays inside `rig.limits`.\n257\t */\n258\texport interface PoseLayerInput {\n259\t    lean: {\n260\t        roll: number;\n261\t        pitch: number;\n262\t    };\n263\t    look: number;\n264\t    impact: number;\n265\t}\n266\texport interface PoseLayerTuning {\n267\t    /** Share of a look that the torso takes (the head takes the rest). */\n268\t    torsoLook: number;\n269\t    /** Landing impact at 1: pelvis drop (m), squash, torso pitch (deg). */\n270\t    impactDrop: number;\n271\t    impactSquash: number;\n272\t    impactTorso: number;\n273\t    /** Springy cap: stiffness (1/s²), damping (1/s), degrees per m/s² of head acceleration, max angle (deg). */\n274\t    capStiffness: number;\n275\t    capDamping: number;\n276\t    capGain: number;\n277\t    capMax: number;\n278\t}\n279\texport declare const POSE_LAYER_DEFAULTS: PoseLayerTuning;\n280\texport declare class PoseLayers {\n281\t    readonly tuning: PoseLayerTuning;\n282\t    private readonly pelvis;\n283\t    private readonly torso;\n284\t    private readonly head;\n285\t    private readonly cap;\n286\t    private readonly rest;\n287\t    private readonly limits;\n288\t    private readonly capAngle;\n289\t    private readonly capVel;\n290\t    private readonly lastHead;\n291\t    private readonly lastHeadVel;\n292\t    private capStarted;\n293\t    constructor(model: Object3D, rig: RigSpec, tuning?: Partial<PoseLayerTuning>);\n294\t    /** Rest rotations (the clips' reference), if the model was posed when this was built. */\n295\t    setRest(rest: ReadonlyMap<string, Quaternion>): void;\n296\t    reset(): void;\n297\t    apply(dt: number, input: PoseLayerInput): void;\n298\t    /** Springy cap: driven by the head's acceleration, in the head's frame. */\n299\t    private spring;\n300\t    /** Add degrees to a joint's Euler XYZ (relative to rest), clamped to its limits. */\n301\t    private addEuler;\n302\t}\n303\t=================== animation/procedural\n304\t/**\n305\t * Procedural motion: things that move because something else moved, computed every frame\n306\t * instead of keyed.\n307\t *\n308\t *   SpringChain   secondary motion: a tail, antennae, a ponytail, a cape strip. Verlet points\n309\t *                 that keep most of their velocity, are pulled back toward their rest\n310\t *                 direction (`stiffness`), sag under gravity and stay their length apart.\n311\t *   Squash        squash and stretch: a spring on one number, drawn as a volume-preserving\n312\t *                 scale (taller is thinner). Kick it on landings, jumps and hits.\n313\t *   LegStepper    planted feet for creatures with any number of legs: a foot stays where it\n314\t *                 is in the world until it is too far from where it should be, then steps\n315\t *                 there in an arc, never lifting at the same time as its neighbours.\n316\t *\n317\t * All pure (no three.js), deterministic, unit-tested; the Animation wing's rooms draw them.\n318\t */\n319\ttype Vec3 = [number, number, number];\n320\texport interface SpringChainOptions {\n321\t    /** Points after the root (≥ 1). */\n322\t    segments: number;\n323\t    /** Length of each segment (m). */\n324\t    length: number;\n325\t    /** Rest direction from the root in the root's own space (normalised; default straight back, −Z). */\n326\t    rest?: Vec3;\n327\t    /** Pull toward the rest pose per second (0 floppy … 30 stiff). Default 10. */\n328\t    stiffness?: number;\n329\t    /** Velocity kept per 1/60 s (0..1). Default 0.94. */\n330\t    keep?: number;\n331\t    /** Gravity on the chain (m/s²). Default 6 (lighter than real: tails hold up a bit). */\n332\t    gravity?: number;\n333\t}\n334\t/**\n335\t * A chain of points hanging off a moving root. Call `update(dt, root, basis)` every frame\n336\t * with the root's world position and its orientation (three columns: right, up, forward),\n337\t * then read `points` (root first).\n338\t */\n339\texport declare class SpringChain {\n340\t    readonly points: Vec3[];\n341\t    private readonly prev;\n342\t    o: Required<SpringChainOptions>;\n343\t    private started;\n344\t    /** Time not yet stepped, and where the root was at the last step. */\n345\t    private pending;\n346\t    private readonly lastRoot;\n347\t    private readonly dir;\n348\t    constructor(o: SpringChainOptions);\n349\t    /** Put the chain straight out in its rest pose (no swing). */\n350\t    reset(root: Vec3, basis: readonly [Vec3, Vec3, Vec3]): void;\n351\t    update(dt: number, root: Vec3, basis: readonly [Vec3, Vec3, Vec3]): void;\n352\t    /** How far the tip is from where the rest pose puts it (m): how much it is swinging. */\n353\t    swing(basis: readonly [Vec3, Vec3, Vec3]): number;\n354\t    /** Each segment back to its length, from the root out (the root is fixed). */\n355\t    private keepLengths;\n356\t    /** The rest direction in the world (unit), into a reused array. */\n357\t    private restDir;\n358\t}\n359\t/**\n360\t * Squash and stretch as a damped spring on `value` (0 = rest, + stretched, − squashed).\n361\t * `scale()` turns it into a volume-preserving pair: `const [h, v] = squash.scale();\n362\t * mesh.scale.set(h, v, h)`.\n363\t */\n364\texport declare class Squash {\n365\t    value: number;\n366\t    velocity: number;\n367\t    /** Spring stiffness and damping (a critically damped spring has damping = 2√stiffness). */\n368\t    stiffness: number;\n369\t    damping: number;\n370\t    /** 0 turns it off; 2.5 is rubbery. */\n371\t    amount: number;\n372\t    /** Add a kick: negative squashes (a landing), positive stretches (a jump). */\n373\t    kick(v: number): void;\n374\t    /** Set the shape directly (a held squash). */\n375\t    set(v: number): void;\n376\t    update(dt: number): void;\n377\t    /** [horizontal, vertical] scale: y = 1 + s, xz = 1 / √(1 + s), so the volume stays put. */\n378\t    scale(out?: [number, number]): [number, number];\n379\t}\n380\texport interface LegDef {\n381\t    /** Where the foot rests, in the body's space (x right, z forward; y ignored). */\n382\t    rest: readonly [number, number];\n383\t    /** Legs that must not be lifting when this one starts a step (its neighbours; mutual, so listing a pair once is enough). */\n384\t    partners?: readonly number[];\n385\t}\n386\texport interface LegStepperOptions {\n387\t    legs: readonly LegDef[];\n388\t    /** Step when the foot is this far from its target (m). Default 0.3. */\n389\t    threshold?: number;\n390\t    /** Seconds a step takes. Default 0.18. */\n391\t    stepTime?: number;\n392\t    /** How high a step lifts the foot (m). Default 0.15. */\n393\t    lift?: number;\n394\t    /** Aim ahead of the body's motion by this many seconds (feet land where it is going). Default 0.25. */\n395\t    lead?: number;\n396\t}\n397\texport interface Foot {\n398\t    /** World position of the foot now. */\n399\t    readonly at: Vec3;\n400\t    /** Stepping: 0 → 1 through the step; -1 planted. */\n401\t    t: number;\n402\t    readonly from: Vec3;\n403\t    readonly to: Vec3;\n404\t}\n405\t/**\n406\t * Feet for a body with any number of legs. `update(dt, body, yaw, velocity, ground)`:\n407\t * the body's world position and heading, how fast it moves, and the ground height at a point.\n408\t */\n409\texport declare class LegStepper {\n410\t    readonly feet: Foot[];\n411\t    o: Required<Omit<LegStepperOptions, 'legs'>> & {\n412\t        legs: readonly LegDef[];\n413\t    };\n414\t    /** Steps started (tests). */\n415\t    steps: number;\n416\t    private started;\n417\t    /** Each leg's partners, both ways round (a leg waits for its partners, and they for it). */\n418\t    private readonly partners;\n419\t    /** Scratch for `update`: each foot's distance from its target, and the feet by that distance. */\n420\t    private readonly behind;\n421\t    private readonly order;\n422\t    private readonly t;\n423\t    private static readonly STILL;\n424\t    constructor(o: LegStepperOptions);\n425\t    /** Where leg `i` wants to be: its rest spot around the body, ahead by the lead, on the ground. */\n426\t    target(i: number, body: Vec3, yaw: number, velocity: Vec3, ground: (x: number, z: number) => number, out?: Vec3): Vec3;\n427\t    /** Every foot planted on its rest spot around `body` (a spawn or a teleport). The first `update` does this itself. */\n428\t    reset(body: Vec3, yaw: number, ground: (x: number, z: number) => number): void;\n429\t    update(dt: number, body: Vec3, yaw: number, velocity: Vec3, ground: (x: number, z: number) => number): void;\n430\t    /** Feet on the ground now. */\n431\t    planted(): number;\n432\t}\n433\t/** Partners for `n` legs in two rows (left 0, 2, 4…, right 1, 3, 5…): a leg waits for the legs beside and opposite it. */\n434\texport declare function gaitPartners(n: number): number[][];\n435\t/**\n436\t * Where the middle joint of a two-bone limb goes (a knee, an elbow) so the end reaches\n437\t * `target` from `root` with bones `a` and `b` long, bending toward `pole` (a point the knee\n438\t * points at). Analytic (the law of cosines), no iterations; a target out of reach straightens\n439\t * the limb toward it, one too close folds it as far as it goes. Returns the joint, into `out`.\n440\t */\n441\texport declare function twoBoneIK(root: Vec3, target: Vec3, a: number, b: number, pole: Vec3, out?: Vec3): Vec3;\n442\texport {};\n443\t=================== animation/gait\n444\timport { type FootGoal } from './ik';\n445\timport type { ClipDef, Euler, JointPose, LegRig, Pose, RigSpec } from './types';\n446\t/**\n447\t * Procedural locomotion cycles with planted feet. Instead of posing every frame, describe\n448\t * the gait (speed, cadence, stance, bounce, arm swing...) and the generator plants each\n449\t * foot on the ground, sliding it backwards at exactly `speed` while it is in stance, then\n450\t * swings it forward on an arc — heel strike, roll, toe-off included. Tweak numbers,\n451\t * re-run `npm run anim -- check Walk`, look at the sheet.\n452\t *\n453\t * Phase: the RIGHT heel strikes at frame 0, the left at frames / 2.\n454\t */\n455\texport interface GaitSpec {\n456\t    name: string;\n457\t    /** One full cycle (two steps), frames at 30 fps. */\n458\t    frames: number;\n459\t    /** Ground speed the cycle is authored for (m/s at playback rate 1). */\n460\t    speed: number;\n461\t    /** Fraction of the cycle each foot is on the ground. Walk ≈ 0.55–0.6, run ≈ 0.3. */\n462\t    stance: number;\n463\t    /** Mean pelvis height offset from rest (m); negative bends the knees. */\n464\t    hip: number;\n465\t    /** Pelvis bounce amplitude (m), twice per cycle. */\n466\t    bob?: number;\n467\t    /** Cycle fraction at which the pelvis is lowest (default: walk just after contact, run mid-stance). */\n468\t    low?: number;\n469\t    /** Squash at the lowest point (e.g. 0.05 = 5 % shorter, wider). */\n470\t    squash?: number;\n471\t    /** How high the lowest point of the swinging foot clears the floor at its peak (m). */\n472\t    lift?: number;\n473\t    /** Where in the swing (0..1) the foot is highest (default 0.4). */\n474\t    liftPeak?: number;\n475\t    /** Shift the whole stride forward (m). */\n476\t    reach?: number;\n477\t    /** Extra forward throw of the swinging foot late in the swing, before it settles (m). */\n478\t    swingReach?: number;\n479\t    /** Swing timing: 0 = even, + = the foot hangs back then whips forward (running). */\n480\t    swingDelay?: number;\n481\t    /**\n482\t     * 0..1: how much the swinging foot sweeps back to meet the ground at touchdown. At 1 it\n483\t     * arrives moving backwards at exactly the ground speed (still, in the world), so the\n484\t     * foot plants without sliding; at 0 it eases to a stop relative to the hips and slides\n485\t     * forward for the frames it is already on the floor.\n486\t     */\n487\t    plant?: number;\n488\t    /** Toes-up angle at heel strike (deg). */\n489\t    heelStrike?: number;\n490\t    /** Heel-raise angle at toe-off (deg). */\n491\t    toeOff?: number;\n492\t    /** Fraction of stance spent rolling off the heel / onto the toes. */\n493\t    roll?: [heel: number, toe: number];\n494\t    /** Walk on the balls of the feet: extra pitch through stance (deg), pivoting on the ball. */\n495\t    tiptoe?: number;\n496\t    /** Extra toes-down droop mid-swing (deg). */\n497\t    swingPitch?: number;\n498\t    /** How much the swinging foot hangs from the shin mid-swing (0..1, default 0.8). */\n499\t    dangle?: number;\n500\t    /** Torso lean forward (deg) and twist of the shoulders against the legs (deg). */\n501\t    lean?: number;\n502\t    twist?: number;\n503\t    /** Side-to-side torso roll (deg). */\n504\t    sway?: number;\n505\t    /** Pelvis pitch (deg): tips the whole body, legs are re-solved. */\n506\t    pelvisPitch?: number;\n507\t    /** Head pitch (deg) and how much it counters the torso twist (0..1). */\n508\t    head?: number;\n509\t    headSteady?: number;\n510\t    arms?: {\n511\t        /** Swing amplitude (deg). */\n512\t        swing: number;\n513\t        /** Base elbow bend (deg). */\n514\t        elbow: number;\n515\t        /** Extra elbow bend when the arm is forward (deg). */\n516\t        pump?: number;\n517\t        /** Arms out from the body (deg). */\n518\t        spread?: number;\n519\t        /** Arms forward of hanging (deg) — offsets the swing centre. */\n520\t        forward?: number;\n521\t        /** Follow-through delay behind the legs, as a fraction of the cycle. */\n522\t        lag?: number;\n523\t    };\n524\t    /** Extra joints/overrides mixed into every frame (hands, hat...). */\n525\t    pose?: Pose;\n526\t    /** Per-frame hook for anything else: receives the cycle phase 0..1. */\n527\t    extra?: (u: number, pose: Record<string, Euler | JointPose>) => void;\n528\t    /** Key spacing in frames (default 0.5 — IK is non-linear, keep it fine). */\n529\t    step?: number;\n530\t    notes?: string;\n531\t}\n532\texport declare function gaitClip(rig: RigSpec, g: GaitSpec): ClipDef;\n533\t/** The pose at cycle phase u (0..1). */\n534\texport declare function gaitPose(rig: RigSpec, g: GaitSpec, u: number): Pose;\n535\t/** Where a foot is at its own phase (0 = heel strike). */\n536\texport declare function footAt(g: GaitSpec, legs: LegRig, phase: number, S: number): FootGoal;\n537\t=================== physics/CharacterController\n538\timport { type AnimationClip, type Object3D, Vector3 } from 'three/webgpu';\n539\timport { type Physics, RAPIER } from './Physics';\n540\texport interface CharacterOptions {\n541\t    position: [number, number, number];\n542\t    radius?: number;\n543\t    /** Height of the cylindrical part of the capsule. */\n544\t    halfHeight?: number;\n545\t    speed?: number;\n546\t    jumpSpeed?: number;\n547\t    gravity?: number;\n548\t}\n549\texport type CharacterAnim = 'Idle' | 'Walk' | 'Jump';\n550\t/**\n551\t * Kinematic capsule driven by Rapier's KinematicCharacterController, with classic\n552\t * platformer affordances (coyote time, jump buffering, variable jump height).\n553\t *\n554\t * The body moves in continuous world space; the visual model is interpolated by\n555\t * Physics.bind and only *looks* pixel-aligned through the render pipeline.\n556\t */\n557\texport declare class CharacterController {\n558\t    private readonly physics;\n559\t    readonly body: RAPIER.RigidBody;\n560\t    readonly collider: RAPIER.Collider;\n561\t    readonly controller: RAPIER.KinematicCharacterController;\n562\t    readonly velocity: Vector3;\n563\t    grounded: boolean;\n564\t    facing: number;\n565\t    private readonly speed;\n566\t    private readonly jumpSpeed;\n567\t    private readonly gravity;\n568\t    private readonly footOffset;\n569\t    private readonly prevFeet;\n570\t    private coyote;\n571\t    private jumpBuffer;\n572\t    private wish;\n573\t    private jumpHeld;\n574\t    private mixer;\n575\t    private actions;\n576\t    private current;\n577\t    constructor(physics: Physics, options: CharacterOptions);\n578\t    /** Feet position (bottom of the capsule), continuous world space. */\n579\t    get feet(): Vector3;\n580\t    /** Feet position blended between the previous and current physics step (render use). */\n581\t    interpolatedFeet(alpha: number): Vector3;\n582\t    /** Set desired horizontal move direction (world space, length ≤ 1) and jump input. */\n583\t    setInput(move: Vector3, jumpPressed: boolean, jumpHeld: boolean): void;\n584\t    teleport(position: [number, number, number]): void;\n585\t    /** Call from Physics.update's fixedUpdate callback. */\n586\t    fixedUpdate(dt: number): void;\n587\t    /** Attach a model's animation clips (expects Idle / Walk / Jump). */\n588\t    attachAnimations(model: Object3D, clips: readonly AnimationClip[]): void;\n589\t    get animation(): CharacterAnim;\n590\t    /** Per render frame: pick animation state and advance the mixer. */\n591\t    updateVisual(model: Object3D, dt: number): void;\n592\t    private play;\n593\t}\n594\t=================== character/animator\n595\timport { type AnimationClip, type Object3D, type Quaternion } from 'three/webgpu';\n596\timport { FootPlacement, type FootPlacementInput, type FootPlacementTuning, type GroundProbe } from '../animation/footPlacement';\n597\timport { PoseLayers, type PoseLayerInput, type PoseLayerTuning } from '../animation/poseLayers';\n598\timport type { RigSpec } from '../animation/types';\n599\t/**\n600\t * Clip playback for PlatformerCharacter: blends, the locomotion blend space and the\n601\t * procedural layers, in the order they run every render frame:\n602\t *\n603\t *   fades → gait phase → mixer → RotationBlend → (feet captured) → PoseLayers (lean, look,\n604\t *   landing) → FootPlacement (feet back where the clips put them, on the real ground)\n605\t *\n606\t * **Blends.** Weights are driven here, not by three's crossFadeFrom (which restarts the\n607\t * outgoing clip's fade from full weight, so a clip only partly faded in snapped to 100%\n608\t * whenever states changed faster than the fade). Every outgoing clip fades from the weight\n609\t * it has now.\n610\t *\n611\t * **Locomotion blend space.** Tiptoe, Walk and Run play together as one logical clip (the\n612\t * \"gait\"): weights come from the ground speed (Walk at its authored speed → Run at its\n613\t * authored speed), with Tiptoe taking the low end on a gentle stick tilt. All three share\n614\t * one normalised phase (they all strike the right heel at 0), which advances at\n615\t * speed / (blended stride length), so the blended planted foot moves exactly with the\n616\t * ground and every clip plays at a rate matched to its own authored speed.\n617\t */\n618\texport interface AnimRequest {\n619\t    name: string;\n620\t    once?: boolean;\n621\t    /** Playback rate (negative plays backwards). */\n622\t    speed?: number;\n623\t    /** Fade-in seconds (default 0.12). */\n624\t    fade?: number;\n625\t    /** Play the locomotion blend space instead of `name` (`name` is the fallback clip). */\n626\t    gait?: GaitRequest;\n627\t}\n628\texport interface GaitRequest {\n629\t    /** Ground speed (m/s). */\n630\t    speed: number;\n631\t    /** 0..1: the share of the low end that tiptoes (gentle stick tilt) instead of walking. */\n632\t    tiptoe: number;\n633\t}\n634\t/** The clips of the locomotion blend space, by role, and where walking turns into running. */\n635\texport interface GaitClips {\n636\t    tiptoe: string;\n637\t    walk: string;\n638\t    run: string;\n639\t    /**\n640\t     * Ground speeds (m/s) between which Walk cross-fades into Run (default: their authored\n641\t     * speeds). Gaits with different stance shares don't blend cleanly (one foot is still\n642\t     * planted while the other gait already swings it), so keep the band short.\n643\t     */\n644\t    blend?: readonly [number, number];\n645\t}\n646\texport interface AnimatorOptions {\n647\t    rig?: RigSpec;\n648\t    probe?: GroundProbe;\n649\t    feet?: Partial<FootPlacementTuning>;\n650\t    layers?: Partial<PoseLayerTuning>;\n651\t    gait?: GaitClips;\n652\t}\n653\t/** Everything the procedural passes need this frame. */\n654\texport interface ProceduralInput extends PoseLayerInput {\n655\t    feet: FootPlacementInput;\n656\t}\n657\texport declare class Animator {\n658\t    readonly model: Object3D;\n659\t    private readonly mixer;\n660\t    private readonly rotationBlend;\n661\t    private readonly layers;\n662\t    private readonly byName;\n663\t    private current;\n664\t    /** Gait: actions in role order (tiptoe, walk, run), stride per cycle (m), stance shares, phase 0..1. */\n665\t    private readonly gait;\n666\t    readonly feet: FootPlacement | null;\n667\t    readonly pose: PoseLayers | null;\n668\t    private readonly footNames;\n669\t    /**\n670\t     * The animated pose of every joint the procedural passes change, saved after the mixer and\n671\t     * put back before the next mixer update. three's mixer only writes a joint whose blended\n672\t     * value changed, so a held pose would otherwise keep (and stack) last frame's offsets.\n673\t     */\n674\t    private readonly touched;\n675\t    constructor(model: Object3D, clips: readonly AnimationClip[], rest: ReadonlyMap<string, Quaternion>, options?: AnimatorOptions);\n676\t    dispose(): void;\n677\t    duration(name: string): number | undefined;\n678\t    authoredSpeed(name: string): number | undefined;\n679\t    /** The clip a request shows most (the gait's dominant clip). */\n680\t    dominant(req: AnimRequest): string;\n681\t    /** Tooling: every clip contributing to the pose, with its share of the blend, time (s) and rate. */\n682\t    mix(): {\n683\t        name: string;\n684\t        weight: number;\n685\t        time: number;\n686\t        rate: number;\n687\t    }[];\n688\t    /** Start over with `name` playing alone, no blends, no procedural memory (a teleport, a respawn). */\n689\t    restart(name: string): void;\n690\t    /** Switch to (or keep playing) what `req` asks for, fading over `fade` seconds. */\n691\t    play(req: AnimRequest, fade: number): void;\n692\t    /** Advance fades, the gait and the mixer, then the procedural passes. */\n693\t    update(dt: number, procedural?: ProceduralInput): void;\n694\t    /** Gait shares and phase: weights from the speed, rates matched to each clip's own speed. */\n695\t    private stepGait;\n696\t    /**\n697\t     * Which foot the gait swings and where it will land (foot placement blends a swinging\n698\t     * foot from the ground it left to the ground it lands on); null when no gait leads.\n699\t     */\n700\t    private swingOf;\n701\t    private readonly swing;\n702\t    private readonly swingR;\n703\t    private readonly swingL;\n704\t    private gaitShares;\n705\t    /** Normalised phase of a layer, if it is a stride (a gait clip with an authored speed). */\n706\t    private phaseOf;\n707\t    private isStride;\n708\t    /**\n709\t     * Starting the gait from another clip (standing, landing): the foot that is further forward\n710\t     * now is the planted one, at the point of its stance where the gait has it that far\n711\t     * forward (mid-stance from standing, heel strike landing with a leg out front), and the\n712\t     * other one takes the next step.\n713\t     */\n714\t    private startPhase;\n715\t    private stop;\n716\t}\n717\t=================== character/controls\n718\timport type { GameContext } from '../Engine';\n719\timport type { MoveInput, PlatformerCharacter } from './PlatformerCharacter';\n720\t/**\n721\t * Default key map for PlatformerCharacter. Movement is camera-relative for every preset\n722\t * (strafing in first person; left/right only on a side-scroller lane, except while\n723\t * climbing or hanging). Call from Game.fixedUpdate.\n724\t *\n725\t *   WASD / arrows  move          Shift   walk / tiptoe\n726\t *   Space          jump          C / Ctrl crouch (air: ground pound)\n727\t *   Z              prone toggle  X        lie down / get up\n728\t *   F (hold)       grab / pull   J        attack (punch, punch, kick; air: dive / kick)\n729\t *   V              wave          B        sit\n730\t */\n731\texport declare const KEYMAP: {\n732\t    readonly jump: readonly [\"Space\"];\n733\t    readonly walk: readonly [\"ShiftLeft\", \"ShiftRight\"];\n734\t    readonly crouch: readonly [\"KeyC\", \"ControlLeft\", \"ControlRight\"];\n735\t    readonly prone: readonly [\"KeyZ\"];\n736\t    readonly lie: readonly [\"KeyX\"];\n737\t    readonly grab: readonly [\"KeyF\"];\n738\t    readonly attack: readonly [\"KeyJ\"];\n739\t    readonly wave: readonly [\"KeyV\"];\n740\t    readonly sit: readonly [\"KeyB\"];\n741\t};\n742\t/**\n743\t * Read the default key map into a MoveInput. Pass `out` (kept by the game) to reuse it and\n744\t * its `move` vector every step instead of allocating a new one.\n745\t */\n746\texport declare function readMoveInput(ctx: GameContext, character: PlatformerCharacter, out?: MoveInput): MoveInput;\n747\t"}]},"parent_tool_use_id":null,"session_id":"3b81aee7-e493-4131-b722-c7c742e27493","uuid":"a314001b-0591-4e72-95df-3deee09c4fd4","timestamp":"2026-11-05T23:24:21.514Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bq45f86os.txt","content":"=================== animation/types\n/**\n * Animation authoring format — designed to be written and edited by AI agents (and\n * humans) as plain data. See docs/ANIMATION.md for the workflow.\n *\n * - Time is in FRAMES at 30 fps (Mario 64's rate). `frames: 24` = 0.8 s.\n * - Rotations are Euler XYZ in DEGREES, relative to the joint's rest orientation.\n *   Values interpolate per axis, so a full flip is simply `[360, 0, 0]`.\n * - A key's pose is a FULL pose: any joint not listed is at rest (0,0,0). Build poses by\n *   spreading shared poses: `{ ...CROUCH, Head: [10, 0, 0] }`.\n * - Root motion lives in the Pelvis: `p` is an OFFSET from its rest position (metres),\n *   `s` is scale (squash & stretch). Only Pelvis and Head may scale.\n */\nexport type Euler = [number, number, number];\nexport type Vec3 = [number, number, number];\nexport interface JointPose {\n    /** Rotation, degrees XYZ. */\n    r?: Euler;\n    /** Position offset from rest, metres (Pelvis only in practice). */\n    p?: Vec3;\n    /** Scale: uniform number or per-axis. 1 = rest. */\n    s?: number | Vec3;\n}\n/** Joint name → rotation (degrees) or full joint pose. Missing joints are at rest. */\nexport type Pose = Readonly<Record<string, Euler | JointPose>>;\nexport type Ease = 'linear'\n/** accelerate */\n | 'in'\n/** decelerate */\n | 'out'\n/** smooth start and stop (default) */\n | 'inOut'\n/** hold this pose until the next key, then snap */\n | 'hold'\n/** pull back before moving (anticipation) */\n | 'inBack'\n/** overshoot and settle (follow-through) */\n | 'outBack';\n/** `[frame, pose, easeToNextKey?]` */\nexport type Key = readonly [number, Pose, Ease?];\n/** Additive sine wave on one channel — breathing, bobbing, idle sway. */\nexport interface Layer {\n    joint: string;\n    /** rx/ry/rz in degrees, px/py/pz in metres, s = uniform scale delta. */\n    channel: 'rx' | 'ry' | 'rz' | 'px' | 'py' | 'pz' | 's';\n    amplitude: number;\n    /** Frames per cycle. For looping clips it must divide `frames`. */\n    period: number;\n    /** 0..1 fraction of a cycle. */\n    phase?: number;\n}\n/** Where the feet should be (foot IK goals; see ik.ts). A missing side is left as keyed. */\nexport interface FeetGoals {\n    R?: FootGoalDef;\n    L?: FootGoalDef;\n}\n/** Same shape as ik.ts `FootGoal` (kept here so types.ts has no imports). */\nexport interface FootGoalDef {\n    z: number;\n    x?: number;\n    y?: number;\n    pitch?: number;\n    pivot?: 'heel' | 'ball' | 'ankle';\n    follow?: number;\n    relax?: number;\n}\n/** `[frame, goals, easeToNextKey?]` */\nexport type FeetKey = readonly [number, FeetGoals, Ease?];\nexport interface ClipDef {\n    name: string;\n    /** Length in frames at 30 fps. */\n    frames: number;\n    loop?: boolean;\n    keys: readonly Key[];\n    layers?: readonly Layer[];\n    /**\n     * Feet track: foot goals interpolated between its own keys and solved with IK every\n     * frame, overriding the keyed leg rotations. Use it whenever feet touch the floor\n     * through a transition (kneel → stand, sit → lie) so they roll instead of sinking.\n     */\n    feet?: readonly FeetKey[];\n    /**\n     * Ground speed (m/s) the clip is authored for at playback rate 1. Locomotion clips set\n     * this; metrics then measure foot sliding against it and the runtime can scale playback.\n     */\n    speed?: number;\n    /**\n     * Gait cycles (gaitClip): the share of the cycle each foot is planted. The right heel\n     * strikes at phase 0, the left at 0.5, so the right foot is mid-stance at `stance / 2`.\n     */\n    stance?: number;\n    /** Gaits: how far ahead of the hips (m) the middle of the stance is (feet touch down `reach` + half a stance's ground ahead). */\n    reach?: number;\n    /** Grounded clip: soles should rest on y = 0 (metrics flag floating / penetration). */\n    grounded?: boolean;\n    /** Intentionally snappy (flips, punches, launches): skip the angular-speed warning. */\n    fast?: boolean;\n    notes?: string;\n}\nexport interface JointLimit {\n    x?: [number, number];\n    y?: [number, number];\n    z?: [number, number];\n}\n/** One leg's joints, hip → knee → ankle, bending about X (knee forward). */\nexport interface LegJoints {\n    upper: string;\n    lower: string;\n    foot: string;\n    /** Hip joint position in the root (pelvis) joint's space. */\n    hip: Vec3;\n}\n/** Leg geometry for foot-placement IK (`placeFeet`, `gaitClip`). Lengths in metres. */\nexport interface LegRig {\n    R: LegJoints;\n    L: LegJoints;\n    /** Root (pelvis) joint height above the ground at rest. */\n    rootHeight: number;\n    /** Hip → knee. */\n    upper: number;\n    /** Knee → ankle. */\n    lower: number;\n    /** Ankle height above the sole when the foot is flat. */\n    ankle: number;\n    /** Heel contact point, metres behind the ankle. */\n    heel: number;\n    /** Toe tip contact point, metres ahead of the ankle. */\n    ball: number;\n    /** Top of the shoe above the ankle (m), for swing clearance when the foot tips over. */\n    top?: number;\n}\n/** Everything the tools need to know about a rig beyond its hierarchy. */\nexport interface RigSpec {\n    /** Joint names in hierarchy order (root first). */\n    joints: readonly string[];\n    root: string;\n    /** Left/right counterparts for mirroring. */\n    mirror: Readonly<Record<string, string>>;\n    /** Mesh names that touch the ground (soles). */\n    soles: readonly string[];\n    /** Points to trace in contact sheets (joint or mesh names). */\n    trace: readonly string[];\n    /** Human-plausible rotation ranges, degrees. */\n    limits: Readonly<Record<string, JointLimit>>;\n    /** Frame rate of the authoring format. */\n    fps: number;\n    /** Leg geometry, enabling foot IK and the gait generator. */\n    legs?: LegRig;\n    /**\n     * Joints the runtime procedural layers turn (PoseLayers): the torso and head look where\n     * the character is going; `cap` is an optional springy joint (not animated by clips).\n     */\n    spine?: {\n        torso?: string;\n        head?: string;\n        cap?: string;\n    };\n}\n=================== animation/compile\nimport { AnimationClip, type Object3D, Quaternion } from 'three/webgpu';\nimport type { ClipDef, RigSpec } from './types';\n/** Rest transforms of a model's joints (from the GLB), used as the base for poses. */\nexport interface RestPose {\n    position: Record<string, [number, number, number]>;\n    quaternion: Record<string, Quaternion>;\n    scale: Record<string, [number, number, number]>;\n}\nexport declare function restPoseOf(model: Object3D, rig: RigSpec): RestPose;\n/**\n * Bake a ClipDef into a three.js AnimationClip (quaternion + position + scale tracks,\n * sampled at 60 Hz so easing and per-axis Euler interpolation — including 360° flips —\n * survive exactly).\n */\nexport declare function compileClip(def: ClipDef, rig: RigSpec, rest: RestPose): AnimationClip;\nexport declare function compileClips(defs: readonly ClipDef[], rig: RigSpec, model: Object3D): AnimationClip[];\n=================== animation/sheet\nimport { type AnimationClip, type Object3D } from 'three/webgpu';\nimport { type SheetImage } from './raster';\nexport type { SheetImage } from './raster';\nimport type { ClipReport } from './metrics';\nimport type { ClipDef, RigSpec } from './types';\n/**\n * Contact sheets: render a clip to an RGBA image with a tiny software rasterizer — no\n * GPU, no DOM, so it runs in Node (the `npm run anim` CLI) and in the browser alike.\n *\n *   rows     views (side / front / top / three-quarter), columns = frames\n *   overlay  skeleton (right side orange, left cyan, centre yellow) and ground contacts\n *            (green bar = sole on the floor, red = through it)\n *   trails   one wide side-view panel with onion-skinned stick figures and the paths of\n *            the hands, feet and head; locomotion clips are drawn travelling at their\n *            authored speed, so a planted foot shows as a single point (sliding = smear)\n *\n * This is the main way an agent \"looks\" at an animation: render, read the PNG, adjust\n * numbers, repeat.\n */\nexport type ViewName = 'side' | 'front' | 'top' | 'three';\nexport interface SheetOptions {\n    /** Authoring frames to show (default: the key frames, or 12 evenly spaced). */\n    frames?: number[];\n    views?: ViewName[];\n    /** Pixels per metre (default 64). */\n    scale?: number;\n    skeleton?: boolean;\n    trails?: boolean;\n    /** Metrics to print under the sheet. */\n    report?: ClipReport;\n    /** A previous version of the clip: its skeleton and paths are drawn in magenta. */\n    ghost?: AnimationClip;\n    /**\n     * Called after the model is posed at each frame, before it is drawn: for parts the game\n     * moves at runtime from the pose (a bow's string drawn to the hand).\n     */\n    onPose?: (model: Object3D, frame: number) => void;\n}\nexport declare function defaultFrames(def: ClipDef, max?: number): number[];\n/** Render a contact sheet for one clip. */\nexport declare function renderSheet(model: Object3D, rig: RigSpec, def: ClipDef, clip: AnimationClip, options?: SheetOptions): SheetImage;\n=================== animation/pose\nimport { type ResolvedJoint } from './joint';\nimport type { ClipDef, Ease, Pose, RigSpec } from './types';\nexport { applyEase } from './ease';\nexport { REST_JOINT, resolveJoint, type ResolvedJoint } from './joint';\n/** Mirror a pose left ↔ right (rig.mirror pairs; Y/Z rotations and X offsets flip). */\nexport declare function mirror(pose: Pose, rig: Pick<RigSpec, 'mirror'>): Pose;\n/** A whole clip mirrored left ↔ right (e.g. ShimmyLeft from ShimmyRight). */\nexport declare function mirrorClip(clip: ClipDef, name: string, rig: Pick<RigSpec, 'mirror'>): ClipDef;\n/** Linear blend of two poses (0 = a, 1 = b). */\nexport declare function blend(a: Pose, b: Pose, t: number): Pose;\n/** Add rotation offsets (degrees) on top of a pose — handy for variations. */\nexport declare function offset(pose: Pose, deltas: Pose): Pose;\n/**\n * Evaluate a clip's pose at `frame` (keys + layers + feet track), fully resolved for every\n * joint of `rig` (or the listed joints — then the feet track needs a rig and is skipped).\n */\nexport declare function sampleClip(clip: ClipDef, frame: number, rig: RigSpec | readonly string[]): Record<string, ResolvedJoint>;\n/** The keys around frame `f` and the eased 0..1 position between them. */\nexport declare function bracket<T extends readonly [number, unknown, Ease?]>(keys: readonly T[], f: number): [T, T, number];\n/** Problems with a clip definition itself (unknown joints, bad key order, loop mismatch). */\nexport declare function validateClip(clip: ClipDef, rig: RigSpec): string[];\n=================== animation/poseLayers\nimport { type Object3D, Quaternion } from 'three/webgpu';\nimport type { RigSpec } from './types';\n/**\n * Procedural layers on top of the clips: small, physically motivated offsets that clips\n * can't know about because they depend on how the character is moving right now. Apply\n * them every render frame after the mixer (and RotationBlend), before foot placement, which\n * then puts the feet back on the ground.\n *\n * - **lean**: the whole body tips about the feet. `roll` (degrees, + = to its right) leans\n *   into turns; `pitch` (+ = forward) leans into acceleration and back when braking.\n * - **look**: the head (and a little of the torso) turns toward where the character is\n *   going, or toward something worth looking at. `yaw` in degrees, + = to its left.\n * - **impact**: 0..1, a landing squash: hips drop, body squashes and tips forward.\n * - **cap**: an optional springy joint (a hat): it lags behind the head's motion and settles.\n *\n * Every joint stays inside `rig.limits`.\n */\nexport interface PoseLayerInput {\n    lean: {\n        roll: number;\n        pitch: number;\n    };\n    look: number;\n    impact: number;\n}\nexport interface PoseLayerTuning {\n    /** Share of a look that the torso takes (the head takes the rest). */\n    torsoLook: number;\n    /** Landing impact at 1: pelvis drop (m), squash, torso pitch (deg). */\n    impactDrop: number;\n    impactSquash: number;\n    impactTorso: number;\n    /** Springy cap: stiffness (1/s²), damping (1/s), degrees per m/s² of head acceleration, max angle (deg). */\n    capStiffness: number;\n    capDamping: number;\n    capGain: number;\n    capMax: number;\n}\nexport declare const POSE_LAYER_DEFAULTS: PoseLayerTuning;\nexport declare class PoseLayers {\n    readonly tuning: PoseLayerTuning;\n    private readonly pelvis;\n    private readonly torso;\n    private readonly head;\n    private readonly cap;\n    private readonly rest;\n    private readonly limits;\n    private readonly capAngle;\n    private readonly capVel;\n    private readonly lastHead;\n    private readonly lastHeadVel;\n    private capStarted;\n    constructor(model: Object3D, rig: RigSpec, tuning?: Partial<PoseLayerTuning>);\n    /** Rest rotations (the clips' reference), if the model was posed when this was built. */\n    setRest(rest: ReadonlyMap<string, Quaternion>): void;\n    reset(): void;\n    apply(dt: number, input: PoseLayerInput): void;\n    /** Springy cap: driven by the head's acceleration, in the head's frame. */\n    private spring;\n    /** Add degrees to a joint's Euler XYZ (relative to rest), clamped to its limits. */\n    private addEuler;\n}\n=================== animation/procedural\n/**\n * Procedural motion: things that move because something else moved, computed every frame\n * instead of keyed.\n *\n *   SpringChain   secondary motion: a tail, antennae, a ponytail, a cape strip. Verlet points\n *                 that keep most of their velocity, are pulled back toward their rest\n *                 direction (`stiffness`), sag under gravity and stay their length apart.\n *   Squash        squash and stretch: a spring on one number, drawn as a volume-preserving\n *                 scale (taller is thinner). Kick it on landings, jumps and hits.\n *   LegStepper    planted feet for creatures with any number of legs: a foot stays where it\n *                 is in the world until it is too far from where it should be, then steps\n *                 there in an arc, never lifting at the same time as its neighbours.\n *\n * All pure (no three.js), deterministic, unit-tested; the Animation wing's rooms draw them.\n */\ntype Vec3 = [number, number, number];\nexport interface SpringChainOptions {\n    /** Points after the root (≥ 1). */\n    segments: number;\n    /** Length of each segment (m). */\n    length: number;\n    /** Rest direction from the root in the root's own space (normalised; default straight back, −Z). */\n    rest?: Vec3;\n    /** Pull toward the rest pose per second (0 floppy … 30 stiff). Default 10. */\n    stiffness?: number;\n    /** Velocity kept per 1/60 s (0..1). Default 0.94. */\n    keep?: number;\n    /** Gravity on the chain (m/s²). Default 6 (lighter than real: tails hold up a bit). */\n    gravity?: number;\n}\n/**\n * A chain of points hanging off a moving root. Call `update(dt, root, basis)` every frame\n * with the root's world position and its orientation (three columns: right, up, forward),\n * then read `points` (root first).\n */\nexport declare class SpringChain {\n    readonly points: Vec3[];\n    private readonly prev;\n    o: Required<SpringChainOptions>;\n    private started;\n    /** Time not yet stepped, and where the root was at the last step. */\n    private pending;\n    private readonly lastRoot;\n    private readonly dir;\n    constructor(o: SpringChainOptions);\n    /** Put the chain straight out in its rest pose (no swing). */\n    reset(root: Vec3, basis: readonly [Vec3, Vec3, Vec3]): void;\n    update(dt: number, root: Vec3, basis: readonly [Vec3, Vec3, Vec3]): void;\n    /** How far the tip is from where the rest pose puts it (m): how much it is swinging. */\n    swing(basis: readonly [Vec3, Vec3, Vec3]): number;\n    /** Each segment back to its length, from the root out (the root is fixed). */\n    private keepLengths;\n    /** The rest direction in the world (unit), into a reused array. */\n    private restDir;\n}\n/**\n * Squash and stretch as a damped spring on `value` (0 = rest, + stretched, − squashed).\n * `scale()` turns it into a volume-preserving pair: `const [h, v] = squash.scale();\n * mesh.scale.set(h, v, h)`.\n */\nexport declare class Squash {\n    value: number;\n    velocity: number;\n    /** Spring stiffness and damping (a critically damped spring has damping = 2√stiffness). */\n    stiffness: number;\n    damping: number;\n    /** 0 turns it off; 2.5 is rubbery. */\n    amount: number;\n    /** Add a kick: negative squashes (a landing), positive stretches (a jump). */\n    kick(v: number): void;\n    /** Set the shape directly (a held squash). */\n    set(v: number): void;\n    update(dt: number): void;\n    /** [horizontal, vertical] scale: y = 1 + s, xz = 1 / √(1 + s), so the volume stays put. */\n    scale(out?: [number, number]): [number, number];\n}\nexport interface LegDef {\n    /** Where the foot rests, in the body's space (x right, z forward; y ignored). */\n    rest: readonly [number, number];\n    /** Legs that must not be lifting when this one starts a step (its neighbours; mutual, so listing a pair once is enough). */\n    partners?: readonly number[];\n}\nexport interface LegStepperOptions {\n    legs: readonly LegDef[];\n    /** Step when the foot is this far from its target (m). Default 0.3. */\n    threshold?: number;\n    /** Seconds a step takes. Default 0.18. */\n    stepTime?: number;\n    /** How high a step lifts the foot (m). Default 0.15. */\n    lift?: number;\n    /** Aim ahead of the body's motion by this many seconds (feet land where it is going). Default 0.25. */\n    lead?: number;\n}\nexport interface Foot {\n    /** World position of the foot now. */\n    readonly at: Vec3;\n    /** Stepping: 0 → 1 through the step; -1 planted. */\n    t: number;\n    readonly from: Vec3;\n    readonly to: Vec3;\n}\n/**\n * Feet for a body with any number of legs. `update(dt, body, yaw, velocity, ground)`:\n * the body's world position and heading, how fast it moves, and the ground height at a point.\n */\nexport declare class LegStepper {\n    readonly feet: Foot[];\n    o: Required<Omit<LegStepperOptions, 'legs'>> & {\n        legs: readonly LegDef[];\n    };\n    /** Steps started (tests). */\n    steps: number;\n    private started;\n    /** Each leg's partners, both ways round (a leg waits for its partners, and they for it). */\n    private readonly partners;\n    /** Scratch for `update`: each foot's distance from its target, and the feet by that distance. */\n    private readonly behind;\n    private readonly order;\n    private readonly t;\n    private static readonly STILL;\n    constructor(o: LegStepperOptions);\n    /** Where leg `i` wants to be: its rest spot around the body, ahead by the lead, on the ground. */\n    target(i: number, body: Vec3, yaw: number, velocity: Vec3, ground: (x: number, z: number) => number, out?: Vec3): Vec3;\n    /** Every foot planted on its rest spot around `body` (a spawn or a teleport). The first `update` does this itself. */\n    reset(body: Vec3, yaw: number, ground: (x: number, z: number) => number): void;\n    update(dt: number, body: Vec3, yaw: number, velocity: Vec3, ground: (x: number, z: number) => number): void;\n    /** Feet on the ground now. */\n    planted(): number;\n}\n/** Partners for `n` legs in two rows (left 0, 2, 4…, right 1, 3, 5…): a leg waits for the legs beside and opposite it. */\nexport declare function gaitPartners(n: number): number[][];\n/**\n * Where the middle joint of a two-bone limb goes (a knee, an elbow) so the end reaches\n * `target` from `root` with bones `a` and `b` long, bending toward `pole` (a point the knee\n * points at). Analytic (the law of cosines), no iterations; a target out of reach straightens\n * the limb toward it, one too close folds it as far as it goes. Returns the joint, into `out`.\n */\nexport declare function twoBoneIK(root: Vec3, target: Vec3, a: number, b: number, pole: Vec3, out?: Vec3): Vec3;\nexport {};\n=================== animation/gait\nimport { type FootGoal } from './ik';\nimport type { ClipDef, Euler, JointPose, LegRig, Pose, RigSpec } from './types';\n/**\n * Procedural locomotion cycles with planted feet. Instead of posing every frame, describe\n * the gait (speed, cadence, stance, bounce, arm swing...) and the generator plants each\n * foot on the ground, sliding it backwards at exactly `speed` while it is in stance, then\n * swings it forward on an arc — heel strike, roll, toe-off included. Tweak numbers,\n * re-run `npm run anim -- check Walk`, look at the sheet.\n *\n * Phase: the RIGHT heel strikes at frame 0, the left at frames / 2.\n */\nexport interface GaitSpec {\n    name: string;\n    /** One full cycle (two steps), frames at 30 fps. */\n    frames: number;\n    /** Ground speed the cycle is authored for (m/s at playback rate 1). */\n    speed: number;\n    /** Fraction of the cycle each foot is on the ground. Walk ≈ 0.55–0.6, run ≈ 0.3. */\n    stance: number;\n    /** Mean pelvis height offset from rest (m); negative bends the knees. */\n    hip: number;\n    /** Pelvis bounce amplitude (m), twice per cycle. */\n    bob?: number;\n    /** Cycle fraction at which the pelvis is lowest (default: walk just after contact, run mid-stance). */\n    low?: number;\n    /** Squash at the lowest point (e.g. 0.05 = 5 % shorter, wider). */\n    squash?: number;\n    /** How high the lowest point of the swinging foot clears the floor at its peak (m). */\n    lift?: number;\n    /** Where in the swing (0..1) the foot is highest (default 0.4). */\n    liftPeak?: number;\n    /** Shift the whole stride forward (m). */\n    reach?: number;\n    /** Extra forward throw of the swinging foot late in the swing, before it settles (m). */\n    swingReach?: number;\n    /** Swing timing: 0 = even, + = the foot hangs back then whips forward (running). */\n    swingDelay?: number;\n    /**\n     * 0..1: how much the swinging foot sweeps back to meet the ground at touchdown. At 1 it\n     * arrives moving backwards at exactly the ground speed (still, in the world), so the\n     * foot plants without sliding; at 0 it eases to a stop relative to the hips and slides\n     * forward for the frames it is already on the floor.\n     */\n    plant?: number;\n    /** Toes-up angle at heel strike (deg). */\n    heelStrike?: number;\n    /** Heel-raise angle at toe-off (deg). */\n    toeOff?: number;\n    /** Fraction of stance spent rolling off the heel / onto the toes. */\n    roll?: [heel: number, toe: number];\n    /** Walk on the balls of the feet: extra pitch through stance (deg), pivoting on the ball. */\n    tiptoe?: number;\n    /** Extra toes-down droop mid-swing (deg). */\n    swingPitch?: number;\n    /** How much the swinging foot hangs from the shin mid-swing (0..1, default 0.8). */\n    dangle?: number;\n    /** Torso lean forward (deg) and twist of the shoulders against the legs (deg). */\n    lean?: number;\n    twist?: number;\n    /** Side-to-side torso roll (deg). */\n    sway?: number;\n    /** Pelvis pitch (deg): tips the whole body, legs are re-solved. */\n    pelvisPitch?: number;\n    /** Head pitch (deg) and how much it counters the torso twist (0..1). */\n    head?: number;\n    headSteady?: number;\n    arms?: {\n        /** Swing amplitude (deg). */\n        swing: number;\n        /** Base elbow bend (deg). */\n        elbow: number;\n        /** Extra elbow bend when the arm is forward (deg). */\n        pump?: number;\n        /** Arms out from the body (deg). */\n        spread?: number;\n        /** Arms forward of hanging (deg) — offsets the swing centre. */\n        forward?: number;\n        /** Follow-through delay behind the legs, as a fraction of the cycle. */\n        lag?: number;\n    };\n    /** Extra joints/overrides mixed into every frame (hands, hat...). */\n    pose?: Pose;\n    /** Per-frame hook for anything else: receives the cycle phase 0..1. */\n    extra?: (u: number, pose: Record<string, Euler | JointPose>) => void;\n    /** Key spacing in frames (default 0.5 — IK is non-linear, keep it fine). */\n    step?: number;\n    notes?: string;\n}\nexport declare function gaitClip(rig: RigSpec, g: GaitSpec): ClipDef;\n/** The pose at cycle phase u (0..1). */\nexport declare function gaitPose(rig: RigSpec, g: GaitSpec, u: number): Pose;\n/** Where a foot is at its own phase (0 = heel strike). */\nexport declare function footAt(g: GaitSpec, legs: LegRig, phase: number, S: number): FootGoal;\n=================== physics/CharacterController\nimport { type AnimationClip, type Object3D, Vector3 } from 'three/webgpu';\nimport { type Physics, RAPIER } from './Physics';\nexport interface CharacterOptions {\n    position: [number, number, number];\n    radius?: number;\n    /** Height of the cylindrical part of the capsule. */\n    halfHeight?: number;\n    speed?: number;\n    jumpSpeed?: number;\n    gravity?: number;\n}\nexport type CharacterAnim = 'Idle' | 'Walk' | 'Jump';\n/**\n * Kinematic capsule driven by Rapier's KinematicCharacterController, with classic\n * platformer affordances (coyote time, jump buffering, variable jump height).\n *\n * The body moves in continuous world space; the visual model is interpolated by\n * Physics.bind and only *looks* pixel-aligned through the render pipeline.\n */\nexport declare class CharacterController {\n    private readonly physics;\n    readonly body: RAPIER.RigidBody;\n    readonly collider: RAPIER.Collider;\n    readonly controller: RAPIER.KinematicCharacterController;\n    readonly velocity: Vector3;\n    grounded: boolean;\n    facing: number;\n    private readonly speed;\n    private readonly jumpSpeed;\n    private readonly gravity;\n    private readonly footOffset;\n    private readonly prevFeet;\n    private coyote;\n    private jumpBuffer;\n    private wish;\n    private jumpHeld;\n    private mixer;\n    private actions;\n    private current;\n    constructor(physics: Physics, options: CharacterOptions);\n    /** Feet position (bottom of the capsule), continuous world space. */\n    get feet(): Vector3;\n    /** Feet position blended between the previous and current physics step (render use). */\n    interpolatedFeet(alpha: number): Vector3;\n    /** Set desired horizontal move direction (world space, length ≤ 1) and jump input. */\n    setInput(move: Vector3, jumpPressed: boolean, jumpHeld: boolean): void;\n    teleport(position: [number, number, number]): void;\n    /** Call from Physics.update's fixedUpdate callback. */\n    fixedUpdate(dt: number): void;\n    /** Attach a model's animation clips (expects Idle / Walk / Jump). */\n    attachAnimations(model: Object3D, clips: readonly AnimationClip[]): void;\n    get animation(): CharacterAnim;\n    /** Per render frame: pick animation state and advance the mixer. */\n    updateVisual(model: Object3D, dt: number): void;\n    private play;\n}\n=================== character/animator\nimport { type AnimationClip, type Object3D, type Quaternion } from 'three/webgpu';\nimport { FootPlacement, type FootPlacementInput, type FootPlacementTuning, type GroundProbe } from '../animation/footPlacement';\nimport { PoseLayers, type PoseLayerInput, type PoseLayerTuning } from '../animation/poseLayers';\nimport type { RigSpec } from '../animation/types';\n/**\n * Clip playback for PlatformerCharacter: blends, the locomotion blend space and the\n * procedural layers, in the order they run every render frame:\n *\n *   fades → gait phase → mixer → RotationBlend → (feet captured) → PoseLayers (lean, look,\n *   landing) → FootPlacement (feet back where the clips put them, on the real ground)\n *\n * **Blends.** Weights are driven here, not by three's crossFadeFrom (which restarts the\n * outgoing clip's fade from full weight, so a clip only partly faded in snapped to 100%\n * whenever states changed faster than the fade). Every outgoing clip fades from the weight\n * it has now.\n *\n * **Locomotion blend space.** Tiptoe, Walk and Run play together as one logical clip (the\n * \"gait\"): weights come from the ground speed (Walk at its authored speed → Run at its\n * authored speed), with Tiptoe taking the low end on a gentle stick tilt. All three share\n * one normalised phase (they all strike the right heel at 0), which advances at\n * speed / (blended stride length), so the blended planted foot moves exactly with the\n * ground and every clip plays at a rate matched to its own authored speed.\n */\nexport interface AnimRequest {\n    name: string;\n    once?: boolean;\n    /** Playback rate (negative plays backwards). */\n    speed?: number;\n    /** Fade-in seconds (default 0.12). */\n    fade?: number;\n    /** Play the locomotion blend space instead of `name` (`name` is the fallback clip). */\n    gait?: GaitRequest;\n}\nexport interface GaitRequest {\n    /** Ground speed (m/s). */\n    speed: number;\n    /** 0..1: the share of the low end that tiptoes (gentle stick tilt) instead of walking. */\n    tiptoe: number;\n}\n/** The clips of the locomotion blend space, by role, and where walking turns into running. */\nexport interface GaitClips {\n    tiptoe: string;\n    walk: string;\n    run: string;\n    /**\n     * Ground speeds (m/s) between which Walk cross-fades into Run (default: their authored\n     * speeds). Gaits with different stance shares don't blend cleanly (one foot is still\n     * planted while the other gait already swings it), so keep the band short.\n     */\n    blend?: readonly [number, number];\n}\nexport interface AnimatorOptions {\n    rig?: RigSpec;\n    probe?: GroundProbe;\n    feet?: Partial<FootPlacementTuning>;\n    layers?: Partial<PoseLayerTuning>;\n    gait?: GaitClips;\n}\n/** Everything the procedural passes need this frame. */\nexport interface ProceduralInput extends PoseLayerInput {\n    feet: FootPlacementInput;\n}\nexport declare class Animator {\n    readonly model: Object3D;\n    private readonly mixer;\n    private readonly rotationBlend;\n    private readonly layers;\n    private readonly byName;\n    private current;\n    /** Gait: actions in role order (tiptoe, walk, run), stride per cycle (m), stance shares, phase 0..1. */\n    private readonly gait;\n    readonly feet: FootPlacement | null;\n    readonly pose: PoseLayers | null;\n    private readonly footNames;\n    /**\n     * The animated pose of every joint the procedural passes change, saved after the mixer and\n     * put back before the next mixer update. three's mixer only writes a joint whose blended\n     * value changed, so a held pose would otherwise keep (and stack) last frame's offsets.\n     */\n    private readonly touched;\n    constructor(model: Object3D, clips: readonly AnimationClip[], rest: ReadonlyMap<string, Quaternion>, options?: AnimatorOptions);\n    dispose(): void;\n    duration(name: string): number | undefined;\n    authoredSpeed(name: string): number | undefined;\n    /** The clip a request shows most (the gait's dominant clip). */\n    dominant(req: AnimRequest): string;\n    /** Tooling: every clip contributing to the pose, with its share of the blend, time (s) and rate. */\n    mix(): {\n        name: string;\n        weight: number;\n        time: number;\n        rate: number;\n    }[];\n    /** Start over with `name` playing alone, no blends, no procedural memory (a teleport, a respawn). */\n    restart(name: string): void;\n    /** Switch to (or keep playing) what `req` asks for, fading over `fade` seconds. */\n    play(req: AnimRequest, fade: number): void;\n    /** Advance fades, the gait and the mixer, then the procedural passes. */\n    update(dt: number, procedural?: ProceduralInput): void;\n    /** Gait shares and phase: weights from the speed, rates matched to each clip's own speed. */\n    private stepGait;\n    /**\n     * Which foot the gait swings and where it will land (foot placement blends a swinging\n     * foot from the ground it left to the ground it lands on); null when no gait leads.\n     */\n    private swingOf;\n    private readonly swing;\n    private readonly swingR;\n    private readonly swingL;\n    private gaitShares;\n    /** Normalised phase of a layer, if it is a stride (a gait clip with an authored speed). */\n    private phaseOf;\n    private isStride;\n    /**\n     * Starting the gait from another clip (standing, landing): the foot that is further forward\n     * now is the planted one, at the point of its stance where the gait has it that far\n     * forward (mid-stance from standing, heel strike landing with a leg out front), and the\n     * other one takes the next step.\n     */\n    private startPhase;\n    private stop;\n}\n=================== character/controls\nimport type { GameContext } from '../Engine';\nimport type { MoveInput, PlatformerCharacter } from './PlatformerCharacter';\n/**\n * Default key map for PlatformerCharacter. Movement is camera-relative for every preset\n * (strafing in first person; left/right only on a side-scroller lane, except while\n * climbing or hanging). Call from Game.fixedUpdate.\n *\n *   WASD / arrows  move          Shift   walk / tiptoe\n *   Space          jump          C / Ctrl crouch (air: ground pound)\n *   Z              prone toggle  X        lie down / get up\n *   F (hold)       grab / pull   J        attack (punch, punch, kick; air: dive / kick)\n *   V              wave          B        sit\n */\nexport declare const KEYMAP: {\n    readonly jump: readonly [\"Space\"];\n    readonly walk: readonly [\"ShiftLeft\", \"ShiftRight\"];\n    readonly crouch: readonly [\"KeyC\", \"ControlLeft\", \"ControlRight\"];\n    readonly prone: readonly [\"KeyZ\"];\n    readonly lie: readonly [\"KeyX\"];\n    readonly grab: readonly [\"KeyF\"];\n    readonly attack: readonly [\"KeyJ\"];\n    readonly wave: readonly [\"KeyV\"];\n    readonly sit: readonly [\"KeyB\"];\n};\n/**\n * Read the default key map into a MoveInput. Pass `out` (kept by the game) to reuse it and\n * its `move` vector every step instead of allocating a new one.\n */\nexport declare function readMoveInput(ctx: GameContext, character: PlatformerCharacter, out?: MoveInput): MoveInput;\n","numLines":747,"startLine":1,"totalLines":747}},"tool_result_meta":[{"id":"toolu_01EAPx3XBYyZRc8VUxpAz5eM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
