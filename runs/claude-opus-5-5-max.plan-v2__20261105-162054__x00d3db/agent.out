{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0131ebrX9ZbkFhEJerPG1NtG","type":"tool_result","content":"1\t=================== camera\n2\timport { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\n3\timport { type Resolution } from './framing';\n4\timport type { Input } from './input';\n5\t/**\n6\t * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n7\t * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n8\t * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n9\t * `fixed` config into your game.\n10\t */\n11\texport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\n12\texport declare const CAMERA_PRESETS: readonly CameraPreset[];\n13\texport interface CameraConfig {\n14\t    preset?: CameraPreset;\n15\t    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n16\t    zoom?: number;\n17\t    minZoom?: number;\n18\t    maxZoom?: number;\n19\t    /** Ortho presets: visible world height at zoom 1. */\n20\t    viewHeight?: number;\n21\t    /** iso: degrees below horizon / around Y. */\n22\t    pitch?: number;\n23\t    yaw?: number;\n24\t    /** Perspective presets: vertical field of view in degrees. */\n25\t    fov?: number;\n26\t    /** third: orbit distance at zoom 1. */\n27\t    distance?: number;\n28\t    /** fixed: camera position and look-at target. */\n29\t    position?: [number, number, number];\n30\t    target?: [number, number, number];\n31\t    /** fixed/free: projection. */\n32\t    projection?: 'perspective' | 'ortho';\n33\t    /** Follow smoothing; higher is snappier. */\n34\t    stiffness?: number;\n35\t}\n36\t/** What rigs may ask of the world (e.g. third-person wall avoidance). */\n37\texport interface CameraWorld {\n38\t    /** Distance from `from` along `dir` to the first obstacle, or null. */\n39\t    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n40\t}\n41\texport interface CameraUpdate {\n42\t    /** Point to follow (character center/chest). */\n43\t    target: Vector3;\n44\t    /** First-person eye point. */\n45\t    eye: Vector3;\n46\t    dt: number;\n47\t    resolution: Resolution;\n48\t    input: Input;\n49\t    world: CameraWorld;\n50\t    /**\n51\t     * Screen shake: added to the camera's position after the rig placed it (the engine's\n52\t     * `CameraShake`). Ortho rigs move it by whole art pixels.\n53\t     */\n54\t    shake?: Vector3;\n55\t}\n56\t/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\n57\texport interface CameraRigState {\n58\t    readonly preset: CameraPreset;\n59\t    readonly focus: readonly number[];\n60\t    readonly zoom: number;\n61\t    readonly aspect: number;\n62\t    readonly position: readonly number[];\n63\t    readonly quaternion: readonly number[];\n64\t    readonly shaken: readonly number[];\n65\t    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n66\t    readonly own: Readonly<Record<string, number>>;\n67\t}\n68\t/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\n69\texport declare abstract class CameraRig {\n70\t    abstract readonly preset: CameraPreset;\n71\t    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n72\t    /** World point the rig is centred on (used for shadow framing). */\n73\t    readonly focus: Vector3;\n74\t    zoom: number;\n75\t    readonly minZoom: number;\n76\t    readonly maxZoom: number;\n77\t    /** Whether zoom applies (all presets except first person). */\n78\t    readonly zoomable: boolean;\n79\t    /** First person hides the player model. */\n80\t    readonly hidesTarget: boolean;\n81\t    /** Side-scroller: characters should stay on their depth lane. */\n82\t    readonly lockDepth: boolean;\n83\t    /** False while the free camera is flying (input drives the camera, not the player). */\n84\t    controlsCharacter: boolean;\n85\t    /** Pixel-snap the camera (ortho only). */\n86\t    snap: boolean;\n87\t    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n88\t    aspect: number;\n89\t    protected readonly stiffness: number;\n90\t    constructor(config: CameraConfig);\n91\t    /**\n92\t     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n93\t     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n94\t     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n95\t     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n96\t     * them long (hundreds of metres).\n97\t     */\n98\t    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n99\t    setZoom(zoom: number): void;\n100\t    /**\n101\t     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n102\t     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n103\t     */\n104\t    setAspect(aspect: number): void;\n105\t    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n106\t    protected abstract applyZoom(): void;\n107\t    /** Place the camera without smoothing. */\n108\t    teleport(target: Vector3): void;\n109\t    /** Screen-relative movement basis on the ground plane. */\n110\t    groundBasis(): {\n111\t        right: Vector3;\n112\t        forward: Vector3;\n113\t    };\n114\t    update(u: CameraUpdate): void;\n115\t    protected abstract step(u: CameraUpdate): void;\n116\t    /** The shake offset actually applied this frame (zero when still). */\n117\t    private readonly shaken;\n118\t    /** The offset a shake moves the placed camera by (into `out`). */\n119\t    protected shakeOffset(offset: Vector3, out: Vector3): void;\n120\t    /** Serializable description (debug UI, `state()`). */\n121\t    describe(): Record<string, unknown>;\n122\t    /** The rig as data, exact (`engine.snapshot()`). */\n123\t    state(): CameraRigState;\n124\t    /** Put the rig back where `state()` found it (the same preset). */\n125\t    setState(s: CameraRigState): void;\n126\t    /** What a preset keeps beyond the base (`state()`). */\n127\t    protected ownState(): Record<string, number>;\n128\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n129\t    protected follow(target: Vector3, dt: number): void;\n130\t}\n131\t/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\n132\texport declare class OrthoRig extends CameraRig {\n133\t    readonly camera: OrthographicCamera;\n134\t    readonly preset: 'iso' | 'topdown' | 'side';\n135\t    readonly lockDepth: boolean;\n136\t    readonly baseViewHeight: number;\n137\t    private readonly offset;\n138\t    private readonly right;\n139\t    private readonly up;\n140\t    private readonly forward;\n141\t    private readonly tmp;\n142\t    /** World units per art pixel at the last update. */\n143\t    private pixel;\n144\t    protected ownState(): Record<string, number>;\n145\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n146\t    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n147\t    get viewHeight(): number;\n148\t    protected applyZoom(): void;\n149\t    protected step(u: CameraUpdate): void;\n150\t    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n151\t    protected shakeOffset(offset: Vector3, out: Vector3): void;\n152\t}\n153\t/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\n154\texport declare class ThirdPersonRig extends CameraRig {\n155\t    readonly preset: \"third\";\n156\t    readonly camera: PerspectiveCamera;\n157\t    yaw: number;\n158\t    pitch: number;\n159\t    private readonly baseDistance;\n160\t    private currentDistance;\n161\t    protected ownState(): Record<string, number>;\n162\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n163\t    constructor(config?: CameraConfig);\n164\t    protected applyZoom(): void;\n165\t    protected step(u: CameraUpdate): void;\n166\t    describe(): {\n167\t        yaw: number;\n168\t        pitch: number;\n169\t    };\n170\t}\n171\t/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\n172\texport declare class FirstPersonRig extends CameraRig {\n173\t    readonly preset: \"first\";\n174\t    readonly camera: PerspectiveCamera;\n175\t    readonly zoomable = false;\n176\t    readonly hidesTarget = true;\n177\t    yaw: number;\n178\t    pitch: number;\n179\t    protected ownState(): Record<string, number>;\n180\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n181\t    constructor(config?: CameraConfig);\n182\t    protected applyZoom(): void;\n183\t    protected step(u: CameraUpdate): void;\n184\t    groundBasis(): {\n185\t        right: Vector3;\n186\t        forward: Vector3;\n187\t    };\n188\t    describe(): {\n189\t        yaw: number;\n190\t        pitch: number;\n191\t    };\n192\t}\n193\t/**\n194\t * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n195\t * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n196\t * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n197\t * Enter again unfixes.\n198\t */\n199\texport declare class FreeRig extends CameraRig {\n200\t    readonly preset: 'free' | 'fixed';\n201\t    readonly camera: PerspectiveCamera | OrthographicCamera;\n202\t    fixed: boolean;\n203\t    yaw: number;\n204\t    pitch: number;\n205\t    protected ownState(): Record<string, number>;\n206\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n207\t    private readonly baseFov;\n208\t    private readonly baseViewHeight;\n209\t    private readonly projection;\n210\t    onFix: ((config: CameraConfig) => void) | null;\n211\t    constructor(preset: 'free' | 'fixed', config?: CameraConfig);\n212\t    protected applyZoom(): void;\n213\t    /** Freeze (or unfreeze) the view. */\n214\t    setFixed(fixed: boolean): void;\n215\t    fixedConfig(): CameraConfig;\n216\t    protected step(u: CameraUpdate): void;\n217\t    describe(): {\n218\t        fixed: boolean;\n219\t        config: CameraConfig;\n220\t    };\n221\t}\n222\texport declare function createCameraRig(config?: CameraConfig): CameraRig;\n223\texport declare function isPerspective(camera: Camera): camera is PerspectiveCamera;\n224\t=================== framing\n225\t/**\n226\t * Pure layout math for pixel-perfect presentation. No DOM, no three.js: unit-tested.\n227\t *\n228\t * The canvas backing store is sized to `art × scale` device pixels with an integer\n229\t * `scale`, and the scene renders at exactly the art resolution (pixelSize = scale). Every\n230\t * art pixel therefore covers an integer block of device pixels, and the canvas is centered\n231\t * inside the viewport. Fixed/adaptive framing letterboxes; fill framing crops only the\n232\t * excess device pixels at the edges of the last art pixel.\n233\t *\n234\t * Three aspect modes:\n235\t * - `fixed`: the art resolution is exactly `internal` (16:9); other screen shapes letterbox.\n236\t * - `adaptive`: the art *height* stays `internal.height` and the art width follows the\n237\t *   screen's aspect (clamped to ADAPTIVE_ASPECT), so phones in portrait or landscape and\n238\t *   odd window shapes fill the screen. Still integer-scaled. On a 16:9 screen it is\n239\t *   identical to `fixed`.\n240\t * - `fill`: the art width and height follow the viewport at the nearest integer scale\n241\t *   to `internal.height`. The canvas covers every edge without stretching art pixels.\n242\t */\n243\texport interface Resolution {\n244\t    readonly width: number;\n245\t    readonly height: number;\n246\t}\n247\texport declare const RESOLUTIONS: {\n248\t    /** Default internal resolution (16:9, 4× → 1920×1080). */\n249\t    readonly default: {\n250\t        readonly width: 480;\n251\t        readonly height: 270;\n252\t    };\n253\t    /** Chunkier comparison resolution (16:9, 6× → 1920×1080). */\n254\t    readonly compare: {\n255\t        readonly width: 320;\n256\t        readonly height: 180;\n257\t    };\n258\t};\n259\texport type AspectMode = 'fixed' | 'adaptive' | 'fill';\n260\t/** Art aspect ratios (width / height) the adaptive mode allows; beyond them it letterboxes. */\n261\texport declare const ADAPTIVE_ASPECT: {\n262\t    readonly min: 0.4;\n263\t    readonly max: 2.4;\n264\t};\n265\texport interface Framing {\n266\t    /** Art (internal) resolution actually rendered. Equals `internal` in fixed mode. */\n267\t    readonly artWidth: number;\n268\t    readonly artHeight: number;\n269\t    /** Device pixels per art pixel. Integer whenever `integer` is true. */\n270\t    readonly scale: number;\n271\t    /** True when every art pixel maps to an integer block of device pixels. */\n272\t    readonly integer: boolean;\n273\t    /** Canvas backing-store size in device pixels. */\n274\t    readonly canvasWidth: number;\n275\t    readonly canvasHeight: number;\n276\t    /** Canvas CSS size and offset inside the viewport, in CSS pixels. */\n277\t    readonly cssWidth: number;\n278\t    readonly cssHeight: number;\n279\t    readonly offsetX: number;\n280\t    readonly offsetY: number;\n281\t}\n282\t/** A page's viewport: its size in CSS pixels and the device pixel ratio (a recording keeps it: `Recording.view`). */\n283\texport interface Viewport {\n284\t    readonly width: number;\n285\t    readonly height: number;\n286\t    readonly dpr: number;\n287\t}\n288\t/**\n289\t * The framing and art resolution of a view (PixelRenderer's canvas, or a HeadlessView's viewport):\n290\t * `computeFraming`, and the art size as a resolution. Identity is kept where nothing changed: the\n291\t * `current` object while the art size stays, else `base` itself when the art size equals it (a\n292\t * fixed or 16:9 view reports the preset it was given), else a new one.\n293\t */\n294\texport declare function frameView(viewport: Viewport, base: Resolution, aspect: AspectMode, current: Resolution): {\n295\t    framing: Framing;\n296\t    resolution: Resolution;\n297\t};\n298\t/**\n299\t * @param viewportWidth  viewport width in CSS pixels\n300\t * @param viewportHeight viewport height in CSS pixels\n301\t * @param devicePixelRatio window.devicePixelRatio\n302\t * @param internal the art resolution (in adaptive mode: its height, and the 16:9 fallback)\n303\t * @param aspect `fixed` (exactly `internal`), `adaptive` (art width follows the screen),\n304\t * or `fill` (both art dimensions follow the screen, with no letterbox)\n305\t */\n306\texport declare function computeFraming(viewportWidth: number, viewportHeight: number, devicePixelRatio: number, internal: Resolution, aspect?: AspectMode): Framing;\n307\t/**\n308\t * Size of one art pixel in world units for an orthographic camera whose visible\n309\t * height is `viewHeight` world units. Used to snap the *camera* (never physics) to the\n310\t * pixel grid so static geometry doesn't shimmer while the camera moves.\n311\t */\n312\texport declare function worldUnitsPerPixel(viewHeight: number, internal: Resolution): number;\n313\texport declare function snapToGrid(value: number, step: number): number;\n314\t=================== SettingsPanel\n315\timport type { Engine } from './Engine';\n316\timport type { TouchCorner } from './TouchControls';\n317\t/**\n318\t * The settings panel (DOM, like the debug panel: it stays legible at any art resolution) and the\n319\t * ⚙ button that opens it: the player's picture, sound and engine options (`engine.settings`,\n320\t * settings.ts; the AudioManager's volumes). The engine pauses the game while it is open. Keys\n321\t * pressed in it never reach the game; Escape or Done closes it.\n322\t */\n323\texport declare class SettingsPanel {\n324\t    private readonly engine;\n325\t    readonly root: HTMLDivElement;\n326\t    readonly button: HTMLButtonElement | null;\n327\t    private idleTimer;\n328\t    private readonly controls;\n329\t    private readonly outputs;\n330\t    private readonly listeners;\n331\t    constructor(engine: Engine, container: HTMLElement, corner: TouchCorner | false);\n332\t    /**\n333\t     * Show the panel with the engine's current values. The panel takes the focus, not a control: a\n334\t     * game key pressed out of habit (D, Space) must not pick an option; Tab reaches the controls.\n335\t     */\n336\t    show(): void;\n337\t    hide(): void;\n338\t    /** Put the engine's current values into the controls, and into the debug panel (the loop fills it only while the game runs). */\n339\t    sync(): void;\n340\t    dispose(): void;\n341\t}\n342\t=================== LoadingScreen\n343\t/**\n344\t * Minimal pixel-styled loading indicator: a blocky segmented bar and a status word,\n345\t * plain DOM (it shows before the renderer exists). Reuses a `.pixel-loading` element\n346\t * already in the container (index.html ships one so it appears before any JS runs).\n347\t */\n348\texport declare class LoadingScreen {\n349\t    readonly root: HTMLElement;\n350\t    private readonly cells;\n351\t    private readonly label;\n352\t    private lit;\n353\t    constructor(container: HTMLElement, segments?: number);\n354\t    /** `progress` 0..1; `label` is shown in capitals. */\n355\t    set(progress: number, label?: string): void;\n356\t    done(): void;\n357\t}\n358\t=================== render/lights\n359\timport { Color, type ColorRepresentation, Group, type Object3D, PointLight, Vector3 } from 'three/webgpu';\n360\t/**\n361\t * Dynamic lighting: a fixed pool of real `PointLight`s shared by any number of *light\n362\t * requests* (torches, spells, projectiles, loot beams, glowing monsters...).\n363\t *\n364\t * Every light the toon material sees is part of its compiled shader, so changing the number\n365\t * of lights recompiles every material. The pool therefore never adds or removes lights: it\n366\t * keeps `size` lights in the scene at all times (unused ones at intensity 0) and, every\n367\t * frame, hands them to the most important requests: intensity × priority × proximity to the\n368\t * camera focus. Requests that hold a light get a hysteresis bonus, and every switch fades\n369\t * (the old owner out, then the new one in), so lights never pop. Moving a light or changing\n370\t * its colour, intensity or radius only updates uniforms: no shader work at all.\n371\t *\n372\t *   const torch = ctx.lights.request({ position: [3, 1.6, 4], color: 0xffa040, intensity: 6, radius: 7, flicker: 'torch' });\n373\t *   torch.update({ intensity: 9 });          // or torch.position.set(...)\n374\t *   torch.release();                          // fades out, frees its light\n375\t *\n376\t * The assignment itself is pure (`LightAssigner`, unit-tested); `LightPool` adds the\n377\t * three.js lights, flicker and following.\n378\t */\n379\t/** Flicker presets: intensity multipliers over time (deterministic per request seed). */\n380\texport type FlickerPreset = 'none' | 'torch' | 'candle' | 'brazier' | 'pulse' | 'strobe' | 'spell';\n381\texport declare const FLICKER_PRESETS: readonly FlickerPreset[];\n382\t/**\n383\t * Intensity multiplier of a flicker preset at time `t` (seconds). Averages ~1, stays within\n384\t * roughly 0.6..1.25 for fire so a torch never goes dark.\n385\t */\n386\texport declare function flicker(preset: FlickerPreset, t: number, seed?: number): number;\n387\t/** One request as the assigner sees it. `slot`/`level` are owned by the assigner. */\n388\texport interface AssignItem {\n389\t    /** Importance this frame (≥ 0); 0 = not wanted (out of range, off). */\n390\t    score: number;\n391\t    /** False once released: fades out, then leaves. */\n392\t    alive: boolean;\n393\t    /** Seconds to fade in / out. */\n394\t    fadeIn: number;\n395\t    fadeOut: number;\n396\t    /** Pool slot held, or -1. */\n397\t    slot: number;\n398\t    /** Shown fraction 0..1 (fades). */\n399\t    level: number;\n400\t}\n401\texport interface AssignStats {\n402\t    /** Requests that got a slot this step. */\n403\t    assigned: number;\n404\t    /** Requests that lost their slot (faded to 0) this step. */\n405\t    freed: number;\n406\t    /** Requests wanted but waiting for a slot to fade out. */\n407\t    waiting: number;\n408\t}\n409\t/**\n410\t * Pure light assignment: `capacity` slots, many items. Each step picks the `capacity`\n411\t * highest-scoring live items (items already holding a slot score × `hysteresis`, so two\n412\t * similar requests don't trade a light back and forth), fades winners in and losers out,\n413\t * and moves a slot to a new owner only once the old one has faded to 0. A fade changes a\n414\t * level by at most `dt / fade` per step: nothing ever pops.\n415\t */\n416\texport declare class LightAssigner<T extends AssignItem> {\n417\t    /** Slot → item holding it. */\n418\t    readonly slots: (T | null)[];\n419\t    hysteresis: number;\n420\t    private readonly ranked;\n421\t    private readonly wanted;\n422\t    constructor(capacity: number);\n423\t    get capacity(): number;\n424\t    /** Change the slot count (the pool's lights are rebuilt: a one-off shader recompile). */\n425\t    resize(capacity: number, items: Iterable<T>): void;\n426\t    /** Effective rank of an item (score with the hysteresis bonus for holders). */\n427\t    rank(it: T): number;\n428\t    step(dt: number, items: readonly T[]): AssignStats;\n429\t}\n430\texport interface LightRequestOptions {\n431\t    /** World position (copied). Ignored while `follow` is set (then it is `follow` + `offset`). */\n432\t    position?: Vector3 | readonly [number, number, number];\n433\t    /** Follow an object's world position every frame (a projectile, a monster, the hero). */\n434\t    follow?: Object3D | null;\n435\t    /** Offset from `follow` (world axes). */\n436\t    offset?: readonly [number, number, number];\n437\t    color?: ColorRepresentation;\n438\t    /** Point light intensity at full strength (before flicker and fades). Default 4. */\n439\t    intensity?: number;\n440\t    /** Reach in metres (PointLight.distance: light is 0 beyond it). Default 6. */\n441\t    radius?: number;\n442\t    /** Distance falloff exponent (PointLight.decay; a uniform, free to change). Default 1.2. */\n443\t    decay?: number;\n444\t    flicker?: FlickerPreset;\n445\t    /** Importance multiplier: the hero's light 4, a loot beam 2, a torch 1 (default). */\n446\t    priority?: number;\n447\t    /** Fade times in seconds (defaults 0.25 in, 0.2 out). */\n448\t    fadeIn?: number;\n449\t    fadeOut?: number;\n450\t    /** Release automatically after this many seconds (spell flashes, explosions). */\n451\t    lifetime?: number;\n452\t    /** Optional label for debugging (`pool.describe()`). */\n453\t    name?: string;\n454\t}\n455\t/** A light request. Change it freely; the pool decides whether it currently owns a real light. */\n456\texport interface LightHandle {\n457\t    readonly id: number;\n458\t    /** World position (mutable; ignored while following). */\n459\t    readonly position: Vector3;\n460\t    /** Colour (mutable). */\n461\t    readonly color: Color;\n462\t    intensity: number;\n463\t    radius: number;\n464\t    decay: number;\n465\t    flicker: FlickerPreset;\n466\t    priority: number;\n467\t    follow: Object3D | null;\n468\t    readonly offset: Vector3;\n469\t    name: string;\n470\t    /** Seconds left before auto-release (Infinity = until `release()`). */\n471\t    lifetime: number;\n472\t    /** Set several fields at once. */\n473\t    update(options: LightRequestOptions): this;\n474\t    /** Fade out and give the light back. Safe to call twice. */\n475\t    release(): void;\n476\t    readonly alive: boolean;\n477\t    /** Whether it holds one of the pool's real lights right now. */\n478\t    readonly lit: boolean;\n479\t    /** 0..1: how much of it is shown (fades). */\n480\t    readonly level: number;\n481\t}\n482\t/** Pool sizes by quality level (`QUALITY[level].lights`). */\n483\texport declare const LIGHT_POOL_SIZES: {\n484\t    readonly low: 4;\n485\t    readonly medium: 8;\n486\t    readonly high: 16;\n487\t};\n488\texport interface LightPoolOptions {\n489\t    /** Real lights in the pool (constant: changing it recompiles materials). Default 8. */\n490\t    size?: number;\n491\t    /** Parent for the pool's lights (added to it). Usually the scene. */\n492\t    parent?: Object3D;\n493\t}\n494\texport interface LightPoolStats {\n495\t    size: number;\n496\t    requests: number;\n497\t    lit: number;\n498\t    /** Slot hand-overs since creation (a request got a light). */\n499\t    assignments: number;\n500\t    /** Requests that wanted a light but had to wait last frame. */\n501\t    waiting: number;\n502\t    /** Milliseconds spent in the last update (CPU). */\n503\t    updateMs: number;\n504\t}\n505\t/**\n506\t * A fixed pool of point lights shared by many requests (see the file comment). Available\n507\t * to games as `ctx.lights` (sized by quality: low 4, medium 8, high 16), or create your\n508\t * own with `new LightPool({ size, parent: scene })` and call `update` every frame.\n509\t */\n510\texport declare class LightPool {\n511\t    readonly group: Group<import(\"three\").Object3DEventMap>;\n512\t    readonly lights: PointLight[];\n513\t    private readonly requests;\n514\t    private readonly assigner;\n515\t    private nextId;\n516\t    private time;\n517\t    private assignments;\n518\t    private waiting;\n519\t    private updateMs;\n520\t    private readonly tmp;\n521\t    constructor(options?: LightPoolOptions);\n522\t    /** Number of real lights (constant unless `resize`d). */\n523\t    get size(): number;\n524\t    /** Ask for a light. Returns a handle to move, recolour or release. */\n525\t    request(options?: LightRequestOptions): LightHandle;\n526\t    /**\n527\t     * Assign lights for this frame. `focus` is what the camera looks at; requests further\n528\t     * than `range` + their radius from it are not lit. Call once per rendered frame.\n529\t     */\n530\t    update(dt: number, focus: Vector3, range?: number): void;\n531\t    /** Release every request at once and darken the lights (level unload). */\n532\t    clear(): void;\n533\t    /**\n534\t     * Change the number of real lights. Every material using lights recompiles once, so do it\n535\t     * rarely (a quality change), never per frame.\n536\t     */\n537\t    resize(size: number): void;\n538\t    stats(): LightPoolStats;\n539\t    /** Every live request with its score and slot (debugging, inspectors). */\n540\t    describe(): {\n541\t        id: number;\n542\t        name: string;\n543\t        score: number;\n544\t        slot: number;\n545\t        level: number;\n546\t        alive: boolean;\n547\t    }[];\n548\t    dispose(): void;\n549\t    private worldPosition;\n550\t    private build;\n551\t}\n552\t=================== render/look\n553\t/**\n554\t * Looks: which filters run on which part of the picture.\n555\t *\n556\t * A frame has two kinds of things in it: **actors** (characters and objects: the hero,\n557\t * monsters, townsfolk, loot, chests; anything a game tags with `setLookLayer(obj, 'actors')`)\n558\t * and the **environment** (everything else: floors, walls, buildings, trees). A `Look` gives\n559\t * each of them its own source and filter stack, and then runs a third stack over the whole\n560\t * composed frame:\n561\t *\n562\t *   actors      → pixel art (or clean) + actor filters   ─┐\n563\t *                                                         ├─ composed by depth ─▶ scene filters ─▶ screen\n564\t *   environment → pixel art (or clean) + world filters   ─┘\n565\t *\n566\t * So a clean, full-resolution world with pixel-art characters is\n567\t * `{ actors: { pixel: crisp }, environment: { pixel: null } }`. When both layers are the\n568\t * same (the default: pixel art everywhere, filters on the whole scene) the renderer draws\n569\t * the scene once, exactly as before; only a look that differs per layer pays for a second\n570\t * scene pass. Filter parameters are uniforms, so moving a slider never rebuilds a shader.\n571\t *\n572\t * Everything here is plain data (unit-tested in `look.test.ts`): the renderer turns a look\n573\t * into a node graph (`PixelRenderer.setLook`).\n574\t */\n575\timport { type FilterParam } from './filters';\n576\timport type { LookLayer } from './lookLayer';\n577\texport { LOOK_LAYER_KEY, lookLayerOf, setLookLayer, type LookLayer } from './lookLayer';\n578\t/** Where a filter stack applies: the whole composed frame, or one layer. */\n579\texport type LookTarget = 'scene' | LookLayer;\n580\texport declare const LOOK_TARGETS: readonly LookTarget[];\n581\texport declare const LOOK_TARGET_LABELS: Readonly<Record<LookTarget, string>>;\n582\t/** Pixel-art rendering of a layer: the scene at the art resolution with outlines. */\n583\texport interface PixelLook {\n584\t    /** Art pixels per rendered pixel: 1 = the native art resolution, 2+ = chunkier. */\n585\t    size: number;\n586\t    /** Silhouette (depth) outline darkening, 0..1. */\n587\t    outline: number;\n588\t    /** Internal crease highlight (normal edges), 0..1. Keep it weak. */\n589\t    crease: number;\n590\t}\n591\t/** One filter in a stack, with its parameter values (missing ones are the defaults). */\n592\texport interface LookFilter {\n593\t    id: string;\n594\t    params?: Record<string, number>;\n595\t}\n596\t/** A layer's own look: its source (pixel art or clean) and its filters. */\n597\texport interface LayerLook {\n598\t    /** Pixel-art settings, or null for clean full-resolution rendering. */\n599\t    pixel: PixelLook | null;\n600\t    filters: LookFilter[];\n601\t}\n602\texport interface Look {\n603\t    /** Filters on the composed frame (both layers). */\n604\t    scene: LookFilter[];\n605\t    actors: LayerLook;\n606\t    environment: LayerLook;\n607\t}\n608\texport declare const PIXEL_PARAMS: readonly FilterParam[];\n609\texport declare const PIXEL_PRESETS: Readonly<Record<string, Readonly<PixelLook>>>;\n610\texport declare const DEFAULT_PIXEL: Readonly<PixelLook>;\n611\t/** The engine default: pixel art everywhere, no filters. */\n612\texport declare function defaultLook(): Look;\n613\t/** A plain stack of filters on the whole scene (what `setFilters(ids)` means), keeping `base`'s layers. */\n614\texport declare function lookFromFilters(ids: readonly string[], base?: Look): Look;\n615\t/**\n616\t * The look a view starts with (PixelRenderer and HeadlessView alike): `look` when given, else\n617\t * `filters` on the whole scene over pixel art with these outline strengths (`EngineOptions.edges`).\n618\t */\n619\texport declare function startingLook(o: {\n620\t    look?: Look;\n621\t    filters?: readonly string[];\n622\t    edges: {\n623\t        depth: number;\n624\t        normal: number;\n625\t    };\n626\t}): Look;\n627\texport declare function cloneLook(look: Look): Look;\n628\t/** The filters of one target (scene stack or a layer's). */\n629\texport declare function lookFilters(look: Look, target: LookTarget): LookFilter[];\n630\texport declare function normalizePixel(raw: unknown): PixelLook | null;\n631\t/**\n632\t * A complete, valid look from anything (storage, the URL, an agent): unknown filters and\n633\t * duplicates dropped (and `sceneOnly` filters from layer stacks), every parameter present\n634\t * and clamped to its range, layers defaulted.\n635\t */\n636\texport declare function normalizeLook(raw: unknown): Look;\n637\texport declare function looksEqual(a: Look, b: Look): boolean;\n638\texport declare function pixelsEqual(a: PixelLook | null, b: PixelLook | null): boolean;\n639\t/** The layers' pixel settings when they are the same (what \"whole scene\" pixel art means), else undefined. */\n640\texport declare function scenePixel(look: Look): PixelLook | null | undefined;\n641\t/** One scene render the renderer needs: the whole scene, or one layer. */\n642\texport interface LookSource {\n643\t    layer: 'all' | LookLayer;\n644\t    pixel: PixelLook | null;\n645\t    /** Filters of this source before composing (empty for `all`). */\n646\t    filters: LookFilter[];\n647\t}\n648\texport interface LookPlan {\n649\t    /** Two scene passes (actors and environment) composed by depth. */\n650\t    split: boolean;\n651\t    sources: LookSource[];\n652\t    /** Filters on the composed frame. */\n653\t    scene: LookFilter[];\n654\t    /**\n655\t     * What decides the node graph: pixel on/off per source and the filter ids in order.\n656\t     * Parameter values and pixel sizes are uniforms and stay out of it.\n657\t     */\n658\t    key: string;\n659\t}\n660\t/**\n661\t * What a look needs from the renderer. One scene pass when both layers look the same\n662\t * (same pixel settings, no per-layer filters), two otherwise.\n663\t */\n664\texport declare function planLook(look: Look): LookPlan;\n665\t/** Filter ids active in a target (setActive side effects such as the PS1 wobble). */\n666\texport declare function activeIds(look: Look, target: LookTarget): string[];\n667\t/**\n668\t * Named looks: the default (`none`: pixel art, no filters), `no_filters` (nothing at all:\n669\t * full resolution, no pixel art, no outlines, no filters), every plain filter stack\n670\t * (`FILTER_PRESETS`) as a whole-scene look, then looks that mix layers and stacks.\n671\t */\n672\texport declare const LOOK_PRESETS: Readonly<Record<string, Look>>;\n673\t/** Names looks used to have (stored settings, links): `hd_clean` is `no_filters` now. */\n674\texport declare const LOOK_ALIASES: Readonly<Record<string, string>>;\n675\t/** The `LOOK_PRESETS` name a name means (aliases resolved), or null when there is none. */\n676\texport declare function lookPresetName(name: string): string | null;\n677\t/** How a menu shows a look's name: `none` is the default, underscores are spaces. */\n678\texport declare function lookPresetLabel(name: string): string;\n679\t/** The preset name a look matches, or null (custom). */\n680\texport declare function lookPresetOf(look: Look): string | null;\n681\t/**\n682\t * The parameter preset a filter's values match, or null (custom). A preset sets its own\n683\t * keys and the defaults for the rest; strength (`amount`) only counts when the preset sets it,\n684\t * so a half-strength \"heavy\" is still \"heavy\".\n685\t */\n686\texport declare function filterPresetOf(presets: Readonly<Record<string, Readonly<Record<string, number>>>>, defaults: Record<string, number>, values: Record<string, number>): string | null;\n687\t/** Parameter values of a filter in a look (defaults filled in). */\n688\texport declare function paramsOf(f: LookFilter): Record<string, number>;\n689\t/** Canonical position of a filter (the order of FILTERS), so stacks edited by a UI stay in a sensible order. */\n690\texport declare function filterOrder(id: string): number;\n691\t"}]},"parent_tool_use_id":null,"session_id":"3b81aee7-e493-4131-b722-c7c742e27493","uuid":"29d9be31-500f-48f7-b24b-c8e2a5bc07ef","timestamp":"2026-11-05T23:24:50.000Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bkpmrqnfq.txt","content":"=================== camera\nimport { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\nimport { type Resolution } from './framing';\nimport type { Input } from './input';\n/**\n * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n * `fixed` config into your game.\n */\nexport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\nexport declare const CAMERA_PRESETS: readonly CameraPreset[];\nexport interface CameraConfig {\n    preset?: CameraPreset;\n    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n    zoom?: number;\n    minZoom?: number;\n    maxZoom?: number;\n    /** Ortho presets: visible world height at zoom 1. */\n    viewHeight?: number;\n    /** iso: degrees below horizon / around Y. */\n    pitch?: number;\n    yaw?: number;\n    /** Perspective presets: vertical field of view in degrees. */\n    fov?: number;\n    /** third: orbit distance at zoom 1. */\n    distance?: number;\n    /** fixed: camera position and look-at target. */\n    position?: [number, number, number];\n    target?: [number, number, number];\n    /** fixed/free: projection. */\n    projection?: 'perspective' | 'ortho';\n    /** Follow smoothing; higher is snappier. */\n    stiffness?: number;\n}\n/** What rigs may ask of the world (e.g. third-person wall avoidance). */\nexport interface CameraWorld {\n    /** Distance from `from` along `dir` to the first obstacle, or null. */\n    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n}\nexport interface CameraUpdate {\n    /** Point to follow (character center/chest). */\n    target: Vector3;\n    /** First-person eye point. */\n    eye: Vector3;\n    dt: number;\n    resolution: Resolution;\n    input: Input;\n    world: CameraWorld;\n    /**\n     * Screen shake: added to the camera's position after the rig placed it (the engine's\n     * `CameraShake`). Ortho rigs move it by whole art pixels.\n     */\n    shake?: Vector3;\n}\n/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\nexport interface CameraRigState {\n    readonly preset: CameraPreset;\n    readonly focus: readonly number[];\n    readonly zoom: number;\n    readonly aspect: number;\n    readonly position: readonly number[];\n    readonly quaternion: readonly number[];\n    readonly shaken: readonly number[];\n    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n    readonly own: Readonly<Record<string, number>>;\n}\n/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\nexport declare abstract class CameraRig {\n    abstract readonly preset: CameraPreset;\n    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n    /** World point the rig is centred on (used for shadow framing). */\n    readonly focus: Vector3;\n    zoom: number;\n    readonly minZoom: number;\n    readonly maxZoom: number;\n    /** Whether zoom applies (all presets except first person). */\n    readonly zoomable: boolean;\n    /** First person hides the player model. */\n    readonly hidesTarget: boolean;\n    /** Side-scroller: characters should stay on their depth lane. */\n    readonly lockDepth: boolean;\n    /** False while the free camera is flying (input drives the camera, not the player). */\n    controlsCharacter: boolean;\n    /** Pixel-snap the camera (ortho only). */\n    snap: boolean;\n    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n    aspect: number;\n    protected readonly stiffness: number;\n    constructor(config: CameraConfig);\n    /**\n     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n     * them long (hundreds of metres).\n     */\n    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n    setZoom(zoom: number): void;\n    /**\n     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n     */\n    setAspect(aspect: number): void;\n    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n    protected abstract applyZoom(): void;\n    /** Place the camera without smoothing. */\n    teleport(target: Vector3): void;\n    /** Screen-relative movement basis on the ground plane. */\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    update(u: CameraUpdate): void;\n    protected abstract step(u: CameraUpdate): void;\n    /** The shake offset actually applied this frame (zero when still). */\n    private readonly shaken;\n    /** The offset a shake moves the placed camera by (into `out`). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n    /** Serializable description (debug UI, `state()`). */\n    describe(): Record<string, unknown>;\n    /** The rig as data, exact (`engine.snapshot()`). */\n    state(): CameraRigState;\n    /** Put the rig back where `state()` found it (the same preset). */\n    setState(s: CameraRigState): void;\n    /** What a preset keeps beyond the base (`state()`). */\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    protected follow(target: Vector3, dt: number): void;\n}\n/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\nexport declare class OrthoRig extends CameraRig {\n    readonly camera: OrthographicCamera;\n    readonly preset: 'iso' | 'topdown' | 'side';\n    readonly lockDepth: boolean;\n    readonly baseViewHeight: number;\n    private readonly offset;\n    private readonly right;\n    private readonly up;\n    private readonly forward;\n    private readonly tmp;\n    /** World units per art pixel at the last update. */\n    private pixel;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n    get viewHeight(): number;\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n}\n/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\nexport declare class ThirdPersonRig extends CameraRig {\n    readonly preset: \"third\";\n    readonly camera: PerspectiveCamera;\n    yaw: number;\n    pitch: number;\n    private readonly baseDistance;\n    private currentDistance;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\nexport declare class FirstPersonRig extends CameraRig {\n    readonly preset: \"first\";\n    readonly camera: PerspectiveCamera;\n    readonly zoomable = false;\n    readonly hidesTarget = true;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/**\n * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n * Enter again unfixes.\n */\nexport declare class FreeRig extends CameraRig {\n    readonly preset: 'free' | 'fixed';\n    readonly camera: PerspectiveCamera | OrthographicCamera;\n    fixed: boolean;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    private readonly baseFov;\n    private readonly baseViewHeight;\n    private readonly projection;\n    onFix: ((config: CameraConfig) => void) | null;\n    constructor(preset: 'free' | 'fixed', config?: CameraConfig);\n    protected applyZoom(): void;\n    /** Freeze (or unfreeze) the view. */\n    setFixed(fixed: boolean): void;\n    fixedConfig(): CameraConfig;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        fixed: boolean;\n        config: CameraConfig;\n    };\n}\nexport declare function createCameraRig(config?: CameraConfig): CameraRig;\nexport declare function isPerspective(camera: Camera): camera is PerspectiveCamera;\n=================== framing\n/**\n * Pure layout math for pixel-perfect presentation. No DOM, no three.js: unit-tested.\n *\n * The canvas backing store is sized to `art × scale` device pixels with an integer\n * `scale`, and the scene renders at exactly the art resolution (pixelSize = scale). Every\n * art pixel therefore covers an integer block of device pixels, and the canvas is centered\n * inside the viewport. Fixed/adaptive framing letterboxes; fill framing crops only the\n * excess device pixels at the edges of the last art pixel.\n *\n * Three aspect modes:\n * - `fixed`: the art resolution is exactly `internal` (16:9); other screen shapes letterbox.\n * - `adaptive`: the art *height* stays `internal.height` and the art width follows the\n *   screen's aspect (clamped to ADAPTIVE_ASPECT), so phones in portrait or landscape and\n *   odd window shapes fill the screen. Still integer-scaled. On a 16:9 screen it is\n *   identical to `fixed`.\n * - `fill`: the art width and height follow the viewport at the nearest integer scale\n *   to `internal.height`. The canvas covers every edge without stretching art pixels.\n */\nexport interface Resolution {\n    readonly width: number;\n    readonly height: number;\n}\nexport declare const RESOLUTIONS: {\n    /** Default internal resolution (16:9, 4× → 1920×1080). */\n    readonly default: {\n        readonly width: 480;\n        readonly height: 270;\n    };\n    /** Chunkier comparison resolution (16:9, 6× → 1920×1080). */\n    readonly compare: {\n        readonly width: 320;\n        readonly height: 180;\n    };\n};\nexport type AspectMode = 'fixed' | 'adaptive' | 'fill';\n/** Art aspect ratios (width / height) the adaptive mode allows; beyond them it letterboxes. */\nexport declare const ADAPTIVE_ASPECT: {\n    readonly min: 0.4;\n    readonly max: 2.4;\n};\nexport interface Framing {\n    /** Art (internal) resolution actually rendered. Equals `internal` in fixed mode. */\n    readonly artWidth: number;\n    readonly artHeight: number;\n    /** Device pixels per art pixel. Integer whenever `integer` is true. */\n    readonly scale: number;\n    /** True when every art pixel maps to an integer block of device pixels. */\n    readonly integer: boolean;\n    /** Canvas backing-store size in device pixels. */\n    readonly canvasWidth: number;\n    readonly canvasHeight: number;\n    /** Canvas CSS size and offset inside the viewport, in CSS pixels. */\n    readonly cssWidth: number;\n    readonly cssHeight: number;\n    readonly offsetX: number;\n    readonly offsetY: number;\n}\n/** A page's viewport: its size in CSS pixels and the device pixel ratio (a recording keeps it: `Recording.view`). */\nexport interface Viewport {\n    readonly width: number;\n    readonly height: number;\n    readonly dpr: number;\n}\n/**\n * The framing and art resolution of a view (PixelRenderer's canvas, or a HeadlessView's viewport):\n * `computeFraming`, and the art size as a resolution. Identity is kept where nothing changed: the\n * `current` object while the art size stays, else `base` itself when the art size equals it (a\n * fixed or 16:9 view reports the preset it was given), else a new one.\n */\nexport declare function frameView(viewport: Viewport, base: Resolution, aspect: AspectMode, current: Resolution): {\n    framing: Framing;\n    resolution: Resolution;\n};\n/**\n * @param viewportWidth  viewport width in CSS pixels\n * @param viewportHeight viewport height in CSS pixels\n * @param devicePixelRatio window.devicePixelRatio\n * @param internal the art resolution (in adaptive mode: its height, and the 16:9 fallback)\n * @param aspect `fixed` (exactly `internal`), `adaptive` (art width follows the screen),\n * or `fill` (both art dimensions follow the screen, with no letterbox)\n */\nexport declare function computeFraming(viewportWidth: number, viewportHeight: number, devicePixelRatio: number, internal: Resolution, aspect?: AspectMode): Framing;\n/**\n * Size of one art pixel in world units for an orthographic camera whose visible\n * height is `viewHeight` world units. Used to snap the *camera* (never physics) to the\n * pixel grid so static geometry doesn't shimmer while the camera moves.\n */\nexport declare function worldUnitsPerPixel(viewHeight: number, internal: Resolution): number;\nexport declare function snapToGrid(value: number, step: number): number;\n=================== SettingsPanel\nimport type { Engine } from './Engine';\nimport type { TouchCorner } from './TouchControls';\n/**\n * The settings panel (DOM, like the debug panel: it stays legible at any art resolution) and the\n * ⚙ button that opens it: the player's picture, sound and engine options (`engine.settings`,\n * settings.ts; the AudioManager's volumes). The engine pauses the game while it is open. Keys\n * pressed in it never reach the game; Escape or Done closes it.\n */\nexport declare class SettingsPanel {\n    private readonly engine;\n    readonly root: HTMLDivElement;\n    readonly button: HTMLButtonElement | null;\n    private idleTimer;\n    private readonly controls;\n    private readonly outputs;\n    private readonly listeners;\n    constructor(engine: Engine, container: HTMLElement, corner: TouchCorner | false);\n    /**\n     * Show the panel with the engine's current values. The panel takes the focus, not a control: a\n     * game key pressed out of habit (D, Space) must not pick an option; Tab reaches the controls.\n     */\n    show(): void;\n    hide(): void;\n    /** Put the engine's current values into the controls, and into the debug panel (the loop fills it only while the game runs). */\n    sync(): void;\n    dispose(): void;\n}\n=================== LoadingScreen\n/**\n * Minimal pixel-styled loading indicator: a blocky segmented bar and a status word,\n * plain DOM (it shows before the renderer exists). Reuses a `.pixel-loading` element\n * already in the container (index.html ships one so it appears before any JS runs).\n */\nexport declare class LoadingScreen {\n    readonly root: HTMLElement;\n    private readonly cells;\n    private readonly label;\n    private lit;\n    constructor(container: HTMLElement, segments?: number);\n    /** `progress` 0..1; `label` is shown in capitals. */\n    set(progress: number, label?: string): void;\n    done(): void;\n}\n=================== render/lights\nimport { Color, type ColorRepresentation, Group, type Object3D, PointLight, Vector3 } from 'three/webgpu';\n/**\n * Dynamic lighting: a fixed pool of real `PointLight`s shared by any number of *light\n * requests* (torches, spells, projectiles, loot beams, glowing monsters...).\n *\n * Every light the toon material sees is part of its compiled shader, so changing the number\n * of lights recompiles every material. The pool therefore never adds or removes lights: it\n * keeps `size` lights in the scene at all times (unused ones at intensity 0) and, every\n * frame, hands them to the most important requests: intensity × priority × proximity to the\n * camera focus. Requests that hold a light get a hysteresis bonus, and every switch fades\n * (the old owner out, then the new one in), so lights never pop. Moving a light or changing\n * its colour, intensity or radius only updates uniforms: no shader work at all.\n *\n *   const torch = ctx.lights.request({ position: [3, 1.6, 4], color: 0xffa040, intensity: 6, radius: 7, flicker: 'torch' });\n *   torch.update({ intensity: 9 });          // or torch.position.set(...)\n *   torch.release();                          // fades out, frees its light\n *\n * The assignment itself is pure (`LightAssigner`, unit-tested); `LightPool` adds the\n * three.js lights, flicker and following.\n */\n/** Flicker presets: intensity multipliers over time (deterministic per request seed). */\nexport type FlickerPreset = 'none' | 'torch' | 'candle' | 'brazier' | 'pulse' | 'strobe' | 'spell';\nexport declare const FLICKER_PRESETS: readonly FlickerPreset[];\n/**\n * Intensity multiplier of a flicker preset at time `t` (seconds). Averages ~1, stays within\n * roughly 0.6..1.25 for fire so a torch never goes dark.\n */\nexport declare function flicker(preset: FlickerPreset, t: number, seed?: number): number;\n/** One request as the assigner sees it. `slot`/`level` are owned by the assigner. */\nexport interface AssignItem {\n    /** Importance this frame (≥ 0); 0 = not wanted (out of range, off). */\n    score: number;\n    /** False once released: fades out, then leaves. */\n    alive: boolean;\n    /** Seconds to fade in / out. */\n    fadeIn: number;\n    fadeOut: number;\n    /** Pool slot held, or -1. */\n    slot: number;\n    /** Shown fraction 0..1 (fades). */\n    level: number;\n}\nexport interface AssignStats {\n    /** Requests that got a slot this step. */\n    assigned: number;\n    /** Requests that lost their slot (faded to 0) this step. */\n    freed: number;\n    /** Requests wanted but waiting for a slot to fade out. */\n    waiting: number;\n}\n/**\n * Pure light assignment: `capacity` slots, many items. Each step picks the `capacity`\n * highest-scoring live items (items already holding a slot score × `hysteresis`, so two\n * similar requests don't trade a light back and forth), fades winners in and losers out,\n * and moves a slot to a new owner only once the old one has faded to 0. A fade changes a\n * level by at most `dt / fade` per step: nothing ever pops.\n */\nexport declare class LightAssigner<T extends AssignItem> {\n    /** Slot → item holding it. */\n    readonly slots: (T | null)[];\n    hysteresis: number;\n    private readonly ranked;\n    private readonly wanted;\n    constructor(capacity: number);\n    get capacity(): number;\n    /** Change the slot count (the pool's lights are rebuilt: a one-off shader recompile). */\n    resize(capacity: number, items: Iterable<T>): void;\n    /** Effective rank of an item (score with the hysteresis bonus for holders). */\n    rank(it: T): number;\n    step(dt: number, items: readonly T[]): AssignStats;\n}\nexport interface LightRequestOptions {\n    /** World position (copied). Ignored while `follow` is set (then it is `follow` + `offset`). */\n    position?: Vector3 | readonly [number, number, number];\n    /** Follow an object's world position every frame (a projectile, a monster, the hero). */\n    follow?: Object3D | null;\n    /** Offset from `follow` (world axes). */\n    offset?: readonly [number, number, number];\n    color?: ColorRepresentation;\n    /** Point light intensity at full strength (before flicker and fades). Default 4. */\n    intensity?: number;\n    /** Reach in metres (PointLight.distance: light is 0 beyond it). Default 6. */\n    radius?: number;\n    /** Distance falloff exponent (PointLight.decay; a uniform, free to change). Default 1.2. */\n    decay?: number;\n    flicker?: FlickerPreset;\n    /** Importance multiplier: the hero's light 4, a loot beam 2, a torch 1 (default). */\n    priority?: number;\n    /** Fade times in seconds (defaults 0.25 in, 0.2 out). */\n    fadeIn?: number;\n    fadeOut?: number;\n    /** Release automatically after this many seconds (spell flashes, explosions). */\n    lifetime?: number;\n    /** Optional label for debugging (`pool.describe()`). */\n    name?: string;\n}\n/** A light request. Change it freely; the pool decides whether it currently owns a real light. */\nexport interface LightHandle {\n    readonly id: number;\n    /** World position (mutable; ignored while following). */\n    readonly position: Vector3;\n    /** Colour (mutable). */\n    readonly color: Color;\n    intensity: number;\n    radius: number;\n    decay: number;\n    flicker: FlickerPreset;\n    priority: number;\n    follow: Object3D | null;\n    readonly offset: Vector3;\n    name: string;\n    /** Seconds left before auto-release (Infinity = until `release()`). */\n    lifetime: number;\n    /** Set several fields at once. */\n    update(options: LightRequestOptions): this;\n    /** Fade out and give the light back. Safe to call twice. */\n    release(): void;\n    readonly alive: boolean;\n    /** Whether it holds one of the pool's real lights right now. */\n    readonly lit: boolean;\n    /** 0..1: how much of it is shown (fades). */\n    readonly level: number;\n}\n/** Pool sizes by quality level (`QUALITY[level].lights`). */\nexport declare const LIGHT_POOL_SIZES: {\n    readonly low: 4;\n    readonly medium: 8;\n    readonly high: 16;\n};\nexport interface LightPoolOptions {\n    /** Real lights in the pool (constant: changing it recompiles materials). Default 8. */\n    size?: number;\n    /** Parent for the pool's lights (added to it). Usually the scene. */\n    parent?: Object3D;\n}\nexport interface LightPoolStats {\n    size: number;\n    requests: number;\n    lit: number;\n    /** Slot hand-overs since creation (a request got a light). */\n    assignments: number;\n    /** Requests that wanted a light but had to wait last frame. */\n    waiting: number;\n    /** Milliseconds spent in the last update (CPU). */\n    updateMs: number;\n}\n/**\n * A fixed pool of point lights shared by many requests (see the file comment). Available\n * to games as `ctx.lights` (sized by quality: low 4, medium 8, high 16), or create your\n * own with `new LightPool({ size, parent: scene })` and call `update` every frame.\n */\nexport declare class LightPool {\n    readonly group: Group<import(\"three\").Object3DEventMap>;\n    readonly lights: PointLight[];\n    private readonly requests;\n    private readonly assigner;\n    private nextId;\n    private time;\n    private assignments;\n    private waiting;\n    private updateMs;\n    private readonly tmp;\n    constructor(options?: LightPoolOptions);\n    /** Number of real lights (constant unless `resize`d). */\n    get size(): number;\n    /** Ask for a light. Returns a handle to move, recolour or release. */\n    request(options?: LightRequestOptions): LightHandle;\n    /**\n     * Assign lights for this frame. `focus` is what the camera looks at; requests further\n     * than `range` + their radius from it are not lit. Call once per rendered frame.\n     */\n    update(dt: number, focus: Vector3, range?: number): void;\n    /** Release every request at once and darken the lights (level unload). */\n    clear(): void;\n    /**\n     * Change the number of real lights. Every material using lights recompiles once, so do it\n     * rarely (a quality change), never per frame.\n     */\n    resize(size: number): void;\n    stats(): LightPoolStats;\n    /** Every live request with its score and slot (debugging, inspectors). */\n    describe(): {\n        id: number;\n        name: string;\n        score: number;\n        slot: number;\n        level: number;\n        alive: boolean;\n    }[];\n    dispose(): void;\n    private worldPosition;\n    private build;\n}\n=================== render/look\n/**\n * Looks: which filters run on which part of the picture.\n *\n * A frame has two kinds of things in it: **actors** (characters and objects: the hero,\n * monsters, townsfolk, loot, chests; anything a game tags with `setLookLayer(obj, 'actors')`)\n * and the **environment** (everything else: floors, walls, buildings, trees). A `Look` gives\n * each of them its own source and filter stack, and then runs a third stack over the whole\n * composed frame:\n *\n *   actors      → pixel art (or clean) + actor filters   ─┐\n *                                                         ├─ composed by depth ─▶ scene filters ─▶ screen\n *   environment → pixel art (or clean) + world filters   ─┘\n *\n * So a clean, full-resolution world with pixel-art characters is\n * `{ actors: { pixel: crisp }, environment: { pixel: null } }`. When both layers are the\n * same (the default: pixel art everywhere, filters on the whole scene) the renderer draws\n * the scene once, exactly as before; only a look that differs per layer pays for a second\n * scene pass. Filter parameters are uniforms, so moving a slider never rebuilds a shader.\n *\n * Everything here is plain data (unit-tested in `look.test.ts`): the renderer turns a look\n * into a node graph (`PixelRenderer.setLook`).\n */\nimport { type FilterParam } from './filters';\nimport type { LookLayer } from './lookLayer';\nexport { LOOK_LAYER_KEY, lookLayerOf, setLookLayer, type LookLayer } from './lookLayer';\n/** Where a filter stack applies: the whole composed frame, or one layer. */\nexport type LookTarget = 'scene' | LookLayer;\nexport declare const LOOK_TARGETS: readonly LookTarget[];\nexport declare const LOOK_TARGET_LABELS: Readonly<Record<LookTarget, string>>;\n/** Pixel-art rendering of a layer: the scene at the art resolution with outlines. */\nexport interface PixelLook {\n    /** Art pixels per rendered pixel: 1 = the native art resolution, 2+ = chunkier. */\n    size: number;\n    /** Silhouette (depth) outline darkening, 0..1. */\n    outline: number;\n    /** Internal crease highlight (normal edges), 0..1. Keep it weak. */\n    crease: number;\n}\n/** One filter in a stack, with its parameter values (missing ones are the defaults). */\nexport interface LookFilter {\n    id: string;\n    params?: Record<string, number>;\n}\n/** A layer's own look: its source (pixel art or clean) and its filters. */\nexport interface LayerLook {\n    /** Pixel-art settings, or null for clean full-resolution rendering. */\n    pixel: PixelLook | null;\n    filters: LookFilter[];\n}\nexport interface Look {\n    /** Filters on the composed frame (both layers). */\n    scene: LookFilter[];\n    actors: LayerLook;\n    environment: LayerLook;\n}\nexport declare const PIXEL_PARAMS: readonly FilterParam[];\nexport declare const PIXEL_PRESETS: Readonly<Record<string, Readonly<PixelLook>>>;\nexport declare const DEFAULT_PIXEL: Readonly<PixelLook>;\n/** The engine default: pixel art everywhere, no filters. */\nexport declare function defaultLook(): Look;\n/** A plain stack of filters on the whole scene (what `setFilters(ids)` means), keeping `base`'s layers. */\nexport declare function lookFromFilters(ids: readonly string[], base?: Look): Look;\n/**\n * The look a view starts with (PixelRenderer and HeadlessView alike): `look` when given, else\n * `filters` on the whole scene over pixel art with these outline strengths (`EngineOptions.edges`).\n */\nexport declare function startingLook(o: {\n    look?: Look;\n    filters?: readonly string[];\n    edges: {\n        depth: number;\n        normal: number;\n    };\n}): Look;\nexport declare function cloneLook(look: Look): Look;\n/** The filters of one target (scene stack or a layer's). */\nexport declare function lookFilters(look: Look, target: LookTarget): LookFilter[];\nexport declare function normalizePixel(raw: unknown): PixelLook | null;\n/**\n * A complete, valid look from anything (storage, the URL, an agent): unknown filters and\n * duplicates dropped (and `sceneOnly` filters from layer stacks), every parameter present\n * and clamped to its range, layers defaulted.\n */\nexport declare function normalizeLook(raw: unknown): Look;\nexport declare function looksEqual(a: Look, b: Look): boolean;\nexport declare function pixelsEqual(a: PixelLook | null, b: PixelLook | null): boolean;\n/** The layers' pixel settings when they are the same (what \"whole scene\" pixel art means), else undefined. */\nexport declare function scenePixel(look: Look): PixelLook | null | undefined;\n/** One scene render the renderer needs: the whole scene, or one layer. */\nexport interface LookSource {\n    layer: 'all' | LookLayer;\n    pixel: PixelLook | null;\n    /** Filters of this source before composing (empty for `all`). */\n    filters: LookFilter[];\n}\nexport interface LookPlan {\n    /** Two scene passes (actors and environment) composed by depth. */\n    split: boolean;\n    sources: LookSource[];\n    /** Filters on the composed frame. */\n    scene: LookFilter[];\n    /**\n     * What decides the node graph: pixel on/off per source and the filter ids in order.\n     * Parameter values and pixel sizes are uniforms and stay out of it.\n     */\n    key: string;\n}\n/**\n * What a look needs from the renderer. One scene pass when both layers look the same\n * (same pixel settings, no per-layer filters), two otherwise.\n */\nexport declare function planLook(look: Look): LookPlan;\n/** Filter ids active in a target (setActive side effects such as the PS1 wobble). */\nexport declare function activeIds(look: Look, target: LookTarget): string[];\n/**\n * Named looks: the default (`none`: pixel art, no filters), `no_filters` (nothing at all:\n * full resolution, no pixel art, no outlines, no filters), every plain filter stack\n * (`FILTER_PRESETS`) as a whole-scene look, then looks that mix layers and stacks.\n */\nexport declare const LOOK_PRESETS: Readonly<Record<string, Look>>;\n/** Names looks used to have (stored settings, links): `hd_clean` is `no_filters` now. */\nexport declare const LOOK_ALIASES: Readonly<Record<string, string>>;\n/** The `LOOK_PRESETS` name a name means (aliases resolved), or null when there is none. */\nexport declare function lookPresetName(name: string): string | null;\n/** How a menu shows a look's name: `none` is the default, underscores are spaces. */\nexport declare function lookPresetLabel(name: string): string;\n/** The preset name a look matches, or null (custom). */\nexport declare function lookPresetOf(look: Look): string | null;\n/**\n * The parameter preset a filter's values match, or null (custom). A preset sets its own\n * keys and the defaults for the rest; strength (`amount`) only counts when the preset sets it,\n * so a half-strength \"heavy\" is still \"heavy\".\n */\nexport declare function filterPresetOf(presets: Readonly<Record<string, Readonly<Record<string, number>>>>, defaults: Record<string, number>, values: Record<string, number>): string | null;\n/** Parameter values of a filter in a look (defaults filled in). */\nexport declare function paramsOf(f: LookFilter): Record<string, number>;\n/** Canonical position of a filter (the order of FILTERS), so stacks edited by a UI stay in a sensible order. */\nexport declare function filterOrder(id: string): number;\n","numLines":691,"startLine":1,"totalLines":691}},"tool_result_meta":[{"id":"toolu_0131ebrX9ZbkFhEJerPG1NtG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
