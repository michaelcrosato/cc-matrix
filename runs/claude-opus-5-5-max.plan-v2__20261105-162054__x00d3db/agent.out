] }], [10, { ArmR: [0, 0, 150] }], [20, { ArmR: [0, 0, 120] }]] } ];\nconsole.log(ok());\nconsole.log('validate', CLIPS.map((c) => validateClip(c, RIG)));\nconst b = buildModel(def, { catalog: new ModelCatalog([...MODEL_LIBRARY.all(), def]) });\nconst clips = compileClips(CLIPS, RIG, b.object);\nconst rest = new Map(); b.object.traverse((o) => { if (RIG.joints.includes(o.name)) rest.set(o.name, o.quaternion.clone()); });\nconst an = new Animator(b.object, clips, rest, { rig: RIG });\nan.play({ name: 'Idle' }, 0.1); an.update(0.1);\nan.play({ name: 'Wave' }, 0.2);\nfor (let i = 0; i < 30; i++) an.update(1 / 60);\nconst arm = b.object.getObjectByName('ArmR');\nconsole.log('animator mix', an.mix().map((m) => [m.name, +m.weight.toFixed(2)]), 'armR quat z', arm.quaternion.z.toFixed(3));\nEOF\nesbuild src/main.js --bundle --format=esm --target=esnext --log-level=warning --external:./pixel-engine.js --outfile=src/out.mjs && grep -n \"pixel-engine.js\" src/out.mjs | head -5; wc -c src/out.mjs; cd src && node out.mjs 2>&1 | cut -c1-300 | tail -8; cd $W/proto; C='%7B%22preset%22:%22iso%22,%22yaw%22:45,%22pitch%22:35,%22zoom%22:1.3%7D'; timeout 100 python3 shot.py \"file://$W/proto/out/proto.html\" shots \"{\\\"v_city_bloom\\\":\\\"?cam=$C&scene=city&filters=bloom\\\"}\" 2>&1 | cut -c1-140 | tail -3; grep -n \"\\\"id\\\": *\\\"bloom\\\"\\|id: .bloom\" -n $K/API.md | head; grep -n \"bloom\" $K/API.md | cut -c1-220 | head -6","description":"Test nested imports with an external engine, the Animator on a custom rig, and city bloom","timeout":150000}}}
