lide over a few hundredths of a second (no clicks). */\n    set(s: VoiceSettings): void;\n    stop(): void;\n}\n/** Low-pass cutoff (Hz) for a muffle of 0..1: wide open to a dull thud. */\nexport declare const muffleCutoff: (muffle: number) => number;\n/**\n * Web Audio for games: procedural retro sound effects (`SFX`, data), a small chiptune\n * sequencer (`Song`, data), optional audio files, and master / sfx / music volume + mute\n * persisted in localStorage. Available as `ctx.audio`.\n *\n * Browsers only allow sound after a user gesture, so the AudioContext is created on the\n * first key / pointer / touch input. Before that, and wherever Web Audio does not exist\n * (headless tests, old browsers), every call is a silent no-op that still records what\n * was played in `log`, so games behave identically and tests can assert on sounds.\n */\nexport declare class AudioManager {\n    /** Sound registry: the built-in SFX plus anything registered or loaded. */\n    readonly sounds: Map<string, SoundDef>;\n    /** The most recent plays (name and game-independent wall time), newest last; tooling/tests. */\n    readonly log: {\n        name: string;\n        at: number;\n    }[];\n    /** How many times each sound was requested. */\n    readonly counts: Record<string, number>;\n    context: AudioContext | null;\n    private master;\n    private buses;\n    private readonly settings;\n    private readonly buffers;\n    private readonly files;\n    private readonly pendingFiles;\n    private unlockListeners;\n    private readonly lifetime;\n    private song;\n    private songName;\n    private readonly musicSources;\n    private readonly voices;\n    /** Files being fetched or decoded (a loop waiting for one is not missing its sound). */\n    private readonly loading;\n    private disposed;\n    constructor(target?: EventTarget | null);\n    /** Web Audio exists in this environment. */\n    static get supported(): boolean;\n    /** True once the AudioContext is running (after the first user input). */\n    get unlocked(): boolean;\n    /** Current volumes and mute (persisted). */\n    get volume(): Readonly<AudioSettings>;\n    get muted(): boolean;\n    /** Name of the playing song ('' when none). */\n    get playing(): string;\n    /**\n     * Create / resume the AudioContext. Called automatically on the first user input; call\n     * it yourself from a click handler if you start sound from your own UI.\n     */\n    unlock(): void;\n    private target;\n    /** Listen for the next user input (until the context is running). */\n    private armUnlock;\n    private disarmUnlock;\n    /** Resume a suspended / interrupted context; stop listening for input once it runs. */\n    private resume;\n    /** Add or replace a sound effect (data, see SoundDef). */\n    register(name: string, def: SoundDef): void;\n    /**\n     * Play a sound effect by name (built-in SFX, `register`ed or `load`ed) or directly from a\n     * SoundDef. Returns false when nothing could be heard (locked, muted, no Web Audio).\n     */\n    play(sound: string | SoundDef, options?: PlayOptions): boolean;\n    /**\n     * Start a sound looping, as a voice you steer while it plays (volume, pan, muffle, pitch:\n     * with `spatialize` it sits at a place in the world). Before the first user input, or with\n     * no Web Audio, the voice keeps its settings silently and starts once audio unlocks.\n     * Stop it when you are done (a level's `dispose`).\n     */\n    loop(sound: string | SoundDef, settings?: VoiceSettings): Voice;\n    /** Voices playing or waiting to (tooling and tests). */\n    get loops(): readonly Voice[];\n    /** Stop every looping voice (the engine does this when a level unloads). */\n    stopLoops(): void;\n    /**\n     * Load an audio file (wav/ogg/mp3…) under `name`; `play(name)` then plays it. Works\n     * before the first user input too: the file is decoded once audio unlocks.\n     */\n    load(name: string, url: string): Promise<void>;\n    /** Start a song (looping by default), replacing the current one. `null` stops music. */\n    playMusic(song: Song | null, name?: string): void;\n    stopMusic(): void;\n    /**\n     * Volume changes are written to storage. The engine turns this off while a replay plays: the\n     * recording sets the volumes it set, nothing is written, and the player's come back after.\n     */\n    persist: boolean;\n    setVolume(channel: VolumeChannel, value: number): void;\n    setMuted(muted: boolean): void;\n    toggleMute(): boolean;\n    /** The default volumes, sound on (the settings panel's Reset). */\n    resetVolumes(): void;\n    /** Engine: once per rendered frame. Schedules the next notes of the song. */\n    update(): void;\n    /** Stop everything and close the AudioContext. */\n    dispose(): void;\n    private start;\n    private bufferFor;\n    private toBuffer;\n    private decode;\n    private applyVolumes;\n}\n=================== audio/music\nimport { type SoundDef } from './synth';\n/** A track's instrument: a SoundDef without pitch or length (each note sets those). */\nexport type Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>;\n/**\n * A chiptune song as data. Each pattern holds one string per track: space-separated steps,\n * where a step is a note ('C4', 'F#5', 'Bb2'), '.' (rest) or '-' (hold the previous note).\n * Every track of a pattern must have the same number of steps. For `noise` tracks the\n * note's pitch is the noise rate: C6 is a snare-ish hiss, C8 a hi-hat tick.\n */\nexport interface Song {\n    bpm: number;\n    /** Steps per beat (4 = sixteenth notes). Default 4. */\n    stepsPerBeat?: number;\n    tracks: Record<string, Instrument>;\n    patterns: Record<string, Record<string, string>>;\n    /** Pattern names in play order. */\n    order: readonly string[];\n    /** Loop forever (default true). */\n    loop?: boolean;\n}\nexport interface SongNote {\n    track: string;\n    /** Step index from the start of the song. */\n    step: number;\n    /** Length in steps (1 + following holds). */\n    steps: number;\n    freq: number;\n}\nexport interface ParsedSong {\n    /** Seconds per step. */\n    stepTime: number;\n    /** Total steps in one pass of `order`. */\n    length: number;\n    notes: SongNote[];\n}\n/** Flatten a song into timed notes. Throws on malformed patterns, so tests catch typos. */\nexport declare function parseSong(song: Song): ParsedSong;\n/** The playable SoundDef for one note of a track. */\nexport declare function noteSound(instrument: Instrument, freq: number, seconds: number): SoundDef;\n/** The playground's short looping track: C major, bouncy, 2 × 16 steps. */\nexport declare const PLAYGROUND_SONG: Song;\n=================== audio/synth\n/**\n * Retro sound synthesis as pure functions (no Web Audio): a sound is data (`SoundDef`)\n * rendered to samples once, then played as a buffer. Deterministic (seeded noise), so\n * sounds are unit-testable and identical on every machine.\n */\nexport type Wave = 'square' | 'triangle' | 'saw' | 'sine' | 'noise';\nexport interface SoundDef {\n    wave: Wave;\n    /** Start pitch in Hz. For `noise` it is the sample-and-hold rate (higher = hissier). */\n    freq: number;\n    /** End pitch for a sweep (exponential glide from `freq`). */\n    freqEnd?: number;\n    /** Seconds the sweep takes (default: the whole sound). */\n    sweepTime?: number;\n    /** Square duty cycle: 0.125, 0.25 or 0.5 are the classic NES widths. Default 0.5. */\n    duty?: number;\n    /** Envelope (seconds): ramp up, hold at full volume, then fade out. */\n    attack?: number;\n    sustain?: number;\n    decay?: number;\n    /** Peak level 0..1 (default 0.5). */\n    volume?: number;\n    /** Arpeggio: semitone offsets stepped every `arpRate` seconds (the coin \"ba-ding\"). */\n    arp?: readonly number[];\n    arpRate?: number;\n    /** Vibrato depth in semitones and rate in Hz. */\n    vibrato?: {\n        depth: number;\n        rate: number;\n    };\n    /** Quantize to this many levels (4-bit style crunch). 0 = off. */\n    crush?: number;\n    /** Seconds of silence before the sound starts (for layers). */\n    delay?: number;\n    /** Extra sounds mixed in (e.g. a noise burst under a thump). */\n    layers?: readonly SoundDef[];\n}\n/** Seconds a sound lasts, including delays and layers. */\nexport declare function soundDuration(def: SoundDef): number;\n/** Envelope gain 0..1 at time `t` (seconds since the sound's own start). */\nexport declare function envelope(def: SoundDef, t: number): number;\n/** Instantaneous frequency (Hz) at time `t`: sweep, arpeggio and vibrato applied. */\nexport declare function frequencyAt(def: SoundDef, t: number): number;\n/** Small deterministic PRNG (mulberry32). */\nexport declare function rng(seed?: number): () => number;\n/** Render a sound to mono samples in -1..1. */\nexport declare function renderSound(def: SoundDef, sampleRate?: number, seed?: number): Float32Array<ArrayBuffer>;\n/** 'A4' → 440, 'C#5', 'Eb3'… Returns null for anything that is not a note. */\nexport declare function noteFrequency(note: string): number | null;\n=================== audio/sfx\n/**\n * Built-in retro sound effects, as data. Tweak numbers here (or register your own with\n * `ctx.audio.register(name, def)`) and every `ctx.audio.play(name)` picks them up.\n * See docs/engine/audio.md for the SoundDef fields.\n */\nexport declare const SFX: {\n    /** Short rising square chirp. */\n    jump: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Higher, thinner chirp with a fifth on top. */\n    doubleJump: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Soft thud: a falling triangle under a short noise puff. */\n    land: {\n        wave: \"triangle\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"noise\";\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** The classic two-note pickup (B5 → E6). */\n    coin: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** A tiny tick per footstep. */\n    step: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n    };\n    /** Shoe squeal: hissy noise plus a wobbling high square. */\n    skid: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"square\";\n            duty: number;\n            freq: number;\n            freqEnd: number;\n            vibrato: {\n                depth: number;\n                rate: number;\n            };\n            attack: number;\n            sustain: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Whack: noise burst over a dropping square. */\n    punch: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"square\";\n            duty: number;\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Big low boom for the ground-pound impact. */\n    groundPound: {\n        wave: \"triangle\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n        crush: number;\n        layers: {\n            wave: \"noise\";\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Spin-up whoosh before the pound falls. */\n    whoosh: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n    };\n    /** Descending, wobbly \"ouch\". */\n    hurt: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        vibrato: {\n            depth: number;\n            rate: number;\n        };\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Victory fanfare arpeggio. */\n    fanfare: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n};\nexport type SfxName = keyof typeof SFX;\n=================== audio/spatial\n/**\n * Sound in space: how loud and how far left or right a sound at a point is for a listener\n * (the camera, or the hero's ears). Pure maths, so it is unit-tested and the same in a\n * headless run; `AudioManager.loop()` voices take the result.\n *\n *   const hum = ctx.audio.loop('hum');\n *   const s = spatialize({ position: ears, right: cameraRight }, generator.position, { ref: 2, max: 25 });\n *   hum.set({ volume: s.gain * (blocked ? 0.4 : 1), pan: s.pan, muffle: blocked ? 0.8 : 0 });\n */\nexport type V3Like = readonly [number, number, number] | {\n    readonly x: number;\n    readonly y: number;\n    readonly z: number;\n};\nexport interface Listener {\n    position: V3Like;\n    /** The listener's right, in world space (unit): the camera's right for a third-person game. */\n    right: V3Like;\n}\nexport interface SpatialOptions {\n    /** Within this distance (m) the sound is at full volume (default 1). */\n    ref?: number;\n    /** Silent from this distance on (default 30); it fades out over the last fifth. */\n    max?: number;\n    /** How fast it falls off past `ref` (default 1: inverse distance, the way sound really does). */\n    rolloff?: number;\n}\nexport interface Spatial {\n    /** 0..1 volume. */\n    gain: number;\n    /** -1 (left) .. 1 (right). */\n    pan: number;\n    distance: number;\n}\n/** Volume at `distance` (m): 1 inside `ref`, then inverse distance, fading to 0 at `max`. */\nexport declare function attenuation(distance: number, o?: SpatialOptions): number;\n/** Gain and pan of a sound at `at` for `listener`. */\nexport declare function spatialize(listener: Listener, at: V3Like, o?: SpatialOptions): Spatial;\n=================== palette\n/**\n * Restrained 16-color palette (Sweetie 16 by GrafxKid). Every color in a game should come\n * from here: authentic pixel art reads as \"designed\" because the palette is small.\n * Keep in sync with scripts/generate-assets.mjs.\n */\nexport declare const PALETTE: {\n    readonly ink: 1711148;\n    readonly plum: 6104925;\n    readonly red: 11615827;\n    readonly orange: 15695191;\n    readonly sand: 16764277;\n    readonly lime: 11006064;\n    readonly green: 3716964;\n    readonly teal: 2453881;\n    readonly navy: 2700911;\n    readonly blue: 3890633;\n    readonly sky: 4302582;\n    readonly cyan: 7598071;\n    readonly white: 16053492;\n    readonly mist: 9744578;\n    readonly slate: 5663878;\n    readonly night: 3357783;\n};\nexport type PaletteColor = keyof typeof PALETTE;\n/** Whether a value names a PALETTE colour. */\nexport declare const isPaletteName: (v: unknown) => v is PaletteColor;\n=================== render/sky\n/**\n * Time of day: a sun that rises in the east, crosses the sky and sets in the west, warm at\n * dawn and dusk, a dim blue moon at night, with the ambient light, the sky colour and the fog\n * colour following. `skyAt(hour)` is pure (keyframes interpolated, unit-tested); `applySky`\n * puts it on an engine (the sun, its direction and shadows, the ambient light, the\n * background). Levels unload back to the engine's defaults.\n *\n *   const s = skyAt(18.5);                 // 0..24\n *   applySky(engine, s);                   // or read s.night to light the lanterns\n */\nimport { Color, type Node } from 'three/webgpu';\nimport type { Engine } from '../Engine';\nexport interface SkyState {\n    /** Unit vector toward the sun (or the moon, at night). */\n    readonly sunDir: [number, number, number];\n    readonly sunColor: number;\n    readonly sunIntensity: number;\n    readonly ambientColor: number;\n    readonly ambientIntensity: number;\n    /** Background (sky) and fog colour. */\n    readonly sky: number;\n    /** 0 by day, 1 deep at night: lanterns, stars, windows. */\n    readonly night: number;\n}\n/** The sky at `hour` (wraps around 24). */\nexport declare function skyAt(hour: number): SkyState;\n/** Put a sky on the engine: sun direction, colour and strength, ambient light, background. */\nexport declare function applySky(engine: Pick<Engine, 'sun' | 'ambient' | 'scene' | 'setSunDirection'>, s: SkyState): void;\n/**\n * Fog for `scene.fogNode` with live settings (uniforms: changing them never recompiles):\n * ground mist that thickens below `top` (m) and a haze that grows with distance from the\n * camera, both up to `amount` (0..1), in `color` (match the sky).\n *\n *   const mist = groundFog({ color: s.sky, top: 1.5 });\n *   (scene as { fogNode: unknown }).fogNode = mist.node;\n *   mist.amount.value = 0.8; mist.color.value.setHex(s.sky);\n */\nexport declare function groundFog(o?: {\n    color?: number;\n    top?: number;\n    amount?: number;\n    near?: number;\n    far?: number;\n}): {\n    node: Node;\n    color: import(\"three/webgpu\").UniformNode<\"color\", Color>;\n    amount: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    top: import(\"three/webgpu\").UniformNode<\"float\", number>;\n};\n=================== render/precipitation\n/**\n * Rain and snow: thousands of drops or flakes in one instanced draw, placed entirely by the\n * vertex shader. Each drop's start comes from a hash of its instance index; it falls through a\n * box of air around a centre (the camera's focus) whose x and z wrap in world space, so walking\n * through the weather doesn't drag the drops sideways (the box's height follows the centre). Rain falls fast and slants with the wind; snow\n * drifts and sways. `intensity` (0..1) shows that share of the drops: no buffers change, no\n * shader recompiles. Splashes are left to the game (`splashes(dt)` says how many this frame).\n *\n *   const rain = new Precipitation({ kind: 'rain', count: 3000, area: [24, 14, 24] });\n *   scene.add(rain);\n *   // per frame: rain.update(dt, camera.focus); rain.intensity = 0.7; rain.wind.set(3, 0)\n */\nimport { InstancedMesh, Vector2, Vector3 } from 'three/webgpu';\nexport type PrecipitationKind = 'rain' | 'snow';\nexport interface PrecipitationOptions {\n    kind: PrecipitationKind;\n    /** Most drops at once (the instance count). */\n    count: number;\n    /** Width, height and depth of the air the drops fall through, around the centre. */\n    area?: readonly [number, number, number];\n    /** Drop colour (hex). */\n    color?: number;\n    /** Fall speed (m/s). Rain 16, snow 1.4. */\n    speed?: number;\n}\nexport declare class Precipitation extends InstancedMesh {\n    readonly kind: PrecipitationKind;\n    readonly area: readonly [number, number, number];\n    /** Wind (m/s along x and z): rain slants, snow drifts. */\n    readonly wind: Vector2;\n    private readonly uTime;\n    private readonly uCenter;\n    private readonly uWind;\n    private readonly uIntensity;\n    private readonly uSpeed;\n    private t;\n    constructor(o: PrecipitationOptions);\n    /** Share of the drops falling (0..1). */\n    get intensity(): number;\n    set intensity(v: number);\n    /** Fall speed (m/s). */\n    get speed(): number;\n    set speed(v: number);\n    /** Per frame (game time): advance the fall and follow `center`. */\n    update(dt: number, center: Vector3): void;\n    /** How many drops hit the ground in `dt` seconds at this intensity (for splash particles, ripples). */\n    splashes(dt: number): number;\n    dispose(): this;\n}\n=================== render/grass\n/**\n * A meadow: thousands of grass blades in one instanced draw, bent by the vertex shader. Wind\n * leans every blade and sends gusts across the field as visible waves; up to four pushers\n * (the hero, a ball) part and flatten the blades around them. Blades are two crossed\n * triangles (they read from any side), toon-lit as if they were the ground (an up normal), so\n * they take the same light bands and shadows as the floor they stand on.\n *\n *   const grass = new GrassField({ area: [12, 8], at: [0, 0, 0], count: 6000 });\n *   scene.add(grass);\n *   // per frame: grass.update(t); grass.push(0, hero.position, 0.9)\n *   grass.wind.set(2.5, 0.5);       // m/s-ish: direction and strength\n */\nimport { InstancedMesh, Vector2, type Vector3Like } from 'three/webgpu';\nexport declare const MAX_PUSHERS = 4;\nexport interface GrassOptions {\n    /** Width (x) and depth (z) of the patch, m. */\n    area: readonly [number, number];\n    /** Centre of the patch on the ground. */\n    at: readonly [number, number, number];\n    count: number;\n    /** Blade heights (m): shortest and tallest. Default [0.25, 0.55]. */\n    height?: readonly [number, number];\n    /** Blade width at the root (m). Default 0.07. */\n    width?: number;\n    /** Colours (hex): roots and tips. */\n    base?: number;\n    tip?: number;\n    /** Where blades grow (world x, z); default everywhere in the patch. */\n    mask?: (x: number, z: number) => boolean;\n    /** Ground height under a blade (default: the patch's y). */\n    ground?: (x: number, z: number) => number;\n    seed?: number;\n}\nexport declare class GrassField extends InstancedMesh {\n    /** Wind along x and z (its length is the strength). */\n    readonly wind: Vector2;\n    /** How far blades lean per unit of wind (m at the tip). Default 0.12. */\n    sway: number;\n    private readonly uTime;\n    private readonly uWind;\n    private readonly uSway;\n    private readonly uPush;\n    /** Blades actually placed (the mask can leave fewer than `count`). */\n    readonly blades: number;\n    constructor(o: GrassOptions);\n    /** Pusher `i` (0..3): blades within `radius` of `at` part and flatten (radius 0: none). */\n    push(i: number, at: Vector3Like | null, radius?: number): void;\n    /** Per frame (game time). */\n    update(time: number): void;\n    dispose(): this;\n}\n=================== render/mirror\n/**\n * A flat mirror: before each frame a camera reflected in the mirror's plane draws the scene\n * into a texture at the art resolution, and the glass shows it at each pixel's screen position\n * (mirrored left to right), so the reflection lines up from wherever the camera looks. An\n * oblique near plane (Lengyel) on that camera cuts away everything behind the glass; it works\n * for orthographic cameras (the iso view) as well as perspective ones.\n *\n *   const mirror = new Mirror({ size: [8, 3] });\n *   mirror.mesh.position.set(0, 1.8, -6.9);              // the glass faces its local +z\n *   scene.add(mirror.mesh);\n *   const stop = mirror.attach(engine.renderer, scene);  // renders before each frame\n *\n * The glass is on `SCREEN_LAYER`, so neither it nor other screens appear in the reflection.\n */\nimport { type Camera, Mesh, Plane, RenderTarget, type Scene, type WebGPURenderer } from 'three/webgpu';\nimport type { View } from './view';\nexport interface MirrorOptions {\n    /** Width and height of the glass (m). Default [4, 2]. */\n    size?: readonly [number, number];\n    /** A colour the reflection leans toward, and how much (0..1). Default a faint blue, 0.15. */\n    tint?: number;\n    tintAmount?: number;\n}\n/**\n * Set `virtual` to `camera` reflected in `plane` (world space, its normal toward the side that\n * is seen): the position, the way it looks and its up reflected (a proper rotation: the picture\n * comes out mirrored left to right), and an oblique near plane on the mirror plane, so nothing\n * behind it is drawn. Orthographic or perspective, either depth range. Returns `virtual`.\n */\nexport declare function mirrorCamera<T extends Camera>(camera: Camera, virtual: T, plane: Plane): T;\nexport declare class Mirror {\n    readonly mesh: Mesh;\n    readonly target: RenderTarget;\n    /** False: the glass shows plain glass and nothing is rendered for it. */\n    enabled: boolean;\n    /** Times it has rendered. */\n    renders: number;\n    private virtual;\n    private readonly material;\n    private readonly on;\n    constructor(o?: MirrorOptions);\n    /**\n     * Reflect `camera` in the glass and draw `scene` from there into the texture (sized\n     * `width` x `height`, the art resolution). Skipped when the camera is behind the glass.\n     */\n    render(renderer: WebGPURenderer, scene: Scene, camera: Camera, width: number, height: number): boolean;\n    /**\n     * Render before every frame of `view` (`engine.renderer`), from its camera, at its art size.\n     * Returns a stop. Headless the hook is kept and never runs (nothing is drawn).\n     */\n    attach(view: View, scene: Scene): () => void;\n    dispose(): void;\n}\n=================== render/toon\nimport { type ColorRepresentation, DataTexture, MeshBasicNodeMaterial, MeshToonNodeMaterial, type Object3D, type Texture, Vector2 } from 'three/webgpu';\n/**\n * PS1-style vertex snapping (\"wobble\"): clip-space vertices snap to the internal pixel\n * grid. Off by default; the `ps1` filter switches it on (PixelRenderer drives these).\n */\nexport declare const vertexSnap: {\n    enabled: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    /** Internal resolution (art pixels). */\n    resolution: import(\"three/webgpu\").UniformNode<\"vec2\", Vector2>;\n};\n/**\n * The toon materials' vertex stage (clip position, snapped to the art grid while the `ps1`\n * filter is on). Exported so procedural toon materials (`colorNode` from attributes) keep\n * the same wobble as every other toon material.\n */\nexport declare function snappedClipPosition(): import(\"three/webgpu\").VarNode<\"vec4\", import(\"three/webgpu\").JoinNode<\"vec4\">>;\n/**\n * 3-band toon ramp (shadow / mid / lit). Sampled with NearestFilter so light falls\n * off in hard bands, the way hand-shaded sprites look. Values are 0..255 intensity.\n */\nexport declare const TOON_BANDS: readonly [96, 176, 255];\nexport declare function toonGradient(): DataTexture;\nexport interface ToonMaterialOptions {\n    /** Base color texture. Switched to nearest filtering (crisp texels, no mip blur). */\n    map?: Texture | null;\n    /** Multiply by the geometry's `color` attribute (vertex colors). */\n    vertexColors?: boolean;\n    /**\n     * A hard-banded rim light in this colour (hex) on grazing, upward-facing surfaces: a\n     * silhouette that reads against dark floors (monsters in dark levels). Added to the\n     * emissive, so `material.emissive` (hit flashes) still works on top. Same shader for\n     * every rim colour (the colour is a uniform).\n     */\n    rim?: number;\n    /**\n     * Pixel dissolve: the material reads its own `dissolve` property (0 = solid, 1 = gone)\n     * and discards a per-art-pixel noise pattern below it, with a 1-pixel glowing front in\n     * the rim colour (or white). Set it on per-body clones (`material.dissolve = 0.4`), not on\n     * the shared cached material.\n     */\n    dissolve?: boolean;\n}\n/** A toon material made with `dissolve: true` has this property. */\nexport type DissolvableMaterial = MeshToonNodeMaterial & {\n    dissolve: number;\n};\n/**\n * Make a texture pixel-art friendly: nearest-neighbor sampling, no mipmaps. Returns it.\n */\nexport declare function pixelTexture<T extends Texture>(texture: T): T;\n/**\n * Shared 3-band toon node material for a palette color, optionally textured and/or\n * vertex-colored (color × map × vertex color), cached per combination. Untextured ones\n * (and ones whose texture is itself shared, e.g. from a cached GLB) are marked\n * `userData.shared`, so level unloads keep them; a material with a level's own texture is\n * disposed with the level, and disposing it drops it from the cache.\n */\nexport declare function toonMaterial(color: ColorRepresentation, options?: ToonMaterialOptions): MeshToonNodeMaterial;\n/**\n * Unlit, full-bright material for a colour (flames, eyes, screens, crystal cores), shared and\n * cached per colour like `toonMaterial` (`userData.shared`; disposing it drops it from the\n * cache). Its vertices snap with the toon materials' under the `ps1` filter, so a glowing part\n * stays on its model.\n */\nexport declare function glowMaterial(color:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bm2rkhaay.txt","persistedOutputSize":30493},"tool_result_meta":[{"id":"toolu_01HfFHrjDmzSWrxEcHfgrEpZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
