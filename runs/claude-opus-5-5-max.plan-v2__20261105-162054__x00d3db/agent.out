{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tt11hdRwAxY6Dhb2EbGihe","type":"tool_result","content":"=================== hud/Hud\nimport type { Framing, Resolution } from '../framing';\nimport { type PaletteColor } from '../palette';\n/** Where an element is attached on screen; it is also aligned that way (right-anchored text grows left). */\nexport type HudAnchor = 'top-left' | 'top' | 'top-right' | 'left' | 'center' | 'right' | 'bottom-left' | 'bottom' | 'bottom-right';\nexport type HudColor = PaletteColor | number;\nexport interface HudOptions {\n    /** Default 'white'. */\n    color?: HudColor;\n    /** 1-pixel drop shadow color, or false. Default 'ink'. */\n    shadow?: HudColor | false;\n    /** Integer art-pixel scale (2 = double-size glyphs). Default 1. */\n    scale?: number;\n    /** Default 'top-left': x/y are offsets from that screen corner/edge, in art pixels. */\n    anchor?: HudAnchor;\n}\n/**\n * Pixel HUD: crisp text and icons drawn in art pixels on top of the game, never through\n * the post filters. It is a 2D canvas at the internal resolution (480×270 / 320×180),\n * laid over the game canvas with the same integer scale and letterbox offset\n * (`framing.ts`), so one HUD pixel is exactly one art pixel at every resolution.\n *\n * Retained: what you add stays on screen until `clear()`. Redraw everything each frame\n * (clear + add) or only when something changes; the canvas repaints only when the content,\n * resolution or framing changed. Available as `ctx.hud`.\n *\n *   ctx.hud.clear();\n *   ctx.hud.text(4, 4, `COINS ${n}/12`, { color: 'sand' });\n *   ctx.hud.text(4, 4, 'PAUSED', { anchor: 'center', scale: 2 });\n */\nexport declare class Hud {\n    private readonly container;\n    /** The overlay canvas (created on the first draw; null when nothing was ever drawn). */\n    canvas: HTMLCanvasElement | null;\n    visible: boolean;\n    private items;\n    private drawn;\n    private size;\n    private layoutKey;\n    constructor(container: HTMLElement | null);\n    /** HUD width/height in art pixels (the internal resolution). */\n    get width(): number;\n    get height(): number;\n    /** Text in the 5×7 bitmap font (uppercase; digits and common punctuation). */\n    text(x: number, y: number, text: string, options?: HudOptions): void;\n    /** A filled rectangle (panels, bars). */\n    rect(x: number, y: number, w: number, h: number, color: HudColor, anchor?: HudAnchor): void;\n    /**\n     * A tiny pixel-art icon as data: one string per row, one character per pixel, mapped\n     * through `colors` ('.' or ' ' = transparent).\n     *\n     *   hud.sprite(4, 4, ['.yy.', 'ywyy', 'yyyy', '.yy.'], { y: 'sand', w: 'white' });\n     */\n    sprite(x: number, y: number, rows: readonly string[], colors: Record<string, HudColor>, options?: HudOptions): void;\n    /** Remove everything. */\n    clear(): void;\n    /** Size of `text` in art pixels at `scale`. */\n    measure(text: string, scale?: number): {\n        width: number;\n        height: number;\n    };\n    /** Engine: follow the renderer's resolution and framing, and repaint if needed. */\n    sync(resolution: Resolution, framing: Framing): void;\n    dispose(): void;\n    private createCanvas;\n    private paint;\n    private glyphs;\n    private place;\n}\n/**\n * Top-left corner, in whole art pixels, of a w×h element placed at offset (x, y) from\n * `anchor` on a screen of `size` art pixels. Pure (unit-tested).\n */\nexport declare function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number];\n=================== input\n/**\n * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n */\nexport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\nexport interface GamepadLike {\n    readonly connected?: boolean;\n    readonly mapping?: string;\n    readonly axes: readonly number[];\n    readonly buttons: readonly {\n        readonly pressed: boolean;\n        readonly value?: number;\n    }[];\n}\n/**\n * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n * direction is kept (no square-gate snapping to the axes).\n */\nexport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n    x: number;\n    y: number;\n};\n/** How long a queued press stays consumable, in seconds of game time. */\nexport declare const PRESS_WINDOW = 0.15;\n/**\n * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n * from the frame before.\n */\nexport interface InputFrame {\n    /** Real seconds this frame lasted (game time follows from it). */\n    dt: number;\n    /** Keys held, keyboard and gamepad buttons together, sorted. */\n    held?: string[];\n    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n    pressed?: string[];\n    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n    analog?: [number, number];\n    pad?: [number, number];\n    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n    delta?: [number, number];\n    wheel?: number;\n    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n    pointer?: [number, number, number, number];\n    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n    gamepad?: boolean;\n    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n    touch?: boolean;\n    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n    clicks?: [string, 0 | 1, number, number][];\n    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n    commands?: unknown[];\n    /**\n     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n     * callbacks ran between them. A replay waits for them before every other frame.\n     */\n    sync?: true;\n}\n/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\nexport interface InputState {\n    readonly held: readonly string[];\n    /** Queued presses: [key, seconds of game time since it was pressed]. */\n    readonly queued: readonly (readonly [string, number])[];\n    readonly pointer: readonly [number, number, number, number];\n    readonly gamepad: boolean;\n    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n    readonly outbox: readonly unknown[];\n}\n/** What the frame before held, for `snapshot()` to leave out what did not change. */\nexport interface SnapshotMemory {\n    held: string;\n    pointer: string;\n    gamepad?: boolean;\n    touch?: boolean;\n}\n/**\n * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n */\nexport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\nexport declare const TOUCH_KEY = \"Touch\";\n/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\nexport interface ButtonEvent {\n    readonly code: string;\n    readonly down: boolean;\n    readonly x: number;\n    readonly y: number;\n}\n/**\n * Keyboard + pointer + gamepad input.\n * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n *   right stick feeds the pointer delta (camera look), buttons press key codes\n *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n *   a frame is not lost.\n * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n *   and recorded with it.\n * - `dispose()` removes every listener it added.\n */\nexport declare class Input {\n    private readonly target;\n    private readonly held;\n    private readonly pressed;\n    /** Queued presses → the game time they happened at. */\n    private readonly queued;\n    /** Keys held through gamepad buttons (merged into isDown). */\n    private readonly padHeld;\n    private readonly listeners;\n    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n    readonly mouseDelta: {\n        x: number;\n        y: number;\n    };\n    /**\n     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n     * Under pointer lock it is the screen's centre (the crosshair).\n     */\n    readonly pointer: {\n        x: number;\n        y: number;\n        over: boolean;\n        touch: boolean;\n    };\n    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n    wheel: number;\n    /** This frame's button presses and releases, in order (`buttonEvents`). */\n    private _buttonEvents;\n    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n    private outbox;\n    private _commands;\n    private lockTarget;\n    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n    wantsPointerLock: boolean;\n    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n    readonly analog: {\n        x: number;\n        y: number;\n    };\n    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n    readonly padAxis: {\n        x: number;\n        y: number;\n    };\n    /** True while any gamepad is connected. */\n    gamepadConnected: boolean;\n    /**\n     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n     */\n    readonly preventKeys: Set<string>;\n    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n    gamepadButtons: Record<number, string>;\n    /** Stick deadzone (radial, 0..1). */\n    gamepadDeadzone: number;\n    /** Right stick look speed: pointer pixels per second at full tilt. */\n    gamepadLookSpeed: number;\n    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n    now: number;\n    /**\n     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n     * are ignored, and `playBefore` / `playAfter` set everything.\n     */\n    get playing(): boolean;\n    set playing(on: boolean);\n    private _playing;\n    private playedPad;\n    /** Queued presses older than this many seconds of game time are dropped. */\n    pressWindow: number;\n    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n    constructor(target?: Window | null);\n    /**\n     * Listen for pointer input on the game canvas. Only pointers that went down on the\n     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n     * pinch to zoom (emitted as wheel ticks).\n     */\n    attachPointer(el: HTMLElement): void;\n    /** Remove every listener this Input added (window and canvas). */\n    dispose(): void;\n    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n    release(): void;\n    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n    reset(): void;\n    /**\n     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n     */\n    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n    get pointerLocked(): boolean;\n    isDown(...codes: string[]): boolean;\n    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n    anyDown(codes: readonly string[]): boolean;\n    /** True once per physical key press (valid for the current render frame). */\n    wasPressed(...codes: string[]): boolean;\n    /**\n     * True once per physical key press, kept until consumed or until it is older than\n     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n     * several times per frame) so no press is dropped, while a stale press (made during a\n     * pause, a loading screen or a long hitch) never fires late.\n     */\n    consumePress(...codes: string[]): boolean;\n    /** `consumePress` for a list of codes, without building a rest-argument array. */\n    consumeAny(codes: readonly string[]): boolean;\n    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n    state(): InputState;\n    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n    setState(s: InputState, now: number): void;\n    /** Presses waiting to be consumed (tooling / tests). */\n    get queuedPresses(): string[];\n    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n    clearQueued(...codes: string[]): void;\n    /**\n     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n     */\n    moveAxis(): {\n        x: number;\n        y: number;\n    };\n    /** Call at the end of each rendered frame. */\n    endFrame(): void;\n    /** Test hook: simulate a key being held (true) or released (false). */\n    setKey(code: string, down: boolean): void;\n    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n    setPointer(x: number, y: number, down?: boolean): void;\n    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n    setButtons(bits: number): void;\n    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n    get mouseButtons(): number;\n    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n    private button;\n    /**\n     * This frame's pointer button presses and releases, in order, each with where the pointer\n     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n     */\n    get buttonEvents(): readonly ButtonEvent[];\n    /**\n     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n     * a save read from storage, anything a game would otherwise take straight from the page. It\n     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n     * through JSON first: live play reads exactly what a replay will.\n     */\n    send(command: unknown): void;\n    /**\n     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n     */\n    get commands(): readonly unknown[];\n    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n    deliver(): void;\n    /** Test hook: inject pointer movement / wheel for the next frame. */\n    addPointer(dx: number, dy: number, wheel?: number): void;\n    /**\n     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n     * before: unchanged held keys, pointer and gamepad connection are left out.\n     */\n    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n    /**\n     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n     * at the time they would have arrived, the frame before's game time).\n     */\n    playBefore(f: InputFrame): void;\n    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n    playAfter(f: InputFrame): void;\n    private press;\n    private pollGamepads;\n}\n=================== TouchControls\nimport type { Input } from './input';\n/** Corner of the screen a placed touch button is measured from (inside the safe area). */\nexport type TouchCorner = 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';\nexport interface TouchButton {\n    label: string;\n    /** Key code this button presses (e.g. 'Space'). */\n    code: string;\n    /** Short hint shown under the label. */\n    hint?: string;\n    /**\n     * Place the button yourself instead of in the default grid: its centre, in CSS pixels from\n     * `corner` (default bottom-right; `x` grows inward from the side, `y` inward from the top or\n     * bottom edge), and its diameter (`size`, default 58). An action game's cluster (a big\n     * attack button with skills on an arc around it) is a list of these.\n     */\n    at?: {\n        x: number;\n        y: number;\n        size?: number;\n        corner?: TouchCorner;\n    };\n}\n/**\n * What a button shows right now (`TouchControls.set`): a game drives its buttons from its own\n * state each frame (skill icons, cooldowns, costs, a contextual action). Only what changed\n * touches the DOM.\n */\nexport interface TouchButtonState {\n    label?: string;\n    hint?: string;\n    /** A picture instead of the label (a canvas or image; drawn pixelated); null removes it. */\n    icon?: HTMLCanvasElement | HTMLImageElement | null;\n    /** Cooldown shutter, 0..1 of the button covered (0 = ready). */\n    cooldown?: number;\n    /** Text over the shutter (seconds left). */\n    timer?: string;\n    /** A small corner badge (a cost, a count). */\n    badge?: string;\n    /** Dimmed (can't be used now); it still presses its key. */\n    disabled?: boolean;\n    /** Not shown (its place is kept), and its key is released. */\n    hidden?: boolean;\n}\n/** Default buttons for PlatformerCharacter (see character/controls.ts KEYMAP). */\nexport declare const DEFAULT_TOUCH_BUTTONS: readonly TouchButton[];\n/**\n * On-screen controls for phones and tablets: a virtual joystick (bottom-left) that feeds\n * `input.analog`, action buttons (bottom-right, in a grid or placed one by one with `at`)\n * that press key codes, and a small top bar (debug panel, Pixel/Raw, resolution, looks).\n * Camera: drag on the game to orbit/look, pinch to zoom (handled by Input.attachPointer).\n * Shown automatically on coarse pointers, or with `?touch=1`.\n *\n * A game drives it at runtime: `set(code, state)` (icon, cooldown, badge, disabled, hidden),\n * `show(false)` while a menu owns the screen, and `rects()` to lay its HUD out around the\n * controls.\n */\nexport declare class TouchControls {\n    private readonly input;\n    readonly root: HTMLDivElement;\n    private readonly views;\n    private readonly stick;\n    private readonly bar;\n    private shownAll;\n    private releaseStick;\n    constructor(container: HTMLElement, input: Input, buttons?: readonly TouchButton[], topBar?: readonly TouchButton[]);\n    static wanted(search?: string): boolean;\n    /** Update every button that presses `code` (see TouchButtonState). */\n    set(code: string, state: TouchButtonState): void;\n    /**\n     * Show or hide the joystick and the action buttons (the top bar stays): hide them while a\n     * menu or a full-screen view owns the screen. Hiding releases every held key and the stick.\n     */\n    show(on: boolean): void;\n    get visible(): boolean;\n    /**\n     * Client rects (CSS pixels) of the controls on screen now: the joystick and every button,\n     * with the key code it presses. A hidden button keeps its place (`hidden` says it isn't\n     * drawn), so a HUD laid out around them doesn't move when a contextual button comes and goes.\n     * Nothing but the bar while `show(false)`.\n     */\n    rects(): {\n        stick: DOMRect | null;\n        buttons: {\n            code: string;\n            label: string;\n            hidden: boolean;\n            rect: DOMRect;\n        }[];\n        bar: DOMRect | null;\n    };\n    private makeButton;\n    private apply;\n    private release;\n    private bindButton;\n    private bindStick;\n}\n=================== settings\nimport { type Resolution } from './framing';\nimport type { QualityOption } from './quality';\nimport { type Look } from './render/look';\nimport type { RenderMode } from './render/PixelRenderer';\n/**\n * The player's settings: the standard picture and engine options every game gets, as plain data\n * (sound is the AudioManager's, which keeps its own volumes). A field left out is the game's own\n * choice; a field set is the player's and wins over it. `engine.settings` holds them, applies\n * them, saves them per game and shows them in the settings panel (the ⚙ button).\n */\nexport interface PlayerSettings {\n    /** A LOOK_PRESETS name. Left out: the look the game gives each level. */\n    look?: string;\n    /** Pixel art (the pixel pass), or false for smooth 3D (render mode `raw`). */\n    pixelArt?: boolean;\n    /** The art resolution: `fine` (the game's, 480×270 by default) or `chunky` (two thirds of it: bigger pixels). */\n    pixelSize?: 'fine' | 'chunky';\n    /** Shadow and light quality: a level, or `auto` (the device's). */\n    quality?: QualityOption;\n    /** Frame cap: 60, 30, or 0 for the display's own rate. */\n    fps?: number;\n    /** The debug panel: frame rate, camera, GPU errors and the game's status. */\n    debugInfo?: boolean;\n}\nexport declare const PIXEL_SIZES: readonly [\"fine\", \"chunky\"];\nexport declare const QUALITY_OPTIONS: readonly QualityOption[];\nexport declare const FPS_OPTIONS: readonly number[];\n/** Keep only fields with a valid value: what storage or a caller handed over may be anything. */\nexport declare function normalizeSettings(raw: unknown): PlayerSettings;\n/** The settings saved under `key` ({} when there are none, or storage is blocked or holds junk). */\nexport declare function loadSettings(key: string): PlayerSettings;\nexport declare function storeSettings(key: string, settings: PlayerSettings): void;\n/** The engine options a page URL's review flags set (what `optionsFromUrl` gives). */\nexport type UrlFlags = {\n    look?: unknown;\n    filters?: unknown;\n    mode?: unknown;\n    resolution?: unknown;\n    quality?: unknown;\n    maxFps?: unknown;\n    debugUI?: unknown;\n};\n/**\n * The settings a page URL's review flags set (`?look=`, `?filters=`, `?mode=`, `?res=`,\n * `?quality=`, `?fps=`, `?debug=`): the fields `url` (optionsFromUrl) holds that the game's\n * `options` took (`withUrlOptions`). They win over the saved ones at start.\n */\nexport declare function urlSettings(url: UrlFlags, options?: UrlFlags): Set<keyof PlayerSettings>;\n/** Chunky pixels for a resolution: the engine's 320×180 for its 480×270, else two thirds of it. */\nexport declare function chunkyResolution(base: Resolution): Resolution;\n/** What the settings change in the engine (Engine implements it; tests pass a fake). */\nexport interface SettingsHost {\n    readonly look: Look;\n    setLook(look: Look): void;\n    readonly renderer: {\n        readonly mode: RenderMode;\n        readonly baseResolution: Resolution;\n        readonly lookVersion: number;\n        setMode(mode: RenderMode): void;\n        setResolution(resolution: Resolution): void;\n    };\n    maxFps: number;\n    readonly qualityOption: QualityOption;\n    useQuality(option: QualityOption): void;\n    readonly debugShown: boolean;\n    showDebug(on: boolean): void;\n}\n/**\n * `engine.settings`: the player's settings, applied to the engine and saved. A field the page URL\n * sets (`?look=`, `?mode=`, `?res=`, `?quality=`, `?fps=`, `?debug=`: review flags) wins over a\n * saved one at start (which stays saved). `open`, `close` and `toggle` show and hide the\n * settings panel.\n */\nexport declare class Settings {\n    private readonly host;\n    readonly key: string | null;\n    /** The player's choices: the saved ones from the start, and a game's `set()` before it. */\n    private current;\n    /** Saved choices a review flag in the URL overrides: not applied, still saved. */\n    private held;\n    private game;\n    private readonly listeners;\n    private shown;\n    /** `host.renderer.lookVersion` once the settings last set the look: unchanged, nothing else did since. */\n    private lookShown;\n    /** `key`: where they are saved (`pixel-engine:settings:<key>`), or null for nowhere. */\n    constructor(host: SettingsHost, key: string | null);\n    /** The player's choices in effect: fields left out are the game's (or a review flag's). */\n    get values(): Readonly<PlayerSettings>;\n    get isOpen(): boolean;\n    /** Change some settings: applied at once and saved. A field set to `undefined` goes back to the game's. */\n    set(patch: PlayerSettings): void;\n    /** Forget every choice, the held ones too: the game's own picture again. */\n    reset(): void;\n    /** Make `values` the settings, changing only the fields that differ: the ones it leaves out go back to the game's. */\n    replace(values: PlayerSettings): void;\n    /** Called with the values after every change; returns the unsubscribe. */\n    onChange(fn: (values: Readonly<PlayerSettings>) => void): () => void;\n    open(): void;\n    close(): void;\n    toggle(): void;\n    private save;\n    /** Put each field of `s` into the engine; `fields` also lists cleared ones (back to the game's). */\n    private apply;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3b81aee7-e493-4131-b722-c7c742e27493","uuid":"e8993f9f-e951-42c9-9a3a-44c72083cd5d","timestamp":"2026-11-05T23:24:13.250Z","tool_use_result":{"stdout":"=================== hud/Hud\nimport type { Framing, Resolution } from '../framing';\nimport { type PaletteColor } from '../palette';\n/** Where an element is attached on screen; it is also aligned that way (right-anchored text grows left). */\nexport type HudAnchor = 'top-left' | 'top' | 'top-right' | 'left' | 'center' | 'right' | 'bottom-left' | 'bottom' | 'bottom-right';\nexport type HudColor = PaletteColor | number;\nexport interface HudOptions {\n    /** Default 'white'. */\n    color?: HudColor;\n    /** 1-pixel drop shadow color, or false. Default 'ink'. */\n    shadow?: HudColor | false;\n    /** Integer art-pixel scale (2 = double-size glyphs). Default 1. */\n    scale?: number;\n    /** Default 'top-left': x/y are offsets from that screen corner/edge, in art pixels. */\n    anchor?: HudAnchor;\n}\n/**\n * Pixel HUD: crisp text and icons drawn in art pixels on top of the game, never through\n * the post filters. It is a 2D canvas at the internal resolution (480×270 / 320×180),\n * laid over the game canvas with the same integer scale and letterbox offset\n * (`framing.ts`), so one HUD pixel is exactly one art pixel at every resolution.\n *\n * Retained: what you add stays on screen until `clear()`. Redraw everything each frame\n * (clear + add) or only when something changes; the canvas repaints only when the content,\n * resolution or framing changed. Available as `ctx.hud`.\n *\n *   ctx.hud.clear();\n *   ctx.hud.text(4, 4, `COINS ${n}/12`, { color: 'sand' });\n *   ctx.hud.text(4, 4, 'PAUSED', { anchor: 'center', scale: 2 });\n */\nexport declare class Hud {\n    private readonly container;\n    /** The overlay canvas (created on the first draw; null when nothing was ever drawn). */\n    canvas: HTMLCanvasElement | null;\n    visible: boolean;\n    private items;\n    private drawn;\n    private size;\n    private layoutKey;\n    constructor(container: HTMLElement | null);\n    /** HUD width/height in art pixels (the internal resolution). */\n    get width(): number;\n    get height(): number;\n    /** Text in the 5×7 bitmap font (uppercase; digits and common punctuation). */\n    text(x: number, y: number, text: string, options?: HudOptions): void;\n    /** A filled rectangle (panels, bars). */\n    rect(x: number, y: number, w: number, h: number, color: HudColor, anchor?: HudAnchor): void;\n    /**\n     * A tiny pixel-art icon as data: one string per row, one character per pixel, mapped\n     * through `colors` ('.' or ' ' = transparent).\n     *\n     *   hud.sprite(4, 4, ['.yy.', 'ywyy', 'yyyy', '.yy.'], { y: 'sand', w: 'white' });\n     */\n    sprite(x: number, y: number, rows: readonly string[], colors: Record<string, HudColor>, options?: HudOptions): void;\n    /** Remove everything. */\n    clear(): void;\n    /** Size of `text` in art pixels at `scale`. */\n    measure(text: string, scale?: number): {\n        width: number;\n        height: number;\n    };\n    /** Engine: follow the renderer's resolution and framing, and repaint if needed. */\n    sync(resolution: Resolution, framing: Framing): void;\n    dispose(): void;\n    private createCanvas;\n    private paint;\n    private glyphs;\n    private place;\n}\n/**\n * Top-left corner, in whole art pixels, of a w×h element placed at offset (x, y) from\n * `anchor` on a screen of `size` art pixels. Pure (unit-tested).\n */\nexport declare function hudPlace(x: number, y: number, w: number, h: number, anchor: HudAnchor, size: Resolution): [number, number];\n=================== input\n/**\n * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n */\nexport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\nexport interface GamepadLike {\n    readonly connected?: boolean;\n    readonly mapping?: string;\n    readonly axes: readonly number[];\n    readonly buttons: readonly {\n        readonly pressed: boolean;\n        readonly value?: number;\n    }[];\n}\n/**\n * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n * direction is kept (no square-gate snapping to the axes).\n */\nexport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n    x: number;\n    y: number;\n};\n/** How long a queued press stays consumable, in seconds of game time. */\nexport declare const PRESS_WINDOW = 0.15;\n/**\n * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n * from the frame before.\n */\nexport interface InputFrame {\n    /** Real seconds this frame lasted (game time follows from it). */\n    dt: number;\n    /** Keys held, keyboard and gamepad buttons together, sorted. */\n    held?: string[];\n    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n    pressed?: string[];\n    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n    analog?: [number, number];\n    pad?: [number, number];\n    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n    delta?: [number, number];\n    wheel?: number;\n    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n    pointer?: [number, number, number, number];\n    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n    gamepad?: boolean;\n    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n    touch?: boolean;\n    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n    clicks?: [string, 0 | 1, number, number][];\n    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n    commands?: unknown[];\n    /**\n     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n     * callbacks ran between them. A replay waits for them before every other frame.\n     */\n    sync?: true;\n}\n/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\nexport interface InputState {\n    readonly held: readonly string[];\n    /** Queued presses: [key, seconds of game time since it was pressed]. */\n    readonly queued: readonly (readonly [string, number])[];\n    readonly pointer: readonly [number, number, number, number];\n    readonly gamepad: boolean;\n    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n    readonly outbox: readonly unknown[];\n}\n/** What the frame before held, for `snapshot()` to leave out what did not change. */\nexport interface SnapshotMemory {\n    held: string;\n    pointer: string;\n    gamepad?: boolean;\n    touch?: boolean;\n}\n/**\n * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n */\nexport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\nexport declare const TOUCH_KEY = \"Touch\";\n/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\nexport interface ButtonEvent {\n    readonly code: string;\n    readonly down: boolean;\n    readonly x: number;\n    readonly y: number;\n}\n/**\n * Keyboard + pointer + gamepad input.\n * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n *   right stick feeds the pointer delta (camera look), buttons press key codes\n *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n *   a frame is not lost.\n * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n *   and recorded with it.\n * - `dispose()` removes every listener it added.\n */\nexport declare class Input {\n    private readonly target;\n    private readonly held;\n    private readonly pressed;\n    /** Queued presses → the game time they happened at. */\n    private readonly queued;\n    /** Keys held through gamepad buttons (merged into isDown). */\n    private readonly padHeld;\n    private readonly listeners;\n    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n    readonly mouseDelta: {\n        x: number;\n        y: number;\n    };\n    /**\n     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n     * Under pointer lock it is the screen's centre (the crosshair).\n     */\n    readonly pointer: {\n        x: number;\n        y: number;\n        over: boolean;\n        touch: boolean;\n    };\n    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n    wheel: number;\n    /** This frame's button presses and releases, in order (`buttonEvents`). */\n    private _buttonEvents;\n    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n    private outbox;\n    private _commands;\n    private lockTarget;\n    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n    wantsPointerLock: boolean;\n    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n    readonly analog: {\n        x: number;\n        y: number;\n    };\n    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n    readonly padAxis: {\n        x: number;\n        y: number;\n    };\n    /** True while any gamepad is connected. */\n    gamepadConnected: boolean;\n    /**\n     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n     */\n    readonly preventKeys: Set<string>;\n    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n    gamepadButtons: Record<number, string>;\n    /** Stick deadzone (radial, 0..1). */\n    gamepadDeadzone: number;\n    /** Right stick look speed: pointer pixels per second at full tilt. */\n    gamepadLookSpeed: number;\n    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n    now: number;\n    /**\n     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n     * are ignored, and `playBefore` / `playAfter` set everything.\n     */\n    get playing(): boolean;\n    set playing(on: boolean);\n    private _playing;\n    private playedPad;\n    /** Queued presses older than this many seconds of game time are dropped. */\n    pressWindow: number;\n    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n    constructor(target?: Window | null);\n    /**\n     * Listen for pointer input on the game canvas. Only pointers that went down on the\n     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n     * pinch to zoom (emitted as wheel ticks).\n     */\n    attachPointer(el: HTMLElement): void;\n    /** Remove every listener this Input added (window and canvas). */\n    dispose(): void;\n    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n    release(): void;\n    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n    reset(): void;\n    /**\n     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n     */\n    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n    get pointerLocked(): boolean;\n    isDown(...codes: string[]): boolean;\n    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n    anyDown(codes: readonly string[]): boolean;\n    /** True once per physical key press (valid for the current render frame). */\n    wasPressed(...codes: string[]): boolean;\n    /**\n     * True once per physical key press, kept until consumed or until it is older than\n     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n     * several times per frame) so no press is dropped, while a stale press (made during a\n     * pause, a loading screen or a long hitch) never fires late.\n     */\n    consumePress(...codes: string[]): boolean;\n    /** `consumePress` for a list of codes, without building a rest-argument array. */\n    consumeAny(codes: readonly string[]): boolean;\n    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n    state(): InputState;\n    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n    setState(s: InputState, now: number): void;\n    /** Presses waiting to be consumed (tooling / tests). */\n    get queuedPresses(): string[];\n    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n    clearQueued(...codes: string[]): void;\n    /**\n     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n     */\n    moveAxis(): {\n        x: number;\n        y: number;\n    };\n    /** Call at the end of each rendered frame. */\n    endFrame(): void;\n    /** Test hook: simulate a key being held (true) or released (false). */\n    setKey(code: string, down: boolean): void;\n    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n    setPointer(x: number, y: number, down?: boolean): void;\n    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n    setButtons(bits: number): void;\n    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n    get mouseButtons(): number;\n    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n    private button;\n    /**\n     * This frame's pointer button presses and releases, in order, each with where the pointer\n     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n     */\n    get buttonEvents(): readonly ButtonEvent[];\n    /**\n     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n     * a save read from storage, anything a game would otherwise take straight from the page. It\n     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n     * through JSON first: live play reads exactly what a replay will.\n     */\n    send(command: unknown): void;\n    /**\n     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n     */\n    get commands(): readonly unknown[];\n    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n    deliver(): void;\n    /** Test hook: inject pointer movement / wheel for the next frame. */\n    addPointer(dx: number, dy: number, wheel?: number): void;\n    /**\n     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n     * before: unchanged held keys, pointer and gamepad connection are left out.\n     */\n    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n    /**\n     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n     * at the time they would have arrived, the frame before's game time).\n     */\n    playBefore(f: InputFrame): void;\n    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n    playAfter(f: InputFrame): void;\n    private press;\n    private pollGamepads;\n}\n=================== TouchControls\nimport type { Input } from './input';\n/** Corner of the screen a placed touch button is measured from (inside the safe area). */\nexport type TouchCorner = 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';\nexport interface TouchButton {\n    label: string;\n    /** Key code this button presses (e.g. 'Space'). */\n    code: string;\n    /** Short hint shown under the label. */\n    hint?: string;\n    /**\n     * Place the button yourself instead of in the default grid: its centre, in CSS pixels from\n     * `corner` (default bottom-right; `x` grows inward from the side, `y` inward from the top or\n     * bottom edge), and its diameter (`size`, default 58). An action game's cluster (a big\n     * attack button with skills on an arc around it) is a list of these.\n     */\n    at?: {\n        x: number;\n        y: number;\n        size?: number;\n        corner?: TouchCorner;\n    };\n}\n/**\n * What a button shows right now (`TouchControls.set`): a game drives its buttons from its own\n * state each frame (skill icons, cooldowns, costs, a contextual action). Only what changed\n * touches the DOM.\n */\nexport interface TouchButtonState {\n    label?: string;\n    hint?: string;\n    /** A picture instead of the label (a canvas or image; drawn pixelated); null removes it. */\n    icon?: HTMLCanvasElement | HTMLImageElement | null;\n    /** Cooldown shutter, 0..1 of the button covered (0 = ready). */\n    cooldown?: number;\n    /** Text over the shutter (seconds left). */\n    timer?: string;\n    /** A small corner badge (a cost, a count). */\n    badge?: string;\n    /** Dimmed (can't be used now); it still presses its key. */\n    disabled?: boolean;\n    /** Not shown (its place is kept), and its key is released. */\n    hidden?: boolean;\n}\n/** Default buttons for PlatformerCharacter (see character/controls.ts KEYMAP). */\nexport declare const DEFAULT_TOUCH_BUTTONS: readonly TouchButton[];\n/**\n * On-screen controls for phones and tablets: a virtual joystick (bottom-left) that feeds\n * `input.analog`, action buttons (bottom-right, in a grid or placed one by one with `at`)\n * that press key codes, and a small top bar (debug panel, Pixel/Raw, resolution, looks).\n * Camera: drag on the game to orbit/look, pinch to zoom (handled by Input.attachPointer).\n * Shown automatically on coarse pointers, or with `?touch=1`.\n *\n * A game drives it at runtime: `set(code, state)` (icon, cooldown, badge, disabled, hidden),\n * `show(false)` while a menu owns the screen, and `rects()` to lay its HUD out around the\n * controls.\n */\nexport declare class TouchControls {\n    private readonly input;\n    readonly root: HTMLDivElement;\n    private readonly views;\n    private readonly stick;\n    private readonly bar;\n    private shownAll;\n    private releaseStick;\n    constructor(container: HTMLElement, input: Input, buttons?: readonly TouchButton[], topBar?: readonly TouchButton[]);\n    static wanted(search?: string): boolean;\n    /** Update every button that presses `code` (see TouchButtonState). */\n    set(code: string, state: TouchButtonState): void;\n    /**\n     * Show or hide the joystick and the action buttons (the top bar stays): hide them while a\n     * menu or a full-screen view owns the screen. Hiding releases every held key and the stick.\n     */\n    show(on: boolean): void;\n    get visible(): boolean;\n    /**\n     * Client rects (CSS pixels) of the controls on screen now: the joystick and every button,\n     * with the key code it presses. A hidden button keeps its place (`hidden` says it isn't\n     * drawn), so a HUD laid out around them doesn't move when a contextual button comes and goes.\n     * Nothing but the bar while `show(false)`.\n     */\n    rects(): {\n        stick: DOMRect | null;\n        buttons: {\n            code: string;\n            label: string;\n            hidden: boolean;\n            rect: DOMRect;\n        }[];\n        bar: DOMRect | null;\n    };\n    private makeButton;\n    private apply;\n    private release;\n    private bindButton;\n    private bindStick;\n}\n=================== settings\nimport { type Resolution } from './framing';\nimport type { QualityOption } from './quality';\nimport { type Look } from './render/look';\nimport type { RenderMode } from './render/PixelRenderer';\n/**\n * The player's settings: the standard picture and engine options every game gets, as plain data\n * (sound is the AudioManager's, which keeps its own volumes). A field left out is the game's own\n * choice; a field set is the player's and wins over it. `engine.settings` holds them, applies\n * them, saves them per game and shows them in the settings panel (the ⚙ button).\n */\nexport interface PlayerSettings {\n    /** A LOOK_PRESETS name. Left out: the look the game gives each level. */\n    look?: string;\n    /** Pixel art (the pixel pass), or false for smooth 3D (render mode `raw`). */\n    pixelArt?: boolean;\n    /** The art resolution: `fine` (the game's, 480×270 by default) or `chunky` (two thirds of it: bigger pixels). */\n    pixelSize?: 'fine' | 'chunky';\n    /** Shadow and light quality: a level, or `auto` (the device's). */\n    quality?: QualityOption;\n    /** Frame cap: 60, 30, or 0 for the display's own rate. */\n    fps?: number;\n    /** The debug panel: frame rate, camera, GPU errors and the game's status. */\n    debugInfo?: boolean;\n}\nexport declare const PIXEL_SIZES: readonly [\"fine\", \"chunky\"];\nexport declare const QUALITY_OPTIONS: readonly QualityOption[];\nexport declare const FPS_OPTIONS: readonly number[];\n/** Keep only fields with a valid value: what storage or a caller handed over may be anything. */\nexport declare function normalizeSettings(raw: unknown): PlayerSettings;\n/** The settings saved under `key` ({} when there are none, or storage is blocked or holds junk). */\nexport declare function loadSettings(key: string): PlayerSettings;\nexport declare function storeSettings(key: string, settings: PlayerSettings): void;\n/** The engine options a page URL's review flags set (what `optionsFromUrl` gives). */\nexport type UrlFlags = {\n    look?: unknown;\n    filters?: unknown;\n    mode?: unknown;\n    resolution?: unknown;\n    quality?: unknown;\n    maxFps?: unknown;\n    debugUI?: unknown;\n};\n/**\n * The settings a page URL's review flags set (`?look=`, `?filters=`, `?mode=`, `?res=`,\n * `?quality=`, `?fps=`, `?debug=`): the fields `url` (optionsFromUrl) holds that the game's\n * `options` took (`withUrlOptions`). They win over the saved ones at start.\n */\nexport declare function urlSettings(url: UrlFlags, options?: UrlFlags): Set<keyof PlayerSettings>;\n/** Chunky pixels for a resolution: the engine's 320×180 for its 480×270, else two thirds of it. */\nexport declare function chunkyResolution(base: Resolution): Resolution;\n/** What the settings change in the engine (Engine implements it; tests pass a fake). */\nexport interface SettingsHost {\n    readonly look: Look;\n    setLook(look: Look): void;\n    readonly renderer: {\n        readonly mode: RenderMode;\n        readonly baseResolution: Resolution;\n        readonly lookVersion: number;\n        setMode(mode: RenderMode): void;\n        setResolution(resolution: Resolution): void;\n    };\n    maxFps: number;\n    readonly qualityOption: QualityOption;\n    useQuality(option: QualityOption): void;\n    readonly debugShown: boolean;\n    showDebug(on: boolean): void;\n}\n/**\n * `engine.settings`: the player's settings, applied to the engine and saved. A field the page URL\n * sets (`?look=`, `?mode=`, `?res=`, `?quality=`, `?fps=`, `?debug=`: review flags) wins over a\n * saved one at start (which stays saved). `open`, `close` and `toggle` show and hide the\n * settings panel.\n */\nexport declare class Settings {\n    private readonly host;\n    readonly key: string | null;\n    /** The player's choices: the saved ones from the start, and a game's `set()` before it. */\n    private current;\n    /** Saved choices a review flag in the URL overrides: not applied, still saved. */\n    private held;\n    private game;\n    private readonly listeners;\n    private shown;\n    /** `host.renderer.lookVersion` once the settings last set the look: unchanged, nothing else did since. */\n    private lookShown;\n    /** `key`: where they are saved (`pixel-engine:settings:<key>`), or null for nowhere. */\n    constructor(host: SettingsHost, key: string | null);\n    /** The player's choices in effect: fields left out are the game's (or a review flag's). */\n    get values(): Readonly<PlayerSettings>;\n    get isOpen(): boolean;\n    /** Change some settings: applied at once and saved. A field set to `undefined` goes back to the game's. */\n    set(patch: PlayerSettings): void;\n    /** Forget every choice, the held ones too: the game's own picture again. */\n    reset(): void;\n    /** Make `values` the settings, changing only the fields that differ: the ones it leaves out go back to the game's. */\n    replace(values: PlayerSettings): void;\n    /** Called with the values after every change; returns the unsubscribe. */\n    onChange(fn: (values: Readonly<PlayerSettings>) => void): () => void;\n    open(): void;\n    close(): void;\n    toggle(): void;\n    private save;\n    /** Put each field of `s` into the engine; `fields` also lists cleared ones (back to the game's). */\n    private apply;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Tt11hdRwAxY6Dhb2EbGihe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
