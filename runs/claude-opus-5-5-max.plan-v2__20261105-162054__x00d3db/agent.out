{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WXgLRMi7wAU7EcnChQnnZ","type":"tool_result","content":"1\t=================== audio/AudioManager\n2\timport { type Song } from './music';\n3\timport { type SoundDef } from './synth';\n4\texport type VolumeChannel = 'master' | 'sfx' | 'music';\n5\texport interface AudioSettings {\n6\t    master: number;\n7\t    sfx: number;\n8\t    music: number;\n9\t    muted: boolean;\n10\t}\n11\texport interface PlayOptions {\n12\t    /** 0..1 multiplier on the sound's own volume. */\n13\t    volume?: number;\n14\t    /** Pitch shift in semitones (playback rate), e.g. a rising combo. */\n15\t    pitch?: number;\n16\t    /** Stereo position -1 (left) .. 1 (right). */\n17\t    pan?: number;\n18\t}\n19\texport interface VoiceSettings {\n20\t    /** 0..1 (default 1). */\n21\t    volume?: number;\n22\t    /** Stereo position -1 (left) .. 1 (right). */\n23\t    pan?: number;\n24\t    /** 0 (clear) .. 1 (behind a thick wall, under water): a low-pass filter closing down. */\n25\t    muffle?: number;\n26\t    /** Pitch shift in semitones. */\n27\t    pitch?: number;\n28\t}\n29\t/** A looping sound steered while it plays (`AudioManager.loop`): a hum, a fire, a waterfall. */\n30\texport interface Voice {\n31\t    readonly name: string;\n32\t    /** The values last set (kept headless too, so games and tests can read them). */\n33\t    readonly settings: Readonly<Required<VoiceSettings>>;\n34\t    /** Really sounding: Web Audio running and the loop started. */\n35\t    readonly sounding: boolean;\n36\t    readonly stopped: boolean;\n37\t    /** Change any of its settings; they glide over a few hundredths of a second (no clicks). */\n38\t    set(s: VoiceSettings): void;\n39\t    stop(): void;\n40\t}\n41\t/** Low-pass cutoff (Hz) for a muffle of 0..1: wide open to a dull thud. */\n42\texport declare const muffleCutoff: (muffle: number) => number;\n43\t/**\n44\t * Web Audio for games: procedural retro sound effects (`SFX`, data), a small chiptune\n45\t * sequencer (`Song`, data), optional audio files, and master / sfx / music volume + mute\n46\t * persisted in localStorage. Available as `ctx.audio`.\n47\t *\n48\t * Browsers only allow sound after a user gesture, so the AudioContext is created on the\n49\t * first key / pointer / touch input. Before that, and wherever Web Audio does not exist\n50\t * (headless tests, old browsers), every call is a silent no-op that still records what\n51\t * was played in `log`, so games behave identically and tests can assert on sounds.\n52\t */\n53\texport declare class AudioManager {\n54\t    /** Sound registry: the built-in SFX plus anything registered or loaded. */\n55\t    readonly sounds: Map<string, SoundDef>;\n56\t    /** The most recent plays (name and game-independent wall time), newest last; tooling/tests. */\n57\t    readonly log: {\n58\t        name: string;\n59\t        at: number;\n60\t    }[];\n61\t    /** How many times each sound was requested. */\n62\t    readonly counts: Record<string, number>;\n63\t    context: AudioContext | null;\n64\t    private master;\n65\t    private buses;\n66\t    private readonly settings;\n67\t    private readonly buffers;\n68\t    private readonly files;\n69\t    private readonly pendingFiles;\n70\t    private unlockListeners;\n71\t    private readonly lifetime;\n72\t    private song;\n73\t    private songName;\n74\t    private readonly musicSources;\n75\t    private readonly voices;\n76\t    /** Files being fetched or decoded (a loop waiting for one is not missing its sound). */\n77\t    private readonly loading;\n78\t    private disposed;\n79\t    constructor(target?: EventTarget | null);\n80\t    /** Web Audio exists in this environment. */\n81\t    static get supported(): boolean;\n82\t    /** True once the AudioContext is running (after the first user input). */\n83\t    get unlocked(): boolean;\n84\t    /** Current volumes and mute (persisted). */\n85\t    get volume(): Readonly<AudioSettings>;\n86\t    get muted(): boolean;\n87\t    /** Name of the playing song ('' when none). */\n88\t    get playing(): string;\n89\t    /**\n90\t     * Create / resume the AudioContext. Called automatically on the first user input; call\n91\t     * it yourself from a click handler if you start sound from your own UI.\n92\t     */\n93\t    unlock(): void;\n94\t    private target;\n95\t    /** Listen for the next user input (until the context is running). */\n96\t    private armUnlock;\n97\t    private disarmUnlock;\n98\t    /** Resume a suspended / interrupted context; stop listening for input once it runs. */\n99\t    private resume;\n100\t    /** Add or replace a sound effect (data, see SoundDef). */\n101\t    register(name: string, def: SoundDef): void;\n102\t    /**\n103\t     * Play a sound effect by name (built-in SFX, `register`ed or `load`ed) or directly from a\n104\t     * SoundDef. Returns false when nothing could be heard (locked, muted, no Web Audio).\n105\t     */\n106\t    play(sound: string | SoundDef, options?: PlayOptions): boolean;\n107\t    /**\n108\t     * Start a sound looping, as a voice you steer while it plays (volume, pan, muffle, pitch:\n109\t     * with `spatialize` it sits at a place in the world). Before the first user input, or with\n110\t     * no Web Audio, the voice keeps its settings silently and starts once audio unlocks.\n111\t     * Stop it when you are done (a level's `dispose`).\n112\t     */\n113\t    loop(sound: string | SoundDef, settings?: VoiceSettings): Voice;\n114\t    /** Voices playing or waiting to (tooling and tests). */\n115\t    get loops(): readonly Voice[];\n116\t    /** Stop every looping voice (the engine does this when a level unloads). */\n117\t    stopLoops(): void;\n118\t    /**\n119\t     * Load an audio file (wav/ogg/mp3…) under `name`; `play(name)` then plays it. Works\n120\t     * before the first user input too: the file is decoded once audio unlocks.\n121\t     */\n122\t    load(name: string, url: string): Promise<void>;\n123\t    /** Start a song (looping by default), replacing the current one. `null` stops music. */\n124\t    playMusic(song: Song | null, name?: string): void;\n125\t    stopMusic(): void;\n126\t    /**\n127\t     * Volume changes are written to storage. The engine turns this off while a replay plays: the\n128\t     * recording sets the volumes it set, nothing is written, and the player's come back after.\n129\t     */\n130\t    persist: boolean;\n131\t    setVolume(channel: VolumeChannel, value: number): void;\n132\t    setMuted(muted: boolean): void;\n133\t    toggleMute(): boolean;\n134\t    /** The default volumes, sound on (the settings panel's Reset). */\n135\t    resetVolumes(): void;\n136\t    /** Engine: once per rendered frame. Schedules the next notes of the song. */\n137\t    update(): void;\n138\t    /** Stop everything and close the AudioContext. */\n139\t    dispose(): void;\n140\t    private start;\n141\t    private bufferFor;\n142\t    private toBuffer;\n143\t    private decode;\n144\t    private applyVolumes;\n145\t}\n146\t=================== audio/music\n147\timport { type SoundDef } from './synth';\n148\t/** A track's instrument: a SoundDef without pitch or length (each note sets those). */\n149\texport type Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>;\n150\t/**\n151\t * A chiptune song as data. Each pattern holds one string per track: space-separated steps,\n152\t * where a step is a note ('C4', 'F#5', 'Bb2'), '.' (rest) or '-' (hold the previous note).\n153\t * Every track of a pattern must have the same number of steps. For `noise` tracks the\n154\t * note's pitch is the noise rate: C6 is a snare-ish hiss, C8 a hi-hat tick.\n155\t */\n156\texport interface Song {\n157\t    bpm: number;\n158\t    /** Steps per beat (4 = sixteenth notes). Default 4. */\n159\t    stepsPerBeat?: number;\n160\t    tracks: Record<string, Instrument>;\n161\t    patterns: Record<string, Record<string, string>>;\n162\t    /** Pattern names in play order. */\n163\t    order: readonly string[];\n164\t    /** Loop forever (default true). */\n165\t    loop?: boolean;\n166\t}\n167\texport interface SongNote {\n168\t    track: string;\n169\t    /** Step index from the start of the song. */\n170\t    step: number;\n171\t    /** Length in steps (1 + following holds). */\n172\t    steps: number;\n173\t    freq: number;\n174\t}\n175\texport interface ParsedSong {\n176\t    /** Seconds per step. */\n177\t    stepTime: number;\n178\t    /** Total steps in one pass of `order`. */\n179\t    length: number;\n180\t    notes: SongNote[];\n181\t}\n182\t/** Flatten a song into timed notes. Throws on malformed patterns, so tests catch typos. */\n183\texport declare function parseSong(song: Song): ParsedSong;\n184\t/** The playable SoundDef for one note of a track. */\n185\texport declare function noteSound(instrument: Instrument, freq: number, seconds: number): SoundDef;\n186\t/** The playground's short looping track: C major, bouncy, 2 × 16 steps. */\n187\texport declare const PLAYGROUND_SONG: Song;\n188\t=================== audio/synth\n189\t/**\n190\t * Retro sound synthesis as pure functions (no Web Audio): a sound is data (`SoundDef`)\n191\t * rendered to samples once, then played as a buffer. Deterministic (seeded noise), so\n192\t * sounds are unit-testable and identical on every machine.\n193\t */\n194\texport type Wave = 'square' | 'triangle' | 'saw' | 'sine' | 'noise';\n195\texport interface SoundDef {\n196\t    wave: Wave;\n197\t    /** Start pitch in Hz. For `noise` it is the sample-and-hold rate (higher = hissier). */\n198\t    freq: number;\n199\t    /** End pitch for a sweep (exponential glide from `freq`). */\n200\t    freqEnd?: number;\n201\t    /** Seconds the sweep takes (default: the whole sound). */\n202\t    sweepTime?: number;\n203\t    /** Square duty cycle: 0.125, 0.25 or 0.5 are the classic NES widths. Default 0.5. */\n204\t    duty?: number;\n205\t    /** Envelope (seconds): ramp up, hold at full volume, then fade out. */\n206\t    attack?: number;\n207\t    sustain?: number;\n208\t    decay?: number;\n209\t    /** Peak level 0..1 (default 0.5). */\n210\t    volume?: number;\n211\t    /** Arpeggio: semitone offsets stepped every `arpRate` seconds (the coin \"ba-ding\"). */\n212\t    arp?: readonly number[];\n213\t    arpRate?: number;\n214\t    /** Vibrato depth in semitones and rate in Hz. */\n215\t    vibrato?: {\n216\t        depth: number;\n217\t        rate: number;\n218\t    };\n219\t    /** Quantize to this many levels (4-bit style crunch). 0 = off. */\n220\t    crush?: number;\n221\t    /** Seconds of silence before the sound starts (for layers). */\n222\t    delay?: number;\n223\t    /** Extra sounds mixed in (e.g. a noise burst under a thump). */\n224\t    layers?: readonly SoundDef[];\n225\t}\n226\t/** Seconds a sound lasts, including delays and layers. */\n227\texport declare function soundDuration(def: SoundDef): number;\n228\t/** Envelope gain 0..1 at time `t` (seconds since the sound's own start). */\n229\texport declare function envelope(def: SoundDef, t: number): number;\n230\t/** Instantaneous frequency (Hz) at time `t`: sweep, arpeggio and vibrato applied. */\n231\texport declare function frequencyAt(def: SoundDef, t: number): number;\n232\t/** Small deterministic PRNG (mulberry32). */\n233\texport declare function rng(seed?: number): () => number;\n234\t/** Render a sound to mono samples in -1..1. */\n235\texport declare function renderSound(def: SoundDef, sampleRate?: number, seed?: number): Float32Array<ArrayBuffer>;\n236\t/** 'A4' → 440, 'C#5', 'Eb3'… Returns null for anything that is not a note. */\n237\texport declare function noteFrequency(note: string): number | null;\n238\t=================== audio/sfx\n239\t/**\n240\t * Built-in retro sound effects, as data. Tweak numbers here (or register your own with\n241\t * `ctx.audio.register(name, def)`) and every `ctx.audio.play(name)` picks them up.\n242\t * See docs/engine/audio.md for the SoundDef fields.\n243\t */\n244\texport declare const SFX: {\n245\t    /** Short rising square chirp. */\n246\t    jump: {\n247\t        wave: \"square\";\n248\t        duty: number;\n249\t        freq: number;\n250\t        freqEnd: number;\n251\t        attack: number;\n252\t        sustain: number;\n253\t        decay: number;\n254\t        volume: number;\n255\t    };\n256\t    /** Higher, thinner chirp with a fifth on top. */\n257\t    doubleJump: {\n258\t        wave: \"square\";\n259\t        duty: number;\n260\t        freq: number;\n261\t        freqEnd: number;\n262\t        arp: number[];\n263\t        arpRate: number;\n264\t        attack: number;\n265\t        sustain: number;\n266\t        decay: number;\n267\t        volume: number;\n268\t    };\n269\t    /** Soft thud: a falling triangle under a short noise puff. */\n270\t    land: {\n271\t        wave: \"triangle\";\n272\t        freq: number;\n273\t        freqEnd: number;\n274\t        attack: number;\n275\t        decay: number;\n276\t        volume: number;\n277\t        layers: {\n278\t            wave: \"noise\";\n279\t            freq: number;\n280\t            freqEnd: number;\n281\t            attack: number;\n282\t            decay: number;\n283\t            volume: number;\n284\t        }[];\n285\t    };\n286\t    /** The classic two-note pickup (B5 → E6). */\n287\t    coin: {\n288\t        wave: \"square\";\n289\t        duty: number;\n290\t        freq: number;\n291\t        arp: number[];\n292\t        arpRate: number;\n293\t        attack: number;\n294\t        sustain: number;\n295\t        decay: number;\n296\t        volume: number;\n297\t    };\n298\t    /** A tiny tick per footstep. */\n299\t    step: {\n300\t        wave: \"noise\";\n301\t        freq: number;\n302\t        freqEnd: number;\n303\t        attack: number;\n304\t        decay: number;\n305\t        volume: number;\n306\t    };\n307\t    /** Shoe squeal: hissy noise plus a wobbling high square. */\n308\t    skid: {\n309\t        wave: \"noise\";\n310\t        freq: number;\n311\t        freqEnd: number;\n312\t        attack: number;\n313\t        sustain: number;\n314\t        decay: number;\n315\t        volume: number;\n316\t        layers: {\n317\t            wave: \"square\";\n318\t            duty: number;\n319\t            freq: number;\n320\t            freqEnd: number;\n321\t            vibrato: {\n322\t                depth: number;\n323\t                rate: number;\n324\t            };\n325\t            attack: number;\n326\t            sustain: number;\n327\t            decay: number;\n328\t            volume: number;\n329\t        }[];\n330\t    };\n331\t    /** Whack: noise burst over a dropping square. */\n332\t    punch: {\n333\t        wave: \"noise\";\n334\t        freq: number;\n335\t        freqEnd: number;\n336\t        attack: number;\n337\t        decay: number;\n338\t        volume: number;\n339\t        layers: {\n340\t            wave: \"square\";\n341\t            duty: number;\n342\t            freq: number;\n343\t            freqEnd: number;\n344\t            attack: number;\n345\t            decay: number;\n346\t            volume: number;\n347\t        }[];\n348\t    };\n349\t    /** Big low boom for the ground-pound impact. */\n350\t    groundPound: {\n351\t        wave: \"triangle\";\n352\t        freq: number;\n353\t        freqEnd: number;\n354\t        attack: number;\n355\t        sustain: number;\n356\t        decay: number;\n357\t        volume: number;\n358\t        crush: number;\n359\t        layers: {\n360\t            wave: \"noise\";\n361\t            freq: number;\n362\t            freqEnd: number;\n363\t            attack: number;\n364\t            decay: number;\n365\t            volume: number;\n366\t        }[];\n367\t    };\n368\t    /** Spin-up whoosh before the pound falls. */\n369\t    whoosh: {\n370\t        wave: \"noise\";\n371\t        freq: number;\n372\t        freqEnd: number;\n373\t        attack: number;\n374\t        decay: number;\n375\t        volume: number;\n376\t    };\n377\t    /** Descending, wobbly \"ouch\". */\n378\t    hurt: {\n379\t        wave: \"square\";\n380\t        duty: number;\n381\t        freq: number;\n382\t        freqEnd: number;\n383\t        vibrato: {\n384\t            depth: number;\n385\t            rate: number;\n386\t        };\n387\t        attack: number;\n388\t        sustain: number;\n389\t        decay: number;\n390\t        volume: number;\n391\t    };\n392\t    /** Victory fanfare arpeggio. */\n393\t    fanfare: {\n394\t        wave: \"square\";\n395\t        duty: number;\n396\t        freq: number;\n397\t        arp: number[];\n398\t        arpRate: number;\n399\t        attack: number;\n400\t        sustain: number;\n401\t        decay: number;\n402\t        volume: number;\n403\t    };\n404\t};\n405\texport type SfxName = keyof typeof SFX;\n406\t=================== audio/spatial\n407\t/**\n408\t * Sound in space: how loud and how far left or right a sound at a point is for a listener\n409\t * (the camera, or the hero's ears). Pure maths, so it is unit-tested and the same in a\n410\t * headless run; `AudioManager.loop()` voices take the result.\n411\t *\n412\t *   const hum = ctx.audio.loop('hum');\n413\t *   const s = spatialize({ position: ears, right: cameraRight }, generator.position, { ref: 2, max: 25 });\n414\t *   hum.set({ volume: s.gain * (blocked ? 0.4 : 1), pan: s.pan, muffle: blocked ? 0.8 : 0 });\n415\t */\n416\texport type V3Like = readonly [number, number, number] | {\n417\t    readonly x: number;\n418\t    readonly y: number;\n419\t    readonly z: number;\n420\t};\n421\texport interface Listener {\n422\t    position: V3Like;\n423\t    /** The listener's right, in world space (unit): the camera's right for a third-person game. */\n424\t    right: V3Like;\n425\t}\n426\texport interface SpatialOptions {\n427\t    /** Within this distance (m) the sound is at full volume (default 1). */\n428\t    ref?: number;\n429\t    /** Silent from this distance on (default 30); it fades out over the last fifth. */\n430\t    max?: number;\n431\t    /** How fast it falls off past `ref` (default 1: inverse distance, the way sound really does). */\n432\t    rolloff?: number;\n433\t}\n434\texport interface Spatial {\n435\t    /** 0..1 volume. */\n436\t    gain: number;\n437\t    /** -1 (left) .. 1 (right). */\n438\t    pan: number;\n439\t    distance: number;\n440\t}\n441\t/** Volume at `distance` (m): 1 inside `ref`, then inverse distance, fading to 0 at `max`. */\n442\texport declare function attenuation(distance: number, o?: SpatialOptions): number;\n443\t/** Gain and pan of a sound at `at` for `listener`. */\n444\texport declare function spatialize(listener: Listener, at: V3Like, o?: SpatialOptions): Spatial;\n445\t=================== palette\n446\t/**\n447\t * Restrained 16-color palette (Sweetie 16 by GrafxKid). Every color in a game should come\n448\t * from here: authentic pixel art reads as \"designed\" because the palette is small.\n449\t * Keep in sync with scripts/generate-assets.mjs.\n450\t */\n451\texport declare const PALETTE: {\n452\t    readonly ink: 1711148;\n453\t    readonly plum: 6104925;\n454\t    readonly red: 11615827;\n455\t    readonly orange: 15695191;\n456\t    readonly sand: 16764277;\n457\t    readonly lime: 11006064;\n458\t    readonly green: 3716964;\n459\t    readonly teal: 2453881;\n460\t    readonly navy: 2700911;\n461\t    readonly blue: 3890633;\n462\t    readonly sky: 4302582;\n463\t    readonly cyan: 7598071;\n464\t    readonly white: 16053492;\n465\t    readonly mist: 9744578;\n466\t    readonly slate: 5663878;\n467\t    readonly night: 3357783;\n468\t};\n469\texport type PaletteColor = keyof typeof PALETTE;\n470\t/** Whether a value names a PALETTE colour. */\n471\texport declare const isPaletteName: (v: unknown) => v is PaletteColor;\n472\t=================== render/sky\n473\t/**\n474\t * Time of day: a sun that rises in the east, crosses the sky and sets in the west, warm at\n475\t * dawn and dusk, a dim blue moon at night, with the ambient light, the sky colour and the fog\n476\t * colour following. `skyAt(hour)` is pure (keyframes interpolated, unit-tested); `applySky`\n477\t * puts it on an engine (the sun, its direction and shadows, the ambient light, the\n478\t * background). Levels unload back to the engine's defaults.\n479\t *\n480\t *   const s = skyAt(18.5);                 // 0..24\n481\t *   applySky(engine, s);                   // or read s.night to light the lanterns\n482\t */\n483\timport { Color, type Node } from 'three/webgpu';\n484\timport type { Engine } from '../Engine';\n485\texport interface SkyState {\n486\t    /** Unit vector toward the sun (or the moon, at night). */\n487\t    readonly sunDir: [number, number, number];\n488\t    readonly sunColor: number;\n489\t    readonly sunIntensity: number;\n490\t    readonly ambientColor: number;\n491\t    readonly ambientIntensity: number;\n492\t    /** Background (sky) and fog colour. */\n493\t    readonly sky: number;\n494\t    /** 0 by day, 1 deep at night: lanterns, stars, windows. */\n495\t    readonly night: number;\n496\t}\n497\t/** The sky at `hour` (wraps around 24). */\n498\texport declare function skyAt(hour: number): SkyState;\n499\t/** Put a sky on the engine: sun direction, colour and strength, ambient light, background. */\n500\texport declare function applySky(engine: Pick<Engine, 'sun' | 'ambient' | 'scene' | 'setSunDirection'>, s: SkyState): void;\n501\t/**\n502\t * Fog for `scene.fogNode` with live settings (uniforms: changing them never recompiles):\n503\t * ground mist that thickens below `top` (m) and a haze that grows with distance from the\n504\t * camera, both up to `amount` (0..1), in `color` (match the sky).\n505\t *\n506\t *   const mist = groundFog({ color: s.sky, top: 1.5 });\n507\t *   (scene as { fogNode: unknown }).fogNode = mist.node;\n508\t *   mist.amount.value = 0.8; mist.color.value.setHex(s.sky);\n509\t */\n510\texport declare function groundFog(o?: {\n511\t    color?: number;\n512\t    top?: number;\n513\t    amount?: number;\n514\t    near?: number;\n515\t    far?: number;\n516\t}): {\n517\t    node: Node;\n518\t    color: import(\"three/webgpu\").UniformNode<\"color\", Color>;\n519\t    amount: import(\"three/webgpu\").UniformNode<\"float\", number>;\n520\t    top: import(\"three/webgpu\").UniformNode<\"float\", number>;\n521\t};\n522\t=================== render/precipitation\n523\t/**\n524\t * Rain and snow: thousands of drops or flakes in one instanced draw, placed entirely by the\n525\t * vertex shader. Each drop's start comes from a hash of its instance index; it falls through a\n526\t * box of air around a centre (the camera's focus) whose x and z wrap in world space, so walking\n527\t * through the weather doesn't drag the drops sideways (the box's height follows the centre). Rain falls fast and slants with the wind; snow\n528\t * drifts and sways. `intensity` (0..1) shows that share of the drops: no buffers change, no\n529\t * shader recompiles. Splashes are left to the game (`splashes(dt)` says how many this frame).\n530\t *\n531\t *   const rain = new Precipitation({ kind: 'rain', count: 3000, area: [24, 14, 24] });\n532\t *   scene.add(rain);\n533\t *   // per frame: rain.update(dt, camera.focus); rain.intensity = 0.7; rain.wind.set(3, 0)\n534\t */\n535\timport { InstancedMesh, Vector2, Vector3 } from 'three/webgpu';\n536\texport type PrecipitationKind = 'rain' | 'snow';\n537\texport interface PrecipitationOptions {\n538\t    kind: PrecipitationKind;\n539\t    /** Most drops at once (the instance count). */\n540\t    count: number;\n541\t    /** Width, height and depth of the air the drops fall through, around the centre. */\n542\t    area?: readonly [number, number, number];\n543\t    /** Drop colour (hex). */\n544\t    color?: number;\n545\t    /** Fall speed (m/s). Rain 16, snow 1.4. */\n546\t    speed?: number;\n547\t}\n548\texport declare class Precipitation extends InstancedMesh {\n549\t    readonly kind: PrecipitationKind;\n550\t    readonly area: readonly [number, number, number];\n551\t    /** Wind (m/s along x and z): rain slants, snow drifts. */\n552\t    readonly wind: Vector2;\n553\t    private readonly uTime;\n554\t    private readonly uCenter;\n555\t    private readonly uWind;\n556\t    private readonly uIntensity;\n557\t    private readonly uSpeed;\n558\t    private t;\n559\t    constructor(o: PrecipitationOptions);\n560\t    /** Share of the drops falling (0..1). */\n561\t    get intensity(): number;\n562\t    set intensity(v: number);\n563\t    /** Fall speed (m/s). */\n564\t    get speed(): number;\n565\t    set speed(v: number);\n566\t    /** Per frame (game time): advance the fall and follow `center`. */\n567\t    update(dt: number, center: Vector3): void;\n568\t    /** How many drops hit the ground in `dt` seconds at this intensity (for splash particles, ripples). */\n569\t    splashes(dt: number): number;\n570\t    dispose(): this;\n571\t}\n572\t=================== render/grass\n573\t/**\n574\t * A meadow: thousands of grass blades in one instanced draw, bent by the vertex shader. Wind\n575\t * leans every blade and sends gusts across the field as visible waves; up to four pushers\n576\t * (the hero, a ball) part and flatten the blades around them. Blades are two crossed\n577\t * triangles (they read from any side), toon-lit as if they were the ground (an up normal), so\n578\t * they take the same light bands and shadows as the floor they stand on.\n579\t *\n580\t *   const grass = new GrassField({ area: [12, 8], at: [0, 0, 0], count: 6000 });\n581\t *   scene.add(grass);\n582\t *   // per frame: grass.update(t); grass.push(0, hero.position, 0.9)\n583\t *   grass.wind.set(2.5, 0.5);       // m/s-ish: direction and strength\n584\t */\n585\timport { InstancedMesh, Vector2, type Vector3Like } from 'three/webgpu';\n586\texport declare const MAX_PUSHERS = 4;\n587\texport interface GrassOptions {\n588\t    /** Width (x) and depth (z) of the patch, m. */\n589\t    area: readonly [number, number];\n590\t    /** Centre of the patch on the ground. */\n591\t    at: readonly [number, number, number];\n592\t    count: number;\n593\t    /** Blade heights (m): shortest and tallest. Default [0.25, 0.55]. */\n594\t    height?: readonly [number, number];\n595\t    /** Blade width at the root (m). Default 0.07. */\n596\t    width?: number;\n597\t    /** Colours (hex): roots and tips. */\n598\t    base?: number;\n599\t    tip?: number;\n600\t    /** Where blades grow (world x, z); default everywhere in the patch. */\n601\t    mask?: (x: number, z: number) => boolean;\n602\t    /** Ground height under a blade (default: the patch's y). */\n603\t    ground?: (x: number, z: number) => number;\n604\t    seed?: number;\n605\t}\n606\texport declare class GrassField extends InstancedMesh {\n607\t    /** Wind along x and z (its length is the strength). */\n608\t    readonly wind: Vector2;\n609\t    /** How far blades lean per unit of wind (m at the tip). Default 0.12. */\n610\t    sway: number;\n611\t    private readonly uTime;\n612\t    private readonly uWind;\n613\t    private readonly uSway;\n614\t    private readonly uPush;\n615\t    /** Blades actually placed (the mask can leave fewer than `count`). */\n616\t    readonly blades: number;\n617\t    constructor(o: GrassOptions);\n618\t    /** Pusher `i` (0..3): blades within `radius` of `at` part and flatten (radius 0: none). */\n619\t    push(i: number, at: Vector3Like | null, radius?: number): void;\n620\t    /** Per frame (game time). */\n621\t    update(time: number): void;\n622\t    dispose(): this;\n623\t}\n624\t=================== render/mirror\n625\t/**\n626\t * A flat mirror: before each frame a camera reflected in the mirror's plane draws the scene\n627\t * into a texture at the art resolution, and the glass shows it at each pixel's screen position\n628\t * (mirrored left to right), so the reflection lines up from wherever the camera looks. An\n629\t * oblique near plane (Lengyel) on that camera cuts away everything behind the glass; it works\n630\t * for orthographic cameras (the iso view) as well as perspective ones.\n631\t *\n632\t *   const mirror = new Mirror({ size: [8, 3] });\n633\t *   mirror.mesh.position.set(0, 1.8, -6.9);              // the glass faces its local +z\n634\t *   scene.add(mirror.mesh);\n635\t *   const stop = mirror.attach(engine.renderer, scene);  // renders before each frame\n636\t *\n637\t * The glass is on `SCREEN_LAYER`, so neither it nor other screens appear in the reflection.\n638\t */\n639\timport { type Camera, Mesh, Plane, RenderTarget, type Scene, type WebGPURenderer } from 'three/webgpu';\n640\timport type { View } from './view';\n641\texport interface MirrorOptions {\n642\t    /** Width and height of the glass (m). Default [4, 2]. */\n643\t    size?: readonly [number, number];\n644\t    /** A colour the reflection leans toward, and how much (0..1). Default a faint blue, 0.15. */\n645\t    tint?: number;\n646\t    tintAmount?: number;\n647\t}\n648\t/**\n649\t * Set `virtual` to `camera` reflected in `plane` (world space, its normal toward the side that\n650\t * is seen): the position, the way it looks and its up reflected (a proper rotation: the picture\n651\t * comes out mirrored left to right), and an oblique near plane on the mirror plane, so nothing\n652\t * behind it is drawn. Orthographic or perspective, either depth range. Returns `virtual`.\n653\t */\n654\texport declare function mirrorCamera<T extends Camera>(camera: Camera, virtual: T, plane: Plane): T;\n655\texport declare class Mirror {\n656\t    readonly mesh: Mesh;\n657\t    readonly target: RenderTarget;\n658\t    /** False: the glass shows plain glass and nothing is rendered for it. */\n659\t    enabled: boolean;\n660\t    /** Times it has rendered. */\n661\t    renders: number;\n662\t    private virtual;\n663\t    private readonly material;\n664\t    private readonly on;\n665\t    constructor(o?: MirrorOptions);\n666\t    /**\n667\t     * Reflect `camera` in the glass and draw `scene` from there into the texture (sized\n668\t     * `width` x `height`, the art resolution). Skipped when the camera is behind the glass.\n669\t     */\n670\t    render(renderer: WebGPURenderer, scene: Scene, camera: Camera, width: number, height: number): boolean;\n671\t    /**\n672\t     * Render before every frame of `view` (`engine.renderer`), from its camera, at its art size.\n673\t     * Returns a stop. Headless the hook is kept and never runs (nothing is drawn).\n674\t     */\n675\t    attach(view: View, scene: Scene): () => void;\n676\t    dispose(): void;\n677\t}\n678\t=================== render/toon\n679\timport { type ColorRepresentation, DataTexture, MeshBasicNodeMaterial, MeshToonNodeMaterial, type Object3D, type Texture, Vector2 } from 'three/webgpu';\n680\t/**\n681\t * PS1-style vertex snapping (\"wobble\"): clip-space vertices snap to the internal pixel\n682\t * grid. Off by default; the `ps1` filter switches it on (PixelRenderer drives these).\n683\t */\n684\texport declare const vertexSnap: {\n685\t    enabled: import(\"three/webgpu\").UniformNode<\"float\", number>;\n686\t    /** Internal resolution (art pixels). */\n687\t    resolution: import(\"three/webgpu\").UniformNode<\"vec2\", Vector2>;\n688\t};\n689\t/**\n690\t * The toon materials' vertex stage (clip position, snapped to the art grid while the `ps1`\n691\t * filter is on). Exported so procedural toon materials (`colorNode` from attributes) keep\n692\t * the same wobble as every other toon material.\n693\t */\n694\texport declare function snappedClipPosition(): import(\"three/webgpu\").VarNode<\"vec4\", import(\"three/webgpu\").JoinNode<\"vec4\">>;\n695\t/**\n696\t * 3-band toon ramp (shadow / mid / lit). Sampled with NearestFilter so light falls\n697\t * off in hard bands, the way hand-shaded sprites look. Values are 0..255 intensity.\n698\t */\n699\texport declare const TOON_BANDS: readonly [96, 176, 255];\n700\texport declare function toonGradient(): DataTexture;\n701\texport interface ToonMaterialOptions {\n702\t    /** Base color texture. Switched to nearest filtering (crisp texels, no mip blur). */\n703\t    map?: Texture | null;\n704\t    /** Multiply by the geometry's `color` attribute (vertex colors). */\n705\t    vertexColors?: boolean;\n706\t    /**\n707\t     * A hard-banded rim light in this colour (hex) on grazing, upward-facing surfaces: a\n708\t     * silhouette that reads against dark floors (monsters in dark levels). Added to the\n709\t     * emissive, so `material.emissive` (hit flashes) still works on top. Same shader for\n710\t     * every rim colour (the colour is a uniform).\n711\t     */\n712\t    rim?: number;\n713\t    /**\n714\t     * Pixel dissolve: the material reads its own `dissolve` property (0 = solid, 1 = gone)\n715\t     * and discards a per-art-pixel noise pattern below it, with a 1-pixel glowing front in\n716\t     * the rim colour (or white). Set it on per-body clones (`material.dissolve = 0.4`), not on\n717\t     * the shared cached material.\n718\t     */\n719\t    dissolve?: boolean;\n720\t}\n721\t/** A toon material made with `dissolve: true` has this property. */\n722\texport type DissolvableMaterial = MeshToonNodeMaterial & {\n723\t    dissolve: number;\n724\t};\n725\t/**\n726\t * Make a texture pixel-art friendly: nearest-neighbor sampling, no mipmaps. Returns it.\n727\t */\n728\texport declare function pixelTexture<T extends Texture>(texture: T): T;\n729\t/**\n730\t * Shared 3-band toon node material for a palette color, optionally textured and/or\n731\t * vertex-colored (color × map × vertex color), cached per combination. Untextured ones\n732\t * (and ones whose texture is itself shared, e.g. from a cached GLB) are marked\n733\t * `userData.shared`, so level unloads keep them; a material with a level's own texture is\n734\t * disposed with the level, and disposing it drops it from the cache.\n735\t */\n736\texport declare function toonMaterial(color: ColorRepresentation, options?: ToonMaterialOptions): MeshToonNodeMaterial;\n737\t/**\n738\t * Unlit, full-bright material for a colour (flames, eyes, screens, crystal cores), shared and\n739\t * cached per colour like `toonMaterial` (`userData.shared`; disposing it drops it from the\n740\t * cache). Its vertices snap with the toon materials' under the `ps1` filter, so a glowing part\n741\t * stays on its model.\n742\t */\n743\texport declare function glowMaterial(color: ColorRepresentation): MeshBasicNodeMaterial;\n744\texport interface ToonifyOptions {\n745\t    castShadow?: boolean;\n746\t    receiveShadow?: boolean;\n747\t}\n748\t/**\n749\t * Replace every mesh material under `root` with the shared toon material of the same base\n750\t * color, keeping its base color texture (`map`, nearest-filtered) and vertex colors. Makes\n751\t * any GLB (or hand-built mesh) match the engine's look without per-asset work.\n752\t */\n753\texport declare function toonify(root: Object3D, options?: ToonifyOptions): Object3D;\n754\t"}]},"parent_tool_use_id":null,"session_id":"3b81aee7-e493-4131-b722-c7c742e27493","uuid":"be0074ae-8715-44d9-8595-dc92f3c3d813","timestamp":"2026-11-05T23:24:20.354Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bm2rkhaay.txt","content":"=================== audio/AudioManager\nimport { type Song } from './music';\nimport { type SoundDef } from './synth';\nexport type VolumeChannel = 'master' | 'sfx' | 'music';\nexport interface AudioSettings {\n    master: number;\n    sfx: number;\n    music: number;\n    muted: boolean;\n}\nexport interface PlayOptions {\n    /** 0..1 multiplier on the sound's own volume. */\n    volume?: number;\n    /** Pitch shift in semitones (playback rate), e.g. a rising combo. */\n    pitch?: number;\n    /** Stereo position -1 (left) .. 1 (right). */\n    pan?: number;\n}\nexport interface VoiceSettings {\n    /** 0..1 (default 1). */\n    volume?: number;\n    /** Stereo position -1 (left) .. 1 (right). */\n    pan?: number;\n    /** 0 (clear) .. 1 (behind a thick wall, under water): a low-pass filter closing down. */\n    muffle?: number;\n    /** Pitch shift in semitones. */\n    pitch?: number;\n}\n/** A looping sound steered while it plays (`AudioManager.loop`): a hum, a fire, a waterfall. */\nexport interface Voice {\n    readonly name: string;\n    /** The values last set (kept headless too, so games and tests can read them). */\n    readonly settings: Readonly<Required<VoiceSettings>>;\n    /** Really sounding: Web Audio running and the loop started. */\n    readonly sounding: boolean;\n    readonly stopped: boolean;\n    /** Change any of its settings; they glide over a few hundredths of a second (no clicks). */\n    set(s: VoiceSettings): void;\n    stop(): void;\n}\n/** Low-pass cutoff (Hz) for a muffle of 0..1: wide open to a dull thud. */\nexport declare const muffleCutoff: (muffle: number) => number;\n/**\n * Web Audio for games: procedural retro sound effects (`SFX`, data), a small chiptune\n * sequencer (`Song`, data), optional audio files, and master / sfx / music volume + mute\n * persisted in localStorage. Available as `ctx.audio`.\n *\n * Browsers only allow sound after a user gesture, so the AudioContext is created on the\n * first key / pointer / touch input. Before that, and wherever Web Audio does not exist\n * (headless tests, old browsers), every call is a silent no-op that still records what\n * was played in `log`, so games behave identically and tests can assert on sounds.\n */\nexport declare class AudioManager {\n    /** Sound registry: the built-in SFX plus anything registered or loaded. */\n    readonly sounds: Map<string, SoundDef>;\n    /** The most recent plays (name and game-independent wall time), newest last; tooling/tests. */\n    readonly log: {\n        name: string;\n        at: number;\n    }[];\n    /** How many times each sound was requested. */\n    readonly counts: Record<string, number>;\n    context: AudioContext | null;\n    private master;\n    private buses;\n    private readonly settings;\n    private readonly buffers;\n    private readonly files;\n    private readonly pendingFiles;\n    private unlockListeners;\n    private readonly lifetime;\n    private song;\n    private songName;\n    private readonly musicSources;\n    private readonly voices;\n    /** Files being fetched or decoded (a loop waiting for one is not missing its sound). */\n    private readonly loading;\n    private disposed;\n    constructor(target?: EventTarget | null);\n    /** Web Audio exists in this environment. */\n    static get supported(): boolean;\n    /** True once the AudioContext is running (after the first user input). */\n    get unlocked(): boolean;\n    /** Current volumes and mute (persisted). */\n    get volume(): Readonly<AudioSettings>;\n    get muted(): boolean;\n    /** Name of the playing song ('' when none). */\n    get playing(): string;\n    /**\n     * Create / resume the AudioContext. Called automatically on the first user input; call\n     * it yourself from a click handler if you start sound from your own UI.\n     */\n    unlock(): void;\n    private target;\n    /** Listen for the next user input (until the context is running). */\n    private armUnlock;\n    private disarmUnlock;\n    /** Resume a suspended / interrupted context; stop listening for input once it runs. */\n    private resume;\n    /** Add or replace a sound effect (data, see SoundDef). */\n    register(name: string, def: SoundDef): void;\n    /**\n     * Play a sound effect by name (built-in SFX, `register`ed or `load`ed) or directly from a\n     * SoundDef. Returns false when nothing could be heard (locked, muted, no Web Audio).\n     */\n    play(sound: string | SoundDef, options?: PlayOptions): boolean;\n    /**\n     * Start a sound looping, as a voice you steer while it plays (volume, pan, muffle, pitch:\n     * with `spatialize` it sits at a place in the world). Before the first user input, or with\n     * no Web Audio, the voice keeps its settings silently and starts once audio unlocks.\n     * Stop it when you are done (a level's `dispose`).\n     */\n    loop(sound: string | SoundDef, settings?: VoiceSettings): Voice;\n    /** Voices playing or waiting to (tooling and tests). */\n    get loops(): readonly Voice[];\n    /** Stop every looping voice (the engine does this when a level unloads). */\n    stopLoops(): void;\n    /**\n     * Load an audio file (wav/ogg/mp3…) under `name`; `play(name)` then plays it. Works\n     * before the first user input too: the file is decoded once audio unlocks.\n     */\n    load(name: string, url: string): Promise<void>;\n    /** Start a song (looping by default), replacing the current one. `null` stops music. */\n    playMusic(song: Song | null, name?: string): void;\n    stopMusic(): void;\n    /**\n     * Volume changes are written to storage. The engine turns this off while a replay plays: the\n     * recording sets the volumes it set, nothing is written, and the player's come back after.\n     */\n    persist: boolean;\n    setVolume(channel: VolumeChannel, value: number): void;\n    setMuted(muted: boolean): void;\n    toggleMute(): boolean;\n    /** The default volumes, sound on (the settings panel's Reset). */\n    resetVolumes(): void;\n    /** Engine: once per rendered frame. Schedules the next notes of the song. */\n    update(): void;\n    /** Stop everything and close the AudioContext. */\n    dispose(): void;\n    private start;\n    private bufferFor;\n    private toBuffer;\n    private decode;\n    private applyVolumes;\n}\n=================== audio/music\nimport { type SoundDef } from './synth';\n/** A track's instrument: a SoundDef without pitch or length (each note sets those). */\nexport type Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>;\n/**\n * A chiptune song as data. Each pattern holds one string per track: space-separated steps,\n * where a step is a note ('C4', 'F#5', 'Bb2'), '.' (rest) or '-' (hold the previous note).\n * Every track of a pattern must have the same number of steps. For `noise` tracks the\n * note's pitch is the noise rate: C6 is a snare-ish hiss, C8 a hi-hat tick.\n */\nexport interface Song {\n    bpm: number;\n    /** Steps per beat (4 = sixteenth notes). Default 4. */\n    stepsPerBeat?: number;\n    tracks: Record<string, Instrument>;\n    patterns: Record<string, Record<string, string>>;\n    /** Pattern names in play order. */\n    order: readonly string[];\n    /** Loop forever (default true). */\n    loop?: boolean;\n}\nexport interface SongNote {\n    track: string;\n    /** Step index from the start of the song. */\n    step: number;\n    /** Length in steps (1 + following holds). */\n    steps: number;\n    freq: number;\n}\nexport interface ParsedSong {\n    /** Seconds per step. */\n    stepTime: number;\n    /** Total steps in one pass of `order`. */\n    length: number;\n    notes: SongNote[];\n}\n/** Flatten a song into timed notes. Throws on malformed patterns, so tests catch typos. */\nexport declare function parseSong(song: Song): ParsedSong;\n/** The playable SoundDef for one note of a track. */\nexport declare function noteSound(instrument: Instrument, freq: number, seconds: number): SoundDef;\n/** The playground's short looping track: C major, bouncy, 2 × 16 steps. */\nexport declare const PLAYGROUND_SONG: Song;\n=================== audio/synth\n/**\n * Retro sound synthesis as pure functions (no Web Audio): a sound is data (`SoundDef`)\n * rendered to samples once, then played as a buffer. Deterministic (seeded noise), so\n * sounds are unit-testable and identical on every machine.\n */\nexport type Wave = 'square' | 'triangle' | 'saw' | 'sine' | 'noise';\nexport interface SoundDef {\n    wave: Wave;\n    /** Start pitch in Hz. For `noise` it is the sample-and-hold rate (higher = hissier). */\n    freq: number;\n    /** End pitch for a sweep (exponential glide from `freq`). */\n    freqEnd?: number;\n    /** Seconds the sweep takes (default: the whole sound). */\n    sweepTime?: number;\n    /** Square duty cycle: 0.125, 0.25 or 0.5 are the classic NES widths. Default 0.5. */\n    duty?: number;\n    /** Envelope (seconds): ramp up, hold at full volume, then fade out. */\n    attack?: number;\n    sustain?: number;\n    decay?: number;\n    /** Peak level 0..1 (default 0.5). */\n    volume?: number;\n    /** Arpeggio: semitone offsets stepped every `arpRate` seconds (the coin \"ba-ding\"). */\n    arp?: readonly number[];\n    arpRate?: number;\n    /** Vibrato depth in semitones and rate in Hz. */\n    vibrato?: {\n        depth: number;\n        rate: number;\n    };\n    /** Quantize to this many levels (4-bit style crunch). 0 = off. */\n    crush?: number;\n    /** Seconds of silence before the sound starts (for layers). */\n    delay?: number;\n    /** Extra sounds mixed in (e.g. a noise burst under a thump). */\n    layers?: readonly SoundDef[];\n}\n/** Seconds a sound lasts, including delays and layers. */\nexport declare function soundDuration(def: SoundDef): number;\n/** Envelope gain 0..1 at time `t` (seconds since the sound's own start). */\nexport declare function envelope(def: SoundDef, t: number): number;\n/** Instantaneous frequency (Hz) at time `t`: sweep, arpeggio and vibrato applied. */\nexport declare function frequencyAt(def: SoundDef, t: number): number;\n/** Small deterministic PRNG (mulberry32). */\nexport declare function rng(seed?: number): () => number;\n/** Render a sound to mono samples in -1..1. */\nexport declare function renderSound(def: SoundDef, sampleRate?: number, seed?: number): Float32Array<ArrayBuffer>;\n/** 'A4' → 440, 'C#5', 'Eb3'… Returns null for anything that is not a note. */\nexport declare function noteFrequency(note: string): number | null;\n=================== audio/sfx\n/**\n * Built-in retro sound effects, as data. Tweak numbers here (or register your own with\n * `ctx.audio.register(name, def)`) and every `ctx.audio.play(name)` picks them up.\n * See docs/engine/audio.md for the SoundDef fields.\n */\nexport declare const SFX: {\n    /** Short rising square chirp. */\n    jump: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Higher, thinner chirp with a fifth on top. */\n    doubleJump: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Soft thud: a falling triangle under a short noise puff. */\n    land: {\n        wave: \"triangle\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"noise\";\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** The classic two-note pickup (B5 → E6). */\n    coin: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** A tiny tick per footstep. */\n    step: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n    };\n    /** Shoe squeal: hissy noise plus a wobbling high square. */\n    skid: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"square\";\n            duty: number;\n            freq: number;\n            freqEnd: number;\n            vibrato: {\n                depth: number;\n                rate: number;\n            };\n            attack: number;\n            sustain: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Whack: noise burst over a dropping square. */\n    punch: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n        layers: {\n            wave: \"square\";\n            duty: number;\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Big low boom for the ground-pound impact. */\n    groundPound: {\n        wave: \"triangle\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n        crush: number;\n        layers: {\n            wave: \"noise\";\n            freq: number;\n            freqEnd: number;\n            attack: number;\n            decay: number;\n            volume: number;\n        }[];\n    };\n    /** Spin-up whoosh before the pound falls. */\n    whoosh: {\n        wave: \"noise\";\n        freq: number;\n        freqEnd: number;\n        attack: number;\n        decay: number;\n        volume: number;\n    };\n    /** Descending, wobbly \"ouch\". */\n    hurt: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        freqEnd: number;\n        vibrato: {\n            depth: number;\n            rate: number;\n        };\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n    /** Victory fanfare arpeggio. */\n    fanfare: {\n        wave: \"square\";\n        duty: number;\n        freq: number;\n        arp: number[];\n        arpRate: number;\n        attack: number;\n        sustain: number;\n        decay: number;\n        volume: number;\n    };\n};\nexport type SfxName = keyof typeof SFX;\n=================== audio/spatial\n/**\n * Sound in space: how loud and how far left or right a sound at a point is for a listener\n * (the camera, or the hero's ears). Pure maths, so it is unit-tested and the same in a\n * headless run; `AudioManager.loop()` voices take the result.\n *\n *   const hum = ctx.audio.loop('hum');\n *   const s = spatialize({ position: ears, right: cameraRight }, generator.position, { ref: 2, max: 25 });\n *   hum.set({ volume: s.gain * (blocked ? 0.4 : 1), pan: s.pan, muffle: blocked ? 0.8 : 0 });\n */\nexport type V3Like = readonly [number, number, number] | {\n    readonly x: number;\n    readonly y: number;\n    readonly z: number;\n};\nexport interface Listener {\n    position: V3Like;\n    /** The listener's right, in world space (unit): the camera's right for a third-person game. */\n    right: V3Like;\n}\nexport interface SpatialOptions {\n    /** Within this distance (m) the sound is at full volume (default 1). */\n    ref?: number;\n    /** Silent from this distance on (default 30); it fades out over the last fifth. */\n    max?: number;\n    /** How fast it falls off past `ref` (default 1: inverse distance, the way sound really does). */\n    rolloff?: number;\n}\nexport interface Spatial {\n    /** 0..1 volume. */\n    gain: number;\n    /** -1 (left) .. 1 (right). */\n    pan: number;\n    distance: number;\n}\n/** Volume at `distance` (m): 1 inside `ref`, then inverse distance, fading to 0 at `max`. */\nexport declare function attenuation(distance: number, o?: SpatialOptions): number;\n/** Gain and pan of a sound at `at` for `listener`. */\nexport declare function spatialize(listener: Listener, at: V3Like, o?: SpatialOptions): Spatial;\n=================== palette\n/**\n * Restrained 16-color palette (Sweetie 16 by GrafxKid). Every color in a game should come\n * from here: authentic pixel art reads as \"designed\" because the palette is small.\n * Keep in sync with scripts/generate-assets.mjs.\n */\nexport declare const PALETTE: {\n    readonly ink: 1711148;\n    readonly plum: 6104925;\n    readonly red: 11615827;\n    readonly orange: 15695191;\n    readonly sand: 16764277;\n    readonly lime: 11006064;\n    readonly green: 3716964;\n    readonly teal: 2453881;\n    readonly navy: 2700911;\n    readonly blue: 3890633;\n    readonly sky: 4302582;\n    readonly cyan: 7598071;\n    readonly white: 16053492;\n    readonly mist: 9744578;\n    readonly slate: 5663878;\n    readonly night: 3357783;\n};\nexport type PaletteColor = keyof typeof PALETTE;\n/** Whether a value names a PALETTE colour. */\nexport declare const isPaletteName: (v: unknown) => v is PaletteColor;\n=================== render/sky\n/**\n * Time of day: a sun that rises in the east, crosses the sky and sets in the west, warm at\n * dawn and dusk, a dim blue moon at night, with the ambient light, the sky colour and the fog\n * colour following. `skyAt(hour)` is pure (keyframes interpolated, unit-tested); `applySky`\n * puts it on an engine (the sun, its direction and shadows, the ambient light, the\n * background). Levels unload back to the engine's defaults.\n *\n *   const s = skyAt(18.5);                 // 0..24\n *   applySky(engine, s);                   // or read s.night to light the lanterns\n */\nimport { Color, type Node } from 'three/webgpu';\nimport type { Engine } from '../Engine';\nexport interface SkyState {\n    /** Unit vector toward the sun (or the moon, at night). */\n    readonly sunDir: [number, number, number];\n    readonly sunColor: number;\n    readonly sunIntensity: number;\n    readonly ambientColor: number;\n    readonly ambientIntensity: number;\n    /** Background (sky) and fog colour. */\n    readonly sky: number;\n    /** 0 by day, 1 deep at night: lanterns, stars, windows. */\n    readonly night: number;\n}\n/** The sky at `hour` (wraps around 24). */\nexport declare function skyAt(hour: number): SkyState;\n/** Put a sky on the engine: sun direction, colour and strength, ambient light, background. */\nexport declare function applySky(engine: Pick<Engine, 'sun' | 'ambient' | 'scene' | 'setSunDirection'>, s: SkyState): void;\n/**\n * Fog for `scene.fogNode` with live settings (uniforms: changing them never recompiles):\n * ground mist that thickens below `top` (m) and a haze that grows with distance from the\n * camera, both up to `amount` (0..1), in `color` (match the sky).\n *\n *   const mist = groundFog({ color: s.sky, top: 1.5 });\n *   (scene as { fogNode: unknown }).fogNode = mist.node;\n *   mist.amount.value = 0.8; mist.color.value.setHex(s.sky);\n */\nexport declare function groundFog(o?: {\n    color?: number;\n    top?: number;\n    amount?: number;\n    near?: number;\n    far?: number;\n}): {\n    node: Node;\n    color: import(\"three/webgpu\").UniformNode<\"color\", Color>;\n    amount: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    top: import(\"three/webgpu\").UniformNode<\"float\", number>;\n};\n=================== render/precipitation\n/**\n * Rain and snow: thousands of drops or flakes in one instanced draw, placed entirely by the\n * vertex shader. Each drop's start comes from a hash of its instance index; it falls through a\n * box of air around a centre (the camera's focus) whose x and z wrap in world space, so walking\n * through the weather doesn't drag the drops sideways (the box's height follows the centre). Rain falls fast and slants with the wind; snow\n * drifts and sways. `intensity` (0..1) shows that share of the drops: no buffers change, no\n * shader recompiles. Splashes are left to the game (`splashes(dt)` says how many this frame).\n *\n *   const rain = new Precipitation({ kind: 'rain', count: 3000, area: [24, 14, 24] });\n *   scene.add(rain);\n *   // per frame: rain.update(dt, camera.focus); rain.intensity = 0.7; rain.wind.set(3, 0)\n */\nimport { InstancedMesh, Vector2, Vector3 } from 'three/webgpu';\nexport type PrecipitationKind = 'rain' | 'snow';\nexport interface PrecipitationOptions {\n    kind: PrecipitationKind;\n    /** Most drops at once (the instance count). */\n    count: number;\n    /** Width, height and depth of the air the drops fall through, around the centre. */\n    area?: readonly [number, number, number];\n    /** Drop colour (hex). */\n    color?: number;\n    /** Fall speed (m/s). Rain 16, snow 1.4. */\n    speed?: number;\n}\nexport declare class Precipitation extends InstancedMesh {\n    readonly kind: PrecipitationKind;\n    readonly area: readonly [number, number, number];\n    /** Wind (m/s along x and z): rain slants, snow drifts. */\n    readonly wind: Vector2;\n    private readonly uTime;\n    private readonly uCenter;\n    private readonly uWind;\n    private readonly uIntensity;\n    private readonly uSpeed;\n    private t;\n    constructor(o: PrecipitationOptions);\n    /** Share of the drops falling (0..1). */\n    get intensity(): number;\n    set intensity(v: number);\n    /** Fall speed (m/s). */\n    get speed(): number;\n    set speed(v: number);\n    /** Per frame (game time): advance the fall and follow `center`. */\n    update(dt: number, center: Vector3): void;\n    /** How many drops hit the ground in `dt` seconds at this intensity (for splash particles, ripples). */\n    splashes(dt: number): number;\n    dispose(): this;\n}\n=================== render/grass\n/**\n * A meadow: thousands of grass blades in one instanced draw, bent by the vertex shader. Wind\n * leans every blade and sends gusts across the field as visible waves; up to four pushers\n * (the hero, a ball) part and flatten the blades around them. Blades are two crossed\n * triangles (they read from any side), toon-lit as if they were the ground (an up normal), so\n * they take the same light bands and shadows as the floor they stand on.\n *\n *   const grass = new GrassField({ area: [12, 8], at: [0, 0, 0], count: 6000 });\n *   scene.add(grass);\n *   // per frame: grass.update(t); grass.push(0, hero.position, 0.9)\n *   grass.wind.set(2.5, 0.5);       // m/s-ish: direction and strength\n */\nimport { InstancedMesh, Vector2, type Vector3Like } from 'three/webgpu';\nexport declare const MAX_PUSHERS = 4;\nexport interface GrassOptions {\n    /** Width (x) and depth (z) of the patch, m. */\n    area: readonly [number, number];\n    /** Centre of the patch on the ground. */\n    at: readonly [number, number, number];\n    count: number;\n    /** Blade heights (m): shortest and tallest. Default [0.25, 0.55]. */\n    height?: readonly [number, number];\n    /** Blade width at the root (m). Default 0.07. */\n    width?: number;\n    /** Colours (hex): roots and tips. */\n    base?: number;\n    tip?: number;\n    /** Where blades grow (world x, z); default everywhere in the patch. */\n    mask?: (x: number, z: number) => boolean;\n    /** Ground height under a blade (default: the patch's y). */\n    ground?: (x: number, z: number) => number;\n    seed?: number;\n}\nexport declare class GrassField extends InstancedMesh {\n    /** Wind along x and z (its length is the strength). */\n    readonly wind: Vector2;\n    /** How far blades lean per unit of wind (m at the tip). Default 0.12. */\n    sway: number;\n    private readonly uTime;\n    private readonly uWind;\n    private readonly uSway;\n    private readonly uPush;\n    /** Blades actually placed (the mask can leave fewer than `count`). */\n    readonly blades: number;\n    constructor(o: GrassOptions);\n    /** Pusher `i` (0..3): blades within `radius` of `at` part and flatten (radius 0: none). */\n    push(i: number, at: Vector3Like | null, radius?: number): void;\n    /** Per frame (game time). */\n    update(time: number): void;\n    dispose(): this;\n}\n=================== render/mirror\n/**\n * A flat mirror: before each frame a camera reflected in the mirror's plane draws the scene\n * into a texture at the art resolution, and the glass shows it at each pixel's screen position\n * (mirrored left to right), so the reflection lines up from wherever the camera looks. An\n * oblique near plane (Lengyel) on that camera cuts away everything behind the glass; it works\n * for orthographic cameras (the iso view) as well as perspective ones.\n *\n *   const mirror = new Mirror({ size: [8, 3] });\n *   mirror.mesh.position.set(0, 1.8, -6.9);              // the glass faces its local +z\n *   scene.add(mirror.mesh);\n *   const stop = mirror.attach(engine.renderer, scene);  // renders before each frame\n *\n * The glass is on `SCREEN_LAYER`, so neither it nor other screens appear in the reflection.\n */\nimport { type Camera, Mesh, Plane, RenderTarget, type Scene, type WebGPURenderer } from 'three/webgpu';\nimport type { View } from './view';\nexport interface MirrorOptions {\n    /** Width and height of the glass (m). Default [4, 2]. */\n    size?: readonly [number, number];\n    /** A colour the reflection leans toward, and how much (0..1). Default a faint blue, 0.15. */\n    tint?: number;\n    tintAmount?: number;\n}\n/**\n * Set `virtual` to `camera` reflected in `plane` (world space, its normal toward the side that\n * is seen): the position, the way it looks and its up reflected (a proper rotation: the picture\n * comes out mirrored left to right), and an oblique near plane on the mirror plane, so nothing\n * behind it is drawn. Orthographic or perspective, either depth range. Returns `virtual`.\n */\nexport declare function mirrorCamera<T extends Camera>(camera: Camera, virtual: T, plane: Plane): T;\nexport declare class Mirror {\n    readonly mesh: Mesh;\n    readonly target: RenderTarget;\n    /** False: the glass shows plain glass and nothing is rendered for it. */\n    enabled: boolean;\n    /** Times it has rendered. */\n    renders: number;\n    private virtual;\n    private readonly material;\n    private readonly on;\n    constructor(o?: MirrorOptions);\n    /**\n     * Reflect `camera` in the glass and draw `scene` from there into the texture (sized\n     * `width` x `height`, the art resolution). Skipped when the camera is behind the glass.\n     */\n    render(renderer: WebGPURenderer, scene: Scene, camera: Camera, width: number, height: number): boolean;\n    /**\n     * Render before every frame of `view` (`engine.renderer`), from its camera, at its art size.\n     * Returns a stop. Headless the hook is kept and never runs (nothing is drawn).\n     */\n    attach(view: View, scene: Scene): () => void;\n    dispose(): void;\n}\n=================== render/toon\nimport { type ColorRepresentation, DataTexture, MeshBasicNodeMaterial, MeshToonNodeMaterial, type Object3D, type Texture, Vector2 } from 'three/webgpu';\n/**\n * PS1-style vertex snapping (\"wobble\"): clip-space vertices snap to the internal pixel\n * grid. Off by default; the `ps1` filter switches it on (PixelRenderer drives these).\n */\nexport declare const vertexSnap: {\n    enabled: import(\"three/webgpu\").UniformNode<\"float\", number>;\n    /** Internal resolution (art pixels). */\n    resolution: import(\"three/webgpu\").UniformNode<\"vec2\", Vector2>;\n};\n/**\n * The toon materials' vertex stage (clip position, snapped to the art grid while the `ps1`\n * filter is on). Exported so procedural toon materials (`colorNode` from attributes) keep\n * the same wobble as every other toon material.\n */\nexport declare function snappedClipPosition(): import(\"three/webgpu\").VarNode<\"vec4\", import(\"three/webgpu\").JoinNode<\"vec4\">>;\n/**\n * 3-band toon ramp (shadow / mid / lit). Sampled with NearestFilter so light falls\n * off in hard bands, the way hand-shaded sprites look. Values are 0..255 intensity.\n */\nexport declare const TOON_BANDS: readonly [96, 176, 255];\nexport declare function toonGradient(): DataTexture;\nexport interface ToonMaterialOptions {\n    /** Base color texture. Switched to nearest filtering (crisp texels, no mip blur). */\n    map?: Texture | null;\n    /** Multiply by the geometry's `color` attribute (vertex colors). */\n    vertexColors?: boolean;\n    /**\n     * A hard-banded rim light in this colour (hex) on grazing, upward-facing surfaces: a\n     * silhouette that reads against dark floors (monsters in dark levels). Added to the\n     * emissive, so `material.emissive` (hit flashes) still works on top. Same shader for\n     * every rim colour (the colour is a uniform).\n     */\n    rim?: number;\n    /**\n     * Pixel dissolve: the material reads its own `dissolve` property (0 = solid, 1 = gone)\n     * and discards a per-art-pixel noise pattern below it, with a 1-pixel glowing front in\n     * the rim colour (or white). Set it on per-body clones (`material.dissolve = 0.4`), not on\n     * the shared cached material.\n     */\n    dissolve?: boolean;\n}\n/** A toon material made with `dissolve: true` has this property. */\nexport type DissolvableMaterial = MeshToonNodeMaterial & {\n    dissolve: number;\n};\n/**\n * Make a texture pixel-art friendly: nearest-neighbor sampling, no mipmaps. Returns it.\n */\nexport declare function pixelTexture<T extends Texture>(texture: T): T;\n/**\n * Shared 3-band toon node material for a palette color, optionally textured and/or\n * vertex-colored (color × map × vertex color), cached per combination. Untextured ones\n * (and ones whose texture is itself shared, e.g. from a cached GLB) are marked\n * `userData.shared`, so level unloads keep them; a material with a level's own texture is\n * disposed with the level, and disposing it drops it from the cache.\n */\nexport declare function toonMaterial(color: ColorRepresentation, options?: ToonMaterialOptions): MeshToonNodeMaterial;\n/**\n * Unlit, full-bright material for a colour (flames, eyes, screens, crystal cores), shared and\n * cached per colour like `toonMaterial` (`userData.shared`; disposing it drops it from the\n * cache). Its vertices snap with the toon materials' under the `ps1` filter, so a glowing part\n * stays on its model.\n */\nexport declare function glowMaterial(color: ColorRepresentation): MeshBasicNodeMaterial;\nexport interface ToonifyOptions {\n    castShadow?: boolean;\n    receiveShadow?: boolean;\n}\n/**\n * Replace every mesh material under `root` with the shared toon material of the same base\n * color, keeping its base color texture (`map`, nearest-filtered) and vertex colors. Makes\n * any GLB (or hand-built mesh) match the engine's look without per-asset work.\n */\nexport declare function toonify(root: Object3D, options?: ToonifyOptions): Object3D;\n","numLines":754,"startLine":1,"totalLines":754}},"tool_result_meta":[{"id":"toolu_018WXgLRMi7wAU7EcnChQnnZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeHBTK3uHdkksgtHpFd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EAPx3XBYyZRc8VUxpAz5eM","name":"Read","input":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bq45f86os.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26004,"cache_read_input_tokens":86459,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26004},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3b81aee7-e493-4131-b722-c7c742e27493","uuid":"ffde48da-2c8a-4839-8bce-b8c801ef09ae","timestamp":"2026-11-05T23:24:21.356Z","request_id":"req_011CgkeHBER6ryYLLcwA9b1V","wire_tool_inputs":{"toolu_01EAPx3XBYyZRc8VUxpAz5eM":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-max-plan-v2--20261105-162054--x00d3db-work/3b81aee7-e493-4131-b722-c7c742e27493/tool-results/bq45f86os.txt"}}}
