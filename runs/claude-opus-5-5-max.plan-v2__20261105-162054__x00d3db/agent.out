age, which covers only the main features."],"durationSeconds":6.572899134999839,"searchCount":1},"tool_result_meta":[{"id":"toolu_01R4S3bhLJN5k4B9NESCEmNY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
