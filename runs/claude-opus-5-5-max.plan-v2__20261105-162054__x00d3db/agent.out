layers=4&latency=150&jitter=50&loss=5\" \"players=2&scenario=server\" > log_c.txt 2>&1; echo exit $?; cut -c1-200 log_c.txt | grep -v \"^   OK\" | tail -12; grep -c \"   OK\" log_c.txt); cd $W/proto/v2 && cat > t2.py <<'EOF'\nimport sys, json, functools\nprint = functools.partial(print, flush=True)\nfrom playwright.sync_api import sync_playwright\nARGS = ['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader']\nurl=sys.argv[1]\nwith sync_playwright() as p:\n    b=p.chromium.launch(args=ARGS,headless=True); ctx=b.new_context(viewport={'width':1920,'height':1080}); pg=ctx.new_page()\n    pg.goto(url+'?cam=%7B%22preset%22:%22iso%22,%22yaw%22:45,%22pitch%22:35,%22zoom%22:1.6,%22minZoom%22:1.6,%22maxZoom%22:1.6%7D'); pg.wait_for_function('window.__E && window.__E.frame>3',timeout=120000)\n    print('zoom before',pg.evaluate('window.__E.camera.zoom'))\n    pg.mouse.move(900,500); pg.evaluate(\"\"\"()=>{window.__wheelSeen=0; const g=window.__G; const u=g.update.bind(g); g.update=(c,d)=>{u(c,d); if(c.input.wheel) window.__wheelSeen+=c.input.wheel;};}\"\"\")\n    for i in range(4): pg.mouse.wheel(0,240); pg.wait_for_timeout(150)\n    pg.keyboard.press('Equal'); pg.wait_for_timeout(200)\n    print('zoom after wheel & +',pg.evaluate('window.__E.camera.zoom'),'wheel ticks seen in update',pg.evaluate('window.__wheelSeen'))\n    t=pg.evaluate(\"\"\"()=>{const e=window.__E;const t0=performance.now();let o=[];for(let i=0;i<20;i++){const z=1.6+i*0.02;e.setCamera({preset:'iso',yaw:45,pitch:35,zoom:z,minZoom:z,maxZoom:z},{syncUrl:false});}return {ms:performance.now()-t0,zoom:e.camera.zoom,minmax:[e.camera.minZoom,e.camera.maxZoom],loc:location.search.length};}\"\"\")\n    print('tween by setCamera',t)\n    pg.close(); b.close()\nEOF\ntimeout 90 python3 t2.py \"file://$W/proto/v2/v2.html\" 2>&1 | cut -c1-300","description":"Confirm byte-identical engine passes the Hub harness and test wheel lock with c