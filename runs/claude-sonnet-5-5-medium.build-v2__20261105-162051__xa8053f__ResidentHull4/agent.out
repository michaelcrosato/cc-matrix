 hp: 50, speed: [0, 0], dmg: 22, windup: 1.0, range: 22, ranged: 'harpoon', model: 'harpooner', money: [60, 90] },\n  ansgar: { id: 'ansgar', name: 'MATE ANSGAR', hp: 400, speed: [1.5, 1.5], dmg: 30, windup: 1.0, range: 2.2, model: 'ansgar', money: [0, 0], boss: true, scale: 1.15 },\n};\nexport const BARKS = ['HAAL AN!', 'SKARR!', 'VOR THOLE!', 'BRINNA!', 'OV THE TIDE!', 'VEN ULDA!'];\nEOF\necho done"}},"wire_ingest_context":{"toolu_01FigfadKaK1uyGf7pnt7NFg":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/work/ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051"}}}
