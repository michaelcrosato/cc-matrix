 = Math.sin(cy), fz = Math.cos(cy), rx = -Math.cos(cy), rz = Math.sin(cy);\n    i.my = dx * fx + dz * fz; i.mx = dx * rx + dz * rz;\n    if (!avoid) { /* keep moving */ }\n    // face the direction of travel with the camera (so explore turning is natural)\n    this.look.yaw = Math.atan2(dx, dz); this.look.pitch = 0.05;\n    this.look.soft = true;\n  }\n  lookStep(a, dt) {\n    const L = this.look; if (L.yaw === null) { return { dyaw: 0, dpitch: 0 }; }\n    const c = a.cam; const rate = L.soft ? 3.2 : this.opts.turnRate * 1.0;\n    L.soft = false;\n    const dyaw = clamp(angleDiff(c.yaw, L.yaw), -rate * dt, rate * dt);\n    const dpitch = clamp(L.pitch - c.pitch, -rate * 0.8 * dt, rate * 0.8 * dt);\n    return { dyaw, dpitch };\n  }\n}\nEOF\ncat > tools/scratch/t12.mjs <<'EOF'\nimport { Engine } from '../../pixel-engine.js';\nimport { Area } from '../../src/game/area.js';\nimport { quay } from '../../src/data/levels/quay.js';\nimport { app } from '../../src/core/app.js';\nimport { Bot } from '../../src/game/bot.js';\nconst area = new Area(quay, {});\nconst bot = new Bot({ cheat: false, teleportStuck: true }).attach(area);\nconst e = await Engine.headless(area, {}); app.engine = e;\ne.step(10);\nconst a = e.game;\na.player.teleport(18.5, 12);\nfor (let i = 0; i < 8; i++) a.spawn('gaffer', 18.5 + i * 0.5, 2 - i * 0.5, { state: 'APPROACH' });\na.spawn('bottler', 20, -2, { state: 'APPROACH' });\nlet k = 0;\nfor (let s = 0; s < 40; s++) { e.step(60); if (s % 5 === 4) console.log(s + 1, 's', a.status(), 'mag', a.run.mags.pistol, 'ammo', a.run.ammo('pistol'), 'tok', a.tokensInUse, 'rank', a.rank.toFixed(2)); if (a.player.dead) { console.log('DEAD'); break; } }\nconsole.log(e.errors.slice(0,3), a.enemies.map((x) => x.type[0] + ':' + x.state + ':' + Math.round(x.hp)).join(' '));\nEOF\nnode tools/scratch/t12.mjs 2>&1 | grep -v \"^\\`\" | cut -c1-300 | tail -14"}},"wire_ingest_context":{"toolu_01KuTiUAMZ2BNZWZ2Y6RudyF":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-me