 session: o.session || null })); };\n  app.openLobby = (kind) => app.push(new LobbyScreen(kind));\n  app.startAttract = () => startAttract();\n  window.__APP__ = app;\n}\n'''\ns=s[:a]+new\nopen(p,'w').write(s)\np='src/game/shift.js'\ns=open(p).read()\ns=s.replace(\"{ ...o, shift: true, run: o.run || shiftRun(), noPause: true, noSave: true }\",\"{ ...o, shift: true, run: o.run || shiftRun(), noPause: !!app.hub, noSave: true }\")\nopen(p,'w').write(s)\np='src/game/area.js'\ns=open(p).read()\ns=s.replace(\"if (keys.wasPressed('Escape', 'KeyP', 'PadOptions') && !(keys.isDown('PadCreate') && device_isPad())) this.openPause?.();\",\"if (keys.wasPressed('Escape', 'KeyP', 'PadOptions') && !keys.isDown('PadCreate')) this.openPause?.();\")\ns=s.replace(\"function device_isPad() { return false; }\\n\",\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/screens/attract.js <<'EOF'\n// Attract mode: a looping AI-played demo. Any input exits. A director over a list of clips; the bot cheats freely.\nimport { app } from '../core/app.js';\nimport { ui } from '../core/ui.js';\nimport { TITLE } from '../config.js';\nimport { device } from '../core/device.js';\n\nexport function startAttract() { app.attractRun?.stop?.(); }\nexport const ATTRACT = { clips: [] };\nEOF\nnode --check src/core/boot.js && echo ok"}},"wire_ingest_context":{"toolu_01Q9XaRJt33SpkuZWY5frv7a":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/work/ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051"}}}
