{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkePJaqrfPaLUnU18ig8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AV6uaKPwpdXVkkpkFM4NKh","name":"Bash","input":{"command":"cat > src/audio/sfx.js <<'EOF'\n// All sound effects are data: SoundDef layers rendered by the engine. No audio files.\nconst N = (freq, decay, volume, extra = {}) => ({ wave: 'noise', freq, decay, volume, ...extra });\nexport const SFX_DEFS = {\n  pistol: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 120, decay: 0.12, volume: 0.45, layers: [N(9000, 0.09, 0.5), { wave: 'sine', freq: 90, freqEnd: 40, decay: 0.16, volume: 0.6 }] },\n  scatter: { wave: 'saw', freq: 300, freqEnd: 50, decay: 0.3, volume: 0.45, layers: [N(5000, 0.32, 0.7), { wave: 'sine', freq: 70, freqEnd: 30, decay: 0.3, volume: 0.7 }] },\n  rifle: { wave: 'square', duty: 0.25, freq: 1400, freqEnd: 90, decay: 0.2, volume: 0.5, layers: [N(8000, 0.22, 0.55), { wave: 'sine', freq: 110, freqEnd: 35, decay: 0.4, volume: 0.5, delay: 0.02 }] },\n  harpoon: { wave: 'saw', freq: 220, freqEnd: 600, decay: 0.15, volume: 0.4, layers: [{ wave: 'sine', freq: 70, freqEnd: 40, decay: 0.2, volume: 0.7 }, N(2500, 0.1, 0.3, { delay: 0.05 })] },\n  dry: { wave: 'square', freq: 300, decay: 0.03, volume: 0.3, layers: [N(3000, 0.03, 0.2)] },\n  reload1: { wave: 'square', freq: 500, freqEnd: 300, decay: 0.05, volume: 0.3, layers: [N(4000, 0.05, 0.3)] },\n  reload2: { wave: 'square', freq: 260, freqEnd: 700, decay: 0.06, volume: 0.3, layers: [N(2500, 0.08, 0.3, { delay: 0.06 })] },\n  reload3: { wave: 'square', duty: 0.25, freq: 700, decay: 0.05, volume: 0.35, layers: [{ wave: 'square', freq: 350, decay: 0.08, volume: 0.3, delay: 0.07 }] },\n  kick: { wave: 'sine', freq: 200, freqEnd: 50, decay: 0.2, volume: 0.7, layers: [N(1500, 0.18, 0.6), { wave: 'saw', freq: 120, freqEnd: 40, decay: 0.12, volume: 0.3 }] },\n  whoosh: N(1200, 0.2, 0.3, { attack: 0.05 }),\n  knife: { wave: 'saw', freq: 1800, freqEnd: 700, decay: 0.09, volume: 0.25, layers: [N(7000, 0.08, 0.25)] },\n  hit: { wave: 'square', freq: 220, freqEnd: 80, decay: 0.08, volume: 0.4, layers: [N(1800, 0.09, 0.4)] },\n  headhit: { wave: 'square', freq: 520, freqEnd: 110, decay: 0.1, volume: 0.45, layers: [N(3000, 0.12, 0.45), { wave: 'sine', freq: 90, decay: 0.15, volume: 0.5 }] },\n  headpop: { wave: 'noise', freq: 800, decay: 0.3, volume: 0.7, layers: [{ wave: 'sine', freq: 140, freqEnd: 30, decay: 0.35, volume: 0.8 }, { wave: 'saw', freq: 600, freqEnd: 80, decay: 0.2, volume: 0.3 }] },\n  grunt: { wave: 'saw', freq: 140, freqEnd: 70, decay: 0.15, volume: 0.35, layers: [N(600, 0.12, 0.2)] },\n  gruntB: { wave: 'saw', freq: 190, freqEnd: 90, decay: 0.17, volume: 0.35, layers: [N(900, 0.1, 0.2)] },\n  shout: { wave: 'saw', freq: 170, freqEnd: 260, decay: 0.28, volume: 0.35, vibrato: { depth: 1, rate: 12 } },\n  doorkick: { wave: 'sine', freq: 130, freqEnd: 40, decay: 0.3, volume: 0.7, layers: [N(700, 0.25, 0.6), N(2500, 0.1, 0.3)] },\n  glass: { wave: 'square', freq: 3200, freqEnd: 1400, decay: 0.2, volume: 0.25, layers: [N(9500, 0.3, 0.4), { wave: 'square', freq: 4300, freqEnd: 2000, decay: 0.15, volume: 0.15, delay: 0.04 }] },\n  ladder: { wave: 'square', freq: 180, decay: 0.05, volume: 0.3, layers: [N(1200, 0.05, 0.3), { wave: 'square', freq: 220, decay: 0.05, volume: 0.25, delay: 0.12 }] },\n  crate: { wave: 'noise', freq: 1100, decay: 0.3, volume: 0.6, layers: [{ wave: 'square', freq: 160, freqEnd: 60, decay: 0.15, volume: 0.4 }] },\n  barrel: { wave: 'noise', freq: 400, decay: 0.7, volume: 0.9, layers: [{ wave: 'sine', freq: 70, freqEnd: 25, decay: 0.7, volume: 0.9 }, { wave: 'saw', freq: 300, freqEnd: 40, decay: 0.4, volume: 0.4 }] },\n  flare: { wave: 'noise', freq: 9000, decay: 0.8, sustain: 0.6, volume: 0.4, layers: [{ wave: 'saw', freq: 1500, freqEnd: 800, decay: 0.8, volume: 0.15 }] },\n  depth: { wave: 'sine', freq: 90, freqEnd: 20, decay: 1.0, volume: 0.9, layers: [N(300, 0.9, 0.8), { wave: 'saw', freq: 60, decay: 0.7, volume: 0.4 }] },\n  fire: { wave: 'noise', freq: 600, decay: 0.5, sustain: 0.4, volume: 0.25, layers: [N(2200, 0.5, 0.15, { delay: 0.1 })] },\n  tannoyOn: { wave: 'noise', freq: 4000, decay: 0.25, volume: 0.35, layers: [{ wave: 'square', freq: 1100, freqEnd: 800, decay: 0.2, volume: 0.15 }] },\n  tannoyOff: { wave: 'noise', freq: 7000, decay: 0.2, volume: 0.45, layers: [{ wave: 'square', freq: 800, freqEnd: 90, decay: 0.2, volume: 0.25 }, { wave: 'saw', freq: 2400, freqEnd: 200, decay: 0.15, volume: 0.2 }] },\n  tannoyHit: { wave: 'square', freq: 2400, freqEnd: 300, decay: 0.12, volume: 0.35, layers: [N(8000, 0.2, 0.5)] },\n  foghorn: { wave: 'saw', freq: 58, decay: 3.2, attack: 0.6, sustain: 1.8, volume: 0.9, layers: [{ wave: 'saw', freq: 87, decay: 3.2, attack: 0.8, sustain: 1.6, volume: 0.6 }, { wave: 'square', freq: 29, decay: 3.2, attack: 0.5, sustain: 1.9, volume: 0.7 }, { wave: 'sine', freq: 116, decay: 3.2, attack: 1, sustain: 1.2, volume: 0.4, vibrato: { depth: 0.1, rate: 2 } }] },\n  saw: { wave: 'saw', freq: 95, decay: 0.5, sustain: 0.4, volume: 0.35, vibrato: { depth: 0.6, rate: 24 }, layers: [N(3000, 0.5, 0.15, { sustain: 0.4 })] },\n  sawLunge: { wave: 'saw', freq: 140, freqEnd: 260, decay: 0.6, volume: 0.45, vibrato: { depth: 1.2, rate: 30 } },\n  steam: N(5000, 0.7, 0.4, { attack: 0.1, sustain: 0.3 }),\n  rain: N(7000, 1.2, 0.18, { sustain: 1 }),\n  sea: N(350, 2, 0.3, { attack: 0.8, sustain: 1.2, layers: [N(120, 2, 0.2)] }),\n  gull: { wave: 'saw', freq: 1500, freqEnd: 900, decay: 0.35, volume: 0.12, vibrato: { depth: 4, rate: 9 } },\n  belt: N(180, 0.4, 0.25, { sustain: 0.2, layers: [{ wave: 'square', freq: 60, decay: 0.2, volume: 0.15 }] }),\n  crane: { wave: 'saw', freq: 70, decay: 0.6, sustain: 0.4, volume: 0.25, vibrato: { depth: 0.3, rate: 5 } },\n  chain: { wave: 'square', freq: 1200, freqEnd: 700, decay: 0.05, volume: 0.25, layers: [N(6000, 0.05, 0.3), { wave: 'square', freq: 1500, decay: 0.04, volume: 0.2,