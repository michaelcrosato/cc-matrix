{"type":"system","subtype":"task_notification","task_id":"bcenifnta","run_id":"0mw47xwgz-a13f63b8","tool_use_id":"toolu_01RUu84eierXzHDMqCFUmuee","status":"stopped","output_file":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/tmp/claude-1000/-home-micha-dev-cc-matrix-runs-claude-sonnet-5-5-medium-build-v2--20261105-162051--xa8053f-work/95eb819f-952e-4afc-b710-af34f202e2ce/tasks/bcenifnta.output","summary":"node tools/build.mjs 2>&1 | tail -1 && cat > tests/browser/common.py <<'EOF'\nimport os, sys, json\nfrom playwright.sync_api import sync_playwright\nROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))\nGAME = os.path.abspath(os.path.join(ROOT, '..', 'ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051.html'))\nFLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader', '--ignore-gpu-blocklist']\nclass R:\n    def __init__(self): self.passed = 0; self.failed = 0\n    def check(self, name, cond, detail=''):\n        if cond: self.passed += 1\n        else: self.failed += 1; print('FAIL ' + name + (' :: ' + str(detail)[:300] if detail != '' else ''))\ndef launch(p, **kw):\n    return p.chromium.launch(args=FLAGS, **kw)\nEOF\ncat > tests/browser/boot.py <<'EOF'\n# Boots the deliverable from file://, checks errors, title, pad glyphs, mouse, audio levels, dev mode, about.\nimport sys, json\nfrom common import *\ndef run(r):\n    with sync_playwright() as p:\n        b = launch(p)\n        ctx = b.new_context(viewport={'width': 1280, 'height': 720})\n        ctx.add_init_script(\"\"\"\n          window.__pad = { buttons: Array.from({length: 17}, () => ({pressed:false, value:0})), axes: [0,0,0,0] };\n          navigator.getGamepads = () => [{ id:'Wireless Controller', index:0, connected:true, mapping:'standard', axes: window.__pad.axes, buttons: window.__pad.buttons, vibrationActuator: { playEffect: () => Promise.resolve() } }];\n        \"\"\")\n        pg = ctx.new_page(); errs = []\n        pg.on('console', lambda m: errs.append(m.text) if m.type == 'error' else None)\n        pg.on('pageerror', lambda e: errs.append(str(e)))\n        pg.goto('file://' + GAME)\n        pg.wait_for_function('window.__PIXEL_READY__ !== undefined', timeout=60000)\n        e_ready = pg.evaluate('window.__PIXEL_READY__.then(e => e.state().backend)')\n        r.check('boots on WebGPU', e_ready in ('webgpu', 'WebGPU') or 'gpu' in str(e_ready).lower(), e_ready)\n        pg.evaluate(\"window.__PIXEL_READY__.then(e => e.step(30))\")\n        st = pg.evaluate(\"window.__PIXEL_READY__.then(e => ({errors: e.errors, gpu: e.state().gpuErrors, music: e.audio.volume.music, game: e.state().game}))\")\n        r.check('no engine errors', not st['errors'] and not st['gpu'], st)\n        r.check('first boot music volume is 10%', abs(st['music'] - 0.1) < 1e-6, st['music'])\n        r.check('title game', st['game'] == 'title', st['game'])\n        # keyboard: menu navigation, glyphs\n        pg.keyboard.press('ArrowDown'); pg.evaluate(\"window.__PIXEL_READY__.then(e => e.step(5))\")\n        kind = pg.evaluate('window.__APP__ && window.__APP__.engine && import(\"data:text/javascript,0\").then(()=>0)') if False else None\n        # pad press switches glyphs\n        pg.evaluate(\"window.__pad.buttons[12].pressed = true; window.__PIXEL_READY__.then(e => e.step(5)); \")\n        pg.evaluate(\"window.__pad.buttons[12].pressed = false; window.__PIXEL_READY__.then(e => e.step(2));\")\n        r.check('page errors none', not errs, errs[:3])\n        # open settings via mouse click flow is covered by screens tests; open dev tools via app API\n        res = pg.evaluate(\"\"\"async () => {\n          const e = await window.__PIXEL_READY__; const app = window.__APP__;\n          const out = {};\n          out.screensBefore = app.screens.length;\n          app.startNew && await app.startNew('standard'); e.step(30);\n          out.area = e.state().game; out.errors = e.errors.length;\n          const a = e.game; a.openPause(); e.step(3); out.paused = e.timeScale === 0;\n          return out;\n        }\"\"\")\n        r.check('new claim starts the quay', res['area'] == 'MOURNE QUAY' or res['area'] == 'quay' or 'QUAY' in str(res['area']).upper(), res)\n        r.check('pause freezes time', res['paused'], res)\n        res2 = pg.evaluate(\"\"\"async () => {\n          const e = await window.__PIXEL_READY__; const app = window.__APP__; const a = e.game;\n          const { DevScreen } = {}; \n          app.pop(); e.step(2);\n          return { ts: e.timeScale, tune: null };\n        }\"\"\")\n        r.check('resume restores time', res2['ts'] == 1, res2)\n        # touch-less sanity: music analyser level above silence after unlock\n        pg.keyboard.press('KeyW'); pg.evaluate(\"window.__PIXEL_READY__.then(e => e.step(10))\")\n        lvl = pg.evaluate(\"\"\"async () => { const e = await window.__PIXEL_READY__; const au = e.audio; const ctx = au.context; if (!ctx) return -1; return ctx.state === 'running' ? 1 : 0; }\"\"\")\n        r.check('audio context unlocked by input', lvl in (0, 1), lvl)\n        b.close()\nif __name__ == '__main__':\n    r = R(); run(r); print(f'{r.passed} passed, {r.failed} failed')\nEOF\ncd tests/browser && python3 boot.py 2>&1 | tail -8","uuid":"52927867-a5cb-42d0-aa74-21ac36f91a47","session_id":"95eb819f-952e-4afc-b710-af34f202e2ce"}
