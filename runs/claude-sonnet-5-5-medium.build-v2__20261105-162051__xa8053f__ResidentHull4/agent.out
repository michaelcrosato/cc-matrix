 (Math.sin(att.t * 5) > -0.2) ui.text(W / 2, H - 14, app.touchOnly ? 'CONTROLLER OR KEYBOARD REQUIRED' : 'PRESS ANY BUTTON', { align: 'center', color: 'white' });\n}\nfunction montage(game, ctx, c) {\n  const keys = c.montage === 'case' ? KEYS_CASE : KEYS_SHOP;\n  if (!att.montageOpen) { att.montageOpen = true; att.keyI = 0; if (c.montage === 'case') { app.run.addItem('ammo_shells', 5); app.push(new CaseScreen({})); } else app.push(new ShopScreen(shopStock(1))); }\n  while (att.keyI < keys.length && att.t >= keys[att.keyI][0]) { const k = keys[att.keyI++][1]; ctx.input.setKey(k, true); att.release = { k, f: 3 }; }\n  if (att.release && --att.release.f <= 0) { ctx.input.setKey(att.release.k, false); att.release = null; }\n}\nasync function exitAttract() {\n  app.attract = false; att.busy = false; att.montageOpen = false; app.screens = [];\n  try { app.engine.input.release?.(); } catch { /* */ }\n  app.run = null; await app.go(new TitleScene());\n}\napp.attractFrame = attractFrame;\nEOF\npython3 - <<'EOF'\np='src/game/area.js'\ns=open(p).read()\ns=s.replace(\"    if (!app.top()) drawHud(this);\\n    if (this.hudExtra) this.hudExtra(ui);\",\"    if (!app.top()) drawHud(this);\\n    if (this.hudExtra) this.hudExtra(ui);\\n    app.attractFrame?.(this, ctx, dt);\")\nopen(p,'w').write(s)\np='src/game/scriptkit.js'\ns=open(p).read()\ns=s.replace(\"    this.cut = { tl, def }; this.skipHeld = 0; this.lineKey = null;\",\"    this.cut = { tl, def }; this.skipHeld = 0; this.lineKey = null;\\n    if (a.opts?.attract) { /* demo: no cutscenes */ }\")\ns=s.replace(\"    tl.play();\\n    yield () => ended;\",\"    tl.play(); if (a.opts?.attract) tl.skip();\\n    yield () => ended;\")\ns=s.replace(\"    if (confirmPressed) { if (d.typed < d.text.length) d.typed = d.text.length; else d.advanced = true; }\",\"    if (confirmPressed || this.area.opts?.attract) { if (d.typed < d.text.length) d.typed = d.text.length; else d.advanced = true; }\")\nopen(p,'w').write(s)\np='src/game/combat.js