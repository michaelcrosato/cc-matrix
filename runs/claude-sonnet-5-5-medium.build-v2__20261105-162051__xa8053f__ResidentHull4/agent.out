. C2 . . . C2 . C2 .', hat: '. C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 .' },\n      b: { brass: 'Ab2 - . Ab2 - . Ab2 . Bb2 - . Bb2 - . G2 .', drive: 'Ab3 Ab3 Eb4 Ab3 Ab3 Eb4 Ab3 Eb4 G3 G3 D4 G3 G3 D4 G3 D4', toll: 'Ab1 . . . . . . . . . . . . . . .', kick: 'C2 . . . C2 . . . C2 . . . C2 . C2 C2', hat: '. C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8' },\n    },\n    order: ['a', 'a', 'b', 'a', 'b', 'b'],\n  },\n  onhold: {\n    bpm: 96,\n    tracks: {\n      lead: { wave: 'square', duty: 0.25, attack: 0.01, decay: 0.25, volume: 0.4 },\n      comp: { wave: 'triangle', attack: 0.01, decay: 0.2, volume: 0.6 },\n      bass: { wave: 'triangle', attack: 0.005, decay: 0.2, volume: 0.9 },\n    },\n    patterns: {\n      a: { lead: 'E5 . G5 . E5 . C5 . D5 . F5 . D5 . B4 .', comp: 'C4 . E4 . C4 . E4 . B3 . D4 . B3 . D4 .', bass: 'C3 . . G2 . . C3 . G2 . . D3 . . G2 .' },\n      b: { lead: 'A4 . C5 . E5 . C5 . G4 . B4 . D5 . . .', comp: 'A3 . C4 . A3 . C4 . G3 . B3 . G3 . B3 .', bass: 'A2 . . E2 . . A2 . G2 . . D3 . . G2 .' },\n    },\n    order: ['a', 'b', 'a', 'b'],\n  },\n  tide1: {\n    bpm: 100,\n    tracks: { bass: { wave: 'saw', attack: 0.01, decay: 0.3, volume: 0.6 }, arp: { wave: 'square', duty: 0.125, attack: 0.001, decay: 0.1, volume: 0.35 }, hat: { wave: 'noise', attack: 0.001, decay: 0.04, volume: 0.3 } },\n    patterns: { a: { bass: 'A1 . . . A1 . . . A1 . . . A1 . . .', arp: 'A3 C4 E4 C4 A3 C4 E4 C4 A3 C4 E4 C4 A3 C4 E4 C4', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' } },\n    order: ['a', 'a'],\n  },\n  tide2: {\n    bpm: 112,\n    tracks: { bass: { wave: 'saw', attack: 0.01, decay: 0.3, volume: 0.6 }, arp: { wave: 'square', duty: 0.125, attack: 0.001, decay: 0.1, volume: 0.35 }, hat: { wave: 'noise', attack: 0.001, decay: 0.04, volume: 0.3 } },\n    patterns: { a: { bass: 'B1 . . . B1 . . . B1 . . . B1 . . .', arp: 'B3 D4 F#4 D4 B3 D4 F#4 D4 B3 D4 F#4 D4 B3 D4 F#4 D4', hat: '. C8 C8 . . C8 C8 . . C8 C8 . . C8 C8 .' } },\n    order: ['a', 'a'],\n  },\n  tide3: {\n    bpm: 126,\n    tracks: { bass: { wave: 'saw', attack: 0.01, decay: 0.3, volume: 0.6 }, arp: { wave: 'square', duty: 0.125, attack: 0.001, decay: 0.1, volume: 0.35 }, hat: { wave: 'noise', attack: 0.001, decay: 0.04, volume: 0.3 } },\n    patterns: { a: { bass: 'C2 . C2 . C2 . C2 . C2 . C2 . C2 . C2 .', arp: 'C4 Eb4 G4 Eb4 C4 Eb4 G4 Eb4 C4 Eb4 G4 Eb4 C4 Eb4 G4 Eb4', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8' } },\n    order: ['a', 'a'],\n  },\n  dawn: {\n    bpm: 84, loop: false,\n    tracks: { lead: { wave: 'triangle', attack: 0.02, decay: 0.8, volume: 0.7 }, pad: { wave: 'sine', attack: 0.3, decay: 1.5, volume: 0.5 } },\n    patterns: { a: { lead: 'C4 . E4 . G4 . C5 - - - E5 - - - - -', pad: 'C3 - - - - - - - G3 - - - - - - -' }, b: { lead: 'G4 - - - E5 - - - C5 - - - - - - -', pad: 'F3 - - - - - - - C3 - - - - - - -' } },\n    order: ['a', 'b'],\n  },\n};\n// Quiet tension for the crypt (a low drone, no tune).\nSONGS.drone = { bpm: 48, tracks: { low: { wave: 'saw', attack: 0.6, decay: 2, volume: 0.35 }, high: { wave: 'sine', attack: 1, decay: 2, volume: 0.15 } }, patterns: { a: { low: 'C2 - - - - - - - - - - - - - - -', high: '. . . . . . . . Db5 - - - - - - -' } }, order: ['a'] };\nexport const MOOD_SONG = { dusk: 'explore', rain: 'explore', abbey: 'explore', quiet: null };\nEOF\ncat > src/audio/mix.js <<'EOF'\n// Music through a small fader: fade down, swap, fade up to the player's level. Silence is part of the score.\nimport { SONGS } from './songs.js';\nimport { settings } from '../core/settings.js';\nexport class Mix {\n  constructor(audio) { this.audio = audio; this.cur = null; this.want = null; this.gain = 1; this.fade = 0; this.state = 'idle'; this.pending = false; }\n  play(name) { if (name === this.want) return; this.want = name; this.pending = true; }\n  stop() { this.play(null); }\n  /** Call every frame with real-ish dt (menus too). */\n  update(dt) {\n    const a = this.audio;\n    const level = settings.music;\n    if (this.pending) {\n      if (this.cur && this.gain > 0.02) { this.gain = Math.max(0, this.gain - dt / 0.35); }\n      else {\n        this.gain = 0;\n        if (this.want) a.playMusic(SONGS[this.want], this.want); else a.stopMusic();\n        this.cur = this.want; this.pending = false;\n      }\n    } else if (this.gain < 1) this.gain = Math.min(1, this.gain + dt / 0.6);\n    a.setVolume('music', level * this.gain);\n  }\n}\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish-style gibberish: syllables pre-registered per speaker, one played every 2 letters.\nimport { settings } from '../core/settings.js';\nexport const SPEAKERS = {\n  MAX: { wave: 'triangle', freq: 170, decay: 0.09, color: 'sand' },\n  DAME: { wave: 'square', duty: 0.25, freq: 320, decay: 0.07, vibrato: { depth: 0.5, rate: 14 }, color: 'mist' },\n  COMMODORE: { wave: 'square', duty: 0.5, freq: 260, decay: 0.1, crush: 8, noise: true, color: 'red' },\n  FATHOM: { wave: 'triangle', freq: 110, decay: 0.16, bubble: true, color: 'green' },\n  PYM: { wave: 'sine', freq: 200, decay: 0.09, crush: 6, color: 'cyan' },\n  MENDER: { wave: 'saw', freq: 120, decay: 0.12, color: 'orange' },\n  NILS: { wave: 'saw', freq: 140, decay: 0.1, color: 'sky' },\n  ISLANDER: { wave: 'saw', freq: 120, decay: 0.13, color: 'orange' },\n  MONK: { wave: 'sine', freq: 85, decay: 0.3, chant: true, color: 'mist' },\n  BOSUN: { wave: 'saw', freq: 60, decay: 0.7, color: 'red' },\n  ANSGAR: { wave: 'saw', freq: 100, decay: 0.12, color: 'orange' },\n};\nconst VOW = [1, 1.12, 0.89, 1.26, 0.79];\nexport function registerVoices(audio) {\n  for (const [name, s] of Object.entries(SPEAKERS)) {\n    for (let v = 0; v < 5; v++) {\n      for (let c = 0; c < 2; c++) {\n        const def = { wave: s.wave, duty: s.duty, freq: s.freq * VOW[v], freqEnd: s.freq * VOW[v] * (c ? 0.9 : 1.06), attack: c ? 0.002 : 0.012, decay: s.decay, volume: 0.35, vibrato: s.vibrato, crush: s.crush };\n        const layers = [];\n        if (c) layers.push({ wave: 'noise', freq: 3500, decay: 0.03, volume: 0.22 });\n        if (s.noise) layers.push({ wave: 'noise', freq: 6000, decay: s.decay * 1.4, volume: 0.1 });\n        if (s.chant) { layers.push({ wave: 'sine', freq: s.freq * VOW[v] * 1.5, decay: s.decay, volume: 0.25 }, { wave: 'sine', freq: s.freq * VOW[v] * 2, decay: s.decay, volume: 0.15 }); }\n        if (s.bubble && v === 2) layers.push({ wave: 'sine', freq: 500, freqEnd: 1000, decay: 0.08, volume: 0.2, delay: 0.05 });\n        if (layers.length) def.layers = layers;\n        audio.register(`v_${name}_${v}_${c}`, def);\n      }\n    }\n  }\n}\nfunction hash(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }\nexport function wordAt(text, i) {\n  let a = i, b = i;\n  while (a > 0 && text[a - 1] !== ' ') a--;\n  while (b < text.length && text[b] !== ' ') b++;\n  return text.slice(a, b);\n}\n/** The plan for the blip at character i (pure, testable). Returns null on spaces and silent punctuation. */\nexport function blipPlan(speaker, text, i) {\n  const ch = text[i];\n  if (!ch || ch === ' ' || /[.,;:!?'-]/.test(ch)) return null;\n  if (i % 2 !== 0) return null;\n  const word = wordAt(text, i);\n  const h = hash(word.replace(/[^A-Z0-9]/gi, '').toLowerCase());\n  const base = ((h % 9) - 4) * 0.9;\n  const rest = text.slice(i);\n  const endPunct = /^[A-Za-z0-9']*([.?!,])/.exec(rest);\n  let bend = 0, vol = 1;\n  if (endPunct) { if (endPunct[1] === '.') bend = -2.5; else if (endPunct[1] === '?') bend = 3; else if (endPunct[1] === '!') { vol = 1.3; bend = 1; } }\n  const v = (ch.charCodeAt(0) + h) % 5, c = (i >> 1) % 2;\n  return { name: `v_${speaker}_${v}_${c}`, pitch: base + bend, volume: vol };\n}\nexport function blip(audio, speaker, text, i, pan = 0) {\n  if (!SPEAKERS[speaker]) speaker = 'ISLANDER';\n  const p = blipPlan(speaker, text.toUpperCase(), i);\n  if (!p) return false;\n  audio.play(p.name, { pitch: p.pitch, volume: Math.min(1, p.volume * settings.voice), pan });\n  return true;\n}\nEOF\ncat > tools/scratch/t2.mjs <<'EOF'\nimport { parseSong, renderSound } from '../../pixel-engine.js';\nimport { SONGS } from '../../src/audio/songs.js';\nimport { SFX_DEFS } from '../../src/audio/sfx.js';\nfor (const [k, s] of Object.entries(SONGS)) { try { const p = parseSong(s); console.log(k, 'ok', p.notes?.length ?? Object.keys(p)); } catch (e) { console.log(k, 'ERR', e.message); } }\nlet bad = 0;\nfor (const [k, d] of Object.entries(SFX_DEFS)) { const s = renderSound(d); let m = 0; for (const v of s) m = Math.max(m, Math.abs(v)); if (m < 0.01 || m > 1) { bad++; console.log('sfx', k, m); } }\nconsole.log('sfx bad', bad);\nEOF\nnode tools/scratch/t2.mjs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7104,"cache_read_input_tokens":196852,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7104},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"95eb819f-952e-4afc-b710-af34f202e2ce","uuid":"5b0544d1-9c2b-4669-b085-86ca7a5918ff","timestamp":"2026-11-05T23:27:08.378Z","request_id":"req_011CgkeSQ6ZvnsyndMsZwmi5","wire_tool_inputs":{"toolu_01PAT5CETCCUySRYmUQqZH27":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/work/ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051 && cat > src/audio/songs.js <<'EOF'\n// Original compositions as Song data. Loud tracks, because music defaults to 10%.\nconst rep = (s, n) => Array(n).fill(s).join(' ');\nexport const SONGS = {\n  title: {\n    bpm: 66,\n    tracks: {\n      drone: { wave: 'saw', attack: 0.4, decay: 0.8, volume: 0.35 },\n      bell: { wave: 'sine', attack: 0.01, decay: 1.6, volume: 0.7 },\n      mel: { wave: 'triangle', attack: 0.05, decay: 0.7, volume: 0.65 },\n    },\n    patterns: {\n      a: { drone: 'D2 - - - - - - - - - - - - - - -', bell: 'D4 . . . . . . . A3 . . . . . . .', mel: '. . . . F4 - - . E4 - - - D4 - - -' },\n      b: { drone: 'Bb1 - - - - - - - - - - - - - - -', bell: 'Bb3 . . . . . . . F3 . . . . . . .', mel: 'D5 - - - C5 - - . A4 - - - . . . .' },\n      c: { drone: 'G1 - - - - - - - - - - - - - - -', bell: 'G3 . . . . . . . D4 . . . . . . .', mel: '. . A4 - - - F4 - - - E4 - - - - -' },\n    },\n    order: ['a', 'b', 'a', 'c'],\n  },\n  explore: {\n    bpm: 72,\n    tracks: {\n      bass: { wave: 'triangle', attack: 0.01, decay: 0.5, volume: 0.9 },\n      pad: { wave: 'sine', attack: 0.3, decay: 1.2, volume: 0.45 },\n      phrase: { wave: 'square', duty: 0.125, attack: 0.02, decay: 0.4, volume: 0.35 },\n    },\n    patterns: {\n      a: { bass: 'A2 . . . . . A2 . . . E2 . . . . .', pad: 'A3 - - - - - - - - - - - - - - -', phrase: '. . . . . . . . . . . . . . . .' },\n      b: { bass: 'F2 . . . . . F2 . . . C2 . . . . .', pad: 'F3 - - - - - - - - - - - - - - -', phrase: '. . . . E5 . . . C5 . . . . . . .' },\n      c: { bass: 'A2 . . . . . A2 . . . E2 . . . G2 .', pad: 'A3 - - - - - - - E3 - - - - - - -', phrase: '. . . . . . . . . . A4 . . . . .' },\n      d: { bass: 'E2 . . . . . E2 . . . B1 . . . . .', pad: 'E3 - - - - - - - - - - - - - - -', phrase: 'B4 . . C5 . . B4 . . . . . . . . .' },\n    },\n    order: ['a', 'b', 'c', 'd'],\n  },\n  combat: {\n    bpm: 132,\n    tracks: {\n      ost: { wave: 'square', duty: 0.25, attack: 0.005, decay: 0.12, volume: 0.45 },\n      bass: { wave: 'saw', attack: 0.005, decay: 0.2, volume: 0.5 },\n      hat: { wave: 'noise', attack: 0.001, decay: 0.04, volume: 0.35 },\n      kick: { wave: 'sine', attack: 0.001, decay: 0.15, volume: 0.9 },\n    },\n    patterns: {\n      a: { ost: 'E4 E4 G4 E4 B4 E4 G4 E4 E4 E4 G4 E4 A4 E4 G4 E4', bass: 'E2 . E2 . E2 . E2 . E2 . E2 . G2 . A2 .', hat: '. C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8', k