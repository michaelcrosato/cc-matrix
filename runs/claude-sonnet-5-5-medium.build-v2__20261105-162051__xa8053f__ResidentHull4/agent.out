{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkgBBJx3UASCmiGE8WfU","type":"message","role":"assistant","content":[{"type":"text","text":"Status: building Chapter 1's data and scripts now: arrival cutscene, cottage fight, Fathom's intro, the siege, the Foghorn and the aftermath."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5281,"cache_read_input_tokens":439734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5281},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"95eb819f-952e-4afc-b710-af34f202e2ce","uuid":"09bf9e2c-47c1-471d-aa0b-4010dccb0b41","timestamp":"2026-11-05T23:49:11.488Z","request_id":"req_011CgkgBAybk9MbgpvfX7Ur1"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkgBBJx3UASCmiGE8WfU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012XREiMfH1pApUwZKiBzo5k","name":"Bash","input":{"command":"cat > src/data/dialogue.js <<'EOF'\n// All spoken text: Tannoy lines, scripted scenes. Uppercase, no em dashes, no accents.\nexport const TANNOY_LINES = [\n  'A REMINDER: THE FISH MARKET IS CLOSED. THE FISH HAVE WON.',\n  'MISS RANSOM, I HAVE READ YOUR POLICY. I FIND IT RESTRICTIVE.',\n  'WHO IS SHOOTING MY LOUDSPEAKERS? THOSE ARE IMPORTED.',\n  'I AM TOLD YOU WEAR SUNGLASSES AT NIGHT. HOW BRAVE. HOW STUPID.',\n  'OUR HYMN TODAY IS NUMBER NINE. OUR SURVIVORS TODAY ARE NUMBER NONE.',\n  'THE BOSUN WOULD LIKE A WORD. HE ONLY HAS THE ONE.',\n  'DAME OTTOLINE, YOUR GREAT-GRANDFATHER SIGNED IN BLOOD. I HAVE BROUGHT A PEN. IT IS ALSO BLOOD.',\n  'DO STAY DRY, MISS RANSOM. THE WET ONES GET SO ATTACHED.',\n  'THIS ISLAND HAS STOOD FOR A THOUSAND YEARS. YOUR COAT WILL NOT.',\n  'LOST PROPERTY MAY BE COLLECTED FROM THE SEA.',\n  'THE ABBEY GIFT SHOP IS NOW OPEN. THE ABBEY GIFT IS DEATH.',\n  'MISS RANSOM, WHAT IS YOUR DEDUCTIBLE? I SHOULD LIKE TO EXCEED IT.',\n  'A MESSAGE FROM THE CANNERY: WE ARE HIRING. WE ARE ALSO FIRING. MOSTLY FIRING.',\n  'IF YOU CAN HEAR THIS, YOU ARE TOO CLOSE TO MY VOICE.',\n  'THAT WAS THE LAST ONE. I HOPE YOU ARE HAPPY.',\n];\nexport const ARRIVAL = [\n  ['NILS', 'THIS IS AS FAR AS I GO. TIDE\\'S WRONG. EVERYTHING\\'S WRONG.'],\n  ['MAX', 'OSTRANDER MUTUAL THANKS YOU FOR YOUR COOPERATION.'],\n  ['NILS', 'INSURANCE? YOU CAME OUT HERE FOR INSURANCE?'],\n  ['MAX', 'SOMEONE HAS TO READ THE SMALL PRINT.'],\n  ['PYM', 'MS. RANSOM, CLAIMS DESK. POLICY 7741, DAME OTTOLINE VANE. KIDNAP AND RANSOM, PREMIUM TIER. NINE DAYS, NO DEMAND. LOCATE THE INSURED. ASSESS. REPORT.'],\n  ['MAX', 'AND IF THE LOCALS OBJECT?'],\n  ['PYM', 'FORM 11-B. INCIDENTAL VIOLENCE. IN TRIPLICATE.'],\n  ['COMMODORE', 'ATTENTION, MOURNE QUAY. THIS IS YOUR COMMODORE. A SMALL WOMAN IN A LARGE COAT HAS COME ASHORE. KINDLY REMOVE HER.'],\n  ['MAX', 'EVERYONE\\'S A CRITIC.'],\n];\nexport const MENDER_TALK = [\n  ['MAX', 'EVENING. I\\'M LOOKING FOR AN OLD WOMAN. RICH. RUDE. ANSWERS TO DAME.'],\n  ['MENDER', 'THE TIDE TAKES WHAT IT\\'S OWED.'],\n  ['MAX', 'IS THAT A NO?'],\n];\nexport const FATHOM_INTRO = [\n  ['FATHOM', 'BLUB! AHOY! A PAYING CUSTOMER! DRY GOODS, WET GOODS, GOODS OF NO FIXED DESCRIPTION!'],\n  ['MAX', 'YOU\\'RE WEARING A DIVING HELMET.'],\n  ['FATHOM', 'AND YOU\\'RE WEARING A TARGET, FRIEND. BROWSE!'],\n];\nexport const SIEGE_START = [['COMMODORE', 'ALL HANDS TO THE SQUARE. BRING SOMETHING SHARP. BRING A FRIEND. BRING YOUR FRIEND\\'S SOMETHING SHARP.'], ['MAX', 'NOTED.']];\nexport const FOGHORN = [\n  ['COMMODORE', 'AH. THE TIDE WILL HAVE ITS SUPPER FIRST. DO STAY DRY, MISS RANSOM.'],\n  ['PYM', 'MS. RANSOM, ARE WE LOOKING AT A MASS CLAIM? THERE IS A SEPARATE FORM.'],\n  ['MAX', 'FIFTY CLAIMANTS, AND NOT ONE FORWARDING ADDRESS.'],\n];\nexport const COLD_ROOM = [\n  ['DAME', 'YOU ARE NINE DAYS LATE AND YOU ARE DRIPPING.'],\n  ['MAX', 'MAX RANSOM. OSTRANDER MUTUAL.'],\n  ['DAME', 'RANSOM. IS THAT A JOKE?'],\n  ['MAX', 'IT\\'S A SURNAME. I\\'VE HEARD THEM ALL.'],\n  ['DAME', 'I PAY YOUR EMPLOYERS ELEVEN THOUSAND A YEAR. I EXPECTED A REGIMENT.'],\n  ['MAX', 'I\\'M THE REGIMENT. CAN YOU WALK?'],\n  ['DAME', 'I HAVE WALKED OUT ON BETTER THAN YOU, YOUNG WOMAN. LEAD ON. MIND THE COAT.'],\n];\nexport const AFTER_BOSUN = [\n  ['DAME', 'MY GREAT-GRANDFATHER SIGNED THE FIRST TITHE. EVERY VANE SHIP THAT CAME HOME SAFE, THE ISLAND KEPT A CREW FROM IT. THAT IS YOUR PREMIUM, MISS RANSOM. THAT IS WHAT YOU INSURE.'],\n  ['MAX', 'THAT WOULD\\'VE BEEN USEFUL ON THE APPLICATION.'],\n  ['DAME', 'NOBODY READS THE APPLICATION.'],\n];\nexport const CAUSEWAY = [\n  ['COMMODORE', 'TIDE TABLES ARE PRINTED IN THE FOYER, MISS RANSOM. YOU HAVE FOUR MINUTES.'],\n  ['MAX', 'HE PRINTED TIDE TABLES.'],\n  ['DAME', 'HE PRINTS EVERYTHING. HE IS A DREADFUL LITTLE MAN.'],\n];\nexport const CRYPT = [\n  ['DAME', 'VERY WELL. I SHALL DO IT MYSELF. AS USUAL.'],\n  ['PYM', 'DAME OTTOLINE, THIS IS THE CLAIMS DESK. PLEASE HOLD.'],\n  ['DAME', 'I WILL NOT.'],\n];\nexport const FINAL_BOSS = [\n  ['COMMODORE', 'BEHOLD! THE BATHYSPHERE OF SAINT ORRIN! FORTY TONS OF DIVINE PLUMBING!'],\n  ['MAX', 'ARE YOU COVERED FOR THAT?'],\n];\nexport const HATCH = [['COMMODORE', 'THIS IS AN OUTRAGE. I AM ON THE AIR.'], ['MAX', 'NOT FOR LONG.']];\nexport const ENDING = [\n  ['DAME', 'YOUR FEE. LESS DEDUCTIONS.'],\n  ['MAX', 'THIS IS FOR THREE POUNDS SEVENTY-FIVE.'],\n  ['DAME', 'YOU DRIPPED.'],\n  ['PYM', 'MS. RANSOM, ONE THING FOR THE FILE. THE ISLAND APPEARS IN OUR BOOKS. AS A CLIENT.'],\n  ['MAX', 'SINCE WHEN?'],\n  ['PYM', 'SINCE EIGHTEEN FORTY. PLEASE HOLD.'],\n];\nEOF\ncat > src/data/levels/quay.js <<'EOF'\n// CLAIM 1: ACT OF GOD. Mourne Quay at bruised dusk.\nimport { TANNOY_LINES, ARRIVAL, MENDER_TALK, FATHOM_INTRO, SIEGE_START, FOGHORN } from '../dialogue.js';\nimport { S } from '../../game/enemy.js';\nimport { cam, orbit, timed, lineDuration, cp, inCells, nearXZ, hintUntil, waitKills, alive, shake, flashBang } from '../../game/kit.js';\nimport { Vector3 } from '../../../pixel-engine.js';\n\nfunction* intro(a) {\n  const [px, pz] = [a.player.x, a.player.z];\n  if (!a.hasFlag('arrived')) {\n    const ls = timed(ARRIVAL, 0.8);\n    yield* a.cutscene({\n      shots: [{ at: 0, ...cam(px + 7, 3.2, pz - 9, px - 2, 1.5, pz - 2, 52) }, { at: 5, ...cam(px + 3, 2.6, pz - 5, px, 1.6, pz - 1, 48) }, { at: 7, ...cam(px - 3.2, 1.6, pz + 3.6, px, 1.7, pz, 42), cut: true }, { at: 16, ...cam(px - 2.4, 1.7, pz + 2.6, px, 1.75, pz, 40) }, { at: 17, ...cam(px + 5, 2.2, pz - 6, px - 5, 2.5, pz - 14, 46), cut: true }, { at: 26, ...cam(px + 6, 2.6, pz - 8, px - 6, 3, pz - 16, 46) }],\n      lines: ls, duration: lineDuration(ls) + 0.5,\n      cues: [{ at: 0.2, run: () => a.audio('sea'), cosmetic: true }, { at: 15.5, run: () => a.audio('tannoyOn'), cosmetic: true }],\n    });\n    a.setFlag('arrived');\n  }\n  a.setObjective('FIND DAME OTTOLINE VANE');\n  a.autosave();\n  yield* hintUntil(a, 'USE THE LEFT STICK / WASD TO MOVE', () => a.player.speed > 1, 12);\n  yield* hintUntil(a, 'HOLD CIRCLE / SHIFT TO RUN', () => a.player.speed > 4, 10);\n}\nfunction* firstTannoy(a) {\n  const t = a.tannoys[0]; if (!t) return;\n  while (!nearXZ(a, t.x, t.z, 9) && t.alive) yield 0.25;\n  if (t.alive) { a.audio('tannoyOn', t.x, t.z); a.scripts.bark('COMMODORE', TANNOY_LINES[0], 4); }\n  yield* hintUntil(a, 'HOLD L2 / RIGHT MOUSE TO AIM. R2 / LEFT MOUSE TO FIRE. SHOOT THE LOUDSPEAKER.', () => !t.alive, 40);\n}\nfunction* cottage(a) {\n  const [dx, dz] = cp(a, 42, 30);\n  const mender = a.spawn('gaffer', ...cp(a, 43, 35), { work: true, state: S.WORK, yaw: Math.PI, model: 'islander-bare', group: 'cottage' });\n  mender.holdStill = true;\n  while (!inCells(a, 39, 31, 45, 37)) yield 0.25;\n  if (a.hasFlag('mender-done')) return;\n  a.def.mender = function* () {};\n  yield* a.say('MAX', MENDER_TALK[0][1]); yield* a.say('MENDER', MENDER_TALK[1][1]); yield* a.say('MAX', MENDER_TALK[2][1]);\n  mender.alert(); mender.bandBright = true;\n  a.showHint('HEAD AND LEG SHOTS STAGGER. THEN: KICK', 12);\n  a.scripts.bark('MAX', \"I'LL PUT YOU DOWN AS A NO.\", 3);\n  yield () => mender.dead || a.player.dead;\n  a.hintT = 0;\n  a.setFlag('mender-done');\n  flashBang(a, 'orange', 0.3); shake(a, 0.5); a.audio('barrel');\n  a.ctx.lights.request({ position: [a.player.x + 6, 3, a.player.z - 4], color: 0xff6020, intensity: 12, radius: 14, lifetime: 20, flicker: 'torch' });\n  yield 1.2;\n  a.bark('MAX', \"THAT'LL BE THE EXCESS.\", 3);\n  for (let i = 0; i < 2; i++) a.spawnAtDoor('gaffer', '4', { state: S.APPROACH });\n  const [wx, wz] = cp(a, 46, 34);\n  a.showHint('A WINDOW! PRESS ACTION TO VAULT OUT', 14);\n  yield () => a.player.state === 'vault' || !inCells(a, 39, 31, 45, 37);\n  a.hintT = 0;\n}\nfunction* quayFront(a) {\n  const [fx, fz] = cp(a, 44, 7);\n  const grp = [];\n  for (let i = 0; i < 3; i++) grp.push(a.spawn('gaffer', fx + 4 + i, fz + 8 + i * 2, { work: true, state: S.WORK, group: 'front' }));\n  while (!nearXZ(a, fx, fz, 6)) yield 0.5;\n  if (a.hasFlag('fathom-met')) return;\n  a.setFlag('fathom-met');\n  for (const [w, t] of FATHOM_INTRO) yield* a.say(w, t);\n  a.showHint('THE CASE IS TIGHT: SHELLS TAKE ROOM. PRESS TAB TO PACK IT', 10);\n}\nfunction* siege(a) {\n  const [sx, sz] = cp(a, 30, 22);\n  while (!inCells(a, 22, 15, 40, 29)) yield 0.25;\n  if (a.hasFlag('siege-done')) return;\n  a.setFlag('siege-started'); a.setObjective('SURVIVE THE SQUARE');\n  app_mixPlay(a, 'siege');\n  // bonfire + effigy + 14 islanders round it\n  a.placeModel('effigy', sx, sz, 0, { collide: false });\n  a.placeModel('campfire', sx, sz + 1.2, 0, { collide: false });\n  a.ctx.lights.request({ position: [sx, 2, sz], color: 0xff7a20, intensity: 18, radius: 14, flicker: 'torch' });\n  const crowd = [];\n  for (let i = 0; i < 14; i++) { const ang = i / 14 * Math.PI * 2; crowd.push(a.spawn('gaffer', sx + Math.cos(ang) * 4.2, sz + Math.sin(ang) * 4.2, { work: true, state: S.WORK, yaw: ang + Math.PI, group: 'crowd' })); }\n  const ls = timed(SIEGE_START, 0.5);\n  yield* a.cutscene({ shots: [{ at: 0, ...cam(sx - 12, 5, sz - 8, sx, 1.8, sz, 55) }, { at: 5.5, ...cam(sx - 6, 3, sz - 2, sx, 2.4, sz, 48) }], lines: ls, duration: 6.2, cues: [{ at: 0.1, run: () => a.audio('tannoyOn') }] });\n  for (const e of crowd) e.alert();\n  a.siegeT0 = a.time; a.siegeKills0 = a.killsThisArea;\n  // tide of waves from the spawn doors\n  a.scripts.start(function* () {\n    yield 60 - 0;\n    const total = { gaffer: 16, bottler: 4 };\n    const doors = ['1', '2', '3', '4', '5'];\n    let i = 0;\n    const batch = [];\n    for (let k = 0; k < 16; k++) { batch.push(a.spawnAtDoor('gaffer', doors[i++ % 5], { state: S.WAIT })); if (k % 4 === 3) yield 6; else yield 1.2; }\n    for (let k = 0; k < 4; k++) { batch.push(a.spawnAtDoor('bottler', doors[(i++) % 5], { state: S.WAIT })); yield 2; }\n  }, 'waves');\n  a.scripts.start(function* () {\n    yield 90 - 0;\n    const f = a.spawnAtDoor('flenser', '2', { state: S.APPROACH });\n    a.audio('saw', f.x, f.z); a.flenser = f;\n    a.showHint('YOU HEAR THE SAW BEFORE YOU SEE HIM. AIM FOR THE HEAD', 8);\n  }, 'flenser');\n  // end: 3:30 or 34 kills\n  while (a.time - a.siegeT0 < 210 && a.killsThisArea - a.siegeKills0 < 34) yield 0.5;\n  yield* foghorn(a);\n}\nfunction app_mixPlay(a, n) { import('../../core/app.js').then(({ app }) => app.mix?.play(n)); }\nfunction* foghorn(a) {\n  a.setFlag('foghorn');\n  a.scripts.tasks = a.scripts.tasks.filter((t) => t.name === 'siege' || t.name === 'main');\n  import('../../core/app.js').then(({ app }) => app.mix?.play(null));\n  const [hx, hz] = cp(a, 57, 7);\n  const ls = timed(FOGHORN, 5.5);\n  yield* a.cutscene({\n    shots: [{ at: 0, ...cam(a.player.x + 4, 3, a.player.z + 6, hx, 10, hz, 55) }, { at: 5, ...cam(a.player.x + 2, 2.4, a.player.z + 4, a.player.x - 6, 2, a.player.z - 4, 50) }, { at: 10, ...cam(a.player.x - 4, 3, a.player.z - 6, a.player.x + 8, 1.5, a.player.z + 6, 52) }],\n    lines: ls, duration: lineDuration(ls) + 1,\n    cues: [{ at: 0.4, run: () => { a.audio('foghorn'); shake(a, 0.7); } }, { at: 1.5, run: () => { for (const e of a.enemies) if (!e.dead) { e.releaseToken(); e.setState(S.SEA); e.seaT = 0; } if (a.flenser && !a.flenser.dead) a.flenser.setState(S.SEA); } }],\n  });\n  a.setFlag('siege-done');\n  for (const e of a.enemies) if (!e.dead && e.state !== S.SEA) e.setState(S.SEA);\n  a.setObjective('FIND THE WEST GATE'); a.autosave();\n  a.def.gateOpen = true;\n  const gate = a.level.doors.find((d) => d.kind === 'G'); if (gate) a.openDoor(gate);\n  a.audio('stoneGrind');\n}\nfunction* leave(a) {\n  while (!a.hasFlag('siege-done')) yield 0.5;\n  const [gx, gz] = cp(a, 0, 8);\n  while (!nearXZ(a, gx, gz, 3.2)) yield 0.4;\n  yield* a.finishArea({ next: 'road', title: 'CLAIM 1: ACT OF GOD' });\n}\n\nexport const quay = {\n  id: 'quay', name: 'MOURNE QUAY', mapId: 'quay', mood: 'dusk', music: 'explore', chapter: 0, startYaw: Math.PI,\n  theme: { floors: { '.': 'cobbles', ',': 'dirt', '=': 'planks', ':': 'rough-boards', '_': 'flagstones' } },\n  tannoyLines: TANNOY_LINES.slice(0, 6),\n  dress: ['barrel', 'crate', 'sack', 'bucket', 'rope-coil', 'lobster-pot', 'bollard', 'drying-rack'],\n  lamps: [[-2, -9], [-14, -3], [8, -3], [-2, 11], [20, -12], [-20, 5]],\n  props: [{ id: 'foghorn-tower', at: [26, -17], rot: 0, collide: false, y: 0 }, { id: 'rowboat', at: [22.5, 16.5], rot: 20, collide: false, y: -0.3 }, { id: 'hay-cart', at: [0, -8.5], rot: 0, collide: true }],\n  scripts: [intro, firstTannoy, cottage, quayFront, siege, leave],\n  mender: null,\n  chestLoot: {},\n};\nexport { S, Vector3 };\nEOF\ncat > src/data/levels/index.js <<'EOF'\n// All areas, in play order, plus teleport beats for dev mode.\nimport { quay } from './quay.js';\nexport const LEVELS = [quay];\nexport const BEATS = [\n  { label: 'QUAY: ARRIVAL', level: quay, entry: null, flags: [] },\n  { label: 'QUAY: THE SQUARE', level: quay, entry: { x: -1.5, z: 10 }, flags: ['arrived', 'mender-done', 'fathom-met'] },\n  { label: 'QUAY: AFTER THE FOGHORN', level: quay, entry: { x: -1.5, z: 3 }, flags: ['arrived', 'mender-done', 'fathom-met', 'siege-started', 'siege-done'] },\n];\nexport const byId = (id) => LEVELS.find((l) => l.id === id);\nEOF\nnode tools/scratch/t10.mjs 2>&1 | cut -c1-300 | tail -5"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5281,"cache_read_input_tokens":439734,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5281},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"95eb819f-952e-4afc-b710-af34f202e2ce","uuid":"43c73ced-37b4-4d28-a132-ec6d055552ff","timestamp":"2026-11-05T23:49:55.122Z","request_id":"req_011CgkgBAybk9MbgpvfX7Ur1","wire_tool_inputs":{"toolu_012XREiMfH1pApUwZKiBzo5k":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/work/ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051 && cat > src/data/dialogue.js <<'EOF'\n// All spoken text: Tannoy lines, scripted scenes. Uppercase, no em dashes, no accents.\nexport const TANNOY_LINES = [\n  'A REMINDER: THE FISH MARKET IS CLOSED. THE FISH HAVE WON.',\n  'MISS RANSOM, I HAVE READ YOUR POLICY. I FIND IT RESTRICTIVE.',\n  'WHO IS SHOOTING MY LOUDSPEAKERS? THOSE ARE IMPORTED.',\n  'I AM TOLD YOU WEAR SUNGLASSES AT NIGHT. HOW BRAVE. HOW STUPID.',\n  'OUR HYMN TODAY IS NUMBER NINE. OUR SURVIVORS TODAY ARE NUMBER NONE.',\n  'THE BOSUN WOULD LIKE A WORD. HE ONLY HAS THE ONE.',\n  'DAME OTTOLINE, YOUR GREAT-GRANDFATHER SIGNED IN BLOOD. I HAVE BROUGHT A PEN. IT IS ALSO BLOOD.',\n  'DO STAY DRY, MISS RANSOM. THE WET ONES GET SO ATTACHED.',\n  'THIS ISLAND HAS STOOD FOR A THOUSAND YEARS. YOUR COAT WILL NOT.',\n  'LOST PROPERTY MAY BE COLLECTED FROM THE SEA.',\n  'THE ABBEY GIFT SHOP IS NOW OPEN. THE ABBEY GIFT IS DEATH.',\n  'MISS RANSOM, WHAT IS YOUR DEDUCTIBLE? I SHOULD LIKE TO EXCEED IT.',\n  'A MESSAGE FROM THE CANNERY: WE ARE HIRING. WE ARE ALSO FIRING. MOSTLY FIRING.',\n  'IF YOU CAN HEAR THIS, YOU ARE TOO CLOSE TO MY VOICE.',\n  'THAT WAS THE LAST ONE. I HOPE YOU ARE HAPPY.',\n];\nexport const ARRIVAL = [\n  ['NILS', 'THIS IS AS FAR AS I GO. TIDE\\'S WRONG. EVERYTHING\\'S WRONG.'],\n  ['MAX', 'OSTRANDER MUTUAL THANKS YOU FOR YOUR COOPERATION.'],\n  ['NILS', 'INSURANCE? YOU CAME OUT HERE FOR INSURANCE?'],\n  ['MAX', 'SOMEONE HAS TO READ THE SMALL PRINT.'],\n  ['PYM', 'MS. RANSOM, CLAIMS DESK. POLICY 7741, DAME OTTOLINE VANE. KIDNAP AND RANSOM, PREMIUM TIER. NINE DAYS, NO DEMAND. LOCATE THE INSURED. ASSESS. REPORT.'],\n  ['MAX', 'AND IF THE LOCALS OBJECT?'],\n  ['PYM', 'FORM 11-B. INCIDENTAL VIOLENCE. IN TRIPLICATE.'],\n  ['COMMODORE', 'ATTENTION, MOURNE QUAY. THIS IS YOUR COMMODORE. A SMALL WOMAN IN A LARGE COAT HAS COME ASHORE. KINDLY REMOVE HER.'],\n  ['MAX', 'EVERYONE\\'S A CRITIC.'],\n];\nexport const MENDER_TALK = [\n  ['MAX', 'EVENING. I\\'M LOOKING FOR AN OLD WOMAN. RICH. RUDE. ANSWERS TO DAME.'],\n  ['MENDER', 'THE TIDE TAKES WHAT IT\\'S OWED.'],\n  ['MAX', 'IS THAT A NO?'],\n];\nexport const FATHOM_INTRO = [\n  ['FATHOM', 'BLUB! AHOY! A PAYING CUSTOMER! DRY GOODS, WET GOODS, GOODS OF NO FIXED DESCRIPTION!'],\n  ['MAX', 'YOU\\'RE WEARING A DIVING HELMET.'],\n  ['FATHOM', 'AND YOU\\'RE WEARING A TARGET, FRIEND. BROWSE!'],\n];\nexport const SIEGE_START = [['COMMODORE', 'ALL HANDS TO THE SQUARE. BRING SOMETHING SHARP. BRING A FRIEND. BRING YOUR FRIEND\\'S SOMETHING SHARP.'], ['MAX', 'NOTED.']];\nexport const FOGHORN = [\n  ['COMMODORE', 'AH. THE TIDE WILL HAVE ITS SUPPER FIRST. DO STAY DRY, MISS RANSOM.'],\n  ['PYM', 'MS. RANSOM, ARE WE LOOKING AT A MASS CLAIM? THERE IS A SEPARATE FORM.'],\n  ['MAX', 'FIFTY CLAIMANTS, AND NOT ONE FORWARDING ADDRESS.'],\n];\nexport const COLD_ROOM = [\n  ['DAME', 'YOU ARE NINE DAYS LATE AND YOU ARE DRIPPING.'],\n  ['MAX', 'MAX RANSOM. OSTRANDER MUTUAL.'],\n  ['DAME', 'RANSOM. IS THAT A JOKE?'],\n  ['MAX', 'IT\\'S A SURNAME. I\\'VE HEARD THEM ALL.'],\n  ['DAME', 'I PAY YOUR EMPLOYERS ELEVEN THOUSAND A YEAR. I EXPECTED A REGIMENT.'],\n  ['MAX', 'I\\'M THE REGIMENT. CAN YOU WALK?'],\n  ['DAME', 'I HAVE WALKED OUT ON BETTER THAN YOU, YOUNG WOMAN. LEAD ON. MIND THE COAT.'],\n];\nexport const AFTER_BOSUN = [\n  ['DAME', 'MY GREAT-GRANDFATHER SIGNED THE FIRST TITHE. EVERY VANE SHIP THAT CAME HOME SAFE, THE ISLAND KEPT A CREW FROM IT. THAT IS YOUR PREMIUM, MISS RANSOM. THAT IS WHAT YOU INSURE.'],\n  ['MAX', 'THAT WOULD\\'VE BEEN USEFUL ON THE APPLICATION.'],\n  ['DAME', 'NOBODY READS THE APPLICATION.'],\n];\nexport const CAUSEWAY = [\n  ['COMMODORE', 'TIDE TABLES ARE PRINTED IN THE FOYER, MISS RANSOM. YOU HAVE FOUR MINUTES.'],\n  ['MAX', 'HE PRINTED TIDE TABLES.'],\n  ['DAME', 'HE PRINTS EVERYTHING. HE IS A DREADFUL LITTLE MAN.'],\n];\nexport const CRYPT = [\n  ['DAME', 'VERY WELL. I SHALL DO IT MYSELF. AS USUAL.'],\n  ['PYM', 'DAME OTTOLINE, THIS IS THE CLAIMS DESK. PLEASE HOLD.'],\n  ['DAME', 'I WILL NOT.'],\n];\nexport const FINAL_BOSS = [\n  ['COMMODORE', 'BEHOLD! THE BATHYSPHERE OF SAINT ORRIN! FORTY TONS OF DIVINE PLUMBING!'],\n  ['MAX', 'ARE YOU COVERED FOR THAT?'],\n];\nexport const HATCH = [['COMMODORE', 'THIS IS AN OUTRAGE. I AM ON THE AIR.'], ['MAX', 'NOT FOR LONG.']];\nexport const ENDING = [\n  ['DAME', 'YOUR FEE. LESS DEDUCTIONS.'],\n  ['MAX', 'THIS IS FOR THREE POUNDS SEVENTY-FIVE.'],\n  ['DAME', 'YOU DRIPPED.'],\n  ['PYM', 'MS. RANSOM, ONE THING FOR THE FILE. THE ISLAND APPEARS IN OUR BOOKS. AS A CLIENT.'],\n  ['MAX', 'SINCE WHEN?'],\n  ['PYM', 'SINCE EIGHTEEN FORTY. PLEASE HOLD.'],\n];\nEOF\ncat > src/data/levels/quay.js <<'EOF'\n// CLAIM 1: ACT OF GOD. Mourne Quay at bruised dusk.\nimport { TANNOY_LINES, ARRIVAL, MENDER_TALK, FATHOM_INTRO, SIEGE_START, FOGHORN } from '../dialogue.js';\nimport { S } from '../../game/enemy.js';\nimport { cam, orbit, timed, lineDuration, cp, inCells, nearXZ, hintUntil, waitKills, alive, shake, flashBang } from '../../game/kit.js';\nimport { Vector3 } from '../../../pixel-engine.js';\n\nfunction* intro(a) {\n  const [px, pz] = [a.player.x, a.player.z];\n  if (!a.hasFlag('arrived')) {\n    const ls = timed(ARRIVAL, 0.8);\n    yield* a.cutscene({\n      shots: [{ at: 0, ...cam(px + 7, 3.2, pz - 9, px - 2, 1.5, pz - 2, 52) }, { at: 5, ...cam(px + 3, 2.6, pz - 5, px, 1.6, pz - 1, 48) }, { at: 7, ...cam(px - 3.2, 1.6, pz + 3.6, px, 1.7, pz, 42), cut: true }, { at: 16, ...cam(px - 2.4, 1.7, pz + 2.6, px, 1.75, pz, 40) }, { at: 17, ...cam(px + 5, 2.2, pz - 6, px - 5, 2.5, pz - 14, 46), cut: true }, { at: 26, ...cam(px + 6, 2.6, pz - 8, px - 6, 3, pz - 16, 46) }],\n      lines: ls, duration: lineDuration(ls) + 0.5,\n      cues: [{ at: 0.2, run: () => a.audio('sea'), cosmetic: true }, { at: 15.5, run: () => a.audio('tannoyOn'), cosmetic: true }],\n    });\n    a.setFlag('arrived');\n  }\n  a.setObjective('FIND DAME OTTOLINE VANE');\n  a.autosave();\n  yield* hintUntil(a, 'USE THE LEFT STICK / WASD TO MOVE', () => a.player.speed > 1, 12);\n  yield* hintUntil(a, 'HOLD CIRCLE / SHIFT TO RUN', () => a.player.speed > 4, 10);\n}\nfunction* firstTannoy(a) {\n  const t = a.tannoys[0]; if (!t) return;\n  while (!nearXZ(a, t.x, t.z, 9) && t.alive) yield 0.25;\n  if (t.alive) { a.audio('tannoyOn', t.x, t.z); a.scripts.bark('COMMODORE', TANNOY_LINES[0], 4); }\n  yield* hintUntil(a, 'HOLD L2 / RIGHT MOUSE TO AIM. R2 / LEFT MOUSE TO FIRE. SHOOT THE LOUDSPEAKER.', () => !t.alive, 40);\n}\nfunction* cottage(a) {\n  const [dx, dz] = cp(a, 42, 30);\n  const mender = a.spawn('gaffer', ...cp(a, 43, 35), { work: true, state: S.WORK, yaw: Math.PI, model: 'islander-bare', group: 'cottage' });\n  mender.holdStill = true;\n  while (!inCells(a, 39, 31, 45, 37)) yield 0.25;\n  if (a.hasFlag('mender-done')) return;\n  a.def.mender = function* () {};\n  yield* a.say('MAX', MENDER_TALK[0][1]); yield* a.say('MENDER', MENDER_TALK[1][1]); yield* a.say('MAX', MENDER_TALK[2][1]);\n  mender.alert(); mender.bandBright = true;\n  a.showHint('HEAD AND LEG SHOTS STAGGER. THEN: KICK', 12);\n  a.scripts.bark('MAX', \"I'LL PUT YOU DOWN AS A NO.\", 3);\n  yield () => mender.dead || a.player.dead;\n  a.hintT = 0;\n  a.setFlag('mender-done');\n  flashBang(a, 'orange', 0.3); shake(a, 0.5); a.audio('barrel');\n  a.ctx.lights.request({ position: [a.player.x + 6, 3, a.player.z - 4], color: 0xff6020, intensity: 12, radius: 14, lifetime: 20, flicker: 'torch' });\n  yield 1.2;\n  a.bark('MAX', \"THAT'LL BE THE EXCESS.\", 3);\n  for (let i = 0; i < 2; i++) a.spawnAtDoor('gaffer', '4', { state: S.APPROACH });\n  const [wx, wz] = cp(a, 46, 34);\n  a.showHint('A WINDOW! PRESS ACTION TO VAULT OUT', 14);\n  yield () => a.player.state === 'vault' || !inCells(a, 39, 31, 45, 37);\n  a.hintT = 0;\n}\nfunction* quayFront(a) {\n  const [fx, fz] = cp(a, 44, 7);\n  const grp = [];\n  for (let i = 0; i < 3; i++) grp.push(a.spawn('gaffer', fx + 4 + i, fz + 8 + i * 2, { work: true, state: S.WORK, group: 'front' }));\n  while (!nearXZ(a, fx, fz, 6)) yield 0.5;\n  if (a.hasFlag('fathom-met')) return;\n  a.setFlag('fathom-met');\n  for (const [w, t] of FATHOM_INTRO) yield* a.say(w, t);\n  a.showHint('THE CASE IS TIGHT: SHELLS TAKE ROOM. PRESS TAB TO PACK IT', 10);\n}\nfunction* siege(a) {\n  const [sx, sz] = cp(a, 30, 22);\n  while (!inCells(a, 22, 15, 40, 29)) yield 0.25;\n  if (a.hasFlag('siege-done')) return;\n  a.setFlag('siege-started'); a.setObjective('SURVIVE THE SQUARE');\n  app_mixPlay(a, 'siege');\n  // bonfire + effigy + 14 islanders round it\n  a.placeModel('effigy', sx, sz, 0, { collide: false });\n  a.placeModel('campfire', sx, sz + 1.2, 0, { collide: false });\n  a.ctx.lights.request({ position: [sx, 2, sz], color: 0xff7a20, intensity: 18, radius: 14, flicker: 'torch' });\n  const crowd = [];\n  for (let i = 0; i < 14; i++) { const ang = i / 14 * Math.PI * 2; crowd.push(a.spawn('gaffer', sx + Math.cos(ang) * 4.2, sz + Math.sin(ang) * 4.2, { work: true, state: S.WORK, yaw: ang + Math.PI, group: 'crowd' })); }\n  const ls = timed(SIEGE_START, 0.5);\n  yield* a.cutscene({ shots: [{ at: 0, ...cam(sx - 12, 5, sz - 8, sx, 1.8, sz, 55) }, { at: 5.5, ...cam(sx - 6, 3, sz - 2, sx, 2.4, sz, 48) }], lines: ls, duration: 6.2, cues: [{ at: 0.1, run: () => a.audio('tannoyOn') }] });\n  for (const e of crowd) e.alert();\n  a.siegeT0 = a.time; a.siegeKills0 = a.killsThisArea;\n  // tide of waves from the spawn doors\n  a.scripts.start(function* () {\n    yield 60 - 0;\n    const total = { gaffer: 16, bottler: 4 };\n    const doors = ['1', '2', '3', '4', '5'];\n    let i = 0;\n    const batch = [];\n    for (let k = 0; k < 16; k++) { batch.push(a.spawnAtDoor('gaffer', doors[i++ % 5], { state: S.WAIT })); if (k % 4 === 3) yield 6; else yield 1.2; }\n    for (let k = 0; k < 4; k++) { batch.push(a.spawnAtDoor('bottler', doors[(i++) % 5], { state: S.WAIT })); yield 2; }\n  }, 'waves');\n  a.scripts.start(function* () {\n    yield 90 - 0;\n    const f = a.spawnAtDoor('flenser', '2', { state: S.APPROACH });\n    a.audio('saw', f.x, f.z); a.flenser = f;\n    a.showHint('YOU HEAR THE SAW BEFORE YOU SEE HIM. AIM FOR THE HEAD', 8);\n  }, 'flenser');\n  // end: 3:30 or 34 kills\n  while (a.time - a.siegeT0 < 210 && a.killsThisArea - a.siegeKills0 < 34) yield 0.5;\n  yield* foghorn(a);\n}\nfunction app_mixPlay(a, n) { import('../../core/app.js').then(({ app }) => app.mix?.play(n)); }\nfunction* foghorn(a) {\n  a.setFlag('foghorn');\n  a.scripts.tasks = a.scripts.tasks.filter((t) => t.name === 'siege' || t.name === 'main');\n  import('../../core/app.js').then(({ app }) => app.mix?.play(null));\n  const [hx, hz] = cp(a, 57, 7);\n  const ls = timed(FOGHORN, 5.5);\n  yield* a.cutscene({\n    shots: [{ at: 0, ...cam(a.player.x + 4, 3, a.player.z + 6, hx, 10, hz, 55) }, { at: 5, ...cam(a.player.x + 2, 2.4, a.player.z + 4, a.player.x - 6, 2, a.player.z - 4, 50) }, { at: 10, ...cam(a.player.x - 4, 3, a.player.z - 6, a.player.x + 8, 1.5, a.player.z + 6, 52) }],\n    lines: ls, duration: lineDuration(ls) + 1,\n    cues: [{ at: 0.4, run: () => { a.audio('foghorn'); shake(a, 0.7); } }, { at: 1.5, run: () => { for (const e of a.enemies) if (!e.dead) { e.releaseToken(); e.setState(S.SEA); e.seaT = 0; } if (a.flenser && !a.flenser.dead) a.flenser.setState(S.SEA); } }],\n  });\n  a.setFlag('siege-done');\n  for (const e of a.enemies) if (!e.dead && e.state !== S.SEA) e.setState(S.SEA);\n  a.setObjective('FIND THE WEST GATE'); a.autosave();\n  a.def.gateOpen = true;\n  const gate = a.level.doors.find((d) => d.kind === 'G'); if (gate) a.openDoor(gate);\n  a.audio('stoneGrind');\n}\nfunction* leave(a) {\n  while (!a.hasFlag('siege-done')) yield 0.5;\n  const [gx, gz] = cp(a, 0, 8);\n  while (!nearXZ(a, gx, gz, 3.2)) yield 0.4;\n  yield* a.finishArea({ next: 'road', title: 'CLAIM 1: ACT OF GOD' });\n}\n\nexport const quay = {\n  id: 'quay', name: 'MOURNE QUAY', mapId: 'quay', mood: 'dusk', music: 'explore', chapter: 0, startYaw: Math.PI,\n  theme: { floors: { '.': 'cobbles', ',': 'dirt', '=': 'planks', ':': 'rough-boards', '_': 'flagstones' } },\n  tannoyLines: TANNOY_LINES.slice(0, 6),\n  dress: ['barrel', 'crate', 'sack', 'bucket', 'rope-coil', 'lobster-pot', 'bollard', 'drying-rack'],\n  lamps: [[-2, -9], [-14, -3], [8, -3], [-2, 11], [20, -12], [-20, 5]],\n  props: [{ id: 'foghorn-tower', at: [26, -17], rot: 0, collide: false, y: 0 }, { id: 'rowboat', at: [22.5, 16.5], rot: 20, collide: false, y: -0.3 }, { id: 'hay-cart', at: [0, -8.5], rot: 0, collide: true }],\n  scripts: [intro, firstTannoy, cottage, quayFront, siege, leave],\n  mender: null,\n  chestLoot: {},\n};\nexport { S, Vector3 };\nEOF\ncat > src/data/levels/index.js <<'EOF'\n// All areas, in play order, plus teleport beats for dev mode.\nimport { quay } from './quay.js';\nexport const LEVELS = [quay];\nexport const BEATS = [\n  { label: 'QUAY: ARRIVAL', level: quay, entry: null, flags: [] },\n  { label: 'QUAY: THE SQUARE', level: quay, entry: { x: -1.5, z: 10 }, flags: ['arrived', 'mender-done', 'fathom-met'] },\n  { label: 'QUAY: AFTER THE FOGHORN', level: quay, entry: { x: -1.5, z: 3 }, flags: ['arrived', 'mender-done', 'fathom-met', 'siege-started', 'siege-done'] },\n];\nexport const byId = (id) => LEVELS.find((l) => l.id === id);\nEOF\nnode tools/scratch/t10.mjs 2>&1 | cut -c1-300 | tail -5"}},"wire_ingest_context":{"toolu_012XREiMfH1pApUwZKiBzo5k":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-162051__xa8053f/work/ResidentHull4-ResidentEvil4-claude-sonnet-5-5-medium-20261105-162051"}}}
