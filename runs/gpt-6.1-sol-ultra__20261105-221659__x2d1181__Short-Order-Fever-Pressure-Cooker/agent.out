h3{margin:0 0 4px;font-size:25px}.howto-step p{margin:0;font-size:16px}.small-copy{font-size:15px}.keys-copy{padding:15px;background:#102c2780;border-left:3px solid var(--yellow);font-size:15px;line-height:1.8;color:#dbe1ca}.slider-label{display:grid;grid-template-columns:1fr auto;gap:9px;margin:18px 0;font-size:17px;font-weight:700}.slider-label output{color:var(--yellow)}input[type=range]{grid-column:1/3;width:100%;height:24px;accent-color:var(--yellow);cursor:pointer}.select-label,.check-label{display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:17px;font-weight:700;margin:23px 0}.select-label select{padding:10px;background:#36564c;border:1px solid #839878;border-radius:4px;color:var(--cream);max-width:50%}.check-label input{width:25px;height:25px;accent-color:var(--yellow)}#hud{position:absolute;inset:0;pointer-events:none}#topbar{position:absolute;left:3%;right:3%;top:2.4%;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{display:flex;align-items:center;gap:14px;min-width:200px}.brand-icon{width:46px;height:46px;display:grid;place-items:center;border:2px solid var(--yellow);border-radius:50%;font-size:26px;color:var(--yellow)}.brand-name{font-family:'Barlow Condensed';font-size:27px;line-height:.92;font-weight:800;letter-spacing:.015em;text-shadow:1px 2px #20332e}.brand-name span{color:var(--yellow)}.shift-info{display:flex;align-items:center;gap:22px;font-size:15px;font-weight:800;text-shadow:1px 2px #263a30}.shift-info #shift-label{color:var(--yellow);letter-spacing:.12em}.shift-info #clock{border-left:1px solid #a7b59c;padding-left:22px;min-width:55px}.score-box{font-size:14px;letter-spacing:.14em;display:flex;align-items:center;gap:15px;font-weight:800}.score-box strong{font-family:'Barlow Condensed';font-size:40px;font-weight:700;letter-spacing:.02em;color:var(--yellow)}#tickets{position:absolute;display:flex;gap:12px;top:10.5%;left:16%;right:16%;justify-content:center;pointer-events:auto}.ticket{position:relative;flex:1;max-width:365px;min-width:0;padding:10px 15px 12px;background:#fcf0d8;border:2px solid var(--ink);box-shadow:0 5px 0 #172b23b3;color:var(--ink);border-radius:4px;text-align:left;transition:transform .1s;transform:translateY(0);border-top:5px solid var(--ticket)}.ticket.selected{transform:translateY(7px);outline:3px solid var(--ticket);outline-offset:3px}.ticket:hover{background:#fff8e8}.ticket-head{display:flex;justify-content:space-between;gap:8px;font-size:11px;font-weight:900;letter-spacing:.08em;white-space:nowrap}.ticket-head span:last-child{font-size:9px;opacity:.65}.recipe{display:flex;gap:8px;justify-content:space-around;margin:10px 0 6px}.ingredient{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;opacity:.6;font-weight:800;font-size:10px;min-width:32px;padding:3px;border-radius:3px}.ingredient.next{opacity:1;background:#f5d28780;outline:1px dashed #755b3a}.ingredient.caught{opacity:1}.ingredient.caught b{position:absolute;right:-3px;top:-5px;border-radius:50%;background:#35644b;color:#fff4da;font-size:13px;width:16px;height:16px;display:grid;place-items:center}.food{display:block;width:35px;height:17px;background:var(--food);border:2px solid #293c32;box-shadow:0 2px 0 #293c3240;border-radius:50%;position:relative}.food-patty:after{content:'';position:absolute;left:6px;right:6px;top:5px;border-top:2px dashed #5e3325}.food-lettuce{height:15px;border-radius:5px 10px 3px 9px;transform:rotate(-5deg)}.food-cheese{height:15px;border-radius:1px;transform:skewX(-12deg)}.food-tomato:after{content:'✣';position:absolute;color:#f7c98c;font-style:normal;left:10px;top:-6px;font-size:18px}.patience{height:3px;background:#d5ccb4;border-radius:5px;overflow:hidden}.patience i{display:block;height:100%;background:var(--ticket)}#pressure{position:absolute;top:30%;left:3.3%;width:135px;color:var(--cream);text-shadow:1px 1px #172c26}.pressure-label{font-size:10px;letter-spacing:.15em;font-weight:800;display:flex;justify-content:space-between;margin-bottom:7px}.pressure-track{height:11px;border:2px solid #fff1c8;background:#203c32;border-radius:20px;overflow:hidden}#pressure-fill{height:100%;background:var(--yellow);transition:width .2s}.danger #pressure-fill{background:#ed6a56}.danger{animation:alarm 1s infinite alternate}#pressure p{font-size:10px;opacity:.75;margin:7px 0}#combo{position:absolute;left:3.3%;top:39%;font-family:'Barlow Condensed';font-size:25px;color:var(--yellow);text-shadow:2px 2px var(--ink)}#bell-meter{position:absolute;right:3%;top:30%;width:135px;font-size:10px;font-weight:800;letter-spacing:.1em}#bell-meter>div{height:7px;background:#244335;border:1px solid #c8d4a5;margin-top:7px;border-radius:10px;overflow:hidden}#bell-fill{display:block;height:100%;background:#78c9b9}#controls{position:absolute;bottom:2.5%;left:0;right:0;display:flex;gap:22px;justify-content:center;font-size:11px;font-weight:800;color:#fff0d2}#controls span{white-space:nowrap}kbd{display:inline-grid;place-content:center;padding:3px 6px;min-width:23px;border:1px solid #e0debc70;border-radius:4px;background:#244c46c9;color:#fff4d9;font:700 11px 'DM Sans';margin-right:4px;box-shadow:0 2px 0 #152f26}#context-hint{position:absolute;bottom:9%;left:50%;transform:translateX(-50%);font-family:'Barlow Condensed';font-size:24px;letter-spacing:.045em;font-weight:800;white-space:nowrap;background:#183f35ed;padding:9px 22px;border:1px solid #a7bea28c;border-radius:25px;box-shadow:0 3px 0 #102d24}#context-hint kbd{font-size:15px;vertical-align:3px}#toast{position:absolute;top:27%;left:50%;transform:translate(-50%,-8px);max-width:65%;padding:10px 22px;border-radius:5px;background:#fff1d8;color:#293a31;text-align:center;font-size:17px;font-weight:800;opacity:0;transition:opacity .2s,transform .2s;box-shadow:0 3px 0 #253c3280}#toast.visible{opacity:1;transform:translate(-50%,0)}#intermission{position:absolute;inset:32% 20%;display:grid;place-content:center;text-align:center;background:#183d34f5;border:3px solid var(--yellow);border-radius:6px;box-shadow:10px 10px 0 #0e302780}#intermission small{letter-spacing:.18em;color:var(--yellow);font-weight:800}#intermission h2{margin:15px 0 4px;font-size:70px}#intermission p{font-size:23px;margin:10px 0}#attract-label{position:absolute;left:50%;bottom:15%;transform:translateX(-50%);padding:12px 25px;background:#f8d37d;color:var(--ink);border:3px solid var(--ink);box-shadow:5px 5px var(--ink);text-align:center;pointer-events:none}#attract-label b{font-family:'Barlow Condensed';font-size:28px;letter-spacing:.08em}#attract-label p{font-size:12px;font-weight:800;margin:3px 0}.result-score{font-family:'Barlow Condensed';font-size:86px;line-height:1;color:var(--yellow);margin:20px 0 5px}.result-label{letter-spacing:.2em;font-size:12px;font-weight:800}#result-stats{font-size:15px}.info-grid{display:grid;grid-template-columns:110px 1fr;gap:8px 15px;font-size:13px;line-height:1.5}.info-grid dt{color:var(--yellow);font-weight:700}.info-grid dd{margin:0;color:#d9dfce}.credits-panel{width:min(680px,57vw)}.feedback-list{font-size:13px;line-height:1.6;padding-left:20px;color:#d9dfce}.feedback-list li{margin-bottom:10px}.network-code{width:100%;height:94px;border:1px solid #7e9d83;border-radius:4px;background:#183b32;color:#fff4da;padding:10px;font-size:12px;user-select:text;resize:vertical}.network-actions{display:flex;flex-wrap:wrap;gap:7px}.small-button{font-size:14px;min-height:40px;padding:9px 13px}.network-notice{padding:11px 13px;border-left:3px solid var(--yellow);font-size:14px\"'!important;background:#142f29}#peer-list{font-size:15px;font-weight:800;color:var(--yellow)}#load{position:absolute;inset:0;display:grid;place-content:center;text-align:center;background:#1d4238;padding:30px;z-index:99}#load h2{font-size:60px;color:var(--yellow)}#load p{max-width:600px;font-size:18px;line-height:1.5}.loader{display:block;width:42px;height:42px;border:3px solid #55705c;border-top-color:var(--yellow);border-radius:50%;margin:25px auto;animation:spin 1s linear infinite}#menu-button{display:none;position:absolute;right:15px;top:15px;width:45px;height:45px;background:#244c46c9;color:var(--cream);border:1px solid #fff0bb7a;border-radius:50%;font-size:23px}#touch-action,#touch-bell{display:none;position:absolute;bottom:9%;right:5%;width:72px;height:72px;border:2px solid #ffe4a1a0;border-radius:50%;background:#f7cc7788;color:#1c3e31;font-size:14px;font-weight:900;touch-action:none}#touch-bell{right:15%;bottom:7%;width:49px;height:49px;font-size:11px;background:#79c9b898}.touch #touch-action,.touch #touch-bell,.touch #menu-button{display:block}.touch #controls{display:none}.touch #context-hint{bottom:3%;font-size:18px;padding:7px 14px}.touch #context-hint kbd{display:none}.touch #topbar .brand{display:none}.touch #tickets{left:6%;right:6%;top:9%}.touch #pressure,.touch #bell-meter{display:none}.touch #toast{font-size:13px;top:29%;max-width:82%}.touch #topbar{left:6%;right:75px}.touch .score-box strong{font-size:27px}.touch .shift-info{font-size:11px;gap:12px}.touch .shift-info #clock{padding-left:12px}.touch .panel{width:65vw;left:6%}.touch h1{font-size:65px}.touch .stamp{display:none}@keyframes spin{to{transform:rotate(360deg)}}@keyframes alarm{to{filter:brightness(1.5)}}@media(min-width:1800px){.panel{width:630px}.ticket-head{font-size:14px}.ticket-head span:last-child{font-size:11px}.ingredient{font-size:13px}.food{width:43px;height:20px}.recipe{margin:14px 0 9px;gap:12px}.ticket{padding:14px 20px}.brand-name{font-size:34px}#controls{font-size:14px}kbd{font-size:14px}.pressure-label,#bell-meter{font-size:13px}#pressure,#bell-meter{width:165px}#context-hint{font-size:30px}#toast{font-size:21px}}@media(max-width:900px){.panel{left:5%;width:48vw}.menu{gap:7px}.menu button{min-height:44px;padding:10px 15px}.tagline{font-size:15px;margin-bottom:17px}.eyebrow{font-size:10px;letter-spacing:.13em}h1{font-size:65px;margin:20px 0}.fine{font-size:10px;margin-top:15px}.stamp{width:80px;height:80px;font-size:9px}.stamp b{font-size:27px}#tickets{left:9%;right:9%;gap:8px;top:12%}.ticket{padding:6px 9px}.ticket-head{font-size:9px}.ticket-head span:last-child{font-size:7px}.ingredient{font-size:8px;min-width:23px}.food{width:27px;height:13px}.food-tomato:after{left:6px;top:-8px}.recipe{margin:6px 0 3px;gap:4px}.brand{min-width:130px;gap:9px}.brand-icon{display:none}.brand-name{font-size:20px}.shift-info{font-size:11px;gap:12px}.shift-info #clock{padding-left:12px}.score-box{font-size:10px;gap:8px}.score-box strong{font-size:30px}#pressure,#bell-meter{width:95px;top:35%}.pressure-label,#bell-meter{font-size:8px}#pressure p{display:none}#controls{gap:10px;font-size:8px}kbd{font-size:8px;padding:3px}#context-hint{font-size:18px;padding:7px 16px}#toast{font-size:13px}#combo{top:45%;font-size:19px}.howto-step{gap:12px;margin:12px 0}.howto-step p,.small-copy,.keys-copy{font-size:12px}.howto-step h3{font-size:20px}.slider-label,.select-label,.check-label{font-size:14px;margin:14px 0}.credits-panel{width:75vw}.info-grid{font-size:11px;grid-template-columns:100px 1fr}.feedback-list{font-size:11px}}\n@media(orientation:portrait){#shade{background:#173b37e6}.panel,.touch .panel{width:88vw;left:6%;max-height:90vh}.panel h1,.touch h1{font-size:85px}.panel h2{font-size:47px}.menu{max-width:100%}.tagline{font-size:18px}.stamp{display:none}.fine{font-size:12px}.touch #tickets{left:3%;right:3%;gap:6px;top:10%}.ticket-head span:last-child{display:none}.recipe{flex-wrap:wrap;gap:4px}.ingredient{font-size:8px}.touch #toast{top:31%;width:88%}.touch .shift-info{font-size:10px;gap:8px}.score-box{font-size:9px}.touch #touch-bell{right:25%}#context-hint{font-size:16px}#controls{flex-wrap:wrap;gap:6px;bottom:1%}#pressure,#bell-meter{display:none}.credits-panel{width:90vw}}\nEOF\ncat > Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/shell.html <<'\"'EOF'\n<\"'!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#244c46\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-goal\" content=\"Cooperate to serve 15 burgers across three shifts.\"><meta name=\"hub:session-howto\" content=\"Stick/WASD move; Cross/Space catch & serve; shoulders/Tab ticket; Square/Shift dash.\"><meta name=\"hub:session-minutes\" content=\"6\">\n<title>Short Order Fever — A little sizzle. A lot of heart.</title><style>/*STYLE*/</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/tsl\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\",\"rapier\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/+esm\"}}</script>\n</head><body>\n<canvas id=\"game\" aria-label=\"Short Order Fever kitchen\"></canvas><div id=\"shade\"></div>\n<div id=\"load\"><div class=\"eyebrow\">SHORT ORDER FEVER</div><h2>Warming up the griddle.</h2><span class=\"loader\"></span><p>Fresh ingredients. Hot orders. Your kitchen is almost ready.</p></div>\n<section id=\"title-panel\" class=\"panel hidden\"><div class=\"eyebrow\">A FRESH TAKE ON AN ARCADE CLASSIC</div><h1>SHORT<br>ORDER<em>FEVER.</em></h1><p class=\"tagline\">A little sizzle. A lot of heart.<br>Keep your cool. Feed the whole block.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"start\">OPEN THE KITCHEN <span>→</span></button><button data-action=\"howto\">HOW TO COOK <span>↗</span></button><button data-action=\"online\">CO-OP KITCHEN <span>1–4</span></button><div class=\"menu-split\"><button data-action=\"settings\">SETTINGS</button><button data-action=\"about\">ABOUT / CREDITS</button></div></nav><div class=\"fine\">STICK / WASD TO MOVE · ✕ / SPACE TO CATCH & SERVE<br>AN ORIGINAL TRIBUTE TO PRESSURE COOKER (1983)</div></section>\n<div class=\"stamp\" id=\"stamp\">FRESH OFF<br><b>THE GRILL</b>EST. 1983</div>\n<section id=\"howto-panel\" class=\"panel hidden\"><div class=\"eyebrow\">THE SHORT ORDER HANDBOOK</div><h2>ALL HEART.<br>NO COLD BUNS.</h2><div class=\"howto-step\"><b>1</b><div><h3>READ YOUR TICKET</h3><p>Your highlighted ticket is your tray. Catch its ingredients in order, from left to right. The next layer has a dashed border.</p></div></div><div class=\"howto-step\"><b>2</b><div><h3>CATCH THE GOOD STUFF</h3><p>Move up to the conveyor. Catch with Space / ✕ when the right ingredient is beside you. A wrong catch adds pressure.</p></div></div><div class=\"howto-step\"><b>3</b><div><h3>SEND IT HOME</h3><p>Carry a full stack down to its matching color hatch. Space / ✕ serves it. Fifteen burgers across three shifts wins the day.</p></div></div><div class=\"keys-copy\"><b>WASD / arrows</b> move · <b>Space</b> catch & serve · <b>Tab / 1–3</b> ticket<br><b>Shift</b> dash · <b>Q</b> toss tray · <b>E</b> time-out bell · <b>Esc</b> pause<br><b>Pad:</b> left stick · ✕ catch · □ dash · ○ toss · △ bell · L1/R1 ticket<br><b>Mouse:</b> click the floor to move, ingredients to catch, hatches to deliver.<br><b>Touch:</b> drag anywhere on the left to move. Correct catches and deliveries are assisted. Tap a ticket to switch.</div><p class=\"small-copy\">Serve to cool the pressure and recharge the bell. Missed ingredients, expired tickets and wrong catches heat things up. Later shifts add more layers and a steaming floor vent. Don’t let pressure hit 100% or the shift clock run out.</p><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<section id=\"pause-panel\" class=\"panel hidden\"><div class=\"eyebrow\">HOLD THE PICKLES</div><h2>TAKE FIVE,<br>CHEF.</h2><nav class=\"menu\"><button class=\"primary\" data-action=\"resume\">BACK TO THE GRIDDLE <span>→</span></button><button data-action=\"howto\">HOW TO COOK</button><button data-action=\"settings\">SETTINGS</button><button data-action=\"dev\">DEVELOPER KITCHEN</button><button data-action=\"restart\">RESTART SHIFT ONE</button><button data-action=\"title\">CLOSE KITCHEN</button></nav></section>\n<section id=\"settings-panel\" class=\"panel hidden\"><div class=\"eyebrow\">YOUR HOUSE SPECIAL</div><h2>SET THE MOOD.</h2><label class=\"slider-label\"><span>Music</span><output id=\"music-output\">10%</output><input aria-label=\"Music volume\" id=\"music-volume\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"></label><label class=\"slider-label\"><span>Sound effects & voices</span><output id=\"sfx-output\">65%</output><input aria-label=\"Sound effect volume\" id=\"sfx-volume\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"></label><label class=\"select-label\">Controller prompts<select id=\"glyphs\"><option value=\"ps\">PlayStation ✕ ○ □ △</option><option value=\"xbox\">Xbox A B X Y</option></select></label><label class=\"check-label\"><span>Kitchen assist<br><small>Auto-catch the correct layer & auto-serve</small></span><input id=\"assist\" type=\"checkbox\"></label><p class=\"small-copy\">Prompts follow the input you use. Touch always includes kitchen assist. Audio is made entirely from code.</p><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<section id=\"dev-panel\" class=\"panel hidden\"><div class=\"eyebrow\">THE TEST KITCHEN</div><h2>SEASON TO TASTE.</h2><div id=\"dev-sliders\"></div><label class=\"check-label\">No pressure damage<input id=\"dev-invincible\" type=\"checkbox\"></label><label class=\"check-label\">Autochef playthrough<input id=\"dev-auto\" type=\"checkbox\"></label><div class=\"network-actions\"><button class=\"small-button\" data-action=\"dev-fill\">FILL TRAY</button><button class=\"small-button\" data-action=\"dev-clear\">COOL KITCHEN</button><button class=\"small-button\" data-action=\"dev-next\">NEXT SHIFT</button><button class=\"small-button\" data-action=\"dev-reset\">RESET DEFAULTS</button></div><p class=\"small-copy\">Sliders update the live simulation. Developer tools affect this run only.</p><button class=\"primary back\" data-action=\"resume\">BACK TO THE GRIDDLE →</button></section>\n<section id=\"online-panel\" class=\"panel hidden\"><div class=\"eyebrow\">MANY HANDS. HOT BURGERS.</div><h2>CO-OP KITCHEN.</h2><p class=\"small-copy\">Share one kitchen with up to four chefs. Every chef has a tray; tickets and pressure are shared. AI Hub connects everyone automatically.</p><h3>SAME DEVICE / BROWSER</h3><p class=\"small-copy\">Open this game in two tabs from the same address. One chef opens a kitchen; the others join.</p><div class=\"network-actions\"><button class=\"small-button primary\" data-action=\"host-local\">OPEN LOCAL KITCHEN</button><button class=\"small-button\" data-action=\"join-local\">JOIN LOCAL KITCHEN</button></div><h3>FRIEND ON ANOTHER DEVICE</h3><p class=\"small-copy\">Host: make an invite and send it to your friend. Friend: paste it below, choose Answer invite, and send the answer back. Host: paste that answer and connect. Direct connection availability depends on your network.</p><textarea id=\"network-code\" class=\"network-code\" aria-label=\"Connection code\" placeholder=\"Paste your invite or answer code here…\" spellcheck=\"false\"></textarea><div class=\"network-actions\"><button class=\"small-button\" data-action=\"invite\">MAKE INVITE</button><button class=\"small-button\" data-action=\"accept-invite\">ANSWER INVITE</button><button class=\"small-button\" data-action=\"accept-answer\">CONNECT ANSWER</button><button class=\"small-button\" data-action=\"copy-code\">COPY CODE</button></div><p id=\"network-status\" class=\"network-notice\">No kitchen connected. Solo play is always available.</p><p id=\"peer-list\"></p><div class=\"network-actions\"><button class=\"primary small-button\" data-action=\"coop-start\">START / RESTART SERVICE</button><button class=\"secondary small-button\" data-action=\"back\">← BACK</button></div></section>\n<section id=\"result-panel\" class=\"panel hidden\"><div id=\"result-eyebrow\" class=\"eyebrow\"></div><h2 id=\"result-title\"></h2><p id=\"result-copy\"></p><div class=\"result-label\">TOTAL TIPS</div><div id=\"result-score\" class=\"result-score\"></div><p id=\"result-stats\"></p><nav class=\"menu\"><button class=\"primary\" data-action=\"restart\">ANOTHER SHIFT? <span>→</span></button><button data-action=\"title\">BACK TO THE DINER</button></nav></section>\n<section id=\"about-panel\" class=\"panel credits-panel hidden\"><div class=\"eyebrow\">FROM THE TEST KITCHEN</div><h2>ABOUT & CREDITS.</h2><p>An original, affectionate arcade cooking game inspired by the ingredient conveyor, layered orders and cheerful pressure of <b>Pressure Cooker (1983)</b>. Procedural art, animation, music, sound and gibberish voices. Built for a controller on the couch.</p><h3>SOURCE INFORMATION</h3><dl id=\"source-info\" class=\"info-grid\"></dl><h3>TESTING FEEDBACK</h3><ol id=\"testing-feedback\" class=\"feedback-list\"></ol><h3>ENGINE FEEDBACK</h3><ol id=\"engine-feedback\" class=\"feedback-list\"></ol><h3>PROMPT FEEDBACK</h3><ol id=\"prompt-feedback\" class=\"feedback-list\"></ol><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<div id=\"hud\" class=\"hidden\"><div id=\"topbar\"><div class=\"brand\"><span class=\"brand-icon\">♨</span><div class=\"brand-name\">SHORT ORDER<br><span>FEVER.</span></div></div><div class=\"shift-info\"><span id=\"shift-label\"></span><span id=\"quota\"></span><span id=\"clock\"></span></div><div class=\"score-box\">TIPS <strong id=\"score\">00000</strong></div></div><div id=\"tickets\"></div><div id=\"pressure\"><div class=\"pressure-label\">PRESSURE <span id=\"pressure-value\">8%</span></div><div class=\"pressure-track\"><div id=\"pressure-fill\"></div></div><p>KEEP YOUR COOL, CHEF.</p></div><div id=\"combo\"></div><div id=\"bell-meter\"><span id=\"bell-label\">BELL READY</span><div><i id=\"bell-fill\"></i></div></div><div id=\"toast\"></div><div id=\"context-hint\"></div><div id=\"controls\"></div><div id=\"intermission\" class=\"hidden\"></div></div>\n<div id=\"attract-label\" class=\"hidden\"><b>THE KITCHEN NEVER SLEEPS</b><p>ATTRACT DEMO · PRESS ANY BUTTON TO PLAY</p></div><button id=\"menu-button\" data-action=\"pause\" aria-label=\"Pause\">☰</button><button id=\"touch-action\" aria-label=\"Catch or serve\">CATCH</button><button id=\"touch-bell\" aria-label=\"Ring time out bell\">BELL</button><div id=\"engine-label\"></div>\n<script type=\"module\">/*MODULES*/</script></body></html>\nEOF\ncat > Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/build.py <<'\"'EOF'\nfrom pathlib import Path\nimport json\np=Path(__file__).resolve().parent\nmeta=json.loads((p/'title.json').read_text())\nhtml=(p/'shell.html').read_text().replace('<\"'!--HUB_CLIENT-->'\"','<script>'+(p/'session.js').read_text()+'</script>')\nhtml=html.replace('/*STYLE*/',(p/'style.css').read_text())\nmodules=[]\nfor name in ['scene.js','audio.js','network.js','game.js']:\n    code=(p/name).read_text().replace('export async function ','async function ').replace('export function ','function ').replace('export class ','class ')\n    modules.append(code)\ninterview=json.loads((p.parent/'exit-interview.json').read_text()) if (p.parent/'exit-interview.json').exists() else {'sourceInformation':{},'testingFeedback':[],'engineFeedback':[],'promptFeedback':[]}\ncredits=\\\"const CREDITS=\\\"+json.dumps(interview)+\\\";document.getElementById('source-info').innerHTML=Object.entries(CREDITS.sourceInformation).map(([k,v])=>'<dt>'+k[0].toUpperCase()+k.slice(1)+'</dt><dd>'+v+'</dd>').join('');for(const [key,id] of [['testingFeedback','testing-feedback'],['engineFeedback','engine-feedback'],['promptFeedback','prompt-feedback']])document.getElementById(id).innerHTML=CREDITS[key].map(v=>'<li>'+v+'</li>').join('');\\\"\nhtml=html.replace('/*MODULES*/','\\\\n'.join(modules)+'\\\\n'+credits)\n(p.parent/(meta['slug']+'.html')).write_text(html)\nprint(meta['slug']+'.html')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
