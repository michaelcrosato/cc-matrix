{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc 'cat Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_remote.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc 'cat Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_remote.py'","aggregated_output":"\"\"\"Real standalone WebRTC co-op against two complete game pages.\n\nImport run(base_url) from the unified test command. No output on success;\nthe CLI prints only failures and one count. No physical controller needed.\n\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nSLUG = 'Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659'\n\n\ndef run(base_url):\n    count = 0\n    failures = []\n    report = {}\n    errors = []\n\n    def check(name, fn):\n        nonlocal count\n        count += 1\n        try:\n            result = fn()\n            if result is False:\n                raise AssertionError('condition was false')\n        except Exception as exc:\n            failures.append(name+': '+str(exc).splitlines()[0])\n\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(headless=True, args=[\n            '--enable-unsafe-webgpu', '--enable-features=Vulkan',\n            '--use-webgpu-adapter=swiftshader',\n            '--disable-background-timer-throttling', '--disable-renderer-backgrounding',\n            '--autoplay-policy=no-user-gesture-required',\n        ])\n        context = browser.new_context(ignore_https_errors=True, viewport={'width': 1280, 'height': 800})\n        host = context.new_page()\n        guest = context.new_page()\n        try:\n            url = base_url.rstrip('/')+'/'+SLUG+'.html?webgl'\n            for role, page in [('host', host), ('guest', guest)]:\n                page.on('pageerror', lambda error, label=role: errors.append(label+': '+str(error)))\n                page.goto(url, wait_until='domcontentloaded', timeout=60000)\n                page.wait_for_function('window.__gameReady || window.__gameError', timeout=90000)\n            check('WebRTC full game pages initialize', lambda:\n                  host.title().startswith('Short Order Fever') and guest.title().startswith('Short Order Fever') and\n                  host.evaluate('!!window.__gameReady && !window.__gameError') and\n                  guest.evaluate('!!window.__gameReady && !window.__gameError'))\n            offer = host.evaluate('__game.network.createInvite()')\n            answer = guest.evaluate('(offer) => __game.network.acceptInvite(offer)', offer)\n            host.evaluate('(answer) => __game.network.acceptAnswer(answer)', answer)\n            host.wait_for_function('__game.getNetwork().players.length===2', timeout=20000)\n            guest.wait_for_function('__game.getNetwork().me===1 && __game.getNetwork().players.length===2', timeout=10000)\n            check('WebRTC connects and assigns two chef seats', lambda:\n                  host.evaluate('__game.getNetwork().mode === \"local-host\" && __game.getNetwork().authority') and\n                  guest.evaluate('__game.getNetwork().mode === \"rtc-guest\" && !__game.getNetwork().authority'))\n            host.evaluate('__game.start()')\n            host.wait_for_function('__game.getState().players.length===2 && __game.getScreen()===\"playing\"')\n            guest.wait_for_function('__game.getState().players.length===2 && __game.getScreen()===\"playing\"')\n            check('WebRTC full game world and roster replicate', lambda:\n                  host.evaluate('__game.getState().players.map(p=>p.id).join()') ==\n                  guest.evaluate('__game.getState().players.map(p=>p.id).join()') == '0,1')\n            start_x = host.evaluate('__game.getState().players.find(p=>p.id===1).x')\n            guest.keyboard.down('d')\n            host.wait_for_function('(x)=>__game.getState().players.find(p=>p.id===1).x>x+.8', arg=start_x, timeout=6000)\n            guest.keyboard.up('d')\n            guest.evaluate('__game.network.sendInput({x:0,z:0})')\n            check('WebRTC guest movement reaches authoritative kitchen', lambda:\n                  host.evaluate('__game.getState().players.find(p=>p.id===1).x') > start_x+.8)\n            guest.evaluate('__game.network.sendInput({x:0,z:0,select:-1})')\n            host.wait_for_function('__game.getState().players.find(p=>p.id===1).order===0', timeout=5000)\n            check('WebRTC signed ticket selection survives input coalescing', lambda:\n                  host.evaluate('__game.getState().players.find(p=>p.id===1).order') == 0)\n            guest.evaluate('__game.network.sendInput({x:0,z:0,bell:true})')\n            host.wait_for_function('__game.getState().stats.bells===1', timeout=5000)\n            guest.wait_for_function('__game.getState().stats.bells===1', timeout=5000)\n            check('WebRTC remote action changes replicated game state', lambda:\n                  host.evaluate('__game.getState().freeze>0') and guest.evaluate('__game.getState().freeze>0'))\n            host.evaluate('__game.setState({score:321,served:2}); __game.finish(true)')\n            guest.wait_for_function('__game.getState().mode===\"victory\" && __game.getState().score===321', timeout=5000)\n            check('WebRTC completed round reaches remote result screen', lambda:\n                  guest.evaluate('__game.getScreen()') == 'result')\n            host.evaluate('__game.start()')\n            guest.wait_for_function('__game.getScreen()===\"playing\" && __game.getState().score===0 && __game.getState().served===0', timeout=5000)\n            check('WebRTC round restart preserves the connected kitchen', lambda:\n                  guest.evaluate('__game.getNetwork().players.length===2 && __game.getNetwork().started && !__game.getNetwork().ended') and\n                  host.evaluate('__game.getState().players.length===2'))\n            report['host'] = host.evaluate('__game.getNetwork()')\n            report['guest'] = guest.evaluate('__game.getNetwork()')\n            report['gameState'] = host.evaluate('__game.getState()')\n            host.evaluate('__game.network.close()')\n            guest.wait_for_function('__game.getNetwork().ended', timeout=5000)\n            check('WebRTC host departure closes remote kitchen', lambda:\n                  guest.evaluate('__game.getNetwork().ended'))\n            check('WebRTC full game emits no browser errors', lambda: not errors)\n        except Exception as exc:\n            count += 1\n            failures.append('WebRTC full game sequence: '+str(exc).splitlines()[0])\n        finally:\n            report['browserErrors'] = errors\n            report['failures'] = failures\n            report['checks'] = count\n            for page in (host, guest):\n                try:\n                    page.evaluate('__game?.network?.close()')\n                except Exception:\n                    pass\n            context.close()\n            browser.close()\n    Path(__file__).with_name('remote-report.json').write_text(json.dumps(report, indent=2))\n    return count, failures\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser()\n    parser.add_argument('base_url', nargs='?', default='http://127.0.0.1:34895')\n    total, failures = run(parser.parse_args().base_url)\n    for failure in failures:\n        print('FAIL '+failure)\n    print(f'{total-len(failures)}/{total} WebRTC game checks passed')\n    raise SystemExit(bool(failures))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_remote.py')\ns=p.read_text().replace(\\\"offer = host.evaluate('__game.network.createInvite()')\\\", \\\"host.locator('#title-panel [data-action=online]').click()\\\\n            host.locator('[data-action=invite]').click()\\\\n            host.wait_for_function('document.getElementById(\\\\\\\"network-code\\\\\\\").value.length>50', timeout=20000)\\\\n            check('WebRTC generated invite stays visible in lobby',lambda:host.locator('#network-code').is_visible() and host.evaluate('__game.getScreen()')=='online')\\\\n            offer = host.locator('#network-code').input_value()\\\")\ns=s.replace(\\\"answer = guest.evaluate('(offer) => __game.network.acceptInvite(offer)', offer)\\\",\\\"guest.locator('#title-panel [data-action=online]').click()\\\\n            answer = guest.evaluate('(offer) => __game.network.acceptInvite(offer)', offer)\\\")\ns=s.replace(\\\"host.evaluate('__game.start()')\\\\n            host.wait_for_function\\\", \\\"host.locator('[data-action=coop-start]').click()\\\\n            host.wait_for_function\\\",1)\ns=s.replace(\\\"start_x = host.evaluate\\\", \\\"guest.keyboard.press('Escape')\\\\n            guest.wait_for_timeout(450)\\\\n            check('WebRTC guest pause survives incoming snapshots',lambda:guest.evaluate('__game.getScreen()')=='pause')\\\\n            guest.locator('#pause-panel [data-action=resume]').click()\\\\n            start_x = host.evaluate\\\")\np.write_text(s)\np=Path('Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test.py')\ns=p.read_text().replace('from test_hub import run as hub_checks','from test_hub import run as hub_checks\\\\nfrom test_remote import run as remote_checks')\ns=s.replace(\\\"check('pause freezes shift clock',lambda:page.evaluate\\\", \\\"pause_time=page.evaluate('__game.getState().shiftTime');page.wait_for_timeout(250)\\\\n            check('pause freezes shift clock',lambda:page.evaluate('__game.getState().shiftTime')==pause_time and page.evaluate\\\")\ns=s.replace(\\\"page.evaluate('window.__pad=null')\\\\n            page.keyboard.press('Escape');page.locator('#pause-panel\\\", \\\"page.evaluate('window.__pad=null');stop_x=page.evaluate('__game.getState().players[0].x');page.wait_for_timeout(250)\\\\n            check('disconnected controller stops movement',lambda:abs(page.evaluate('__game.getState().players[0].x')-stop_x)<.1)\\\\n            page.keyboard.press('Escape');page.locator('#pause-panel\\\",1)\n# Extra actual pad navigation to SELECT and checkboxes; keep 60ms+ edges separate.\na=\\\"            page.evaluate('window.__pad=null')\\\\n            # Attract mode\\\"\nb=\\\"\\\"\\\"            def pad_press(index):\n                page.evaluate('(i)=>window.__pad.buttons[i]={pressed:true,value:1}',index);page.wait_for_timeout(90)\n                page.evaluate('(i)=>window.__pad.buttons[i]={pressed:false,value:0}',index);page.wait_for_timeout(90)\n            page.evaluate('window.__pad.axes=[0,0,0,0]')\n            pad_press(9)\n            pad_press(13);pad_press(13);pad_press(0)\n            check('controller opens Settings through menu',lambda:page.evaluate('__game.getScreen()')=='settings')\n            pad_press(13);pad_press(13)\n            old_glyph=page.locator('#glyphs').input_value();pad_press(15)\n            check('controller changes prompt SELECT',lambda:page.locator('#glyphs').input_value()\"'!=old_glyph)\n            pad_press(13);old_assist=page.locator('\"'#assist').is_checked();pad_press(0)\n            check('controller toggles Settings checkbox',lambda:page.locator('#assist').is_checked()\"'!=old_assist)\n            pad_press(1);pad_press(13);pad_press(13);pad_press(13);pad_press(0)\n            check('\"'controller opens Developer Kitchen',lambda:page.evaluate('__game.getScreen()')=='dev')\n            for _ in range(6):pad_press(13)\n            pad_press(0)\n            check('controller toggles developer checkbox',lambda:page.locator('#dev-invincible').is_checked())\n            pad_press(0)\n            page.evaluate('window.__pad=null')\n            page.locator('#dev-panel [data-action=resume]').click()\n            # Attract mode\\\"\\\"\\\"\nassert a in s\ns=s.replace(a,b)\ns=s.replace(\\\"count,failures=hub_checks(base);COUNT+=count;FAIL.extend(failures)\\\",\\\"count,failures=remote_checks(base);COUNT+=count;FAIL.extend(failures)\\\\n            count,failures=hub_checks(base);COUNT+=count;FAIL.extend(failures)\\\")\np.write_text(s)\nPY\npython3 -m py_compile Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test.py Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_remote.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
