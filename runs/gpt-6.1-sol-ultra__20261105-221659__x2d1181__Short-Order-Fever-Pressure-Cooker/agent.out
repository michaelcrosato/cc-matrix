inLocal(), createInvite(), acceptInvite(text), acceptAnswer(text), close(). Hub mode shared-world 1-4 (metas root), host-authoritative. initHub returns {active,players,isHost,me,server}; onStart called hub time>=0 handled by root if flag. Hub client included unmodified in head. Standalone BroadcastChannel local tabs, plus manual WebRTC copy/paste remote offers/answers (createInvite returns text, acceptInvite returns answer, acceptAnswer completes; trickle gather wait). No user HTML injected. Input {x,z,action,discard,dash,bell,select}; world serializable plain state. Network messages <=16KB at max 10Hz; drop oversized visual-only effects. close cleans network only. Avoid dependencies on game internals. finish state.score, state.served, state.mode === victory, state.stats. onEnd must stop sound/input in root. onPeers informs [{id,name,color}]. Local solo id=0. Standalone co-op same world up to4.\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/game.js <<'EOF'\nconst INGREDIENTS={patty:{name:'Patty',color:'#8d4e32',icon:'P'},lettuce:{name:'Lettuce',color:'#91be54',icon:'L'},tomato:{name:'Tomato',color:'#e7644d',icon:'T'},cheese:{name:'Cheese',color:'#f1c454',icon:'C'}};\nconst COLORS=['#f87963','#63c6bb','#f7c85f','#b998e4'];\nconst HATCHES=[-5.5,0,5.5];\nconst DEFAULTS={beltSpeed:1.65,chefSpeed:5.4,patience:62,pressureRate:1,catchRadius:2.25,shiftSeconds:110};\nconst tuning={...DEFAULTS};\nconst SHIFTS=[{name:'THE WARM-UP',subtitle:'A little sizzle. A lot of heart.',quota:4,ingredients:2,speed:1},{name:'LUNCH STAMPEDE',subtitle:'The lunch crowd brought friends.',quota:5,ingredients:3,speed:1.18},{name:'FEVER HOUR',subtitle:'Keep your cool. Feed the whole block.',quota:6,ingredients:4,speed:1.38}];\nlet nextItem=1,nextOrder=1;\nfunction freshOrder(index,shift,serial=0){const sets=[['patty','cheese'],['patty','lettuce'],['patty','tomato'],['patty','cheese','tomato'],['patty','lettuce','tomato'],['patty','cheese','lettuce'],['patty','lettuce','tomato','cheese']];let choices=shift===0?sets.slice(0,3):shift===1?sets.slice(3,6):[sets[6],['patty','cheese','tomato','lettuce'],['patty','tomato','cheese','lettuce']];return{id:nextOrder++,color:COLORS[index],recipe:[...choices[(index+serial)%choices.length]],patience:tuning.patience,maxPatience:tuning.patience,label:['SUNSET','MINT','GOLDEN'][index],served:false};}\nfunction makePlayer(id=0,name='CHEF',color=COLORS[id%4]){return{id,name,color,x:(id-1.5)*1.7,z:3.1,angle:Math.PI,stack:[],order:id%3,dash:0,dashCooldown:0,action:0,stun:0,body:null};}\nfunction newState(attract=false){nextItem=1;nextOrder=1;return{mode:'playing',attract,time:0,shift:0,shiftTime:tuning.shiftSeconds,shiftServed:0,score:0,served:0,combo:0,bestCombo:0,pressure:8,freeze:0,bellCharge:1,orders:Array.from({length:3},(_,i)=>freshOrder(i,0)),players:[makePlayer()],items:Array.from({length:11},(_,i)=>({id:nextItem++,type:['patty','cheese','patty','lettuce','tomato'][i%5],x:-9+i*1.65,z:-.65})),effects:[],spawn:0,transition:0,stats:{caught:0,wrong:0,wasted:0,expired:0,dashes:0,bells:0},toast:'',toastTime:0,ventPhase:0};}\nlet state=newState();let screen='title',previousScreen='title',paused=false,devOpen=false,lastInput='keyboard',glyphs='ps',lastActivity=performance.now(),menuFocus=0,muted=false;\nlet scene,audio,network,physics,rapier,simAccumulator=0,networkTimer=0,renderTime=0;\nlet input={x:0,z:0,action:false,discard:false,dash:false,bell:false,select:0};\nlet remoteInputs=new Map(),held=new Set(),pointerTarget=null,padPrevious=[],touches=new Map(),isTouch=false;\nlet settings={music:.10,sfx:.65,glyphs:'ps',assist:false};\ntry{settings={...settings,...JSON.parse(localStorage.getItem('sof-settings')||'{}')};}catch{}\nglyphs=settings.glyphs;\nconst \"'$=id=>document.getElementById(id);\nfunction saveSettings(){try{localStorage.setItem('\"'sof-settings',JSON.stringify(settings));}catch{}}\nfunction notice(text,seconds=2.8){state.toast=text;state.toastTime=seconds;}\nfunction sound(name){if(\"'!muted)audio?.sfx(name);}\nfunction feedback(text,name='\"'ui'){notice(text);sound(name);}\nfunction localPlayer(){return state.players.find(p=>p.id===(network?.localId()??0))||state.players[0];}\nfunction safeState(){return JSON.parse(JSON.stringify(state,(k,v)=>k==='body'?undefined:v));}\nfunction resetBodies(){if(\"'!physics||!rapier)return;for(const p of state.players){p.body=physics.createRigidBody(rapier.RigidBodyDesc.kinematicPositionBased().setTranslation(p.x,.48,p.z));physics.createCollider(rapier.ColliderDesc.ball(.36).setFriction(.2),p.body);}}\nfunction startGame(attract=false){if(network?.hubInfo?.active&&!attract&&screen==='\"'playing')return;state=newState(attract);const peers=network?.names()||[];if(peers.length)state.players=peers.map(p=>makePlayer(p.id,p.name,p.color));resetBodies();screen='playing';paused=false;devOpen=false;pointerTarget=null;remoteInputs.clear();setOverlay();if(\"'!attract){audio?.unlock();audio?.voice('\"'start');}updateHUD();}\nfunction changeOrder(p,direction){const n=(p.order+direction+3)%3;if(p.stack.length){if(p.id===localPlayer()?.id)feedback('Finish your stack first — or toss it with '+promptFor('discard'), 'wrong');return;}p.order=n;sound('ui');}\nfunction catchOrServe(p){if(p.stun>0)return;const o=state.orders[p.order];if(p.stack.length===o.recipe.length){const hatch=HATCHES[p.order];if(Math.abs(p.x-hatch)<2&&p.z>3.95){serve(p);return;}if(p.z>4){penalty(7,'Wrong hatch\"'! Follow your ticket color.'\"');return;}if(p.id===localPlayer()?.id)notice('Stack ready\"'! Deliver to '\"'+o.label+' hatch.');return;}\nconst near=state.items.filter(it=>Math.hypot(it.x-p.x,it.z-p.z)<tuning.catchRadius).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z));\nif(\"'!near.length){if(p.id===localPlayer()?.id)notice(p.z>2?'\"'Move to the conveyor to catch ingredients.':'Get beside an ingredient, then '+promptFor('action')+'.',1.7);return;}\nconst it=near[0],needed=o.recipe[p.stack.length];state.items=state.items.filter(i=>i.id\"'!==it.id);p.action=.35;\nif(it.type===needed){p.stack.push(it.type);state.stats.caught++;sound('\"'catch');scene?.burst(p.x,p.z,INGREDIENTS[it.type].color,7);if(p.stack.length===o.recipe.length){notice(o.label+' stack ready\"'! Bring it to its hatch.'\"');audio?.voice('ready');}else if(p.id===localPlayer()?.id)notice('Nice\"'! Next: '\"'+INGREDIENTS[o.recipe[p.stack.length]].name,1.3);}\nelse{state.stats.wrong++;penalty(8,'Oops\"'! Your next layer is '\"'+INGREDIENTS[needed].name+'.');scene?.burst(p.x,p.z,'#e96f58',5);}}\nfunction penalty(n,msg){if(\"'!state.attract&&!devInvincible)state.pressure=Math.min(100,state.pressure+n);state.combo=0;notice(msg);sound('\"'wrong');}\nlet devInvincible=false,devAuto=false;\nfunction serve(p){const o=state.orders[p.order];const gain=200+Math.min(state.combo,9)*50+Math.round(o.patience*2);state.score+=gain;state.served++;state.shiftServed++;state.combo++;state.bestCombo=Math.max(state.bestCombo,state.combo);state.pressure=Math.max(0,state.pressure-13);state.bellCharge=Math.min(1,state.bellCharge+.36);state.orders[p.order]=freshOrder(p.order,state.shift,state.served);for(const q of state.players)if(q.order===p.order)q.stack=[];scene?.burst(p.x,p.z,o.color,26);notice('ORDER UP\"'!  +'\"'+gain+'   '+(state.combo>1?state.combo+'× hot streak\"'!'\"':'Beautifully done.'));sound('serve');audio?.voice('serve');p.action=.6;\nif(state.shiftServed>=SHIFTS[state.shift].quota){if(state.shift===2){endGame(true);return;}state.mode='intermission';state.transition=4.8;notice('SHIFT CLEARED\"'! The next crowd is on its way.'\"',4.8);sound('win');}}\nfunction discard(p){if(\"'!p.stack.length)return;scene?.burst(p.x,p.z,'\"'#f5dfb4',6);p.stack=[];state.stats.wasted++;penalty(3,'Fresh tray. Let’s make this one count.');}\nfunction ringBell(){if(state.bellCharge<.98){notice('Bell recharging. Serve burgers to fill it.');return;}state.bellCharge=0;state.freeze=5;state.stats.bells++;sound('bell');audio?.voice('bell');notice('TIME, PLEASE\"'! Conveyor and ticket timers paused for 5 seconds.'\"');}\nfunction nextShift(){state.shift++;state.shiftServed=0;state.shiftTime=tuning.shiftSeconds;state.pressure=Math.max(5,state.pressure-18);state.orders=state.orders.map((_,i)=>freshOrder(i,state.shift,state.served));for(const p of state.players)p.stack=[];state.bellCharge=1;state.mode='playing';notice(SHIFTS[state.shift].name+' — '+SHIFTS[state.shift].subtitle,4);audio?.voice('start');}\nfunction endGame(won){state.mode=won?'victory':'defeat';if(state.attract){state.transition=6;return;}screen='result';sound(won?'win':'lose');audio?.voice(won?'win':'lose');if(\"'!network?.hubInfo?.active){try{const best=Number(localStorage.getItem('\"'sof-best')||0);if(state.score>best)localStorage.setItem('sof-best',String(state.score));}catch{}}network?.finish(state);setOverlay();}\nfunction botInput(p,dt){const o=state.orders[p.order];const needed=o.recipe[p.stack.length];let tx,tz,act=false;if(p.stack.length===o.recipe.length){tx=HATCHES[p.order];tz=4.75;act=Math.abs(tx-p.x)<1.3&&p.z>4.1;}else{let it=state.items.filter(i=>i.type===needed).sort((a,b)=>Math.abs(a.x-p.x)-Math.abs(b.x-p.x))[0];if(\"'!it){it={x:p.x,type:needed};if(state.attract||devAuto)state.items.push({id:nextItem++,type:needed,x:Math.max(-8,Math.min(8,p.x)),z:-.65});}tx=Math.max(-8,Math.min(8,it.x+.3));tz=.7;const nearest=state.items.filter(i=>Math.hypot(i.x-p.x,i.z-p.z)<tuning.catchRadius).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z))[0];act=nearest?.type===needed&&p.z<1.2;}\nreturn{x:Math.abs(tx-p.x)>.15?Math.sign(tx-p.x):0,z:Math.abs(tz-p.z)>.12?Math.sign(tz-p.z):0,action:act,discard:false,bell:state.pressure>45&&state.bellCharge>=1,dash:Math.hypot(tx-p.x,tz-p.z)>4,select:0};}\nfunction simulate(dt){if(state.mode==='\"'victory'||state.mode==='defeat'){if(state.attract&&(state.transition-=dt)<=0)startGame(true);return;}state.time+=dt;state.toastTime=Math.max(0,state.toastTime-dt);if(state.mode==='intermission'){state.transition-=dt;if(state.transition<=0)nextShift();return;}\nstate.freeze=Math.max(0,state.freeze-dt);state.bellCharge=Math.min(1,state.bellCharge+dt*.016);state.shiftTime-=dt;\nif(\"'!state.attract&&!devInvincible)state.pressure+=dt*(.12+state.shift*.07)*tuning.pressureRate;\nstate.ventPhase=(state.time%15);const ventOn=state.shift>0&&state.ventPhase>11.5&&state.ventPhase<14;\nfor(const p of state.players){let cmd=state.attract||devAuto?botInput(p,dt):p.id===(network?.localId()??0)?input:remoteInputs.get(p.id)||{};p.dashCooldown=Math.max(0,p.dashCooldown-dt);p.stun=Math.max(0,p.stun-dt);p.action=Math.max(0,p.action-dt);p.dash=Math.max(0,p.dash-dt);if(cmd.select){changeOrder(p,cmd.select);cmd.select=0;}if(cmd.dash&&p.dashCooldown<=0&&p.stun<=0){p.dash=.2;p.dashCooldown=1.25;state.stats.dashes++;sound('\"'dash');}let dx=cmd.x||0,dz=cmd.z||0;const l=Math.hypot(dx,dz);if(l>1){dx/=l;dz/=l;}const speed=tuning.chefSpeed*(p.dash>0?2.5:1)*(p.stun>0?.2:1);p.x=Math.max(-8,Math.min(8,p.x+dx*speed*dt));p.z=Math.max(.65,Math.min(5.25,p.z+dz*speed*dt));if(l>.1)p.angle=Math.atan2(dx,dz);if(p.body){p.body.setNextKinematicTranslation({x:p.x,y:.48,z:p.z});}\nif(ventOn&&Math.abs(p.x)<1&&p.z>2.2&&p.z<3.35&&p.stun<=0){p.stun=.85;penalty(4,'Hot floor\"'! Dash around the steam vent.'\"');sound('spill');}if(cmd.action&&p._actCooldown<=0){catchOrServe(p);p._actCooldown=.23;}p._actCooldown=Math.max(0,(p._actCooldown||0)-dt);if(cmd.action&&p._actCooldown===0){catchOrServe(p);p._actCooldown=.23;}if(cmd.discard){discard(p);cmd.discard=false;}if(cmd.bell){ringBell();cmd.bell=false;}}\nphysics?.step();\nif(state.freeze<=0){const speed=tuning.beltSpeed*SHIFTS[state.shift].speed;for(const it of state.items)it.x+=speed*dt;const escaped=state.items.filter(i=>i.x>9.3).length;if(escaped){state.stats.wasted+=escaped;if(\"'!state.attract&&!devInvincible)state.pressure+=escaped*.45*tuning.pressureRate;}state.items=state.items.filter(i=>i.x<=9.3);state.spawn-=dt;if(state.spawn<=0){state.spawn=.92/(state.shift*.12+1);const types=Object.keys(INGREDIENTS);const missing=state.players.map(p=>state.orders[p.order].recipe[p.stack.length]).filter(Boolean);const type=Math.random()<.7&&missing.length?missing[Math.floor(Math.random()*missing.length)]:types[Math.floor(Math.random()*types.length)];state.items.push({id:nextItem++,type,x:-9,z:-.65});}for(let i=0;i<state.orders.length;i++){const o=state.orders[i];o.patience-=dt;if(o.patience<=0){state.stats.expired++;penalty(13,o.label+'\"' ticket expired\"'! New order coming in.'\"');state.orders[i]=freshOrder(i,state.shift,state.served+state.stats.expired);for(const p of state.players)if(p.order===i)p.stack=[];}}}\nif(state.attract)state.pressure=Math.min(38,state.pressure);if(state.pressure>=100)endGame(false);else if(state.shiftTime<=0){penalty(100,'The shift got away from us.');endGame(false);}input.action=false;input.discard=false;input.dash=false;input.bell=false;input.select=0;\n}\nfunction promptFor(action){if(lastInput==='gamepad'){const ps={action:'✕',discard:'○',dash:'□',bell:'△',pause:'OPTIONS',select:'L1 / R1'};const xb={action:'A',discard:'B',dash:'X',bell:'Y',pause:'MENU',select:'LB / RB'};return(glyphs==='ps'?ps:xb)[action];}return{action:'SPACE',discard:'Q',dash:'SHIFT',bell:'E',pause:'ESC',select:'TAB / 1–3'}[action];}\nfunction actionHint(){const p=localPlayer();if(\"'!p)return'\"'';const o=state.orders[p.order];if(p.stack.length===o.recipe.length)return 'DELIVER TO '+o.label+' HATCH';const it=state.items.filter(i=>Math.hypot(i.x-p.x,i.z-p.z)<tuning.catchRadius).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z))[0];return it?'CATCH '+INGREDIENTS[it.type].name.toUpperCase():'NEXT: '+INGREDIENTS[o.recipe[p.stack.length]].name.toUpperCase();}\nfunction updateHUD(){const show=screen==='playing'||screen==='pause'||screen==='dev'||screen==='result';\"'$('\"'hud').classList.toggle('hidden',\"'!show);$('\"'attract-label').classList.toggle('hidden',\"'!state.attract);if(!show)return;const p=localPlayer();$('\"'score').textContent=String(state.score).padStart(5,'0');\"'$('\"'shift-label').textContent='SHIFT '+(state.shift+1)+' / 3';\"'$('\"'quota').textContent=state.shiftServed+' / '+SHIFTS[state.shift].quota+' SERVED';\"'$('\"'clock').textContent=Math.max(0,Math.ceil(state.shiftTime))+'s';\"'$('\"'pressure-fill').style.width=Math.min(100,state.pressure)+'%';\"'$('\"'pressure-value').textContent=Math.floor(state.pressure)+'%';\"'$('\"'pressure').classList.toggle('danger',state.pressure>70);\"'$('\"'combo').textContent=state.combo>1?state.combo+'× HOT STREAK':'';\n\"'$('\"'tickets').innerHTML=state.orders.map((o,i)=>{const mine=p?.order===i;const progress=mine?p.stack.length:0;return\"'`<button class=\"ticket ${mine?'\"'selected':''}\\\" style=\\\"--ticket:\"'${o.color}\" data-order=\"${i}\"><div class=\"ticket-head\"><span>${i+1} · ${o.label}</span><span>${mine?'\"'YOUR TRAY':'ORDER '+(i+1)}</span></div><div class=\\\"recipe\\\">\"'${o.recipe.map((t,j)=>`<span class=\"ingredient ${progress>j?'\"'caught':''} \"'${mine&&progress===j?'\"'next':''}\\\" style=\\\"--food:\"'${INGREDIENTS[t].color}\"><i class=\"food food-${t}\"></i><span>${INGREDIENTS[t].name}</span>${progress>j?'\"'<b>✓</b>':''}</span>\"'`).join('\"'')}</div><div class=\\\"patience\\\"><i style=\\\"width:\"'${Math.max(0,o.patience/o.maxPatience*100)}%\"></i></div></button>`}).join('\"'');\n\"'$('\"'toast').textContent=state.toastTime>0?state.toast:'';\"'$('\"'toast').classList.toggle('visible',state.toastTime>0);\"'$('\"'context-hint').innerHTML=\"'`<kbd>${promptFor('\"'action')}</kbd> \"'${actionHint()}`;$('\"'bell-fill').style.width=state.bellCharge*100+'%';\"'$('\"'bell-label').textContent=state.freeze>0?'TIME OUT '+state.freeze.toFixed(1)+'s':state.bellCharge>=.98?'BELL READY':'BELL CHARGING';\"'$('\"'controls').innerHTML=\"'`<span><kbd>${lastInput==='\"'gamepad'?'L STICK':'WASD / ↑↓←→'}</kbd> MOVE</span><span><kbd>\"'${promptFor('\"'select')}</kbd> TICKET</span><span><kbd>\"'${promptFor('\"'dash')}</kbd> DASH</span><span><kbd>\"'${promptFor('\"'discard')}</kbd> TOSS</span><span><kbd>\"'${promptFor('\"'bell')}</kbd> BELL</span><span><kbd>\"'${promptFor('\"'pause')}</kbd> PAUSE</span>\"'`;\n$('\"'intermission').classList.toggle('hidden',state.mode\"'!=='\"'intermission');if(state.mode==='intermission')\"'$('\"'intermission').innerHTML=\"'`<small>BEAUTIFULLY DONE, CHEF.</small><h2>SHIFT CLEARED!</h2><p>${SHIFTS[state.shift+1].name} in ${Math.ceil(state.transition)}…</p>`;\n$('\"'touch-action').textContent=p&&p.stack.length===state.orders[p.order].recipe.length?'SERVE':'CATCH';}\nfunction setOverlay(){document.querySelectorAll('.panel').forEach(el=>el.classList.add('hidden'));\"'$('\"'shade').classList.toggle('hidden',screen==='playing');\"'$('\"'load').classList.add('hidden');if(screen==='title')\"'$('\"'title-panel').classList.remove('hidden');if(screen==='pause')\"'$('\"'pause-panel').classList.remove('hidden');if(screen==='settings'){\"'$('\"'settings-panel').classList.remove('hidden');syncSettings();}if(screen==='howto')\"'$('\"'howto-panel').classList.remove('hidden');if(screen==='about')\"'$('\"'about-panel').classList.remove('hidden');if(screen==='online')\"'$('\"'online-panel').classList.remove('hidden');if(screen==='dev'){\"'$('\"'dev-panel').classList.remove('hidden');renderDev();}if(screen==='result'){\"'$('\"'result-panel').classList.remove('hidden');\"'$('\"'result-eyebrow').textContent=state.mode==='victory'?'THE BLOCK IS FED.':'TAKE A BREATHER, CHEF.';\"'$('\"'result-title').textContent=state.mode==='victory'?'SERVICE WITH STYLE\"'!'\"':'A LITTLE TOO HOT.';\"'$('\"'result-copy').textContent=state.mode==='victory'?'Three shifts. Fifteen orders. One very happy neighborhood.':'Every great chef burns a bun. Your next shift is waiting.';\"'$('\"'result-score').textContent=state.score.toLocaleString();\"'$('\"'result-stats').textContent=state.served+' orders served  ·  '+state.bestCombo+' best streak  ·  '+state.stats.caught+' perfect catches';}\nmenuFocus=0;updateFocus();updateHUD();}\nfunction openPanel(name){previousScreen=screen;screen=name;paused=previousScreen==='playing'||paused;setOverlay();}\nfunction back(){if(network?.hubInfo?.active){screen='playing';paused=false;}else if(paused){screen='pause';}else screen='title';setOverlay();}\nfunction resume(){screen='playing';paused=false;setOverlay();audio?.resume();}\nfunction title(){if(network?.hubInfo?.active)return;network?.close();state.attract=false;screen='title';paused=false;lastActivity=performance.now();audio?.stop();setOverlay();}\nfunction pause(){if(state.attract){exitAttract();return;}if(network?.hubInfo?.active)return;if(screen==='playing'){paused=true;screen='pause';setOverlay();}else if(screen==='pause')resume();else if(['dev','settings','howto','about','online'].includes(screen))back();}\nfunction exitAttract(){if(\"'!state.attract)return;state.attract=false;state=newState();screen='\"'title';paused=false;lastActivity=performance.now();setOverlay();}\nfunction activity(type){if(state.attract){exitAttract();return true;}lastActivity=performance.now();if(type)lastInput=type;return false;}\nfunction menuButtons(){const panel=[...document.querySelectorAll('.panel')].find(p=>\"'!p.classList.contains('\"'hidden'));return panel?[...panel.querySelectorAll('button,input,textarea,select')].filter(e=>\"'!e.disabled&&e.offsetParent!==null):[];}\nfunction updateFocus(delta=0){const buttons=menuButtons();if(!buttons.length)return;menuFocus=(menuFocus+delta+buttons.length)%buttons.length;document.querySelectorAll('\"'.pad-focus').forEach(e=>e.classList.remove('pad-focus'));if(lastInput==='gamepad'||lastInput==='keyboard')buttons[menuFocus]?.classList.add('pad-focus');}\nfunction activateFocus(){const b=menuButtons()[menuFocus];if(b?.tagName==='BUTTON')b.click();else b?.focus();}\nfunction syncSettings(){\"'$('\"'music-volume').value=settings.music*100;\"'$('\"'sfx-volume').value=settings.sfx*100;\"'$('\"'glyphs').value=glyphs;\"'$('\"'assist').checked=settings.assist;\"'$('\"'music-output').textContent=Math.round(settings.music*100)+'%';\"'$('\"'sfx-output').textContent=Math.round(settings.sfx*100)+'%';}\nfunction renderDev(){const labels={beltSpeed:['Belt speed',.5,4,.05],chefSpeed:['Chef speed',2,10,.1],patience:['Ticket patience',20,150,1],pressureRate:['Pressure gain',0,3,.05],catchRadius:['Catch reach',1.5,4,.05],shiftSeconds:['Shift duration',45,240,1]};\"'$('\"'dev-sliders').innerHTML=Object.entries(labels).map(([k,[label,min,max,step]])=>\"'`<label class=\"slider-label\"><span>${label}</span><output id=\"out-${k}\">${tuning[k]}</output><input type=\"range\" data-tuning=\"${k}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[k]}\"></label>`).join('\"'');\"'$('\"'dev-invincible').checked=devInvincible;\"'$('\"'dev-auto').checked=devAuto;}\nfunction pollPad(){