5px auto;animation:spin 1s linear infinite}#menu-button{display:none;position:absolute;right:15px;top:15px;width:45px;height:45px;background:#244c46c9;color:var(--cream);border:1px solid #fff0bb7a;border-radius:50%;font-size:23px}#touch-action,#touch-bell{display:none;position:absolute;bottom:9%;right:5%;width:72px;height:72px;border:2px solid #ffe4a1a0;border-radius:50%;background:#f7cc7788;color:#1c3e31;font-size:14px;font-weight:900;touch-action:none}#touch-bell{right:15%;bottom:7%;width:49px;height:49px;font-size:11px;background:#79c9b898}.touch #touch-action,.touch #touch-bell,.touch #menu-button{display:block}.touch #controls{display:none}.touch #context-hint{bottom:3%;font-size:18px;padding:7px 14px}.touch #context-hint kbd{display:none}.touch #topbar .brand{display:none}.touch #tickets{left:6%;right:6%;top:9%}.touch #pressure,.touch #bell-meter{display:none}.touch #toast{font-size:13px;top:29%;max-width:82%}.touch #topbar{left:6%;right:75px}.touch .score-box strong{font-size:27px}.touch .shift-info{font-size:11px;gap:12px}.touch .shift-info #clock{padding-left:12px}.touch .panel{width:65vw;left:6%}.touch h1{font-size:65px}.touch .stamp{display:none}@keyframes spin{to{transform:rotate(360deg)}}@keyframes alarm{to{filter:brightness(1.5)}}@media(min-width:1800px){.panel{width:630px}.ticket-head{font-size:14px}.ticket-head span:last-child{font-size:11px}.ingredient{font-size:13px}.food{width:43px;height:20px}.recipe{margin:14px 0 9px;gap:12px}.ticket{padding:14px 20px}.brand-name{font-size:34px}#controls{font-size:14px}kbd{font-size:14px}.pressure-label,#bell-meter{font-size:13px}#pressure,#bell-meter{width:165px}#context-hint{font-size:30px}#toast{font-size:21px}}@media(max-width:900px){.panel{left:5%;width:48vw}.menu{gap:7px}.menu button{min-height:44px;padding:10px 15px}.tagline{font-size:15px;margin-bottom:17px}.eyebrow{font-size:10px;letter-spacing:.13em}h1{font-size:65px;margin:20px 0}.fine{font-size:10px;margin-top:15px}.stamp{width:80px;height:80px;font-size:9px}.stamp b{font-size:27px}#tickets{left:9%;right:9%;gap:8px;top:12%}.ticket{padding:6px 9px}.ticket-head{font-size:9px}.ticket-head span:last-child{font-size:7px}.ingredient{font-size:8px;min-width:23px}.food{width:27px;height:13px}.food-tomato:after{left:6px;top:-8px}.recipe{margin:6px 0 3px;gap:4px}.brand{min-width:130px;gap:9px}.brand-icon{display:none}.brand-name{font-size:20px}.shift-info{font-size:11px;gap:12px}.shift-info #clock{padding-left:12px}.score-box{font-size:10px;gap:8px}.score-box strong{font-size:30px}#pressure,#bell-meter{width:95px;top:35%}.pressure-label,#bell-meter{font-size:8px}#pressure p{display:none}#controls{gap:10px;font-size:8px}kbd{font-size:8px;padding:3px}#context-hint{font-size:18px;padding:7px 16px}#toast{font-size:13px}#combo{top:45%;font-size:19px}.howto-step{gap:12px;margin:12px 0}.howto-step p,.small-copy,.keys-copy{font-size:12px}.howto-step h3{font-size:20px}.slider-label,.select-label,.check-label{font-size:14px;margin:14px 0}.credits-panel{width:75vw}.info-grid{font-size:11px;grid-template-columns:100px 1fr}.feedback-list{font-size:11px}}\n@media(orientation:portrait){#shade{background:#173b37e6}.panel,.touch .panel{width:88vw;left:6%;max-height:90vh}.panel h1,.touch h1{font-size:85px}.panel h2{font-size:47px}.menu{max-width:100%}.tagline{font-size:18px}.stamp{display:none}.fine{font-size:12px}.touch #tickets{left:3%;right:3%;gap:6px;top:10%}.ticket-head span:last-child{display:none}.recipe{flex-wrap:wrap;gap:4px}.ingredient{font-size:8px}.touch #toast{top:31%;width:88%}.touch .shift-info{font-size:10px;gap:8px}.score-box{font-size:9px}.touch #touch-bell{right:25%}#context-hint{font-size:16px}#controls{flex-wrap:wrap;gap:6px;bottom:1%}#pressure,#bell-meter{display:none}.credits-panel{width:90vw}}\nEOF\ncat > Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/shell.html <<'\"'EOF'\n<\"'!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#244c46\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-goal\" content=\"Cooperate to serve 15 burgers across three shifts.\"><meta name=\"hub:session-howto\" content=\"Stick/WASD move; Cross/Space catch & serve; shoulders/Tab ticket; Square/Shift dash.\"><meta name=\"hub:session-minutes\" content=\"6\">\n<title>Short Order Fever — A little sizzle. A lot of heart.</title><style>/*STYLE*/</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/tsl\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\",\"rapier\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/+esm\"}}</script>\n</head><body>\n<canvas id=\"game\" aria-label=\"Short Order Fever kitchen\"></canvas><div id=\"shade\"></div>\n<div id=\"load\"><div class=\"eyebrow\">SHORT ORDER FEVER</div><h2>Warming up the griddle.</h2><span class=\"loader\"></span><p>Fresh ingredients. Hot orders. Your kitchen is almost ready.</p></div>\n<section id=\"title-panel\" class=\"panel hidden\"><div class=\"eyebrow\">A FRESH TAKE ON AN ARCADE CLASSIC</div><h1>SHORT<br>ORDER<em>FEVER.</em></h1><p class=\"tagline\">A little sizzle. A lot of heart.<br>Keep your cool. Feed the whole block.</p><nav class=\"menu\"><button class=\"primary\" data-action=\"start\">OPEN THE KITCHEN <span>→</span></button><button data-action=\"howto\">HOW TO COOK <span>↗</span></button><button data-action=\"online\">CO-OP KITCHEN <span>1–4</span></button><div class=\"menu-split\"><button data-action=\"settings\">SETTINGS</button><button data-action=\"about\">ABOUT / CREDITS</button></div></nav><div class=\"fine\">STICK / WASD TO MOVE · ✕ / SPACE TO CATCH & SERVE<br>AN ORIGINAL TRIBUTE TO PRESSURE COOKER (1983)</div></section>\n<div class=\"stamp\" id=\"stamp\">FRESH OFF<br><b>THE GRILL</b>EST. 1983</div>\n<section id=\"howto-panel\" class=\"panel hidden\"><div class=\"eyebrow\">THE SHORT ORDER HANDBOOK</div><h2>ALL HEART.<br>NO COLD BUNS.</h2><div class=\"howto-step\"><b>1</b><div><h3>READ YOUR TICKET</h3><p>Your highlighted ticket is your tray. Catch its ingredients in order, from left to right. The next layer has a dashed border.</p></div></div><div class=\"howto-step\"><b>2</b><div><h3>CATCH THE GOOD STUFF</h3><p>Move up to the conveyor. Catch with Space / ✕ when the right ingredient is beside you. A wrong catch adds pressure.</p></div></div><div class=\"howto-step\"><b>3</b><div><h3>SEND IT HOME</h3><p>Carry a full stack down to its matching color hatch. Space / ✕ serves it. Fifteen burgers across three shifts wins the day.</p></div></div><div class=\"keys-copy\"><b>WASD / arrows</b> move · <b>Space</b> catch & serve · <b>Tab / 1–3</b> ticket<br><b>Shift</b> dash · <b>Q</b> toss tray · <b>E</b> time-out bell · <b>Esc</b> pause<br><b>Pad:</b> left stick · ✕ catch · □ dash · ○ toss · △ bell · L1/R1 ticket<br><b>Mouse:</b> click the floor to move, ingredients to catch, hatches to deliver.<br><b>Touch:</b> drag anywhere on the left to move. Correct catches and deliveries are assisted. Tap a ticket to switch.</div><p class=\"small-copy\">Serve to cool the pressure and recharge the bell. Missed ingredients, expired tickets and wrong catches heat things up. Later shifts add more layers and a steaming floor vent. Don’t let pressure hit 100% or the shift clock run out.</p><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<section id=\"pause-panel\" class=\"panel hidden\"><div class=\"eyebrow\">HOLD THE PICKLES</div><h2>TAKE FIVE,<br>CHEF.</h2><nav class=\"menu\"><button class=\"primary\" data-action=\"resume\">BACK TO THE GRIDDLE <span>→</span></button><button data-action=\"howto\">HOW TO COOK</button><button data-action=\"settings\">SETTINGS</button><button data-action=\"dev\">DEVELOPER KITCHEN</button><button data-action=\"restart\">RESTART SHIFT ONE</button><button data-action=\"title\">CLOSE KITCHEN</button></nav></section>\n<section id=\"settings-panel\" class=\"panel hidden\"><div class=\"eyebrow\">YOUR HOUSE SPECIAL</div><h2>SET THE MOOD.</h2><label class=\"slider-label\"><span>Music</span><output id=\"music-output\">10%</output><input aria-label=\"Music volume\" id=\"music-volume\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"></label><label class=\"slider-label\"><span>Sound effects & voices</span><output id=\"sfx-output\">65%</output><input aria-label=\"Sound effect volume\" id=\"sfx-volume\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"></label><label class=\"select-label\">Controller prompts<select id=\"glyphs\"><option value=\"ps\">PlayStation ✕ ○ □ △</option><option value=\"xbox\">Xbox A B X Y</option></select></label><label class=\"check-label\"><span>Kitchen assist<br><small>Auto-catch the correct layer & auto-serve</small></span><input id=\"assist\" type=\"checkbox\"></label><p class=\"small-copy\">Prompts follow the input you use. Touch always includes kitchen assist. Audio is made entirely from code.</p><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<section id=\"dev-panel\" class=\"panel hidden\"><div class=\"eyebrow\">THE TEST KITCHEN</div><h2>SEASON TO TASTE.</h2><div id=\"dev-sliders\"></div><label class=\"check-label\">No pressure damage<input id=\"dev-invincible\" type=\"checkbox\"></label><label class=\"check-label\">Autochef playthrough<input id=\"dev-auto\" type=\"checkbox\"></label><div class=\"network-actions\"><button class=\"small-button\" data-action=\"dev-fill\">FILL TRAY</button><button class=\"small-button\" data-action=\"dev-clear\">COOL KITCHEN</button><button class=\"small-button\" data-action=\"dev-next\">NEXT SHIFT</button><button class=\"small-button\" data-action=\"dev-reset\">RESET DEFAULTS</button></div><p class=\"small-copy\">Sliders update the live simulation. Developer tools affect this run only.</p><button class=\"primary back\" data-action=\"resume\">BACK TO THE GRIDDLE →</button></section>\n<section id=\"online-panel\" class=\"panel hidden\"><div class=\"eyebrow\">MANY HANDS. HOT BURGERS.</div><h2>CO-OP KITCHEN.</h2><p class=\"small-copy\">Share one kitchen with up to four chefs. Every chef has a tray; tickets and pressure are shared. AI Hub connects everyone automatically.</p><h3>SAME DEVICE / BROWSER</h3><p class=\"small-copy\">Open this game in two tabs from the same address. One chef opens a kitchen; the others join.</p><div class=\"network-actions\"><button class=\"small-button primary\" data-action=\"host-local\">OPEN LOCAL KITCHEN</button><button class=\"small-button\" data-action=\"join-local\">JOIN LOCAL KITCHEN</button></div><h3>FRIEND ON ANOTHER DEVICE</h3><p class=\"small-copy\">Host: make an invite and send it to your friend. Friend: paste it below, choose Answer invite, and send the answer back. Host: paste that answer and connect. Direct connection availability depends on your network.</p><textarea id=\"network-code\" class=\"network-code\" aria-label=\"Connection code\" placeholder=\"Paste your invite or answer code here…\" spellcheck=\"false\"></textarea><div class=\"network-actions\"><button class=\"small-button\" data-action=\"invite\">MAKE INVITE</button><button class=\"small-button\" data-action=\"accept-invite\">ANSWER INVITE</button><button class=\"small-button\" data-action=\"accept-answer\">CONNECT ANSWER</button><button class=\"small-button\" data-action=\"copy-code\">COPY CODE</button></div><p id=\"network-status\" class=\"network-notice\">No kitchen connected. Solo play is always available.</p><p id=\"peer-list\"></p><div class=\"network-actions\"><button class=\"primary small-button\" data-action=\"coop-start\">START / RESTART SERVICE</button><button class=\"secondary small-button\" data-action=\"back\">← BACK</button></div></section>\n<section id=\"result-panel\" class=\"panel hidden\"><div id=\"result-eyebrow\" class=\"eyebrow\"></div><h2 id=\"result-title\"></h2><p id=\"result-copy\"></p><div class=\"result-label\">TOTAL TIPS</div><div id=\"result-score\" class=\"result-score\"></div><p id=\"result-stats\"></p><nav class=\"menu\"><button class=\"primary\" data-action=\"restart\">ANOTHER SHIFT? <span>→</span></button><button data-action=\"title\">BACK TO THE DINER</button></nav></section>\n<section id=\"about-panel\" class=\"panel credits-panel hidden\"><div class=\"eyebrow\">FROM THE TEST KITCHEN</div><h2>ABOUT & CREDITS.</h2><p>An original, affectionate arcade cooking game inspired by the ingredient conveyor, layered orders and cheerful pressure of <b>Pressure Cooker (1983)</b>. Procedural art, animation, music, sound and gibberish voices. Built for a controller on the couch.</p><h3>SOURCE INFORMATION</h3><dl id=\"source-info\" class=\"info-grid\"></dl><h3>TESTING FEEDBACK</h3><ol id=\"testing-feedback\" class=\"feedback-list\"></ol><h3>ENGINE FEEDBACK</h3><ol id=\"engine-feedback\" class=\"feedback-list\"></ol><h3>PROMPT FEEDBACK</h3><ol id=\"prompt-feedback\" class=\"feedback-list\"></ol><button class=\"secondary back\" data-action=\"back\">← BACK</button></section>\n<div id=\"hud\" class=\"hidden\"><div id=\"topbar\"><div class=\"brand\"><span class=\"brand-icon\">♨</span><div class=\"brand-name\">SHORT ORDER<br><span>FEVER.</span></div></div><div class=\"shift-info\"><span id=\"shift-label\"></span><span id=\"quota\"></span><span id=\"clock\"></span></div><div class=\"score-box\">TIPS <strong id=\"score\">00000</strong></div></div><div id=\"tickets\"></div><div id=\"pressure\"><div class=\"pressure-label\">PRESSURE <span id=\"pressure-value\">8%</span></div><div class=\"pressure-track\"><div id=\"pressure-fill\"></div></div><p>KEEP YOUR COOL, CHEF.</p></div><div id=\"combo\"></div><div id=\"bell-meter\"><span id=\"bell-label\">BELL READY</span><div><i id=\"bell-fill\"></i></div></div><div id=\"toast\"></div><div id=\"context-hint\"></div><div id=\"controls\"></div><div id=\"intermission\" class=\"hidden\"></div></div>\n<div id=\"attract-label\" class=\"hidden\"><b>THE KITCHEN NEVER SLEEPS</b><p>ATTRACT DEMO · PRESS ANY BUTTON TO PLAY</p></div><button id=\"menu-button\" data-action=\"pause\" aria-label=\"Pause\">☰</button><button id=\"touch-action\" aria-label=\"Catch or serve\">CATCH</button><button id=\"touch-bell\" aria-label=\"Ring time out bell\">BELL</button><div id=\"engine-label\"></div>\n<script type=\"module\">/*MODULES*/</script></body></html>\nEOF\ncat > Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/build.py <<'\"'EOF'\nfrom pathlib import Path\nimport json\np=Path(__file__).resolve().parent\nmeta=json.loads((p/'title.json').read_text())\nhtml=(p/'shell.html').read_text().replace('<\"'!--HUB_CLIENT-->'\"','<script>'+(p/'session.js').read_text()+'</script>')\nhtml=html.replace('/*STYLE*/',(p/'style.css').read_text())\nmodules=[]\nfor name in ['scene.js','audio.js','network.js','game.js']:\n    code=(p/name).read_text().replace('export async function ','async function ').replace('export function ','function ').replace('export class ','class ')\n    modules.append(code)\ninterview=json.loads((p.parent/'exit-interview.json').read_text()) if (p.parent/'exit-interview.json').exists() else {'sourceInformation':{},'testingFeedback':[],'engineFeedback':[],'promptFeedback':[]}\ncredits=\\\"const CREDITS=\\\"+json.dumps(interview)+\\\";document.getElementById('source-info').innerHTML=Object.entries(CREDITS.sourceInformation).map(([k,v])=>'<dt>'+k[0].toUpperCase()+k.slice(1)+'</dt><dd>'+v+'</dd>').join('');for(const [key,id] of [['testingFeedback','testing-feedback'],['engineFeedback','engine-feedback'],['promptFeedback','prompt-feedback']])document.getElementById(id).innerHTML=CREDITS[key].map(v=>'<li>'+v+'</li>').join('');\\\"\nhtml=html.replace('/*MODULES*/','\\\\n'.join(modules)+'\\\\n'+credits)\n(p.parent/(meta['slug']+'.html')).write_text(html)\nprint(meta['slug']+'.html')\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/network.js\"","aggregated_output":"// AI Hub shared-world transport and serverless standalone co-op.\nexport class KitchenNetwork {\n  constructor(callbacks={}) {\n    this.cb=callbacks; this.mode='solo'; this.me=0; this.host=0; this.server=false;\n    this.players=[this._player(0)]; this.room=''; this.token=this._token();\n    this.peers=new Map(); this.unsub=[]; this.timers=new Set(); this.lastWorld=null;\n    this.lastWorldAt=-Infinity; this.lastInputAt=-Infinity; this.pendingInput=null;\n    this.finished=false; this.ended=false; this.readySent=false; this.started=false;\n    this.sent=0; this.received=0; this.maxBytes=0; this.hubInfo=null;\n    this.channel=null; this.pc=null; this.data=null; this.pendingPCs=new Set();\n    this._unload=()=>this.close(); addEventListener('pagehide',this._unload);\n  }\n  _token(){return globalThis.crypto?.randomUUID?.()||String(Date.now())+'-'+String(Math.random()).slice(2);}\n  _player(id){return {id,name:id===0?'Head chef':'Chef '+(id+1),color:['#ef5a48','#45a9b4','#7bb66a','#f1c14c'][id%4]};}\n  _emit(name,...args){try{this.cb[name]?.(...args);}catch(e){console.error('Kitchen network callback',name,e);}}\n  _status(text){this._emit('onStatus',text);}\n  _roster(){this._emit('onPeers',this.names());}\n  _interval(fn,ms){const id=setInterval(fn,ms);this.timers.add(id);return id;}\n  _start(){if(this.started||this.ended)return;this.started=true;this._emit('onStart');}\n  async initHub(){\n    if(!globalThis.AIHub?.active)return {active:false,players:this.names(),isHost:true,me:0,server:false};\n    this.mode='hub';\n    const hub=globalThis.AIHub;\n    this.unsub.push(hub.on('message',(data,from)=>this._receive(data,from,'hub')));\n    this.unsub.push(hub.on('start',()=>{\n      const timer=this._interval(()=>{if(hub.time()>=0){clearInterval(timer);this.timers.delete(timer);this._start();}},16);\n    }));\n    this.unsub.push(hub.on('time-up',()=>{if(this.isAuthority())this.finish(this.lastWorld||{score:0,served:0,mode:'time-up'});}));\n    this.unsub.push(hub.on('end',data=>{\n      this.ended=true;this.finished=true;this._emit('onEnd',data);this._clearTimers();\n    }));\n    this.unsub.push(hub.on('leave',data=>{\n      this.players=this.players.filter(p=>p.id!==data.id);this._roster();\n    }));\n    const info=await hub.connect({mode:'shared-world',seats:[1,4]});\n    if(!info){this.mode='solo';this.unsub.forEach(fn=>typeof fn==='function'&&fn());this.unsub=[];return {active:false,players:this.names(),isHost:true,me:0,server:false};}\n    this.hubInfo=info;this.me=info.me;this.host=info.host;this.server=!!info.server;\n    this.players=info.players.map(p=>({id:p.id,name:String(p.name),color:p.color}));\n    this._roster();this._status('AI Hub kitchen connected');\n    return {...info,active:true};\n  }\n  ready(){if(this.mode==='hub'&&!this.readySent){this.readySent=true;globalThis.AIHub.ready();}}\n  isAuthority(){return this.mode!=='hub'&&this.mode!=='local-guest'&&this.mode!=='rtc-guest'||this.mode==='hub'&&!!this.hubInfo?.isHost;}\n  active(){return this.mode!=='solo';}\n  localId(){return this.me;}\n  names(){return this.players.map(p=>({...p}));}\n  _input(input){\n    const num=x=>Number.isFinite(Number(x))?Math.max(-1,Math.min(1,Number(x))):0;\n    const clean={x:num(input?.x),z:num(input?.z),action:!!input?.action,discard:!!input?.discard,dash:!!input?.dash,bell:!!input?.bell};\n    if(Number.isFinite(input?.select))clean.select=Math.max(0,Math.min(2,Math.floor(input.select)));\n    if(input?.target&&Number.isFinite(input.target.x)&&Number.isFinite(input.target.z))clean.target={x:Math.max(-8,Math.min(8,input.target.x)),z:Math.max(.65,Math.min(5.25,input.target.z))};\n    return clean;\n  }\n  sendInput(input){\n    if(this.ended||this.finished||this.server)return;\n    const clean=this._input(input);\n    if(this.isAuthority()){this._emit('onInput',clean,this.me);return;}\n    if(this.pendingInput)for(const key of ['action','discard','dash','bell'])clean[key]||=this.pendingInput[key];\n    this.pendingInput=clean;\n    if(performance.now()-this.lastInputAt<100){\n      if(!this.inputTimer){this.inputTimer=setTimeout(()=>{this.inputTimer=null;this._flushInput();},100-(performance.now()-this.lastInputAt));}\n      return;\n    }\n    this._flushInput();\n  }\n  _flushInput(){\n    if(!this.pendingInput||this.ended||this.finished)return;\n    const message={kind:'input',input:this.pendingInput};this.pendingInput=null;this.lastInputAt=performance.now();\n    this._send(message,this.host);\n  }\n  _snapshot(state){\n    let data;\n    try{data=JSON.parse(JSON.stringify(state));}catch{this._status('A kitchen snapshot could not be sent.');return null;}\n    if(data.effects)data.effects=[];\n    let bytes=new TextEncoder().encode(JSON.stringify({kind:'world',state:data})).length;\n    if(bytes>15500&&Array.isArray(data.items))data.items=data.items.slice(-48);\n    bytes=new TextEncoder().encode(JSON.stringify({kind:'world',state:data})).length;\n    if(bytes>15500){this._status('Kitchen snapshot is too large.');return null;}\n    return data;\n  }\n  sendWorld(state){\n    this.lastWorld=state;\n    if(!this.active()||!this.isAuthority()||this.ended||this.finished)return;\n    if(performance.now()-this.lastWorldAt<100)return;\n    const snapshot=this._snapshot(state);if(!snapshot)return;\n    this.lastWorldAt=performance.now();this._send({kind:'world',state:snapshot});\n  }\n  report(state){this.lastWorld=state;}\n  finish(state={}){\n    this.lastWorld=state;\n    if(this.finished||this.ended||!this.isAuthority())return;\n    this.finished=true;\n    if(this.mode==='hub'){\n      const ids=this.players.map(p=>p.id);const scores={};const stats={};\n      const score=Number.isFinite(state.score)?Math.round(state.score):0;\n      for(const id of ids){scores[id]=score;stats[id]={'Burgers served':Number(state.served)||0,'Team score':score};}\n      globalThis.AIHub.finish({standings:[ids],scores,won:state.mode==='victory',stats});\n    }else if(this.active())this._send({kind:'finished',state:this._snapshot(state)});\n  }\n  _send(data,to){\n    if(this.ended)return false;\n    const text=JSON.stringify(data),bytes=new TextEncoder().encode(text).length;\n    if(bytes>16000)return false;\n    this.maxBytes=Math.max(this.maxBytes,bytes);this.sent++;\n    if(this.mode==='hub')return globalThis.AIHub.send(data,to==null?{reliable:true}:{to,reliable:true});\n    if(this.mode==='local-host'||this.mode==='local-guest'){\n      this.channel?.postMessage({game:'short-order-fever-v1',room:this.room,from:this.token,player:this.me,to,kind:'packet',data});\n    }\n    if(this.mode==='rtc-guest'){if(this.data?.readyState==='open')this.data.send(text);}\n    else for(const [id,peer]of this.peers){if(peer.channel?.readyState==='open'&&(to==null||to===id))peer.channel.send(text);}\n    return true;\n  }\n  resetRound(){\n    if(this.mode==='hub'||!this.isAuthority())return false;\n    this.finished=false;this.ended=false;this.lastWorld=null;this.lastWorldAt=-Infinity;this.pendingInput=null;\n    this._send({kind:'reset'});return true;\n  }\n  _receive(data,from,transport){\n    if(this.ended||!data||typeof data!=='object')return;\n    this.received++;\n    if(data.kind==='input'&&this.isAuthority()&&this.players.some(p=>p.id===from))this._emit('onInput',this._input(data.input),from);\n    if(data.kind==='world'&&!this.isAuthority()&&from===this.host&&data.state){this.lastWorld=data.state;this._emit('onWorld',data.state);}\n    if(data.kind==='roster'&&transport!=='hub'&&!this.isAuthority()&&Array.isArray(data.players)){\n      this.players=data.players.slice(0,4).map(p=>({id:Number(p.id),name:String(p.name),color:String(p.color)}));this._roster();\n    }\n    if(data.kind==='welcome'&&transport==='rtc'){\n      this.me=data.id;this.host=0;this.players=data.players;this._roster();this._status('Connected — kitchen is live');this._start();\n    }\n    if(data.kind==='reset'&&transport!=='hub'&&!this.isAuthority()&&from===this.host){\n      this.finished=false;this.ended=false;this.lastWorld=null;this.pendingInput=null;this.started=false;this._start();return;\n    }\n    if(data.kind==='finished'&&!this.isAuthority()){\n      if(data.state){this.lastWorld=data.state;this._emit('onWorld',data.state);}this.finished=true;this._emit('onEnd',{reason:'finished',standalone:true});\n    }\n    if(data.kind==='closed'&&!this.isAuthority()){\n      this.ended=true;this._status('The head chef closed this kitchen.');this._emit('onEnd',{reason:'host-left',standalone:true});\n    }\n  }\n  _openBroadcast(){\n    if(!globalThis.BroadcastChannel)throw new Error('Local co-op needs BroadcastChannel support.');\n    const path=location.pathname.replace(/\\/[^/]*$/,'/');\n    this.channel=new BroadcastChannel('short-order-fever-v1:'+path);\n    this.channel.onmessage=event=>this._broadcastMessage(event.data);\n  }\n  hostLocal(){\n    if(this.mode==='hub')return;\n    this.close(false);this.mode='local-host';this.me=0;this.host=0;this.room=this._token();this.players=[this._player(0)];\n    this.ended=false;this.finished=false;this.started=false;this._openBroadcast();this._roster();this._status('Kitchen open. Join from another tab, or send an online invite.');this._start();\n    this._interval(()=>{\n      this.channel?.postMessage({game:'short-order-fever-v1',kind:'beacon',room:this.room,from:this.token});\n      const expired=[];for(const[id,peer]of this.peers)if(peer.kind==='local'&&Date.now()-peer.seen>8000)expired.push(id);\n      for(const id of expired)this._removePeer(id);\n    },1500);\n    return {room:this.room,players:this.names()};\n  }\n  joinLocal(){\n    if(this.mode==='hub')return;\n    this.close(false);this.mode='local-guest';this.me=-1;this.host=0;this.room='';this.players=[];this.ended=false;this.finished=false;this.started=false;\n    this._openBroadcast();this._status('Looking for a kitchen in another tab…');\n    const discover=()=>{\n      if(!this.room)this.channel?.postMessage({game:'short-order-fever-v1',kind:'discover',from:this.token});\n      else this.channel?.postMessage({game:'short-order-fever-v1',kind:'ping',room:this.room,from:this.token,player:this.me});\n    };discover();this._interval(discover,1500);\n  }\n  _broadcastMessage(m){\n    if(!m||m.game!=='short-order-fever-v1'||m.from===this.token||this.ended)return;\n    if(this.mode==='local-host'&&m.kind==='discover'){\n      let peer=[...this.peers.values()].find(p=>p.token===m.from);\n      if(!peer){const id=[1,2,3].find(n=>!this.peers.has(n));if(id==null){this.channel.postMessage({game:m.game,kind:'full',target:m.from,from:this.token});return;}\n        peer={id,token:m.from,kind:'local',seen:Date.now()};this.peers.set(id,peer);this.players.push(this._player(id));this._roster();}\n      this.channel.postMessage({game:m.game,kind:'welcome',target:m.from,from:this.token,room:this.room,id:peer.id,players:this.names()});\n      this._send({kind:'roster',players:this.names()});\n      if(this.lastWorld)this._send({kind:'world',state:this._snapshot(this.lastWorld)},peer.id);\n      this._status(this.players.length+' chefs in the kitchen');return;\n    }\n    if(this.mode==='local-guest'&&m.kind==='welcome'&&m.target===this.token&&!this.room){\n      this.room=m.room;this.me=m.id;this.players=m.players;this._roster();this._status('Connected — kitchen is live');this._start();return;\n    }\n    if(m.kind==='full'&&m.target===this.token&&!this.room){this._status('That kitchen already has four chefs.');return;}\n    if(m.room!==this.room)return;\n    if(this.mode==='local-host'&&m.kind==='ping'){\n      const peer=this.peers.get(m.player);if(peer?.token===m.from)peer.seen=Date.now();return;\n    }\n    if(this.mode==='local-host'&&m.kind==='bye'){\n      const peer=this.peers.get(m.player);if(peer?.token===m.from)this._removePeer(m.player);return;\n    }\n    if(m.kind==='packet'&&(m.to==null||m.to===this.me)){\n      if(this.mode==='local-host'){\n        const peer=this.peers.get(m.player);if(!peer||peer.token!==m.from)return;peer.seen=Date.now();\n      }\n      this._receive(m.data,m.player,'local');\n    }\n  }\n  _removePeer(id){\n    const peer=this.peers.get(id);if(!peer)return;this.peers.delete(id);peer.pc?.close();\n    this.players=this.players.filter(p=>p.id!==id);this._roster();this._send({kind:'roster',players:this.names()});this._status(this.players.length+' chefs in the kitchen');\n  }\n  _newPC(){\n    if(!globalThis.RTCPeerConnection)throw new Error('This browser cannot make an online kitchen.');\n    const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});\n    this.pendingPCs.add(pc);return pc;\n  }\n  async _gather(pc){\n    if(pc.iceGatheringState==='complete')return;\n    await new Promise(resolve=>{\n      const done=()=>{clearTimeout(timeout);pc.removeEventListener('icegatheringstatechange',change);resolve();};\n      const change=()=>{if(pc.iceGatheringState==='complete')done();};\n      const timeout=setTimeout(done,7000);pc.addEventListener('icegatheringstatechange',change);\n    });\n  }\n  _encode(data){return btoa(unescape(encodeURIComponent(JSON.stringify(data))));}\n  _decode(text,type){\n    if(typeof text!=='string'||text.length>200000)throw new Error('Paste the complete kitchen code.');\n    let data;try{data=JSON.parse(decodeURIComponent(escape(atob(text.trim()))));}catch{throw new Error('That kitchen code is not valid.');}\n    if(data.game!=='short-order-fever-v1'||data.type!==type||!data.description?.sdp)throw new Error('That is not a '+type+' code for Short Order Fever.');\n    return data;\n  }\n  async createInvite(){\n    if(this.mode==='hub')throw new Error('AI Hub handles all session invitations.');\n    if(this.mode!=='local-host')this.hostLocal();\n    if(this.players.length>=4)throw new Error('The kitchen already has four chefs.');\n    if(this.offerPC){this.offerPC.close();this.pendingPCs.delete(this.offerPC);}\n    const pc=this._newPC();this.offerPC=pc;const channel=pc.createDataChannel('kitchen',{ordered:true});\n    channel.onopen=()=>{\n      const id=[1,2,3].find(n=>!this.peers.has(n));if(id==null){channel.close();return;}\n      if(this.offerPC===pc)this.offerPC=null;\n      const peer={id,kind:'rtc',pc,channel};this.peers.set(id,peer);this.players.push(this._player(id));this._roster();\n      channel.send(JSON.stringify({kind:'welcome',id,players:this.names()}));\n      this._send({kind:'roster',players:this.names()});\n      if(this.lastWorld)channel.send(JSON.stringify({kind:'world',state:this._snapshot(this.lastWorld)}));\n      channel.onmessage=e=>{try{this._receive(JSON.parse(e.data),id,'rtc');}catch{}};\n      channel.onclose=()=>this._removePeer(id);this._status(this.players.length+' chefs in the kitchen');\n    };\n    pc.onconnectionstatechange=()=>{if(pc.connectionState==='failed')this._status('Connection failed. Create a fresh invite and try again.');};\n    await pc.setLocalDescription(await pc.createOffer());await this._gather(pc);\n    return this._encode({game:'short-order-fever-v1',type:'offer',room:this.room,description:pc.localDescription});\n  }\n  async acceptInvite(text){\n    if(this.mode==='hub')throw new Error('AI Hub handles all session invitations.');\n    const offer=this._decode(text,'offer');\n    this.close(false);this.mode='rtc-guest';this.me=-1;this.host=0;this.players=[];this.room=offer.room;\n    this.ended=false;this.finished=false;this.started=false;const pc=this._newPC();this.pc=pc;\n    pc.ondatachannel=e=>{\n      this.data=e.channel;this.data.onmessage=ev=>{try{this._receive(JSON.parse(ev.data),0,'rtc');}catch{}};\n      this.data.onclose=()=>{if(!this.ended){this.ended=true;this._status('Connection closed.');this._emit('onEnd',{reason:'host-left',standalone:true});}};\n    };\n    pc.onconnectionstatechange=()=>{if(pc.connectionState==='failed')this._status('Connection failed. Ask for a fresh invitation.');};\n    await pc.setRemoteDescription(offer.description);await pc.setLocalDescription(await pc.createAnswer());await this._gather(pc);\n    this._status('Send this answer code back to the head chef.');\n    return this._encode({game:'short-order-fever-v1',type:'answer',room:this.room,description:pc.localDescription});\n  }\n  async acceptAnswer(text){\n    if(this.mode==='hub')throw new Error('AI Hub handles all session invitations.');\n    const answer=this._decode(text,'answer');\n    if(!this.offerPC||answer.room!==this.room)throw new Error('Create an invite in this kitchen first.');\n    await this.offerPC.setRemoteDescription(answer.description);this._status('Connecting chefs…');\n  }\n  _clearTimers(){for(const timer of this.timers)clearInterval(timer);this.timers.clear();clearTimeout(this.inputTimer);this.inputTimer=null;}\n  close(reset=true){\n    if(this.mode==='hub')return;\n","exit_code":0,"status":"completed"}}
