{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/game.js')\ns=p.read_text().replace(\\\"if(\"'!pad){padPrevious=[];return;}\",\"if(!pad){if(lastInput==='\"'gamepad'){input.x=0;input.z=0;input.action=false;input.dash=false;input.bell=false;input.discard=false;}padPrevious=[];return;}\\\")\n# Broadcast pause state from active host menu, and retain guest local menu while receiving snapshots.\ns=s.replace(\\\"network.isAuthority()&&(screen==='playing'||screen==='result')\\\", \\\"network.isAuthority()&&(['playing','pause','settings','howto','dev','result'].includes(screen))\\\")\ns=s.replace(\\\"\"'$('\"'toast').textContent=state.toastTime>0?state.toast:'';\\\", \\\"\"'$('\"'toast').textContent=state.hostPaused&&\"'!network.isAuthority()?'\"'HEAD CHEF PAUSED THE KITCHEN':state.toastTime>0?state.toast:'';\\\")\ns=s.replace(\\\"\"'$('\"'toast').classList.toggle('visible',state.toastTime>0);\\\", \\\"\"'$('\"'toast').classList.toggle('visible',state.toastTime>0||(state.hostPaused&&\"'!network.isAuthority()));\")\np.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
