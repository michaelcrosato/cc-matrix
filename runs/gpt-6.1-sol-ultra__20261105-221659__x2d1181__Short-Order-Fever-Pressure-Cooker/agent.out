ivity('touch');input.bell=true;});}\nasync function runInvite(kind){try{\"'$('\"'network-status').textContent='Preparing connection code…';const text=\"'$('\"'network-code').value.trim();const result=kind==='create'?await network.createInvite():kind==='join'?await network.acceptInvite(text):await network.acceptAnswer(text);if(result)\"'$('\"'network-code').value=result;\"'$('\"'network-status').textContent=kind==='create'?'Send this invite to your friend. Then paste their answer and choose Connect answer.':kind==='join'?'Send this answer back to the host. Leave this screen open.':'Connecting kitchen…';}catch(e){\"'$('\"'network-status').textContent='Connection: '+e.message;}}\nasync function init(){try{audio=new KitchenAudio();audio.setVolumes(settings.music,settings.sfx);network=new KitchenNetwork({onStatus:s=>{\"'$('\"'network-status').textContent=s;},onWorld:s=>{if(network.isAuthority())return;state=s;state.attract=false;if(screen\"'!=='\"'playing'&&screen\"'!=='\"'result'){screen='playing';setOverlay();}if(s.mode==='victory'||s.mode==='defeat'){screen='result';setOverlay();}},onInput:(id,cmd)=>remoteInputs.set(id,cmd),onStart:()=>{if(network.isAuthority())startGame();else{screen='playing';setOverlay();}},onEnd:()=>{muted=true;paused=true;audio.stop();},onPeers:peers=>{if(network.isAuthority()&&screen==='playing'){for(const peer of peers)if(\"'!state.players.some(p=>p.id===peer.id)){state.players.push(makePlayer(peer.id,peer.name,peer.color));}}$('\"'peer-list').textContent=peers.map(p=>p.name).join(' · ');}});\nconst tasks=await Promise.all([createScene(\"'$('\"'game')),import('rapier').then(async R=>{rapier=R.default||R;await rapier.init();physics=new rapier.World({x:0,y:-9.81,z:0});const floor=physics.createRigidBody(rapier.RigidBodyDesc.fixed().setTranslation(0,-.25,2));physics.createCollider(rapier.ColliderDesc.cuboid(10,.25,5),floor);}),network.initHub()]);scene=tasks[0];resetBodies();bindUI();const info=tasks[2];if(info?.active){screen='playing';paused=true;\"'$('\"'load').classList.add('hidden');setOverlay();}else setOverlay();window.__gameReady=true;\"'$('\"'engine-label').textContent=scene.rendererName+' · THREE r180';let last=performance.now();function frame(now){const dt=Math.min(.05,(now-last)/1000);last=now;renderTime+=dt;pollPad();gatherInput();if(network.hubInfo?.active&&network.started&&AIHub.time()>=0&&paused){paused=false;}if(screen==='title'&&now-lastActivity>=10000)startGame(true);\nif(screen==='playing'&&\"'!paused){if(network.isAuthority()){simulate(dt);}else{network.sendInput({...input});input.action=false;input.discard=false;input.dash=false;input.bell=false;input.select=0;}}\nnetworkTimer+=dt;if(networkTimer>.105){networkTimer=0;if(network.active()&&network.isAuthority()&&(screen==='\"'playing'||screen==='result'))network.sendWorld(safeState());network.report(state);}scene.update({...state,time:renderTime,paused:paused||screen\"'!=='\"'playing',menu:screen==='title'},dt);audio.tick({...state,paused:paused||screen\"'!=='\"'playing',menu:screen==='title'},dt);if(Math.floor(renderTime*12)\"'!==Math.floor((renderTime-dt)*12))updateHUD();requestAnimationFrame(frame);}requestAnimationFrame(frame);\nwindow.__game={getState:()=>safeState(),getScreen:()=>screen,getTuning:()=>({...tuning}),getAudio:()=>audio.getDiagnostics(),getNetwork:()=>network.getDiagnostics?.(),start:()=>startGame(),step:dt=>simulate(dt),setState:patch=>Object.assign(state,patch),setPlayer:patch=>Object.assign(localPlayer(),patch),act:()=>catchOrServe(localPlayer()),discard:()=>discard(localPlayer()),bell:ringBell,select:n=>{const p=localPlayer();if(!p.stack.length)p.order=n;},pause,showDev:()=>{screen='\"'dev';paused=true;setOverlay();},resume,auto:v=>{devAuto=v;},setTuning:(k,v)=>{tuning[k]=v;},finish:won=>endGame(won),audioTest:()=>typeof testKitchenAudio==='function'?testKitchenAudio():null,scene:()=>({renderer:scene.rendererName,objects:scene.renderer.info.render.calls}),network};\n}catch(e){console.error(e);\"'$('\"'load').innerHT