th SPACE.\", \"toastTime\": 4.350000000000002, \"ventPhase\": 0.65}, \"audio\": {\"supported\": true, \"unlocked\": true, \"state\": \"running\", \"stopped\": false, \"musicVolume\": 0.1, \"sfxVolume\": 0.65, \"notes\": 51, \"effects\": 1, \"voices\": 1, \"activeSources\": 4, \"rms\": 0}, \"scene\": {\"renderer\": \"WebGL 2 fallback\", \"objects\": 70}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,200p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/audio.js && sed -n '1,140p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_hub.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,200p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/audio.js && sed -n '1,140p' Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659/test_hub.py\"","aggregated_output":"      this.musicBus.connect(this.master);\n      this.sfxBus.connect(this.master);\n      this.master.connect(this.compressor);\n      this.compressor.connect(this.analyser);\n      this.analyser.connect(this.ctx.destination);\n      this.noise = kitchenNoiseBuffer(this.ctx);\n      this.musicBus.gain.value = this.musicVolume;\n      this.sfxBus.gain.value = this.sfxVolume;\n      this.master.gain.value = .8;\n    }\n    if (this.ctx.state === 'suspended') await this.ctx.resume();\n    this.resume();\n    return this.ctx.state === 'running';\n  }\n\n  setVolumes(music = .1, sfx = .65) {\n    this.musicVolume = Math.max(0, Math.min(1, Number(music)));\n    this.sfxVolume = Math.max(0, Math.min(1, Number(sfx)));\n    if (!this.ctx) return;\n    this.musicBus.gain.setTargetAtTime(this.musicVolume, this.ctx.currentTime, .025);\n    this.sfxBus.gain.setTargetAtTime(this.sfxVolume, this.ctx.currentTime, .025);\n  }\n\n  tone(options, music = false) {\n    if (!this.ctx || this.stopped) return;\n    kitchenTone(this.ctx, music ? this.musicBus : this.sfxBus, options, this.track);\n    if (music) this.notes++;\n  }\n\n  hiss(options, music = false) {\n    if (!this.ctx || this.stopped) return;\n    kitchenNoise(this.ctx, music ? this.musicBus : this.sfxBus, this.noise, options, this.track);\n  }\n\n  tick(state, dt) {\n    if (!this.ctx || this.stopped || this.ctx.state !== 'running') return;\n    const now = this.ctx.currentTime;\n    if (this.nextBeat < now - .2) this.nextBeat = now + .035;\n    const tempo = state?.shift >= 3 ? 124 : state?.shift === 2 ? 118 : 112;\n    const eighth = 60 / tempo / 2;\n    while (this.nextBeat < now + .12) {\n      this.playStep(this.nextBeat, this.step++);\n      // Alternating long/short eighths make the kitchen shuffle swing.\n      this.nextBeat += eighth * ((this.step % 2) ? 1.24 : .76);\n    }\n    if (state?.pressure > 78 && now - this.lastWarning > 5) {\n      this.lastWarning = now;\n      this.sfx('warning');\n    }\n  }\n\n  playStep(time, step) {\n    const chords = [[53,57,60,64], [50,53,57,60], [55,58,62,65], [48,52,58,62]];\n    const chord = chords[Math.floor(step / 16) % chords.length];\n    const slot = step % 8;\n    const bar = Math.floor(step / 8);\n    if (slot % 2 === 0) {\n      const walking = [chord[0] - 12, chord[2] - 12, chord[1] - 12, chord[0] - 11];\n      this.tone({ time, frequency: kitchenMidi(walking[slot / 2]), duration: .25, volume: .24,\n        type: 'triangle', filter: 650, attack: .008 }, true);\n    }\n    if (slot === 0 || slot === 3 || slot === 6) {\n      chord.slice(1).forEach((n, i) => this.tone({ time: time + i * .009,\n        frequency: kitchenMidi(n + 12), duration: slot === 0 ? .27 : .16,\n        volume: .085, type: 'triangle', filter: 2400, attack: .004 }, true));\n    }\n    const melody = [0, null, 2, 3, 1, null, 2, 1, 0, 1, 2, null, 3, 2, 1, null];\n    const m = melody[step % melody.length];\n    if (m !== null && bar % 4 !== 3) {\n      this.tone({ time: time + .012, frequency: kitchenMidi(chord[m] + 24),\n        duration: .11 + (slot === 6 ? .12 : 0), volume: .063,\n        type: 'sine', attack: .008 }, true);\n      this.tone({ time: time + .013, frequency: kitchenMidi(chord[m] + 36),\n        duration: .055, volume: .016, type: 'sine' }, true);\n    }\n    this.hiss({ time, duration: slot % 2 ? .075 : .04, volume: .035,\n      frequency: 6000, rate: 1.5 }, true);\n    if (slot === 0 || slot === 4) {\n      this.tone({ time, frequency: 130, endFrequency: 43, duration: .16,\n        volume: .28, type: 'sine', attack: .001 }, true);\n    }\n    if (slot === 2 || slot === 6) {\n      this.hiss({ time, duration: .09, volume: .12, frequency: 1500, type: 'bandpass' }, true);\n      this.tone({ time, frequency: 210, endFrequency: 120, duration: .06,\n        volume: .055, type: 'triangle' }, true);\n    }\n    if (step % 32 === 31) this.hiss({ time, duration: .24, volume: .045, frequency: 4500 }, true);\n  }\n\n  sfx(name) {\n    if (!this.ctx || this.stopped) return;\n    this.effects++;\n    const time = this.ctx.currentTime + .005;\n    const sequence = (notes, duration = .08, volume = .11, type = 'triangle') =>\n      notes.forEach((n, i) => this.tone({ time: time + i * duration * .65,\n        frequency: kitchenMidi(n), duration, volume, type }));\n    switch (name) {\n      case 'catch':\n        this.tone({ time, frequency: 320, endFrequency: 920, duration: .075, volume: .15 });\n        this.hiss({ time, duration: .03, volume: .065, frequency: 900, type: 'bandpass' });\n        break;\n\"\"\"AI Hub conformance: sequential scenarios, one browser, only failures and total.\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\nfrom urllib.parse import urlencode\nfrom playwright.sync_api import sync_playwright\n\nSLUG = 'Short-Order-Fever-Pressure-Cooker-gpt-6.1-sol-ultra-20261105-221659'\n\ndef run(base_url):\n    reports = []\n    failures = []\n    count = 0\n    scenarios = [\n        ('two-player', {'players': 2}),\n        ('four-player-loss', {'players': 4, 'latency': 150, 'jitter': 50, 'loss': 5}),\n        ('host-leave', {'players': 4, 'latency': 150, 'jitter': 50, 'loss': 5, 'scenario': 'host-leave'}),\n        ('server', {'players': 2, 'scenario': 'server'}),\n    ]\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader'])\n        for name, options in scenarios:\n            context = browser.new_context(ignore_https_errors=True, viewport={'width': 1280, 'height': 720})\n            page = context.new_page()\n            try:\n                query = {'game': '../'+SLUG+'.html?webgl', 'auto': 1, **options}\n                url = base_url.rstrip('/')+'/'+SLUG+'/harness.html?'+urlencode(query)\n                page.goto(url, wait_until='domcontentloaded', timeout=60000)\n                page.wait_for_function('document.body.dataset.complete === \"true\"', timeout=120000)\n                report = page.evaluate('window.__hubCheck')\n                reports.append({'scenario': name, **report})\n                for check in report['checks']:\n                    count += 1\n                    if not check['pass']:\n                        failures.append(name+': '+check['name']+' — '+check.get('detail',''))\n            except Exception as exc:\n                count += 1\n                failures.append(name+': '+str(exc).splitlines()[0])\n                try: reports.append({'scenario': name, 'error': str(exc), 'body': page.locator('body').inner_text()[-6000:]})\n                except Exception: pass\n            finally:\n                context.close()\n        browser.close()\n    Path(__file__).with_name('hub-report.json').write_text(json.dumps(reports, indent=2))\n    return count, failures\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser()\n    parser.add_argument('base_url', nargs='?', default='http://127.0.0.1:34895')\n    args = parser.parse_args()\n    total, errors = run(args.base_url)\n    for error in errors: print('FAIL '+error)\n    print(f'{total-len(errors)}/{total} AI Hub checks passed')\n    raise SystemExit(bool(errors))\n","exit_code":0,"status":"completed"}}
