&&screen==='playing'&&\"'!paused){const p=localPlayer();if(p){const o=state.orders[p.order];if(p.stack.length===o.recipe.length){if(p.z>4.1&&Math.abs(p.x-HATCHES[p.order])<1.8)input.action=true;}else{const near=state.items.filter(i=>Math.hypot(i.x-p.x,i.z-p.z)<tuning.catchRadius).sort((a,b)=>Math.hypot(a.x-p.x,a.z-p.z)-Math.hypot(b.x-p.x,b.z-p.z))[0];if(near?.type===o.recipe[p.stack.length])input.action=true;}}}}\nlet pointerAction=false;\nfunction bindUI(){document.addEventListener('\"'click',e=>{const b=e.target.closest('[data-action]');if(b){if(activity('keyboard'))return;audio?.unlock();sound('ui');const a=b.dataset.action;if(a==='start')startGame();if(a==='howto'||a==='settings'||a==='about'||a==='online'||a==='dev')openPanel(a);if(a==='back')back();if(a==='resume')resume();if(a==='title')title();if(a==='restart'){if(\"'!network?.active())startGame();}if(a==='\"'pause')pause();if(a==='host-local'){network.hostLocal();\"'$('\"'network-status').textContent='Kitchen open. On the other tab, choose Join local kitchen.';}if(a==='join-local'){network.joinLocal();\"'$('\"'network-status').textContent='Looking for a kitchen in another tab…';}if(a==='coop-start'){startGame();network.sendWorld(safeState());}if(a==='invite')runInvite('create');if(a==='accept-invite')runInvite('join');if(a==='accept-answer')runInvite('answer');if(a==='copy-code'){navigator.clipboard?.writeText(\"'$('\"'network-code').value).then(()=>{\"'$('\"'network-status').textContent='Code copied.';}).catch(()=>{\"'$('\"'network-code').select();\"'$('\"'network-status').textContent='Select the code and copy it with Ctrl+C.';});}if(a==='dev-reset'){Object.assign(tuning,DEFAULTS);renderDev();}if(a==='dev-fill'){const p=localPlayer();p.stack=[...state.orders[p.order].recipe];notice('Tray filled. Deliver it to '+state.orders[p.order].label+'.');}if(a==='dev-next'){if(state.shift<2){state.mode='intermission';state.transition=.1;}else endGame(true);}if(a==='dev-clear'){state.pressure=0;state.bellCharge=1;for(