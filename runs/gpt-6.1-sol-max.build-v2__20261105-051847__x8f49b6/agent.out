querySelectorAll('\"'[data-focus]')].filter(e=>\"'!e.disabled&&e.offsetParent!==null);}\n set(id,sound=true){const items=this.items();if(!items.length){this.id=null;return;}let el=items.find(e=>e.dataset.focus===id)||items[0];const old=this.id;this.id=el.dataset.focus;for(const x of this.root.querySelectorAll('\"'.focused'))x.classList.remove('focused');el.classList.add('focused');if(sound&&old\"'!==this.id)this.onSound();}\n reset(){this.set(this.items()[0]?.dataset.focus,false);}\n move(delta){const a=this.items(),i=a.findIndex(x=>x.dataset.focus===this.id);if(a.length)this.set(a[(i+delta+a.length)%a.length].dataset.focus);}\n confirm(){this.items().find(e=>e.dataset.focus===this.id)?.click();}\n adjust(delta){const el=this.items().find(e=>e.dataset.focus===this.id);if(!el)return;const input=el.matches('\"'input,select')?el:el.querySelector('input,select');if(input?.type==='range'){input.value=String(Math.min(+input.max,Math.max(+input.min,+input.value+delta*(+input.step||.05))));input.dispatchEvent(new Event('input',{bubbles:true}));}else if(input?.tagName==='SELECT'){input.selectedIndex=(input.selectedIndex+delta+input.options.length)%input.options.length;input.dispatchEvent(new Event('change',{bubbles:true}));}else el.click();}\n}\nEOF\ncat > src/ui/ecg.js <<'EOF'\nexport class ECG{\n constructor(canvas){this.canvas=canvas;this.ctx=canvas.getContext('2d');}\n draw(s){const c=this.canvas,x=this.ctx,w=c.width=500,h=c.height=94;x.clearRect(0,0,w,h);x.strokeStyle='#44726e66';x.lineWidth=1;for(let i=0;i<w;i+=25){x.beginPath();x.moveTo(i,0);x.lineTo(i,h);x.stroke();}for(let i=0;i<h;i+=23){x.beginPath();x.moveTo(0,i);x.lineTo(w,i);x.stroke();}x.lineWidth=2.5;x.strokeStyle=s.arrest?'#e8443a':s.vitals<=30?'#f2b134':'#7cf2c9';x.shadowColor=x.strokeStyle;x.shadowBlur=7;x.beginPath();for(let i=0;i<=w;i++){let f=((i/w*2+s.beatPhase)%1),v=0;if(\"'!s.arrest){v=Math.exp(-((f-.49)/.018)**2)*-37+Math.exp(-((f-.455)/.014)**2)*11+Math.exp(-((f-.53)/.02)**2)*20+Math.exp(-((f-.3)/.04)**2)*-5+Math.exp(-((f-.7)/.07)**2)*-9;}const y=h*.52+v;if(!i)x.moveTo(i,y);else x.lineTo(i,y);}x.stroke();x.shadowBlur=0;}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/ui.css <<'EOF'\n@font-face{font-family:Bangers;src:url('@fontsource/bangers/files/bangers-latin-400-normal.woff2') format('woff2');font-display:swap}\n@font-face{font-family:Barlow;src:url('@fontsource/barlow-condensed/files/barlow-condensed-latin-500-normal.woff2') format('woff2');font-weight:500;font-display:swap}\n@font-face{font-family:Barlow;src:url('@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2') format('woff2');font-weight:700;font-display:swap}\n:root{font-size:clamp(8px,1.48148vh,24px);--paper:#f4f1e8;--ink:#120d20;--teal:#17707a;--dark:#0b2529;--gold:#f2b134;--mint:#7cf2c9;--red:#e8443a;--muted:#9ebdb7;color-scheme:dark}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;overscroll-behavior:none}body{background:var(--dark);color:var(--paper);font-family:Barlow,'Arial Narrow',sans-serif;font-weight:500}button,input,select{font:inherit}button{cursor:pointer;color:inherit;border:0;background:none;touch-action:manipulation}button:focus-visible,input:focus-visible{outline:.2rem solid var(--gold);outline-offset:.25rem}button,select,input{ -webkit-tap-highlight-color:transparent}button[disabled]{cursor:default;opacity:.45}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#app{position:fixed;inset:0;isolation:isolate;pointer-events:none}#screen,#hud,#overlays,#touch,#toast-layer{position:absolute;inset:0;pointer-events:none}#screen>*{pointer-events:auto}#hud button,#hud input,#overlays button,#overlays input,#overlays select,#touch button{pointer-events:auto}.screen{position:absolute;inset:0;padding:4.8vh 5vw;animation:ink-in .35s ease-out}h1,h2,h3,p{margin:0}h1,h2,h3,.comic{font-family:Bangers,Impact,sans-serif;font-weight:400}h2{font-size:5rem;letter-spacing:.035em}h3{font-size:3rem}p{font-size:2.25rem;line-height:1.2}.eyebrow{font-size:2.1rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase}.muted{color:var(--muted)}.gold{color:var(--gold)}.mint{color:var(--mint)}.red{color:var(--red)}.rule{height:.12rem;background:currentColor;opacity:.3;margin:1.4rem 0}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:2rem}.small{font-size:2rem}.key-row{display:flex;align-items:center;gap:1.3rem;font-size:2.15rem}.glyph,kbd{display:inline-flex;align-items:center;justify-content:center;min-width:2.2rem;height:2.2rem;padding:0 .45rem;border:.12rem solid currentColor;border-radius:.25rem;font-family:Barlow,sans-serif;font-weight:700;font-size:1.6rem;line-height:1;white-space:nowrap;vertical-align:.12rem;box-shadow:0 .16rem 0 #0003}.glyph-special{color:var(--mint)}.glyph-alt{color:#ef9b94}.glyph-syringe{color:#eab3e6}.primary,.secondary,.menu-item,.choice,.back-btn{transition:background .12s,color .12s,transform .12s;position:relative}.primary{background:var(--gold);color:var(--ink);font-size:2.8rem;font-weight:700;min-height:4.6rem;padding:.7rem 1.5rem;border:.16rem solid var(--ink);box-shadow:.35rem .4rem 0 var(--ink);text-transform:uppercase;letter-spacing:.03em;display:flex;justify-content:space-between;align-items:center;gap:2rem}.primary.focused,.primary:hover{background:#ffcf65;transform:translate(-.12rem,-.12rem);box-shadow:.5rem .55rem 0 var(--ink)}.secondary{background:#19434b;color:var(--paper);font-size:2.4rem;min-height:4rem;padding:.55rem 1.3rem;border:.12rem solid #8db6b64f;display:flex;align-items:center;justify-content:space-between;gap:1rem}.secondary.focused,.secondary:hover{border-color:var(--gold);color:var(--gold);background:#28535a}.back-btn{font-size:2rem;padding:.5rem 1rem;border:.1rem solid #f4f1e850;align-self:flex-start}.back-btn:hover,.back-btn.focused{background:var(--paper);color:var(--ink)}.bottom-bar{position:absolute;bottom:4.8vh;left:5vw;right:5vw;display:flex;justify-content:space-between;align-items:center;gap:1rem;font-size:2.1rem}.top-brand{display:flex;justify-content: