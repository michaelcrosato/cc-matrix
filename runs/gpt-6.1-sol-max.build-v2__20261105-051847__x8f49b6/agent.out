mplate-columns:1fr 1fr}.dev-controls{gap:.55rem}.dev-controls button{font-size:1.85rem;min-height:4rem}.touch-notice{left:6vw;right:6vw;bottom:7vh;padding:2rem 1.5rem}.touch-notice h2{font-size:3.6rem}.touch-notice p{font-size:2.2rem}.touch-notice .secondary{font-size:2.5rem}.session-intro h1{font-size:5rem}.session-intro h2{font-size:3.5rem}.session-actions{flex-direction:column}.session-player{font-size:2.2rem}.credits{inset:8vh 5vw;padding:2rem}.credits h2{font-size:4.8rem}.credits p{font-size:2.5rem}.cutin{left:5vw;right:5vw;font-size:4.5rem}.demo-badge{top:25vh;right:5vw}.demo-badge strong{font-size:2.5rem}.demo-badge span{font-size:1.9rem}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms\"'!important;transition-duration:.01ms!important}}\nEOF\ncat > src/ui/icons.js <<'\"'EOF'\nconst paths=[\n '<path d=\\\"M6 20 18 4M6 20l2-7 4 3-6 4M13 11l3 2\\\"/>',\n '<path d=\\\"M6 20 10 3l4 0 4 17M10 3l2 13M14 3l-2 13M6 20l3-1M18 20l-3-1\\\"/>',\n '<path d=\\\"M5 20v-8q0-4 4-4h7V3M9 12h7M13 3h6M5 20h3\\\"/>',\n '<path d=\\\"M8 8h8v12H8zM10 8V4h7v3M10 3h7M10 12h4M18 10l3-2M18 14h3\\\"/>',\n '<path d=\\\"M5 20 16 5q6-2 3 4L9 20M16 5l3 4M5 20q5-7 10 0\\\"/>',\n '<path d=\\\"M7 20 15 7l3 2-8 13M15 7l3-4M17 12l3 2M4 4l3 3M12 2v3\\\"/>',\n '<circle cx=\\\"10\\\" cy=\\\"11\\\" r=\\\"6\\\"/><circle cx=\\\"10\\\" cy=\\\"11\\\" r=\\\"3\\\"/><path d=\\\"m14 16 5 6M10 5v6l4 2\\\"/>',\n '<path d=\\\"M6 4v9l10 6M18 4v9L8 19M6 4h3M18 4h-3\\\"/><circle cx=\\\"6\\\" cy=\\\"19\\\" r=\\\"3\\\"/><circle cx=\\\"18\\\" cy=\\\"19\\\" r=\\\"3\\\"/>'\n];\nexport const toolIcon=(i)=>\"'`<svg viewBox=\"0 0 24 26\" aria-hidden=\"true\">${paths[i]}</svg>`;\nEOF\ncat > src/ui/focus.js <<'\"'EOF'\nexport class Focus{\n constructor(root,onSound=()=>{}){this.root=root;this.onSound=onSound;this.id=null;root.addEventListener('pointerover',e=>{const el=e.target.closest('[data-focus]');if(el&&\"'!el.disabled)this.set(el.dataset.focus,false);});}\n items(){return [...this.root.querySelectorAll('\"'[data-focus]')].filter(e=>\"'!e.disabled&&e.offsetParent!==null);}\n set(id,sound=true){const items=this.items();if(!items.length){this.id=null;return;}let el=items.find(e=>e.dataset.focus===id)||items[0];const old=this.id;this.id=el.dataset.focus;for(const x of this.root.querySelectorAll('\"'.focused'))x.classList.remove('focused');el.classList.add('focused');if(sound&&old\"'!==this.id)this.onSound();}\n reset(){this.set(this.items()[0]?.dataset.focus,false);}\n move(delta){const a=this.items(),i=a.findIndex(x=>x.dataset.focus===this.id);if(a.length)this.set(a[(i+delta+a.length)%a.length].dataset.focus);}\n confirm(){this.items().find(e=>e.dataset.focus===this.id)?.click();}\n adjust(delta){const el=this.items().find(e=>e.dataset.focus===this.id);if(!el)return;const input=el.matches('\"'input,select')?el:el.querySelector('input,select');if(input?.type==='range'){input.value=String(Math.min(+input.max,Math.max(+input.min,+input.value+delta*(+input.step||.05))));input.dispatchEvent(new Event('input',{bubbles:true}));}else if(input?.tagName==='SELECT'){input.selectedIndex=(input.selectedIndex+delta+input.options.length)%input.options.length;input.dispatchEvent(new Event('change',{bubbles:true}));}else el.click();}\n}\nEOF\ncat > src/ui/ecg.js <<'EOF'\nexport class ECG{\n constructor(canvas){this.canvas=canvas;this.ctx=canvas.getContext('2d');}\n draw(s){const c=this.canvas,x=this.ctx,w=c.width=500,h=c.height=94;x.clearRect(0,0,w,h);x.strokeStyle='#44726e66';x.lineWidth=1;for(let i=0;i<w;i+=25){x.beginPath();x.moveTo(i,0);x.lineTo(i,h);x.stroke();}for(let i=0;i<h;i+=23){x.beginPath();x.moveTo(0,i);x.lineTo(w,i);x.stroke();}x.lineWidth=2.5;x.strokeStyle=s.arrest?'#e8443a':s.vitals<=30?'#f2b134':'#7cf2c9';x.shadowColor=x.strokeStyle;x.shadowBlur=7;x.beginPath();for(let i=0;i<=w;i++){let f=((i/w*2+s.beatPhase)%1),v=0;if(\"'!s.arrest){v=Math.exp(-((f-.49)/.018)**2)*-37+Math.exp(-((f-.455)/.014)**2)*11+Math.exp(-((f-.53)/.02)**2)*20+Math.exp(-((f-.3)/.04)**2)*-5+Math.exp(-((f-.7)/.07)**2)*-9;}const y=h*.52+v;if(!i)x.moveTo(i,y);else x.lineTo(i,y);}x.stroke();x.shadowBlur=0;}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/hud.js <<'EOF'\nimport {tools,toolLabels,toolHints} from '../config/tuning.js';\nimport {operations} from '../data/ops/index.js';\nimport {toolIcon} from './icons.js';\nimport {renderTokens} from '../input/glyphs.js';\nimport {ECG} from './ecg.js';\nexport const timeText=(n)=>\"'`${Math.floor(Math.max(0,n)/60)}:${String(Math.floor(Math.max(0,n)%60)).padStart(2,'\"'0')}\"'`;\nexport class HUD{\n constructor(el,app){this.el=el;this.app=app;this.phaseKey='\"'';this.device='';this.labels=[];\n el.innerHTML=\"'`<div class=\"hud-top\"><div class=\"objective-card\"><div class=\"objective-phase\" id=\"phase-label\"></div><div class=\"objective-text\" id=\"objective\"></div><div class=\"objective-tools\" id=\"objective-tools\"></div></div><div class=\"vitals-panel\"><div class=\"vitals-value\" id=\"vitals\">100<small>VITALS</small></div><div class=\"ecg-wrap\"><canvas id=\"ecg\" width=\"500\" height=\"94\"></canvas><span class=\"bpm\" id=\"bpm\"></span></div></div><div class=\"hud-stats\"><div class=\"timer\" id=\"timer\"></div><div class=\"score-line\" id=\"score\"></div><div class=\"combo\" id=\"combo\"></div><button class=\"pause-chip\" data-action=\"pause\" aria-label=\"Pause operation\">Ⅱ <span id=\"pause-prompt\"></span></button></div></div><div class=\"tool-dock\"><div class=\"tool-wheel\">${tools.map((t,i)=>{const a=i*Math.PI/4,x=Math.sin(a)*7.05,y=-Math.cos(a)*7.05;return`<button class=\"tool-slot\" style=\"margin-left:${x}rem;margin-top:${y}rem\" data-action=\"tool\" data-value=\"${i}\" title=\"${i+1} · ${toolLabels[i]}\" aria-label=\"${toolLabels[i]}\">${toolIcon(i)}<span>${i+1}</span></button>`;}).join('\"'')}<div class=\\\"tool-center\\\"><strong id=\\\"tool-name\\\">Gel</strong><small id=\\\"tool-select\\\"></small></div></div></div><div class=\\\"bark-area\\\"><div class=\\\"bark-bubble\\\"><span class=\\\"bark-name\\\" id=\\\"bark-name\\\">BEA OKONKWO</span><div class=\\\"bark-text\\\" id=\\\"bark-text\\\"></div></div><div class=\\\"tool-help\\\" id=\\\"tool-help\\\"></div></div><div class=\\\"gifts\\\"><div class=\\\"gift-label\\\"><strong id=\\\"gift-name\\\">The Hush</strong><span id=\\\"composure-value\\\">0%</span></div><div class=\\\"gift-meter\\\"><div class=\\\"gift-fill\\\" id=\\\"composure-fill\\\"></div></div><button class=\\\"gift-button\\\" data-action=\\\"special\\\"><span id=\\\"special-label\\\">Gather composure</span><span id=\\\"special-prompt\\\"></span></button><button class=\\\"syringe-button\\\" data-hold=\\\"syringe\\\"><span id=\\\"syringe-label\\\">Stabilizer</span><span id=\\\"syringe-prompt\\\"></span></button></div><div class=\\\"site-tabs\\\" id=\\\"sites\\\"></div><div class=\\\"tray-label\\\" id=\\\"tray-label\\\">SPECIMEN TRAY · 0</div><div id=\\\"targets\\\"></div><div id=\\\"tip-names\\\"></div><div id=\\\"arrest\\\"></div><div id=\\\"danger\\\"></div><div id=\\\"demo-mark\\\"></div><div id=\\\"debug\\\"></div>\"'`;\n this.$=id=>el.querySelector('\"'#'+id);this.ecg=new ECG(this.\"'$('\"'ecg'));}\n update(s){const app=this.app,op=operations[s.op],seat=s.seats.find(t=>t.id===app.localId)||s.seats[0];if(\"'!seat)return;const token=[REDACTED_SECRET] phaseKey=s.op+'\"':'+s.phase+':'+app.input.prompt+':'+app.settings.glyphs;\n if(this.phaseKey\"'!==phaseKey){this.phaseKey=phaseKey;this.$('\"'phase-label').textContent=\"'`${op.title} / ${s.phase+1} OF ${op.phases.length}`;this.$('\"'objective').innerHTML=token(s.objective||'Tonight, the patient comes first.');this.\"'$('\"'objective-tools').textContent=op.phases[s.phase].tools.map(t=>t.toUpperCase()).join('  /  ');this.\"'$('\"'sites').innerHTML=op.sites.length>1?op.sites.map((site,i)=>\"'`<button data-action=\"siteDirect\" data-value=\"${i}\" class=\"site-button ${i===s.site?'\"'active':''}\\\">\"'${site.organ}</button>`).join('\"''):'';this.\"'$('\"'pause-prompt').innerHTML=token('{pause} Pause');this.\"'$('\"'special-prompt').innerHTML=token('{special}');this.\"'$('\"'syringe-prompt').innerHTML=token('{syringe}');this.\"'$('\"'tool-select').innerHTML=token('{tools}');}\n this.\"'$('\"'vitals').innerHTML=\"'`${Math.ceil(s.vitals)}<small>VITALS</small>`;this.$('\"'vitals').style.color=s.vitals<=30?'#e8443a':'#7cf2c9';this.\"'$('\"'bpm').textContent=\"'`${Math.round(s.bpm)} BPM`;this.$('\"'timer').textContent=op.unfailing?'—:—':timeText(s.timer);this.\"'$('\"'timer').classList.toggle('red',s.timer<30&&\"'!op.unfailing);this.$('\"'score').textContent=String(s.score).padStart(6,'0');this.\"'$('\"'combo').textContent=s.combo?\"'`×${(1+.05*Math.min(20,s.combo)).toFixed(2)} · ${s.combo} CHAIN`:'\"'KEEP YOUR RHYTHM';\n this.el.querySelectorAll('.tool-slot').forEach((b,i)=>{b.classList.toggle('active',seat.tool===i);b.classList.toggle('hint',app.hintUntil>performance.now()&&op.phases[s.phase].tools.includes(tools[i]));});this.\"'$('\"'tool-name').textContent=toolLabels[seat.tool];this.\"'$('\"'tool-help').innerHTML=token(toolHints[tools[seat.tool]]);this.\"'$('\"'gift-name').textContent=s.doctor==='ines'?'Sforzando':'The Hush';this.\"'$('\"'composure-value').textContent=Math.round(s.composure)+'%';this.\"'$('\"'composure-fill').style.width=s.composure+'%';this.\"'$('\"'special-label').textContent=s.hush>0?'The room is quiet':s.sforzando>0?'ACCENT\"'!'\"':s.composure>=99?'Ready. Breathe.':'Gather composure';this.\"'$('\"'syringe-label').textContent=seat.cooldown>0?\"'`Ready in ${seat.cooldown.toFixed(1)}s`:'\"'Stabilizer +15';\n this.\"'$('\"'bark-name').textContent=s.op===6?'PIP · BEA’S NOTEBOOK':'BEA OKONKWO';this.\"'$('\"'bark-text').innerHTML=token(app.bark||'Steady hands, Doctor.');this.\"'$('\"'demo-mark').innerHTML=app.attract?'<div class=\\\"demo-badge\\\"><strong>DEMO / AUTO SURGEON</strong><span>Press any button to scrub in</span></div>':'';this.\"'$('\"'danger').innerHTML=s.vitals<=30&&\"'!s.arrest?'\"'<div class=\\\"danger-vignette\\\"></div>':'';\n this.el.querySelectorAll('.site-button').forEach((b,i)=>{b.classList.toggle('active',i===s.site);b.classList.toggle('alarm',s.entities.some(e=>e.site===i&&\"'!e.done&&['\"'bleeder','crescendo'].includes(e.kind)));});\n if(s.arrest){const charge=seat.charge||0;this.\"'$('\"'arrest').innerHTML=\"'`<div class=\"arrest-panel\"><h2>CARDIAC ARREST</h2><p>${token('\"'Hold {charge}. Release both in gold.')}</p><div class=\\\"charge-track\\\"><div class=\\\"charge-gold\\\"></div><div class=\\\"charge-pointer\\\" style=\\\"left:\"'${Math.min(100,charge/1.8*100)}%\"></div></div><span class=\"arrest-count\">${s.arrestLeft.toFixed(1)}s</span>${s.entities.some(e=>e.kind==='\"'fermata'&&e.hp>0)?'<p class=\\\"gold\\\">Laser the exposed eye first.</p>':''}</div>\"'`;}else this.$('\"'arrest').innerHTML='';\n const tray=app.view?.project(1.67,-.44,.49);if(tray){this.\"'$('\"'tray-label').style.left=(tray.x-60)+'px';this.\"'$('\"'tray-label').style.top=tray.y+'px';this.\"'$('\"'tray-label').textContent=\"'`SPECIMENS · ${s.tray.length}`;}\n const active=s.entities.filter(e=>e.site===s.site&&!e.done&&e.marked&&e.required).slice(0,5);const labels=[];for(const e of active){let text='\"'';if(e.kind==='shard')text='PULL ↗';if(e.kind==='injection')text='ANTIDOTE';if(e.kind==='tremolo')text=e.pinned>0?'PINNED · LASER':'SLOW HANDS · SCAN';if(e.hp>0&&e.kind\"'!=='\"'tremolo')text=\"'`${e.kind.toUpperCase()} · ${Math.ceil(e.hp)}`;if(e.kind==='\"'legato')text=\"'`TAIL FIRST · ${e.remaining+1}`;if(e.kind==='\"'crescendo')text=e.exposed?'TRACE THE RING':'FOUR FEEDERS';if(text){const p=app.view?.project(e.x,e.y+.14);if(p&&p.visible)labels.push(\"'`<span class=\"target-label\" style=\"left:${p.x}px;top:${p.y}px\">${text}</span>`);}}\n this.$('\"'targets').innerHTML=labels.join('');this.\"'$('\"'tip-names').replaceChildren();if(s.seats.length>1)for(const t of s.seats){if(t.site\"'!==s.site)continue;const p=app.view?.project(t.x,t.y);if(p){const el=document.createElement('\"'span');el.className='tip-name';el.style.cssText=\"'`left:${p.x}px;top:${p.y}px;color:${t.color}`;el.textContent=t.name;this.$('\"'tip-names').append(el);}}\n this.\"'$('\"'debug').innerHTML=app.debugOverlay?\"'`<div class=\"debug-overlay\"><p>${app.view?.backend} / ${s.bpm.toFixed(1)} BPM / BEAT ${s.beat} / ${app.frameMs.toFixed(1)}ms<br>TIP ${seat.x.toFixed(3)}, ${seat.y.toFixed(3)} · USE ${seat.use.toFixed(2)}<br>${JSON.stringify(app.input.padStates.get(app.input.lastPad)?.axes||[])}</p></div>`:'\"'';this.ecg.draw(s);\n // Last Patient gives the room back to the patient.\n this.el.style.opacity=op.unfailing?'.0':'1';\n }\n}\nEOF\ncat > tools/build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport {readFileSync,writeFileSync,mkdirSync,copyFileSync} from 'node:fs';\nimport path from 'node:path';\nimport {GAME_TITLE,TAGLINE} from '../src/config/identity.js';\nconst exact={name:'one-three',setup(b){b.onResolve({filter:/\"'^three$/},()=>({path:path.resolve('\"'node_modules/three/build/three.webgpu.js')}));}};\nconst shared={bundle:true,minify:true,write:false,legalComments:'none',logLevel:'error',target:'es2022'};\nconst js=(await build({...shared,entryPoints:['src/main.js'],format:'esm',platform:'browser',plugins:[exact]})).outputFiles[0].text;\nconst css=(await build({...shared,entryPoints:['src/ui/ui.css'],loader:{'.woff2':'dataurl'}})).outputFiles[0].text;\nconst client=readFileSync('tools/vendor/session.js','utf8').replace(/\\\\r\\\\n/g,'\\\\n').trimEnd();\nconst about=readFileSync('src/data/about.json','utf8');\nconst esc=s=>s.replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst noCloser=s=>s.replace(/<\\\\/(script)/gi,'<\\\\\\\\/\"'$1'\"');\nconst html=['<\"'!doctype html>'\"','<html lang=\\\"en\\\" data-prompt-set=\\\"keyboard\\\">','<head>','<meta charset=\\\"utf-8\\\">','<script>',client,'</script>',\n'<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">',\"'`<title>${esc(GAME_TITLE)} — ${esc(TAGLINE)}</title>`,\n'\"'<meta name=\\\"description\\\" content=\\\"A rain-soaked surgical action drama. Eight instruments, seven engineered parasites, one shared heartbeat. Story and 1–4 player surgery.\\\">',\n'<meta name=\\\"theme-color\\\" content=\\\"#17707A\\\">','<meta name=\\\"hub:type\\\" content=\\\"Game\\\">','<meta name=\\\"hub:players\\\" content=\\\"1–4\\\">','<meta name=\\\"hub:source\\\" content=\\\"Trauma Center: Second Opinion\\\">',\n'<meta name=\\\"hub:session\\\" content=\\\"1\\\">','<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">','<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">','<meta name=\\\"hub:session-minutes\\\" content=\\\"6\\\">','<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the operation together\\\">','<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: right stick or mouse · use: R2 or click · tools: left stick or 1-8\\\">',\n'<link rel=\\\"icon\\\" href=\\\"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect width=%2764%27 height=%2764%27 rx=%2712%27 fill=%27%2317707a%27/%3E%3Cpath d=%27M32 53 8 30C-2 10 22 4 32 18 42 4 66 10 56 30Z%27 fill=%27%23f2b134%27 stroke=%27%2312081a%27 stroke-width=%273%27/%3E%3Cpath d=%27M8 30h12l4-9 7 24 6-16h19%27 fill=%27none%27 stroke=%27%2312081a%27 stroke-width=%273%27/%3E%3C/svg%3E\\\">',\n'<style>',css,'</style>','</head>','<body>',\n'<div id=\\\"app\\\"><div id=\\\"screen\\\"></div><div id=\\\"hud\\\"></div><div id=\\\"overlays\\\"></div><div id=\\\"touch\\\"></div><div id=\\\"toast-layer\\\"></div></div>',\n'<div id=\\\"boot\\\" class=\\\"boot\\\"><div class=\\\"boot-ecg\\\"></div><h1>Scrubbing in…</h1><p>St. Alder Memorial / Operating Room 03</p></div>',\n'<script type=\\\"application/json\\\" id=\\\"about-data\\\">',noCloser(about),'</script>','<script type=\\\"module\\\">',noCloser(js),'</script>','</body>','</html>'].join('\\\\n');\nmkdirSync('dist',{recursive:true});writeFileSync('dist/game.html',html);\nconst filename=path.basename(process.cwd())+'.html';copyFileSync('dist/game.html',path.join('..',filename));\nEOF\ncat > tools/serve.mjs <<'EOF'\nimport http from 'node:http';\nimport {readFile} from 'node:fs/promises';\nimport path from 'node:path';\nconst server=http.createServer(async(req,res)=>{let file=decodeURIComponent(new URL(req.url,'http://local').pathname);if(file==='/')file='/dist/game.html';const p=path.resolve('.','.'+file);if(\"'!p.startsWith(process.cwd()+path.sep)){res.writeHead(403).end();return;}try{const data=await readFile(p);res.setHeader('\"'Content-Type',file.endsWith('.js')?'text/javascript':file.endsWith('.json')?'application/json':'text/html');res.end(data);}catch{res.writeHead(404).end('Not found');}});\nserver.listen(0,'127.0.0.1',()=>console.log(\"'`http://127.0.0.1:${server.address().port}`));\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/hud.js <<'EOF'\nimport {tools,toolLabels,toolHints} from '../config/tuning.js';\nimport {operations} from '../data/ops/index.js';\nimport {toolIcon} from './icons.js';\nimport {renderTokens} from '../input/glyphs.js';\nimport {ECG} from './ecg.js';\nexport const timeText=(n)=>\"'`${Math.floor(Math.max(0,n)/60)}:${String(Math.floor(Math.max(0,n)%60)).padStart(2,'\"'0')}\"'`;\nexport class HUD{\n constructor(el,app){this.el=el;this.app=app;this.phaseKey='\"'';this.device='';this.labels=[];\n el.innerHTML=\"'`<div class=\"hud-top\"><div class=\"objective-card\"><div class=\"objective-phase\" id=\"phase-label\"></div><div class=\"objective-text\" id=\"objective\"></div><div class=\"objective-tools\" id=\"objective-tools\"></div></div><div class=\"vitals-panel\"><div class=\"vitals-value\" id=\"vitals\">100<small>VITALS</small></div><div class=\"ecg-wrap\"><canvas id=\"ecg\" width=\"500\" height=\"94\"></canvas><span class=\"bpm\" id=\"bpm\"></span></div></div><div class=\"hud-stats\"><div class=\"timer\" id=\"timer\"></div><div class=\"score-line\" id=\"score\"></div><div class=\"combo\" id=\"combo\"></div><button class=\"pause-chip\" data-action=\"pause\" aria-label=\"Pause operation\">Ⅱ <span id=\"pause-prompt\"></span></button></div></div><div class=\"tool-dock\"><div class=\"tool-wheel\">${tools.map((t,i)=>{const a=i*Math.PI/4,x=Math.sin(a)*7.05,y=-Math.cos(a)*7.05;return`<button class=\"tool-slot\" style=\"margin-left:${x}rem;margin-top:${y}rem\" data-action=\"tool\" data-value=\"${i}\" title=\"${i+1} · ${toolLabels[i]}\" aria-label=\"${toolLabels[i]}\">${toolIcon(i)}<span>${i+1}</span></button>`;}).join('\"'')}<div class=\\\"tool-center\\\"><strong id=\\\"tool-name\\\">Gel</strong><small id=\\\"tool-select\\\"></small></div></div></div><div class=\\\"bark-area\\\"><div class=\\\"bark-bubble\\\"><span class=\\\"bark-name\\\" id=\\\"bark-name\\\">BEA OK