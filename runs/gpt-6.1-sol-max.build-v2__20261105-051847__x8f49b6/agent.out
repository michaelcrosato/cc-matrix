nnerHTML=token('{special}');this.\"'$('\"'syringe-prompt').innerHTML=token('{syringe}');this.\"'$('\"'tool-select').innerHTML=token('{tools}');}\n this.\"'$('\"'vitals').innerHTML=\"'`${Math.ceil(s.vitals)}<small>VITALS</small>`;this.$('\"'vitals').style.color=s.vitals<=30?'#e8443a':'#7cf2c9';this.\"'$('\"'bpm').textContent=\"'`${Math.round(s.bpm)} BPM`;this.$('\"'timer').textContent=op.unfailing?'—:—':timeText(s.timer);this.\"'$('\"'timer').classList.toggle('red',s.timer<30&&\"'!op.unfailing);this.$('\"'score').textContent=String(s.score).padStart(6,'0');this.\"'$('\"'combo').textContent=s.combo?\"'`×${(1+.05*Math.min(20,s.combo)).toFixed(2)} · ${s.combo} CHAIN`:'\"'KEEP YOUR RHYTHM';\n this.el.querySelectorAll('.tool-slot').forEach((b,i)=>{b.classList.toggle('active',seat.tool===i);b.classList.toggle('hint',app.hintUntil>performance.now()&&op.phases[s.phase].tools.includes(tools[i]));});this.\"'$('\"'tool-name').textContent=toolLabels[seat.tool];this.\"'$('\"'tool-help').innerHTML=token(toolHints[tools[seat.tool]]);this.\"'$('\"'gift-name').textContent=s.doctor==='ines'?'Sforzando':'The Hush';this.\"'$('\"'composure-value').textContent=Math.round(s.composure)+'%';this.\"'$('\"'composure-fill').style.width=s.composure+'%';this.\"'$('\"'special-label').textContent=s.hush>0?'The room is quiet':s.sforzando>0?'ACCENT\"'!'\"':s.composure>=99?'Ready. Breathe.':'Gather composure';this.\"'$('\"'syringe-label').textContent=seat.cooldown>0?\"'`Ready in ${seat.cooldown.toFixed(1)}s`:'\"'Stabilizer +15';\n this.\"'$('\"'bark-name').textContent=s.op===6?'PIP · BEA’S NOTEBOOK':'BEA OKONKWO';this.\"'$('\"'bark-text').innerHTML=token(app.bark||'Steady hands, Doctor.');this.\"'$('\"'demo-mark').innerHTML=app.attract?'<div class=\\\"demo-badge\\\"><strong>DEMO / AUTO SURGEON</strong><span>Press any button to scrub in</span></div>':'';this.\"'$('\"'danger').innerHTML=s.vitals<=30&&\"'!s.arrest?'\"'<div class=\\\"danger-vignette\\\"></div>':'';\n this.el.querySelectorAll('.site-button').forEach((b,i)=>{b.classList.toggle('active',i===s.site);b.classList.toggle('alarm',s.entities.some(e=>e.site===i&&\"'!e.done&&['\"'bleeder','crescendo'].includes(e.kind)));});\n if(s.arrest){const charge=seat.charge||0;this.\"'$('\"'arrest').innerHTML=\"'`<div class=\"arrest-panel\"><h2>CARDIAC ARREST</h2><p>${token('\"'Hold {charge}. Release both in gold.')}</p><div class=\\\"charge-track\\\"><div class=\\\"charge-gold\\\"></div><div class=\\\"charge-pointer\\\" style=\\\"left:\"'${Math.min(100,charge/1.8*100)}%\"></div></div><span class=\"arrest-count\">${s.arrestLeft.toFixed(1)}s</span>${s.entities.some(e=>e.kind==='\"'fermata'&&e.hp>0)?'<p class=\\\"gold\\\">Laser the exposed eye first.</p>':''}</div>\"'`;}else this.$('\"'arrest').innerHTML='';\n const tray=app.view?.project(1.67,-.44,.49);if(tray){this.\"'$('\"'tray-label').style.left=(tray.x-60)+'px';this.\"'$('\"'tray-label').style.top=tray.y+'px';this.\"'$('\"'tray-label').textContent=\"'`SPECIMENS · ${s.tray.length}`;}\n const active=s.entities.filter(e=>e.site===s.site&&!e.done&&e.marked&&e.required).slice(0,5);const labels=[];for(const e of active){let text='\"'';if(e.kind==='shard')text='PULL ↗';if(e.kind==='injection')text='ANTIDOTE';if(e.kind==='tremolo')text=e.pinned>0?'PINNED · LASER':'SLOW HANDS · SCAN';if(e.hp>0&&e.kind\"'!=='\"'tremolo')text=\"'`${e.kind.toUpperCase()} · ${Math.ceil(e.hp)}`;if(e.kind==='\"'legato')text=\"'`TAIL FIRST · ${e.remaining+1}`;if(e.kind==='\"'crescendo')text=e.exposed?'TRACE THE RING':'FOUR FEEDERS';if(text){const p=app.view?.project(e.x,e.y+.14);if(p&&p.visible)labels.push(\"'`<span class=\"target-label\" style=\"left:${p.x}px;top:${p.y}px\">${text}</span>`);}}\n this.$('\"'targets').innerHTML=labels.join('');this.\"'$('\"'tip-names').replaceChildren();if(s.seats.length>1)for(const t of s.seats){if(t.site\"'!==s.site)continue;const p=app.view?.project(t.x,t.y);if(p){const el=document.createElement('\"'span');el.className='tip-name';el.style.cssText=\"'`left:${p.x}px;top:${p.y}px;color:${t.color}`;el.textContent=t.name;this.$('\"'tip-names').append(el);}}\n this.\"'$('\"'debug').innerHTML=app.debugOverlay?\"'`<div class=\"debug-overlay\"><p>${app.view?.backend} / ${s.bpm.toFixed(1)} BPM / BEAT ${s.beat} / ${app.frameMs.toFixed(1)}ms<br>TIP ${seat.x.toFixed(3)}, ${seat.y.toFixed(3)} · USE ${seat.use.toFixed(2)}<br>${JSON.stringify(app.input.padStates.get(app.input.lastPad)?.axes||[])}</p></div>`:'\"'';this.ecg.draw(s);\n // Last Patient gives the room back to the patient.\n this.el.style.opacity=op.unfailing?'.0':'1';\n }\n}\nEOF\ncat > tools/build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport {readFileSync,writeFileSync,mkdirSync,copyFileSync} from 'node:fs';\nimport path from 'node:path';\nimport {GAME_TITLE,TAGLINE} from '../src/config/identity.js';\nconst exact={name:'one-three',setup(b){b.onResolve({filter:/\"'^three$/},()=>({path:path.resolve('\"'node_modules/three/build/three.webgpu.js')}));}};\nconst shared={bundle:true,minify:true,write:false,legalComments:'none',logLevel:'error',target:'es2022'};\nconst js=(await build({...shared,entryPoints:['src/main.js'],format:'esm',platform:'browser',plugins:[exact]})).outputFiles[0].text;\nconst css=(await build({...shared,entryPoints:['src/ui/ui.css'],loader:{'.woff2':'dataurl'}})).outputFiles[0].text;\nconst client=readFileSync('tools/vendor/session.js','utf8').replace(/\\\\r\\\\n/g,'\\\\n').trimEnd();\nconst about=readFileSync('src/data/about.json','utf8');\nconst esc=s=>s.replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst noCloser=s=>s.replace(/<\\\\/(script)/gi,'<\\\\\\\\/\"'$1'\"');\nconst html=['<\"'!doctype html>'\"','<html lang=\\\"en\\\" data-prompt-set=\\\"keyboard\\\">','<head>','<meta charset=\\\"utf-8\\\">','<script>',client,'</script>',\n'<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">',\"'`<title>${esc(GAME_TITLE)} — ${esc(TAGLINE)}</title>`,\n'\"'<meta name=\\\"description\\\" content=\\\"A rain-soaked surgical action drama. Eight instruments, seven engineered parasites, one shared heartbeat. Story and 1–4 player surgery.\\\">',\n'<meta name=\\\"theme-color\\\" content=\\\"#17707A\\\">','<meta name=\\\"hub:type\\\" content=\\\"Game\\\">','<meta name=\\\"hub:players\\\" content=\\\"1–4\\\">','<meta name=\\\"hub:source\\\" content=\\\"Trauma Center: Second Opinion\\\">',\n'<meta name=\\\"hub:session\\\" content=\\\"1\\\">','<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">','<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">','<meta name=\\\"hub:session-minutes\\\" content=\\\"6\\\">','<meta name=\\\"hub:session-goal\\\" content=\\\"Keep the patient alive and finish the operation together\\\">','<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: right stick or mouse · use: R2 or click · tools: left stick or 1-8\\\">',\n'<link rel=\\\"icon\\\" href=\\\"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect width=%2764%27 height=%2764%27 rx=%2712%27 fill=%27%2317707a%27/%3E%3Cpath d=%27M32 53 8 30C-2 10 22 4 32 18 42 4 66 10 56 30Z%27 fill=%27%23f2b134%27 stroke=%27%2312081a%27 stroke-width=%273%27/%3E%3Cpath d=%27M8 30h12l4-9 7 24 6-16h19%27 fill=%27none%27 stroke=%27%2312081a%27 stroke-width=%273%27/%3E%3C/svg%3E\\\">',\n'<style>',css,'</style>','</head>','<body>',\n'<div id=\\\"app\\\"><div id=\\\"screen\\\"></div><div id=\\\"hud\\\"></div><div id=\\\"overlays\\\"></div><div id=\\\"touch\\\"></div><div id=\\\"toast-layer\\\"></div></div>',\n'<div id=\\\"boot\\\" class=\\\"boot\\\"><div class=\\\"boot-ecg\\\"></div><h1>Scrubbing in…</h1><p>St. Alder Memorial / Operating Room 03</p></div>',\n'<script type=\\\"application/json\\\" id=\\\"about-data\\\">',noCloser(about),'</script>','<script type=\\\"module\\\">',noCloser(js),'</script>','</body>','</html>'].join('\\\\n');\nmkdirSync('dist',{recursive:true});writeFileSync('dist/game.html',html);\nconst filename=path.basename(process.cwd())+'.html';copyFileSync('dist/game.html',path.join('..',filename));\nEOF\ncat > tools/serve.mjs <<'EOF'\nimport http from 'node:http';\nimport {readFile} from 'node:fs/promises';\nimport path from 'node:path';\nconst server=http.createServer(async(req,res)=>{let file=decodeURIComponent(new URL(req.url,'http://local').pathname);if(file==='/')file='/dist/game.html';const p=path.resolve('.','.'+file);if(\"'!p.startsWith(process.cwd()+path.sep)){res.writeHead(403).end();return;}try{const data=await readFile(p);res.setHeader('\"'Content-Type',file.endsWith('.js')?'text/javascript':file.endsWith('.json')?'application/json':'text/html');res.end(data);}catch{res.writeHead(404).end('Not found');}});\nserver.listen(0,'127.0.0.1',()=>console.log(\"'`http://127.0.0.1:${server.address().port}`));\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"The shell now has the fixed tool wheel, ECG, patient charts, dialogue, reports, and controller prompts. Music, effects, and gibberish voices are synthesized in code, with music at 10% by default. I’m connecting the menus, saves, attract mode, dev tools, and co-op session flow.\n"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/app/director.js <<'EOF'\nimport {GAME_TITLE,TAGLINE} from '../config/identity.js';\nimport {defaults,groups,difficulty,tools,toolLabels} from '../config/tuning.js';\nimport {operations} from '../data/ops/index.js';\nimport {story,barkFor} from '../data/story/index.js';\nimport {cast,strainInfo} from '../data/cast.js';\nimport {Sim} from '../sim/sim.js';\nimport {botInput} from '../sim/bot.js';\nimport {rankTitles} from '../sim/scoring.js';\nimport {Input} from '../input/input.js';\nimport {renderTokens} from '../input/glyphs.js';\nimport {Focus} from '../ui/focus.js';\nimport {HUD,timeText} from '../ui/hud.js';\nimport {loadSave,writeSave,defaultSettings} from './save.js';\nimport {AudioEngine} from '../audio/engine.js';\nexport const esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst btn=(action,text,css='secondary',value='')=>\"'`<button class=\"${css}\" data-focus=\"${action}${value}\" data-action=\"${action}\" data-value=\"${value}\">${text}</button>`;\nconst names={title:'\"'Title',menu:'Main Menu',story:'Story',chart:'Chart',operation:'Operation',report:'Report',free:'Free Play',lobby:'Lobby',credits:'Credits roll',difficulty:'Difficulty','session-card':'Session card','session-end':'Session ended'};\nconst chapters=['','Scrub In','First Movement','Dissent','Coda'];\nexport class App{\n constructor({view=null,params=new URLSearchParams(location.search),session=false}={}){\n this.view=view;this.params=params;this.inSession=session;this.save=session?{progress:0,best:{},settings:{...defaultSettings}}:loadSave();this.settings=this.save.settings;this.tuning={...defaults,tipSpeed:this.settings.tipSpeed,aimAssist:this.settings.aimAssist};this.audio=new AudioEngine(this.settings);\n this.screen='title';this.overlay=null;this.returnOverlay=null;this.reached=new Set(['Title']);this.lastActivity=performance.now();this.lastPump=performance.now();this.acc=0;this.warp=1;this.timeScale=1;this.frameMs=0;this.bot=false;this.attract=false;this.attractIndex=-1;this.sim=null;this.externalState=null;this.localId=0;this.level='normal';this.consult='careful';this.freeDoctor='ren';this.modeFree=false;this.page=0;this.aboutPage=0;this.settingsPage=0;this.devPage=0;this.freePage=0;this.lobby=[];this.virtual={};this.bark='Steady hands, Doctor.';this.hintUntil=0;this.debugOverlay=false;this.storyLine=0;this.charCount=0;this.storyNext=null;this.storyId='S1';this.lastStoryAdvance=0;this.testBotOptions={};this.ended=false;this.siteCooldown=0;this.sessionData=null;\n this.touchOnly=\"'!matchMedia('\"'(any-pointer: fine)').matches;this.notice=this.touchOnly&&\"'!session;\n this.screenEl=document.getElementById('\"'screen');this.hudEl=document.getElementById('hud');this.overlayEl=document.getElementById('overlays');this.touchEl=document.getElementById('touch');this.toastEl=document.getElementById('toast-layer');\n this.focus=new Focus(document.getElementById('app'),()=>this.audio.effect('move',.4));\n this.input=new Input({onAction:(...args)=>this.action(...args),onActivity:kind=>this.activity(kind),getMode:()=>this.overlay||this.screen,aim:(x,y)=>view?.screenToField(x,y)||{x:(x/innerWidth-.5)*3,y:(.5-y/innerHeight)*2},settings:()=>this.settings});\n document.getElementById('app').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled){e.stopPropagation();this.execute(b.dataset.action,b.dataset.value);}});\n document.getElementById('\"'app').addEventListener('input',e=>this.change(e.target));document.getElementById('app').addEventListener('change',e=>this.change(e.target));\n document.getElementById('app').addEventListener('pointerdown',e=>{const b=e.target.closest('[data-hold]');if(b){e.preventDefault();this.virtual[b.dataset.hold]=true;}});addEventListener('pointerup',()=>this.virtual={});\n document.addEventListener('visibilitychange',()=>{if(document.hidden&&\"'!this.inSession&&!this.attract&&(this.screen==='\"'operation'||this.screen==='story')&&\"'!this.overlay)this.pause();});\n this.hud=new HUD(this.hudEl,this);this.render();this.expose();\n }\n tokens(s){return renderTokens(s,this.input.prompt,this.settings.glyphs);}\n activity(kind){if(this.ended)return;this.audio.unlock();this.lastActivity=performance.now();if(this.attract){this.exitAttract();this.ignoreInputUntil=performance.now()+100;return;}if(this.notice&&(kind==='\"'keyboard'||kind==='pad')){this.notice=false;this.touchOnly=false;this.renderTouch();this.setScreen('title');}if(kind==='pad'&&this.audio.ctx?.state==='suspended'&&this.screen==='title')this.soundNotice=true;}\n state(){const s=this.sim?.state||this.externalState;const seat=s?.seats.find(x=>x.id===this.localId)||s?.seats[0];return{screen:this.notice&&\"'!this.overlay?'\"'Touch notice':this.overlay?({pause:'Pause',fail:'Fail',settings:'Settings',about:'About',dev:'Dev Mode',strain:'Strain card'}[this.overlay]||this.overlay):names[this.screen]||this.screen,op:s?.op??this.chartOp??null,phase:s?.phase??0,vitals:s?.vitals??100,timer:s?.timer??0,score:s?.score??0,rank:s?.rank??null,bpm:s?.bpm??64,beat:s?.beat??0,site:s?.site??0,tool:seat?.tool??this.input.tool,tips:s?.seats.map(x=>({id:x.id,x:x.x,y:x.y,tool:x.tool,use:x.use,site:x.site,score:x.score}))||[],focusId:this.focus.id,promptSet:this.input.prompt,glyphSet:this.settings.glyphs,attract:this.attract,devOpen:this.overlay==='dev',renderBackend:this.view?.backend||'none',musicGain:this.audio.musicGain,tuning:{...this.sim?.tuning||this.tuning},reached:[...this.reached],status:s?.status||'menu',storyId:this.storyId,storyLine:this.storyLine,progress:this.save.progress,notes:\"'!!s?.notes};}\n expose(){const api={state:()=>this.state()};if(this.params.get('\"'test')==='1'){api.test={step:n=>{for(let i=0;i<n;i++){if(this.sim&&this.screen==='operation'&&\"'!this.overlay){this.simStep();if(this.sim?.state.status!=='\"'playing')break;}}this.hudUpdate();return this.state();},warp:n=>this.warp=Math.max(1,n),input:f=>this.input.override=f,bot:(on,opts={})=>{this.bot=on;this.testBotOptions=opts;},skipTo:(op,phase)=>{this.startOperation(Number(op),true);this.sim.skipTo(Number(phase));this.clearOverlay();this.hudUpdate();},hash:()=>this.sim?.hash(),idle:ms=>this.lastActivity=performance.now()-ms,dev:(id,value)=>this.devAction(id,value),getState:()=>structuredClone(this.sim?.state),setVitals:n=>{if(this.sim)this.sim.state.vitals=n;},audio:this.audio};}window.__game=api;}\n setScreen(screen){this.screen=screen;this.reached.add(names[screen]||screen);this.overlay=null;this.view?.setMode(screen);this.render();}\n header(text,right=''){return\"'`<div class=\"page-head\"><div><div class=\"eyebrow gold\">ST. ALDER / OR 03</div><h2>${text}</h2></div>${right||btn('\"'back','← Back','back-btn')}</div>\"'`;}\n footer(text='\"''){return\"'`<div class=\"bottom-bar\"><span>${this.tokens('\"'{confirm} Select · {back} Back')}</span><span class=\\\"muted\\\">\"'${text}</span></div>`;}\n logo(){const [first,...rest]=GAME_TITLE.split('\"':');return\"'`${esc(first)}${rest.length?`<span>${esc(rest.join('\"':'))}</span>\"'`:'\"''}\"'`;}\n render(){const el=this.screenEl;this.hudEl.style.display=this.screen==='\"'operation'?'block':'none';el.innerHTML='';\n switch(this.screen){\n case'title':el.innerHTML=\"'`<main class=\"screen title-screen\"><div class=\"top-brand\"><div class=\"hospital\"><span class=\"cross\">✚</span><span class=\"eyebrow\">ST. ALDER MEMORIAL</span></div><span class=\"small muted\">PORT CALLOWAY / 02:17</span></div><div class=\"title-content\"><h1 class=\"title-logo\">${this.logo()}</h1><p class=\"title-tag\">${esc(TAGLINE)}</p>${btn('\"'enter','Scrub in <span>↗</span>','primary title-start')}</div><div class=\\\"title-index\\\"><strong>03</strong><span>Operating theatre</span></div><div class=\\\"bottom-bar\\\"><span class=\\\"key-row\\\">\"'${this.tokens('\"'{confirm} Press any button')}</span><span class=\\\"signal small\\\">\"'${this.save.progress?'\"'SHIFT RECORD FOUND':'NIGHT SHIFT / SINGLE PLAYER + CO-OP'}</span></div>\"'${this.soundNotice?'\"'<div class=\\\"sound-note\\\">Press any key or click for sound</div>':''}<div class=\\\"ink-texture\\\"></div></main>\"'`;this.audio.setTrack('\"'title');break;\n case'menu':el.innerHTML=\"'`<main class=\"screen main-screen\"><div class=\"top-brand\"><div class=\"main-logo comic\">${esc(GAME_TITLE)}</div><span class=\"eyebrow muted\">NIGHT SHIFT / 03</span></div><div class=\"menu-panel\"><div class=\"eyebrow gold\">YOUR HANDS. THEIR HEARTBEAT.</div><h2>Clock in, Doctor.</h2><nav class=\"menu-list\">${[['\"'storyMenu','Story'],['free','Free Play'],['lobby','Grand Rounds'],['settings','Settings'],['about','About & Credits']].map(([id,label],i)=>btn(id,\"'`<span class=\"num\">0${i+1}</span>${label}<span class=\"arrow\">↗</span>`,'\"'menu-item')).join('')}</nav><div class=\\\"chapter-tag\\\">\"'${this.save.progress?`CHAPTER ${operations[Math.min(6,this.save.progress)].chapter} / ${chapters[operations[Math.min(6,this.save.progress)].chapter]}`:'\"'A SURGICAL ACTION DRAMA'}</div><p class=\\\"menu-note\\\">\"'${this.save.progress?'\"'A chart is waiting where you left it.':'Eight instruments. Seven strains. One second chance.'}</p></div><div class=\\\"room-tag\\\"><span class=\\\"muted\\\">THE ROOM IS QUIET.</span><b>FOR NOW.</b></div>\"'${this.footer('\"'1–4 SURGEONS / CONTROLLER RECOMMENDED')}</main>\"'`;break;\n case'\"'difficulty':el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'First, a question.')}<div class=\\\"menu-panel\\\" style=\\\"width:55%;max-width:54rem\\\"><p>“How much do you hate yourself, child?”</p><p class=\\\"muted small\\\" style=\\\"margin:1rem 0 2rem\\\">You can change this on any patient chart.</p><nav class=\\\"menu-list\\\">\"'${Object.entries(difficulty).map(([id,d])=>btn('\"'difficulty',\"'`<span>${d.label}</span><span class=\"small\">${id==='\"'easy'?'More time. Gentler hands.':id==='normal'?'The intended night shift.':'Less room for error.'}</span>\"'`,'\"'menu-item',id)).join('')}</nav></div>\"'${this.footer('\"'BEA OKONKWO / HEAD NURSE')}</main>\"'`;break;\n case'\"'story':{const data=story[this.storyId],line=data.lines[this.storyLine];el.innerHTML=\"'`<main class=\"screen story-screen\"><div class=\"story-top\"><span class=\"scene-title\">${esc(data.title)}</span>${btn('\"'skip',this.tokens('{special} / Tab Skip scene'),'back-btn')}</div><div class=\\\"dialogue-box\\\" data-action=\\\"advance\\\"><span class=\\\"speaker-tag\\\" style=\\\"background:\"'${cast[line.who].color}\">${esc(cast[line.who].name)}</span><div class=\"dialogue ${line.shout?'\"'shout':''}\\\" id=\\\"dialogue-text\\\"></div><span class=\\\"advance-prompt\\\">\"'${this.tokens('\"'{confirm} Continue')} ▸</span></div><span class=\\\"story-line-count\\\">\"'${String(this.storyLine+1).padStart(2,'\"'0')} / \"'${data.lines.length} · HOLD TO FAST-FORWARD</span></main>`;break;}\n case'\"'chart':{const op=operations[this.chartOp];el.innerHTML=\"'`<main class=\"screen chart-screen\"><div class=\"top-brand\"><span class=\"eyebrow\">${this.chartOp===8?'\"'WARD ZERO / TEAM CHART':\"'`CHAPTER ${op.chapter} / ${chapters[op.chapter]}`}</span>${btn('\"'back','← Chart board','back-btn')}</div><article class=\\\"chart\\\"><div class=\\\"chart-id\\\"><span>CONFIDENTIAL / PATIENT RECORD</span><span>SA–\"'${String(this.chartOp+1).padStart(3,'\"'0')}</span></div><h2>\"'${esc(op.patient.name)}</h2><p class=\"chart-job\">${op.patient.age} years · ${esc(op.patient.job)}</p><p class=\"chart-note\">${esc(op.patient.note)}</p><div class=\"chart-operation\"><span>PROCEDURE ${String(this.chartOp+1).padStart(2,'\"'0')}</span><strong class=\\\"comic\\\">\"'${esc(op.title)}</strong><span>${op.timer?timeText(op.timer):'\"'UNTIMED'}</span></div><div class=\\\"chart-controls\\\"><label>Difficulty<select data-setting=\\\"level\\\" data-focus=\\\"chartLevel\\\">\"'${Object.entries(difficulty).map(([id,d])=>`<option value=\"${id}\" ${id===this.level?'\"'selected':''}>\"'${d.label}</option>`).join('\"'')}</select></label><label>Lead surgeon<select data-setting=\\\"doctor\\\" data-focus=\\\"chartDoctor\\\"><option value=\\\"ren\\\" \"'${this.freeDoctor==='\"'ren'?'selected':''}>Dr. Halloran / The Hush</option><option value=\\\"ines\\\" \"'${this.freeDoctor==='\"'ines'?'selected':''}>Dr. Varga / Sforzando</option></select></label></div>\"'${op.consult?`<div class=\"consult-options\">${btn('\"'consult','Halloran · Careful <span>+60s / gentler drain</span>',\"'`consult-btn ${this.consult==='\"'careful'?'active':''}\"'`,'\"'careful')}\"'${btn('\"'consult','Varga · Aggressive <span>Faster tools / ×1.15 score</span>',\"'`consult-btn ${this.consult==='\"'aggressive'?'active':''}\"'`,'\"'aggressive')}</div>\"'`:'\"''}\"'${btn('\"'begin','Begin procedure <span>↗</span>','primary')}</article>\"'${this.footer('\"'COUNT YOUR INSTRUMENTS. BREATHE.')}</main>\"'`;break;}\n case'\"'operation':break;\n case'report':{const s=this.sim.state,op=this.sim.op;el.innerHTML=\"'`<main class=\"screen report-screen\"><article class=\"report-paper\"><span class=\"eyebrow\" style=\"color:#4e706d\">OPERATIVE REPORT / ${String(s.op+1).padStart(2,'\"'0')}</span><h2>\"'${op.unfailing?'\"'Patient survived.':'Patient stable.'}</h2>\"'${s.rank?`<div class=\"report-rank\">${s.rank}</div>`:'\"''}<div class=\\\"report-subtitle\\\">\"'${s.rank?rankTitles[s.rank]:esc(op.patient.name)}${s.notes?'\"' · BEA’S NOTES / ASSISTED':''}</div><div class=\\\"report-stats\\\">\"'${[['\"'Time',timeText(s.elapsed)],['Vitals',Math.ceil(s.vitals)+'%'],['Precision',Math.round((s.actions-s.misses)/Math.max(1,s.actions)*100)+'%'],['Best Combo',s.bestCombo]].map(([l,v])=>\"'`<div class=\"report-stat\"><strong>${v}</strong><span>${l}</span></div>`).join('\"'')}</div><p>\"'${esc(op.patient.followUp)}</p>${s.seats.length>1?`<div class=\"team-stats\">${s.seats.map(x=>`<span class=\"seat-chip\" style=\"color:${x.color}\">${esc(x.name)} · ${x.score} · ${x.stats.Stitches} stitches</span>`).join('\"'')}</div>\"'`:'\"''}<div class=\\\"report-subtitle\\\">\"'${s.rank?`SCORE ${s.score.toLocaleString()} · ${s.misses===0?'\"'NO MISSES':s.misses+' MISSES'}\"'`:'\"'Tonight’s patient survived.'}</div>\"'${btn('\"'continueReport','Continue <span>↗</span>','primary')}</article></main>\"'`;break;}\n case'\"'free':{const unlocked=operations.slice(0,Math.min(7,this.save.progress+1)),visible=unlocked.slice(this.freePage*6,this.freePage*6+6);el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'The chart board.')}<p class=\\\"muted\\\">\"'${unlocked.length} procedures reached · Your best work is stamped here.</p><div class=\"free-grid\">${visible.map(op=>{const i=operations.indexOf(op);return btn('\"'selectOp',\"'`<span class=\"eyebrow small\">PROCEDURE ${String(i+1).padStart(2,'\"'0')}</span><span class=\\\"rank-chip\\\">\"'${this.save.best[op.id]||'\"'—'}</span><h3>\"'${op.title}</h3><p>${esc(op.patient.name)}</p>`,'\"'patient-card',i);}).join('')}</div>\"'${this.footer(`${this.freePage+1} / ${Math.max(1,Math.ceil(unlocked.length/6))} · Q / E PAGES`)}</main>`;break;}\n case'\"'lobby':el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'Grand Rounds.')}<p class=\\\"muted\\\">One patient. Four pairs of hands. \"'${this.tokens('\"'Press {confirm} to join.')}</p><div class=\\\"lobby-seats\\\">\"'${Array.from({length:4},(_,i)=>{const seat=this.lobby[i];return`<div class=\"seat-card ${seat?'\"'joined':''}\\\" style=\\\"\"'${seat?'\"'border-color:'+seat.color:''}\\\"><div class=\\\"seat-number\\\" style=\\\"\"'${seat?'\"'color:'+seat.color:''}\\\">0\"'${i+1}</div><h3>${seat?esc(seat.name):'\"'Scrub in.'}</h3><p>\"'${seat?(i%2?'\"'Sforzando':'The Hush'):'Controller or keyboard'}</p><p class=\\\"muted\\\">\"'${seat?'\"'READY':'AWAITING SURGEON'}</p></div>\"'`;}).join('\"'')}</div><div class=\\\"tabs\\\">\"'${btn('\"'join','Join with keyboard','secondary')}\"'${btn('\"'startCoop','Start procedure ↗','primary')}</div>\"'${this.footer('\"'L1 / R1 OR Q / E CHANGES THE SHARED SITE')}</main>\"'`;break;\n case'\"'credits':el.innerHTML=\"'`<main class=\"screen\"><div class=\"credits\"><div class=\"eyebrow\">ST. ALDER MEMORIAL</div><h2>Good hands, child.</h2><p>${esc(TAGLINE)}</p><div class=\"rule\" style=\"width:50%\"></div><p>An original surgical action drama<br>Built with Three.js & Rapier<br>Music, voices and art made in code</p><p class=\"muted small\">OpenAI · gpt-6.1-sol · reasoning effort max<br>Bangers & Barlow Condensed · OFL</p>${btn('\"'finishCredits','End shift ↗','primary')}<span class=\\\"small gold\\\">A new envelope. Opus 2.</span></div></main>\"'`;this.audio.setTrack('\"'credits');break;\n case'session-card':this.renderSessionCard();break;\n case'session-end':el.innerHTML=\"'`<main class=\"screen main-screen\"><div class=\"session-intro\"><h2>Shift concluded.</h2><p class=\"muted\">${esc(this.endReason||'\"'The hub is preparing your results.')}</p></div></main>\"'`;break;\n }\n this.renderTouch();this.renderOverlay();this.focus.reset();\n }\n renderTouch(){this.touchEl.innerHTML=this.notice&&!this.overlay?`<aside class=\"touch-notice\"><div class=\"touch-icon\">✕ ○ □ △</div><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to scrub in.<br>The night shift will play itself in a moment.</p>${btn('\"'settings','Settings','secondary')}</aside>\"'`:'\"'';if(this.notice)this.reached.add('Touch notice');}\n renderOverlay(){const el=this.overlayEl;el.innerHTML='';if(\"'!this.overlay)return;this.reached.add({pause:'\"'Pause',fail:'Fail',settings:'Settings',about:'About',dev:'Dev Mode',strain:'Strain card'}[this.overlay]||this.overlay);const shade='<div class=\\\"overlay-shade\\\"></div>';\n if(this.overlay==='pause'){const isStory=this.screen==='story';el.innerHTML=shade+\"'`<section class=\"modal narrow\"><div class=\"eyebrow gold\">TAKE A BREATH</div><h2>On standby.</h2><nav class=\"menu-list\">${btn('\"'resume','Resume','menu-item')}\"'${isStory?btn('\"'skip','Skip scene','menu-item'):btn('retry','Retry phase','menu-item')}\"'${!isStory?btn('\"'restart','Restart operation','menu-item'):''}\"'${btn('\"'settings','Settings','menu-item')}\"'${btn('\"'dev','Dev Mode','menu-item')}\"'${btn('\"'quit','Quit to menu','menu-item')}</nav></section>\"'`;}\n if(this.overlay==='\"'storyMenu')el.innerHTML=shade+\"'`<section class=\"modal narrow\"><span class=\"eyebrow gold\">YOUR SHIFT RECORD</span><h2>Story.</h2><nav class=\"menu-list\">${this.save.progress?btn('\"'continueStory','Continue','menu-item'):''}\"'${btn('\"'newGame','New game','menu-item')}\"'${btn('\"'back','Back','menu-item')}</nav></section>\"'`;\n if(this.overlay==='\"'fail'){const s=this.sim.state;el.innerHTML=shade+\"'`<section class=\"modal narrow\"><span class=\"eyebrow\">PROCEDURE INTERRUPTED</span><h2 class=\"fail-heading\">${s.reason}</h2><p class=\"fail-message\">${esc(barkFor('\"'fail',s.tick))}</p><nav class=\\\"menu-list\\\">\"'${btn('\"'retry','Retry phase','menu-item')}\"'${btn('\"'restart','Restart operation','menu-item')}\"'${btn('\"'quit','Quit','menu-item')}</nav>\"'${(this.sim.failures[s.phase]||0)>=1?btn('\"'notes','Bea’s Notes · +30% time, −30% drain.<br>Assisted rank capped at B.','notes-offer'):''}</section>\"'`;}\n if(this.overlay==='\"'settings')el.innerHTML=shade+this.settingsHTML();\n if(this.overlay==='about')el.innerHTML=shade+this.aboutHTML();\n if(this.overlay==='dev')el.innerHTML=shade+this.devHTML();\n if(this.overlay==='strain'){const info=strainInfo[this.strain];el.innerHTML=\"'`<button class=\"strain-card\" data-action=\"dismissStrain\" data-focus=\"strain\"><div class=\"eyebrow\">REQUIEM / FIELD IDENTIFICATION</div><h2>${info.name}</h2><p><em>${info.definition}</em></p><p>${info.aside}</p><div class=\"rule\"></div><p class=\"small\">${info.hint}</p><span class=\"card-continue\">${this.tokens('\"'{confirm} Continue')}</span></button>\"'`;}\n this.renderTouch();this.focus.reset();\n }\n settingsHTML(){const page=this.settingsPage,tabs=['\"'Audio','Controls','Display'];let rows='';const range=(id,name,min,max,step,value,format)=>\"'`<div class=\"setting-row\" data-focus=\"setting${id}\"><label for=\"set-${id}\">${name}<output id=\"out-${id}\">${format?format(value):value}</output></label><input id=\"set-${id}\" data-setting=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" aria-label=\"${name}\"></div>`;\n const toggle=(id,name)=>`<div class=\"setting-row\" data-focus=\"setting${id}\"><label>${name}</label><select data-setting=\"${id}\" aria-label=\"${name}\"><option value=\"true\" ${this.settings[id]?'\"'selected':''}>On</option><option value=\\\"false\\\" \"'${!this.settings[id]?'\"'selected':''}>Off</option></select></div>\"'`;\n if(page===0)rows=[['\"'music','Music'],['sfx','Effects'],['voice','Voices']].map(([id,n])=>range(id,n,0,1,.05,this.settings[id],v=>Math.round(v*100)+'%')).join('');\n if(page===1)rows=\"'`<div class=\"setting-row\" data-focus=\"settingglyphs\"><label>Button glyphs</label><select data-setting=\"glyphs\" aria-label=\"Button glyphs\"><option value=\"playstation\" ${this.settings.glyphs==='\"'playstation'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${this.settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div>\"'${toggle('\"'rumble','Controller rumble')}\"'${range('\"'aimAssist','Aim assist',0,1,.05,this.settings.aimAssist,v=>Math.round(v*100)+'%')}\"'${toggle('\"'swapSticks','Swap sticks')}\"'${range('\"'tipSpeed','Tip speed',.8,3.5,.1,this.settings.tipSpeed,v=>Number(v).toFixed(1))}\"'`;\n if(page===2)rows=`<div class=\"setting-row\"><label>Fullscreen</label>${btn('\"'fullscreen',document.fullscreenElement?'Windowed':'Enter fullscreen','secondary')}</div>\"'${toggle('\"'shake','Screen shake')}\"'${toggle('\"'lineBoil','Line boil')}\"'${range('\"'textSpeed','Text speed',.5,3,.25,this.settings.textSpeed,v=>v+'×')}\"'`;\n return`<section class=\"modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">MAKE YOURSELF AT HOME</span><h2>Settings.</h2></div>${btn('\"'back','Done','back-btn')}</div><div class=\\\"tabs\\\">\"'${tabs.map((t,i)=>btn('\"'settingsPage',t,\"'`tab ${i===page?'\"'active':''}\"'`,i)).join('\"'')}</div><div class=\\\"settings-list\\\">\"'${rows}</div><div class=\"modal-footer\"><span class=\"small muted\">${page===0?'\"'All sound is synthesized. No recordings.':page===1?'Standard controllers · Both sticks are yours.':'A comfortable shift is a steady shift.'}</span><span class=\\\"key-row\\\">\"'${this.tokens('\"'{prev} / {next} Page')}</span></div></section>\"'`;\n }\n aboutPages(){let data;try{data=JSON.parse(document.getElementById('\"'about-data').textContent);}catch{data={sourceInformation:{source:'unknown'},testingFeedback:['unknown'],engineFeedback:['unknown'],promptFeedback:['unknown']};}const pages=[];const labels={sourceInformation:'Source Information',testingFeedback:'Testing Feedback',engineFeedback:'Engine Feedback',promptFeedback:'Prompt Feedback'};for(const [block,title]of Object.entries(labels)){const entries=Array.isArray(data[block])?data[block].map((x,i)=>[String(i+1).padStart(2,'0'),x]):Object.entries(data[block]||{});for(let i=0;i<entries.length;i+=3)pages.push({title,entries:entries.slice(i,i+3)});}pages.push({title:'Credits',entries:[['Built by','OpenAI · gpt-6.1-sol · reasoning effort max'],['Engine & type','Three.js r180 · Rapier 0.19.3 · Bangers & Barlow Condensed, SIL OFL'],['This session',\"'`Renderer: ${this.view?.backend||'\"'unknown'} · AI Hub client 1.4.0\"'`]]});return pages;}\n aboutHTML(){const pages=this.aboutPages(),page=pages[this.aboutPage%pages.length];return`<section class=\"modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">ABOUT & CREDITS</span><h2>${page.title}</h2></div>${btn('\"'back','Close','back-btn')}</div><div class=\\\"rule\\\"></div><div class=\\\"about-body\\\">\"'${page.entries.map(([k,v])=>`<p class=\"about-field ${String(v).length>150?'\"'long':''}\\\"><b>\"'${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase()))}</b><br>${esc(v)}</p>`).join('\"'')}</div><div class=\\\"modal-footer\\\">\"'${btn('\"'aboutPrev',this.tokens('{prev} Previous'),'secondary')}<span class=\\\"page-count\\\">\"'${this.aboutPage+1} / ${pages.length}</span>${btn('\"'aboutNext',this.tokens('Next {next}'),'secondary')}</div></section>\"'`;}\n devPages(){const p=[{title:'\"'Jump',type:'jump'},{title:'Actions',type:'actions'},{title:'Cheats',type:'cheats'},{title:'Spawn',type:'spawn'},{title:'View',type:'view'}];for(const [name,values]of Object.entries(groups))for(let i=0;i<values.length;i+=5)p.push({title:name+(values.length>5?' '+(i/5+1):''),type:'sliders',values:values.slice(i,i+5)});return p;}\n devHTML(){const pages=this.devPages(),p=pages[this.devPage%pages.length];const s=this.sim?.state;const action=(id,text,value='')=>btn('devAction',text,'secondary',id+(value?'|'+value:''));let content='';\n if(p.type==='jump')content=\"'`<div><div class=\"setting-row\"><label>Operation</label><select data-dev=\"op\" aria-label=\"Operation\">${operations.map((o,i)=>`<option value=\"${i}\" ${s?.op===i?'\"'selected':''}>\"'${i+1} · ${o.title}</option>`).join('\"'')}</select></div><div class=\\\"setting-row\\\"><label>Phase</label><select data-dev=\\\"phase\\\" aria-label=\\\"Phase\\\">\"'${(this.sim?.op||operations[0]).phases.map((q,i)=>`<option value=\"${i}\" ${s?.phase===i?'\"'selected':''}>\"'${i+1} · ${q.id}</option>`).join('\"'')}</select></div><div class=\\\"setting-row\\\"><label>Story</label><select data-dev=\\\"scene\\\" aria-label=\\\"Story scene\\\">\"'${Object.entries(story).map(([id,x])=>`<option value=\"${id}\">${id} · ${x.title}</option>`).join('\"'')}</select></div></div><div class=\\\"dev-controls\\\">\"'${action('\"'jump','Jump to selected phase')}\"'${action('\"'unlock','Unlock chart board')}\"'${action('\"'story','Play selected scene')}</div>\"'`;\n if(p.type==='\"'actions')content=\"'`<div class=\"dev-controls\">${[['\"'objective','Complete objective'],['phase','Complete phase'],['win','Win operation'],['fail','Fail operation'],['rank','Force S rank'],['step','Single step']].map(([id,t])=>action(id,t)).join('')}</div><div><p class=\\\"muted\\\">The simulation is paused while this panel is open.</p><p class=\\\"dev-values\\\" style=\\\"margin-top:1rem\\\">\"'${s?`Operation ${s.op+1} / phase ${s.phase+1}<br>Tick ${s.tick} / vitals ${s.vitals.toFixed(2)}<br>World hash ${this.sim.hash()}`:'\"'Story stage'}</p></div>\"'`;\n if(p.type==='\"'cheats')content=\"'`<div class=\"dev-controls\">${[['\"'god','Lock vitals'],['freezeTimer','Freeze timer'],['infiniteComposure','Infinite composure'],['infiniteClamps','Infinite clamps'],['bot','Auto Surgeon']].map(([id,t])=>action(id,\"'`${t} · ${(id==='\"'bot'?this.bot:this.sim?.cheats[id])?'ON':'OFF'}\"'`)).join('\"'')}</div><div><div class=\\\"setting-row\\\"><label>Time scale <output>\"'${this.timeScale}×</output></label><input data-dev=\"timeScale\" type=\"range\" min=\".1\" max=\"4\" step=\".1\" value=\"${this.timeScale}\" aria-label=\"Time scale\"></div>${action('\"'resetCheats','Reset cheats')}</div>\"'`;\n if(p.type==='\"'spawn')content=\"'`<div class=\"dev-controls\">${[['\"'bleeder','Bleeder at tip'],['arrest','Cardiac arrest'],['fortissimo','Fortissimo'],['hush','The Hush'],['sforzando','Sforzando']].map(([id,t])=>action(id,t)).join('')}</div><div><div class=\\\"setting-row\\\"><label>Strain</label><select data-dev=\\\"strain\\\" aria-label=\\\"Strain\\\">\"'${Object.entries(strainInfo).map(([id,x])=>`<option value=\"${id}\">${x.name}</option>`).join('\"'')}</select></div>\"'${action('\"'strain','Spawn selected strain')}</div>\"'`;\n if(p.type==='\"'view')content=\"'`<div class=\"dev-controls\">${[['\"'debug','Grid / colliders / input'],['ink','Ink outlines'],['halftone','Manga halftone'],['lineBoil','Line boil'],['shadows','Shadows']].map(([id,t])=>action(id,\"'`${t} · ${(id==='\"'debug'?this.debugOverlay:this.settings[id])?'ON':'OFF'}\"'`)).join('\"'')}</div><div><p class=\\\"dev-values\\\">\"'${this.view?.backend||'\"'none'}<br>Beat \"'${s?.beat||0} / ${(s?.bpm||64).toFixed(1)} BPM<br>Last render interval ${this.frameMs.toFixed(1)}ms<br>Input ${this.input.prompt}</p></div>`;\n if(p.type==='\"'sliders')content=\"'`<div class=\"settings-list\" style=\"grid-column:1/-1\">${p.values.map(([id,v,min,max])=>`<div class=\"setting-row\" data-focus=\"tune${id}\"><label>${id}<output id=\"tune-out-${id}\">${(this.sim?.tuning[id]??this.tuning[id]).toFixed(3)} <span class=\"muted\">/ default ${v}</span></output></label><input data-tuning=\"${id}\" aria-label=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${max<=1?.005:.05}\" value=\"${this.sim?.tuning[id]??this.tuning[id]}\" list=\"default-${id}\"><datalist id=\"default-${id}\"><option value=\"${v}\"></datalist></div>`).join('\"'')}</div>\"'`;\n return`<section class=\"modal dev-modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">WARD ZERO / DEVELOPER TOOLS</span><h2>${p.title}</h2></div>${btn('\"'back','Back to pause','back-btn')}</div><div class=\\\"dev-content\\\">\"'${content}</div><div class=\"modal-footer\">${btn('\"'devPrev',this.tokens('{prev} Previous'),'secondary')}<span class=\\\"page-count\\\">\"'${this.devPage+1} / ${pages.length}</span>${btn('\"'resetPage','Reset page','secondary')}\"'${btn('\"'resetAll','Reset all','secondary')}\"'${btn('\"'devNext',this.tokens('Next {next}'),'secondary')}</div></section>\"'`;\n }\n action(action,value,extra){if(this.ended||performance.now()<(this.ignoreInputUntil||0))return;if(this.inSession&&this.sessionData){if(this.screen==='\"'session-card'){if(action==='confirm')this.sessionData.answer('ready');if(action==='more')this.sessionData.answer('more');return;}if(action==='pause'||action==='back'&&\"'!this.overlay){this.openSettings();return;}}\n if(this.overlay==='\"'strain'){if(action==='confirm'||action==='back'||action==='skip')this.execute('dismissStrain');return;}\n if(action==='disconnect'){if(\"'!this.inSession)this.pause();return;}\n if(this.overlay){if(action==='\"'back')this.back();else if(action==='nav')this.focus.move(value);else if(action==='confirm')this.focus.confirm();else if(action==='horizontal')this.focus.adjust(value);else if(action==='page')this.changePage(value);return;}\n if(this.notice){if(action==='confirm'&&typeof value==='number'){this.notice=false;this.render();}return;}\n if(this.screen==='title'){if(action==='confirm'||action==='any')this.setScreen('menu');return;}\n if(this.screen==='story'){if(action==='confirm')this.advanceStory();else if(action==='skip'||action==='more')this.skipStory();else if(action==='back')this.pause();return;}\n if(this.screen==='operation'){if(action==='pause'||action==='back')this.pause();if(action==='tool')this.setTool(value);if(action==='site')this.changeSite(value,extra);if(action==='hint')this.showHint();return;}\n if(this.screen==='lobby'&&action==='confirm'){this.join(value);return;}\n if(action==='back')this.back();else if(action==='nav')this.focus.move(value);else if(action==='confirm')this.focus.confirm();else if(action==='horizontal')this.focus.adjust(value);else if(action==='page')this.changePage(value);\n }\n execute(id,value){if(this.ended)return;this.activity(this.input.prompt);this.audio.effect('confirm',.45);\n switch(id){case'enter':this.setScreen('menu');break;case'back':this.back();break;case'storyMenu':this.overlay='storyMenu';this.renderOverlay();break;case'newGame':this.setScreen('difficulty');break;case'difficulty':this.level=value;this.save.progress=0;this.save.best={};this.modeFree=false;this.startStory('S0',()=>this.beforeOperation(0));break;case'continueStory':this.modeFree=false;this.showChart(Math.min(7,this.save.progress));break;case'free':this.modeFree=true;this.freePage=0;this.setScreen('free');break;case'selectOp':this.modeFree=true;this.showChart(+value);break;case'consult':this.consult=value;this.render();this.focus.set('consult'+value,false);break;case'begin':this.startOperation(this.chartOp,this.modeFree);break;case'continueReport':this.continueReport();break;case'advance':this.advanceStory();break;case'skip':this.skipStory();break;case'pause':this.pause();break;case'resume':this.clearOverlay();break;case'retry':this.sim?.retry();this.clearOverlay();break;case'notes':this.sim?.retry(true);this.clearOverlay();break;case'restart':if(\"'!this.inSession){const op=this.sim?.state.op??this.chartOp??0;this.startOperation(op,this.modeFree);}break;case'\"'quit':if(\"'!this.inSession){this.sim?.free();this.sim=null;this.setScreen('\"'menu');}break;case'settings':this.openSettings();break;case'about':this.aboutPage=0;this.overlay='about';this.renderOverlay();break;case'settingsPage':this.settingsPage=+value;this.renderOverlay();break;case'aboutPrev':this.changePage(-1);break;case'aboutNext':this.changePage(1);break;case'devPrev':this.changePage(-1);break;case'devNext':this.changePage(1);break;case'fullscreen':if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{});else document.documentElement.requestFullscreen?.().catch(()=>this.toast('Fullscreen is unavailable in this browser.'));break;case'lobby':this.lobby=[];this.setScreen('lobby');break;case'join':this.join('keyboard');break;case'startCoop':this.startCoop();break;case'tool':this.setTool(+value);break;case'siteDirect':this.setSite(+value);break;case'special':if(this.sim){this.sim.special(this.sim.state.seats[0]);this.processEvents();}else this.virtual.special=true;break;case'dismissStrain':this.clearOverlay();break;case'dev':if(\"'!this.inSession){this.devPage=0;this.overlay='\"'dev';this.renderOverlay();}break;case'devAction':{const [a,v]=value.split('|');this.devAction(a,v);break;}case'resetPage':this.resetTuning(false);break;case'resetAll':this.resetTuning(true);break;case'finishCredits':this.sim?.free();this.sim=null;this.setScreen('menu');break;case'sessionReady':this.sessionData?.answer('ready');break;case'sessionMore':this.sessionData?.answer('more');break;}\n }\n back(){this.audio.effect('back',.4);if(this.overlay==='dev'){this.overlay='pause';this.renderOverlay();return;}if(this.overlay==='settings'){this.overlay=this.returnOverlay;this.returnOverlay=null;this.renderOverlay();return;}if(this.overlay){if(this.overlay==='pause')this.clearOverlay();else if(this.overlay==='fail')return;else this.clearOverlay();return;}if(this.screen==='menu')this.setScreen('title');else if(this.screen==='chart')this.setScreen(this.modeFree?'free':'menu');else if(this.screen==='lobby'||this.screen==='free'||this.screen==='difficulty')this.setScreen('menu');else if(this.screen==='report')this.continueReport();else if(this.screen==='credits')this.execute('finishCredits');}\n clearOverlay(){this.overlay=null;this.renderOverlay();this.focus.reset();this.input.mouse.down=false;this.input.mouse.right=false;}\n openSettings(){this.returnOverlay=this.overlay&&this.overlay\"'!=='\"'settings'?this.overlay:null;this.overlay='settings';this.settingsPage=0;this.renderOverlay();}\n pause(){if(this.inSession){this.openSettings();return;}if(\"'!this.overlay){this.overlay='\"'pause';this.renderOverlay();}}\n changePage(d){if(this.overlay==='settings')this.settingsPage=(this.settingsPage+d+3)%3;else if(this.overlay==='about')this.aboutPage=(this.aboutPage+d+this.aboutPages().length)%this.aboutPages().length;else if(this.overlay==='dev')this.devPage=(this.devPage+d+this.devPages().length)%this.devPages().length;else if(this.screen==='free'){this.freePage=(this.freePage+d+2)%Math.max(1,Math.ceil(Math.min(7,this.save.progress+1)/6));this.render();return;}this.renderOverlay();}\n change(el){if(el.dataset.setting){const id=el.dataset.setting;let value=el.value;if(id==='level'){this.level=value;return;}if(id==='doctor'){this.freeDoctor=value;return;}if(['music','sfx','voice','aimAssist','tipSpeed','textSpeed'].includes(id))value=+value;else if(['rumble','swapSticks','shake','lineBoil'].includes(id))value=value==='true';this.settings[id]=value;this.audio.apply(this.settings);if(id==='tipSpeed'||id==='aimAssist'){this.tuning[id]=value;if(this.sim)this.sim.tuning[id]=value;}const out=this.overlayEl.querySelector('#out-'+id);if(out)out.textContent=['music','sfx','voice','aimAssist'].includes(id)?Math.round(value*100)+'%':value;writeSave(this.save);}\n if(el.dataset.tuning){const id=el.dataset.tuning;this.tuning[id]=+el.value;if(this.sim)this.sim.tuning[id]=+el.value;const out=this.overlayEl.querySelector('#tune-out-'+id);if(out)out.textContent=(+el.value).toFixed(3)+' / default '+defaults[id];}\n if(el.dataset.dev==='timeScale')this.timeScale=+el.value;\n }\n resetTuning(all){const page=this.devPages()[this.devPage],ids=all?Object.keys(defaults):(page.values||[]).map(x=>x[0]);for(const id of ids){this.tuning[id]=defaults[id];if(this.sim)this.sim.tuning[id]=defaults[id];}if(all){this.sim&&(this.sim.cheats={god:false,freezeTimer:false,infiniteComposure:false,infiniteClamps:false});this.bot=false;this.timeScale=1;this.settings.ink=this.settings.halftone=this.settings.shadows=this.settings.lineBoil=true;}this.renderOverlay();}\n setTool(n){this.input.tool=n;this.input.selected.set(this.input.lastPad,n);const seat=this.sim?.state.seats.find(s=>s.id===this.localId);if(seat)seat.tool=n;}\n setSite(n){if(\"'!this.sim)return;const s=this.sim.state;s.site=n;for(const seat of s.seats)seat.site=n;this.hud.phaseKey='\"'';this.siteCooldown=performance.now()+800;}\n changeSite(delta,padIndex){if(performance.now()<this.siteCooldown)return;const state=this.sim?.state||this.externalState;if(\"'!state)return;const n=(state.site+delta+operations[state.op].sites.length)%operations[state.op].sites.length;if(this.sim)this.setSite(n);else{const seat=state.seats.find(s=>s.id===this.localId);if(seat)seat.site=n;state.site=n;}}\n showHint(){this.hintUntil=performance.now()+6000;this.bark=this.sim?.phase.objective||'\"'Follow the highlighted objective, Doctor.';this.audio.say(this.bark,this.sim?.state.op===6?'pip':'bea');}\n startStory(id,next){this.storyId=id;this.storyLine=0;this.charCount=0;this.storyNext=next;this.setScreen('story');const data=story[id];this.view?.stage(data,data.lines[0]);this.audio.setTrack(data.mood);this.audio.say(data.lines[0].text,data.lines[0].who);this.lastStoryAdvance=performance.now();}\n advanceStory(){if(this.screen\"'!=='\"'story')return;const data=story[this.storyId],line=data.lines[this.storyLine];if(this.charCount<line.text.length){this.charCount=line.text.length;this.updateStoryText();return;}this.storyLine++;if(this.storyLine>=data.lines.length){this.storyNext?.();return;}this.charCount=0;this.render();this.view?.stage(data,data.lines[this.storyLine]);this.audio.say(data.lines[this.storyLine].text,data.lines[this.storyLine].who);this.lastStoryAdvance=performance.now();}\n updateStoryText(){const line=story[this.storyId]?.lines[this.storyLine];const el=this.screenEl.querySelector('#dialogue-text');if(el&&line)el.textContent=line.text.slice(0,Math.floor(this.charCount));}\n skipStory(){if(this.screen==='story'){this.overlay=null;this.storyNext?.();}}\n beforeOperation(op){this.save.progress=Math.max(this.save.progress,op);if(\"'!this.attract)writeSave(this.save);const scene=operations[op].scene?.before;if(scene)this.startStory(scene,()=>this.showChart(op));else this.showChart(op);}\n showChart(op){this.chartOp=op;this.freeDoctor=operations[op].doctor;this.consult='\"'careful';this.setScreen('chart');this.view?.chart?.(operations[op].patient);this.audio.setTrack('calm');}\n startOperation(op,free=false,players){this.sim?.free();this.chartOp=op;this.modeFree=free;this.seenStrains=new Set();this.sim=new Sim({op,level:this.level,tuning:this.tuning,doctor:free?this.freeDoctor:undefined,consult:this.consult,players});this.acc=0;this.input.tool=3;this.bot=this.params.get('auto')==='1';this.bark=operations[op].phases[0].say||barkFor('start');this.setScreen('operation');this.hud.phaseKey='';this.audio.setTrack(operations[op].music||'or-calm');this.audio.effect('grip');this.processEvents();}\n continueReport(){const op=this.sim.state.op;if(this.modeFree||op===8){this.setScreen(op===8?'menu':'free');return;}if(op===7){this.startStory('S16',()=>this.setScreen('credits'));return;}const after=operations[op].scene.after;this.startStory(after,()=>{if(op===6)this.startStory('S15',()=>this.showChart(7));else this.beforeOperation(op+1);});}\n join(device='keyboard'){const key=typeof device==='number'?'pad'+device:'keyboard';const exists=this.lobby.findIndex(s=>s.device===key);if(exists>=0){if(exists===0)this.startCoop();return;}if(this.lobby.length>=4)return;const i=this.lobby.length;this.lobby.push({id:i,name:key==='keyboard'?'Keyboard / Mouse':'Controller '+(Number(key.slice(3))+1),device:key,color:['#e8443a','#3b82f6','#22c55e','#f5b700'][i]});this.render();}\n startCoop(){if(\"'!this.lobby.length){this.join('\"'keyboard');return;}this.startOperation(8,true,this.lobby);}\n processEvents(){if(\"'!this.sim)return;const events=this.sim.drainEvents();for(const e of events){this.view?.event(e);if(e.type==='\"'bark'){this.bark=e.text||barkFor(e.event,this.sim.state.tick);if(this.sim.state.op===6)this.bark='“'+this.bark+'” — her notebook.';if(performance.now()-(this.lastBarkTime||0)>1200){this.audio.say(this.bark,this.sim.state.op===6?'pip':'bea');this.lastBarkTime=performance.now();}}\n if(e.type==='hint')this.showHint();if(e.type==='grade'&&\"'!this.params.has('\"'norender')){const pos=this.view?.project(e.x,e.y)||{x:innerWidth/2,y:innerHeight/2};const g=document.createElement('div');g.className='grade '+(e.grade==='MISS'?'miss':'');g.textContent=e.grade;g.style.left=pos.x+'px';g.style.top=pos.y+'px';this.toastEl.append(g);setTimeout(()=>g.remove(),950);}\n if(e.type==='strain'&&\"'!this.attract&&!this.bot&&!this.inSession&&!this.seenStrains?.has(e.strain)){this.seenStrains?.add(e.strain);this.strain=e.strain;this.overlay='\"'strain';this.renderOverlay();this.audio.setTrack(e.strain);}\n if(e.type==='phase'){this.hud.phaseKey='';if(this.sim.phase?.tools[0]&&tools.includes(this.sim.phase.tools[0]))this.setTool(tools.indexOf(this.sim.phase.tools[0]));}\n if(['defib','sforzando','hush'].includes(e.type)){this.cutIn(e.type==='defib'?'CLEAR\"'!'\"':e.type==='hush'?'THE HUSH':'SFORZANDO\"'!'\"');}\n if(e.type==='win')this.audio.effect('stamp');else if(['beat','grip','pop','deposit','stitch','ping','clamp','unclamp','inject','defib','weakShock','vent','nick','hush','sforzando','fortissimo'].includes(e.type))this.audio.effect(e.type,e.type==='beat'?.16:.7);\n if(this.settings.rumble&&['stitch','clamp','defib'].includes(e.type)){const pad=Array.from(navigator.getGamepads?.()||[]).find(p=>p?.index===this.input.lastPad);try{pad?.vibrationActuator?.playEffect('dual-rumble',{duration:e.type==='defib'?180:35,strongMagnitude:e.type==='defib'?.8:.15,weakMagnitude:.25})?.catch(()=>{});}catch{}}\n }\n const s=this.sim.state;if(s.status==='won'&&\"'!this.attract&&this.screen==='\"'operation'&&\"'!this.inSession){if(!this.modeFree){this.save.progress=Math.max(this.save.progress,Math.min(7,s.op+1));}const order='\"'SABCD',previous=this.save.best[this.sim.op.id];if(s.rank&&(\"'!previous||order.indexOf(s.rank)<order.indexOf(previous)))this.save.best[this.sim.op.id]=s.rank;writeSave(this.save);this.overlay=null;this.setScreen('\"'report');}\n if(s.status==='failed'&&\"'!this.attract&&this.screen==='\"'operation'&&\"'!this.inSession){this.overlay='\"'fail';this.renderOverlay();}\n }\n cutIn(text){if(this.attract||this.params.has('norender'))return;const el=document.createElement('div');el.className='cutin';el.textContent=text;this.toastEl.append(el);setTimeout(()=>el.remove(),1400);}\n toast(text){const el=document.createElement('div');el.className='toast';el.textContent=text;this.toastEl.append(el);setTimeout(()=>el.remove(),2800);}\n simStep(){if(\"'!this.sim||this.screen!=='\"'operation')return;for(const seat of this.sim.state.seats){const frame=(this.bot||this.attract)?botInput(this.sim,seat.id,this.testBotOptions):{...this.input.frame(seat),...this.virtual};this.sim.input(seat.id,frame);}this.sim.step();this.processEvents();}\n startAttract(){if(this.inSession||this.attract)return;this.attract=true;this.attractReturn=this.screen;this.attractStarted=performance.now();this.attractIndex=-1;this.updateAttract();}\n updateAttract(){const segments=[[0,1],[0,4],[1,1],[1,4],[2,2],[3,1],[3,4],[4,1],[4,2],[5,1],[5,4],[6,4],[6,5]];const n=Math.floor((performance.now()-this.attractStarted)/11000)%segments.length;if(n\"'!==this.attractIndex){this.attractIndex=n;const [op,phase]=segments[n];this.sim?.free();this.sim=new Sim({op,tuning:this.tuning,level:'\"'easy'});this.sim.cheats.god=true;this.sim.cheats.freezeTimer=true;this.sim.cheats.infiniteComposure=true;this.sim.cheats.infiniteClamps=true;this.sim.skipTo(phase);this.screen='operation';this.overlay=null;this.view?.setMode('attract');this.hudEl.style.display='block';this.screenEl.innerHTML='';this.overlayEl.innerHTML='';this.hud.phaseKey='';this.bot=true;this.processEvents();this.renderTouch();}if(this.sim.state.status\"'!=='\"'playing'){this.sim.state.status='playing';this.sim.skipTo(segments[n][1]);}}\n exitAttract(){if(\"'!this.attract)return;this.sim?.free();this.sim=null;this.bot=false;this.attract=false;this.setScreen(this.attractReturn||'\"'title');this.lastActivity=performance.now();}\n devAction(id,value){if(this.inSession)return;let s=this.sim?.state;const sel=n=>this.overlayEl.querySelector(\"'`[data-dev=\"${n}\"]`)?.value;const requireSim=()=>{if(!this.sim){this.startOperation(0,true);this.overlay='\"'dev';this.renderOverlay();}s=this.sim.state;};\n if(id==='unlock'){this.save.progress=7;writeSave(this.save);this.toast('All procedure charts unlocked.');return;}\n if(id==='jump'){const op=Number(value??sel('op')??0),phase=Number(sel('phase')??0);this.startOperation(op,true);this.sim.skipTo(Math.min(phase,this.sim.op.phases.length-1));this.overlay='dev';this.renderOverlay();return;}\n if(id==='story'){this.startStory(value||sel('scene')||'S1',()=>this.setScreen('menu'));return;}\n requireSim();switch(id){case'objective':this.sim.completeObjective();break;case'phase':this.sim.completePhase();break;case'win':this.sim.win();break;case'fail':this.sim.fail('FLATLINE');break;case'rank':this.sim.state.score=this.sim.op.parScore;this.sim.win();this.sim.state.rank=value||'S';break;case'step':{const current=this.overlay;this.overlay=null;this.simStep();this.overlay=current;break;}case'god':case'freezeTimer':case'infiniteComposure':case'infiniteClamps':this.sim.cheats[id]=\"'!this.sim.cheats[id];break;case'\"'bot':this.bot=\"'!this.bot;break;case'\"'resetCheats':this.sim.cheats={god:false,freezeTimer:false,infiniteComposure:false,infiniteClamps:false};this.bot=false;this.timeScale=1;break;case'bleeder':this.sim.spawn({kind:'bleeder',x:s.seats[0].x,y:s.seats[0].y},false);break;case'arrest':this.sim.arrest(12);break;case'fortissimo':{let e=s.entities.find(e=>e.kind==='crescendo');if(\"'!e)e=this.sim.spawn({kind:'\"'crescendo',x:0,y:0,size:.99},false);e.size=1.01;this.sim.step();break;}case'hush':case'sforzando':s.composure=100;s.doctor=id==='hush'?'ren':'ines';this.sim.special(s.seats[0]);break;case'strain':{const kind=value||sel('strain')||'adagio';this.sim.spawn({kind:kind==='staccato'?'note':kind,x:s.seats[0].x,y:s.seats[0].y,hp:['adagio','tremolo','coda','fermata'].includes(kind)?100:undefined,links:8,size:.2,embed:.2,axis:90,arms:2,ttl:10},false);break;}case'debug':this.debugOverlay=\"'!this.debugOverlay;break;case'\"'ink':case'halftone':case'lineBoil':case'shadows':this.settings[id]=\"'!this.settings[id];break;}\n this.processEvents();if(this.overlay==='\"'dev')this.renderOverlay();}\n hudUpdate(){const state=this.sim?.state||this.externalState;if(this.screen==='operation'&&state)this.hud.update(state);}\n renderSessionCard(){const info=this.sessionInfo;if(\"'!info)return;this.screenEl.innerHTML=`<main class=\"screen session-card\"><div class=\"top-brand\"><span class=\"eyebrow\">WARD ZERO / LIVE TEAM PROCEDURE</span><span class=\"small gold\" id=\"card-clock\">Preparing…</span></div><div class=\"session-intro\"><h1>${esc(GAME_TITLE)}</h1><h2>Grand Rounds.</h2><p>Keep the patient alive. Finish every movement together.</p><div class=\"session-players\" id=\"session-players\"></div><p class=\"muted\">${this.tokens('\"'{aim} Aim · {tools} Tools · {use} Use')}<br>\"'${this.tokens('\"'{syringe} Stabilize · {prev} / {next} Change site')}</p><div class=\\\"session-actions\\\">\"'${btn('\"'sessionReady',this.tokens('{confirm} Ready'),'primary')}\"'${btn('\"'sessionMore',this.tokens('{special} / M More time'),'secondary')}</div></div></main>\"'`;this.refreshSessionCard();}\n refreshSessionCard(data){if(data)this.cardData=data;const info=this.sessionInfo,dataNow=this.cardData||{};const list=this.screenEl.querySelector('\"'#session-players');if(list){list.replaceChildren();for(const p of info.players){const span=document.createElement('span');span.className='session-player';span.style.color=p.color;span.textContent=p.name+(dataNow.ready?.includes(p.id)?' · READY':' · SCRUBBING IN');list.append(span);}}const clock=this.screenEl.querySelector('#card-clock');if(clock)clock.textContent=dataNow.starting?'STARTING…':dataNow.paused?'TAKE YOUR TIME':dataNow.left==null?'PREPARING…':Math.ceil(dataNow.left/1000)+'s';}\n loop(){let lastRender=performance.now();const pump=()=>{if(this.ended)return;const now=performance.now(),dt=Math.min(.25,(now-this.lastPump)/1000);this.lastPump=now;this.input.poll();if(\"'!this.inSession){if(!this.attract&&!this.overlay&&['\"'title','menu','free'].includes(this.screen)&&now-this.lastActivity>=10000)this.startAttract();if(this.attract)this.updateAttract();if(this.screen==='operation'&&\"'!this.overlay){this.acc+=dt*this.timeScale;let n=0;while(this.acc>=1/60&&n<30){for(let i=0;i<this.warp;i++){if(this.overlay||this.screen!=='\"'operation')break;this.simStep();}this.acc-=1/60;n++;}}}\n if(this.screen==='story'&&\"'!this.overlay){const line=story[this.storyId].lines[this.storyLine];this.charCount=Math.min(line.text.length,this.charCount+dt*38*this.settings.textSpeed);this.updateStoryText();if((this.input.keys.has('\"'enter')||this.input.keys.has(' ')||this.input.mouse.down)&&now-this.lastStoryAdvance>450){this.charCount=line.text.length;this.advanceStory();}}\n if(now-(this.lastHUD||0)>75){this.hudUpdate();this.lastHUD=now;}\n const s=this.screen==='operation'?(this.sim?.state||this.externalState):null;this.audio.update(s);setTimeout(pump,16);};pump();\n const draw=async()=>{if(this.ended)return;const now=performance.now(),dt=Math.min(.15,(now-lastRender)/1000);this.frameMs=now-lastRender;lastRender=now;const s=this.sim?.state||this.externalState;this.view?.update(s,dt,{...this.settings,hushDuration:this.tuning.hushDuration});await this.view?.draw();requestAnimationFrame(draw);};requestAnimationFrame(draw);\n }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/app/director.js <<'EOF'\nimport {GAME_TITLE,TAGLINE} from '../config/identity.js';\nimport {defaults,groups,difficulty,tools,toolLabels} from '../config/tuning.js';\nimport {operations} from '../data/ops/index.js';\nimport {story,barkFor} from '../data/story/index.js';\nimport {cast,strainInfo} from '../data/cast.js';\nimport {Sim} from '../sim/sim.js';\nimport {botInput} from '../sim/bot.js';\nimport {rankTitles} from '../sim/scoring.js';\nimport {Input} from '../input/input.js';\nimport {renderTokens} from '../input/glyphs.js';\nimport {Focus} from '../ui/focus.js';\nimport {HUD,timeText} from '../ui/hud.js';\nimport {loadSave,writeSave,defaultSettings} from './save.js';\nimport {AudioEngine} from '../audio/engine.js';\nexport const esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst btn=(action,text,css='secondary',value='')=>\"'`<button class=\"${css}\" data-focus=\"${action}${value}\" data-action=\"${action}\" data-value=\"${value}\">${text}</button>`;\nconst names={title:'\"'Title',menu:'Main Menu',story:'Story',chart:'Chart',operation:'Operation',report:'Report',free:'Free Play',lobby:'Lobby',credits:'Credits roll',difficulty:'Difficulty','session-card':'Session card','session-end':'Session ended'};\nconst chapters=['','Scrub In','First Movement','Dissent','Coda'];\nexport class App{\n constructor({view=null,params=new URLSearchParams(location.search),session=false}={}){\n this.view=view;this.params=params;this.inSession=session;this.save=session?{progress:0,best:{},settings:{...defaultSettings}}:loadSave();this.settings=this.save.settings;this.tuning={...defaults,tipSpeed:this.settings.tipSpeed,aimAssist:this.settings.aimAssist};this.audio=new AudioEngine(this.settings);\n this.screen='title';this.overlay=null;this.returnOverlay=null;this.reached=new Set(['Title']);this.lastActivity=performance.now();this.lastPump=performance.now();this.acc=0;this.warp=1;this.timeScale=1;this.frameMs=0;this.bot=false;this.attract=false;this.attractIndex=-1;this.sim=null;this.externalState=null;this.localId=0;this.level='normal';this.consult='careful';this.freeDoctor='ren';this.modeFree=false;this.page=0;this.aboutPage=0;this.settingsPage=0;this.devPage=0;this.freePage=0;this.lobby=[];this.virtual={};this.bark='Steady hands, Doctor.';this.hintUntil=0;this.debugOverlay=false;this.storyLine=0;this.charCount=0;this.storyNext=null;this.storyId='S1';this.lastStoryAdvance=0;this.testBotOptions={};this.ended=false;this.siteCooldown=0;this.sessionData=null;\n this.touchOnly=\"'!matchMedia('\"'(any-pointer: fine)').matches;this.notice=this.touchOnly&&\"'!session;\n this.screenEl=document.getElementById('\"'screen');this.hudEl=document.getElementById('hud');this.overlayEl=document.getElementById('overlays');this.touchEl=document.getElementById('touch');this.toastEl=document.getElementById('toast-layer');\n this.focus=new Focus(document.getElementById('app'),()=>this.audio.effect('move',.4));\n this.input=new Input({onAction:(...args)=>this.action(...args),onActivity:kind=>this.activity(kind),getMode:()=>this.overlay||this.screen,aim:(x,y)=>view?.screenToField(x,y)||{x:(x/innerWidth-.5)*3,y:(.5-y/innerHeight)*2},settings:()=>this.settings});\n document.getElementById('app').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled){e.stopPropagation();this.execute(b.dataset.action,b.dataset.value);}});\n document.getElementById('\"'app').addEventListener('input',e=>this.change(e.target));document.getElementById('app').addEventListener('change',e=>this.change(e.target));\n document.getElementById('app').addEventListener('pointerdown',e=>{const b=e.target.closest('[data-hold]');if(b){e.preventDefault();this.virtual[b.dataset.hold]=true;}});addEventListener('pointerup',()=>this.virtual={});\n document.addEventListener('visibilitychange',()=>{if(document.hidden&&\"'!this.inSession&&!this.attract&&(this.screen==='\"'operation'||this.screen==='story')&&\"'!this.overlay)this.pause();});\n this.hud=new HUD(this.hudEl,this);this.render();this.expose();\n }\n tokens(s){return renderTokens(s,this.input.prompt,this.settings.glyphs);}\n activity(kind){if(this.ended)return;this.audio.unlock();this.lastActivity=performance.now();if(this.attract){this.exitAttract();this.ignoreInputUntil=performance.now()+100;return;}if(this.notice&&(kind==='\"'keyboard'||kind==='pad')){this.notice=false;this.touchOnly=false;this.renderTouch();this.setScreen('title');}if(kind==='pad'&&this.audio.ctx?.state==='suspended'&&this.screen==='title')this.soundNotice=true;}\n state(){const s=this.sim?.state||this.externalState;const seat=s?.seats.find(x=>x.id===this.localId)||s?.seats[0];return{screen:this.notice&&\"'!this.overlay?'\"'Touch notice':this.overlay?({pause:'Pause',fail:'Fail',settings:'Settings',about:'About',dev:'Dev Mode',strain:'Strain card'}[this.overlay]||this.overlay):names[this.screen]||this.screen,op:s?.op??this.chartOp??null,phase:s?.phase??0,vitals:s?.vitals??100,timer:s?.timer??0,score:s?.score??0,rank:s?.rank??null,bpm:s?.bpm??64,beat:s?.beat??0,site:s?.site??0,tool:seat?.tool??this.input.tool,tips:s?.seats.map(x=>({id:x.id,x:x.x,y:x.y,tool:x.tool,use:x.use,site:x.site,score:x.score}))||[],focusId:this.focus.id,promptSet:this.input.prompt,glyphSet:this.settings.glyphs,attract:this.attract,devOpen:this.overlay==='dev',renderBackend:this.view?.backend||'none',musicGain:this.audio.musicGain,tuning:{...this.sim?.tuning||this.tuning},reached:[...this.reached],status:s?.status||'menu',storyId:this.storyId,storyLine:this.storyLine,progress:this.save.progress,notes:\"'!!s?.notes};}\n expose(){const api={state:()=>this.state()};if(this.params.get('\"'test')==='1'){api.test={step:n=>{for(let i=0;i<n;i++){if(this.sim&&this.screen==='operation'&&\"'!this.overlay){this.simStep();if(this.sim?.state.status!=='\"'playing')break;}}this.hudUpdate();return this.state();},warp:n=>this.warp=Math.max(1,n),input:f=>this.input.override=f,bot:(on,opts={})=>{this.bot=on;this.testBotOptions=opts;},skipTo:(op,phase)=>{this.startOperation(Number(op),true);this.sim.skipTo(Number(phase));this.clearOverlay();this.hudUpdate();},hash:()=>this.sim?.hash(),idle:ms=>this.lastActivity=performance.now()-ms,dev:(id,value)=>this.devAction(id,value),getState:()=>structuredClone(this.sim?.state),setVitals:n=>{if(this.sim)this.sim.state.vitals=n;},audio:this.audio};}window.__game=api;}\n setScreen(screen){this.screen=screen;this.reached.add(names[screen]||screen);this.overlay=null;this.view?.setMode(screen);this.render();}\n header(text,right=''){return\"'`<div class=\"page-head\"><div><div class=\"eyebrow gold\">ST. ALDER / OR 03</div><h2>${text}</h2></div>${right||btn('\"'back','← Back','back-btn')}</div>\"'`;}\n footer(text='\"''){return\"'`<div class=\"bottom-bar\"><span>${this.tokens('\"'{confirm} Select · {back} Back')}</span><span class=\\\"muted\\\">\"'${text}</span></div>`;}\n logo(){const [first,...rest]=GAME_TITLE.split('\"':');return\"'`${esc(first)}${rest.length?`<span>${esc(rest.join('\"':'))}</span>\"'`:'\"''}\"'`;}\n render(){const el=this.screenEl;this.hudEl.style.display=this.screen==='\"'operation'?'block':'none';el.innerHTML='';\n switch(this.screen){\n case'title':el.innerHTML=\"'`<main class=\"screen title-screen\"><div class=\"top-brand\"><div class=\"hospital\"><span class=\"cross\">✚</span><span class=\"eyebrow\">ST. ALDER MEMORIAL</span></div><span class=\"small muted\">PORT CALLOWAY / 02:17</span></div><div class=\"title-content\"><h1 class=\"title-logo\">${this.logo()}</h1><p class=\"title-tag\">${esc(TAGLINE)}</p>${btn('\"'enter','Scrub in <span>↗</span>','primary title-start')}</div><div class=\\\"title-index\\\"><strong>03</strong><span>Operating theatre</span></div><div class=\\\"bottom-bar\\\"><span class=\\\"key-row\\\">\"'${this.tokens('\"'{confirm} Press any button')}</span><span class=\\\"signal small\\\">\"'${this.save.progress?'\"'SHIFT RECORD FOUND':'NIGHT SHIFT / SINGLE PLAYER + CO-OP'}</span></div>\"'${this.soundNotice?'\"'<div class=\\\"sound-note\\\">Press any key or click for sound</div>':''}<div class=\\\"ink-texture\\\"></div></main>\"'`;this.audio.setTrack('\"'title');break;\n case'menu':el.innerHTML=\"'`<main class=\"screen main-screen\"><div class=\"top-brand\"><div class=\"main-logo comic\">${esc(GAME_TITLE)}</div><span class=\"eyebrow muted\">NIGHT SHIFT / 03</span></div><div class=\"menu-panel\"><div class=\"eyebrow gold\">YOUR HANDS. THEIR HEARTBEAT.</div><h2>Clock in, Doctor.</h2><nav class=\"menu-list\">${[['\"'storyMenu','Story'],['free','Free Play'],['lobby','Grand Rounds'],['settings','Settings'],['about','About & Credits']].map(([id,label],i)=>btn(id,\"'`<span class=\"num\">0${i+1}</span>${label}<span class=\"arrow\">↗</span>`,'\"'menu-item')).join('')}</nav><div class=\\\"chapter-tag\\\">\"'${this.save.progress?`CHAPTER ${operations[Math.min(6,this.save.progress)].chapter} / ${chapters[operations[Math.min(6,this.save.progress)].chapter]}`:'\"'A SURGICAL ACTION DRAMA'}</div><p class=\\\"menu-note\\\">\"'${this.save.progress?'\"'A chart is waiting where you left it.':'Eight instruments. Seven strains. One second chance.'}</p></div><div class=\\\"room-tag\\\"><span class=\\\"muted\\\">THE ROOM IS QUIET.</span><b>FOR NOW.</b></div>\"'${this.footer('\"'1–4 SURGEONS / CONTROLLER RECOMMENDED')}</main>\"'`;break;\n case'\"'difficulty':el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'First, a question.')}<div class=\\\"menu-panel\\\" style=\\\"width:55%;max-width:54rem\\\"><p>“How much do you hate yourself, child?”</p><p class=\\\"muted small\\\" style=\\\"margin:1rem 0 2rem\\\">You can change this on any patient chart.</p><nav class=\\\"menu-list\\\">\"'${Object.entries(difficulty).map(([id,d])=>btn('\"'difficulty',\"'`<span>${d.label}</span><span class=\"small\">${id==='\"'easy'?'More time. Gentler hands.':id==='normal'?'The intended night shift.':'Less room for error.'}</span>\"'`,'\"'menu-item',id)).join('')}</nav></div>\"'${this.footer('\"'BEA OKONKWO / HEAD NURSE')}</main>\"'`;break;\n case'\"'story':{const data=story[this.storyId],line=data.lines[this.storyLine];el.innerHTML=\"'`<main class=\"screen story-screen\"><div class=\"story-top\"><span class=\"scene-title\">${esc(data.title)}</span>${btn('\"'skip',this.tokens('{special} / Tab Skip scene'),'back-btn')}</div><div class=\\\"dialogue-box\\\" data-action=\\\"advance\\\"><span class=\\\"speaker-tag\\\" style=\\\"background:\"'${cast[line.who].color}\">${esc(cast[line.who].name)}</span><div class=\"dialogue ${line.shout?'\"'shout':''}\\\" id=\\\"dialogue-text\\\"></div><span class=\\\"advance-prompt\\\">\"'${this.tokens('\"'{confirm} Continue')} ▸</span></div><span class=\\\"story-line-count\\\">\"'${String(this.storyLine+1).padStart(2,'\"'0')} / \"'${data.lines.length} · HOLD TO FAST-FORWARD</span></main>`;break;}\n case'\"'chart':{const op=operations[this.chartOp];el.innerHTML=\"'`<main class=\"screen chart-screen\"><div class=\"top-brand\"><span class=\"eyebrow\">${this.chartOp===8?'\"'WARD ZERO / TEAM CHART':\"'`CHAPTER ${op.chapter} / ${chapters[op.chapter]}`}</span>${btn('\"'back','← Chart board','back-btn')}</div><article class=\\\"chart\\\"><div class=\\\"chart-id\\\"><span>CONFIDENTIAL / PATIENT RECORD</span><span>SA–\"'${String(this.chartOp+1).padStart(3,'\"'0')}</span></div><h2>\"'${esc(op.patient.name)}</h2><p class=\"chart-job\">${op.patient.age} years · ${esc(op.patient.job)}</p><p class=\"chart-note\">${esc(op.patient.note)}</p><div class=\"chart-operation\"><span>PROCEDURE ${String(this.chartOp+1).padStart(2,'\"'0')}</span><strong class=\\\"comic\\\">\"'${esc(op.title)}</strong><span>${op.timer?timeText(op.timer):'\"'UNTIMED'}</span></div><div class=\\\"chart-controls\\\"><label>Difficulty<select data-setting=\\\"level\\\" data-focus=\\\"chartLevel\\\">\"'${Object.entries(difficulty).map(([id,d])=>`<option value=\"${id}\" ${id===this.level?'\"'selected':''}>\"'${d.label}</option>`).join('\"'')}</select></label><label>Lead surgeon<select data-setting=\\\"doctor\\\" data-focus=\\\"chartDoctor\\\"><option value=\\\"ren\\\" \"'${this.freeDoctor==='\"'ren'?'selected':''}>Dr. Halloran / The Hush</option><option value=\\\"ines\\\" \"'${this.freeDoctor==='\"'ines'?'selected':''}>Dr. Varga / Sforzando</option></select></label></div>\"'${op.consult?`<div class=\"consult-options\">${btn('\"'consult','Halloran · Careful <span>+60s / gentler drain</span>',\"'`consult-btn ${this.consult==='\"'careful'?'active':''}\"'`,'\"'careful')}\"'${btn('\"'consult','Varga · Aggressive <span>Faster tools / ×1.15 score</span>',\"'`consult-btn ${this.consult==='\"'aggressive'?'active':''}\"'`,'\"'aggressive')}</div>\"'`:'\"''}\"'${btn('\"'begin','Begin procedure <span>↗</span>','primary')}</article>\"'${this.footer('\"'COUNT YOUR INSTRUMENTS. BREATHE.')}</main>\"'`;break;}\n case'\"'operation':break;\n case'report':{const s=this.sim.state,op=this.sim.op;el.innerHTML=\"'`<main class=\"screen report-screen\"><article class=\"report-paper\"><span class=\"eyebrow\" style=\"color:#4e706d\">OPERATIVE REPORT / ${String(s.op+1).padStart(2,'\"'0')}</span><h2>\"'${op.unfailing?'\"'Patient survived.':'Patient stable.'}</h2>\"'${s.rank?`<div class=\"report-rank\">${s.rank}</div>`:'\"''}<div class=\\\"report-subtitle\\\">\"'${s.rank?rankTitles[s.rank]:esc(op.patient.name)}${s.notes?'\"' · BEA’S NOTES / ASSISTED':''}</div><div class=\\\"report-stats\\\">\"'${[['\"'Time',timeText(s.elapsed)],['Vitals',Math.ceil(s.vitals)+'%'],['Precision',Math.round((s.actions-s.misses)/Math.max(1,s.actions)*100)+'%'],['Best Combo',s.bestCombo]].map(([l,v])=>\"'`<div class=\"report-stat\"><strong>${v}</strong><span>${l}</span></div>`).join('\"'')}</div><p>\"'${esc(op.patient.followUp)}</p>${s.seats.length>1?`<div class=\"team-stats\">${s.seats.map(x=>`<span class=\"seat-chip\" style=\"color:${x.color}\">${esc(x.name)} · ${x.score} · ${x.stats.Stitches} stitches</span>`).join('\"'')}</div>\"'`:'\"''}<div class=\\\"report-subtitle\\\">\"'${s.rank?`SCORE ${s.score.toLocaleString()} · ${s.misses===0?'\"'NO MISSES':s.misses+' MISSES'}\"'`:'\"'Tonight’s patient survived.'}</div>\"'${btn('\"'continueReport','Continue <span>↗</span>','primary')}</article></main>\"'`;break;}\n case'\"'free':{const unlocked=operations.slice(0,Math.min(7,this.save.progress+1)),visible=unlocked.slice(this.freePage*6,this.freePage*6+6);el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'The chart board.')}<p class=\\\"muted\\\">\"'${unlocked.length} procedures reached · Your best work is stamped here.</p><div class=\"free-grid\">${visible.map(op=>{const i=operations.indexOf(op);return btn('\"'selectOp',\"'`<span class=\"eyebrow small\">PROCEDURE ${String(i+1).padStart(2,'\"'0')}</span><span class=\\\"rank-chip\\\">\"'${this.save.best[op.id]||'\"'—'}</span><h3>\"'${op.title}</h3><p>${esc(op.patient.name)}</p>`,'\"'patient-card',i);}).join('')}</div>\"'${this.footer(`${this.freePage+1} / ${Math.max(1,Math.ceil(unlocked.length/6))} · Q / E PAGES`)}</main>`;break;}\n case'\"'lobby':el.innerHTML=\"'`<main class=\"screen main-screen\">${this.header('\"'Grand Rounds.')}<p class=\\\"muted\\\">One patient. Four pairs of hands. \"'${this.tokens('\"'Press {confirm} to join.')}</p><div class=\\\"lobby-seats\\\">\"'${Array.from({length:4},(_,i)=>{const seat=this.lobby[i];return`<div class=\"seat-card ${seat?'\"'joined':''}\\\" style=\\\"\"'${seat?'\"'border-color:'+seat.color:''}\\\"><div class=\\\"seat-number\\\" style=\\\"\"'${seat?'\"'color:'+seat.color:''}\\\">0\"'${i+1}</div><h3>${seat?esc(seat.name):'\"'Scrub in.'}</h3><p>\"'${seat?(i%2?'\"'Sforzando':'The Hush'):'Controller or keyboard'}</p><p class=\\\"muted\\\">\"'${seat?'\"'READY':'AWAITING SURGEON'}</p></div>\"'`;}).join('\"'')}</div><div class=\\\"tabs\\\">\"'${btn('\"'join','Join with keyboard','secondary')}\"'${btn('\"'startCoop','Start procedure ↗','primary')}</div>\"'${this.footer('\"'L1 / R1 OR Q / E CHANGES THE SHARED SITE')}</main>\"'`;break;\n case'\"'credits':el.innerHTML=\"'`<main class=\"screen\"><div class=\"credits\"><div class=\"eyebrow\">ST. ALDER MEMORIAL</div><h2>Good hands, child.</h2><p>${esc(TAGLINE)}</p><div class=\"rule\" style=\"width:50%\"></div><p>An original surgical action drama<br>Built with Three.js & Rapier<br>Music, voices and art made in code</p><p class=\"muted small\">OpenAI · gpt-6.1-sol · reasoning effort max<br>Bangers & Barlow Condensed · OFL</p>${btn('\"'finishCredits','End shift ↗','primary')}<span class=\\\"small gold\\\">A new envelope. Opus 2.</span></div></main>\"'`;this.audio.setTrack('\"'credits');break;\n case'session-card':this.renderSessionCard();break;\n case'session-end':el.innerHTML=\"'`<main class=\"screen main-screen\"><div class=\"session-intro\"><h2>Shift concluded.</h2><p class=\"muted\">${esc(this.endReason||'\"'The hub is preparing your results.')}</p></div></main>\"'`;break;\n }\n this.renderTouch();this.renderOverlay();this.focus.reset();\n }\n renderTouch(){this.touchEl.innerHTML=this.notice&&!this.overlay?`<aside class=\"touch-notice\"><div class=\"touch-icon\">✕ ○ □ △</div><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to scrub in.<br>The night shift will play itself in a moment.</p>${btn('\"'settings','Settings','secondary')}</aside>\"'`:'\"'';if(this.notice)this.reached.add('Touch notice');}\n renderOverlay(){const el=this.overlayEl;el.innerHTML='';if(\"'!this.overlay)return;this.reached.add({pause:'\"'Pause',fail:'Fail',settings:'Settings',about:'About',dev:'Dev Mode',strain:'Strain card'}[this.overlay]||this.overlay);const shade='<div class=\\\"overlay-shade\\\"></div>';\n if(this.overlay==='pause'){const isStory=this.screen==='story';el.innerHTML=shade+\"'`<section class=\"modal narrow\"><div class=\"eyebrow gold\">TAKE A BREATH</div><h2>On standby.</h2><nav class=\"menu-list\">${btn('\"'resume','Resume','menu-item')}\"'${isStory?btn('\"'skip','Skip scene','menu-item'):btn('retry','Retry phase','menu-item')}\"'${!isStory?btn('\"'restart','Restart operation','menu-item'):''}\"'${btn('\"'settings','Settings','menu-item')}\"'${btn('\"'dev','Dev Mode','menu-item')}\"'${btn('\"'quit','Quit to menu','menu-item')}</nav></section>\"'`;}\n if(this.overlay==='\"'storyMenu')el.innerHTML=shade+\"'`<section class=\"modal narrow\"><span class=\"eyebrow gold\">YOUR SHIFT RECORD</span><h2>Story.</h2><nav class=\"menu-list\">${this.save.progress?btn('\"'continueStory','Continue','menu-item'):''}\"'${btn('\"'newGame','New game','menu-item')}\"'${btn('\"'back','Back','menu-item')}</nav></section>\"'`;\n if(this.overlay==='\"'fail'){const s=this.sim.state;el.innerHTML=shade+\"'`<section class=\"modal narrow\"><span class=\"eyebrow\">PROCEDURE INTERRUPTED</span><h2 class=\"fail-heading\">${s.reason}</h2><p class=\"fail-message\">${esc(barkFor('\"'fail',s.tick))}</p><nav class=\\\"menu-list\\\">\"'${btn('\"'retry','Retry phase','menu-item')}\"'${btn('\"'restart','Restart operation','menu-item')}\"'${btn('\"'quit','Quit','menu-item')}</nav>\"'${(this.sim.failures[s.phase]||0)>=1?btn('\"'notes','Bea’s Notes · +30% time, −30% drain.<br>Assisted rank capped at B.','notes-offer'):''}</section>\"'`;}\n if(this.overlay==='\"'settings')el.innerHTML=shade+this.settingsHTML();\n if(this.overlay==='about')el.innerHTML=shade+this.aboutHTML();\n if(this.overlay==='dev')el.innerHTML=shade+this.devHTML();\n if(this.overlay==='strain'){const info=strainInfo[this.strain];el.innerHTML=\"'`<button class=\"strain-card\" data-action=\"dismissStrain\" data-focus=\"strain\"><div class=\"eyebrow\">REQUIEM / FIELD IDENTIFICATION</div><h2>${info.name}</h2><p><em>${info.definition}</em></p><p>${info.aside}</p><div class=\"rule\"></div><p class=\"small\">${info.hint}</p><span class=\"card-continue\">${this.tokens('\"'{confirm} Continue')}</span></button>\"'`;}\n this.renderTouch();this.focus.reset();\n }\n settingsHTML(){const page=this.settingsPage,tabs=['\"'Audio','Controls','Display'];let rows='';const range=(id,name,min,max,step,value,format)=>\"'`<div class=\"setting-row\" data-focus=\"setting${id}\"><label for=\"set-${id}\">${name}<output id=\"out-${id}\">${format?format(value):value}</output></label><input id=\"set-${id}\" data-setting=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" aria-label=\"${name}\"></div>`;\n const toggle=(id,name)=>`<div class=\"setting-row\" data-focus=\"setting${id}\"><label>${name}</label><select data-setting=\"${id}\" aria-label=\"${name}\"><option value=\"true\" ${this.settings[id]?'\"'selected':''}>On</option><option value=\\\"false\\\" \"'${!this.settings[id]?'\"'selected':''}>Off</option></select></div>\"'`;\n if(page===0)rows=[['\"'music','Music'],['sfx','Effects'],['voice','Voices']].map(([id,n])=>range(id,n,0,1,.05,this.settings[id],v=>Math.round(v*100)+'%')).join('');\n if(page===1)rows=\"'`<div class=\"setting-row\" data-focus=\"settingglyphs\"><label>Button glyphs</label><select data-setting=\"glyphs\" aria-label=\"Button glyphs\"><option value=\"playstation\" ${this.settings.glyphs==='\"'playstation'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${this.settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div>\"'${toggle('\"'rumble','Controller rumble')}\"'${range('\"'aimAssist','Aim assist',0,1,.05,this.settings.aimAssist,v=>Math.round(v*100)+'%')}\"'${toggle('\"'swapSticks','Swap sticks')}\"'${range('\"'tipSpeed','Tip speed',.8,3.5,.1,this.settings.tipSpeed,v=>Number(v).toFixed(1))}\"'`;\n if(page===2)rows=`<div class=\"setting-row\"><label>Fullscreen</label>${btn('\"'fullscreen',document.fullscreenElement?'Windowed':'Enter fullscreen','secondary')}</div>\"'${toggle('\"'shake','Screen shake')}\"'${toggle('\"'lineBoil','Line boil')}\"'${range('\"'textSpeed','Text speed',.5,3,.25,this.settings.textSpeed,v=>v+'×')}\"'`;\n return`<section class=\"modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">MAKE YOURSELF AT HOME</span><h2>Settings.</h2></div>${btn('\"'back','Done','back-btn')}</div><div class=\\\"tabs\\\">\"'${tabs.map((t,i)=>btn('\"'settingsPage',t,\"'`tab ${i===page?'\"'active':''}\"'`,i)).join('\"'')}</div><div class=\\\"settings-list\\\">\"'${rows}</div><div class=\"modal-footer\"><span class=\"small muted\">${page===0?'\"'All sound is synthesized. No recordings.':page===1?'Standard controllers · Both sticks are yours.':'A comfortable shift is a steady shift.'}</span><span class=\\\"key-row\\\">\"'${this.tokens('\"'{prev} / {next} Page')}</span></div></section>\"'`;\n }\n aboutPages(){let data;try{data=JSON.parse(document.getElementById('\"'about-data').textContent);}catch{data={sourceInformation:{source:'unknown'},testingFeedback:['unknown'],engineFeedback:['unknown'],promptFeedback:['unknown']};}const pages=[];const labels={sourceInformation:'Source Information',testingFeedback:'Testing Feedback',engineFeedback:'Engine Feedback',promptFeedback:'Prompt Feedback'};for(const [block,title]of Object.entries(labels)){const entries=Array.isArray(data[block])?data[block].map((x,i)=>[String(i+1).padStart(2,'0'),x]):Object.entries(data[block]||{});for(let i=0;i<entries.length;i+=3)pages.push({title,entries:entries.slice(i,i+3)});}pages.push({title:'Credits',entries:[['Built by','OpenAI · gpt-6.1-sol · reasoning effort max'],['Engine & type','Three.js r180 · Rapier 0.19.3 · Bangers & Barlow Condensed, SIL OFL'],['This session',\"'`Renderer: ${this.view?.backend||'\"'unknown'} · AI Hub client 1.4.0\"'`]]});return pages;}\n aboutHTML(){const pages=this.aboutPages(),page=pages[this.aboutPage%pages.length];return`<section class=\"modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">ABOUT & CREDITS</span><h2>${page.title}</h2></div>${btn('\"'back','Close','back-btn')}</div><div class=\\\"rule\\\"></div><div class=\\\"about-body\\\">\"'${page.entries.map(([k,v])=>`<p class=\"about-field ${String(v).length>150?'\"'long':''}\\\"><b>\"'${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase()))}</b><br>${esc(v)}</p>`).join('\"'')}</div><div class=\\\"modal-footer\\\">\"'${btn('\"'aboutPrev',this.tokens('{prev} Previous'),'secondary')}<span class=\\\"page-count\\\">\"'${this.aboutPage+1} / ${pages.length}</span>${btn('\"'aboutNext',this.tokens('Next {next}'),'secondary')}</div></section>\"'`;}\n devPages(){const p=[{title:'\"'Jump',type:'jump'},{title:'Actions',type:'actions'},{title:'Cheats',type:'cheats'},{title:'Spawn',type:'spawn'},{title:'View',type:'view'}];for(const [name,values]of Object.entries(groups))for(let i=0;i<values.length;i+=5)p.push({title:name+(values.length>5?' '+(i/5+1):''),type:'sliders',values:values.slice(i,i+5)});return p;}\n devHTML(){const pages=this.devPages(),p=pages[this.devPage%pages.length];const s=this.sim?.state;const action=(id,text,value='')=>btn('devAction',text,'secondary',id+(value?'|'+value:''));let content='';\n if(p.type==='jump')content=\"'`<div><div class=\"setting-row\"><label>Operation</label><select data-dev=\"op\" aria-label=\"Operation\">${operations.map((o,i)=>`<option value=\"${i}\" ${s?.op===i?'\"'selected':''}>\"'${i+1} · ${o.title}</option>`).join('\"'')}</select></div><div class=\\\"setting-row\\\"><label>Phase</label><select data-dev=\\\"phase\\\" aria-label=\\\"Phase\\\">\"'${(this.sim?.op||operations[0]).phases.map((q,i)=>`<option value=\"${i}\" ${s?.phase===i?'\"'selected':''}>\"'${i+1} · ${q.id}</option>`).join('\"'')}</select></div><div class=\\\"setting-row\\\"><label>Story</label><select data-dev=\\\"scene\\\" aria-label=\\\"Story scene\\\">\"'${Object.entries(story).map(([id,x])=>`<option value=\"${id}\">${id} · ${x.title}</option>`).join('\"'')}</select></div></div><div class=\\\"dev-controls\\\">\"'${action('\"'jump','Jump to selected phase')}\"'${action('\"'unlock','Unlock chart board')}\"'${action('\"'story','Play selected scene')}</div>\"'`;\n if(p.type==='\"'actions')content=\"'`<div class=\"dev-controls\">${[['\"'objective','Complete objective'],['phase','Complete phase'],['win','Win operation'],['fail','Fail operation'],['rank','Force S rank'],['step','Single step']].map(([id,t])=>action(id,t)).join('')}</div><div><p class=\\\"muted\\\">The simulation is paused while this panel is open.</p><p class=\\\"dev-values\\\" style=\\\"margin-top:1rem\\\">\"'${s?`Operation ${s.op+1} / phase ${s.phase+1}<br>Tick ${s.tick} / vitals ${s.vitals.toFixed(2)}<br>World hash ${this.sim.hash()}`:'\"'Story stage'}</p></div>\"'`;\n if(p.type==='\"'cheats')content=\"'`<div class=\"dev-controls\">${[['\"'god','Lock vitals'],['freezeTimer','Freeze timer'],['infiniteComposure','Infinite composure'],['infiniteClamps','Infinite clamps'],['bot','Auto Surgeon']].map(([id,t])=>action(id,\"'`${t} · ${(id==='\"'bot'?this.bot:this.sim?.cheats[id])?'ON':'OFF'}\"'`)).join('\"'')}</div><div><div class=\\\"setting-row\\\"><label>Time scale <output>\"'${this.timeScale}×</output></label><input data-dev=\"timeScale\" type=\"range\" min=\".1\" max=\"4\" step=\".1\" value=\"${this.timeScale}\" aria-label=\"Time scale\"></div>${action('\"'resetCheats','Reset cheats')}</div>\"'`;\n if(p.type==='\"'spawn')content=\"'`<div class=\"dev-controls\">${[['\"'bleeder','Bleeder at tip'],['arrest','Cardiac arrest'],['fortissimo','Fortissimo'],['hush','The Hush'],['sforzando','Sforzando']].map(([id,t])=>action(id,t)).join('')}</div><div><div class=\\\"setting-row\\\"><label>Strain</label><select data-dev=\\\"strain\\\" aria-label=\\\"Strain\\\">\"'${Object.entries(strainInfo).map(([id,x])=>`<option value=\"${id}\">${x.name}</option>`).join('\"'')}</select></div>\"'${action('\"'strain','Spawn selected strain')}</div>\"'`;\n if(p.type==='\"'view')content=\"'`<div class=\"dev-controls\">${[['\"'debug','Grid / colliders / input'],['ink','Ink outlines'],['halftone','Manga halftone'],['lineBoil','Line boil'],['shadows','Shadows']].map(([id,t])=>action(id,\"'`${t} · ${(id==='\"'debug'?this.debugOverlay:this.settings[id])?'ON':'OFF'}\"'`)).join('\"'')}</div><div><p class=\\\"dev-values\\\">\"'${this.view?.backend||'\"'none'}<br>Beat \"'${s?.beat||0} / ${(s?.bpm||64).toFixed(1)} BPM<br>Last render interval ${this.frameMs.toFixed(1)}ms<br>Input ${this.input.prompt}</p></div>`;\n if(p.type==='\"'sliders')content=\"'`<div class=\"settings-list\" style=\"grid-column:1/-1\">${p.values.map(([id,v,min,max])=>`<div class=\"setting-row\" data-focus=\"tune${id}\"><label>${id}<output id=\"tune-out-${id}\">${(this.sim?.tuning[id]??this.tuning[id]).toFixed(3)} <span class=\"muted\">/ default ${v}</span></output></label><input data-tuning=\"${id}\" aria-label=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${max<=1?.005:.05}\" value=\"${this.sim?.tuning[id]??this.tuning[id]}\" list=\"default-${id}\"><datalist id=\"default-${id}\"><option value=\"${v}\"></datalist></div>`).join('\"'')}</div>\"'`;\n return`<section class=\"modal dev-modal\"><div class=\"page-head\"><div><span class=\"eyebrow gold\">WARD ZERO / DEVELOPER TOOLS</span><h2>${p.title}</h2></div>${btn('\"'back','Back to pause','back-btn')}</div><div class=\\\"dev-content\\\">\"'${content}</div><div class=\"modal-footer\">${btn('\"'devPrev',this.tokens('{prev} Previous'),'secondary')}<span class=\\\"page-count\\\">\"'${this.devPage+1} / ${pages.length}</span>${btn('\"'resetPage','Reset page','secondary')}\"'${btn('\"'resetAll','Reset all','secondary')}\"'${btn('\"'devNext',this.tokens('Next {next}'),'secondary')}</div></section>\"'`;\n }\n action(action,value,extra){if(this.ended||performance.now()<(this.ignoreInputUntil||0))return;if(this.inSession&&this.sessionData){if(this.screen==='\"'session-card'){if(action==='confirm')this.sessionData.answer('ready');if(action==='more')this.sessionData.answer('more');return;}if(action==='pause'||action==='back'&&\"'!this.overlay){this.openSettings();return;}}\n if(this.overlay==='\"'strain'){if(action==='confirm'||action==='back'||action==='skip')this.execute('dismissStrain');return;}\n if(action==='disconnect'){if(\"'!this.inSession)this.pause();return;}\n if(this.overlay){if(action==='\"'back')this.back();else if(action==='nav')this.focus.move(value);else if(action==='confirm')this.focus.confirm();else if(action==='horizontal')this.focus.adjust(value);else if(action==='page')this.changePage(value);return;}\n if(this.notice){if(action==='confirm'&&typeof value==='number'){this.notice=false;this.render();}return;}\n if(this.screen==='title'){if(action==='confirm'||action==='any')this.setScreen('menu');return;}\n if(this.screen==='story'){if(action==='confirm')this.advanceStory();else if(action==='skip'||action==='more')this.skipStory();else if(action==='back')this.pause();return;}\n if(this.screen==='operation'){if(action==='pause'||action==='back')this.pause();if(action==='tool')this.setTool(value);if(action==='site')this.changeSite(value,extra);if(action==='hint')this.showHint();return;}\n if(this.screen==='lobby'&&action==='confirm'){this.join(value);return;}\n if(action==='back')this.back();else if(action==='nav')this.focus.move(value);else if(action==='confirm')this.focus.confirm();else if(action==='horizontal')this.focus.adjust(value);else if(action==='page')this.changePage(value);\n }\n execute(id,value){if(this.ended)return;this.activity(this.input.prompt);this.audio.effect('confirm',.45);\n switch(id){case'enter':this.setScreen('menu');break;case'back':this.back();break;case'storyMenu':this.overlay='storyMenu';this.renderOverlay();break;case'newGame':this.setScreen('difficulty');break;case'difficulty':this.level=value;this.save.progress=0;this.save.best={};this.modeFree=false;this.startStory('S0',()=>this.beforeOperation(0));break;case'continueStory':this.modeFree=false;this.showChart(Math.min(7,this.save.progress));break;case'free':this.modeFree=true;this.freePage=0;this.setScreen('free');break;case'selectOp':this.modeFree=true;this.showChart(+value);break;case'consult':this.consult=value;this.render();this.focus.set('consult'+value,false);break;case'begin':this.startOperation(this.chartOp,this.modeFree);break;case'continueReport':this.continueReport();break;case'advance':this.advanceStory();break;case'skip':this.skipStory();break;case'pause':this.pause();break;case'resume':this.clearOverlay();break;case'retry':this.sim?.retry();this.clearOverlay();break;case'notes':this.sim?.retry(true);this.clearOverlay();break;case'restart':if(\"'!this.inSession){const op=this.sim?.state.op??this.chartOp??0;this.startOperation(op,this.modeFree);}break;case'\"'quit':if(\"'!this.inSession){this.sim?.free();this.sim=null;this.setScreen('\"'menu');}break;case'settings':this.openSettings();break;case'about':this.aboutPage=0;this.overlay='about';this.renderOverlay();break;case'settingsPage':this.settingsPage=+value;this.renderOverlay();break;case'aboutPrev':this.changePage(-1);break;case'aboutNext':this.changePage(1);break;case'devPrev':this.changePage(-1);break;case'devNext':this.changePage(1);break;case'fullscreen':if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{});else document.documentElement.requestFullscreen?.().catch(()=>this.toast('Fullscreen is unavailable in this browser.'));break;case'lobby':this.lobby=[];this.setScreen('lobby');break;case'join':this.join('keyboard');break;case'startCoop':this.startCoop();break;case'tool':this.setTool(+value);break;case'siteDirect':this.setSite(+value);break;case'special':if(this.sim){this.sim.special(this.sim.state.seats[0]);this.processEvents();}else this.virtual.special=true;break;case'dismissStrain':this.clearOverlay();break;case'dev':if(\"'!this.inSession){this.devPage=0;this.overlay='\"'dev';this.renderOverlay();}break;case'devAction':{const [a,v]=value.split('|');this.devAction(a,v);break;}case'resetPage':this.resetTuning(false);break;case'resetAll':this.resetTuning(true);break;case'finishCredits':this.sim?.free();this.sim=null;this.setScreen('menu');break;case'sessionReady':this.sessionData?.answer('ready');break;case'sessionMore':this.sessionData?.answer('more');break;}\n }\n back(){this.audio.effect('back',.4);if(this.overlay==='dev'){this.overlay='pause';this.renderOverlay();return;}if(this.overlay==='settings'){this.overlay=this.returnOverlay;this.returnOverlay=null;this.renderOverlay();return;}if(this.overlay){if(this.overlay==='pause')this.clearOverlay();else if(this.overlay==='fail')return;else this.clearOverlay();return;}if(this.screen==='menu')this.setScreen('title');else if(this.screen==='chart')this.setScreen(this.modeFree?'free':'menu');else if(this.screen==='lobby'||this.screen==='free'||this.screen==='difficulty')this.setScreen('menu');else if(this.screen==='report')this.continueReport();else if(this.screen==='credits')this.execute('finishCredits');}\n clearOverlay(){this.overlay=null;this.renderOverlay();this.focus.reset();this.input.mouse.down=false;this.input.mouse.right=false;}\n openSettings(){this.returnOverlay=this.overlay&&this.overlay\"'!=='\"'settings'?this.overlay:null;this.overlay='settings';this.settingsPage=0;this.renderOverlay();}\n pause(){if(this.inSession){this.openSettings();return;}if(\"'!this.overlay){this.overlay='\"'pause';this.renderOverlay();}}\n changePage(d){if(this.overlay==='settings')this.settingsPage=(this.settingsPage+d+3)%3;else if(this.overlay==='about')this.aboutPage=(this.aboutPage+d+this.aboutPages().length)%this.aboutPages().length;else if(this.overlay==='dev')this.devPage=(this.devPage+d+this.devPages().length)%this.devPages().length;else if(this.screen==='free'){this.freePage=(this.freePage+d+2)%Math.max(1,Math.ceil(Math.min(7,this.save.progress+1)/6));this.render();return;}this.renderOverlay();}\n change(el){if(el.dataset.setting){const id=el.dataset.setting;let value=el.value;if(id==='level'){this.level=value;return;}if(id==='doctor'){this.freeDoctor=value;return;}if(['music','sfx','voice','aimAssist','tipSpeed','textSpeed'].includes(id))value=+value;else if(['rumble','swapSticks','shake','lineBoil'].includes(id))value=value==='true';this.settings[id]=value;this.audio.apply(this.settings);if(id==='tipSpeed'||id==='aimAssist'){this.tuning[id]=value;if(this.sim)this.sim.tuning[id]=value;}const out=this.overlayEl.querySelector('#out-'+id);if(out)out.textContent=['music','sfx','voice','aimAssist'].includes(id)?Math.round(value*100)+'%':value;writeSave(this.save);}\n if(el.dataset.tuning){const id=el.dataset.tuning;this.tuning[id]=+el.value;if(this.sim)this.sim.tuning[id]=+el.value;const out=this.overlayEl.querySelector('#tune-out-'+id);if(out)out.textContent=(+el.value).toFixed(3)+' / default '+defaults[id];}\n if(el.dataset.dev==='timeScale')this.timeScale=+el.value;\n }\n resetTuning(all){const page=this.devPages()[this.devPage],ids=all?Object.keys(defaults):(page.values||[]).map(x=>x[0]);for(const id of ids){this.tuning[id]=defaults[id];if(this.sim)this.sim.tuning[id]=defaults[id];}if(all){this.sim&&(this.sim.cheats={god:false,freezeTimer:false,infiniteComposure:false,infiniteClamps:false});this.bot=false;this.timeScale=1;this.settings.ink=this.settings.halftone=this.settings.shadows=this.settings.lineBoil=true;}this.renderOverlay();}\n setTool(n){this.input.tool=n;this.input.selected.set(this.input.lastPad,n);const seat=this.sim?.state.seats.find(s=>s.id===this.localId);if(seat)seat.tool=n;}\n setSite(n){if(\"'!this.sim)return;const s=this.sim.state;s.site=n;for(const seat of s.seats)seat.site=n;this.hud.phaseKey='\"'';this.siteCooldown=performance.now()+800;}\n changeSite(delta,padIndex){if(performance.now()<this.siteCooldown)return;const state=this.sim?.state||this.externalState;if(\"'!state)return;const n=(state.site+delta+operations[state.op].sites.length)%operations[state.op].sites.length;if(this.sim)this.setSite(n);else{const seat=state.seats.find(s=>s.id===this.localId);if(seat)seat.site=n;state.site=n;}}\n showHint(){this.hintUntil=performance.now()+6000;this.bark=this.sim?.phase.objective||'\"'Follow the highlighted objective, Doctor.';this.audio.say(this.bark,this.sim?.state.op===6?'pip':'bea');}\n startStory(id,next){this.storyId=id;this.storyLine=0;this.charCount=0;this.storyNext=next;this.setScreen('story');const data=story[id];this.view?.stage(data,data.lines[0]);this.audio.setTrack(data.mood);this.audio.say(data.lines[0].text,data.lines[0].who);this.lastStoryAdvance=performance.now();}\n advanceStory(){if(this.screen\"'!=='\"'story')return;const data=story[this.storyId],line=data.lines[this.storyLine];if(this.charCount<line.text.length){this.charCount=line.text.length;this.updateStoryText();return;}this.storyLine++;if(this.storyLine>=data.lines.length){this.storyNext?.();return;}this.charCount=0;this.render();this.view?.stage(data,data.lines[this.storyLine]);this.audio.say(data.lines[this.storyLine].text,data.lines[this.storyLine].who);this.lastStoryAdvance=performance.now();}\n updateStoryText(){const line=story[this.storyId]?.lines[this.storyLine];const el=this.screenEl.querySelector('#dialogue-text');if(el&&line)el.textContent=line.text.slice(0,Math.floor(this.charCount));}\n skipStory(){if(this.screen==='story'){this.overlay=null;this.storyNext?.();}}\n beforeOperation(op){this.save.progress=Math.max(this.save.progress,op);if(\"'!this.attract)writeSave(this.save);const scene=operations[op].scene?.before;if(scene)this.startStory(scene,()=>this.showChart(op));else this.showChart(op);}\n showChart(op){this.chartOp=op;this.freeDoctor=operations[op].doctor;this.consult='\"'careful';this.setScreen('chart');this.view?.chart?.(operations[op].patient);this.audio.setTrack('calm');}\n startOperation(op,free=false,players){this.sim?.free();this.chartOp=op;this.modeFree=free;this.seenStrains=new Set();this.sim=new Sim({op,level:this.level,tuning:this.tuning,doctor:free?this.freeDoctor:undefined,consult:this.consult,players});this.acc=0;this.input.tool=3;this.bot=this.params.get('auto')==='1';this.bark=operations[op].phases[0].say||barkFor('start');this.setScreen('operation');this.hud.phaseKey='';this.audio.setTrack(operations[op].music||'or-calm');this.audio.effect('grip');this.processEvents();}\n continueReport(){const op=this.sim.state.op;if(this.modeFree||op===8){this.setScreen(op===8?'menu':'free');return;}if(op===7){this.startStory('S16',()=>this.setScreen('credits'));return;}const after=operations[op].scene.after;this.startStory(after,()=>{if(op===6)this.startStory('S15',()=>this.showChart(7));else this.beforeOperation(op+1);});}\n join(device='keyboard'){const key=typeof device==='number'?'pad'+device:'keyboard';const exists=this.lobby.findIndex(s=>s.device===key);if(exists>=0){if(exists===0)this.startCoop();return;}if(this.lobby.length>=4)return;const i=this.lobby.length;this.lobby.push({id:i,name:key==='keyboard'?'Keyboard / Mouse':'Controller '+(Number(key.slice(3))+1),device:key,color:['#e8443a','#3b82f6','#22c55e','#f5b700'][i]});this.render();}\n startCoop(){if(\"'!this.lobby.length){this.join('\"'keyboard');return;}this.startOperation(8,true,this.lobby);}\n processEvents(){if(\"'!this.sim)return;const events=this.sim.drainEvents();for(const e of events){this.view?.event(e);if(e.type==='\"'bark'){this.bark=e.text||barkFor(e.event,this.sim.state.tick);if(this.sim.state.op===6)this.bark='“'+this.bark+'” — her notebook.';if(performance.now()-(this.lastBarkTime||0)>1200){this.audio.say(this.bark,this.sim.state.op===6?'pip':'bea');this.lastBarkTime=performance.now();}}\n if(e.type==='hint')this.showHint();if(e.type==='grade'&&\"'!this.params.has('\"'norender')){const pos=this.view?.project(e.x,e.y)||{x:innerWidth/2,y:innerHeight/2};const g=document.createElement('div');g.className='grade '+(e.grade==='MISS'?'miss':'');g.textContent=e.grade;g.style.left=pos.x+'px';g.style.top=pos.y+'px';this.toastEl.append(g);setTimeout(()=>g.remove(),950);}\n if(e.type==='strain'&&\"'!this.attract&&!this.bot&&!this.inSession&&!this.seenStrains?.has(e.strain)){this.seenStrains?.add(e.strain);this.strain=e.strain;this.overlay='\"'strain';this.renderOverlay();this.audio.setTrack(e.strain);}\n if(e.type==='phase'){this.hud.phaseKey='';if(this.sim.phase?.tools[0]&&tools.includes(this.sim.phase.tools[0]))this.setTool(tools.indexOf(this.sim.phase.tools[0]));}\n if(['defib','sforzando','hush'].includes(e.type)){this.cutIn(e.type==='defib'?'CLEAR\"'!'\"':e.type==='hush'?'THE HUSH':'SFORZANDO\"'!'\"');}\n if(e.type==='win')this.audio.effect('stamp');else if(['beat','grip','pop','deposit','stitch','ping','clamp','unclamp','inject','defib','weakShock','vent','nick','hush','sforzando','fortissimo'].includes(e.type))this.audio.effect(e.type,e.type==='beat'?.16:.7);\n if(this.settings.rumble&&['stitch','clamp','defib'].includes(e.type)){const pad=Array.from(navigator.getGamepads?.()||[]).find(p=>p?.index===this.input.lastPad);try{pad?.vibrationActuator?.playEffect('dual-rumble',{duration:e.type==='defib'?180:35,strongMagnitude:e.type==='defib'?.8:.15,weakMagnitude:.25})?.catch(()=>{});}catch{}}\n }\n const s=this.sim.state;if(s.status==='won'&&\"'!this.attract&&this.screen==='\"'operation'&&\"'!this.inSession){if(!this.modeFree){this.save.progress=Math.max(this.save.progress,Math.min(7,s.op+1));}const order='\"'SABCD',previous=this.save.best[this.sim.op.id];if(s.rank&&(\"'!previous||order.indexOf(s.rank)<order.indexOf(previous)))this.save.best[this.sim.op.id]=s.rank;writeSave(this.save);this.overlay=null;this.setScreen('\"'report');}\n if(s.status==='failed'&&\"'!this.attract&&this.screen==='\"'operation'&&\"'!this.inSession){this.overlay='\"'fail';this.renderOverlay();}\n }\n cutIn(text){if(this.attract||this.params.has('norender'))return;const el=document.createElement('div');el.className='cutin';el.textContent=text;this.toastEl.append(el);setTimeout(()=>el.remove(),1400);}\n toast(text){const el=document.createElement('div');el.className='toast';el.textContent=text;this.toastEl.append(el);setTimeout(()=>el.remove(),2800);}\n simStep(){if(\"'!this.sim||this.screen!=='\"'operation')return;for(const seat of this.sim.state.seats){const frame=(this.bot||this.attract)?botInput(this.sim,seat.id,this.testBotOptions):{...this.input.frame(seat),...this.virtual};this.sim.input(seat.id,frame);}this.sim.step();this.processEvents();}\n startAttract(){if(this.inSession||this.attract)return;this.attract=true;this.attractReturn=this.screen;this.attractStarted=performance.now();this.attractIndex=-1;this.updateAttract();}\n updateAttract(){const segments=[[0,1],[0,4],[1,1],[1,4],[2,2],[3,1],[3,4],[4,1],[4,2],[5,1],[5,4],[6,4],[6,5]];const n=Math.floor((performance.now()-this.attractStarted)/11000)%segments.length;if(n\"'!==this.attractIndex){this.attractIndex=n;const [op,phase]=segments[n];this.sim?.free();this.sim=new Sim({op,tuning:this.tuning,level:'\"'easy'});this.sim.cheats.god=true;this.sim.cheats.freezeTimer=true;this.sim.cheats.infiniteComposure=true;this.sim.cheats.infiniteClamps=true;this.sim.skipTo(phase);this.screen='operation';this.overlay=null;this.view?.setMode('attract');this.hudEl.style.display='block';this.screenEl.innerHTML='';this.overlayEl.innerHTML='';this.hud.phaseKey='';this.bot=true;this.processEvents();this.renderTouch();}if(this.sim.state.status\"'!=='\"'playing'){this.sim.state.status='playing';this.sim.skipTo(segments[n][1]);}}\n exitAttract(){if(\"'!this.attract)return;this.sim?.free();this.sim=null;this.bot=false;this.attract=false;this.setScreen(this.attractReturn||'\"'title');this.lastActivity=performance.now();}\n devAction(id,value){if(this.inSession)return;let s=this.sim?.state;const sel=n=>this.overlayEl.querySelector(\"'`[data-dev=\"${n}\"]`)?.value;const requireSim=()=>{if(!this.sim){this.startOperation(0,true);this.overlay='\"'dev';this.renderOverlay();}s=this.sim.state;};\n if(id==='unlock'){this.save.progress=7;writeSave(this.save);this.toast('All procedure charts unlocked.');return;}\n if(id==='jump'){const op=Number(value??sel('op')??0),phase=Number(sel('phase')??0);this.startOperation(op,true);this.sim.skipTo(Math.min(phase,this.sim.op.phases.length-1));this.overlay='dev';this.renderOverlay();return;}\n if(id==='story'){this.startStory(value||sel('scene')||'S1',()=>this.setScreen('menu'));return;}\n requireSim();switch(id){case'objective':this.sim.completeObjective();break;case'phase':this.sim.completePhase();break;case'win':this.sim.win();break;case'fail':this.sim.fail('FLATLINE');break;case'rank':this.sim.state.score=this.sim.op.parScore;this.sim.win();this.sim.state.rank=value||'S';break;case'step':{const current=this.overlay;this.overlay=null;this.simStep();this.overlay=current;break;}case'god':case'freezeTimer':case'infiniteComposure':case'infiniteClamps':this.sim.cheats[id]=\"'!this.sim.cheats[id];break;case'\"'bot':this.bot=\"'!this.bot;break;case'\"'resetCheats':this.sim.cheats={god:false,freezeTimer:false,infiniteComposure:false,infiniteClamps:false};this.bot=false;this.timeScale=1;break;case'bleeder':this.sim.spawn({kind:'bleeder',x:s.seats[0].x,y:s.seats[0].y},false);break;case'arrest':this.sim.arrest(12);break;case'fortissimo':{let e=s.entities.find(e=>e.kind==='crescendo');if(\"'!e)e=this.sim.spawn({kind:'\"'crescendo',x:0,y:0,size:.99},false);e.size=1.01;this.sim.step();break;}case'hush':case'sforzando':s.composure=100;s.doctor=id==='hush'?'ren':'ines';this.sim.special(s.seats[0]);break;case'strain':{const kind=value||sel('strain')||'adagio';this.sim.spawn({kind:kind==='staccato'?'note':kind,x:s.seats[0].x,y:s.seats[0].y,hp:['adagio','tremolo','coda','fermata'].includes(kind)?100:undefined,links:8,size:.2,embed:.2,axis:90,arms:2,ttl:10},false);break;}case'debug':this.debugOverlay=\"'!this.debugOverlay;break;case'\"'ink':case'halftone':case'lineBoil':case'shadows':this.settings[id]=\"'!this.settings[id];break;}\n this.processEvents();if(this.overlay==='\"'dev')this.renderOverlay();}\n hudUpdate(){const state=this.sim?.state||this.externalState;if(this.screen==='operation'&&state)this.hud.update(state);}\n renderSessionCard(){const info=this.sessionInfo;if(\"'!info)return;this.screenEl.innerHTML=`<main class=\"screen session-card\"><div class=\"top-brand\"><span class=\"eyebrow\">WARD ZERO / LIVE TEAM PROCEDURE</span><span class=\"small gold\" id=\"card-clock\">Preparing…</span></div><div class=\"session-intro\"><h1>${esc(GAME_TITLE)}</h1><h2>Grand Rounds.</h2><p>Keep the patient alive. Finish every movement together.</p><div class=\"session-players\" id=\"session-players\"></div><p class=\"muted\">${this.tokens('\"'{aim} Aim · {tools} Tools · {use} Use')}<br>\"'${this.tokens('\"'{syringe} Stabilize · {prev} / {next} Change site')}</p><div class=\\\"session-actions\\\">\"'${btn('\"'sessionReady',this.tokens('{confirm} Ready'),'primary')}\"'${btn('\"'sessionMore',this.tokens('{special} / M More time'),'secondary')}</div></div></main>\"'`;this.refreshSessionCard();}\n refreshSessionCard(data){if(data)this.cardData=data;const info=this.sessionInfo,dataNow=this.cardData||{};const list=this.screenEl.querySelector('\"'#session-players');if(list){list.replaceChildren();for(const p of info.players){const span=document.createElement('span');span.className='session-player';span.style.color=p.color;span.textContent=p.name+(dataNow.ready?.includes(p.id)?' · READY':' · SCRUBBING IN');list.append(span);}}const clock=this.screenEl.querySelector('#card-clock');if(clock)clock.textContent=dataNow.starting?'STARTING…':dataNow.paused?'TAKE YOUR TIME':dataNow.left==null?'PREPARING…':Math.ceil(dataNow.left/1000)+'s';}\n loop(){let lastRender=performance.now();const pump=()=>{if(this.ended)return;const now=performance.now(),dt=Math.min(.25,(now-this.lastPump)/1000);this.lastPump=now;this.input.poll();if(\"'!this.inSession){if(!this.attract&&!this.overlay&&['\"'title','menu','free'].includes(this.screen)&&now-this.lastActivity>=10000)this.startAttract();if(this.attract)this.updateAttract();if(this.screen==='operation'&&\"'!this.overlay){this.acc+=dt*this.timeScale;let n=0;while(this.acc>=1/60&&n<30){for(let i=0;i<this.warp;i++){if(this.overlay||this.screen!=='\"'operation')break;this.simStep();}this.acc-=1/60;n++;}}}\n if(this.screen==='story'&&\"'!this.overlay){const line=story[this.storyId].lines[this.storyLine];this.charCount=Math.min(line.text.length,this.charCount+dt*38*this.settings.textSpeed);this.updateStoryText();if((this.input.keys.has('\"'enter')||this.input.keys.has(' ')||this.input.mouse.down)&&now-this.lastStoryAdvance>450){this.charCount=line.text.length;this.advanceStory();}}\n if(now-(this.lastHUD||0)>75){this.hudUpdate();this.lastHUD=now;}\n const s=this.screen==='operation'?(this.sim?.state||this.externalState):null;this.audio.update(s);setTimeout(pump,16);};pump();\n const draw=async()=>{if(this.ended)return;const now=performance.now(),dt=Math.min(.15,(now-lastRender)/1000);this.frameMs=now-lastRender;lastRender=now;const s=this.sim?.state||this.externalState;this.view?.update(s,dt,{...this.settings,hushDuration:this.tuning.hushDuration});await this.view?.draw();requestAnimationFrame(draw);};requestAnimationFrame(draw);\n }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > src/app/session.js <<'EOF'\nimport {Sim} from '../sim/sim.js';\nimport {snapshot,keyframe,applySnapshot} from '../sim/snapshot.js';\nexport async function startSession(info,app){\n let sim=info.isHost?new Sim({op:8,players:info.players,rng:AIHub.rng('world')}):null;\n let ended=false,finished=false,started=false,acc=0,last=performance.now(),lastSnapshot=0,lastKeyframe=0,lastEvents=0,lastInput=0,lastActions=0,tokens=16,tokenAt=performance.now();\n let pendingEvents=[],localFrame={},lastDiscrete='',seq=0;\n const send=(data,reliable=false,to)=>{if(ended)return false;const now=performance.now();tokens=Math.min(16,tokens+(now-tokenAt)/1000*16);tokenAt=now;if(tokens<1)return false;const size=JSON.stringify(data).length;if(size>(reliable?15800:1100))return false;tokens--;return AIHub.send(data,{reliable,to});};\n const finish=()=>{if(\"'!sim||finished||ended)return;finished=true;const seats=sim.state.seats,scores=Object.fromEntries(seats.map(s=>[s.id,Math.max(0,Math.round(s.score))])),standings=[...seats].sort((a,b)=>b.score-a.score).map(s=>[s.id]),stats=Object.fromEntries(seats.map(s=>[s.id,{Cuts:s.stats.Cuts,Stitches:s.stats.Stitches,Burns:Math.round(s.stats.Burns),Saves:s.stats.Saves,Accuracy:Math.round(s.clean/Math.max(1,s.actions)*100)+'\"'%'}]));AIHub.finish({standings,scores,won:sim.state.status==='won',stats,awards:seats.length?[{id:[...seats].sort((a,b)=>b.clean-a.clean)[0].id,title:'Steadiest Hands',detail:'Held the rhythm together'}]:[]});};\n if(app){app.inSession=true;app.sessionInfo=info;app.localId=info.me;app.sim=sim;app.externalState=sim?null:{...newClientState(info)};app.sessionData={answer:answer=>{if(\"'!ended&&!started)AIHub.answer(answer);}};app.screen='\"'session-card';app.overlay=null;app.notice=false;app.view?.setMode('title');app.render();}\n AIHub.on('card',data=>app?.refreshSessionCard(data));\n AIHub.on('start',()=>{started=true;if(app){app.overlay=null;app.setScreen('operation');app.view?.setMode('operation');app.audio.setTrack('or-tense');}});\n AIHub.on('message',(data,from)=>{if(ended||\"'!data||typeof data!=='\"'object')return;if(sim&&(data.t==='i'||data.t==='a')){const seat=sim.state.seats.find(s=>s.id===from);if(\"'!seat)return;const frame=data.f;if(!frame||!Number.isFinite(frame.ax??frame.x??0)||!Number.isFinite(frame.ay??frame.y??0))return;if(data.n<(seat.seq||0))return;seat.seq=data.n;sim.input(from,frame);}else if(from===info.host&&app){if(data.t==='\"'k'||data.t==='s')app.externalState=applySnapshot(app.externalState,data);else if(data.t==='e')for(const e of data.e||[])app.view?.event(e);}});\n AIHub.on('leave',({id})=>{sim?.leave(id);if(app?.sessionInfo)app.sessionInfo.players=app.sessionInfo.players.filter(p=>p.id\"'!==id);});\n AIHub.on('\"'time-up',()=>{if(sim)finish();});\n AIHub.on('end',data=>{ended=true;if(app){app.audio.stop();app.screen='session-end';app.overlay=null;app.endReason=data.reason==='host-left'?'The lead surgeon disconnected. The hub has closed this round.':'Your team’s results are with the hub.';app.render();app.ended=true;}sim?.free();sim=null;});\n AIHub.ready();\n const pump=()=>{if(ended)return;const now=performance.now(),dt=Math.min((now-last)/1000,.25);last=now;if(started&&AIHub.time()>=0){\n if(app){const state=sim?.state||app.externalState,seat=state?.seats.find(s=>s.id===info.me);if(seat){localFrame={...app.input.frame(seat),...app.virtual};if(sim)sim.input(info.me,localFrame);else{\n // Local prediction is immediate, while the authoritative state arrives behind it.\n if(Number.isFinite(localFrame.x)){seat.x=localFrame.x;seat.y=localFrame.y;}else{seat.x=Math.max(-1.55,Math.min(1.9,seat.x+(localFrame.ax||0)*app.settings.tipSpeed*dt));seat.y=Math.max(-.95,Math.min(.95,seat.y+(localFrame.ay||0)*app.settings.tipSpeed*dt));}seat.tool=localFrame.tool;seat.use=localFrame.use;\n }}}\n if(sim){acc+=dt;while(acc>=1/60){sim.step();acc-=1/60;}const events=sim.drainEvents().filter(e=>e.type\"'!=='\"'beat');if(app){for(const e of events){app.view?.event(e);if(e.type==='bark')app.bark=e.text||'One patient. All hands.';if(['pop','deposit','stitch','clamp','defib','inject'].includes(e.type))app.audio.effect(e.type,.7);}}pendingEvents.push(...events);\n if(now-lastSnapshot>=105){lastSnapshot=now;send(snapshot(sim.state));}if(now-lastKeyframe>=1020){lastKeyframe=now;send(keyframe(sim.state),true);}if(pendingEvents.length&&now-lastEvents>=260){lastEvents=now;send({t:'e',e:pendingEvents.slice(-16)},true);pendingEvents=[];}if(sim.state.status\"'!=='\"'playing')finish();\n }else{if(now-lastInput>=86){lastInput=now;send({t:'i',n:++seq,f:localFrame},false,info.host);}const discrete=JSON.stringify([localFrame.syringe,localFrame.special,localFrame.alt,localFrame.site]);if(discrete\"'!==lastDiscrete&&now-lastActions>340){lastActions=now;lastDiscrete=discrete;send({t:'\"'a',n:++seq,f:localFrame},true,info.host);}}\n }else if(app&&started){const left=Math.ceil(-AIHub.time()/1000);let countdown=document.getElementById('countdown');if(\"'!countdown){countdown=document.createElement('\"'div');countdown.id='countdown';countdown.className='countdown';app.toastEl.append(countdown);}countdown.textContent=left>0?left:'';if(left<=0)countdown.remove();}\n if(AIHub.time()>=0)document.getElementById('countdown')?.remove();setTimeout(pump,16);};pump();\n return{finish,stop:()=>{ended=true;}};\n}\nfunction newClientState(info){return{op:8,phase:0,phaseTime:0,tick:-1,elapsed:0,vitals:100,minVitals:100,timer:300,score:0,combo:0,bestCombo:0,misses:0,actions:0,flawless:0,rank:null,doctor:'ren',composure:0,hush:0,sforzando:0,beat:0,bar:0,beatPhase:0,bpm:82,pulse:0,site:0,entities:[],tray:[],seats:info.players.map(p=>({...p,x:0,y:0,tool:3,site:0,use:0,cooldown:0})),status:'playing',arrest:false,objective:'Split the work. Keep the patient alive.'};}\nEOF\ncat > src/data/about.json <<'EOF'\n{\n \\\"sourceInformation\\\": {\n  \\\"date\\\": \\\"2026-11-05 05:18:47\\\",\n  \\\"source\\\": \\\"Trauma Center: Second Opinion\\\",\n  \\\"plan\\\": \\\"PLAN.md\\\",\n  \\\"genre\\\": \\\"Surgical action (arcade operation game) with a visual-novel story\\\",\n  \\\"perspective\\\": \\\"First-person surgeon’s-eye 3D operative field; staged third-person story scenes\\\",\n  \\\"tech\\\": \\\"Three.js 0.180.0, WebGPU with WebGL2 fallback, TSL ink filter, Rapier 0.19.3, Web Audio, Gamepad API, esbuild 0.28.2, AI Hub session client 1.4.0\\\",\n  \\\"artDirection\\\": \\\"Comic-book medical drama. Procedural toon geometry, ink outlines, manga tone, hand-painted organ textures made in code.\\\",\n  \\\"animation\\\": \\\"Three.js AnimationMixer, code-built keyframe clips, skinned strains, beat-driven organs and procedural follow-through\\\",\n  \\\"audio\\\": \\\"Original synthesized sequencer music, procedural effects, text-driven gibberish voices. Music 10%; effects and voices 80% by default.\\\",\n  \\\"online\\\": \\\"AI Hub Session Protocol v1, shared world, 1–4 players. Standalone couch co-op.\\\",\n  \\\"testing\\\": \\\"Headless Node and Playwright tests, full bot campaign, protocol harness, synthesized audio checks, visual and responsive screenshots. Final results pending.\\\",\n  \\\"research\\\": \\\"Supplied game plan and verified engine recipes; the official AI Hub protocol, client and harness.\\\",\n  \\\"environment\\\": \\\"Codex CLI (headless); Linux\\\",\n  \\\"model\\\": \\\"OpenAI, gpt-6.1-sol, reasoning effort max\\\",\n  \\\"usage\\\": \\\"added on import\\\"\n },\n \\\"testingFeedback\\\": [\\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\"],\n \\\"engineFeedback\\\": [\\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\", \\\"none\\\", \\\"unknown\\\"],\n \\\"promptFeedback\\\": [\\\"The heartbeat pillar gives every system a common purpose.\\\", \\\"The plan’s bot minimum-vitals target conflicts with scripted arrests at 15 vitals; scripted events need separate checks.\\\", \\\"Making every surgical tool feel distinct while sharing simulation logic across solo, co-op and the bot.\\\", \\\"Define test invariants for scripted vital dips separately from ordinary danger.\\\"]\n}\nEOF\ncat > src/main.js <<'EOF'\nimport {initPhysics} from './sim/physics.js';\nimport {createView} from './view/renderer.js';\nimport {App} from './app/director.js';\nimport {startSession} from './app/session.js';\nconst params=new URLSearchParams(location.search);\nwindow.__game={state:()=>({screen:'Boot',renderBackend:'loading'})};\nconst fail=(error)=>{const text=error?.message||String(error);if(AIHub.active){AIHub.fail(text);return;}document.getElementById('boot')?.remove();document.getElementById('screen').innerHTML='<main class=\\\"screen no-graphics\\\"><span class=\\\"eyebrow gold\\\">ST. ALDER / GRAPHICS SUPPORT</span><h2>The theatre could not open.</h2><p>This game needs WebGPU or WebGL 2. Try another browser or the compatibility renderer.</p><button class=\\\"primary\\\" id=\\\"compatibility\\\">Use compatibility renderer ↗</button><p class=\\\"small muted\\\" id=\\\"graphics-message\\\"></p></main>';document.getElementById('graphics-message').textContent=text;document.getElementById('compatibility').onclick=()=>{const url=new URL(location.href);url.searchParams.set('webgl','1');location.href=url.href;};window.__game={state:()=>({screen:'No graphics',renderBackend:'unavailable'})};};\ntry{\n const info=await AIHub.connect({mode:'shared-world',seats:[1,4],card:true});\n await initPhysics();\n if(info?.server){document.getElementById('boot')?.remove();await startSession(info,null);}else{\n const view=await createView(document.body,{forceWebGL:params.get('webgl')==='1',noRender:params.get('norender')==='1',onError:fail});\n const app=new App({view,params,session:\"'!!info});document.getElementById('\"'boot')?.remove();\n if(info)await startSession(info,app);app.loop();\n }\n}catch(error){console.error(error);fail(error);}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/ui/focus.js');s=p.read_text().replace(\\\"items(){return [...this.root.querySelectorAll('[data-focus]')].filter\\\", \\\"items(){const scope=this.root.querySelector('#overlays')?.children.length?this.root.querySelector('#overlays'):this.root.querySelector('#touch')?.children.length?this.root.querySelector('#touch'):this.root.querySelector('#screen')?.children.length?this.root.querySelector('#screen'):this.root;return [...scope.querySelectorAll('[data-focus]')].filter\\\");p.write_text(s)\np=Path('src/view/renderer.js');s=p.read_text().replace(\\\"storyRoot.visible=mode==='story';\\\",\\\"storyRoot.visible=mode==='story'||mode==='chart';\\\").replace(\\\"else if(mode==='story'){\\\", \\\"else if(mode==='story'||mode==='chart'){\\\")\ns=s.replace(\\\"function speak(line)\\\",\\\"function chart(patient){mode='chart';for(const b of busts)storyRoot.remove(b.root);const b=createBust('patient',{...patient.bust,name:patient.name,coat:'#6ba0a0',hair:'#383944',eyes:'#4f6473',age:patient.age});b.root.position.set(2,.6,0);b.root.scale.setScalar(.7);storyRoot.add(b.root);busts=[b];}\\\\n function speak(line)\\\")\ns=s.replace('setMode,stage,speak,event,project', 'setMode,stage,chart,speak,event,project')\np.write_text(s)\nPY\nnpm run build\nnode tools/serve.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor name in ['src/view/field.js','src/ui/ecg.js']:\n p=Path(name);s=p.read_text().replace('Math.exp(-((','Math.exp(-1*((');p.write_text(s)\nPY\nnpm run build\ncat > tests/browser/probe.mjs <<'EOF'\nimport {chromium} from 'playwright';\nconst browser=await chromium.launch({headless:true,args:['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-webgpu-adapter=swiftshader','--use-angle=swiftshader']});\nconst page=await browser.newPage({viewport:{width:1280,height:720}});page.on('pageerror',e=>console.log('PAGE ERROR',e.message));page.on('console',m=>{if(m.type()==='error'||m.type()==='warning')console.log(m.type(),m.text().slice(0,500));});\nawait page.goto('http://127.0.0.1:37593/dist/game.html?test=1');await page.waitForTimeout(8000);console.log(await page.evaluate(()=>window.__game.state()));await page.screenshot({path:'artifacts/first-title.png'});\nawait page.keyboard.press('Enter');await page.waitForTimeout(1000);console.log(await page.evaluate(()=>window.__game.state().screen));await page.screenshot({path:'artifacts/first-menu.png'});await page.evaluate(()=>{__game.test.skipTo(0,1)});await page.waitForTimeout(3000);console.log(await page.evaluate(()=>window.__game.state()));await page.screenshot({path:'artifacts/first-operation.png'});await browser.close();\nEOF\nnode tests/browser/probe.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
