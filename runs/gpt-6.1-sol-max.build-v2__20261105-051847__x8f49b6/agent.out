{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/data/ops/index.js');s=p.read_text().replace(\\\"{...wound(0,0,8,1.1),site:2},bleeder(-.7,.15)\\\",\\\"{...wound(0,0,8,1.1),site:2},zone(.7,.26),{...zone(.7,.26),site:1},{...zone(.7,.26),site:2},bleeder(-.7,.15)\\\")\ns=s.replace(\\\"phase('arrest','One heart. Any surgeon’s shock counts.',['defib','syringe'],[]\\\", \\\"phase('arrest','One heart. Any surgeon’s shock counts.',['defib','syringe'],[e('injection',-.5,0,{site:0}),e('injection',0,0,{site:1}),e('injection',.5,0,{site:2})]\\\")\np.write_text(s)\np=Path('src/sim/bot.js');s=p.read_text().replace('export function botInput(', 'function decideInput(').replace('(danger||s.arrest?1:',\\\"(danger||s.arrest?(s.op===4?.68:1):\\\")\ns=s.replace(\\\"let dx=x-seat.x,dy=y-seat.y,d=Math.hypot(dx,dy),step=\\\", \\\"const n=noise*Math.sin(s.tick*.017+id),ny=noise*Math.cos(s.tick*.019+id);let dx=x+n-seat.x,dy=y+ny-seat.y,d=Math.hypot(dx,dy),step=\\\")\ns=s.replace(\\\"const n=noise?Math.sin(s.tick*.17+id)*noise:0;return{...base,x:seat.x+dx+n*.06,y:seat.y+dy+n*.06\\\", \\\"return{...base,x:seat.x+dx,y:seat.y+dy\\\")\ns+='''\\\\nconst reactions=new WeakMap();\\\\nexport function botInput(sim,id=0,opts={}){const frame=decideInput(sim,id,opts);if(\"'!(opts.reactionDelay>0))return frame;let map=reactions.get(sim);if(!map){map=new Map();reactions.set(sim,map);}let memory=map.get(id);if(!memory){memory={tool:frame.tool,until:0};map.set(id,memory);}if(frame.tool!==memory.tool){memory.tool=frame.tool;memory.until=sim.state.elapsed+opts.reactionDelay;}if(sim.state.elapsed<memory.until&&!sim.state.arrest)return{...frame,use:0};return frame;}'\"\\\\n'''\np.write_text(s)\nPY\nnode tests/run-all.mjs sim\nnpm run build\ncat > tests/browser/visual-probe.mjs <<'EOF'\nimport {chromium} from 'playwright';\nconst b=await chromium.launch({headless:true});const p=await b.newPage({viewport:{width:1920,height:1080}});p.on('pageerror',e=>console.log('ERROR',e.message));await p.goto('http://127.0.0.1:37593/dist/game.html?test=1&webgl=1');await p.waitForFunction(()=>__game.state().screen==='Title');await p.keyboard.press('Enter');await p.waitForTimeout(1200);await p.screenshot({path:'artifacts/menu-1080.png'});await p.click('[data-action=storyMenu]');await p.click('[data-action=newGame]');await p.click('[data-action=difficulty][data-value=normal]');await p.waitForTimeout(1600);await p.screenshot({path:'artifacts/story-1080.png'});await p.keyboard.press('Tab');await p.keyboard.press('Tab');await p.waitForTimeout(1300);await p.screenshot({path:'artifacts/chart-1080.png'});await p.evaluate(()=>{__game.test.skipTo(0,1)});await p.waitForTimeout(1300);await p.screenshot({path:'artifacts/operation-1080.png'});await b.close();\nEOF\nnode tests/browser/visual-probe.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
