{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/sim/bot.js');s=p.read_text().replace('tool,use=0,speed=.55,extra={}',\\\"tool,use=0,speed=s.entities.some(e=>e.kind==='crescendo'&&\"'!e.done)?1.1:.55,extra={}\")\ns=s.replace(\"let req=all.filter(e=>e.required&&e.kind!=='\"'bleeder');\\\", \\\"let req=all.filter(e=>e.required&&e.kind\"'!=='\"'bleeder'&&\"'!s.seats.some(p=>p.id!==seat.id&&p.held===e.id));\")\np.write_text(s)\np=Path('\"'src/sim/sim.js');s=p.read_text().replace(\\\"extractKinds.includes(e.kind)&&(\"'!e.hp\", \"extractKinds.includes(e.kind)&&!s.seats.some(p=>p.held===e.id)&&(!e.hp\")\np.write_text(s)\np=Path('\"'src/data/ops/index.js');s=p.read_text().replace(\\\"zone(.7,.26),{...zone(.7,.26),site:1},{...zone(.7,.26),site:2}\\\", \\\"zone(.8,.28),{...zone(.8,.28),site:1},{...zone(.8,.28),site:2}\\\").replace(\\\"{...wound(0,0,6,1),site:2},zone(1.2,.4)]\\\", \\\"{...wound(0,0,6,1),site:2},zone(1.3,.46)]\\\")\np.write_text(s)\nPY\nnode tests/run-all.mjs sim\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
