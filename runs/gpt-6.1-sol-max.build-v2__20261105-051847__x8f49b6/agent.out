{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser/suite.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {chromium,webkit,firefox,devices} from 'playwright';\nimport http from 'node:http';\nimport {readFileSync,readdirSync,statSync} from 'node:fs';\nimport path from 'node:path';\nimport {createHash} from 'node:crypto';\nimport {operations} from '../../src/data/ops/index.js';\nimport {defaults} from '../../src/config/tuning.js';\nimport {GAME_TITLE} from '../../src/config/identity.js';\nexport const GPU=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-webgpu-adapter=swiftshader','--use-angle=swiftshader'];\nexport async function server(){const s=http.createServer((req,res)=>{const file=decodeURIComponent(new URL(req.url,'http://local').pathname),p=path.resolve('.','.'+(file==='/'?'/dist/game.html':file));if(\"'!p.startsWith(process.cwd()+path.sep)){res.writeHead(403).end();return;}try{res.setHeader('\"'Content-Type',p.endsWith('.js')?'text/javascript':p.endsWith('.json')?'application/json':'text/html');res.end(readFileSync(p));}catch{res.writeHead(404).end();}});await new Promise(r=>s.listen(0,'127.0.0.1',r));return{url:\"'`http://127.0.0.1:${s.address().port}`,close:()=>new Promise(r=>s.close(r))};}\nconst padInit=()=>{const mk=i=>({id:'\"'Synthetic DualSense',index:i,connected:true,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0})),vibrationActuator:null});window.__pads=[mk(0),mk(1),mk(2),mk(3)];navigator.getGamepads=()=>window.__pads;};\nconst errors=[];\nasync function boot(browser,url,query='test=1&norender=1&webgl=1',options={}){const context=await browser.newContext({viewport:{width:1280,height:720},...options});const page=await context.newPage();page.setDefaultTimeout(15000);page.on('pageerror',e=>errors.push(e.message));await page.goto(url+'/dist/game.html?'+query);await page.waitForFunction(()=>window.__game&&__game.state().screen\"'!=='\"'Boot');assert.notEqual(await page.evaluate(()=>__game.state().screen),'No graphics');return{context,page};}\nconst state=p=>p.evaluate(()=>__game.state());\nconst click=(p,action,value)=>p.locator(\"'`[data-action=\"${action}\"]${value==null?'\"'':\"'`[data-value=\"${value}\"]`}`).first().click({force:true});\nconst pad=async(p,id,button,value)=>{await p.evaluate(({id,button,value})=>{__pads[id].buttons[button]={pressed:value>.5,touched:value>0,value};},{id,button,value});await p.waitForTimeout(65);};\nasync function pressPad(p,id,b){await pad(p,id,b,1);await pad(p,id,b,0);}\nconst allFiles=dir=>readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?allFiles(path.join(dir,e.name)):[path.join(dir,e.name)]);\nexport async function run(test){const srv=await server();let browser;\n await test('\"'package / one self-contained HTML with a pristine protocol client and embedded fonts',()=>{const html=readFileSync('dist/game.html','utf8'),client=readFileSync('tools/vendor/session.js','utf8').trimEnd(),sha=createHash('sha256').update(client).digest('hex');assert.equal(sha,'529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a');assert.equal(html.split('/*\"'! aihub-session '\"').length-1,1);assert.ok(html.includes('<script>\\\\n'+client+'\\\\n</script>'));assert.ok(\"'!/<script[''^>]+src=|url'\"\\\\([\\\"']?https?:/i.test(html));for(const [n,v]of Object.entries({'session':'1','session-players':'1-4','session-mode':'shared-world'}))assert.ok(html.includes(\"'`<meta name=\"hub:${n}\" content=\"${v}\">`));assert.ok(!html.includes('\"'hub:webgpu'));assert.ok(html.includes('data:font/woff2'));for(const file of allFiles('src')){const txt=readFileSync(file,'utf8');assert.ok(\"'!/TODO|FIXME|placeholder|stub/i.test(txt),file);if(file.includes('\"'/sim/'))assert.ok(\"'!txt.includes('\"'Math.random'),file);if(file\"'!=='\"'src/config/identity.js')assert.ok(\"'!txt.includes(GAME_TITLE),file);}const root=path.join('\"'..',path.basename(process.cwd())+'.html');assert.equal(statSync(root).size,statSync('dist/game.html').size);});\n for(const [name,type,args,query]of [['WebGPU',chromium,GPU,'test=1'],['WebGL2',chromium,[],'test=1&webgl=1'],['WebKit',webkit,[],'test=1&webgl=1']])await test(\"'`graphics / ${name} boots and produces an inked frame`,async()=>{browser=await type.launch({headless:true,args});try{const {context,page}=await boot(browser,srv.url,query,{viewport:{width:960,height:540}});await page.evaluate(()=>__game.test.idle(-600000));await page.waitForTimeout(name==='\"'WebGPU'?1800:900);const s=await state(page);assert.equal(s.renderBackend,name==='WebGPU'?'webgpu':'webgl2');await page.screenshot({path:\"'`artifacts/boot-${name.toLowerCase()}.png`});assert.ok(statSync(`artifacts/boot-${name.toLowerCase()}.png`).size>24000);assert.ok(await page.evaluate(()=>document.fonts.check('\"'16px Bangers')));await context.close();}finally{await browser.close();}});\n browser=await chromium.launch({headless:true});\n try{\n await test('input / keyboard, mouse, native menu focus and all eight tool slots',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');assert.equal((await state(page)).screen,'Main Menu');await page.hover('[data-action=\\\"free\\\"]');assert.equal((await state(page)).focusId,'free');await click(page,'free');assert.equal((await state(page)).screen,'Free Play');await page.evaluate(()=>__game.test.skipTo(0,1));for(let i=1;i<=8;i++){await page.keyboard.press(String(i));await page.waitForTimeout(40);assert.equal((await state(page)).tool,i-1);}const before=(await state(page)).tips[0].x;await page.keyboard.down('d');await page.waitForTimeout(250);await page.keyboard.up('d');assert.ok((await state(page)).tips[0].x>before+.25);await page.mouse.move(700,300);await page.waitForTimeout(50);assert.equal((await state(page)).promptSet,'mouse');}finally{await context.close();}});\n await test('input / analog triggers, right-stick speed, left-stick flick and disconnect pause',async()=>{const context=await browser.newContext({viewport:{width:1280,height:720}});await context.addInitScript(padInit);const page=await context.newPage();try{await page.goto(srv.url+'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Title');await page.evaluate(()=>__game.test.skipTo(0,1));await page.evaluate(()=>{__pads[0].axes=[0,0,1,0];});await page.waitForTimeout(60);const before=(await state(page)).tips[0].x;await page.waitForTimeout(700);await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];});await page.waitForTimeout(40);const distance=(await state(page)).tips[0].x-before;assert.ok(distance>1.17&&distance<1.5,\"'`distance ${distance}`);await pad(page,0,7,.62);assert.ok(Math.abs((await state(page)).tips[0].use-.62)<.01);await pad(page,0,7,0);await page.evaluate(()=>{__pads[0].axes=[1,0,0,0];});await page.waitForTimeout(70);assert.equal((await state(page)).tool,2);assert.equal((await state(page)).promptSet,'\"'pad');await page.evaluate(()=>{__pads[0].connected=false;});await page.waitForTimeout(80);assert.equal((await state(page)).screen,'Pause');}finally{await context.close();}});\n await test('settings / glyphs, live audio gains and save persistence',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');await click(page,'settings');assert.equal((await state(page)).musicGain,Math.fround(.1));await click(page,'settingsPage',1);await page.selectOption('[data-setting=glyphs]','xbox');await page.locator('[data-setting=tipSpeed]').fill('2.5');assert.equal((await state(page)).tuning.tipSpeed,2.5);assert.equal((await state(page)).glyphSet,'xbox');await page.reload();await page.waitForFunction(()=>__game.state().screen==='Title');assert.equal((await state(page)).glyphSet,'xbox');assert.equal((await state(page)).tuning.tipSpeed,2.5);}finally{await context.close();}});\n await test('dev / pause access, live tuning, page and global resets',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.evaluate(()=>__game.test.skipTo(0,1));await page.keyboard.press('Escape');assert.equal((await state(page)).screen,'Pause');await click(page,'dev');assert.equal((await state(page)).devOpen,true);for(let i=0;i<5;i++)await page.keyboard.press('e');await page.locator('[data-tuning=tipSpeed]').fill('3');assert.equal((await state(page)).tuning.tipSpeed,3);await click(page,'resetPage');assert.equal((await state(page)).tuning.tipSpeed,defaults.tipSpeed);await page.locator('[data-tuning=tipSpeed]').fill('2.5');await click(page,'resetAll');assert.deepEqual((await state(page)).tuning,defaults);for(const id of ['god','freezeTimer','infiniteComposure','infiniteClamps','bot','resetCheats','bleeder','strain','arrest','fortissimo','hush','sforzando','debug','ink','halftone','lineBoil','shadows','step','objective','unlock'])await page.evaluate(id=>__game.test.dev(id),id);assert.equal((await state(page)).progress,7);await page.evaluate(()=>__game.test.dev('phase'));await page.evaluate(()=>__game.test.dev('rank'));assert.equal((await state(page)).screen,'Report');}finally{await context.close();}});\n await test('campaign / real menu flow through every chart, operation, scene and credits',async()=>{const {context,page}=await boot(browser,srv.url);const reached=[];try{await page.keyboard.press('Enter');await click(page,'storyMenu');await click(page,'newGame');await click(page,'difficulty','normal');let iterations=0;while(iterations++<65){const s=await state(page);reached.push(s.screen);if(s.screen==='Story'){await page.keyboard.press('Tab');}else if(s.screen==='Chart'){await click(page,'begin');await page.evaluate(()=>{__game.test.bot(true);__game.test.warp(500);});}else if(s.screen==='Operation'){await page.waitForFunction(()=>\"'!['\"'Operation','Strain card'].includes(__game.state().screen),{timeout:30000});}else if(s.screen==='Report'){assert.ok(s.op===7||['S','A'].includes(s.rank),\"'`${s.op}: ${s.rank}`);await click(page,'\"'continueReport');}else if(s.screen==='Credits roll')break;else throw new Error('Unexpected '+s.screen);}const end=await state(page);assert.equal(end.screen,'Credits roll');for(const name of ['Title','Main Menu','Story','Chart','Operation','Report','Credits roll'])assert.ok(end.reached.includes(name),name);assert.equal(end.progress,7);await page.reload();await page.waitForFunction(()=>__game.state().screen==='Title');assert.equal((await state(page)).progress,7);}finally{await context.close();}});\n await test('recovery / failure, repeated phase retry and optional Bea’s Notes',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.evaluate(()=>{__game.test.skipTo(0,1);__game.test.dev('fail');});assert.equal((await state(page)).screen,'Fail');await click(page,'retry');await page.evaluate(()=>__game.test.dev('fail'));assert.ok(await page.locator('[data-action=notes]').count());await click(page,'notes');assert.equal((await state(page)).notes,true);assert.ok((await state(page)).vitals>=60);}finally{await context.close();}});\n await test('about / all feedback blocks and source fields are paged and readable',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');await click(page,'about');const data=await page.evaluate(()=>JSON.parse(document.getElementById('about-data').textContent));for(const block of ['sourceInformation','testingFeedback','engineFeedback','promptFeedback'])assert.ok(data[block]);const seen=new Set();for(let i=0;i<16;i++){seen.add(await page.locator('.modal h2').textContent());await page.keyboard.press('e');}for(const name of ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','Credits'])assert.ok(seen.has(name),name);assert.equal(await page.locator('.focused').count(),1);}finally{await context.close();}});\n await test('couch / two independent controllers join, move and score',async()=>{const context=await browser.newContext({viewport:{width:1280,height:720}});await context.addInitScript(padInit);const page=await context.newPage();try{await page.goto(srv.url+'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Title');await page.keyboard.press('Enter');await click(page,'lobby');await pressPad(page,0,0);await pressPad(page,1,0);assert.equal(await page.locator('.seat-card.joined').count(),2);await click(page,'startCoop');await page.evaluate(()=>{__pads[0].axes=[0,0,1,0];__pads[1].axes=[0,0,-1,0];});await page.waitForTimeout(250);await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];__pads[1].axes=[0,0,0,0];});const s=await state(page);assert.ok(s.tips[0].x>s.tips[1].x+.3);await page.evaluate(()=>{__game.test.bot(true);__game.test.warp(500);});await page.waitForFunction(()=>__game.state().screen==='Report',{timeout:30000});assert.ok((await state(page)).tips.every(s=>s.score>0));}finally{await context.close();}});\n await test('audio / every original track, procedural effect and voice renders non-silent samples',async()=>{const {context,page}=await boot(browser,srv.url);try{const bundle=readFileSync('src/audio/engine.js','utf8');const outputs=await page.evaluate(async source=>{const module=await import(URL.createObjectURL(new Blob([source],{type:'text/javascript'})));const result=[];for(const [kind,names]of [['music',module.tracks],['sfx',module.effects],['voice',['ren','bea','bell','pip','sorrento','ines','voss']]])for(const name of names){const ctx=new OfflineAudioContext(1,24000,24000);if(kind==='music')module.musicStep(ctx,ctx.destination,name,0,0,.3,3);else if(kind==='sfx')module.synthSfx(ctx,ctx.destination,name,0);else module.voiceLine(ctx,ctx.destination,'Doctor, steady hands\"'!'\"',name,0);const b=await ctx.startRendering();const d=b.getChannelData(0);let sum=0;for(const n of d)sum+=n*n;result.push([kind,name,Math.sqrt(sum/d.length)]);}return result;},bundle);for(const [kind,name,rms]of outputs)assert.ok(rms>.00005,\"'`${kind}/${name} silent ${rms}`);for(const file of allFiles('\"'src'))assert.ok(\"'!/'\"\\\\.(mp3|wav|ogg|m4a|flac)\\\\b/i.test(readFileSync(file,'utf8')));}finally{await context.close();}});\n await test('attract / actual 10-second idle threshold, exits without writing a save',async()=>{const {context,page}=await boot(browser,srv.url);try{const before=await page.evaluate(()=>JSON.stringify(localStorage));await page.waitForTimeout(9200);assert.equal((await state(page)).attract,false);await page.waitForTimeout(1100);assert.equal((await state(page)).attract,true);const ops=new Set([(await state(page)).op]);for(let i=0;i<3;i++){await page.waitForTimeout(11100);ops.add((await state(page)).op);}assert.ok(ops.size>=3,JSON.stringify([...ops]));await page.keyboard.press('x');assert.equal((await state(page)).attract,false);assert.equal(await page.evaluate(()=>JSON.stringify(localStorage)),before);for(const kind of ['mouse','pad']){await page.evaluate(()=>__game.test.idle(11000));await page.waitForTimeout(60);assert.equal((await state(page)).attract,true);if(kind==='mouse')await page.mouse.move(500,300);else{await page.evaluate(padInit);await pressPad(page,0,0);}assert.equal((await state(page)).attract,false);}}finally{await context.close();}});\n }finally{await browser.close();}\n for(const [name,type,device]of [['Android',chromium,'Pixel 7'],['iPhone WebKit',webkit,'iPhone 15']])await test(\"'`touch / ${name} exact notice, tap settings, attract and keyboard escape`,async()=>{browser=await type.launch({headless:true});const context=await browser.newContext({...devices[device]});const page=await context.newPage();try{await page.goto(srv.url+'\"'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Touch notice');await page.getByRole('heading',{name:'Controller or keyboard required',exact:true}).waitFor();assert.equal(await page.locator('.tool-dock:visible').count(),0);await page.getByRole('button',{name:'Settings',exact:true}).tap();assert.equal((await state(page)).screen,'Settings');await page.getByRole('button',{name:'Done',exact:true}).tap();await page.evaluate(()=>__game.test.idle(11000));await page.waitForTimeout(100);assert.ok((await state(page)).attract);await page.touchscreen.tap(15,200);assert.ok(\"'!(await state(page)).attract);await page.keyboard.press('\"'x');assert.equal((await state(page)).screen,'Title');}finally{await context.close();await browser.close();}});\n await test('graphics / unsupported Firefox displays a recoverable graphics message',async()=>{browser=await firefox.launch({headless:true});try{const context=await browser.newContext();const p=await context.newPage();await p.goto(srv.url+'/dist/game.html?test=1&webgl=1');await p.waitForFunction(()=>__game.state().screen\"'!=='\"'Boot');const s=await state(p);assert.ok(['Title','No graphics','Touch notice'].includes(s.screen));if(s.screen==='No graphics')assert.ok(await p.locator('#compatibility').isVisible());await context.close();}finally{await browser.close();}});\n await test('runtime / no unexpected page errors',()=>assert.deepEqual(errors,[]));\n await srv.close();return{pageErrors:errors};\n}\nEOF\nnpm run build\nnode tests/run-all.mjs browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"agent_message","text":"All 60 simulation checks now pass, including the full campaign, the imprecise bot on Easy, idle failures, and Grand Rounds with one to four surgeons. Browser checks are running for graphics, controls, campaign flow, saves, dev tools, audio, and touch-only screens.\n"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"cat >> ../PROGRESS.md <<'EOF'\n\n## Simulation verified\n- \"'`node tests/run-all.mjs sim`: 60 passed, 0 failed.\n- Normal campaign bot completes all procedures at A or S; imprecise/delayed bot completes all main procedures on Intern; idle fails; Grand Rounds 1–4 seats completes with contributions.\n- Rule coverage includes beat pressure, input curves, all instruments, gifts, scoring, retry/assist, seven strains, snapshot MTU, determinism, data/story lint.\n- Added finish gel to Coda’s three sites and the missing Grand Rounds antidote sites.\n- Browser suite now running (WebGPU, WebGL2, WebKit; controls; campaign UI; saves/settings/dev; audio; attract; mobile notice).\n\n## Further bugs fixed\n5. A finished incision could nick the patient immediately while the player released the button; added a short safe release interval.\n6. Forceps treated an axis of zero as the default 90°; fixed null handling.\n7. Dropping an incompletely extracted item moved its anchor, eventually making a long pull impossible (critical); it now springs back to its original anchor.\n8. The bot released a grip to use the IV, and could swing a scalpel before its simulated reaction delay elapsed; fixed held inputs and crossing behavior.\n9. Recurring spore cleanup could distract the bot forever from the spawning nest; it now treats the source first and spawn counts are bounded.\n10. Portrait placement, tray framing and excessive wet glints failed visual inspection; adjusted.\n- Tally so far: 10 distinct issues; 4 critical (1, 2, 3, 7). Finalize after browser/hub checks.\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"cat >> ../PROGRESS.md <<'EOF'\n\n## Simulation verified\n- \"'`node tests/run-all.mjs sim`: 60 passed, 0 failed.\n- Normal campaign bot completes all procedures at A or S; imprecise/delayed bot completes all main procedures on Intern; idle fails; Grand Rounds 1–4 seats completes with contributions.\n- Rule coverage includes beat pressure, input curves, all instruments, gifts, scoring, retry/assist, seven strains, snapshot MTU, determinism, data/story lint.\n- Added finish gel to Coda’s three sites and the missing Grand Rounds antidote sites.\n- Browser suite now running (WebGPU, WebGL2, WebKit; controls; campaign UI; saves/settings/dev; audio; attract; mobile notice).\n\n## Further bugs fixed\n5. A finished incision could nick the patient immediately while the player released the button; added a short safe release interval.\n6. Forceps treated an axis of zero as the default 90°; fixed null handling.\n7. Dropping an incompletely extracted item moved its anchor, eventually making a long pull impossible (critical); it now springs back to its original anchor.\n8. The bot released a grip to use the IV, and could swing a scalpel before its simulated reaction delay elapsed; fixed held inputs and crossing behavior.\n9. Recurring spore cleanup could distract the bot forever from the spawning nest; it now treats the source first and spawn counts are bounded.\n10. Portrait placement, tray framing and excessive wet glints failed visual inspection; adjusted.\n- Tally so far: 10 distinct issues; 4 critical (1, 2, 3, 7). Finalize after browser/hub checks.\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"rg -n '__hubCheck|play=|data-complete|auto|pass|console' tests/hub/site/harness.html | head -n 65 && viewport-matrix --help\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"rg -n '__hubCheck|play=|data-complete|auto|pass|console' tests/hub/site/harness.html | head -n 65 && viewport-matrix --help\"","aggregated_output":"12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n238:      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n406:  const check = (name, pass, detail = '') => {\n407:    checks.push({ name, pass: !!pass, detail });\n409:    return !!pass;\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n416:      check('game named', false, 'pass ?game=<path> of a page on this site');\n525:    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n528:    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n536:      li.className = c.pass ? 'ok' : 'bad';\n537:      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n544:if (auto) conformance();\nusage: viewport-matrix [-h] [-o OUT] [--engines ENGINES] [--all-engines]\n                       [--only ONLY] [--devices DEVICES] [--full-page]\n                       [--dpr1] [--wait WAIT] [--timeout TIMEOUT] [--headed]\n                       url\n\nScreenshot a URL across phone / foldable / tablet / desktop viewports in Chromium, WebKit and Firefox.\n\nWrites one PNG per (device, engine) plus index.html (contact sheet drawn to relative scale) and\nreport.json, and flags horizontal overflow, console errors, page errors and failed requests.\n\nBy default each device runs on the engine it really ships with (iPhone/iPad -> WebKit,\nAndroid -> Chromium) and desktop sizes run on all three engines.\n\n  viewport-matrix http://localhost:5173\n  viewport-matrix http://localhost:5173/play -o /tmp/shots --full-page\n  viewport-matrix URL --engines firefox              # everything in Firefox\n  viewport-matrix URL --all-engines                  # every device x every engine\n  viewport-matrix URL --only phone,foldable --dpr1   # small files, mobile only\n\npositional arguments:\n  url\n\noptions:\n  -h, --help         show this help message and exit\n  -o, --out OUT      output dir (default: $TMPDIR/viewport-matrix/<timestamp>)\n  --engines ENGINES  comma list from chromium,webkit,firefox\n  --all-engines      run every device on every selected engine\n  --only ONLY        comma list of categories: phone,foldable,tablet,desktop\n  --devices DEVICES  comma list of Playwright device names to use instead of\n                     the built-in matrix\n  --full-page        capture the whole scrollable page, not just the viewport\n  --dpr1             force device pixel ratio 1 (smaller PNGs)\n  --wait WAIT        extra ms to wait after load for animations (default 800)\n  --timeout TIMEOUT  navigation timeout in seconds (default 45)\n  --headed           show the browser windows\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser/suite.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {chromium,webkit,firefox,devices} from 'playwright';\nimport http from 'node:http';\nimport {readFileSync,readdirSync,statSync} from 'node:fs';\nimport path from 'node:path';\nimport {createHash} from 'node:crypto';\nimport {operations} from '../../src/data/ops/index.js';\nimport {defaults} from '../../src/config/tuning.js';\nimport {GAME_TITLE} from '../../src/config/identity.js';\nexport const GPU=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-webgpu-adapter=swiftshader','--use-angle=swiftshader'];\nexport async function server(){const s=http.createServer((req,res)=>{const file=decodeURIComponent(new URL(req.url,'http://local').pathname),p=path.resolve('.','.'+(file==='/'?'/dist/game.html':file));if(\"'!p.startsWith(process.cwd()+path.sep)){res.writeHead(403).end();return;}try{res.setHeader('\"'Content-Type',p.endsWith('.js')?'text/javascript':p.endsWith('.json')?'application/json':'text/html');res.end(readFileSync(p));}catch{res.writeHead(404).end();}});await new Promise(r=>s.listen(0,'127.0.0.1',r));return{url:\"'`http://127.0.0.1:${s.address().port}`,close:()=>new Promise(r=>s.close(r))};}\nconst padInit=()=>{const mk=i=>({id:'\"'Synthetic DualSense',index:i,connected:true,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0})),vibrationActuator:null});window.__pads=[mk(0),mk(1),mk(2),mk(3)];navigator.getGamepads=()=>window.__pads;};\nconst errors=[];\nasync function boot(browser,url,query='test=1&norender=1&webgl=1',options={}){const context=await browser.newContext({viewport:{width:1280,height:720},...options});const page=await context.newPage();page.setDefaultTimeout(15000);page.on('pageerror',e=>errors.push(e.message));await page.goto(url+'/dist/game.html?'+query);await page.waitForFunction(()=>window.__game&&__game.state().screen\"'!=='\"'Boot');assert.notEqual(await page.evaluate(()=>__game.state().screen),'No graphics');return{context,page};}\nconst state=p=>p.evaluate(()=>__game.state());\nconst click=(p,action,value)=>p.locator(\"'`[data-action=\"${action}\"]${value==null?'\"'':\"'`[data-value=\"${value}\"]`}`).first().click({force:true});\nconst pad=async(p,id,button,value)=>{await p.evaluate(({id,button,value})=>{__pads[id].buttons[button]={pressed:value>.5,touched:value>0,value};},{id,button,value});await p.waitForTimeout(65);};\nasync function pressPad(p,id,b){await pad(p,id,b,1);await pad(p,id,b,0);}\nconst allFiles=dir=>readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?allFiles(path.join(dir,e.name)):[path.join(dir,e.name)]);\nexport async function run(test){const srv=await server();let browser;\n await test('\"'package / one self-contained HTML with a pristine protocol client and embedded fonts',()=>{const html=readFileSync('dist/game.html','utf8'),client=readFileSync('tools/vendor/session.js','utf8').trimEnd(),sha=createHash('sha256').update(client).digest('hex');assert.equal(sha,'529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a');assert.equal(html.split('/*\"'! aihub-session '\"').length-1,1);assert.ok(html.includes('<script>\\\\n'+client+'\\\\n</script>'));assert.ok(\"'!/<script[''^>]+src=|url'\"\\\\([\\\"']?https?:/i.test(html));for(const [n,v]of Object.entries({'session':'1','session-players':'1-4','session-mode':'shared-world'}))assert.ok(html.includes(\"'`<meta name=\"hub:${n}\" content=\"${v}\">`));assert.ok(!html.includes('\"'hub:webgpu'));assert.ok(html.includes('data:font/woff2'));for(const file of allFiles('src')){const txt=readFileSync(file,'utf8');assert.ok(\"'!/TODO|FIXME|placeholder|stub/i.test(txt),file);if(file.includes('\"'/sim/'))assert.ok(\"'!txt.includes('\"'Math.random'),file);if(file\"'!=='\"'src/config/identity.js')assert.ok(\"'!txt.includes(GAME_TITLE),file);}const root=path.join('\"'..',path.basename(process.cwd())+'.html');assert.equal(statSync(root).size,statSync('dist/game.html').size);});\n for(const [name,type,args,query]of [['WebGPU',chromium,GPU,'test=1'],['WebGL2',chromium,[],'test=1&webgl=1'],['WebKit',webkit,[],'test=1&webgl=1']])await test(\"'`graphics / ${name} boots and produces an inked frame`,async()=>{browser=await type.launch({headless:true,args});try{const {context,page}=await boot(browser,srv.url,query,{viewport:{width:960,height:540}});await page.evaluate(()=>__game.test.idle(-600000));await page.waitForTimeout(name==='\"'WebGPU'?1800:900);const s=await state(page);assert.equal(s.renderBackend,name==='WebGPU'?'webgpu':'webgl2');await page.screenshot({path:\"'`artifacts/boot-${name.toLowerCase()}.png`});assert.ok(statSync(`artifacts/boot-${name.toLowerCase()}.png`).size>24000);assert.ok(await page.evaluate(()=>document.fonts.check('\"'16px Bangers')));await context.close();}finally{await browser.close();}});\n browser=await chromium.launch({headless:true});\n try{\n await test('input / keyboard, mouse, native menu focus and all eight tool slots',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');assert.equal((await state(page)).screen,'Main Menu');await page.hover('[data-action=\\\"free\\\"]');assert.equal((await state(page)).focusId,'free');await click(page,'free');assert.equal((await state(page)).screen,'Free Play');await page.evaluate(()=>__game.test.skipTo(0,1));for(let i=1;i<=8;i++){await page.keyboard.press(String(i));await page.waitForTimeout(40);assert.equal((await state(page)).tool,i-1);}const before=(await state(page)).tips[0].x;await page.keyboard.down('d');await page.waitForTimeout(250);await page.keyboard.up('d');assert.ok((await state(page)).tips[0].x>before+.25);await page.mouse.move(700,300);await page.waitForTimeout(50);assert.equal((await state(page)).promptSet,'mouse');}finally{await context.close();}});\n await test('input / analog triggers, right-stick speed, left-stick flick and disconnect pause',async()=>{const context=await browser.newContext({viewport:{width:1280,height:720}});await context.addInitScript(padInit);const page=await context.newPage();try{await page.goto(srv.url+'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Title');await page.evaluate(()=>__game.test.skipTo(0,1));await page.evaluate(()=>{__pads[0].axes=[0,0,1,0];});await page.waitForTimeout(60);const before=(await state(page)).tips[0].x;await page.waitForTimeout(700);await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];});await page.waitForTimeout(40);const distance=(await state(page)).tips[0].x-before;assert.ok(distance>1.17&&distance<1.5,\"'`distance ${distance}`);await pad(page,0,7,.62);assert.ok(Math.abs((await state(page)).tips[0].use-.62)<.01);await pad(page,0,7,0);await page.evaluate(()=>{__pads[0].axes=[1,0,0,0];});await page.waitForTimeout(70);assert.equal((await state(page)).tool,2);assert.equal((await state(page)).promptSet,'\"'pad');await page.evaluate(()=>{__pads[0].connected=false;});await page.waitForTimeout(80);assert.equal((await state(page)).screen,'Pause');}finally{await context.close();}});\n await test('settings / glyphs, live audio gains and save persistence',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');await click(page,'settings');assert.equal((await state(page)).musicGain,Math.fround(.1));await click(page,'settingsPage',1);await page.selectOption('[data-setting=glyphs]','xbox');await page.locator('[data-setting=tipSpeed]').fill('2.5');assert.equal((await state(page)).tuning.tipSpeed,2.5);assert.equal((await state(page)).glyphSet,'xbox');await page.reload();await page.waitForFunction(()=>__game.state().screen==='Title');assert.equal((await state(page)).glyphSet,'xbox');assert.equal((await state(page)).tuning.tipSpeed,2.5);}finally{await context.close();}});\n await test('dev / pause access, live tuning, page and global resets',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.evaluate(()=>__game.test.skipTo(0,1));await page.keyboard.press('Escape');assert.equal((await state(page)).screen,'Pause');await click(page,'dev');assert.equal((await state(page)).devOpen,true);for(let i=0;i<5;i++)await page.keyboard.press('e');await page.locator('[data-tuning=tipSpeed]').fill('3');assert.equal((await state(page)).tuning.tipSpeed,3);await click(page,'resetPage');assert.equal((await state(page)).tuning.tipSpeed,defaults.tipSpeed);await page.locator('[data-tuning=tipSpeed]').fill('2.5');await click(page,'resetAll');assert.deepEqual((await state(page)).tuning,defaults);for(const id of ['god','freezeTimer','infiniteComposure','infiniteClamps','bot','resetCheats','bleeder','strain','arrest','fortissimo','hush','sforzando','debug','ink','halftone','lineBoil','shadows','step','objective','unlock'])await page.evaluate(id=>__game.test.dev(id),id);assert.equal((await state(page)).progress,7);await page.evaluate(()=>__game.test.dev('phase'));await page.evaluate(()=>__game.test.dev('rank'));assert.equal((await state(page)).screen,'Report');}finally{await context.close();}});\n await test('campaign / real menu flow through every chart, operation, scene and credits',async()=>{const {context,page}=await boot(browser,srv.url);const reached=[];try{await page.keyboard.press('Enter');await click(page,'storyMenu');await click(page,'newGame');await click(page,'difficulty','normal');let iterations=0;while(iterations++<65){const s=await state(page);reached.push(s.screen);if(s.screen==='Story'){await page.keyboard.press('Tab');}else if(s.screen==='Chart'){await click(page,'begin');await page.evaluate(()=>{__game.test.bot(true);__game.test.warp(500);});}else if(s.screen==='Operation'){await page.waitForFunction(()=>\"'!['\"'Operation','Strain card'].includes(__game.state().screen),{timeout:30000});}else if(s.screen==='Report'){assert.ok(s.op===7||['S','A'].includes(s.rank),\"'`${s.op}: ${s.rank}`);await click(page,'\"'continueReport');}else if(s.screen==='Credits roll')break;else throw new Error('Unexpected '+s.screen);}const end=await state(page);assert.equal(end.screen,'Credits roll');for(const name of ['Title','Main Menu','Story','Chart','Operation','Report','Credits roll'])assert.ok(end.reached.includes(name),name);assert.equal(end.progress,7);await page.reload();await page.waitForFunction(()=>__game.state().screen==='Title');assert.equal((await state(page)).progress,7);}finally{await context.close();}});\n await test('recovery / failure, repeated phase retry and optional Bea’s Notes',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.evaluate(()=>{__game.test.skipTo(0,1);__game.test.dev('fail');});assert.equal((await state(page)).screen,'Fail');await click(page,'retry');await page.evaluate(()=>__game.test.dev('fail'));assert.ok(await page.locator('[data-action=notes]').count());await click(page,'notes');assert.equal((await state(page)).notes,true);assert.ok((await state(page)).vitals>=60);}finally{await context.close();}});\n await test('about / all feedback blocks and source fields are paged and readable',async()=>{const {context,page}=await boot(browser,srv.url);try{await page.keyboard.press('Enter');await click(page,'about');const data=await page.evaluate(()=>JSON.parse(document.getElementById('about-data').textContent));for(const block of ['sourceInformation','testingFeedback','engineFeedback','promptFeedback'])assert.ok(data[block]);const seen=new Set();for(let i=0;i<16;i++){seen.add(await page.locator('.modal h2').textContent());await page.keyboard.press('e');}for(const name of ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','Credits'])assert.ok(seen.has(name),name);assert.equal(await page.locator('.focused').count(),1);}finally{await context.close();}});\n await test('couch / two independent controllers join, move and score',async()=>{const context=await browser.newContext({viewport:{width:1280,height:720}});await context.addInitScript(padInit);const page=await context.newPage();try{await page.goto(srv.url+'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Title');await page.keyboard.press('Enter');await click(page,'lobby');await pressPad(page,0,0);await pressPad(page,1,0);assert.equal(await page.locator('.seat-card.joined').count(),2);await click(page,'startCoop');await page.evaluate(()=>{__pads[0].axes=[0,0,1,0];__pads[1].axes=[0,0,-1,0];});await page.waitForTimeout(250);await page.evaluate(()=>{__pads[0].axes=[0,0,0,0];__pads[1].axes=[0,0,0,0];});const s=await state(page);assert.ok(s.tips[0].x>s.tips[1].x+.3);await page.evaluate(()=>{__game.test.bot(true);__game.test.warp(500);});await page.waitForFunction(()=>__game.state().screen==='Report',{timeout:30000});assert.ok((await state(page)).tips.every(s=>s.score>0));}finally{await context.close();}});\n await test('audio / every original track, procedural effect and voice renders non-silent samples',async()=>{const {context,page}=await boot(browser,srv.url);try{const bundle=readFileSync('src/audio/engine.js','utf8');const outputs=await page.evaluate(async source=>{const module=await import(URL.createObjectURL(new Blob([source],{type:'text/javascript'})));const result=[];for(const [kind,names]of [['music',module.tracks],['sfx',module.effects],['voice',['ren','bea','bell','pip','sorrento','ines','voss']]])for(const name of names){const ctx=new OfflineAudioContext(1,24000,24000);if(kind==='music')module.musicStep(ctx,ctx.destination,name,0,0,.3,3);else if(kind==='sfx')module.synthSfx(ctx,ctx.destination,name,0);else module.voiceLine(ctx,ctx.destination,'Doctor, steady hands\"'!'\"',name,0);const b=await ctx.startRendering();const d=b.getChannelData(0);let sum=0;for(const n of d)sum+=n*n;result.push([kind,name,Math.sqrt(sum/d.length)]);}return result;},bundle);for(const [kind,name,rms]of outputs)assert.ok(rms>.00005,\"'`${kind}/${name} silent ${rms}`);for(const file of allFiles('\"'src'))assert.ok(\"'!/'\"\\\\.(mp3|wav|ogg|m4a|flac)\\\\b/i.test(readFileSync(file,'utf8')));}finally{await context.close();}});\n await test('attract / actual 10-second idle threshold, exits without writing a save',async()=>{const {context,page}=await boot(browser,srv.url);try{const before=await page.evaluate(()=>JSON.stringify(localStorage));await page.waitForTimeout(9200);assert.equal((await state(page)).attract,false);await page.waitForTimeout(1100);assert.equal((await state(page)).attract,true);const ops=new Set([(await state(page)).op]);for(let i=0;i<3;i++){await page.waitForTimeout(11100);ops.add((await state(page)).op);}assert.ok(ops.size>=3,JSON.stringify([...ops]));await page.keyboard.press('x');assert.equal((await state(page)).attract,false);assert.equal(await page.evaluate(()=>JSON.stringify(localStorage)),before);for(const kind of ['mouse','pad']){await page.evaluate(()=>__game.test.idle(11000));await page.waitForTimeout(60);assert.equal((await state(page)).attract,true);if(kind==='mouse')await page.mouse.move(500,300);else{await page.evaluate(padInit);await pressPad(page,0,0);}assert.equal((await state(page)).attract,false);}}finally{await context.close();}});\n }finally{await browser.close();}\n for(const [name,type,device]of [['Android',chromium,'Pixel 7'],['iPhone WebKit',webkit,'iPhone 15']])await test(\"'`touch / ${name} exact notice, tap settings, attract and keyboard escape`,async()=>{browser=await type.launch({headless:true});const context=await browser.newContext({...devices[device]});const page=await context.newPage();try{await page.goto(srv.url+'\"'/dist/game.html?test=1&norender=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Touch notice');await page.getByRole('heading',{name:'Controller or keyboard required',exact:true}).waitFor();assert.equal(await page.locator('.tool-dock:visible').count(),0);await page.getByRole('button',{name:'Settings',exact:true}).tap();assert.equal((await state(page)).screen,'Settings');await page.getByRole('button',{name:'Done',exact:true}).tap();await page.evaluate(()=>__game.test.idle(11000));await page.waitForTimeout(100);assert.ok((await state(page)).attract);await page.touchscreen.tap(15,200);assert.ok(\"'!(await state(page)).attract);await page.keyboard.press('\"'x');assert.equal((await state(page)).screen,'Title');}finally{await context.close();await browser.close();}});\n await test('graphics / unsupported Firefox displays a recoverable graphics message',async()=>{browser=await firefox.launch({headless:true});try{const context=await browser.newContext();const p=await context.newPage();await p.goto(srv.url+'/dist/game.html?test=1&webgl=1');await p.waitForFunction(()=>__game.state().screen\"'!=='\"'Boot');const s=await state(p);assert.ok(['Title','No graphics','Touch notice'].includes(s.screen));if(s.screen==='No graphics')assert.ok(await p.locator('#compatibility').isVisible());await context.close();}finally{await browser.close();}});\n await test('runtime / no unexpected page errors',()=>assert.deepEqual(errors,[]));\n await srv.close();return{pageErrors:errors};\n}\nEOF\nnpm run build\nnode tests/run-all.mjs browser\"","aggregated_output":"\n> surgical-cadence@1.0.0 build\n> node tools/build.mjs\n\nFAIL input / keyboard, mouse, native menu focus and all eight tool slots: AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:\n\n1 !== 0\n\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/browser/suite.mjs:25:547\n    at async test (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/run-all.mjs:4:34)\n    at async Module.run (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Te