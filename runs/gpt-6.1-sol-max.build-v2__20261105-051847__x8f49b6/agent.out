{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sha256sum tools/vendor/session.js && head -n 3 tools/vendor/session.js && sed -n '1,60p' node_modules/three/src/materials/nodes/MeshToonNodeMaterial.js\"","aggregated_output":"6ab6be43898e2db069bc21a94757d77d9c3f2a0cb76f01186490d3bd88d8717a  tools/vendor/session.js\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\nimport NodeMaterial from './NodeMaterial.js';\nimport ToonLightingModel from '../../nodes/functions/ToonLightingModel.js';\n\nimport { MeshToonMaterial } from '../MeshToonMaterial.js';\n\nconst _defaultValues = /*@__PURE__*/ new MeshToonMaterial();\n\n/**\n * Node material version of {@link MeshToonMaterial}.\n *\n * @augments NodeMaterial\n */\nclass MeshToonNodeMaterial extends NodeMaterial {\n\n\tstatic get type() {\n\n\t\treturn 'MeshToonNodeMaterial';\n\n\t}\n\n\t/**\n\t * Constructs a new mesh toon node material.\n\t *\n\t * @param {Object} [parameters] - The configuration parameter.\n\t */\n\tconstructor( parameters ) {\n\n\t\tsuper();\n\n\t\t/**\n\t\t * This flag can be used for type testing.\n\t\t *\n\t\t * @type {boolean}\n\t\t * @readonly\n\t\t * @default true\n\t\t */\n\t\tthis.isMeshToonNodeMaterial = true;\n\n\t\t/**\n\t\t * Set to `true` because toon materials react on lights.\n\t\t *\n\t\t * @type {boolean}\n\t\t * @default true\n\t\t */\n\t\tthis.lights = true;\n\n\t\tthis.setDefaultValues( _defaultValues );\n\n\t\tthis.setValues( parameters );\n\n\t}\n\n\t/**\n\t * Setups the lighting model.\n\t *\n\t * @return {ToonLightingModel} The lighting model.\n\t */\n\tsetupLightingModel( /*builder*/ ) {\n\n\t\treturn new ToonLightingModel();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/config/tuning.js <<'EOF'\nexport const groups = {\n  Hands: [['tipSpeed',1.9,.8,3.5],['stickCurve',1.7,1,3],['aimAssist',.35,0,1],['steadyFactor',.4,.2,.8]],\n  Tools: [['scalpelTol',.055,.02,.12],['pullTol',1.6,.6,3],['suctionRate',1,.3,3],['gelRadius',.16,.08,.3],['stitchGateR',.07,.03,.15],['laserDps',30,10,80],['laserBurn',2,0,6],['scannerRadius',.3,.15,.5],['clampWindow',.18,.06,.4],['defibWindow',.30,.1,.6]],\n  Patient: [['drainMult',1,0,3],['timerMult',1,.5,2],['tempoPressure',60,0,120],['stabilizerHeal',15,5,30],['stabilizerCooldown',3,.5,8],['missLimit',8,3,20]],\n  Strains: [['strainHpMult',1,.3,3],['strainSpeedMult',1,.3,2.5],['spawnRateMult',1,.3,2.5]],\n  Gifts: [['composureGain',1,.2,3],['hushDuration',7,2,15],['hushTimeScale',.25,.05,.7],['sforzandoStun',3,1,6],['sforzandoDamage',.25,.05,.6],['sforzandoToolMult',2,1.2,4],['sforzandoDuration',6,2,12]]\n};\nexport const defaults = Object.fromEntries(Object.values(groups).flat().map(([id,value])=>[id,value]));\nexport const difficulty = {\n easy: {label:'Intern',drain:.6,time:1.4,tolerance:1.4,misses:12,hp:.85},\n normal:{label:'Resident',drain:1,time:1,tolerance:1,misses:8,hp:1},\n hard:{label:'Attending',drain:1.35,time:.85,tolerance:.8,misses:5,hp:1.2}\n};\nexport const tools = ['scalpel','forceps','suction','gel','suture','laser','scanner','clamp'];\nexport const toolLabels = ['Scalpel','Forceps','Suction','Gel','Suture','Laser','Scanner','Clamp'];\nexport const toolHints = {\n scalpel:'Hold {use} at the first dot. Trace the gold guide slowly.',\n forceps:'Hold {use} to grip. Pull along the arrow, then release over the tray.',\n suction:'Hold {use} over crimson pools until the field is clear.',\n gel:'Hold {use} and paint the dotted area mint green.',\n suture:'Hold {use}. Follow the numbered gates, then {alt} to tie.',\n laser:'Hold {use} on the violet target. Lift off healthy tissue.',\n scanner:'Hold {use} and sweep. Stay on a hidden target until it pings.',\n clamp:'Press {use} on a bleeder as the ring closes. {alt} removes it.',\n syringe:'Hold {syringe} to restore vitals. Unlimited doses; a short cooldown.',\n defib:'Hold {charge} to charge. Release both in the gold band.',\n hush:'Press {special}. Slow the world. Keep your hands moving.',\n sforzando:'Press {special}. Stun every strain and double your tool power.'\n};\nEOF\ncat > src/data/cast.js <<'EOF'\nexport const cast={\n ren:{name:'Dr. Ren Halloran',short:'Halloran',color:'#64e5cd',skin:'#e5b391',hair:'#123a44',coat:'#eef1e7',eyes:'#297e9d',pitch:190,rate:.052,style:'spiky'},\n bea:{name:'Bea Okonkwo',short:'Okonkwo',color:'#f2b134',skin:'#915c43',hair:'#bfc4bb',coat:'#176670',eyes:'#342016',pitch:130,rate:.085,style:'wrap'},\n bell:{name:'Dr. Augustin Bell',short:'Bell',color:'#f2b134',skin:'#e6b292',hair:'#e5e6df',coat:'#f5f0dc',eyes:'#759892',pitch:85,rate:.073,style:'bald'},\n pip:{name:'Pip Adeyemi',short:'Adeyemi',color:'#efcb68',skin:'#aa6a48',hair:'#2c1a2b',coat:'#e3b33f',eyes:'#36253c',pitch:280,rate:.043,style:'buns'},\n sorrento:{name:'Hale Sorrento',short:'Sorrento',color:'#a7b1c0',skin:'#c9987f',hair:'#16222c',coat:'#303e48',eyes:'#5d6269',pitch:110,rate:.07,style:'slick'},\n ines:{name:'Dr. Ines Varga',short:'Varga',color:'#c2acfa',skin:'#e2b99f',hair:'#1a1528',coat:'#232637',eyes:'#7b86b5',pitch:150,rate:.064,style:'bob'},\n voss:{name:'Dr. Cordelia Voss',short:'The Maestro',color:'#d7f24a',skin:'#d9bfae',hair:'#e1e2da',coat:'#22232e',eyes:'#aa6a8b',pitch:120,rate:.09,style:'long'}\n};\nexport const strainInfo={\n adagio:{name:'Adagio',definition:'Slowly, with great expression.',aside:'Also: it is eating her liver.',hint:'Laser the open core. Forceps it to the tray.',color:'#d7f24a'},\n staccato:{name:'Staccato',definition:'Short, sharp, detached.',aside:'Like her prognosis.',hint:'Pinch the notes. Scan and gel the nests.',color:'#e5aeec'},\n tremolo:{name:'Tremolo',definition:'A rapid, nervous trembling.',aside:'Yours, specifically.',hint:'Slow hands. Scanner to pin, then Laser.',color:'#abe4f0'},\n legato:{name:'Legato',definition:'Smoothly connected, without a break.',aside:'It does not want a break.',hint:'Cut the glowing tail first. Carry each bead away.',color:'#ba9aef'},\n crescendo:{name:'Crescendo',definition:'Gradually getting louder.',aside:'She is about to get very loud.',hint:'Laser four feeders. Trace the ring. Extract.',color:'#ffb45c'},\n fermata:{name:'Fermata',definition:'Hold until the conductor releases you.',aside:'The conductor is not coming.',hint:'Laser the eye. Charge and release in gold.',color:'#f4df9e'},\n coda:{name:'Coda',definition:'The tail. The part that ends everything.',aside:'Her heartbeat. Your hands.',hint:'Cut the batons. Laser the core during its rest.',color:'#ed83ab'}\n};\nEOF\ncat > src/data/ops/index.js <<'EOF'\n// Operations are complete, self-contained sequences. Coordinates are field units.\nconst e=(kind,x=0,y=0,o={})=>({kind,x,y,...o});\nconst zone=(w=1.1,h=.45)=>e('gelZone',0,0,{w,h,parTime:9});\nconst cut=(x1=-.65,y1=0,x2=.65,y2=0)=>e('incision',x1,y1,{points:[[x1,y1],[(x1+x2)/2,(y1+y2)/2+.055],[x2,y2]]});\nconst wound=(x=0,y=0,n=6,w=.7)=>e('wound',x,y,{gates:Array.from({length:n},(_,i)=>[x-w/2+w*i/(n-1),y+(i%2?-.08:.08)])});\nconst shard=(x,y,a=90,embed=.2,hidden=false)=>e('shard',x,y,{axis:a,embed,hidden,poolOnRemove:.4});\nconst bleeder=(x,y)=>e('bleeder',x,y);\nconst phase=(id,objective,tools,spawn,more={})=>({id,objective,tools,spawn,done:{all:true},...more});\nconst sites=(...organs)=>organs.map((organ)=>({id:organ,organ}));\nconst patient=(name,age,job,note,followUp,style='slick',skin='#d5a080')=>({name,age,job,note,followUp,bust:{style,skin}});\nexport const operations=[\n {id:'broken-glass',chapter:1,title:'Broken Glass',doctor:'ren',scene:{before:'S1',after:'S2'},timer:240,bpm:72,parScore:10500,music:'or-calm',sites:sites('forearm'),\n patient:patient('Desmond Pell',52,'Taxi driver','Has never once used a turn signal.','Discharged Tuesday. Was seen signaling, once, leaving the car park.','slick'),\n teaches:['gel','forceps','suction','syringe','scanner','suture'],phases:[\n phase('clean','Disinfect the wound',['gel'],[zone(1.2,.5)],{say:'Gel first, child. Everything in a taxi is filthy.'}),\n phase('glass','Pull four shards to the tray. Drain the pools.',['forceps','suction'],[shard(-.65,.16,70,.18),shard(-.2,-.22,100,.22),shard(.32,.19,60,.25),shard(.7,-.12,110,.3)],{say:'That is a shard of windshield, not a sacrament. Take it out.'}),\n phase('dip','Stabilize the patient. Hold {syringe}.',['syringe'],[],{begin:{vitals:-25,lockFail:true},done:{vitalsAbove:90},say:'Pressure is falling. The IV, child. Hold {syringe}.'}),\n phase('missing','Count them. Scan for the missing shard.',['scanner','forceps'],[shard(.05,.2,85,.3,true)],{say:'Four on the tray. Five on the radiograph. Count them, child.'}),\n phase('stitch','Close both lacerations. Follow every gate.',['suture'],[wound(-.1,.27,6,1),wound(.1,-.28,8,1.15)],{say:'Numbered gates. Left, right, left. Then tie your knot.'}),\n phase('finish','Seal the stitches with gel.',['gel'],[zone(1.3,.55)],{say:'A little gel. Let him keep his arm.'})]},\n {id:'growth-spurt',chapter:1,title:'Growth Spurt',doctor:'ren',scene:{before:'S3',after:'S4'},timer:330,bpm:76,parScore:14500,music:'or-tense',sites:sites('abdomen','bowel'),\n patient:patient('Hana Ito',38,'Crane operator','Lifts forty tons for a living. Fainted at the consent form.','Back on the cranes. Has asked you to stop visiting.','bob','#e5b697'),teaches:['scalpel','clamp','laser','hush'],phases:[\n phase('open','Disinfect, then trace the incision.',['gel','scalpel'],[zone(1.5,.4),cut(-.7,0,.7,0)],{ordered:true}),\n phase('bleed','Clamp both bleeders. Clear the field.',['clamp','suction'],[bleeder(-.4,.15),bleeder(.45,-.1),e('pool',-.4,.15,{vol:.6}),e('pool',.45,-.1,{vol:.6})],{site:1}),\n phase('nodules','Five nodules. One is under the surface.',['scanner','laser'],[-.8,-.4,0,.4,.8].map((x,i)=>e('nodule',x,i%2?.22:-.15,{hp:30,hidden:i===3}))),\n phase('tumor','Sever three tethers. Extract the mass.',['scalpel','forceps'],[e('tumor',0,0,{embed:.4,axis:90,tethers:3}),...[-1,0,1].map((s,i)=>e('tether',s*.33,.08,{points:[[s*.33-.15,-.22],[s*.33+.15,.38]],order:i}))]),\n phase('crash','THE HUSH. Slow the world. Close the rupture.',['hush','suture'],[wound(0,0,12,1.35)],{begin:{vitalsSet:35,composure:100,drain:3},say:'THE VESSEL\"'! Child, listen. Listen to the room.'\"'}),\n phase('close','Remove clamps with {alt}. Close and seal.',['clamp','suture','gel'],[bleeder(-.65,.25),bleeder(.65,.25),wound(0,0,10,1.2),zone(1.4,.45)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'adagio',chapter:2,title:'Adagio',doctor:'ren',scene:{before:'S5',after:'S6'},timer:330,bpm:80,parScore:15000,sites:sites('liver'),\n patient:patient('Theodora Lund',61,'Cellist · Harbor Orchestra','Refuses anesthesia until she finishes a sentence about Brahms.','Dedicated the slow movement to “the nervous one.”','long','#e3bca8'),teaches:['adagio'],phases:[\n phase('open','Disinfect and open the field.',['gel','scalpel'],[zone(),cut()],{ordered:true}),\n phase('scan','Scan the stave lines. Mark three nests.',['scanner'],[-.6,0,.6].map(x=>e('scanMark',x,0,{hidden:true}))),\n phase('adagio','Laser the core, then extract Adagio.',['laser','forceps'],[e('adagio',0,0,{hp:100,embed:.22,axis:90})],{strain:'adagio'}),\n phase('eggs','Find four eggs before they hatch.',['scanner','laser'],[-.7,-.25,.25,.7].map((x,i)=>e('egg',x,i%2?.25:-.2,{hidden:true,hp:20,hatchBar:16}))),\n phase('grande','Adagio Grande. Clamp its bleeders.',['laser','forceps','clamp'],[e('adagio',0,0,{hp:150,grande:true,embed:.3,axis:90}),bleeder(-.7,.25),bleeder(.7,-.25)],{strain:'adagio'}),\n phase('close','Clamps out. Stitch and seal the lesions.',['clamp','suture','gel'],[bleeder(-.75,.15),bleeder(.75,.15),wound(0,.25,6,1),wound(0,-.25,6,1),zone(1.2,.65)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'staccato',chapter:2,title:'Staccato',doctor:'ren',scene:{before:'S7',after:'S8'},timer:360,bpm:84,parScore:20000,sites:sites('bowel','stomach'),\n patient:patient('Ruben Castellano',47,'Ferry captain','Has not missed a crossing in nineteen years. Is asking how long.','Missed two crossings. Sent flowers to the ferry.','bald','#b78060'),teaches:['staccato','tremolo'],phases:[\n phase('open','Disinfect and open the field.',['gel','scalpel'],[zone(),cut()],{ordered:true}),\n phase('wave-one','Pinch the notes before they burst.',['forceps','laser'],Array.from({length:8},(_,i)=>e('note',-.8+(i%4)*.5,-.26+Math.floor(i/4)*.5,{hp:8,ttl:8+i*.75})),{strain:'staccato'}),\n phase('nests','Scan and seal four hidden nests.',['scanner','gel'],[-.75,-.25,.25,.75].map((x,i)=>e('nest',x,i%2?.22:-.2,{hidden:true}))),\n phase('waves','Two more waves. Keep the field clean.',['laser','forceps','gel'],Array.from({length:12},(_,i)=>e('note',-.9+(i%6)*.36,-.3+Math.floor(i/6)*.6,{hp:8,ttl:10+i*.9})),{extraWave:16}),\n phase('tremolo','Slow hands. Pin Tremolo three times.',['scanner','laser'],[e('tremolo',0,0,{hp:40,pinsRequired:3})],{site:1,strain:'tremolo',say:'Slow hands, child. It is more frightened than you.'}),\n phase('close','Close and seal the field.',['suture','gel'],[wound(0,0,8,1.2),zone(1.3,.45)],{ordered:true})]},\n {id:'legato',chapter:3,title:'Legato',doctor:'ines',scene:{before:'S9',after:'S10'},timer:360,bpm:70,parScore:19000,consult:true,scalpelMult:.75,sites:sites('brain'),\n patient:patient('Nadia Bloom',29,'School music teacher','Class 4 sent a card signed “Please do not miss.”','Back with Class 4. They have sent a second card.','buns','#a97655'),teaches:['legato','sforzando'],phases:[\n phase('membrane','Open the membrane. Precise hands.',['scalpel'],[cut(-.7,-.2,.65,-.12),cut(-.65,.24,.7,.2)]),\n phase('chain','Cut the glowing tail. Carry every bead away.',['scalpel','forceps'],[e('legato',0,0,{links:12})],{strain:'legato'}),\n phase('thrash','SFORZANDO. Sever the thrashing chain.',['sforzando','scalpel','forceps'],[e('legato',0,0,{links:6,speed:1.7})],{begin:{composure:100},say:'Now you will see how I work, Doctor.'}),\n phase('second','A second chain. Tail first, Doctor.',['scalpel','forceps'],[e('legato',0,0,{links:8,twoTails:true})]),\n phase('repair','Repair the vessel. Clamps out. Seal.',['suture','clamp','gel'],[bleeder(-.8,0),wound(0,0,10,1),zone(1.2,.4)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'fermata',chapter:3,title:'Fermata',doctor:'ren',scene:{before:'S11',after:'S12'},timer:420,bpm:88,parScore:18500,consult:true,sites:sites('heart'),\n patient:patient('Dr. Augustin Bell',66,'Chief of Surgery','Has told every surgeon here to quit smoking. Smokes.','Under arrest. Recovering. Has quit.','bald','#e6b292'),teaches:['crescendo','fermata','defib'],phases:[\n phase('open','Open and disinfect the field.',['scalpel','gel'],[cut(-.75,0,.75,0),zone(1.5,.4)],{ordered:true}),\n phase('crescendo','Kill four feeders. Cut and extract the ring.',['laser','scalpel','forceps'],[e('crescendo',0,0,{size:.2,embed:.3,axis:90})],{strain:'crescendo'}),\n phase('first-arrest','CARDIAC ARREST. Charge. Release in gold.',['defib'],[],{begin:{arrest:true,arrestTime:14},done:{arrestsSurvived:1},strain:'fermata'}),\n phase('antidote','Inject three antidote sites. Clamp bleeding.',['syringe','clamp'],[e('injection',-.6,0),e('injection',0,.3),e('injection',.6,0),bleeder(-.4,-.3),bleeder(.4,-.3)]),\n phase('second-arrest','Laser the eye. Then CLEAR\"'!'\"',['laser','defib'],[e('fermata',0,0,{hp:60})],{begin:{arrest:true,arrestTime:12},done:{arrestsSurvived:1}}),\n phase('third-arrest','Laser. Shock. Extract the eye.',['laser','defib','forceps'],[e('fermata',0,0,{hp:80,extract:true,embed:.25,axis:90})],{begin:{arrest:true,arrestTime:14}}),\n phase('close','Remove clamps. Close the heart.',['clamp','suture','gel'],[bleeder(-.7,.25),bleeder(.7,.25),wound(0,0,10,1.2),zone(1.3,.5)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'coda',chapter:4,title:'Coda',doctor:'ren',scene:{before:'S13',after:'S14'},timer:570,bpm:92,parScore:26500,consult:true,sites:sites('heart','lung','aorta'),\n patient:patient('Beatrice Okonkwo',58,'Head Nurse · OR 3','In her own handwriting: “Do not be dramatic about this.”','Discharged herself. Is back in OR 3. Has opinions.','wrap','#915c43'),teaches:['coda'],phases:[\n phase('exposition','Adagio and Staccato. Keep her with us.',['laser','forceps','gel'],[e('adagio',-.3,0,{hp:100,embed:.2,axis:90}),e('nest',.65,.1),e('note',.5,-.3,{hp:8,ttl:10})],{strain:'adagio',say:'“Suction before you cannot see.” She underlined that twice.'}),\n phase('development','Switch to the lung. Pin and sever.',['scanner','laser','scalpel','forceps'],[e('tremolo',-.5,0,{hp:40,pinsRequired:2}),e('legato',.4,0,{links:5})],{site:1,strain:'tremolo'}),\n phase('recapitulation','The aorta. Stop the crescendo.',['laser','scalpel','forceps'],[e('crescendo',0,0,{size:.2,embed:.3,axis:90})],{site:2,strain:'crescendo'}),\n phase('rest','Her heart has stopped. Laser. Defibrillate.',['laser','defib'],[e('fermata',0,0,{hp:60})],{site:0,begin:{arrest:true,arrestTime:12},done:{arrestsSurvived:1},strain:'fermata'}),\n phase('conductor','CODA. Cut the batons. Strike during the rest.',['scalpel','laser','forceps'],[e('coda',0,0,{hp:300,embed:.6,axis:90,arms:2})],{strain:'coda'}),\n phase('closing','Close every site. Remove every clamp.',['suture','gel','clamp'],[wound(0,0,8,1.1),{...wound(0,0,8,1.1),site:1},{...wound(0,0,8,1.1),site:2},bleeder(-.7,.15)],{clampsOn:true,done:{all:true,allClampsOff:true}}),\n phase('last-stop','Listen, Doctor. Bring her back.',['hush','defib'],[],{site:0,begin:{composure:100,arrest:true,arrestTime:12,doctor:'ren'},done:{arrestsSurvived:1},say:'Her notebook ends here, Doctor.'})]},\n {id:'last-patient',chapter:4,title:'Last Patient',doctor:'ren',scene:{before:'S15',after:'S16'},timer:0,bpm:60,parScore:0,unfailing:true,sites:sites('heart'),\n patient:patient('Dr. Cordelia Voss',71,'Founder · Cardiac unit','“Deceased.” Seventeen years ago. Crossed out by Ren.','Tonight’s patient survived.','long','#d9bfae'),teaches:[],phases:[\n phase('clamp','',['clamp'],[bleeder(0,0)],{say:'She is a patient.'}),\n phase('heartbeat','',['defib'],[],{begin:{arrest:true,arrestTime:60},done:{arrestsSurvived:1},say:'Tonight, the room is quiet for her.'})]},\n {id:'grand-rounds',chapter:0,title:'Grand Rounds',doctor:'ren',timer:300,bpm:82,parScore:22000,sites:sites('liver','bowel','heart'),\n patient:patient('Ngaio Reeve',55,'Harbor master','Ward Zero has only this to say: everyone scrub in.','A harbor needs every pair of hands. So does a heart.','slick','#ac775b'),teaches:[],phases:[\n phase('open','Split the work. Open, extract, disinfect.',['scalpel','forceps','gel','clamp'],[cut(-.6,.2,.6,.2),zone(1.3,.35),...[-.6,-.2,.2,.6].map(x=>({...shard(x,0),site:1})),{...bleeder(-.5,.2),site:2},{...bleeder(.5,-.2),site:2}],{ordered:true}),\n phase('first-movement','Adagio on the liver. Notes on the bowel.',['laser','forceps','scanner','gel'],[e('adagio',0,0,{hp:100,embed:.25,axis:90}),e('nest',-.4,0,{site:1,hidden:true}),e('note',.5,0,{site:1,hp:8,ttl:12})]),\n phase('second-movement','Legato on the bowel. Crescendo at the heart.',['scalpel','laser','forceps'],[e('legato',0,0,{links:6,site:1}),e('crescendo',0,0,{size:.2,site:2,embed:.3,axis:90})]),\n phase('arrest','One heart. Any surgeon’s shock counts.',['defib','syringe'],[],{site:2,begin:{arrest:true,arrestTime:14},done:{arrestsSurvived:1}}),\n phase('close','Close every site. No instruments left behind.',['suture','gel','clamp'],[wound(0,0,6,1),{...wound(0,0,6,1),site:1},{...wound(0,0,6,1),site:2},zone(1.2,.4)],{ordered:true,done:{all:true,allClampsOff:true}})]}\n];\nexport const GRAND_ROUNDS=8;\nexport const kinds=['gelZone','incision','wound','shard','pool','bleeder','nodule','tumor','tether','scanMark','adagio','egg','nest','note','tremolo','legato','crescendo','feeder','fermata','coda','injection','scratch','spore','piece'];\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/config/tuning.js <<'EOF'\nexport const groups = {\n  Hands: [['tipSpeed',1.9,.8,3.5],['stickCurve',1.7,1,3],['aimAssist',.35,0,1],['steadyFactor',.4,.2,.8]],\n  Tools: [['scalpelTol',.055,.02,.12],['pullTol',1.6,.6,3],['suctionRate',1,.3,3],['gelRadius',.16,.08,.3],['stitchGateR',.07,.03,.15],['laserDps',30,10,80],['laserBurn',2,0,6],['scannerRadius',.3,.15,.5],['clampWindow',.18,.06,.4],['defibWindow',.30,.1,.6]],\n  Patient: [['drainMult',1,0,3],['timerMult',1,.5,2],['tempoPressure',60,0,120],['stabilizerHeal',15,5,30],['stabilizerCooldown',3,.5,8],['missLimit',8,3,20]],\n  Strains: [['strainHpMult',1,.3,3],['strainSpeedMult',1,.3,2.5],['spawnRateMult',1,.3,2.5]],\n  Gifts: [['composureGain',1,.2,3],['hushDuration',7,2,15],['hushTimeScale',.25,.05,.7],['sforzandoStun',3,1,6],['sforzandoDamage',.25,.05,.6],['sforzandoToolMult',2,1.2,4],['sforzandoDuration',6,2,12]]\n};\nexport const defaults = Object.fromEntries(Object.values(groups).flat().map(([id,value])=>[id,value]));\nexport const difficulty = {\n easy: {label:'Intern',drain:.6,time:1.4,tolerance:1.4,misses:12,hp:.85},\n normal:{label:'Resident',drain:1,time:1,tolerance:1,misses:8,hp:1},\n hard:{label:'Attending',drain:1.35,time:.85,tolerance:.8,misses:5,hp:1.2}\n};\nexport const tools = ['scalpel','forceps','suction','gel','suture','laser','scanner','clamp'];\nexport const toolLabels = ['Scalpel','Forceps','Suction','Gel','Suture','Laser','Scanner','Clamp'];\nexport const toolHints = {\n scalpel:'Hold {use} at the first dot. Trace the gold guide slowly.',\n forceps:'Hold {use} to grip. Pull along the arrow, then release over the tray.',\n suction:'Hold {use} over crimson pools until the field is clear.',\n gel:'Hold {use} and paint the dotted area mint green.',\n suture:'Hold {use}. Follow the numbered gates, then {alt} to tie.',\n laser:'Hold {use} on the violet target. Lift off healthy tissue.',\n scanner:'Hold {use} and sweep. Stay on a hidden target until it pings.',\n clamp:'Press {use} on a bleeder as the ring closes. {alt} removes it.',\n syringe:'Hold {syringe} to restore vitals. Unlimited doses; a short cooldown.',\n defib:'Hold {charge} to charge. Release both in the gold band.',\n hush:'Press {special}. Slow the world. Keep your hands moving.',\n sforzando:'Press {special}. Stun every strain and double your tool power.'\n};\nEOF\ncat > src/data/cast.js <<'EOF'\nexport const cast={\n ren:{name:'Dr. Ren Halloran',short:'Halloran',color:'#64e5cd',skin:'#e5b391',hair:'#123a44',coat:'#eef1e7',eyes:'#297e9d',pitch:190,rate:.052,style:'spiky'},\n bea:{name:'Bea Okonkwo',short:'Okonkwo',color:'#f2b134',skin:'#915c43',hair:'#bfc4bb',coat:'#176670',eyes:'#342016',pitch:130,rate:.085,style:'wrap'},\n bell:{name:'Dr. Augustin Bell',short:'Bell',color:'#f2b134',skin:'#e6b292',hair:'#e5e6df',coat:'#f5f0dc',eyes:'#759892',pitch:85,rate:.073,style:'bald'},\n pip:{name:'Pip Adeyemi',short:'Adeyemi',color:'#efcb68',skin:'#aa6a48',hair:'#2c1a2b',coat:'#e3b33f',eyes:'#36253c',pitch:280,rate:.043,style:'buns'},\n sorrento:{name:'Hale Sorrento',short:'Sorrento',color:'#a7b1c0',skin:'#c9987f',hair:'#16222c',coat:'#303e48',eyes:'#5d6269',pitch:110,rate:.07,style:'slick'},\n ines:{name:'Dr. Ines Varga',short:'Varga',color:'#c2acfa',skin:'#e2b99f',hair:'#1a1528',coat:'#232637',eyes:'#7b86b5',pitch:150,rate:.064,style:'bob'},\n voss:{name:'Dr. Cordelia Voss',short:'The Maestro',color:'#d7f24a',skin:'#d9bfae',hair:'#e1e2da',coat:'#22232e',eyes:'#aa6a8b',pitch:120,rate:.09,style:'long'}\n};\nexport const strainInfo={\n adagio:{name:'Adagio',definition:'Slowly, with great expression.',aside:'Also: it is eating her liver.',hint:'Laser the open core. Forceps it to the tray.',color:'#d7f24a'},\n staccato:{name:'Staccato',definition:'Short, sharp, detached.',aside:'Like her prognosis.',hint:'Pinch the notes. Scan and gel the nests.',color:'#e5aeec'},\n tremolo:{name:'Tremolo',definition:'A rapid, nervous trembling.',aside:'Yours, specifically.',hint:'Slow hands. Scanner to pin, then Laser.',color:'#abe4f0'},\n legato:{name:'Legato',definition:'Smoothly connected, without a break.',aside:'It does not want a break.',hint:'Cut the glowing tail first. Carry each bead away.',color:'#ba9aef'},\n crescendo:{name:'Crescendo',definition:'Gradually getting louder.',aside:'She is about to get very loud.',hint:'Laser four feeders. Trace the ring. Extract.',color:'#ffb45c'},\n fermata:{name:'Fermata',definition:'Hold until the conductor releases you.',aside:'The conductor is not coming.',hint:'Laser the eye. Charge and release in gold.',color:'#f4df9e'},\n coda:{name:'Coda',definition:'The tail. The part that ends everything.',aside:'Her heartbeat. Your hands.',hint:'Cut the batons. Laser the core during its rest.',color:'#ed83ab'}\n};\nEOF\ncat > src/data/ops/index.js <<'EOF'\n// Operations are complete, self-contained sequences. Coordinates are field units.\nconst e=(kind,x=0,y=0,o={})=>({kind,x,y,...o});\nconst zone=(w=1.1,h=.45)=>e('gelZone',0,0,{w,h,parTime:9});\nconst cut=(x1=-.65,y1=0,x2=.65,y2=0)=>e('incision',x1,y1,{points:[[x1,y1],[(x1+x2)/2,(y1+y2)/2+.055],[x2,y2]]});\nconst wound=(x=0,y=0,n=6,w=.7)=>e('wound',x,y,{gates:Array.from({length:n},(_,i)=>[x-w/2+w*i/(n-1),y+(i%2?-.08:.08)])});\nconst shard=(x,y,a=90,embed=.2,hidden=false)=>e('shard',x,y,{axis:a,embed,hidden,poolOnRemove:.4});\nconst bleeder=(x,y)=>e('bleeder',x,y);\nconst phase=(id,objective,tools,spawn,more={})=>({id,objective,tools,spawn,done:{all:true},...more});\nconst sites=(...organs)=>organs.map((organ)=>({id:organ,organ}));\nconst patient=(name,age,job,note,followUp,style='slick',skin='#d5a080')=>({name,age,job,note,followUp,bust:{style,skin}});\nexport const operations=[\n {id:'broken-glass',chapter:1,title:'Broken Glass',doctor:'ren',scene:{before:'S1',after:'S2'},timer:240,bpm:72,parScore:10500,music:'or-calm',sites:sites('forearm'),\n patient:patient('Desmond Pell',52,'Taxi driver','Has never once used a turn signal.','Discharged Tuesday. Was seen signaling, once, leaving the car park.','slick'),\n teaches:['gel','forceps','suction','syringe','scanner','suture'],phases:[\n phase('clean','Disinfect the wound',['gel'],[zone(1.2,.5)],{say:'Gel first, child. Everything in a taxi is filthy.'}),\n phase('glass','Pull four shards to the tray. Drain the pools.',['forceps','suction'],[shard(-.65,.16,70,.18),shard(-.2,-.22,100,.22),shard(.32,.19,60,.25),shard(.7,-.12,110,.3)],{say:'That is a shard of windshield, not a sacrament. Take it out.'}),\n phase('dip','Stabilize the patient. Hold {syringe}.',['syringe'],[],{begin:{vitals:-25,lockFail:true},done:{vitalsAbove:90},say:'Pressure is falling. The IV, child. Hold {syringe}.'}),\n phase('missing','Count them. Scan for the missing shard.',['scanner','forceps'],[shard(.05,.2,85,.3,true)],{say:'Four on the tray. Five on the radiograph. Count them, child.'}),\n phase('stitch','Close both lacerations. Follow every gate.',['suture'],[wound(-.1,.27,6,1),wound(.1,-.28,8,1.15)],{say:'Numbered gates. Left, right, left. Then tie your knot.'}),\n phase('finish','Seal the stitches with gel.',['gel'],[zone(1.3,.55)],{say:'A little gel. Let him keep his arm.'})]},\n {id:'growth-spurt',chapter:1,title:'Growth Spurt',doctor:'ren',scene:{before:'S3',after:'S4'},timer:330,bpm:76,parScore:14500,music:'or-tense',sites:sites('abdomen','bowel'),\n patient:patient('Hana Ito',38,'Crane operator','Lifts forty tons for a living. Fainted at the consent form.','Back on the cranes. Has asked you to stop visiting.','bob','#e5b697'),teaches:['scalpel','clamp','laser','hush'],phases:[\n phase('open','Disinfect, then trace the incision.',['gel','scalpel'],[zone(1.5,.4),cut(-.7,0,.7,0)],{ordered:true}),\n phase('bleed','Clamp both bleeders. Clear the field.',['clamp','suction'],[bleeder(-.4,.15),bleeder(.45,-.1),e('pool',-.4,.15,{vol:.6}),e('pool',.45,-.1,{vol:.6})],{site:1}),\n phase('nodules','Five nodules. One is under the surface.',['scanner','laser'],[-.8,-.4,0,.4,.8].map((x,i)=>e('nodule',x,i%2?.22:-.15,{hp:30,hidden:i===3}))),\n phase('tumor','Sever three tethers. Extract the mass.',['scalpel','forceps'],[e('tumor',0,0,{embed:.4,axis:90,tethers:3}),...[-1,0,1].map((s,i)=>e('tether',s*.33,.08,{points:[[s*.33-.15,-.22],[s*.33+.15,.38]],order:i}))]),\n phase('crash','THE HUSH. Slow the world. Close the rupture.',['hush','suture'],[wound(0,0,12,1.35)],{begin:{vitalsSet:35,composure:100,drain:3},say:'THE VESSEL\"'! Child, listen. Listen to the room.'\"'}),\n phase('close','Remove clamps with {alt}. Close and seal.',['clamp','suture','gel'],[bleeder(-.65,.25),bleeder(.65,.25),wound(0,0,10,1.2),zone(1.4,.45)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'adagio',chapter:2,title:'Adagio',doctor:'ren',scene:{before:'S5',after:'S6'},timer:330,bpm:80,parScore:15000,sites:sites('liver'),\n patient:patient('Theodora Lund',61,'Cellist · Harbor Orchestra','Refuses anesthesia until she finishes a sentence about Brahms.','Dedicated the slow movement to “the nervous one.”','long','#e3bca8'),teaches:['adagio'],phases:[\n phase('open','Disinfect and open the field.',['gel','scalpel'],[zone(),cut()],{ordered:true}),\n phase('scan','Scan the stave lines. Mark three nests.',['scanner'],[-.6,0,.6].map(x=>e('scanMark',x,0,{hidden:true}))),\n phase('adagio','Laser the core, then extract Adagio.',['laser','forceps'],[e('adagio',0,0,{hp:100,embed:.22,axis:90})],{strain:'adagio'}),\n phase('eggs','Find four eggs before they hatch.',['scanner','laser'],[-.7,-.25,.25,.7].map((x,i)=>e('egg',x,i%2?.25:-.2,{hidden:true,hp:20,hatchBar:16}))),\n phase('grande','Adagio Grande. Clamp its bleeders.',['laser','forceps','clamp'],[e('adagio',0,0,{hp:150,grande:true,embed:.3,axis:90}),bleeder(-.7,.25),bleeder(.7,-.25)],{strain:'adagio'}),\n phase('close','Clamps out. Stitch and seal the lesions.',['clamp','suture','gel'],[bleeder(-.75,.15),bleeder(.75,.15),wound(0,.25,6,1),wound(0,-.25,6,1),zone(1.2,.65)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'staccato',chapter:2,title:'Staccato',doctor:'ren',scene:{before:'S7',after:'S8'},timer:360,bpm:84,parScore:20000,sites:sites('bowel','stomach'),\n patient:patient('Ruben Castellano',47,'Ferry captain','Has not missed a crossing in nineteen years. Is asking how long.','Missed two crossings. Sent flowers to the ferry.','bald','#b78060'),teaches:['staccato','tremolo'],phases:[\n phase('open','Disinfect and open the field.',['gel','scalpel'],[zone(),cut()],{ordered:true}),\n phase('wave-one','Pinch the notes before they burst.',['forceps','laser'],Array.from({length:8},(_,i)=>e('note',-.8+(i%4)*.5,-.26+Math.floor(i/4)*.5,{hp:8,ttl:8+i*.75})),{strain:'staccato'}),\n phase('nests','Scan and seal four hidden nests.',['scanner','gel'],[-.75,-.25,.25,.75].map((x,i)=>e('nest',x,i%2?.22:-.2,{hidden:true}))),\n phase('waves','Two more waves. Keep the field clean.',['laser','forceps','gel'],Array.from({length:12},(_,i)=>e('note',-.9+(i%6)*.36,-.3+Math.floor(i/6)*.6,{hp:8,ttl:10+i*.9})),{extraWave:16}),\n phase('tremolo','Slow hands. Pin Tremolo three times.',['scanner','laser'],[e('tremolo',0,0,{hp:40,pinsRequired:3})],{site:1,strain:'tremolo',say:'Slow hands, child. It is more frightened than you.'}),\n phase('close','Close and seal the field.',['suture','gel'],[wound(0,0,8,1.2),zone(1.3,.45)],{ordered:true})]},\n {id:'legato',chapter:3,title:'Legato',doctor:'ines',scene:{before:'S9',after:'S10'},timer:360,bpm:70,parScore:19000,consult:true,scalpelMult:.75,sites:sites('brain'),\n patient:patient('Nadia Bloom',29,'School music teacher','Class 4 sent a card signed “Please do not miss.”','Back with Class 4. They have sent a second card.','buns','#a97655'),teaches:['legato','sforzando'],phases:[\n phase('membrane','Open the membrane. Precise hands.',['scalpel'],[cut(-.7,-.2,.65,-.12),cut(-.65,.24,.7,.2)]),\n phase('chain','Cut the glowing tail. Carry every bead away.',['scalpel','forceps'],[e('legato',0,0,{links:12})],{strain:'legato'}),\n phase('thrash','SFORZANDO. Sever the thrashing chain.',['sforzando','scalpel','forceps'],[e('legato',0,0,{links:6,speed:1.7})],{begin:{composure:100},say:'Now you will see how I work, Doctor.'}),\n phase('second','A second chain. Tail first, Doctor.',['scalpel','forceps'],[e('legato',0,0,{links:8,twoTails:true})]),\n phase('repair','Repair the vessel. Clamps out. Seal.',['suture','clamp','gel'],[bleeder(-.8,0),wound(0,0,10,1),zone(1.2,.4)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'fermata',chapter:3,title:'Fermata',doctor:'ren',scene:{before:'S11',after:'S12'},timer:420,bpm:88,parScore:18500,consult:true,sites:sites('heart'),\n patient:patient('Dr. Augustin Bell',66,'Chief of Surgery','Has told every surgeon here to quit smoking. Smokes.','Under arrest. Recovering. Has quit.','bald','#e6b292'),teaches:['crescendo','fermata','defib'],phases:[\n phase('open','Open and disinfect the field.',['scalpel','gel'],[cut(-.75,0,.75,0),zone(1.5,.4)],{ordered:true}),\n phase('crescendo','Kill four feeders. Cut and extract the ring.',['laser','scalpel','forceps'],[e('crescendo',0,0,{size:.2,embed:.3,axis:90})],{strain:'crescendo'}),\n phase('first-arrest','CARDIAC ARREST. Charge. Release in gold.',['defib'],[],{begin:{arrest:true,arrestTime:14},done:{arrestsSurvived:1},strain:'fermata'}),\n phase('antidote','Inject three antidote sites. Clamp bleeding.',['syringe','clamp'],[e('injection',-.6,0),e('injection',0,.3),e('injection',.6,0),bleeder(-.4,-.3),bleeder(.4,-.3)]),\n phase('second-arrest','Laser the eye. Then CLEAR\"'!'\"',['laser','defib'],[e('fermata',0,0,{hp:60})],{begin:{arrest:true,arrestTime:12},done:{arrestsSurvived:1}}),\n phase('third-arrest','Laser. Shock. Extract the eye.',['laser','defib','forceps'],[e('fermata',0,0,{hp:80,extract:true,embed:.25,axis:90})],{begin:{arrest:true,arrestTime:14}}),\n phase('close','Remove clamps. Close the heart.',['clamp','suture','gel'],[bleeder(-.7,.25),bleeder(.7,.25),wound(0,0,10,1.2),zone(1.3,.5)],{ordered:true,clampsOn:true,done:{all:true,allClampsOff:true}})]},\n {id:'coda',chapter:4,title:'Coda',doctor:'ren',scene:{before:'S13',after:'S14'},timer:570,bpm:92,parScore:26500,consult:true,sites:sites('heart','lung','aorta'),\n patient:patient('Beatrice Okonkwo',58,'Head Nurse · OR 3','In her own handwriting: “Do not be dramatic about this.”','Discharged herself. Is back in OR 3. Has opinions.','wrap','#915c43'),teaches:['coda'],phases:[\n phase('exposition','Adagio and Staccato. Keep her with us.',['laser','forceps','gel'],[e('adagio',-.3,0,{hp:100,embed:.2,axis:90}),e('nest',.65,.1),e('note',.5,-.3,{hp:8,ttl:10})],{strain:'adagio',say:'“Suction before you cannot see.” She underlined that twice.'}),\n phase('development','Switch to the lung. Pin and sever.',['scanner','laser','scalpel','forceps'],[e('tremolo',-.5,0,{hp:40,pinsRequired:2}),e('legato',.4,0,{links:5})],{site:1,strain:'tremolo'}),\n phase('recapitulation','The aorta. Stop the crescendo.',['laser','scalpel','forceps'],[e('crescendo',0,0,{size:.2,embed:.3,axis:90})],{site:2,strain:'crescendo'}),\n phase('rest','Her heart has stopped. Laser. Defibrillate.',['laser','defib'],[e('fermata',0,0,{hp:60})],{site:0,begin:{arrest:true,arrestTime:12},done:{arrestsSurvived:1},strain:'fermata'}),\n phase('conductor','CODA. Cut the batons. Strike during the rest.',['scalpel','laser','forceps'],[e('coda',0,0,{hp:300,embed:.6,axis:90,arms:2})],{strain:'coda'}),\n phase('closing','Close every site. Remove every clamp.',['suture','gel','clamp'],[wound(0,0,8,1.1),{...wound(0,0,8,1.1),site:1},{...wound(0,0,8,1.1),site:2},bleeder(-.7,.15)],{clampsOn:true,done:{all:true,allClampsOff:true}}),\n phase('last-stop','Listen, Doctor. Bring her back.',['hush','defib'],[],{site:0,begin:{composure:100,arrest:true,arrestTime:12,doctor:'ren'},done:{arrestsSurvived:1},say:'Her notebook ends here, Doctor.'})]},\n {id:'last-patient',chapter:4,title:'Last Patient',doctor:'ren',scene:{before:'S15',after:'S16'},timer:0,bpm:60,parScore:0,unfailing:true,sites:sites('heart'),\n patient:patient('Dr. Cordelia Voss',71,'Founder · Cardiac unit','“Deceased.” Seventeen years ago. Crossed out by Ren.','Tonight’s patient survived.','long','#d9bfae'),teaches:[],phases:[\n phase('clamp','',['clamp'],[bleeder(0,0)],{say:'She is a patient.'}),\n phase('heartbeat','',['defib'],[],{begin:{arrest:true,arrestTime:60},done:{arrestsSurvived:1},say:'Tonight, the room is quiet for her.'})]},\n {id:'grand-rounds',chapter:0,title:'Grand Rounds',doctor:'ren',timer:300,bpm:82,parScore:22000,sites:sites('liver','bowel','heart'),\n patient:patient('Ngaio Reeve',55,'Harbor master','Ward Zero has only this to say: everyone scrub in.','A harbor needs every pair of hands. So does a heart.','slick','#ac775b'),teaches:[],phases:[\n phase('open','Split the work. Open, extract, disinfect.',['scalpel','forceps','gel','clamp'],[cut(-.6,.2,.6,.2),zone(1.3,.35),...[-.6,-.2,.2,.6].map(x=>({...shard(x,0),site:1})),{...bleeder(-.5,.2),site:2},{...bleeder(.5,-.2),site:2}],{ordered:true}),\n phase('first-movement','Adagio on the liver. Notes on the bowel.',['laser','forceps','scanner','gel'],[e('adagio',0,0,{hp:100,embed:.25,axis:90}),e('nest',-.4,0,{site:1,hidden:true}),e('note',.5,0,{site:1,hp:8,ttl:12})]),\n phase('second-movement','Legato on the bowel. Crescendo at the heart.',['scalpel','laser','forceps'],[e('legato',0,0,{links:6,site:1}),e('crescendo',0,0,{size:.2,site:2,embed:.3,axis:90})]),\n phase('arrest','One heart. Any surgeon’s shock counts.',['defib','syringe'],[],{site:2,begin:{arrest:true,arrestTime:14},done:{arrestsSurvived:1}}),\n phase('close','Close every site. No instruments left behind.',['suture','gel','clamp'],[wound(0,0,6,1),{...wound(0,0,6,1),site:1},{...wound(0,0,6,1),site:2},zone(1.2,.4)],{ordered:true,done:{all:true,allClampsOff:true}})]}\n];\nexport const GRAND_ROUNDS=8;\nexport const kinds=['gelZone','incision','wound','shard','pool','bleeder','nodule','tumor','tether','scanMark','adagio','egg','nest','note','tremolo','legato','crescendo','feeder','fermata','coda','injection','scratch','spore','piece'];\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"agent_message","text":"The operation data is in place, including every tool and parasite, phase checkpoints, the final patient, and Grand Rounds. The title draw selected **Trauma Tempo: Encore**. I’m now implementing the tool interactions and the bot that will test campaign completion.\n"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim/math.js <<'EOF'\nexport const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));\nexport const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);\nexport function seeded(seed=2147){let s=seed>>>0;return()=>{s+=0x6D2B79F5;let t=s;t=Math.imul(t\"'^t>>>15,t|1);t''^=t+Math.imul(t''^t>>>7,t|61);return ((t''^t>>>14)>>>0)/4294967296;};}\nexport function project(x,y,points){let best={d:Infinity,t:0,x:points[0][0],y:points[0][1]};let total=0;const lengths=[];for(let i=1;i<points.length;i++){const n=Math.hypot(points[i][0]-points[i-1][0],points[i][1]-points[i-1][1]);lengths.push(n);total+=n;}let off=0;for(let i=1;i<points.length;i++){const [a,b]=points[i-1],[c,d]=points[i],dx=c-a,dy=d-b;const t=clamp(((x-a)*dx+(y-b)*dy)/(dx*dx+dy*dy||1),0,1),px=a+t*dx,py=b+t*dy,n=Math.hypot(x-px,y-py);if(n<best.d)best={d:n,x:px,y:py,t:(off+t*lengths[i-1])/(total||1)};off+=lengths[i-1];}return best;}\nexport function pointAt(points,f){let lengths=[],total=0;for(let i=1;i<points.length;i++){let l=Math.hypot(points[i][0]-points[i-1][0],points[i][1]-points[i-1][1]);lengths.push(l);total+=l;}let t=clamp(f,0,1)*total;for(let i=0;i<lengths.length;i++){if(t<=lengths[i]||i===lengths.length-1){const q=t/(lengths[i]||1);return {x:points[i][0]+(points[i+1][0]-points[i][0])*q,y:points[i][1]+(points[i+1][1]-points[i][1])*q};}t-=lengths[i];}return{x:points[0][0],y:points[0][1]};}\nexport const inDrape=(x,y)=>(x/1.4)**2+(y/.85)**2<=1;\nexport const inTray=(x,y)=>x>1.37&&x<1.89&&y>-.2&&y<.6;\nexport function hash(value){let n=2166136261;const s=JSON.stringify(value);for(let i=0;i<s.length;i++)n=Math.imul(n''^s.charCodeAt(i),16777619);return(n>>>0).toString(16);}\nEOF\ncat > src/sim/beat.js <<'\"'EOF'\nexport function stepBeat(state,dt,tuning,base){const target=base+tuning.tempoPressure*(1-state.vitals/100);state.bpm+=(target-state.bpm)*Math.min(1,dt);if(state.arrest)return false;state.beatPhase+=dt*state.bpm/60;let hit=false;while(state.beatPhase>=1){state.beatPhase-=1;state.beat++;state.bar=Math.floor(state.beat/4);hit=true;}state.pulse=Math.exp(-state.beatPhase*9);return hit;}\nexport function beatDistance(s){return Math.min(s.beatPhase,1-s.beatPhase)*60/s.bpm;}\nEOF\ncat > src/sim/scoring.js <<'EOF'\nexport const rankTitles={S:'Chief of Surgery',A:'Attending',B:'Resident',C:'Intern',D:'Malpractice Suit Pending'};\nexport function gradeAction(s,grade,tuning,seat){const points={FLAWLESS:300,CLEAN:150,ROUGH:50,MISS:-100}[grade];if(grade==='MISS'){s.misses++;s.combo=0;}else if(grade\"'!=='\"'ROUGH')s.combo++;s.bestCombo=Math.max(s.bestCombo,s.combo);const gain=Math.round(points*(grade==='MISS'?1:1+.05*Math.min(20,s.combo)));s.score=Math.max(0,s.score+gain);s.actions++;if(grade==='FLAWLESS')s.flawless++;s.composure=Math.max(0,Math.min(100,s.composure+({FLAWLESS:10,CLEAN:5,ROUGH:0,MISS:-10}[grade])*tuning.composureGain));if(seat){seat.score+=gain;seat.actions++;if(grade\"'!=='\"'MISS')seat.clean++;}return gain;}\nexport function finalRank(s,par,assist=false){const v=s.score/Math.max(1,par);const r=v>=.9?'S':v>=.75?'A':v>=.55?'B':v>=.35?'C':'D';return assist&&['S','A'].includes(r)?'B':r;}\nEOF\ncat > src/sim/physics.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nlet promise;\nexport const initPhysics=()=>promise??=(RAPIER.init());\nexport class Physics {\n constructor(seats){this.world=new RAPIER.World({x:0,y:-9.81,z:0});this.world.timestep=1/60;this.bodies=new Map();this.joints=new Map();this.tips=new Map();\n const ground=this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(1.62,-.09,-.2));this.world.createCollider(RAPIER.ColliderDesc.cuboid(.26,.025,.41),ground);\n for(const s of seats){const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(s.x,.35,-s.y));this.tips.set(s.id,body);}}\n add(e){if(\"'!['\"'shard','tumor','piece','adagio','fermata','coda','crescendo'].includes(e.kind))return;const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(e.x,.14,-e.y).setLinearDamping(4).setAngularDamping(3).setGravityScale(0));this.world.createCollider(RAPIER.ColliderDesc.ball(e.kind==='shard'?.04:.065).setDensity(2).setRestitution(.25),body);this.bodies.set(e.id,body);}\n grip(seat,e){this.release(seat);let b=this.bodies.get(e.id);if(\"'!b){this.add(e);b=this.bodies.get(e.id);}if(!b)return;const tip=this.tips.get(seat.id);b.setTranslation({x:e.x,y:.2,z:-e.y},true);b.setGravityScale(0,true);const j=this.world.createImpulseJoint(RAPIER.JointData.spring(0,60,6,{x:0,y:0,z:0},{x:0,y:0,z:0}),tip,b,true);this.joints.set(seat.id,j);}\n release(seat,e,deposit=false){const j=this.joints.get(seat.id);if(j){this.world.removeImpulseJoint(j,true);this.joints.delete(seat.id);}const b=e&&this.bodies.get(e.id);if(b){if(deposit){b.setTranslation({x:1.48+(e.id%5)*.065,y:.42,z:-.3+(e.id%3)*.09},true);b.setGravityScale(1,true);b.setLinvel({x:.06,y:.2,z:.03},true);}else b.setGravityScale(0,true);}}\n rope(a,b,length=.16){return this.world.createImpulseJoint(RAPIER.JointData.rope(length,{x:0,y:0,z:0},{x:0,y:0,z:0}),a,b,true);}\n step(seats){for(const s of seats)this.tips.get(s.id)?.setNextKinematicTranslation({x:s.x,y:s.held?.42:.28,z:-s.y});this.world.step();}\n positions(){return [...this.bodies].map(([id,b])=>({id,...b.translation()}));}\n free(){this.world.free();}\n}\nEOF\ncat > src/sim/sim.js <<'\"'EOF'\nimport {operations} from '../data/ops/index.js';\nimport {defaults,difficulty,tools} from '../config/tuning.js';\nimport {clamp,dist,seeded,project,pointAt,inTray,inDrape,hash} from './math.js';\nimport {stepBeat,beatDistance} from './beat.js';\nimport {gradeAction,finalRank} from './scoring.js';\nimport {Physics} from './physics.js';\nexport const DT=1/60;\nconst extractKinds=['shard','tumor','piece','adagio','fermata','crescendo','coda'];\nexport class Sim {\n constructor({op=0,players=[{id:0,name:'Doctor',color:'#f2b134'}],seed=1847,rng,tuning={},level='normal',doctor,consult='careful',assist=false}={}){\n this.op=typeof op==='number'?operations[op]:op;this.opIndex=operations.indexOf(this.op);this.tuning={...defaults,...tuning};this.level=level;this.diff=difficulty[level]||difficulty.normal;this.rng=rng||seeded(seed);this.events=[];this.inputs=new Map();this.nextId=1;this.assist=assist;this.consult=this.op.consult?consult:null;this.failures={};\n const time=this.op.timer*this.diff.time*this.tuning.timerMult+(this.consult==='careful'?60:this.consult==='aggressive'?-40:0);\n this.state={op:this.opIndex,phase:0,phaseTime:0,tick:0,elapsed:0,vitals:100,minVitals:100,timer:time,timerStart:time,score:0,combo:0,bestCombo:0,misses:0,actions:0,flawless:0,rank:null,doctor:doctor||this.op.doctor,composure:0,hush:0,sforzando:0,freeze:0,beat:0,bar:0,beatPhase:0,bpm:this.op.bpm,pulse:0,site:0,entities:[],tray:[],seats:players.map((p,i)=>({...p,x:-.3+i*.2,y:0,tool:3,site:0,held:null,cooldown:0,score:0,actions:0,clean:0,stats:{Cuts:0,Stitches:0,Burns:0,Saves:0},use:0,steady:false,seq:0})),status:'playing',arrest:false,arrestLeft:0,arrestsSurvived:0,objective:'',clamps:4,notes:assist,progressAt:0};\n this.cheats={god:false,freezeTimer:false,infiniteComposure:false,infiniteClamps:false};this.physics=new Physics(this.state.seats);this.beginPhase(0);\n }\n emit(type,data={}){this.events.push({type,...data,tick:this.state.tick});}\n drainEvents(){const e=this.events;this.events=[];return e;}\n get phase(){return this.op.phases[this.state.phase];}\n input(id,frame){if(this.state.seats.some(s=>s.id===id))this.inputs.set(id,{...frame});}\n spawn(spec,required=true){const s=this.state,site=spec.site??this.phase.site??s.site;\n const e={id:this.nextId++,site,required,done:false,marked:\"'!spec.hidden,age:0,progress:0, ...structuredClone(spec)};\n e.x??=e.at?.[0]??0;e.y??=e.at?.[1]??0;e.ox=e.x;e.oy=e.y;\n if(e.hp){e.hp*=this.tuning.strainHpMult*this.diff.hp*(this.opIndex===8?1+.25*(s.seats.length-1):1);e.maxHp=e.hp;}\n if(e.kind==='\"'gelZone'){e.c