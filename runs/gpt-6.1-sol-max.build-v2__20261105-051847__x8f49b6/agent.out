{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"cat >> src/ui/ui.css <<'EOF'\n@media(max-width:600px) and (max-aspect-ratio:3/4){.chart{margin-top:2vh;padding:1.6rem}.chart-id{font-size:1.5rem}.chart h2{font-size:3.4rem;line-height:1.05;margin-top:.7rem}.chart-job{font-size:1.9rem}.chart-note{font-size:2rem;margin:.9rem 0}.chart-operation{font-size:1.55rem;padding-top:.7rem}.chart-operation strong{font-size:2.2rem}.chart-controls{margin-top:.8rem}.chart-controls label{font-size:1.6rem}.chart select{font-size:1.7rem;padding:.4rem}.consult-btn{font-size:1.8rem;padding:.45rem .6rem;line-height:1.1}.chart .primary{margin-top:.9rem;min-height:4rem;font-size:2.3rem}.chart-screen>.bottom-bar{font-size:1.5rem;bottom:3vh}}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/run-all.mjs');s=p.read_text().replace(\\\"async function test(name,fn){try\\\", \\\"async function test(name,fn){if(process.env.TEST_FILTER&&\"'!name.toLowerCase().includes(process.env.TEST_FILTER.toLowerCase()))return;try\");p.write_text(s)\np=Path('\"'tests/sim/suite.mjs');s=p.read_text().replace(\\\"const make=(spawn=[],extra={})=>\\\", \\\"const make=(spawn=[],extra={},players)=>\\\").replace(\\\"const sim=new Sim({op});owned.push(sim);return sim;\\\", \\\"const sim=new Sim({op,players});owned.push(sim);return sim;\\\",1)\nanchor=\\\" await test('snapshots / delta\\\"\nidx=s.index(anchor)\naddition=''' await test('Crescendo / sixteen-beat feeder regrowth never exceeds four live feeders',()=>{const sim=make([{kind:'crescendo',x:0,y:0,size:.2}]);const c=ent(sim,'crescendo');sim.state.entities.find(e=>e.parent===c.id).done=true;sim.updateEntities(1/60,1/60);assert.ok(c.nextRegrowBeat);sim.state.beat=c.nextRegrowBeat;sim.strainBeat();assert.equal(sim.state.entities.filter(e=>e.parent===c.id&&\"'!e.done).length,4);sim.state.entities.find(e=>e.parent===c.id&&!e.done).done=true;sim.state.beat=c.nextRegrowBeat;sim.strainBeat();assert.equal(sim.state.entities.filter(e=>e.parent===c.id&&!e.done).length,4);});\n await test('\"'Legato / cutting the wrong link re-heals two removed connections',()=>{const sim=make([{kind:'legato',x:0,y:0,links:4}]);const c=ent(sim,'legato');c.remaining=1;for(let i=2;i<4;i++){c.nodes[i].cut=true;c.nodes[i].deposited=true;}const n=c.nodes[0];frames(sim,1,{tool:0,x:n.x-.05,y:n.y});frames(sim,1,{tool:0,x:n.x,y:n.y,use:1});assert.equal(c.remaining,3);assert.ok(\"'!c.nodes[2].deposited&&!c.nodes[3].deposited);assert.ok(sim.state.misses);});\n await test('\"'co-op / a gripped object belongs to exactly one pair of forceps',()=>{const sim=make([{kind:'shard',x:0,y:0,axis:90,embed:.2}],{},[{id:0,name:'First'},{id:1,name:'Second'}]);sim.input(0,{tool:1,x:0,y:0,use:1});sim.input(1,{tool:1,x:0,y:0,use:1});sim.step();assert.ok(sim.state.seats[0].held);assert.equal(sim.state.seats[1].held,null);assert.equal(sim.physics.joints.size,1);});\n'''\ns=s[:idx]+addition+s[idx:];p.write_text(s)\nPY\nnpm run build\nTEST_FILTER=responsive node tests/run-all.mjs browser\nnode tests/run-all.mjs sim\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
