('result',await p.evaluate(()=>__game.state()));await p.click('[data-action=continueReport]');await p.keyboard.press('Tab');await p.keyboard.press('Tab');console.log('next',await p.evaluate(()=>__game.state().screen));await b.close();\nEOF\nnode tests/browser/flow-probe.mjs\"","aggregated_output":"\n> surgical-cadence@1.0.0 build\n> node tools/build.mjs\n\nmenu Main Menu\nstory Story\nchart Chart\nresult {\n  screen: 'Report',\n  op: 0,\n  phase: 5,\n  vitals: 97.35258333332294,\n  timer: 111.78333333324514,\n  score: 9369,\n  rank: 'A',\n  bpm: 73.56745000000598,\n  beat: 156,\n  site: 0,\n  tool: 3,\n  tips: [\n    {\n      id: 0,\n      x: 0.4050959050993019,\n      y: 0.07195067595258321,\n      tool: 3,\n      use: 1,\n      site: 0,\n      score: 5363\n    }\n  ],\n  focusId: 'continueReport',\n  promptSet: 'mouse',\n  glyphSet: 'playstation',\n  attract: false,\n  devOpen: false,\n  renderBackend: 'webgl2',\n  musicGain: 0.10000000149011612,\n  tuning: {\n    tipSpeed: 1.9,\n    stickCurve: 1.7,\n    aimAssist: 0.35,\n    steadyFactor: 0.4,\n    scalpelTol: 0.055,\n    pullTol: 1.6,\n    suctionRate: 1,\n    gelRadius: 0.16,\n    stitchGateR: 0.07,\n    laserDps: 30,\n    laserBurn: 2,\n    scannerRadius: 0.3,\n    clampWindow: 0.18,\n    defibWindow: 0.3,\n    drainMult: 1,\n    timerMult: 1,\n    tempoPressure: 60,\n    stabilizerHeal: 15,\n    stabilizerCooldown: 3,\n    missLimit: 8,\n    strainHpMult: 1,\n    strainSpeedMult: 1,\n    spawnRateMult: 1,\n    composureGain: 1,\n    hushDuration: 7,\n    hushTimeScale: 0.25,\n    sforzandoStun: 3,\n    sforzandoDamage: 0.25,\n    sforzandoToolMult: 2,\n    sforzandoDuration: 6\n  },\n  reached: [\n    'Title',\n    'Main Menu',\n    'storyMenu',\n    'Difficulty',\n    'Story',\n    'Chart',\n    'Operation',\n    'Report'\n  ],\n  status: 'won',\n  storyId: 'S1',\n  storyLine: 0,\n  progress: 1,\n  notes: false\n}\nnext Chart\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tests/sim/suite.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFileSync,readdirSync} from 'node:fs';\nimport {Sim} from '../../src/sim/sim.js';\nimport {initPhysics} from '../../src/sim/physics.js';\nimport {botInput} from '../../src/sim/bot.js';\nimport {stepBeat} from '../../src/sim/beat.js';\nimport {gradeAction,finalRank} from '../../src/sim/scoring.js';\nimport {snapshot,keyframe,applySnapshot} from '../../src/sim/snapshot.js';\nimport {defaults,tools,difficulty} from '../../src/config/tuning.js';\nimport {operations,kinds} from '../../src/data/ops/index.js';\nimport {story,barks} from '../../src/data/story/index.js';\nimport {cast} from '../../src/data/cast.js';\nimport {inDrape,dist} from '../../src/sim/math.js';\nconst close=(a,b,eps=.01)=>assert.ok(Math.abs(a-b)<eps,\"'`${a} ≠ ${b}`);\nconst owned=[];\nconst make=(spawn=[],extra={})=>{const op={...operations[0],id:'\"'rules',sites:[{id:'heart',organ:'heart'},{id:'lung',organ:'lung'},{id:'aorta',organ:'aorta'}],phases:[{id:'rule',objective:'Verify a rule',tools,spawn,done:{vitalsAbove:101},...extra}]};const sim=new Sim({op});owned.push(sim);return sim;};\nconst frames=(sim,n,f={})=>{for(let i=0;i<n&&sim.state.status==='playing';i++){sim.input(0,typeof f==='function'?f(i,sim.state):f);sim.step();}};\nconst ent=(sim,kind)=>sim.state.entities.find(e=>e.kind===kind);\nconst player=sim=>sim.state.seats[0];\nconst play=(op,opts={})=>{const sim=new Sim({op,...opts});let ordinaryMin=100;for(let n=0;n<90000&&sim.state.status==='playing';n++){for(const seat of sim.state.seats)sim.input(seat.id,botInput(sim,seat.id,opts.bot));sim.step();if(\"'!sim.state.arrest&&!sim.phase.begin?.vitalsSet)ordinaryMin=Math.min(ordinaryMin,sim.state.vitals);sim.drainEvents();}return{sim,ordinaryMin};};\nexport async function run(test){\n await initPhysics();\n await test('\"'clock / all beat-driven systems share one pressure-smoothed clock',()=>{const s={vitals:20,bpm:72,beatPhase:0,beat:0,bar:0};for(let i=0;i<120;i++)stepBeat(s,1/60,defaults,72);assert.ok(s.bpm>110&&s.beat>=3);close(s.pulse,Math.exp(-s.beatPhase*9));s.arrest=true;const before=s.beatPhase;stepBeat(s,2,defaults,72);close(s.beatPhase,before);});\n await test('input / speed, radial deadzone, response curve and steady',()=>{const sim=make();frames(sim,60,{ax:1});close(player(sim).x+.3,defaults.tipSpeed,.02);player(sim).x=0;frames(sim,60,{ax:.1});close(player(sim).x,0);frames(sim,60,{ax:1,steady:true});close(player(sim).x,defaults.tipSpeed*defaults.steadyFactor,.02);});\n await test('input / absolute aim clamps to the physical field',()=>{const sim=make();frames(sim,1,{x:8,y:-8});close(player(sim).x,1.9);close(player(sim).y,-.95);});\n await test('scoring / precise grades, combo cap, misses and composure',()=>{const sim=make();const s=sim.state;s.score=0;gradeAction(s,'FLAWLESS',defaults,player(sim));assert.equal(s.score,315);assert.equal(s.composure,10);gradeAction(s,'ROUGH',defaults,player(sim));assert.equal(s.combo,1);gradeAction(s,'MISS',defaults,player(sim));assert.equal(s.combo,0);assert.equal(s.misses,1);for(let i=0;i<30;i++)gradeAction(s,'CLEAN',defaults,player(sim));assert.equal(s.composure,100);assert.equal(finalRank({score:900},1000),'S');assert.equal(finalRank({score:800},1000,true),'B');});\n await test('scalpel / guide tracing, precision grading and no lost progress',()=>{const sim=make([{kind:'incision',x:-.5,y:0,points:[[-.5,0],[.5,0]]}]);frames(sim,1,{tool:0,x:-.5,y:0,use:1});frames(sim,110,i=>({tool:0,x:-.5+i/109,y:0,use:1}));assert.ok(ent(sim,'incision').done);assert.equal(sim.state.misses,0);assert.ok(sim.state.flawless>0);});\n await test('scalpel / nicks cost vitals and retained cuts resume',()=>{const sim=make([{kind:'incision',x:-.5,y:0,points:[[-.5,0],[.5,0]]}]);frames(sim,1,{tool:0,x:-.5,y:0,use:1});frames(sim,20,i=>({tool:0,x:-.5+i*.01,y:0,use:1}));const progress=ent(sim,'incision').progress;frames(sim,1,{tool:0,x:-.3,y:.2,use:1});assert.ok(sim.state.misses);close(ent(sim,'incision').progress,progress);assert.ok(ent(sim,'pool'));});\n await test('forceps / spring grip, resisted direction, smooth pop and tray trophy',()=>{const sim=make([{kind:'shard',x:0,y:0,axis:0,embed:.2,poolOnRemove:.4}]);frames(sim,1,{tool:1,x:0,y:0,use:1});assert.ok(player(sim).held);assert.equal(sim.physics.joints.size,1);frames(sim,20,i=>({tool:1,x:0,y:.01*i,use:1}));assert.ok(\"'!ent(sim,'\"'shard').embedded);player(sim).x=0;player(sim).y=0;frames(sim,25,i=>({tool:1,x:i*.01,y:0,use:1}));assert.ok(ent(sim,'shard').embedded);frames(sim,40,{tool:1,x:1.62,y:.2,use:1});frames(sim,1,{tool:1,x:1.62,y:.2,use:0});assert.equal(sim.state.tray.length,1);assert.ok(ent(sim,'shard').done);assert.ok(ent(sim,'pool'));assert.equal(sim.physics.joints.size,0);});\n await test('forceps / excessive speed tears and the item remains embedded',()=>{const sim=make([{kind:'shard',x:0,y:0,axis:0,embed:.3}]);frames(sim,1,{tool:1,x:0,y:0,use:1});frames(sim,1,{tool:1,x:.4,y:0,use:1});assert.ok(sim.state.misses);assert.ok(\"'!ent(sim,'\"'shard').embedded);assert.ok(sim.state.vitals<100);});\n await test('forceps / dropping away from the tray loses one vital and can be recovered',()=>{const sim=make([{kind:'piece',x:0,y:0,embed:0}]);frames(sim,1,{tool:1,x:0,y:0,use:1});frames(sim,1,{tool:1,x:0,y:0,use:0});assert.ok(\"'!ent(sim,'\"'piece').done);assert.equal(player(sim).held,null);assert.ok(sim.state.vitals<=99);frames(sim,1,{tool:1,x:0,y:0,use:1});assert.ok(player(sim).held);});\n await test('suction / analog drain rate and overflow consequences',()=>{const sim=make([{kind:'pool',x:0,y:0,vol:1.5}]);frames(sim,30,{tool:2,x:0,y:0,use:.5});close(ent(sim,'pool').vol,1.25,.015);assert.ok(sim.state.vitals<100);frames(sim,100,{tool:2,x:0,y:0,use:1});assert.ok(ent(sim,'pool').done);});\n await test('gel / coverage grid, scratches, spores and sealed nests',()=>{const sim=make([{kind:'gelZone',x:0,y:0,w:.3,h:.2,parTime:8},{kind:'scratch',x:.4,y:0},{kind:'spore',x:.6,y:0},{kind:'nest',x:-.5,y:0}]);frames(sim,3,{tool:3,x:0,y:0,use:1});frames(sim,3,{tool:3,x:.1,y:0,use:1});assert.ok(ent(sim,'gelZone').done);for(const x of [.4,.6,-.5])frames(sim,65,{tool:3,x,y:0,use:1});for(const k of ['scratch','spore','nest'])assert.ok(ent(sim,k).done);});\n await test('suture / ordered gates, visible progress, manual knot',()=>{const gates=[[-.3,.08],[-.1,-.08],[.1,.08],[.3,-.08]],sim=make([{kind:'wound',x:0,y:0,gates}]);frames(sim,1,{tool:4,x:.1,y:.08,use:1});assert.equal(ent(sim,'wound').gate,0);for(const [x,y]of gates)frames(sim,1,{tool:4,x,y,use:1});assert.equal(ent(sim,'wound').gate,4);frames(sim,1,{tool:4,alt:true});assert.ok(ent(sim,'wound').done);});\n await test('suture / tear penalty and automatic tie grade',()=>{const sim=make([{kind:'wound',x:0,y:0,gates:[[0,0],[.1,.1]]}]);frames(sim,1,{tool:4,x:0,y:0,use:1});frames(sim,1,{tool:4,x:.7,y:.5,use:1});assert.equal(sim.state.misses,1);frames(sim,1,{tool:4,x:.1,y:.1,use:1});frames(sim,100,{});assert.ok(ent(sim,'wound').done);});\n await test('laser / analog DPS, bare-tissue grace, burn and forced vent',()=>{const sim=make([{kind:'nodule',x:0,y:0,hp:1000}]);frames(sim,60,{tool:5,x:0,y:0,use:.5});close(ent(sim,'nodule').hp,985,.1);const initial=sim.state.vitals;frames(sim,10,{tool:5,x:.8,y:.4,use:1});assert.ok(initial-sim.state.vitals<.02);frames(sim,40,{tool:5,x:.8,y:.4,use:1});assert.ok(sim.state.vitals<initial-1);frames(sim,310,{tool:5,x:0,y:0,use:1});assert.ok(player(sim).vent>0);});\n await test('scanner / concealed targets are protected until 0.6 second marking',()=>{const sim=make([{kind:'nodule',x:0,y:0,hp:20,hidden:true}]);frames(sim,60,{tool:5,x:0,y:0,use:1});assert.equal(ent(sim,'nodule').hp,20);frames(sim,37,{tool:6,x:0,y:0,use:1});assert.ok(ent(sim,'nodule').marked);frames(sim,45,{tool:5,x:0,y:0,use:1});assert.ok(ent(sim,'nodule').done);});\n await test('clamp / beat grade, capacity and removal interlock',()=>{const sim=make([{kind:'bleeder',x:0,y:0}],{done:{all:true,allClampsOff:true}});sim.state.beatPhase=0;frames(sim,1,{tool:7,x:0,y:0,use:1});assert.ok(ent(sim,'bleeder').clamped);assert.equal(sim.state.clamps,3);assert.ok(\"'!sim.phaseComplete());frames(sim,1,{tool:7,x:0,y:0,alt:true});assert.ok(ent(sim,'\"'bleeder').removed);assert.equal(sim.state.clamps,4);});\n await test('syringe / IV, cooldown and context-sensitive antidote',()=>{const sim=make([{kind:'injection',x:.6,y:0}]);sim.state.vitals=50;frames(sim,31,{x:0,y:0,syringe:true});close(sim.state.vitals,65,.1);assert.ok(player(sim).cooldown>2.9);frames(sim,190,{});frames(sim,50,{x:.6,y:0,syringe:true});assert.ok(ent(sim,'injection').done);});\n await test('defibrillator / weak release loses time; gold release restarts the heart',()=>{const sim=make();sim.arrest(12);frames(sim,30,{charge:1,use:1,steady:true});frames(sim,1,{});assert.ok(sim.state.arrest);assert.ok(sim.state.arrestLeft<10);frames(sim,72,{charge:1,use:1,steady:true});frames(sim,1,{});assert.ok(\"'!sim.state.arrest);assert.equal(sim.state.arrestsSurvived,1);assert.equal(sim.state.vitals,65);});\n await test('\"'gifts / Hush freezes then slows the clock without slowing tools',()=>{const sim=make([{kind:'pool',x:0,y:0,vol:2}]);sim.state.composure=100;frames(sim,1,{special:true});const timer=sim.state.timer;frames(sim,24,{tool:2,x:0,y:0,use:1});assert.ok(timer-sim.state.timer<.02);assert.ok(ent(sim,'pool').vol<1.65);frames(sim,60,{});assert.ok(timer-sim.state.timer<.3);});\n await test('gifts / Sforzando stuns, damages and accelerates tools',()=>{const sim=make([{kind:'adagio',x:0,y:0,hp:100}]);sim.state.doctor='ines';sim.state.composure=100;frames(sim,1,{special:true});close(ent(sim,'adagio').hp,75);assert.ok(ent(sim,'adagio').stunned>2.9);frames(sim,30,{tool:5,x:0,y:0,use:1});assert.ok(ent(sim,'adagio').hp<50);});\n await test('checkpoints / phase retry restores a viable patient and honest assist cap',()=>{const sim=new Sim({op:1});owned.push(sim);sim.skipTo(3);sim.state.vitals=1;sim.state.timer=2;sim.state.score=20;sim.fail();sim.retry(true);assert.equal(sim.state.status,'playing');assert.ok(sim.state.vitals>=60);assert.ok(sim.state.timer>=90);assert.equal(sim.state.score,sim.checkpoint.score);assert.ok(sim.state.notes);sim.state.score=100000;sim.win();assert.equal(sim.state.rank,'B');});\n await test('failure / flatline, timer and malpractice are separate causes',()=>{for(const [field,value,reason]of [['vitals',0,'FLATLINE'],['timer',0,'TIME'],['misses',8,'MALPRACTICE']]){const sim=make();sim.state[field]=value;sim.step();assert.equal(sim.state.reason,reason);}});\n await test('difficulty / drain, time, tolerance and HP scale together',()=>{const a=new Sim({op:2,level:'easy'}),b=new Sim({op:2,level:'hard'});owned.push(a,b);assert.ok(a.state.timer>b.state.timer);a.damage(10);b.damage(10);assert.ok(a.state.vitals>b.state.vitals);a.skipTo(2);b.skipTo(2);assert.ok(ent(a,'adagio').hp<ent(b,'adagio').hp);});\n await test('Adagio / core multiplier, stun and five-second recovery',()=>{const sim=make([{kind:'adagio',x:0,y:0,hp:100}]);sim.state.beat=2;frames(sim,25,i=>({tool:5,x:ent(sim,'adagio').x,y:ent(sim,'adagio').y,use:1}));assert.ok(ent(sim,'adagio').hp<70);ent(sim,'adagio').hp=0;ent(sim,'adagio').stunned=.1;frames(sim,8,{});assert.equal(ent(sim,'adagio').hp,40);});\n await test('Staccato / off-beat nest notes burst and spores persist',()=>{const sim=make([{kind:'nest',x:0,y:0},{kind:'note',x:.6,y:0,hp:8,ttl:.5}]);frames(sim,40,{});assert.ok(ent(sim,'spore'));frames(sim,60,{});assert.ok(sim.state.entities.some(e=>e.kind==='note'&&\"'!e.done));});\n await test('\"'Tremolo / quick approaches flee; slow scanner pins',()=>{const sim=make([{kind:'tremolo',x:0,y:0,hp:40,pinsRequired:3}]);frames(sim,1,{x:-.1,y:0});assert.ok(ent(sim,'tremolo').x>0);assert.ok(sim.state.vitals<100);const e=ent(sim,'tremolo');frames(sim,65,{tool:6,x:e.x,y:e.y,use:1,steady:true});assert.ok(e.pinned>0);assert.equal(e.pins,1);});\n await test('Legato / tail-first severing, wrong-link damage, eight-beat reattachment',()=>{const sim=make([{kind:'legato',x:0,y:0,links:4}]);const chain=ent(sim,'legato');const n=chain.nodes.at(-1);frames(sim,1,{tool:0,x:n.x-.05,y:n.y,use:0});frames(sim,1,{tool:0,x:n.x+.01,y:n.y,use:1});assert.ok(n.cut);assert.ok(ent(sim,'piece'));sim.state.beat=n.cutBeat+9;sim.strainBeat();assert.ok(\"'!n.cut);});\n await test('\"'Crescendo / feeder dependency and Fortissimo',()=>{const sim=make([{kind:'crescendo',x:0,y:0,size:.99,embed:.3}]);assert.equal(sim.state.entities.filter(e=>e.kind==='feeder').length,4);frames(sim,30,{});assert.ok(sim.state.entities.filter(e=>e.kind==='bleeder').length>=2);assert.ok(ent(sim,'crescendo').size<.9);for(const e of sim.state.entities.filter(e=>e.kind==='feeder'))e.done=true;frames(sim,1,{});assert.ok(ent(sim,'crescendo').exposed);});\n await test('Fermata / the eye must be destroyed before a strong shock works',()=>{const sim=make([{kind:'fermata',x:0,y:0,hp:60}]);sim.arrest(12);player(sim).charge=1.2;sim.shock(player(sim));assert.ok(sim.state.arrest);frames(sim,122,{tool:5,x:0,y:0,use:1});player(sim).charge=1.2;sim.shock(player(sim));assert.ok(\"'!sim.state.arrest);});\n await test('\"'Coda / severed arms stop downbeats; health thresholds change sites',()=>{const sim=make([{kind:'coda',x:0,y:0,hp:300,arms:2,embed:.6}]);const e=ent(sim,'coda');sim.state.beat=4;const before=sim.state.vitals;sim.strainBeat();assert.ok(sim.state.vitals<before);e.arms=0;const after=sim.state.vitals;sim.strainBeat();close(sim.state.vitals,after);e.hp=190;sim.updateEntities(1/60,1/60);assert.equal(e.site,1);e.hp=90;sim.updateEntities(1/60,1/60);assert.equal(e.site,2);});\n await test('snapshots / delta fits MTU; reliable topology round-trip',()=>{const sim=new Sim({op:8,players:Array.from({length:4},(_,id)=>({id,name:'Doctor '+id,color:'#f5b700'}))});owned.push(sim);sim.skipTo(2);const delta=snapshot(sim.state),full=keyframe(sim.state);assert.ok(JSON.stringify(delta).length<1100);assert.ok(JSON.stringify(full).length<16000);const decoded=applySnapshot(null,full);assert.equal(decoded.entities.length,sim.state.entities.length);assert.equal(decoded.seats.length,4);assert.equal(decoded.objective,sim.state.objective);assert.equal(applySnapshot(decoded,{...delta,n:decoded.tick-1}),decoded);});\n await test('determinism / same seed plus input gives identical simulation and Rapier positions',()=>{const a=new Sim({op:0,seed:934}),b=new Sim({op:0,seed:934});owned.push(a,b);a.skipTo(1);b.skipTo(1);for(let i=0;i<1200;i++){const f={ax:Math.sin(i*.03)*.2,ay:Math.cos(i*.02)*.2,tool:2};a.input(0,f);b.input(0,f);a.step();b.step();}assert.equal(a.hash(),b.hash());assert.deepEqual(a.physics.positions(),b.physics.positions());});\n await test('data / valid tools, entity kinds, speakers and in-drape targets',()=>{const coverage=new Set();for(const op of operations){for(const t of op.teaches)coverage.add(t);for(const p of op.phases){assert.ok(typeof p.objective==='string');assert.ok(p.spawn);for(const t of p.tools)assert.ok([...tools,'hush','sforzando','defib','syringe'].includes(t));for(const e of p.spawn){assert.ok(kinds.includes(e.kind),e.kind);assert.ok(inDrape(e.x,e.y),\"'`${op.id}/${p.id}: ${e.x}, ${e.y}`);for(const pt of [...(e.points||[]),...(e.gates||[])])assert.ok(inDrape(...pt));}}}for(const t of [...tools,'\"'syringe','defib','hush','sforzando','adagio','staccato','tremolo','legato','crescendo','fermata','coda'])assert.ok(coverage.has(t),t);for(const [id,scene] of Object.entries(story)){assert.ok(scene.lines.length<=30);for(const l of scene.lines){assert.ok(cast[l.who]);if(l.who==='bea'&&id\"'!=='\"'S16')assert.ok(\"'!/'\"\\\\bgood\\\\b/i.test(l.text));}}assert.ok(Object.values(story).reduce((n,s)=>n+s.lines.length,0)>=250);assert.ok(Object.values(barks).flat().length>=60);for(const l of Object.values(barks).flat())assert.ok(\"'!/'\"\\\\bgood\\\\b/i.test(l));});\n const results=[];\n for(let op=0;op<operations.length;op++)await test(\"'`campaign / normal bot completes ${operations[op].title}`,()=>{const {sim,ordinaryMin}=play(op);owned.push(sim);assert.equal(sim.state.status,'\"'won',\"'`${sim.state.reason} phase ${sim.state.phase} at ${sim.state.elapsed}`);if(op!==7){assert.ok(['\"'S','A'].includes(sim.state.rank),\"'`rank ${sim.state.rank}`);assert.ok(ordinaryMin>=35,`minimum ${ordinaryMin}`);assert.ok(sim.state.elapsed<sim.state.timerStart*.75,`slow ${sim.state.elapsed}`);}results.push({op,seconds:sim.state.elapsed,timer:sim.state.timerStart,score:sim.state.score,rank:sim.state.rank,min:ordinaryMin});});\n for(let op=0;op<7;op++)await test(`assist / imprecise bot completes ${operations[op].title} on Intern`,()=>{const {sim}=play(op,{level:'\"'easy',bot:{noise:.03,reactionDelay:.25}});owned.push(sim);assert.equal(sim.state.status,'won',\"'`${sim.state.reason} in phase ${sim.state.phase}`);assert.ok('\"'SABC'.includes(sim.state.rank));});\n for(let op=0;op<operations.length;op++)if(op\"'!==7)await test(`idle / no-input ${operations[op].title} fails honestly`,()=>{const sim=new Sim({op});owned.push(sim);frames(sim,70000);assert.equal(sim.state.status,'\"'failed');});\n for(let n=2;n<=4;n++)await test(\"'`co-op / ${n} surgeons independently contribute and complete Grand Rounds`,()=>{const players=Array.from({length:n},(_,id)=>({id,name:'\"'Doctor '+id,color:'#f2b134'})),{sim}=play(8,{players});owned.push(sim);assert.equal(sim.state.status,'won',\"'`${sim.state.reason} phase ${sim.state.phase}`);assert.ok(sim.state.seats.every(s=>s.score>0));});\n for(const sim of owned)sim.free();\n return results;\n}\nEOF\ncat > tests/run-all.mjs <<'\"'EOF'\nimport {writeFileSync,mkdirSync} from 'node:fs';\nlet passed=0,failed=0;const failures=[];const start=Date.now();\nconst warn=console.warn;console.warn=(...args)=>{if(\"'!String(args[0]).startsWith('\"'using deprecated parameters'))warn(...args);};\nasync function test(name,fn){try{await fn();passed++;}catch(e){failed++;const message=\"'`FAIL ${name}: ${e?.stack||e}`;failures.push(message);console.error(message);}}\nconst suite=process.argv[2];const results={};\nfor(const name of ['\"'sim','browser','hub'])if(\"'!suite||suite===name){try{const mod=await import(`./${name}/suite.mjs`);results[name]=await mod.run(test);}catch(e){await test(`${name} suite setup`,()=>{throw e;});}}\nmkdirSync('\"'artifacts',{recursive:true});writeFileSync(\"'`artifacts/test-results-${suite||'\"'all'}.json\"'`,JSON.stringify({passed,failed,seconds:(Date.now()-start)/1000,failures,results},null,2));\nconsole.log(`${passed} passed, ${failed} failed (${((Date.now()-start)/1000).toFixed(1)}s)`);process.exitCode=failed?1:0;\nEOF\nnode tests/run-all.mjs sim'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tests/sim/suite.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFileSync,readdirSync} from 'node:fs';\nimport {Sim} from '../../src/sim/sim.js';\nimport {initPhysics} from '../../src/sim/physics.js';\nimport {botInput} from '../../src/sim/bot.js';\nimport {stepBeat} from '../../src/sim/beat.js';\nimport {gradeAction,finalRank} from '../../src/sim/scoring.js';\nimport {snapshot,keyframe,applySnapshot} from '../../src/sim/snapshot.js';\nimport {defaults,tools,difficulty} from '../../src/config/tuning.js';\nimport {operations,kinds} from '../../src/data/ops/index.js';\nimport {story,barks} from '../../src/data/story/index.js';\nimport {cast} from '../../src/data/cast.js';\nimport {inDrape,dist} from '../../src/sim/math.js';\nconst close=(a,b,eps=.01)=>assert.ok(Math.abs(a-b)<eps,\"'`${a} ≠ ${b}`);\nconst owned=[];\nconst make=(spawn=[],extra={})=>{const op={...operations[0],id:'\"'rules',sites:[{id:'heart',organ:'heart'},{id:'lung',organ:'lung'},{id:'aorta',organ:'aorta'}],phases:[{id:'rule',objective:'Verify a rule',tools,spawn,done:{vitalsAbove:101},...extra}]};const sim=new Sim({op});owned.push(sim);return sim;};\nconst frames=(sim,n,f={})=>{for(let i=0;i<n&&sim.state.status==='playing';i++){sim.input(0,typeof f==='function'?f(i,sim.state):f);sim.step();}};\nconst ent=(sim,kind)=>sim.state.entities.find(e=>e.kind===kind);\nconst player=sim=>sim.state.seats[0];\nconst play=(op,opts={})=>{const sim=new Sim({op,...opts});let ordinaryMin=100;for(let n=0;n<90000&&sim.state.status==='playing';n++){for(const seat of sim.state.seats)sim.input(seat.id,botInput(sim,seat.id,opts.bot));sim.step();if(\"'!sim.state.arrest&&!sim.phase.begin?.vitalsSet)ordinaryMin=Math.min(ordinaryMin,sim.state.vitals);sim.drainEvents();}return{sim,ordinaryMin};};\nexport async function run(test){\n await initPhysics();\n await test('\"'clock / all beat-driven systems share one pressure-smoothed clock',()=>{const s={vitals:20,bpm:72,beatPhase:0,beat:0,bar:0};for(let i=0;i<120;i++)stepBeat(s,1/60,defaults,72);assert.ok(s.bpm>110&&s.beat>=3);close(s.pulse,Math.exp(-s.beatPhase*9));s.arrest=true;const before=s.beatPhase;stepBeat(s,2,defaults,72);close(s.beatPhase,before);});\n await test('input / speed, radial deadzone, response curve and steady',()=>{const sim=make();frames(sim,60,{ax:1});close(player(sim).x+.3,defaults.tipSpeed,.02);player(sim).x=0;frames(sim,60,{ax:.1});close(player(sim).x,0);frames(sim,60,{ax:1,steady:true});close(player(sim).x,defaults.tipSpeed*defaults.steadyFactor,.02);});\n await test('input / absolute aim clamps to the physical field',()=>{const sim=make();frames(sim,1,{x:8,y:-8});close(player(sim).x,1.9);close(player(sim).y,-.95);});\n await test('scoring / precise grades, combo cap, misses and composure',()=>{const sim=make();const s=sim.state;s.score=0;gradeAction(s,'FLAWLESS',defaults,player(sim));assert.equal(s.score,315);assert.equal(s.composure,10);gradeAction(s,'ROUGH',defaults,player(sim));assert.equal(s.combo,1);gradeAction(s,'MISS',defaults,player(sim));assert.equal(s.combo,0);assert.equal(s.misses,1);for(let i=0;i<30;i++)gradeAction(s,'CLEAN',defaults,player(sim));assert.equal(s.composure,100);assert.equal(finalRank({score:900},1000),'S');assert.equal(finalRank({score:800},1000,true),'B');});\n await test('scalpel / guide tracing, precision grading and no lost progress',()=>{const sim=make([{kind:'incision',x:-.5,y:0,points:[[-.5,0],[.5,0]]}]);frames(sim,1,{tool:0,x:-.5,y:0,use:1});frames(sim,110,i=>({tool:0,x:-.5+i/109,y:0,use:1}));assert.ok(ent(sim,'incision').done);assert.equal(sim.state.misses,0);assert.ok(sim.state.flawless>0);});\n await test('scalpel / nicks cost vitals and retained cuts resume',()=>{const sim=make([{kind:'incision',x:-.5,y:0,points:[[-.5,0],[.5,0]]}]);frames(sim,1,{tool:0,x:-.5,y:0,use:1});frames(sim,20,i=>({tool:0,x:-.5+i*.01,y:0,use:1}));const progress=ent(sim,'incision').progress;frames(sim,1,{tool:0,x:-.3,y:.2,use:1});assert.ok(sim.state.misses);close(ent(sim,'incision').progress,progress);assert.ok(ent(sim,'pool'));});\n await test('forceps / spring grip, resisted direction, smooth pop and tray trophy',()=>{const sim=make([{kind:'shard',x:0,y:0,axis:0,embed:.2,poolOnRemove:.4}]);frames(sim,1,{tool:1,x:0,y:0,use:1});assert.ok(player(sim).held);assert.equal(sim.physics.joints.size,1);frames(sim,20,i=>({tool:1,x:0,y:.01*i,use:1}));assert.ok(\"'!ent(sim,'\"'shard').embedded);player(sim).x=0;player(sim).y=0;frames(sim,25,i=>({tool:1,x:i*.01,y:0,use:1}));assert.ok(ent(sim,'shard').embedded);frames(sim,40,{tool:1,x:1.62,y:.2,use:1});frames(sim,1,{tool:1,x:1.62,y:.2,use:0});assert.equal(sim.state.tray.length,1);assert.ok(ent(sim,'shard').done);assert.ok(ent(sim,'pool'));assert.equal(sim.physics.joints.size,0);});\n await test('forceps / excessive speed tears and the item remains embedded',()=>{const sim=make([{kind:'shard',x:0,y:0,axis:0,embed:.3}]);frames(sim,1,{tool:1,x:0,y:0,use:1});frames(sim,1,{tool:1,x:.4,y:0,use:1});assert.ok(sim.state.misses);assert.ok(\"'!ent(sim,'\"'shard').embedded);assert.ok(sim.state.vitals<100);});\n await test('forceps / dropping away from the tray loses one vital and can be recovered',()=>{const sim=make([{kind:'piece',x:0,y:0,embed:0}]);frames(sim,1,{tool:1,x:0,y:0,use:1});frames(sim,1,{tool:1,x:0,y:0,use:0});assert.ok(\"'!ent(sim,'\"'piece').done);assert.equal(player(sim).held,null);assert.ok(sim.state.vitals<=99);frames(sim,1,{tool:1,x:0,y:0,use:1});assert.ok(player(sim).held);});\n await test('suction / analog drain rate and overflow consequences',()=>{const sim=make([{kind:'pool',x:0,y:0,vol:1.5}]);frames(sim,30,{tool:2,x:0,y:0,use:.5});close(ent(sim,'pool').vol,1.25,.015);assert.ok(sim.state.vitals<100);frames(sim,100,{tool:2,x:0,y:0,use:1});assert.ok(ent(sim,'pool').done);});\n await test('gel / coverage grid, scratches, spores and sealed nests',()=>{const sim=make([{kind:'gelZone',x:0,y:0,w:.3,h:.2,parTime:8},{kind:'scratch',x:.4,y:0},{kind:'spore',x:.6,y:0},{kind:'nest',x:-.5,y:0}]);frames(sim,3,{tool:3,x:0,y:0,use:1});frames(sim,3,{tool:3,x:.1,y:0,use:1});assert.ok(ent(sim,'gelZone').done);for(const x of [.4,.6,-.5])frames(sim,65,{tool:3,x,y:0,use:1});for(const k of ['scratch','spore','nest'])assert.ok(ent(sim,k).done);});\n await test('suture / ordered gates, visible progress, manual knot',()=>{const gates=[[-.3,.08],[-.1,-.08],[.1,.08],[.3,-.08]],sim=make([{kind:'wound',x:0,y:0,gates}]);frames(sim,1,{tool:4,x:.1,y:.08,use:1});assert.equal(ent(sim,'wound').gate,0);for(const [x,y]of gates)frames(sim,1,{tool:4,x,y,use:1});assert.equal(ent(sim,'wound').gate,4);frames(sim,1,{tool:4,alt:true});assert.ok(ent(sim,'wound').done);});\n await test('suture / tear penalty and automatic tie grade',()=>{const sim=make([{kind:'wound',x:0,y:0,gates:[[0,0],[.1,.1]]}]);frames(sim,1,{tool:4,x:0,y:0,use:1});frames(sim,1,{tool:4,x:.7,y:.5,use:1});assert.equal(sim.state.misses,1);frames(sim,1,{tool:4,x:.1,y:.1,use:1});frames(sim,100,{});assert.ok(ent(sim,'wound').done);});\n await test('laser / analog DPS, bare-tissue grace, burn and forced vent',()=>{const sim=make([{kind:'nodule',x:0,y:0,hp:1000}]);frames(sim,60,{tool:5,x:0,y:0,use:.5});close(ent(sim,'nodule').hp,985,.1);const initial=sim.state.vitals;frames(sim,10,{tool:5,x:.8,y:.4,use:1});assert.ok(initial-sim.state.vitals<.02);frames(sim,40,{tool:5,x:.8,y:.4,use:1});assert.ok(sim.state.vitals<initial-1);frames(sim,310,{tool:5,x:0,y:0,use:1});assert.ok(player(sim).vent>0);});\n await test('scanner / concealed targets are protected until 0.6 second marking',()=>{const sim=make([{kind:'nodule',x:0,y:0,hp:20,hidden:true}]);frames(sim,60,{tool:5,x:0,y:0,use:1});assert.equal(ent(sim,'nodule').hp,20);frames(sim,37,{tool:6,x:0,y:0,use:1});assert.ok(ent(sim,'nodule').marked);frames(sim,45,{tool:5,x:0,y:0,use:1});assert.ok(ent(sim,'nodule').done);});\n await test('clamp / beat grade, capacity and removal interlock',()=>{const sim=make([{kind:'bleeder',x:0,y:0}],{done:{all:true,allClampsOff:true}});sim.state.beatPhase=0;frames(sim,1,{tool:7,x:0,y:0,use:1});assert.ok(ent(sim,'bleeder').clamped);assert.equal(sim.state.clamps,3);assert.ok(\"'!sim.phaseComplete());frames(sim,1,{tool:7,x:0,y:0,alt:true});assert.ok(ent(sim,'\"'bleeder').removed);assert.equal(sim.state.clamps,4);});\n await test('syringe / IV, cooldown and context-sensitive antidote',()=>{const sim=make([{kind:'injection',x:.6,y:0}]);sim.state.vitals=50;frames(sim,31,{x:0,y:0,syringe:true});close(sim.state.vitals,65,.1);assert.ok(player(sim).cooldown>2.9);frames(sim,190,{});frames(sim,50,{x:.6,y:0,syringe:true});assert.ok(ent(sim,'injection').done);});\n await test('defibrillator / weak release loses time; gold release restarts the heart',()=>{const sim=make();sim.arrest(12);frames(sim,30,{charge:1,use:1,steady:true});frames(sim,1,{});assert.ok(sim.state.arrest);assert.ok(sim.state.arrestLeft<10);frames(sim,72,{charge:1,use:1,steady:true});frames(sim,1,{});assert.ok(\"'!sim.state.arrest);assert.equal(sim.state.arrestsSurvived,1);assert.equal(sim.state.vitals,65);});\n await test('\"'gifts / Hush freezes then slows the clock without slowing tools',()=>{const sim=make([{kind:'pool',x:0,y:0,vol:2}]);sim.state.composure=100;frames(sim,1,{special:true});const timer=sim.state.timer;frames(sim,24,{tool:2,x:0,y:0,use:1});assert.ok(timer-sim.state.timer<.02);assert.ok(ent(sim,'pool').vol<1.65);frames(sim,60,{});assert.ok(timer-sim.state.timer<.3);});\n await test('gifts / Sforzando stuns, damages and accelerates tools',()=>{const sim=make([{kind:'adagio',x:0,y:0,hp:100}]);sim.state.doctor='ines';sim.state.composure=100;frames(sim,1,{special:true});close(ent(sim,'adagio').hp,75);assert.ok(ent(sim,'adagio').stunned>2.9);frames(sim,30,{tool:5,x:0,y:0,use:1});assert.ok(ent(sim,'adagio').hp<50);});\n await test('checkpoints / phase retry restores a viable patient and honest assist cap',()=>{const sim=new Sim({op:1});owned.push(sim);sim.skipTo(3);sim.state.vitals=1;sim.state.timer=2;sim.state.score=20;sim.fail();sim.retry(true);assert.equal(sim.state.status,'playing');assert.ok(sim.state.vitals>=60);assert.ok(sim.state.timer>=90);assert.equal(sim.state.score,sim.checkpoint.score);assert.ok(sim.state.notes);sim.state.score=100000;sim.win();assert.equal(sim.state.rank,'B');});\n await test('failure / flatline, timer and malpractice are separate causes',()=>{for(const [field,value,reason]of [['vitals',0,'FLATLINE'],['timer',0,'TIME'],['misses',8,'MALPRACTICE']]){const sim=make();sim.state[field]=value;sim.step();assert.equal(sim.state.reason,reason);}});\n await test('difficulty / drain, time, tolerance and HP scale together',()=>{const a=new Sim({op:2,level:'easy'}),b=new Sim({op:2,level:'hard'});owned.push(a,b);assert.ok(a.state.timer>b.state.timer);a.damage(10);b.damage(10);assert.ok(a.state.vitals>b.state.vitals);a.skipTo(2);b.skipTo(2);assert.ok(ent(a,'adagio').hp<ent(b,'adagio').hp);});\n await test('Adagio / core multiplier, stun and five-second recovery',()=>{const sim=make([{kind:'adagio',x:0,y:0,hp:100}]);sim.state.beat=2;frames(sim,25,i=>({tool:5,x:ent(sim,'adagio').x,y:ent(sim,'adagio').y,use:1}));assert.ok(ent(sim,'adagio').hp<70);ent(sim,'adagio').hp=0;ent(sim,'adagio').stunned=.1;frames(sim,8,{});assert.equal(ent(sim,'adagio').hp,40);});\n await test('Staccato / off-beat nest notes burst and spores persist',()=>{const sim=make([{kind:'nest',x:0,y:0},{kind:'note',x:.6,y:0,hp:8,ttl:.5}]);frames(sim,40,{});assert.ok(ent(sim,'spore'));frames(sim,60,{});assert.ok(sim.state.entities.some(e=>e.kind==='note'&&\"'!e.done));});\n await test('\"'Tremolo / quick approaches flee; slow scanner pins',()=>{const sim=make([{kind:'tremolo',x:0,y:0,hp:40,pinsRequired:3}]);frames(sim,1,{x:-.1,y:0});assert.ok(ent(sim,'tremolo').x>0);assert.ok(sim.state.vitals<100);const e=ent(sim,'tremolo');frames(sim,65,{tool:6,x:e.x,y:e.y,use:1,steady:true});assert.ok(e.pinned>0);assert.equal(e.pins,1);});\n await test('Legato / tail-first severing, wrong-link damage, eight-beat reattachment',()=>{const sim=make([{kind:'legato',x:0,y:0,links:4}]);const chain=ent(sim,'legato');const n=chain.nodes.at(-1);frames(sim,1,{tool:0,x:n.x-.05,y:n.y,use:0});frames(sim,1,{tool:0,x:n.x+.01,y:n.y,use:1});assert.ok(n.cut);assert.ok(ent(sim,'piece'));sim.state.beat=n.cutBeat+9;sim.strainBeat();assert.ok(\"'!n.cut);});\n await test('\"'Crescendo / feeder dependency and Fortissimo',()=>{const sim=make([{kind:'crescendo',x:0,y:0,size:.99,embed:.3}]);assert.equal(sim.state.entities.filter(e=>e.kind==='feeder').length,4);frames(sim,30,{});assert.ok(sim.state.entities.filter(e=>e.kind==='bleeder').length>=2);assert.ok(ent(sim,'crescendo').size<.9);for(const e of sim.state.entities.filter(e=>e.kind==='feeder'))e.done=true;frames(sim,1,{});assert.ok(ent(sim,'crescendo').exposed);});\n await test('Fermata / the eye must be destroyed before a strong shock works',()=>{const sim=make([{kind:'fermata',x:0,y:0,hp:60}]);sim.arrest(12);player(sim).charge=1.2;sim.shock(player(sim));assert.ok(sim.state.arrest);frames(sim,122,{tool:5,x:0,y:0,use:1});player(sim).charge=1.2;sim.shock(player(sim));assert.ok(\"'!sim.state.arrest);});\n await test('\"'Coda / severed arms stop downbeats; health thresholds change sites',()=>{const sim=make([{kind:'coda',x:0,y:0,hp:300,arms:2,embed:.6}]);const e=ent(sim,'coda');sim.state.beat=4;const before=sim.state.vitals;sim.strainBeat();assert.ok(sim.state.vitals<before);e.arms=0;const after=sim.state.vitals;sim.strainBeat();close(sim.state.vitals,after);e.hp=190;sim.updateEntities(1/60,1/60);assert.equal(e.site,1);e.hp=90;sim.updateEntities(1/60,1/60);assert.equal(e.site,2);});\n await test('snapshots / delta fits MTU; reliable topology round-trip',()=>{const sim=new Sim({op:8,players:Array.from({length:4},(_,id)=>({id,name:'Doctor '+id,color:'#f5b700'}))});owned.push(sim);sim.skipTo(2);const delta=snapshot(sim.state),full=keyframe(sim.state);assert.ok(JSON.stringify(delta).length<1100);assert.ok(JSON.stringify(full).length<16000);const decoded=applySnapshot(null,full);assert.equal(decoded.entities.length,sim.state.entities.length);assert.equal(decoded.seats.length,4);assert.equal(decoded.objective,sim.state.objective);assert.equal(applySnapshot(decoded,{...delta,n:decoded.tick-1}),decoded);});\n await test('determinism / same seed plus input gives identical simulation and Rapier positions',()=>{const a=new Sim({op:0,seed:934}),b=new Sim({op:0,seed:934});owned.push(a,b);a.skipTo(1);b.skipTo(1);for(let i=0;i<1200;i++){const f={ax:Math.sin(i*.03)*.2,ay:Math.cos(i*.02)*.2,tool:2};a.input(0,f);b.input(0,f);a.step();b.step();}assert.equal(a.hash(),b.hash());assert.deepEqual(a.physics.positions(),b.physics.positions());});\n await test('data / valid tools, entity kinds, speakers and in-drape targets',()=>{const coverage=new Set();for(const op of operations){for(const t of op.teaches)coverage.add(t);for(const p of op.phases){assert.ok(typeof p.objective==='string');assert.ok(p.spawn);for(const t of p.tools)assert.ok([...tools,'hush','sforzando','defib','syringe'].includes(t));for(const e of p.spawn){assert.ok(kinds.includes(e.kind),e.kind);assert.ok(inDrape(e.x,e.y),\"'`${op.id}/${p.id}: ${e.x}, ${e.y}`);for(const pt of [...(e.points||[]),...(e.gates||[])])assert.ok(inDrape(...pt));}}}for(const t of [...tools,'\"'syringe','defib','hush','sforzando','adagio','staccato','tremolo','legato','crescendo','fermata','coda'])assert.ok(coverage.has(t),t);for(const [id,scene] of Object.entries(story)){assert.ok(scene.lines.length<=30);for(const l of scene.lines){assert.ok(cast[l.who]);if(l.who==='bea'&&id\"'!=='\"'S16')assert.ok(\"'!/'\"\\\\bgood\\\\b/i.test(l.text));}}assert.ok(Object.values(story).reduce((n,s)=>n+s.lines.length,0)>=250);assert.ok(Object.values(barks).flat().length>=60);for(const l of Object.values(barks).flat())assert.ok(\"'!/'\"\\\\bgood\\\\b/i.test(l));});\n const results=[];\n for(let op=0;op<operations.length;op++)await test(\"'`campaign / normal bot completes ${operations[op].title}`,()=>{const {sim,ordinaryMin}=play(op);owned.push(sim);assert.equal(sim.state.status,'\"'won',\"'`${sim.state.reason} phase ${sim.state.phase} at ${sim.state.elapsed}`);if(op!==7){assert.ok(['\"'S','A'].includes(sim.state.rank),\"'`rank ${sim.state.rank}`);assert.ok(ordinaryMin>=35,`minimum ${ordinaryMin}`);assert.ok(sim.state.elapsed<sim.state.timerStart*.75,`slow ${sim.state.elapsed}`);}results.push({op,seconds:sim.state.elapsed,timer:sim.state.timerStart,score:sim.state.score,rank:sim.state.rank,min:ordinaryMin});});\n for(let op=0;op<7;op++)await test(`assist / imprecise bot completes ${operations[op].title} on Intern`,()=>{const {sim}=play(op,{level:'\"'easy',bot:{noise:.03,reactionDelay:.25}});owned.push(sim);assert.equal(sim.state.status,'won',\"'`${sim.state.reason} in phase ${sim.state.phase}`);assert.ok('\"'SABC'.includes(sim.state.rank));});\n for(let op=0;op<operations.length;op++)if(op\"'!==7)await test(`idle / no-input ${operations[op].title} fails honestly`,()=>{const sim=new Sim({op});owned.push(sim);frames(sim,70000);assert.equal(sim.state.status,'\"'failed');});\n for(let n=2;n<=4;n++)await test(\"'`co-op / ${n} surgeons independently contribute and complete Grand Rounds`,()=>{const players=Array.from({length:n},(_,id)=>({id,name:'\"'Doctor '+id,color:'#f2b134'})),{sim}=play(8,{players});owned.push(sim);assert.equal(sim.state.status,'won',\"'`${sim.state.reason} phase ${sim.state.phase}`);assert.ok(sim.state.seats.every(s=>s.score>0));});\n for(const sim of owned)sim.free();\n return results;\n}\nEOF\ncat > tests/run-all.mjs <<'\"'EOF'\nimport {writeFileSync,mkdirSync} from 'node:fs';\nlet passed=0,failed=0;const failures=[];const start=Date.now();\nconst warn=console.warn;console.warn=(...args)=>{if(\"'!String(args[0]).startsWith('\"'using deprecated parameters'))warn(...args);};\nasync function test(name,fn){try{await fn();passed++;}catch(e){failed++;const message=\"'`FAIL ${name}: ${e?.stack||e}`;failures.push(message);console.error(message);}}\nconst suite=process.argv[2];const results={};\nfor(const name of ['\"'sim','browser','hub'])if(\"'!suite||suite===name){try{const mod=await import(`./${name}/suite.mjs`);results[name]=await mod.run(test);}catch(e){await test(`${name} suite setup`,()=>{throw e;});}}\nmkdirSync('\"'artifacts',{recursive:true});writeFileSync(\"'`artifacts/test-results-${suite||'\"'all'}.json\"'`,JSON.stringify({passed,failed,seconds:(Date.now()-start)/1000,failures,results},null,2));\nconsole.log(`${passed} passed, ${failed} failed (${((Date.now()-start)/1000).toFixed(1)}s)`);process.exitCode=failed?1:0;\nEOF\nnode tests/run-all.mjs sim'","aggregated_output":"FAIL scalpel / guide tracing, precision grading and no lost progress: AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:\n\n1 !== 0\n\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/sim/suite.mjs:27:288\n    at test (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/run-all.mjs:4:40)\n    at Module.run (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/sim/suite.mjs:27:8)\n    at async file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-Encore-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-051847/tests/run-all.mjs:6:132\nFAIL forceps / spring grip, resisted direction, smooth pop and tray trophy: AssertionError [ERR_ASSERTION]: The expression evaluated to a falsy value:\n\n  assert.ok(ent(sim,'shard').embedded)\n\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-051847__x8f49b6/work/Trauma-Tempo-