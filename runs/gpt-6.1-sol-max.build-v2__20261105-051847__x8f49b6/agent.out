{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/sim/bot.js');s=p.read_text().replace('cheat=false}={})','cheat=false,pace:givenPace}={})').replace('const base={x:seat.x',\\\"const pace=givenPace??[.55,.4,.9,.45,.78,.28,.32,1,1][s.op];\\\\n const base={x:seat.x\\\")\ns=s.replace('step=speed*dt','step=(tool===0&&use?Math.max(.55,speed*pace):speed*pace)*dt').replace('if((s.vitals<48','if((s.vitals<58')\ns=s.replace(\\\"let req=all.filter(e=>e.required&&e.kind\"'!=='\"'bleeder');\\\", \\\"let req=all.filter(e=>e.required&&e.kind\"'!=='\"'bleeder');if(s.op===8){const urgent=req.find(e=>e.kind==='crescendo');if(urgent)req=[urgent,...req.filter(e=>e\"'!==urgent)];}\")\np.write_text(s)\np=Path('\"'src/sim/sim.js');s=p.read_text().replace(\\\"s.entities.filter(q=>['note','spore'].includes(q.kind)&&\"'!q.done).length<3\", \"s.entities.filter(q=>['\"'note','spore'].includes(q.kind)&&\"'!q.done).length<3\")\n# Apply limited help only on pad/keyboard while tracing.\ns=s.replace(\"seat.x=clamp(seat.x,-1.55,1.9);\", \"if(!Number.isFinite(f.x)&&seat.use>0&&[0,4].includes(seat.tool)){let nearest=null,best=.12;for(const e of s.entities.filter(e=>!e.done&&e.site===seat.site)){const p=e.kind==='\"'wound'?e.gates[e.gate]:null;const q=p?{x:p[0],y:p[1]}:e.kind==='incision'?project(seat.x,seat.y,e.points):null;if(q){const d=Math.hypot(seat.x-q.x,seat.y-q.y);if(d<best){nearest=q;best=d;}}}if(nearest){seat.x+=(nearest.x-seat.x)*t.aimAssist*dt*12;seat.y+=(nearest.y-seat.y)*t.aimAssist*dt*12;}}\\\\n seat.x=clamp(seat.x,-1.55,1.9);\\\")\n# Preserve the biological clock throughout an arrest: no hazards drain the held vital sign.\ns=s.replace(\\\"if(this.cheats.god||this.op.unfailing||this.state.lockFail)return\\\", \\\"if(this.cheats.god||this.op.unfailing||this.state.lockFail||this.state.arrest)return\\\")\n# Cosmetic phase winding: idle still loses to the timer.\ns=s.replace(\\\"if(e.kind==='scratch')this.damage(.5*wd);\\\", \\\"if(e.kind==='nest'){e.spawnClock=(e.spawnClock||0)+wd*this.tuning.spawnRateMult;if(e.spawnClock>60/s.bpm*1.5&&s.entities.filter(n=>n.kind==='note'&&\"'!n.done).length<3){e.spawnClock=0;this.spawn({kind:'\"'note',x:clamp(e.x+.12,-1,1),y:clamp(e.y+.1,-.5,.5),site:e.site,hp:8,ttl:60/s.bpm*2},false);}}\\\\n if(e.kind==='scratch')this.damage(.5*wd);\\\")\np.write_text(s)\nPY\nnode tests/sim/diagnose.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
