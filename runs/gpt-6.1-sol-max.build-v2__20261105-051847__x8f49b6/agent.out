this.music.connect(this.filter).connect(this.master);this.sfx.connect(this.master);this.voice.connect(this.master);this.apply(settings);}catch{this.ctx=null;}}\n apply(s){this.settings={music:.1,sfx:.8,voice:.8,...this.settings,...s};if(this.ctx){this.music.gain.value=this.settings.music;this.sfx.gain.value=this.settings.sfx;this.voice.gain.value=this.settings.voice;}}\n unlock(){if(this.ctx?.state==='suspended')this.ctx.resume().catch(()=>{});}\n get musicGain(){return this.music?.gain.value??.1;}\n setTrack(t){if(this.track\"'!==t){this.track=t;this.step=0;this.next=0;}}\n update(s){if(!this.ctx||this.ctx.state!=='\"'running'||\"'!this.running)return;const now=this.ctx.currentTime;if(s?.arrest){this.music.gain.setTargetAtTime(0,now,.03);if(this.lastFlatline!==Math.floor(now)){this.lastFlatline=Math.floor(now);synthSfx(this.ctx,this.sfx,'\"'flatline',now,.15);}return;}this.music.gain.setTargetAtTime(this.settings.music,now,.15);this.filter.frequency.setTargetAtTime(s?.hush?300:18000,now,.15);const bpm=s?.bpm||64,seconds=60/bpm;\n if(s){if(s.beat\"'!==this.lastBeat){this.lastBeat=s.beat;this.next=now+.015;this.step=s.beat;musicStep(this.ctx,this.music,this.track,this.step,this.next,seconds,s.phase+1);synthSfx(this.ctx,this.sfx,'\"'beat',this.next,.25);if(s.vitals<=30)synthSfx(this.ctx,this.sfx,'ecg',this.next,.3);}}\n else{if(\"'!this.next||this.next<now-.3)this.next=now;while(this.next<now+.12){musicStep(this.ctx,this.music,this.track,this.step++,this.next,seconds);synthSfx(this.ctx,this.sfx,'\"'beat',this.next,.18);this.next+=seconds;}}}\n effect(name,power=1){if(this.ctx?.state==='running'&&this.running)synthSfx(this.ctx,this.sfx,name,this.ctx.currentTime,power);}\n say(text,who){if(this.ctx?.state==='running'&&this.running)voiceLine(this.ctx,this.voice,text,who,this.ctx.currentTime+.01);}\n stop(){this.running=false;this.ctx?.suspend().catch(()=>{});}\n}\nEOF\ncat > src/input/glyphs.js <<'EOF'\nconst key={confirm:'Enter',back:'Esc',use:'LMB',steady:'Shift',alt:'