f(dist(seat,p)>.15)return go(p.x-.1,p.y-.1,0,0);return go(p.x+.12,p.y+.12,0,1,1.2,{use:1});}}\n if(e.kind==='legato'){const piece=all.find(q=>q.chain===e.id);if(piece)return go(piece.x,piece.y,1,1);const n=e.nodes[e.remaining];if(\"'!n)return base;if(n.cut)return base;const p={x:n.x-.09,y:n.y};if(dist(seat,n)>.15)return go(p.x,p.y,0,0);return go(n.x+.09,n.y,0,1,.9,{use:1});}\n if(e.kind==='\"'crescendo'&&\"'!e.exposed){const f=all.find(q=>q.parent===e.id);if(f)return go(f.x,f.y,5,1);return base;}\n if(e.kind==='\"'coda'&&e.arms>0){const x=e.x+(e.arms===2?-.5:.5),y=e.y+.15;if(Math.hypot(seat.x-x,seat.y-y)>.15)return go(x-.1,y,0,0);return go(x+.1,y,0,1,1,{use:1});}\n if(e.hp>0){if(seat.laserTime>5.75)return base;return go(e.x,e.y,5,1);}\n if(['shard','tumor','piece','adagio','crescendo','fermata','coda'].includes(e.kind))return go(e.x,e.y,1,1);\n if(e.kind==='note')return go(e.x,e.y,1,1);\n return base;\n}\nEOF\ncat > src/sim/snapshot.js <<'EOF'\n// Compact deltas fit a single unreliable packet. Keyframes restore full topology.\nexport function snapshot(state){return{t:'s',n:state.tick,p:state.phase,v:+state.vitals.toFixed(1),r:+state.timer.toFixed(1),b:state.beat,q:+state.beatPhase.toFixed(2),m:Math.round(state.bpm),s:state.site,c:state.composure,z:state.score,a:state.arrest?+state.arrestLeft.toFixed(1):0,tip:state.seats.map(s=>[s.id,+s.x.toFixed(3),+s.y.toFixed(3),s.tool,s.site,s.use,s.held||0]),e:state.entities.filter(e=>\"'!e.done&&['\"'adagio','tremolo','coda','crescendo'].includes(e.kind)).slice(0,12).map(e=>[e.id,+e.x.toFixed(2),+e.y.toFixed(2),Math.round(e.hp||0),+(e.progress||0).toFixed(2)])};}\nexport function keyframe(state){const s=structuredClone(state);for(const e of s.entities){if(e.cells){e.covered=e.cells.filter(c=>c[2]).length;e.cells=[];}delete e.deviations;}return{t:'k',n:s.tick,state:s};}\nexport function applySnapshot(current,data){if(data.n<=(current?.tick??-1))return current;if(data.t==='k')return data.state;if(data.t\"'!=='\"'s'||\"'!current)r