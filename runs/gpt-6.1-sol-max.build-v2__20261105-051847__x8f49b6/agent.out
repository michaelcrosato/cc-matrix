www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' d='M0 0h100v100H0z'/%3E%3C/svg%3E\\\")}.toast{position:absolute;left:50%;bottom:29vh;transform:translateX(-50%);font-size:2.2rem;padding:.7rem 1.2rem;background:var(--ink);border:.12rem solid var(--gold);color:var(--gold);text-align:center;animation:ink-in .2s;max-width:80%}.safe-button{min-width:3rem;min-height:3rem}.no-graphics{background:linear-gradient(120deg,#0b2529,#153f49);display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:2rem}.no-graphics p{max-width:60rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@keyframes ink-in{from{opacity:0;clip-path:polygon(0 0,0 0,0 100%,0 100%)}to{opacity:1;clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}}@keyframes heartbeat{0%,18%,38%,100%{opacity:1}9%,28%{opacity:.35}}@keyframes grade-pop{0%{opacity:0;scale:2.2}12%,65%{opacity:1;scale:1}100%{opacity:0;translate:0 -2rem;scale:.9}}@keyframes stamp-in{0%{opacity:0;scale:3}55%{opacity:1;scale:.85}75%,100%{opacity:1;scale:1}}@keyframes blink{0%,100%{opacity:1}50%{opacity:.45}}@keyframes hint-pulse{50%{box-shadow:0 0 0 .5rem #f2b13455}}@keyframes danger{50%{opacity:.4}}\n@media(min-aspect-ratio:21/9){.title-content{width:43%}.menu-panel{width:28%}.hud-top{grid-template-columns:1fr 1fr 1fr}.bark-area{left:26vw;right:28vw}.tool-dock{left:8vw}.gifts{right:8vw}.chart{width:48%}.objective-card{max-width:32rem}}\n@media(max-aspect-ratio:4/3){.title-content{width:73%;top:25vh}.title-logo{font-size:8.5rem}.title-index{top:18vh;right:5vw}.menu-panel{width:57%;max-width:44rem}.modal{inset:8vh 8vw}.modal.narrow{inset:10vh 20vw}.chart{width:76%;max-width:none}.free-grid{grid-template-columns:repeat(2,1fr);gap:1rem}.patient-card{min-height:10rem}.hud-top{grid-template-columns:1fr .95fr .