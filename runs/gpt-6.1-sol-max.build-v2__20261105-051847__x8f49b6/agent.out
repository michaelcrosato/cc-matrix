{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' src/view/renderer.js\"","aggregated_output":"import * as T from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createInk} from './ink.js';\nimport {makeField} from './field.js';\nimport {mesh,box,ball,tube,ring,flatLabel,toon} from './materials.js';\nimport {createBust} from './bust.js';\nimport {createInstrument,makePaddles} from './instruments.js';\nimport {entityModel} from './entities.js';\nimport {operations} from '../data/ops/index.js';\nimport {cast} from '../data/cast.js';\nfunction makeRoom(scene){const room=new T.Group();scene.add(room);box(room,'#102d34',0,-.8,0,12,.15,12);box(room,'#1d4c52',0,2,-3.2,12,6,.2);\n for(let x=-5.5;x<=5.5;x+=.55)for(let y=-.5;y<4.6;y+=.55){box(room,(Math.round((x+5.5)/.55)+Math.round(y/.55))%4===0?'#245359':'#21494e',x,y,-3.07,.53,.53,.025);}\n for(const x of [-4.4,4.4]){box(room,'#15333e',x,1.1,-2.95,2.1,2.6,.1);box(room,'#102332',x,1.1,-2.85,1.95,2.4,.03);for(let i=0;i<9;i++)box(room,'#215461',x-.87+i*.22,1.05,-2.81,.012,2.3,.02);box(room,'#486f70',x,1.1,-2.79,2,.035,.02);}\n flatLabel(room,'ST. ALDER MEMORIAL',0,3.35,-2.93,4,.55,'#acc2ba');flatLabel(room,'OPERATING THEATRE  /  03',0,2.85,-2.91,3.5,.4,'#f2b134');\n const table=new T.Group();room.add(table);box(table,'#102f36',0,-.38,0,3.5,.3,2.15);box(table,'#5f8d8d',0,-.61,0,.7,.4,1.1);for(const x of [-1.45,1.45])box(table,'#9cbdba',x,-.25,0,.05,.07,2.2);\n const lamp=new T.Group();lamp.name='Lamp';lamp.position.set(1.5,1.55,-.6);room.add(lamp);tube(lamp,'#9ebdb7',[[0,.08,0],[0,.7,0],[1.6,.7,0],[1.6,1.6,0]],.055);const shade=mesh(new T.CylinderGeometry(.55,.65,.15,12),'#90b8ae',lamp);shade.rotation.x=.15;const lightmat=new T.MeshBasicNodeMaterial({color:'#f8ecc5'});const disc=mesh(new T.CylinderGeometry(.56,.56,.025,32),lightmat,lamp,0,-.09,0);for(let i=0;i<6;i++){const a=i/6*Math.PI*2;ball(lamp,'#fff4d5',Math.cos(a)*.34,-.12,Math.sin(a)*.34,.13,.018,.13);}ring(lamp,'#153b43',0,-.12,0,.62,.025).rotation.x=-Math.PI/2;\n const mixer=new T.AnimationMixer(room);const action=mixer.clipAction(new T.AnimationClip('lamp swing',8,[new T.NumberKeyframeTrack('Lamp.rotation[z]',[0,2,4,6,8],[.025,0,-.025,0,.025])]));action.play();\n for(const x of [-2.5,2.8]){const monitor=new T.Group();monitor.position.set(x,.45,-1.6);room.add(monitor);box(monitor,'#0d202a',0,0,0,.88,.63,.19);box(monitor,'#b9c4ae',0,-.37,.01,.9,.07,.24);box(monitor,'#071923',0,0,.11,.73,.48,.025);tube(monitor,'#6de1c3',[[-.33,-.02,.14],[-.17,-.02,.14],[-.1,.02,.14],[-.05,-.17,.14],[.01,.19,.14],[.06,-.03,.14],[.33,-.02,.14]],.008);for(let i=0;i<3;i++)ball(monitor,i?'#567c73':'#f2b134',.33,-.2+i*.07,.13,.015);tube(monitor,'#829e95',[[0,-.4,0],[0,-1.12,0],[.3,-1.15,0]],.03);}\n return {root:room,lamp,mixer};}\nexport async function createView(container,{forceWebGL=false,noRender=false,onError=()=>{}}={}){\n const renderer=new T.WebGPURenderer({antialias:false,forceWebGL});renderer.setPixelRatio(Math.min(devicePixelRatio,1.6));renderer.toneMapping=T.NoToneMapping;renderer.shadowMap.enabled=true;renderer.shadowMap.type=T.PCFSoftShadowMap;renderer.onDeviceLost=onError;await renderer.init();\n renderer.domElement.id='world';renderer.domElement.setAttribute('aria-label','Three-dimensional operating theatre');container.prepend(renderer.domElement);\n const scene=new T.Scene();scene.background=new T.Color('#0b2529');scene.fog=new T.Fog('#0b2529',9,24);\n const camera=new T.PerspectiveCamera(34,innerWidth/innerHeight,.1,60);scene.add(camera);\n const ambient=new T.HemisphereLight(0xffffff,0x819ba0,1.5);scene.add(ambient);const light=new T.DirectionalLight(0xfff2de,1.9);light.position.set(2.5,5,2);light.castShadow=true;light.shadow.mapSize.set(2048,2048);light.shadow.bias=-.0006;light.shadow.normalBias=.03;light.shadow.camera.left=-4;light.shadow.camera.right=4;light.shadow.camera.top=4;light.shadow.camera.bottom=-4;scene.add(light);\n const room=makeRoom(scene),field=makeField();scene.add(field.root);\n const entities=new T.Group(),tips=new T.Group(),storyRoot=new T.Group(),effects=new T.Group();scene.add(entities,tips,storyRoot,effects);\n const entityMap=new Map(),tipMap=new Map(),mixers=[];let currentSite='',mode='title',busts=[],speaker='bea',talkUntil=0,portraitTalkUntil=0,state=null,elapsed=0,flash=0,speed=0,hush=0,shake=0,lastPaint=0;\n const ink=createInk(renderer,scene,camera);\n const portraitScene=new T.Scene();portraitScene.background=new T.Color('#163f49');portraitScene.add(new T.HemisphereLight(0xffffff,0x6f8f96,2));const pl=new T.DirectionalLight(0xffe5c7,2);pl.position.set(2,3,4);portraitScene.add(pl);const portraitCam=new T.PerspectiveCamera(30,1,.1,20);portraitCam.position.set(0,-.2,5);portraitCam.lookAt(0,-.1,0);const portraitTarget=new T.RenderTarget(256,256);let portraitBust=createBust('bea');portraitScene.add(portraitBust.root);\n const pg=new T.PlaneGeometry(.18,.18);const uvs=pg.attributes.uv;for(let i=0;i<uvs.count;i++)uvs.setY(i,1-uvs.getY(i));const portrait=mesh(pg,new T.MeshBasicNodeMaterial({map:portraitTarget.texture,depthTest:false,depthWrite:false}),camera,0,-.43,-2);portrait.renderOrder=10;portrait.visible=false;\n const paddles=makePaddles();scene.add(paddles);paddles.visible=false;\n const stamps=new T.Group();scene.add(stamps);const clipboard=box(stamps,'#bf9c6c',0,.1,0,1.25,.06,1.65);const paper=box(stamps,'#f4f1e8',0,.14,0,1.12,.012,1.45);box(stamps,'#8baea9',0,.17,-.65,.45,.08,.12);const stamp=box(stamps,'#8d3a49',0,.9,0,.34,.18,.22);stamp.name='RankStamp';const stampMixer=new T.AnimationMixer(stamps);const stampAction=stampMixer.clipAction(new T.AnimationClip('stamp',.65,[new T.NumberKeyframeTrack('RankStamp.position[y]',[0,.24,.32,.43,.65],[1.2,1.2,.24,.3,.24])]));stampAction.setLoop(T.LoopOnce);stampAction.clampWhenFinished=true;stamps.visible=false;\n // A small view-only physics world supplies drops, sparks and thread follow-through.\n const cosmeticWorld=new RAPIER.World({x:0,y:-3.4,z:0});cosmeticWorld.timestep=1/60;const floor=cosmeticWorld.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0,-.06,0));cosmeticWorld.createCollider(RAPIER.ColliderDesc.cuboid(5,.03,5),floor);\n const particleMesh=new T.InstancedMesh(new T.SphereGeometry(.012,6,4),toon('#ffffff'),140);effects.add(particleMesh);const particles=[];const dummy=new T.Object3D();particleMesh.count=0;\n function burst(x,y,color,count=8){for(let i=0;i<count&&particles.length<140;i++){const b=cosmeticWorld.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,.35,-y).setLinvel(Math.cos(i*2.4)*.35,.2+i%3*.14,Math.sin(i*2.4)*.3));particles.push({b,life:.6+i*.02,color:new T.Color(color)});}}\n function resize(){const w=innerWidth,h=innerHeight;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();const portraitX=w/h>1.4?-.53:-.18;portrait.position.set(portraitX,-.44,-2);}\n addEventListener('resize',resize);resize();\n const ray=new T.Raycaster(),mouse=new T.Vector2();\n function project(x,y,z){const v=new T.Vector3(x,z??field.height(x,y)+.05,-y).project(camera);return{x:(v.x+1)/2*innerWidth,y:(1-v.y)/2*innerHeight,visible:v.z<1};}\n function screenToField(x,y){mouse.set(x/innerWidth*2-1,1-y/innerHeight*2);ray.setFromCamera(mouse,camera);const p=new T.Vector3();let height=.2;for(let i=0;i<4;i++){ray.ray.intersectPlane(new T.Plane(new T.Vector3(0,1,0),-height),p);height=p.x>1.36?.45:field.height(p.x,-p.z);}return{x:p.x,y:-p.z};}\n function setSpeaker(id){if(id===speaker)return;speaker=id;portraitScene.remove(portraitBust.root);portraitBust.dispose();portraitBust=createBust(id);portraitScene.add(portraitBust.root);}\n function stage(data,line){mode='story';for(const b of busts)storyRoot.remove(b.root);busts=[];const ids=[...new Set(data.lines.map(l=>l.who))].slice(0,2);if(!ids.includes(line.who))ids[1]=line.who;ids.forEach((id,i)=>{const b=createBust(id);b.root.position.set((i?1:-1)*1.62,.65,.1);b.root.scale.setScalar(.67);b.root.rotation.y=(i?-.15:.15);storyRoot.add(b.root);busts.push(b);});if(data.set==='ward')scene.background.set('#15352f');else if(data.set==='lab')scene.background.set('#12303f');else scene.background.set('#0b2529');speak(line);}\n function chart(patient){mode='chart';for(const b of busts)storyRoot.remove(b.root);const b=createBust('patient',{...patient.bust,name:patient.name,coat:'#6ba0a0',hair:'#383944',eyes:'#4f6473',age:patient.age});b.root.position.set(2,.6,0);b.root.scale.setScalar(.7);storyRoot.add(b.root);busts=[b];}\n function speak(line){talkUntil=elapsed+Math.min(4.5,line.text.length*.045);for(const b of busts){const active=b.spec.name===cast[line.who]?.name;b.expression(active?line.expression||'neutral':'neutral');if(active)b.animate(line.shout?'shock':'nod');}if(line.shout){speed=1;shake=.07;}}\n function event(e){if(e.type==='bark')portraitTalkUntil=elapsed+Math.min(4,(e.text||'').length*.06);if(e.type==='grade'){burst(e.x,e.y,e.grade==='MISS'?'#e8443a':'#f2b134',5);if(e.grade==='FLAWLESS')shake=.012;}if(e.type==='pop'||e.type==='deposit'){burst(e.x||1.6,e.y||.2,'#b8e5dc',8);}if(e.type==='hush'){hush=1;speed=1;}if(e.type==='sforzando'){flash=.45;speed=1;shake=.07;}if(e.type==='defib'){flash=1;shake=.09;speed=1;}if(e.type==='fortissimo'){speed=1;shake=.08;}if(['nick','scorch'].includes(e.type)&&elapsed-lastPaint>.06){field.paint(e.type,e.x,e.y);lastPaint=elapsed;}}\n function setMode(m){if(mode===m)return;mode=m;if(m==='report'){stampAction.reset().play();flash=.2;}}\n function update(s,dt,settings={}){state=s;elapsed+=dt;const operation=mode==='operation'||mode==='attract';field.root.visible=mode!=='story'&&mode!=='report';entities.visible=operation;tips.visible=operation;storyRoot.visible=mode==='story'||mode==='chart';stamps.visible=mode==='report';room.root.visible=true;portrait.visible=operation&&innerWidth/innerHeight>1.25&&s?.op!==7;\n if(operation&&s){const op=operations[s.op]||operations[0],site=op.sites[s.site]?.organ||'heart';if(site!==currentSite){currentSite=site;field.reset(site);entityMap.forEach(v=>entities.remove(v.root));entityMap.clear();}field.update(s);\n for(const e of s.entities){let m=entityMap.get(e.id);if(!m){m=entityModel(e);entityMap.set(e.id,m);entities.add(m.root);}m.root.visible=e.site===s.site&&(!e.done||e.kind==='bleeder'&&e.clamped||e.kind==='wound'&&e.done)&&(!e.hidden||e.marked||e.scanned);m.root.position.set(e.x,field.height(e.x,e.y)+.015,-e.y);if(e.done&&e.kind==='wound')m.root.scale.setScalar(.99);m.update?.(dt,s);}\n for(const [id,m] of entityMap)if(!s.entities.some(e=>e.id===id)){entities.remove(m.root);entityMap.delete(id);}\n for(const seat of s.seats){let tip=tipMap.get(seat.id);if(!tip){const root=new T.Group(),r=ring(root,seat.color||'#f2b134',0,.02,0,.075,.006);r.rotation.x=-Math.PI/2;const dot=ball(root,'#fff5d5',0,.02,0,.012,.006,.012);tips.add(root);tip={root,ring:r,tool:-1,model:null};tipMap.set(seat.id,tip);}tip.root.visible=seat.site===s.site;tip.root.position.set(seat.x,field.height(seat.x,seat.y)+.045,-seat.y);if(tip.tool!==seat.tool){if(tip.model)tip.root.remove(tip.model.root);tip.model=createInstrument(seat.tool);tip.root.add(tip.model.root);tip.tool=seat.tool;}tip.model.update(dt,seat.use);tip.ring.scale.setScalar(seat.use?.8:1);}\n for(const [id,m] of tipMap)if(!s.seats.some(t=>t.id===id)){tips.remove(m.root);tipMap.delete(id);}\n paddles.visible=s.arrest;if(s.arrest)paddles.position.set(0,field.height(0,0)+.02,0);\n setSpeaker(s.op===6?'pip':'bea');portraitBust.expression(s.vitals<30?'wide':'neutral');portraitBust.talk(elapsed<portraitTalkUntil&&Math.sin(elapsed*12)>0?1:0);portraitBust.update(dt);\n for(const trophy of s.tray){const key='tray'+trophy.id;if(!entityMap.has(key)){const m=entityModel({...trophy,kind:trophy.kind==='adagio'?'tumor':trophy.kind,embed:0,cells:[]});m.root.position.set(trophy.x,.47+(s.tray.indexOf(trophy)%4)*.015,-trophy.y);m.root.scale.setScalar(.7);m.root.rotation.y=trophy.id*1.7;entities.add(m.root);entityMap.set(key,m);}}\n ink.u.danger.value=s.vitals<=30?1-s.vitals/40:0;hush=s.hush>0?Math.min(2,(settings.hushDuration||7)-s.hush+dt):Math.max(0,hush-dt*2);ink.u.hushRadius.value=hush;const p=project(s.seats[0]?.x||0,s.seats[0]?.y||0);ink.u.hushCenter.value.set(p.x/innerWidth,p.y/innerHeight);\n }else{paddles.visible=false;ink.u.danger.value=0;ink.u.hushRadius.value=0;}\n let target,look;\n const aspect=innerWidth/innerHeight;\n if(operation){const factor=aspect<16/9?(16/9)/aspect:1;target=new T.Vector3(.1,3.9*factor,1.82*factor);look=new T.Vector3(.05,.1,.06);if(aspect<1)target.y*=.85;}\n else if(mode==='story'||mode==='chart'){target=new T.Vector3(0,.2,8.7);look=new T.Vector3(0,-.1,0);if(aspect<1.3)target.z*=1.3/aspect;}\n else if(mode==='report'){target=new T.Vector3(2,3.5,2.7);look=new T.Vector3(0,0,0);}\n else{target=new T.Vector3(3.2,2.7,4.7);look=new T.Vector3(-.35,.8,-.3);if(aspect<1.2)target.z+=2;}\n if(shake>0&&settings.shake!==false){target.x+=Math.sin(elapsed*83)*shake;target.z+=Math.cos(elapsed*67)*shake;}camera.position.lerp(target,mode==='operation'?.3:.08);camera.lookAt(look);if(s?.pulse&&operation)camera.position.multiplyScalar(1+s.pulse*.001);\n room.mixer.update(dt);stampMixer.update(dt);for(const b of busts){b.update(dt);b.talk(elapsed<talkUntil&&Math.sin(elapsed*15)>0?1:0);}flash=Math.max(0,flash-dt*2);speed=Math.max(0,speed-dt*1.6);shake=Math.max(0,shake-dt*.2);ink.u.flash.value=flash;ink.u.speedLines.value=speed;ink.u.boil.value=settings.lineBoil===false?0:1;ink.u.lineOn.value=settings.ink===false?0:1;ink.u.toneOn.value=settings.halftone===false?0:1;renderer.shadowMap.enabled=settings.shadows!==false;\n if(particles.length){cosmeticWorld.step();for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;if(p.life<=0){cosmeticWorld.removeRigidBody(p.b);particles.splice(i,1);}}particleMesh.count=particles.length;particles.forEach((p,i)=>{const a=p.b.translation();dummy.position.set(a.x,a.y,a.z);dummy.scale.setScalar(Math.min(1,p.life*3));dummy.updateMatrix();particleMesh.setMatrixAt(i,dummy.matrix);particleMesh.setColorAt(i,p.color);});particleMesh.instanceMatrix.needsUpdate=true;if(particleMesh.instanceColor)particleMesh.instanceColor.needsUpdate=true;}\n }\n let drawing=false;\n async function draw(){if(drawing||noRender)return;drawing=true;try{if(portrait.visible){renderer.setRenderTarget(portraitTarget);renderer.render(portraitScene,portraitCam);renderer.setRenderTarget(null);}await ink.post.renderAsync();}catch(e){onError(e);}finally{drawing=false;}}\n return{renderer,backend:renderer.backend.isWebGPUBackend?'webgpu':'webgl2',update,draw,setMode,stage,chart,speak,event,project,screenToField,ink,resize,dispose(){removeEventListener('resize',resize);renderer.dispose();cosmeticWorld.free();}};\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > src/view/stage.js <<'EOF'\nimport * as T from 'three/webgpu';\nimport {box,ball,tube,flatLabel,toon} from './materials.js';\nexport function createStageDecor(scene){const root=new T.Group();scene.add(root);const sets=new Map();let current='or',time=0;\n for(const name of ['corridor','office','ward','lab','roof']){const g=new T.Group();sets.set(name,g);root.add(g);g.visible=false;box(g,name==='ward'?'#274e43':name==='lab'?'#284957':'#173842',0,1,-3.2,12,7,.12);box(g,'#12313a',0,-1.9,0,12,.1,8);\n if(name==='corridor'||name==='office'){for(const x of [-3.7,0,3.7]){box(g,'#536e6d',x,.8,-3.05,2.5,3.4,.05);box(g,'#112d3c',x,.8,-3,2.32,3.22,.04);for(let j=0;j<6;j++)box(g,'#1a3e4a',x-.95+j*.38,.8,-2.96,.022,3.2,.02);box(g,'#477579',x,.8,-2.9,2.4,.04,.04);}flatLabel(g,'ST. ALDER  /  CARDIAC UNIT',0,3,-2.9,6,.5,'#d5e2d0');for(const side of [-1,1]){box(g,'#d3c8a6',side*5,1.3,-2.9,.7,1.1,.03);flatLabel(g,'03',side*5,1.35,-2.86,.6,.4,'#17707a');}if(name==='office'){box(g,'#745d49',0,-1,-1.8,5,.18,1.2);for(let i=0;i<15;i++)box(g,i%2?'#406e6c':'#a28c57',-4+i*.13,.1,-2.7,.1,1.5+(i%3)*.12,.23);}}\n if(name==='ward'){for(let x=-5;x<=5;x+=.55)for(let y=-1.5;y<=3;y+=.55)box(g,'#346150',x,y,-3.08,.52,.52,.03);for(const x of [-4.5,-3.9,4.4]){tube(g,'#79947d',[[x,-1.7,-2.7],[x,2.8,-2.7],[x+.4,3.1,-2.7],[x+1.2,3.1,-2.7]],.065);for(let y=-1;y<3;y+=1.2)box(g,'#33493d',x,y,-2.68,.25,.09,.2);}flatLabel(g,'WARD  ZERO',0,2.65,-2.85,4,.6,'#e4c15b');box(g,'#b1b18c',0,.5,-2.98,1.2,1.8,.05);flatLabel(g,'RESTRICTED',0,1,-2.9,1.1,.25,'#974b43');}\n if(name==='lab'){flatLabel(g,'PATHOLOGY  /  NIGHT SERVICE',0,2.8,-2.95,6,.5,'#e1c66a');for(const x of [-4.2,4.2]){for(let y=-.8;y<2.4;y+=.8){box(g,'#9cbbb0',x,y,-2.7,2.6,.05,.55);for(let i=0;i<8;i++){const p=x-1+i*.27;const vial=box(g,'#88ae9c',p,y+.2,-2.6,.13,.35,.13);ball(g,i%2?'#d3d863':'#729cc3',p,y+.22,-2.55,.045,.1,.045);box(g,'#d3cdb0',p,y+.4,-2.6,.15,.06,.15);}}}box(g,'#789b97',0,-1.2,-1.7,6,.15,1.1);for(let i=0;i<7;i++)box(g,'#e5d2a6',-.8+i*.26,-1.06,-1.5,.22,.05,.4);}\n if(name==='roof'){box(g,'#0c2635',0,1,-3.05,12,7,.04);for(let i=0;i<23;i++){const x=-5.6+i*.51,h=.6+(i*7%13)*.13;box(g,'#133945',x,h/2-1,-2.8,.46,h,.2);for(let j=0;j<5;j++)for(let k=0;k<3;k++)if((i+j+k)%3===0)box(g,(i+j)%2?'#e9b953':'#5ca2ad',x-.14+k*.13,-.8+j*.24,-2.65,.045,.065,.015);}for(const x of [-5.5,-2.7,0,2.7,5.5])tube(g,'#667f7f',[[x,-1.6,-2.3],[x,.15,-2.3]],.025);tube(g,'#96b4a6',[[-6,.15,-2.3],[6,.15,-2.3]],.025);tube(g,'#607d81',[[-6,-.35,-2.3],[6,-.35,-2.3]],.02);flatLabel(g,'PORT CALLOWAY',0,3,-2.8,5,.4,'#578c92');}\n }\n const rain=new T.InstancedMesh(new T.BoxGeometry(.008,.13,.008),toon('#6a9aab'),180);root.add(rain);const dummy=new T.Object3D();\n return{root,get current(){return current;},set(name){current=name;for(const [n,g]of sets)g.visible=n===name;rain.visible=['roof','corridor','office'].includes(name);},update(dt){time+=dt;if(rain.visible){for(let i=0;i<180;i++){dummy.position.set(-5.5+(i*1.618%11),3.5-((time*1.9+i*.37)%6),-2.3-(i%4)*.08);dummy.rotation.z=-.13;dummy.updateMatrix();rain.setMatrixAt(i,dummy.matrix);}rain.instanceMatrix.needsUpdate=true;}}};\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/view/renderer.js');s=p.read_text().replace(\\\"import {createBust} from './bust.js';\\\", \\\"import {createBust} from './bust.js';\\\\nimport {createStageDecor} from './stage.js';\\\")\ns=s.replace(\\\"const room=makeRoom(scene),field=makeField();\\\", \\\"const room=makeRoom(scene),decor=createStageDecor(scene),field=makeField();\\\")\ns=s.replace(\\\"const entityMap=new Map(),tipMap=new Map(),mixers=[];let currentSite=''\\\", \\\"const entityMap=new Map(),tipMap=new Map(),bustCache=new Map(),portraitCache=new Map();let lastViewTick=-1,currentSite=''\\\")\ns=s.replace(\\\"portraitScene.add(portraitBust.root);\\\\n const pg\\\", \\\"portraitScene.add(portraitBust.root);portraitCache.set('bea',portraitBust);\\\\n const pg\\\")\ns=s.replace(\\\"portraitBust.dispose();portraitBust=createBust(id);\\\", \\\"portraitBust=portraitCache.get(id)||createBust(id);portraitCache.set(id,portraitBust);\\\")\ns=s.replace(\\\"function stage(data,line){mode='story';\\\", \\\"function stage(data,line){mode='story';decor.set(data.set);\\\")\ns=s.replace(\\\"const b=createBust(id);b.root.position\\\", \\\"const b=bustCache.get(id)||createBust(id);bustCache.set(id,b);b.root.position\\\")\ns=s.replace(\\\"const b=createBust('patient',{...patient.bust,name:patient.name,coat:'#6ba0a0',hair:'#383944',eyes:'#4f6473',age:patient.age});\\\", \\\"const b=bustCache.get(patient.name)||createBust('patient',{...patient.bust,name:patient.name,coat:'#6ba0a0',hair:'#383944',eyes:'#4f6473',age:patient.age});bustCache.set(patient.name,b);\\\")\ns=s.replace(\\\"function update(s,dt,settings={})\\\", \\\"function disposeTree(root){root.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material){const a=Array.isArray(o.material)?o.material:[o.material];for(const m of a)m.dispose();}});}\\\\n function update(s,dt,settings={})\\\")\ns=s.replace(\\\"room.root.visible=true;portrait.visible\\\", \\\"room.root.visible=mode\"'!=='\"'story'||decor.current==='or';decor.root.visible=mode==='story'&&decor.current\"'!=='\"'or';decor.update(dt);portrait.visible\\\")\ns=s.replace(\\\"if(site\"'!==currentSite){currentSite=site;field.reset(site);entityMap.forEach(v=>entities.remove(v.root));entityMap.clear();}\", \"const fieldKey=s.op+'\"':'+s.phase+':'+site;if(fieldKey\"'!==currentSite||s.tick<lastViewTick){currentSite=fieldKey;field.reset(site);entityMap.forEach(v=>{entities.remove(v.root);disposeTree(v.root);});entityMap.clear();}lastViewTick=s.tick;\")\ns=s.replace(\"m.update?.(dt,s);\", \"m.update?.(dt,s,e);\")\ns=s.replace(\"for(const [id,m] of entityMap)if(!s.entities.some(e=>e.id===id)){entities.remove(m.root);entityMap.delete(id);}\", \"for(const [id,m] of entityMap)if(typeof id==='\"'number'&&\"'!s.entities.some(e=>e.id===id)){entities.remove(m.root);disposeTree(m.root);entityMap.delete(id);}\")\ns=s.replace(\"if(tip.model)tip.root.remove(tip.model.root);\", \"if(tip.model){tip.root.remove(tip.model.root);disposeTree(tip.model.root);}\")\ns=s.replace(\"m.root.position.set(e.x,field.height(e.x,e.y)+.015,-e.y);\", \"if(settings.interpolate)m.root.position.lerp(new T.Vector3(e.x,field.height(e.x,e.y)+.015,-e.y),Math.min(1,dt*10));else m.root.position.set(e.x,field.height(e.x,e.y)+.015,-e.y);\")\ns=s.replace(\"tip.root.position.set(seat.x,field.height(seat.x,seat.y)+.045,-seat.y);\", \"if(settings.interpolate&&seat.id!==settings.localId)tip.root.position.lerp(new T.Vector3(seat.x,field.height(seat.x,seat.y)+.045,-seat.y),Math.min(1,dt*10));else tip.root.position.set(seat.x,field.height(seat.x,seat.y)+.045,-seat.y);\")\np.write_text(s)\nfor f in ['\"'src/view/entities.js','src/view/strains.js']:\n p=Path(f);s=p.read_text().replace('update(dt,s){','update(dt,s,next){if(next)e=next;');p.write_text(s)\np=Path('src/sim/physics.js');s=p.read_text().replace('this.chains.set(e.id,parts);return;}','this.chains.set(e.id,parts);if(e.kind===\\\\'legato\\\\')return;}');p.write_text(s)\np=Path('src/app/director.js');s=p.read_text().replace('hushDuration:this.tuning.hushDuration});','hushDuration:this.tuning.hushDuration,interpolate:this.inSession&&\"'!AIHub.isHost,localId:this.localId});'\"');p.write_text(s)\np=Path('tests/browser/suite.mjs');s=p.read_text().replace(\\\"}else if(s.screen==='Chart')\\\", \\\"}else if(s.screen==='Strain card'){await page.keyboard.press('Enter');}else if(s.screen==='Chart')\\\").replace(\\\"\"'!['\"'Operation','Strain card'].includes(__game.state().screen)\\\", \\\"__game.state().screen\"'!=='\"'Operation'\\\");p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
