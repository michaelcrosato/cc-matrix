.entities.some(e=>e.id===id)){entities.remove(m.root);disposeTree(m.root);entityMap.delete(id);}\")\ns=s.replace(\"if(tip.model)tip.root.remove(tip.model.root);\", \"if(tip.model){tip.root.remove(tip.model.root);disposeTree(tip.model.root);}\")\ns=s.replace(\"m.root.position.set(e.x,field.height(e.x,e.y)+.015,-e.y);\", \"if(settings.interpolate)m.root.position.lerp(new T.Vector3(e.x,field.height(e.x,e.y)+.015,-e.y),Math.min(1,dt*10));else m.root.position.set(e.x,field.height(e.x,e.y)+.015,-e.y);\")\ns=s.replace(\"tip.root.position.set(seat.x,field.height(seat.x,seat.y)+.045,-seat.y);\", \"if(settings.interpolate&&seat.id!==settings.localId)tip.root.position.lerp(new T.Vector3(seat.x,field.height(seat.x,seat.y)+.045,-seat.y),Math.min(1,dt*10));else tip.root.position.set(seat.x,field.height(seat.x,seat.y)+.045,-seat.y);\")\np.write_text(s)\nfor f in ['\"'src/view/entities.js','src/view/strains.js']:\n p=Path(f);s=p.read_text().replace('update(dt,s){','update(dt,s,next){if(next)e=next;');p.write_text(s)\np=Path('src/sim/physics.js');s=p.read_text().replace('this.chains.set(e.id,parts);return;}','this.chains.set(e.id,parts);if(e.kind===\\\\'legato\\\\')return;}');p.write_text(s)\np=Path('src/app/director.js');s=p.read_text().replace('hushDuration:this.tuning.hushDuration});','hushDuration:this.tuning.hushDuration,interpolate:this.inSession&&\"'!AIHub.isHost,localId:this.localId});'\"');p.write_text(s)\np=Path('tests/browser/suite.mjs');s=p.read_text().replace(\\\"}else if(s.screen==='Chart')\\\", \\\"}else if(s.screen==='Strain card'){await page.keyboard.press('Enter');}else if(s.screen==='Chart')\\\").replace(\\\"\"'!['\"'Operation','Strain card'].includes(__game.state().screen)\\\", \\\"__game.state().screen\"'!=='\"'Operation'\\\");p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"npm run build\ncat > tests/browser/visual-probe.mjs <<'EOF'\nimport {chromium} from 'playwright';\nconst b=await chromium.launch({headless:true});\ntry{const p=await b.newPage({viewport:{width:1920,height:1080}});p.on('pageerror',e=>console.log('ERROR',e.message));await p.goto('http://127.0.0.1:37593/dist/game.html?test=1&webgl=1');await p.waitForFunction(()=>__game.state().screen==='Title');const shot=async(name)=>{await p.evaluate(()=>__game.test.idle(-600000));await p.waitForTimeout(1200);await p.screenshot({path:\"'`artifacts/${name}-1080.png`});};const click=async(a,v)=>{await p.locator(`[data-action=${a}]${v==null?'\"'':\"'`[data-value=${v}]`}`).first().evaluate(el=>el.click());};await shot('\"'title');await p.keyboard.press('Enter');await shot('menu');await click('storyMenu');await click('newGame');await click('difficulty','normal');await shot('story');await p.keyboard.press('Tab');await p.keyboard.press('Tab');await shot('chart');await p.evaluate(()=>__game.test.skipTo(0,1));await shot('operation');await p.keyboard.press('Escape');await click('settings');await shot('settings');await p.keyboard.press('Escape');await p.keyboard.press('Escape');await p.evaluate(()=>{__game.test.setVitals(22)});await shot('danger');await p.evaluate(()=>{__game.test.skipTo(1,4);__game.test.dev('hush');});await shot('hush');}finally{await b.close();}\nEOF\nnode tests/browser/visual-probe.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
