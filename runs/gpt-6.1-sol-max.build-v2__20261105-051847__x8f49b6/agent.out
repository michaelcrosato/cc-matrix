{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The 3D field, instruments, parasite models, character busts, and ink filter are implemented. The campaign bot now completes all seven main operations and the final patient. Grand Rounds still needs balance work when threats overlap; I’ll address that alongside input and audio.\n"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/audio/engine.js <<'EOF'\nexport const tracks=['title','calm','comic','tense','sad','villain','or-calm','or-tense','adagio','staccato','tremolo','legato','crescendo','fermata','coda','credits'];\nexport const effects=['beat','ecg','flatline','slice','grip','pop','deposit','suction','gel','stitch','thread','laser','ping','clamp','unclamp','inject','defib','weakShock','vent','strain','nick','stamp','move','confirm','back','rain','murmur','door','phone','alarm','hush','sforzando','fortissimo'];\nconst midi=(n)=>440*2**((n-69)/12);\nexport function tone(ctx,dest,time,freq,duration=.16,type='sine',gain=.2){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(Math.max(20,freq),time);g.gain.setValueAtTime(.0001,time);g.gain.exponentialRampToValueAtTime(Math.max(.001,gain),time+.008);g.gain.exponentialRampToValueAtTime(.0001,time+duration);o.connect(g).connect(dest);o.start(time);o.stop(time+duration+.015);return o;}\nexport function noise(ctx,dest,time,duration=.14,freq=1800,gain=.15){const buffer=ctx.createBuffer(1,Math.ceil(ctx.sampleRate*duration),ctx.sampleRate),data=buffer.getChannelData(0);let seed=183;for(let i=0;i<data.length;i++){seed=(seed*16807)%2147483647;data[i]=(seed/1073741824-1)*(1-i/data.length);}const source=ctx.createBufferSource(),filter=ctx.createBiquadFilter(),g=ctx.createGain();filter.type='bandpass';filter.frequency.value=freq;filter.Q.value=.8;g.gain.value=gain;source.buffer=buffer;source.connect(filter).connect(g).connect(dest);source.start(time);}\nexport function synthSfx(ctx,dest,name,time=ctx.currentTime,power=1){if(['suction','gel','slice','nick','thread','rain','murmur','hush','door'].includes(name)){noise(ctx,dest,time,name==='rain'?.7:.16,name==='suction'?340:name==='hush'?700:1900,.25*power);if(name==='rain')noise(ctx,dest,time,.7,6500,.07);return;}\n const pitches={beat:68,ecg:880,flatline:950,grip:1700,pop:280,deposit:2400,stitch:1350,laser:190,ping:1200,clamp:760,unclamp:430,inject:480,defib:64,weakShock:130,vent:350,strain:175,stamp:70,move:600,confirm:900,back:350,phone:830,alarm:990,hush:190,sforzando:92,fortissimo:60};const f=pitches[name]||380;\n if(['beat','defib','stamp','fortissimo'].includes(name)){const o=tone(ctx,dest,time,f,.3,'sine',.5*power);o.frequency.exponentialRampToValueAtTime(24,time+.2);if(name==='beat')tone(ctx,dest,time+.12,55,.12,'sine',.18);else noise(ctx,dest,time,.2,700,.18);}\n else if(name==='deposit'){for(const r of [1,1.43,2.13,2.9])tone(ctx,dest,time,f*r,.23,'sine',.12/r);}\n else{tone(ctx,dest,time,f,name==='flatline'?.7:.14,['laser','strain','sforzando'].includes(name)?'sawtooth':'sine',.18*power);if(['ping','phone','alarm'].includes(name))tone(ctx,dest,time+.1,f*1.5,.2,'sine',.1);}}\nconst patterns={title:[0,7,10,7,5,3,2,7],calm:[0,4,7,11,7,4,2,7],comic:[0,7,12,7,3,10,15,10],tense:[0,0,1,0,7,6,3,2],sad:[0,7,3,10,5,3,2,7],villain:[5,4,5,2,4,0,2,2],adagio:[0,2,3,7,5,3,2,0],staccato:[0,12,7,10,0,7,12,10],tremolo:[12,14,15,14,12,14,19,14],legato:[0,2,3,5,7,5,3,2],crescendo:[0,3,7,10,12,15,19,22],fermata:[0,0,0,0,0,0,0,0],coda:[5,4,5,2,4,0,2,2],credits:[0,4,7,12,11,7,9,12]};\nexport function musicStep(ctx,dest,track,beat,time,duration=.65,layers=1){const pat=patterns[track]||patterns[track?.includes('tense')?'tense':'title'],root=track==='credits'?48:45,n=pat[beat%pat.length];tone(ctx,dest,time,midi(root-12+(beat%4===2?7:0)),duration*.6,'triangle',.25);const melody=ctx.createBiquadFilter();melody.type='lowpass';melody.frequency.value=track==='sad'?1300:2300;melody.connect(dest);tone(ctx,melody,time,midi(root+n+12),track==='staccato'?.11:duration*.8,track==='adagio'?'sawtooth':'triangle',.16);\n if(beat%4===0||track==='coda'){for(const k of [0,7,12])tone(ctx,dest,time,midi(root+k),duration*2.6,track==='coda'?'sine':'triangle',.035);}\n if(layers>1){tone(ctx,dest,time+duration*.5,midi(root+pat[(beat+3)%8]+24),.08,'sine',.07);noise(ctx,dest,time+duration*.5,.045,7000,.035);}if(track==='tremolo')for(let i=0;i<4;i++)tone(ctx,dest,time+i*duration/4,midi(root+n+24),duration/4,'sawtooth',.035);}\nconst vowels={a:[730,1090],e:[530,1840],i:[270,2290],o:[570,840],u:[300,870]};\nexport function voiceLine(ctx,dest,text,who='bea',time=ctx.currentTime){const settings={ren:[190,.052],bea:[130,.085],bell:[85,.073],pip:[280,.043],sorrento:[110,.07],ines:[150,.064],voss:[120,.09]},[pitch,rate]=settings[who]||settings.ren,chunks=text.toLowerCase().replace(/[\"'^a-z!? .]/g,'\"'').match(/.{1,3}/g)||[];chunks.slice(0,44).forEach((syllable,i)=>{if(\"'!syllable.trim())return;const vowel=syllable.match(/[aeiou]/)?.[0]||'\"'e',[f1,f2]=vowels[vowel],at=time+i*rate,osc=ctx.createOscillator(),g=ctx.createGain(),a=ctx.createBiquadFilter(),b=ctx.createBiquadFilter();osc.type='sawtooth';const variation=who==='sorrento'?1:1+Math.sin(syllable.charCodeAt(0)+i)*.09;osc.frequency.value=pitch*variation*(text.includes('\"'!'\"')?1.16:1);a.type=b.type='bandpass';a.frequency.value=f1;b.frequency.value=f2;a.Q.value=4;b.Q.value=3;g.gain.setValueAtTime(.0001,at);g.gain.exponentialRampToValueAtTime(.18,at+.01);g.gain.exponentialRampToValueAtTime(.0001,at+.065);osc.connect(a).connect(g);osc.connect(b).connect(g);g.connect(dest);osc.start(at);osc.stop(at+.075);if(/[ktp]/.test(syllable))noise(ctx,dest,at,.02,2800,.035);});return chunks.length*rate;}\nexport class AudioEngine{\n constructor(settings={}){this.ctx=null;this.track='title';this.muted=false;this.settings=settings;this.step=0;this.next=0;this.lastBeat=-1;this.running=true;\n try{this.ctx=new (window.AudioContext||window.webkitAudioContext)();const ctx=this.ctx;this.master=ctx.createDynamicsCompressor();this.master.threshold.value=-9;this.master.ratio.value=5;this.master.connect(ctx.destination);this.music=ctx.createGain();this.sfx=ctx.createGain();this.voice=ctx.createGain();this.filter=ctx.createBiquadFilter();this.filter.type='lowpass';this.filter.frequency.value=18000;th