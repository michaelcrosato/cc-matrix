{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"sed -n '/processEvents(){/,/cutIn(text)/p' src/app/director.js && sed -n '1,95p' src/app/session.js\"","aggregated_output":" processEvents(){if(!this.sim)return;const events=this.sim.drainEvents();for(const e of events){this.view?.event(e);if(e.type==='bark'){this.bark=e.text||barkFor(e.event,this.sim.state.tick);if(this.sim.state.op===6)this.bark='“'+this.bark+'” — her notebook.';if(performance.now()-(this.lastBarkTime||0)>1200){this.audio.say(this.bark,this.sim.state.op===6?'pip':'bea');this.lastBarkTime=performance.now();}}\n if(e.type==='hint')this.showHint();if(e.type==='grade'&&!this.params.has('norender')){const pos=this.view?.project(e.x,e.y)||{x:innerWidth/2,y:innerHeight/2};const g=document.createElement('div');g.className='grade '+(e.grade==='MISS'?'miss':'');g.textContent=e.grade;g.style.left=pos.x+'px';g.style.top=pos.y+'px';this.toastEl.append(g);setTimeout(()=>g.remove(),950);}\n if(e.type==='strain'&&!this.attract&&!this.bot&&!this.inSession&&!this.seenStrains?.has(e.strain)){this.seenStrains?.add(e.strain);this.strain=e.strain;this.overlay='strain';this.renderOverlay();this.audio.setTrack(e.strain);}\n if(e.type==='phase'){this.hud.phaseKey='';if(this.sim.phase?.tools[0]&&tools.includes(this.sim.phase.tools[0]))this.setTool(tools.indexOf(this.sim.phase.tools[0]));}\n if(['defib','sforzando','hush'].includes(e.type)){this.cutIn(e.type==='defib'?'CLEAR!':e.type==='hush'?'THE HUSH':'SFORZANDO!');}\n if(e.type==='win')this.audio.effect('stamp');else if(['beat','grip','pop','deposit','stitch','ping','clamp','unclamp','inject','defib','weakShock','vent','nick','hush','sforzando','fortissimo'].includes(e.type))this.audio.effect(e.type,e.type==='beat'?.16:.7);\n if(this.settings.rumble&&['stitch','clamp','defib'].includes(e.type)){const pad=Array.from(navigator.getGamepads?.()||[]).find(p=>p?.index===this.input.lastPad);try{pad?.vibrationActuator?.playEffect('dual-rumble',{duration:e.type==='defib'?180:35,strongMagnitude:e.type==='defib'?.8:.15,weakMagnitude:.25})?.catch(()=>{});}catch{}}\n }\n const s=this.sim.state;if(s.status==='won'&&!this.attract&&this.screen==='operation'&&!this.inSession){if(!this.modeFree){this.save.progress=Math.max(this.save.progress,Math.min(7,s.op+1));}const order='SABCD',previous=this.save.best[this.sim.op.id];if(s.rank&&(!previous||order.indexOf(s.rank)<order.indexOf(previous)))this.save.best[this.sim.op.id]=s.rank;writeSave(this.save);this.overlay=null;this.setScreen('report');}\n if(s.status==='failed'&&!this.attract&&this.screen==='operation'&&!this.inSession){this.overlay='fail';this.renderOverlay();}\n }\n cutIn(text){if(this.attract||this.params.has('norender'))return;const el=document.createElement('div');el.className='cutin';el.textContent=text;this.toastEl.append(el);setTimeout(()=>el.remove(),1400);}\nimport {Sim} from '../sim/sim.js';\nimport {snapshot,keyframe,applySnapshot} from '../sim/snapshot.js';\nexport async function startSession(info,app){\n let sim=info.isHost?new Sim({op:8,players:info.players,rng:AIHub.rng('world')}):null;\n let ended=false,finished=false,started=false,acc=0,last=performance.now(),lastSnapshot=0,lastKeyframe=0,lastEvents=0,lastInput=0,lastActions=0,tokens=16,tokenAt=performance.now();\n let pendingEvents=[],localFrame={},lastDiscrete='',seq=0;\n const send=(data,reliable=false,to)=>{if(ended)return false;const now=performance.now();tokens=Math.min(16,tokens+(now-tokenAt)/1000*16);tokenAt=now;if(tokens<1)return false;const size=JSON.stringify(data).length;if(size>(reliable?15800:1100))return false;tokens--;return AIHub.send(data,{reliable,to});};\n const finish=()=>{if(!sim||finished||ended)return;finished=true;const seats=sim.state.seats,scores=Object.fromEntries(seats.map(s=>[s.id,Math.max(0,Math.round(s.score))])),standings=[...seats].sort((a,b)=>b.score-a.score).map(s=>[s.id]),stats=Object.fromEntries(seats.map(s=>[s.id,{Cuts:s.stats.Cuts,Stitches:s.stats.Stitches,Burns:Math.round(s.stats.Burns),Saves:s.stats.Saves,Accuracy:Math.round(s.clean/Math.max(1,s.actions)*100)+'%'}]));AIHub.finish({standings,scores,won:sim.state.status==='won',stats,awards:seats.length?[{id:[...seats].sort((a,b)=>b.clean-a.clean)[0].id,title:'Steadiest Hands',detail:'Held the rhythm together'}]:[]});};\n if(app){app.inSession=true;app.sessionInfo=info;app.localId=info.me;app.sim=sim;app.externalState=sim?null:{...newClientState(info)};app.sessionData={answer:answer=>{if(!ended&&!started)AIHub.answer(answer);}};app.screen='session-card';app.overlay=null;app.notice=false;app.view?.setMode('title');app.render();}\n AIHub.on('card',data=>app?.refreshSessionCard(data));\n AIHub.on('start',()=>{started=true;if(app){app.overlay=null;app.setScreen('operation');app.view?.setMode('operation');app.audio.setTrack('or-tense');}});\n AIHub.on('message',(data,from)=>{if(ended||!data||typeof data!=='object')return;if(sim&&(data.t==='i'||data.t==='a')){const seat=sim.state.seats.find(s=>s.id===from);if(!seat)return;const frame=data.f;if(!frame||!Number.isFinite(frame.ax??frame.x??0)||!Number.isFinite(frame.ay??frame.y??0))return;if(data.n<(seat.seq||0))return;seat.seq=data.n;sim.input(from,frame);}else if(from===info.host&&app){if(data.t==='k'||data.t==='s'){const own=app.externalState?.seats.find(p=>p.id===info.me),prediction=own&&app.externalState.tick>=0?{x:own.x,y:own.y,tool:own.tool,use:own.use}:null;app.externalState=applySnapshot(app.externalState,data);const target=app.externalState?.seats.find(p=>p.id===info.me);if(target&&prediction)Object.assign(target,prediction);}else if(data.t==='e')for(const e of data.e||[])app.view?.event(e);}});\n AIHub.on('leave',({id})=>{sim?.leave(id);if(app?.sessionInfo)app.sessionInfo.players=app.sessionInfo.players.filter(p=>p.id!==id);});\n AIHub.on('time-up',()=>{if(sim)finish();});\n AIHub.on('end',data=>{ended=true;if(app){app.audio.stop();app.screen='session-end';app.overlay=null;app.endReason=data.reason==='host-left'?'The lead surgeon disconnected. The hub has closed this round.':'Your team’s results are with the hub.';app.render();app.ended=true;}sim?.free();sim=null;});\n AIHub.ready();\n const pump=()=>{if(ended)return;const now=performance.now(),dt=Math.min((now-last)/1000,.25);last=now;if(started&&AIHub.time()>=0){\n if(app){const state=sim?.state||app.externalState,seat=state?.seats.find(s=>s.id===info.me);if(seat){localFrame={...app.input.frame(seat),...app.virtual};if(sim)sim.input(info.me,localFrame);else{\n // Local prediction is immediate, while the authoritative state arrives behind it.\n if(Number.isFinite(localFrame.x)){seat.x=Math.max(-1.55,Math.min(1.9,localFrame.x));seat.y=Math.max(-.95,Math.min(.95,localFrame.y));}else{seat.x=Math.max(-1.55,Math.min(1.9,seat.x+(localFrame.ax||0)*app.settings.tipSpeed*dt));seat.y=Math.max(-.95,Math.min(.95,seat.y+(localFrame.ay||0)*app.settings.tipSpeed*dt));}seat.tool=localFrame.tool;seat.use=localFrame.use;\n }}}\n if(sim){acc+=dt;while(acc>=1/60){sim.step();acc-=1/60;}const events=sim.drainEvents().filter(e=>e.type!=='beat');if(app){for(const e of events){app.view?.event(e);if(e.type==='bark')app.bark=e.text||'One patient. All hands.';if(['pop','deposit','stitch','clamp','defib','inject'].includes(e.type))app.audio.effect(e.type,.7);}}pendingEvents.push(...events);\n if(now-lastSnapshot>=105){lastSnapshot=now;send(snapshot(sim.state));}if(now-lastKeyframe>=1020){lastKeyframe=now;send(keyframe(sim.state),true);}if(pendingEvents.length&&now-lastEvents>=260){lastEvents=now;send({t:'e',e:pendingEvents.slice(-16)},true);pendingEvents=[];}if(sim.state.status!=='playing')finish();\n }else{if(now-lastInput>=86){lastInput=now;send({t:'i',n:++seq,f:localFrame},false,info.host);}const discrete=JSON.stringify([localFrame.syringe,localFrame.special,localFrame.alt,localFrame.site]);if(discrete!==lastDiscrete&&now-lastActions>340){lastActions=now;lastDiscrete=discrete;send({t:'a',n:++seq,f:localFrame},true,info.host);}}\n }else if(app&&started){const left=Math.ceil(-AIHub.time()/1000);let countdown=document.getElementById('countdown');if(!countdown){countdown=document.createElement('div');countdown.id='countdown';countdown.className='countdown';app.toastEl.append(countdown);}countdown.textContent=left>0?left:'';if(left<=0)countdown.remove();}\n if(AIHub.time()>=0)document.getElementById('countdown')?.remove();setTimeout(pump,16);};pump();\n return{finish,stop:()=>{ended=true;}};\n}\nfunction newClientState(info){return{op:8,phase:0,phaseTime:0,tick:-1,elapsed:0,vitals:100,minVitals:100,timer:300,score:0,combo:0,bestCombo:0,misses:0,actions:0,flawless:0,rank:null,doctor:'ren',composure:0,hush:0,sforzando:0,beat:0,bar:0,beatPhase:0,bpm:82,pulse:0,site:0,entities:[],tray:[],seats:info.players.map(p=>({...p,x:0,y:0,tool:3,site:0,use:0,cooldown:0})),status:'playing',arrest:false,objective:'Split the work. Keep the patient alive.'};}\n","exit_code":0,"status":"completed"}}
