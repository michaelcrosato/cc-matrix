age.waitForFunction(()=>__game.state().screen==='Title');await page.waitForTimeout(900);assert.equal((await state(page)).renderBackend,'webgl2');assert.ok(await page.evaluate(()=>document.fonts.check('16px Bangers')));await page.screenshot({path:'artifacts/offline-handin.png'});assert.ok(statSync('artifacts/offline-handin.png').size>12000);assert.deepEqual(requests,[]);assert.deepEqual(problems,[]);await context.close();}finally{await browser.close();}});\n'''\ns=s[:idx]+addition+s[idx:]\nidx=s.index(\\\" await test('input / keyboard\\\")\naddition=''' await test('graphics / removed strain trophies keep rendering through the next phase',async()=>{const {context,page}=await boot(browser,srv.url,'test=1&webgl=1',{viewport:{width:960,height:540}});try{await page.evaluate(()=>{__game.test.skipTo(5,1);__game.test.bot(true);__game.test.step(2000);});assert.ok(await page.evaluate(()=>__game.test.getState().tray.some(e=>e.kind==='crescendo')));await page.waitForTimeout(1200);const before=await page.evaluate(()=>__game.test.graphics().frames);await page.waitForTimeout(900);assert.ok(await page.evaluate(before=>__game.test.graphics().frames>before,before));}finally{await context.close();}});\n'''\ns=s[:idx]+addition+s[idx:];p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
