{"type":"item.completed","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"rg --files artifacts -g 'final-*.png' && nl -ba tests/browser/final-visuals.mjs | sed -n '1,15p'\"","aggregated_output":"artifacts/final-story-shout.png\nartifacts/final-title.png\n     1\timport {chromium} from 'playwright';\n     2\timport {copyFileSync} from 'node:fs';\n     3\tconst browser=await chromium.launch({headless:true});\n     4\ttry{const page=await browser.newPage({viewport:{width:1920,height:1080}}),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:37593/dist/game.html?test=1&webgl=1');await page.waitForFunction(()=>__game.state().screen==='Title');const shot=async(name,wait=700)=>{await page.evaluate(()=>__game.test.idle(-600000));await page.waitForTimeout(wait);await page.screenshot({path:`artifacts/final-${name}.png`});};await shot('title');\n     5\tawait page.evaluate(()=>__game.test.dev('story','S13'));for(let i=0;i<7;i++)await page.locator('[data-action=advance]').evaluate(el=>el.click());await shot('story-shout',150);\n     6\tfor(const [name,op,phase]of [['adagio',2,2],['staccato',3,1],['tremolo',3,4],['legato',4,1],['crescendo',5,1],['fermata',5,4],['coda',6,4]]){await page.evaluate(([op,phase])=>__game.test.skipTo(op,phase),[op,phase]);await shot(name);}\n     7\tawait page.evaluate(()=>__game.test.skipTo(5,1));const feeders=await page.evaluate(()=>__game.test.getState().entities.filter(e=>e.kind==='feeder').map(e=>[e.x,e.y]));for(const [x,y]of feeders)await page.evaluate(([x,y])=>{__game.test.input({tool:5,x,y,use:1});__game.test.step(85);},[x,y]);await page.evaluate(()=>__game.test.input(null));await shot('crescendo-cut-guide');\n     8\tawait page.evaluate(()=>{__game.test.skipTo(1,4);__game.test.dev('hush');});await shot('hush-cutin',200);\n     9\tawait page.evaluate(()=>{__game.test.skipTo(0,1);__game.test.setVitals(22);});await shot('danger');\n    10\tawait page.evaluate(()=>{__game.test.skipTo(0,0);__game.test.bot(true);__game.test.step(22000);});await shot('report');await page.keyboard.press('Escape');await page.keyboard.press('Escape');await page.locator('[data-action=settings]').first().evaluate(el=>el.click());await shot('settings');await page.keyboard.press('Escape');await page.locator('[data-action=about]').evaluate(el=>el.click());await shot('about');await page.close();\n    11\tcopyFileSync('dist/game.html','tests/hub/site/game.html');const hub=await browser.newPage({viewport:{width:1920,height:1080}});await hub.goto('http://127.0.0.1:37593/tests/hub/site/harness.html?game=game.html&players=2');await hub.waitForTimeout(1800);const frame=hub.frames().find(f=>f.url().includes('/game.html'));if(frame){await frame.waitForFunction(()=>window.__game&&__game.state().screen==='Session card');await frame.locator('body').screenshot({path:'artifacts/final-session-card.png'});}await hub.close();if(errors.length)throw Error(errors.join('\\n'));}finally{await browser.close();}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"npm run build\nnode --input-type=module <<'EOF'\nimport {chromium} from 'playwright';const b=await chromium.launch({headless:true});try{const p=await b.newPage({viewport:{width:960,height:540}});p.on('console',m=>{if(m.type()==='error'||m.type()==='warning')console.log(m.type(),m.text().slice(0,1000));});p.on('pageerror',e=>console.log('PAGE',e.message));await p.goto('http://127.0.0.1:37593/dist/game.html?test=1&webgl=1');await p.waitForFunction(()=>__game.state().screen==='Title');await p.evaluate(()=>{__game.test.skipTo(2,2);__game.test.idle(-600000);});await p.waitForTimeout(1800);console.log(await p.evaluate(()=>({state:__game.state(),msg:document.getElementById('graphics-message')?.textContent})));await p.screenshot({path:'artifacts/adagio-debug.png'});}finally{await b.close();}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
