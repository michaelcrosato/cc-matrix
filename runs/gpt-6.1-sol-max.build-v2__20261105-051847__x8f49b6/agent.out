.about-body{display:grid;gap:1.15rem;margin-top:1rem}.about-field{font-size:2.45rem;line-height:1.18}.about-field b{color:var(--gold);font-weight:700;margin-right:.75rem}.about-field.long{font-size:2.1rem}.story-screen{pointer-events:none\"'!important;background:linear-gradient(0deg,#061b25aa,transparent 45%)}.story-top{position:absolute;top:4.8vh;left:5vw;right:5vw;display:flex;justify-content:space-between;align-items:center;gap:1.5rem}.scene-title{font-size:2.1rem;letter-spacing:.1em;text-transform:uppercase}.dialogue-box{position:absolute;left:8vw;right:8vw;bottom:8vh;min-height:12rem;background:var(--paper);color:var(--ink);padding:2rem 2.5rem;border:.3rem solid var(--ink);box-shadow:.6rem .7rem 0 #041b22;pointer-events:auto;cursor:pointer}.speaker-tag{position:absolute;left:1.5rem;top:-2rem;background:var(--gold);color:var(--ink);font-size:2.6rem;font-weight:700;padding:.25rem 1.3rem;transform:rotate(-2deg);border:.2rem solid var(--ink);box-shadow:.2rem .2rem 0 #120d20}.dialogue{font-size:3.1rem;line-height:1.15;padding-top:.8rem;max-width:91%}.dialogue.shout{font:4rem Bangers;letter-spacing:.025em}.advance-prompt{position:absolute;right:1.5rem;bottom:1rem;color:#4e6262;font-size:1.8rem;display:flex;gap:.6rem;align-items:center}.story-line-count{position:absolute;left:8vw;bottom:4.4vh;font-size:1.8rem;color:var(--muted)}.chart-screen{background:linear-gradient(90deg,#091d25f5,#0a222bdb 57%,#0c263024)}.chart{width:57%;max-width:64rem;position:relative;padding:2.5rem 2.6rem;background:var(--paper);color:var(--ink);box-shadow:.65rem .65rem 0 #030f1b;border:.18rem solid var(--ink);margin-top:3vh;transform:rotate(-.6deg)}.chart:before{content:'\"'';position:absolute;width:10rem;height:1.7rem;background:#729595;border:.2rem solid var(--ink);left:calc(50% - 5rem);top:-.9rem;border-radius:.3rem}.chart-id{display:flex;justify-content:space-between;align-items:center;font-size:1.8rem;color:#537775;letter-spacing:.08em;text-transform:uppercase}.chart h2{font-size:4.7rem;