{"type":"item.completed","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"rg -n 'splash|cardMs|card|countdown' tests/hub/site/harness.html | head -n 40\"","aggregated_output":"51:  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n224:    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n254:  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n266:  state.splashUntil = null;\n268:  log('splash over: the round starts once every game has loaded');\n272:/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\n274:  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\n278:    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n279:    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\n280:    if (cell.cardSent === id) continue;\n281:    cell.cardSent = id;\n282:    cell.bridge.card(card);\n286:/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\n298:    state.splashUntil += 10_000;\n300:  log(`${cell.key} answers ${what} on the game's card`);\n350:  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n440:    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n443:    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n444:    if (caps.some((c) => c?.card)) {\n446:      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n456:    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n","exit_code":0,"status":"completed"}}
