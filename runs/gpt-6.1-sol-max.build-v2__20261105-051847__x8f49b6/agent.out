{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/app/session.js');s=p.read_text().replace(\\\"if(data.t==='k'||data.t==='s')app.externalState=applySnapshot(app.externalState,data);\\\", \\\"if(data.t==='k'||data.t==='s'){const own=app.externalState?.seats.find(p=>p.id===info.me),prediction=own?{x:own.x,y:own.y,tool:own.tool,use:own.use}:null;app.externalState=applySnapshot(app.externalState,data);const target=app.externalState?.seats.find(p=>p.id===info.me);if(target&&prediction)Object.assign(target,prediction);}\\\")\ns=s.replace(\\\"seat.x=localFrame.x;seat.y=localFrame.y;\\\", \\\"seat.x=Math.max(-1.55,Math.min(1.9,localFrame.x));seat.y=Math.max(-.95,Math.min(.95,localFrame.y));\\\")\np.write_text(s)\np=Path('src/sim/snapshot.js');s=p.read_text().replace('z:state.score,a:', 'z:state.score,h:+state.hush.toFixed(2),f:+state.sforzando.toFixed(2),a:')\ns=s.replace(\\\"beatPhase:data.q,bpm:data.m,site:data.s,composure:data.c\\\", \\\"beatPhase:data.q,bpm:data.m,bar:Math.floor(data.b/4),elapsed:data.n/60,pulse:Math.exp(-data.q*9),hush:data.h||0,sforzando:data.f||0,site:data.s,composure:data.c\\\")\np.write_text(s)\np=Path('src/app/director.js');s=p.read_text().replace(\\\"setSite(n){if(\"'!this.sim)return;const s=this.sim.state;s.site=n;for(const seat of s.seats)seat.site=n;\", \"setSite(n){if(!this.sim)return;const s=this.sim.state;s.site=n;for(const seat of s.seats)if(!this.inSession||seat.id===this.localId)seat.site=n;\")\ns=s.replace(\"hudUpdate(){const state=this.sim?.state||this.externalState;\", \"displayState(){const s=this.sim?.state||this.externalState;if(this.inSession&&s){const seat=s.seats.find(p=>p.id===this.localId);return{...s,site:seat?.site??s.site};}return s;}'\"\\\\n hudUpdate(){const state=this.displayState();\\\")\ns=s.replace(\\\"const s=this.sim?.state||this.externalState;this.view?.update\\\", \\\"const s=this.displayState();this.view?.upd