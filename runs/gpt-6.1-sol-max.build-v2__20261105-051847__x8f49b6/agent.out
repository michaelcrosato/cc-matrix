"'!!a[5]\")\np.write_text(s)\np=Path('\"'src/app/director.js');s=p.read_text();head=\\\" processEvents(){if(\"'!this.sim)return;const events=this.sim.drainEvents();for(const e of events){\";a=s.index(head);b=s.index(\"'\"\\\\n }\\\\n const s=this.sim.state\\\",a);frag=s[a+len(head):b]\nfrag=frag.replace('this.sim.state.tick','state.tick').replace('this.sim.state.op','state.op')\nold=\\\"if(e.type==='phase'){this.hud.phaseKey='';if(this.sim.phase?.tools[0]&&tools.includes(this.sim.phase.tools[0]))this.setTool(tools.indexOf(this.sim.phase.tools[0]));}\\\"\nnew=\\\"if(e.type==='phase'){this.hud.phaseKey='';if(this.externalState&&e.objective)this.externalState.objective=e.objective;const phase=operations[state.op]?.phases[e.phase??state.phase];if(phase?.tools[0]&&tools.includes(phase.tools[0]))this.setTool(tools.indexOf(phase.tools[0]));}\\\"\nassert old in frag;frag=frag.replace(old,new)\nfrag=frag.replace(\\\"if(e.type==='win')this.audio.effect('stamp');\\\", \\\"if(e.type==='land')this.audio.effect('deposit',.7);else if(e.type==='win')this.audio.effect('stamp');\\\").replace(\\\"'pop','deposit','stitch'\\\",\\\"'pop','stitch'\\\")\nmethod=\\\" presentEvent(e){const state=this.sim?.state||this.externalState||{op:0,tick:0,phase:0};\\\"+frag+\\\"\\\\n }\\\\n\\\"\ns=s[:a]+method+\\\" processEvents(){if(\"'!this.sim)return;const events=this.sim.drainEvents();for(const e of events)this.presentEvent(e);\"+s[b+len('\"'\\\\n }'):]\np.write_text(s)\np=Path('src/app/session.js');s=p.read_text().replace(\\\"for(const e of data.e||[])app.view?.event(e);\\\", \\\"for(const e of data.e||[])app.presentEvent(e);\\\")\nold=\\\"if(app){for(const e of events){app.view?.event(e);if(e.type==='bark')app.bark=e.text||'One patient. All hands.';if(['pop','deposit','stitch','clamp','defib','inject'].includes(e.type))app.audio.effect(e.type,.7);}}\\\"\nassert old in s;s=s.replace(old,\\\"if(app)for(const e of events)app.presentEvent(e);\\\")\np.write_text(s)\nPY\nnode tests/run-all.mjs sim\"","