{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '180,320p' Son-of-a-Sun-Superman-1979-gpt-6.1-sol-ultra-20261106-011205/hub.js\"","aggregated_output":"    this.me = 0;\n    this.players = [{ id: 0, name: 'Sun', color: '#e8443a' }];\n    this.connected = true;\n    this.playing = true;\n    this.openBroadcast();\n    this.roleTo('host');\n    this.statusTo(`Room ${this.room} · waiting for a partner tab`);\n    const heartbeat = () => {\n      if (!this.broadcast || this.role !== 'host') return;\n      this.broadcast.postMessage({ t: 'beacon', from: this.clientId, players: this.players });\n      this.later(heartbeat, 1000);\n    };\n    heartbeat();\n    return this.room;\n  }\n\n  join(room = 'sun') {\n    if (this.active) throw new Error('The AI Hub manages this round.');\n    this.close();\n    this.mode = 'broadcast';\n    this.room = String(room).trim().toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 20) || 'SUN';\n    this.me = 1;\n    this.openBroadcast();\n    this.roleTo('guest');\n    this.statusTo(`Room ${this.room} · looking for the host tab`);\n    const hello = () => {\n      if (!this.broadcast || this.role !== 'guest') return;\n      this.broadcast.postMessage({ t: 'join', from: this.clientId });\n      this.later(hello, 1000);\n    };\n    hello();\n    return this.room;\n  }\n\n  openBroadcast() {\n    if (!globalThis.BroadcastChannel) throw new Error('Tab rooms are unavailable in this browser. Use a direct link.');\n    this.broadcast = new BroadcastChannel(`son-of-a-sun:${this.room}`);\n    this.broadcast.onmessage = ({ data }) => {\n      if (!data || data.from === this.clientId || this.ended) return;\n      if (data.t === 'join' && this.role === 'host') {\n        if (!this.clients.has(data.from)) {\n          const used = new Set(this.clients.values());\n          const slot = [1, 2, 3].find(id => !used.has(id));\n          if (slot === undefined) { this.broadcast.postMessage({ t: 'full', to: data.from }); return; }\n          this.clients.set(data.from, slot);\n          this.players.push({ id: slot, name: ['Sun', 'Moon', 'Comet', 'Nova'][slot], color: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][slot] });\n          this.roleTo('host');\n        }\n        this.broadcast.postMessage({ t: 'welcome', from: this.clientId, to: data.from, me: this.clients.get(data.from), players: this.players });\n        this.statusTo(`Room ${this.room} · ${this.players.length} heroes connected`);\n      } else if (data.t === 'welcome' && this.role === 'guest' && data.to === this.clientId) {\n        const first = !this.connected;\n        this.me = data.me;\n        this.hostId = data.from;\n        this.players = data.players;\n        this.connected = true;\n        this.playing = true;\n        this.lastHostAt = performance.now();\n        if (first) { this.roleTo('guest'); this.callbacks.onStart?.({ standalone: true }); }\n        this.statusTo(`Room ${this.room} · partner connected`);\n      } else if (data.t === 'bye') {\n        if (this.role === 'host' && this.clients.has(data.from)) {\n          const id = this.clients.get(data.from);\n          this.clients.delete(data.from);\n          this.players = this.players.filter(p => p.id !== id);\n          this.callbacks.onLeave?.(id, 'left');\n          this.roleTo('host');\n        } else if (this.role === 'guest' && data.from === this.hostId) {\n          this.connected = false;\n          this.statusTo('The host left the room');\n          this.callbacks.onEnd?.('host-left');\n        }\n      } else if (data.t === 'full' && data.to === this.clientId) this.statusTo('That room already has four heroes');\n      else if (data.game === 'son-of-a-sun') {\n        if (this.role === 'host' && this.clients.has(data.from)) this.receive(data, this.clients.get(data.from));\n        else if (this.role === 'guest' && data.from === this.hostId) this.receive(data, 0);\n      }\n    };\n  }\n\n  newPeer(role) {\n    if (this.active) throw new Error('The AI Hub manages this round.');\n    this.close();\n    if (!globalThis.RTCPeerConnection) throw new Error('Direct co-op is unavailable in this browser.');\n    this.mode = 'webrtc';\n    this.me = role === 'host' ? 0 : 1;\n    this.players = [{ id: 0, name: 'Sun', color: '#e8443a' }, { id: 1, name: 'Moon', color: '#3b82f6' }];\n    this.roleTo(role);\n    this.pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n    this.pc.onconnectionstatechange = () => {\n      const state = this.pc?.connectionState;\n      if (state === 'failed') this.statusTo('Direct connection failed. Some networks require AI Hub.');\n      if (state === 'disconnected' || state === 'closed') {\n        this.connected = false;\n        this.statusTo('Partner disconnected');\n        this.callbacks.onLeave?.(this.me === 0 ? 1 : 0, 'disconnected');\n      }\n    };\n    this.pc.ondatachannel = ({ channel }) => this.attachDataChannel(channel);\n    return this.pc;\n  }\n\n  attachDataChannel(channel) {\n    this.channel = channel;\n    channel.onopen = () => {\n      this.connected = true;\n      this.playing = true;\n      this.statusTo('Direct co-op · partner connected');\n      this.roleTo(this.role);\n      this.callbacks.onStart?.({ standalone: true });\n    };\n    channel.onclose = () => {\n      if (this.ended) return;\n      this.connected = false;\n      this.statusTo('Direct co-op · partner disconnected');\n      this.callbacks.onLeave?.(this.me === 0 ? 1 : 0, 'disconnected');\n    };\n    channel.onerror = () => this.statusTo('Direct co-op · connection error');\n    channel.onmessage = ({ data }) => {\n      if (typeof data !== 'string' || data.length > 65536) return;\n      try { this.receive(JSON.parse(data), this.me === 0 ? 1 : 0); } catch { /* Ignore malformed peer packets. */ }\n    };\n  }\n\n  async gather() {\n    if (!this.pc || this.pc.iceGatheringState === 'complete') return;\n    const pc = this.pc;\n    await new Promise(resolve => {\n      let timeout;\n      const done = () => { clearTimeout(timeout); pc.removeEventListener('icegatheringstatechange', check); resolve(); };\n      const check = () => { if (pc.iceGatheringState === 'complete') done(); };\n      pc.addEventListener('icegatheringstatechange', check);\n      timeout = setTimeout(done, 6500);\n    });\n  }\n\n  encodeDescription() {\n    const description = this.pc.localDescription;\n    return `SUN1.${btoa(JSON.stringify({ type: description.type, sdp: description.sdp }))}`;\n  }\n\n","exit_code":0,"status":"completed"}}
