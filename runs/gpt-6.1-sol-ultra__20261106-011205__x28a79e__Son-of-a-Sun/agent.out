{"type":"item.completed","item":{"id":"item_38","type":"agent_message","text":"The campaign playthrough is reaching the finale, including the “freeze, then shatter” rule and solar recharging between emitters. A four-player test exposed a startup deadline issue, so I removed an unnecessary shader precompile wait. I’m checking the final co-op cases and the direct-open HTML package now.\n"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' Son-of-a-Sun-Superman-1979-gpt-6.1-sol-ultra-20261106-011205/tests-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' Son-of-a-Sun-Superman-1979-gpt-6.1-sol-ultra-20261106-011205/tests-game.py\"","aggregated_output":"\"\"\"One-command gameplay verification: prints failures and one final count only.\"\"\"\nfrom contextlib import contextmanager\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nimport json\nimport sys\nimport threading\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent\nchecks = 0\nfailures = []\n\n\ndef check(condition, label, detail=\"\"):\n    global checks\n    checks += 1\n    if not condition:\n        message = f\"FAIL {label}\" + (f\": {detail}\" if detail else \"\")\n        failures.append(message)\n        print(message, flush=True)\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\n\n@contextmanager\ndef serve():\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), partial(QuietHandler, directory=str(ROOT)))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        yield f\"http://127.0.0.1:{server.server_port}/game.html?test=1\"\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join(timeout=2)\n\n\ndef boot(page, url):\n    page.goto(url, wait_until=\"domcontentloaded\", timeout=120000)\n    page.wait_for_function(\"window.__sun?.state.ready || window.__bootError\", timeout=120000)\n    error = page.evaluate(\"window.__bootError || null\")\n    if error:\n        raise AssertionError(\"boot: \" + error)\n    check(page.title().startswith(\"Son of a Sun\"), \"server serves this game\", page.title())\n    check(page.evaluate(\"__sun.state.backend\") == \"WebGPU\", \"WebGPU backend\")\n\n\ndef state(page):\n    return page.evaluate(\"__sun.state\")\n\n\ndef step(page, seconds, controls=None, warp=None):\n    return page.evaluate(\"\"\"({seconds, controls, warp}) => {\n      if(warp) __sun.warp(warp);\n      if(controls !== null) __sun.input(controls);\n      __sun.advanceTime(seconds);\n      return __sun.state;\n    }\"\"\", {\"seconds\": seconds, \"controls\": controls, \"warp\": warp})\n\n\ndef target(page, offset=(0, 0, 0)):\n    return page.evaluate(\"offset => __sun.target().map((v,i)=>v+offset[i])\", list(offset))\n\n\ndef run(headed=False, visual_only=False):\n    with serve() as url, sync_playwright() as p:\n        browser = p.chromium.launch(headless=not headed, args=[\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--disable-vulkan-surface\"])\n        try:\n            context = browser.new_context(viewport={\"width\": 1920, \"height\": 1080}, ignore_https_errors=True)\n            page = context.new_page()\n            errors = []\n            page.on(\"pageerror\", lambda e: errors.append(str(e)))\n            boot(page, url)\n            if visual_only:\n                page.wait_for_timeout(3000)\n                page.screenshot(path=str(ROOT / \"qa-title-headed.png\"))\n                page.locator('[data-act=\"start\"]').click()\n                page.evaluate(\"__sun.warp([0,65,65])\")\n                page.wait_for_timeout(4500)\n                page.screenshot(path=str(ROOT / \"qa-gameplay-headed.png\"))\n                check(not errors, \"headed render browser errors\", \"; \".join(errors))\n                context.close()\n                return\n            page.screenshot(path=str(ROOT / \"qa-title.png\"))\n            native = page.evaluate(\"__sun.native()\")\n            check(native[\"rapier\"] and native[\"colliders\"] > 20, \"native Rapier collision world\", str(native))\n            check(native[\"animation\"], \"native AnimationMixer\")\n            check({\"idle\", \"fly\", \"boost\"}.issubset(state(page)[\"nativeAnimations\"][0]), \"native animation clips\")\n            check(state(page)[\"settings\"][\"music\"] == 0.1, \"music defaults to 10 percent\")\n            offline = page.evaluate(\"__sun.offlineTest()\")\n            check(offline[\"passed\"], \"audible unclipped procedural audio\", json.dumps(offline))\n\n            # Attract is entered by the same timeout path as normal title idling.\n            page.evaluate(\"__sun.setAttract()\")\n            page.wait_for_function(\"__sun.state.demo\", timeout=10000)\n            check(state(page)[\"mode\"] == \"demo\", \"attract enters after title timeout\")\n            step(page, 8)\n            check(state(page)[\"runTime\"] >= 8, \"attract replay simulates\")\n            page.keyboard.press(\"Enter\")\n            page.wait_for_function(\"!__sun.state.demo\")\n            check(not state(page)[\"demo\"], \"any input exits attract\")\n            page.evaluate(\"__sun.action('title')\")\n\n            page.locator('[data-act=\"start\"]').click()\n            page.wait_for_function(\"__sun.state.mode === 'playing'\")\n            check(state(page)[\"actors\"] == 1, \"solo shift starts\")\n            page.evaluate(\"__sun.input(null)\")\n            before = state(page)[\"heroes\"][0][\"pos\"]\n            page.keyboard.down(\"Space\")\n            page.wait_for_timeout(700)\n            page.keyboard.up(\"Space\")\n            after = state(page)[\"heroes\"][0][\"pos\"]\n            check(after[1] > before[1] + 1, \"actual keyboard rise\", str([before, after]))\n            # A known roof collider: fly down onto the Evening Sun.\n            collision_before = state(page)[\"collisionCount\"]\n            page.evaluate(\"__sun.warp([-65,45,-40]); __sun.input(null)\")\n            page.keyboard.down(\"ControlLeft\")\n            page.wait_for_timeout(1600)\n            page.keyboard.up(\"ControlLeft\")\n            collision_state = state(page)\n            check(collision_state[\"heroes\"][0][\"pos\"][1] > 31.3, \"solid building blocks flight\", str(collision_state[\"heroes\"][0][\"pos\"]))\n            check(collision_state[\"collisionCount\"] > collision_before, \"actual keyboard collision contacts\")\n\n            # The whole campaign uses normal ability processing, only teleporting travel.\n            page.evaluate(\"__sun.start()\")\n            for i in range(3):\n                s = step(page, 0.8, {\"action\": True}, target(page))\n                check(s[\"heroes\"][0][\"carry\"] >= 0, f\"citizen {i + 1} can be caught\")\n                s = step(page, 0.8, {\"action\": True}, [0, 5, 65])\n                check(s[\"rescued\"] == i + 1, f\"citizen {i + 1} safely delivered\", str(s[\"rescued\"]))\n            check(state(page)[\"mission\"] == 1, \"rescue chapter advances\")\n            s = step(page, 6.2, {\"freeze\": True, \"action\": False}, target(page, (0, 4, 8)))\n            check(s[\"fireProgress\"] == 1 and s[\"mission\"] == 2, \"freeze breath extinguishes rooftop\")\n            for _ in range(22):\n                if state(page)[\"mission\"] != 2:\n","exit_code":0,"status":"completed"}}
