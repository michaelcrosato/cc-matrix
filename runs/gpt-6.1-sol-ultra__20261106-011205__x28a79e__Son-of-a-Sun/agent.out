{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' Son-of-a-Sun-Superman-1979-gpt-6.1-sol-ultra-20261106-011205/hub.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' Son-of-a-Sun-Superman-1979-gpt-6.1-sol-ultra-20261106-011205/hub.js\"","aggregated_output":"// Game transport. AI Hub's unmodified session.js must precede this module.\nexport class OnlineLink {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.role = 'solo';\n    this.connected = false;\n    this.status = 'Solo patrol';\n    this.me = 0;\n    this.server = false;\n    this.players = [{ id: 0, name: 'Sun', color: '#e8443a' }];\n    this.playing = false;\n    this.ended = false;\n    this.finished = false;\n    this.info = null;\n    this.mode = 'solo';\n    this.room = '';\n    this.pc = null;\n    this.channel = null;\n    this.broadcast = null;\n    this.timers = new Set();\n    this.unsubscribers = [];\n    this.clientId = globalThis.crypto?.randomUUID?.() || `sun-${Date.now()}-${Math.random()}`;\n    this.clients = new Map();\n    this.lastStateAt = -Infinity;\n    this.lastInputAt = -Infinity;\n    this.stateSequence = 0;\n    this.receivedSequence = -1;\n    this.lastHostAt = 0;\n    this.hostId = null;\n  }\n\n  get active() { return !!globalThis.AIHub?.active; }\n\n  statusTo(text) {\n    this.status = text;\n    this.callbacks.onStatus?.(text);\n  }\n\n  roleTo(role) {\n    this.role = role;\n    this.callbacks.onRole?.(role, {\n      me: this.me, server: this.server, players: this.players,\n      mode: this.mode, connected: this.connected, room: this.room,\n    });\n  }\n\n  async init() {\n    if (!this.active) return null;\n    this.mode = 'hub';\n    const hub = globalThis.AIHub;\n    const info = await hub.connect({ mode: 'shared-world', seats: [1, 4] });\n    if (!info) { this.mode = 'solo'; return null; }\n    this.info = info;\n    this.me = info.me;\n    this.server = !!info.server;\n    this.hostId = info.host;\n    this.players = info.players.slice();\n    this.connected = true;\n    this.roleTo(info.isHost ? 'host' : 'guest');\n    this.statusTo('AI Hub · waiting for the round');\n    this.unsubscribers.push(\n      hub.on('start', () => {\n        const begin = () => {\n          if (this.ended) return;\n          const remaining = -hub.time();\n          if (remaining > 0) { this.later(begin, Math.min(remaining + 1, 100)); return; }\n          this.playing = true;\n          this.statusTo('AI Hub · city patrol');\n          this.callbacks.onStart?.(info);\n        };\n        begin();\n      }),\n      hub.on('message', (data, from) => this.receive(data, from)),\n      hub.on('leave', ({ id, reason }) => {\n        this.players = hub.players.slice();\n        this.callbacks.onLeave?.(id, reason);\n        this.roleTo(this.role);\n      }),\n      hub.on('time-up', () => {\n        if (this.ended) return;\n        this.callbacks.onTimeUp?.();\n        // A host must report inside the grace period even if no gameplay\n        // callback was installed. A game's callback can supply its real score.\n        if (this.role === 'host' && !this.finished) this.finish({ score: 0, won: false });\n      }),\n      hub.on('end', ({ reason }) => {\n        this.ended = true;\n        this.playing = false;\n        this.connected = false;\n        this.clearTimers();\n        this.statusTo(`AI Hub · ${reason === 'finished' ? 'round complete' : reason}`);\n        this.callbacks.onEnd?.(reason);\n      }),\n    );\n    return info;\n  }\n\n  ready() { if (this.active && !this.ended) globalThis.AIHub.ready(); }\n\n  later(fn, delay) {\n    const id = setTimeout(() => { this.timers.delete(id); fn(); }, delay);\n    this.timers.add(id);\n    return id;\n  }\n\n  clearTimers() {\n    for (const id of this.timers) clearTimeout(id);\n    this.timers.clear();\n  }\n\n  receive(packet, from) {\n    if (!packet || packet.game !== 'son-of-a-sun' || this.ended) return;\n    if (packet.type === 'state' && this.role === 'guest') {\n      if (this.mode === 'hub' && from !== this.hostId) return;\n      if (Number.isFinite(packet.seq) && packet.seq <= this.receivedSequence) return;\n      this.receivedSequence = packet.seq;\n      this.lastHostAt = performance.now();\n      this.callbacks.onState?.(packet.state, from);\n    } else if (packet.type === 'input' && this.role === 'host') {\n      if (this.mode === 'hub' && !this.players.some(p => p.id === from)) return;\n      this.callbacks.onInput?.(packet.input, from);\n    } else if (packet.type === 'end' && this.role === 'guest' && this.mode !== 'hub') {\n      this.callbacks.onRoundEnd?.(packet.result);\n    }\n  }\n\n  send(packet) {\n    if (this.ended || !this.connected) return false;\n    packet.game = 'son-of-a-sun';\n    if (this.mode === 'hub') {\n      return globalThis.AIHub.send(packet, {\n        ...(this.role === 'guest' ? { to: this.hostId } : {}), reliable: true,\n      });\n    }\n    if (this.mode === 'webrtc' && this.channel?.readyState === 'open') {\n      if (this.channel.bufferedAmount > 262144) return false;\n      try { this.channel.send(JSON.stringify(packet)); return true; } catch { return false; }\n    }\n    if (this.mode === 'broadcast' && this.broadcast) {\n      this.broadcast.postMessage({ ...packet, from: this.clientId, player: this.me });\n      return true;\n    }\n    return false;\n  }\n\n  sendState(state) {\n    if (this.role !== 'host' || this.ended) return false;\n    const now = performance.now();\n    if (now - this.lastStateAt < 70) return false;\n    this.lastStateAt = now;\n    return this.send({ type: 'state', seq: ++this.stateSequence, state });\n  }\n\n  sendInput(input) {\n    if (this.role !== 'guest' || this.ended) return false;\n    const now = performance.now();\n    if (now - this.lastInputAt < 70) return false;\n    this.lastInputAt = now;\n    return this.send({ type: 'input', input });\n  }\n\n  finish({ score = 0, won = true, stats = {} } = {}) {\n    if (this.role !== 'host' || this.finished || this.ended) return;\n    this.finished = true;\n    const ids = this.players.map(p => p.id);\n    const result = {\n      standings: [ids], scores: Object.fromEntries(ids.map(id => [id, Number.isFinite(score) ? score : 0])),\n      won: !!won, stats: Object.fromEntries(ids.map(id => [id, stats])),\n    };\n    if (this.mode === 'hub') globalThis.AIHub.finish(result);\n    else this.send({ type: 'end', result });\n  }\n\n  // Same-browser tab rooms are useful for quick co-op and deterministic tests.\n  host(room = 'sun') {\n    if (this.active) throw new Error('The AI Hub manages this round.');\n    this.close();\n    this.mode = 'broadcast';\n    this.room = String(room).trim().toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 20) || 'SUN';\n    this.me = 0;\n","exit_code":0,"status":"completed"}}
