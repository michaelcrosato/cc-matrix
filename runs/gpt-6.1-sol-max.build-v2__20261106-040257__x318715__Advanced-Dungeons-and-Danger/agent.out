ttom:8px}.floor-name{font-family:Georgia,serif;font-size:1.13em}.compass{text-align:center;min-width:27%}.compass strong{font-family:Georgia,serif;font-size:1.3em;color:var(--gold);padding:0 18px}.compass .wind{color:#7d9299;letter-spacing:.2em;font-size:.56em}.goal{margin-top:10px;font-size:.58em;color:#c0c8bf;letter-spacing:.03em}.hud-button{color:var(--pale);border:1px solid #b7ac8e55;background:#0d171ccc;border-radius:3px;padding:10px 16px;line-height:1.35}.hud-button:hover,.hud-button:focus-visible{background:#6d5c3850;border-color:var(--gold)}kbd{font-family:inherit;border:1px solid #c5c0a666;border-radius:4px;padding:.1em .32em;color:#ecdbb3;font-size:.78em;white-space:nowrap}.menu-button{font-size:.68em}.hud-bottom{position:absolute;left:3.3%;right:3.3%;bottom:3.9%;display:flex;align-items:flex-end;justify-content:space-between;gap:25px}.vitals{width:26%;min-width:230px;max-width:440px}.meter{margin:13px 0}.meter-head{display:flex;align-items:center;gap:9px;font-size:.66em;letter-spacing:.08em}.meter-head .amount{margin-left:auto;font-size:1.13em;font-weight:bold;font-variant-numeric:tabular-nums;letter-spacing:0}.war .meter-head{color:var(--war)}.spirit .meter-head{color:var(--spirit)}.meter-track{height:8px;background:#213038aa;margin-top:9px;outline:1px solid #b1b6a826;outline-offset:3px}.meter-fill{height:100%;background:var(--war);transition:width .3s}.spirit .meter-track{height:6px}.spirit .meter-fill{background:var(--spirit)}.defenses{font-size:.5em;color:#aebcaf;margin:10px 0}.counters{display:flex;gap:20px;font-size:.63em;color:#b9c4bc;margin-top:17px}.counters b{font-weight:400;color:var(--pale)}.hands{width:24%;text-align:right}.hand{font-size:.63em;margin-top:12px}.hand-label{color:#a0a99f;letter-spacing:.12em;font-size:.75em;display:block;margin-bottom:6px}.hand strong{font-weight:400}.hand.active strong{font-size:1.15em;color:var(--gold)}.tool-links{display:flex;justify-content:flex-end;gap:9px;margin-top:16px}.tool-links button{font-size:.58em