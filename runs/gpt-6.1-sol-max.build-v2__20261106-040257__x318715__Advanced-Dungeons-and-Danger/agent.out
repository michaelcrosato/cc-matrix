his.rendererName=page.backend||'WebGL 2';this.ready=true;this._sync(true);this.options.onReady?.(this);return this;}\n    catch(e){this.ready=false;this.rendererName='unsupported';this.options.onError?.(e);throw e;}\n  }\n  _state(){return this.options.getState?.()||null;}\n  _settings(){return this.options.getSettings?.()||{};}\n  _player(){const s=this._state();return this.options.getPlayer?.()||Object.values(s?.players||{}).find(p=>p.connected&&!p.down)||Object.values(s?.players||{})[0]||null;}\n  look(dx=0,dy=0){const sensitivity=(this._settings().lookSensitivity??1)*.0026;this.yawOffset=clamp(this.yawOffset+dx*sensitivity,-.72,.72);this.pitch=clamp(this.pitch-dy*sensitivity,-.6,.45);}\n  resetLook(){this.yawOffset=0;this.pitch=-.035;}\n  _sync(force=false){\n    if(!this.ready)return;\n    const s=this._state(), p=this._player(), content=s?.content||CONTENT, floor=s?content.floors[s.floor]||content.floors[0]:showcase;\n    const secrets=entityList(s).filter(e=>e.type==='secret'&&e.floor===s.floor).map(e=>e.id+':'+e.open).join('|');\n    const key=(s?.runId||'title')+'|'+(s?.floor??-1)+'|'+floor.rows.join('')+'|'+secrets;\n    if(force||key!==this.floorKey){this.floorKey=key;this._build(floor,s,p);}\n    if(s?.runId!==this.lastRun){this.lastRun=s?.runId;this.seenEvents.clear();this.fx.length=0;}\n    const events=s?.events||[];\n    for(const ev of events){if(this.seenEvents.has(ev.id))continue;this.seenEvents.add(ev.id);this._event(ev);}\n    if(this.seenEvents.size>512)this.seenEvents=new Set(events.map(e=>e.id));\n    this._syncEntities(s);\n  }\n  _build(floor,s,p){\n    if(this.world)this.world.dispose();\n    this.actors.clear();this.things.clear();this.fx.length=0;this.lanterns=[];this.lastLogical=null;this.moveTween=null;\n    const E=this.E,index=s?.floor??0,pal=palettes[index]||palettes[0],rows=floor.rows.map(row=>row.split(''));\n    for(const e of entityList(s))if(e.type==='secret'&&e.floor===index&&e.open&&rows[e.y])rows[e.y][e.x]='.';\n    const doubled=[];\n    for(const row of rows){const r=row.map(ch=>ch==='#'?'##':'..').join('');doubled.push(r,r);}\n    this.floor=floor;this.rows=rows;this.palette=pal;\n    const world=this.world=new E.World3D(this.game,{level:{rows:doubled,ground:'flagstone',colors:{base:pal.base,dark:pal.dark,light:pal.light},wallSide:'brick',side:'brick',color:pal.wall,legend:{'#':{wall:48,cut:false,color:pal.wall,top:pal.wall,line:'#1d2a32'}}},\n      look:'puppet',res:'full',camera:{mode:'fixed',fov:72,near:.25,mouseLook:false,cut:false},overlay:{fov:62,light:1.1},\n      ambient:[pal.sky,pal.ground,2.45],sun:{color:'#aab9c7',intensity:.32,dir:[.3,.5,-1],shadow:false},\n      lights:9,torchLights:0,glowLights:4,shadows:true,outlines:true,fog:{color:pal.fog,near:62,far:240},sky:pal.fog,\n      filter:{look:'clean',bloom:.12,fxaa:true,punch:1.05},onDraw:()=>this._drawWorld()});\n    world.camera.mouseLook=false;\n    const st=p||floor.start;\n    this.hero=world.hero({x:mid(st.x),y:mid(st.y),z:0,r:1,half:0,visible:false,fly:true});this.hero.visible=false;this.hero.setSolid(false);world.camera.follow(this.hero);\n    this.camera={x:mid(st.x),y:mid(st.y),yaw:-PI/2+(st.dir||0)*PI/2};this.resetLook();\n    this.lamp=world.light({color:'#ffe0aa',reach:180,power:9,flicker:.025});\n    this.floorLamps=Array.from({length:8},()=>world.light({color:index===1?'#85cce8':'#ffc579',reach:105,power:9,flicker:.04}));\n    this._dress(rows,index);\n    if(!s){\n      const fake={id:'title.warden',type:'enemy',kind:'minotaur',x:5.8,y:2.5,war:90,maxWar:90,spirit:90,maxSpirit:90,phase:1};\n      this._createActor(fake);const a=this.actors.get(fake.id);a.showcase=true;\n      world.thing('dangerEye',mid(3),32.1,0,{color:'#eac983',yaw:0});\n      world.thing('dangerCamp',mid(6),mid(4),0,{});\n      world.shape('dangerPedestal',mid(6),mid(1),0,{});world.thing('dangerTreasure',mid(6),mid(1),12,{open:0});\n    }else this._syncEntities(s);\n    world.camera.fixed={x:this.camera.x,y:this.camera.y,z:EYE,yaw:this.camera.yaw,pitch:this.pitch,fov:72};\n    world.step(1/120);\n  }\n  _dress(rows,index){\n    const w=this.world;\n    this.arches=[];this.seams=[];\n    for(let y=0;y<rows.length;y++)for(let x=0;x<rows[y].length;x++){\n      if(rows[y][x]==='#')continue;\n      const walls=[];for(let d=0;d<4;d++)if(rows[y+DY[d]]?.[x+DX[d]]==='#')walls.push(d);\n      if(walls.length&&((x*7+y*3)%5===0||(!this._state()&&x===1&&y%2===0))){\n        const d=walls[(x+y)%walls.length],lx=mid(x)+DX[d]*14,ly=mid(y)+DY[d]*14;\n        w.thing('dangerLantern',lx,ly,22,{color:index===1?'#a3d6e4':'#ffd397'});this.lanterns.push({x:lx,y:ly,z:28});\n      }\n      if(walls.length===2&&walls[1]===walls[0]+2&&((x+y)%3===0))this.arches.push({x:mid(x),y:mid(y),yaw:walls[0]%2?0:PI/2});\n      if(walls.length>=2&&(x*13+y*7)%11===0){\n        const d=walls[0],px=mid(x)+DX[d]*11+DY[d]*8,py=mid(y)+DY[d]*11-DX[d]*8;\n        w.shape((x+y)%2?'dangerUrn':'barrel',px,py,0,{scale:.63});\n      }\n      if(index===1&&(x+y)%3===0)this.seams.push({x:mid(x),y:mid(y)});\n    }\n    if(this.lanterns.length<5){\n      for(let y=1;y<rows.length-1;y+=2)for(let x=1;x<rows[y].length-1;x+=3)if(rows[y][x]!== '#'&&this.lanterns.length<8){\n        const d=[0,1,2,3].find(d=>rows[y+DY[d]]?.[x+DX[d]]==='#');if(d===undefined)continue;\n        const lx=mid(x)+DX[d]*14,ly=mid(y)+DY[d]*14;w.thing('dangerLantern',lx,ly,22,{color:index===1?'#9dd8ee':'#ffd397'});this.lanterns.push({x:lx,y:ly,z:28});\n      }\n    }\n  }\n  _createActor(e){\n    const E=this.E,w=this.world,k=e.kind,boss=k==='minotaur',scorpion=k==='scorpion',wraith=k==='wraith',brute=k==='brute';\n    let rig=null,blob=null;\n    if(scorpion){blob=new E.Blob({R:4.5,mouth:true,colors:{base:'#527d84',dk:'#294d58',lt:'#83b3b6',eye:'#c1e9ec',pupil:'#17343e'},face:'front'});}\n    if(s)this._drawHands(w.overlay.pen,s,this._player(),settings);\n  }\n  _drawHands(p,s,player,settings){\n    if(!player||player.down)return;\n    const t=this.time,A=this.handAction,u=A?clamp(A.t/.8,0,1):0,motion=settings.reducedMotion?0:1;\n    const recoil=A?.type==='attack'?Math.sin(u*PI*2)*1.4:0,guard=A?.type==='guard'?Math.sin(u*PI)*4:0;\n    const swap=this.handSwap?Math.sin(this.handSwap/.6*PI)*5:0,bob=!settings.reducedMotion&&this.moveTween?Math.sin(t*12)*.22:0;\n    const actionChannel=A?.channel||'war';\n    const defs=(s.content||CONTENT).items;\n    for(const hand of [0,1]){\n      const sign=hand?1:-1,itemId=player.hands?.[hand],instance=s.items?.[itemId],kind=instance?.kind||'',def=defs[kind]||{};\n      const raise=guard+(hand===1?recoil:0),y=sign*(7.5+(swap*.3)),z=-7+bob+raise*.4-swap;\n      p.at(11+(hand===1?recoil:0),y,z,0,1,0,hand===1?-recoil*.05:0);\n      p.tube(-5,sign*2,-5,0,0,0,1.35,'#405349').ball(0,0,0,1.55,1.3,1.1,'#a88a63').box(-2.7,sign*.8,-2.7,2.5,3,2,'#5d6c60');\n      if(/shield/i.test(kind)){\n        p.at(13,y,-4.2+guard*.7-swap,0,1,0,sign*-.12).box(0,0,0,1.1,8,11,'#3c5350').box(.7,0,0,.3,6,9,'#7a927a').tube(1,-3,0,1,3,0,.32,'#cbb579').tube(1,0,-4,1,0,4,.35,'#cbb579').ball(1.1,0,0,.6,1.1,1.1,'#c9b477');\n      }else if(def.ammo||kind==='bow'){\n        p.at(12,y,-3.7-swap,0,1,0,recoil*.06);\n        const draw=A?.type==='attack'?Math.sin(u*PI)*2.5:0;\n        p.tube(0,0,-9,3,0,-5,.55,'#a38148').tube(3,0,-5,4,0,1,.6,'#b99456').tube(4,0,1,2,0,7,.55,'#b99456').tube(2,0,7,-1,0,10,.45,'#96723d')\n          .tube(0,0,-9,-draw,0,0,.08,'#dacda5').tube(-draw,0,0,-1,0,10,.08,'#dacda5');\n        if(player.arrows>0)p.tube(-3-draw,0,0,11,0,0,.12,'#d0b47f').cone(11,0,0,13,0,0,.45,'#a1acaa');\n      }else if(def.channel==='spirit'||/rune/i.test(kind)){\n        p.tube(0,0,-2,2,0,6,.55,'#91794c').ball(2,0,8,1.6,1.3,2.4,'#66afc1').tube(2,-1.3,8,2,1.3,8,.25,'#e1c890').glow(2,0,8,.35+Math.sin(t*2)*.08,'#8ed9ed');\n        if(A?.type==='attack'&&actionChannel==='spirit'&&u<.7)p.glow(4+u*8,0,9,Math.sin(u/.7*PI)*1.2,'#91e5ed');\n      }else if(def.channel==='war'||/blade|throwing/i.test(kind)){\n        p.at(13,y,-3+recoil-swap,0,1,0,-.18-recoil*.1).tube(-1,0,-3,1,0,2,.6,'#645741').tube(1,-2.2,2,1,2.2,2,.4,'#c4a46c').bar(1,0,3,6,0,15,2,.4,'#bcc6b8').cone(6,0,15,7,0,17,1,'#d5ddcd');\n      }else if(def.family==='book'||kind==='scroll'){\n        p.box(2,0,2,6,5,1,'#dfd2a6').box(2,0,1.2,6.6,5.5,.5,'#4f7a8b');\n      }else if(kind){p.ball(2,0,3,1.5,1.5,2,def.family==='potion'?'#9cc3bd':'#c5ab70').tube(2,0,4,2,0,6,.65,'#ddd0b3');}\n      else if(hand===1&&player.basicSpirit&&A?.type==='attack'&&actionChannel==='spirit')p.glow(3,0,3,Math.sin(u*PI)*1.3,'#9ae5f2');\n    }\n  }\n  draw(r){if(this.ready&&this.world)this.world.draw(r);}\n  dispose(){if(this.world)this.world.dispose();this.world=null;this.ready=false;this.actors.clear();this.things.clear();}\n  snapshot(){return{ready:this.ready,renderer:this.rendererName,floor:this.floor?.name,actors:this.actors.size,things:this.things.size,camera:{...this.camera},effects:this.fx.length,native:true};}\n}\n    if (!el) return;\n    // the keyboard's own letters for labels (an AZERTY Z where the code says KeyW), where the browser tells them\n    try { if (navigator.keyboard && navigator.keyboard.getLayoutMap) navigator.keyboard.getLayoutMap().then(m => { this._layout = m; }).catch(() => {}); } catch (e) { /* no layout map */ }\n    if (screen.listeners) screen.listeners.push(() => { if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); });   // a resize or a turn of the phone moves the stick's origin: lift it (a screen of a page's own may have no listeners)\n    const on = (t, type, fn) => t.addEventListener(type, fn, { signal });\n    const typing = e => {\n      const t = e.target; if (!t || !t.tagName) return false;\n      if (t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable) return true;\n      return t.tagName === 'INPUT' && !['range', 'checkbox', 'radio', 'button', 'submit', 'color'].includes(t.type);\n    };\n    on(window, 'keydown', e => {\n      if (typing(e)) return;\n      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n      if (this._codes[e.code] || (share && share.length)) { e.preventDefault(); if (!e.repeat) { if (this._codes[e.code]) this.press(e.code); if (share) for (const q of share) q.press(e.code); } }\n      else if (this._zoomOn && ZOOM_KEYS[e.code] && !e.ctrlKey && !e.metaKey && !e.altKey) { e.preventDefault(); if (!e.repeat) this._zoomAcc *= ZOOM_KEYS[e.code]; }   // - and =, where no action uses them\n    });\n    // the wheel zooms where the game lets it (a mouse's notch 10%; a trackpad's pinch comes as the wheel with ctrlKey);\n    // not over a menu, which scrolls\n    el.addEventListener('wheel', e => {\n      const wc = e.deltaY < 0 ? 'WheelUp' : e.deltaY > 0 ? 'WheelDown' : null;\n      if (wc && this._codes[wc]) { e.preventDefault(); this._tapCode(wc); this.lastDevice = 'mouse'; return; }   // (a wheel bound to an action: a notch taps it, no zoom)\n      if (!this._wheelOn) return; e.preventDefault();\n      const d = e.deltaY * (e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 100 : 1);\n      this._zoomAcc *= clamp(Math.exp(-d * (e.ctrlKey ? .01 : .001)), .8, 1.25); this._zoomPt = this.screenPoint(e.clientX, e.clientY);\n    }, { signal, passive: false });\n    const all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n    on(window, 'keyup', e => all(q => q.release(e.code)));\n    on(window, 'blur', () => all(q => q.clear()));\n    on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });\n    on(el, 'contextmenu', e => e.preventDefault());\n    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { if (this.lastDevice !== 'mouse' && this.lastDevice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\n759:    this.use(map);\n867:  use(map) {\n936:    const real = m.filter(c => !c.startsWith('Act:') && !c.startsWith('PadAxis')), pads = real.filter(padCode), keys = real.filter(c => !padCode(c));\n1176:      if (this.padIndex !== null) { this.padPrev.forEach((on, i) => { if (on) this.release('Pad' + i); }); for (const c of ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight', 'PadRAxisUp', 'Pa [... omitted end of long line]\n1193:      ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight'].forEach((c, i) => dirs[i] ? this.press(c) : this.release(c));\n1290:const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\n1292:const STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\n1306:  PadAxisUp: 'L stick ↑', PadAxisDown: 'L stick ↓', PadAxisLeft: 'L stick ←', PadAxisRight: 'L stick →',\n3993: *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\n9646:  _controls(add) {\n9661:        const codes = I.map[a].filter(c => !c.startsWith('Act:') && !c.startsWith('PadAxis') && padCode(c) === (d === 'pad')), cap = this._cap && this._cap.a === a && this._cap.device === d;\n9721:    if (name === 'controls') this._controls(add);\n11832:  _control(i) {\n11846:    a.update(dt, this._control(0)); b.update(dt, this._control(1)); Fighter.exchange(a, b);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,pathlib\nr={\n'sourceInformation':{\n'date':'2026-11-06 04:02:57','source':'Advanced Dungeons & Dragons: Treasure of Tarmin (1983), Mattel Electronics / APh; program by Tom Loughry.','plan':'PLAN.md','genre':'RPG; tactical dungeon crawler','perspective':'First person; temporary explored automap','tech':'my-3D2dge / World3D v0.89.1 (8ecc2f62353761187bdfe226f327b7ea5d2eb691); three.js 0.182.0; Rapier SIMD compat 0.19.3; AI Hub client 1.4.0 (35a1047f2067b2af3de3943f0fe452f39105d869); browser JavaScript; Bun bundler.','artDirection':'Original procedural pixel-textured stone, lantern-lit volumetric puppets, eye murals and horned machinery, extending native shapes and materials.','animation':'Native Humanoid, Blob, Attack, Combo and World3D pen animation; interpolated grid camera and two visible first-person hands; original species and channel effects.','audio':'Original code-generated score, effects and short gibberish voices; no audio files. Music defaults to 10%.','online':'1–2 shared-world co-op: reliable ordered WebRTC DataChannel with manual offer/answer; AI Hub shared-world protocol including server-only authority. No TURN relay: some NAT/firewall pairs cannot connect. Rendering dependencies are embedded.','testing':'Deterministic rules and a normal-rules complete route; final-HTML headless browser and input checks; two browser peers and official Hub harness. Physical controller, real touch devices, cross-network NAT and human listening unavailable.','research':'Read all 17 pages of the scanned Mattel manual; cross-checked official transcript and publisher history; inspected gameplay excerpt 00:40–01:20 and representative stills. Sound cues documented in the manual; exact original timbres and music unknown. See linked research ledger.','environment':'Codex CLI (headless); Linux','model':'OpenAI, gpt-6.1-sol, reasoning effort max','usage':'added on import'},\n 'testingFeedback':['unknown']*4,\n 'engineFeedback':['World3D turns the same native shapes, materials and articulated rigs into a coherent first-person scene.','unknown','The deterministic two-strength rules, authored campaign, inventory transactions and shared-world authority.','unknown','none','Include a documented single-file first-person example with rendering-free network authority and explicit menu timing.'],\n 'promptFeedback':['The concrete strategic identity, three-floor campaign and explicit treasure-claim ending make the intended game clear.','The plan refers to a different model/context-window size than TASK.md; delivery metadata follows TASK.md.','Keeping complete solo play, native presentation, standalone WebRTC and the Hub lifecycle coherent in one self-contained artifact.','Separate required acceptance checks from optional presentation ideas and supply executable content/session schemas.'],\n 'aiHub':{'name':'Advanced Dungeons and Danger','tagline':'Two strengths. Six slots. No way back.','description':'Enter three lantern-lit vaults where steel and spirit are separate strengths. Read enemy intentions, prepare your six-slot pack, break the Minotaur’s seals and claim the Emberheart, alone or together.','type':'Game','genre':'RPG','source':'Advanced Dungeons & Dragons: Treasure of Tarmin (1983)','series':'Advanced Dungeons & Dragons','players':'1–2','controls':'WASD step; Q/E turn; mouse look; F interact; Enter/left click commit; right click guard; Tab pack; X swap; M map; R retreat; Esc menu. Standard gamepad and assisted touch.','tags':['3d','first-person','co-op','fantasy','exploration','boss fights']}}\npathlib.Path('src/report.json').write_text(json.dumps(r,indent=2,ensure_ascii=False)+'\\\\n')\nPY\ncat > src/main.js <<'EOF'\nimport '../vendor/engine/my-3d2dge-3d.js';\nimport { Model, CONTENT, DEFAULT_TUNING, validateContent } from './core/model.js';\nimport { Network } from './net/network.js';\nimport { DungeonView } from './view/view.js';\nimport { GameAudio } from './audio/audio.js';\nimport { Interface, report } from './ui/interface.js';\n\nconst E=globalThis.My3D2dge;\nconst INPUT={\n  forward:['KeyW','ArrowUp','PadAxisUp'],backward:['KeyS','ArrowDown','PadAxisDown'],strafeLeft:['KeyA','ArrowLeft','PadAxisLeft'],strafeRight:['KeyD','ArrowRight','PadAxisRight'],turnLeft:['KeyQ','Pad4'],turnRight:['KeyE','Pad5'],\n  attack:['Mouse0','Enter','Pad7'],guard:['Mouse2','KeyG','Pad6'],interact:['KeyF','Pad0'],pack:['Tab','KeyI','Pad3'],swap:['KeyX','Pad2'],map:['KeyM','Pad17'],retreat:['KeyR','Pad1'],rest:['KeyH'],use:['KeyU'],inspect:['KeyV'],target:['KeyT'],war:['Digit1'],spirit:['Digit2'],held:['Digit3'],pause:['Escape','KeyP','Pad9'],confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1']\n};\nconst TUNING_KEYS={devPlayerDamage:'playerDamage',devEnemyDamage:'enemyDamage',devMaxWar:'maxWar',devMaxSpirit:'maxSpirit',devRationWar:'rationWar',devRationSpirit:'rationSpirit',devPlanning:'planningSeconds',devTempo:'tempo'};\nconst settings=[{key:'music',value:.10},{key:'effects',value:.65},{key:'volume',value:.70},{key:'glyphs',value:'playstation'},\n  {key:'voice',label:'Creature voices',group:'Sound',type:'slider',value:.35,min:0,max:1,step:.05},\n  {key:'reducedMotion',label:'Reduced motion',group:'Comfort',value:false,help:'No walking bob, strong shake or sweeping transitions.'},\n  {key:'uiScale',label:'Interface scale',group:'Display',type:'slider',value:1,min:.8,max:1.35,step:.05},\n  {key:'lookSensitivity',label:'Look sensitivity',group:'Controller',type:'slider',value:1,min:.3,max:2,step:.1},\n  {key:'touchAssist',label:'Touch assistance',group:'Touch',value:true,help:'Select the vulnerable channel and offer contextual actions.'},\n  {key:'devPlayerDamage',label:'Player damage ×',type:'slider',value:1,min:.25,max:3,step:.05},\n  {key:'devEnemyDamage',label:'Enemy damage ×',type:'slider',value:1,min:.25,max:3,step:.05},\n  {key:'devMaxWar',label:'Base / maximum War',type:'slider',value:36,min:12,max:120,step:1},\n  {key:'devMaxSpirit',label:'Base / maximum Spirit',type:'slider',value:24,min:12,max:120,step:1},\n  {key:'devRationWar',label:'War per ration',type:'slider',value:8,min:1,max:24,step:1},\n  {key:'devRationSpirit',label:'Spirit per ration',type:'slider',value:5,min:1,max:24,step:1},\n  {key:'devPlanning',label:'Co-op planning seconds',type:'slider',value:8,min:2,max:30,step:1},\n  {key:'devTempo',label:'Animation tempo ×',type:'slider',value:1,min:.25,max:3,step:.05}\n];\nclass Expedition{\n  constructor(){this.game=null;this.ui=null;this.view=null;this.audio=null;this.stage='boot';this.state=null;this.attract=false;this.attractModel=null;this.lastInput='keyboard';this.lastActivity=performance.now();this.inputCooldown=0;this.persistence=false;this._saved=null;this._lastSaveTick=-1;this._lastSaveTime=0;this._lastPhase='';this._lastFloor=-1;this._replay=[];this.devReveal=false;this.finishedDismissed=false;this.hidden=false;this._restoreTuning=false;\n    this.net=new Network({onState:s=>this.onState(s),onStatus:s=>this.onStatus(s),onMode:()=>{},onStart:()=>this.onStart(),onEnd:r=>this.onEnd(r),onCommandResult:(r,a)=>this.result(r,a)});\n  }\n  get player(){return this.state?.players?.[this.net.localId]||Object.values(this.state?.players||{}).find(p=>p.connected)||null;}\n  get online(){return this.net.mode\"'!=='\"'solo';}\n  async boot(){const hub=await this.net.initHub();if(this.net.server){this.stage='server';document.getElementById('boot').hidden=true;document.getElementById('server-status').hidden=false;this.net.ready();this.expose();return;}\n    this.game=new E.Game({id:'advanced-dungeons-and-danger-v1',canvas:'screen',res:'wide',expand:true,bg:null,input:INPUT,autoPause:false,corner:false,fullscreen:false,touch:false,backGesture:false,menu:{quit:false,controls:{forward:'Step forward',backward:'Step back',strafeLeft:'Strafe left',strafeRight:'Strafe right',turnLeft:'Quarter-turn left',turnRight:'Quarter-turn right',attack:'Commit selected action',guard:'Guard',interact:'Interact',pack:'Open pack',swap:'Swap hands',map:'Explored map',retreat:'Retreat',rest:'Rest',use:'Use held object',target:'Next target',war:'Select basic War',spirit:'Select Spirit spark',held:'Select right hand'} ,settings}});\n    this.game.input.touchEnabled=false;this.game.input.glyphs='playstation';this.audio=new GameAudio(this.game);this.ui=new Interface(this);this.ui.shell._o.screens.settings.rows=['#Expedition comfort','uiScale','reducedMotion','touchAssist'];\n    // Developer rows belong to the developer screen, outside ordinary preferences.\n    const nativeSettings=this.ui.shell._settingsRows.bind(this.ui.shell);this.ui.shell._settingsRows=add=>{const S=this.game.settings;for(const group of ['Sound','Display','Comfort','Controller','Touch']){const keys=S.keys(group).filter(k=>\"'!k.startsWith('\"'dev')&&\"'!['\"'fps','frameRate','pixelScale','filter','filter3d','fullscreen','touchButtons','touchSide'].includes(k));if(\"'!keys.length)continue;add(this.ui.shell._el('\"'div','esh-k esh-sec',group));for(const k of keys)add(this.ui.shell._row(k));}};\n    this.game.settings.onChange=(k,v)=>{document.documentElement.style.setProperty('--ui',this.game.settings.uiScale||1);if(k==='reducedMotion')this.game.settings.set('motion',v);if(TUNING_KEYS[k]&&\"'!this._restoreTuning&&this.stage==='\"'play'&&this.net.mode==='solo'){this.net.model?.setTuning({[TUNING_KEYS[k]]:v});this.onState(this.net.model.state);}if(k==='glyphs')this.ui.lastHUD='';};document.documentElement.style.setProperty('--ui',this.game.settings.uiScale||1);\n    this.view=new DungeonView(this.game,{getState:()=>this.stage==='title'?null:this.state,getPlayer:()=>this.player,getSettings:()=>this.game.settings});await this.view.init();\n    this.game.debug={snapshot:()=>({stage:this.stage,renderer:this.view.rendererName,state:this.state,view:this.view.snapshot()})};\n    this.game.start({scene:'main',scenes:{main:{pausable:false,touch:[],camera:{zoom:false},update:dt=>this.update(dt),draw:r=>this.view.draw(r)}}});\n    this.game.hook('input',()=>this.checkAttractPad());this.bindEvents();this.expose();document.getElementById('boot').hidden=true;\n    if(hub){this.stage='play';this.ui.hide();this.state=this.net.state;this.net.ready();}else{this.readSaved();this.stage='title';this.ui.title();}this.lastActivity=performance.now();\n  }\n  expose(){globalThis.__DANGER={app:this,game:this.game,net:this.net,ui:this.ui,view:this.view,audio:this.audio,Model,CONTENT,report,send:a=>this.send(a),newSolo:()=>this.newSolo(false),snapshot:()=>this.net.model?.snapshot()||this.state,logical:(a)=>this.game?.input.tap(a),setIdle:ms=>{this.lastActivity=performance.now()-ms},attractStep:ms=>this.attractStep(ms),stop:()=>this.dispose()};globalThis.__gameReady=true;}\n  onStart(){if(this.stage==='boot')return;this.stage='play';this.attract=false;this.attractModel=null;this.ui?.hide();this.state=this.net.state;this._lastPhase='';this._lastFloor=-1;this.finishedDismissed=false;this.ui?.notice(this.online?'Two lanterns, one descent':'The lantern is lit','Keep both strengths alive. Read each intention before committing.');}\n  onState(s){if(this.attract)return;this.state=s;if(this.stage==='play'&&this.net.mode==='solo'&&s?.phase==='explore'&&this.net.model&&s.tick\"'!==this._lastSaveTick&&performance.now()-this._lastSaveTime>1500)this.saveCheckpoint();}\n  onStatus(s){if(this.ui?.shell.screen==='\"'invite'){this.ui.invite.status=s;this.ui.statusInvite();}const out=document.getElementById('server-status');if(out&&this.net.server)out.textContent=s;}\n  onEnd(reason){this.audio?.stop();if(this.stage==='title'||this.stage==='boot')return;this.ui?.hide();this.stage='ended';const e=document.getElementById('session-ended');e.hidden=false;e.querySelector('p').textContent=reason;e.querySelector('button').hidden=this.net.mode==='hub';}\n  readSaved(){try{const raw=localStorage.getItem('danger-expedition-v1');if(raw){const parsed=JSON.parse(raw),m=new Model();if(m.load(parsed).ok)this._saved=parsed;else this._saved=null;}const probe='danger-storage-probe';localStorage.setItem(probe,'1');this.persistence=localStorage.getItem(probe)==='1';localStorage.removeItem(probe);}catch{this.persistence=false;this._saved=null;}return this._saved;}\n  saved(){return this._saved;}\n  saveCheckpoint(){if(this.net.mode\"'!=='\"'solo'||\"'!this.net.model||this.attract||this.state?.phase!=='\"'explore')return false;const save=this.net.model.exportSave();if(this.state.content)save.content=this.state.content;this._saved=save;this._lastSaveTick=this.state.tick;this._lastSaveTime=performance.now();try{const raw=JSON.stringify(save);localStorage.setItem('danger-expedition-v1',raw);this.persistence=localStorage.getItem('danger-expedition-v1')===raw;}catch{this.persistence=false;}return this.persistence;}\n  newSolo(tutorial=true){this.stopAttract(false);this.stage='play';this._lastSaveTick=-1;this._lastPhase='';this._lastFloor=-1;this.finishedDismissed=false;document.getElementById('session-ended').hidden=true;this.net.startSolo();this.state=this.net.state;this.ui.hide();this.saveCheckpoint();this.view?.resetLook();if(tutorial)this.ui.show('briefing',{kicker:'The Lantern Vault · first descent',title:'Keep both fires burning.',text:'▰ WAR is your body. ◇ SPIRIT is your resolve. Either empty pool brings you down.\\\\n\\\\nRead each creature’s next blow. Prepare the right hand. Combat waits until you commit. A ration restores both strengths when you are safe.',actions:[['Enter the vault',()=>this.ui.hide()],['Learn the controls',()=>this.ui.help()]]});this.syncPause();}\n  continueSolo(){if(\"'!this._saved)return;try{this.stopAttract(false);this.stage='\"'play';if(this._saved.content){this.net.startSolo();this.net.model=new Model({content:this._saved.content});const r=this.net.model.load(this._saved);if(\"'!r.ok)throw Error(r.message);this.net.state=this.net.model.state;this.net._run=this.net.state.runId;this.net._emit();}else this.net.startSolo(this._saved);this.state=this.net.state;this._lastPhase='\"'';this._lastFloor=-1;this.finishedDismissed=false;this.ui.hide();}catch(e){this.ui.notice('Save could not be restored',e.message);this.returnTitle();}}\n  returnTitle(){if(this.net.mode==='hub'&&\"'!this.net.ended)return;this.saveCheckpoint();this.stopAttract(false);this.net.close();this.state=null;this.stage='\"'title';this._lastPhase='';this.audio?.stop();this.ui?.title();this.lastActivity=performance.now();this.unlockPointer();document.getElementById('session-ended').hidden=true;}\n  retry(){if(this.net.mode\"'!=='\"'solo')return;const r=this.net.model?.retry();if(r?.ok){this.net.state=this.net.model.state;this.state=this.net.state;this.stage='play';this.finishedDismissed=false;this._lastPhase='';this.ui.hide();this.saveCheckpoint();}else this.ui.notice('Checkpoint unavailable',r?.message||'Start a fresh expedition.');}\n  syncPause(){this.net.paused=this.net.mode==='solo'&&(this.hidden||\"'!!this.ui?.shell.screen)&&this.stage==='\"'play';if(this.ui?.shell.screen)this.unlockPointer();}\n  unlockPointer(){if(document.pointerLockElement)document.exitPointerLock?.();}\n  send(a){if(this.attract)return null;if(this.stage\"'!=='\"'play'||this.net.ended)return{ok:false,message:'No active expedition.'};this._replay.push({tick:this.state?.tick,action:structuredClone(a)});if(this._replay.length>3000)this._replay.shift();const r=this.net.send(a);if(r&&typeof r.ok==='boolean')this.result(r,a);this.state=this.net.state;this.ui.lastHUD='';return r;}\n  result(r,a){if(\"'!r||!this.ui)return;if(r.full){this.ui.fullPack(r.target||a.target);return;}if(r.confirm){if(r.action)this.ui.confirm('\"'Commit this action?',r.message,()=>{this.ui.hide();this.send(r.action);});else if(r.target)this.ui.entity(this.state.entities[r.target]);return;}if(\"'!r.ok)this.ui.notice('\"'Hold your hand',r.message);else if(r.waiting)this.ui.notice('Ready to descend',r.message);else if(a.type==='pickup'||a.type==='use')this.ui.notice(a.type==='pickup'?'Object secured':'Prepared',r.message);}\n  dev(action){if(this.net.mode\"'!=='\"'solo'){this.ui.notice('Read-only online','Developer mutations are disabled in network expeditions.');return;}const map={floor:'jump',item:'spawn',invulnerability:'invulnerable'};const a={...action,type:map[action.type]||action.type};if(a.type==='invulnerable')a.value=action.enabled;const r=this.net.model.dev(a);this.net.state=this.net.model.state;this.onState(this.net.state);this.ui.notice(r.ok?'Developer tool applied':'Tool rejected',r.message);this.ui.lastHUD='';}\n  devStep(){if(this.net.mode\"'!=='\"'solo')return;this.net.model.dev({type:'step',ms:1000});this.onState(this.net.model.state);}\n  resetTuning(){if(this.net.mode\"'!=='\"'solo')return;this._restoreTuning=true;for(const[k,v]of Object.entries(TUNING_KEYS))this.game.settings.set(k,DEFAULT_TUNING[v]);this._restoreTuning=false;this.net.model.setTuning({...DEFAULT_TUNING});this.onState(this.net.model.state);this.ui.dev();}\n  startContent(content){if(this.online)return;const check=validateContent(content);if(\"'!check.ok){this.ui.notice('\"'Campaign rejected',check.errors.join('; '));return;}this.newSolo(false);this.net.model=new Model({content,seed:1983,runId:'workshop-'+Date.now()});this.net.model.state.content=structuredClone(content);this.net.model.state.modified=true;this.net.state=this.net.model.state;this.net._run=this.net.state.runId;this.net._emit();this.state=this.net.state;this.ui.hide();}\n  download(name,text){const blob=new Blob([text],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\n  exportSave(diagnostic=false){if(this.online){this.ui.notice('Network expedition','Network state does not become a solo continuation.');return;}const save=this.net.model?.exportSave()||this._saved;if(\"'!save){this.ui.notice('\"'Nothing to save','Begin an expedition first.');return;}this.download(diagnostic?'danger-state-replay.json':'danger-expedition.json',JSON.stringify(diagnostic?{...save,replay:this._replay}:save,null,2));}\n  pickJSON(){return new Promise(resolve=>{const f=document.createElement('input');f.type='file';f.accept='.json,application/json';let done=false;const finish=x=>{if(done)return;done=true;resolve(x);f.remove();};f.onchange=async()=>{try{if(\"'!f.files?.[0])return finish(null);if(f.files[0].size>500000)return this.ui.notice('\"'Import rejected','File exceeds 500 KB.'),finish(null);finish(JSON.parse(await f.files[0].text()));}catch(e){this.ui.notice('Import rejected',e.message);finish(null);}};f.oncancel=()=>finish(null);f.style.display='none';document.body.append(f);f.click();});}\n  async importSave(){const data=await this.pickJSON();if(\"'!data)return;const m=new Model(data.content?{content:data.content}:{}),r=m.load(data);if(!r.ok){this.ui.notice('\"'Import rejected',r.message);return;}this._saved=data;this.continueSolo();this.ui.notice('Expedition imported','Your versioned save is restored.');}\n  meaningful(type,event){if(this.attract){event?.preventDefault();event?.stopImmediatePropagation();this.stopAttract();return true;}this.lastActivity=performance.now();this.lastInput=type;this.game&&(this.game.input.lastDevice=type==='gamepad'?'gamepad':type);if(event?.isTrusted)this.audio?.unlock();return false;}\n  bindEvents(){const c=document.getElementById('screen');document.addEventListener('keydown',e=>{if(this.meaningful('keyboard',e))return;},true);document.addEventListener('pointerdown',e=>{this.meaningful(e.pointerType==='touch'?'touch':'mouse',e);},true);document.addEventListener('wheel',e=>this.meaningful('mouse',e),{capture:true,passive:false});let mouse={x:0,y:0};document.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'mouse')return;if(Math.hypot(e.clientX-mouse.x,e.clientY-mouse.y)>5){this.lastActivity=performance.now();mouse={x:e.clientX,y:e.clientY};}if(this.stage==='play'&&\"'!this.ui.isOpen&&(document.