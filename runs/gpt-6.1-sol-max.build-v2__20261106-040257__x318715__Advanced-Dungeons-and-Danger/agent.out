ished\n\t\t)\n\t\t\treturn;\n\t\tconst t = now();\n\t\tthis.model.advance(Math.max(0, t - this._lastTick));\n\t\tthis._lastTick = t;\n\t\tthis.state = this.model.state;\n\t}\n\n\t_reject() {\n\t\tthis._traffic.rejected++;\n\t}\n\t_receive(packet, from) {\n\t\tif (\n\t\t\tthis.ended ||\n\t\t\t!plain(packet) ||\n\t\t\tpacket.v !== VERSION ||\n\t\t\tpacket.game !== GAME ||\n\t\t\tpacket.run !== this._run ||\n\t\t\t!Number.isSafeInteger(packet.s) ||\n\t\t\tpacket.s < 1 ||\n\t\t\ttypeof packet.kind !== \"string\" ||\n\t\t\tbyteSize(packet) > MAX_PACKET\n\t\t) {\n\t\t\tthis._reject();\n\t\t\treturn;\n\t\t}\n\t\tconst allowedSender =\n\t\t\tthis.mode === \"hub\"\n\t\t\t\t? this.isHost\n\t\t\t\t\t? this._participants.some((player) => player.id === from)\n\t\t\t\t\t: from === this._hubHost\n\t\t\t\t: from === (this.isHost ? \"1\" : \"0\");\n\t\tif (!allowedSender) {\n\t\t\tthis._reject();\n\t\t\treturn;\n\t\t}\n\t\tif (packet.s <= (this._seen.get(from) ?? 0)) {\n700:\t\t\tthis._call(\"onCommandResult\", result, action);\n822:\t\t\t\t\t\t\"onCommandResult\",\nls: cannot access 'evidence/release*': No such file or directory\n","exit_code":2,"status":"failed"}}
