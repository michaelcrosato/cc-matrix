 file of ['node_modules/three/LICENSE','node_modules/@dimforge/rapier3d-simd-compat/LICENSE'])if(fs.existsSync(file))licenses+='\\\\n\\\\n'+file+'\\\\n'+fs.readFileSync(file,'utf8');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\\\\n<script>\"'${esc(session)}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\\\">\\\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"10\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Descend three vaults, defeat the Minotaur and claim the Emberheart together.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"WASD step; Q/E turn; F interact; Enter commit; Tab pack; M map. Standard pad: left stick move, shoulders turn, Cross interact, R2 commit, Triangle pack, Square swap, Options menu.\\\">\\\\n<meta name=\\\"description\\\" content=\\\"Two strengths. Six slots. No way back. A complete first-person tactical dungeon expedition for one or two adventurers.\\\">\\\\n<title>\"'${config.title}</title><style>${css}</style></head><body>'\"\\\\n<div id=\\\"stage\\\"><canvas id=\\\"view\\\" aria-hidden=\\\"true\\\"></canvas><canvas id=\\\"screen\\\" aria-label=\\\"First person dungeon view\\\"></canvas></div><div id=\\\"ambience\\\"></div>\\\\n<div id=\\\"boot\\\"><div class=\\\"sigil\\\">◇</div><h1>Lighting the lantern</h1><p>Preparing stone, steel and spirit…</p><progress></progress></div>\\\\n<div id=\\\"attract-banner\\\" hidden>THE VAULT REMEMBERS · press any button to return</div>\\\\n<div id=\\\"server-status\\\" hidden>Authoritative expedition · no local adventurer</div>\\\\n<div id=\\\"session-ended\\\" hidden><h2>The expedition has ended.</h2><p></p><button id=\\\"ended-title\\\" class=\\\"hud-button\\\">Return to title</button></div>\\\\n<script type=\\\"application/json\\\" id=\\\"game-credits\\\">\"'${esc(JSON.stringify(report))}</script>'\"\\\\n<script type=\\\"text/plain\\\" id=\\\"dependency-licenses\\\">\"'${esc(licenses)}</script>'\"\\\\n<script>\"'${esc(core)}</script>'\"\\\\n<script>\"'${esc(bundle)}</script>'\"\\\\n</body></html>\"'`;\nconst out=path.join(root,'\"'..',config.html);fs.writeFileSync(out,html);fs.copyFileSync('src/report.json',path.join(root,'..','exit-interview.json'));\nfs.writeFileSync('build/artifact.json',JSON.stringify({file:out,bytes:Buffer.byteLength(html),built:new Date().toISOString()},null,2));\nconsole.log(\"'`Built ${config.html} (${(Buffer.byteLength(html)/1024/1024).toFixed(2)} MiB; all runtime dependencies embedded)`);\n}finally{if(original!==null)fs.writeFileSync('\"'src/content/campaign.js',original);}\nEOF\nnpm run build\"","aggregated_output":"142:const CSS_NAMES = { black: '000', white: 'fff', red: 'f00', lime: '0f0', green: '008000', blue: '00f', yellow: 'ff0', cyan: '0ff', aqua: '0ff', magenta: 'f0f', fuchsia: 'f0f', gray: '808080', grey: '8 [... omitted end of long line]\n2311:   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n2328:   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n2396:     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n2546:  menu(name, o) {\n2950:    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\nnpm notice run advanced-dungeons-and-danger@1.0.0 build\nnpm notice run node tools/build.mjs\nBuilt Advanced-Dungeons-and-Danger-Advanced-Dungeons-and-Dragons-Treasure-of-Tarmin-1983-gpt-6.1-sol-max-20261106-040257.html (4.73 MiB; all runtime dependencies embedded)\n","exit_code":0,"status":"completed"}}
