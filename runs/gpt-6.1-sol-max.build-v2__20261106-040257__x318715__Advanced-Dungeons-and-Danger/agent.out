{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tools/verify.mjs');s=p.read_text();s=s.replace(\\\"const h=fs.readFileSync(artifact,'utf8');return \"'!/<script[''^>]+src=/.test(h)&&!/<link[''^>]+href=/.test(h)&&!/<script[''^>]*type='\"\\\\\\\"module\\\\\\\"/.test(h);\\\", \\\"const h=fs.readFileSync(artifact,'utf8').replace(/<script\\\\\\\\b[\"'^>]*>['\"\\\\\\\\s\\\\\\\\S]*?<\\\\\\\\/script>/gi,m=>m.slice(0,m.indexOf('>')+1)+'</script>');return \"'!/<script[''^>]+src=/.test(h)&&!/<link[''^>]+href=/.test(h)&&!/<script[''^>]*type='\"\\\\\\\"module\\\\\\\"/.test(h);\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"if(I.down(act)){this.moveRelative(d)\\\",\\\"if(I.pressed(act)||I.down(act)){this.moveRelative(d)\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
