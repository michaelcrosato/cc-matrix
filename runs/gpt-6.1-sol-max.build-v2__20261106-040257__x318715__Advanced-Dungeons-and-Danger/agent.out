{"type":"item.completed","item":{"id":"item_160","type":"command_execution","command":"/bin/bash -lc \"sed -n '913,1020p' src/ui/interface.js && sed -n '1103,1126p' src/ui/interface.js && sed -n '127,175p' src/main.js && sed -n '522,540p' src/main.js\"","aggregated_output":"\t\t\t\t\"Spend 1 ration. Restore at least \" +\n\t\t\t\t\tMath.ceil(q.maxWar * 0.3) +\n\t\t\t\t\t\" War and \" +\n\t\t\t\t\tMath.ceil(q.maxSpirit * 0.3) +\n\t\t\t\t\t\" Spirit; preserve any higher remaining value.\",\n\t\t\t\t() => {\n\t\t\t\t\tthis.hide();\n\t\t\t\t\tthis.command({ type: \"revive\", target: q.id });\n\t\t\t\t},\n\t\t\t\t\"Share one ration\",\n\t\t\t);\n\t\telse\n\t\t\tthis.notice(\n\t\t\t\t\"No fallen ally in reach\",\n\t\t\t\t\"Move within one tile of your companion.\",\n\t\t\t);\n\t}\n\tcoop() {\n\t\tthis.show(\"coop\", {\n\t\t\tkicker: \"One vault · two first-person views\",\n\t\t\ttitle: \"Bring a second lantern\",\n\t\t\ttext: \"Connect two browsers with invitation codes. Each adventurer keeps a personal pack; the dungeon and its decisions are shared. A direct connection requires reachable network peers. No relay is supplied.\",\n\t\t\tactions: [\n\t\t\t\t[\"Host an expedition\", () => this.host()],\n\t\t\t\t[\"Join an expedition\", () => this.join()],\n\t\t\t\t[\"How co-op works\", () => this.help()],\n\t\t\t\t[\"Back\", () => this.shell.back()],\n\t\t\t],\n\t\t});\n\t}\n\tasync host() {\n\t\tthis.invite = {\n\t\t\trole: \"host\",\n\t\t\tstatus: \"Gathering a direct invitation…\",\n\t\t\toutput: \"\",\n\t\t\tinput: \"\",\n\t\t};\n\t\tthis.inviteScreen();\n\t\ttry {\n\t\t\tconst code = await this.app.net.host();\n\t\t\tif (this.invite.role !== \"host\") return;\n\t\t\tthis.invite.output = code;\n\t\t\tthis.invite.status =\n\t\t\t\t\"Give the offer to your companion. Paste their answer below, then connect.\";\n\t\t\tthis.inviteScreen();\n\t\t} catch (e) {\n\t\t\tthis.invite.status = e.message;\n\t\t\tthis.inviteScreen();\n\t\t}\n\t}\n\tjoin() {\n\t\tthis.invite = {\n\t\t\trole: \"guest\",\n\t\t\tstatus: \"Paste the host’s offer. Then create an answer and send it back.\",\n\t\t\toutput: \"\",\n\t\t\tinput: \"\",\n\t\t};\n\t\tthis.inviteScreen();\n\t}\n\tasync joinAnswer() {\n\t\tthis.captureInvite();\n\t\ttry {\n\t\t\tthis.invite.status = \"Gathering your answer…\";\n\t\t\tthis.statusInvite();\n\t\t\tconst code = await this.app.net.join(this.invite.input);\n\t\t\tthis.invite.output = code;\n\t\t\tthis.invite.status =\n\t\t\t\t\"Return this answer to the host. Waiting for the reliable data channel…\";\n\t\t\tthis.inviteScreen();\n\t\t} catch (e) {\n\t\t\tthis.invite.status = e.message;\n\t\t\tthis.statusInvite();\n\t\t}\n\t}\n\tasync acceptAnswer() {\n\t\tthis.captureInvite();\n\t\ttry {\n\t\t\tawait this.app.net.accept(this.invite.input);\n\t\t\tthis.invite.status = \"Connecting and checking expedition version…\";\n\t\t\tthis.statusInvite();\n\t\t} catch (e) {\n\t\t\tthis.invite.status = e.message;\n\t\t\tthis.statusInvite();\n\t\t}\n\t}\n\tcaptureInvite() {\n\t\tconst t = this.shell.root.querySelector(\"#invite-input\");\n\t\tif (t) this.invite.input = t.value;\n\t}\n\tstatusInvite() {\n\t\tconst e = this.shell.root.querySelector(\".connection-status\");\n\t\tif (e) e.textContent = this.invite.status;\n\t}\n\tinviteScreen() {\n\t\tconst host = this.invite.role === \"host\";\n\t\tthis.show(\"invite\", {\n\t\t\tkicker: \"Direct WebRTC · no camera or microphone\",\n\t\t\ttitle: host ? \"Carry the first lantern\" : \"Carry the second lantern\",\n\t\t\ttext: host\n\t\t\t\t? \"1. Copy your offer to your companion.  2. They return an answer.  3. Paste it below and connect.\"\n\t\t\t\t: \"1. Paste the host’s offer.  2. Create your answer.  3. Send the answer to the host. The expedition starts when both browsers connect.\",\n\t\t\tactions: [\n\t\t\t\t...(host\n\t\t\t\t\t? [\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlabel: \"Connect using answer\",\n\t\t\t\t\t\t\t\tdisabled: !this.invite.output,\n\t\t\t\t\t\t\t\tfn: () => this.acceptAnswer(),\n\t\t\tactions:\n\t\t\t\tthis.app.net.mode === \"hub\"\n\t\t\t\t\t? [[\"View expedition record\", () => this.credits()]]\n\t\t\t\t\t: this.online\n\t\t\t\t\t\t? [[\"End this expedition\", () => this.app.returnTitle()]]\n\t\t\t\t\t\t: [\n\t\t\t\t\t\t\t\t[\"Retry from floor entrance\", () => this.app.retry()],\n\t\t\t\t\t\t\t\t[\"Begin a fresh expedition\", () => this.app.newSolo()],\n\t\t\t\t\t\t\t\t[\"Return to title\", () => this.app.returnTitle()],\n\t\t\t\t\t\t\t],\n\t\t});\n\t}\n\tdev() {\n\t\tconst s = this.state;\n\t\tif (!s) return;\n\t\tconst scored = this.app.net.mode === \"hub\";\n\t\tthis.show(\"dev\", {\n\t\t\tkicker: scored\n\t\t\t\t? \"Scored session · read-only diagnostics\"\n\t\t\t\t: \"Developer mode · modified runs are marked\",\n\t\t\ttitle: \"The lantern behind the walls\",\n\t\t\ttext: scored\n\t\t\t\t? \"The session owns the clock and balance. No developer mutation is allowed.\"\n\t\t\t\t: \"Tools operate on the same state and command handlers as normal play. Changes mark this expedition as modified.\",\n\t\tmin: 12,\n\t\tmax: 120,\n\t\tstep: 1,\n\t},\n\t{\n\t\tkey: \"devMaxSpirit\",\n\t\tlabel: \"Base / maximum Spirit\",\n\t\ttype: \"slider\",\n\t\tvalue: 24,\n\t\tmin: 12,\n\t\tmax: 120,\n\t\tstep: 1,\n\t},\n\t{\n\t\tkey: \"devRationWar\",\n\t\tlabel: \"War per ration\",\n\t\ttype: \"slider\",\n\t\tvalue: 8,\n\t\tmin: 1,\n\t\tmax: 24,\n\t\tstep: 1,\n\t},\n\t{\n\t\tkey: \"devRationSpirit\",\n\t\tlabel: \"Spirit per ration\",\n\t\ttype: \"slider\",\n\t\tvalue: 5,\n\t\tmin: 1,\n\t\tmax: 24,\n\t\tstep: 1,\n\t},\n\t{\n\t\tkey: \"devPlanning\",\n\t\tlabel: \"Co-op planning seconds\",\n\t\ttype: \"slider\",\n\t\tvalue: 8,\n\t\tmin: 2,\n\t\tmax: 30,\n\t\tstep: 1,\n\t},\n\t{\n\t\tkey: \"devTempo\",\n\t\tlabel: \"Animation tempo ×\",\n\t\ttype: \"slider\",\n\t\tvalue: 1,\n\t\tmin: 0.25,\n\t\tmax: 3,\n\t\tstep: 0.05,\n\t},\n\t\tthis._lastFloor = -1;\n\t\tthis.finishedDismissed = false;\n\t\tdocument.getElementById(\"session-ended\").hidden = true;\n\t\tthis.net.startSolo();\n\t\tthis.state = this.net.state;\n\t\tthis.ui.hide();\n\t\tthis.saveCheckpoint();\n\t\tthis.view?.resetLook();\n\t\tif (tutorial)\n\t\t\tthis.ui.show(\"briefing\", {\n\t\t\t\tkicker: \"The Lantern Vault · first descent\",\n\t\t\t\ttitle: \"Keep both fires burning.\",\n\t\t\t\ttext: \"▰ WAR is your body. ◇ SPIRIT is your resolve. Either empty pool brings you down.\\n\\nRead each creature’s next blow. Prepare the right hand. Combat waits until you commit. A ration restores both strengths when you are safe.\",\n\t\t\t\tactions: [\n\t\t\t\t\t[\"Enter the vault\", () => this.ui.hide()],\n\t\t\t\t\t[\"Learn the controls\", () => this.ui.help()],\n\t\t\t\t],\n\t\t\t});\n\t\tthis.syncPause();\n","exit_code":0,"status":"completed"}}
