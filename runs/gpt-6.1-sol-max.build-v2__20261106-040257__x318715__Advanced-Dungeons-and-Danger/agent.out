{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"npm run build\n/home/micha/.local/share/pipx/venvs/playwright/bin/python -u - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--use-angle=swiftshader','--enable-unsafe-swiftshader'])\n page=b.new_page(viewport={'width':1280,'height':720});page.add_init_script(\\\"window.__pad=null;Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});window.pad=(button=-1)=>window.__pad={id:'DualSense standard emulation',index:0,mapping:'standard',connected:true,timestamp:performance.now(),axes:[0,0,0,0],buttons:Array.from({length:18},(_,i)=>({pressed:i===button,touched:i===button,value:i===button?1:0}))};\\\")\n page.on('pageerror',lambda e:print('ERROR',e));page.on('console',lambda m:print('CONSOLE',m.text) if m.type=='error' else None)\n page.goto(next(Path('..').glob('Advanced-*.html')).resolve().as_uri()+'?backend=webgl');page.wait_for_function('window.__gameReady',timeout=60000)\n def snap(label):print(label,page.evaluate('({stage:__app.stage,menu:__app.ui.shell.screen,pause:__app.game.paused,live:__app.game.live,run:__app.net.running,netpause:__app.net.paused,p:__app.player,errors:__app.game.errors,held:[...__app.game.input.held],map:__app.game.input.map.forward})'))\n page.evaluate('pad(0)');page.wait_for_timeout(120);page.evaluate('pad()');page.wait_for_timeout(100);snap('after new')\n page.evaluate('pad(0)');page.wait_for_timeout(120);page.evaluate('pad()');page.wait_for_timeout(100);snap('after brief')\n page.evaluate('window.__pad=null');page.wait_for_timeout(100);page.evaluate('pad()');page.wait_for_timeout(100)\n page.keyboard.press('w');page.wait_for_timeout(300);snap('after W')\n page.keyboard.press('e');page.wait_for_timeout(300);snap('after E')\n page.keyboard.press('Escape');page.wait_for_timeout(300);snap('after Esc')\n page.screenshot(path='evidence/diagnose.png');b.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
