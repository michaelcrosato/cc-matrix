)\ns=s.replace(\\\"a.keyboard.press('w');a.wait_for_function('__app.player.y===8')\\\", \\\"send(a,{'type':'move','dx':0,'dy':-1});a.wait_for_function('__app.player.y===8')\\\")\ns=s.replace(\\\"b.keyboard.press('q');a.wait_for_function('__app.state.players[\\\\\\\"1\\\\\\\"].dir===0')\\\", \\\"send(b,{'type':'turn','delta':-1});a.wait_for_function('__app.state.players[\\\\\\\"1\\\\\\\"].dir===0')\\\")\ns=s.replace(\\\"check('guest keyboard intent reaches authority'\\\", \\\"check('guest logical input reaches authority'\\\")\n# Real session route in a single browser task retains its own authority clock.\nold=\\\"\\\"\\\"        for entry in actions:\n            r=send(frame,entry['action'])\n            if not r or not r.get('ok'):raise RuntimeError('Hub route rejected '+str(entry['action'])+' '+str(r))\n            accepted+=1\\\"\\\"\\\"\nnew=\\\"\\\"\\\"        accepted=frame.evaluate('''entries=>{__app.game.stop();let n=0;for(const e of entries){const r=__DANGER.send(e.action);if(\"'!r?.ok)throw Error('\"'Hub route '+JSON.stringify(e.action)+' '+JSON.stringify(r));n++;}__app.update(0);__app.game.start();return n;}''',actions)\\\"\\\"\\\"\ns=s.replace(old,new)\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"if(event?.isTrusted)this.audio?.unlock();\\\", \\\"if(event?.isTrusted&&this.stage\"'!=='\"'ended')this.audio?.unlock();\\\")\ns=s.replace(\\\"this.finishedDismissed=false;this.ui?.notice(this.online?\\\", \\\"this.finishedDismissed=false;this.syncTuningSliders();this.ui?.notice(this.online?\\\")\ns=s.replace(\\\"  onState(s){\\\", \\\"  syncTuningSliders(){if(\"'!this.game||!this.state)return;this._restoreTuning=true;for(const[k,v]of Object.entries(TUNING_KEYS))this.game.settings.set(k,this.state.tuning[v]);this._restoreTuning=false;}'\"\\\\n  onState(s){\\\")\ns=s.replace(\\\"const p=document.createElement('p');p.textContent='This browser\\\", \\\"document.getElementById('my3d2dge-error')?.remove();const p=document.createElement('p');p.t