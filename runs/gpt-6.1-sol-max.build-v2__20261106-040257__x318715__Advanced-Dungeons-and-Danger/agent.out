{"type":"item.completed","item":{"id":"item_126","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' tools/visual-release.py\"","aggregated_output":"\"\"\"Visual evidence only, against the exact release HTML; no production mutations.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nCONFIG = json.loads((ROOT / 'build-config.json').read_text())\nARTIFACT = ROOT.parent / CONFIG['html']\nFIXTURE = json.loads((ROOT / 'build/route-fixture.json').read_text())\nEVIDENCE = ROOT / 'evidence'\nREPORT = {'artifact': str(ARTIFACT), 'sha256': hashlib.sha256(ARTIFACT.read_bytes()).hexdigest(), 'screens': [], 'errors': [], 'engineErrors': [], 'notes': []}\n\n\ndef ready(page):\n    page.on('pageerror', lambda e: REPORT['errors'].append(str(e)))\n    page.goto(ARTIFACT.as_uri() + '?backend=webgl', wait_until='load', timeout=60000)\n    page.wait_for_function('window.__gameReady || window.__bootError', timeout=60000, polling=50)\n    error = page.evaluate('window.__bootError || null')\n    if error:\n        raise RuntimeError(error)\n    page.evaluate('__app.lastActivity = performance.now() + 1000000')\n\n\ndef capture(page, name, delay=1000):\n    page.wait_for_timeout(delay)\n    path = EVIDENCE / ('visual-release-' + name + '.png')\n    page.screenshot(path=str(path), timeout=60000)\n    data = page.evaluate('({screen: __app.ui.shell.screen, stage: __app.stage, view: __app.view.snapshot(), errors: __app.game.errors})')\n    REPORT['screens'].append({'name': name, 'path': str(path.relative_to(ROOT)), **data})\n    REPORT['engineErrors'].extend(data['errors'])\n    print(json.dumps({'capture': name, 'screen': data['screen'], 'view': data['view'], 'engineErrors': data['errors']}), flush=True)\n\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True, args=['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--disable-dev-shm-usage'])\n    try:\n        context = browser.new_context(viewport={'width': 1920, 'height': 1080})\n        page = context.new_page()\n        ready(page)\n        capture(page, 'title-tv')\n        page.evaluate('__app.newSolo(false)')\n        page.wait_for_function('__app.view.snapshot().floor === \"The Lantern Vault\"', timeout=60000, polling=50)\n        capture(page, 'first-room')\n        page.evaluate('__app.ui.pack()')\n        page.wait_for_function('__app.ui.shell.screen === \"pack\"', timeout=5000, polling=50)\n        capture(page, 'pack', 400)\n        page.evaluate('__app.ui.hide(); __app.game.resume(); __app.ui.map()')\n        capture(page, 'map', 400)\n        page.evaluate('__app.ui.hide(); __app.game.resume(); __app.ui.pause()')\n        capture(page, 'pause', 400)\n        page.get_by_role('button', name='Expedition tools', exact=True).click()\n        page.wait_for_function('__app.ui.shell.screen === \"dev\"', timeout=5000, polling=50)\n        capture(page, 'developer', 400)\n        page.evaluate('__app.ui.hide(); __app.game.resume(); __app.newSolo(false)')\n        run_id = page.evaluate('__app.state.runId')\n        actions = json.loads(json.dumps(FIXTURE['actions']).replace(FIXTURE['run'], run_id))\n        replay = page.evaluate('''entries => { __app.game.stop(); let accepted = 0, beforeClaim = false; for (const entry of entries) { const a = entry.action; if (a.type === 'interact' && a.target === 'guardian.treasure') beforeClaim = __app.state.shared.bossDefeated && !__app.state.shared.treasureClaimed && __app.state.phase === 'explore'; const r = __DANGER.send(a); if (!r?.ok) throw Error('Visual route ' + accepted + ': ' + JSON.stringify(a) + ' ' + JSON.stringify(r)); accepted++; } __app.update(0); __app.game.start(); return {accepted, beforeClaim, phase:__app.state.phase, modified:__app.state.modified, stats:__app.state.stats}; }''', actions)\n        REPORT['stockVictory'] = replay\n        page.wait_for_function('__app.ui.shell.screen === \"victory\"', timeout=10000, polling=50)\n        capture(page, 'stock-victory', 1200)\n        # Only these two presentation paths changed since the earlier native visual review.\n        page.evaluate('__app.ui.hide(); __app.game.resume(); __app.newSolo(false)')\n        for name, enemy in [('scorpion', 'upper.scorpion'), ('wraith', 'spirit.wraith')]:\n            page.evaluate('''enemy => { const a = __app, m = a.net.model; m.state.combat = null; m.state.phase = 'explore'; m.dev({type:'encounter',target:enemy}); const e=m.state.entities[enemy],p=m.state.players['0'],dx=e.x-p.x,dy=e.y-p.y; p.dir=Math.abs(dx)>Math.abs(dy)?dx>0?1:3:dy>0?2:0; a.onState(m.state); a.ui.hide(); a.syncPause(); a.view.resetLook(); }''', enemy)\n            page.wait_for_function('(id)=>__app.view.floorKey.includes(__app.state.floor)', arg=enemy, timeout=60000, polling=50)\n            capture(page, name, 1800)\n        REPORT['desktopAudio'] = page.evaluate('__DANGER.audio.offlineProbe()')\n        context.close()\n        phone = browser.new_context(**p.devices['iPhone 13'])\n        page = phone.new_page()\n        ready(page)\n        page.evaluate('__app.newSolo(false)')\n        page.wait_for_function('__app.view.snapshot().floor === \"The Lantern Vault\"', timeout=60000, polling=50)\n        capture(page, 'phone-hud', 1000)\n        page.get_by_role('button', name='Menu', exact=False).first.click()\n        page.wait_for_function('__app.ui.shell.screen === \"pause\"', timeout=5000, polling=50)\n        capture(page, 'phone-menu', 500)\n        phone.close()\n    except Exception as exc:\n        REPORT['errors'].append(str(exc))\n        raise\n    finally:\n        browser.close()\n        REPORT['sha256After'] = hashlib.sha256(ARTIFACT.read_bytes()).hexdigest()\n        REPORT['artifactUnchanged'] = REPORT['sha256After'] == REPORT['sha256']\n        (EVIDENCE / 'visual-release.json').write_text(json.dumps(REPORT, indent=2))\n        print(json.dumps({'sha256': REPORT['sha256'], 'artifactUnchanged': REPORT['artifactUnchanged'], 'errors': REPORT['errors'], 'engineErrors': REPORT['engineErrors'], 'stockVictory': REPORT.get('stockVictory')}), flush=True)\n","exit_code":0,"status":"completed"}}
