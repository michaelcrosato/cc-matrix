ucturedClone(CONTENT);this.editorMessage='Shipped campaign restored in the editor.';this.workshop();}],['Back',()=>this.shell.back()]]});}\n  editTile(){const f=this.editor.floors[this.editorFloor],{x,y}=this.editorTile;if(x===0||y===0||x===f.rows[0].length-1||y===f.rows.length-1){this.editorMessage='The outer boundary stays closed.';}else{const r=f.rows[y].split('');r[x]=r[x]==='#'?'.':'#';f.rows[y]=r.join('');this.editorMessage='Tile '+x+','+y+' changed. Validate before applying.';}this.workshop();}\n  moveEditorEntity(){const f=this.editor.floors[this.editorFloor],id=this.shell.root.querySelector('#editor-entity')?.value;const e=f.entities.find(e=>e.id===id);if(e){e.x=this.editorTile.x;e.y=this.editorTile.y;this.editorMessage=e.id+' moved to '+e.x+','+e.y+'.';}this.workshop();}\n  validation(){try{const r=validateContent(this.editor);if(Array.isArray(r))return r;if(r?.errors)return r.errors;if(r?.ok===false)return[r.message||'Validation failed'];return [];}catch(e){return[e.message];}}\n  validateEditor(){const errors=this.validation();this.editorMessage=errors.length?errors.join('\\\\n'):'Valid: references, geometry, routes, locks, destinations and tutorial supplies passed.';this.workshop();return errors.length===0;}\n  applyEditor(){if(this.validation().length){this.validateEditor();return;}this.app.startContent(this.editor);}\n  async importContent(){const data=await this.app.pickJSON();if(\"'!data)return;try{if(!Array.isArray(data.floors)||!data.items||!data.enemies)throw Error('\"'Expected campaign object with floors, items and enemies.');this.editor=data;this.editorFloor=0;this.editorMessage='Imported. Validate before applying.';}catch(e){this.editorMessage=e.message;}this.workshop();}\n  decorate(name,sh){if(\"'!sh)return;const box=sh.firstElementChild,buttons=box?.querySelector('\"'.esh-btns');if(\"'!box)return;\n    if(name==='\"'title'){const h=box.querySelector('h1');if(h)h.innerHTML='<span class=\\\"title-small\\\">Advanced</span><span class=\\\"title-main\\\">Dungeons</span><span class=\\\"title-end\\\">&amp; Danger</span>';const crest=el('div','title-crest');crest.innerHTML=EYE;box.prepend(crest);const top=el('div','title-topline');top.append(el('span','','A lantern-lit tactical expedition'),el('span','','The Emberheart awaits'));const bottom=el('div','title-bottomline');bottom.append(el('span','','Read the room. Prepare your hand.'),el('span','','Steel / Spirit'));sh.append(top,bottom);}\n    if(this.online&&\"'!['\"'title','invite','coop'].includes(name)){const n=el('div','live-notice','Shared world · continues while this menu is open');box.prepend(n);}\n    if(name==='pack'&&this.player){const p=this.player,sum=el('div','pack-summary');const left=el('div');left.append(el('span','','LEFT HAND'),el('br'),el('strong','',this.nameItem(p.hands[0])));const right=el('div');right.append(el('span','','RIGHT HAND'),el('br'),el('strong','',this.nameItem(p.hands[1])));sum.append(left,right,el('div','','▰ armor '+p.armor+'  /  ◇ ring '+p.ring+'\\\\n'+p.food+' rations · '+p.arrows+' arrows'));buttons?.before(sum);}\n    if(name==='invite'){const wrap=el('div');if(this.invite.output){const lab=el('label','invite-label',(this.invite.role==='host'?'YOUR OFFER':'YOUR ANSWER')+' · select or copy');lab.htmlFor='invite-output';const out=el('textarea','invite-area');out.id='invite-output';out.readOnly=true;out.value=this.invite.output;wrap.append(lab,out);}const lab=el('label','invite-label',this.invite.role==='host'?'PASTE YOUR COMPANION’S ANSWER':'PASTE THE HOST’S OFFER');lab.htmlFor='invite-input';const input=el('textarea','invite-area');input.id='invite-input';input.value=this.invite.input;input.autocomplete='off';input.spellcheck=false;input.placeholder=this.invite.role==='host'?'DD1.A.…':'DD1.O.…';input.addEventListener('input',()=>this.invite.input=input.value);wrap.append(lab,input,el('div','connection-status',this.invite.status));buttons?.before(wrap);}\n    if(name==='dev'&&this.state){const n=this.app.net.diagnostics?.()||{};const pre=el('pre','dev-state',JSON.stringify({seed:this.state.seed,run:this.state.runId,tick:this.state.tick,phase:this.state.phase,round:this.state.combat?.round,intents:this.state.combat?.intents,network:n},null,2));buttons?.before(pre);}\n    if(name==='workshop'){const f=this.editor.floors[this.editorFloor],wrap=el('div','content-editor'),grid=el('div','editor-grid');grid.style.gridTemplateColumns='repeat('+f.rows[0].length+',1fr)';for(let y=0;y<f.rows.length;y++)for(let x=0;x<f.rows[y].length;x++){const entities=f.entities.filter(q=>q.x===x&&q.y===y);const b=el('button',(f.rows[y][x]==='#'?'wall ':'')+(entities.length?'has-entity ':'')+(this.editorTile.x===x&&this.editorTile.y===y?'selected':''),entities[0]?.type[0]?.toUpperCase()||'');b.title=x+','+y+' '+entities.map(e=>e.id).join('; ');b.setAttribute('aria-label',b.title);b.onclick=()=>{this.editorTile={x,y};this.editorMessage=b.title;this.workshop();};grid.append(b);}const controls=el('div','editor-controls');controls.append(el('b','',f.name+' · tile '+this.editorTile.x+','+this.editorTile.y),el('p','','Gold outlines mark authored entities. L=loot, E=enemy, G=gate, S=secret, M=mural, C=camp/coffer.'));const label=el('label','invite-label','Entity to move');const select=el('select');select.id='editor-entity';select.style.cssText='width:100%;background:#12272b;color:#e6d6b4;padding:10px;font-size:.75em';for(const e of f.entities){const o=el('option','',e.id);o.value=e.id;select.append(o);}controls.append(label,select,el('pre','editor-log',this.editorMessage));wrap.append(grid,controls);buttons?.before(wrap);}\n  }\n  makeHUD(){const root=this.hud=el('div');root.id='game-hud';root.hidden=true;root.innerHTML='<div class=\\\"hud-top\\\"><div class=\\\"place\\\"><div class=\\\"eye-mark\\\">'+EYE+'</div><div><div class=\\\"eyebrow\\\" id=\\\"depth-label\\\"></div><div class=\\\"floor-name\\\" id=\\\"floor-name\\\"></div></div></div><div class=\\\"compass\\\"><div><span class=\\\"wind\\\">W · ·</span><strong id=\\\"heading\\\">N</strong><span class=\\\"wind\\\">· · E</span></div><div class=\\\"goal\\\">Descend. Defeat the warden. Claim the Emberheart.</div><div class=\\\"session-clock\\\" id=\\\"session-clock\\\"></div></div><button class=\\\"hud-button menu-button\\\" id=\\\"menu-button\\\"><kbd id=\\\"menu-key\\\">Esc</kbd> <span>Menu</span> ☰</button></div><div id=\\\"crosshair\\\"></div><div id=\\\"recent\\\" aria-live=\\\"polite\\\"></div><section id=\\\"target\\\" hidden><div class=\\\"eyebrow\\\" id=\\\"round-label\\\"></div><div class=\\\"enemy-name\\\" id=\\\"enemy-name\\\"></div><div class=\\\"enemy-pools\\\"><span class=\\\"war\\\" id=\\\"enemy-war\\\"></span><span class=\\\"spirit\\\" id=\\\"enemy-spirit\\\"></span></div><div class=\\\"intent\\\" id=\\\"enemy-intent\\\"></div><div class=\\\"readiness\\\" id=\\\"readiness\\\"></div><button class=\\\"inspect\\\" id=\\\"inspect-enemy\\\">Inspect intention</button></section><div class=\\\"hud-bottom\\\"><div class=\\\"vitals\\\"><div class=\\\"meter war\\\"><div class=\\\"meter-head\\\"><span>▰ WAR</span><span class=\\\"amount\\\" id=\\\"war-amount\\\"></span></div><div class=\\\"meter-track\\\"><div class=\\\"meter-fill\\\" id=\\\"war-fill\\\"></div></div></div><div class=\\\"meter spirit\\\"><div class=\\\"meter-head\\\"><span>◇ SPIRIT</span><span class=\\\"amount\\\" id=\\\"spirit-amount\\\"></span></div><div class=\\\"meter-track\\\"><div class=\\\"meter-fill\\\" id=\\\"spirit-fill\\\"></div></div></div><div class=\\\"defenses\\\" id=\\\"defenses\\\"></div><div class=\\\"counters\\\"><span>▱ <b id=\\\"food-count\\\"></b> rations</span><span>↗ <b id=\\\"arrow-count\\\"></b> arrows</span></div></div><div class=\\\"hands\\\"><div class=\\\"hand\\\"><span class=\\\"hand-label\\\">LEFT HAND / DEFENSE</span><strong id=\\\"left-hand\\\"></strong></div><div class=\\\"hand active\\\"><span class=\\\"hand-label\\\">RIGHT HAND / ACTIVE</span><strong id=\\\"right-hand\\\"></strong></div><div class=\\\"tool-links\\\"><button id=\\\"pack-button\\\"></button><button id=\\\"swap-button\\\"></button><button id=\\\"map-button\\\"></button></div></div></div><div id=\\\"context\\\"><button id=\\\"context-action\\\"></button><div class=\\\"hint\\\" id=\\\"context-hint\\\"></div></div><div id=\\\"combat-actions\\\" hidden><button data-source=\\\"right\\\">Held</button><button data-source=\\\"war\\\">▰ Strike</button><button data-source=\\\"spirit\\\">◇ Spark</button><button data-source=\\\"guard\\\">Guard</button><button data-source=\\\"retreat\\\">Retreat</button></div><div class=\\\"touch-hint\\\" id=\\\"touch-hint\\\" hidden>Left thumb: step · Right thumb: look · Double tap: pack</div><div class=\\\"modified-badge\\\" id=\\\"modified-badge\\\"></div>';\n    document.body.append(root);const by=id=>root.querySelector('#'+id);by('menu-button').onclick=()=>this.pause();by('pack-button').onclick=()=>this.pack();by('swap-button').onclick=()=>this.command({type:'swap'});by('map-button').onclick=()=>this.map();by('inspect-enemy').onclick=()=>this.inspectEnemy();by('context-action').onclick=()=>this.contextAction();root.querySelectorAll('[data-source]').forEach(b=>b.onclick=()=>b.dataset.source==='retreat'?this.retreat():this.choose(b.dataset.source));\n  }\n  contextAction(){const s=this.state;if(\"'!s)return;if(this.player?.down){this.notice('\"'Your companion can bring you back','A nearby ally needs one ration. You travel with the party.');return;}if(s.phase==='preparation'){this.command({type:'resume'});return;}if(s.phase==='combat'){if(this.selected==='guard')this.command({type:'guard',channel:'both'});else this.attack();return;}const down=Object.values(s.players).find(q=>q.down&&dist(q,this.player)<=1&&q.connected\"'!==false);if(down){this.revive();return;}this.interact();}\n  update(){const s=this.state,p=this.player,show=!!s&&!!p&&!this.shell.screen&&!this.app.attract&&this.app.stage==='\"'play';this.hud.hidden=\"'!show;document.body.classList.toggle('\"'menu-open',\"'!!this.shell.screen);document.body.classList.toggle('\"'touch-mode',this.app.lastInput==='touch');document.body.classList.toggle('reduced-motion',\"'!!this.game.settings.reducedMotion);if(!show)return;const e=this.target(),c=s.combat;const key=JSON.stringify([s.tick,s.floor,s.phase,p,c?.round,c?.deadline,c?.plans,e?.id,this.selected,this.app.lastInput,this.app.net.mode,Math.floor((s.clock||0)/500),this.game.settings.glyphs]);if(key===this.lastHUD)return;this.lastHUD=key;const by=id=>this.hud.querySelector('\"'#'+id),text=(id,t)=>{by(id).textContent=t;};text('depth-label','Depth '+String(s.floor+1).padStart(2,'0')+' / 03');text('floor-name',this.content.floors[s.floor]?.name||'The vault');text('heading',['N','E','S','W'][p.dir]);text('menu-key',this.label('pause'));text('war-amount',p.war+' / '+p.maxWar);text('spirit-amount',p.spirit+' / '+p.maxSpirit);by('war-fill').style.width=Math.max(0,p.war/p.maxWar*100)+'%';by('spirit-fill').style.width=Math.max(0,p.spirit/p.maxSpirit*100)+'%';text('defenses','▰ Armor '+p.armor+'  ·  ◇ Ring '+p.ring+(this.itemDef(p.hands[0])?.defense?'  ·  Shield +'+this.itemDef(p.hands[0]).defense:''));text('food-count',p.food);text('arrow-count',p.arrows);text('left-hand',this.nameItem(p.hands[0]));text('right-hand',this.nameItem(p.hands[1]));text('pack-button',this.label('pack')+' Pack '+p.pack.filter(Boolean).length+'/6');text('swap-button',this.label('swap')+' Swap');text('map-button',this.label('map')+' Map');text('recent',(s.log||[]).slice(-3).map(x=>typeof x==='string'?x:x.text||'').join('\\\\n'));by('target').hidden=\"'!e;by('\"'combat-actions').hidden=s.phase\"'!=='\"'combat';by('touch-hint').hidden=this.app.lastInput\"'!=='\"'touch';text('modified-badge',s.modified?'MODIFIED EXPEDITION':'');let clock='';if(this.app.net.mode==='hub'&&Number.isFinite(globalThis.AIHub?.time?.())){const left=Math.max(0,(AIHub.limitMs||900000)-AIHub.time());clock=Math.ceil(left/60000)+' min remain · live co-op';}text('session-clock',clock);\n    if(e&&c){const d=this.content.enemies[e.kind],intent=c.intents[e.id];text('round-label','Round '+c.round+(e.kind==='minotaur'?' · Seal '+(e.phase||1)+' / 3':''));text('enemy-name',d.name);text('enemy-war','▰ '+e.war+' / '+e.maxWar);text('enemy-spirit','◇ '+e.spirit+' / '+e.maxSpirit);by('enemy-intent').replaceChildren();if(intent){const who=s.players[intent.target]?.name||'the party';const channel=intent.channel==='war'?'▰ WAR':'◇ SPIRIT';const em=el('em','',intent.kind==='windup'?'Drawing back…':channel+' · '+intent.power+' before defense');by('enemy-intent').append(em,el('div','','Intends '+(intent.kind==='windup'?'a heavy blow':intent.kind||'a strike')+' → '+who),el('small','','Defeat it first, guard the blow, or reposition.'));}const living=Object.values(s.players).filter(q=>q.connected\"'!==false&&!q.down);const ready=living.filter(q=>c.plans?.[q.id]).map(q=>q.name);text('\"'readiness',(ready.length?'Ready: '+ready.join(', '):'Choose an action, then commit.')+(c.deadline?' · '+Math.max(0,Math.ceil((c.deadline-s.clock)/1000))+'s':' · no timer until commitment'));\n    }\n    const entity=this.contextEntity();let action='',hint='',disabled=false;\n    if(p.down){action='You are down · await a ration';hint='A nearby ally can revive both strengths.';}\n    else if(s.phase==='preparation'){action='Continue to the next seal';hint='A preparation beat. Drink, equip or mend your strengths before continuing.';}\n    else if(s.phase==='combat'){const d=this.selected==='right'?this.itemDef(p.hands[1]):null;const name=this.selected==='guard'?'Guard both strengths':this.selected==='war'?'Basic War strike · 3':this.selected==='spirit'?'Spirit spark · 3':(d?.name||'Basic War strike');action=this.label('attack')+'  Commit: '+name;hint=this.selected==='guard'?'Guard reduces the next hit.':d?this.itemTag(p.hands[1])+' · range '+(d.range||1)+' tiles':this.selected==='spirit'?'Reusable · no Spirit cost':'Reusable · no cost';if(c?.plans?.[p.id]){action='Committed · waiting for your companion';disabled=true;}}\n    else{const down=Object.values(s.players).find(q=>q.down&&q.connected\"'!==false&&q.id!==p.id&&dist(q,p)<=1);if(down){action=this.label('\"'interact')+'  Revive '+down.name;hint='Cost: 1 ration. Both strengths return to at least 30%.';}else if(entity){const item=entity.itemId&&this.state.items[entity.itemId],d=item&&this.content.items[item.kind];action=this.label('interact')+'  '+(entity.type==='loot'?'Take ':'')+(d?.name||entity.name||titleCase(entity.type));hint=entity.type==='loot'?(d?this.itemTag(entity.itemId):entity.food?'Supplies stay outside the six-slot pack':'Shared keyring'):entity.type==='secret'?'A hollow seam. Try the stone.':entity.type==='ladder'?'One-way descent · asks before committing':'Inspect / interact';}else{action=this.label('pack')+'  Prepare your pack';hint='WASD step · Q/E quarter-turn · '+this.label('rest')+' rest';}}\n    by('context-action').disabled=disabled;text('context-action',action);text('context-hint',hint);this._contextIsPack=s.phase==='explore'&&\"'!entity&&!Object.values(s.players).some(q=>q.down&&q.connected!==false&&q.id!==p.id&&dist(q,p)<=1);this.hud.querySelectorAll('\"'[data-source]').forEach(b=>b.classList.toggle('selected',b.dataset.source===this.selected));\n  }\n}\nexport {report};\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/interface.js <<'EOF'\nimport report from '../report.json';\nimport { CONTENT, DEFAULT_TUNING, validateContent } from '../core/model.js';\nconst E=globalThis.My3D2dge;\nexport const EYE='<svg viewBox=\\\"0 0 100 64\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"3\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 32Q50-9 96 32Q50 73 4 32ZM50 5V0M50 64V59M12 9l9 9M88 9l-9 9M12 55l9-9M88 55l-9-9\\\"/><path d=\\\"M50 15l14 17-14 17-14-17Z\\\"/><circle cx=\\\"50\\\" cy=\\\"32\\\" r=\\\"6\\\" fill=\\\"currentColor\\\"/></svg>';\nexport const QUESTIONS={testingFeedback:['How many issues did testing catch?','How many would be considered critical issues / game breaking?','What was the most helpful test you ran?','What was the least helpful test you ran?'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','What was the most important thing you had to build yourself?','What was the hardest part about using the engine?','What did you change in the engine, and why? (none if nothing)','If you could change one thing about the engine, what would it be?'],promptFeedback:['What did you like most about this prompt?','What was confusing?','What was the hardest thing to do?','What would you change in this prompt?']};\nexport const el=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text\"'!==undefined)e.textContent=String(text);return e};\nconst titleCase=k=>k.replace(/([a-z])([A-Z])/g,'\"'\"'$1 $2'\"').replace(/\"'^./,c=>c.toUpperCase());\nconst dist=(a,b)=>Math.abs(a.x-b.x)+Math.abs(a.y-b.y);\nconst DX=[0,1,0,-1],DY=[-1,0,1,0];\nexport class DangerShell extends E.Shell{\n  constructor(game,opts,decorate){super(game,opts);this.decorate=decorate;this.root?.classList.add('\"'danger-shell');this.root?.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&\"'!b.disabled&&document.activeElement?.tagName!=='\"'TEXTAREA')b.focus({preventScroll:true});});}\n  _render(){super._render();if(this.root){this.root.classList.add('danger-shell');const sh=this._els.scr.querySelector('.esh-sh');if(sh&&this.screen)sh.classList.add('screen-'+this.screen);this.decorate?.(this.screen,sh);}}\n  _focusables(){return this.root?[...this._els.scr.querySelectorAll('.esh-sh button:not(:disabled),.esh-sh input:not(:disabled),.esh-sh textarea:not(:disabled),.esh-sh select:not(:disabled),.esh-sh a[href]')]:[];}\n  _step(){const f=document.activeElement;if(f&&['TEXTAREA','SELECT'].includes(f.tagName)){if(this._game.input.pressed('cancel')){f.blur();this.back();}return;}super._step();}\n}\nexport class Interface{\n  constructor(app){this.app=app;this.game=app.game;this.selected='right';this.targetId=null;this.invite={role:'',status:'',output:'',input:''};this._packItem=null;this.editor=structuredClone(CONTENT);this.editorFloor=0;this.editorTile={x:1,y:1};this.editorMessage='Choose a tile to inspect or change it. Export valid content to rebuild the HTML.';\n    this.shell=new DangerShell(this.game,{standard:true,theme:{scale:1,font:'Arial, sans-serif',titleFont:'Georgia, serif'},screens:{pause:{},help:{title:'Into the vault'},settings:{text:'Your expedition preferences. Choices apply immediately.'}}},(name,sh)=>this.decorate(name,sh));\n    this.makeHUD();this.lastHUD='';\n  }\n  get state(){return this.app.state;}get player(){return this.app.player;}get online(){return this.app.online;}get content(){return this.state?.content||CONTENT;}get isOpen(){return \"'!!this.shell.screen;}\n  label(action){return this.game.input.label(action);}\n  nameItem(id){const s=this.state;const it=s?.items?.[id];return it?(this.content.items[it.kind]?.name||it.kind):'\"'Empty hand';}\n  itemDef(id){return this.content.items[this.state?.items?.[id]?.kind]||null;}\n  show(name,spec={}){this.app.unlockPointer();this.shell.show(name,spec);this.app.syncPause();return this;}\n  hide(){this.shell.hide();this.app.syncPause();}\n  title(){this.shell.hide();this.show('title',{name:report.aiHub.name,subtitle:'Two strengths. Six slots.\\\\nNo way back.',actions:[['Begin expedition',()=>this.app.newSolo()],{label:'Continue expedition',disabled:\"'!this.app.saved(),fn:()=>this.app.continueSolo()},['\"'Two adventurers',()=>this.coop()],['Settings & controls',()=>this.settings()],['About this expedition',()=>this.credits()]],meta:['3 authored floors','1–2 adventurers','Steel & spirit'],footer:'Inspired by Treasure of Tarmin · 1983',back:()=>{}});}\n  pause(){if(\"'!this.state||this.app.attract)return;this.show('\"'pause',{kicker:this.online?'Online · world remains live':'The lantern is still',title:this.online?'Expedition menu':'Take a breath',text:this.online?'Your companion can still act. Local settings do not pause the shared world.':'Study your pack. The creatures will wait.',actions:[['The six-slot pack',()=>this.pack()],['Explored map',()=>this.map()],['Expedition tools',()=>this.dev()],['About / Credits',()=>this.credits()],...(\"'!this.online?[['\"'Export / import save',()=>this.saves()],['Return to title',()=>this.confirm('Leave the vault?','Your latest safe checkpoint is kept. Return here through Continue expedition.',()=>this.app.returnTitle())]]:this.app.net.mode==='hub'?[]:[['Leave co-op',()=>this.confirm('Leave your companion?','The host continues alone if the guest leaves. Losing the host ends this connection.',()=>this.app.returnTitle())]])],back:()=>this.hide()});}\n  settings(){this.show('settings',{kicker:this.online?'Live shared world':'Your preferences',text:'Music starts at 10%. Reduced motion keeps every enemy intention visible.'});}\n  help(){this.show('help',{kicker:'Before you descend',title:'Read. Prepare. Commit.',sections:[['Keep both strengths above zero','▰ War is your body. ◇ Spirit is your resolve. Armor and a left-hand shield protect War; a worn ring protects Spirit. Either empty pool brings you down.'],['Read the next blow','Combat waits for your decision. Choose an attack or Guard, then commit. Attacks show their channel, cost and range. A defeated foe cannot strike back. Looking and inspecting are free.'],['Carry with purpose','Six pack slots, two hands. The right hand attacks. The left can hold a shield or another implement; quick-swap makes it active. Food and arrows have their own counters; keys cannot be dropped.'],['Rest and commit','In safety, a ration restores up to 8 War and 5 Spirit. Ladders and gates ask before carrying you onward. Inspect a ticking coffer before opening it. Look for blue seams.'],['Claim the prize','Break all three of the warden’s seals, then walk to the Emberheart and take it. Victory is yours only when the treasure is in your hands.'],['Together','Each adventurer carries a personal pack. The first committed action opens an 8-second planning window; both ready actions resolve early. A nearby ally can spend a ration to revive. Both living players must agree to descend.'],['Touch gestures','Drag the left half to step; drag the right half to look. Tap the contextual action to interact or commit. Double-tap the right half for your pack; two-finger tap for the map. The menu stays in the top corner.']],actions:[['Rebind controls',()=>this.show('controls')],['Back',()=>this.shell.back()]]});}\n  credits(){const sections=[];sections.push(['Source Information',Object.entries(report.sourceInformation).map(([k,v])=>titleCase(k)+': '+v).join('\\\\n\\\\n')]);for(const [key,title]of [['testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']])sections.push([title,report[key].map((a,i)=>(i+1)+'. '+QUESTIONS[key][i]+'\\\\n'+a).join('\\\\n\\\\n')]);sections.push(['Credits & licenses','Original game, writing, geometry, rules, music and code: OpenAI gpt-6.1-sol. Source inspiration: Mattel Electronics / APh, Tom Loughry, 1983; original package illustration by Jerrol Richardson. my-3D2dge and World3D: Michael Crosato, MIT. three.js: three.js contributors, MIT. Rapier: Dimforge, Apache-2.0. AI Hub session client: Michael Crosato; pinned unmodified. All dependency licenses are embedded in the HTML source. No source game art, recorded music or audio files are used.']);this.show('credits',{kicker:'Advanced Dungeons and Danger',title:'About this expedition',sections,actions:[['Back',()=>this.shell.back()]]});}\n  confirm(title,text,fn,yes='Commit'){this.show('confirm',{kicker:this.online?'Shared expedition · live':'Consider your next step',title,text,actions:[{label:yes,fn:()=>{this.shell.back();fn();this.app.syncPause();}},['Cancel',()=>{this.shell.back();this.app.syncPause();}]]});}\n  notice(title,text){this.shell.toast(title,text,4);}\n  command(action){return this.app.send(action);}\n  interact(){const e=this.contextEntity();if(\"'!e){this.notice('\"'Nothing within reach','Face a door, mural or object, or step closer.');return;}this.entity(e);}\n  contextEntity(){const s=this.state,p=this.player;if(\"'!s||!p)return null;const at=[...Object.values(s.entities)].filter(e=>e.floor===s.floor&&!e.dead&&!e.claimed&&!e.taken&&!e.used&&e.type!=='\"'enemy'&&dist(p,e)<=1);const forward=at.filter(e=>e.x===p.x+DX[p.dir]&&e.y===p.y+DY[p.dir]);const under=at.filter(e=>e.x===p.x&&e.y===p.y);const list=[...under,...forward,...at];return list.find(e=>\"'!(e.type==='\"'door'&&e.open)&&\"'!(e.type==='\"'secret'&&e.open)&&\"'!(e.type==='\"'loot'&&e.claimed))||null;}\n  entity(e){const s=this.state,p=this.player;if(\"'!e||!p)return;if(e.type==='\"'loot'){this.command({type:'pickup',target:e.id});return;}if(e.type==='mural'){this.show('inspect',{kicker:'A warning in stone',title:e.name||'The watching eye',text:e.text,actions:[['Remember it',()=>this.hide()]]});return;}if(e.type==='camp'){this.rest();return;}if(e.type==='ladder'){this.confirm('Descend to '+(this.content.floors[e.toFloor]?.name||'the next vault')+'?','The ladder is one way. Carry what you need; the party must agree. A viable floor-entry checkpoint will be kept.',()=>{this.hide();this.command({type:'descend',target:e.id,confirm:true});},this.online?'Ready to descend':'Descend');return;}if(e.type==='gate'){this.show('gate',{kicker:'One-way transfer · read the cost',title:e.name,text:'This gate carries the whole party to the far passage. Each pool remains at least 1. Choose which strength it favors.',actions:Object.entries(e.options||{war:{war:6,spirit:-4},spirit:{war:-4,spirit:6},balanced:{war:0,spirit:0}}).map(([k,v])=>[titleCase(k)+'  ·  ▰ War '+(v.war>=0?'+':'')+v.war+'  /  ◇ Spirit '+(v.spirit>=0?'+':'')+v.spirit,()=>this.confirm('Commit to the '+k+' gate?','You cannot travel back through it. Both adventurers move together.',()=>{this.hide();this.command({type:'interact',target:e.id,choice:k,confirm:true});},'Pass through')]).concat([['Leave the gate',()=>this.hide()]])});return;}if(e.type==='chest'){this.show('chest',{kicker:e.trapped&&\"'!e.disarmed?'\"'Listen: a dry ticking':'A sealed coffer',title:e.name,text:e.open?'The coffer stands open. Its contents lie nearby.':e.hint||'Dust lies thick on an untrapped latch.',actions:[...(e.trapped&&\"'!e.disarmed?[['\"'Disarm the silver wire · safe',()=>{this.command({type:'interact',target:e.id,choice:'disarm'});this.hide();}]]:[]),{label:e.open?'Already opened':e.trapped&&\"'!e.disarmed?'\"'Force open · lose 6 War':'Open the coffer',disabled:\"'!!e.open,fn:()=>{this.command({type:'\"'interact',target:e.id,choice:'open'});this.hide();}},['Leave it',()=>this.hide()]]});return;}if(e.type==='treasure'){if(\"'!s.shared.bossDefeated){this.notice('\"'The guardian’s seals hold','Defeat the warden before claiming the Emberheart.');return;}this.confirm('Claim the Emberheart?','The warden is fallen. The treasure must be taken. This is the end of your expedition.',()=>{this.hide();this.command({type:'interact',target:e.id,choice:'confirm'});},'Take the treasure');return;}this.command({type:'interact',target:e.id});}\n  pack(){const p=this.player;if(\"'!p)return;this.show('\"'pack',{kicker:this.state.phase==='combat'?'Round '+this.state.combat.round+' · gear changes use your action':'Carry only what earns its place',title:'Six slots. Two hands.',text:'Select an object to equip, use, drop, or hand it to a nearby companion.',actions:p.pack.map((id,i)=>({label:(i+1)+'  '+(id?this.nameItem(id):'Empty slot')+'\\\\n'+(id?this.itemTag(id):'Space for an object'),disabled:\"'!id,fn:()=>this.item(i,id)})).concat([['\"'Quick-swap hands',()=>{this.hide();this.command({type:'swap'});}],['Use right-hand object',()=>{this.hide();this.useHand();}],['Rest · one ration',()=>this.rest()],['Back to the vault',()=>this.hide()]])});}\n  itemTag(id){const d=this.itemDef(id);if(\"'!d)return '\"'';return d.ammo?'1 arrow / shot':d.channel&&d.power?(d.channel==='war'?'▰ WAR ':'◇ SPIRIT ')+d.power+' · '+(d.reusable?'reusable':'single use'):d.reusable?'Reusable':'Single use';}\n  item(slot,id){const d=this.itemDef(id);if(\"'!d)return;const p=this.player;const near=Object.values(this.state.players).find(q=>q.id!==p.id&&q.connected!==false&&!q.down&&dist(p,q)<=1);this.show('\"'item',{kicker:this.itemTag(id),title:d.name,text:d.description,actions:[...(d.family==='weapon'||d.family==='shield'?[['Equip in right hand',()=>{this.hide();this.command({type:'equip',slot,hand:1});}],['Equip in left hand',()=>{this.hide();this.command({type:'equip',slot,hand:0});}]]:[]),...(d.use?[['Use '+d.name,()=>{this.hide();this.command({type:'use',item:id});}]]:[]),...(near?[['Give to '+near.name,()=>{this.hide();this.command({type:'handoff',item:id,target:near.id});}]]:[]),['Drop at your feet',()=>{this.hide();this.command({type:'drop',slot});}],['Back to pack',()=>this.shell.back()]]});}\n  useHand(){const id=this.player?.hands?.[1],d=this.itemDef(id);if(d?.use)this.command({type:'use',item:id});else this.notice('Hold a useful object','Use the pack to drink a potion, put on armor or a ring, or read a book.');}\n  fullPack(target){const e=this.state.entities[target];if(\"'!e)return;const incoming=this.state.items[e.itemId],d=this.content.items[incoming?.kind||e.kind];this.show('\"'packfull',{kicker:'Six slots are occupied',title:d?.name||e.name||'An object at your feet',text:(d?.description||'')+' Choose one pack object to leave here. Cancel keeps this object safely in the world.',actions:this.player.pack.map((id,i)=>['Leave '+this.nameItem(id)+' / take this',()=>{this.hide();this.command({type:'pickup',target,swap:i});}]).concat([['Leave it where it lies',()=>this.hide()]])});}\n  rest(){const p=this.player,t=this.state?.tuning||DEFAULT_TUNING;if(\"'!p)return;const w=Math.min(t.rationWar,p.maxWar-p.war),sp=Math.min(t.rationSpirit,p.maxSpirit-p.spirit);this.confirm('\"'Rest by the lantern?','Cost: 1 ration ('+p.food+' carried). Restore exactly ▰ '+w+' War and ◇ '+sp+' Spirit. Rest requires safety; full strengths waste no ration.',()=>{this.hide();this.command({type:'rest',confirm:true});},'Rest · restore '+w+' / '+sp);}\n  retreat(){const c=this.state?.combat,p=this.player;if(\"'!c||!p)return;const strikes=c.enemies.map(id=>c.intents[id]).filter(Boolean);const damage=strikes.map(a=>(a.channel==='\"'war'?'▰ War':'◇ Spirit')+' '+a.power).join(', ');this.confirm('Fall back?','The living threats may deliver a parting strike ('+damage+' before defense). The party returns to its last safe positions.',()=>{this.hide();this.command({type:'retreat',confirm:true});},'Retreat together');}\n  map(){const s=this.state,p=this.player;if(\"'!s||!p)return;const f=this.content.floors[s.floor],rows=f.rows.map(r=>r.split('\"''));for(const q of Object.values(s.entities))if(q.floor===s.floor&&q.type==='secret'&&q.open)rows[q.y][q.x]='.';const map=new E.TileMap({rows:rows.map(r=>r.join('')),legend:{'#':1,'.':0},types:{1:{h:16,top:'#4b6669',side:'#344b53'}},tile:16});const seen=new Set(p.seen||[]);const markers=[];for(const e of Object.values(s.entities)){if(e.floor\"'!==s.floor||e.claimed||e.dead||e.taken||!seen.has(e.x+'\"','+e.y))continue;markers.pu