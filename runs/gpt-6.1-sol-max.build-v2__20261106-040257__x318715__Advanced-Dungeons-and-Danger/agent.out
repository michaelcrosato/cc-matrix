{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/boot-proof.js <<'EOF'\nimport '../vendor/engine/my-3d2dge-3d.js';\n(async()=>{const E=globalThis.My3D2dge;const g=new E.Game({canvas:'screen',res:'wide',expand:true,bg:null,autoPause:false,fullscreen:false,corner:false});await E.World3D.init(g);const w=new E.World3D(g,{level:{rows:['#####','#...#','#...#','#...#','#####']},camera:{mode:'fixed'}});const a=new E.Humanoid({build:'skeleton'});w.mob({x:40,y:40,rig:a});w.camera.pose={x:40,y:65,z:25,yaw:-Math.PI/2,pitch:0,fov:70};g.start({update(dt){w.step(dt);Object.assign(w.camera.pose,{x:40,y:65,z:25,yaw:-Math.PI/2,pitch:0,fov:70})},draw(r){w.draw(r)}});window.__proof={backend:E.World3D.backend,engine:E.version,wasm:true};})().catch(e=>{window.__proof={error:String(e.stack)};document.body.dataset.error=String(e)});\nEOF\nmkdir -p build\nbun build src/boot-proof.js --target browser --format iife --outfile build/proof.js --minify\nnode --input-type=module - <<'JS'\nimport fs from 'node:fs';\nconst esc=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nfs.writeFileSync('build/packaging-proof.html','<\"'!doctype html><html><head><meta charset=\"utf-8\"><style>body{margin:0;background:black}#stage{position:relative;width:100vw;height:100vh}canvas{position:absolute;inset:0;width:100%;height:100%}</style></head><body><div id=\"stage\"><canvas id=\"view\"></canvas><canvas id=\"screen\"></canvas></div><script>'\"'+esc(fs.readFileSync('vendor/engine/my-3d2dge.js','utf8'))+'</script><script>'+esc(fs.readFileSync('build/proof.js','utf8'))+'</script></body></html>');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/boot-proof.js <<'EOF'\nimport '../vendor/engine/my-3d2dge-3d.js';\n(async()=>{const E=globalThis.My3D2dge;const g=new E.Game({canvas:'screen',res:'wide',expand:true,bg:null,autoPause:false,fullscreen:false,corner:false});await E.World3D.init(g);const w=new E.World3D(g,{level:{rows:['#####','#...#','#...#','#...#','#####']},camera:{mode:'fixed'}});const a=new E.Humanoid({build:'skeleton'});w.mob({x:40,y:40,rig:a});w.camera.pose={x:40,y:65,z:25,yaw:-Math.PI/2,pitch:0,fov:70};g.start({update(dt){w.step(dt);Object.assign(w.camera.pose,{x:40,y:65,z:25,yaw:-Math.PI/2,pitch:0,fov:70})},draw(r){w.draw(r)}});window.__proof={backend:E.World3D.backend,engine:E.version,wasm:true};})().catch(e=>{window.__proof={error:String(e.stack)};document.body.dataset.error=String(e)});\nEOF\nmkdir -p build\nbun build src/boot-proof.js --target browser --format iife --outfile build/proof.js --minify\nnode --input-type=module - <<'JS'\nimport fs from 'node:fs';\nconst esc=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nfs.writeFileSync('build/packaging-proof.html','<\"'!doctype html><html><head><meta charset=\"utf-8\"><style>body{margin:0;background:black}#stage{position:relative;width:100vw;height:100vh}canvas{position:absolute;inset:0;width:100%;height:100%}</style></head><body><div id=\"stage\"><canvas id=\"view\"></canvas><canvas id=\"screen\"></canvas></div><script>'\"'+esc(fs.readFileSync('vendor/engine/my-3d2dge.js','utf8'))+'</script><script>'+esc(fs.readFileSync('build/proof.js','utf8'))+'</script></body></html>');\nJS\"","aggregated_output":"Bundled 6 modules in 378ms\n\n  proof.js  3.48 MB  (entry point)\n\n","exit_code":0,"status":"completed"}}
