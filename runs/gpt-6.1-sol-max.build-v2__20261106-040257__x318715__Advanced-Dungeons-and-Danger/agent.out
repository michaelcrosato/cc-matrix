{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '65,115p' vendor/hub/harness.html && rg -n 'window\\\\.|__|const newRound|function newRound|async function newRound|removeCell|roundState' vendor/hub/harness.html | tail -35 && rg -n 'diagnostics\\\\(' src/net/network.js && sed -n '1308,1348p' src/net/network.js\"","aggregated_output":"<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n24:  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n25:  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n158:async function newRound() {\n214:    label.className = 'cell__bar';\n215:    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n309:  for (const cell of current.cells) removeCell(cell, false);\n314:function removeCell(cell, tellRound = true) {\n346:    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n365:  if (cell) removeCell(cell);\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n478:    else if (n >= 3) removeCell(state.cells[n - 1]);\n517:        extra = c.frame.contentWindow?.__hubViolations ?? [];\n1309:\tdiagnostics() {\n\n\tdiagnostics() {\n\t\treturn {\n\t\t\tmode: this.mode,\n\t\t\tauthority: this.isHost,\n\t\t\tserver: this.server,\n\t\t\trun: this._run,\n\t\t\trunning: this.running,\n\t\t\tended: this.ended,\n\t\t\tpaused: this.paused,\n\t\t\tallowSoloSave: this.allowSoloSave,\n\t\t\tconnection: this.pc?.connectionState ?? null,\n\t\t\tchannel: this.channel?.readyState ?? null,\n\t\t\trevision: this.isHost ? this._revision : this._receivedRevision,\n\t\t\tqueue: this._outbox.length,\n\t\t\tpendingInputs: this._commands.length,\n\t\t\ttraffic: {\n\t\t\t\t...this._traffic,\n\t\t\t\tmaxPerSecond: Math.max(\n\t\t\t\t\tthis._traffic.maxPerSecond,\n\t\t\t\t\tthis._traffic.secondCount,\n\t\t\t\t),\n\t\t\t},\n\t\t};\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,65p' vendor/hub/harness.html && sed -n '320,373p' vendor/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,65p' vendor/hub/harness.html && sed -n '320,373p' vendor/hub/harness.html\"","aggregated_output":"  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n    if (p.out) bits.push(`out: ${p.out}`);\n    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n    else if (p.ready) bits.push('ready');\n    else if (p.hello) bits.push('welcomed');\n    else bits.push('loading');\n    const last = cell.progress.at(-1);\n    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n    bits.push(`↑${cell.bridge.stats.sent} ↓${cell.bridge.stats.received}`);\n    cell.label.querySelector('.cell__state').textContent = bits.join(' · ');\n    cell.el.classList.toggle('is-out', !!p.out || cell.gone);\n  }\n  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\n  if (state.record) {\n    const name = (id) => s.players[id]?.name ?? `#${id}`;\n    lines.push(`Ended ${state.record.status} (${state.record.reason})`);\n    if (state.record.standings) state.record.standings.forEach((ids, i) => lines.push(`  ${i + 1}. ${ids.map(name).join(', ')}`));\n  }\n  if (s.issues.length) lines.push(...s.issues.map((i) => `✗ ${i.key}: ${i.problem}`));\n  $('round').textContent = lines.join('\\n');\n}\n\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > tools/browser-test.py <<'PY'\n\\\"\\\"\\\"Release checks use the delivered HTML and production commands. No route cheats.\\\"\\\"\\\"\nfrom pathlib import Path\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nWORK=ROOT.parent\nCONFIG=json.loads((ROOT/'build-config.json').read_text())\nARTIFACT=WORK/CONFIG['html']\nREPORT=json.loads((ROOT/'src/report.json').read_text())\nFIXTURE=json.loads((ROOT/'build/route-fixture.json').read_text())\nchecks=[]\nevidence={}\n\ndef check(name, passed, detail=''):\n    checks.append({'name':name,'pass':bool(passed),'detail':str(detail)[:1800]})\n\ndef safe(name,fn):\n    try:\n        fn()\n    except Exception as exc:\n        check(name,False,str(exc))\n\nPAD=\\\"\\\"\\\"window.__pad=null;Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});window.pad=(button=-1,axes=[0,0,0,0])=>window.__pad={id:'DualSense standard emulation',index:0,mapping:'standard',connected:true,timestamp:performance.now(),axes,buttons:Array.from({length:18},(_,i)=>({pressed:i===button,touched:i===button,value:i===button?1:0}))};\\\"\\\"\\\"\nFLAGS=['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']\n\ndef ready(page,url):\n    page.goto(url,wait_until='load',timeout=60000)\n    page.wait_for_function('window.__gameReady || window.__bootError',timeout=60000)\n    if page.evaluate('window.__bootError || null'):\n        raise RuntimeError(page.evaluate('window.__bootError'))\n\ndef state(page):\n    return page.evaluate('__app.state')\n\ndef send(page,action):\n    return page.evaluate('(a)=>__DANGER.send(a)',action)\n\ndef idle_stop(page):\n    page.evaluate('__app.lastActivity=performance.now()')\n\ndef file_checks(pw):\n    browser=pw.chromium.launch(headless=True,args=FLAGS)\n    context=browser.new_context(viewport={'width':1280,'height':720})\n    context.add_init_script(PAD)\n    page=context.new_page(); errors=[];requests=[]\n    page.on('pageerror',lambda exc:errors.append(str(exc)))\n    page.on('request',lambda req:requests.append(req.url))\n    ready(page,ARTIFACT.as_uri()+'?backend=webgl')\n    check('file:// final artifact boots native World3D',page.evaluate('__app.view.rendererName')=='WebGL 2')\n    check('native engine version pinned',page.evaluate('My3D2dge.version')=='0.89.1')\n    check('fresh music gain defaults to 0.10',page.evaluate('__app.game.settings.music')==.10)\n    check('fresh PS glyph setting',page.evaluate('__app.game.settings.glyphs')=='playstation')\n    check('canonical embedded report equals delivered JSON',page.evaluate('JSON.parse(document.getElementById(\\\"game-credits\\\").textContent)')==REPORT)\n    check('offline artifact requests no neighbors or CDN',all(u.startswith(ARTIFACT.as_uri()) or u.startswith('data:') or u.startswith('blob:') for u in requests),requests)\n    page.wait_for_timeout(80)\n    bounds=page.evaluate('''()=>[...document.querySelectorAll('.esh-ttl .esh-btns button')].map(b=>{const r=b.getBoundingClientRect();return{label:b.textContent,bottom:r.bottom,right:r.right,top:r.top}})''')\n    check('title choices fit viewport',all(b['bottom']<=724 and b['top']>=0 for b in bounds),bounds)\n    # A standard-mapping pad selects the same title and starts the same expedition.\n    page.evaluate('pad(0)');page.wait_for_timeout(120);page.evaluate('pad()')\n    page.wait_for_function('__app.stage===\\\"play\\\"',timeout=10000)\n    check('standard gamepad starts expedition',page.evaluate('__app.ui.shell.screen')=='briefing')\n    page.evaluate('pad(0)');page.wait_for_timeout(100);page.evaluate('pad()');page.wait_for_timeout(150)\n    check('pad confirms briefing',page.evaluate('__app.ui.shell.screen') is None)\n    check('gamepad prompt uses PlayStation glyphs',page.evaluate('__app.game.input.lastDevice===\\\"gamepad\\\" && __app.ui.label(\\\"pack\\\").includes(\\\"△\\\")'))\n    page.evaluate('__app.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")');page.wait_for_timeout(80)\n    check('Xbox glyph option changes prompt',page.evaluate('__app.ui.label(\\\"pack\\\")') in ['Y','Y / I','Y / Tab'])\n    page.evaluate('__app.game.settings.set(\\\"glyphs\\\",\\\"playstation\\\");window.__pad=null')\n    page.wait_for_timeout(100)\n    check('controller disconnect preserves run',page.evaluate('__app.state.phase===\\\"explore\\\" && __app.state.players[\\\"0\\\"].war===36'))\n    page.evaluate('pad()');page.wait_for_timeout(100)\n    page.keyboard.press('w');page.wait_for_timeout(180)\n    check('keyboard W moves logical tile north',page.evaluate('__app.player.y')==8)\n    page.keyboard.press('e');page.wait_for_timeout(100)\n    check('quarter turn E is free',page.evaluate('__app.player.dir===1 && __app.state.stats.rounds===0'))\n    page.keyboard.press('q');page.wait_for_timeout(100)\n    check('quarter turn Q restores heading',page.evaluate('__app.player.dir')==0)\n    page.keyboard.press('Tab');page.wait_for_timeout(160)\n    check('Tab opens actual six-slot pack',page.evaluate('__app.ui.shell.screen')=='pack' and page.evaluate('__app.player.pack.length')==6)\n    check('pack has two visible hand indicators',page.locator('.pack-summary').count()==1)\n    page.keyboard.press('Escape');page.wait_for_timeout(100)\n    page.keyboard.press('Escape');page.wait_for_timeout(150)\n    check('pause persists through native shell lifecycle',page.evaluate('__app.ui.shell.screen===\\\"pause\\\" && __app.game.paused && __app.net.paused'))\n    page.get_by_role('button',name='Expedition tools',exact=True).click();page.wait_for_timeout(120)\n    check('developer mode reachable through pause',page.evaluate('__app.ui.shell.screen')=='dev')\n    slider=page.get_by_role('slider',name='Player damage ×',exact=True)\n    slider.fill('1.5');slider.dispatch_event('input')\n    check('live tuning changes production multiplier',page.evaluate('__app.state.tuning.playerDamage===1.5 && __app.state.modified'))\n    page.get_by_role('button',name='Reset tuning to defaults',exact=True).click();page.wait_for_timeout(100)\n    check('tuning reset restores canonical values',page.evaluate('JSON.stringify(__app.state.tuning)===JSON.stringify(__DANGER.CONTENT.tuning)'))\n    page.get_by_role('button',name='Content workshop',exact=True).click();page.wait_for_timeout(120)\n    check('designer workflow has tile/entity preview',page.locator('.editor-grid button').count()==121 and page.locator('#editor-entity option').count()>0)\n    page.get_by_role('button',name='Validate content',exact=True).click()\n    check('shipped content validates in workshop',page.locator('.editor-log').inner_text().startswith('Valid:'))\n    # Native Controls rebinding enters the same production input map.\n    page.evaluate('__app.ui.hide();__app.ui.show(\\\"controls\\\")');page.wait_for_timeout(120)\n    result=page.evaluate('__app.game.input.rebind(\\\"interact\\\",\\\"keys\\\",\\\"KeyB\\\")')\n    check('native rebinding accepts conflict-free key',result is None)\n    page.evaluate('__app.game.input.lastDevice=\\\"keyboard\\\"')\n    check('rebound prompts follow key',page.evaluate('__app.ui.label(\\\"interact\\\")')=='B')\n    page.evaluate('__app.game.input.resetBindings();__app.ui.hide();__app.game.resume();__app.newSolo(false)')\n    # One complete stock-balance run, including both boss state boundaries.\n    run_id=page.evaluate('__app.state.runId')\n    actions=json.loads(json.dumps(FIXTURE['actions']).replace(FIXTURE['run'],run_id))\n    before_claim=False;accepted=0\n    for i,entry in enumerate(actions):\n        action=entry['action']\n        if action.get('type')=='interact' and action.get('target')=='guardian.treasure':\n            before_claim=page.evaluate('__app.state.shared.bossDefeated && \"'!__app.state.shared.treasureClaimed && __app.state.phase===\"explore\"'\"')\n        r=send(page,action)\n        if not r or not r.get('ok'):\n            raise RuntimeError(f'Normal route action {i}: {action}: {r}')\n        accepted+=1\n        if i%18==0:page.wait_for_timeout(20)\n    page.wait_for_timeout(250)\n    s=state(page);evidence['soloSummary']={'actions':accepted,'stats':s['stats'],'war':s['players']['0']['war'],'spirit':s['players']['0']['spirit'],'clockMs':s['clock']}\n    check('boss death does not silently claim treasure',before_claim)\n    check('all 175 production route actions accepted',accepted==175)\n    check('normal route wins three-floor campaign',s['phase']=='victory' and s['floor']==2 and s['shared']['treasureClaimed'])\n    check('normal route exercises both channels',s['stats']['damageWar']>0 and s['stats']['damageSpirit']>0)\n    check('normal route covers gate, secret and recovery',s['stats']['gates']==1 and s['stats']['secrets']==1 and s['stats']['rests']>=8)\n    check('all ordinary roles and boss defeated',s['stats']['enemies']==8 and s['stats']['bossPhases']==2)\n    check('normal route used no invulnerability or tuning',not s['modified'] and not s['invulnerable'])\n    check('victory screen provides run summary',page.evaluate('__app.ui.shell.screen')=='victory')\n    page.get_by_role('button',name='Continue in the vault',exact=True).click();page.wait_for_timeout(100)\n    check('victory continuation actually reopens exploration',page.evaluate('__app.state.phase===\\\"explore\\\" && __app.state.shared.treasureClaimed && __app.state.completed'))\n    check('completed vault permits movement',send(page,{'type':'move','dx':-1,'dy':0})['ok'])\n    # Exact serialized checkpoint roundtrip, corruption rejection, and floor retry.\n    saved=page.evaluate('__app.net.model.exportSave()')\n    roundtrip=page.evaluate('''save=>{const m=new __DANGER.Model();const r=m.load(save);return{ok:r.ok,equal:JSON.stringify(m.snapshot())===JSON.stringify(save.state),retry:m.retry().ok,health:m.state.players['0'].war}}''',saved)\n    check('save/load roundtrip preserves authoritative state',roundtrip['ok'] and roundtrip['equal'])\n    check('floor-entry retry restores viable strength',roundtrip['retry'] and roundtrip['health']>0)\n    check('corrupt save is refused gracefully',page.evaluate('(()=>{const m=new __DANGER.Model();return m.load({garbage:true}).ok===false})()'))\n    # Audio from real gesture plus OfflineAudioContext checks all generated samples.\n    page.mouse.click(1100,100)\n    page.evaluate('__app.audio.unlock()')\n    audio=page.evaluate('__app.audio.offlineProbe()');evidence['audio']=audio\n    check('synthesized audio finite, nonzero and unclipped',audio.get('pass') is True,audio)\n    check('fresh default music remains 10%',page.evaluate('__app.game.settings.music')==.10)\n    # Attract has exact inactivity boundary and input is consumed on exit.\n    original_save=page.evaluate('localStorage.getItem(\\\"danger-expedition-v1\\\")')\n    page.evaluate('__app.returnTitle();__DANGER.setIdle(9900);__app.update(0)')\n    check('attract does not start before 10-second boundary',page.evaluate('\"'!__app.attract'\"'))\n    page.evaluate('__DANGER.setIdle(10001);__app.update(0)')\n    check('attract starts at 10-second boundary',page.evaluate('__app.attract'))\n    page.evaluate('__app.attractStep(6001)')\n    check('attract demonstrates pack',page.evaluate('__app.ui.shell.screen')=='pack')\n    page.evaluate('__app.attractStep(24000)')\n    check('attract reaches guardian preview',page.evaluate('__app.state.floor')==2)\n    page.keyboard.press('Enter');page.wait_for_timeout(120)\n    check('any input exits attract and is consumed',page.evaluate('__app.stage===\\\"title\\\" && \"'!__app.attract && __app.ui.shell.screen===\"title\"'\"'))\n    check('attract never overwrites solo save',page.evaluate('localStorage.getItem(\\\"danger-expedition-v1\\\")')==original_save)\n    check('no game or page exceptions on complete solo/input/audio path',not errors and page.evaluate('__app.game.errors.length')==0,errors)\n    evidence['fileRequests']=requests;evidence['fileErrors']=errors\n    # Blocked persistence must remain playable.\n    context.close()\n    blocked=browser.new_context(viewport={'width':960,'height':640})\n    blocked.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new DOMException('blocked','SecurityError')}})\\\")\n    bp=blocked.new_page();ready(bp,ARTIFACT.as_uri()+'?backend=webgl');bp.evaluate('__app.newSolo(false)')\n    check('blocked localStorage still permits a complete playable model',bp.evaluate('__app.player.war===36 && __app.persistence===false'))\n    blocked.close();browser.close()\n\ndef touch_checks(pw):\n    browser=pw.chromium.launch(headless=True,args=FLAGS)\n    for device in ['iPhone 13','iPad (gen 7)']:\n        context=browser.new_context(**pw.devices[device]);page=context.new_page()\n        ready(page,ARTIFACT.as_uri()+'?backend=webgl')\n        page.get_by_role('button',name='Begin expedition',exact=True).tap();page.get_by_role('button',name='Enter the vault',exact=True).tap()\n        page.touchscreen.tap(15,200);page.wait_for_timeout(100)\n        check(device+' touch uses minimal contextual HUD',page.evaluate('__app.lastInput===\\\"touch\\\"') and page.locator('#menu-button').is_visible())\n        check(device+' no permanent movement button bank',page.locator('#e3-touch').count()==0 or not page.locator('#e3-touch').is_visible())\n        # Multi-pointer production events exercise invisible left movement + right look.\n        before=page.evaluate('({y:__app.player.y,yaw:__app.view.yawOffset})')\n        page.evaluate('''()=>{const c=document.getElementById('screen');const ev=(type,id,x,y)=>c.dispatchEvent(new PointerEvent(type,{pointerId:id,pointerType:'touch',isPrimary:id===11,clientX:x,clientY:y,bubbles:true,cancelable:true}));ev('pointerdown',11,80,400);ev('pointerdown',12,300,400);ev('pointermove',11,80,350);ev('pointermove',12,340,400);ev('pointerup',11,80,350);ev('pointerup',12,340,400)}''')\n        after=page.evaluate('({y:__app.player.y,yaw:__app.view.yawOffset})')\n        check(device+' multitouch moves and looks independently',after['y']<before['y'] and after['yaw']\"'!=before['\"'yaw'],after)\n        page.locator('#menu-button').tap();page.wait_for_timeout(120)\n        check(device+' touch opens same pause menu',page.evaluate('__app.ui.shell.screen')=='pause')\n        page.get_by_role('button',name='The six-slot pack',exact=True).tap()\n        check(device+' touch opens same six-slot pack',page.evaluate('__app.ui.shell.screen')=='pack')\n        context.close()\n    browser.close()\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\n\ndef server_start():\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(WORK)))\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    return server,thread\n\ndef rtc_checks(pw):\n    server,thread=server_start();browser=pw.chromium.launch(headless=True,args=FLAGS)\n    url=f'http://127.0.0.1:{server.server_port}/'+urllib.parse.quote(CONFIG['html'])+'?backend=webgl'\n    try:\n        host=browser.new_context(viewport={'width':1100,'height':760});guest=browser.new_context(viewport={'width':1100,'height':760})\n        a=host.new_page();b=guest.new_page();errors=[]\n        a.on('pageerror',lambda e:errors.append('host: '+str(e)));b.on('pageerror',lambda e:errors.append('guest: '+str(e)))\n        ready(a,url);ready(b,url)\n        check('loopback server serves intended game',a.title()==CONFIG['title'] and b.title()==CONFIG['title'])\n        for page in [a,b]:page.get_by_role('button',name='Two adventurers',exact=True).click()\n        b.get_by_role('button',name='Join an expedition',exact=True).click()\n        b.locator('#invite-input').fill('damaged-code')\n        b.get_by_role('button',name='Create answer from offer',exact=True).click()\n        check('malformed invite remains recoverable in real UI',b.evaluate('__app.net.pc===null') and 'code' in b.locator('.connection-status').inner_text().lower())\n        a.get_by_role('button',name='Host an expedition',exact=True).click()\n        a.wait_for_function('document.querySelector(\\\"#invite-output\\\")?.value?.startsWith(\\\"DD1.O.\\\")',timeout=20000)\n        offer=a.locator('#invite-output').input_value()\n        b.locator('#invite-input').fill(offer);b.get_by_role('button',name='Create answer from offer',exact=True).click()\n        b.wait_for_function('document.querySelector(\\\"#invite-output\\\")?.value?.startsWith(\\\"DD1.A.\\\")',timeout=20000)\n        answer=b.locator('#invite-output').input_value()\n        a.locator('#invite-input').fill(answer);a.get_by_role('button',name='Connect using answer',exact=True).click()\n        for page in [a,b]:page.wait_for_function('__app.net.running && __app.stage===\\\"play\\\"',timeout=20000)\n        check('UI-exchanged WebRTC codes open actual data channel',a.evaluate('__app.net.channel.readyState')=='open' and b.evaluate('__app.net.channel.readyState')=='open')\n        check('separate browser peers own separate adventurers',a.evaluate('__app.net.localId')=='0' and b.evaluate('__app.net.localId')=='1')\n        # Follow commands through actual pads/UI and authority, never optimistic client awards.\n        b.keyboard.press('e');b.wait_for_function('__app.player.dir===1')\n        a.wait_for_function('__app.state.players[\\\"1\\\"].dir===1')\n        check('guest keyboard intent reaches authority',a.evaluate('__app.state.players[\\\"1\\\"].dir')==1)\n        a.keyboard.press('w');a.wait_for_function('__app.player.y===8');b.wait_for_function('__app.state.players[\\\"0\\\"].y===8')\n        check('host exploration movement is shared without timer',b.evaluate('__app.state.players[\\\"0\\\"].y')==8 and a.evaluate('__app.state.combat') is None)\n        a.evaluate('__app.ui.pause();__app.ui.settings()');a.wait_for_timeout(160)\n        check('online settings keep authority live',a.evaluate('__app.net.running && \"'!__app.net.paused'\"'))\n        b.keyboard.press('q');a.wait_for_function('__app.state.players[\\\"1\\\"].dir===0')\n        check('one player menu does not block companion input',a.evaluate('__app.state.players[\\\"1\\\"].dir')==0)\n        a.evaluate('__app.ui.hide()')\n        check('network state is never eligible for solo autosave',a.evaluate('\"'!__app.net.allowSoloSave'\"') and b.evaluate('\"'!__app.net.allowSoloSave'\"'))\n        # Set up contested pickup with legal exploration route and a stock pack.\n        # Browser setup snapshots are from production commands; full campaign stock proof is separate.\n        a.evaluate('''()=>{const m=__app.net.model;for(const id of ['0','1']){m.state.players[id].x=3;m.state.players[id].y=3;}m.state.combat=null;m.state.phase='explore';__app.net._emit();__app.net._publish(true)}''')\n        b.wait_for_function('__app.state.players[\\\"1\\\"].x===3 && __app.state.players[\\\"1\\\"].y===3')\n        send(a,{'type':'pickup','target':'upper.rune'});send(b,{'type':'pickup','target':'upper.rune'})\n        b.wait_for_function('__app.state.entities[\\\"upper.rune\\\"].claimed===true')\n        check('simultaneous loot has exactly one authoritative owner',a.evaluate('Object.values(__app.state.players).flatMap(p=>[...p.pack,...p.hands]).filter(i=>i===\\\"upper.rune.item\\\").length')==1)\n        # Hand off the rune via production transaction.\n        send(a,{'type':'handoff','item':'upper.rune.item','target':'1'});b.wait_for_function('__app.player.pack.includes(\\\"upper.rune.item\\\")')\n        check('nearby item handoff changes ownership on both peers',a.evaluate('\"'!__app.player.pack.includes(\"upper.rune.item\")'\"') and b.evaluate('__app.player.pack.includes(\\\"upper.rune.item\\\")'))\n        a.evaluate('''()=>{const m=__app.net.model;m.state.players['1'].war=0;m.state.players['1'].down=true;m.state.players['0'].food=0;__app.net._emit();__app.net._publish(true)}''')\n        check('no-food revive is rejected without counter loss',not send(a,{'type':'revive','target':'1'})['ok'] and a.evaluate('__app.player.food')==0)\n        a.evaluate('__app.net.model.state.players[\\\"0\\\"].food=2')\n        check('revive from depleted War restores both pools',send(a,{'type':'revive','target':'1'})['ok'])\n        b.wait_for_function('\"'!__app.player.down && __app.player.war>0 && __app.player.spirit>0'\"')\n        a.evaluate('''()=>{const m=__app.net.model;m.state.players['1'].spirit=0;m.state.players['1'].down=true;__app.net._emit();__app.net._publish(true)}''')\n        check('revive from depleted Spirit restores both pools',send(a,{'type':'revive','target':'1'})['ok'])\n        b.wait_for_function('\"'!__app.player.down && __app.player.spirit>0'\"')\n        # Departure preserves shared objectives and recovers stable inventory in reachable bags.\n        b.evaluate('__app.net.close()');a.wait_for_function('__app.state.players[\\\"1\\\"].connected===false')\n        check('guest departure does not end host expedition',a.evaluate('__app.net.running && \"'!__app.net.ended && __app.state.phase!==\"ended\"'\"'))\n        check('departed gear recovered in stable world loot',a.evaluate('Object.values(__app.state.entities).some(e=>e.type===\\\"loot\\\" && e.itemId===\\\"upper.rune.item\\\" && \"'!e.claimed)'\"'))\n        check('network-origin continuation still cannot overwrite solo save',a.evaluate('\"'!__app.net.allowSoloSave'\"'))\n        evidence['rtcDiagnostics']=a.evaluate('__app.net.diagnostics()')\n        check('real RTC produces no page exceptions',not errors,errors)\n        host.close();guest.close()\n    finally:\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ndef hub_checks(pw):\n    server,thread=server_start();browser=pw.chromium.launch(headless=True,args=FLAGS)\n    base=f'http://127.0.0.1:{server.server_port}'\n    harness='/'+ROOT.name+'/vendor/hub/harness.html'\n    game='/'+CONFIG['html']+'?backend=webgl'\n    reports=[]\n    try:\n        for name,extra in [('standard',''),('impaired','&latency=150&jitter=50&loss=5'),('host-leave','&scenario=host-leave'),('server','&scenario=server&latency=150&jitter=50&loss=5'),('solo-hub','')]:\n            context=browser.new_context(viewport={'width':1280,'height':800});page=context.new_page()\n            players=1 if name=='solo-hub' else 2\n            url=base+harness+'?game='+urllib.parse.quote(game,safe='')+f'&players={players}&auto=1&play=2500'+extra\n            page.goto(url,wait_until='load')\n            page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=90000)\n            r=page.evaluate('window.__hubCheck');r['scenarioName']=name;reports.append(r)\n            check('final artifact official Hub '+name,r.get('pass') is True,[c for c in r.get('checks',[]) if not c['pass']])\n            diagnostics=[]\n            for frame in page.frames[1:]:\n                try:\n                    d=frame.evaluate('__app.net.diagnostics()');diagnostics.append(d)\n                    check(name+' copy stops simulation/outgoing on end',d['ended'] and not d['running'] and d['queue']==0)\n                    check(name+' traffic within Hub limits',d['traffic']['maxBytes']<=16384 and d['traffic']['maxPerSecond']<=20,d['traffic'])\n                    if d['server']:check('Hub server authority creates no renderer/audio',frame.evaluate('__app.game===null && __app.view===null && __app.audio===null'))\n                    elif frame.evaluate('__app.game\"'!==null'\"'):check(name+' native world has no engine exceptions',frame.evaluate('__app.game.errors.length')==0)\n                except Exception as exc:\n                    if name\"'!='\"'host-leave':check(name+' diagnostics reachable',False,str(exc))\n            r['diagnostics']=diagnostics\n            context.close()\n        # A full normal-rules Hub victory within real session time, with a legitimate one-seat session.\n        context=browser.new_context(viewport={'width':1100,'height':760});page=context.new_page()\n        page.goto(base+harness+'?game='+urllib.parse.quote(game,safe='')+'&players=1&limit=600')\n        page.locator('#restart').click()\n        page.wait_for_function('document.querySelector(\\\"iframe\\\")?.contentWindow?.__gameReady===true',timeout=60000)\n        page.locator('#release').click()\n        frame=page.frames[1];frame.wait_for_function('__app.net.running===true',timeout=15000)\n        check('Hub begins automatically without title or attract',frame.evaluate('__app.stage===\\\"play\\\" && \"'!__app.attract && !__app.ui.shell.screen'\"'))\n        run=frame.evaluate('__app.state.runId');actions=json.loads(json.dumps(FIXTURE['actions']).replace(FIXTURE['run'],run));accepted=0\n        for entry in actions:\n            r=send(frame,entry['action'])\n            if not r or not r.get('ok'):raise RuntimeError('Hub route rejected '+str(entry['action'])+' '+str(r))\n            accepted+=1\n        frame.wait_for_function('__app.net.ended===true',timeout=10000)\n        check('stock full campaign wins under actual Hub clock',frame.evaluate('__app.state.shared.treasureClaimed && AIHub.time()<AIHub.limitMs') and accepted==175)\n        check('Hub result authority calls finish exactly once',frame.evaluate('__app.net._finished===true && __app.net.isHost'))\n        context.close()\n    finally:\n        evidence['hubReports']=reports\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ndef browser_fallbacks(pw):\n    # WebGPU state can be tested independently from unreliable headless captures.\n    browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n    page=browser.new_page(viewport={'width':960,'height':640})\n    try:\n        ready(page,ARTIFACT.as_uri())\n        page.evaluate('__app.newSolo(false)')\n        check('native WebGPU path boots and advances gameplay',page.evaluate('__app.view.rendererName')=='WebGPU' and send(page,{'type':'move','dx':0,'dy':-1})['ok'])\n    finally:browser.close()\n    browser=pw.webkit.launch(headless=True)\n    page=browser.new_page(viewport={'width':1024,'height':768})\n    try:\n        ready(page,ARTIFACT.as_uri()+'?backend=webgl');page.evaluate('__app.newSolo(false)')\n        check('WebKit available WebGL2 path plays same rules',page.evaluate('__app.view.rendererName')=='WebGL 2' and send(page,{'type':'move','dx':0,'dy':-1})['ok'])\n    finally:browser.close()\n    browser=pw.firefox.launch(headless=True)\n    page=browser.new_page(viewport={'width':960,'height':640})\n    try:\n        page.goto(ARTIFACT.as_uri()+'?backend=webgl');page.wait_for_function('window.__gameReady||window.__bootError',timeout=60000)\n        check('unsupported Firefox displays actionable renderer message',page.evaluate('\"'!!window.__bootError'\"') and page.get_by_role('button',name='Retry loading').is_visible())\n    finally:browser.close()\n\nselected=sys.argv[1:] or ['file','touch','rtc','hub','fallbacks']\nwith sync_playwright() as pw:\n    for name,fn in [('file',file_checks),('touch',touch_checks),('rtc',rtc_checks),('hub',hub_checks),('fallbacks',browser_fallbacks)]:\n        if name in selected:safe(name+' check group completed',lambda fn=fn:fn(pw))\noutput={'checks':checks,'evidence':evidence,'passed':sum(c['pass'] for c in checks),'failed':sum(not c['pass'] for c in checks),'total':len(checks)}\n(ROOT/'evidence'/('release-'+ '-'.join(selected)+'.json')).write_text(json.dumps(output,indent=2,ensure_ascii=False))\nfor c in checks:\n    if not c['pass']:print('FAIL '+c['name']+': '+c['detail'])\nprint(f'{output[\\\"passed\\\"]}/{len(checks)} browser checks passed; {output[\\\"failed\\\"]} failures')\nraise SystemExit(1 if output['failed'] else 0)\nPY\ncat > tools/verify.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { spawnSync } from 'node:child_process';\nimport { runRuleTests } from './rules-test.mjs';\nimport { runNetworkTests } from './net-test.mjs';\nimport { scriptedRoute } from './route.mjs';\nimport { Model } from '../src/core/model.js';\nprocess.chdir(path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'));\nconst failures=[];let total=0;\nconst rules=runRuleTests();total+=rules.count;failures.push(...rules.failures);\nconst net=await runNetworkTests();total+=net.total;failures.push(...net.failures);\nconst r=scriptedRoute(new Model({seed:43021,runId:'browser-route'}));fs.mkdirSync('build',{recursive:true});fs.writeFileSync('build/route-fixture.json',JSON.stringify({run:'browser-route',...r}));\nconst config=JSON.parse(fs.readFileSync('build-config.json','utf8'));\nconst artifact=path.resolve('..',config.html),interview=path.resolve('..','exit-interview.json');\nfunction check(name,fn){total++;try{if(\"'!fn())failures.push(name);}catch(e){failures.push(name+'\"': '+e.message);}}\ncheck('delivery artifact exists',()=>fs.statSync(artifact).size>1000000);\ncheck('canonical JSON report matches delivery',()=>JSON.stringify(JSON.parse(fs.readFileSync(interview)))===JSON.stringify(JSON.parse(fs.readFileSync('src/report.json'))));\ncheck('report required shapes/usage',()=>{const r=JSON.parse(fs.readFileSync(interview));return Object.keys(r).join(',')==='sourceInformation,testingFeedback,engineFeedback,promptFeedback,aiHub'&&Object.keys(r.sourceInformation).length===16&&r.sourceInformation.usage==='added on import'&&r.testingFeedback.length===4&&r.engineFeedback.length===6&&r.promptFeedback.length===4&&r.aiHub.tags.length>=3&&r.aiHub.tags.length<=6;});\ncheck('unmodified session client is first head script',()=>{const h=fs.readFileSync(artifact,'utf8'),s=fs.readFileSync('vendor/hub/session.js','utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script');return h.includes('<meta charset=\\\"utf-8\\\">\\\\n<script>'+s+'</script>');});\ncheck('all runtime module and WASM dependencies bundled',()=>{const h=fs.readFileSync(artifact,'utf8');return \"'!/<script[''^>]+src=/.test(h)&&!/<link[''^>]+href=/.test(h)&&!/<script[''^>]*type=\"module\"/.test(h);});\nif(!process.argv.includes('\"'--rules')){\nconst groups=process.argv.slice(2).filter(a=>\"'!a.startsWith('\"'--'));\nconst p=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tools/browser-test.py',...groups],{encoding:'utf8',maxBuffer:6000000,timeout:600000});\nconst file='evidence/release-'+(groups.length?groups:['file','touch','rtc','hub','fallbacks']).join('-')+'.json';\nif(fs.existsSync(file)){const report=JSON.parse(fs.readFileSync(file));total+=report.total;failures.push(...report.checks.filter(c=>\"'!c.pass).map(c=>c.name+'\"': '+c.detail));}else failures.push('Browser runner failed to produce evidence: '+p.stdout+' '+p.stderr);\nif(p.status\"'!==0&&!fs.existsSync(file))failures.push('\"'Browser runner exit '+p.status);\n}\nfor(const f of failures)console.error('FAIL '+f);\nconsole.log(\"'`${total-failures.length}/${total} checks passed; ${failures.length} failures.`);\nprocess.exitCode=failures.length?1:0;\nEOF\nnode --check tools/verify.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > tools/browser-test.py <<'PY'\n\\\"\\\"\\\"Release checks use the delivered HTML and production commands. No route cheats.\\\"\\\"\\\"\nfrom pathlib import Path\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nWORK=ROOT.parent\nCONFIG=json.loads((ROOT/'build-config.json').read_text())\nARTIFACT=WORK/CONFIG['html']\nREPORT=json.loads((ROOT/'src/report.json').read_text())\nFIXTURE=json.loads((ROOT/'build/route-fixture.json').read_text())\nchecks=[]\nevidence={}\n\ndef check(name, passed, detail=''):\n    checks.append({'name':name,'pass':bool(passed),'detail':str(detail)[:1800]})\n\ndef safe(name,fn):\n    try:\n        fn()\n    except Exception as exc:\n        check(name,False,str(exc))\n\nPAD=\\\"\\\"\\\"window.__pad=null;Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});window.pad=(button=-1,axes=[0,0,0,0])=>window.__pad={id:'DualSense standard emulation',index:0,mapping:'standard',connected:true,timestamp:performance.now(),axes,buttons:Array.from({length:18},(_,i)=>({pressed:i===button,touched:i===button,value:i===button?1:0}))};\\\"\\\"\\\"\nFLAGS=['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']\n\ndef ready(page,url):\n    page.goto(url,wait_until='load',timeout=60000)\n    page.wait_for_function('window.__gameReady || window.__bootError',timeout=60000)\n    if page.evaluate('window.__bootError || null'):\n        raise RuntimeError(page.evaluate('window.__bootError'))\n\ndef state(page):\n    return page.evaluate('__app.state')\n\ndef send(page,action):\n    return page.evaluate('(a)=>__DANGER.send(a)',action)\n\ndef idle_stop(page):\n    page.evaluate('__app.lastActivity=performance.now()')\n\ndef file_checks(pw):\n    browser=pw.chromium.launch(headless=True,args=FLAGS)\n    context=browser.new_context(viewport={'width':1280,'height':720})\n    context.add_init_script(PAD)\n    page=context.new_page(); errors=[];requests=[]\n    page.on('pageerror',lambda exc:errors.append(str(exc)))\n    page.on('request',lambda req:requests.append(req.url))\n    ready(page,ARTIFACT.as_uri()+'?backend=webgl')\n    check('file:// final artifact boots native World3D',page.evaluate('__app.view.rendererName')=='WebGL 2')\n    check('native engine version pinned',page.evaluate('My3D2dge.version')=='0.89.1')\n    check('fresh music gain defaults to 0.10',page.evaluate('__app.game.settings.music')==.10)\n    check('fresh PS glyph setting',page.evaluate('__app.game.settings.glyphs')=='playstation')\n    check('canonical embedded report equals delivered JSON',page.evaluate('JSON.parse(document.getElementById(\\\"game-credits\\\").textContent)')==REPORT)\n    check('offline artifact requests no neighbors or CDN',all(u.startswith(ARTIFACT.as_uri()) or u.startswith('data:') or u.startswith('blob:') for u in requests),requests)\n    page.wait_for_timeout(80)\n    bounds=page.evaluate('''()=>[...document.querySelectorAll('.esh-ttl .esh-btns button')].map(b=>{const r=b.getBoundingClientRect();return{label:b.textContent,bottom:r.bottom,right:r.right,top:r.top}})''')\n    check('title choices fit viewport',all(b['bottom']<=724 and b['top']>=0 for b in bounds),bounds)\n    # A standard-mapping pad selects the same title and starts the same expedition.\n    page.evaluate('pad(0)');page.wait_for_timeout(120);page.evaluate('pad()')\n    page.wait_for_function('__app.stage===\\\"play\\\"',timeout=10000)\n    check('standard gamepad starts expedition',page.evaluate('__app.ui.shell.screen')=='briefing')\n    page.evaluate('pad(0)');page.wait_for_timeout(100);page.evaluate('pad()');page.wait_for_timeout(150)\n    check('pad confirms briefing',page.evaluate('__app.ui.shell.screen') is None)\n    check('gamepad prompt uses PlayStation glyphs',page.evaluate('__app.game.input.lastDevice===\\\"gamepad\\\" && __app.ui.label(\\\"pack\\\").includes(\\\"△\\\")'))\n    page.evaluate('__app.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")');page.wait_for_timeout(80)\n    check('Xbox glyph option changes prompt',page.evaluate('__app.ui.label(\\\"pack\\\")') in ['Y','Y / I','Y / Tab'])\n    page.evaluate('__app.game.settings.set(\\\"glyphs\\\",\\\"playstation\\\");window.__pad=null')\n    page.wait_for_timeout(100)\n    check('controller disconnect preserves run',page.evaluate('__app.state.phase===\\\"explore\\\" && __app.state.players[\\\"0\\\"].war===36'))\n    page.evaluate('pad()');page.wait_for_timeout(100)\n    page.keyboard.press('w');page.wait_for_timeout(180)\n    check('keyboard W moves logical tile north',page.evaluate('__app.player.y')==8)\n    page.keyboard.press('e');page.wait_for_timeout(100)\n    check('quarter turn E is free',page.evaluate('__app.player.dir===1 && __app.state.stats.rounds===0'))\n    page.keyboard.press('q');page.wait_for_timeout(100)\n    check('quarter turn Q restores heading',page.evaluate('__app.player.dir')==0)\n    page.keyboard.press('Tab');page.wait_for_timeout(160)\n    check('Tab opens actual six-slot pack',page.evaluate('__app.ui.shell.screen')=='pack' and page.evaluate('__app.player.pack.length')==6)\n    check('pack has two visible hand indicators',page.locator('.pack-summary').count()==1)\n    page.keyboard.press('Escape');page.wait_for_timeout(100)\n    page.keyboard.press('Escape');page.wait_for_timeout(150)\n    check('pause persists through native shell lifecycle',page.evaluate('__app.ui.shell.screen===\\\"pause\\\" && __app.game.paused && __app.net.paused'))\n    page.get_by_role('button',name='Expedition tools',exact=True).click();page.wait_for_timeout(120)\n    check('developer mode reachable through pause',page.evaluate('__app.ui.shell.screen')=='dev')\n    slider=page.get_by_role('slider',name='Player damage ×',exact=True)\n    slider.fill('1.5');slider.dispatch_event('input')\n    check('live tuning changes production multiplier',page.evaluate('__app.state.tuning.playerDamage===1.5 && __app.state.modified'))\n    page.get_by_role('button',name='Reset tuning to defaults',exact=True).click();page.wait_for_timeout(100)\n    check('tuning reset restores canonical values',page.evaluate('JSON.stringify(__app.state.tuning)===JSON.stringify(__DANGER.CONTENT.tuning)'))\n    page.get_by_role('button',name='Content workshop',exact=True).click();page.wait_for_timeout(120)\n    check('designer workflow has tile/entity preview',page.locator('.editor-grid button').count()==121 and page.locator('#editor-entity option').count()>0)\n    page.get_by_role('button',name='Validate content',exact=True).click()\n    check('shipped content validates in workshop',page.locator('.editor-log').inner_text().startswith('Valid:'))\n    # Native Controls rebinding enters the same production input map.\n    page.evaluate('__app.ui.hide();__app.ui.show(\\\"controls\\\")');page.wait_for_timeout(120)\n    result=page.evaluate('__app.game.input.rebind(\\\"interact\\\",\\\"keys\\\",\\\"KeyB\\\")')\n    check('native rebinding accepts conflict-free key',result is None)\n    page.evaluate('__app.game.input.lastDevice=\\\"keyboard\\\"')\n    check('rebound prompts follow key',page.evaluate('__app.ui.label(\\\"interact\\\")')=='B')\n    page.evaluate('__app.game.input.resetBindings();__app.ui.hide();__app.game.resume();__app.newSolo(false)')\n    # One complete stock-balance run, including both boss state boundaries.\n    run_id=page.evaluate('__app.state.runId')\n    actions=json.loads(json.dumps(FIXTURE['actions']).replace(FIXTURE['run'],run_id))\n    before_claim=False;accepted=0\n    for i,entry in enumerate(actions):\n        action=entry['action']\n        if action.get('type')=='interact' and action.get('target')=='guardian.treasure':\n            before_claim=page.evaluate('__app.state.shared.bossDefeated && \"'!__app.state.shared.treasureClaimed && __app.state.phase===\"explore\"'\"')\n        r=send(page,action)\n        if not r or not r.get('ok'):\n            raise RuntimeError(f'Normal route action {i}: {action}: {r}')\n        accepted+=1\n        if i%18==0:page.wait_for_timeout(20)\n    page.wait_for_timeout(250)\n    s=state(page);evidence['soloSummary']={'actions':accepted,'stats':s['stats'],'war':s['players']['0']['war'],'spirit':s['players']['0']['spirit'],'clockMs':s['clock']}\n    check('boss death does not silently claim treasure',before_claim)\n    check('all 175 production route actions accepted',accepted==175)\n    check('normal route wins three-floor campaign',s['phase']=='victory' and s['floor']==2 and s['shared']['treasureClaimed'])\n    check('normal route exercises both channels',s['stats']['damageWar']>0 and s['stats']['damageSpirit']>0)\n    check('normal route covers gate, secret and recovery',s['stats']['gates']==1 and s['stats']['secrets']==1 and s['stats']['rests']>=8)\n    check('all ordinary roles and boss defeated',s['stats']['enemies']==8 and s['stats']['bossPhases']==2)\n    check('normal route used no invulnerability or tuning',not s['modified'] and not s['invulnerable'])\n    check('victory screen provides run summary',page.evaluate('__app.ui.shell.screen')=='victory')\n    page.get_by_role('button',name='Continue in the vault',exact=True).click();page.wait_for_timeout(100)\n    check('victory continuation actually reopens exploration',page.evaluate('__app.state.phase===\\\"explore\\\" && __app.state.shared.treasureClaimed && __app.state.completed'))\n    check('completed vault permits movement',send(page,{'type':'move','dx':-1,'dy':0})['ok'])\n    # Exact serialized checkpoint roundtrip, corruption rejection, and floor retry.\n    saved=page.evaluate('__app.net.model.exportSave()')\n    roundtrip=page.evaluate('''save=>{const m=new __DANGER.Model();const r=m.load(save);return{ok:r.ok,equal:JSON.stringify(m.snapshot())===JSON.stringify(save.state),retry:m.retry().ok,health:m.state.players['0'].war}}''',saved)\n    check('save/load roundtrip preserves authoritative state',roundtrip['ok'] and roundtrip['equal'])\n    check('floor-entry retry restores viable strength',roundtrip['retry'] and roundtrip['health']>0)\n    check('corrupt save is refused gracefully',page.evaluate('(()=>{const m=new __DANGER.Model();return m.load({garbage:true}).ok===false})()'))\n    # Audio from real gesture plus OfflineAudioContext checks all generated samples.\n    page.mouse.click(1100,100)\n    page.evaluate('__app.audio.unlock()')\n    audio=page.evaluate('__app.audio.offlineProbe()');evidence['audio']=audio\n    check('synthesized audio finite, nonzero and unclipped',audio.get('pass') is True,audio)\n    check('fresh default music remains 10%',page.evaluate('__app.game.settings.music')==.10)\n    # Attract has exact inactivity boundary and input is consumed on exit.\n    original_save=page.evaluate('localStorage.getItem(\\\"danger-expedition-v1\\\")')\n    page.evaluate('__app.returnTitle();__DANGER.setIdle(9900);__app.update(0)')\n    check('attract does not start before 10-second boundary',page.evaluate('\"'!__app.attract'\"'))\n    page.evaluate('__DANGER.setIdle(10001);__app.update(0)')\n    check('attract starts at 10-second boundary',page.evaluate('__app.attract'))\n    page.evaluate('__app.attractStep(6001)')\n    check('attract demonstrates pack',page.evaluate('__app.ui.shell.screen')=='pack')\n    page.evaluate('__app.attractStep(24000)')\n    check('attract reaches guardian preview',page.evaluate('__app.state.floor')==2)\n    page.keyboard.press('Enter');page.wait_for_timeout(120)\n    check('any input exits attract and is consumed',page.evaluate('__app.stage===\\\"title\\\" && \"'!__app.attract && __app.ui.shell.screen===\"title\"'\"'))\n    check('attract never overwrites solo save',page.evaluate('localStorage.getItem(\\\"danger-expedition-v1\\\")')==original_save)\n    check('no game or page exceptions on complete solo/input/audio path',not errors and page.evaluate('__app.game.errors.length')==0,errors)\n    evidence['fileRequests']=requests;evidence['fileErrors']=errors\n    # Blocked persistence must remain playable.\n    context.close()\n    blocked=browser.new_context(viewport={'width':960,'height':640})\n    blocked.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new DOMException('blocked','SecurityError')}})\\\")\n    bp=blocked.new_page();ready(bp,ARTIFACT.as_uri()+'?backend=webgl');bp.evaluate('__app.newSolo(false)')\n    check('blocked localStorage still permits a complete playable model',bp.evaluate('__app.player.war===36 && __app.persistence===false'))\n    blocked.close();browser.close()\n\ndef touch_checks(pw):\n    browser=pw.chromium.launch(headless=True,args=FLAGS)\n    for device in ['iPhone 13','iPad (gen 7)']:\n        context=browser.new_context(**pw.devices[device]);page=context.new_page()\n        ready(page,ARTIFACT.as_uri()+'?backend=webgl')\n        page.get_by_role('button',name='Begin expedition',exact=True).tap();page.get_by_role('button',name='Enter the vault',exact=True).tap()\n        page.touchscreen.tap(15,200);page.wait_for_timeout(100)\n        check(device+' touch uses minimal contextual HUD',page.evaluate('__app.lastInput===\\\"touch\\\"') and page.locator('#menu-button').is_visible())\n        check(device+' no permanent movement button bank',page.locator('#e3-touch').count()==0 or not page.locator('#e3-touch').is_visible())\n        # Multi-pointer production events exercise invisible left movement + right look.\n        before=page.evaluate('({y:__app.player.y,yaw:__app.view.yawOffset})')\n        page.evaluate('''()=>{const c=document.getElementById('screen');const ev=(type,id,x,y)=>c.dispatchEvent(new PointerEvent(type,{pointerId:id,pointerType:'touch',isPrimary:id===11,clientX:x,clientY:y,bubbles:true,cancelable:true}));ev('pointerdown',11,80,400);ev('pointerdown',12,300,400);ev('pointermove',11,80,350);ev('pointermove',12,340,400);ev('pointerup',11,80,350);ev('pointerup',12,340,400)}''')\n        after=page.evaluate('({y:__app.player.y,yaw:__app.view.yawOffset})')\n        check(device+' multitouch moves and looks independently',after['y']<before['y'] and after['yaw']\"'!=before['\"'yaw'],after)\n        page.locator('#menu-button').tap();page.wait_for_timeout(120)\n        check(device+' touch opens same pause menu',page.evaluate('__app.ui.shell.screen')=='pause')\n        page.get_by_role('button',name='The six-slot pack',exact=True).tap()\n        check(device+' touch opens same six-slot pack',page.evaluate('__app.ui.shell.screen')=='pack')\n        context.close()\n    browser.close()\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\n\ndef server_start():\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(WORK)))\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    return server,thread\n\ndef rtc_checks(pw):\n    server,thread=server_start();browser=pw.chromium.launch(headless=True,args=FLAGS)\n    url=f'http://127.0.0.1:{server.server_port}/'+urllib.parse.quote(CONFIG['html'])+'?backend=webgl'\n    try:\n        host=browser.new_context(viewport={'width':1100,'height':760});guest=browser.new_context(viewport={'width':1100,'height':760})\n        a=host.new_page();b=guest.new_page();errors=[]\n        a.on('pageerror',lambda e:errors.append('host: '+str(e)));b.on('pageerror',lambda e:errors.append('guest: '+str(e)))\n        ready(a,url);ready(b,url)\n        check('loopback server serves intended game',a.title()==CONFIG['title'] and b.title()==CONFIG['title'])\n        for page in [a,b]:page.get_by_role('button',name='Two adventurers',exact=True).click()\n        b.get_by_role('button',name='Join an expedition',exact=True).click()\n        b.locator('#invite-input').fill('damaged-code')\n        b.get_by_role('button',name='Create answer from offer',exact=True).click()\n        check('malformed invite remains recoverable in real UI',b.evaluate('__app.net.pc===null') and 'code' in b.locator('.connection-status').inner_text().lower())\n        a.get_by_role('button',name='Host an expedition',exact=True).click()\n        a.wait_for_function('document.querySelector(\\\"#invite-output\\\")?.value?.startsWith(\\\"DD1.O.\\\")',timeout=20000)\n        offer=a.locator('#invite-output').input_value()\n        b.locator('#invite-input').fill(offer);b.get_by_role('button',name='Create answer from offer',exact=True).click()\n        b.wait_for_function('document.querySelector(\\\"#invite-output\\\")?.value?.startsWith(\\\"DD1.A.\\\")',timeout=20000)\n        answer=b.locator('#invite-output').input_value()\n        a.locator('#invite-input').fill(answer);a.get_by_role('button',name='Connect using answer',exact=True).click()\n        for page in [a,b]:page.wait_for_function('__app.net.running && __app.stage===\\\"play\\\"',timeout=20000)\n        check('UI-exchanged WebRTC codes open actual data channel',a.evaluate('__app.net.channel.readyState')=='open' and b.evaluate('__app.net.channel.readyState')=='open')\n        check('separate browser peers own separate adventurers',a.evaluate('__app.net.localId')=='0' and b.evaluate('__app.net.localId')=='1')\n        # Follow commands through actual pads/UI and authority, never optimistic client awards.\n        b.keyboard.press('e');b.wait_for_function('__app.player.dir===1')\n        a.wait_for_function('__app.state.players[\\\"1\\\"].dir===1')\n        check('guest keyboard intent reaches authority',a.evaluate('__app.state.players[\\\"1\\\"].dir')==1)\n        a.keyboard.press('w');a.wait_for_function('__app.player.y===8');b.wait_for_function('__app.state.players[\\\"0\\\"].y===8')\n        check('host exploration movement is shared without timer',b.evaluate('__app.state.players[\\\"0\\\"].y')==8 and a.evaluate('__app.state.combat') is None)\n        a.evaluate('__app.ui.pause();__app.ui.settings()');a.wait_for_timeout(160)\n        check('online settings keep authority live',a.evaluate('__app.net.running && \"'!__app.net.paused'\"'))\n        b.keyboard.press('q');a.wait_for_function('__app.state.players[\\\"1\\\"].dir===0')\n        check('one player menu does not block companion input',a.evaluate('__app.state.players[\\\"1\\\"].dir')==0)\n        a.evaluate('__app.ui.hide()')\n        check('network state is never eligible for solo autosave',a.evaluate('\"'!__app.net.allowSoloSave'\"') and b.evaluate('\"'!__app.net.allowSoloSave'\"'))\n        # Set up contested pickup with legal exploration route and a stock pack.\n        # Browser setup snapshots are from production commands; full campaign stock proof is separate.\n        a.evaluate('''()=>{const m=__app.net.model;for(const id of ['0','1']){m.state.players[id].x=3;m.state.players[id].y=3;}m.state.combat=null;m.state.phase='explore';__app.net._emit();__app.net._publish(true)}''')\n        b.wait_for_function('__app.state.players[\\\"1\\\"].x===3 && __app.state.players[\\\"1\\\"].y===3')\n        send(a,{'type':'pickup','target':'upper.rune'});send(b,{'type':'pickup','target':'upper.rune'})\n        b.wait_for_function('__app.state.entities[\\\"upper.rune\\\"].claimed===true')\n        check('simultaneous loot has exactly one authoritative owner',a.evaluate('Object.values(__app.state.players).flatMap(p=>[...p.pack,...p.hands]).filter(i=>i===\\\"upper.rune.item\\\").length')==1)\n        # Hand off the rune via production transaction.\n        send(a,{'type':'handoff','item':'upper.rune.item','target':'1'});b.wait_for_function('__app.player.pack.includes(\\\"upper.rune.item\\\")')\n        check('nearby item handoff changes ownership on both peers',a.evaluate('\"'!__app.player.pack.includes(\"upper.rune.item\")'\"') and b.evaluate('__app.player.pack.includes(\\\"upper.rune.item\\\")'))\n        a.evaluate('''()=>{const m=__app.net.model;m.state.players['1'].war=0;m.state.players['1'].down=true;m.state.players['0'].food=0;__app.net._emit();__app.net._publish(true)}''')\n        check('no-food revive is rejected without counter loss',not send(a,{'type':'revive','target':'1'})['ok'] and a.evaluate('__app.player.food')==0)\n        a.evaluate('__app.net.model.state.players[\\\"0\\\"].food=2')\n        check('revive from depleted War restores both pools',send(a,{'type':'revive','target':'1'})['ok'])\n        b.wait_for_function('\"'!__app.player.down && __app.player.war>0 && __app.player.spirit>0'\"')\n        a.evaluate('''()=>{const m=__app.net.model;m.state.players['1'].spirit=0;m.state.players['1'].down=true;__app.net._emit();__app.net._publish(true)}''')\n        check('revive from depleted Spirit restores both pools',send(a,{'type':'revive','target':'1'})['ok'])\n        b.wait_for_function('\"'!__app.player.down && __app.player.spirit>0'\"')\n        # Departure preserves shared objectives and recovers stable inventory in reachable bags.\n        b.evaluate('__app.net.close()');a.wait_for_function('__app.state.players[\\\"1\\\"].connected===false')\n        check('guest departure does not end host expedition',a.evaluate('__app.net.running && \"'!__app.net.ended && __app.state.phase!==\"ended\"'\"'))\n        check('departed gear recovered in stable world loot',a.evaluate('Object.values(__app.state.entities).some(e=>e.type===\\\"loot\\\" && e.itemId===\\\"upper.rune.item\\\" && \"'!e.claimed)'\"'))\n        check('network-origin continuation still cannot overwrite solo save',a.evaluate('\"'!__app.net.allowSoloSave'\"'))\n        evidence['rtcDiagnostics']=a.evaluate('__app.net.diagnostics()')\n        check('real RTC produces no page exceptions',not errors,errors)\n        host.close();guest.close()\n    finally:\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ndef hub_checks(pw):\n    server,thread=server_start();browser=pw.chromium.launch(headless=True,args=FLAGS)\n    base=f'http://127.0.0.1:{server.server_port}'\n    harness='/'+ROOT.name+'/vendor/hub/harness.html'\n    game='/'+CONFIG['html']+'?backend=webgl'\n    reports=[]\n    try:\n        for name,extra in [('standard',''),('impaired','&latency=150&jitter=50&loss=5'),('host-leave','&scenario=host-leave'),('server','&scenario=server&latency=150&jitter=50&loss=5'),('solo-hub','')]:\n            context=browser.new_context(viewport={'width':1280,'height':800});page=context.new_page()\n            players=1 if name=='solo-hub' else 2\n            url=base+harness+'?game='+urllib.parse.quote(game,safe='')+f'&players={players}&auto=1&play=2500'+extra\n            page.goto(url,wait_until='load')\n            page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=90000)\n            r=page.evaluate('window.__hubCheck');r['scenarioName']=name;reports.append(r)\n            check('final artifact official Hub '+name,r.get('pass') is True,[c for c in r.get('checks',[]) if not c['pass']])\n            diagnostics=[]\n            for frame in page.frames[1:]:\n                try:\n                    d=frame.evaluate('__app.net.diagnostics()');diagnostics.append(d)\n                    check(name+' copy stops simulation/outgoing on end',d['ended'] and not d['running'] and d['queue']==0)\n                    check(name+' traffic within Hub limits',d['traffic']['maxBytes']<=16384 and d['traffic']['maxPerSecond']<=20,d['traffic'])\n                    if d['server']:check('Hub server authority creates no renderer/audio',frame.evaluate('__app.game===null && __app.view===null && __app.audio===null'))\n                    elif frame.evaluate('__app.game\"'!==null'\"'):check(name+' native world has no engine exceptions',frame.evaluate('__app.game.errors.length')==0)\n                except Exception as exc:\n                    if name\"'!='\"'host-leave':check(name+' diagnostics reachable',False,str(exc))\n            r['diagnostics']=diagnostics\n            context.close()\n        # A full normal-rules Hub victory within real session time, with a legitimate one-seat session.\n        context=browser.new_context(viewport={'width':1100,'height':760});page=context.new_page()\n        page.goto(base+harness+'?game='+urllib.parse.quote(game,safe='')+'&players=1&limit=600')\n        page.locator('#restart').click()\n        page.wait_for_function('document.querySelector(\\\"iframe\\\")?.contentWindow?.__gameReady===true',timeout=60000)\n        page.locator('#release').click()\n        frame=page.frames[1];frame.wait_for_function('__app.net.running===true',timeout=15000)\n        check('Hub begins automatically without title or attract',frame.evaluate('__app.stage===\\\"play\\\" && \"'!__app.attract && !__app.ui.shell.screen'\"'))\n        run=frame.evaluate('__app.state.runId');actions=json.loads(json.dumps(FIXTURE['actions']).replace(FIXTURE['run'],run));accepted=0\n        for entry in actions:\n            r=send(frame,entry['action'])\n            if not r or not r.get('ok'):raise RuntimeError('Hub route rejected '+str(entry['action'])+' '+str(r))\n            accepted+=1\n        frame.wait_for_function('__app.net.ended===true',timeout=10000)\n        check('stock full campaign wins under actual Hub clock',frame.evaluate('__app.state.shared.treasureClaimed && AIHub.time()<AIHub.limitMs') and accepted==175)\n        check('Hub result authority calls finish exactly once',frame.evaluate('__app.net._finished===true && __app.net.isHost'))\n        context.close()\n    finally:\n        evidence['hubReports']=reports\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ndef browser_fallbacks(pw):\n    # WebGPU state can be tested independently from unreliable headless captures.\n    browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n    page=browser.new_page(viewport={'width':960,'height':640})\n    try:\n        ready(page,ARTIFACT.as_uri())\n        page.evaluate('__app.newSolo(false)')\n        check('native WebGPU path boots and advances gameplay',page.evaluate('__app.view.rendererName')=='WebGPU' and send(page,{'type':'move','dx':0,'dy':-1})['ok'])\n    finally:browser.close()\n    browser=pw.webkit.launch(headless=True)\n    page=browser.new_page(viewport={'width':1024,'height':768})\n    try:\n        ready(page,ARTIFACT.as_uri()+'?backend=webgl');page.evaluate('__app.newSolo(false)')\n        check('WebKit available WebGL2 path plays same rules',page.evaluate('__app.view.rendererName')=='WebGL 2' and send(page,{'type':'move','dx':0,'dy':-1})['ok'])\n    finally:browser.close()\n    browser=pw.firefox.launch(headless=True)\n    page=browser.new_page(viewport={'width':960,'height':640})\n    try:\n        page.goto(ARTIFACT.as_uri()+'?backend=webgl');page.wait_for_function('window.__gameReady||window.__bootError',timeout=60000)\n        check('unsupported Firefox displays actionable renderer message',page.evaluate('\"'!!window.__bootError'\"') and page.get_by_role('button',name='Retry loading').is_visible())\n    finally:browser.close()\n\nselected=sys.argv[1:] or ['file','touch','rtc','hub','fallbacks']\nwith sync_playwright() as pw:\n    for name,fn in [('file',file_checks),('touch',touch_checks),('rtc',rtc_checks),('hub',hub_checks),('fallbacks',browser_fallbacks)]:\n        if name in selected:safe(name+' check group completed',lambda fn=fn:fn(pw))\noutput={'checks':checks,'evidence':evidence,'passed':sum(c['pass'] for c in checks),'failed':sum(not c['pass'] for c in checks),'total':len(checks)}\n(ROOT/'evidence'/('release-'+ '-'.join(selected)+'.json')).write_text(json.dumps(output,indent=2,ensure_ascii=False))\nfor c in checks:\n    if not c['pass']:print('FAIL '+c['name']+': '+c['detail'])\nprint(f'{output[\\\"passed\\\"]}/{len(checks)} browser checks passed; {output[\\\"failed\\\"]} failures')\nraise SystemExit(1 if output['failed'] else 0)\nPY\ncat > tools/verify.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { spawnSync } from 'node:child_process';\nimport { runRuleTests } from './rules-test.mjs';\nimport { runNetworkTests } from './net-test.mjs';\nimport { scriptedRoute } from './route.mjs';\nimport { Model } from '../src/core/model.js';\nprocess.chdir(path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'));\nconst failures=[];let total=0;\nconst rules=runRuleTests();total+=rules.count;failures.push(...rules.failures);\nconst net=await runNetworkTests();total+=net.total;failures.push(...net.failures);\nconst r=scriptedRoute(new Model({seed:43021,runId:'browser-route'}));fs.mkdirSync('build',{recursive:true});fs.writeFileSync('build/route-fixture.json',JSON.stringify({run:'browser-route',...r}));\nconst config=JSON.parse(fs.readFileSync('build-config.json','utf8'));\nconst artifact=path.resolve('..',config.html),interview=path.resolve('..','exit-interview.json');\nfunction check(name,fn){total++;try{if(\"'!fn())failures.push(name);}catch(e){failures.push(name+'\"': '+e.message);}}\ncheck('delivery artifact exists',()=>fs.statSync(artifact).size>1000000);\ncheck('canonical JSON report matches delivery',()=>JSON.stringify(JSON.parse(fs.readFileSync(interview)))===JSON.stringify(JSON.parse(fs.readFileSync('src/report.json'))));\ncheck('report required shapes/usage',()=>{const r=JSON.parse(fs.readFileSync(interview));return Object.keys(r).join(',')==='sourceInformation,testingFeedback,engineFeedback,promptFeedback,aiHub'&&Object.keys(r.sourceInformation).length===16&&r.sourceInformation.usage==='added on import'&&r.testingFeedback.length===4&&r.engineFeedback.length===6&&r.promptFeedback.length===4&&r.aiHub.tags.length>=3&&r.aiHub.tags.length<=6;});\ncheck('unmodified session client is first head script',()=>{const h=fs.readFileSync(artifact,'utf8'),s=fs.readFileSync('vendor/hub/session.js','utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script');return h.includes('<meta charset=\\\"utf-8\\\">\\\\n<script>'+s+'</script>');});\ncheck('all runtime module and WASM dependencies bundled',()=>{const h=fs.readFileSync(artifact,'utf8');return \"'!/<script[''^>]+src=/.test(h)&&!/<link[''^>]+href=/.test(h)&&!/<script[''^>]*type=\"module\"/.test(h);});\nif(!process.argv.includes('\"'--rules')){\nconst groups=process.argv.slice(2).filter(a=>\"'!a.startsWith('\"'--'));\nconst p=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tools/browser-test.py',...groups],{encoding:'utf8',maxBuffer:6000000,timeout:600000});\nconst file='evidence/release-'+(groups.length?groups:['file','touch','rtc','hub','fallbacks']).join('-')+'.json';\nif(fs.existsSync(file)){const report=JSON.parse(fs.readFileSync(file));total+=report.total;failures.push(...report.checks.filter(c=>\"'!c.pass).map(c=>c.name+'\"': '+c.detail));}else failures.push('Browser runner failed to produce evidence: '+p.stdout+' '+p.stderr);\nif(p.status\"'!==0&&!fs.existsSync(file))failures.push('\"'Browser runner exit '+p.status);\n}\nfor(const f of failures)console.error('FAIL '+f);\nconsole.log(\"'`${total-failures.length}/${total} checks passed; ${failures.length} failures.`);\nprocess.exitCode=failures.length?1:0;\nEOF\nnode --check tools/verify.mjs'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_64","type":"agent_message","text":"Integration checks caught several gaps between the rules and UI: the pause screen closed immediately, opened coffers blocked their loot, the second player lost access to a used gate, and combat revive had no button. Those are fixed, along with victory continuation. I’m checking the packaged HTML with the complete route, emulated inputs, audio analysis, and the Hub harness.\n"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tools/verify.mjs');s=p.read_text().replace('Object.keys(r.sourceInformation).length===16','Object.keys(r.sourceInformation).length===15');p.write_text(s)\nPY\nnpm run build && npm run verify -- file touch\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"sed -n '172,218p' src/audio/audio.js && rg -n 'Pad3|playstation' vendor/engine/my-3d2dge.js | head -16 && tail -85 tools/route.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"sed -n '172,218p' src/audio/audio.js && rg -n 'Pad3|playstation' vendor/engine/my-3d2dge.js | head -16 && tail -85 tools/route.mjs\"","aggregated_output":"      const c=new Offline(1,44100,44100),master=c.createGain();master.gain.value=mute?0:.7;master.connect(c.destination);\n      const musicBus=c.createGain(),voiceBus=c.createGain(),effectsBus=c.createGain();musicBus.gain.value=.1;voiceBus.gain.value=.35;effectsBus.gain.value=.65;for(const b of[musicBus,voiceBus,effectsBus])b.connect(master);\n      // The same original instrument and syllable functions that play during the expedition.\n      bell(c,musicBus,.01,293.66,.7,.15);bell(c,musicBus,.22,440,.6,.15);bell(c,effectsBus,.42,880,.35,.16);\n      voiceSyllable(c,voiceBus,.12,72,.11,.24,0);voiceSyllable(c,voiceBus,.27,91,.12,.24,1);\n      const buffer=await c.startRendering(),data=buffer.getChannelData(0);let finite=true,peak=0,sum=0,nonzero=0;\n      for(const x of data){if(!Number.isFinite(x))finite=false;peak=Math.max(peak,Math.abs(x));sum+=x*x;if(Math.abs(x)>1e-7)nonzero++;}\n      return{finite,peak,rms:Math.sqrt(sum/data.length),nonzero,samples:data.length};\n    };\n    const normal=await render(false),muted=await render(true);\n    return{supported:true,...normal,mutedPeak:muted.peak,musicDefault:.10,clipping:normal.peak>=1,pass:normal.finite&&normal.nonzero>0&&normal.peak<1&&muted.peak===0};\n  }\n}\n802:    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n929:    return /054c|playstation|dualsense|dualshock|wireless controller/i.test(id) ? 'playstation' : /057e|nintendo|pro controller|joy-con/i.test(id) ? 'nintendo' : 'xbox';\n1298:  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\n1312:  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\n1318:  skill: ['KeyE', 'KeyV', 'Mouse2', 'Pad3'], ...MENU_KEYS\n1325:  sprint: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad10'], jump: ['Space', 'Pad0'], crouch: ['KeyC', 'ControlLeft', 'Pad1'], interact: ['KeyE', 'KeyF', 'Pad3'],\n3025: *      'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] } shows PlayStation symbols unless the\n3066:  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['gener [... omitted end of long line]\n11469:E.FIGHT_KEYS = { up: D.up, down: D.down, left: D.left, right: D.right, lp: ['KeyU', 'Pad2'], hp: ['KeyI', 'Pad3'], lk: ['KeyJ', 'Pad0'], hk: ['KeyK', 'Pad1'], start: D.start, pause: D.pause, confirm:  [... omitted end of long line]\n  navigate({ x: 5, y: 2 }); fight(); mark('both-channels-unlocked');\n  take('upper.key');\n  navigate(model.state.entities['upper.vaultDoor'], 1); send({ type: 'interact', target: 'upper.vaultDoor' });\n  take('upper.ladderSupplies'); navigate(model.state.entities['upper.camp']); rest();\n  navigate(model.state.entities['upper.ladder'], 1); send({ type: 'descend', confirm: true }); mark('spirit-floor');\n\n  take('spirit.ring'); use('ring');\n  take('spirit.sight'); use('sightBook');\n  navigate(model.state.entities['spirit.secret'], 1); send({ type: 'interact', target: 'spirit.secret' });\n  take('spirit.secretBook'); use('spiritBook'); mark('secret-training');\n  navigate({ x: 1, y: 6 }); fight();\n  take('spirit.training'); use('warBook');\n  navigate(model.state.entities['spirit.chest'], 1); send({ type: 'interact', target: 'spirit.chest', choice: 'disarm' }); send({ type: 'interact', target: 'spirit.chest', choice: 'open' });\n  take('spirit.westSupply');\n  navigate(model.state.entities['spirit.gate'], 1); send({ type: 'interact', target: 'spirit.gate', choice: 'spirit' }); mark('one-way-gate');\n  navigate({ x: 7, y: 6 }); fight();\n  take('spirit.eastSupply'); navigate({ x: 9, y: 4 }); fight();\n  take('spirit.brightRune'); equip('brightRune'); rest();\n  navigate(model.state.entities['spirit.ladder'], 1); send({ type: 'descend', confirm: true }); mark('guardian-floor');\n\n  take('guardian.provisions'); take('guardian.blade'); take('guardian.shield'); wearLeft('greatShield');\n  // The guaranteed bright rune is optional if the improved rune was carried down.\n  if (!itemKind('brightRune')) take('guardian.rune');\n  navigate({ x: 7, y: 6 }); fight(); mark('mixed-encounter');\n  navigate(model.state.entities['guardian.camp']); rest();\n  navigate({ x: 5, y: 5 }); fight(); mark('boss-defeated');\n  if (!model.state.shared.bossDefeated || model.state.shared.treasureClaimed) throw new Error('Boss defeat and treasure claim are not separate.');\n  if (claimTreasure) { navigate(model.state.entities['guardian.treasure'], 1); send({ type: 'interact', target: 'guardian.treasure' }); mark('treasure-claimed'); }\n  if (model.state.modified) throw new Error('Route unexpectedly enabled developer balance.');\n  return { actions, milestones, summary: structuredClone(model.state.stats), final: model.snapshot() };\n}\n\nexport { scriptedRoute as runRoute };\n\n// A real second participant follows and commits guard. The leader makes the\n// authored carrying/channel decisions; both avatars use production commands.\nexport function scriptedCoopRoute(model, { player = '0', companion = '1', claimTreasure = true, onAction = null, onMilestone = null } = {}) {\n  const allActions = [];\n  const submit = (id, action) => {\n    const result = model.command(id, action);\n    allActions.push({ player: id, action: structuredClone(action), result: structuredClone(result) });\n    if (onAction) onAction(id, action, result, model.state);\n    return result;\n  };\n  const walkable = (x, y) => {\n    const s = model.state, f = (s.content || CONTENT).floors[s.floor], entities = Object.values(s.entities).filter(e => e.floor === s.floor && e.x === x && e.y === y);\n    if ((f.rows[y]?.[x] || '#') === '#' && !entities.some(e => e.type === 'secret' && e.open)) return false;\n    return !entities.some(e => e.type === 'gate' || e.type === 'door' && !e.open || e.type === 'enemy' && !e.dead);\n  };\n  const follow = () => {\n    let limit = 0;\n    while (model.state.phase === 'explore' && dist(model.state.players[player], model.state.players[companion]) > 0 && ++limit < 100) {\n      const p = model.state.players[companion], goal = model.state.players[player];\n      if (p.down || !p.connected) return;\n      const queue = [{ x: p.x, y: p.y, first: null }], seen = new Set(); let step = null;\n      for (let n = 0; n < queue.length && n < 500; n++) {\n        const at = queue[n], k = key(at); if (seen.has(k)) continue; seen.add(k);\n        if (at.x === goal.x && at.y === goal.y) { step = at.first; break; }\n        for (const [dx, dy] of dirs) if (walkable(at.x + dx, at.y + dy)) queue.push({ x: at.x + dx, y: at.y + dy, first: at.first || { dx, dy } });\n      }\n      if (!step || !submit(companion, { type: 'move', ...step }).ok) return;\n    }\n  };\n  const wrapper = {\n    get state() { return model.state; }, snapshot: () => model.snapshot(),\n    command(id, a) {\n      const r = submit(id, a); if (!r.ok) return r;\n      if (a.type === 'interact' && model.state.entities[a.target]?.type === 'gate' && !model.state.players[companion].down) {\n        const gate = submit(companion, a); if (!gate.ok) throw new Error(`Companion gate: ${gate.message}`);\n      }\n      if (a.type === 'descend' && r.waiting) { const descent = submit(companion, a); if (!descent.ok) throw new Error(`Companion descent: ${descent.message}`); }\n      if (model.state.phase === 'combat' && model.state.combat?.plans[player] && !model.state.combat.plans[companion] && !model.state.players[companion].down) {\n        const guard = submit(companion, { type: 'guard' }); if (!guard.ok) throw new Error(`Companion guard: ${guard.message}`);\n      }\n      if (model.state.phase === 'preparation') {\n        const p = model.state.players[companion];\n        while (p.food > 0 && (p.war < p.maxWar || p.spirit < p.maxSpirit)) if (!submit(companion, { type: 'rest', confirm: true }).ok) break;\n      }\n      if (model.state.phase === 'explore') follow();\n      return r;\n    },\n  };\n  const route = scriptedRoute(wrapper, { player, claimTreasure, onMilestone });\n  return { ...route, allActions };\n}\n","exit_code":0,"status":"completed"}}
