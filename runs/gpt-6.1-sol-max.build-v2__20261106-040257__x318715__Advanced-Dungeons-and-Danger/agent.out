./core/model.js\";\n\n// The transport has no rules of its own. Every accepted command enters Model.\n// All packets are reliable and ordered. Identity always comes from the transport.\nconst VERSION = 1;\nconst GAME = \"ddanger\";\nconst MAX_PACKET = 15_200;\nconst MAX_SNAPSHOT = 320_000;\nconst CHUNK = 10_000;\nconst MAX_INVITE = 120_000;\nconst RTC_TIMEOUT = 120_000;\nconst AUTH_HZ = 8;\nconst SEND_INTERVAL = 65; // <=16 packets/second, with no burst on a stalled tab.\nconst ALLOWED_ACTIONS = new Set([\n\t\"inspect\",\n\t\"move\",\n\t\"turn\",\n\t\"interact\",\n\t\"pickup\",\n\t\"attack\",\n\t\"guard\",\n\t\"retreat\",\n\t\"equip\",\n\t\"swap\",\n\t\"use\",\n\t\"drop\",\n\t\"rest\",\n\t\"descend\",\n\t\"resume\",\n\t\"handoff\",\n\t\"revive\",\n]);\nconst TACTICAL_ACTIONS = new Set([\n\t\"move\",\n\t\"interact\",\n\t\"pickup\",\n\t\"attack\",\n\t\"guard\",\n\t\"retreat\",\n\t\"equip\",\n\t\"swap\",\n\t\"use\",\n\t\"drop\",\n\t\"rest\",\n\t\"descend\",\n\t\"resume\",\n\t\"handoff\",\n\t\"revive\",\n]);\nconst BAD_KEYS = new Set([\"__proto__\", \"prototype\", \"constructor\"]);\nconst encoder = new TextEncoder();\nconst decoder = new TextDecoder(\"utf-8\", { fatal: true });\nconst clone = (value) => JSON.parse(JSON.stringify(value));\nconst now = () => globalThis.performance?.now?.() ?? Date.now();\nconst freshRun = (prefix) =>\n\t`${prefix}-${globalThis.crypto?.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.floor(Math.random() * 0xffffffff).toString(36)}`}`;\nconst byteSize = (value) =>\n\tencoder.encode(typeof value === \"string\" ? value : JSON.stringify(value))\n\t\t.length;\nconst plain = (value) =>\n\t!!value && typeof value === \"object\" && !Array.isArray(value);\nconst finite = (value) => typeof value === \"number\" && Number.isFinite(value);\n\nexport function encodeInvite(description, run) {\n\tif (\n\t\t!description ||\n\t\t![\"offer\", \"answer\"].includes(description.type) ||\n\t\ttypeof description.sdp !== \"string\"\n\t)\n\t\tthrow new Error(\"This is not an offer or answer.\");\n\tconst data = JSON.stringify({\n\t\tv: VERSION,\n\t\tgame: GAME,\n\t\trun,\n\t\ttype: description.type,\n\t\tsdp: description.sdp,\n\t});\n\tconst encoded = toBase64(encoder.encode(data))\n\t\t.replaceAll(\"+\", \"-\")\n\t\t.replaceAll(\"/\", \"_\")\n\t\t.replace(/=+$/, \"\");\n\tconst result = `DD1.${description.type === \"offer\" ? \"O\" : \"A\"}.${encoded}`;\n\tif (result.length > MAX_INVITE)\n\t\tthrow new Error(\n\t\t\t\"The connection code is too large. Retry with a direct connection.\",\n\t\t);\n\treturn result;\n}\n\nexport function decodeInvite(value, expectedType) {\n\tif (typeof value !== \"string\")\n\t\tthrow new Error(\"Paste a connection code first.\");\n\tconst code = value.replace(/\\s/g, \"\");\n\tif (code.length < 40 || code.length > MAX_INVITE)\n\t\tthrow new Error(\n\t\t\t\"The connection code is incomplete or too long. Copy the entire code.\",\n\t\t);\n\tconst match = /^DD1\\.([OA])\\.([A-Za-z0-9_-]+)$/.exec(code);\n\tif (!match)\n\t\tthrow new Error(\n\t\t\t\"This is not an Advanced Dungeons and Danger version 1 connection code.\",\n\t\t);\n\tconst type = match[1] === \"O\" ? \"offer\" : \"answer\";\n\tif (type !== expectedType)\n\t\tthrow new Error(\n\t\t\t`This step needs the ${expectedType} code, not the ${type}.`,\n\t\t);\n\tlet data;\n\ttry {\n\t\tdata = JSON.parse(\n\t\t\tdecoder.decode(\n\t\t\t\tfromBase64(match[2].replaceAll(\"-\", \"+\").replaceAll(\"_\", \"/\")),\n\t\t\t),\n\t\t);\n\t} catch {\n\t\tthrow new Error(\n\t\t\t\"The connection code is damaged or truncated. Copy it again.\",\n\t\t);\n\t}\n\tif (\n\t\t!plain(data) ||\n\t\tdata.v !== VERSION ||\n\t\tdata.game !== GAME ||\n\t\tdata.type !== type ||\n\t\ttypeof data.run !== \"string\" ||\n\t\t!/^[\\w-]{1,100}$/.test(data.run) ||\n\t\ttypeof data.sdp !== \"string\" ||\n\t\t!data.sdp.startsWith(\"v=0\") ||\n\t\t!data.sdp.includes(\"m=application\") ||\n\t\t!data.sdp.includes(\"a=ice-ufrag:\") ||\n\t\tdata.sdp.length > 90_000\n\t)\n\t\tthrow new Error(\n\t\t\t\"The connection code has invalid or incompatible contents.\",\n\t\t);\n\treturn data;\n}\n\nfunction toBase64(bytes) {\n\tlet str = \"\";\n\tfor (let n = 0; n < bytes.length; n += 8192)\n\t\tstr += String.fromCharCode(...bytes.subarray(n, n + 8192));\n\treturn btoa(str);\n}\nfunction fromBase64(value) {\n\tconst str = atob(value);\n\treturn Uint8Array.from(str, (char) => char.charCodeAt(0));\n}\n\n/** A small, explicit structural delta; arrays replace atomically. */\n/* All score, effects, and invented creature syllables are synthesized here.\n * Native ChipAudio supplies buses, sequencing, noise, fades, and gesture locking. */\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nexport const AUDIO_DEFAULTS=Object.freeze({music:.10,effects:.65,voice:.35,mute:false});\n\nfunction bell(ctx,bus,time,freq,dur,vol){\n  const nodes=[];\n  for(const [ratio,k]of [[1,.65],[2.01,.18],[3.98,.06]]){\n    const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type='sine';osc.frequency.setValueAtTime(freq*ratio,time);\n    gain.gain.setValueAtTime(0,time);gain.gain.linearRampToValueAtTime(vol*k,time+.006);gain.gain.exponentialRampToValueAtTime(.00001,time+Math.max(.04,dur));\n    osc.connect(gain);gain.connect(bus);osc.start(time);osc.stop(time+Math.max(.04,dur)+.02);nodes.push(osc);\n  }\n  return nodes;\n}\nfunction voiceSyllable(ctx,bus,time,freq,dur,vol,vowel=0){\n  const o=ctx.createOscillator(),filter=ctx.createBiquadFilter(),g=ctx.createGain();\n  o.type='sawtooth';o.frequency.setValueAtTime(freq,time);o.frequency.exponentialRampToValueAtTime(freq*(vowel%2?1.18:.83),time+dur);\n  filter.type='bandpass';filter.frequency.setValueAtTime([690,920,1250,1680][vowel%4],time);filter.Q.value=3;\n  g.gain.setValueAtTime(0,time);g.gain.linearRampToValueAtTime(vol,time+.012);g.gain.exponentialRampToValueAtTime(.00001,time+dur);\n  o.connect(filter);filter.connect(g);g.connect(bus);o.start(time);o.stop(time+dur+.025);return o;\n}\nconst SOUNDS={\n  dangerStep:{wave:'noise',freq:520,to:180,dur:.075,vol:.09,filter:'lowpass'},\n  dangerTurn:{wave:'noise',freq:1000,to:350,dur:.05,vol:.035},\n  dangerWar:[{wave:'triangle',freq:145,to:68,dur:.12,vol:.23},{wave:'noise',freq:3800,to:650,dur:.09,vol:.15}],\n  dangerSpirit:[{wave:'sine',freq:390,to:880,dur:.13,vol:.17},{wave:'dangerGlass',freq:1174,dur:.24,vol:.15}],\n  dangerBow:[{wave:'noise',freq:4100,to:2200,dur:.07,vol:.13},{wave:'triangle',freq:145,to:320,dur:.07,vol:.09}],\n  dangerGuard:[{wave:'square',freq:180,dur:.04,vol:.11},{wave:'dangerGlass',freq:520,dur:.12,vol:.12}],\n  dangerHurt:{wave:'triangle',freq:140,to:50,dur:.17,vol:.18},\n  dangerPickup:{wave:'dangerGlass',freq:660,arp:[0,7,12],step:.045,dur:.22,vol:.13},\n  dangerEquip:{wave:'noise',freq:1500,to:700,dur:.09,vol:.09},\n  dangerRest:[{wave:'dangerGlass',freq:330,arp:[0,4,7,12],step:.09,dur:.5,vol:.15},{wave:'noise',freq:180,to:80,dur:.25,vol:.045,filter:'lowpass'}],\n  dangerPotion:{wave:'sine',freq:260,arp:[0,5,12],step:.08,dur:.35,vol:.14},\n  dangerKey:{wave:'dangerGlass',freq:880,arp:[0,7,4,12],step:.055,dur:.32,vol:.16},\n  dangerDoor:[{wave:'noise',freq:240,to:80,dur:.6,vol:.13,filter:'lowpass'},{wave:'triangle',freq:70,to:95,dur:.5,vol:.07}],\n  dangerGate:[{wave:'saw',freq:65,to:350,dur:.65,vol:.10,filter:'lowpass',vib:[6,.08]},{wave:'dangerGlass',freq:587,arp:[0,7,12,19],step:.11,dur:.75,vol:.15}],\n  dangerSecret:{wave:'dangerGlass',freq:440,arp:[0,3,7,12,15],step:.07,dur:.6,vol:.16},\n  dangerDown:{wave:'triangle',freq:330,arp:[0,-2,-5,-12],step:.11,dur:.6,vol:.16},\n  dangerEnemyFall:[{wave:'noise',freq:600,to:100,dur:.3,vol:.1},{wave:'sine',freq:250,to:70,dur:.25,vol:.12}],\n  dangerPhase:[{wave:'saw',freq:78,to:156,dur:.65,vol:.08,filter:'lowpass'},{wave:'dangerGlass',freq:293.66,arp:[0,7,12],step:.17,dur:.85,vol:.18}],\n  dangerVictory:{wave:'dangerGlass',freq:440,arp:[0,4,7,12,16,19],step:.09,dur:1.1,vol:.16},\n  dangerMenu:{wave:'sine',freq:660,dur:.045,vol:.08},\n};\n\nconst music=(bpm,tracks)=>({bpm,steps:4,tracks});\nexport const SCORES={\n  title:music(68,[\n    {name:'stone',wave:'triangle',vol:.15,notes:'D2 - - - - - - - | D2 - - - - - - - | Bb1 - - - - - - - | C2 - - - A1 - - -'},\n    {name:'lantern',wave:'dangerGlass',vol:.15,notes:'D4 . . . A4 . . . | F4 . . . E4 . . . | D4 . . . F4 . . . | E4 . . . C#4 . . .'},\n    {name:'dust',wave:'sine',vol:.045,notes:'. . . . . . D5 . | . . . . . . . . | . . . . . . C5 . | . . . . . . . .'},\n  ]),\n  upper:music(72,[\n    {name:'stone',wave:'triangle',vol:.15,notes:'D2 . . . . . D2 . | Bb1 . . . . . . . | G1 . . . . . . . | A1 . . . . . . .'},\n    {name:'lantern',wave:'dangerGlass',vol:.13,notes:'D4 . A4 . . . F4 . | E4 . . . D4 . . . | Bb3 . D4 . . . F4 . | E4 . . . C#4 . . .'},\n    {name:'pulse',wave:'sine',vol:.04,notes:'D3 . . . . . . . | . . . . . . . .'},\n  ]),\n  spirit:music(66,[\n    {name:'water',wave:'sine',vol:.19,notes:'G1 - - - - - - - | Eb2 - - - - - - - | C2 - - - - - - - | D2 - - - - - - -'},\n    {name:'script',wave:'dangerGlass',vol:.14,notes:'G4 . D5 . . . Bb4 . | Ab4 . . . G4 . . . | Eb4 . G4 . . . Bb4 . | A4 . . . F#4 . . .'},\n    {name:'drops',wave:'sine',vol:.035,notes:'. . G5 . . . . . | . . . . . . D5 . | . . . . Eb5 . . . | . . . . . . . .'},\n  ]),\n  guardian:music(76,[\n    {name:'engine',wave:'triangle',vol:.16,notes:'D2 . D2 . . . D2 . | C2 . C2 . . . C2 . | Bb1 . Bb1 . . . Bb1 . | A1 . A1 . . . A1 .'},\n    {name:'horns',wave:'dangerGlass',vol:.12,notes:'D3 . . . A3 . . . | F3 . . . G3 . . . | Bb3 . . . F3 . . . | E3 . . . C#3 . . .'},\n    {name:'clock',wave:'drums',vol:.026,notes:'. . h . . . h . | . . h . . . h .'},\n  ]),\n  combat:music(104,[\n    {name:'tread',wave:'triangle',vol:.16,notes:'D2 . D2 . A1 . D2 . | C2 . C2 . G1 . C2 . | Bb1 . Bb1 . F1 . Bb1 . | A1 . A1 . E2 . A1 .'},\n    {name:'edge',wave:'dangerGlass',vol:.13,notes:'D4 . A4 . F4 . E4 . | D4 . G4 . E4 . C4 . | Bb3 . F4 . D4 . C4 . | C#4 . E4 . A4 . . .'},\n    {name:'round',wave:'drums',vol:.045,notes:'k . h . . . h . | k . h . s . h .'},\n  ]),\n  boss1:music(112,[\n    {name:'iron',wave:'triangle',vol:.17,notes:'D2 . D2 . D2 . A1 . | D2 . D2 . F2 . E2 . | Bb1 . Bb1 . Bb1 . F1 . | A1 . A1 . E2 . C#2 .'},\n    {name:'weight',wave:'saw',vol:.035,notes:'D3 - . . . . A3 . | F3 - . . E3 - . . | Bb2 - . . . . F3 . | A3 - . . C#4 - . .'},\n    {name:'ward',wave:'dangerGlass',vol:.11,notes:'. . . . D5 . . . | . . . . . . E5 . | . . . . F5 . . . | E5 . . . C#5 . . .'},\n    {name:'hammer',wave:'drums',vol:.055,notes:'k . h . s . h . | k k h . s . h .'},\n  ]),\n  boss2:music(100,[\n    {name:'tide',wave:'sine',vol:.18,notes:'G1 . D2 . G1 . D2 . | Eb2 . Bb1 . Eb2 . Bb1 . | C2 . G2 . C2 . G2 . | D2 . A1 . D2 . A1 .'},\n    {name:'oath',wave:'dangerGlass',vol:.14,notes:'G4 . Bb4 . D5 . G5 . | Eb5 . D5 . Bb4 . G4 . | C5 . Eb5 . G5 . Eb5 . | D5 . C5 . A4 . F#4 .'},\n    {name:'pulse',wave:'drums',vol:.04,notes:'k . h . . . h . | k . h . s . h .'},\n  ]),\n  boss3:music(120,[\n    {name:'mastery',wave:'triangle',vol:.16,notes:'D2 . D2 A1 D2 . F2 . | C2 . C2 G1 C2 . E2 . | Bb1 . Bb1 F1 Bb1 . D2 . | A1 . A1 E2 A1 . C#2 .'},\n    {name:'steel',wave:'dangerGlass',vol:.14,notes:'D4 A4 F4 A4 D5 . C5 . | C4 G4 E4 G4 C5 . Bb4 . | Bb3 F4 D4 F4 Bb4 . A4 . | A3 E4 C#4 E4 A4 . C#5 .'},\n    {name:'answer',wave:'sine',vol:.04,notes:'D5 . . . . . E5 . | F5 . . . E5 . . .'},\n    {name:'oath',wave:'drums',vol:.055,notes:'k . h k s . h . | k k h . s . h h'},\n  ]),\n  victory:music(86,[\n    {name:'dawn',wave:'triangle',vol:.14,notes:'D2 - - - A2 - - - | G2 - - - D2 - - - | Bb1 - - - F2 - - - | A1 - - - D2 - - -'},\n    {name:'emberheart',wave:'dangerGlass',vol:.17,notes:'D4 . F#4 . A4 . D5 . | B4 . A4 . F#4 . E4 . | D4 . F4 . Bb4 . D5 . | A4 . F#4 . E4 . D4 .'},\n  ]),\n};\n\nexport class GameAudio{\n  constructor(game){\n    this.game=game;this.audio=game.audio;this.unlocked=false;this.stopped=false;this.songKey=null;this.lastRun=null;this.seen=new Set();this.handles=[];this.voiceNodes=[];this.settings={...AUDIO_DEFAULTS};this.paused=false;this.analyser=null;this.samples=null;this.eventsPlayed=0;this.lastCombat=null;\n    const a=this.audio;\n    a.instrument('dangerGlass',(ctx,bus,time,freq,dur,vol)=>bell(ctx,bus,time,freq,Math.max(.11,dur),vol));\n    for(const [id,v]of Object.entries(SOUNDS))a.define(id,v);\n","exit_code":0,"status":"completed"}}
