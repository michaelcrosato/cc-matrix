{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"sed -n '2530,2564p' vendor/engine/my-3d2dge.js && sed -n '2930,2960p' vendor/engine/my-3d2dge.js && sed -n '2875,2935p' vendor/engine/my-3d2dge.js && ls tools\"","aggregated_output":"  /** pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused.\n   *  The player resumes (Escape, Start, Resume); resume() does it from code */\n  pause(reason = 'player') { this.input.stopRumble(); if (this.paused) return false; this.paused = true; this.pauseReason = reason; return true; }\n  _ownRun(kind, ...a) { const L = this._own && this._own[kind]; if (L) for (const f of L.slice()) try { f(...a); } catch (e) { this.fail('hook ' + kind, e); } }\n  /** take the game out of pause (and close the pause screen) */\n  resume() { this.paused = false; this.pauseReason = null; this._goOn = false; }\n  /** a pausable scene in play pauses when the page is hidden, the window loses focus or the controller is unplugged\n   *  (new E.Game({ autoPause: false }) turns that off); coming back never resumes by itself */\n  _autoPause(reason) { this.input.stopRumble(); return this.o.autoPause !== false && !!this.scene && !!this.scene.pausable && this.pause(reason); }\n  /**\n   * open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without\n   * scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or\n   * menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play.\n   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n   * a menu opened\n   */\n  menu(name, o) {\n    const sh = this.shell, s = this.scene, play = !!s && (!!s.pausable || this.sceneName === 'main');\n    if (o && o.pause === false && !this.paused) this._goOn = true;   // (until it resumes)\n    if (!sh || !sh._menu()) { if (play) this.pause('player'); return false; }\n    if (!name && play) { this.pause('player'); return true; }\n    if (this.pause('menu')) sh._ownPause = true;\n    sh.show(name || 'settings'); return true;\n  }\n  /** the standard features in a page (section 10b): the page set up for phones, pausing when it is hidden, the player's\n   *  full-screen choice kept, a phone's first tap going full screen, the corner buttons and the menu screens */\n  _standard(signal) {\n    const on = (t, type, fn, o) => t.addEventListener(type, fn, Object.assign({ signal }, o)), fs = this.fullscreen;\n    pageSetup(this.screen.canvas);\n    on(window, 'blur', () => this._autoPause('focus'));\n    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its sound\n    on(window, 'pagehide', () => this._autoPause('focus'));\n    // held keys let go as the screen changes; a finger on the glass goes on, and a tap that has landed (the one that went full screen) counts\n    const fsChange = () => { this.input._refit(); if (this.shell && this.shell.screen) this.shell._render(); };   // (the player's choice is what they asked for: fullscreen.toggle() keeps it)\n    on(document, 'fullscreenchange', fsChange); on(document, 'webkitfullscreenchange', fsChange);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n  /**\n   * switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another\n   * number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or\n   * 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each\n   * scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n   */\n  go(name, data, o = {}) {\n    if (this._booting) { this._bootGo = { name, data }; return; }   // (a boot step's go: that scene, when the boot ends)\n    if (!this.scenes) { warn('go:noscenes', 'game.go() needs game.start({ scenes: {...}, scene }) first'); return; }\n    if (!this.scenes[name]) { warn('go:' + name, 'game.go(\"' + name + '\"): no such scene. Scenes: ' + Object.keys(this.scenes).join(', ')); return; }\n    let fade = o.fade === undefined ? this.fadeTime : o.fade, kind = null;\n    if (typeof fade === 'string') {\n      kind = fade; fade = o.seconds === undefined ? .4 : +o.seconds || 0;\n      if (kind !== 'black' && kind !== 'white' && !FADES[kind]) warn('fade:' + kind, 'game.go: no transition \"' + kind + '\" here (black, white, wipe, iris, mosaic, swirl, dissolve; a kit may leave them out: the full engine has them): a fade through black');\n    }\n    if (fade > 0 && this.scene) this._fade = { t: 0, dur: fade, name, data, out: true, kind, at: o.at };\n    else { this._fade = null; this._next = { name, data }; }\n  }\n  _fadeStep(dt) {\n    const f = this._fade; f.t += dt;\n    if (f.out && f.t >= f.dur) { f.out = false; f.t = 0; this._enter(f.name, f.data); }\n    else if (!f.out && f.t >= f.dur) this._fade = null;\n  }\n  _fadeLevel() { const f = this._fade; return f ? clamp(f.out ? f.t / f.dur : 1 - f.t / f.dur, 0, 1) : 0; }\n  _enter(name, data) {\n    const s = this.scenes[name];\n    if (!s) throw new Error('scene \"' + name + '\" does not exist. Scenes: ' + Object.keys(this.scenes).join(', '));\n    const old = this.scene;\n    if (old && old.exit) old.exit();\n    if (old && old._propWas !== undefined) { E.style.propSize = old._propWas; old._propWas = undefined; }\n    this.scene = s; this.sceneName = name; this.paused = false; if (old) prune(this._timers, t => !t.keep); this.hitstop = 0;   // (timers made before the first scene live into it)\n    this.particles.list.length = 0; this.cam.snap = true; this.audio._duck(false); this._follow = this._framed = null;\n    const ok = sceneField(name, s);\n    if (ok('view')) this.setView(s.view);\n    if (ok('views')) this.views = s.views;\n    if (ok('input')) this.input.use(s.input);\n    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n    if (ok('touch')) this.input.touchButtons(s.touch);\n    ok('camera');\n    if (s.propSize !== undefined) { s._propWas = E.style.propSize; E.style.propSize = s.propSize; }   // scene option: prop scale while this scene runs\n    this._zoomFit(true);   // its camera: its zoom to start at, and whether the player's applies\n    if (s.pausable || name === 'main') this._fsAuto = this._autoFull();   // a game starting from a tap goes full screen again\n    for (const f of HOOKS.enter) f(this, old);\n    this._ownRun('enter', name, data);\n    if (s.enter) s.enter(data);\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n      this._errKeys.add(key); this.errors.push({ where, scene: this.sceneName, message: msg, stack: e && e.stack });\n      console.error('my-3D2dge: error in ' + where + (this.sceneName ? ' (scene \"' + this.sceneName + '\")' : '') + ': ' + ((e && e.stack) || msg));\n    }\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\nbuild.mjs\nnet-test.mjs\nroute.mjs\nrules-test.mjs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"/home/micha/.local/share/pipx/venvs/playwright/bin/python - <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json\nartifact=next(Path('..').glob('Advanced-*.html')).resolve()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--use-angle=swiftshader','--enable-unsafe-swiftshader'])\n page=b.new_page(viewport={'width':1920,'height':1080});errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto(artifact.as_uri()+'?backend=webgl');page.wait_for_function('window.__gameReady || window.__bootError',timeout=60000)\n print(page.evaluate('({ready:window.__gameReady,bootError:window.__bootError,stage:window.__app.stage,view:window.__app.view?.snapshot(),engineErrors:window.__app.game?.errors})'))\n page.screenshot(path='evidence/title-integrated.png')\n page.get_by_role('button',name='Begin expedition',exact=True).click();page.wait_for_timeout(200)\n print('After New',page.evaluate('({stage:__app.stage,phase:__app.state?.phase,menu:__app.ui.shell.screen})'))\n page.get_by_role('button',name='Enter the vault',exact=True).click();page.wait_for_timeout(700)\n page.screenshot(path='evidence/play-integrated.png')\n page.keyboard.press('Escape');page.wait_for_timeout(300)\n print('After Esc',page.evaluate('({menu:__app.ui.shell.screen,paused:__app.game.paused,netPaused:__app.net.paused})'))\n print('Errors',errors)\n b.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
