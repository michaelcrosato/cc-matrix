ation. Restore at least '+Math.ceil(q.maxWar*.3)+' War and '+Math.ceil(q.maxSpirit*.3)+' Spirit; preserve any higher remaining value.',()=>{this.hide();this.command({type:'revive',target:q.id});},'Share one ration');else this.notice('No fallen ally in reach','Move within one tile of your companion.');}\n  coop(){this.show('coop',{kicker:'One vault · two first-person views',title:'Bring a second lantern',text:'Connect two browsers with invitation codes. Each adventurer keeps a personal pack; the dungeon and its decisions are shared. A direct connection requires reachable network peers. No relay is supplied.',actions:[['Host an expedition',()=>this.host()],['Join an expedition',()=>this.join()],['How co-op works',()=>this.help()],['Back',()=>this.shell.back()]]});}\n  async host(){this.invite={role:'host',status:'Gathering a direct invitation…',output:'',input:''};this.inviteScreen();try{const code=await this.app.net.host();if(this.invite.role\"'!=='\"'host')return;this.invite.output=code;this.invite.status='Give the offer to your companion. Paste their answer below, then connect.';this.inviteScreen();}catch(e){this.invite.status=e.message;this.inviteScreen();}}\n  join(){this.invite={role:'guest',status:'Paste the host’s offer. Then create an answer and send it back.',output:'',input:''};this.inviteScreen();}\n  async joinAnswer(){this.captureInvite();try{this.invite.status='Gathering your answer…';this.statusInvite();const code=await this.app.net.join(this.invite.input);this.invite.output=code;this.invite.status='Return this answer to the host. Waiting for the reliable data channel…';this.inviteScreen();}catch(e){this.invite.status=e.message;this.statusInvite();}}\n  async acceptAnswer(){this.captureInvite();try{await this.app.net.accept(this.invite.input);this.invite.status='Connecting and checking expedition version…';this.statusInvite();}catch(e){this.invite.status=e.message;this.statusInvite();}}\n  captureInvite(){const t=this.shell.root.querySelector('#invite-