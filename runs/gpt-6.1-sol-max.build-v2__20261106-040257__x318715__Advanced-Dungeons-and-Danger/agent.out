onnection: this.pc?.connectionState ?? null,\n\t\tthis.pc = null;\n\t\tthis.channel = null;\n\t\tthis.status = \"Solo expedition\";\n\t\tthis._generation = 0;\n\t\tthis._interval = null;\n\t\tthis._unsub = [];\n\t\tthis._rtcTimer = null;\n\t\tthis._cancelGather = null;\n\t\tthis._disconnectedTimer = null;\n\t\tthis._run = \"\";\n\t\tthis._seq = 0;\n\t\tthis._seen = new Map();\n\t\tthis._outbox = [];\n\t\tthis._commands = [];\n\t\tthis._parts = new Map();\n\t\tthis._published = null;\n\t\tthis._revision = 0;\n\t\tthis._receivedRevision = -1;\n\t\tthis._handshaken = false;\n\t\tthis._finished = false;\n\t\tthis._hubStarted = false;\n\t\tthis._ready = false;\n\t\tthis._lastTick = now();\n\t\tthis._lastPublish = -Infinity;\n\t\tthis._lastFull = -Infinity;\n\t\tthis._lastSend = -Infinity;\n\t\tthis._lastHeartbeat = -Infinity;\n\t\tthis._lastClientSend = -Infinity;\n\t\tthis._resyncAt = -Infinity;\n\t\tthis._traffic = {\n\t\t\tsent: 0,\n\t\t\treceived: 0,\n\t\t\trejected: 0,\n\t\t\tmaxBytes: 0,\n\t\t\trates: [],\n\t\t\tlastSecond: Math.floor(now() / 1000),\n\t\t\tsecondCount: 0,\n\t\t\tmaxPerSecond: 0,\n\t\t\tsnapshots: 0,\n\t\t};\n\t}\n\n\t_call(name, ...args) {\n\t\tthis.callbacks[name]?.(...args);\n\t}\n\t_status(message) {\n\t\tthis.status = message;\n\t\tthis._call(\"onStatus\", message);\n\t}\n\t_mode(mode, localId, host, server = false) {\n\t\tthis.mode = mode;\n\t\tthis.localId = String(localId);\n\t\tthis.isHost = host;\n\t\tthis.server = server;\n\t\tthis._call(\"onMode\", mode, this.localId);\n\t}\n\t_emit() {\n\t\tthis.state = this.model ? this.model.state : this.state;\n\t\tthis._call(\"onState\", this.state);\n\t}\n\t_startTimer() {\n\t\tif (this._interval) clearInterval(this._interval);\n\t\tthis._lastTick = now();\n\t\tthis._interval = setInterval(() => this.tick(), 25);\n\t}\n\n\tstartSolo(snapshot = null) {\n\t\tif (this.mode === \"hub\" && !this.ended)\n\t\t\treturn { ok: false, message: \"The Hub owns this expedition.\" };\n\t\tthis.close();\n\t\tthis.ended = false;\n\t\tthis.running = true;\n\t\tthis.paused = false;\n\t\tthis._finished = false;\n\t\tthis._mode(\"solo\", \"0\", true);\n\t\tthis._run = snapshot?.runId || freshRun(\"solo\");\n\t\tthis.model = new Model({\n\t\t\tplayers: [{ id: \"0\", name: \"Adventurer\" }],\n\t\t\tseed: snapshot?.seed ?? 43021,\n\t\t\trunId: this._run,\n\t\t});\n\t\tif (snapshot) {\n\t\t\tconst loaded = this.model.load(snapshot);\n\t\t\tif (loaded?.ok === false) {\n\t\t\t\tthis.model = null;\n\t\t\t\tthis.state = null;\n\t\t\t\tthis.running = false;\n\t\t\t\tthrow new Error(loaded.message || \"The saved expedition is invalid.\");\n\t\t\t}\n\t\t\tthis._run = this.model.state.runId;\n\t\t}\n\t\tthis.state = this.model.state;\n\t\tthis._status(\"Solo expedition · no time limit\");\n\t\tthis._emit();\n\t\tthis._startTimer();\n\t\tthis._call(\"onStart\");\n\t\treturn { ok: true };\n\t}\n\n\tasync initHub() {\n\t\tconst hub = globalThis.AIHub;\n\t\tif (!hub) return false;\n\t\tconst info = await hub.connect({ mode: \"shared-world\", seats: [1, 2] });\n\t\tif (!info) return false;\n\t\tthis.close();\n\t\tthis.ended = false;\n\t\tthis.running = false;\n\t\tthis.paused = false;\n\t\tthis._finished = false;\n\t\tthis._hub = hub;\n\t\tthis._hubStarted = false;\n\t\tthis._ready = false;\n\t\tthis._run = `hub-${info.round}-${info.seed}`;\n\t\tthis._hubHost = String(info.host);\n\t\tthis._participants = info.players.map((player) => ({\n\t\t\tid: String(player.id),\n\t\t\tname: String(player.name),\n\t\t}));\n\t\tthis._mode(\"hub\", info.me, !!info.isHost, !!info.server);\n\t\tif (this.isHost) {\n\t\t\tthis.model = new Model({\n\t\t\t\tplayers: this._participants,\n\t\t\t\tseed: info.seed,\n\t\t\t\trunId: this._run,\n\t\t\t});\n\t\t\tthis.state = this.model.state;\n\t\t\tthis._emit();\n\t\t}\n\t\tthis._unsub = [\n\t\t\thub.on(\"message\", (data, from) => this._receive(data, String(from))),\n\t\t\thub.on(\"start\", () => {\n\t\t\t\tif (this.ended) return;\n\t\t\t\tthis._hubStarted = true;\n\t\t\t\tthis._status(\"The expedition begins on the Hub clock.\");\n\t\t\t}),\n\t\t\thub.on(\"leave\", ({ id }) => {\n\t\t\t\tif (this.ended) return;\n\t\t\t\tconst pid = String(id);\n\t\t\t\tthis._participants = this._participants.filter(\n\t\t\t\t\t(player) => player.id !== pid,\n\t\t\t\t);\n\t\t\t\tif (this.isHost && this.model) {\n\t\t\t\t\tthis.model.leave(pid);\n\t\t\t\t\tthis._emit();\n\t\t\t\t\tthis._publish(true);\n\t\t\t\t\tthis._status(\n\t\t\t\t\t\t\"An adventurer departed. Their gear waits in a recovery bag.\",\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}),\n\t\t\thub.on(\"time-up\", () => {\n\t\t\t\tif (!this.ended && this.isHost) {\n\t\t\t\t\tthis.running = false;\n\t\t\t\t\tthis.finish(!!this.state?.shared?.treasureClaimed);\n\t\t\t\t}\n\t\t\t}),\n\t\t\thub.on(\"end\", ({ reason }) =>\n\t\t\t\tthis._end(`Hub round ended: ${reason}`, false),\n\t\t\t),\n\t\t];\n\t\tthis._status(\n\t\t\tthis.server\n\t\t\t\t? \"Hub authority · no local adventurer\"\n\t\t\t\t: \"Hub connected · waiting for synchronized start\",\n\t\t);\n\t\tthis._startTimer();\n\t\tthis._call(\"onReady\");\n\t\tif (this.server) this.ready();\n\t\treturn true;\n\t}\n\n\tready() {\n\t\tif (this.mode !== \"hub\" || this.ended || this._ready) return;\n\t\tthis._ready = true;\n\t\tthis._hub.ready();\n\t\tif (this.isHost) this._publish(true);\n\t\telse this._queue(\"resync\", {}, this._hubHost, true);\n\t}\n\n      return denied('No encounter to resume.');\n    }\n    if (s.phase === 'preparation' && ['attack', 'move', 'retreat'].includes(action.type)) return denied('Prepare, then choose FACE THE NEXT SEAL.');\n    if (s.phase === 'combat') return this._commit(p, action);\n    const result = this._validate(p, action);\n    if (!result.ok) return result;\n    const applied = this._apply(p, action);\n    if (applied.ok) s.tick++;\n    return applied;\n  }\n\n  _validate(p, a, resolution = false) {\n    const s = this.state;\n  }\n  unlock(){\n    this.unlocked=true;this.stopped=false;\n    const master=this.audio.bus('master'),c=this.audio.ctx;\n    if(c&&master&&!this.analyser){this.analyser=c.createAnalyser();this.analyser.fftSize=1024;master.connect(this.analyser);this.samples=new Float32Array(this.analyser.fftSize);}\n    if(c?.state==='suspended')c.resume().catch(()=>{});\n    this._volumes();\n  }\n  _volumes(){\n    const a=this.audio,settings=this.settings;a.musicVolume=clamp(settings.music??.10);a.sfxVolume=clamp(settings.effects??.65);a.voiceVolume=clamp(settings.voice??.35);a.volume=clamp(settings.volume??.7);a.muted=!!settings.mute||this.paused||this.stopped;a.applyVolume();\n  }\n  update(state,settings={},paused=false){\n    this.settings={...AUDIO_DEFAULTS,...settings};\n    const shouldPause=!!paused||state?.phase==='ended';\n    if(shouldPause!==this.paused){this.paused=shouldPause;if(shouldPause){this._silence();}else if(this.unlocked){this.stopped=false;if(this.audio.ctx?.state==='suspended')this.audio.ctx.resume().catch(()=>{});this.songKey=null;}}\n    this._volumes();if(!this.unlocked||this.stopped||this.paused)return;\n    if(state?.runId!==this.lastRun){this.lastRun=state?.runId;this.seen.clear();this.lastCombat=null;}\n    const boss=Object.values(state?.entities||{}).find(e=>e.type==='enemy'&&e.kind==='minotaur'&&!e.dead&&state.combat?.enemies.includes(e.id));\n    let key=!state?'title':state.phase==='victory'?'victory':boss?'boss'+clamp(boss.phase||1,1,3):state.phase==='combat'?'combat':['upper','spirit','guardian'][state.floor]||'upper';\n    if(state?.phase==='defeat')key=null;\n    if(key!==this.songKey){this.songKey=key;this.audio.music(key?SCORES[key]:null,{fade:.65,sync:true});}\n    const events=state?.events||[];\n    for(const ev of events){if(this.seen.has(ev.id))continue;this.seen.add(ev.id);this.event(ev,state);}\n    if(this.seen.size>512)this.seen=new Set(events.map(e=>e.id));\n    if(state?.combat?.id&&state.combat.id!==this.lastCombat){this.lastCombat=state.combat.id;const spooky=Object.values(state.entities).some(e=>state.combat.enemies.includes(e.id)&&['minotaur','wraith'].includes(e.kind));if(spooky)this._babble(boss?'warden':'wraith');}\n    this.handles=this.handles.filter(h=>!h.ended).slice(-30);\n  }\n  event(e,state=null){\n    if(!this.unlocked||this.stopped||this.paused||this.settings.mute)return;\n    let id=null;\n    if(e.type==='move')id='dangerStep';else if(e.type==='turn')id='dangerTurn';\n    else if(e.type==='attack'){\n      const item=state?.items?.[e.item]?.kind||e.weapon;\n      id=e.channel==='spirit'?'dangerSpirit':item==='bow'?'dangerBow':'dangerWar';\n    }\n    else if(e.type==='enemyAttack')id=e.channel==='spirit'?'dangerSpirit':'dangerWar';\n    else if(e.type==='guard')id='dangerGuard';else if(e.type==='damage'&&state?.players?.[e.target])id='dangerHurt';\n    else if(e.type==='pickup')id=e.key||/key/i.test(e.text||'')?'dangerKey':'dangerPickup';\n    else if(['equip','swap','drop','handoff'].includes(e.type))id='dangerEquip';\n    else if(e.type==='rest'||e.type==='revive')id='dangerRest';\n    else if(e.type==='use')id='dangerPotion';else if(e.type==='door')id='dangerDoor';\n","exit_code":0,"status":"completed"}}
