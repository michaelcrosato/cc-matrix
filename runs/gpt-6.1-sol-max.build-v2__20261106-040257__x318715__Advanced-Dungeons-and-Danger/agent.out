extAction();}}}};c.addEventListener('pointerup',up);c.addEventListener('pointercancel',e=>fingers.delete(e.pointerId));}\n  moveRelative(direction){const p=this.player;if(\"'!p)return;const d=(p.dir+({forward:0,right:1,back:2,left:3}[direction]??0))%4;const[dx,dy]=[[0,-1],[1,0],[0,1],[-1,0]][d];return this.send({type:'\"'move',dx,dy,epoch:this.state.epoch});}\n  checkAttractPad(){const I=this.game?.input;if(\"'!I||this.net.mode==='\"'hub')return;const active=I.padPrev?.some(Boolean)||Math.hypot(...(I.padMove||[0,0]))>.25||Math.hypot(...(I.padAim||[0,0]))>.25;if(active){if(this.attract){I.clear();this.stopAttract();this._consumePad=true;}else{this.lastActivity=performance.now();this.lastInput='gamepad';}}}\n  readInput(dt){const I=this.game.input;if(this._consumePad){this._consumePad=false;return;}if(this.ui.isOpen)return;for(const [act,fn]of [['pause',()=>this.ui.pause()],['pack',()=>this.ui.pack()],['map',()=>this.ui.map()],['swap',()=>this.send({type:'swap'})],['rest',()=>this.ui.rest()],['use',()=>this.ui.useHand()],['inspect',()=>this.ui.inspectEnemy()],['target',()=>this.ui.cycleTarget()],['war',()=>this.ui.choose('war')],['spirit',()=>this.ui.choose('spirit')],['held',()=>this.ui.choose('right')],['retreat',()=>this.ui.retreat()]])if(I.pressed(act)){fn();return;}\n    if(I.pressed('turnLeft')||I.pressed('turnRight')){this.view.resetLook();this.send({type:'turn',delta:I.pressed('turnLeft')?-1:1});return;}\n    const aim=I.padAim;if(aim&&Math.hypot(...aim)>.15)this.view.look(aim[0]*dt*320,aim[1]*dt*240);\n    if(this.game.real>=this.inputCooldown){for(const [act,d]of [['forward','forward'],['backward','back'],['strafeLeft','left'],['strafeRight','right']])if(I.down(act)){this.moveRelative(d);this.inputCooldown=this.game.real+.28/(this.state?.tuning?.tempo||1);return;}}\n    if(I.pressed('guard')&&this.state?.combat){this.send({type:'guard',channel:'both'});return;}if(I.pressed('attack')){if(this.state?.combat||this.state?.phase==='preparation')this.ui.contextAction();else this.ui.interact();return;}if(I.pressed('interact')){if(this.state?.combat)this.ui.contextAction();else this.ui.interact();}\n    const dev=I.lastDevice;if(dev==='gamepad')this.lastInput='gamepad';\n  }\n  update(dt){if(this.attract){this.attractStep(dt*1000);this.view.update(dt);this.ui.update();return;}if(this.stage==='title'){if(\"'!this.net.pc&&performance.now()-this.lastActivity>=10000)this.startAttract();this.view.update(dt);this.audio.update(null,this.game.settings,false);this.ui.update();return;}if(this.stage!=='\"'play'){this.ui.update();return;}this.syncPause();this.state=this.net.state;if(\"'!this.state){this.view.update(dt);return;}if(this.net.running)this.readInput(dt);if(!this.net.paused)this.view.update(dt);this.audio.update(this.state,this.game.settings,this.hidden||this.net.paused||this.net.ended);this.ui.update();\n    if(this.state.phase!==this._lastPhase){this._lastPhase=this.state.phase;if(this.state.phase==='\"'victory'&&\"'!this.finishedDismissed)this.ui.victory();if(this.state.phase==='\"'defeat')this.ui.defeat();if(this.state.phase==='preparation')this.ui.notice('A seal breaks. The damage remains.','A quiet beat: prepare, then face the next seal.');}\n    if(this.state.floor\"'!==this._lastFloor){this._lastFloor=this.state.floor;this.saveCheckpoint();if(this._lastFloor>0)this.ui.notice(this.ui.content.floors[this._lastFloor].name,'\"'The stair closes above you. A viable checkpoint is kept.');}\n  }\n  startAttract(){if(this.net.mode==='hub'||this.net.pc||this.stage\"'!=='\"'title')return;this.attract=true;this.stage='attract';this.attractModel=new Model({seed:8319,runId:'attract-isolated'});this.attractModel.dev({type:'invulnerable',value:true});this.state=this.attractModel.state;this.attractTime=0;this.attractCue=-1;this.ui.hide();document.getElementById('attract-banner').hidden=false;this.ui.hud.hidden=true;}\n  attractStep(ms){if(\"'!this.attract)return;this.attractTime+=ms;const phase=Math.floor(this.attractTime/6000);if(phase