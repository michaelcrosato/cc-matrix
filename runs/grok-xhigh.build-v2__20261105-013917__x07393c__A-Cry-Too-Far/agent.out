ddy.wound = true;\\n          this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60 * 2;\\n        }\\n        this.rescueBuddy = null;\\n        this.dead = false;\\n      }\\n    }\\n  }\\n\\n  tickPosts() {\\n    for (const post of this.posts) {\\n      if (post.alive || post.clearedAt == null) continue;\\n      if (this.gameHours - post.clearedAt >= TUNING.postRemanHours) {\\n        post.alive = true;\\n        post.clearedAt = null;\\n      }\\n    }\\n  }\\n\\n  tickPlayer(dt) {\\n    if (this.round?.localDown) return;\\n    if (this.dead && this.rescueT <= 0) return;\\n    const input = this.ctx.input;\\n    const bot = this.game.mode === 'attract' ? this.game.bot : null;\\n    if (!bot && this.lines.length) {\\n      if (consumeAction(input, 'confirm')) this.advanceLines();\\n      return;\\n    }\\n    if (!bot && this.choice) {\\n      if (consumeAction(input, 'left')) this.choice.focus = Math.max(0, this.choice.focus - 1);\\n      if (consumeAction(input, 'right')) this.choice.focus = Math.min(this.choice.options.length - 1, this.choice.focus + 1);\\n      if (consumeAction(input, 'confirm')) this.choicePick = this.choice.focus;\\n      return;\\n    }\\n    if (this.surgeryT > 0) {\\n      this.surgeryT -= dt;\\n      if (this.surgeryT <= 0) this.hp = 40;\\n      return;\\n    }\\n    if (this.rescueT > 0) return;\\n    this.readNeeds(dt, input, bot);\\n    if (this.choice) return;\\n    if (this.map.up && input) {\\n      let dx = input.mouseDelta.x;\\n      let dy = input.mouseDelta.y;\\n      const px = input.pointer?.x || 0;\\n      const py = input.pointer?.y || 0;\\n      if (dx === 0 && dy === 0 && this.map.px != null) {\\n        dx = (px - this.map.px) * 800;\\n        dy = (py - this.map.py) * 800;\\n      }\\n      this.map.px = px;\\n      this.map.py = py;\\n      this.map.cx = clamp(this.map.cx + dx * 0.35, -640, 640);\\n\",\"total_lines\":1532}}","is_error":false},{"type":"tool_result","tool_use_id":"call-55c8d2af-9113-4248-b51f-9cb2b10f03b1-21","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→    else if (!session.server) {\\n      const p = this.world.feet();\\n      session.send({ t: 'me', id: session.me, x: p.x, z: p.z, yaw: this.ctx?.camera?.yaw || 0, carrying: this.round.seat(session.me)?.carrying || null }, { reliable: false });\\n    }\\n  }\\n\\n  onSessionEnd() {\\n    this.ended = true;\\n    if (this.ctx?.audio) {\\n      this.ctx.audio.stopMusic();\\n190→      this.ctx.audio.stopLoops();\\n    }\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 0;\\n  }\\n\\n  fixedUpdate(_ctx, dt) {\\n    if (!this.world) return;\\n    this.world.fixed(dt);\\n  }\\n\\n200→  update(ctx, dt) {\\n    this.ctx = ctx;\\n    this.frame += 1;\\n    this.musicT += dt;\\n    this.trackDevice(ctx);\\n    if (this.touchGate && this.realControl(ctx)) {\\n      this.touchGate = false;\\n      this.notice = '';\\n    }\\n    if (this.menuArm > 0) this.menuArm = Math.max(0, this.menuArm - dt);\\n210→    this.trackIdle(ctx, dt);\\n    if (this.mode === 'attract') {\\n      if (this.freshInput(ctx)) this.exitAttract();\\n      else this.stepAttract(dt);\\n    } else if (this.mode === 'card') this.cardInput(ctx);\\n    else if (this.mode === 'play' || this.mode === 'round') this.playChrome(ctx);\\n    else this.menuInput(ctx);\\n    this.look.enabled = (this.mode === 'play' || this.mode === 'round' || this.mode === 'attract') && !this.world?.map.up && !this.look.override;\\n    if (this.grass) this.grass.update(ctx.time);\\n    if (this.world && typeof document !== 'undefined') applySky(ctx.engine, skyAt(this.world.hour));\\n220→    this.world?.syncViews();\\n    this.draw(ctx);\\n  }\\n\\n  cameraTarget() {\\n    const f = this.world ? this.world.feet() : { x: 0, y: 42, z: 40 };\\n    const y = this.world?.crouch ? 1.15 : 1.62;\\n    return target.set(f.x, f.y + y, f.z);\\n  }\\n\",\"content_concise\":\"180→    else if (!session.server) {\\n      const p = this.world.feet();\\n    