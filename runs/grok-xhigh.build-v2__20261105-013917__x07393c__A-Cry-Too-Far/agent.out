gine, THREE } from './pixel-engine.js';\\nimport { World } from './src/sim/world.js';\\nconst target = new THREE.Vector3();\\nconst eye = new THREE.Vector3();\\nconst game = {\\n  name: 'boot',\\n  mode: 'play',\\n  screen: 'play',\\n  blocksSim() { return false; },\\n  onDeath() {},\\n  showEnding() {},\\n  async setup(ctx) {\\n    const t0 = Date.now();\\n    this.world = new World(this, ctx);\\n    this.world.build();\\n    console.log('build_ms', Date.now() - t0, 'nx', this.world.land.nx);\\n    const f = this.world.feet();\\n    console.log('feet', f.x.toFixed(2), f.y.toFixed(2), f.z.toFixed(2));\\n    console.log('speed', this.world.hero.speed);\\n    this.world.hero.speed = 9;\\n    console.log('speed_after', this.world.hero.speed);\\n    this.ctx = ctx;\\n  },\\n  fixedUpdate(_ctx, dt) { this.world.fixed(dt); },\\n  update() {},\\n  cameraTarget() {\\n    const f = this.world.feet();\\n    return target.set(f.x, f.y + 1.6, f.z);\\n  },\\n  eyePosition() {\\n    const f = this.world.feet();\\n    return eye.set(f.x, f.y + 1.65, f.z);\\n  },\\n};\\nconst t0 = Date.now();\\nconst e = await Engine.headless(game, { seed: 1 });\\nconsole.log('headless_ms', Date.now() - t0);\\nconst a = { ...game.world.feet() };\\ngame.ctx.input.setKey('KeyW', true);\\ngame.ctx.camera.yaw = 0;\\nconst t1 = Date.now();\\ne.step(60, 1/60);\\nconsole.log('step60_ms', Date.now() - t1);\\nconst b = game.world.feet();\\nconsole.log('delta', (b.x-a.x).toFixed(3), (b.z-a.z).toFixed(3), 'yaw', game.ctx.camera.yaw);\\nconsole.log('err', (e.errors||[]).slice(0,2));\\nEOF\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Boot headless world and measure a step\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261105-013917__x07393c%2Fwork/01a1aadc-c537-7073-8756-0b078a9e97df/terminal/call-7b2e084e-31e2-4bc6