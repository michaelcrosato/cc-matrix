,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,47,65,32,67,114,121,32,84,111,111,32,70,97,114,45,70,97,114,32,67,114,121,32,50,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,47,115,114,99,47,115,105,109,47,119,111,114,108,100,46,106,115,10,52,52,55,58,32,32,32,32,32,32,116,104,105,115,46,115,112,97,119,110,83,111,108,100,105,101,114,40,123,32,105,100,58,32,115,46,116,97,103,44,32,112,111,115,116,58,32,115,46,116,97,103,44,32,120,58,32,115,105,116,101,46,120,32,43,32,50,44,32,122,58,32,115,105,116,101,46,122,44,32,102,97,99,116,105,111,110,58,32,39,99,111,110,99,111,114,100,39,32,125,41,59,10,49,51,49,49,58,32,32,115,112,97,119,110,83,111,108,100,105,101,114,40,111,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":4,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/round.js\",\"matches\":[{\"line_number\":60,\"content\":\"      world.spawnSoldier({ x: 130 + (i % 4) * 14, z: -300 - Math.floor(i / 4) * 12, faction: i % 2 ? 'harvest' : 'concord' });\"},{\"line_number\":64,\"content\":\"      const actor = world.spawnSoldier({ id: 'merc-' + s.id, x: s.x, z: s.z, faction: 'merc' });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\",\"matches\":[{\"line_number\":447,\"content\":\"      this.spawnSoldier({ id: s.tag, post: s.tag, x: site.x + 2, z: site.z, faction: 'concord' });\"},{\"line_number\":1311,\"content\":\"  spawnSoldier(o) {\"}]}]}","is_error":false}]},"parent_too