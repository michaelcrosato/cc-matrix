core/tuning.js';\\nimport { consumeAction, heldAction } from '../core/actions.js';\\nimport { CASES, POSTS, SITES, STRIPS, TRIGS, siteById } from '../content/sites.js';\\nimport { missionById } from '../content/missions.js';\\nimport { WEAPON_BY_ID, freshWeapon } from '../content/weapons.js';\\nimport { onBridge, nearRiver } from '../content/roads.js';\\nimport { FireGrid } from '../world/fire.js';\\nimport { addBlock, buildLand, fillFuel, paintScar } from '../world/terrain.js';\\nimport { line } from '../content/dialogue.js';\\n\\nconst { Vector3 } = THREE;\\nconst MOVE = new Vector3();\\n\\nconst BUDDY_DEF = {\\n  ines: { name: 'INES CARVALHO', hp: 200 },\\n  dov: { name: 'DOV HALPERN', hp: 200 },\\n  mags: { name: 'MAGS OYELARAN', hp: 200 },\\n};\\n\\nexport class World {\\n  constructor(game, ctx) {\\n    this.game = game;\\n    this.ctx = ctx;\\n    this.rng = ctx.random.fork('world');\\n    this.fire = new FireGrid(ctx.random.fork('fire'));\\n    this.fire.onBurnt = (ix, iz) => {\\n      if (this.land) paintScar(this.land, ix, iz);\\n      this.scarTick = (this.scarTick || 0) + 1;\\n    };\\n    this.heroes = null;\\n    this.land = null;\\n    this.heights = null;\\n    this.hp = 100;\\n    this.stones = 0;\\n    this.tablets = 0;\\n    this.syrettes = 3;\\n    this.syretteMax = 3;\\n    this.hour = 9;\\n    this.gameHours = 9;\\n    this.windDir = 0.4;\\n    this.windSpeed = 3;\\n    this.windPin = null;\\n    this.rain = false;\\n    this.weather = 'clear';\\n    this.guns = [];\\n    this.slot = 0;\\n    this.unlocked = new Set(['cane', 'm38']);\\n    this.upgrades = new Set();\\n    this.flags = new Set();\\n    this.safehouses = new Set();\\n    this.seen = new Set(['mile-forty', 'clinic']);\\n    this.notes = 0;\\n    this.tracker = false;\\n    this.truce = true;\\n    this.column = false;\\n    this.pass = null;\\n    this.provoked = false;\\n    this.buddies = [];\\n    this.actors = [];\\n    this.props = [];\\n    this.cases = [];\\n    this.posts = POSTS.map((p) => ({ ...p, alive: true, clearedAt: null }));\\n    this.trucks = [];\\n    this.car = null;\\n    this.inVehicle = false;\\n    this.vehicleHp = 100;\\n    this.vehicleKind = null;\\n    this.repairT = 0;\\n    this.explodeT = 0;\\n    this.carrying = null;\\n    this.waypoint = null;\\n    this.map = { up: false, anim: 0, cx: 0, cz: 40, zoom: 1 };\\n    this.mapPx = new Uint8Array(320 * 240 * 4);\\n    this.feverT = 12 * 60;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.holdT = { tablet: 0, heal: 0, use: 0 };\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.rescueBuddy = null;\\n    this.dead = false;\\n    this.god = false;\\n    this.noJam = false;\\n    this.infAmmo = false;\\n    this.invisible = false;\\n    this.noclip = false;\\n    this.crouch = false;\\n    this.walk = false;\\n    this.sprint = false;\\n    this.stamina = 6;\\n    this.burning = 0;\\n    this.regenT = 0;\\n    this.lastHurt = 'bullet';\\n    this.shotCount = 0;\\n    this.jamScript = 0;\\n    this.mission = null;\\n    this.stepT = 0;\\n    this.lines = [];\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.subtitle = '';\\n    this.speaker = '';\\n    this.prompt = '';\\n    this.ledger = { killed: 0, friends: 0, moved: 0, stonesEarned: 0 };\\n    this.clock = 0;\\n    this.rideT = 0;\\n    this.riding = false;\\n    this.heard = { spot: false };\\n    this.aimError = 0;\\n    this.sheet = null;\\n    this.ending = null;\\n    this.civilians = 12;\\n    this.movedOnce = false;\\n    this.deadBuddies = new Set();\\n    this.round = null;\\n  }\\n\\n  build() {\\n    const built = buildLand(this.ctx, this.ctx.random.fork('land').state);\\n    this.land = built.land;\\n    this.heights = built.heights;\\n    fillFuel(this.fire, this.heights);\\n    const y = this.ground(0, 40);\\n    this.hero = new CharacterController(this.ctx.physics, {\\n      position: [0, y + 0.05, 40],\\n      speed: 5.4,\\n      jumpSpeed: 8,\\n      gravity: -24,\\n      radius: 0.35,\\n      halfHeight: 0.55,\\n    });\\n    this.paintMapBase();\\n    this.spawnTown();\\n    for (const c of CASES) this.cases.push({ ...c, taken: false });\\n    this.markSeen();\\n  }\\n\\n  ground(x, z) {\\n    if (this.land) return this.land.heightAt(x, z);\\n    if (this.heights) return this.heights(x, z);\\n    return 40;\\n  }\\n\\n  feet() {\\n    if (this.inVehicle && this.car) {\\n      const t = this.car.body.translation();\\n      return { x: t.x, y: t.y, z: t.z };\\n    }\\n\",\"total_lines\":1334}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9d9d19b7-19e2-40eb-a5cb-42715af94281-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"350→     * Freeze the game for `seconds` of real time: impact frames that sell a hit. Rendering,\\n     * screen shake and transitions keep going; overlapping hitstops keep the longest. Key\\n     * presses made during a hitstop still count afterwards (a buffered jump).\\n     */\\n    hitstop(seconds: number): void;\\n    /** Transitions, flashes and shockwaves (render/screenFx.ts): `await engine.screen.cover('iris')`. */\\n    get screen(): ScreenFx;\\n    /** The direction sunlight comes from (unit, pointing at the sun). */\\n    get sunDir(): Vector3;\\n    /**\\n360→     * Point the sun (and its shadows): a direction toward the sun, normalised here. A level's\\n     * time of day or a sun dial; reset to the engine default when the level unloads. Below the\\n     * horizon the sun is kept just above it (lower `sun.intensity` for night instead).\\n     */\\n    setSunDirection(dir: Vector3 | readonly [number, number, number]): void;\\n    /** The quality level in use (see `EngineOptions.quality`). */\\n    get quality(): QualityLevel;\\n    /**\\n     * Quality by option: a level, or `auto`: the device's level (low on phones and tablets, else\\n     * medium), lowered once if a few seconds of frames are slow (measured once, then remembered).\\n370→     */\\n    useQuality(option: QualityOption): void;\\n    /** Whether the debug panel is showing. */\\n    get debugShown(): boolean;\\n    /** Show or hide the debug panel (created the first time it shows, filled at once: the loop fills it only while the game runs). */\\n    showDebug(on: boolean): void;\\n    setQuality(level: QualityLevel): void;\\n    /** Frame cap of the render loop (0 = display rate). */\\n    get maxFps(): number;\\n    set maxFps(fps: number);\\n380→    static start(game: Game, options?: EngineOptions): Promise<Engine>;\\n    /**\\n     * The engine without a page (docs/engine/headless.md): the same boot, game code and frames as\\n     * `start`, with a `HeadlessView` that draws nothing, in Node. No DOM, no GPU, no listeners, no\\n     * AudioContext (`audio.counts` still counts), no panels; errors go to `engine.errors` and the\\n     * console. It runs in manual time from the start: advance it with `step()`, give it input with\\n     * `input.setKey` / `setPointer` / `send`, or `replay()` a recording. Models and packs are read\\n     * by `assets`, a reader of the game's own files (`(path) => Promise<ArrayBuffer>`; in this\\n     * engine's repository, `nodeAssets()`); the engine kit's built-in models need none.\\n     */\\n390→    static headless(game: Game, options?: HeadlessOptions): Promise<Engine>;\\n    /** The one boot sequence of `start` and `headless`: only the view and the page's parts differ. */\\n    private static boot;\\n    /** Debug panel, touch controls, then the render loop. */\\n    private finishStart;\\n    /**\\n     * Swap the camera preset mid-game (review tool: presets are a per-game choice). The\\n     * player, physics and the rest of the world are left exactly as they are. `free` and\\n     * `fixed` without an explicit position start from the view currently on screen.\\n     * Keeps `?camera=` in the URL in sync so a reload restores the preset; a game that swaps\\n400→     * presets as part of play (a side-scroller stage, a first-person hall, a photo mode) passes\\n     * `{ syncUrl: false }` so a reload still starts with its own camera.\\n     */\\n    setCamera(config: CameraConfig, options?: {\\n        syncUrl?: boolean;\\n    }): CameraRig;\\n    private wireRig;\\n    toggleMode(): RenderMode;\\n    toggleResolution(): Resolution;\\n    /** Every filter id the engine ships (see render/filters.ts). */\\n410→    get availableFilters(): readonly string[];\\n    get filters(): readonly string[];\\n    setFilters(ids: readonly string[]): void;\\n    /** The current look (a copy): per-layer pixel art and filters, whole-scene filters. */\\n    get look(): Look;\\n    /** Every named look (LOOK_PRESETS): `engine.setLook(engine.lookPresets.pixel_heroes)`. */\\n    get lookPresets(): Readonly<Record<string, Look>>;\\n    /** Apply a look (render/look.ts); `LOOK_PRESETS` has named ones. */\\n    setLook(look: Look): void;\\n    /** Cycle through LOOK_PRESETS ([ and ] keys). */\\n420→    cycleLook(step: 1 | -1): string;\\n    /** Snapshot for tests, tooling and agents. */\\n    state(): {\\n        version: string;\\n        game: string;\\n        seed: number;\\n        ready: boolean;\\n        paused: boolean;\\n        time: number;\\n        timeScale: number;\",\"content_concise\":\"350→     * Freeze the game for `seconds` of real time: impact frames that sell a hit. Rendering,\\n     * screen shake and transitions keep going; overlapping hitstops keep the longest. Key\\n     * presses made during a hitstop still count afterwards (a buffered jump).\\n     */\\n    hitstop(seconds: number): void;\\n    /** Transitions, flashes and shockwaves (render/screenFx.ts): `await engine.screen.cover('iris')`. */\\n    get screen(): ScreenFx;\\n    /** The direction sunlight comes from (unit, pointing at the sun). */\\n    get sunDir(): Vector3;\\n    /**\\n360→     * Point the sun (and its shadows): a direction toward the sun, normalised here. A level's\\n     * 