live && a.post === step.tag);\\n      if (!foe) throw new Error('no foe ' + step.tag);\\n      placeFacing(foe.x, foe.z);\\n      arm('tractor');\\n      holdFire(80);\\n    } else if (step.do === 'use' || step.do === 'collect' || step.do === 'report') {\\n      const prop = w.props.find((p) => p.tag === step.tag && p.alive !== false && !p.hidden);\\n      const site = step.to ? siteById(step.to) : null;\\n      const x = prop ? prop.x : site ? site.x : w.feet().x;\\n210→      const z = prop ? prop.z : site ? site.z : w.feet().z;\\n      if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n      w.teleport(x, z + 1);\\n      engine.step(1, DT);\\n      tap('KeyE');\\n    } else if (step.do === 'buddy-down') {\\n      tap('KeyE');\\n    } else if (step.do === 'hold' || step.do === 'ride') {\\n      release();\\n      const frames = Math.ceil(step.time * 60) + 30;\\n220→      engine.step(frames, DT);\\n    } else if (step.do === 'choice') {\\n      const pick = (opts.picks || [])[choiceI] || 0;\\n      choiceI += 1;\\n      if (pick === 1) tap('ArrowRight');\\n      tap('Enter');\\n    } else {\\n      throw new Error('unhandled step ' + step.do);\\n    }\\n    if (w.mission && !w.mission.done && w.mission.index === before) {\\n230→      const p = w.feet();\\n      throw new Error(id + ' stuck on ' + step.do + ' ' + (step.text || '') + ' at ' + p.x.toFixed(0) + ',' + p.z.toFixed(0));\\n    }\\n  }\\n  assert(w.mission?.done, id + ' did not finish');\\n  release();\\n}\\n\\nfunction walkSrc(dir, hit) {\\n  for (const name of readdirSync(dir)) {\\n240→    const path = join(dir, name);\\n    if (statSync(path).isDirectory()) walkSrc(path, hit);\\n    else if (name.endsWith('.js')) hit.push(readFileSync(path, 'utf8'));\\n  }\\n}\\n\\ntest('static files', () => {\\n  const files = [];\\n  walkSrc(join(root, 'src'), files);\\n  const blob = files.join('\\\\n');\\n250→  assert(!blob.includes('Math.random'), 'Math.random in src');\\n  for (const word of ['TODO', 'FIXME', 'placeholder', 'stub', 'coming soon']) {\\n    assert(!blob.toLowerCase().includes(word), 'forbidden ' + word);\\n  }\\n  const zip = join(root, 'vendor', 'pixel-engine.zip');\\n  const packed = execFileSync('unzip', ['-Z1', zip], { encoding: 'utf8' }).trim().split('\\\\n');\\n  const entry = packed.find((line) => line.endsWith('pixel-engine.js'));\\n  assert(entry, 'zip has no pixel-engine.js');\\n  const fromZip = execFileSync('unzip', ['-p', zip, entry], { maxBuffer: 16 * 1024 * 1024 });\\n  const onDisk = readFileSync(join(root, 'pixel-engine.js'));\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"offset\":140,\"limit\":120,\"raw_output\":\"      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n        goTo(x + radius + 30, z, 8);\\n      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n    } else if (step.do === 'syrette') {\\n      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n        engine.input.setButtons(0);\\n        engine.step(1, DT);\\n      }\\n    } else if (step.do === 'burn') {\\n      if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n      const r = step.r || 12;\\n      const origin = w.fire.cellAt(step.x, step.z);\\n      let lx = step.x;\\n      let lz = step.z;\\n      const reach = Math.ceil(r / 5);\\n      let best = Infinity;\\n      for (let dz = -reach; dz <= reach; dz++) {\\n        for (let dx = -reach; dx <= reach; dx++) {\\n          const ix = origin.ix + dx;\\n          const iz = origin.iz + dz;\\n          if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n          const i = w.fire.idx(ix, iz);\\n          if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n          const [cx, cz] = w.fire.center(ix, iz);\\n          const d = Math.hypot(cx - step.x, cz - step.z);\\n          if (d > r - 1 || d >= best) continue;\\n          best = d;\\n          lx = cx;\\n          lz = cz;\\n        }\\n      }\\n      w.teleport(lx, lz + 18);\\n      game.ctx.camera.yaw = 0;\\n      arm('flare');\\n      tapFire();\\n      engine.step(20, DT);\\n    } else if (step.do === 'clear') {\\n      const foe = w.actors.find((a) => a.alive && a.post === step.tag);\\n      if (!foe) throw new Error('no foe ' + step.tag);\\n      placeFacing(foe.x, foe.z);\\n      arm('tractor');\\n      holdFire(80);\\n    } else if (step.do === 'use' || step.do === 'collect' || step.do === 'report') {\\n      const prop = w.props.find((p) => p.tag === step.tag && p.alive !== false && !p.hidden);\\n      const site = step.to ? siteById(step.to) : null;\\n      const x = prop ? prop.x : site ? site.x : w.feet().x;\\n      const z = prop ? prop.z : site ? site.z : w.feet().z;\\n      if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n      w.teleport(x, z + 1);\\n      engine.step(1, DT);\\n      tap('KeyE');\\n    } else if (step.do === 'buddy-down') {\\n      tap('KeyE');\\n    } else if (step.do === 'hold' || step.do === 'ride') {\\n      release();\\n      const frames = Math.ceil(step.time * 60) + 30;\\n      engine.step(frames, DT);\\n    } else if (step.do === 'choice') {\\n      const pick = (opts.picks || [])[choiceI] || 0;\\n      choiceI += 1;\\n      if (pick === 1) tap('ArrowRight');\\n      tap('Enter');\\n    } else {\\n      throw new Error('unhandled step ' + step.do);\\n    }\\n    if (w.mission && !w.mission.done && w.mission.index === before) {\\n      const p = w.feet();\\n      throw new Error(id + ' stuck on ' + step.do + ' ' + (step.text || '') + ' at ' + p.x.toFixed(0) + ',' + p.z.toFixed(0));\\n    }\\n  }\\n  assert(w.mission?.done, id + ' did not finish');\\n  release();\\n}\\n\\nfunction walkSrc(dir, hit) {\\n  for (const name of readdirSync(dir)) {\\n    const path = join(dir, name);\\n    if (statSync(path).isDirectory()) walkSrc(path, hit);\\n    else if (name.endsWith('.js')) hit.push(readFileSync(path, 'utf8'));\\n  }\\n}\\n\\ntest('static files', () => {\\n  const files = [];\\n  walkSrc(join(root, 'src'), files);\\n  const blob = files.join('\\\\n');\\n  assert(!blob.includes('Math.random'), 'Math.random in src');\\n  for (const word of ['TODO', 'FIXME', 'placeholder', 'stub', 'coming soon']) {\\n    assert(!blob.toLowerCase().includes(word), 'forbidden ' + word);\\n  }\\n  const zip = join(root, 'vendor', 'pixel-engine.zip');\\n  const packed = execFileSync('unzip', ['-Z1', zip], { encoding: 'utf8' }).trim().split('\\\\n');\\n  const entry = packed.find((line) => line.endsWith('pixel-engine.js'));\\n  assert(entry, 'zip has no pixel-engine.js');\\n  const fromZip = execFileSync('unzip', ['-p', zip, entry], { maxBuffer: 16 * 1024 * 1024 });\\n  const onDisk = readFileSync(join(root, 'pixel-engine.js'));\\n\",\"total_lines\":639}}","is_error":false},{"type":"tool_result","tool_use_id":"call-f7e2238a-2afe-41cd-af17-ebc5840ebb67-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1260→    if (this.hp < 20 && this.hp > 0) {\\n      this.prompt = 'FIELD SURGERY';\\n      return;\\n    }\\n    if (step?.text && this.mission?.textT > 0) {\\n      this.prompt = step.text;\\n      return;\\n    }\\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 8) {\\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\\n1270→      return;\\n    }\\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\\n  }\\n\\n  tickMission(dt) {\\n    const step = this.currentStep();\\n    if (!step || !this.mission) return;\\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\\n    const p = this.feet();\\n1280→    if (step.do === 'goto' || step.do === 'drive') {\\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\\n    } else if (step.do === 'leave') {\\n      const target = siteById(step.site);\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\\n    } else if (step.do === 'burn') {\\n      const cell = this.fire.cellAt(step.x, step.z);\\n      const reach = Math.ceil((step.r || 12) / 5);\\n      let hot = false;\\n1290→      if (cell) {\\n        for (let dz = -reach; dz <= reach && !hot; dz++) {\\n          for (let dx = -reach; dx <= reach; dx++) {\\n            const ix = cell.ix + dx;\\n            const iz = cell.iz + dz;\\n            if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n            const [cx, cz] = this.fire.center(ix, iz);\\n            if (Math.hypot(cx - step.x, cz - step.z) > (step.r || 12)) continue;\\n            if (this.fire.state[this.fire.idx(ix, iz)] === 1) {\\n              hot = true;\\n1300→              break;\\n            }\\n          }\\n        }\\n      }\\n      if (hot) this.completeStep();\\n    } else if (step.do === 'hold') {\\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\\n      if (this.mission.hold >= step.time) this.completeStep();\\n    } else if (step.do === 'ride') {\\n1310→      this.riding = true;\\n      this.mission.ride += dt;\\n      if (this.mission.ride >= step.time) {\\n        this.riding = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\\n        this._reported = false;\\n1320→        this.completeStep();\\n      }\\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\\n      this._linesDone = false;\\n      this.completeStep();\\n    } else if (step.do === 'choice' && this.choicePick != null) {\\n      const pick = this.choicePick;\\n      this.choicePick = null;\\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\\n1330→      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\\n      this.completeStep();\\n    }\\n  }\\n\\n  advanceLines() {\\n    if (this.lines.length) {\\n      const id = this.lines.shift();\\n      this.subtitle = line(id);\\n      this.speaker = id.split(':')[0].toUpperCase();\",\"content_concise\":\"1260→    if (this.hp < 20 && this.hp > 0) {\\n      this.prompt = 'FIELD SURGERY';\\n      return;\\n    }\\n    if (step?.text && this.mission?.textT > 0) {\\n      this.prompt = step.text;\\n      return;\\n    }\\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 8) {\\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\\n1270→      return;\\n    }\\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\\n  }\\n\\n  tickMission(dt) {\\n    const step = this.currentStep();\\n    if (!step || !this.mission) return;\\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\\n    const p = this.feet();\\n1280→    if (step.do === 'goto' || step.do === 'drive') {\\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\\n    } else if (step.do === 'leave') {\\n      const target = siteById(step.site);\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\\n    } else if (step.do === 'burn') {\\n      const cell = this.fire.cellAt(step.x, step.z);\\n      const reach = Math.ceil((step.r || 12) / 5);\\n      let hot = false;\\n1290→      if (cell) {\\n        for (let dz = -reach; dz <= reach && !hot; dz++) {\\n          for (let dx = -reach; dx <= reach; dx++) {\\n            const ix = cell.ix + dx;\\n            const iz = cell.iz + dz;\\n            if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n            const [cx, cz] = this.fire.center(ix, iz);\\n            if (Math.hypot(cx - step.x, cz - step.z) > (step.r || 12)) continue;\\n            if (this.fire.state[this.fire.idx(ix, iz)] === 1) {\\n              hot = true;\\n1300→              break;\\n            }\\n          }\\n        }\\n      }\\n      if (hot) this.completeStep();\\n    } else if (step.do === 'hold') {\\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\\n      if (this.mission.hold >= step.time) this.completeStep();\\n    } else if (step.do === 'ride') {\\n1310→      this.riding = true;\\n      this.mission.ride += dt;\\n      if (this.mission.ride >= step.time) {\\n        this.riding = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\\n        this._reported = false;\\n1320→        this.completeStep();\\n      }\\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\\n      this._linesDone = false;\\n      this.completeStep();\\n    } else if (step.do === 'choice' && this.choicePick != null) {\\n      const pick = this.choicePick;\\n      this.choicePick = null;\\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\\n1330→      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\\n      this.completeStep();\\n    }\\n  }\\n\\n  advanceLines() {\\n    if (this.lines.length) {\\n      const id = this.lines.shift();\\n      this.subtitle = line(id);\\n      this.speaker = id.split(':')[0].toUpperCase();\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\",\"offset\":1260,\"limit\":80,\"raw_output\":\"    if (this.hp < 20 && this.hp > 0) {\\n      this.prompt = 'FIELD SURGERY';\\n      return;\\n    }\\n    if (step?.text && this.mission?.textT > 0) {\\n      this.prompt = step.text;\\n      return;\\n    }\\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 8) {\\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\\n      return;\\n    }\\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\\n  }\\n\\n  tickMission(dt) {\\n    const step = this.currentStep();\\n    if (!step || !this.mission) return;\\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\\n    const p = this.feet();\\n    if (step.do === 'goto' || step.do === 'drive') {\\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\\n    } else if (step.do === 'leave') {\\n      const target = siteById(step.site);\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\\n    } else if (step.do === 'burn') {\\n      const cell = this.fire.cellAt(step.x, step.z);\\n      const reach = Math.ceil((step.r || 12) / 5);\\n      let hot = false;\\n      if (cell) {\\n        for (let dz = -reach; dz <= reach && !hot; dz++) {\\n          for (let dx = -reach; dx <= reach; dx++) {\\n            const ix = cell.ix + dx;\\n            const iz = cell.iz + dz;\\n            if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n            const [cx, cz] = this.fire.center(ix, iz);\\n            if (Math.hypot(cx - step.x, cz - step.z) > (step.r || 12)) continue;\\n            if (this.fire.state[this.fire.idx(ix, iz)] === 1) {\\n              hot = true;\\n              break;\\n            }\\n          }\\n        }\\n      }\\n      if (hot) this.completeStep();\\n    } else if (step.do === 'hold') {\\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\\n      if (this.mission.hold >= step.time) this.completeStep();\\n    } else if (step.do === 'ride') {\\n      this.riding = true;\\n      this.mission.ride += dt;\\n      if (this.mission.ride >= step.time) {\\n        this.riding = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\\n        this._reported = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\\n      this._linesDone = false;\\n      this.completeStep();\\n    } else if (step.do === 'choice' && this.choicePick != null) {\\n      const pick = this.choicePick;\\n      this.choicePick = null;\\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\\n      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\\n      this.completeStep();\\n    }\\n  }\\n\\n  advanceLines() {\\n    if (this.lines.length) {\\n      const id = this.lines.shift();\\n      this.subtitle = line(id);\\n      this.speaker = id.split(':')[0].toUpperCase();\\n\",\"total_lines\":1394}}","is_error":false},{"type":"tool_result","tool_use_id":"call-f7e2238a-2afe-41cd-af17-ebc5840ebb67-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"480→    const [a, b] = TUNING_RANGES[key];\\n    game.applySlider(key, a);\\n    assert(TUNING[key] === a, key + ' low');\\n    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n  game.resetSliders();\\n  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n});\\n490→\\ntest('story both endings', async () => {\\n  await boot();\\n  const chain = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5'];\\n  for (const id of chain) playMission(id);\\n  const burntBefore = game.world.fire.burntCount;\\n  playMission('m6', { dead: ['dov'] });\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy was not kept');\\n  assert(game.world.fire.burntCount > burntBefore, 'story scar missing');\\n  playMission('m7');\\n500→  playMission('m8');\\n  playMission('m9', { picks: [0, 0] });\\n  assert(game.world.ledger.killed >= 1, 'shoot choice did not pay a kill');\\n  assert(game.world.sheet === 'walk', 'walk sheet ' + game.world.sheet);\\n  playMission('end', { sheet: 'walk' });\\n  assert(game.ending === 'walk', 'walk card ' + game.ending);\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy lost before the ending');\\n  playMission('end', { sheet: 'give', dead: ['ines'] });\\n  assert(game.ending === 'give', 'give card');\\n  assert(game.world.deadBuddies.has('ines'), 'second ending had no dead buddy');\\n510→  assert(game.world.ledger.moved > 0, 'nobody moved');\\n  assert(game.world.ledger.stonesEarned > 0, 'no stones');\\n  assert(game.world.ledger.friends >= 1, 'no friends lost');\\n});\\n\\ntest('solo round', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.startSolo();\\n  const round = game.world.round;\\n520→  const seat = round.seat(0);\\n  const merc = round.seats.find((s) => s.ai);\\n  const startHp = merc.hp;\\n  arm('tractor');\\n  for (let n = 0; n < 10 && !merc.down; n++) {\\n    const foe = game.world.actors.find((a) => a.seat === merc.id);\\n    if (!foe) break;\\n    placeFacing(foe.x, foe.z);\\n    holdFire(10);\\n  }\\n530→  assert(merc.hp < startHp, 'friendly fire did nothing ' + merc.hp);\\n  assert(merc.down, 'merc did not drop ' + merc.hp);\\n  game.world.teleport(merc.x, merc.z + 1);\\n  engine.step(1, DT);\\n  holdKey('KeyE', 200);\\n  assert(!merc.down && merc.hp > 0, 'revive failed');\\n  const box = round.cases.find((c) => !c.taken && !c.carrier);\\n  game.world.teleport(box.x, box.z);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n540→  assert(seat.carrying === box.id, 'did not pick up');\\n  game.world.hurt(500, 'bullet', true);\\n  assert(round.localDown && box.carrier == null && !box.taken, 'down did not drop the case');\\n  game.session.emit('time-up');\\n  assert(game.session.ended, 'time-up did not finish');\\n  const standings = game.session.outcome.standings;\\n  assert(Array.isArray(standings) && standings.length > 0, 'no standings');\\n  assert(game.session.outcome.stats[0].Stones != null, 'no stats');\\n});\\n\\n550→test('menus attract pause touch', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.idle = 0;\\n  game.attract = false;\\n  game.mode = 'title';\\n  game.screen = 'title';\\n  const saves = game.saves;\\n  engine.step(600, DT);\\n  assert(!game.attract && game.idle < 10.01, 'attract early ' + game.idle);\\n560→  engine.step(1, DT);\\n  assert(game.attract && game.state().attract