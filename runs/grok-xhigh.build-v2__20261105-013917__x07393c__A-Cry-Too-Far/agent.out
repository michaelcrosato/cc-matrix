{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-87a46740-cc87-4d09-9f6c-ece01d363d0a-51","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** First-person look. Re-install after every setCamera while the preset is first. */\\nlet wantLock = false;\\n\\nexport function setWantLock(v) {\\n  wantLock = !!v;\\n}\\n\\nexport function installLook(ctx, cam) {\\n  ctx.camera.step = function (u) {\\n10→    if (cam.override) {\\n      this.camera.position.set(cam.override.position[0], cam.override.position[1], cam.override.position[2]);\\n      this.camera.lookAt(cam.override.target[0], cam.override.target[1], cam.override.target[2]);\\n      this.focus.copy(this.camera.position);\\n      return;\\n    }\\n    const k = cam.enabled ? 1 : 0;\\n    const mx = u.input.mouseDelta.x;\\n    const my = u.input.mouseDelta.y;\\n    this.yaw -= mx * 0.0025 * cam.sensX * k;\\n20→    const inv = cam.invertY ? -1 : 1;\\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - my * 0.0025 * cam.sensY * inv * k));\\n    this.focus.copy(u.target);\\n    this.camera.position.copy(u.eye);\\n    this.camera.rotation.set(this.pitch, this.yaw, 0);\\n  };\\n  ctx.input.gamepadButtons = {\\n    0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle',\\n    4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2',\\n    8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3',\\n30→    12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight',\\n  };\\n  Object.defineProperty(ctx.input, 'wantsPointerLock', {\\n    get: () => wantLock,\\n    set() {},\\n    configurable: true,\\n  });\\n}\\n\\nexport const LOOK = {\\n40→  scene: [\",\"content_concise\":\"1→/** First-person look. Re-install after every setCamera while the preset is first. */\\nlet wantLock = false;\\n\\nexport function setWantLock(v) {\\n  wantLock = !!v;\\n}\\n\\nexport function installLook(ctx, cam) {\\n  ctx.camera.step = function (u) {\\n10→    if (cam.override) {\\n      this.camera.position.set(cam.override.position[0], cam.override.position[1], cam.override.position[2]);\\n      this.camera.lookAt(cam.override.target[0], cam.override.target[1], cam.override.target[2]);\\n      this.focus.copy(this.camera.position);\\n      return;\\n    }\\n    const k = cam.enabled ? 1 : 0;\\n    const mx = u.input.mouseDelta.x;\\n    const my = u.input.mouseDelta.y;\\n    this.yaw -= mx * 0.0025 * cam.sensX * k;\\n20→    const inv = cam.invertY ? -1 : 1;\\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - my * 0.0025 * cam.sensY * inv * k));\\n    this.focus.copy(u.target);\\n    this.camera.position.copy(u.eye);\\n    this.camera.rotation.set(this.pitch, this.yaw, 0);\\n  };\\n  ctx.input.gamepadButtons = {\\n    0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle',\\n    4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2',\\n    8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3',\\n30→    12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight',\\n  };\\n  Object.defineProperty(ctx.input, 'wantsPointerLock', {\\n    get: () => wantLock,\\n    set() {},\\n    configurable: true,\\n  });\\n}\\n\\nexport const LOOK = {\\n40→  scene: [\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/core/look.js\",\"offset\":null,\"limit\":40,\"raw_output\":\"/** First-person look. Re-install after every setCamera while the preset is first. */\\nlet wantLock = false;\\n\\nexport function setWantLock(v) {\\n  wantLock = !!v;\\n}\\n\\nexport function installLook(ctx, cam) {\\n  ctx.camera.step = function (u) {\\n    if (cam.override) {\\n      this.camera.position.set(cam.override.position[0], cam.override.position[1], cam.override.position[2]);\\n      this.camera.lookAt(cam.override.target[0], cam.override.target[1], cam.override.target[2]);\\n      this.focus.copy(this.camera.position);\\n      return;\\n    }\\n    const k = cam.enabled ? 1 : 0;\\n    const mx = u.input.mouseDelta.x;\\n    const my = u.input.mouseDelta.y;\\n    this.yaw -= mx * 0.0025 * cam.sensX * k;\\n    const inv = cam.invertY ? -1 : 1;\\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - my * 0.0025 * cam.sensY * inv * k));\\n    this.focus.copy(u.target);\\n    this.camera.position.copy(u.eye);\\n    this.camera.rotation.set(this.pitch, this.yaw, 0);\\n  };\\n  ctx.input.gamepadButtons = {\\n    0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle',\\n    4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2',\\n    8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3',\\n    12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight',\\n  };\\n  Object.defineProperty(ctx.input, 'wantsPointerLock', {\\n    get: () => wantLock,\\n    set() {},\\n    configurable: true,\\n  });\\n}\\n\\nexport const LOOK = {\\n  scene: [\\n\",\"total_lines\":47}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"948ab072-df85-45de-9921-c4061476a394"}
