s.inVehicle && this.car) this.car.reset([x, y + 1, z], this.car.yaw);\\n    else this.hero.teleport([x, y, z]);\\n    this.markSeen();\\n  }\\n\\n  giveGun(id, cond) {\\n    const gun = freshWeapon(id, cond);\\n    if (!gun) return;\\n    if (this.upgrades.has('belt') && gun.reserve) gun.reserve = Math.round(gun.reserve * 1.5);\\n    const slot = gun.slot;\\n    const at = this.guns.findIndex((g) => g.slot === slot);\\n    if (at >= 0) this.guns[at] = gun;\\n    else this.guns.push(gun);\\n    this.unlocked.add(id);\\n    this.slot = Math.max(0, this.guns.findIndex((g) => g.id === id));\\n  }\\n\\n  get weapon() {\\n    return this.guns[this.slot] || null;\\n  }\\n\\n  hurt(amount, kind = 'bullet', force = false) {\\n    if (this.dead) return;\\n    if (this.god && !force) return;\\n    const d = amount * TUNING.playerDamageTaken;\\n    this.hp = Math.max(0, this.hp - d);\\n    this.lastHurt = kind;\\n    this.regenT = 5;\\n    this.surgeryT = 0;\\n    if (this.hp <= 0) this.down();\\n  }\\n\\n  down() {\\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\\n    if (buddy) {\\n      this.rescueT = 2.2;\\n      this.rescueBuddy = buddy;\\n      this.subtitle = line('buddy:rescue');\\n      this.speaker = buddy.name;\\n      return;\\n    }\\n    this.dead = true;\\n    this.subtitle = line('death');\\n    this.game.onDeath();\\n  }\\n\\n  pay(amount) {\\n    const n = Math.round(amount * TUNING.stonesReward);\\n    this.stones += n;\\n    this.ledger.stonesEarned += n;\\n  }\\n\\n  applySetup(setup, deadIds = []) {\\n    this.flags = new Set(setup.flags || []);\\n    this.safehouses = new Set(setup.safehouses || []);\\n    this.stones = setup.stones ?? 0;\\n    this.tablets = setup.tablets ?? 0;\\n    this.syrettes = setup.syrettes ?? 3;\\n    this.hour = setup.hour ?? 9;\\n    this.gameHours = this.hour;\\n    this.truce = setup.truce !== false;\\n    this.column = !!setup.column;\\n    this.tracker = !!setup.tracker;\\n    this.hp = 100;\\n    this.dead = false;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.feverT = setup.feverIn === 0 ? 0 : (TUNING.feverMinutes * 60);\\n    this.guns = [];\\n    for (const g of setup.guns || []) this.giveGun(g.id, g.cond);\\n    if (!this.guns.find((g) => g.id === 'cane') && (setup.guns || []).length) this.giveGun('cane', 100);\\n    this.buddies = (setup.buddies || []).map((id) => this.makeBuddy(id));\\n    for (const id of deadIds) {\\n      const b = this.buddies.find((x) => x.id === id);\\n      if (b) {\\n        b.alive = false;\\n        b.down = false;\\n        this.ledger.friends += 1;\\n      } else this.buddies.push({ ...this.makeBuddy(id), alive: false, down: false, hp: 0 });\\n    }\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.paintMapBase();\\n    for (const scar of setup.scars || []) this.layScar(scar);\\n    this.sheet = setup.sheet || null;\\n    this.ending = null;\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.lines = [];\\n    this.carrying = null;\\n    this.jamScript = 0;\\n    this.shotCount = 0;\\n    this.movedOnce = false;\\n    this.civilians = 12;\\n    this.provoked = false;\\n    if (setup.truck) this.ensureTruck(setup.x + 6, setup.z);\\n    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\\n    this.subtitle = '';\\n  }\\n\\n  makeBuddy(id) {\\n    const d = BUDDY_DEF[id] || { name: id.toUpperCase(), hp: 200 };\\n    return { id, name: d.name, hp: d.hp, max: d.hp, alive: true, down: false, downLeft: 0, trust: 1, spentUntil: 0, wound: false, burning: false };\\n  }\\n\\n  layScar(id) {\\n    const strip = STRIPS[id];\\n    if (!strip) return;\\n    this.fire.burnStrip(strip.points, strip.width);\\n    this.refreshMap();\\n  }\\n\\n  startMission(id, opts = {}) {\\n    const m = missionById(id);\\n    if (!m) return false;\\n    const dead = opts.dead || [];\\n    this.applySetup(m.setup || {}, dead);\\n    this.mission = {\\n      def: m,\\n      index: 0,\\n      done: false,\\n      textT: 5,\\n      hold: 0,\\n      ride: 0,\\n    };\\n    this.pass = m.faction || null;\\n    this.windPin = m.wind || null;\\n    if (m.weather === 'storm') this.rain = true;\\n    else this.rain = false;\\n    if (m.hour !== undefined) this.hour = m.hour;\\n    this.announceStep();\\n    this.game.mode = 'play';\\n    this.game.screen = 'play';\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    return true;\\n  }\\n\\n  currentStep() {\\n    if (!this.mission || this.mission.done) return null;\\n    return this.mission.def.steps[this.mission.index] || null;\\n  }\\n\\n  announceStep() {\\n    const s = this.currentStep();\\n    if (!s) return;\\n    this.subtitle = s.text || '';\\n    this.speaker = '';\\n    this.mission.textT = 5;\\n    this.mission.hold = 0;\\n    this.mission.ride = 0;\\n    if (s.do === 'lines') this.lines = [...s.ids];\\n    if (s.do === 'choice') {\\n      this.choice = { id: s.id, options: s.options, focus: 0 };\\n      this.choicePick = null;\\n    }\\n    if (s.do === 'jam') this.jamScript = 5;\\n    if (s.do === 'repair') {\\n      this.ensureTruck(this.feet().x + 3, this.feet().z);\\n      this.vehicleHp = 0;\\n    }\\n    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\\n    if (s.do === 'buddy-down') this.knockBuddy();\\n    if (s.do === 'fever-fall') {\\n      this.feverT = 0;\\n      this.tablets = 0;\\n    }\\n  }\\n\\n  knockBuddy() {\\n    const b = this.buddies.find((x) => x.alive && !x.down);\\n    if (!b) {\\n      this.subtitle = line('buddy:burn');\\n      this.completeStep();\\n      return;\\n    }\\n    b.hp = 0;\\n    b.down = true;\\n    b.downLeft = 40;\\n    b.burning = true;\\n    b.x = this.feet().x + 1.2;\\n    b.z = this.feet().z;\\n    this.subtitle = line('buddy:burn');\\n    this.speaker = b.name;\\n  }\\n\\n  completeStep() {\\n    if (!this.mission || this.mission.done) return;\\n    this.mission.index += 1;\\n    this.choice = null;\\n    if (this.mission.index >= this.mission.def.steps.length) {\\n      this.mission.done = true;\\n      this.finishMission();\\n      return;\\n    }\\n    this.announceStep();\\n  }\\n\\n  finishMission() {\\n    const m = this.mission.def;\\n    for (const effect of m.onDone || []) {\\n      if (effect.flag) this.flags.add(effect.flag);\\n      if (effect.safehouse) this.safehouses.add(effect.safehouse);\\n      if (effect.tablets) this.tablets += effect.tablets;\\n      if (effect.pay) this.pay(effect.pay);\\n      if (effect.scar) this.layScar(effect.scar);\\n      if (effect.buddy) {\\n        if (!this.buddies.some((b) => b.id === effect.buddy)) this.buddies.push(this.makeBuddy(effect.buddy));\\n      }\\n      if (effect.tracker) this.tracker = true;\\n      if (effect.truce === false) this.truce = false;\\n      if (effect.column) this.column = true;\\n      if (effect.moveVillage) this.moveVillage();\\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\\n    }\\n    this.pass = null;\\n    this.windPin = null;\\n    this.subtitle = m.title + ' DONE';\\n  }\\n\\n  moveVillage() {\\n    if (this.movedOnce) return;\\n    this.movedOnce = true;\\n    this.ledger.moved += this.civilians;\\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\\n  }\\n\\n  ensureTruck(x, z) {\\n    if (this.car) return;\\n    const y = this.ground(x, z) + 1.2;\\n    this.car = new Vehicle(this.ctx.physics, {\\n      at: [x, y, z],\\n      yaw: 0,\\n      size: [0.95, 0.45, 2.2],\\n      mass: 12,\\n      power: 160,\\n      topSpeed: TUNING.vehicleTopSpeed,\\n      wheelRadius: 0.42,\\n      suspension: 0.45,\\n      stiffness: 30,\\n      grip: 2.6,\\n    });\\n    this.vehicleHp = 100;\\n    this.vehicleKind = 'pickup';\\n    this.truckX = x;\\n    this.truckZ = z;\\n  }\\n\\n  fixed(dt) {\\n    this.clock += dt;\\n    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\\n    this.hour = ((this.gameHours % 24) + 24) % 24;\\n    this.stepWind(dt);\\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\\n    this.fire.rain = this.rain;\\n    this.fire.step(dt);\\n    this.tickFever(dt);\\n    this.tickBurn(dt);\\n    this.tickRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    if (this.game.blocksSim()) return;\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\\n\",\"total_lines\":1199}}","is_error":false},{"type":"tool_result","tool_use_id":"call-fc6e27d9-5fcf-41eb-a17e-81a30ad51f2f-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Story missions. A bot can start any one from its setup and finish it with actions. */\\nexport const MISSIONS = [\\n  {\\n    id: 'm0', title: 'THE GOODS LINE', giver: 'bakr', pay: 0, hour: 18.5,\\n    faction: null,\\n    setup: { x: -520, z: 108, hour: 18.5, tablets: 0, syrettes: 0, guns: [], buddies: [], stones: 0, feverIn: 0 },\\n    steps: [\\n      { do: 'lines', ids: ['bakr:m0.1', 'bakr:m0.2', 'bakr:m0.3', 'bakr:m0.6'], text: 'RIDE WITH BAKR' },\\n      { do: 'map', text: 'RAISE THE MAP' },\\n10→      { do: 'fever-fall', text: 'THE FEVER' },\\n    ],\\n    onDone: [{ flag: 'm0' }],\\n  },\\n  {\\n    id: 'm1', title: 'MERCY RUN', giver: 'odile', pay: 5, hour: 8, requires: ['m0'],\\n    faction: null,\\n    setup: {\\n      x: 12, z: 55, hour: 8, tablets: 1, syrettes: 2, stones: 0,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'm38', cond: 100 }, { id: 'tractor', cond: 45 }],\\n20→      buddies: [], flags: ['m0'], truck: true,\\n    },\\n    steps: [\\n      { do: 'tablet', text: 'TAKE A TABLET' },\\n      { do: 'drive', x: -260, z: 240, r: 28, text: 'DRIVE MEDICINE TO THREE WELLS' },\\n      { do: 'goto', x: -200, z: 30, r: 20, text: 'THE WEST ROAD IS MANNED' },\\n      { do: 'jam', text: 'CLEAR THE JAM' },\\n      { do: 'repair', text: 'REPAIR THE TRUCK' },\\n      { do: 'syrette', text: 'USE A SYRETTE' },\\n      { do: 'report', to: 'clinic', text: 'REPORT TO ODILE' },\\n30→    ],\\n    onDone: [{ flag: 'm1' }, { safehouse: 'pump-shed' }, { tablets: 3 }, { pay: 5 }],\\n  },\\n  {\\n    id: 'm2', title: 'A CAGE AT THE POST', giver: 'tibor', pay: 8, hour: 21, requires: ['m1'],\\n    faction: null,\\n    setup: {\\n      x: -18, z: 62, hour: 21, tablets: 3, syrettes: 3, stones: 5,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'm38', cond: 100 }, { id: 'tractor', cond: 70 }],\\n      buddies: [], flags: ['m0', 'm1'], safehouses: ['pump-shed'],\\n40→    },\\n    steps: [\\n      { do: 'lines', ids: ['tibor:m2.1', 'tibor:shop'], text: 'TIBOR HAS A JOB' },\\n      { do: 'goto', site: 'ranger-post', r: 24, text: 'REACH THE RANGER POST' },\\n      { do: 'clear', tag: 'cage-guard', n: 1, text: 'DEAL WITH THE CAGE GUARD' },\\n      { do: 'use', tag: 'cage', text: 'OPEN THE CAGE' },\\n    ],\\n    onDone: [{ flag: 'm2' }, { buddy: 'ines' }, { safehouse: 'ranger-post' }, { pay: 8 }],\\n  },\\n  {\\n50→    id: 'm3', title: 'FUEL FOR THE PEACE', giver: 'vance', pay: 15, hour: 16, requires: ['m2'],\\n    faction: 'concord',\\n    wind: { dir: -2.5, speed: 5 },\\n    setup: {\\n      x: -430, z: -180, hour: 16, tablets: 3, syrettes: 3, stones: 13,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'flare', cond: 100 }, { id: 'tractor', cond: 80 }],\\n      buddies: ['ines'], flags: ['m0', 'm1', 'm2'], safehouses: ['pump-shed', 'ranger-post'],\\n    },\\n    steps: [\\n      { do: 'lines', ids: ['vance:m3.1', 'vance:m3.2'], text: 'VANCE HAS AN INVOICE' },\\n60→      { do: 'goto', site: 'east-siding', r: 40, text: 'REACH THE SIDING' },\\n      { do: 'destroy', tag: 'fuel-tank', n: 3, text: 'BURN THE TANKS' },\\n      { do: 'leave', site: 'east-siding', r: 80, text: 'GET OUT' },\\n      { do: 'report', to: 'fort-clement', text: 'REPORT TO VANCE' },\\n    ],\\n    onDone: [{ flag: 'm3' }, { scar: 'A' }, { pay: 15 }],\\n  },\\n  {\\n    id: 'm4', title: 'SEED MONEY', giver: 'ansa', pay: 20, hour: 11, requires: ['m2'],\\n    faction: 'harvest',\\n70→    setup: {\\n      x: 400, z: 280, hour: 11, tablets: 3, syrettes: 3, stones: 13,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'tube', cond: 100 }, { id: 'tractor', cond: 80 }],\\n      buddies: ['ines'], flags: ['m0', 'm1', 'm2'], safehouses: ['pump-shed', 'ranger-post'],\\n    },\\n    steps: [\\n      { do: 'lines', ids: ['ansa:m4.1', 'ansa:m4.2'], text: 'ANSA CORRECTS YOU' },\\n      { do: 'goto', x: 200, z: 470, r: 50, text: 'MEET THE CONVOY ON THE SALT' },\\n      { do: 'destroy', tag: 'convoy', n: 1, text: 'STOP THE PAYROLL TRUCK' },\\n      { do: 'collect', tag: 'payroll', text: 'TAKE THE CASE' },\\n80→    ],\\n    onDone: [{ flag: 'm4' }, { buddy: 'dov' }, { tracker: true }, { pay: 20 }],\\n  },\\n  {\\n    id: 'm5', title: 'THE WATER QUESTION', giver: 'vance', pay: 20, hour: 10, requires: ['m3'],\\n    faction: 'concord',\\n    setup: {\\n      x: -430, z: -180, hour: 10, tablets: 2, syrettes: 3, stones: 28,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'charge', cond: 100 }, { id: 'tractor', cond: 75 }],\\n      buddies: ['ines', 'dov'], flags: ['m0', 'm1', 'm2', 'm3'],\\n90→      safehouses: ['pump-shed', 'ranger-post'], scars: ['A'],\\n    },\\n    steps: [\\n      { do: 'lines', ids: ['vance:m5.1', 'vance:m5.2'], text: 'THE WATER QUESTION' },\\n      { do: 'goto', site: 'pump-station', r: 30, text: 'REACH THE PUMP' },\\n      { do: 'destroy', tag: 'pump', n: 1, text: 'BREAK THE PUMP' },\\n      { do: 'report', to: 'fort-clement', text: 'REPORT TO VANCE' },\\n    ],\\n    onDone: [{ flag: 'm5' }, { moveVillage: true }, { pay: 20 }],\\n  },\\n100→  {\\n    id: 'm6', title: 'THE LONG FIELD', giver: 'ansa', pay: 25, hour: 22, requires: ['m4'],\\n    faction: 'harvest',\\n    setup: {\\n      x: 400, z: 280, hour: 22, tablets: 2, syrettes: 1, stones: 33,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'flare', cond: 100 }, { id: 'm38', cond: 90 }],\\n      buddies: ['ines', 'dov'], flags: ['m0', 'm1', 'm2', 'm4'],\\n      safehouses: ['pump-shed', 'ranger-post'], scars: ['A'],\\n    },\\n    steps: [\\n110→      { do: 'lines', ids: ['ansa:m6.1'], text: 'BURN THE LONG FIELD' },\\n      { do: 'goto', site: 'long-field', r: 40, text: 'REACH THE LONG FIELD' },\\n      { do: 'burn', x: -260, z: -300, r: 18, text: 'LIGHT THE CROP' },\\n      { do: 'buddy-down', text: 'SYRETTE OR FINISH IT' },\\n    ],\\n    onDone: [{ flag: 'm6' }, { scar: 'B' }, { pay: 25 }],\\n  },\\n  {\\n    id: 'm7', title: 'THE CUT', giver: 'harrow', pay: 10, hour: 15, requires: ['m5', 'm6'],\\n    faction: null,\\n120→    setup: {\\n      x: -120, z: 150, hour: 15, tablets: 2, syrettes: 2, stones: 50,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'tractor', cond: 60 }, { id: 'flare', cond: 80 }],\\n      buddies: ['ines'], flags: ['m0', 'm1', 'm2', 'm3', 'm4', 'm5', 'm6'],\\n      safehouses: ['pump-shed', 'ranger-post'], scars: ['A', 'B'],\\n    },\\n    steps: [\\n      { do: 'goto', site: 'sluice', r: 20, text: 'REACH THE SLUICE HOUSE' },\\n      { do: 'use', tag: 'ledger-book', text: 'TAKE HIS LEDGER' },\\n    ],\\n130→    onDone: [{ flag: 'm7' }, { scar: 'C' }, { truce: false }, { pay: 10 }],\\n  },\\n  {\\n    id: 'm8', title: 'LAST TRAIN', giver: 'odile', pay: 8, hour: 17, requires: ['m7'],\\n    faction: null,\\n    setup: {\\n      x: 0, z: 70, hour: 17, tablets: 1, syrettes: 2, stones: 60,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'tractor', cond: 70 }],\\n      buddies: ['ines'], flags: ['m7'], scars: ['A', 'B', 'C'], truce: false,\\n      safehouses: ['pump-shed', 'ranger-post'],\\n140→    },\\n    steps: [\\n      { do: 'lines', ids: ['odile:m8.1'], text: 'HOLD THE PLATFORM' },\\n      { do: 'hold', x: 0, z: 70, r: 24, time: 120, text: 'HOLD WHILE THEY BOARD' },\\n      { do: 'ride', time: 60, text: 'RIDE THE FLATCAR' },\\n    ],\\n    onDone: [{ flag: 'm8' }, { column: true }, { pay: 8 }],\\n  },\\n  {\\n    id: 'm9', title: 'THE SURVEYOR', giver: 'harrow', pay: 0, hour: 23, requires: ['m8'],\\n150→    faction: null,\\n    weather: 'storm',\\n    setup: {\\n      x: -80, z: -420, hour: 23, tablets: 1, syrettes: 2, stones: 68,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'm38', cond: 80 }],\\n      buddies: ['ines'], flags: ['m8'], scars: ['A', 'B', 'C'], column: true, truce: false,\\n      safehouses: ['pump-shed', 'ranger-post'],\\n    },\\n    steps: [\\n      { do: 'goto', site: 'observatory', r: 24, text: 'CLIMB TO THE OBSERVATORY' },\\n160→      { do: 'lines', ids: ['harrow:m9.1', 'harrow:m9.5', 'harrow:m9.6', 'harrow:m9.8'], text: 'SIT WITH HARROW' },\\n      { do: 'choice', id: 'shoot', options: ['SHOOT HIM', 'LEAVE HIM'], text: 'YOUR CONTRACT' },\\n      { do: 'choice', id: 'sheet', options: ['WALK OUT', 'GIVE IT TO THEM'], text: 'WHO GETS THE SHEET' },\\n    ],\\n    onDone: [{ flag: 'm9' }],\\n  },\\n  {\\n    id: 'end', title: 'THE PASS', giver: 'harrow', pay: 0, hour: 5.5, requires: ['m9'],\\n    faction: null,\\n    setup: {\\n170→      x: -420, z: -360, hour: 5.5, tablets: 0, syrettes: 1, stones: 68,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'flare', cond: 70 }],\\n      buddies: ['ines'], flags: ['m9'], scars: ['A', 'B', 'C'], column: true, truce: false,\\n      safehouses: ['pump-shed', 'ranger-post'], sheet: 'give',\\n    },\\n    steps: [\\n      { do: 'goto', site: 'the-pass', r: 30, text: 'REACH THE PASS' },\\n      { do: 'burn', x: -560, z: -420, r: 12, text: 'LIGHT THE LAST GRASS' },\\n    ],\\n    onDone: [{ flag: 'end' }, { ending: true }],\\n180→  },\\n];\\n\\nexport function missionById(id) {\\n  return MISSIONS.find((m) => m.id === id) || null;\\n}\",\"content_concise\":\"1→/** Story missions. A bot can start any one from its setup and finish it with actions. */\\nexport const MISSIONS = [\\n  {\\n    id: 'm0', title: 'THE GOODS LINE', giver: 'bakr', pay: 0, hour: 18.5,\\n    faction: null,\\n    setup: { x: -520, z: 108, hour: 18.5, tablets: 0, syrettes: 0, guns: [], buddies: [], stones: 0, feverIn: 0 },\\n    steps: [\\n      { do: 'lines', ids: ['bakr:m0.1', 'bakr:m0.2', 'bakr:m0.3', 'bakr:m0.6'], text: 'RIDE WITH BAKR' },\\n      { do: 'map', text: 'RAISE THE MAP' },\\n10→      { do: 'fever-fall', text: 'THE FEVER' },\\n    ],\\n    onDone: [{ flag: 'm0' }],\\n  },\\n  {\\n    id: 'm1', title: 'MERCY RUN', giver: 'odile', pay: 5, hour: 8, requires: ['m0'],\\n    faction: null,\\n    setup: {\\n      x: 12, z: 55, hour: 8, tablets: 1, syrettes: 2, stones: 0,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'm38', cond: 100 }, { id: 'tractor', cond: 45 }],\\n20→      buddies: [], flags: ['m0'], truck: true,\\n    },\\n    steps: [\\n      { do: 'tablet', text: 'TAKE A TABLET' },\\n      { do: 'drive', x: -260, z: 240, r: 28, text: 'DRIVE MEDICINE TO THREE WELLS' },\\n      { do: 'goto', x: -200, z: 30, r: 20, text: 'THE WEST ROAD IS MANNED' },\\n      { do: 'jam', text: 'CLEAR THE JAM' },\\n      { do: 'repair', text: 'REPAIR THE TRUCK' },\\n      { do: 'syrette', text: 'USE A SYRETTE' },\\n      { do: 'report', to: 'clinic', text: 'REPORT TO ODILE' },\\n30→    ],\\n    onDone: [{ flag: 'm1' }, { safehouse: 'pump-shed' }, { tablets: 3 }, { pay: 5 }],\\n  },\\n  {\\n    id: 'm2', title: 'A CAGE AT THE POST', giver: 'tibor', pay: 8, hour: 21, requires: ['m1'],\\n    faction: null,\\n    setup: {\\n      x: -18, z: 62, hour: 21, tablets: 3, syrettes: 3, stones: 5,\\n      guns: [{ id: 'cane', cond: 100 }, { id: 'm38', cond: 100 }, { id: 'tractor', cond: 70 }],\\n      buddies: [], flags