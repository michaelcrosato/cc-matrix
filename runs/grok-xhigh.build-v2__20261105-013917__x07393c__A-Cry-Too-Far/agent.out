uArm > 0);\\n    if (armed && pressed(input, ['Enter', 'Space', 'PadCross'])) this.activate(items[this.focus]);\\n    if (armed && pressed(input, ['Escape', 'PadCircle']) && this.screen !== 'title' && this.screen !== 'menu') this.back();\\n    this.hover(ctx, items, armed);\\n  }\\n\\n  menuWindow(items) {\\n    const top = Math.max(0, this.focus - 6);\\n    const count = Math.min(9, Math.max(0, (items?.length || 0) - top));\\n    return { top, count };\\n  }\\n\\n  hover(ctx, items, armed = true) {\\n    const input = ctx.input;\\n    const width = ctx.hud?.width || 480;\\n    const height = ctx.hud?.height || 270;\\n    const px = (input.pointer.x + 1) / 2 * width;\\n    const py = (1 - input.pointer.y) / 2 * height;\\n    const { top, count } = this.menuWindow(items);\\n    for (let i = 0; i < count; i++) {\\n      const y = 86 + i * 16;\\n      if (px > 36 && px < width - 36 && py > y - 2 && py < y + 14) this.focus = top + i;\\n    }\\n    if (!armed) return;\\n    for (const ev of input.buttonEvents) {\\n      if (!ev.down) continue;\\n      if (ev.code === 'MouseLeft' || ev.code === 'Touch') this.activate(items[this.focus]);\\n    }\\n  }\\n\\n  state() {\\n    const w = this.world;\\n    const p = w ? w.feet() : { x: 0, y: 0, z: 0 };\\n    const gun = w?.weapon;\\n    const rows = [];\\n    if (this.notice) rows.push({ action: 'confirm', text: 'SETTINGS' });\\n    if (w?.prompt) rows.push({ action: 'use', text: w.prompt });\\n    if (this.mode === 'play' || this.mode === 'round') rows.push({ action: 'fire', text: 'FIRE' }, { action: 'map', text: 'MAP' });\\n    const prompts = promptList(this.device, this.glyphSet, rows);\\n    return {\\n      title: GAME_TITLE,\\n      mode: this.mode,\\n      screen: this.screen,\\n      focus: this.focus,\\n      device: this.device,\\n      glyphSet: this.glyphSet,\\n      notice: this.touchGate ? 'Controller or keyboard required' : '',\\n      attract: this.attract,\\n      mission: w?.mission?.def?.id || null,\\n      step: w?.currentStep()?.do || null,\\n      hp: w ? Math.round(w.hp) : 0,\\n      stones: w?.stones || 0,\\n      tablets: w?.tablets || 0,\\n      syrettes: w?.syrettes || 0,\\n      weapon: gun ? { id: gun.id, cond: gun.cond, jammed: gun.jammed, mag: gun.mag } : null,\\n      fever: !!w?.feverOn,\\n      pos: { x: p.x, y: p.y, z: p.z },\\n      yaw: this.ctx?.camera?.yaw || 0,\\n      vehicle: w?.inVehicle ? w.vehicleKind : null,\\n      hour: w?.hour || 0,\\n      wind: { dir: w?.windDir || 0, speed: w?.windSpeed || 0 },\\n      fire: { burning: w?.fire?.burning.length || 0, burnt: w?.fire?.burntCount || 0 },\\n      prompts,\\n      subtitle: w?.subtitle || '',\\n      buddies: (w?.buddies || []).map((b) => ({ id: b.id, alive: b.alive, down: b.down, hp: b.hp })),\\n      ledger: w ? { ...w.ledger, hectares: w.hectares() } : null,\\n      menu: this.items().map((item) => item.label),\\n      ending: this.ending,\\n      link: true,\\n      saves: this.saves,\\n    };\\n  }\\n\\n  fingerprint() {\\n    const w = this.world;\\n    if (!w) return '0';\\n    const p = w.feet();\\n    return [Math.round(w.hp), w.stones, w.mission?.index || 0, Math.round(p.x), Math.round(p.z), w.fire.burntCount].join(':');\\n  }\\n\\n  draw(ctx) {\\n    const hud = ctx.hud;\\n    if (!hud) return;\\n    hud.clear();\\n    const ink = 'ink';\\n    if (this.mode === 'card') {\\n      hud.text(16, 24, GAME_TITLE, { scale: 3, color: 'sand' });\\n      hud.text(16, 70, 'CARRY THE MOST DIAMOND CASES OUT', { color: 'sand' });\\n      const players = this.session?.players || [];\\n      players.forEach((pl, i) => {\\n        const ready = this.card?.ready?.includes?.(pl.id) ? 'READY' : 'WAIT';\\n        hud.text(16, 100 + i * 14, (pl.name || 'PLAYER') + ' ' + ready, { color: 'white' });\\n      });\\n      const left = this.card?.left;\\n      hud.text(16, 220, left == null ? 'STARTING' : 'CARD ' + Math.ceil(left / 1000), { color: 'sand' });\\n      hud.text(16, 240, 'ENTER READY  M MORE TIME', { color: 'white' });\\n      return;\\n    }\\n    if (this.attract) hud.text(8, 8, 'DEMO', { color: 'orange', anchor: 'top-right' });\\n    if (this.touchGate && (this.screen === 'title' || this.screen === 'menu' || this.attract)) {\\n      hud.text(0, 70, 'CONTROLLER OR KEYBOARD REQUIRED', { anchor: 'top', color: 'white', scale: 2 });\\n    }\\n    if (this.screen === 'title' || this.screen === 'menu' || this.screen === 'pause' || this.screen === 'cash' || this.screen === 'settings' || this.screen === 'about' || this.screen === 'dev' || this.screen === 'ledger' || this.screen === 'ending' || this.screen === 'gameover') {\\n      if (this.screen === 'title' || this.screen === 'menu') hud.text(16, 28, GAME_TITLE, { scale: 3, color: 'sand' });\\n      else hud.text(16, 16, this.screen === 'about' ? 'ABOUT AND CREDITS' : this.screen.toUpperCase(), { scale: 2, color: 'sand' });\\n      if (this.screen === 'about') {\\n        const page = aboutPages()[this.page] || [];\\n        page.forEach((line, i) => hud.text(16, 56 + i * 14, line, { color: 'white' }));\\n      }\\n      if (this.screen === 'ledger' && this.world) {\\n        const L = this.world.ledger;\\n        const lines = [\\n          'HECTARES ' + this.world.hectares().toFixed(2),\\n          'PEOPLE MOVED ' + L.moved,\\n          'MEN PAID TO KILL ' + L.killed,\\n          'FRIENDS LOST ' + L.friends,\\n          'STONES EARNED ' + L.stonesEarned,\\n        ];\\n        lines.forEach((line, i) => hud.text(16, 56 + i * 16, line, { color: 'white' }));\\n      }\\n      if (this.screen === 'ending') {\\n        const lines = this.ending === 'walk'\\n          ? ['YOU REACHED THE BORDER WITH THE SHEET.', 'THE GUARD ASKS YOUR TRADE.', 'YOU TELL HIM: SURVEYOR.']\\n          : ['THEY CROSSED AT FIRST LIGHT ON ASH.', 'NOBODY HAS ASKED WHO LIT IT.', 'YOU ARE OUT OF TABLETS. GOOD VIEW.'];\\n        lines.forEach((line, i) => hud.text(16, 56 + i * 16, line, { color: 'white' }));\\n      }\\n      const items = this.items();\\n      this.rows = items;\\n      const { top, count } = this.menuWindow(items);\\n      for (let i = 0; i < count; i++) {\\n        const index = top + i;\\n        const item = items[index];\\n        const mark = index === this.focus ? '> ' : '  ';\\n        hud.text(24, 86 + i * 16, mark + item.label, { color: index === this.focus ? 'orange' : 'white' });\\n      }\\n      if (this.screen === 'title') {\\n        const g = promptList(this.device, this.glyphSet, [{ action: 'confirm', text: 'START' }])[0];\\n        hud.text(16, 230, 'PRESS ' + g.glyph, { color: 'sand' });\\n      }\\n      return;\\n    }\\n    if (!this.world) return;\\n    const w = this.world;\\n    hud.text(8, 8, 'HP ' + Math.round(w.hp), { color: 'white' });\\n    hud.text(8, 20, 'STONES ' + w.stones, { color: 'sand' });\\n    if (w.weapon) hud.text(8, 32, w.weapon.name + ' ' + Math.round(w.weapon.cond) + (w.weapon.jammed ? ' JAM' : ''), { color: 'white' });\\n    if (w.feverOn) hud.text(8, 44, 'FEVER', { color: 'red' });\\n    if (w.prompt) hud.text(0, 230, w.prompt, { anchor: 'bottom', color: 'sand' });\\n    if (w.subtitle) hud.text(16, 200, w.subtitle.slice(0, 52), { color: 'white' });\\n    if (w.subtitle && w.subtitle !== this.said) {\\n      this.said = w.subtitle;\\n      const who = (w.speaker || 'soldier').toLowerCase().split(' ')[0];\\n      say(ctx.audio, who, w.subtitle, this.volumes.voice);\\n    }\\n    const g = promptList(this.device, this.glyphSet, [{ action: 'use', text: 'USE' }])[0];\\n    hud.text(8, 250, g.glyph + ' USE', { color: 'white' });\\n  }\\n\\n  dispose() {\\n    if (this.netTimer) clearInterval(this.netTimer);\\n    this.netTimer = null;\\n  }\\n}\\n\",\"total_lines\":781}}","is_error":false},{"type":"tool_result","tool_use_id":"call-75852fd8-e59c-4128-8d14-89a9373e8e45-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n130→  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n140→  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n150→  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n160→  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n170→  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n180→      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n190→    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n200→  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\",\"content_concise\":\"90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n130→  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n140→  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n150→  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n160→  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n170→  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n180→      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n190→    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n200→  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"offset\":90,\"limit\":120,\"raw_output\":\"    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n\",\"total_lines\":775}}","is_error":false},{"type":"tool_result","tool_use_id":"call-75852fd8-e59c-4128-8d14-89a9373e8e45-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"450→  holdFire(40);\\n  const jammed = w.guns.find((g) => g.id === 'tractor');\\n  assert(jammed.jammed, 'did not jam');\\n  const shots = jammed.shots;\\n  holdFire(20);\\n  assert(jammed.shots === shots, 'jammed gun fired');\\n  for (let n = 0; n < 5 && jammed.jammed; n++) tap('KeyR');\\n  assert(!jammed.jammed, 'reload did not clear jam');\\n  const civil = w.actors.find((a) => a.kind === 'civil');\\n  const hp = civil.hp;\\n460→  placeFacing(civil.x, civil.z);\\n  arm('tractor');\\n  holdFire(20);\\n  assert(civil.alive && civil.hp === hp && civil.fleeing, 'civilian was killed');\\n  w.tablets = 1;\\n  w.stones = 50;\\n  w.feverT = 0.05;\\n  w.feverOn = false;\\n  engine.step(5, DT);\\n  assert(w.feverOn, 'fever did not start');\\n470→  holdKey('KeyH', 80);\\n  assert(!w.feverOn || w.feverClear > 0, 'tablet did not clear fever');\\n  w.feverOn = true;\\n  w.feverClear = 0;\\n  w.feverIgnore = 0;\\n  w.tablets = 0;\\n  w.stones = 50;\\n  engine.step(26 * 60, DT);\\n  assert(w.stones <= 40.01, 'ignore did not cost stones ' + w.stones);\\n  w.hp = 15;\\n480→  tap('KeyQ');\\n  assert(w.surgeryT > 0, 'no surgery');\\n  engine.step(5 * 60, DT);\\n  assert(w.hp >= 40, 'surgery hp ' + w.hp);\\n  w.startMission('m3');\\n  w.lines = [];\\n  w.hp = 1;\\n  w.hurt(50, 'bullet', true);\\n  assert(w.rescueT > 0, 'no rescue');\\n  engine.step(4 * 60, DT);\\n490→  assert(w.hp >= 40 && w.rescueT <= 0, 'rescue failed ' + w.hp + ' t ' + w.rescueT);\\n  w.deadBuddies.clear();\\n  assert(w.startMission('m6'), 'm6 missing');\\n  assert(w.currentStep().do === 'lines', 'm6 did not open on its line');\\n  tap('Enter');\\n  assert(w.currentStep()?.do === 'goto', 'm6 line did not advance ' + w.currentStep()?.do);\\n  const field = siteById('long-field');\\n  w.teleport(field.x, field.z);\\n  engine.step(2, DT);\\n  assert(w.currentStep()?.do === 'burn', 'm6 goto did not finish ' + w.currentStep()?.do);\\n500→  lightCurrentBurn();\\n  assert(w.currentStep()?.do === 'buddy-down', 'm6 burn did not reach the down ' + w.currentStep()?.do);\\n  const down = w.buddies.find((b) => b.alive && b.down);\\n  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\\n  assert(down.view && down.view.parent === game.ctx.scene, 'downed buddy has no rig');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'SYRETTE OR FINISH IT', 'campaign prompt ' + w.prompt);\\n  assert(w.syrettes > 0, 'campaign down had no syrette');\\n  const sid = down.id;\\n  const syretteBefore = w.syrettes;\\n510→  tap('KeyE');\\n  const up = w.buddies.find((b) => b.id === sid);\\n  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\\n  assert(w.syrettes === 0, 'a syrette was left after the campaign down');\\n  w.knockBuddy();\\n  const down2 = w.buddies.find((b) => b.alive && b.down);\\n  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'empty syrette prompt ' + w.prompt);\\n  const fid = down2.id;\\n520→  tap('KeyE');\\n  assert(w.deadBuddies.has(fid) && w.syrettes === 0, 'finish-it did not record the death');\\n  const live = w.buddies.find((b) => b.alive && !b.down);\\n  w.syrettes = 1;\\n  w.downBuddy(live.id, { burning: true });\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'a burning down still offered a syrette');\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(live.id) && w.syrettes === 1, 'a burning down used the syrette');\\n});\\n530→\\ntest('map while driving and sliders', async () => {\\n  await boot();\\n  const w = game.world;\\n  w.startMission('m1');\\n  engine.step(2, DT);\\n  assert(!w.inVehicle, 'map walk started in the truck');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(w.map.up && w.map.anim > 0.9, 'map did not rise on foot ' + w.map.anim);\\n540→  assertHeldMap(w, 'walking');\\n  w.teleport(80, 120);\\n  engine.step(2, DT);\\n  const zFoot = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyW', false);\\n  assert(Math.abs(w.feet().z - zFoot) > 0.2, 'world paused while walking with the map');\\n  assertHeldMap(w, 'walking');\\n  tap('KeyM');\\n550→  engine.step(30, DT);\\n  assert(!w.map.up && w.map.anim < 0.02, 'map stayed up');\\n  w.teleport(16, 55);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n  assert(w.inVehicle, 'did not enter');\\n  const z0 = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.input.setKey('KeyM', true);\\n  engine.step(20, DT);\\n560→  engine.input.setKey('KeyM', false);\\n  engine.input.setKey('KeyW', false);\\n  assert(w.map.up && w.inVehicle, 'map not held while driving');\\n  assertHeldMap(w, 'driving');\\n  assert(w.feet().z !== z0, 'world paused on the map');\\n  const cx = w.map.cx;\\n  engine.input.setPointer(0, 0, false);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0.02, -0.01, false);\\n  engine.step(2, DT);\\n570→  assert(w.map.cx !== cx, 'cursor did not move');\\n  tap('KeyE');\\n  assert(w.waypoint, 'no waypoint');\\n  w.spawnSoldier({ x: 20, z: 20, faction: 'concord' });\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  const maxBefore = soldier.max;\\n  game.applySlider('enemyHealth', 2);\\n  assert(TUNING.enemyHealth === 2 && soldier.max === maxBefore * 2, 'enemy health slider');\\n  game.applySlider('vehicleTopSpeed', 40);\\n  assert(w.car.o.topSpeed === 40, 'top speed slider');\\n580→  game.applySlider('playerSpeed', 2);\\n  assert(TUNING.playerSpeed === 2, 'player speed');\\n  for (const key of SLIDER_KEYS) {\\n    const [a, b] = TUNING_RANGES[key];\\n    game.applySlider(key, a);\\n    assert(TUNING[key] === a, key + ' low');\\n    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n  game.resetSliders();\\n590→  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\\n\\n600→test('story both endings', async () => {\\n  await boot();\\n  game.world.deadBuddies.clear();\\n  const chain = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5'];\\n  for (const id of chain) playMission(id);\\n  const burntBefore = game.world.fire.burntCount;\\n  playMission('m6', { dead: ['dov'] });\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy was not kept');\\n  assert(game.world.fire.burntCount > burntBefore, 'story scar missing');\\n  playMission('m7');\\n610→  playMission('m8');\\n  playMission('m9', { picks: [0, 0] });\\n  assert(game.world.ledger.killed >= 1, 'shoot choice did not pay a kill');\\n  assert(game.world.sheet === 'walk', 'walk sheet ' + game.world.sheet);\\n  playMission('end', { sheet: 'walk' });\\n  assert(game.ending === 'walk', 'walk card ' + game.ending);\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy lost before the ending');\\n  playMission('end', { sheet: 'give', dead: ['ines'] });\\n  assert(game.ending === 'give', 'give card');\\n  assert(game.world.deadBuddies.has('ines'), 'second ending had no dead buddy');\\n620→  assert(game.world.ledger.moved > 0, 'nobody moved');\\n  assert(game.world.ledger.stonesEarned > 0, 'no stones');\\n  assert(game.world.ledger.friends >= 1, 'no friends lost');\\n});\\n\\ntest('solo round', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.startSolo();\\n  const round = game.world.round;\\n630→  const seat = round.seat(0);\\n  const merc = round.seats.find((s) => s.ai);\\n  const startHp = merc.hp;\\n  arm('tractor');\\n  for (let n = 0; n < 10 && !merc.down; n++) {\\n    const foe = game.world.actors.find((a) => a.seat === merc.id);\\n    if (!foe) break;\\n    placeFacing(foe.x, foe.z);\\n    holdFire(10);\\n  }\\n640→  assert(merc.hp < startHp, 'friendly fire did nothing ' + merc.hp);\\n  assert(merc.down, 'merc did not drop ' + merc.hp);\\n  game.world.teleport(merc.x, merc.z + 1);\\n  engine.step(1, DT);\\n  holdKey('KeyE', 200);\\n  assert(!merc.down && merc.hp > 0, 'revive failed');\\n  const box = round.cases.find((c) => !c.taken && !c.carrier);\\n  game.world.teleport(box.x, box.z);\\n  engine.step(1, DT);\\n  tap('KeyE');\",\"content_concise\":\"450→  holdFire(40);\\n  const jammed = w.guns.find((g) => g.id === 'tractor');\\n  assert(jammed.jammed, 'did not jam');\\n  const shots = jammed.shots;\\n  holdFire(20);\\n  assert(jammed.shots === shots, 'jammed gun fired');\\n  for (let n = 0; n < 5 && jammed.jammed; n++) tap('KeyR');\\n  assert(!jammed.jammed, 'reload did not clear jam');\\n  const civil = w.actors.find((a) => a.kind === 'civil');\\n  const hp = civil.hp;\\n460→  placeFacing(civil.x, civil.z);\\n  arm('tractor');\\n  holdFire(20);\\n  assert(civil.alive && civil.hp === hp && civil.fleeing, 'civilian was killed');\\n  w.tablets = 1;\\n  w.stones = 50;\\n  w.feverT = 0.05;\\n  w.feverOn = false;\\n  engine.step(5, DT);\\n  assert(w.feverOn, 'fever did not start');\\n470→  holdKey('KeyH', 80);\\n  assert(!w.feverOn || w.feverClear > 0, 'tablet did not clear fever');\\n  w.feverOn = true;\\n  w.feverClear = 0;\\n  w.feverIgnore = 0;\\n  w.tablets = 0;\\n  w.stones = 50;\\n  engine.step(26 * 60, DT);\\n  assert(w.stones <= 40.01, 'ignore did not cost stones ' + w.stones);\\n  w.hp = 15;\\n480→  tap('KeyQ');\\n  assert(w.surgeryT > 0, 'no surgery');\\n  engine.step(5 * 60, DT);\\n  assert(w.hp >= 40, 'surgery hp ' + w.hp);\\n  w.startMission('m3');\\n  w.lines = [];\\n  w.hp = 1;\\n  w.hurt(50, 'bullet', true);\\n  assert(w.rescueT > 0, 'no rescue');\\n  engine.step(4 * 60, DT);\\n490→  assert(w.hp >= 40 && w.rescueT <= 0, 'rescue failed ' + w.hp + ' t ' + w.rescueT);\\n  w.deadBuddies.clear();\\n  assert(w.startMission('m6'), 'm6 missing');\\n  assert(w.currentStep().do === 'lines', 'm6 did not open on its line');\\n  tap('Enter');\\n  assert(w.currentStep()?.do === 'goto', 'm6 line did not advance ' + w.currentStep()?.do);\\n  const field = siteById('long-field');\\n  w.teleport(field.x, field.z);\\n  engine.step(2, DT);\\n  assert(w.currentStep()?.do === 'burn', 'm6 goto did not finish ' + w.currentStep()?.do);\\n500→  lightCurrentBurn();\\n  assert(w.currentStep()?.do === 'buddy-down', 'm6 burn did not reach the down ' + w.currentStep()?.do);\\n  const down = w.buddies.find((b) => b.alive && b.down);\\n  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\\n  assert(down.view && down.view.parent === game.ctx.scene, 'downed buddy has no rig');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'SYRETTE OR FINISH IT', 'campaign prompt ' + w.prompt);\\n  assert(w.syrettes > 0, 'campaign down had no syrette');\\n  const sid = down.id;\\n  const syretteBefore = w.syrettes;\\n510→  tap('KeyE');\\n  const up = w.buddies.find((b) => b.id === sid);\\n  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\\n  assert(w.syrettes === 0, 'a syrette was left after the campaign down');\\n  w.knockBuddy();\\n  const down2 = w.buddies.find((b) => b.alive && b.down);\\n  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'empty syrette prompt ' + w.prompt);\\n  const fid = down2.id;\\n520→  tap('KeyE');\\n  assert(w.deadBuddies.has(fid) && w.syrettes === 0, 'finish-it did not record the death');\\n  const live = w.buddies.find((b) => b.alive && !b.down);\\n  w.syrettes = 1;\\n  w.downBuddy(live.id, { burning: true });\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'a burning down still offered a syrette');\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(live.id) && w.syrettes === 1, 'a burning down used the syrette');\\n});\\n530→\\ntest('map while driving and sliders', async () => {\\n  await boot();\\n  const w = game.world;\\n  w.startMission('m1');\\n  engine.step(2, DT);\\n  assert(!w.inVehicle, 'map walk started in the truck');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(w.map.up && w.map.anim > 0.9, 'map did not rise on foot ' + w.map.anim);\\n540→  assertHeldMap(w, 'walking');\\n  w.teleport(80, 120);\\n  engine.step(2, DT);\\n  const zFoot = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyW', false);\\n  assert(Math.abs(w.feet().z - zFoot) > 0.2, 'world paused while walking with the map');\\n  assertHeldMap(w, 'walking');\\n  tap('KeyM');\\n550→  engine.step(30, DT);\\n  assert(!w.map.up && w.map.anim < 0.02, 'map stayed up');\\n  w.teleport(16, 55);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n  assert(w.inVehicle, 'did not enter');\\n  const z0 = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.input.setKey('KeyM', true);\\n  engine.step(20, DT);\\n560→  engine.input.setKey('KeyM', false);\\n  engine.input.setKey('KeyW', false);\\n  assert(w.map.up && w.inVehicle, 'map not held while driving');\\n  assertHeldMap(w, 'driving');\\n  assert(w.feet().z !== z0, 'world paused on the map');\\n  const cx = w.map.cx;\\n  engine.input.setPointer(0, 0, false);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0.02, -0.01, false);\\n  engine.step(2, DT);\\n570→  assert(w.map.cx !== cx, 'cursor did not move');\\n  tap('KeyE');\\n  assert(w.waypoint, 'no waypoint');\\n  w.spawnSoldier({ x: 20, z: 20, faction: 'concord' });\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  const maxBefore = soldier.max;\\n  game.applySlider('enemyHealth', 2);\\n  assert(TUNING.enemyHealth === 2 && soldier.max === maxBefore * 2, 'enemy health slider');\\n  game.applySlider('vehicleTopSpeed', 40);\\n  assert(w.car.o.topSpeed === 40, 'top speed slider');\\n580→  game.applySlider('playerSpeed', 2);\\n  assert(TUNING.playerSpeed === 2, 'player speed');\\n  for (const key of SLIDER_KEYS) {\\n    const [a, b] = TUNING_RANGES[key];\\n    game.applySlider(key, a);\\n    assert(TUNING[key] === a, key + ' low');\\n    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n  game.resetSliders();\\n590→  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\\n\\n600→test('story both endings', async () => {\\n  await boot();\\n  game.world.deadBuddies.clear();\\n  const chain = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5'];\\n  for (const id of chain) playMission(id);\\n  const burntBefore = game.world.fire.burntCount;\\n  playMission('m6', { dead: ['dov'] });\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy was not kept');\\n  assert(game.world.fire.burntCount > burntBefore, 'story scar missing');\\n  playMission('m7');\\n610→  playMission('m8');\\n  playMission('m9', { picks: [0, 0] });\\n  assert(game.world.ledger.killed >= 1, 'shoot choice did not pay a kill');\\n  assert(game.world.sheet === 'walk', 'walk sheet ' + game.world.sheet);\\n  playMission('end', { sheet: 'walk' });\\n  assert(game.ending === 'walk', 'walk card ' + game.ending);\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy lost before the ending');\\n  playMission('end', { sheet: 'give', dead: ['ines'] });\\n  assert(game.ending === 'give', 'give card');\\n  assert(game.world.deadBuddies.has('ines'), 'second ending had no dead buddy');\\n620→  assert(game.world.ledger.moved > 0, 'nobody moved');\\n  assert(game.world.ledger.stonesEarned > 0, 'no stones');\\n  assert(game.world.ledger.friends >= 1, 'no friends lost');\\n});\\n\\ntest('solo round', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.startSolo();\\n  const round = game.world.round;\\n630→  const seat = round.seat(0);\\n  const merc = round.seats.find((s) => s.ai);\\n  const startHp = merc.hp;\\n  arm('tractor');\\n  for (let n = 0; n < 10 && !merc.down; n++) {\\n    const foe = game.world.actors.find((a) => a.seat === merc.id);\\n    if (!foe) break;\\n    placeFacing(foe.x, foe.z);\\n    holdFire(10);\\n  }\\n640→  assert(merc.hp < startHp, 'friendly fire did nothing ' + merc.hp);\\n  assert(merc.down, 'merc did not drop ' + merc.hp);\\n  game.world.teleport(merc.x, merc.z + 1);\\n  engine.step(1, DT);\\n  holdKey('KeyE', 200);\\n  assert(!merc.down && merc.hp > 0, 'revive failed');\\n  const box = round.cases.find((c) => !c.taken && !c.carrier);\\n  game.world.teleport(box.x, box.z);\\n  engine.step(1, DT);\\n  tap('KeyE');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"offset\":450,\"limit\":200,\"raw_output\":\"  holdFire(40);\\n  const jammed = w.guns.find((g) => g.id === 'tractor');\\n  assert(jammed.jammed, 'did not jam');\\n  const shots = jammed.shots;\\n  holdFire(20);\\n  assert(jammed.shots === shots, 'jammed gun fired');\\n  for (let n = 0; n < 5 && jammed.jammed; n++) tap('KeyR');\\n  assert(!jammed.jammed, 'reload did not clear jam');\\n  const civil = w.actors.find((a) => a.kind === 'civil');\\n  const hp = civil.hp;\\n  placeFacing(civil.x, civil.z);\\n  arm('tractor');\\n  holdFire(20);\\n  assert(civil.alive && civil.hp === hp && civil.fleeing, 'civilian was killed');\\n  w.tablets = 1;\\n  w.stones = 50;\\n  w.feverT = 0.05;\\n  w.feverOn = false;\\n  engine.step(5, DT);\\n  assert(w.feverOn, 'fever did not start');\\n  holdKey('KeyH', 80);\\n  assert(!w.feverOn || w.feverClear > 0, 'tablet did not clear fever');\\n  w.feverOn = true;\\n  w.feverClear = 0;\\n  w.feverIgnore = 0;\\n  w.tablets = 0;\\n  w.stones = 50;\\n  engine.step(26 * 60, DT);\\n  assert(w.stones <= 40.01, 'ignore did not cost stones ' + w.stones);\\n  w.hp = 15;\\n  tap('KeyQ');\\n  assert(w.surgeryT > 0, 'no surgery');\\n  engine.step(5 * 60, DT);\\n  assert(w.hp >= 40, 'surgery hp ' + w.hp);\\n  w.startMission('m3');\\n  w.lines = [];\\n  w.hp = 1;\\n  w.hurt(50, 'bullet', true);\\n  assert(w.rescueT > 0, 'no rescue');\\n  engine.step(4 * 60, DT);\\n  assert(w.hp >= 40 && w.rescueT <= 0, 'rescue failed ' + w.hp + ' t ' + w.rescueT);\\n  w.deadBuddies.clear();\\n  assert(w.startMission('m6'), 'm6 missing');\\n  assert(w.currentStep().do === 'lines', 'm6 did not open on its line');\\n  tap('Enter');\\n  assert(w.currentStep()?.do === 'goto', 'm6 line did not advance ' + w.currentStep()?.do);\\n  const field = siteById('long-field');\\n  w.teleport(field.x, field.z);\\n  engine.step(2, DT);\\n  assert(w.currentStep()?.do === 'burn', 'm6 goto did not finish ' + w.currentStep()?.do);\\n  lightCurrentBurn();\\n  assert(w.currentStep()?.do === 'buddy-down', 'm6 burn did not reach the down ' + w.currentStep()?.do);\\n  const down = w.buddies.find((b) => b.alive && b.down);\\n  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\\n  assert(down.view && down.view.parent === game.ctx.scene, 'downed buddy has no rig');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'SYRETTE OR FINISH IT', 'campaign prompt ' + w.prompt);\\n  assert(w.syrettes > 0, 'campaign down had no syrette');\\n  const sid = down.id;\\n  const syretteBefore = w.syrettes;\\n  tap('KeyE');\\n  const up = w.buddies.find((b) => b.id === sid);\\n  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\\n  assert(w.syrettes === 0, 'a syrette was left after the campaign down');\\n  w.knockBuddy();\\n  const down2 = w.buddies.find((b) => b.alive && b.down);\\n  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'empty syrette prompt ' + w.prompt);\\n  const fid = down2.id;\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(fid) && w.syrettes === 0, 'finish-it did not record the death');\\n  const live = w.buddies.find((b) => b.alive && !b.down);\\n  w.syrettes = 1;\\n  w.downBuddy(live.id, { burning: true });\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'a burning down still offered a syrette');\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(live.id) && w.syrettes === 1, 'a burning down used the syrette');\\n});\\n\\ntest('map while driving and sliders', async () => {\\n  await boot();\\n  const w = game.world;\\n  w.startMission('m1');\\n  engine.step(2, DT);\\n  assert(!w.inVehicle, 'map walk started in the truck');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(w.map.up && w.map.anim > 0.9, 'map did not rise on foot ' + w.map.anim);\\n  assertHeldMap(w, 'walking');\\n  w.teleport(80, 120);\\n  engine.step(2, DT);\\n  const zFoot = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyW', false);\\n  assert(Math.abs(w.feet().z - zFoot) > 0.2, 'world paused while walking with the map');\\n  assertHeldMap(w, 'walking');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(!w.map.up && w.map.anim < 0.02, 'map stayed up');\\n  w.teleport(16, 55);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n  assert(w.inVehicle, 'did not enter');\\n  const z0 = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.input.setKey('KeyM', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyM', false);\\n  engine.input.setKey('KeyW', false);\\n  assert(w.map.up && w.inVehicle, 'map not held while driving');\\n  assertHeldMap(w, 'driving');\\n  assert(w.feet().z !== z0, 'world paused on the map');\\n  const cx = w.map.cx;\\n  engine.input.setPointer(0, 0, false);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0.02, -0.01, false);\\n  engine.step(2, DT);\\n  assert(w.map.cx !== cx, 'cursor did not move');\\n  tap('KeyE');\\n  assert(w.waypoint, 'no waypoint');\\n  w.spawnSoldier({ x: 20, z: 20, faction: 'concord' });\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  const maxBefore = soldier.max;\\n  game.applySlider('enemyHealth', 2);\\n  assert(TUNING.enemyHealth === 2 && soldier.max === maxBefore * 2, 'enemy health slider');\\n  game.applySlider('vehicleTopSpeed', 40);\\n  assert(w.car.o.topSpeed === 40, 'top speed slider');\\n  game.applySlider('playerSpeed', 2);\\n  assert(TUNING.playerSpeed === 2, 'player speed');\\n  for (const key of SLIDER_KEYS) {\\n    const [a, b] = TUNING_RANGES[key];\\n    game.applySlider(key, a);\\n    assert(TUNING[key] === a, key + ' low');\\n    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n  game.resetSliders();\\n  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\\n\\ntest('story both endings', async () => {\\n  await boot();\\n  game.world.deadBuddies.clear();\\n  const chain = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5'];\\n  for (const id of chain) playMission(id);\\n  const burntBefore = game.world.fire.burntCount;\\n  playMission('m6', { dead: ['dov'] });\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy was not kept');\\n  assert(game.world.fire.burntCount > burntBefore, 'story scar missing');\\n  playMission('m7');\\n  playMission('m8');\\n  playMission('m9', { picks: [0, 0] });\\n  assert(game.world.ledger.killed >= 1, 'shoot choice did not pay a kill');\\n  assert(game.world.sheet === 'walk', 'walk sheet ' + game.world.sheet);\\n  playMission('end', { sheet: 'walk' });\\n  assert(game.ending === 'walk', 'walk card ' + game.ending);\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy lost before the ending');\\n  playMission('end', { sheet: 'give', dead: ['ines'] });\\n  assert(game.ending === 'give', 'give card');\\n  assert(game.world.deadBuddies.has('ines'), 'second ending had no dead buddy');\\n  assert(game.world.ledger.moved > 0, 'nobody moved');\\n  assert(game.world.ledger.stonesEarned > 0, 'no stones');\\n  assert(game.world.ledger.friends >= 1, 'no friends lost');\\n});\\n\\ntest('solo round', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.startSolo();\\n  const round = game.world.round;\\n  const seat = round.seat(0);\\n  const merc = round.seats.find((s) => s.ai);\\n  const startHp = merc.hp;\\n  arm('tractor');\\n  for (let n = 0; n < 10 && !merc.down; n++) {\\n    const foe = game.world.actors.find((a) => a.seat === merc.id);\\n    if (!foe) break;\\n    placeFacing(foe.x, foe.z);\\n    holdFire(10);\\n  }\\n  assert(merc.hp < startHp, 'friendly fire did nothing ' + merc.hp);\\n  assert(merc.down, 'merc did not drop ' + merc.hp);\\n  game.world.teleport(merc.x, merc.z + 1);\\n  engine.step(1, DT);\\n  holdKey('KeyE', 200);\\n  assert(!merc.down && merc.hp > 0, 'revive failed');\\n  const box = round.cases.find((c) => !c.taken && !c.carrier);\\n  game.world.teleport(box.x, box.z);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n\",\"total_lines\":775}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"f3d39e88-de3b-4a2e-baa4-791de477b798"}
{"type":"assistant","message":{"id":"msg_579","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"\n\nI'm examining the map visibility logic. The map only appears when animation exceeds 0.02 and the mode is play, round, or attract. I need to verify whether `toonMaterial` and Several potential issuesTHREE are available in headless tests, since require closer examination. `mountMap` returns early without a camera or existing sheet.\n\nThe GPS mark is painted onto a separate 16x16 texture rather than\n\nThe map implementation mapPx. The map sheet has a bug. `refreshMap` uses DataTexture of mapPx, and the GPS  early-returns when mesh is a child of thethe scarTick hasn't  map rig, so this satisfieschanged, so the base the requirement to draw the map in hands map is only painted from mapPx.\n\n`paintGps` once and never refreshed fills gpsPx with 24 via Uint8Array.fill, during movement. which sets alpha to 24 but remains acceptable for a mark.\n\nThere is also a potential issue where the map stays invisible while `map.anim` is zero, even when the player is walking with the map raised.\n\nI need to verify whether the map can be held while driving. I will read the map toggle code around lines 965-1060.\n\nThe knockBuddy fix now calls downBuddy without the burning flag, so buddies are not set on fire by \n\nGPS is a separate default. This alignssmall texture, not the with the prompt logic: syrettes are offered map cursor. The map when available and the buddy is not burning, sheet's parent-child and finish-it appears only when no syrettes relationship with mapRig remain.\n\nThe knockBuddy fix appears correct for allows finish-it on hand positioning. DataTexture burning buddies even stores its array in when syrettes remain. image.data, so texBytes checks against mapPx The prompt logic in tryUse and handleUse are valid. both trigger finishBuddy when a buddy is burning or syrettes are empty.\n\nThe prior gap required\n\nNeed to verify THREE knockBuddy to assert the down state without is imported in world.js. always setting burning The knockBuddy logic to true. Syrette and defaults burning to finish-it must be available false via !!opts.burning, on that down, with  and tryUse branchesfinish-it restricted on buddy state and  to cases where no syrettessyrette count. remain. The implementation should use knockBuddy directly rather than calling downBuddy with a burning flag.\n\nI need to check the tests and PLAN.md to confirm whether finish-it should only auto-offer when no syrettes remain, or if both actions \n\nThe knockBuddy promptare available via different logic needs clarification. buttons while syrettes The original gap requested are present. syrette or finish-it as options, with finish-it only when no syrettes remain. It is unclear whether both actions should be available simultaneously when syrettes are left.\n\nI need to verify that syncViews is called from the update loop so soldiers, mercenaries, buddies, and civilians all move correctly. The dev mode hit test fix looks correct if the dev screen uses menuInput, hover, and draw through the same window. I should confirm the Reset button is inside that window.\n\nThe knockBuddy prompt claims to offer syrette or finish-it, but the use key only triggers the syrette path. When a syrette is available, finish-it is unreachable. This appears to be a bug relative to the prior gap.","signature":""},{"type":"tool_use","id":"call-d5f02df4-7c30-4e40-baf1-65b188f84d03-11","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs","offset":1,"limit":250}},{"type":"tool_use","id":"call-d5f02df4-7c30-4e40-baf1-65b188f84d03-12","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs","offset":450,"limit":280}},{"type":"tool_use","id":"call-d5f02df4-7c30-4e40-baf1-65b188f84d03-13","name":"grep","input":{"pattern":"dev|menuWindow|Reset|hover","glob":"**/tests/run.mjs","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6369,"output_tokens":1430,"cache_read_input_tokens":43264,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"8bac1d11-6379-4d03-a727-a2199957572e"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-d5f02df4-7c30-4e40-baf1-65b188f84d03-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Headless acceptance. Run from the dev folder: node tests/run.mjs --all */\\nimport { execFileSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { Engine, checkModel, parseSong, validateTexture } from '../pixel-engine.js';\\nimport { aboutPages } from '../src/content/about.js';\\nimport { LINES } from '../src/content/dialogue.js';\\n10→import { SONGS } from '../src/audio/songs.js';\\nimport { MODELS } from '../src/art/models.js';\\nimport { TEXTURES } from '../src/art/textures.js';\\nimport { siteById } from '../src/content/sites.js';\\nimport { TUNING_DEFAULTS, TUNING_RANGES, SLIDER_KEYS } from '../src/content/tuning-defaults.js';\\nimport { TUNING } from '../src/core/tuning.js';\\nimport { createGame } from '../src/game.js';\\n\\nconst root = dirname(dirname(fileURLToPath(import.meta.url)));\\nconst args = process.argv.slice(2);\\n20→const only = args.find((a) => a.startsWith('--only='))?.slice(7)\\n  || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\\nconst DT = 1 / 60;\\nconst tests = [];\\nconst test = (name, fn) => tests.push({ name, fn });\\n\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg || 'assertion failed');\\n}\\n\\n30→let engine;\\nlet game;\\n\\nasync function boot() {\\n  if (engine) return;\\n  game = createGame();\\n  engine = await Engine.headless(game, { seed: 1 });\\n}\\n\\nfunction release() {\\n40→  for (const code of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'ShiftLeft', 'Space', 'Enter', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4']) {\\n    engine.input.setKey(code, false);\\n  }\\n  engine.input.setButtons(0);\\n}\\n\\nfunction tap(code) {\\n  engine.input.setKey(code, true);\\n  engine.step(1, DT);\\n  engine.input.setKey(code, false);\\n50→  engine.step(1, DT);\\n}\\n\\nfunction holdKey(code, frames) {\\n  engine.input.setKey(code, true);\\n  engine.step(frames, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\n60→function tapFire() {\\n  engine.input.setButtons(1);\\n  engine.step(2, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdFire(frames) {\\n  engine.input.setButtons(1);\\n  engine.step(frames, DT);\\n70→  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction arm(id) {\\n  const w = game.world;\\n  const i = w.guns.findIndex((g) => g.id === id);\\n  if (i < 0) throw new Error('no gun ' + id);\\n  tap('Digit' + (i + 1));\\n  if (w.weapon?.id !== id) throw new Error('selected ' + w.weapon?.id + ' instead of ' + id);\\n80→}\\n\\nfunction goTo(x, z, r) {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  release();\\n  for (let spins = 0; spins < 2500; spins++) {\\n    if (!w.mission || w.mission.done || w.currentStep() !== step) {\\n      release();\\n      return;\\n90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n130→  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n140→  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n150→  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n160→  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n170→  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n180→      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n190→    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n200→  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n210→  for (let guard = 0; guard < 80 && w.mission && !w.mission.done; guard++) {\\n    const step = w.currentStep();\\n    if (!step) break;\\n    const before = w.mission.index;\\n    if (step.do === 'lines') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'lines'; n++) tap('Enter');\\n    } else if (step.do === 'map') {\\n      if (!w.map.up) tap('KeyM');\\n      else engine.step(1, DT);\\n      if (w.map.up) tap('KeyM');\\n220→    } else if (step.do === 'fever-fall') {\\n      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n230→        goTo(x + radius + 30, z, 8);\\n      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n240→    } else if (step.do === 'syrette') {\\n      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n250→        engine.input.setButtons(0);\",\"content_concise\":\"1→/** Headless acceptance. Run from the dev folder: node tests/run.mjs --all */\\nimport { execFileSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { Engine, checkModel, parseSong, validateTexture } from '../pixel-engine.js';\\nimport { aboutPages } from '../src/content/about.js';\\nimport { LINES } from '../src/content/dialogue.js';\\n10→import { SONGS } from '../src/audio/songs.js';\\nimport { MODELS } from '../src/art/models.js';\\nimport { TEXTURES } from '../src/art/textures.js';\\nimport { siteById } from '../src/content/sites.js';\\nimport { TUNING_DEFAULTS, TUNING_RANGES, SLIDER_KEYS } from '../src/content/tuning-defaults.js';\\nimport { TUNING } from '../src/core/tuning.js';\\nimport { createGame } from '../src/game.js';\\n\\nconst root = dirname(dirname(fileURLToPath(import.meta.url)));\\nconst args = process.argv.slice(2);\\n20→const only = args.find((a) => a.startsWith('--only='))?.slice(7)\\n  || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\\nconst DT = 1 / 60;\\nconst tests = [];\\nconst test = (name, fn) => tests.push({ name, fn });\\n\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg || 'assertion failed');\\n}\\n\\n30→let engine;\\nlet game;\\n\\nasync function boot() {\\n  if (engine) return;\\n  game = createGame();\\n  engine = await Engine.headless(game, { seed: 1 });\\n}\\n\\nfunction release() {\\n40→  for (const code of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'ShiftLeft', 'Space', 'Enter', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4']) {\\n    engine.input.setKey(code, false);\\n  }\\n  engine.input.setButtons(0);\\n}\\n\\nfunction tap(code) {\\n  engine.input.setKey(code, true);\\n  engine.step(1, DT);\\n  engine.input.setKey(code, false);\\n50→  engine.step(1, DT);\\n}\\n\\nfunction holdKey(code, frames) {\\n  engine.input.setKey(code, true);\\n  engine.step(frames, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\n60→function tapFire() {\\n  engine.input.setButtons(1);\\n  engine.step(2, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdFire(frames) {\\n  engine.input.setButtons(1);\\n  engine.step(frames, DT);\\n70→  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction arm(id) {\\n  const w = game.world;\\n  const i = w.guns.findIndex((g) => g.id === id);\\n  if (i < 0) throw new Error('no gun ' + id);\\n  tap('Digit' + (i + 1));\\n  if (w.weapon?.id !== id) throw new Error('selected ' + w.weapon?.id + ' instead of ' + id);\\n80→}\\n\\nfunction goTo(x, z, r) {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  release();\\n  for (let spins = 0; spins < 2500; spins++) {\\n    if (!w.mission || w.mission.done || w.currentStep() !== step) {\\n      release();\\n      return;\\n90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n130→  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n140→  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n150→  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n160→  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n170→  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n180→      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n190→    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n200→  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n210→  for (let guard = 0; guard < 80 && w.mission && !w.mission.done; guard++) {\\n    const step = w.currentStep();\\n    if (!step) break;\\n    const before = w.mission.index;\\n    if (step.do === 'lines') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'lines'; n++) tap('Enter');\\n    } else if (step.do === 'map') {\\n      if (!w.map.up) tap('KeyM');\\n      else engine.step(1, DT);\\n      if (w.map.up) tap('KeyM');\\n220→    } else if (step.do === 'fever-fall') {\\n      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n230→        goTo(x + radius + 30, z, 8);\\n      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n240→    } else if (step.do === 'syrette') {\\n      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n250→        engine.input.setButtons(0);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"offset\":1,\"limit\":250,\"raw_output\":\"/** Headless acceptance. Run from the dev folder: node tests/run.mjs --all */\\nimport { execFileSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { Engine, checkModel, parseSong, validateTexture } from '../pixel-engine.js';\\nimport { aboutPages } from '../src/content/about.js';\\nimport { LINES } from '../src/content/dialogue.js';\\nimport { SONGS } from '../src/audio/songs.js';\\nimport { MODELS } from '../src/art/models.js';\\nimport { TEXTURES } from '../src/art/textures.js';\\nimport { siteById } from '../src/content/sites.js';\\nimport { TUNING_DEFAULTS, TUNING_RANGES, SLIDER_KEYS } from '../src/content/tuning-defaults.js';\\nimport { TUNING } from '../src/core/tuning.js';\\nimport { createGame } from '../src/game.js';\\n\\nconst root = dirname(dirname(fileURLToPath(import.meta.url)));\\nconst args = process.argv.slice(2);\\nconst only = args.find((a) => a.startsWith('--only='))?.slice(7)\\n  || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\\nconst DT = 1 / 60;\\nconst tests = [];\\nconst test = (name, fn) => tests.push({ name, fn });\\n\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg || 'assertion failed');\\n}\\n\\nlet engine;\\nlet game;\\n\\nasync function boot() {\\n  if (engine) return;\\n  game = createGame();\\n  engine = await Engine.headless(game, { seed: 1 });\\n}\\n\\nfunction release() {\\n  for (const code of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'ShiftLeft', 'Space', 'Enter', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4']) {\\n    engine.input.setKey(code, false);\\n  }\\n  engine.input.setButtons(0);\\n}\\n\\nfunction tap(code) {\\n  engine.input.setKey(code, true);\\n  engine.step(1, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdKey(code, frames) {\\n  engine.input.setKey(code, true);\\n  engine.step(frames, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction tapFire() {\\n  engine.input.setButtons(1);\\n  engine.step(2, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdFire(frames) {\\n  engine.input.setButtons(1);\\n  engine.step(frames, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction arm(id) {\\n  const w = game.world;\\n  const i = w.guns.findIndex((g) => g.id === id);\\n  if (i < 0) throw new Error('no gun ' + id);\\n  tap('Digit' + (i + 1));\\n  if (w.weapon?.id !== id) throw new Error('selected ' + w.weapon?.id + ' instead of ' + id);\\n}\\n\\nfunction goTo(x, z, r) {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  release();\\n  for (let spins = 0; spins < 2500; spins++) {\\n    if (!w.mission || w.mission.done || w.currentStep() !== step) {\\n      release();\\n      return;\\n    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction texBytes(tex) {\\n  const image = tex && tex.image;\\n  if (image && image.data) return image.data;\\n  const source = tex && tex.source && tex.source.data;\\n  if (source && source.data) return source.data;\\n  return source || image || null;\\n}\\n\\nfunction assertHeldMap(w, label) {\\n  const sheet = w.mapSheet;\\n  const cam = game.ctx.camera.camera;\\n  assert(sheet && sheet.visible, label + ' map is not in the hands');\\n  assert(w.mapRig && w.mapRig.parent === game.ctx.scene, label + ' map is not in the scene');\\n  assert(sheet.parent === w.mapRig, label + ' map is not on the hand rig');\\n  cam.updateMatrixWorld(true);\\n  const e = cam.matrixWorld.elements;\\n  const dx = w.mapRig.position.x - e[12];\\n  const dy = w.mapRig.position.y - e[13];\\n  const dz = w.mapRig.position.z - e[14];\\n  assert(dx * dx + dy * dy + dz * dz < 0.04, label + ' map is not on the camera');\\n  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\\n  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\\n  const gps = sheet.getObjectByName('gps');\\n  assert(gps, label + ' gps missing');\\n  assert(texBytes(w.gpsTex) === w.gpsPx, label + ' gps texture does not read gpsPx');\\n  assert(gps.material && gps.material.map === w.gpsTex, label + ' gps mesh does not sample gpsPx');\\n  let marked = false;\\n  for (let i = 0; i < w.gpsPx.length; i += 4) {\\n    if (w.gpsPx[i] === 220 && w.gpsPx[i + 1] === 48) marked = true;\\n  }\\n  assert(marked, label + ' gps did not paint');\\n}\\n\\nfunction assertRig(actor, label) {\\n  assert(actor && actor.view, label + ' has no rig');\\n  assert(actor.view.parent === game.ctx.scene, label + ' rig is not in the scene');\\n  actor.x = (actor.x || 0) + 6;\\n  engine.step(1, DT);\\n  const dx = Math.abs(actor.view.position.x - actor.x);\\n  assert(dx < 0.05, label + ' rig did not follow ' + actor.view.position.x + ' vs ' + actor.x);\\n}\\n\\nfunction lightCurrentBurn() {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n  const r = step.r || 12;\\n  const origin = w.fire.cellAt(step.x, step.z);\\n  let lx = step.x;\\n  let lz = step.z;\\n  const reach = Math.ceil(r / 5);\\n  let best = Infinity;\\n  for (let dz = -reach; dz <= reach; dz++) {\\n    for (let dx = -reach; dx <= reach; dx++) {\\n      const ix = origin.ix + dx;\\n      const iz = origin.iz + dz;\\n      if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n      const i = w.fire.idx(ix, iz);\\n      if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n      const [cx, cz] = w.fire.center(ix, iz);\\n      const d = Math.hypot(cx - step.x, cz - step.z);\\n      if (d > r - 1 || d >= best) continue;\\n      best = d;\\n      lx = cx;\\n      lz = cz;\\n    }\\n  }\\n  w.teleport(lx, lz + 18);\\n  game.ctx.camera.yaw = 0;\\n  arm('flare');\\n  tapFire();\\n  engine.step(20, DT);\\n}\\n\\nfunction clickHud(pixelY) {\\n  engine.input.setPointer(0, 1 - (pixelY / 270) * 2, true);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0, 1, false);\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n  for (let guard = 0; guard < 80 && w.mission && !w.mission.done; guard++) {\\n    const step = w.currentStep();\\n    if (!step) break;\\n    const before = w.mission.index;\\n    if (step.do === 'lines') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'lines'; n++) tap('Enter');\\n    } else if (step.do === 'map') {\\n      if (!w.map.up) tap('KeyM');\\n      else engine.step(1, DT);\\n      if (w.map.up) tap('KeyM');\\n    } else if (step.do === 'fever-fall') {\\n      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n        goTo(x + radius + 30, z, 8);\\n      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n    } else if (step.do === 'syrette') {\\n      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n        engine.input.setButtons(0);\\n\",\"total_lines\":775}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d5f02df4-7c30-4e40-baf1-65b188f84d03-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"450→  holdFire(40);\\n  const jammed = w.guns.find((g) => g.id === 'tractor');\\n  assert(jammed.jammed, 'did not jam');\\n  const shots = jammed.shots;\\n  holdFire(20);\\n  assert(jammed.shots === shots, 'jammed gun fired');\\n  for (let n = 0; n < 5 && jammed.jammed; n++) tap('KeyR');\\n  assert(!jammed.jammed, 'reload did not clear jam');\\n  const civil = w.actors.find((a) => a.kind === 'civil');\\n  const hp = civil.hp;\\n460→  placeFacing(civil.x, civil.z);\\n  arm('tractor');\\n  holdFire(20);\\n  assert(civil.alive && civil.hp === hp && civil.fleeing, 'civilian was killed');\\n  w.tablets = 1;\\n  w.stones = 50;\\n  w.feverT = 0.05;\\n  w.feverOn = false;\\n  engine.step(5, DT);\\n  assert(w.feverOn, 'fever did not start');\\n470→  holdKey('KeyH', 80);\\n  assert(!w.feverOn || w.feverClear > 0, 'tablet did not clear fever');\\n  w.feverOn = true;\\n  w.feverClear = 0;\\n  w.feverIgnore = 0;\\n  w.tablets = 0;\\n  w.stones = 50;\\n  engine.step(26 * 60, DT);\\n  assert(w.stones <= 40.01, 'ignore did not cost stones ' + w.stones);\\n  w.hp = 15;\\n480→  tap('KeyQ');\\n  assert(w.surgeryT > 0, 'no surgery');\\n  engine.step(5 * 60, DT);\\n  assert(w.hp >= 40, 'surgery hp ' + w.hp);\\n  w.startMission('m3');\\n  w.lines = [];\\n  w.hp = 1;\\n  w.hurt(50, 'bullet', true);\\n  assert(w.rescueT > 0, 'no rescue');\\n  engine.step(4 * 60, DT);\\n490→  assert(w.hp >= 40 && w.rescueT <= 0, 'rescue failed ' + w.hp + ' t ' + w.rescueT);\\n  w.deadBuddies.clear();\\n  assert(w.startMission('m6'), 'm6 missing');\\n  assert(w.currentStep().do === 'lines', 'm6 did not open on its line');\\n  tap('Enter');\\n  assert(w.currentStep()?.do === 'goto', 'm6 line did not advance ' + w.currentStep()?.do);\\n  const field = siteById('long-field');\\n  w.teleport(field.x, field.z);\\n  engine.step(2, DT);\\n  assert(w.currentStep()?.do === 'burn', 'm6 goto did not finish ' + w.currentStep()?.do);\\n500→  lightCurrentBurn();\\n  assert(w.currentStep()?.do === 'buddy-down', 'm6 burn did not reach the down ' + w.currentStep()?.do);\\n  const down = w.buddies.find((b) => b.alive && b.down);\\n  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\\n  assert(down.view && down.view.parent === game.ctx.scene, 'downed buddy has no rig');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'SYRETTE OR FINISH IT', 'campaign prompt ' + w.prompt);\\n  assert(w.syrettes > 0, 'campaign down had no syrette');\\n  const sid = down.id;\\n  const syretteBefore = w.syrettes;\\n510→  tap('KeyE');\\n  const up = w.buddies.find((b) => b.id === sid);\\n  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\\n  assert(w.syrettes === 0, 'a syrette was left after the campaign down');\\n  w.knockBuddy();\\n  const down2 = w.buddies.find((b) => b.alive && b.down);\\n  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'empty syrette prompt ' + w.prompt);\\n  const fid = down2.id;\\n520→  tap('KeyE');\\n  assert(w.deadBuddies.has(fid) && w.syrettes === 0, 'finish-it did not record the death');\\n  const live = w.buddies.find((b) => b.alive && !b.down);\\n  w.syrettes = 1;\\n  w.downBuddy(live.id, { burning: true });\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'a burning down still offered a syrette');\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(live.id) && w.syrettes === 1, 'a burning down used the syrette');\\n});\\n530→\\ntest('map while driving and sliders', async () => {\\n  await boot();\\n  const w = game.world;\\n  w.startMission('m1');\\n  engine.step(2, DT);\\n  assert(!w.inVehicle, 'map walk started in the truck');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(w.map.up && w.map.anim > 0.9, 'map did not rise on foot ' + w.map.anim);\\n540→  assertHeldMap(w, 'walking');\\n  w.teleport(80, 120);\\n  engine.step(2, DT);\\n  const zFoot = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyW', false);\\n  assert(Math.abs(w.feet().z - zFoot) > 0.2, 'world paused while walking with the map');\\n  assertHeldMap(w, 'walking');\\n  tap('KeyM');\\n550→  engine.step(30, DT);\\n  assert(!w.map.up && w.map.anim < 0.02, 'map stayed up');\\n  w.teleport(16, 55);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n  assert(w.inVehicle, 'did not enter');\\n  const z0 = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.input.setKey('KeyM', true);\\n  engine.step(20, DT);\\n560→  engine.input.setKey('KeyM', false);\\n  engine.input.setKey('KeyW', false);\\n  assert(w.map.up && w.inVehicle, 'map not held while driving');\\n  assertHeldMap(w, 'driving');\\n  assert(w.feet().z !== z0, 'world paused on the map');\\n  const cx = w.map.cx;\\n  engine.input.setPointer(0, 0, false);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0.02, -0.01, false);\\n  engine.step(2, DT);\\n570→  assert(w.map.cx !== cx, 'cursor did not move');\\n  tap('KeyE');\\n  assert(w.waypoint, 'no waypoint');\\n  w.spawnSoldier({ x: 20, z: 20, faction: 'concord' });\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  const maxBefore = soldier.max;\\n  game.applySlider('enemyHealth', 2);\\n  assert(TUNING.enemyHealth === 2 && soldier.max === maxBefore * 2, 'enemy health slider');\\n  game.applySlider('vehicleTopSpeed', 40);\\n  assert(w.car.o.topSpeed === 40, 'top speed slider');\\n580→  game.applySlider('playerSpeed', 2);\\n  assert(TUNING.playerSpeed === 2, 'player speed');\\n  for (const key of SLIDER_KEYS) {\\n    const [a, b] = TUNING_RANGES[key];\\n    game.applySlider(key, a);\\n    assert(TUNING[key] === a, key + ' low');\\n    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n  game.resetSliders();\\n590→  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\\n\\n600→test('story both endings', async () => {\\n  await boot();\\n  game.world.deadBuddies.clear();\\n  const chain = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5'];\\n  for (const id of chain) playMission(id);\\n  const burntBefore = game.world.fire.burntCount;\\n  playMission('m6', { dead: ['dov'] });\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy was not kept');\\n  assert(game.world.fire.burntCount > burntBefore, 'story scar missing');\\n  playMission('m7');\\n610→  playMission('m8');\\n  playMission('m9', { picks: [0, 0] });\\n  assert(game.world.ledger.killed >= 1, 'shoot choice did not pay a kill');\\n  assert(game.world.sheet === 'walk', 'walk sheet ' + game.world.sheet);\\n  playMission('end', { sheet: 'walk' });\\n  assert(game.ending === 'walk', 'walk card ' + game.ending);\\n  assert(game.world.deadBuddies.has('dov'), 'dead buddy lost before the ending');\\n  playMission('end', { sheet: 'give', dead: ['ines'] });\\n  assert(game.ending === 'give', 'give card');\\n  assert(game.world.deadBuddies.has('ines'), 'second ending had no dead buddy');\\n620→  assert(game.world.ledger.moved > 0, 'nobody moved');\\n  assert(game.world.ledger.stonesEarned > 0, 'no stones');\\n  assert(game.world.ledger.friends >= 1, 'no friends lost');\\n});\\n\\ntest('solo round', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.startSolo();\\n  const round = game.world.round;\\n630→  const seat = round.seat(0);\\n  const merc = round.seats.find((s) => s.ai);\\n  const startHp = merc.hp;\\n  arm('tractor');\\n  for (let n = 0; n < 10 && !merc.down; n++) {\\n    const foe = game.world.actors.find((a) => a.seat === merc.id);\\n    if (!foe) break;\\n    placeFacing(foe.x, foe.z);\\n    holdFire(10);\\n  }\\n640→  assert(merc.hp < startHp, 'friendly fire did nothing ' + merc.hp);\\n  assert(merc.down, 'merc did not drop ' + merc.hp);\\n  game.world.teleport(merc.x, merc.z + 1);\\n  engine.step(1, DT);\\n  holdKey('KeyE', 200);\\n  assert(!merc.down && merc.hp > 0, 'revive failed');\\n  const box = round.cases.find((c) => !c.taken && !c.carrier);\\n  game.world.teleport(box.x, box.z);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n650→  assert(seat.carrying === box.id, 'did not pick up');\\n  game.world.hurt(500, 'bullet', true);\\n  assert(round.localDown && box.carrier == null && !box.taken, 'down did not drop the case');\\n  game.session.emit('time-up');\\n  assert(game.session.ended, 'time-up did not finish');\\n  const standings = game.session.outcome.standings;\\n  assert(Array.isArray(standings) && standings.length > 0, 'no standings');\\n  assert(game.session.outcome.stats[0].Stones != null, 'no stats');\\n});\\n\\n660→test('menus attract pause touch', async () => {\\n  await boot();\\n  game.toTitle();\\n  game.idle = 0;\\n  game.attract = false;\\n  game.mode = 'title';\\n  game.screen = 'title';\\n  const saves = game.saves;\\n  engine.step(600, DT);\\n  assert(!game.attract && game.idle < 10.01, 'attract early ' + game.idle);\\n670→  engine.step(1, DT);\\n  assert(game.attract && game.state().attract, 'attract did not start');\\n  engine.step(70 * 60, DT);\\n  assert(engine.errors.length === 0, 'attract errors');\\n  tap('KeyE');\\n  assert(!game.attract && game.screen === 'title', 'attract exit ' + game.screen);\\n  assert(game.saves === saves, 'attract wrote a save');\\n  game.screen = 'settings';\\n  game.mode = 'menu';\\n  game.idle = 0;\\n680→  engine.step(700, DT);\\n  assert(!game.attract, 'attract on settings');\\n  game.toTitle();\\n  tap('Enter');\\n  assert(game.screen === 'menu', 'title confirm');\\n  const labels = game.items().map((item) => item.label);\\n  assert(labels.includes('HOST ON THIS COMPUTER') === false, 'host is not on the root menu');\\n  game.screen = 'cash';\\n  const cash = game.items().map((item) => item.id);\\n  assert(cash.includes('host') && cash.includes('join') && cash.includes('solo'), 'link menu missing');\\n690→  game.screen = 'menu';\\n  game.mode = 'menu';\\n  game.focus = game.items().findIndex((item) => item.id === 'settings');\\n  tap('Enter');\\n  assert(game.screen === 'settings', 'settings');\\n  game.focus = game.items().findIndex((item) => item.id === 'glyphs');\\n  tap('Enter');\\n  assert(game.glyphSet === 'xbox', 'glyphs');\\n  game.world.startMission('m2');\\n  tap('Escape');\\n700→  assert(engine.timeScale === 0 && game.mode === 'pause', 'pause');\\n  const clock = game.world.clock;\\n  engine.step(30, DT);\\n  assert(game.world.clock === clock, 'pause stepped the sim');\\n  const dev = game.items().some((item) => item.id === 'dev');\\n  assert(dev, 'dev mode hidden');\\n  game.focus = game.items().findIndex((item) => item.id === 'dev');\\n  tap('Enter');\\n  assert(game.screen === 'dev' && game.items().length > 9, 'dev list ' + game.items().length);\\n  game.focus = 10;\\n710→  const windowTop = Math.max(0, game.focus - 6);\\n  const activated = [];\\n  const activate = game.activate.bind(game);\\n  game.activate = (item) => {\\n    activated.push(item && item.id);\\n    activate(item);\\n  };\\n  clickHud(86);\\n  assert(game.focus === windowTop, 'scrolled click focused ' + game.focus + ' wanted ' + windowTop);\\n  assert(activated[0] === game.items()[windowTop].id, 'scrolled click activated ' + activated[0]);\\n720→  const resetAt = game.items().findIndex((item) => item.id === 'reset-sliders');\\n  game.focus = resetAt;\\n  const resetRow = resetAt - Math.max(0, resetAt - 6);\\n  game.applySlider('wearRate', TUNING_RANGES.wearRate[1]);\\n  assert(TUNING.wearRate === TUNING_RANGES.wearRate[1], 'wear slider');\\n  clickHud(86 + resetRow * 16);\\n  assert(game.focus === resetAt, 'reset click focused ' + game.focus);\\n  assert(TUNING.wearRate === TUNING_DEFAULTS.wearRate, 'reset click missed the drawn row');\\n  engine.input.setPointer(0, 1, false);\\n  game.focus = game.items().findIndex((item) => item.id === 'back');\",\"content_concise\":\"450→  holdFire(40);\\n  const jammed = w.guns.find((g) => g.id === 'tractor');\\n  assert(jammed.jammed, 'did not jam');\\n  const shots = jammed.shots;\\n  holdFire(20);\\n  assert(jammed.shots === shots, 'jammed gun fired');\\n  for (let n = 0; n < 5 && jammed.jammed; n++) tap('KeyR');\\n  assert(!jammed.jammed, 'reload did not clear jam');\\n  const civil = w.actors.find((a) => a.kind === 'civil');\\n  const hp = civil.hp;\\n460→  placeFacing(civil.x, civil.z);\\n  arm('tractor');\\n  holdFire(20);\\n  assert(civil.alive && civil.hp === hp && civil.fleeing, 'civilian was killed');\\n  w.tablets = 1;\\n  w.stones = 50;\\n  w.feverT = 0.05;\\n  w.feverOn = false;\\n  engine.step(5, DT);\\n  assert(w.feverOn, 'fever did not start');\\n470→  holdKey('KeyH', 80);\\n  assert(!w.feverOn || w.feverClear > 0, 'tablet did not clear fever');\\n  w.feverOn = true;\\n  w.feverClear = 0;\\n  w.feverIgnore = 0;\\n  w.tablets = 0;\\n  w.stones = 50;\\n  engine.step(26 * 60, DT);\\n  assert(w.stones <= 40.01, 'ignore did not cost stones ' + w.stones);\\n  w.hp = 15;\\n480→  tap('KeyQ');\\n  assert(w.surgeryT > 0, 'no surgery');\\n  engine.step(5 * 60, DT);\\n  assert(w.hp >= 40, 'surgery hp ' + w.hp);\\n  w.startMission('m3');\\n  w.lines = [];\\n  w.hp = 1;\\n  w.hurt(50, 'bullet', true);\\n  assert(w.rescueT > 0, 'no rescue');\\n  engine.step(4 * 60, DT);\\n490→  assert(w.hp >= 40 && w.rescueT <= 0, 'rescue failed ' + w.hp + ' t ' + w.rescueT);\\n  w.deadBuddies.clear();\\n  assert(w.startMission('m6'), 'm6 missing');\\n  assert(w.currentStep().do === 'lines', 'm6 did not open on its line');\\n  tap('Enter');\\n  assert(w.currentStep()?.do === 'goto', 'm6 line did not advance ' + w.currentStep()?.do);\\n  const field = siteById('long-field');\\n  w.teleport(field.x, field.z);\\n  engine.step(2, DT);\\n  assert(w.currentStep()?.do === 'burn', 'm6 goto did not finish ' + w.currentStep()?.do);\\n500→  lightCurrentBurn();\\n  assert(w.currentStep()?.do === 'buddy-down', 'm6 burn did not reach the down ' + w.currentStep()?.do);\\n  const down = w.buddies.find((b) => b.alive && b.down);\\n  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\\n  assert(down.view && down.view.parent === game.ctx.scene, 'downed buddy has no rig');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'SYRETTE OR FINISH IT', 'campaign prompt ' + w.prompt);\\n  assert(w.syrettes > 0, 'campaign down had no syrette');\\n  const sid = down.id;\\n  const syretteBefore = w.syrettes;\\n510→  tap('KeyE');\\n  const up = w.buddies.find((b) => b.id === sid);\\n  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\\n  assert(w.syrettes === 0, 'a syrette was left after the campaign down');\\n  w.knockBuddy();\\n  const down2 = w.buddies.find((b) => b.alive && b.down);\\n  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'empty syrette prompt ' + w.prompt);\\n  const fid = down2.id;\\n520→  tap('KeyE');\\n  assert(w.deadBuddies.has(fid) && w.syrettes === 0, 'finish-it did not record the death');\\n  const live = w.buddies.find((b) => b.alive && !b.down);\\n  w.syrettes = 1;\\n  w.downBuddy(live.id, { burning: true });\\n  engine.step(1, DT);\\n  assert(w.prompt === 'FINISH IT', 'a burning down still offered a syrette');\\n  tap('KeyE');\\n  assert(w.deadBuddies.has(live.id) && w.syrettes === 1, 'a burning down used the syrette');\\n});\\n530→\\ntest('map while driving and sliders', async () => {\\n  await boot();\\n  const w = game.world;\\n  w.startMission('m1');\\n  engine.step(2, DT);\\n  assert(!w.inVehicle, 'map walk started in the truck');\\n  tap('KeyM');\\n  engine.step(30, DT);\\n  assert(w.map.up && w.map.anim > 0.9, 'map did not rise on foot ' + w.map.anim);\\n540→  assertHeldMap(w, 'walking');\\n  w.teleport(80, 120);\\n  engine.step(2, DT);\\n  const zFoot = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.step(20, DT);\\n  engine.input.setKey('KeyW', false);\\n  assert(Math.abs(w.feet().z - zFoot) > 0.2, 'world paused while walking with the map');\\n  assertHeldMap(w, 'walking');\\n  tap('KeyM');\\n550→  engine.step(30, DT);\\n  assert(!w.map.up && w.map.anim < 0.02, 'map stayed up');\\n  w.teleport(16, 55);\\n  engine.step(1, DT);\\n  tap('KeyE');\\n  assert(w.inVehicle, 'did not enter');\\n  const z0 = w.feet().z;\\n  engine.input.setKey('KeyW', true);\\n  engine.input.setKey('KeyM', true);\\n  engine.step(20, DT);\\n560→  engine.input.setKey('KeyM', false);\\n  engine.input.setKey('KeyW', false);\\n  assert(w.map.up && w.inVehicle, 'map not held while driving');\\n  assertHeldMap(w, 'driving');\\n  assert(w.feet().z !== z0, 'world paused on the map');\\n  const cx = w.map.cx;\\n  engine.input.setPointer(0, 0, false);\\n  engine.step(1, DT);\\n  engine.input.setPointer(0.02, -0.01, false);\\n  engine.step(2, DT);\\n570→  assert(w.map.cx !== cx, 'cursor did not move');\\n  tap('KeyE');\\n  assert(w.waypoint, 'no waypoint');\\n  w.spawnSoldier({ x: 20, z: 20, faction: 