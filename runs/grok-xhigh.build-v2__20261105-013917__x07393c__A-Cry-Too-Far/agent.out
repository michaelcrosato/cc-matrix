\"playerSpeed 1\\\",\\n        \\\"playerDamageTaken 1\\\",\\n        \\\"weaponDamage 1\\\",\\n        \\\"enemyHealth 1\\\",\\n        \\\"enemyAccuracy 1\\\",\\n70→        \\\"enemyVision 90\\\"\\n      ]\\n    },\\n    \\\"ending\\\": {\\n      \\\"screen\\\": \\\"ending\\\",\\n      \\\"ending\\\": \\\"walk\\\",\\n      \\\"menu\\\": [\\n        \\\"TITLE\\\"\\n      ]\\n    },\\n80→    \\\"hub-card\\\": {\\n      \\\"mode\\\": \\\"card\\\",\\n      \\\"players\\\": 2\\n    }\\n  }\\n}\\n\",\"content_concise\":\"1→{\\n  \\\"errors\\\": [],\\n  \\\"notes\\\": {\\n    \\\"day-gun\\\": {\\n      \\\"screen\\\": \\\"play\\\",\\n      \\\"hour\\\": 8.055777777777699,\\n      \\\"weapon\\\": {\\n        \\\"id\\\": \\\"tractor\\\",\\n        \\\"cond\\\": 100,\\n10→        \\\"jammed\\\": false,\\n        \\\"mag\\\": 30\\n      },\\n      \\\"frame\\\": 53\\n    },\\n    \\\"title\\\": {\\n      \\\"screen\\\": \\\"title\\\",\\n      \\\"title\\\": \\\"A Cry Too Far\\\",\\n      \\\"menu\\\": [\\n        \\\"PRESS TO START\\\"\\n20→      ]\\n    },\\n    \\\"night-fire\\\": {\\n      \\\"hour\\\": 22,\\n      \\\"burning\\\": 8\\n    },\\n    \\\"map-truck\\\": {\\n      \\\"vehicle\\\": true,\\n      \\\"map\\\": true,\\n      \\\"sheet\\\": true,\\n30→      \\\"parent\\\": true,\\n      \\\"truck\\\": {\\n        \\\"x\\\": 18,\\n        \\\"z\\\": 55\\n      }\\n    },\\n    \\\"fight\\\": {\\n      \\\"rig\\\": true,\\n      \\\"at\\\": {\\n        \\\"x\\\": 17.73834991455078,\\n40→        \\\"y\\\": 35.489863766264165,\\n        \\\"z\\\": 50.4205207824707\\n      },\\n      \\\"player\\\": {\\n        \\\"x\\\": 17.73834991455078,\\n        \\\"z\\\": 57.4205207824707\\n      }\\n    },\\n    \\\"tibor-rack\\\": {\\n      \\\"subtitle\\\": \\\"EVERYTHING ON THIS RACK HAS BEEN RETURNED AT LEAST ONCE.\\\",\\n50→      \\\"speaker\\\": \\\"TIBOR\\\",\\n      \\\"screen\\\": \\\"play\\\"\\n    },\\n    \\\"dialogue\\\": {\\n      \\\"subtitle\\\": \\\"WE DO NOT BU