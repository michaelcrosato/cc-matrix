,105,115,46,114,111,111,116,46,97,32,91,46,46,46,32,116,114,117,110,99,97,116,101,100,32,40,49,48,51,53,32,99,104,97,114,115,32,116,111,116,97,108,41,93,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":4,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\",\"matches\":[{\"line_number\":843,\"content\":\"    if (this.inVehicle && this.car) this.drive(dt, input, bot, ax, ay);\"},{\"line_number\":851,\"content\":\"  drive(dt, input, bot, ax, ay) {\"},{\"line_number\":855,\"content\":\"    this.car.drive({ throttle, steer, brake: throttle < 0, handbrake: false }, dt);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/pixel-engine.js\",\"matches\":[{\"line_number\":579,\"content\":\"      </div>`;for(let e of this.root.querySelectorAll(`[data-s]`))this.controls.set(e.dataset.s,e);for(let e of this.root.querySelectorAll(`[data-o]`))this.outputs.set(e.dataset.o,e);let o=e.settings,s=(e,t)=>{let n=this.controls.get(e);n.addEventListener(n instanceof HTMLInputElement&&n.type===`range`?`input`:`change`,()=>{t(n),this.sync()})};s(`look`,e=>o.set({look:e.value||void 0})),s(`pixelArt`,e=>o.set({pixelArt:e.checked})),s(`pixelSize`,e=>o.set({pixelSize:e.value})),s(`quality`,e=>o.set({quality:e.value})),s(`fps`,e=>o.set({fps:kY.includes(Number(e.value))?Number(e.value):void 0})),s(`debugInfo`,e=>o.set({debugInfo:e.checked})),s(`sound`,t=>{e.audio.unlock(),e.audio.setMuted(!t.checked)});for(let[t]of LY)s(t,n=>{e.audio.unlock(),e.audio.setVolume(t,Number(n.value)/100)});let c=(e,t)=>this.root.querySelector(`[data-a=\\\"${e}\\\"]`).addEventListener(`click`,t);c(`close`,()=>o.close()),c(`done`,()=>o.close()),c(`reset`,()=>{o.reset(),e.audio.resetVolumes(),this.sync()}),this.root.addE