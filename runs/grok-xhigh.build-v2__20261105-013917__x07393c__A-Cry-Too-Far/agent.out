pe SongNote } from './music';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/types/engine/index.d.ts\",\"matches\":[{\"line_number\":4,\"content\":\"export { AMOUNT, FILTERS, FILTER_IDS, FILTER_PRESETS, PALETTES, applyFilter, applyFilters, clampParam, defaultParams, filterParams, filterPresets, getFilter, splitFilters, type FilterContext, type FilterDef, type FilterGroup, type FilterParam, type FilterSpace, } from './render/filters';\"},{\"line_number\":14,\"content\":\"export { AudioManager, attenuation, muffleCutoff, PLAYGROUND_SONG, SFX, noteFrequency, parseSong, renderSound, type AudioSettings, type Instrument, type PlayOptions, type SfxName, type Song, type SoundDef, spatialize, type Listener, type Spatial, type SpatialOptions, type Voice, type VoiceSettings, type VolumeChannel, type Wave, } from './audio';\"},{\"line_number\":18,\"content\":\"export { PALETTE, type PaletteColor } from './palette';\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/types/engine/particles/presets.d.ts\",\"matches\":[{\"line_number\":3,\"content\":\" * `ctx.particles.register(name, preset)`. Sizes are art pixels; colors are PALETTE names.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/types/engine/texture/types.d.ts\",\"matches\":[{\"line_number\":11,\"content\":\"/** A key of the def's palette. Layers never name PALETTE colours directly. */\"},{\"line_number\":58,\"content\":\"    /** Slots → PALETTE names (at most 255). Layers name slots, never colours, so a bake can re-bind them. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/types/engine/Engine.d.ts\",\"mat