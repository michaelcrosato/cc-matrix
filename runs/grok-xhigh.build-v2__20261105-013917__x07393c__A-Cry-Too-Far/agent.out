le && this.vehicleHp >= 50) {\\n      this.inVehicle = true;\\n      this.hero.collider.setEnabled(false);\\n      return;\\n    }\\n    if (this.inVehicle) {\\n      this.inVehicle = false;\\n      this.hero.collider.setEnabled(true);\\n      const t = this.truckPos();\\n      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\\n      return;\\n    }\\n    const step = this.currentStep();\\n    if (step && step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16) {\\n        this.completeStep();\\n        return;\\n      }\\n    }\\n    if (step && step.do === 'collect') {\\n      const prop = this.props.find((pr) => pr.tag === step.tag && !pr.hidden && pr.alive !== false);\\n      if (prop && Math.hypot(prop.x - p.x, prop.z - p.z) < 6) {\\n--- ensureTruck ---\\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\\n    }\\n    this.pass = null;\\n    this.windPin = null;\\n    this.subtitle = m.title + ' DONE';\\n  }\\n\\n  moveVillage() {\\n    if (this.movedOnce) return;\\n    this.movedOnce = true;\\n    this.ledger.moved += this.civilians;\\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\\n  }\\n\\n  ensureTruck(x, z) {\\n    if (this.car) return;\\n    const y = this.ground(x, z) + 1.2;\\n    this.car = new Vehicle(this.ctx.physics, {\\n      at: [x, y, z],\\n      yaw: Math.PI,\\n      size: [0.95, 0.45, 2.2],\\n      mass: 12,\\n      power: 160,\\n      topSpeed: TUNING.vehicleTopSpeed,\\n      wheelRadius: 0.42,\\n      suspension: 0.45,\\n      stiffness: 30,\\n      grip: 2.6,\\n    });\\n    this.vehicleHp = 100;\\n    this.vehicleKind = 'pickup';\\n    this.truckX = x;\\n    this.truckZ = z;\\n  }\\n\\n  fixed(dt) {\\n    this.clock += dt;\\n    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\\n    this.hour = ((this.gameHours % 24) + 24) % 24;\\n    this.stepWind(dt);\\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\\n    this.fire.rain = this.rain;\\n    this.fire.step(dt);\\n    this.tickFever(dt);\\n    this.tickBurn(dt);\\n    this.tickRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    if (this.game.blocksSim()) return;\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if (this.round) this.round.tick(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n\",\"exit_code\":0,\"command\":\"DEV=\\\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917\\\"\\nls \\\"$DEV/tests\\\" \\\"$DEV/tools\\\" \\\"$DEV/vendor\\\" | head -80\\necho '--- world enter ---'\\nsed -n '1080,1120p' \\\"$DEV/src/sim/world.js\\\"\\necho '--- ensureTruck ---'\\nsed -n '520,580p' \\\"$DEV/src/sim/world.js\\\"\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Inspect tests dir and truck enter code\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261105-013917__x07393c%2Fwork/01a1aadc-c537-7073-8756-0b078a9e97df/terminal/call-24b98b07-bf32-4c9f-ad7c-54bc6b450f85-8.log\",\"total_bytes\":3639}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"153a767e-c1dc-4e6c-9528-d8b991d5db2c"}
