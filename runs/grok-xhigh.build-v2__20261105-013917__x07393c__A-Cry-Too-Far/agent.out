_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917.html\",\"matches\":[{\"line_number\":492,\"content\":\"<meta name=\\\"hub:session\\\" content=\\\"1\\\">\"},{\"line_number\":493,\"content\":\"<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\"},{\"line_number\":494,\"content\":\"<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\"},{\"line_number\":495,\"content\":\"<meta name=\\\"hub:session-minutes\\\" content=\\\"6\\\">\"},{\"line_number\":497,\"content\":\"<meta name=\\\"hub:session-goal\\\" content=\\\"Carry the most diamond cases out of the burning mine\\\">\"},{\"line_number\":498,\"content\":\"<meta name=\\\"hub:session-howto\\\" content=\\\"Stick/WASD move, R2/mouse fire, Square/E use, carry cases to the truck\\\">\"},{\"line_number\":500,\"content\":\"<title>A Cry Too Far</title>\"},{\"line_number\":501,\"content\":\"</head><body><div id=\\\"app\\\"></div><script type=\\\"module\\\">// pixel-engine.js\"},{\"line_number\":30799,\"content\":\"var NK = `pixel-engine:audio`;\"},{\"line_number\":32560,\"content\":\"var jY = (e104) => `pixel-engine:settings:${e104}`;\"},{\"line_number\":42195,\"content\":\"if ($9.__PIXEL_ASSETS__ = { ...Q9, ...$9.__PIXEL_ASSETS__ }, $9.document && !$9.document.querySelector(`style[data-pixel-engine]`)) {\"},{\"line_number\":42259,\"content\":\"var GAME_TITLE = \\\"A Cry Too Far\\\";\"},{\"line_number\":42335,\"content\":\"  [\\\"CHANGED IN THE ENGINE\\\", \\\"What did you change in the engine, and why?\\\", \\\"None. pixel-engine.js is the kit file.\\\"],\"},{\"line_number\":42919,\"content\":\"      { do: \\\"buddy-down\\\", text: \\\"SYRETTE OR FINISH IT\\\" }\"},{\"line_number\":44807,\"content\":\"      this.prompt = this.syrettes > 0 && !down.burning ? \\\"SYRETTE OR FINISH IT\\\" : \\\"FINISH IT\\\";\"},{\"line_number\":45280,\"content\":\"// src/net/session.js\"},{\"line_number\":45610,\