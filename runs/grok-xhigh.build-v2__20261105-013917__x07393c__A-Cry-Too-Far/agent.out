');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"edits\":{\"details\":[{\"old_string\":\"  game.resetSliders();\\n  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n});\",\"old_line\":579,\"new_string\":\"  game.resetSliders();\\n  for (const key of SLIDER_KEYS) assert(TUNING[key] === TUNING_DEFAULTS[key], 'reset ' + key);\\n  assert(w.car.o.topSpeed === TUNING_DEFAULTS.vehicleTopSpeed, 'reset speed');\\n  const civil = w.actors.find((a) => a.kind === 'civil' && a.alive);\\n  assertRig(civil, 'civilian');\\n  const soldier = w.actors.find((a) => a.kind === 'soldier' && a.alive);\\n  assertRig(soldier, 'soldier');\\n  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\\n  merc.kind = 'merc';\\n  assertRig(merc, 'merc');\\n});\",\"new_line\":579,\"context_before\":\"    game.applySlider(key, b);\\n    assert(TUNING[key] === b, key + ' high');\\n  }\\n\",\"context_after\":\"\\ntest('story both end