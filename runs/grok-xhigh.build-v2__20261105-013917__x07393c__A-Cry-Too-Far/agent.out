     if (this.map.up) {\"},{\"line_number\":883,\"content\":\"    if (this.map.up) this.map.anim = Math.min(1, this.map.anim + dt / 0.4);\"},{\"line_number\":1103,\"content\":\"    if (this.map.up && pressed) {\"},{\"line_number\":1204,\"content\":\"    if (this.map.up) return true;\"},{\"line_number\":1287,\"content\":\"    } else if (step.do === 'map' && this.map.up) this.completeStep();\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/game.js\",\"matches\":[{\"line_number\":20,\"content\":\"const KEYS = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'Enter', 'Space', 'Escape', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'MouseLeft'];\"},{\"line_number\":201,\"content\":\"    this.look.enabled = (this.mode === 'play' || this.mode === 'round' || this.mode === 'attract') && !this.world?.map.up && !this.look.override;\"},{\"line_number\":537,\"content\":\"      w.map.up = this.beatT > 3;\"},{\"line_number\":565,\"content\":\"    if (pressed(input, ['KeyM', 'PadTriangle'])) this.session?.answer('more');\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"444e02a1-451a-49e3-bf30-846ba9d550c2"}
