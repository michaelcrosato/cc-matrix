wers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n450→    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n460→      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n470→    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n480→    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\\n490→        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\\n    } else {\\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n500→      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n510→    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n520→    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\\n  } catch (error) {\\n    check('harness ran', false, String(error?.stack || error));\\n  } finally {\\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\\n    report.done = true;\\n    document.body.dataset.complete = 'true';\\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\\n  }\\n530→}\\n\\nfunction renderChecks(checks) {\\n  $('checklist').replaceChildren(\\n    ...checks.map((c) => {\\n      const li = document.createElement('li');\\n      li.className = c.pass ? 'ok' : 'bad';\\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\\n      li.title = c.detail;\\n      return li;\\n540→    }),\\n  );\\n}\\n\\nif (auto) conformance();\\nelse if ($('game').value) newRound();\\n</script>\\n</body>\\n</html>\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/vendor/hub/harness.html\",\"offset\":360,\"limit\":200,\"raw_output\":\"$('restart').onclick = () => newRound();\\n$('release').onclick = () => releaseRound();\\n$('timeup').onclick = () => current?.coordinator.timeUp();\\n$('remove').onclick = () => {\\n  const cell = current?.cells.find((c) => c.key === $('who').value);\\n  if (cell) removeCell(cell);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\\n  window.__hubCheck = report;\\n  try {\\n    const state = await newRound();\\n    if (!state) {\\n      check('game named', false, 'pass ?game=<path> of a page on this site');\\n      return;\\n    }\\n    const n = state.n;\\n    const m = state.metas;\\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\\n    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\\n    const [least, most = least] = seats;\\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\\n\\n    // Every copy: the players, and in a server round the server's copy.\\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\\n    if (!helloed) return;\\n    const caps = state.coordinator.seats().map((s) => s.caps);\\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\\n      return;\\n    }\\n\\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\\n    if (caps.some((c) => c?.card)) {\\n      const players = state.cells.filter((c) => !c.server);\\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\\n      for (const cell of players) poke(cell, 'Enter');\\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\\n    }\\n    releaseRound(state);\\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\\n    if (!started || state.record) return;\\n\\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\\n    const randomly = async (ms) => {\\n      const end = performance.now() + ms;\\n      while (performance.now() < end && !state.record) {\\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\\n        await sleep(150);\\n      }\\n    };\\n    await randomly(Math.min(1500, playMs / 4));\\n\\n    const mode = state.coordinator.mode;\\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\\n    const own = SELF_REPORTED.includes(mode);\\n    const legacyRace = own && !seedsRandom(m?.mode);\\n    if (own && !legacyRace) {\\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\\n    }\\n\\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\\n    else if (n >= 3) removeCell(state.cells[n - 1]);\\n    await randomly(playMs / 2);\\n    const remaining = state.cells.filter((c) => !c.gone);\\n    if (own) {\\n      if (mode === 'parallel') {\\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      } else {\\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\\n      }\\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\\n    } else {\\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\\n    }\\n\\n    if (!state.record) state.coordinator.timeUp();\\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\\n    const record = state.record;\\n    if (serverMode) {\\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\\n      const serverCell = state.cells.find((c) => c.server);\\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\\n    }\\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\\n    } else {\\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\\n    }\\n    await sleep(300);\\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\\n    const violations = state.cells.flatMap((c) => {\\n      let extra = [];\\n      try {\\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\\n      } catch {}\\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\\n    });\\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\\n  } catch (error) {\\n    check('harness ran', false, String(error?.stack || error));\\n  } finally {\\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\\n    report.done = true;\\n    document.body.dataset.complete = 'true';\\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\\n  }\\n}\\n\\nfunction renderChecks(checks) {\\n  $('checklist').replaceChildren(\\n    ...checks.map((c) => {\\n      const li = document.createElement('li');\\n      li.className = c.pass ? 'ok' : 'bad';\\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\\n      li.title = c.detail;\\n      return li;\\n    }),\\n  );\\n}\\n\\nif (auto) conformance();\\nelse if ($('game').value) newRound();\\n</script>\\n</body>\\n</html>\\n\",\"total_lines\":548}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d9fe5318-fbf3-4036-81d7-54904a7c2900-35","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"120→`info` (also on `AIHub` after `connect()`):\\n\\n| Field | |\\n|---|---|\\n| `me` | this copy's player id |\\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\\n130→\\nNames come from the hub and are never inserted into the page as HTML. Colours\\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### The card\\n\\nBefore every round the players get 10 to 30 seconds to learn what comes\\nnext and say when they are ready. By default the hub shows its own card over\\nthe game. A game can make the card its own, as part of the game:\\n\\n140→```js\\nAIHub.connect({ mode, seats, card: true });\\n```\\n\\nThe hub's card then steps aside when the game calls `ready()`, and the game's\\nscreen is the card until `start`. How it looks and sounds is the game's: its\\ntitle, its music, its world, the players lining up. Introduce the game the way\\nit deserves.\\n\\nWhile it is on, the card shows:\\n150→\\n- the game's name;\\n- the players, each in their colour, and which of them are ready;\\n- how to win the round;\\n- the controls this player will use;\\n- the time left, from the `card` event.\\n\\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\\non the card:\\n\\n160→- **Ready**: Enter, Cross (button 0), or a tap on Ready:\\n  `AIHub.answer('ready')`.\\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\\n\\nNothing done on the card changes the round. It has no menus, settings or\\nchoices, and play begins only at `start`. In parallel and ghost it draws no\\nnumbers from `Math.random`, which would change the round's start: use\\n`AIHub.rng('card')`.\\n\\n170→`card` arrives whenever it changes, and every second while the countdown runs:\\n\\n| Field | |\\n|---|---|\\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\\n| `paused` | `true` while most players asked for more time |\\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\\n| `ready` | the ids of the players who are ready |\\n| `asking` | how many players asked for more time (never who) |\\n| `asked` | `true` when this player asked for more time |\\n180→\\n### The start\\n\\n`start` arrives when the round starts. Play begins three seconds later, when\\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\\n`start`.\\n\\n### Reporting\\n\\n190→- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\\n  standing during the round. `score` is a number, higher is ahead; `label` is\\n  text for the hub's scoreboard. The hub takes the latest about once a second.\\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\\n  ghost, once, when the player's round is over. `time` is milliseconds of\\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\\n  by the host only:\\n  - `standings`: arrays of player ids, best first; players in the same array\\n    tie. It lists every player still in the round once; anyone left out is\\n200→    placed last.\\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\\n  - `won` (optional): `true` or `false` when the round is a team result.\\n\\n### Time-up and the end\\n\\n- The hub may call time while the round is still going. On `time-up`, the\\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\\n  `finish()` from the host in a shared world. A shared world with no\\n  `finish()` by then is void.\\n210→- `end` is the last message of a round. After it, the game takes no input and\\n  sends nothing, and its sound stops. The hub shows its results over the\\n  game, then removes it.\\n\\n| `end` reason | |\\n|---|---|\\n| `finished` | the round counted; `standings` is the final order |\\n| `void` | it didn't count (no result, a fatal error, skipped) |\\n| `host-left` | the host of a shared world left |\\n| `sat-out` | this player missed the ready deadline |\\n220→| `session-ended` | the session closed |\\n\\n### Leaving\\n\\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\\n- A parallel or ghost round goes on whoever leaves, the host included.\\n- A shared-world round is void when its host leaves, isn't ready, or has its\\n  tab hidden for more than 20 seconds.\\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\\n230→  of a shared world it voids the round; from any other copy it counts as\\n  that player leaving.\\n\\n### Scoring\\n\\n- Parallel and ghost: players with a `time` rank first, lowest first; then\\n  the rest by `score`. A player with no result is ranked by their last\\n  progress.\\n- Shared world: the host's `standings`. With `won`, the results show a team\\n  result instead of medals.\\n240→- Each player gets one point for every player they beat.\\n\\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\\nresults:\\n\\n- in `result()`: `stats` is `{ name: value }` and `awards` is\\n  `[{ title, detail }]`, for this player;\\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\\n  `[{ id, title, detail }]`, for each player.\\n\\n250→Places and points come only from the standings, `time` and `score`.\\n\\n---\\n\\n## Sending data between copies\\n\\n### Parallel\\n\\nThe copies send nothing to each other. `send()` is not used.\\n\\n260→### Ghost\\n\\nEach copy sends its own player's position and what the player is doing to\\nthe other copies with `send()`. Each copy shows the other players' characters\\nonly while they are in the same area of the game as its own player, and those\\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\\n\\n### Shared world\\n\\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\\n270→  host what their own player does, and show the world the host sends them.\\n- The hub can run the host's copy with no player of its own: `AIHub.server`\\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\\n  the world in that case too, with no local player, camera or input.\\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\\n  every copy.\\n\\n### `send()` and `message`\\n\\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\\n280→  to the one player `to`. It returns `false` when the message is dropped.\\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\\n  sender's player id. A copy never receives its own messages. Messages sent\\n  before another copy has loaded are queued for it.\\n- `data` is JSON, at most 16 KB.\\n- At most 20 messages a second leave each copy, with bursts up to 40; the\\n  client drops the rest.\\n- Reliable messages (the default) arrive in the order they were sent.\\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\\n  unreliable message larger than about 1,200 bytes travels as several packets\\n290→  and is lost whole if any of them is.\\n\\n---\\n\\n## Rules\\n\\nIn a session:\\n\\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\\n  game server or public broker. Loading the game's own files is fine.\\n300→- **No communication between players.** No chat, voice, emotes or custom\\n  names. Names come from the hub.\\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\\n  new tabs or navigating away. Quitting, restarting or returning to a title\\n  screen does nothing; the hub starts and ends rounds.\\n- **Create + Options is the hub's.** On a controller, holding the two\\n  together opens the hub's corner bar; the game ignores Options while Create\\n  is held.\\n\\nEverything on this page applies only in a session (`AIHub.active`). Outside\\n310→one, the game is not affected.\\n\\n---\\n\\n## Test it\\n\\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\\nand runs the checks the hub runs when a game joins the library. Serve it next\\nto the game:\\n\\n320→```bash\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\\npython3 -m http.server 8000\\n```\\n\\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\\nThe hub's own test also runs ghost and shared-world games with\\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\\n330→`&scenario=host-leave`, and shared worlds once more with\\n`&players=2&scenario=server`.\\n\\nThe checklist fills in as it runs. **A game passes when\\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\\n`\\\"true\\\"` at the end. It checks:\\n\\n- the tags, `connect()`, `ready()` with no key press, and the start;\\n- with the game's own card, that Enter answers Ready;\\n- parallel and ghost: `Math.random` the same on every copy, and progress from\",\"content_concise\":\"120→`info` (also on `AIHub` after `connect()`):\\n\\n| Field | |\\n|---|---|\\n| `me` | this copy's player id |\\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\\n130→\\nNames come from the hub and are never inserted into the page as HTML. Colours\\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### The card\\n\\nBefore every round the players get 10 to 30 seconds to learn what comes\\nnext and say when they are ready. By default the hub shows its own card over\\nthe game. A game can make the card its own, as part of the game:\\n\\n140→```js\\nAIHub.connect({ mode, seats, card: true });\\n```\\n\\nThe hub's card then steps aside when the game calls `ready()`, and the game's\\nscreen is the card until `start`. How it looks and sounds is the game's: its\\ntitle, its music, its world, the players lining up. Introduce the game the way\\nit deserves.\\n\\nWhile it is on, the card shows:\\n150→\\n- the game's name;\\n- the players, each in their colour, and which of them are ready;\\n- how to win the round;\\n- the controls this player will use;\\n- the time left, from the `card` event.\\n\\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\\non the card:\\n\\n160→- **Ready**: Enter, Cross (button 0), or a tap on Ready:\\n  `AIHub.answer('ready')`.\\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\\n\\nNothing done on the card changes the round. It has no menus, settings or\\nchoices, and play begins only at `start`. In parallel and ghost it draws no\\nnumbers from `Math.random`, which would change the round's start: use\\n`AIHub.rng('card')`.\\n\\n170→`card` arrives whenever it changes, and every second while the countdown runs:\\n\\n| Field | |\\n|---|---|\\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\\n| `paused` | `true` while most players asked for more time |\\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\\n| `ready` | the ids of the players who are ready |\\n| `asking` | how many players asked for more time (never who) |\\n| `asked` | `true` when this player asked for more time |\\n180→\\n### The start\\n\\n`start` arrives when the round starts. Play begins three seconds later, when\\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\\n`start`.\\n\\n### Reporting\\n\\n190→- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\\n  standing during the round. `score` is a number, higher is ahead; `label` is\\n  text for the hub's scoreboard. The hub takes the latest about once a second.\\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\\n  ghost, once, when the player's round is over. `time` is milliseconds of\\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\\n  by the host only:\\n  - `standings`: arrays of player ids, best first; players in the same array\\n    tie. It lists every player still in the round once; anyone left out is\\n200→    placed last.\\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\\n  - `won` (optional): `true` or `false` when the round is a team result.\\n\\n### Time-up and the end\\n\\n- The hub may call time while the round is still going. On `time-up`, the\\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\\n  `finish()` from the host in a shared world. A shared world with no\\n  `finish()` by then is void.\\n210→- `end` is the last message of a round. After it, the game takes no input and\\n  sends nothing, and its sound stops. The hub shows its results over the\\n  game, then removes it.\\n\\n| `end` reason | |\\n|---|---|\\n| `finished` | the round counted; `standings` is the final order |\\n| `void` | it didn't count (no result, a fatal error, skipped) |\\n| `host-left` | the host of a shared world left |\\n| `sat-out` | this player missed the ready deadline |\\n220→| `session-ended` | the session closed |\\n\\n### Leaving\\n\\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\\n- A parallel or ghost round goes on whoever leaves, the host included.\\n- A shared-world round is void when its host leaves, isn't ready, or has its\\n  tab hidden for more than 20 seconds.\\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\\n230→  of a shared world it voids the round; from any other copy it counts as\\n  that player leaving.\\n\\n### Scoring\\n\\n- Parallel and ghost: players with a `time` rank first, lowest first; then\\n  the rest by `score`. A player with no result is ranked by their last\\n  progress.\\n- Shared world: the host's `standings`. With `won`, the results show a team\\n  result instead of medals.\\n240→- Each player gets one point for every player they beat.\\n\\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\\nresults:\\n\\n- in `result()`: `stats` is `{ name: value }` and `awards` is\\n  `[{ title, detail }]`, for this player;\\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\\n  `[{ id, title, detail }]`, for each player.\\n\\n250→Places and points come only from the standings, `time` and `score`.\\n\\n---\\n\\n## Sending data between copies\\n\\n### Parallel\\n\\nThe copies send nothing to each other. `send()` is not used.\\n\\n260→### Ghost\\n\\nEach copy sends its own player's position and what the player is doing to\\nthe other copies with `send()`. Each copy shows the other players' characters\\nonly while they are in the same area of the game as its own player, and those\\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\\n\\n### Shared world\\n\\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\\n270→  host what their own player does, and show the world the host sends them.\\n- The hub can run the host's copy with no player of its own: `AIHub.server`\\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\\n  the world in that case too, with no local player, camera or input.\\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\\n  every copy.\\n\\n### `send()` and `message`\\n\\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\\n280→  to the one player `to`. It returns `false` when the message is dropped.\\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\\n  sender's player id. A copy never receives its own messages. Messages sent\\n  before another copy has loaded are queued for it.\\n- `data` is JSON, at most 16 KB.\\n- At most 20 messages a second leave each copy, with bursts up to 40; the\\n  client drops the rest.\\n- Reliable messages (the default) arrive in the order they were sent.\\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\\n  unreliable message larger than about 1,200 bytes travels as several packets\\n290→  and is lost whole if any of them is.\\n\\n---\\n\\n## Rules\\n\\nIn a session:\\n\\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\\n  game server or public broker. Loading the game's own files is fine.\\n300→- **No communication between players.** No chat, voice, emotes or custom\\n  names. Names come from the hub.\\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\\n  new tabs or navigating away. Quitting, restarting or returning to a title\\n  screen does nothing; the hub starts and ends rounds.\\n- **Create + Options is the hub's.** On a controller, holding the two\\n  together opens the hub's corner bar; the game ignores Options while Create\\n  is held.\\n\\nEverything on this page applies only in a session (`AIHub.active`). Outside\\n310→one, the game is not affected.\\n\\n---\\n\\n## Test it\\n\\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\\nand runs the checks the hub runs when a game joins the library. Serve it next\\nto the game:\\n\\n320→```bash\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\\npython3 -m http.server 8000\\n```\\n\\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\\nThe hub's own test also runs ghost and shared-world games with\\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\\n330→`&scenario=host-leave`, and shared worlds once more with\\n`&players=2&scenario=server`.\\n\\nThe checklist fills in as it runs. **A game passes when\\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\\n`\\\"true\\\"` at the end. It checks:\\n\\n- the tags, `connect()`, `ready()` with no key press, and the start;\\n- with the game's own card, that Enter answers Ready;\\n- parallel and ghost: `Math.random` the same on every copy, and progress from\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/vendor/hub/README.md\",\"offset\":120,\"limit\":220,\"raw_output\":\"`info` (also on `AIHub` after `connect()`):\\n\\n| Field | |\\n|---|---|\\n| `me` | this copy's player id |\\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\\n\\nNames come from the hub and are never inserted into the page as HTML. Colours\\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### The card\\n\\nBefore every round the players get 10 to 30 seconds to learn what comes\\nnext and say when they are ready. By default the hub shows its own card over\\nthe game. A game can make the card its own, as part of the game:\\n\\n```js\\nAIHub.connect({ mode, seats, card: true });\\n```\\n\\nThe hub's card then steps aside when the game calls `ready()`, and the game's\\nscreen is the card until `start`. How it looks and sounds is the game's: its\\ntitle, its music, its world, the players lining up. Introduce the game the way\\nit deserves.\\n\\nWhile it is on, the card shows:\\n\\n- the game's name;\\n- the players, each in their colour, and which of them are ready;\\n- how to win the round;\\n- the controls this player will use;\\n- the time left, from the `card` event.\\n\\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\\non the card:\\n\\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\\n  `AIHub.answer('ready')`.\\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\\n\\nNothing done on the card changes the round. It has no menus, settings or\\nchoices, and play begins only at `start`. In parallel and ghost it draws no\\nnumbers from `Math.random`, which would change the round's start: use\\n`AIHub.rng('card')`.\\n\\n`card` arrives whenever it changes, and every second while the countdown runs:\\n\\n| Field | |\\n|---|---|\\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\\n| `paused` | `true` while most players asked for more time |\\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\\n| `ready` | the ids of the players who are ready |\\n| `asking` | how many players asked for more time (never who) |\\n| `asked` | `true` when this player asked for more time |\\n\\n### The start\\n\\n`start` arrives when the round starts. Play begins three seconds later, when\\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\\n`start`.\\n\\n### Reporting\\n\\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\\n  standing during the round. `score` is a number, higher is ahead; `label` is\\n  text for the hub's scoreboard. The hub takes the latest about once a second.\\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\\n  ghost, once, when the player's round is over. `time` is milliseconds of\\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\\n  by the host only:\\n  - `standings`: arrays of player ids, best first; players in the same array\\n    tie. It lists every player still in the round once; anyone left out is\\n    placed last.\\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\\n  - `won` (optional): `true` or `false` when the round is a team result.\\n\\n### Time-up and the end\\n\\n- The hub may call time while the round is still going. On `time-up`, the\\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\\n  `finish()` from the host in a shared world. A shared world with no\\n  `finish()` by then is void.\\n- `end` is the last message of a round. After it, the game takes no input and\\n  sends nothing, and its sound stops. The hub shows its results over the\\n  game, then removes it.\\n\\n| `end` reason | |\\n|---|---|\\n| `finished` | the round counted; `standings` is the final order |\\n| `void` | it didn't count (no result, a fatal error, skipped) |\\n| `host-left` | the host of a shared world left |\\n| `sat-out` | this player missed the ready deadline |\\n| `session-ended` | the session closed |\\n\\n### Leaving\\n\\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\\n- A parallel or ghost round goes on whoever leaves, the host included.\\n- A shared-world round is void when its host leaves, isn't ready, or has its\\n  tab hidden for more than 20 seconds.\\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\\n  of a shared world it voids the round; from any other copy it counts as\\n  that player leaving.\\n\\n### Scoring\\n\\n- Parallel and ghost: players with a `time` rank first, lowest first; then\\n  the rest by `score`. A player with no result is ranked by their last\\n  progress.\\n- Shared world: the host's `standings`. With `won`, the results show a team\\n  result instead of medals.\\n- Each player gets one point for every player they beat.\\n\\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\\nresults:\\n\\n- in `result()`: `stats` is `{ name: value }` and `awards` is\\n  `[{ title, detail }]`, for this player;\\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\\n  `[{ id, title, detail }]`, for each player.\\n\\nPlaces and points come only from the standings, `time` and `score`.\\n\\n---\\n\\n## Sending data between copies\\n\\n### Parallel\\n\\nThe copies send nothing to each other. `send()` is not used.\\n\\n### Ghost\\n\\nEach copy sends its own player's position and what the player is doing to\\nthe other copies with `send()`. Each copy shows the other players' characters\\nonly while they are in the same area of the game as its own player, and those\\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\\n\\n### Shared world\\n\\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\\n  host what their own player does, and show the world the host sends them.\\n- The hub can run the host's copy with no player of its own: `AIHub.server`\\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\\n  the world in that case too, with no local player, camera or input.\\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\\n  every copy.\\n\\n### `send()` and `message`\\n\\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\\n  to the one player `to`. It returns `false` when the message is dropped.\\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\\n  sender's player id. A copy never receives its own messages. Messages sent\\n  before another copy has loaded are queued for it.\\n- `data` is JSON, at most 16 KB.\\n- At most 20 messages a second leave each copy, with bursts up to 40; the\\n  client drops the rest.\\n- Reliable messages (the default) arrive in the order they were sent.\\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\\n  unreliable message larger than about 1,200 bytes travels as several packets\\n  and is lost whole if any of them is.\\n\\n---\\n\\n## Rules\\n\\nIn a session:\\n\\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\\n  game server or public broker. Loading the game's own files is fine.\\n- **No communication between players.** No chat, voice, emotes or custom\\n  names. Names come from the hub.\\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\\n  new tabs or navigating away. Quitting, restarting or returning to a title\\n  screen does nothing; the hub starts and ends rounds.\\n- **Create + Options is the hub's.** On a controller, holding the two\\n  together opens the hub's corner bar; the game ignores Options while Create\\n  is held.\\n\\nEverything on this page applies only in a session (`AIHub.active`). Outside\\none, the game is not affected.\\n\\n---\\n\\n## Test it\\n\\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\\nand runs the checks the hub runs when a game joins the library. Serve it next\\nto the game:\\n\\n```bash\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\\npython3 -m http.server 8000\\n```\\n\\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\\nThe hub's own test also runs ghost and shared-world games with\\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\\n`&scenario=host-leave`, and shared worlds once more with\\n`&players=2&scenario=server`.\\n\\nThe checklist fills in as it runs. **A game passes when\\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\\n`\\\"true\\\"` at the end. It checks:\\n\\n- the tags, `connect()`, `ready()` with no key press, and the start;\\n- with the game's own card, that Enter answers Ready;\\n- parallel and ghost: `Math.random` the same on every copy, and progress from\\n\",\"total_lines\":410}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d9fe5318-fbf3-4036-81d7-54904a7c2900-36","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { AmbientLight, DirectionalLight, Scene, Vector3 } from 'three/webgpu';\\nimport { type AssetReader, loadModel } from './assets';\\nimport { AudioManager } from './audio/AudioManager';\\nimport { type CameraConfig, type CameraRig } from './camera';\\nimport { DebugUI } from './DebugUI';\\nimport { type DebugKeyMap, type DebugKeysOption } from './debugKeys';\\nimport { type AspectMode, type Resolution, type Viewport } from './framing';\\nimport { Hud } from './hud/Hud';\\nimport { Input } from './input';\\n10→import { Particles } from './particles/Particles';\\nimport { type TouchButton, TouchControls, type TouchCorner } from './TouchControls';\\nimport { Settings } from './settings';\\nimport { PALETTE } from './palette';\\nimport { Physics } from './physics/Physics';\\nimport { type QualityLevel, type QualityOption } from './quality';\\nimport { type Look } from './render/look';\\nimport { LightPool } from './render/lights';\\nimport { type EdgeSettings, PixelRenderer, type RenderMode } from './render/PixelRenderer';\\nimport type { View } from './render/view';\\n20→import { Rng } from './random';\\nimport { type Recording } from './replay';\\nimport { CameraShake } from './shake';\\nimport { type Snapshot } from './snapshot';\\nimport { Tweens } from './tween';\\nimport type { ScreenFx } from './render/screenFx';\\nexport interface GameContext {\\n    readonly engine: Engine;\\n    readonly scene: Scene;\\n    readonly physics: Physics;\\n30→    readonly input: Input;\\n    readonly camera: CameraRig;\\n    readonly loadModel: typeof loadModel;\\n    readonly palette: typeof PALETTE;\\n    /** Game time in seconds since start. Frozen while paused or loading. */\\n    readonly time: number;\\n    /**\\n     * This level's seeded randomness (src/engine/random.ts): the same engine seed and game give\\n     * the same numbers. Use it (or forks of it) for everything random; never Math.random.\\n     */\\n40→    readonly random: Rng;\\n    /** Sound effects, music, volumes (src/engine/audio). */\\n    readonly audio: AudioManager;\\n    /** Pixel particles: `particles.burst('dust', at)` (src/engine/particles). */\\n    readonly particles: Particles;\\n    /** Pixel HUD text and icons in art pixels (src/engine/hud). */\\n    readonly hud: Hud;\\n    /**\\n     * Dynamic point lights: `lights.request({ position, color, intensity, radius, flicker })`\\n     * (src/engine/render/lights.ts). A fixed pool sized by quality, created on first use.\\n50→     */\\n    readonly lights: LightPool;\\n    /**\\n     * Tweens on game time: `tweens.to(door.position, { y: 3 }, { duration: 0.8, ease: 'outBack' })`\\n     * (src/engine/tween.ts). Cleared when the level unloads.\\n     */\\n    readonly tweens: Tweens;\\n}\\n/**\\n * A game is a plain object. The engine owns rendering, physics stepping, camera,\\n60→ * lighting and debug UI; the game only builds its world and reacts to input.\\n */\\nexport interface Game {\\n    readonly name: string;\\n    /**\\n     * The plain JSON the game was made with, when its name alone can't rebuild it (a lab's depth\\n     * and seed, the door a room was entered by): kept in its recordings (`Recording.args`), so a\\n     * tool can make the same game again to replay one (`npm run replay`, src/games.ts).\\n     */\\n    readonly args?: unknown;\\n70→    /**\\n     * Models `setup` will load (`ctx.loadModel` URLs). Optional: listing them lets the\\n     * engine start downloading while the renderer and physics initialise.\\n     */\\n    readonly assets?: readonly string[];\\n    /** Build the level: load models, add colliders, spawn entities. */\\n    setup(ctx: GameContext): Promise<void> | void;\\n    /** Runs before every fixed 60 Hz physics step. Move characters/apply forces here. */\\n    fixedUpdate?(ctx: GameContext, dt: number): void;\\n    /**\\n80→     * Runs when the engine starts running this game: after `Engine.start` (just before\\n     * `__PIXEL_READY__` resolves) and after each `loadGame`. Install page handles for tools here\\n     * (`window.__MYGAME__`), so they never exist before the engine can step. An exception is\\n     * reported like any hook's (`engine.errors`, on screen); the game runs on.\\n     */\\n    ready?(ctx: GameContext): void;\\n    /** Runs once per rendered frame after physics (animation, pickups, UI state). */\\n    update?(ctx: GameContext, dt: number): void;\\n    /** World position the camera follows. */\\n    cameraTarget(ctx: GameContext): Vector3;\\n90→    /** First-person eye position (defaults to cameraTarget + 0.7 up). */\\n    eyePosition?(ctx: GameContext): Vector3;\\n    /** One-line status for the debug UI (score, lives...). */\\n    status?(ctx: GameContext): string;\\n    /**\\n     * The game's own state as a short string or hash, for `engine.fingerprint()`: what lives\\n     * outside physics and `ctx.random` (positions, life, counters, the game's own random\\n     * streams), so two runs that should match (a replay) can be compared. Only what a replay must\\n     * reproduce: no timings or measurements.\\n     */\\n100→    fingerprint?(ctx: GameContext): string;\\n    /**\\n     * The game's own state as plain data, between frames (`engine.snapshot()`): everything a\\n     * later frame reads that the engine does not keep (its entities, timers, random streams; the\\n     * handles of its physics bodies). With `restore`, the game has save-states.\\n     */\\n    snapshot?(ctx: GameContext): unknown;\\n    /**\\n     * Put the game back to what `snapshot` returned (`engine.restore()`): the same game, already\\n     * set up. Find physics bodies again by handle (`ctx.physics.world.getRigidBody(h)`).\\n110→     */\\n    restore?(ctx: GameContext, state: unknown): void | Promise<void>;\\n    /**\\n     * Optional: leave whatever mode the game is in before a restore changes anything (a mode\\n     * with a camera of its own, a dialog, a level): `engine.restore()` calls it first, then checks\\n     * the snapshot fits (the camera preset) and puts the engine's part back, then `restore`.\\n     */\\n    beforeRestore?(ctx: GameContext): void | Promise<void>;\\n    /**\\n     * Called after `engine.setCamera()` swapped the camera preset mid-game. The world,\\n120→     * physics and player are untouched; adjust anything that depends on the preset\",\"content_concise\":\"1→import { AmbientLight, DirectionalLight, Scene, Vector3 } from 'three/webgpu';\\nimport { type AssetReader, loadModel } from './assets';\\nimport { AudioManager } from './audio/AudioManager';\\nimport { type CameraConfig, type CameraRig } from './camera';\\nimport { DebugUI } from './DebugUI';\\nimport { type DebugKeyMap, type DebugKeysOption } from './debugKeys';\\nimport { type AspectMode, type Resolution, type Viewport } from './framing';\\nimport { Hud } from './hud/Hud';\\nimport { Input } from './input';\\n10→import { Particles } from './particles/Particles';\\nimport { type TouchButton, TouchControls, type TouchCorner } from './TouchControls';\\nimport { Settings } from './settings';\\nimport { PALETTE } from './palette';\\nimport { Physics } from './physics/Physics';\\nimport { type QualityLevel, type QualityOption } from './quality';\\nimport { type Look } from './render/look';\\nimport { LightPool } from './render/lights';\\n