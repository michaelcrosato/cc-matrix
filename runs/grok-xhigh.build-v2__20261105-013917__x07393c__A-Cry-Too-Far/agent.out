nst jamP = this.noJam ? 0 : TUNING.jamRate * 0.12 * (1 - gun.cond / 100) ** 2;\\n    const script = this.jamScript && gun.shots >= this.jamScript;\\n    if (script || this.rng.next() < jamP) {\\n      gun.jammed = true;\\n      gun.jamLeft = 2 + Math.floor(this.rng.next() * 3);\\n      if (script) this.jamScript = 0;\\n    }\\n    this.resolveShot(def);\\n    this.provoked = true;\\n  }\\n\\n  breakGun() {\\n    const gun = this.weapon;\\n    if (!gun) return;\\n    this.guns.splice(this.slot, 1);\\n    this.slot = Math.max(0, this.guns.length - 1);\\n    this.subtitle = 'THE GUN COMES APART.';\\n  }\\n\\n  resolveShot(def) {\\n    const p = this.feet();\\n    const yaw = this.ctx.camera.yaw || 0;\\n    const dx = -Math.sin(yaw);\\n    const dz = -Math.cos(yaw);\\n    const range = def.range || 40;\\n    if (def.ignite || def.blast) {\\n      const x = p.x + dx * Math.min(range, 18);\\n      const z = p.z + dz * Math.min(range, 18);\\n      const r = def.ignite || def.blast || 1;\\n      this.fire.ignite(x, z, r);\\n      this.linkSpark = { x, z, r };\\n\",\"total_lines\":1532}}","is_error":false},{"type":"tool_result","tool_use_id":"call-df04fb74-cdb8-4117-81e0-06bfd572c3aa-28","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"448→\\n  toTitle() {\\n450→    this.mode = 'title';\\n    this.screen = 'title';\\n    this.focus = 0;\\n    this.ending = null;\\n    this.session = null;\\n    this.round = null;\\n    this.ended = false;\\n    if (this.world) {\\n      this.world.round = null;\\n      this.world.keepCivilians();\\n460→      this.world.dead = false;\\n      this.world.rescueT = 0;\\n      this.world.surgeryT = 0;\\n      if (this.world.hp <= 0) this.world.hp = 40;\\n    }\\n    this.idle = 0;\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    setWantLock(false);\\n    this.playSong('title');\\n  }\\n470→\\n  startSolo() {\\n    const session = soloSession(this.ctx.random.fork('solo'));\\n    this.session = session;\\n    this.bindSession(session);\\n    this.beginRound();\\n  }\\n\\n  startLink(role) {\\n    const session = linkSession(role === 'host' ? 'host' : 'join', this.ctx.random.fork('link'));\\n480→    this.session = session;\\n    this.bindSession(session);\\n    if (session.isHost) {\\n      session.post?.({ t: 'start', seed: this.ctx.random.state || 1 });\\n      this.beginRound();\\n    }\\n  }\\n\",\"content_concise\":\"448→\\n  toTitle() {\\n450→    this.mode = 'title';\\n    this.screen = 'title';\\n    this.focus = 0;\\n    this.ending = null;\\n    this.session = null;\\n    this.round = null;\\n    this.ended = false;\\n    if (this.world) {\\n      this.world.round = null;\\n      this.world.keepCivilians();\\n460→      this.world.dead = false;\\n      this.world.rescueT = 0;\\n      this.world.surgeryT = 0;\\n      if (this.world.hp <= 0) this.world.hp = 40;\\n    }\\n    this.idle = 0;\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    setWantLock(false);\\n    this.playSong('title');\\n  }\\n470→\\n  startSolo() {\\n    const session = soloSession(this.ctx.random.fork('solo'));\\n    this.session = session;\\n    this.bindSession(session);\\n    this.beginRound();\\n  }\\n\\n  startLink(role) {\\n    const session = linkSession(role === 'host' ? 'host' : 'join', this.ctx.random.fork('link'));\\n480→    this.session = session;\\n    this.bindSession(session);\\n    if (session.isHost) {\\n      session.post?.({ t: 'start', seed: this.ctx.random.state || 1 });\\n      this.beginRound();\\n    }\\n  }\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/game.js\",\"offset\":448,\"limit\":40,\"raw_output\":\"\\n  toTitle() {\\n    this.mode = 'title';\\n    this.screen = 'title';\\n    this.focus = 0;\\n    this.ending = null;\\n    this.session = null;\\n    this.round = null;\\n    this.ended = false;\\n    if (this.world) {\\n      this.world.round = null;\\n      this.world.keepCivilians();\\n      this.world.dead = false;\\n      this.world.rescueT = 0;\\n      this.world.surgeryT = 0;\\n      if (this.world.hp <= 0) this.world.hp = 40;\\n    }\\n    this.idle = 0;\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    setWantLock(false);\\n    this.playSong('title');\\n  }\\n\\n  startSolo() {\\n    const session = soloSession(this.ctx.random.fork('solo'));\\n    this.session = session;\\n    this.bindSession(session);\\n    this.beginRound();\\n  }\\n\\n  startLink(role) {\\n    const session = linkSession(role === 'host' ? 'host' : 'join', this.ctx.random.fork('link'));\\n    this.session = session;\\n    this.bindSession(session);\\n    if (session.isHost) {\\n      session.post?.({ t: 'start', seed: this.ctx.random.state || 1 });\\n      this.beginRound();\\n    }\\n  }\\n\\n\",\"total_lines\":781}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"4ad41b85-d2a5-4f83-b96c-074f100e317d"}
