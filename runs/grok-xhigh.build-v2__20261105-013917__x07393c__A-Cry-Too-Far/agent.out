\n    const c = this.cellAt(x, z);\\n    if (!c) return 0;\\n    const r = Math.max(0, radius);\\n    const reach = Math.ceil(r / FIRE_CELL);\\n    let n = 0;\\n    for (let dz = -reach; dz <= reach; dz++) {\\n      for (let dx = -reach; dx <= reach; dx++) {\\n        const ix = c.ix + dx;\\n        const iz = c.iz + dz;\\n        if (ix < 0 || iz < 0 || ix >= FIRE_N || iz >= FIRE_N) continue;\\n        if (r > 0) {\\n          const [cx, cz] = this.center(ix, iz);\\n          if (Math.hypot(cx - x, cz - z) > r + FIRE_CELL * 0.5) continue;\\n        }\\n        if (this.lightIndex(this.idx(ix, iz))) n++;\\n      }\\n    }\\n    return n;\\n  }\\n\\n  lightIndex(i) {\\n    if (!this.canBurn(i)) return false;\\n    const fuel = this.fuel[i];\\n    const span = fuel === 1 ? 8 + this.rng.next() * 6\\n      : fuel === 2 ? 12 + this.rng.next() * 6\\n        : 30 + this.rng.next() * 10;\\n    this.state[i] = 1;\\n    this.burnEnd[i] = this.time + span;\\n    this.burning.push(i);\\n    return true;\\n  }\\n\\n  /** Quiet story scar. Burns the strip immediately to state burnt. */\\n  burnStrip(points, width) {\\n    const half = width * 0.5;\\n    for (let i = 1; i < points.length; i++) {\\n      const [x0, z0] = points[i - 1];\\n      const [x1, z1] = points[i];\\n      const len = Math.hypot(x1 - x0, z1 - z0) || 1;\\n      const steps = Math.ceil(len / 4);\\n      for (let s = 0; s <= steps; s++) {\\n        const t = s / steps;\\n        const x = x0 + (x1 - x0) * t;\\n        const z = z0 + (z1 - z0) * t;\\n        const c = this.cellAt(x, z);\\n        if (!c) continue;\\n        const reach = Math.ceil(half / FIRE_CELL);\\n        for (let dz = -reach; dz <= reach; dz++) {\\n          for (let dx = -reach; dx <= reach; dx++) {\\n            const ix = c.ix + dx;\\n            const iz = c.iz + dz;\\n            if (ix < 0 || iz < 0 || ix >= FIRE_N || iz >= FIRE_N) continue;\\n            const [cx, cz] = this.center(ix, iz);\\n            if (Math.hypot(cx - x, cz - z) > half) continue;\\n            const i = this.idx(ix, iz);\\n            if (this.fuel[i] === 0 || this.state[i] === 2 || this.state[i] === 3) continue;\\n            if (this.state[i] === 1) {\\n              this.state[i] = 2;\\n              this.burntAt[i] = this.time;\\n              this.burntCount++;\\n              this.onBurnt(ix, iz, i);\\n            } else if (this.state[i] === 0) {\\n              this.state[i] = 2;\\n              this.burntAt[i] = this.time;\\n              this.burntCount++;\\n              this.onBurnt(ix, iz, i);\\n            }\\n          }\\n        }\\n      }\\n    }\\n    this.burning = this.burning.filter((i) => this.state[i] === 1);\\n  }\\n\\n  step(dt) {\\n    this.time += dt;\\n    this.acc += dt;\\n    let guard = 0;\\n    while (this.acc >= 0.25 && guard++ < 6) {\\n      this.acc -= 0.25;\\n      this.spread();\\n    }\\n    this.regrow();\\n  }\\n\\n  spread() {\\n    const next = [];\\n    const wx = this.wind.x;\\n    const wz = this.wind.z;\\n    const wsp = this.wind.speed;\\n    const wlen = Math.hypot(wx, wz) || 1;\\n    const ux = wx / wlen;\\n    const uz = wz / wlen;\\n    const fresh = [];\\n    for (const i of this.burning) {\\n      if (this.state[i] !== 1) continue;\\n      if (this.time >= this.burnEnd[i]) {\\n        this.state[i] = 2;\\n        this.burntAt[i] = this.time;\\n        this.burntCount++;\\n        const ix = i % FIRE_N;\\n        const iz = (i / FIRE_N) | 0;\\n        this.onBurnt(ix, iz, i);\\n        continue;\\n      }\\n      next.push(i);\\n      const ix = i % FIRE_N;\\n      const iz = (i / FIRE_N) | 0;\\n      const h = this.heightAt(...this.center(ix, iz));\\n      for (const [dx, dz] of NBR) {\\n        const nx = ix + dx;\\n        const nz = iz + dz;\\n        if (nx < 0 || nz < 0 || nx >= FIRE_N || nz >= FIRE_N) continue;\\n        const j = this.idx(nx, nz);\\n        if (!this.canBurn(j)) continue;\\n        const len = Math.hypot(dx, dz);\\n        const cos = (dx / len) * ux + (dz / len) * uz;\\n        const windFactor = clamp(1 + TUNING.windEffect * (wsp / 5) * 1.6 * cos, 0.15, 3.5);\\n        if (dx === 1 && dz === 0) this.lastWindFactor = windFactor;\\n        const nh = this.heightAt(...this.center(nx, nz));\\n        const slopeFactor = nh > h + 0.4 ? 1.4 : nh < h - 0.4 ? 0.7 : 1;\\n        const rainFactor = this.rain ? 0.15 : 1;\\n        const diag = dx !== 0 && dz !== 0 ? 1.41 : 1;\\n        const p = BASE_P * (FUEL_FACTOR[this.fuel[j]] || 0) * windFactor * slopeFactor * rainFactor * TUNING.fireSpread / diag;\\n        if (this.rng.next() < p) fresh.push(j);\\n      }\\n      if (wsp > 6 && this.rng.next() < 0.04 * TUNING.fireSpread) {\\n        const hop = 2 + (this.rng.next() < 0.5 ? 0 : 1);\\n        const ex = ix + Math.round(ux * hop);\\n        const ez = iz + Math.round(uz * hop);\\n        if (ex >= 0 && ez >= 0 && ex < FIRE_N && ez < FIRE_N) fresh.push(this.idx(ex, ez));\\n      }\\n    }\\n    this.burning = next;\\n    for (const j of fresh) this.lightIndex(j);\\n  }\\n\\n  regrow() {\\n    const hours = this.time / 3600;\\n    if (TUNING.regrowHours <= 0) return;\\n    for (let i = 0; i < this.state.length; i++) {\\n      if (this.state[i] !== 2) continue;\\n      const ageH = (this.time - this.burntAt[i]) / 3600;\\n      if (ageH >= TUNING.regrowHours) {\\n        this.state[i] = 3;\\n        this.burntCount = Math.max(0, this.burntCount - 1);\\n      }\\n    }\\n    void hours;\\n  }\\n\\n  /** Day roll: regrowth becomes fresh fuel at half spread weight. */\\n  dayRoll() {\\n    for (let i = 0; i < this.state.length; i++) {\\n      if (this.state[i] === 3) {\\n        this.state[i] = 0;\\n        if (this.fuel[i] > 1) this.fuel[i] = 1;\\n      }\\n    }\\n  }\\n\\n  extinguish() {\\n    for (const i of this.burning) {\\n      if (this.state[i] === 1) this.state[i] = 0;\\n    }\\n    this.burning.length = 0;\\n  }\\n\\n  /** Run-length encode state for the save. */\\n  encode() {\\n    const out = [];\\n    let prev = this.state[0];\\n    let n = 1;\\n    for (let i = 1; i <= this.state.length; i++) {\\n      if (i < this.state.length && this.state[i] === prev && n < 65535) n++;\\n      else {\\n        out.push(prev, n);\\n        prev = this.state[i];\\n        n = 1;\\n      }\\n    }\\n    return out;\\n  }\\n\\n  decode(runs) {\\n    this.state.fill(0);\\n    this.burning.length = 0;\\n    this.burntCount = 0;\\n    let at = 0;\\n    for (let i = 0; i < runs.length; i += 2) {\\n      const v = runs[i];\\n      const n = runs[i + 1];\\n      for (let k = 0; k < n && at < this.state.length; k++, at++) this.state[at] = v;\\n    }\\n    for (let i = 0; i < this.state.length; i++) {\\n      if (this.state[i] === 1) this.burning.push(i);\\n      if (this.state[i] === 2) this.burntCount++;\\n    }\\n  }\\n\\n  counts() {\\n    return { burning: this.burning.length, burnt: this.burntCount };\\n  }\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"24ef43c9-de09-44dd-8933-6d297b2624a3"}
{"type":"assistant","message":{"id":"msg_27","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Calibrating fire speed with a quick script. Starting to write more content files.","signature":""},{"type":"tool_use","id":"call-4f7a230d-ee73-4070-afe7-9f683bfa551c-58","name":"run_terminal_command","input":{"command":"cd \"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917\" && node --input-type=module -e '\nimport { FireGrid } from \"./src/world/fire.js\";\nimport { Rng } from \"./pixel-engine.js\";\nfunction measure(speed, seconds=8) {\n  const rng = new Rng(\"fire-cal\");\n  const f = new FireGrid(rng);\n  f.fill(1);\n  f.wind = { x: 1, z: 0, speed };\n  // wide line perpendicular to +x wind\n  for (let iz = 108; iz <= 148; iz++) f.ignite(-640 + (100+0.5)*5, -640 + (iz+0.5)*5, 0);\n  const steps = Math.round(seconds / (1/60));\n  for (let i = 0; i < steps; i++) f.step(1/60);\n  let maxIx = 100, minIz = 108, maxIz = 148;\n  for (let i = 0; i < f.state.length; i++) {\n    if (f.state[i] === 0) continue;\n    const ix = i % 256, iz = (i/256)|0;\n    if (ix > maxIx) maxIx = ix;\n    if (iz < minIz) minIz = iz;\n    if (iz > maxIz) maxIz = iz;\n  }\n  const head = (maxIx - 100) * 5 / seconds;\n  const flank = Math.max(108 - minIz, maxIz - 148) * 5 / seconds;\n  return { head, flank, burning: f.burning.length, burnt: f.burntCount, maxIx };\n}\nfor (const s of [0, 5, 8]) console.log(s, measure(s));\n'","description":"Calibrate grass-fire head speed"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4947,"output_tokens":581,"cache_read_input_tokens":148736,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"b9addf83-7b54-4683-9af7-4d25dd31cf42"}
