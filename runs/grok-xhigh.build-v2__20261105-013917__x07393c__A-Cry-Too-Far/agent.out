input, 'fire');\"},{\"line_number\":1237,\"content\":\"    const pressed = consumeAction(input, 'use');\"},{\"line_number\":1377,\"content\":\"    if (buddy && consumeAction(input, 'melee')) {\"},{\"line_number\":1382,\"content\":\"    if (consumeAction(input, 'reload') || (!this.wantsUse() && consumeAction(input, 'use'))) this.tryReload();\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/game.js\",\"matches\":[{\"line_number\":23,\"content\":\"function pressed(input, codes) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"28468d28-2b07-4738-9cc1-ddbec09556c4"}
