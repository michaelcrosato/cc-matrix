02,105,108,101,58,47,47,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,47,65,37,50,48,67,114,121,37,50,48,84,111,111,37,50,48,70,97,114,45,70,97,114,37,50,48,67,114,121,37,50,48,50,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,47,116,101,115,116,115,47,114,117,110,46,109,106,115,58,54,50,56,58,53,10,112,97,115,115,101,100,32,57,32,102,97,105,108,101,100,32,49,10],\"output_for_prompt\":\"exit: 1\\nFAIL menus attract pause touch\\nError: attract did not start idle 0.44999999999999996 ended false scale 0 mode gameover screen gameover\\n    at assert (file:///home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A%20Cry%20Too%20Far-Far%20Cry%202-grok-4.7-xhigh-20261105-013917/tests/run.mjs:27:20)\\n    at Object.fn (file:///home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A%20Cry%20Too%20Far-Far%20Cry%202-grok-4.7-xhigh-20261105-013917/tests/run.mjs:562:3)\\n    at async file:///home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A%20Cry%20Too%20Far-Far%20Cry%202-grok-4.7-xhigh-20261105-013917/tests/run.mjs:628:5\\npassed 9 failed 1\\n\",\"exit_code\":1,\"command\":\"cd \\\"A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917\\\" && node tests/run.mjs --all\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"See why attract stays idle after solo\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261105-013917__x07393c%2Fwork/01a1aadc-c537-7073-8756-0b078a9e97df/terminal/call-1ddbbbb6-24cb-4402-987e-dd7b980af60a-7