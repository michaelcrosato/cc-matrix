, faction: 'harvest', n: 5 },\\n  { id: 'p6', name: 'SALT ROAD', x: 300, z: 390, faction: 'harvest', n: 4 },\\n];\\n\\nexport const TRIGS = [\\n  { id: 't1', name: 'RIDGE TRIG', x: -130, z: -500 },\\n  { id: 't2', name: 'WEST TRIG', x: -400, z: -40 },\\n  { id: 't3', name: 'EAST TRIG', x: 280, z: 40 },\\n  { id: 't4', name: 'MERCY TRIG', x: -40, z: 280 },\\n  { id: 't5', name: 'GRANARY TRIG', x: 460, z: 180 },\\n  { id: 't6', name: 'CUT TRIG', x: 60, z: -420 },\\n];\\n\\nexport const CASES = [\\n  { id: 'c1', x: -80, z: -40, stones: 3 },\\n  { id: 'c2', x: 210, z: 20, stones: 4 },\\n  { id: 'c3', x: -300, z: -240, stones: 5 },\\n  { id: 'c4', x: 360, z: -40, stones: 2 },\\n  { id: 'c5', x: 40, z: 300, stones: 6 },\\n  { id: 'c6', x: -180, z: 180, stones: 3 },\\n  { id: 'c7', x: 500, z: 40, stones: 4 },\\n  { id: 'c8', x: -480, z: -300, stones: 5 },\\n  { id: 'c9', x: 140, z: 420, stones: 2 },\\n  { id: 'c10', x: 20, z: -360, stones: 4 },\\n  { id: 'c11', x: 300, z: -300, stones: 3 },\\n  { id: 'c12', x: -90, z: 420, stones: 6 },\\n];\\n\\nexport const HALTS = [\\n  { id: 'west-cutting', name: 'WEST CUTTING', x: -400, z: 100 },\\n  { id: 'mile-halt', name: 'MILE FORTY HALT', x: 0, z: 70 },\\n  { id: 'east-halt', name: 'EAST SIDING HALT', x: 430, z: -60 },\\n  { id: 'cut-spur', name: 'CUT SPUR', x: 180, z: -220 },\\n];\\n\\n/** Story scars. Burned grass cannot burn twice, so the column can walk them. */\\nexport const STRIPS = {\\n  A: { width: 30, points: [[430, -60], [320, -150], [220, -230], [150, -300]] },\\n  C: { width: 26, points: [[90, -280], [150, -300], [230, -290]] },\\n  B: { width: 30, points: [[150, -300], [-40, -310], [-260, -300], [-420, -370], [-590, -430]] },\\n};\\n\\nexport function siteById(id) {\\n  return SITES.find((s) => s.id === id) || POSTS.find((s) => s.id === id) || HALTS.find((s) => s.id === id) || null;\\n}\\n\",\"total_lines\":72}}","is_error":false},{"type":"tool_result","tool_use_id":"call-be1aaa79-5e64-4228-bf97-e1e5f8831cd1-22","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→  ground(x, z) {\\n    if (this.land) return this.land.heightAt(x, z);\\n    if (this.heights) return this.heights(x, z);\\n    return 40;\\n  }\\n\\n  feet() {\\n    if (this.inVehicle && this.car) {\\n      const t = this.car.body.translation();\\n      return { x: t.x, y: t.y, z: t.z };\\n150→    }\\n    const f = this.hero.feet;\\n    return { x: f.x, y: f.y, z: f.z };\\n  }\\n\\n  spawnTown() {\\n    const y = this.ground(12, 55);\\n    addBlock(this.ctx, 12, y + 1.2, 55, 6, 2.4, 4, PALETTE.white);\\n    addBlock(this.ctx, -18, this.ground(-18, 62) + 1.1, 62, 5, 2.2, 4, PALETTE.orange);\\n    addBlock(this.ctx, 0, this.ground(0, 70) + 0.4, 70, 14, 0.4, 4, PALETTE.slate);\\n160→    this.props.push({ tag: 'ledger-book', x: 168, z: -286, alive: true });\\n    this.props.push({ tag: 'cage', x: 40, z: -164, alive: true });\\n    this.props.push({ tag: 'pump', x: -330, z: 395, alive: true });\\n    for (const [x, z] of [[410, -50], [440, -70], [455, -45]]) {\\n      this.props.push({ tag: 'fuel-tank', x, z, alive: true });\\n      addBlock(this.ctx, x, this.ground(x, z) + 1.5, z, 2.2, 3, 2.2, PALETTE.slate);\\n    }\\n    this.props.push({ tag: 'convoy', x: 220, z: 450, alive: true, hp: 80 });\\n    this.props.push({ tag: 'payroll', x: 220, z: 450, alive: true, hidden: true });\\n    this.actors.push({\\n170→      id: 'civil-1', kind: 'civil', x: -250, z: 230, hp: 40, alive: true, faction: 'civil', fleeing: false,\\n    });\\n  }\\n\\n  paintMapBase() {\\n    const px = this.mapPx;\\n    px.fill(0);\\n    for (let i = 0; i < 320 * 240; i++) {\\n      px[i * 4] = 196;\\n      px[i * 4 + 1] = 154;\\n180→      px[i * 4 + 2] = 96;\\n      px[i * 4 + 3] = 255;\\n    }\\n  }\\n\\n  worldToMap(x, z) {\\n    const mx = Math.floor(((x + 640) / 1280) * 300) + 8;\\n    const my = Math.floor(((z + 640) / 1280) * 220) + 8;\\n    return [mx, my];\\n  }\\n190→\\n  stamp(x, z, r, g, b) {\\n    const [mx, my] = this.worldToMap(x, z);\\n    if (mx < 0 || my < 0 || mx >= 320 || my >= 240) return;\\n    const i = (mx + my * 320) * 4;\\n    this.mapPx[i] = r;\\n    this.mapPx[i + 1] = g;\\n    this.mapPx[i + 2] = b;\\n    this.mapPx[i + 3] = 255;\\n  }\\n200→\\n  refreshMap() {\\n    const fire = this.fire;\\n    if (this.scarTick === this._scarDrawn) {\\n      const p = this.feet();\\n      this.stamp(p.x, p.z, 240, 240, 240);\\n      return;\\n    }\\n    this._scarDrawn = this.scarTick;\\n    for (const i of fire.burntList) {\\n210→      const ix = i % 256;\\n      const iz = (i / 256) | 0;\\n      const [x, z] = fire.center(ix, iz);\\n      this.stamp(x, z, 30, 28, 36);\\n    }\\n    const p = this.feet();\\n    this.stamp(p.x, p.z, 240, 240, 240);\\n  }\\n\\n  mapHasScar() {\\n220→    for (let i = 0; i < this.mapPx.length; i += 4) {\\n      if (this.mapPx[i] < 40 && this.mapPx[i + 1] < 40 && this.mapPx[i + 2] < 50 && this.mapPx[i + 3] > 0) return true;\\n    }\\n    return false;\\n  }\\n\\n  markSeen() {\\n    const p = this.feet();\\n    for (const s of SITES) if (Math.hypot(s.x - p.x, s.z - p.z) < 90) this.seen.add(s.id);\\n  }\\n230→\\n  resetDynamic() {\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.actors.length = 0;\\n    this.props.length = 0;\\n    this.dead = false;\\n240→    this.carrying = null;\\n    this.inVehicle = false;\\n    this.mission = null;\\n    this.lines = [];\\n    this.choice = null;\\n    this.subtitle = '';\\n    this.feverOn = false;\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.ending = null;\\n250→    this.sheet = null;\\n    this.spawnTown();\\n  }\\n\\n  teleport(x, z) {\\n    const y = this.ground(x, z) + 0.1;\\n    if (this.inVehicle && this.car) this.car.reset([x, y + 1, z], this.car.yaw);\\n    else this.hero.teleport([x, y, z]);\\n    this.markSeen();\\n  }\",\"content_concise\":\"140→  ground(x, z