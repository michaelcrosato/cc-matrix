":\"      this.subtitle = line('buddy:rescue');\"},{\"line_number\":324,\"content\":\"    this.feverOn = false;\"},{\"line_number\":569,\"content\":\"    this.tickFever(dt);\"},{\"line_number\":589,\"content\":\"  tickFever(dt) {\"},{\"line_number\":591,\"content\":\"    if (!this.feverOn) {\"},{\"line_number\":594,\"content\":\"        this.feverOn = true;\"},{\"line_number\":603,\"content\":\"        this.feverOn = false;\"},{\"line_number\":615,\"content\":\"    this.feverOn = false;\"},{\"line_number\":672,\"content\":\"        this.fire.ignite(a.x, a.z, 0);\"},{\"line_number\":740,\"content\":\"    if (this.rescueT > 0) {\"},{\"line_number\":741,\"content\":\"      this.rescueT -= dt;\"},{\"line_number\":742,\"content\":\"      if (this.rescueT <= 0 && this.rescueBuddy) {\"},{\"line_number\":743,\"content\":\"        const mags = this.rescueBuddy.id === 'mags';\"},{\"line_number\":745,\"content\":\"        this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60;\"},{\"line_number\":747,\"content\":\"          this.rescueBuddy.wound = true;\"},{\"line_number\":748,\"content\":\"          this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60 * 2;\"},{\"line_number\":750,\"content\":\"        this.rescueBuddy = null;\"},{\"line_number\":768,\"content\":\"    if (this.dead && this.rescueT <= 0) return;\"},{\"line_number\":786,\"content\":\"    if (this.rescueT > 0) return;\"},{\"line_number\":849,\"content\":\"        this.fire.ignite(t.x, t.z, 6);\"},{\"line_number\":869,\"content\":\"    if (this.feverOn && (heldAction(input, 'tablet') || input.isDown('KeyH'))) {\"},{\"line_number\":949,\"content\":\"    if (def.ignite || def.blast) {\"},{\"line_number\":952,\"content\":\"      this.fire.ignite(x, z, def.ignite || def.blast || 1);\"},{\"line_number\":1037,\"content\":\"    this.fire.ignite(prop.x, prop.z, 4);\"},{\"line_number\":1211,\"content\":\"    if (this.feverOn && this.tablets > 0) {\"}]}]}","is_error":false}]},"parent_tool_use_id":nu