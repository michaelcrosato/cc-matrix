kRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if (this.round) this.round.tick(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n730→\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\\n    this.windSpeed = clamp(this.windSpeed + (this.rng.next() - 0.5) * dt * 0.15, 0, 8);\\n  }\\n\\n  tickFever(dt) {\\n    if (this.game.mode !== 'play' && this.game.mode !== 'attract') return;\\n740→    if (!this.feverOn) {\\n      this.feverT -= dt;\\n      if (this.feverT <= 0) {\\n        this.feverOn = true;\\n        this.feverIgnore = 0;\\n        this.subtitle = line('fever');\\n      }\\n      return;\\n    }\\n    if (this.feverClear > 0) {\\n750→      this.feverClear -= dt;\\n      if (this.feverClear <= 0) {\\n        this.feverOn = false;\\n        const shrink = this.flags.has('m7') ? 2 : this.flags.has('m3') ? 1 : 0;\\n        const mins = Math.max(2, TUNING.feverMinutes - shrink);\\n        this.feverT = mins * 60;\\n      }\\n      return;\\n    }\\n    this.feverIgnore += dt;\",\"content_concise\":\"680→  moveVillage() {\\n    if (this.movedOnce) return;\\n    this.movedOnce = true;\\n    this.ledger.moved += this.civilians;\\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\\n  }\\n\\n  ensureTruck(x, z) {\\n    if (this.car) return;\\n    const y = this.ground(x, z) + 1.2;\\n690→    this.car = new Vehicle(this.ctx.physics, {\\n      at: [x, y, z],\\n      yaw: Math.PI,\\n      size: [0.95, 0.45, 2.2],\\n      mass: 12,\\n      power: 160,\\n      topSpeed: TUNING.vehicleTopSpeed,\\n      wheelRadius: 0.42,\\n      suspension: 0.45,\\n      stiffness: 30,\\n700→      grip: 2.6,\\n    });\\n    this.vehicleHp = 100;\\n    this.vehicleKind = 'pickup';\\n    this.truckX = x;\\n    this.truckZ = z;\\n  }\\n\\n  fixed(dt) {\\n    this.clock += dt;\\n710→    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\\n    this.hour = ((this.gameHours % 24) + 24) % 24;\\n    this.stepWind(dt);\\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\\n    this.fire.rain = this.rain;\\n    this.fire.step(dt);\\n    if (this.game.blocksSim()) return;\\n    this.tickFever(dt);\\n720→    this.tickBurn(dt);\\n    this.tickRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if (this.round) this.round.tick(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n730→\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\\n    this.windSpeed = clamp(this.windSpeed + (this.rng.next() - 0.5) * dt * 0.15, 0, 8);\\n  }\\n\\n  tickFever(dt) {\\n    if (this.game.mode !== 'play' && this.game.mode !== 'attract') return;\\n740→    if (!this.feverOn) {\\n      this.feverT -= dt;\\n      if (this.feverT <= 0) {\\n        this.feverOn = true;\\n        this.feverIgnore = 0;\\n        this.subtitle = line('fever');\\n      }\\n      return;\\n    }\\n    if (this.feverClear > 0) {\\n750→      this.feverClear -= dt;\\n      if (this.feverClear <= 0) {\\n        this.feverOn = false;\\n        const shrink = this.flags.has('m7') ? 2 : this.flags.has('m3') ? 1 : 0;\\n        const mins = Math.max(2, TUNING.feverMinutes - shrink);\\n        this.feverT = mins * 60;\\n      }\\n      return;\\n    }\\n    this.feverIgnore += dt;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\