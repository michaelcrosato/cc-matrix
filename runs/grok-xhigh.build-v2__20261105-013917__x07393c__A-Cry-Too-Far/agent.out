59,10,49,53,54,58,32,32,32,32,97,100,100,66,108,111,99,107,40,116,104,105,115,46,99,116,120,44,32,45,49,56,44,32,116,104,105,115,46,103,114,111,117,110,100,40,45,49,56,44,32,54,50,41,32,43,32,49,46,49,44,32,54,50,44,32,53,44,32,50,46,50,44,32,52,44,32,116,104,105,115,46,99,116,120,46,112,97,108,101,116,116,101,46,111,114,97,110,103,101,41,59,10,49,53,55,58,32,32,32,32,97,100,100,66,108,111,99,107,40,116,104,105,115,46,99,116,120,44,32,48,44,32,116,104,105,115,46,103,114,111,117,110,100,40,48,44,32,55,48,41,32,43,32,48,46,52,44,32,55,48,44,32,49,52,44,32,48,46,52,44,32,52,44,32,116,104,105,115,46,99,116,120,46,112,97,108,101,116,116,101,46,115,108,97,116,101,41,59,10,49,54,51,58,32,32,32,32,32,32,97,100,100,66,108,111,99,107,40,116,104,105,115,46,99,116,120,44,32,120,44,32,116,104,105,115,46,103,114,111,117,110,100,40,120,44,32,122,41,32,43,32,49,46,53,44,32,122,44,32,50,46,50,44,32,51,44,32,50,46,50,44,32,116,104,105,115,46,99,116,120,46,112,97,108,101,116,116,101,46,115,108,97,116,101,41,59,10],\"output_for_prompt\":\"exit: 0\\n 1199 src/sim/world.js\\n  156 src/world/terrain.js\\n  276 src/world/fire.js\\n   99 src/content/dialogue.js\\n  185 src/content/missions.js\\n   63 src/content/roads.js\\n   72 src/content/sites.js\\n   57 src/content/title.js\\n   48 src/content/tuning-defaults.js\\n   42 src/content/weapons.js\\n   49 src/core/actions.js\\n   47 src/core/look.js\\n   48 src/core/save.js\\n   13 src/core/tuning.js\\n 2354 total\\nCHECK_OK\\n143:      { do: 'hold', x: 0, z: 70, r: 24, time: 120, text: 'HOLD WHILE THEY BOARD' },\\n144:      { do: 'ride', time: 60, text: 'RIDE THE FLATCAR' },\\n155:    addBlock(this.ctx, 12, y + 1.2, 55, 6, 2.4, 4, this.ctx.palette.white);\\n156:    addBlock(this.ctx, -18, this.ground(-18, 62) + 1.1, 62, 5, 2.2, 4, this.ctx.palette.orange);\\n157:    addBlock(this.ctx, 0, this.ground(0, 70) + 0.4, 70, 14, 0.4, 4, this.ctx.palette.slate);\\n163:      addBlock(this.ctx, x, this.ground(x, z) + 1.5, z, 2.2, 3, 2.2, this.ctx.pale