if (s.bleed <= 0) this.respawn(s);\\n    }\\n    for (const seat of this.seats) {\\n      if (seat.ai) this.think(seat, dt);\\n      if (seat.actor) {\\n        seat.actor.x = seat.x;\\n        seat.actor.z = seat.z;\\n        seat.actor.alive = !seat.down;\\n        seat.actor.hp = seat.hp;\\n      }\\n    }\\n    if (this.session.isHost && this.session.kind !== 'hub' && this.t >= this.limit) this.finish('time');\\n  }\\n\\n  applyClient(msg) {\\n    if (!msg || msg.t !== 'me') return;\\n    const s = this.seat(msg.id);\\n    if (!s || s.id === this.me) return;\\n    s.x = msg.x;\\n    s.z = msg.z;\\n    s.yaw = msg.yaw || 0;\\n    if (msg.carrying && !s.carrying) {\\n      const c = this.cases.find((item) => item.id === msg.carrying && !item.taken);\\n      if (c && c.carrier == null) {\\n        c.carrier = s.id;\\n        s.carrying = c.id;\\n      }\\n    }\\n  }\\n\\n  snapshot() {\\n    const spark = this.world.linkSpark || null;\\n    this.world.linkSpark = null;\\n    return {\\n      t: 's',\\n      time: Math.round(this.t * 10) / 10,\\n      seats: this.seats.map((s) => [s.id, Math.round(s.x), Math.round(s.z), Math.round(s.hp), s.stones, s.down ? 1 : 0, s.carrying || 0]),\\n      cases: this.cases.map((c) => [c.id, c.taken ? 1 : 0, c.carrier == null ? -1 : c.carrier]),\\n      fire: this.world.fire.litByPlayer,\\n      spark,\\n    };\\n  }\\n\\n  applySnapshot(msg) {\\n    if (!msg || msg.t !== 's') return;\\n    if (typeof msg.time === 'number') this.t = msg.time;\\n    for (const row of msg.seats || []) {\\n      const s = this.seat(row[0]);\\n      if (!s || s.id === this.me) continue;\\n      s.x = row[1];\\n      s.z = row[2];\\n      s.hp = row[3];\\n      s.stones = row[4];\\n      s.down = !!row[5];\\n      s.carrying = row[6] || null;\\n    }\\n    for (const row of msg.cases || []) {\\n      const c = this.cases.find((item) => item.id === row[0]);\\n      if (!c) continue;\\n      c.taken = !!row[1];\\n      c.carrier = row[2] < 0 ? null : row[2];\\n    }\\n    if (msg.spark) this.world.fire.ignite(msg.spark.x, msg.spark.z, msg.spark.r || 1);\\n  }\\n\\n  finish(reason) {\\n    if (this.finished || !this.session.isHost) return;\\n    this.finished = true;\\n    const buckets = new Map();\\n    for (const s of this.seats) {\\n      const list = buckets.get(s.stones) || [];\\n      list.push(s.id);\\n      buckets.set(s.stones, list);\\n    }\\n    const standings = [...buckets.entries()].sort((a, b) => b[0] - a[0]).map(([, ids]) => ids);\\n    const scores = {};\\n    const stats = {};\\n    for (const s of this.seats) {\\n      scores[s.id] = s.stones;\\n      stats[s.id] = { Stones: s.stones, Downs: s.downs, Revives: s.revives, Kills: s.kills };\\n    }\\n    const awards = [];\\n    const byRev = [...this.seats].sort((a, b) => b.revives - a.revives)[0];\\n    const byStones = [...this.seats].sort((a, b) => b.stones - a.stones)[0];\\n    const byLit = [...this.seats].sort((a, b) => b.lit - a.lit)[0];\\n    if (byRev && byRev.revives > 0) awards.push({ id: byRev.id, title: 'Last Friend', detail: 'Most revives' });\\n    if (byStones) awards.push({ id: byStones.id, title: 'Paid in Full', detail: 'Most stones' });\\n    if (byLit && byLit.lit > 0) awards.push({ id: byLit.id, title: 'Arsonist', detail: 'Most grass lit' });\\n\",\"total_lines\":352}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9e22f413-1768-4228-a67b-f8cd03d3ebc5-51","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,34,62,10,70,111,117,110,100,32,55,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,47,65,32,67,114,121,32,84,111,111,32,70,97,114,45,70,97,114,32,67,114,121,32,50,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,47,115,114,99,47,115,105,109,47,114,111,117,110,100,46,106,115,10,55,51,58,32,32,32,32,32,32,115,46,97,99,116,111,114,32,61,32,97,99,116,111,114,59,10,57,56,58,32,32,32,32,105,102,32,40,115,46,97,99,116,111,114,41,32,115,46,97,99,116,111,114,46,104,112,32,61,32,48,59,10,49,49,54,58,32,32,32,32,105,102,32,40,115,46,97,99,116,111,114,41,32,115,46,97,99,116,111,114,46,104,112,32,61,32,115,46,104,112,59,10,49,51,49,58,32,32,32,32,105,102,32,40,115,46,97,99,116,111,114,41,32,123,10,49,51,50,58,32,32,32,32,32,32,115,46,97,99,116,111,114,46,104,112,32,61,32,54,48,59,10,49,51,51,58,32,32,32,32,32,32,115,46,97,99,116,111,114,46,97,108,105,118,101,32,61,32,116,114,117,101,59,10,50,54,55,58,32,32,32,32,32,32,32,32,115,101,97,116,46,97,99,116,111,114,46,120,32,61,32,115,101,97,116,46,120,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":7,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/round.js\",\"matches\":[{\"line_number\":73,\"content\":\"      s.actor = actor;\"},{\"line_number\":98,\"content\":\"    if (s.actor) s.actor.hp = 0;\"},{\"line_number\":116,\"content\":\"    if (s.actor) s.actor.hp = s.hp;\"},{\"line_number\":131,\"content\":\"    if (s.actor) {\"},{\"line_number\":132,\"content\":\"      s.actor.hp = 60;\"},{\"line_number\":133,\"content\":\"      s.actor.alive = true;\"},{\"line_number\":267,\"content\":\"        seat.actor.x = seat.x;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"584340a3-0288-4b12-b478-2814e1d9bae2"}
{"type":"assistant","message":{"id":"msg_604","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A visual bug appears when the missions list shows buddies.\n\nThe rig-attachmentThe rig follows actor.x, fix is broken. Both buddy meshes sit 1.4m from the player because their x and z positions are null. They stack on top of the player which follows seat. for the entire mission. The rig should move with the actor, not the player.\n\nThe anti-ratchet rule allows refuting a new objection only if it is a demonstrable defect in shipped behavior. This bug qualifies. Yet its severity is questionable. The core gap was missing first-person visuals. Soldiers now have meshes at their posts. The buddy bug is a side effect.\n\nMercenaries stand at posts and only move when burning. Their mesh and damage radius align at x,z. Gap 3 is fixed. placeRig handles missing x,z gracefully via feet(). The screenshot shows\n\nA senior engineer  a map-truck view.would likely treat this as a real bug. Two full soldier rigs are welded to the player during M6, blocking the view. The fix is to only place the rig when x and z coordinates are set, or to give buddies real positions.\n\nTwo other potential bugs were considered. A melee finish without range might be pre-existing. The map also fails to show sites and roads,\n\nWalking tests also which violates the  use the same poseMap path and appear to work. The dev mode hit test bug is fixed; plan.tests passed and the log reflects this round's output.","signature":""},{"type":"tool_use","id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-50","name":"grep","input":{"pattern":"this\\.stamp\\(","glob":"**/*.js","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917"}},{"type":"tool_use","id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-51","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/PLAN.md","offset":680,"limit":80}},{"type":"tool_use","id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-52","name":"grep","input":{"pattern":"SLIDER_KEYS","glob":"**/*.{js,mjs}","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917"}},{"type":"tool_use","id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-53","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/core/actions.js","limit":80}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":7797,"output_tokens":884,"cache_read_input_tokens":94080,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"9ecba17c-0be3-4b54-bc51-f2531e20ae56"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-50","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,34,62,10,70,111,117,110,100,32,51,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,95,95,120,48,55,51,57,51,99,47,119,111,114,107,47,65,32,67,114,121,32,84,111,111,32,70,97,114,45,70,97,114,32,67,114,121,32,50,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,53,45,48,49,51,57,49,55,47,115,114,99,47,115,105,109,47,119,111,114,108,100,46,106,115,10,50,48,57,58,32,32,32,32,32,32,116,104,105,115,46,115,116,97,109,112,40,112,46,120,44,32,112,46,122,44,32,50,52,48,44,32,50,52,48,44,32,50,52,48,41,59,10,50,49,55,58,32,32,32,32,32,32,116,104,105,115,46,115,116,97,109,112,40,120,44,32,122,44,32,51,48,44,32,50,56,44,32,51,54,41,59,10,50,50,48,58,32,32,32,32,116,104,105,115,46,115,116,97,109,112,40,112,46,120,44,32,112,46,122,44,32,50,52,48,44,32,50,52,48,44,32,50,52,48,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":3,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\",\"matches\":[{\"line_number\":209,\"content\":\"      this.stamp(p.x, p.z, 240, 240, 240);\"},{\"line_number\":217,\"content\":\"      this.stamp(x, z, 30, 28, 36);\"},{\"line_number\":220,\"content\":\"    this.stamp(p.x, p.z, 240, 240, 240);\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-86b20883-5a21-45b3-b769-74a7d7f004bb-51","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"680→- Mission step at the top for 5 s when it changes.\\n\\n**Controls** (`src/core/actions.js`):\\n\\n| Action | DualSense | Xbox glyph | Keyboard and mouse |\\n| --- | --- | --- | --- |\\n| Move / look | L stick / R stick | same | WASD / mouse |\\n| Fire / aim | R2 / L2 | RT / LT | LMB / RMB |\\n| Use (when a prompt shows), else reload | Square | X | E / R |\\n| Jump | Cross | A | Space |\\n690→| Crouch | Circle | B | C (never Ctrl: Ctrl+W closes the browser tab) |\\n| Sprint | L3 (click) | LS | Left Shift |\\n| Melee | R3 | RS | F |\\n| Next weapon | Triangle | Y | Wheel, or 1-4 |\\n| Throw / plant | R1 | RB | G |\\n| Syrette, surgery | L1 | LB | Q |\\n| Map up / down | D-pad Up | D-pad Up | M or Tab |\\n| Tablet | D-pad Down | D-pad Down | H |\\n| Tracker | D-pad Left | D-pad Left | T |\\n| Monocular (hold) | D-pad Right | D-pad Right | V |\\n700→| Pause | Options | Menu | Esc |\\n| Ledger | Create | View | J |\\n| **Driving:** gas / brake-reverse / steer | R2 / L2 / L stick | RT / LT / L stick | W / S / A-D |\\n| Handbrake | Cross | A | Space |\\n| Get out / repair | Square | X | E |\\n| Swap to gun | Triangle | Y | F |\\n| Chase camera | R3 | RS | C |\\n\\nUse `input.preventKeys.add('Tab')` etc. Analog triggers: each frame, read `navigator.getGamepads()` buttons 6 and 7 `value` and `input.send({ tr:[l2, r2] })` when changed, so recordings keep it, and use it for throttle and brake. Rumble: `pad.vibrationActuator?.playEffect('dual-rumble', {...})`, guarded, Settings toggle.\\n\\n710→**Glyphs.** Prompts follow the input used last:\\n- `device` flips to `kbm` on keydown, mouse button or real mouse movement, and to `pad` on any `Pad*` code or a stick past 0.35.\\n- `src/ui/glyphs.js` is pixel art as `hud.sprite` rows, about 11 × 11: Cross, Circle, Square, Triangle, L1, L2, R1, R2, L3, R3, D-pad directions, Options, Create; Xbox A, B, X, Y, LB, LT, RB, RT, LS, RS, Menu, View; a key cap drawn around any letter; LMB, RMB, MMB, wheel.\\n- Settings has **Glyphs: PlayStation / Xbox**, default PlayStation.\\n- `game.state().prompts` lists what's on screen, so tests can check it.\\n\\n**The mouse is native.** In menus the pointer is free (no lock), hover moves focus, click activates (read `input.buttonEvents`; convert with `x = (p.x+1)/2*hud.width`, `y = (1-p.y)/2*hud.height`). The wheel scrolls pages. Over the world it aims and looks under pointer lock. On the held map it's a cursor (hover focuses a marker, click sets the waypoint). On Tibor's rack and in dialogue choices, click works too. Keyboard in menus: arrows or WASD, Enter or Space, Esc back. Pad in menus: D-pad or left stick with key repeat, Cross confirms, Circle goes back, L1/R1 change tabs and pages. If the pad disconnects during play, open the pause menu.\\n\\n**The held map** (`src/world/map-texture.js`). The heart of pillar 3.\\n- 320 × 240 DataTexture on a plane about 0.5 × 0.375 m, about 0.42 m in front of the camera, tilted, in both hands (the `hand` model and hands rig), filling about 70% of the width, so one texel is about one art pixel. A 0.62 m plane, which I tried first, was too big.\\n720→- Baked at start: contour lines every 8 m on sand paper, river, roads, rail, labels in your own 5×7 `pixfont.js`.\\n- Redrawn at up to 2 Hz on a copy: burn scars (ink), your position and heading, the waypoint, sites you've seen, mission step and Harrow's notes in the margin, wind arrow and clock on a small GPS clipped to the corner.\\n- Raise and lower takes 0.4 s with paper sound. **The world never stops.** You can walk and drive with it up. While it's up, the look input moves the map cursor.\\n- Square/LMB on a marker sets the waypoint; Triangle or wheel toggles a closer zoom.\\n- It works at night because the paper uses a dim lit toon plus a small hand torch `lights.request` following the view group.\\n\\n**Screens:**\\n- **Loading:** the engine's, then a black screen with one Harrow epigraph.\\n- **Title:** live 3D scene (dusk, fixed slow camera over burning grass on the Long Field, music), the title large (scale 4, or 3 if it won't fit), the latest input's *Press [glyph]*. Then the main menu.\\n- **Main menu:** Continue (when a save exists), New Game, Cash Run, Settings, About and Credits.\\n730→- **Pause** (`timeScale = 0`): Resume, Ledger, Settings, Dev Mode, About and Credits, Quit to Title. In a hub session: Resume and Settings only.\\n- **Settings:** Sound (Music slider **default 10%**, Effects, Voices), Controls (Look sensitivity for pad, for mouse; Invert Y; Aim assist; Rumble; Glyphs), Picture (Fullscreen, for the TV; Pixel size Fine/Chunky via `engine.settings.set`; Quality; Field of view), Comfort (Subtitle size; Reduce flashes; Fever effects reduced), Reset to Defaults. Saved in your own `localStorage` entry and re-applied at boot: `settings:{ button:false, key:false }` hides the engine's panel and stops the engine saving its own copy.\\n- **Dialogue:** the camera holds on the speaker; subtitles; two big buttons at most.\\n- **Tibor's rack:** one gun at a time, large (its first-person model turned to the side on a table), name, three bars (Damage, Range, Reliability), price. Left/right cycles. Buy or Take.\\n- **Locker:** one row per slot, left/right picks.\\n- **Bed:** Dawn, Noon, Dusk, Midnight, Leave.\\n- **Ledger:** section 13.\\n- **Game Over, Ending card, Credits.**\\n- **About and Credits:** paged, see section 27.\\n\\n740→**Touch-only devices.** Detect with `matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches` and no pad connected (verified: true on Chromium with the `iPhone 14`, `iPad Pro 11` and `Pixel 7` profiles, false on a desktop context). Engine option `touch:false` always, so there are never on-screen controls. On such a device the title shows **Controller or keyboard required** (the exact text in `state().notice`, drawn uppercase by the font) and one large **Settings** button (tap works as click: `input.buttonEvents` reports a finger as code `Touch`). Attract mode still starts after 10 s; a tap exits to this screen. A key press or pad connecting clears the gate and shows the normal title.\\n\\n---\\n\\n## 17. Dev mode\\n\\nPause menu → **Dev Mode** (hidden in a hub session). An overlay with tabs (L1/R1 or Q/E), world visible behind, playing or frozen by a toggle.\\n\\n| Tab | Contents |\\n| --- | --- |\\n750→| Cheats | God mode, infinite ammo, no jams, no fever, invisible to AI, noclip fly |\\n| Teleport | Every site, every post, every case, the crosshair point |\\n| Spawn | Squad of each faction, pickup, technical, truck, a stone case, a buddy |\\n| World | Hour slider, wind direction and speed sliders, weather (clear, dust, storm), ignite at crosshair, extinguish all, regrow all, sleep +6 h |\\n| Mission | Start any mission, complete current step, set story flags, give stones, tablets, syrettes, all guns; break gun; force jam; force fever; down a buddy |\\n| **Balance** | Live sliders (below), **Reset to Defaults** for all, Square/R resets one |\\n| Debug | Fire-grid overlay, nav overlay, AI state text over heads, counts (actors, burning cells, draw info from `engine.state()`), engine debug panel (`engine.showDebug`), free camera (`engine.setCamera({ preset:'free' })`, restored after; re-install `step` in `onCameraChange`), crosshair coordinates for placing things in `src/content/`, Quick Save/Load, show `status()` |\\n\\n**Balance sliders** (left/right steps, hold accelerates, mouse drags). Defaults in `src/content/tuning-defaults.js`:\\n\",\"content_concise\":\"680→- Mission step at the top for 5 s when it changes.\\n\\n**Controls** (`src/core/actions.js`):\\n\\n| Action | DualSense | Xbox glyph | Keyboard and mouse |\\n| --- | --- | --- | --- |\\n| Move / look | L stick / R stick | same | WASD / mouse |\\n| Fire / aim | R2 / L2 | RT / LT | LMB / RMB |\\n| Use (when a prompt shows), else reload | Square | X | E / R |\\n| Jump | Cross | A | Space |\\n690→| Crouch | Circle | B | C (never Ctrl: Ctrl+W closes the browser tab) |\\n| Sprint | L3 (click) | LS | Left Shift |\\n| Melee | R3 | RS | F |\\n| Next weapon | Triangle | Y | Wheel, or 1-4 |\\n| Throw / plant | R1 | RB | G |\\n| Syrette, surgery | L1 | LB | Q |\\n| Map up / down | D-pad Up | D-pad Up | M or Tab |\\n| Tablet | D-pad Down | D-pad Down | H |\\n| Tracker | D-pad Left | D-pad Left | T |\\n| Monocular (hold) | D-pad Right | D-pad Right | V |\\n700→| Pause | Options | Menu | Esc |\\n| Ledger | Create | View | J |\\n| **Driving:** gas / brake-reverse / steer | R2 / L2 / L stick | RT / LT / L stick | W / S / A-D |\\n| Handbrake | Cross | A | Space |\\n| Get out / repair | Square | X | E |\\n| Swap to gun | Triangle | Y | F |\\n| Chase camera | R3 | RS | C |\\n\\nUse `input.preventKeys.add('Tab')` etc. Analog triggers: each frame, read `navigator.getGamepads()` buttons 6 and 7 `value` and `input.send({ tr:[l2, r2] })` when changed, so recordings keep it, and use it for throttle and brake. Rumble: `pad.vibrationActuator?.playEffect('dual-rumble', {...})`, guarded, Settings toggle.\\n\\n710→**Glyphs.** Prompts follow the input used last:\\n- `device` flips to `kbm` on keydown, mouse button or real mouse movement, and to `pad` on any `Pad*` code or a stick past 0.35.\\n- `src/ui/glyphs.js` is pixel art as `hud.sprite` rows, about 11 × 11: Cross, Circle, Square, Triangle, L1, L2, R1, R2, L3, R3, D-pad directions, Options, Create; Xbox A, B, X, Y, LB, LT, RB, RT, LS, RS, Menu, View; a key cap drawn around any letter; LMB, RMB, MMB, wheel.\\n- Settings has **Glyphs: PlayStation / Xbox**, default PlayStation.\\n- `game.state().prompts` lists what's on screen, so tests can check it.\\n\\n**The mouse is native.** In menus the pointer is free (no lock), hover moves focus, click activates (read `input.buttonEvents`; convert with `x = (p.x+1)/2*hud.width`, `y = (1-p.y)/2*hud.height`). The wheel scrolls pages. Over the world it aims and looks under pointer lock. On the held map it's a cursor (hover focuses a marker, click sets the waypoint). On Tibor's rack and in dialogue choices, click works too. Keyboard in menus: arrows or WASD, Enter or Space, Esc back. Pad in menus: D-pad or left stick with key repeat, Cross confirms, Circle goes back, L1/R1 change tabs and pages. If the pad disconnects during play, open the pause menu.\\n\\n**The held map** (`src/world/map-texture.js`). The heart of pillar 3.\\n- 320 × 240 DataTexture on a plane about 0.5 × 0.375 m, about 0.42 m in front of the camera, tilted, in both hands (the `hand` model and hands rig), filling about 70% of the width, so one texel is about one art pixel. A 0.62 m plane, which I tried first, was too big.\\n720→- Baked at start: contour lines every 8 m on sand paper, river, roads, rail, labels in your own 5×7 `pixfont.js`.\\n- Redrawn at up to 2 Hz on a copy: burn scars (ink), your position and heading, the waypoint, sites you've seen, mission step and Harrow's notes in the margin, wind arrow and clock on a small GPS clipped to the corner.\\n- Raise and lower takes 0.4 s with paper sound. **The world never stops.** You can walk and drive with it up. While it's up, the look input moves the map cursor.\\n- Square/LMB on a marker sets the waypoint; Triangle or wheel toggles a closer zoom.\\n- It works at night because the paper uses a dim lit toon plus a small hand torch `lights.request` following the view group.\\n\\n**Screens:**\\n- **Loading:** the engine's, then a black screen with one Harrow epigraph.\\n- **Title:** live 3D scene (dusk, fixed slow camera over burning grass on the Long Field, music), the title large (scale 4, or 3 if it won't fit), the latest input's *Press [glyph]*. Then the main menu.\\n- **Main menu:** Continue (when a save exists), New Game, Cash Run, Settings, About and Credits.\\n730→- **Pause** (`timeScale = 0`): Resume, Ledger, Settings, Dev Mode, About and Credits, Quit to Title. In a hub session: Resume and Settings only.\\n- **Settings:** Sound (Music slider **default 10%**, Effects, Voices), Controls (Look sensitivity for pad, for mouse; Invert Y; Aim assist; Rumble; Glyphs), Picture (Fullscreen, for the TV; Pixel size Fine/Chunky via `engine.settings.set`; Quality; Field of view), Comfort (Subtitle size; Reduce flashes; Fever effects reduced), Reset to Defaults. Saved in your own `localStorage` entry and re-applied at boot: `settings:{ button:false, key:false }` hides the engine's panel and stops the engine saving its own copy.\\n- **Dialogue:** the camera holds on the speaker; subtitles; two big buttons at most.\\n- **Tibor's rack:** one gun at a time, large (its first-person model turned to the side on a table), name, three bars (Damage, Range, Reliability), price. Left/right cycles. Buy or Take.\\n- **Locker:** one row per slot, left/right picks.\\n- **Bed:** Dawn, Noon, Dusk, Midnight, Leave.\\n- **Ledger:** section 13.\\n- **Game Over, Ending card, Credits.**\\n- **About and Credits:** paged, see section 27.\\n\\n740→**Touch-only devices.** Detect with `matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches` and no pad connected (verified: true on Chromium with the `iPhone 14`, `iPad Pro 11` and `Pixel 7` profiles, false on a desktop context). Engine option `touch:false` always, so there are never on-screen controls. On such a device the title shows **Controller or keyboard required** (the exact text in `state().notice`, drawn uppercase by the font) and one large **Settings** button (tap works as click: `input.buttonEvents` reports a finger as code `Touch`). Attract mode still starts after 10 s; a tap exits to this screen. A key press or pad connecting clears the gate and shows the normal title.\\n\\n---\\n\\n## 17. Dev mode\\n\\nPause menu → **Dev Mode** (hidden in a hub session). An overlay with tabs (L1/R1 or Q/E), world visible behind, playing or frozen by a toggle.\\n\\n| Tab | Contents |\\n| --- | --- |\\n750→| Cheats | God mode, infinite ammo, no jams, no fever, invisible to AI, noclip fly |\\n| Teleport | Every site, every post, every case, the crosshair point |\\n| Spawn | Squad of each faction, pickup, technical, truck, a stone case, a buddy |\\n| World | Hour slider, wind direction and speed sliders, weather (clear, dust, storm), ignite at crosshair, extinguish all, regrow all, sleep +6 h |\\n| Mission | Start any mission, complete current step, set story flags, give stones, tablets, syrettes, all guns; break gun; force jam; force fever; down a buddy |\\n| **Balance** | Live sliders (below), **Reset to Defaults** for all, Square/R resets one |\\n| Debug | Fire-grid overlay, nav overlay, AI state text over heads, counts (actors, burning cells, draw info from `engine.state()`), engine debug panel (`engine.showDebug`), free camera (`engine.setCamera({ preset:'free' })`, restored after; re-install `step` in `onCameraChange`), crosshair coordinates for placing things in `src/content/`, Quick Save/Load, show `status()` |\\n\\n**Balance sliders** (left/right steps, hold accelerates, mouse drags). Defaults in `src/content/tuning-defaults.js`:\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/PLAN.md\",\"offset\":680,\"limit\":80,\"raw_output\":\"- Mission step at the top for 5 s when it changes.\\n\\n**Controls** (`src/core/actions.js`):\\n\\n| Action | DualSense | Xbox glyph | Keyboard and mouse |\\n| --- | --- | --- | --- |\\n| Move / look | L stick / R stick | same | WASD / mouse |\\n| Fire / aim | R2 / L2 | RT / LT | LMB / RMB |\\n| Use (when a prompt shows), else reload | Square | X | E / R |\\n| Jump | Cross | A | Space |\\n| Crouch | Circle | B | C (never Ctrl: Ctrl+W closes the b