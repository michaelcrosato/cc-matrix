e_number\":239,\"content\":\"    this.dead = false;\"},{\"line_number\":254,\"content\":\"  teleport(x, z) {\"},{\"line_number\":257,\"content\":\"    else this.hero.teleport([x, y, z]);\"},{\"line_number\":276,\"content\":\"  hurt(amount, kind = 'bullet', force = false) {\"},{\"line_number\":277,\"content\":\"    if (this.dead) return;\"},{\"line_number\":300,\"content\":\"    this.dead = true;\"},{\"line_number\":323,\"content\":\"    this.dead = false;\"},{\"line_number\":332,\"content\":\"      if (!this.deadBuddies.has(id)) {\"},{\"line_number\":333,\"content\":\"        this.deadBuddies.add(id);\"},{\"line_number\":341,\"content\":\"      if (this.deadBuddies.has(id)) {\"},{\"line_number\":347,\"content\":\"    for (const id of this.deadBuddies) {\"},{\"line_number\":369,\"content\":\"    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\"},{\"line_number\":441,\"content\":\"      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\"},{\"line_number\":443,\"content\":\"    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\"},{\"line_number\":489,\"content\":\"    if (!this.deadBuddies.has(b.id)) {\"},{\"line_number\":490,\"content\":\"      this.deadBuddies.add(b.id);\"},{\"line_number\":622,\"content\":\"    this.teleport(home.x, home.z);\"},{\"line_number\":623,\"content\":\"    this.dead = false;\"},{\"line_number\":650,\"content\":\"    if (this.burning > 0) this.hurt(TUNING.fireDamage * dt, 'fire', false);\"},{\"line_number\":692,\"content\":\"          if (this.rng.next() < 0.5 * dt * 4) this.hurt(9, 'bullet', false);\"},{\"line_number\":733,\"content\":\"        if (!this.deadBuddies.has(b.id)) {\"},{\"line_number\":734,\"content\":\"          this.deadBuddies.add(b.id);\"},{\"line_number\":751,\"content\":\"        this.dead = false;\"},{\"line_number\":768,\"content\":\"    if (this.dead && this.rescueT <= 0) return;\"},{\"line_number\":841,\"content\":\"      this.hero.teleport([f.x + MOVE.x * dt * 12, f.y, f.z + MOVE.z * 