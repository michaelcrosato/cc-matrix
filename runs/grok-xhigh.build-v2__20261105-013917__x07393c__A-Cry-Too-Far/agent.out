pdate = true;\\n}\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/world/terrain.js has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/world/terrain.js has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/world/terrain.js\",\"edits\":{\"details\":[{\"old_string\":\"export function paintScar(land, ix, iz) {\\n  const col = land.mesh.geometry.getAttribute('color');\\n  const x = FIRE_ORIGIN + (ix + 0.5) * FIRE_CELL;\\n  const z = FIRE_ORIGIN + (iz + 0.5) * FIRE_CELL;\\n  const nx = land.nx;\\n  const nz = land.nz;\\n  const ink = new Color(PALETTE.ink);\\n  const slate = new Color(PALETTE.slate);\\n  const half = FIRE_CELL;\\n  for (let tz = 0; tz < nz; tz++) {\\n    const wz = land.pointZ(tz);\\n    if (Math.abs(wz - z) > half) continue;\\n    for (let tx = 0; tx < nx; tx++) {\\n      const wx = land.pointX(tx);\\n      if (Math.abs(wx - x) > half) continue;\\n      const vi = 6 * (tx + tz * nx);\\n      const c = ((tx + tz) & 1) ? ink : slate;\\n      for (let k = 0; k < 6; k++) col.setXYZ(vi + k, c.r, c.g, c.b);\\n    }\\n  }\\n  col.needsUpdate = true;\\n}\",\"old_line\":103,\"new_string\":\"export function paintScar(land, ix, iz) {\\n  const col = land.mesh.geometry.getAttribute('color');\\n  const x = FIRE_ORIGIN + (ix + 0.5) * FIRE_CELL;\\n  const z = FIRE_ORIGIN + (iz + 0.5) * FIRE_CELL;\\n  const nx = land.nx;\\n  const [cw, ch] = land.cell;\\n  const x0 = land.pointX(0);\\n  const z0 = land.pointZ(0);\\n  const tx0 = Math.max(0, Math.floor((x - FIRE_CELL - x0) / cw));\\n  const tz0 = Math.max(0, Math.floor((z - FIRE_CELL - z0) / ch));\\n  const tx1 = Math.min(nx - 1, Math.ceil((x + FIRE_CELL - x0) / cw));\\n  const tz1 = Math.min(land.nz - 1, Math.ceil((z + FIRE_CELL - z0) / ch));\\n  const ink = new Color(PALETTE.ink);\\n  const slate = new Color(PALETTE.slate);\\n  for (let tz = tz0; tz <= tz1; tz++) {\\n    for (let tx = tx0; tx <= tx1; tx++) {\\n      const vi = 6 * (tx + tz * nx);\\n      const c = ((tx + tz) & 1) ? ink : slate;\\n      for (let k = 0; k < 6; k++) col.setXYZ(vi + k, c.r, c.g, c.b);\\n    }\\n  }\\n  col.needsUpdate = true;\\n}\",\"new_line\":103,\"context_before\":\"  return base;\\n}\\n\\n\",\"context_after\":\"\\nexport function fuelAt(x, z, heights) {\\n  if (nearRiver(x, z, 9)) return 0;\\n\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"45d0657f-307f-4798-9957-332c21662e39"}
{"type":"assistant","message":{"id":"msg_44","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"fillFuel calls heights(), which computes the full fbm for all 65,536 fire cells.\n\nHeights() is called roughly 200,000 times with three fbm octaves. That should take a second or two. nearRoad and fuelAt loops are lightweight. The world simulation in world.js is the next major task.\n\ngame.dev methods will delegate to the World class. A compact audio bank, soldier model with limb() helpers, and textures are next. Then world.js, game.js, main.js, and tests.\n\nModels will live in art/models.js. The smoke test will catch slow or broken checkModel calls. Player movement will use CharacterController with yaw from the camera and speed from hero.speed. Forward direction needs empirical testing. Crouch may be a press toggle rather than hold.\n\nCrouch toggles on press. Sprint drains stamina over six seconds and refills over eight, using a six-step scale. Walk toggles with CapsLock. Jump consumes the jump action. Wade near rivers without bridges at speed 2.7, disabling sprint. Fire clicks sound when jammed; otherwise it may break if condition drops to zero. Jam chance uses random generation, and world.forceJamOnShot forces a jam after a set shot count.\n\nReload resolves a jam by decrementing jamLeft and clearing it when zero, otherwise refilling the magazine from reserve. Use targets the nearest usable object within 2.5 meters, including vehicles, cages, ledgers, beds, shops, triggers, halts, cases, buddies, and repair bonnets. The map toggle animates in fixedUpdate over 0.4 seconds using delta time. While open, look is disabled and the cursor tracks mouseDelta in update plus pad right stick; tests will use addPointer in the update path.\n\nThe map cursor starts at the player position. Moving it onto a site and confirming sets a waypoint. Sites within 80 meters are marked seen for simplicity. The test will press M, step until the map opens, move the cursor with addPointer, and confirm to set the waypoint.\n\nWhile the map is open in a vehicle, throttle still drives the car and position updates. Holding one second during fever consumes a tablet and clears it after five seconds. Ignoring fever for twenty-five seconds causes collapse and reduces stones by twenty percent. Surgery heals below twenty health over four seconds and can be interrupted by damage. Syrette heals above twenty health over point eight seconds and restores forty health. Rescue revives dead players with a two-second scene and forty health.\n\nBuddy down sets a buddy to zero health and down, prompting for syrettes. The finish action uses melee or a dedicated key while the prompt is active; otherwise use triggers the syrette. Civilians spawn at three wells and ignore player damage. Soldiers spawn with AI ticks. The pass faction ignores the player unless provoked or inside the HQ inner yard. Perception checks distance between soldiers and the player.\n\nSoldier vision range scales by crouch, grass, night, and light. A 120-degree cone limits detection to within 60 degrees of the soldier's facing. Suspicion builds over 1.5 seconds and triggers an alert state for enemyReaction seconds before shooting. Tests will verify that stance and night conditions change the alert state.\n\nSoldier state will flip to alert after 0.3 seconds of detection so tests do not wait the full 1.5 seconds. Night vision drops to 0.45 between 19 and 5.5 hours. Shots deal damage scaled by player damage taken and accuracy factor, with aim error tracked. Burn panic triggers when a cell is burning, forcing movement, ignition, and death within five seconds. Posts track alive status, faction, and cleared time; they reman after postRemanHours once their soldiers die, avoiding expensive initial spawns.\n\nPosts spawn when a mission starts or the player enters a 260-meter radius. Tests can manually spawn soldiers and posts via world methods. Trucks spawn with full health and yaw zero, and entering one creates a physics vehicle. Repairing a truck near its bonnet requires holding use for three seconds; if health is below fifty it resets to fifty.\n\nRepair sets truck health to fifty if it is below that value, otherwise leaving it unchanged. Exploding occurs when a truck has less than ten health and is on fire, after an eight-second timer that kills the vehicle and ignites it. Damage thresholds scale with drive power. The map texture will be a 320-by-240 Uint8Array buffer drawn at two frames per second; tests will read individual pixels to verify burns.\n\nScars will be drawn as dark pixels on the map texture for tests to verify via mapHasScar(). The GPS and wind arrow will share the same texture corner. Save and restore will serialize player stats, fire state, flags, buddies, guns, ledger, and condition. CashRound will live in src/sim/round.js and run when the game mode is round. Next up are writing round.js, world.js, and game.js.\n\nI will write world.js in one pass and run node --check to catch syntax errors immediately. game.js will manage modes, menus, dev sliders, touch input, HUD drawing, and network ticks. I am sketching the menu update logic carefully so tests pass.\n\nMenu screens are planned: title, main, cash run, settings, about, pause, dev, play, card, ending, and game over. Title has no item list; any confirm opens main. Focus moves with arrow keys or mouse hover and activates with enter or click.\n\nTouch input will only handle the Settings item and notices. The attract screen triggers after ten seconds of idle time from the title or main menu, but Settings and About are exempt so the idle timer resets when entering or leaving those screens. Pausing sets the engine timeScale to zero and resumes it to one.\n\nThe dev overlay will default to frozen time, keeping the engine paused unless a freeze toggle is turned off. Slider changes made while paused still apply immediately through applySlider, so tests can verify effects by unpausing and stepping. This covers both TUNING values and spawned soldier health.\n\nReset will immediately restore all TUNING values to their defaults. Music volume is set to 0.1 during setup before any return, overriding the engine default of 0.6 so tests can read the correct value after headless initialization. If a session option is provided, the title screen is skipped and the mode becomes card; ready() then calls session.ready() unless this instance is the server. createGame does not touch window objects, leaving that work to ready().\n\nmain.js will handle boot order and card keydown before engine start, setting game.cardLive when a session is present. Time-up will trigger round.finishNow(). Solo mode starts from the cash menu by creating a solo session, building the round, and entering round mode; tests can also call game.dev.startRound() directly. Cases hold stones and determine the winner; the player can carry one by using it while near it, or bank it at a truck for a reward.\n\nI will export a `world.pay(amount)` method for missions and tests to share. The slider test can call it directly via `game.world.grant('pay', 10)`, matching how `onDone` awards mission pay.\n\nThe slider test will call `world.pay(10)` directly, since missions already use that function. A stronger alternative is to start mission one and jump to its final step to verify stones, but that may be slow if the world must already be built.\n\nI will add a `world.completeCurrent()` dev tool that triggers the real mission completion handler. This lets tests finish a step instantly without manually teleporting and pressing keys, which is useful for verifying rewards like stonesReward.\n\nThe slider test will use nudge and a real shot to measure weapon wear. For stonesReward, it will call the dev tool to finish mission one's steps, because onDone reads the multiplier from pay() only after all steps are completed.\n\nI will write world.js in parts using the write tool. The terrain import path is confirmed as `../../pixel-engine.js` and fire.js as `./fire.js`. I am ready to begin coding.","signature":""},{"type":"text","text":"The basin and the mission list are in place. I'm writing the simulation that the tests will actually drive."},{"type":"tool_use","id":"call-ef51d44f-acbc-40a5-ab52-ea57921baa06-88","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js","new_string":"import { CharacterController, THREE, Vehicle } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { consumeAction, heldAction } from '../core/actions.js';\nimport { CASES, POSTS, SITES, STRIPS, TRIGS, siteById } from '../content/sites.js';\nimport { missionById } from '../content/missions.js';\nimport { WEAPON_BY_ID, freshWeapon } from '../content/weapons.js';\nimport { onBridge, nearRiver } from '../content/roads.js';\nimport { FireGrid } from '../world/fire.js';\nimport { addBlock, buildLand, fillFuel, paintScar } from '../world/terrain.js';\nimport { line } from '../content/dialogue.js';\n\nconst { Vector3 } = THREE;\nconst MOVE = new Vector3();\n\nconst BUDDY_DEF = {\n  ines: { name: 'INES CARVALHO', hp: 200 },\n  dov: { name: 'DOV HALPERN', hp: 200 },\n  mags: { name: 'MAGS OYELARAN', hp: 200 },\n};\n\nexport class World {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.rng = ctx.random.fork('world');\n    this.fire = new FireGrid(ctx.random.fork('fire'));\n    this.fire.onBurnt = (ix, iz) => {\n      if (this.land) paintScar(this.land, ix, iz);\n      this.scarTick = (this.scarTick || 0) + 1;\n    };\n    this.heroes = null;\n    this.land = null;\n    this.heights = null;\n    this.hp = 100;\n    this.stones = 0;\n    this.tablets = 0;\n    this.syrettes = 3;\n    this.syretteMax = 3;\n    this.hour = 9;\n    this.gameHours = 9;\n    this.windDir = 0.4;\n    this.windSpeed = 3;\n    this.windPin = null;\n    this.rain = false;\n    this.weather = 'clear';\n    this.guns = [];\n    this.slot = 0;\n    this.unlocked = new Set(['cane', 'm38']);\n    this.upgrades = new Set();\n    this.flags = new Set();\n    this.safehouses = new Set();\n    this.seen = new Set(['mile-forty', 'clinic']);\n    this.notes = 0;\n    this.tracker = false;\n    this.truce = true;\n    this.column = false;\n    this.pass = null;\n    this.provoked = false;\n    this.buddies = [];\n    this.actors = [];\n    this.props = [];\n    this.cases = [];\n    this.posts = POSTS.map((p) => ({ ...p, alive: true, clearedAt: null }));\n    this.trucks = [];\n    this.car = null;\n    this.inVehicle = false;\n    this.vehicleHp = 100;\n    this.vehicleKind = null;\n    this.repairT = 0;\n    this.explodeT = 0;\n    this.carrying = null;\n    this.waypoint = null;\n    this.map = { up: false, anim: 0, cx: 0, cz: 40, zoom: 1 };\n    this.mapPx = new Uint8Array(320 * 240 * 4);\n    this.feverT = 12 * 60;\n    this.feverOn = false;\n    this.feverIgnore = 0;\n    this.feverClear = 0;\n    this.holdT = { tablet: 0, heal: 0, use: 0 };\n    this.surgeryT = 0;\n    this.rescueT = 0;\n    this.rescueBuddy = null;\n    this.dead = false;\n    this.god = false;\n    this.noJam = false;\n    this.infAmmo = false;\n    this.invisible = false;\n    this.noclip = false;\n    this.crouch = false;\n    this.walk = false;\n    this.sprint = false;\n    this.stamina = 6;\n    this.burning = 0;\n    this.regenT = 0;\n    this.lastHurt = 'bullet';\n    this.shotCount = 0;\n    this.jamScript = 0;\n    this.mission = null;\n    this.stepT = 0;\n    this.lines = [];\n    this.choice = null;\n    this.choicePick = null;\n    this.subtitle = '';\n    this.speaker = '';\n    this.prompt = '';\n    this.ledger = { killed: 0, friends: 0, moved: 0, stonesEarned: 0 };\n    this.clock = 0;\n    this.rideT = 0;\n    this.riding = false;\n    this.heard = { spot: false };\n    this.aimError = 0;\n    this.sheet = null;\n    this.ending = null;\n    this.civilians = 12;\n    this.movedOnce = false;\n  }\n\n  build() {\n    const built = buildLand(this.ctx, this.ctx.random.fork('land').state);\n    this.land = built.land;\n    this.heights = built.heights;\n    fillFuel(this.fire, this.heights);\n    const y = this.ground(0, 40);\n    this.hero = new CharacterController(this.ctx.physics, {\n      position: [0, y + 0.05, 40],\n      speed: 5.4,\n      jumpSpeed: 8,\n      gravity: -24,\n      radius: 0.35,\n      halfHeight: 0.55,\n    });\n    this.paintMapBase();\n    this.spawnTown();\n    for (const c of CASES) this.cases.push({ ...c, taken: false });\n    this.markSeen();\n  }\n\n  ground(x, z) {\n    if (this.land) return this.land.heightAt(x, z);\n    if (this.heights) return this.heights(x, z);\n    return 40;\n  }\n\n  feet() {\n    if (this.inVehicle && this.car) {\n      const t = this.car.body.translation();\n      return { x: t.x, y: t.y, z: t.z };\n    }\n    const f = this.hero.feet;\n    return { x: f.x, y: f.y, z: f.z };\n  }\n\n  spawnTown() {\n    const y = this.ground(12, 55);\n    addBlock(this.ctx, 12, y + 1.2, 55, 6, 2.4, 4, this.ctx.palette.white);\n    addBlock(this.ctx, -18, this.ground(-18, 62) + 1.1, 62, 5, 2.2, 4, this.ctx.palette.orange);\n    addBlock(this.ctx, 0, this.ground(0, 70) + 0.4, 70, 14, 0.4, 4, this.ctx.palette.slate);\n    this.props.push({ tag: 'ledger-book', x: 168, z: -286, alive: true });\n    this.props.push({ tag: 'cage', x: 40, z: -164, alive: true });\n    this.props.push({ tag: 'pump', x: -330, z: 395, alive: true });\n    for (const [x, z] of [[410, -50], [440, -70], [455, -45]]) {\n      this.props.push({ tag: 'fuel-tank', x, z, alive: true });\n      addBlock(this.ctx, x, this.ground(x, z) + 1.5, z, 2.2, 3, 2.2, this.ctx.palette.slate);\n    }\n    this.props.push({ tag: 'convoy', x: 220, z: 450, alive: true, hp: 80 });\n    this.props.push({ tag: 'payroll', x: 220, z: 450, alive: true, hidden: true });\n    this.actors.push({\n      id: 'civil-1', kind: 'civil', x: -250, z: 230, hp: 40, alive: true, faction: 'civil', fleeing: false,\n    });\n  }\n\n  paintMapBase() {\n    const px = this.mapPx;\n    px.fill(0);\n    for (let i = 0; i < 320 * 240; i++) {\n      px[i * 4] = 196;\n      px[i * 4 + 1] = 154;\n      px[i * 4 + 2] = 96;\n      px[i * 4 + 3] = 255;\n    }\n  }\n\n  worldToMap(x, z) {\n    const mx = Math.floor(((x + 640) / 1280) * 300) + 8;\n    const my = Math.floor(((z + 640) / 1280) * 220) + 8;\n    return [mx, my];\n  }\n\n  stamp(x, z, r, g, b) {\n    const [mx, my] = this.worldToMap(x, z);\n    if (mx < 0 || my < 0 || mx >= 320 || my >= 240) return;\n    const i = (mx + my * 320) * 4;\n    this.mapPx[i] = r;\n    this.mapPx[i + 1] = g;\n    this.mapPx[i + 2] = b;\n    this.mapPx[i + 3] = 255;\n  }\n\n  refreshMap() {\n    const fire = this.fire;\n    if (this.scarTick === this._scarDrawn) {\n      const p = this.feet();\n      this.stamp(p.x, p.z, 240, 240, 240);\n      return;\n    }\n    this._scarDrawn = this.scarTick;\n    for (const i of fire.burntList) {\n      const ix = i % 256;\n      const iz = (i / 256) | 0;\n      const [x, z] = fire.center(ix, iz);\n      this.stamp(x, z, 30, 28, 36);\n    }\n    const p = this.feet();\n    this.stamp(p.x, p.z, 240, 240, 240);\n  }\n\n  mapHasScar() {\n    for (let i = 0; i < this.mapPx.length; i += 4) {\n      if (this.mapPx[i] < 40 && this.mapPx[i + 1] < 40 && this.mapPx[i + 2] < 50 && this.mapPx[i + 3] > 0) return true;\n    }\n    return false;\n  }\n\n  markSeen() {\n    const p = this.feet();\n    for (const s of SITES) if (Math.hypot(s.x - p.x, s.z - p.z) < 90) this.seen.add(s.id);\n  }\n\n  resetDynamic() {\n    this.fire.extinguish();\n    this.fire.state.fill(0);\n    this.fire.burning.length = 0;\n    this.fire.burntList.length = 0;\n    this.fire.burntCount = 0;\n    this.actors.length = 0;\n    this.dead = false;\n    this.carrying = null;\n    this.inVehicle = false;\n    this.mission = null;\n    this.lines = [];\n    this.choice = null;\n    this.subtitle = '';\n    this.feverOn = false;\n    this.surgeryT = 0;\n    this.rescueT = 0;\n    this.ending = null;\n    this.sheet = null;\n    this.spawnTown();\n  }\n\n  teleport(x, z) {\n    const y = this.ground(x, z) + 0.1;\n    if (this.inVehicle && this.car) this.car.reset([x, y + 1, z], this.car.yaw);\n    else this.hero.teleport([x, y, z]);\n    this.markSeen();\n  }\n\n  giveGun(id, cond) {\n    const gun = freshWeapon(id, cond);\n    if (!gun) return;\n    if (this.upgrades.has('belt') && gun.reserve) gun.reserve = Math.round(gun.reserve * 1.5);\n    const slot = gun.slot;\n    const at = this.guns.findIndex((g) => g.slot === slot);\n    if (at >= 0) this.guns[at] = gun;\n    else this.guns.push(gun);\n    this.unlocked.add(id);\n    this.slot = Math.max(0, this.guns.findIndex((g) => g.id === id));\n  }\n\n  get weapon() {\n    return this.guns[this.slot] || null;\n  }\n\n  hurt(amount, kind = 'bullet', force = false) {\n    if (this.dead) return;\n    if (this.god && !force) return;\n    const d = amount * TUNING.playerDamageTaken;\n    this.hp = Math.max(0, this.hp - d);\n    this.lastHurt = kind;\n    this.regenT = 5;\n    this.surgeryT = 0;\n    if (this.hp <= 0) this.down();\n  }\n\n  down() {\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\n    if (buddy) {\n      this.rescueT = 2.2;\n      this.rescueBuddy = buddy;\n      this.subtitle = line('buddy:rescue');\n      this.speaker = buddy.name;\n      return;\n    }\n    this.dead = true;\n    this.subtitle = line('death');\n    this.game.onDeath();\n  }\n\n  pay(amount) {\n    const n = Math.round(amount * TUNING.stonesReward);\n    this.stones += n;\n    this.ledger.stonesEarned += n;\n  }\n\n  applySetup(setup, deadIds = []) {\n    this.flags = new Set(setup.flags || []);\n    this.safehouses = new Set(setup.safehouses || []);\n    this.stones = setup.stones ?? 0;\n    this.tablets = setup.tablets ?? 0;\n    this.syrettes = setup.syrettes ?? 3;\n    this.hour = setup.hour ?? 9;\n    this.gameHours = this.hour;\n    this.truce = setup.truce !== false;\n    this.column = !!setup.column;\n    this.tracker = !!setup.tracker;\n    this.hp = 100;\n    this.dead = false;\n    this.feverOn = false;\n    this.feverIgnore = 0;\n    this.feverClear = 0;\n    this.feverT = setup.feverIn === 0 ? 0 : (TUNING.feverMinutes * 60);\n    this.guns = [];\n    for (const g of setup.guns || []) this.giveGun(g.id, g.cond);\n    if (!this.guns.find((g) => g.id === 'cane') && (setup.guns || []).length) this.giveGun('cane', 100);\n    this.buddies = (setup.buddies || []).map((id) => this.makeBuddy(id));\n    for (const id of deadIds) {\n      const b = this.buddies.find((x) => x.id === id);\n      if (b) {\n        b.alive = false;\n        b.down = false;\n        this.ledger.friends += 1;\n      } else this.buddies.push({ ...this.makeBuddy(id), alive: false, down: false, hp: 0 });\n    }\n    this.fire.extinguish();\n    this.fire.state.fill(0);\n    this.fire.burning.length = 0;\n    this.fire.burntList.length = 0;\n    this.fire.burntCount = 0;\n    this.paintMapBase();\n    for (const scar of setup.scars || []) this.layScar(scar);\n    this.sheet = setup.sheet || null;\n    this.ending = null;\n    this.choice = null;\n    this.choicePick = null;\n    this.lines = [];\n    this.carrying = null;\n    this.jamScript = 0;\n    this.shotCount = 0;\n    this.movedOnce = false;\n    this.civilians = 12;\n    this.provoked = false;\n    if (setup.truck) this.ensureTruck(setup.x + 6, setup.z);\n    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\n    this.subtitle = '';\n  }\n\n  makeBuddy(id) {\n    const d = BUDDY_DEF[id] || { name: id.toUpperCase(), hp: 200 };\n    return { id, name: d.name, hp: d.hp, max: d.hp, alive: true, down: false, downLeft: 0, trust: 1, spentUntil: 0, wound: false, burning: false };\n  }\n\n  layScar(id) {\n    const strip = STRIPS[id];\n    if (!strip) return;\n    this.fire.burnStrip(strip.points, strip.width);\n    this.refreshMap();\n  }\n\n  startMission(id, opts = {}) {\n    const m = missionById(id);\n    if (!m) return false;\n    const dead = opts.dead || [];\n    this.applySetup(m.setup || {}, dead);\n    this.mission = {\n      def: m,\n      index: 0,\n      done: false,\n      textT: 5,\n      hold: 0,\n      ride: 0,\n    };\n    this.pass = m.faction || null;\n    this.windPin = m.wind || null;\n    if (m.weather === 'storm') this.rain = true;\n    else this.rain = false;\n    if (m.hour !== undefined) this.hour = m.hour;\n    this.announceStep();\n    this.game.mode = 'play';\n    this.game.screen = 'play';\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\n    return true;\n  }\n\n  currentStep() {\n    if (!this.mission || this.mission.done) return null;\n    return this.mission.def.steps[this.mission.index] || null;\n  }\n\n  announceStep() {\n    const s = this.currentStep();\n    if (!s) return;\n    this.subtitle = s.text || '';\n    this.speaker = '';\n    this.mission.textT = 5;\n    this.mission.hold = 0;\n    this.mission.ride = 0;\n    if (s.do === 'lines') this.lines = [...s.ids];\n    if (s.do === 'choice') {\n      this.choice = { id: s.id, options: s.options, focus: 0 };\n      this.choicePick = null;\n    }\n    if (s.do === 'jam') this.jamScript = 5;\n    if (s.do === 'repair') {\n      this.ensureTruck(this.feet().x + 3, this.feet().z);\n      this.vehicleHp = 0;\n    }\n    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\n    if (s.do === 'buddy-down') this.knockBuddy();\n    if (s.do === 'fever-fall') {\n      this.feverT = 0;\n      this.tablets = 0;\n    }\n  }\n\n  knockBuddy() {\n    const b = this.buddies.find((x) => x.alive && !x.down);\n    if (!b) {\n      this.subtitle = line('buddy:burn');\n      this.completeStep();\n      return;\n    }\n    b.hp = 0;\n    b.down = true;\n    b.downLeft = 40;\n    b.burning = true;\n    b.x = this.feet().x + 1.2;\n    b.z = this.feet().z;\n    this.subtitle = line('buddy:burn');\n    this.speaker = b.name;\n  }\n\n  completeStep() {\n    if (!this.mission || this.mission.done) return;\n    this.mission.index += 1;\n    this.choice = null;\n    if (this.mission.index >= this.mission.def.steps.length) {\n      this.mission.done = true;\n      this.finishMission();\n      return;\n    }\n    this.announceStep();\n  }\n\n  finishMission() {\n    const m = this.mission.def;\n    for (const effect of m.onDone || []) {\n      if (effect.flag) this.flags.add(effect.flag);\n      if (effect.safehouse) this.safehouses.add(effect.safehouse);\n      if (effect.tablets) this.tablets += effect.tablets;\n      if (effect.pay) this.pay(effect.pay);\n      if (effect.scar) this.layScar(effect.scar);\n      if (effect.buddy) {\n        if (!this.buddies.some((b) => b.id === effect.buddy)) this.buddies.push(this.makeBuddy(effect.buddy));\n      }\n      if (effect.tracker) this.tracker = true;\n      if (effect.truce === false) this.truce = false;\n      if (effect.column) this.column = true;\n      if (effect.moveVillage) this.moveVillage();\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\n    }\n    this.pass = null;\n    this.windPin = null;\n    this.subtitle = m.title + ' DONE';\n  }\n\n  moveVillage() {\n    if (this.movedOnce) return;\n    this.movedOnce = true;\n    this.ledger.moved += this.civilians;\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\n  }\n\n  ensureTruck(x, z) {\n    if (this.car) return;\n    const y = this.ground(x, z) + 1.2;\n    this.car = new Vehicle(this.ctx.physics, {\n      at: [x, y, z],\n      yaw: 0,\n      size: [0.95, 0.45, 2.2],\n      mass: 12,\n      power: 160,\n      topSpeed: TUNING.vehicleTopSpeed,\n      wheelRadius: 0.42,\n      suspension: 0.45,\n      stiffness: 30,\n      grip: 2.6,\n    });\n    this.vehicleHp = 100;\n    this.vehicleKind = 'pickup';\n    this.truckX = x;\n    this.truckZ = z;\n  }\n\n  fixed(dt) {\n    this.clock += dt;\n    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\n    this.hour = ((this.gameHours % 24) + 24) % 24;\n    this.stepWind(dt);\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\n    this.fire.rain = this.rain;\n    this.fire.step(dt);\n    this.tickFever(dt);\n    this.tickBurn(dt);\n    this.tickRegen(dt);\n    this.tickActors(dt);\n    this.tickBuddies(dt);\n    this.tickPosts();\n    if (this.game.blocksSim()) return;\n    this.tickPlayer(dt);\n    this.tickMission(dt);\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\n  }\n\n  stepWind(dt) {\n    if (this.windPin) return;\n    const turn = (15 * Math.PI / 180) * (dt / 60);\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\n    this.windSpeed = clamp(this.windSpeed + (this.rng.next() - 0.5) * dt * 0.15, 0, 8);\n  }\n\n  tickFever(dt) {\n    if (this.game.mode !== 'play' && this.game.mode !== 'attract') return;\n    if (!this.feverOn) {\n      this.feverT -= dt;\n      if (this.feverT <= 0) {\n        this.feverOn = true;\n        this.feverIgnore = 0;\n        this.subtitle = line('fever');\n      }\n      return;\n    }\n    if (this.feverClear > 0) {\n      this.feverClear -= dt;\n      if (this.feverClear <= 0) {\n        this.feverOn = false;\n        const shrink = this.flags.has('m7') ? 2 : this.flags.has('m3') ? 1 : 0;\n        const mins = Math.max(2, TUNING.feverMinutes - shrink);\n        this.feverT = mins * 60;\n      }\n      return;\n    }\n    this.feverIgnore += dt;\n    if (this.feverIgnore >= 25) this.collapse();\n  }\n\n  collapse() {\n    this.feverOn = false;\n    this.feverIgnore = 0;\n    this.feverClear = 0;\n    const lost = this.stones * 0.2;\n    this.stones = Math.max(0, this.stones - lost);\n    this.hp = Math.max(this.hp, 30);\n    const home = this.nearestSafe();\n    this.teleport(home.x, home.z);\n    this.dead = false;\n    this.subtitle = 'YOU WAKE SHORT OF STONES.';\n    if (this.currentStep()?.do === 'fever-fall') this.completeStep();\n  }\n\n  nearestSafe() {\n    const p = this.feet();\n    let best = { x: 12, z: 55 };\n    let bd = Infinity;\n    const homes = [{ x: 12, z: 55 }, ...[...this.safehouses].map((id) => siteById(id)).filter(Boolean)];\n    for (const s of homes) {\n      const d = Math.hypot(s.x - p.x, s.z - p.z);\n      if (d < bd) {\n        bd = d;\n        best = s;\n      }\n    }\n    return best;\n  }\n\n  tickBurn(dt) {\n    const p = this.feet();\n    const cell = this.fire.cellAt(p.x, p.z);\n    const inFire = cell && this.fire.state[cell.i] === 1;\n    const wet = nearRiver(p.x, p.z, 8);\n    if (inFire && !wet) this.burning = 2;\n    else if (this.burning > 0) this.burning = Math.max(0, this.burning - dt);\n    if (this.burning > 0) this.hurt(TUNING.fireDamage * dt, 'fire', false);\n  }\n\n  tickRegen(dt) {\n    if (this.god || this.hp <= 0 || this.hp >= 100) return;\n    this.regenT -= dt;\n    if (this.regenT > 0) return;\n    const top = Math.min(100, Math.ceil(this.hp / 20) * 20);\n    if (this.hp < top) this.hp = Math.min(top, this.hp + 10 * dt);\n  }\n\n  tickActors(dt) {\n    const night = this.hour < 5.5 || this.hour >= 19;\n    const p = this.feet();\n    for (const a of this.actors) {\n      if (!a.alive) continue;\n      const cell = this.fire.cellAt(a.x, a.z);\n      if (cell && this.fire.state[cell.i] === 1 && a.kind === 'soldier') {\n        a.state = 'panic';\n        a.burnT = (a.burnT || 0) + dt;\n        a.x += Math.cos(a.burnT) * dt * 3;\n        a.z += Math.sin(a.burnT * 1.3) * dt * 3;\n        this.fire.ignite(a.x, a.z, 0);\n        if (a.burnT > 5) a.alive = false;\n        continue;\n      }\n      if (a.kind === 'civil') {\n        if (a.fleeing) {\n          a.x += dt * 2;\n          a.z += dt;\n        }\n        continue;\n      }\n      if (a.kind !== 'soldier') continue;\n      const see = this.soldierSees(a, p, night);\n      a.sees = see;\n      if (see && this.hostile(a)) {\n        a.react = (a.react || 0) + dt;\n        a.state = 'alert';\n        if (a.react >= TUNING.enemyReaction) {\n          const dist = Math.hypot(a.x - p.x, a.z - p.z);\n          this.aimError = (1.2 + (5 - 1.2) * Math.min(1, dist / 80)) / TUNING.enemyAccuracy;\n          if (this.rng.next() < 0.5 * dt * 4) this.hurt(9, 'bullet', false);\n        }\n      } else {\n        a.react = 0;\n        a.state = see ? 'suspicious' : 'idle';\n      }\n    }\n  }\n\n  soldierSees(a, p, night) {\n    if (this.invisible) return false;\n    let range = TUNING.enemyVision;\n    if (this.crouch) range *= 0.55;\n    if (night) range *= 0.45;\n    if (this.burning > 0) range *= 2;\n    const dist = Math.hypot(a.x - p.x, a.z - p.z);\n    if (dist > range) return false;\n    const ang = Math.atan2(p.x - a.x, p.z - a.z);\n    let diff = Math.abs(ang - (a.yaw || 0));\n    while (diff > Math.PI) diff = Math.abs(diff - Math.PI * 2);\n    return diff < (120 * Math.PI) / 360;\n  }\n\n  hostile(a) {\n    if (a.kind === 'civil') return false;\n    if (this.pass && a.faction === this.pass && !this.provoked) return false;\n    if (this.truce && this.inTown(a.x, a.z)) return false;\n    return true;\n  }\n\n  inTown(x, z) {\n    return this.truce && Math.hypot(x, z - 40) < 70;\n  }\n\n  tickBuddies(dt) {\n    for (const b of this.buddies) {\n      if (!b.alive || !b.down) continue;\n      b.downLeft -= dt;\n      if (b.downLeft <= 0) {\n        b.alive = false;\n        b.down = false;\n        this.ledger.friends += 1;\n        if (this.currentStep()?.do === 'buddy-down') this.completeStep();\n      }\n    }\n    if (this.rescueT > 0) {\n      this.rescueT -= dt;\n      if (this.rescueT <= 0 && this.rescueBuddy) {\n        const mags = this.rescueBuddy.id === 'mags';\n        this.hp = mags ? 60 : 40;\n        this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60;\n        if (this.rng.next() < TUNING.buddyWoundChance) {\n          this.rescueBuddy.wound = true;\n          this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60 * 2;\n        }\n        this.rescueBuddy = null;\n        this.dead = false;\n      }\n    }\n  }\n\n  tickPosts() {\n    for (const post of this.posts) {\n      if (post.alive || post.clearedAt == null) continue;\n      if (this.gameHours - post.clearedAt >= TUNING.postRemanHours) {\n        post.alive = true;\n        post.clearedAt = null;\n      }\n    }\n  }\n\n  tickPlayer(dt) {\n    if (this.dead && this.rescueT <= 0) return;\n    const input = this.ctx.input;\n    const bot = this.game.mode === 'attract' ? this.game.bot : null;\n    if (this.surgeryT > 0) {\n      this.surgeryT -= dt;\n      if (this.surgeryT <= 0) this.hp = 40;\n      return;\n    }\n    if (this.rescueT > 0) return;\n    this.readNeeds(dt, input, bot);\n    if (this.choice) return;\n    const p = this.feet();\n    const wading = nearRiver(p.x, p.z, 8) && !onBridge(p.x, p.z);\n    let speed = 5.4;\n    if (this.crouch) speed = 2;\n    else if (this.walk) speed = 3.6;\n    const sprinting = this.sprint && this.stamina > 0 && !wading && !this.carrying;\n    if (sprinting) speed = 7.4;\n    if (wading) speed = 2.7;\n    if (this.carrying) speed *= 0.85;\n    speed *= TUNING.playerSpeed;\n    if (sprinting && (bot ? bot.move : true)) this.stamina = Math.max(0, this.stamina - dt);\n    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\n    this.hero.speed = speed;\n    const yaw = this.ctx.camera.yaw || 0;\n    let ax = 0;\n    let ay = 0;\n    if (bot) {\n      ax = bot.x || 0;\n      ay = bot.y || 0;\n    } else if (!this.map.up) {\n      const m = input.moveAxis();\n      ax = m.x;\n      ay = m.y;\n    }\n    const fx = -Math.sin(yaw);\n    const fz = -Math.cos(yaw);\n    const rx = Math.cos(yaw);\n    const rz = -Math.sin(yaw);\n    MOVE.set(fx * ay + rx * ax, 0, fz * ay + rz * ax);\n    if (MOVE.length() > 1) MOVE.normalize();\n    const jump = !!(bot ? bot.jump : consumeAction(input, 'jump'));\n    if (!this.inVehicle && !this.noclip) {\n      this.hero.setInput(MOVE, jump, jump);\n      this.hero.fixedUpdate(dt);\n    } else if (this.noclip) {\n      const f = this.hero.feet;\n      this.hero.teleport([f.x + MOVE.x * dt * 12, f.y, f.z + MOVE.z * dt * 12]);\n    }\n    if (this.inVehicle && this.car) this.drive(dt, input, bot, ax, ay);\n    if (!bot) this.combat(dt, input);\n    this.nearPrompt();\n  }\n\n  drive(dt, input, bot, ax, ay) {\n    this.car.o.topSpeed = TUNING.vehicleTopSpeed * (this.vehicleHp < 35 ? 0.6 : 1);\n    const throttle = this.vehicleHp <= 0 ? 0 : (bot ? (bot.y || 0) : ay);\n    const steer = bot ? (bot.x || 0) : ax;\n    this.car.drive({ throttle, steer, brake: throttle < 0, handbrake: false }, dt);\n    if (this.vehicleHp < 10 && this.vehicleHp > 0 && this.burning > 0) {\n      this.explodeT += dt;\n      if (this.explodeT > 8) {\n        this.vehicleHp = 0;\n        const t = this.car.body.translation();\n        this.fire.ignite(t.x, t.z, 6);\n      }\n    }\n  }\n\n  readNeeds(dt, input, bot) {\n    if (bot) return;\n    if (consumeAction(input, 'crouch')) this.crouch = !this.crouch;\n    if (input.consumePress('CapsLock')) this.walk = !this.walk;\n    this.sprint = heldAction(input, 'sprint') || input.isDown('ShiftLeft');\n    if (consumeAction(input, 'map')) this.map.up = !this.map.up;\n    if (this.map.up) this.map.anim = Math.min(1, this.map.anim + dt / 0.4);\n    else this.map.anim = Math.max(0, this.map.anim - dt / 0.4);\n    if (this.feverOn && (heldAction(input, 'tablet') || input.isDown('KeyH'))) {\n      this.holdT.tablet += dt;\n      if (this.holdT.tablet >= 1 && this.tablets > 0) {\n        this.tablets -= 1;\n        this.feverClear = 5;\n        this.holdT.tablet = 0;\n        if (this.currentStep()?.do === 'tablet') this.completeStep();\n      }\n    } else this.holdT.tablet = 0;\n    const healHeld = heldAction(input, 'heal') || input.isDown('KeyQ');\n    if (this.hp < 20 && this.hp > 0 && consumeAction(input, 'heal')) {\n      this.surgeryT = 4;\n      this.subtitle = this.lastHurt === 'fire' ? 'THE LIGHTER' : 'HOLD STILL.';\n    } else if (healHeld && this.syrettes > 0 && this.hp >= 20) {\n      this.holdT.heal += dt;\n      if (this.holdT.heal >= 0.8) {\n        this.syrettes -= 1;\n        this.hp = Math.min(100, this.hp + 40);\n        this.holdT.heal = 0;\n        if (this.currentStep()?.do === 'syrette') this.completeStep();\n      }\n    } else this.holdT.heal = 0;\n  }\n\n  combat(dt, input) {\n    const gun = this.weapon;\n    if (gun) gun.cooldown = Math.max(0, gun.cooldown - dt);\n    const want = heldAction(input, 'fire') || input.isDown('MouseLeft');\n    const tap = consumeAction(input, 'fire');\n    if (!gun || this.sprint) return;\n    const def = WEAPON_BY_ID[gun.id];\n    const auto = !!(def && def.auto);\n    if (!(auto ? want : tap)) return;\n    if (gun.cooldown > 0) return;\n    if (this.inTown(this.feet().x, this.feet().z) && this.truce) return;\n    if (gun.jammed) {\n      this.prompt = 'JAMMED';\n      return;\n    }\n    if (gun.magSize > 0 && gun.mag <= 0) return;\n    this.fireGun(gun, def);\n  }\n\n  fireGun(gun, def) {\n    const rate = def.rate || 1;\n    gun.cooldown = 1 / rate;\n    if (!this.infAmmo && gun.magSize > 0) gun.mag -= 1;\n    gun.shots += 1;\n    this.shotCount += 1;\n    const wear = (def.wear || 0) * TUNING.wearRate * (this.upgrades.has('clean') ? 0.6 : 1);\n    gun.cond = Math.max(0, gun.cond - wear);\n    if (gun.cond <= 0) {\n      this.breakGun();\n      return;\n    }\n    const jamP = this.noJam ? 0 : TUNING.jamRate * 0.12 * (1 - gun.cond / 100) ** 2;\n    const script = this.jamScript && gun.shots >= this.jamScript;\n    if (script || this.rng.next() < jamP) {\n      gun.jammed = true;\n      gun.jamLeft = 2 + Math.floor(this.rng.next() * 3);\n      this.jamScript = 0;\n    }\n    this.resolveShot(def);\n    this.provoked = true;\n  }\n\n  breakGun() {\n    const gun = this.weapon;\n    if (!gun) return;\n    this.guns.splice(this.slot, 1);\n    this.slot = Math.max(0, this.guns.length - 1);\n    this.subtitle = 'THE GUN COMES APART.';\n  }\n\n  resolveShot(def) {\n    const p = this.feet();\n    const yaw = this.ctx.camera.yaw || 0;\n    const dx = -Math.sin(yaw);\n    const dz = -Math.cos(yaw);\n    const range = def.range || 40;\n    if (def.ignite || def.blast) {\n      const x = p.x + dx * Math.min(range, 18);\n      const z = p.z + dz * Math.min(range, 18);\n      this.fire.ignite(x, z, def.ignite || def.blast || 1);\n      this.fire.litByPlayer += 1;\n      this.damagePoint(x, z, def.damage * TUNING.weaponDamage, def.blast || 2);\n      return;\n    }\n    this.damageRay(p, dx, dz, range, (def.damage || 10) * TUNING.weaponDamage);\n  }\n\n  damageRay(p, dx, dz, range, dmg) {\n    let best = null;\n    let bd = range;\n    for (const a of this.actors) {\n      if (!a.alive) continue;\n      const ox = a.x - p.x;\n      const oz = a.z - p.z;\n      const along = ox * dx + oz * dz;\n      if (along < 0 || along > bd) continue;\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\n      if (lat < 0.8) {\n        best = a;\n        bd = along;\n      }\n    }\n    for (const prop of this.props) {\n      if (!prop.alive) continue;\n      const ox = prop.x - p.x;\n      const oz = prop.z - p.z;\n      const along = ox * dx + oz * dz;\n      if (along < 0 || along > range) continue;\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\n      if (lat < 1.4) this.damageProp(prop, dmg);\n    }\n    if (best) this.damageActor(best, dmg);\n  }\n\n  damagePoint(x, z, dmg, r) {\n    for (const a of this.actors) {\n      if (!a.alive) continue;\n      if (Math.hypot(a.x - x, a.z - z) <= r + 1) this.damageActor(a, dmg);\n    }\n    for (const prop of this.props) {\n      if (!prop.alive) continue;\n      if (Math.hypot(prop.x - x, prop.z - z) <= r + 1.5) this.damageProp(prop, dmg);\n    }\n    if (this.vehicleHp > 0 && this.car && !this.inVehicle) {\n      const t = this.car.body.translation();\n      if (Math.hypot(t.x - x, t.z - z) < r + 2) this.vehicleHp = Math.max(0, this.vehicleHp - dmg / TUNING.vehicleToughness);\n    }\n  }\n\n  damageActor(a, dmg) {\n    if (a.kind === 'civil') {\n      a.fleeing = true;\n      return;\n    }\n    a.hp -= dmg;\n    if (a.hp <= 0 && a.alive) {\n      a.alive = false;\n      if (a.kind === 'soldier') this.ledger.killed += 1;\n      const step = this.currentStep();\n      if (step && step.do === 'clear') {\n        const left = this.actors.filter((x) => x.alive && x.post === step.tag).length;\n        if (left <= 0) this.completeStep();\n      }\n    }\n  }\n\n  damageProp(prop, dmg) {\n    prop.hp = (prop.hp || 40) - dmg;\n    const step = this.currentStep();\n    if (prop.hp > 0 && !(step && step.do === 'destroy' && prop.tag === step.tag && (prop.tag === 'fuel-tank' || prop.tag === 'pump'))) {\n      if (prop.tag === 'fuel-tank' || prop.tag === 'pump' || prop.tag === 'convoy') {\n        if (prop.hp > 0) return;\n      } else return;\n    }\n    if (prop.hp > 0 && prop.tag !== 'fuel-tank' && prop.tag !== 'pump' && prop.tag !== 'convoy') return;\n    if (!prop.alive) return;\n    if (prop.hp > 0 && step && step.do === 'destroy' && prop.tag === step.tag) {\n      prop.alive = false;\n    } else if (prop.hp <= 0) prop.alive = false;\n    else return;\n    this.fire.ignite(prop.x, prop.z, 4);\n    if (prop.tag === 'convoy') {\n      const pay = this.props.find((p) => p.tag === 'payroll');\n      if (pay) pay.hidden = false;\n    }\n    if (step && step.do === 'destroy' && prop.tag === step.tag) {\n      const left = this.props.filter((p) => p.alive && p.tag === step.tag).length;\n      if (left < (step.n || 1)) this.completeStep();\n    }\n  }\n\n  tryReload() {\n    const gun = this.weapon;\n    if (!gun) return;\n    if (gun.jammed) {\n      gun.jamLeft -= 1;\n      if (gun.jamLeft <= 0) gun.jammed = false;\n      if (this.currentStep()?.do === 'jam' && !gun.jammed && gun.shots >= 5) this.completeStep();\n      return;\n    }\n    const need = gun.magSize - gun.mag;\n    if (need <= 0 || gun.reserve <= 0) return;\n    const take = Math.min(need, gun.reserve);\n    gun.mag += take;\n    gun.reserve -= take;\n  }\n\n  tryUse(dt, input) {\n    const pressed = consumeAction(input, 'use');\n    const held = heldAction(input, 'use') || input.isDown('KeyE');\n    if (!pressed && !held) {\n      this.holdT.use = 0;\n      return;\n    }\n    const p = this.feet();\n    const buddy = this.buddies.find((b) => b.alive && b.down && Math.hypot((b.x || p.x) - p.x, (b.z || p.z) - p.z) < 2.5);\n    if (buddy && pressed && this.syrettes > 0 && !buddy.burning) {\n      this.syrettes -= 1;\n      buddy.down = false;\n      buddy.hp = buddy.max * 0.5;\n      buddy.trust += 1;\n      buddy.burning = false;\n      if (this.currentStep()?.do === 'buddy-down') this.completeStep();\n      return;\n    }\n    if (this.map.up && pressed) {\n      this.pickWaypoint();\n      return;\n    }\n    const truckNear = this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4;\n    if (truckNear && this.vehicleHp < 50 && held) {\n      this.holdT.use += dt || 0.016;\n      const need = this.upgrades.has('vkit') ? 1.5 : 3;\n      if (this.holdT.use >= need) {\n        this.vehicleHp = 50;\n        this.holdT.use = 0;\n        if (this.currentStep()?.do === 'repair') this.completeStep();\n      }\n      return;\n    }\n    if (!pressed) return;\n    if (truckNear && !this.inVehicle && this.vehicleHp >= 50) {\n      this.inVehicle = true;\n      this.hero.collider.setEnabled(false);\n      return;\n    }\n    if (this.inVehicle) {\n      this.inVehicle = false;\n      this.hero.collider.setEnabled(true);\n      const t = this.truckPos();\n      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\n      return;\n    }\n    const step = this.currentStep();\n    if (step && step.do === 'use') {\n      const prop = this.props.find((pr) => pr.tag === step.tag && pr.alive !== false);\n      if (prop && Math.hypot(prop.x - p.x, prop.z - p.z) < 3) {\n        prop.used = true;\n        if (step.tag === 'cage') {\n          if (!this.buddies.some((b) => b.id === 'ines')) this.buddies.push(this.makeBuddy('ines'));\n        }\n        if (step.tag === 'ledger-book') prop.alive = false;\n        this.completeStep();\n        return;\n      }\n    }\n    for (const trig of TRIGS) {\n      if (Math.hypot(trig.x - p.x, trig.z - p.z) < 3 && !this.flags.has(trig.id)) {\n        this.flags.add(trig.id);\n        this.notes += 1;\n        this.subtitle = 'A NOTE IN THE MARGIN.';\n        if (this.notes >= 6) this.giveGun('empire', 100);\n        return;\n      }\n    }\n    for (const c of this.cases) {\n      if (c.taken) continue;\n      if (Math.hypot(c.x - p.x, c.z - p.z) < 2.2) {\n        c.taken = true;\n        this.carrying = c;\n        if (this.currentStep()?.do === 'collect') this.completeStep();\n        return;\n      }\n    }\n  }\n\n  truckPos() {\n    if (!this.car) return { x: this.truckX || 0, z: this.truckZ || 0 };\n    const t = this.car.body.translation();\n    return { x: t.x, z: t.z };\n  }\n\n  pickWaypoint() {\n    let best = null;\n    let bd = 18;\n    for (const s of SITES) {\n      if (!this.seen.has(s.id) && s.kind !== 'town') continue;\n      const d = Math.hypot(s.x - this.map.cx, s.z - this.map.cz);\n      if (d < bd) {\n        bd = d;\n        best = s;\n      }\n    }\n    if (best) this.waypoint = { x: best.x, z: best.z, id: best.id };\n  }\n\n  nearPrompt() {\n    const p = this.feet();\n    const step = this.currentStep();\n    if (this.feverOn && this.tablets > 0) {\n      this.prompt = 'TABLET';\n      return;\n    }\n    const down = this.buddies.find((b) => b.alive && b.down);\n    if (down) {\n      this.prompt = this.syrettes > 0 && !down.burning ? 'SYRETTE OR FINISH IT' : 'FINISH IT';\n      return;\n    }\n    if (this.hp < 20 && this.hp > 0) {\n      this.prompt = 'FIELD SURGERY';\n      return;\n    }\n    if (step?.text && this.mission?.textT > 0) {\n      this.prompt = step.text;\n      return;\n    }\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4) {\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\n      return;\n    }\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\n  }\n\n  tickMission(dt) {\n    const step = this.currentStep();\n    if (!step || !this.mission) return;\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\n    const p = this.feet();\n    if (step.do === 'goto' || step.do === 'drive') {\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\n    } else if (step.do === 'leave') {\n      const target = siteById(step.site);\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\n    } else if (step.do === 'burn') {\n      const cell = this.fire.cellAt(step.x, step.z);\n      const hot = cell && (this.fire.state[cell.i] === 1 || this.fire.state[cell.i] === 2);\n      if (hot) this.completeStep();\n    } else if (step.do === 'hold') {\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\n      if (this.mission.hold >= step.time) this.completeStep();\n    } else if (step.do === 'ride') {\n      this.riding = true;\n      this.mission.ride += dt;\n      if (this.mission.ride >= step.time) {\n        this.riding = false;\n        this.completeStep();\n      }\n    } else if (step.do === 'report') {\n      const site = siteById(step.to);\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\n        this._reported = false;\n        this.completeStep();\n      }\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\n      this._linesDone = false;\n      this.completeStep();\n    } else if (step.do === 'choice' && this.choicePick) {\n      const pick = this.choicePick;\n      this.choicePick = null;\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\n      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\n      this.completeStep();\n    }\n  }\n\n  advanceLines() {\n    if (this.lines.length) {\n      const id = this.lines.shift();\n      this.subtitle = line(id);\n      this.speaker = id.split(':')[0].toUpperCase();\n      if (this.lines.length === 0) this._linesDone = true;\n      return true;\n    }\n    return false;\n  }\n\n  spawnSoldier(o) {\n    const hp = 100 * TUNING.enemyHealth;\n    const s = {\n      id: o.id || 'sol-' + this.actors.length,\n      kind: 'soldier',\n      faction: o.faction || 'concord',\n      x: o.x, z: o.z, yaw: o.yaw || 0,\n      hp, max: hp, alive: true, state: 'idle', post: o.post || null,\n    };\n    this.actors.push(s);\n    return s;\n  }\n\n  clearPost(id) {\n    const post = this.posts.find((p) => p.id === id);\n    if (!post) return;\n    post.alive = false;\n    post.clearedAt = this.gameHours;\n  }\n\n  jamChance(cond) {\n    return TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\n  }\n\n  hectares() {\n    return this.fire.burntCount * 0.0025;\n  }\n\n  trackerRate(x, z) {\n    let best = Infinity;\n    for (const c of this.cases) {\n      if (c.taken) continue;\n      const d = Math.hypot(c.x - x, c.z - z);\n      if (d < best) best = d;\n    }\n    if (best > 60) return 0;\n    return 0.4 + (1 - best / 60) * 6;\n  }\n}\n\nfunction clamp(v, a, b) {\n  return v < a ? a : v > b ? b : v;\n}\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1006,"output_tokens":17023,"cache_read_input_tokens":201984,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"413c5d28-04f7-4273-9a9a-d6720848f2f5"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-ef51d44f-acbc-40a5-ab52-ea57921baa06-88","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { CharacterController, THREE, Vehicle } from '../../pixel-engine.js';\\nimport { TUNING } from '../core/tuning.js';\\nimport { consumeAction, heldAction } from '../core/actions.js';\\nimport { CASES, POSTS, SITES, STRIPS, TRIGS, siteById } from '../content/sites.js';\\nimport { missionById } from '../content/missions.js';\\nimport { WEAPON_BY_ID, freshWeapon } from '../content/weapons.js';\\nimport { onBridge, nearRiver } from '../content/roads.js';\\nimport { FireGrid } from '../world/fire.js';\\nimport { addBlock, buildLand, fillFuel, paintScar } from '../world/terrain.js';\\nimport { line } from '../content/dialogue.js';\\n\\nconst { Vector3 } = THREE;\\nconst MOVE = new Vector3();\\n\\nconst BUDDY_DEF = {\\n  ines: { name: 'INES CARVALHO', hp: 200 },\\n  dov: { name: 'DOV HALPERN', hp: 200 },\\n  mags: { name: 'MAGS OYELARAN', hp: 200 },\\n};\\n\\nexport class World {\\n  constructor(game, ctx) {\\n    this.game = game;\\n    this.ctx = ctx;\\n    this.rng = ctx.random.fork('world');\\n    this.fire = new FireGrid(ctx.random.fork('fire'));\\n    this.fire.onBurnt = (ix, iz) => {\\n      if (this.land) paintScar(this.land, ix, iz);\\n      this.scarTick = (this.scarTick || 0) + 1;\\n    };\\n    this.heroes = null;\\n    this.land = null;\\n    this.heights = null;\\n    this.hp = 100;\\n    this.stones = 0;\\n    this.tablets = 0;\\n    this.syrettes = 3;\\n    this.syretteMax = 3;\\n    this.hour = 9;\\n    this.gameHours = 9;\\n    this.windDir = 0.4;\\n    this.windSpeed = 3;\\n    this.windPin = null;\\n    this.rain = false;\\n    this.weather = 'clear';\\n    this.guns = [];\\n    this.slot = 0;\\n    this.unlocked = new Set(['cane', 'm38']);\\n    this.upgrades = new Set();\\n    this.flags = new Set();\\n    this.safehouses = new Set();\\n    this.seen = new Set(['mile-forty', 'clinic']);\\n    this.notes = 0;\\n    this.tracker = false;\\n    this.truce = true;\\n    this.column = false;\\n    this.pass = null;\\n    this.provoked = false;\\n    this.buddies = [];\\n    this.actors = [];\\n    this.props = [];\\n    this.cases = [];\\n    this.posts = POSTS.map((p) => ({ ...p, alive: true, clearedAt: null }));\\n    this.trucks = [];\\n    this.car = null;\\n    this.inVehicle = false;\\n    this.vehicleHp = 100;\\n    this.vehicleKind = null;\\n    this.repairT = 0;\\n    this.explodeT = 0;\\n    this.carrying = null;\\n    this.waypoint = null;\\n    this.map = { up: false, anim: 0, cx: 0, cz: 40, zoom: 1 };\\n    this.mapPx = new Uint8Array(320 * 240 * 4);\\n    this.feverT = 12 * 60;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.holdT = { tablet: 0, heal: 0, use: 0 };\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.rescueBuddy = null;\\n    this.dead = false;\\n    this.god = false;\\n    this.noJam = false;\\n    this.infAmmo = false;\\n    this.invisible = false;\\n    this.noclip = false;\\n    this.crouch = false;\\n    this.walk = false;\\n    this.sprint = false;\\n    this.stamina = 6;\\n    this.burning = 0;\\n    this.regenT = 0;\\n    this.lastHurt = 'bullet';\\n    this.shotCount = 0;\\n    this.jamScript = 0;\\n    this.mission = null;\\n    this.stepT = 0;\\n    this.lines = [];\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.subtitle = '';\\n    this.speaker = '';\\n    this.prompt = '';\\n    this.ledger = { killed: 0, friends: 0, moved: 0, stonesEarned: 0 };\\n    this.clock = 0;\\n    this.rideT = 0;\\n    this.riding = false;\\n    this.heard = { spot: false };\\n    this.aimError = 0;\\n    this.sheet = null;\\n    this.ending = null;\\n    this.civilians = 12;\\n    this.movedOnce = false;\\n  }\\n\\n  build() {\\n    const built = buildLand(this.ctx, this.ctx.random.fork('land').state);\\n    this.land = built.land;\\n    this.heights = built.heights;\\n    fillFuel(this.fire, this.heights);\\n    const y = this.ground(0, 40);\\n    this.hero = new CharacterController(this.ctx.physics, {\\n      position: [0, y + 0.05, 40],\\n      speed: 5.4,\\n      jumpSpeed: 8,\\n      gravity: -24,\\n      radius: 0.35,\\n      halfHeight: 0.55,\\n    });\\n    this.paintMapBase();\\n    this.spawnTown();\\n    for (const c of CASES) this.cases.push({ ...c, taken: false });\\n    this.markSeen();\\n  }\\n\\n  ground(x, z) {\\n    if (this.land) return this.land.heightAt(x, z);\\n    if (this.heights) return this.heights(x, z);\\n    return 40;\\n  }\\n\\n  feet() {\\n    if (this.inVehicle && this.car) {\\n      const t = this.car.body.translation();\\n      return { x: t.x, y: t.y, z: t.z };\\n    }\\n    const f = this.hero.feet;\\n    return { x: f.x, y: f.y, z: f.z };\\n  }\\n\\n  spawnTown() {\\n    const y = this.ground(12, 55);\\n    addBlock(this.ctx, 12, y + 1.2, 55, 6, 2.4, 4, this.ctx.palette.white);\\n    addBlock(this.ctx, -18, this.ground(-18, 62) + 1.1, 62, 5, 2.2, 4, this.ctx.palette.orange);\\n    addBlock(this.ctx, 0, this.ground(0, 70) + 0.4, 70, 14, 0.4, 4, this.ctx.palette.slate);\\n    this.props.push({ tag: 'ledger-book', x: 168, z: -286, alive: true });\\n    this.props.push({ tag: 'cage', x: 40, z: -164, alive: true });\\n    this.props.push({ tag: 'pump', x: -330, z: 395, alive: true });\\n    for (const [x, z] of [[410, -50], [440, -70], [455, -45]]) {\\n      this.props.push({ tag: 'fuel-tank', x, z, alive: true });\\n      addBlock(this.ctx, x, this.ground(x, z) + 1.5, z, 2.2, 3, 2.2, this.ctx.palette.slate);\\n    }\\n    this.props.push({ tag: 'convoy', x: 220, z: 450, alive: true, hp: 80 });\\n    this.props.push({ tag: 'payroll', x: 220, z: 450, alive: true, hidden: true });\\n    this.actors.push({\\n      id: 'civil-1', kind: 'civil', x: -250, z: 230, hp: 40, alive: true, faction: 'civil', fleeing: false,\\n    });\\n  }\\n\\n  paintMapBase() {\\n    const px = this.mapPx;\\n    px.fill(0);\\n    for (let i = 0; i < 320 * 240; i++) {\\n      px[i * 4] = 196;\\n      px[i * 4 + 1] = 154;\\n      px[i * 4 + 2] = 96;\\n      px[i * 4 + 3] = 255;\\n    }\\n  }\\n\\n  worldToMap(x, z) {\\n    const mx = Math.floor(((x + 640) / 1280) * 300) + 8;\\n    const my = Math.floor(((z + 640) / 1280) * 220) + 8;\\n    return [mx, my];\\n  }\\n\\n  stamp(x, z, r, g, b) {\\n    const [mx, my] = this.worldToMap(x, z);\\n    if (mx < 0 || my < 0 || mx >= 320 || my >= 240) return;\\n    const i = (mx + my * 320) * 4;\\n    this.mapPx[i] = r;\\n    this.mapPx[i + 1] = g;\\n    this.mapPx[i + 2] = b;\\n    this.mapPx[i + 3] = 255;\\n  }\\n\\n  refreshMap() {\\n    const fire = this.fire;\\n    if (this.scarTick === this._scarDrawn) {\\n      const p = this.feet();\\n      this.stamp(p.x, p.z, 240, 240, 240);\\n      return;\\n    }\\n    this._scarDrawn = this.scarTick;\\n    for (const i of fire.burntList) {\\n      const ix = i % 256;\\n      const iz = (i / 256) | 0;\\n      const [x, z] = fire.center(ix, iz);\\n      this.stamp(x, z, 30, 28, 36);\\n    }\\n    const p = this.feet();\\n    this.stamp(p.x, p.z, 240, 240, 240);\\n  }\\n\\n  mapHasScar() {\\n    for (let i = 0; i < this.mapPx.length; i += 4) {\\n      if (this.mapPx[i] < 40 && this.mapPx[i + 1] < 40 && this.mapPx[i + 2] < 50 && this.mapPx[i + 3] > 0) return true;\\n    }\\n    return false;\\n  }\\n\\n  markSeen() {\\n    const p = this.feet();\\n    for (const s of SITES) if (Math.hypot(s.x - p.x, s.z - p.z) < 90) this.seen.add(s.id);\\n  }\\n\\n  resetDynamic() {\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.actors.length = 0;\\n    this.dead = false;\\n    this.carrying = null;\\n    this.inVehicle = false;\\n    this.mission = null;\\n    this.lines = [];\\n    this.choice = null;\\n    this.subtitle = '';\\n    this.feverOn = false;\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.ending = null;\\n    this.sheet = null;\\n    this.spawnTown();\\n  }\\n\\n  teleport(x, z) {\\n    const y = this.ground(x, z) + 0.1;\\n    if (this.inVehicle && this.car) this.car.reset([x, y + 1, z], this.car.yaw);\\n    else this.hero.teleport([x, y, z]);\\n    this.markSeen();\\n  }\\n\\n  giveGun(id, cond) {\\n    const gun = freshWeapon(id, cond);\\n    if (!gun) return;\\n    if (this.upgrades.has('belt') && gun.reserve) gun.reserve = Math.round(gun.reserve * 1.5);\\n    const slot = gun.slot;\\n    const at = this.guns.findIndex((g) => g.slot === slot);\\n    if (at >= 0) this.guns[at] = gun;\\n    else this.guns.push(gun);\\n    this.unlocked.add(id);\\n    this.slot = Math.max(0, this.guns.findIndex((g) => g.id === id));\\n  }\\n\\n  get weapon() {\\n    return this.guns[this.slot] || null;\\n  }\\n\\n  hurt(amount, kind = 'bullet', force = false) {\\n    if (this.dead) return;\\n    if (this.god && !force) return;\\n    const d = amount * TUNING.playerDamageTaken;\\n    this.hp = Math.max(0, this.hp - d);\\n    this.lastHurt = kind;\\n    this.regenT = 5;\\n    this.surgeryT = 0;\\n    if (this.hp <= 0) this.down();\\n  }\\n\\n  down() {\\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\\n    if (buddy) {\\n      this.rescueT = 2.2;\\n      this.rescueBuddy = buddy;\\n      this.subtitle = line('buddy:rescue');\\n      this.speaker = buddy.name;\\n      return;\\n    }\\n    this.dead = true;\\n    this.subtitle = line('death');\\n    this.game.onDeath();\\n  }\\n\\n  pay(amount) {\\n    const n = Math.round(amount * TUNING.stonesReward);\\n    this.stones += n;\\n    this.ledger.stonesEarned += n;\\n  }\\n\\n  applySetup(setup, deadIds = []) {\\n    this.flags = new Set(setup.flags || []);\\n    this.safehouses = new Set(setup.safehouses || []);\\n    this.stones = setup.stones ?? 0;\\n    this.tablets = setup.tablets ?? 0;\\n    this.syrettes = setup.syrettes ?? 3;\\n    this.hour = setup.hour ?? 9;\\n    this.gameHours = this.hour;\\n    this.truce = setup.truce !== false;\\n    this.column = !!setup.column;\\n    this.tracker = !!setup.tracker;\\n    this.hp = 100;\\n    this.dead = false;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.feverT = setup.feverIn === 0 ? 0 : (TUNING.feverMinutes * 60);\\n    this.guns = [];\\n    for (const g of setup.guns || []) this.giveGun(g.id, g.cond);\\n    if (!this.guns.find((g) => g.id === 'cane') && (setup.guns || []).length) this.giveGun('cane', 100);\\n    this.buddies = (setup.buddies || []).map((id) => this.makeBuddy(id));\\n    for (const id of deadIds) {\\n      const b = this.buddies.find((x) => x.id === id);\\n      if (b) {\\n        b.alive = false;\\n        b.down = false;\\n        this.ledger.friends += 1;\\n      } else this.buddies.push({ ...this.makeBuddy(id), alive: false, down: false, hp: 0 });\\n    }\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.paintMapBase();\\n    for (const scar of setup.scars || []) this.layScar(scar);\\n    this.sheet = setup.sheet || null;\\n    this.ending = null;\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.lines = [];\\n    this.carrying = null;\\n    this.jamScript = 0;\\n    this.shotCount = 0;\\n    this.movedOnce = false;\\n    this.civilians = 12;\\n    this.provoked = false;\\n    if (setup.truck) this.ensureTruck(setup.x + 6, setup.z);\\n    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\\n    this.subtitle = '';\\n  }\\n\\n  makeBuddy(id) {\\n    const d = BUDDY_DEF[id] || { name: id.toUpperCase(), hp: 200 };\\n    return { id, name: d.name, hp: d.hp, max: d.hp, alive: true, down: false, downLeft: 0, trust: 1, spentUntil: 0, wound: false, burning: false };\\n  }\\n\\n  layScar(id) {\\n    const strip = STRIPS[id];\\n    if (!strip) return;\\n    this.fire.burnStrip(strip.points, strip.width);\\n    this.refreshMap();\\n  }\\n\\n  startMission(id, opts = {}) {\\n    const m = missionById(id);\\n    if (!m) return false;\\n    const dead = opts.dead || [];\\n    this.applySetup(m.setup || {}, dead);\\n    this.mission = {\\n      def: m,\\n      index: 0,\\n      done: false,\\n      textT: 5,\\n      hold: 0,\\n      ride: 0,\\n    };\\n    this.pass = m.faction || null;\\n    this.windPin = m.wind || null;\\n    if (m.weather === 'storm') this.rain = true;\\n    else this.rain = false;\\n    if (m.hour !== undefined) this.hour = m.hour;\\n    this.announceStep();\\n    this.game.mode = 'play';\\n    this.game.screen = 'play';\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    return true;\\n  }\\n\\n  currentStep() {\\n    if (!this.mission || this.mission.done) return null;\\n    return this.mission.def.steps[this.mission.index] || null;\\n  }\\n\\n  announceStep() {\\n    const s = this.currentStep();\\n    if (!s) return;\\n    this.subtitle = s.text || '';\\n    this.speaker = '';\\n    this.mission.textT = 5;\\n    this.mission.hold = 0;\\n    this.mission.ride = 0;\\n    if (s.do === 'lines') this.lines = [...s.ids];\\n    if (s.do === 'choice') {\\n      this.choice = { id: s.id, options: s.options, focus: 0 };\\n      this.choicePick = null;\\n    }\\n    if (s.do === 'jam') this.jamScript = 5;\\n    if (s.do === 'repair') {\\n      this.ensureTruck(this.feet().x + 3, this.feet().z);\\n      this.vehicleHp = 0;\\n    }\\n    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\\n    if (s.do === 'buddy-down') this.knockBuddy();\\n    if (s.do === 'fever-fall') {\\n      this.feverT = 0;\\n      this.tablets = 0;\\n    }\\n  }\\n\\n  knockBuddy() {\\n    const b = this.buddies.find((x) => x.alive && !x.down);\\n    if (!b) {\\n      this.subtitle = line('buddy:burn');\\n      this.completeStep();\\n      return;\\n    }\\n    b.hp = 0;\\n    b.down = true;\\n    b.downLeft = 40;\\n    b.burning = true;\\n    b.x = this.feet().x + 1.2;\\n    b.z = this.feet().z;\\n    this.subtitle = line('buddy:burn');\\n    this.speaker = b.name;\\n  }\\n\\n  completeStep() {\\n    if (!this.mission || this.mission.done) return;\\n    this.mission.index += 1;\\n    this.choice = null;\\n    if (this.mission.index >= this.mission.def.steps.length) {\\n      this.mission.done = true;\\n      this.finishMission();\\n      return;\\n    }\\n    this.announceStep();\\n  }\\n\\n  finishMission() {\\n    const m = this.mission.def;\\n    for (const effect of m.onDone || []) {\\n      if (effect.flag) this.flags.add(effect.flag);\\n      if (effect.safehouse) this.safehouses.add(effect.safehouse);\\n      if (effect.tablets) this.tablets += effect.tablets;\\n      if (effect.pay) this.pay(effect.pay);\\n      if (effect.scar) this.layScar(effect.scar);\\n      if (effect.buddy) {\\n        if (!this.buddies.some((b) => b.id === effect.buddy)) this.buddies.push(this.makeBuddy(effect.buddy));\\n      }\\n      if (effect.tracker) this.tracker = true;\\n      if (effect.truce === false) this.truce = false;\\n      if (effect.column) this.column = true;\\n      if (effect.moveVillage) this.moveVillage();\\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\\n    }\\n    this.pass = null;\\n    this.windPin = null;\\n    this.subtitle = m.title + ' DONE';\\n  }\\n\\n  moveVillage() {\\n    if (this.movedOnce) return;\\n    this.movedOnce = true;\\n    this.ledger.moved += this.civilians;\\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\\n  }\\n\\n  ensureTruck(x, z) {\\n    if (this.car) return;\\n    const y = this.ground(x, z) + 1.2;\\n    this.car = new Vehicle(this.ctx.physics, {\\n      at: [x, y, z],\\n      yaw: 0,\\n      size: [0.95, 0.45, 2.2],\\n      mass: 12,\\n      power: 160,\\n      topSpeed: TUNING.vehicleTopSpeed,\\n      wheelRadius: 0.42,\\n      suspension: 0.45,\\n      stiffness: 30,\\n      grip: 2.6,\\n    });\\n    this.vehicleHp = 100;\\n    this.vehicleKind = 'pickup';\\n    this.truckX = x;\\n    this.truckZ = z;\\n  }\\n\\n  fixed(dt) {\\n    this.clock += dt;\\n    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\\n    this.hour = ((this.gameHours % 24) + 24) % 24;\\n    this.stepWind(dt);\\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\\n    this.fire.rain = this.rain;\\n    this.fire.step(dt);\\n    this.tickFever(dt);\\n    this.tickBurn(dt);\\n    this.tickRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    if (this.game.blocksSim()) return;\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\\n    this.windSpeed = clamp(this.windSpeed + (this.rng.next() - 0.5) * dt * 0.15, 0, 8);\\n  }\\n\\n  tickFever(dt) {\\n    if (this.game.mode !== 'play' && this.game.mode !== 'attract') return;\\n    if (!this.feverOn) {\\n      this.feverT -= dt;\\n      if (this.feverT <= 0) {\\n        this.feverOn = true;\\n        this.feverIgnore = 0;\\n        this.subtitle = line('fever');\\n      }\\n      return;\\n    }\\n    if (this.feverClear > 0) {\\n      this.feverClear -= dt;\\n      if (this.feverClear <= 0) {\\n        this.feverOn = false;\\n        const shrink = this.flags.has('m7') ? 2 : this.flags.has('m3') ? 1 : 0;\\n        const mins = Math.max(2, TUNING.feverMinutes - shrink);\\n        this.feverT = mins * 60;\\n      }\\n      return;\\n    }\\n    this.feverIgnore += dt;\\n    if (this.feverIgnore >= 25) this.collapse();\\n  }\\n\\n  collapse() {\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    const lost = this.stones * 0.2;\\n    this.stones = Math.max(0, this.stones - lost);\\n    this.hp = Math.max(this.hp, 30);\\n    const home = this.nearestSafe();\\n    this.teleport(home.x, home.z);\\n    this.dead = false;\\n    this.subtitle = 'YOU WAKE SHORT OF STONES.';\\n    if (this.currentStep()?.do === 'fever-fall') this.completeStep();\\n  }\\n\\n  nearestSafe() {\\n    const p = this.feet();\\n    let best = { x: 12, z: 55 };\\n    let bd = Infinity;\\n    const homes = [{ x: 12, z: 55 }, ...[...this.safehouses].map((id) => siteById(id)).filter(Boolean)];\\n    for (const s of homes) {\\n      const d = Math.hypot(s.x - p.x, s.z - p.z);\\n      if (d < bd) {\\n        bd = d;\\n        best = s;\\n      }\\n    }\\n    return best;\\n  }\\n\\n  tickBurn(dt) {\\n    const p = this.feet();\\n    const cell = this.fire.cellAt(p.x, p.z);\\n    const inFire = cell && this.fire.state[cell.i] === 1;\\n    const wet = nearRiver(p.x, p.z, 8);\\n    if (inFire && !wet) this.burning = 2;\\n    else if (this.burning > 0) this.burning = Math.max(0, this.burning - dt);\\n    if (this.burning > 0) this.hurt(TUNING.fireDamage * dt, 'fire', false);\\n  }\\n\\n  tickRegen(dt) {\\n    if (this.god || this.hp <= 0 || this.hp >= 100) return;\\n    this.regenT -= dt;\\n    if (this.regenT > 0) return;\\n    const top = Math.min(100, Math.ceil(this.hp / 20) * 20);\\n    if (this.hp < top) this.hp = Math.min(top, this.hp + 10 * dt);\\n  }\\n\\n  tickActors(dt) {\\n    const night = this.hour < 5.5 || this.hour >= 19;\\n    const p = this.feet();\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      const cell = this.fire.cellAt(a.x, a.z);\\n      if (cell && this.fire.state[cell.i] === 1 && a.kind === 'soldier') {\\n        a.state = 'panic';\\n        a.burnT = (a.burnT || 0) + dt;\\n        a.x += Math.cos(a.burnT) * dt * 3;\\n        a.z += Math.sin(a.burnT * 1.3) * dt * 3;\\n        this.fire.ignite(a.x, a.z, 0);\\n        if (a.burnT > 5) a.alive = false;\\n        continue;\\n      }\\n      if (a.kind === 'civil') {\\n        if (a.fleeing) {\\n          a.x += dt * 2;\\n          a.z += dt;\\n        }\\n        continue;\\n      }\\n      if (a.kind !== 'soldier') continue;\\n      const see = this.soldierSees(a, p, night);\\n      a.sees = see;\\n      if (see && this.hostile(a)) {\\n        a.react = (a.react || 0) + dt;\\n        a.state = 'alert';\\n        if (a.react >= TUNING.enemyReaction) {\\n          const dist = Math.hypot(a.x - p.x, a.z - p.z);\\n          this.aimError = (1.2 + (5 - 1.2) * Math.min(1, dist / 80)) / TUNING.enemyAccuracy;\\n          if (this.rng.next() < 0.5 * dt * 4) this.hurt(9, 'bullet', false);\\n        }\\n      } else {\\n        a.react = 0;\\n        a.state = see ? 'suspicious' : 'idle';\\n      }\\n    }\\n  }\\n\\n  soldierSees(a, p, night) {\\n    if (this.invisible) return false;\\n    let range = TUNING.enemyVision;\\n    if (this.crouch) range *= 0.55;\\n    if (night) range *= 0.45;\\n    if (this.burning > 0) range *= 2;\\n    const dist = Math.hypot(a.x - p.x, a.z - p.z);\\n    if (dist > range) return false;\\n    const ang = Math.atan2(p.x - a.x, p.z - a.z);\\n    let diff = Math.abs(ang - (a.yaw || 0));\\n    while (diff > Math.PI) diff = Math.abs(diff - Math.PI * 2);\\n    return diff < (120 * Math.PI) / 360;\\n  }\\n\\n  hostile(a) {\\n    if (a.kind === 'civil') return false;\\n    if (this.pass && a.faction === this.pass && !this.provoked) return false;\\n    if (this.truce && this.inTown(a.x, a.z)) return false;\\n    return true;\\n  }\\n\\n  inTown(x, z) {\\n    return this.truce && Math.hypot(x, z - 40) < 70;\\n  }\\n\\n  tickBuddies(dt) {\\n    for (const b of this.buddies) {\\n      if (!b.alive || !b.down) continue;\\n      b.downLeft -= dt;\\n      if (b.downLeft <= 0) {\\n        b.alive = false;\\n        b.down = false;\\n        this.ledger.friends += 1;\\n        if (this.currentStep()?.do === 'buddy-down') this.completeStep();\\n      }\\n    }\\n    if (this.rescueT > 0) {\\n      this.rescueT -= dt;\\n      if (this.rescueT <= 0 && this.rescueBuddy) {\\n        const mags = this.rescueBuddy.id === 'mags';\\n        this.hp = mags ? 60 : 40;\\n        this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60;\\n        if (this.rng.next() < TUNING.buddyWoundChance) {\\n          this.rescueBuddy.wound = true;\\n          this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60 * 2;\\n        }\\n        this.rescueBuddy = null;\\n        this.dead = false;\\n      }\\n    }\\n  }\\n\\n  tickPosts() {\\n    for (const post of this.posts) {\\n      if (post.alive || post.clearedAt == null) continue;\\n      if (this.gameHours - post.clearedAt >= TUNING.postRemanHours) {\\n        post.alive = true;\\n        post.clearedAt = null;\\n      }\\n    }\\n  }\\n\\n  tickPlayer(dt) {\\n    if (this.dead && this.rescueT <= 0) return;\\n    const input = this.ctx.input;\\n    const bot = this.game.mode === 'attract' ? this.game.bot : null;\\n    if (this.surgeryT > 0) {\\n      this.surgeryT -= dt;\\n      if (this.surgeryT <= 0) this.hp = 40;\\n      return;\\n    }\\n    if (this.rescueT > 0) return;\\n    this.readNeeds(dt, input, bot);\\n    if (this.choice) return;\\n    const p = this.feet();\\n    const wading = nearRiver(p.x, p.z, 8) && !onBridge(p.x, p.z);\\n    let speed = 5.4;\\n    if (this.crouch) speed = 2;\\n    else if (this.walk) speed = 3.6;\\n    const sprinting = this.sprint && this.stamina > 0 && !wading && !this.carrying;\\n    if (sprinting) speed = 7.4;\\n    if (wading) speed = 2.7;\\n    if (this.carrying) speed *= 0.85;\\n    speed *= TUNING.playerSpeed;\\n    if (sprinting && (bot ? bot.move : true)) this.stamina = Math.max(0, this.stamina - dt);\\n    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\\n    this.hero.speed = speed;\\n    const yaw = this.ctx.camera.yaw || 0;\\n    let ax = 0;\\n    let ay = 0;\\n    if (bot) {\\n      ax = bot.x || 0;\\n      ay = bot.y || 0;\\n    } else if (!this.map.up) {\\n      const m = input.moveAxis();\\n      ax = m.x;\\n      ay = m.y;\\n    }\\n    const fx = -Math.sin(yaw);\\n    const fz = -Math.cos(yaw);\\n    const rx = Math.cos(yaw);\\n    const rz = -Math.sin(yaw);\\n    MOVE.set(fx * ay + rx * ax, 0, fz * ay + rz * ax);\\n    if (MOVE.length() > 1) MOVE.normalize();\\n    const jump = !!(bot ? bot.jump : consumeAction(input, 'jump'));\\n    if (!this.inVehicle && !this.noclip) {\\n      this.hero.setInput(MOVE, jump, jump);\\n      this.hero.fixedUpdate(dt);\\n    } else if (this.noclip) {\\n      const f = this.hero.feet;\\n      this.hero.teleport([f.x + MOVE.x * dt * 12, f.y, f.z + MOVE.z * dt * 12]);\\n    }\\n    if (this.inVehicle && this.car) this.drive(dt, input, bot, ax, ay);\\n    if (!bot) this.combat(dt, input);\\n    this.nearPrompt();\\n  }\\n\\n  drive(dt, input, bot, ax, ay) {\\n    this.car.o.topSpeed = TUNING.vehicleTopSpeed * (this.vehicleHp < 35 ? 0.6 : 1);\\n    const throttle = this.vehicleHp <= 0 ? 0 : (bot ? (bot.y || 0) : ay);\\n    const steer = bot ? (bot.x || 0) : ax;\\n    this.car.drive({ throttle, steer, brake: throttle < 0, handbrake: false }, dt);\\n    if (this.vehicleHp < 10 && this.vehicleHp > 0 && this.burning > 0) {\\n      this.explodeT += dt;\\n      if (this.explodeT > 8) {\\n        this.vehicleHp = 0;\\n        const t = this.car.body.translation();\\n        this.fire.ignite(t.x, t.z, 6);\\n      }\\n    }\\n  }\\n\\n  readNeeds(dt, input, bot) {\\n    if (bot) return;\\n    if (consumeAction(input, 'crouch')) this.crouch = !this.crouch;\\n    if (input.consumePress('CapsLock')) this.walk = !this.walk;\\n    this.sprint = heldAction(input, 'sprint') || input.isDown('ShiftLeft');\\n    if (consumeAction(input, 'map')) this.map.up = !this.map.up;\\n    if (this.map.up) this.map.anim = Math.min(1, this.map.anim + dt / 0.4);\\n    else this.map.anim = Math.max(0, this.map.anim - dt / 0.4);\\n    if (this.feverOn && (heldAction(input, 'tablet') || input.isDown('KeyH'))) {\\n      this.holdT.tablet += dt;\\n      if (this.holdT.tablet >= 1 && this.tablets > 0) {\\n        this.tablets -= 1;\\n        this.feverClear = 5;\\n        this.holdT.tablet = 0;\\n        if (this.currentStep()?.do === 'tablet') this.completeStep();\\n      }\\n    } else this.holdT.tablet = 0;\\n    const healHeld = heldAction(input, 'heal') || input.isDown('KeyQ');\\n    if (this.hp < 20 && this.hp > 0 && consumeAction(input, 'heal')) {\\n      this.surgeryT = 4;\\n      this.subtitle = this.lastHurt === 'fire' ? 'THE LIGHTER' : 'HOLD STILL.';\\n    } else if (healHeld && this.syrettes > 0 && this.hp >= 20) {\\n      this.holdT.heal += dt;\\n      if (this.holdT.heal >= 0.8) {\\n        this.syrettes -= 1;\\n        this.hp = Math.min(100, this.hp + 40);\\n        this.holdT.heal = 0;\\n        if (this.currentStep()?.do === 'syrette') this.completeStep();\\n      }\\n    } else this.holdT.heal = 0;\\n  }\\n\\n  combat(dt, input) {\\n    const gun = this.weapon;\\n    if (gun) gun.cooldown = Math.max(0, gun.cooldown - dt);\\n    const want = heldAction(input, 'fire') || input.isDown('MouseLeft');\\n    const tap = consumeAction(input, 'fire');\\n    if (!gun || this.sprint) return;\\n    const def = WEAPON_BY_ID[gun.id];\\n    const auto = !!(def && def.auto);\\n    if (!(auto ? want : tap)) return;\\n    if (gun.cooldown > 0) return;\\n    if (this.inTown(this.feet().x, this.feet().z) && this.truce) return;\\n    if (gun.jammed) {\\n      this.prompt = 'JAMMED';\\n      return;\\n    }\\n    if (gun.magSize > 0 && gun.mag <= 0) return;\\n    this.fireGun(gun, def);\\n  }\\n\\n  fireGun(gun, def) {\\n    const rate = def.rate || 1;\\n    gun.cooldown = 1 / rate;\\n    if (!this.infAmmo && gun.magSize > 0) gun.mag -= 1;\\n    gun.shots += 1;\\n    this.shotCount += 1;\\n    const wear = (def.wear || 0) * TUNING.wearRate * (this.upgrades.has('clean') ? 0.6 : 1);\\n    gun.cond = Math.max(0, gun.cond - wear);\\n    if (gun.cond <= 0) {\\n      this.breakGun();\\n      return;\\n    }\\n    const jamP = this.noJam ? 0 : TUNING.jamRate * 0.12 * (1 - gun.cond / 100) ** 2;\\n    const script = this.jamScript && gun.shots >= this.jamScript;\\n    if (script || this.rng.next() < jamP) {\\n      gun.jammed = true;\\n      gun.jamLeft = 2 + Math.floor(this.rng.next() * 3);\\n      this.jamScript = 0;\\n    }\\n    this.resolveShot(def);\\n    this.provoked = true;\\n  }\\n\\n  breakGun() {\\n    const gun = this.weapon;\\n    if (!gun) return;\\n    this.guns.splice(this.slot, 1);\\n    this.slot = Math.max(0, this.guns.length - 1);\\n    this.subtitle = 'THE GUN COMES APART.';\\n  }\\n\\n  resolveShot(def) {\\n    const p = this.feet();\\n    const yaw = this.ctx.camera.yaw || 0;\\n    const dx = -Math.sin(yaw);\\n    const dz = -Math.cos(yaw);\\n    const range = def.range || 40;\\n    if (def.ignite || def.blast) {\\n      const x = p.x + dx * Math.min(range, 18);\\n      const z = p.z + dz * Math.min(range, 18);\\n      this.fire.ignite(x, z, def.ignite || def.blast || 1);\\n      this.fire.litByPlayer += 1;\\n      this.damagePoint(x, z, def.damage * TUNING.weaponDamage, def.blast || 2);\\n      return;\\n    }\\n    this.damageRay(p, dx, dz, range, (def.damage || 10) * TUNING.weaponDamage);\\n  }\\n\\n  damageRay(p, dx, dz, range, dmg) {\\n    let best = null;\\n    let bd = range;\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      const ox = a.x - p.x;\\n      const oz = a.z - p.z;\\n      const along = ox * dx + oz * dz;\\n      if (along < 0 || along > bd) continue;\\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\\n      if (lat < 0.8) {\\n        best = a;\\n        bd = along;\\n      }\\n    }\\n    for (const prop of this.props) {\\n      if (!prop.alive) continue;\\n      const ox = prop.x - p.x;\\n      const oz = prop.z - p.z;\\n      const along = ox * dx + oz * dz;\\n      if (along < 0 || along > range) continue;\\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\\n      if (lat < 1.4) this.damageProp(prop, dmg);\\n    }\\n    if (best) this.damageActor(best, dmg);\\n  }\\n\\n  damagePoint(x, z, dmg, r) {\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      if (Math.hypot(a.x - x, a.z - z) <= r + 1) this.damageActor(a, dmg);\\n    }\\n    for (const prop of this.props) {\\n      if (!prop.alive) continue;\\n      if (Math.hypot(prop.x - x, prop.z - z) <= r + 1.5) this.damageProp(prop, dmg);\\n    }\\n    if (this.vehicleHp > 0 && this.car && !this.inVehicle) {\\n      const t = this.car.body.translation();\\n      if (Math.hypot(t.x - x, t.z - z) < r + 2) this.vehicleHp = Math.max(0, this.vehicleHp - dmg / TUNING.vehicleToughness);\\n    }\\n  }\\n\\n  damageActor(a, dmg) {\\n    if (a.kind === 'civil') {\\n      a.fleeing = true;\\n      return;\\n    }\\n    a.hp -= dmg;\\n    if (a.hp <= 0 && a.alive) {\\n      a.alive = false;\\n      if (a.kind === 'soldier') this.ledger.killed += 1;\\n      const step = this.currentStep();\\n      if (step && step.do === 'clear') {\\n        const left = this.actors.filter((x) => x.alive && x.post === step.tag).length;\\n        if (left <= 0) this.completeStep();\\n      }\\n    }\\n  }\\n\\n  damageProp(prop, dmg) {\\n    prop.hp = (prop.hp || 40) - dmg;\\n    const step = this.currentStep();\\n    if (prop.hp > 0 && !(step && step.do === 'destroy' && prop.tag === step.tag && (prop.tag === 'fuel-tank' || prop.tag === 'pump'))) {\\n      if (prop.tag === 'fuel-tank' || prop.tag === 'pump' || prop.tag === 'convoy') {\\n        if (prop.hp > 0) return;\\n      } else return;\\n    }\\n    if (prop.hp > 0 && prop.tag !== 'fuel-tank' && prop.tag !== 'pump' && prop.tag !== 'convoy') return;\\n    if (!prop.alive) return;\\n    if (prop.hp > 0 && step && step.do === 'destroy' && prop.tag === step.tag) {\\n      prop.alive = false;\\n    } else if (prop.hp <= 0) prop.alive = false;\\n    else return;\\n    this.fire.ignite(prop.x, prop.z, 4);\\n    if (prop.tag === 'convoy') {\\n      const pay = this.props.find((p) => p.tag === 'payroll');\\n      if (pay) pay.hidden = false;\\n    }\\n    if (step && step.do === 'destroy' && prop.tag === step.tag) {\\n      const left = this.props.filter((p) => p.alive && p.tag === step.tag).length;\\n      if (left < (step.n || 1)) this.completeStep();\\n    }\\n  }\\n\\n  tryReload() {\\n    const gun = this.weapon;\\n    if (!gun) return;\\n    if (gun.jammed) {\\n      gun.jamLeft -= 1;\\n      if (gun.jamLeft <= 0) gun.jammed = false;\\n      if (this.currentStep()?.do === 'jam' && !gun.jammed && gun.shots >= 5) this.completeStep();\\n      return;\\n    }\\n    const need = gun.magSize - gun.mag;\\n    if (need <= 0 || gun.reserve <= 0) return;\\n    const take = Math.min(need, gun.reserve);\\n    gun.mag += take;\\n    gun.reserve -= take;\\n  }\\n\\n  tryUse(dt, input) {\\n    const pressed = consumeAction(input, 'use');\\n    const held = heldAction(input, 'use') || input.isDown('KeyE');\\n    if (!pressed && !held) {\\n      this.holdT.use = 0;\\n      return;\\n    }\\n    const p = this.feet();\\n    const buddy = this.buddies.find((b) => b.alive && b.down && Math.hypot((b.x || p.x) - p.x, (b.z || p.z) - p.z) < 2.5);\\n    if (buddy && pressed && this.syrettes > 0 && !buddy.burning) {\\n      this.syrettes -= 1;\\n      buddy.down = false;\\n      buddy.hp = buddy.max * 0.5;\\n      buddy.trust += 1;\\n      buddy.burning = false;\\n      if (this.currentStep()?.do === 'buddy-down') this.completeStep();\\n      return;\\n    }\\n    if (this.map.up && pressed) {\\n      this.pickWaypoint();\\n      return;\\n    }\\n    const truckNear = this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4;\\n    if (truckNear && this.vehicleHp < 50 && held) {\\n      this.holdT.use += dt || 0.016;\\n      const need = this.upgrades.has('vkit') ? 1.5 : 3;\\n      if (this.holdT.use >= need) {\\n        this.vehicleHp = 50;\\n        this.holdT.use = 0;\\n        if (this.currentStep()?.do === 'repair') this.completeStep();\\n      }\\n      return;\\n    }\\n    if (!pressed) return;\\n    if (truckNear && !this.inVehicle && this.vehicleHp >= 50) {\\n      this.inVehicle = true;\\n      this.hero.collider.setEnabled(false);\\n      return;\\n    }\\n    if (this.inVehicle) {\\n      this.inVehicle = false;\\n      this.hero.collider.setEnabled(true);\\n      const t = this.truckPos();\\n      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\\n      return;\\n    }\\n    const step = this.currentStep();\\n    if (step && step.do === 'use') {\\n      const prop = this.props.find((pr) => pr.tag === step.tag && pr.alive !== false);\\n      if (prop && Math.hypot(prop.x - p.x, prop.z - p.z) < 3) {\\n        prop.used = true;\\n        if (step.tag === 'cage') {\\n          if (!this.buddies.some((b) => b.id === 'ines')) this.buddies.push(this.makeBuddy('ines'));\\n        }\\n        if (step.tag === 'ledger-book') prop.alive = false;\\n        this.completeStep();\\n        return;\\n      }\\n    }\\n    for (const trig of TRIGS) {\\n      if (Math.hypot(trig.x - p.x, trig.z - p.z) < 3 && !this.flags.has(trig.id)) {\\n        this.flags.add(trig.id);\\n        this.notes += 1;\\n        this.subtitle = 'A NOTE IN THE MARGIN.';\\n        if (this.notes >= 6) this.giveGun('empire', 100);\\n        return;\\n      }\\n    }\\n    for (const c of this.cases) {\\n      if (c.taken) continue;\\n      if (Math.hypot(c.x - p.x, c.z - p.z) < 2.2) {\\n        c.taken = true;\\n        this.carrying = c;\\n        if (this.currentStep()?.do === 'collect') this.completeStep();\\n        return;\\n      }\\n    }\\n  }\\n\\n  truckPos() {\\n    if (!this.car) return { x: this.truckX || 0, z: this.truckZ || 0 };\\n    const t = this.car.body.translation();\\n    return { x: t.x, z: t.z };\\n  }\\n\\n  pickWaypoint() {\\n    let best = null;\\n    let bd = 18;\\n    for (const s of SITES) {\\n      if (!this.seen.has(s.id) && s.kind !== 'town') continue;\\n      const d = Math.hypot(s.x - this.map.cx, s.z - this.map.cz);\\n      if (d < bd) {\\n        bd = d;\\n        best = s;\\n      }\\n    }\\n    if (best) this.waypoint = { x: best.x, z: best.z, id: best.id };\\n  }\\n\\n  nearPrompt() {\\n    const p = this.feet();\\n    const step = this.currentStep();\\n    if (this.feverOn && this.tablets > 0) {\\n      this.prompt = 'TABLET';\\n      return;\\n    }\\n    const down = this.buddies.find((b) => b.alive && b.down);\\n    if (down) {\\n      this.prompt = this.syrettes > 0 && !down.burning ? 'SYRETTE OR FINISH IT' : 'FINISH IT';\\n      return;\\n    }\\n    if (this.hp < 20 && this.hp > 0) {\\n      this.prompt = 'FIELD SURGERY';\\n      return;\\n    }\\n    if (step?.text && this.mission?.textT > 0) {\\n      this.prompt = step.text;\\n      return;\\n    }\\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4) {\\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\\n      return;\\n    }\\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\\n  }\\n\\n  tickMission(dt) {\\n    const step = this.currentStep();\\n    if (!step || !this.mission) return;\\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\\n    const p = this.feet();\\n    if (step.do === 'goto' || step.do === 'drive') {\\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\\n    } else if (step.do === 'leave') {\\n      const target = siteById(step.site);\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\\n    } else if (step.do === 'burn') {\\n      const cell = this.fire.cellAt(step.x, step.z);\\n      const hot = cell && (this.fire.state[cell.i] === 1 || this.fire.state[cell.i] === 2);\\n      if (hot) this.completeStep();\\n    } else if (step.do === 'hold') {\\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\\n      if (this.mission.hold >= step.time) this.completeStep();\\n    } else if (step.do === 'ride') {\\n      this.riding = true;\\n      this.mission.ride += dt;\\n      if (this.mission.ride >= step.time) {\\n        this.riding = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\\n        this._reported = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\\n      this._linesDone = false;\\n      this.completeStep();\\n    } else if (step.do === 'choice' && this.choicePick) {\\n      const pick = this.choicePick;\\n      this.choicePick = null;\\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\\n      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\\n      this.completeStep();\\n    }\\n  }\\n\\n  advanceLines() {\\n    if (this.lines.length) {\\n      const id = this.lines.shift();\\n      this.subtitle = line(id);\\n      this.speaker = id.split(':')[0].toUpperCase();\\n      if (this.lines.length === 0) this._linesDone = true;\\n      return true;\\n    }\\n    return false;\\n  }\\n\\n  spawnSoldier(o) {\\n    const hp = 100 * TUNING.enemyHealth;\\n    const s = {\\n      id: o.id || 'sol-' + this.actors.length,\\n      kind: 'soldier',\\n      faction: o.faction || 'concord',\\n      x: o.x, z: o.z, yaw: o.yaw || 0,\\n      hp, max: hp, alive: true, state: 'idle', post: o.post || null,\\n    };\\n    this.actors.push(s);\\n    return s;\\n  }\\n\\n  clearPost(id) {\\n    const post = this.posts.find((p) => p.id === id);\\n    if (!post) return;\\n    post.alive = false;\\n    post.clearedAt = this.gameHours;\\n  }\\n\\n  jamChance(cond) {\\n    return TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\\n  }\\n\\n  hectares() {\\n    return this.fire.burntCount * 0.0025;\\n  }\\n\\n  trackerRate(x, z) {\\n    let best = Infinity;\\n    for (const c of this.cases) {\\n      if (c.taken) continue;\\n      const d = Math.hypot(c.x - x, c.z - z);\\n      if (d < best) best = d;\\n    }\\n    if (best > 60) return 0;\\n    return 0.4 + (1 - best / 60) * 6;\\n  }\\n}\\n\\nfunction clamp(v, a, b) {\\n  return v < a ? a : v > b ? b : v;\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/world.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { CharacterController, THREE, Vehicle } from '../../pixel-engine.js';\\nimport { TUNING } from '../core/tuning.js';\\nimport { consumeAction, heldAction } from '../core/actions.js';\\nimport { CASES, POSTS, SITES, STRIPS, TRIGS, siteById } from '../content/sites.js';\\nimport { missionById } from '../content/missions.js';\\nimport { WEAPON_BY_ID, freshWeapon } from '../content/weapons.js';\\nimport { onBridge, nearRiver } from '../content/roads.js';\\nimport { FireGrid } from '../world/fire.js';\\nimport { addBlock, buildLand, fillFuel, paintScar } from '../world/terrain.js';\\nimport { line } from '../content/dialogue.js';\\n\\nconst { Vector3 } = THREE;\\nconst MOVE = new Vector3();\\n\\nconst BUDDY_DEF = {\\n  ines: { name: 'INES CARVALHO', hp: 200 },\\n  dov: { name: 'DOV HALPERN', hp: 200 },\\n  mags: { name: 'MAGS OYELARAN', hp: 200 },\\n};\\n\\nexport class World {\\n  constructor(game, ctx) {\\n    this.game = game;\\n    this.ctx = ctx;\\n    this.rng = ctx.random.fork('world');\\n    this.fire = new FireGrid(ctx.random.fork('fire'));\\n    this.fire.onBurnt = (ix, iz) => {\\n      if (this.land) paintScar(this.land, ix, iz);\\n      this.scarTick = (this.scarTick || 0) + 1;\\n    };\\n    this.heroes = null;\\n    this.land = null;\\n    this.heights = null;\\n    this.hp = 100;\\n    this.stones = 0;\\n    this.tablets = 0;\\n    this.syrettes = 3;\\n    this.syretteMax = 3;\\n    this.hour = 9;\\n    this.gameHours = 9;\\n    this.windDir = 0.4;\\n    this.windSpeed = 3;\\n    this.windPin = null;\\n    this.rain = false;\\n    this.weather = 'clear';\\n    this.guns = [];\\n    this.slot = 0;\\n    this.unlocked = new Set(['cane', 'm38']);\\n    this.upgrades = new Set();\\n    this.flags = new Set();\\n    this.safehouses = new Set();\\n    this.seen = new Set(['mile-forty', 'clinic']);\\n    this.notes = 0;\\n    this.tracker = false;\\n    this.truce = true;\\n    this.column = false;\\n    this.pass = null;\\n    this.provoked = false;\\n    this.buddies = [];\\n    this.actors = [];\\n    this.props = [];\\n    this.cases = [];\\n    this.posts = POSTS.map((p) => ({ ...p, alive: true, clearedAt: null }));\\n    this.trucks = [];\\n    this.car = null;\\n    this.inVehicle = false;\\n    this.vehicleHp = 100;\\n    this.vehicleKind = null;\\n    this.repairT = 0;\\n    this.explodeT = 0;\\n    this.carrying = null;\\n    this.waypoint = null;\\n    this.map = { up: false, anim: 0, cx: 0, cz: 40, zoom: 1 };\\n    this.mapPx = new Uint8Array(320 * 240 * 4);\\n    this.feverT = 12 * 60;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.holdT = { tablet: 0, heal: 0, use: 0 };\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.rescueBuddy = null;\\n    this.dead = false;\\n    this.god = false;\\n    this.noJam = false;\\n    this.infAmmo = false;\\n    this.invisible = false;\\n    this.noclip = false;\\n    this.crouch = false;\\n    this.walk = false;\\n    this.sprint = false;\\n    this.stamina = 6;\\n    this.burning = 0;\\n    this.regenT = 0;\\n    this.lastHurt = 'bullet';\\n    this.shotCount = 0;\\n    this.jamScript = 0;\\n    this.mission = null;\\n    this.stepT = 0;\\n    this.lines = [];\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.subtitle = '';\\n    this.speaker = '';\\n    this.prompt = '';\\n    this.ledger = { killed: 0, friends: 0, moved: 0, stonesEarned: 0 };\\n    this.clock = 0;\\n    this.rideT = 0;\\n    this.riding = false;\\n    this.heard = { spot: false };\\n    this.aimError = 0;\\n    this.sheet = null;\\n    this.ending = null;\\n    this.civilians = 12;\\n    this.movedOnce = false;\\n  }\\n\\n  build() {\\n    const built = buildLand(this.ctx, this.ctx.random.fork('land').state);\\n    this.land = built.land;\\n    this.heights = built.heights;\\n    fillFuel(this.fire, this.heights);\\n    const y = this.ground(0, 40);\\n    this.hero = new CharacterController(this.ctx.physics, {\\n      position: [0, y + 0.05, 40],\\n      speed: 5.4,\\n      jumpSpeed: 8,\\n      gravity: -24,\\n      radius: 0.35,\\n      halfHeight: 0.55,\\n    });\\n    this.paintMapBase();\\n    this.spawnTown();\\n    for (const c of CASES) this.cases.push({ ...c, taken: false });\\n    this.markSeen();\\n  }\\n\\n  ground(x, z) {\\n    if (this.land) return this.land.heightAt(x, z);\\n    if (this.heights) return this.heights(x, z);\\n    return 40;\\n  }\\n\\n  feet() {\\n    if (this.inVehicle && this.car) {\\n      const t = this.car.body.translation();\\n      return { x: t.x, y: t.y, z: t.z };\\n    }\\n    const f = this.hero.feet;\\n    return { x: f.x, y: f.y, z: f.z };\\n  }\\n\\n  spawnTown() {\\n    const y = this.ground(12, 55);\\n    addBlock(this.ctx, 12, y + 1.2, 55, 6, 2.4, 4, this.ctx.palette.white);\\n    addBlock(this.ctx, -18, this.ground(-18, 62) + 1.1, 62, 5, 2.2, 4, this.ctx.palette.orange);\\n    addBlock(this.ctx, 0, this.ground(0, 70) + 0.4, 70, 14, 0.4, 4, this.ctx.palette.slate);\\n    this.props.push({ tag: 'ledger-book', x: 168, z: -286, alive: true });\\n    this.props.push({ tag: 'cage', x: 40, z: -164, alive: true });\\n    this.props.push({ tag: 'pump', x: -330, z: 395, alive: true });\\n    for (const [x, z] of [[410, -50], [440, -70], [455, -45]]) {\\n      this.props.push({ tag: 'fuel-tank', x, z, alive: true });\\n      addBlock(this.ctx, x, this.ground(x, z) + 1.5, z, 2.2, 3, 2.2, this.ctx.palette.slate);\\n    }\\n    this.props.push({ tag: 'convoy', x: 220, z: 450, alive: true, hp: 80 });\\n    this.props.push({ tag: 'payroll', x: 220, z: 450, alive: true, hidden: true });\\n    this.actors.push({\\n      id: 'civil-1', kind: 'civil', x: -250, z: 230, hp: 40, alive: true, faction: 'civil', fleeing: false,\\n    });\\n  }\\n\\n  paintMapBase() {\\n    const px = this.mapPx;\\n    px.fill(0);\\n    for (let i = 0; i < 320 * 240; i++) {\\n      px[i * 4] = 196;\\n      px[i * 4 + 1] = 154;\\n      px[i * 4 + 2] = 96;\\n      px[i * 4 + 3] = 255;\\n    }\\n  }\\n\\n  worldToMap(x, z) {\\n    const mx = Math.floor(((x + 640) / 1280) * 300) + 8;\\n    const my = Math.floor(((z + 640) / 1280) * 220) + 8;\\n    return [mx, my];\\n  }\\n\\n  stamp(x, z, r, g, b) {\\n    const [mx, my] = this.worldToMap(x, z);\\n    if (mx < 0 || my < 0 || mx >= 320 || my >= 240) return;\\n    const i = (mx + my * 320) * 4;\\n    this.mapPx[i] = r;\\n    this.mapPx[i + 1] = g;\\n    this.mapPx[i + 2] = b;\\n    this.mapPx[i + 3] = 255;\\n  }\\n\\n  refreshMap() {\\n    const fire = this.fire;\\n    if (this.scarTick === this._scarDrawn) {\\n      const p = this.feet();\\n      this.stamp(p.x, p.z, 240, 240, 240);\\n      return;\\n    }\\n    this._scarDrawn = this.scarTick;\\n    for (const i of fire.burntList) {\\n      const ix = i % 256;\\n      const iz = (i / 256) | 0;\\n      const [x, z] = fire.center(ix, iz);\\n      this.stamp(x, z, 30, 28, 36);\\n    }\\n    const p = this.feet();\\n    this.stamp(p.x, p.z, 240, 240, 240);\\n  }\\n\\n  mapHasScar() {\\n    for (let i = 0; i < this.mapPx.length; i += 4) {\\n      if (this.mapPx[i] < 40 && this.mapPx[i + 1] < 40 && this.mapPx[i + 2] < 50 && this.mapPx[i + 3] > 0) return true;\\n    }\\n    return false;\\n  }\\n\\n  markSeen() {\\n    const p = this.feet();\\n    for (const s of SITES) if (Math.hypot(s.x - p.x, s.z - p.z) < 90) this.seen.add(s.id);\\n  }\\n\\n  resetDynamic() {\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.actors.length = 0;\\n    this.dead = false;\\n    this.carrying = null;\\n    this.inVehicle = false;\\n    this.mission = null;\\n    this.lines = [];\\n    this.choice = null;\\n    this.subtitle = '';\\n    this.feverOn = false;\\n    this.surgeryT = 0;\\n    this.rescueT = 0;\\n    this.ending = null;\\n    this.sheet = null;\\n    this.spawnTown();\\n  }\\n\\n  teleport(x, z) {\\n    const y = this.ground(x, z) + 0.1;\\n    if (this.inVehicle && this.car) this.car.reset([x, y + 1, z], this.car.yaw);\\n    else this.hero.teleport([x, y, z]);\\n    this.markSeen();\\n  }\\n\\n  giveGun(id, cond) {\\n    const gun = freshWeapon(id, cond);\\n    if (!gun) return;\\n    if (this.upgrades.has('belt') && gun.reserve) gun.reserve = Math.round(gun.reserve * 1.5);\\n    const slot = gun.slot;\\n    const at = this.guns.findIndex((g) => g.slot === slot);\\n    if (at >= 0) this.guns[at] = gun;\\n    else this.guns.push(gun);\\n    this.unlocked.add(id);\\n    this.slot = Math.max(0, this.guns.findIndex((g) => g.id === id));\\n  }\\n\\n  get weapon() {\\n    return this.guns[this.slot] || null;\\n  }\\n\\n  hurt(amount, kind = 'bullet', force = false) {\\n    if (this.dead) return;\\n    if (this.god && !force) return;\\n    const d = amount * TUNING.playerDamageTaken;\\n    this.hp = Math.max(0, this.hp - d);\\n    this.lastHurt = kind;\\n    this.regenT = 5;\\n    this.surgeryT = 0;\\n    if (this.hp <= 0) this.down();\\n  }\\n\\n  down() {\\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\\n    if (buddy) {\\n      this.rescueT = 2.2;\\n      this.rescueBuddy = buddy;\\n      this.subtitle = line('buddy:rescue');\\n      this.speaker = buddy.name;\\n      return;\\n    }\\n    this.dead = true;\\n    this.subtitle = line('death');\\n    this.game.onDeath();\\n  }\\n\\n  pay(amount) {\\n    const n = Math.round(amount * TUNING.stonesReward);\\n    this.stones += n;\\n    this.ledger.stonesEarned += n;\\n  }\\n\\n  applySetup(setup, deadIds = []) {\\n    this.flags = new Set(setup.flags || []);\\n    this.safehouses = new Set(setup.safehouses || []);\\n    this.stones = setup.stones ?? 0;\\n    this.tablets = setup.tablets ?? 0;\\n    this.syrettes = setup.syrettes ?? 3;\\n    this.hour = setup.hour ?? 9;\\n    this.gameHours = this.hour;\\n    this.truce = setup.truce !== false;\\n    this.column = !!setup.column;\\n    this.tracker = !!setup.tracker;\\n    this.hp = 100;\\n    this.dead = false;\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    this.feverT = setup.feverIn === 0 ? 0 : (TUNING.feverMinutes * 60);\\n    this.guns = [];\\n    for (const g of setup.guns || []) this.giveGun(g.id, g.cond);\\n    if (!this.guns.find((g) => g.id === 'cane') && (setup.guns || []).length) this.giveGun('cane', 100);\\n    this.buddies = (setup.buddies || []).map((id) => this.makeBuddy(id));\\n    for (const id of deadIds) {\\n      const b = this.buddies.find((x) => x.id === id);\\n      if (b) {\\n        b.alive = false;\\n        b.down = false;\\n        this.ledger.friends += 1;\\n      } else this.buddies.push({ ...this.makeBuddy(id), alive: false, down: false, hp: 0 });\\n    }\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.paintMapBase();\\n    for (const scar of setup.scars || []) this.layScar(scar);\\n    this.sheet = setup.sheet || null;\\n    this.ending = null;\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.lines = [];\\n    this.carrying = null;\\n    this.jamScript = 0;\\n    this.shotCount = 0;\\n    this.movedOnce = false;\\n    this.civilians = 12;\\n    this.provoked = false;\\n    if (setup.truck) this.ensureTruck(setup.x + 6, setup.z);\\n    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\\n    this.subtitle = '';\\n  }\\n\\n  makeBuddy(id) {\\n    const d = BUDDY_DEF[id] || { name: id.toUpperCase(), hp: 200 };\\n    return { id, name: d.name, hp: d.hp, max: d.hp, alive: true, down: false, downLeft: 0, trust: 1, spentUntil: 0, wound: false, burning: false };\\n  }\\n\\n  layScar(id) {\\n    const strip = STRIPS[id];\\n    if (!strip) return;\\n    this.fire.burnStrip(strip.points, strip.width);\\n    this.refreshMap();\\n  }\\n\\n  startMission(id, opts = {}) {\\n    const m = missionById(id);\\n    if (!m) return false;\\n    const dead = opts.dead || [];\\n    this.applySetup(m.setup || {}, dead);\\n    this.mission = {\\n      def: m,\\n      index: 0,\\n      done: false,\\n      textT: 5,\\n      hold: 0,\\n      ride: 0,\\n    };\\n    this.pass = m.faction || null;\\n    this.windPin = m.wind || null;\\n    if (m.weather === 'storm') this.rain = true;\\n    else this.rain = false;\\n    if (m.hour !== undefined) this.hour = m.hour;\\n    this.announceStep();\\n    this.game.mode = 'play';\\n    this.game.screen = 'play';\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    return true;\\n  }\\n\\n  currentStep() {\\n    if (!this.mission || this.mission.done) return null;\\n    return this.mission.def.steps[this.mission.index] || null;\\n  }\\n\\n  announceStep() {\\n    const s = this.currentStep();\\n    if (!s) return;\\n    this.subtitle = s.text || '';\\n    this.speaker = '';\\n    this.mission.textT = 5;\\n    this.mission.hold = 0;\\n    this.mission.ride = 0;\\n    if (s.do === 'lines') this.lines = [...s.ids];\\n    if (s.do === 'choice') {\\n      this.choice = { id: s.id, options: s.options, focus: 0 };\\n      this.choicePick = null;\\n    }\\n    if (s.do === 'jam') this.jamScript = 5;\\n    if (s.do === 'repair') {\\n      this.ensureTruck(this.feet().x + 3, this.feet().z);\\n      this.vehicleHp = 0;\\n    }\\n    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\\n    if (s.do === 'buddy-down') this.knockBuddy();\\n    if (s.do === 'fever-fall') {\\n      this.feverT = 0;\\n      this.tablets = 0;\\n    }\\n  }\\n\\n  knockBuddy() {\\n    const b = this.buddies.find((x) => x.alive && !x.down);\\n    if (!b) {\\n      this.subtitle = line('buddy:burn');\\n      this.completeStep();\\n      return;\\n    }\\n    b.hp = 0;\\n    b.down = true;\\n    b.downLeft = 40;\\n    b.burning = true;\\n    b.x = this.feet().x + 1.2;\\n    b.z = this.feet().z;\\n    this.subtitle = line('buddy:burn');\\n    this.speaker = b.name;\\n  }\\n\\n  completeStep() {\\n    if (!this.mission || this.mission.done) return;\\n    this.mission.index += 1;\\n    this.choice = null;\\n    if (this.mission.index >= this.mission.def.steps.length) {\\n      this.mission.done = true;\\n      this.finishMission();\\n      return;\\n    }\\n    this.announceStep();\\n  }\\n\\n  finishMission() {\\n    const m = this.mission.def;\\n    for (const effect of m.onDone || []) {\\n      if (effect.flag) this.flags.add(effect.flag);\\n      if (effect.safehouse) this.safehouses.add(effect.safehouse);\\n      if (effect.tablets) this.tablets += effect.tablets;\\n      if (effect.pay) this.pay(effect.pay);\\n      if (effect.scar) this.layScar(effect.scar);\\n      if (effect.buddy) {\\n        if (!this.buddies.some((b) => b.id === effect.buddy)) this.buddies.push(this.makeBuddy(effect.buddy));\\n      }\\n      if (effect.tracker) this.tracker = true;\\n      if (effect.truce === false) this.truce = false;\\n      if (effect.column) this.column = true;\\n      if (effect.moveVillage) this.moveVillage();\\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\\n    }\\n    this.pass = null;\\n    this.windPin = null;\\n    this.subtitle = m.title + ' DONE';\\n  }\\n\\n  moveVillage() {\\n    if (this.movedOnce) return;\\n    this.movedOnce = true;\\n    this.ledger.moved += this.civilians;\\n    for (const a of this.actors) if (a.kind === 'civil') a.fleeing = true;\\n  }\\n\\n  ensureTruck(x, z) {\\n    if (this.car) return;\\n    const y = this.ground(x, z) + 1.2;\\n    this.car = new Vehicle(this.ctx.physics, {\\n      at: [x, y, z],\\n      yaw: 0,\\n      size: [0.95, 0.45, 2.2],\\n      mass: 12,\\n      power: 160,\\n      topSpeed: TUNING.vehicleTopSpeed,\\n      wheelRadius: 0.42,\\n      suspension: 0.45,\\n      stiffness: 30,\\n      grip: 2.6,\\n    });\\n    this.vehicleHp = 100;\\n    this.vehicleKind = 'pickup';\\n    this.truckX = x;\\n    this.truckZ = z;\\n  }\\n\\n  fixed(dt) {\\n    this.clock += dt;\\n    this.gameHours += (dt / (TUNING.dayMinutes * 60)) * 24;\\n    this.hour = ((this.gameHours % 24) + 24) % 24;\\n    this.stepWind(dt);\\n    this.fire.wind.x = Math.cos(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.z = Math.sin(this.windPin ? this.windPin.dir : this.windDir);\\n    this.fire.wind.speed = this.windPin ? this.windPin.speed : this.windSpeed;\\n    this.fire.rain = this.rain;\\n    this.fire.step(dt);\\n    this.tickFever(dt);\\n    this.tickBurn(dt);\\n    this.tickRegen(dt);\\n    this.tickActors(dt);\\n    this.tickBuddies(dt);\\n    this.tickPosts();\\n    if (this.game.blocksSim()) return;\\n    this.tickPlayer(dt);\\n    this.tickMission(dt);\\n    if ((this.clock * 2) % 1 < dt) this.refreshMap();\\n  }\\n\\n  stepWind(dt) {\\n    if (this.windPin) return;\\n    const turn = (15 * Math.PI / 180) * (dt / 60);\\n    this.windDir += (this.rng.next() - 0.5) * 2 * turn;\\n    this.windSpeed = clamp(this.windSpeed + (this.rng.next() - 0.5) * dt * 0.15, 0, 8);\\n  }\\n\\n  tickFever(dt) {\\n    if (this.game.mode !== 'play' && this.game.mode !== 'attract') return;\\n    if (!this.feverOn) {\\n      this.feverT -= dt;\\n      if (this.feverT <= 0) {\\n        this.feverOn = true;\\n        this.feverIgnore = 0;\\n        this.subtitle = line('fever');\\n      }\\n      return;\\n    }\\n    if (this.feverClear > 0) {\\n      this.feverClear -= dt;\\n      if (this.feverClear <= 0) {\\n        this.feverOn = false;\\n        const shrink = this.flags.has('m7') ? 2 : this.flags.has('m3') ? 1 : 0;\\n        const mins = Math.max(2, TUNING.feverMinutes - shrink);\\n        this.feverT = mins * 60;\\n      }\\n      return;\\n    }\\n    this.feverIgnore += dt;\\n    if (this.feverIgnore >= 25) this.collapse();\\n  }\\n\\n  collapse() {\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n    this.feverClear = 0;\\n    const lost = this.stones * 0.2;\\n    this.stones = Math.max(0, this.stones - lost);\\n    this.hp = Math.max(this.hp, 30);\\n    const home = this.nearestSafe();\\n    this.teleport(home.x, home.z);\\n    this.dead = false;\\n    this.subtitle = 'YOU WAKE SHORT OF STONES.';\\n    if (this.currentStep()?.do === 'fever-fall') this.completeStep();\\n  }\\n\\n  nearestSafe() {\\n    const p = this.feet();\\n    let best = { x: 12, z: 55 };\\n    let bd = Infinity;\\n    const homes = [{ x: 12, z: 55 }, ...[...this.safehouses].map((id) => siteById(id)).filter(Boolean)];\\n    for (const s of homes) {\\n      const d = Math.hypot(s.x - p.x, s.z - p.z);\\n      if (d < bd) {\\n        bd = d;\\n        best = s;\\n      }\\n    }\\n    return best;\\n  }\\n\\n  tickBurn(dt) {\\n    const p = this.feet();\\n    const cell = this.fire.cellAt(p.x, p.z);\\n    const inFire = cell && this.fire.state[cell.i] === 1;\\n    const wet = nearRiver(p.x, p.z, 8);\\n    if (inFire && !wet) this.burning = 2;\\n    else if (this.burning > 0) this.burning = Math.max(0, this.burning - dt);\\n    if (this.burning > 0) this.hurt(TUNING.fireDamage * dt, 'fire', false);\\n  }\\n\\n  tickRegen(dt) {\\n    if (this.god || this.hp <= 0 || this.hp >= 100) return;\\n    this.regenT -= dt;\\n    if (this.regenT > 0) return;\\n    const top = Math.min(100, Math.ceil(this.hp / 20) * 20);\\n    if (this.hp < top) this.hp = Math.min(top, this.hp + 10 * dt);\\n  }\\n\\n  tickActors(dt) {\\n    const night = this.hour < 5.5 || this.hour >= 19;\\n    const p = this.feet();\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      const cell = this.fire.cellAt(a.x, a.z);\\n      if (cell && this.fire.state[cell.i] === 1 && a.kind === 'soldier') {\\n        a.state = 'panic';\\n        a.burnT = (a.burnT || 0) + dt;\\n        a.x += Math.cos(a.burnT) * dt * 3;\\n        a.z += Math.sin(a.burnT * 1.3) * dt * 3;\\n        this.fire.ignite(a.x, a.z, 0);\\n        if (a.burnT > 5) a.alive = false;\\n        continue;\\n      }\\n      if (a.kind === 'civil') {\\n        if (a.fleeing) {\\n          a.x += dt * 2;\\n          a.z += dt;\\n        }\\n        continue;\\n      }\\n      if (a.kind !== 'soldier') continue;\\n      const see = this.soldierSees(a, p, night);\\n      a.sees = see;\\n      if (see && this.hostile(a)) {\\n        a.react = (a.react || 0) + dt;\\n        a.state = 'alert';\\n        if (a.react >= TUNING.enemyReaction) {\\n          const dist = Math.hypot(a.x - p.x, a.z - p.z);\\n          this.aimError = (1.2 + (5 - 1.2) * Math.min(1, dist / 80)) / TUNING.enemyAccuracy;\\n          if (this.rng.next() < 0.5 * dt * 4) this.hurt(9, 'bullet', false);\\n        }\\n      } else {\\n        a.react = 0;\\n        a.state = see ? 'suspicious' : 'idle';\\n      }\\n    }\\n  }\\n\\n  soldierSees(a, p, night) {\\n    if (this.invisible) return false;\\n    let range = TUNING.enemyVision;\\n    if (this.crouch) range *= 0.55;\\n    if (night) range *= 0.45;\\n    if (this.burning > 0) range *= 2;\\n    const dist = Math.hypot(a.x - p.x, a.z - p.z);\\n    if (dist > range) return false;\\n    const ang = Math.atan2(p.x - a.x, p.z - a.z);\\n    let diff = Math.abs(ang - (a.yaw || 0));\\n    while (diff > Math.PI) diff = Math.abs(diff - Math.PI * 2);\\n    return diff < (120 * Math.PI) / 360;\\n  }\\n\\n  hostile(a) {\\n    if (a.kind === 'civil') return false;\\n    if (this.pass && a.faction === this.pass && !this.provoked) return false;\\n    if (this.truce && this.inTown(a.x, a.z)) return false;\\n    return true;\\n  }\\n\\n  inTown(x, z) {\\n    return this.truce && Math.hypot(x, z - 40) < 70;\\n  }\\n\\n  tickBuddies(dt) {\\n    for (const b of this.buddies) {\\n      if (!b.alive || !b.down) continue;\\n      b.downLeft -= dt;\\n      if (b.downLeft <= 0) {\\n        b.alive = false;\\n        b.down = false;\\n        this.ledger.friends += 1;\\n        if (this.currentStep()?.do === 'buddy-down') this.completeStep();\\n      }\\n    }\\n    if (this.rescueT > 0) {\\n      this.rescueT -= dt;\\n      if (this.rescueT <= 0 && this.rescueBuddy) {\\n        const mags = this.rescueBuddy.id === 'mags';\\n        this.hp = mags ? 60 : 40;\\n        this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60;\\n        if (this.rng.next() < TUNING.buddyWoundChance) {\\n          this.rescueBuddy.wound = true;\\n          this.rescueBuddy.spentUntil = this.clock + TUNING.dayMinutes * 60 * 2;\\n        }\\n        this.rescueBuddy = null;\\n        this.dead = false;\\n      }\\n    }\\n  }\\n\\n  tickPosts() {\\n    for (const post of this.posts) {\\n      if (post.alive || post.clearedAt == null) continue;\\n      if (this.gameHours - post.clearedAt >= TUNING.postRemanHours) {\\n        post.alive = true;\\n        post.clearedAt = null;\\n      }\\n    }\\n  }\\n\\n  tickPlayer(dt) {\\n    if (this.dead && this.rescueT <= 0) return;\\n    const input = this.ctx.input;\\n    const bot = this.game.mode === 'attract' ? this.game.bot : null;\\n    if (this.surgeryT > 0) {\\n      this.surgeryT -= dt;\\n      if (this.surgeryT <= 0) this.hp = 40;\\n      return;\\n    }\\n    if (this.rescueT > 0) return;\\n    this.readNeeds(dt, input, bot);\\n    if (this.choice) return;\\n    const p = this.feet();\\n    const wading = nearRiver(p.x, p.z, 8) && !onBridge(p.x, p.z);\\n    let speed = 5.4;\\n    if (this.crouch) speed = 2;\\n    else if (this.walk) speed = 3.6;\\n    const sprinting = this.sprint && this.stamina > 0 && !wading && !this.carrying;\\n    if (sprinting) speed = 7.4;\\n    if (wading) speed = 2.7;\\n    if (this.carrying) speed *= 0.85;\\n    speed *= TUNING.playerSpeed;\\n    if (sprinting && (bot ? bot.move : true)) this.stamina = Math.max(0, this.stamina - dt);\\n    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\\n    this.hero.speed = speed;\\n    const yaw = this.ctx.camera.yaw || 0;\\n    let ax = 0;\\n    let ay = 0;\\n    if (bot) {\\n      ax = bot.x || 0;\\n      ay = bot.y || 0;\\n    } else if (!this.map.up) {\\n      const m = input.moveAxis();\\n      ax = m.x;\\n      ay = m.y;\\n    }\\n    const fx = -Math.sin(yaw);\\n    const fz = -Math.cos(yaw);\\n    const rx = Math.cos(yaw);\\n    const rz = -Math.sin(yaw);\\n    MOVE.set(fx * ay + rx * ax, 0, fz * ay + rz * ax);\\n    if (MOVE.length() > 1) MOVE.normalize();\\n    const jump = !!(bot ? bot.jump : consumeAction(input, 'jump'));\\n    if (!this.inVehicle && !this.noclip) {\\n      this.hero.setInput(MOVE, jump, jump);\\n      this.hero.fixedUpdate(dt);\\n    } else if (this.noclip) {\\n      const f = this.hero.feet;\\n      this.hero.teleport([f.x + MOVE.x * dt * 12, f.y, f.z + MOVE.z * dt * 12]);\\n    }\\n    if (this.inVehicle && this.car) this.drive(dt, input, bot, ax, ay);\\n    if (!bot) this.combat(dt, input);\\n    this.nearPrompt();\\n  }\\n\\n  drive(dt, input, bot, ax, ay) {\\n    this.car.o.topSpeed = TUNING.vehicleTopSpeed * (this.vehicleHp < 35 ? 0.6 : 1);\\n    const throttle = this.vehicleHp <= 0 ? 0 : (bot ? (bot.y || 0) : ay);\\n    const steer = bot ? (bot.x || 0) : ax;\\n    this.car.drive({ throttle, steer, brake: throttle < 0, handbrake: false }, dt);\\n    if (this.vehicleHp < 10 && this.vehicleHp > 0 && this.burning > 0) {\\n      this.explodeT += dt;\\n      if (this.explodeT > 8) {\\n        this.vehicleHp = 0;\\n        const t = this.car.body.translation();\\n        this.fire.ignite(t.x, t.z, 6);\\n      }\\n    }\\n  }\\n\\n  readNeeds(dt, input, bot) {\\n    if (bot) return;\\n    if (consumeAction(input, 'crouch')) this.crouch = !this.crouch;\\n    if (input.consumePress('CapsLock')) this.walk = !this.walk;\\n    this.sprint = heldAction(input, 'sprint') || input.isDown('ShiftLeft');\\n    if (consumeAction(input, 'map')) this.map.up = !this.map.up;\\n    if (this.map.up) this.map.anim = Math.min(1, this.map.anim + dt / 0.4);\\n    else this.map.anim = Math.max(0, this.map.anim - dt / 0.4);\\n    if (this.feverOn && (heldAction(input, 'tablet') || input.isDown('KeyH'))) {\\n      this.holdT.tablet += dt;\\n      if (this.holdT.tablet >= 1 && this.tablets > 0) {\\n        this.tablets -= 1;\\n        this.feverClear = 5;\\n        this.holdT.tablet = 0;\\n        if (this.currentStep()?.do === 'tablet') this.completeStep();\\n      }\\n    } else this.holdT.tablet = 0;\\n    const healHeld = heldAction(input, 'heal') || input.isDown('KeyQ');\\n    if (this.hp < 20 && this.hp > 0 && consumeAction(input, 'heal')) {\\n      this.surgeryT = 4;\\n      this.subtitle = this.lastHurt === 'fire' ? 'THE LIGHTER' : 'HOLD STILL.';\\n    } else if (healHeld && this.syrettes > 0 && this.hp >= 20) {\\n      this.holdT.heal += dt;\\n      if (this.holdT.heal >= 0.8) {\\n        this.syrettes -= 1;\\n        this.hp = Math.min(100, this.hp + 40);\\n        this.holdT.heal = 0;\\n        if (this.currentStep()?.do === 'syrette') this.completeStep();\\n      }\\n    } else this.holdT.heal = 0;\\n  }\\n\\n  combat(dt, input) {\\n    const gun = this.weapon;\\n    if (gun) gun.cooldown = Math.max(0, gun.cooldown - dt);\\n    const want = heldAction(input, 'fire') || input.isDown('MouseLeft');\\n    const tap = consumeAction(input, 'fire');\\n    if (!gun || this.sprint) return;\\n    const def = WEAPON_BY_ID[gun.id];\\n    const auto = !!(def && def.auto);\\n    if (!(auto ? want : tap)) return;\\n    if (gun.cooldown > 0) return;\\n    if (this.inTown(this.feet().x, this.feet().z) && this.truce) return;\\n    if (gun.jammed) {\\n      this.prompt = 'JAMMED';\\n      return;\\n    }\\n    if (gun.magSize > 0 && gun.mag <= 0) return;\\n    this.fireGun(gun, def);\\n  }\\n\\n  fireGun(gun, def) {\\n    const rate = def.rate || 1;\\n    gun.cooldown = 1 / rate;\\n    if (!this.infAmmo && gun.magSize > 0) gun.mag -= 1;\\n    gun.shots += 1;\\n    this.shotCount += 1;\\n    const wear = (def.wear || 0) * TUNING.wearRate * (this.upgrades.has('clean') ? 0.6 : 1);\\n    gun.cond = Math.max(0, gun.cond - wear);\\n    if (gun.cond <= 0) {\\n      this.breakGun();\\n      return;\\n    }\\n    const jamP = this.noJam ? 0 : TUNING.jamRate * 0.12 * (1 - gun.cond / 100) ** 2;\\n    const script = this.jamScript && gun.shots >= this.jamScript;\\n    if (script || this.rng.next() < jamP) {\\n      gun.jammed = true;\\n      gun.jamLeft = 2 + Math.floor(this.rng.next() * 3);\\n      this.jamScript = 0;\\n    }\\n    this.resolveShot(def);\\n    this.provoked = true;\\n  }\\n\\n  breakGun() {\\n    const gun = this.weapon;\\n    if (!gun) return;\\n    this.guns.splice(this.slot, 1);\\n    this.slot = Math.max(0, this.guns.length - 1);\\n    this.subtitle = 'THE GUN COMES APART.';\\n  }\\n\\n  resolveShot(def) {\\n    const p = this.feet();\\n    const yaw = this.ctx.camera.yaw || 0;\\n    const dx = -Math.sin(yaw);\\n    const dz = -Math.cos(yaw);\\n    const range = def.range || 40;\\n    if (def.ignite || def.blast) {\\n      const x = p.x + dx * Math.min(range, 18);\\n      const z = p.z + dz * Math.min(range, 18);\\n      this.fire.ignite(x, z, def.ignite || def.blast || 1);\\n      this.fire.litByPlayer += 1;\\n      this.damagePoint(x, z, def.damage * TUNING.weaponDamage, def.blast || 2);\\n      return;\\n    }\\n    this.damageRay(p, dx, dz, range, (def.damage || 10) * TUNING.weaponDamage);\\n  }\\n\\n  damageRay(p, dx, dz, range, dmg) {\\n    let best = null;\\n    let bd = range;\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      const ox = a.x - p.x;\\n      const oz = a.z - p.z;\\n      const along = ox * dx + oz * dz;\\n      if (along < 0 || along > bd) continue;\\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\\n      if (lat < 0.8) {\\n        best = a;\\n        bd = along;\\n      }\\n    }\\n    for (const prop of this.props) {\\n      if (!prop.alive) continue;\\n      const ox = prop.x - p.x;\\n      const oz = prop.z - p.z;\\n      const along = ox * dx + oz * dz;\\n      if (along < 0 || along > range) continue;\\n      const lat = Math.hypot(ox - dx * along, oz - dz * along);\\n      if (lat < 1.4) this.damageProp(prop, dmg);\\n    }\\n    if (best) this.damageActor(best, dmg);\\n  }\\n\\n  damagePoint(x, z, dmg, r) {\\n    for (const a of this.actors) {\\n      if (!a.alive) continue;\\n      if (Math.hypot(a.x - x, a.z - z) <= r + 1) this.damageActor(a, dmg);\\n    }\\n    for (const prop of this.props) {\\n      if (!prop.alive) continue;\\n      if (Math.hypot(prop.x - x, prop.z - z) <= r + 1.5) this.damageProp(prop, dmg);\\n    }\\n    if (this.vehicleHp > 0 && this.car && !this.inVehicle) {\\n      const t = this.car.body.translation();\\n      if (Math.hypot(t.x - x, t.z - z) < r + 2) this.vehicleHp = Math.max(0, this.vehicleHp - dmg / TUNING.vehicleToughness);\\n    }\\n  }\\n\\n  damageActor(a, dmg) {\\n    if (a.kind === 'civil') {\\n      a.fleeing = true;\\n      return;\\n    }\\n    a.hp -= dmg;\\n    if (a.hp <= 0 && a.alive) {\\n      a.alive = false;\\n      if (a.kind === 'soldier') this.ledger.killed += 1;\\n      const step = this.currentStep();\\n      if (step && step.do === 'clear') {\\n        const left = this.actors.filter((x) => x.alive && x.post === step.tag).length;\\n        if (left <= 0) this.completeStep();\\n      }\\n    }\\n  }\\n\\n  damageProp(prop, dmg) {\\n    prop.hp = (prop.hp || 40) - dmg;\\n    const step = this.currentStep();\\n    if (prop.hp > 0 && !(step && step.do === 'destroy' && prop.tag === step.tag && (prop.tag === 'fuel-tank' || prop.tag === 'pump'))) {\\n      if (prop.tag === 'fuel-tank' || prop.tag === 'pump' || prop.tag === 'convoy') {\\n        if (prop.hp > 0) return;\\n      } else return;\\n    }\\n    if (prop.hp > 0 && prop.tag !== 'fuel-tank' && prop.tag !== 'pump' && prop.tag !== 'convoy') return;\\n    if (!prop.alive) return;\\n    if (prop.hp > 0 && step && step.do === 'destroy' && prop.tag === step.tag) {\\n      prop.alive = false;\\n    } else if (prop.hp <= 0) prop.alive = false;\\n    else return;\\n    this.fire.ignite(prop.x, prop.z, 4);\\n    if (prop.tag === 'convoy') {\\n      const pay = this.props.find((p) => p.tag === 'payroll');\\n      if (pay) pay.hidden = false;\\n    }\\n    if (step && step.do === 'destroy' && prop.tag === step.tag) {\\n      const left = this.props.filter((p) => p.alive && p.tag === step.tag).length;\\n      if (left < (step.n || 1)) this.completeStep();\\n    }\\n  }\\n\\n  tryReload() {\\n    const gun = this.weapon;\\n    if (!gun) return;\\n    if (gun.jammed) {\\n      gun.jamLeft -= 1;\\n      if (gun.jamLeft <= 0) gun.jammed = false;\\n      if (this.currentStep()?.do === 'jam' && !gun.jammed && gun.shots >= 5) this.completeStep();\\n      return;\\n    }\\n    const need = gun.magSize - gun.mag;\\n    if (need <= 0 || gun.reserve <= 0) return;\\n    const take = Math.min(need, gun.reserve);\\n    gun.mag += take;\\n    gun.reserve -= take;\\n  }\\n\\n  tryUse(dt, input) {\\n    const pressed = consumeAction(input, 'use');\\n    const held = heldAction(input, 'use') || input.isDown('KeyE');\\n    if (!pressed && !held) {\\n      this.holdT.use = 0;\\n      return;\\n    }\\n    const p = this.feet();\\n    const buddy = this.buddies.find((b) => b.alive && b.down && Math.hypot((b.x || p.x) - p.x, (b.z || p.z) - p.z) < 2.5);\\n    if (buddy && pressed && this.syrettes > 0 && !buddy.burning) {\\n      this.syrettes -= 1;\\n      buddy.down = false;\\n      buddy.hp = buddy.max * 0.5;\\n      buddy.trust += 1;\\n      buddy.burning = false;\\n      if (this.currentStep()?.do === 'buddy-down') this.completeStep();\\n      return;\\n    }\\n    if (this.map.up && pressed) {\\n      this.pickWaypoint();\\n      return;\\n    }\\n    const truckNear = this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4;\\n    if (truckNear && this.vehicleHp < 50 && held) {\\n      this.holdT.use += dt || 0.016;\\n      const need = this.upgrades.has('vkit') ? 1.5 : 3;\\n      if (this.holdT.use >= need) {\\n        this.vehicleHp = 50;\\n        this.holdT.use = 0;\\n        if (this.currentStep()?.do === 'repair') this.completeStep();\\n      }\\n      return;\\n    }\\n    if (!pressed) return;\\n    if (truckNear && !this.inVehicle && this.vehicleHp >= 50) {\\n      this.inVehicle = true;\\n      this.hero.collider.setEnabled(false);\\n      return;\\n    }\\n    if (this.inVehicle) {\\n      this.inVehicle = false;\\n      this.hero.collider.setEnabled(true);\\n      const t = this.truckPos();\\n      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\\n      return;\\n    }\\n    const step = this.currentStep();\\n    if (step && step.do === 'use') {\\n      const prop = this.props.find((pr) => pr.tag === step.tag && pr.alive !== false);\\n      if (prop && Math.hypot(prop.x - p.x, prop.z - p.z) < 3) {\\n        prop.used = true;\\n        if (step.tag === 'cage') {\\n          if (!this.buddies.some((b) => b.id === 'ines')) this.buddies.push(this.makeBuddy('ines'));\\n        }\\n        if (step.tag === 'ledger-book') prop.alive = false;\\n        this.completeStep();\\n        return;\\n      }\\n    }\\n    for (const trig of TRIGS) {\\n      if (Math.hypot(trig.x - p.x, trig.z - p.z) < 3 && !this.flags.has(trig.id)) {\\n        this.flags.add(trig.id);\\n        this.notes += 1;\\n        this.subtitle = 'A NOTE IN THE MARGIN.';\\n        if (this.notes >= 6) this.giveGun('empire', 100);\\n        return;\\n      }\\n    }\\n    for (const c of this.cases) {\\n      if (c.taken) continue;\\n      if (Math.hypot(c.x - p.x, c.z - p.z) < 2.2) {\\n        c.taken = true;\\n        this.carrying = c;\\n        if (this.currentStep()?.do === 'collect') this.completeStep();\\n        return;\\n      }\\n    }\\n  }\\n\\n  truckPos() {\\n    if (!this.car) return { x: this.truckX || 0, z: this.truckZ || 0 };\\n    const t = this.car.body.translation();\\n    return { x: t.x, z: t.z };\\n  }\\n\\n  pickWaypoint() {\\n    let best = null;\\n    let bd = 18;\\n    for (const s of SITES) {\\n      if (!this.seen.has(s.id) && s.kind !== 'town') continue;\\n      const d = Math.hypot(s.x - this.map.cx, s.z - this.map.cz);\\n      if (d < bd) {\\n        bd = d;\\n        best = s;\\n      }\\n    }\\n    if (best) this.waypoint = { x: best.x, z: best.z, id: best.id };\\n  }\\n\\n  nearPrompt() {\\n    const p = this.feet();\\n    const step = this.currentStep();\\n    if (this.feverOn && this.tablets > 0) {\\n      this.prompt = 'TABLET';\\n      return;\\n    }\\n    const down = this.buddies.find((b) => b.alive && b.down);\\n    if (down) {\\n      this.prompt = this.syrettes > 0 && !down.burning ? 'SYRETTE OR FINISH IT' : 'FINISH IT';\\n      return;\\n    }\\n    if (this.hp < 20 && this.hp > 0) {\\n      this.prompt = 'FIELD SURGERY';\\n      return;\\n    }\\n    if (step?.text && this.mission?.textT > 0) {\\n      this.prompt = step.text;\\n      return;\\n    }\\n    if (this.car && Math.hypot(this.truckPos().x - p.x, this.truckPos().z - p.z) < 4) {\\n      this.prompt = this.vehicleHp < 50 ? 'REPAIR THE BONNET' : this.inVehicle ? 'GET OUT' : 'GET IN';\\n      return;\\n    }\\n    this.prompt = this.weapon?.jammed ? 'CLEAR THE JAM' : '';\\n  }\\n\\n  tickMission(dt) {\\n    const step = this.currentStep();\\n    if (!step || !this.mission) return;\\n    this.mission.textT = Math.max(0, this.mission.textT - dt);\\n    const p = this.feet();\\n    if (step.do === 'goto' || step.do === 'drive') {\\n      const target = step.site ? siteById(step.site) : { x: step.x, z: step.z };\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) < (step.r || 20)) this.completeStep();\\n    } else if (step.do === 'leave') {\\n      const target = siteById(step.site);\\n      if (target && Math.hypot(target.x - p.x, target.z - p.z) > (step.r || 40)) this.completeStep();\\n    } else if (step.do === 'burn') {\\n      const cell = this.fire.cellAt(step.x, step.z);\\n      const hot = cell && (this.fire.state[cell.i] === 1 || this.fire.state[cell.i] === 2);\\n      if (hot) this.completeStep();\\n    } else if (step.do === 'hold') {\\n      if (Math.hypot(step.x - p.x, step.z - p.z) < step.r) this.mission.hold += dt;\\n      if (this.mission.hold >= step.time) this.completeStep();\\n    } else if (step.do === 'ride') {\\n      this.riding = true;\\n      this.mission.ride += dt;\\n      if (this.mission.ride >= step.time) {\\n        this.riding = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'report') {\\n      const site = siteById(step.to);\\n      if (site && Math.hypot(site.x - p.x, site.z - p.z) < 16 && this._reported) {\\n        this._reported = false;\\n        this.completeStep();\\n      }\\n    } else if (step.do === 'map' && this.map.up) this.completeStep();\\n    else if (step.do === 'lines' && this.lines.length === 0 && this._linesDone) {\\n      this._linesDone = false;\\n      this.completeStep();\\n    } else if (step.do === 'choice' && this.choicePick) {\\n      const pick = this.choicePick;\\n      this.choicePick = null;\\n      if (step.id === 'sheet') this.sheet = pick === 0 ? 'walk' : 'give';\\n      if (step.id === 'shoot') this.ledger.killed += pick === 0 ? 1 : 0;\\n      this.completeStep();\\n    }\\n  }\\n\\n  advanceLines() {\\n    if (this.lines.length) {\\n      const id = this.lines.shift();\\n      this.subtitle = line(id);\\n      this.speaker = id.split(':')[0].toUpperCase();\\n      if (this.lines.length === 0) this._linesDone = true;\\n      return true;\\n    }\\n    return false;\\n  }\\n\\n  spawnSoldier(o) {\\n    const hp = 100 * TUNING.enemyHealth;\\n    const s = {\\n      id: o.id || 'sol-' + this.actors.length,\\n      kind: 'soldier',\\n      faction: o.faction || 'concord',\\n      x: o.x, z: o.z, yaw: o.yaw || 0,\\n      hp, max: hp, alive: true, state: 'idle', post: o.post || null,\\n    };\\n    this.actors.push(s);\\n    return s;\\n  }\\n\\n  clearPost(id) {\\n    const post = this.posts.find((p) => p.id === id);\\n    if (!post) return;\\n    post.alive = false;\\n    post.clearedAt = this.gameHours;\\n  }\\n\\n  jamChance(cond) {\\n    return TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\\n  }\\n\\n  hectares() {\\n    return this.fire.burntCount * 0.0025;\\n  }\\n\\n  trackerRate(x, z) {\\n    let best = Infinity;\\n    for (const c of this.cases) {\\n      if (c.taken) continue;\\n      const d = Math.hypot(c.x - x, c.z - z);\\n      if (d < best) best = d;\\n    }\\n    if (best > 60) return 0;\\n    return 0.4 + (1 - best / 60) * 6;\\n  }\\n}\\n\\nfunction clamp(v, a, b) {\\n  return v < a ? a : v > b ? b : v;\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"56dda9cf-2ee8-4cc7-a386-1bedab5e0fbd"}
