rt/models.js\",\"matches\":[{\"line_number\":58,\"content\":\"  prop('map-sheet', 'Paper map plane', 'sand', [0.5, 0.02, 0.38]),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"matches\":[{\"line_number\":145,\"content\":\"  assert(texBytes(w.mapTex) === w.mapPx, label + ' map texture does not read mapPx');\"},{\"line_number\":146,\"content\":\"  assert(sheet.material && sheet.material.map === w.mapTex, label + ' mesh does not sample mapPx');\"},{\"line_number\":503,\"content\":\"  assert(down && down.burning === false, 'knockBuddy forced the buddy to burn');\"},{\"line_number\":512,\"content\":\"  assert(up && !up.down && up.hp > 0 && w.syrettes === syretteBefore - 1, 'syrette through knockBuddy failed');\"},{\"line_number\":514,\"content\":\"  w.knockBuddy();\"},{\"line_number\":516,\"content\":\"  assert(down2 && down2.burning === false, 'second knockBuddy burned the buddy');\"},{\"line_number\":573,\"content\":\"  w.spawnSoldier({ x: 20, z: 20, faction: 'concord' });\"},{\"line_number\":595,\"content\":\"  const merc = w.spawnSoldier({ id: 'merc-proof', x: 500, z: 500, faction: 'merc' });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"4fb0a192-dd49-4a52-9b18-e233b757b70b"}
