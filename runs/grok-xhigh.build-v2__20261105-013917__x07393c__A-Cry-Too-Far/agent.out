ixed(3), (b.z - a.z).toFixed(3), 'yaw', e.ctx?.camera?.yaw);\nconsole.log('errors', e.errors?.slice?.(0, 3) || e.errors);\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3355,"output_tokens":745,"cache_read_input_tokens":135552,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"f696c5e9-4d50-458b-b308-3c14354b6a7d"}
