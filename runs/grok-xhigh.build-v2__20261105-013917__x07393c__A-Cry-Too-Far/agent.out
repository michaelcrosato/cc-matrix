114,107,32,43,32,105,116,101,109,46,108,97,98,101,108,44,32,123,32,99,111,108,111,114,58,32,105,110,100,101,120,32,61,61,61,32,116,104,105,115,46,102,111,99,117,115,32,63,32,39,111,114,97,110,103,101,39,32,58,32,39,119,104,105,116,101,39,32,125,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":23,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/game.js\",\"matches\":[{\"line_number\":49,\"content\":\"    this.focus = 0;\"},{\"line_number\":368,\"content\":\"    if (item.id === 'menu') { this.screen = 'menu'; this.mode = 'menu'; this.focus = 0; return; }\"},{\"line_number\":371,\"content\":\"    if (item.id === 'cash') { this.screen = 'cash'; this.focus = 0; return; }\"},{\"line_number\":372,\"content\":\"    if (item.id === 'settings') { this.screen = 'settings'; this.focus = 0; this.idle = 0; return; }\"},{\"line_number\":373,\"content\":\"    if (item.id === 'about') { this.screen = 'about'; this.page = 0; this.focus = 0; this.idle = 0; return; }\"},{\"line_number\":376,\"content\":\"    if (item.id === 'ledger') { this.screen = 'ledger'; this.focus = 0; return; }\"},{\"line_number\":381,\"content\":\"      this.focus = 0;\"},{\"line_number\":409,\"content\":\"    const item = this.items()[this.focus];\"},{\"line_number\":432,\"content\":\"      this.focus = 0;\"},{\"line_number\":438,\"content\":\"      this.focus = 0;\"},{\"line_number\":452,\"content\":\"    this.focus = 0;\"},{\"line_number\":492,\"content\":\"    this.focus = 0;\"},{\"line_number\":613,\"content\":\"    if (pressed(input, ['ArrowDown', 'KeyS', 'PadDown'])) this.focus = Math.min(items.length - 1, this.focus + 1);\"},{\"line_number\":614,\"content\":\"    if (pressed(input, ['ArrowUp', 'KeyW', 'PadUp'])) this.focus = Math.max(0, this.focus - 1);\"},{\"line_number\":618,\"content\":\"    if (armed && pressed(input, ['Enter', 'Space', 'PadCross'])) this.activate(items[this.focus]);\"},{\"line_number\":620,\"content\":\"    this.hover(ctx, items, armed);\"},{\"line_number\":624,\"content\":\"    const top = Math.max(0, this.focus - 6);\"},{\"line_number\":629,\"content\":\"  hover(ctx, items, armed = true) {\"},{\"line_number\":638,\"content\":\"      if (px > 36 && px < width - 36 && py > y - 2 && py < y + 14) this.focus = top + i;\"},{\"line_number\":643,\"content\":\"      if (ev.code === 'MouseLeft' || ev.code === 'Touch') this.activate(items[this.focus]);\"},{\"line_number\":660,\"content\":\"      focus: this.focus,\"},{\"line_number\":749,\"content\":\"        const mark = index === this.focus ? '> ' : '  ';\"},{\"line_number\":750,\"content\":\"        hud.text(24, 86 + i * 16, mark + item.label, { color: index === this.focus ? 'orange' : 'white' });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"44fc8b8a-9d2b-4841-a5ff-f2714cc125ea"}
