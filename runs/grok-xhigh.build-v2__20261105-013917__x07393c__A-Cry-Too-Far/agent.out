\"line_number\":870,\"content\":\"    this.car.o.topSpeed = TUNING.vehicleTopSpeed * (this.vehicleHp < 35 ? 0.6 : 1);\"},{\"line_number\":952,\"content\":\"    const wear = (def.wear || 0) * TUNING.wearRate * (this.upgrades.has('clean') ? 0.6 : 1);\"},{\"line_number\":958,\"content\":\"    const jamP = this.noJam ? 0 : TUNING.jamRate * 0.12 * (1 - gun.cond / 100) ** 2;\"},{\"line_number\":990,\"content\":\"      this.damagePoint(x, z, def.damage * TUNING.weaponDamage, def.blast || 2);\"},{\"line_number\":993,\"content\":\"    this.damageRay(p, dx, dz, range, (def.damage || 10) * TUNING.weaponDamage);\"},{\"line_number\":1034,\"content\":\"      if (Math.hypot(t.x - x, t.z - z) < r + 2) this.vehicleHp = Math.max(0, this.vehicleHp - dmg / TUNING.vehicleToughness);\"},{\"line_number\":1353,\"content\":\"    const hp = 100 * TUNING.enemyHealth;\"},{\"line_number\":1379,\"content\":\"    return TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/world/fire.js\",\"matches\":[{\"line_number\":186,\"content\":\"        const windFactor = clamp(1 + TUNING.windEffect * (wsp / 5) * 1.6 * cos, 0.15, 3.5);\"},{\"line_number\":192,\"content\":\"        const p = BASE_P * (FUEL_FACTOR[this.fuel[j]] || 0) * windFactor * slopeFactor * rainFactor * TUNING.fireSpread / diag;\"},{\"line_number\":195,\"content\":\"      if (wsp > 6 && this.rng.next() < 0.04 * TUNING.fireSpread) {\"},{\"line_number\":207,\"content\":\"    if (TUNING.regrowHours <= 0 || this.burntList.length === 0) return;\"},{\"line_number\":212,\"content\":\"      if (ageH >= TUNING.regrowHours) {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-97e2a430-34b7-4045-9d73-29764a6271fc-30","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"270→  }\\n\\n  get weapon() {\\n    return this.guns[this.slot] || null;\\n  }\\n\\n  hurt(amount, kind = 'bullet', force = false) {\\n    if (this.dead) return;\\n    if (this.god && !force) return;\\n    const d = amount * TUNING.playerDamageTaken;\\n280→    this.hp = Math.max(0, this.hp - d);\\n    this.lastHurt = kind;\\n    this.regenT = 5;\\n    this.surgeryT = 0;\\n    if (this.hp <= 0) this.down();\\n  }\\n\\n  down() {\\n    if (this.round) {\\n      this.round.noteDown();\\n290→      return;\\n    }\\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\\n    if (buddy) {\\n      this.rescueT = 2.2;\\n      this.rescueBuddy = buddy;\\n      this.subtitle = line('buddy:rescue');\\n      this.speaker = buddy.name;\\n      return;\\n    }\\n300→    this.dead = true;\\n    this.subtitle = line('death');\\n    this.game.onDeath();\\n  }\\n\\n  pay(amount) {\\n    const n = Math.round(amount * TUNING.stonesReward);\\n    this.stones += n;\\n    this.ledger.stonesEarned += n;\\n  }\\n310→\\n  applySetup(setup, deadIds = []) {\\n    this.flags = new Set(setup.flags || []);\\n    this.safehouses = new Set(setup.safehouses || []);\\n    this.stones = setup.stones ?? 0;\\n    this.tablets = setup.tablets ?? 0;\\n    this.syrettes = setup.syrettes ?? 3;\\n    this.hour = setup.hour ?? 9;\\n    this.gameHours = this.hour;\\n    this.truce = setup.truce !== false;\\n320→    this.column = !!setup.column;\\n    this.tracker = !!setup.tracker;\\n    this.hp = 100;\\n    this.dead = false;\\n    this.rescueT = 0;\\n    this.surgeryT = 0;\\n    this.burning = 0;\\n    this.actors = this.actors.filter((a) => a.kind === 'civil');\\n    this.feverOn = false;\\n    this.feverIgnore = 0;\\n330→    this.feverClear = 0;\\n    this.feverT = setup.feverIn === 0 ? 0 : (TUNING.feverMinutes * 60);\\n    this.guns = [];\\n    for (const g of setup.guns || []) this.giveGun(g.id, g.cond);\\n    if (!this.guns.find((g) => g.id === 'cane') && (setup.guns || []).length) this.giveGun('cane', 100);\\n    for (const id of deadIds) {\\n      if (!this.deadBuddies.has(id)) {\\n        this.deadBuddies.add(id);\\n        this.ledger.friends += 1;\\n      }\\n340→    }\\n    this.buddies = [];\\n    const listed = new Set(setup.buddies || []);\\n    for (const id of listed) {\\n      const b = this.makeBuddy(id);\\n      if (this.deadBuddies.has(id)) {\\n        b.alive = false;\\n        b.hp = 0;\\n      }\\n      this.buddies.push(b);\\n350→    }\\n    for (const id of this.deadBuddies) {\\n      if (!listed.has(id)) this.buddies.push({ ...this.makeBuddy(id), alive: false, down: false, hp: 0 });\\n    }\\n    this.fire.extinguish();\\n    this.fire.state.fill(0);\\n    this.fire.burning.length = 0;\\n    this.fire.burntList.length = 0;\\n    this.fire.burntCount = 0;\\n    this.paintMapBase();\\n360→    for (const scar of setup.scars || []) this.layScar(scar);\\n    this.sheet = setup.sheet || null;\\n    this.ending = null;\\n    this.choice = null;\\n    this.choicePick = null;\\n    this.lines = [];\\n    this.carrying = null;\\n    this.inVehicle = false;\\n    this.map.up = false;\\n    this.god = false;\\n370→    this.infAmmo = false;\\n    this.crouch = false;\\n    if (this.hero?.collider) this.hero.collider.setEnabled(true);\\n    this.jamScript = 0;\\n    this.shotCount = 0;\\n    this.movedOnce = false;\\n    this.civilians = 12;\\n    this.provoked = false;\\n    if (setup.truck) {\\n      const tx = setup.x + 6;\\n380→      const tz = setup.z;\\n      if (!this.car) this.ensureTruck(tx, tz);\\n      else {\\n        this.car.reset([tx, this.ground(tx, tz) + 1.2, tz], Math.PI);\\n        this.vehicleHp = 100;\\n      }\\n    }\\n    if (setup.x !== undefined) this.teleport(setup.x, setup.z);\\n    this.subtitle = '';\\n  }\\n390→\\n  makeBuddy(id) {\\n    const d = BUDDY_DEF[id] || { name: id.toUpperCase(), hp: 200 };\\n    return { id, name: d.name, hp: d.hp, max: d.hp, alive: true, down: false, downLeft: 0, trust: 1, spentUntil: 0, wound: false, burning: false };\\n  }\\n\\n  layScar(id) {\\n    const strip = STRIPS[id];\\n    if (!strip) return;\\n    this.fire.burnStrip(strip.points, strip.width);\\n400→    this.refreshMap();\\n  }\\n\\n  startMission(id, opts = {}) {\\n    const m = missionById(id);\\n    if (!m) return false;\\n    const dead = opts.dead || [];\\n    this.applySetup(m.setup || {}, dead);\\n    if (opts.sheet) this.sheet = opts.sheet;\\n    this.mission = {\\n410→      def: m,\\n      index: 0,\\n      done: false,\\n      textT: 5,\\n      hold: 0,\\n      ride: 0,\\n    };\\n    this.pass = m.faction || null;\\n    this.windPin = m.wind || null;\\n    if (m.weather === 'storm') this.rain = true;\\n420→    else this.rain = false;\\n    if (m.hour !== undefined) this.hour = m.hour;\\n    this.announceStep();\\n    this.game.mode = 'play';\\n    this.game.screen = 'play';\\n    if (this.ctx?.engine) this.ctx.engine.timeScale = 1;\\n    return true;\\n  }\\n\\n  currentStep() {\\n430→    if (!this.mission || this.mission.done) return null;\\n    return this.mission.def.steps[this.mission.index] || null;\\n  }\\n\\n  announceStep() {\\n    const s = this.currentStep();\\n    if (!s) return;\\n    this.subtitle = s.text || '';\\n    this.speaker = '';\\n    this.mission.textT = 5;\\n440→    this.mission.hold = 0;\\n    this.mission.ride = 0;\\n    if (s.do === 'lines') this.lines = [...s.ids];\\n    if (s.do === 'choice') {\\n      this.choice = { id: s.id, options: s.options, focus: 0 };\\n      this.choicePick = null;\\n    }\\n    if (s.do === 'jam') this.jamScript = 5;\\n    if (s.do === 'repair') {\\n      const riding = this.inVehicle && this.car;\\n450→      const here = this.feet();\\n      const x = here.x + (riding ? 0 : 3);\\n      const z = here.z;\\n      if (!this.car) this.ensureTruck(x, z);\\n      else this.car.reset([x, this.ground(x, z) + 1.2, z], Math.PI);\\n      this.vehicleHp = 0;\\n      this.inVehicle = false;\\n      if (this.hero.collider) this.hero.collider.setEnabled(true);\\n      const t = this.truckPos();\\n      this.hero.teleport([t.x + 2, this.ground(t.x, t.z) + 0.1, t.z]);\\n460→    }\\n    if (s.do === 'syrette') this.hurt(30, 'bullet', true);\\n    if (s.do === 'buddy-down') this.knockBuddy();\\n    if (s.do === 'clear') {\\n      const site = siteById('ranger-post') || { x: this.feet().x, z: this.feet().z };\\n      this.spawnSoldier({ id: s.tag, post: s.tag, x: site.x + 2, z: site.z, faction: 'concord' });\\n    }\\n    if (s.do === 'fever-fall') {\\n      this.feverT = 0;\\n      this.tablets = 0;\\n470→    }\\n  }\\n\\n  knockBuddy() {\\n    const b = this.buddies.find((x) => x.alive && !x.down);\\n    if (!b) {\\n      this.subtitle = line('buddy:burn');\\n      this.completeStep();\\n      return;\\n    }\\n480→    this.downBuddy(b.id, { burning: true });\\n    this.subtitle = line('buddy:burn');\\n    this.speaker = b.name;\\n  }\\n\\n  downBuddy(id, opts = {}) {\\n    let b = this.buddies.find((x) => x.id === id);\\n    if (!b) {\\n      b = this.makeBuddy(id);\\n      this.buddies.push(b);\\n490→    }\\n    b.hp = 0;\\n    b.alive = true;\\n    b.down = true;\\n    b.downLeft = 40;\\n    b.burning = !!opts.burning;\\n    const p = this.feet();\\n    b.x = p.x + 1.2;\\n    b.z = p.z;\\n    return b;\\n500→  }\\n\\n  finishBuddy(b) {\\n    if (!b || !b.down) return;\\n    b.alive = false;\\n    b.down = false;\\n    b.hp = 0;\\n    if (!this.deadBuddies.has(b.id)) {\\n      this.deadBuddies.add(b.id);\\n      this.ledger.friends += 1;\\n510→    }\\n    this.subtitle = 'IT IS DONE.';\\n    if (this.currentStep()?.do === 'buddy-down') this.completeStep();\\n  }\\n\\n  completeStep() {\\n    if (!this.mission || this.mission.done) return;\\n    this.mission.index += 1;\\n    this.choice = null;\\n    if (this.mission.index >= this.mission.def.steps.length) {\\n520→      this.mission.done = true;\\n      this.finishMission();\\n      return;\\n    }\\n    this.announceStep();\\n  }\\n\\n  finishMission() {\\n    const m = this.mission.def;\\n    for (const effect of m.onDone || []) {\\n530→      if (effect.flag) this.flags.add(effect.flag);\\n      if (effect.safehouse) this.safehouses.add(effect.safehouse);\\n      if (effect.tablets) this.tablets += effect.tablets;\\n      if (effect.pay) this.pay(effect.pay);\\n      if (effect.scar) this.layScar(effect.scar);\\n      if (effect.buddy) {\\n        if (!this.buddies.some((b) => b.id === effect.buddy)) this.buddies.push(this.makeBuddy(effect.buddy));\\n      }\\n      if (effect.tracker) this.tracker = true;\\n      if (effect.truce === false) this.truce = false;\\n540→      if (effect.column) this.column = true;\\n      if (effect.moveVillage) this.moveVillage();\\n      if (effect.ending) this.game.showEnding(this.sheet || 'give');\\n    }\\n    this.pass = null;\\n    this.windPin = null;\\n    this.subtitle = m.title + ' DONE';\\n  }\\n\\n  moveVillage() {\",\"content_concise\":\"270→  }\\n\\n  get weapon() {\\n    return this.guns[this.slot] || null;\\n  }\\n\\n  hurt(amount, kind = 'bullet', force = false) {\\n    if (this.dead) return;\\n    if (this.god && !force) return;\\n    const d = amount * TUNING.playerDamageTaken;\\n280→    this.hp = Math.max(0, this.hp - d);\\n    this.lastHurt = kind;\\n    this.regenT = 5;\\n    this.surgeryT = 0;\\n    if (this.hp <= 0) this.down();\\n  }\\n\\n  down() {\\n    if (this.round) {\\n      this.round.noteDown();\\n290→      return;\\n    }\\n    const buddy = this.buddies.find((b) => b.alive && !b.down && (b.spentUntil || 0) <= this.clock);\\n    if (buddy) {\\n      this.rescueT = 2.2;\\n      this.rescueBuddy = buddy;\\n      this.subtitle = line('buddy:rescue');\\n      this.speaker = buddy.name;\\n      return;\\n    }\\n300→    this.dead = true;\\n    this.subtitle = line('death');\\n    this.game.onDeath();\\n  }\\n\\n  pay(amount) {\\n    const n = Math.round(amount * TUNING.stonesReward);\\n    this.stones += n;\\n    this.ledger.stonesEarned += n;\\n  }\\n310→\\n  applySetup(setup, deadIds = []) {\\n    this.flags 