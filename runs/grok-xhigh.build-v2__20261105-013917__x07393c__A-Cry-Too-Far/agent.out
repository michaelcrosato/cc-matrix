376,\"content\":\"    phase = 'ended';\"},{\"line_number\":396,\"content\":\"    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\"},{\"line_number\":468,\"content\":\"    if (!seat || seat.out || phase === 'ended') return;\"},{\"line_number\":513,\"content\":\"      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\"},{\"line_number\":515,\"content\":\"    /** End the round now: the session ended, or the host skipped this game. */\"},{\"line_number\":517,\"content\":\"      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/src/sim/round.js\",\"matches\":[{\"line_number\":273,\"content\":\"    if (this.session.isHost && this.session.kind !== 'hub' && this.t >= this.limit) this.finish('time');\"},{\"line_number\":302,\"content\":\"  finish(reason) {\"},{\"line_number\":325,\"content\":\"    this.session.finish({ standings, scores, stats, awards, reason });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aadc-c537-7073-8756-0b078a9e97df","uuid":"9dbc9a8d-5311-4ef5-b294-96a0147852a6"}
