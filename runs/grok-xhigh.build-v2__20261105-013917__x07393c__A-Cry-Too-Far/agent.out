rt(g.screen === 'settings', 'tap did not open settings ' + g.screen);\\n});\\n\\nconst picked = tests.filter((t) => !only || t.name.includes(only));\\n630→let failed = 0;\\nfor (const t of picked) {\\n  try {\\n    await t.fn();\\n  } catch (err) {\\n    failed += 1;\\n    if (engine) {\\n      engine.timeScale = 1;\\n      release();\\n    }\\n640→    const msg = String(err && err.stack || err).split('\\\\n').filter((line) => line.length < 240).slice(0, 8).join('\\\\n');\\n    console.log('FAIL ' + t.name + '\\\\n' + msg);\\n  }\\n}\\nconsole.log('passed ' + (picked.length - failed) + ' failed ' + failed);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013917__x07393c/work/A Cry Too Far-Far Cry 2-grok-4.7-xhigh-20261105-013917/tests/run.mjs\",\"offset\":610,\"limit\":35,\"raw_output\":\"\\nconst touch = test;\\ntouch('touch gate', async () => {\\n  const g = createGame({ touchOnly: true });\\n  const e = await Engine.headless(g, { seed: 2 });\\n  assert(g.notice === 'Controller or keyboard required', g.notice);\\n  assert(g.items().length === 1 && g.items()[0].id === 'settings', 'touch menu');\\n  e.step(601, DT);\\n  assert(g.attract, 'touch blocked attract');\\n  g.exitAttract();\\n  g.focus = 0;\\n  e.input.setPointer(0, 1 - (86 / 270) * 2, true);\\n  e.input.setButtons(1);\\n  e.step(1, DT);\\n  e.input.setButtons(0);\\n  e.step(1, DT);\\n  assert(g.screen === 'settings', 'tap did not open settings ' + g.screen);\\n});\\n\\nconst picked = tests.filter((t) => !only || t.name.includes(only));\\nlet failed = 0;\\nfor (const t of picked) {\\n  try {\\n    await t.fn();\\n  } catch (err) {\\n    failed += 1;\\n    if (engine) {\\n      engine.timeScale = 1;\\n      release();\\n    }\\n    const msg = String(err && err.stack || err).split('\\\\n').filter((line) => line.length < 240).slice(0, 8).join('\\\\n');\\n    console.log('FAIL ' + t.name + '\\\\n' + msg);\\n  }\\n}\\nconsole.log('passed ' + (picked.length - failed) + ' faile