97334677);return n=Math.imul(n^n>>>16,2246822507),n^=Math.imul(r^r>>>13,3266489909),r=Math.imul(r^r>>>16,2246822507),r^=Math.imul(n^n>>>13,3266489909),4294967296*(2097151&r)+(n>>>0)}var nf=e=>tf(e),rf=e=>tf(e),af=(...e)=>tf(e),lte=/*@__PURE__*/ new Map([[1,`float`],[2,`vec2`],[3,`vec3`],[4,`vec4`],[9,`mat3`],[16,`mat4`]]),of=/*@__PURE__*/ new WeakMap;function sf(e){return lte.get(e)}function cf(e){if(/[iu]?vec\\\\d/.test(e))return e.startsWith(`ivec`)?Int32Array:e.startsWith(`uvec`)?Uint32Array:Float32Array;if(/mat\\\\d/.test(e)||/float/.test(e))return Float32Array;if(/uint/.test(e))return Uint32Array;if(/int/.test(e))return Int32Array;throw Error(`THREE.NodeUtils: Unsupported type: ${e}`)}function lf(e){if(/float|int|uint|boo [... truncated (1031 chars total)]\"},{\"line_number\":579,\"content\":\"      </div>`;for(let e of this.root.querySelectorAll(`[data-s]`))this.controls.set(e.dataset.s,e);for(let e of this.root.querySelectorAll(`[data-o]`))this.outputs.set(e.dataset.o,e);let o=e.settings,s=(e,t)=>{let n=this.controls.get(e);n.addEventListener(n instanceof HTMLInputElement&&n.type===`range`?`input`:`change`,()=>{t(n),this.sync()})};s(`look`,e=>o.set({look:e.value||void 0})),s(`pixelArt`,e=>o.set({pixelArt:e.checked})),s(`pixelSize`,e=>o.set({pixelSize:e.value})),s(`quality`,e=>o.set({quality:e.value})),s(`fps`,e=>o.set({fps:kY.includes(Number(e.value))?Number(e.value):void 0})),s(`debugInfo`,e=>o.set({debugInfo:e.checked})),s(`sound`,t=>{e.audio.unlock(),e.audio.setMuted(!t.checked)});for(let[t]of LY)s(t,n=>{e.audio.unlock(),e.audio.setVolume(t,Number(n.value)/100)});let c=(e,t)=>this.root.querySelector(`[data-a=\\\"${e}\\\"]`).addEventListener(`click`,t);c(`close`,()=>o.close()),c(`done`,()=>o.close()),c(`reset`,()=>{o.reset(),e.audio.resetVolumes(),this.sync()}),this.root.addEv [... truncated (1031 chars total)]\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-d4fc5e2b-9694-4fe1-8617-b79829b6da65-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** Headless acceptance. Run from the dev folder: node tests/run.mjs --all */\\nimport { execFileSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { Engine, checkModel, parseSong, validateTexture } from '../pixel-engine.js';\\nimport { aboutPages } from '../src/content/about.js';\\nimport { LINES } from '../src/content/dialogue.js';\\n10→import { SONGS } from '../src/audio/songs.js';\\nimport { MODELS } from '../src/art/models.js';\\nimport { TEXTURES } from '../src/art/textures.js';\\nimport { siteById } from '../src/content/sites.js';\\nimport { TUNING_DEFAULTS, TUNING_RANGES, SLIDER_KEYS } from '../src/content/tuning-defaults.js';\\nimport { TUNING } from '../src/core/tuning.js';\\nimport { createGame } from '../src/game.js';\\n\\nconst root = dirname(dirname(fileURLToPath(import.meta.url)));\\nconst args = process.argv.slice(2);\\n20→const only = args.find((a) => a.startsWith('--only='))?.slice(7)\\n  || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\\nconst DT = 1 / 60;\\nconst tests = [];\\nconst test = (name, fn) => tests.push({ name, fn });\\n\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg || 'assertion failed');\\n}\\n\\n30→let engine;\\nlet game;\\n\\nasync function boot() {\\n  if (engine) return;\\n  game = createGame();\\n  engine = await Engine.headless(game, { seed: 1 });\\n}\\n\\nfunction release() {\\n40→  for (const code of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'ShiftLeft', 'Space', 'Enter', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4']) {\\n    engine.input.setKey(code, false);\\n  }\\n  engine.input.setButtons(0);\\n}\\n\\nfunction tap(code) {\\n  engine.input.setKey(code, true);\\n  engine.step(1, DT);\\n  engine.input.setKey(code, false);\\n50→  engine.step(1, DT);\\n}\\n\\nfunction holdKey(code, frames) {\\n  engine.input.setKey(code, true);\\n  engine.step(frames, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\n60→function tapFire() {\\n  engine.input.setButtons(1);\\n  engine.step(2, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdFire(frames) {\\n  engine.input.setButtons(1);\\n  engine.step(frames, DT);\\n70→  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction arm(id) {\\n  const w = game.world;\\n  const i = w.guns.findIndex((g) => g.id === id);\\n  if (i < 0) throw new Error('no gun ' + id);\\n  tap('Digit' + (i + 1));\\n  if (w.weapon?.id !== id) throw new Error('selected ' + w.weapon?.id + ' instead of ' + id);\\n80→}\\n\\nfunction goTo(x, z, r) {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  release();\\n  for (let spins = 0; spins < 2500; spins++) {\\n    if (!w.mission || w.mission.done || w.currentStep() !== step) {\\n      release();\\n      return;\\n90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n  for (let guard = 0; guard < 80 && w.mission && !w.mission.done; guard++) {\\n130→    const step = w.currentStep();\\n    if (!step) break;\\n    const before = w.mission.index;\\n    if (step.do === 'lines') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'lines'; n++) tap('Enter');\\n    } else if (step.do === 'map') {\\n      if (!w.map.up) tap('KeyM');\\n      else engine.step(1, DT);\\n      if (w.map.up) tap('KeyM');\\n    } else if (step.do === 'fever-fall') {\\n140→      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n        goTo(x + radius + 30, z, 8);\\n150→      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n    } else if (step.do === 'syrette') {\\n160→      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n        engine.input.setButtons(0);\\n170→        engine.step(1, DT);\\n      }\\n    } else if (step.do === 'burn') {\\n      if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n      const r = step.r || 12;\\n      const origin = w.fire.cellAt(step.x, step.z);\\n      let lx = step.x;\\n      let lz = step.z;\\n      const reach = Math.ceil(r / 5);\\n      let best = Infinity;\\n180→      for (let dz = -reach; dz <= reach; dz++) {\\n        for (let dx = -reach; dx <= reach; dx++) {\\n          const ix = origin.ix + dx;\\n          const iz = origin.iz + dz;\\n          if (ix < 0 || iz < 0 || ix >= 256 || iz >= 256) continue;\\n          const i = w.fire.idx(ix, iz);\\n          if (w.fire.fuel[i] <= 0 || w.fire.state[i] !== 0) continue;\\n          const [cx, cz] = w.fire.center(ix, iz);\\n          const d = Math.hypot(cx - step.x, cz - step.z);\\n          if (d > r - 1 || d >= best) continue;\\n190→          best = d;\\n          lx = cx;\\n          lz = cz;\\n        }\\n      }\\n      w.teleport(lx, lz + 18);\\n      game.ctx.camera.yaw = 0;\\n      arm('flare');\\n      tapFire();\\n      engine.step(20, DT);\\n200→    } else if (step.do === 'clear') {\",\"content_concise\":\"1→/** Headless acceptance. Run from the dev folder: node tests/run.mjs --all */\\nimport { execFileSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\\nimport { dirname, join } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { Engine, checkModel, parseSong, validateTexture } from '../pixel-engine.js';\\nimport { aboutPages } from '../src/content/about.js';\\nimport { LINES } from '../src/content/dialogue.js';\\n10→import { SONGS } from '../src/audio/songs.js';\\nimport { MODELS } from '../src/art/models.js';\\nimport { TEXTURES } from '../src/art/textures.js';\\nimport { siteById } from '../src/content/sites.js';\\nimport { TUNING_DEFAULTS, TUNING_RANGES, SLIDER_KEYS } from '../src/content/tuning-defaults.js';\\nimport { TUNING } from '../src/core/tuning.js';\\nimport { createGame } from '../src/game.js';\\n\\nconst root = dirname(dirname(fileURLToPath(import.meta.url)));\\nconst args = process.argv.slice(2);\\n20→const only = args.find((a) => a.startsWith('--only='))?.slice(7)\\n  || (args.includes('--only') ? args[args.indexOf('--only') + 1] : '');\\nconst DT = 1 / 60;\\nconst tests = [];\\nconst test = (name, fn) => tests.push({ name, fn });\\n\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg || 'assertion failed');\\n}\\n\\n30→let engine;\\nlet game;\\n\\nasync function boot() {\\n  if (engine) return;\\n  game = createGame();\\n  engine = await Engine.headless(game, { seed: 1 });\\n}\\n\\nfunction release() {\\n40→  for (const code of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'KeyQ', 'KeyM', 'KeyH', 'KeyF', 'KeyC', 'KeyJ', 'ShiftLeft', 'Space', 'Enter', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4']) {\\n    engine.input.setKey(code, false);\\n  }\\n  engine.input.setButtons(0);\\n}\\n\\nfunction tap(code) {\\n  engine.input.setKey(code, true);\\n  engine.step(1, DT);\\n  engine.input.setKey(code, false);\\n50→  engine.step(1, DT);\\n}\\n\\nfunction holdKey(code, frames) {\\n  engine.input.setKey(code, true);\\n  engine.step(frames, DT);\\n  engine.input.setKey(code, false);\\n  engine.step(1, DT);\\n}\\n\\n60→function tapFire() {\\n  engine.input.setButtons(1);\\n  engine.step(2, DT);\\n  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction holdFire(frames) {\\n  engine.input.setButtons(1);\\n  engine.step(frames, DT);\\n70→  engine.input.setButtons(0);\\n  engine.step(1, DT);\\n}\\n\\nfunction arm(id) {\\n  const w = game.world;\\n  const i = w.guns.findIndex((g) => g.id === id);\\n  if (i < 0) throw new Error('no gun ' + id);\\n  tap('Digit' + (i + 1));\\n  if (w.weapon?.id !== id) throw new Error('selected ' + w.weapon?.id + ' instead of ' + id);\\n80→}\\n\\nfunction goTo(x, z, r) {\\n  const w = game.world;\\n  const step = w.currentStep();\\n  release();\\n  for (let spins = 0; spins < 2500; spins++) {\\n    if (!w.mission || w.mission.done || w.currentStep() !== step) {\\n      release();\\n      return;\\n90→    }\\n    const p = w.feet();\\n    if (Math.hypot(x - p.x, z - p.z) <= r) {\\n      release();\\n      engine.step(1, DT);\\n      return;\\n    }\\n    const look = Math.atan2(-(x - p.x), -(z - p.z));\\n    game.ctx.camera.yaw = look;\\n    let aligned = true;\\n100→    if (w.inVehicle && w.car) {\\n      const face = Math.atan2(x - p.x, z - p.z);\\n      let err = face - w.car.yaw;\\n      while (err > Math.PI) err -= Math.PI * 2;\\n      while (err < -Math.PI) err += Math.PI * 2;\\n      aligned = Math.abs(err) < 0.7;\\n      engine.input.setKey('KeyA', err > 0.25);\\n      engine.input.setKey('KeyD', err < -0.25);\\n    }\\n    engine.input.setKey('KeyW', aligned);\\n110→    engine.step(6, DT);\\n  }\\n  const p = w.feet();\\n  release();\\n  throw new Error('goto stuck at ' + p.x.toFixed(1) + ',' + p.z.toFixed(1) + ' wanting ' + x + ',' + z);\\n}\\n\\nfunction placeFacing(x, z) {\\n  const w = game.world;\\n  if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n120→  w.teleport(x, z + 4);\\n  game.ctx.camera.yaw = 0;\\n  engine.step(1, DT);\\n}\\n\\nfunction playMission(id, opts = {}) {\\n  const w = game.world;\\n  assert(w.startMission(id, opts), 'missing ' + id);\\n  let choiceI = 0;\\n  for (let guard = 0; guard < 80 && w.mission && !w.mission.done; guard++) {\\n130→    const step = w.currentStep();\\n    if (!step) break;\\n    const before = w.mission.index;\\n    if (step.do === 'lines') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'lines'; n++) tap('Enter');\\n    } else if (step.do === 'map') {\\n      if (!w.map.up) tap('KeyM');\\n      else engine.step(1, DT);\\n      if (w.map.up) tap('KeyM');\\n    } else if (step.do === 'fever-fall') {\\n140→      engine.step(Math.ceil(26 * 60), DT);\\n    } else if (step.do === 'tablet') {\\n      holdKey('KeyH', 90);\\n    } else if (step.do === 'goto' || step.do === 'drive' || step.do === 'leave') {\\n      const site = step.site ? siteById(step.site) : null;\\n      const x = site ? site.x : step.x;\\n      const z = site ? site.z : step.z;\\n      const radius = step.r || (step.do === 'leave' ? 40 : 20);\\n      if (step.do === 'leave') {\\n        goTo(x + radius + 30, z, 8);\\n150→      } else goTo(x, z, Math.max(4, radius - 2));\\n    } else if (step.do === 'jam') {\\n      arm('tractor');\\n      for (let n = 0; n < 24 && w.currentStep()?.do === 'jam'; n++) {\\n        if (w.weapon?.jammed) tap('KeyR');\\n        else holdFire(15);\\n      }\\n    } else if (step.do === 'repair') {\\n      holdKey('KeyE', 220);\\n    } else if (step.do === 'syrette') {\\n160→      holdKey('KeyQ', 70);\\n    } else if (step.do === 'destroy') {\\n      for (let n = 0; n < 8 && w.currentStep()?.do === 'destroy'; n++) {\\n        const prop = w.props.find((p) => p.alive !== false && p.tag === step.tag);\\n        if (!prop) break;\\n        placeFacing(prop.x, prop.z);\\n        if (w.guns.some((g) => g.id === 'tractor')) arm('tractor');\\n        engine.input.setButtons(1);\\n        for (let f = 0; f < 90 && w.currentStep()?.do === 'destroy'; f++) engine.step(1, DT);\\n        engine.input.setButtons(0);\\n170→        engine.step(1, DT);\\n      }\\n    } else if (step.do === 'burn') {\\n      if (w.inVehicle && w.vehicleHp >= 50) tap('KeyE');\\n      const r = step.r || 12;\\n      const origin = w.fire.cellAt(step.x, step.z);\\n      let lx = step.x;\\n      let lz = step.z;\\n      const reach = Math.ceil(r / 5);\\n      let best = Infinity;\\n180→      for (let dz = -reach; dz <= reach; dz++) {\\n        for (let dx = -reach; dx <= reach; dx++) {\\n      