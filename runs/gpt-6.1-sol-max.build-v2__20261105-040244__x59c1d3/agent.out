uble-fist':{handR:[.4,.2,-.4],handL:[.4,-.2,-.4],lean:.3},\n};\nexport const ACTIONS=Object.entries(moves).map(([name,m])=>defineAction(\"'`action:${name}`,{desc:`Original Harbor Light gesture: ${name}.`,beats:[{name:'\"'prepare',seconds:.15,motion:{lean:(m.lean??0)*.3}},{name:'gesture',seconds:.65,effectors:{...(m.handR?{handR:m.handR}:{}),...(m.handL?{handL:m.handL}:{})},motion:{lean:m.lean??0,twist:m.twist??0,crouch:m.crouch??0}},{name:'settle',seconds:.35}]} satisfies ActionSpec));\n''')\nPath('labs/game/view/bodies/index.ts').write_text('''/** @file Distinct surgical puppets built on native adult proportions and the engine body grammar. */\nimport {defineBody,defineBuild,getBody,getBuild,type BodyPart} from '../../../../engine';\nconst adult=getBuild('build:adult');\ndefineBuild('build:drama',{...Object.fromEntries(Object.entries(adult).filter(([k])=>k\"'!=='\"'id'&&k\"'!=='\"'kind')),headRadius:adult.headRadius*1.25});\nconst human=getBody('body:humanoid');\nconst people:Record<string,[string,string,string,string]>={wren:['#d9ad89','#203034','#3d9d98','#1a4850'],odie:['#bd8e69','#c4b9aa','#233e54','#192939'],chief:['#e6b995','#bdb4a3','#e8e7db','#374653'],sabine:['#8e5f46','#cbd2cf','#e6dbc2','#394f58'],voss:['#e4bca1','#a28462','#e4d8b8','#e6dfce'],patient:['#d4a383','#684a39','#9baea5','#657c7c']};\nfor(const [id,[skin,hair,cloth,pants]] of Object.entries(people)){\n const extras:BodyPart[]=[];\n if(id==='chief')extras.push(['limb',['off','head',.18,-.09,.15],['off','head',.18,.09,.15],.035,.045,'hair']);\n if(id==='odie')extras.push(['ball',['off','head',-.17,0,.4],.14,'hair']);\n if(id==='wren')for(const sign of [-1,1])extras.push(['limb',['off','head',.22,sign*.03,.22],['off','head',.22,sign*.15,.22],.012,.012,'belt']);\n defineBody(\"'`body:${id}`,{description:`Original Harbor Light cast: ${id}.`,build:'\"'build:drama',parts:[...human.parts,...extras],mirror:human.mirror,slots:{...human.slots,skin,hair,cloth,pants,boot:'#172d35',belt:'#c7b582'},limbRadius:.07,torsoRadius:.23});\n}\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/cast/props.ts');s=p.read_text().replace(\\\"export function stage\\\", \\\"for(const id of ['sheet','wet','thread','glow','steel','glove'])defineProp(\"'`prop:live-${id}`,{description:`Live surgical ${id} surface.`,parts:[{geometry:`geometry:live-${id}`,material:id==='\"'sheet'?'material:tissue':id==='wet'?'material:wet':id==='thread'?'material:thread':id==='glow'?'material:field-glow':id==='steel'?'material:field-steel':'material:field-glove'}]});\\\\nexport function stage\\\");p.write_text(s)\nPath('labs/game/scenes/main.ts').write_text('''/** @file The one engine scene: title and story sets, or a deterministic surgical operation. */\nimport {defineScene,defineComponent,createCharacter,spawnActor,actOn,addBox,physicsOf,type World} from '../../../engine/sim-api';\nimport {BALANCE,GAME_SETTINGS} from '../data/balance';\nimport {getCase} from '../data/cases';\nimport {storyFor} from '../data/story';\nimport type {Difficulty,Hand,Operation,Rules} from '../data/types';\nimport {stage} from '../cast/props';\nimport '../cast/actions';\nimport {botHand,botHands} from '../bot';\nimport {createOperation} from './op/state';\nimport {stepOperation} from './op/step';\nimport './op/dev';\nvoid GAME_SETTINGS;\ndefineComponent('operation',{description:'The complete deterministic surgery state.',fields:{data:{type:'object',default:{},description:'Case, patients, instruments, targets and checkpoints.'}}});\ndefineComponent('theatre',{description:'A staged hospital scene.',fields:{run:{type:'string',default:'title',description:'Scene identifier.'},beat:{type:'integer',default:-1,description:'Current dialogue beat.'},actors:{type:'object',default:{},description:'Cast actor ids.'}}});\nexport interface GameComponents {operation:{data:Operation};theatre:{run:string;beat:number;actors:Record<string,number>};}\nexport function readRules(w:World):Rules{\n return {balance:Object.fromEntries(Object.keys(BALANCE).map(k=>[k,w.settings.get<number>(\"'`game.${k}`)])),difficulty:w.settings.get<Difficulty>('\"'game.difficulty'),simpleGift:w.settings.get<boolean>('game.simpleGift'),attract:w.settings.get<boolean>('game.attract'),freezeVitals:w.settings.get<boolean>('game.freezeVitals'),freezeClock:w.settings.get<boolean>('game.freezeClock'),infiniteGift:w.settings.get<boolean>('game.infiniteGift'),oneHit:w.settings.get<boolean>('game.oneHit')};\n}\nexport const main=defineScene<GameComponents>('game:main',{\n description:'Harbor Light: story drama and first-person surgical action.',physics:true,\n setup(w){\n  const run=w.settings.get<string>('game.run'),isOp=run.startsWith('op:');\n  addBox(physicsOf(w),{at:[0,-.5,0],size:[50,1,50],type:'fixed'});\n  if(isOp){\n   stage(w,'field');\n   spawnActor(w,{at:[0,-8,0],character:createCharacter({speed:0}),player:true});\n   const s=createOperation(run.slice(3),w.rng('operation').int(1,999999),w.settings.get<number>('game.seats'),w.settings.get<number>('game.phase'),readRules(w));\n   w.spawn({operation:{data:s}});\n  }else{\n   const parts=run.split(':'),story=run.startsWith('story:')?storyFor(Number(parts[1]),parts[2]==='after'?'after':'before'):null;\n   stage(w,story?.set??'or');\n   const actors:Record<string,number>={};\n   const cast=story?[...new Set(story.beats.map(b=>b.who))]:['wren','odie'];\n   for(let i=0;i<cast.length;i++){\n    const who=cast[i];actors[who]=spawnActor(w,{at:[-3.5+i*1.45,0,3.7+(i%2)*.4],character:createCharacter({speed:0}),player:i===0,yaw:Math.PI,body:\"'`body:${who}`,anim:{build:'\"'build:drama'}});\n   }\n   w.spawn({theatre:{run,beat:-1,actors}});\n  }\n },\n step(w,intents){\n  const entity=w.query('operation')[0];\n  if(entity){\n   const s=entity.operation.data,r=readRules(w);let hands=intents['game:hands'] as unknown as Hand[]|undefined;\n   if(w.settings.get<boolean>('game.autoplay')||r.attract)hands=botHands(s,r);\n   else if(getCase(s.caseId).ai&&w.settings.get<number>('game.seats')===1){hands=hands?[...hands]:[];hands[1]=botHand(s,1,r,true);}\n   stepOperation(s,hands??s.seats.map(p=>[p.x,p.z,p.tool,p.held?1:0,p.giftCounter,p.shockCounter,p.site,p.swapCounter,0]),r);\n   const last=s.events.at(-1);if(last&&last.n>0&&last.type==='rating')w.emit('surgical-rating',{text:last.text});\n  }else{\n   const theatre=w.query('theatre')[0]?.theatre,beat=intents['game:beat'];\n   if(theatre&&typeof beat==='number'&&beat\"'!==theatre.beat&&theatre.run.startsWith('\"'story:')){\n    theatre.beat=beat;const p=theatre.run.split(':'),story=storyFor(Number(p[1]),p[2]==='after'?'after':'before'),b=story.beats[beat];\n    if(b&&theatre.actors[b.who])actOn(w,theatre.actors[b.who],a=>a.play(\"'`action:${b.act}`));\n   }\n  }\n }\n});\nexport default main;\n'\"''')\nPath('labs/game/scenes/op/dev.ts').write_text('''/** @file Reproducible developer actions; every mutation goes through the engine action recorder. */\nimport {defineDevAction,type World} from '../../../../engine/sim-api';\nimport {KINDS} from '../../data/tools';\nimport {getCase} from '../../data/cases';\nimport type {Operation,TargetKind} from '../../data/types';\nimport {event,fail,seat,spawn,startPhase} from './state';\nconst state=(w:World):Operation|undefined=>(w.query('operation')[0] as unknown as {operation:{data:Operation}}|undefined)?.operation.data;\ndefineDevAction('surgery-control',{help:'Advance, fail, restore vitals, grant Gift or add a bot.',args:{command:{type:'string',default:'heal',enum:['phase','fail','heal','gift','bot','win'],description:'The change to record.'}},run(w,args){const s=state(w);if(\"'!s)return;s.dev=true;switch(args.command){case '\"'phase':if(s.phase<getCase(s.caseId).phases.length-1)startPhase(s,s.phase+1);else s.status='won';break;case 'fail':fail(s,'Developer failure injection.');break;case 'heal':s.patients.fill(100);s.code=null;break;case 'gift':for(const p of s.seats)p.gift=99;break;case 'bot':if(s.seats.length<4)s.seats.push(seat(s.seats.length,'none',0));break;case 'win':s.status='won';event(s,'won','OPERATION COMPLETE');break;}}});\ndefineDevAction('surgery-spawn',{help:'Spawn a target at a surgeon cursor.',args:{kind:{type:'string',default:'lull',enum:KINDS,description:'Target kind.'},x:{type:'number',default:0,description:'East, metres.'},z:{type:'number',default:0,description:'South, metres.'},site:{type:'integer',default:0,minimum:0,maximum:2,description:'Field index.'}},run(w,args){const s=state(w);if(\"'!s)return;s.dev=true;spawn(s,{kind:args.kind as TargetKind,at:[args.x as number,args.z as number],site:args.site as number,path:['\"'wound','incision'].includes(String(args.kind))?[[Number(args.x)-1,Number(args.z)],[Number(args.x)+1,Number(args.z)]]:undefined});}});\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/cast/props.ts');s=p.read_text().replace(\\\"export function stage\\\", \\\"for(const id of ['sheet','wet','thread','glow','steel','glove'])defineProp(\"'`prop:live-${id}`,{description:`Live surgical ${id} surface.`,parts:[{geometry:`geometry:live-${id}`,material:id==='\"'sheet'?'material:tissue':id==='wet'?'material:wet':id==='thread'?'material:thread':id==='glow'?'material:field-glow':id==='steel'?'material:field-steel':'material:field-glove'}]});\\\\nexport function stage\\\");p.write_text(s)\nPath('labs/game/scenes/main.ts').write_text('''/** @file The one engine scene: title and story sets, or a deterministic surgical operation. */\nimport {defineScene,defineComponent,createCharacter,spawnActor,actOn,addBox,physicsOf,type World} from '../../../engine/sim-api';\nimport {BALANCE,GAME_SETTINGS} from '../data/balance';\nimport {getCase} from '../data/cases';\nimport {storyFor} from '../data/story';\nimport type {Difficulty,Hand,Operation,Rules} from '../data/types';\nimport {stage} from '../cast/props';\nimport '../cast/actions';\nimport {botHand,botHands} from '../bot';\nimport {createOperation} from './op/state';\nimport {stepOperation} from './op/step';\nimport './op/dev';\nvoid GAME_SETTINGS;\ndefineComponent('operation',{description:'The complete deterministic surgery state.',fields:{data:{type:'object',default:{},description:'Case, patients, instruments, targets and checkpoints.'}}});\ndefineComponent('theatre',{description:'A staged hospital scene.',fields:{run:{type:'string',default:'title',description:'Scene identifier.'},beat:{type:'integer',default:-1,description:'Current dialogue beat.'},actors:{type:'object',default:{},description:'Cast actor ids.'}}});\nexport interface GameComponents {operation:{data:Operation};theatre:{run:string;beat:number;actors:Record<string,number>};}\nexport function readRules(w:World):Rules{\n return {balance:Object.fromEntries(Object.keys(BALANCE).map(k=>[k,w.settings.get<number>(\"'`game.${k}`)])),difficulty:w.settings.get<Difficulty>('\"'game.difficulty'),simpleGift:w.settings.get<boolean>('game.simpleGift'),attract:w.settings.get<boolean>('game.attract'),freezeVitals:w.settings.get<boolean>('game.freezeVitals'),freezeClock:w.settings.get<boolean>('game.freezeClock'),infiniteGift:w.settings.get<boolean>('game.infiniteGift'),oneHit:w.settings.get<boolean>('game.oneHit')};\n}\nexport const main=defineScene<GameComponents>('game:main',{\n description:'Harbor Light: story drama and first-person surgical action.',physics:true,\n setup(w){\n  const run=w.settings.get<string>('game.run'),isOp=run.startsWith('op:');\n  addBox(physicsOf(w),{at:[0,-.5,0],size:[50,1,50],type:'fixed'});\n  if(isOp){\n   stage(w,'field');\n   spawnActor(w,{at:[0,-8,0],character:createCharacter({speed:0}),player:true});\n   const s=createOperation(run.slice(3),w.rng('operation').int(1,999999),w.settings.get<number>('game.seats'),w.settings.get<number>('game.phase'),readRules(w));\n   w.spawn({operation:{data:s}});\n  }else{\n   const parts=run.split(':'),story=run.startsWith('story:')?storyFor(Number(parts[1]),parts[2]==='after'?'after':'before'):null;\n   stage(w,story?.set??'or');\n   const actors:Record<string,number>={};\n   const cast=story?[...new Set(story.beats.map(b=>b.who))]:['wren','odie'];\n   for(let i=0;i<cast.length;i++){\n    const who=cast[i];actors[who]=spawnActor(w,{at:[-3.5+i*1.45,0,3.7+(i%2)*.4],character:createCharacter({speed:0}),player:i===0,yaw:Math.PI,body:\"'`body:${who}`,anim:{build:'\"'build:drama'}});\n   }\n   w.spawn({theatre:{run,beat:-1,actors}});\n  }\n },\n step(w,intents){\n  const entity=w.query('operation')[0];\n  if(entity){\n   const s=entity.operation.data,r=readRules(w);let hands=intents['game:hands'] as unknown as Hand[]|undefined;\n   if(w.settings.get<boolean>('game.autoplay')||r.attract)hands=botHands(s,r);\n   else if(getCase(s.caseId).ai&&w.settings.get<number>('game.seats')===1){hands=hands?[...hands]:[];hands[1]=botHand(s,1,r,true);}\n   stepOperation(s,hands??s.seats.map(p=>[p.x,p.z,p.tool,p.held?1:0,p.giftCounter,p.shockCounter,p.site,p.swapCounter,0]),r);\n   const last=s.events.at(-1);if(last&&last.n>0&&last.type==='rating')w.emit('surgical-rating',{text:last.text});\n  }else{\n   const theatre=w.query('theatre')[0]?.theatre,beat=intents['game:beat'];\n   if(theatre&&typeof beat==='number'&&beat\"'!==theatre.beat&&theatre.run.startsWith('\"'story:')){\n    theatre.beat=beat;const p=theatre.run.split(':'),story=storyFor(Number(p[1]),p[2]==='after'?'after':'before'),b=story.beats[beat];\n    if(b&&theatre.actors[b.who])actOn(w,theatre.actors[b.who],a=>a.play(\"'`action:${b.act}`));\n   }\n  }\n }\n});\nexport default main;\n'\"''')\nPath('labs/game/scenes/op/dev.ts').write_text('''/** @file Reproducible developer actions; every mutation goes through the engine action recorder. */\nimport {defineDevAction,type World} from '../../../../engine/sim-api';\nimport {KINDS} from '../../data/tools';\nimport {getCase} from '../../data/cases';\nimport type {Operation,TargetKind} from '../../data/types';\nimport {event,fail,seat,spawn,startPhase} from './state';\nconst state=(w:World):Operation|undefined=>(w.query('operation')[0] as unknown as {operation:{data:Operation}}|undefined)?.operation.data;\ndefineDevAction('surgery-control',{help:'Advance, fail, restore vitals, grant Gift or add a bot.',args:{command:{type:'string',default:'heal',enum:['phase','fail','heal','gift','bot','win'],description:'The change to record.'}},run(w,args){const s=state(w);if(\"'!s)return;s.dev=true;switch(args.command){case '\"'phase':if(s.phase<getCase(s.caseId).phases.length-1)startPhase(s,s.phase+1);else s.status='won';break;case 'fail':fail(s,'Developer failure injection.');break;case 'heal':s.patients.fill(100);s.code=null;break;case 'gift':for(const p of s.seats)p.gift=99;break;case 'bot':if(s.seats.length<4)s.seats.push(seat(s.seats.length,'none',0));break;case 'win':s.status='won';event(s,'won','OPERATION COMPLETE');break;}}});\ndefineDevAction('surgery-spawn',{help:'Spawn a target at a surgeon cursor.',args:{kind:{type:'string',default:'lull',enum:KINDS,description:'Target kind.'},x:{type:'number',default:0,description:'East, metres.'},z:{type:'number',default:0,description:'South, metres.'},site:{type:'integer',default:0,minimum:0,maximum:2,description:'Field index.'}},run(w,args){const s=state(w);if(\"'!s)return;s.dev=true;spawn(s,{kind:args.kind as TargetKind,at:[args.x as number,args.z as number],site:args.site as number,path:['\"'wound','incision'].includes(String(args.kind))?[[Number(args.x)-1,Number(args.z)],[Number(args.x)+1,Number(args.z)]]:undefined});}});\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/view/field/liveMesh.ts <<'EOF'\n/** @file Live public-API geometry buffers; page animation changes presentation without touching the simulation. */\nimport {boxGeometry,defineGeometry,Color} from '../../../../engine';\nexport type V3=[number,number,number];\ntype Geo=ReturnType<typeof boxGeometry>;\nconst sample=boxGeometry();\nconst Geometry=sample.constructor as new()=>Geo;\nconst Attribute=sample.getAttribute('position').constructor as new(a:Float32Array,n:number)=>ReturnType<Geo['getAttribute']>;\nconst colors=new Map<string,V3>();\nexport function rgb(hex:string):V3{let c=colors.get(hex);if(\"'!c){const v=new Color(hex);c=[v.r,v.g,v.b];colors.set(hex,c);}return c;}\nexport class LiveMesh{\n readonly positions:Float32Array;readonly normals:Float32Array;readonly colors:Float32Array;\n geometry:Geo|null=null;count=0;\n constructor(readonly id:string,readonly capacity=150000){\n  this.positions=new Float32Array(capacity*3);this.normals=new Float32Array(capacity*3);this.colors=new Float32Array(capacity*3);\n  for(let i=0;i<capacity;i++){this.positions[i*3]=(i%2?1:-1)*24;this.positions[i*3+1]=i%3===0?8:-2;this.positions[i*3+2]=(i%3?1:-1)*18;this.normals[i*3+1]=1;}\n  defineGeometry(`geometry:live-${id}`,{description:`Animated ${id} buffer owned by the surgical view.`,budget:capacity,create:()=>{const g=new Geometry();g.setAttribute('\"'position',new Attribute(this.positions,3));g.setAttribute('normal',new Attribute(this.normals,3));g.setAttribute('color',new Attribute(this.colors,3));g.computeBoundingSphere();this.geometry=g;return g;}});\n }\n clear():void{this.count=0;}\n tri(a:V3,b:V3,c:V3,color:string):void{\n  if(this.count+3>this.capacity)return;\n  const tone=rgb(color),ux=b[0]-a[0],uy=b[1]-a[1],uz=b[2]-a[2],vx=c[0]-a[0],vy=c[1]-a[1],vz=c[2]-a[2],nx=uy*vz-uz*vy,ny=uz*vx-ux*vz,nz=ux*vy-uy*vx,length=Math.hypot(nx,ny,nz)||1;\n  for(const p of [a,b,c]){const i=this.count++*3;this.positions.set(p,i);this.normals.set([nx/length,ny/length,nz/length],i);this.colors.set(tone,i);}\n }\n quad(a:V3,b:V3,c:V3,d:V3,color:string):void{this.tri(a,b,c,color);this.tri(a,c,d,color);}\n disc(x:number,y:number,z:number,rx:number,rz:number,color:string,time=0):void{\n  for(let i=0;i<48;i++){const a=i/48*Math.PI*2,b=(i+1)/48*Math.PI*2,r1=1+Math.sin(a*7+time)*.035,r2=1+Math.sin(b*7+time)*.035;this.tri([x,y,z],[x+Math.cos(b)*rx*r2,y,z+Math.sin(b)*rz*r2],[x+Math.cos(a)*rx*r1,y,z+Math.sin(a)*rz*r1],color);}\n }\n ring(x:number,y:number,z:number,r:number,width:number,color:string,fraction=1):void{\n  const count=Math.ceil(64*fraction);for(let i=0;i<count;i++){const a=i/64*Math.PI*2,b=(i+1)/64*Math.PI*2;this.quad([x+Math.cos(a)*r,y,z+Math.sin(a)*r],[x+Math.cos(b)*r,y,z+Math.sin(b)*r],[x+Math.cos(b)*(r-width),y,z+Math.sin(b)*(r-width)],[x+Math.cos(a)*(r-width),y,z+Math.sin(a)*(r-width)],color);}\n }\n ball(x:number,y:number,z:number,rx:number,ry:number,rz:number,color:string,detail=18):void{\n  const p=(a:number,b:number):V3=>[x+Math.cos(a)*Math.sin(b)*rx,y+Math.cos(b)*ry,z+Math.sin(a)*Math.sin(b)*rz];\n  for(let j=0;j<10;j++)for(let i=0;i<detail;i++){const a=i/detail*Math.PI*2,b=(i+1)/detail*Math.PI*2,c=j/10*Math.PI,d=(j+1)/10*Math.PI;this.quad(p(a,c),p(a,d),p(b,d),p(b,c),color);}\n }\n line(points:V3[],width:number,color:string):void{\n  for(let i=1;i<points.length;i++){const a=points[i-1],b=points[i],dx=b[0]-a[0],dz=b[2]-a[2],l=Math.hypot(dx,dz)||1,nx=-dz/l*width/2,nz=dx/l*width/2;this.quad([a[0]+nx,a[1],a[2]+nz],[b[0]+nx,b[1],b[2]+nz],[b[0]-nx,b[1],b[2]-nz],[a[0]-nx,a[1],a[2]-nz],color);}\n }\n commit():void{if(\"'!this.geometry)return;for(const name of ['\"'position','normal','color'])this.geometry.getAttribute(name).needsUpdate=true;this.geometry.setDrawRange(0,this.count);}\n}\nexport const meshes={sheet:new LiveMesh('sheet',180000),wet:new LiveMesh('wet',100000),thread:new LiveMesh('thread',100000),glow:new LiveMesh('glow',75000),steel:new LiveMesh('steel',45000),glove:new LiveMesh('glove',45000)};\nEOF\ncat > labs/game/view/field/sheet.ts <<'EOF'\n/** @file A breathing 3D tissue sheet with organ bulges, vascular relief, cloth folds and submerged ripples. */\nimport type {Operation} from '../../data/types';\nimport {getCase} from '../../data/cases';\nimport {meshes,type V3} from './liveMesh';\nconst hump=(x:number,z:number,cx:number,cz:number,rx:number,rz:number):number=>Math.exp(-((x-cx)*(x-cx)/(rx*rx)+(z-cz)*(z-cz)/(rz*rz))*2);\nexport function fieldHeight(x:number,z:number,s:Operation):number{\n const t=s.fieldTicks/6000,heart=getCase(s.caseId).field==='heart';\n let h=.07*Math.sin(t*1.5)+.18*hump(x,z,0,0,7,4)+.32*hump(x,z,-2,-.4,4,2.9)+.25*hump(x,z,2,.6,3,2);\n if(heart)h+=.55*hump(x,z,0,0,3,2)*(1+Math.max(0,Math.sin(t*7))* .18);\n h+=.025*Math.sin(x*4+Math.sin(z*3))*Math.cos(z*4);\n for(const target of s.targets)if(\"'!target.done&&target.kind==='\"'reverie'&&target.site===(s.seats[0]?.site??0)){const d=Math.hypot(x-target.x,z-target.z);h+=Math.exp(-d*d*3)*.24+Math.sin(d*12-t*9)*Math.exp(-d*2)*.055;}\n return h;\n}\nexport function drawSheet(s:Operation,blood='red'):void{\n const m=meshes.sheet;m.clear();const nx=160,nz=96,dx=20/nx,dz=12/nz;\n const at=(x:number,z:number):V3=>{\n  const edge=(x*x/61+z*z/15.3),cloth=edge>1;\n  const h=cloth?.1+.09*Math.sin(x*3+z*.7)*Math.cos(z*2.7)+Math.max(0,Math.abs(x)-7.8)*.07:fieldHeight(x,z,s);\n  return [x,h,z];\n };\n for(let j=0;j<nz;j++)for(let i=0;i<nx;i++){\n  const x=-10+i*dx,z=-6+j*dz,e=(x*x/61+z*z/15.3),cloth=e>1;\n  let color:string;\n  if(cloth){const n=Math.sin(x*2.4+z)*Math.cos(z*3.3);color=n>.45?'#2c6464':n<-.4?'#194647':'#245758';}\n  else{\n   const v=Math.sin(x*1.2+Math.cos(z*1.3))*.4+Math.cos(z*1.9)*.3;\n   color=e>.91?'#c38a76':v>.35?'#be827c':v<-.3?'#8b4b60':'#b57377';\n   if(getCase(s.caseId).field==='heart')color=v>.2?'#a34c60':'#bb6269';\n   const vein=Math.abs(Math.sin(x*1.9+Math.sin(z*1.7)*.7));\n   if(vein<.035&&e<.8)color='#704858';\n   for(const t of s.targets){if(t.done||t.site\"'!==s.seats[0].site)continue;\n    const d=Math.hypot(x-t.x,z-t.z);\n    if(t.kind==='\"'numb'&&d<t.radius)color='#637d93';\n    if(t.kind==='balm'&&d<t.radius){const gx=Math.floor(x*2),gz=Math.floor(z*2);if(((gx*17+gz*31+t.id)%7+7)%7<6)color='#c9cdb0';}\n    if(t.kind==='pool'&&d<t.radius*Math.sqrt(Math.max(0,t.hp)))color=blood==='teal'?'#1b6065':'#6d263d';\n   }\n  }\n  m.quad(at(x,z),at(x,z+dz),at(x+dx,z+dz),at(x+dx,z),color);\n }\n m.commit();\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
