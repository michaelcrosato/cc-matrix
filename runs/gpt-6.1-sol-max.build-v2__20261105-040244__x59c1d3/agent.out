]=this.radial.selected;this.radial=null;h[8]=0;}\n    if(press(1)){h[3]=0;this.radial=null;h[8]=0;}\n   }\n   this.previousPads[pad.index]=values;\n  }\n }\n private assist(h:Hand,s:Operation|undefined,precision:boolean,prefs:Preferences):void{\n  if(\"'!s||!prefs.assist)return;const t=s.targets.filter(t=>!t.done&&t.site===h[6]&&RESPONSE[TOOLS[h[2]]][t.kind]==='\"'effect').sort((a,b)=>distanceTo(a,h[0],h[1])-distanceTo(b,h[0],h[1]))[0];\n  if(t&&distanceTo(t,h[0],h[1])<.65){const p=t.path.length?nearest(t.path,h[0],h[1]).point:[t.x,t.z];const factor=precision?.3:.12;h[0]+=(p[0]-h[0])*factor;h[1]+=(p[1]-h[1])*factor;}\n }\n frame(frame:EngineFrame,prefs:Preferences,s?:Operation,input?:Input):Hand[]{\n  this.pollPads(frame.dt,prefs,s);if(\"'!this.playing)return this.seats;\n  const h=this.seats[0];\n  if(this.lastDevice!=='\"'gamepad'&&this.devices[0]==='keyboard'){\n   if(this.moved){const ray=screenRay(frame.camera,[this.mouse[0]/innerWidth*2-1,1-this.mouse[1]/innerHeight*2],innerWidth/innerHeight);let p=onFloor(ray,0);if(p&&s){for(let i=0;i<3;i++)p=onFloor(ray,fieldHeight(p[0],p[2],s))??p;}if(p){h[0]=p[0];h[1]=p[2];}this.moved=false;}\n   const dx=(this.keys.has('KeyD')||this.keys.has('ArrowRight')?1:0)-(this.keys.has('KeyA')||this.keys.has('ArrowLeft')?1:0),dz=(this.keys.has('KeyS')||this.keys.has('ArrowDown')?1:0)-(this.keys.has('KeyW')||this.keys.has('ArrowUp')?1:0);\n   h[0]-=dx*prefs.cursorSpeed*frame.dt;h[1]+=dz*prefs.cursorSpeed*frame.dt;\n   h[3]=this.radial?0:prefs.toggleUse?(this.toggle?1:0):this.buttons.has(0)||input?.held('use')?1:0;h[8]=this.radial?1:0;\n  }\n  for(const hand of this.seats){hand[0]=clamp(hand[0],-7.2,7.2);hand[1]=clamp(hand[1],-3.4,3.4);if(s)hand[6]=(Math.round(hand[6])+(s.caseId==='gala-night'?3:3)*10)%((s.caseId==='crosstalk'||s.caseId==='gala-night')?3:(s.caseId==='reverie'||s.caseId==='gala-shift')?2:1);}\n  return this.seats;\n }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_72","type":"agent_message","text":"All eight operations and the extra co-op case now have authored phases, and the bot can complete the main sequence. I’m adding the presentation and controls: breathing tissue, wound edges, stitches, parasites, gloved instruments, and the surrounding hospital scenes.\n"}}
{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/audio/data.ts <<'EOF'\n/** @file Original synthesized instrument signatures, monitor tones and adaptive score; no audio files. */\nimport {defineSfx,defineSong} from '../../../engine';\nconst sounds:Record<string,[number,number,number,string]>={cut:[500,90,.12,'noise'],stitch:[850,300,.1,'triangle'],drain:[180,60,.3,'noise'],laser:[1700,900,.14,'saw'],syringe:[1100,700,.06,'sine'],gel:[130,55,.18,'noise'],scanner:[850,1500,.25,'sine'],forceps:[2300,1500,.08,'triangle'],clack:[700,160,.065,'noise'],beep:[830,830,.085,'sine'],flat:[420,420,1,'sine'],alarm:[600,900,.22,'square'],good:[523,1046,.22,'sine'],no:[180,90,.13,'triangle'],shock:[90,50,.38,'noise'],rain:[900,700,2,'noise'],creak:[160,65,.7,'saw']};\nfor(const [id,[freq,to,dur,wave]] of Object.entries(sounds))defineSfx(\"'`sfx:hl-${id}`,{voices:[{wave:wave as '\"'sine',freq,to,dur,vol:wave==='noise'?.08:.15,filter:'lowpass'}],variants:id==='beep'?1:3,vary:.04,bus:id==='rain'?'ambience':'effects'});\nconst themes:Record<string,[number,string,string]>={title:[84,'D3 - - - A2 - - - Bb2 - - - C3 - - -','A4 . D5 . F5 - E5 - D5 - C5 - A4 - . .'],story:[76,'D3 - - - Bb2 - - - G2 - - - A2 - - -','F4 - . . E4 - D4 - G4 - F4 - E4 - . .'],calm:[100,'D2 - - - D3 - - - Bb2 - - - A2 - - -','D5 . A4 . F5 . E5 . D5 . F5 . E5 . A4 .'],strain:[126,'D2 - D3 - C2 - C3 - Bb1 - Bb2 - A1 - A2 -','D5 . Eb5 . A5 . F5 . D5 . C5 . A4 . C5 .'],mercy:[92,'A2 - - - F2 - - - D2 - - - E2 - - -','E5 - A5 - G5 - E5 - F5 - E5 - D5 - C5 -'],success:[110,'D3 - F3 - A3 - D4 - Bb3 - A3 - F3 - D3 -','F5 - A5 - D6 - A5 - G5 - F5 - E5 - D5 -'],failed:[60,'D2 - - - C2 - - - Bb1 - - - A1 - - -','F4 - E4 - D4 - . . C4 - Bb3 - A3 - . .'],jingle:[134,'C3 . G3 . C4 . G3 . F3 . C4 . G3 . C4 .','E5 . G5 . C6 - G5 . A5 . F5 . G5 - C5 .']};\nfor(const [name,[bpm,bass,melody]] of Object.entries(themes))defineSong(\"'`song:hl-${name}`,{bpm,tracks:[{wave:'\"'triangle',vol:.22,notes:bass},{wave:'sine',vol:.15,notes:melody},{wave:'pulse',vol:.06,intensity:.5,notes:'D4 . A4 . D5 . A4 . C5 . A4 . E5 . A4 .'},{wave:'drums',vol:.1,intensity:.7,notes:'k . h . s . h . k . h h s . h .'}]});\nEOF\ncat > labs/game/audio/voice.ts <<'EOF'\n/** @file Formant gibberish syllables rendered offline per character, then spoken with punctuation and emphasis. */\nconst profiles:Record<string,[number,number,number]>={wren:[250,900,.058],odie:[145,700,.075],chief:[94,560,.095],sabine:[175,800,.08],voss:[270,1200,.07],patient:[195,850,.08]};\nexport class Voices{\n buffers=new Map<string,AudioBuffer[]>();gain:GainNode|null=null;context:BaseAudioContext|null=null;sources:AudioBufferSourceNode[]=[];generation=0;\n async init(context:BaseAudioContext):Promise<void>{\n  if(this.context===context)return;this.context=context;this.gain=context.createGain();this.gain.gain.value=.35;this.gain.connect(context.destination);\n  for(const [who,[pitch,formant]] of Object.entries(profiles)){\n   const list:AudioBuffer[]=[];\n   for(let i=0;i<16;i++){\n    const offline=new OfflineAudioContext(1,Math.ceil(context.sampleRate*.105),context.sampleRate),osc=offline.createOscillator(),filter=offline.createBiquadFilter(),f2=offline.createBiquadFilter(),g=offline.createGain();\n    osc.type='sawtooth';osc.frequency.setValueAtTime(pitch*(.86+i*.023),0);osc.frequency.exponentialRampToValueAtTime(pitch*(.93+i*.025),.095);\n    filter.type='bandpass';filter.frequency.value=formant+(i%4)*140;filter.Q.value=2.5;f2.type='peaking';f2.frequency.value=1800+(i%3)*300;f2.Q.value=1.8;f2.gain.value=8;\n    g.gain.setValueAtTime(0,0);g.gain.linearRampToValueAtTime(.28,.008);g.gain.exponentialRampToValueAtTime(.001,.1);\n    osc.connect(filter).connect(f2).connect(g).connect(offline.destination);osc.start();osc.stop(.103);list.push(await offline.startRendering());\n   }this.buffers.set(who,list);\n  }\n }\n speak(who:string,text:string,volume:number):void{\n  const context=this.context,gain=this.gain,buffers=this.buffers.get(who)??this.buffers.get('wren');if(\"'!context||!gain||!buffers)return;\n  this.stop();gain.gain.value=volume*.55;let when=context.currentTime+.02;\n  const pace=profiles[who]?.[2]??.07;\n  for(let i=0;i<text.length;i++){\n   const char=text[i];if(/[.,!?—]/.test(char)){when+=pace*2;continue;}if(char==='\"' '){when+=pace*.5;continue;}\n   const source=context.createBufferSource();source.buffer=buffers[(char.charCodeAt(0)+i*3)%16];source.playbackRate.value=(char===char.toUpperCase()?1.1:1)*(text.endsWith('?')?1+i/text.length*.25:1);source.connect(gain);source.start(when);this.sources.push(source);when+=pace;\n  }\n }\n stop():void{for(const s of this.sources)try{s.stop();}catch{}this.sources=[];}\n}\nEOF\ncat > labs/game/audio/mix.ts <<'EOF'\n/** @file A quiet adaptive soundtrack, synthesized voices, heartbeat and audible confirmation of every tool. */\nimport {createAudio,type EngineFrame} from '../../../engine';\nimport type {Operation} from '../data/types';\nimport type {Preferences} from '../app/settings';\nimport {heartRate} from '../scenes/op/gift';\nimport {Voices} from './voice';\nimport './data';\nexport class Soundtrack{\n audio=createAudio();voices=new Voices();last=0;world:object|null=null;beat=-1;song='';analyser:AnalyserNode|null=null;voiceReady=false;\n constructor(){this.audio.volume('master',.7);this.audio.volume('music',.1);}\n theme(name:string):void{if(this.song===name)return;this.song=name;this.audio.music(\"'`song:hl-${name}`);}\n say(who:string,text:string,prefs:Preferences):void{this.audio.duck(1);this.voices.speak(who,text,prefs.voice*prefs.master);}\n frame(f:EngineFrame,p:Preferences,s?:Operation):void{\n  this.audio.volume('\"'master',p.master);this.audio.volume('music',p.music);this.audio.volume('effects',p.effects);this.audio.update(f.camera);\n  const context=this.audio.context;\n  if(context&&\"'!this.voiceReady){this.voiceReady=true;void this.voices.init(context).then(()=>{this.analyser=context.createAnalyser();this.voices.gain?.connect(this.analyser);});}\n  if(!s)return;if(this.world!==f.world){this.world=f.world;this.last=0;this.beat=-1;}\n  this.audio.intensity(Math.min(...s.patients)<25?1:s.targets.some(t=>!t.done&&['\"'lull','solace','mercy','reverie'].includes(t.kind))?.75:.2);\n  const beat=Math.floor(s.fieldTicks/6000*heartRate(s)/60);\n  if(beat\"'!==this.beat){this.beat=beat;this.audio.play(s.code?'\"'sfx:hl-flat':'sfx:hl-beep',{vol:s.targets.some(t=>\"'!t.done&&t.kind==='\"'lull')?.13:.45});}\n  const mapping:Record<string,string>={switch:'clack',rating:'good',stitch:'stitch',refusal:'no',shock:'shock',binder:'syringe',inject:'syringe',scan:'scanner',hit:'alarm',gift:'good',drama:'shock',lost:'flat'};\n  for(const e of s.events){if(e.n<=this.last)continue;this.last=e.n;if(mapping[e.type])this.audio.play(\"'`sfx:hl-${mapping[e.type]}`);}\n  const seat=s.seats[0];if(seat.held&&s.tick%15===0)this.audio.play(`sfx:hl-${['\"'cut','forceps','stitch','drain','laser','syringe','gel','scanner'][seat.tool]}\"'`,{vol:.2});\n }\n silence():void{this.audio.mute(true);this.voices.stop();}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
