{"type":"item.started","item":{"id":"item_134","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/app/attract.ts <<'EOF'\n/** @file A looping real-bot kiosk shift after ten idle seconds, with input-consuming wakeup and no progress saves. */\nimport type {Director} from './director';\nconst clips=[['op:first-cut',0,18],['op:crosstalk',0,22],['story:1:after',0,10],['op:struck-off',1,25],['op:reverie',2,22],['op:gala-night',0,22],['op:mercy',1,22],['op:mercy',9,14]] as const;\nexport class Attractor{\n active=false;idle=0;clock=0;index=-1;d:Director;set:(key:string,value:unknown)=>void;changed:(active:boolean)=>void;\n constructor(d:Director,set:(key:string,value:unknown)=>void,changed:(active:boolean)=>void){this.d=d;this.set=set;this.changed=changed;}\n activity():boolean{const woke=this.active;this.idle=0;if(woke)this.exit();return woke;}\n exit():void{if(\"'!this.active)return;this.active=false;this.changed(false);this.clock=0;this.index=-1;document.querySelectorAll('\"'.demo-banner,.demo-prompt').forEach(e=>e.remove());this.set('game.autoplay',false);this.set('game.attract',false);this.d.go('title','title');}\n frame(dt:number,rebinding=false):void{\n  this.idle+=dt;\n  if(\"'!this.active){if(this.idle<10||rebinding||!['\"'title','board','about','scrub','postcards','settings','handbook'].includes(this.d.screen))return;this.active=true;this.changed(true);this.clock=0;this.set('game.autoplay',true);this.set('game.attract',true);}\n  this.clock+=dt;const total=clips.reduce((n,c)=>n+c[2],6),clock=this.clock%total;let elapsed=6,index=-1;\n  for(let i=0;i<clips.length;i++){if(clock>=elapsed&&clock<elapsed+clips[i][2])index=i;elapsed+=clips[i][2];}\n  if(index\"'!==this.index){this.index=index;if(index<0)this.d.go('\"'title','title');else{const [run,phase]=clips[index];if(run.startsWith('story')){this.d.caseIndex=1;this.d.part='after';this.d.beat=0;this.d.go('story',run);}else{this.d.caseIndex=run==='op:first-cut'?0:run==='op:crosstalk'?2:run==='op:struck-off'?4:run==='op:reverie'?5:run==='op:gala-night'?6:7;this.d.go('op',run,phase);}}}\n  if(\"'!document.querySelector('\"'.demo-banner')){const banner=document.createElement('div');banner.className='demo-banner';banner.textContent='DEMO / THE NIGHT SHIFT';const prompt=document.createElement('div');prompt.className='demo-prompt';prompt.textContent='Any button to take the shift';document.getElementById('app')\"'!.append(banner,prompt);}\n }\n}\nEOF\nnode --input-type=module <<'\"'JS'\nimport fs from 'node:fs';\nlet s=fs.readFileSync('labs/game/main.ts','utf8');s=s.replace(\\\"import { Director, freshProgress }\\\", \\\"import { Attractor } from './app/attract';\\\\nimport { Director, freshProgress }\\\");s=s.replace('  idle = 0,\\\\n  demoClock = 0,\\\\n  demoIndex = -1,\\\\n','');s=s.replace('const ui = new GameUI(context);',\\\"const ui = new GameUI(context);\\\\nconst attractor=new Attractor(d,set,active=>{attract=active;});\\\");let a=s.index('function exitDemo()'),b=s.index('hands.onMenu',a);s=s.slice(0,a)+\\\"hands.onActivity=()=>attractor.activity();\\\\n\\\"+s.slice(b);a=s.index('const clips =');b=s.index('function touchGate()',a);s=s.slice(0,a)+s.slice(b);a=s.index('  if (\"'!session) {'\"\\\\n    idle +=');b=s.index(\\\"  if (operation && activeRun.startsWith('op:'))\\\",a);s=s.slice(0,a)+\\\"  if(\"'!session)attractor.frame(f.dt,ui.rebinding);'\"\\\\n\\\"+s.slice(b);s=s.replace('return idle;','return attractor.idle;').replace('    exitDemo,','    exitDemo:()=>attractor.exit(),');fs.writeFileSync('labs/game/main.ts',s);\nJS\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/view/field/targets.ts');s=p.read_text().replace(\\\"const red = blood === 'teal' ? '#134c52' : '#662238';\\\", \\\"const red = blood === 'off'?'#354c53':blood === 'teal' ? '#134c52' : '#662238';\\\").replace(\\\"if (blood \"'!== '\"'off') {\\\", \\\"if (t.hp>0) {\\\");p.write_text(s)\np=Path('labs/game/view/field/sheet.ts');s=p.read_text().replace(\\\"blood === 'teal' ? '#1