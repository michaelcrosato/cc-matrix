{"type":"item.completed","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -lc \"sed -n '250,327p' engine/anim/check.ts; rg -n -A8 'step\\\\(' engine/anim/character.ts | head -26; sed -n '45,94p' engine/anim/check.ts; sed -n '1,110p' tools/checkAll.ts; cat eslint.config.js | head -90\"","aggregated_output":"      if (p.y < floor - tolerance) {\n        report(\n          'floor',\n          name,\n          frame,\n          floor - p.y,\n          () => `${name} is ${m(floor - p.y)} m below the floor (y ${m(p.y)}); raise the root or bend the leg`,\n        );\n      }\n    }\n    const scale = Math.max(pose.rootScale.x, pose.rootScale.y, pose.rootScale.z);\n    for (const [i, name] of SOCKETS.entries()) {\n      const distance = socketPosition(skeleton, world, name).distanceTo(pose.rootPos);\n      if (distance > reach[i] * scale + tolerance) {\n        report(\n          'reach',\n          name,\n          frame,\n          distance - reach[i] * scale,\n          () => `${name} is ${m(distance)} m from the root, past its chain's reach of ${m(reach[i] * scale)} m`,\n        );\n      }\n    }\n  });\n  const problems = [...found.values()].map(({ last: _last, ...problem }) =>\n    problem.frames > 1\n      ? { ...problem, message: `${problem.message} (${problem.frames} frames${worstOf(problem.worst)})` }\n      : problem,\n  );\n  return { ok: problems.length === 0, frames: spec.poses.length, problems };\n}\n\n/** What `animCheckBody` checks: the matrix, `animCheck`'s spec, the hash and the rate. */\nexport interface BodyCheckOptions extends StateMatrixOptions, Omit<AnimCheckSpec, 'poses' | 'skeleton'> {\n  /** Metres a joint may drift between 1/60 s and 1/120 s steps; `STATE_MATRIX.rate` by default, false to skip. */\n  rate?: number | false;\n  /** Whether to run the matrix again for the same hashes; true by default. */\n  hash?: boolean;\n}\n\n/** What `animCheckBody` found, with the runs it checked. */\nexport interface BodyCheckReport extends AnimCheckReport {\n  runs: MatrixRun[];\n}\n\n/**\n * Checks a whole body (my-3d2dge's `checkRig`): every pose of the state matrix (`animCheck`), the same hashes when\n * the matrix runs again (`hash`), and the joints within `rate` metres of a run at half the step (`rate`). Each\n * problem names its state and facing.\n */\nexport function animCheckBody(make: (dt: number) => Animator, options: BodyCheckOptions = {}): BodyCheckReport {\n  const runs = stateMatrix(make, options);\n  const problems: AnimProblem[] = [];\n  const add = (run: MatrixRun, problem: Omit<AnimProblem, 'state'>) =>\n    problems.push({ ...problem, state: run.state, message: `${run.state} facing ${run.facing}: ${problem.message}` });\n  const { rigid, floor, tolerance } = options;\n  for (const run of runs) {\n    for (const problem of animCheck({ poses: run.poses, skeleton: run.skeleton, rigid, floor, tolerance }).problems) {\n      add(run, problem);\n    }\n  }\n  if (options.hash !== false) {\n    stateMatrix(make, options).forEach((again, i) => {\n      const frame = again.poses.findIndex((pose, f) => !pose.equals(runs[i].poses[f]));\n      if (frame < 0 && hashRun(again) === hashRun(runs[i])) return;\n      const message = `frame ${frame}: running it again gave another pose; look for module state, Math.random or a clock`;\n      add(runs[i], { check: 'hash', point: 'pose', frame, frames: 1, worst: 1, message });\n    });\n  }\n  const limit = options.rate ?? STATE_MATRIX.rate;\n  if (limit !== false) {\n    stateMatrix(make, { ...options, dt: (options.dt ?? SIM_DT) / 2 }).forEach((fine, i) => {\n      const { worst, frame, point } = rateDrift(runPoints(runs[i]), runPoints(fine));\n      const joint = RUN_POINTS[point];\n      if (worst <= limit) return;\n      const message = `frame ${frame}: ${joint} is ${m(worst)} m from where half steps put it (over ${limit} m); scale each step's change by dt`;\n      add(runs[i], { check: 'rate', point: joint, frame, frames: 1, worst, message });\n    });\n13: * - `step(states)`, the sim's, for every character, every tick: it checks the body states (states.ts), eases the\n14- *   body's weights and clocks, and lists the tick's `events` (`footstep` as a foot lands). Cheap, and part of the\n15- *   gameplay hash: `save()` writes what it changed as plain data (`ANIMATOR_FIELDS`), `load()` reads it back.\n16- * - `pose(options)`, the presentation's, for characters that are drawn: the body's solve, the layers, FK, the trail.\n17- *   It re-solves once per tick and between ticks moves the last pose with the body. `lod` (an index into weights.ts\n18- *   `LOD`) is a view-only hook: fewer layers, fewer re-solves.\n19- * - `preciseHits`: the sim poses the character itself every tick (engine/sim/actors.ts), at full detail with no\n20- *   layers, so its trail (the weapon sweeps) is sim data, saved with the rest. It never depends on visibility.\n21- *\n--\n34: * hero.step({ pose: 'cheer', trail: 'blade' }).events; // [] standing; while walking, footsteps: { type: 'footstep', side: 'L', … }\n35- * hero.pose().trail.length; // 1: the sword's first sample\n36- * @see engine/anim/character.test.ts\n37- */\n38-import { codeError, defineCodes, log as engineLog, type Log } from '../core/log';\n39-import { MathUtils, Quaternion, Vector3 } from '../core/math';\n40-import type { Rng } from '../core/rng';\n41-import { copyValue, defineSchema } from '../core/schema';\n42-import { fru, type LimbSide } from './authoring';\n--\n176:  step(states: AnimatorInput = {}): this {\n177-    const input = checkBodyStates(states, this.#log, this.#ignored);\n178-    const from = this.body.state.phase;\n179:    this.body.step(input);\n180-    this.trailing = input.trail;\n181-    this.events.length = 0;\n  type JointName,\n  type Skeleton,\n  type SocketName,\n} from './skeleton';\nimport {\n  hashRun,\n  rateDrift,\n  RUN_POINTS,\n  runPoints,\n  STATE_MATRIX,\n  stateMatrix,\n  type MatrixRun,\n  type StateMatrixOptions,\n} from './stateMatrix';\n\n/** The codes this module raises, with their fixes. */\nexport const CHECK_CODES = defineCodes('anim', {\n  ANIM_UNKNOWN_POINT: {\n    template: 'the rigid pair names {name}, which is not a joint, a socket or the root{suggestion}',\n    fix: 'name joints (JOINTS), sockets (SOCKETS) or \"root\" in rigid pairs',\n    doc: 'Raised by `animCheck` (engine/anim/check.ts) for a rigid pair naming a point the skeleton lacks.',\n  },\n});\n\n/** A point a rigid pair can name: a joint, a socket, or the root. */\nexport type PointName = JointName | SocketName | 'root';\n\n/** Two points whose distance must not change: from the first frame, or the distance given third (metres). */\nexport type RigidPair = readonly [PointName, PointName] | readonly [PointName, PointName, number];\n\n/** What `animCheck` checks. */\nexport interface AnimCheckSpec {\n  /** The poses to check: a clip's samples, a state matrix, one pose. */\n  poses: readonly Pose[];\n  /** The skeleton they are for: a skeleton or a build id; `build:chibi`'s by default. */\n  skeleton?: Skeleton | string;\n  /** Pairs of points held at a fixed distance, such as both hands on one weapon. */\n  rigid?: readonly RigidPair[];\n  /** The floor's height under the feet, in the space the poses' roots are in; 0 by default. */\n  floor?: number;\n  /** How far a length or a height may be off, in metres; 0.001 by default. */\n  tolerance?: number;\n}\n\n/**\n * One kind of problem: which check found it. `hash` and `rate` come from `animCheckBody`: a run that gave another\n * hash the second time, and one whose joints drift between 1/60 s and 1/120 s steps.\n */\nexport type AnimCheckName = 'finite' | 'length' | 'rigid' | 'floor' | 'reach' | 'hash' | 'rate';\n\n/**\n * @file `npm run check` (T0, PLAN.md §8.1–§8.2): runs `tsc`, ESLint, Prettier and `node x check` at the same time and\n * fails if any fails. Run one after another they took about 9 s of T0's 10 s budget at G0, `tsc` alone about 4 s; in\n * parallel T0 takes as long as the slowest. Node runs this file directly (type stripping, as the hooks do; ADR-0014\n * amendment 4), so it needs nothing installed beyond the tools it starts.\n *\n * `tsc` is `npm run typecheck`'s command: `tsc -b` over the projects of tsconfig.check.json, which together hold\n * tsconfig.json's files. It reuses what the last run checked (node_modules/.cache/tsc/), so it costs what a change\n * reaches: measured 0.2 s unchanged, 1.5–3 s after a typical edit, about 6 s when an export of a module every file\n * reaches changes, against 6 s every time for `tsc --noEmit` (ADR-0014 amendment 7).\n *\n * Invariants: every tool runs to the end, so one run names every failure; each tool's output is printed whole, in\n * the fixed order below, after all have finished (never interleaved); the exit code is 0 only when all four pass,\n * else 1. Caches live under node_modules/.cache/, which `x ci --local` keeps across `npm ci`; a new checkout or\n * worktree has none, so its first run fills them (measured after G5: 13.9 s cold, Prettier 13.7 s of it; 5.8 s warm).\n *\n * Usage: `npm run check` (package.json: `\"check\": \"node tools/checkAll.ts\"`). Importing the module runs nothing.\n *\n * @see package.json, docs/TESTING.md\n */\nimport { spawn } from 'node:child_process';\nimport { mkdirSync } from 'node:fs';\n\n/** One T0 tool: its name and its command line, run from the repository root. */\nexport interface CheckTool {\n  name: string;\n  command: string;\n}\n\n/** The T0 tools, in the order their output is printed; `tsc` runs package.json's `typecheck` command. */\nexport const CHECK_TOOLS: CheckTool[] = [\n  { name: 'tsc', command: 'npx tsc -b tsconfig.check.json' },\n  { name: 'eslint', command: 'npx eslint --cache --cache-location node_modules/.cache/eslint/ .' },\n  { name: 'prettier', command: 'npx prettier --check --cache .' },\n  { name: 'x check', command: 'node x check' },\n];\n\n/** The outcome of one tool: its exit code, combined output and time taken. */\ninterface ToolResult {\n  tool: CheckTool;\n  code: number;\n  output: string;\n  ms: number;\n}\n\n/** Runs one tool through the shell, collecting stdout and stderr together. */\nfunction run(tool: CheckTool): Promise<ToolResult> {\n  const started = performance.now();\n  return new Promise((resolve) => {\n    const child = spawn(tool.command, { shell: true, stdio: ['ignore', 'pipe', 'pipe'] });\n    let output = '';\n    child.stdout.on('data', (chunk: Buffer) => (output += chunk));\n    child.stderr.on('data', (chunk: Buffer) => (output += chunk));\n    child.on('close', (code) => resolve({ tool, code: code ?? 1, output, ms: performance.now() - started }));\n  });\n}\n\n/**\n * The cache directories ESLint and Prettier create on a cold run. They are made first, because `x check`'s docs\n * plugin, running at the same time, checks that the paths the docs cite exist.\n */\nexport const CACHE_DIRS = ['node_modules/.cache/eslint', 'node_modules/.cache/prettier'];\n\n/** Runs every tool in parallel, prints their output in order, and returns the exit code (0 only if all pass). */\nexport async function checkAll(tools: CheckTool[] = CHECK_TOOLS): Promise<number> {\n  for (const dir of CACHE_DIRS) mkdirSync(dir, { recursive: true });\n  const started = performance.now();\n  const results = await Promise.all(tools.map(run));\n  for (const { tool, code, output, ms } of results) {\n    const text = output.trimEnd();\n    console.log(`${code === 0 ? 'ok  ' : 'FAIL'} ${tool.name} (${(ms / 1000).toFixed(1)} s)${text ? `\\n${text}` : ''}`);\n  }\n  const failed = results.filter((result) => result.code !== 0).map((result) => result.tool.name);\n  const seconds = ((performance.now() - started) / 1000).toFixed(1);\n  console.log(failed.length ? `check: FAIL (${failed.join(', ')})` : `check: ok in ${seconds} s`);\n  return failed.length ? 1 : 0;\n}\n\nif (import.meta.main) process.exitCode = await checkAll();\n/**\n * @file ESLint's settings for T0 (PLAN.md §6.10; `npm run lint`, inside `npm run check`): typescript-eslint's\n * recommended rules without type information (so T0 stays fast), the file-comment and size rules, then the doctrine's\n * rule families from tools/eslint/, one block per family, each message naming the fix.\n *\n * Families, in order: the layer rules (layers.ts), the public-API rule (publicApi.ts), the reproducibility bans for\n * sim-side code (simSide.ts), the banned three.js APIs (banned.ts) and the local rule \"ask the entry, never the id\"\n * (askTheEntry.ts). Each family's rule ids carry its name (`layer/no-restricted-imports`, `sim/no-restricted-globals`,\n * `banned/no-restricted-syntax`, `local/ask-the-entry`); tools/eslint/family.ts says why.\n *\n * Invariants: rules written ahead of the code they guard are switched in `SWITCHES` and nowhere else. The cache lives\n * in node_modules/.cache/eslint/ (package.json's scripts). Tests lint fixtures with `configure(…)` from a temporary\n * directory (tools/eslint/testing.ts).\n *\n * @example\n * // npm run lint  → eslint --cache --cache-location node_modules/.cache/eslint/ .\n * @see tools/eslint/index.ts\n */\nimport jsdoc from 'eslint-plugin-jsdoc';\nimport globals from 'globals';\nimport { tsImport } from 'tsx/esm/api';\nimport tseslint from 'typescript-eslint';\n\n/** The families are TypeScript under tools/eslint/; tsx loads them, as x.js loads the x commands. */\nconst families = await tsImport('./tools/eslint/index.ts', import.meta.url);\n\n/** Rules written ahead of the code they guard. The WP named flips its switch to true, here and only here. */\nexport const SWITCHES = {\n  /** Game code imports only engine/index.ts and engine/sim-api.ts (tools/eslint/publicApi.ts): on since WP 1.6. */\n  publicApi: true,\n  /** \"Ask the entry, never the id\" (tools/eslint/askTheEntry.ts): on since WP 1.2, with the registry. */\n  askTheEntry: true,\n};\n\n/** Code under these directories opens with a `@file` comment and stays under 400 lines (hard cap 600). */\nconst AGENT_READABLE = [\n  'engine/**/*.{ts,js,mjs}',\n  'tools/**/*.{ts,js,mjs}',\n  'labs/**/*.{ts,js,mjs}',\n  'tests/**/*.{ts,js,mjs}',\n  '.claude/hooks/**/*.ts',\n];\n\n/** Builds the whole config; `switches` defaults to `SWITCHES` (tests turn every switch on). */\nexport function configure(switches = SWITCHES) {\n  return [\n    {\n      name: 'ignores',\n      ignores: ['out/**', 'dist/**', '.cache/**', 'test-results/**', 'lean/**', '.claude/worktrees/**'],\n    },\n    ...tseslint.configs.recommended,\n    {\n      name: 'typescript: unused names',\n      rules: {\n        // The usual exceptions: a leading underscore marks a name unused on purpose; `{ dropped, ...rest }` omits a key.\n        '@typescript-eslint/no-unused-vars': [\n          'error',\n          {\n            argsIgnorePattern: '^_',\n            varsIgnorePattern: '^_',\n            caughtErrorsIgnorePattern: '^_',\n            ignoreRestSiblings: true,\n          },\n        ],\n      },\n    },\n    { name: 'globals', languageOptions: { globals: { ...globals.browser, ...globals.node } } },\n    {\n      name: 'agent-readable: file comments and size (PLAN.md §6.8)',\n      files: AGENT_READABLE,\n      plugins: { jsdoc, 'hard-cap': families.family('hard-cap', 'max-lines') },\n      rules: {\n        'jsdoc/require-file-overview': 'error',\n        'max-lines': ['warn', { max: 400 }],\n        'hard-cap/max-lines': ['error', { max: 600 }],\n      },\n    },\n    {\n      name: 'no enums (erasableSyntaxOnly)',\n      files: ['**/*.ts'],\n      rules: {\n        'no-restricted-syntax': [\n          'error',\n          {\n            selector: 'TSEnumDeclaration',\n            message: 'no enums (erasableSyntaxOnly): use an `as const` object and a union of its values (ADR-0003)',\n          },\n        ],\n      },\n    },\n","exit_code":0,"status":"completed"}}
