{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '45,100p' engine/core/schema.ts && sed -n '1,170p' engine/sim/scene.ts && sed -n '70,125p' engine/app/drawing.ts && cat labs/box/looks/torch-lit.ts && cat labs/box/looks/daylight.ts && rg --files labs/box | rg 'bod|hero|song|sound|clip|library'\"","aggregated_output":"});\n\n/** The value types: JSON's, plus `integer`, `function` (a hook) and `any`. */\nexport type FieldType = 'number' | 'integer' | 'boolean' | 'string' | 'array' | 'object' | 'function' | 'any';\n\n/** Every `FieldType`, in documentation order. */\nexport const FIELD_TYPES: readonly FieldType[] = [\n  'number',\n  'integer',\n  'boolean',\n  'string',\n  'array',\n  'object',\n  'function',\n  'any',\n];\n\n/** When a change takes effect: at once, for what spawns next, or when the scene next starts. */\nexport type When = 'now' | 'spawn' | 'scene';\n\n/** One field: what its values are, documented. Keys follow JSON Schema where it has one (see the file comment). */\nexport interface Field {\n  type: FieldType;\n  /** What the field means, one or more plain sentences. Required except inside `items`. */\n  description?: string;\n  /** The value an absent field takes; a hook's default is a function. */\n  default?: unknown;\n  /** True when a spec must give the field. */\n  required?: boolean;\n  /** The smallest number allowed. */\n  minimum?: number;\n  /** The largest number allowed. */\n  maximum?: number;\n  /** The only values allowed. */\n  enum?: readonly (string | number | boolean)[];\n  /** The unit, in SI: `m`, `s`, `m/s`, `rad`, `kg`… */\n  unit?: string;\n  /** For an array: the field every item matches. */\n  items?: Field;\n  /** For an object: its own fields (unknown keys are errors). Without it, any plain object. */\n  properties?: Schema;\n  /** When a change takes effect (settings); `now` when absent. */\n  when?: When;\n  /** True for a setting that changes only how the game looks or performs (kept out of the hash and replays). */\n  view?: boolean;\n}\n\n/** A schema: field name → field. */\nexport type Schema = Readonly<Record<string, Field>>;\n\n/** One thing wrong with a spec or a schema: where (`roughness`, `layers[2].color`) and a plain sentence. */\nexport interface Problem {\n  path: string;\n  message: string;\n}\n\n/**\n * @file Scenes, sim-side (PLAN.md §6.9, §9.0, WP 1.5; doctrines: Reproducible, Agent-operable):\n * `defineScene(id, { level?, settings, setup, step })` registers a scene as an entry of the registry kind `scene`;\n * `startScene` makes its world (a settings store with the scene's settings over the defaults and the caller's over\n * those, a world seeded from the seed, the scene's `step` as the system `scene`, then its `setup`). A session\n * (engine/sim/session.ts `createSession`) starts one that records its inputs. The kernel fixture, the box's scenes and\n * `createHeadless` (WP 1.6) all start scenes here, so no scene imports `app/`; engine/sim/replay.ts plays them.\n *\n * A scene is game code: `setup(w)` spawns, adds systems and listeners (inside `w.run`, so under the fdlibm swap);\n * `step(w, intents)` runs every sim step as the system `scene`, first in the phase `intents`, ahead of the systems\n * setup adds there; `actions` are its dev actions, `(w, args) => void` by name (WP 5.6 adds the engine's own).\n * `level` names the level it loads (WP 2.2 compiles it), `terrain` its ground (WP 10.5, engine/world/terrain.ts) and\n * `site` the levels standing on a terrain (WP 13.15, engine/world/site.ts): the view draws them; its setup adds their\n * bodies. `physics: true` gives it a physics world (physicsOf, WP 3.1).\n * `sounds(record, w)` says which sound a traced sim event plays, `{ sfx, vol?, variant? }`, a list of them (a shot and\n * where it strikes, WP 13.22) or null, for `x audio --replay` (WP 9.4): by default the event payload's own\n * (`payloadSound`); a game that maps its events to sounds sets its map here, so Node hears what its pages play (after\n * G9, ADR-0013 amendment 3).\n * Seeds are whole numbers from 0 (`checkSeed`, `SIM_BAD_SEED`).\n *\n * Invariants: a scene's `settings` are checked against the settings schema when it is defined (`CORE_BAD_SPEC`\n * naming each problem), so declare its settings before it; they apply for the run's lifetime, as an override layer\n * (engine/core/settings.ts), and the caller's settings (`--set`, a replay's `settings`) go on top. Each start makes\n * a new settings store and world, so runs share nothing but the registry. A missing scene id is `CORE_NO_ENTRY`.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const reg = createRegistry();\n * let made = 0;\n * defineScene('demo', { description: 'Counts its steps.', setup: (w) => w.spawn(), step: () => made++ }, reg);\n * const { world } = startScene('demo', { seed: 3, registry: reg });\n * world.step({});\n * [world.count, made]; // [1, 1]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap, TraceRecord } from '../core/events';\nimport { codeError, defineCodes, type Log } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { isPlainObject, show, type Schema } from '../core/schema';\nimport { createSettings, type Settings } from '../core/settings';\nimport type { Intents } from '../input/intents';\nimport { attachPhysics, scenePhysics } from '../physics/binding';\nimport type { AnyComponents, PhysicsHook } from './state';\nimport { createWorld, type SystemProbe, type World } from './world';\n\n/** The codes this module raises, with their fixes. */\nexport const SCENE_CODES = defineCodes('sim', {\n  SIM_BAD_SEED: {\n    template: '{where} got the seed {value}, which a replay cannot hold',\n    fix: 'pass a whole number, 0 or more (x sim --seed 3, __engine.seed(3)): record() writes the seed into the replay',\n  },\n});\n\n/** Returns `seed` (1 when absent; -0 as 0); throws `SIM_BAD_SEED` naming `where` unless it is a whole number from 0. */\nexport function checkSeed(seed: unknown, where: string): number {\n  if (seed === undefined) return 1;\n  if (Number.isInteger(seed) && (seed as number) >= 0) return (seed as number) + 0; // -0 + 0 is 0\n  throw codeError('SIM_BAD_SEED', { where, value: show(seed) });\n}\n\n/** A dev action of a scene: runs between steps inside `w.run`, with plain-data `args`; recorded in replays. */\nexport type SceneAction<W> = (w: W, args: unknown) => void;\n\n/** A sound a sim event plays: an `sfx` entry, its gain (1 by default) and its variant (the effect's next by default). */\nexport interface SceneSound {\n  readonly sfx: string;\n  readonly vol?: number;\n  readonly variant?: number;\n}\n\n/** The sound a traced event names in its payload, `{ sfx, vol?, variant? }`, or null: a scene's default `sounds`. */\nexport function payloadSound(record: TraceRecord): SceneSound | null {\n  const payload = record.payload;\n  if (!isPlainObject(payload) || payload.sfx === undefined) return null;\n  return { sfx: payload.sfx, vol: payload.vol, variant: payload.variant } as SceneSound;\n}\n\n/** How a scene is written: `defineScene(id, spec)`. */\nexport interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  /** What the scene shows or tests, in plain sentences. */\n  description?: string;\n  /** The level it loads (`level:<name>`), when it has one (WP 2.2). */\n  level?: string;\n  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\n  terrain?: string;\n  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\n  site?: string;\n  /** Whether it has a physics world (WP 3.1): `physicsOf(w)` reaches it, the system `physics` steps it. */\n  physics?: boolean;\n  /** Setting values for its lifetime, path → value (schema-checked). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Runs once when it starts: spawns, systems, listeners. */\n  setup: (w: World<C, E>) => void;\n  /** Runs every step, first in the phase `intents`: reads the step's intents and components, writes components. */\n  step?: (w: World<C, E>, intents: Intents) => void;\n  /** Its dev actions, by name. */\n  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\n  /** The sounds each traced sim event plays, read as the event is delivered (`x audio --replay`); `payloadSound`. */\n  sounds?: (record: TraceRecord, w: World<C, E>) => SceneSound | readonly SceneSound[] | null;\n}\n\n/** A defined scene: its spec with defaults filled, plus `id` and `kind`. */\nexport type Scene<C extends object = AnyComponents, E extends EventMap = EventMap> = Readonly<\n  Required<Omit<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>> & Pick<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>\n> & { readonly id: string; readonly kind: 'scene' };\n\n/** The fields of a `scene` entry. */\nconst SCENE_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the scene shows or tests, in plain sentences.' },\n  level: { type: 'string', description: 'The level it loads (level:<name>, compiled by WP 2.2), when it has one.' },\n  terrain: { type: 'string', description: 'Its terrain (terrain:<name>, WP 10.5), when it has one.' },\n  site: { type: 'string', description: 'Its site (site:<name>: levels on a terrain, WP 13.15), when it has one.' },\n  physics: { type: 'boolean', default: false, description: 'Whether it has a physics world: physicsOf(w) reaches it.' },\n  settings: {\n    type: 'object',\n    default: {},\n    description: \"Setting values for the scene's lifetime, path → value, checked against the settings schema.\",\n  },\n  setup: {\n    type: 'function',\n    required: true,\n    description: 'Runs once when the scene starts, inside w.run: spawns, systems, listeners. (w) => void.',\n  },\n  step: {\n    type: 'function',\n    default: () => {},\n    description: \"Runs every sim step as the system 'scene', first in the phase intents. (w, intents) => void.\",\n  },\n  actions: {\n    type: 'object',\n    default: {},\n    description: 'Dev actions by name, (w, args) => void: run between steps by a session and recorded in replays.',\n  },\n  sounds: {\n    type: 'function',\n    default: payloadSound,\n    description:\n      \"The sounds each traced sim event plays, for x audio --replay: (record, w) => { sfx, vol?, variant? }, a list of them, or null; by default the payload's own sfx.\",\n  },\n} as const satisfies Schema;\n\n/** The problems of a scene entry beyond its fields: settings the schema refuses, actions that are not functions. */\nfunction sceneProblems(entry: Entry, registry: Registry): string[] {\n  const problems: string[] = [];\n  const actions = entry.actions as Record<string, unknown>;\n  for (const [name, action] of Object.entries(actions)) {\n    if (typeof action !== 'function') problems.push(`actions.${name} is not a function (w, args) => void`);\n  }\n  try {\n    createSettings({ registry }).override(entry.settings as Record<string, unknown>, `scene ${entry.id}`);\n  } catch (error) {\n    problems.push(`settings: ${error instanceof Error ? error.message : String(error)}`);\n  }\n  return problems;\n}\n\n/** Declares the kind `scene` on `registry` unless it has it. */\nfunction sceneKind(registry: Registry): void {\n  if (registry.kinds().includes('scene')) return;\n  registry.defineKind('scene', {\n    description:\n      'Scenes: a level, settings, a setup and a step, sim-side, so x sim, x replay and createHeadless run them in Node.',\n    fields: SCENE_FIELDS,\n    defineWith: \"defineScene('<id>', { setup(w) { … }, step(w, intents) { … } })\",\n    check: (entry) => sceneProblems(entry, registry),\n  });\n}\nsceneKind(sharedRegistry);\n\n/**\n  /** The performance governor (engine/dev/governor.ts): `auto`'s tier as the frame rate asks. */\n  governor: Governor | null;\n  /** The page's own camera input, laid over the devices' each drawn frame (`EngineOptions.cameraInput`). */\n  cameraInput?: () => CameraInput | undefined;\n  /** Whether the first frame is drawn. */\n  ready: boolean;\n}\n\n/** The read side of the run's world a page gets each frame: its step, rate, entities and the trace of its events. */\nexport type FrameWorld = Pick<World, 'tick' | 'hz' | 'get' | 'query'> & { readonly events: Pick<WorldEvents, 'trace'> };\n\n/**\n * What `onFrame` gets once per drawn frame: the run to read, never to change (presentation only: nothing reaches the\n * hash), the camera the frame was drawn from, and the emitters to run.\n */\nexport interface EngineFrame {\n  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n  readonly world: FrameWorld;\n  /** The running scene: its id, its level and whether it has physics. */\n  readonly scene: Scene;\n  /** The camera's pose this frame: where a listener goes. */\n  readonly camera: CameraPose;\n  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n  readonly queries: QueryView | null;\n  /** Real seconds since the last frame. */\n  readonly dt: number;\n  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n  setting(key: string): unknown;\n  /**\n   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n   */\n  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n}\n\n/** What `createPageDrawing` draws with besides the parts. */\nexport interface PageDrawingOptions {\n  /** The page's chrome: its touch class and top panel. */\n  chrome: Chrome;\n  /** The current run's settings (`quality`). */\n  settings: Settings;\n  /** The page's own presentation, after each drawn frame. */\n  onFrame?: (frame: EngineFrame) => void;\n}\n\n/** The page's drawing (see the file comment). */\nexport interface PageDrawing {\n  /** The rendering members' drawing. */\n  readonly drawing: Drawing;\n  /** Draws the view at `alpha`, `dt` real seconds after the last frame. */\n  frame(alpha: number, dt: number): FrameReport;\n  /** Draws until a frame is drawn and done on the GPU; throws `APP_NO_FRAME` after `DRAWING.tries`. */\n  settle(alpha: number, dt: number): Promise<FrameReport>;\n  /** Warms up through each camera `warmedCameras` names that is not warm under the shader key now. */\n  warmCameras(): Promise<void>;\n/**\n * @file The look `look:torch-lit`: the torch-lit hall, the prototype's stress world (PLAN.md WP 7.8): dark but for the\n * torches on the braziers, each flickering on its own, the nearest casting shadows, and fog from 12 m past the hero. It\n * is the sky `sky:hall` over the scene's own style with no filter: the light pool lights all the hall's 30 torch\n * spots on a renderer with tiled lighting (engine/gfx/enhanced/lighting.ts), else the 12 nearest the hero\n * (engine/gfx/lights.ts), the light following him round the hall; the other box looks are this one with a style or a\n * filter preset (labs/box/README.md lists them).\n *\n * Invariants: data only, the kind's fields (`node x describe look`): the sky `sky:hall` (engine/gfx/sky.ts), which a\n * page that starts the engine shows (engine/app/look.ts), the scene's own style, and every filter it leaves out off;\n * levels 0 (off) or 8 and more, so dull colours keep their hue. A page draws it when its setting `post.look` names it;\n * switching to it from a look with the scene's own lights warms up first (the lights change the shader key), then\n * builds nothing.\n *\n * @example\n * look.id; // 'look:torch-lit'\n * look.sky; // 'sky:hall'\n * @see labs/box/looks/torch-lit.test.ts\n * @see tests/e2e/box-look.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:torch-lit`: the torch-lit hall: the sky `sky:hall` over the scene's own style, no filter. */\nexport const look = defineLook('look:torch-lit', {\n  description:\n    'The torch-lit hall: dark but for the flickering torches near the hero, the nearest casting shadows; fog past him.',\n  sky: 'sky:hall',\n});\n/**\n * @file The look `look:daylight`: the box under a plain day (PLAN.md WP 11.5): the sky `sky:daylight` over the scene's\n * own style with no filter, its sun casting shadows across the scene. On a renderer with cascaded shadows\n * (`feature:cascadedShadows`, engine/gfx/enhanced/csm.ts) the sun casts through three cascades of the view, so the\n * crowd arenas' shadows stay sharp near the camera; tests/e2e/enhanced.spec.ts draws it both ways.\n *\n * Invariants: data only, the kind's fields (`node x describe look`): the sky `sky:daylight` (engine/gfx/sky.ts), which\n * a page that starts the engine shows (engine/app/look.ts), the scene's own style, and every filter it leaves out off.\n * Switching to it from a look with the scene's own lights warms up first (the lights change the shader key), then\n * builds nothing.\n *\n * @example\n * look.id; // 'look:daylight'\n * look.sky; // 'sky:daylight'\n * @see labs/box/looks/daylight.test.ts\n * @see tests/e2e/enhanced.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:daylight`: the box under a plain day: the sky `sky:daylight` over the scene's own style. */\nexport const look = defineLook('look:daylight', {\n  description: 'A plain day: the day sky and its sun over the scene, casting shadows; no filter.',\n  sky: 'sky:daylight',\n});\nlabs/box/scenes/fight-hero.ts\nlabs/box/scenes/clips.ts\nlabs/box/scenes/room-hero.ts\nlabs/box/cast/hero.ts\nlabs/box/library.ts\nlabs/box/sounds/effects.ts\nlabs/box/sounds/events.ts\nlabs/box/sounds/page.ts\nlabs/box/sounds/boxHall.ts\nlabs/box/clipFiles.ts\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport tempfile,json,shutil\np=Path('.')\nshort=tempfile.mkdtemp(prefix='g.',dir='/tmp')\nPath('runtime-env.json').write_text(json.dumps({'tmpdir':short})+'\\\\n')\nshutil.rmtree('.bootstrap-engine')\nPath('labs/game/tools').mkdir(exist_ok=True)\nPath('labs/game/tools/verify.mjs').write_text('''/** @file Quiet aggregate verification for the game, using private short socket paths. */\nimport { spawnSync } from 'node:child_process';\nimport { existsSync, globSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';\nimport { homedir } from 'node:os';\nconst fast = process.argv.includes('--fast');\nconst tmp = mkdtempSync('/tmp/g.');\nconst chrome = globSync(\"'`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0];\nconst env = { ...process.env, TMPDIR: tmp, CHROMIUM_PATH: process.env.CHROMIUM_PATH ?? chrome };\nlet passed = 0;\nconst failed = [];\nconst run = (command, ...args) => spawnSync(command, args, { env, encoding: '\"'utf8', maxBuffer: 268435456 });\nconst note = (name, ok, detail = '') => ok ? passed++ : failed.push(\"'`${name}: ${detail}`);\nconst tail = r => `${r.stdout}${r.stderr}`.trim().split('\"'\\\\\\\\n').slice(-5).join(' | ').slice(0, 700);\nconst step = (name, command, ...args) => { const r = run(command, ...args); note(name, r.status === 0, tail(r)); };\ntry {\n step('check', 'npm', 'run', '--silent', 'check');\n const report = 'out/test/report.json';\n rmSync(report, { force: true });\n const r = run('npm', 'test', '--silent');\n if (\"'!existsSync(report)) note('\"'tests', false, tail(r));\n else for (const f of JSON.parse(readFileSync(report, 'utf8')).testResults) for (const t of f.assertionResults) note(t.fullName, t.status === 'passed', String(t.failureMessages?.[0] ?? '').split('\\\\\\\\n')[0].slice(0,300));\n if (\"'!fast) {\n  step('\"'bundle', 'npx', 'tsx', 'labs/game/tools/one-file.mts');\n  step('replays', 'node', 'x', 'replay', 'labs/game/replays', '--browser', 'sim');\n  for (const path of ['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs']) if (existsSync(path)) {\n   const b = run('node', path);\n   const lines = b.stdout.split('\\\\\\\\n').filter(l => l.startsWith('{'));\n   for (const line of lines) { const t = JSON.parse(line); note(t.name,t.ok,t.detail); }\n   if (b.status \"'!== 0 || lines.length === 0) note(path,false,tail(b));\n  }\n }\n} finally { rmSync(tmp, { recursive: true, force: true }); }\nfor (const f of failed) console.log(`FAIL ${f}`);\nconsole.log(`verify: ${passed} passed, ${failed.length} failed`);\nprocess.exitCode = failed.length ? 1 : 0;\n'\"''')\nPath('labs/game/tools/one-file.mts').write_text('''/** @file Bundle all engine, game, UI and procedural assets into the requested portable HTML. */\nimport { build, type Rollup } from 'vite';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { resolve } from 'node:path';\nimport { inlineBuild, externalRefs, ONE_FILE_NOTE } from '../../../tools/lib/oneFile';\nconst root = process.cwd();\nconst { base } = JSON.parse(readFileSync('identity.json','utf8')) as {base:string};\nconst result = await build({root, configFile:false, logLevel:'error', base:'./', resolve:{alias:[{find:/\"'^three$/,replacement:'\"'three/webgpu'}]}, build:{write:false,modulePreload:false,cssCodeSplit:false,assetsInlineLimit:()=>true,chunkSizeWarningLimit:Infinity,rollupOptions:{input:resolve('labs/game/index.html'),output:{inlineDynamicImports:true}}}});\nconst outputs = (Array.isArray(result)?result:[result]) as Rollup.RollupOutput[];\nconst files: Record<string,string> = {};\nlet html = '';\nfor (const item of outputs.flatMap(o=>o.output)) {\n const value = item.type==='chunk'?item.code:typeof item.source==='string'?item.source:new TextDecoder().decode(item.source);\n if(item.fileName.endsWith('.html')) html=value; else files[item.fileName]=value;\n}\nhtml=inlineBuild(html,files).replace(ONE_FILE_NOTE,'<\"'!-- Trauma Coast: Second Sight. Original game; my-3dge, three.js MIT; Rapier and stdlib Apache-2.0. -->'\"');\nif(externalRefs(html).length) throw new Error('Bundle has external dependencies');\nwriteFileSync(resolve('..',\"'`${base}.html`),html);\nconsole.log(`Bundled ${html.length} characters`);\n'\"''')\nPath('labs/game/TESTING-LOG.md').write_text('# Testing log\\\\n\\\\nIssues are added when a check demonstrates a defect. Critical means a game cannot start or complete.\\\\n\\\\n## Issues\\\\n\\\\n## Prompt friction\\\\n- The supplied testing toolkit document is absent; built-in Playwright and the supplied instructions cover the required checks.\\\\n')\npkg=json.loads(Path('package.json').read_text());pkg['scripts']['verify']='node labs/game/tools/verify.mjs';pkg['scripts']['bundle']='tsx labs/game/tools/one-file.mts';Path('package.json').write_text(json.dumps(pkg,indent=2)+'\\\\n')\nprint(short)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
