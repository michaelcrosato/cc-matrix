-file.mts');\n  step('replays', 'node', 'x', 'replay', 'labs/game/replays', '--browser', 'sim');\n  for (const path of ['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs']) if (existsSync(path)) {\n   const b = run('node', path);\n   const lines = b.stdout.split('\\\\\\\\n').filter(l => l.startsWith('{'));\n   for (const line of lines) { const t = JSON.parse(line); note(t.name,t.ok,t.detail); }\n   if (b.status \"'!== 0 || lines.length === 0) note(path,false,tail(b));\n  }\n }\n} finally { rmSync(tmp, { recursive: true, force: true }); }\nfor (const f of failed) console.log(`FAIL ${f}`);\nconsole.log(`verify: ${passed} passed, ${failed.length} failed`);\nprocess.exitCode = failed.length ? 1 : 0;\n'\"''')\nPath('labs/game/tools/one-file.mts').write_text('''/** @file Bundle all engine, game, UI and procedural assets into the requested portable HTML. */\nimport { build, type Rollup } from 'vite';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { resolve } from 'node:path';\nimport { inlineBuild, externalRefs, ONE_FILE_NOTE } from '../../../tools/lib/oneFile';\nconst root = process.cwd();\nconst { base } = JSON.parse(readFileSync('identity.json','utf8')) as {base:string};\nconst result = await build({root, configFile:false, logLevel:'error', base:'./', resolve:{alias:[{find:/\"'^three$/,replacement:'\"'three/webgpu'}]}, build:{write:false,modulePreload:false,cssCodeSplit:false,assetsInlineLimit:()=>true,chunkSizeWarningLimit:Infinity,rollupOptions:{input:resolve('labs/game/index.html'),output:{inlineDynamicImports:true}}}});\nconst outputs = (Array.isArray(result)?result:[result]) as Rollup.RollupOutput[];\nconst files: Record<string,string> = {};\nlet html = '';\nfor (const item of outputs.flatMap(o=>o.output)) {\n const value = item.type==='chunk'?item.code:typeof item.source==='string'?item.source:new TextDecoder().decode(item.source);\n if(item.fileName.endsWith('.html')) html=value; else files[item.fileName]=value;\n}\nhtml=inlineBuild(html,files).replace(ONE_FILE_NOTE,'<\"'!-- Trauma Coast: Second Sight. Original game; my-3dge, three.js MIT; Rapier and stdlib Apache-2.0. -->'\"');\nif(externalRefs(html).length) throw new Error('Bundle has external dependencies');\nwriteFileSync(resolve('..',\"'`${base}.html`),html);\nconsole.log(`Bundled ${html.length} characters`);\n'\"''')\nPath('labs/game/TESTING-LOG.md').write_text('# Testing log\\\\n\\\\nIssues are added when a check demonstrates a defect. Critical means a game cannot start or complete.\\\\n\\\\n## Issues\\\\n\\\\n## Prompt friction\\\\n- The supplied testing toolkit document is absent; built-in Playwright and the supplied instructions cover the required checks.\\\\n')\npkg=json.loads(Path('package.json').read_text());pkg['scripts']['verify']='node labs/game/tools/verify.mjs';pkg['scripts']['bundle']='tsx labs/game/tools/one-file.mts';Path('package.json').write_text(json.dumps(pkg,indent=2)+'\\\\n')\nprint(short)\nPY\"","aggregated_output":"/tmp/g.5ozaaka0\n","exit_code":0,"status":"completed"}}
