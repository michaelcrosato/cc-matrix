{"type":"item.started","item":{"id":"item_144","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/e2e.mjs <<'EOF'\n/** @file Browser acceptance against the final file: actual pad menus, a complete shift, developer controls and attract. */\nimport {chromium} from '@playwright/test';\nimport {readFileSync,globSync,mkdirSync} from 'node:fs';\nimport {homedir} from 'node:os';\nimport {resolve} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nconst {base}=JSON.parse(readFileSync('identity.json','utf8'));\nconst url=pathToFileURL(resolve('..',base+'.html')).href;\nconst checks=[];const check=(name,ok,detail='')=>{const item={name,ok:\"'!!ok,detail};checks.push(item);console.log(JSON.stringify(item));};\nconst browser=await chromium.launch({executablePath:process.env.CHROMIUM_PATH??globSync(`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0],args:['\"'--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader']});\ntry{\n const context=await browser.newContext({viewport:{width:960,height:540}});\n await context.addInitScript(()=>{\n  window.testPads=[];\n  navigator.getGamepads=()=>window.testPads;\n  window.pad=(index,button,value=1)=>{let p=window.testPads[index];if(\"'!p)p=window.testPads[index]={id:'\"'Standard test controller',index,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};p.buttons[button]={pressed:value>.5,touched:value>0,value};};\n });\n const page=await context.newPage();page.setDefaultTimeout(90000);const errors=[],requests=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(/\"'^https?:/.test(r.url()))requests.push(r.url());});\n await page.goto(url);await page.waitForFunction(()=>!!window.__surgery&&window.__engine?.ready);\n check('\"'portable WebGPU boot',errors.length===0&&await page.locator('[data-game=\\\"title\\\"]').count()===1,errors.join(' | '));\n check('no external requests',requests.length===0,requests.join(' | '));\n const pad=async(button,index=0)=>{await page.evaluate(([i,b])=>window.pad(i,b,1),[index,button]);await page.waitForTimeout(100);await page.evaluate(([i,b])=>window.pad(i,b,0),[index,button]);await page.waitForTimeout(100);};\n const pick=async(action)=>{for(let i=0;i<30;i++){const active=await page.evaluate(()=>document.activeElement?.getAttribute('data-action'));if(active===action){await pad(0);return;}await pad(13);}throw new Error('Pad could not focus '+action);};\n await pad(0);check('pad starts a new story',await page.evaluate(()=>window.__surgery.director.screen==='story'));\n let ops=0;await page.evaluate(()=>{window.__surgery.autoplay(true);window.__engine.timeScale(4);});\n for(let guard=0;guard<260;guard++){\n  const state=await page.evaluate(()=>({screen:window.__surgery.director.screen,part:window.__surgery.director.part,index:window.__surgery.director.caseIndex,ready:window.__engine.ready}));\n  if(state.screen==='credits')break;\n  if(state.screen==='story'){await pad(0);}\n  else if(state.screen==='briefing'){await pick('operate');await page.waitForFunction(()=>window.__surgery.state?.status==='playing'&&window.__engine.ready);}\n  else if(state.screen==='op'){\n   await page.waitForFunction(()=>['debrief','failed'].includes(window.__surgery.director.screen),{timeout:120000});\n   const result=await page.evaluate(()=>({screen:window.__surgery.director.screen,id:window.__surgery.state?.caseId,reason:window.__surgery.state?.reason}));\n   check('browser surgeon completes '+result.id,result.screen==='debrief',result.reason);if(result.screen==='failed')throw new Error('Operation failed: '+result.id);ops++;\n  }else if(state.screen==='debrief'||state.screen==='postcard'){await pick('next-result');}\n  else await page.waitForTimeout(150);\n }\n check('whole shift reaches credits',ops===8&&await page.evaluate(()=>window.__surgery.director.screen==='credits'));\n check('eight postcards and Attending unlocked',await page.evaluate(()=>Object.keys(window.__surgery.director.progress.postcards).length===8&&window.__surgery.director.progress.ended));\n await page.evaluate(()=>{window.__surgery.autoplay(false);window.__engine.timeScale(1);window.__surgery.case('first-cut');});\n await page.waitForFunction(()=>window.__surgery.state?.caseId==='first-cut'&&window.__surgery.meshes.sheet>0&&window.__engine.ready);\n await page.keyboard.press('Escape');await page.locator('[data-action=\\\"dev\\\"]').click();await page.locator('[data-action=\\\"dev-tab:1\\\"]').click();\n const slider=page.locator('[data-balance=\\\"vitalsDrain\\\"]');await slider.evaluate(el=>{el.value='1.7';el.dispatchEvent(new Event('input',{bubbles:true}));});\n check('live developer balance',await page.evaluate(()=>Number(window.__surgery.ui.c.get('game.vitalsDrain'))===1.7));\n await page.locator('[data-action=\\\"balance-reset:vitalsDrain\\\"]').click();check('developer reset',await page.evaluate(()=>Number(window.__surgery.ui.c.get('game.vitalsDrain'))===1));\n await page.evaluate(()=>{window.__surgery.ui.action('board');window.__surgery.ui.action('scrub');});\n await pad(0,1);await pad(0,2);check('two independent pads claim couch seats',await page.evaluate(()=>window.__surgery.hands.devices.includes(1)&&window.__surgery.hands.devices.includes(2)&&window.__surgery.director.screen==='scrub'));\n await page.evaluate(()=>{window.__surgery.case('first-cut');});await page.waitForFunction(()=>window.__surgery.state?.caseId==='first-cut'&&window.__engine.ready);\n const before=await page.evaluate(()=>window.__surgery.state.seats.map(s=>s.x));\n await page.evaluate(()=>{window.testPads[1].axes[0]=.8;window.testPads[2].axes[0]=-.8;});await page.waitForTimeout(550);await page.evaluate(()=>{window.testPads[1].axes[0]=0;window.testPads[2].axes[0]=0;});\n const after=await page.evaluate(()=>window.__surgery.state.seats.map(s=>s.x));check('couch cursors move independently',after[1]<before[1]&&aft