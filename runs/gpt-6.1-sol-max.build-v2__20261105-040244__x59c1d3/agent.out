{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc 'cat tools/templates/camera/camera.ts.tmpl'","aggregated_output":"/**\n * @file The camera mode `cam3={{name}}`: what it shows (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a side-scroller's dolly: it stands `distance` metres east of the player and `height` metres up, looks\n * west and down at a point a metre over his feet, and follows him with a lag (a time constant of 0.15 real seconds),\n * so a jump or a fall moves the picture smoothly and a stop settles it. Its code is\n * `cam3={{name}}[,<distance>,<height>]` in metres, 8 and 2.5 when left out.\n *\n * Invariants: view state, never the sim's: pure steps over plain data, which `followCamera` wraps in a camera; a\n * checked pose each frame (`makePose`: metres and radians, +Y up, its yaw the heading the intents' `cam` takes); `dt`\n * is real seconds since the last frame, so it frames alike at any frame rate. `defineCamera` adds the mode when the\n * page imports this module; from then `?cam3={{name}}`, `__engine.camera.set('cam3={{name}}', { blend: true })` and\n * the camera rig's blends reach it, and its name is a word no engine camera has.\n *\n * @example\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n\ndefineCamera('{{name}}', {\n  description: \"A side-scroller's dolly: east of the player, looking west, following him with a lag (replace).\",\n  create(code) {\n    const [distance = DEFAULTS.distance, height = DEFAULTS.height] = code.split(',').slice(1).map(Number);\n    if (!(distance > 0) || !Number.isFinite(height)) throw new Error(`${code} is no {{name}} camera: write ${FORM}`);\n    return {{name}}Camera({ distance, height });\n  },\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/main.ts <<'EOF'\n/** @file Boot, run transitions and presentation; surgery rules and all multiplayer inputs stay in the sim. */\n/// <reference types=\\\"vite/client\\\" />\nimport {createEngine,createStore,type Engine,type EngineFrame,type Inspector} from '../../engine';\nimport {main} from './scenes/main';\nimport './view/assets';\nimport './view/bodies';\nimport {drawField} from './view/field';\nimport {meshes} from './view/field/liveMesh';\nimport {Hands,MAP} from './input/hands';\nimport {Director,freshProgress} from './app/director';\nimport {defaultPreferences} from './app/settings';\nimport {Soundtrack} from './audio/mix';\nimport {GameUI} from './ui';\nimport type {UIContext} from './ui/context';\nimport {CASES,getCase} from './data/cases';\nimport {storyFor} from './data/story';\nimport {BALANCE} from './data/balance';\nimport type {Hand,Operation} from './data/types';\nimport {Session,readOperation,type Hub} from './net/session';\nimport './ui/styles.css';\nconst hub=(window as unknown as {AIHub:Hub}).AIHub;\nconst info=hub?.active?await hub.connect({mode:'shared-world',seats:[1,4],card:true}):null;\nconst search=new URLSearchParams(location.search);\nfor(const key of [...search.keys()])if(key.startsWith('aihub'))search.delete(key);\nsearch.set('touch','off');search.set('gfx.warmUp','asked');\nsearch.set('cam3',info||search.get('game.run')?.startsWith('op:')?'fixed,0,15,-5,0,-72,42':'fixed,9,5,-12,-33,-16,46');\nsearch.set('post.look',info||search.get('game.run')?.startsWith('op:')?'look:field':'look:harbor');\nif(info){search.set('seed',String(info.seed));search.set('game.run','op:gala-shift');search.set('game.seats',String(info.players.length));}\nconst store=createStore({prefix:'trauma-coast:',mode:info?'demo':'play'}),prefs={...defaultPreferences(),...store.get('preferences',defaultPreferences())};\nconst d=new Director(store.get('progress',freshProgress())),hands=new Hands(),sound=new Soundtrack();\nlet engine:Engine|null=null,frame:EngineFrame|null=null,operation:Operation|undefined,activeRun=search.get('game.run')??'title',seed=Number(search.get('seed')??1),attract=false,idle=0,demoClock=0,demoIndex=-1,storyClock=0,storyKey='',lastPhase=-1,skipHold=0;\nconst live:Record<string,unknown>=Object.fromEntries(Object.entries(BALANCE).map(([k,[v]])=>[\"'`game.${k}`,v]));\nconst session=info?new Session(hub,info):null;\nif(activeRun.startsWith('\"'op:')){d.screen='op';d.caseIndex=activeRun==='op:gala-shift'?8:Math.max(0,CASES.findIndex(c=>c.id===activeRun.slice(3)));}\nconst set=(key:string,value:unknown):void=>{live[key]=value;engine?.inspector.set(key,value);};\nconst save=():void=>{if(attract||session)return;store.set('preferences',prefs);store.set('progress',d.progress);};\nconst context:UIContext={session:\"'!!session,d,prefs,hands,sound,engine:()=>engine,save,state:()=>operation,set,get:key=>frame?.setting(key)??live[key],act:(name,args)=>(engine?.inspector.actions as {run:(name:string,args:Record<string,unknown>)=>unknown})?.run(name,args),startSession:()=>{d.caseIndex=8;d.free=true;d.start();}};\nconst ui=new GameUI(context);\nfunction camera(code:string,blend=true):void{(engine?.inspector.camera as {set:(code:string,options?:object)=>void})?.set(code,{blend});}\nfunction run(runId:string,phase=0):void{\n if(!engine)return;activeRun=runId;lastPhase=-1;\n set('\"'game.run',runId);set('game.phase',phase);set('game.difficulty',prefs.difficulty);set('game.simpleGift',prefs.simpleGift);set('game.seats',hands.devices.length);set('game.attract',attract);\n for(const h of hands.seats){h[3]=0;h[4]=0;h[5]=0;h[7]=0;h[6]=0;}\n engine.inspector.seed(++seed);engine.inspector.resume();\n const op=runId.startsWith('op:');set('post.look',op?'look:field':'look:harbor');camera(op?'cam3=fixed,0,15,-5,0,-72,42':'cam3=fixed,9,5,-12,-33,-16,46',false);\n document.body.classList.toggle('operating',op);sound.theme(op?runId==='op:mercy'?'mercy':'calm':runId==='title'?'title':'story');\n}\nd.onChange=(runId,phase)=>{if(runId)run(runId,phase);ui.render();storyClock=0;};\nfunction exitDemo():void{if(\"'!attract)return;attract=false;demoClock=0;demoIndex=-1;document.querySelectorAll('\"'.demo-banner,.demo-prompt').forEach(e=>e.remove());set('game.autoplay',false);set('game.attract',false);d.go('title','title');}\nhands.onActivity=()=>{idle=0;if(attract)exitDemo();};\nhands.onMenu=code=>{if(session&&\"'!session.started){if(code==='\"'Enter')hub.answer('ready');if(code==='KeyT')hub.answer('more');return;}ui.menu(code);};\nhands.onPause=()=>{if(session){hands.seats[0][3]=0;ui.returnTo='op';d.go('settings');}else ui.pause();};\nhands.onHint=()=>{if(operation){ui.hud.line=operation.hint;sound.say('odie',operation.hint,prefs);}};\nhands.onClaim=device=>{if(session&&\"'!session.started){hub.answer('\"'ready');return;}if(d.screen==='scrub'&&hands.claim(device))ui.render(true);};\nconst clips=[['op:first-cut',0,18],['op:crosstalk',0,22],['story:1:after',0,10],['op:struck-off',1,25],['op:reverie',2,22],['op:gala-night',0,22],['op:mercy',1,22],['op:mercy',9,14]] as const;\nfunction demo(dt:number):void{\n demoClock+=dt;const total=clips.reduce((n,c)=>n+c[2],6),clock=demoClock%total;let passed=6,index=-1;\n for(let i=0;i<clips.length;i++){if(clock>=passed&&clock<passed+clips[i][2])index=i;passed+=clips[i][2];}\n if(index\"'!==demoIndex){demoIndex=index;if(index<0){d.go('\"'title','title');}else{const [runId,phase]=clips[index];if(runId.startsWith('story')){d.caseIndex=1;d.part='after';d.beat=0;d.go('story',runId);}else{d.caseIndex=runId==='op:first-cut'?0:runId==='op:crosstalk'?2:runId==='op:struck-off'?4:runId==='op:reverie'?5:runId==='op:gala-night'?6:7;d.go('op',runId,phase);}}}\n if(\"'!document.querySelector('\"'.demo-banner')){const banner=document.createElement('div');banner.className='demo-banner';banner.textContent='DEMO / THE NIGHT SHIFT';const prompt=document.createElement('div');prompt.className='demo-prompt';prompt.textContent='Any button to take the shift';document.getElementById('app')\"'!.append(banner,prompt);}\n}\nfunction touchGate():void{\n const gate=document.getElementById('\"'touch-gate')\"'!;\n if(hands.touch&&d.screen!=='\"'settings'){\n  if(\"'!gate.firstChild){gate.innerHTML='\"'<section class=\\\"touch-cover\\\"><h2>Controller or keyboard required</h2><p>Connect a controller to scrub in.<br>The night shift will play itself.</p><button data-touch-settings>Settings</button></section>';gate.querySelector('button')\"'!.onclick=()=>{ui.open('\"'settings');gate.innerHTML='';};}\n }else gate.innerHTML='';\n}\nfunction onFrame(f:EngineFrame):void{\n frame=f;if(\"'!engine)return;\n operation=(f.world.query('\"'operation')[0] as unknown as {operation:{data:Operation}}|undefined)?.operation.data;\n if(session&&session.e)operation=readOperation(session.e);\n hands.playing=d.screen==='op'&&\"'!attract&&(!session||session.started)&&!session?.ended;\n const inputs=hands.frame(f,prefs,operation,engine.input);\n if(session){if(info&&!info.server)session.local=[...(inputs[0]??[0,0,3,0,0,0,0,0,0])] as Hand;if(session.ended)sound.silence();}\n else if(hands.playing&&!ui.dev.author)(engine.inspector.input as {axis:(key:string,value:unknown)=>void}).axis('\"'game:hands',inputs);\n if(ui.dev.author){const h=inputs[0];if(h[3]&&ui.dev.path.length<500){const last=ui.dev.path.at(-1);if(\"'!last||Math.hypot(last[0]-h[0],last[1]-h[1])>.1)ui.dev.path.push([Math.round(h[0]*100)/100,Math.round(h[1]*100)/100]);}}\n if(!session){idle+=f.dt;if(attract)demo(f.dt);else if(idle>=10&&['\"'title','board','about','scrub','postcards','settings','handbook'].includes(d.screen)&&\"'!ui.rebinding){attract=true;demoClock=0;set('\"'game.autoplay',true);set('game.attract',true);demo(0);}}\n if(operation&&activeRun.startsWith('op:')){\n  const localSite=inputs[0]?.[6]??operation.seats[0].site;\n  const view=session?{...operation,seats:operation.seats.map((p,i)=>i===0?{...p,site:localSite}:p)}:operation;\n  drawField(view,f.dt,prefs.blood);ui.hud.frame(context,view,f.dt,f.world);\n  if(operation.phase\"'!==lastPhase){lastPhase=operation.phase;if(!attract&&!session&&!operation.dev){d.progress.checkpoint={caseIndex:d.caseIndex,phase:operation.phase};save();}}\n  if(operation.status!=='\"'playing'&&d.screen==='op'&&\"'!attract&&!session){engine.inspector.pause();sound.theme(operation.status==='\"'won'?'success':'failed');d.finish(operation,true);save();}\n  if(operation.caseId==='gala-night'&&\"'!document.querySelector('\"'.tv-caption')){const el=document.createElement('div');el.className='tv-caption';el.textContent='VOSS, LIVE: “A city without suffering\"'!”'\"';document.getElementById('hud')\"'!.append(el);}\n }else document.querySelector('\"'.tv-caption')?.remove();\n if(d.screen==='story'){\n  const story=storyFor(d.caseIndex,d.part),b=story.beats[d.beat]??story.beats[0],key=\"'`${story.id}/${d.beat}`;\n  (engine.inspector.input as {axis:(key:string,value:unknown)=>void}).axis('\"'game:beat',d.beat);\n  if(key\"'!==storyKey){storyKey=key;storyClock=0;sound.say(b.who,b.text,prefs);if(b.drama&&prefs.flashes){const el=document.getElementById('\"'drama')\"'!;el.querySelector('\"'b')\"'!.textContent=b.drama;el.classList.add('\"'show');setTimeout(()=>el.classList.remove('show'),800);}}\n  storyClock+=f.dt;if(attract&&storyClock>2){d.beat=(d.beat+1)%story.beats.length;d.revision++;storyClock=0;}\n  else if(prefs.auto&&storyClock>Math.max(2,b.text.length*.045)/prefs.textSpeed)d.advanceStory();\n  const padHeld=Array.from(navigator.getGamepads?.()??[]).some(p=>p?.buttons[1]?.pressed);skipHold=hands.keys.has('Escape')||padHeld?skipHold+f.dt:0;if(skipHold>.75){skipHold=0;d.skipStory();}\n }\n sound.frame(f,prefs,operation);ui.radial();if(\"'!session||d.screen==='\"'settings')ui.render();touchGate();\n document.body.classList.toggle('operating',activeRun.startsWith('op:'));\n if(\"'!session?.ended&&session?.started&&hub.time()<0){const boot=document.getElementById('\"'boot')\"'!;boot.classList.remove('\"'hidden');boot.querySelector('p')\"'!.textContent=String(Math.ceil(-hub.time()/1000));}else document.getElementById('\"'boot')\"'!.classList.add('\"'hidden');\n}\nif(\"'!session)ui.render();else{\n const wait=setInterval(()=>{const e=(window as unknown as {__engine?:Inspector}).__engine;if(e&&typeof e.step==='\"'function'){session.attach(e);clearInterval(wait);}},25);\n addEventListener('pagehide',()=>{clearInterval(wait);session.stop();},{once:true});\n}\nsound.theme(session?'calm':'title');\nengine=await createEngine({canvas:document.querySelector<HTMLCanvasElement>('#view')\"'!,scenes:[main.id],search:`?${search}`,store,actionMap:MAP.id,modal:()=>!session&&d.screen!=='\"'op',onFrame});\nif(\"'!session&&activeRun.startsWith('\"'op:'))document.body.classList.add('operating');\nObject.assign(window,{__surgery:{get state(){return operation;},director:d,ui,hands,prefs,sound,session,get attract(){return attract;},get idle(){return idle;},get meshes(){return Object.fromEntries(Object.entries(meshes).map(([k,m])=>[k,m.count]));},autoplay:(value:boolean)=>set('game.autoplay',value),case:(id:string,phase=0)=>{d.caseIndex=CASES.findIndex(c=>c.id===id);d.go('op',\"'`op:${id}`,phase);},exitDemo}});\naddEventListener('\"'pagehide',()=>{session?.stop();void sound.audio.close();},{once:true});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/main.ts <<'EOF'\n/** @file Boot, run transitions and presentation; surgery rules and all multiplayer inputs stay in the sim. */\n/// <reference types=\\\"vite/client\\\" />\nimport {createEngine,createStore,type Engine,type EngineFrame,type Inspector} from '../../engine';\nimport {main} from './scenes/main';\nimport './view/assets';\nimport './view/bodies';\nimport {drawField} from './view/field';\nimport {meshes} from './view/field/liveMesh';\nimport {Hands,MAP} from './input/hands';\nimport {Director,freshProgress} from './app/director';\nimport {defaultPreferences} from './app/settings';\nimport {Soundtrack} from './audio/mix';\nimport {GameUI} from './ui';\nimport type {UIContext} from './ui/context';\nimport {CASES,getCase} from './data/cases';\nimport {storyFor} from './data/story';\nimport {BALANCE} from './data/balance';\nimport type {Hand,Operation} from './data/types';\nimport {Session,readOperation,type Hub} from './net/session';\nimport './ui/styles.css';\nconst hub=(window as unknown as {AIHub:Hub}).AIHub;\nconst info=hub?.active?await hub.connect({mode:'shared-world',seats:[1,4],card:true}):null;\nconst search=new URLSearchParams(location.search);\nfor(const key of [...search.keys()])if(key.startsWith('aihub'))search.delete(key);\nsearch.set('touch','off');search.set('gfx.warmUp','asked');\nsearch.set('cam3',info||search.get('game.run')?.startsWith('op:')?'fixed,0,15,-5,0,-72,42':'fixed,9,5,-12,-33,-16,46');\nsearch.set('post.look',info||search.get('game.run')?.startsWith('op:')?'look:field':'look:harbor');\nif(info){search.set('seed',String(info.seed));search.set('game.run','op:gala-shift');search.set('game.seats',String(info.players.length));}\nconst store=createStore({prefix:'trauma-coast:',mode:info?'demo':'play'}),prefs={...defaultPreferences(),...store.get('preferences',defaultPreferences())};\nconst d=new Director(store.get('progress',freshProgress())),hands=new Hands(),sound=new Soundtrack();\nlet engine:Engine|null=null,frame:EngineFrame|null=null,operation:Operation|undefined,activeRun=search.get('game.run')??'title',seed=Number(search.get('seed')??1),attract=false,idle=0,demoClock=0,demoIndex=-1,storyClock=0,storyKey='',lastPhase=-1,skipHold=0;\nconst live:Record<string,unknown>=Object.fromEntries(Object.entries(BALANCE).map(([k,[v]])=>[\"'`game.${k}`,v]));\nconst session=info?new Session(hub,info):null;\nif(activeRun.startsWith('\"'op:')){d.screen='op';d.caseIndex=activeRun==='op:gala-shift'?8:Math.max(0,CASES.findIndex(c=>c.id===activeRun.slice(3)));}\nconst set=(key:string,value:unknown):void=>{live[key]=value;engine?.inspector.set(key,value);};\nconst save=():void=>{if(attract||session)return;store.set('preferences',prefs);store.set('progress',d.progress);};\nconst context:UIContext={session:\"'!!session,d,prefs,hands,sound,engine:()=>engine,save,state:()=>operation,set,get:key=>frame?.setting(key)??live[key],act:(name,args)=>(engine?.inspector.actions as {run:(name:string,args:Record<string,unknown>)=>unknown})?.run(name,args),startSession:()=>{d.caseIndex=8;d.free=true;d.start();}};\nconst ui=new GameUI(context);\nfunction camera(code:string,blend=true):void{(engine?.inspector.camera as {set:(code:string,options?:object)=>void})?.set(code,{blend});}\nfunction run(runId:string,phase=0):void{\n if(!engine)return;activeRun=runId;lastPhase=-1;\n set('\"'game.run',runId);set('game.phase',phase);set('game.difficulty',prefs.difficulty);set('game.simpleGift',prefs.simpleGift);set('game.seats',hands.devices.length);set('game.attract',attract);\n for(const h of hands.seats){h[3]=0;h[4]=0;h[5]=0;h[7]=0;h[6]=0;}\n engine.inspector.seed(++seed);engine.inspector.resume();\n const op=runId.startsWith('op:');set('post.look',op?'look:field':'look:harbor');camera(op?'cam3=fixed,0,15,-5,0,-72,42':'cam3=fixed,9,5,-12,-33,-16,46',false);\n document.body.classList.toggle('operating',op);sound.theme(op?runId==='op:mercy'?'mercy':'calm':runId==='title'?'title':'story');\n}\nd.onChange=(runId,phase)=>{if(runId)run(runId,phase);ui.render();storyClock=0;};\nfunction exitDemo():void{if(\"'!attract)return;attract=false;demoClock=0;demoIndex=-1;document.querySelectorAll('\"'.demo-banner,.demo-prompt').forEach(e=>e.remove());set('game.autoplay',false);set('game.attract',false);d.go('title','title');}\nhands.onActivity=()=>{idle=0;if(attract)exitDemo();};\nhands.onMenu=code=>{if(session&&\"'!session.started){if(code==='\"'Enter')hub.answer('ready');if(code==='KeyT')hub.answer('more');return;}ui.menu(code);};\nhands.onPause=()=>{if(session){hands.seats[0][3]=0;ui.returnTo='op';d.go('settings');}else ui.pause();};\nhands.onHint=()=>{if(operation){ui.hud.line=operation.hint;sound.say('odie',operation.hint,prefs);}};\nhands.onClaim=device=>{if(session&&\"'!session.started){hub.answer('\"'ready');return;}if(d.screen==='scrub'&&hands.claim(device))ui.render(true);};\nconst clips=[['op:first-cut',0,18],['op:crosstalk',0,22],['story:1:after',0,10],['op:struck-off',1,25],['op:reverie',2,22],['op:gala-night',0,22],['op:mercy',1,22],['op:mercy',9,14]] as const;\nfunction demo(dt:number):void{\n demoClock+=dt;const total=clips.reduce((n,c)=>n+c[2],6),clock=demoClock%total;let passed=6,index=-1;\n for(let i=0;i<clips.length;i++){if(clock>=passed&&clock<passed+clips[i][2])index=i;passed+=clips[i][2];}\n if(index\"'!==demoIndex){demoIndex=index;if(index<0){d.go('\"'title','title');}else{const [runId,phase]=clips[index];if(runId.startsWith('story')){d.caseIndex=1;d.part='after';d.beat=0;d.go('story',runId);}else{d.caseIndex=runId==='op:first-cut'?0:runId==='op:crosstalk'?2:runId==='op:struck-off'?4:runId==='op:reverie'?5:runId==='op:gala-night'?6:7;d.go('op',runId,phase);}}}\n if(\"'!document.querySelector('\"'.demo-banner')){const banner=document.createElement('div');banner.className='demo-banner';banner.textContent='DEMO / THE NIGHT SHIFT';const prompt=document.createElement('div');prompt.className='demo-prompt';prompt.textContent='Any button to take the shift';document.getElementById('app')\"'!.append(banner,prompt);}\n}\nfunction touchGate():void{\n const gate=document.getElementById('\"'touch-gate')\"'!;\n if(hands.touch&&d.screen!=='\"'settings'){\n  if(\"'!gate.firstChild){gate.innerHTML='\"'<section class=\\\"touch-cover\\\"><h2>Controller or keyboard required</h2><p>Connect a controller to scrub in.<br>The night shift will play itself.</p><button data-touch-settings>Settings</button></section>';gate.querySelector('button')\"'!.onclick=()=>{ui.open('\"'settings');gate.innerHTML='';};}\n }else gate.innerHTML='';\n}\nfunction onFrame(f:EngineFrame):void{\n frame=f;if(\"'!engine)return;\n operation=(f.world.query('\"'operation')[0] as unknown as {operation:{data:Operation}}|undefined)?.operation.data;\n if(session&&session.e)operation=readOperation(session.e);\n hands.playing=d.screen==='op'&&\"'!attract&&(!session||session.started)&&!session?.ended;\n const inputs=hands.frame(f,prefs,operation,engine.input);\n if(session){if(info&&!info.server)session.local=[...(inputs[0]??[0,0,3,0,0,0,0,0,0])] as Hand;if(session.ended)sound.silence();}\n else if(hands.playing&&!ui.dev.author)(engine.inspector.input as {axis:(key:string,value:unknown)=>void}).axis('\"'game:hands',inputs);\n if(ui.dev.author){const h=inputs[0];if(h[3]&&ui.dev.path.length<500){const last=ui.dev.path.at(-1);if(\"'!last||Math.hypot(last[0]-h[0],last[1]-h[1])>.1)ui.dev.path.push([Math.round(h[0]*100)/100,Math.round(h[1]*100)/100]);}}\n if(!session){idle+=f.dt;if(attract)demo(f.dt);else if(idle>=10&&['\"'title','board','about','scrub','postcards','settings','handbook'].includes(d.screen)&&\"'!ui.rebinding){attract=true;demoClock=0;set('\"'game.autoplay',true);set('game.attract',true);demo(0);}}\n if(operation&&activeRun.startsWith('op:')){\n  const localSite=inputs[0]?.[6]??operation.seats[0].site;\n  const view=session?{...operation,seats:operation.seats.map((p,i)=>i===0?{...p,site:localSite}:p)}:operation;\n  drawField(view,f.dt,prefs.blood);ui.hud.frame(context,view,f.dt,f.world);\n  if(operation.phase\"'!==lastPhase){lastPhase=operation.phase;if(!attract&&!session&&!operation.dev){d.progress.checkpoint={caseIndex:d.caseIndex,phase:operation.phase};save();}}\n  if(operation.status!=='\"'playing'&&d.screen==='op'&&\"'!attract&&!session){engine.inspector.pause();sound.theme(operation.status==='\"'won'?'success':'failed');d.finish(operation,true);save();}\n  if(operation.caseId==='gala-night'&&\"'!document.querySelector('\"'.tv-caption')){const el=document.createElement('div');el.className='tv-caption';el.textContent='VOSS, LIVE: “A city without suffering\"'!”'\"';document.getElementById('hud')\"'!.append(el);}\n }else document.querySelector('\"'.tv-caption')?.remove();\n if(d.screen==='story'){\n  const story=storyFor(d.caseIndex,d.part),b=story.beats[d.beat]??story.beats[0],key=\"'`${story.id}/${d.beat}`;\n  (engine.inspector.input as {axis:(key:string,value:unknown)=>void}).axis('\"'game:beat',d.beat);\n  if(key\"'!==storyKey){storyKey=key;storyClock=0;sound.say(b.who,b.text,prefs);if(b.drama&&prefs.flashes){const el=document.getElementById('\"'drama')\"'!;el.querySelector('\"'b')\"'!.textContent=b.drama;el.classList.add('\"'show');setTimeout(()=>el.classList.remove('show'),800);}}\n  storyClock+=f.dt;if(attract&&storyClock>2){d.beat=(d.beat+1)%story.beats.length;d.revision++;storyClock=0;}\n  else if(prefs.auto&&storyClock>Math.max(2,b.text.length*.045)/prefs.textSpeed)d.advanceStory();\n  const padHeld=Array.from(navigator.getGamepads?.()??[]).some(p=>p?.buttons[1]?.pressed);skipHold=hands.keys.has('Escape')||padHeld?skipHold+f.dt:0;if(skipHold>.75){skipHold=0;d.skipStory();}\n }\n sound.frame(f,prefs,operation);ui.radial();if(\"'!session||d.screen==='\"'settings')ui.render();touchGate();\n document.body.classList.toggle('operating',activeRun.startsWith('op:'));\n if(\"'!session?.ended&&session?.started&&hub.time()<0){const boot=document.