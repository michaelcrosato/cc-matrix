{"type":"item.started","item":{"id":"item_179","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/calibrate.mts <<'EOF'\n/** @file Write rank thresholds at 45/60/75/90 percent of a fresh Resident solo-plus-colleague bot score. */\nimport {writeFileSync} from 'node:fs';\nimport {format,resolveConfig} from 'prettier';\nimport {allCases} from '../data/cases';\nimport {createOperation,defaultRules,scoreTotal} from '../scenes/op/state';\nimport {stepOperation} from '../scenes/op/step';\nimport {botHands,botHand} from '../bot';\nconst scores:Record<string,number>={},ranks:Record<string,number[]>={};\nfor(const c of allCases){const r=defaultRules(),s=createOperation(c.id,1,1,0,r);for(let i=0;i<60000&&s.status==='playing';i++){const h=botHands(s,r);if(c.ai)h[1]=botHand(s,1,r,true);stepOperation(s,h,r);}if(s.status\"'!=='\"'won')throw new Error(\"'`${c.id}: ${s.reason}`);scores[c.id]=scoreTotal(s);ranks[c.id]=[.45,.6,.75,.9].map(f=>Math.round(scores[c.id]*f));}\nconst file='\"'labs/game/data/cases/calibration.ts',source='/** @file Generated Resident bot scores and rank thresholds; npm run calibrate refreshes them. */\\\\nexport const BASE_SCORES:Record<string,number>='+JSON.stringify(scores)+';\\\\nexport const RANKS:Record<string,number[]>='+JSON.stringify(ranks)+';\\\\n';\nwriteFileSync(file,await format(source,{...(await resolveConfig(file)),parser:'typescript'}));console.log(\"'`Calibrated ${allCases.length} cases.`);\nEOF\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/calibrate.mts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_179","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/calibrate.mts <<'EOF'\n/** @file Write rank thresholds at 45/60/75/90 percent of a fresh Resident solo-plus-colleague bot score. */\nimport {writeFileSync} from 'node:fs';\nimport {format,resolveConfig} from 'prettier';\nimport {allCases} from '../data/cases';\nimport {createOperation,defaultRules,scoreTotal} from '../scenes/op/state';\nimport {stepOperation} from '../scenes/op/step';\nimport {botHands,botHand} from '../bot';\nconst scores:Record<string,number>={},ranks:Record<string,number[]>={};\nfor(const c of allCases){const r=defaultRules(),s=createOperation(c.id,1,1,0,r);for(let i=0;i<60000&&s.status==='playing';i++){const h=botHands(s,r);if(c.ai)h[1]=botHand(s,1,r,true);stepOperation(s,h,r);}if(s.status\"'!=='\"'won')throw new Error(\"'`${c.id}: ${s.reason}`);scores[c.id]=scoreTotal(s);ranks[c.id]=[.45,.6,.75,.9].map(f=>Math.round(scores[c.id]*f));}\nconst file='\"'labs/game/data/cases/calibration.ts',source='/** @file Generated Resident bot scores and rank thresholds; npm run calibrate refreshes them. */\\\\nexport const BASE_SCORES:Record<string,number>='+JSON.stringify(scores)+';\\\\nexport const RANKS:Record<string,number[]>='+JSON.stringify(ranks)+';\\\\n';\nwriteFileSync(file,await format(source,{...(await resolveConfig(file)),parser:'typescript'}));console.log(\"'`Calibrated ${allCases.length} cases.`);\nEOF\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/calibrate.mts'","aggregated_output":"Calibrated 9 cases.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_180","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re,json\nfor p in Path('labs/game/data/cases').glob('*.ts'):\n s=p.read_text();m=re.search(r\\\"id: '([\"'^'\"']+)'\\\",s)\n if m and re.search(r'ranks: \\\\[[\"'^'\"\\\\]]*\\\\]',s):\n  s=s.replace(\\\"import type { Case }\\\", \\\"import {RANKS} from './calibration';\\\\nimport type { Case }\\\")\n  s=re.sub(r'ranks: \\\\[[\"'^'\"\\\\]]*\\\\]',\\\"ranks: RANKS['\\\"+m[1]+\\\"']\\\",s);p.write_text(s)\np=Path('package.json');data=json.loads(p.read_text());data['scripts']['calibrate']='tsx labs/game/tools/calibrate.mts';p.write_text(json.dumps(data,indent=2)+'\\\\n')\np=Path('labs/game/scenes/play.test.ts');s=p.read_text().replace('createOperation, defaultRules','createOperation, defaultRules,scoreTotal').replace(\\\"import { Director }\\\", \\\"import {BASE_SCORES} from '../data/cases/calibration';\\\\nimport { Director }\\\");s+='''\\\\nit('keeps every rank threshold calibrated to the current Resident bot',()=>{for(const c of allCases){const s=play(c.id,1,1,'Resident',c.ai);expect(scoreTotal(s)).toBe(BASE_SCORES[c.id]);expect(c.ranks).toEqual([.45,.6,.75,.9].map(f=>Math.round(scoreTotal(s)*f)));}});\\\\n''';p.write_text(s)\n# The baseline gem game is superseded by the surgical scene and its replay/capture/bot/rule tests.\nfor name in ['best.ts','best.test.ts','cast/player.ts','scenes/play.ts']:\n (Path('labs/game')/name).unlink(missing_ok=True)\nfor name in ['debug.mts','coop-debug.mts','smoke.mts']:(Path('labs/game/tools')/name).unlink(missing_ok=True)\nPY\nnpx prettier --write labs/game/data/cases labs/game/scenes/play.test.ts labs/game/tools/calibrate.mts package.json\nnpm run check\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
