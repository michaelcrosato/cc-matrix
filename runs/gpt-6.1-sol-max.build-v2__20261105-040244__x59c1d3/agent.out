{"type":"item.completed","item":{"id":"item_160","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,125p' labs/game/tools/e2e.mjs; tail -30 labs/game/tools/one-file.mts; sed -n '230,245p' labs/game/scenes/op/state.ts; rg -n -A8 'if \\\\(.*gift|phase.gift' labs/game/bot.ts\"","aggregated_output":"/** @file Browser acceptance against the final file: actual pad menus, a complete shift, developer controls and attract. */\nimport { chromium } from '@playwright/test';\nimport { readFileSync, globSync } from 'node:fs';\nimport { homedir } from 'node:os';\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nconst { base } = JSON.parse(readFileSync('identity.json', 'utf8'));\nconst url = pathToFileURL(resolve('..', base + '.html')).href;\nconst errors = [];\nlet page;\nconst checks = [];\nconst check = (name, ok, detail = '') => {\n  const item = { name, ok: !!ok, detail };\n  checks.push(item);\n  console.log(JSON.stringify(item));\n};\nconst browser = await chromium.launch({\n  executablePath:\n    process.env.CHROMIUM_PATH ?? globSync(`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0],\n  args: ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader'],\n});\ntry {\n  const context = await browser.newContext({ viewport: { width: 960, height: 540 } });\n  await context.addInitScript(() => {\n    window.testPads = [];\n    navigator.getGamepads = () => window.testPads;\n    window.pad = (index, button, value = 1) => {\n      let p = window.testPads[index];\n      if (!p)\n        p = window.testPads[index] = {\n          id: 'Standard test controller',\n          index,\n          connected: true,\n          mapping: 'standard',\n          axes: [0, 0, 0, 0],\n          buttons: Array.from({ length: 17 }, () => ({ pressed: false, touched: false, value: 0 })),\n        };\n      p.buttons[button] = { pressed: value > 0.5, touched: value > 0, value };\n    };\n  });\n  page = await context.newPage();\n  page.setDefaultTimeout(90000);\n  const requests = [];\n  page.on('pageerror', (e) => {\n    errors.push(e.message);\n    console.log(JSON.stringify({ name: 'runtime exception', ok: false, detail: e.message }));\n  });\n  page.on('request', (r) => {\n    if (/^https?:/.test(r.url())) requests.push(r.url());\n  });\n  await page.goto(url);\n  await page.waitForFunction(() => !!window.__surgery && window.__engine?.ready);\n  check(\n    'portable WebGPU boot',\n    errors.length === 0 && (await page.locator('[data-game=\"title\"]').count()) === 1,\n    errors.join(' | '),\n  );\n  check('no external requests', requests.length === 0, requests.join(' | '));\n  const pad = async (button, index = 0) => {\n    await page.evaluate(([i, b]) => window.pad(i, b, 1), [index, button]);\n    await page.waitForTimeout(100);\n    await page.evaluate(([i, b]) => window.pad(i, b, 0), [index, button]);\n    await page.waitForTimeout(100);\n  };\n  const pick = async (action) => {\n    for (let i = 0; i < 30; i++) {\n      const active = await page.evaluate(() => document.activeElement?.getAttribute('data-action'));\n      if (active === action) {\n        await pad(0);\n        return;\n      }\n      await pad(13);\n    }\n    throw new Error('Pad could not focus ' + action);\n  };\n  await pad(0);\n  check('pad starts a new story', await page.evaluate(() => window.__surgery.director.screen === 'story'));\n  let ops = 0;\n  await page.evaluate(() => {\n    window.__surgery.autoplay(true);\n    window.__engine.timeScale(4);\n  });\n  for (let guard = 0; guard < 260; guard++) {\n    const state = await page.evaluate(() => ({\n      screen: window.__surgery.director.screen,\n      part: window.__surgery.director.part,\n      index: window.__surgery.director.caseIndex,\n      ready: window.__engine.ready,\n    }));\n    if (state.screen === 'credits') break;\n    if (state.screen === 'story') {\n      await pad(0);\n    } else if (state.screen === 'briefing') {\n      await pick('operate');\n      await page.waitForFunction(() => window.__surgery.state?.status === 'playing' && window.__engine.ready);\n    } else if (state.screen === 'op') {\n      await page.waitForFunction(() => ['debrief', 'failed'].includes(window.__surgery.director.screen), {\n        timeout: 120000,\n      });\n      const result = await page.evaluate(() => ({\n        screen: window.__surgery.director.screen,\n        id: window.__surgery.state?.caseId,\n        reason: window.__surgery.state?.reason,\n      }));\n      check('browser surgeon completes ' + result.id, result.screen === 'debrief', result.reason);\n      if (result.screen === 'failed') throw new Error('Operation failed: ' + result.id);\n      ops++;\n    } else if (state.screen === 'debrief' || state.screen === 'postcard') {\n      await pick('next-result');\n    } else await page.waitForTimeout(150);\n  }\n  check(\n    'whole shift reaches credits',\n    ops === 8 && (await page.evaluate(() => window.__surgery.director.screen === 'credits')),\n  );\n  check(\n    'eight postcards and Attending unlocked',\n    await page.evaluate(\n      () =>\n        Object.keys(window.__surgery.director.progress.postcards).length === 8 &&\n        window.__surgery.director.progress.ended,\n    ),\n  );\n  await page.evaluate(() => {\n    window.__surgery.autoplay(false);\n    cssCodeSplit: false,\n    assetsInlineLimit: () => true,\n    chunkSizeWarningLimit: Infinity,\n    rollupOptions: { input: resolve('labs/game/index.html'), output: { inlineDynamicImports: true } },\n  },\n});\nconst outputs = (Array.isArray(result) ? result : [result]) as Rollup.RollupOutput[];\nconst files: Record<string, string> = {};\nlet html = '';\nfor (const item of outputs.flatMap((o) => o.output)) {\n  const value =\n    item.type === 'chunk'\n      ? item.code\n      : typeof item.source === 'string'\n        ? item.source\n        : new TextDecoder().decode(item.source);\n  if (item.fileName.endsWith('.html')) html = value;\n  else files[item.fileName] = value;\n}\nhtml = inlineBuild(html, files).replace(\n  /<script type=\"module\">([\\s\\S]*?)<\\/script>/g,\n  (_match, code: string) => `<script type=\"module\">if(!globalThis.__unsupported){${code}}<` + '/script>',\n);\nhtml = html.replace(\n  ONE_FILE_NOTE,\n  '<!-- Trauma Coast: Second Sight. Original game; my-3dge, three.js MIT; Rapier and stdlib Apache-2.0. -->',\n);\nif (externalRefs(html).length) throw new Error('Bundle has external dependencies');\nwriteFileSync(resolve('..', `${base}.html`), html);\nconsole.log(`Bundled ${html.length} characters`);\n): void {\n  t.done = true;\n  rate(s, rules, seat, rating, base, t.x, t.z);\n  if (t.kind === 'wound' || t.kind === 'incision')\n    spawn(s, {\n      kind: t.kind === 'incision' ? 'wound' : 'abrasion',\n      at: [t.x, t.z],\n      path: t.path,\n      site: t.site,\n      required: getCase(s.caseId).phases[s.phase].close === true,\n    });\n  if (t.kind === 'lull') spawn(s, { kind: 'cocoon', at: [t.x, t.z], site: t.site });\n}\nexport function fail(s: Operation, reason: string): void {\n  s.status = 'lost';\n  s.reason = reason;\n35:    ((!limited&&phase.gift) || s.patients.some((v) => v < 28) || s.seats.some((q) => q.id !== id && (q.giftUntil > s.tick||q.pulseAt>0)))\n36-  ) {\n37-    h[4]++;\n38-  }\n39:  if (limited && s.seats.some((q) => q.giftUntil > s.tick) && p.gift > 0 && p.giftUntil <= s.tick) h[4]++;\n40-  if (p.tool === 5 && p.charge > 0) {\n41-    h[2] = 5;\n42-    h[3] = p.charge < 0.85 ? 1 : 0;\n43-    return h;\n44-  }\n45-  if (!limited && p.cooldown === 0 && Math.min(...s.patients) < 48) {\n46-    h[2] = 5;\n47-    h[0] = 6.8;\n--\n151:  if (t.kind === 'binder' && !s.seats.some((q) => q.giftUntil > s.tick)) {\n152:    if (p.gift === 0 && p.giftUntil > s.tick) return h;\n153-    use = false;\n154-  }\n155-  if (tool === 1 && !p.grab) use = dist([p.x, p.z], point) < 0.15;\n156-  return go(point, tool, use, t.site);\n157-}\n158-export function botHands(s: Operation, rules?: Rules): Hand[] {\n159-  return s.seats.map((p) => botHand(s, p.id, rules));\n160-}\n","exit_code":0,"status":"completed"}}
