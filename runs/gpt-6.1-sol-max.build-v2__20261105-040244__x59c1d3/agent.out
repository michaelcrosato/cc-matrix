xtContent=p.name;team.append(line);}}\n  hub.on('card',(data:{left:number|null;ready:number[];paused:boolean})=>{const timer=this.card.querySelector('[data-game=\\\"card-clock\\\"]');if(timer)timer.textContent=data.paused?'The team asked for more time.':data.left===null?'Preparing…':\"'`${Math.ceil(data.left/1000)}s to scrub in`;for(const p of this.players){const el=this.card.querySelector(`[data-player=\"${p.id}\"]`);if(el)el.textContent=p.name+(data.ready.includes(p.id)?'\"' · READY':' · preparing');}});\n  hub.on('start',()=>{this.started=true;this.card.innerHTML='';});\n  hub.on('message',(data:TickPacket|{t:'input';hand:Hand},from?:number)=>{if(this.ended)return;if(data.t==='input'&&info.isHost&&from\"'!==undefined)this.seq.input(from,data.hand);else if(data.t==='\"'ticks'&&\"'!info.isHost)this.seq.receive(data);});\n  hub.on('\"'leave',(data:{id:number})=>{this.players=this.players.filter(p=>p.id\"'!==data.id);this.seq.leave(data.id);});\n  hub.on('\"'time-up',()=>{if(info.isHost)this.finish(false);});\n  hub.on('end',()=>{this.ended=true;if(this.timer)clearInterval(this.timer);});\n  addEventListener('keydown',event=>{if(\"'!this.started){if(event.code==='\"'Enter')hub.answer('ready');if(event.code==='KeyT')hub.answer('more');}});\n  this.card.addEventListener('click',event=>{const el=(event.target as Element).closest<HTMLElement>('[data-hub]');if(el)hub.answer(el.dataset.hub\"'!);});\n }\n attach(e:Inspector):void{if(this.e)return;this.e=e;e.pause();this.hub.ready();this.timer=setInterval(()=>this.tick(),16);}\n tick():void{\n  const e=this.e;if(!e||this.ended||!this.started||this.hub.time()<0)return;const now=this.hub.time();\n  if(!this.info.server&&now-this.lastInput>=70){this.lastInput=now;if(this.info.isHost)this.seq.input(this.info.me,this.local);else this.hub.send({t:'\"'input',hand:this.local},{to:this.info.host,reliable:false});}\n  if(this.info.isHost){\n   const due=Math.floor(now*60/1000);let count=0;\n   while(this.seq.next<due&&count++<120){const hands=this.seq.hands.map(h=>[...h] as Hand);if(\"'!this.buffer.length)this.from=this.seq.next;e.step(1,{'\"'game:hands':hands});this.seq.next++;this.buffer.push(hands);if(this.buffer.length>=5)this.flush();}\n   if(now-this.lastSend>=70)this.flush();const s=readOperation(e);if(s&&s.status\"'!=='\"'playing')this.finish(s.status==='won');\n  }else this.seq.drain(h=>e.step(1,{'game:hands':h}),()=>e.hash(),this.seq.queue.size>30?8:this.seq.queue.size>6?2:1);\n }\n flush():void{if(\"'!this.e||!this.buffer.length)return;const packet:TickPacket={t:'\"'ticks',from:this.from,hands:this.buffer,check:this.seq.next%60<5?[this.seq.next,this.e.hash()]:undefined};this.hub.send(packet,{reliable:true});this.buffer=[];this.lastSend=this.hub.time();}\n finish(won:boolean):void{\n  if(this.finished||this.ended||\"'!this.info.isHost)return;this.finished=true;const s=this.e?readOperation(this.e):undefined,players=[...this.players].sort((a,b)=>(s?.seats[b.id]?.score??0)-(s?.seats[a.id]?.score??0));\n  const standings:number[][]=[];for(const p of players){const value=s?.seats[p.id]?.score??0,last=standings.at(-1);if(last&&(s?.seats[last[0]]?.score??0)===value)last.push(p.id);else standings.push([p.id]);}\n  this.hub.finish({standings,scores:Object.fromEntries(players.map(p=>[p.id,s?.seats[p.id]?.score??0])),won,stats:Object.fromEntries(players.map(p=>[p.id,{Slips:s?.seats[p.id]?.slips??0,'\"'Best chain':s?.seats[p.id]?.best??1}])),awards:players.map(p=>({id:p.id,title:'Steadiest hands',detail:\"'`${s?.seats[p.id]?.slips??0} slips`}))});\n }\n stop():void{if(this.timer)clearInterval(this.timer);this.timer=null;}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
