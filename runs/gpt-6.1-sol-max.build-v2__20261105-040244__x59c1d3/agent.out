oid{\n if(lacquered(s,t)){refuse(s,p,'Balm seals the wound. Dissolve it with Gel first.');return;}\n const n=nearest(t.path,p.x,p.z),spacing=r.balance.stitchSpacing,need=Math.ceil(pathLength(t.path)/spacing);\n if(n.distance<.12||n.distance>1.2)return;\n if(n.side\"'!==t.last&&(t.stitches.length===0||dist(t.stitches.at(-1)!,n.point)>=spacing*.6)){\n  t.stitches.push(n.point);t.last=n.side;t.progress=t.stitches.length/need;event(s,'\"'stitch','STITCH',n.point[0],n.point[1],p.id);s.lastProgress=s.tick;\n  if(t.stitches.length>=need)finishTarget(s,r,p,t,20*need,t.cycle>need*130?'CLEAN':'TEXTBOOK');\n }t.cycle++;\n}\nfunction laser(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(p.cooldown>0)return;\n p.heat+=1/60;if(p.heat>=r.balance.laserHeat){p.cooldown=120;p.heat=0;event(s,'say','Laser overheated. Two seconds, Doctor.');return;}\n const damage=(r.oneHit?100:r.balance.laserPower)/60;\n if(t.kind==='solace'&&t.generation<3){refuse(s,p,'It likes the warmth. Divide it with the Scalpel first.');return;}\n if(t.kind==='reverie'){\n  if(t.scanned<s.fieldTicks){refuse(s,p,'Find its pulse with the Scanner first.');return;}\n  if(t.exposed<s.fieldTicks){t.exposed=s.fieldTicks+18000;t.dose++;event(s,'tool','SURFACED',t.x,t.z);}\n }\n if(t.kind==='balm'){t.radius-=damage*.8;s.patients[patientAt(s,p.site)]-=.5/60;if(t.radius<.2)finishTarget(s,r,p,t,30);return;}\n t.progress+=damage;\n const need=t.kind==='lull'?1.5:t.kind==='mote'?.6:t.kind==='reverie'?5:1.2;\n if(t.progress>=need*r.balance.strainHp*(1+r.balance.coopHp*Math.max(0,s.seats.filter(x=>x.active).length-1))&&(t.kind\"'!=='\"'reverie'||t.dose>=3))finishTarget(s,r,p,t,['lull','reverie','solace'].includes(t.kind)?500:100);\n}\nfunction binder(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(t.kind==='matron'&&(s.fieldTicks-t.born)%48000>15000){refuse(s,p,'Armoured. Wait for the yawn.');return;}\n if(t.kind==='mercy'&&s.targets.some(m=>m.kind==='mote'&&\"'!m.done)){refuse(s,p,'\"'The motes shield her. Laser every one.');return;}\n if(t.kind==='binder'&&\"'!s.seats.some(seat=>seat.giftUntil>s.tick)){refuse(s,p,'\"'These points need a Gift. Press Space.');return;}\n t.progress+=1/60;p.charge=0;\n if(t.progress>=.4){t.progress=0;t.dose++;p.cooldown=24;rate(s,r,p,'TEXTBOOK',100);event(s,'binder','BINDER',t.x,t.z,p.id);const need=t.kind==='matron'||t.kind==='node'?2:t.kind==='mercy'?3:1;if(t.dose>=need){t.done=true;rate(s,r,p,'TEXTBOOK',500);if(t.kind==='node')for(const f of s.targets)if(f.site===t.site&&f.kind==='balm')f.clip=s.fieldTicks+36000;}}\n}\nfunction gel(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(t.kind==='balm'){t.radius-=1/60;if(t.radius<.18)finishTarget(s,r,p,t,30);return;}\n let sector:number;\n if(t.path.length)sector=Math.round(nearest(t.path,p.x,p.z).along/pathLength(t.path)*11);\n else sector=Math.round(((Math.atan2(p.z-t.z,p.x-t.x)+Math.PI)/(2*Math.PI))*11);\n for(let i=Math.max(0,sector-1);i<=Math.min(11,sector+1);i++)t.mask|=1<<i;\n t.progress+=1/60;\n const count=t.mask.toString(2).replaceAll('0','').length;\n if(count>=11&&t.progress>.35)finishTarget(s,r,p,t,50);\n}\nexport function useTool(s:Operation,r:Rules,p:Seat,held:boolean):void{\n const was=p.held;p.held=held;p.cooldown=Math.max(0,p.cooldown-1);\n if(\"'!held)p.heat=Math.max(0,p.heat-2/60);\n if(p.tool===5&&!held&&was&&p.charge>0&&p.cooldown===0){const dose=p.charge>=.75&&p.charge<=.95?24:p.charge>.95?6:r.balance.stabilizer*Math.min(1,p.charge/.75);s.patients[patientAt(s,p.site)]=Math.min(100,s.patients[patientAt(s,p.site)]+dose);rate(s,r,p,dose===24?'\"'TEXTBOOK':dose>=12?'CLEAN':'ROUGH',20);event(s,'inject',\"'`+${Math.round(dose)} VITALS`,p.x,p.z);p.charge=0;p.cooldown=120;}\n if(p.grab&&p.tool===1){const grab=s.targets.find(t=>t.id===p.grab&&!t.done);if(grab){extract(s,r,p,grab,held);return;}p.grab=0;}\n if(!held){p.grab=0;return;}\n if(p.tool===7){\n  for(const t of s.targets)if(!t.done&&t.site===p.site&&Math.hypot(t.x-p.x,t.z-p.z)<=3&&!hidden(s,t)){\n   if(t.buried&&t.scanned<s.fieldTicks){event(s,'\"'scan','FOUND',t.x,t.z);rate(s,r,p,'CLEAN',30);}\n   t.scanned=s.fieldTicks+36000;if(t.kind==='decoy')finishTarget(s,r,p,t,30);\n  }return;\n }\n const t=targetAt(s,p);\n if(p.tool===5){if(p.cooldown>0)return;if(t&&['matron','node','mercy','binder'].includes(t.kind)&&\"'!hidden(s,t)){binder(s,r,p,t);return;}p.charge=clamp(p.charge+1/60,0,1.2);return;}\n if(!t){if(p.tool===0){p.healthy++;if(p.healthy>12)slip(s,r,p,'\"'There is no incision guide here.');}if(p.tool===4){p.heat+=1/60;p.healthy++;if(p.healthy>60){slip(s,r,p,'That is healthy tissue. Move the beam.');p.healthy=0;}}return;}\n if(hidden(s,t)){refuse(s,p,t.parent?'Lift the flap with Forceps.':'Blood hides it. Drain the pool first.');return;}\n if(t.buried&&t.scanned<s.fieldTicks){refuse(s,p,'It is below the surface. Scanner first.');return;}\n if(RESPONSE[TOOLS[p.tool]][t.kind]\"'!=='\"'effect'){refuse(s,p,RESPONSE[TOOLS[p.tool]][t.kind]);return;}\n switch(p.tool){\n case 0:cut(s,r,p,t);break;\n case 1:if(t.kind==='mass'&&\"'!t.dose)refuse(s,p,'\"'Cut all the way around the mass first.');else extract(s,r,p,t,held);break;\n case 2:sew(s,r,p,t);break;\n case 3:if(lacquered(s,t)){refuse(s,p,'Gel the lacquer first.');break;}t.hp-=r.balance.drainRate/70;if(t.hp<=.04)finishTarget(s,r,p,t,30);break;\n case 4:laser(s,r,p,t);break;\n case 6:gel(s,r,p,t);break;\n }\n}\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/scenes/strains/index.ts').write_text('''/** @file Deterministic telegraphed parasite state machines, reattaching tendrils and flap physics. */\nimport { getCase } from '../../data/cases';\nimport { STRAINS } from '../../data/strains';\nimport type { Operation, Rules, Target } from '../../data/types';\nimport { clamp } from '../op/geometry';\nimport { event, patientAt, spawn } from '../op/state';\nexport function telegraph(s:Operation,t:Target,rules:Rules):number{\n const key=t.kind==='matron'?'matron':t.kind==='solace'?'solace':t.kind==='reverie'?'reverie':t.kind==='mercy'?'mercy':'lull';\n const cfg=STRAINS[key],period=cfg.period*6000,phase=(s.fieldTicks-t.born)%period,duration=cfg.telegraph*rules.balance.telegraph*6000;\n return phase>period-duration?(phase-(period-duration))/duration:0;\n}\nexport function updateStrains(s:Operation,r:Rules,delta:number):void{\n const dt=delta/6000;\n for(const t of [...s.targets]){\n  if(t.kind==='tendril'&&t.done&&t.clip&&s.fieldTicks>t.clip&&getCase(s.caseId).phases[s.phase].id==='tendrils'){t.done=false;t.clip=0;event(s,'say','A tendril reattached. Work around the heart.');}\n  if(t.done)continue;\n  const age=(s.fieldTicks-t.born)/6000;\n  if(t.kind==='flap'){\n   const holder=s.seats.find(p=>p.grab===t.id&&p.held);\n   if(\"'!holder&&t.clip<s.fieldTicks)t.lift=Math.max(0,t.lift-dt*3);\n   continue;\n  }\n  if(t.kind==='\"'lull'){t.x=clamp(t.baseX+Math.sin(age*.75+t.id)*.65,-6.2,6.2);t.z=clamp(t.baseZ+Math.cos(age*.8+t.id)*.35,-2.6,2.6);}\n  if(t.kind==='reverie'){t.x=Math.sin(age*.7+t.id)*3.6;t.z=Math.sin(age*1.12+t.id)*1.9;}\n  if(t.kind==='solace'){t.x=t.baseX+Math.sin(age*.4+t.id)*.15;}\n  if(t.kind==='balm'){\n   if(t.clip){t.radius=Math.max(0,t.radius-dt*.8);if(s.fieldTicks>t.clip||t.radius<.1)t.done=true;}\n   else t.radius=Math.min(3,t.radius+dt*.035*r.balance.strainSpeed);\n   continue;\n  }\n  if(t.kind==='mote'){\n   const a=t.id*Math.PI/3+age*.22;t.x=Math.cos(a)*2.5;t.z=Math.sin(a)*1.9;continue;\n  }\n  const cfg=STRAINS[t.kind as keyof typeof STRAINS];\n  if(\"'!cfg||t.kind==='\"'balm')continue;\n  const period=cfg.period*6000,cycle=Math.floor((s.fieldTicks-t.born)/period);\n  if(cycle>t.cycle){\n   t.cycle=cycle;\n   if(t.kind==='matron'){if(s.targets.filter(x=>x.kind==='lull'&&\"'!x.done).length<5)spawn(s,{kind:'\"'lull',at:[t.x+1.8,t.z+1],site:t.site,required:true});}\n   else{\n    const p=patientAt(s,t.site);if(\"'!r.freezeVitals&&!s.seats.some(x=>x.giftKind==='\"'pulse'&&x.giftUntil>s.tick))s.patients[p]-=cfg.damage*r.balance.strainDamage;\n    if(t.kind==='reverie'||t.kind==='solace')spawn(s,{kind:'wound',at:[t.x,t.z],path:[[t.x-.8,t.z-.1],[t.x+.8,t.z+.2]],site:t.site,deep:t.kind==='reverie',required:false});\n    else spawn(s,{kind:'numb',at:[clamp(t.x+1,-5,5),clamp(t.z+.6,-2.5,2.5)],site:t.site,required:false,radius:.8});\n    event(s,'hit',\"'`${t.kind.toUpperCase()} HIT`,t.x,t.z);\n   }\n  }\n  if(t.kind==='\"'mercy'&&age>0&&Math.floor(age/8)>t.last&&s.targets.some(m=>m.kind==='mote'&&\"'!m.done)){\n   t.last=Math.floor(age/8);if(s.targets.filter(m=>m.kind==='\"'mote'&&\"'!m.done).length<6)spawn(s,{kind:'\"'mote',at:[2.5,0],site:t.site});\n  }\n }\n}\n''')\nPath('labs/game/scenes/op/step.ts').write_text('''/** @file One fixed surgical tick: hands, instruments, parasites, physiology, clock and checkpoint transitions. */\nimport { getCase } from '../../data/cases';\nimport type { Hand, Operation, Rules } from '../../data/types';\nimport { clamp } from './geometry';\nimport { pressGift, shock, updateGift } from './gift';\nimport { event, fail, patientAt, rate, startPhase } from './state';\nimport { useTool } from './tools';\nimport { updateStrains } from '../strains';\nexport function stepOperation(s:Operation,hands:Hand[],r:Rules):void{\n if(s.status\"'!=='\"'playing')return;s.tick++;\n let fieldRate=s.seats.some(p=>p.giftKind==='still'&&p.giftUntil>s.tick)?r.balance.stillRate:s.seats.some(p=>p.pulseAt)?.3:1;\n if(hands.some(h=>h?.[8]))fieldRate*=r.balance.radialSlow;\n const delta=Math.round(100*fieldRate),c=getCase(s.caseId);s.fieldTicks+=delta;\n for(const p of s.seats){\n  const h=hands[p.id];if(\"'!h||!p.active)continue;\n  p.px=p.x;p.pz=p.z;p.x=clamp(Math.round(h[0]*256)/256,-7.2,7.2);p.z=clamp(Math.round(h[1]*256)/256,-3.4,3.4);p.site=clamp(Math.round(h[6]),0,c.sites.length-1);\n  if(p.tool!==h[2]){p.grab=0;p.charge=0;event(s,'\"'switch',String(h[2]),p.x,p.z,p.id);}p.tool=clamp(Math.round(h[2]),0,7);\n  if(h[4]>p.giftCounter){p.giftCounter=h[4];pressGift(s,r,p);}\n  if(h[5]>p.shockCounter){p.shockCounter=h[5];shock(s);}\n  if(h[7]>p.swapCounter){p.swapCounter=h[7];if(c.ai&&c.id\"'!=='\"'struck-off'){const other=s.seats.find(q=>q.id\"'!==p.id);if(other){[p.giftKind,other.giftKind]=[other.giftKind,p.giftKind];[p.gift,other.gift]=[other.gift,p.gift];event(s,'\"'say',p.giftKind==='pulse'?'Sabine has the field.':'Wren has the field.');}}}\n  if(\"'!s.code)useTool(s,r,p,h[3]>0);\n  for(const t of s.targets)if(t.kind==='\"'tendril'&&t.done&&\"'!t.clip)t.clip=s.fieldTicks+60000;\n }\n updateGift(s,r);updateStrains(s,r,delta);\n if(!r.freezeVitals&&!r.attract){\n  for(let i=0;i<s.patients.length;i++){\n   let drain=0;\n   for(const t of s.targets){if(t.done||patientAt(s,t.site)!==i)continue;\n    if(t.kind==='\"'wound')drain+=t.deep?1.2:.5;\n    if(t.kind==='bleeder')drain+=.5;\n    if(t.kind==='lull')drain+=.6;\n    if(t.kind==='numb')drain+=.2;\n    if(t.kind==='balm')drain+=t.radius*t.radius*.04;\n    if(t.kind==='wound'&&s.fieldTicks-t.born>120000&&c.id==='reverie')t.deep=true;\n   }\n   if(\"'!s.seats.some(p=>p.giftUntil>s.tick&&p.giftKind==='\"'pulse'))s.patients[i]-=drain*delta/6000*r.balance.vitalsDrain*(r.difficulty==='Intern'?.6:r.difficulty==='Attending'?1.3:1);\n   if(s.patients[i]<=0&&\"'!s.code){if(c.id==='\"'first-cut'||c.id==='quiet-lump'||s.codes[i]>=1)fail(s,'The rhythm is gone.');else{s.patients[i]=0;s.code={patient:i,until:s.fieldTicks+48000,tries:0,scripted:false};event(s,'code','CODE. Charge the paddles.');}}\n  }\n }\n if(s.code&&s.fieldTicks>s.code.until&&\"'!r.attract)fail(s,'\"'The charge window closed.');\n if(\"'!r.freezeClock&&!r.attract)s.left=Math.max(0,s.left-delta);\n if(s.left===0&&!r.attract)fail(s,'\"'Time of death. You ran out of time.');\n const phase=c.phases[s.phase];\n if(phase.goal==='race'&&s.fieldTicks-s.phaseAt>180000&&\"'!r.attract)fail(s,'\"'Thirty seconds. The ventricle could not wait.');\n if(s.status\"'!=='\"'playing')return;\n const goals=s.targets.filter(t=>t.required&&\"'!t.done&&t.kind!=='\"'flap');\n const complete=phase.goal==='stabilize'?s.patients[0]>=58:goals.length===0;\n const giftDone=phase.goal\"'!=='\"'gift'||s.seats.some(p=>p.giftUntil>0);\n if(complete&&\"'!s.code&&giftDone){\n  if(++s.phaseWait>=36){rate(s,r,s.seats[0],'\"'CLEAN',1000);if(s.phase===c.phases.length-1){s.status='won';event(s,'won','OPERATION COMPLETE');}else startPhase(s,s.phase+1);}\n }else s.phaseWait=0;\n if(s.tick-s.lastProgress>480&&s.tick%480===0&&r.difficulty\"'!=='\"'Attending')event(s,'hint',s.hint);\n if(r.attract)for(let i=0;i<s.patients.length;i++)s.patients[i]=Math.max(65,s.patients[i]);\n}\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/scenes/strains/index.ts').write_text('''/** @file Deterministic telegraphed parasite state machines, reattaching tendrils and flap physics. */\nimport { getCase } from '../../data/cases';\nimport { STRAINS } from '../../data/strains';\nimport type { Operation, Rules, Target } from '../../data/types';\nimport { clamp } from '../op/geometry';\nimport { event, patientAt, spawn } from '../op/state';\nexport function telegraph(s:Operation,t:Target,rules:Rules):number{\n const key=t.kind==='matron'?'matron':t.kind==='solace'?'solace':t.kind==='reverie'?'reverie':t.kind==='mercy'?'mercy':'lull';\n const cfg=STRAINS[key],period=cfg.period*6000,phase=(s.fieldTicks-t.born)%period,duration=cfg.telegraph*rules.balance.telegraph*6000;\n return phase>period-duration?(phase-(period-duration))/duration:0;\n}\nexport function updateStrains(s:Operation,r:Rules,delta:number):void{\n const dt=delta/6000;\n for(const t of [...s.targets]){\n  if(t.kind==='tendril'&&t.done&&t.clip&&s.fieldTicks>t.clip&&getCase(s.caseId).phases[s.phase].id==='tendrils'){t.done=false;t.clip=0;event(s,'say','A tendril reattached. Work around the heart.');}\n  if(t.done)continue;\n  const age=(s.fieldTicks-t.born)/6000;\n  if(t.kind==='flap'){\n   const holder=s.seats.find(p=>p.grab===t.id&&p.held);\n   if(\"'!holder&&t.clip<s.fieldTicks)t.lift=Math.max(0,t.lift-dt*3);\n   continue;\n  }\n  if(t.kind==='\"'lull'){t.x=clamp(t.baseX+Math.sin(age*.75+t.id)*.65,-6.2,6.2);t.z=clamp(t.baseZ+Math.cos(age*.8+t.id)*.35,-2.6,2.6);}\n  if(t.kind==='reverie'){t.x=Math.sin(age*.7+t.id)*3.6;t.z=Math.sin(age*1.12+t.id)*1.9;}\n  if(t.kind==='solace'){t.x=t.baseX+Math.sin(age*.4+t.id)*.15;}\n  if(t.kind==='balm'){\n   if(t.clip){t.radius=Math.max(0,t.radius-dt*.8);if(s.fieldTicks>t.clip||t.radius<.1)t.done=true;}\n   else t.radius=Math.min(3,t.radius+dt*.035*r.balance.strainSpeed);\n   continue;\n  }\n  if(t.kind==='mote'){\n   const a=t.id*Math.PI/3+age*.22;t.x=Math.cos(a)*2.5;t.z=Math.sin(a)*1.9;continue;\n  }\n  const cfg=STRAINS[t.kind as keyof typeof STRAINS];\n  if(\"'!cfg||t.kind==='\"'balm')continue;\n  const period=cfg.period*6000,cycle=Math.floor((s.fieldTicks-t.born)/period);\n  if(cycle>t.cycle){\n   t.cycle=cycle;\n   if(t.kind==='matron'){if(s.targets.filter(x=>x.kind==='lull'&&\"'!x.done).length<5)spawn(s,{kind:'\"'lull',at:[t.x+1.8,t.z+1],site:t.site,required:true});}\n   else{\n    const p=patientAt(s,t.site);if(\"'!r.freezeVitals&&!s.seats.some(x=>x.giftKind==='\"'pulse'&&x.giftUntil>s.tick))s.patients[p]-=cfg.damage*r.balance.strainDamage;\n    if(t.kind==='reverie'||t.kind==='solace')spawn(s,{kind:'wound',at:[t.x,t.z],path:[[t.x-.8,t.z-.1],[t.x+.8,t.z+.2]],site:t.site,deep:t.kind==='reverie',required:false});\n    else spawn(s,{kind:'numb',at:[clamp(t.x+1,-5,5),clamp(t.z+.6,-2.5,2.5)],site:t.site,required:false,radius:.8});\n    event(s,'hit',\"'`${t.kind.toUpperCase()} HIT`,t.x,t.z);\n   }\n  }\n  if(t.kind==='\"'mercy'&&age>0&&Math.floor(age/8)>t.last&&s.targets.some(m=>m.kind==='mote'&&\"'!m.done)){\n   t.last=Math.floor(age/8);if(s.targets.filter(m=>m.kind==='\"'mote'&&\"'!m.done).length<6)spawn(s,{kind:'\"'mote',at:[2.5,0],site:t.site});\n  }\n }\n}\n''')\nPath('labs/game/scenes/op/step.ts').write_text('''/** @file One fixed surgical tick: hands, instruments, parasites, physiology, clock and checkpoint transitions. */\nimport { getCase } from '../../data/cases';\nimport type { Hand, Operation, Rules } from '../../data/types';\nimport { clamp } from './geometry';\nimport { pressGift, shock, updateGift } from './gift';\nimport { event, fail, patientAt, rate, startPhase } from './state';\nimport { useTool } from './tools';\nimport { updateStrains } from '../strains';\nexport function stepOperation(s:Operation,hands:Hand[],r:Rules):void{\n if(s.status\"'!=='\"'playing')return;s.tick++;\n let fieldRate=s.seats.some(p=>p.giftKind==='still'&&p.giftUntil>s.tick)?r.balance.stillRate:s.seats.some(p=>p.pulseAt)?.3:1;\n if(hands.some(h=>h?.[8]))fieldRate*=r.balance.radialSlow;\n const delta=Math.round(100*fieldRate),c=getCase(s.caseId);s.fieldTicks+=delta;\n for(const p of s.seats){\n  const h=hands[p.id];if(\"'!h||!p.active)continue;\n  p.px=p.x;p.pz=p.z;p.x=clamp(Math.round(h[0]*256)/256,-7.2,7.2);p.z=clamp(Math.round(h[1]*256)/256,-3.4,3.4);p.site=clamp(Math.round(h[6]),0,c.sites.length-1);\n  if(p.tool!==h[2]){p.grab=0;p.charge=0;event(s,'\"'switch',String(h[2]),p.x,p.z,p.id);}p.tool=clamp(Math.round(h[2]),0,7);\n  if(h[4]>p.giftCounter){p.giftCounter=h[4];pressGift(s,r,p);}\n  if(h[5]>p.shockCounter){p.shockCounter=h[5];shock(s);}\n  if(h[7]>p.swapCounter){p.swapCounter=h[7];if(c.ai&&c.id\"'!=='\"'struck-off'){const other=s.seats.find(q=>q.id\"'!==p.id);if(other){[p.giftKind,other.giftKind]=[other.giftKind,p.giftKind];[p.gift,other.gift]=[other.gift,p.gift];event(s,'\"'say',p.giftKind==='pulse'?'Sabine has the field.':'Wren has the field.');}}}\n  if(\"'!s.code)useTool(s,r,p,h[3]>0);\n  for(const t of s.targets)if(t.kind==='\"'tendril'&&t.done&&\"'!t.clip)t.clip=s.fieldTicks+60000;\n }\n updateGift(s,r);updateStrains(s,r,delta);\n if(!r.freezeVitals&&!r.attract){\n  for(let i=0;i<s.patients.length;i++){\n   let drain=0;\n   for(const t of s.targets){if(t.done||patientAt(s,t.site)!==i)continue;\n    if(t.kind==='\"'wound')drain+=t.deep?1.2:.5;\n    if(t.kind==='bleeder')drain+=.5;\n    if(t.kind==='lull')drain+=.6;\n    if(t.kind==='numb')drain+=.2;\n    if(t.kind==='balm')drain+=t.radius*t.radius*.04;\n    if(t.kind==='wound'&&s.fieldTicks-t.born>120000&&c.id==='reverie')t.deep=true;\n   }\n   if(\"'!s.seats.some(p=>p.giftUntil>s.tick&&p.giftKind==='\"'pulse'))s.patients[i]-=drain*delta/6000*r.balance.vitalsDrain*(r.difficulty==='Intern'?.6:r.difficulty==='Attending'?1.3:1);\n   if(s.patients[i]<=0&&\"'!s.code){if(c.id==='\"'first-cut'||c.id==='quiet-lump'||s.codes[i]>=1)fail(s,'The rhythm is gone.');else{s.patients[i]=0;s.code={patient:i,until:s.fieldTicks+48000,tries:0,scripted:false};event(s,'code','CODE. Charge the paddles.');}}\n  }\n }\n if(s.code&&s.fieldTicks>s.code.until&&\"'!r.attract)fail(s,'\"'The charge window closed.');\n if(\"'!r.freezeClock&&!r.attract)s.left=Math.max(0,s.left-delta);\n if(s.left===0&&!r.attract)fail(s,'\"'Time of death. You ran out of time.');\n const phase=c.phases[s.phase];\n if(phase.goal==='race'&&s.fieldTicks-s.phaseAt>180000&&\"'!r.attract)fail(s,'\"'Thirty seconds. The ventricle could not wait.');\n if(s.status\"'!=='\"'playing')return;\n const goals=s.targets.filter(t=>t.required&&\"'!t.done&&t.kind!=='\"'flap');\n const complete=phase.goal==='stabilize'?s.patients[0]>=58:goals.length===0;\n const giftDone=phase.goal\"'!=='\"'gift'||s.seats.some(p=>p.giftUntil>0);\n if(complete&&\"'!s.code&&giftDone){\n  if(++s.phaseWait>=36){rate(s,r,s.seats[0],'\"'CLEAN',1000);if(s.phase===c.phases.length-1){s.status='won';event(s,'won','OPERATION COMPLETE');}else startPhase(s,s.phase+1);}\n }else s.phaseWait=0;\n if(s.tick-s.lastProgress>480&&s.tick%480===0&&r.difficulty\"'!=='\"'Attending')event(s,'hint',s.hint);\n if(r.attract)for(let i=0;i<s.patients.length;i++)s.patients[i]=Math.max(65,s.patients[i]);\n}\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/bot.ts').write_text('''/** @file A surgeon bot uses the same quantized hands as humans, for proof, attract and the AI colleague. */\nimport { getCase } from './data/cases';\nimport { recommended } from './data/tools';\nimport type { Hand, Operation, Point, Rules, Seat, Target } from './data/types';\nimport { clamp, dist, pathAt, pathLength } from './scenes/op/geometry';\nimport { beatPeriod, shockLevel } from './scenes/op/gift';\nimport { hidden, lacquered } from './scenes/op/tools';\nexport function botHand(s:Operation,id=0,rules?:Rules,limited=false):Hand{\n const p=s.seats[id],c=getCase(s.caseId),phase=c.phases[s.phase];\n const h:Hand=[p.x,p.z,p.tool,0,p.giftCounter,p.shockCounter,p.site,p.swapCounter,0];\n const go=(point:Point,tool:number,use=true,site=p.site):Hand=>{\n  const d=dist([p.x,p.z],point),speed=limited?.11:.095,ratio=d>speed?speed/d:1;\n  h[0]=p.x+(point[0]-p.x)*ratio;h[1]=p.z+(point[1]-p.z)*ratio;h[2]=tool;h[3]=use?1:0;h[6]=site;return h;\n };\n if(s.code){const v=shockLevel(s);if(v>=.7&&v<=.8)h[5]++;return h;}\n if(p.pulseAt){const period=beatPeriod(s);if((s.tick+1)%period<2&&s.tick-p.pulseAt>period*(p.beats+.5))h[4]++;}\n else if(p.gift>0&&p.giftUntil<=s.tick&&(phase.gift||s.patients.some(v=>v<28)||s.seats.some(q=>q.id\"'!==id&&q.giftUntil>s.tick))){h[4]++;}\n if(limited&&s.seats.some(q=>q.giftUntil>s.tick)&&p.gift>0&&p.giftUntil<=s.tick)h[4]++;\n if(p.tool===5&&p.charge>0){h[2]=5;h[3]=p.charge<.85?1:0;return h;}\n if(!limited&&p.cooldown===0&&s.patients[p.site>=s.patients.length?0:p.site]<42){h[2]=5;h[0]=6;h[1]=3;h[3]=1;return h;}\n const live=s.targets.filter(t=>!t.done&&t.kind!=='\"'flap');\n if(p.grab&&p.tool===1){const t=s.targets.find(t=>t.id===p.grab&&\"'!t.done);if(t){if(t.kind==='\"'flap'){if(t.lift>.85&&\"'!limited){h[3]=0;return h;}return go([p.start[0],Math.max(-3.35,p.start[1]-1.75)],1,true,t.site);}return go([clamp(p.start[0]+1.28,-7,7),p.start[1]],1,true,t.site);}}\n const flap=live.map(t=>t.parent?s.targets.find(f=>f.id===t.parent&&!f.done):undefined).find(f=>f&&f.lift<.8);\n if(flap)return go([flap.x,flap.z],1,true,flap.site);\n let candidates=live;\n if(limited)candidates=live.filter(t=>['\"'pool','bleeder','numb','abrasion','mote'].includes(t.kind));\n const priority=(t:Target):number=>hidden(s,t)?100:t.kind==='balm'?0:t.kind==='pool'?1:t.kind==='mote'?2:t.kind==='wound'&&t.deep?3:t.required?4:9;\n candidates.sort((a,b)=>priority(a)-priority(b)||a.id-b.id);\n const assigned=candidates.filter((t,i)=>\"'!limited&&s.seats.filter(q=>q.active).length>1?i%Math.min(2,s.seats.length)===id%2:true);\n const t=assigned[0]??candidates[0];if(!t)return h;\n if(hidden(s,t)){const pool=live.find(p=>p.kind==='\"'pool'&&p.site===t.site);if(pool)return go([pool.x,pool.z],3,true,pool.site);return h;}\n if(lacquered(s,t)&&['wound','pool'].includes(t.kind)){const film=live.find(f=>f.kind==='balm'&&f.site===t.site);if(film)return go([film.x,film.z],6,true,film.site);}\n if(t.buried&&t.scanned<s.fieldTicks+500)return go([t.x,t.z],7,true,t.site);\n let tool=recommended(t.kind),point:Point=[t.x,t.z],use=true;\n if(t.kind==='incision'||t.kind==='mass'&&\"'!t.dose){tool=0;point=pathAt(t.path,t.progress+.065);use=dist([p.x,p.z],point)<.25;}\n if(t.kind==='\"'mass'&&t.dose)tool=1;\n if(t.kind==='solace'){\n  tool=t.generation<3?0:4;\n  if(tool===0){if(\"'!p.grab)point=[t.x-.78,t.z];else point=[p.start[0]+1.58,p.start[1]];use=dist([p.x,p.z],point)<.15||p.grab===t.id;}\n }\n if(t.kind==='\"'wound'){\n  const n=t.stitches.length,total=pathLength(t.path),along=clamp((n+.3)*total/Math.ceil(total/(rules?.balance.stitchSpacing??.45)),.12,total-.05),base=pathAt(t.path,along);\n  point=[base[0],base[1]+(n%2===0?.55:-.55)];\n }\n if(t.kind==='abrasion'||t.kind==='numb'){\n  let bit=0;while(bit<12&&(t.mask&(1<<bit)))bit++;\n  if(t.path.length)point=pathAt(t.path,pathLength(t.path)*Math.min(11,bit)/11);\n  else{const a=Math.min(11,bit)/11*Math.PI*2-Math.PI;point=[t.x+Math.cos(a)*.4,t.z+Math.sin(a)*.4];}\n }\n if(t.kind==='reverie')tool=t.scanned<s.fieldTicks+500?7:4;\n if(t.kind==='matron'&&(s.fieldTicks-t.born)%48000>14500)use=false;\n if(t.kind==='binder'&&\"'!s.seats.some(q=>q.giftUntil>s.tick)){if(p.gift===0&&p.giftUntil>s.tick)return h;use=false;}\n if(tool===1&&!p.grab)use=dist([p.x,p.z],point)<.15;\n return go(point,tool,use,t.site);\n}\nexport function botHands(s:Operation,rules?:Rules):Hand[]{return s.seats.map(p=>botHand(s,p.id,rules));}\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/bot.ts').write_text('''/** @file A surgeon bot uses the same quantized hands as humans, for proof, attract and the AI colleague. */\nimport { getCase } from './data/cases';\nimport { recommended } from './data/tools';\nimport type { Hand, Operation, Point, Rules, Seat, Target } from './data/types';\nimport { clamp, dist, pathAt, pathLength } from './scenes/op/geometry';\nimport { beatPeriod, shockLevel } from './scenes/op/gift';\nimport { hidden, lacquered } from './scenes/op/tools';\nexport function botHand(s:Operation,id=0,rules?:Rules,limited=false):Hand{\n const p=s.seats[id],c=getCase(s.caseId),phase=c.phases[s.phase];\n const h:Hand=[p.x,p.z,p.tool,0,p.giftCounter,p.shockCounter,p.site,p.swapCounter,0];\n const go=(point:Point,tool:number,use=true,site=p.site):Hand=>{\n  const d=dist([p.x,p.z],point),speed=limited?.11:.095,ratio=d>speed?speed/d:1;\n  h[0]=p.x+(point[0]-p.x)*ratio;h[1]=p.z+(point[1]-p.z)*ratio;h[2]=tool;h[3]=use?1:0;h[6]=site;return h;\n };\n if(s.code){const v=shockLevel(s);if(v>=.7&&v<=.8)h[5]++;return h;}\n if(p.pulseAt){const period=beatPeriod(s);if((s.tick+1)%period<2&&s.tick-p.pulseAt>period*(p.beats+.5))h[4]++;}\n else if(p.gift>0&&p.giftUntil<=s.tick&&(phase.gift||s.patients.some(v=>v<28)||s.seats.some(q=>q.id\"'!==id&&q.giftUntil>s.tick))){h[4]++;}\n if(limited&&s.seats.some(q=>q.giftUntil>s.tick)&&p.gift>0&&p.giftUntil<=s.tick)h[4]++;\n if(p.tool===5&&p.charge>0){h[2]=5;h[3]=p.charge<.85?1:0;return h;}\n if(!limited&&p.cooldown===0&&s.patients[p.site>=s.patients.length?0:p.site]<42){h[2]=5;h[0]=6;h[1]=3;h[3]=1;return h;}\n const live=s.targets.filter(t=>!t.done&&t.kind!=='\"'flap');\n if(p.grab&&p.tool===1){const t=s.targets.find(t=>t.id===p.grab&&\"'!t.done);if(t){if(t.kind==='\"'flap'){if(t.lift>.85&&\"'!limited){h[3]=0;return h;}return go([p.start[0],Math.max(-3.35,p.start[1]-1.75)],1,true,t.site);}return go([clamp(p.start[0]+1.28,-7,7),p.start[1]],1,true,t.site);}}\n const flap=live.map(t=>t.parent?s.targets.find(f=>f.id===t.parent&&!f.done):undefined).find(f=>f&&f.lift<.8);\n if(flap)return go([flap.x,flap.z],1,true,flap.site);\n let candidates=live;\n if(limited)candidates=live.filter(t=>['\"'pool','bleeder','numb','abrasion','mote'].includes(t.kind));\n const priority=(t:Target):number=>hidden(s,t)?100:t.kind==='balm'?0:t.kind==='pool'?1:t.kind==='mote'?2:t.kind==='wound'&&t.deep?3:t.required?4:9;\n candidates.sort((a,b)=>priority(a)-priority(b)||a.id-b.id);\n const assigned=candidates.filter((t,i)=>\"'!limited&&s.seats.filter(q=>q.active).length>1?i%Math.min(2,s.seats.length)===id%2:true);\n const t=assigned[0]??candidates[0];if(!t)return h;\n if(hidden(s,t)){const pool=live.find(p=>p.kind==='\"'pool'&&p.site===t.site);if(pool)return go([pool.x,pool.z],3,true,pool.site);return h;}\n if(lacquered(s,t)&&['wound','pool'].includes(t.kind)){const film=live.find(f=>f.kind==='balm'&&f.site===t.site);if(film)return go([film.x,film.z],6,true,film.site);}\n if(t.buried&&t.scanned<s.fieldTicks+500)return go([t.x,t.z],7,true,t.site);\n let tool=recommended(t.kind),point:Point=[t.x,t.z],use=true;\n if(t.kind==='incision'||t.kind==='mass'&&\"'!t.dose){tool=0;point=pathAt(t.path,t.progress+.065);use=dist([p.x,p.z],point)<.25;}\n if(t.kind==='\"'mass'&&t.dose)tool=1;\n if(t.kind==='solace'){\n  tool=t.generation<3?0:4;\n  if(tool===0){if(\"'!p.grab)point=[t.x-.78,t.z];else point=[p.start[0]+1.58,p.start[1]];use=dist([p.x,p.z],point)<.15||p.grab===t.id;}\n }\n if(t.kind==='\"'wound'){\n  const n=t.stitches.length,total=pathLength(t.path),along=clamp((n+.3)*total/Math.ceil(total/(rules?.balance.stitchSpacing??.45)),.12,total-.05),base=pathAt(t.path,along);\n  point=[base[0],base[1]+(n%2===0?.55:-.55)];\n }\n if(t.kind==='abrasion'||t.kind==='numb'){\n  let bit=0;while(bit<12&&(t.mask&(1<<bit)))bit++;\n  if(t.path.length)point=pathAt(t.path,pathLength(t.path)*Math.min(11,bit)/11);\n  else{const a=Math.min(11,bit)/11*Math.PI*2-Math.PI;point=[t.x+Math.cos(a)*.4,t.z+Math.sin(a)*.4];}\n }\n if(t.kind==='reverie')tool=t.scanned<s.fieldTicks+500?7:4;\n if(t.kind==='matron'&&(s.fieldTicks-t.born)%48000>14500)use=false;\n if(t.kind==='binder'&&\"'!s.seats.some(q=>q.giftUntil>s.tick)){if(p.gift===0&&p.giftUntil>s.tick)return h;use=false;}\n if(tool===1&&!p.grab)use=dist([p.x,p.z],point)<.15;\n return go(point,tool,use,t.site);\n}\nexport function botHands(s:Operation,rules?:Rules):Hand[]{return s.seats.map(p=>botHand(s,p.id,rules));}\n'\"''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/playthrough.mts <<'EOF'\n/** @file A complete scripted surgical playthrough and rank calibration, using human hand intents. */\nimport { allCases } from '../data/cases';\nimport { createOperation, defaultRules } from '../scenes/op/state';\nimport { stepOperation } from '../scenes/op/step';\nimport { botHands } from '../bot';\nconst rules=defaultRules();\nfor(const c of allCases){\n const s=createOperation(c.id,1,1,0,rules);\n for(let tick=0;tick<80000&&s.status==='playing';tick++)stepOperation(s,botHands(s,rules),rules);\n console.log(JSON.stringify({id:c.id,status:s.status,phase:s.phase,tick:s.tick,vitals:s.patients,slips:s.slips,score:s.score,reason:s.reason,targets:s.targets.filter(t=>\"'!t.done&&t.required).map(t=>({id:t.id,kind:t.kind,progress:t.progress,stitches:t.stitches.length,dose:t.dose,mask:t.mask})),last:s.events.slice(-4)}));\n}\nEOF\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/playthrough.mts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
