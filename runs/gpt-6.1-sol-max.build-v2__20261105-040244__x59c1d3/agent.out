{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat labs/box/cast/hero.ts && cat labs/box/library.ts && sed -n '100,195p' engine/world/props/prop.ts && rg -n \\\"SKY_FIELDS|ambient|sun:\\\" engine/gfx/sky.ts && rg -n \\\"interface LookSpec|const LOOK_FIELDS|filters|resolution|textures\\\" engine/gfx/post/looks.ts engine/gfx/post/*.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat labs/box/cast/hero.ts && cat labs/box/library.ts && sed -n '100,195p' engine/world/props/prop.ts && rg -n \\\"SKY_FIELDS|ambient|sun:\\\" engine/gfx/sky.ts && rg -n \\\"interface LookSpec|const LOOK_FIELDS|filters|resolution|textures\\\" engine/gfx/post/looks.ts engine/gfx/post/*.ts\"","aggregated_output":"/**\n * @file The box's hero (PLAN.md §9.0, WP 3.10): who the player walks, dashes and jumps as from Box 2 on. `HERO` is\n * his character (engine/physics/character.ts's settings: the controller's capsule, his speeds and timings),\n * `HERO_BODY` his animator's make (engine/anim/character.ts: the build and what his right hand holds), and\n * `spawnHero(w, at, tuning)` spawns him as a player actor (engine/sim/actors.ts) with both, so the controller moves\n * him, the animator steps his body with the sim, and the page draws him as the neutral humanoid.\n *\n * His numbers are the stress test's hero (`my-3d2dge:src/stress-world/20-sim.js:29, 113, 242-301`), in SI units\n * (PLAN.md Appendix C: 16 units a metre), as starting values (§9.0: similar, not identical; tuning changes them\n * freely). Where the prototype set a value they override the controller's defaults (shardfall's); where it set none\n * (coyote time, the variable jump, the capsule, steps and snapping) the defaults stand:\n * - walk 80 u/s → 5 m/s; take-off 150 u/s → 9.375 m/s; gravity 480 u/s² → 30 m/s², so the apex is\n *   9.375² / (2 · 30) ≈ 1.46 m, enough to jump onto the room's 0.75 m low wall and not its 3 m walls;\n * - fall capped at 600 u/s → 37.5 m/s;\n * - one rate, 900 u/s² → 56.25 m/s², for speeding up, stopping and turning (the prototype's `approach`), and 420 u/s²\n *   in the air, a share of 420 / 900 of it;\n * - the dash: 260 u/s → 16.25 m/s for 0.2 s, then 0.45 s before the next (the prototype also eased the dash's\n *   speed down to half: the controller's dash keeps its speed, so it reaches 3.25 m where the prototype's reached\n *   2.7 m); a jump pressed up to 0.12 s before landing still jumps.\n *\n * He shoves the crowd (`shoves: ['crowd']`): his controller passes walkers, slimes and wisps, and his capsule pushes\n * their bodies aside, as the prototype's `HERO_QUERY` did (`20-sim.js:33`; ADR-0020 amendment 9).\n *\n * His body: the default build (`build:chibi`, as the prototype's hero), empty-handed (`weapon: 'none'`).\n *\n * His fight (Box 5, WP 6.7): `HERO_FIGHT`, with a sword: his combo, the thrust out of a dash, his bolt, his hits.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * HERO.speed; // 5: m/s\n * HERO.jumpSpeed ** 2 / (2 * HERO.characterGravity!); // 1.46…: the apex, m\n * heroCharacter({ speed: 6 }).speed; // 6: a scene's setting, over the hero's own\n * @see labs/box/cast/hero.test.ts\n */\nimport {\n  createCharacter,\n  spawnActor,\n  type ActorSpec,\n  type Character,\n  type HitShape,\n  type World,\n} from '../../../engine/sim-api';\n\n/** The prototype's units per metre (PLAN.md Appendix C). */\nconst UNITS = 16;\n\n/** The hero's numbers as the prototype wrote them, in its units and seconds (see the file comment). */\nexport const PROTOTYPE = Object.freeze({\n  speed: 80,\n  jump: 150,\n  gravity: 480,\n  maxFall: 600,\n  acceleration: 900,\n  airAcceleration: 420,\n  dashSpeed: 260,\n  dashTime: 0.2,\n  dashCooldown: 0.45,\n  buffer: 0.12,\n});\n\n/** What a scene may tune of the hero: his walk, take-off and dash speeds, m/s. */\nexport interface HeroTuning {\n  speed?: number;\n  jumpSpeed?: number;\n  dashSpeed?: number;\n}\n\n/** The hero's character with `tuning` over his own numbers. Throws `CORE_BAD_SPEC` for a value out of range. */\nexport function heroCharacter(tuning: HeroTuning = {}): Character {\n  const p = PROTOTYPE;\n  const rate = p.acceleration / UNITS;\n  return createCharacter({\n    speed: tuning.speed ?? p.speed / UNITS,\n    jumpSpeed: tuning.jumpSpeed ?? p.jump / UNITS,\n    characterGravity: p.gravity / UNITS,\n    maxFall: p.maxFall / UNITS,\n    shoves: ['crowd'], // HERO_QUERY: his capsule shoves the crowd aside, never steering round it\n    acceleration: rate,\n    deceleration: rate,\n    skid: rate,\n    feel: {\n      buffer: p.buffer,\n      airControl: p.airAcceleration / p.acceleration,\n      dash: { speed: tuning.dashSpeed ?? p.dashSpeed / UNITS, duration: p.dashTime, cooldown: p.dashCooldown },\n    },\n  });\n}\n\n/** The hero's character, untuned. */\nexport const HERO: Character = heroCharacter();\n\n/** The hero's animator: the default build, empty-handed. */\nexport const HERO_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' }) satisfies ActorSpec['anim'];\n\n/**\n * Spawns the hero, the player, with his feet at `at` facing `yaw` (rad), and any further `components` (the fight's\n * reactions and cape); returns his id.\n */\nexport function spawnHero<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  yaw = 0,\n  tuning: HeroTuning = {},\n  components?: ActorSpec['components'],\n): number {\n  const character = heroCharacter(tuning);\n  return spawnActor(w, { at: [...at], character, player: true, yaw, anim: { ...HERO_BODY }, components });\n}\n\n/** What one of the hero's hits does: its cone, hit points, push (m/s), lunge (m/s) and whether it is a big one. */\nexport interface HeroHit {\n  readonly shape: HitShape;\n  readonly damage: number;\n  readonly knockback: number;\n  readonly push: number;\n  readonly big: boolean;\n}\n\n/** One of the prototype's hits (`HIT`): reach and push in its units, width in rad; from his feet to 1.5 m up. */\nconst hit = (range: number, halfAngle: number, damage: number, knockback: number, push: number, big = false) =>\n  Object.freeze({\n    shape: Object.freeze({ range: range / UNITS, halfAngle, yMin: 0, yMax: 24 / UNITS }),\n    damage,\n    knockback: knockback / UNITS,\n    push: push / UNITS,\n    big,\n  }) satisfies HeroHit;\n\n/**\n * The hero's fight (Box 5, WP 6.7), with a sword. Attack runs his combo, a slash, a backslash and a spin, each press\n * within `window` of the last hit's end flowing into the next; out of a dash it is the thrust instead, cutting the\n * dash. Each hit lands on what its cone holds (`hits`): the prototype's ranges and widths, wider than the blade's\n * measured sweep (engine/anim/moves.ts `measureMove`: a slash's tip reaches 1.13 m), so the walkers waiting on their\n * ring round him are in reach, and from his feet to 1.5 m up, so a slash meets a wisp hovering at his head as well as\n * a slime at his knees. A hit takes its hit points and pushes the body away; the big ones (the spin, the thrust) throw\n * it up a little and stop time a moment longer; one that kills throws the body up (`kill`: high after a big one) and\n * on with its push. He lunges into each strike (`push`). Skill fires a bolt ahead of him (`bolt`). A foe's blow\n * flinches him, pushes him away, and then he cannot be hit for a moment (`hurt`). The numbers are the prototype's\n * (`my-3d2dge:src/stress-world/20-sim.js:107-112, 134-135, 268-274, 303-316, 324-342`: `HIT`, the combo, the thrust,\n * `hurtHero`, `fireBolt`, `damageEnemy`), in metres and seconds, as starting values.\n *\n * WP 6.2 in the box (WP 7.8): every blow flinches the body it lands on through its reactions, `react.small` or\n * `react.big` hard (engine/anim/reactions.ts `hit`: about 1 for a blow); a big one knocks a walker down. He wears a\n * cape (`secondary`: the component the view hangs on his puppet, engine/sim/reactions.ts; the cape WP 6.2 carried\n * from `my-3d2dge:engine/my-3d2dge.js:2033-2068`), chosen here as the part a fight swings most.\n */\nexport const HERO_FIGHT = Object.freeze({\n  /** What his right hand holds. */\n  weapon: 'sword',\n  /** His combo's moves, in order, and how long after a hit ends a press still flows into the next (s). */\n  combo: Object.freeze(['move:slash', 'move:backslash', 'move:spin']),\n  window: 0.3,\n  /** The move attack runs out of a dash. */\n  thrust: 'move:thrust',\n  /** What each move's hit does, by move. */\n  hits: Object.freeze<Record<string, HeroHit>>({\n    'move:slash': hit(27, 1.35, 12, 130, 70),\n    'move:backslash': hit(27, 1.35, 12, 130, 70),\n    'move:spin': hit(34, Math.PI, 22, 230, 40, true),\n    'move:thrust': hit(38, 0.45, 20, 220, 130, true),\n  }),\n  /** A big hit's throw (m/s up), a killing hit's (small and big) and how much faster across the ground it goes. */\n  launch: 70 / UNITS,\n  kill: Object.freeze({ small: 95 / UNITS, big: 170 / UNITS, carry: 1.3 }),\n  /** The hit-stop a hit asks for (s), small and big. */\n  stop: Object.freeze({ small: 0.045, big: 0.06 }),\n  /** His bolt: speed (m/s), life (s), hit points, push (m/s), radius (m), start (m ahead, up), how often (s), his cast (s). */\n  bolt: Object.freeze({\n    speed: 260 / UNITS,\n    life: 1.2,\n    damage: 9,\n    knockback: 70 / UNITS,\n    radius: 3 / UNITS,\n    ahead: 8 / UNITS,\n    up: 11 / UNITS,\n    cooldown: 0.3,\n    cast: 0.18,\n  }),\n  /** His hit points. */\n  health: 100,\n  /** When a foe hits him: his flinch (s), the push (m/s), the time he cannot be hit after (s), the hit-stop (s). */\n  hurt: Object.freeze({ flinch: 0.22, knockback: 170 / UNITS, safe: 0.8, stop: 0.05 }),\n  /** How hard a blow flinches the body it lands on (a reaction's strength): a small blow's, a big one's. */\n  react: Object.freeze({ small: 1, big: 2 }),\n  /** His cape, the component `secondary` (engine/sim/reactions.ts): the view hangs it on his puppet and swings it. */\n  secondary: Object.freeze({ cape: true, color: '#7a2430' }),\n});\n/**\n * @file The animation library on the box page (PLAN.md §10, WP 8.9): `loadLibrary(files)` registers every set of\n * `data/anim/sets/` the page loaded as text (labs/box/clipFiles.ts, one chunk through `import.meta.glob`, never a\n * fetch), each as a\n * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\n * the mannequin, its build and body, from the Quaternius set (engine/gfx/puppets/bodies/mannequin.ts): what clip mode\n * (labs/box/scenes/clips.ts) plays and draws. The page calls it before it opens clip mode; no other scene loads it.\n * tests/pages/replay.ts calls it too, so clip mode's replays play in the sim page as here; Node registers the same\n * entries through tools/anim/library.ts. The lab pages register through here too (WP 10.8), so no page entry calls a\n * `define…` itself: `loadMannequin(text)`, the mannequin alone from the Quaternius set's `_set.json` text (labs/anim/,\n * labs/index/gallery.ts), and `registerEdit`, a clip's edited text played as a set of its own (labs/library/).\n *\n * Invariants: the sets register sorted by directory, each once (`defineClipSet` keeps a set registered already); the\n * module does nothing at its top level, so tools that import it in Node (`x describe`) load it as it is.\n *\n * Game code, a page's: it imports only engine/index.ts.\n *\n * @example\n * // await loadLibrary((await import('./clipFiles')).CLIP_FILES); // __engine.describe('clipset').ids: ['clipset:cmu', …]\n */\nimport { clipSetFromFiles, defineClipSet, defineMannequin, getClipSet, parseClip } from '../../engine';\n\n/** Registers the sets in `files` (path → its text, loaded on demand), then the mannequin from the Quaternius set. */\nexport async function loadLibrary(files: Readonly<Record<string, () => Promise<string>>>): Promise<string[]> {\n  const dirs: Record<string, Record<string, string>> = {};\n  const read = async ([path, load]: [string, () => Promise<string>]) => {\n    const [dir, file] = path.split('/').slice(-2);\n    (dirs[dir] ??= {})[file] = await load();\n  };\n  await Promise.all(Object.entries(files).map(read));\n  const ids = Object.keys(dirs)\n    .sort()\n    .map((dir) => defineClipSet(clipSetFromFiles(dirs[dir], `data/anim/sets/${dir}`)).id);\n  defineMannequin(getClipSet('clipset:quaternius'));\n  return ids;\n}\n\n/** Registers the mannequin, its build and body, from the Quaternius set's `_set.json` text (the page's `?raw`). */\nexport function loadMannequin(text: string): void {\n  defineMannequin(JSON.parse(text) as Parameters<typeof defineMannequin>[0]);\n}\n\n/**\n * Registers the clip `name` from its edited `text` as the set `set` of its own, with the sources of the set `from`\n * (`clipset:cmu`), and returns the clip's path to play (`lab1/<name>`). Throws what `parseClip` throws for bad text.\n */\nexport function registerEdit(set: string, from: string, name: string, text: string): string {\n  defineClipSet({ set, sources: getClipSet(from).sources, clips: { [name]: parseClip(text, name) } });\n  return `${set.toLowerCase()}/${name}`;\n}\n    type: 'object',\n    default: defaultsOf(FLAME_FIELDS),\n    description:\n      'Drawn as flame tongues dancing round its origin (its geometry a cone 1 m high), or still (tongues 0).',\n    properties: FLAME_FIELDS,\n  },\n} as const satisfies Schema;\n\n/** The physics shapes a prop's body may have, sized as three.js sizes its geometries. */\nexport const PROP_SHAPES = ['box', 'cylinder', 'ball', 'capsule'] as const;\n\n/** The fields of a prop's body: its type, its shape and its material (engine/physics/bodies.ts's PROP_MATERIAL). */\nconst BODY_FIELDS = {\n  type: {\n    type: 'string',\n    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n    default: 'none',\n    description:\n      \"'dynamic' falls, slides and is knocked; 'fixed' stands where it is placed and blocks; 'kinematic' moves only as the sim drives it (a door on its hinge, WP 13.16); 'none' has none.\",\n  },\n  shape: { type: 'string', enum: PROP_SHAPES, default: 'box', description: 'Its shape.' },\n  size: vec3([1, 1, 1], \"A box's width, height and depth.\"),\n  radius: metres(0.5, \"A cylinder's, ball's or capsule's radius.\"),\n  height: metres(1, \"A cylinder's height, or a capsule's straight middle.\"),\n  density: {\n    type: 'number',\n    default: 57,\n    minimum: 0,\n    unit: 'kg/m³',\n    description: \"A hollow crate's: 24 kg at 0.75 m.\",\n  },\n  friction: { type: 'number', default: 0.7, minimum: 0, description: 'Coulomb friction.' },\n  restitution: { type: 'number', default: 0.05, minimum: 0, maximum: 1, description: 'Bounciness, 0 to 1.' },\n  linearDamping: { type: 'number', default: 0.3, minimum: 0, unit: '1/s', description: 'Slows its sliding.' },\n  angularDamping: { type: 'number', default: 0.8, minimum: 0, unit: '1/s', description: 'Slows its rolling.' },\n} as const satisfies Schema;\n\n/** The fields of a prop's light spot, as three.js's `PointLight` takes them. */\nconst LIGHT_FIELDS = {\n  tag: { type: 'string', default: '', description: \"What kind of light it is ('torch'); '' for none.\" },\n  color: { type: 'string', default: '#ffffff', description: 'Its colour, hex.' },\n  intensity: { type: 'number', default: 1, minimum: 0, description: \"Its intensity, three.js's.\" },\n  distance: metres(0, 'Where it fades out; 0 for no limit.'),\n  decay: { type: 'number', default: 2, minimum: 0, description: 'How it dims with distance (2: physically).' },\n  position: vec3([0, 0, 0], \"Where it shines from, in the prop's frame.\"),\n  flicker: { type: 'boolean', default: false, description: \"Whether it flickers as a flame does (gfx's FLICKER).\" },\n} as const satisfies Schema;\n\n/** The fields of what breaking a prop leaves (WP 13.16). */\nconst BREAK_FIELDS = {\n  into: { type: 'string', default: '', description: \"The prop its pieces are ('prop:<id>', dynamic); '' none.\" },\n  pieces: { type: 'integer', default: 0, minimum: 0, maximum: 16, description: 'How many pieces it leaves.' },\n  shards: {\n    type: 'string',\n    default: '',\n    description: \"The event it breaks with, its look ('glass', 'splinters'); '' shatter.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of where a level places a prop. */\nconst PLACE_FIELDS = {\n  spawn: {\n    type: 'string',\n    default: '',\n    description: \"The spawn name whose points place it, on their floor (a glyph with spawn: 'crate'); '' none.\",\n  },\n  light: {\n    type: 'string',\n    default: '',\n    description: \"The light-spot tag whose spots place it, on the top of the spot's tile ('torch'); '' none.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of a `prop` entry. */\nexport const PROP_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is, in plain sentences.' },\n  parts: {\n    type: 'array',\n    items: { type: 'object', properties: PROP_PART_FIELDS },\n    default: [],\n    description: 'Its meshes: { name, geometry, params, material, top, tint, position, rotation, shadow, flame }.',\n  },\n  body: {\n    type: 'object',\n    default: defaultsOf(BODY_FIELDS),\n    description: 'Its body in the physics world, standing on its base: { type, shape, size, radius, height, … }.',\n    properties: BODY_FIELDS,\n  },\n  light: {\n    type: 'object',\n    default: defaultsOf(LIGHT_FIELDS),\n    description: \"Its light spot, for the light pool (WP 7.1): { tag, color, intensity, … }; tag '' for none.\",\n    properties: LIGHT_FIELDS,\n  },\n  place: {\n    type: 'object',\n5: * (silhouette layers round the horizon), a sun (a `DirectionalLight` the dome agrees with), the ambient light and fog\n25: * lights in id order (the pool, the ambient light, then the sun), and a light made later belongs after them in the\n75:export { defineSkies, defineSky, SKY_FIELDS, type BackdropSpec, type SkyEntry, type SkySpec } from './skyKind';\n81:  readonly sun: DirectionalLight;\n223:  // In id order (the pool's lights, the ambient light, the sun): see the file comment.\n232:  let split: Casters = { sun: false, points: 0 };\n234:    split = splitCasters(casters, { sun: preset.sun.intensity > 0, points: preset.pointLights > 0 });\n254:      atmosphere.set({ fog: preset.fog, ambient: preset.ambient });\nengine/gfx/post/filterSchema.ts:5: * pairs; the filters that act on the camera or the screen take only `off` and `all`), an `amount` (how much of it\nengine/gfx/post/filterSchema.ts:15: * @see engine/gfx/post/filters.test.ts\nengine/gfx/post/filterSchema.ts:35:/** The scopes of the filters that cover the whole screen. */\nengine/gfx/post/filterChecks.ts:2: * @file The filter chain's checks (PLAN.md WP 7.4; split from engine/gfx/post/filters.ts at its size cap in WP 13.24):\nengine/gfx/post/filterChecks.ts:6: * reports (engine/gfx/post/looks.ts) and as fixes the chain applies to the setting `post.filters`, a layer over a look,\nengine/gfx/post/filterChecks.ts:7: * reporting what it fixed (engine/gfx/post/chain.ts). filters.ts re-exports them.\nengine/gfx/post/filterChecks.ts:12: * levelsProblem(4, 'filters.palette.levels'); // '… posterize with 0 (off) or 8 levels and more …'\nengine/gfx/post/filterChecks.ts:15: * @see engine/gfx/post/filters.test.ts\nengine/gfx/post/filterChecks.ts:18:import { FILTER_FIELDS, type FilterSpec } from './filters';\nengine/gfx/post/filterChecks.ts:44: * Every colour field of the filters (the fields whose unit is `COLOR_UNIT`), as `[filter, field, empty]`: `empty`\nengine/gfx/post/filterChecks.ts:58: * `post.filters`) is fixed and reported this way.\nengine/gfx/post/filterChecks.ts:76: * (the setting `post.filters`) is fixed and reported this way; looks are checked when they are defined.\nengine/gfx/post/snap.ts:14: * resolution), and says where: the whole blocks the camera stands at (`cells`, across and down the screen, which a\nengine/gfx/post/snap.ts:17: * picture (engine/gfx/resolution.ts `shift`), so the snapped picture still glides as the camera does.\nengine/gfx/post/resolveLook.ts:5: * (`combineChain`, engine/gfx/post/combine.ts), the looks `post.combine` lays over it, then `post.filters` laid over\nengine/gfx/post/resolveLook.ts:12: * `post.filters` and `post.strength` stay the same it gives the same objects, so the chain sees a change by identity\ne