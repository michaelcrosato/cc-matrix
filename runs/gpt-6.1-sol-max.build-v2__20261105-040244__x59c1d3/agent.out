members.ts-133-  /** The downgrades taken, as advice codes. */\nengine/dev/members.ts-134-  readonly downgrades: readonly string[];\nengine/dev/members.ts-135-  /** Runs `n` sim steps through the clock, with one intents object for every step, one per step, or (undefined) the virtual device's. */\nengine/dev/members.ts-136-  step(n: number, intents: unknown): void;\nengine/dev/members.ts-137-  /** Starts the scene again with `seed`, keeping the settings changed since it started. */\nengine/dev/members.ts-138-  restart(seed: number): void;\nengine/dev/members.ts-139-}\nengine/dev/members.ts-140-\nengine/dev/members.ts-141-/** How a member is written: `defineMember(name, spec)` or `def('inspectorMember', name, spec)`. */\nengine/dev/members.ts-142-export interface MemberSpec {\nengine/dev/members.ts-143-  /** What it does, one line: `help()` prints it after the signature. */\nengine/dev/members.ts-144-  help: string;\nengine/dev/members.ts-145-  /** Its arguments in call order, name → schema field. */\nengine/dev/members.ts-146-  args?: Schema;\nengine/dev/members.ts-147-  /** The work: the host, then the checked arguments; returns plain data. */\nengine/dev/members.ts-148-  impl: (host: InspectorHost, ...args: never[]) => unknown;\nengine/dev/members.ts-149-  /** What the host must have: `renderer` members throw `DEV_NO_RENDERER` without one (`sim` by default). */\nengine/dev/members.ts-150-  needs?: 'sim' | 'renderer';\n--\nengine/dev/inspector.ts:69:  adapter: Readonly<Record<string, unknown>> | null;\nengine/dev/inspector.ts-70-  features: string[];\nengine/dev/inspector.ts-71-  downgrades: string[];\nengine/dev/inspector.ts-72-  /** The runtime dependencies and their pinned versions. */\nengine/dev/inspector.ts-73-  deps: Record<string, string>;\nengine/dev/inspector.ts-74-  scene: string;\nengine/dev/inspector.ts-75-  seed: number;\nengine/dev/inspector.ts-76-  tick: number;\nengine/dev/inspector.ts-77-  hz: number;\nengine/dev/inspector.ts-78-}\nengine/dev/inspe