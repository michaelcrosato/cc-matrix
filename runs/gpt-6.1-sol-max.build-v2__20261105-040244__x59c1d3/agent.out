-size:clamp(18px,3vw,28px);line-height:1.5;color:#a4bbb5\\\">Open it in a WebGPU-enabled browser to begin the shift.</p>'+(touch?'<h2 style=\\\"font-size:28px\\\">Controller or keyboard required</h2>':'')+'<button id=\\\"compat-settings\\\" style=\\\"font-size:24px;padding:16px 32px;background:#a3edcf;color:#10333b;border:0;margin-top:30px;cursor:pointer\\\">Settings</button></div>';\n  document.body.append(el);\n  document.getElementById('compat-settings').onclick=function(){el.innerHTML='<div><h1 style=\\\"font-size:40px\\\">Settings</h1><p style=\\\"font-size:24px\\\">Display: WebGPU required</p><p style=\\\"font-size:24px\\\">Music: 10% · Effects: 100%</p><p style=\\\"font-size:22px\\\">Controller or keyboard required</p><button id=\\\"compat-back\\\" style=\\\"font-size:24px;padding:18px 32px\\\">Back</button></div>';document.getElementById('compat-back').onclick=function(){el.remove();show();};};\n  if(window.AIHub&&AIHub.active&&\"'!reported){reported=true;AIHub.fail('\"'WebGPU is required for Trauma Coast: Second Sight.');}\n }\n if(window.__unsupported){if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',show);else show();}\n const check=setInterval(function(){const errors=window.__engine&&window.__engine.errors;if(errors&&errors.some(e=>e.code==='GFX_NO_WEBGPU')){show();clearInterval(check);}},200);\n window.addEventListener('pagehide',()=>clearInterval(check),{once:true});\n})();\n</script>\n<style>html,body{margin:0;background:#071b22} .no-gpu #app,.no-gpu canvas,.no-gpu [data-engine-error]{display:none\"'!important}</style>\n</head><body>\n<canvas id=\"view\" aria-label=\"The 3D Harbor Light operating theatre\"></canvas>\n<main id=\"app\"><div id=\"panels\"></div><div id=\"hud\"></div><div id=\"radial\" class=\"radial\"></div><div id=\"drama\" class=\"drama\"><b></b></div><div id=\"touch-gate\"></div><div id=\"boot\" class=\"boot\"><svg viewBox=\"0 0 64 64\"><path d=\"M22 52h20L38 24H26l-4 28ZM25 18h14v7H25zM21 18l11-9 11 9M14 55h36M4 17h13m30 0h13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><p>PREPARING THE THEATRE</p></div></main>\n<script type=\"module\" src=\"./main.ts\"></script>\n</body></html>'\"'''\nPath('labs/game/index.html').write_text(head)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"rg --files tools/templates | rg camera; sed -n '1,150p' engine/gfx/cameras/kinds.ts; sed -n '24,68p' engine/gfx/cameras/follow.ts; cat labs/game/best.ts | tail -35\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"rg --files tools/templates | rg camera; sed -n '1,150p' engine/gfx/cameras/kinds.ts; sed -n '24,68p' engine/gfx/cameras/follow.ts; cat labs/game/best.ts | tail -35\"","aggregated_output":"tools/templates/camera/camera.ts.tmpl\ntools/templates/camera/camera.test.ts.tmpl\ntools/templates/camera/template.json\nsed: can't read engine/gfx/cameras/kinds.ts: No such file or directory\n * and never stands in a wall; held off its arm, it looks off its view toward the pivot (`FollowState.aim`), turning\n * that look at most `FOLLOW_RIG.aim` rad/s, right over it straight down and half as fast again (WP 13.27: indoors,\n * where the walls keep it from behind him).\n *\n * Invariants: with `queries` and the eye at least `COLLIDE_RADIUS` from every wall, the camera's ball never ends\n * inside one; the pivot's height is within `FOLLOW_RIG.zone` of the feet's ground; the pitch within `FOLLOW_LIMITS.pitch`.\n * Pure: each step returns a new state.\n *\n * Codes: `cam3=follow[,<yaw>,<pitch>,<distance>]` (degrees, metres); a bare one keeps the last camera's heading.\n *\n * @example\n * const follow = createFollowCamera();\n * follow.update({ follow: [0, 0, 0] }).position; // [0, 3.40…, -5.16…]: 5.5 m back from his eye, 20° down\n * follow.code(); // 'cam3=follow,0,-20,5.5'\n * @see engine/gfx/cameras/follow.test.ts\n */\nimport { MathUtils } from '../../core/math';\nimport { codeDegrees, codeNumber, followCamera, readCode, type CodePart, type FollowCamera } from './chase';\nimport { carry, COLLIDE_PULL, COLLIDE_RADIUS, follow, moveCamera, reach, type CameraBall, type Walls } from './collide';\nimport type { CameraPlayer, EffectWeights } from './effects';\nimport { ORBIT_ZOOM_STEP } from './orbit';\nimport { approach, makePose, poseForward, rangeProblems, refuse, wrapAngle, type CameraInput, type CameraPose, type Vec3 } from './pose'; // prettier-ignore\n\nconst DEG = MathUtils.DEG2RAD;\n\n/** The rig's numbers (see the file comment): metres, seconds, rad/s; `lens` its lens, degrees. */\nexport const FOLLOW_RIG = Object.freeze({\n  pitch: -20 * DEG,\n  back: 5.5,\n  height: 1.524,\n  idle: 1.5,\n  moving: 0.5,\n  ease: 0.6,\n  recentre: 1.5,\n  ahead: 1,\n  run: 5,\n  lead: 0.5,\n  zone: 1.5,\n  settle: 0.3,\n  lag: 0.1,\n  trail: 0.5,\n  lift: 50 * DEG,\n  raise: 1.5,\n  lower: 0.6,\n  room: 0.25,\n/**\n * @file The starter game's best round (PLAN.md WP 10.9): the fastest round won, kept across sessions in the engine's\n * store (engine/app/store.ts) under the game's own prefix. `bestOf(store)` reads it (null before a first win) and\n * `recordBest(store, seconds)` keeps a time that beats it, returning the best after. The page (labs/game/main.ts)\n * records each won round's time and shows the best in the HUD; a replay's page opens the store in its `demo` mode, so\n * a replay never sets a best.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts).\n *\n * @example\n * import { createStore } from '../../engine';\n * const store = createStore({ mode: 'demo' }); // in memory: nothing kept past the page\n * [recordBest(store, 14.2), recordBest(store, 16), recordBest(store, 9.5), bestOf(store)]; // [14.2, 14.2, 9.5, 9.5]\n * @see labs/game/best.test.ts\n */\nimport type { Store } from '../../engine';\n\n/** The key the best round is kept under. */\nexport const BEST_KEY = 'best';\n\n/** The fastest won round kept (s), or null: none yet, or a value that is no time. */\nexport function bestOf(store: Store): number | null {\n  const best = store.get<unknown>(BEST_KEY, null);\n  return typeof best === 'number' && best > 0 ? best : null;\n}\n\n/** Keeps `seconds` when it beats the best kept; returns the best after. */\nexport function recordBest(store: Store, seconds: number): number {\n  const best = bestOf(store);\n  if (best !== null && best <= seconds) return best;\n  store.set(BEST_KEY, seconds);\n  return seconds;\n}\n","exit_code":0,"status":"completed"}}
