{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"sed -n '40,84p' engine/physics/bodies.ts; sed -n '103,155p' engine/input/input.ts; sed -n '38,65p' engine/dev/actions.ts; rg -n \\\"engine.*errors|GFX_NO_WEBGPU|warmUp\\\" engine/app/engine.ts\"","aggregated_output":"import { codeError } from '../core/log';\nimport { Quaternion, Vector3 } from '../core/math';\nimport { copyValue, defineSchema, freezeValue, isPlainObject, show } from '../core/schema';\nimport { bodyId, liveBody } from './capture';\nimport type { GroupName } from './groups';\nimport { check, quat, vec, type HullShape, type QuatLike, type Shape, type Vec3Like } from './queries';\nimport { rapierOf, type BodySpec, type Physics } from './world';\n\n/**\n * The props' material: a hollow wooden crate's (24 kg at 0.75 m), Coulomb friction, a little bounce, and damping that\n * lets a knocked prop slide and roll to rest. The prototype's 0.5 a cubic unit, its hero 2,500, gives 57 kg/m³.\n */\nexport const PROP_MATERIAL = Object.freeze({\n  /** kg/m³. */\n  density: 57,\n  friction: 0.7,\n  restitution: 0.05,\n  /** Per second. */\n  linearDamping: 0.3,\n  /** Per second. */\n  angularDamping: 0.8,\n});\n\n/** A prop as `addProp` takes it: a body's pose, velocities and options, and its material. */\nexport interface PropSpec extends Omit<BodySpec, 'type' | 'colliders'> {\n  /** kg/m³ (`PROP_MATERIAL`'s). */\n  density?: number;\n  friction?: number;\n  restitution?: number;\n}\n\n/** The Rapier body of `id`, or throws `PHYSICS_NO_BODY`. */\nfunction rigid(physics: Physics, id: number): RAPIER.RigidBody {\n  const found = liveBody(rapierOf(physics), id);\n  if (found) return found;\n  const why = Number.isInteger(id) && id >= 0 ? ': it was removed, or never added' : ': ids are whole numbers from 0';\n  throw codeError('PHYSICS_NO_BODY', { id: show(id), why });\n}\n\n/** A finite number, or the fallback; throws `PHYSICS_BAD_ARGUMENT`. */\nfunction finite(value: number | undefined, fallback: number, where: string): number {\n  check(value === undefined || Number.isFinite(value), where, value, 'a finite number');\n  return value ?? fallback;\n}\n\nexport interface Input {\n  /** The bindings of the map in use: rebind, reset, labels. */\n  readonly bindings: Bindings;\n  /** Switches to the action map `map` (an id, its bindings made and saved as the first's, or bindings); returns them. */\n  use(map: string | Bindings): Bindings;\n  /** The bindings of the action map `map` (an id), made and saved as the first's, without switching to them. */\n  bindingsFor(map: string): Bindings;\n  /** The virtual device, merged into every sample (`__engine.input` drives it). */\n  readonly virtual: VirtualDevice;\n  /** The mouse (pointer lock, pointer), when there is a page. */\n  readonly mouse: MouseDevice | undefined;\n  /** Fingers (touch mode, the stick, the buttons under them), when there is a page. */\n  readonly touch: TouchDevice | undefined;\n  /** The device used last: prompts follow it. */\n  readonly lastDevice: DeviceKind;\n  /**\n   * One frame's intents (unnormalized) at the frame's timestamp `now` (ms): see the file comment. Every action also\n   * binds `touch:<action>` (WP 3.12), and the touch stick adds to the move axes before `fromCamera` clamps them to\n   * length 1. A code a held binding waits on (engine/input/codes.ts `Hold:<code>`, WP 13.20) is held back as it goes\n   * down: let go before `HOLD_TIME`, it taps (its plain actions pressed at the next sample, never held); kept down, its\n   * held binding's actions press and hold until it goes up, and its plain ones never see it. The time is `now`, or a\n   * 60 Hz frame a sample without one; such a code is digital, its analog strength unread.\n   */\n  sample(camera?: CameraLike, now?: number): Record<string, unknown>;\n  /** Whether `action` (either layer) was held at the last sample. */\n  held(action: string): boolean;\n  /** Whether `action` (either layer) was pressed at the last sample. */\n  pressed(action: string): boolean;\n  /** How far `action` was pushed at the last sample, 0 to 1. */\n  strength(action: string): number;\n  /** What the camera takes since the last call (mouse look, right stick, wheel); then zero. */\n  camera(): CameraInputSample;\n  /** The label of `action`'s binding on the device used last: `Space`, `A`, `LMB`. */\n  prompt(action: string): string;\n  /** The next code pressed on `device`'s family, swallowed; null when Escape cancels or another listen starts. */\n  listen(device: 'keyboard' | 'gamepad'): Promise<string | null>;\n  /** Lets go of everything held and drops pending presses. */\n  clear(): void;\n  /** Removes every listener. */\n  dispose(): void;\n}\n\n/** The look settings' defaults: what `camera()` scales by without `options.look`. */\nconst DEFAULT_LOOK = lookOptions(() => undefined);\n\n/** Makes the page's input. */\nexport function createInput(options: InputOptions = {}): Input {\n  const made = (map: string | Bindings) => (typeof map === 'object' ? map : createBindings(map, options));\n  let bindings = made(options.map ?? 'actionMap:thirdPerson');\n  const known = new Map<string, Bindings>([[bindings.map.id, bindings]]);\n  const scope = globalThis as { window?: EventTarget; document?: InputOptions['document'] & { body?: EventTarget } };\n  const win = options.window ?? scope.window;\n  const doc = options.document ?? scope.document;\n  name: string;\n  /** Whose it is: the scene's own, or the engine's. */\n  from: 'scene' | 'engine';\n  /** What it changes: `sim` (recorded as a dev action), or `settings` alone (recorded as set, but view ones). */\n  changes: 'sim' | 'settings';\n  /** Its help line and its arguments (`at, yaw?, id?`), the engine's only. */\n  help?: string;\n  args?: string;\n}\n\n/** An action's arguments as a list reads them: `at, yaw?, id?`, defaults shown. */\nconst argsLine = (args: Schema) =>\n  Object.entries(args)\n    .map(([key, field]: [string, Field]) =>\n      field.required ? key : field.default === undefined ? `${key}?` : `${key} = ${JSON.stringify(field.default)}`,\n    ) // prettier-ignore\n    .join(', ');\n\ndefineMember('actions.list', {\n  help: \"Lists the run's dev actions: the scene's own, then the engine's (god, freeze, spawn, travel, timeScale).\",\n  impl(h): ActionRow[] {\n    const own = Object.keys(h.session.scene.actions ?? {}).sort();\n    const scene = own.map((name): ActionRow => ({ name, from: 'scene', changes: 'sim' }));\n    const engine = listDevActions(h.registry)\n      .filter((action) => !own.includes(action.id))\n      .map((action): ActionRow => ({ name: action.id, from: 'engine', changes: changesSim(action) ? 'sim' : 'settings', help: action.help, args: argsLine(action.args) })); // prettier-ignore\n    return [...scene, ...engine];\n  },\n8: * `post.show`; the look's sky and style, engine/app/look.ts), warms up every pipeline the view needs (`gfx.warmUp`,\n15: * error; every failure (a frame that throws stops the loop) is one record in `__engine.errors` (the log's), shown as\n17: * (`GFX_NO_WEBGPU`) the sim still runs, and `__engine` still steps it; only `render` and `shot` throw.\n99:    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"rg -n -A35 'export interface BodySpec' engine/physics/world.ts; sed -n '88,109p' engine/physics/bodies.ts; sed -n '40,85p' engine/gfx/cameras/fixed.ts; sed -n '188,214p' engine/input/actionMaps.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"rg -n -A35 'export interface BodySpec' engine/physics/world.ts; sed -n '88,109p' engine/physics/bodies.ts; sed -n '40,85p' engine/gfx/cameras/fixed.ts; sed -n '188,214p' engine/input/actionMaps.ts\"","aggregated_output":"113:export interface BodySpec {\n114-  /** `'dynamic'` (the default), `'fixed'` or `'kinematic'` (moved by the velocity code gives it). */\n115-  type?: BodyType;\n116-  position?: Vec3Like;\n117-  rotation?: QuatLike;\n118-  /** Linear velocity (m/s). */\n119-  velocity?: Vec3Like;\n120-  /** Angular velocity (rad/s). */\n121-  angularVelocity?: Vec3Like;\n122-  /** Its colliders, at least one for a body that should touch anything. */\n123-  colliders?: readonly ColliderSpec[];\n124-  /** Its colliders' group: `prop` for a dynamic body, `world` for the others, by default. */\n125-  group?: GroupName;\n126-  linearDamping?: number;\n127-  angularDamping?: number;\n128-  /** Continuous collision detection, for fast small bodies. */\n129-  ccd?: boolean;\n130-  /** Whether it may fall asleep when it rests (true). */\n131-  canSleep?: boolean;\n132-  /** How much of the world's gravity it feels (1). */\n133-  gravityScale?: number;\n134-  /** Solver passes beyond the pinned ones for its island (0): a ragdoll's joints hold better (engine/physics/ragdoll.ts). */\n135-  solverIterations?: number;\n136-}\n137-\n138-/** A body's state, copied: changing it changes nothing. */\n139-export interface BodyState {\n140-  id: number;\n141-  type: BodyType;\n142-  position: Vector3;\n143-  rotation: Quaternion;\n144-  velocity: Vector3;\n145-  angularVelocity: Vector3;\n146-  sleeping: boolean;\n147-  /** kg. */\n148-  mass: number;\n  const { density, friction, restitution, ...body } = spec;\n  const m = PROP_MATERIAL;\n  return physics.addBody({\n    ...body,\n    type: 'dynamic',\n    linearDamping: body.linearDamping ?? m.linearDamping,\n    angularDamping: body.angularDamping ?? m.angularDamping,\n    colliders: [\n      {\n        shape,\n        density: density ?? m.density,\n        friction: friction ?? m.friction,\n        restitution: restitution ?? m.restitution,\n      },\n    ],\n  });\n}\n\n/** Adds a box prop, sized as BoxGeometry (full width, height, depth); returns its id. */\nexport function addBox(physics: Physics, size: Vec3Like, spec?: PropSpec): number {\n  return addProp(physics, { type: 'box', size }, spec);\n}\nexport interface FixedState {\n  readonly position: Vec3;\n  readonly yaw: number;\n  readonly pitch: number;\n  readonly fov: number;\n}\n\n/** Options for a fixed camera: its code's data, and the pose to fix when the code has no position. */\nexport interface FixedOptions extends Omit<FreeSpec, 'type'> {\n  readonly from?: CameraPose;\n}\n\n/** A checked fixed state for `options`: the code's place, else `from`'s, else the origin at eye height. */\nexport function fixedState(options: FixedOptions = {}): FixedState {\n  const lens = options.from?.projection === 'perspective' ? options.from.fov : FLY_FOV;\n  const fov = options.fov ?? lens;\n  const start = options.position ? null : options.from ? perspectiveFrom(options.from, fov) : null;\n  const state: FixedState = {\n    position: [...(options.position ?? start?.position ?? [0, 1.7, 0])],\n    yaw: options.yaw ?? start?.yaw ?? 0,\n    pitch: options.pitch ?? start?.pitch ?? 0,\n    fov,\n  };\n  refuse('the fixed camera', [\n    ...pointProblems('position', state.position),\n    ...rangeProblems({\n      yaw: [state.yaw, -1e6, 1e6],\n      pitch: [state.pitch, -Math.PI / 2, Math.PI / 2],\n      fov: [fov, 1, 179],\n    }),\n  ]);\n  return state;\n}\n\n/** Steps a fixed camera: only `input.zoom` changes it (its lens). */\nexport function stepFixed(state: FixedState, input: CameraInput): FixedState {\n  return input.zoom ? { ...state, fov: MathUtils.clamp(state.fov - input.zoom * 5, ...FLY_FOV_RANGE) } : state;\n}\n\n/** The fixed camera's pose. */\nexport function fixedPose(state: FixedState): CameraPose {\n  return makePose({\n    position: state.position,\n    yaw: state.yaw,\n    pitch: state.pitch,\n    fov: state.fov,\n  values?: Readonly<Record<string, string>>;\n  look?: boolean;\n  aimWith?: AimRule;\n  lock?: boolean;\n  view?: readonly string[];\n  reserved?: readonly string[];\n}\n\n/** Registers an action map (on the shared registry by default). Throws `CORE_BAD_SPEC` naming each problem. */\nexport function defineActionMap(id: string, spec: ActionMapSpec, registry: Registry = sharedRegistry): ActionMap {\n  actionMapKind(registry);\n  return registry.def('actionMap', id, spec as unknown as Record<string, unknown>) as ActionMap;\n}\n\n/** The action map `id`. Throws `CORE_NO_ENTRY` naming the closest ids. */\nexport function getActionMap(id: string, registry: Registry = sharedRegistry): ActionMap {\n  actionMapKind(registry);\n  return registry.get('actionMap', id) as ActionMap;\n}\n\n/** Every action map, sorted by id. */\nexport function listActionMaps(registry: Registry = sharedRegistry): ActionMap[] {\n  actionMapKind(registry);\n  return registry.list('actionMap') as ActionMap[];\n}\n\n/** Walking on WASD, the arrows, the d-pad and the left stick: every preset's `move` actions. */\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/main.ts');s=p.read_text().replace('actOn,addBox,physicsOf','actOn,physicsOf').replace(\\\"addBox(physicsOf(w),[0,-.5,0],[50,1,50],{type:'fixed'});\\\", \\\"physicsOf(w).addBody({type:'fixed',position:[0,-.5,0],colliders:[{shape:{type:'box',size:[50,1,50]}}]});\\\");p.write_text(s)\nPath('labs/game/app/director.ts').write_text('''/** @file DOM-free story flow, case unlocks, score records, postcards and replayable Free Surgery. */\nimport {CASES} from '../data/cases';\nimport {storyFor} from '../data/story';\nimport type {Operation} from '../data/types';\nimport {rank} from '../scenes/op/state';\nexport type Screen='title'|'board'|'postcards'|'story'|'briefing'|'op'|'debrief'|'postcard'|'failed'|'credits'|'pause'|'settings'|'handbook'|'scrub'|'about'|'dev';\nexport interface Progress {unlocked:number;ended:boolean;ranks:Record<string,string>;postcards:Record<string,string>;checkpoint:{caseIndex:number;phase:number}|null;}\nexport const freshProgress=():Progress=>({unlocked:1,ended:false,ranks:{},postcards:{},checkpoint:null});\nexport class Director{\n screen:Screen='title';previous:Screen='title';caseIndex=0;part:'before'|'after'='before';beat=0;free=false;last:Operation|null=null;revision=0;\n progress:Progress;onChange:(run?:string,phase?:number)=>void;\n constructor(progress=freshProgress(),onChange:(run?:string,phase?:number)=>void=()=>{}){this.progress=progress;this.onChange=onChange;}\n go(screen:Screen,run?:string,phase=0):void{this.screen=screen;this.revision++;this.onChange(run,phase);}\n story(part:'before'|'after'):void{this.part=part;this.beat=0;this.go('story',\"'`story:${this.caseIndex}:${part}`);}\n newShift():void{this.caseIndex=0;this.free=false;this.story('\"'before');}\n advanceStory():void{\n  const story=storyFor(this.caseIndex,this.part);if(++this.beat<story.beats.length){this.revision++;return;}\n  if(this.part==='before')this.go('briefing');else if(this.caseIndex===7){this.progress.ended=true;this.progress.unlocked=8;this.go('credits','title');}else{this.caseIndex++;this.story('before');}\n }\n skipStory():void{this.beat=storyFor(this.caseIndex,this.part).beats.length;this.advanceStory();}\n start(phase=0):void{this.go('op',\"'`op:${CASES[this.caseIndex]?.id??'\"'gala-shift'}\"'`,phase);}\n finish(s:Operation,allowSave=true):void{\n  this.last=s;if(s.status!=='\"'won'){this.go('failed');return;}\n  if(allowSave&&\"'!s.dev){const r=rank(s),id=s.caseId,order=['\"'C','B','A','S','★'];if(order.indexOf(r)>order.indexOf(this.progress.ranks[id]??''))this.progress.ranks[id]=r;\n   const c=CASES.find(c=>c.id===id);if(c)this.progress.postcards[id]=c.postcard[Math.max(0,order.indexOf(r))]??c.postcard[3];\n   this.progress.unlocked=Math.min(8,Math.max(this.progress.unlocked,this.caseIndex+2));this.progress.checkpoint=null;\n  }this.go('debrief');\n }\n continueResult():void{if(this.screen==='debrief')this.go('postcard');else if(this.free||this.caseIndex===8)this.go('board','title');else this.story('after');}\n}\n''')\nPath('labs/game/app/settings.ts').write_text('''/** @file Accessible player preferences, isolated from deterministic operation balance. */\nimport type {Difficulty} from '../data/types';\nexport interface Preferences {master:number;music:number;effects:number;voice:number;glyphs:'PlayStation'|'Xbox';difficulty:Difficulty;simpleGift:boolean;hints:boolean;auto:boolean;textSpeed:number;textSize:number;blood:'red'|'teal'|'off';flashes:boolean;assist:boolean;toggleUse:boolean;cursorSpeed:number;}\nexport const defaultPreferences=():Preferences=>({master:.7,music:.1,effects:1,voice:1,glyphs:'PlayStation',difficulty:'Resident',simpleGift:false,hints:true,auto:false,textSpeed:1,textSize:1,blood:'red',flashes:true,assist:true,toggleUse:false,cursorSpeed:13});\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/main.ts');s=p.read_text().replace('actOn,addBox,physicsOf','actOn,physicsOf').replace(\\\"addBox(physicsOf(w),[0,-.5,0],[50,1,50],{type:'fixed'});\\\", \\\"physicsOf(w).addBody({type:'fixed',position:[0,-.5,0],colliders:[{shape:{type:'box',size:[50,1,50]}}]});\\\");p.write_text(s)\nPath('labs/game/app/director.ts').write_text('''/** @file DOM-free story flow, case unlocks, score records, postcards and replayable Free Surgery. */\nimport {CASES} from '../data/cases';\nimport {storyFor} from '../data/story';\nimport type {Operation} from '../data/types';\nimport {rank} from '../scenes/op/state';\nexport type Screen='title'|'board'|'postcards'|'story'|'briefing'|'op'|'debrief'|'postcard'|'failed'|'credits'|'pause'|'settings'|'handbook'|'scrub'|'about'|'dev';\nexport interface Progress {unlocked:number;ended:boolean;ranks:Record<string,string>;postcards:Record<string,string>;checkpoint:{caseIndex:number;phase:number}|null;}\nexport const freshProgress=():Progress=>({unlocked:1,ended:false,ranks:{},postcards:{},checkpoint:null});\nexport class Director{\n screen:Screen='title';previous:Screen='title';caseIndex=0;part:'before'|'after'='before';beat=0;free=false;last:Operation|null=null;revision=0;\n progress:Progress;onChange:(run?:string,phase?:number)=>void;\n constructor(progress=freshProgress(),onChange:(run?:string,phase?:number)=>void=()=>{}){this.progress=progress;this.onChange=onChange;}\n go(screen:Screen,run?:string,phase=0):void{this.screen=screen;this.revision++;this.onChange(run,phase);}\n story(part:'before'|'after'):void{this.part=part;this.beat=0;this.go('story',\"'`story:${this.caseIndex}:${part}`);}\n newShift():void{this.caseIndex=0;this.free=false;this.story('\"'before');}\n advanceStory():void{\n  const story=storyFor(this.caseIndex,this.part);if(++this.beat<story.beats.length){this.revision++;return;}\n  if(this.part==='before')this.go('briefing');else if(this.caseIndex===7){this.progress.ended=true;this.progress.unlocked=8;this.go('credits','title');}else{this.caseIndex++;this.story('before');}\n }\n skipStory():void{this.beat=storyFor(this.caseIndex,this.part).beats.length;this.advanceStory();}\n start(phase=0):void{this.go('op',\"'`op:${CASES[this.caseIndex]?.id??'\"'gala-shift'}\"'`,phase);}\n finish(s:Operation,allowSave=true):void{\n  this.last=s;if(s.status!=='\"'won'){this.go('failed');return;}\n  if(allowSave&&\"'!s.dev){const r=rank(s),id=s.caseId,order=['\"'C','B','A','S','★'];if(order.indexOf(r)>order.indexOf(this.progress.ranks[id]??''))this.progress.ranks[id]=r;\n   const c=CASES.find(c=>c.id===id);if(c)this.progress.postcards[id]=c.postcard[Math.max(0,order.indexOf(r))]??c.postcard[3];\n   this.progress.unlocked=Math.min(8,Math.max(this.progress.unlocked,this.caseIndex+2));this.progress.checkpoint=null;\n  }this.go('debrief');\n }\n continueResult():void{if(this.screen==='debrief')this.go('postcard');else if(this.free||this.caseIndex===8)this.go('board','title');else this.story('after');}\n}\n''')\nPath('labs/game/app/settings.ts').write_text('''/** @file Accessible player preferences, isolated from deterministic operation balance. */\nimport type {Difficulty} from '../data/types';\nexport interface Preferences {master:number;music:number;effects:number;voice:number;glyphs:'PlayStation'|'Xbox';difficulty:Difficulty;simpleGift:boolean;hints:boolean;auto:boolean;textSpeed:number;textSize:number;blood:'red'|'teal'|'off';flashes:boolean;assist:boolean;toggleUse:boolean;cursorSpeed:number;}\nexport const defaultPreferences=():Preferences=>({master:.7,music:.1,effects:1,voice:1,glyphs:'PlayStation',difficulty:'Resident',simpleGift:false,hints:true,auto:false,textSpeed:1,textSize:1,blood:'red',flashes:true,assist:true,toggleUse:false,cursorSpeed:13});\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/input/hands.ts <<'EOF'\n/** @file Native pointer aiming and independent standard-mapping gamepads, quantized into shared surgeon seats. */\nimport {defineActionMap,screenRay,onFloor,type EngineFrame,type Input} from '../../../engine';\nimport type {Hand,Operation,Point} from '../data/types';\nimport type {Preferences} from '../app/settings';\nimport {fieldHeight} from '../view/field/sheet';\nimport {clamp,distanceTo,nearest} from '../scenes/op/geometry';\nimport {RESPONSE,TOOLS} from '../data/tools';\nexport const MAP=defineActionMap('actionMap:surgeon',{description:'First-person twin-stick surgery.',lock:false,actions:{left:['KeyA','ArrowLeft','PadLeftStickLeft'],right:['KeyD','ArrowRight','PadLeftStickRight'],up:['KeyW','ArrowUp','PadLeftStickUp'],down:['KeyS','ArrowDown','PadLeftStickDown'],use:['Enter','MouseLeft','PadRightTrigger','PadSouth'],precision:['ShiftLeft','PadLeftTrigger'],gift:['Space','PadNorth'],syringe:['KeyF','PadWest'],drop:['KeyR','PadEast'],previous:['PadLeftShoulder','WheelUp'],next:['PadRightShoulder','WheelDown'],siteleft:['KeyQ','PadLeft'],siteright:['KeyE','PadRight'],hint:['KeyH','PadUp'],swap:['Tab','PadRightStick'],pause:['Escape','PadStart']}});\nexport class Hands{\n seats:Hand[]=[[0,0,3,0,0,0,0,0,0]];devices:(number|'keyboard')[]=['keyboard'];\n mouse:Point=[0,0];moved=false;buttons=new Set<number>();keys=new Set<string>();lastDevice:'mouse'|'keyboard'|'gamepad'='mouse';\n radial: {x:number;y:number;selected:number;pad:boolean}|null=null;\n previousPads:number[][]=[];onActivity:()=>void=()=>{};onPause:()=>void=()=>{};onHint:()=>void=()=>{};onMenu:(action:string)=>void=()=>{};onClaim:(device:number|'keyboard')=>void=()=>{};\n playing=false;touch=matchMedia('(any-pointer:fine)').matches===false;toggle=false;\n constructor(){\n  addEventListener('keydown',e=>{this.lastDevice='keyboard';this.touch=false;this.onActivity();if(e.repeat)return;this.keys.add(e.code);if(this.playing){if(e.code==='Tab'||e.code==='Space'||e.code.startsWith('Arrow'))e.preventDefault();if(/\"'^Digit[1-8]$/.test(e.code))this.seats[0][2]=Number(e.code.slice(5))-1;if(e.code==='\"'Space')this.seats[0][4]++;if(e.code==='KeyF')this.seats[0][2]=5;if(e.code==='KeyR')this.buttons.delete(0);if(e.code==='Tab')this.seats[0][7]++;if(e.code==='KeyQ')this.seats[0][6]--;if(e.code==='KeyE')this.seats[0][6]++;if(e.code==='KeyH')this.onHint();if(e.code==='Escape')this.onPause();if(e.code==='Enter')this.toggle=\"'!this.toggle;}\n   else{if(e.code==='\"'Enter')this.onClaim('keyboard');this.onMenu(e.code);}\n  });\n  addEventListener('keyup',e=>this.keys.delete(e.code));\n  addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;this.lastDevice='mouse';this.mouse=[e.clientX,e.clientY];this.moved=true;this.onActivity();if(this.radial&&\"'!this.radial.pad){const dx=e.clientX-this.radial.x,dy=e.clientY-this.radial.y;if(Math.hypot(dx,dy)>18)this.radial.selected=(Math.round((Math.atan2(dy,dx)+Math.PI/2)/(Math.PI/4))+8)%8;}});\n  addEventListener('\"'pointerdown',e=>{if(e.pointerType==='touch')return;this.lastDevice='mouse';this.buttons.add(e.button);this.onActivity();if(this.playing&&e.button===2){if(this.buttons.has(0))this.seats[0][5]++;else this.radial={x:e.clientX,y:e.clientY,selected:this.seats[0][2],pad:false};}if(this.playing&&e.button===0&&this.buttons.has(2))this.seats[0][5]++;});\n  addEventListener('pointerup',e=>{this.buttons.delete(e.button);if(e.button===2&&this.radial){this.seats[0][2]=this.radial.selected;this.radial=null;}});\n  addEventListener('contextmenu',e=>e.preventDefault());\n  addEventListener('wheel',e=>{if(this.playing){this.seats[0][2]=(this.seats[0][2]+(e.deltaY>0?1:7))%8;e.preventDefault();}this.onActivity();},{passive:false});\n  addEventListener('blur',()=>{this.keys.clear();this.buttons.clear();});\n }\n claim(device:number|'keyboard'):boolean{if(this.devices.includes(device)||this.devices.length===4)return false;this.devices.push(device);this.seats.push([0,0,3,0,0,0,0,0,0]);return true;}\n pollPads(dt:number,prefs:Preferences,s?:Operation):void{\n  for(const pad of navigator.getGamepads?.()??[]){if(\"'!pad?.connected)continue;const values=pad.buttons.map(b=>b.value),prev=this.previousPads[pad.index]??[];\n   const press=(n:number):boolean=>(values[n]??0)>.5&&(prev[n]??0)<=.5;\n   const active=values.some(v=>v>.1)||pad.axes.some(v=>Math.abs(v)>.2);\n   if(active){this.lastDevice='\"'gamepad';this.touch=false;this.onActivity();}\n   if(\"'!this.playing){if(press(0))this.onClaim(pad.index);for(const [i,action] of [[0,'\"'Enter'],[1,'Escape'],[3,'KeyT'],[9,'Escape'],[12,'ArrowUp'],[13,'ArrowDown'],[14,'ArrowLeft'],[15,'ArrowRight']] as [number,string][])if(press(i))this.onMenu(action);const y=pad.axes[1]??0;if(Math.abs(y)>.6&&Math.abs(prev[20]??0)<.6)this.onMenu(y>0?'ArrowDown':'ArrowUp');values[20]=y;}\n   else{\n    let index=this.devices.indexOf(pad.index);if(index<0&&this.devices.length===1&&this.devices[0]==='keyboard')index=0;if(index<0)continue;\n    const h=this.seats[index],x=pad.axes[0]??0,z=pad.axes[1]??0,lean=Math.hypot(x,z),precise=(values[6]??0)>.2;\n    if(lean>.15){const speed=prefs.cursorSpeed*Math.pow(Math.min(1,lean),2.2)*dt*(precise?.4:1);h[0]-=x/lean*speed;h[1]+=z/lean*speed;this.assist(h,s,precise,prefs);}\n    h[3]=Math.max(values[7]??0,values[0]??0)>.1?1:0;\n    if(s?.code&&values[6]>.5&&values[7]>.5&&((prev[6]??0)<=.5||(prev[7]??0)<=.5))h[5]++;\n    if(press(3))h[4]++;if(press(2))h[2]=5;if(press(4))h[2]=(h[2]+7)%8;if(press(5))h[2]=(h[2]+1)%8;if(press(14))h[6]--;if(press(15))h[6]++;if(press(12))this.onHint();if(press(11))h[7]++;if(press(9)&&values[8]<.5)this.onPause();\n    const rx=pad.axes[2]??0,ry=pad.axes[3]??0,rad=Math.hypot(rx,ry);\n    if(rad>.4){const selected=(Math.round((Math.atan2(ry,rx)+Math.PI/2)/(Math.PI/4))+8)%8;this.radial={x:innerWidth*.5,y:innerHeight*.55,selected,pad:true};h[8]=1;}else if(this.radial?.pad){h[2]=this.radial.selected;this.radial=null;h[8]=0;}\n    if(press(1)){h[3]=0;this.radial=null;h[8]=0;}\n   }\n   this.previousPads[pad.index]=values;\n  }\n }\n private assist(h:Hand,s:Operation|undefined,precision:boolean,prefs:Preferences):void{\n  if(\"'!s||!prefs.assist)return;const t=s.targets.filter(t=>!t.done&&t.site===h[6]&&RESPONSE[TOOLS[h[2]]][t.kind]==='\"'effect').sort((a,b)=>distanceTo(a,h[0],h[1])-distanceTo(b,h[0],h[1]))[0];\n  if(t&&distanceTo(t,h[0],h[1])<.65){const p=t.path.length?nearest(t.path,h[0],h[1]).point:[t.x,t.z];const factor=precision?.3:.12;h[0]+=(p[0]-h[0])*factor;h[1]+=(p[1]-h[1])*factor;}\n }\n frame(frame:EngineFrame,prefs:Preferences,s?:Operation,input?:Input):Hand[]{\n  this.pollPads(frame.dt,prefs,s);if(\"'!this.playing)return this.seats;\n  const h=this.seats[0];\n  if(this.lastDevice!=='\"'gamepad'&&this.devices[0]==='keyboard'){\n   if(this.moved){const ray=screenRay(frame.camera,[this.mouse[0]/innerWidth*2-1,1-this.mouse[1]/innerHeight*2],innerWidth/innerHeight);let p=onFloor(ray,0);if(p&&s){for(let i=0;i<3;i++)p=onFloor(ray,fieldHeight(p[0],p[2],s))??p;}if(p){h[0]=p[0];h[1]=p[2];}this.moved=false;}\n   const dx=(this.keys.has('KeyD')||this.keys.has('ArrowRight')?1:0)-(this.keys.has('KeyA')||this.keys.has('ArrowLeft')?1:0),dz=(this.keys.has('KeyS')||this.keys.has('ArrowDown')?1:0)-(this.keys.has('KeyW')||this.keys.has('ArrowUp')?1:0);\n   h[0]-=dx*prefs.cursorSpeed*frame.dt;h[1]+=dz*prefs.cursorSpeed*frame.dt;\n   h[3]=this.radial?0:prefs.toggleUse?(this.toggle?1:0):this.buttons.has(0)||input?.held('use')?1:0;h[8]=this.radial?1:0;\n  }\n  for(const hand of this.seats){hand[0]=clamp(hand[0],-7.2,7.2);hand[1]=clamp(hand[1],-3.4,3.4);if(s)hand[6]=(Math.round(hand[6])+(s.caseId==='gala-night'?3:3)*10)%((s.caseId==='crosstalk'||s.caseId==='gala-night')?3:(s.caseId==='reverie'||s.caseId==='gala-shift')?2:1);}\n  return this.seats;\n }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
