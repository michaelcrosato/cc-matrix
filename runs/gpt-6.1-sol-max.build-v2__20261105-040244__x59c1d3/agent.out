c.engine()?.inspector.camera as {set:(code:string)=>void})?.set(d.freeCamera?'cam3=fly':'cam3=fixed,0,15,-5,0,-72,42');}\n else if(id==='dev-look'){d.look=1-d.look;c.set('post.look',d.look?'look:harbor':'look:field');}\n else if(id==='dev-step')c.engine()?.inspector.step(1);\n else if(id==='dev-spawn-prev'||id==='dev-spawn-next')d.spawn=(d.spawn+(id.endsWith('prev')?KINDS.length-1:1))%KINDS.length;\n else if(id==='dev-spawn'){const p=c.hands.seats[0];c.act('surgery-spawn',{kind:KINDS[d.spawn],x:p[0],z:p[1],site:p[6]});}\n else if(id==='dev-seed'){d.seed++;c.engine()?.inspector.seed(d.seed);}\n else if(id==='dev-unlock'){c.d.progress.unlocked=8;c.d.progress.ended=true;c.save();}\n else if(id==='dev-author'){d.author=true;d.path=[];c.d.go('op');}\n else if(id==='dev-copy-path')void copyText(JSON.stringify(d.path));\n else if(id==='dev-copy-replay'){const input=c.engine()?.inspector.input as {record:()=>unknown};void copyText(JSON.stringify(input?.record(),null,2));}\n else if(id.startsWith('balance-reset:')){const k=id.split(':')[1];c.set(\"'`game.${k}`,BALANCE[k][0]);}\n else if(id==='\"'balance-reset-all')for(const [k,[value]] of Object.entries(BALANCE))c.set(\"'`game.${k}`,value);\n else return false;\n return true;\n}\nEOF\ncat > labs/game/ui/index.ts <<'\"'EOF'\n/** @file UI flow and common controller/mouse focus; every screen shares the same large interactive elements. */\nimport type {UIContext} from './context';\nimport type {Screen} from '../app/director';\nimport type {Preferences} from '../app/settings';\nimport {getCase} from '../data/cases';\nimport {TOOLS} from '../data/tools';\nimport {about,aboutCards,handbook,postcards} from './reference';\nimport {settingPage,cyclePreference} from './settings';\nimport {devPage,newDevView} from './dev';\nimport {developerAction} from './devActions';\nimport {Hud} from './hud';\nimport * as pages from './pages';\nexport class GameUI{\n c:UIContext;root:HTMLElement;hud:Hud;revision=-1;ref=0;settingsTab=0;rebindPage=0;dev=newDevView();rebinding=false;returnTo:Screen='title';\n constructor(c:UIContext){this.c=c;this.root=document.getElementById('panels')\"'!;this.hud=new Hud(document.getElementById('\"'hud')\"'!);\n  document.getElementById('\"'app')\"'!.addEventListener('\"'click',e=>{const target=e.target as Element,tool=target.closest<HTMLElement>('[data-tool]'),site=target.closest<HTMLElement>('[data-site]'),action=target.closest<HTMLElement>('[data-action]');if(tool){c.hands.seats[0][2]=Number(tool.dataset.tool);return;}if(site){c.hands.seats[0][6]=Number(site.dataset.site);return;}if(action&&\"'!action.hasAttribute('\"'disabled'))this.action(action.dataset.action\"'!);});\n  this.root.addEventListener('\"'pointerover',e=>{const button=(e.target as Element).closest<HTMLElement>('[data-focus]');if(button)button.focus({preventScroll:true});});\n  this.root.addEventListener('input',e=>{const el=e.target as HTMLInputElement;if(el.dataset.pref){const key=el.dataset.pref as keyof Preferences;Object.assign(c.prefs,{[key]:Number(el.value)});if(key==='cursorSpeed')c.set('game.cursorSpeed',Number(el.value));c.save();}if(el.dataset.balance)c.set('game.'+el.dataset.balance,Number(el.value));if(el.hasAttribute('data-timescale'))c.engine()?.inspector.timeScale(Number(el.value));const out=el.parentElement?.querySelector('output');if(out)out.textContent=Number(el.max)===1?Math.round(Number(el.value)*100)+'%':Number(el.value).toFixed(2);});\n }\n open(screen:Screen):void{this.returnTo=this.c.d.screen;this.ref=0;this.c.d.go(screen);}\n render(force=false):void{\n  const c=this.c,d=c.d;if(\"'!force&&this.revision===d.revision)return;this.revision=d.revision;this.root.dataset.game=d.screen;document.body.dataset.screen=d.screen;\n  const renderers:Partial<Record<Screen,()=>string>>={title:()=>pages.title(c),board:()=>pages.board(c),story:()=>pages.story(c),briefing:()=>pages.briefing(c),debrief:()=>pages.result(c),failed:()=>pages.result(c),postcard:()=>pages.postcard(c),pause:()=>pages.pause(c),scrub:()=>pages.scrub(c),credits:pages.credits,about:()=>about(this.ref),handbook:()=>handbook(c,this.ref),postcards:()=>postcards(c,this.ref),settings:()=>settingPage(c,this.settingsTab,this.rebindPage),dev:()=>devPage(c,this.dev)};\n  this.root.innerHTML=renderers[d.screen]?.()??'\"'';\n  const first=this.root.querySelector<HTMLElement>('[data-focus]:not(:disabled)');first?.focus({preventScroll:true});\n }\n menu(code:string):void{\n  if(this.rebinding)return;const d=this.c.d;\n  if(code==='Escape'){if(d.screen==='story')return;this.action('back');return;}\n  if(code==='KeyT'){if(d.screen==='story'){this.action('skip');return;}}\n  if(d.screen==='story'&&(code==='Enter'||code==='Space')){this.action('advance');return;}\n  const elements=[...this.root.querySelectorAll<HTMLElement>('[data-focus]:not(:disabled)')],focused=document.activeElement as HTMLElement,index=elements.indexOf(focused);\n  if(code==='Enter'){focused?.click();return;}\n  if(code==='ArrowUp'||code==='ArrowDown'){const next=(index+(code==='ArrowDown'?1:elements.length-1))%elements.length;elements[next]?.focus({preventScroll:true});}\n  if(code==='ArrowLeft'||code==='ArrowRight'){\n   if(focused instanceof HTMLInputElement&&focused.type==='range'){focused.value=String(Number(focused.value)+(code==='ArrowRight'?1:-1)*Number(focused.step||.1));focused.dispatchEvent(new Event('input',{bubbles:true}));}\n   else if(d.screen==='board')this.action(code==='ArrowRight'?'case-next':'case-prev');\n   else if(['about','handbook','postcards'].includes(d.screen))this.action(code==='ArrowRight'?'ref-next':'ref-prev');\n  }\n }\n action(id:string):void{\n  const c=this.c,d=c.d;c.sound.audio.play('sfx:hl-clack',{vol:.18});\n  if(developerAction(c,this.dev,id)){this.render(true);return;}\n  if(id==='new'){d.newShift();}\n  else if(id==='continue'){const cp=d.progress.checkpoint;d.caseIndex=cp?.caseIndex??Math.min(7,d.progress.unlocked-1);d.free=false;if(cp)d.start(cp.phase);else d.story('before');}\n  else if(id==='board'){this.dev.author=false;d.go('board','title');}\n  else if(['settings','about','handbook','scrub','dev','postcards'].includes(id)){if(id==='dev'){this.dev.caseIndex=d.caseIndex;this.dev.phase=c.state()?.phase??0;}this.open(id as Screen);}\n  else if(id==='case-next'||id==='case-prev'){d.caseIndex=(d.caseIndex+(id==='case-next'?1:8))%9;this.render(true);}\n  else if(id==='case-play'){d.free=true;d.go('briefing');}\n  else if(id.startsWith('difficulty:')){c.prefs.difficulty=id.split(':')[1] as Preferences['difficulty'];c.save();this.render(true);}\n  else if(id==='operate'){d.start();}\n  else if(id==='advance'){d.advanceStory();}\n  else if(id==='skip'){d.skipStory();}\n  else if(id==='next-result'){d.continueResult();}\n  else if(id==='pause'){this.pause();}\n  else if(id==='resume'){this.dev.author=false;c.engine()?.inspector.resume();d.go('op');}\n  else if(id==='retry'){d.start();}\n  else if(id==='retry-phase'){d.start(c.state()?.phase??d.last?.phase??0);}\n  else if(id==='scrub-start'){d.go('board','title');}\n  else if(id==='back'){\n   if(d.screen==='op'){this.pause();return;}\n   if(d.screen==='pause'){this.action('resume');return;}\n   if(d.screen==='board'||d.screen==='credits')d.go('title','title');\n   else if(d.screen==='briefing')d.go('board','title');\n   else{d.go(this.returnTo);if(this.returnTo==='op')c.engine()?.inspector.resume();}\n  }\n  else if(id==='ref-prev'||id==='ref-next'){const count=d.screen==='about'?aboutCards.length:d.screen==='postcards'?Math.max(1,Object.keys(d.progress.postcards).length):12+Math.max(0,Math.min(5,d.progress.unlocked-3));this.ref=(this.ref+(id==='ref-next'?1:count-1))%count;this.render(true);}\n  else if(id.startsWith('settings-tab:')){this.settingsTab=Number(id.split(':')[1]);this.render(true);}\n  else if(id.startsWith('pref:')){cyclePreference(c,id.split(':')[1] as keyof Preferences);this.render(true);}\n  else if(id.startsWith('bind:')){this.rebinding=true;const action=id.split(':')[1],input=c.engine()?.input;this.root.querySelector('h2')\"'!.textContent='\"'Press a new key or button…';if(input)void input.listen(c.hands.lastDevice==='gamepad'?'gamepad':'keyboard').then(code=>{if(code)input.bindingsFor('actionMap:surgeon').rebind(action,code);this.rebinding=false;this.render(true);});}\n  else if(id==='bind-reset'){c.engine()?.input.bindingsFor('actionMap:surgeon').reset();this.render(true);}\n  else if(id==='bind-prev'||id==='bind-next'){this.rebindPage=(this.rebindPage+(id==='bind-next'?1:4))%5;this.render(true);}\n  c.save();this.render();\n }\n pause():void{\n  if(this.dev.author){this.dev.author=false;this.c.d.go('dev');return;}\n  if(this.c.d.screen==='pause'){this.action('resume');return;}\n  this.c.engine()?.inspector.pause();this.c.d.go('pause');this.render();\n }\n radial():void{\n  const r=this.c.hands.radial,el=document.getElementById('radial')\"'!;\n  if(!r){el.classList.remove('\"'open');return;}el.classList.add('open');el.style.left=\"'`${Math.min(innerWidth*.8,Math.max(innerWidth*.2,r.x))}px`;el.style.top=`${Math.min(innerHeight*.75,Math.max(innerHeight*.25,r.y))}px`;\n  el.innerHTML=`<div class=\"center\">${TOOLS[r.selected]}</div>${TOOLS.map((_,i)=>{const a=i*Math.PI/4-Math.PI/2;return `<button class=\"${i===r.selected?'\"'active':''}\\\" style=\\\"transform:translate(-50%,-50%) translate(\"'${Math.cos(a)*175}%,${Math.sin(a)*175}%)\" aria-label=\"${TOOLS[i]}\">${pages.page?'\"'':''}\"'${'\"''}</button>\"'`;}).join('\"'')}\"'`;\n }\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/net/sequencer.ts <<'EOF'\n/** @file Host input sequencing and monotonic presses; this pure queue is exercised under simulated packet loss. */\nimport type {Hand} from '../data/types';\nexport interface TickPacket {t:'ticks';from:number;hands:Hand[][];check?:[number,string];}\nexport class Sequencer{\n next=0;hands:Hand[];queue=new Map<number,Hand[]>();checks=new Map<number,string>();mismatches=0;checked=0;\n constructor(seats:number){this.hands=Array.from({length:seats},()=>[0,0,3,0,0,0,0,0,0]);}\n input(seat:number,hand:Hand):void{const old=this.hands[seat];if(\"'!old)return;const n=[...hand] as Hand;for(const i of [4,5,7])n[i]=Math.max(old[i],n[i]);this.hands[seat]=n;}\n receive(packet:TickPacket):void{packet.hands.forEach((h,i)=>{if(packet.from+i>=this.next)this.queue.set(packet.from+i,h);});if(packet.check)this.checks.set(...packet.check);}\n drain(step:(hands:Hand[])=>void,hash:()=>string,limit=8):void{\n  for(let i=0;i<limit;i++){const h=this.queue.get(this.next);if(!h)break;step(h);this.queue.delete(this.next);this.next++;const expected=this.checks.get(this.next);if(expected){this.checked++;if(hash()!==expected)this.mismatches++;this.checks.delete(this.next);}}\n }\n leave(seat:number):void{if(this.hands[seat])this.hands[seat][3]=-1;}\n}\nEOF\ncat > labs/game/net/session.ts <<'\"'EOF'\n/** @file AI Hub shared-world card, host-sequenced simulation and standings; the hub owns every network action. */\nimport type {Inspector} from '../../../engine';\nimport type {Hand,Operation} from '../data/types';\nimport {Sequencer,type TickPacket} from './sequencer';\nimport {interview} from '../data/about';\nimport {esc,lighthouse} from '../ui/icons';\nexport interface Player {id:number;name:string;color:string;}\nexport interface HubInfo {me:number;players:Player[];host:number;isHost:boolean;server:boolean;seed:number;limitMs:number;}\nexport interface Hub {active:boolean;server:boolean;connect:(o:object)=>Promise<HubInfo|null>;ready:()=>void;fail:(message:string)=>void;answer:(a:string)=>void;time:()=>number;on:(event:string,fn:(data:never,from?:number)=>void)=>()=>void;send:(data:unknown,opts?:object)=>boolean;finish:(data:unknown)=>void;}\nexport const readOperation=(e:Inspector):Operation|undefined=>(e.state('operation').entities[0] as unknown as {operation?:{data:Operation}}|undefined)?.operation?.data;\nexport class Session{\n info:HubInfo;hub:Hub;e:Inspector|null=null;seq:Sequencer;timer:ReturnType<typeof setInterval>|null=null;ended=false;started=false;finished=false;lastSend=0;lastInput=0;buffer:Hand[][]=[];from=0;local:Hand=[0,0,3,0,0,0,0,0,0];players:Player[];card:HTMLElement;\n constructor(hub:Hub,info:HubInfo){\n  this.hub=hub;this.info=info;this.players=[...info.players];this.seq=new Sequencer(info.players.length);this.card=document.getElementById('panels')\"'!;\n  if(!info.server){this.card.innerHTML=`<section class=\"page\"><header class=\"page-head\"><div><div class=\"eyebrow\">AI HUB / PRE-OP BRIEFING</div><h2>${esc(interview.aiHub.name)}</h2></div><div class=\"brandmark\">${lighthouse}</div></header><div class=\"page-body\"><div class=\"briefing-content\"><h3>The Gala Shift</h3><p>Keep both patients alive. Clear the grafts and close every wound together.</p><div class=\"rule\"></div><div data-game=\"team\"></div><p class=\"small\">Stick or mouse aims · R2 or click operates · right stick or 1–8 picks a tool · Q / E switches tables.</p></div></div><footer class=\"page-footer\"><span data-game=\"card-clock\">Waiting for the team…</span><button data-focus data-hub=\"more\">△ / T · More time</button><button data-focus data-hub=\"ready\" class=\"primary\">✕ / Enter · Ready</button></footer></section>`;const team=this.card.querySelector('\"'[data-game=\\\"team\\\"]')\"'!;for(const p of info.players){const line=document.createElement('\"'p');line.dataset.player=String(p.id);line.style.color=p.color;line.textContent=p.name;team.append(line);}}\n  hub.on('card',(data:{left:number|null;ready:number[];paused:boolean})=>{const timer=this.card.querySelector('[data-game=\\\"card-clock\\\"]');if(timer)timer.textContent=data.paused?'The team asked for more time.':data.left===null?'Preparing…':\"'`${Math.ceil(data.left/1000)}s to scrub in`;for(const p of this.players){const el=this.card.querySelector(`[data-player=\"${p.id}\"]`);if(el)el.textContent=p.name+(data.ready.includes(p.id)?'\"' · READY':' · preparing');}});\n  hub.on('start',()=>{this.started=true;this.card.innerHTML='';});\n  hub.on('message',(data:TickPacket|{t:'input';hand:Hand},from?:number)=>{if(this.ended)return;if(data.t==='input'&&info.isHost&&from\"'!==undefined)this.seq.input(from,data.hand);else if(data.t==='\"'ticks'&&\"'!info.isHost)this.seq.receive(data);});\n  hub.on('\"'leave',(data:{id:number})=>{this.players=this.players.filter(p=>p.id\"'!==data.id);this.seq.leave(data.id);});\n  hub.on('\"'time-up',()=>{if(info.isHost)this.finish(false);});\n  hub.on('end',()=>{this.ended=true;if(this.timer)clearInterval(this.timer);});\n  addEventListener('keydown',event=>{if(\"'!this.started){if(event.code==='\"'Enter')hub.answer('ready');if(event.code==='KeyT')hub.answer('more');}});\n  this.card.addEventListener('click',event=>{const el=(event.target as Element).closest<HTMLElement>('[data-hub]');if(el)hub.answer(el.dataset.hub\"'!);});\n }\n attach(e:Inspector):void{if(this.e)return;this.e=e;e.pause();this.hub.ready();this.timer=setInterval(()=>this.tick(),16);}\n tick():void{\n  const e=this.e;if(!e||this.ended||!this.started||this.hub.time()<0)return;const now=this.hub.time();\n  if(!this.info.server&&now-this.lastInput>=70){this.lastInput=now;if(this.info.isHost)this.seq.input(this.info.me,this.local);else this.hub.send({t:'\"'input',hand:this.local},{to:this.info.host,reliable:false});}\n  if(this.info.isHost){\n   const due=Math.floor(now*60/1000);let count=0;\n   while(this.seq.next<due&&count++<120){const hands=this.seq.hands.map(h=>[...h] as Hand);if(\"'!this.buffer.length)this.from=this.seq.next;e.step(1,{'\"'game:hands':hands});this.seq.next++;this.buffer.push(hands);if(this.buffer.length>=5)this.flush();}\n   if(now-this.lastSend>=70)this.flush();const s=readOperation(e);if(s&&s.status\"'!=='\"'playing')this.finish(s.status==='won');\n  }else this.seq.drain(h=>e.step(1,{'game:hands':h}),()=>e.hash(),this.seq.queue.size>30?8:this.seq.queue.size>6?2:1);\n }\n flush():void{if(\"'!this.e||!this.buffer.length)return;const packet:TickPacket={t:'\"'ticks',from:this.from,hands:this.buffer,check:this.seq.next%60<5?[this.seq.next,this.e.hash()]:undefined};this.hub.send(packet,{reliable:true});this.buffer=[];this.lastSend=this.hub.time();}\n finish(won:boolean):void{\n  if(this.finished||this.ended||\"'!this.info.isHost)return;this.finished=true;const s=this.e?readOperation(this.e):undefined,players=[...this.players].sort((a,b)=>(s?.seats[b.id]?.score??0)-(s?.seats[a.id]?.score??0));\n  const standings:number[][]=[];for(const p of players){const value=s?.seats[p.id]?.score??0,last=standings.at(-1);if(last&&(s?.seats[last[0]]?.score??0)===value)last.push(p.id);else standings.push([p.id]);}\n  this.hub.finish({standings,scores:Object.fromEntries(players.map(p=>[p.id,s?.seats[p.id]?.score??0])),won,stats:Object.fromEntries(players.map(p=>[p.id,{Slips:s?.seats[p.id]?.slips??0,'\"'Best chain':s?.seats[p.id]?.best??1}])),awards:players.map(p=>({id:p.id,title:'Steadiest hands',detail:\"'`${s?.seats[p.id]?.slips??0} slips`}))});\n }\n stop():void{if(this.timer)clearInterval(this.timer);this.timer=null;}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
