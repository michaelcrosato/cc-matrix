,\"kind\":\"solace\",\"progress\":0,\"stitches\":0,\"dose\":0,\"mask\":0},{\"id\":17,\"kind\":\"solace\",\"progress\":0,\"stitches\":0,\"dose\":0,\"mask\":0},{\"id\":18,\"kind\":\"solace\",\"progress\":0,\"stitches\":0,\"dose\":0,\"mask\":0}],\"last\":[{\"n\":228,\"type\":\"refusal\",\"text\":\"Small enough. Laser now.\",\"x\":-3.23046875,\"z\":1.16015625,\"seat\":0},{\"n\":229,\"type\":\"switch\",\"text\":\"5\",\"x\":6.80078125,\"z\":3.3515625,\"seat\":0},{\"n\":230,\"type\":\"switch\",\"text\":\"5\",\"x\":6.80078125,\"z\":3.3515625,\"seat\":1},{\"n\":231,\"type\":\"lost\",\"text\":\"The rhythm is gone.\",\"x\":0,\"z\":0,\"seat\":0}]}\n{\"id\":\"reverie\",\"status\":\"won\",\"phase\":4,\"tick\":2509,\"vitals\":[51.14999999999992],\"slips\":0,\"score\":17425,\"reason\":\"\",\"targets\":[],\"last\":[{\"n\":140,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":1.87890625,\"z\":-1.625,\"seat\":0},{\"n\":141,\"type\":\"phase\",\"text\":\"Close the field\",\"x\":0,\"z\":0,\"seat\":0},{\"n\":142,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":1.87890625,\"z\":-1.625,\"seat\":0},{\"n\":143,\"type\":\"won\",\"text\":\"OPERATION COMPLETE\",\"x\":0,\"z\":0,\"seat\":0}]}\n{\"id\":\"gala-night\",\"status\":\"won\",\"phase\":2,\"tick\":785,\"vitals\":[76.84857685768334,76.93191019101674,75.80267677103986],\"slips\":0,\"score\":14534,\"reason\":\"\",\"targets\":[],\"last\":[{\"n\":70,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":0,\"z\":0,\"seat\":0},{\"n\":71,\"type\":\"phase\",\"text\":\"Close the field\",\"x\":0,\"z\":0,\"seat\":0},{\"n\":72,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":0,\"z\":0,\"seat\":0},{\"n\":73,\"type\":\"won\",\"text\":\"OPERATION COMPLETE\",\"x\":0,\"z\":0,\"seat\":0}]}\n{\"id\":\"mercy\",\"status\":\"won\",\"phase\":10,\"tick\":2727,\"vitals\":[73],\"slips\":0,\"score\":38672,\"reason\":\"\",\"targets\":[],\"last\":[{\"n\":242,\"type\":\"rating\",\"text\":\"TEXTBOOK\",\"x\":6.80078125,\"z\":3.3515625,\"seat\":1},{\"n\":243,\"type\":\"inject\",\"text\":\"+24 VITALS\",\"x\":6.80078125,\"z\":3.3515625,\"seat\":0},{\"n\":244,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":6.80078125,\"z\":3.3515625,\"seat\":0},{\"n\":245,\"type\":\"won\",\"text\":\"OPERATION COMPLETE\",\"x\":0,\"z\":0,\"seat\":0}]}\n{\"id\":\"gala-shift\",\"status\":\"won\",\"phase\":1,\"tick\":904,\"vitals\":[77.88333333333165,99.35000000000059],\"slips\":0,\"score\":9536,\"reason\":\"\",\"targets\":[],\"last\":[{\"n\":79,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":-0.19921875,\"z\":0.7890625,\"seat\":0},{\"n\":80,\"type\":\"phase\",\"text\":\"Close the field\",\"x\":0,\"z\":0,\"seat\":0},{\"n\":81,\"type\":\"rating\",\"text\":\"CLEAN\",\"x\":-0.19921875,\"z\":0.7890625,\"seat\":0},{\"n\":82,\"type\":\"won\",\"text\":\"OPERATION COMPLETE\",\"x\":0,\"z\":0,\"seat\":0}]}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_44","type":"agent_message","text":"The first playthroughs caught two blocking problems: overlapping targets could steal an active stroke, and the bot could neglect a patient on another table. Those are fixed. I’m checking the full case sequence again while building the operating field, story scenes, and controller-friendly menus.\n"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/data/story/index.ts').write_text('''/** @file Original hospital melodrama: sixteen skippable scenes, each twelve short voiced beats. */\nexport const CAST:Record<string,{name:string;color:string;role:string}>={wren:{name:'DR. WREN TOLLIVER',color:'#59e6cf',role:'Second-year resident'},odie:{name:'ODALYS “ODIE” FERREIRA',color:'#e4ba75',role:'Charge nurse'},chief:{name:'DR. BRAM ACHTERBERG',color:'#e4e9e4',role:'Chief of Surgery'},sabine:{name:'DR. SABINE OYELARAN',color:'#f2a964',role:'The other doctor'},voss:{name:'DR. LUCAN VOSS',color:'#f4e7bb',role:'Halcyon Biosciences'},patient:{name:'THE PATIENT',color:'#9ab5d0',role:'A life, not a case'}};\nexport interface Beat {who:string;text:string;act:string;drama?:string;}\nexport interface Story {id:string;set:string;beats:Beat[];}\nconst before:[string,string][][]=[\n [['voss','Halcyon. Because you deserve to feel nothing.'],['odie','Congratulations, Doctor. You are the only surgeon in the building.'],['wren','The only surgeon?'],['odie','The other one is a poster. He has excellent hands.'],['patient','My dog is outside. Pepper. She does not like thunder.'],['wren','We will get you back to her, Mr. Reyes.'],['patient','I bring the ships in. Tonight the harbor brought me.'],['odie','Deck-hatch glass. Four fragments. Chest wound.'],['wren','I have never done this without someone watching.'],['odie','I am watching. That should worry you more.'],['wren','Sorry, Mr. Reyes. My hands are cold.'],['odie','Scalpel. No, the other end, Doctor.']],\n [['patient','A cyst. That is a very small word for a very large bill.'],['wren','Gwen Abara? I heard your set at the Breakwater.'],['patient','Then you know my lungs are the expensive part.'],['odie','Her old graft scar. Right where it should not be.'],['voss','A miracle patch. A perfect tomorrow.'],['patient','It healed my lip. Bought me another ten years on the trumpet.'],['wren','And this lump?'],['patient','It started humming. Probably jealous.'],['odie','Routine, Doctor. You are allowed one routine thing.'],['wren','I promised myself a quiet night.'],['patient','Promise me the last set instead.'],['wren','All right. One quiet incision.']],\n [['odie','Bus on Breakwater Road. Three sites. One driver.'],['chief','Tolliver\"'! Why is that patient still bleeding?'\"'],['wren','Because he has only just arrived\"'!'\"'],['chief','Then work as though he arrived yesterday.'],['patient','Route 9. There was a child at the stop.'],['wren','The child is safe, Mr. Minsky.'],['patient','She forgets her lunch on Thursdays. Tell someone.'],['odie','Liver. Lung. Arm. They all need you.'],['wren','I cannot be in three places.'],['chief','A surgeon does not feel. A surgeon finishes.'],['wren','Then I will have to be faster.'],['odie','Fast is useful. Right is better.']],\n [['patient','It is not a cyst. I can feel it listening.'],['wren','Gwen. Look at me. You are back at Harbor Light.'],['odie','Her scar moved. In front of me.'],['chief','Scar tissue contracts. It does not listen.'],['wren','Neither did the specimen. Until I cut it.'],['voss','Pain is just a feeling you have not paid to remove yet.'],['odie','Someone turn that television off.'],['chief','I will observe from the gallery.'],['wren','Then observe this time.'],['patient','If I cannot play again—'],['wren','You will. Save the breath.'],['odie','Keep a specimen jar. And this time, a witness.']],\n [['wren','Dr. Oyelaran?'],['sabine','Depends who is asking. Lawyers get the gangplank.'],['wren','They said you imagined what you found.'],['sabine','Everyone agreed I was wrong. That is consensus from the inside.'],['wren','My specimen vanished. So did my operating privileges.'],['sabine','Mine too. The sea has fewer committees.'],['patient','Doctor\"'! Big Ana is down on deck!'\"'],['odie','I brought the good instruments. And no permission.'],['sabine','Your hands are shaking.'],['wren','They have never shaken.'],['sabine','Then that is new. Use it.'],['odie','The ship is rolling. Try not to operate on the furniture.']],\n [['chief','Do not let them see me fall.'],['odie','Then stop standing, Bram.'],['wren','Your collar. That is a graft scar.'],['chief','I know what it is.'],['sabine','You knew what ours were too.'],['chief','The trials were supposed to follow.'],['wren','They did not.'],['chief','The city needed hope.'],['odie','It needed evidence. Hope is not sterile.'],['chief','Tolliver. I think I am dying.'],['wren','In my operating room, we check.'],['sabine','Two surgeons. One very overdue admission.']],\n [['voss','Ladies and gentlemen, a city without suffering\"'!'\"'],['odie','Three donors down. Three tables ready.'],['wren','They all have grafts.'],['sabine','And the new strain spreads like varnish.'],['voss','What is generosity, if not a chance to leave a mark?'],['patient','My husband is at the next table.'],['wren','We will keep both of you here.'],['odie','And the third. He paid for the wing, not immunity.'],['sabine','Balm locks the wounds. Gel clears it.'],['wren','We have the trial files. The truth is in this room.'],['odie','So are three people who need morning.'],['voss','To Halcyon. To a kinder tomorrow\"'!'\"']],\n [['odie','Lucan Voss. His own product. Inside his heart.'],['sabine','The final strain. He named it Mercy.'],['wren','Prepare the field.'],['voss','I wanted to make the pain stop.'],['sabine','You stopped the questions instead.'],['voss','Am I going to die?'],['wren','You are going into surgery.'],['odie','We could be slow, Doctor. Nobody would know.'],['wren','I would.'],['sabine','Then our hands know what to do.'],['odie','Paddles charged. Evidence secured.'],['wren','Mr. Voss. I am sorry my hands are cold.']],\n];\nconst after:[string,string][][]=[\n [['odie','Vitals steady. Every fragment accounted for.'],['wren','He is going to wake up?'],['odie','Not if you keep talking at that volume.'],['patient','Pepper?'],['wren','She is right here.'],['odie','There are no dogs on this ward.'],['patient','Then this is a very convincing cushion.'],['wren','Thank you for watching my hands.'],['odie','Somebody had to.'],['voss','Halcyon. A gentler world is waiting.'],['wren','I think I can do this.'],['odie','Good. The night has noticed.']],\n [['wren','It flinched.'],['odie','I saw.'],['wren','That was not a cyst.'],['chief','Pathology says otherwise.'],['odie','Pathology has not received the jar.'],['chief','Then wait for people who know.'],['wren','I had it in my hand.'],['patient','Did I miss my set?'],['wren','Just the first song.'],['patient','Good. I hate the first song.'],['odie','Seal the jar, Doctor.'],['wren','And label it what we saw.']],\n [['wren','The room went slow. Or I went—'],['odie','Fast. You were fast. Do not make it weird.'],['patient','The child with the lunch?'],['odie','Her mother is in the corridor.'],['wren','For a moment I could hear every beat.'],['chief','A surgeon finishes. You finished.'],['wren','That is not what I asked.'],['chief','Then ask a question with an answer.'],['odie','Your patient is breathing. Start there.'],['patient','I will save you a seat on Route 9.'],['wren','I may be late.'],['odie','She is always late. She stays.']],\n [['wren','The jar. Where is the jar?'],['odie','A man from Halcyon collected it.'],['chief','You saw a twitch at hour nineteen of a shift.'],['wren','We saw a living organism.'],['chief','Your privileges are suspended.'],['odie','For finding what was killing her?'],['chief','For refusing to understand uncertainty.'],['wren','I understand it. That is why I kept the evidence.'],['chief','Get a second opinion. Find a fool to give one.'],['odie','There is a ship in the south harbor.'],['wren','You already knew.'],['odie','I am always two steps ahead. Take your coat.']],\n [['patient','My crew?'],['odie','Still outside. Still being loud.'],['sabine','Two samples. Same graft substrate. Different strains.'],['wren','You were right.'],['sabine','That was never the part I wanted.'],['wren','Come back with us. They need a doctor.'],['sabine','I am not a doctor anymore, Dr. Tolliver.'],['wren','You just saved her.'],['sabine','I am a second opinion.'],['odie','Both opinions can carry a stretcher.'],['wren','The Chief needs to see this.'],['odie','The Chief is calling. From a bed.']],\n [['chief','I signed the trial. I signed them all.'],['wren','Where are the results?'],['chief','There are no results. They went to market first.'],['sabine','And you let them.'],['chief','Yes.'],['odie','That is a complete sentence. Try more of those.'],['chief','The files. My desk. Bottom drawer.'],['wren','We will give them to the investigators.'],['chief','The gala is tonight. Every donor wears a graft.'],['sabine','Then we are going to a party.'],['chief','Tolliver. I was wrong.'],['wren','Rest. We have work.']],\n [['odie','All three. Alive.'],['sabine','Three Nodes. Three clean samples.'],['voss','And that, friends, is the power of—'],['wren','His smile.'],['odie','Get a gurney under that man.'],['voss','I cannot feel my hands.'],['sabine','The product works exactly as advertised.'],['wren','Do not say that.'],['sabine','Then make it untrue.'],['odie','Heart room. Now.'],['wren','We are still doctors.'],['odie','Then everybody move.']],\n [['voss','You saved me.'],['wren','You were my patient.'],['voss','That is the one thing I could never have sold.'],['odie','The officers will help you with the paperwork.'],['chief','The files are public. Every name. Every signature.'],['sabine','Including yours.'],['chief','Especially mine.'],['patient','Postcards arrive from the harbor, the bus depot, the bandstand.'],['wren','Morning looks different from this side of it.'],['odie','Coffee does not. Drink it.'],['sabine','A shipping manifest. Another crate. Already at sea.'],['wren','CASE FILE REMAINS OPEN.']],\n];\nconst sets=['ward','ward','corridor','chief','ship','chief','gala','or'];\nconst actions=['adjust-glasses','clipboard-slam','point-accusingly','hands-on-desk','exhale-relief','hand-over-instrument','scrub-hands','mask-up','collar-open','collapse','moustache-rage','tv-host-smile'];\nexport function storyFor(index:number,part:'before'|'after'):Story{\n const source=(part==='before'?before:after)[index]??before[0];\n return {id:\"'`story:${index}:${part}`,set:sets[index]??'\"'or',beats:source.map(([who,text],i)=>({who,text,act:actions[(i+index)%actions.length],...((index===1&&part==='after'&&i===0)||(index===7&&i===8)||(index===5&&part==='before'&&i===2)?{drama:text.toUpperCase()}: {})}))};\n}\nexport function validateStory(s:Story):string[]{return [...(s.beats.length<12?['A scene needs at least twelve beats.']:[]),...s.beats.filter(b=>\"'!CAST[b.who]||!b.text||b.text.length>180).map(b=>`Invalid beat: ${b.who}`)];}\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('labs/game/data/story/index.ts').write_text('''/** @file Original hospital melodrama: sixteen skippable scenes, each twelve short voiced beats. */\nexport const CAST:Record<string,{name:string;color:string;role:string}>={wren:{name:'DR. WREN TOLLIVER',color:'#59e6cf',role:'Second-year resident'},odie:{name:'ODALYS “ODIE” FERREIRA',color:'#e4ba75',role:'Charge nurse'},chief:{name:'DR. BRAM ACHTERBERG',color:'#e4e9e4',role:'Chief of Surgery'},sabine:{name:'DR. SABINE OYELARAN',color:'#f2a964',role:'The other doctor'},voss:{name:'DR. LUCAN VOSS',color:'#f4e7bb',role:'Halcyon Biosciences'},patient:{name:'THE PATIENT',color:'#9ab5d0',role:'A life, not a case'}};\nexport interface Beat {who:string;text:string;act:string;drama?:string;}\nexport interface Story {id:string;set:string;beats:Beat[];}\nconst before:[string,string][][]=[\n [['voss','Halcyon. Because you deserve to feel nothing.'],['odie','Congratulations, Doctor. You are the only surgeon in the building.'],['wren','The only surgeon?'],['odie','The other one is a poster. He has excellent hands.'],['patient','My dog is outside. Pepper. She does not like thunder.'],['wren','We will get you back to her, Mr. Reyes.'],['patient','I bring the ships in. Tonight the harbor brought me.'],['odie','Deck-hatch glass. Four fragments. Chest wound.'],['wren','I have never done this without someone watching.'],['odie','I am watching. That should worry you more.'],['wren','Sorry, Mr. Reyes. My hands are cold.'],['odie','Scalpel. No, the other end, Doctor.']],\n [['patient','A cyst. That is a very small word for a very large bill.'],['wren','Gwen Abara? I heard your set at the Breakwater.'],['patient','Then you know my lungs are the expensive part.'],['odie','Her old graft scar. Right where it should not be.'],['voss','A miracle patch. A perfect tomorrow.'],['patient','It healed my lip. Bought me another ten years on the trumpet.'],['wren','And this lump?'],['patient','It started humming. Probably jealous.'],['odie','Routine, Doctor. You are allowed one routine thing.'],['wren','I promised myself a quiet night.'],['patient','Promise me the last set instead.'],['wren','All right. One quiet incision.']],\n [['odie','Bus on Breakwater Road. Three sites. One driver.'],['chief','Tolliver\"'! Why is that patient still bleeding?'\"'],['wren','Because he has only just arrived\"'!'\"'],['chief','Then work as though he arrived yesterday.'],['patient','Route 9. There was a child at the stop.'],['wren','The child is safe, Mr. Minsky.'],['patient','She forgets her lunch on Thursdays. Tell someone.'],['odie','Liver. Lung. Arm. They all need you.'],['wren','I cannot be in three places.'],['chief','A surgeon does not feel. A surgeon finishes.'],['wren','Then I will have to be faster.'],['odie','Fast is useful. Right is better.']],\n [['patient','It is not a cyst. I can feel it listening.'],['wren','Gwen. Look at me. You are back at Harbor Light.'],['odie','Her scar moved. In front of me.'],['chief','Scar tissue contracts. It does not listen.'],['wren','Neither did the specimen. Until I cut it.'],['voss','Pain is just a feeling you have not paid to remove yet.'],['odie','Someone turn that television off.'],['chief','I will observe from the gallery.'],['wren','Then observe this time.'],['patient','If I cannot play again—'],['wren','You will. Save the breath.'],['odie','Keep a specimen jar. And this time, a witness.']],\n [['wren','Dr. Oyelaran?'],['sabine','Depends who is asking. Lawyers get the gangplank.'],['wren','They said you imagined what you found.'],['sabine','Everyone agreed I was wrong. That is consensus from the inside.'],['wren','My specimen vanished. So did my operating privileges.'],['sabine','Mine too. The sea has fewer committees.'],['patient','Doctor\"'! Big Ana is down on deck!'\"'],['odie','I brought the good instruments. And no permission.'],['sabine','Your hands are shaking.'],['wren','They have never shaken.'],['sabine','Then that is new. Use it.'],['odie','The ship is rolling. Try not to operate on the furniture.']],\n [['chief','Do not let them see me fall.'],['odie','Then stop standing, Bram.'],['wren','Your collar. That is a graft scar.'],['chief','I know what it is.'],['sabine','You knew what ours were too.'],['chief','The trials were supposed to follow.'],['wren','They did not.'],['chief','The city needed hope.'],['odie','It needed evidence. Hope is not sterile.'],['chief','Tolliver. I think I am dying.'],['wren','In my operating room, we check.'],['sabine','Two surgeons. One very overdue admission.']],\n [['voss','Ladies and gentlemen, a city without suffering\"'!'\"'],['odie','Three donors down. Three tables ready.'],['wren','They all have grafts.'],['sabine','And the new strain spreads like varnish.'],['voss','What is generosity, if not a chance to leave a mark?'],['patient','My husband is at the next table.'],['wren','We will keep both of you here.'],['odie','And the third. He paid for the wing, not immunity.'],['sabine','Balm locks the wounds. Gel clears it.'],['wren','We have the trial files. The truth is in this room.'],['odie','So are three people who need morning.'],['voss','To Halcyon. To a kinder tomorrow\"'!'\"']],\n [['odie','Lucan Voss. His own product. Inside his heart.'],['sabine','The final strain. He named it Mercy.'],['wren','Prepare the field.'],['voss','I wanted to make the pain stop.'],['sabine','You stopped the questions instead.'],['voss','Am I going to die?'],['wren','You are going into surgery.'],['odie','We could be slow, Doctor. Nobody would know.'],['wren','I would.'],['sabine','Then our hands know what to do.'],['odie','Paddles charged. Evidence secured.'],['wren','Mr. Voss. I am sorry my hands are cold.']],\n];\nconst after:[string,string][][]=[\n [['odie','Vitals steady. Every fragment accounted for.'],['wren','He is going to wake up?'],['odie','Not if you keep talking at that volume.'],['patient','Pepper?'],['wren','She is right here.'],['odie','There are no dogs on this ward.'],['patient','Then this is a very convincing cushion.'],['wren','Thank you for watching my hands.'],['odie','Somebody had to.'],['voss','Halcyon. A gentler world is waiting.'],['wren','I think I can do this.'],['odie','Good. The night has noticed.']],\n [['wren','It flinched.'],['odie','I saw.'],['wren','That was not a cyst.'],['chief','Pathology says otherwise.'],['odie','Pathology has not received the jar.'],['chief','Then wait for people who know.'],['wren','I had it in my hand.'],['patient','Did I miss my set?'],['wren','Just the first song.'],['patient','Good. I hate the first song.'],['odie','Seal the jar, Doctor.'],['wren','And label it what we saw.']],\n [['wren','The room went slow. Or I went—'],['odie','Fast. You were fast. Do not make it weird.'],['patient','The child with the lunch?'],['odie','Her mother is in the corridor.'],['wren','For a moment I could hear every beat.'],['chief','A surgeon finishes. You finished.'],['wren','That is not what I asked.'],['chief','Then ask a question with an answer.'],['odie','Your patient is breathing. Start there.'],['patient','I will save you a seat on Route 9.'],['wren','I may be late.'],['odie','She is always late. She stays.']],\n [['wren','The jar. Where is the jar?'],['odie','A man from Halcyon collected it.'],['chief','You saw a twitch at hour nineteen of a shift.'],['wren','We saw a living organism.'],['chief','Your privileges are suspended.'],['odie','For finding what was killing her?'],['chief','For refusing to understand uncertainty.'],['wren','I understand it. That is why I kept the evidence.'],['chief','Get a second opinion. Find a fool to give one.'],['odie','There is a ship in the south harbor.'],['wren','You already knew.'],['odie','I am always two steps ahead. Take your coat.']],\n [['patient','My crew?'],['odie','Still outside. Still being loud.'],['sabine','Two samples. Same graft substrate. Different strains.'],['wren','You were right.'],['sabine','That was never the part I wanted.'],['wren','Come back with us. They need a doctor.'],['sabine','I am not a doctor anymore, Dr. Tolliver.'],['wren','You just saved her.'],['sabine','I am a second opinion.'],['odie','Both opinions can carry a stretcher.'],['wren','The Chief needs to see this.'],['odie','The Chief is calling. From a bed.']],\n [['chief','I signed the trial. I signed them all.'],['wren','Where are the results?'],['chief','There are no results. They went to market first.'],['sabine','And you let them.'],['chief','Yes.'],['odie','That is a complete sentence. Try more of those.'],['chief','The files. My desk. Bottom drawer.'],['wren','We will give them to the investigators.'],['chief','The gala is tonight. Every donor wears a graft.'],['sabine','Then we are going to a party.'],['chief','Tolliver. I was wrong.'],['wren','Rest. We have work.']],\n [['odie','All three. Alive.'],['sabine','Three Nodes. Three clean samples.'],['voss','And that, friends, is the power of—'],['wren','His smile.'],['odie','Get a gurney under that man.'],['voss','I cannot feel my hands.'],['sabine','The product works exactly as advertised.'],['wren','Do not say that.'],['sabine','Then make it untrue.'],['odie','Heart room. Now.'],['wren','We are still doctors.'],['odie','Then everybody move.']],\n [['voss','You saved me.'],['wren','You were my patient.'],['voss','That is the one thing I could never have sold.'],['odie','The officers will help you with the paperwork.'],['chief','The files are public. Every name. Every signature.'],['sabine','Including yours.'],['chief','Especially mine.'],['patient','Postcards arrive from the harbor, the bus depot, the bandstand.'],['wren','Morning looks different from this side of it.'],['odie','Coffee does not. Drink it.'],['sabine','A shipping manifest. Another crate. Already at sea.'],['wren','CASE FILE REMAINS OPEN.']],\n];\nconst sets=['ward','ward','corridor','chief','ship','chief','gala','or'];\nconst actions=['adjust-glasses','clipboard-slam','point-accusingly','hands-on-desk','exhale-relief','hand-over-instrument','scrub-hands','mask-up','collar-open','collapse','moustache-rage','tv-host-smile'];\nexport function storyFor(index:number,part:'before'|'after'):Story{\n const source=(part==='before'?before:after)[index]??before[0];\n return {id:\"'`story:${index}:${part}`,set:sets[index]??'\"'or',beats:source.map(([who,text],i)=>({who,text,act:actions[(i+index)%actions.length],...((index===1&&part==='after'&&i===0)||(index===7&&i===8)||(index===5&&part==='before'&&i===2)?{drama:text.toUpperCase()}: {})}))};\n}\nexport function validateStory(s:Story):string[]{return [...(s.beats.length<12?['A scene needs at least twelve beats.']:[]),...s.beats.filter(b=>\"'!CAST[b.who]||!b.text||b.text.length>180).map(b=>`Invalid beat: ${b.who}`)];}\n'\"''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
