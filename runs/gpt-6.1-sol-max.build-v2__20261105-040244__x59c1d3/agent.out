{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor name in ['main.ts','ui/dev.ts','ui/devActions.ts','ui/index.ts','ui/settings.ts']:\n p=Path('labs/game')/name;s=p.read_text().replace('?.inspector.', '?.inspector?.').replace('?.input.bindings','?.input?.bindings');\n if name=='main.ts':s=s.replace('engine?.inspector.set','engine?.inspector?.set').replace('if(\"'!engine)return;'\"', 'if(\"'!engine?.inspector)return;'\"').replace('frame=f;if(\"'!engine)return;'\"', 'frame=f;if(\"'!engine?.inspector)return;'\"').replace('operation,engine.input)', 'operation,engine.input??undefined)')\n p.write_text(s)\nPY\nmkdir -p out/visual\ncat > labs/game/tools/visual.py <<'EOF'\n# A real WebGPU browser boot and a small set of visual checks, saved under the game's own out directory.\nimport os,json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path.cwd();ident=json.loads((root/'identity.json').read_text());url=(root.parent/(ident['base']+'.html')).as_uri()\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n page=browser.new_page(viewport={'width':1920,'height':1080},device_scale_factor=1)\n errors=[];page.on('pageerror',lambda e: errors.append(str(e)))\n page.goto(url);page.wait_for_timeout(1500)\n try:page.wait_for_function('\"'!!window.__surgery && !!window.__engine?.ready'\"',timeout=90000)\n except Exception:pass\n print(json.dumps({'errors':errors,'text':page.locator('body').inner_text()[:1200],'state':page.evaluate('({gpu:\"'!!navigator.gpu,game:!!window.__surgery,engine:!!window.__engine,errors:window.__engine?.errors})'\"')}))\n page.screenshot(path=str(root/'out/visual/title.png'))\n if page.evaluate('\"'!!window.__surgery'\"'):\n  page.evaluate(\\\"window.__surgery.case('first-cut')\\\")\n  page.wait_for_timeout(2000)\n  print(json.dumps({'meshes':page.evaluate('window.__surgery.meshes'),'state':page.evaluate('({status:window.__surgery.state?.status,errors:window.__engine?.errors})')}))\n  page.screenshot(path=str(root/'out/visual/field.png'))\n browser.close()\nEOF\nTMPDIR=/tmp/g.5ozaaka0 python3 labs/game/tools/visual.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
