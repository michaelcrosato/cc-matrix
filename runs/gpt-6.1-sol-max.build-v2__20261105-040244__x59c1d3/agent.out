{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport ts from 'typescript';\nimport fs from 'node:fs';\nconst root='labs/game/data/';\nlet text=fs.readFileSync(root+'cases/index.ts','utf8');let sf=ts.createSourceFile('index.ts',text,ts.ScriptTarget.Latest,true);\nconst decls=sf.statements.filter(ts.isVariableStatement).flatMap(s=>s.declarationList.declarations);\nconst cases=decls.find(d=>d.name.getText(sf)==='CASES');\nconst prefix=text.slice(0,cases.parent.parent.getStart(sf)).replace(/Case, /,'').replace(/Case,/,'').replace(/(?<\"'!export )const (at|wound|cut|phase|close|cards)=/g,'\"'export const \"'$1='\"');\nfs.writeFileSync(root+'cases/helpers.ts',prefix);\nconst imports=[];\nfor(const [i,obj] of cases.initializer.elements.entries()){\n const id=/id:'([\"'^'\"']+)'/.exec(obj.getText(sf))[1];\n const code=obj.getText(sf),names=['at','line','circle','wound','cut','phase','close','cards'].filter(n=>new RegExp('\\\\\\\\b'+n+'\\\\\\\\(').test(code));\n fs.writeFileSync(root+\"'`cases/${id}.ts`,`/** @file Authored surgery case ${i+1}: ${id}. */'\"\\\\nimport type {Case} from '../types';\\\\nimport {\"'${names.join('\"',')}} from './helpers';\\\\nexport default \"'${code} satisfies Case;'\"\\\\n\"'`);\n imports.push(`import case${i} from '\"'./\"'${id}'\"';\"'`);\n}\nconst session=decls.find(d=>d.name.getText(sf)==='\"'SESSION'),code=session.initializer.getText(sf),names=['at','line','circle','wound','cut','phase','close','cards'].filter(n=>new RegExp('\\\\\\\\b'+n+'\\\\\\\\(').test(code));\nfs.writeFileSync(root+'cases/gala-shift.ts',\"'`/** @file The standalone co-op Gala Shift session case. */'\"\\\\nimport type {Case} from '../types';\\\\nimport {\"'${names.join('\"',')}} from './helpers';\\\\nexport default \"'${code} satisfies Case;'\"\\\\n\"'`);\nfs.writeFileSync(root+'\"'cases/index.ts',\"'`/** @file Case catalogue and designer-data validation. */'\"\\\\nimport type {Case} from '../types';\\\\n\"'${imports.join('\"'\\\\n')}\\\\nimport session from './gala-shift';\\\\nexport {line,circle} from './helpers';\\\\nexport const CASES:Case[]=[\"'${imports.map((_,i)=>`case${i}`).join('\"',')}];\\\\nexport const SESSION:Case=session;\\\\n\"'`+text.slice(session.parent.parent.getEnd()));\ntext=fs.readFileSync(root+'\"'story/index.ts','utf8');sf=ts.createSourceFile('story.ts',text,ts.ScriptTarget.Latest,true);\nconst ds=sf.statements.filter(ts.isVariableStatement).flatMap(s=>s.declarationList.declarations);const before=ds.find(d=>d.name.getText(sf)==='before'),after=ds.find(d=>d.name.getText(sf)==='after');\nfor(let i=0;i<8;i++)fs.writeFileSync(root+\"'`story/episode-${i+1}.ts`,`/** @file Original pre-op and post-op dialogue for case ${i+1}. */'\"\\\\nexport const before\"'${i}:[string,string][]=${before.initializer.elements[i].getText(sf)};'\"\\\\nexport const after\"'${i}:[string,string][]=${after.initializer.elements[i].getText(sf)};'\"\\\\n\"'`);\nconst start=text.slice(0,before.parent.parent.getStart(sf));const end=text.slice(after.parent.parent.getEnd());\nfs.writeFileSync(root+'\"'story/index.ts',start+'\\\\n'+Array.from({length:8},(_,i)=>\"'`import {before${i},after${i}} from '\"'./episode-\"'${i+1}'\"';\"'`).join('\"'\\\\n')+\"'`'\"\\\\nconst before=[\"'${Array.from({length:8},(_,i)=>`before${i}`).join('\"',')}];\\\\nconst after=[\"'${Array.from({length:8},(_,i)=>`after${i}`).join('\"',')}];\\\\n\"'`+end);\nJS\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/index.html');s=p.read_text().replace('<script>(function', '<script>(function')\npos=s.index('<script>');s=s[:pos]+'<\"'!-- prettier-ignore -->'\"\\\\n'+s[pos:];p.write_text(s)\nPY\nnpx prettier --write labs/game package.json identity.json runtime-env.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
