 Takes `code` off `action`, or every code of `device`'s family. */\n93-  unbind(action: string, which: string): void;\n94-  /** Gives `action` (or every action) the map's codes again. */\n95-  reset(action?: string): void;\n96-  /** What a prompt shows for `action` on `device`: its first code of that device, labelled; `—` when unbound. */\n97-  label(action: string, device: DeviceKind, options?: LabelOptions): string;\n98-  /** The changes as a bindings file. */\n99-  toJSON(): BindingsFile;\n100-}\n101-\n102-/**\n103- * What a prompt shows for an action bound to `codes` on `device`: its first code of that device, labelled (the\n104- * gamepad's only; the mouse's, then the keyboard's; the keyboard's, then the mouse's), or `—` when none is bound.\n105- */\n106-export function pickLabel(codes: readonly string[], device: DeviceKind, options?: LabelOptions): string {\n107-  const order: DeviceKind[] = device === 'gamepad' ? ['gamepad'] : device === 'mouse' ? ['mouse', 'keyboard'] : ['keyboard', 'mouse']; // prettier-ignore\n108-  for (const want of order) {\n109-    const code = codes.find((c) => deviceOf(c) === want);\n110-    if (code) return codeLabel(code, options);\n111-  }\n112-  return '—';\n113-}\n114-\n115-/** The family a device rebinds with: keyboard and mouse share one. */\n116-const family = (device: DeviceKind) => (device === 'gamepad' ? 'gamepad' : 'keyboard');\n117-\n118-/** Makes the bindings of the action map `map` (an id or an entry), loading saved changes from `options.storage`. */\n119-export function createBindings(map: string | ActionMap, options: BindingsOptions = {}): Bindings {\n120-  const entry = typeof map === 'string' ? getActionMap(map, options.registry) : map;\n121-  const key = options.key ?? `my3dge:bindings:${entry.id}`;\n122-  const names = Object.keys(entry.actions);\n123-  const reserved = new Set([...RESERVED_CODES, ...entry.reserved]);\n124-  const changed = new Map<string, readonly string[]>();\n125-  let version = 0;\n126-  const codes = (action: string) => changed.get(action) ?? entry.actions[action] ?? [];\n127-  const holder = (code: string, except: string) => names.find((name) => name !== except && codes(name).includes(code));\n128-  const save = () => {\n129-    version++;\n130-    options.storage?.setItem(key, JSON.stringify(bindings.toJSON()));\n131-  };\n132-  const refuse = (reason: 'unknown-action' | 'bad-code' | 'reserved' | 'conflict', message: string, action?: string) =>\n133-    ({ ok: false, reason, message, ...(action === undefined ? {} : { action }) }) as RebindResult;\n134-\n135-  const bindings: Bindings = {\n136-    map: entry,\n137-    get version() {\n138-      return version;\n139-    },\n140-    actions: () => [...names],\n141-    codes: (action) => Object.freeze([...codes(action)]),\n  timeScale(k?: number): number;\n  seed(n?: number): number;\n  state(query?: string | readonly string[]): WorldState;\n  hash(): string;\n  trace(): WorldTrace;\n  entities(query?: string | readonly string[]): EntitySummary[];\n  get(id: number): EntityData | null;\n  set(path: string, value: unknown): SettingChange;\n  capture(): WorldCapture;\n  restore(capture: WorldCapture): void;\n  describe(kind?: string, id?: string): unknown;\n  help(member?: string): string;\n  readonly errors: readonly ErrorRecord[];\n  readonly advice: readonly AdviceRecord[];\n  /** The members later WPs register (`input`, `stats`, `scene.dump`…). */\n  [member: string]: unknown;\n}\n\n/** Throws `DEV_BAD_ARGS` for `member` with these problems. */\nfunction badArgs(member: string, problems: string, signature: string): never {\n  throw codeError('DEV_BAD_ARGS', { member, problems, signature, name: show(member) });\n}\n\n/** Runs a member on `host`: the renderer check, the argument checks, then `impl` with the arguments as given. */\nfunction call(host: InspectorHost, member: Member, args: readonly unknown[]): unknown {\n  if (member.needs === 'renderer' && !host.renderer) {\n    throw codeError('DEV_NO_RENDERER', { member: member.id, runtime: host.runtime });\n  }\n  const fields = Object.entries(member.args);\n  const problems: Problem[] = [];\n  if (args.length > fields.length) {\n    problems.push({ path: '', message: `it takes ${fields.length} argument(s), not ${args.length}` });\n  }\n  const given = fields.map(([name, field], i) => {\n    if (args[i] === undefined) {\n      if (field.required) problems.push({ path: name, message: `${name} is required (${field.description})` });\n      return copyValue(field.default);\n    }\n    checkValue(field, args[i], name, problems);\n// The compiler options every TypeScript config here shares (PLAN.md §6.10, WP 0.1): tsconfig.json, the whole\n// repository as one program, and the projects T0 checks through tsconfig.check.json (ADR-0014, amendment 7).\n{\n  \"compilerOptions\": {\n    \"target\": \"es2022\",\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"lib\": [\"es2022\", \"dom\", \"dom.iterable\"],\n    \"types\": [\"node\"],\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"erasableSyntaxOnly\": true,\n    \"verbatimModuleSyntax\": true,\n    \"isolatedModules\": true\n  }\n}\ncat: tests/config/vitest.ts: No such file or directory\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/icons.ts <<'EOF'\n/** @file Original instrument and lighthouse glyphs, drawn in code and shared by toolbar, radial and Handbook. */\nconst paths=[\n 'M12 52 43 21M36 15l10-10 8 8-10 10M10 54l5-14 8 8-13 6',\n 'M14 8c0 15 1 25 10 41l5 7M49 8c0 15-1 25-10 41l-5 7M14 8h35',\n 'M47 12C14 4 4 32 27 45M27 45l5 11M23 40c19-19 25 5 34 2',\n 'M50 9H30v24c0 8-17 5-17 14v10M24 9v22M43 13v13M24 5h31',\n 'M12 50l21-24M30 19l14 14 12-12-14-14-12 12M11 40l-5 11 11 5M17 37l10 9',\n 'M12 53l12-12M19 32l13 13 19-19-13-13-19 19M34 10l20 20M46 5l13 13M25 28l5 5M31 22l5 5',\n 'M20 14h24l-4 35-8 9-8-9-4-35M19 9h26M27 31h10M26 39h12',\n 'M31 12a19 19 0 1 0 1 0M32 18v16l11 6M49 48l10 10M28 8h8',\n];\nexport function toolIcon(i:number):string{return \"'`<svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"${paths[i]??paths[0]}\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>`;}\nexport const lighthouse='\"'<svg viewBox=\\\"0 0 64 64\\\" aria-hidden=\\\"true\\\"><path d=\\\"M22 52h20L38 24H26l-4 28ZM25 18h14v7H25zM21 18l11-9 11 9M29 10V5M14 55h36M5 19l13-3M46 16l13 3M29 35h6M28 44h8\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\" stroke-linejoin=\\\"round\\\"/></svg>';\nexport const esc=(s:unknown):string=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]\"'!));\nexport function button(id:string,label:string,extra='\"''):string{return \"'`<button data-focus data-action=\"${id}\" ${extra}><span>${label}</span><span class=\"arrow\">↗</span></button>`;}\nEOF\ncat > labs/game/ui/context.ts <<'\"'EOF'\n/** @file Presentation dependencies passed explicitly, keeping screens independent of boot and networking. */\nimport type {Engine} from '../../../engine';\nimport type {Director} from '../app/director';\nimport type {Preferences} from '../app/settings';\nimport type {Hands} from '../input/hands';\nimport type {Soundtrack} from '../audio/mix';\nimport type {Operation} from '../data/types';\nexport interface UIContext {d:Director;prefs:Preferences;hands:Hands;sound:Soundtrack;engine:()=>Engine|null;save:()=>void;state:()=>Operation|undefined;act:(name:string,args:Record<string,unknown>)=>void;set:(key:string,value:unknown)=>void;get:(key:string)=>unknown;startSession:()=>void;}\nEOF\ncat > labs/game/ui/styles.css <<'EOF'\n/* @file Harbor Light's couch-readable clinical theatre, responsive from handheld previews to ultrawide TVs. */\n:root{color-scheme:dark;--ink:#e2e7dc;--soft:#9eb4b2;--mint:#a2efcf;--gold:#d0b581;--night:#071b22;--line:#85b2aa42;--u:min(1vw,1.77778vh);font-family:'Arial','DejaVu Sans',sans-serif;font-size:calc(var(--u)*1.7);font-synthesis:none}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07171e;color:var(--ink)}button,input{font:inherit}button{color:inherit;background:transparent;border:0;cursor:pointer;text-align:left}button:disabled{opacity:.35;cursor:default}button:focus-visible,input:focus-visible{outline:3px solid var(--mint);outline-offset:5px}button:hover{color:#f4fff4}button[data-focus]:focus{color:var(--mint)}button svg{display:block}#view{display:block;width:100%;height:100%;position:absolute;inset:0}#app{position:absolute;inset:0;pointer-events:none;z-index:10}#panels{position:absolute;inset:0}#panels>*{pointer-events:auto}#panels:empty{display:none}.eyebrow{text-transform:uppercase;font-size:calc(var(--u)*1.05);letter-spacing:.21em;color:var(--mint);font-weight:600}.small{font-size:calc(var(--u)*1.12);color:var(--soft);line-height:1.55}.muted{color:var(--soft)}.gold{color:var(--gold)}.tag{border:1px solid var(--line);padding:.4em .7em;text-transform:uppercase;font-size:.63em;letter-spacing:.14em}.rule{height:1px;background:var(--line);margin:calc(var(--u)*1.7) 0}.brandmark{display:flex;align-items:center;gap:calc(var(--u)*.7);font-size:calc(var(--u)*1.05);letter-spacing:.16em;line-height:1.5}.brandmark svg{width:calc(var(--u)*3.1);height:calc(var(--u)*3.1);color:var(--mint)}h1,h2,h3,p{margin:0}h1,h2{font-weight:500;letter-spacing:-.055em}h2{font-size:calc(var(--u)*4.4);line-height:1.06}h3{font-size:calc(var(--u)*2.4);font-weight:500;letter-spacing:-.03em}p{line-height:1.5}kbd,.glyph{border:1px solid #91b9ad77;display:inline-flex;align-items:center;justify-content:center;min-width:1.65em;height:1.6em;font-size:.78em;border-radius:.25em;padding:.1em .4em;margin-right:.4em;color:#dcece2;font-family:inherit;background:#0b242a88}\n.title-screen{position:absolute;inset:0;background:linear-gradient(90deg,#06191ff5 0%,#06191fea 31%,#06191f72 56%,#06191f00 80%),linear-gradient(0deg,#04141cde,transparent 25%,transparent 85%,#06191faa)}.title-content{position:absolute;top:7%;left:6.3%;width:33%;height:86%;display:flex;flex-direction:column}.title-logo{font-family:'Arial Narrow','DejaVu Sans',sans-serif;font-stretch:condensed;font-size:calc(var(--u)*7.2);font-weight:600;line-height:.86;letter-spacing:-.075em;margin-top:calc(var(--u)*3.1);text-transform:uppercase}.title-logo span{color:var(--mint)}.subtitle{font-family:Georgia,serif;font-style:italic;font-size:calc(var(--u)*2.03);margin-top:calc(var(--u)*1.15);letter-spacing:-.025em;color:var(--gold)}.title-menu{margin-top:calc(var(--u)*2);display:grid;gap:calc(var(--u)*.18)}.title-menu button{display:flex;align-items:center;justify-content:space-between;min-height:calc(var(--u)*3.6);width:88%;border-bottom:1px solid var(--line);padding:.35em .15em;transition:padding .15s,color .15s}.title-menu button:focus,.title-menu button:hover{padding-left:.6em;color:var(--mint)}.title-menu button:first-child{color:var(--mint);font-weight:600}.arrow{font-size:.9em;color:var(--gold)}.title-foot{position:absolute;bottom:3.5%;left:6.3%;right:5%;display:flex;justify-content:space-between;align-items:center}.title-copy{position:absolute;right:6.5%;bottom:18%;max-width:27%;border-left:2px solid var(--gold);padding-left:calc(var(--u)*1.4)}.title-copy p{font-size:calc(var(--u)*1.7);line-height:1.4}.title-copy .eyebrow{margin-bottom:1em}.storm-lines{position:absolute;right:8%;top:8%;color:#a9c4c7;display:flex;gap:2em;font-size:calc(var(--u)*.94);letter-spacing:.15em}.live-dot{display:inline-block;width:.45em;height:.45em;background:var(--mint);border-radius:50%;margin-right:.5em;box-shadow:0 0 .6em #9aecc7}\n.page{position:absolute;inset:0;background:linear-gradient(110deg,#081d24f5,#071e27d9);padding:5.5% 7% 4%;display:flex;flex-direction:column;gap:calc(var(--u)*1.6)}.page-head{display:flex;align-items:center;justify-content:space-between}.page-head .eyebrow{margin-bottom:1em}.page-body{flex:1;min-height:0;display:flex;align-items:center;gap:6%;max-width:100%}.page-footer{display:flex;align-items:center;justify-content:space-between;gap:1em;margin-top:auto}.page-footer button{min-height:calc(var(--u)*3.5);padding:.3em 1em;border:1px solid var(--line);font-size:.85em}.primary{background:var(--mint)\"'!important;color:#0d3035!important;border-color:var(--mint)!important;font-weight:600}.wide{width:100%}.menu-list{display:grid;gap:.22em;width:min(90%,650px)}.menu-list button{display:flex;justify-content:space-between;align-items:center;min-height:calc(var(--u)*3.6);border-bottom:1px solid var(--line);padding:.4em}.menu-list button:focus,.menu-list button:hover{background:#a2efcf11}.case-number{font-family:Georgia,serif;font-style:italic;font-size:calc(var(--u)*12);line-height:.9;color:#8ca9a54d}.case-card{flex:1;border-top:1px solid var(--mint);border-bottom:1px solid var(--line);padding:calc(var(--u)*2.3) 0;max-width:75%}.case-card h2{margin:.3em 0}.case-card p{color:var(--soft);max-width:36em;margin-top:1em}.case-meta{display:flex;gap:2em;align-items:center;margin:1.5em 0}.tools-small{display:flex;gap:.4em}.tools-small svg{width:calc(var(--u)*2.4);height:calc(var(--u)*2.4);color:var(--mint)}.case-nav{display:flex;gap:1em;align-items:center}.case-nav button{border:1px solid var(--line);height:calc(var(--u)*4.5);width:calc(var(--u)*4.5);text-align:center}.case-nav button:focus{background:#9bf1ca22}.briefing-content{max-width:64%}.briefing-content h2{margin:.35em 0}.briefing-content p{color:var(--soft);margin:.7em 0}.difficulty{display:flex;gap:.7em;margin-top:1.5em}.difficulty button{border:1px solid var(--line);padding:.5em .8em;font-size:.8em}.difficulty button.selected{border-color:var(--mint);background:#b4efd313}.side-note{border-left:1px solid var(--line);padding-left:2em;width:28%;display:flex;flex-direction:column;gap:1em}.side-note .big{font:italic calc(var(--u)*5) Georgia,serif;color:var(--gold)}\n.story-screen{position:absolute;inset:0;background:linear-gradient(0deg,#04151dee 0%,#04151d70 25%,transparent 60%);pointer-events:none!important}.scene-top{position:absolute;top:6%;left:6.5%}.story-dialog{position:absolute;left:6.5%;right:6.5%;bottom:6%;background:#071e24ed;border-top:2px solid var(--mint);padding:1.6em 2em;min-height:24%;pointer-events:auto}.speaker{color:var(--mint);letter-spacing:.15em;font-size:.72em;font-weight:600}.story-text{font-family:Georgia,serif;font-size:calc(var(--u)*2.35);line-height:1.45;margin-top:.5em;max-width:90%}.dialog-footer{display:flex;justify-content:space-between;align-items:center;margin-top:1em}.dialog-footer button{font-size:.7em;min-height:2em;color:var(--soft)}.dialog-next{font-size:.85em!important;color:var(--mint)!important}.drama{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;z-index:60;background:repeating-conic-gradient(from 2deg at 50% 50%,transparent 0deg 6deg,#afeddc17 6.1deg 7deg);opacity:0;transition:opacity .1s}.drama.show{opacity:1}.drama b{display:block;transform:rotate(-4deg);font-size:calc(var(--u)*6);font-style:italic;text-shadow:4px 4px #061c23,-2px -2px #061c23;max-width:90%;text-align:center}\n#hud{position:absolute;inset:0;pointer-events:none;display:none}body.operating #hud{display:block}body.operating #view{cursor:none}.hud-top{position:absolute;top:4.5%;left:4%;right:4%;display:flex;justify-content:space-between;gap:2em}.vitals-block{width:26%;max-width:500px}.hud-label{font-size:.62em;text-transform:uppercase;letter-spacing:.15em;color:#d6e6dd}.vitals-number{font-size:calc(var(--u)*4.2);font-weight:400;letter-spacing:-.08em;line-height:1.05}.vitals-number small{font-size:.3em;letter-spacing:.02em;color:var(--soft);margin-left:.5em}.ecg{width:100%;height:calc(var(--u)*2.25);margin-top:.45em;background:#061b22bd;border-top:1px solid #adc9b33b;border-bottom:1px solid #adc9b33b}.ecg path{stroke:var(--mint);fill:none;stroke-width:2;filter:drop-shadow(0 0 3px #7de8bd)}.ecg.dim{opacity:.35}.clock-block{text-align:center;max-width:45%}.clock-value{font-size:calc(var(--u)*3);letter-spacing:.04em;font-variant-numeric:tabular-nums}.phase-name{color:var(--mint);font-size:.8em;margin:.4em 0}.score-block{text-align:right}.score-value{font-size:calc(var(--u)*2.5);font-variant-numeric:tabular-nums}.chain{color:var(--gold);font-size:.85em;margin-top:.4em}.vitals-bar{height:5px;background:#53706e88;margin-top:.6em}.vitals-bar i{display:block;height:100%;background:var(--mint);transition:width .1s}.hud-low{position:absolute;inset:0;box-shadow:inset 0 0 calc(var(--u)*14) #9e283855;display:none}.low #hud-low{display:block}.tool-bar{position:absolute;bottom:5.3%;left:50%;transform:translateX(-50%);display:flex;gap:calc(var(--u)*.55);align-items:end;pointer-events:auto;background:#071f26dd;padding:.6em .9em;border-top:1px solid var(--line);border-radius:.35em}.tool-button{position:relative;width:calc(var(--u)*4.4);height:calc(var(--u)*4.6);min-width:0;padding:.25em;border:1px solid transparent;display:flex;align-items:center;justify-content:center;transition:transform .1s}.tool-button svg{width:80%;height:80%;color:#b0c4bd}.tool-button .tool-key{position:absolute;top:1px;left:4px;font-size:.48em;color:var(--soft)}.tool-button.active{transform:translateY(-.45em);border:1px solid var(--mint);background:#8ddcc91b}.tool-button.active svg{color:var(--mint)}.tool-name{position:absolute;bottom:-1.35em;left:50%;transform:translateX(-50%);font-size:.55em;white-space:nowrap;letter-spacing:.06em}.op-footer{position:absolute;left:4%;right:4%;bottom:1.6%;display:flex;align-items:center;justify-content:space-between;font-size:.58em;color:#c2d3ca}.op-footer button{pointer-events:auto;color:var(--ink)}.odie-box{position:absolute;left:4%;bottom:21%;max-width:35%;display:flex;gap:.7em;align-items:start;padding:.8em 1em;background:linear-gradient(90deg,#071d26ee,#071d26c0);border-left:2px solid var(--gold)}.odie-avatar{width:2.4em;flex-shrink:0}.odie-box p{font-size:.87em;line-height:1.4}.odie-box .speaker{color:var(--gold);font-size:.51em;margin-bottom:.5em}.rating-pop{position:absolute;top:31%;left:50%;transform:translateX(-50%);font-size:calc(var(--u)*2.5);letter-spacing:.15em;font-weight:700;color:var(--mint);text-shadow:2px 2px #10313b;opacity:0;transition:opacity .2s}.rating-pop.show{opacity:1}.site-tabs{position:absolute;right:3.8%;top:34%;display:grid;gap:.5em;pointer-events:auto;max-width:20%}.site-tabs button{font-size:.65em;background:#07222ae8;border:1px solid var(--line);padding:.8em 1.2em;text-transform:uppercase;letter-spacing:.08em}.site-tabs button.active{border-color:var(--mint);color:var(--mint)}.site-tabs button.danger{border-color:#eb9164}.site-tabs small{display:block;margin-top:.4em;font-size:.9em;color:var(--gold)}.selected-tool{position:absolute;right:4%;bottom:14.5%;text-align:right;max-width:25%}.selected-tool strong{font-weight:400;font-size:1.4em;color:var(--mint)}.selected-tool p{font-size:.63em;color:var(--soft);margin-top:.5em;max-width:20em}.charge-panel{position:absolute;bottom:24%;left:50%;transform:translateX(-50%);width:22%;text-align:center}.charge-bar{height:.55em;background:#203c43;position:relative;margin-top:.5em;border:1px solid var(--line)}.charge-bar .green{position:absolute;left:75%;