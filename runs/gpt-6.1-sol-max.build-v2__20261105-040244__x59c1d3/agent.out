{"type":"item.completed","item":{"id":"item_147","type":"command_execution","command":"/bin/bash -lc \"sed -n '205,228p' labs/game/scenes/op/tools.ts; sed -n '123,148p' labs/game/bot.ts; sed -n '135,155p' labs/game/scenes/op/state.ts; rg -n 'function shock|needsAll|shockSeats|giftUntil' labs/game/scenes/op/gift.ts; sed -n '1,40p' labs/game/data/data.test.ts; wc -l labs/game/main.ts\"","aggregated_output":"  p.charge = 0;\n  if (t.progress >= 0.4) {\n    t.progress = 0;\n    t.dose++;\n    p.cooldown = 24;\n    rate(s, r, p, 'TEXTBOOK', 100);\n    event(s, 'binder', 'BINDER', t.x, t.z, p.id);\n    const need = t.kind === 'matron' || t.kind === 'node' ? 2 : t.kind === 'mercy' ? 3 : 1;\n    if (t.dose >= need) {\n      t.done = true;\n      rate(s, r, p, 'TEXTBOOK', 500);\n      if (t.kind === 'node')\n        for (const f of s.targets) if (f.site === t.site && f.kind === 'balm') f.clip = s.fieldTicks + 36000;\n    }\n  }\n}\nfunction gel(s: Operation, r: Rules, p: Seat, t: Target): void {\n  if (t.kind === 'balm') {\n    t.radius -= 1 / 60;\n    if (t.radius < 0.18) finishTarget(s, r, p, t, 30);\n    return;\n  }\n  let sector: number;\n  if (t.path.length) sector = Math.round((nearest(t.path, p.x, p.z).along / pathLength(t.path)) * 11);\n      else point = [p.start[0] + 1.58, p.start[1]];\n      use = dist([p.x, p.z], point) < 0.15 || p.grab === t.id;\n    }\n  }\n  if (t.kind === 'wound') {\n    const n = t.stitches.length,\n      total = pathLength(t.path),\n      along = clamp(n * (rules?.balance.stitchSpacing ?? 0.45) + 0.02, 0.02, total - 0.04),\n      base = pathAt(t.path, along),\n      next = pathAt(t.path, along + 0.02),\n      dx = next[0] - base[0],\n      dz = next[1] - base[1],\n      length = Math.hypot(dx, dz) || 1,\n      side = t.last >= 0 ? -0.58 : 0.58;\n    point = [base[0] - (dz / length) * side, base[1] + (dx / length) * side];\n    use = dist([p.x, p.z], point) < 0.13;\n  }\n  if (t.kind === 'abrasion' || t.kind === 'numb') {\n    let bit = 0;\n    while (bit < 12 && t.mask & (1 << bit)) bit++;\n    if (t.path.length) point = pathAt(t.path, (pathLength(t.path) * Math.min(11, bit)) / 11);\n    else {\n      const a = ((Math.min(11, bit) + 0.5) / 12) * Math.PI * 2 - Math.PI;\n      point = [t.x + Math.cos(a) * 0.4, t.z + Math.sin(a) * 0.4];\n    }\n  }\n      needsAll: p.allPaddles,\n      shockSeats: [],\n    };\n    event(s, 'code', 'CODE. Both triggers, in the green band.');\n  }\n  if (p.drama) event(s, 'drama', p.drama);\n  event(s, 'phase', p.title);\n}\nexport function createOperation(id: string, seed = 1, humanSeats = 1, phase = 0, rules = defaultRules()): Operation {\n  const c = getCase(id),\n    n = c.id === 'gala-night' || c.id === 'gala-shift' ? c.sites.length : 1;\n  const s: Operation = {\n    caseId: c.id,\n    humans: humanSeats,\n    difficulty: rules.difficulty,\n    seed,\n    tick: 0,\n    fieldTicks: 0,\n    phase: 0,\n    phaseAt: 0,\n    phaseWait: 0,\n8:  seat.giftUntil = s.tick + Math.round(seconds * 60);\n12:    (p) => p.id !== seat.id && p.giftUntil > s.tick && s.tick - (p.giftUntil - Math.round(seconds * 60)) < 60,\n15:    seat.giftUntil += Math.round(seconds * 30);\n16:    partner.giftUntil += Math.round(seconds * 30);\n22:  if (seat.giftKind === 'none' || seat.giftUntil > s.tick) return;\n56:export function shock(s: Operation, seatId = 0): void {\n61:    if (code.needsAll) {\n62:      code.shockSeats ??= [];\n63:      if (!code.shockSeats.includes(seatId)) code.shockSeats.push(seatId);\n64:      if (code.shockSeats.length < s.seats.filter((p) => p.active).length) {\n/** @file Designer data, settings, interview shape, native actions and complete tool/refusal coverage. */\nimport { readFileSync } from 'node:fs';\nimport { it, expect } from 'vitest';\nimport { actionCheck, Animator } from '../../../engine';\nimport { allCases, validateCase } from './cases';\nimport { storyFor, validateStory } from './story';\nimport { BALANCE, defaults } from './balance';\nimport { interview } from './about';\nimport { ACTIONS } from '../cast/actions';\nfor (const c of allCases) it(`validates every phase of ${c.title}`, () => expect(validateCase(c)).toEqual([]));\nfor (let i = 0; i < 8; i++)\n  for (const part of ['before', 'after'] as const)\n    it(`validates story ${i + 1} ${part}`, () => expect(validateStory(storyFor(i, part))).toEqual([]));\nfor (const [key, [value, min, max]] of Object.entries(BALANCE))\n  it(`${key} has a valid, resettable default`, () => {\n    expect(value).toBeGreaterThanOrEqual(min);\n    expect(value).toBeLessThanOrEqual(max);\n    const state = defaults();\n    state[key] = max;\n    expect(defaults()[key]).toBe(value);\n  });\nit('has the exact exit-interview shape and identical About data', () => {\n  const value = JSON.parse(readFileSync(new URL('../../../../exit-interview.json', import.meta.url), 'utf8'));\n  expect(value).toEqual(interview);\n  expect(Object.keys(value)).toEqual([\n    'sourceInformation',\n    'testingFeedback',\n    'engineFeedback',\n    'promptFeedback',\n    'aiHub',\n  ]);\n  expect(Object.keys(value.sourceInformation)).toHaveLength(15);\n  expect(value.testingFeedback).toHaveLength(4);\n  expect(value.engineFeedback).toHaveLength(6);\n  expect(value.promptFeedback).toHaveLength(4);\n  expect(value.sourceInformation.usage).toBe('added on import');\n});\nfor (const a of ACTIONS)\n  it(`checks native animation ${a.id}`, () => {\n    const report = actionCheck(a),\n349 labs/game/main.ts\n","exit_code":0,"status":"completed"}}
