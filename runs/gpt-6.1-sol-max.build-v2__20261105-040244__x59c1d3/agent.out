{"type":"item.started","item":{"id":"item_167","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/view/assets.ts <<'EOF'\n/** @file Harbor Light materials, tissue relief, cinematic looks and procedural hospital surfaces. */\nimport {defineMaterial,defineLook,defineSky,defineTexture,defineGeometry,roundedBoxGeometry} from '../../../engine';\nexport const PALETTE={teal:'#164b4d',navy:'#071a22',brass:'#bd965c',steel:'#b7cdd3',cream:'#e8e4cf',red:'#7e2637',glow:'#75f3cf'};\nfor(const [name,color] of Object.entries(PALETTE))defineMaterial(\"'`material:hl-${name}`,{color,roughness:name==='\"'steel'?.2:.6,metalness:name==='steel'?.7:name==='brass'?.45:0});\ndefineMaterial('material:hl-lit',{color:'#8de8cf',emissive:'#7bdcbd',emissiveIntensity:1.4,roughness:.3});\ndefineMaterial('material:hl-window',{color:'#153544',emissive:'#0a2638',emissiveIntensity:.3,roughness:.2});\ndefineTexture('texture:wet-cells',{description:'Fine cellular relief in living tissue.',size:[128,128],look:'smooth',create:()=> (x,y,t)=>{const v=190+20*Math.sin(x*.61)*Math.sin(y*.57);t.color=[v,v*.92,v*.9];t.height=.5+(v-190)/800;}});\ndefineMaterial('material:tissue',{color:'#ffffff',vertexColors:true,roughness:.4,metalness:.03,map:'texture:wet-cells'});\ndefineMaterial('material:wet',{color:'#ffffff',vertexColors:true,roughness:.44,metalness:0});\ndefineMaterial('material:thread',{color:'#ffffff',vertexColors:true,roughness:.45});\ndefineMaterial('material:field-glow',{color:'#ffffff',vertexColors:true,emissive:'#6bd8cc',emissiveIntensity:.3,roughness:.35});\ndefineMaterial('material:field-steel',{color:'#ffffff',vertexColors:true,roughness:.3,metalness:.5});\ndefineMaterial('material:field-glove',{color:'#ffffff',vertexColors:true,roughness:.7});\ndefineMaterial('material:hl-floor',{color:'#214047',roughness:.48});\ndefineGeometry('geometry:hl-rounded',{description:'Soft machined hospital furniture.',create:()=>roundedBoxGeometry({width:1,height:1,depth:1,radius:.1})});\ndefineSky('sky:harbor',{background:'#07151c',pointLights:1,ambient:{sky:'#bcdfdf',ground:'#476067',intensity:1},sun:{color:'#ffe4c4',intensity:1.6,azimuth:3.7,elevation:1.1},fog:{color:'#091e28',amount:.3,start:22,end:65}});\ndefineLook('look:field',{description:'Glossy living tissue beneath the surgical lamp.',style:'pbr',sky:'sky:harbor',resolution:'full',textures:'smooth',filters:{ao:{scope:'all',strength:.6},aa:{scope:'all'},bloom:{scope:'all',strength:.1}}});\ndefineLook('look:harbor',{description:'Sea-glass walls, brass lamps and storm blue.',style:'toon',sky:'sky:harbor',resolution:'full',textures:'smooth',filters:{ao:{scope:'all',strength:.4},aa:{scope:'all'},bloom:{scope:'all',strength:.15}}});\ndefineLook('look:stillpoint',{description:'A silent teal moment between heartbeats.',filters:{vignette:{scope:'all',strength:.4},grade:{scope:'all',saturation:.3,temperature:-.25}}});\ndefineLook('look:second-pulse',{description:'Amber heat and the rush of certainty.',filters:{speedlines:{scope:'all',amount:.3},grade:{scope:'all',temperature:.3}}});\ndefineLook('look:critical',{description:'The red edge of a failing heartbeat.',filters:{vignette:{scope:'all',strength:.5,color:'#631d2e'}}});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/TESTING-LOG.md');s=p.read_text().replace('## Prompt friction','16. Non-critical — typecheck caught an accidental overwrite of the visual asset module during an edit. Restored the full definitions; the registration check covers them.\\\\n\\\\n## Prompt friction');p.write_text(s)\nPY\nnpx prettier --write labs/game/view/assets.ts labs/game/net/session.ts labs/game/ui/settings.ts\nnpm run typecheck\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
