{"type":"item.completed","item":{"id":"item_152","type":"command_execution","command":"/bin/bash -lc \"sed -n '45,78p' labs/game/input/hands.ts; sed -n '172,219p' labs/game/input/hands.ts; sed -n '252,296p' labs/game/input/hands.ts; sed -n '225,251p' labs/game/scenes/op/state.ts; sed -n '53,100p' labs/game/scenes/op/step.ts\"","aggregated_output":"  claimMode = false;\n  playing = false;\n  touch = matchMedia('(any-pointer:fine)').matches === false;\n  toggle = false;\n  constructor() {\n    addEventListener('keydown', (e) => {\n      this.lastDevice = 'keyboard';\n      this.touch = false;\n      if (this.onActivity()) {\n        e.preventDefault();\n        return;\n      }\n      if (e.repeat) return;\n      this.keys.add(e.code);\n      if (this.playing) {\n        if (e.code === 'Tab' || e.code === 'Space' || e.code.startsWith('Arrow')) e.preventDefault();\n        if (/^Digit[1-8]$/.test(e.code)) this.seats[0][2] = Number(e.code.slice(5)) - 1;\n        if (e.code === 'Space') this.seats[0][4]++;\n        if (e.code === 'KeyF') this.seats[0][2] = 5;\n        if (e.code === 'KeyR') this.buttons.delete(0);\n        if (e.code === 'Tab') this.seats[0][7]++;\n        if (e.code === 'KeyQ') this.seats[0][6]--;\n        if (e.code === 'KeyE') this.seats[0][6]++;\n        if (e.code === 'KeyH') this.onHint();\n        if (e.code === 'Escape') this.onPause();\n        if (e.code === 'Enter') this.toggle = !this.toggle;\n      } else {\n        if (e.code === 'Enter') this.onClaim('keyboard');\n        this.onMenu(e.code);\n      }\n    });\n    addEventListener('keyup', (e) => this.keys.delete(e.code));\n    addEventListener('pointermove', (e) => {\n      if (e.pointerType === 'touch') return;\n        if (lean > 0.15) {\n          const speed = prefs.cursorSpeed * Math.pow(Math.min(1, lean), 2.2) * dt * (precise ? 0.4 : 1);\n          h[0] -= (x / lean) * speed;\n          h[1] += (z / lean) * speed;\n          this.assist(h, s, precise, prefs);\n        }\n        h[3] = Math.max(values[7] ?? 0, values[0] ?? 0) > 0.1 ? 1 : 0;\n        if (s?.code && values[6] > 0.5 && values[7] > 0.5 && ((prev[6] ?? 0) <= 0.5 || (prev[7] ?? 0) <= 0.5)) h[5]++;\n        if (press(3)) h[4]++;\n        if (press(2)) h[2] = 5;\n        if (press(4)) h[2] = (h[2] + 7) % 8;\n        if (press(5)) h[2] = (h[2] + 1) % 8;\n        if (press(14)) h[6]--;\n        if (press(15)) h[6]++;\n        if (press(12)) this.onHint();\n        if (press(11)) h[7]++;\n        if (press(9) && values[8] < 0.5) this.onPause();\n        const rx = pad.axes[2] ?? 0,\n          ry = pad.axes[3] ?? 0,\n          rad = Math.hypot(rx, ry);\n        if (rad > 0.4) {\n          const selected = (Math.round((Math.atan2(ry, rx) + Math.PI / 2) / (Math.PI / 4)) + 8) % 8;\n          this.radial = { x: innerWidth * 0.5, y: innerHeight * 0.55, selected, pad: true };\n          h[8] = 1;\n        } else if (this.radial?.pad) {\n          h[2] = this.radial.selected;\n          this.radial = null;\n          h[8] = 0;\n        }\n        if (press(1)) {\n          h[3] = 0;\n          this.radial = null;\n          h[8] = 0;\n        }\n      }\n      this.previousPads[pad.index] = values;\n    }\n  }\n  private assist(h: Hand, s: Operation | undefined, precision: boolean, prefs: Preferences): void {\n    if (!s || !prefs.assist) return;\n    const t = s.targets\n      .filter((t) => !t.done && t.site === h[6] && RESPONSE[TOOLS[h[2]]][t.kind] === 'effect')\n      .sort((a, b) => distanceTo(a, h[0], h[1]) - distanceTo(b, h[0], h[1]))[0];\n    if (t && distanceTo(t, h[0], h[1]) < 0.65) {\n      const p = t.path.length ? nearest(t.path, h[0], h[1]).point : [t.x, t.z];\n      const factor = precision ? 0.3 : 0.12;\n      h[0] += (p[0] - h[0]) * factor;\n      h[1] += (p[1] - h[1]) * factor;\n        ? 0\n        : prefs.toggleUse\n          ? this.toggle\n            ? 1\n            : 0\n          : this.buttons.has(0) || input?.held('use')\n            ? 1\n            : 0;\n      h[8] = this.radial ? 1 : 0;\n    }\n    for (const hand of this.seats) {\n      hand[0] = clamp(hand[0], -7.2, 7.2);\n      hand[1] = clamp(hand[1], -3.4, 3.4);\n      if (s)\n        hand[6] =\n          (Math.round(hand[6]) + (s.caseId === 'gala-night' ? 3 : 3) * 10) %\n          (s.caseId === 'crosstalk' || s.caseId === 'gala-night'\n            ? 3\n            : s.caseId === 'reverie' || s.caseId === 'gala-shift'\n              ? 2\n              : 1);\n    }\n    return this.seats;\n  }\n}\n  base = 100,\n  rating: Rating = 'TEXTBOOK',\n): void {\n  t.done = true;\n  rate(s, rules, seat, rating, base, t.x, t.z);\n  if (t.kind === 'wound' || t.kind === 'incision')\n    spawn(s, {\n      kind: t.kind === 'incision' ? 'wound' : 'abrasion',\n      at: [t.x, t.z],\n      path: t.path,\n      site: t.site,\n      required: false,\n    });\n  if (t.kind === 'lull') spawn(s, { kind: 'cocoon', at: [t.x, t.z], site: t.site });\n}\nexport function fail(s: Operation, reason: string): void {\n  s.status = 'lost';\n  s.reason = reason;\n  event(s, 'lost', reason);\n}\nexport function slip(s: Operation, rules: Rules, seat: Seat, text: string): void {\n  if (s.tick - seat.lastSlip < 60) return;\n  seat.lastSlip = s.tick;\n  s.slips++;\n  seat.slips++;\n  s.chain = 1;\n  seat.chain = 1;\n          event(s, 'say', p.giftKind === 'pulse' ? 'Sabine has the field.' : 'Wren has the field.');\n        }\n      }\n    }\n    if (!s.code) useTool(s, r, p, h[3] > 0);\n    for (const t of s.targets) if (t.kind === 'tendril' && t.done && !t.clip) t.clip = s.fieldTicks + 60000;\n  }\n  updateGift(s, r);\n  updateStrains(s, r, delta);\n  bleed(s, r, delta);\n  if (!r.freezeVitals && !r.attract) {\n    for (let i = 0; i < s.patients.length; i++) {\n      let drain = 0;\n      for (const t of s.targets) {\n        if (t.done || patientAt(s, t.site) !== i) continue;\n        if (t.kind === 'wound') drain += t.deep ? 1.2 : 0.5;\n        if (t.kind === 'bleeder') drain += 0.5;\n        if (t.kind === 'lull') drain += 0.6;\n        if (t.kind === 'numb') drain += 0.2;\n        if (t.kind === 'balm') drain += t.radius * t.radius * 0.04;\n        if (t.kind === 'wound' && t.generation === 2 && s.fieldTicks - t.born > 120000) t.deep = true;\n      }\n      if (!s.seats.some((p) => p.giftUntil > s.tick && p.giftKind === 'pulse'))\n        s.patients[i] -=\n          ((drain * delta) / 6000) *\n          r.balance.vitalsDrain *\n          (r.difficulty === 'Intern' ? 0.6 : r.difficulty === 'Attending' ? 1.3 : 1);\n      if (s.patients[i] <= 0 && !s.code) {\n        if (c.id === 'first-cut' || c.id === 'quiet-lump' || s.codes[i] >= 1) fail(s, 'The rhythm is gone.');\n        else {\n          s.patients[i] = 0;\n          s.code = { patient: i, until: s.fieldTicks + 48000, tries: 0, scripted: false };\n          event(s, 'code', 'CODE. Charge the paddles.');\n        }\n      }\n    }\n  }\n  if (s.code && s.fieldTicks > s.code.until && !r.attract) fail(s, 'The charge window closed.');\n  if (!r.freezeClock && !r.attract) s.left = Math.max(0, s.left - delta);\n  if (s.left === 0 && !r.attract) fail(s, 'Time of death. You ran out of time.');\n  const phase = c.phases[s.phase];\n  if (phase.goal === 'race' && s.fieldTicks - s.phaseAt > 180000 && !r.attract)\n    fail(s, 'Thirty seconds. The ventricle could not wait.');\n  if (s.status !== 'playing') return;\n  const goals = s.targets.filter((t) => t.required && !t.done && t.kind !== 'flap');\n  const complete = phase.goal === 'stabilize' ? s.patients[0] >= 58 : goals.length === 0;\n  const giftDone = phase.goal !== 'gift' || s.seats.some((p) => p.giftUntil > 0);\n  if (complete && !s.code && giftDone) {\n","exit_code":0,"status":"completed"}}
