{"type":"item.started","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/view/camera.ts <<'EOF'\n/** @file Native camera modes for surgical parallax, precision, ship roll, flap inspection and dramatic close-ups. */\nimport {defineCamera,followCamera,makePose,type CameraPose} from '../../../engine';\nexport const surgicalCue={x:0,z:0,precision:false,ship:false,time:0,flap:0,failed:false,site:0};\nexport const storyCue={x:9,y:5,z:-12,yaw:-33,pitch:-16,roll:0};\ninterface SurgicalState{x:number;y:number;z:number;yaw:number;pitch:number;roll:number;fov:number;site:number;}\nconst start:SurgicalState={x:0,y:19,z:-5,yaw:0,pitch:-72*Math.PI/180,roll:0,fov:42,site:0};\nconst lerp=(from:number,to:number,k:number):number=>from+(to-from)*k;\ndefineCamera('surgeon',{description:'Above living tissue: precision dolly, parallax, flap tilt and a rolling ship.',create(){return followCamera('surgeon',{...start},{\n step(s,_input,dt){const k=1-Math.exp(-dt*6),cue=surgicalCue,shift=cue.site\"'!==s.site?(cue.site>s.site?1.2:-1.2):s.x;\n  return {x:lerp(shift,-cue.x*.025,k),y:lerp(s.y,cue.failed?22:15,k),z:lerp(s.z,-5-cue.z*.02,k),yaw:lerp(s.yaw,-cue.x*.0025,k),pitch:lerp(s.pitch,(-72+cue.z*.35+cue.flap*4)*Math.PI/180,k),roll:lerp(s.roll,cue.ship?Math.sin(cue.time*Math.PI*2/7)*Math.PI/30:0,k),fov:lerp(s.fov,cue.precision?36:42,k),site:cue.site};\n },pose:s=>makePose({position:[s.x,s.y,s.z],yaw:s.yaw,pitch:s.pitch,roll:s.roll,fov:s.fov,distance:16}),spec:()=>({}),code:()=> '\"'cam3=surgeon',describe:()=> 'A surgeon above the operating field.'});}});\ndefineCamera('harbor',{description:'A staged native portrait camera that can bank into a Drama Cut.',create(){return followCamera('harbor',{x:storyCue.x,y:storyCue.y,z:storyCue.z,yaw:storyCue.yaw,pitch:storyCue.pitch,roll:0},{step(s,_i,dt){const k=1-Math.exp(-dt*7);return {x:lerp(s.x,storyCue.x,k),y:lerp(s.y,storyCue.y,k),z:lerp(s.z,storyCue.z,k),yaw:lerp(s.yaw,storyCue.yaw,k),pitch:lerp(s.pitch,storyCue.pitch,k),roll:lerp(s.roll,storyCue.roll,k)};},pose:s=>makePose({position:[s.x,s.y,s.z],yaw:s.yaw*Math.PI/180,pitch:s.pitch*Math.PI/180,roll:s.roll,fov:38}) as CameraPose,spec:()=>({}),code:()=> 'cam3=harbor',describe:()=> 'Port Verity, seen from the room.'});}});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { meshes }\\\", \\\"import { surgicalCue, storyCue } from './view/camera';\\\\nimport { meshes }\\\")\ns=s.replace(\\\"'fixed,0,15,-5,0,-72,42'\\\", \\\"'surgeon'\\\")\ns=s.replace(\\\"'cam3=fixed,0,15,-5,0,-72,42'\\\", \\\"'cam3=surgeon'\\\")\ns=s.replace(\\\"camera(op ? 'cam3=surgeon' : 'cam3=fixed,9,5,-12,-33,-16,46', false);\\\", \\\"camera(op ? 'cam3=surgeon' : runId.startsWith('story:') ? 'cam3=harbor' : 'cam3=fixed,9,5,-12,-33,-16,46', false);\\\")\ns=s.replace(\\\"  const inputs = hands.frame\\\", \\\"  hands.claimMode = d.screen === 'scrub';\\\\n  const inputs = hands.frame\\\")\ns=s.replace(\\\"    drawField(view, f.dt, prefs.blood);\\\", \\\"    Object.assign(surgicalCue,{x:inputs[0]?.[0]??0,z:inputs[0]?.[1]??0,precision:hands.keys.has('ShiftLeft'),ship:operation.caseId==='struck-off'&&operation.phase>0,time:operation.fieldTicks/6000,flap:Math.max(0,...operation.targets.filter(t=>t.kind==='flap'&&\"'!t.done).map(t=>t.lift)),failed:operation.status==='\"'lost',site:localSite});\\\\n    drawField(view, f.dt, prefs.blood);\\\")\ns=s.replace(\\\"      sound.say(b.who, b.text, prefs);\\\", \\\"      sound.say(b.who, b.text, prefs);\\\\n      const cast=[...new Set(story.beats.map(b=>b.who))],actorX=-3.5+cast.indexOf(b.who)*1.45;Object.assign(storyCue,{x:actorX+.8,y:1.9,z:.1,yaw:-12,pitch:-4,roll:b.drama&&prefs.flashes?-.1:0});\\\")\np.write_text(s)\np=Path('labs/game/input/hands.ts');s=p.read_text().replace('  playing = false;', '  claimMode = false;\\\\n  playing = false;').replace(\\\"        if (press(0)) this.onClaim(pad.index);\\\", \\\"        const justClaimed=press(0)&&this.claimMode&&\"'!this.devices.includes(pad.index);'\"\\\\n        if (justClaimed) this.onClaim(pad.index);\\\").replace(\\\"if (press(i)) this.onMenu(action);\\\", \\\"if (press(i)&&\"'!(i===0&&justClaimed)) this.onMenu(action);\")\np.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
