{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor name in ['main.ts','ui/dev.ts','ui/devActions.ts','ui/index.ts','ui/settings.ts']:\n p=Path('labs/game')/name;s=p.read_text().replace('?.inspector.', '?.inspector?.').replace('?.input.bindings','?.input?.bindings');\n if name=='main.ts':s=s.replace('engine?.inspector.set','engine?.inspector?.set').replace('if(\"'!engine)return;'\"', 'if(\"'!engine?.inspector)return;'\"').replace('frame=f;if(\"'!engine)return;'\"', 'frame=f;if(\"'!engine?.inspector)return;'\"').replace('operation,engine.input)', 'operation,engine.input??undefined)')\n p.write_text(s)\nPY\nmkdir -p out/visual\ncat > labs/game/tools/visual.py <<'EOF'\n# A real WebGPU browser boot and a small set of visual checks, saved under the game's own out directory.\nimport os,json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path.cwd();ident=json.loads((root/'identity.json').read_text());url=(root.parent/(ident['base']+'.html')).as_uri()\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n page=browser.new_page(viewport={'width':1920,'height':1080},device_scale_factor=1)\n errors=[];page.on('pageerror',lambda e: errors.append(str(e)))\n page.goto(url);page.wait_for_timeout(1500)\n try:page.wait_for_function('\"'!!window.__surgery && !!window.__engine?.ready'\"',timeout=90000)\n except Exception:pass\n print(json.dumps({'errors':errors,'text':page.locator('body').inner_text()[:1200],'state':page.evaluate('({gpu:\"'!!navigator.gpu,game:!!window.__surgery,engine:!!window.__engine,errors:window.__engine?.errors})'\"')}))\n page.screenshot(path=str(root/'out/visual/title.png'))\n if page.evaluate('\"'!!window.__surgery'\"'):\n  page.evaluate(\\\"window.__surgery.case('first-cut')\\\")\n  page.wait_for_timeout(2000)\n  print(json.dumps({'meshes':page.evaluate('window.__surgery.meshes'),'state':page.evaluate('({status:window.__surgery.state?.status,errors:window.__engine?.errors})')}))\n  page.screenshot(path=str(root/'out/visual/field.png'))\n browser.close()\nEOF\nTMPDIR=/tmp/g.5ozaaka0 python3 labs/game/tools/visual.py\"","aggregated_output":"{\"errors\": [\"[CORE_BAD_SPEC] devAction \\\"surgery-control\\\": the name \\\"surgery-control\\\" must be a word in camelCase (timeScale): give each field a value of its type inside its range and values, every required field, and no key the schema lacks (node x describe <kind> lists the fields)\"], \"text\": \"PREPARING THE THEATRE\", \"state\": {\"gpu\": true, \"game\": false, \"engine\": false, \"errors\": null}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/op/rules.test.ts <<'EOF'\n/** @file Surgery rule tests: actual inputs and visible state changes, ratings, physiology and failure. */\nimport {describe,it,expect} from 'vitest';\nimport {createOperation,defaultRules,spawn,rank} from './state';\nimport {stepOperation} from './step';\nimport {useTool} from './tools';\nimport {activate,pressGift,shock} from './gift';\nimport {TOOLS,KINDS,RESPONSE} from '../../data/tools';\nimport type {Hand,TargetKind} from '../../data/types';\nconst hand=(x=0,z=0,tool=3,use=0,site=0):Hand=>[x,z,tool,use,0,0,site,0,0];\ndescribe('instruments and physiology',()=>{\n for(const tool of TOOLS)it(\"'`${tool} has a response for every target`,()=>{for(const kind of KINDS)expect(RESPONSE[tool][kind].length).toBeGreaterThan(0);});\n it('\"'drains a real pool and awards points once',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0],t=s.targets[0];p.x=t.x;p.z=t.z;p.tool=3;for(let i=0;i<100;i++)useTool(s,r,p,true);expect(t.done).toBe(true);expect(s.score).toBeGreaterThan(0);const score=s.score;for(let i=0;i<10;i++)useTool(s,r,p,true);expect(s.score).toBe(score);});\n it('does not penalize a wrong tool',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0];p.tool=4;p.x=s.targets[0].x;p.z=s.targets[0].z;useTool(s,r,p,true);expect(s.slips).toBe(0);expect(s.events.some(e=>e.type==='refusal')).toBe(true);});\n it('stabilizer rewards its green band and has a cooldown',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0];s.patients[0]=40;p.x=7;p.z=3;p.tool=5;for(let i=0;i<51;i++)useTool(s,r,p,true);useTool(s,r,p,false);expect(s.patients[0]).toBe(64);expect(p.cooldown).toBe(120);expect(s.rating).toBe('TEXTBOOK');});\n it('underfilled and overfilled doses have distinct results',()=>{for(const [ticks,vitals] of [[15,46],[66,46]]){const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0];s.patients[0]=40;p.x=7;p.tool=5;for(let i=0;i<ticks;i++)useTool(s,r,p,true);useTool(s,r,p,false);expect(s.patients[0]).toBeCloseTo(vitals,3);}});\n it('offscreen sites continue bleeding',()=>{const r=defaultRules(),s=createOperation('crosstalk'),start=s.patients[0];for(let i=0;i<60;i++)stepOperation(s,[hand(7,3,3,0,2)],r);expect(s.patients[0]).toBeCloseTo(start-3,2);});\n it('a clock expiry fails an operation',()=>{const s=createOperation('first-cut');s.left=100;stepOperation(s,[],defaultRules());expect(s.status).toBe('lost');expect(s.reason).toContain('time');});\n it('too many unsafe cuts leave real wounds and fail',()=>{const s=createOperation('first-cut'),r=defaultRules();for(let i=0;i<600&&s.status==='playing';i++)stepOperation(s,[hand(6,3,0,1)],r);expect(s.targets.some(t=>t.kind==='wound')).toBe(true);expect(s.slips).toBeGreaterThan(5);expect(s.status).toBe('lost');});\n it('opens a Code and revives in the green band',()=>{const r=defaultRules(),s=createOperation('crosstalk');s.patients[0]=0;stepOperation(s,[],r);expect(s.code).not.toBeNull();s.tick=110;shock(s);expect(s.code).toBeNull();expect(s.patients[0]).toBe(25);});\n it('two missed shocks fail',()=>{const s=createOperation('crosstalk');s.code={patient:0,until:48000,tries:0,scripted:false};s.tick=1;shock(s);shock(s);expect(s.status).toBe('lost');});\n it('Stillpoint slows only field time',()=>{const s=createOperation('crosstalk'),r=defaultRules();activate(s,r,s.seats[0],6);stepOperation(s,[],r);expect(s.fieldTicks).toBe(25);expect(s.tick).toBe(1);expect(s.left).toBe(1800000-25);});\n it('Second Pulse protects shared vitals',()=>{const s=createOperation('struck-off'),r=defaultRules();spawn(s,{kind:'wound',at:[4,0],path:[[3,0],[5,0]],deep:true});s.patients[0]=50;activate(s,r,s.seats[0],6);for(let i=0;i<60;i++)stepOperation(s,[],r);expect(s.patients[0]).toBe(50);expect(s.fieldTicks).toBe(6000);});\n it('Simple Gift reliably grants six seconds',()=>{const r=defaultRules();r.simpleGift=true;const s=createOperation('crosstalk');pressGift(s,r,s.seats[0]);expect(s.seats[0].giftUntil).toBe(360);expect(s.seats[0].gift).toBe(0);});\n it('Consult lengthens both Gifts',()=>{const r=defaultRules(),s=createOperation('reverie');activate(s,r,s.seats[0],6);s.tick=1;activate(s,r,s.seats[1],6);expect(s.seats[0].giftUntil).toBe(540);expect(s.seats[1].giftUntil).toBe(541);expect(s.events.some(e=>e.text==='CONSULT\"'!'\"')).toBe(true);});\n it('a checkpoint retry caps rank at B',()=>{const s=createOperation('first-cut');s.score=99999;s.retry=true;expect(rank(s)).toBe('B');});\n for(const kind of ['lull','solace','reverie','matron','mercy','node'] as TargetKind[])it(\"'`${kind} is a live, addressable body target`,()=>{const s=createOperation('\"'first-cut');const t=spawn(s,{kind,at:[1,1]});expect(s.targets.find(x=>x.id===t.id)).toBe(t);expect(t.done).toBe(false);});\n});\nEOF\ncat > labs/game/scenes/play.test.ts <<'EOF'\n/** @file The full game is won by real bot inputs; engine capture/restore and all replay goldens must agree. */\nimport {readFileSync,existsSync} from 'node:fs';\nimport {describe,it,expect} from 'vitest';\nimport {createHeadless} from '../../../engine';\nimport {main} from './main';\nimport {allCases,CASES} from '../data/cases';\nimport {botHands,botHand} from '../bot';\nimport {createOperation,defaultRules} from './op/state';\nimport {stepOperation} from './op/step';\nimport {readOperation} from '../net/session';\nimport {Director} from '../app/director';\nimport type {Difficulty,Rules} from '../data/types';\nfunction play(id:string,seed:number,seats=1,difficulty:Difficulty='Resident',limited=false){\n const rules=defaultRules();rules.difficulty=difficulty;const s=createOperation(id,seed,seats,0,rules);\n for(let k=0;k<60000&&s.status==='playing';k++){const hands=botHands(s,rules);if(limited&&s.seats.length>1)hands[1]=botHand(s,1,rules,true);stepOperation(s,hands,rules);}return s;\n}\ndescribe('a complete playable shift',()=>{\n for(const c of allCases)it(\"'`the bot completes ${c.title} on ${process.env.BOT_SEEDS??3} seeds`,()=>{for(let seed=1;seed<=Number(process.env.BOT_SEEDS??3);seed++){const s=play(c.id,seed);expect({seed,status:s.status,phase:s.phase,reason:s.reason,live:s.targets.filter(t=>!t.done&&t.required).map(t=>t.kind)}).toMatchObject({status:'\"'won'});}});\n for(const difficulty of ['Intern','Attending'] as Difficulty[])for(const id of ['first-cut','mercy'])it(\"'`completes ${id} on ${difficulty}`,()=>{expect(play(id,3,1,difficulty).status).toBe('\"'won');});\n for(const seats of [2,4])for(const id of ['first-cut','gala-shift','mercy'])it(\"'`${seats} surgeons complete ${id}`,()=>{expect(play(id,5,seats).status).toBe('\"'won');});\n for(const id of ['struck-off','reverie','gala-night','mercy'])it(\"'`${id} is winnable with the limited AI colleague`,()=>{const s=play(id,7,1,'\"'Resident',true);expect({status:s.status,phase:s.phase,reason:s.reason}).toMatchObject({status:'won'});});\n it('walks title, all story scenes, briefings, surgery, results and postcards to credits',()=>{\n  const d=new Director();d.newShift();for(const c of CASES){expect(d.screen).toBe('story');while(d.screen==='story')d.advanceStory();expect(d.screen).toBe('briefing');d.start();const s=play(c.id,1);expect(s.status).toBe('won');d.finish(s);expect(d.screen).toBe('debrief');d.continueResult();expect(d.screen).toBe('postcard');d.continueResult();while(d.screen==='story'&&d.part==='after')d.advanceStory();}\n  expect(d.screen).toBe('credits');expect(d.progress.ended).toBe(true);expect(Object.keys(d.progress.postcards)).toHaveLength(8);expect(d.progress.unlocked).toBe(8);\n });\n it('the engine continues exactly after capture and restore',async()=>{\n  const e=await createHeadless({scene:main,seed:3,settings:{'game.run':'op:first-cut'}});\n  for(let i=0;i<120;i++)e.step(1,{'game:hands':botHands(readOperation(e)\"'!)});\n  const capture=e.capture();for(let i=0;i<120;i++)e.step(1,{'\"'game:hands':botHands(readOperation(e)\"'!)});const hash=e.hash();\n  e.restore(capture);for(let i=0;i<120;i++)e.step(1,{'\"'game:hands':botHands(readOperation(e)\"'!)});expect(e.hash()).toBe(hash);\n });\n it('\"'the engine is won by the same bot',async()=>{const e=await createHeadless({scene:main,seed:2,settings:{'game.run':'op:first-cut'}});for(let i=0;i<4000&&readOperation(e)?.status==='playing';i++)e.step(1,{'game:hands':botHands(readOperation(e)\"'!)});expect(readOperation(e)?.status).toBe('\"'won');});\n for(const c of CASES)it(\"'`replays ${c.title} to its recorded engine hashes`,async()=>{\n  const file=new URL(`../replays/${c.id}.replay.json`,import.meta.url);expect(existsSync(file)).toBe(true);if(!existsSync(file))return;\n  const replay=readFileSync(file,'\"'utf8'),e=await createHeadless({scene:main});const result=await(e.replay as (text:string)=>Promise<{hashes:Record<string,string>}>)(replay);const goldens=JSON.parse(replay).hashes[\"'`${process.platform}-${process.arch}`];expect(result.hashes).toEqual(goldens);\n });\n});\nEOF\ncat > labs/game/data/data.test.ts <<'\"'EOF'\n/** @file Designer data, settings, interview shape, native actions and complete tool/refusal coverage. */\nimport {readFileSync} from 'node:fs';\nimport {it,expect} from 'vitest';\nimport {actionCheck} from '../../../engine';\nimport {allCases,validateCase} from './cases';\nimport {storyFor,validateStory} from './story';\nimport {BALANCE,defaults} from './balance';\nimport {interview} from './about';\nimport {ACTIONS} from '../cast/actions';\nfor(const c of allCases)it(\"'`validates every phase of ${c.title}`,()=>expect(validateCase(c)).toEqual([]));\nfor(let i=0;i<8;i++)for(const part of ['\"'before','after'] as const)it(\"'`validates story ${i+1} ${part}`,()=>expect(validateStory(storyFor(i,part))).toEqual([]));\nfor(const [key,[value,min,max]] of Object.entries(BALANCE))it(`${key} has a valid, resettable default`,()=>{expect(value).toBeGreaterThanOrEqual(min);expect(value).toBeLessThanOrEqual(max);const state=defaults();state[key]=max;expect(defaults()[key]).toBe(value);});\nit('\"'has the exact exit-interview shape and identical About data',()=>{const value=JSON.parse(readFileSync(new URL('../../../../exit-interview.json',import.meta.url),'utf8'));expect(value).toEqual(interview);expect(Object.keys(value)).toEqual(['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub']);expect(Object.keys(value.sourceInformation)).toHaveLength(16);expect(value.testingFeedback).toHaveLength(4);expect(value.engineFeedback).toHaveLength(6);expect(value.promptFeedback).toHaveLength(4);expect(value.sourceInformation.usage).toBe('added on import');});\nfor(const a of ACTIONS)it(\"'`checks native animation ${a.id}`,()=>{const report=actionCheck(a);expect(report.ok).toBe(true);});\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/op/rules.test.ts <<'EOF'\n/** @file Surgery rule tests: actual inputs and visible state changes, ratings, physiology and failure. */\nimport {describe,it,expect} from 'vitest';\nimport {createOperation,defaultRules,spawn,rank} from './state';\nimport {stepOperation} from './step';\nimport {useTool} from './tools';\nimport {activate,pressGift,shock} from './gift';\nimport {TOOLS,KINDS,RESPONSE} from '../../data/tools';\nimport type {Hand,TargetKind} from '../../data/types';\nconst hand=(x=0,z=0,tool=3,use=0,site=0):Hand=>[x,z,tool,use,0,0,site,0,0];\ndescribe('instruments and physiology',()=>{\n for(const tool of TOOLS)it(\"'`${tool} has a response for every target`,()=>{for(const kind of KINDS)expect(RESPONSE[tool][kind].length).toBeGreaterThan(0);});\n it('\"'drains a real pool and awards points once',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0],t=s.targets[0];p.x=t.x;p.z=t.z;p.tool=3;for(let i=0;i<100;i++)useTool(s,r,p,true);expect(t.done).toBe(true);expect(s.score).toBeGreaterThan(0);const score=s.score;for(let i=0;i<10;i++)useTool(s,r,p,true);expect(s.score).toBe(score);});\n it('does not penalize a wrong tool',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0];p.tool=4;p.x=s.targets[0].x;p.z=s.targets[0].z;useTool(s,r,p,true);expect(s.slips).toBe(0);expect(s.events.some(e=>e.type==='refusal')).toBe(true);});\n it('stabilizer rewards its green band and has a cooldown',()=>{const r=defaultRules(),s=createOperation('first-cut'),p=s.seats[0];s.patients[0]=40;p.x=7;p.z=3;p.tool=5;for(let i=0;i<51;i++)useTool(s,r,p,true);useTool(s,r,p,false);expect(s.patients[0]).toBe(64);expect(p.cooldown).toBe(120);expect(s.rating).toBe('TEXTBOOK');});\n it('underfilled and overfilled doses have distinct results',()=>{for(const [ticks,vitals] of [[15,46],[66,46]]){const r=defaultRules(),s=createOperation('first-