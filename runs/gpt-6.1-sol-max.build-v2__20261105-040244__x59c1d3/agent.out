{"type":"item.started","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/view/field/index.ts');s=p.read_text().replace('export function drawField(s: Operation, dt: number, blood: string): void {', \\\"export function drawField(s: Operation, dt: number, blood: string, debug:{shapes:boolean;assist:boolean;path:number[][]}={shapes:false,assist:false,path:[]}): void {\\\")\ns=s.replace('  drawHands(s, dt);', '''  drawHands(s, dt);\n  if(debug.shapes)for(const t of s.targets)if(\"'!t.done&&t.site===s.seats[0].site){meshes.glow.ring(t.x,fieldHeight(t.x,t.z,s)+.12,t.z,t.radius+.45,.025,'\"'#ffdf8f');if(t.path.length)meshes.glow.line(t.path.map(p=>[p[0],fieldHeight(p[0],p[1],s)+.12,p[1]]),.035,'#ffdf8f');}\n  if(debug.assist){const p=s.seats[0];meshes.glow.ring(p.x,fieldHeight(p.x,p.z,s)+.12,p.z,.65,.025,'#a4c9ff');}\n  if(debug.path.length>1)meshes.glow.line(debug.path.map(p=>[p[0],fieldHeight(p[0],p[1],s)+.14,p[1]]),.055,'#ffe4a1');\n  if(s.caseId==='struck-off'){const drift=Math.sin(s.fieldTicks/6000*Math.PI*2/7)*.4;for(const sign of [-1,1])meshes.steel.line([[sign*8+drift,.3,2],[sign*8.4+drift,.3,3]],.07,'#d9e2d4');}''')\np.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace('    drawField(view, f.dt, prefs.blood);', '''    drawField(view, f.dt, prefs.blood,{shapes:ui.dev.shapes,assist:ui.dev.assist,path:ui.dev.author?ui.dev.path:[]});\n    let debug=document.getElementById('dev-overlay');if(ui.dev.author||ui.dev.shapes||ui.dev.assist){if(\"'!debug){debug=document.createElement('\"'div');debug.id='dev-overlay';debug.className='view-debug';document.getElementById('app')\"'!.append(debug);}debug.textContent=`Cursor [${inputs[0]?.[0].toFixed(2)}, ${inputs[0]?.[1].toFixed(2)}] m'\"\\\\\\\\nSim \"'${view.tick} · field ${view.fieldTicks}'\"\\\\\\\\n\"'${ui.dev.author?'\"'PATH AUTHOR · Esc returns to tools':''}\"'`;}else debug?.remove();'\"''');p.write_text(s)\np=Path('labs