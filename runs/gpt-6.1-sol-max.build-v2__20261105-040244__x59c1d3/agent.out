oint.\nengine/sim/replay.ts-18- * Every value is checked first (`SIM_BAD_REPLAY` naming the path and the closest key), unknown keys included.\nengine/sim/replay.ts-19- * `judgeRuns` gives the verdict on runs (golden match or mismatch; on another platform, the runs against each other)\nengine/sim/replay.ts-20- * and `firstDifference` plus `partingOf` say where two runs part: the step, then the parts, entities and fields.\nengine/sim/replay.ts-21- *\nengine/sim/replay.ts-22- * @example\nengine/sim/replay.ts-23- * import { createRegistry } from '../core/registry';\nengine/sim/replay.ts-24- * import { defineScene } from './scene';\nengine/sim/replay.ts-25- * import { createSession } from './session';\nengine/sim/replay.ts-26- * const reg = createRegistry();\nengine/sim/replay.ts-27- * defineScene('walk', { setup: (w) => w.spawn(), step: (w, i) => void w.rng('walk').next() }, reg);\nengine/sim/replay.ts-28- * const live = createSession('walk', { seed: 2, registry: reg });\nengine/sim/replay.ts-29- * live.step({ move: [0, 1] });\nengine/sim/replay.ts:30: * const replay = { ...live.record(), hashes: { 'linux-x64': { 1: live.world.hash() } } };\nengine/sim/replay.ts:31: * const runs = [0, 1, 2].map(() => playReplay(replay, { registry: reg }).hashes);\nengine/sim/replay.ts-32- * judgeRuns(replay, runs, 'linux-x64'); // { golden: 'match' }\nengine/sim/replay.ts-33- * judgeRuns(replay, runs, 'darwin-arm64'); // { golden: 'other platform', platforms: ['linux-x64'] }\nengine/sim/replay.ts-34- * @see engine/sim/replay.test.ts\nengine/sim/replay.ts-35- */\nengine/sim/replay.ts-36-import { serialize, type Canonical } from '../core/hash';\nengine/sim/replay.ts-37-import { closest, codeError, defineCodes, didYouMean } from '../core/log';\nengine/sim/replay.ts-38-import { registry as sharedRegistry } from '../core/registry';\nengine/sim/replay.ts-39-import { isPlainObject, show } from '../core/schema';\nengine/sim/replay.ts-40-import type { SettingValue } from '../core/settings';\neng