d',\n      'Close all three before thirty seconds pass.',\n      [wound(-3, 1, 0, true), wound(2.7, 1, 0, true), wound(0, -1.5, 0, true)],\n      { goal: 'race' },\n    ),\n    phase(\n      'last-rites',\n      'MERCY / III — Last Rites',\n      'Follow the guide as the ventricle beats.',\n      [at('incision', 0, 0, { path: circle(0, 0, 1.7) })],\n      { drama: 'WE ARE NOT FINISHED.' },\n    ),\n    phase(\n      'tendrils',\n      'Five hands around a heart',\n      'Forceps. Free all five tendrils before they reattach.',\n      Array.from({ length: 5 }, (_, i) =>\n        at('tendril', Math.cos((i * Math.PI * 2) / 5) * 2.4, Math.sin((i * Math.PI * 2) / 5) * 2),\n      ),\n    ),\n    phase(\n      'binder-finish',\n      'One Gift. Three points.',\n      'A Gift is yours. Activate it, then Binder into all three gold marks.',\n      [at('binder', -2, -0.8), at('binder', 2, -0.8), at('binder', 0, 1.6)],\n      { gift: true, goal: 'gift-binder' },\n    ),\n    phase('final-code', 'Bring him back', 'Every surgeon. One heartbeat. Charge the paddles.', [], { code: true }),\n    close(),\n  ],\n} satisfies Case;\nlabs/game/scenes/op/state.ts:180:    retry: phase > 0,\nlabs/game/scenes/op/state.ts:278:  if (s.retry && (r === '★' || r === 'S' || r === 'A')) r = 'B';\nlabs/game/scenes/main.ts:73:      s.retry ||= w.settings.get<boolean>('game.retry');\nlabs/game/ui/index.ts:170:      c.set('game.retry', false);\nlabs/game/ui/index.ts:184:    } else if (id === 'retry') {\nlabs/game/ui/index.ts:185:      c.set('game.retry', false);\nlabs/game/ui/index.ts:187:    } else if (id === 'retry-phase') {\nlabs/game/ui/index.ts:188:      c.set('game.retry', true);\nlabs/game/data/balance.ts:45:  'game.retry': { type: 'boolean', default: false, when: 'scene', description: 'Checkpoint retry caps rank at B.' },\n/** @file Original Harbor Light materials, looks and procedural hospital props on the engine geometry kit. */\nimport {\n  defineMaterial,\n  defineLook,\n  defineSky,\n  defi