{"type":"item.completed","item":{"id":"item_171","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/tools/debug.mts; sed -n '13,31p' labs/game/scenes/play.test.ts; sed -n '125,165p' labs/game/scenes/op/state.ts; sed -n '33,51p' labs/game/scenes/op/gift.ts; sed -n '109,129p' labs/game/scenes/main.ts; rg -n 'precision|lastOverlay|lastSwap' labs/game/main.ts\"","aggregated_output":"/** @file Reproduce a limited-colleague case failure, printing only the remaining work. */\nimport { createOperation, defaultRules } from '../scenes/op/state';\nimport { stepOperation } from '../scenes/op/step';\nimport { botHands, botHand } from '../bot';\nconst r = defaultRules(),\n  s = createOperation('mercy', 5,4);\nfor (let k = 0; k < 40000 && s.status === 'playing'; k++) {\n  const h = botHands(s, r);\n  if(s.seats.length>1)h[1] = botHand(s, 1, r, true);\n  stepOperation(s, h, r);\n}\nconsole.log(\n  JSON.stringify({\n    status: s.status,\n    reason: s.reason,\n    phase: s.phase,\n    tick: s.tick,\n    p: s.seats,\n    targets: s.targets.filter((t) => !t.done).slice(0, 12),\n    last: s.events.slice(-5),\n  }),\n);\nfunction play(id: string, seed: number, seats = 1, difficulty: Difficulty = 'Resident', limited = false) {\n  const rules = defaultRules();\n  rules.difficulty = difficulty;\n  const s = createOperation(id, seed, seats, 0, rules);\n  for (let k = 0; k < 60000 && s.status === 'playing'; k++) {\n    const hands = botHands(s, rules);\n    if (limited && s.seats.length > 1) hands[1] = botHand(s, 1, rules, true);\n    stepOperation(s, hands, rules);\n  }\n  return s;\n}\ndescribe('a complete playable shift', () => {\n  for (const c of allCases)\n    it(`the bot completes ${c.title} on ${process.env.BOT_SEEDS ?? 3} seeds`, () => {\n      for (let seed = 1; seed <= Number(process.env.BOT_SEEDS ?? 3); seed++) {\n        const s = play(c.id, seed);\n        expect({\n          seed,\n          status: s.status,\n  }\n  if (p.goal === 'stabilize') s.patients[0] = 40;\n  if (p.gift && s.seats[0].gift === 0) s.seats[0].gift = 1;\n  if (p.close) {\n    for (const t of s.targets) if (!t.done && t.kind !== 'flap') t.required = true;\n  }\n  if (p.code) {\n    s.code = {\n      patient: 0,\n      until: s.fieldTicks + 48000,\n      tries: 0,\n      scripted: true,\n      needsAll: !!p.allPaddles,\n      shockSeats: [],\n    };\n    event(s, 'code', 'CODE. Both triggers, in the green band.');\n  }\n  if (p.drama) event(s, 'drama', p.drama);\n  event(s, 'phase', p.title);\n}\nexport function createOperation(id: string, seed = 1, humanSeats = 1, phase = 0, rules = defaultRules()): Operation {\n  const c = getCase(id),\n    n = c.id === 'gala-night' || c.id === 'gala-shift' ? c.sites.length : 1;\n  const s: Operation = {\n    caseId: c.id,\n    humans: humanSeats,\n    difficulty: rules.difficulty,\n    seed,\n    tick: 0,\n    fieldTicks: 0,\n    phase: 0,\n    phaseAt: 0,\n    phaseWait: 0,\n    status: 'playing',\n    reason: '',\n    patients: Array.from({ length: n }, () => c.vitals),\n    left: Math.round(\n      c.seconds *\n        6000 *\n        (rules.difficulty === 'Intern' ? 1.3 : rules.difficulty === 'Attending' ? 0.85 : 1) *\n        rules.balance.clock,\n    seat.lastBeat = Math.round(sampledTick / beatPeriod(s));\n    seat.perfect = 0;\n    seat.good = 0;\n    event(s, 'pulse', 'Listen. Match the next three heartbeats.');\n    return;\n  }\n  const period = beatPeriod(s),\n    d = Math.abs((((s.tick % period) + period / 2) % period) - period / 2);\n  const peak = Math.round(sampledTick / period);\n  if (d <= 8.4 && seat.beats < 3 && peak > seat.lastBeat) {\n    seat.lastBeat = peak;\n    seat.beats++;\n    if (d <= 4.2) seat.perfect++;\n    else seat.good++;\n    event(s, 'beat', d <= 4.2 ? 'PERFECT' : 'GOOD');\n    if (seat.beats === 3)\n      activate(s, rules, seat, rules.balance.giftBase + seat.perfect * 2.5 + seat.good * rules.balance.giftPerBeat);\n  }\n}\n          if (p.id >= s.humans && !(getCase(s.caseId).ai && p.id === 1)) {\n            hands ??= [];\n            hands[p.id] = botHand(s, p.id, r);\n          }\n      stepOperation(\n        s,\n        hands ??\n          s.seats.map((p) => [\n            p.x,\n            p.z,\n            p.tool,\n            p.held ? 1 : 0,\n            p.giftCounter,\n            p.shockCounter,\n            p.site,\n            p.swapCounter,\n            0,\n          ]),\n        r,\n      );\n    } else {\n52:  lastSwap = 0,\n53:  lastOverlay = '';\n115:  ((lastSwap = 0), (lastOverlay = ''));\n203:  const swap = operation?.events.find((e) => e.type === 'swap' && e.n > lastSwap);\n205:    lastSwap = swap.n;\n258:      precision: hands.precision,\n267:    if (overlay !== lastOverlay) {\n268:      lastOverlay = overlay;\n346:      ((skipHold = 0), (lastSwap = 0));\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_172","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/coop-debug.mts <<'EOF'\n/** @file Diagnose the cooperative finale with exactly the acceptance test's bot inputs. */\nimport {createOperation,defaultRules} from '../scenes/op/state';\nimport {stepOperation} from '../scenes/op/step';\nimport {botHands} from '../bot';\nfor(const seats of [2,4]){const r=defaultRules(),s=createOperation('mercy',5,seats);for(let i=0;i<60000&&s.status==='playing';i++)stepOperation(s,botHands(s,r),r);console.log(JSON.stringify({seats,phase:s.phase,tick:s.tick,status:s.status,reason:s.reason,code:s.code,targets:s.targets.filter(t=>\"'!t.done&&t.required).map(t=>({id:t.id,kind:t.kind,progress:t.progress,dose:t.dose,lift:t.lift,stitches:t.stitches})),hands:s.seats,last:s.events.slice(-8)}));}\nEOF\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/coop-debug.mts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
