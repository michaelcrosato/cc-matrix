{"type":"item.started","item":{"id":"item_163","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/hub.mjs <<'EOF'\n/** @file Official AI Hub harness acceptance, on a task-owned ephemeral loopback HTTP server. */\nimport {chromium} from '@playwright/test';\nimport {createServer} from 'node:http';\nimport {createReadStream,copyFileSync,existsSync,readFileSync,globSync,writeFileSync} from 'node:fs';\nimport {resolve,extname,sep} from 'node:path';\nimport {homedir} from 'node:os';\nconst {base}=JSON.parse(readFileSync('identity.json','utf8')),root=resolve('out/hub');\ncopyFileSync(resolve('..',base+'.html'),resolve(root,'game.html'));\nconst server=createServer((req,res)=>{const path=resolve(root,'.'+decodeURIComponent(new URL(req.url,'http://127.0.0.1').pathname));if(\"'!path.startsWith(root+sep)||!existsSync(path)){res.writeHead(404);res.end();return;}res.setHeader('\"'Content-Type',extname(path)==='.html'?'text/html':'text/javascript');createReadStream(path).pipe(res);});\nawait new Promise(r=>server.listen(0,'127.0.0.1',r));\nconst port=server.address().port,url=\"'`http://127.0.0.1:${port}`;\nconst records=[];\nlet browser;\nconst check=(name,ok,detail='\"'')=>{records.push({name,ok:\"'!!ok,detail});console.log(JSON.stringify(records.at(-1)));};\ntry{\n const content=await(await fetch(url+'\"'/game.html')).text();if(\"'!content.includes('\"'<title>Trauma Coast: Second Sight</title>'))throw new Error('Loopback server returned the wrong game');\n browser=await chromium.launch({executablePath:process.env.CHROMIUM_PATH??globSync(\"'`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0],args:['\"'--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader']});\n for(const [name,query] of [['two players','players=2'],['four players under loss','players=4&latency=150&jitter=50&loss=5'],['host leaves','players=4&latency=150&jitter=50&loss=5&scenario=host-leave'],['dedicated host','players=2&scenario=server']]){\n  const page=await browser.newPage({viewport:{width:1000,height:720}});const errors=[];page.on('pageerror',e=>errors.push(e.message));\n  await page.goto(\"'`${url}/harness.html?game=game.html&${query}&limit=8&auto=1`);\n  await page.waitForFunction(()=>document.body.dataset.complete==='\"'true',undefined,{timeout:120000}).catch(()=>{});\n  const result=await page.evaluate(()=>({check:window.__hubCheck,text:document.body.innerText.slice(-6000)}));\n  const frames=[];for(const frame of page.frames().slice(1)){try{frames.push(await frame.evaluate(()=>({mismatches:window.__surgery?.session?.seq.mismatches??0,checked:window.__surgery?.session?.seq.checked??0,engineErrors:window.__engine?.errors??[]})));}catch{}}\n  const mismatches=frames.reduce((n,f)=>n+f.mismatches,0);\n  check('AI Hub '+name,result.check?.pass===true&&mismatches===0&&errors.length===0,JSON.stringify({check:result.check,mismatches,frames,errors,text:result.check?.pass?'':result.text}).slice(0,7000));\n  await page.close();\n }\n}catch(error){check('AI Hub harness',false,String(error.stack??error));}finally{if(browser)await browser.close();server.closeAllConnections();await new Promise(r=>server.close(r));writeFileSync(resolve(root,'results.json'),JSON.stringify(records,null,2)+'\\\\n');}\nprocess.exitCode=records.some(r=>\"'!r.ok)?1:0;\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/view/field/liveMesh.ts');s=p.read_text();start=s.index('export class LiveMesh');s=s[:start]+'''export const sheetResolution={x:320,z:192};\nconst gridIndices=(nx:number,nz:number):number[]=>{const out:number[]=[],row=nx+1;for(let j=0;j<nz;j++)for(let i=0;i<nx;i++){const a=j*row+i,b=a+1,c=a+row;out.push(a,c,b,b,c,c+1);}return out;};\n'''+s[start:]\na=s.index(\\\"        if (id === 'sheet') {\\\");b=s.index('        g.computeBoundingSphere();',a);s=s[:a]+\\\"        if(id==='sheet')g.setIndex(gridIndices(sheetResolution.x,sheetResolution.z));\\\\n\\\"+s[b:]\ns+='''\\\\n/** A software-adapter session keeps its world identical while drawing a smaller tissue grid. */\nexport function softwareSessionSheet():void{sheetResolution.x=96;sheetResolution.z=58;const index=meshes.sheet.geometry?.getIndex();if(index){index.array.fill(0);index.array.set(gridIndices(96,58));index.needsUpdate=true;}}\n''';p.write_text(s)\np=Path('labs/game/view/field/sheet.ts');s=p.read_text().replace('meshes, rgb, type V3','meshes, rgb, sheetResolution, type V3').replace('nx = 320,','nx = sheetResolution.x,').replace('nz = 192,','nz = sheetResolution.z,');p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { meshes }\\\", \\\"import { meshes, softwareSessionSheet }\\\");needle=\\\"if (\"'!session && activeRun.startsWith('\"'op:')) document.body.classList.add('operating');\\\";s=s.replace(needle,\\\"if(session&&/swiftshader/i.test(JSON.stringify(engine.inspector?.info().adapter)))softwareSessionSheet();\\\\n\\\"+needle);p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_163","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/hub.mjs <<'EOF'\n/** @file Official AI Hub harness acceptance, on a task-owned ephemeral loopback HTTP server. */\nimport {chromium} from '@playwright/test';\nimport {createServer} from 'node:http';\nimport {createReadStream,copyFileSync,existsSync,readFileSync,globSync,writeFileSync} from 'node:fs';\nimport {resolve,extname,sep} from 'node:path';\nimport {homedir} from 'node:os';\nconst {base}=JSON.parse(readFileSync('identity.json','utf8')),root=resolve('out/hub');\ncopyFileSync(resolve('..',base+'.html'),resolve(root,'game.html'));\nconst server=createServer((req,res)=>{const path=resolve(root,'.'+decodeURIComponent(new URL(req.url,'http://127.0.0.1').pathname));if(\"'!path.startsWith(root+sep)||!existsSync(path)){res.writeHead(404);res.end();return;}res.setHeader('\"'Content-Type',extname(path)==='.html'?'text/html':'text/javascript');createReadStream(path).pipe(res);});\nawait new Promise(r=>server.listen(0,'127.0.0.1',r));\nconst port=server.address().port,url=\"'`http://127.0.0.1:${port}`;\nconst records=[];\nlet browser;\nconst check=(name,ok,detail='\"'')=>{records.push({name,ok:\"'!!ok,detail});console.log(JSON.stringify(records.at(-1)));};\ntry{\n const content=await(await fetch(url+'\"'/game.html')).text();if(\"'!content.includes('\"'<title>Trauma Coast: Second Sight</title>'))throw new Error('Loopback server returned the wrong game');\n browser=await chromium.launch({executablePath:process.env.CHROMIUM_PATH??globSync(\"'`${homedir()}/.cache/ms-playwright/chromium-*/chrome-linux64/chrome`)[0],args:['\"'--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader']});\n for(const [name,query] of [['two players','players=2'],['four players under loss','players=4&latency=150&jitter=50&loss=5'],['host leaves','players=4&latency=150&jitter=50&loss=5&scenario=host-leave'],['dedicated host','players=2&scenario=server']]){\n  const page=await browser.newPage({viewport:{width:1000,height:720}});const errors=[];page.on('pageerror',e=>errors.push(e.message));\n  await page.goto(\"'`${url}/harness.html?game=game.html&${query}&limit=8&auto=1`);\n  await page.waitForFunction(()=>document.body.dataset.complete==='\"'true',undefined,{timeout:120000}).catch(()=>{});\n  const result=await page.evaluate(()=>({check:window.__hubCheck,text:document.body.innerText.slice(-6000)}));\n  const frames=[];for(const frame of page.frames().slice(1)){try{frames.push(await frame.evaluate(()=>({mismatches:window.__surgery?.session?.seq.mismatches??0,checked:window.__surgery?.session?.seq.checked??0,engineErrors:window.__engine?.errors??[]})));}catch{}}\n  const mismatches=frames.reduce((n,f)=>n+f.mismatches,0);\n  check('AI Hub '+name,result.check?.pass===true&&mismatches===0&&errors.length===0,JSON.stringify({check:result.check,mismatches,frames,errors,text:result.check?.pass?'':result.text}).slice(0,7000));\n  await page.close();\n }\n}catch(error){check('AI Hub harness',false,String(error.stack??error));}finally{if(browser)await browser.close();server.closeAllConnections();await new Promise(r=>server.close(r));writeFileSync(resolve(root,'results.json'),JSON.stringify(records,null,2)+'\\\\n');}\nprocess.exitCode=records.some(r=>\"'!r.ok)?1:0;\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/view/field/liveMesh.ts');s=p.read_text();start=s.index('export class LiveMesh');s=s[:start]+'''export const sheetResolution={x:320,z:192};\nconst gridIndices=(nx:number,nz:number):number[]=>{const out:number[]=[],row=nx+1;for(let j=0;j<nz;j++)for(let i=0;i<nx;i++){const a=j*row+i,b=a+1,c=a+row;out.push(a,c,b,b,c,c+1);}return out;};\n'''+s[start:]\na=s.index(\\\"        if (id === 'sheet') {\\\");b=s.index('        g.computeBoundingSphere();',a);s=s[:a]+\\\"        if(id==='sheet')g.setIndex(gridIndices(sheetResolution.x,sheetResolution.z));\\\\n\\\"+s[b:]\ns+='''\\\\n/** A software-adapter session keeps its world identical while drawing a smaller tissue grid. */\nexport function softwareSessionSheet():void{sheetResolution.x=96;sheetResolution.z=58;const index=meshes.sheet.geometry?.getIndex();if(index){index.array.fill(0);index.array.set(gridIndices(96,58));index.needsUpdate=true;}}\n''';p.write_text(s)\np=Path('labs/game/view/field/sheet.ts');s=p.read_text().replace('meshes, rgb, type V3','meshes, rgb, sheetResolution, type V3').replace('nx = 320,','nx = sheetResolution.x,').replace('nz = 192,','nz = sheetResolution.z,');p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { meshes }\\\", \\\"import { meshes, softwareSessionSheet }\\\");needle=\\\"if (\"'!session && activeRun.startsWith('\"'op:')) document.body.classList.add('operating');\\\";s=s.replace(needle,\\\"if(session&&/swiftshader/i.test(JSON.stringify(engine.inspector?.info().adapter)))softwareSessionSheet();\\\\n\\\"+needle);p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_164","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/audio/data.ts');s=p.read_text().replace(\\\"import { defineSfx, defineSong }\\\", \\\"import { STRAINS } from '../data/strains';\\\\nimport { defineSfx, defineSong }\\\");s+='''\\\\nfor(const [name,strain] of Object.entries(STRAINS)){\n strain.notes.forEach((note,i)=>defineSfx(\"'`sfx:hl-signature-${name}-${i}`,{voices:{wave:'\"'sine',freq:440*Math.pow(2,(note-69)/12),dur:.2,vol:.18}}));\n defineSfx(\"'`sfx:hl-signature-${name}`,{layers:strain.notes.map((_,i)=>({sfx:`sfx:hl-signature-${name}-${i}`,at:i*.15}))});\n}\n'\"''';p.write_text(s)\np=Path('labs/game/audio/voice.ts');s=p.read_text().replace('  stop(): void {', '''  sing(notes:number[],volume:number):void{const c=this.context,g=this.gain,b=this.buffers.get('sabine');if(\"'!c||!g||!b)return;g.gain.value=volume*.25;for(const [i,note] of notes.entries()){const s=c.createBufferSource();s.buffer=b[(i*5)%16];s.loop=true;s.playbackRate.value=Math.pow(2,(note-60)/12);s.connect(g);s.start(c.currentTime+.02);s.stop(c.currentTime+1.5);this.sources.push(s);}}\n  stop(): void {'\"''');p.write_text(s)\np=Path('labs/game/audio/mix.ts');s=p.read_text().replace('  voiceReady = false;', '  voiceReady = false;seen=new Set<string>();ambience=false;choir=-1;gala=-1;')\ns=s.replace(\\\"    this.audio.volume('music', p.music);\\\", \\\"    const still=s?.seats.some(q=>q.giftKind==='still'&&q.giftUntil>s.tick);\\\\n    this.audio.volume('music', p.music*(still?.45:1));\\\")\ns=s.replace(\\\"      this.last = 0;\\\", \\\"      this.last = 0;this.seen.clear();this.choir=-1;this.gala=-1;\\\")\ns=s.replace('    if (\"'!s) return;'\"', \\\"    if(this.audio.context&&\"'!this.ambience)this.ambience=!!this.audio.play('\"'sfx:hl-rain',{vol:.12,loop:true});\\\\n    if (\"'!s) return;\")\ns=s.replace(\"    const beat = Math.floor\", \"    if(s.status==='\"'playing'){const strain=s.targets.find(t=>\"'!t.done&&['\"'lull','matron','solace','reverie','balm','mercy'].includes(t.kind));this.theme(s.caseId==='mercy'?'mercy':strain?'strain':'calm');for(const t of s.targets)if(\"'!t.done&&['\"'lull','matron','solace','reverie','balm','mercy'].includes(t.kind)&&\"'!this.seen.has(t.kind)){this.seen.add(t.kind);this.audio.play('\"'sfx:hl-signature-'+t.kind);}\\\\n    if(s.caseId==='mercy'){const bar=Math.floor(s.fieldTicks/24000);if(bar\"'!==this.choir){this.choir=bar;this.voices.sing([57,60,64],p.voice*p.master);}}'\"\\\\n    if(s.caseId==='gala-night'){const bar=Math.floor(s.fieldTicks/90000);if(bar\"'!==this.gala){this.gala=bar;this.say('\"'voss','A gentler world is waiting.',p);this.audio.stinger('song:hl-jingle',{vol:.5});}}}\\\\n    const beat = Math.floor\\\")\np.write_text(s)\np=Path('labs/game/view/assets.ts');s+='''\\\\ndefineLook('look:critical',{description:'Low-vitals red vignette.',filters:{vignette:{scope:'all',strength:.5,color:'#631d2e'}}});\\\\n''';p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace('  lastSwap = 0;', \\\"  lastSwap = 0,lastOverlay='';\\\")\ns=s.replace('  activeRun = runId;\\\\n  lastSwap = 0;', \\\"  activeRun = runId;\\\\n  lastSwap = 0;lastOverlay='';\\\")\ns=s.replace('    drawField(view, f.dt, prefs.blood);', '''    const gift=view.seats.find(q=>q.giftUntil>view.tick),overlay=(gift?.giftKind??'')+(Math.min(...view.patients)<25?'critical':'');\n    if(overlay\"'!==lastOverlay){lastOverlay=overlay;set('\"'post.combine',[...(gift?[{look:gift.giftKind==='still'?'look:stillpoint':'look:second-pulse',amount:1}]:[]),...(Math.min(...view.patients)<25?[{look:'look:critical',amount:1}]:[])]);}\n    drawField(view, f.dt, prefs.blood);''')\ns=s.replace('      sound.say(b.who, b.text, prefs);', \\\"      sound.say(b.who, b.text, prefs);sound.theme(b.who==='voss'?'jingle':'story');\\\")\np.write_text(s)\nPY\ncat > labs/game/audio/audio.test.ts <<'EOF'\n/** @file Every synthesized tool and strain signature produces finite, non-silent audio samples. */\nimport {it,expect} from 'vitest';\nimport {renderSfx,renderSong} from '../../../engine';\nimport './data';\nfor(const id of ['cut','stitch','drain','laser','syringe','gel','scanner','forceps','beep','shock','signature-lull','signature-solace','signature-reverie','signature-balm','signature-mercy'])it(\"'`renders ${id} without an audio file`,()=>{const samples=renderSfx('\"'sfx:hl-'+id),energy=samples.reduce((sum,n)=>sum+n*n,0);expect(samples.length).toBeGreaterThan(100);expect(Number.isFinite(energy)).toBe(true);expect(energy).toBeGreaterThan(.0001);});\nit('renders the original title music',()=>{const song=renderSong('song:hl-title');expect(song.length).toBeGreaterThan(1000);expect(song.some(n=>n\"'!==0)).toBe(true);});\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
