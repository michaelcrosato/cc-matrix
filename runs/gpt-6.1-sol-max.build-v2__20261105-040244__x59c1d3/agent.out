p=await ctx.newPage();await p.goto(url);await p.waitForFunction(()=>\"'!!window.__surgery&&window.__engine.ready);await p.locator('\"'[data-touch-settings]').waitFor();check(profile.name+' requires hardware controls',await p.locator('.touch-cover h2').innerText()==='Controller or keyboard required');await p.locator('[data-touch-settings]').tap();check(profile.name+' settings accepts taps',await p.locator('[data-game=\\\"settings\\\"]').count()===1);check(profile.name+' has no virtual controls',await p.locator('[data-touch-stick],[data-touch-button]').count()===0);await ctx.close();\n }\n}catch(error){check('browser acceptance',false,String(error.stack??error).slice(0,1600));}finally{await browser.close();}\nprocess.exitCode=checks.some(c=>\"'!c.ok)?1:0;\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
