r; pz:number; site:number; tool:number; held:boolean; charge:number; cooldown:number; heat:number; healthy:number; grab:number; start:Point; gift:number; giftUntil:number; giftKind:'still'|'pulse'|'none'; pulseAt:number; beats:number; perfect:number; good:number; giftCounter:number; shockCounter:number; swapCounter:number; score:number; slips:number; chain:number; best:number; active:boolean; }\nexport interface OpEvent { n:number; type:string; text:string; x:number; z:number; seat:number; }\nexport interface Code { patient:number; until:number; tries:number; scripted:boolean; }\nexport interface Operation { caseId:string; seed:number; tick:number; fieldTicks:number; phase:number; phaseAt:number; phaseWait:number; status:'playing'|'won'|'lost'; reason:string; patients:number[]; left:number; targets:Target[]; seats:Seat[]; nextId:number; score:number; chain:number; best:number; slips:number; rating:string; eventId:number; events:OpEvent[]; lastProgress:number; hint:string; code:Code|null; codes:number[]; bossRound:number; consultUntil:number; retry:boolean; dev:boolean; }\nexport type Balance = Record<string,number>;\nexport interface Rules { balance:Balance; difficulty:Difficulty; simpleGift:boolean; attract:boolean; freezeVitals:boolean; freezeClock:boolean; infiniteGift:boolean; oneHit:boolean; }\n''',\n'data/balance.ts':'''/** @file Every live balance slider, declared once for engine settings and the developer panel. */\nimport { defineSettings, type Field } from '../../../engine/sim-api';\nexport const BALANCE:Record<string,[number,number,number,string]> = {\n vitalsDrain:[1,0,3,'Vitals drain'],bleedRate:[1,0,3,'Blood pooling'],clock:[1,.5,2,'Case clock'],slipLimit:[5,1,20,'Slip limit'],cursorSpeed:[13,3,25,'Cursor speed'],cursorCurve:[2.2,1,4,'Stick curve'],magnet:[.55,0,1,'Target magnet'],railAssist:[.6,0,1,'Cutting assist'],sewAssist:[.8,0,2,'Stitch assist'],radialSlow:[.6,.1,1,'Radial slow'],cutTolerance:[1,.5,2,'Cut tolerance'],stitchSpacing:[.45,.2,1,'Stitch spacing'],drainRate:[1,.25,4,'Drain power'],laserPower:[1,.25,4,'Laser power'],laserHeat:[6,2,20,'Laser heat limit'],stabilizer:[18,5,50,'Stabilizer dose'],clipSeconds:[8,2,30,'Flap clip time'],giftBase:[3,1,10,'Gift duration'],giftPerBeat:[1.5,0,5,'Beat bonus'],stillRate:[.25,.05,1,'Stillpoint rate'],pulseHeal:[1.5,0,5,'Second Pulse healing'],strainHp:[1,.25,4,'Parasite health'],strainSpeed:[1,.25,3,'Parasite speed'],strainDamage:[1,0,3,'Parasite damage'],telegraph:[1,.25,3,'Telegraph duration'],coopHp:[.6,0,2,'Co-op extra health'],\n};\nexport const defaults = ():Record<string,number> => Object.fromEntries(Object.entries(BALANCE).map(([k,v])=>[k,v[0]]));\nconst fields:Record<string,Field>={};\nfor(const [key,[value,min,max,label]] of Object.entries(BALANCE)) fields[\"'`game.${key}`]={type:'\"'number',default:value,minimum:min,maximum:max,when:'now',description:label};\nObject.assign(fields,{\n 'game.run':{type:'string',default:'title',when:'scene',description:'Title, story or operation run.'},\n 'game.phase':{type:'integer',default:0,minimum:0,maximum:20,when:'scene',description:'Phase checkpoint.'},\n 'game.seats':{type:'integer',default:1,minimum:1,maximum:4,when:'scene',description:'Human surgeons.'},\n 'game.difficulty':{type:'string',default:'Resident',enum:['Intern','Resident','Attending'],when:'scene',description:'Difficulty.'},\n 'game.attract':{type:'boolean',default:false,when:'scene',description:'Demo mode disables scores and failure.'},\n 'game.simpleGift':{type:'boolean',default:false,when:'now',description:'One-press Gift.'},\n 'game.freezeVitals':{type:'boolean',default:false,when:'now',description:'Developer vitals lock.'},\n 'game.freezeClock':{type:'boolean',default:false,when:'now',description:'Developer clock lock.'},\n 'game.infiniteGift':{type:'boolean',default:false,when:'now',description:'Developer Gift supply.'},\n 'game.oneHit':{type:'boolean',default:false,when:'now',description:'Developer parasite damage.'},\n 'game.autoplay':{type:'boolean',default:false,when:'now',description:'Let the surgeon bot operate.'},\n});\nexport const GAME_SETTINGS=defineSettings(fields);\n''',\n'data/tools.ts':'''/** @file Complete tool/target response matrix shared by play, the bot and the Handbook. */\nimport type { TargetKind, Tool } from './types';\nexport const TOOLS:Tool[]=['Scalpel','Forceps','Suture','Drain','Laser','Syringe','Gel','Scanner'];\nexport const KINDS:TargetKind[]=['pool','shard','wound','incision','mass','nodule','bleeder','abrasion','numb','cocoon','flap','lull','matron','solace','reverie','decoy','balm','node','mercy','mote','tendril','binder'];\nexport const HELP:Record<Tool,string[]>={\n Scalpel:['Hold at the first dot. Follow the cyan guide.','Loop-cut a mass; divide large Solace.','Healthy tissue tears. Cut only on a guide.'],\n Forceps:['Hold to grip; pull away slowly to extract.','Glass, excised masses, cocoons and tendrils.','Lift a flap above the clip line; release to clip.'],\n Suture:['Hold and weave across the wound, left to right.','Each crossing places one stitch.','Drain obscuring blood and clear Balm first.'],\n Drain:['Hold over a dark pool until it disappears.','Blood hides targets beneath it.','A lacquered wound needs Gel first.'],\n Laser:['Hold a steady beam on a nodule or tiny bleeder.','Lull, motes and the smallest Solace burn.','Six seconds of heat; two seconds to cool.'],\n Syringe:['Hold to fill. Release in the green band.','Stabilizer restores vitals; F equips it quickly.','Hold on a marked weak point to inject Binder.'],\n Gel:['Hold and paint the whole marked area.','Seal stitched wounds; soothe numb tissue.','Dissolves Balm. Cannot close an open wound.'],\n Scanner:['Hold to reveal hidden tissue in a three-metre ring.','Reveals last six seconds. Decoys pop.','Reverie must be scanned before the Laser.'],\n};\nconst preferred:Record<TargetKind,Tool>={pool:'Drain',shard:'Forceps',wound:'Suture',incision:'Scalpel',mass:'Scalpel',nodule:'Laser',bleeder:'Laser',abrasion:'Gel',numb:'Gel',cocoon:'Forceps',flap:'Forceps',lull:'Laser',matron:'Syringe',solace:'Scalpel',reverie:'Scanner',decoy:'Scanner',balm:'Gel',node:'Syringe',mercy:'Syringe',mote:'Laser',tendril:'Forceps',binder:'Syringe'};\nexport const RESPONSE:Record<Tool,Record<TargetKind,string>>=Object.fromEntries(TOOLS.map(tool=>[tool,Object.fromEntries(KINDS.map(kind=>[kind,tool===preferred[kind]?'effect':\"'`${tool} cannot treat ${kind}. Use ${preferred[kind]}, Doctor.`]))])) as Record<Tool,Record<TargetKind,string>>;\nfor(const [tool,kinds] of [['\"'Forceps',['mass']],['Laser',['solace','reverie','balm']],['Scanner',['mass','nodule','reverie']]] as [Tool,TargetKind[]][]) for(const kind of kinds) RESPONSE[tool][kind]='effect';\nRESPONSE.Laser.solace='effect';\nexport const recommended=(kind:TargetKind):number=>TOOLS.indexOf(preferred[kind]);\n''',\n'data/strains.ts':'''/** @file Strain health, attack telegraphs and three-note sonic identities. */\nexport const STRAINS={\n lull:{color:'#bd91ff',hp:1.5,speed:1.2,period:6,telegraph:1.5,radius:1.2,damage:2,notes:[62,65,69]},\n matron:{color:'#9e68e3',hp:2,speed:0,period:8,telegraph:2.5,radius:2,damage:3,notes:[50,53,57]},\n solace:{color:'#ffc45d',hp:1,speed:.25,period:7,telegraph:2,radius:.9,damage:5,notes:[65,69,70]},\n reverie:{color:'#7694ff',hp:5,speed:3,period:8,telegraph:1.2,radius:1.6,damage:4,notes:[60,61,67]},\n balm:{color:'#c9f8e7',hp:1,speed:.5,period:4,telegraph:1,radius:1,damage:1,notes:[67,71,74]},\n mercy:{color:'#fff2ab',hp:3,speed:.2,period:9,telegraph:1.5,radius:2,damage:4,notes:[69,72,76]},\n};\n'''\n}\nfor name,content in files.items():(D/name).write_text(content)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"agent_message","text":"The full engine workspace is installed and pinned, and the first single-file build is underway. I’m defining the cases, instruments, and strain rules as shared data so gameplay, the Handbook, developer tools, and test bot use the same rules.\n"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/data/types.ts');s=p.read_text().replace('drama?:string; }','drama?:string; goal?:string; }');p.write_text(s)\nPath('labs/game/data/cases/index.ts').write_text('''/** @file The complete eight-case story and standalone co-op session, authored as phase data. */\nimport type { Case, Phase, Point, Spawn, TargetKind } from '../types';\nconst at=(kind:TargetKind,x:number,z:number,extra:Partial<Spawn>={}):Spawn=>({kind,at:[x,z],...extra});\nexport const line=(x:number,z:number,length=3):Point[]=>[[x-length/2,z-.2],[x,z+.15],[x+length/2,z-.1]];\nexport const circle=(x:number,z:number,r=1.2):Point[]=>Array.from({length:25},(_,i)=>[x+Math.cos(i/24*Math.PI*2)*r,z+Math.sin(i/24*Math.PI*2)*r]);\nconst wound=(x:number,z:number,site=0,deep=false):Spawn=>at('wound',x,z,{path:line(x,z),site,deep});\nconst cut=(x=0,z=0,site=0):Spawn=>at('incision',x,z,{path:[[-3.5+x,z-.6],[-2+x,z-.25],[x,z+.3],[2+x,z+.6],[3.5+x,z+.4]],site});\nconst phase=(id:string,title:string,hint:string,spawn:Spawn[]=[],extra:Partial<Phase>={}):Phase=>({id,title,hint,spawn,...extra});\nconst close=():Phase=>phase('close','Close the field','Stitch any open wounds, paint Gel over the sutures, and let me dress it.',[],{close:true});\nconst cards=(a:string,c:string):string[]=>[c,'Home. A little slower, but home. Thank you for staying.',a,a];\nexport const CASES:Case[]=[\n {id:'first-cut',title:'First Cut',patient:'Tomás Reyes',age:52,detail:'Harbor pilot. His dog is waiting outside the ward.',sites:['Chest'],field:'chest',seconds:240,vitals:70,lead:'wren',gift:0,ai:false,ranks:[1800,2400,3000,3600],postcard:cards('Pepper and I walked the seawall. She still thinks you saved me for her.','Pepper has forgiven the stitches. I am trying to.'),phases:[\n phase('blood','Clear the field','Choose Drain [4]. Hold over each dark pool until I can see.',[at('pool',-3,-1,{radius:1.15}),at('pool',2.5,-.8,{radius:1.05}),at('pool',0,1.7,{radius:.9})]),\n phase('glass','Four pieces of glass','Forceps [2]. Hold a shard, then pull away slowly.',[at('shard',-3.2,-.9),at('shard',2.6,-1.4),at('shard',.8,1.4),at('shard',-1.5,1.8)]),\n phase('stabilize','Steady the heart','Press F. Hold to fill the Syringe; release in the green band.',[],{goal:'stabilize'}),\n phase('suture','Bring the edges together','Suture [3]. Hold and weave from one side of the wound to the other.',[wound(-3,-.7),wound(2.8,-.6),wound(0,1.5)]),close()]},\n {id:'quiet-lump',title:'The Quiet Lump',patient:'Gwen Abara',age:34,detail:'Trumpet player. She promised the band she would make tonight’s set.',sites:['Abdomen'],field:'abdomen',seconds:270,vitals:85,lead:'wren',gift:1,ai:false,ranks:[2400,3200,4000,4800],postcard:cards('Back on the trumpet. Played your name badly on purpose.','I can manage the quiet notes. The loud ones will come.'),phases:[\n phase('open','A routine incision','Scalpel [1]. Begin at the first dot. Hold and follow the cyan guide.',[cut()]),\n phase('bleeders','A little cautery','Laser [5]. Hold on the tiny bright bleeders. Watch the heat.',[at('bleeder',-2,-.3),at('bleeder',1.4,.5)]),\n phase('scan','Something beneath the scar','Scanner [8] reveals the mass and three nodules. Laser the nodules.',[at('nodule',-3,-1.3,{buried:true}),at('nodule',2.8,1.5,{buried:true}),at('nodule',3,-1.5,{buried:true}),at('mass',0,0,{path:circle(0,0),buried:true})]),\n phase('reveal','It flinched','Forceps. The specimen just moved. Keep your hand steady.',[at('cocoon',0,0)],{drama:'IT MOVED.'}),close()]},\n {id:'crosstalk',title:'Crosstalk',patient:'Hal Minsky',age:58,detail:'Bus driver. Route 9. He remembers every passenger’s stop.',sites:['Liver','Lung','Arm'],field:'liver',seconds:300,vitals:60,lead:'wren',gift:1,ai:false,ranks:[3300,4400,5500,6600],postcard:cards('Route 9 is running again. Your stop is always free.','They gave my route to a younger man. I am teaching him the names.'),phases:[\n phase('triage','Three sites. One patient.','Q / E change sites. Every wound keeps bleeding while you are away.',[...Array.from({length:3},(_,site)=>[wound(-2,-.8,site),wound(2,1,site),at('pool',-1,0,{site,radius:1})]).flat()]),\n phase('code','CODE — charge the paddles','LMB + RMB together when the charge reaches the green band.',[],{code:true}),\n phase('discovery','The room holds its breath','Space starts pulse-lock. Match the next three heartbeats.',[wound(-2,-1,0,true),wound(2,1,1,true),wound(0,0,2,true)],{gift:true,goal:'gift',drama:'HOLD. STILL.'}),close()]},\n {id:'it-moves',title:'It Moves',patient:'Gwen Abara',age:34,detail:'She came back before the last song. Her scar is moving.',sites:['Abdomen'],field:'abdomen',seconds:330,vitals:75,lead:'wren',gift:1,ai:false,ranks:[4000,5300,6600,8000],postcard:cards('I wrote a song about the thing you took out. It is not a lullaby.','The scar is quiet. That is enough music for today.'),phases:[\n phase('reopen','The scar remembers','Follow the old incision. This time we keep the evidence.',[cut()]),\n phase('lull','LULL — the quiet is a symptom','Laser the lilac Lulls. Gel their numb patches. Do not trust a quiet monitor.',[at('lull',-3,-1),at('lull',2.5,-1.2),at('lull',.4,1.6)]),\n phase('cocoons','Bag the evidence','Forceps on the cocoons. Suture the tears.',[wound(-2,0),wound(2,.8)]),\n phase('matron','The Matron','Wait for her yawn. Hold the Syringe in her open maw: two Binder doses.',[at('matron',0,0,{radius:1.25})],{drama:'SHE IS A MOTHER.'}),close()]},\n {id:'struck-off',title:'Struck Off',patient:'“Big Ana” Duarte',age:46,detail:'Stevedore. Her crew will not leave the ship without her.',sites:['Ship clinic'],field:'abdomen',seconds:330,vitals:70,lead:'sabine',gift:1,ai:true,ranks:[4400,5900,7400,8900],postcard:cards('The whole crew signed this. Even the one who cannot write.','The sea still makes me nervous. My crew pretends not to notice.'),phases:[\n phase('flap','Lift, clip, look beneath','Forceps on the gold flap handle. Lift up and release above the clip line.',[at('flap',0,-1.5),at('solace',-.7,-.1,{generation:1,parent:-1})]),\n phase('storm','SOLACE — the storm arrives','Scalpel divides the large ones. Laser the smallest. Space: Second Pulse.',[at('solace',-3,1,{generation:1}),at('solace',3,-1,{generation:1})],{gift:true,drama:'THEN USE THE SHAKE.'}),\n phase('mother','Mother Solace','Your colleague holds the flap. Divide the mother and burn every child.',[at('flap',0,-1.5),at('solace',0,0,{generation:1,parent:-1,radius:1.1})]),close()]},\n {id:'reverie',title:'Reverie',patient:'Bram Achterberg',age:60,detail:'The Chief wore his graft under his collar. He signed every trial.',sites:['Chest','Abdomen'],field:'heart',seconds:360,vitals:65,lead:'wren',gift:1,ai:true,ranks:[4300,5700,7200,8600],postcard:cards('A surgeon finishes. A better surgeon admits where he began.','I have started reading the names on the files.'),phases:[\n phase('incisions','Two surgeons. Two incisions.','Tab swaps surgeons. Q / E changes sites.',[cut(0,0,0),cut(0,0,1)]),\n phase('hunt','REVERIE — listen for the true pulse','Scan the moving ripple. Laser reveals it; keep firing while it is surfaced.',[at('reverie',0,0,{site:0}),at('decoy',-3,-1),at('decoy',3,1)]),\n phase('decoys','One heartbeat is real','Scan the decoys. The real ripple beats with the ECG.',[at('decoy',-3,-1,{site:1}),at('decoy',3,-1,{site:1}),at('decoy',0,2,{site:1}),at('reverie',0,0,{site:1})]),\n phase('consult','Ask for another pair of hands','Lift the flap. Start a Gift together: CONSULT extends both.',[at('flap',0,-1.5),at('reverie',0,0,{parent:-1})],{gift:true,drama:'I SIGNED THEM ALL.'}),close()]},\n {id:'gala-night',title:'Gala Night',patient:'Three gala donors',age:0,detail:'Three tables. Voss is still making his speech.',sites:['Table A','Table B','Table C'],field:'abdomen',seconds:390,vitals:80,lead:'wren',gift:1,ai:true,ranks:[4800,6400,8000,9600],postcard:cards('Three signatures. Three lives. One very bad party.','We have cancelled next year’s gala.'),phases:[\n phase('triage','BALM — comfort is spreading','Gel dissolves the pale lacquer. Drain and stitch before the film returns.',Array.from({length:3},(_,site)=>[at('balm',0,0,{site,radius:1.7}),at('pool',-2,-.7,{site}),wound(2,1,site)]).flat()),\n phase('nodes','Find the source','Two Binder doses into each translucent Node. Clear the film around it.',Array.from({length:3},(_,site)=>[at('node',0,0,{site}),at('balm',0,0,{site})]).flat(),{drama:'THE SPEECH IS STILL PLAYING.'}),close()]},\n {id:'mercy',title:'Mercy',patient:'Lucan Voss',age:50,detail:'His own product is inside his heart. He is still your patient.',sites:['Heart'],field:'heart',seconds:480,vitals:100,lead:'wren',gift:1,ai:true,ranks:[6800,9000,11300,13600],postcard:cards('You saved me. That is the one thing I could never have sold.','The cuffs are uncomfortable. I am told that is the point.'),phases:[\n phase('open','The last incision','Open the field. Whatever he did, your hands must be honest.',[cut()]),\n phase('anesthesia','MERCY / I — Anesthesia','Laser all six motes. Three Binder doses while the shield is down.',[at('mercy',0,0,{radius:1.4}),...Array.from({length:6},(_,i)=>at('mote',Math.cos(i*Math.PI/3)*2.5,Math.sin(i*Math.PI/3)*2.1))],{drama:'SHE IS SINGING.'}),\n phase('kindness-code-1','MERCY / II — The Kindness','She stopped his heart. Shock in the green band.',[],{code:true}),\n phase('rakes-1','Thirty seconds to close','Three rakes. Thirty seconds. Stitch now.',[wound(-3,-1,0,true),wound(2.7,-1,0,true),wound(0,1.5,0,true)],{goal:'race'}),\n phase('kindness-code-2','The Kindness — again','One more shock. Do not let her call this kindness.',[],{code:true}),\n phase('rakes-2','Not one stitch left behind','Close all three before thirty seconds pass.',[wound(-3,1,0,true),wound(2.7,1,0,true),wound(0,-1.5,0,true)],{goal:'race'}),\n phase('last-rites','MERCY / III — Last Rites','Follow the guide as the ventricle beats.',[at('incision',0,0,{path:circle(0,0,1.7)})],{drama:'WE ARE NOT FINISHED.'}),\n phase('tendrils','Five hands around a heart','Forceps. Free all five tendrils before they reattach.',Array.from({length:5},(_,i)=>at('tendril',Math.cos(i*Math.PI*2/5)*2.4,Math.sin(i*Math.PI*2/5)*2))),\n phase('binder-finish','One Gift. Three points.','A Gift is yours. Activate it, then Binder into all three gold marks.',[at('binder',-2,-.8),at('binder',2,-.8),at('binder',0,1.6)],{gift:true,goal:'gift-binder'}),\n phase('final-code','Bring him back','Every surgeon. One heartbeat. Charge the paddles.',[],{code:true}),close()]},\n];\nexport const SESSION:Case={id:'gala-shift',title:'The Gala Shift',patient:'The night shift',age:0,detail:'Two patients. One team. Keep both alive.',sites:['Table A','Table B'],field:'abdomen',seconds:270,vitals:80,lead:'wren',gift:1,ai:true,ranks:[3000,4000,5000,6000],postcard:cards('The night shift held.','Both tables made it to morning.'),phases:[phase('team','Two tables. One team.','Split the work. Q / E switches tables. Keep both patients alive.',[wound(-3,-1,0),wound(2,1,1),at('pool',-2,0),at('pool',2,1,{site:1}),at('shard',3,-1),at('lull',-2,-1,{site:1}),at('node',0,1,{site:1}),at('balm',0,1,{site:1}),at('flap',0,-1.5),at('shard',0,0,{parent:-1})]),close()]};\nexport const allCases=[...CASES,SESSION];\nexport const getCase=(id:string):Case=>allCases.find(c=>c.id===id)??CASES[0];\nexport function validateCase(c:Case):string[]{\n const issues:string[]=[];\n if(\"'!c.phases.length||!c.phases.at(-1)?.close)issues.push(`${c.id}: final phase must close`);\n if(c.seconds<60||c.sites.length<1||c.sites.length>3)issues.push(`${c.id}: invalid clock or sites`);\n for(const p of c.phases)for(const s of p.spawn){if((s.site??0)>=c.sites.length)issues.push(`${c.id}/${p.id}: invalid site`);if(s.path&&s.path.length<2)issues.push(`${c.id}/${p.id}: short guide`);}\n return issues;\n}\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/data/types.ts');s=p.read_text().replace('drama?:string; }','drama?:string; goal?:string; }');p.write_text(s)\nPath('labs/game/data/cases/index.ts').write_text('''/** @file The complete eight-case story and standalone co-op session, authored as phase data. */\nimport type { Case, Phase, Point, Spawn, TargetKind } from '../types';\nconst at=(kind:TargetKind,x:number,z:number,extra:Partial<Spawn>={}):Spawn=>({kind,at:[x,z],...extra});\nexport const line=(x:number,z:number,length=3):Point[]=>[[x-length/2,z-.2],[x,z+.15],[x+length/2,z-.1]];\nexport const circle=(x:number,z:number,r=1.2):Point[]=>Array.from({length:25},(_,i)=>[x+Math.cos(i/24*Math.PI*2)*r,z+Math.sin(i/24*Math.PI*2)*r]);\nconst wound=(x:number,z:number,site=0,deep=false):Spawn=>at('wound',x,z,{path:line(x,z),site,deep});\nconst cut=(x=0,z=0,site=0):Spawn=>at('incision',x,z,{path:[[-3.5+x,z-.6],[-2+x,z-.25],[x,z+.3],[2+x,z+.6],[3.5+x,z+.4]],site});\nconst phase=(id:string,title:string,hint:string,spawn:Spawn[]=[],extra:Partial<Phase>={}):Phase=>({id,title,hint,spawn,...extra});\nconst close=():Phase=>phase('close','Close the field','Stitch any open wounds, paint Gel over the sutures, and let me dress it.',[],{close:true});\nconst cards=(a:string,c:string):string[]=>[c,'Home. A little slower, but home. Thank you for staying.',a,a];\nexport const CASES:Case[]=[\n {id:'first-cut',title:'First Cut',patient:'Tomás Reyes',age:52,detail:'Harbor pilot. His dog is waiting outside the ward.',sites:['Chest'],field:'chest',seconds:240,vitals:70,lead:'wren',gift:0,ai:false,ranks:[1800,2400,3000,3600],postcard:cards('Pepper and I walked the seawall. She still thinks you saved me for her.','Pepper has forgiven the stitches. I am trying to.'),phases:[\n phase('blood','Clear the field','Choose Drain [4]. Hold over each dark pool until I can see.',[at('pool',-3,-1,{radius:1.15}),at('pool',2.5,-.8,{radius:1.05}),at('pool',0,1.7,{radius:.9})]),\n phase('glass','Four pieces of glass','Forceps [2]. Hold a shard, then pull away slowly.',[at('shard',-3.2,-.9),at('shard',2.6,-1.4),at('shard',.8,1.4),at('shard',-1.5,1.8)]),\n phase('stabilize','Steady the heart','Press F. Hold to fill the Syringe; release in the green band.',[],{goal:'stabilize'}),\n phase('suture','Bring the edges together','Suture [3]. Hold and weave from one side of the wound to the other.',[wound(-3,-.7),wound(2.8,-.6),wound(0,1.5)]),close()]},\n {id:'quiet-lump',title:'The Quiet Lump',patient:'Gwen Abara',age:34,detail:'Trumpet player. She promised the band she would make tonight’s set.',sites:['Abdomen'],field:'abdomen',seconds:270,vitals:85,lead:'wren',gift:1,ai:false,ranks:[2400,3200,4000,4800],postcard:cards('Back on the trumpet. Played your name badly on purpose.','I can manage the quiet notes. The loud ones will come.'),phases:[\n phase('open','A routine incision','Scalpel [1]. Begin at the first dot. Hold and follow the cyan guide.',[cut()]),\n phase('bleeders','A little cautery','Laser [5]. Hold on the tiny bright bleeders. Watch the heat.',[at('bleeder',-2,-.3),at('bleeder',1.4,.5)]),\n phase('scan','Something beneath the scar','Scanner [8] reveals the mass and three nodules. Laser the nodules.',[at('nodule',-3,-1.3,{buried:true}),at('nodule',2.8,1.5,{buried:true}),at('nodule',3,-1.5,{buried:true}),at('mass',0,0,{path:circle(0,0),buried:true})]),\n phase('reveal','It flinched','Forceps. The specimen just moved. Keep your hand steady.',[at('cocoon',0,0)],{drama:'IT MOVED.'}),close()]},\n {id:'crosstalk',title:'Crosstalk',patient:'Hal Minsky',age:58,detail:'Bus driver. Route 9. He remembers every passenger’s stop.',sites:['Liver','Lung','Arm'],field:'liver',seconds:300,vitals:60,lead:'wren',gift:1,ai:false,ranks:[3300,4400,5500,6600],postcard:cards('Route 9 is running again. Your stop is always free.','They gave my route to a younger man. I am teaching him the names.'),phases:[\n phase('triage','Three sites. One patient.','Q / E change sites. Every wound keeps bleeding while you are away.',[...Array.from({length:3},(_,site)=>[wound(-2,-.8,site),wound(2,1,site),at('pool',-1,0,{site,radius:1})]).flat()]),\n phase('code','CODE — charge the paddles','LMB + RMB together when the charge reaches the green band.',[],{code:true}),\n phase('discovery','The room holds its breath','Space starts pulse-lock. Match the next three heartbeats.',[wound(-2,-1,0,true),wound(2,1,1,true),wound(0,0,2,true)],{gift:true,goal:'gift',drama:'HOLD. STILL.'}),close()]},\n {id:'it-moves',title:'It Moves',patient:'Gwen Abara',age:34,detail:'She came back before the last song. Her scar is moving.',sites:['Abdomen'],field:'abdomen',seconds:330,vitals:75,lead:'wren',gift:1,ai:false,ranks:[4000,5300,6600,8000],postcard:cards('I wrote a song about the thing you took out. It is not a lullaby.','The scar is quiet. That is enough music for today.'),phases:[\n phase('reopen','The scar remembers','Follow the old incision. This time we keep the evidence.',[cut()]),\n phase('lull','LULL — the quiet is a symptom','Laser the lilac Lulls. Gel their numb patches. Do not trust a quiet monitor.',[at('lull',-3,-1),at('lull',2.5,-1.2),at('lull',.4,1.6)]),\n phase('cocoons','Bag the evidence','Forceps on the cocoons. Suture the tears.',[wound(-2,0),wound(2,.8)]),\n phase('matron','The Matron','Wait for her yawn. Hold the Syringe in her open maw: two Binder doses.',[at('matron',0,0,{radius:1.25})],{drama:'SHE IS A MOTHER.'}),close()]},\n {id:'struck-off',title:'Struck Off',patient:'“Big Ana” Duarte',age:46,detail:'Stevedore. Her crew will not leave the ship without her.',sites:['Ship clinic'],field:'abdomen',seconds:330,vitals:70,lead:'sabine',gift:1,ai:true,ranks:[4400,5900,7400,8900],postcard:cards('The whole crew signed this. Even the one who cannot write.','The sea still makes me nervous. My crew pretends not to notice.'),phases:[\n phase('flap','Lift, clip, look beneath','Forceps on the gold flap handle. Lift up and release above the clip line.',[at('flap',0,-1.5),at('solace',-.7,-.1,{generation:1,parent:-1})]),\n phase('storm','SOLACE — the storm arrives','Scalpel divides the large ones. Laser the smallest. Space: Second Pulse.',[at('solace',-3,1,{generation:1}),at('solace',3,-1,{generation:1})],{gift:true,drama:'THEN USE THE SHAKE.'}),\n phase('mother','Mother Solace','Your colleague holds the flap. Divide the mother and burn every child.',[at('flap',0,-1.5),at('solace',0,0,{generation:1,parent:-1,radius:1.1})]),close()]},\n {id:'reverie',title:'Reverie',patient:'Bram Achterberg',age:60,detail:'The Chief wore his graft under his collar. He signed every trial.',sites:['Chest','Abdomen'],field:'heart',seconds:360,vitals:65,lead:'wren',gift:1,ai:true,ranks:[4300,5700,7200,8600],postcard:cards('A surgeon finishes. A better surgeon admits where he began.','I have started reading the names on the files.'),phases:[\n phase('incisions','Two surgeons. Two incisions.','Tab swaps surgeons. Q / E changes sites.',[cut(0,0,0),cut(0,0,1)]),\n phase('hunt','REVERIE — listen for the true pulse','Scan the moving ripple. Laser reveals it; keep firing while it is surfaced.',[at('reverie',0,0,{site:0}),at('decoy',-3,-1),at('decoy',3,1)]),\n phase('decoys','One heartbeat is real','Scan the decoys. The real ripple beats with the ECG.',[at('decoy',-3,-1,{site:1}),at('decoy',3,-1,{site:1}),at('decoy',0,2,{site:1}),at('reverie',0,0,{site:1})]),\n phase('consult','Ask for another pair of hands','Lift the flap. Start a Gift together: CONSULT extends both.',[at('flap',0,-1.5),at('reverie',0,0,{parent:-1})],{gift:true,drama:'I SIGNED THEM ALL.'}),close()]},\n {id:'gala-night',title:'Gala Night',patient:'Three gala donors',age:0,detail:'Three tables. Voss is still making his speech.',sites:['Table A','Table B','Table C'],field:'abdomen',seconds:390,vitals:80,lead:'wren',gift:1,ai:true,ranks:[4800,6400,8000,9600],postcard:cards('Three signatures. Three lives. One very bad party.','We have cancelled next year’s gala.'),phases:[\n phase('triage','BALM — comfort is spreading','Gel dissolves the pale lacquer. Drain and stitch before the film returns.',Array.from({length:3},(_,site)=>[at('balm',0,0,{site,radius:1.7}),at('pool',-2,-.7,{site}),wound(2,1,site)]).flat()),\n phase('nodes','Find the source','Two Binder doses into each translucent Node. Clear the film around it.',Array.from({length:3},(_,site)=>[at('node',0,0,{site}),at('balm',0,0,{site})]).flat(),{drama:'THE SPEECH IS STILL PLAYING.'}),close()]},\n {id:'mercy',title:'Mercy',patient:'Lucan Voss',age:50,detail:'His own product is inside his heart. He is still your patient.',sites:['Heart'],field:'heart',seconds:480,vitals:100,lead:'wren',gift:1,ai:true,ranks:[6800,9000,11300,13600],postcard:cards('You saved me. That is the one thing I could never have sold.','The cuffs are uncomfortable. I am told that is the point.'),phases:[\n phase('open','The last incision','Open the field. Whatever he did, your hands must be honest.',[cut()]),\n phase('anesthesia','MERCY / I — Anesthesia','Laser all six motes. Three Binder doses while the shield is down.',[at('mercy',0,0,{radius:1.4}),...Array.from({length:6},(_,i)=>at('mote',Math.cos(i*Math.PI/3)*2.5,Math.sin(i*Math.PI/3)*2.1))],{drama:'SHE IS SINGING.'}),\n phase('kindness-code-1','MERCY / II — The Kindness','She stopped his heart. Shock in the green band.',[],{code:true}),\n phase('rakes-1','Thirty seconds to close','Three rakes. Thirty seconds. Stitch now.',[wound(-3,-1,0,true),wound(2.7,-1,0,true),wound(0,1.5,0,true)],{goal:'race'}),\n phase('kindness-code-2','The Kindness — again','One more shock. Do not let her call this kindness.',[],{code:true}),\n phase('rakes-2','Not one stitch left behind','Close all three before thirty seconds pass.',[wound(-3,1,0,true),wound(2.7,1,0,true),wound(0,-1.5,0,true)],{goal:'race'}),\n phase('last-rites','MERCY / III — Last Rites','Follow the guide as the ventricle beats.',[at('incision',0,0,{path:circle(0,0,1.7)})],{drama:'WE ARE NOT FINISHED.'}),\n phase('tendrils','Five hands around a heart','Forceps. Free all five tendrils before they reattach.',Array.from({length:5},(_,i)=>at('tendril',Math.cos(i*Math.PI*2/5)*2.4,Math.sin(i*Math.PI*2/5)*2))),\n phase('binder-finish','One Gift. Three points.','A Gift is yours. Activate it, then Binder into all three gold marks.',[at('binder',-2,-.8),at('binder',2,-.8),at('binder',0,1.6)],{gift:true,goal:'gift-binder'}),\n phase('final-code','Bring him back','Every surgeon. One heartbeat. Charge the paddles.',[],{code:true}),close()]},\n];\nexport const SESSION:Case={id:'gala-shift',title:'The Gala Shift',patient:'The night shift',age:0,detail:'Two patients. One team. Keep both alive.',sites:['Table A','Table B'],field:'abdomen',seconds:270,vitals:80,lead:'wren',gift:1,ai:true,ranks:[3000,4000,5000,6000],postcard:cards('The night shift held.','Both tables made it to morning.'),phases:[phase('team','Two tables. One team.','Split the work. Q / E switches tables. Keep both patients alive.',[wound(-3,-1,0),wound(2,1,1),at('pool',-2,0),at('pool',2,1,{site:1}),at('shard',3,-1),at('lull',-2,-1,{site:1}),at('node',0,1,{site:1}),at('balm',0,1,{site:1}),at('flap',0,-1.5),at('shard',0,0,{parent:-1})]),close()]};\nexport const allCases=[...CASES,SESSION];\nexport const getCase=(id:string):Case=>allCases.find(c=>c.id===id)??CASES[0];\nexport function validateCase(c:Case):string[]{\n const issues:string[]=[];\n if(\"'!c.phases.length||!c.phases.at(-1)?.close)issues.push(`${c.id}: final phase must close`);\n if(c.seconds<60||c.sites.length<1||c.sites.length>3)issues.push(`${c.id}: invalid clock or sites`);\n for(const p of c.phases)for(const s of p.spawn){if((s.site??0)>=c.sites.length)issues.push(`${c.id}/${p.id}: invalid site`);if(s.path&&s.path.length<2)issues.push(`${c.id}/${p.id}: short guide`);}\n return issues;\n}\n'\"''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nD=Path('labs/game/scenes/op')\n(D/'geometry.ts').write_text('''/** @file Pure stroke geometry used by tool rules, aiming assistance and the surgeon bot. */\nimport type { Point, Target } from '../../data/types';\nexport const clamp=(n:number,a:number,b:number):number=>Math.max(a,Math.min(b,n));\nexport const dist=(a:Point,b:Point):number=>Math.hypot(a[0]-b[0],a[1]-b[1]);\nexport function pathLength(path:Point[]):number {let d=0;for(let i=1;i<path.length;i++)d+=dist(path[i-1],path[i]);return d;}\nexport function pathAt(path:Point[],along:number):Point {\n for(let i=1;i<path.length;i++){const a=path[i-1],b=path[i],d=dist(a,b);if(along<=d)return [a[0]+(b[0]-a[0])*clamp(along/d,0,1),a[1]+(b[1]-a[1])*clamp(along/d,0,1)];along-=d;}return path.at(-1)??[0,0];\n}\nexport function nearest(path:Point[],x:number,z:number):{distance:number;along:number;side:number;point:Point}{\n let distance=Infinity,along=0,side=0,sum=0;let point:Point=[x,z];\n for(let i=1;i<path.length;i++){const a=path[i-1],b=path[i],dx=b[0]-a[0],dz=b[1]-a[1],l=Math.hypot(dx,dz),t=clamp(((x-a[0])*dx+(z-a[1])*dz)/(l*l||1),0,1),p:Point=[a[0]+dx*t,a[1]+dz*t],d=dist(p,[x,z]);if(d<distance){distance=d;along=sum+l*t;side=Math.sign(dx*(z-a[1])-dz*(x-a[0]));point=p;}sum+=l;}\n return {distance,along,side,point};\n}\nexport const distanceTo=(t:Target,x:number,z:number):number=>t.path.length?nearest(t.path,x,z).distance:Math.hypot(t.x-x,t.z-z);\n''')\n(D/'state.ts').write_text('''/** @file Operation creation, target creation and visible scoring events, with no page dependencies. */\nimport { getCase } from '../../data/cases';\nimport { defaults } from '../../data/balance';\nimport type { Operation, Point, Rating, Rules, Seat, Spawn, Target } from '../../data/types';\nexport const defaultRules=():Rules=>({balance:defaults(),difficulty:'Resident',simpleGift:false,attract:false,freezeVitals:false,freezeClock:false,infiniteGift:false,oneHit:false});\nexport const patientAt=(s:Operation,site:number):number=>s.patients.length>1?site:0;\nexport function event(s:Operation,type:string,text:string,x=0,z=0,seat=0):void{\n s.events.push({n:++s.eventId,type,text,x,z,seat});if(s.events.length>48)s.events.shift();\n}\nexport function seat(id:number,kind:'still'|'pulse'|'none',gift:number):Seat{\n return {id,x:0,z:0,px:0,pz:0,site:0,tool:3,held:false,charge:0,cooldown:0,heat:0,healthy:0,grab:0,start:[0,0],gift,giftUntil:0,giftKind:kind,pulseAt:0,beats:0,perfect:0,good:0,giftCounter:0,shockCounter:0,swapCounter:0,score:0,slips:0,chain:1,best:1,active:true};\n}\nexport function spawn(s:Operation,spec:Spawn):Target {\n const p:Point=spec.at??spec.path?.[0]??[0,0];\n const t:Target={kind:spec.kind,site:spec.site??0,deep:spec.deep??false,buried:spec.buried??false,generation:spec.generation??1,parent:spec.parent??0,required:spec.required??true,radius:spec.radius??.65,hp:spec.hp??1,id:s.nextId++,x:p[0],z:p[1],baseX:p[0],baseZ:p[1],path:spec.path?.map(p=>[...p])??[],progress:0,done:false,born:s.fieldTicks,exposed:0,scanned:0,cycle:0,lift:0,clip:0,dose:0,mask:0,last:0,stitches:[]};\n if(t.parent===-1)t.parent=s.targets.findLast(f=>f.kind==='flap'&&f.site===t.site&&\"'!f.done)?.id??0;\n if(t.kind==='\"'flap')t.required=false;\n if(t.kind==='lull')t.hp=1.5;\n if(t.kind==='reverie'){t.hp=5;t.buried=true;}\n if(t.kind==='solace')t.radius=[.9,.6,.35][t.generation-1]??.35;\n if(t.kind==='balm')t.radius=spec.radius??1.1;\n if(t.kind==='mass')t.radius=1.3;\n s.targets.push(t);return t;\n}\nexport function startPhase(s:Operation,phase:number):void{\n const c=getCase(s.caseId);s.phase=phase;s.phaseAt=s.fieldTicks;s.phaseWait=0;\n const p=c.phases[phase];s.hint=p.hint;s.lastProgress=s.tick;\n for(const t of s.targets)if(t.kind==='flap')t.done=true;\n for(const spec of p.spawn)spawn(s,spec);\n if(p.goal==='stabilize')s.patients[0]=40;\n if(p.gift&&s.seats[0].gift===0)s.seats[0].gift=1;\n if(p.close){for(const t of s.targets)if(\"'!t.done&&t.kind!=='\"'flap')t.required=true;}\n if(p.code){s.code={patient:0,until:s.fieldTicks+48000,tries:0,scripted:true};event(s,'code','CODE. Both triggers, in the green band.');}\n if(p.drama)event(s,'drama',p.drama);\n event(s,'phase',p.title);\n}\nexport function createOperation(id:string,seed=1,humanSeats=1,phase=0,rules=defaultRules()):Operation{\n const c=getCase(id),n=c.id==='gala-night'||c.id==='gala-shift'?c.sites.length:1;\n const s:Operation={caseId:c.id,seed,tick:0,fieldTicks:0,phase:0,phaseAt:0,phaseWait:0,status:'playing',reason:'',patients:Array.from({length:n},()=>c.vitals),left:Math.round(c.seconds*6000*(rules.difficulty==='Intern'?1.3:rules.difficulty==='Attending'?.85:1)*rules.balance.clock),targets:[],seats:Array.from({length:humanSeats},(_,i)=>seat(i,i>1?'none':i===0?(c.lead==='wren'?'still':'pulse'):(c.lead==='wren'?'pulse':'still'),c.gift)),nextId:1,score:0,chain:1,best:1,slips:0,rating:'',eventId:0,events:[],lastProgress:0,hint:'',code:null,codes:Array.from({length:n},()=>0),bossRound:0,consultUntil:0,retry:phase>0,dev:false};\n if(c.ai&&humanSeats===1)s.seats.push(seat(1,c.lead==='wren'?'pulse':'still',c.gift));\n startPhase(s,Math.min(phase,c.phases.length-1));return s;\n}\nexport function rate(s:Operation,rules:Rules,seat:Seat,rating:Rating,base:number,x=seat.x,z=seat.z):void{\n const quality={TEXTBOOK:1.5,CLEAN:1,ROUGH:.5,SLIP:0}[rating];\n if(quality>=1){const add=seat.giftUntil>s.tick&&seat.giftKind==='pulse'?.2:.1;s.chain=Math.min(2,s.chain+add);seat.chain=Math.min(2,seat.chain+add);}\n const points=Math.round(base*quality*s.chain);s.score+=points;seat.score+=points;s.best=Math.max(s.best,s.chain);seat.best=Math.max(seat.best,seat.chain);s.rating=rating;s.lastProgress=s.tick;\n if(seat.giftUntil>s.tick&&seat.giftKind==='pulse')s.patients[patientAt(s,seat.site)]=Math.min(100,s.patients[patientAt(s,seat.site)]+rules.balance.pulseHeal);\n event(s,'rating',rating,x,z,seat.id);\n}\nexport function finishTarget(s:Operation,rules:Rules,seat:Seat,t:Target,base=100,rating:Rating='TEXTBOOK'):void{\n t.done=true;rate(s,rules,seat,rating,base,t.x,t.z);\n if(t.kind==='wound'||t.kind==='incision')spawn(s,{kind:t.kind==='incision'?'wound':'abrasion',at:[t.x,t.z],path:t.path,site:t.site,required:false});\n if(t.kind==='lull')spawn(s,{kind:'cocoon',at:[t.x,t.z],site:t.site});\n}\nexport function fail(s:Operation,reason:string):void{s.status='lost';s.reason=reason;event(s,'lost',reason);}\nexport function slip(s:Operation,rules:Rules,seat:Seat,text:string):void{\n if(s.tick-seat.healthy<60)return;seat.healthy=s.tick;s.slips++;seat.slips++;s.chain=1;seat.chain=1;\n s.patients[patientAt(s,seat.site)]-=6;rate(s,rules,seat,'SLIP',0);event(s,'say',text,seat.x,seat.z);\n spawn(s,{kind:'wound',at:[seat.x,seat.z],path:[[seat.x-.6,seat.z],[seat.x+.6,seat.z]],site:seat.site,required:false});\n const limit=rules.difficulty==='Intern'?10:rules.difficulty==='Attending'?3:rules.balance.slipLimit;\n if(s.slips>limit&&\"'!rules.attract)fail(s,'\"'Too many slips. Hand over the instruments.');\n}\nexport function rank(s:Operation):string{\n const c=getCase(s.caseId),total=s.score+Math.ceil(s.left/6000)*10+Math.round(Math.min(...s.patients))*20+(s.slips===0?2000:0)+(s.seats[0].gift?1000:0);\n let r=total>=c.ranks[3]?'S':total>=c.ranks[2]?'A':total>=c.ranks[1]?'B':'C';if(s.retry&&(r==='S'||r==='A'))r='B';return r;\n}\n''')\n(D/'gift.ts').write_text('''/** @file Beat-timed Gifts, cooperative Consult and life-saving charge-ring shocks. */\nimport type { Operation, Rules, Seat } from '../../data/types';\nimport { event, fail } from './state';\nexport const heartRate=(s:Operation):number=>Math.round(64+(100-Math.min(...s.patients))*.65);\nexport const beatPeriod=(s:Operation):number=>3600/heartRate(s);\nexport function activate(s:Operation,rules:Rules,seat:Seat,seconds:number):void{\n seat.pulseAt=0;seat.giftUntil=s.tick+Math.round(seconds*60);if(\"'!rules.infiniteGift&&!rules.attract)seat.gift=Math.max(0,seat.gift-1);\n event(s,'\"'gift',seat.giftKind==='pulse'?'SECOND PULSE':'STILLPOINT',seat.x,seat.z,seat.id);\n const partner=s.seats.find(p=>p.id\"'!==seat.id&&p.giftUntil>s.tick&&s.tick-(p.giftUntil-Math.round(seconds*60))<60);\n if(partner){seat.giftUntil+=Math.round(seconds*30);partner.giftUntil+=Math.round(seconds*30);s.consultUntil=s.tick+120;event(s,'\"'drama','CONSULT\"'!'\"');}\n}\nexport function pressGift(s:Operation,rules:Rules,seat:Seat):void{\n if(seat.giftKind==='none'||seat.giftUntil>s.tick)return;\n if(\"'!seat.pulseAt){if(seat.gift<1&&!rules.attract&&!rules.infiniteGift){event(s,'\"'say','One Gift per case, Doctor.');return;}if(rules.simpleGift){activate(s,rules,seat,6);return;}seat.pulseAt=s.tick+1;seat.beats=0;seat.perfect=0;seat.good=0;event(s,'pulse','Listen. Match the next three heartbeats.');return;}\n const period=beatPeriod(s),d=Math.abs((s.tick%period+period/2)%period-period/2);\n if(d<=8.4&&seat.beats<3){seat.beats++;if(d<=4.2)seat.perfect++;else seat.good++;event(s,'beat',d<=4.2?'PERFECT':'GOOD');if(seat.beats===3)activate(s,rules,seat,rules.balance.giftBase+seat.perfect*2.5+seat.good*rules.balance.giftPerBeat);}\n}\nexport function updateGift(s:Operation,rules:Rules):void{\n for(const seat of s.seats)if(seat.pulseAt&&s.tick-seat.pulseAt>beatPeriod(s)*4)activate(s,rules,seat,rules.balance.giftBase+seat.perfect*2.5+seat.good*rules.balance.giftPerBeat);\n}\nexport const shockLevel=(s:Operation):number=>(s.tick%150)/150;\nexport function shock(s:Operation):void{\n const code=s.code;if(\"'!code)return;const value=shockLevel(s);\n if(value>=.65&&value<=.86){s.patients[code.patient]=25;s.codes[code.patient]++;s.code=null;event(s,'\"'shock','SINUS RHYTHM. Welcome back.');}\n else{code.tries++;event(s,'say','Not yet. Charge it. Watch the green band.');if(code.tries>=2)fail(s,'Two shocks. No rhythm.');}\n}\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nD=Path('labs/game/scenes/op')\n(D/'geometry.ts').write_text('''/** @file Pure stroke geometry used by tool rules, aiming assistance and the surgeon bot. */\nimport type { Point, Target } from '../../data/types';\nexport const clamp=(n:number,a:number,b:number):number=>Math.max(a,Math.min(b,n));\nexport const dist=(a:Point,b:Point):number=>Math.hypot(a[0]-b[0],a[1]-b[1]);\nexport function pathLength(path:Point[]):number {let d=0;for(let i=1;i<path.length;i++)d+=dist(path[i-1],path[i]);return d;}\nexport function pathAt(path:Point[],along:number):Point {\n for(let i=1;i<path.length;i++){const a=path[i-1],b=path[i],d=dist(a,b);if(along<=d)return [a[0]+(b[0]-a[0])*clamp(along/d,0,1),a[1]+(b[1]-a[1])*clamp(along/d,0,1)];along-=d;}return path.at(-1)??[0,0];\n}\nexport function nearest(path:Point[],x:number,z:number):{distance:number;along:number;side:number;point:Point}{\n let distance=Infinity,along=0,side=0,sum=0;let point:Point=[x,z];\n for(let i=1;i<path.length;i++){const a=path[i-1],b=path[i],dx=b[0]-a[0],dz=b[1]-a[1],l=Math.hypot(dx,dz),t=clamp(((x-a[0])*dx+(z-a[1])*dz)/(l*l||1),0,1),p:Point=[a[0]+dx*t,a[1]+dz*t],d=dist(p,[x,z]);if(d<distance){distance=d;along=sum+l*t;side=Math.sign(dx*(z-a[1])-dz*(x-a[0]));point=p;}sum+=l;}\n return {distance,along,side,point};\n}\nexport const distanceTo=(t:Target,x:number,z:number):number=>t.path.length?nearest(t.path,x,z).distance:Math.hypot(t.x-x,t.z-z);\n''')\n(D/'state.ts').write_text('''/** @file Operation creation, target creation and visible scoring events, with no page dependencies. */\nimport { getCase } from '../../data/cases';\nimport { defaults } from '../../data/balance';\nimport type { Operation, Point, Rating, Rules, Seat, Spawn, Target } from '../../data/types';\nexport const defaultRules=():Rules=>({balance:defaults(),difficulty:'Resident',simpleGift:false,attract:false,freezeVitals:false,freezeClock:false,infiniteGift:false,oneHit:false});\nexport const patientAt=(s:Operation,site:number):number=>s.patients.length>1?site:0;\nexport function event(s:Operation,type:string,text:string,x=0,z=0,seat=0):void{\n s.events.push({n:++s.eventId,type,text,x,z,seat});if(s.events.length>48)s.events.shift();\n}\nexport function seat(id:number,kind:'still'|'pulse'|'none',gift:number):Seat{\n return {id,x:0,z:0,px:0,pz:0,site:0,tool:3,held:false,charge:0,cooldown:0,heat:0,healthy:0,grab:0,start:[0,0],gift,giftUntil:0,giftKind:kind,pulseAt:0,beats:0,perfect:0,good:0,giftCounter:0,shockCounter:0,swapCounter:0,score:0,slips:0,chain:1,best:1,active:true};\n}\nexport function spawn(s:Operation,spec:Spawn):Target {\n const p:Point=spec.at??spec.path?.[0]??[0,0];\n const t:Target={kind:spec.kind,site:spec.site??0,deep:spec.deep??false,buried:spec.buried??false,generation:spec.generation??1,parent:spec.parent??0,required:spec.required??true,radius:spec.radius??.65,hp:spec.hp??1,id:s.nextId++,x:p[0],z:p[1],baseX:p[0],baseZ:p[1],path:spec.path?.map(p=>[...p])??[],progress:0,done:false,born:s.fieldTicks,exposed:0,scanned:0,cycle:0,lift:0,clip:0,dose:0,mask:0,last:0,stitches:[]};\n if(t.parent===-1)t.parent=s.targets.findLast(f=>f.kind==='flap'&&f.site===t.site&&\"'!f.done)?.id??0;\n if(t.kind==='\"'flap')t.required=false;\n if(t.kind==='lull')t.hp=1.5;\n if(t.kind==='reverie'){t.hp=5;t.buried=true;}\n if(t.kind==='solace')t.radius=[.9,.6,.35][t.generation-1]??.35;\n if(t.kind==='balm')t.radius=spec.radius??1.1;\n if(t.kind==='mass')t.radius=1.3;\n s.targets.push(t);return t;\n}\nexport function startPhase(s:Operation,phase:number):void{\n const c=getCase(s.caseId);s.phase=phase;s.phaseAt=s.fieldTicks;s.phaseWait=0;\n const p=c.phases[phase];s.hint=p.hint;s.lastProgress=s.tick;\n for(const t of s.targets)if(t.kind==='flap')t.done=true;\n for(const spec of p.spawn)spawn(s,spec);\n if(p.goal==='stabilize')s.patients[0]=40;\n if(p.gift&&s.seats[0].gift===0)s.seats[0].gift=1;\n if(p.close){for(const t of s.targets)if(\"'!t.done&&t.kind!=='\"'flap')t.required=true;}\n if(p.code){s.code={patient:0,until:s.fieldTicks+48000,tries:0,scripted:true};event(s,'code','CODE. Both triggers, in the green band.');}\n if(p.drama)event(s,'drama',p.drama);\n event(s,'phase',p.title);\n}\nexport function createOperation(id:string,seed=1,humanSeats=1,phase=0,rules=defaultRules()):Operation{\n const c=getCase(id),n=c.id==='gala-night'||c.id==='gala-shift'?c.sites.length:1;\n const s:Operation={caseId:c.id,seed,tick:0,fieldTicks:0,phase:0,phaseAt:0,phaseWait:0,status:'playing',reason:'',patients:Array.from({length:n},()=>c.vitals),left:Math.round(c.seconds*6000*(rules.difficulty==='Intern'?1.3:rules.difficulty==='Attending'?.85:1)*rules.balance.clock),targets:[],seats:Array.from({length:humanSeats},(_,i)=>seat(i,i>1?'none':i===0?(c.lead==='wren'?'still':'pulse'):(c.lead==='wren'?'pulse':'still'),c.gift)),nextId:1,score:0,chain:1,best:1,slips:0,rating:'',eventId:0,events:[],lastProgress:0,hint:'',code:null,codes:Array.from({length:n},()=>0),bossRound:0,consultUntil:0,retry:phase>0,dev:false};\n if(c.ai&&humanSeats===1)s.seats.push(seat(1,c.lead==='wren'?'pulse':'still',c.gift));\n startPhase(s,Math.min(phase,c.phases.length-1));return s;\n}\nexport function rate(s:Operation,rules:Rules,seat:Seat,rating:Rating,base:number,x=seat.x,z=seat.z):void{\n const quality={TEXTBOOK:1.5,CLEAN:1,ROUGH:.5,SLIP:0}[rating];\n if(quality>=1){const add=seat.giftUntil>s.tick&&seat.giftKind==='pulse'?.2:.1;s.chain=Math.min(2,s.chain+add);seat.chain=Math.min(2,seat.chain+add);}\n const points=Math.round(base*quality*s.chain);s.score+=points;seat.score+=points;s.best=Math.max(s.best,s.chain);seat.best=Math.max(seat.best,seat.chain);s.rating=rating;s.lastProgress=s.tick;\n if(seat.giftUntil>s.tick&&seat.giftKind==='pulse')s.patients[patientAt(s,seat.site)]=Math.min(100,s.patients[patientAt(s,seat.site)]+rules.balance.pulseHeal);\n event(s,'rating',rating,x,z,seat.id);\n}\nexport function finishTarget(s:Operation,rules:Rules,seat:Seat,t:Target,base=100,rating:Rating='TEXTBOOK'):void{\n t.done=true;rate(s,rules,seat,rating,base,t.x,t.z);\n if(t.kind==='wound'||t.kind==='incision')spawn(s,{kind:t.kind==='incision'?'wound':'abrasion',at:[t.x,t.z],path:t.path,site:t.site,required:false});\n if(t.kind==='lull')spawn(s,{kind:'cocoon',at:[t.x,t.z],site:t.site});\n}\nexport function fail(s:Operation,reason:string):void{s.status='lost';s.reason=reason;event(s,'lost',reason);}\nexport function slip(s:Operation,rules:Rules,seat:Seat,text:string):void{\n if(s.tick-seat.healthy<60)return;seat.healthy=s.tick;s.slips++;seat.slips++;s.chain=1;seat.chain=1;\n s.patients[patientAt(s,seat.site)]-=6;rate(s,rules,seat,'SLIP',0);event(s,'say',text,seat.x,seat.z);\n spawn(s,{kind:'wound',at:[seat.x,seat.z],path:[[seat.x-.6,seat.z],[seat.x+.6,seat.z]],site:seat.site,required:false});\n const limit=rules.difficulty==='Intern'?10:rules.difficulty==='Attending'?3:rules.balance.slipLimit;\n if(s.slips>limit&&\"'!rules.attract)fail(s,'\"'Too many slips. Hand over the instruments.');\n}\nexport function rank(s:Operation):string{\n const c=getCase(s.caseId),total=s.score+Math.ceil(s.left/6000)*10+Math.round(Math.min(...s.patients))*20+(s.slips===0?2000:0)+(s.seats[0].gift?1000:0);\n let r=total>=c.ranks[3]?'S':total>=c.ranks[2]?'A':total>=c.ranks[1]?'B':'C';if(s.retry&&(r==='S'||r==='A'))r='B';return r;\n}\n''')\n(D/'gift.ts').write_text('''/** @file Beat-timed Gifts, cooperative Consult and life-saving charge-ring shocks. */\nimport type { Operation, Rules, Seat } from '../../data/types';\nimport { event, fail } from './state';\nexport const heartRate=(s:Operation):number=>Math.round(64+(100-Math.min(...s.patients))*.65);\nexport const beatPeriod=(s:Operation):number=>3600/heartRate(s);\nexport function activate(s:Operation,rules:Rules,seat:Seat,seconds:number):void{\n seat.pulseAt=0;seat.giftUntil=s.tick+Math.round(seconds*60);if(\"'!rules.infiniteGift&&!rules.attract)seat.gift=Math.max(0,seat.gift-1);\n event(s,'\"'gift',seat.giftKind==='pulse'?'SECOND PULSE':'STILLPOINT',seat.x,seat.z,seat.id);\n const partner=s.seats.find(p=>p.id\"'!==seat.id&&p.giftUntil>s.tick&&s.tick-(p.giftUntil-Math.round(seconds*60))<60);\n if(partner){seat.giftUntil+=Math.round(seconds*30);partner.giftUntil+=Math.round(seconds*30);s.consultUntil=s.tick+120;event(s,'\"'drama','CONSULT\"'!'\"');}\n}\nexport function pressGift(s:Operation,rules:Rules,seat:Seat):void{\n if(seat.giftKind==='none'||seat.giftUntil>s.tick)return;\n if(\"'!seat.pulseAt){if(seat.gift<1&&!rules.attract&&!rules.infiniteGift){event(s,'\"'say','One Gift per case, Doctor.');return;}if(rules.simpleGift){activate(s,rules,seat,6);return;}seat.pulseAt=s.tick+1;seat.beats=0;seat.perfect=0;seat.good=0;event(s,'pulse','Listen. Match the next three heartbeats.');return;}\n const period=beatPeriod(s),d=Math.abs((s.tick%period+period/2)%period-period/2);\n if(d<=8.4&&seat.beats<3){seat.beats++;if(d<=4.2)seat.perfect++;else seat.good++;event(s,'beat',d<=4.2?'PERFECT':'GOOD');if(seat.beats===3)activate(s,rules,seat,rules.balance.giftBase+seat.perfect*2.5+seat.good*rules.balance.giftPerBeat);}\n}\nexport function updateGift(s:Operation,rules:Rules):void{\n for(const seat of s.seats)if(seat.pulseAt&&s.tick-seat.pulseAt>beatPeriod(s)*4)activate(s,rules,seat,rules.balance.giftBase+seat.perfect*2.5+seat.good*rules.balance.giftPerBeat);\n}\nexport const shockLevel=(s:Operation):number=>(s.tick%150)/150;\nexport function shock(s:Operation):void{\n const code=s.code;if(\"'!code)return;const value=shockLevel(s);\n if(value>=.65&&value<=.86){s.patients[code.patient]=25;s.codes[code.patient]++;s.code=null;event(s,'\"'shock','SINUS RHYTHM. Welcome back.');}\n else{code.tries++;event(s,'say','Not yet. Charge it. Watch the green band.');if(code.tries>=2)fail(s,'Two shocks. No rhythm.');}\n}\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/data/types.ts');s=p.read_text().replace('healthy:number; grab','healthy:number; lastSlip:number; refuseAt:number; grab');p.write_text(s)\np=Path('labs/game/scenes/op/state.ts');s=p.read_text().replace('healthy:0,grab:0','healthy:0,lastSlip:-1000,refuseAt:-1000,grab:0').replace('if(s.tick-seat.healthy<60)return;seat.healthy=s.tick','if(s.tick-seat.lastSlip<60)return;seat.lastSlip=s.tick');p.write_text(s)\nPath('labs/game/scenes/op/tools.ts').write_text('''/** @file All eight instruments act on body targets through a complete, explicit response matrix. */\nimport { RESPONSE, TOOLS } from '../../data/tools';\nimport type { Operation, Rules, Seat, Target } from '../../data/types';\nimport { clamp, distanceTo, dist, nearest, pathLength } from './geometry';\nimport { event, finishTarget, patientAt, rate, slip, spawn } from './state';\nexport function hidden(s:Operation,t:Target):boolean{\n if(t.parent){const flap=s.targets.find(f=>f.id===t.parent);if(flap&&\"'!flap.done&&flap.lift<.8)return true;}\n return s.targets.some(p=>p.kind==='\"'pool'&&\"'!p.done&&p.site===t.site&&p.hp>.35&&Math.hypot(p.x-t.x,p.z-t.z)<p.radius*.7&&t.kind!=='\"'pool');\n}\nexport function lacquered(s:Operation,t:Target):boolean{return s.targets.some(p=>p.kind==='balm'&&\"'!p.done&&p.site===t.site&&Math.hypot(p.x-t.x,p.z-t.z)<p.radius);}\nfunction refuse(s:Operation,seat:Seat,text:string):void{if(s.tick-seat.refuseAt<70)return;seat.refuseAt=s.tick;event(s,'\"'refusal',text,seat.x,seat.z);}\nexport function targetAt(s:Operation,seat:Seat):Target|undefined{\n const candidates=s.targets.filter(t=>\"'!t.done&&t.site===seat.site&&distanceTo(t,seat.x,seat.z)<(t.path.length?1.25:t.radius+.45));\n const tool=TOOLS[seat.tool];\n return candidates.sort((a,b)=>Number(RESPONSE[tool][b.kind]==='\"'effect')-Number(RESPONSE[tool][a.kind]==='effect')||distanceTo(a,seat.x,seat.z)-distanceTo(b,seat.x,seat.z))[0];\n}\nfunction extract(s:Operation,r:Rules,p:Seat,t:Target,held:boolean):void{\n if(\"'!p.grab){p.grab=t.id;p.start=[p.x,p.z];event(s,'\"'tool','GRIP',p.x,p.z,p.id);}\n if(t.kind==='flap'){\n  t.lift=clamp((p.start[1]-p.z)/1.7,0,1);if(\"'!held){if(t.lift>=.8){t.clip=s.fieldTicks+r.balance.clipSeconds*6000;event(s,'\"'tool','FLAP CLIPPED',t.x,t.z);}else t.lift=0;p.grab=0;}return;\n }\n const travel=dist([p.x,p.z],p.start);\n if(travel>=1.2){const speed=dist([p.x,p.z],[p.px,p.pz])*60;finishTarget(s,r,p,t,t.kind==='mass'?300:t.kind==='shard'?100:50,speed>8?'ROUGH':'TEXTBOOK');if(speed>8)spawn(s,{kind:'bleeder',at:[t.x,t.z],site:t.site,required:false});p.grab=0;}\n if(\"'!held)p.grab=0;\n}\nfunction cut(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(t.kind==='\"'solace'){\n  if(t.generation>=3){refuse(s,p,'Small enough. Laser now.');return;}\n  if(\"'!p.grab){p.grab=t.id;p.start=[p.x,p.z];}\n  if(dist(p.start,[p.x,p.z])>=1.5){t.done=true;rate(s,r,p,'\"'TEXTBOOK',200);for(const sign of [-1,1])spawn(s,{kind:'solace',at:[t.x+sign*.6,t.z+sign*.15],site:t.site,generation:t.generation+1,parent:t.parent});p.grab=0;}return;\n }\n if(t.kind==='mass'&&t.dose){refuse(s,p,'The edge is free. Lift the mass with Forceps.');return;}\n const n=nearest(t.path,p.x,p.z),length=pathLength(t.path);\n if(n.distance>=r.balance.cutTolerance){if(++p.healthy>12)slip(s,r,p,'Off the guide. Easy, Doctor.');return;}\n p.healthy=0;\n if(t.progress===0&&n.along>.8){refuse(s,p,'Begin on the first dot. Follow the guide in order.');return;}\n if(n.along<t.progress+1.2){t.progress=Math.max(t.progress,n.along);t.last+=n.distance;t.cycle++;}\n if(t.progress>=length-.18){const mean=t.last/Math.max(1,t.cycle),rating=mean<.18?'TEXTBOOK':mean<.4?'CLEAN':'ROUGH';if(t.kind==='mass'){t.dose=1;rate(s,r,p,rating,200);event(s,'say','Forceps. Lift it into the tray.');}else finishTarget(s,r,p,t,200,rating);}\n}\nfunction sew(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(lacquered(s,t)){refuse(s,p,'Balm seals the wound. Dissolve it with Gel first.');return;}\n const n=nearest(t.path,p.x,p.z),spacing=r.balance.stitchSpacing,need=Math.ceil(pathLength(t.path)/spacing);\n if(n.distance<.12||n.distance>1.2)return;\n if(n.side\"'!==t.last&&(t.stitches.length===0||dist(t.stitches.at(-1)!,n.point)>=spacing*.6)){\n  t.stitches.push(n.point);t.last=n.side;t.progress=t.stitches.length/need;event(s,'\"'stitch','STITCH',n.point[0],n.point[1],p.id);s.lastProgress=s.tick;\n  if(t.stitches.length>=need)finishTarget(s,r,p,t,20*need,t.cycle>need*130?'CLEAN':'TEXTBOOK');\n }t.cycle++;\n}\nfunction laser(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(p.cooldown>0)return;\n p.heat+=1/60;if(p.heat>=r.balance.laserHeat){p.cooldown=120;p.heat=0;event(s,'say','Laser overheated. Two seconds, Doctor.');return;}\n const damage=(r.oneHit?100:r.balance.laserPower)/60;\n if(t.kind==='solace'&&t.generation<3){refuse(s,p,'It likes the warmth. Divide it with the Scalpel first.');return;}\n if(t.kind==='reverie'){\n  if(t.scanned<s.fieldTicks){refuse(s,p,'Find its pulse with the Scanner first.');return;}\n  if(t.exposed<s.fieldTicks){t.exposed=s.fieldTicks+18000;t.dose++;event(s,'tool','SURFACED',t.x,t.z);}\n }\n if(t.kind==='balm'){t.radius-=damage*.8;s.patients[patientAt(s,p.site)]-=.5/60;if(t.radius<.2)finishTarget(s,r,p,t,30);return;}\n t.progress+=damage;\n const need=t.kind==='lull'?1.5:t.kind==='mote'?.6:t.kind==='reverie'?5:1.2;\n if(t.progress>=need*r.balance.strainHp*(1+r.balance.coopHp*Math.max(0,s.seats.filter(x=>x.active).length-1))&&(t.kind\"'!=='\"'reverie'||t.dose>=3))finishTarget(s,r,p,t,['lull','reverie','solace'].includes(t.kind)?500:100);\n}\nfunction binder(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(t.kind==='matron'&&(s.fieldTicks-t.born)%48000>15000){refuse(s,p,'Armoured. Wait for the yawn.');return;}\n if(t.kind==='mercy'&&s.targets.some(m=>m.kind==='mote'&&\"'!m.done)){refuse(s,p,'\"'The motes shield her. Laser every one.');return;}\n if(t.kind==='binder'&&\"'!s.seats.some(seat=>seat.giftUntil>s.tick)){refuse(s,p,'\"'These points need a Gift. Press Space.');return;}\n t.progress+=1/60;p.charge=0;\n if(t.progress>=.4){t.progress=0;t.dose++;p.cooldown=24;rate(s,r,p,'TEXTBOOK',100);event(s,'binder','BINDER',t.x,t.z,p.id);const need=t.kind==='matron'||t.kind==='node'?2:t.kind==='mercy'?3:1;if(t.dose>=need){t.done=true;rate(s,r,p,'TEXTBOOK',500);if(t.kind==='node')for(const f of s.targets)if(f.site===t.site&&f.kind==='balm')f.clip=s.fieldTicks+36000;}}\n}\nfunction gel(s:Operation,r:Rules,p:Seat,t:Target):void{\n if(t.kind==='balm'){t.radius-=1/60;if(t.radius<.18)finishTarget(s,r,p,t,30);return;}\n let sector:number;\n if(t.path.length)sector=Math.round(nearest(t.path,p.x,p.z).along/pathLength(t.path)*11);\n else sector=Math.round(((Math.atan2(p.z-t.z,p.x-t.x)+Math.PI)/(2*Math.PI))*11);\n for(let i=Math.max(0,sector-1);i<=Math.min(11,sector+1);i++)t.mask|=1<<i;\n t.progress+=1/60;\n const count=t.mask.toString(2).replaceAll('0','').length;\n if(count>=11&&t.progress>.35)finishTarget(s,r,p,t,50);\n}\nexport function useTool(s:Operation,r:Rules,p:Seat,held:boolean):void{\n const was=p.held;p.held=held;p.cooldown=Math.max(0,p.cooldown-1);\n if(\"'!held)p.heat=Math.max(0,p.heat-2/60);\n if(p.tool===5&&!held&&was&&p.charge>0&&p.cooldown===0){const dose=p.charge>=.75&&p.charge<=.95?24:p.charge>.95?6:r.balance.stabilizer*Math.min(1,p.charge/.75);s.patients[patientAt(s,p.site)]=Math.min(100,s.patients[patientAt(s,p.site)]+dose);rate(s,r,p,dose===24?'\"'TEXTBOOK':dose>=12?'CLEAN':'ROUGH',20);event(s,'inject',\"'`+${Math.round(dose)} VITALS`,p.x,p.z);p.charge=0;p.cooldown=120;}\n if(p.grab&&p.tool===1){const grab=s.targets.find(t=>t.id===p.grab&&!t.done);if(grab){extract(s,r,p,grab,held);return;}p.grab=0;}\n if(!held){p.grab=0;return;}\n if(p.tool===7){\n  for(const t of s.targets)if(!t.done&&t.site===p.site&&Math.hypot(t.x-p.x,t.z-p.z)<=3&&!hidden(s,t)){\n   if(t.buried&&t.scanned<s.fieldTicks){event(s,'\"'scan','FOUND',t.x,t.z);rate(s,r,p,'CLEAN',30);}\n   t.scanned=s.fieldTicks+36000;if(t.kind==='decoy')finishTarget(s,r,p,t,30);\n  }return;\n }\n const t=targetAt(s,p);\n if(p.tool===5){if(p.cooldown>0)return;if(t&&['matron','node','mercy','binder'].includes(t.kind)&&\"'!hidden(s,t)){binder(s,r,p,t);return;}p.charge=clamp(p.charge+1/60,0,1.2);return;}\n if(!t){if(p.tool===0){p.healthy++;if(p.healthy>12)slip(s,r,p,'\"'There is no incision guide here.');}if(p.tool===4){p.heat+=1/60;p.healthy++;if(p.healthy>60){slip(s,r,p,'That is healthy tissue. Move the beam.');p.healthy=0;}}return;}\n if(hidden(s,t)){refuse(s,p,t.parent?'Lift the flap with Forceps.':'Blood hides it. Drain the pool first.');return;}\n if(t.buried&&t.scanned<s.fieldTicks){refuse(s,p,'It is below the surface. Scanner first.');return;}\n if(RESPONSE[TOOLS[p.tool]][t.kind]\"'!=='\"'effect'){refuse(s,p,RESPONSE[TOOLS[p.tool]][t.kind]);return;}\n switch(p.tool){\n case 0:cut(s,r,p,t);break;\n case 1:if(t.kind==='mass'&&\"'!t.dose)refuse(s,p,'\"'Cut all the way around the mass first.');else extract(s,r,p,t,held);break;\n case 2:sew(s,r,p,t);break;\n case 3:if(lacquered(s,t)){refuse(s,p,'Gel the lacquer first.');break;}t.hp-=r.balance.drainRate/70;if(t.hp<=.04)finishTarget(s,r,p,t,30);break;\n case 4:laser(s,r,p,t);break;\n case 6:gel(s,r,p,t);break;\n }\n}\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
