tRate(s)/60)),4))\\\");p.write_text(s)\np=Path('labs/game/scenes/op/rules.test.ts');s=p.read_text();# Simple Gift becomes available at the discovery checkpoint.\ns=s.replace(\\\"const s = createOperation('crosstalk');\\\\n    pressGift(s, r, s.seats[0]);\\\", \\\"const s = createOperation('crosstalk',1,1,2);\\\\n    pressGift(s, r, s.seats[0]);\\\")\ns+='''\\\\nit('judges a delayed network rhythm press on its sampled ECG beat',()=>{const r=defaultRules(),s=createOperation('crosstalk',1,1,2),p=s.seats[0];s.tick=18;pressGift(s,r,p,0);const period=3600/Math.round(64+(100-s.patients[0])*.65);for(let i=1;i<=3;i++){const sampled=Math.round(period*i);s.tick=sampled+18;pressGift(s,r,p,sampled);}expect(p.beats).toBe(3);expect(p.giftUntil-s.tick).toBe(630);});\nit('requires distinct ECG peaks for the three-press Gift',()=>{const r=defaultRules(),s=createOperation('crosstalk',1,1,2);pressGift(s,r,s.seats[0]);pressGift(s,r,s.seats[0]);pressGift(s,r,s.seats[0]);expect(s.seats[0].beats).toBe(0);});\n''';p.write_text(s)\nPY\nnpx prettier --write labs/game/data/cases/quiet-lump.ts labs/game/data/cases/crosstalk.ts labs/game/scenes/op labs/game/ui/hud.ts labs/game/audio/mix.ts labs/game/view/field/sheet.ts\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/record.mts\nnpm test -- --reporter=dot\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
