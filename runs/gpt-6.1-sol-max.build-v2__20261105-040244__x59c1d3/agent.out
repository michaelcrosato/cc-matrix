s:207:  body?: string;\nengine/sim/actors.ts:247:  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\nengine/sim/props.ts:54:  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\nengine/sim/props.ts:69:  body: number;\nengine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\nengine/sim/props.ts:173:export function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\nengine/sim/props.ts:180:export function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\nengine/sim/props.ts:183:  const actors = (world as unknown as World).query('actor') as unknown as { id: number; actor: { body: number } }[];\nengine/sim/props.ts:213:    body: data.body,\n  sceneKind(registry);\n  return registry.get('scene', id) as unknown as Scene;\n}\n\n/** Whether `value` is a defined scene (an entry of kind `scene`), as a module exports it. */\nexport function isScene(value: unknown): value is Scene {\n  return isPlainObject(value) && value.kind === 'scene' && typeof value.id === 'string';\n}\n\n/** How a scene starts. */\nexport interface SceneOptions {\n  /** The seed every sim RNG stream derives from (1). */\n  seed?: number;\n  /** Setting values over the scene's, path → value (`--set`, a replay's `settings`). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Where the scene, its components and its settings are declared (the shared registry). */\n  registry?: Registry;\n  /** Where failing event listeners are recorded (the shared log). */\n  log?: Log;\n  /** The physics hook (WP 3.1). */\n  physics?: PhysicsHook;\n  /** The world's system probe (engine/sim/world.ts; the stats meter, WP 5.5). */\n  probe?: SystemProbe;\n}\n\n/** A started scene: the scene, its world and its settings store. */\nexport interface SceneRun<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  readonly scene: Scene<C, E>;\n  readonly world: World<C, E>;\n  /** The whole store, view settings included (presentation reads those); the world reads its sim view. */\n  readonly settings: Settings;\n      description: \"[seconds, metres] points: the body's height, linear between them (the jump the game makes).\" },\n  } },\n} as const;\n\n/** An `action` entry. */\nexport type Action = Entry<typeof ACTION_FIELDS>;\n\n/** One beat of an action. */\nexport type Beat = Action['beats'][number];\n\n/** A value with every field optional, all the way down: what a spec leaves out takes its default. */\ntype Loose<T> = T extends readonly (infer I)[] ? readonly Loose<I>[] : T extends object ? { readonly [K in keyof T]?: Loose<T[K]> } : T; // prettier-ignore\n\n/** What `defineAction` takes: `desc` and `beats`, each beat's `name` and `seconds`; the rest as it likes. */\nexport type ActionSpec = Loose<Omit<Action, 'id' | 'kind'>> & { desc: string; beats: readonly (Loose<Beat> & { name: string; seconds: number })[] }; // prettier-ignore\n\n/** The problems of an action beyond its fields. */\nfunction actionProblems(a: Action): string[] {\n  const out: string[] = [];\n  const names = a.beats.map((b) => b.name);\n  const known = (name: string, what: string, among = names) =>\n    name && !among.includes(name) && out.push(`${what} ${JSON.stringify(name)} is unknown${didYouMean(name, among)}`); // prettier-ignore\n  if (!names.length) out.push('it has no beats');\n  names.forEach((name, i) => names.indexOf(name) < i && out.push(`two beats are named ${JSON.stringify(name)}`));\n  a.beats.forEach((b) => {\n    known(b.then, `beat ${b.name}'s then`);\n    if (b.move && b.motion) out.push(`beat ${b.name} has a move and a motion: a move brings its own`);\n    for (const word of Object.keys(b.body ?? {})) known(word, `beat ${b.name}'s body state`, Object.keys(BODY_STATES));\n    const triples = [...Object.values(b.effectors ?? {}), b.scale ?? [1, 1, 1]];\n    if (triples.some((v) => v?.length !== 3)) out.push(`beat ${b.name} has a target or a scale that is not 3 numbers`);\n  });\n  readonly slots: Readonly<Record<string, string>>;\n  readonly parts: readonly BodyPart[];\n  readonly mirror: readonly BodyPart[];\n  readonly builds: Readonly<Record<string, { limbRadius?: number; torsoRadius?: number }>>;\n};\n\n/** What `defineBody` takes: any field; absent ones keep their defaults. */\nexport interface BodySpec {\n  description?: string;\n  slots?: Readonly<Record<string, string>>;\n  parts?: readonly BodyPart[];\n  mirror?: readonly BodyPart[];\n  limbRadius?: number;\n  torsoRadius?: number;\n  builds?: Readonly<Record<string, { limbRadius?: number; torsoRadius?: number }>>;\n  material?: string;\n  glowMaterial?: string;\n  build?: string;\n  gallery?: Gallery;\n}\n\n/** The names a point may give: the joints and the sockets. */\nconst NAMES: readonly string[] = [...JOINTS, ...SOCKETS];\n\n/** `name` with its side swapped (`thighL` → `thighR`), when the swapped name exists; else `name`. */\nexport function mirrorName(name: string): string {\n  const side = name.at(-1);\n  const swapped = name.slice(0, -1) + (side === 'L' ? 'R' : 'L');\n  return (side === 'L' || side === 'R') && NAMES.includes(swapped) ? swapped : name;\n}\n\n/** `length` negated (a right offset turned left). */\nconst negate = (length: BodyLength): BodyLength => (typeof length === 'number' ? -length : [-length[0], length[1]]);\n\n/** `point` mirrored left to right. */\nexport function mirrorPoint(point: BodyPoint): BodyPoint {\n  if (typeof point === 'string') return mirrorName(point);\n  if (point[0] === 'lerp') return ['lerp', mirrorPoint(point[1]), mirrorPoint(point[2]), point[3]];\n  if (point[0] === 'off') return ['off', mirrorPoint(point[1]), point[2], negate(point[3]), point[4]];\n  const [f, r, u] = point as readonly [BodyLength, BodyLength, BodyLength];\n  return [f, negate(r), u];\n}\n\n/** `part` mirrored left to right: its points and its `on` bone (see the file comment). */\nexport function mirrorPart(part: BodyPart): BodyPart {\n  const kinds = PART_TYPES[part[0]];\n  const mirrored = part.map((arg, i) => {\n    if (i === 0) return arg;\n    if (kinds[i - 1] === 'p') return mirrorPoint(arg as BodyPoint);\n    const on = (arg as PartOptions | undefined)?.on;\n    return i > kinds.length && on ? { ...(arg as PartOptions), on: mirrorName(on) } : arg;\n  });\n  return mirrored as unknown as BodyPart;\n}\n\n/** Why `value` is no length (signed when `offset`), or null. */\nfunction lengthProblem(value: unknown, offset: boolean): string | null {\n  const ok = (n: unknown) => typeof n === 'number' && Number.isFinite(n) && (offset || n > 0);\n  if (ok(value)) return null;\n  if (Array.isArray(value) && value.length === 2 && ok(value[0]) && ['head', 'limb', 'torso'].includes(value[1])) {\n    return null;\n  }\n  const what = offset ? 'metres, or [k, ref]' : 'metres above 0, or [k, ref] with k above 0';\n  return `${JSON.stringify(value)} is no ${offset ? 'offset' : 'size'} (write ${what}; ref head, limb or torso)`;\n}\n\n/** Why `point` is no point, or null. */\nexport function pointProblem(point: unknown): string | null {\n  if (typeof point === 'string') {\n    return NAMES.includes(point) ? null : `${JSON.stringify(point)} is no joint or socket${didYouMean(point, NAMES)}`;\n  }\nsed: can't read engine/input/actions.ts: No such file or directory\n","exit_code":2,"status":"failed"}}
