em;border:1px solid var(--line);white-space:pre-wrap;word-break:break-word;max-height:40vh;overflow:auto;width:100%}.demo-banner{position:absolute;top:17%;left:4%;background:#08242aeb;border:1px solid var(--gold);color:var(--gold);padding:.5em 1em;font-size:.75em;letter-spacing:.15em;pointer-events:none;z-index:30}.demo-prompt{position:absolute;bottom:2%;left:50%;transform:translateX(-50%);padding:.5em 1em;background:#071e26e8;color:var(--mint);white-space:nowrap;font-size:.7em;z-index:35}.touch-cover{position:absolute;z-index:95;left:8%;right:8%;top:30%;padding:2em;background:#071c25f5;border:1px solid var(--mint);text-align:center;pointer-events:auto}.touch-cover h2{font-size:clamp(24px,5vw,52px);line-height:1.25;letter-spacing:-.03em}.touch-cover p{font-size:clamp(15px,2.5vw,28px);color:var(--soft);margin:1em 0}.touch-cover button{font-size:clamp(18px,3vw,28px);border:1px solid var(--mint);min-height:52px;padding:.5em 1.5em}.boot{position:absolute;inset:0;background:#071b22;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1em;z-index:100}.boot svg{width:90px;height:90px;color:var(--mint)}.boot p{font-size:20px;letter-spacing:.18em}.boot:after{content:'';width:180px;height:1px;background:var(--mint);animation:beam 2s ease-in-out infinite}.boot.hidden{display:none}@keyframes beam{0%,100%{transform:scaleX(.2);opacity:.3}50%{transform:scaleX(1);opacity:1}}.credits-body{max-width:65%;font:italic calc(var(--u)*2.7)/1.4 Georgia,serif}.about-index{color:var(--soft);font-size:.65em}.tv-caption{position:absolute;right:4%;top:24%;max-width:23%;font-size:.65em;color:var(--gold);background:#09222bcb;padding:.7em 1em;border-left:2px solid var(--gold)}.view-debug{position:absolute;top:25%;left:4%;font:.65em monospace;color:#cef7cb;background:#06191dce;padding:1em;max-width:30%;white-space:pre-wrap;pointer-events:none}\n@media(max-width:700px) and (orientation:portrait){.title-content{width:65%;top:8%}.title-logo{font-size:14vw}.title-copy{display:none}.brandmark{font-size:2.2vw}.brandmark svg{width:7vw;height:7vw}.title-menu{margin-top:4vw}.title-menu button{font-size:3.8vw;min-height:9vw}.subtitle{font-size:4vw}.title-foot{font-size:2.5vw}.storm-lines{font-size:2vw}.page{padding:6%;gap:4vw}.page h2{font-size:8vw}.page .eyebrow{font-size:2.7vw}.page-body{gap:4vw;flex-wrap:wrap}.page-footer{font-size:4vw}.page-footer button{min-height:11vw}.settings-rows{max-width:100%;font-size:4vw}.setting-row{min-height:13vw}.tabs button{font-size:3.5vw;min-height:10vw}.feedback-card{max-width:100%;padding:1em;font-size:4.2vw}.feedback-card h3{font-size:6vw}.case-card{max-width:100%}.case-number{font-size:16vw}.case-card p,.briefing-content p{font-size:4vw}.briefing-content{max-width:100%}.side-note{display:none}.difficulty{font-size:4vw}.case-nav button{width:12vw;height:12vw}.tools-small svg{width:6vw;height:6vw}.small{font-size:3.5vw}.handbook-text{max-width:100%;font-size:4vw}.handbook-icon{width:15vw}.seat-grid{grid-template-columns:repeat(2,1fr);font-size:4vw}.seat-slot{min-height:30vw}}\n@media(prefers-reduced-motion:reduce){*{animation:none\"'!important;transition:none!important}}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/icons.ts <<'EOF'\n/** @file Original instrument and lighthouse glyphs, drawn in code and shared by toolbar, radial and Handbook. */\nconst paths=[\n 'M12 52 43 21M36 15l10-10 8 8-10 10M10 54l5-14 8 8-13 6',\n 'M14 8c0 15 1 25 10 41l5 7M49 8c0 15-1 25-10 41l-5 7M14 8h35',\n 'M47 12C14 4 4 32 27 45M27 45l5 11M23 40c19-19 25 5 34 2',\n 'M50 9H30v24c0 8-17 5-17 14v10M24 9v22M43 13v13M24 5h31',\n 'M12 50l21-24M30 19l14 14 12-12-14-14-12 12M11 40l-5 11 11 5M17 37l10 9',\n 'M12 53l12-12M19 32l13 13 19-19-13-13-19 19M34 10l20 20M46 5l13 13M25 28l5 5M31 22l5 5',\n 'M20 14h24l-4 35-8 9-8-9-4-35M19 9h26M27 31h10M26 39h12',\n 'M31 12a19 19 0 1 0 1 0M32 18v16l11 6M49 48l10 10M28 8h8',\n];\nexport function toolIcon(i:number):string{return \"'`<svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"${paths[i]??paths[0]}\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>`;}\nexport const lighthouse='\"'<svg viewBox=\\\"0 0 64 64\\\" aria-hidden=\\\"true\\\"><path d=\\\"M22 52h20L38 24H26l-4 28ZM25 18h14v7H25zM21 18l11-9 11 9M29 10V5M14 55h36M5 19l13-3M46 16l13 3M29 35h6M28 44h8\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\" stroke-linejoin=\\\"round\\\"/></svg>';\nexport const esc=(s:unknown):string=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]\"'!));\nexport function button(id:string,label:string,extra='\"''):string{return \"'`<button data-focus data-action=\"${id}\" ${extra}><span>${label}</span><span class=\"arrow\">↗</span></button>`;}\nEOF\ncat > labs/game/ui/context.ts <<'\"'EOF'\n/** @file Presentation dependencies passed explicitly, keeping screens independent of boot and networking. */\nimport type {Engine} from '../../../engine';\nimport type {Director} from '../app/director';\nimport type {Preferences} from '../app/settings';\nimport type {Hands} from '../input/hands';\nimport type {Soundtrack} from '../audio/mix';\nimport type {Operation} from '../data/types';\nexport interface UIContext {d:Director;prefs:Preferences;hands:Hands;sound:Soundtrack;engine:()=>Engine|null;save:()=>void;state:()=>Operation|undefined;act:(name:string,args:Record<string,unknown>)=>void;set:(key:string,value:unknown)=>void;get:(key:string)=>unknown;startSession:()=>void;}\nEOF\ncat > labs/game/ui/styles.css <<'EOF'\n/* @file Harbor Light's couch-readable clinical theatre, responsive from handheld previews to ultrawide TVs. */\n:root{color-scheme:dark;--ink:#e2e7dc;--soft:#9eb4b2;--mint:#a2efcf;--gold:#d0b581;--night:#071b22;--line:#85b2aa42;--u:min(1vw,1.77778vh);font-family:'Arial','DejaVu Sans',sans-serif;font-size:calc(var(--u)*1.7);font-synthesis:none}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07171e;color:var(--ink)}button,input{font:inherit}button{color:inherit;background:transparent;border:0;cursor:pointer;text-align:left}button:disabled{opacity:.35;cursor:default}button:focus-visible,input:focus-visible{outline:3px solid var(--mint);outline-offset:5px}button:hover{color:#f4fff4}button[data-focus]:focus{color:var(--mint)}button svg{display:block}#view{display:block;width:100%;height:100%;position:absolute;inset:0}#app{position:absolute;inset:0;pointer-events:none;z-index:10}#panels{position:absolute;inset:0}#panels>*{pointer-events:auto}#panels:empty{display:none}.eyebrow{text-transform:uppercase;font-size:calc(var(--u)*1.05);letter-spacing:.21em;color:var(--mint);font-weight:600}.small{font-size:calc(var(--u)*1.12);color:var(--soft);line-height:1.55}.muted{color:var(--soft)}.gold{color:var(--gold)}.tag{border:1px solid var(--line);padding:.4em .7em;text-transform:uppercase;font-size:.63em;letter-spacing:.14em}.rule{height:1px;background:var(--line);margin:calc(var(--u)*1.7) 0}.brandmark{display:flex;align-items:center;gap:calc(var(--u)*.7);font-size:calc(var(--u)*1.05);letter-spacing:.16em;line-height:1.5}.brandmark svg{width:calc(var(--u)*3.1);height:calc(var(--u)*3.1);color:var(--mint)}h1,h2,h3,p{margin:0}h1,h2{font-weight:500;letter-spacing:-.055em}h2{font-size:calc(var(--u)*4.4);line-height:1.06}h3{font-size:calc(var(--u)*2.4);font-weight:500;letter-spacing:-.03em}p{line-height:1.5}kbd,.glyph{border:1px solid #91b9ad77;display:inline-flex;align-items:center;justify-content:center;min-width:1.65em;height:1.6em;font-size:.78em;border-radius:.25em;padding:.1em .4em;margin-right:.4em;color:#dcece2;font-family:inherit;background:#0b242a88}\n.title-screen{position:absolute;inset:0;background:linear-gradient(90deg,#06191ff5 0%,#06191fea 31%,#06191f72 56%,#06191f00 80%),linear-gradient(0deg,#04141cde,transparent 25%,transparent 85%,#06191faa)}.title-content{position:absolute;top:7%;left:6.3%;width:33%;height:86%;display:flex;flex-direction:column}.title-logo{font-family:'Arial Narrow','DejaVu Sans',sans-serif;font-stretch:condensed;font-size:calc(var(--u)*7.2);font-weight:600;line-height:.86;letter-spacing:-.075em;margin-top:calc(var(--u)*3.1);text-transform:uppercase}.title-logo span{color:var(--mint)}.subtitle{font-family:Georgia,serif;font-style:italic;font-size:calc(var(--u)*2.03);margin-top:calc(var(--u)*1.15);letter-spacing:-.025em;color:var(--gold)}.title-menu{margin-top:calc(var(--u)*2);display:grid;gap:calc(var(--u)*.18)}.title-menu button{display:flex;align-items:center;justify-content:space-between;min-height:calc(var(--u)*3.6);width:88%;border-bottom:1px solid var(--line);padding:.35em .15em;transition:padding .15s,color .15s}.title-menu button:focus,.title-menu button:hover{padding-left:.6em;color:var(--mint)}.title-menu button:first-child{color:var(--mint);font-weight:600}.arrow{font-size:.9em;color:var(--gold)}.title-foot{position:absolute;bottom:3.5%;left:6.3%;right:5%;display:flex;justify-content:space-between;align-items:center}.title-copy{position:absolute;right:6.5%;bottom:18%;max-width:27%;border-left:2px solid var(--gold);padding-left:calc(var(--u)*1.4)}.title-copy p{font-size:calc(var(--u)*1.7);line-height:1.4}.title-copy .eyebrow{margin-bottom:1em}.storm-lines{position:absolute;right:8%;top:8%;color:#a9c4c7;display:flex;gap:2em;font-size:calc(var(--u)*.94);letter-spacing:.15em}.live-dot{display:inline-block;width:.45em;height:.45em;background:var(--mint);border-radius:50%;margin-right:.5em;box-shadow:0 0 .6em #9aecc7}\n.page{position:absolute;inset:0;background:linear-gradient(110deg,#081d24f5,#071e27d9);padding:5.5% 7% 4%;display:flex;flex-direction:column;gap:calc(var(--u)*1.6)}.page-head{display:flex;align-items:center;justify-content:space-between}.page-head .eyebrow{margin-bottom:1em}.page-body{flex:1;min-height:0;display:flex;align-items:center;gap:6%;max-width:100%}.page-footer{display:flex;align-items:center;justify-content:space-between;gap:1em;margin-top:auto}.page-footer button{min-height:calc(var(--u)*3.5);padding:.3em 1em;border:1px solid var(--line);font-size:.85em}.primary{background:var(--mint)\"'!important;color:#0d3035!important;border-color:var(--mint)!important;font-weight:600}.wide{width:100%}.menu-list{display:grid;gap:.22em;width:min(90%,650px)}.menu-list button{display:flex;justify-content:space-between;align-items:center;min-height:calc(var(--u)*3.6);border-bottom:1px solid var(--line);padding:.4em}.menu-list button:focus,.menu-list button:hover{background:#a2efcf11}.case-number{font-family:Georgia,serif;font-style:italic;font-size:calc(var(--u)*12);line-height:.9;color:#8ca9a54d}.case-card{flex:1;border-top:1px solid var(--mint);border-bottom:1px solid var(--line);padding:calc(var(--u)*2.3) 0;max-width:75%}.case-card h2{margin:.3em 0}.case-card p{color:var(--soft);max-width:36em;margin-top:1em}.case-meta{display:flex;gap:2em;align-items:center;margin:1.5em 0}.tools-small{display:flex;gap:.4em}.tools-small svg{width:calc(var(--u)*2.4);height:calc(var(--u)*2.4);color:var(--mint)}.case-nav{display:flex;gap:1em;align-items:center}.case-nav button{border:1px solid var(--line);height:calc(var(--u)*4.5);width:calc(var(--u)*4.5);text-align:center}.case-nav button:focus{background:#9bf1ca22}.briefing-content{max-width:64%}.briefing-content h2{margin:.35em 0}.briefing-content p{color:var(--soft);margin:.7em 0}.difficulty{display:flex;gap:.7em;margin-top:1.5em}.difficulty button{border:1px solid var(--line);padding:.5em .8em;font-size:.8em}.difficulty button.selected{border-color:var(--mint);background:#b4efd313}.side-note{border-left:1px solid var(--line);padding-left:2em;width:28%;display:flex;flex-direction:column;gap:1em}.side-note .big{font:italic calc(var(--u)*5) Georgia,serif;color:var(--gold)}\n.story-screen{position:absolute;inset:0;background:linear-gradient(0deg,#04151dee 0%,#04151d70 25%,transparent 60%);pointer-events:none!important}.scene-top{position:absolute;top:6%;left:6.5%}.story-dialog{position:absolute;left:6.5%;right:6.5%;bottom:6%;background:#071e24ed;border-top:2px solid var(--mint);padding:1.6em 2em;min-height:24%;pointer-events:auto}.speaker{color:var(--mint);letter-spacing:.15em;font-size:.72em;font-weight:600}.story-text{font-family:Georgia,serif;font-size:calc(var(--u)*2.35);line-height:1.45;margin-top:.5em;max-width:90%}.dialog-footer{display:flex;justify-content:space-between;align-items:center;margin-top:1em}.dialog-footer button{font-size:.7em;min-height:2em;color:var(--soft)}.dialog-next{font-size:.85em!important;color:var(--mint)!important}.drama{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;z-index:60;background:repeating-conic-gradient(from 2deg at 50% 50%,transparent 0deg 6deg,#afeddc17 6.1deg 7deg);opacity:0;transition:opacity .1s}.drama.show{opacity:1}.drama b{display:block;transform:rotate(-4deg);font-size:calc(var(--u)*6);font-style:italic;text-shadow:4px 4px #061c23,-2px -2px #061c23;max-width:90%;text-align:center}\n#hud{position:absolute;inset:0;pointer-events:none;display:none}body.operating #hud{display:block}body.operating #view{cursor:none}.hud-top{position:absolute;top:4.5%;left:4%;right:4%;display:flex;justify-content:space-between;gap:2em}.vitals-block{width:26%;max-width:500px}.hud-label{font-size:.62em;text-transform:uppercase;letter-spacing:.15em;color:#d6e6dd}.vitals-number{font-size:calc(var(--u)*4.2);font-weight:400;letter-spacing:-.08em;line-height:1.05}.vitals-number small{font-size:.3em;letter-spacing:.02em;color:var(--soft);margin-left:.5em}.ecg{width:100%;height:calc(var(--u)*2.25);margin-top:.45em;background:#061b22bd;border-top:1px solid #adc9b33b;border-bottom:1px solid #adc9b33b}.ecg path{stroke:var(--mint);fill:none;stroke-width:2;filter:drop-shadow(0 0 3px #7de8bd)}.ecg.dim{opacity:.35}.clock-block{text-align:center;max-width:45%}.clock-value{font-size:calc(var(--u)*3);letter-spacing:.04em;font-variant-numeric:tabular-nums}.phase-name{color:var(--mint);font-size:.8em;margin:.4em 0}.score-block{text-align:right}.score-value{font-size:calc(var(--u)*2.5);font-variant-numeric:tabular-nums}.chain{color:var(--gold);font-size:.85em;margin-top:.4em}.vitals-bar{height:5px;background:#53706e88;margin-top:.6em}.vitals-bar i{display:block;height:100%;background:var(--mint);transition:width .1s}.hud-low{position:absolute;inset:0;box-shadow:inset 0 0 calc(var(--u)*14) #9e283855;display:none}.low #hud-low{display:block}.tool-bar{position:absolute;bottom:5.3%;left:50%;transform:translateX(-50%);display:flex;gap:calc(var(--u)*.55);align-items:end;pointer-events:auto;background:#071f26dd;padding:.6em .9em;border-top:1px solid var(--line);border-radius:.35em}.tool-button{position:relative;width:calc(var(--u)*4.4);height:calc(var(--u)*4.6);min-width:0;padding:.25em;border:1px solid transparent;display:flex;align-items:center;justify-content:center;transition:transform .1s}.tool-button svg{width:80%;height:80%;color:#b0c4bd}.tool-button .tool-key{position:absolute;top:1px;left:4px;font-size:.48em;color:var(--soft)}.tool-button.active{transform:translateY(-.45em);border:1px solid var(--mint);background:#8ddcc91b}.tool-button.active svg{color:var(--mint)}.tool-name{position:absolute;bottom:-1.35em;left:50%;transform:translateX(-50%);font-size:.55em;white-space:nowrap;letter-spacing:.06em}.op-footer{position:absolute;left:4%;right:4%;bottom:1.6%;display:flex;align-items:center;justify-content:space-between;font-size:.58em;color:#c2d3ca}.op-footer button{pointer-events:auto;color:var(--ink)}.odie-box{position:absolute;left:4%;bottom:21%;max-width:35%;display:flex;gap:.7em;align-items:start;padding:.8em 1em;background:linear-gradient(90deg,#071d26ee,#071d26c0);border-left:2px solid var(--gold)}.odie-avatar{width:2.4em;flex-shrink:0}.odie-box p{font-size:.87em;line-height:1.4}.odie-box .speaker{color:var(--gold);font-size:.51em;margin-bottom:.5em}.rating-pop{position:absolute;top:31%;left:50%;transform:translateX(-50%);font-size:calc(var(--u)*2.5);letter-spacing:.15em;font-weight:700;color:var(--mint);text-shadow:2px 2px #10313b;opacity:0;transition:opacity .2s}.rating-pop.show{opacity:1}.site-tabs{position:absolute;right:3.8%;top:34%;display:grid;gap:.5em;pointer-events:auto;max-width:20%}.site-tabs button{font-size:.65em;background:#07222ae8;border:1px solid var(--line);padding:.8em 1.2em;text-transform:uppercase;letter-spacing:.08em}.site-tabs button.active{border-color:var(--mint);color:var(--mint)}.site-tabs button.danger{border-color:#eb9164}.site-tabs small{display:block;margin-top:.4em;font-size:.9em;color:var(--gold)}.selected-tool{position:absolute;right:4%;bottom:14.5%;text-align:right;max-width:25%}.selected-tool strong{font-weight:400;font-size:1.4em;color:var(--mint)}.selected-tool p{font-size:.63em;color:var(--soft);margin-top:.5em;max-width:20em}.charge-panel{position:absolute;bottom:24%;left:50%;transform:translateX(-50%);width:22%;text-align:center}.charge-bar{height:.55em;background:#203c43;position:relative;margin-top:.5em;border:1px solid var(--line)}.charge-bar .green{position:absolute;left:75%;width:20%;top:0;bottom:0;background:#90d4aa88}.charge-bar i{display:block;height:100%;background:var(--gold);position:relative}.code-panel{position:absolute;left:25%;right:25%;top:25%;background:#07212af2;padding:1.8em;border:1px solid var(--gold);text-align:center}.code-panel h2{color:var(--gold)}.code-panel .charge-bar{height:1.1em;margin:1em 0}.code-panel .green{left:65%;width:21%}.code-panel p{font-size:.8em}.pulse-panel{position:absolute;left:25%;right:25%;top:26%;background:#07212af2;border:1px solid var(--mint);padding:1.4em;text-align:center}.pulse-beats{font-size:2.5em;letter-spacing:.25em;color:var(--mint);margin-top:.4em}.gift-overlay{position:absolute;inset:0;pointer-events:none}.gift-overlay.still{box-shadow:inset 0 0 150px #5de2da66;background:#79dcdb10}.gift-overlay.pulse{box-shadow:inset 0 0 140px #ffc66555}.gift-banner{position:absolute;top:19%;left:50%;transform:translateX(-50%);color:var(--mint);font-size:.85em;letter-spacing:.2em;white-space:nowrap}.radial{position:absolute;width:calc(var(--u)*23);height:calc(var(--u)*23);border-radius:50%;background:#071e26ef;transform:translate(-50%,-50%);border:1px solid var(--mint);display:none;z-index:80}.radial.open{display:block}.radial button{position:absolute;left:50%;top:50%;width:22%;height:22%;display:flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:50%;padding:.7em;pointer-events:auto}.radial button.active{border-color:var(--mint);background:#80e5c522;color:var(--mint)}.radial svg{width:100%;height:100%}.radial .center{position:absolute;left:25%;right:25%;top:44%;text-align:center;font-size:.85em;color:var(--mint)}\n.rank{font:italic calc(var(--u)*19)/.9 Georgia,serif;color:var(--gold);min-width:30%;text-align:center}.stat-lines{display:grid;gap:.45em;width:40%;margin-left:5%}.stat-lines div{display:flex;justify-content:space-between;padding:.4em 0;border-bottom:1px solid var(--line);font-size:.9em}.stat-lines b{font-weight:400;color:var(--mint)}.postcard{background:#e1d6b8;color:#253a3d;max-width:82%;padding:calc(var(--u)*4);transform:rotate(-2deg);box-shadow:0 15px 60px #0005;position:relative}.postcard:after{content:'\"'PORT VERITY';position:absolute;right:8%;top:8%;border:3px double #53776f;padding:1em;font-size:.55em;border-radius:50%;transform:rotate(13deg)}.postcard h3{margin:1.5em 0 .9em}.postcard p{font:italic calc(var(--u)*2.4)/1.5 Georgia,serif;max-width:85%}.postcard .signature{margin-top:1.8em;font-family:Georgia,serif;font-size:.8em}.tabs{display:flex;gap:.5em;flex-wrap:wrap}.tabs button{font-size:.72em;padding:.6em 1em;border:1px solid var(--line);min-height:calc(var(--u)*3)}.tabs button.selected{color:var(--mint);border-color:var(--mint);background:#8be2bc0d}.settings-rows{width:100%;display:grid;gap:.4em;max-width:calc(var(--u)*68)}.setting-row{display:flex;align-items:center;justify-content:space-between;min-height:calc(var(--u)*4.1);gap:1em;border-bottom:1px solid var(--line);padding:.5em .3em}.setting-row label{flex:1}.setting-row output{color:var(--mint);min-width:3em;text-align:right}.setting-row input{width:35%;accent-color:var(--mint);height:1em}.setting-row button{font-size:.8em;border:1px solid var(--line);padding:.4em .8em;min-width:4em;text-align:center}.feedback-card{max-width:85%;border-left:2px solid var(--gold);padding:1.5em 2em}.feedback-card h3{color:var(--gold);margin:.5em 0 1em}.feedback-card p{color:#d5e2d7;font-size:1.12em;line-height:1.55}.handbook-icon{width:20%;color:var(--mint)}.handbook-text{max-width:66%}.handbook-text h2{margin-bottom:.5em}.handbook-text p{font-size:1.1em;margin:.7em 0;color:#bdd0c7}.seat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1em;width:100%}.seat-slot{border:1px solid var(--line);min-height:calc(var(--u)*16);padding:1.2em;display:flex;flex-direction:column;justify-content:space-between}.seat-slot .number{font-size:3em;font-family:Georgia,serif}.seat-slot .small{font-size:.7em}.dev-output{font: .7em/1.7 monospace;background:#06171d;padding:1em;border:1px solid var(--line);white-space:pre-wrap;word-break:break-word;max-height:40vh;overflow:auto;width:100%}.demo-banner{position:absolute;top:17%;left:4%;background:#08242aeb;border:1px solid var(--gold);color:var(--gold);padding:.5em 1em;font-size:.75em;letter-spacing:.15em;pointer-events:none;z-index:30}.demo-prompt{position:absolute;bottom:2%;left:50%;transform:translateX(-50%);padding:.5em 1em;background:#071e26e8;color:var(--mint);white-space:nowrap;font-size:.7em;z-index:35}.touch-cover{position:absolute;z-index:95;left:8%;right:8%;top:30%;padding:2em;background:#071c25f5;border:1px solid var(--mint);text-align:center;pointer-events:auto}.touch-cover h2{font-size:clamp(24px,5vw,52px);line-height:1.25;letter-spacing:-.03em}.touch-cover p{font-size:clamp(15px,2.5vw,28px);color:var(--soft);margin:1em 0}.touch-cover button{font-size:clamp(18px,3vw,28px);border:1px solid var(--mint);min-height:52px;padding:.5em 1.5em}.boot{position:absolute;inset:0;background:#071b22;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1em;z-index:100}.boot svg{width:90px;height:90px;color:var(--mint)}.boot p{font-size:20px;letter-spacing:.18em}.boot:after{content:'';width:180px;height:1px;background:var(--mint);animation:beam 2s ease-in-out infinite}.boot.hidden{display:none}@keyframes beam{0%,100%{transform:scaleX(.2);opacity:.3}50%{transform:scaleX(1);opacity:1}}.credits-body{max-width:65%;font:italic calc(var(--u)*2.7)/1.4 Georgia,serif}.about-index{color:var(--soft);font-size:.65em}.tv-caption{position:absolute;right:4%;top:24%;max-width:23%;font-size:.65em;color:var(--gold);background:#09222bcb;padding:.7em 1em;border-left:2px solid var(--gold)}.view-debug{position:absolute;top:25%;left:4%;font:.65em monospace;color:#cef7cb;background:#06191dce;padding:1em;max-width:30%;white-space:pre-wrap;pointer-events:none}\n@media(max-width:700px) and (orientation:portrait){.title-content{width:65%;top:8%}.title-logo{font-size:14vw}.title-copy{display:none}.brandmark{font-size:2.2vw}.brandmark svg{width:7vw;height:7vw}.title-menu{margin-top:4vw}.title-menu button{font-size:3.8vw;min-height:9vw}.subtitle{font-size:4vw}.title-foot{font-size:2.5vw}.storm-lines{font-size:2vw}.page{padding:6%;gap:4vw}.page h2{font-size:8vw}.page .eyebrow{font-size:2.7vw}.page-body{gap:4vw;flex-wrap:wrap}.page-footer{font-size:4vw}.page-footer button{min-height:11vw}.settings-rows{max-width:100%;font-size:4vw}.setting-row{min-height:13vw}.tabs button{font-size:3.5vw;min-height:10vw}.feedback-card{max-width:100%;padding:1em;font-size:4.2vw}.feedback-card h3{font-size:6vw}.case-card{max-width:100%}.case-number{font-size:16vw}.case-card p,.briefing-content p{font-size:4vw}.briefing-content{max-width:100%}.side-note{display:none}.difficulty{font-size:4vw}.case-nav button{width:12vw;height:12vw}.tools-small svg{width:6vw;height:6vw}.small{font-size:3.5vw}.handbook-text{max-width:100%;font-size:4vw}.handbook-icon{width:15vw}.seat-grid{grid-template-columns:repeat(2,1fr);font-size:4vw}.seat-slot{min-height:30vw}}\n@media(prefers-reduced-motion:reduce){*{animation:none\"'!important;transition:none!important}}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/pages.ts <<'EOF'\n/** @file Large, single-purpose front-end screens for story, case selection, briefings and results. */\nimport {CASES,SESSION} from '../data/cases';\nimport {CAST,storyFor} from '../data/story';\nimport {TOOLS} from '../data/tools';\nimport {rank} from '../scenes/op/state';\nimport type {UIContext} from './context';\nimport {button,esc,lighthouse,toolIcon} from './icons';\nexport const page=(title:string,kicker:string,body:string,footer:string,extra=''):string=>\"'`<section class=\"page ${extra}\"><header class=\"page-head\"><div><div class=\"eyebrow\">${kicker}</div><h2>${title}</h2></div><div class=\"brandmark\">${lighthouse}<span>HARBOR LIGHT<br>GENERAL</span></div></header><div class=\"page-body\">${body}</div><footer class=\"page-footer\">${footer}</footer></section>`;\nexport function title(c:UIContext):string{\n const continueButton=c.d.progress.checkpoint||c.d.progress.unlocked>1?button('\"'continue','Continue shift'):'';\n return \"'`<section class=\"title-screen\"><div class=\"title-content\"><div class=\"brandmark\">${lighthouse}<span>HARBOR LIGHT GENERAL<br>PORT VERITY · NIGHT DIVISION</span></div><h1 class=\"title-logo\">TRAUMA<br><span>COAST</span></h1><div class=\"subtitle\">Second Sight</div><nav class=\"title-menu\" aria-label=\"Main menu\">${continueButton}${button('\"'new','New shift')}\"'${button('\"'board','The Board')}\"'${button('\"'scrub','Scrub in <span class=\\\"tag\\\">1–4 surgeons</span>')}\"'${button('\"'settings','Settings')}\"'${button('\"'about','About & credits')}</nav></div><div class=\\\"storm-lines\\\"><span>PV / 03:17</span><span>STORM WARNING 04</span></div><div class=\\\"title-copy\\\"><div class=\\\"eyebrow\\\"><span class=\\\"live-dot\\\"></span>THE NIGHT SHIFT HAS A PULSE</div><p>A miracle graft.<br>A city that trusted it.<br>Your hands on the evidence.</p></div><footer class=\\\"title-foot\\\"><span class=\\\"small\\\">\"'${c.hands.lastDevice==='\"'gamepad'?'<span class=\\\"glyph\\\">✕</span> Select · <span class=\\\"glyph\\\">○</span> Back':'<kbd>↑ ↓</kbd> Navigate <kbd>Enter</kbd> Select · or click'}</span><span class=\\\"eyebrow\\\">AN ORIGINAL SURGICAL THRILLER</span></footer></section>\"'`;\n}\nexport function board(c:UIContext):string{\n const index=c.d.caseIndex,cs=index===8?SESSION:CASES[index],unlocked=index<c.d.progress.unlocked||index===8&&c.d.progress.ended;\n return page('\"'The Board','CASE FILES / FREE SURGERY',\"'`<div class=\"case-number\">${String(index+1).padStart(2,'\"'0')}</div><article class=\\\"case-card\\\"><div class=\\\"eyebrow\\\">\"'${index===8?'\"'TEAM PROCEDURE':unlocked?'AVAILABLE FOR SURGERY':'SEALED CASE FILE'}</div><h2>\"'${esc(cs.title)}</h2><h3>${esc(cs.patient)}${cs.age?`, ${cs.age}`:'\"''}</h3><p>\"'${esc(cs.detail)}</p><div class=\"case-meta\"><span class=\"tag\">${cs.sites.join('\"' / ')}</span><span class=\\\"gold\\\">\"'${Math.floor(cs.seconds/60)}:${String(cs.seconds%60).padStart(2,'\"'0')}</span><span class=\\\"muted\\\">Best <b class=\\\"gold\\\">\"'${c.d.progress.ranks[cs.id]??'\"'—'}</b></span></div><div class=\\\"tools-small\\\">\"'${TOOLS.map((_,i)=>toolIcon(i)).join('\"'')}</div></article><div class=\\\"case-nav\\\">\"'${button('\"'case-prev','←','aria-label=\\\"Previous case\\\"')}\"'${button('\"'case-next','→','aria-label=\\\"Next case\\\"')}</div>\"'`,`${button('\"'back','Back')}\"'${button('\"'postcards','Postcards')}\"'${button('\"'handbook','Handbook')}\"'${button('\"'case-play',unlocked?'Scrub in →':'Complete the previous case',\"'`${unlocked?'\"'class=\\\"primary\\\"':'disabled'}\"'`)}`);\n}\nexport function story(c:UIContext):string{\n const s=storyFor(c.d.caseIndex,c.d.part),b=s.beats[c.d.beat]??s.beats[0],who=CAST[b.who];\n return `<section class=\"story-screen\"><div class=\"scene-top\"><div class=\"eyebrow\">PORT VERITY / ${s.set.toUpperCase()}</div><div class=\"small\">${esc(CASES[c.d.caseIndex].title)} · ${c.d.part==='\"'before'?'Before the operation':'After the operation'}</div></div><article class=\\\"story-dialog\\\"><div class=\\\"speaker\\\" style=\\\"color:\"'${who.color}\" data-game=\"speaker\">${who.name}</div><p class=\"story-text\" data-game=\"dialogue\">${esc(b.text)}</p><div class=\"dialog-footer\"><button data-focus data-action=\"skip\" title=\"Hold Circle or Escape to skip the scene\">Hold ${c.hands.lastDevice==='\"'gamepad'?'○':'Esc'} to skip scene</button><span class=\\\"small\\\">\"'${String(c.d.beat+1).padStart(2,'\"'0')} / \"'${s.beats.length}</span><button class=\"dialog-next\" data-focus data-action=\"advance\">${c.hands.lastDevice==='\"'gamepad'?'<span class=\\\"glyph\\\">✕</span>':'<kbd>Enter</kbd>'} Continue →</button></div></article></section>\"'`;\n}\nexport function briefing(c:UIContext):string{\n const cs=c.d.caseIndex===8?SESSION:CASES[c.d.caseIndex];\n return page('\"'Pre-op briefing',\"'`CASE ${String(c.d.caseIndex+1).padStart(2,'\"'0')} / \"'${esc(cs.title).toUpperCase()}`,`<div class=\"briefing-content\"><div class=\"eyebrow\">YOUR PATIENT</div><h2>${esc(cs.patient)}</h2><p>${esc(cs.detail)}</p><div class=\"rule\"></div><p>${esc(cs.phases[0].hint)}</p><div class=\"difficulty\">${(['\"'Intern','Resident','Attending'] as const).map(d=>button(\"'`difficulty:${d}`,d,`class=\"${c.prefs.difficulty===d?'\"'selected':''}\\\" \"'${d==='\"'Attending'&&\"'!c.d.progress.ended?'\"'disabled':''}\"'`)).join('\"'')}</div></div><aside class=\\\"side-note\\\"><span class=\\\"eyebrow\\\">FIELD TIME</span><span class=\\\"big\\\">\"'${Math.floor(cs.seconds/60)}:${String(cs.seconds%60).padStart(2,'\"'0')}</span><span class=\\\"small\\\">\"'${cs.sites.join('\"' · ')}<br>\"'${cs.lead==='\"'wren'?'Dr. Wren Tolliver':'Dr. Sabine Oyelaran'}\"'${cs.ai?'\"' + colleague':''}</span><div class=\\\"tools-small\\\">\"'${toolIcon(3)}${toolIcon(1)}${toolIcon(2)}${toolIcon(5)}</div></aside>`,`${button('\"'back','Back to Board')}<span class=\\\"small\\\">\"'${c.hands.lastDevice==='\"'gamepad'?'Stick aims · R2 operates · Right stick selects tools':'Mouse aims · Hold click to operate · 1–8 select tools'}</span>\"'${button('\"'operate','Begin operation →','class=\\\"primary\\\"')}\"'`);\n}\nexport function result(c:UIContext):string{\n const s=c.d.last!;\n if(c.d.screen==='\"'failed')return page('Operation failed','THE ROOM GOES QUIET',\"'`<div class=\"briefing-content\"><h3>${esc(s.reason)}</h3><p class=\"muted\">Odie switches off the monitor.</p><div class=\"rule\"></div><p>We can begin again, Doctor. This time, ask sooner.</p></div>`,`${button('\"'board','The Board')}\"'${button('\"'retry-phase','Retry this phase',c.prefs.difficulty==='Attending'?'disabled':'')}\"'${button('\"'retry','Retry case','class=\\\"primary\\\"')}\"'`);\n const r=rank(s);return page('\"'Operation complete','THE TEAM EXHALES',\"'`<div class=\"rank\" data-game=\"rank\">${r}</div><div class=\"stat-lines\"><div><span>Time remaining</span><b>${Math.floor(s.left/360000)}:${String(Math.ceil(s.left/6000)%60).padStart(2,'\"'0')}</b></div><div><span>Final vitals</span><b>\"'${Math.round(Math.min(...s.patients))}</b></div><div><span>Slips</span><b>${s.slips}</b></div><div><span>Best chain</span><b>×${s.best.toFixed(1)}</b></div><div><span>Score</span><b>${s.score.toLocaleString('\"'en')}</b></div>\"'${s.seats.length>1?`<p class=\"small\">${s.seats.map(p=>`Seat ${p.id+1}: ${p.score}`).join('\"' · ')}</p>\"'`:'\"''}</div>\"'`,`${button('\"'board','The Board')}<span class=\\\"small\\\">\"'${s.retry?'\"'Checkpoint retry · rank capped at B':s.dev?'Developer run · no record saved':'A person gets another morning.'}</span>\"'${button('\"'next-result','Patient postcard →','class=\\\"primary\\\"')}\"'`);\n}\nexport function postcard(c:UIContext):string{\n const id=c.d.last?.caseId??CASES[c.d.caseIndex].id,cs=id==='\"'gala-shift'?SESSION:CASES.find(c=>c.id===id)??CASES[0],text=c.d.progress.postcards[id]??cs.postcard[2];\n return page('From Port Verity','A LIFE AFTER THE CASE',\"'`<article class=\"postcard\"><div class=\"eyebrow\" style=\"color:#54776a\">HARBOR LIGHT / POST RECEIVED</div><h3>Dear Doctor,</h3><p>${esc(text)}</p><div class=\"signature\">With gratitude,<br>${esc(cs.patient)}</div></article>`,`${button('\"'board','The Board')}\"'${button('\"'next-result','Continue the shift →','class=\\\"primary\\\"')}\"'`);\n}\nexport function pause(c:UIContext):string{\n return page('\"'A moment, Doctor.','PAUSED',\"'`<nav class=\"menu-list\">${button('\"'resume','Resume operation')}\"'${button('\"'retry-phase','Retry this phase',c.prefs.difficulty==='Attending'?'disabled':'')}\"'${button('\"'retry','Retry case')}\"'${button('\"'handbook','Handbook')}\"'${button('\"'settings','Settings & controls')}\"'${button('\"'dev','Dev Mode')}\"'${button('\"'board','Quit to Board')}</nav><aside class=\\\"side-note\\\"><span class=\\\"eyebrow\\\">CHARGE NURSE’S ORDERS</span><p>“The patient can wait one minute.<br>You cannot wait forever.”</p></aside>\"'`,`${button('\"'resume','← Resume')}<span class=\\\"small\\\">Your instruments will be exactly where you left them.</span>\"'`);\n}\nexport function scrub(c:UIContext):string{\n const colors=['\"'#e8443a','#3b82f6','#22c55e','#f5b700'];\n return page('Scrub in','ONE PATIENT / UP TO FOUR SURGEONS',\"'`<div class=\"seat-grid\">${colors.map((color,i)=>`<article class=\"seat-slot\" style=\"border-top:3px solid ${color}\"><span class=\"number\" style=\"color:${color}\">${i+1}</span><h3>${i<c.hands.devices.length?'\"'Scrubbed in':'Open seat'}</h3><span class=\\\"small\\\">\"'${i<c.hands.devices.length?c.hands.devices[i]==='\"'keyboard'?'Keyboard + mouse':\"'`Controller ${Number(c.hands.devices[i])+1}`:'\"'Press ✕ on a controller'}</span></article>\"'`).join('\"'')}</div>\"'`,`${button('\"'back','Back')}<span class=\\\"small\\\">One keyboard + mouse, or a controller in each seat.<br>Online procedures run through AI Hub.</span>\"'${button('\"'scrub-start','To the Board →','class=\\\"primary\\\"')}\"'`);\n}\nexport function credits():string{return page('\"'Case file remains open.','THE MORNING AFTER',\"'`<div class=\"credits-body\">Tomás walks the seawall.<br>Gwen plays the loud notes.<br>Route 9 is running again.<br><br>Out beyond the lighthouse,<br>a crate is already at sea.</div><aside class=\"side-note\"><span class=\"eyebrow\">FREE SURGERY UNLOCKED</span><p>All eight cases.<br>Attending difficulty.<br>One more shift.</p></aside>`,`${button('\"'about','Credits')}\"'${button('\"'board','Free Surgery →','class=\\\"primary\\\"')}\"'`);}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/pages.ts <<'EOF'\n/** @file Large, single-purpose front-end screens for story, case selection, briefings and results. */\nimport {CASES,SESSION} from '../data/cases';\nimport {CAST,storyFor} from '../data/story';\nimport {TOOLS} from '../data/tools';\nimport {rank} from '../scenes/op/state';\nimport type {UIContext} from './context';\nimport {button,esc,lighthouse,toolIcon} from './icons';\nexport const page=(title:string,kicker:string,body:string,footer:string,extra=''):string=>\"'`<section class=\"page ${extra}\"><header class=\"page-head\"><div><div class=\"eyebrow\">${kicker}</div><h2>${title}</h2></div><div class=\"brandmark\">${lighthouse}<span>HARBOR LIGHT<br>GENERAL</span></div></header><div class=\"page-body\">${body}</div><footer class=\"page-footer\">${footer}</footer></section>`;\nexport function title(c:UIContext):string{\n const continueButton=c.d.progress.checkpoint||c.d.progress.unlocked>1?button('\"'continue','Continue shift'):'';\n return \"'`<section class=\"title-screen\"><div class=\"title-content\"><div class=\"brandmark\">${lighthouse}<span>HARBOR LIGHT GENERAL<br>PORT VERITY · NIGHT DIVISION</span></div><h1 class=\"title-logo\">TRAUMA<br><span>COAST</span></h1><div class=\"subtitle\">Second Sight</div><nav class=\"title-menu\" aria-label=\"Main menu\">${continueButton}${button('\"'new','New shift')}\"'${button('\"'board','The Board')}\"'${button('\"'scrub','Scrub in <span class=\\\"tag\\\">1–4 surgeons</span>')}\"'${button('\"'settings','Settings')}\"'${button('\"'about','About & credits')}</nav></div><div class=\\\"storm-lines\\\"><span>PV / 03:17</span><span>STORM WARNING 04</span></div><div class=\\\"title-copy\\\"><div class=\\\"eyebrow\\\"><span class=\\\"live-dot\\\"></span>THE NIGHT SHIFT HAS A PULSE</div><p>A miracle graft.<br>A city that trusted it.<br>Your hands on the evidence.</p></div><footer class=\\\"title-foot\\\"><span class=\\\"small\\\">\"'${c.hands.lastDevice==='\"'gamepad'?'<span class=\\\"glyph\\\">✕</span> Select · <span class=\\\"glyph\\\">○</span> Back':'<kbd>↑ ↓</kbd> Navigate <kbd>Enter</kbd> Select · or click'}</span><span class=\\\"eyebrow\\\">AN ORIGINAL SURGICAL THRILLER</span></footer></section>\"'`;\n}\nexport function board(c:UIContext):string{\n const index=c.d.caseIndex,cs=index===8?SESSION:CASES[index],unlocked=index<c.d.progress.unlocked||index===8&&c.d.progress.ended;\n return page('\"'The Board','CASE FILES / FREE SURGERY',\"'`<div class=\"case-number\">${String(index+1).padStart(2,'\"'0')}</div><article class=\\\"case-card\\\"><div class=\\\"eyebrow\\\">\"'${index===8?'\"'TEAM PROCEDURE':unlocked?'AVAILABLE FOR SURGERY':'SEALED CASE FILE'}</div><h2>\"'${esc(cs.title)}</h2><h3>${esc(cs.patient)}${cs.age?`, ${cs.age}`:'\"''}</h3><p>\"'${esc(cs.detail)}</p><div class=\"case-meta\"><span class=\"tag\">${cs.sites.join('\"' / ')}</span><span class=\\\"gold\\\">\"'${Math.floor(cs.seconds/60)}:${String(cs.seconds%60).padStart(2,'\"'0')}</span><span class=\\\"muted\\\">Best <b class=\\\"gold\\\">\"'${c.d.progress.ranks[cs.id]??'\"'—'}</b></span></div><div class=\\\"tools-small\\\">\"'${TOOLS.map((_,i)=>toolIcon(i)).join('\"'')}</div></article><div class=\\\"case-nav\\\">\"'${button('\"'case-prev','←','aria-label=\\\"Previous case\\\"')}\"'${button('\"'case-next','→','aria-label=\\\"Next case\\\"')}</div>\"'`,`${button('\"'back','Back')}\"'${button('\"'postcards','Postcards')}\"'${button('\"'handbook','Handbook')}\"'${button('\"'case-play',unlocked?'Scrub in →':'Complete the previous case',\"'`${unlocked?'\"'class=\\\"primary\\\"':'disabled'}\"'`)}`);\n}\nexport function story(c:UIContext):string{\n const s=storyFor(c.d.caseIndex,c.d.part),b=s.beats[c.d.beat]??s.beats[0],who=CAST[b.who];\n return `<section class=\"story-screen\"><div class=\"scene-top\"><div class=\"eyebrow\">PORT VERITY / ${s.set.toUpperCase()}</div><div class=\"small\">${esc(CASES[c.d.caseIndex].title)} · ${c.d.part==='\"'before'?'Before the operation':'After the operation'}</div></div><article class=\\\"story-dialog\\\"><div class=\\\"speaker\\\" style=\\\"color:\"'${who.color}\" data-game=\"speaker\">${who.name}</div><p class=\"story-text\" data-game=\"dialogue\">${esc(b.text)}</p><div class=\"dialog-footer\"><button data-focus data-action=\"skip\" title=\"Hold Circle or Escape to skip the scene\">Hold ${c.hands.lastDevice==='\"'gamepad'?'○':'Esc'} to skip scene</button><span class=\\\"small\\\">\"'${String(c.d.beat+1).padStart(2,'\"'0')} / \"'${s.beats.length}</span><button class=\"dialog-next\" data-focus data-action=\"advance\">${c.hands.lastDevice==='\"'gamepad'?'<span class=\\\"glyph\\\">✕</span>':'<kbd>Enter</kbd>'} Continue →</button></div></article></section>\"'`;\n}\nexport function briefing(c:UIContext):string{\n const cs=c.d.caseIndex===8?SESSION:CASES[c.d.caseIndex];\n return page('\"'Pre-op briefing',\"'`CASE ${String(c.d.caseIndex+1).padStart(2,'\"'0')} / \"'${esc(cs.title).toUpperCase()}`,`<div class=\"briefing-content\"><div class=\"eyebrow\">YOUR PATIENT</div><h2>${esc(cs.patient)}</h2><p>${esc(cs.detail)}</p><div class=\"rule\"></div><p>${esc(cs.phases[0].hint)}</p><div class=\"difficulty\">${(['\"'Intern','Resident','Attending'] as const).map(d=>button(\"'`difficulty:${d}`,d,`class=\"${c.prefs.difficulty===d?'\"'selected':''}\\\" \"'${d==='\"'Attending'&&\"'!c.d.progress.ended?'\"'disabled':''}\"'`)).join('\"'')}</div></div><aside class=\\\"side-note\\\"><span class=\\\"eyebrow\\\">FIELD TIME</span><span class=\\\"big\\\">\"'${Math.floor(cs.seconds/60)}:${String(cs.seconds%60).padStart(2,'\"'0')}</span><span class=\\\"small\\\">\"'${cs.sites.join('\"' · ')}<br>\"'${cs.lead==='\"'wren'?'Dr. Wren Tolliver':'Dr. Sabine Oyelaran'}\"'${cs.ai?'\"' + colleague':''}</span><div class=\\\"tools-small\\\">\"'${toolIcon(3)}${toolIcon(1)}${toolIcon(2)}${toolIcon(5)}</div></aside>`,`${button('\"'back','Back to Board')}<span class=\\\"small\\\">\"'${c.hands.lastDevice==='\"'gamepad'?'Stick aims · R2 operates · Right stick selects tools':'Mouse aims · Hold click to operate · 1–8 select tools'}</span>\"'${button('\"'operate','Begin operation →','class=\\\"primary\\\"')}\"'`);\n}\nexport function result(c:UIContext):string{\n const s=c.d.last!;\n if(c.d.screen==='\"'failed')return page('Operation failed','THE ROOM GOES QUIET',\"'`<div class=\"briefing-content\"><h3>${esc(s.reason)}</h3><p class=\"muted\">Odie switches off the monitor.</p><div class=\"rule\"></div><p>We can begin again, Doctor. This time, ask sooner.</p></div>`,`${button('\"'board','The Board')}\"'${button('\"'retry-phase','Retry this phase',c.prefs.difficulty==='Attending'?'disabled':'')}\"'${button('\"'retry','Retry case','class=\\\"primary\\\"')}\"'`);\n const r=rank(s);return page('\"'Operation complete','THE TEAM EXHALES',\"'`<div class=\"rank\" data-game=\"rank\">${r}</div><div class=\"stat-lines\"><div><span>Time remaining</span><b>${Math.floor(s.left/360000)}:${String(Math.ceil(s.left/6000)%60).padStart(2,'\"'0')}</b></div><div><span>Final vitals</span><b>\"'${Math.round(Math.min(...s.patients))}</b></div><div><span>Slips</span><b>${s.slips}</b></div><div><span>Best chain</span><b>×${s.best.toFixed(1)}</b></div><div><span>Score</span><b>${s.score.toLocaleString('\"'en')}</b></div>\"'${s.seats.length>1?`<p class=\"small\">${s.seats.map(p=>`Seat ${p.id+1}: ${p.score}`).join('\"' · ')}</p>\"'`:'\"''}</div>\"'`,`${button('\"'board','The Board')}<span class=\\\"small\\\">\"'${s.retry?'\"'Checkpoint retry · rank capped at B':s.dev?'Developer run · no record saved':'A person gets another morning.'}</span>\"'${button('\"'next-result','Patient postcard →','class=\\\"primary\\\"')}\"'`);\n}\nexport function postcard(c:UIContext):string{\n const id=c.d.last?.caseId??CASES[c.d.caseIndex].id,cs=id==='\"'gala-shift'?SESSION:CASES.find(c=>c.id===id)??CASES[0],text=c.d.progress.postcards[id]??cs.postcard[2];\n return page('From Port Verity','A LIFE AFTER THE CASE',\"'`<article class=\"postcard\"><div class=\"eyebrow\" style=\"color:#54776a\">HARBOR LIGHT / POST RECEIVED</div><h3>Dear Doctor,</h3><p>${esc(text)}</p><div class=\"signature\">With gratitude,<br>${esc(cs.patient)}</div></article>`,`${button('\"'board','The Board')}\"'${button('\"'next-result','Continue the shift →','class=\\\"primary\\\"')}\"'`);\n}\nexport function pause(c:UIContext):string{\n return page('\"'A moment, Doctor.','PAUSED',\"'`<nav class=\"menu-list\">${button('\"'resume','Resume operation')}\"'${button('\"'retry-phase','Retry this phase',c.prefs.difficulty==='Attending'?'disabled':'')}\"'${button('\"'retry','Retry case')}\"'${button('\"'handbook','Handbook')}\"'${button('\"'settings','Settings & controls')}\"'${button('\"'dev','Dev Mode')}\"'${button('\"'board','Quit to Board')}</nav><aside class=\\\"side-note\\\"><span class=\\\"eyebrow\\\">CHARGE NURSE’S ORDERS</span><p>“The patient can wait one minute.<br>You cannot wait forever.”</p></aside>\"'`,`${button('\"'resume','← Resume')}<span class=\\\"small\\\">Your instruments will be exactly where you left them.</span>\"'`);\n}\nexport function scrub(c:UIContext):string{\n const colors=['\"'#e8443a','#3b82f6','#22c55e','#f5b700'];\n return page('Scrub in','ONE PATIENT / UP TO FOUR SURGEONS',\"'`<div class=\"seat-grid\">${colors.map((color,i)=>`<article class=\"seat-slot\" style=\"border-top:3px solid ${color}\"><span class=\"number\" style=\"color:${color}\">${i+1}</span><h3>${i<c.hands.devices.length?'\"'Scrubbed in':'Open seat'}</h3><span class=\\\"small\\\">\"'${i<c.hands.devices.length?c.hands.devices[i]==='\"'keyboard'?'Keyboard + mouse':\"'`Controller ${Number(c.hands.devices[i])+1}`:'\"'Press ✕ on a controller'}</span></article>\"'`).join('\"'')}</div>\"'`,`${button('\"'back','Back')}<span class=\\\"small\\\">One keyboard + mouse, or a controller in each seat.<br>Online procedures run through AI Hub.</span>\"'${button('\"'scrub-start','To the Board →','class=\\\"primary\\\"')}\"'`);\n}\nexport function credits():string{return page('\"'Case file remains open.','THE MORNING AFTER',\"'`<div class=\"credits-body\">Tomás walks the seawall.<br>Gwen plays the loud notes.<br>Route 9 is running again.<br><br>Out beyond the lighthouse,<br>a crate is already at sea.</div><aside class=\"side-note\"><span class=\"eyebrow\">FREE SURGERY UNLOCKED</span><p>All eight cases.<br>Attending difficulty.<br>One more shift.</p></aside>`,`${button('\"'about','Credits')}\"'${button('\"'board','Free Surgery →','class=\\\"primary\\\"')}\"'`);}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/reference.ts <<'EOF'\n/** @file Paged clinical Handbook, source information, interview feedback and patient correspondence. */\nimport {interview} from '../data/about';\nimport {HELP,TOOLS} from '../data/tools';\nimport {CASES} from '../data/cases';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc,toolIcon} from './icons';\nconst questions={testing:['How many issues did testing catch?','How many were critical or game breaking?','What was the most helpful test?','What was the least helpful test?'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','What was most important to build yourself?','What was hardest about using the engine?','What did you change in the engine, and why?','What one engine improvement would you make?'],prompt:['What did you like most about this prompt?','What was confusing?','What was hardest to do?','What would you change?']};\nexport const aboutCards=[...Object.entries(interview.sourceInformation).map(([key,value])=>({section:'Source Information',title:key==='artDirection'?'Art direction':key.charAt(0).toUpperCase()+key.slice(1),body:value,key})),...interview.testingFeedback.map((body,i)=>({section:'Testing Feedback',title:questions.testing[i],body,key:''})),...interview.engineFeedback.map((body,i)=>({section:'Engine Feedback',title:questions.engine[i],body,key:''})),...interview.promptFeedback.map((body,i)=>({section:'Prompt Feedback',title:questions.prompt[i],body,key:''})),{section:'Credits',title:'Harbor Light General',body:'Original game, characters, geometry, animations and synthesized score. Built with my-3dge and three.js (MIT); Rapier and stdlib mathematics (Apache-2.0). Inspired by Trauma Center: Second Opinion. All characters and events in Port Verity are fictional.',key:'credits'}];\nexport function about(index:number):string{\n const card=aboutCards[((index%aboutCards.length)+aboutCards.length)%aboutCards.length];\n return page('About & credits',card.section.toUpperCase(),\"'`<article class=\"feedback-card\"><div class=\"eyebrow\">${esc(card.section)}</div><h3>${esc(card.title)}</h3><p data-about=\"${card.key}\">${esc(card.body)}</p></article>`,`${button('\"'back','Back')}\"'${button('\"'ref-prev','← Previous')}<span class=\\\"about-index\\\">\"'${index+1} / ${aboutCards.length}</span>${button('\"'ref-next','Next →')}\"'`);\n}\nconst extra=[\n ['\"'The Gift','Space / Triangle starts pulse-lock. Match the next three ECG beats.','Stillpoint slows field time; your hands stay fast. Second Pulse protects vitals and rewards clean work.','Start with your colleague within one second for CONSULT.'],\n ['The flap','Forceps on the gold handle. Pull upward to raise the tissue.','Release above the clip line to hold it for eight seconds. A partner can hold indefinitely.','You cannot treat what is below a closed flap.'],\n ['Several sites','Q / E or D-pad left / right changes the operating site.','Every other site keeps bleeding. In Gala Night each table has its own vitals.','An edge alert means another site needs your hands.'],\n ['Code blue','LMB + RMB, or L2 + R2. Both together when the charge reaches green.','Eight seconds, two tries. A successful shock restores 25 vitals.','A lost patient ends the whole operation.'],\n ['LULL','Lilac. It quiets the monitor while draining life.','Laser the small ones; Forceps the cocoons. Gel every numb patch.','The Matron opens her maw for 2.5 seconds. Two Binder doses.'],\n ['SOLACE','Amber. Large ones thrive under the Laser.','Cut through at least 1.5 metres to divide them. Only the smallest generation burns.','Mother Solace hides beneath a flap. Ask your colleague to hold it.'],\n ['REVERIE','Ink-blue. A raised ripple moves under the tissue.','Scanner reveals it for six seconds. Laser brings it to the surface for three.','Three exposures. Listen for the true heartbeat among the decoys.'],\n ['BALM','Pearl lacquer, spreading half a metre at a time.','Lacquer blocks sutures and suction. Gel dissolves it. Laser works at a cost to vitals.','Two Binder doses kill a Node; its film fades in six seconds.'],\n ['MERCY','White-gold. Anesthesia, The Kindness, Last Rites.','Laser the shield; Binder the core. Restart the heart and close the rakes.','Cut with the heartbeat. Extract all five tendrils. Gift, Binder, then one final shock.'],\n];\nexport function handbook(c:UIContext,index:number):string{\n const count=12+Math.max(0,Math.min(5,c.d.progress.unlocked-3)),i=(index%count+count)%count;\n const data=i<8?[TOOLS[i],...HELP[TOOLS[i]]]:extra[i-8];\n return page('The surgical Handbook','READ THE BODY / TRUST THE TOOLS',\"'`${i<8?`<div class=\"handbook-icon\">${toolIcon(i)}</div>`:'\"''}<article class=\\\"handbook-text\\\"><div class=\\\"eyebrow\\\">\"'${i<8?`INSTRUMENT ${i+1} / KEY ${i+1}`:'\"'CHARGE NURSE’S NOTES'}</div><h2>\"'${esc(data[0])}</h2>${data.slice(1).map(text=>`<p>${esc(text)}</p>`).join('\"'')}</article>\"'`,`${button('\"'back','Back')}\"'${button('\"'ref-prev','← Previous')}<span class=\\\"about-index\\\">\"'${i+1} / ${count}</span>${button('\"'ref-next','Next →')}\"'`);\n}\nexport function postcards(c:UIContext,index:number):string{\n const ids=Object.keys(c.d.progress.postcards),id=ids[index%Math.max(1,ids.length)],cs=CASES.find(c=>c.id===id);\n return page('\"'The people you saved','POSTCARDS / PORT VERITY',ids.length?\"'`<article class=\"postcard\"><div class=\"eyebrow\" style=\"color:#537767\">HARBOR LIGHT GENERAL</div><h3>Dear Doctor,</h3><p>${esc(c.d.progress.postcards[id])}</p><div class=\"signature\">${esc(cs?.patient??'\"'The night shift')}</div></article>\"'`:'\"'<article class=\\\"handbook-text\\\"><h3>The post has not arrived yet.</h3><p>Finish an operation. Every patient has a life beyond the monitor.</p></article>',\"'`${button('\"'back','Back')}\"'${ids.length>1?button('\"'ref-prev','← Previous'):''}<span class=\\\"small\\\">\"'${ids.length} postcard${ids.length===1?'\"'':'s'} received</span>\"'${ids.length>1?button('\"'ref-next','Next →'):''}\"'`);\n}\nEOF\ncat > labs/game/ui/settings.ts <<'\"'EOF'\n/** @file Four preference pages with large live controls, controller glyph choices and persistent rebinding. */\nimport type {Preferences} from '../app/settings';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc} from './icons';\nexport const settingTabs=['Audio','Controls','Gameplay','Display','Rebind'];\nexport function settingPage(c:UIContext,tab:number,rebindPage=0):string{\n const p=c.prefs;\n const slider=(key:keyof Preferences,label:string,min=0,max=1,step=.01):string=>\"'`<div class=\"setting-row\"><label for=\"pref-${key}\">${label}</label><input data-focus id=\"pref-${key}\" data-pref=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${p[key]}\"/><output>${max===1?Math.round(Number(p[key])*100)+'\"'%':Number(p[key]).toFixed(1)}</output></div>\"'`;\n const choice=(key:keyof Preferences,label:string):string=>`<div class=\"setting-row\"><label>${label}</label>${button(`pref:${key}`,typeof p[key]==='\"'boolean'?p[key]?'On':'Off':esc(p[key]))}</div>\"'`;\n let body='\"'';\n if(tab===0)body=slider('master','Master')+slider('music','Music')+slider('effects','Effects')+slider('voice','Gibberish voices');\n if(tab===1)body=choice('glyphs','Controller glyphs')+slider('cursorSpeed','Cursor speed',3,25,.5)+choice('assist','Aim assistance')+choice('toggleUse','Toggle tool use');\n if(tab===2)body=choice('difficulty','Difficulty')+choice('simpleGift','Simple Gift')+choice('hints','Hints')+choice('auto','Auto-advance story')+slider('textSpeed','Story pace',.5,2,.1);\n if(tab===3)body=choice('blood','Blood colour')+choice('flashes','Drama flashes')+slider('textSize','Text size',.85,1.3,.05);\n if(tab===4){const bindings=c.engine()?.input.bindingsFor('actionMap:surgeon'),actions=bindings?.actions()??[];body=actions.slice(rebindPage*4,rebindPage*4+4).map(action=>\"'`<div class=\"setting-row\"><label>${esc(action)}</label>${button(`bind:${action}`,esc(bindings?.label(action,c.hands.lastDevice)??'\"''))}</div>\"'`).join('\"'');body+=\"'`<div class=\"page-footer\">${button('\"'bind-prev','← Previous controls')}\"'${button('\"'bind-reset','Reset bindings')}\"'${button('\"'bind-next','Next controls →')}</div>\"'`;}\n return page('\"'Settings',settingTabs[tab].toUpperCase(),\"'`<div class=\"settings-rows\"><nav class=\"tabs\">${settingTabs.map((name,i)=>button(`settings-tab:${i}`,name,`class=\"${i===tab?'\"'selected':''}\\\"\"'`)).join('\"'')}</nav>\"'${body}</div>`,`${button('\"'back','Back')}<span class=\\\"small\\\">\"'${tab===0?'\"'Music defaults to 10%. All sound is synthesized.':tab===4?'Select a binding, then press the new key or button.':'Preferences save on this device.'}</span>\"'`);\n}\nexport function cyclePreference(c:UIContext,key:keyof Preferences):void{\n const p=c.prefs,v=p[key];\n if(typeof v==='\"'boolean')Object.assign(p,{[key]:\"'!v});\n else{\n  const options:Record<string,string[]>={glyphs:['\"'PlayStation','Xbox'],blood:['red','teal','off'],difficulty:c.d.progress.ended?['Intern','Resident','Attending']:['Intern','Resident']};\n  const choices=options[key];if(choices)Object.assign(p,{[key]:choices[(choices.indexOf(String(v))+1)%choices.length]});\n }c.set('game.simpleGift',p.simpleGift);c.save();\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/reference.ts <<'EOF'\n/** @file Paged clinical Handbook, source information, interview feedback and patient correspondence. */\nimport {interview} from '../data/about';\nimport {HELP,TOOLS} from '../data/tools';\nimport {CASES} from '../data/cases';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc,toolIcon} from './icons';\nconst questions={testing:['How many issues did testing catch?','How many were critical or game breaking?','What was the most helpful test?','What was the least helpful test?'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','What was most important to build yourself?','What was hardest about using the engine?','What did you change in the engine, and why?','What one engine improvement would you make?'],prompt:['What did you like most about this prompt?','What was confusing?','What was hardest to do?','What would you change?']};\nexport const aboutCards=[...Object.entries(interview.sourceInformation).map(([key,value])=>({section:'Source Information',title:key==='artDirection'?'Art direction':key.charAt(0).toUpperCase()+key.slice(1),body:value,key})),...interview.testingFeedback.map((body,i)=>({section:'Testing Feedback',title:questions.testing[i],body,key:''})),...interview.engineFeedback.map((body,i)=>({section:'Engine Feedback',title:questions.engine[i],body,key:''})),...interview.promptFeedback.map((body,i)=>({section:'Prompt Feedback',title:questions.prompt[i],body,key:''})),{section:'Credits',title:'Harbor Light General',body:'Original game, characters, geometry, animations and synthesized score. Built with my-3dge and three.js (MIT); Rapier and stdlib mathematics (Apache-2.0). Inspired by Trauma Center: Second Opinion. All characters and events in Port Verity are fictional.',key:'credits'}];\nexport function about(index:number):string{\n const card=aboutCards[((index%aboutCards.length)+aboutCards.length)%aboutCards.length];\n return page('About & credits',card.section.toUpperCase(),\"'`<article class=\"feedback-card\"><div class=\"eyebrow\">${esc(card.section)}</div><h3>${esc(card.title)}</h3><p data-about=\"${card.key}\">${esc(card.body)}</p></article>`,`${button('\"'back','Back')}\"'${button('\"'ref-prev','← Previous')}<span class=\\\"about-index\\\">\"'${index+1} / ${aboutCards.length}</span>${button('\"'ref-next','Next →')}\"'`);\n}\nconst extra=[\n ['\"'The Gift','Space / Triangle starts pulse-lock. Match the next three ECG beats.','Stillpoint slows field time; your hands stay fast. Second Pulse protects vitals and rewards clean work.','Start with your colleague within one second for CONSULT.'],\n ['The flap','Forceps on the gold handle. Pull upward to raise the tissue.','Release above the clip line to hold it for eight seconds. A partner can hold indefinitely.','You cannot treat what is below a closed flap.'],\n ['Several sites','Q / E or D-pad left / right changes the operating site.','Every other site keeps bleeding. In Gala Night each table has its own vitals.','An edge alert means another site needs your hands.'],\n ['Code blue','LMB + RMB, or L2 + R2. Both together when the charge reaches green.','Eight seconds, two tries. A successful shock restores 25 vitals.','A lost patient ends the whole operation.'],\n ['LULL','Lilac. It quiets the monitor while draining life.','Laser the small ones; Forceps the cocoons. Gel every numb patch.','The Matron opens her maw for 2.5 seconds. Two Binder doses.'],\n ['SOLACE','Amber. Large ones thrive under the Laser.','Cut through at least 1.5 metres to divide them. Only the smallest generation burns.','Mother Solace hides beneath a flap. Ask your colleague to hold it.'],\n ['REVERIE','Ink-blue. A raised ripple moves under the tissue.','Scanner reveals it for six seconds. Laser brings it to the surface for three.','Three exposures. Listen for the true heartbeat among the decoys.'],\n ['BALM','Pearl lacquer, spreading half a metre at a time.','Lacquer blocks sutures and suction. Gel dissolves it. Laser works at a cost to vitals.','Two Binder doses kill a Node; its film fades in six seconds.'],\n ['MERCY','White-gold. Anesthesia, The Kindness, Last Rites.','Laser the shield; Binder the core. Restart the heart and close the rakes.','Cut with the heartbeat. Extract all five tendrils. Gift, Binder, then one final shock.'],\n];\nexport function handbook(c:UIContext,index:number):string{\n const count=12+Math.max(0,Math.min(5,c.d.progress.unlocked-3)),i=(index%count+count)%count;\n const data=i<8?[TOOLS[i],...HELP[TOOLS[i]]]:extra[i-8];\n return page('The surgical Handbook','READ THE BODY / TRUST THE TOOLS',\"'`${i<8?`<div class=\"handbook-icon\">${toolIcon(i)}</div>`:'\"''}<article class=\\\"handbook-text\\\"><div class=\\\"eyebrow\\\">\"'${i<8?`INSTRUMENT ${i+1} / KEY ${i+1}`:'\"'CHARGE NURSE’S NOTES'}</div><h2>\"'${esc(data[0])}</h2>${data.slice(1).map(text=>`<p>${esc(text)}</p>`).join('\"'')}</article>\"'`,`${button('\"'back','Back')}\"'${button('\"'ref-prev','← Previous')}<span class=\\\"about-index\\\">\"'${i+1} / ${count}</span>${button('\"'ref-next','Next →')}\"'`);\n}\nexport function postcards(c:UIContext,index:number):string{\n const ids=Object.keys(c.d.progress.postcards),id=ids[index%Math.max(1,ids.length)],cs=CASES.find(c=>c.id===id);\n return page('\"'The people you saved','POSTCARDS / PORT VERITY',ids.length?\"'`<article class=\"postcard\"><div class=\"eyebrow\" style=\"color:#537767\">HARBOR LIGHT GENERAL</div><h3>Dear Doctor,</h3><p>${esc(c.d.progress.postcards[id])}</p><div class=\"signature\">${esc(cs?.patient??'\"'The night shift')}</div></article>\"'`:'\"'<article class=\\\"handbook-text\\\"><h3>The post has not arrived yet.</h3><p>Finish an operation. Every patient has a life beyond the monitor.</p></article>',\"'`${button('\"'back','Back')}\"'${ids.length>1?button('\"'ref-prev','← Previous'):''}<span class=\\\"small\\\">\"'${ids.length} postcard${ids.length===1?'\"'':'s'} received</span>\"'${ids.length>1?button('\"'ref-next','Next →'):''}\"'`);\n}\nEOF\ncat > labs/game/ui/settings.ts <<'\"'EOF'\n/** @file Four preference pages with large live controls, controller glyph choices and persistent rebinding. */\nimport type {Preferences} from '../app/settings';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc} from './icons';\nexport const settingTabs=['Audio','Controls','Gameplay','Display','Rebind'];\nexport function settingPage(c:UIContext,tab:number,rebindPage=0):string{\n const p=c.prefs;\n const slider=(key:keyof Preferences,label:string,min=0,max=1,step=.01):string=>\"'`<div class=\"setting-row\"><label for=\"pref-${key}\">${label}</label><input data-focus id=\"pref-${key}\" data-pref=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${p[key]}\"/><output>${max===1?Math.round(Number(p[key])*100)+'\"'%':Number(p[key]).toFixed(1)}</output></div>\"'`;\n const choice=(key:keyof Preferences,label:string):string=>`<div class=\"setting-row\"><label>${label}</label>${button(`pref:${key}`,typeof p[key]==='\"'boolean'?p[key]?'On':'Off':esc(p[key]))}</div>\"'`;\n let body='\"'';\n if(tab===0)body=slider('master','Master')+slider('music','Music')+slider('effects','Effects')+slider('voice','Gibberish voices');\n if(tab===1)body=choice('glyphs','Controller glyphs')+slider('cursorSpeed','Cursor speed',3,25,.5)+choice('assist','Aim assistance')+choice('toggleUse','Toggle tool use');\n if(tab===2)body=choice('difficulty','Difficulty')+choice('simpleGift','Simple Gift')+choice('hints','Hints')+choice('auto','Auto-advance story')+slider('textSpeed','Story pace',.5,2,.1);\n if(tab===3)body=choice('blood','Blood colour')+choice('flashes','Drama flashes')+slider('textSize','Text size',.85,1.3,.05);\n if(tab===4){const bindings=c.engine()?.input.bindingsFor('actionMap:surgeon'),actions=bindings?.actions()??[];body=actions.slice(rebindPage*4,rebindPage*4+4).map(action=>\"'`<div class=\"setting-row\"><label>${esc(action)}</label>${button(`bind:${action}`,esc(bindings?.label(action,c.hands.lastDevice)??'\"''))}</div>\"'`).join('\"'');body+=\"'`<div class=\"page-footer\">${button('\"'bind-prev','← Previous controls')}\"'${button('\"'bind-reset','Reset bindings')}\"'${button('\"'bind-next','Next controls →')}</div>\"'`;}\n return page('\"'Settings',settingTabs[tab].toUpperCase(),\"'`<div class=\"settings-rows\"><nav class=\"tabs\">${settingTabs.map((name,i)=>button(`settings-tab:${i}`,name,`class=\"${i===tab?'\"'selected':''}\\\"\"'`)).join('\"'')}</nav>\"'${body}</div>`,`${button('\"'back','Back')}<span class=\\\"small\\\">\"'${tab===0?'\"'Music defaults to 10%. All sound is synthesized.':tab===4?'Select a binding, then press the new key or button.':'Preferences save on this device.'}</span>\"'`);\n}\nexport function cyclePreference(c:UIContext,key:keyof Preferences):void{\n const p=c.prefs,v=p[key];\n if(typeof v==='\"'boolean')Object.assign(p,{[key]:\"'!v});\n else{\n  const options:Record<string,string[]>={glyphs:['\"'PlayStation','Xbox'],blood:['red','teal','off'],difficulty:c.d.progress.ended?['Intern','Resident','Attending']:['Intern','Resident']};\n  const choices=options[key];if(choices)Object.assign(p,{[key]:choices[(choices.indexOf(String(v))+1)%choices.length]});\n }c.set('game.simpleGift',p.simpleGift);c.save();\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/dev.ts <<'EOF'\n/** @file Live balance, reproducible play actions, view diagnostics, path authoring and replay export. */\nimport {BALANCE} from '../data/balance';\nimport {CASES,SESSION} from '../data/cases';\nimport {KINDS} from '../data/tools';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc} from './icons';\nexport const DEV_TABS=['Play','Balance','View','Author','Data'];\nexport interface DevView {tab:number;page:number;caseIndex:number;phase:number;spawn:number;seed:number;hideHud:boolean;shapes:boolean;assist:boolean;freeCamera:boolean;author:boolean;path:number[][];look:number;}\nexport const newDevView=():DevView=>({tab:0,page:0,caseIndex:0,phase:0,spawn:0,seed:1,hideHud:false,shapes:false,assist:false,freeCamera:false,author:false,path:[],look:0});\nexport function devPage(c:UIContext,d:DevView):string{\n const cs=[...CASES,SESSION][d.caseIndex],state=c.state();let body='';\n const row=(label:string,control:string):string=>\"'`<div class=\"setting-row\"><label>${label}</label>${control}</div>`;\n if(d.tab===0){\n  const groups=[\n   row('\"'Case',button('dev-case-prev','←')+button('dev-case-next',esc(cs.title)))+row('Phase',button('dev-phase-prev','←')+button('dev-phase-next',\"'`${d.phase+1} · ${esc(cs.phases[d.phase]?.title??'\"'Opening')}\"'`))+row('\"'Jump in',button('dev-jump','Begin at checkpoint')),\n   row('Operation',button('dev-act:phase','Win phase')+button('dev-act:fail','Fail'))+row('Vitals',button('dev-act:heal','Restore to 100')+button('dev-toggle:freezeVitals',c.get('game.freezeVitals')?'Unfreeze':'Freeze'))+row('Clock',button('dev-toggle:freezeClock',c.get('game.freezeClock')?'Unfreeze':'Freeze'))+row('Gift',button('dev-toggle:infiniteGift',c.get('game.infiniteGift')?'Finite':'Infinite')+button('dev-act:gift','Grant')),\n   row('Surgeons',button('dev-act:bot','Add bot')+button('dev-toggle:autoplay',c.get('game.autoplay')?'Stop autoplay':'Autoplay'))+row('Parasites',button('dev-toggle:oneHit',c.get('game.oneHit')?'Normal HP':'One-hit'))+row('Time scale','<input data-focus type=\\\"range\\\" data-timescale min=\\\".25\\\" max=\\\"4\\\" step=\\\".25\\\" value=\\\"1\\\"><output>1×</output>')+row('One tick',button('dev-step','Frame step')),\n   row('Spawn target',button('dev-spawn-prev','←')+button('dev-spawn-next',KINDS[d.spawn])+button('dev-spawn','Spawn at cursor'))+row('Seed',button('dev-seed','Next seed: '+d.seed))+row('Case files',button('dev-unlock','Unlock all')),\n  ];body=groups[d.page%groups.length];\n }else if(d.tab===1){body=Object.entries(BALANCE).slice(d.page*4,d.page*4+4).map(([key,[value,min,max,label]])=>row(label,\"'`<input data-focus data-balance=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${max>20?1:.05}\" value=\"${c.get(`game.${key}`)??value}\"><output>${Number(c.get(`game.${key}`)??value).toFixed(2)}</output>${button(`balance-reset:${key}`,'\"'↺',\"'`aria-label=\"Reset ${label}\"`)}`)).join('\"'');}\n else if(d.tab===2)body=row('HUD',button('dev-view:hideHud',d.hideHud?'Hidden':'Visible'))+row('Target shapes',button('dev-view:shapes',d.shapes?'On':'Off'))+row('Cursor assistance',button('dev-view:assist',d.assist?'Shown':'Hidden'))+row('Camera / look',button('dev-view:freeCamera',d.freeCamera?'Free':'Surgical')+button('dev-look',d.look?'Harbor':'Field'));\n else if(d.tab===3)body=\"'`<p class=\"small\">Draw a surgical guide directly on the field. Hold the tool trigger or click and move. Escape returns here. The polyline is ready to paste into a case file.</p>${row('\"'Path',button('dev-author','Draw on the field')+button('dev-copy-path','Copy polyline'))}<pre class=\\\"dev-output\\\" data-game=\\\"author-path\\\">\"'${esc(JSON.stringify(d.path))}</pre>`;\n else body=`<pre class=\"dev-output\" data-game=\"dev-data\">State hash: ${esc(c.engine()?.inspector.hash()??'\"'unknown')}\\\\n\"'${esc(state?.events.slice(-6).map(e=>`${e.n} ${e.type}: ${e.text}`).join('\"'\\\\n')??'No operation is running.')}</pre>\"'${row('\"'Replay',button('dev-copy-replay','Copy recorded inputs'))}\"'`;\n return page('\"'Developer theatre','LIVE / RECORDED CHANGES · SCORES DISABLED',\"'`<div class=\"settings-rows\"><nav class=\"tabs\">${DEV_TABS.map((name,i)=>button(`dev-tab:${i}`,name,`class=\"${i===d.tab?'\"'selected':''}\\\"\"'`)).join('\"'')}</nav>\"'${body}</div>`,`${button('\"'back','Back')}\"'${d.tab<=1?button('\"'dev-prev','← Previous'):''}\"'${d.tab===1?button('\"'balance-reset-all','Reset all defaults'):''}<span class=\\\"about-index\\\">\"'${d.tab<=1?`PAGE ${d.page+1}`:'\"''}</span>\"'${d.tab<=1?button('\"'dev-next','Next →'):''}\"'`);\n}\nEOF\ncat > labs/game/ui/hud.ts <<'\"'EOF'\n/** @file The operating HUD: only physiology, time, score, tools, a nurse and actionable body feedback. */\nimport {getCase} from '../data/cases';\nimport {TOOLS,HELP} from '../data/tools';\nimport {heartRate,shockLevel,beatPeriod} from '../scenes/op/gift';\nimport type {Operation} from '../data/types';\nimport type {UIContext} from './context';\nimport {button,esc,toolIcon} from './icons';\nexport class Hud{\n root:HTMLElement;lastEvent=0;lastWorld:object|null=null;line='';popTime=0;dramaTime=0;time=0;\n constructor(root:HTMLElement){this.root=root;root.innerHTML=\"'`<div class=\"hud-low\" id=\"hud-low\"></div><div class=\"gift-overlay\" data-game=\"gift-overlay\"></div><div class=\"hud-top\"><div class=\"vitals-block\"><div class=\"hud-label\">VITAL SIGNS / <span data-game=\"patient-label\"></span></div><div class=\"vitals-number\"><span data-game=\"vitals\">70</span><small data-game=\"bpm\">78 BPM</small></div><svg class=\"ecg\" data-game=\"ecg\" viewBox=\"0 0 400 48\" preserveAspectRatio=\"none\"><path data-game=\"ecg-path\"/></svg><div class=\"vitals-bar\"><i data-game=\"vitals-fill\"></i></div></div><div class=\"clock-block\"><div class=\"hud-label\" data-game=\"case-label\"></div><div class=\"clock-value\" data-game=\"clock\"></div><div class=\"phase-name\" data-game=\"phase\"></div><div class=\"small\" data-game=\"phase-index\"></div></div><div class=\"score-block\"><div class=\"hud-label\">PROCEDURE SCORE</div><div class=\"score-value\" data-game=\"score\"></div><div class=\"chain\" data-game=\"chain\"></div><div class=\"small\" data-game=\"slips\"></div></div></div><div class=\"gift-banner\" data-game=\"gift\"></div><div class=\"site-tabs\" data-game=\"sites\"></div><div class=\"odie-box\"><svg class=\"odie-avatar\" viewBox=\"0 0 60 70\"><path d=\"M12 68V45c0-10 36-10 36 0v23\" fill=\"#1f4650\"/><ellipse cx=\"30\" cy=\"24\" rx=\"17\" ry=\"21\" fill=\"#a47d62\"/><path d=\"M12 22c-4-28 39-27 36 1L38 12 19 14Z\" fill=\"#b9b9a8\"/><path d=\"M18 42h24l-3 13H22Z\" fill=\"#6c9292\"/><path d=\"M22 26h4m8 0h4\" stroke=\"#182b35\" stroke-width=\"3\"/></svg><div><div class=\"speaker\">ODIE / CHARGE NURSE</div><p data-game=\"hint\"></p></div></div><div class=\"rating-pop\" data-game=\"rating\"></div><div class=\"tool-bar\" aria-label=\"Surgical instruments\">${TOOLS.map((t,i)=>`<button data-tool=\"${i}\" class=\"tool-button\" aria-label=\"${t}\"><span class=\"tool-key\">${i+1}</span>${toolIcon(i)}<span class=\"tool-name\">${t}</span></button>`).join('\"'')}</div><div class=\\\"selected-tool\\\"><strong data-game=\\\"tool-name\\\"></strong><p data-game=\\\"tool-help\\\"></p></div><div class=\\\"charge-panel\\\" data-game=\\\"syringe-panel\\\"><div class=\\\"hud-label\\\">STABILIZER / RELEASE IN GREEN</div><div class=\\\"charge-bar\\\"><span class=\\\"green\\\"></span><i data-game=\\\"syringe-fill\\\"></i></div></div><div data-game=\\\"context\\\"></div><footer class=\\\"op-footer\\\"><span data-game=\\\"prompts\\\"></span><button data-action=\\\"pause\\\" aria-label=\\\"Pause operation\\\">Ⅱ <span data-game=\\\"pause-prompt\\\">ESC</span> · Pause</button></footer>\"'`;}\n el(name:string):HTMLElement{return this.root.querySelector(`[data-game=\"${name}\"]`)!;}\n frame(c:UIContext,s:Operation,dt:number,world:object):void{\n  this.time+=dt;if(this.lastWorld!==world){this.lastWorld=world;this.lastEvent=0;this.line=s.hint;}\n  const cs=getCase(s.caseId),p=s.seats[0],v=s.patients.length>1?s.patients[p.site]:s.patients[0],pad=c.hands.lastDevice==='\"'gamepad',xbox=c.prefs.glyphs==='Xbox';\n  this.el('vitals').textContent=String(Math.max(0,Math.round(v)));this.el('vitals-fill').style.width=\"'`${Math.max(0,v)}%`;this.el('\"'bpm').textContent=s.code?'ASYSTOLE':\"'`${heartRate(s)} BPM`;\n  this.el('\"'patient-label').textContent=cs.patient.toUpperCase();this.el('case-label').textContent=\"'`CASE ${cs.id==='\"'gala-shift'?'TEAM':String(c.d.caseIndex+1).padStart(2,'0')} / \"'${cs.title.toUpperCase()}`;\n  this.el('\"'clock').textContent=\"'`${Math.floor(s.left/360000)}:${String(Math.ceil(s.left/6000)%60).padStart(2,'\"'0')}\"'`;this.el('\"'phase').textContent=cs.phases[s.phase].title;this.el('phase-index').textContent=\"'`PHASE ${s.phase+1} OF ${cs.phases.length}`;\n  this.el('\"'score').textContent=s.score.toLocaleString('en');this.el('chain').textContent=\"'`×${s.chain.toFixed(1)} CHAIN`;this.el('\"'slips').textContent=\"'`${s.slips} SLIPS`;\n  this.el('\"'tool-name').textContent=TOOLS[p.tool];this.el('tool-help').textContent=HELP[TOOLS[p.tool]][0];\n  for(const b of this.root.querySelectorAll<HTMLButtonElement>('[data-tool]'))b.classList.toggle('active',Number(b.dataset.tool)===p.tool);\n  const events=s.events.filter(e=>e.n>this.lastEvent);\n  for(const e of events){this.lastEvent=e.n;if(['say','hint','phase','refusal'].includes(e.type)){this.line=e.type==='phase'?s.hint:e.text;if(e.type\"'!=='\"'refusal')c.sound.say('odie',this.line,c.prefs);}if(e.type==='rating'){this.el('rating').textContent=e.text;this.popTime=this.time+1;}if(e.type==='drama'&&c.prefs.flashes){const d=document.getElementById('drama')\"'!;d.querySelector('\"'b')\"'!.textContent=e.text;d.classList.add('\"'show');this.dramaTime=this.time+.8;}}\n  this.el('hint').textContent=this.line;this.el('rating').classList.toggle('show',this.popTime>this.time);if(this.dramaTime<this.time)document.getElementById('drama')?.classList.remove('show');\n  const active=s.seats.find(q=>q.giftUntil>s.tick),overlay=this.el('gift-overlay');overlay.className=\"'`gift-overlay ${active?active.giftKind==='\"'still'?'still':'pulse':''}\"'`;this.el('\"'gift').textContent=active?\"'`${active.giftKind==='\"'still'?'STILLPOINT':'SECOND PULSE'} · \"'${Math.ceil((active.giftUntil-s.tick)/60)}s`:p.gift>0?`${pad?xbox?'\"'Y':'△':'SPACE'} · \"'${p.giftKind==='\"'pulse'?'SECOND PULSE':'STILLPOINT'} READY\"'`:'\"'';\n  this.el('syringe-panel').style.display=p.tool===5?'block':'none';this.el('syringe-fill').style.width=\"'`${Math.min(100,p.charge*100)}%`;\n  const sites=this.el('\"'sites'),siteHTML=cs.sites.length>1?cs.sites.map((name,i)=>\"'`<button data-site=\"${i}\" class=\"${i===p.site?'\"'active':''} \"'${s.targets.some(t=>!t.done&&t.site===i&&t.kind==='\"'wound')?'danger':''}\\\">\"'${esc(name)}<small>${s.patients.length>1?`${Math.round(s.patients[i])} VITALS`:s.targets.filter(t=>!t.done&&t.site===i&&t.required).length+'\"' TARGETS'}</small></button>\"'`).join('\"''):'';if(sites.innerHTML\"'!==siteHTML)sites.innerHTML=siteHTML;\n  this.el('\"'prompts').innerHTML=pad?\"'`<span class=\"glyph\">${xbox?'\"'RT':'R2'}</span> Use <span class=\\\"glyph\\\">RS</span> Tools <span class=\\\"glyph\\\">\"'${xbox?'\"'X':'□'}</span> Syringe <span class=\\\"glyph\\\">↑</span> Hint\"'`:'\"'<kbd>LMB</kbd> Use <kbd>RMB</kbd> Tool radial <kbd>F</kbd> Syringe <kbd>H</kbd> Hint';this.el('pause-prompt').textContent=pad?'OPTIONS':'ESC';\n  let context='';if(s.code)context=\"'`<section class=\"code-panel\"><div class=\"eyebrow\">CODE BLUE / TWO CHANCES</div><h2>Bring them back.</h2><div class=\"charge-bar\"><span class=\"green\"></span><i style=\"width:${shockLevel(s)*100}%\"></i></div><p>${pad?'\"'L2 + R2':'LMB + RMB'} together when the charge is in green.</p><p class=\\\"gold\\\">\"'${Math.max(0,Math.ceil((s.code.until-s.fieldTicks)/6000))} seconds · ${2-s.code.tries} shocks</p></section>`;\n  else if(p.pulseAt){const beat=(s.tick%beatPeriod(s))/beatPeriod(s);context=`<section class=\"pulse-panel\"><div class=\"eyebrow\">PULSE-LOCK</div><h3>Match the next three beats.</h3><div class=\"pulse-beats\">${'\"'●'.repeat(p.beats)}\"'${'\"'○'.repeat(3-p.beats)}</div><div class=\\\"charge-bar\\\"><i style=\\\"width:\"'${beat*100}%\"></i></div><p class=\"small\">${pad?xbox?'\"'Y':'△':'SPACE'} on the ECG peak</p></section>\"'`;}\n  this.el('\"'context').innerHTML=context;\n  const lull=s.targets.some(t=>\"'!t.done&&t.kind==='\"'lull');this.el('ecg').classList.toggle('dim',lull);const path:string[]=[];for(let x=0;x<=400;x+=3){const cycle=(x/400*3+s.fieldTicks/6000*heartRate(s)/60)%1;const y=s.code?25:25-(cycle>.14&&cycle<.18?30:cycle>.18&&cycle<.22?-15:cycle>.08&&cycle<.12?5:0);path.push(\"'`${x===0?'\"'M':'L'}\"'${x} ${y}`);}this.el('\"'ecg-path').setAttribute('d',path.join(' '));document.body.classList.toggle('low',v<25);\n }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/dev.ts <<'EOF'\n/** @file Live balance, reproducible play actions, view diagnostics, path authoring and replay export. */\nimport {BALANCE} from '../data/balance';\nimport {CASES,SESSION} from '../data/cases';\nimport {KINDS} from '../data/tools';\nimport type {UIContext} from './context';\nimport {page} from './pages';\nimport {button,esc} from './icons';\nexport const DEV_TABS=['Play','Balance','View','Author','Data'];\nexport interface DevView {tab:number;page:number;caseIndex:number;phase:number;spawn:number;seed:number;hideHud:boolean;shapes:boolean;assist:boolean;freeCamera:boolean;author:boolean;path:number[][];look:number;}\nexport const newDevView=():DevView=>({tab:0,page:0,caseIndex:0,phase:0,spawn:0,seed:1,hideHud:false,shapes:false,assist:false,freeCamera:false,author:false,path:[],look:0});\nexport function devPage(c:UIContext,d:DevView):string{\n const cs=[...CASES,SESSION][d.caseIndex],state=c.state();let body='';\n const row=(label:string,control:string):string=>\"'`<div class=\"setting-row\"><label>${label}</label>${control}</div>`;\n if(d.tab===0){\n  const groups=[\n   row('\"'Case',button('dev-case-prev','←')+button('dev-case-next',esc(cs.title)))+row('Phase',button('dev-phase-prev','←')+button('dev-phase-next',\"'`${d.phase+1} · ${esc(cs.phases[d.phase]?.title??'\"'Opening')}\"'`))+row('\"'Jump in',button('dev-jump','Begin at checkpoint')),\n   row('Operation',button('dev-act:phase','Win phase')+button('dev-act:fail','Fail'))+row('Vitals',button('dev-act:heal','Restore to 100')+button('dev-toggle:freezeVitals',c.get('game.freezeVitals')?'Unfreeze':'Freeze'))+row('Clock',button('dev-toggle:freezeClock',c.get('game.freezeClock')?'Unfreeze':'Freeze'))+row('Gift',button('dev-toggle:infiniteGift',c.get('game.infiniteGift')?'Finite':'Infinite')+button('dev-act:gift','Grant')),\n   row('Surgeons',button('dev-act:bot','Add bot')+button('dev-toggle:autoplay',c.get('game.autoplay')?'Stop autoplay':'Autoplay'))+row('Parasites',button('dev-toggle:oneHit',c.get('game.oneHit')?'Normal HP':'One-hit'))+row('Time scale','<input data-focus type=\\\"range\\\" data-timescale min=\\\".25\\\" max=\\\"4\\\" step=\\\".25\\\" value=\\\"1\\\"><output>1×</output>')+row('One tick',button('dev-step','Frame step')),\n   row('Spawn target',button('dev-spawn-prev','←')+button('dev-spawn-next',KINDS[d.spawn])+button('dev-spawn','Spawn at cursor'))+row('Seed',button('dev-seed','Next seed: '+d.seed))+row('Case files',button('dev-unlock','Unlock all')),\n  ];body=groups[d.page%groups.length];\n }else if(d.tab===1){body=Object.entries(BALANCE).slice(d.page*4,d.page*4+4).map(([key,[value,min,max,label]])=>row(label,\"'`<input data-focus data-balance=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${max>20?1:.05}\" value=\"${c.get(`game.${key}`)??value}\"><output>${Number(c.get(`game.${key}`)??value).toFixed(2)}</output>${button(`balance-reset:${key}`,'\"'↺',\"'`aria-label=\"Reset ${label}\"`)}`)).join('\"'');}\n else if(d.tab===2)body=row('HUD',button('dev-view:hideHud',d.hideHud?'Hidden':'Visible'))+row('Target shapes',button('dev-view:shapes',d.shapes?'On':'Off'))+row('Cursor assistance',button('dev-view:assist',d.assist?'Shown':'Hidden'))+row('Camera / look',button('dev-view:freeCamera',d.freeCamera?'Free':'Surgical')+button('dev-look',d.look?'Harbor':'Field'));\n else if(d.tab===3)body=\"'`<p class=\"small\">Draw a surgical guide directly on the field. Hold the tool trigger or click and move. Escape returns here. The polyline is ready to paste into a case file.</p>${row('\"'Path',button('dev-author','Draw on the field')+button('dev-copy-path','Copy polyline'))}<pre class=\\\"dev-output\\\" data-game=\\\"author-path\\\">\"'${esc(JSON.stringify(d.path))}</pre>`;\n else body=`<pre class=\"dev-output\" data-game=\"dev-data\">State hash: ${esc(c.engine()?.inspector.hash()??'\"'unknown')}\\\\n\"'${esc(state?.events.slice(-6).map(e=>`${e.n} ${e.type}: ${e.text}`).join('\"'\\\\n')??'No operation is running.')}</pre>\"'${row('\"'Replay',button('dev-copy-replay','Copy recorded inputs'))}\"'`;\n return page('\"'Developer theatre','LIVE / RECORDED CHANGES · SCORES DISABLED',\"'`<div class=\"settings-rows\"><nav class=\"tabs\">${DEV_TABS.map((name,i)=>button(`dev-tab:${i}`,name,`class=\"${i===d.tab?'\"'selected':''}\\\"\"'`)).join('\"'')}</nav>\"'${body}</div>`,`${button('\"'back','Back')}\"'${d.tab<=1?button('\"'dev-prev','← Previous'):''}\"'${d.tab===1?button('\"'balance-reset-all','Reset all defaults'):''}<span class=\\\"about-index\\\">\"'${d.tab<=1?`PAGE ${d.page+1}`:'\"''}</span>\"'${d.tab<=1?button('\"'dev-next','Next →'):''}\"'`);\n}\nEOF\ncat > labs/game/ui/hud.ts <<'\"'EOF'\n/** @file The operating HUD: only physiology, time, score, tools, a nurse and actionable body feedback. */\nimport {getCase} from '../data/cases';\nimport {TOOLS,HELP} from '../data/tools';\nimport {heartRate,shockLevel,beatPeriod} from '../scenes/op/gift';\nimport type {Operation} from '../data/types';\nimport type {UIContext} from './context';\nimport {button,esc,toolIcon} from './icons';\nexport class Hud{\n root:HTMLElement;lastEvent=0;lastWorld:object|null=null;line='';popTime=0;dramaTime=0;time=0;\n constructor(root:HTMLElement){this.root=root;root.innerHTML=\"'`<div class=\"hud-low\" id=\"hud-low\"></div><div class=\"gift-overlay\" data-game=\"gift-overlay\"></div><div class=\"hud-top\"><div class=\"vitals-block\"><div class=\"hud-label\">VITAL SIGNS / <span data-game=\"patient-label\"></span></div><div class=\"vitals-number\"><span data-game=\"vitals\">70</span><small data-game=\"bpm\">78 BPM</small></div><svg class=\"ecg\" data-game=\"ecg\" viewBox=\"0 0 400 48\" preserveAspectRatio=\"none\"><path data-game=\"ecg-path\"/></svg><div class=\"vitals-bar\"><i data-game=\"vitals-fill\"></i></div></div><div class=\"clock-block\"><div class=\"hud-label\" data-game=\"case-label\"></div><div class=\"clock-value\" data-game=\"clock\"></div><div class=\"phase-name\" data-game=\"phase\"></div><div class=\"small\" data-game=\"phase-index\"></div></div><div class=\"score-block\"><div class=\"hud-label\">PROCEDURE SCORE</div><div class=\"score-value\" data-game=\"score\"></div><div class=\"chain\" data-game=\"chain\"></div><div class=\"small\" data-game=\"slips\"></div></div></div><div class=\"gift-banner\" data-game=\"gift\"></div><div class=\"site-tabs\" data-game=\"sites\"></div><div class=\"odie-box\"><svg class=\"odie-avatar\" viewBox=\"0 0 60 70\"><path d=\"M12 68V45c0-10 36-10 36 0v23\" fill=\"#1f4650\"/><ellipse cx=\"30\" cy=\"24\" rx=\"17\" ry=\"21\" fill=\"#a47d62\"/><path d=\"M12 22c-4-28 39-27 36 1L38 12 19 14Z\" fill=\"#b9b9a8\"/><path d=\"M18 42h24l-3 13H22Z\" fill=\"#6c9292\"/><path d=\"M22 26h4m8 0h4\" stroke=\"#182b35\" stroke-width=\"3\"/></svg><div><div class=\"speaker\">ODIE / CHARGE NURSE</div><p data-game=\"hint\"></p></div></div><div class=\"rating-pop\" data-game=\"rating\"></div><div class=\"tool-bar\" aria-label=\"Surgical instruments\">${TOOLS.map((t,i)=>`<button data-tool=\"${i}\" class=\"tool-button\" aria-label=\"${t}\"><span class=\"tool-key\">${i+1}</span>${toolIcon(i)}<span class=\"tool-name\">${t}</span></button>`).join('\"'')}</div><div class=\\\"selected-tool\\\"><strong data-game=\\\"tool-name\\\"></strong><p data-game=\\\"tool-help\\\"></p></div><div class=\\\"charge-panel\\\" data-game=\\\"syringe-panel\\\"><div class=\\\"hud-label\\\">STABILIZER / RELEASE IN GREEN</div><div class=\\\"charge-bar\\\"><span class=\\\"green\\\"></span><i data-game=\\\"syringe-fill\\\"></i></div></div><div data-game=\\\"context\\\"></div><footer class=\\\"op-footer\\\"><span data-game=\\\"prompts\\\"></span><button data-action=\\\"pause\\\" aria-label=\\\"Pause operation\\\">Ⅱ <span data-game=\\\"pause-prompt\\\">ESC</span> · Pause</button></footer>\"'`;}\n el(name:string):HTMLElement{return this.root.querySelector(`[data-game=\"${name}\"]`)!;}\n frame(c:UIContext,s:Operation,dt:number,world:object):void{\n  this.time+=dt;if(this.lastWorld!==world){this.lastWorld=world;this.lastEvent=0;this.line=s.hint;}\n  const cs=getCase(s.caseId),p=s.seats[0],v=s.patients.length>1?s.patients[p.site]:s.patients[0],pad=c.hands.lastDevice==='\"'gamepad',xbox=c.prefs.glyphs==='Xbox';\n  this.el('vitals').textContent=String(Math.max(0,Math.round(v)));this.el('vitals-fill').style.width=\"'`${Math.max(0,v)}%`;this.el('\"'bpm').textContent=s.code?'ASYSTOLE':\"'`${heartRate(s)} BPM`;\n  this.el('\"'patient-label').textContent=cs.patient.toUpperCase();this.el('case-label').textContent=\"'`CASE ${cs.id==='\"'gala-shift'?'TEAM':String(c.d.caseIndex+1).padStart(2,'0')} / \"'${cs.title.toUpperCase()}`;\n  this.el('\"'clock').textContent=\"'`${Math.floor(s.left/360000)}:${String(Math.ceil(s.left/6000)%60).padStart(2,'\"'0')}\"'`;this.el('\"'phase').textContent=cs.phases[s.phase].title;this.el('phase-index').textContent=\"'`PHASE ${s.phase+1} OF ${cs.phases.length}`;\n  this.el('\"'score').textContent=s.score.toLocaleString('en');this.el('chain').textContent=\"'`×${s.chain.toFixed(1)} CHAIN`;this.el('\"'slips').textContent=\"'`${s.slips} SLIPS`;\n  this.el('\"'tool-name').textContent=TOOLS[p.tool];this.el('tool-help').textContent=HELP[TOOLS[p.tool]][0];\n  for(const b of this.root.querySelectorAll<HTMLButtonElement>('[data-tool]'))b.classList.toggle('active',Number(b.dataset.tool)===p.tool);\n  const events=s.events.filter(e=>e.n>this.lastEvent);\n  for(const e of events){this.lastEvent=e.n;if(['say','hint','phase','refusal'].includes(e.type)){this.line=e.type==='phase'?s.hint:e.text;if(e.type\"'!=='\"'refusal')c.sound.say('odie',this.line,c.prefs);}if(e.type==='rating'){this.el('rating').textContent=e.text;this.popTime=this.time+1;}if(e.type==='drama'&&c.prefs.flashes){const d=document.getElementById('drama')\"'!;d.querySelector('\"'b')\"'!.textContent=e.text;d.classList.add('\"'show');this.dramaTime=this.time+.8;}}\n  this.el('hint').textContent=this.line;this.el('rating').classList.toggle('show',this.popTime>this.time);if(this.dramaTime<this.time)document.getElementById('drama')?.classList.remove('show');\n  const active=s.seats.find(q=>q.giftUntil>s.tick),overlay=this.el('gift-overlay');overlay.className=\"'`gift-overlay ${active?active.giftKind==='\"'still'?'still':'pulse':''}\"'`;this.el('\"'gift').textContent=active?\"'`${active.giftKind==='\"'still'?'STILLPOINT':'SECOND PULSE'} · \"'${Math.ceil((active.giftUntil-s.tick)/60)}s`:p.gift>0?`${pad?xbox?'\"'Y':'△':'SPACE'} · \"'${p.giftKind==='\"'pulse'?'SECOND PULSE':'STILLPOINT'} READY\"'`:'\"'';\n  this.el('syringe-panel').style.display=p.tool===5?'block':'none';this.el('syringe-fill').style.width=\"'`${Math.min(100,p.charge*100)}%`;\n  const sites=this.el('\"'sites'),siteHTML=cs.sites.length>1?cs.sites.map((name,i)=>\"'`<button data-site=\"${i}\" class=\"${i===p.site?'\"'active':''} \"'${s.targets.some(t=>!t.done&&t.site===i&&t.kind==='\"'wound')?'danger':''}\\\">\"'${esc(name)}<small>${s.patients.length>1?`${Math.round(s.patients[i])} VITALS`:s.targets.filter(t=>!t.done&&t.site===i&&t.required).length+'\"' TARGETS'}</small></button>\"'`).join('\"''):'';if(sites.innerHTML\"'!==siteHTML)sites.innerHTML=siteHTML;\n  this.el('\"'prompts').innerHTML=pad?\"'`<span class=\"glyph\">${xbox?'\"'RT':'R2'}</span> Use <span class=\\\"glyph\\\">RS</span> Tools <span class=\\\"glyph\\\">\"'${xbox?'\"'X':'□'}</span> Syringe <span class=\\\"glyph\\\">↑</span> Hint\"'`:'\"'<kbd>LMB</kbd> Use <kbd>RMB</kbd> Tool radial <kbd>F</kbd> Syringe <kbd>H</kbd> Hint';this.el('pause-prompt').textContent=pad?'OPTIONS':'ESC';\n  let context='';if(s.code)context=\"'`<section class=\"code-panel\"><div class=\"eyebrow\">CODE BLUE / TWO CHANCES</div><h2>Bring them back.</h2><div class=\"charge-bar\"><span class=\"green\"></span><i style=\"width:${shockLevel(s)*100}%\"></i></div><p>${pad?'\"'L2 + R2':'LMB + RMB'} together when the charge is in green.</p><p class=\\\"gold\\\">\"'${Math.max(0,Math.ceil((s.code.until-s.fieldTicks)/6000))} seconds · ${2-s.code.tries} shocks</p></section>`;\n  else if(p.pulseAt){const beat=(s.tick%beatPeriod(s))/beatPeriod(s);context=`<section class=\"pulse-panel\"><div class=\"eyebrow\">PULSE-LOCK</div><h3>Match the next three beats.</h3><div class=\"pulse-beats\">${'\"'●'.repeat(p.beats)}\"'${'\"'○'.repeat(3-p.beats)}</div><div class=\\\"charge-bar\\\"><i style=\\\"width:\"'${beat*100}%\"></i></div><p class=\"small\">${pad?xbox?'\"'Y':'△':'SPACE'} on the ECG peak</p></section>\"'`;}\n  this.el('\"'context').innerHTML=context;\n  const lull=s.targets.some(t=>\"'!t.done&&t.kind==='\"'lull');this.el('ecg').classList.toggle('dim',lull);const path:string[]=[];for(let x=0;x<=400;x+=3){const cycle=(x/400*3+s.fieldTicks/6000*heartRate(s)/60)%1;const y=s.code?25:25-(cycle>.14&&cycle<.18?30:cycle>.18&&cycle<.22?-15:cycle>.08&&cycle<.12?5:0);path.push(\"'`${x===0?'\"'M':'L'}\"'${x} ${y}`);}this.el('\"'ecg-path').setAttribute('d',path.join(' '));document.body.classList.toggle('low',v<25);\n }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/devActions.ts <<'EOF'\n/** @file Developer button dispatch, copying authored paths and recorded inputs without a server. */\nimport type {UIContext} from './context';\nimport type {DevView} from './dev';\nimport {CASES,SESSION} from '../data/cases';\nimport {KINDS} from '../data/tools';\nimport {BALANCE} from '../data/balance';\nexport async function copyText(text:string):Promise<void>{try{await navigator.clipboard.writeText(text);}catch{const area=document.createElement('textarea');area.value=text;area.style.cssText='position:absolute;left:10%;top:25%;width:80%;height:35%;z-index:999;font-size:20px;background:#102e35;color:#dcebdc';document.body.append(area);area.focus();area.select();area.addEventListener('blur',()=>area.remove(),{once:true});}}\nexport function developerAction(c:UIContext,d:DevView,id:string):boolean{\n const cs=[...CASES,SESSION][d.caseIndex];\n if(id.startsWith('dev-tab:')){d.tab=Number(id.split(':')[1]);d.page=0;}\n else if(id==='dev-prev')d.page=(d.page+(d.tab===1?6:3))%(d.tab===1?7:4);\n else if(id==='dev-next')d.page=(d.page+1)%(d.tab===1?7:4);\n else if(id==='dev-case-prev'||id==='dev-case-next'){d.caseIndex=(d.caseIndex+(id.endsWith('prev')?8:1))%9;d.phase=0;}\n else if(id==='dev-phase-prev'||id==='dev-phase-next')d.phase=(d.phase+(id.endsWith('prev')?cs.phases.length-1:1))%cs.phases.length;\n else if(id==='dev-jump'){c.d.caseIndex=d.caseIndex;c.set('game.autoplay',false);c.d.start(d.phase);}\n else if(id.startsWith('dev-act:'))c.act('surgery-control',{command:id.split(':')[1]});\n else if(id.startsWith('dev-toggle:')){const k='game.'+id.split(':')[1];c.set(k,\"'!c.get(k));}\n else if(id.startsWith('\"'dev-view:')){const k=id.split(':')[1] as 'hideHud'|'shapes'|'assist'|'freeCamera';d[k]=\"'!d[k];if(k==='\"'hideHud')document.getElementById('hud')\"'!.style.visibility=d.hideHud?'\"'hidden':'visible';if(k==='freeCamera')(c.engine()?.inspector.camera as {set:(code:string)=>void})?.set(d.freeCamera?'cam3=fly':'cam3=fixed,0,15,-5,0,-72,42');}\n else if(id==='dev-look'){d.look=1-d.look;c.set('post.look',d.look?'look:harbor':'look:field');}\n else if(id==='dev-step')c.engine()?.inspector.step(1);\n else if(id==='dev-spawn-prev'||id==='dev-spawn-next')d.spawn=(d.spawn+(id.endsWith('prev')?KINDS.length-1:1))%KINDS.length;\n else if(id==='dev-spawn'){const p=c.hands.seats[0];c.act('surgery-spawn',{kind:KINDS[d.spawn],x:p[0],z:p[1],site:p[6]});}\n else if(id==='dev-seed'){d.seed++;c.engine()?.inspector.seed(d.seed);}\n else if(id==='dev-unlock'){c.d.progress.unlocked=8;c.d.progress.ended=true;c.save();}\n else if(id==='dev-author'){d.author=true;d.path=[];c.d.go('op');}\n else if(id==='dev-copy-path')void copyText(JSON.stringify(d.path));\n else if(id==='dev-copy-replay'){const input=c.engine()?.inspector.input as {record:()=>unknown};void copyText(JSON.stringify(input?.record(),null,2));}\n else if(id.startsWith('balance-reset:')){const k=id.split(':')[1];c.set(\"'`game.${k}`,BALANCE[k][0]);}\n else if(id==='\"'balance-reset-all')for(const [k,[value]] of Object.entries(BALANCE))c.set(\"'`game.${k}`,value);\n else return false;\n return true;\n}\nEOF\ncat > labs/game/ui/index.ts <<'\"'EOF'\n/** @file UI flow and common controller/mouse focus; every screen shares the same large interactive elements. */\nimport type {UIContext} from './context';\nimport type {Screen} from '../app/director';\nimport type {Preferences} from '../app/settings';\nimport {getCase} from '../data/cases';\nimport {TOOLS} from '../data/tools';\nimport {about,aboutCards,handbook,postcards} from './reference';\nimport {settingPage,cyclePreference} from './settings';\nimport {devPage,newDevView} from './dev';\nimport {developerAction} from './devActions';\nimport {Hud} from './hud';\nimport * as pages from './pages';\nexport class GameUI{\n c:UIContext;root:HTMLElement;hud:Hud;revision=-1;ref=0;settingsTab=0;rebindPage=0;dev=newDevView();rebinding=false;returnTo:Screen='title';\n constructor(c:UIContext){this.c=c;this.root=document.getElementById('panels')\"'!;this.hud=new Hud(document.getElementById('\"'hud')\"'!);\n  document.getElementById('\"'app')\"'!.addEventListener('\"'click',e=>{const target=e.target as Element,tool=target.closest<HTMLElement>('[data-tool]'),site=target.closest<HTMLElement>('[data-site]'),action=target.closest<HTMLElement>('[data-action]');if(tool){c.hands.seats[0][2]=Number(tool.dataset.tool);return;}if(site){c.hands.seats[0][6]=Number(site.dataset.site);return;}if(action&&\"'!action.hasAttribute('\"'disabled'))this.action(action.dataset.action\"'!);});\n  this.root.addEventListener('\"'pointerover',e=>{const button=(e.target as Element).closest<HTMLElement>('[data-focus]');if(button)button.focus({preventScroll:true});});\n  this.root.addEventListener('input',e=>{const el=e.target as HTMLInputElement;if(el.dataset.pref){const key=el.dataset.pref as keyof Preferences;Object.assign(c.prefs,{[key]:Number(el.value)});if(key==='cursorSpeed')c.set('game.cursorSpeed',Number(el.value));c.save();}if(el.dataset.balance)c.set('game.'+el.dataset.balance,Number(el.value));if(el.hasAttribute('data-timescale'))c.engine()?.inspector.timeScale(Number(el.value));const out=el.parentElement?.querySelector('output');if(out)out.textContent=Number(el.max)===1?Math.round(Number(el.value)*100)+'%':Number(el.value).toFixed(2);});\n }\n open(screen:Screen):void{this.returnTo=this.c.d.screen;this.ref=0;this.c.d.go(screen);}\n render(force=false):void{\n  const c=this.c,d=c.d;if(\"'!force&&this.revision===d.revision)return;this.revision=d.revision;this.root.dataset.game=d.screen;document.body.dataset.screen=d.screen;\n  const renderers:Partial<Record<Screen,()=>string>>={title:()=>pages.title(c),board:()=>pages.board(c),story:()=>pages.story(c),briefing:()=>pages.briefing(c),debrief:()=>pages.result(c),failed:()=>pages.result(c),postcard:()=>pages.postcard(c),pause:()=>pages.pause(c),scrub:()=>pages.scrub(c),credits:pages.credits,about:()=>about(this.ref),handbook:()=>handbook(c,this.ref),postcards:()=>postcards(c,this.ref),settings:()=>settingPage(c,this.settingsTab,this.rebindPage),dev:()=>devPage(c,this.dev)};\n  this.root.innerHTML=renderers[d.screen]?.()??'\"'';\n  const first=this.root.querySelector<HTMLElement>('[data-focus]:not(:disabled)');first?.focus({preventScroll:true});\n }\n menu(code:string):void{\n  if(this.rebinding)return;const d=this.c.d;\n  if(code==='Escape'){if(d.screen==='story')return;this.action('back');return;}\n  if(code==='KeyT'){if(d.screen==='story'){this.action('skip');return;}}\n  if(d.screen==='story'&&(code==='Enter'||code==='Space')){this.action('advance');return;}\n  const elements=[...this.root.querySelectorAll<HTMLElement>('[data-focus]:not(:disabled)')],focused=document.activeElement as HTMLElement,index=elements.indexOf(focused);\n  if(code==='Enter'){focused?.click();return;}\n  if(code==='ArrowUp'||code==='ArrowDown'){const next=(index+(code==='ArrowDown'?1:elements.length-1))%elements.length;elements[next]?.focus({preventScroll:true});}\n  if(code==='ArrowLeft'||code==='ArrowRight'){\n   if(focused instanceof HTMLInputElement&&focused.type==='range'){focused.value=String(Number(focused.value)+(code==='ArrowRight'?1:-1)*Number(focused.step||.1));focused.dispatchEvent(new Event('input',{bubbles:true}));}\n   else if(d.screen==='board')this.action(code==='ArrowRight'?'case-next':'case-prev');\n   else if(['about','handbook','postcards'].includes(d.screen))this.action(code==='ArrowRight'?'ref-next':'ref-prev');\n  }\n }\n action(id:string):void{\n  const c=this.c,d=c.d;c.sound.audio.play('sfx:hl-clack',{vol:.18});\n  if(developerAction(c,this.dev,id)){this.render(true);return;}\n  if(id==='new'){d.newShift();}\n  else if(id==='continue'){const cp=d.progress.checkpoint;d.caseIndex=cp?.caseIndex??Math.min(7,d.progress.unlocked-1);d.free=false;if(cp)d.start(cp.phase);else d.story('before');}\n  else if(id==='board'){this.dev.author=false;d.go('board','title');}\n  else if(['settings','about','handbook','scrub','dev','postcards'].includes(id)){if(id==='dev'){this.dev.caseIndex=d.caseIndex;this.dev.phase=c.state()?.phase??0;}this.open(id as Screen);}\n  else if(id==='case-next'||id==='case-prev'){d.caseIndex=(d.caseIndex+(id==='case-next'?1:8))%9;this.render(true);}\n  else if(id==='case-play'){d.free=true;d.go('briefing');}\n  else if(id.startsWith('difficulty:')){c.prefs.difficulty=id.split(':')[1] as Preferences['difficulty'];c.save();this.render(true);}\n  else if(id==='operate'){d.start();}\n  else if(id==='advance'){d.advanceStory();}\n  else if(id==='skip'){d.skipStory();}\n  else if(id==='next-result'){d.continueResult();}\n  else if(id==='pause'){this.pause();}\n  else if(id==='resume'){this.dev.author=false;c.engine()?.inspector.resume();d.go('op');}\n  else if(id==='retry'){d.start();}\n  else if(id==='retry-phase'){d.start(c.state()?.phase??d.last?.phase??0);}\n  else if(id==='scrub-start'){d.go('board','title');}\n  else if(id==='back'){\n   if(d.screen==='op'){this.pause();return;}\n   if(d.screen==='pause'){this.action('resume');return;}\n   if(d.screen==='board'||d.screen==='credits')d.go('title','title');\n   else if(d.screen==='briefing')d.go('board','title');\n   else{d.go(this.returnTo);if(this.returnTo==='op')c.engine()?.inspector.resume();}\n  }\n  else if(id==='ref-prev'||id==='ref-next'){const count=d.screen==='about'?aboutCards.length:d.screen==='postcards'?Math.max(1,Object.keys(d.progress.postcards).length):12+Math.max(0,Math.min(5,d.progress.unlocked-3));this.ref=(this.ref+(id==='ref-next'?1:count-1))%count;this.render(true);}\n  else if(id.startsWith('settings-tab:')){this.settingsTab=Number(id.split(':')[1]);this.render(true);}\n  else if(id.startsWith('pref:')){cyclePreference(c,id.split(':')[1] as keyof Preferences);this.render(true);}\n  else if(id.startsWith('bind:')){this.rebinding=true;const action=id.split(':')[1],input=c.engine()?.input;this.root.querySelector('h2')\"'!.textContent='\"'Press a new key or button…';if(input)void input.listen(c.hands.lastDevice==='gamepad'?'gamepad':'keyboard').then(code=>{if(code)input.bindingsFor('actionMap:surgeon').rebind(action,code);this.rebinding=false;this.render(true);});}\n  else if(id==='bind-reset'){c.engine()?.input.bindingsFor('actionMap:surgeon').reset();this.render(true);}\n  else if(id==='bind-prev'||id==='bind-next'){this.rebindPage=(this.rebindPage+(id==='bind-next'?1:4))%5;this.render(true);}\n  c.save();this.render();\n }\n pause():void{\n  if(this.dev.author){this.dev.author=false;this.c.d.go('dev');return;}\n  if(this.c.d.screen==='pause'){this.action('resume');return;}\n  this.c.engine()?.inspector.pause();this.c.d.go('pause');this.render();\n }\n radial():void{\n  const r=this.c.hands.radial,el=document.getElementById('radial')\"'!;\n  if(!r){el.classList.remove('\"'open');return;}el.classList.add('open');el.style.left=\"'`${Math.min(innerWidth*.8,Math.max(innerWidth*.2,r.x))}px`;el.style.top=`${Math.min(innerHeight*.75,Math.max(innerHeight*.25,r.y))}px`;\n  el.innerHTML=`<div class=\"center\">${TOOLS[r.selected]}</div>${TOOLS.map((_,i)=>{const a=i*Math.PI/4-Math.PI/2;return `<button class=\"${i===r.selected?'\"'active':''}\\\" style=\\\"transform:translate(-50%,-50%) translate(\"'${Math.cos(a)*175}%,${Math.sin(a)*175}%)\" aria-label=\"${TOOLS[i]}\">${pages.page?'\"'':''}\"'${'\"''}</button>\"'`;}).join('\"'')}\"'`;\n }\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
