{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/op/bleeding.ts <<'EOF'\n/** @file Open wounds produce physical pools; an unseen site can hide its own work beneath blood. */\nimport type {Operation,Rules} from '../../data/types';\nimport {spawn} from './state';\nexport function bleed(s:Operation,r:Rules,delta:number):void{\n const dt=delta/6000;\n for(const wound of [...s.targets]){\n  if(wound.done||wound.kind\"'!=='\"'wound')continue;\n  let pool=s.targets.find(t=>t.kind==='pool'&&\"'!t.done&&t.dose===wound.id);\n  if(!pool&&s.fieldTicks-wound.born>60000&&wound.clip<s.fieldTicks){pool=spawn(s,{kind:'\"'pool',at:[wound.x,wound.z+.12],site:wound.site,radius:.8,required:false,hp:.25});pool.dose=wound.id;wound.clip=s.fieldTicks+60000;}\n  if(pool)pool.hp=Math.min(1.8,pool.hp+dt*.04*r.balance.bleedRate*(wound.deep?1.7:1));\n }\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/op/step.ts');s=p.read_text().replace(\\\"import { updateStrains }\\\", \\\"import { bleed } from './bleeding';\\\\nimport { updateStrains }\\\").replace('  updateStrains(s, r, delta);', '  updateStrains(s, r, delta);\\\\n  bleed(s,r,delta);');p.write_text(s)\np=Path('labs/game/view/field/hands.ts');s=p.read_text().replace(\\\"  const site = s.seats[0].site;\\\", \\\"  const site = s.seats[0].site;\\\\n  if(s.code){for(const side of [-1,1]){const x=side*2,z=1,h=fieldHeight(x,z,s);meshes.steel.ball(x,h+.15,z,.65,.15,.8,'#bdd2d3');meshes.glove.ball(x,h+.48,z+.3,.4,.25,.6,'#d4e2d7');meshes.steel.line([[x,h+.4,z],[x,h+.5,z+.7]],.17,'#35555f');meshes.glow.ring(x,h+.07,z,.88,.035,'#f2ce8c');}return;}\\\");p.write_text(s)\np=Path('labs/game/view/field/index.ts');s=p.read_text().replace('  drawTargets(s, blood);', \\\"  drawTargets(s, blood);\\\\n  if(s.status==='won'){const h=fieldHeight(0,0,s)+.12;meshes.glove.quad([-2,h,-1],[-2,h,1],[2,h,1],[2,h,-1],'#d8dccb');for(let i=0;i<9;i++)meshes.thread.line([[-1+i*.25,h+.01,-.8],[-1+i*.25,h+.01,.8]],.025,'#a4b2a7');}\\\");p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace('  frame = f;\\\\n  if (\"'!engine?.inspector) return;'\"', '  frame = f;\\\\n  if (\"'!engine?.inspector) return;'\"\\\\n  if(info?.server)return;');s=s.replace(\\\"  const session =\\\", \\\"  const session =\\\")\ns=s.replace(\\\"const session = info ? new Session(hub, info) : null;\\\", \\\"const session = info ? new Session(hub, info) : null;\\\\nif(info?.server){document.getElementById('app')\"'!.style.display='\"'none';document.querySelector<HTMLCanvasElement>('#view')\"'!.style.cssText='\"'position:fixed;width:1px;height:1px;inset:0';}\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
