{"type":"item.completed","item":{"id":"item_145","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/op/step.ts');s=p.read_text();a=s.index(\\\"      if (c.ai && c.id \"'!== '\"'struck-off') {\\\");b=s.index('\\\\n    if (\"'!s.code)'\"',a);print(s[a:b])\nPY\"","aggregated_output":"      if (c.ai && c.id !== 'struck-off') {\n        const other = s.seats.find((q) => q.id !== p.id);\n        if (other) {\n          [p.giftKind, other.giftKind] = [other.giftKind, p.giftKind];\n          [p.gift, other.gift] = [other.gift, p.gift];\n          event(s, 'say', p.giftKind === 'pulse' ? 'Sabine has the field.' : 'Wren has the field.');\n        }\n      }\n    }\n","exit_code":0,"status":"completed"}}
