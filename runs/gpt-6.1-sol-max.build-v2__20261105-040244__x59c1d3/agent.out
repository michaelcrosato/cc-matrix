th\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { storyFor } from './data/story';\\\", \\\"import {StoryView} from './app/storyView';\\\").replace('surgicalCue, storyCue','surgicalCue').replace(\\\"  storyClock = 0,\\\\n  storyKey = '',\\\\n\\\",'').replace('  skipHold = 0,\\\\n','');s=s.replace('const ui = new GameUI(context);', 'const ui = new GameUI(context);\\\\nconst storyView=new StoryView(context);').replace('  storyClock = 0;','  storyView.reset();')\na=s.index(\\\"  if (d.screen === 'story') {\\\");b=s.index('  sound.frame(',a);s=s[:a]+'  storyView.frame(f,attract);\\\\n'+s[b:];p.write_text(s)\nPY\nnpx prettier --write labs/game/main.ts labs/game/app/storyView.ts labs/game/data/story/index.ts labs/game/data/types.ts\nTMPDIR=/tmp/g.5ozaaka0 NODE_OPTIONS=--max-old-space-size=1536 npm run bundle\"","aggregated_output":"labs/game/main.ts 123ms\nlabs/game/app/storyView.ts 13ms\nlabs/game/data/story/index.ts 14ms\nlabs/game/data/types.ts 13ms\n\n> trauma-coast-second-sight@0.0.0 bundle\n> tsx labs/game/tools/one-file.mts\n\nBundled 6914956 characters\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_183","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"hands.playing = d.screen === 'op' && \"'!attract\", \"hands.playing = d.screen === '\"'op' && \"'!hands.touch && !attract\").replace('\"'  activeRun = runId;','  activeRun = runId;hands.radial=null;');p.write_text(s)\nPY\nrg -n 'mark|enum' labs/game/scenes/op/dev.ts\nwc -l labs/game/main.ts labs/game/input/hands.ts\nnpx prettier --write labs/game/main.ts\nTMPDIR=/tmp/g.5ozaaka0 NODE_OPTIONS=--max-old-space-size=1536 npm run bundle\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
