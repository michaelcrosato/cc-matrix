[-1+i*.25,h+.01,-.8],[-1+i*.25,h+.01,.8]],.025,'#a4b2a7');}\\\");p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace('  frame = f;\\\\n  if (\"'!engine?.inspector) return;'\"', '  frame = f;\\\\n  if (\"'!engine?.inspector) return;'\"\\\\n  if(info?.server)return;');s=s.replace(\\\"  const session =\\\", \\\"  const session =\\\")\ns=s.replace(\\\"const session = info ? new Session(hub, info) : null;\\\", \\\"const session = info ? new Session(hub, info) : null;\\\\nif(info?.server){document.getElementById('app')\"'!.style.display='\"'none';document.querySelector<HTMLCanvasElement>('#view')\"'!.style.cssText='\"'position:fixed;width:1px;height:1px;inset:0';}\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_126","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/op/tools.ts');s=p.read_text().replace(\\\"t.lift = clamp((p.start[1] - p.z) / 1.7, 0, 1);\\\", \\\"t.lift = clamp(Math.hypot(p.start[0]-p.x,p.start[1]-p.z) / 1.7, 0, 1);\\\")\ns=s.replace(\\\"  p.heat += 1 / 60;\\\\n  if (p.heat >= r.balance.laserHeat) {\\\\n    p.cooldown = 120;\\\\n    p.heat = 0;\\\\n    event(s, 'say', 'Laser overheated. Two seconds, Doctor.');\\\\n    return;\\\\n  }\\\\n\\\",'')\ns=s.replace(\\\"need * r.balance.strainHp * (1 + r.balance.coopHp * Math.max(0, s.humans - 1))\\\", \\\"need * (['lull','solace','reverie','mote'].includes(t.kind)?r.balance.strainHp*(r.difficulty==='Intern'?.75:r.difficulty==='Attending'?1.25:1)*(1+r.balance.coopHp*Math.max(0,s.humans-1)):1)\\\")\ns=s.replace(\\\"  if (\"'!held) p.heat = Math.max(0, p.heat - 2 / 60);\", \"  if (!held) p.heat = Math.max(0, p.heat - 2 / 60);'\"\\\\n  if(p.tool===4&&held){if(p.cooldown>0)return;p.heat+=1/60;if(p.heat>=r.balance.laserHeat){p.cooldown=120;p.heat=0;event(s,'say','Laser overheated. Two seconds, Doctor.');return;}}\\\")\ns=s.replace(\\\"      p.heat += 1 / 60;\\\\n      p.healthy++;\\\", \\\"      if(Math.hypot(p.start[0]-p.x,p.start[1]-p.z)>.3){p.healthy=0;p.start=[p.x,p.z];}\\\\n      p.healthy++;\\\")\np.write_text(s)\np=Path('labs/game/scenes/strains/index.ts');s=p.read_text().replace('const age = (s.fieldTicks - t.born) / 6000;', \\\"const age = (s.fieldTicks - t.born) / 6000*r.balance.strainSpeed*(r.difficulty==='Intern'?.75:r.difficulty==='Attending'?1.25:1);\\\");p.write_text(s)\np=Path('labs/game/data/balance.ts');s=p.read_text().replace(\\\"  'game.phase': {\\\", \\\"  'game.retry':{type:'boolean',default:false,when:'scene',description:'Checkpoint retry caps rank at B.'},\\\\n  'game.phase': {\\\");p.write_text(s)\np=Path('labs/game/scenes/main.ts');s=p.read_text().replace('      w.spawn({ operation: { data: s } });', \\\"      s.retry ||= w.settings.get<boolean>('game.retry');\\\\n      w.spawn({ operation: { data: s } });\\\");p.write_text(s)\np=Path('labs/game/ui/index.ts');s=p.read_text().replace(\\\"else if (id === 'operate') {\\\\n      d.start();\\\", \\\"else if (id === 'operate') {\\\\n      c.set('game.retry',false);d.start();\\\").replace(\\\"else if (id === 'retry') {\\\\n      d.start();\\\", \\\"else if (id === 'retry') {\\\\n      c.set('game.retry',false);d.start();\\\").replace(\\\"else if (id === 'retry-phase') {\\\\n      d.start\\\", \\\"else if (id === 'retry-phase') {\\\\n      c.set('game.retry',true);d.start\\\");p.write_text(s)\np=Path('labs/game/scenes/op/state.ts');s=p.read_text().replace(\\\"rules.difficulty === 'Intern' ? 10 : rules.difficulty === 'Attending' ? 3 : rules.balance.slipLimit\\\", \\\"rules.balance.slipLimit\"'!==5?rules.balance.slipLimit:rules.difficulty === '\"'Intern' ? 10 : rules.difficulty === 'Attending' ? 3 : 5\\\");p.write_text(s)\nPY\nnpx prettier --write labs/game/scenes labs/game/ui/index.ts labs/game/data/balance.ts labs/game/data/types.ts labs/game/data/data.test.ts\nTMPDIR=/tmp/g.5ozaaka0 npx tsx labs/game/tools/record.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
