 3ms\nlabs/game/data/cases/helpers.ts 8ms (unchanged)\nlabs/game/data/cases/index.ts 10ms (unchanged)\nlabs/game/data/cases/it-moves.ts 2ms\nlabs/game/data/cases/mercy.ts 6ms\nlabs/game/data/cases/quiet-lump.ts 3ms\nlabs/game/data/cases/reverie.ts 3ms\nlabs/game/data/cases/struck-off.ts 2ms\nlabs/game/scenes/play.test.ts 16ms\nlabs/game/tools/calibrate.mts 4ms\npackage.json 7ms (unchanged)\n\n> trauma-coast-second-sight@0.0.0 check\n> node tools/checkAll.ts\n\nok   tsc (4.6 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\nok   eslint (3.2 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\n\n/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-040244__x59c1d3/work/Trauma-Coast-Second-Sight-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-040244/labs/game/main.ts\n  401:1  warning  File has too many lines (432). Maximum allowed is 400  max-lines\n\n✖ 1 problem (0 errors, 1 warning)\nFAIL prettier (11.6 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\nChecking formatting...\n[warn] labs/game/data/story/index.ts\n[warn] labs/game/data/types.ts\n[warn] Code style issues found in 2 files. Run Prettier with --write to fix.\nok   x check (1.6 s)\nx check: ok: 3 plugins: all pass\nassets: ok, 2243 files, 0 binary (0 approved, 0 fonts)\nengine: ok, my-3dge@6a1501f, 2137 files\nevals: ok, 0 tasks\nreport: out/check/all/report.json\ncheck: FAIL (prettier)\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_181","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/fallback.py <<'EOF'\n# Acceptance checks for unsupported WebGPU browsers and responsive phone/tablet/TV presentation.\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path.cwd()\nidentity=json.loads((root/'identity.json').read_text())\nurl=(root.parent/(identity['base']+'.html')).as_uri()\nout=root/'out'/'viewports';out.mkdir(parents=True,exist_ok=True)\nchecks=[]\ndef check(name,ok,detail=''):\n    item={'name':name,'ok':bool(ok),'detail':str(detail)};checks.append(item);print(json.dumps(item),flush=True)\nwith sync_playwright() as p:\n    for name,engine,device in [('Firefox',p.firefox,None),('WebKit phone',p.webkit,p.devices['iPhone 13']),('WebKit tablet',p.webkit,p.devices['iPad Pro 11'])]:\n        browser=None\n        try:\n            browser=engine.launch(headless=True)\n            context=browser.new_context(**(device or {'viewport':{'width':1440,'height':900}}))\n            page=context.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n            page.goto(url);page.locator('#compatibility').wait_for(timeout=20000)\n            check(name+' WebGPU explanation','needs a browser with WebGPU' in page.locator('#compatibility').inner_text())\n            if device:check(name+' hardware requirement','Controller or keyboard required' in page.locator('#compatibility').inner_text())\n            page.locator('#compat-settings').click();check(name+' fallback settings',page.locator('#compatibility h1').inner_text()=='Settings')\n            check(name+' has no import crash',len(errors)==0,' | '.join(errors))\n            page.screenshot(path=str(out/(name.lower().replace(' ','-')+'.png')))\n        except Exception as error:check(name+' fallback',False,error)\n        finally:\n            if browser:browser.close()\n    browser=None\n    try:\n        browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n        context=browser.new_context(viewport={'width':1920,'height':1080},device_scale_factor=1)\n        page=context.new_page();page.goto(url);page.wait_for_function('\"'!!window.__surgery && window.__engine.ready'\"',timeout=90000)\n        for name,width,height in [('small-phone',320,568),('phone',390,844),('foldable',673,841),('tablet',768,1024),('tablet-landscape',1024,768),('television',1920,1080),('wide',2560,1080),('ultrawide',3440,1440)]:\n            page.set_viewport_size({'width':width,'height':height});page.mouse.move(2,2);page.wait_for_timeout(150)\n            if width<700:page.evaluate(\\\"window.__surgery.ui.open('settings')\\\")\n            else:page.evaluate(\\\"window.__surgery.director.go('title','title')\\\")\n            page.wait_for_timeout(150)\n            overflow=page.evaluate('document.documentElement.scrollWidth>innerWidth+1')\n            check(name+' horizontal layout',not overflow)\n            if name in ['small-phone','tablet','television','ultrawide']:page.screenshot(path=str(out/(name+'.png')),timeout=60000)\n        check('packaged module is GPU guarded', 'if(\"'!globalThis.__unsupported)'\"' in (root.parent/(identity['base']+'.html')).read_text())\n    except Exception as error:check('viewport presentation',False,error)\n    finally:\n        if browser:browser.close()\n(root/'out'/'viewports'/'results.json').write_text(json.dumps(checks,indent=2)+'\\\\n')\nraise SystemExit(1 if any(not c['ok'] for c in checks) else 0)\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/tools/verify.mjs');s=p.read_text().replace(\\\"['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs']\\\", \\\"['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs','labs/game/tools/fallback.py']\\\").replace(\\\"const b = run('node', path);\\\", \\\"const b = run(path.endsWith('.py')?'python3':'node', path);\\\");p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"        ui.open('settings');\\\\n        gate.innerHTML\\\", \\\"        attractor.exit();ui.open('settings');\\\\n        gate.innerHTML\\\");p.write_text(s)\np=Path('labs/game/input/hands.ts');s=p.read_text().replace(\\\"if (e.pointerType === 'touch') return;\\\", \\\"if (e.pointerType === 'touch'){this.onActivity();return;}\\\");p.write_text(s)\np=Path('labs/game/ui/styles.css');s=p.read_text()+'''\\\\n@media(max-width:700px) and (orientation:portrait){.settings-rows{font-size:clamp(17px,4.2vw,28px)}.setting-row{min-height:56px}.tabs button{font-size:clamp(13px,3.5vw,18px);min-height:44px}.page h2{font-size:clamp(26px,8vw,48px)}}\\\\n.odie-box p{font-size:1em}.phase-name{font-size:1em}\\\\n''';p.write_text(s)\np=Path('labs/game/ui/reference.ts');s=p.read_text().replace('\"'${esc(card.body)}</p>'\"', \\\"\"'${esc(card.key==='\"'usage'?document.getElementById('usage-record')?.textContent??card.body:card.body)}</p>\\\");p.write_text(s)\nPY\nnpx prettier --write labs/game/tools/verify.mjs labs/game/main.ts labs/game/input/hands.ts labs/game/ui/styles.css labs/game/ui/reference.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_181","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/tools/fallback.py <<'EOF'\n# Acceptance checks for unsupported WebGPU browsers and responsive phone/tablet/TV presentation.\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path.cwd()\nidentity=json.loads((root/'identity.json').read_text())\nurl=(root.parent/(identity['base']+'.html')).as_uri()\nout=root/'out'/'viewports';out.mkdir(parents=True,exist_ok=True)\nchecks=[]\ndef check(name,ok,detail=''):\n    item={'name':name,'ok':bool(ok),'detail':str(detail)};checks.append(item);print(json.dumps(item),flush=True)\nwith sync_playwright() as p:\n    for name,engine,device in [('Firefox',p.firefox,None),('WebKit phone',p.webkit,p.devices['iPhone 13']),('WebKit tablet',p.webkit,p.devices['iPad Pro 11'])]:\n        browser=None\n        try:\n            browser=engine.launch(headless=True)\n            context=browser.new_context(**(device or {'viewport':{'width':1440,'height':900}}))\n            page=context.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n            page.goto(url);page.locator('#compatibility').wait_for(timeout=20000)\n            check(name+' WebGPU explanation','needs a browser with WebGPU' in page.locator('#compatibility').inner_text())\n            if device:check(name+' hardware requirement','Controller or keyboard required' in page.locator('#compatibility').inner_text())\n            page.locator('#compat-settings').click();check(name+' fallback settings',page.locator('#compatibility h1').inner_text()=='Settings')\n            check(name+' has no import crash',len(errors)==0,' | '.join(errors))\n            page.screenshot(path=str(out/(name.lower().replace(' ','-')+'.png')))\n        except Exception as error:check(name+' fallback',False,error)\n        finally:\n            if browser:browser.close()\n    browser=None\n    try:\n        browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n        context=browser.new_context(viewport={'width':1920,'height':1080},device_scale_factor=1)\n        page=context.new_page();page.goto(url);page.wait_for_function('\"'!!window.__surgery && window.__engine.ready'\"',timeout=90000)\n        for name,width,height in [('small-phone',320,568),('phone',390,844),('foldable',673,841),('tablet',768,1024),('tablet-landscape',1024,768),('television',1920,1080),('wide',2560,1080),('ultrawide',3440,1440)]:\n            page.set_viewport_size({'width':width,'height':height});page.mouse.move(2,2);page.wait_for_timeout(150)\n            if width<700:page.evaluate(\\\"window.__surgery.ui.open('settings')\\\")\n            else:page.evaluate(\\\"window.__surgery.director.go('title','title')\\\")\n            page.wait_for_timeout(150)\n            overflow=page.evaluate('document.documentElement.scrollWidth>innerWidth+1')\n            check(name+' horizontal layout',not overflow)\n            if name in ['small-phone','tablet','television','ultrawide']:page.screenshot(path=str(out/(name+'.png')),timeout=60000)\n        check('packaged module is GPU guarded', 'if(\"'!globalThis.__unsupported)'\"' in (root.parent/(identity['base']+'.html')).read_text())\n    except Exception as error:check('viewport presentation',False,error)\n    finally:\n        if browser:browser.close()\n(root/'out'/'viewports'/'results.json').write_text(json.dumps(checks,indent=2)+'\\\\n')\nraise SystemExit(1 if any(not c['ok'] for c in checks) else 0)\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/tools/verify.mjs');s=p.read_text().replace(\\\"['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs']\\\", \\\"['labs/game/tools/e2e.mjs', 'labs/game/tools/hub.mjs','labs/game/tools/fallback.py']\\\").replace(\\\"const b = run('node', path);\\\", \\\"const b = run(path.endsWith('.py')?'python3':'node', path);\\\");p.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"        ui.open('settings');\\\\n        gate.innerHTML\\\", \\\"        attractor.exit();ui.open('settings');\\\\n        gate.innerHTML\\\");p.write_text(s)\np=Path('labs/game/input/hands.ts');s=p.read_text().replace(\\\"if (e.pointerType === 'touch') return;\\\", \\\"if (e.pointerType === 'touch'){this.onActivity();return;}\\\");p.write_text(s)\np=Path('labs/game/ui/styles.css');s=p.read_text()+'''\\\\n@media(max-width:700px) and (orientation:portrait){.settings-rows{font-size:clamp(17px,4.2vw,28px)}.setting-row{min-height:56px}.tabs button{font-size:clamp(13px,3.5vw,18px);min-height:44px}.page h2{font-size:clamp(26px,8vw,48px)}}\\\\n.odie-box p{font-size:1em}.phase-name{font-size:1em}\\\\n''';p.write_text(s)\np=Path('labs/game/ui/reference.ts');s=p.read_text().replace('\"'${esc(card.body)}</p>'\"', \\\"\"'${esc(card.key==='\"'usage'?document.getElementById('usage-record')?.textContent??card.body:card.body)}</p>\\\");p.write_text(s)\nPY\nnpx prettier --write labs/game/tools/verify.mjs labs/game/main.ts labs/game/input/hands.ts labs/game/ui/styles.css labs/game/ui/reference.ts\"","aggregated_output":"labs/game/tools/verify.mjs 44ms\nlabs/game/main.ts 114ms\nlabs/game/input/hands.ts 58ms\nlabs/game/ui/styles.css 140ms\nlabs/game/ui/reference.ts 23ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_182","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/app/storyView.ts <<'EOF'\n/** @file Story presentation: voiced captions, native portrait framing, Drama Cuts, auto mode and hold-to-skip. */\nimport type {EngineFrame} from '../../../engine';\nimport type {UIContext} from '../ui/context';\nimport {storyFor} from '../data/story';\nimport {storyCue} from '../view/camera';\nexport class StoryView{\n c:UIContext;clock=0;key='';skipHold=0;\n constructor(c:UIContext){this.c=c;}\n reset():void{this.clock=0;this.key='';this.skipHold=0;}\n frame(f:EngineFrame,attract:boolean):void{\n  const {d,prefs,hands,sound}=this.c,engine=this.c.engine();if(d.screen\"'!=='\"'story'||\"'!engine?.inspector)return;\n  const story=storyFor(d.caseIndex,d.part),beat=story.beats[d.beat]??story.beats[0],key=`${story.id}/${d.beat}`;\n  (engine.inspector.input as {axis:(key:string,value:unknown)=>void}).axis('\"'game:beat',d.beat);\n  if(key\"'!==this.key){this.key=key;this.clock=0;sound.say(beat.who,beat.text,prefs);sound.theme(beat.who==='\"'voss'?'jingle':'story');\n   const cast=[...new Set(story.beats.map(b=>b.who))],x=-3.5+cast.indexOf(beat.who)*1.45;\n   Object.assign(storyCue,{x:x+.8,y:1.9,z:.1,yaw:-12,pitch:-4,roll:beat.drama&&prefs.flashes?-.1:0});\n   if(beat.drama&&prefs.flashes){const el=document.getElementById('drama')\"'!;el.querySelector('\"'b')\"'!.textContent=beat.drama;el.classList.add('\"'show');setTimeout(()=>el.classList.remove('show'),800);}\n  }\n  this.clock+=f.dt;if(attract&&this.clock>2){d.beat=(d.beat+1)%story.beats.length;d.revision++;this.clock=0;}else if(prefs.auto&&this.clock>Math.max(2,beat.text.length*.045)/prefs.textSpeed)d.advanceStory();\n  const held=Array.from(navigator.getGamepads?.()??[]).some(p=>p?.buttons[1]?.pressed);this.skipHold=hands.keys.has('Escape')||held?this.skipHold+f.dt:0;if(this.skipHold>.75){this.skipHold=0;d.skipStory();}\n }\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { storyFor } from './data/story';\\\", \\\"import {StoryView} from './app/storyView';\\\").replace('surgicalCue, storyCue','surgicalCue').replace(\\\"  storyClock = 0,\\\\n  storyKey = '',\\\\n\\\",'').replace('  skipHold = 0,\\\\n','');s=s.replace('const ui = new GameUI(context);', 'const ui = new GameUI(context);\\\\nconst storyView=new StoryView(context);').replace('  storyClock = 0;','  storyView.reset();')\na=s.index(\\\"  if (d.screen === 'story') {\\\");b=s.index('  sound.frame(',a);s=s[:a]+'  storyView.frame(f,attract);\\\\n'+s[b:];p.write_text(s)\nPY\nnpx prettier --write labs/game/main.ts labs/game/app/storyView.ts labs/game/data/story/index.ts labs/game/data/types.ts\nTMPDIR=/tmp/g.5ozaaka0 NODE_OPTIONS=--max-old-space-size=1536 npm run bundle\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
