)\np='labs/game/scenes/events/line.ts';s=open(p).read()\ns=s.replace(\"e.wobble.vx += (left ? -1 : 1) * gameNumber(w, 'game.line.stepKick');\",\"e.wobble.vx += (left ? -1 : 1) * gameNumber(w, 'game.line.stepKick') * 2.2;\")\ns=s.replace(\"const ready = Math.abs(e.wobble.x) < (skill.name === 'perfect' ? 0.5 : 0.35);\",\"const ready = Math.abs(e.wobble.x) < (skill.name === 'perfect' ? 0.35 : skill.name === 'human' ? 0.5 : 0.7);\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/plunge.ts';s=open(p).read()\ns=s.replace(\"\"\"    const goal = 540;\n    const left = goal - d.rot;\n    const twist = Math.abs(d.twist) < 170 ? 1 : 0;\n    const k = skill.name === 'sloppy' ? 1 / 120 : skill.name === 'human' ? 1 / 90 : 1 / 12;\n    return { stick: [twist, clamp(left * k, -1, 1)], raw: skill.name === 'perfect' };\"\"\",\"\"\"    // the thumb reads the spin late, so it overshoots the way a person does\n    const late = skill.delay;\n    const hist = (d as unknown as { hist: number[] }).hist;\n    hist.push(d.rot);\n    while (hist.length > late + 1) hist.shift();\n    const left = 540 - hist[0];\n    const twist = Math.abs(d.twist) < 170 ? 1 : 0;\n    const k = skill.name === 'perfect' ? 1 / 12 : 1 / 60;\n    return { stick: [twist, clamp(left * k, -1, 1)], raw: skill.name === 'perfect' };\"\"\")\ns=s.replace(\"Object.assign(d, { power: 0, timing: 0, rot: 0, twist: 0, fill: 0, slip: false, gauge: 0, cards: [] });\",\"Object.assign(d, { power: 0, timing: 0, rot: 0, twist: 0, fill: 0, slip: false, gauge: 0, cards: [], hist: [] });\")\ns=s.replace(\"lastEntry: 0, gauge: 0 });\",\"lastEntry: 0, gauge: 0, hist: [] });\")\nopen(p,'w').write(s)\nE\ncat >> ../PROGRESS.md <<'E'\n- [x] 1 workspace in dev folder; hub files fetched to labs/game/hub (client sha differs from plan: 6ab6be43…, use fetched)\n- [x] sim written: settings, types, wobble, bots, all events/*, flow, pilot, director, island, round, props/index.ts, builds, cast/clips\n- balance table: `WT_SEEDS=1 npx vitest run labs/game/scenes/balance.test.ts -t meets` -> out/balance.json\n- [ ] next: page (main.ts, ui/*, audio/*, bodies/*, materials, looks, cameras), onefile, verify.mjs, hub test, lines (200+), about-data, README, ENGINE-FEEDBACK, exit-interview.json\n- Calls: moving props have no body (write sceneProp pose directly); stage camera `cam3=stage` driven by page shot table.\nE\nWT_SEEDS=2 WT_ONLY=reps,plunge,line,pond,pondS timeout 280 npx vitest run labs/game/scenes/balance.test.ts -t \"meets\" 2>&1 | grep -E \"Error:\" | cut -c1-200 | head; cat out/balance.json | tr -d '\\n ' | cut -c1-900;echo; grep -n \"defineSky\\|createAudio\\|volume\\|createDialog\" labs/box/sounds/page.ts | head -12 | cut -c1-140; grep -n \"export interface Audio \" -A50 engine/audio/runtime.ts 2>/dev/null | grep -v \"\\*\" | cut -c1-120 | head -30; ls engine/audio; grep -n \"export function createStore\" -A14 engine/app/store.ts | cut -c1-120; grep -n \"export interface Store\" -A18 engine/app/store.ts | grep -v '\\*' | cut -c1-100","description":"Add builds, tune reps/line/plunge, read audio & store APIs","timeout":320000}}}
