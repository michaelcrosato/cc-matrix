{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YNJEGHWM5fQsFGVgwZjeGW","type":"tool_result","content":"/**\n * @file Scenes, sim-side (PLAN.md §6.9, §9.0, WP 1.5; doctrines: Reproducible, Agent-operable):\n * `defineScene(id, { level?, settings, setup, step })` registers a scene as an entry of the registry kind `scene`;\n * `startScene` makes its world (a settings store with the scene's settings over the defaults and the caller's over\n * those, a world seeded from the seed, the scene's `step` as the system `scene`, then its `setup`). A session\n * (engine/sim/session.ts `createSession`) starts one that records its inputs. The kernel fixture, the box's scenes and\n * `createHeadless` (WP 1.6) all start scenes here, so no scene imports `app/`; engine/sim/replay.ts plays them.\n *\n * A scene is game code: `setup(w)` spawns, adds systems and listeners (inside `w.run`, so under the fdlibm swap);\n * `step(w, intents)` runs every sim step as the system `scene`, first in the phase `intents`, ahead of the systems\n * setup adds there; `actions` are its dev actions, `(w, args) => void` by name (WP 5.6 adds the engine's own).\n * `level` names the level it loads (WP 2.2 compiles it), `terrain` its ground (WP 10.5, engine/world/terrain.ts) and\n * `site` the levels standing on a terrain (WP 13.15, engine/world/site.ts): the view draws them; its setup adds their\n * bodies. `physics: true` gives it a physics world (physicsOf, WP 3.1).\n * `sounds(record, w)` says which sound a traced sim event plays, `{ sfx, vol?, variant? }`, a list of them (a shot and\n * where it strikes, WP 13.22) or null, for `x audio --replay` (WP 9.4): by default the event payload's own\n * (`payloadSound`); a game that maps its events to sounds sets its map here, so Node hears what its pages play (after\n * G9, ADR-0013 amendment 3).\n * Seeds are whole numbers from 0 (`checkSeed`, `SIM_BAD_SEED`).\n *\n * Invariants: a scene's `settings` are checked against the settings schema when it is defined (`CORE_BAD_SPEC`\n * naming each problem), so declare its settings before it; they apply for the run's lifetime, as an override layer\n * (engine/core/settings.ts), and the caller's settings (`--set`, a replay's `settings`) go on top. Each start makes\n * a new settings store and world, so runs share nothing but the registry. A missing scene id is `CORE_NO_ENTRY`.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const reg = createRegistry();\n * let made = 0;\n * defineScene('demo', { description: 'Counts its steps.', setup: (w) => w.spawn(), step: () => made++ }, reg);\n * const { world } = startScene('demo', { seed: 3, registry: reg });\n * world.step({});\n * [world.count, made]; // [1, 1]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap, TraceRecord } from '../core/events';\nimport { codeError, defineCodes, type Log } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { isPlainObject, show, type Schema } from '../core/schema';\nimport { createSettings, type Settings } from '../core/settings';\nimport type { Intents } from '../input/intents';\nimport { attachPhysics, scenePhysics } from '../physics/binding';\nimport type { AnyComponents, PhysicsHook } from './state';\nimport { createWorld, type SystemProbe, type World } from './world';\n\n/** The codes this module raises, with their fixes. */\nexport const SCENE_CODES = defineCodes('sim', {\n  SIM_BAD_SEED: {\n    template: '{where} got the seed {value}, which a replay cannot hold',\n    fix: 'pass a whole number, 0 or more (x sim --seed 3, __engine.seed(3)): record() writes the seed into the replay',\n  },\n});\n\n/** Returns `seed` (1 when absent; -0 as 0); throws `SIM_BAD_SEED` naming `where` unless it is a whole number from 0. */\nexport function checkSeed(seed: unknown, where: string): number {\n  if (seed === undefined) return 1;\n  if (Number.isInteger(seed) && (seed as number) >= 0) return (seed as number) + 0; // -0 + 0 is 0\n  throw codeError('SIM_BAD_SEED', { where, value: show(seed) });\n}\n\nexport type SceneAction<W> = (w: W, args: unknown) => void;\n\n/** A sound a sim event plays: an `sfx` entry, its gain (1 by default) and its variant (the effect's next by default). */\nexport interface SceneSound {\n  readonly sfx: string;\n  readonly vol?: number;\n  readonly variant?: number;\n}\n\n/** The sound a traced event names in its payload, `{ sfx, vol?, variant? }`, or null: a scene's default `sounds`. */\nexport function payloadSound(record: TraceRecord): SceneSound | null {\n  const payload = record.payload;\n  if (!isPlainObject(payload) || payload.sfx === undefined) return null;\n  return { sfx: payload.sfx, vol: payload.vol, variant: payload.variant } as SceneSound;\n}\n\n/** How a scene is written: `defineScene(id, spec)`. */\nexport interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  /** What the scene shows or tests, in plain sentences. */\n  description?: string;\n  /** The level it loads (`level:<name>`), when it has one (WP 2.2). */\n  level?: string;\n  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\n  terrain?: string;\n  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\n  site?: string;\n  /** Whether it has a physics world (WP 3.1): `physicsOf(w)` reaches it, the system `physics` steps it. */\n  physics?: boolean;\n  /** Setting values for its lifetime, path → value (schema-checked). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Runs once when it starts: spawns, systems, listeners. */\n  setup: (w: World<C, E>) => void;\n  /** Runs every step, first in the phase `intents`: reads the step's intents and components, writes components. */\n  step?: (w: World<C, E>, intents: Intents) => void;\n  /** Its dev actions, by name. */\n  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\n  /** The sounds each traced sim event plays, read as the event is delivered (`x audio --replay`); `payloadSound`. */\n  sounds?: (record: TraceRecord, w: World<C, E>) => SceneSound | readonly SceneSound[] | null;\n}\n\n/** A defined scene: its spec with defaults filled, plus `id` and `kind`. */\nexport type Scene<C extends object = AnyComponents, E extends EventMap = EventMap> = Readonly<\n  Required<Omit<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>> & Pick<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>\n> & { readonly id: string; readonly kind: 'scene' };\n\n/** The fields of a `scene` entry. */\nconst SCENE_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the scene shows or tests, in plain sentences.' },\n  level: { type: 'string', description: 'The level it loads (level:<name>, compiled by WP 2.2), when it has one.' },\n  terrain: { type: 'string', description: 'Its terrain (terrain:<name>, WP 10.5), when it has one.' },\n  site: { type: 'string', description: 'Its site (site:<name>: levels on a terrain, WP 13.15), when it has one.' },\n  physics: { type: 'boolean', default: false, description: 'Whether it has a physics world: physicsOf(w) reaches it.' },\n  settings: {\n    type: 'object',\n    default: {},\n    description: \"Setting values for the scene's lifetime, path → value, checked against the settings schema.\",\n  },\n  setup: {\n    type: 'function',\n    required: true,\n    description: 'Runs once when the scene starts, inside w.run: spawns, systems, listeners. (w) => void.',\n  },\n  step: {\n    type: 'function',\nengine/anim/clip/layerData.ts:19:export interface ClipPlay {\nengine/world/terrain.ts\nengine/gfx/stageGround.ts:4: * `stage/ground` and receiving shadows. Round a terrain (`hole`) it is a frame about the terrain's area instead, which\nengine/gfx/stageGround.ts:5: * the terrain itself covers: a site's cut shows what stands under it (a cellar), and the terrain's dips under its\nengine/gfx/stageGround.ts:14: * frame.geometry.getIndex()!.count / 6; // 8: the cells round the terrain's own\nengine/gfx/stageGround.ts:22:/** Where the ground lies: its area's north-west corner (m), the floor it stands under (m), and a terrain's hole. */\nengine/gfx/stageGround.ts:63:      if (r === 1 && c === 1) continue; // the area's own cell: the terrain's\nengine/sim/scene.ts:12: * `level` names the level it loads (WP 2.2 compiles it), `terrain` its ground (WP 10.5, engine/world/terrain.ts) and\nengine/sim/scene.ts:13: * `site` the levels standing on a terrain (WP 13.15, engine/world/site.ts): the view draws them; its setup adds their\nengine/sim/scene.ts:84:  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\nengine/sim/scene.ts:85:  terrain?: string;\nengine/sim/scene.ts:86:  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\nengine/sim/scene.ts:104:  Required<Omit<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>> & Pick<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>\nengine/sim/scene.ts:111:  terrain: { type: 'string', description: 'Its terrain (terrain:<name>, WP 10.5), when it has one.' },\n/**\n * @file The camera mode `cam3={{name}}`: what it shows (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a side-scroller's dolly: it stands `distance` metres east of the player and `height` metres up, looks\n * west and down at a point a metre over his feet, and follows him with a lag (a time constant of 0.15 real seconds),\n * so a jump or a fall moves the picture smoothly and a stop settles it. Its code is\n * `cam3={{name}}[,<distance>,<height>]` in metres, 8 and 2.5 when left out.\n *\n * Invariants: view state, never the sim's: pure steps over plain data, which `followCamera` wraps in a camera; a\n * checked pose each frame (`makePose`: metres and radians, +Y up, its yaw the heading the intents' `cam` takes); `dt`\n * is real seconds since the last frame, so it frames alike at any frame rate. `defineCamera` adds the mode when the\n * page imports this module; from then `?cam3={{name}}`, `__engine.camera.set('cam3={{name}}', { blend: true })` and\n * the camera rig's blends reach it, and its name is a word no engine camera has.\n *\n * @example\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n40:export interface CameraPose {\n41-  /** The camera's position, m. */\n42-  readonly position: Vec3;\n43-  /** The heading of the view direction, rad (the intents' `cam`). */\n44-  readonly yaw: number;\n45-  /** Up or down from level, rad: + up, −π/2 straight down. */\n46-  readonly pitch: number;\n47-  /** A bank about the view direction, rad: + tips the picture's top to the right, as a lean into a right turn. */\n48-  readonly roll: number;\n49-  readonly projection: Projection;\n50-  /** Vertical field of view, degrees (`PerspectiveCamera.fov`). */\n51-  readonly fov: number;\n52-  /** Orthographic: the frustum's height at zoom 1, m (`top − bottom`, three.js's examples' `frustumSize`). */\n53-  readonly frustumSize: number;\n54-  /** As three.js cameras' `zoom`: 2 shows half as much (a narrower lens, a smaller frustum). */\n140:export function makePose(fields: Partial<CameraPose> & { position: Vec3 }): CameraPose {\n141-  const p = { ...POSE_DEFAULTS, ...fields };\n142-  const problems = [\n143-    ...pointProblems('position', p.position),\n144-    ...rangeProblems({\n145-      yaw: [p.yaw, -1e9, 1e9],\n146-      pitch: [p.pitch, -Math.PI / 2, Math.PI / 2],\n147-      roll: [p.roll, -Math.PI / 2, Math.PI / 2],\n148-      fov: [p.fov, 1, 179],\n149-      frustumSize: [p.frustumSize, 1e-6, 1e9],\n150-      zoom: [p.zoom, 1e-3, 1e3],\n151-      near: [p.near, 1e-6, 1e9],\n152-      far: [p.far, p.near, 1e9],\n153-      boost: [p.boost, 0.01, 100],\n154-      distance: [p.distance, 0, 1e9],\nengine/gfx/cameras/chase.ts-282- * takes the view `effects` (engine/gfx/cameras/effects.ts) and `fade` (see `FollowCamera`) when given. A game's own\nengine/gfx/cameras/chase.ts-283- * camera is made this way.\nengine/gfx/cameras/chase.ts-284- */\nengine/gfx/cameras/chase.ts:285:export function followCamera<T extends string, St, S, I extends CameraInput>(\nengine/gfx/cameras/chase.ts-286-  type: T,\nengine/gfx/cameras/chase.ts-287-  first: St,\nengine/gfx/cameras/chase.ts-288-  steps: FollowSteps<St, S, I>,\nengine/gfx/cameras/chase.ts-289-  extras: { readonly effects?: EffectWeights; readonly fade?: boolean } = {},\nengine/gfx/cameras/chase.ts-290-): FollowCamera<T, S, I> {\nengine/gfx/cameras/chase.ts-291-  let state = first;\nengine/gfx/cameras/chase.ts-292-  let pose = steps.pose(state);\nengine/gfx/cameras/chase.ts-293-  return {\nengine/gfx/cameras/chase.ts-294-    type,\nengine/gfx/cameras/chase.ts-295-    ...extras,\nengine/gfx/cameras/chase.ts-296-    update(input = {} as I, dt = 0) {\nengine/gfx/cameras/chase.ts-297-      refuse(`${type} camera update`, rangeProblems({ dt: [dt, 0, 3600] }));\nengine/gfx/cameras/chase.ts-298-      state = steps.step(state, input, dt);\nengine/gfx/cameras/chase.ts-299-      pose = steps.pose(state);\nengine/gfx/cameras/chase.ts-300-      return pose;\nengine/gfx/cameras/chase.ts-301-    },\nengine/gfx/cameras/chase.ts-302-    pose: () => pose,\nengine/gfx/cameras/chase.ts-303-    yaw: () => wrapAngle(pose.yaw),\nengine/gfx/cameras/chase.ts-304-    spec: () => steps.spec(state),\nengine/gfx/cameras/chase.ts-305-    code: () => steps.code(steps.spec(state)),\nengine/gfx/cameras/chase.ts-306-    describe: () => steps.describe(steps.spec(state), pose),\nengine/gfx/cameras/chase.ts-307-  };\nengine/gfx/cameras/chase.ts-308-}\nengine/gfx/cameras/chase.ts-309-\nengine/gfx/cameras/chase.ts-310-/** A chase camera: behind the hero on its arm, following `input.follow`, in front of the walls `input.queries` sees. */\nengine/gfx/cameras/chase.ts-311-export function createChaseCamera(options: ChaseOptions = {}): FollowCamera<'chase', ChaseSpec, ChaseInput> {\nengine/gfx/cameras/chase.ts-312-  return followCamera('chase', chaseState(options), {\nengine/gfx/cameras/chase.ts-313-    step: stepChase,\nengine/gfx/cameras/chase.ts-314-    pose: chasePose,\nengine/gfx/cameras/chase.ts-315-    spec: chaseSpec,\n65:export interface CameraInput {\n66-  /** Look this frame `[right, up]`, rad: turn the view right and tilt it up (a captured mouse × its sensitivity). */\n67-  readonly look?: readonly [number, number];\n68-  /** Turn rates `[right, up]`, −1 to 1 (arrow keys, a right stick), times the camera's turn speed. */\n69-  readonly turn?: readonly [number, number];\n70-  /** Move axes `[right, forward, up]`, −1 to 1 (WASD, then E or Space up and Q down): fly cameras. */\n71-  readonly move?: readonly [number, number, number];\n72-  /** Move at the fast speed (Shift). */\n73-  readonly fast?: boolean;\n74-  /** Zoom steps, + in (wheel notches, + and −): views step their zoom, orbits come closer, fly and fixed narrow. */\n75-  readonly zoom?: number;\n76-  /** 45° turns of a classic view, + raising its azimuth (the prototype's `]` key). */\n77-  readonly turnSteps?: number;\n78-  /** The zoom steps a classic view's `zoom` moves through (engine/gfx/cameras/presets.ts's when absent). */\n79-  readonly zooms?: readonly number[];\n80-  /** The point views and orbits follow (the hero's feet, or a point just ahead of his aim), m. */\n81-  readonly follow?: Vec3;\n82-}\n83-\n84-/** A camera: its state, stepped once per rendered frame, and its pose. Made by the factories, or `createCamera`. */\n85-export interface Camera {\n86-  readonly type: CameraType;\n87-  /** Steps the camera by one rendered frame (`dt` real seconds) and returns its new pose. */\n88-  update(input?: CameraInput, dt?: number): CameraPose;\n89-  /** The pose after the last update. */","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"55fc36af-6254-419a-b078-1731f2864c32","timestamp":"2026-11-05T09:45:36.119Z","tool_use_result":{"stdout":"/**\n * @file Scenes, sim-side (PLAN.md §6.9, §9.0, WP 1.5; doctrines: Reproducible, Agent-operable):\n * `defineScene(id, { level?, settings, setup, step })` registers a scene as an entry of the registry kind `scene`;\n * `startScene` makes its world (a settings store with the scene's settings over the defaults and the caller's over\n * those, a world seeded from the seed, the scene's `step` as the system `scene`, then its `setup`). A session\n * (engine/sim/session.ts `createSession`) starts one that records its inputs. The kernel fixture, the box's scenes and\n * `createHeadless` (WP 1.6) all start scenes here, so no scene imports `app/`; engine/sim/replay.ts plays them.\n *\n * A scene is game code: `setup(w)` spawns, adds systems and listeners (inside `w.run`, so under the fdlibm swap);\n * `step(w, intents)` runs every sim step as the system `scene`, first in the phase `intents`, ahead of the systems\n * setup adds there; `actions` are its dev actions, `(w, args) => void` by name (WP 5.6 adds the engine's own).\n * `level` names the level it loads (WP 2.2 compiles it), `terrain` its ground (WP 10.5, engine/world/terrain.ts) and\n * `site` the levels standing on a terrain (WP 13.15, engine/world/site.ts): the view draws them; its setup adds their\n * bodies. `physics: true` gives it a physics world (physicsOf, WP 3.1).\n * `sounds(record, w)` says which sound a traced sim event plays, `{ sfx, vol?, variant? }`, a list of them (a shot and\n * where it strikes, WP 13.22) or null, for `x audio --replay` (WP 9.4): by default the event payload's own\n * (`payloadSound`); a game that maps its events to sounds sets its map here, so Node hears what its pages play (after\n * G9, ADR-0013 amendment 3).\n * Seeds are whole numbers from 0 (`checkSeed`, `SIM_BAD_SEED`).\n *\n * Invariants: a scene's `settings` are checked against the settings schema when it is defined (`CORE_BAD_SPEC`\n * naming each problem), so declare its settings before it; they apply for the run's lifetime, as an override layer\n * (engine/core/settings.ts), and the caller's settings (`--set`, a replay's `settings`) go on top. Each start makes\n * a new settings store and world, so runs share nothing but the registry. A missing scene id is `CORE_NO_ENTRY`.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const reg = createRegistry();\n * let made = 0;\n * defineScene('demo', { description: 'Counts its steps.', setup: (w) => w.spawn(), step: () => made++ }, reg);\n * const { world } = startScene('demo', { seed: 3, registry: reg });\n * world.step({});\n * [world.count, made]; // [1, 1]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap, TraceRecord } from '../core/events';\nimport { codeError, defineCodes, type Log } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { isPlainObject, show, type Schema } from '../core/schema';\nimport { createSettings, type Settings } from '../core/settings';\nimport type { Intents } from '../input/intents';\nimport { attachPhysics, scenePhysics } from '../physics/binding';\nimport type { AnyComponents, PhysicsHook } from './state';\nimport { createWorld, type SystemProbe, type World } from './world';\n\n/** The codes this module raises, with their fixes. */\nexport const SCENE_CODES = defineCodes('sim', {\n  SIM_BAD_SEED: {\n    template: '{where} got the seed {value}, which a replay cannot hold',\n    fix: 'pass a whole number, 0 or more (x sim --seed 3, __engine.seed(3)): record() writes the seed into the replay',\n  },\n});\n\n/** Returns `seed` (1 when absent; -0 as 0); throws `SIM_BAD_SEED` naming `where` unless it is a whole number from 0. */\nexport function checkSeed(seed: unknown, where: string): number {\n  if (seed === undefined) return 1;\n  if (Number.isInteger(seed) && (seed as number) >= 0) return (seed as number) + 0; // -0 + 0 is 0\n  throw codeError('SIM_BAD_SEED', { where, value: show(seed) });\n}\n\nexport type SceneAction<W> = (w: W, args: unknown) => void;\n\n/** A sound a sim event plays: an `sfx` entry, its gain (1 by default) and its variant (the effect's next by default). */\nexport interface SceneSound {\n  readonly sfx: string;\n  readonly vol?: number;\n  readonly variant?: number;\n}\n\n/** The sound a traced event names in its payload, `{ sfx, vol?, variant? }`, or null: a scene's default `sounds`. */\nexport function payloadSound(record: TraceRecord): SceneSound | null {\n  const payload = record.payload;\n  if (!isPlainObject(payload) || payload.sfx === undefined) return null;\n  return { sfx: payload.sfx, vol: payload.vol, variant: payload.variant } as SceneSound;\n}\n\n/** How a scene is written: `defineScene(id, spec)`. */\nexport interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  /** What the scene shows or tests, in plain sentences. */\n  description?: string;\n  /** The level it loads (`level:<name>`), when it has one (WP 2.2). */\n  level?: string;\n  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\n  terrain?: string;\n  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\n  site?: string;\n  /** Whether it has a physics world (WP 3.1): `physicsOf(w)` reaches it, the system `physics` steps it. */\n  physics?: boolean;\n  /** Setting values for its lifetime, path → value (schema-checked). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Runs once when it starts: spawns, systems, listeners. */\n  setup: (w: World<C, E>) => void;\n  /** Runs every step, first in the phase `intents`: reads the step's intents and components, writes components. */\n  step?: (w: World<C, E>, intents: Intents) => void;\n  /** Its dev actions, by name. */\n  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\n  /** The sounds each traced sim event plays, read as the event is delivered (`x audio --replay`); `payloadSound`. */\n  sounds?: (record: TraceRecord, w: World<C, E>) => SceneSound | readonly SceneSound[] | null;\n}\n\n/** A defined scene: its spec with defaults filled, plus `id` and `kind`. */\nexport type Scene<C extends object = AnyComponents, E extends EventMap = EventMap> = Readonly<\n  Required<Omit<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>> & Pick<SceneSpec<C, E>, 'level' | 'terrain' | 'site'>\n> & { readonly id: string; readonly kind: 'scene' };\n\n/** The fields of a `scene` entry. */\nconst SCENE_FIELDS = {\n  description: { type: 'string', default: '', description: 'What the scene shows or tests, in plain sentences.' },\n  level: { type: 'string', description: 'The level it loads (level:<name>, compiled by WP 2.2), when it has one.' },\n  terrain: { type: 'string', description: 'Its terrain (terrain:<name>, WP 10.5), when it has one.' },\n  site: { type: 'string', description: 'Its site (site:<name>: levels on a terrain, WP 13.15), when it has one.' },\n  physics: { type: 'boolean', default: false, description: 'Whether it has a physics world: physicsOf(w) reaches it.' },\n  s