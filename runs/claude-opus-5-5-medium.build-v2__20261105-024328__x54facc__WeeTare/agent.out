{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcXkfjhZRG7x3rFvZB8","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9338,"cache_read_input_tokens":361671,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9338},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"5397ad2f-c531-4a0e-83a2-3570196ac6cf","timestamp":"2026-11-05T10:20:50.900Z","request_id":"req_011CgjcXkFfufM5VMpaERxuU","thinking_duration_ms":3649,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcXkfjhZRG7x3rFvZB8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012bCXTVhYvRxL8VzRvvmaYo","name":"Bash","input":{"command":"cat > labs/game/ui/lines/activities.ts <<'E'\n/**\n * @file What the staff say during activities, keyed by id. The sim emits ids; the page says them. Short declarative\n * sentences, polite, level, a beat too honest. Never an exclamation mark from Plumb. Never about bodies, only about wobble.\n */\nexport const ACTIVITY_LINES: Readonly<Record<string, string>> = {\n  'pose.intro.nothing': 'Seated Nothing. It is exactly what it sounds like.',\n  'pose.intro.chair': 'The Patient Chair. There is no chair. Hold both feet down.',\n  'pose.intro.heron': 'The Heron. Hold your standing foot. Herons do not get a second one.',\n  'pose.intro.archer': 'The Archer. There is nothing to aim at. Aim anyway.',\n  'pose.intro.comma': 'The Sideways Comma. Pause, as a comma does. Then the other side.',\n  'pose.intro.napkin': 'The Folded Napkin. Fold. Something may land on you. That is its right.',\n  'pose.intro.bridge': 'The Polite Bridge. Your hips follow your lungs. Be courteous.',\n  'pose.intro.lighthouse': 'The Lighthouse. Stand very tall. The ring is smaller. I made it smaller.',\n  'pose.nowYou': 'Now you.',\n  'pose.start': 'We will call that a start.',\n  'pose.rest.1': 'And rest. You may stop wobbling now. Thank you for stopping.',\n  'pose.rest.2': 'Your knee is where it should be. I mention it because it is rare.',\n  'pose.rest.3': 'Good. Now do that again, but as though you meant it.',\n  'pose.rest.4': 'That was adequate. I chose that word carefully.',\n  'ring.intro': 'Stay in the ring. The ring has not moved. Remember that.',\n  'check.q.1': 'Have you been leaning toward anything lately? A person? A decision?',\n  'check.q.2': 'Did you sleep on your left side? You don’t have to answer. I can tell. I can’t tell. Did you?',\n  'check.q.3': 'Have you ever stood on one foot when nobody was looking?',\n  'check.q.4': 'Do you feel the floor is on your side?',\n  'check.q.5': 'Is there someone you would like to be steadier for?',\n  'check.q.6': 'Have you been drifting east at all? You can tell me.',\n  'check.q.7': 'If I asked you to stand further east, would you ask why?',\n  'check.q.8': 'Do you think about your ankles more than most people?',\n  'check.q.9': 'Have you noticed anything about the plaques? No? Good.',\n  'check.q.10': 'Would you say you have settled? As a person?',\n  'check.q.11': 'When you close your eyes, do you still know which way is down?',\n  'check.q.12': 'Is everything fine? It is. I am asking for a form.',\n  'check.a.yes': 'I know.',\n  'check.a.no': 'I know.',\n  'check.a.none': 'You don’t have to answer. I wrote something down anyway.',\n  'check.intro.still': 'Stay inside the ring. Your thumb is your weight. It is that simple and it is that bad.',\n  'check.intro.reach': 'Now reach the lights. One at a time. They will wait, but they will notice.',\n  'check.foot.l': 'Left foot only, please. Hold it. Please step on me. Not like that. Actually, like that is fine.',\n  'check.foot.r': 'Right foot only, please. Hold it. Your other foot may rest. It has done nothing wrong.',\n  'pond.begin': 'Sit. Breathe with the ring. Do nothing else. That is the whole class.',\n  'pond.end': 'You did nothing for a while. Nobody has ever been prouder of you. Nobody was watching.',\n  'pond.lure.psst': 'Psst. Is this on? Press the button for yes.',\n  'pond.lure.phone': 'My stone is buzzing. It might be for you.',\n  'pond.lure.frog': 'There is a frog on your knee. Do not look at it. It would like you to look at it.',\n  'pond.lure.gull': 'That gull is on your head now. It seems nice. Do not check.',\n  'pond.lure.wrong': 'You are doing it wrong.',\n  'reps.knees': 'Deep Knees. Pull back to sink, return to stand. I am counting. Gerald is also counting.',\n  'reps.pushups': 'Polite Push-Ups. Hold both feet: those are your palms now. Do not ask.',\n  'reps.lunges': 'Side Lunges. Left, then right, then left. You have seen left. You will recognise it.',\n  'reps.cheat': 'Four more. I may be lying. We will both find out.',\n  'step.intro': 'Step Class. Step on the beat. The others will follow you. I am sorry to say that.',\n  'step.endGood': 'The class remained in time. Several of them have asked after you.',\n  'step.endFair': 'You lost them, one by one, politely. They did not mention it. They will not mention it.',\n  'hoop.intro': 'Hoops! I throw them, you keep them up. Circle your thumb. Your hips will find out.',\n  'hoop.drop': 'That one fell. It is fine. It used to be a much better hoop.',\n  'line.intro': 'This is The Line. Left foot, right foot. Do not look down. I am in the boat. I am down.',\n  'line.closes': 'The line closes at this time.',\n  'line.gull': 'A gull is on your arm. Flick it off. Quickly left and right. It won’t take it personally.',\n  'line.flag': 'That is a flag. You passed it. You may not go back and pass it again.',\n  'line.fell': 'You have left the line. The line is fine.',\n  'paddle.intro': 'Lean forward to glide. Lean sideways to turn. Alternate your feet to paddle. The buoys are expecting you.',\n  'paddle.fell': 'You have got out to look at the water. Three seconds. Enjoy it.',\n  'paddle.endGood': 'You went round. The ferry waved. The ferry has no way to wave. I saw it.',\n  'paddle.endFair': 'Some of the buoys saw you. The others have been told.',\n  'garden.tray.1': 'Tilt the tray. The marble goes in the hole. This has worked for centuries.',\n  'garden.tray.2': 'Two marbles. A raked ridge. Do not disturb the ridge. Somebody cares about it.',\n  'garden.tray.3': 'This tray is longer than it looks. It looks long.',\n  'garden.tray.4': 'That rake is moving. Nobody is holding it. It has a good heart.',\n  'garden.tray.5': 'There is a gap in the rim now. Please do not ask about the rim.',\n  'garden.end': 'Everything is back in its place. Marbles do roll on their own sometimes. Not here.',\n  'plunge.intro': 'Hold still, breathe, then let go at the top of the swing. Spin with your lean. The gulls are judging.',\n  'plunge.slip': 'You stayed so long the cliff made the decision. That still counts as a dive.',\n  'plunge.good': 'The gulls have conferred. Two of them are moved. The third gave you a four.',\n  'plunge.fair': 'That was a dive. I would call it a dive. The gulls called it a four.',\n  'plunge.poor': 'You have reached the water. That is really the main thing.',\n  'jog.start': 'Morning.',\n  'jog.end': 'Nice weather for it.',\n  'jog.tare.1': 'Gerald has done this every day for eleven years. He started before the path did.',\n  'jog.tare.2': 'That is the lighthouse. It leans a little. It has always leaned. Do not write that down.',\n  'jog.tare.3': 'Alternate your feet if he gets away. Everyone gets away from Gerald. Gerald is the exception.',\n  'jog.tare.4': 'Did you know? There was a plaque here this morning. It has gone to look at the sea.',\n  'jog.tare.5': 'I used to weigh him. I didn’t say anything then either.',\n  'jog.tare.6': 'Nearly there. There is the place you started. Nothing happened to it while you were gone.',\n  'tilt.storm': 'Attention, guests. Please remain on the island.',\n  'tilt.calm': 'The island is now six degrees out of true. Please remain calm. Calm is mandatory.',\n  'tilt.east': 'Everyone east. Hold your breath, let it go, and they will follow. Lead them to the terrace.',\n  'tilt.delivered.1': 'One more on the terrace. The terrace is fully booked. Please enjoy the terrace.',\n  'tilt.delivered.2': 'Thank you for distributing yourselves evenly.',\n  'tilt.delivered.3': 'That helped. I will not say how much.',\n  'tilt.delivered.4': 'Please do not run. There is no running. There is only arriving uphill.',\n  'tilt.shuffle': 'The rest have shuffled up by themselves. They are like that. We will call that a start.',\n  'tilt.carts': 'Your pebbles are on the carts. All of them. Crank with your feet and lean into the slope.',\n  'tilt.cartsTime': 'That is as far as the carts go. They have been very good about it.',\n  'tilt.cartsDone': 'You moved your whole cairn. It was heavier than it looks. I can’t tell you by how much.',\n  'tilt.stone': 'Go up to the stone. Stand on the plate. It says “Do not”. Do.',\n  'tilt.again': 'Again, please.',\n  'tilt.level': 'That is level. You may stop now. You will not know how.',\n  'tilt.hm': 'Hm.',\n  'tilt.tare': 'Everything is balanced now. Please do not tell anyone about the rock.',\n  'day.finished': 'That is everything for today. Your hut is where you left it. Mostly.',\n  'walk.found': 'That’s the Noticeboard. Everything you’ve met is on it. Everything else is behind it.',\n  'hut.notYet': 'Not yet. You still have things to do today. I have a list. I am the list.',\n  'bench.sit': 'You sit. The view is very good. It has been asked to be.',\n};\nE\ncat > labs/game/ui/lines/island.ts <<'E'\n/**\n * @file What people say when you walk up to them, by day, and the plaques. Each cast member has new lines each day; Gerald says\n * only \"Morning.\" until Day 4. Plaques are \"Did you know?\" trivia that is not quite trivia.\n */\nexport const ISLAND_LINES: Readonly<Record<string, string>> = {\n  'talk.tare.d1.1': 'Welcome to Little Fulcrum. I am Tare. I used to weigh people. We don’t talk about that.',\n  'talk.tare.d1.2': 'I no longer measure weight. It made people sad, and it made me sad. Now I only measure how much you wobble.',\n  'talk.tare.d1.3': 'Please keep to the centre. No reason.',\n  'talk.tare.d2.1': 'You came back. A lot of people say they will.',\n  'talk.tare.d2.2': 'The plaques have not moved. If anyone asks, they have never moved.',\n  'talk.tare.d2.3': 'Guests are reminded to distribute themselves evenly. It is on a sign. I put up the sign.',\n  'talk.tare.d3.1': 'If your drink slides, that is a feature of the drink.',\n  'talk.tare.d3.2': 'Have you been to the east lawn? It is fully booked. Please enjoy it.',\n  'talk.tare.d3.3': 'Everything is fine. If anyone asks, everything was always fine.',\n  'talk.tare.d4.1': 'The island sits on one rock. We don’t mention it to guests. You’re a guest. I didn’t mention it.',\n  'talk.tare.d4.2': 'Just the one rock. It’s a good rock. It has very good posture.',\n  'talk.tare.d4.3': 'If you stood a little further east, I would feel better. I don’t have feelings. Further east.',\n  'talk.tare.d5.1': 'Today is Group Class. Then this evening there is a small thing. Please be calm for it.',\n  'talk.tare.d5.2': 'Do you know how to hold something very still? Good. No reason.',\n  'talk.tare.d5.3': 'I measured the island this morning. I am not going to tell you. You would only wobble.',\n  'talk.plumb.d1.1': 'Breathe in. Breathe out. You have been doing this for years, and yet.',\n  'talk.plumb.d1.2': 'You fell. The mat forgives you. The mat is not me.',\n  'talk.plumb.d1.3': 'Stand up straight. Not for me. For the vertical.',\n  'talk.plumb.d2.1': 'I have not moved since the spring. I am told it suits me.',\n  'talk.plumb.d2.2': 'My plait has never once swung. I do not expect you to understand what that took.',\n  'talk.plumb.d2.3': 'You are leaning. Slightly. I will not say toward what.',\n  'talk.plumb.d3.1': 'Water has no opinion of you. I envy it.',\n  'talk.plumb.d3.2': 'The mats have been sliding. They were asked not to. I asked them.',\n  'talk.plumb.d3.3': 'Please do not stand there. That side is full.',\n  'talk.plumb.d4.1': 'Your weight is your own business. Your balance is mine.',\n  'talk.plumb.d4.2': 'I do not sleep. I hold a very long pose with my eyes closed.',\n  'talk.plumb.d4.3': 'Tomorrow you will be asked to be calm. It will not be a suggestion.',\n  'talk.plumb.d5.1': 'Today we practise. Tonight we do not call it practice.',\n  'talk.plumb.d5.2': 'You have improved. I chose that word from a short list.',\n  'talk.plumb.d5.3': 'Good. Now stand somewhere that helps.',\n  'talk.gerald.d1.1': 'Morning.',\n  'talk.gerald.d2.1': 'Morning.',\n  'talk.gerald.d3.1': 'Morning.',\n  'talk.gerald.d4.1': 'Morning. Finished, have you?',\n  'talk.gerald.d4.2': 'I was here first. I don’t know why I said that.',\n  'talk.gerald.d4.3': 'It’s all calves, this.',\n  'talk.gerald.d5.1': 'Morning. Big day.',\n  'talk.gerald.d5.2': 'I’ve seen it go over twice. Nineteen eighty-one. And Tuesday.',\n  'talk.gerald.d5.3': 'Morning.',\n  'talk.bex.d1.1': 'My mum says this is good for me.',\n  'talk.bex.d1.2': 'I got a 98. I wasn’t trying.',\n  'talk.bex.d1.3': 'This is a stone. It’s the shape of a phone. There is no signal, but it is very restful to hold.',\n  'talk.bex.d2.1': 'That sign wasn’t there yesterday. Or it was over there.',\n  'talk.bex.d2.2': 'Nan beat me. Nan’s not even playing.',\n  'talk.bex.d2.3': 'Do you get the feeling we’re going slightly downhill? Not like, in life. Actually.',\n  'talk.bex.d3.1': 'My drink went past me. I didn’t chase it. I’m not doing that.',\n  'talk.bex.d3.2': 'I asked Plumb about the plait. Plumb said “Hm.”',\n  'talk.bex.d3.3': 'I got a 99. It told me to stop.',\n  'talk.bex.d4.1': 'The stone buzzed. It’s a stone.',\n  'talk.bex.d4.2': 'The marbles are doing it by themselves now. No one’s saying anything.',\n  'talk.bex.d4.3': 'I’ve decided I’m not scared. I’m just going to stand over here. East.',\n  'talk.bex.d5.1': 'If this island falls over I am telling my mum.',\n  'talk.bex.d5.2': 'I got a 100. Nobody clapped. It’s fine.',\n  'talk.bex.d5.3': 'You’re all right at this. Don’t tell anyone I said.',\n  'talk.nan.d1.1': 'I’ve been standing here since Tuesday.',\n  'talk.nan.d1.2': 'Which Tuesday? Yes.',\n  'talk.nan.d1.3': 'Ninety-one. Wobble Age nineteen. It’s the shoes.',\n  'talk.nan.d2.1': 'You’ve grown. Not up. Sideways, a bit, in your manner.',\n  'talk.nan.d2.2': 'I knew a man who could stand on nothing. Lovely man. Fell off.',\n  'talk.nan.d2.3': 'Don’t tell that dial anything. It writes it down.',\n  'talk.nan.d3.1': 'Water’s just the ground being rude.',\n  'talk.nan.d3.2': 'I’ve been standing here since Tuesday. Different here.',\n  'talk.nan.d3.3': 'They move the plaques at night. I watch them. Nobody moves them.',\n  'talk.nan.d4.1': 'There’s a rock. I sat on it once. We got on.',\n  'talk.nan.d4.2': 'You’re doing lovely. I’m not looking.',\n  'talk.nan.d4.3': 'Gerald talked? Oh dear. It must be nearly time.',\n  'talk.nan.d5.1': 'Going to be a bit of weather. I’ll see you up there.',\n  'talk.nan.d5.2': 'Stand where you like, dear. It’ll come to you.',\n  'talk.nan.d5.3': 'I was here when it was level. Nobody liked it.',\n  'plaque.1': 'Did you know? The average person leans two degrees toward the things they want.',\n  'plaque.2': 'Did you know? This plaque was four centimetres to the left on Tuesday.',\n  'plaque.3': 'Did you know? A flamingo stands on one leg because it has been told it is being watched.',\n  'plaque.4': 'Did you know? Gulls do not have a Wobble Age. They have been asked.',\n  'plaque.5': 'Notice: Guests are reminded to distribute themselves evenly.',\n  'plaque.6': 'Notice: The east lawn is fully booked. Please enjoy the east lawn.',\n  'plaque.7': 'Notice: If your drink slides, that is a feature of the drink.',\n  'plaque.8': 'Did you know? Sand remembers. It does not bring it up unless you do.',\n  'plaque.9': 'Did you know? The cliff is the same height as it was. The sea has been told otherwise.',\n  'plaque.10': 'Did you know? A hoop only falls because it has stopped believing in you.',\n  'plaque.11': 'Did you know? The lighthouse is vertical. It is everything else that has moved.',\n  'plaque.12': 'Notice: Please keep to the centre. No reason.',\n};\nE\ncat > labs/game/ui/lines/results.ts <<'E'\n/**\n * @file What is said about results, evenings and days: Tare's scientific surprise, Plumb's adjectives, the five days' opening\n * lines, the cairn's unlocks and the final remark. All chosen by the page from what the sim reports.\n */\nexport const RESULT_LINES: Readonly<Record<string, string>> = {\n  'rank.Present': 'You were present. That has been noted. There is a form.',\n  'rank.Adequate': 'That was adequate. I chose that word carefully.',\n  'rank.Composed': 'You were composed. You may tell people. I would not.',\n  'rank.Serene': 'That was serene. Please do not do it near the other guests.',\n  'rank.Unsettling': 'That was unsettling. I have asked the mat if it is all right.',\n  'first': 'That was your best score so far. It is also your only score so far. Well done on both.',\n  'best': 'That is your best yet. I have told no one. I have told everyone.',\n  'worse': 'You have done that better. You know you have. It is written on a stone.',\n  'age.first': 'Your Wobble Age is {age}. That is a number. I will not say whose.',\n  'age.younger': 'Your Wobble Age is {age}. Yesterday it was {prev}. You have become {diff} years younger by standing still. Science.',\n  'age.older': 'Your Wobble Age is {age}. Yesterday it was {prev}. You have aged {diff} years overnight. It happens. It happens to you.',\n  'age.same': 'Your Wobble Age is {age}. It was {prev} yesterday. Yes. I checked it twice. I don’t know either.',\n  'age.best': 'Your Wobble Age is {age}. Old Nan is nineteen. I mention it for no reason.',\n  'evening.1': 'Today you wobbled less than you might have. Goodnight.',\n  'evening.2': 'The plaques may be in different places tomorrow. They won’t. Goodnight.',\n  'evening.3': 'Your drink has been returned to your hut. It got there first. Goodnight.',\n  'evening.4': 'I am going to tell you something. There is one rock. I didn’t mention it. Goodnight.',\n  'evening.5': 'You may stay as long as you like. The ferry does not return. Goodnight.',\n  'evening.6': 'You came back again. Everything is balanced. Please don’t check. Goodnight.',\n  'morning.2': 'Guests are reminded to distribute themselves evenly.',\n  'morning.3': 'Please note that sliding drinks are a feature of the drink.',\n  'morning.4': 'Marbles may roll by themselves today. Please do not assist them.',\n  'morning.5': 'Group Class at noon. There is a light chance of everything this evening.',\n  'morning.6': 'You may stay as long as you like. The ferry does not return.',\n  'arrive.1': 'The ferry leaves. It does not hurry. Please keep to the centre.',\n  'arrive.2': 'Sign: Please keep to the centre.',\n  'unlock.expert': 'Your cairn is ten pebbles high. The Noticeboard now offers Expert: a smaller ring. You did this to yourself.',\n  'unlock.colours': 'Twenty pebbles. New tracksuit colours are in Settings. Nobody will look at them. Everyone will.',\n  'unlock.headband': 'Thirty pebbles. You have earned a headband. It doesn’t do anything. It knows.',\n  'unlock.stamps': 'Forty pebbles. The Unsettling stamp set is yours. We ask you to use it sparingly.',\n  'final.high': 'Everybody got uphill. I have written that down, then rubbed it out. Please don’t tell anyone about the rock.',\n  'final.mid': 'Enough people got uphill. The island has agreed to let it go.',\n  'final.low': 'It came level by itself in the end. It wanted you to feel involved. You did well to be there.',\n  'after': 'You may stay as long as you like. The ferry does not return.',\n};\nE\ncat > labs/game/ui/lines/index.ts <<'E'\n/**\n * @file Every line of the game by id, and how a line is named on screen. Tests check that every id the sim says is here.\n */\nimport { ACTIVITY_LINES } from './activities';\nimport { ISLAND_LINES } from './island';\nimport { RESULT_LINES } from './results';\n\nexport const LINES: Readonly<Record<string, string>> = { ...ACTIVITY_LINES, ...ISLAND_LINES, ...RESULT_LINES };\n\nexport const WHO: Readonly<Record<string, string>> = {\n  tare: 'Tare', plumb: 'Instructor Plumb', gerald: 'Gerald', bex: 'Bex', nan: 'Old Nan', pa: 'Loudspeaker', plaque: '',\n}; // prettier-ignore\n\n/** A line's text, with `{name}` filled. */\nexport function lineText(id: string, values: Record<string, string | number> = {}): string {\n  let text = LINES[id] ?? id;\n  for (const [key, value] of Object.entries(values)) text = text.replaceAll(`{${key}}`, String(value));\n  return text;\n}\nE\ncat > labs/game/ui/titles.ts <<'E'\n/**\n * @file The names of things for the screens: activities, cards, and each activity's prompts.\n */\nexport const TITLE = 'Wee Tare';\nexport const TAGLINE = 'Stand still. It is harder than it looks.';\n\nexport const ACTIVITY_TITLES: Readonly<Record<string, string>> = {\n  check: 'Morning Check', poseA: 'Pose Class', poseB: 'Pose Class II', poseC: 'Pose Class III', pond: 'Still Pond', reps: 'Reps Hall', step: 'Step Class',\n  line: 'The Line', paddle: 'Paddle Glide', garden: 'Sand Garden', plunge: 'Cliff Plunge', hoop: 'Hoop Patrol', jog: 'Island Jog', group: 'Group Class', tilt: 'The Great Tilt',\n  walk: 'Find the Noticeboard', ring: 'The Still Ring', heron: 'The Heron', hoopS: 'Hoop Patrol', stepS: 'Step Class', pondS: 'Still Pond',\n}; // prettier-ignore\n\n/** What each activity's prompts are. */\nexport const ACTIVITY_PROMPTS: Readonly<Record<string, readonly (readonly [string, string])[]>> = {\n  check: [['lean', 'Lean'], ['footL', 'Left foot'], ['footR', 'Right foot']],\n  poseA: [['lean', 'Lean'], ['both', 'Breathe']], poseB: [['lean', 'Lean'], ['both', 'Breathe']], poseC: [['lean', 'Lean'], ['both', 'Breathe']],\n  heron: [['lean', 'Lean'], ['footL', 'Stand'], ['footR', 'Breathe']], ring: [['lean', 'Lean']],\n  pond: [['both', 'Breathe']], pondS: [['both', 'Breathe']],\n  reps: [['lean', 'Your thumb is the exercise'], ['both', 'Palms']],\n  step: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Jump']], stepS: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Jump']],\n  line: [['footL', 'Step'], ['footR', 'Step'], ['lean', 'Balance']],\n  paddle: [['lean', 'Glide and steer'], ['footL', 'Paddle'], ['footR', 'Paddle']],\n  garden: [['lean', 'Tilt the tray']],\n  plunge: [['both', 'Hold, then let go'], ['lean', 'Spin and twist']],\n  hoop: [['lean', 'Circle your thumb'], ['footL', 'or alternate'], ['footR', 'feet']], hoopS: [['lean', 'Circle your thumb'], ['footL', 'or alternate'], ['footR', 'feet']],\n  jog: [['lean', 'Steer'], ['footL', 'Stride'], ['footR', 'Stride']],\n  tilt: [['lean', 'Lean'], ['both', 'Calm Call'], ['footL', 'Crank'], ['footR', 'Crank']],\n}; // prettier-ignore\nE\ncat > labs/game/ui/about-data.ts <<'E'\n/**\n * @file The one place the reports live: Source Information, Testing Feedback, Engine Feedback, Prompt Feedback and credits.\n * The About screen shows this; tools/write-interview.mjs writes exit-interview.json from it, so they always agree.\n */\nexport const SOURCE_INFORMATION = {\n  date: '2026-11-05 02:43:28',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'A 3D sports and wellness anthology of balance activities around a small walkable island, with a daily-ritual meta game and a comedy story',\n  perspective: 'Third person: a chase camera on the island and a purpose-built camera for each activity',\n  tech: 'my-3dge at 2dbd829, three.js r182 on WebGPU, Rapier 0.21, Vite, TypeScript',\n  artDirection: 'The engine’s native toon puppets and generators with new retreat assets: high-key brochure daylight, clinical white, mint, sand, coral',\n  animation: 'The engine’s clip layer and humanoid with a new readable clip set scrubbed from the sim, so limbs follow your thumb',\n  audio: 'Tracker songs, defineSfx effects, gibberish syllable voices, all code with no audio files, music at 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, 1 to 4 players; same-screen Group Class on its own',\n  testing: 'Headless scripts allowed: bots in Node, the built file in headless Chromium, the hub harness; one command that prints failures and a count; sparing screenshots; no review subagents',\n  research: 'None beyond the plan, the engine’s documents and the AI Hub protocol README',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort medium',\n  usage: 'added on import',\n};\n\nexport const SOURCE_LABELS: Readonly<Record<string, string>> = {\n  date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction',\n  animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage',\n}; // prettier-ignore\n\nexport const TESTING_FEEDBACK: readonly string[] = [\n  'pending',\n  'pending',\n  'pending',\n  'pending',\n];\nexport const TESTING_QUESTIONS = ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'];\n\nexport const ENGINE_FEEDBACK: readonly string[] = ['pending', 'pending', 'pending', 'pending', 'pending', 'pending'];\nexport const ENGINE_QUESTIONS = ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why?', 'If you could change one thing about the engine, what would it be?'];\n\nexport const PROMPT_FEEDBACK: readonly string[] = ['pending', 'pending', 'pending', 'pending'];\nexport const PROMPT_QUESTIONS = ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'];\n\nexport const CREDITS: readonly string[] = [\n  'Wee Tare: made by Claude (Anthropic, claude-opus-5-5) for Michael Crosato.',\n  'Engine: my-3dge (MIT). three.js (MIT). Rapier (Apache-2.0). @stdlib (Apache-2.0).',\n  'AI Hub session client 1.4.0, pasted unmodified.',\n  'Animation clips: Mesh2Motion (CC0) and the Quaternius Universal Animation Library (CC0).',\n  'CMU Graphics Lab Motion Capture Database: the wave, the yawn and the jumping jacks.',\n  '100STYLE dataset, Mason, Starke and Komura, 2022, CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/): Balance_Idle and Balance_Walk, converted to key poses.',\n  'All music, effects and voices are written in code.',\n];\n\nexport const AI_HUB = {\n  name: 'Wee Tare',\n  tagline: 'Stand still. It is harder than it looks.',\n  description: 'A deadpan wellness retreat on an island balanced on one rock, where a retired bathroom scale measures only how much you wobble. Eleven balance activities, one verb, and a storm.',\n  type: 'Game',\n  genre: 'Sports',\n  source: 'Wii Fit',\n  series: '',\n  players: '1–4',\n  controls: 'Lean: left stick, WASD or mouse · Feet: L2 R2, Q E or mouse buttons · Breathe: both',\n  tags: ['3d', 'third-person', 'comedy', 'sports', 'story', 'arcade'],\n};\nE\nnode -e \"\nconst fs=require('fs');let n=0;for(const f of ['activities','island','results']){const s=fs.readFileSync('labs/game/ui/lines/'+f+'.ts','utf8');n+=(s.match(/^  '/gm)||[]).length}console.log('lines',n)\"","description":"Write all game lines, titles and about data"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9338,"cache_read_input_tokens":361671,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9338},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"cf49c18f-4068-40e6-a882-707241346b52","timestamp":"2026-11-05T10:22:33.464Z","request_id":"req_011CgjcXkFfufM5VMpaERxuU","wire_tool_inputs":{"toolu_012bCXTVhYvRxL8VzRvvmaYo":{"command":"cat > labs/game/ui/lines/activities.ts <<'E'\n/**\n * @file What the staff say during activities, keyed by id. The sim emits ids; the page says them. Short declarative\n * sentences, polite, level, a beat too honest. Never an exclamation mark from Plumb. Never about bodies, only about wobble.\n */\nexport const ACTIVITY_LINES: Readonly<Record<string, string>> = {\n  'pose.intro.nothing': 'Seated Nothing. It is exactly what it sounds like.',\n  'pose.intro.chair': 'The Patient Chair. There is no chair. Hold both feet down.',\n  'pose.intro.heron': 'The Heron. Hold your standing foot. Herons do not get a second one.',\n  'pose.intro.archer': 'The Archer. There is nothing to aim at. Aim anyway.',\n  'pose.intro.comma': 'The Sideways Comma. Pause, as a comma does. Then the other side.',\n  'pose.intro.napkin': 'The Folded Napkin. Fold. Something may land on you. That is its right.',\n  'pose.intro.bridge': 'The Polite Bridge. Your hips follow your lungs. Be courteous.',\n  'pose.intro.lighthouse': 'The Lighthouse. Stand very tall. The ring is smaller. I made it smaller.',\n  'pose.nowYou': 'Now you.',\n  'pose.start': 'We will call that a start.',\n  'pose.rest.1': 'And rest. You may stop wobbling now. Thank you for stopping.',\n  'pose.rest.2': 'Your knee is where it should be. I mention it because it is rare.',\n  'pose.rest.3': 'Good. Now do that again, but as though you meant it.',\n  'pose.rest.4': 'That was adequate. I chose that word carefully.',\n  'ring.intro': 'Stay in the ring. The ring has not moved. Remember that.',\n  'check.q.1': 'Have you been leaning toward anything lately? A person? A decision?',\n  'check.q.2': 'Did you sleep on your left side? You don\\u2019t have to answer. I can tell. I can\\u2019t tell. Did you?',\n  'check.q.3': 'Have you ever stood on one foot when nobody was looking?',\n  'check.q.4': 'Do you feel the floor is on your side?',\n  'check.q.5': 'Is there someone you would like to be steadier for?',\n  'check.q.6': 'Have you been drifting east at all? You can tell me.',\n  'check.q.7': 'If I asked you to stand further east, would you ask why?',\n  'check.q.8': 'Do you think about your ankles more than most people?',\n  'check.q.9': 'Have you noticed anything about the plaques? No? Good.',\n  'check.q.10': 'Would you say you have settled? As a person?',\n  'check.q.11': 'When you close your eyes, do you still know which way is down?',\n  'check.q.12': 'Is everything fine? It is. I am asking for a form.',\n  'check.a.yes': 'I know.',\n  'check.a.no': 'I know.',\n  'check.a.none': 'You don\\u2019t have to answer. I wrote something down anyway.',\n  'check.intro.still': 'Stay inside the ring. Your thumb is your weight. It is that simple and it is that bad.',\n  'check.intro.reach': 'Now reach the lights. One at a time. They will wait, but they will notice.',\n  'check.foot.l': 'Left foot only, please. Hold it. Please step on me. Not like that. Actually, like that is fine.',\n  'check.foot.r': 'Right foot only, please. Hold it. Your other foot may rest. It has done nothing wrong.',\n  'pond.begin': 'Sit. Breathe with the ring. Do nothing else. That is the whole class.',\n  'pond.end': 'You did nothing for a while. Nobody has ever been prouder of you. Nobody was watching.',\n  'pond.lure.psst': 'Psst. Is this on? Press the button for yes.',\n  'pond.lure.phone': 'My stone is buzzing. It might be for you.',\n  'pond.lure.frog': 'There is a frog on your knee. Do not look at it. It would like you to look at it.',\n  'pond.lure.gull': 'That gull is on your head now. It seems nice. Do not check.',\n  'pond.lure.wrong': 'You are doing it wrong.',\n  'reps.knees': 'Deep Knees. Pull back to sink, return to stand. I am counting. Gerald is also counting.',\n  'reps.pushups': 'Polite Push-Ups. Hold both feet: those are your palms now. Do not ask.',\n  'reps.lunges': 'Side Lunges. Left, then right, then left. You have seen left. You will recognise it.',\n  'reps.cheat': 'Four more. I may be lying. We will both find out.',\n  'step.intro': 'Step Class. Step on the beat. The others will follow you. I am sorry to say that.',\n  'step.endGood': 'The class remained in time. Several of them have asked after you.',\n  'step.endFair': 'You lost them, one by one, politely. They did not mention it. They will not mention it.',\n  'hoop.intro': 'Hoops! I throw them, you keep them up. Circle your thumb. Your hips will find out.',\n  'hoop.drop': 'That one fell. It is fine. It used to be a much better hoop.',\n  'line.intro': 'This is The Line. Left foot, right foot. Do not look down. I am in the boat. I am down.',\n  'line.closes': 'The line closes at this time.',\n  'line.gull': 'A gull is on your arm. Flick it off. Quickly left and right. It won\\u2019t take it personally.',\n  'line.flag': 'That is a flag. You passed it. You may not go back and pass it again.',\n  'line.fell': 'You have left the line. The line is fine.',\n  'paddle.intro': 'Lean forward to glide. Lean sideways to turn. Alternate your feet to paddle. The buoys are expecting you.',\n  'paddle.fell': 'You have got out to look at the water. Three seconds. Enjoy it.',\n  'paddle.endGood': 'You went round. The ferry waved. The ferry has no way to wave. I saw it.',\n  'paddle.endFair': 'Some of the buoys saw you. The others have been told.',\n  'garden.tray.1': 'Tilt the tray. The marble goes in the hole. This has worked for centuries.',\n  'garden.tray.2': 'Two marbles. A raked ridge. Do not disturb the ridge. Somebody cares about it.',\n  'garden.tray.3': 'This tray is longer than it looks. It looks long.',\n  'garden.tray.4': 'That rake is moving. Nobody is holding it. It has a good heart.',\n  'garden.tray.5': 'There is a gap in the rim now. Please do not ask about the rim.',\n  'garden.end': 'Everything is back in its place. Marbles do roll on their own sometimes. Not here.',\n  'plunge.intro': 'Hold still, breathe, then let go at the top of the swing. Spin with your lean. The gulls are judging.',\n  'plunge.slip': 'You stayed so long the cliff made the decision. That still counts as a dive.',\n  'plunge.good': 'The gulls have conferred. Two of them are moved. The third gave you a four.',\n  'plunge.fair': 'That was a dive. I would call it a dive. The gulls called it a four.',\n  'plunge.poor': 'You have reached the water. That is really the main thing.',\n  'jog.start': 'Morning.',\n  'jog.end': 'Nice weather for it.',\n  'jog.tare.1': 'Gerald has done this every day for eleven years. He started before the path did.',\n  'jog.tare.2': 'That is the lighthouse. It leans a little. It has always leaned. Do not write that down.',\n  'jog.tare.3': 'Alternate your feet if he gets away. Everyone gets away from Gerald. Gerald is the exception.',\n  'jog.tare.4': 'Did you know? There was a plaque here this morning. It has gone to look at the sea.',\n  'jog.tare.5': 'I used to weigh him. I didn\\u2019t say anything then either.',\n  'jog.tare.6': 'Nearly there. There is the place you started. Nothing happened to it while you were gone.',\n  'tilt.storm': 'Attention, guests. Please remain on the island.',\n  'tilt.calm': 'The island is now six degrees out of true. Please remain calm. Calm is mandatory.',\n  'tilt.east': 'Everyone east. Hold your breath, let it go, and they will follow. Lead them to the terrace.',\n  'tilt.delivered.1': 'One more on the terrace. The terrace is fully booked. Please enjoy the terrace.',\n  'tilt.delivered.2': 'Thank you for distributing yourselves evenly.',\n  'tilt.delivered.3': 'That helped. I will not say how much.',\n  'tilt.delivered.4': 'Please do not run. There is no running. There is only arriving uphill.',\n  'tilt.shuffle': 'The rest have shuffled up by themselves. They are like that. We will call that a start.',\n  'tilt.carts': 'Your pebbles are on the carts. All of them. Crank with your feet and lean into the slope.',\n  'tilt.cartsTime': 'That is as far as the carts go. They have been very good about it.',\n  'tilt.cartsDone': 'You moved your whole cairn. It was heavier than it looks. I can\\u2019t tell you by how much.',\n  'tilt.stone': 'Go up to the stone. Stand on the plate. It says \\u201cDo not\\u201d. Do.',\n  'tilt.again': 'Again, please.',\n  'tilt.level': 'That is level. You may stop now. You will not know how.',\n  'tilt.hm': 'Hm.',\n  'tilt.tare': 'Everything is balanced now. Please do not tell anyone about the rock.',\n  'day.finished': 'That is everything for today. Your hut is where you left it. Mostly.',\n  'walk.found': 'That\\u2019s the Noticeboard. Everything you\\u2019ve met is on it. Everything else is behind it.',\n  'hut.notYet': 'Not yet. You still have things to do today. I have a list. I am the list.',\n  'bench.sit': 'You sit. The view is very good. It has been asked to be.',\n};\nE\ncat > labs/game/ui/lines/island.ts <<'E'\n/**\n * @file What people say when you walk up to them, by day, and the plaques. Each cast member has new lines each day; Gerald says\n * only \"Morning.\" until Day 4. Plaques are \"Did you know?\" trivia that is not quite trivia.\n */\nexport const ISLAND_LINES: Readonly<Record<string, string>> = {\n  'talk.tare.d1.1': 'Welcome to Little Fulcrum. I am Tare. I used to weigh people. We don\\u2019t talk about that.',\n  'talk.tare.d1.2': 'I no longer measure weight. It made people sad, and it made me sad. Now I only measure how much you wobble.',\n  'talk.tare.d1.3': 'Please keep to the centre. No reason.',\n  'talk.tare.d2.1': 'You came back. A lot of people say they will.',\n  'talk.tare.d2.2': 'The plaques have not moved. If anyone asks, they have never moved.',\n  'talk.tare.d2.3': 'Guests are reminded to distribute themselves evenly. It is on a sign. I put up the sign.',\n  'talk.tare.d3.1': 'If your drink slides, that is a feature of the drink.',\n  'talk.tare.d3.2': 'Have you been to the east lawn? It is fully booked. Please enjoy it.',\n  'talk.tare.d3.3': 'Everything is fine. If anyone asks, everything was always fine.',\n  'talk.tare.d4.1': 'The island sits on one rock. We don\\u2019t mention it to guests. You\\u2019re a guest. I didn\\u2019t mention it.',\n  'talk.tare.d4.2': 'Just the one rock. It\\u2019s a good rock. It has very good posture.',\n  'talk.tare.d4.3': 'If you stood a little further east, I would feel better. I don\\u2019t have feelings. Further east.',\n  'talk.tare.d5.1': 'Today is Group Class. Then this evening there is a small thing. Please be calm for it.',\n  'talk.tare.d5.2': 'Do you know how to hold something very still? Good. No reason.',\n  'talk.tare.d5.3': 'I measured the island this morning. I am not going to tell you. You would only wobble.',\n  'talk.plumb.d1.1': 'Breathe in. Breathe out. You have been doing this for years, and yet.',\n  'talk.plumb.d1.2': 'You fell. The mat forgives you. The mat is not me.',\n  'talk.plumb.d1.3': 'Stand up straight. Not for me. For the vertical.',\n  'talk.plumb.d2.1': 'I have not moved since the spring. I am told it suits me.',\n  'talk.plumb.d2.2': 'My plait has never once swung. I do not expect you to understand what that took.',\n  'talk.plumb.d2.3': 'You are leaning. Slightly. I will not say toward what.',\n  'talk.plumb.d3.1': 'Water has no opinion of you. I envy it.',\n  'talk.plumb.d3.2': 'The mats have been sliding. They were asked not to. I asked them.',\n  'talk.plumb.d3.3': 'Please do not stand there. That side is full.',\n  'talk.plumb.d4.1': 'Your weight is your own business. Your balance is mine.',\n  'talk.plumb.d4.2': 'I do not sleep. I hold a very long pose with my eyes closed.',\n  'talk.plumb.d4.3': 'Tomorrow you will be asked to be calm. It will not be a suggestion.',\n  'talk.plumb.d5.1': 'Today we practise. Tonight we do not call it practice.',\n  'talk.plumb.d5.2': 'You have improved. I chose that word from a short list.',\n  'talk.plumb.d5.3': 'Good. Now stand somewhere that helps.',\n  'talk.gerald.d1.1': 'Morning.',\n  'talk.gerald.d2.1': 'Morning.',\n  'talk.gerald.d3.1': 'Morning.',\n  'talk.gerald.d4.1': 'Morning. Finished, have you?',\n  'talk.gerald.d4.2': 'I was here first. I don\\u2019t know why I said that.',\n  'talk.gerald.d4.3': 'It\\u2019s all calves, this.',\n  'talk.gerald.d5.1': 'Morning. Big day.',\n  'talk.gerald.d5.2': 'I\\u2019ve seen it go over twice. Nineteen eighty-one. And Tuesday.',\n  'talk.gerald.d5.3': 'Morning.',\n  'talk.bex.d1.1': 'My mum says this is good for me.',\n  'talk.bex.d1.2': 'I got a 98. I wasn\\u2019t trying.',\n  'talk.bex.d1.3': 'This is a stone. It\\u2019s the shape of a phone. There is no signal, but it is very restful to hold.',\n  'talk.bex.d2.1': 'That sign wasn\\u2019t there yesterday. Or it was over there.',\n  'talk.bex.d2.2': 'Nan beat me. Nan\\u2019s not even playing.',\n  'talk.bex.d2.3': 'Do you get the feeling we\\u2019re going slightly downhill? Not like, in life. Actually.',\n  'talk.bex.d3.1': 'My drink went past me. I didn\\u2019t chase it. I\\u2019m not doing that.',\n  'talk.bex.d3.2': 'I asked Plumb about the plait. Plumb said \\u201cHm.\\u201d',\n  'talk.bex.d3.3': 'I got a 99. It told me to stop.',\n  'talk.bex.d4.1': 'The stone buzzed. It\\u2019s a stone.',\n  'talk.bex.d4.2': 'The marbles are doing it by themselves now. No one\\u2019s saying anything.',\n  'talk.bex.d4.3': 'I\\u2019ve decided I\\u2019m not scared. I\\u2019m just going to stand over here. East.',\n  'talk.bex.d5.1': 'If this island falls over I am telling my mum.',\n  'talk.bex.d5.2': 'I got a 100. Nobody clapped. It\\u2019s fine.',\n  'talk.bex.d5.3': 'You\\u2019re all right at this. Don\\u2019t tell anyone I said.',\n  'talk.nan.d1.1': 'I\\u2019ve been standing here since Tuesday.',\n  'talk.nan.d1.2': 'Which Tuesday? Yes.',\n  'talk.nan.d1.3': 'Ninety-one. Wobble Age nineteen. It\\u2019s the shoes.',\n  'talk.nan.d2.1': 'You\\u2019ve grown. Not up. Sideways, a bit, in your manner.',\n  'talk.nan.d2.2': 'I knew a man who could stand on nothing. Lovely man. Fell off.',\n  'talk.nan.d2.3': 'Don\\u2019t tell that dial anything. It writes it down.',\n  'talk.nan.d3.1': 'Water\\u2019s just the ground being rude.',\n  'talk.nan.d3.2': 'I\\u2019ve been standing here since Tuesday. Different here.',\n  'talk.nan.d3.3': 'They move the plaques at night. I watch them. Nobody moves them.',\n  'talk.nan.d4.1': 'There\\u2019s a rock. I sat on it once. We got on.',\n  'talk.nan.d4.2': 'You\\u2019re doing lovely. I\\u2019m not looking.',\n  'talk.nan.d4.3': 'Gerald talked? Oh dear. It must be nearly time.',\n  'talk.nan.d5.1': 'Going to be a bit of weather. I\\u2019ll see you up there.',\n  'talk.nan.d5.2': 'Stand where you like, dear. It\\u2019ll come to you.',\n  'talk.nan.d5.3': 'I was here when it was level. Nobody liked it.',\n  'plaque.1': 'Did you know? The average person leans two degrees toward the things they want.',\n  'plaque.2': 'Did you know? This plaque was four centimetres to the left on Tuesday.',\n  'plaque.3': 'Did you know? A flamingo stands on one leg because it has been told it is being watched.',\n  'plaque.4': 'Did you know? Gulls do not have a Wobble Age. They have been asked.',\n  'plaque.5': 'Notice: Guests are reminded to distribute themselves evenly.',\n  'plaque.6': 'Notice: The east lawn is fully booked. Please enjoy the east lawn.',\n  'plaque.7': 'Notice: If your drink slides, that is a feature of the drink.',\n  'plaque.8': 'Did you know? Sand remembers. It does not bring it up unless you do.',\n  'plaque.9': 'Did you know? The cliff is the same height as it was. The sea has been told otherwise.',\n  'plaque.10': 'Did you know? A hoop only falls because it has stopped believing in you.',\n  'plaque.11': 'Did you know? The lighthouse is vertical. It is everything else that has moved.',\n  'plaque.12': 'Notice: Please keep to the centre. No reason.',\n};\nE\ncat > labs/game/ui/lines/results.ts <<'E'\n/**\n * @file What is said about results, evenings and days: Tare's scientific surprise, Plumb's adjectives, the five days' opening\n * lines, the cairn's unlocks and the final remark. All chosen by the page from what the sim reports.\n */\nexport const RESULT_LINES: Readonly<Record<string, string>> = {\n  'rank.Present': 'You were present. That has been noted. There is a form.',\n  'rank.Adequate': 'That was adequate. I chose that word carefully.',\n  'rank.Composed': 'You were composed. You may tell people. I would not.',\n  'rank.Serene': 'That was serene. Please do not do it near the other guests.',\n  'rank.Unsettling': 'That was unsettling. I have asked the mat if it is all right.',\n  'first': 'That was your best score so far. It is also your only score so far. Well done on both.',\n  'best': 'That is your best yet. I have told no one. I have told everyone.',\n  'worse': 'You have done that better. You know you have. It is written on a stone.',\n  'age.first': 'Your Wobble Age is {age}. That is a number. I will not say whose.',\n  'age.younger': 'Your Wobble Age is {age}. Yesterday it was {prev}. You have become {diff} years younger by standing still. Science.',\n  'age.older': 'Your Wobble Age is {age}. Yesterday it was {prev}. You have aged {diff} years overnight. It happens. It happens to you.',\n  'age.same': 'Your Wobble Age is {age}. It was {prev} yesterday. Yes. I checked it twice. I don\\u2019t know either.',\n  'age.best': 'Your Wobble Age is {age}. Old Nan is nineteen. I mention it for no reason.',\n  'evening.1': 'Today you wobbled less than you might have. Goodnight.',\n  'evening.2': 'The plaques may be in different places tomorrow. They won\\u2019t. Goodnight.',\n  'evening.3': 'Your drink has been returned to your hut. It got there first. Goodnight.',\n  'evening.4': 'I am going to tell you something. There is one rock. I didn\\u2019t mention it. Goodnight.',\n  'evening.5': 'You may stay as long as you like. The ferry does not return. Goodnight.',\n  'evening.6': 'You came back again. Everything is balanced. Please don\\u2019t check. Goodnight.',\n  'morning.2': 'Guests are reminded to distribute themselves evenly.',\n  'morning.3': 'Please note that sliding drinks are a feature of the drink.',\n  'morning.4': 'Marbles may roll by themselves today. Please do not assist them.',\n  'morning.5': 'Group Class at noon. There is a light chance of everything this evening.',\n  'morning.6': 'You may stay as long as you like. The ferry does not return.',\n  'arrive.1': 'The ferry leaves. It does not hurry. Please keep to the centre.',\n  'arrive.2': 'Sign: Please keep to the centre.',\n  'unlock.expert': 'Your cairn is ten pebbles high. The Noticeboard now offers Expert: a smaller ring. You did this to yourself.',\n  'unlock.colours': 'Twenty pebbles. New tracksuit colours are in Settings. Nobody will look at them. Everyone will.',\n  'unlock.headband': 'Thirty pebbles. You have earned a headband. It doesn\\u2019t do anything. It knows.',\n  'unlock.stamps': 'Forty pebbles. The Unsettling stamp set is yours. We ask you to use it sparingly.',\n  'final.high': 'Everybody got uphill. I have written that down, then rubbed it out. Please don\\u2019t tell anyone about the rock.',\n  'final.mid': 'Enough people got uphill. The island has agreed to let it go.',\n  'final.low': 'It came level by itself in the end. It wanted you to feel involved. You did well to be there.',\n  'after': 'You may stay as long as you like. The ferry does not return.',\n};\nE\ncat > labs/game/ui/lines/index.ts <<'E'\n/**\n * @file Every line of the game by id, and how a line is named on screen. Tests check that every id the sim says is here.\n */\nimport { ACTIVITY_LINES } from './activities';\nimport { ISLAND_LINES } from './island';\nimport { RESULT_LINES } from './results';\n\nexport const LINES: Readonly<Record<string, string>> = { ...ACTIVITY_LINES, ...ISLAND_LINES, ...RESULT_LINES };\n\nexport const WHO: Readonly<Record<string, string>> = {\n  tare: 'Tare', plumb: 'Instructor Plumb', gerald: 'Gerald', bex: 'Bex', nan: 'Old Nan', pa: 'Loudspeaker', plaque: '',\n}; // prettier-ignore\n\n/** A line's text, with `{name}` filled. */\nexport function lineText(id: string, values: Record<string, string | number> = {}): string {\n  let text = LINES[id] ?? id;\n  for (const [key, value] of Object.entries(values)) text = text.replaceAll(`{${key}}`, String(value));\n  return text;\n}\nE\ncat > labs/game/ui/titles.ts <<'E'\n/**\n * @file The names of things for the screens: activities, cards, and each activity's prompts.\n */\nexport const TITLE = 'Wee Tare';\nexport const TAGLINE = 'Stand still. It is harder than it looks.';\n\nexport const ACTIVITY_TITLES: Readonly<Record<string, string>> = {\n  check: 'Morning Check', poseA: 'Pose Class', poseB: 'Pose Class II', poseC: 'Pose Class III', pond: 'Still Pond', reps: 'Reps Hall', step: 'Step Class',\n  line: 'The Line', paddle: 'Paddle Glide', garden: 'Sand Garden', plunge: 'Cliff Plunge', hoop: 'Hoop Patrol', jog: 'Island Jog', group: 'Group Class', tilt: 'The Great Tilt',\n  walk: 'Find the Noticeboard', ring: 'The Still Ring', heron: 'The Heron', hoopS: 'Hoop Patrol', stepS: 'Step Class', pondS: 'Still Pond',\n}; // prettier-ignore\n\n/** What each activity's prompts are. */\nexport const ACTIVITY_PROMPTS: Readonly<Record<string, readonly (readonly [string, string])[]>> = {\n  check: [['lean', 'Lean'], ['footL', 'Left foot'], ['footR', 'Right foot']],\n  poseA: [['lean', 'Lean'], ['both', 'Breathe']], poseB: [['lean', 'Lean'], ['both', 'Breathe']], poseC: [['lean', 'Lean'], ['both', 'Breathe']],\n  heron: [['lean', 'Lean'], ['footL', 'Stand'], ['footR', 'Breathe']], ring: [['lean', 'Lean']],\n  pond: [['both', 'Breathe']], pondS: [['both', 'Breathe']],\n  reps: [['lean', 'Your thumb is the exercise'], ['both', 'Palms']],\n  step: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Jump']], stepS: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Jump']],\n  line: [['footL', 'Step'], ['footR', 'Step'], ['lean', 'Balance']],\n  paddle: [['lean', 'Glide and steer'], ['footL', 'Paddle'], ['footR', 'Paddle']],\n  garden: [['lean', 'Tilt the tray']],\n  plunge: [['both', 'Hold, then let go'], ['lean', 'Spin and twist']],\n  hoop: [['lean', 'Circle your thumb'], ['footL', 'or alternate'], ['footR', 'feet']], hoopS: [['lean', 'Circle your thumb'], ['footL', 'or alternate'], ['footR', 'feet']],\n  jog: [['lean', 'Steer'], ['footL', 'Stride'], ['footR', 'Stride']],\n  tilt: [['lean', 'Lean'], ['both', 'Calm Call'], ['footL', 'Crank'], ['footR', 'Crank']],\n}; // prettier-ignore\nE\ncat > labs/game/ui/about-data.ts <<'E'\n/**\n * @file The one place the reports live: Source Information, Testing Feedback, Engine Feedback, Prompt Feedback and credits.\n * The About screen shows this; tools/write-interview.mjs writes exit-interview.json from it, so they always agree.\n */\nexport const SOURCE_INFORMATION = {\n  date: '2026-11-05 02:43:28',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'A 3D sports and wellness anthology of balance activities around a small walkable island, with a daily-ritual meta game and a comedy story',\n  perspective: 'Third person: a chase camera on the island and a purpose-built camera for each activity',\n  tech: 'my-3dge at 2dbd829, three.js r182 on WebGPU, Rapier 0.21, Vite, TypeScript',\n  artDirection: 'The engine\\u2019s native toon puppets and generators with new retreat assets: high-key brochure daylight, clinical white, mint, sand, coral',\n  animation: 'The engine\\u2019s clip layer and humanoid with a new readable clip set scrubbed from the sim, so limbs follow your thumb',\n  audio: 'Tracker songs, defineSfx effects, gibberish syllable voices, all code with no audio files, music at 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, 1 to 4 players; same-screen Group Class on its own',\n  testing: 'Headless scripts allowed: bots in Node, the built file in headless Chromium, the hub harness; one command that prints failures and a count; sparing screenshots; no review subagents',\n  research: 'None beyond the plan, the engine\\u2019s documents and the AI Hub protocol README',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort medium',\n  usage: 'added on import',\n};\n\nexport const SOURCE_LABELS: Readonly<Record<string, string>> = {\n  date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction',\n  animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage',\n}; // prettier-ignore\n\nexport const TESTING_FEEDBACK: readonly string[] = [\n  'pending',\n  'pending',\n  'pending',\n  'pending',\n];\nexport const TESTING_QUESTIONS = ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'];\n\nexport const ENGINE_FEEDBACK: readonly string[] = ['pending', 'pending', 'pending', 'pending', 'pending', 'pending'];\nexport const ENGINE_QUESTIONS = ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why?', 'If you could change one thing about the engine, what would it be?'];\n\nexport const PROMPT_FEEDBACK: readonly string[] = ['pending', 'pending', 'pending', 'pending'];\nexport const PROMPT_QUESTIONS = ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'];\n\nexport const CREDITS: readonly string[] = [\n  'Wee Tare: made by Claude (Anthropic, claude-opus-5-5) for Michael Crosato.',\n  'Engine: my-3dge (MIT). three.js (MIT). Rapier (Apache-2.0). @stdlib (Apache-2.0).',\n  'AI Hub session client 1.4.0, pasted unmodified.',\n  'Animation clips: Mesh2Motion (CC0) and the Quaternius Universal Animation Library (CC0).',\n  'CMU Graphics Lab Motion Capture Database: the wave, the yawn and the jumping jacks.',\n  '100STYLE dataset, Mason, Starke and Komura, 2022, CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/): Balance_Idle and Balance_Walk, converted to key poses.',\n  'All music, effects and voices are written in code.',\n];\n\nexport const AI_HUB = {\n  name: 'Wee Tare',\n  tagline: 'Stand still. It is harder than it looks.',\n  description: 'A deadpan wellness retreat on an island balanced on one rock, where a retired bathroom scale measures only how much you wobble. Eleven balance activities, one verb, and a storm.',\n  type: 'Game',\n  genre: 'Sports',\n  source: 'Wii Fit',\n  series: '',\n  players: '1\\u20134',\n  controls: 'Lean: left stick, WASD or mouse \\u00b7 Feet: L2 R2, Q E or mouse buttons \\u00b7 Breathe: both',\n  tags: ['3d', 'third-person', 'comedy', 'sports', 'story', 'arcade'],\n};\nE\nnode -e \"\nconst fs=require('fs');let n=0;for(const f of ['activities','island','results']){const s=fs.readFileSync('labs/game/ui/lines/'+f+'.ts','utf8');n+=(s.match(/^  '/gm)||[]).length}console.log('lines',n)\"","description":"Write all game lines, titles and about data"}}}
