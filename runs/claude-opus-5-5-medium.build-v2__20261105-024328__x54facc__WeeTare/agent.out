{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaxJnTAqqnH2eRPegPv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DirEw4CSoD6L9iBv1WmpKA","name":"Bash","input":{"command":"python3 - <<'E'\np='labs/game/scenes/events/kit.ts';s=open(p).read()\ns=s.replace(\"\"\"export const playing = (w: W, ev: EvState): SeatE[] =>\n  seatsOf(w).filter((e) => ev.seats.includes(e.seat.index) && e.seat.kind !== 'none');\"\"\",\"\"\"export const playing = (w: W, ev: EvState): SeatE[] => {\n  const seats = seatsOf(w);\n  return ev.seats.map((i) => seats.find((e) => e.seat.index === i) as SeatE).filter((e) => e && e.seat.kind !== 'none');\n};\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/types.ts';s=open(p).read()\ns=s.replace(\"\"\"  /** Finale score pieces. */\n  tiltScore: number;\n}\"\"\",\"\"\"  /** Finale score pieces. */\n  tiltScore: number;\n  /** What the guest could use now, as `kind:id`, and how many times each person has been talked to today. */\n  near: string;\n  talk: Record<string, number>;\n  /** Sitting on a bench. */\n  sit: number;\n  /** Steps since the last pebble dropped on the cairn; how many stand on it. */\n  cairnT: number;\n  cairnShown: number;\n  /** Lets a menu pick wait: the Day 1 walk is done. */\n  walked: boolean;\n}\"\"\")\ns=s.replace(\"\"\"    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n\"\"\",\"\"\"    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n    near: { type: 'string', default: '', description: 'What the guest could use now.' },\n    talk: { type: 'object', default: {}, description: 'Talks today, per person.' },\n    sit: { type: 'integer', default: 0, description: 'Steps sat on a bench.' },\n    cairnT: { type: 'integer', default: 0, description: 'Steps since the last pebble dropped.' },\n    cairnShown: { type: 'integer', default: 0, description: 'Pebbles standing on the cairn.' },\n    walked: { type: 'boolean', default: false, description: 'The Day 1 walk is done.' },\n\"\"\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/flow.ts <<'E'\n/**\n * @file The game's state machine: starting and ending activities, results, the day, Group Class's list of classes, the\n * scene actions every menu pick goes through, and the input each seat gets each step. Everything here is sim state, so a\n * replay holds every pick. The page sends picks with `inspector.actions.run` and reads `flow` back.\n */\nimport { pressed, type Intents } from '../../../engine/sim-api';\nimport { clearBody, setLean } from '../cast/body';\nimport { applyOrder, SKILLS } from './bot/players';\nimport { castOf } from './cast-ref';\nimport { ageOf, DAYS, rankOf } from './data/days';\nimport { STATIONS, type StationId } from './data/stations';\nimport { ACTIVITIES } from './events';\nimport { clearOwned, standAt } from './events/kit';\nimport { gameNumber } from './settings';\nimport { cue, flowOf, islandOf, say, seatsOf, type EvState, type Flow, type SeatE, type W } from './types';\nimport { resetWobble } from './wobble';\n\n/** Where you are left standing when an activity at each station ends. */\nconst LANDINGS: Readonly<Record<StationId, readonly [number, number]>> = {\n  pier: [0, 84], plaza: [0, 40], pavilion: [-52, 28], pond: [-60, -8], annex: [52, 32], huts: [58, 46],\n  lagoon: [-36, 66], terrace: [30, -41], cliff: [0, -80], hoopBeach: [58, 76], lighthouse: [78, -54], east: [70, 8], stone: [0, 6],\n}; // prettier-ignore\n\n/** Options for starting an activity. */\nexport interface StartOptions { short?: boolean; expert?: boolean; final?: boolean; only?: string; seats?: number[] }\n\n/** Starts activity `id`, ending any that runs. */\nexport function startEvent(w: W, id: string, options: StartOptions = {}): void {\n  const flow = flowOf(w);\n  if (flow.ev) endWithoutResult(w);\n  const activity = ACTIVITIES[id];\n  if (!activity) return;\n  const multi = activity.multi && !options.seats;\n  const seats = options.seats ?? (multi ? seatsOf(w).filter((e) => e.seat.kind !== 'none').map((e) => e.seat.index) : [0]);\n  // Seats not in this activity stand down; CPU guests hold the other mats.\n  const ev: EvState = {\n    id, phase: 'go', t: 0, total: 0, done: false, score: 0, short: !!options.short, expert: !!options.expert,\n    owned: [], s: [], d: { final: !!options.final, only: options.only ?? '' }, seats,\n  }; // prettier-ignore\n  flow.ev = ev;\n  flow.mode = 'event';\n  for (const e of seatsOf(w)) {\n    e.seat.extra = options.expert ? 0.35 : e.seat.kind === 'cpu' ? 0.15 + e.seat.index * 0.08 : 0;\n    Object.assign(e.seat, { hx: [], hy: [], bot: {}, score: 0 });\n    resetWobble(e.wobble);\n  }\n  activity.setup(w, ev);\n  w.emit('eventStart', { id } as never);\n}\n\n/** Tears an activity down: what it spawned goes, the bodies stand down. */\nfunction endWithoutResult(w: W): void {\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  if (!ev) return;\n  ACTIVITIES[ev.id]?.teardown?.(w, ev);\n  clearOwned(w, ev);\n  const cast = castOf(w);\n  for (const e of seatsOf(w)) {\n    if (e.seat.actor >= 0 && w.get(e.seat.actor)) {\n      clearBody(w, e.seat.actor);\n      setLean(w, e.seat.actor, 0, 0);\n    }\n  }\n  if (cast.plumb >= 0) clearBody(w, cast.plumb);\n  if (cast.gerald >= 0) clearBody(w, cast.gerald);\n  const station = ACTIVITIES[ev.id]?.station ?? 'plaza';\n  const guest = cast.guest;\n  if (guest >= 0 && !w.query('roundScene').length) {\n    const [x, z] = LANDINGS[station];\n    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n}\n\n/** Records a finished activity and moves on. */\nfunction finishEvent(w: W): void {\n  const flow = flowOf(w);\n  const ev = flow.ev as EvState;\n  const { id, score } = ev;\n  const final = !!ev.d.final;\n  const seatScores = seatsOf(w).map((e) => e.seat.score);\n  endWithoutResult(w);\n  if (flow.group) {\n    flow.group.scores = flow.group.scores.map((sum, i) => sum + (seatScores[i] ?? 0));\n    flow.group.at += 1;\n    w.emit('classDone', { at: flow.group.at, score: seatScores } as never);\n    if (flow.group.at < flow.group.list.length) {\n      startEvent(w, flow.group.list[flow.group.at], { short: true, seats: flow.group.seats });\n      return;\n    }\n    const scores = flow.group.scores;\n    flow.bests.group = Math.max(flow.bests.group ?? 0, scores[flow.group.seats[0]] / 3);\n    recordResult(w, 'group', Math.round(scores[flow.group.seats[0]] / 3));\n    return;\n  }\n  if (id === 'tilt') {\n    flow.tiltScore = score;\n    markDone(flow, 'tilt');\n    startEvent(w, 'check', { final: true });\n    return;\n  }\n  recordResult(w, id, score, final);\n}\n\nfunction markDone(flow: Flow, id: string): void {\n  if (!flow.done.includes(id)) flow.done.push(id);\n}\n\n/** Puts the result in `flow.last`, pays pebbles, opens the results. */\nfunction recordResult(w: W, id: string, score: number, final = false): void {\n  const flow = flowOf(w);\n  const rank = rankOf(score);\n  const mult = gameNumber(w, 'game.pebbles.mult');\n  const pebbles = flow.auto ? 0 : Math.max(0, Math.round(rank.pebbles * mult));\n  let age = 0;\n  if (id === 'check') {\n    age = ageOf(score / 1000, gameNumber(w, 'game.age.k'));\n    flow.ages.push(age);\n    if (flow.ages.length > 7) flow.ages.shift();\n  }\n  flow.pebbles += pebbles;\n  flow.bests[id] = Math.max(flow.bests[id] ?? 0, score);\n  flow.last = { id, score, rank: rank.name, pebbles, age };\n  markDone(flow, id);\n  flow.mode = final ? 'credits' : 'results';\n  w.emit('results', { id, score, rank: rank.name, pebbles, age, final } as never);\n  cue(w, 'stampJingle');\n}\n\n/** Starts Group Class: three short classes, dealt, on every occupied seat. */\nexport function startGroup(w: W, seats?: number[]): void {\n  const flow = flowOf(w);\n  const middle = ['heron', 'hoopS', 'stepS'][w.rng('deal').int(0, 2)];\n  const list = ['ring', middle, 'pondS'];\n  const who = seats ?? seatsOf(w).filter((e) => e.seat.kind !== 'none').map((e) => e.seat.index);\n  flow.group = { list, at: 0, scores: [0, 0, 0, 0], seats: who };\n  startEvent(w, list[0], { short: true, seats: who });\n}\n\n/** The next thing today, or null when today is finished. */\nexport function nextItem(flow: Flow): string | null {\n  const list = DAYS[flow.day - 1] ?? [];\n  return list.find((id) => !flow.done.includes(id)) ?? null;\n}\n\n/** Sets who sits where outside a session: seat 0 is the guest; the rest are CPU guests in classes. */\nfunction defaultSeats(w: W): void {\n  const cast = castOf(w);\n  const others = [cast.gerald, cast.bex, cast.nan];\n  for (const e of seatsOf(w)) {\n    if (e.seat.index === 0) Object.assign(e.seat, { kind: 'human', actor: cast.guest });\n    else Object.assign(e.seat, { kind: 'cpu', actor: others[e.seat.index - 1] });\n  }\n}\n\n/** The morning: the day turns, the tilt grows a little. */\nexport function nextDay(w: W): void {\n  const flow = flowOf(w);\n  flow.day += 1;\n  flow.done = [];\n  flow.talk = {};\n  islandOf(w).tilt = 0.4 + 0.5 * (flow.day - 1);\n  flow.mode = 'roam';\n  w.emit('morning', { day: flow.day } as never);\n}\n\n/** Reads the page's input for a seat from the step's intents. */\nfunction readHuman(w: W, intents: Intents, e: SeatE): void {\n  const read = (key: string): number => {\n    const value = (intents as unknown as Record<string, unknown>)[key];\n    return typeof value === 'number' ? value : 0;\n  };\n  const seats = (intents as unknown as Record<string, unknown>)['game:seats'] as number[] | undefined;\n  const { index } = e.seat;\n  if (seats && seats[index]) {\n    const o = 4 + index * 5;\n    Object.assign(e.seat.input, { x: seats[o], y: seats[o + 1], l: seats[o + 2], r: seats[o + 3], act: seats[o + 4] > 0.5, gentle: false });\n  } else if (index === (w.query('roundScene').length ? flowOf(w).meSeat : 0)) {\n    const held = (intents.b ?? []) as readonly string[];\n    Object.assign(e.seat.input, {\n      x: read('game:r') - read('game:l'), y: read('game:f') - read('game:b'), l: read('game:fl'), r: read('game:fr'),\n      act: pressed(intents, 'act') || held.includes('act'), gentle: held.includes('gentle'),\n    }); // prettier-ignore\n    const mouse = (intents as unknown as Record<string, unknown>)['game:mouse'] as number[] | undefined;\n    if (mouse) {\n      const bot = e.seat.bot;\n      if (bot.mx !== undefined) {\n        e.wobble.mx += mouse[0] - bot.mx;\n        e.wobble.my += mouse[1] - bot.my;\n      }\n      [bot.mx, bot.my] = [mouse[0], mouse[1]];\n    }\n    const pointer = (intents as unknown as Record<string, unknown>)['game:pointer'] as number[] | undefined;\n    if (pointer && flowOf(w).ev?.id === 'garden') [e.wobble.mx, e.wobble.my] = [pointer[0], pointer[1]];\n  } else Object.assign(e.seat.input, { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false });\n}\n\n/** Writes this step's input into every seat. */\nfunction readSeats(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind === 'ghost' || e.seat.kind === 'none') continue;\n    const skillName = e.seat.kind === 'cpu' ? 'cpu' : flow.bot;\n    if (skillName) {\n      const skill = SKILLS[skillName] ?? SKILLS.perfect;\n      const running = ev && ev.seats.includes(e.seat.index) ? ACTIVITIES[ev.id] : null;\n      applyOrder(w, e, skill, running ? running.bot(w, ev as EvState, e, skill) : {});\n    } else readHuman(w, intents, e);\n  }\n}\n\n/** One step of the running activity. Run the input first, then the rules, then remember the feet. */\nexport function flowStep(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  readSeats(w, intents);\n  const ev = flow.ev;\n  if (flow.mode === 'event' && ev) {\n    ACTIVITIES[ev.id].step(w, ev);\n    ev.t += 1;\n    ev.total += 1;\n    if (ev.done) finishEvent(w);\n  }\n  for (const e of seatsOf(w)) {\n    e.seat.pl = e.seat.input.l;\n    e.seat.pr = e.seat.input.r;\n    e.seat.pact = e.seat.input.act;\n  }\n}\n\n/** The scene actions that belong to the flow. */\nexport const FLOW_ACTIONS = {\n  /** Hands the sim the save and walks onto the island. */\n  'game.begin': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    const save = (args ?? {}) as Partial<Flow>;\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n    defaultSeats(w);\n    islandOf(w).tilt = 0.4 + 0.5 * Math.min(4, flow.day - 1);\n    const cast = castOf(w);\n    if (cast.guest >= 0) {\n      const fresh = flow.day === 1 && flow.done.length === 0;\n      const at = fresh ? STATIONS.pier : STATIONS.plaza;\n      standAt(w, cast.guest, at.x, at.z + (fresh ? -14 : 10), Math.PI);\n    }\n    w.emit('begin', { day: flow.day } as never);\n  },\n  /** Starts an activity by id. */\n  'game.start': (w: W, args: unknown) => {\n    const { id, expert, only } = args as { id: string; expert?: boolean; only?: string };\n    if (id === 'group') return startGroup(w);\n    if (id === 'walk') return void w.emit('goWalk', {} as never);\n    flowOf(w).group = null;\n    startEvent(w, id, { expert, only });\n  },\n  /** Leaves results or an activity, back to the island. */\n  'game.leave': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    flow.group = null;\n    flow.mode = 'roam';\n    if (nextItem(flow) === null && !flow.free) say(w, 'day.finished', 'tare');\n  },\n  /** Again: runs the last activity. */\n  'game.again': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    if (flow.last.id === 'group') return startGroup(w);\n    startEvent(w, flow.last.id);\n  },\n  /** Finish now, at a score (dev). */\n  'game.finishAt': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    if (!flow.ev) return;\n    flow.ev.score = (args as { score: number }).score;\n    flow.ev.done = true;\n    if (flow.group) flow.group.at = flow.group.list.length - 1;\n  },\n  /** Opens the evening screen. */\n  'game.evening': (w: W) => void Object.assign(flowOf(w), { mode: 'evening' }),\n  /** Sleep: the next day. Day 5's end is the credits. */\n  'game.sleep': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    nextDay(w);\n    const cast = castOf(w);\n    if (cast.guest >= 0) standAt(w, cast.guest, 60, 44, 3.14);\n  },\n  /** After the credits: Free Play. */\n  'game.after': (w: W) => {\n    const flow = flowOf(w);\n    flow.day = 6;\n    flow.free = true;\n    flow.mode = 'roam';\n    flow.done = [];\n    w.emit('free', {} as never);\n  },\n  /** Back to the title. */\n  'game.front': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { mode: 'front', auto: false, bot: '', drive: false, noTopple: false, group: null });\n  },\n  /** Jumps to a day (dev). */\n  'game.day': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { day: (args as { day: number }).day, done: [], mode: 'roam' });\n    islandOf(w).tilt = 0.4 + 0.5 * (flow.day - 1);\n    w.emit('morning', { day: flow.day } as never);\n  },\n  /** A bot plays seat 0 ('' a person). */\n  'game.bot': (w: W, args: unknown) => void (flowOf(w).bot = (args as { skill: string }).skill),\n  /** Cheats and assists. */\n  'game.flags': (w: W, args: unknown) => void Object.assign(flowOf(w), args as object),\n  /** Group Class seats: who is human, who is CPU, who is empty. */\n  'game.seats': (w: W, args: unknown) => {\n    const { kinds } = args as { kinds: Flow['mode'][] };\n    const cast = castOf(w);\n    const others = [cast.guest, cast.gerald, cast.bex, cast.nan];\n    for (const e of seatsOf(w)) Object.assign(e.seat, { kind: kinds[e.seat.index], actor: others[e.seat.index] });\n  },\n};\nE\npython3 - <<'E'\np='labs/game/scenes/types.ts';s=open(p).read()\ns=s.replace(\"group: { list: string[]; at: number; scores: number[] } | null;\",\"group: { list: string[]; at: number; scores: number[]; seats: number[] } | null;\\n  /** A session's own seat. */\\n  meSeat: number;\")\ns=s.replace(\"\"\"    near: { type: 'string',\"\"\",\"\"\"    meSeat: { type: 'integer', default: 0, description: 'A session\\\\u2019s own seat.' },\n    near: { type: 'string',\"\"\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/pilot.ts <<'E'\n/**\n * @file The pilot: every character stays `player: false`, and this system writes their intents. On the island the guest\n * walks by the step's `move`; the thing nearest in front of you gets the prompt; `use` talks, reads, enters or sleeps.\n * Tare hops along beside you. Also the walk's small rules: the sea's edge, hidden pebbles, the cairn, benches, the wave.\n */\nimport { held, pressed, terrainHeight, type Intents } from '../../../engine/sim-api';\nimport { clearBody, setLoop, setOnce } from '../cast/body';\nimport { castOf } from './cast-ref';\nimport { DAYS, BOARD } from './data/days';\nimport { BENCHES, HIDDEN_PEBBLES, PLAQUES } from './data/places';\nimport { STATIONS } from './data/stations';\nimport { ACTIVITIES } from './events';\nimport { nextItem, startEvent, startGroup } from './flow';\nimport { cue, flowOf, say, type C, type Flow, type W } from './types';\nimport { FULCRUM } from './terrain';\n\nconst REACH = 4.5;\nconst FLOOR = 2.3;\n\ntype ActorOf = { actor: C['actor'] & { intents: Record<string, unknown> } };\n\n/** A thing you can use. */\ninterface Thing { key: string; x: number; z: number; r?: number }\n\n/** Today's list of usable things. */\nfunction things(w: W, flow: Flow): Thing[] {\n  const cast = castOf(w);\n  const list: Thing[] = [];\n  for (const who of ['plumb', 'gerald', 'bex', 'nan'] as const) {\n    const id = cast[who];\n    const entity = id >= 0 ? (w.get(id) as unknown as ActorOf | undefined) : undefined;\n    if (entity) list.push({ key: `npc:${who}`, x: entity.actor.x, z: entity.actor.z });\n  }\n  const tare = cast.tare >= 0 ? (w.get(cast.tare) as unknown as ActorOf | undefined) : undefined;\n  if (tare) list.push({ key: 'npc:tare', x: tare.actor.x, z: tare.actor.z, r: 3 });\n  PLAQUES.forEach((p, k) => {\n    const creep = 1 + (flow.day - 1) * 0.012;\n    list.push({ key: `plaque:${k}`, x: p[0] * creep, z: p[1] * creep, r: 3.5 });\n  });\n  list.push({ key: 'board:board', x: 12, z: 34, r: 5 });\n  list.push({ key: 'hut:hut', x: 64, z: 49, r: 5 });\n  BENCHES.forEach((b, k) => list.push({ key: `bench:${k}`, x: b[0], z: b[1], r: 3 }));\n  const today = DAYS[flow.day - 1] ?? [];\n  for (const id of today) {\n    if (id === 'walk' || flow.done.includes(id)) continue;\n    const station = id === 'group' ? STATIONS.pavilion : ACTIVITIES[id] ? STATIONS[ACTIVITIES[id].station] : null;\n    if (station) list.push({ key: `go:${id}`, x: station.x, z: station.z, r: 9 });\n  }\n  if (flow.free) {\n    for (const id of BOARD) {\n      if (id === 'group') continue;\n      const station = STATIONS[ACTIVITIES[id].station];\n      list.push({ key: `go:${id}`, x: station.x, z: station.z, r: 7 });\n    }\n  }\n  return list;\n}\n\n/** What's nearest and in front. */\nfunction nearest(w: W, flow: Flow, ax: number, az: number, yaw: number): string {\n  let best = '';\n  let score = Infinity;\n  for (const t of things(w, flow)) {\n    const [dx, dz] = [t.x - ax, t.z - az];\n    const d = Math.hypot(dx, dz);\n    if (d > (t.r ?? REACH)) continue;\n    const front = d > 0.01 ? (dx * Math.sin(yaw) + dz * Math.cos(yaw)) / d : 1;\n    const value = d - front * 1.5;\n    if (value < score) [score, best] = [value, t.key];\n  }\n  return best;\n}\n\n/** Uses a thing. */\nfunction use(w: W, flow: Flow, key: string): void {\n  const [kind, id] = key.split(':');\n  if (kind === 'npc') {\n    const n = (flow.talk[id] ?? 0) + 1;\n    flow.talk[id] = n;\n    const day = Math.min(5, flow.day);\n    const count = id === 'gerald' && day < 4 ? 1 : 3;\n    say(w, `talk.${id}.d${day}.${((n - 1) % count) + 1}`, id);\n    return;\n  }\n  if (kind === 'plaque') {\n    const k = Number(id);\n    if (!flow.plaques.includes(k)) flow.plaques.push(k);\n    say(w, `plaque.${k + 1}`, 'plaque');\n    cue(w, 'tick');\n    return;\n  }\n  if (kind === 'board') {\n    if (!flow.done.includes('walk') && (DAYS[flow.day - 1] ?? []).includes('walk')) {\n      flow.done.push('walk');\n      say(w, 'walk.found', 'tare');\n    }\n    w.emit('openBoard', {} as never);\n    return;\n  }\n  if (kind === 'hut') {\n    if (nextItem(flow) === null || flow.free) flow.mode = 'evening';\n    else say(w, 'hut.notYet', 'tare');\n    return;\n  }\n  if (kind === 'bench') {\n    flow.sit = 1;\n    say(w, 'bench.sit', 'plaque');\n    return;\n  }\n  if (kind === 'go') {\n    if (id === 'group') return startGroup(w);\n    startEvent(w, id);\n  }\n}\n\n/** Keeps the walker out of deep water: the sea's edge pushes back. */\nfunction shoreline(x: number, z: number): [number, number] | null {\n  const h = terrainHeight(FULCRUM(), x, z);\n  if (h !== null && h > FLOOR) return null;\n  const len = Math.hypot(x, z) || 1;\n  return [-(x / len), -(z / len)];\n}\n\n/** One roam step. */\nexport function pilot(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  const guest = w.get(cast.guest) as unknown as ActorOf;\n  if (flow.mode !== 'roam') {\n    if (guest && flow.mode !== 'event') guest.actor.intents = {};\n    return;\n  }\n  const { actor } = guest;\n  let move = (intents.move ?? [0, 0]) as readonly number[];\n  if (flow.drive) move = [0, 0];\n  const slow = held(intents, 'walk') ? 0.45 : 1;\n  let [mx, mz] = [move[0] * slow, move[1] * slow];\n  if (Math.hypot(mx, mz) > 0.05 && flow.sit) {\n    flow.sit = 0;\n    clearBody(w, cast.guest);\n  }\n  if (flow.sit) {\n    flow.sit += 1;\n    setLoop(w, cast.guest, 'RETREATLIB/Sitting_Idle_Loop', 1);\n  }\n  const back = shoreline(actor.x + mx * 0.5, actor.z + mz * 0.5);\n  if (back) [mx, mz] = [back[0] * 0.6, back[1] * 0.6];\n  actor.intents = { move: [mx, mz], ...(held(intents, 'jump') ? { b: ['jump'] } : {}) };\n  flow.near = nearest(w, flow, actor.x, actor.z, actor.yaw);\n  if (pressed(intents, 'use') && flow.near) use(w, flow, flow.near);\n  if (pressed(intents, 'wave')) {\n    setOnce(w, cast.guest, 'RETREATLIB/Wave_Hello');\n    w.emit('waved', {} as never);\n    flow.sit = 900; // the wave ends when you walk off\n  }\n  // Tare hops along beside you\n  const tare = w.get(cast.tare) as unknown as ActorOf | undefined;\n  if (tare) {\n    const [dx, dz] = [actor.x - 2.2 - tare.actor.x, actor.z - 1.4 - tare.actor.z];\n    const far = Math.hypot(dx, dz);\n    tare.actor.intents = far > 1.6 ? { move: [dx / far, dz / far], ...(w.tick % 30 < 3 ? { b: ['jump'] } : {}) } : {};\n  }\n  // hidden pebbles\n  HIDDEN_PEBBLES.forEach((p, k) => {\n    if (!flow.found.includes(k) && Math.hypot(p[0] - actor.x, p[1] - actor.z) < 1.8) {\n      flow.found.push(k);\n      flow.pebbles += 1;\n      cue(w, 'pebble');\n      w.emit('foundPebble', { k } as never);\n    }\n  });\n  // a walk's other rule: at the Noticeboard, on Day 1, the walk is done\n  if (flow.day === 1 && !flow.done.includes('walk') && Math.hypot(actor.x - 12, actor.z - 34) < 7) {\n    flow.done.push('walk');\n    say(w, 'walk.found', 'tare');\n    cue(w, 'stamp');\n  }\n}\nE\ncat > labs/game/scenes/terrain.ts <<'E'\n/**\n * @file Little Fulcrum's ground: a sea-girt dome with a summit, flats for its stations, hollows for the pond and the\n * lagoon, and the north cliff. `FULCRUM()` is its terrain data, for height queries.\n */\nimport { defineTerrain, getTerrain, makeTerrain } from '../../../engine/sim-api';\n\nexport const FULCRUM_ID = 'terrain:fulcrum';\n\ndefineTerrain(FULCRUM_ID, {\n  size: [260, 260],\n  cell: 2,\n  origin: [-130, 0, -130],\n  height: 0,\n  hills: [\n    { at: [0, 0], radius: 122, height: 12.5 },\n    { at: [0, 0], radius: 30, height: 4.5 },\n    { at: [0, -74], radius: 26, height: 9 },\n    { at: [0, -110], radius: 20, height: -22 },\n    { at: [-60, 96], radius: 40, height: -13 },\n    { at: [-70, -12], radius: 11, height: -5 },\n    { at: [84, -60], radius: 14, height: 3 },\n    { at: [0, 112], radius: 22, height: -7 },\n  ],\n  flats: [\n    { rect: [-12, 26, 16, 46], height: 8, margin: 7 },\n    { rect: [-64, 8, -40, 30], height: 7.4, margin: 6 },\n    { rect: [40, 12, 66, 34], height: 7.2, margin: 6 },\n    { rect: [56, 44, 78, 62], height: 5.2, margin: 6 },\n    { rect: [20, -56, 40, -40], height: 7, margin: 6 },\n    { rect: [-9, -93, 9, -80], height: 16, margin: 3 },\n    { rect: [66, 2, 84, 16], height: 6.6, margin: 5 },\n    { rect: [52, 74, 74, 94], height: 2.7, margin: 8 },\n  ],\n  high: 7,\n  materials: ['material:retreatSand', 'material:retreatSand', 'material:retreatLawn'],\n  surface: 'grass',\n});\n\n/** The terrain's heights. */\nexport const FULCRUM = () => getTerrain(FULCRUM_ID);\nvoid makeTerrain;\nE\ncat > labs/game/scenes/director.ts <<'E'\n/**\n * @file The director: the attract loop, and the driver that plays the whole game (the softlock finder, and dev mode's \"bot\n * plays for me\"). Attract is free to cheat: a perfect bot with no topples, each clip about fifteen seconds, then round\n * again. It never reaches the save, because only the page writes one, and only when attract is off.\n */\nimport { flowStepAttractGuard } from './attract-guard';\nimport { castOf } from './cast-ref';\nimport { nextItem, nextDay, startEvent, startGroup } from './flow';\nimport { flowOf, type W } from './types';\nimport { standAt } from './events/kit';\nimport { COAST } from './data/courses';\n\n/** The loop: activity, how long, options. */\nexport const ATTRACT: readonly { id: string; steps: number; only?: string }[] = [\n  { id: 'jog', steps: 900 },\n  { id: 'poseA', steps: 1500 },\n  { id: 'pond', steps: 1200 },\n  { id: 'line', steps: 900 },\n  { id: 'paddle', steps: 900 },\n  { id: 'garden', steps: 900 },\n  { id: 'step', steps: 900 },\n  { id: 'hoop', steps: 900 },\n  { id: 'plunge', steps: 1000 },\n  { id: 'tilt', steps: 1100, only: 'stone' },\n];\n\n/** Starts attract, or ends it. */\nexport function setAttract(w: W, on: boolean): void {\n  const flow = flowOf(w);\n  flow.auto = on;\n  flow.noTopple = on;\n  flow.bot = on ? 'perfect' : '';\n  flow.autoIndex = -1;\n  flow.autoT = 0;\n}\n\n/** One director step. */\nexport function directorStep(w: W): void {\n  const flow = flowOf(w);\n  flowStepAttractGuard(w);\n  if (flow.auto) {\n    flow.autoT -= 1;\n    if (flow.autoT <= 0 || flow.mode === 'results') {\n      flow.autoIndex = (flow.autoIndex + 1) % ATTRACT.length;\n      const clip = ATTRACT[flow.autoIndex];\n      flow.autoT = clip.steps;\n      flow.mode = 'front';\n      flow.group = null;\n      startEvent(w, clip.id, { only: clip.only });\n      w.emit('attractClip', { id: clip.id, index: flow.autoIndex } as never);\n    }\n    return;\n  }\n  if (!flow.drive) return;\n  driveStep(w);\n}\n\n/** The whole-game driver: goes on to the next thing whenever nothing is playing. */\nfunction driveStep(w: W): void {\n  const flow = flowOf(w);\n  if (flow.mode === 'event') {\n    flow.driveT = 0;\n    return;\n  }\n  flow.driveT += 1;\n  if (flow.driveT < 30) return;\n  flow.driveT = 0;\n  if (flow.mode === 'results') {\n    flow.mode = 'roam';\n    return;\n  }\n  if (flow.mode === 'credits') {\n    flow.day = 6;\n    flow.free = true;\n    flow.mode = 'roam';\n    flow.drive = false;\n    flow.bot = '';\n    w.emit('free', {} as never);\n    return;\n  }\n  if (flow.mode === 'evening') {\n    nextDay(w);\n    return;\n  }\n  if (flow.mode !== 'roam') return;\n  const next = nextItem(flow);\n  if (next === null) {\n    flow.mode = 'evening';\n    return;\n  }\n  if (next === 'walk') {\n    standAt(w, castOf(w).guest, 12, 38, Math.PI);\n    flow.done.push('walk');\n    return;\n  }\n  if (next === 'group') return startGroup(w);\n  startEvent(w, next);\n}\nvoid COAST;\nE\ncat > labs/game/scenes/attract-guard.ts <<'E'\n/**\n * @file Keeps attract's bot cheating: nothing it plays can leave the flow in a state that stops the loop. Attract never\n * reads or writes the save, and pays no pebbles.\n */\nimport { flowOf, type W } from './types';\n\n/** Attract earns nothing: pebbles and ages stay as they were. */\nexport function flowStepAttractGuard(w: W): void {\n  const flow = flowOf(w);\n  if (flow.auto) flow.group = null;\n}\nE\ncat > labs/game/scenes/round.ts <<'E'\n/**\n * @file The scene `game:round`: a session's small pavilion, and the rules of a Round. Three classes dealt from the stream\n * `deal`: the Still Ring, one of Heron, Hoop or Step, and Still Pond, each short. Every copy runs its own seeded round.\n * Other players arrive as ghosts through the custom intent `game:ghosts`, wobbling on the neighbouring mats, shown only\n * while they are in the same class. Nothing they do touches this copy's round.\n */\nimport { addBox, defineComponent, defineScene, physicsOf, removeProp, spawnProp, type Intents, type World } from '../../../engine/sim-api';\nimport { setLean, setPose } from '../cast/body';\nimport { spawnPerson } from '../cast/people';\nimport { CAST, castOf } from './cast-ref';\nimport { FRONT_MAT, MATS } from './data/stations';\nimport { standAt } from './events/kit';\nimport { FLOW_ACTIONS, flowStep, startGroup } from './flow';\nimport './settings';\nimport { ISLAND, SEAT, FLOW, WOBBLE, flowOf, seatOf, seatsOf, type C, type W } from './types';\nimport { seedSway } from './wobble';\n\n/** Marks the scene as a session's: stations all mean the pavilion here. */\nexport const ROUND_SCENE = defineComponent('roundScene', { description: 'This scene is a session’s.', fields: {} });\n\n/** A ghost: which seat it shows. */\nexport const GHOST = defineComponent('ghost', {\n  description: 'Another player, shown on a neighbouring mat. It never touches this copy’s round.',\n  fields: { seat: { type: 'integer', default: 0, description: 'Its seat.' } },\n});\n\nconst CLASS_CLIP: Readonly<Record<string, string>> = {\n  ring: 'RETREAT/Stand', heron: 'RETREAT/Heron', nothing: 'RETREAT/Nothing', hoop: 'RETREAT/HipCircle', hoopS: 'RETREAT/HipCircle',\n  stepS: 'RETREAT/StepUpL', pondS: 'RETREAT/Nothing', pond: 'RETREAT/Nothing', '': 'RETREAT/Stand',\n}; // prettier-ignore\n\n/** Message pose ids by number, the wire's small table. */\nexport const POSE_WIRE = ['', 'ring', 'heron', 'hoopS', 'stepS', 'pondS'] as const;\n\n/** Applies what ghosts sent: [seat, class, x, y, score, pose] sextuples. */\nfunction readGhosts(w: W, intents: Intents): void {\n  const data = (intents as unknown as Record<string, unknown>)['game:ghosts'] as number[] | undefined;\n  const flow = flowOf(w);\n  const myClass = flow.group ? flow.group.at : -1;\n  if (data) {\n    for (let k = 0; k + 5 < data.length; k += 6) {\n      const e = seatsOf(w).find((one) => one.seat.index === data[k]);\n      if (!e || e.seat.kind !== 'ghost') continue;\n      e.seat.shownClass = data[k + 1];\n      e.wobble.bx = data[k + 2];\n      e.wobble.by = data[k + 3];\n      e.seat.score = data[k + 4];\n      e.seat.pose = POSE_WIRE[data[k + 5]] ?? '';\n    }\n  }\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind !== 'ghost') continue;\n    e.wobble.x += (e.wobble.bx - e.wobble.x) * 0.15;\n    e.wobble.y += (e.wobble.by - e.wobble.y) * 0.15;\n    const here = e.seat.shownClass === myClass || myClass < 0;\n    const mat = MATS[e.seat.index];\n    standAt(w, e.seat.actor, here ? mat[0] : mat[0] * 3, here ? mat[1] : 12, Math.PI);\n    setPose(w, e.seat.actor, CLASS_CLIP[e.seat.pose] ?? 'RETREAT/Stand', 1);\n    setLean(w, e.seat.actor, e.wobble.x, e.wobble.y);\n  }\n}\n\n/** The small scene. */\nexport const round = defineScene<C>('game:round', {\n  description: 'A session’s round: the pavilion, four mats, the cast, three classes.',\n  physics: true,\n  setup(w) {\n    const world = w as unknown as World;\n    addBox(physicsOf(world), { type: 'fixed', size: [60, 1, 60], at: [0, -0.5, 0] } as never);\n    world.spawn({ flow: { mode: 'round' } } as never);\n    world.spawn({ island: {}, roundScene: {} } as never);\n    spawnProp(w, { prop: 'prop:pavilion', at: [0, 0, 0] });\n    spawnProp(w, { prop: 'prop:roundFloor', at: [0, 0, 0] });\n    MATS.forEach((m, i) => spawnProp(w, { prop: `prop:matSeat${i}`, at: [m[0], 0.01, m[1]] }));\n    const plumb = spawnPerson(w, { at: [FRONT_MAT[0], 0, FRONT_MAT[1]], body: 'body:plumb', build: 'build:plumb', speed: 2, secondary: { hair: 'ponytail' } });\n    world.spawn({ cast: { plumb, guest: -1 } } as never);\n    for (let i = 0; i < 4; i++) {\n      const m = MATS[i];\n      const actor = spawnPerson(w, { at: [m[0] * 3, 0, 12], body: `body:seat${i}`, build: 'build:chibi', speed: 3, yaw: Math.PI });\n      const id = world.spawn({ seat: { index: i, kind: 'none', actor }, wobble: {} } as never);\n      seedSway(w as unknown as W, (world.get(id) as unknown as { wobble: never }).wobble);\n    }\n  },\n  step(w, intents) {\n    const world = w as unknown as W;\n    readGhosts(world, intents);\n    flowStep(world, intents);\n  },\n  actions: {\n    ...(FLOW_ACTIONS as never),\n    /** Who sits where: my seat, and how many players. */\n    'round.seat': (w: World<C>, args: unknown) => {\n      const world = w as unknown as W;\n      const { me, players } = args as { me: number; players: number[] };\n      flowOf(world).meSeat = me;\n      for (const e of seatsOf(world)) {\n        const inRound = players.includes(e.seat.index);\n        e.seat.kind = e.seat.index === me ? 'human' : inRound ? 'ghost' : 'none';\n        if (e.seat.kind === 'ghost') (w as unknown as World).spawn({ ghost: { seat: e.seat.index } } as never);\n        const m = MATS[e.seat.index];\n        if (inRound) standAt(world, e.seat.actor, m[0], m[1], Math.PI);\n      }\n      (w as unknown as { emit(n: string, p: object): void }).emit('seated', { me });\n    },\n    /** The round begins. */\n    'round.go': (w: World<C>) => {\n      const world = w as unknown as W;\n      const flow = flowOf(world);\n      if (flow.group) return;\n      startGroup(world, [flow.meSeat, ...seatsOf(world).filter((e) => e.seat.kind === 'ghost').map((e) => e.seat.index)]);\n    },\n    /** A player left: they walk off politely. */\n    'round.leave': (w: World<C>, args: unknown) => {\n      const world = w as unknown as W;\n      const e = seatOf(world, (args as { seat: number }).seat);\n      if (!e || e.seat.kind !== 'ghost') return;\n      e.seat.kind = 'none';\n      standAt(world, e.seat.actor, MATS[e.seat.index][0] * 3, 12, 0);\n      const ev = flowOf(world).ev;\n      if (ev) ev.seats = ev.seats.filter((i) => i !== e.seat.index);\n      if (flowOf(world).group) flowOf(world).group!.seats = flowOf(world).group!.seats.filter((i) => i !== e.seat.index);\n    },\n  },\n});\n\nexport default round;\nvoid [CAST, ISLAND, SEAT, FLOW, WOBBLE, castOf, removeProp, setPose];\nE\ncat > labs/game/scenes/island.ts <<'E'\n/**\n * @file The scene `game:island`: the whole game, on one world. Terrain, sea, the dressed stations, the cast, the four seats.\n * Activities spawn their own bits at their stations and take them away again; the page drives it with scene actions.\n */\nimport { addTerrainBody, defineScene, physicsOf, spawnProp, stepCrowdBody, getTerrain, type World } from '../../../engine/sim-api';\nimport { GUEST_BUILDS, GUEST_SPEED, guestBody, PEOPLE, spawnPerson } from '../cast/people';\nimport { CAST, castOf } from './cast-ref';\nimport { DRESSING, HIDDEN_PEBBLES, PLAQUES, BENCHES } from './data/places';\nimport { setAttract, directorStep } from './director';\nimport { groundAt, moveProp, tiltQuat } from './events/kit';\nimport { stepTiltCrowd } from './events/tilt';\nimport { FLOW_ACTIONS, flowStep } from './flow';\nimport { pilot } from './pilot';\nimport './settings';\nimport { FULCRUM_ID } from './terrain';\nimport { flowOf, islandOf, say, type C, type W } from './types';\nimport { seedSway } from './wobble';\nimport { setLean, setPose } from '../cast/body';\nimport { rankOf } from './data/days';\n\n/** A pebble on the cairn or a hidden one. */\nexport const PEBBLE = { description: 'marks' };\n\nconst SEA_Y = 2;\n\nfunction spawnAt(w: W, prop: string, x: number, z: number, yaw = 0, lift = 0): number {\n  return spawnProp(w, { prop, at: [x, groundAt(w, x, z) + lift, z], yaw });\n}\n\n/** Stands everything on the island once. */\nfunction dress(w: W): void {\n  for (const [prop, x, z, yaw] of DRESSING) spawnAt(w, prop, x, z, yaw);\n  PLAQUES.forEach((p, k) => {\n    const id = spawnAt(w, 'prop:plaque', p[0], p[1], k * 1.3);\n    w.spawn({ plaque: { k, id } } as never);\n  });\n  HIDDEN_PEBBLES.forEach((p, k) => {\n    const id = spawnAt(w, 'prop:hiddenPebble', p[0], p[1], k, 0.02);\n    w.spawn({ pebble: { k, id } } as never);\n  });\n  for (const b of BENCHES) spawnAt(w, 'prop:bench', b[0], b[1], b[2]);\n  const pondFloor = groundAt(w, -70, -12);\n  spawnProp(w, { prop: 'prop:pondWater', at: [-70, pondFloor + 0.9, -12] });\n}\n\n/** Moves things that show the tilt: plaques creep, drinks slide, the sea leans a hair. */\nfunction storyStep(w: W): void {\n  const flow = flowOf(w);\n  const island = islandOf(w);\n  island.seaT += 1 / 60;\n  const sea = (w.query('seaProp' as never)[0] as unknown as { id: number; seaProp: { id: number } } | undefined)?.seaProp.id;\n  if (sea !== undefined) {\n    const lean = (island.finale ? -island.tiltX : island.tilt * 0.12) * (Math.PI / 180);\n    const leanZ = (island.finale ? -island.tiltZ : 0) * (Math.PI / 180);\n    const bob = Math.sin(island.seaT * 0.6) * 0.05 - 0.05;\n    moveProp(w, sea, [Math.sin(island.seaT * 0.02) * 6, SEA_Y + bob, Math.cos(island.seaT * 0.017) * 6], tiltQuat(leanZ, lean));\n  }\n  for (const e of w.query('plaque' as never) as unknown as { plaque: { k: number; id: number } }[]) {\n    const p = PLAQUES[e.plaque.k];\n    const creep = 1 + (Math.min(flow.day, 5) - 1) * 0.012;\n    const [x, z] = [p[0] * creep, p[1] * creep];\n    if (w.tick % 120 === e.plaque.k) moveProp(w, e.plaque.id, [x, groundAt(w, x, z), z], [0, Math.sin(e.plaque.k * 0.65), 0, Math.cos(e.plaque.k * 0.65)]);\n  }\n  for (const e of w.query('pebble' as never) as unknown as { pebble: { k: number; id: number } }[]) {\n    if (flow.found.includes(e.pebble.k) && (w.get(e.pebble.id) as unknown as { sceneProp: { y: number } }).sceneProp.y > -5) moveProp(w, e.pebble.id, [0, -30, 0]);\n  }\n  for (const e of w.query('drink' as never) as unknown as { drink: { id: number; x: number; z: number; k: number } }[]) {\n    const run = island.tilt * 0.25;\n    const at = ((island.seaT * 0.05 * (e.drink.k + 2)) % 1) * run;\n    moveProp(w, e.drink.id, [e.drink.x + at, 8.96, e.drink.z]);\n  }\n  for (const e of w.query('rollMarble' as never) as unknown as { rollMarble: { id: number; k: number } }[]) {\n    const show = flow.day >= 4;\n    const a = island.seaT * 0.5 + e.rollMarble.k * 2;\n    moveProp(w, e.rollMarble.id, show ? [30 + Math.cos(a) * 1.8, 7.95, -48 + Math.sin(a) * 1.2] : [0, -30, 0]);\n  }\n  cairnStep(w);\n}\n\n/** Drops earned pebbles on the cairn, one by one. */\nfunction cairnStep(w: W): void {\n  const flow = flowOf(w);\n  const cairn = w.query('cairn' as never)[0] as unknown as { cairn: { ids: number[] } };\n  flow.cairnT += 1;\n  if (flow.cairnShown < Math.min(flow.pebbles, cairn.cairn.ids.length) && flow.cairnT > 18) {\n    flow.cairnT = 0;\n    flow.cairnShown += 1;\n    w.emit('clack', {} as never);\n  } else if (flow.cairnShown > flow.pebbles) flow.cairnShown = flow.pebbles;\n  const age = flow.ages[flow.ages.length - 1] ?? 60;\n  const lean = ((age - 18) / 64) * 0.09;\n  cairn.cairn.ids.forEach((id, k) => {\n    if (k % 7 !== w.tick % 7) return;\n    const layer = Math.floor(Math.sqrt(k) * 0.9);\n    const ring = Math.max(0, 5 - layer) * 0.16;\n    const y = 8.05 + layer * 0.15;\n    const a = k * 2.4;\n    const show = k < flow.cairnShown;\n    moveProp(w, id, show ? [-12 + Math.cos(a) * ring + y * lean - 0.7, y, 30 + Math.sin(a) * ring] : [0, -30, 0], [0, Math.sin(a / 2), 0, Math.cos(a / 2)]);\n  });\n}\n\n/** Gull and Frog: blobs, cheap and very funny. */\nfunction critters(w: W): void {\n  const cast = castOf(w);\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  const gull = w.get(cast.gull) as unknown as { crowdBody: never; id: number } | undefined;\n  const frog = w.get(cast.frog) as unknown as { crowdBody: never; id: number } | undefined;\n  const guest = (w.get(cast.guest) as unknown as { actor: { x: number; y: number; z: number } }).actor;\n  const t = w.tick / 60;\n  if (gull) {\n    const onHead = ev?.id === 'pond' && (ev.d as { gullOn?: boolean }).gullOn;\n    const onArm = ev?.id === 'line' && ((ev.d as { gull?: number }).gull ?? 0) !== 0;\n    const onBack = ev?.id === 'poseB' && (ev.d as { list?: string[]; at?: number }).list?.[(ev.d as { at: number }).at] === 'napkin' && ev.phase === 'hold';\n    const at: [number, number, number] = onHead\n      ? [guest.x, guest.y + 1.5, guest.z]\n      : onArm\n        ? [guest.x, guest.y + 1.1, guest.z + 0.55]\n        : onBack\n          ? [guest.x, guest.y + 1.1, guest.z]\n          : [20 + Math.cos(t * 0.3) * 40, 16 + Math.sin(t * 0.7) * 2, 40 + Math.sin(t * 0.3) * 40];\n    stepCrowdBody(w as never, cast.gull, gull.crowdBody, { at, velocity: [Math.sin(t) * 2, 0, Math.cos(t) * 2], blob: { flap: 1 } } as never);\n  }\n  if (frog) {\n    const onKnee = ev?.id === 'pond' && (ev.d as { onKnee?: boolean }).onKnee;\n    const look = ev?.id === 'pond' && ((ev.d as { frogLook?: number }).frogLook ?? 0) > 0;\n    const at: [number, number, number] = onKnee ? [guest.x + 0.25, guest.y + 0.45, guest.z - 0.3] : [-67.6, groundAt(w, -67.6, -13.2) + 1.1, -13.2];\n    stepCrowdBody(w as never, cast.frog, frog.crowdBody, { at, velocity: [0, 0, 0], blob: look ? { look: [guest.x - at[0], guest.z - at[2]] } : {} } as never);\n  }\n}\n\n/** Plumb in the Pavilion when not teaching, the others about the island. */\nfunction standAround(w: W): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  if (flow.mode === 'event') return;\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    setPose(w, id, id === cast.plumb ? 'RETREAT/Stand' : 'RETREAT/Stand', 0);\n    setLean(w, id, 0, 0);\n  }\n}\n\nexport const island = defineScene<C>('game:island', {\n  description: 'Little Fulcrum: the whole game on one world.',\n  physics: true,\n  terrain: FULCRUM_ID,\n  setup(w) {\n    const world = w as unknown as World;\n    addTerrainBody(physicsOf(world), getTerrain(FULCRUM_ID));\n    world.spawn({ flow: {} } as never);\n    world.spawn({ island: {} } as never);\n    dress(w as unknown as W);\n    const sea = spawnProp(w, { prop: 'prop:sea', at: [0, SEA_Y, 0] });\n    world.spawn({ seaProp: { id: sea } } as never);\n    const table = [\n      [-11.6, 39.8], [-10.8, 40.2], [-11.1, 39.5], [-10.4, 39.7],\n    ]; // prettier-ignore\n    table.forEach(([x, z], k) => world.spawn({ drink: { id: spawnProp(w, { prop: 'prop:drink', at: [x, 8.96, z] }), x, z, k } } as never));\n    [0, 1, 2].forEach((k) => world.spawn({ rollMarble: { id: spawnProp(w, { prop: 'prop:marble', at: [0, -30, 0] }), k } } as never));\n    const ids: number[] = [];\n    for (let k = 0; k < 90; k++) ids.push(spawnProp(w, { prop: `prop:cairnPebble${k % 4}`, at: [0, -30, 0] }));\n    world.spawn({ cairn: { ids } } as never);\n    const stand = (who: string, x: number, z: number, yaw = 0) =>\n      spawnPerson(w, { at: [x, groundAt(w as unknown as W, x, z) + 0.05, z], yaw, ...PEOPLE[who] });\n    const guest = spawnPerson(w, { at: [0, groundAt(w as unknown as W, 0, 86) + 0.05, 86], body: guestBody(0, 0), build: GUEST_BUILDS[0], speed: GUEST_SPEED, yaw: Math.PI });\n    const plumb = stand('plumb', -52, 12);\n    const tare = stand('tare', 3, 84, Math.PI);\n    const gerald = stand('gerald', 4, 38, 0.8);\n    const bex = stand('bex', 15, 24, -0.6);\n    const nan = stand('nan', -8, 30, 1.8);\n    const extras = [stand('extra0', 49, 28), stand('extra1', 52, 28), stand('extra2', 55, 28)];\n    const gull = world.spawn({ crowdBody: { rig: 'blob', look: 'wings', x: 20, y: 16, z: 40, size: 0.28 } } as never);\n    const frog = world.spawn({ crowdBody: { rig: 'blob', look: 'ears', x: -67, y: 6, z: -13, size: 0.2 } } as never);\n    world.spawn({ cast: { plumb, tare, gerald, bex, nan, guest, gull, frog, extras } } as never);\n    const others = [gerald, bex, nan];\n    for (let i = 0; i < 4; i++) {\n      const id = world.spawn({ seat: { index: i, kind: i === 0 ? 'human' : 'cpu', actor: i === 0 ? guest : others[i - 1] }, wobble: {} } as never);\n      seedSway(w as unknown as W, (world.get(id) as unknown as { wobble: never }).wobble);\n    }\n    w.systems.add('game.critters', (now) => critters(now as unknown as W), { phase: 'anim' });\n    w.systems.add('game.tiltCrowd', (now) => stepTiltCrowd(now as unknown as W), { phase: 'anim' });\n    (w as unknown as { emit(n: string, p: object): void }).emit('ready', {});\n  },\n  step(w, intents) {\n    const world = w as unknown as W;\n    flowStep(world, intents);\n    pilot(world, intents);\n    standAround(world);\n    storyStep(world);\n    directorStep(world);\n  },\n  actions: {\n    ...(FLOW_ACTIONS as never),\n    /** Attract on or off. */\n    'game.attract': (w: World<C>, args: unknown) => setAttract(w as unknown as W, (args as { on: boolean }).on),\n    /** The whole-game driver. */\n    'game.drive': (w: World<C>, args: unknown) => {\n      const flow = flowOf(w as unknown as W);\n      Object.assign(flow, { drive: true, bot: (args as { skill?: string }).skill ?? 'perfect' });\n    },\n    /** A line said on request (the walk-up remark, the final remark). */\n    'game.say': (w: World<C>, args: unknown) => {\n      const { line, who } = args as { line: string; who: string };\n      say(w as unknown as W, line, who);\n    },\n  },\n});\n\nexport default island;\nvoid [CAST, rankOf];\nE\npython3 - <<'E'\np='labs/game/scenes/types.ts';s=open(p).read()\ns+=\"\"\"\nfor (const [name, description, field] of [\n  ['plaque', 'A plaque.', 'k'],\n  ['pebble', 'A hidden pebble.', 'k'],\n  ['drink', 'A drink on the table.', 'k'],\n  ['rollMarble', 'A marble nobody is rolling.', 'k'],\n] as const) {\n  defineComponent(name, {\n    description,\n    fields: {\n      [field]: { type: 'integer', default: 0, description: 'Which.' },\n      id: { type: 'integer', default: -1, description: 'Its prop.' },\n      x: { type: 'number', default: 0, description: 'Rest place, east.' },\n      z: { type: 'number', default: 0, description: 'Rest place, south.' },\n    },\n  });\n}\ndefineComponent('seaProp', { description: 'The sea.', fields: { id: { type: 'integer', default: -1, description: 'Its prop.' } } });\ndefineComponent('cairn', { description: 'The pebbles of your cairn.', fields: { ids: { type: 'array', default: [], description: 'Their props.' } } });\n\"\"\"\nopen(p,'w').write(s)\nE\ncat > labs/game/props/index.ts <<'E'\n/**\n * @file Every prop of Wee Tare, data only. Parts stand on the base, in metres, built from the engine's geometry kit with\n * materials by id. Props that move have no body: the sim writes their pose and nothing collides with them.\n */\nimport { defineProp } from '../../../engine/sim-api';\n\ntype Part = { g?: string; p: Record<string, number>; m?: string; at?: readonly [number, number, number]; tint?: string; rot?: readonly number[] };\nconst BOX = 'geometry:box';\nconst ROUND = 'geometry:roundedBox';\nconst LIMB = 'geometry:limb';\nconst FRUSTUM = 'geometry:frustum';\nconst PILLAR = 'geometry:pillar';\nconst RING = 'geometry:ring';\n\n/** Defines a prop from short parts. */\nfunction prop(name: string, description: string, parts: readonly Part[], size?: readonly [number, number, number]): void {\n  defineProp(`prop:${name}`, {\n    description,\n    parts: parts.map((part, k) => ({\n      name: `part${k}`,\n      geometry: part.g ?? BOX,\n      params: part.p,\n      material: part.m ?? 'material:retreatWhite',\n      ...(part.at ? { position: [...part.at] } : {}),\n      ...(part.tint ? { tint: part.tint } : {}),\n      ...(part.rot ? { rotation: [...part.rot] } : {}),\n    })),\n    ...(size ? { body: { type: 'fixed', shape: 'box', size: [...size] } } : {}),\n  } as never);\n}\n\nconst SEAT_COLOURS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nSEAT_COLOURS.forEach((tint, i) => prop(`matSeat${i}`, 'A class mat in a seat’s colour.', [{ g: ROUND, p: { width: 1.5, height: 0.05, depth: 2.3, radius: 0.02 }, m: 'material:retreatMat', tint }]));\n\nprop('platform', 'Tare’s Platform: a low round stage.', [\n  { g: FRUSTUM, p: { bottom: 2.6, top: 2.4, height: 0.4 }, tint: '#f7fafc' },\n  { g: RING, p: { radius: 2.2, thickness: 0.08 }, m: 'material:retreatMint', at: [0, 0.41, 0] },\n]);\nprop('platformRing', 'The bright ring of a Morning Check.', [{ g: RING, p: { radius: 1.1, thickness: 0.05 }, m: 'material:retreatCoral' }]);\nprop('noticeboard', 'The Noticeboard.', [\n  { p: { width: 3, height: 1.8, depth: 0.1 }, at: [0, 1, 0], tint: '#f7fafc' },\n  { p: { width: 2.7, height: 1.5, depth: 0.12 }, at: [0, 1.15, 0], m: 'material:retreatMint' },\n  { g: LIMB, p: { length: 1, radiusStart: 0.06, radiusEnd: 0.06 }, at: [-1.3, 0, 0] },\n  { g: LIMB, p: { length: 1, radiusStart: 0.06, radiusEnd: 0.06 }, at: [1.3, 0, 0] },\n]);\nprop('plaque', 'A “Did you know?” plaque on a little post.', [\n  { g: LIMB, p: { length: 0.8, radiusStart: 0.04, radiusEnd: 0.04 }, tint: '#a8b4bc' },\n  { p: { width: 0.6, height: 0.36, depth: 0.05 }, at: [0, 0.8, 0], m: 'material:retreatBrass' },\n]);\nprop('hiddenPebble', 'A pebble somebody has placed with care.', [{ g: ROUND, p: { width: 0.38, height: 0.2, depth: 0.3, radius: 0.09 }, m: 'material:retreatCoral' }]);\n['#d7dee2', '#b8c6cc', '#e8e1cf', '#9fb4a8'].forEach((tint, k) => prop(`cairnPebble${k}`, 'A pebble of your cairn.', [{ g: ROUND, p: { width: 0.34, height: 0.15, depth: 0.28, radius: 0.07 }, m: 'material:retreatStone', tint }]));\nprop('bench', 'A clean white bench.', [\n  { p: { width: 1.8, height: 0.08, depth: 0.5 }, at: [0, 0.45, 0] },\n  { p: { width: 1.8, height: 0.5, depth: 0.08 }, at: [0, 0.6, -0.22] },\n  { p: { width: 0.1, height: 0.45, depth: 0.45 }, at: [-0.8, 0, 0], tint: '#a8b4bc' },\n  { p: { width: 0.1, height: 0.45, depth: 0.45 }, at: [0.8, 0, 0], tint: '#a8b4bc' },\n]);\nprop('pavilion', 'The Pose Pavilion: white floor, pale curtains, open sides.', [\n  { p: { width: 22, height: 0.15, depth: 16 }, at: [0, 0, 1], tint: '#f7fafc' },\n  ...[[-10, -6], [10, -6], [-10, 8], [10, 8], [0, -6], [0, 8]].map(([x, z]) => ({ g: PILLAR, p: { width: 0.5, height: 5.2 }, at: [x, 0.15, z] as const })),\n  { g: FRUSTUM, p: { bottom: 14, top: 2, height: 2.6 }, at: [0, 5.4, 1], tint: '#f7fafc' },\n  { p: { width: 3, height: 4.6, depth: 0.1 }, at: [-6.5, 0.4, -6.2], m: 'material:retreatCurtain' },\n  { p: { width: 3, height: 4.6, depth: 0.1 }, at: [6.5, 0.4, -6.2], m: 'material:retreatCurtain' },\n]);\nprop('roundFloor', 'The ground round a session’s pavilion.', [{ p: { width: 120, height: 0.05, depth: 120 }, at: [0, -0.06, 0], m: 'material:retreatLawn' }]);\nprop('annex', 'The Annex: one long open roof over a mirror wall.', [\n  { p: { width: 26, height: 0.15, depth: 18 }, at: [0, 0, 0], tint: '#f7fafc' },\n  { p: { width: 26, height: 4.2, depth: 0.2 }, at: [0, 0.15, -9], m: 'material:retreatMirror' },\n  { p: { width: 28, height: 0.3, depth: 20 }, at: [0, 4.6, 0], tint: '#f7fafc' },\n  ...[[-12.5, 8.5], [12.5, 8.5], [-12.5, -8.5], [12.5, -8.5], [0, 8.5]].map(([x, z]) => ({ g: PILLAR, p: { width: 0.4, height: 4.5 }, at: [x, 0.15, z] as const })),\n]);\nprop('stepPlatform', 'A low stepping platform.', [{ g: ROUND, p: { width: 1.6, height: 0.16, depth: 1, radius: 0.05 }, m: 'material:retreatMint' }]);\nprop('floorTile', 'A floor tile that lights on the beat.', [{ p: { width: 1.4, height: 0.03, depth: 1.4 }, m: 'material:retreatCoral' }]);\nprop('hut', 'A guest hut.', [\n  { p: { width: 5, height: 2.6, depth: 4 } },\n  { g: FRUSTUM, p: { bottom: 3.6, top: 0.4, height: 1.5 }, at: [0, 2.6, 0], m: 'material:retreatCoral' },\n  { p: { width: 1, height: 1.9, depth: 0.1 }, at: [0, 0, 2.02], m: 'material:retreatMint' },\n]);\nprop('ferryPier', 'The pier.', [\n  { p: { width: 4, height: 0.2, depth: 22 }, at: [0, 0.4, 2], m: 'material:retreatWood' },\n  ...[-6, 2, 10].flatMap((z) => [-1.8, 1.8].map((x) => ({ g: PILLAR, p: { width: 0.3, height: 2.5 }, at: [x, -2, z] as const, m: 'material:retreatWood' }))),\n  { p: { width: 5, height: 1.4, depth: 12 }, at: [8, -0.3, 8], tint: '#f7fafc' },\n  { p: { width: 3, height: 1.4, depth: 4 }, at: [8, 1.1, 6], m: 'material:retreatMint' },\n]);\nprop('lighthouse', 'The lighthouse.', [\n  { g: FRUSTUM, p: { bottom: 2.6, top: 1.6, height: 11 } },\n  { g: FRUSTUM, p: { bottom: 1.62, top: 1.5, height: 2 }, at: [0, 7, 0], m: 'material:retreatCoral' },\n  { g: FRUSTUM, p: { bottom: 1.2, top: 1.1, height: 1.6 }, at: [0, 11, 0], m: 'material:retreatLamp' },\n  { g: FRUSTUM, p: { bottom: 1.5, top: 0.2, height: 1 }, at: [0, 12.6, 0], m: 'material:retreatCoral' },\n]);\nprop('centreStone', 'A plain stone with a brass plate reading “Do not”.', [\n  { g: FRUSTUM, p: { bottom: 1.5, top: 1.1, height: 0.4 }, m: 'material:retreatStone' },\n  { p: { width: 0.6, height: 0.03, depth: 0.3 }, at: [0, 0.4, 0], m: 'material:retreatBrass' },\n]);\nprop('sandTerrace', 'A raked terrace of pale gravel.', [{ p: { width: 22, height: 0.06, depth: 18 }, m: 'material:retreatSand' }]);\nprop('eastTerrace', 'The East Terrace: fully booked.', [\n  { p: { width: 20, height: 0.12, depth: 16 }, tint: '#f7fafc' },\n  { g: FRUSTUM, p: { bottom: 3, top: 0.1, height: 1 }, at: [-5, 2.6, -4], m: 'material:retreatCoral' },\n  { g: LIMB, p: { length: 2.6, radiusStart: 0.05, radiusEnd: 0.05 }, at: [-5, 0, -4] },\n]);\nprop('cliffLip', 'The diving board at the cliff’s lip.', [{ p: { width: 2.4, height: 0.1, depth: 3.5 }, at: [0, 0, -2], m: 'material:retreatWood' }]);\nprop('parasol', 'A parasol.', [\n  { g: LIMB, p: { length: 2.5, radiusStart: 0.05, radiusEnd: 0.05 } },\n  { g: FRUSTUM, p: { bottom: 2, top: 0.1, height: 0.8 }, at: [0, 2.3, 0], m: 'material:retreatCoral' },\n]);\nprop('lounger', 'A sun lounger.', [\n  { g: ROUND, p: { width: 0.7, height: 0.1, depth: 1.9, radius: 0.04 }, at: [0, 0.3, 0], m: 'material:retreatMint' },\n  { p: { width: 0.7, height: 0.3, depth: 0.1 }, at: [0, 0, 0.8] },\n  { p: { width: 0.7, height: 0.3, depth: 0.1 }, at: [0, 0, -0.8] },\n]);\nprop('palm', 'A very tidy palm.', [\n  { g: LIMB, p: { length: 5.4, radiusStart: 0.2, radiusEnd: 0.1 }, m: 'material:retreatWood' },\n  ...[0, 1, 2, 3, 4].map((k) => ({ g: ROUND, p: { width: 3.2, height: 0.08, depth: 0.7, radius: 0.03 }, at: [Math.cos(k * 1.26) * 1.3, 5.3, Math.sin(k * 1.26) * 1.3] as const, m: 'material:retreatPalm', rot: [0, -k * 1.26, 0.24] })),\n]);\nprop('rock', 'A rock that seems to know.', [{ g: ROUND, p: { width: 3.2, height: 1.6, depth: 2.4, radius: 0.5 }, m: 'material:retreatStone' }]);\nprop('jetty', 'The jetty at Still Pond.', [{ p: { width: 2, height: 0.12, depth: 7 }, m: 'material:retreatWood' }]);\nprop('jettyPosts', 'The jetty’s posts.', [-0.9, 0.9].map((x) => ({ g: PILLAR, p: { width: 0.2, height: 2 }, at: [x, -0.3, 0] as const, m: 'material:retreatWood' })));\nprop('pondWater', 'Still Pond’s still water.', [{ g: FRUSTUM, p: { bottom: 12, top: 12, height: 0.02 }, m: 'material:retreatPond' }]);\nprop('sea', 'The sea: one huge flat sheet, drifting slowly.', [{ p: { width: 1400, height: 0.02, depth: 1400 }, m: 'material:retreatSea' }]);\nprop('drink', 'A drink. It is a feature of the drink.', [{ g: FRUSTUM, p: { bottom: 0.07, top: 0.09, height: 0.2 }, m: 'material:retreatDrink' }]);\nprop('drinksTable', 'A drinks table.', [\n  { p: { width: 2.2, height: 0.08, depth: 1.2 }, at: [0, 0.88, 0] },\n  { g: LIMB, p: { length: 0.88, radiusStart: 0.06, radiusEnd: 0.06 } },\n]);\nprop('linePost', 'A post that holds the line.', [{ g: PILLAR, p: { width: 0.5, height: 5.3 }, m: 'material:retreatWood' }]);\nprop('slackline', 'The Line: forty metres, very slack.', [{ p: { width: 41, height: 0.05, depth: 0.08 }, m: 'material:retreatCoral' }]);\nprop('lineFlag', 'A flag on the line.', [\n  { g: LIMB, p: { length: 1.2, radiusStart: 0.02, radiusEnd: 0.02 } },\n  { p: { width: 0.5, height: 0.28, depth: 0.02 }, at: [0.25, 0.92, 0], m: 'material:retreatCoral' },\n]);\nprop('tareBoat', 'Tare’s little boat.', [\n  { g: ROUND, p: { width: 2.4, height: 0.5, depth: 1.2, radius: 0.2 }, m: 'material:retreatMint' },\n  { g: LIMB, p: { length: 1.6, radiusStart: 0.03, radiusEnd: 0.03 }, at: [0.6, 0.4, 0] },\n  { p: { width: 0.5, height: 0.3, depth: 0.02 }, at: [0.86, 1.65, 0], m: 'material:retreatCoral' },\n]);\nprop('board', 'A paddleboard.', [{ g: ROUND, p: { width: 0.85, height: 0.12, depth: 3.2, radius: 0.05 }, m: 'material:retreatCoral' }]);\nprop('buoy', 'A buoy gate.', [\n  { g: FRUSTUM, p: { bottom: 0.5, top: 0.28, height: 1 }, m: 'material:retreatCoral' },\n  { g: LIMB, p: { length: 1, radiusStart: 0.04, radiusEnd: 0.04 }, at: [0, 1, 0] },\n]);\nprop('turtle', 'A crossing turtle.', [\n  { g: ROUND, p: { width: 1, height: 0.25, depth: 1.3, radius: 0.12 }, m: 'material:retreatPalm' },\n  { g: ROUND, p: { width: 0.3, height: 0.2, depth: 0.3, radius: 0.1 }, at: [0, 0.05, 0.75], m: 'material:retreatLawn' },\n]);\nprop('tray', 'A raked sand tray.', [\n  { p: { width: 3.2, height: 0.1, depth: 3.2 }, at: [0, -0.1, 0], m: 'material:retreatWood' },\n  { p: { width: 3, height: 0.02, depth: 3 }, m: 'material:retreatSand' },\n  { p: { width: 3.2, height: 0.12, depth: 0.1 }, at: [0, 0, -1.55], m: 'material:retreatWood' },\n  { p: { width: 3.2, height: 0.12, depth: 0.1 }, at: [0, 0, 1.55], m: 'material:retreatWood' },\n  { p: { width: 0.1, height: 0.12, depth: 3.2 }, at: [-1.55, 0, 0], m: 'material:retreatWood' },\n  { p: { width: 0.1, height: 0.12, depth: 3.2 }, at: [1.55, 0, 0], m: 'material:retreatWood' },\n]);\nprop('trayStand', 'The tray’s stand.', [{ g: PILLAR, p: { width: 0.5, height: 0.7 } }]);\nprop('trayHole', 'A hole in the sand.', [{ g: RING, p: { radius: 0.2, thickness: 0.05 }, m: 'material:retreatCoral' }]);\nprop('trayRidge', 'A raked ridge.', [{ p: { width: 1.1, height: 0.08, depth: 0.08 }, m: 'material:retreatStone' }]);\nprop('marble', 'A marble.', [{ g: ROUND, p: { width: 0.22, height: 0.22, depth: 0.22, radius: 0.11 }, m: 'material:retreatMarble' }]);\nprop('hoop', 'A hoop.', [{ g: RING, p: { radius: 0.55, thickness: 0.04 }, m: 'material:retreatCoral' }]);\nprop('scoreRaft', 'A gull judge’s raft.', [\n  { g: ROUND, p: { width: 1.6, height: 0.2, depth: 1.2, radius: 0.08 }, m: 'material:retreatWood' },\n  { p: { width: 1, height: 0.7, depth: 0.05 }, at: [0, 1, 0] },\n  { g: LIMB, p: { length: 1, radiusStart: 0.03, radiusEnd: 0.03 }, at: [0, 0.2, -0.1] },\n]);\nprop('cart', 'A counterweight cart, full of your pebbles.', [\n  { p: { width: 3, height: 0.8, depth: 1.6 }, at: [0, 0.3, 0], m: 'material:retreatWood' },\n  { g: ROUND, p: { width: 2.6, height: 0.5, depth: 1.2, radius: 0.2 }, at: [0, 1, 0], m: 'material:retreatStone' },\n]);\nprop('rails', 'The rails.', [-0.7, 0.7, 1.5, 2.9].map((z) => ({ p: { width: 30, height: 0.06, depth: 0.1 }, at: [0, 0, z] as const, m: 'material:retreatWood' })));\nE\nsed -n 1,40p engine/world/props/place.ts | grep -n \"rotation\\|position\\|yaw\" | head; grep -n \"params\\|description\" engine/gfx/geometry/kit.ts 2>/dev/null | head -5; node x describe geometry geometry:frustum 2>&1 | head -12 | cut -c1-120; node x describe geometry geometry:pillar 2>&1 | sed -n 2,10p | cut -c1-120;node x describe geometry geometry:ring 2>&1 | sed -n 2,10p | cut -c1-120; node x describe geometry geometry:limb 2>&1 | sed -n 2,10p | cut -c1-120; node x describe geometry geometry:roundedBox 2>&1 | sed -n 2,10p | cut -c1-120; grep -n \"rotation\\|euler\\|rotate\\|position:\" engine/world/props/*.ts | head -10 | cut -c1-130","description":"Write flow, pilot, terrain, director, round, island, props","timeout":60000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14763,"cache_read_input_tokens":264509,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14763},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"3501c7cc-8d5f-45e4-9540-8b8bfab234bb","timestamp":"2026-11-05T10:04:09.750Z","request_id":"req_011CgjaxJHwnJPDCDtFbBhiP","wire_tool_inputs":{"toolu_01DirEw4CSoD6L9iBv1WmpKA":{"command":"python3 - <<'E'\np='labs/game/scenes/events/kit.ts';s=open(p).read()\ns=s.replace(\"\"\"export const playing = (w: W, ev: EvState): SeatE[] =>\n  seatsOf(w).filter((e) => ev.seats.includes(e.seat.index) && e.seat.kind !== 'none');\"\"\",\"\"\"export const playing = (w: W, ev: EvState): SeatE[] => {\n  const seats = seatsOf(w);\n  return ev.seats.map((i) => seats.find((e) => e.seat.index === i) as SeatE).filter((e) => e && e.seat.kind !== 'none');\n};\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/types.ts';s=open(p).read()\ns=s.replace(\"\"\"  /** Finale score pieces. */\n  tiltScore: number;\n}\"\"\",\"\"\"  /** Finale score pieces. */\n  tiltScore: number;\n  /** What the guest could use now, as `kind:id`, and how many times each person has been talked to today. */\n  near: string;\n  talk: Record<string, number>;\n  /** Sitting on a bench. */\n  sit: number;\n  /** Steps since the last pebble dropped on the cairn; how many stand on it. */\n  cairnT: number;\n  cairnShown: number;\n  /** Lets a menu pick wait: the Day 1 walk is done. */\n  walked: boolean;\n}\"\"\")\ns=s.replace(\"\"\"    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n\"\"\",\"\"\"    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n    near: { type: 'string', default: '', description: 'What the guest could use now.' },\n    talk: { type: 'object', default: {}, description: 'Talks today, per person.' },\n    sit: { type: 'integer', default: 0, description: 'Steps sat on a bench.' },\n    cairnT: { type: 'integer', default: 0, description: 'Steps since the last pebble dropped.' },\n    cairnShown: { type: 'integer', default: 0, description: 'Pebbles standing on the cairn.' },\n    walked: { type: 'boolean', default: false, description: 'The Day 1 walk is done.' },\n\"\"\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/flow.ts <<'E'\n/**\n * @file The game's state machine: starting and ending activities, results, the day, Group Class's list of classes, the\n * scene actions every menu pick goes through, and the input each seat gets each step. Everything here is sim state, so a\n * replay holds every pick. The page sends picks with `inspector.actions.run` and reads `flow` back.\n */\nimport { pressed, type Intents } from '../../../engine/sim-api';\nimport { clearBody, setLean } from '../cast/body';\nimport { applyOrder, SKILLS } from './bot/players';\nimport { castOf } from './cast-ref';\nimport { ageOf, DAYS, rankOf } from './data/days';\nimport { STATIONS, type StationId } from './data/stations';\nimport { ACTIVITIES } from './events';\nimport { clearOwned, standAt } from './events/kit';\nimport { gameNumber } from './settings';\nimport { cue, flowOf, islandOf, say, seatsOf, type EvState, type Flow, type SeatE, type W } from './types';\nimport { resetWobble } from './wobble';\n\n/** Where you are left standing when an activity at each station ends. */\nconst LANDINGS: Readonly<Record<StationId, readonly [number, number]>> = {\n  pier: [0, 84], plaza: [0, 40], pavilion: [-52, 28], pond: [-60, -8], annex: [52, 32], huts: [58, 46],\n  lagoon: [-36, 66], terrace: [30, -41], cliff: [0, -80], hoopBeach: [58, 76], lighthouse: [78, -54], east: [70, 8], stone: [0, 6],\n}; // prettier-ignore\n\n/** Options for starting an activity. */\nexport interface StartOptions { short?: boolean; expert?: boolean; final?: boolean; only?: string; seats?: number[] }\n\n/** Starts activity `id`, ending any that runs. */\nexport function startEvent(w: W, id: string, options: StartOptions = {}): void {\n  const flow = flowOf(w);\n  if (flow.ev) endWithoutResult(w);\n  const activity = ACTIVITIES[id];\n  if (!activity) return;\n  const multi = activity.multi && !options.seats;\n  const seats = options.seats ?? (multi ? seatsOf(w).filter((e) => e.seat.kind !== 'none').map((e) => e.seat.index) : [0]);\n  // Seats not in this activity stand down; CPU guests hold the other mats.\n  const ev: EvState = {\n    id, phase: 'go', t: 0, total: 0, done: false, score: 0, short: !!options.short, expert: !!options.expert,\n    owned: [], s: [], d: { final: !!options.final, only: options.only ?? '' }, seats,\n  }; // prettier-ignore\n  flow.ev = ev;\n  flow.mode = 'event';\n  for (const e of seatsOf(w)) {\n    e.seat.extra = options.expert ? 0.35 : e.seat.kind === 'cpu' ? 0.15 + e.seat.index * 0.08 : 0;\n    Object.assign(e.seat, { hx: [], hy: [], bot: {}, score: 0 });\n    resetWobble(e.wobble);\n  }\n  activity.setup(w, ev);\n  w.emit('eventStart', { id } as never);\n}\n\n/** Tears an activity down: what it spawned goes, the bodies stand down. */\nfunction endWithoutResult(w: W): void {\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  if (!ev) return;\n  ACTIVITIES[ev.id]?.teardown?.(w, ev);\n  clearOwned(w, ev);\n  const cast = castOf(w);\n  for (const e of seatsOf(w)) {\n    if (e.seat.actor >= 0 && w.get(e.seat.actor)) {\n      clearBody(w, e.seat.actor);\n      setLean(w, e.seat.actor, 0, 0);\n    }\n  }\n  if (cast.plumb >= 0) clearBody(w, cast.plumb);\n  if (cast.gerald >= 0) clearBody(w, cast.gerald);\n  const station = ACTIVITIES[ev.id]?.station ?? 'plaza';\n  const guest = cast.guest;\n  if (guest >= 0 && !w.query('roundScene').length) {\n    const [x, z] = LANDINGS[station];\n    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n}\n\n/** Records a finished activity and moves on. */\nfunction finishEvent(w: W): void {\n  const flow = flowOf(w);\n  const ev = flow.ev as EvState;\n  const { id, score } = ev;\n  const final = !!ev.d.final;\n  const seatScores = seatsOf(w).map((e) => e.seat.score);\n  endWithoutResult(w);\n  if (flow.group) {\n    flow.group.scores = flow.group.scores.map((sum, i) => sum + (seatScores[i] ?? 0));\n    flow.group.at += 1;\n    w.emit('classDone', { at: flow.group.at, score: seatScores } as never);\n    if (flow.group.at < flow.group.list.length) {\n      startEvent(w, flow.group.list[flow.group.at], { short: true, seats: flow.group.seats });\n      return;\n    }\n    const scores = flow.group.scores;\n    flow.bests.group = Math.max(flow.bests.group ?? 0, scores[flow.group.seats[0]] / 3);\n    recordResult(w, 'group', Math.round(scores[flow.group.seats[0]] / 3));\n    return;\n  }\n  if (id === 'tilt') {\n    flow.tiltScore = score;\n    markDone(flow, 'tilt');\n    startEvent(w, 'check', { final: true });\n    return;\n  }\n  recordResult(w, id, score, final);\n}\n\nfunction markDone(flow: Flow, id: string): void {\n  if (!flow.done.includes(id)) flow.done.push(id);\n}\n\n/** Puts the result in `flow.last`, pays pebbles, opens the results. */\nfunction recordResult(w: W, id: string, score: number, final = false): void {\n  const flow = flowOf(w);\n  const rank = rankOf(score);\n  const mult = gameNumber(w, 'game.pebbles.mult');\n  const pebbles = flow.auto ? 0 : Math.max(0, Math.round(rank.pebbles * mult));\n  let age = 0;\n  if (id === 'check') {\n    age = ageOf(score / 1000, gameNumber(w, 'game.age.k'));\n    flow.ages.push(age);\n    if (flow.ages.length > 7) flow.ages.shift();\n  }\n  flow.pebbles += pebbles;\n  flow.bests[id] = Math.max(flow.bests[id] ?? 0, score);\n  flow.last = { id, score, rank: rank.name, pebbles, age };\n  markDone(flow, id);\n  flow.mode = final ? 'credits' : 'results';\n  w.emit('results', { id, score, rank: rank.name, pebbles, age, final } as never);\n  cue(w, 'stampJingle');\n}\n\n/** Starts Group Class: three short classes, dealt, on every occupied seat. */\nexport function startGroup(w: W, seats?: number[]): void {\n  const flow = flowOf(w);\n  const middle = ['heron', 'hoopS', 'stepS'][w.rng('deal').int(0, 2)];\n  const list = ['ring', middle, 'pondS'];\n  const who = seats ?? seatsOf(w).filter((e) => e.seat.kind !== 'none').map((e) => e.seat.index);\n  flow.group = { list, at: 0, scores: [0, 0, 0, 0], seats: who };\n  startEvent(w, list[0], { short: true, seats: who });\n}\n\n/** The next thing today, or null when today is finished. */\nexport function nextItem(flow: Flow): string | null {\n  const list = DAYS[flow.day - 1] ?? [];\n  return list.find((id) => !flow.done.includes(id)) ?? null;\n}\n\n/** Sets who sits where outside a session: seat 0 is the guest; the rest are CPU guests in classes. */\nfunction defaultSeats(w: W): void {\n  const cast = castOf(w);\n  const others = [cast.gerald, cast.bex, cast.nan];\n  for (const e of seatsOf(w)) {\n    if (e.seat.index === 0) Object.assign(e.seat, { kind: 'human', actor: cast.guest });\n    else Object.assign(e.seat, { kind: 'cpu', actor: others[e.seat.index - 1] });\n  }\n}\n\n/** The morning: the day turns, the tilt grows a little. */\nexport function nextDay(w: W): void {\n  const flow = flowOf(w);\n  flow.day += 1;\n  flow.done = [];\n  flow.talk = {};\n  islandOf(w).tilt = 0.4 + 0.5 * (flow.day - 1);\n  flow.mode = 'roam';\n  w.emit('morning', { day: flow.day } as never);\n}\n\n/** Reads the page's input for a seat from the step's intents. */\nfunction readHuman(w: W, intents: Intents, e: SeatE): void {\n  const read = (key: string): number => {\n    const value = (intents as unknown as Record<string, unknown>)[key];\n    return typeof value === 'number' ? value : 0;\n  };\n  const seats = (intents as unknown as Record<string, unknown>)['game:seats'] as number[] | undefined;\n  const { index } = e.seat;\n  if (seats && seats[index]) {\n    const o = 4 + index * 5;\n    Object.assign(e.seat.input, { x: seats[o], y: seats[o + 1], l: seats[o + 2], r: seats[o + 3], act: seats[o + 4] > 0.5, gentle: false });\n  } else if (index === (w.query('roundScene').length ? flowOf(w).meSeat : 0)) {\n    const held = (intents.b ?? []) as readonly string[];\n    Object.assign(e.seat.input, {\n      x: read('game:r') - read('game:l'), y: read('game:f') - read('game:b'), l: read('game:fl'), r: read('game:fr'),\n      act: pressed(intents, 'act') || held.includes('act'), gentle: held.includes('gentle'),\n    }); // prettier-ignore\n    const mouse = (intents as unknown as Record<string, unknown>)['game:mouse'] as number[] | undefined;\n    if (mouse) {\n      const bot = e.seat.bot;\n      if (bot.mx !== undefined) {\n        e.wobble.mx += mouse[0] - bot.mx;\n        e.wobble.my += mouse[1] - bot.my;\n      }\n      [bot.mx, bot.my] = [mouse[0], mouse[1]];\n    }\n    const pointer = (intents as unknown as Record<string, unknown>)['game:pointer'] as number[] | undefined;\n    if (pointer && flowOf(w).ev?.id === 'garden') [e.wobble.mx, e.wobble.my] = [pointer[0], pointer[1]];\n  } else Object.assign(e.seat.input, { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false });\n}\n\n/** Writes this step's input into every seat. */\nfunction readSeats(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind === 'ghost' || e.seat.kind === 'none') continue;\n    const skillName = e.seat.kind === 'cpu' ? 'cpu' : flow.bot;\n    if (skillName) {\n      const skill = SKILLS[skillName] ?? SKILLS.perfect;\n      const running = ev && ev.seats.includes(e.seat.index) ? ACTIVITIES[ev.id] : null;\n      applyOrder(w, e, skill, running ? running.bot(w, ev as EvState, e, skill) : {});\n    } else readHuman(w, intents, e);\n  }\n}\n\n/** One step of the running activity. Run the input first, then the rules, then remember the feet. */\nexport function flowStep(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  readSeats(w, intents);\n  const ev = flow.ev;\n  if (flow.mode === 'event' && ev) {\n    ACTIVITIES[ev.id].step(w, ev);\n    ev.t += 1;\n    ev.total += 1;\n    if (ev.done) finishEvent(w);\n  }\n  for (const e of seatsOf(w)) {\n    e.seat.pl = e.seat.input.l;\n    e.seat.pr = e.seat.input.r;\n    e.seat.pact = e.seat.input.act;\n  }\n}\n\n/** The scene actions that belong to the flow. */\nexport const FLOW_ACTIONS = {\n  /** Hands the sim the save and walks onto the island. */\n  'game.begin': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    const save = (args ?? {}) as Partial<Flow>;\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n    defaultSeats(w);\n    islandOf(w).tilt = 0.4 + 0.5 * Math.min(4, flow.day - 1);\n    const cast = castOf(w);\n    if (cast.guest >= 0) {\n      const fresh = flow.day === 1 && flow.done.length === 0;\n      const at = fresh ? STATIONS.pier : STATIONS.plaza;\n      standAt(w, cast.guest, at.x, at.z + (fresh ? -14 : 10), Math.PI);\n    }\n    w.emit('begin', { day: flow.day } as never);\n  },\n  /** Starts an activity by id. */\n  'game.start': (w: W, args: unknown) => {\n    const { id, expert, only } = args as { id: string; expert?: boolean; only?: string };\n    if (id === 'group') return startGroup(w);\n    if (id === 'walk') return void w.emit('goWalk', {} as never);\n    flowOf(w).group = null;\n    startEvent(w, id, { expert, only });\n  },\n  /** Leaves results or an activity, back to the island. */\n  'game.leave': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    flow.group = null;\n    flow.mode = 'roam';\n    if (nextItem(flow) === null && !flow.free) say(w, 'day.finished', 'tare');\n  },\n  /** Again: runs the last activity. */\n  'game.again': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    if (flow.last.id === 'group') return startGroup(w);\n    startEvent(w, flow.last.id);\n  },\n  /** Finish now, at a score (dev). */\n  'game.finishAt': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    if (!flow.ev) return;\n    flow.ev.score = (args as { score: number }).score;\n    flow.ev.done = true;\n    if (flow.group) flow.group.at = flow.group.list.length - 1;\n  },\n  /** Opens the evening screen. */\n  'game.evening': (w: W) => void Object.assign(flowOf(w), { mode: 'evening' }),\n  /** Sleep: the next day. Day 5's end is the credits. */\n  'game.sleep': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    nextDay(w);\n    const cast = castOf(w);\n    if (cast.guest >= 0) standAt(w, cast.guest, 60, 44, 3.14);\n  },\n  /** After the credits: Free Play. */\n  'game.after': (w: W) => {\n    const flow = flowOf(w);\n    flow.day = 6;\n    flow.free = true;\n    flow.mode = 'roam';\n    flow.done = [];\n    w.emit('free', {} as never);\n  },\n  /** Back to the title. */\n  'game.front': (w: W) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { mode: 'front', auto: false, bot: '', drive: false, noTopple: false, group: null });\n  },\n  /** Jumps to a day (dev). */\n  'game.day': (w: W, args: unknown) => {\n    const flow = flowOf(w);\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { day: (args as { day: number }).day, done: [], mode: 'roam' });\n    islandOf(w).tilt = 0.4 + 0.5 * (flow.day - 1);\n    w.emit('morning', { day: flow.day } as never);\n  },\n  /** A bot plays seat 0 ('' a person). */\n  'game.bot': (w: W, args: unknown) => void (flowOf(w).bot = (args as { skill: string }).skill),\n  /** Cheats and assists. */\n  'game.flags': (w: W, args: unknown) => void Object.assign(flowOf(w), args as object),\n  /** Group Class seats: who is human, who is CPU, who is empty. */\n  'game.seats': (w: W, args: unknown) => {\n    const { kinds } = args as { kinds: Flow['mode'][] };\n    const cast = castOf(w);\n    const others = [cast.guest, cast.gerald, cast.bex, cast.nan];\n    for (const e of seatsOf(w)) Object.assign(e.seat, { kind: kinds[e.seat.index], actor: others[e.seat.index] });\n  },\n};\nE\npython3 - <<'E'\np='labs/game/scenes/types.ts';s=open(p).read()\ns=s.replace(\"group: { list: string[]; at: number; scores: number[] } | null;\",\"group: { list: string[]; at: number; scores: number[]; seats: number[] } | null;\\n  /** A session's own seat. */\\n  meSeat: number;\")\ns=s.replace(\"\"\"    near: { type: 'string',\"\"\",\"\"\"    meSeat: { type: 'integer', default: 0, description: 'A session\\\\u2019s own seat.' },\n    near: { type: 'string',\"\"\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/pilot.ts <<'E'\n/**\n * @file The pilot: every character stays `player: false`, and this system writes their intents. On the island the guest\n * walks by the step's `move`; the thing nearest in front of you gets the prompt; `use` talks, reads, enters or sleeps.\n * Tare hops along beside you. Also the walk's small rules: the sea's edge, hidden pebbles, the cairn, benches, the wave.\n */\nimport { held, pressed, terrainHeight, type Intents } from '../../../engine/sim-api';\nimport { clearBody, setLoop, setOnce } from '../cast/body';\nimport { castOf } from './cast-ref';\nimport { DAYS, BOARD } from './data/days';\nimport { BENCHES, HIDDEN_PEBBLES, PLAQUES } from './data/places';\nimport { STATIONS } from './data/stations';\nimport { ACTIVITIES } from './events';\nimport { nextItem, startEvent, startGroup } from './flow';\nimport { cue, flowOf, say, type C, type Flow, type W } from './types';\nimport { FULCRUM } from './terrain';\n\nconst REACH = 4.5;\nconst FLOOR = 2.3;\n\ntype ActorOf = { actor: C['actor'] & { intents: Record<string, unknown> } };\n\n/** A thing you can use. */\ninterface Thing { key: string; x: number; z: number; r?: number }\n\n/** Today's list of usable things. */\nfunction things(w: W, flow: Flow): Thing[] {\n  const cast = castOf(w);\n  const list: Thing[] = [];\n  for (const who of ['plumb', 'gerald', 'bex', 'nan'] as const) {\n    const id = cast[who];\n    const entity = id >= 0 ? (w.get(id) as unknown as ActorOf | undefined) : undefined;\n    if (entity) list.push({ key: `npc:${who}`, x: entity.actor.x, z: entity.actor.z });\n  }\n  const tare = cast.tare >= 0 ? (w.get(cast.tare) as unknown as ActorOf | undefined) : undefined;\n  if (tare) list.push({ key: 'npc:tare', x: tare.actor.x, z: tare.actor.z, r: 3 });\n  PLAQUES.forEach((p, k) => {\n    const creep = 1 + (flow.day - 1) * 0.012;\n    list.push({ key: `plaque:${k}`, x: p[0] * creep, z: p[1] * creep, r: 3.5 });\n  });\n  list.push({ key: 'board:board', x: 12, z: 34, r: 5 });\n  list.push({ key: 'hut:hut', x: 64, z: 49, r: 5 });\n  BENCHES.forEach((b, k) => list.push({ key: `bench:${k}`, x: b[0], z: b[1], r: 3 }));\n  const today = DAYS[flow.day - 1] ?? [];\n  for (const id of today) {\n    if (id === 'walk' || flow.done.includes(id)) continue;\n    const station = id === 'group' ? STATIONS.pavilion : ACTIVITIES[id] ? STATIONS[ACTIVITIES[id].station] : null;\n    if (station) list.push({ key: `go:${id}`, x: station.x, z: station.z, r: 9 });\n  }\n  if (flow.free) {\n    for (const id of BOARD) {\n      if (id === 'group') continue;\n      const station = STATIONS[ACTIVITIES[id].station];\n      list.push({ key: `go:${id}`, x: station.x, z: station.z, r: 7 });\n    }\n  }\n  return list;\n}\n\n/** What's nearest and in front. */\nfunction nearest(w: W, flow: Flow, ax: number, az: number, yaw: number): string {\n  let best = '';\n  let score = Infinity;\n  for (const t of things(w, flow)) {\n    const [dx, dz] = [t.x - ax, t.z - az];\n    const d = Math.hypot(dx, dz);\n    if (d > (t.r ?? REACH)) continue;\n    const front = d > 0.01 ? (dx * Math.sin(yaw) + dz * Math.cos(yaw)) / d : 1;\n    const value = d - front * 1.5;\n    if (value < score) [score, best] = [value, t.key];\n  }\n  return best;\n}\n\n/** Uses a thing. */\nfunction use(w: W, flow: Flow, key: string): void {\n  const [kind, id] = key.split(':');\n  if (kind === 'npc') {\n    const n = (flow.talk[id] ?? 0) + 1;\n    flow.talk[id] = n;\n    const day = Math.min(5, flow.day);\n    const count = id === 'gerald' && day < 4 ? 1 : 3;\n    say(w, `talk.${id}.d${day}.${((n - 1) % count) + 1}`, id);\n    return;\n  }\n  if (kind === 'plaque') {\n    const k = Number(id);\n    if (!flow.plaques.includes(k)) flow.plaques.push(k);\n    say(w, `plaque.${k + 1}`, 'plaque');\n    cue(w, 'tick');\n    return;\n  }\n  if (kind === 'board') {\n    if (!flow.done.includes('walk') && (DAYS[flow.day - 1] ?? []).includes('walk')) {\n      flow.done.push('walk');\n      say(w, 'walk.found', 'tare');\n    }\n    w.emit('openBoard', {} as never);\n    return;\n  }\n  if (kind === 'hut') {\n    if (nextItem(flow) === null || flow.free) flow.mode = 'evening';\n    else say(w, 'hut.notYet', 'tare');\n    return;\n  }\n  if (kind === 'bench') {\n    flow.sit = 1;\n    say(w, 'bench.sit', 'plaque');\n    return;\n  }\n  if (kind === 'go') {\n    if (id === 'group') return startGroup(w);\n    startEvent(w, id);\n  }\n}\n\n/** Keeps the walker out of deep water: the sea's edge pushes back. */\nfunction shoreline(x: number, z: number): [number, number] | null {\n  const h = terrainHeight(FULCRUM(), x, z);\n  if (h !== null && h > FLOOR) return null;\n  const len = Math.hypot(x, z) || 1;\n  return [-(x / len), -(z / len)];\n}\n\n/** One roam step. */\nexport function pilot(w: W, intents: Intents): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  const guest = w.get(cast.guest) as unknown as ActorOf;\n  if (flow.mode !== 'roam') {\n    if (guest && flow.mode !== 'event') guest.actor.intents = {};\n    return;\n  }\n  const { actor } = guest;\n  let move = (intents.move ?? [0, 0]) as readonly number[];\n  if (flow.drive) move = [0, 0];\n  const slow = held(intents, 'walk') ? 0.45 : 1;\n  let [mx, mz] = [move[0] * slow, move[1] * slow];\n  if (Math.hypot(mx, mz) > 0.05 && flow.sit) {\n    flow.sit = 0;\n    clearBody(w, cast.guest);\n  }\n  if (flow.sit) {\n    flow.sit += 1;\n    setLoop(w, cast.guest, 'RETREATLIB/Sitting_Idle_Loop', 1);\n  }\n  const back = shoreline(actor.x + mx * 0.5, actor.z + mz * 0.5);\n  if (back) [mx, mz] = [back[0] * 0.6, back[1] * 0.6];\n  actor.intents = { move: [mx, mz], ...(held(intents, 'jump') ? { b: ['jump'] } : {}) };\n  flow.near = nearest(w, flow, actor.x, actor.z, actor.yaw);\n  if (pressed(intents, 'use') && flow.near) use(w, flow, flow.near);\n  if (pressed(intents, 'wave')) {\n    setOnce(w, cast.guest, 'RETREATLIB/Wave_Hello');\n    w.emit('waved', {} as never);\n    flow.sit = 900; // the wave ends when you walk off\n  }\n  // Tare hops along beside you\n  const tare = w.get(cast.tare) as unknown as ActorOf | undefined;\n  if (tare) {\n    const [dx, dz] = [actor.x - 2.2 - tare.actor.x, actor.z - 1.4 - tare.actor.z];\n    const far = Math.hypot(dx, dz);\n    tare.actor.intents = far > 1.6 ? { move: [dx / far, dz / far], ...(w.tick % 30 < 3 ? { b: ['jump'] } : {}) } : {};\n  }\n  // hidden pebbles\n  HIDDEN_PEBBLES.forEach((p, k) => {\n    if (!flow.found.includes(k) && Math.hypot(p[0] - actor.x, p[1] - actor.z) < 1.8) {\n      flow.found.push(k);\n      flow.pebbles += 1;\n      cue(w, 'pebble');\n      w.emit('foundPebble', { k } as never);\n    }\n  });\n  // a walk's other rule: at the Noticeboard, on Day 1, the walk is done\n  if (flow.day === 1 && !flow.done.includes('walk') && Math.hypot(actor.x - 12, actor.z - 34) < 7) {\n    flow.done.push('walk');\n    say(w, 'walk.found', 'tare');\n    cue(w, 'stamp');\n  }\n}\nE\ncat > labs/game/scenes/terrain.ts <<'E'\n/**\n * @file Little Fulcrum's ground: a sea-girt dome with a summit, flats for its stations, hollows for the pond and the\n * lagoon, and the north cliff. `FULCRUM()` is its terrain data, for height queries.\n */\nimport { defineTerrain, getTerrain, makeTerrain } from '../../../engine/sim-api';\n\nexport const FULCRUM_ID = 'terrain:fulcrum';\n\ndefineTerrain(FULCRUM_ID, {\n  size: [260, 260],\n  cell: 2,\n  origin: [-130, 0, -130],\n  height: 0,\n  hills: [\n    { at: [0, 0], radius: 122, height: 12.5 },\n    { at: [0, 0], radius: 30, height: 4.5 },\n    { at: [0, -74], radius: 26, height: 9 },\n    { at: [0, -110], radius: 20, height: -22 },\n    { at: [-60, 96], radius: 40, height: -13 },\n    { at: [-70, -12], radius: 11, height: -5 },\n    { at: [84, -60], radius: 14, height: 3 },\n    { at: [0, 112], radius: 22, height: -7 },\n  ],\n  flats: [\n    { rect: [-12, 26, 16, 46], height: 8, margin: 7 },\n    { rect: [-64, 8, -40, 30], height: 7.4, margin: 6 },\n    { rect: [40, 12, 66, 34], height: 7.2, margin: 6 },\n    { rect: [56, 44, 78, 62], height: 5.2, margin: 6 },\n    { rect: [20, -56, 40, -40], height: 7, margin: 6 },\n    { rect: [-9, -93, 9, -80], height: 16, margin: 3 },\n    { rect: [66, 2, 84, 16], height: 6.6, margin: 5 },\n    { rect: [52, 74, 74, 94], height: 2.7, margin: 8 },\n  ],\n  high: 7,\n  materials: ['material:retreatSand', 'material:retreatSand', 'material:retreatLawn'],\n  surface: 'grass',\n});\n\n/** The terrain's heights. */\nexport const FULCRUM = () => getTerrain(FULCRUM_ID);\nvoid makeTerrain;\nE\ncat > labs/game/scenes/director.ts <<'E'\n/**\n * @file The director: the attract loop, and the driver that plays the whole game (the softlock finder, and dev mode's \"bot\n * plays for me\"). Attract is free to cheat: a perfect bot with no topples, each clip about fifteen seconds, then round\n * again. It never reaches the save, because only the page writes one, and only when attract is off.\n */\nimport { flowStepAttractGuard } from './attract-guard';\nimport { castOf } from './cast-ref';\nimport { nextItem, nextDay, startEvent, startGroup } from './flow';\nimport { flowOf, type W } from './types';\nimport { standAt } from './events/kit';\nimport { COAST } from './data/courses';\n\n/** The loop: activity, how long, options. */\nexport const ATTRACT: readonly { id: string; steps: number; only?: string }[] = [\n  { id: 'jog', steps: 900 },\n  { id: 'poseA', steps: 1500 },\n  { id: 'pond', steps: 1200 },\n  { id: 'line', steps: 900 },\n  { id: 'paddle', steps: 900 },\n  { id: 'garden', steps: 900 },\n  { id: 'step', steps: 900 },\n  { id: 'hoop', steps: 900 },\n  { id: 'plunge', steps: 1000 },\n  { id: 'tilt', steps: 1100, only: 'stone' },\n];\n\n/** Starts attract, or ends it. */\nexport function setAttract(w: W, on: boolean): void {\n  const flow = flowOf(w);\n  flow.auto = on;\n  flow.noTopple = on;\n  flow.bot = on ? 'perfect' : '';\n  flow.autoIndex = -1;\n  flow.autoT = 0;\n}\n\n/** One director step. */\nexport function directorStep(w: W): void {\n  const flow = flowOf(w);\n  flowStepAttractGuard(w);\n  if (flow.auto) {\n    flow.autoT -= 1;\n    if (flow.autoT <= 0 || flow.mode === 'results') {\n      flow.autoIndex = (flow.autoIndex + 1) % ATTRACT.length;\n      const clip = ATTRACT[flow.autoIndex];\n      flow.autoT = clip.steps;\n      flow.mode = 'front';\n      flow.group = null;\n      startEvent(w, clip.id, { only: clip.only });\n      w.emit('attractClip', { id: clip.id, index: flow.autoIndex } as never);\n    }\n    return;\n  }\n  if (!flow.drive) return;\n  driveStep(w);\n}\n\n/** The whole-game driver: goes on to the next thing whenever nothing is playing. */\nfunction driveStep(w: W): void {\n  const flow = flowOf(w);\n  if (flow.mode === 'event') {\n    flow.driveT = 0;\n    return;\n  }\n  flow.driveT += 1;\n  if (flow.driveT < 30) return;\n  flow.driveT = 0;\n  if (flow.mode === 'results') {\n    flow.mode = 'roam';\n    return;\n  }\n  if (flow.mode === 'credits') {\n    flow.day = 6;\n    flow.free = true;\n    flow.mode = 'roam';\n    flow.drive = false;\n    flow.bot = '';\n    w.emit('free', {} as never);\n    return;\n  }\n  if (flow.mode === 'evening') {\n    nextDay(w);\n    return;\n  }\n  if (flow.mode !== 'roam') return;\n  const next = nextItem(flow);\n  if (next === null) {\n    flow.mode = 'evening';\n    return;\n  }\n  if (next === 'walk') {\n    standAt(w, castOf(w).guest, 12, 38, Math.PI);\n    flow.done.push('walk');\n    return;\n  }\n  if (next === 'group') return startGroup(w);\n  startEvent(w, next);\n}\nvoid COAST;\nE\ncat > labs/game/scenes/attract-guard.ts <<'E'\n/**\n * @file Keeps attract's bot cheating: nothing it plays can leave the flow in a state that stops the loop. Attract never\n * reads or writes the save, and pays no pebbles.\n */\nimport { flowOf, type W } from './types';\n\n/** Attract earns nothing: pebbles and ages stay as they were. */\nexport function flowStepAttractGuard(w: W): void {\n  const flow = flowOf(w);\n  if (flow.auto) flow.group = null;\n}\nE\ncat > labs/game/scenes/round.ts <<'E'\n/**\n * @file The scene `game:round`: a session's small pavilion, and the rules of a Round. Three classes dealt from the stream\n * `deal`: the Still Ring, one of Heron, Hoop or Step, and Still Pond, each short. Every copy runs its own seeded round.\n * Other players arrive as ghosts through the custom intent `game:ghosts`, wobbling on the neighbouring mats, shown only\n * while they are in the same class. Nothing they do touches this copy's round.\n */\nimport { addBox, defineComponent, defineScene, physicsOf, removeProp, spawnProp, type Intents, type World } from '../../../engine/sim-api';\nimport { setLean, setPose } from '../cast/body';\nimport { spawnPerson } from '../cast/people';\nimport { CAST, castOf } from './cast-ref';\nimport { FRONT_MAT, MATS } from './data/stations';\nimport { standAt } from './events/kit';\nimport { FLOW_ACTIONS, flowStep, startGroup } from './flow';\nimport './settings';\nimport { ISLAND, SEAT, FLOW, WOBBLE, flowOf, seatOf, seatsOf, type C, type W } from './types';\nimport { seedSway } from './wobble';\n\n/** Marks the scene as a session's: stations all mean the pavilion here. */\nexport const ROUND_SCENE = defineComponent('roundScene', { description: 'This scene is a session\\u2019s.', fields: {} });\n\n/** A ghost: which seat it shows. */\nexport const GHOST = defineComponent('ghost', {\n  description: 'Another player, shown on a neighbouring mat. It never touches this copy\\u2019s round.',\n  fields: { seat: { type: 'integer', default: 0, description: 'Its seat.' } },\n});\n\nconst CLASS_CLIP: Readonly<Record<string, string>> = {\n  ring: 'RETREAT/Stand', heron: 'RETREAT/Heron', nothing: 'RETREAT/Nothing', hoop: 'RETREAT/HipCircle', hoopS: 'RETREAT/HipCircle',\n  stepS: 'RETREAT/StepUpL', pondS: 'RETREAT/Nothing', pond: 'RETREAT/Nothing', '': 'RETREAT/Stand',\n}; // prettier-ignore\n\n/** Message pose ids by number, the wire's small table. */\nexport const POSE_WIRE = ['', 'ring', 'heron', 'hoopS', 'stepS', 'pondS'] as const;\n\n/** Applies what ghosts sent: [seat, class, x, y, score, pose] sextuples. */\nfunction readGhosts(w: W, intents: Intents): void {\n  const data = (intents as unknown as Record<string, unknown>)['game:ghosts'] as number[] | undefined;\n  const flow = flowOf(w);\n  const myClass = flow.group ? flow.group.at : -1;\n  if (data) {\n    for (let k = 0; k + 5 < data.length; k += 6) {\n      const e = seatsOf(w).find((one) => one.seat.index === data[k]);\n      if (!e || e.seat.kind !== 'ghost') continue;\n      e.seat.shownClass = data[k + 1];\n      e.wobble.bx = data[k + 2];\n      e.wobble.by = data[k + 3];\n      e.seat.score = data[k + 4];\n      e.seat.pose = POSE_WIRE[data[k + 5]] ?? '';\n    }\n  }\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind !== 'ghost') continue;\n    e.wobble.x += (e.wobble.bx - e.wobble.x) * 0.15;\n    e.wobble.y += (e.wobble.by - e.wobble.y) * 0.15;\n    const here = e.seat.shownClass === myClass || myClass < 0;\n    const mat = MATS[e.seat.index];\n    standAt(w, e.seat.actor, here ? mat[0] : mat[0] * 3, here ? mat[1] : 12, Math.PI);\n    setPose(w, e.seat.actor, CLASS_CLIP[e.seat.pose] ?? 'RETREAT/Stand', 1);\n    setLean(w, e.seat.actor, e.wobble.x, e.wobble.y);\n  }\n}\n\n/** The small scene. */\nexport const round = defineScene<C>('game:round', {\n  description: 'A session\\u2019s round: the pavilion, four mats, the cast, three classes.',\n  physics: true,\n  setup(w) {\n    const world = w as unknown as World;\n    addBox(physicsOf(world), { type: 'fixed', size: [60, 1, 60], at: [0, -0.5, 0] } as never);\n    world.spawn({ flow: { mode: 'round' } } as never);\n    world.spawn({ island: {}, roundScene: {} } as never);\n    spawnProp(w, { prop: 'prop:pavilion', at: [0, 0, 0] });\n    spawnProp(w, { prop: 'prop:roundFloor', at: [0, 0, 0] });\n    MATS.forEach((m, i) => spawnProp(w, { prop: `prop:matSeat${i}`, at: [m[0], 0.01, m[1]] }));\n    const plumb = spawnPerson(w, { at: [FRONT_MAT[0], 0, FRONT_MAT[1]], body: 'body:plumb', build: 'build:plumb', speed: 2, secondary: { hair: 'ponytail' } });\n    world.spawn({ cast: { plumb, guest: -1 } } as never);\n    for (let i = 0; i < 4; i++) {\n      const m = MATS[i];\n      const actor = spawnPerson(w, { at: [m[0] * 3, 0, 12], body: `body:seat${i}`, build: 'build:chibi', speed: 3, yaw: Math.PI });\n      const id = world.spawn({ seat: { index: i, kind: 'none', actor }, wobble: {} } as never);\n      seedSway(w as unknown as W, (world.get(id) as unknown as { wobble: never }).wobble);\n    }\n  },\n  step(w, intents) {\n    const world = w as unknown as W;\n    readGhosts(world, intents);\n    flowStep(world, intents);\n  },\n  actions: {\n    ...(FLOW_ACTIONS as never),\n    /** Who sits where: my seat, and how many players. */\n    'round.seat': (w: World<C>, args: unknown) => {\n      const world = w as unknown as W;\n      const { me, players } = args as { me: number; players: number[] };\n      flowOf(world).meSeat = me;\n      for (const e of seatsOf(world)) {\n        const inRound = players.includes(e.seat.index);\n        e.seat.kind = e.seat.index === me ? 'human' : inRound ? 'ghost' : 'none';\n        if (e.seat.kind === 'ghost') (w as unknown as World).spawn({ ghost: { seat: e.seat.index } } as never);\n        const m = MATS[e.seat.index];\n        if (inRound) standAt(world, e.seat.actor, m[0], m[1], Math.PI);\n      }\n      (w as unknown as { emit(n: string, p: object): void }).emit('seated', { me });\n    },\n    /** The round begins. */\n    'round.go': (w: World<C>) => {\n      const world = w as unknown as W;\n      const flow = flowOf(world);\n      if (flow.group) return;\n      startGroup(world, [flow.meSeat, ...seatsOf(world).filter((e) => e.seat.kind === 'ghost').map((e) => e.seat.index)]);\n    },\n    /** A player left: they walk off politely. */\n    'round.leave': (w: World<C>, args: unknown) => {\n      const world = w as unknown as W;\n      const e = seatOf(world, (args as { seat: number }).seat);\n      if (!e || e.seat.kind !== 'ghost') return;\n      e.seat.kind = 'none';\n      standAt(world, e.seat.actor, MATS[e.seat.index][0] * 3, 12, 0);\n      const ev = flowOf(world).ev;\n      if (ev) ev.seats = ev.seats.filter((i) => i !== e.seat.index);\n      if (flowOf(world).group) flowOf(world).group!.seats = flowOf(world).group!.seats.filter((i) => i !== e.seat.index);\n    },\n  },\n});\n\nexport default round;\nvoid [CAST, ISLAND, SEAT, FLOW, WOBBLE, castOf, removeProp, setPose];\nE\ncat > labs/game/scenes/island.ts <<'E'\n/**\n * @file The scene `game:island`: the whole game, on one world. Terrain, sea, the dressed stations, the cast, the four seats.\n * Activities spawn their own bits at their stations and take them away again; the page drives it with scene actions.\n */\nimport { addTerrainBody, defineScene, physicsOf, spawnProp, stepCrowdBody, getTerrain, type World } from '../../../engine/sim-api';\nimport { GUEST_BUILDS, GUEST_SPEED, guestBody, PEOPLE, spawnPerson } from '../cast/people';\nimport { CAST, castOf } from './cast-ref';\nimport { DRESSING, HIDDEN_PEBBLES, PLAQUES, BENCHES } from './data/places';\nimport { setAttract, directorStep } from './director';\nimport { groundAt, moveProp, tiltQuat } from './events/kit';\nimport { stepTiltCrowd } from './events/tilt';\nimport { FLOW_ACTIONS, flowStep } from './flow';\nimport { pilot } from './pilot';\nimport './settings';\nimport { FULCRUM_ID } from './terrain';\nimport { flowOf, islandOf, say, type C, type W } from './types';\nimport { seedSway } from './wobble';\nimport { setLean, setPose } from '../cast/body';\nimport { rankOf } from './data/days';\n\n/** A pebble on the cairn or a hidden one. */\nexport const PEBBLE = { description: 'marks' };\n\nconst SEA_Y = 2;\n\nfunction spawnAt(w: W, prop: string, x: number, z: number, yaw = 0, lift = 0): number {\n  return spawnProp(w, { prop, at: [x, groundAt(w, x, z) + lift, z], yaw });\n}\n\n/** Stands everything on the island once. */\nfunction dress(w: W): void {\n  for (const [prop, x, z, yaw] of DRESSING) spawnAt(w, prop, x, z, yaw);\n  PLAQUES.forEach((p, k) => {\n    const id = spawnAt(w, 'prop:plaque', p[0], p[1], k * 1.3);\n    w.spawn({ plaque: { k, id } } as never);\n  });\n  HIDDEN_PEBBLES.forEach((p, k) => {\n    const id = spawnAt(w, 'prop:hiddenPebble', p[0], p[1], k, 0.02);\n    w.spawn({ pebble: { k, id } } as never);\n  });\n  for (const b of BENCHES) spawnAt(w, 'prop:bench', b[0], b[1], b[2]);\n  const pondFloor = groundAt(w, -70, -12);\n  spawnProp(w, { prop: 'prop:pondWater', at: [-70, pondFloor + 0.9, -12] });\n}\n\n/** Moves things that show the tilt: plaques creep, drinks slide, the sea leans a hair. */\nfunction storyStep(w: W): void {\n  const flow = flowOf(w);\n  const island = islandOf(w);\n  island.seaT += 1 / 60;\n  const sea = (w.query('seaProp' as never)[0] as unknown as { id: number; seaProp: { id: number } } | undefined)?.seaProp.id;\n  if (sea !== undefined) {\n    const lean = (island.finale ? -island.tiltX : island.tilt * 0.12) * (Math.PI / 180);\n    const leanZ = (island.finale ? -island.tiltZ : 0) * (Math.PI / 180);\n    const bob = Math.sin(island.seaT * 0.6) * 0.05 - 0.05;\n    moveProp(w, sea, [Math.sin(island.seaT * 0.02) * 6, SEA_Y + bob, Math.cos(island.seaT * 0.017) * 6], tiltQuat(leanZ, lean));\n  }\n  for (const e of w.query('plaque' as never) as unknown as { plaque: { k: number; id: number } }[]) {\n    const p = PLAQUES[e.plaque.k];\n    const creep = 1 + (Math.min(flow.day, 5) - 1) * 0.012;\n    const [x, z] = [p[0] * creep, p[1] * creep];\n    if (w.tick % 120 === e.plaque.k) moveProp(w, e.plaque.id, [x, groundAt(w, x, z), z], [0, Math.sin(e.plaque.k * 0.65), 0, Math.cos(e.plaque.k * 0.65)]);\n  }\n  for (const e of w.query('pebble' as never) as unknown as { pebble: { k: number; id: number } }[]) {\n    if (flow.found.includes(e.pebble.k) && (w.get(e.pebble.id) as unknown as { sceneProp: { y: number } }).sceneProp.y > -5) moveProp(w, e.pebble.id, [0, -30, 0]);\n  }\n  for (const e of w.query('drink' as never) as unknown as { drink: { id: number; x: number; z: number; k: number } }[]) {\n    const run = island.tilt * 0.25;\n    const at = ((island.seaT * 0.05 * (e.drink.k + 2)) % 1) * run;\n    moveProp(w, e.drink.id, [e.drink.x + at, 8.96, e.drink.z]);\n  }\n  for (const e of w.query('rollMarble' as never) as unknown as { rollMarble: { id: number; k: number } }[]) {\n    const show = flow.day >= 4;\n    const a = island.seaT * 0.5 + e.rollMarble.k * 2;\n    moveProp(w, e.rollMarble.id, show ? [30 + Math.cos(a) * 1.8, 7.95, -48 + Math.sin(a) * 1.2] : [0, -30, 0]);\n  }\n  cairnStep(w);\n}\n\n/** Drops earned pebbles on the cairn, one by one. */\nfunction cairnStep(w: W): void {\n  const flow = flowOf(w);\n  const cairn = w.query('cairn' as never)[0] as unknown as { cairn: { ids: number[] } };\n  flow.cairnT += 1;\n  if (flow.cairnShown < Math.min(flow.pebbles, cairn.cairn.ids.length) && flow.cairnT > 18) {\n    flow.cairnT = 0;\n    flow.cairnShown += 1;\n    w.emit('clack', {} as never);\n  } else if (flow.cairnShown > flow.pebbles) flow.cairnShown = flow.pebbles;\n  const age = flow.ages[flow.ages.length - 1] ?? 60;\n  const lean = ((age - 18) / 64) * 0.09;\n  cairn.cairn.ids.forEach((id, k) => {\n    if (k % 7 !== w.tick % 7) return;\n    const layer = Math.floor(Math.sqrt(k) * 0.9);\n    const ring = Math.max(0, 5 - layer) * 0.16;\n    const y = 8.05 + layer * 0.15;\n    const a = k * 2.4;\n    const show = k < flow.cairnShown;\n    moveProp(w, id, show ? [-12 + Math.cos(a) * ring + y * lean - 0.7, y, 30 + Math.sin(a) * ring] : [0, -30, 0], [0, Math.sin(a / 2), 0, Math.cos(a / 2)]);\n  });\n}\n\n/** Gull and Frog: blobs, cheap and very funny. */\nfunction critters(w: W): void {\n  const cast = castOf(w);\n  const flow = flowOf(w);\n  const ev = flow.ev;\n  const gull = w.get(cast.gull) as unknown as { crowdBody: never; id: number } | undefined;\n  const frog = w.get(cast.frog) as unknown as { crowdBody: never; id: number } | undefined;\n  const guest = (w.get(cast.guest) as unknown as { actor: { x: number; y: number; z: number } }).actor;\n  const t = w.tick / 60;\n  if (gull) {\n    const onHead = ev?.id === 'pond' && (ev.d as { gullOn?: boolean }).gullOn;\n    const onArm = ev?.id === 'line' && ((ev.d as { gull?: number }).gull ?? 0) !== 0;\n    const onBack = ev?.id === 'poseB' && (ev.d as { list?: string[]; at?: number }).list?.[(ev.d as { at: number }).at] === 'napkin' && ev.phase === 'hold';\n    const at: [number, number, number] = onHead\n      ? [guest.x, guest.y + 1.5, guest.z]\n      : onArm\n        ? [guest.x, guest.y + 1.1, guest.z + 0.55]\n        : onBack\n          ? [guest.x, guest.y + 1.1, guest.z]\n          : [20 + Math.cos(t * 0.3) * 40, 16 + Math.sin(t * 0.7) * 2, 40 + Math.sin(t * 0.3) * 40];\n    stepCrowdBody(w as never, cast.gull, gull.crowdBody, { at, velocity: [Math.sin(t) * 2, 0, Math.cos(t) * 2], blob: { flap: 1 } } as never);\n  }\n  if (frog) {\n    const onKnee = ev?.id === 'pond' && (ev.d as { onKnee?: boolean }).onKnee;\n    const look = ev?.id === 'pond' && ((ev.d as { frogLook?: number }).frogLook ?? 0) > 0;\n    const at: [number, number, number] = onKnee ? [guest.x + 0.25, guest.y + 0.45, guest.z - 0.3] : [-67.6, groundAt(w, -67.6, -13.2) + 1.1, -13.2];\n    stepCrowdBody(w as never, cast.frog, frog.crowdBody, { at, velocity: [0, 0, 0], blob: look ? { look: [guest.x - at[0], guest.z - at[2]] } : {} } as never);\n  }\n}\n\n/** Plumb in the Pavilion when not teaching, the others about the island. */\nfunction standAround(w: W): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  if (flow.mode === 'event') return;\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    setPose(w, id, id === cast.plumb ? 'RETREAT/Stand' : 'RETREAT/Stand', 0);\n    setLean(w, id, 0, 0);\n  }\n}\n\nexport const island = defineScene<C>('game:island', {\n  description: 'Little Fulcrum: the whole game on one world.',\n  physics: true,\n  terrain: FULCRUM_ID,\n  setup(w) {\n    const world = w as unknown as World;\n    addTerrainBody(physicsOf(world), getTerrain(FULCRUM_ID));\n    world.spawn({ flow: {} } as never);\n    world.spawn({ island: {} } as never);\n    dress(w as unknown as W);\n    const sea = spawnProp(w, { prop: 'prop:sea', at: [0, SEA_Y, 0] });\n    world.spawn({ seaProp: { id: sea } } as never);\n    const table = [\n      [-11.6, 39.8], [-10.8, 40.2], [-11.1, 39.5], [-10.4, 39.7],\n    ]; // prettier-ignore\n    table.forEach(([x, z], k) => world.spawn({ drink: { id: spawnProp(w, { prop: 'prop:drink', at: [x, 8.96, z] }), x, z, k } } as never));\n    [0, 1, 2].forEach((k) => world.spawn({ rollMarble: { id: spawnProp(w, { prop: 'prop:marble', at: [0, -30, 0] }), k } } as never));\n    const ids: number[] = [];\n    for (let k = 0; k < 90; k++) ids.push(spawnProp(w, { prop: `prop:cairnPebble${k % 4}`, at: [0, -30, 0] }));\n    world.spawn({ cairn: { ids } } as never);\n    const stand = (who: string, x: number, z: number, yaw = 0) =>\n      spawnPerson(w, { at: [x, groundAt(w as unknown as W, x, z) + 0.05, z], yaw, ...PEOPLE[who] });\n    const guest = spawnPerson(w, { at: [0, groundAt(w as unknown as W, 0, 86) + 0.05, 86], body: guestBody(0, 0), build: GUEST_BUILDS[0], speed: GUEST_SPEED, yaw: Math.PI });\n    const plumb = stand('plumb', -52, 12);\n    const tare = stand('tare', 3, 84, Math.PI);\n    const gerald = stand('gerald', 4, 38, 0.8);\n    const bex = stand('bex', 15, 24, -0.6);\n    const nan = stand('nan', -8, 30, 1.8);\n    const extras = [stand('extra0', 49, 28), stand('extra1', 52, 28), stand('extra2', 55, 28)];\n    const gull = world.spawn({ crowdBody: { rig: 'blob', look: 'wings', x: 20, y: 16, z: 40, size: 0.28 } } as never);\n    const frog = world.spawn({ crowdBody: { rig: 'blob', look: 'ears', x: -67, y: 6, z: -13, size: 0.2 } } as never);\n    world.spawn({ cast: { plumb, tare, gerald, bex, nan, guest, gull, frog, extras } } as never);\n    const others = [gerald, bex, nan];\n    for (let i = 0; i < 4; i++) {\n      const id = world.spawn({ seat: { index: i, kind: i === 0 ? 'human' : 'cpu', actor: i === 0 ? guest : others[i - 1] }, wobble: {} } as never);\n      seedSway(w as unknown as W, (world.get(id) as unknown as { wobble: never }).wobble);\n    }\n    w.systems.add('game.critters', (now) => critters(now as unknown as W), { phase: 'anim' });\n    w.systems.add('game.tiltCrowd', (now) => stepTiltCrowd(now as unknown as W), { phase: 'anim' });\n    (w as unknown as { emit(n: string, p: object): void }).emit('ready', {});\n  },\n  step(w, intents) {\n    const world = w as unknown as W;\n    flowStep(world, intents);\n    pilot(world, intents);\n    standAround(world);\n    storyStep(world);\n    directorStep(world);\n  },\n  actions: {\n    ...(FLOW_ACTIONS as never),\n    /** Attract on or off. */\n    'game.attract': (w: World<C>, args: unknown) => setAttract(w as unknown as W, (args as { on: boolean }).on),\n    /** The whole-game driver. */\n    'game.drive': (w: World<C>, args: unknown) => {\n      const flow = flowOf(w as unknown as W);\n      Object.assign(flow, { drive: true, bot: (args as { skill?: string }).skill ?? 'perfect' });\n    },\n    /** A line said on request (the walk-up remark, the final remark). */\n    'game.say': (w: World<C>, args: unknown) => {\n      const { line, who } = args as { line: string; who: string };\n      say(w as unknown as W, line, who);\n    },\n  },\n});\n\nexport default island;\nvoid [CAST, rankOf];\nE\npython3 - <<'E'\np='labs/game/scenes/types.ts';s=open(p).read()\ns+=\"\"\"\nfor (const [name, description, field] of [\n  ['plaque', 'A plaque.', 'k'],\n  ['pebble', 'A hidden pebble.', 'k'],\n  ['drink', 'A drink on the table.', 'k'],\n  ['rollMarble', 'A marble nobody is rolling.', 'k'],\n] as const) {\n  defineComponent(name, {\n    description,\n    fields: {\n      [field]: { type: 'integer', default: 0, description: 'Which.' },\n      id: { type: 'integer', default: -1, description: 'Its prop.' },\n      x: { type: 'number', default: 0, description: 'Rest place, east.' },\n      z: { type: 'number', default: 0, description: 'Rest place, south.' },\n    },\n  });\n}\ndefineComponent('seaProp', { description: 'The sea.', fields: { id: { type: 'integer', default: -1, description: 'Its prop.' } } });\ndefineComponent('cairn', { description: 'The pebbles of your cairn.', fields: { ids: { type: 'array', default: [], description: 'Their props.' } } });\n\"\"\"\nopen(p,'w').write(s)\nE\ncat > labs/game/props/index.ts <<'E'\n/**\n * @file Every prop of Wee Tare, data only. Parts stand on the base, in metres, built from the engine's geometry kit with\n * materials by id. Props that move have no body: the sim writes their pose and nothing collides with them.\n */\nimport { defineProp } from '../../../engine/sim-api';\n\ntype Part = { g?: string; p: Record<string, number>; m?: string; at?: readonly [number, number, number]; tint?: string; rot?: readonly number[] };\nconst BOX = 'geometry:box';\nconst ROUND = 'geometry:roundedBox';\nconst LIMB = 'geometry:limb';\nconst FRUSTUM = 'geometry:frustum';\nconst PILLAR = 'geometry:pillar';\nconst RING = 'geometry:ring';\n\n/** Defines a prop from short parts. */\nfunction prop(name: string, description: string, parts: readonly Part[], size?: readonly [number, number, number]): void {\n  defineProp(`prop:${name}`, {\n    description,\n    parts: parts.map((part, k) => ({\n      name: `part${k}`,\n      geometry: part.g ?? BOX,\n      params: part.p,\n      material: part.m ?? 'material:retreatWhite',\n      ...(part.at ? { position: [...part.at] } : {}),\n      ...(part.tint ? { tint: part.tint } : {}),\n      ...(part.rot ? { rotation: [...part.rot] } : {}),\n    })),\n    ...(size ? { body: { type: 'fixed', shape: 'box', size: [...size] } } : {}),\n  } as never);\n}\n\nconst SEAT_COLOURS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nSEAT_COLOURS.forEach((tint, i) => prop(`matSeat${i}`, 'A class mat in a seat\\u2019s colour.', [{ g: ROUND, p: { width: 1.5, height: 0.05, depth: 2.3, radius: 0.02 }, m: 'material:retreatMat', tint }]));\n\nprop('platform', 'Tare\\u2019s Platform: a low round stage.', [\n  { g: FRUSTUM, p: { bottom: 2.6, top: 2.4, height: 0.4 }, tint: '#f7fafc' },\n  { g: RING, p: { radius: 2.2, thickness: 0.08 }, m: 'material:retreatMint', at: [0, 0.41, 0] },\n]);\nprop('platformRing', 'The bright ring of a Morning Check.', [{ g: RING, p: { radius: 1.1, thickness: 0.05 }, m: 'material:retreatCoral' }]);\nprop('noticeboard', 'The Noticeboard.', [\n  { p: { width: 3, height: 1.8, depth: 0.1 }, at: [0, 1, 0], tint: '#f7fafc' },\n  { p: { width: 2.7, height: 1.5, depth: 0.12 }, at: [0, 1.15, 0], m: 'material:retreatMint' },\n  { g: LIMB, p: { length: 1, radiusStart: 0.06, radiusEnd: 0.06 }, at: [-1.3, 0, 0] },\n  { g: LIMB, p: { length: 1, radiusStart: 0.06, radiusEnd: 0.06 }, at: [1.3, 0, 0] },\n]);\nprop('plaque', 'A \\u201cDid you know?\\u201d plaque on a little post.', [\n  { g: LIMB, p: { length: 0.8, radiusStart: 0.04, radiusEnd: 0.04 }, tint: '#a8b4bc' },\n  { p: { width: 0.6, height: 0.36, depth: 0.05 }, at: [0, 0.8, 0], m: 'material:retreatBrass' },\n]);\nprop('hiddenPebble', 'A pebble somebody has placed with care.', [{ g: ROUND, p: { width: 0.38, height: 0.2, depth: 0.3, radius: 0.09 }, m: 'material:retreatCoral' }]);\n['#d7dee2', '#b8c6cc', '#e8e1cf', '#9fb4a8'].forEach((tint, k) => prop(`cairnPebble${k}`, 'A pebble of your cairn.', [{ g: ROUND, p: { width: 0.34, height: 0.15, depth: 0.28, radius: 0.07 }, m: 'material:retreatStone', tint }]));\nprop('bench', 'A clean white bench.', [\n  { p: { width: 1.8, height: 0.08, depth: 0.5 }, at: [0, 0.45, 0] },\n  { p: { width: 1.8, height: 0.5, depth: 0.08 }, at: [0, 0.6, -0.22] },\n  { p: { width: 0.1, height: 0.45, depth: 0.45 }, at: [-0.8, 0, 0], tint: '#a8b4bc' },\n  { p: { width: 0.1, height: 0.45, depth: 0.45 }, at: [0.8, 0, 0], tint: '#a8b4bc' },\n]);\nprop('pavilion', 'The Pose Pavilion: white floor, pale curtains, open sides.', [\n  { p: { width: 22, height: 0.15, depth: 16 }, at: [0, 0, 1], tint: '#f7fafc' },\n  ...[[-10, -6], [10, -6], [-10, 8], [10, 8], [0, -6], [0, 8]].map(([x, z]) => ({ g: PILLAR, p: { width: 0.5, height: 5.2 }, at: [x, 0.15, z] as const })),\n  { g: FRUSTUM, p: { bottom: 14, top: 2, height: 2.6 }, at: [0, 5.4, 1], tint: '#f7fafc' },\n  { p: { width: 3, height: 4.6, depth: 0.1 }, at: [-6.5, 0.4, -6.2], m: 'material:retreatCurtain' },\n  { p: { width: 3, height: 4.6, depth: 0.1 }, at: [6.5, 0.4, -6.2], m: 'material:retreatCurtain' },\n]);\nprop('roundFloor', 'The ground round a session\\u2019s pavilion.', [{ p: { width: 120, height: 0.05, depth: 120 }, at: [0, -0.06, 0], m: 'material:retreatLawn' }]);\nprop('annex', 'The Annex: one long open roof over a mirror wall.', [\n  { p: { width: 26, height: 0.15, depth: 18 }, at: [0, 0, 0], tint: '#f7fafc' },\n  { p: { width: 26, height: 4.2, depth: 0.2 }, at: [0, 0.15, -9], m: 'material:retreatMirror' },\n  { p: { width: 28, height: 0.3, depth: 20 }, at: [0, 4.6, 0], tint: '#f7fafc' },\n  ...[[-12.5, 8.5], [12.5, 8.5], [-12.5, -8.5], [12.5, -8.5], [0, 8.5]].map(([x, z]) => ({ g: PILLAR, p: { width: 0.4, height: 4.5 }, at: [x, 0.15, z] as const })),\n]);\nprop('stepPlatform', 'A low stepping platform.', [{ g: ROUND, p: { width: 1.6, height: 0.16, depth: 1, radius: 0.05 }, m: 'material:retreatMint' }]);\nprop('floorTile', 'A floor tile that lights on the beat.', [{ p: { width: 1.4, height: 0.03, depth: 1.4 }, m: 'material:retreatCoral' }]);\nprop('hut', 'A guest hut.', [\n  { p: { width: 5, height: 2.6, depth: 4 } },\n  { g: FRUSTUM, p: { bottom: 3.6, top: 0.4, height: 1.5 }, at: [0, 2.6, 0], m: 'material:retreatCoral' },\n  { p: { width: 1, height: 1.9, depth: 0.1 }, at: [0, 0, 2.02], m: 'material:retreatMint' },\n]);\nprop('ferryPier', 'The pier.', [\n  { p: { width: 4, height: 0.2, depth: 22 }, at: [0, 0.4, 2], m: 'material:retreatWood' },\n  ...[-6, 2, 10].flatMap((z) => [-1.8, 1.8].map((x) => ({ g: PILLAR, p: { width: 0.3, height: 2.5 }, at: [x, -2, z] as const, m: 'material:retreatWood' }))),\n  { p: { width: 5, height: 1.4, depth: 12 }, at: [8, -0.3, 8], tint: '#f7fafc' },\n  { p: { width: 3, height: 1.4, depth: 4 }, at: [8, 1.1, 6], m: 'material:retreatMint' },\n]);\nprop('lighthouse', 'The lighthouse.', [\n  { g: FRUSTUM, p: { bottom: 2.6, top: 1.6, height: 11 } },\n  { g: FRUSTUM, p: { bottom: 1.62, top: 1.5, height: 2 }, at: [0, 7, 0], m: 'material:retreatCoral' },\n  { g: FRUSTUM, p: { bottom: 1.2, top: 1.1, height: 1.6 }, at: [0, 11, 0], m: 'material:retreatLamp' },\n  { g: FRUSTUM, p: { bottom: 1.5, top: 0.2, height: 1 }, at: [0, 12.6, 0], m: 'material:retreatCoral' },\n]);\nprop('centreStone', 'A plain stone with a brass plate reading \\u201cDo not\\u201d.', [\n  { g: FRUSTUM, p: { bottom: 1.5, top: 1.1, height: 0.4 }, m: 'material:retreatStone' },\n  { p: { width: 0.6, height: 0.03, depth: 0.3 }, at: [0, 0.4, 0], m: 'material:retreatBrass' },\n]);\nprop('sandTerrace', 'A raked terrace of pale gravel.', [{ p: { width: 2