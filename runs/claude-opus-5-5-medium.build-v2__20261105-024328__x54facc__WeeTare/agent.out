{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaEBUzJMMEEaMnByQN6","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11142,"cache_read_input_tokens":195802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11142},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"bd21bf9b-ca5a-4b68-a5c6-f7874d7aa4c4","timestamp":"2026-11-05T09:52:25.171Z","request_id":"req_011CgjaEBDcjtwipsH6fFSow","thinking_duration_ms":110158,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaEBUzJMMEEaMnByQN6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FGYD51zQbSQZqswdMxAo47","name":"Bash","input":{"command":"cat > labs/game/scenes/events/kit.ts <<'E'\n/**\n * @file What every activity is made of: the `Activity` shape, the running state's helpers, standing people on their marks,\n * moving props, and the small rules many activities share. An activity runs on `flow.ev`: phases, per-seat numbers in\n * `ev.s`, its own data in `ev.d`, entities it spawned in `ev.owned` (removed at the end, so nothing is left behind).\n */\nimport { driveBody, physicsOf, placeActor, removeProp, spawnProp, type World } from '../../../../engine/sim-api';\nimport { setLean, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { STATIONS, type StationId } from '../data/stations';\nimport { cue, flowOf, say, seatsOf, type EvState, type SeatE, type W } from '../types';\nimport { stepBreath, stepWobble } from '../wobble';\n\n/** An activity module. */\nexport interface Activity {\n  readonly id: string;\n  readonly title: string;\n  readonly station: StationId;\n  /** The camera's name in ui/shots.ts. */\n  readonly shot: string;\n  /** The action map the page uses. */\n  readonly map: 'balance' | 'pointer';\n  readonly song: string;\n  /** Plays on every seat; others play seat 0 alone. */\n  readonly multi?: boolean;\n  setup(w: W, ev: EvState): void;\n  step(w: W, ev: EvState): void;\n  bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order;\n  teardown?(w: W, ev: EvState): void;\n}\n\n/** A place on the island or, in a session's little scene, the Pavilion alone. */\nexport function stationAt(w: W, id: StationId): { x: number; z: number; yaw: number } {\n  if (w.query('roundScene').length) return { x: 0, z: 0, yaw: 0 };\n  return STATIONS[id];\n}\n\n/** The ground's height at (x, z), by a ray; `fallback` where there is none. */\nexport function groundAt(w: W, x: number, z: number, fallback = 0): number {\n  const hit = physicsOf(w as unknown as World).raycast([x, 60, z], [0, -1, 0], { maxDistance: 120, groups: 'world' });\n  return hit ? 60 - hit.distance : fallback;\n}\n\n/** Stands actor `id` on the ground at (x, z), at rest. */\nexport function standAt(w: W, id: number, x: number, z: number, yaw = 0): void {\n  placeActor(w, id, [x, groundAt(w, x, z) + 0.02, z], yaw);\n}\n\n/** Holds actor `id` at a point in the air or over water: it never falls, because the step puts it back. */\nexport function hover(w: W, id: number, x: number, y: number, z: number, yaw: number): void {\n  placeActor(w, id, [x, y, z], yaw);\n}\n\n/** Spawns a prop for this run; the activity's end removes it. */\nexport function ownProp(w: W, ev: EvState, prop: string, at: readonly [number, number, number], yaw = 0): number {\n  const id = spawnProp(w, { prop, at: [at[0], at[1], at[2]], yaw } as never);\n  ev.owned.push(id);\n  return id;\n}\n\n/** A quaternion from yaw alone. */\nexport const yawQuat = (yaw: number): [number, number, number, number] => [0, Math.sin(yaw / 2), 0, Math.cos(yaw / 2)];\n\n/** A quaternion for a small tilt: `rx` about east, `rz` about south, radians. */\nexport function tiltQuat(rx: number, rz: number): [number, number, number, number] {\n  const [cx, sx, cz, sz] = [Math.cos(rx / 2), Math.sin(rx / 2), Math.cos(rz / 2), Math.sin(rz / 2)];\n  return [sx * cz, sx * sz * -1 * 0 + 0, cx * sz, cx * cz];\n}\n\n/** Moves a kinematic prop to a pose this step. */\nexport function moveProp(\n  w: W,\n  id: number,\n  at: readonly [number, number, number],\n  q: readonly [number, number, number, number] = [0, 0, 0, 1],\n): void {\n  const entity = (w as unknown as World).get(id) as unknown as { sceneProp?: { body: number } } | undefined;\n  if (!entity?.sceneProp) return;\n  const pose = { position: { x: at[0], y: at[1], z: at[2] }, rotation: { x: q[0], y: q[1], z: q[2], w: q[3] } };\n  driveBody(physicsOf(w as unknown as World), entity.sceneProp.body, pose as never, 1 / 60);\n}\n\n/** The seats an activity plays on. */\nexport const playing = (w: W, ev: EvState): SeatE[] =>\n  seatsOf(w).filter((e) => ev.seats.includes(e.seat.index) && e.seat.kind !== 'none');\n\n/** Moves the activity on a phase. */\nexport function phase(ev: EvState, name: string): void {\n  ev.phase = name;\n  ev.t = 0;\n}\n\n/** Whether a foot just went down. */\nexport const footDown = (e: SeatE, side: 'l' | 'r'): boolean =>\n  side === 'l' ? e.seat.input.l >= 0.5 && e.seat.pl < 0.5 : e.seat.input.r >= 0.5 && e.seat.pr < 0.5;\n\n/** Whether the seat's `act` was just pressed. */\nexport const actDown = (e: SeatE): boolean => e.seat.input.act && !e.seat.pact;\n\n/** Whether both feet are down. */\nexport const bothHeld = (e: SeatE): boolean => e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5;\n\n/** Whether the CoB is inside a ring. */\nexport const inRing = (e: SeatE, x: number, y: number, r: number): boolean =>\n  Math.hypot(e.wobble.x - x, e.wobble.y - y) <= r;\n\n/** A line out of `count` numbered ones, by the stream `lines`. */\nexport function sayOne(w: W, base: string, count: number, who: string): void {\n  say(w, `${base}.${w.rng('lines').int(1, count)}`, who);\n}\n\n/** Runs balance and breath for every playing seat. Ghosts only show what their messages say. */\nexport function balanceAll(w: W, ev: EvState, disturb?: (e: SeatE) => [number, number]): void {\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    stepBreath(w, e, w.tick);\n    if (!e.wobble.off) stepWobble(w, e, disturb ? disturb(e) : [0, 0]);\n  }\n}\n\n/** Puts a body in a pose, tips it by its CoB, and lets it stumble while it recovers from a topple. */\nexport function bodyPose(w: W, e: SeatE, clip: string, t: number, mirror = false, lean = 1): void {\n  if (e.wobble.recover > 0) setPose(w, e.seat.actor, 'RETREAT/Stumble', Math.min(1, e.wobble.recover / 30));\n  else setPose(w, e.seat.actor, clip, t, mirror);\n  setLean(w, e.seat.actor, e.wobble.x * lean, e.wobble.y * lean);\n}\n\n/** The opening of every activity's short form: a lead-in the whole class stands through. */\nexport function leadIn(w: W, ev: EvState, steps = 360): boolean {\n  if (ev.phase !== 'lead') return false;\n  if (ev.t === 0) cue(w, 'whistle');\n  if (ev.t >= steps) phase(ev, 'go');\n  return ev.phase === 'lead';\n}\n\n/** Removes everything this run spawned. */\nexport function clearOwned(w: W, ev: EvState): void {\n  const world = w as unknown as World;\n  for (const id of ev.owned) {\n    const entity = world.get(id) as unknown as { sceneProp?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\n    else world.despawn(id);\n  }\n  ev.owned.length = 0;\n}\n\n/** Whether the game is running attract. */\nexport const inAttract = (w: W): boolean => flowOf(w).auto;\n\n/** Clamps. */\nexport const clamp = (v: number, a: number, b: number): number => Math.max(a, Math.min(b, v));\nE\ncat > labs/game/scenes/data/poses.ts <<'E'\n/**\n * @file The poses as a table (PLAN.md section 6). A row is one pose: its strip, its seat(s) on the disc, and its rules.\n * Adding a pose is adding a row and a strip in cast/clips.ts. `CLASSES` deals them into the three Pose Classes.\n */\nexport interface Pose {\n  readonly id: string;\n  readonly title: string;\n  readonly clip: string;\n  readonly seats: readonly (readonly [number, number])[];\n  /** Sway and instability scales. */\n  readonly sway: number;\n  readonly instab: number;\n  /** How much the breath weighs in the score. */\n  readonly breath: number;\n  /** Which feet must stay down. */\n  readonly hold: '' | 'l' | 'both';\n  /** The ring's scale: 1 is `game.pose.ring`. */\n  readonly ring: number;\n  /** Sway climbs with time. */\n  readonly climbs?: boolean;\n  /** The gull lands halfway. */\n  readonly gull?: boolean;\n  /** The strip follows the lungs. */\n  readonly lungs?: boolean;\n  /** Each seat's hold, seconds, when it isn't `game.pose.hold`. */\n  readonly each?: number;\n}\n\nexport const POSES: Readonly<Record<string, Pose>> = {\n  nothing: { id: 'nothing', title: 'Seated Nothing', clip: 'RETREAT/Nothing', seats: [[0, 0]], sway: 0.5, instab: 1, breath: 0.6, hold: '', ring: 1 },\n  chair: { id: 'chair', title: 'The Patient Chair', clip: 'RETREAT/Chair', seats: [[0, -0.35]], sway: 1, instab: 1, breath: 0, hold: 'both', ring: 1, climbs: true },\n  heron: { id: 'heron', title: 'The Heron', clip: 'RETREAT/Heron', seats: [[0, 0]], sway: 1, instab: 1.5, breath: 0.3, hold: 'l', ring: 1 },\n  archer: { id: 'archer', title: 'The Archer', clip: 'RETREAT/Archer', seats: [[0.35, 0.35]], sway: 1, instab: 1.2, breath: 0.3, hold: '', ring: 1 },\n  comma: { id: 'comma', title: 'The Sideways Comma', clip: 'RETREAT/CommaR', seats: [[0.5, 0], [-0.5, 0]], sway: 1, instab: 1, breath: 0.3, hold: '', ring: 1, each: 8 },\n  napkin: { id: 'napkin', title: 'The Folded Napkin', clip: 'RETREAT/Napkin', seats: [[0, 0.5]], sway: 1, instab: 1, breath: 0.3, hold: '', ring: 1, gull: true },\n  bridge: { id: 'bridge', title: 'The Polite Bridge', clip: 'RETREAT/Bridge', seats: [[0, 0]], sway: 1, instab: 1, breath: 0.7, hold: '', ring: 1, lungs: true },\n  lighthouse: { id: 'lighthouse', title: 'The Lighthouse', clip: 'RETREAT/Lighthouse', seats: [[0, 0]], sway: 1.2, instab: 1, breath: 0.3, hold: '', ring: 0.7 },\n}; // prettier-ignore\n\nexport const CLASSES: Readonly<Record<string, readonly string[]>> = {\n  poseA: ['nothing', 'chair', 'heron'],\n  poseB: ['archer', 'comma', 'napkin'],\n  poseC: ['bridge', 'lighthouse'],\n};\nE\ncat > labs/game/scenes/events/pose.ts <<'E'\n/**\n * @file Pose Class (PLAN.md section 6). Plumb demonstrates; you follow a guide dot from the centre to the pose's seat, and\n * that progress scrubs the pose strip; then you hold the ring, breathing with the guide, while your off-seat lean tips the\n * body. Every seat plays: CPU guests hold too, and in a Round the other mats are ghosts. The `heron` activity is the\n * one-pose short form rounds deal.\n */\nimport { setPose } from '../../cast/body';\nimport { breathFeet, type Order, type Skill } from '../bot/players';\nimport { CLASSES, POSES, type Pose } from '../data/poses';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { syncShare, resetWobble } from '../wobble';\nimport { actDown, balanceAll, bodyPose, clamp, inRing, leadIn, phase, playing, sayOne, type Activity } from './kit';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\n\nconst DEMO = 240;\nconst ENTER_WAIT = 600;\nconst ENTER_MAX = 900;\nconst REST = 150;\n\ninterface PoseData { list: string[]; at: number; hold: number; seatAt: number; total: number; scores: Record<string, number[]> }\n\nconst dataOf = (ev: EvState): PoseData => ev.d as unknown as PoseData;\nconst poseOf = (ev: EvState): Pose => POSES[dataOf(ev).list[dataOf(ev).at]];\nconst holdSteps = (w: W, pose: Pose): number => Math.round((pose.each ?? gameNumber(w, 'game.pose.hold')) * 60);\n\n/** The guide dot on its curved way from the centre to the seat. */\nfunction guideDot(seat: readonly [number, number], k: number): [number, number] {\n  const bend = Math.sin(k * Math.PI) * 0.12;\n  return [seat[0] * k - seat[1] * bend, seat[1] * k + seat[0] * bend + bend * (seat[0] === 0 && seat[1] === 0 ? 1 : 0)];\n}\n\n/** The seat's aim on the disc now. */\nfunction aimOf(ev: EvState, e: SeatE): [number, number] {\n  const pose = poseOf(ev);\n  const seat = pose.seats[Math.min(dataOf(ev).seatAt, pose.seats.length - 1)];\n  const s = ev.s[e.seat.index];\n  if (ev.phase === 'enter') return guideDot(seat, s.prog);\n  return [seat[0], seat[1]];\n}\n\nfunction startPose(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  dataOf(ev).seatAt = 0;\n  dataOf(ev).hold = 0;\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind !== 'ghost') {\n      resetWobble(e.wobble);\n      e.wobble.instab = pose.instab;\n      e.wobble.sway = pose.sway;\n    }\n    Object.assign(ev.s[e.seat.index], { prog: 0, inside: 0, steps: 0, wait: 0 });\n    e.seat.pose = pose.id;\n  }\n  say(w, `pose.intro.${pose.id}`, 'plumb');\n  phase(ev, ev.short ? 'enter' : 'demo');\n}\n\nfunction scorePose(ev: EvState, w: W): void {\n  const pose = poseOf(ev);\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    const share = s.steps ? s.inside / s.steps : 0;\n    const breath = Math.max(0, (syncShare(e.wobble) - 0.2) / 0.8);\n    const value = 1000 * ((1 - pose.breath) * share + pose.breath * breath) - 60 * e.wobble.topples;\n    (dataOf(ev).scores[e.seat.index] ??= []).push(clamp(value, 0, 1000));\n    e.seat.score = mean(dataOf(ev).scores[e.seat.index]);\n  }\n}\n\nconst mean = (list: readonly number[]): number => (list.length ? list.reduce((a, b) => a + b, 0) / list.length : 0);\n\nfunction enterStep(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  balanceAll(w, ev);\n  let waited = true;\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    const [gx, gy] = guideDot(pose.seats[0], s.prog);\n    if (inRing(e, gx, gy, 0.18)) {\n      s.prog = Math.min(1, s.prog + 1 / 150);\n      s.wait = 0;\n    } else s.wait += 1;\n    if (e.seat.index === ev.seats[0] && s.prog < 1 && s.wait < ENTER_WAIT) waited = false;\n    if (s.prog > 0.995 && e.seat.index === ev.seats[0]) waited = true;\n    if (e.seat.kind !== 'ghost') bodyPose(w, e, pose.clip, s.prog);\n  }\n  if (waited || ev.t > ENTER_MAX) {\n    const s0 = ev.s[ev.seats[0]];\n    if (s0.prog < 0.99) say(w, 'pose.start', 'plumb');\n    cue(w, 'bell');\n    phase(ev, 'hold');\n  }\n}\n\nfunction holdStep(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  const d = dataOf(ev);\n  const steps = holdSteps(w, pose);\n  const ring = gameNumber(w, 'game.pose.ring') * pose.ring;\n  balanceAll(w, ev, (e) => {\n    if (pose.gull && d.hold > steps / 2) return [0.8 * Math.sin(w.tick * 0.012), -2.5];\n    return pose.climbs ? [0, 0] : [0, 0];\n  });\n  if (pose.gull && d.hold === Math.floor(steps / 2)) cue(w, 'gullLand', { on: 'seat0' });\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    if (pose.climbs && e.seat.kind !== 'ghost') e.wobble.sway = pose.sway + (d.hold / steps) * 0.8;\n    const [ax, ay] = aimOf(ev, e);\n    const feet = pose.hold === '' || (pose.hold === 'l' ? e.seat.input.l >= 0.5 : e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5);\n    s.steps += 1;\n    if (inRing(e, ax, ay, ring) && feet) s.inside += 1;\n    if (e.seat.kind === 'ghost') continue;\n    const clip = pose.id === 'comma' && d.seatAt === 1 ? 'RETREAT/CommaL' : pose.clip;\n    const t = pose.lungs ? 0.5 + 0.5 * e.wobble.lungs : 1;\n    bodyPose(w, e, clip, t, false, 0.8);\n  }\n  d.hold += 1;\n  if (pose.seats.length > 1 && d.seatAt < pose.seats.length - 1 && d.hold >= steps / pose.seats.length) {\n    d.seatAt += 1;\n    cue(w, 'bell');\n  }\n  if (d.hold >= steps) {\n    scorePose(ev, w);\n    sayOne(w, 'pose.rest', 4, 'plumb');\n    cue(w, 'bell');\n    phase(ev, 'rest');\n  }\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  if (ev.phase === 'go') return startPose(w, ev);\n  const d = dataOf(ev);\n  const cast = castOf(w);\n  const pose = poseOf(ev);\n  if (ev.phase === 'demo') {\n    if (cast.plumb >= 0) setPose(w, cast.plumb, pose.clip, clamp(ev.t / 120, 0, 1));\n    const skip = playing(w, ev).some((e) => e.seat.kind === 'human' && actDown(e));\n    if (ev.t >= DEMO || skip) {\n      say(w, 'pose.nowYou', 'plumb');\n      phase(ev, 'enter');\n    }\n    return;\n  }\n  if (cast.plumb >= 0) setPose(w, cast.plumb, pose.clip, 1);\n  if (ev.phase === 'enter') return enterStep(w, ev);\n  if (ev.phase === 'hold') return holdStep(w, ev);\n  if (ev.phase === 'rest') {\n    for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') bodyPose(w, e, pose.clip, clamp(1 - ev.t / 60, 0, 1));\n    if (ev.t < REST) return;\n    d.at += 1;\n    if (d.at >= d.list.length) {\n      if (cast.plumb >= 0) setPose(w, cast.plumb, 'RETREAT/Stand', 0);\n      ev.done = true;\n      ev.score = rankScore(mean(d.scores[ev.seats[0]] ?? []));\n      return;\n    }\n    startPose(w, ev);\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'demo' || ev.phase === 'lead' || ev.phase === 'rest') return {};\n  const pose = poseOf(ev);\n  const feet = breathFeet(w, skill);\n  const order: Order = { aim: aimOf(ev, e), l: feet, r: feet };\n  if (pose.hold === 'both') [order.l, order.r] = [1, 1];\n  if (pose.hold === 'l') order.l = 1;\n  return order;\n}\n\n/** Makes a Pose Class activity for a list of poses. */\nfunction poseClass(id: string, title: string, list: readonly string[], short: boolean): Activity {\n  return {\n    id, title, station: 'pavilion', shot: 'mat', map: 'balance', song: 'song:stillness', multi: true,\n    setup(w, ev) {\n      arrangeClass(w, ev);\n      Object.assign(ev.d, { list: [...list], at: 0, hold: 0, seatAt: 0, scores: {} });\n      ev.seats.forEach((i) => (ev.s[i] = { prog: 0, inside: 0, steps: 0, wait: 0 }));\n      if (short) return phase(ev, 'lead');\n      startPose(w, ev);\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const POSE_ACTIVITIES: readonly Activity[] = [\n  poseClass('poseA', 'Pose Class', CLASSES.poseA, false),\n  poseClass('poseB', 'Pose Class II', CLASSES.poseB, false),\n  poseClass('poseC', 'Pose Class III', CLASSES.poseC, false),\n  poseClass('heron', 'The Heron', ['heron'], true),\n];\nE\ncat > labs/game/scenes/cast-ref.ts <<'E'\n/**\n * @file Who stands where, by id: the component `cast` (one entity) names the actors and crowd bodies a scene has, so\n * activities reach Plumb or Gerald without a search. Absent people are −1: a session's small scene has fewer.\n */\nimport { defineComponent } from '../../../engine/sim-api';\nimport type { W } from './types';\n\nexport interface Cast {\n  plumb: number; tare: number; gerald: number; bex: number; nan: number; guest: number;\n  gull: number; frog: number; extras: number[];\n}\n\nexport const CAST = defineComponent('cast', {\n  description: 'The ids of the scene’s people and critters.',\n  fields: {\n    plumb: { type: 'integer', default: -1, description: 'Instructor Plumb.' },\n    tare: { type: 'integer', default: -1, description: 'Tare.' },\n    gerald: { type: 'integer', default: -1, description: 'Gerald.' },\n    bex: { type: 'integer', default: -1, description: 'Bex.' },\n    nan: { type: 'integer', default: -1, description: 'Old Nan.' },\n    guest: { type: 'integer', default: -1, description: 'You.' },\n    gull: { type: 'integer', default: -1, description: 'The Gull.' },\n    frog: { type: 'integer', default: -1, description: 'The Frog.' },\n    extras: { type: 'array', default: [], description: 'Other guests.' },\n  },\n});\n\nexport const castOf = (w: W): Cast => (w.query('cast' as never)[0] as unknown as { cast: Cast }).cast;\nE\ncat > labs/game/scenes/events/mats.ts <<'E'\n/**\n * @file The Pavilion's class floor: stands each seat's body on its mat, Plumb in front, spawns the mats for this class,\n * and hands back how a raw score becomes the activity's. Group Class and a session's Round use the same floor.\n */\nimport { clearBody } from '../../cast/body';\nimport { FRONT_MAT, MATS } from '../data/stations';\nimport { seatsOf, type EvState, type W } from '../types';\nimport { castOf } from '../cast-ref';\nimport { groundAt, ownProp, standAt, stationAt } from './kit';\n\n/** Stands the class on its mats. `ev.seats` lists who plays. */\nexport function arrangeClass(w: W, ev: EvState, station: 'pavilion' | 'plaza' | 'annex' = 'pavilion'): void {\n  const c = stationAt(w, station);\n  const cast = castOf(w);\n  if (cast.plumb >= 0) standAt(w, cast.plumb, c.x + FRONT_MAT[0], c.z + FRONT_MAT[1], 0);\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind === 'none') continue;\n    const mat = MATS[e.seat.index];\n    const [x, z] = [c.x + mat[0], c.z + mat[1]];\n    ownProp(w, ev, `prop:matSeat${e.seat.index}`, [x, groundAt(w, x, z) + 0.01, z]);\n    if (e.seat.actor >= 0) {\n      standAt(w, e.seat.actor, x, z, Math.PI);\n      clearBody(w, e.seat.actor);\n    }\n  }\n}\n\n/** A class's raw mean as its score, whole numbers. */\nexport const rankScore = (raw: number): number => Math.round(Math.max(0, Math.min(1000, raw)));\nE\ncat > labs/game/scenes/events/ring.ts <<'E'\n/**\n * @file The Still Ring and the Morning Check. The ring is the first thing you learn: stay inside it. `ring` is the short\n * class a Round opens with, every seat on its mat. `check` is the daily test on Tare's Platform: a question (it only\n * changes the remark), then the Still Ring, Reach and One Foot, ending in a Wobble Age.\n */\nimport { breathFeet, type Order, type Skill } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, flowOf, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { balanceAll, bodyPose, clamp, footDown, inRing, leadIn, ownProp, phase, playing, sayOne, standAt, stationAt, type Activity } from './kit';\n\nconst RING = 0.22;\nconst NARROW = 0.16;\n\n/** Today's question count: the page holds their text, by day. */\nexport const QUESTIONS = 12;\n\n/** The short class: 45 s in the ring. */\nexport const RING_CLASS: Activity = {\n  id: 'ring', title: 'The Still Ring', station: 'pavilion', shot: 'mat', map: 'balance', song: 'song:stillness', multi: true,\n  setup(w, ev) {\n    arrangeClass(w, ev);\n    ev.seats.forEach((i) => (ev.s[i] = { inside: 0, steps: 0 }));\n    phase(ev, 'lead');\n    for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') resetWobble(e.wobble);\n    say(w, 'ring.intro', 'plumb');\n  },\n  step(w, ev) {\n    if (leadIn(w, ev)) return;\n    const total = 2700;\n    balanceAll(w, ev);\n    const r = ev.t > total * 0.66 ? NARROW : RING;\n    ev.d.ring = r;\n    for (const e of playing(w, ev)) {\n      const s = ev.s[e.seat.index];\n      s.steps += 1;\n      if (inRing(e, 0, 0, r)) s.inside += 1;\n      if (e.seat.kind !== 'ghost') bodyPose(w, e, 'RETREAT/Stand', 1);\n      e.seat.score = (1000 * s.inside) / Math.max(1, s.steps);\n    }\n    if (ev.t >= total) {\n      const s = ev.s[ev.seats[0]];\n      ev.score = rankScore((1000 * s.inside) / Math.max(1, s.steps));\n      ev.done = true;\n    }\n  },\n  bot: () => ({ aim: [0, 0] }),\n}; // prettier-ignore\n\nconst ASK = 480;\nconst STILL = 720;\nconst REACH = 1440;\nconst FOOT = 480;\nconst REACH_R = 0.5;\nconst TARGET_R = 0.16;\nconst TARGET_HOLD = 30;\n\ninterface CheckData { a: number; b: number; c: number; targets: number[][]; at: number; hold: number; foot: string; question: number; final: boolean; inside: number; steps: number; lift: number; intro: number }\n\nconst dataOf = (ev: EvState): CheckData => ev.d as unknown as CheckData;\n\n/** The Morning Check's score from its three parts (the plan's weights). */\nexport const checkScore = (a: number, b: number, c: number): number => 0.45 * a + 0.3 * b + 0.25 * c;\n\n/** Starts the seeded six targets. */\nfunction reachTargets(w: W): number[][] {\n  const rng = w.rng('check');\n  const order = [0, 1, 2, 3, 4, 5];\n  for (let k = 5; k > 0; k--) {\n    const j = rng.int(0, k);\n    [order[k], order[j]] = [order[j], order[k]];\n  }\n  return order.map((i) => [Math.cos((i * Math.PI) / 3) * REACH_R, Math.sin((i * Math.PI) / 3) * REACH_R]);\n}\n\nexport const CHECK: Activity = {\n  id: 'check', title: 'Morning Check', station: 'plaza', shot: 'check', map: 'balance', song: 'song:stillness',\n  setup(w, ev) {\n    const c = stationAt(w, 'plaza');\n    const [e] = playing(w, ev);\n    const flow = flowOf(w);\n    ownProp(w, ev, 'prop:platformRing', [c.x, 8.42, c.z - 6]);\n    standAt(w, e.seat.actor, c.x, c.z - 6, 0);\n    const cast = castOf(w);\n    if (cast.tare >= 0) standAt(w, cast.tare, c.x + 1.4, c.z - 4.6, -0.6);\n    resetWobble(e.wobble);\n    const question = w.rng('check').int(1, QUESTIONS);\n    Object.assign(ev.d, { a: 0, b: 0, c: 0, targets: [], at: 0, hold: 0, foot: 'l', question, final: !!ev.d.final, inside: 0, steps: 0, lift: 0, intro: flow.day === 1 ? 1 : 0 });\n    ev.s[e.seat.index] = {};\n    say(w, `check.q.${question}`, 'tare');\n    phase(ev, 'ask');\n  },\n  step(w, ev) {\n    const d = dataOf(ev);\n    const [e] = playing(w, ev);\n    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\n    if (ev.phase === 'ask') {\n      pose(1);\n      const yes = footDown(e, 'l');\n      const no = footDown(e, 'r');\n      if (yes || no || ev.t >= ASK) {\n        say(w, ev.t >= ASK ? 'check.a.none' : yes ? 'check.a.yes' : 'check.a.no', 'tare');\n        resetWobble(e.wobble);\n        phase(ev, 'still');\n        if (d.intro) say(w, 'check.intro.still', 'tare');\n      }\n      return;\n    }\n    balanceAll(w, ev);\n    pose(1);\n    if (ev.phase === 'still') {\n      d.steps += 1;\n      if (inRing(e, 0, 0, ev.t > STILL - 240 ? NARROW : RING)) d.inside += 1;\n      if (ev.t >= STILL) {\n        d.a = d.inside / d.steps;\n        d.targets = reachTargets(w);\n        [d.inside, d.steps] = [0, 0];\n        cue(w, 'stamp');\n        if (d.intro) say(w, 'check.intro.reach', 'tare');\n        phase(ev, 'reach');\n      }\n      return;\n    }\n    if (ev.phase === 'reach') {\n      const target = d.targets[d.at];\n      if (inRing(e, target[0], target[1], TARGET_R)) d.hold += 1;\n      else d.hold = 0;\n      if (d.hold >= TARGET_HOLD) {\n        d.hold = 0;\n        d.at += 1;\n        cue(w, 'ding', { n: d.at });\n      }\n      if (d.at >= d.targets.length || ev.t >= REACH) {\n        d.b = d.at >= d.targets.length ? clamp(1 - ev.t / REACH, 0, 1) : 0;\n        d.foot = w.rng('check').chance(0.5) ? 'l' : 'r';\n        e.wobble.instab = 1.6;\n        cue(w, 'stamp');\n        say(w, d.foot === 'l' ? 'check.foot.l' : 'check.foot.r', 'tare');\n        phase(ev, 'foot');\n      }\n      return;\n    }\n    if (ev.phase === 'foot') {\n      const held = d.foot === 'l' ? e.seat.input.l >= 0.5 : e.seat.input.r >= 0.5;\n      d.steps += 1;\n      if (held && inRing(e, 0, 0, 0.3)) d.inside += 1;\n      else if (!held) d.inside = Math.max(0, d.inside - 0.5);\n      bodyPose(w, e, 'RETREAT/StepUpL', held ? 1 : 0, d.foot === 'r');\n      if (ev.t >= FOOT) {\n        d.c = d.inside / d.steps;\n        ev.score = rankScore(1000 * checkScore(d.a, d.b, d.c));\n        ev.done = true;\n      }\n    }\n  },\n  bot(w, ev, e, skill) {\n    const d = dataOf(ev);\n    if (ev.phase === 'ask') return ev.t > 100 ? { l: ev.t % 2 } : {};\n    if (ev.phase === 'reach') return { aim: d.targets[d.at] as [number, number] };\n    if (ev.phase === 'foot') {\n      const down = ev.t > skill.delay ? 1 : 0;\n      return { aim: [0, 0], l: d.foot === 'l' ? down : 0, r: d.foot === 'r' ? down : 0 };\n    }\n    return { aim: [0, 0] };\n  },\n}; // prettier-ignore\n\n/** Plumb's and Tare's lines at the end, by rank, are chosen in the flow. */\nexport const breathOf = breathFeet;\nexport { sayOne };\nexport type { Order, Skill, SeatE };\nvoid gameNumber;\nE\ncat > labs/game/scenes/events/pond.ts <<'E'\n/**\n * @file Still Pond (PLAN.md section 6): the funniest thing in the game and almost no input. Composure starts at 1000; the\n * only right thing to do is breathe with the guide. Anything else is \"You moved\". Lures come from a seeded table, every\n * 6 to 10 seconds, and escalate. The page draws the lures; the sim says which is up, so replays and tests hold them.\n */\nimport type { Order, Skill } from '../bot/players';\nimport { breathFeet } from '../bot/players';\nimport { LURES } from '../data/lures';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble, stepBreath, syncShare } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { actDown, bodyPose, footDown, groundAt, leadIn, ownProp, phase, playing, standAt, stationAt, type Activity } from './kit';\nimport { setPose } from '../../cast/body';\n\nconst DEBOUNCE = 60;\n/** How long one foot alone may be down before it counts: reaching for both is not a stray foot. */\nconst STRAY = 18;\nconst STICK = 0.25;\nconst MOUSE = 0.18;\n\ninterface PondData { lure: string; lureAt: number; nextLure: number; lureT: number; frogLook: number; onKnee: boolean; gullOn: boolean; length: number }\n\nconst dataOf = (ev: EvState): PondData => ev.d as unknown as PondData;\n\n/** The score: composure scaled by breath; no input earns exactly half. */\nexport function pondScore(composure: number, sync: number): number {\n  return composure * (0.5 + 0.5 * Math.max(0, (sync - 0.2) / 0.8));\n}\n\n/** Whether a seat moved this step. */\nfunction moved(e: SeatE, s: Record<string, number>): boolean {\n  const { input } = e.seat;\n  const both = input.l >= 0.5 && input.r >= 0.5;\n  const one = (input.l >= 0.5 || input.r >= 0.5) && !both;\n  s.stray = one ? s.stray + 1 : 0;\n  return Math.hypot(input.x, input.y) > STICK || actDown(e) || s.stray > STRAY || Math.hypot(e.wobble.mx, e.wobble.my) > MOUSE;\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  if (ev.phase === 'go') {\n    say(w, 'pond.begin', 'plumb');\n    phase(ev, 'sit');\n  }\n  const d = dataOf(ev);\n  if (ev.t === d.nextLure) {\n    const entry = LURES[Math.min(d.lureAt, LURES.length - 1)];\n    d.lure = entry.id;\n    d.lureT = 0;\n    d.lureAt += 1;\n    d.nextLure = ev.t + w.rng('pond').int(360, 600);\n    cue(w, 'lure', { id: entry.id });\n    if (entry.line) say(w, entry.line, entry.who ?? 'tare');\n    if (entry.id === 'frogKnee') d.onKnee = true;\n    if (entry.id === 'gullHead') d.gullOn = true;\n  }\n  d.lureT += 1;\n  if (d.lureT > 240) d.lure = '';\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    const s = ev.s[e.seat.index];\n    stepBreath(w, e, w.tick);\n    s.cool = Math.max(0, s.cool - 1);\n    if (moved(e, s) && s.cool === 0) {\n      s.composure = Math.max(0, s.composure - gameNumber(w, 'game.pond.penalty'));\n      s.cool = DEBOUNCE;\n      s.moves += 1;\n      w.emit('moved', { seat: e.seat.index } as never);\n      if (e.seat.index === ev.seats[0]) d.frogLook = 120;\n    }\n    bodyPose(w, e, 'RETREAT/Nothing', 1, false, 0);\n    e.seat.score = pondScore(s.composure, syncShare(e.wobble));\n  }\n  d.frogLook = Math.max(0, d.frogLook - 1);\n  if (ev.t >= d.length) {\n    const [first] = playing(w, ev);\n    ev.score = rankScore(pondScore(ev.s[first.seat.index].composure, syncShare(first.wobble)));\n    say(w, 'pond.end', 'plumb');\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const feet = breathFeet(w, skill);\n  const order: Order = { stick: [0, 0], l: feet, r: feet, raw: skill.name === 'perfect' };\n  const d = dataOf(ev);\n  if (d.lure && d.lureT === 40) {\n    const chance = skill.name === 'sloppy' ? 0.3 : skill.name === 'human' ? 0.1 : 0;\n    if (w.rng('bot').chance(chance)) order.act = true;\n  }\n  return order;\n}\n\nfunction pondActivity(id: string, title: string, short: boolean): Activity {\n  return {\n    id, title, station: 'pond', shot: 'pond', map: 'balance', song: '', multi: short,\n    setup(w, ev) {\n      Object.assign(ev.d, { lure: '', lureAt: 0, nextLure: 300, lureT: 0, frogLook: 0, onKnee: false, gullOn: false, length: short ? 2700 : 4500 });\n      if (short) {\n        arrangeClass(w, ev);\n        phase(ev, 'lead');\n      } else {\n        const c = stationAt(w, 'pond');\n        const [e] = playing(w, ev);\n        const y = groundAt(w, c.x, c.z);\n        ownProp(w, ev, 'prop:jetty', [c.x, y + 0.5, c.z - 2]);\n        standAt(w, e.seat.actor, c.x, c.z, Math.PI);\n        const { frog, plumb } = castOf(w);\n        if (plumb >= 0) {\n          standAt(w, plumb, c.x - 5, c.z - 3, 0.5);\n          setPose(w, plumb, 'RETREAT/Stand', 1);\n        }\n        void frog;\n        phase(ev, 'go');\n      }\n      ev.seats.forEach((i) => (ev.s[i] = { composure: 1000, cool: 0, moves: 0, stray: 0 }));\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.off = true; }\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const POND = pondActivity('pond', 'Still Pond', false);\nexport const POND_SHORT = pondActivity('pondS', 'Still Pond', true);\nvoid footDown;\nE\ncat > labs/game/scenes/data/lures.ts <<'E'\n/**\n * @file Still Pond's lures, in order: each tempts you to press something. The page draws them. A row is an id it knows,\n * and the line said with it, if any.\n */\nexport interface Lure { readonly id: string; readonly line?: string; readonly who?: string }\n\nexport const LURES: readonly Lure[] = [\n  { id: 'pressNow' },\n  { id: 'psst', line: 'pond.lure.psst', who: 'tare' },\n  { id: 'phone', line: 'pond.lure.phone', who: 'bex' },\n  { id: 'frogKnee', line: 'pond.lure.frog', who: 'tare' },\n  { id: 'gullHead', line: 'pond.lure.gull', who: 'tare' },\n  { id: 'fakePause' },\n  { id: 'disconnect' },\n  { id: 'wrong', line: 'pond.lure.wrong', who: 'plumb' },\n  { id: 'credits' },\n  { id: 'pressNow' },\n];\nE\n","description":"Write activity kit, poses, ring, check and pond"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11142,"cache_read_input_tokens":195802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11142},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"d74377e8-da38-4981-95e3-4452c04f6ff0","timestamp":"2026-11-05T09:54:20.721Z","request_id":"req_011CgjaEBDcjtwipsH6fFSow","wire_tool_inputs":{"toolu_01FGYD51zQbSQZqswdMxAo47":{"command":"cat > labs/game/scenes/events/kit.ts <<'E'\n/**\n * @file What every activity is made of: the `Activity` shape, the running state's helpers, standing people on their marks,\n * moving props, and the small rules many activities share. An activity runs on `flow.ev`: phases, per-seat numbers in\n * `ev.s`, its own data in `ev.d`, entities it spawned in `ev.owned` (removed at the end, so nothing is left behind).\n */\nimport { driveBody, physicsOf, placeActor, removeProp, spawnProp, type World } from '../../../../engine/sim-api';\nimport { setLean, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { STATIONS, type StationId } from '../data/stations';\nimport { cue, flowOf, say, seatsOf, type EvState, type SeatE, type W } from '../types';\nimport { stepBreath, stepWobble } from '../wobble';\n\n/** An activity module. */\nexport interface Activity {\n  readonly id: string;\n  readonly title: string;\n  readonly station: StationId;\n  /** The camera's name in ui/shots.ts. */\n  readonly shot: string;\n  /** The action map the page uses. */\n  readonly map: 'balance' | 'pointer';\n  readonly song: string;\n  /** Plays on every seat; others play seat 0 alone. */\n  readonly multi?: boolean;\n  setup(w: W, ev: EvState): void;\n  step(w: W, ev: EvState): void;\n  bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order;\n  teardown?(w: W, ev: EvState): void;\n}\n\n/** A place on the island or, in a session's little scene, the Pavilion alone. */\nexport function stationAt(w: W, id: StationId): { x: number; z: number; yaw: number } {\n  if (w.query('roundScene').length) return { x: 0, z: 0, yaw: 0 };\n  return STATIONS[id];\n}\n\n/** The ground's height at (x, z), by a ray; `fallback` where there is none. */\nexport function groundAt(w: W, x: number, z: number, fallback = 0): number {\n  const hit = physicsOf(w as unknown as World).raycast([x, 60, z], [0, -1, 0], { maxDistance: 120, groups: 'world' });\n  return hit ? 60 - hit.distance : fallback;\n}\n\n/** Stands actor `id` on the ground at (x, z), at rest. */\nexport function standAt(w: W, id: number, x: number, z: number, yaw = 0): void {\n  placeActor(w, id, [x, groundAt(w, x, z) + 0.02, z], yaw);\n}\n\n/** Holds actor `id` at a point in the air or over water: it never falls, because the step puts it back. */\nexport function hover(w: W, id: number, x: number, y: number, z: number, yaw: number): void {\n  placeActor(w, id, [x, y, z], yaw);\n}\n\n/** Spawns a prop for this run; the activity's end removes it. */\nexport function ownProp(w: W, ev: EvState, prop: string, at: readonly [number, number, number], yaw = 0): number {\n  const id = spawnProp(w, { prop, at: [at[0], at[1], at[2]], yaw } as never);\n  ev.owned.push(id);\n  return id;\n}\n\n/** A quaternion from yaw alone. */\nexport const yawQuat = (yaw: number): [number, number, number, number] => [0, Math.sin(yaw / 2), 0, Math.cos(yaw / 2)];\n\n/** A quaternion for a small tilt: `rx` about east, `rz` about south, radians. */\nexport function tiltQuat(rx: number, rz: number): [number, number, number, number] {\n  const [cx, sx, cz, sz] = [Math.cos(rx / 2), Math.sin(rx / 2), Math.cos(rz / 2), Math.sin(rz / 2)];\n  return [sx * cz, sx * sz * -1 * 0 + 0, cx * sz, cx * cz];\n}\n\n/** Moves a kinematic prop to a pose this step. */\nexport function moveProp(\n  w: W,\n  id: number,\n  at: readonly [number, number, number],\n  q: readonly [number, number, number, number] = [0, 0, 0, 1],\n): void {\n  const entity = (w as unknown as World).get(id) as unknown as { sceneProp?: { body: number } } | undefined;\n  if (!entity?.sceneProp) return;\n  const pose = { position: { x: at[0], y: at[1], z: at[2] }, rotation: { x: q[0], y: q[1], z: q[2], w: q[3] } };\n  driveBody(physicsOf(w as unknown as World), entity.sceneProp.body, pose as never, 1 / 60);\n}\n\n/** The seats an activity plays on. */\nexport const playing = (w: W, ev: EvState): SeatE[] =>\n  seatsOf(w).filter((e) => ev.seats.includes(e.seat.index) && e.seat.kind !== 'none');\n\n/** Moves the activity on a phase. */\nexport function phase(ev: EvState, name: string): void {\n  ev.phase = name;\n  ev.t = 0;\n}\n\n/** Whether a foot just went down. */\nexport const footDown = (e: SeatE, side: 'l' | 'r'): boolean =>\n  side === 'l' ? e.seat.input.l >= 0.5 && e.seat.pl < 0.5 : e.seat.input.r >= 0.5 && e.seat.pr < 0.5;\n\n/** Whether the seat's `act` was just pressed. */\nexport const actDown = (e: SeatE): boolean => e.seat.input.act && !e.seat.pact;\n\n/** Whether both feet are down. */\nexport const bothHeld = (e: SeatE): boolean => e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5;\n\n/** Whether the CoB is inside a ring. */\nexport const inRing = (e: SeatE, x: number, y: number, r: number): boolean =>\n  Math.hypot(e.wobble.x - x, e.wobble.y - y) <= r;\n\n/** A line out of `count` numbered ones, by the stream `lines`. */\nexport function sayOne(w: W, base: string, count: number, who: string): void {\n  say(w, `${base}.${w.rng('lines').int(1, count)}`, who);\n}\n\n/** Runs balance and breath for every playing seat. Ghosts only show what their messages say. */\nexport function balanceAll(w: W, ev: EvState, disturb?: (e: SeatE) => [number, number]): void {\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    stepBreath(w, e, w.tick);\n    if (!e.wobble.off) stepWobble(w, e, disturb ? disturb(e) : [0, 0]);\n  }\n}\n\n/** Puts a body in a pose, tips it by its CoB, and lets it stumble while it recovers from a topple. */\nexport function bodyPose(w: W, e: SeatE, clip: string, t: number, mirror = false, lean = 1): void {\n  if (e.wobble.recover > 0) setPose(w, e.seat.actor, 'RETREAT/Stumble', Math.min(1, e.wobble.recover / 30));\n  else setPose(w, e.seat.actor, clip, t, mirror);\n  setLean(w, e.seat.actor, e.wobble.x * lean, e.wobble.y * lean);\n}\n\n/** The opening of every activity's short form: a lead-in the whole class stands through. */\nexport function leadIn(w: W, ev: EvState, steps = 360): boolean {\n  if (ev.phase !== 'lead') return false;\n  if (ev.t === 0) cue(w, 'whistle');\n  if (ev.t >= steps) phase(ev, 'go');\n  return ev.phase === 'lead';\n}\n\n/** Removes everything this run spawned. */\nexport function clearOwned(w: W, ev: EvState): void {\n  const world = w as unknown as World;\n  for (const id of ev.owned) {\n    const entity = world.get(id) as unknown as { sceneProp?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\n    else world.despawn(id);\n  }\n  ev.owned.length = 0;\n}\n\n/** Whether the game is running attract. */\nexport const inAttract = (w: W): boolean => flowOf(w).auto;\n\n/** Clamps. */\nexport const clamp = (v: number, a: number, b: number): number => Math.max(a, Math.min(b, v));\nE\ncat > labs/game/scenes/data/poses.ts <<'E'\n/**\n * @file The poses as a table (PLAN.md section 6). A row is one pose: its strip, its seat(s) on the disc, and its rules.\n * Adding a pose is adding a row and a strip in cast/clips.ts. `CLASSES` deals them into the three Pose Classes.\n */\nexport interface Pose {\n  readonly id: string;\n  readonly title: string;\n  readonly clip: string;\n  readonly seats: readonly (readonly [number, number])[];\n  /** Sway and instability scales. */\n  readonly sway: number;\n  readonly instab: number;\n  /** How much the breath weighs in the score. */\n  readonly breath: number;\n  /** Which feet must stay down. */\n  readonly hold: '' | 'l' | 'both';\n  /** The ring's scale: 1 is `game.pose.ring`. */\n  readonly ring: number;\n  /** Sway climbs with time. */\n  readonly climbs?: boolean;\n  /** The gull lands halfway. */\n  readonly gull?: boolean;\n  /** The strip follows the lungs. */\n  readonly lungs?: boolean;\n  /** Each seat's hold, seconds, when it isn't `game.pose.hold`. */\n  readonly each?: number;\n}\n\nexport const POSES: Readonly<Record<string, Pose>> = {\n  nothing: { id: 'nothing', title: 'Seated Nothing', clip: 'RETREAT/Nothing', seats: [[0, 0]], sway: 0.5, instab: 1, breath: 0.6, hold: '', ring: 1 },\n  chair: { id: 'chair', title: 'The Patient Chair', clip: 'RETREAT/Chair', seats: [[0, -0.35]], sway: 1, instab: 1, breath: 0, hold: 'both', ring: 1, climbs: true },\n  heron: { id: 'heron', title: 'The Heron', clip: 'RETREAT/Heron', seats: [[0, 0]], sway: 1, instab: 1.5, breath: 0.3, hold: 'l', ring: 1 },\n  archer: { id: 'archer', title: 'The Archer', clip: 'RETREAT/Archer', seats: [[0.35, 0.35]], sway: 1, instab: 1.2, breath: 0.3, hold: '', ring: 1 },\n  comma: { id: 'comma', title: 'The Sideways Comma', clip: 'RETREAT/CommaR', seats: [[0.5, 0], [-0.5, 0]], sway: 1, instab: 1, breath: 0.3, hold: '', ring: 1, each: 8 },\n  napkin: { id: 'napkin', title: 'The Folded Napkin', clip: 'RETREAT/Napkin', seats: [[0, 0.5]], sway: 1, instab: 1, breath: 0.3, hold: '', ring: 1, gull: true },\n  bridge: { id: 'bridge', title: 'The Polite Bridge', clip: 'RETREAT/Bridge', seats: [[0, 0]], sway: 1, instab: 1, breath: 0.7, hold: '', ring: 1, lungs: true },\n  lighthouse: { id: 'lighthouse', title: 'The Lighthouse', clip: 'RETREAT/Lighthouse', seats: [[0, 0]], sway: 1.2, instab: 1, breath: 0.3, hold: '', ring: 0.7 },\n}; // prettier-ignore\n\nexport const CLASSES: Readonly<Record<string, readonly string[]>> = {\n  poseA: ['nothing', 'chair', 'heron'],\n  poseB: ['archer', 'comma', 'napkin'],\n  poseC: ['bridge', 'lighthouse'],\n};\nE\ncat > labs/game/scenes/events/pose.ts <<'E'\n/**\n * @file Pose Class (PLAN.md section 6). Plumb demonstrates; you follow a guide dot from the centre to the pose's seat, and\n * that progress scrubs the pose strip; then you hold the ring, breathing with the guide, while your off-seat lean tips the\n * body. Every seat plays: CPU guests hold too, and in a Round the other mats are ghosts. The `heron` activity is the\n * one-pose short form rounds deal.\n */\nimport { setPose } from '../../cast/body';\nimport { breathFeet, type Order, type Skill } from '../bot/players';\nimport { CLASSES, POSES, type Pose } from '../data/poses';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { syncShare, resetWobble } from '../wobble';\nimport { actDown, balanceAll, bodyPose, clamp, inRing, leadIn, phase, playing, sayOne, type Activity } from './kit';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\n\nconst DEMO = 240;\nconst ENTER_WAIT = 600;\nconst ENTER_MAX = 900;\nconst REST = 150;\n\ninterface PoseData { list: string[]; at: number; hold: number; seatAt: number; total: number; scores: Record<string, number[]> }\n\nconst dataOf = (ev: EvState): PoseData => ev.d as unknown as PoseData;\nconst poseOf = (ev: EvState): Pose => POSES[dataOf(ev).list[dataOf(ev).at]];\nconst holdSteps = (w: W, pose: Pose): number => Math.round((pose.each ?? gameNumber(w, 'game.pose.hold')) * 60);\n\n/** The guide dot on its curved way from the centre to the seat. */\nfunction guideDot(seat: readonly [number, number], k: number): [number, number] {\n  const bend = Math.sin(k * Math.PI) * 0.12;\n  return [seat[0] * k - seat[1] * bend, seat[1] * k + seat[0] * bend + bend * (seat[0] === 0 && seat[1] === 0 ? 1 : 0)];\n}\n\n/** The seat's aim on the disc now. */\nfunction aimOf(ev: EvState, e: SeatE): [number, number] {\n  const pose = poseOf(ev);\n  const seat = pose.seats[Math.min(dataOf(ev).seatAt, pose.seats.length - 1)];\n  const s = ev.s[e.seat.index];\n  if (ev.phase === 'enter') return guideDot(seat, s.prog);\n  return [seat[0], seat[1]];\n}\n\nfunction startPose(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  dataOf(ev).seatAt = 0;\n  dataOf(ev).hold = 0;\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind !== 'ghost') {\n      resetWobble(e.wobble);\n      e.wobble.instab = pose.instab;\n      e.wobble.sway = pose.sway;\n    }\n    Object.assign(ev.s[e.seat.index], { prog: 0, inside: 0, steps: 0, wait: 0 });\n    e.seat.pose = pose.id;\n  }\n  say(w, `pose.intro.${pose.id}`, 'plumb');\n  phase(ev, ev.short ? 'enter' : 'demo');\n}\n\nfunction scorePose(ev: EvState, w: W): void {\n  const pose = poseOf(ev);\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    const share = s.steps ? s.inside / s.steps : 0;\n    const breath = Math.max(0, (syncShare(e.wobble) - 0.2) / 0.8);\n    const value = 1000 * ((1 - pose.breath) * share + pose.breath * breath) - 60 * e.wobble.topples;\n    (dataOf(ev).scores[e.seat.index] ??= []).push(clamp(value, 0, 1000));\n    e.seat.score = mean(dataOf(ev).scores[e.seat.index]);\n  }\n}\n\nconst mean = (list: readonly number[]): number => (list.length ? list.reduce((a, b) => a + b, 0) / list.length : 0);\n\nfunction enterStep(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  balanceAll(w, ev);\n  let waited = true;\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    const [gx, gy] = guideDot(pose.seats[0], s.prog);\n    if (inRing(e, gx, gy, 0.18)) {\n      s.prog = Math.min(1, s.prog + 1 / 150);\n      s.wait = 0;\n    } else s.wait += 1;\n    if (e.seat.index === ev.seats[0] && s.prog < 1 && s.wait < ENTER_WAIT) waited = false;\n    if (s.prog > 0.995 && e.seat.index === ev.seats[0]) waited = true;\n    if (e.seat.kind !== 'ghost') bodyPose(w, e, pose.clip, s.prog);\n  }\n  if (waited || ev.t > ENTER_MAX) {\n    const s0 = ev.s[ev.seats[0]];\n    if (s0.prog < 0.99) say(w, 'pose.start', 'plumb');\n    cue(w, 'bell');\n    phase(ev, 'hold');\n  }\n}\n\nfunction holdStep(w: W, ev: EvState): void {\n  const pose = poseOf(ev);\n  const d = dataOf(ev);\n  const steps = holdSteps(w, pose);\n  const ring = gameNumber(w, 'game.pose.ring') * pose.ring;\n  balanceAll(w, ev, (e) => {\n    if (pose.gull && d.hold > steps / 2) return [0.8 * Math.sin(w.tick * 0.012), -2.5];\n    return pose.climbs ? [0, 0] : [0, 0];\n  });\n  if (pose.gull && d.hold === Math.floor(steps / 2)) cue(w, 'gullLand', { on: 'seat0' });\n  for (const e of playing(w, ev)) {\n    const s = ev.s[e.seat.index];\n    if (pose.climbs && e.seat.kind !== 'ghost') e.wobble.sway = pose.sway + (d.hold / steps) * 0.8;\n    const [ax, ay] = aimOf(ev, e);\n    const feet = pose.hold === '' || (pose.hold === 'l' ? e.seat.input.l >= 0.5 : e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5);\n    s.steps += 1;\n    if (inRing(e, ax, ay, ring) && feet) s.inside += 1;\n    if (e.seat.kind === 'ghost') continue;\n    const clip = pose.id === 'comma' && d.seatAt === 1 ? 'RETREAT/CommaL' : pose.clip;\n    const t = pose.lungs ? 0.5 + 0.5 * e.wobble.lungs : 1;\n    bodyPose(w, e, clip, t, false, 0.8);\n  }\n  d.hold += 1;\n  if (pose.seats.length > 1 && d.seatAt < pose.seats.length - 1 && d.hold >= steps / pose.seats.length) {\n    d.seatAt += 1;\n    cue(w, 'bell');\n  }\n  if (d.hold >= steps) {\n    scorePose(ev, w);\n    sayOne(w, 'pose.rest', 4, 'plumb');\n    cue(w, 'bell');\n    phase(ev, 'rest');\n  }\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  if (ev.phase === 'go') return startPose(w, ev);\n  const d = dataOf(ev);\n  const cast = castOf(w);\n  const pose = poseOf(ev);\n  if (ev.phase === 'demo') {\n    if (cast.plumb >= 0) setPose(w, cast.plumb, pose.clip, clamp(ev.t / 120, 0, 1));\n    const skip = playing(w, ev).some((e) => e.seat.kind === 'human' && actDown(e));\n    if (ev.t >= DEMO || skip) {\n      say(w, 'pose.nowYou', 'plumb');\n      phase(ev, 'enter');\n    }\n    return;\n  }\n  if (cast.plumb >= 0) setPose(w, cast.plumb, pose.clip, 1);\n  if (ev.phase === 'enter') return enterStep(w, ev);\n  if (ev.phase === 'hold') return holdStep(w, ev);\n  if (ev.phase === 'rest') {\n    for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') bodyPose(w, e, pose.clip, clamp(1 - ev.t / 60, 0, 1));\n    if (ev.t < REST) return;\n    d.at += 1;\n    if (d.at >= d.list.length) {\n      if (cast.plumb >= 0) setPose(w, cast.plumb, 'RETREAT/Stand', 0);\n      ev.done = true;\n      ev.score = rankScore(mean(d.scores[ev.seats[0]] ?? []));\n      return;\n    }\n    startPose(w, ev);\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'demo' || ev.phase === 'lead' || ev.phase === 'rest') return {};\n  const pose = poseOf(ev);\n  const feet = breathFeet(w, skill);\n  const order: Order = { aim: aimOf(ev, e), l: feet, r: feet };\n  if (pose.hold === 'both') [order.l, order.r] = [1, 1];\n  if (pose.hold === 'l') order.l = 1;\n  return order;\n}\n\n/** Makes a Pose Class activity for a list of poses. */\nfunction poseClass(id: string, title: string, list: readonly string[], short: boolean): Activity {\n  return {\n    id, title, station: 'pavilion', shot: 'mat', map: 'balance', song: 'song:stillness', multi: true,\n    setup(w, ev) {\n      arrangeClass(w, ev);\n      Object.assign(ev.d, { list: [...list], at: 0, hold: 0, seatAt: 0, scores: {} });\n      ev.seats.forEach((i) => (ev.s[i] = { prog: 0, inside: 0, steps: 0, wait: 0 }));\n      if (short) return phase(ev, 'lead');\n      startPose(w, ev);\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const POSE_ACTIVITIES: readonly Activity[] = [\n  poseClass('poseA', 'Pose Class', CLASSES.poseA, false),\n  poseClass('poseB', 'Pose Class II', CLASSES.poseB, false),\n  poseClass('poseC', 'Pose Class III', CLASSES.poseC, false),\n  poseClass('heron', 'The Heron', ['heron'], true),\n];\nE\ncat > labs/game/scenes/cast-ref.ts <<'E'\n/**\n * @file Who stands where, by id: the component `cast` (one entity) names the actors and crowd bodies a scene has, so\n * activities reach Plumb or Gerald without a search. Absent people are −1: a session's small scene has fewer.\n */\nimport { defineComponent } from '../../../engine/sim-api';\nimport type { W } from './types';\n\nexport interface Cast {\n  plumb: number; tare: number; gerald: number; bex: number; nan: number; guest: number;\n  gull: number; frog: number; extras: number[];\n}\n\nexport const CAST = defineComponent('cast', {\n  description: 'The ids of the scene\\u2019s people and critters.',\n  fields: {\n    plumb: { type: 'integer', default: -1, description: 'Instructor Plumb.' },\n    tare: { type: 'integer', default: -1, description: 'Tare.' },\n    gerald: { type: 'integer', default: -1, description: 'Gerald.' },\n    bex: { type: 'integer', default: -1, description: 'Bex.' },\n    nan: { type: 'integer', default: -1, description: 'Old Nan.' },\n    guest: { type: 'integer', default: -1, description: 'You.' },\n    gull: { type: 'integer', default: -1, description: 'The Gull.' },\n    frog: { type: 'integer', default: -1, description: 'The Frog.' },\n    extras: { type: 'array', default: [], description: 'Other guests.' },\n  },\n});\n\nexport const castOf = (w: W): Cast => (w.query('cast' as never)[0] as unknown as { cast: Cast }).cast;\nE\ncat > labs/game/scenes/events/mats.ts <<'E'\n/**\n * @file The Pavilion's class floor: stands each seat's body on its mat, Plumb in front, spawns the mats for this class,\n * and hands back how a raw score becomes the activity's. Group Class and a session's Round use the same floor.\n */\nimport { clearBody } from '../../cast/body';\nimport { FRONT_MAT, MATS } from '../data/stations';\nimport { seatsOf, type EvState, type W } from '../types';\nimport { castOf } from '../cast-ref';\nimport { groundAt, ownProp, standAt, stationAt } from './kit';\n\n/** Stands the class on its mats. `ev.seats` lists who plays. */\nexport function arrangeClass(w: W, ev: EvState, station: 'pavilion' | 'plaza' | 'annex' = 'pavilion'): void {\n  const c = stationAt(w, station);\n  const cast = castOf(w);\n  if (cast.plumb >= 0) standAt(w, cast.plumb, c.x + FRONT_MAT[0], c.z + FRONT_MAT[1], 0);\n  for (const e of seatsOf(w)) {\n    if (e.seat.kind === 'none') continue;\n    const mat = MATS[e.seat.index];\n    const [x, z] = [c.x + mat[0], c.z + mat[1]];\n    ownProp(w, ev, `prop:matSeat${e.seat.index}`, [x, groundAt(w, x, z) + 0.01, z]);\n    if (e.seat.actor >= 0) {\n      standAt(w, e.seat.actor, x, z, Math.PI);\n      clearBody(w, e.seat.actor);\n    }\n  }\n}\n\n/** A class's raw mean as its score, whole numbers. */\nexport const rankScore = (raw: number): number => Math.round(Math.max(0, Math.min(1000, raw)));\nE\ncat > labs/game/scenes/events/ring.ts <<'E'\n/**\n * @file The Still Ring and the Morning Check. The ring is the first thing you learn: stay inside it. `ring` is the short\n * class a Round opens with, every seat on its mat. `check` is the daily test on Tare's Platform: a question (it only\n * changes the remark), then the Still Ring, Reach and One Foot, ending in a Wobble Age.\n */\nimport { breathFeet, type Order, type Skill } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, flowOf, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { balanceAll, bodyPose, clamp, footDown, inRing, leadIn, ownProp, phase, playing, sayOne, standAt, stationAt, type Activity } from './kit';\n\nconst RING = 0.22;\nconst NARROW = 0.16;\n\n/** Today's question count: the page holds their text, by day. */\nexport const QUESTIONS = 12;\n\n/** The short class: 45 s in the ring. */\nexport const RING_CLASS: Activity = {\n  id: 'ring', title: 'The Still Ring', station: 'pavilion', shot: 'mat', map: 'balance', song: 'song:stillness', multi: true,\n  setup(w, ev) {\n    arrangeClass(w, ev);\n    ev.seats.forEach((i) => (ev.s[i] = { inside: 0, steps: 0 }));\n    phase(ev, 'lead');\n    for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') resetWobble(e.wobble);\n    say(w, 'ring.intro', 'plumb');\n  },\n  step(w, ev) {\n    if (leadIn(w, ev)) return;\n    const total = 2700;\n    balanceAll(w, ev);\n    const r = ev.t > total * 0.66 ? NARROW : RING;\n    ev.d.ring = r;\n    for (const e of playing(w, ev)) {\n      const s = ev.s[e.seat.index];\n      s.steps += 1;\n      if (inRing(e, 0, 0, r)) s.inside += 1;\n      if (e.seat.kind !== 'ghost') bodyPose(w, e, 'RETREAT/Stand', 1);\n      e.seat.score = (1000 * s.inside) / Math.max(1, s.steps);\n    }\n    if (ev.t >= total) {\n      const s = ev.s[ev.seats[0]];\n      ev.score = rankScore((1000 * s.inside) / Math.max(1, s.steps));\n      ev.done = true;\n    }\n  },\n  bot: () => ({ aim: [0, 0] }),\n}; // prettier-ignore\n\nconst ASK = 480;\nconst STILL = 720;\nconst REACH = 1440;\nconst FOOT = 480;\nconst REACH_R = 0.5;\nconst TARGET_R = 0.16;\nconst TARGET_HOLD = 30;\n\ninterface CheckData { a: number; b: number; c: number; targets: number[][]; at: number; hold: number; foot: string; question: number; final: boolean; inside: number; steps: number; lift: number; intro: number }\n\nconst dataOf = (ev: EvState): CheckData => ev.d as unknown as CheckData;\n\n/** The Morning Check's score from its three parts (the plan's weights). */\nexport const checkScore = (a: number, b: number, c: number): number => 0.45 * a + 0.3 * b + 0.25 * c;\n\n/** Starts the seeded six targets. */\nfunction reachTargets(w: W): number[][] {\n  const rng = w.rng('check');\n  const order = [0, 1, 2, 3, 4, 5];\n  for (let k = 5; k > 0; k--) {\n    const j = rng.int(0, k);\n    [order[k], order[j]] = [order[j], order[k]];\n  }\n  return order.map((i) => [Math.cos((i * Math.PI) / 3) * REACH_R, Math.sin((i * Math.PI) / 3) * REACH_R]);\n}\n\nexport const CHECK: Activity = {\n  id: 'check', title: 'Morning Check', station: 'plaza', shot: 'check', map: 'balance', song: 'song:stillness',\n  setup(w, ev) {\n    const c = stationAt(w, 'plaza');\n    const [e] = playing(w, ev);\n    const flow = flowOf(w);\n    ownProp(w, ev, 'prop:platformRing', [c.x, 8.42, c.z - 6]);\n    standAt(w, e.seat.actor, c.x, c.z - 6, 0);\n    const cast = castOf(w);\n    if (cast.tare >= 0) standAt(w, cast.tare, c.x + 1.4, c.z - 4.6, -0.6);\n    resetWobble(e.wobble);\n    const question = w.rng('check').int(1, QUESTIONS);\n    Object.assign(ev.d, { a: 0, b: 0, c: 0, targets: [], at: 0, hold: 0, foot: 'l', question, final: !!ev.d.final, inside: 0, steps: 0, lift: 0, intro: flow.day === 1 ? 1 : 0 });\n    ev.s[e.seat.index] = {};\n    say(w, `check.q.${question}`, 'tare');\n    phase(ev, 'ask');\n  },\n  step(w, ev) {\n    const d = dataOf(ev);\n    const [e] = playing(w, ev);\n    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\n    if (ev.phase === 'ask') {\n      pose(1);\n      const yes = footDown(e, 'l');\n      const no = footDown(e, 'r');\n      if (yes || no || ev.t >= ASK) {\n        say(w, ev.t >= ASK ? 'check.a.none' : yes ? 'check.a.yes' : 'check.a.no', 'tare');\n        resetWobble(e.wobble);\n        phase(ev, 'still');\n        if (d.intro) say(w, 'check.intro.still', 'tare');\n      }\n      return;\n    }\n    balanceAll(w, ev);\n    pose(1);\n    if (ev.phase === 'still') {\n      d.steps += 1;\n      if (inRing(e, 0, 0, ev.t > STILL - 240 ? NARROW : RING)) d.inside += 1;\n      if (ev.t >= STILL) {\n        d.a = d.inside / d.steps;\n        d.targets = reachTargets(w);\n        [d.inside, d.steps] = [0, 0];\n        cue(w, 'stamp');\n        if (d.intro) say(w, 'check.intro.reach', 'tare');\n        phase(ev, 'reach');\n      }\n      return;\n    }\n    if (ev.phase === 'reach') {\n      const target = d.targets[d.at];\n      if (inRing(e, target[0], target[1], TARGET_R)) d.hold += 1;\n      else d.hold = 0;\n      if (d.hold >= TARGET_HOLD) {\n        d.hold = 0;\n        d.at += 1;\n        cue(w, 'ding', { n: d.at });\n      }\n      if (d.at >= d.targets.length || ev.t >= REACH) {\n        d.b = d.at >= d.targets.length ? clamp(1 - ev.t / REACH, 0, 1) : 0;\n        d.foot = w.rng('check').chance(0.5) ? 'l' : 'r';\n        e.wobble.instab = 1.6;\n        cue(w, 'stamp');\n        say(w, d.foot === 'l' ? 'check.foot.l' : 'check.foot.r', 'tare');\n        phase(ev, 'foot');\n      }\n      return;\n    }\n    if (ev.phase === 'foot') {\n      const held = d.foot === 'l' ? e.seat.input.l >= 0.5 : e.seat.input.r >= 0.5;\n      d.steps += 1;\n      if (held && inRing(e, 0, 0, 0.3)) d.inside += 1;\n      else if (!held) d.inside = Math.max(0, d.inside - 0.5);\n      bodyPose(w, e, 'RETREAT/StepUpL', held ? 1 : 0, d.foot === 'r');\n      if (ev.t >= FOOT) {\n        d.c = d.inside / d.steps;\n        ev.score = rankScore(1000 * checkScore(d.a, d.b, d.c));\n        ev.done = true;\n      }\n    }\n  },\n  bot(w, ev, e, skill) {\n    const d = dataOf(ev);\n    if (ev.phase === 'ask') return ev.t > 100 ? { l: ev.t % 2 } : {};\n    if (ev.phase === 'reach') return { aim: d.targets[d.at] as [number, number] };\n    if (ev.phase === 'foot') {\n      const down = ev.t > skill.delay ? 1 : 0;\n      return { aim: [0, 0], l: d.foot === 'l' ? down : 0, r: d.foot === 'r' ? down : 0 };\n    }\n    return { aim: [0, 0] };\n  },\n}; // prettier-ignore\n\n/** Plumb's and Tare's lines at the end, by rank, are chosen in the flow. */\nexport const breathOf = breathFeet;\nexport { sayOne };\nexport type { Order, Skill, SeatE };\nvoid gameNumber;\nE\ncat > labs/game/scenes/events/pond.ts <<'E'\n/**\n * @file Still Pond (PLAN.md section 6): the funniest thing in the game and almost no input. Composure starts at 1000; the\n * only right thing to do is breathe with the guide. Anything else is \"You moved\". Lures come from a seeded table, every\n * 6 to 10 seconds, and escalate. The page draws the lures; the sim says which is up, so replays and tests hold them.\n */\nimport type { Order, Skill } from '../bot/players';\nimport { breathFeet } from '../bot/players';\nimport { LURES } from '../data/lures';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble, stepBreath, syncShare } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { actDown, bodyPose, footDown, groundAt, leadIn, ownProp, phase, playing, standAt, stationAt, type Activity } from './kit';\nimport { setPose } from '../../cast/body';\n\nconst DEBOUNCE = 60;\n/** How long one foot alone may be down before it counts: reaching for both is not a stray foot. */\nconst STRAY = 18;\nconst STICK = 0.25;\nconst MOUSE = 0.18;\n\ninterface PondData { lure: string; lureAt: number; nextLure: number; lureT: number; frogLook: number; onKnee: boolean; gullOn: boolean; length: number }\n\nconst dataOf = (ev: EvState): PondData => ev.d as unknown as PondData;\n\n/** The score: composure scaled by breath; no input earns exactly half. */\nexport function pondScore(composure: number, sync: number): number {\n  return composure * (0.5 + 0.5 * Math.max(0, (sync - 0.2) / 0.8));\n}\n\n/** Whether a seat moved this step. */\nfunction moved(e: SeatE, s: Record<string, number>): boolean {\n  const { input } = e.seat;\n  const both = input.l >= 0.5 && input.r >= 0.5;\n  const one = (input.l >= 0.5 || input.r >= 0.5) && !both;\n  s.stray = one ? s.stray + 1 : 0;\n  return Math.hypot(input.x, input.y) > STICK || actDown(e) || s.stray > STRAY || Math.hypot(e.wobble.mx, e.wobble.my) > MOUSE;\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  if (ev.phase === 'go') {\n    say(w, 'pond.begin', 'plumb');\n    phase(ev, 'sit');\n  }\n  const d = dataOf(ev);\n  if (ev.t === d.nextLure) {\n    const entry = LURES[Math.min(d.lureAt, LURES.length - 1)];\n    d.lure = entry.id;\n    d.lureT = 0;\n    d.lureAt += 1;\n    d.nextLure = ev.t + w.rng('pond').int(360, 600);\n    cue(w, 'lure', { id: entry.id });\n    if (entry.line) say(w, entry.line, entry.who ?? 'tare');\n    if (entry.id === 'frogKnee') d.onKnee = true;\n    if (entry.id === 'gullHead') d.gullOn = true;\n  }\n  d.lureT += 1;\n  if (d.lureT > 240) d.lure = '';\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    const s = ev.s[e.seat.index];\n    stepBreath(w, e, w.tick);\n    s.cool = Math.max(0, s.cool - 1);\n    if (moved(e, s) && s.cool === 0) {\n      s.composure = Math.max(0, s.composure - gameNumber(w, 'game.pond.penalty'));\n      s.cool = DEBOUNCE;\n      s.moves += 1;\n      w.emit('moved', { seat: e.seat.index } as never);\n      if (e.seat.index === ev.seats[0]) d.frogLook = 120;\n    }\n    bodyPose(w, e, 'RETREAT/Nothing', 1, false, 0);\n    e.seat.score = pondScore(s.composure, syncShare(e.wobble));\n  }\n  d.frogLook = Math.max(0, d.frogLook - 1);\n  if (ev.t >= d.length) {\n    const [first] = playing(w, ev);\n    ev.score = rankScore(pondScore(ev.s[first.seat.index].composure, syncShare(first.wobble)));\n    say(w, 'pond.end', 'plumb');\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const feet = breathFeet(w, skill);\n  const order: Order = { stick: [0, 0], l: feet, r: feet, raw: skill.name === 'perfect' };\n  const d = dataOf(ev);\n  if (d.lure && d.lureT === 40) {\n    const chance = skill.name === 'sloppy' ? 0.3 : skill.name === 'human' ? 0.1 : 0;\n    if (w.rng('bot').chance(chance)) order.act = true;\n  }\n  return order;\n}\n\nfunction pondActivity(id: string, title: string, short: boolean): Activity {\n  return {\n    id, title, station: 'pond', shot: 'pond', map: 'balance', song: '', multi: short,\n    setup(w, ev) {\n      Object.assign(ev.d, { lure: '', lureAt: 0, nextLure: 300, lureT: 0, frogLook: 0, onKnee: false, gullOn: false, length: short ? 2700 : 4500 });\n      if (short) {\n        arrangeClass(w, ev);\n        phase(ev, 'lead');\n      } else {\n        const c = stationAt(w, 'pond');\n        const [e] = playing(w, ev);\n        const y = groundAt(w, c.x, c.z);\n        ownProp(w, ev, 'prop:jetty', [c.x, y + 0.5, c.z - 2]);\n        standAt(w, e.seat.actor, c.x, c.z, Math.PI);\n        const { frog, plumb } = castOf(w);\n        if (plumb >= 0) {\n          standAt(w, plumb, c.x - 5, c.z - 3, 0.5);\n          setPose(w, plumb, 'RETREAT/Stand', 1);\n        }\n        void frog;\n        phase(ev, 'go');\n      }\n      ev.seats.forEach((i) => (ev.s[i] = { composure: 1000, cool: 0, moves: 0, stray: 0 }));\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.off = true; }\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const POND = pondActivity('pond', 'Still Pond', false);\nexport const POND_SHORT = pondActivity('pondS', 'Still Pond', true);\nvoid footDown;\nE\ncat > labs/game/scenes/data/lures.ts <<'E'\n/**\n * @file Still Pond's lures, in order: each tempts you to press something. The page draws them. A row is an id it knows,\n * and the line said with it, if any.\n */\nexport interface Lure { readonly id: string; readonly line?: string; readonly who?: string }\n\nexport const LURES: readonly Lure[] = [\n  { id: 'pressNow' },\n  { id: 'psst', line: 'pond.lure.psst', who: 'tare' },\n  { id: 'phone', line: 'pond.lure.phone', who: 'bex' },\n  { id: 'frogKnee', line: 'pond.lure.frog', who: 'tare' },\n  { id: 'gullHead', line: 'pond.lure.gull', who: 'tare' },\n  { id: 'fakePause' },\n  { id: 'disconnect' },\n  { id: 'wrong', line: 'pond.lure.wrong', who: 'plumb' },\n  { id: 'credits' },\n  { id: 'pressNow' },\n];\nE\n","description":"Write activity kit, poses, ring, check and pond"}}}
