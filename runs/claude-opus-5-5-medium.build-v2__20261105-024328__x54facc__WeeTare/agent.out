{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjZuof5G5hGeUrfw3aRT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015zrgi5NktWbMHH4XXnBUXL","name":"Bash","input":{"command":"mkdir -p labs/game/{scenes/events,scenes/bot,scenes/data,cast/clipdata,props,bodies,builds,emitters,looks,cameras,sounds,ui/screens,ui/hud,ui/lines,ui/dev,audio,tools,materials}\nrm -f labs/game/best.ts labs/game/best.test.ts labs/game/bot.ts labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/cast/player.ts labs/game/replays/bot.replay.json\ncat > labs/game/scenes/settings.ts <<'E'\n/**\n * @file Every tunable number of Wee Tare as sim settings (`game.*`): the Wobble Model's, the breath's, and each\n * activity's. All are `when: 'now'`, so the dev panel's sliders change play at once and replays hold them. Each carries\n * its range, which the dev panel reads back through `inspector.describe('setting', path)`.\n */\nimport { defineSettings } from '../../../engine/sim-api';\n\n/** One number setting. */\nconst num = (fallback: number, minimum: number, maximum: number, description: string, unit?: string) =>\n  ({ type: 'number', default: fallback, minimum, maximum, when: 'now', description, ...(unit ? { unit } : {}) }) as const;\n\n/** Every numeric `game.*` setting, grouped by the first word after `game.` (the dev panel's groups). */\nexport const GAME_NUMBERS = {\n  'game.wobble.gain': num(14, 4, 30, 'How fast your weight follows your thumb.', '1/s2'),\n  'game.wobble.instability': num(3, 0, 10, 'How hard you fall away from the centre.', '1/s2'),\n  'game.wobble.damping': num(5, 1, 12, 'How heavy the body feels.', '1/s'),\n  'game.wobble.noise': num(3.5, 0, 8, 'Sway strength.', '1/s2'),\n  'game.wobble.noiseRate': num(0.15, 0.05, 0.4, 'Sway speed: a slow push you lean against.', 'Hz'),\n  'game.wobble.reach': num(0.9, 0.5, 1, 'Full stick’s target; a held full stick topples, on purpose.'),\n  'game.breath.period': num(8, 4, 14, 'One breath, half in, half out.', 's'),\n  'game.breath.calmEffect': num(0.5, 0, 1, 'How much full calm quiets the sway.'),\n  'game.age.k': num(1.3, 0.5, 3, 'The Wobble Age curve.'),\n  'game.pose.hold': num(12, 4, 30, 'How long a pose is held.', 's'),\n  'game.pose.ring': num(0.2, 0.08, 0.4, 'The size of a pose’s ring.'),\n  'game.reps.tempo': num(3, 1.5, 6, 'Seconds a rep.', 's'),\n  'game.step.bpm': num(1, 0.5, 1.5, 'Scales every Step Class tempo.'),\n  'game.step.perfect': num(3, 1, 8, 'The Perfect window, in steps either side.'),\n  'game.step.good': num(7, 3, 14, 'The Good window, in steps either side.'),\n  'game.pond.penalty': num(80, 10, 300, 'Composure lost each time you move.'),\n  'game.line.stepKick': num(0.35, 0, 1, 'How hard each step kicks you sideways.'),\n  'game.line.gust': num(1.2, 0, 4, 'The strength of a gust.'),\n  'game.paddle.speed': num(6, 2, 12, 'The board’s top speed.', 'm/s'),\n  'game.garden.tilt': num(12, 4, 25, 'The tray’s greatest tilt.', 'deg'),\n  'game.garden.gravity': num(9, 2, 20, 'How hard a slope pulls a marble.', 'm/s2'),\n  'game.garden.sink': num(1.6, 0.4, 4, 'A hole catches a marble below this speed.', 'm/s'),\n  'game.hoop.bandMin': num(5, 2, 8, 'Slowest spin that keeps hoops up.', 'rad/s'),\n  'game.hoop.bandMax': num(9, 7, 16, 'Fastest spin that keeps hoops up.', 'rad/s'),\n  'game.tilt.rate': num(0.03, 0, 0.2, 'How fast the island tips in the storm.', 'deg/s'),\n  'game.pebbles.mult': num(1, 0, 5, 'Multiplies the pebbles earned.'),\n} as const;\n\nexport const GAME_SETTINGS = defineSettings(GAME_NUMBERS);\n\n/** What a sim module reads a number through: settings are looked up by path. */\nexport const gameNumber = (w: { settings: { get<T>(path: string): T } }, path: keyof typeof GAME_NUMBERS): number =>\n  w.settings.get<number>(path);\nE\ncat > labs/game/scenes/types.ts <<'E'\n/**\n * @file The components of Wee Tare and their plain-data types. `flow` is the game's state machine and holds the running\n * activity's state (`ev`); `seat` is one balancing person (a player, a CPU guest or a ghost) with its input and its\n * `wobble`; `island` is the tilt. All plain data, so the sim hashes, captures and restores them.\n */\nimport { defineComponent, type ActorComponent, type World } from '../../../engine/sim-api';\n\n/** Where the game is. */\nexport type Mode = 'front' | 'roam' | 'event' | 'cutscene' | 'results' | 'evening' | 'credits' | 'round';\n\n/** A seat's balance state. */\nexport interface Wobble {\n  x: number; y: number; vx: number; vy: number;\n  /** The slewed stick. */\n  tx: number; ty: number;\n  /** The mouse's own target, decaying. */\n  mx: number; my: number;\n  /** Sway phases and rate ratios per axis. */\n  p: number[]; m: number[];\n  calm: number; lungs: number; sync: number;\n  /** A running share of how well the lungs match the guide, kept for the score. */\n  syncSum: number; syncN: number;\n  /** Steps past the edge; steps left of the recovery; how many topples so far. */\n  over: number; recover: number; topples: number;\n  /** Per-activity modifiers. */\n  instab: number; sway: number; off: boolean;\n  bx: number; by: number;\n}\n\n/** What a seat's owner does this step: a player's devices, a bot or a network ghost. */\nexport interface SeatInput { x: number; y: number; l: number; r: number; act: boolean; gentle: boolean }\n\n/** One seat. */\nexport interface Seat {\n  index: number;\n  /** 'human' reads the page's intents; 'cpu' the bot; 'ghost' a network message; 'none' is empty. */\n  kind: 'human' | 'cpu' | 'ghost' | 'none';\n  actor: number;\n  input: SeatInput;\n  /** Last step's feet, for edges. */\n  pl: number; pr: number; pact: boolean;\n  /** The bot's reading history (cob x, y) and own memory. */\n  hx: number[]; hy: number[]; bot: Record<string, number>;\n  /** Extra sway for CPU guests. */\n  extra: number;\n  /** Round score and label for a ghost. */\n  score: number; pose: string; shownClass: number; name: string; color: string;\n}\n\n/** An activity's running state. Plain data; each module adds its own fields to `ev.s` and `ev.d`. */\nexport interface EvState {\n  id: string; phase: string; t: number; total: number; done: boolean; score: number;\n  /** Short form (rounds). */\n  short: boolean; expert: boolean;\n  /** Entities this run spawned, removed at the end. */\n  owned: number[];\n  /** Per seat, activity-defined. */\n  s: Record<string, number>[];\n  /** Whole activity, activity-defined. */\n  d: Record<string, unknown>;\n  /** Text line shown now (the sim emits ids; the page says them). */\n  seats: number[];\n}\n\n/** The game's state. */\nexport interface Flow {\n  mode: Mode;\n  day: number;\n  /** Activity ids finished today. */\n  done: string[];\n  /** Bot skill driving seat 0: '' a person; 'perfect', 'human', 'sloppy', 'idle', 'random'. */\n  bot: string;\n  noTopple: boolean;\n  steadier: boolean;\n  /** Attract: the director loop runs. */\n  auto: boolean;\n  autoIndex: number; autoT: number;\n  /** Whole-game playthrough driver on. */\n  drive: boolean;\n  driveT: number;\n  ev: EvState | null;\n  /** The last result. */\n  last: { id: string; score: number; rank: string; pebbles: number; age: number };\n  ages: number[];\n  pebbles: number;\n  found: number[];\n  plaques: number[];\n  bests: Record<string, number>;\n  look: number; colour: number; headband: boolean;\n  cut: string; cutT: number;\n  /** Set on when a class list is running (Group Class). */\n  group: { list: string[]; at: number; scores: number[] } | null;\n  /** The island's whole state hits Free Play after credits. */\n  free: boolean;\n  /** Finale score pieces. */\n  tiltScore: number;\n}\n\nexport const FLOW = defineComponent('flow', {\n  description: 'The game state: mode, day, the running activity and what the player has earned.',\n  fields: {\n    mode: { type: 'string', default: 'front', description: 'Where the game is.' },\n    day: { type: 'integer', default: 1, description: 'The residency day, 1 to 5; 6 is After.' },\n    done: { type: 'array', default: [], description: 'Activities finished today.' },\n    bot: { type: 'string', default: '', description: 'The bot skill playing seat 0, or empty.' },\n    noTopple: { type: 'boolean', default: false, description: 'Dev cheat.' },\n    steadier: { type: 'boolean', default: false, description: 'The Steadier Hands assist.' },\n    auto: { type: 'boolean', default: false, description: 'Attract mode.' },\n    autoIndex: { type: 'integer', default: 0, description: 'Which attract clip.' },\n    autoT: { type: 'integer', default: 0, description: 'Steps into this attract clip.' },\n    drive: { type: 'boolean', default: false, description: 'The whole-game driver.' },\n    driveT: { type: 'integer', default: 0, description: 'Steps the driver has waited.' },\n    ev: { type: 'any', default: null, description: 'The running activity.' },\n    last: { type: 'object', default: { id: '', score: 0, rank: 'Present', pebbles: 0, age: 0 }, description: 'The last result.' },\n    ages: { type: 'array', default: [], description: 'Wobble Ages so far.' },\n    pebbles: { type: 'integer', default: 0, description: 'Pebbles earned.' },\n    found: { type: 'array', default: [], description: 'Hidden pebbles found.' },\n    plaques: { type: 'array', default: [], description: 'Plaques read.' },\n    bests: { type: 'object', default: {}, description: 'Best score per activity.' },\n    look: { type: 'integer', default: 0, description: 'Which of three guest looks.' },\n    colour: { type: 'integer', default: 0, description: 'Tracksuit colour.' },\n    headband: { type: 'boolean', default: false, description: 'The headband is on.' },\n    cut: { type: 'string', default: '', description: 'The cutscene.' },\n    cutT: { type: 'integer', default: 0, description: 'Steps into it.' },\n    group: { type: 'any', default: null, description: 'A list of classes running.' },\n    free: { type: 'boolean', default: false, description: 'Free Play is open.' },\n    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n  },\n});\n\nexport const SEAT = defineComponent('seat', {\n  description: 'One balancing person: who drives it, its body and its input.',\n  fields: {\n    index: { type: 'integer', default: 0, description: 'Which seat.' },\n    kind: { type: 'string', default: 'none', description: 'human, cpu, ghost or none.' },\n    actor: { type: 'integer', default: -1, description: 'Its body.' },\n    input: { type: 'object', default: { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false }, description: 'This step.' },\n    pl: { type: 'number', default: 0, description: 'Last left foot.' },\n    pr: { type: 'number', default: 0, description: 'Last right foot.' },\n    pact: { type: 'boolean', default: false, description: 'Last act.' },\n    hx: { type: 'array', default: [], description: 'The bot’s late reading of x.' },\n    hy: { type: 'array', default: [], description: 'The bot’s late reading of y.' },\n    bot: { type: 'object', default: {}, description: 'The bot’s memory.' },\n    extra: { type: 'number', default: 0, description: 'Extra sway.' },\n    score: { type: 'number', default: 0, description: 'A ghost’s score.' },\n    pose: { type: 'string', default: '', description: 'A ghost’s pose.' },\n    shownClass: { type: 'integer', default: -1, description: 'Which class a ghost is in.' },\n    name: { type: 'string', default: '', description: 'Its name.' },\n    color: { type: 'string', default: '', description: 'Its colour.' },\n  },\n});\n\nexport const WOBBLE = defineComponent('wobble', {\n  description: 'A seat’s centre of balance and its breath.',\n  fields: {\n    x: { type: 'number', default: 0, description: 'CoB right.' },\n    y: { type: 'number', default: 0, description: 'CoB forward.' },\n    vx: { type: 'number', default: 0, description: 'Velocity.' },\n    vy: { type: 'number', default: 0, description: 'Velocity.' },\n    tx: { type: 'number', default: 0, description: 'Slewed stick.' },\n    ty: { type: 'number', default: 0, description: 'Slewed stick.' },\n    mx: { type: 'number', default: 0, description: 'Mouse target.' },\n    my: { type: 'number', default: 0, description: 'Mouse target.' },\n    p: { type: 'array', default: [], description: 'Sway phases.' },\n    m: { type: 'array', default: [], description: 'Sway ratios.' },\n    calm: { type: 'number', default: 0, description: '0 to 1.' },\n    lungs: { type: 'number', default: 0, description: '0 to 1.' },\n    sync: { type: 'number', default: 0, description: '0 to 1.' },\n    syncSum: { type: 'number', default: 0, description: 'Sum.' },\n    syncN: { type: 'integer', default: 0, description: 'Count.' },\n    over: { type: 'integer', default: 0, description: 'Steps past the edge.' },\n    recover: { type: 'integer', default: 0, description: 'Steps of recovery left.' },\n    topples: { type: 'integer', default: 0, description: 'Topples so far.' },\n    instab: { type: 'number', default: 1, description: 'Instability scale.' },\n    sway: { type: 'number', default: 1, description: 'Sway scale.' },\n    off: { type: 'boolean', default: false, description: 'No model this activity.' },\n    bx: { type: 'number', default: 0, description: 'A steady push.' },\n    by: { type: 'number', default: 0, description: 'A steady push.' },\n  },\n});\n\nexport const ISLAND = defineComponent('island', {\n  description: 'The island’s tilt.',\n  fields: {\n    tilt: { type: 'number', default: 0.4, description: 'The story tilt, degrees.' },\n    tiltX: { type: 'number', default: 0, description: 'Finale tilt about east, degrees.' },\n    tiltZ: { type: 'number', default: 0, description: 'Finale tilt about south, degrees.' },\n    storm: { type: 'number', default: 0, description: '0 clear, 1 full storm.' },\n    finale: { type: 'integer', default: 0, description: 'The finale step, 0 when off.' },\n    seaT: { type: 'number', default: 0, description: 'The sea’s drift.' },\n  },\n});\n\n/** The scene's components, typed. */\nexport type C = {\n  flow: Flow;\n  seat: Seat;\n  wobble: Wobble;\n  island: { tilt: number; tiltX: number; tiltZ: number; storm: number; finale: number; seaT: number };\n  actor: ActorComponent;\n};\n\nexport type W = World<C>;\nexport type SeatE = { id: number; seat: Seat; wobble: Wobble };\n\nexport const flowOf = (w: W): Flow => (w.query('flow')[0] as unknown as { flow: Flow }).flow;\nexport const islandOf = (w: W): C['island'] => (w.query('island')[0] as unknown as { island: C['island'] }).island;\nexport const seatsOf = (w: W): SeatE[] => w.query('seat', 'wobble') as unknown as SeatE[];\nexport const seatOf = (w: W, i: number): SeatE => seatsOf(w).find((e) => e.seat.index === i) as SeatE;\nexport const say = (w: W, line: string, who = ''): void => void w.emit('say', { line, who } as never);\nexport const cue = (w: W, name: string, data: Record<string, unknown> = {}): void =>\n  void w.emit('cue', { name, ...data } as never);\nE\ncat > labs/game/scenes/wobble.ts <<'E'\n/**\n * @file The one verb. The Wobble Model (PLAN.md section 3): each step moves a seat's centre of balance in the unit disc\n * from its input, its instability, a slow sway and any disturbance, runs the breath, and notices a topple. Sway is\n * written with plain `Math.sin`, so the sim's math swap reaches it; phases come from the stream `sway`, per seat.\n */\nimport { gameNumber } from './settings';\nimport { cue, flowOf, type SeatE, type W, type Wobble } from './types';\n\nconst TAU = Math.PI * 2;\n/** Steps past r = 1 that make a topple; steps of the walk back to centre. */\nconst OVER = 6;\nconst RECOVER = 60;\n/** How fast the stick's target moves, units a second. */\nconst SLEW = 4;\n\n/** Fills a seat's sway from the stream `sway`, once. */\nexport function seedSway(w: W, wobble: Wobble): void {\n  const rng = w.rng('sway');\n  wobble.p = [0, 1, 2, 3, 4, 5].map(() => rng.range(0, TAU));\n  wobble.m = [0, 1, 2, 3, 4, 5].map(() => rng.range(0.8, 1.25));\n}\n\n/** The sway on one axis at step `tick` (the plan's formula). */\nfunction noise(tick: number, rate: number, wobble: Wobble, axis: number): number {\n  const t = tick / 60;\n  const { p, m } = wobble;\n  const o = axis * 3;\n  return (\n    (Math.sin(TAU * rate * m[o] * t + p[o]) +\n      0.6 * Math.sin(TAU * rate * 1.7 * m[o + 1] * t + p[o + 1]) +\n      0.3 * Math.sin(TAU * rate * 3.1 * m[o + 2] * t + p[o + 2])) /\n    1.3\n  );\n}\n\n/** The guide's lungs at step `tick`: 1 means full. Half a breath in, half out, triangle-shaped. */\nexport function guideOf(tick: number, period: number): number {\n  const steps = Math.max(1, Math.round(period * 60));\n  const at = (tick % steps) / steps;\n  return at < 0.5 ? at * 2 : 2 - at * 2;\n}\n\n/** Whether the guide is breathing in now. */\nexport const guideIn = (tick: number, period: number): boolean =>\n  tick % Math.max(1, Math.round(period * 60)) < Math.round(period * 30);\n\n/** Steps the seat's breath: holding both feet fills the lungs, letting go empties them, a match with the guide calms. */\nexport function stepBreath(w: W, e: SeatE, tick: number): void {\n  const { wobble, seat } = e;\n  const period = gameNumber(w, 'game.breath.period');\n  const both = seat.input.l >= 0.5 && seat.input.r >= 0.5;\n  const rate = 2 / (period * 60);\n  wobble.lungs = Math.max(0, Math.min(1, wobble.lungs + (both ? rate : -rate)));\n  const match = 1 - Math.min(1, Math.abs(wobble.lungs - guideOf(tick, period)) * 2.5);\n  wobble.sync += (match - wobble.sync) * 0.02;\n  wobble.syncSum += match;\n  wobble.syncN += 1;\n  wobble.calm += (Math.max(0, (wobble.sync - 0.45) / 0.45) - wobble.calm) * 0.01;\n  wobble.calm = Math.max(0, Math.min(1, wobble.calm));\n}\n\n/** Resets a seat's balance for a new activity. */\nexport function resetWobble(wobble: Wobble): void {\n  Object.assign(wobble, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, calm: 0, lungs: 0, sync: 0,\n    syncSum: 0, syncN: 0, over: 0, recover: 0, topples: 0, instab: 1, sway: 1, off: false, bx: 0, by: 0 }); // prettier-ignore\n}\n\n/** The sync so far as a share, 0 to 1. */\nexport const syncShare = (wobble: Wobble): number => (wobble.syncN ? wobble.syncSum / wobble.syncN : 0);\n\n/** One step of the Wobble Model for a seat at `tick`; emits `topple` when it goes over. */\nexport function stepWobble(w: W, e: SeatE, disturb: [number, number] = [0, 0]): void {\n  const { wobble, seat } = e;\n  const flow = flowOf(w);\n  const dt = 1 / 60;\n  const gain = gameNumber(w, 'game.wobble.gain');\n  const instability = gameNumber(w, 'game.wobble.instability') * wobble.instab;\n  const damping = gameNumber(w, 'game.wobble.damping');\n  const reach = gameNumber(w, 'game.wobble.reach');\n  const rate = gameNumber(w, 'game.wobble.noiseRate');\n  const strength = gameNumber(w, 'game.wobble.noise') * wobble.sway * (1 + seat.extra) * (flow.steadier ? 0.5 : 1);\n  const calmEffect = gameNumber(w, 'game.breath.calmEffect');\n  const ease = seat.input.gentle ? 0.4 : 1;\n  const limit = SLEW * dt;\n  wobble.tx += Math.max(-limit, Math.min(limit, seat.input.x - wobble.tx));\n  wobble.ty += Math.max(-limit, Math.min(limit, seat.input.y - wobble.ty));\n  wobble.mx *= Math.exp(-dt / 0.6);\n  wobble.my *= Math.exp(-dt / 0.6);\n  let tx = (wobble.tx + wobble.mx) * ease * reach;\n  let ty = (wobble.ty + wobble.my) * ease * reach;\n  const len = Math.hypot(tx, ty);\n  if (len > 1) [tx, ty] = [tx / len, ty / len];\n  if (wobble.recover > 0) {\n    wobble.recover -= 1;\n    const k = 1 / Math.max(1, wobble.recover + 1);\n    wobble.x -= wobble.x * k;\n    wobble.y -= wobble.y * k;\n    wobble.vx = 0;\n    wobble.vy = 0;\n    return;\n  }\n  const quiet = 1 - calmEffect * wobble.calm;\n  const axes: [number, number, number, number][] = [\n    [tx, wobble.x, wobble.bx + disturb[0], 0],\n    [ty, wobble.y, wobble.by + disturb[1], 1],\n  ];\n  for (const [target, at, push, axis] of axes) {\n    const accel = gain * (target - at) + instability * at + noise(w.tick, rate, wobble, axis) * strength * quiet + push;\n    if (axis === 0) {\n      wobble.vx = (wobble.vx + accel * dt) * Math.exp(-damping * dt);\n      wobble.x += wobble.vx * dt;\n    } else {\n      wobble.vy = (wobble.vy + accel * dt) * Math.exp(-damping * dt);\n      wobble.y += wobble.vy * dt;\n    }\n  }\n  const r = Math.hypot(wobble.x, wobble.y);\n  if (r > 1 && !flow.noTopple) {\n    wobble.over += 1;\n    if (wobble.over >= OVER) {\n      wobble.over = 0;\n      wobble.recover = RECOVER;\n      wobble.topples += 1;\n      w.emit('topple', { seat: seat.index, actor: seat.actor } as never);\n      cue(w, 'creak', { r: 1 });\n    }\n  } else wobble.over = 0;\n  if (flow.noTopple && r > 0.98) {\n    wobble.x *= 0.98 / r;\n    wobble.y *= 0.98 / r;\n  }\n}\nE\ncat > labs/game/scenes/bot/players.ts <<'E'\n/**\n * @file The four players who stand in for a human (PLAN.md section 16) and the CPU guests. Each is the same thumb: it\n * reads the CoB late, adds jitter, and steers toward an activity's aim. An activity's `bot` answers with an `Order`: what\n * it wants the CoB or the feet to do. Rhythm activities read `skill.timing` as their timing error.\n */\nimport { seatOf, type SeatE, type W } from '../types';\nimport { gameNumber } from '../settings';\n\n/** How a thumb plays. */\nexport interface Skill {\n  readonly name: string;\n  /** Reading delay, steps; proportional gain; stick jitter; timing error, steps; reaction chance scale. */\n  readonly delay: number;\n  readonly gain: number;\n  readonly jitter: number;\n  readonly timing: number;\n  readonly idle?: boolean;\n  readonly random?: boolean;\n}\n\nexport const SKILLS: Readonly<Record<string, Skill>> = {\n  perfect: { name: 'perfect', delay: 0, gain: 3, jitter: 0, timing: 0 },\n  human: { name: 'human', delay: 15, gain: 1.2, jitter: 0.04, timing: 4 },\n  sloppy: { name: 'sloppy', delay: 21, gain: 0.8, jitter: 0.06, timing: 7 },\n  idle: { name: 'idle', delay: 0, gain: 0, jitter: 0, timing: 0, idle: true },\n  random: { name: 'random', delay: 0, gain: 0, jitter: 0, timing: 0, random: true },\n  cpu: { name: 'cpu', delay: 12, gain: 1.3, jitter: 0.04, timing: 3 },\n};\n\n/** What an activity's bot wants this step. */\nexport interface Order {\n  /** Where the CoB should be: the thumb closes the loop on it. */\n  aim?: readonly [number, number];\n  /** Or the raw stick. */\n  stick?: readonly [number, number];\n  l?: number;\n  r?: number;\n  act?: boolean;\n  /** Steps-late-safe: an activity's bot asked to skip the thumb's jitter. */\n  raw?: boolean;\n}\n\n/** The stick that, without noise, settles the CoB on `aim`. */\nfunction feedForward(w: W, aim: number): number {\n  const gain = gameNumber(w, 'game.wobble.gain');\n  const inst = gameNumber(w, 'game.wobble.instability');\n  return (aim * (gain - inst)) / gain / gameNumber(w, 'game.wobble.reach');\n}\n\n/** Writes the order into the seat's input, through the thumb of `skill`. */\nexport function applyOrder(w: W, e: SeatE, skill: Skill, order: Order): void {\n  const { seat, wobble } = e;\n  seat.hx.push(wobble.x);\n  seat.hy.push(wobble.y);\n  while (seat.hx.length > skill.delay + 1) {\n    seat.hx.shift();\n    seat.hy.shift();\n  }\n  const rng = w.rng('bot');\n  if (skill.idle) {\n    Object.assign(seat.input, { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false });\n    return;\n  }\n  if (skill.random) {\n    Object.assign(seat.input, {\n      x: rng.range(-1, 1), y: rng.range(-1, 1), l: rng.chance(0.5) ? 1 : 0, r: rng.chance(0.5) ? 1 : 0,\n      act: rng.chance(0.05), gentle: rng.chance(0.1),\n    }); // prettier-ignore\n    return;\n  }\n  let x = 0;\n  let y = 0;\n  if (order.aim) {\n    const [ax, ay] = order.aim;\n    x = feedForward(w, ax) + skill.gain * (ax - seat.hx[0]);\n    y = feedForward(w, ay) + skill.gain * (ay - seat.hy[0]);\n  } else if (order.stick) [x, y] = order.stick;\n  if (!order.raw) {\n    x += rng.range(-1, 1) * skill.jitter;\n    y += rng.range(-1, 1) * skill.jitter;\n  }\n  const len = Math.hypot(x, y);\n  if (len > 1) [x, y] = [x / len, y / len];\n  Object.assign(seat.input, { x, y, l: order.l ?? 0, r: order.r ?? 0, act: order.act ?? false, gentle: false });\n}\n\n/** The lungs the guide wants: hold both feet while breathing in. Late by the thumb's timing. */\nexport function breathFeet(w: W, skill: Skill, period = gameNumber(w, 'game.breath.period')): number {\n  const steps = Math.round(period * 60);\n  return (w.tick + steps - Math.round(skill.timing)) % steps < steps / 2 ? 1 : 0;\n}\n\n/** A seat by index, for a bot. */\nexport const botSeat = seatOf;\nE\nsed -n 40,75p tools/templates/camera/camera.ts.tmpl | cut -c1-140; node -e \"\nconst j=JSON.parse(require('fs').readFileSync('data/anim/sets/mesh2motion/_set.json','utf8'));console.log(Object.keys(j),Object.keys(j.sources), JSON.stringify(j.sources.M2M_ANIMATED.rest).slice(0,200))\"; ls data/anim/sets | head; ls data/anim/sets/mesh2motion | head -5; sed -n 1,30p labs/box/clipFiles.ts | cut -c1-140; grep -n \"clips\" labs/box/library.ts | head","description":"Write settings, component types, wobble model, bot players"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9542,"cache_read_input_tokens":163943,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9542},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"a4ac9750-045a-4ca2-be3f-5ff8e09306e2","timestamp":"2026-11-05T09:47:52.901Z","request_id":"req_011CgjZuoNTvdnJFBMMu8acD","wire_tool_inputs":{"toolu_015zrgi5NktWbMHH4XXnBUXL":{"command":"mkdir -p labs/game/{scenes/events,scenes/bot,scenes/data,cast/clipdata,props,bodies,builds,emitters,looks,cameras,sounds,ui/screens,ui/hud,ui/lines,ui/dev,audio,tools,materials}\nrm -f labs/game/best.ts labs/game/best.test.ts labs/game/bot.ts labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/cast/player.ts labs/game/replays/bot.replay.json\ncat > labs/game/scenes/settings.ts <<'E'\n/**\n * @file Every tunable number of Wee Tare as sim settings (`game.*`): the Wobble Model's, the breath's, and each\n * activity's. All are `when: 'now'`, so the dev panel's sliders change play at once and replays hold them. Each carries\n * its range, which the dev panel reads back through `inspector.describe('setting', path)`.\n */\nimport { defineSettings } from '../../../engine/sim-api';\n\n/** One number setting. */\nconst num = (fallback: number, minimum: number, maximum: number, description: string, unit?: string) =>\n  ({ type: 'number', default: fallback, minimum, maximum, when: 'now', description, ...(unit ? { unit } : {}) }) as const;\n\n/** Every numeric `game.*` setting, grouped by the first word after `game.` (the dev panel's groups). */\nexport const GAME_NUMBERS = {\n  'game.wobble.gain': num(14, 4, 30, 'How fast your weight follows your thumb.', '1/s2'),\n  'game.wobble.instability': num(3, 0, 10, 'How hard you fall away from the centre.', '1/s2'),\n  'game.wobble.damping': num(5, 1, 12, 'How heavy the body feels.', '1/s'),\n  'game.wobble.noise': num(3.5, 0, 8, 'Sway strength.', '1/s2'),\n  'game.wobble.noiseRate': num(0.15, 0.05, 0.4, 'Sway speed: a slow push you lean against.', 'Hz'),\n  'game.wobble.reach': num(0.9, 0.5, 1, 'Full stick\\u2019s target; a held full stick topples, on purpose.'),\n  'game.breath.period': num(8, 4, 14, 'One breath, half in, half out.', 's'),\n  'game.breath.calmEffect': num(0.5, 0, 1, 'How much full calm quiets the sway.'),\n  'game.age.k': num(1.3, 0.5, 3, 'The Wobble Age curve.'),\n  'game.pose.hold': num(12, 4, 30, 'How long a pose is held.', 's'),\n  'game.pose.ring': num(0.2, 0.08, 0.4, 'The size of a pose\\u2019s ring.'),\n  'game.reps.tempo': num(3, 1.5, 6, 'Seconds a rep.', 's'),\n  'game.step.bpm': num(1, 0.5, 1.5, 'Scales every Step Class tempo.'),\n  'game.step.perfect': num(3, 1, 8, 'The Perfect window, in steps either side.'),\n  'game.step.good': num(7, 3, 14, 'The Good window, in steps either side.'),\n  'game.pond.penalty': num(80, 10, 300, 'Composure lost each time you move.'),\n  'game.line.stepKick': num(0.35, 0, 1, 'How hard each step kicks you sideways.'),\n  'game.line.gust': num(1.2, 0, 4, 'The strength of a gust.'),\n  'game.paddle.speed': num(6, 2, 12, 'The board\\u2019s top speed.', 'm/s'),\n  'game.garden.tilt': num(12, 4, 25, 'The tray\\u2019s greatest tilt.', 'deg'),\n  'game.garden.gravity': num(9, 2, 20, 'How hard a slope pulls a marble.', 'm/s2'),\n  'game.garden.sink': num(1.6, 0.4, 4, 'A hole catches a marble below this speed.', 'm/s'),\n  'game.hoop.bandMin': num(5, 2, 8, 'Slowest spin that keeps hoops up.', 'rad/s'),\n  'game.hoop.bandMax': num(9, 7, 16, 'Fastest spin that keeps hoops up.', 'rad/s'),\n  'game.tilt.rate': num(0.03, 0, 0.2, 'How fast the island tips in the storm.', 'deg/s'),\n  'game.pebbles.mult': num(1, 0, 5, 'Multiplies the pebbles earned.'),\n} as const;\n\nexport const GAME_SETTINGS = defineSettings(GAME_NUMBERS);\n\n/** What a sim module reads a number through: settings are looked up by path. */\nexport const gameNumber = (w: { settings: { get<T>(path: string): T } }, path: keyof typeof GAME_NUMBERS): number =>\n  w.settings.get<number>(path);\nE\ncat > labs/game/scenes/types.ts <<'E'\n/**\n * @file The components of Wee Tare and their plain-data types. `flow` is the game's state machine and holds the running\n * activity's state (`ev`); `seat` is one balancing person (a player, a CPU guest or a ghost) with its input and its\n * `wobble`; `island` is the tilt. All plain data, so the sim hashes, captures and restores them.\n */\nimport { defineComponent, type ActorComponent, type World } from '../../../engine/sim-api';\n\n/** Where the game is. */\nexport type Mode = 'front' | 'roam' | 'event' | 'cutscene' | 'results' | 'evening' | 'credits' | 'round';\n\n/** A seat's balance state. */\nexport interface Wobble {\n  x: number; y: number; vx: number; vy: number;\n  /** The slewed stick. */\n  tx: number; ty: number;\n  /** The mouse's own target, decaying. */\n  mx: number; my: number;\n  /** Sway phases and rate ratios per axis. */\n  p: number[]; m: number[];\n  calm: number; lungs: number; sync: number;\n  /** A running share of how well the lungs match the guide, kept for the score. */\n  syncSum: number; syncN: number;\n  /** Steps past the edge; steps left of the recovery; how many topples so far. */\n  over: number; recover: number; topples: number;\n  /** Per-activity modifiers. */\n  instab: number; sway: number; off: boolean;\n  bx: number; by: number;\n}\n\n/** What a seat's owner does this step: a player's devices, a bot or a network ghost. */\nexport interface SeatInput { x: number; y: number; l: number; r: number; act: boolean; gentle: boolean }\n\n/** One seat. */\nexport interface Seat {\n  index: number;\n  /** 'human' reads the page's intents; 'cpu' the bot; 'ghost' a network message; 'none' is empty. */\n  kind: 'human' | 'cpu' | 'ghost' | 'none';\n  actor: number;\n  input: SeatInput;\n  /** Last step's feet, for edges. */\n  pl: number; pr: number; pact: boolean;\n  /** The bot's reading history (cob x, y) and own memory. */\n  hx: number[]; hy: number[]; bot: Record<string, number>;\n  /** Extra sway for CPU guests. */\n  extra: number;\n  /** Round score and label for a ghost. */\n  score: number; pose: string; shownClass: number; name: string; color: string;\n}\n\n/** An activity's running state. Plain data; each module adds its own fields to `ev.s` and `ev.d`. */\nexport interface EvState {\n  id: string; phase: string; t: number; total: number; done: boolean; score: number;\n  /** Short form (rounds). */\n  short: boolean; expert: boolean;\n  /** Entities this run spawned, removed at the end. */\n  owned: number[];\n  /** Per seat, activity-defined. */\n  s: Record<string, number>[];\n  /** Whole activity, activity-defined. */\n  d: Record<string, unknown>;\n  /** Text line shown now (the sim emits ids; the page says them). */\n  seats: number[];\n}\n\n/** The game's state. */\nexport interface Flow {\n  mode: Mode;\n  day: number;\n  /** Activity ids finished today. */\n  done: string[];\n  /** Bot skill driving seat 0: '' a person; 'perfect', 'human', 'sloppy', 'idle', 'random'. */\n  bot: string;\n  noTopple: boolean;\n  steadier: boolean;\n  /** Attract: the director loop runs. */\n  auto: boolean;\n  autoIndex: number; autoT: number;\n  /** Whole-game playthrough driver on. */\n  drive: boolean;\n  driveT: number;\n  ev: EvState | null;\n  /** The last result. */\n  last: { id: string; score: number; rank: string; pebbles: number; age: number };\n  ages: number[];\n  pebbles: number;\n  found: number[];\n  plaques: number[];\n  bests: Record<string, number>;\n  look: number; colour: number; headband: boolean;\n  cut: string; cutT: number;\n  /** Set on when a class list is running (Group Class). */\n  group: { list: string[]; at: number; scores: number[] } | null;\n  /** The island's whole state hits Free Play after credits. */\n  free: boolean;\n  /** Finale score pieces. */\n  tiltScore: number;\n}\n\nexport const FLOW = defineComponent('flow', {\n  description: 'The game state: mode, day, the running activity and what the player has earned.',\n  fields: {\n    mode: { type: 'string', default: 'front', description: 'Where the game is.' },\n    day: { type: 'integer', default: 1, description: 'The residency day, 1 to 5; 6 is After.' },\n    done: { type: 'array', default: [], description: 'Activities finished today.' },\n    bot: { type: 'string', default: '', description: 'The bot skill playing seat 0, or empty.' },\n    noTopple: { type: 'boolean', default: false, description: 'Dev cheat.' },\n    steadier: { type: 'boolean', default: false, description: 'The Steadier Hands assist.' },\n    auto: { type: 'boolean', default: false, description: 'Attract mode.' },\n    autoIndex: { type: 'integer', default: 0, description: 'Which attract clip.' },\n    autoT: { type: 'integer', default: 0, description: 'Steps into this attract clip.' },\n    drive: { type: 'boolean', default: false, description: 'The whole-game driver.' },\n    driveT: { type: 'integer', default: 0, description: 'Steps the driver has waited.' },\n    ev: { type: 'any', default: null, description: 'The running activity.' },\n    last: { type: 'object', default: { id: '', score: 0, rank: 'Present', pebbles: 0, age: 0 }, description: 'The last result.' },\n    ages: { type: 'array', default: [], description: 'Wobble Ages so far.' },\n    pebbles: { type: 'integer', default: 0, description: 'Pebbles earned.' },\n    found: { type: 'array', default: [], description: 'Hidden pebbles found.' },\n    plaques: { type: 'array', default: [], description: 'Plaques read.' },\n    bests: { type: 'object', default: {}, description: 'Best score per activity.' },\n    look: { type: 'integer', default: 0, description: 'Which of three guest looks.' },\n    colour: { type: 'integer', default: 0, description: 'Tracksuit colour.' },\n    headband: { type: 'boolean', default: false, description: 'The headband is on.' },\n    cut: { type: 'string', default: '', description: 'The cutscene.' },\n    cutT: { type: 'integer', default: 0, description: 'Steps into it.' },\n    group: { type: 'any', default: null, description: 'A list of classes running.' },\n    free: { type: 'boolean', default: false, description: 'Free Play is open.' },\n    tiltScore: { type: 'number', default: 0, description: 'The finale, for its remark.' },\n  },\n});\n\nexport const SEAT = defineComponent('seat', {\n  description: 'One balancing person: who drives it, its body and its input.',\n  fields: {\n    index: { type: 'integer', default: 0, description: 'Which seat.' },\n    kind: { type: 'string', default: 'none', description: 'human, cpu, ghost or none.' },\n    actor: { type: 'integer', default: -1, description: 'Its body.' },\n    input: { type: 'object', default: { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false }, description: 'This step.' },\n    pl: { type: 'number', default: 0, description: 'Last left foot.' },\n    pr: { type: 'number', default: 0, description: 'Last right foot.' },\n    pact: { type: 'boolean', default: false, description: 'Last act.' },\n    hx: { type: 'array', default: [], description: 'The bot\\u2019s late reading of x.' },\n    hy: { type: 'array', default: [], description: 'The bot\\u2019s late reading of y.' },\n    bot: { type: 'object', default: {}, description: 'The bot\\u2019s memory.' },\n    extra: { type: 'number', default: 0, description: 'Extra sway.' },\n    score: { type: 'number', default: 0, description: 'A ghost\\u2019s score.' },\n    pose: { type: 'string', default: '', description: 'A ghost\\u2019s pose.' },\n    shownClass: { type: 'integer', default: -1, description: 'Which class a ghost is in.' },\n    name: { type: 'string', default: '', description: 'Its name.' },\n    color: { type: 'string', default: '', description: 'Its colour.' },\n  },\n});\n\nexport const WOBBLE = defineComponent('wobble', {\n  description: 'A seat\\u2019s centre of balance and its breath.',\n  fields: {\n    x: { type: 'number', default: 0, description: 'CoB right.' },\n    y: { type: 'number', default: 0, description: 'CoB forward.' },\n    vx: { type: 'number', default: 0, description: 'Velocity.' },\n    vy: { type: 'number', default: 0, description: 'Velocity.' },\n    tx: { type: 'number', default: 0, description: 'Slewed stick.' },\n    ty: { type: 'number', default: 0, description: 'Slewed stick.' },\n    mx: { type: 'number', default: 0, description: 'Mouse target.' },\n    my: { type: 'number', default: 0, description: 'Mouse target.' },\n    p: { type: 'array', default: [], description: 'Sway phases.' },\n    m: { type: 'array', default: [], description: 'Sway ratios.' },\n    calm: { type: 'number', default: 0, description: '0 to 1.' },\n    lungs: { type: 'number', default: 0, description: '0 to 1.' },\n    sync: { type: 'number', default: 0, description: '0 to 1.' },\n    syncSum: { type: 'number', default: 0, description: 'Sum.' },\n    syncN: { type: 'integer', default: 0, description: 'Count.' },\n    over: { type: 'integer', default: 0, description: 'Steps past the edge.' },\n    recover: { type: 'integer', default: 0, description: 'Steps of recovery left.' },\n    topples: { type: 'integer', default: 0, description: 'Topples so far.' },\n    instab: { type: 'number', default: 1, description: 'Instability scale.' },\n    sway: { type: 'number', default: 1, description: 'Sway scale.' },\n    off: { type: 'boolean', default: false, description: 'No model this activity.' },\n    bx: { type: 'number', default: 0, description: 'A steady push.' },\n    by: { type: 'number', default: 0, description: 'A steady push.' },\n  },\n});\n\nexport const ISLAND = defineComponent('island', {\n  description: 'The island\\u2019s tilt.',\n  fields: {\n    tilt: { type: 'number', default: 0.4, description: 'The story tilt, degrees.' },\n    tiltX: { type: 'number', default: 0, description: 'Finale tilt about east, degrees.' },\n    tiltZ: { type: 'number', default: 0, description: 'Finale tilt about south, degrees.' },\n    storm: { type: 'number', default: 0, description: '0 clear, 1 full storm.' },\n    finale: { type: 'integer', default: 0, description: 'The finale step, 0 when off.' },\n    seaT: { type: 'number', default: 0, description: 'The sea\\u2019s drift.' },\n  },\n});\n\n/** The scene's components, typed. */\nexport type C = {\n  flow: Flow;\n  seat: Seat;\n  wobble: Wobble;\n  island: { tilt: number; tiltX: number; tiltZ: number; storm: number; finale: number; seaT: number };\n  actor: ActorComponent;\n};\n\nexport type W = World<C>;\nexport type SeatE = { id: number; seat: Seat; wobble: Wobble };\n\nexport const flowOf = (w: W): Flow => (w.query('flow')[0] as unknown as { flow: Flow }).flow;\nexport const islandOf = (w: W): C['island'] => (w.query('island')[0] as unknown as { island: C['island'] }).island;\nexport const seatsOf = (w: W): SeatE[] => w.query('seat', 'wobble') as unknown as SeatE[];\nexport const seatOf = (w: W, i: number): SeatE => seatsOf(w).find((e) => e.seat.index === i) as SeatE;\nexport const say = (w: W, line: string, who = ''): void => void w.emit('say', { line, who } as never);\nexport const cue = (w: W, name: string, data: Record<string, unknown> = {}): void =>\n  void w.emit('cue', { name, ...data } as never);\nE\ncat > labs/game/scenes/wobble.ts <<'E'\n/**\n * @file The one verb. The Wobble Model (PLAN.md section 3): each step moves a seat's centre of balance in the unit disc\n * from its input, its instability, a slow sway and any disturbance, runs the breath, and notices a topple. Sway is\n * written with plain `Math.sin`, so the sim's math swap reaches it; phases come from the stream `sway`, per seat.\n */\nimport { gameNumber } from './settings';\nimport { cue, flowOf, type SeatE, type W, type Wobble } from './types';\n\nconst TAU = Math.PI * 2;\n/** Steps past r = 1 that make a topple; steps of the walk back to centre. */\nconst OVER = 6;\nconst RECOVER = 60;\n/** How fast the stick's target moves, units a second. */\nconst SLEW = 4;\n\n/** Fills a seat's sway from the stream `sway`, once. */\nexport function seedSway(w: W, wobble: Wobble): void {\n  const rng = w.rng('sway');\n  wobble.p = [0, 1, 2, 3, 4, 5].map(() => rng.range(0, TAU));\n  wobble.m = [0, 1, 2, 3, 4, 5].map(() => rng.range(0.8, 1.25));\n}\n\n/** The sway on one axis at step `tick` (the plan's formula). */\nfunction noise(tick: number, rate: number, wobble: Wobble, axis: number): number {\n  const t = tick / 60;\n  const { p, m } = wobble;\n  const o = axis * 3;\n  return (\n    (Math.sin(TAU * rate * m[o] * t + p[o]) +\n      0.6 * Math.sin(TAU * rate * 1.7 * m[o + 1] * t + p[o + 1]) +\n      0.3 * Math.sin(TAU * rate * 3.1 * m[o + 2] * t + p[o + 2])) /\n    1.3\n  );\n}\n\n/** The guide's lungs at step `tick`: 1 means full. Half a breath in, half out, triangle-shaped. */\nexport function guideOf(tick: number, period: number): number {\n  const steps = Math.max(1, Math.round(period * 60));\n  const at = (tick % steps) / steps;\n  return at < 0.5 ? at * 2 : 2 - at * 2;\n}\n\n/** Whether the guide is breathing in now. */\nexport const guideIn = (tick: number, period: number): boolean =>\n  tick % Math.max(1, Math.round(period * 60)) < Math.round(period * 30);\n\n/** Steps the seat's breath: holding both feet fills the lungs, letting go empties them, a match with the guide calms. */\nexport function stepBreath(w: W, e: SeatE, tick: number): void {\n  const { wobble, seat } = e;\n  const period = gameNumber(w, 'game.breath.period');\n  const both = seat.input.l >= 0.5 && seat.input.r >= 0.5;\n  const rate = 2 / (period * 60);\n  wobble.lungs = Math.max(0, Math.min(1, wobble.lungs + (both ? rate : -rate)));\n  const match = 1 - Math.min(1, Math.abs(wobble.lungs - guideOf(tick, period)) * 2.5);\n  wobble.sync += (match - wobble.sync) * 0.02;\n  wobble.syncSum += match;\n  wobble.syncN += 1;\n  wobble.calm += (Math.max(0, (wobble.sync - 0.45) / 0.45) - wobble.calm) * 0.01;\n  wobble.calm = Math.max(0, Math.min(1, wobble.calm));\n}\n\n/** Resets a seat's balance for a new activity. */\nexport function resetWobble(wobble: Wobble): void {\n  Object.assign(wobble, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, calm: 0, lungs: 0, sync: 0,\n    syncSum: 0, syncN: 0, over: 0, recover: 0, topples: 0, instab: 1, sway: 1, off: false, bx: 0, by: 0 }); // prettier-ignore\n}\n\n/** The sync so far as a share, 0 to 1. */\nexport const syncShare = (wobble: Wobble): number => (wobble.syncN ? wobble.syncSum / wobble.syncN : 0);\n\n/** One step of the Wobble Model for a seat at `tick`; emits `topple` when it goes over. */\nexport function stepWobble(w: W, e: SeatE, disturb: [number, number] = [0, 0]): void {\n  const { wobble, seat } = e;\n  const flow = flowOf(w);\n  const dt = 1 / 60;\n  const gain = gameNumber(w, 'game.wobble.gain');\n  const instability = gameNumber(w, 'game.wobble.instability') * wobble.instab;\n  const damping = gameNumber(w, 'game.wobble.damping');\n  const reach = gameNumber(w, 'game.wobble.reach');\n  const rate = gameNumber(w, 'game.wobble.noiseRate');\n  const strength = gameNumber(w, 'game.wobble.noise') * wobble.sway * (1 + seat.extra) * (flow.steadier ? 0.5 : 1);\n  const calmEffect = gameNumber(w, 'game.breath.calmEffect');\n  const ease = seat.input.gentle ? 0.4 : 1;\n  const limit = SLEW * dt;\n  wobble.tx += Math.max(-limit, Math.min(limit, seat.input.x - wobble.tx));\n  wobble.ty += Math.max(-limit, Math.min(limit, seat.input.y - wobble.ty));\n  wobble.mx *= Math.exp(-dt / 0.6);\n  wobble.my *= Math.exp(-dt / 0.6);\n  let tx = (wobble.tx + wobble.mx) * ease * reach;\n  let ty = (wobble.ty + wobble.my) * ease * reach;\n  const len = Math.hypot(tx, ty);\n  if (len > 1) [tx, ty] = [tx / len, ty / len];\n  if (wobble.recover > 0) {\n    wobble.recover -= 1;\n    const k = 1 / Math.max(1, wobble.recover + 1);\n    wobble.x -= wobble.x * k;\n    wobble.y -= wobble.y * k;\n    wobble.vx = 0;\n    wobble.vy = 0;\n    return;\n  }\n  const quiet = 1 - calmEffect * wobble.calm;\n  const axes: [number, number, number, number][] = [\n    [tx, wobble.x, wobble.bx + disturb[0], 0],\n    [ty, wobble.y, wobble.by + disturb[1], 1],\n  ];\n  for (const [target, at, push, axis] of axes) {\n    const accel = gain * (target - at) + instability * at + noise(w.tick, rate, wobble, axis) * strength * quiet + push;\n    if (axis === 0) {\n      wobble.vx = (wobble.vx + accel * dt) * Math.exp(-damping * dt);\n      wobble.x += wobble.vx * dt;\n    } else {\n      wobble.vy = (wobble.vy + accel * dt) * Math.exp(-damping * dt);\n      wobble.y += wobble.vy * dt;\n    }\n  }\n  const r = Math.hypot(wobble.x, wobble.y);\n  if (r > 1 && !flow.noTopple) {\n    wobble.over += 1;\n    if (wobble.over >= OVER) {\n      wobble.over = 0;\n      wobble.recover = RECOVER;\n      wobble.topples += 1;\n      w.emit('topple', { seat: seat.index, actor: seat.actor } as never);\n      cue(w, 'creak', { r: 1 });\n    }\n  } else wobble.over = 0;\n  if (flow.noTopple && r > 0.98) {\n    wobble.x *= 0.98 / r;\n    wobble.y *= 0.98 / r;\n  }\n}\nE\ncat > labs/game/scenes/bot/players.ts <<'E'\n/**\n * @file The four players who stand in for a human (PLAN.md section 16) and the CPU guests. Each is the same thumb: it\n * reads the CoB late, adds jitter, and steers toward an activity's aim. An activity's `bot` answers with an `Order`: what\n * it wants the CoB or the feet to do. Rhythm activities read `skill.timing` as their timing error.\n */\nimport { seatOf, type SeatE, type W } from '../types';\nimport { gameNumber } from '../settings';\n\n/** How a thumb plays. */\nexport interface Skill {\n  readonly name: string;\n  /** Reading delay, steps; proportional gain; stick jitter; timing error, steps; reaction chance scale. */\n  readonly delay: number;\n  readonly gain: number;\n  readonly jitter: number;\n  readonly timing: number;\n  readonly idle?: boolean;\n  readonly random?: boolean;\n}\n\nexport const SKILLS: Readonly<Record<string, Skill>> = {\n  perfect: { name: 'perfect', delay: 0, gain: 3, jitter: 0, timing: 0 },\n  human: { name: 'human', delay: 15, gain: 1.2, jitter: 0.04, timing: 4 },\n  sloppy: { name: 'sloppy', delay: 21, gain: 0.8, jitter: 0.06, timing: 7 },\n  idle: { name: 'idle', delay: 0, gain: 0, jitter: 0, timing: 0, idle: true },\n  random: { name: 'random', delay: 0, gain: 0, jitter: 0, timing: 0, random: true },\n  cpu: { name: 'cpu', delay: 12, gain: 1.3, jitter: 0.04, timing: 3 },\n};\n\n/** What an activity's bot wants this step. */\nexport interface Order {\n  /** Where the CoB should be: the thumb closes the loop on it. */\n  aim?: readonly [number, number];\n  /** Or the raw stick. */\n  stick?: readonly [number, number];\n  l?: number;\n  r?: number;\n  act?: boolean;\n  /** Steps-late-safe: an activity's bot asked to skip the thumb's jitter. */\n  raw?: boolean;\n}\n\n/** The stick that, without noise, settles the CoB on `aim`. */\nfunction feedForward(w: W, aim: number): number {\n  const gain = gameNumber(w, 'game.wobble.gain');\n  const inst = gameNumber(w, 'game.wobble.instability');\n  return (aim * (gain - inst)) / gain / gameNumber(w, 'game.wobble.reach');\n}\n\n/** Writes the order into the seat's input, through the thumb of `skill`. */\nexport function applyOrder(w: W, e: SeatE, skill: Skill, order: Order): void {\n  const { seat, wobble } = e;\n  seat.hx.push(wobble.x);\n  seat.hy.push(wobble.y);\n  while (seat.hx.length > skill.delay + 1) {\n    seat.hx.shift();\n    seat.hy.shift();\n  }\n  const rng = w.rng('bot');\n  if (skill.idle) {\n    Object.assign(seat.input, { x: 0, y: 0, l: 0, r: 0, act: false, gentle: false });\n    return;\n  }\n  if (skill.random) {\n    Object.assign(seat.input, {\n      x: rng.range(-1, 1), y: rng.range(-1, 1), l: rng.chance(0.5) ? 1 : 0, r: rng.chance(0.5) ? 1 : 0,\n      act: rng.chance(0.05), gentle: rng.chance(0.1),\n    }); // prettier-ignore\n    return;\n  }\n  let x = 0;\n  let y = 0;\n  if (order.aim) {\n    const [ax, ay] = order.aim;\n    x = feedForward(w, ax) + skill.gain * (ax - seat.hx[0]);\n    y = feedForward(w, ay) + skill.gain * (ay - seat.hy[0]);\n  } else if (order.stick) [x, y] = order.stick;\n  if (!order.raw) {\n    x += rng.range(-1, 1) * skill.jitter;\n    y += rng.range(-1, 1) * skill.jitter;\n  }\n  const len = Math.hypot(x, y);\n  if (len > 1) [x, y] = [x / len, y / len];\n  Object.assign(seat.input, { x, y, l: order.l ?? 0, r: order.r ?? 0, act: order.act ?? false, gentle: false });\n}\n\n/** The lungs the guide wants: hold both feet while breathing in. Late by the thumb's timing. */\nexport function breathFeet(w: W, skill: Skill, period = gameNumber(w, 'game.breath.period')): number {\n  const steps = Math.round(period * 60);\n  return (w.tick + steps - Math.round(skill.timing)) % steps < steps / 2 ? 1 : 0;\n}\n\n/** A seat by index, for a bot. */\nexport const botSeat = seatOf;\nE\nsed -n 40,75p tools/templates/camera/camera.ts.tmpl | cut -c1-140; node -e \"\nconst j=JSON.parse(require('fs').readFileSync('data/anim/sets/mesh2motion/_set.json','utf8'));console.log(Object.keys(j),Object.keys(j.sources), JSON.stringify(j.sources.M2M_ANIMATED.rest).slice(0,200))\"; ls data/anim/sets | head; ls data/anim/sets/mesh2motion | head -5; sed -n 1,30p labs/box/clipFiles.ts | cut -c1-140; grep -n \"clips\" labs/box/library.ts | head","description":"Write settings, component types, wobble model, bot players"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015zrgi5NktWbMHH4XXnBUXL","type":"tool_result","content":"interface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n[\n  'set',    'title',\n  'format', 'credit',\n  'fps',    'sources',\n  'body',   'fit'\n] [ 'M2M_QUATERNIUS', 'M2M_ANIMATED', 'M2M_MOCOPI' ] {\"H0\":916.7,\"hipZ\":932.1,\"ankleZ\":97.96,\"Pr\":[[1,0,0],[0,1,0],[0,0,1]],\"Cr\":[[0.97616,0,0.21704],[0,1,0],[-0.21704,0,0.97616]],\"Hr\":[[0.99625,0,-0.08657],[0,1,0],[0.08657,0,0.99625]],\"hip\":{\"L\":[51.5,\ncmu\nmesh2motion\nquaternius\nstyle100\nstyle100_back\nstyle100_backrun\nstyle100_idle\nstyle100_run\nstyle100_side\nstyle100_siderun\nAngry.json\nAttack_Ground_Pound.json\nBackflip.json\nBow.json\nBow_Pull_Back.json\n/**\n * @file The animation library's files (`data/anim/sets/<set>/*.json`) as text, in one chunk: the pages that register\n * the whole library (the box's clip mode, labs/box/main.ts; the Animation Lab with a library clip, labs/anim/; the\n * Library Lab, labs/library/) import this module when they need it (`await import(…)`), so a visit fetches one file\n * instead of one a clip (1,270 of them on 2026-10-27, each a request Vercel counts; ADR-0023 amendment 4). The bytes\n * are the same text, and compress better together. `CLIP_FILES` is what `loadLibrary` (labs/box/library.ts) takes:\n * each path with its text, handed over at once.\n *\n * Invariants: the module only reads the files Vite bundles into it; nothing else imports it statically, so a page\n * that never needs the library never fetches it.\n *\n * Game code, a page's: it imports nothing.\n *\n * @example\n * // browser (Vite reads the files: `import.meta.glob`)\n * const [path, read] = Object.entries(CLIP_FILES)[0]; // ['../../data/anim/sets/<set>/<file>.json', …]\n * typeof JSON.parse(await read()); // 'object': the file, as loadLibrary reads it\n * // labs/box/main.ts, clip mode: await loadLibrary((await import('./clipFiles')).CLIP_FILES);\n */\n/// <reference types=\"vite/client\" />\n\n/** Every clip set's files, by path (`../../data/anim/sets/<set>/<file>.json`), as their text. */\nconst TEXT = import.meta.glob<string>('../../data/anim/sets/*/*.json', { query: '?raw', import: 'default', eager: true }); // prettier-ignor\n\n/** The library's files as `loadLibrary` takes them: each path, and its text. */\nexport const CLIP_FILES: Readonly<Record<string, () => Promise<string>>> = Object.fromEntries(\n  Object.entries(TEXT).map(([path, text]) => [path, () => Promise.resolve(text)]),\n);\n5: * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\n7: * (labs/box/scenes/clips.ts) plays and draws. The page calls it before it opens clip mode; no other scene loads it.\n19: * // await loadLibrary((await import('./clipFiles')).CLIP_FILES); // __engine.describe('clipset').ids: ['clipset:cmu', …]\n34:  defineMannequin(getClipSet('clipset:quaternius'));\n45: * (`clipset:cmu`), and returns the clip's path to play (`lab1/<name>`). Throws what `parseClip` throws for bad text.\n48:  defineClipSet({ set, sources: getClipSet(from).sources, clips: { [name]: parseClip(text, name) } });","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"e02610f1-0db2-4b7a-af6e-fe193c68ab2a","timestamp":"2026-11-05T09:47:53.179Z","tool_use_result":{"stdout":"interface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camer