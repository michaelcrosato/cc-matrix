{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgja84Li6m5DcQHLnhKbf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RmvnCYTiHgdq9Vf4hNyY58","name":"Bash","input":{"command":"cat > labs/game/tools/copy-clips.mjs <<'E'\n/**\n * @file Copies the library clips Wee Tare plays into labs/game/cast/clipdata/library.json, with their sources' rest\n * bodies, so sim-side code can import them statically. Run once from the dev folder: node labs/game/tools/copy-clips.mjs\n */\nimport { readFileSync, writeFileSync } from 'node:fs';\n\nconst WANT = {\n  mesh2motion: ['Meditate', 'Pushup', 'Cheering_Two_Hands', 'Victory', 'Greeting'],\n  quaternius: ['Jog_Fwd_Loop', 'Dance_Loop', 'Sitting_Idle_Loop'],\n  style100_idle: ['Balance_Idle'],\n  style100: ['Balance_Walk'],\n  cmu: ['Wave_Hello', 'Stretch_Yawn', 'Jumping_Jacks_Loop'],\n};\nconst sources = {};\nconst clips = {};\nfor (const [set, names] of Object.entries(WANT)) {\n  const meta = JSON.parse(readFileSync(`data/anim/sets/${set}/_set.json`, 'utf8'));\n  for (const name of names) {\n    const clip = JSON.parse(readFileSync(`data/anim/sets/${set}/${name}.json`, 'utf8'));\n    delete clip.clip;\n    sources[clip.src] = meta.sources[clip.src];\n    clips[name] = clip;\n  }\n}\nwriteFileSync('labs/game/cast/clipdata/library.json', JSON.stringify({ sources, clips }));\nE\nnode labs/game/tools/copy-clips.mjs && ls -la labs/game/cast/clipdata/\nnode -e \"\nconst j=JSON.parse(require('fs').readFileSync('data/anim/sets/mesh2motion/_set.json','utf8'));\nrequire('fs').writeFileSync('labs/game/cast/rest.json',JSON.stringify(j.sources.M2M_ANIMATED.rest));\"\ncat > labs/game/cast/clips.ts <<'E'\n/**\n * @file The Retreat clip set: every pose of Wee Tare as a two-key strip (`t = 0` stands, `t = 1` is the pose), scrubbed by\n * the sim, so the body goes into a pose exactly as far as your thumb does. Plus additive leans and a few short cycles,\n * all written by hand in the library's readable key format (LEGEND in engine/anim/clip/lens.ts). `LIBRARY` holds the\n * clips copied from the engine's library with their sources (tools/copy-clips.mjs).\n */\nimport { defineClipSet } from '../../../engine/sim-api';\nimport rest from './rest.json' with { type: 'json' };\nimport library from './clipdata/library.json' with { type: 'json' };\n\ntype Keys = Record<string, number[]>;\n\nconst STAND: Keys = {\n  hips: [0, 0, 100], body: [0, 0, 0], chest: [0, 0, 0], head: [0, 0, 0], shL: [0, 0], shR: [0, 0],\n  armL: [0, 20, -100, 8, 0], armR: [0, 20, -100, 8, 0], legL: [0, 6, -100, 4, 0], legR: [0, 6, -100, 4, 0], footL: [0, 6, 0], footR: [0, 6, 0],\n}; // prettier-ignore\n\nconst key = (t: number, over: Keys) => ({ t, ...STAND, ...over });\n/** A two-key strip: stands at 0, the pose at 1. */\nconst strip = (over: Keys) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(1, over)] });\n/** A strip that passes through `mid` halfway. */\nconst strip3 = (mid: Keys, over: Keys) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(0.5, mid), key(1, over)] });\n/** Keys evenly spread over `dur`, looping. */\nconst ring = (dur: number, poses: Keys[]) => ({\n  src: 'RETREAT', dur, loop: true,\n  keys: [...poses, poses[0]].map((over, i) => key((i / poses.length) * dur, over)),\n}); // prettier-ignore\n\nconst CHAIR: Keys = { hips: [-14, 0, 62], body: [0, 22, 0], legL: [50, 6, -62, 74, 0], legR: [50, 6, -62, 74, 0], armL: [86, 8, 4, 6, 0], armR: [86, 8, 4, 6, 0] }; // prettier-ignore\n\nconst POSES = {\n  Heron: strip({ hips: [0, 0, 99], legL: [0, 2, -100, 2, 0], legR: [28, 62, -42, 118, 40], footR: [30, 20, 0], armL: [6, 4, 100, 30, 0], armR: [6, 4, 100, 30, 0] }),\n  Archer: strip({ hips: [0, 0, 72], legL: [62, 12, -78, 62, 0], legR: [-70, 10, -72, 4, 0], footR: [10, 40, 0], armL: [0, 100, 4, 2, 0], armR: [0, 100, 4, 2, 0] }),\n  Nothing: strip({ hips: [-5, 0, 28], legL: [70, 60, -18, 140, 40], legR: [70, 60, -22, 140, -40], footL: [-20, 60, 0], footR: [-20, 60, 0], armL: [70, 22, -60, 58, 20], armR: [70, 22, -60, 58, -20] }),\n  Chair: strip(CHAIR),\n  CommaR: strip({ body: [0, 0, 22], chest: [0, 0, 14], hips: [0, -6, 98], armL: [0, 60, 90, 18, 0], armR: [0, 30, -80, 20, 0] }),\n  CommaL: strip({ body: [0, 0, -22], chest: [0, 0, -14], hips: [0, 6, 98], armR: [0, 60, 90, 18, 0], armL: [0, 30, -80, 20, 0] }),\n  Napkin: strip({ hips: [-8, 0, 94], body: [0, 78, 0], chest: [0, 18, 0], head: [0, 10, 0], armL: [80, 4, -60, 6, 0], armR: [80, 4, -60, 6, 0] }),\n  Bridge: strip3(\n    { hips: [-20, 0, 22], body: [0, -80, 0], legL: [70, 8, 20, 120, 0], legR: [70, 8, 20, 120, 0], armL: [-40, 12, -40, 4, 0], armR: [-40, 12, -40, 4, 0] },\n    { hips: [-20, 0, 58], body: [0, -80, 0], legL: [70, 8, -30, 86, 0], legR: [70, 8, -30, 86, 0], armL: [-40, 12, -60, 4, 0], armR: [-40, 12, -60, 4, 0] },\n  ),\n  Lighthouse: strip({ hips: [0, 0, 106], armL: [4, 2, 100, 2, 0], armR: [4, 2, 100, 2, 0], footL: [-30, 2, 0], footR: [-30, 2, 0], legL: [0, 2, -100, 0, 0], legR: [0, 2, -100, 0, 0] }),\n  LeanR: strip({ body: [0, 0, 8], chest: [0, 0, 4], hips: [0, 5, 99], armL: [0, 40, -70, 8, 0] }),\n  LeanL: strip({ body: [0, 0, -8], chest: [0, 0, -4], hips: [0, -5, 99], armR: [0, 40, -70, 8, 0] }),\n  LeanF: strip({ body: [0, 9, 0], chest: [0, 3, 0], hips: [4, 0, 99], armL: [24, 20, -90, 10, 0], armR: [24, 20, -90, 10, 0] }),\n  LeanB: strip({ body: [0, -8, 0], chest: [0, -3, 0], hips: [-4, 0, 99], armL: [-24, 20, -90, 10, 0], armR: [-24, 20, -90, 10, 0] }),\n  DeepKnee: strip(CHAIR),\n  SideLunge: strip({ hips: [0, 34, 66], legL: [0, 46, -72, 6, 0], legR: [40, 12, -70, 78, 0], body: [0, 12, 8], armL: [60, 20, -30, 40, 0], armR: [60, 20, -30, 40, 0] }),\n  StepUpL: strip({ hips: [0, -5, 105], legL: [60, 6, -40, 84, 0], armR: [30, 18, -80, 40, 0], armL: [-20, 18, -90, 20, 0] }),\n  StepUpR: strip({ hips: [0, 5, 105], legR: [60, 6, -40, 84, 0], armL: [30, 18, -80, 40, 0], armR: [-20, 18, -90, 20, 0] }),\n  SideStep: strip({ hips: [0, 22, 96], legL: [0, 30, -94, 4, 0], legR: [0, 2, -100, 6, 0], armL: [0, 64, -20, 10, 0], armR: [0, 64, -20, 10, 0] }),\n  Jump: strip({ hips: [0, 0, 124], legL: [24, 12, -78, 44, 0], legR: [24, 12, -78, 44, 0], armL: [20, 30, 90, 10, 0], armR: [20, 30, 90, 10, 0] }),\n  LineWalkL: strip({ hips: [0, -3, 100], legL: [34, 2, -84, 30, 0], legR: [-18, 2, -96, 6, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0], footL: [0, 0, 0] }),\n  LineWalkR: strip({ hips: [0, 3, 100], legR: [34, 2, -84, 30, 0], legL: [-18, 2, -96, 6, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0], footR: [0, 0, 0] }),\n  LineStand: strip({ hips: [0, 0, 96], legL: [0, 4, -100, 8, 0], legR: [0, 4, -100, 8, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0] }),\n  BoardStand: strip({ hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], armL: [30, 24, -40, 40, 0], armR: [30, 24, -40, 40, 0], body: [0, 8, 0] }),\n  Paddling: ring(1, [\n    { hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], body: [18, 16, 0], armL: [70, 10, -10, 20, 0], armR: [30, 20, 10, 80, 0] },\n    { hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], body: [-18, 16, 0], armR: [70, 10, -10, 20, 0], armL: [30, 20, 10, 80, 0] },\n  ]),\n  HipCircle: ring(1, [\n    { hips: [12, 0, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0] },\n    { hips: [0, 12, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0], body: [0, 0, -6] },\n    { hips: [-12, 0, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0] },\n    { hips: [0, -12, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0], body: [0, 0, 6] },\n  ]),\n  Somersault: {\n    src: 'RETREAT', dur: 1, loop: false,\n    keys: [0, 1, 2, 3, 4].map((i) => key(i / 4, { body: [0, i * 180, 0], hips: [0, 0, 92], legL: [70, 8, -10, 120, 0], legR: [70, 8, -10, 120, 0], armL: [60, 10, -30, 80, 0], armR: [60, 10, -30, 80, 0] })),\n  },\n  Twist: {\n    src: 'RETREAT', dur: 1, loop: false,\n    keys: [0, 1, 2, 3, 4].map((i) => key(i / 4, { body: [i * 90, 0, 0], armL: [0, 14, 96, 2, 0], armR: [0, 14, 96, 2, 0], legL: [0, 2, -100, 0, 0], legR: [0, 2, -100, 0, 0] })),\n  },\n  DiveReady: strip({ hips: [0, 0, 94], body: [0, 8, 0], armL: [0, 12, 96, 2, 0], armR: [0, 12, 96, 2, 0], footL: [-16, 2, 0], footR: [-16, 2, 0] }),\n  CalmCall: strip({ hips: [0, 0, 92], armL: [50, 26, -30, 20, 0], armR: [50, 26, -30, 20, 0], body: [0, 6, 0] }),\n  Crank: ring(1, [\n    { hips: [0, 0, 84], body: [0, 22, 0], armL: [70, 6, -10, 30, 0], armR: [50, 6, 10, 60, 0], legL: [30, 8, -80, 40, 0], legR: [-20, 8, -92, 10, 0] },\n    { hips: [0, 0, 84], body: [0, 22, 0], armR: [70, 6, -10, 30, 0], armL: [50, 6, 10, 60, 0], legR: [30, 8, -80, 40, 0], legL: [-20, 8, -92, 10, 0] },\n  ]),\n  Stumble: strip({ hips: [-8, 8, 88], body: [10, -8, 16], armL: [20, 80, 30, 30, 0], armR: [-10, 90, 40, 30, 0], legR: [26, 22, -78, 30, 0] }),\n  Fall: strip({ hips: [0, 0, 30], body: [0, -60, 0], armL: [20, 70, 40, 10, 0], armR: [20, 70, 40, 10, 0], legL: [60, 20, -10, 30, 0], legR: [40, 20, -20, 30, 0] }),\n  Bow: strip({ hips: [-2, 0, 98], body: [0, 42, 0], head: [0, 16, 0] }),\n  Nod: strip({ head: [0, 22, 0], body: [0, 4, 0] }),\n  Stand: strip({}),\n}; // prettier-ignore\n\n/** The hand-written set. */\nexport const RETREAT = defineClipSet({\n  set: 'RETREAT', title: 'Retreat poses', format: 2, fps: 30, credit: 'Original',\n  sources: { RETREAT: { file: 'none', rig: 'unreal', label: 'Original', origin: 'Written by hand', license: 'CC0', url: '', rest } },\n  clips: POSES,\n} as never); // prettier-ignore\n\n/** The clips copied from the engine's library, with their sources. */\nexport const RETREATLIB = defineClipSet({\n  set: 'RETREATLIB', title: 'Library clips', format: 2, fps: 30, credit: 'See About',\n  sources: library.sources, clips: library.clips,\n} as never); // prettier-ignore\n\n/** Every actor's clip sets. */\nexport const CLIP_SETS = ['clipset:retreat', 'clipset:retreatlib'] as const;\nE\ncat > labs/game/cast/body.ts <<'E'\n/**\n * @file Drives an actor's clip layer directly: one full-body clip (a scrubbed strip or a loop) and, on top, the four\n * additive leans, written as plain slots, so the sim scrubs them each step. `seekClip` only reaches the top clip, so it\n * could not do two axes; the layer's own `play` removes what a full-body clip covers, so the leans always sit above it.\n */\nimport type { World } from '../../../engine/sim-api';\n\ninterface Slot {\n  clip: string; t: number; w: number; rate: number; stopping: number; loco: boolean;\n  play: Record<string, unknown>;\n}\ntype ClipEntity = { clips?: { state: { slots: Slot[] } } };\n\nconst LEANS = ['RETREAT/LeanR', 'RETREAT/LeanL', 'RETREAT/LeanF', 'RETREAT/LeanB'];\n\nconst slotsOf = (w: World<never> | World, id: number): Slot[] | null =>\n  ((w as World).get(id) as unknown as ClipEntity | undefined)?.clips?.state.slots ?? null;\n\nconst leanSlot = (clip: string): Slot => ({\n  clip, t: 0, w: 1, rate: 0, stopping: 0, loco: false,\n  play: { speed: 0, hold: true, walk: true, loop: false, additive: true, fade: 0 },\n}); // prettier-ignore\n\n/** Scrubs the leans to the CoB: `x` right, `y` forward, each −1 to 1. */\nexport function setLean(w: object, id: number, x: number, y: number): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  if (!slots.some((s) => s.clip === LEANS[0])) slots.push(...LEANS.map(leanSlot));\n  for (const slot of slots) {\n    if (slot.clip === LEANS[0]) slot.t = Math.max(0, Math.min(1, x));\n    else if (slot.clip === LEANS[1]) slot.t = Math.max(0, Math.min(1, -x));\n    else if (slot.clip === LEANS[2]) slot.t = Math.max(0, Math.min(1, y));\n    else if (slot.clip === LEANS[3]) slot.t = Math.max(0, Math.min(1, -y));\n  }\n}\n\n/** The clip now under the leans, or null. */\nfunction baseOf(slots: Slot[]): Slot | null {\n  for (let k = slots.length - 1; k >= 0; k--) {\n    if (!slots[k].play.additive && !slots[k].stopping) return slots[k];\n  }\n  return null;\n}\n\n/** Puts `clip` under the leans, or finds it there. Fades from what was there. */\nfunction ensure(slots: Slot[], clip: string, play: Record<string, unknown>): Slot {\n  const base = baseOf(slots);\n  if (base?.clip === clip && !!base.play.mirror === !!play.mirror) return base;\n  if (base) base.stopping = 0.2;\n  const slot: Slot = { clip, t: 0, w: 0, rate: 0, stopping: 0, loco: false, play };\n  const at = slots.findIndex((s) => s.play.additive);\n  if (at < 0) slots.push(slot);\n  else slots.splice(at, 0, slot);\n  return slot;\n}\n\n/** Scrubs a strip: `clip` as `RETREAT/Heron`, `t` from 0 stood to 1 in the pose. */\nexport function setPose(w: object, id: number, clip: string, t: number, mirror = false): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  const slot = ensure(slots, clip, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.2, mirror });\n  slot.t = t;\n}\n\n/** Plays a loop under the leans at `speed`; the same call again changes nothing but the speed. */\nexport function setLoop(w: object, id: number, clip: string, speed = 1): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  ensure(slots, clip, { speed, walk: true, loop: true, fade: 0.25, out: 0.25 }).play.speed = speed;\n}\n\n/** Plays a clip once and holds its end. */\nexport function setOnce(w: object, id: number, clip: string): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  ensure(slots, clip, { speed: 1, walk: true, loop: false, hold: true, fade: 0.2, out: 0.25 });\n}\n\n/** Lets the body's own animation back: the base clip fades, the leans go to zero. */\nexport function clearBody(w: object, id: number): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  for (const slot of slots) {\n    if (!slot.play.additive) slot.stopping = slot.stopping || 0.25;\n    else slot.t = 0;\n  }\n}\nE\ncat > labs/game/cast/people.ts <<'E'\n/**\n * @file Who is who: the characters' numbers, bodies and builds as data, and `spawnPerson`, which stands one in a scene as\n * an actor the pilot drives (`player: false`). Gull and Frog are blob crowd bodies, spawned in critters.ts.\n */\nimport { createCharacter, spawnActor, type Character } from '../../../engine/sim-api';\nimport { CLIP_SETS } from './clips';\n\nexport interface Person {\n  readonly body: string;\n  readonly build: string;\n  readonly speed: number;\n  readonly secondary?: Readonly<Record<string, unknown>>;\n}\n\nexport const PEOPLE: Readonly<Record<string, Person>> = {\n  plumb: { body: 'body:plumb', build: 'build:plumb', speed: 2.4, secondary: { hair: 'ponytail' } },\n  tare: { body: 'body:tare', build: 'build:tare', speed: 5 },\n  gerald: { body: 'body:gerald', build: 'build:gerald', speed: 4.6 },\n  bex: { body: 'body:bex', build: 'build:bex', speed: 4 },\n  nan: { body: 'body:nan', build: 'build:nan', speed: 2 },\n  extra0: { body: 'body:extra0', build: 'build:chibi', speed: 3 },\n  extra1: { body: 'body:extra1', build: 'build:chibi', speed: 3 },\n  extra2: { body: 'body:extra2', build: 'build:chibi', speed: 3 },\n};\n\nexport const GUEST_SPEED = 5.4;\nexport const GUEST_JUMP = 7.5;\n\n/** Guest bodies by look and colour: `body:guest<look>c<colour>`; hub seats use `body:seat<i>`. */\nexport const GUEST_BUILDS = ['build:chibi', 'build:guestTall', 'build:guestRound'] as const;\nexport const guestBody = (look: number, colour: number): string => `body:guest${look}c${colour}`;\n\n/** A character at `speed` m/s. */\nexport const characterAt = (speed: number): Character => createCharacter({ speed, jumpSpeed: GUEST_JUMP });\n\n/** Stands a person at `at`, facing `yaw`. Keep every character at `player: false`: the pilot writes their intents. */\nexport function spawnPerson(w: object, spec: { at: [number, number, number]; body: string; build: string; speed: number; yaw?: number; secondary?: Readonly<Record<string, unknown>> }): number {\n  return spawnActor(w as never, {\n    at: spec.at,\n    character: characterAt(spec.speed),\n    player: false,\n    yaw: spec.yaw ?? 0,\n    anim: { build: spec.build, weapon: 'none' },\n    body: spec.body,\n    clips: { sets: [...CLIP_SETS] },\n    components: spec.secondary ? { secondary: spec.secondary } : {},\n  });\n}\nE\ncat > labs/game/scenes/data/stations.ts <<'E'\n/**\n * @file The island's places as data (PLAN.md section 2), metres, x east, z south. Heights come from the terrain at run\n * time. `MATS` are the four mats of the Pavilion, seat by seat, relative to its centre.\n */\nexport interface Station { readonly x: number; readonly z: number; readonly yaw: number; readonly title: string }\n\nexport const STATIONS = {\n  pier: { x: 0, z: 100, yaw: Math.PI, title: 'Ferry Pier' },\n  plaza: { x: 0, z: 34, yaw: 0, title: 'The Plaza' },\n  pavilion: { x: -52, z: 18, yaw: 0, title: 'Pose Pavilion' },\n  pond: { x: -70, z: -12, yaw: 0, title: 'Still Pond' },\n  annex: { x: 52, z: 22, yaw: 0, title: 'The Annex' },\n  huts: { x: 64, z: 52, yaw: 0, title: 'Guest Huts' },\n  lagoon: { x: -60, z: 85, yaw: 0, title: 'South-West Lagoon' },\n  terrace: { x: 30, z: -48, yaw: 0, title: 'Sand Terrace' },\n  cliff: { x: 0, z: -88, yaw: Math.PI, title: 'North Cliff' },\n  hoopBeach: { x: 62, z: 84, yaw: 0, title: 'Hoop Beach' },\n  lighthouse: { x: 84, z: -60, yaw: 0, title: 'Lighthouse' },\n  east: { x: 74, z: 8, yaw: 0, title: 'East Terrace' },\n  stone: { x: 0, z: 0, yaw: 0, title: 'Centre Stone' },\n} as const satisfies Record<string, Station>;\n\nexport type StationId = keyof typeof STATIONS;\n\n/** The four mats, seat by seat: x and z from the Pavilion's centre. Seat 0 is the front right; Plumb stands north of them. */\nexport const MATS: readonly (readonly [number, number])[] = [\n  [-1.9, 1.2],\n  [1.9, 1.2],\n  [-5.2, 3.6],\n  [5.2, 3.6],\n];\n\n/** Where the instructor stands, from the Pavilion's centre. */\nexport const FRONT_MAT: readonly [number, number] = [0, -5];\nE\ngit -C . rev-parse --show-toplevel | tail -1; grep -n \"createNoise\\|reactTo\" engine/sim-api.ts | head -3; sed -n 1,25p tools/templates/body/body.ts.tmpl | grep -n \"parts\\|mirror\" | head; grep -rn \"'ball'\\|'box'\\|'limb'\\|'eye'\\|'cyl\\|'disc\" engine/gfx/puppets/compile.ts | head -12 | cut -c1-140; node x describe body 2>&1 | head -14 | cut -c1-200; grep -n \"defineBody\\|ponytail\\|hair\" engine/sim/reactions.ts | head -8 | cut -c1-160","description":"Write clip set, body driver, people, stations"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8991,"cache_read_input_tokens":186811,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8991},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"7bb197a0-0fbe-445d-93ca-d8a7f882d7ae","timestamp":"2026-11-05T09:50:26.591Z","request_id":"req_011Cgja8427YU5PebgNL5KEM","wire_tool_inputs":{"toolu_01RmvnCYTiHgdq9Vf4hNyY58":{"command":"cat > labs/game/tools/copy-clips.mjs <<'E'\n/**\n * @file Copies the library clips Wee Tare plays into labs/game/cast/clipdata/library.json, with their sources' rest\n * bodies, so sim-side code can import them statically. Run once from the dev folder: node labs/game/tools/copy-clips.mjs\n */\nimport { readFileSync, writeFileSync } from 'node:fs';\n\nconst WANT = {\n  mesh2motion: ['Meditate', 'Pushup', 'Cheering_Two_Hands', 'Victory', 'Greeting'],\n  quaternius: ['Jog_Fwd_Loop', 'Dance_Loop', 'Sitting_Idle_Loop'],\n  style100_idle: ['Balance_Idle'],\n  style100: ['Balance_Walk'],\n  cmu: ['Wave_Hello', 'Stretch_Yawn', 'Jumping_Jacks_Loop'],\n};\nconst sources = {};\nconst clips = {};\nfor (const [set, names] of Object.entries(WANT)) {\n  const meta = JSON.parse(readFileSync(`data/anim/sets/${set}/_set.json`, 'utf8'));\n  for (const name of names) {\n    const clip = JSON.parse(readFileSync(`data/anim/sets/${set}/${name}.json`, 'utf8'));\n    delete clip.clip;\n    sources[clip.src] = meta.sources[clip.src];\n    clips[name] = clip;\n  }\n}\nwriteFileSync('labs/game/cast/clipdata/library.json', JSON.stringify({ sources, clips }));\nE\nnode labs/game/tools/copy-clips.mjs && ls -la labs/game/cast/clipdata/\nnode -e \"\nconst j=JSON.parse(require('fs').readFileSync('data/anim/sets/mesh2motion/_set.json','utf8'));\nrequire('fs').writeFileSync('labs/game/cast/rest.json',JSON.stringify(j.sources.M2M_ANIMATED.rest));\"\ncat > labs/game/cast/clips.ts <<'E'\n/**\n * @file The Retreat clip set: every pose of Wee Tare as a two-key strip (`t = 0` stands, `t = 1` is the pose), scrubbed by\n * the sim, so the body goes into a pose exactly as far as your thumb does. Plus additive leans and a few short cycles,\n * all written by hand in the library's readable key format (LEGEND in engine/anim/clip/lens.ts). `LIBRARY` holds the\n * clips copied from the engine's library with their sources (tools/copy-clips.mjs).\n */\nimport { defineClipSet } from '../../../engine/sim-api';\nimport rest from './rest.json' with { type: 'json' };\nimport library from './clipdata/library.json' with { type: 'json' };\n\ntype Keys = Record<string, number[]>;\n\nconst STAND: Keys = {\n  hips: [0, 0, 100], body: [0, 0, 0], chest: [0, 0, 0], head: [0, 0, 0], shL: [0, 0], shR: [0, 0],\n  armL: [0, 20, -100, 8, 0], armR: [0, 20, -100, 8, 0], legL: [0, 6, -100, 4, 0], legR: [0, 6, -100, 4, 0], footL: [0, 6, 0], footR: [0, 6, 0],\n}; // prettier-ignore\n\nconst key = (t: number, over: Keys) => ({ t, ...STAND, ...over });\n/** A two-key strip: stands at 0, the pose at 1. */\nconst strip = (over: Keys) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(1, over)] });\n/** A strip that passes through `mid` halfway. */\nconst strip3 = (mid: Keys, over: Keys) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(0.5, mid), key(1, over)] });\n/** Keys evenly spread over `dur`, looping. */\nconst ring = (dur: number, poses: Keys[]) => ({\n  src: 'RETREAT', dur, loop: true,\n  keys: [...poses, poses[0]].map((over, i) => key((i / poses.length) * dur, over)),\n}); // prettier-ignore\n\nconst CHAIR: Keys = { hips: [-14, 0, 62], body: [0, 22, 0], legL: [50, 6, -62, 74, 0], legR: [50, 6, -62, 74, 0], armL: [86, 8, 4, 6, 0], armR: [86, 8, 4, 6, 0] }; // prettier-ignore\n\nconst POSES = {\n  Heron: strip({ hips: [0, 0, 99], legL: [0, 2, -100, 2, 0], legR: [28, 62, -42, 118, 40], footR: [30, 20, 0], armL: [6, 4, 100, 30, 0], armR: [6, 4, 100, 30, 0] }),\n  Archer: strip({ hips: [0, 0, 72], legL: [62, 12, -78, 62, 0], legR: [-70, 10, -72, 4, 0], footR: [10, 40, 0], armL: [0, 100, 4, 2, 0], armR: [0, 100, 4, 2, 0] }),\n  Nothing: strip({ hips: [-5, 0, 28], legL: [70, 60, -18, 140, 40], legR: [70, 60, -22, 140, -40], footL: [-20, 60, 0], footR: [-20, 60, 0], armL: [70, 22, -60, 58, 20], armR: [70, 22, -60, 58, -20] }),\n  Chair: strip(CHAIR),\n  CommaR: strip({ body: [0, 0, 22], chest: [0, 0, 14], hips: [0, -6, 98], armL: [0, 60, 90, 18, 0], armR: [0, 30, -80, 20, 0] }),\n  CommaL: strip({ body: [0, 0, -22], chest: [0, 0, -14], hips: [0, 6, 98], armR: [0, 60, 90, 18, 0], armL: [0, 30, -80, 20, 0] }),\n  Napkin: strip({ hips: [-8, 0, 94], body: [0, 78, 0], chest: [0, 18, 0], head: [0, 10, 0], armL: [80, 4, -60, 6, 0], armR: [80, 4, -60, 6, 0] }),\n  Bridge: strip3(\n    { hips: [-20, 0, 22], body: [0, -80, 0], legL: [70, 8, 20, 120, 0], legR: [70, 8, 20, 120, 0], armL: [-40, 12, -40, 4, 0], armR: [-40, 12, -40, 4, 0] },\n    { hips: [-20, 0, 58], body: [0, -80, 0], legL: [70, 8, -30, 86, 0], legR: [70, 8, -30, 86, 0], armL: [-40, 12, -60, 4, 0], armR: [-40, 12, -60, 4, 0] },\n  ),\n  Lighthouse: strip({ hips: [0, 0, 106], armL: [4, 2, 100, 2, 0], armR: [4, 2, 100, 2, 0], footL: [-30, 2, 0], footR: [-30, 2, 0], legL: [0, 2, -100, 0, 0], legR: [0, 2, -100, 0, 0] }),\n  LeanR: strip({ body: [0, 0, 8], chest: [0, 0, 4], hips: [0, 5, 99], armL: [0, 40, -70, 8, 0] }),\n  LeanL: strip({ body: [0, 0, -8], chest: [0, 0, -4], hips: [0, -5, 99], armR: [0, 40, -70, 8, 0] }),\n  LeanF: strip({ body: [0, 9, 0], chest: [0, 3, 0], hips: [4, 0, 99], armL: [24, 20, -90, 10, 0], armR: [24, 20, -90, 10, 0] }),\n  LeanB: strip({ body: [0, -8, 0], chest: [0, -3, 0], hips: [-4, 0, 99], armL: [-24, 20, -90, 10, 0], armR: [-24, 20, -90, 10, 0] }),\n  DeepKnee: strip(CHAIR),\n  SideLunge: strip({ hips: [0, 34, 66], legL: [0, 46, -72, 6, 0], legR: [40, 12, -70, 78, 0], body: [0, 12, 8], armL: [60, 20, -30, 40, 0], armR: [60, 20, -30, 40, 0] }),\n  StepUpL: strip({ hips: [0, -5, 105], legL: [60, 6, -40, 84, 0], armR: [30, 18, -80, 40, 0], armL: [-20, 18, -90, 20, 0] }),\n  StepUpR: strip({ hips: [0, 5, 105], legR: [60, 6, -40, 84, 0], armL: [30, 18, -80, 40, 0], armR: [-20, 18, -90, 20, 0] }),\n  SideStep: strip({ hips: [0, 22, 96], legL: [0, 30, -94, 4, 0], legR: [0, 2, -100, 6, 0], armL: [0, 64, -20, 10, 0], armR: [0, 64, -20, 10, 0] }),\n  Jump: strip({ hips: [0, 0, 124], legL: [24, 12, -78, 44, 0], legR: [24, 12, -78, 44, 0], armL: [20, 30, 90, 10, 0], armR: [20, 30, 90, 10, 0] }),\n  LineWalkL: strip({ hips: [0, -3, 100], legL: [34, 2, -84, 30, 0], legR: [-18, 2, -96, 6, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0], footL: [0, 0, 0] }),\n  LineWalkR: strip({ hips: [0, 3, 100], legR: [34, 2, -84, 30, 0], legL: [-18, 2, -96, 6, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0], footR: [0, 0, 0] }),\n  LineStand: strip({ hips: [0, 0, 96], legL: [0, 4, -100, 8, 0], legR: [0, 4, -100, 8, 0], armL: [0, 92, -6, 4, 0], armR: [0, 92, -6, 4, 0] }),\n  BoardStand: strip({ hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], armL: [30, 24, -40, 40, 0], armR: [30, 24, -40, 40, 0], body: [0, 8, 0] }),\n  Paddling: ring(1, [\n    { hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], body: [18, 16, 0], armL: [70, 10, -10, 20, 0], armR: [30, 20, 10, 80, 0] },\n    { hips: [0, 0, 88], legL: [18, 16, -88, 26, 0], legR: [18, 16, -88, 26, 0], body: [-18, 16, 0], armR: [70, 10, -10, 20, 0], armL: [30, 20, 10, 80, 0] },\n  ]),\n  HipCircle: ring(1, [\n    { hips: [12, 0, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0] },\n    { hips: [0, 12, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0], body: [0, 0, -6] },\n    { hips: [-12, 0, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0] },\n    { hips: [0, -12, 98], armL: [0, 50, -30, 80, 0], armR: [0, 50, -30, 80, 0], body: [0, 0, 6] },\n  ]),\n  Somersault: {\n    src: 'RETREAT', dur: 1, loop: false,\n    keys: [0, 1, 2, 3, 4].map((i) => key(i / 4, { body: [0, i * 180, 0], hips: [0, 0, 92], legL: [70, 8, -10, 120, 0], legR: [70, 8, -10, 120, 0], armL: [60, 10, -30, 80, 0], armR: [60, 10, -30, 80, 0] })),\n  },\n  Twist: {\n    src: 'RETREAT', dur: 1, loop: false,\n    keys: [0, 1, 2, 3, 4].map((i) => key(i / 4, { body: [i * 90, 0, 0], armL: [0, 14, 96, 2, 0], armR: [0, 14, 96, 2, 0], legL: [0, 2, -100, 0, 0], legR: [0, 2, -100, 0, 0] })),\n  },\n  DiveReady: strip({ hips: [0, 0, 94], body: [0, 8, 0], armL: [0, 12, 96, 2, 0], armR: [0, 12, 96, 2, 0], footL: [-16, 2, 0], footR: [-16, 2, 0] }),\n  CalmCall: strip({ hips: [0, 0, 92], armL: [50, 26, -30, 20, 0], armR: [50, 26, -30, 20, 0], body: [0, 6, 0] }),\n  Crank: ring(1, [\n    { hips: [0, 0, 84], body: [0, 22, 0], armL: [70, 6, -10, 30, 0], armR: [50, 6, 10, 60, 0], legL: [30, 8, -80, 40, 0], legR: [-20, 8, -92, 10, 0] },\n    { hips: [0, 0, 84], body: [0, 22, 0], armR: [70, 6, -10, 30, 0], armL: [50, 6, 10, 60, 0], legR: [30, 8, -80, 40, 0], legL: [-20, 8, -92, 10, 0] },\n  ]),\n  Stumble: strip({ hips: [-8, 8, 88], body: [10, -8, 16], armL: [20, 80, 30, 30, 0], armR: [-10, 90, 40, 30, 0], legR: [26, 22, -78, 30, 0] }),\n  Fall: strip({ hips: [0, 0, 30], body: [0, -60, 0], armL: [20, 70, 40, 10, 0], armR: [20, 70, 40, 10, 0], legL: [60, 20, -10, 30, 0], legR: [40, 20, -20, 30, 0] }),\n  Bow: strip({ hips: [-2, 0, 98], body: [0, 42, 0], head: [0, 16, 0] }),\n  Nod: strip({ head: [0, 22, 0], body: [0, 4, 0] }),\n  Stand: strip({}),\n}; // prettier-ignore\n\n/** The hand-written set. */\nexport const RETREAT = defineClipSet({\n  set: 'RETREAT', title: 'Retreat poses', format: 2, fps: 30, credit: 'Original',\n  sources: { RETREAT: { file: 'none', rig: 'unreal', label: 'Original', origin: 'Written by hand', license: 'CC0', url: '', rest } },\n  clips: POSES,\n} as never); // prettier-ignore\n\n/** The clips copied from the engine's library, with their sources. */\nexport const RETREATLIB = defineClipSet({\n  set: 'RETREATLIB', title: 'Library clips', format: 2, fps: 30, credit: 'See About',\n  sources: library.sources, clips: library.clips,\n} as never); // prettier-ignore\n\n/** Every actor's clip sets. */\nexport const CLIP_SETS = ['clipset:retreat', 'clipset:retreatlib'] as const;\nE\ncat > labs/game/cast/body.ts <<'E'\n/**\n * @file Drives an actor's clip layer directly: one full-body clip (a scrubbed strip or a loop) and, on top, the four\n * additive leans, written as plain slots, so the sim scrubs them each step. `seekClip` only reaches the top clip, so it\n * could not do two axes; the layer's own `play` removes what a full-body clip covers, so the leans always sit above it.\n */\nimport type { World } from '../../../engine/sim-api';\n\ninterface Slot {\n  clip: string; t: number; w: number; rate: number; stopping: number; loco: boolean;\n  play: Record<string, unknown>;\n}\ntype ClipEntity = { clips?: { state: { slots: Slot[] } } };\n\nconst LEANS = ['RETREAT/LeanR', 'RETREAT/LeanL', 'RETREAT/LeanF', 'RETREAT/LeanB'];\n\nconst slotsOf = (w: World<never> | World, id: number): Slot[] | null =>\n  ((w as World).get(id) as unknown as ClipEntity | undefined)?.clips?.state.slots ?? null;\n\nconst leanSlot = (clip: string): Slot => ({\n  clip, t: 0, w: 1, rate: 0, stopping: 0, loco: false,\n  play: { speed: 0, hold: true, walk: true, loop: false, additive: true, fade: 0 },\n}); // prettier-ignore\n\n/** Scrubs the leans to the CoB: `x` right, `y` forward, each −1 to 1. */\nexport function setLean(w: object, id: number, x: number, y: number): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  if (!slots.some((s) => s.clip === LEANS[0])) slots.push(...LEANS.map(leanSlot));\n  for (const slot of slots) {\n    if (slot.clip === LEANS[0]) slot.t = Math.max(0, Math.min(1, x));\n    else if (slot.clip === LEANS[1]) slot.t = Math.max(0, Math.min(1, -x));\n    else if (slot.clip === LEANS[2]) slot.t = Math.max(0, Math.min(1, y));\n    else if (slot.clip === LEANS[3]) slot.t = Math.max(0, Math.min(1, -y));\n  }\n}\n\n/** The clip now under the leans, or null. */\nfunction baseOf(slots: Slot[]): Slot | null {\n  for (let k = slots.length - 1; k >= 0; k--) {\n    if (!slots[k].play.additive && !slots[k].stopping) return slots[k];\n  }\n  return null;\n}\n\n/** Puts `clip` under the leans, or finds it there. Fades from what was there. */\nfunction ensure(slots: Slot[], clip: string, play: Record<string, unknown>): Slot {\n  const base = baseOf(slots);\n  if (base?.clip === clip && !!base.play.mirror === !!play.mirror) return base;\n  if (base) base.stopping = 0.2;\n  const slot: Slot = { clip, t: 0, w: 0, rate: 0, stopping: 0, loco: false, play };\n  const at = slots.findIndex((s) => s.play.additive);\n  if (at < 0) slots.push(slot);\n  else slots.splice(at, 0, slot);\n  return slot;\n}\n\n/** Scrubs a strip: `clip` as `RETREAT/Heron`, `t` from 0 stood to 1 in the pose. */\nexport function setPose(w: object, id: number, clip: string, t: number, mirror = false): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  const slot = ensure(slots, clip, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.2, mirror });\n  slot.t = t;\n}\n\n/** Plays a loop under the leans at `speed`; the same call again changes nothing but the speed. */\nexport function setLoop(w: object, id: number, clip: string, speed = 1): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  ensure(slots, clip, { speed, walk: true, loop: true, fade: 0.25, out: 0.25 }).play.speed = speed;\n}\n\n/** Plays a clip once and holds its end. */\nexport function setOnce(w: object, id: number, clip: string): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  ensure(slots, clip, { speed: 1, walk: true, loop: false, hold: true, fade: 0.2, out: 0.25 });\n}\n\n/** Lets the body's own animation back: the base clip fades, the leans go to zero. */\nexport function clearBody(w: object, id: number): void {\n  const slots = slotsOf(w as World, id);\n  if (!slots) return;\n  for (const slot of slots) {\n    if (!slot.play.additive) slot.stopping = slot.stopping || 0.25;\n    else slot.t = 0;\n  }\n}\nE\ncat > labs/game/cast/people.ts <<'E'\n/**\n * @file Who is who: the characters' numbers, bodies and builds as data, and `spawnPerson`, which stands one in a scene as\n * an actor the pilot drives (`player: false`). Gull and Frog are blob crowd bodies, spawned in critters.ts.\n */\nimport { createCharacter, spawnActor, type Character } from '../../../engine/sim-api';\nimport { CLIP_SETS } from './clips';\n\nexport interface Person {\n  readonly body: string;\n  readonly build: string;\n  readonly speed: number;\n  readonly secondary?: Readonly<Record<string, unknown>>;\n}\n\nexport const PEOPLE: Readonly<Record<string, Person>> = {\n  plumb: { body: 'body:plumb', build: 'build:plumb', speed: 2.4, secondary: { hair: 'ponytail' } },\n  tare: { body: 'body:tare', build: 'build:tare', speed: 5 },\n  gerald: { body: 'body:gerald', build: 'build:gerald', speed: 4.6 },\n  bex: { body: 'body:bex', build: 'build:bex', speed: 4 },\n  nan: { body: 'body:nan', build: 'build:nan', speed: 2 },\n  extra0: { body: 'body:extra0', build: 'build:chibi', speed: 3 },\n  extra1: { body: 'body:extra1', build: 'build:chibi', speed: 3 },\n  extra2: { body: 'body:extra2', build: 'build:chibi', speed: 3 },\n};\n\nexport const GUEST_SPEED = 5.4;\nexport const GUEST_JUMP = 7.5;\n\n/** Guest bodies by look and colour: `body:guest<look>c<colour>`; hub seats use `body:seat<i>`. */\nexport const GUEST_BUILDS = ['build:chibi', 'build:guestTall', 'build:guestRound'] as const;\nexport const guestBody = (look: number, colour: number): string => `body:guest${look}c${colour}`;\n\n/** A character at `speed` m/s. */\nexport const characterAt = (speed: number): Character => createCharacter({ speed, jumpSpeed: GUEST_JUMP });\n\n/** Stands a person at `at`, facing `yaw`. Keep every character at `player: false`: the pilot writes their intents. */\nexport function spawnPerson(w: object, spec: { at: [number, number, number]; body: string; build: string; speed: number; yaw?: number; secondary?: Readonly<Record<string, unknown>> }): number {\n  return spawnActor(w as never, {\n    at: spec.at,\n    character: characterAt(spec.speed),\n    player: false,\n    yaw: spec.yaw ?? 0,\n    anim: { build: spec.build, weapon: 'none' },\n    body: spec.body,\n    clips: { sets: [...CLIP_SETS] },\n    components: spec.secondary ? { secondary: spec.secondary } : {},\n  });\n}\nE\ncat > labs/game/scenes/data/stations.ts <<'E'\n/**\n * @file The island's places as data (PLAN.md section 2), metres, x east, z south. Heights come from the terrain at run\n * time. `MATS` are the four mats of the Pavilion, seat by seat, relative to its centre.\n */\nexport interface Station { readonly x: number; readonly z: number; readonly yaw: number; readonly title: string }\n\nexport const STATIONS = {\n  pier: { x: 0, z: 100, yaw: Math.PI, title: 'Ferry Pier' },\n  plaza: { x: 0, z: 34, yaw: 0, title: 'The Plaza' },\n  pavilion: { x: -52, z: 18, yaw: 0, title: 'Pose Pavilion' },\n  pond: { x: -70, z: -12, yaw: 0, title: 'Still Pond' },\n  annex: { x: 52, z: 22, yaw: 0, title: 'The Annex' },\n  huts: { x: 64, z: 52, yaw: 0, title: 'Guest Huts' },\n  lagoon: { x: -60, z: 85, yaw: 0, title: 'South-West Lagoon' },\n  terrace: { x: 30, z: -48, yaw: 0, title: 'Sand Terrace' },\n  cliff: { x: 0, z: -88, yaw: Math.PI, title: 'North Cliff' },\n  hoopBeach: { x: 62, z: 84, yaw: 0, title: 'Hoop Beach' },\n  lighthouse: { x: 84, z: -60, yaw: 0, title: 'Lighthouse' },\n  east: { x: 74, z: 8, yaw: 0, title: 'East Terrace' },\n  stone: { x: 0, z: 0, yaw: 0, title: 'Centre Stone' },\n} as const satisfies Record<string, Station>;\n\nexport type StationId = keyof typeof STATIONS;\n\n/** The four mats, seat by seat: x and z from the Pavilion's centre. Seat 0 is the front right; Plumb stands north of them. */\nexport const MATS: readonly (readonly [number, number])[] = [\n  [-1.9, 1.2],\n  [1.9, 1.2],\n  [-5.2, 3.6],\n  [5.2, 3.6],\n];\n\n/** Where the instructor stands, from the Pavilion's centre. */\nexport const FRONT_MAT: readonly [number, number] = [0, -5];\nE\ngit -C . rev-parse --show-toplevel | tail -1; grep -n \"createNoise\\|reactTo\" engine/sim-api.ts | head -3; sed -n 1,25p tools/templates/body/body.ts.tmpl | grep -n \"parts\\|mirror\" | head; grep -rn \"'ball'\\|'box'\\|'limb'\\|'eye'\\|'cyl\\|'disc\" engine/gfx/puppets/compile.ts | head -12 | cut -c1-140; node x describe body 2>&1 | head -14 | cut -c1-200; grep -n \"defineBody\\|ponytail\\|hair\" engine/sim/reactions.ts | head -8 | cut -c1-160","description":"Write clip set, body driver, people, stations"}}}
