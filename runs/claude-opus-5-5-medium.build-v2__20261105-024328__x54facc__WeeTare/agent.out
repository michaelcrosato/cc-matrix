{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgji4us5CSdu34B3eMRLG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NmG2xz7iYGyr8sqPgsQp5z","name":"Bash","input":{"command":"mkdir -p out; mv .t out/t; sed -i 's#\\.t/#out/t/#g' out/t/*.py; cat > out/t/b.sh <<'E'\n#!/bin/bash\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-024328__x54facc/work/WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328\ntimeout 100 node labs/game/tools/onefile.mjs ../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html 2>&1 | tail -3 | cut -c1-200\nE\nsed -i 's#\\.t/b\\.sh#out/t/b.sh#' ../PROGRESS.md\npython3 - <<'E'\nM='labs/game/main.ts';s=open(M).read()\ns=s.replace(\"if (mode === 'results' && !flow.bot) ctx.push(\",\"if (mode === 'results' && !flow.drive && !flow.auto) ctx.push(\")\ns=s.replace(\"      title: TITLE,\\n\",\"      title: TITLE,\\n      setting: (key: string) => lastFrame?.setting(key),\\n\")\ns=s.replace(\"    frame(frame: EngineFrame) {\\n      const dt = frame.dt;\",\"    frame(frame: EngineFrame) {\\n      lastFrame = frame;\\n      const dt = frame.dt;\")\ns=s.replace(\"  const touchScreen = () => touchOnly;\",\"  let lastFrame: EngineFrame | null = null;\\n  const touchScreen = () => touchOnly;\")\nopen(M,'w').write(s)\nE\ncat > labs/game/tools/verify.mjs <<'E'\n/**\n * @file The one command: node labs/game/tools/verify.mjs [--quick]. Node stages: npm run check, then the game's tests. Browser\n * stages: build the single file, then tools/browser.py plays it in headless Chromium and tools/hub.py runs the hub's harness.\n * Prints only failures and one final count line.\n */\nimport { spawnSync } from 'node:child_process';\nimport { resolve } from 'node:path';\n\nconst quick = process.argv.includes('--quick');\nconst OUT = resolve('../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html');\nlet passed = 0;\nlet failed = 0;\n\n/** Runs a stage; on failure prints its last lines. `count` reads \"ok N, fail M\" lines from a script. */\nfunction stage(name, command, args, options = {}) {\n  const run = spawnSync(command, args, { encoding: 'utf8', maxBuffer: 1 << 28, ...options });\n  const text = `${run.stdout ?? ''}${run.stderr ?? ''}`;\n  const counted = /^RESULT ok (\\d+) fail (\\d+)$/m.exec(text);\n  if (counted) {\n    passed += Number(counted[1]);\n    failed += Number(counted[2]);\n    for (const line of text.split('\\n')) if (line.startsWith('FAIL')) console.log(`${name}: ${line}`);\n    return;\n  }\n  if (run.status === 0) passed += 1;\n  else {\n    failed += 1;\n    console.log(`FAIL ${name}\\n${text.split('\\n').slice(-25).join('\\n')}`);\n  }\n}\n\nstage('check', 'npm', ['run', 'check']);\nstage('tests', 'npx', ['vitest', 'run', 'labs/game']);\nstage('no audio files', 'node', ['-e', `\nconst fs=require('fs');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]);\nfor(const f of walk('labs/game')) if(/\\\\.(mp3|wav|ogg|flac|m4a)$/i.test(f)) throw new Error(f);`]);\nif (!quick) {\n  stage('build', 'node', ['labs/game/tools/onefile.mjs', OUT]);\n  stage('browser', 'python3', ['-u', 'labs/game/tools/browser.py', OUT]);\n  stage('hub', 'python3', ['-u', 'labs/game/tools/hub.py', OUT]);\n}\nconsole.log(`${failed === 0 ? 'ok' : 'FAILED'}: ${passed} passed, ${failed} failed`);\nprocess.exit(failed ? 1 : 0);\nE\ncat > labs/game/tools/hub.py <<'E'\n\"\"\"The hub's own harness (labs/game/hub/harness.html) at 2, 3 and 4 players and with the host leaving, on a server this script\nstarts and stops by itself. Each frame must have the engine truly running: the harness alone would pass a dead game.\"\"\"\nimport hashlib, json, os, re, shutil, subprocess, sys, tempfile, time\nfrom playwright.sync_api import sync_playwright\n\nbuilt = sys.argv[1]\nok = fail = 0\ndef check(name, cond, detail=''):\n    global ok, fail\n    if cond: ok += 1\n    else:\n        fail += 1\n        print('FAIL', name, str(detail)[:1500])\n\nd = tempfile.mkdtemp(prefix='hub', dir='out')\nshutil.copy(built, d + '/game.html')\nfor f in ['harness.html', 'bridge.js', 'round.js']:\n    shutil.copy('labs/game/hub/' + f, d + '/' + f)\nhtml = open(built, encoding='utf8').read()\nclient = open('labs/game/hub/session-client.txt', encoding='utf8').read()\ncheck('client pasted byte for byte', client in html)\ncheck('client is first in head', html.index('aihub-session') < html.index('hub:session-mode'))\nsrv = subprocess.Popen(['python3', '-u', '-m', 'http.server', '0', '--bind', '127.0.0.1', '--directory', d], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\nport = re.search(r'port (\\d+)', srv.stdout.readline()).group(1)\nARGS = ['--no-sandbox', '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader']\ntry:\n    with sync_playwright() as p:\n        b = p.chromium.launch(headless=True, args=ARGS)\n        for players, scenario, play in [(2, '', 80000), (3, '', 8000), (4, '', 8000), (3, 'host-leave', 8000)]:\n            pg = b.new_page(viewport={'width': 1280, 'height': 800})\n            logs = []\n            pg.on('console', lambda m: logs.append(m.text) if m.text.startswith('[AIHub]') else None)\n            q = f'game=game.html&players={players}&latency=150&jitter=50&loss=5&auto=1&play={play}' + (f'&scenario={scenario}' if scenario else '')\n            pg.goto(f'http://127.0.0.1:{port}/harness.html?{q}')\n            t = time.time()\n            live = []\n            while time.time() - t < 400:\n                if pg.evaluate(\"()=>document.body.dataset.complete==='true'\"):\n                    break\n                for fr in pg.frames[1:]:\n                    try:\n                        s = fr.evaluate(\"()=>[window.__engine&&window.__engine.ready===true,(window.__engine&&window.__engine.errors||[]).length,window.__engine&&window.__engine.state?window.__engine.state('ghost').entities.length:-1]\")\n                        live.append(s)\n                    except Exception:\n                        pass\n                time.sleep(2)\n            c = json.loads(pg.evaluate(\"()=>JSON.stringify(window.__hubCheck||null)\"))\n            name = f'{players} players {scenario}'\n            check(name + ' harness pass', c and c.get('pass'), [x for x in (c or {}).get('checks', []) if not x['pass']])\n            check(name + ' no protocol lines', not logs, logs[:3])\n            check(name + ' no engine errors', all(s[1] == 0 for s in live), live[-4:])\n            if players == 2:\n                check('engine truly running in every frame', sum(1 for s in live if s[0]) >= 2, live[-4:])\n                check('a ghost at 2 players', any(s[2] == 1 for s in live), live[-4:])\n            pg.close()\n        b.close()\nfinally:\n    srv.terminate()\n    shutil.rmtree(d, ignore_errors=True)\nprint(f'RESULT ok {ok} fail {fail}')\nE\ncat > labs/game/tools/browser.py <<'E'\n\"\"\"Plays the built file in headless Chromium through its devices: boot, pad, keys, mouse, 10-foot, attract, pause, dev, settings,\nAbout, touch-only and the no-WebGPU page. Prints FAIL lines and a RESULT line. One or two browsers at once.\"\"\"\nimport json, sys, time\nfrom playwright.sync_api import sync_playwright\n\nbuilt = sys.argv[1]\nURL = 'file://' + built\nARGS = ['--no-sandbox', '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader']\nPAD = \"\"\"\nwindow.__pad = null;\nconst real = navigator.getGamepads.bind(navigator);\nnavigator.getGamepads = () => {\n  if (!window.__pad) return [null, null, null, null];\n  return [window.__pad, null, null, null];\n};\nwindow.__press = (i, down) => {\n  const buttons = Array.from({length: 17}, (_, k) => ({pressed: k === i && down, touched: k === i && down, value: k === i && down ? 1 : 0}));\n  window.__pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: [0, 0, 0, 0], buttons};\n};\n\"\"\"\nok = fail = 0\ndef check(name, cond, detail=''):\n    global ok, fail\n    if cond: ok += 1\n    else:\n        fail += 1\n        print('FAIL', name, str(detail)[:700])\n\ndef boot(pg):\n    t = time.time()\n    while time.time() - t < 180:\n        try:\n            if pg.evaluate(\"()=>window.__engine&&window.__engine.ready===true&&!!window.__game\"): return True\n        except Exception:\n            pass\n        time.sleep(1)\n    return False\n\ngame = lambda pg: pg.evaluate(\"()=>{const g={...window.__game};delete g.setting;return g}\")\nact = lambda pg, name, args=None: pg.evaluate(\"([n,a])=>a?__engine.actions.run(n,a):__engine.actions.run(n)\", [name, args])\n\ndef until(pg, js, secs=20):\n    t = time.time()\n    while time.time() - t < secs:\n        try:\n            if pg.evaluate(js): return True\n        except Exception:\n            pass\n        time.sleep(0.2)\n    return False\n\ndef tap_key(pg, key):\n    pg.keyboard.press(key, delay=120)\n    time.sleep(0.5)\n\ndef tap_pad(pg, i):\n    pg.evaluate(\"(i)=>__press(i,true)\", i)\n    time.sleep(0.5)\n    pg.evaluate(\"(i)=>__press(i,false)\", i)\n    time.sleep(0.5)\n\nSMALL = \"\"\"()=>{const out=[];const w=document.createTreeWalker(document.getElementById('wt'),NodeFilter.SHOW_TEXT);\n while(w.nextNode()){const n=w.currentNode;if(!n.textContent.trim())continue;const e=n.parentElement;if(!e.offsetParent&&getComputedStyle(e).position!=='fixed')continue;const cs=getComputedStyle(e);if(cs.visibility==='hidden'||cs.display==='none')continue;\n const r=e.getBoundingClientRect();if(!r.width)continue;if(parseFloat(cs.fontSize)<27.9)out.push(n.textContent.slice(0,30)+' '+cs.fontSize);}return out}\"\"\"\nROWS = \"()=>Math.max(0,...[...document.querySelectorAll('#wt .wt-menu')].map(m=>m.children.length))\"\n\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=ARGS)\n    ctx = b.new_context(viewport={'width': 1920, 'height': 1080})\n    ctx.add_init_script(PAD)\n    pg = ctx.new_page()\n    logs = []\n    pg.on('console', lambda m: logs.append(m.text) if m.type == 'error' else None)\n    pg.on('pageerror', lambda e: logs.append(str(e)))\n    requests = []\n    pg.on('request', lambda r: requests.append(r.url) if not r.url.startswith(('file:', 'data:', 'blob:')) else None)\n    pg.goto(URL)\n    check('boot', boot(pg))\n    check('no engine errors at boot', pg.evaluate(\"()=>__engine.errors.length===0\"), pg.evaluate(\"()=>JSON.stringify(__engine.errors).slice(0,500)\"))\n    check('no WebGPU downgrade errors', pg.evaluate(\"()=>__engine.info().adapter!==null\"))\n    g = game(pg)\n    check('title first', g['screen'] == 'title', g)\n    check('music at 10% on a fresh save', abs(g['music'] - 0.1) < 1e-6, g)\n    check('session client present and inactive', pg.evaluate(\"()=>window.AIHub&&window.AIHub.active===false\"))\n    check('Math.random untouched outside a session', pg.evaluate(\"()=>/native code/.test(String(Math.random))\"))\n    check('title text at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    check('title menu at most six rows', pg.evaluate(ROWS) <= 6)\n    check('title names the game', 'Wee Tare' in pg.inner_text('[data-ui=title]'))\n    # keyboard and mouse on menus\n    tap_key(pg, 'ArrowDown')\n    check('keys move the focus', game(pg)['focus'] != 'begin', game(pg))\n    check('prompts follow keys', game(pg)['device'] == 'keys')\n    pg.hover('[data-id=settings]')\n    time.sleep(0.5)\n    check('hover moves the focus', game(pg)['focus'] == 'settings', game(pg))\n    pg.click('[data-id=settings]')\n    check('click picks', until(pg, \"()=>__game.screen==='settings'\"), game(pg))\n    check('prompts follow the mouse', until(pg, \"()=>__game.device==='mouse'\", 5), game(pg))\n    check('settings shows music at 10%', '10%' in pg.inner_text('[data-id=music]'))\n    check('settings text at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    check('settings at most six rows', pg.evaluate(ROWS) <= 6)\n    # music persists\n    tap_key(pg, 'ArrowRight')\n    check('music slider moves', until(pg, \"()=>Math.abs(__game.music-0.2)<1e-6\", 5), game(pg))\n    check('volumes kept', '0.2' in pg.evaluate(\"()=>localStorage.getItem('weetare:settings')||JSON.stringify(Object.fromEntries(Object.entries(localStorage)))\"))\n    tap_key(pg, 'ArrowLeft')\n    tap_key(pg, 'Escape')\n    check('Esc goes back', until(pg, \"()=>__game.screen==='title'\"), game(pg))\n    # the pad on menus, glyphs\n    pg.evaluate(\"()=>__press(-1,false)\")\n    tap_pad(pg, 13)\n    check('prompts follow the pad', game(pg)['device'] == 'pad', game(pg))\n    check('D-pad moves the focus', until(pg, \"()=>__game.focus!==''\", 3))\n    check('PlayStation glyphs by default', pg.evaluate(\"()=>getComputedStyle(document.getElementById('wt')).getPropertyValue('--ink')!==''&&document.getElementById('wt').dataset.pad==='ps'\"))\n    pg.keyboard.press('ArrowUp', delay=120)\n    time.sleep(0.3)\n    check('prompts change to keys at a key', game(pg)['device'] == 'keys', game(pg))\n    # About\n    for _ in range(6):\n        if game(pg)['focus'] == 'about': break\n        tap_key(pg, 'ArrowDown')\n    tap_key(pg, 'Enter')\n    check('About opens', until(pg, \"()=>__game.screen==='about'\"), game(pg))\n    seen = ''\n    for _ in range(7):\n        seen += pg.inner_text('[data-ui=about]') + '\\n'\n        check('About text fits a TV', pg.evaluate(\"()=>{const a=document.querySelector('.wt-about');return a.scrollHeight<=a.clientHeight+2}\"), seen[-200:])\n        tap_key(pg, 'ArrowRight')\n    for word in ['Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback', 'Credits', 'Wii Fit', 'PLAN.md', 'added on import', 'Date', 'Genre', 'Perspective', 'Tech', 'Art Direction', 'Animation', 'Audio', 'Online', 'Testing', 'Research', 'Environment', 'Model', 'Usage', 'How many issues', 'What did you like most', 'What would you change', 'my-3dge', '100STYLE']:\n        check('About says ' + word, word in seen)\n    check('no pending answers', 'pending' not in seen)\n    tap_key(pg, 'Escape')\n    until(pg, \"()=>__game.screen==='title'\")\n    # attract: starts by itself, loops, leaves on input, never saves\n    save0 = pg.evaluate(\"()=>localStorage.getItem('weetare:game')\")\n    t0 = time.time()\n    pg.keyboard.press('Shift', delay=50)\n    started = until(pg, \"()=>__game.attract===true\", 16)\n    dt = time.time() - t0\n    check('attract starts near 10 s', started and 9 <= dt <= 14.5, dt)\n    ids = set()\n    for _ in range(4):\n        ids.add(game(pg)['event'])\n        pg.evaluate(\"()=>__engine.step(1500)\")\n        time.sleep(0.4)\n    check('attract shows several activities', len(ids) >= 3, ids)\n    check('attract says DEMO', 'DEMO' in pg.inner_text('[data-ui=attract]'))\n    pg.keyboard.press('KeyA', delay=60)\n    check('a key leaves attract', until(pg, \"()=>__game.attract===false&&__game.screen==='title'\"), game(pg))\n    until(pg, \"()=>__game.attract===true\", 16)\n    pg.mouse.click(30, 30)\n    check('a click leaves attract', until(pg, \"()=>__game.attract===false\"), game(pg))\n    until(pg, \"()=>__game.attract===true\", 16)\n    tap_pad(pg, 0)\n    check('a pad press leaves attract', until(pg, \"()=>__game.attract===false\"), game(pg))\n    pg.evaluate(\"()=>{window.__pad=null}\")\n    check('attract never touches the save', pg.evaluate(\"()=>localStorage.getItem('weetare:game')\") == save0)\n    # begin: the standalone hub test's presses, then the pier, the island\n    until(pg, \"()=>__game.screen==='title'\")\n    tap_key(pg, 'Enter')\n    check('Begin opens the pier', until(pg, \"()=>__game.screen==='wtpier'||document.querySelector('[data-id=look]')!==null\"), game(pg))\n    tap_key(pg, 'ArrowUp')\n    tap_key(pg, 'Enter')\n    check('onto the island', until(pg, \"()=>__game.mode==='roam'&&__game.screen==='roam'\", 15), game(pg))\n    pg.keyboard.press('Tab', delay=120)\n    check('Tab opens the Programme', until(pg, \"()=>__game.screen==='programme'\", 6), game(pg))\n    check('Programme at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    tap_key(pg, 'Escape')\n    # an activity, pause, dev mode\n    act(pg, 'game.start', {'id': 'poseA'})\n    check('an activity runs', until(pg, \"()=>__game.event==='poseA'\"), game(pg))\n    pg.evaluate(\"()=>__engine.step(400)\")\n    time.sleep(1)\n    check('Pose HUD at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    before = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.ty\")\n    pg.keyboard.down('KeyW')\n    time.sleep(1.2)\n    after = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.ty\")\n    pg.keyboard.up('KeyW')\n    check('W leans', after > before + 0.05, [before, after])\n    pg.mouse.click(960, 300)\n    time.sleep(0.6)\n    locked = pg.evaluate(\"()=>!!document.pointerLockElement\")\n    mx0 = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.mx\")\n    pg.mouse.move(1200, 300, steps=4)\n    time.sleep(0.4)\n    mx1 = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.mx\")\n    check('pointer-lock lean moves the CoB', not locked or mx1 != mx0, [locked, mx0, mx1])\n    pg.keyboard.press('Escape', delay=120)\n    check('Esc pauses', until(pg, \"()=>__game.screen==='pause'\", 8), game(pg))\n    pg.evaluate(\"()=>document.exitPointerLock&&document.exitPointerLock()\")\n    tick = pg.evaluate(\"()=>__engine.info().tick\")\n    time.sleep(1)\n    check('pause stops the sim', pg.evaluate(\"()=>__engine.info().tick\") == tick)\n    check('pause at most six rows', pg.evaluate(ROWS) <= 6)\n    pg.click('[data-id=more]')\n    time.sleep(0.4)\n    pg.click('[data-id=dev]')\n    check('pause reaches Dev Mode', until(pg, \"()=>__game.screen==='dev'\"), game(pg))\n    PATH = 'game.wobble.noise'\n    pg.evaluate(\"\"\"(path)=>{const r=document.querySelector(`input[data-path=\"${path}\"]`)||null;if(!r)return;r.value='7';r.dispatchEvent(new Event('input'))}\"\"\", PATH)\n    if pg.evaluate(\"(p)=>!document.querySelector(`input[data-path=\\\"${p}\\\"]`)\", PATH):\n        for _ in range(8):\n            tap_key(pg, 'ArrowDown')\n            if pg.evaluate(\"(p)=>!!document.querySelector(`input[data-path=\\\"${p}\\\"]`)\", PATH): break\n        pg.evaluate(\"\"\"(path)=>{const r=document.querySelector(`input[data-path=\"${path}\"]`);r.value='7';r.dispatchEvent(new Event('input'))}\"\"\", PATH)\n    time.sleep(0.4)\n    check('a slider changes the setting', pg.evaluate(\"(p)=>__game.setting(p)\", PATH) == 7, pg.evaluate(\"(p)=>__game.setting(p)\", PATH))\n    pg.click('.drow >> nth=0')\n    time.sleep(0.4)\n    check('Reset restores the default', pg.evaluate(\"(p)=>__game.setting(p)\", PATH) == 3.5, pg.evaluate(\"(p)=>__game.setting(p)\", PATH))\n    pg.click('.tab >> nth=1')\n    time.sleep(0.3)\n    pg.click('.drow >> nth=2')\n    check('Jump to Day 3 works', until(pg, \"()=>__game.day===3&&__game.mode==='roam'\"), game(pg))\n    pg.evaluate(\"()=>{if(__engine.info&&__engine.resume)__engine.resume()}\")\n    # the way to the credits, by keys alone from here\n    act(pg, 'game.day', {'day': 5})\n    act(pg, 'game.flags', {'done': ['check', 'group', 'poseC']})\n    act(pg, 'game.start', {'id': 'tilt'})\n    check('the Great Tilt starts', until(pg, \"()=>__game.event==='tilt'\"), game(pg))\n    pg.evaluate(\"()=>__engine.step(200)\")\n    time.sleep(1)\n    act(pg, 'game.finishAt', {'score': 800})\n    check('the last Morning Check follows', until(pg, \"()=>__game.event==='check'\", 10), game(pg))\n    act(pg, 'game.finishAt', {'score': 900})\n    check('then the credits', until(pg, \"()=>__game.screen==='credits'\", 10), game(pg))\n    tap_key(pg, 'Enter')\n    check('then Free Play', until(pg, \"()=>__game.mode==='roam'&&__game.day===6\", 10), game(pg))\n    check('fetches nothing', not requests, requests[:3])\n    check('no console errors', not logs, logs[:3])\n    ctx.close()\n\n    # Erase asks in-game, and volumes survive a reload: a fresh page in a fresh context, keeping storage in it\n    ctx = b.new_context(viewport={'width': 1920, 'height': 1080})\n    pg = ctx.new_page()\n    dialogs = []\n    pg.on('dialog', lambda d: (dialogs.append(d.type), d.dismiss()))\n    pg.goto(URL)\n    boot(pg)\n    pg.click('[data-id=settings]')\n    until(pg, \"()=>__game.screen==='settings'\")\n    tap_key(pg, 'ArrowRight')\n    until(pg, \"()=>Math.abs(__game.music-0.2)<1e-6\", 5)\n    pg.reload()\n    boot(pg)\n    check('volumes persist across a reload', abs(game(pg)['music'] - 0.2) < 1e-6, game(pg))\n    pg.click('[data-id=settings]')\n    time.sleep(0.5)\n    for _ in range(2):\n        pg.click('[data-id^=next]')\n        time.sleep(0.3)\n    pg.click('[data-id=erase]')\n    check('Erase asks in-game', until(pg, \"()=>document.querySelector('[data-id=yes]')!==null\", 5) and not dialogs, dialogs)\n    pg.click('[data-id=yes]')\n    time.sleep(0.5)\n    check('Erase resets music', abs(game(pg)['music'] - 0.1) < 1e-6, game(pg))\n    ctx.close()\n\n    # touch-only\n    phone = dict(p.devices['iPhone 13'])\n    phone.pop('default_browser_type', None)\n    ctx = b.new_context(**phone)\n    pg = ctx.new_page()\n    pg.goto(URL)\n    check('touch boot', boot(pg))\n    check('touch says controller required', until(pg, \"()=>document.body.innerText.includes('Controller or keyboard required')\", 10))\n    check('no touch controls', pg.evaluate(\"()=>document.querySelectorAll('[data-ui^=touch],.touch-stick,.touch-button,.touch-fan').length===0\"))\n    check('touch shows only Settings', pg.evaluate(\"()=>[...document.querySelectorAll('#wt .wt-row')].map(r=>r.dataset.id).join()\") == 'settings')\n    check('attract runs behind it', until(pg, \"()=>__game.attract===true\", 16), game(pg))\n    box = pg.locator('[data-id=settings]').bounding_box()\n    pg.touchscreen.tap(box['x'] + box['width'] / 2, box['y'] + box['height'] / 2)\n    check('a tap opens Settings', until(pg, \"()=>__game.screen==='settings'\", 8), game(pg))\n    ctx.close()\n    b.close()\n\n    # no WebGPU here\n    wk = p.webkit.launch()\n    pg = wk.new_page()\n    pg.goto(URL)\n    time.sleep(3)\n    check('no-WebGPU page is friendly', 'WebGPU' in pg.inner_text('body'), pg.inner_text('body')[:200])\n    wk.close()\nprint(f'RESULT ok {ok} fail {fail}')\nE\necho \"unknown\" >/dev/null; sed -i \"s/const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');/const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');\\n  layer.dataset.ui = 'pier';/\" labs/game/ui/screens/front.ts; sed -i \"s/__game.screen==='wtpier'||document.querySelector('\\[data-id=look\\]')!==null/__game.screen==='pier'/\" labs/game/tools/browser.py\nnpx prettier --write labs/game --log-level warn 2>&1 | tail -3 | cut -c1-160; npx eslint labs/game 2>&1 | grep -E \"^\\S|error\" | head -24 | cut -c1-200; wc -l labs/game/*/*.ts labs/game/*.ts labs/game/*/*/*.ts | sort -rn | sed -n 1,8p | cut -c1-60; out/t/b.sh; (timeout 580 python3 -u labs/game/tools/browser.py \"$PWD/../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html\" > out/t/browser.log 2>&1; echo finished >> out/t/browser.log) ; tail -40 out/t/browser.log | cut -c1-500","description":"Write verify and browser tests, format, lint, run browser stage","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":771,"cache_read_input_tokens":530551,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":771},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"6e3f7b84-c129-47c3-ae92-148e904bd631","timestamp":"2026-11-05T11:35:08.074Z","request_id":"req_011Cgji4uWEbp9AiffKBUhau","wire_tool_inputs":{"toolu_01NmG2xz7iYGyr8sqPgsQp5z":{"command":"mkdir -p out; mv .t out/t; sed -i 's#\\.t/#out/t/#g' out/t/*.py; cat > out/t/b.sh <<'E'\n#!/bin/bash\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-024328__x54facc/work/WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328\ntimeout 100 node labs/game/tools/onefile.mjs ../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html 2>&1 | tail -3 | cut -c1-200\nE\nsed -i 's#\\.t/b\\.sh#out/t/b.sh#' ../PROGRESS.md\npython3 - <<'E'\nM='labs/game/main.ts';s=open(M).read()\ns=s.replace(\"if (mode === 'results' && !flow.bot) ctx.push(\",\"if (mode === 'results' && !flow.drive && !flow.auto) ctx.push(\")\ns=s.replace(\"      title: TITLE,\\n\",\"      title: TITLE,\\n      setting: (key: string) => lastFrame?.setting(key),\\n\")\ns=s.replace(\"    frame(frame: EngineFrame) {\\n      const dt = frame.dt;\",\"    frame(frame: EngineFrame) {\\n      lastFrame = frame;\\n      const dt = frame.dt;\")\ns=s.replace(\"  const touchScreen = () => touchOnly;\",\"  let lastFrame: EngineFrame | null = null;\\n  const touchScreen = () => touchOnly;\")\nopen(M,'w').write(s)\nE\ncat > labs/game/tools/verify.mjs <<'E'\n/**\n * @file The one command: node labs/game/tools/verify.mjs [--quick]. Node stages: npm run check, then the game's tests. Browser\n * stages: build the single file, then tools/browser.py plays it in headless Chromium and tools/hub.py runs the hub's harness.\n * Prints only failures and one final count line.\n */\nimport { spawnSync } from 'node:child_process';\nimport { resolve } from 'node:path';\n\nconst quick = process.argv.includes('--quick');\nconst OUT = resolve('../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html');\nlet passed = 0;\nlet failed = 0;\n\n/** Runs a stage; on failure prints its last lines. `count` reads \"ok N, fail M\" lines from a script. */\nfunction stage(name, command, args, options = {}) {\n  const run = spawnSync(command, args, { encoding: 'utf8', maxBuffer: 1 << 28, ...options });\n  const text = `${run.stdout ?? ''}${run.stderr ?? ''}`;\n  const counted = /^RESULT ok (\\d+) fail (\\d+)$/m.exec(text);\n  if (counted) {\n    passed += Number(counted[1]);\n    failed += Number(counted[2]);\n    for (const line of text.split('\\n')) if (line.startsWith('FAIL')) console.log(`${name}: ${line}`);\n    return;\n  }\n  if (run.status === 0) passed += 1;\n  else {\n    failed += 1;\n    console.log(`FAIL ${name}\\n${text.split('\\n').slice(-25).join('\\n')}`);\n  }\n}\n\nstage('check', 'npm', ['run', 'check']);\nstage('tests', 'npx', ['vitest', 'run', 'labs/game']);\nstage('no audio files', 'node', ['-e', `\nconst fs=require('fs');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]);\nfor(const f of walk('labs/game')) if(/\\\\.(mp3|wav|ogg|flac|m4a)$/i.test(f)) throw new Error(f);`]);\nif (!quick) {\n  stage('build', 'node', ['labs/game/tools/onefile.mjs', OUT]);\n  stage('browser', 'python3', ['-u', 'labs/game/tools/browser.py', OUT]);\n  stage('hub', 'python3', ['-u', 'labs/game/tools/hub.py', OUT]);\n}\nconsole.log(`${failed === 0 ? 'ok' : 'FAILED'}: ${passed} passed, ${failed} failed`);\nprocess.exit(failed ? 1 : 0);\nE\ncat > labs/game/tools/hub.py <<'E'\n\"\"\"The hub's own harness (labs/game/hub/harness.html) at 2, 3 and 4 players and with the host leaving, on a server this script\nstarts and stops by itself. Each frame must have the engine truly running: the harness alone would pass a dead game.\"\"\"\nimport hashlib, json, os, re, shutil, subprocess, sys, tempfile, time\nfrom playwright.sync_api import sync_playwright\n\nbuilt = sys.argv[1]\nok = fail = 0\ndef check(name, cond, detail=''):\n    global ok, fail\n    if cond: ok += 1\n    else:\n        fail += 1\n        print('FAIL', name, str(detail)[:1500])\n\nd = tempfile.mkdtemp(prefix='hub', dir='out')\nshutil.copy(built, d + '/game.html')\nfor f in ['harness.html', 'bridge.js', 'round.js']:\n    shutil.copy('labs/game/hub/' + f, d + '/' + f)\nhtml = open(built, encoding='utf8').read()\nclient = open('labs/game/hub/session-client.txt', encoding='utf8').read()\ncheck('client pasted byte for byte', client in html)\ncheck('client is first in head', html.index('aihub-session') < html.index('hub:session-mode'))\nsrv = subprocess.Popen(['python3', '-u', '-m', 'http.server', '0', '--bind', '127.0.0.1', '--directory', d], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\nport = re.search(r'port (\\d+)', srv.stdout.readline()).group(1)\nARGS = ['--no-sandbox', '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader']\ntry:\n    with sync_playwright() as p:\n        b = p.chromium.launch(headless=True, args=ARGS)\n        for players, scenario, play in [(2, '', 80000), (3, '', 8000), (4, '', 8000), (3, 'host-leave', 8000)]:\n            pg = b.new_page(viewport={'width': 1280, 'height': 800})\n            logs = []\n            pg.on('console', lambda m: logs.append(m.text) if m.text.startswith('[AIHub]') else None)\n            q = f'game=game.html&players={players}&latency=150&jitter=50&loss=5&auto=1&play={play}' + (f'&scenario={scenario}' if scenario else '')\n            pg.goto(f'http://127.0.0.1:{port}/harness.html?{q}')\n            t = time.time()\n            live = []\n            while time.time() - t < 400:\n                if pg.evaluate(\"()=>document.body.dataset.complete==='true'\"):\n                    break\n                for fr in pg.frames[1:]:\n                    try:\n                        s = fr.evaluate(\"()=>[window.__engine&&window.__engine.ready===true,(window.__engine&&window.__engine.errors||[]).length,window.__engine&&window.__engine.state?window.__engine.state('ghost').entities.length:-1]\")\n                        live.append(s)\n                    except Exception:\n                        pass\n                time.sleep(2)\n            c = json.loads(pg.evaluate(\"()=>JSON.stringify(window.__hubCheck||null)\"))\n            name = f'{players} players {scenario}'\n            check(name + ' harness pass', c and c.get('pass'), [x for x in (c or {}).get('checks', []) if not x['pass']])\n            check(name + ' no protocol lines', not logs, logs[:3])\n            check(name + ' no engine errors', all(s[1] == 0 for s in live), live[-4:])\n            if players == 2:\n                check('engine truly running in every frame', sum(1 for s in live if s[0]) >= 2, live[-4:])\n                check('a ghost at 2 players', any(s[2] == 1 for s in live), live[-4:])\n            pg.close()\n        b.close()\nfinally:\n    srv.terminate()\n    shutil.rmtree(d, ignore_errors=True)\nprint(f'RESULT ok {ok} fail {fail}')\nE\ncat > labs/game/tools/browser.py <<'E'\n\"\"\"Plays the built file in headless Chromium through its devices: boot, pad, keys, mouse, 10-foot, attract, pause, dev, settings,\nAbout, touch-only and the no-WebGPU page. Prints FAIL lines and a RESULT line. One or two browsers at once.\"\"\"\nimport json, sys, time\nfrom playwright.sync_api import sync_playwright\n\nbuilt = sys.argv[1]\nURL = 'file://' + built\nARGS = ['--no-sandbox', '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--use-vulkan=swiftshader', '--use-angle=swiftshader']\nPAD = \"\"\"\nwindow.__pad = null;\nconst real = navigator.getGamepads.bind(navigator);\nnavigator.getGamepads = () => {\n  if (!window.__pad) return [null, null, null, null];\n  return [window.__pad, null, null, null];\n};\nwindow.__press = (i, down) => {\n  const buttons = Array.from({length: 17}, (_, k) => ({pressed: k === i && down, touched: k === i && down, value: k === i && down ? 1 : 0}));\n  window.__pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index: 0, connected: true, mapping: 'standard', timestamp: performance.now(), axes: [0, 0, 0, 0], buttons};\n};\n\"\"\"\nok = fail = 0\ndef check(name, cond, detail=''):\n    global ok, fail\n    if cond: ok += 1\n    else:\n        fail += 1\n        print('FAIL', name, str(detail)[:700])\n\ndef boot(pg):\n    t = time.time()\n    while time.time() - t < 180:\n        try:\n            if pg.evaluate(\"()=>window.__engine&&window.__engine.ready===true&&!!window.__game\"): return True\n        except Exception:\n            pass\n        time.sleep(1)\n    return False\n\ngame = lambda pg: pg.evaluate(\"()=>{const g={...window.__game};delete g.setting;return g}\")\nact = lambda pg, name, args=None: pg.evaluate(\"([n,a])=>a?__engine.actions.run(n,a):__engine.actions.run(n)\", [name, args])\n\ndef until(pg, js, secs=20):\n    t = time.time()\n    while time.time() - t < secs:\n        try:\n            if pg.evaluate(js): return True\n        except Exception:\n            pass\n        time.sleep(0.2)\n    return False\n\ndef tap_key(pg, key):\n    pg.keyboard.press(key, delay=120)\n    time.sleep(0.5)\n\ndef tap_pad(pg, i):\n    pg.evaluate(\"(i)=>__press(i,true)\", i)\n    time.sleep(0.5)\n    pg.evaluate(\"(i)=>__press(i,false)\", i)\n    time.sleep(0.5)\n\nSMALL = \"\"\"()=>{const out=[];const w=document.createTreeWalker(document.getElementById('wt'),NodeFilter.SHOW_TEXT);\n while(w.nextNode()){const n=w.currentNode;if(!n.textContent.trim())continue;const e=n.parentElement;if(!e.offsetParent&&getComputedStyle(e).position!=='fixed')continue;const cs=getComputedStyle(e);if(cs.visibility==='hidden'||cs.display==='none')continue;\n const r=e.getBoundingClientRect();if(!r.width)continue;if(parseFloat(cs.fontSize)<27.9)out.push(n.textContent.slice(0,30)+' '+cs.fontSize);}return out}\"\"\"\nROWS = \"()=>Math.max(0,...[...document.querySelectorAll('#wt .wt-menu')].map(m=>m.children.length))\"\n\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=ARGS)\n    ctx = b.new_context(viewport={'width': 1920, 'height': 1080})\n    ctx.add_init_script(PAD)\n    pg = ctx.new_page()\n    logs = []\n    pg.on('console', lambda m: logs.append(m.text) if m.type == 'error' else None)\n    pg.on('pageerror', lambda e: logs.append(str(e)))\n    requests = []\n    pg.on('request', lambda r: requests.append(r.url) if not r.url.startswith(('file:', 'data:', 'blob:')) else None)\n    pg.goto(URL)\n    check('boot', boot(pg))\n    check('no engine errors at boot', pg.evaluate(\"()=>__engine.errors.length===0\"), pg.evaluate(\"()=>JSON.stringify(__engine.errors).slice(0,500)\"))\n    check('no WebGPU downgrade errors', pg.evaluate(\"()=>__engine.info().adapter!==null\"))\n    g = game(pg)\n    check('title first', g['screen'] == 'title', g)\n    check('music at 10% on a fresh save', abs(g['music'] - 0.1) < 1e-6, g)\n    check('session client present and inactive', pg.evaluate(\"()=>window.AIHub&&window.AIHub.active===false\"))\n    check('Math.random untouched outside a session', pg.evaluate(\"()=>/native code/.test(String(Math.random))\"))\n    check('title text at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    check('title menu at most six rows', pg.evaluate(ROWS) <= 6)\n    check('title names the game', 'Wee Tare' in pg.inner_text('[data-ui=title]'))\n    # keyboard and mouse on menus\n    tap_key(pg, 'ArrowDown')\n    check('keys move the focus', game(pg)['focus'] != 'begin', game(pg))\n    check('prompts follow keys', game(pg)['device'] == 'keys')\n    pg.hover('[data-id=settings]')\n    time.sleep(0.5)\n    check('hover moves the focus', game(pg)['focus'] == 'settings', game(pg))\n    pg.click('[data-id=settings]')\n    check('click picks', until(pg, \"()=>__game.screen==='settings'\"), game(pg))\n    check('prompts follow the mouse', until(pg, \"()=>__game.device==='mouse'\", 5), game(pg))\n    check('settings shows music at 10%', '10%' in pg.inner_text('[data-id=music]'))\n    check('settings text at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    check('settings at most six rows', pg.evaluate(ROWS) <= 6)\n    # music persists\n    tap_key(pg, 'ArrowRight')\n    check('music slider moves', until(pg, \"()=>Math.abs(__game.music-0.2)<1e-6\", 5), game(pg))\n    check('volumes kept', '0.2' in pg.evaluate(\"()=>localStorage.getItem('weetare:settings')||JSON.stringify(Object.fromEntries(Object.entries(localStorage)))\"))\n    tap_key(pg, 'ArrowLeft')\n    tap_key(pg, 'Escape')\n    check('Esc goes back', until(pg, \"()=>__game.screen==='title'\"), game(pg))\n    # the pad on menus, glyphs\n    pg.evaluate(\"()=>__press(-1,false)\")\n    tap_pad(pg, 13)\n    check('prompts follow the pad', game(pg)['device'] == 'pad', game(pg))\n    check('D-pad moves the focus', until(pg, \"()=>__game.focus!==''\", 3))\n    check('PlayStation glyphs by default', pg.evaluate(\"()=>getComputedStyle(document.getElementById('wt')).getPropertyValue('--ink')!==''&&document.getElementById('wt').dataset.pad==='ps'\"))\n    pg.keyboard.press('ArrowUp', delay=120)\n    time.sleep(0.3)\n    check('prompts change to keys at a key', game(pg)['device'] == 'keys', game(pg))\n    # About\n    for _ in range(6):\n        if game(pg)['focus'] == 'about': break\n        tap_key(pg, 'ArrowDown')\n    tap_key(pg, 'Enter')\n    check('About opens', until(pg, \"()=>__game.screen==='about'\"), game(pg))\n    seen = ''\n    for _ in range(7):\n        seen += pg.inner_text('[data-ui=about]') + '\\n'\n        check('About text fits a TV', pg.evaluate(\"()=>{const a=document.querySelector('.wt-about');return a.scrollHeight<=a.clientHeight+2}\"), seen[-200:])\n        tap_key(pg, 'ArrowRight')\n    for word in ['Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback', 'Credits', 'Wii Fit', 'PLAN.md', 'added on import', 'Date', 'Genre', 'Perspective', 'Tech', 'Art Direction', 'Animation', 'Audio', 'Online', 'Testing', 'Research', 'Environment', 'Model', 'Usage', 'How many issues', 'What did you like most', 'What would you change', 'my-3dge', '100STYLE']:\n        check('About says ' + word, word in seen)\n    check('no pending answers', 'pending' not in seen)\n    tap_key(pg, 'Escape')\n    until(pg, \"()=>__game.screen==='title'\")\n    # attract: starts by itself, loops, leaves on input, never saves\n    save0 = pg.evaluate(\"()=>localStorage.getItem('weetare:game')\")\n    t0 = time.time()\n    pg.keyboard.press('Shift', delay=50)\n    started = until(pg, \"()=>__game.attract===true\", 16)\n    dt = time.time() - t0\n    check('attract starts near 10 s', started and 9 <= dt <= 14.5, dt)\n    ids = set()\n    for _ in range(4):\n        ids.add(game(pg)['event'])\n        pg.evaluate(\"()=>__engine.step(1500)\")\n        time.sleep(0.4)\n    check('attract shows several activities', len(ids) >= 3, ids)\n    check('attract says DEMO', 'DEMO' in pg.inner_text('[data-ui=attract]'))\n    pg.keyboard.press('KeyA', delay=60)\n    check('a key leaves attract', until(pg, \"()=>__game.attract===false&&__game.screen==='title'\"), game(pg))\n    until(pg, \"()=>__game.attract===true\", 16)\n    pg.mouse.click(30, 30)\n    check('a click leaves attract', until(pg, \"()=>__game.attract===false\"), game(pg))\n    until(pg, \"()=>__game.attract===true\", 16)\n    tap_pad(pg, 0)\n    check('a pad press leaves attract', until(pg, \"()=>__game.attract===false\"), game(pg))\n    pg.evaluate(\"()=>{window.__pad=null}\")\n    check('attract never touches the save', pg.evaluate(\"()=>localStorage.getItem('weetare:game')\") == save0)\n    # begin: the standalone hub test's presses, then the pier, the island\n    until(pg, \"()=>__game.screen==='title'\")\n    tap_key(pg, 'Enter')\n    check('Begin opens the pier', until(pg, \"()=>__game.screen==='wtpier'||document.querySelector('[data-id=look]')!==null\"), game(pg))\n    tap_key(pg, 'ArrowUp')\n    tap_key(pg, 'Enter')\n    check('onto the island', until(pg, \"()=>__game.mode==='roam'&&__game.screen==='roam'\", 15), game(pg))\n    pg.keyboard.press('Tab', delay=120)\n    check('Tab opens the Programme', until(pg, \"()=>__game.screen==='programme'\", 6), game(pg))\n    check('Programme at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    tap_key(pg, 'Escape')\n    # an activity, pause, dev mode\n    act(pg, 'game.start', {'id': 'poseA'})\n    check('an activity runs', until(pg, \"()=>__game.event==='poseA'\"), game(pg))\n    pg.evaluate(\"()=>__engine.step(400)\")\n    time.sleep(1)\n    check('Pose HUD at 10 feet', not pg.evaluate(SMALL), pg.evaluate(SMALL))\n    before = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.ty\")\n    pg.keyboard.down('KeyW')\n    time.sleep(1.2)\n    after = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.ty\")\n    pg.keyboard.up('KeyW')\n    check('W leans', after > before + 0.05, [before, after])\n    pg.mouse.click(960, 300)\n    time.sleep(0.6)\n    locked = pg.evaluate(\"()=>!!document.pointerLockElement\")\n    mx0 = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.mx\")\n    pg.mouse.move(1200, 300, steps=4)\n    time.sleep(0.4)\n    mx1 = pg.evaluate(\"()=>__engine.state('seat').entities[0].wobble.mx\")\n    check('pointer-lock lean moves the CoB', not locked or mx1 != mx0, [locked, mx0, mx1])\n    pg.keyboard.press('Escape', delay=120)\n    check('Esc pauses', until(pg, \"()=>__game.screen==='pause'\", 8), game(pg))\n    pg.evaluate(\"()=>document.exitPointerLock&&document.exitPointerLock()\")\n    tick = pg.evaluate(\"()=>__engine.info().tick\")\n    time.sleep(1)\n    check('pause stops the sim', pg.evaluate(\"()=>__engine.info().tick\") == tick)\n    check('pause at most six rows', pg.evaluate(ROWS) <= 6)\n    pg.click('[data-id=more]')\n    time.sleep(0.4)\n    pg.click('[data-id=dev]')\n    check('pause reaches Dev Mode', until(pg, \"()=>__game.screen==='dev'\"), game(pg))\n    PATH = 'game.wobble.noise'\n    pg.evaluate(\"\"\"(path)=>{const r=document.querySelector(`input[data-path=\"${path}\"]`)||null;if(!r)return;r.value='7';r.dispatchEvent(new Event('input'))}\"\"\", PATH)\n    if pg.evaluate(\"(p)=>!document.querySelector(`input[data-path=\\\"${p}\\\"]`)\", PATH):\n        for _ in range(8):\n            tap_key(pg, 'ArrowDown')\n            if pg.evaluate(\"(p)=>!!document.querySelector(`input[data-path=\\\"${p}\\\"]`)\", PATH): break\n        pg.evaluate(\"\"\"(path)=>{const r=document.querySelector(`input[data-path=\"${path}\"]`);r.value='7';r.dispatchEvent(new Event('input'))}\"\"\", PATH)\n    time.sleep(0.4)\n    check('a slider changes the setting', pg.evaluate(\"(p)=>__game.setting(p)\", PATH) == 7, pg.evaluate(\"(p)=>__game.setting(p)\", PATH))\n    pg.click('.drow >> nth=0')\n    time.sleep(0.4)\n    check('Reset restores the default', pg.evaluate(\"(p)=>__game.setting(p)\", PATH) == 3.5, pg.evaluate(\"(p)=>__game.setting(p)\", PATH))\n    pg.click('.tab >> nth=1')\n    time.sleep(0.3)\n    pg.click('.drow >> nth=2')\n    check('Jump to Day 3 works', until(pg, \"()=>__game.day===3&&__game.mode==='roam'\"), game(pg))\n    pg.evaluate(\"()=>{if(__engine.info&&__engine.resume)__engine.resume()}\")\n    # the way to the credits, by keys alone from here\n    act(pg, 'game.day', {'day': 5})\n    act(pg, 'game.flags', {'done': ['check', 'group', 'poseC']})\n    act(pg, 'game.start', {'id': 'tilt'})\n    check('the Great Tilt starts', until(pg, \"()=>__game.event==='tilt'\"), game(pg))\n    pg.evaluate(\"()=>__engine.step(200)\")\n    time.sleep(1)\n    act(pg, 'game.finishAt', {'score': 800})\n    check('the last Morning Check follows', until(pg, \"()=>__game.event==='check'\", 10), game(pg))\n    act(pg, 'game.finishAt', {'score': 900})\n    check('then the credits', until(pg, \"()=>__game.screen==='credits'\", 10), game(pg))\n    tap_key(pg, 'Enter')\n    check('then Free Play', until(pg, \"()=>__game.mode==='roam'&&__game.day===6\", 10), game(pg))\n    check('fetches nothing', not requests, requests[:3])\n    check('no console errors', not logs, logs[:3])\n    ctx.close()\n\n    # Erase asks in-game, and volumes survive a reload: a fresh page in a fresh context, keeping storage in it\n    ctx = b.new_context(viewport={'width': 1920, 'height': 1080})\n    pg = ctx.new_page()\n    dialogs = []\n    pg.on('dialog', lambda d: (dialogs.append(d.type), d.dismiss()))\n    pg.goto(URL)\n    boot(pg)\n    pg.click('[data-id=settings]')\n    until(pg, \"()=>__game.screen==='settings'\")\n    tap_key(pg, 'ArrowRight')\n    until(pg, \"()=>Math.abs(__game.music-0.2)<1e-6\", 5)\n    pg.reload()\n    boot(pg)\n    check('volumes persist across a reload', abs(game(pg)['music'] - 0.2) < 1e-6, game(pg))\n    pg.click('[data-id=settings]')\n    time.sleep(0.5)\n    for _ in range(2):\n        pg.click('[data-id^=next]')\n        time.sleep(0.3)\n    pg.click('[data-id=erase]')\n    check('Erase asks in-game', until(pg, \"()=>document.querySelector('[data-id=yes]')!==null\", 5) and not dialogs, dialogs)\n    pg.click('[data-id=yes]')\n    time.sleep(0.5)\n    check('Erase resets music', abs(game(pg)['music'] - 0.1) < 1e-6, game(pg))\n    ctx.close()\n\n    # touch-only\n    phone = dict(p.devices['iPhone 13'])\n    phone.pop('default_browser_type', None)\n    ctx = b.new_context(**phone)\n    pg = ctx.new_page()\n    pg.goto(URL)\n    check('touch boot', boot(pg))\n    check('touch says controller required', until(pg, \"()=>document.body.innerText.includes('Controller or keyboard required')\", 10))\n    check('no touch controls', pg.evaluate(\"()=>document.querySelectorAll('[data-ui^=touch],.touch-stick,.touch-button,.touch-fan').length===0\"))\n    check('touch shows only Settings', pg.evaluate(\"()=>[...document.querySelectorAll('#wt .wt-row')].map(r=>r.dataset.id).join()\") == 'settings')\n    check('attract runs behind it', until(pg, \"()=>__game.attract===true\", 16), game(pg))\n    box = pg.locator('[data-id=settings]').bounding_box()\n    pg.touchscreen.tap(box['x'] + box['width'] / 2, box['y'] + box['height'] / 2)\n    check('a tap opens Settings', until(pg, \"()=>__game.screen==='settings'\", 8), game(pg))\n    ctx.close()\n    b.close()\n\n    # no WebGPU here\n    wk = p.webkit.launch()\n    pg = wk.new_page()\n    pg.goto(URL)\n    time.sleep(3)\n    check('no-WebGPU page is friendly', 'WebGPU' in pg.inner_text('body'), pg.inner_text('body')[:200])\n    wk.close()\nprint(f'RESULT ok {ok} fail {fail}')\nE\necho \"unknown\" >/dev/null; sed -i \"s/const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');/const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');\\n  layer.dataset.ui = 'pier';/\" labs/game/ui/screens/front.ts; sed -i \"s/__game.screen==='wtpier'||document.querySelector('\\[data-id=look\\]')!==null/__game.screen==='pier'/\" labs/game/tools/browser.py\nnpx prettier --write labs/game --log-level warn 2>&1 | tail -3 | cut -c1-160; npx eslint labs/game 2>&1 | grep -E \"^\\S|error\" | head -24 | cut -c1-200; wc -l labs/game/*/*.ts labs/game/*.ts labs/game/*/*/*.ts | sort -rn | sed -n 1,8p | cut -c1-60; out/t/b.sh; (timeout 580 python3 -u labs/game/tools/browser.py \"$PWD/../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html\" > out/t/browser.log 2>&1; echo finished >> out/t/browser.log) ; tail -40 out/t/browser.log | cut -c1-500","description":"Write verify and browser tests, format, lint, run browser stage","timeout":600000}}}
