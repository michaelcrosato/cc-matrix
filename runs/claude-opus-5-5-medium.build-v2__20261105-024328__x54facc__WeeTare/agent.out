{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbzuukGkU774myw73VZ","type":"message","role":"assistant","content":[{"type":"text","text":"Status: the sim and balance tests run. Now I'm writing the page side: materials, looks, bodies, camera and sound."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6277,"cache_read_input_tokens":330880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6277},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"a6daf6e0-c190-4d8e-89c9-ea86ca353017","timestamp":"2026-11-05T10:13:49.673Z","request_id":"req_011Cgjbzub9VzjD9Zzt1ZUNz"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbzuukGkU774myw73VZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NgVjcnzEQGjsohUQ68gBqW","name":"Bash","input":{"command":"cat > labs/game/materials/index.ts <<'E'\n/**\n * @file The retreat's materials as data: clinical white, mint, sand, lawn, sea, coral. Page-side, as materials are.\n */\nimport { defineMaterial } from '../../../engine';\n\nconst flat = (id: string, description: string, color: string, more: object = {}) =>\n  defineMaterial(`material:${id}`, { description, color, roughness: 0.8, ...more } as never);\n\nflat('retreatWhite', 'Clinical white.', '#f7fafc');\nflat('retreatMint', 'Mint trim.', '#bfead6');\nflat('retreatCoral', 'Coral: prompts, buoys, focus.', '#ff8a70');\nflat('retreatMat', 'A class mat.', '#ffffff');\nflat('retreatStone', 'Pale stone.', '#c9d2d6', { map: { texture: 'texture:stone', seed: 3 } });\nflat('retreatBrass', 'Brass, polished by someone who is paid to.', '#d8b45a', { metalness: 0.6, roughness: 0.4 });\nflat('retreatWood', 'Pale decking.', '#d9bd92', { map: { texture: 'texture:planks', seed: 4 } });\nflat('retreatCurtain', 'A pale curtain.', '#e8f4f0', { side: 'double' });\nflat('retreatMirror', 'A mirror wall, very clean.', '#cfe6f2', { metalness: 0.7, roughness: 0.15 });\nflat('retreatLamp', 'A lighthouse lamp.', '#fff4c8', { emissive: '#fff0a8', emissiveIntensity: 1.6 });\nflat('retreatPalm', 'A tidy frond.', '#6fbf73');\nflat('retreatMarble', 'A marble.', '#3a6fd8', { roughness: 0.2 });\nflat('retreatDrink', 'A drink.', '#ffb45a', { transparent: true, opacity: 0.85 });\nflat('retreatPond', 'Still Pond.', '#7fcfd8', { roughness: 0.12, transparent: true, opacity: 0.86 });\nflat('retreatSand', 'Sand.', '#f4e8c8', { map: { texture: 'texture:dirt', seed: 5, params: { base: '#f4e8c8' } } });\nflat('retreatLawn', 'Lawn, mown by someone who worries.', '#a9d98a', { map: { texture: 'texture:grass', seed: 6 } });\nflat('retreatSea', 'The sea.', '#ffffff', { map: { texture: 'texture:water', seed: 2, params: { base: '#6fd0e8' } }, roughness: 0.2 });\nE\ncat > labs/game/looks/index.ts <<'E'\n/**\n * @file The picture: high-key brochure daylight (`look:retreat`), its skies by time and mood, and the storm's drained\n * `look:storm`. The skies start from `sky:noon`'s numbers, with its mountains gone: only sea to every horizon.\n */\nimport { defineLook, defineSky } from '../../../engine';\n\nconst fog = { color: '#d4ecf8', start: 200, end: 900, amount: 0.4, floor: 0, ceiling: 1.5, height: 0 };\n\ndefineSky('sky:retreat', {\n  description: 'A brochure noon over an empty sea.',\n  background: '#bfe9ff', pointLights: 1,\n  dome: { show: true, turbidity: 2, rayleigh: 1, mieCoefficient: 0.005, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#fff4e0', intensity: 2.8, azimuth: 0.4, elevation: 0.95 },\n  ambient: { sky: '#d8e6ff', ground: '#c8c0a8', intensity: 1.9 },\n  fog,\n} as never); // prettier-ignore\ndefineSky('sky:retreatDawn', {\n  description: 'First light, after everything.',\n  background: '#ffd9c8', pointLights: 1,\n  dome: { show: true, turbidity: 3, rayleigh: 2, mieCoefficient: 0.006, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#ffc8a0', intensity: 2, azimuth: 1.5, elevation: 0.18 },\n  ambient: { sky: '#ffdcd0', ground: '#a89c98', intensity: 1.6 },\n  fog: { ...fog, color: '#ffe0d0' },\n} as never); // prettier-ignore\ndefineSky('sky:retreatDusk', {\n  description: 'An evening that has been told to be pleasant.',\n  background: '#f3b9a6', pointLights: 1,\n  dome: { show: true, turbidity: 4, rayleigh: 2.4, mieCoefficient: 0.006, mieDirectionalG: 0.8, exposure: 0.45 },\n  sun: { color: '#ffb080', intensity: 1.6, azimuth: -1.4, elevation: 0.14 },\n  ambient: { sky: '#d0b8d8', ground: '#8a7c80', intensity: 1.4 },\n  fog: { ...fog, color: '#f0c8c0' },\n} as never); // prettier-ignore\ndefineSky('sky:storm', {\n  description: 'The storm. Please remain calm.',\n  background: '#46545e', pointLights: 1,\n  dome: { show: false, turbidity: 8, rayleigh: 1, mieCoefficient: 0.01, mieDirectionalG: 0.7, exposure: 0.3 },\n  sun: { color: '#a8bcc8', intensity: 0.9, azimuth: 0.4, elevation: 0.7 },\n  ambient: { sky: '#68788a', ground: '#3a4048', intensity: 1.2 },\n  fog: { color: '#56646e', start: 40, end: 420, amount: 0.75, floor: 0, ceiling: 1.5, height: 0 },\n} as never); // prettier-ignore\n\nconst FILTERS = {\n  bloom: { scope: 'all', strength: 0.35, threshold: 0.92 },\n  grade: { scope: 'all', brightness: 1.08, saturation: 0.92, lift: 0.03 },\n  outline: { scope: 'characters+objects', width: 1, darken: 0.25 },\n};\n\ndefineLook('look:retreat', { description: 'High-key brochure daylight: soft toon light, a little bloom, a thin ink line on people and things.', sky: 'sky:retreat', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:dawn', { description: 'The same, at first light.', sky: 'sky:retreatDawn', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:dusk', { description: 'The same, at the day’s end.', sky: 'sky:retreatDusk', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:storm', {\n  description: 'The storm: the colour drained.',\n  sky: 'sky:storm', style: 'toon',\n  filters: { grade: { scope: 'all', brightness: 0.92, saturation: 0.45, lift: 0.01 }, outline: { scope: 'characters+objects', width: 1, darken: 0.4 } },\n} as never); // prettier-ignore\nE\ncat > labs/game/bodies/index.ts <<'E'\n/**\n * @file The cast as puppet bodies, on the humanoid's bones. No two look alike: Plumb's mint tracksuit and closed-eye arcs, one\n * long plait; Gerald's immense calves; Tare a dial on a drum with stubby legs. Guests come in three looks and six colours.\n */\nimport { defineBody } from '../../../engine';\n\ntype Slots = Record<string, string>;\n\nconst eyeArc = (slot: string) => [['box', ['off', 'head', -0.05, 0.14, 0.17], ['off', 'head', -0.02, 0.14, 0.17], 0.018, 0.01, slot], ['box', ['off', 'head', 0.02, 0.14, 0.17], ['off', 'head', 0.05, 0.14, 0.17], 0.018, 0.01, slot]];\nvoid eyeArc;\n\n/** A person's parts: slots skin, suit, trim, hair, eye. */\nfunction person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true): object {\n  return {\n    slots,\n    parts: [\n      ['limb', 'thighL', 'thighR', [1.2, 'limb'], [1.2, 'limb'], 'suit', { on: 'pelvis' }],\n      ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [torso * 0.82, 'torso'], [torso, 'torso'], 'suit', { on: 'spine1' }],\n      ['limb', 'chest', 'neck', [torso, 'torso'], [0.7, 'torso'], 'suit'],\n      ['limb', 'upperArmL', 'upperArmR', [1.1, 'limb'], [1.1, 'limb'], 'suit', { on: 'chest' }],\n      ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n      ...(hair ? [['ball', ['off', 'head', 0, -0.03, [1.15, 'head']], [0.82, 'head'], 'hair']] : []),\n      ...extra,\n    ],\n    mirror: [\n      ['limb', 'thighL', 'shinL', [1.3, 'limb'], [1.1 * calf, 'limb'], 'suit'],\n      ['limb', 'shinL', 'footL', [1.1 * calf, 'limb'], [1, 'limb'], 'skin'],\n      ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'trim'],\n      ['limb', 'upperArmL', 'forearmL', [1.05, 'limb'], [0.95, 'limb'], 'suit'],\n      ['limb', 'forearmL', 'handL', [0.95, 'limb'], [0.85, 'limb'], 'skin'],\n      ['eye', 'eyeL', [0.12, 'head'], 'eye'],\n    ],\n  };\n}\n\nconst LOOKS: readonly Slots[] = [\n  { skin: '#e8b48c', hair: '#3a2a20', eye: '#14181c', trim: '#f7fafc' },\n  { skin: '#8d5a3c', hair: '#14100c', eye: '#101014', trim: '#f7fafc' },\n  { skin: '#f3d2b8', hair: '#c2803c', eye: '#14181c', trim: '#f7fafc' },\n];\n\n/** The tracksuits: the first two free, the rest earned at the cairn. */\nexport const TRACKSUITS = ['#ff8a70', '#6aa8e8', '#8fd694', '#f0c04a', '#b48ae0', '#3a4a55'] as const;\n\nLOOKS.forEach((look, l) =>\n  TRACKSUITS.forEach((suit, c) => defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never)),\n);\n['#e8443a', '#3b82f6', '#22c55e', '#f5b700'].forEach((suit, i) =>\n  defineBody(`body:seat${i}`, { description: `A session seat in its colour.`, ...person({ ...LOOKS[i % 3], suit }) } as never),\n);\n\ndefineBody('body:plumb', {\n  description: 'Instructor Plumb: tall, narrow, utterly vertical. Mint tracksuit. Eyes closed in two calm arcs.',\n  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6),\n} as never);\ndefineBody('body:gerald', {\n  description: 'Gerald: a retired guest with immense calves. Always already there, always finished.',\n  ...person({ skin: '#e0b090', suit: '#7a8ea0', trim: '#f7fafc', hair: '#e8e8e8', eye: '#14181c' }, [], 2.3, 0.9),\n} as never);\ndefineBody('body:bex', {\n  description: 'Bex: bored, sent here by a parent, holding a phone-shaped stone.',\n  ...person({ skin: '#c89070', suit: '#3a3a4a', trim: '#ff8a70', hair: '#201018', eye: '#101014' }, [['box', 'handR', ['off', 'handR', 0, 0.04, 0.12], 0.1, 0.03, 'trim']]),\n} as never);\ndefineBody('body:nan', {\n  description: 'Old Nan: 91, Wobble Age 19. Nobody has seen her arrive.',\n  ...person({ skin: '#ecd0bc', suit: '#d8a8c8', trim: '#f7fafc', hair: '#f4f4f4', eye: '#14181c' }, [], 0.9, 0.75),\n} as never);\ndefineBody('body:tare', {\n  description: 'Tare: a squat round dial on two stubby legs, face in the dial. Retired from weighing.',\n  slots: { body: '#f7fafc', dial: '#fff8d8', needle: '#ff5a4a', leg: '#a8b4bc', eye: '#14181c' },\n  parts: [\n    ['ball', ['off', 'spine1', 0, 0, 0.08], 0.33, 'body'],\n    ['ball', ['off', 'spine1', 0, 0.2, 0.1], 0.2, 'dial'],\n    ['box', ['off', 'spine1', 0, 0.38, 0.1], ['off', 'spine1', 0, 0.38, 0.27], 0.03, 0.03, 'needle'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', 0.05, 0.05, 'leg'],\n    ['limb', 'shinL', 'footL', 0.05, 0.05, 'leg'],\n    ['limb', 'footL', 'toeL', 0.06, 0.05, 'leg'],\n  ],\n} as never);\n['#a0c8d8', '#e0b8a0', '#c8c8a0'].forEach((suit, i) =>\n  defineBody(`body:extra${i}`, { description: 'Another guest, on the next mat.', ...person({ ...LOOKS[(i + 1) % 3], suit }) } as never),\n);\nE\ncat > labs/game/emitters/index.ts <<'E'\n/**\n * @file The effects, as data: ripples, splashes, dust, the calm wave, sparkles, feathers, confetti, rain and spray. Each\n * fires on a sim event or from a page's `frame.emit`.\n */\nimport { defineEmitter } from '../../../engine';\n\nconst em = (name: string, spec: object) => defineEmitter(`emitter:${name}`, spec as never);\n\nem('wtRipple', { description: 'A ring on still water.', area: [0.6, 0.02, 0.6], velocity: [0, 0.05, 0], spread: 1, gravity: 0, drag: 2, life: [0.5, 1.1], size: [0.18, 0.5], color: ['#ffffff', '#bfe9ff'], brightness: [1.2, 1], alpha: [0.7, 0], count: 22, events: ['wtRipple'] });\nem('wtSplash', { description: 'A small splash.', area: [0.4, 0.05, 0.4], velocity: [0, 3.5, 0], spread: 0.6, gravity: -9, drag: 0.4, life: [0.4, 0.8], size: [0.14, 0.03], color: ['#ffffff', '#6fd0e8'], brightness: [1.3, 1], alpha: [0.9, 0], count: 30, events: ['wtSplash'] });\nem('wtSplashBig', { description: 'A huge splash.', area: [1, 0.1, 1], velocity: [0, 8, 0], spread: 0.6, gravity: -9, drag: 0.3, life: [0.7, 1.5], size: [0.28, 0.05], color: ['#ffffff', '#6fd0e8'], brightness: [1.4, 1], alpha: [0.95, 0], count: 90, events: ['wtSplashBig'] });\nem('wtDust', { description: 'Pebble clack dust.', area: [0.2, 0.02, 0.2], velocity: [0, 0.4, 0], spread: 1, gravity: -0.4, drag: 1.5, life: [0.3, 0.7], size: [0.08, 0.14], color: ['#e8e1cf', '#c8c0a8'], brightness: [1, 1], alpha: [0.7, 0], count: 10, events: ['wtDust'] });\nem('wtCalm', { description: 'A calm wave going out from your hands.', area: [1, 0.05, 1], velocity: [0, 0.2, 0], spread: 1, gravity: 0, drag: 0.2, life: [0.8, 1.3], size: [0.5, 0.9], color: ['#bfead6', '#ffffff'], brightness: [1.6, 1], alpha: [0.5, 0], count: 60, events: ['wtCalm'] });\nem('wtSparkle', { description: 'A sparkle on a stamp.', area: [0.5, 0.5, 0.5], velocity: [0, 0.6, 0], spread: 1, gravity: 0.2, drag: 0.8, life: [0.4, 0.9], size: [0.07, 0], color: ['#fff4c8', '#ff8a70'], brightness: [2, 1], alpha: [1, 0], count: 20, events: ['wtSparkle'] });\nem('wtFeathers', { description: 'Seagull feathers.', area: [0.3, 0.2, 0.3], velocity: [0, 0.8, 0], spread: 1, gravity: -0.6, drag: 1.5, turbulence: 2, life: [0.8, 1.6], size: [0.08, 0.05], color: ['#ffffff', '#d8dee2'], brightness: [1.1, 1], alpha: [0.9, 0], count: 12, events: ['wtFeathers'] });\nem('wtRain', { description: 'The storm’s rain.', area: [26, 0.1, 26], velocity: [1.5, -22, 0], spread: 0.02, gravity: 0, drag: 0, life: [0.8, 1.1], size: [0.035, 0.035], color: ['#c8d8e4', '#a8bcc8'], brightness: [1, 1], alpha: [0.6, 0.5], rate: 500 });\nem('wtSpray', { description: 'Spray in the storm.', area: [30, 0.3, 30], velocity: [3, 0.8, 0], spread: 0.3, gravity: -2, drag: 0.6, life: [0.8, 1.8], size: [0.2, 0.5], color: ['#ffffff', '#a8bcc8'], brightness: [1, 1], alpha: [0.35, 0], rate: 70 });\nE\ncat > labs/game/cameras/stage.ts <<'E'\n/**\n * @file The camera mode `cam3=stage`: whatever `ui/shots.ts` says this frame. Every activity's camera is a shot it computes\n * from the sim: where to stand, what to look at, how wide and how far to bank. This module holds that one shot and eases\n * toward it, so cuts can be soft, and hands out a checked pose. View state only.\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\nexport interface Shot {\n  at: [number, number, number];\n  look: [number, number, number];\n  fov: number;\n  roll: number;\n  /** Ease time, real seconds; 0 cuts. */\n  lag: number;\n}\n\n/** The shot the page wants now. */\nexport const SHOT: Shot = { at: [0, 30, 60], look: [0, 6, 0], fov: 50, roll: 0, lag: 0.5 };\n\ninterface State { at: [number, number, number]; look: [number, number, number]; fov: number; roll: number }\n\nconst ease = (from: number, to: number, k: number) => from + (to - from) * k;\n\nfunction step(state: State, _input: CameraInput, dt: number): State {\n  const k = SHOT.lag <= 0 ? 1 : 1 - Math.exp(-dt / SHOT.lag);\n  return {\n    at: [0, 1, 2].map((i) => ease(state.at[i], SHOT.at[i], k)) as State['at'],\n    look: [0, 1, 2].map((i) => ease(state.look[i], SHOT.look[i], k)) as State['look'],\n    fov: ease(state.fov, SHOT.fov, k),\n    roll: ease(state.roll, SHOT.roll, k),\n  };\n}\n\nfunction pose(state: State): CameraPose {\n  const [dx, dy, dz] = [0, 1, 2].map((i) => state.look[i] - state.at[i]);\n  const flat = Math.hypot(dx, dz) || 1e-6;\n  return makePose({\n    position: state.at,\n    yaw: Math.atan2(dx, dz),\n    pitch: Math.max(-1.55, Math.min(1.55, Math.atan2(dy, flat))),\n    roll: state.roll,\n    fov: state.fov,\n    far: 3000,\n    distance: Math.hypot(flat, dy),\n  } as never);\n}\n\ndefineCamera('stage', {\n  description: 'The stage camera: the page computes a shot each frame; this eases to it.',\n  create() {\n    return followCamera('stage', { at: [...SHOT.at], look: [...SHOT.look], fov: SHOT.fov, roll: SHOT.roll } as State, {\n      step,\n      pose,\n      spec: () => ({}),\n      code: () => 'cam3=stage',\n      describe: () => 'stage: wherever the shot says',\n    });\n  },\n} as never);\nE\ncat > labs/game/sounds/songs.ts <<'E'\n/**\n * @file The music, original, in tracker notation: light, slightly over-pleasant lobby music. Mixed so it is fine at 100% and\n * a whisper at the default 10%. Nothing a player needs lives only in the music; Step Class's beat is on the effects bus.\n */\nimport { defineSong } from '../../../engine';\n\nconst SEVENTH = 'C5 - E5 - G5 - B5 - | A4 - C5 - E5 - G5 - | F4 - A4 - C5 - E5 - | G4 - B4 - D5 - F#5 - ';\n\ndefineSong('song:lobby', {\n  bpm: 84,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: SEVENTH },\n    { wave: 'sine', vol: 0.3, notes: 'C3 - - - - - - - | A2 - - - - - - - | F2 - - - - - - - | G2 - - - - - - - ' },\n    { wave: 'square', vol: 0.05, intensity: 0.4, notes: '. . E6 . . . G6 . | . . C6 . . . E6 . | . . A5 . . . C6 . | . . B5 . . . D6 . ' },\n    { wave: 'triangle', vol: 0.12, intensity: 0.7, notes: 'G4 . G4 . B4 . B4 . | E4 . E4 . G4 . G4 . | C4 . C4 . E4 . E4 . | D4 . D4 . F#4 . F#4 . ' },\n  ],\n} as never);\ndefineSong('song:stillness', {\n  bpm: 60,\n  tracks: [\n    { wave: 'sine', vol: 0.3, notes: 'C4 - - - - - - - | G3 - - - - - - - ' },\n    { wave: 'sine', vol: 0.2, notes: 'E4 - - - - - - - | B3 - - - - - - - ' },\n    { wave: 'triangle', vol: 0.1, notes: '. . . . G5 . . . | . . . . D5 . . . ' },\n  ],\n} as never);\ndefineSong('song:water', {\n  bpm: 96,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: 'G4 . B4 D5 . B4 G4 . | A4 . C5 E5 . C5 A4 . | F4 . A4 C5 . A4 F4 . | G4 . B4 D5 - - . . ' },\n    { wave: 'sine', vol: 0.3, notes: 'G2 . . . D3 . . . | A2 . . . E3 . . . | F2 . . . C3 . . . | G2 . . . D3 . . . ' },\n  ],\n} as never);\ndefineSong('song:stepBed', {\n  bpm: 112,\n  tracks: [\n    { wave: 'square', vol: 0.1, notes: 'C4 . C4 C4 . C4 . . | F4 . F4 F4 . F4 . . | G4 . G4 G4 . G4 . . | C4 . C4 C4 . C4 . . ' },\n    { wave: 'triangle', vol: 0.28, notes: 'C3 - . . G2 - . . | F2 - . . C3 - . . | G2 - . . D3 - . . | C3 - . . G2 - . . ' },\n  ],\n} as never);\ndefineSong('song:hoop', {\n  bpm: 100,\n  tracks: [\n    { wave: 'triangle', vol: 0.2, notes: 'D5 . . F#5 . . A5 . | . G5 . . E5 . . C#5 | D5 . . F#5 . . A5 . | . B5 . A5 . F#5 . . ' },\n    { wave: 'sine', vol: 0.3, notes: 'D3 . . A2 . . D3 . | A2 . . E3 . . A2 . | D3 . . A2 . . D3 . | G2 . . A2 . . D3 . ' },\n  ],\n} as never);\ndefineSong('song:tilt', {\n  bpm: 84,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: 'C5 - Eb5 - G5 - Bb5 - | Ab4 - C5 - Eb5 - G5 - | F4 - Ab4 - C5 - Eb5 - | G4 - Bb4 - D5 - F5 - ' },\n    { wave: 'sine', vol: 0.34, notes: 'C3 - - - - - - - | Ab2 - - - - - - - | F2 - - - - - - - | G2 - - - - - - - ' },\n    { wave: 'saw', vol: 0.08, intensity: 0.4, notes: 'C4 - - - C4 - - - | Ab3 - - - Ab3 - - - | F3 - - - F3 - - - | G3 - - - G3 - - - ' },\n    { wave: 'drums', vol: 0.14, intensity: 0.7, notes: 'k . . . k . . . | k . . . k . . . | k . . . k . . . | k . . k k . . . ' },\n  ],\n} as never);\ndefineSong('song:dawn', {\n  bpm: 60,\n  tracks: [\n    { wave: 'triangle', vol: 0.24, notes: 'C5 - E5 - G5 - B5 - | A4 - C5 - E5 - G5 - | F4 - A4 - C5 - E5 - | C5 - - - - - - - ' },\n    { wave: 'sine', vol: 0.2, notes: 'C3 - - - - - - - | A2 - - - - - - - | F2 - - - - - - - | C3 - - - - - - - ' },\n  ],\n} as never);\ndefineSong('song:stamp', {\n  bpm: 132,\n  tracks: [\n    { wave: 'triangle', vol: 0.3, notes: 'C5 E5 G5 C6 - - - - ' },\n    { wave: 'sine', vol: 0.3, notes: 'C3 - - - C3 - - - ' },\n  ],\n} as never);\nE\ncat > labs/game/sounds/sfx.ts <<'E'\n/**\n * @file Every sound effect as data, and the voices' syllable banks: for each speaker, 16 short consonant-then-vowel\n * entries (a saw through two formant filters). No audio files anywhere. `SPEAKERS` holds each voice's character.\n */\nimport { defineSfx } from '../../../engine';\n\nconst fx = (name: string, voices: object | object[], more: object = {}) => defineSfx(`sfx:${name}`, { voices, ...more } as never);\n\nfx('wtCreak', { wave: 'saw', freq: 90, to: 60, dur: 0.22, vol: 0.2, filter: { type: 'bandpass', freq: 700 }, q: 6 }, { variants: 3 });\nfx('wtBreathIn', { wave: 'noise', dur: 0.8, vol: 0.09, attack: 0.3, filter: { type: 'bandpass', freq: 1400 } });\nfx('wtBreathOut', { wave: 'noise', dur: 0.9, vol: 0.08, attack: 0.1, filter: { type: 'bandpass', freq: 800 } });\nfx('wtSqueak', { wave: 'sine', freq: 1200, to: 1700, dur: 0.07, vol: 0.12 }, { variants: 3 });\nfx('wtStamp', [{ wave: 'noise', dur: 0.05, vol: 0.4, filter: { type: 'lowpass', freq: 900 } }, { wave: 'sine', freq: 110, to: 60, dur: 0.14, vol: 0.6 }]);\nfx('wtClack', [{ wave: 'noise', dur: 0.03, vol: 0.3, filter: { type: 'bandpass', freq: 2400 } }, { wave: 'triangle', freq: 880, to: 620, dur: 0.05, vol: 0.25 }], { variants: 4 });\nfx('wtSplash', { wave: 'noise', dur: 0.45, vol: 0.4, filter: { type: 'lowpass', freq: 2400 } });\nfx('wtSplashBig', [{ wave: 'noise', dur: 1.1, vol: 0.6, filter: { type: 'lowpass', freq: 1800 } }, { wave: 'sine', freq: 80, to: 40, dur: 0.5, vol: 0.6 }]);\nfx('wtGull', { wave: 'saw', freq: 1100, to: 620, dur: 0.28, vol: 0.2, vib: { rate: 22, depth: 90 }, filter: { type: 'bandpass', freq: 1600 } }, { variants: 3 });\nfx('wtFrog', { wave: 'square', freq: 120, to: 90, dur: 0.22, vol: 0.2, vib: { rate: 30, depth: 25 }, filter: { type: 'lowpass', freq: 800 } });\nfx('wtRope', { wave: 'saw', freq: 170, to: 130, dur: 0.12, vol: 0.12, filter: { type: 'bandpass', freq: 500 } }, { variants: 3 });\nfx('wtWhoosh', { wave: 'noise', dur: 0.4, vol: 0.2, attack: 0.15, filter: { type: 'bandpass', freq: 1800 } });\nfx('wtClap', { wave: 'noise', dur: 0.06, vol: 0.5, filter: { type: 'bandpass', freq: 1800 } });\nfx('wtKick', { wave: 'sine', freq: 130, to: 45, dur: 0.14, vol: 0.8 });\nfx('wtHat', { wave: 'noise', dur: 0.025, vol: 0.2, filter: { type: 'highpass', freq: 6000 } });\nfx('wtWhistle', { wave: 'sine', freq: 2100, to: 2300, dur: 0.3, vol: 0.2, vib: { rate: 34, depth: 80 } });\nfx('wtHorn', [{ wave: 'saw', freq: 98, dur: 1.5, vol: 0.28, attack: 0.1, filter: { type: 'lowpass', freq: 500 } }, { wave: 'saw', freq: 147, dur: 1.5, vol: 0.2, attack: 0.1, filter: { type: 'lowpass', freq: 600 } }]);\nfx('wtThunder', [{ wave: 'noise', dur: 2.4, vol: 0.5, attack: 0.08, filter: { type: 'lowpass', freq: 240 } }, { wave: 'sine', freq: 55, to: 30, dur: 1.4, vol: 0.5 }]);\nfx('wtGroan', { wave: 'saw', freq: 58, to: 41, dur: 2.2, vol: 0.34, attack: 0.3, filter: { type: 'lowpass', freq: 240 }, vib: { rate: 3, depth: 3 } });\nfx('wtOoh', [{ wave: 'saw', freq: 210, to: 240, dur: 0.6, vol: 0.14, attack: 0.1, filter: { type: 'bandpass', freq: 450 }, q: 5 }, { wave: 'saw', freq: 280, to: 320, dur: 0.6, vol: 0.1, attack: 0.1, filter: { type: 'bandpass', freq: 800 }, q: 5 }]);\nfx('wtDing', { wave: 'sine', freq: 1320, dur: 0.3, vol: 0.2 }, { variants: 3 });\nfx('wtBell', [{ wave: 'sine', freq: 660, dur: 0.9, vol: 0.2 }, { wave: 'sine', freq: 1320, dur: 0.5, vol: 0.08 }]);\nfx('wtMarble', { wave: 'noise', dur: 0.5, vol: 0.09, filter: { type: 'bandpass', freq: 3000 } });\nfx('wtSink', { wave: 'sine', freq: 660, to: 220, dur: 0.22, vol: 0.3 });\nfx('wtSea', { wave: 'noise', dur: 4, vol: 0.14, attack: 1.2, filter: { type: 'lowpass', freq: 800 } }, { bus: 'ambience' });\nfx('wtBirds', { wave: 'sine', freq: 3200, to: 3900, dur: 0.14, vol: 0.05, vib: { rate: 40, depth: 240 } }, { bus: 'ambience', variants: 3 });\nfx('wtWind', { wave: 'noise', dur: 4, vol: 0.2, attack: 1.2, filter: { type: 'bandpass', freq: 500 } }, { bus: 'ambience' });\nfx('wtRain', { wave: 'noise', dur: 3, vol: 0.2, attack: 0.5, filter: { type: 'highpass', freq: 2200 } }, { bus: 'ambience' });\nfx('wtBuzz', { wave: 'square', freq: 120, dur: 0.3, vol: 0.1, vib: { rate: 40, depth: 8 } });\n\n/** Each voice: base pitch, syllable length, character. */\nexport const SPEAKERS = {\n  tare: { base: 260, syllable: 0.06, contour: 1.2, vib: 0, sigh: false, narrow: false },\n  plumb: { base: 135, syllable: 0.11, contour: 0, vib: 0, sigh: false, narrow: false },\n  gerald: { base: 95, syllable: 0.14, contour: 0.3, vib: 0, sigh: false, narrow: false },\n  bex: { base: 210, syllable: 0.08, contour: 0.1, vib: 0, sigh: true, narrow: false },\n  nan: { base: 170, syllable: 0.12, contour: 0.4, vib: 6, sigh: false, narrow: false },\n  pa: { base: 135, syllable: 0.11, contour: 0, vib: 0, sigh: false, narrow: true },\n  plaque: { base: 190, syllable: 0.07, contour: 0.2, vib: 0, sigh: false, narrow: false },\n} as const;\n\nexport type Speaker = keyof typeof SPEAKERS;\n\nconst VOWELS: readonly (readonly [number, number])[] = [[800, 1200], [500, 1900], [300, 2300], [500, 900], [320, 800]];\nconst BANDS = [3200, 2400, 4200, 1600];\n\n/** Bank ids `sfx:vo.<who>.<0-15>`. */\nexport function voiceId(who: Speaker, k: number): string {\n  return `sfx:vo.${who}.${k}`;\n}\n\nfor (const [who, s] of Object.entries(SPEAKERS)) {\n  for (let k = 0; k < 16; k++) {\n    const [f1, f2] = VOWELS[k % VOWELS.length];\n    const q = s.narrow ? 16 : 7;\n    const vib = s.vib ? { vib: { rate: s.vib, depth: s.base * 0.05 } } : {};\n    const dur = s.syllable * 1.15;\n    defineSfx(voiceId(who as Speaker, k), {\n      bus: 'ui',\n      voices: [\n        { wave: 'noise', dur: 0.012 + (k % 3) * 0.006, vol: 0.12, attack: 0.001, filter: { type: 'bandpass', freq: BANDS[k % BANDS.length] } },\n        { wave: 'saw', freq: s.base, to: s.base * 0.92, at: 0.012, dur, vol: 0.5, attack: 0.006, filter: { type: 'bandpass', freq: s.narrow ? 1100 : f1 }, q, ...vib },\n        { wave: 'saw', freq: s.base, to: s.base * 0.92, at: 0.012, dur, vol: 0.35, attack: 0.006, filter: { type: 'bandpass', freq: s.narrow ? 1400 : f2 }, q: q + 2, ...vib },\n      ],\n    } as never);\n  }\n}\nE\ncat > labs/game/audio/voice.ts <<'E'\n/**\n * @file Animalese: `say(speaker, text)` babbles a line. One syllable per two letters, hashed from the letters so the same line\n * always babbles the same way; the pitch rises on \"?\" and falls on \".\"; spaces are silence, punctuation longer. Text\n * always stays on screen too, so nothing needs the voice.\n */\nimport type { Audio } from '../../../engine';\nimport { SPEAKERS, voiceId, type Speaker } from '../sounds/sfx';\n\n/** Plays a line now; returns its length, seconds. */\nexport function babble(audio: Audio, who: Speaker, text: string, level: number): number {\n  const s = SPEAKERS[who] ?? SPEAKERS.tare;\n  const context = audio.context;\n  if (!context) return 0;\n  const start = context.currentTime + 0.02;\n  let at = 0;\n  const rising = text.trim().endsWith('?');\n  const count = Math.ceil(text.length / 2);\n  for (let i = 0; i < text.length; i += 2) {\n    const pair = text.slice(i, i + 2);\n    const code = (pair.charCodeAt(0) * 31 + (pair.charCodeAt(1) || 7)) & 0xffff;\n    if (/^[\\s]+$/.test(pair)) {\n      at += s.syllable * 0.6;\n      continue;\n    }\n    const k = i / 2 / Math.max(1, count - 1);\n    const contour = (rising ? 0.3 * Math.pow(k, 3) : -0.18 * Math.pow(k, 3)) * s.contour + Math.sin(i * 1.1) * 0.04 * s.contour;\n    const sigh = s.sigh && k > 0.8 ? -0.15 : 0;\n    audio.play(voiceId(who, code % 16), {\n      pitch: 1 + contour + sigh + ((code % 5) - 2) * 0.012 * s.contour,\n      when: start + at,\n      vol: level,\n      bus: 'ui',\n      duck: true,\n    } as never);\n    at += s.syllable;\n    if (/[.,!?]/.test(pair)) at += s.syllable * 2.2;\n  }\n  return at;\n}\nE\ncat > labs/game/audio/sound.ts <<'E'\n/**\n * @file The page's sound: the audio runtime with music at 10% by default, the songs by activity, the sim's `cue` and other\n * events mapped to effects, ambience by place, and the Voices slider. Started by the first gesture, as the runtime does.\n */\nimport { createAudio, type Audio } from '../../../engine';\nimport '../sounds/songs';\nimport '../sounds/sfx';\nimport { babble } from './voice';\nimport type { Speaker } from '../sounds/sfx';\n\n/** What a cue plays. */\nconst CUES: Readonly<Record<string, string>> = {\n  creak: 'sfx:wtCreak', bell: 'sfx:wtBell', stamp: 'sfx:wtStamp', ding: 'sfx:wtDing', whistle: 'sfx:wtWhistle',\n  repGood: 'sfx:wtSqueak', repMiss: 'sfx:wtCreak', gullLand: 'sfx:wtGull', gullOff: 'sfx:wtGull', rope: 'sfx:wtRope',\n  stumble: 'sfx:wtCreak', splash: 'sfx:wtSplash', splashBig: 'sfx:wtSplashBig', paddle: 'sfx:wtSqueak', horn: 'sfx:wtHorn',\n  turtle: 'sfx:wtFrog', marbleSink: 'sfx:wtSink', marbleLost: 'sfx:wtWhoosh', whoosh: 'sfx:wtWhoosh', hoopDrop: 'sfx:wtClack',\n  hoopWhoosh: 'sfx:wtWhoosh', hoopCatch: 'sfx:wtDing', hoopWarn: 'sfx:wtWhistle', pace: 'sfx:wtSqueak', calmWave: 'sfx:wtOoh',\n  crank: 'sfx:wtRope', groan: 'sfx:wtGroan', thunder: 'sfx:wtThunder', tick: 'sfx:wtClack', pebble: 'sfx:wtClack',\n  gust: 'sfx:wtWhoosh', gustWarn: 'sfx:wtWhistle', stampJingle: 'sfx:wtStamp',\n}; // prettier-ignore\n\nexport interface Sound {\n  readonly audio: Audio;\n  /** Plays a cue by name. */\n  cue(name: string, extra?: Record<string, unknown>): void;\n  /** Plays a sim event by type. */\n  event(type: string): void;\n  /** Babbles a line at the Voices level. */\n  say(who: string, text: string): number;\n  /** Changes the song; '' silence. */\n  song(id: string): void;\n  /** Sets the ambience: sea, wind, rain. */\n  ambience(storm: number): void;\n  voices: number;\n  stop(): void;\n}\n\n/** Makes the sound. `volumes` is what the save holds. */\nexport function createSound(volumes: { music: number; effects: number; voices: number }): Sound {\n  const audio = createAudio();\n  audio.volume('music', volumes.music);\n  audio.volume('effects', volumes.effects);\n  audio.volume('ui', 1);\n  let current = '';\n  let last = 0;\n  let stormOn = false;\n  const self: Sound = {\n    audio,\n    voices: volumes.voices,\n    cue(name) {\n      const id = CUES[name];\n      if (id) audio.play(id);\n    },\n    event(type) {\n      if (type === 'beat') {\n        audio.play('sfx:wtClap', { vol: 0.8 } as never);\n        audio.play('sfx:wtKick');\n      } else if (type === 'topple') audio.play('sfx:wtCreak');\n      else if (type === 'clack') audio.play('sfx:wtClack');\n      else if (type === 'moved') audio.play('sfx:wtFrog');\n      else if (type === 'results') audio.stinger?.('song:stamp', { vol: 1 } as never);\n    },\n    say(who, text) {\n      return babble(audio, who as Speaker, text, self.voices);\n    },\n    song(id) {\n      if (id === current) return;\n      current = id;\n      audio.music(id || null, { intensity: 0.2 } as never);\n    },\n    ambience(storm) {\n      const now = performance.now() / 1000;\n      if (now - last < 3.4) return;\n      last = now;\n      audio.play(storm > 0.3 ? 'sfx:wtWind' : 'sfx:wtSea');\n      if (storm > 0.3) audio.play('sfx:wtRain');\n      else if (Math.random() < 0.3) audio.play('sfx:wtBirds');\n      stormOn = storm > 0.3;\n      void stormOn;\n    },\n    stop() {\n      audio.music(null);\n      void audio.close();\n    },\n  };\n  return self;\n}\nE\ngrep -n \"Math.random\" engine/audio/runtime/*.ts | head -3 | cut -c1-100; grep -n \"when\\|pitch\" engine/audio/runtime/audio.ts | head -8 | cut -c1-120;grep -n \"createDialog\" engine/ui/*.ts | head -2 | cut -c1-100; sed -n 40,60p engine/input/bindings.ts | head -0; WT_SEEDS=2 WT_ONLY=reps,plunge timeout 200 npx vitest run labs/game/scenes/balance.test.ts -t \"meets\" 2>&1 | grep -E \"Error:\" | cut -c1-160 | head -4; cat out/balance.json | tr -d '\\n ' | cut -c1-500","description":"Write page assets: materials, looks, bodies, emitters, camera, audio","timeout":280000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6277,"cache_read_input_tokens":330880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6277},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"92b4c7b1-5b90-416e-8e79-2a88c8817c39","timestamp":"2026-11-05T10:15:51.636Z","request_id":"req_011Cgjbzub9VzjD9Zzt1ZUNz","wire_tool_inputs":{"toolu_01NgVjcnzEQGjsohUQ68gBqW":{"command":"cat > labs/game/materials/index.ts <<'E'\n/**\n * @file The retreat's materials as data: clinical white, mint, sand, lawn, sea, coral. Page-side, as materials are.\n */\nimport { defineMaterial } from '../../../engine';\n\nconst flat = (id: string, description: string, color: string, more: object = {}) =>\n  defineMaterial(`material:${id}`, { description, color, roughness: 0.8, ...more } as never);\n\nflat('retreatWhite', 'Clinical white.', '#f7fafc');\nflat('retreatMint', 'Mint trim.', '#bfead6');\nflat('retreatCoral', 'Coral: prompts, buoys, focus.', '#ff8a70');\nflat('retreatMat', 'A class mat.', '#ffffff');\nflat('retreatStone', 'Pale stone.', '#c9d2d6', { map: { texture: 'texture:stone', seed: 3 } });\nflat('retreatBrass', 'Brass, polished by someone who is paid to.', '#d8b45a', { metalness: 0.6, roughness: 0.4 });\nflat('retreatWood', 'Pale decking.', '#d9bd92', { map: { texture: 'texture:planks', seed: 4 } });\nflat('retreatCurtain', 'A pale curtain.', '#e8f4f0', { side: 'double' });\nflat('retreatMirror', 'A mirror wall, very clean.', '#cfe6f2', { metalness: 0.7, roughness: 0.15 });\nflat('retreatLamp', 'A lighthouse lamp.', '#fff4c8', { emissive: '#fff0a8', emissiveIntensity: 1.6 });\nflat('retreatPalm', 'A tidy frond.', '#6fbf73');\nflat('retreatMarble', 'A marble.', '#3a6fd8', { roughness: 0.2 });\nflat('retreatDrink', 'A drink.', '#ffb45a', { transparent: true, opacity: 0.85 });\nflat('retreatPond', 'Still Pond.', '#7fcfd8', { roughness: 0.12, transparent: true, opacity: 0.86 });\nflat('retreatSand', 'Sand.', '#f4e8c8', { map: { texture: 'texture:dirt', seed: 5, params: { base: '#f4e8c8' } } });\nflat('retreatLawn', 'Lawn, mown by someone who worries.', '#a9d98a', { map: { texture: 'texture:grass', seed: 6 } });\nflat('retreatSea', 'The sea.', '#ffffff', { map: { texture: 'texture:water', seed: 2, params: { base: '#6fd0e8' } }, roughness: 0.2 });\nE\ncat > labs/game/looks/index.ts <<'E'\n/**\n * @file The picture: high-key brochure daylight (`look:retreat`), its skies by time and mood, and the storm's drained\n * `look:storm`. The skies start from `sky:noon`'s numbers, with its mountains gone: only sea to every horizon.\n */\nimport { defineLook, defineSky } from '../../../engine';\n\nconst fog = { color: '#d4ecf8', start: 200, end: 900, amount: 0.4, floor: 0, ceiling: 1.5, height: 0 };\n\ndefineSky('sky:retreat', {\n  description: 'A brochure noon over an empty sea.',\n  background: '#bfe9ff', pointLights: 1,\n  dome: { show: true, turbidity: 2, rayleigh: 1, mieCoefficient: 0.005, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#fff4e0', intensity: 2.8, azimuth: 0.4, elevation: 0.95 },\n  ambient: { sky: '#d8e6ff', ground: '#c8c0a8', intensity: 1.9 },\n  fog,\n} as never); // prettier-ignore\ndefineSky('sky:retreatDawn', {\n  description: 'First light, after everything.',\n  background: '#ffd9c8', pointLights: 1,\n  dome: { show: true, turbidity: 3, rayleigh: 2, mieCoefficient: 0.006, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#ffc8a0', intensity: 2, azimuth: 1.5, elevation: 0.18 },\n  ambient: { sky: '#ffdcd0', ground: '#a89c98', intensity: 1.6 },\n  fog: { ...fog, color: '#ffe0d0' },\n} as never); // prettier-ignore\ndefineSky('sky:retreatDusk', {\n  description: 'An evening that has been told to be pleasant.',\n  background: '#f3b9a6', pointLights: 1,\n  dome: { show: true, turbidity: 4, rayleigh: 2.4, mieCoefficient: 0.006, mieDirectionalG: 0.8, exposure: 0.45 },\n  sun: { color: '#ffb080', intensity: 1.6, azimuth: -1.4, elevation: 0.14 },\n  ambient: { sky: '#d0b8d8', ground: '#8a7c80', intensity: 1.4 },\n  fog: { ...fog, color: '#f0c8c0' },\n} as never); // prettier-ignore\ndefineSky('sky:storm', {\n  description: 'The storm. Please remain calm.',\n  background: '#46545e', pointLights: 1,\n  dome: { show: false, turbidity: 8, rayleigh: 1, mieCoefficient: 0.01, mieDirectionalG: 0.7, exposure: 0.3 },\n  sun: { color: '#a8bcc8', intensity: 0.9, azimuth: 0.4, elevation: 0.7 },\n  ambient: { sky: '#68788a', ground: '#3a4048', intensity: 1.2 },\n  fog: { color: '#56646e', start: 40, end: 420, amount: 0.75, floor: 0, ceiling: 1.5, height: 0 },\n} as never); // prettier-ignore\n\nconst FILTERS = {\n  bloom: { scope: 'all', strength: 0.35, threshold: 0.92 },\n  grade: { scope: 'all', brightness: 1.08, saturation: 0.92, lift: 0.03 },\n  outline: { scope: 'characters+objects', width: 1, darken: 0.25 },\n};\n\ndefineLook('look:retreat', { description: 'High-key brochure daylight: soft toon light, a little bloom, a thin ink line on people and things.', sky: 'sky:retreat', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:dawn', { description: 'The same, at first light.', sky: 'sky:retreatDawn', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:dusk', { description: 'The same, at the day\\u2019s end.', sky: 'sky:retreatDusk', style: 'toon', filters: FILTERS } as never);\ndefineLook('look:storm', {\n  description: 'The storm: the colour drained.',\n  sky: 'sky:storm', style: 'toon',\n  filters: { grade: { scope: 'all', brightness: 0.92, saturation: 0.45, lift: 0.01 }, outline: { scope: 'characters+objects', width: 1, darken: 0.4 } },\n} as never); // prettier-ignore\nE\ncat > labs/game/bodies/index.ts <<'E'\n/**\n * @file The cast as puppet bodies, on the humanoid's bones. No two look alike: Plumb's mint tracksuit and closed-eye arcs, one\n * long plait; Gerald's immense calves; Tare a dial on a drum with stubby legs. Guests come in three looks and six colours.\n */\nimport { defineBody } from '../../../engine';\n\ntype Slots = Record<string, string>;\n\nconst eyeArc = (slot: string) => [['box', ['off', 'head', -0.05, 0.14, 0.17], ['off', 'head', -0.02, 0.14, 0.17], 0.018, 0.01, slot], ['box', ['off', 'head', 0.02, 0.14, 0.17], ['off', 'head', 0.05, 0.14, 0.17], 0.018, 0.01, slot]];\nvoid eyeArc;\n\n/** A person's parts: slots skin, suit, trim, hair, eye. */\nfunction person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true): object {\n  return {\n    slots,\n    parts: [\n      ['limb', 'thighL', 'thighR', [1.2, 'limb'], [1.2, 'limb'], 'suit', { on: 'pelvis' }],\n      ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [torso * 0.82, 'torso'], [torso, 'torso'], 'suit', { on: 'spine1' }],\n      ['limb', 'chest', 'neck', [torso, 'torso'], [0.7, 'torso'], 'suit'],\n      ['limb', 'upperArmL', 'upperArmR', [1.1, 'limb'], [1.1, 'limb'], 'suit', { on: 'chest' }],\n      ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n      ...(hair ? [['ball', ['off', 'head', 0, -0.03, [1.15, 'head']], [0.82, 'head'], 'hair']] : []),\n      ...extra,\n    ],\n    mirror: [\n      ['limb', 'thighL', 'shinL', [1.3, 'limb'], [1.1 * calf, 'limb'], 'suit'],\n      ['limb', 'shinL', 'footL', [1.1 * calf, 'limb'], [1, 'limb'], 'skin'],\n      ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'trim'],\n      ['limb', 'upperArmL', 'forearmL', [1.05, 'limb'], [0.95, 'limb'], 'suit'],\n      ['limb', 'forearmL', 'handL', [0.95, 'limb'], [0.85, 'limb'], 'skin'],\n      ['eye', 'eyeL', [0.12, 'head'], 'eye'],\n    ],\n  };\n}\n\nconst LOOKS: readonly Slots[] = [\n  { skin: '#e8b48c', hair: '#3a2a20', eye: '#14181c', trim: '#f7fafc' },\n  { skin: '#8d5a3c', hair: '#14100c', eye: '#101014', trim: '#f7fafc' },\n  { skin: '#f3d2b8', hair: '#c2803c', eye: '#14181c', trim: '#f7fafc' },\n];\n\n/** The tracksuits: the first two free, the rest earned at the cairn. */\nexport const TRACKSUITS = ['#ff8a70', '#6aa8e8', '#8fd694', '#f0c04a', '#b48ae0', '#3a4a55'] as const;\n\nLOOKS.forEach((look, l) =>\n  TRACKSUITS.forEach((suit, c) => defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never)),\n);\n['#e8443a', '#3b82f6', '#22c55e', '#f5b700'].forEach((suit, i) =>\n  defineBody(`body:seat${i}`, { description: `A session seat in its colour.`, ...person({ ...LOOKS[i % 3], suit }) } as never),\n);\n\ndefineBody('body:plumb', {\n  description: 'Instructor Plumb: tall, narrow, utterly vertical. Mint tracksuit. Eyes closed in two calm arcs.',\n  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6),\n} as never);\ndefineBody('body:gerald', {\n  description: 'Gerald: a retired guest with immense calves. Always already there, always finished.',\n  ...person({ skin: '#e0b090', suit: '#7a8ea0', trim: '#f7fafc', hair: '#e8e8e8', eye: '#14181c' }, [], 2.3, 0.9),\n} as never);\ndefineBody('body:bex', {\n  description: 'Bex: bored, sent here by a parent, holding a phone-shaped stone.',\n  ...person({ skin: '#c89070', suit: '#3a3a4a', trim: '#ff8a70', hair: '#201018', eye: '#101014' }, [['box', 'handR', ['off', 'handR', 0, 0.04, 0.12], 0.1, 0.03, 'trim']]),\n} as never);\ndefineBody('body:nan', {\n  description: 'Old Nan: 91, Wobble Age 19. Nobody has seen her arrive.',\n  ...person({ skin: '#ecd0bc', suit: '#d8a8c8', trim: '#f7fafc', hair: '#f4f4f4', eye: '#14181c' }, [], 0.9, 0.75),\n} as never);\ndefineBody('body:tare', {\n  description: 'Tare: a squat round dial on two stubby legs, face in the dial. Retired from weighing.',\n  slots: { body: '#f7fafc', dial: '#fff8d8', needle: '#ff5a4a', leg: '#a8b4bc', eye: '#14181c' },\n  parts: [\n    ['ball', ['off', 'spine1', 0, 0, 0.08], 0.33, 'body'],\n    ['ball', ['off', 'spine1', 0, 0.2, 0.1], 0.2, 'dial'],\n    ['box', ['off', 'spine1', 0, 0.38, 0.1], ['off', 'spine1', 0, 0.38, 0.27], 0.03, 0.03, 'needle'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', 0.05, 0.05, 'leg'],\n    ['limb', 'shinL', 'footL', 0.05, 0.05, 'leg'],\n    ['limb', 'footL', 'toeL', 0.06, 0.05, 'leg'],\n  ],\n} as never);\n['#a0c8d8', '#e0b8a0', '#c8c8a0'].forEach((suit, i) =>\n  defineBody(`body:extra${i}`, { description: 'Another guest, on the next mat.', ...person({ ...LOOKS[(i + 1) % 3], suit }) } as never),\n);\nE\ncat > labs/game/emitters/index.ts <<'E'\n/**\n * @file The effects, as data: ripples, splashes, dust, the calm wave, sparkles, feathers, confetti, rain and spray. Each\n * fires on a sim event or from a page's `frame.emit`.\n */\nimport { defineEmitter } from '../../../engine';\n\nconst em = (name: string, spec: object) => defineEmitter(`emitter:${name}`, spec as never);\n\nem('wtRipple', { description: 'A ring on still water.', area: [0.6, 0.02, 0.6], velocity: [0, 0.05, 0], spread: 1, gravity: 0, drag: 2, life: [0.5, 1.1], size: [0.18, 0.5], color: ['#ffffff', '#bfe9ff'], brightness: [1.2, 1], alpha: [0.7, 0], count: 22, events: ['wtRipple'] });\nem('wtSplash', { description: 'A small splash.', area: [0.4, 0.05, 0.4], velocity: [0, 3.5, 0], spread: 0.6, gravity: -9, drag: 0.4, life: [0.4, 0.8], size: [0.14, 0.03], color: ['#ffffff', '#6fd0e8'], brightness: [1.3, 1], alpha: [0.9, 0], count: 30, events: ['wtSplash'] });\nem('wtSplashBig', { description: 'A huge splash.', area: [1, 0.1, 1], velocity: [0, 8, 0], spread: 0.6, gravity: -9, drag: 0.3, life: [0.7, 1.5], size: [0.28, 0.05], color: ['#ffffff', '#6fd0e8'], brightness: [1.4, 1], alpha: [0.95, 0], count: 90, events: ['wtSplashBig'] });\nem('wtDust', { description: 'Pebble clack dust.', area: [0.2, 0.02, 0.2], velocity: [0, 0.4, 0], spread: 1, gravity: -0.4, drag: 1.5, life: [0.3, 0.7], size: [0.08, 0.14], color: ['#e8e1cf', '#c8c0a8'], brightness: [1, 1], alpha: [0.7, 0], count: 10, events: ['wtDust'] });\nem('wtCalm', { description: 'A calm wave going out from your hands.', area: [1, 0.05, 1], velocity: [0, 0.2, 0], spread: 1, gravity: 0, drag: 0.2, life: [0.8, 1.3], size: [0.5, 0.9], color: ['#bfead6', '#ffffff'], brightness: [1.6, 1], alpha: [0.5, 0], count: 60, events: ['wtCalm'] });\nem('wtSparkle', { description: 'A sparkle on a stamp.', area: [0.5, 0.5, 0.5], velocity: [0, 0.6, 0], spread: 1, gravity: 0.2, drag: 0.8, life: [0.4, 0.9], size: [0.07, 0], color: ['#fff4c8', '#ff8a70'], brightness: [2, 1], alpha: [1, 0], count: 20, events: ['wtSparkle'] });\nem('wtFeathers', { description: 'Seagull feathers.', area: [0.3, 0.2, 0.3], velocity: [0, 0.8, 0], spread: 1, gravity: -0.6, drag: 1.5, turbulence: 2, life: [0.8, 1.6], size: [0.08, 0.05], color: ['#ffffff', '#d8dee2'], brightness: [1.1, 1], alpha: [0.9, 0], count: 12, events: ['wtFeathers'] });\nem('wtRain', { description: 'The storm\\u2019s rain.', area: [26, 0.1, 26], velocity: [1.5, -22, 0], spread: 0.02, gravity: 0, drag: 0, life: [0.8, 1.1], size: [0.035, 0.035], color: ['#c8d8e4', '#a8bcc8'], brightness: [1, 1], alpha: [0.6, 0.5], rate: 500 });\nem('wtSpray', { description: 'Spray in the storm.', area: [30, 0.3, 30], velocity: [3, 0.8, 0], spread: 0.3, gravity: -2, drag: 0.6, life: [0.8, 1.8], size: [0.2, 0.5], color: ['#ffffff', '#a8bcc8'], brightness: [1, 1], alpha: [0.35, 0], rate: 70 });\nE\ncat > labs/game/cameras/stage.ts <<'E'\n/**\n * @file The camera mode `cam3=stage`: whatever `ui/shots.ts` says this frame. Every activity's camera is a shot it computes\n * from the sim: where to stand, what to look at, how wide and how far to bank. This module holds that one shot and eases\n * toward it, so cuts can be soft, and hands out a checked pose. View state only.\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\nexport interface Shot {\n  at: [number, number, number];\n  look: [number, number, number];\n  fov: number;\n  roll: number;\n  /** Ease time, real seconds; 0 cuts. */\n  lag: number;\n}\n\n/** The shot the page wants now. */\nexport const SHOT: Shot = { at: [0, 30, 60], look: [0, 6, 0], fov: 50, roll: 0, lag: 0.5 };\n\ninterface State { at: [number, number, number]; look: [number, number, number]; fov: number; roll: number }\n\nconst ease = (from: number, to: number, k: number) => from + (to - from) * k;\n\nfunction step(state: State, _input: CameraInput, dt: number): State {\n  const k = SHOT.lag <= 0 ? 1 : 1 - Math.exp(-dt / SHOT.lag);\n  return {\n    at: [0, 1, 2].map((i) => ease(state.at[i], SHOT.at[i], k)) as State['at'],\n    look: [0, 1, 2].map((i) => ease(state.look[i], SHOT.look[i], k)) as State['look'],\n    fov: ease(state.fov, SHOT.fov, k),\n    roll: ease(state.roll, SHOT.roll, k),\n  };\n}\n\nfunction pose(state: State): CameraPose {\n  const [dx, dy, dz] = [0, 1, 2].map((i) => state.look[i] - state.at[i]);\n  const flat = Math.hypot(dx, dz) || 1e-6;\n  return makePose({\n    position: state.at,\n    yaw: Math.atan2(dx, dz),\n    pitch: Math.max(-1.55, Math.min(1.55, Math.atan2(dy, flat))),\n    roll: state.roll,\n    fov: state.fov,\n    far: 3000,\n    distance: Math.hypot(flat, dy),\n  } as never);\n}\n\ndefineCamera('stage', {\n  description: 'The stage camera: the page computes a shot each frame; this eases to it.',\n  create() {\n    return followCamera('stage', { at: [...SHOT.at], look: [...SHOT.look], fov: SHOT.fov, roll: SHOT.roll } as State, {\n      step,\n      pose,\n      spec: () => ({}),\n      code: () => 'cam3=stage',\n      describe: () => 'stage: wherever the shot says',\n    });\n  },\n} as never);\nE\ncat > labs/game/sounds/songs.ts <<'E'\n/**\n * @file The music, original, in tracker notation: light, slightly over-pleasant lobby music. Mixed so it is fine at 100% and\n * a whisper at the default 10%. Nothing a player needs lives only in the music; Step Class's beat is on the effects bus.\n */\nimport { defineSong } from '../../../engine';\n\nconst SEVENTH = 'C5 - E5 - G5 - B5 - | A4 - C5 - E5 - G5 - | F4 - A4 - C5 - E5 - | G4 - B4 - D5 - F#5 - ';\n\ndefineSong('song:lobby', {\n  bpm: 84,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: SEVENTH },\n    { wave: 'sine', vol: 0.3, notes: 'C3 - - - - - - - | A2 - - - - - - - | F2 - - - - - - - | G2 - - - - - - - ' },\n    { wave: 'square', vol: 0.05, intensity: 0.4, notes: '. . E6 . . . G6 . | . . C6 . . . E6 . | . . A5 . . . C6 . | . . B5 . . . D6 . ' },\n    { wave: 'triangle', vol: 0.12, intensity: 0.7, notes: 'G4 . G4 . B4 . B4 . | E4 . E4 . G4 . G4 . | C4 . C4 . E4 . E4 . | D4 . D4 . F#4 . F#4 . ' },\n  ],\n} as never);\ndefineSong('song:stillness', {\n  bpm: 60,\n  tracks: [\n    { wave: 'sine', vol: 0.3, notes: 'C4 - - - - - - - | G3 - - - - - - - ' },\n    { wave: 'sine', vol: 0.2, notes: 'E4 - - - - - - - | B3 - - - - - - - ' },\n    { wave: 'triangle', vol: 0.1, notes: '. . . . G5 . . . | . . . . D5 . . . ' },\n  ],\n} as never);\ndefineSong('song:water', {\n  bpm: 96,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: 'G4 . B4 D5 . B4 G4 . | A4 . C5 E5 . C5 A4 . | F4 . A4 C5 . A4 F4 . | G4 . B4 D5 - - . . ' },\n    { wave: 'sine', vol: 0.3, notes: 'G2 . . . D3 . . . | A2 . . . E3 . . . | F2 . . . C3 . . . | G2 . . . D3 . . . ' },\n  ],\n} as never);\ndefineSong('song:stepBed', {\n  bpm: 112,\n  tracks: [\n    { wave: 'square', vol: 0.1, notes: 'C4 . C4 C4 . C4 . . | F4 . F4 F4 . F4 . . | G4 . G4 G4 . G4 . . | C4 . C4 C4 . C4 . . ' },\n    { wave: 'triangle', vol: 0.28, notes: 'C3 - . . G2 - . . | F2 - . . C3 - . . | G2 - . . D3 - . . | C3 - . . G2 - . . ' },\n  ],\n} as never);\ndefineSong('song:hoop', {\n  bpm: 100,\n  tracks: [\n    { wave: 'triangle', vol: 0.2, notes: 'D5 . . F#5 . . A5 . | . G5 . . E5 . . C#5 | D5 . . F#5 . . A5 . | . B5 . A5 . F#5 . . ' },\n    { wave: 'sine', vol: 0.3, notes: 'D3 . . A2 . . D3 . | A2 . . E3 . . A2 . | D3 . . A2 . . D3 . | G2 . . A2 . . D3 . ' },\n  ],\n} as never);\ndefineSong('song:tilt', {\n  bpm: 84,\n  tracks: [\n    { wave: 'triangle', vol: 0.22, notes: 'C5 - Eb5 - G5 - Bb5 - | Ab4 - C5 - Eb5 - G5 - | F4 - Ab4 - C5 - Eb5 - | G4 - Bb4 - D5 - F5 - ' },\n    { wave: 'sine', vol: 0.34, notes: 'C3 - - - - - - - | Ab2 - - - - - - - | F2 - - - - - - - | G2 - - - - - - - ' },\n    { wave: 'saw', vol: 0.08, intensity: 0.4, notes: 'C4 - - - C4 - - - | Ab3 - - - Ab3 - - - | F3 - - - F3 - - - | G3 - - - G3 - - - ' },\n    { wave: 'drums', vol: 0.14, intensity: 0.7, notes: 'k . . . k . . . | k . . . k . . . | k . . . k . . . | k . . k k . . . ' },\n  ],\n} as never);\ndefineSong('song:dawn', {\n  bpm: 60,\n  tracks: [\n    { wave: 'triangle', vol: 0.24, notes: 'C5 - E5 - G5 - B5 - | A4 - C5 - E5 - G5 - | F4 - A4 - C5 - E5 - | C5 - - - - - - - ' },\n    { wave: 'sine', vol: 0.2, notes: 'C3 - - - - - - - | A2 - - - - - - - | F2 - - - - - - - | C3 - - - - - - - ' },\n  ],\n} as never);\ndefineSong('song:stamp', {\n  bpm: 132,\n  tracks: [\n    { wave: 'triangle', vol: 0.3, notes: 'C5 E5 G5 C6 - - - - ' },\n    { wave: 'sine', vol: 0.3, notes: 'C3 - - - C3 - - - ' },\n  ],\n} as never);\nE\ncat > labs/game/sounds/sfx.ts <<'E'\n/**\n * @file Every sound effect as data, and the voices' syllable banks: for each speaker, 16 short consonant-then-vowel\n * entries (a saw through two formant filters). No audio files anywhere. `SPEAKERS` holds each voice's character.\n */\nimport { defineSfx } from '../../../engine';\n\nconst fx = (name: string, voices: object | object[], more: object = {}) => defineSfx(`sfx:${name}`, { voices, ...more } as never);\n\nfx('wtCreak', { wave: 'saw', freq: 90, to: 60, dur: 0.22, vol: 0.2, filter: { type: 'bandpass', freq: 700 }, q: 6 }, { variants: 3 });\nfx('wtBreathIn', { wave: 'noise', dur: 0.8, vol: 0.09, attack: 0.3, filter: { type: 'bandpass', freq: 1400 } });\nfx('wtBreathOut', { wave: 'noise', dur: 0.9, vol: 0.08, attack: 0.1, filter: { type: 'bandpass', freq: 800 } });\nfx('wtSqueak', { wave: 'sine', freq: 1200, to: 1700, dur: 0.07, vol: 0.12 }, { variants: 3 });\nfx('wtStamp', [{ wave: 'noise', dur: 0.05, vol: 0.4, filter: { type: 'lowpass', freq: 900 } }, { wave: 'sine', freq: 110, to: 60, dur: 0.14, vol: 0.6 }]);\nfx('wtClack', [{ wave: 'noise', dur: 0.03, vol: 0.3, filter: { type: 'bandpass', freq: 2400 } }, { wave: 'triangle', freq: 880, to: 620, dur: 0.05, vol: 0.25 }], { variants: 4 });\nfx('wtSplash', { wave: 'noise', dur: 0.45, vol: 0.4, filter: { type: 'lowpass', freq: 2400 } });\nfx('wtSplashBig', [{ wave: 'noise', dur: 1.1, vol: 0.6, filter: { type: 'lowpass', freq: 1800 } }, { wave: 'sine', freq: 80, to: 40, dur: 0.5, vol: 0.6 }]);\nfx('wtGull', { wave: 'saw', freq: 1100, to: 620, dur: 0.28, vol: 0.2, vib: { rate: 22, depth: 90 }, filter: { type: 'bandpass', freq: 1600 } }, { variants: 3 });\nfx('wtFrog', { wave: 'square', freq: 120, to: 90, dur: 0.22, vol: 0.2, vib: { rate: 30, depth: 25 }, filter: { type: 'lowpass', freq: 800 } });\nfx('wtRope', { wave: 'saw', freq: 170, to: 130, dur: 0.12, vol: 0.12, filter: { type: 'bandpass', freq: 500 } }, { variants: 3 });\nfx('wtWhoosh', { wave: 'noise', dur: 0.4, vol: 0.2, attack: 0.15, filter: { type: 'bandpass', freq: 1800 } });\nfx('wtClap', { wave: 'noise', dur: 0.06, vol: 0.5, filter: { type: 'bandpass', freq: 1800 } });\nfx('wtKick', { wave: 'sine', freq: 130, to: 45, dur: 0.14, vol: 0.8 });\nfx('wtHat', { wave: 'noise', dur: 0.025, vol: 0.2, filter: { type: 'highpass', freq: 6000 } });\nfx('wtWhistle', { wave: 'sine', freq: 2100, to: 2300, dur: 0.3, vol: 0.2, vib: { rate: 34, depth: 80 } });\nfx('wtHorn', [{ wave: 'saw', freq: 98, dur: 1.5, vol: 0.28, attack: 0.1, filter: { type: 'lowpass', freq: 500 } }, { wave: 'saw', freq: 147, dur: 1.5, vol: 0.2, attack: 0.1, filter: { type: 'lowpass', freq: 600 } }]);\nfx('wtThunder', [{ wave: 'noise', dur: 2.4, vol: 0.5, attack: 0.08, filter: { type: 'lowpass', freq: 240 } }, { wave: 'sine', freq: 55, to: 30, dur: 1.4, vol: 0.5 }]);\nfx('wtGroan', { wave: 'saw', freq: 58, to: 41, dur: 2.2, vol: 0.34, attack: 0.3, filter: { type: 'lowpass', freq: 240 }, vib: { rate: 3, depth: 3 } });\nfx('wtOoh', [{ wave: 'saw', freq: 210, to: 240, dur: 0.6, vol: 0.14, attack: 0.1, filter: { type: 'bandpass', freq: 450 }, q: 5 }, { wave: 'saw', freq: 280, to: 320, dur: 0.6, vol: 0.1, attack: 0.1, filter: { type: 'bandpass', freq: 800 }, q: 5 }]);\nfx('wtDing', { wave: 'sine', freq: 1320, dur: 0.3, vol: 0.2 }, { variants: 3 });\nfx('wtBell', [{ wave: 'sine', freq: 660, dur: 0.9, vol: 0.2 }, { wave: 'sine', freq: 1320, dur: 0.5, vol: 0.08 }]);\nfx('wtMarble', { wave: 'noise', dur: 0.5, vol: 0.09, filter: { type: 'bandpass', freq: 3000 } });\nfx('wtSink', { wave: 'sine', freq: 660, to: 220, dur: 0.22, vol: 0.3 });\nfx('wtSea', { wave: 'noise', dur: 4, vol: 0.14, attack: 1.2, filter: { type: 'lowpass', freq: 800 } }, { bus: 'ambience' });\nfx('wtBirds', { wave: 'sine', freq: 3200, to: 3900, dur: 0.14, vol: 0.05, vib: { rate: 40, depth: 240 } }, { bus: 'ambience', variants: 3 });\nfx('wtWind', { wave: 'noise', dur: 4, vol: 0.2, attack: 1.2, filter: { type: 'bandpass', freq: 500 } }, { bus: 'ambience' });\nfx('wtRain', { wave: 'noise', dur: 3, vol: 0.2, attack: 0.5, filter: { type: 'highpass', freq: 2200 } }, { bus: 'ambience' });\nfx('wtBuzz', { wave: 'square', freq: 120, dur: 0.3, vol: 0.1, vib: { rate: 40, depth: 8 } });\n\n/** Each voice: base pitch, syllable length, character. */\nexport const SPEAKERS = {\n  tare: { base: 260, syllable: 0.06, contour: 1.2, vib: 0, sigh: false, narrow: false },\n  plumb: { base: 135, syllable: 0.11, contour: 0, vib: 0, sigh: false, narrow: false },\n  gerald: { base: 95, syllable: 0.14, contour: 0.3, vib: 0, sigh: false, narrow: false },\n  bex: { base: 210, syllable: 0.08, contour: 0.1, vib: 0, sigh: true, narrow: false },\n  nan: { base: 170, syllable: 0.12, contour: 0.4, vib: 6, sigh: false, narrow: false },\n  pa: { base: 135, syllable: 0.11, contour: 0, vib: 0, sigh: false, narrow: true },\n  plaque: { base: 190, syllable: 0.07, contour: 0.2, vib: 0, sigh: false, narrow: false },\n} as const;\n\nexport type Speaker = keyof typeof SPEAKERS;\n\nconst VOWELS: readonly (readonly [number, number])[] = [[800, 1200], [500, 1900], [300, 2300], [500, 900], [320, 800]];\nconst BANDS = [3200, 2400, 4200, 1600];\n\n/** Bank ids `sfx:vo.<who>.<0-15>`. */\nexport function voiceId(who: Speaker, k: number): string {\n  return `sfx:vo.${who}.${k}`;\n}\n\nfor (const [who, s] of Object.entries(SPEAKERS)) {\n  for (let k = 0; k < 16; k++) {\n    const [f1, f2] = VOWELS[k % VOWELS.length];\n    const q = s.narrow ? 16 : 7;\n    const vib = s.vib ? { vib: { rate: s.vib, depth: s.base * 0.05 } } : {};\n    const dur = s.syllable * 1.15;\n    defineSfx(voiceId(who as Speaker, k), {\n      bus: 'ui',\n      voices: [\n        { wave: 'noise', dur: 0.012 + (k % 3) * 0.006, vol: 0.12, attack: 0.001, filter: { type: 'bandpass', freq: BANDS[k % BANDS.length] } },\n        { wave: 'saw', freq: s.base, to: s.base * 0.92, at: 0.012, dur, vol: 0.5, attack: 0.006, filter: { type: 'bandpass', freq: s.narrow ? 1100 : f1 }, q, ...vib },\n        { wave: 'saw', freq: s.base, to: s.base * 0.92, at: 0.012, dur, vol: 0.35, attack: 0.006, filter: { type: 'bandpass', freq: s.narrow ? 1400 : f2 }, q: q + 2, ...vib },\n      ],\n    } as never);\n  }\n}\nE\ncat > labs/game/audio/voice.ts <<'E'\n/**\n * @file Animalese: `say(speaker, text)` babbles a line. One syllable per two letters, hashed from the letters so the same line\n * always babbles the same way; the pitch rises on \"?\" and falls on \".\"; spaces are silence, punctuation longer. Text\n * always stays on screen too, so nothing needs the voice.\n */\nimport type { Audio } from '../../../engine';\nimport { SPEAKERS, voiceId, type Speaker } from '../sounds/sfx';\n\n/** Plays a line now; returns its length, seconds. */\nexport function babble(audio: Audio, who: Speaker, text: string, level: number): number {\n  const s = SPEAKERS[who] ?? SPEAKERS.tare;\n  const context = audio.context;\n  if (!context) return 0;\n  const start = context.currentTime + 0.02;\n  let at = 0;\n  const rising = text.trim().endsWith('?');\n  const count = Math.ceil(text.length / 2);\n  for (let i = 0; i < text.length; i += 2) {\n    const pair = text.slice(i, i + 2);\n    const code = (pair.charCodeAt(0) * 31 + (pair.charCodeAt(1) || 7)) & 0xffff;\n    if (/^[\\s]+$/.test(pair)) {\n      at += s.syllable * 0.6;\n      continue;\n    }\n    const k = i / 2 / Math.max(1, count - 1);\n    const contour = (rising ? 0.3 * Math.pow(k, 3) : -0.18 * Math.pow(k, 3)) * s.contour + Math.sin(i * 1.1) * 0.04 * s.contour;\n    const sigh = s.sigh && k > 0.8 ? -0.15 : 0;\n    audio.play(voiceId(who, code % 16), {\n      pitch: 1 + contour + sigh + ((code % 5) - 2) * 0.012 * s.contour,\n      when: start + at,\n      vol: level,\n      bus: 'ui',\n      duck: true,\n    } as never);\n    at += s.syllable;\n    if (/[.,!?]/.test(pair)) at += s.syllable * 2.2;\n  }\n  return at;\n}\nE\ncat > labs/game/audio/sound.ts <<'E'\n/**\n * @file The page's sound: the audio runtime with music at 10% by default, the songs by activity, the sim's `cue` and other\n * events mapped to effects, ambience by place, and the Voices slider. Started by the first gesture, as the runtime does.\n */\nimport { createAudio, type Audio } from '../../../engine';\nimport '../sounds/songs';\nimport '../sounds/sfx';\nimport { babble } from './voice';\nimport type { Speaker } from '../sounds/sfx';\n\n/** What a cue plays. */\nconst CUES: Readonly<Record<string, string>> = {\n  creak: 'sfx:wtCreak', bell: 'sfx:wtBell', stamp: 'sfx:wtStamp', ding: 'sfx:wtDing', whistle: 'sfx:wtWhistle',\n  repGood: 'sfx:wtSqueak', repMiss: 'sfx:wtCreak', gullLand: 'sfx:wtGull', gullOff: 'sfx:wtGull', rope: 'sfx:wtRope',\n  stumble: 'sfx:wtCreak', splash: 'sfx:wtSplash', splashBig: 'sfx:wtSplashBig', paddle: 'sfx:wtSqueak', horn: 'sfx:wtHorn',\n  turtle: 'sfx:wtFrog', marbleSink: 'sfx:wtSink', marbleLost: 'sfx:wtWhoosh', whoosh: 'sfx:wtWhoosh', hoopDrop: 'sfx:wtClack',\n  hoopWhoosh: 'sfx:wtWhoosh', hoopCatch: 'sfx:wtDing', hoopWarn: 'sfx:wtWhistle', pace: 'sfx:wtSqueak', calmWave: 'sfx:wtOoh',\n  crank: 'sfx:wtRope', groan: 'sfx:wtGroan', thunder: 'sfx:wtThunder', tick: 'sfx:wtClack', pebble: 'sfx:wtClack',\n  gust: 'sfx:wtWhoosh', gustWarn: 'sfx:wtWhistle', stampJingle: 'sfx:wtStamp',\n}; // prettier-ignore\n\nexport interface Sound {\n  readonly audio: Audio;\n  /** Plays a cue by name. */\n  cue(name: string, extra?: Record<string, unknown>): void;\n  /** Plays a sim event by type. */\n  event(type: string): void;\n  /** Babbles a line at the Voices level. */\n  say(who: string, text: string): number;\n  /** Changes the song; '' silence. */\n  song(id: string): void;\n  /** Sets the ambience: sea, wind, rain. */\n  ambience(storm: number): void;\n  voices: number;\n  stop(): void;\n}\n\n/** Makes the sound. `volumes` is what the save holds. */\nexport function createSound(volumes: { music: number; effects: number; voices: number }): Sound {\n  const audio = createAudio();\n  audio.volume('music', volumes.music);\n  audio.volume('effects', volumes.effects);\n  audio.volume('ui', 1);\n  let current = '';\n  let last = 0;\n  let stormOn = false;\n  const self: Sound = {\n    audio,\n    voices: volumes.voices,\n    cue(name) {\n      const id = CUES[name];\n      if (id) audio.play(id);\n    },\n    event(type) {\n      if (type === 'beat') {\n        audio.play('sfx:wtClap', { vol: 0.8 } as never);\n        audio.play('sfx:wtKick');\n      } else if (type === 'topple') audio.play('sfx:wtCreak');\n      else if (type === 'clack') audio.play('sfx:wtClack');\n      else if (type === 'moved') audio.play('sfx:wtFrog');\n      else if (type === 'results') audio.stinger?.('song:stamp', { vol: 1 } as never);\n    },\n    say(who, text) {\n      return babble(audio, who as Speaker, text, self.voices);\n    },\n    song(id) {\n      if (id === current) return;\n      current = id;\n      audio.music(id || null, { intensity: 0.2 } as never);\n    },\n    ambience(storm) {\n      const now = performance.now() / 1000;\n      if (now - last < 3.4) return;\n      last = now;\n      audio.play(storm > 0.3 ? 'sfx:wtWind' : 'sfx:wtSea');\n      if (storm > 0.3) audio.play('sfx:wtRain');\n      else if (Math.random() < 0.3) audio.play('sfx:wtBirds');\n      stormOn = storm > 0.3;\n      void stormOn;\n    },\n    stop() {\n      audio.music(null);\n      void audio.close();\n    },\n  };\n  return self;\n}\nE\ngrep -n \"Math.random\" engine/audio/runtime/*.ts | head -3 | cut -c1-100; grep -n \"when\\|pitch\" engine/audio/runtime/audio.ts | head -8 | cut -c1-120;grep -n \"createDialog\" engine/ui/*.ts | head -2 | cut -c1-100; sed -n 40,60p engine/input/bindings.ts | head -0; WT_SEEDS=2 WT_ONLY=reps,plunge timeout 200 npx vitest run labs/game/scenes/balance.test.ts -t \"meets\" 2>&1 | grep -E \"Error:\" | cut -c1-160 | head -4; cat out/balance.json | tr -d '\\n ' | cut -c1-500","description":"Write page assets: materials, looks, bodies, emitters, camera, audio","timeout":280000}}}
