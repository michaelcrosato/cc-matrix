e point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n40:export interface CameraPose {\n41-  /** The camera's position, m. */\n42-  readonly position: Vec3;\n43-  /** The heading of the view direction, rad (the intents' `cam`). */\n44-  readonly yaw: number;\n45-  /** Up or down from level, rad: + up, −π/2 straight down. */\n46-  readonly pitch: number;\n47-  /** A bank about the view direction, rad: + tips the picture's top to the right, as a lean into a right turn. */\n48-  readonly roll: number;\n49-  readonly projection: Projection;\n50-  /** Vertical field of view, degrees (`PerspectiveCamera.fov`). */\n51-  readonly fov: number;\n52-  /** Orthographic: the frustum's height at zoom 1, m (`top − bottom`, three.js's examples' `frustumSize`). */\n53-  readonly frustumSize: number;\n54-  /** As three.js cameras' `zoom`: 2 shows half as much (a narrower lens, a smaller frustum). */\n140:export function makePose(fields: Partial<CameraPose> & { position: Vec3 }): CameraPose {\n141-  const p = { ...POSE_DEFAULTS, ...fields };\n142-  const problems = [\n143-    ...pointProblems('position', p.position),\n144-    ...rangeProblems({\n145-      yaw: [p.yaw, -1e9, 1e9],\n146-      pitch: [p.pitch, -Math.PI / 2, Math.PI / 2],\n147-      roll: [p.roll, -Math.PI / 2, Math.PI / 2],\n148-      fov: [p.fov, 1, 179],\n149-      frustumSize: [p.frustumSize, 1e-6, 1e9],\n150-      zoom: [p.zoom, 1e-3, 1e3],\n151-      near: [p.near, 1e-6, 1e9],\n152-      far: [p.far, p.near, 1e9],\n153-      boost: [p.boost, 0.01, 100],\n154-      distance: [p.distance, 0, 1e9],\nengine/gfx/cameras/chase.ts-282- * takes the view `effects` (engine/gfx/cameras/effects.ts) and `fade` (see `FollowCamera`) when given. A game's own\nengine/gfx/cameras/chase.ts-283- * camera is made this way.\nengine/gfx/cameras/chase.ts-284- */\nengine/gfx/cameras/chase.ts:285:export function followCamera<T extends string, St, S, I extends CameraInput>(\nengine/gfx/cameras/chase.ts-286-  type: T,\nengine/gfx/cameras/chase.ts-287-  first: St,\nengine/gfx/cameras/chase.ts-288-  steps: FollowSteps<St, S, I>,\nengine/gfx/cameras/chase.ts-289-  extras: { readonly effects?: EffectWeights; readonly fade?: boolean } = {},\nengine/gfx/cameras/chase.ts-290-): FollowCamera<T, S, I> {\nengine/gfx/cameras/chase.ts-291-  let state = first;\nengine/gfx/cameras/chase.ts-292-  let pose = steps.pose(state);\nengine/gfx/cameras/chase.ts-293-  return {\nengine/gfx/cameras/chase.ts-294-    type,\nengine/gfx/cameras/chase.ts-295-    ...extras,\nengine/gfx/cameras/chase.ts-296-    update(input = {} as I, dt = 0) {\nengine/gfx/cameras/chase.ts-297-      refuse(`${type} camera update`, rangeProblems({ dt: [dt, 0, 3600] }));\nengine/gfx/cameras/chase.ts-298-      state = steps.step(state, input, dt);\nengine/gfx/cameras/chase.ts-299-      pose = steps.pose(state);\nengine/gfx/cameras/chase.ts-300-      return pose;\nengine/gfx/cameras/chase.ts-301-    },\nengine/gfx/cameras/chase.ts-302-    pose: () => pose,\nengine/gfx/cameras/chase.ts-303-    yaw: () => wrapAngle(pose.yaw),\nengine/gfx/cameras/chase.ts-304-    spec: () => steps.spec(state),\nengine/gfx/cameras/chase.ts-305-    code: () => steps.code(steps.spec(state)),\nengine/gfx/cameras/chase.ts-306-    describe: () => steps.describe(steps.spec(state), pose),\nengine/gfx/cameras/chase.ts-307-  };\nengine/gfx/cameras/chase.ts-308-}\nengine/gfx/cameras/chase.ts-309-\nengine/gfx/cameras/chase.ts-310-/** A chase camera: behind the hero on its arm, following `input.follow`, in front of the walls `input.queries` sees. */\nengine/gfx/cameras/chase.ts-311-export function createChaseCamera(options: ChaseOptions = {}): FollowCamera<'chase', ChaseSpec, ChaseInput> {\nengine/gfx/cameras/chase.ts-312-  return followCamera('chase', chaseState(options), {\nengine/gfx/cameras/chase.ts-313-    step: stepChase,\nengine/gfx/cameras/chase.ts-314-    pose: chasePose,\nengine/gfx/cameras/chase.ts-315-    spec: chaseSpec,\n65:export interface CameraInput {\n66-  /** Look this frame `[right, up]`, rad: turn the view right and tilt it up (a captured mouse × its sensitivity). */\n67-  readonly look?: readonly [number, number];\n68-  /** Turn rates `[right, up]`, −1 to 1 (arrow keys, a right stick), times the camera's turn speed. */\n69-  readonly turn?: readonly [number, number];\n70-  /** Move axes `[right, forward, up]`, −1 to 1 (WASD, then E or Space up and Q down): fly cameras. */\n71-  readonly move?: readonly [number, number, number];\n72-  /** Move at the fast speed (Shift). */\n73-  readonly fast?: boolean;\n74-  /** Zoom steps, + in (wheel notches, + and −): views step their zoom, orbits come closer, fly and fixed narrow. */\n75-  readonly zoom?: number;\n76-  /** 45° turns of a classic view, + raising its azimuth (the prototype's `]` key). */\n77-  readonly turnSteps?: number;\n78-  /** The zoom steps a classic view's `zoom` moves through (engine/gfx/cameras/presets.ts's when absent). */\n79-  readonly zooms?: readonly number[];\n80-  /** The point views and orbits follow (the hero's feet, or a point just ahead of his aim), m. */\n81-  readonly follow?: Vec3;\n82-}\n83-\n84-/** A camera: its state, stepped once per rendered frame, and its pose. Made by the factories, or `createCamera`. */\n85-export interface Camera {\n86-  readonly type: CameraType;\n87-  /** Steps the camera by one rendered frame (`dt` real seconds) and returns its new pose. */\n88-  update(input?: CameraInput, dt?: number): CameraPose;\n89-  /** The pose after the last update. */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YNJEGHWM5fQsFGVgwZjeGW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
