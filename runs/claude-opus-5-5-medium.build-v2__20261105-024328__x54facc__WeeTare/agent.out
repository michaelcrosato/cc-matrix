{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaojNJmq9ba1v5Fm7Qp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y47uoQRKWS6Jm5LMYFHepe","name":"Bash","input":{"command":"sed -n 85,130p engine/sim/actors.ts | cut -c1-150 | grep -n \"intents\\|held\\|pressed\\|edges\" ; grep -n \"function moveActors\" -A22 engine/sim/actors.ts | cut -c1-150; grep -n \"export interface CrowdBodyInput\" -A14 engine/sim/crowdBodies.ts | cut -c1-140\npython3 - <<'E'\np='labs/game/scenes/events/kit.ts';s=open(p).read()\na=s.index(\"/** Moves a kinematic prop to a pose this step. */\");b=s.index(\"/** The seats an activity plays on. */\")\ns=s[:a]+'''/**\n * Moves a prop to a pose this step. Moving props here have no body: nothing collides with them, and the view reads the\n * pose straight from the component.\n */\nexport function moveProp(\n  w: W,\n  id: number,\n  at: readonly [number, number, number],\n  q: readonly [number, number, number, number] = [0, 0, 0, 1],\n): void {\n  const entity = (w as unknown as World).get(id) as unknown as { sceneProp?: { x: number; y: number; z: number; q: number[] } } | undefined;\n  if (!entity?.sceneProp) return;\n  [entity.sceneProp.x, entity.sceneProp.y, entity.sceneProp.z] = [at[0], at[1], at[2]];\n  entity.sceneProp.q = [q[0], q[1], q[2], q[3]];\n}\n\n'''+s[b:]\ns=s.replace(\"import { driveBody, physicsOf,\",\"import { physicsOf,\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/data/days.ts <<'E'\n/**\n * @file The Programme (PLAN.md section 5) as a table: each day's items in order. An item is an activity id, or `walk` for\n * the Day 1 stroll to the Noticeboard. Also the rank table and everything a threshold unlocks. Adding a day is adding a row.\n */\nexport const DAYS: readonly (readonly string[])[] = [\n  ['check', 'poseA', 'pond', 'walk'],\n  ['check', 'reps', 'garden', 'poseB'],\n  ['check', 'paddle', 'line', 'step'],\n  ['check', 'hoop', 'plunge', 'jog'],\n  ['check', 'group', 'poseC', 'tilt'],\n];\n\n/** Every activity a player can replay, in Noticeboard order. */\nexport const BOARD: readonly string[] = ['check', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'step', 'line', 'paddle', 'garden', 'plunge', 'hoop', 'jog', 'group'];\n\n/** Ranks from the bottom; a score reaches each at its floor. */\nexport const RANKS = [\n  { floor: 0, name: 'Present', pebbles: 1 },\n  { floor: 300, name: 'Adequate', pebbles: 2 },\n  { floor: 550, name: 'Composed', pebbles: 3 },\n  { floor: 750, name: 'Serene', pebbles: 4 },\n  { floor: 900, name: 'Unsettling', pebbles: 5 },\n] as const;\n\n/** The rank a score earns. */\nexport function rankOf(score: number): (typeof RANKS)[number] {\n  let at: (typeof RANKS)[number] = RANKS[0];\n  for (const rank of RANKS) if (score >= rank.floor) at = rank;\n  return at;\n}\n\n/** The Wobble Age from a score of 0 to 1. */\nexport const ageOf = (s: number, k: number): number =>\n  Math.round(18 + 64 * Math.pow(Math.max(0, Math.min(1, 1 - s)), k));\n\n/** What the cairn unlocks, by pebbles. */\nexport const UNLOCKS = [\n  { at: 10, id: 'expert' },\n  { at: 20, id: 'colours' },\n  { at: 30, id: 'headband' },\n  { at: 40, id: 'stamps' },\n] as const;\nE\ncat > labs/game/scenes/data/places.ts <<'E'\n/**\n * @file What lies around the island: the 12 plaques, the 20 hidden pebbles, the benches and the props that dress each\n * station, as plain rows. Heights come from the ground at run time. Add a row, get a thing.\n */\nexport const PLAQUES: readonly (readonly [number, number])[] = [\n  [10, 44], [-14, 30], [-40, 8], [-62, -4], [42, 12], [60, 34], [-48, 74], [24, -38], [-10, -72], [52, 74], [70, -46], [64, -2],\n]; // prettier-ignore\n\nexport const HIDDEN_PEBBLES: readonly (readonly [number, number])[] = [\n  [26, 60], [-26, 56], [-74, 30], [-84, 2], [-52, -38], [-24, -60], [16, -62], [52, -30], [78, -24], [82, 18],\n  [72, 40], [46, 62], [10, 78], [-14, 72], [-36, 44], [-20, 12], [20, 16], [34, -14], [-30, -18], [6, -30],\n]; // prettier-ignore\n\nexport const BENCHES: readonly (readonly [number, number, number])[] = [\n  [12, 22, 0], [-30, 34, 1.2], [38, 40, -1.2], [8, -56, 3.1], [-66, 40, 1.8],\n]; // prettier-ignore\n\n/** Static dressing: [prop, x, z, yaw]. */\nexport const DRESSING: readonly (readonly [string, number, number, number])[] = [\n  ['prop:platform', 0, 28, 0], ['prop:noticeboard', 12, 34, -1.57], ['prop:drinksTable', -11, 40, 0],\n  ['prop:pavilion', -52, 18, 0], ['prop:jettyPosts', -70, -14, 0], ['prop:annex', 52, 22, 0],\n  ['prop:hut', 64, 52, 3.1], ['prop:hut', 74, 58, 2.6], ['prop:hut', 54, 60, 3.4],\n  ['prop:ferryPier', 0, 96, 0], ['prop:lighthouse', 84, -60, 0], ['prop:centreStone', 0, 0, 0],\n  ['prop:sandTerrace', 30, -48, 0], ['prop:eastTerrace', 74, 8, 0], ['prop:cliffLip', 0, -88, 0],\n  ['prop:parasol', 58, 90, 0], ['prop:parasol', 70, 86, 1], ['prop:lounger', 62, 92, 0.2], ['prop:lounger', 74, 88, -0.4],\n  ['prop:palm', -18, 46, 0], ['prop:palm', 22, 50, 1], ['prop:palm', -70, 64, 2], ['prop:palm', -40, 66, 0.5], ['prop:palm', 84, 40, 3],\n  ['prop:palm', 44, 70, 1.4], ['prop:palm', 16, 72, 4], ['prop:palm', -16, 66, 2], ['prop:palm', 70, 20, 1], ['prop:palm', -74, 8, 4],\n  ['prop:rock', -44, 84, 0], ['prop:rock', 40, -70, 1], ['prop:rock', -70, -50, 2], ['prop:rock', 90, 0, 3], ['prop:rock', -92, 30, 4],\n  ['prop:rock', 18, -82, 5], ['prop:rock', -20, -84, 0.6], ['prop:rock', 70, 72, 2.2],\n]; // prettier-ignore\nE\ncat > labs/game/scenes/events/tilt.ts <<'E'\n/**\n * @file The Great Tilt (PLAN.md section 7), the finale: every verb at the scale of the world. The storm comes, the island\n * tips, guests drift downhill politely and a Calm Call leads them to the high side; two carts of your pebbles are cranked\n * uphill; then you stand on the plate that says \"Do not\", and your balance is the island's. No fail state, only remarks.\n */\nimport { stepCrowdBody } from '../../../../engine/sim-api';\nimport { clearBody, setLoop, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { STATIONS } from '../data/stations';\nimport { gameNumber } from '../settings';\nimport { cue, islandOf, say, type C, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble, stepBreath, stepWobble, syncShare } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { bothHeld, clamp, footDown, groundAt, hover, inRing, moveProp, ownProp, phase, playing, standAt, type Activity } from './kit';\n\nconst STORM = 1200;\nconst EAST = 4500;\nconst CARTS = 2700;\nconst STONE = 3600;\nconst DAWN = 1500;\nconst CALM_HOLD = 120;\nconst WAVE_R = 8;\nconst DELIVER_R = 11;\nconst START_TILT = 6;\n\n/** A guest in the storm. */\ninterface Drifter { body: number; named: boolean; x: number; z: number; follow: boolean; home: boolean; nan: boolean }\n\ninterface TiltData { guests: Drifter[]; delivered: number; call: number; wave: number; cart: number; last: string; lurch: number; ring: number; inside: number; steps: number; x: number; z: number; carts: number[]; loungers: number[]; lx: number[]; waves: number; endScore: number; cartLast: number; line: number; only: string }\nconst dataOf = (ev: EvState): TiltData => ev.d as unknown as TiltData;\n\ntype ActorOf = { actor: C['actor'] & { intents: Record<string, unknown> } };\n\n/** The slope's downhill push, m/s, for the current tilt. */\nexport function slopePush(tiltDeg: number): number {\n  return Math.sin((Math.abs(tiltDeg) * Math.PI) / 180) * 12;\n}\n\n/** Moves the crowd bodies each step (their rigs step in `anim`). */\nfunction stepDrifters(w: W, d: TiltData): void {\n  const island = islandOf(w);\n  const push = slopePush(island.tiltX);\n  const gx = (w.get(castOf(w).guest) as unknown as ActorOf).actor;\n  for (const g of d.guests) {\n    if (g.home) continue;\n    let vx = -push * 0.5;\n    let vz = Math.sin(w.tick * 0.013 + g.body) * 0.25;\n    if (g.follow) {\n      const [dx, dz] = [gx.x - 1.5 - g.x, gx.z - g.z];\n      const len = Math.hypot(dx, dz);\n      if (len > 2.5) {\n        vx += (dx / len) * 4.6;\n        vz += (dz / len) * 4.6;\n      } else vx *= 0.1;\n    }\n    if (g.nan) [vx, vz] = [(STATIONS.east.x - g.x) * 0.02, (STATIONS.east.z - g.z) * 0.02];\n    g.x = clamp(g.x + vx / 60, -82, 90);\n    g.z = clamp(g.z + vz / 60, -60, 70);\n    if (Math.hypot(g.x - STATIONS.east.x, g.z - STATIONS.east.z) < DELIVER_R) {\n      g.home = true;\n      g.follow = false;\n      if (!g.nan) {\n        d.delivered += 1;\n        island.tiltX = Math.max(1, island.tiltX - 0.5);\n        cue(w, 'ding', { n: d.delivered });\n        say(w, `tilt.delivered.${(d.delivered % 4) + 1}`, 'plumb');\n      }\n    }\n  }\n}\n\n/** Draws the guests where they are. Named people are actors; the rest are crowd bodies, stepped by the system below. */\nfunction drawDrifters(w: W, d: TiltData): void {\n  for (const g of d.guests) {\n    if (g.named) standAt(w, g.body, g.x, g.z, Math.PI / 2);\n  }\n}\n\n/** The system that steps the crowd humanoids in `anim`, as the engine asks. */\nexport function stepTiltCrowd(w: W): void {\n  const ev = (w.query('flow')[0] as unknown as { flow: { ev: EvState | null } }).flow.ev;\n  if (!ev || ev.id !== 'tilt') return;\n  const d = dataOf(ev);\n  for (const g of d.guests ?? []) {\n    if (g.named) continue;\n    const entity = w.get(g.body) as unknown as { id: number; crowdBody: never } | undefined;\n    if (!entity) continue;\n    stepCrowdBody(w as never, g.body, entity.crowdBody, { at: [g.x, groundAt(w, g.x, g.z), g.z], velocity: [0, 0, 0], yaw: Math.PI / 2 } as never);\n  }\n}\n\nconst walkTo = (w: W, e: SeatE, slope: number): void => {\n  const entity = w.get(e.seat.actor) as unknown as ActorOf;\n  entity.actor.intents = { move: [clamp(e.seat.input.y - slope * 0.1, -1, 1), clamp(e.seat.input.x, -1, 1)] };\n};\n\nfunction eastStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  island.tiltX += (gameNumber(w, 'game.tilt.rate') / 60) * 1;\n  walkTo(w, e, slopePush(island.tiltX));\n  if (bothHeld(e)) {\n    d.call += 1;\n    setPose(w, e.seat.actor, 'RETREAT/CalmCall', clamp(d.call / CALM_HOLD, 0, 1));\n  } else {\n    if (d.call >= CALM_HOLD) {\n      d.wave = 40;\n      cue(w, 'calmWave');\n      const { actor } = w.get(e.seat.actor) as unknown as ActorOf;\n      for (const g of d.guests) if (!g.home && Math.hypot(g.x - actor.x, g.z - actor.z) <= WAVE_R) g.follow = true;\n    }\n    if (d.call > 0) clearBody(w, e.seat.actor);\n    d.call = 0;\n  }\n  d.wave = Math.max(0, d.wave - 1);\n  stepDrifters(w, d);\n  drawDrifters(w, d);\n  // loungers slide through, and go round again\n  d.loungers.forEach((id, k) => {\n    d.lx[k] -= (slopePush(island.tiltX) * 1.6) / 60;\n    if (d.lx[k] < -60) d.lx[k] = 80;\n    moveProp(w, id, [d.lx[k], groundAt(w, d.lx[k], 20 + k * 8), 20 + k * 8]);\n  });\n  const left = d.guests.filter((g) => !g.home && !g.nan).length;\n  if (left === 0 || ev.t >= EAST) {\n    if (left) say(w, 'tilt.shuffle', 'plumb');\n    for (const g of d.guests) if (!g.home) Object.assign(g, { home: true, x: STATIONS.east.x + (g.body % 7) - 3, z: STATIONS.east.z + (g.body % 5) - 2 });\n    drawDrifters(w, d);\n    for (const id of d.loungers) moveProp(w, id, [0, -30, 0]);\n    (w.get(e.seat.actor) as unknown as ActorOf).actor.intents = {};\n    resetWobble(e.wobble);\n    island.finale = 3;\n    standAt(w, e.seat.actor, -10, 40, Math.PI / 2);\n    say(w, 'tilt.carts', 'plumb');\n    phase(ev, 'carts');\n  }\n}\n\nfunction cartsStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  stepBreath(w, e, w.tick);\n  stepWobble(w, e, [-slopePush(island.tiltX) * 0.7, 0]);\n  const left = footDown(e, 'l');\n  const right = footDown(e, 'r');\n  if (left !== right) {\n    const foot = left ? 'l' : 'r';\n    if (foot !== d.last && inRing(e, 0.3, 0, 0.45)) {\n      d.cart = Math.min(1, d.cart + 0.03);\n      cue(w, 'crank');\n    }\n    d.last = foot;\n  }\n  setLoop(w, e.seat.actor, 'RETREAT/Crank', d.cartLast === Math.floor(d.cart * 100) ? 0.2 : 1.2);\n  d.cartLast = Math.floor(d.cart * 100);\n  d.carts.forEach((id, k) => moveProp(w, id, [-10 + d.cart * 22 - k * 4, 8.1, 42 + k * 2.2]));\n  (w.get(e.seat.actor) as unknown as ActorOf).actor.intents = {};\n  if (d.cart >= 1 || ev.t >= CARTS) {\n    island.tiltX = Math.max(1, island.tiltX - 1.5 * d.cart);\n    if (d.cart < 1) say(w, 'tilt.cartsTime', 'plumb');\n    else say(w, 'tilt.cartsDone', 'tare');\n    resetWobble(e.wobble);\n    clearBody(w, e.seat.actor);\n    island.finale = 4;\n    d.line = 0;\n    say(w, 'tilt.stone', 'plumb');\n    phase(ev, 'stone');\n  }\n}\n\nfunction stoneStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  stepBreath(w, e, w.tick);\n  const k = ev.t / STONE;\n  d.waves = (0.6 + k * 1.2) * 3;\n  const shove: [number, number] = [Math.sin(ev.t * 0.021) * d.waves, Math.sin(ev.t * 0.017 + 1) * d.waves * 0.8];\n  const before = e.wobble.topples;\n  stepWobble(w, e, shove);\n  if (e.wobble.topples > before) {\n    d.lurch += 3;\n    say(w, 'tilt.again', 'plumb');\n    cue(w, 'groan');\n  }\n  d.lurch *= 0.995;\n  d.ring = 0.3 - 0.13 * k;\n  d.steps += 1;\n  if (inRing(e, 0, 0, d.ring)) d.inside += 1;\n  island.tiltX = e.wobble.x * 8 + d.lurch;\n  island.tiltZ = e.wobble.y * 8;\n  const y = groundAt(w, d.x, d.z);\n  hover(w, e.seat.actor, d.x, y + 0.42, d.z, 0);\n  setPose(w, e.seat.actor, 'RETREAT/LineStand', 1);\n  if (ev.t >= STONE) {\n    const breath = syncShare(e.wobble);\n    d.endScore = (0.3 * d.delivered) / 11 + (0.5 * d.inside) / Math.max(1, d.steps) + 0.2 * breath;\n    say(w, 'tilt.level', 'plumb');\n    cue(w, 'groan');\n    phase(ev, 'dawn');\n  }\n}\n\nfunction dawnStep(w: W, ev: EvState, e: SeatE): void {\n  const island = islandOf(w);\n  island.storm = Math.max(0, island.storm - 1 / 300);\n  island.tiltX *= 0.98;\n  island.tiltZ *= 0.98;\n  const { plumb } = castOf(w);\n  void e;\n  if (ev.t === 360) {\n    w.emit('plumbEyes', { open: true } as never);\n    say(w, 'tilt.hm', 'plumb');\n  }\n  if (ev.t === 480) w.emit('plumbEyes', { open: false } as never);\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\n  if (ev.t >= DAWN) {\n    island.finale = 0;\n    island.tiltX = 0;\n    island.tiltZ = 0;\n    ev.score = Math.round(clamp(dataOf(ev).endScore, 0, 1) * 1000);\n    ev.done = true;\n  }\n}\n\nfunction step(w: W, ev: EvState): void {\n  const [e] = playing(w, ev);\n  const island = islandOf(w);\n  if (ev.phase === 'storm') {\n    island.storm = clamp(ev.t / 300, 0, 1);\n    island.tiltX = clamp((ev.t / STORM) * START_TILT, 0, START_TILT);\n    if (ev.t === 60) cue(w, 'horn');\n    if (ev.t === 240) cue(w, 'thunder');\n    if (ev.t === 360) w.emit('plait', { swing: true } as never);\n    if (ev.t === 480) say(w, 'tilt.calm', 'plumb');\n    const { plumb } = castOf(w);\n    if (plumb >= 0) standAt(w, plumb, 3, 28 + Math.sin(ev.t * 0.05) * 0.4, Math.sin(ev.t * 0.04) * 0.35);\n    if (ev.t >= STORM || (e.seat.kind === 'human' && e.seat.input.act && ev.t > 300)) {\n      island.finale = 2;\n      island.tiltX = START_TILT;\n      say(w, 'tilt.east', 'plumb');\n      phase(ev, 'east');\n    }\n    return;\n  }\n  if (ev.phase === 'east') return eastStep(w, ev, e);\n  if (ev.phase === 'carts') return cartsStep(w, ev, e);\n  if (ev.phase === 'stone') return stoneStep(w, ev, e);\n  if (ev.phase === 'dawn') return dawnStep(w, ev, e);\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  const d = dataOf(ev);\n  const { actor } = w.get(e.seat.actor) as unknown as ActorOf;\n  if (ev.phase === 'east') {\n    const followers = d.guests.filter((g) => g.follow && !g.home).length;\n    const lost = d.guests.filter((g) => !g.follow && !g.home && !g.nan);\n    const near = lost.reduce<Drifter | null>((best, g) => (!best || Math.hypot(g.x - actor.x, g.z - actor.z) < Math.hypot(best.x - actor.x, best.z - actor.z) ? g : best), null);\n    const goEast = followers >= 3 || !near;\n    const [tx, tz] = goEast ? [STATIONS.east.x, STATIONS.east.z] : [near.x, near.z];\n    const far = Math.hypot(tx - actor.x, tz - actor.z);\n    if (!goEast && far < 6) {\n      const hold = d.call < CALM_HOLD + 4;\n      return hold ? { stick: [0, 0], l: 1, r: 1, raw: true } : { stick: [0, 0] };\n    }\n    return { stick: [clamp((tz - actor.z) / 6, -1, 1), clamp((tx - actor.x) / 6, -1, 1)], raw: true };\n  }\n  if (ev.phase === 'carts') {\n    const beat = w.tick % 40;\n    const order: Order = { aim: [0.3, 0] };\n    if (beat < 8) order.l = 1;\n    else if (beat >= 20 && beat < 28) order.r = 1;\n    return order;\n  }\n  if (ev.phase === 'stone') {\n    const steps = Math.round(gameNumber(w, 'game.breath.period') * 60);\n    const feet = (w.tick + steps - skill.timing) % steps < steps / 2 ? 1 : 0;\n    return { aim: [0, 0], l: feet, r: feet };\n  }\n  return {};\n}\n\nexport const TILT: Activity = {\n  id: 'tilt', title: 'The Great Tilt', station: 'plaza', shot: 'tilt', map: 'balance', song: 'song:tilt',\n  setup(w, ev) {\n    const [e] = playing(w, ev);\n    const cast = castOf(w);\n    const island = islandOf(w);\n    resetWobble(e.wobble);\n    island.finale = 1;\n    ev.s[e.seat.index] = {};\n    const rng = w.rng('tilt');\n    const guests: Drifter[] = [];\n    const named = [cast.gerald, cast.bex, cast.nan];\n    for (let k = 0; k < 12; k++) {\n      const x = rng.range(-26, 30);\n      const z = rng.range(14, 54);\n      if (k < 3 && named[k] >= 0) {\n        guests.push({ body: named[k], named: true, x, z, follow: false, home: false, nan: named[k] === cast.nan });\n      } else {\n        const y = groundAt(w, x, z);\n        const body = w.spawn({ crowdBody: { rig: 'humanoid', look: 'build:chibi', x, y, z, yaw: 0 } } as never);\n        ev.owned.push(body);\n        guests.push({ body, named: false, x, z, follow: false, home: false, nan: false });\n      }\n    }\n    const carts = [0, 1].map((k) => ownProp(w, ev, 'prop:cart', [-10 - k * 4, 8.1, 42 + k * 2.2]));\n    ownProp(w, ev, 'prop:rails', [1, 8.02, 43]);\n    const loungers = [0, 1, 2].map((k) => ownProp(w, ev, 'prop:lounger', [80 - k * 45, -30, 20 + k * 8]));\n    Object.assign(ev.d, { guests, delivered: 0, call: 0, wave: 0, cart: 0, last: '', lurch: 0, ring: 0.3, inside: 0, steps: 0, x: STATIONS.stone.x, z: STATIONS.stone.z, carts, loungers, lx: [80, 35, -10], waves: 0, endScore: 0, cartLast: 0, line: 0 });\n    standAt(w, e.seat.actor, 0, 32, Math.PI / 2);\n    say(w, 'tilt.storm', 'pa');\n    if (ev.d.only === 'stone') {\n      island.finale = 4;\n      island.storm = 1;\n      island.tiltX = START_TILT;\n      phase(ev, 'stone');\n      return;\n    }\n    phase(ev, 'storm');\n  },\n  step, bot,\n  teardown(w) {\n    const island = islandOf(w);\n    Object.assign(island, { finale: 0, tiltX: 0, tiltZ: 0, storm: 0 });\n  },\n}; // prettier-ignore\nE\ncat > labs/game/scenes/events/index.ts <<'E'\n/**\n * @file Every activity by id. Adding an activity is a module and a row here (and rows in days.ts and the line files).\n */\nimport type { Activity } from './kit';\nimport { CHECK, RING_CLASS } from './ring';\nimport { POSE_ACTIVITIES } from './pose';\nimport { POND, POND_SHORT } from './pond';\nimport { REPS } from './reps';\nimport { STEP, STEP_SHORT } from './step';\nimport { HOOP, HOOP_SHORT } from './hoop';\nimport { LINE } from './line';\nimport { PADDLE } from './paddle';\nimport { GARDEN } from './garden';\nimport { PLUNGE } from './plunge';\nimport { JOG } from './jog';\nimport { TILT } from './tilt';\n\nconst LIST: readonly Activity[] = [CHECK, RING_CLASS, ...POSE_ACTIVITIES, POND, POND_SHORT, REPS, STEP, STEP_SHORT, HOOP, HOOP_SHORT, LINE, PADDLE, GARDEN, PLUNGE, JOG, TILT]; // prettier-ignore\n\nexport const ACTIVITIES: Readonly<Record<string, Activity>> = Object.fromEntries(LIST.map((a) => [a.id, a]));\n\n/** The activities the balance tests hold to the plan's targets. */\nexport const PLAYED = ['check', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'step', 'line', 'paddle', 'garden', 'plunge', 'hoop', 'jog', 'ring', 'heron', 'hoopS', 'stepS', 'pondS'] as const;\nE\n","description":"Write finale, days data, places, activities index"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1450,"cache_read_input_tokens":263059,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1450},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"852ee2a4-7986-4a85-b5d6-a21dc7fd1f5f","timestamp":"2026-11-05T10:00:05.238Z","request_id":"req_011Cgjaoj6SbiuCFNjodMGkb","wire_tool_inputs":{"toolu_01Y47uoQRKWS6Jm5LMYFHepe":{"command":"sed -n 85,130p engine/sim/actors.ts | cut -c1-150 | grep -n \"intents\\|held\\|pressed\\|edges\" ; grep -n \"function moveActors\" -A22 engine/sim/actors.ts | cut -c1-150; grep -n \"export interface CrowdBodyInput\" -A14 engine/sim/crowdBodies.ts | cut -c1-140\npython3 - <<'E'\np='labs/game/scenes/events/kit.ts';s=open(p).read()\na=s.index(\"/** Moves a kinematic prop to a pose this step. */\");b=s.index(\"/** The seats an activity plays on. */\")\ns=s[:a]+'''/**\n * Moves a prop to a pose this step. Moving props here have no body: nothing collides with them, and the view reads the\n * pose straight from the component.\n */\nexport function moveProp(\n  w: W,\n  id: number,\n  at: readonly [number, number, number],\n  q: readonly [number, number, number, number] = [0, 0, 0, 1],\n): void {\n  const entity = (w as unknown as World).get(id) as unknown as { sceneProp?: { x: number; y: number; z: number; q: number[] } } | undefined;\n  if (!entity?.sceneProp) return;\n  [entity.sceneProp.x, entity.sceneProp.y, entity.sceneProp.z] = [at[0], at[1], at[2]];\n  entity.sceneProp.q = [q[0], q[1], q[2], q[3]];\n}\n\n'''+s[b:]\ns=s.replace(\"import { driveBody, physicsOf,\",\"import { physicsOf,\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/data/days.ts <<'E'\n/**\n * @file The Programme (PLAN.md section 5) as a table: each day's items in order. An item is an activity id, or `walk` for\n * the Day 1 stroll to the Noticeboard. Also the rank table and everything a threshold unlocks. Adding a day is adding a row.\n */\nexport const DAYS: readonly (readonly string[])[] = [\n  ['check', 'poseA', 'pond', 'walk'],\n  ['check', 'reps', 'garden', 'poseB'],\n  ['check', 'paddle', 'line', 'step'],\n  ['check', 'hoop', 'plunge', 'jog'],\n  ['check', 'group', 'poseC', 'tilt'],\n];\n\n/** Every activity a player can replay, in Noticeboard order. */\nexport const BOARD: readonly string[] = ['check', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'step', 'line', 'paddle', 'garden', 'plunge', 'hoop', 'jog', 'group'];\n\n/** Ranks from the bottom; a score reaches each at its floor. */\nexport const RANKS = [\n  { floor: 0, name: 'Present', pebbles: 1 },\n  { floor: 300, name: 'Adequate', pebbles: 2 },\n  { floor: 550, name: 'Composed', pebbles: 3 },\n  { floor: 750, name: 'Serene', pebbles: 4 },\n  { floor: 900, name: 'Unsettling', pebbles: 5 },\n] as const;\n\n/** The rank a score earns. */\nexport function rankOf(score: number): (typeof RANKS)[number] {\n  let at: (typeof RANKS)[number] = RANKS[0];\n  for (const rank of RANKS) if (score >= rank.floor) at = rank;\n  return at;\n}\n\n/** The Wobble Age from a score of 0 to 1. */\nexport const ageOf = (s: number, k: number): number =>\n  Math.round(18 + 64 * Math.pow(Math.max(0, Math.min(1, 1 - s)), k));\n\n/** What the cairn unlocks, by pebbles. */\nexport const UNLOCKS = [\n  { at: 10, id: 'expert' },\n  { at: 20, id: 'colours' },\n  { at: 30, id: 'headband' },\n  { at: 40, id: 'stamps' },\n] as const;\nE\ncat > labs/game/scenes/data/places.ts <<'E'\n/**\n * @file What lies around the island: the 12 plaques, the 20 hidden pebbles, the benches and the props that dress each\n * station, as plain rows. Heights come from the ground at run time. Add a row, get a thing.\n */\nexport const PLAQUES: readonly (readonly [number, number])[] = [\n  [10, 44], [-14, 30], [-40, 8], [-62, -4], [42, 12], [60, 34], [-48, 74], [24, -38], [-10, -72], [52, 74], [70, -46], [64, -2],\n]; // prettier-ignore\n\nexport const HIDDEN_PEBBLES: readonly (readonly [number, number])[] = [\n  [26, 60], [-26, 56], [-74, 30], [-84, 2], [-52, -38], [-24, -60], [16, -62], [52, -30], [78, -24], [82, 18],\n  [72, 40], [46, 62], [10, 78], [-14, 72], [-36, 44], [-20, 12], [20, 16], [34, -14], [-30, -18], [6, -30],\n]; // prettier-ignore\n\nexport const BENCHES: readonly (readonly [number, number, number])[] = [\n  [12, 22, 0], [-30, 34, 1.2], [38, 40, -1.2], [8, -56, 3.1], [-66, 40, 1.8],\n]; // prettier-ignore\n\n/** Static dressing: [prop, x, z, yaw]. */\nexport const DRESSING: readonly (readonly [string, number, number, number])[] = [\n  ['prop:platform', 0, 28, 0], ['prop:noticeboard', 12, 34, -1.57], ['prop:drinksTable', -11, 40, 0],\n  ['prop:pavilion', -52, 18, 0], ['prop:jettyPosts', -70, -14, 0], ['prop:annex', 52, 22, 0],\n  ['prop:hut', 64, 52, 3.1], ['prop:hut', 74, 58, 2.6], ['prop:hut', 54, 60, 3.4],\n  ['prop:ferryPier', 0, 96, 0], ['prop:lighthouse', 84, -60, 0], ['prop:centreStone', 0, 0, 0],\n  ['prop:sandTerrace', 30, -48, 0], ['prop:eastTerrace', 74, 8, 0], ['prop:cliffLip', 0, -88, 0],\n  ['prop:parasol', 58, 90, 0], ['prop:parasol', 70, 86, 1], ['prop:lounger', 62, 92, 0.2], ['prop:lounger', 74, 88, -0.4],\n  ['prop:palm', -18, 46, 0], ['prop:palm', 22, 50, 1], ['prop:palm', -70, 64, 2], ['prop:palm', -40, 66, 0.5], ['prop:palm', 84, 40, 3],\n  ['prop:palm', 44, 70, 1.4], ['prop:palm', 16, 72, 4], ['prop:palm', -16, 66, 2], ['prop:palm', 70, 20, 1], ['prop:palm', -74, 8, 4],\n  ['prop:rock', -44, 84, 0], ['prop:rock', 40, -70, 1], ['prop:rock', -70, -50, 2], ['prop:rock', 90, 0, 3], ['prop:rock', -92, 30, 4],\n  ['prop:rock', 18, -82, 5], ['prop:rock', -20, -84, 0.6], ['prop:rock', 70, 72, 2.2],\n]; // prettier-ignore\nE\ncat > labs/game/scenes/events/tilt.ts <<'E'\n/**\n * @file The Great Tilt (PLAN.md section 7), the finale: every verb at the scale of the world. The storm comes, the island\n * tips, guests drift downhill politely and a Calm Call leads them to the high side; two carts of your pebbles are cranked\n * uphill; then you stand on the plate that says \"Do not\", and your balance is the island's. No fail state, only remarks.\n */\nimport { stepCrowdBody } from '../../../../engine/sim-api';\nimport { clearBody, setLoop, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { STATIONS } from '../data/stations';\nimport { gameNumber } from '../settings';\nimport { cue, islandOf, say, type C, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble, stepBreath, stepWobble, syncShare } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { bothHeld, clamp, footDown, groundAt, hover, inRing, moveProp, ownProp, phase, playing, standAt, type Activity } from './kit';\n\nconst STORM = 1200;\nconst EAST = 4500;\nconst CARTS = 2700;\nconst STONE = 3600;\nconst DAWN = 1500;\nconst CALM_HOLD = 120;\nconst WAVE_R = 8;\nconst DELIVER_R = 11;\nconst START_TILT = 6;\n\n/** A guest in the storm. */\ninterface Drifter { body: number; named: boolean; x: number; z: number; follow: boolean; home: boolean; nan: boolean }\n\ninterface TiltData { guests: Drifter[]; delivered: number; call: number; wave: number; cart: number; last: string; lurch: number; ring: number; inside: number; steps: number; x: number; z: number; carts: number[]; loungers: number[]; lx: number[]; waves: number; endScore: number; cartLast: number; line: number; only: string }\nconst dataOf = (ev: EvState): TiltData => ev.d as unknown as TiltData;\n\ntype ActorOf = { actor: C['actor'] & { intents: Record<string, unknown> } };\n\n/** The slope's downhill push, m/s, for the current tilt. */\nexport function slopePush(tiltDeg: number): number {\n  return Math.sin((Math.abs(tiltDeg) * Math.PI) / 180) * 12;\n}\n\n/** Moves the crowd bodies each step (their rigs step in `anim`). */\nfunction stepDrifters(w: W, d: TiltData): void {\n  const island = islandOf(w);\n  const push = slopePush(island.tiltX);\n  const gx = (w.get(castOf(w).guest) as unknown as ActorOf).actor;\n  for (const g of d.guests) {\n    if (g.home) continue;\n    let vx = -push * 0.5;\n    let vz = Math.sin(w.tick * 0.013 + g.body) * 0.25;\n    if (g.follow) {\n      const [dx, dz] = [gx.x - 1.5 - g.x, gx.z - g.z];\n      const len = Math.hypot(dx, dz);\n      if (len > 2.5) {\n        vx += (dx / len) * 4.6;\n        vz += (dz / len) * 4.6;\n      } else vx *= 0.1;\n    }\n    if (g.nan) [vx, vz] = [(STATIONS.east.x - g.x) * 0.02, (STATIONS.east.z - g.z) * 0.02];\n    g.x = clamp(g.x + vx / 60, -82, 90);\n    g.z = clamp(g.z + vz / 60, -60, 70);\n    if (Math.hypot(g.x - STATIONS.east.x, g.z - STATIONS.east.z) < DELIVER_R) {\n      g.home = true;\n      g.follow = false;\n      if (!g.nan) {\n        d.delivered += 1;\n        island.tiltX = Math.max(1, island.tiltX - 0.5);\n        cue(w, 'ding', { n: d.delivered });\n        say(w, `tilt.delivered.${(d.delivered % 4) + 1}`, 'plumb');\n      }\n    }\n  }\n}\n\n/** Draws the guests where they are. Named people are actors; the rest are crowd bodies, stepped by the system below. */\nfunction drawDrifters(w: W, d: TiltData): void {\n  for (const g of d.guests) {\n    if (g.named) standAt(w, g.body, g.x, g.z, Math.PI / 2);\n  }\n}\n\n/** The system that steps the crowd humanoids in `anim`, as the engine asks. */\nexport function stepTiltCrowd(w: W): void {\n  const ev = (w.query('flow')[0] as unknown as { flow: { ev: EvState | null } }).flow.ev;\n  if (!ev || ev.id !== 'tilt') return;\n  const d = dataOf(ev);\n  for (const g of d.guests ?? []) {\n    if (g.named) continue;\n    const entity = w.get(g.body) as unknown as { id: number; crowdBody: never } | undefined;\n    if (!entity) continue;\n    stepCrowdBody(w as never, g.body, entity.crowdBody, { at: [g.x, groundAt(w, g.x, g.z), g.z], velocity: [0, 0, 0], yaw: Math.PI / 2 } as never);\n  }\n}\n\nconst walkTo = (w: W, e: SeatE, slope: number): void => {\n  const entity = w.get(e.seat.actor) as unknown as ActorOf;\n  entity.actor.intents = { move: [clamp(e.seat.input.y - slope * 0.1, -1, 1), clamp(e.seat.input.x, -1, 1)] };\n};\n\nfunction eastStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  island.tiltX += (gameNumber(w, 'game.tilt.rate') / 60) * 1;\n  walkTo(w, e, slopePush(island.tiltX));\n  if (bothHeld(e)) {\n    d.call += 1;\n    setPose(w, e.seat.actor, 'RETREAT/CalmCall', clamp(d.call / CALM_HOLD, 0, 1));\n  } else {\n    if (d.call >= CALM_HOLD) {\n      d.wave = 40;\n      cue(w, 'calmWave');\n      const { actor } = w.get(e.seat.actor) as unknown as ActorOf;\n      for (const g of d.guests) if (!g.home && Math.hypot(g.x - actor.x, g.z - actor.z) <= WAVE_R) g.follow = true;\n    }\n    if (d.call > 0) clearBody(w, e.seat.actor);\n    d.call = 0;\n  }\n  d.wave = Math.max(0, d.wave - 1);\n  stepDrifters(w, d);\n  drawDrifters(w, d);\n  // loungers slide through, and go round again\n  d.loungers.forEach((id, k) => {\n    d.lx[k] -= (slopePush(island.tiltX) * 1.6) / 60;\n    if (d.lx[k] < -60) d.lx[k] = 80;\n    moveProp(w, id, [d.lx[k], groundAt(w, d.lx[k], 20 + k * 8), 20 + k * 8]);\n  });\n  const left = d.guests.filter((g) => !g.home && !g.nan).length;\n  if (left === 0 || ev.t >= EAST) {\n    if (left) say(w, 'tilt.shuffle', 'plumb');\n    for (const g of d.guests) if (!g.home) Object.assign(g, { home: true, x: STATIONS.east.x + (g.body % 7) - 3, z: STATIONS.east.z + (g.body % 5) - 2 });\n    drawDrifters(w, d);\n    for (const id of d.loungers) moveProp(w, id, [0, -30, 0]);\n    (w.get(e.seat.actor) as unknown as ActorOf).actor.intents = {};\n    resetWobble(e.wobble);\n    island.finale = 3;\n    standAt(w, e.seat.actor, -10, 40, Math.PI / 2);\n    say(w, 'tilt.carts', 'plumb');\n    phase(ev, 'carts');\n  }\n}\n\nfunction cartsStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  stepBreath(w, e, w.tick);\n  stepWobble(w, e, [-slopePush(island.tiltX) * 0.7, 0]);\n  const left = footDown(e, 'l');\n  const right = footDown(e, 'r');\n  if (left !== right) {\n    const foot = left ? 'l' : 'r';\n    if (foot !== d.last && inRing(e, 0.3, 0, 0.45)) {\n      d.cart = Math.min(1, d.cart + 0.03);\n      cue(w, 'crank');\n    }\n    d.last = foot;\n  }\n  setLoop(w, e.seat.actor, 'RETREAT/Crank', d.cartLast === Math.floor(d.cart * 100) ? 0.2 : 1.2);\n  d.cartLast = Math.floor(d.cart * 100);\n  d.carts.forEach((id, k) => moveProp(w, id, [-10 + d.cart * 22 - k * 4, 8.1, 42 + k * 2.2]));\n  (w.get(e.seat.actor) as unknown as ActorOf).actor.intents = {};\n  if (d.cart >= 1 || ev.t >= CARTS) {\n    island.tiltX = Math.max(1, island.tiltX - 1.5 * d.cart);\n    if (d.cart < 1) say(w, 'tilt.cartsTime', 'plumb');\n    else say(w, 'tilt.cartsDone', 'tare');\n    resetWobble(e.wobble);\n    clearBody(w, e.seat.actor);\n    island.finale = 4;\n    d.line = 0;\n    say(w, 'tilt.stone', 'plumb');\n    phase(ev, 'stone');\n  }\n}\n\nfunction stoneStep(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const island = islandOf(w);\n  stepBreath(w, e, w.tick);\n  const k = ev.t / STONE;\n  d.waves = (0.6 + k * 1.2) * 3;\n  const shove: [number, number] = [Math.sin(ev.t * 0.021) * d.waves, Math.sin(ev.t * 0.017 + 1) * d.waves * 0.8];\n  const before = e.wobble.topples;\n  stepWobble(w, e, shove);\n  if (e.wobble.topples > before) {\n    d.lurch += 3;\n    say(w, 'tilt.again', 'plumb');\n    cue(w, 'groan');\n  }\n  d.lurch *= 0.995;\n  d.ring = 0.3 - 0.13 * k;\n  d.steps += 1;\n  if (inRing(e, 0, 0, d.ring)) d.inside += 1;\n  island.tiltX = e.wobble.x * 8 + d.lurch;\n  island.tiltZ = e.wobble.y * 8;\n  const y = groundAt(w, d.x, d.z);\n  hover(w, e.seat.actor, d.x, y + 0.42, d.z, 0);\n  setPose(w, e.seat.actor, 'RETREAT/LineStand', 1);\n  if (ev.t >= STONE) {\n    const breath = syncShare(e.wobble);\n    d.endScore = (0.3 * d.delivered) / 11 + (0.5 * d.inside) / Math.max(1, d.steps) + 0.2 * breath;\n    say(w, 'tilt.level', 'plumb');\n    cue(w, 'groan');\n    phase(ev, 'dawn');\n  }\n}\n\nfunction dawnStep(w: W, ev: EvState, e: SeatE): void {\n  const island = islandOf(w);\n  island.storm = Math.max(0, island.storm - 1 / 300);\n  island.tiltX *= 0.98;\n  island.tiltZ *= 0.98;\n  const { plumb } = castOf(w);\n  void e;\n  if (ev.t === 360) {\n    w.emit('plumbEyes', { open: true } as never);\n    say(w, 'tilt.hm', 'plumb');\n  }\n  if (ev.t === 480) w.emit('plumbEyes', { open: false } as never);\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\n  if (ev.t >= DAWN) {\n    island.finale = 0;\n    island.tiltX = 0;\n    island.tiltZ = 0;\n    ev.score = Math.round(clamp(dataOf(ev).endScore, 0, 1) * 1000);\n    ev.done = true;\n  }\n}\n\nfunction step(w: W, ev: EvState): void {\n  const [e] = playing(w, ev);\n  const island = islandOf(w);\n  if (ev.phase === 'storm') {\n    island.storm = clamp(ev.t / 300, 0, 1);\n    island.tiltX = clamp((ev.t / STORM) * START_TILT, 0, START_TILT);\n    if (ev.t === 60) cue(w, 'horn');\n    if (ev.t === 240) cue(w, 'thunder');\n    if (ev.t === 360) w.emit('plait', { swing: true } as never);\n    if (ev.t === 480) say(w, 'tilt.calm', 'plumb');\n    const { plumb } = castOf(w);\n    if (plumb >= 0) standAt(w, plumb, 3, 28 + Math.sin(ev.t * 0.05) * 0.4, Math.sin(ev.t * 0.04) * 0.35);\n    if (ev.t >= STORM || (e.seat.kind === 'human' && e.seat.input.act && ev.t > 300)) {\n      island.finale = 2;\n      island.tiltX = START_TILT;\n      say(w, 'tilt.east', 'plumb');\n      phase(ev, 'east');\n    }\n    return;\n  }\n  if (ev.phase === 'east') return eastStep(w, ev, e);\n  if (ev.phase === 'carts') return cartsStep(w, ev, e);\n  if (ev.phase === 'stone') return stoneStep(w, ev, e);\n  if (ev.phase === 'dawn') return dawnStep(w, ev, e);\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  const d = dataOf(ev);\n  const { actor } = w.get(e.seat.actor) as unknown as ActorOf;\n  if (ev.phase === 'east') {\n    const followers = d.guests.filter((g) => g.follow && !g.home).length;\n    const lost = d.guests.filter((g) => !g.follow && !g.home && !g.nan);\n    const near = lost.reduce<Drifter | null>((best, g) => (!best || Math.hypot(g.x - actor.x, g.z - actor.z) < Math.hypot(best.x - actor.x, best.z - actor.z) ? g : best), null);\n    const goEast = followers >= 3 || !near;\n    const [tx, tz] = goEast ? [STATIONS.east.x, STATIONS.east.z] : [near.x, near.z];\n    const far = Math.hypot(tx - actor.x, tz - actor.z);\n    if (!goEast && far < 6) {\n      const hold = d.call < CALM_HOLD + 4;\n      return hold ? { stick: [0, 0], l: 1, r: 1, raw: true } : { stick: [0, 0] };\n    }\n    return { stick: [clamp((tz - actor.z) / 6, -1, 1), clamp((tx - actor.x) / 6, -1, 1)], raw: true };\n  }\n  if (ev.phase === 'carts') {\n    const beat = w.tick % 40;\n    const order: Order = { aim: [0.3, 0] };\n    if (beat < 8) order.l = 1;\n    else if (beat >= 20 && beat < 28) order.r = 1;\n    return order;\n  }\n  if (ev.phase === 'stone') {\n    const steps = Math.round(gameNumber(w, 'game.breath.period') * 60);\n    const feet = (w.tick + steps - skill.timing) % steps < steps / 2 ? 1 : 0;\n    return { aim: [0, 0], l: feet, r: feet };\n  }\n  return {};\n}\n\nexport const TILT: Activity = {\n  id: 'tilt', title: 'The Great Tilt', station: 'plaza', shot: 'tilt', map: 'balance', song: 'song:tilt',\n  setup(w, ev) {\n    const [e] = playing(w, ev);\n    const cast = castOf(w);\n    const island = islandOf(w);\n    resetWobble(e.wobble);\n    island.finale = 1;\n    ev.s[e.seat.index] = {};\n    const rng = w.rng('tilt');\n    const guests: Drifter[] = [];\n    const named = [cast.gerald, cast.bex, cast.nan];\n    for (let k = 0; k < 12; k++) {\n      const x = rng.range(-26, 30);\n      const z = rng.range(14, 54);\n      if (k < 3 && named[k] >= 0) {\n        guests.push({ body: named[k], named: true, x, z, follow: false, home: false, nan: named[k] === cast.nan });\n      } else {\n        const y = groundAt(w, x, z);\n        const body = w.spawn({ crowdBody: { rig: 'humanoid', look: 'build:chibi', x, y, z, yaw: 0 } } as never);\n        ev.owned.push(body);\n        guests.push({ body, named: false, x, z, follow: false, home: false, nan: false });\n      }\n    }\n    const carts = [0, 1].map((k) => ownProp(w, ev, 'prop:cart', [-10 - k * 4, 8.1, 42 + k * 2.2]));\n    ownProp(w, ev, 'prop:rails', [1, 8.02, 43]);\n    const loungers = [0, 1, 2].map((k) => ownProp(w, ev, 'prop:lounger', [80 - k * 45, -30, 20 + k * 8]));\n    Object.assign(ev.d, { guests, delivered: 0, call: 0, wave: 0, cart: 0, last: '', lurch: 0, ring: 0.3, inside: 0, steps: 0, x: STATIONS.stone.x, z: STATIONS.stone.z, carts, loungers, lx: [80, 35, -10], waves: 0, endScore: 0, cartLast: 0, line: 0 });\n    standAt(w, e.seat.actor, 0, 32, Math.PI / 2);\n    say(w, 'tilt.storm', 'pa');\n    if (ev.d.only === 'stone') {\n      island.finale = 4;\n      island.storm = 1;\n      island.tiltX = START_TILT;\n      phase(ev, 'stone');\n      return;\n    }\n    phase(ev, 'storm');\n  },\n  step, bot,\n  teardown(w) {\n    const island = islandOf(w);\n    Object.assign(island, { finale: 0, tiltX: 0, tiltZ: 0, storm: 0 });\n  },\n}; // prettier-ignore\nE\ncat > labs/game/scenes/events/index.ts <<'E'\n/**\n * @file Every activity by id. Adding an activity is a module and a row here (and rows in days.ts and the line files).\n */\nimport type { Activity } from './kit';\nimport { CHECK, RING_CLASS } from './ring';\nimport { POSE_ACTIVITIES } from './pose';\nimport { POND, POND_SHORT } from './pond';\nimport { REPS } from './reps';\nimport { STEP, STEP_SHORT } from './step';\nimport { HOOP, HOOP_SHORT } from './hoop';\nimport { LINE } from './line';\nimport { PADDLE } from './paddle';\nimport { GARDEN } from './garden';\nimport { PLUNGE } from './plunge';\nimport { JOG } from './jog';\nimport { TILT } from './tilt';\n\nconst LIST: readonly Activity[] = [CHECK, RING_CLASS, ...POSE_ACTIVITIES, POND, POND_SHORT, REPS, STEP, STEP_SHORT, HOOP, HOOP_SHORT, LINE, PADDLE, GARDEN, PLUNGE, JOG, TILT]; // prettier-ignore\n\nexport const ACTIVITIES: Readonly<Record<string, Activity>> = Object.fromEntries(LIST.map((a) => [a.id, a]));\n\n/** The activities the balance tests hold to the plan's targets. */\nexport const PLAYED = ['check', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'step', 'line', 'paddle', 'garden', 'plunge', 'hoop', 'jog', 'ring', 'heron', 'hoopS', 'stepS', 'pondS'] as const;\nE\n","description":"Write finale, days data, places, activities index"}}}
