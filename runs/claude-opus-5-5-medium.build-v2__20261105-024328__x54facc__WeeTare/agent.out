ath.round(v / 64) * 64;\n    moveProp(w, seaOf.near, [snap(guest.x) + Math.sin(island.seaT * 0.05) * 2, SEA_Y + bob + 0.03, snap(guest.z) + island.seaT * 0.1 % 16], tiltQuat(leanZ, lean));\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/types.ts';s=open(p).read()\ns=s.replace(\"defineComponent('seaProp', { description: 'The sea.', fields: { id: { type: 'integer', default: -1, description: 'Its prop.' } } });\",\"defineComponent('seaProp', { description: 'The sea.', fields: { id: { type: 'integer', default: -1, description: 'Its prop.' }, near: { type: 'integer', default: -1, description: 'The textured water near you.' } } });\")\nopen(p,'w').write(s)\nE\ncat > .t/hub.py <<'E'\nimport sys,json,time,subprocess,re,os,shutil\nfrom playwright.sync_api import sync_playwright\nbuilt=sys.argv[1]; players=sys.argv[2:] or ['2']\nd='.t/srv'; os.makedirs(d,exist_ok=True)\nshutil.copy(built,d+'/game.html')\nfor f in ['harness.html','bridge.js','round.js']: shutil.copy('labs/game/hub/'+f,d+'/'+f)\nsrv=subprocess.Popen(['python3','-m','http.server','0','--bind','127.0.0.1','--directory',d],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\nline=srv.stdout.readline(); port=re.search(r'port (\\d+)',line).group(1)\nfails=0\ntry:\n  with sync_playwright() as p:\n    b=p.chromium.launch(headless=True,args=['--no-sandbox','--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n    for spec in players:\n        n,_,sc=spec.partition(':')\n        pg=b.new_page(viewport={'width':1280,'height':800})\n        logs=[]\n        pg.on('console',lambda m: logs.append(m.text[:240]) if m.text.startswith('[AIHub]') or m.type=='error' else None)\n        q=f'game=game.html&players={n}&latency=150&jitter=50&loss=5&auto=1&play=8000'+(f'&scenario={sc}' if sc else '')\n        pg.goto(f'http://127.0.0.1:{port}/harness.html?{q}')\n        t=time.time(); snap=[]\n        while time.time()-t<420:\n            if pg.evaluate(\"()=>document.body.dataset.complete==='true'\"): break\n            st=[]\n            for fr in pg.frames[1:]:\n                try: st.append(fr.evaluate(\"()=>[window.__engine&&window.__engine.ready===true,(window.__engine&&window.__engine.errors||[]).length, window.__engine&&window.__engine.state?window.__engine.state('ghost').entities.length:-1, document.title]\"))\n                except Exception: pass\n            snap=st or snap\n            time.sleep(3)\n        chk=pg.evaluate(\"()=>JSON.stringify(window.__hubCheck||null)\")\n        c=json.loads(chk)\n        ok=c and c.get('pass')\n        if not ok: fails+=1\n        print(spec,'pass',ok,'t',round(time.time()-t),'frames',snap)\n        if not ok: print(chk[:2500])\n        print('\\n'.join(logs[:6]))\n        pg.close()\n    b.close()\nfinally:\n    srv.terminate()\nprint('fails',fails)\nE\n.t/b.sh; timeout 560 python3 .t/hub.py \"$PWD/../WeeTare-WiiFit-claude-opus-5-5-medium-20261105-024328.html\" 2 2>&1 | tail -14 | cut -c1-2200","description":"Split sea near/far, write hub harness runner, run 2 players","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2361,"cache_read_input_tokens":485500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2361},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"fa5d0c89-407c-4399-8483-5066364c4536","timestamp":"2026-11-05T11:10:15.950Z","request_id":"req_011CgjgGFVc4XWy4E6smTu1B","wire_tool_inputs":{"toolu_013dxX6D451FKqbUU23R8G4P":{"command":"python3 - <<'E'\np='labs/game/materials/index.ts';s=open(p).read()\ns=s.replace(\"flat('retreatSea', 'The sea.', '#ffffff', { map: { texture: 'texture:water', se