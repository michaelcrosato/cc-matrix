)\ns=s.replace(\"\"\"      if (speechLeft > 0) {\n        speechLeft -= dt;\n        if (speechLeft <= 0) speech.style.display = 'none';\n      }\n\"\"\",\"      tickSpeech(dt);\\n\")\ns=s.replace(\"    void padHeld;\\n    padHeld = any;\\n\",\"\").replace(\"  let padHeld = false;\\n\",\"\")\ns=s.replace(\"      title: TITLE,\\n\",\"      title: TITLE,\\n      probeAudio,\\n\")\n# imports\ns=s.replace(\"import { updateShot } from './shots';\",\"import { createCtx } from './page-ctx';\\nimport { createDevices } from './page-devices';\\nimport { createEventReader } from './page-events';\\nimport { drawNear } from './hud/near';\\nimport { probeAudio } from '../audio/probe';\\nimport { updateShot } from './shots';\")\ns=s.replace(\"import { UNLOCKS } from '../scenes/data/days';\\n\",\"\")\ns=s.replace(\"import { LINES, lineText, WHO } from './lines';\\n\",\"\")\ns=s.replace(\"import { type Ctx, type Screen, type Settings } from './ctx';\",\"import { type Screen, type Settings } from './ctx';\")\ns=s.replace(\"import { prompt, promptBar } from './glyphs';\",\"import { promptBar } from './glyphs';\")\ns=s.replace(\"import { boardScreen, creditsScreen,\",\"import { creditsScreen,\")\nopen(P,'w').write(s)\n# page-ctx\nbody=ctxblock\nbody=body.replace(\"engine, inspector, input,\\n    nav, store, sound, root, settings, stack, hubActive: inHub,\",\"engine, inspector, input, nav, store, sound, root, settings, stack, hubActive: inHub,\")\nbody=body.replace(\"flowOf(worldNow as W)\",\"flowOf(world())\")\nopen('labs/game/ui/page-ctx.ts','w').write(\"\"\"/**\n * @file Makes the context every screen shares, with the two things it draws itself: the line being spoken, and the fade.\n */\nimport type { Engine, Inspector, Input, Store } from '../../../engine';\nimport type { Sound } from '../audio/sound';\nimport { flowOf, type W } from '../scenes/types';\nimport type { Ctx, Screen, Settings } from './ctx';\nimport { lineText, WHO } from './lines';\nimport type { Nav } from './nav';\n\nexport function createCtx(args: {\n  engine: Engine; inspector: Inspector; input: Input; nav: Nav; store: Store; sound: Sound; root: HTMLElement;\n  settings: Settings; stack: Screen[]; inHub: boolean; world: () => W;\n}): { ctx: Ctx; tickSpeech(dt: number): void } {\n  const { engine, inspector, input, nav, store, sound, root, settings, stack, inHub, world } = args;\n  const speech = document.createElement('div');\n  speech.className = 'wt-speech';\n  speech.dataset.ui = 'speech';\n  speech.style.display = 'none';\n  const fadeEl = document.createElement('div');\n  fadeEl.className = 'wt-fade';\n  root.append(speech, fadeEl);\n  let speechLeft = 0;\n\"\"\"+body+\"\"\"  return {\n    ctx,\n    tickSpeech(dt) {\n      if (speechLeft <= 0) return;\n      speechLeft -= dt;\n      if (speechLeft <= 0) speech.style.display = 'none';\n    },\n  };\n}\n\"\"\")\nopen('labs/game/ui/page-devices.ts','w').write(\"\"\"/**\n * @file The device used last, the mouse's running total for the lean, and pause and the Programme read from the devices directly:\n * `input.pressed` only holds a press for the last sim step's sample, and a frame can run several steps, so a read in the frame\n * misses it. Menus have no mouse bindings for the engine's own tracking to see, either.\n */\nexport function createDevices(root: HTMLElement, map: () => string, open: () => number) {\n  const setDevice = (device: string) => {\n    if (root.dataset.device !== device) root.dataset.device = device;\n  };\n  addEventListener('keydown', () => setDevice('keys'), true);\n  addEventListener('pointerdown', (event) => {\n    if (event.pointerType === 'mouse') setDevice('mouse');\n  }, true); // prettier-ignore\n  addEventListener('pointermove', (event) => {\n    if (event.pointerType === 'mouse' && Math.abs(event.movementX) + Math.abs(event.movementY) > 2) setDevice('mouse');\n  }, true); // prettier-ignore\n  const mouseTotal = [0, 0];\n  const settingsOf = { mouse: 1 };\n  addEventListener('pointermove', (event) => {\n    if (!document.pointerLockElement) return;\n    mouseTotal[0] += event.movementX * 0.0035 * settingsOf.mouse;\n    mouseTotal[1] -= event.movementY * 0.0035 * settingsOf.mouse;\n  });\n  const keysAsked = { pause: false, plan: false };\n  addEventListener('keydown', (event) => {\n    if (event.repeat) return;\n    if (event.code === 'Escape') keysAsked.pause = true;\n    if (event.code === 'Tab') {\n      keysAsked.plan = true;\n      event.preventDefault();\n    }\n  });\n  // Esc under pointer lock goes to the browser, which only gives the pointer back: that is the player asking to pause\n  document.addEventListener('pointerlockchange', () => {\n    if (!document.pointerLockElement && (map() === 'actionMap:balance' || map() === 'actionMap:roam') && !open()) keysAsked.pause = true;\n  });\n  const padWas = { pause: false, plan: false };\n  function askedFor(): { pause: boolean; plan: boolean } {\n    const pad = (navigator.getGamepads?.() ?? []).find((one) => one);\n    const options = pad?.buttons[9]?.pressed ?? false;\n    const triangle = pad?.buttons[3]?.pressed ?? false;\n    const out = {\n      pause: keysAsked.pause || (options && !padWas.pause && !pad?.buttons[8]?.pressed),\n      plan: keysAsked.plan || (triangle && !padWas.plan),\n    };\n    [padWas.pause, padWas.plan] = [options, triangle];\n    [keysAsked.pause, keysAsked.plan] = [false, false];\n    return out;\n  }\n  return { setDevice, askedFor, mouseTotal, settingsOf };\n}\n\"\"\")\nev=evblock.replace(\"  /** Reads the sim's events this frame. */\\n  function events(frame: EngineFrame, flow: Flow): void {\",\"  function read(frame: EngineFrame, flow: Flow): void {\").replace(\"  function rumble(\",\"  function rumble(\")\nopen('labs/game/ui/page-events.ts','w').write(\"\"\"/**\n * @file Reads the sim's events each frame and turns them into lines, sound, rumble and the odd screen. New records only, by number.\n */\nimport type { EngineFrame } from '../../../engine';\nimport { UNLOCKS } from '../scenes/data/days';\nimport type { Flow } from '../scenes/types';\nimport type { Ctx } from './ctx';\nimport { LINES } from './lines';\nimport { boardScreen } from './screens/programme';\n\nexport function createEventReader(ctx: Ctx) {\n  const { sound, settings } = ctx;\n  const seen: { world: unknown; seq: number } = { world: null, seq: 0 };\n\"\"\"+ev+\"\"\"  return { read, rumble };\n}\n\"\"\")\nopen('labs/game/ui/hud/near.ts','w').write(\"\"\"/**\n * @file The prompt beside the thing you could use on the island.\n */\nimport { ACTIVITIES } from '../../scenes/events';\nimport type { Flow } from '../../scenes/types';\nimport { prompt } from '../glyphs';\n\nconst VERBS: Readonly<Record<string, string>> = { npc: 'Talk', plaque: 'Read', board: 'Noticeboard', hut: 'Sleep', bench: 'Sit' };\n\nexport function drawNear(near: HTMLElement, flow: Flow, free: boolean): void {\n  const on = flow.mode === 'roam' && !!flow.near && free;\n  near.style.display = on ? '' : 'none';\n  if (!on || near.dataset.near === flow.near) return;\n  near.dataset.near = flow.near;\n  const [kind, id] = flow.near.split(':');\n  near.innerHTML = prompt('use', VERBS[kind] ?? `Begin ${ACTIVITIES[id]?.title ?? (id === 'group' ? 'Group Class' : id)}`);\n}\n\"\"\")\nopen('labs/game/audio/probe.ts','w').write(\"\"\"/**\n * @file Sound by numbers in the browser, since nobody can listen here: renders a song and a voice through the real runtime into an\n * OfflineAudioContext and reports their peaks, with the music bus at full and at the default 10%.\n */\nimport { createAudio } from '../../../engine';\nimport { babble } from './voice';\n\nconst peak = (buffer: AudioBuffer): number => buffer.getChannelData(0).reduce((max, v) => Math.max(max, Math.abs(v)), 0);\n\nasync function render(fill: (context: OfflineAudioContext) => void): Promise<number> {\n  const context = new OfflineAudioContext(2, 44100 * 4, 44100);\n  fill(context);\n  return peak(await context.startRendering());\n}\n\n/** The peaks: `song` at 100%, `quiet` at 10%, `voice` for one babbled line. */\nexport async function probeAudio(): Promise<{ song: number; quiet: number; voice: number }> {\n  const song = (level: number) => (context: OfflineAudioContext) => {\n    const audio = createAudio({ context } as never);\n    audio.volume('music', level);\n    audio.music('song:lobby', { intensity: 1 } as never);\n    audio.update();\n  };\n  const [loud, quiet, voice] = [\n    await render(song(1)),\n    await render(song(0.1)),\n    await render((context) => void babble(createAudio({ context } as never), 'tare', 'Please keep to the centre.', 1)),\n  ];\n  return { song: loud, quiet, voice };\n}\n\"\"\")\n# mouse sensitivity wired\ns=open(P).read()\ns=s.replace(\"  const { setDevice, askedFor, mouseTotal } = devices;\\n\",\"  const { setDevice, askedFor, mouseTotal } = devices;\\n  devices.settingsOf.mouse = settings.mouse;\\n\")\ns=s.replace(\"      lastFrame = frame;\\n\",\"      lastFrame = frame;\\n      devices.settingsOf.mouse = settings.mouse;\\n\")\nopen(P,'w').write(s)\n# walk\nF='labs/game/scenes/flow.ts'; s=open(F).read()\ns=s.replace(\"if (id === 'walk') return void w.emit('goWalk', {} as never);\",\"if (id === 'walk') return standAt(w, castOf(w).guest, 12, 38, Math.PI); // the pilot notices you have arrived\")\nopen(F,'w').write(s)\n# tilt split\nT='labs/game/scenes/events/tilt.ts'; s=open(T).read()\na=s.index(\"/** The slope's downhill push\"); b=s.index(\"const walkTo\")\nblock=s[a:b]; s=s[:a]+s[b:]\nm=re.search(r\"/\\*\\* A guest in the storm\\. \\*/\\ninterface Drifter \\{.*?\\n\\}\\n\",s,re.S)\ndrifter=m.group(0); s=s.replace(drifter,\"\")\ns=s.replace(\"const DELIVER_R = 11;\\n\",\"\")\ns=s.replace(\"guests: Drifter[];\",\"guests: Drifter[];\",1)\ns=s.replace(\"import { spawnPerson } from '../../cast/people';\",\"import { spawnPerson } from '../../cast/people';\\nimport { drawDrifters, slopePush, stepDrifters, type Drifter } from './tilt-guests';\")\nopen(T,'w').write(s)\nblock=block.replace(\"function stepDrifters(w: W, d: TiltData)\",\"export function stepDrifters(w: W, d: Pick<Guests, 'guests' | 'delivered'>)\").replace(\"function drawDrifters(w: W, d: TiltData)\",\"export function drawDrifters(w: W, d: Pick<Guests, 'guests'>)\")\nblock=block.replace(\"const d = dataOf(ev);\",\"const d = ev.d as unknown as Pick<Guests, 'guests'>;\")\nopen('labs/game/scenes/events/tilt-guests.ts','w').write(\"\"\"/**\n * @file The Great Tilt's guests: drifting downhill politely, following a Calm Call, arriving on the East Terrace. Gerald, Bex and Nan\n * are actors; the rest are crowd bodies, stepped in the phase `anim`. All are carried along, so none can stick.\n */\nimport { stepCrowdBody } from '../../../../engine/sim-api';\nimport { castOf } from '../cast-ref';\nimport { STATIONS } from '../data/stations';\nimport { cue, islandOf, say, type C, type EvState, type W } from '../types';\nimport { clamp, groundAt, standAt } from './kit';\n\nconst DELIVER_R = 11;\n\n\"\"\"+drifter.replace(\"interface Drifter\",\"export interface Drifter\")+\"\"\"\ninterface Guests { guests: Drifter[]; delivered: number }\ntype ActorOf = { actor: C['actor'] & { intents: Record<string, unknown> } };\n\n\"\"\"+block)\nI='labs/game/scenes/island.ts'; s=open(I).read()\ns=s.replace(\"import { stepTiltCrowd } from './events/tilt';\",\"import { stepTiltCrowd } from './events/tilt-guests';\")\nopen(I,'w').write(s)\n# line tune\nL='labs/game/scenes/events/line.ts'; s=open(L).read()\ns=s.replace(\"gameNumber(w, 'game.line.gust') * 3\",\"gameNumber(w, 'game.line.gust') * 6\")\nopen(L,'w').write(s)\nE\nnpx prettier --write labs/game --log-level warn; npx tsc -b tsconfig.check.json 2>&1 | head -20 | cut -c1-170; npx eslint labs/game 2>&1 | grep -E \" error |warning  File\" | cut -c1-130 | head; wc -l labs/game/ui/page.ts labs/game/scenes/events/tilt.ts","description":"Split page.ts and tilt.ts, fix walk, add audio probe, tune line","timeout":200000},"caller":{"type":"direct"}}],"contain