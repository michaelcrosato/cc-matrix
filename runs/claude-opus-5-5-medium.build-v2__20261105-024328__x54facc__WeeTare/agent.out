rt (`SET/Clip`, or the clip and how it plays: the layer's `play`); none when absent. */\n59-  play?: string | ({ clip: string } & ClipPlay);\n60-}\n61-\n62-/** An entity with an animated actor and its clips. */\n63-type ClipActor = Pick<ActorComponents, 'actor' | 'animator'> & { id: number; clips: ClipsData };\n64-\n65-/** The layers of each world (see the file comment). */\n--\n93:export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\n94-  const w = world as unknown as World;\n95-  const pool = poolOf(w);\n96-  const library = spec.sets.map((set) => pool.library(set));\n97-  if (!w.systems.has('actors.clips')) w.systems.add('actors.clips', stepClips, { phase: 'anim' });\n98-  const data = { sets: [...spec.sets], ik: spec.ik ?? true, blade: spec.blade ?? 0, state: emptyClipState() };\n99-  if (spec.play === undefined) return data;\n100-  const { clip, ...play } = typeof spec.play === 'string' ? { clip: spec.play } : spec.play;\n4: * `press('jump')` taps an action for the next step, `hold('sprint')` keeps one down, `axis('move', [0, 1])` pushes a\n5: * virtual stick (`[right, forward]`, turned by the camera as keys are), and `axis('cam' | 'look' | 'aim' | 'game:…',\n19: * pad.axis('move', [0, 1]);\n36:    fix: \"press(action) and hold(action) take an action's name; axis takes 'move' or 'look' [x, y], 'aim' [x, y, z], 'cam' (rad) or a 'ga\n37:    doc: 'Raised by the virtual device (engine/input/devices/virtual.ts) and `__engine.input` for an empty action name, an unknown axis, \n60:  /** Sets an axis: `move` `[right, forward]`, `look`, `aim`, `cam` or a `game:key`; `null` lets go. */\n61:  axis(name: string, value: unknown): void;\n95:    axis(name, value) {\n98:        throw codeError('INPUT_BAD_VIRTUAL', { what: `axis(${show(name)})`, problem: 'no such axis' });\n122:/** A checked copy of an axis value, or `INPUT_BAD_VIRTUAL`. */\n131:  throw codeError('INPUT_BAD_VIRTUAL', { what: `axis(${show(name)})`, problem: `${show(value)} is not ${want}` });\n134:/** One step's intents from a virtual sample: `move` turned by the heading `yaw` (the `cam` axis when it holds one). */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014sVvsAUaPy8coUjmEo3m1g","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
