's own).\n62:export type SceneAction<W> = (w: W, args: unknown) => void;\n96:  /** Its dev actions, by name. */\n97:  actions?: Readonly<Record<string, SceneAction<World<C, E>>>>;\n129:  actions: {\n132:    description: 'Dev actions by name, (w, args) => void: run between steps by a session and recorded in replays.',\n142:/** The problems of a scene entry beyond its fields: settings the schema refuses, actions that are not functions. */\n145:  const actions = entry.actions as Record<string, unknown>;\n146:  for (const [name, action] of Object.entries(actions)) {\n147:    if (typeof action !== 'function') problems.push(`actions.${name} is not a function (w, args) => void`);\nx help: ok: 24 commands: node x <cmd> [args]; node x help <cmd> for one\n  anim, audio, check, describe, dump, engine, eval, evals, eye, feel, film, gallery, help, inspect, lab, mcp\n  new, perf, qa, replay, set, sheet, shot, sim\neach with what it does: out/help/all/commands.txt\nreport: out/help/all/report.json\n23: *   roughness: { type: 'number', default: 1, minimum: 0, maximum: 1, description: 'Microfacet roughness.' },\n24: *   side: { type: 'string', enum: ['front', 'back', 'double'], default: 'front', description: 'Faces drawn.' },\n25: *   onHit: { type: 'function', default: () => 0, description: 'Called when hit; returns extra damage.' },\n104:  : F extends { type: 'number' | 'integer' }\n106:    : F extends { type: 'boolean' }\n108:      : F extends { type: 'string' }\n110:        : F extends { type: 'array'; items: infer I }\n112:          : F extends { type: 'array' }\n114:            : F extends { type: 'object'; properties: infer P extends Schema }\n116:              : F extends { type: 'object' }\n118:                : F extends { type: 'function'; default: infer D }\n120:                  : F extends { type: 'function' }\n164:  hook: \"type: 'function'\",\n48:export type FieldType = 'number' | 'integer' | 'boolean' | 'string' | 'array' | 'object' | 'function' | 'any';\n56:  'array',\n57:  'object',\n59:  'any',\n110:        : F extends { type: 'array'; items: infer I }\n112:          : F extends { type: 'array' }\n114:            : F extends { type: 'object'; properties: infer P extends Schema }\n116:              : F extends { type: 'object' }\n176:  if (typeof value !== 'object' || value === null) return false;\n195:  if (typeof value === 'object') return isPlainObject(value) ? 'an object' : `a ${value.constructor?.name ?? 'value'}`;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DcGqahaTmnfrW2EnzMFpsh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
