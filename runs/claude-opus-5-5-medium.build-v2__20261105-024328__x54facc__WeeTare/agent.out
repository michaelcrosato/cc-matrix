de<DeviceKind, 'virtual'> {\nengine/input/codes.ts-140-  const base = heldBase(code);\nengine/input/codes.ts-141-  if (base !== null) return deviceOf(base);\nengine/input/codes.ts-142-  if (code.startsWith(TOUCH_PREFIX)) return 'touch';\nengine/input/codes.ts-143-  if (code.startsWith('Pad')) return 'gamepad';\nengine/input/codes.ts-144-  return code.startsWith('Mouse') || code.startsWith('Wheel') ? 'mouse' : 'keyboard';\nengine/input/codes.ts-145-}\nengine/input/codes.ts-146-\nengine/input/codes.ts-147-/** Pad button labels per family, in `PAD_BUTTONS` order. */\nx describe: ok: look \"look:storybook\": 2 of 14 fields differ from the default\n* description = \"A storybook: watercolour on cold-pressed paper with a thin ink line.\"\n  group = \"look\"\n  style = \"\"\n  sky = \"\"\n  toon = {\"bands\":3,\"rim\":0.25,\"shade\":0,\"dither\":0}\n  shells = {\"width\":0,\"color\":\"#141018\"}\n  skyGradient = 0\n15:export const {{name}} = defineEmitter('emitter:{{name}}', {\n16-  description: 'Pale green spores drifting up, swirling and fading (replace).',\n17-  area: [0.2, 0.1, 0.2],\n18-  velocity: [0, 0.8, 0],\n19-  spread: 0.5,\n20-  gravity: -0.3,\n21-  drag: 0.8,\n22-  turbulence: 1.5,\n23-  life: [0.8, 1.6],\n24-  size: [0.06, 0],\n25-  color: ['#c8ff9a', '#6ad16a'],\n26-  brightness: [1.5, 1],\n27-  alpha: [0.9, 0],\n28-  count: 16,\n29-  events: ['{{name}}'],\nengine/app/engine.ts:27: * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's c\nengine/app/engine.ts:144:  cameraInput?: () => CameraInput | undefined;\nengine/app/engine.ts:221:  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: \nengine/app/drawing.ts:72:  /** The page's own camera input, laid over the devices' each drawn frame (`EngineOptions.cameraInput`).\nengine/app/drawing.ts:73:  cameraInput?: () => CameraInput | undefined;\nengine/app/drawing.ts:178:      const cameraInput = { ...parts.input?.camera(), ...parts.cameraInput?.() };\nengine/gfx/post/combine.ts:4: * alone. A look's `combine` (engine/gfx/post/looks.ts) lists layers: each a look, how much\nengine/gfx/post/presetsMore.ts:14: * @see engine/gfx/post/looks.test.ts\nengine/gfx/post/presets.ts:3: * `[[preset]]` tables (`shardfall:crates/pav_view/src/looks.toml:13-462`), keys renamed (e\nengine/gfx/post/presets.ts:16: * @see engine/gfx/post/looks.test.ts\nengine/gfx/post/filterChecks.ts:6: * reports (engine/gfx/post/looks.ts) and as fixes the chain applies to the setting `p\nids: texture:asphalt, texture:brick, texture:carpet, texture:checker, texture:concrete, texture:crate, texture:dirt, texture:flagstone, texture:glass, texture:grass, texture:hallFloor, texture:metal, texture:moss, texture:planks, texture:plaster, texture:runes, texture:shingles, texture:siding, texture:staves, texture:stone, texture:tiles, texture:wallpaper, texture:water, texture:wood\n  description: string, required: What it draws, in plain sentences.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LEsjg8gWAbUUrrDCxzUvGM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
