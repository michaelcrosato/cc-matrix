{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcfgVgvZsfEy5X4evP9","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12286,"cache_read_input_tokens":371009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12286},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"8580f5e3-7721-433d-b7d3-62a2a360fa03","timestamp":"2026-11-05T10:22:35.532Z","request_id":"req_011CgjcfgE4b8NtQ9cENPRQD","thinking_duration_ms":886,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcfgVgvZsfEy5X4evP9","type":"message","role":"assistant","content":[{"type":"text","text":"Status: all 213 lines of writing are in. Next I'm writing the HUD, camera shots, screens, dev panel, hub session and `main.ts`."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12286,"cache_read_input_tokens":371009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12286},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"c9a165c4-bdce-4ee0-84e9-6234b57d9f6e","timestamp":"2026-11-05T10:22:35.539Z","request_id":"req_011CgjcfgE4b8NtQ9cENPRQD"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcfgVgvZsfEy5X4evP9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018BXFC97a6S1iFPKaeby9kD","name":"Bash","input":{"command":"cat > labs/game/ui/ctx.ts <<'E'\n/**\n * @file What every screen shares: the engine, the input, the sound, the save, the settings. A plain object made once in main.ts.\n */\nimport type { Engine, Inspector, Input, Store } from '../../../engine';\nimport type { Sound } from '../audio/sound';\nimport type { Flow } from '../scenes/types';\n\nexport interface Settings {\n  music: number; effects: number; voices: number; icons: 'ps' | 'xbox'; mouse: number; invert: boolean; rumble: boolean;\n  steadier: boolean; reduced: boolean; cpu: boolean; colour: number; look: number; headband: boolean;\n}\n\nexport const DEFAULT_SETTINGS: Settings = {\n  music: 0.1, effects: 0.8, voices: 0.8, icons: 'ps', mouse: 1, invert: false, rumble: true, steadier: false, reduced: false, cpu: true, colour: 0, look: 0, headband: false,\n}; // prettier-ignore\n\n/** A screen on top of play. */\nexport interface Screen {\n  el: HTMLElement;\n  update(dt: number): void;\n  close?(): void;\n}\n\nexport interface Ctx {\n  engine: Engine;\n  inspector: Inspector;\n  input: Input;\n  store: Store;\n  sound: Sound;\n  root: HTMLElement;\n  settings: Settings;\n  stack: Screen[];\n  run(action: string, args?: unknown): void;\n  flow(): Flow;\n  push(screen: Screen): void;\n  pop(): void;\n  clear(): void;\n  say(line: string, who: string, values?: Record<string, string | number>): void;\n  saveSettings(): void;\n  saveGame(): void;\n  hubActive: boolean;\n  fade(then: () => void): void;\n}\n\n/** A centred layer with a panel. */\nexport function panel(ctx: Ctx, title?: string): { layer: HTMLElement; box: HTMLElement } {\n  const layer = document.createElement('div');\n  layer.className = 'wt-layer';\n  const box = document.createElement('div');\n  box.className = 'wt-panel';\n  if (title) {\n    const h = document.createElement('div');\n    h.className = 'wt-h';\n    h.textContent = title;\n    box.append(h);\n  }\n  layer.append(box);\n  ctx.root.append(layer);\n  return { layer, box };\n}\n\n/** Removes a screen's layer as `close`. */\nexport const closer = (el: HTMLElement) => () => el.remove();\nE\ncat > labs/game/ui/shots.ts <<'E'\n/**\n * @file Every camera in the game as a function from the sim to a shot (cameras/stage.ts eases to it): the title's slow orbit,\n * each activity's purpose-built framing, and the finale's wide view of the whole island banking with its tilt.\n */\nimport type { EngineFrame } from '../../../engine';\nimport { SHOT } from '../cameras/stage';\nimport type { EvState, Flow } from '../scenes/types';\nimport { STATIONS } from '../scenes/data/stations';\n\ntype Vec = [number, number, number];\ntype ActorView = { actor?: { x: number; y: number; z: number; yaw: number } };\n\nconst set = (at: Vec, look: Vec, fov = 46, lag = 0.5) => Object.assign(SHOT, { at, look, fov, lag });\n\n/** Reads an actor's feet. */\nexport function feetOf(frame: EngineFrame, id: number): { x: number; y: number; z: number; yaw: number } {\n  const entity = (frame.world as unknown as { get(id: number): ActorView | undefined }).get(id);\n  return entity?.actor ?? { x: 0, y: 8, z: 0, yaw: 0 };\n}\n\n/** Sets the shot for an activity. */\nfunction eventShot(frame: EngineFrame, ev: EvState, guest: { x: number; y: number; z: number; yaw: number }, t: number): void {\n  const { x, y, z } = guest;\n  const d = ev.d as Record<string, number> & { guests?: unknown };\n  switch (ev.id) {\n    case 'check': return void set([x + Math.sin(t * 0.08) * 0.6, y + 1.3, z + 6 - Math.min(2, ev.total / 1200)], [x, y + 1, z], 42);\n    case 'poseA': case 'poseB': case 'poseC': case 'ring': case 'heron': case 'hoopS': case 'stepS': case 'pondS': {\n      if (ev.phase === 'demo') {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return void set([p.x + 2.2, p.y + 1.6, p.z + 5], [p.x, p.y + 1.4, p.z], 42);\n      }\n      const a = 0.6 + Math.sin(t * 0.05) * 0.25;\n      return void set([x + Math.sin(a) * 6.2, y + 2.4, z + Math.cos(a) * 6.2], [x + 0.2, y + 0.9, z - 0.6], 44);\n    }\n    case 'reps': return void set([x + 5, y + 1.6, z + 4.5], [x + 1.6, y + 0.9, z - 1], 46);\n    case 'step': return void set([x, y + 3.4, z + 7], [x, y + 1, z - 0.8], 48);\n    case 'pond': return void set([x, y + 1.1, z - 4.2], [x, y + 0.75, z], 40);\n    case 'line': return void set([x - 7, y + 3.4, z + 2], [x + 3, y + 0.6, z], 48, 0.3);\n    case 'paddle': {\n      const yaw = d.yaw;\n      return void set([x - Math.sin(yaw) * 8, y + 3.2, z - Math.cos(yaw) * 8], [x + Math.sin(yaw) * 3, y + 0.8, z + Math.cos(yaw) * 3], 52, 0.4);\n    }\n    case 'garden': return void set([d.cx, d.cy + 5.2, d.cz + 1.4], [d.cx, d.cy, d.cz], 44, 0.6);\n    case 'plunge':\n      if (ev.phase === 'cards') return void set([x + 5, 2.4, z - 8], [x, 2.6, z - 2], 50, 0.25);\n      if (ev.phase === 'air') return void set([x + 12, Math.max(4, y + 1), z - 3], [x, y + 1, z - 2], 50, 0.12);\n      return void set([x + 7, y + 1.6, z - 1], [x, y + 0.9, z - 2], 46);\n    case 'hoop': return void set([x, y + 1.6, z - 6.5], [x, y + 0.9, z], 46);\n    case 'jog': {\n      const yaw = d.yaw;\n      return void set([x - Math.sin(yaw) * 7, y + 3, z - Math.cos(yaw) * 7], [x + Math.sin(yaw) * 4, y + 1.2, z + Math.cos(yaw) * 4], 56, 0.3);\n    }\n    case 'tilt':\n      if (ev.phase === 'storm') {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return ev.t < 700 ? void set([p.x - 1.1, p.y + 2.6, p.z - 2.2], [p.x, p.y + 2.5, p.z], 40, 0.4) : void set([0, 40, 90], [0, 6, 0], 50, 2);\n      }\n      if (ev.phase === 'east') return void set([x - 12, y + 7, z], [x + 4, y + 1, z], 56, 0.4);\n      if (ev.phase === 'carts') return void set([x - 2, y + 3, z + 7], [x, y + 1, z], 46);\n      if (ev.phase === 'stone') return void set([34, 42, 92], [0, 6, 0], 52, 1);\n      if (ev.t < 500) {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return void set([p.x - 1.1, p.y + 2.6, p.z - 2.2], [p.x, p.y + 2.5, p.z], 40, 0.6);\n      }\n      return void set([Math.sin(t * 0.05) * 90, 26, Math.cos(t * 0.05) * 90], [0, 6, 0], 46, 1.5);\n    default: return void set([x, y + 4, z + 8], [x, y + 1, z]);\n  }\n}\n\n/** Sets this frame's shot; `t` is real seconds. */\nexport function updateShot(frame: EngineFrame, flow: Flow, guestId: number, t: number, reduced: boolean, tilt: { x: number; z: number; story: number }): void {\n  const guest = feetOf(frame, guestId);\n  if (flow.mode === 'event' && flow.ev) eventShot(frame, flow.ev, guest, t);\n  else if (flow.mode === 'credits') set([STATIONS.east.x + Math.sin(t * 0.07) * 18, 10, STATIONS.east.z + Math.cos(t * 0.07) * 18], [STATIONS.east.x, 7.5, STATIONS.east.z], 46, 1.5);\n  else if (flow.mode === 'results' || flow.mode === 'evening') set([guest.x + 5, guest.y + 2.5, guest.z + 5], [guest.x, guest.y + 1, guest.z], 44, 1);\n  else set([Math.sin(t * 0.03) * 150, 58, Math.cos(t * 0.03) * 150], [0, 6, 0], 42, 1.5);\n  SHOT.roll = reduced ? 0 : (flow.mode === 'event' && flow.ev?.id === 'tilt' ? (-tilt.x * Math.PI) / 180 : (tilt.story * Math.PI) / 180) * 0.6;\n}\nE\ncat > labs/game/ui/hud/disc.ts <<'E'\n/**\n * @file The Balance Disc, the HUD's heart: target ring, your dot with a short trail, a guide ring swelling with the breath, a\n * foot pill either side with analog fill. It reads the sim's `wobble` each frame. Rings and targets come from what the\n * running activity asks.\n */\nexport interface DiscView {\n  el: HTMLElement;\n  draw(data: DiscData): void;\n}\n\nexport interface DiscData {\n  x: number; y: number; lungs: number; guide: number; calm: number; l: number; r: number;\n  rings: { x: number; y: number; r: number; color?: string }[];\n  breath: boolean;\n}\n\nconst R = 100;\nconst SVG = 'http://www.w3.org/2000/svg';\n\nexport function createDisc(root: HTMLElement): DiscView {\n  const el = document.createElement('div');\n  el.innerHTML = `<div class=\"wt-disc\" data-ui=\"disc\"><svg viewBox=\"-120 -120 240 240\">\n    <circle r=\"${R}\" fill=\"rgb(251 248 241 / 88%)\" stroke=\"#3a4a55\" stroke-width=\"4\"/>\n    <circle class=\"guide\" r=\"50\" fill=\"none\" stroke=\"#bfe9ff\" stroke-width=\"10\"/>\n    <circle class=\"lungs\" r=\"50\" fill=\"none\" stroke=\"#6aa8e8\" stroke-width=\"3\"/>\n    <g class=\"rings\"></g><polyline class=\"trail\" fill=\"none\" stroke=\"#ff8a70\" stroke-opacity=\".45\" stroke-width=\"6\"/>\n    <circle class=\"dot\" r=\"11\" fill=\"#ff5a4a\" stroke=\"#fff\" stroke-width=\"3\"/></svg></div>\n    <div class=\"wt-foot\" style=\"left:calc(50% - 26vh)\"><i></i><span>L</span></div>\n    <div class=\"wt-foot\" style=\"left:calc(50% + 20vh)\"><i></i><span>R</span></div>`;\n  root.append(el);\n  const q = <T extends Element>(s: string) => el.querySelector<T>(s) as T;\n  const dot = q<SVGCircleElement>('.dot');\n  const trail = q<SVGPolylineElement>('.trail');\n  const guide = q<SVGCircleElement>('.guide');\n  const lungs = q<SVGCircleElement>('.lungs');\n  const rings = q<SVGGElement>('.rings');\n  const feet = el.querySelectorAll<HTMLElement>('.wt-foot i');\n  const history: string[] = [];\n  return {\n    el,\n    draw(data) {\n      const [dx, dy] = [data.x * R, -data.y * R];\n      dot.setAttribute('cx', dx.toFixed(1));\n      dot.setAttribute('cy', dy.toFixed(1));\n      history.push(`${dx.toFixed(0)},${dy.toFixed(0)}`);\n      if (history.length > 14) history.shift();\n      trail.setAttribute('points', history.join(' '));\n      guide.style.display = data.breath ? '' : 'none';\n      lungs.style.display = data.breath ? '' : 'none';\n      guide.setAttribute('r', (20 + data.guide * 70).toFixed(1));\n      lungs.setAttribute('r', (20 + data.lungs * 70).toFixed(1));\n      while (rings.childNodes.length < data.rings.length) rings.append(document.createElementNS(SVG, 'circle'));\n      while (rings.childNodes.length > data.rings.length) rings.lastChild?.remove();\n      data.rings.forEach((ring, i) => {\n        const node = rings.childNodes[i] as SVGCircleElement;\n        node.setAttribute('cx', (ring.x * R).toFixed(1));\n        node.setAttribute('cy', (-ring.y * R).toFixed(1));\n        node.setAttribute('r', (ring.r * R).toFixed(1));\n        node.setAttribute('fill', 'none');\n        node.setAttribute('stroke', ring.color ?? '#22a06b');\n        node.setAttribute('stroke-width', '6');\n      });\n      feet[0].style.height = `${Math.round(data.l * 100)}%`;\n      feet[1].style.height = `${Math.round(data.r * 100)}%`;\n    },\n  };\n}\nE\ncat > labs/game/ui/hud/index.ts <<'E'\n/**\n * @file The HUD in play: the Balance Disc when an activity uses balance, the line at the top, each activity's own gauge, lane,\n * cards or lures, and the prompts for the device used last. Built from what the sim holds; it never writes the sim.\n */\nimport type { EvState, Flow, Wobble, Seat } from '../../scenes/types';\nimport { guideOf } from '../../scenes/wobble';\nimport { POSES } from '../../scenes/data/poses';\nimport { EXERCISES } from '../../scenes/events/reps';\nimport { LINE_LENGTH } from '../../scenes/events/line';\nimport { TRAYS } from '../../scenes/data/trays';\nimport { DIVES } from '../../scenes/events/plunge';\nimport { ACTIVITY_PROMPTS, ACTIVITY_TITLES } from '../titles';\nimport { prompt, promptBar } from '../glyphs';\nimport { createDisc, type DiscData } from './disc';\nimport { drawLure } from './lures';\n\nexport interface Hud { update(flow: Flow, seat: { seat: Seat; wobble: Wobble } | null, tick: number, period: number, pose: number, ringSize: number): void; root: HTMLElement }\n\nconst USES_DISC = new Set(['check', 'poseA', 'poseB', 'poseC', 'ring', 'heron', 'reps', 'line', 'plunge', 'pond', 'pondS', 'paddle', 'step', 'stepS', 'tilt']);\n\nexport function createHud(parent: HTMLElement): Hud {\n  const root = document.createElement('div');\n  root.dataset.ui = 'hud-root';\n  parent.append(root);\n  const disc = createDisc(root);\n  const top = document.createElement('div');\n  top.className = 'wt-top';\n  top.dataset.ui = 'hud-top';\n  const bar = document.createElement('div');\n  const gauge = document.createElement('div');\n  gauge.className = 'wt-gauge';\n  gauge.innerHTML = '<div class=\"band\"></div><div class=\"mark\"></div>';\n  const lane = document.createElement('div');\n  lane.className = 'wt-lane';\n  lane.innerHTML = '<div class=\"line\"></div>';\n  const cards = document.createElement('div');\n  cards.className = 'wt-cards';\n  const lure = document.createElement('div');\n  lure.className = 'wt-lure';\n  root.append(top, bar, gauge, lane, cards, lure);\n  let promptsFor = '';\n  const noteNodes: HTMLElement[] = [];\n\n  /** The rings the disc shows and the line at the top. */\n  function rings(ev: EvState, data: DiscData, ringSize: number, seatIndex: number): string {\n    const d = ev.d as Record<string, unknown>;\n    const title = ACTIVITY_TITLES[ev.id] ?? ev.id;\n    switch (ev.id) {\n      case 'check': {\n        const target = (d.targets as number[][])[d.at as number];\n        if (ev.phase === 'ask') return 'Left foot: yes · Right foot: no';\n        if (ev.phase === 'reach' && target) data.rings = [{ x: target[0], y: target[1], r: 0.16, color: '#ff8a70' }];\n        else if (ev.phase === 'foot') data.rings = [{ x: 0, y: 0, r: 0.3 }];\n        else data.rings = [{ x: 0, y: 0, r: ev.t > 480 ? 0.16 : 0.22 }];\n        if (ev.phase === 'foot') return (d.foot as string) === 'l' ? 'Hold your left foot' : 'Hold your right foot';\n        return ev.phase === 'reach' ? `Reach ${d.at as number} of 6` : 'Stay in the ring';\n      }\n      case 'poseA': case 'poseB': case 'poseC': case 'heron': {\n        const list = d.list as string[];\n        const pose = POSES[list[d.at as number]];\n        if (!pose) return title;\n        const seat = pose.seats[Math.min(d.seatAt as number, pose.seats.length - 1)];\n        data.rings = [{ x: seat[0], y: seat[1], r: ringSize * pose.ring }];\n        data.breath = pose.breath > 0;\n        if (ev.phase === 'enter') {\n          const k = ev.s[seatIndex]?.prog ?? 0;\n          data.rings.push({ x: seat[0] * k, y: seat[1] * k, r: 0.18, color: '#ff8a70' });\n          return `${pose.title}: follow the dot`;\n        }\n        return pose.hold === 'both' ? `${pose.title}: hold both feet` : pose.hold === 'l' ? `${pose.title}: hold your left foot` : pose.title;\n      }\n      case 'ring': data.rings = [{ x: 0, y: 0, r: (d.ring as number) ?? 0.22 }]; return ev.phase === 'lead' ? 'Get ready' : title;\n      case 'pond': case 'pondS': data.breath = true; return `Composure ${Math.round(ev.s[seatIndex]?.composure ?? 1000)}`;\n      case 'reps': {\n        const ex = EXERCISES[d.ex as number];\n        if (!ex) return title;\n        const shown = (d.fake as number) ? `${(d.rep as number) + 1} of ${ex.count + 1}` : `${d.rep as number} of ${ex.count}`;\n        return `Rep ${shown}`;\n      }\n      case 'line': return `${Math.round(d.at as number)} of ${LINE_LENGTH} m · Falls ${d.falls as number}`;\n      case 'paddle': return `Gate ${d.at as number} of 12`;\n      case 'garden': return `Tray ${Math.min((d.tray as number) + 1, TRAYS.length)} of ${TRAYS.length}`;\n      case 'plunge': {\n        data.rings = [{ x: 0, y: 0, r: 0.3 }];\n        data.breath = ev.phase === 'compose';\n        const dive = `Dive ${(d.dive as number) + 1} of ${DIVES}`;\n        return ev.phase === 'go' ? `${dive}: let go at the top` : `${dive}`;\n      }\n      case 'hoop': case 'hoopS': {\n        const s = ev.s[seatIndex];\n        const warn = s?.warn > 0 ? (s.side > 0 ? ' · Hoop from the right' : ' · Hoop from the left') : s?.window > 0 ? ' · Lean!' : '';\n        return `Hoops ${s?.hoops ?? 0}${warn}`;\n      }\n      case 'jog': return (d.dist as number) <= 8 ? 'In the Pace Ribbon' : `Gerald is ${Math.round(d.dist as number)} m ahead`;\n      case 'step': case 'stepS': return `Combo ${ev.s[seatIndex]?.combo ?? 0}`;\n      case 'tilt':\n        if (ev.phase === 'east') {\n          data.breath = false;\n          return `On the terrace: ${d.delivered as number}. Everyone east.`;\n        }\n        if (ev.phase === 'carts') {\n          data.rings = [{ x: 0.3, y: 0, r: 0.45 }];\n          return `Crank the carts: ${Math.round((d.cart as number) * 100)}%`;\n        }\n        if (ev.phase === 'stone') {\n          data.rings = [{ x: 0, y: 0, r: d.ring as number }];\n          data.breath = true;\n          return 'You are the island';\n        }\n        return title;\n      default: return title;\n    }\n  }\n\n  return {\n    root,\n    update(flow, seat, tick, period, _pose, ringSize) {\n      const ev = flow.ev;\n      const on = !!(ev && flow.mode === 'event' && seat);\n      root.style.display = on ? '' : 'none';\n      if (!on || !ev || !seat) return;\n      const data: DiscData = { x: seat.wobble.x, y: seat.wobble.y, lungs: seat.wobble.lungs, guide: guideOf(tick, period), calm: seat.wobble.calm, l: seat.seat.input.l, r: seat.seat.input.r, rings: [], breath: false };\n      top.textContent = rings(ev, data, ringSize, seat.seat.index);\n      const useDisc = USES_DISC.has(ev.id) && !(ev.id === 'tilt' && (ev.phase === 'east' || ev.phase === 'storm' || ev.phase === 'dawn'));\n      disc.el.style.display = useDisc && !(ev.id === 'plunge' && ev.phase === 'air') && !ev.id.startsWith('step') ? '' : 'none';\n      if (useDisc) disc.draw(data);\n      const key = ev.id;\n      if (promptsFor !== key) {\n        promptsFor = key;\n        bar.innerHTML = '';\n        const items = ACTIVITY_PROMPTS[ev.id] ?? [];\n        if (!(USES_DISC.has(ev.id) && !ev.id.startsWith('step'))) bar.innerHTML = promptBar(items);\n        else {\n          const div = document.createElement('div');\n          div.className = 'wt-prompts';\n          div.style.cssText = 'position:absolute;left:50%;top:13vh;transform:translateX(-50%);background:rgb(251 248 241 / 92%);border-radius:3vh;padding:.7vh 2.4vh';\n          div.innerHTML = items.map(([v, l]) => prompt(v, l)).join('');\n          bar.append(div);\n        }\n      }\n      // reps' gauge\n      gauge.style.display = ev.id === 'reps' && ev.phase === 'rep' ? '' : 'none';\n      if (ev.id === 'reps') {\n        const d = ev.d as unknown as { band: number; marker: number };\n        (gauge.firstChild as HTMLElement).style.bottom = `${Math.round(d.band * 76)}%`;\n        (gauge.lastChild as HTMLElement).style.bottom = `${Math.round(Math.min(1, d.marker) * 88 + 6)}%`;\n      }\n      // step's lane\n      lane.style.display = ev.id === 'step' || ev.id === 'stepS' ? '' : 'none';\n      if (ev.id === 'step' || ev.id === 'stepS') {\n        const d = ev.d as unknown as { notes: { t: number; k: string }[] };\n        const s = ev.s[seat.seat.index];\n        const shown = d.notes.slice(s?.at ?? 0, (s?.at ?? 0) + 8);\n        while (noteNodes.length < shown.length) {\n          const n = document.createElement('div');\n          n.className = 'wt-note';\n          lane.append(n);\n          noteNodes.push(n);\n        }\n        noteNodes.forEach((n, i) => {\n          const note = shown[i];\n          n.style.display = note ? '' : 'none';\n          if (!note) return;\n          n.textContent = note.k === 'a' ? '←L' : note.k === 'd' ? 'R→' : note.k === 'B' ? 'B' : note.k;\n          n.dataset.k = note.k === 'a' ? 'L' : note.k === 'd' ? 'R' : note.k;\n          n.style.left = `${14 + ((note.t - (ev.phase === 'lead' ? -360 + ev.t : ev.t)) / 240) * 86}%`;\n          n.style.top = note.k === 'R' || note.k === 'd' ? '70%' : note.k === 'B' ? '50%' : '30%';\n        });\n      }\n      // plunge's gauge and cards\n      const dive = ev.id === 'plunge' ? (ev.d as unknown as { cards: number[]; gauge: number }) : null;\n      const showCards = dive && ev.phase === 'cards' && dive.cards.length;\n      cards.style.display = showCards ? '' : 'none';\n      if (showCards && cards.dataset.of !== dive.cards.join()) {\n        cards.dataset.of = dive.cards.join();\n        cards.innerHTML = dive.cards.map((c) => `<div>${c}</div>`).join('');\n      }\n      if (dive && ev.phase === 'go') {\n        gauge.style.display = '';\n        (gauge.firstChild as HTMLElement).style.bottom = '76%';\n        (gauge.lastChild as HTMLElement).style.bottom = `${Math.round(dive.gauge * 94)}%`;\n      }\n      drawLure(lure, ev);\n    },\n  };\n}\nE\ncat > labs/game/ui/hud/lures.ts <<'E'\n/**\n * @file Still Pond's lures as the screen shows them: big prompts for your device, a fake pause menu, a fake disconnect\n * message, fake credits. Each is exactly what it pretends to be, so pressing is your fault.\n */\nimport type { EvState } from '../../scenes/types';\nimport { glyphs } from '../glyphs';\nimport { TITLE } from '../titles';\n\nconst LURES: Readonly<Record<string, () => string>> = {\n  pressNow: () => `<div class=\"wt-big\" style=\"display:flex;gap:2vh;align-items:center\">${glyphs('use')} PRESS NOW</div>`,\n  psst: () => `<div class=\"wt-panel wt-body\" style=\"display:flex;gap:1vh;align-items:center\">${glyphs('use')} Yes</div>`,\n  phone: () => '<div class=\"wt-panel wt-body\">Buzz buzz. One new stone.</div>',\n  fakePause: () => '<div class=\"wt-panel\"><div class=\"wt-h\">Paused</div><div class=\"wt-menu\"><div class=\"wt-row\" data-focus=\"1\">Resume</div><div class=\"wt-row\">Quit to Title</div></div></div>',\n  disconnect: () => '<div class=\"wt-panel wt-body\">Your controller appears to be disconnected.<br/>Press any button.</div>',\n  credits: () => `<div class=\"wt-panel wt-body\"><div class=\"wt-h\">Thanks for playing!</div>${TITLE}<br/><span style=\"display:inline-flex;gap:1vh;align-items:center\">${glyphs('use')} Continue</span></div>`,\n};\n\n/** Draws the lure that's up. */\nexport function drawLure(el: HTMLElement, ev: EvState): void {\n  const id = ev.id === 'pond' || ev.id === 'pondS' ? ((ev.d as { lure?: string }).lure ?? '') : '';\n  if (el.dataset.lure === id) return;\n  el.dataset.lure = id;\n  el.dataset.ui = 'lure';\n  el.innerHTML = id && LURES[id] ? LURES[id]() : '';\n}\nE\ncat > labs/game/ui/screens/front.ts <<'E'\n/**\n * @file The front end: the title (with its touch-only form), the pier where you pick a look, the attract banner, and About.\n */\nimport { lineText } from '../lines';\nimport { promptBar, prompt } from '../glyphs';\nimport { closer, panel, type Ctx, type Screen } from '../ctx';\nimport { createRows, type Row } from '../menu';\nimport { TAGLINE, TITLE } from '../titles';\nimport { TRACKSUITS } from '../../bodies';\nimport { CREDITS, ENGINE_FEEDBACK, ENGINE_QUESTIONS, PROMPT_FEEDBACK, PROMPT_QUESTIONS, SOURCE_INFORMATION, SOURCE_LABELS, TESTING_FEEDBACK, TESTING_QUESTIONS } from '../about-data';\nimport { settingsScreen } from './settings';\nimport { boardScreen } from './programme';\nimport { joinScreen } from './group';\n\nexport interface TitleOptions { touch: () => boolean; onBegin: (fresh: boolean) => void; hasSave: () => boolean }\n\n/** The title screen. */\nexport function titleScreen(ctx: Ctx, options: TitleOptions): Screen {\n  const layer = document.createElement('div');\n  layer.className = 'wt-layer';\n  layer.dataset.ui = 'title';\n  layer.innerHTML = `<div class=\"wt-title\">${TITLE}</div><div class=\"wt-tag\">${TAGLINE}</div>`;\n  const box = document.createElement('div');\n  box.className = 'wt-panel';\n  layer.append(box);\n  ctx.root.append(layer);\n  const touchNote = document.createElement('div');\n  touchNote.className = 'wt-touch';\n  touchNote.textContent = 'Controller or keyboard required';\n  const rows = (): Row[] => {\n    if (options.touch()) return [{ id: 'settings', label: 'Settings' }];\n    const save = options.hasSave();\n    return [\n      { id: 'begin', label: save ? 'Continue' : 'Begin' },\n      ...(save ? [{ id: 'new', label: 'Begin Again' }] : []),\n      { id: 'free', label: 'Free Play', off: !save },\n      { id: 'group', label: 'Group Class' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'about', label: 'About / Credits' },\n    ];\n  };\n  const menu = createRows(box, rows(), ctx.input, (id) => {\n    if (id === 'begin') options.onBegin(false);\n    else if (id === 'new') ctx.push(confirmScreen(ctx, 'Begin again? Your cairn will be taken apart.', () => options.onBegin(true)));\n    else if (id === 'free') ctx.push(boardScreen(ctx, true));\n    else if (id === 'group') ctx.push(joinScreen(ctx));\n    else if (id === 'settings') ctx.push(settingsScreen(ctx));\n    else if (id === 'about') ctx.push(aboutScreen(ctx));\n  }, () => {}, () => ctx.sound.audio.play('sfx:select'));\n  let touchShown: boolean | null = null;\n  return {\n    el: layer,\n    update(dt) {\n      const touch = options.touch();\n      if (touch !== touchShown) {\n        touchShown = touch;\n        touchNote.remove();\n        if (touch) box.prepend(touchNote);\n        menu.setRows(rows());\n      }\n      menu.update(dt);\n    },\n    close: closer(layer),\n  };\n}\n\n/** Are you sure, in-game. */\nexport function confirmScreen(ctx: Ctx, text: string, yes: () => void): Screen {\n  const { layer, box } = panel(ctx);\n  const body = document.createElement('div');\n  body.className = 'wt-body';\n  body.style.marginBottom = '2vh';\n  body.textContent = text;\n  box.append(body);\n  const menu = createRows(box, [{ id: 'no', label: 'No' }, { id: 'yes', label: 'Yes' }], ctx.input, (id) => {\n    ctx.pop();\n    if (id === 'yes') yes();\n  }, () => ctx.pop());\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\n/** The pier: one of three looks, a tracksuit colour. */\nexport function pierScreen(ctx: Ctx, done: () => void): Screen {\n  const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');\n  const s = ctx.settings;\n  const looks = ['One', 'Two', 'Three'];\n  const colours = ['Coral', 'Blue'];\n  const rows: Row[] = [\n    { id: 'look', label: 'Look', value: () => looks[s.look], change: (dir) => void (s.look = (s.look + dir + 3) % 3) },\n    { id: 'colour', label: 'Tracksuit', value: () => colours[s.colour % 2], change: (dir) => void (s.colour = (s.colour + dir + 2) % 2) },\n    { id: 'go', label: 'Step ashore' },\n  ];\n  const menu = createRows(box, rows, ctx.input, () => {\n    ctx.saveSettings();\n    ctx.pop();\n    done();\n  }, () => {});\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\nvoid TRACKSUITS;\n\n/** The attract banner. */\nexport function attractBanner(ctx: Ctx): HTMLElement {\n  const el = document.createElement('div');\n  el.className = 'wt-banner';\n  el.dataset.ui = 'attract';\n  el.innerHTML = `<div class=\"wt-title\" style=\"font-size:8vh\">${TITLE}</div><div class=\"wt-demo\">DEMO</div><div style=\"margin-top:1.5vh;display:flex;justify-content:center\">${prompt('any', 'Press any button')}</div>`;\n  ctx.root.append(el);\n  return el;\n}\n\n/** About and credits: paged, from the one data file. */\nexport function aboutScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'About / Credits');\n  layer.dataset.ui = 'about';\n  const body = document.createElement('div');\n  body.className = 'wt-about';\n  box.append(body);\n  const qa = (questions: readonly string[], answers: readonly string[]) => questions.map((q, i) => [q, answers[i]] as const);\n  const source = Object.entries(SOURCE_INFORMATION).map(([k, v]) => [SOURCE_LABELS[k], v] as const);\n  const pages: { title: string; rows: readonly (readonly [string, string])[] }[] = [\n    { title: 'Source Information', rows: source.slice(0, 7) },\n    { title: 'Source Information', rows: source.slice(7) },\n    { title: 'Testing Feedback', rows: qa(TESTING_QUESTIONS, TESTING_FEEDBACK) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_QUESTIONS.slice(0, 3), ENGINE_FEEDBACK.slice(0, 3)) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_QUESTIONS.slice(3), ENGINE_FEEDBACK.slice(3)) },\n    { title: 'Prompt Feedback', rows: qa(PROMPT_QUESTIONS, PROMPT_FEEDBACK) },\n    { title: 'Credits', rows: CREDITS.map((c) => ['', c] as const) },\n  ];\n  let at = 0;\n  const heading = box.querySelector('.wt-h') as HTMLElement;\n  const draw = () => {\n    heading.textContent = `${pages[at].title} (${at + 1} of ${pages.length})`;\n    body.innerHTML = '';\n    for (const [k, v] of pages[at].rows) {\n      const p = document.createElement('p');\n      if (k) {\n        const b = document.createElement('b');\n        b.textContent = `${k}: `;\n        p.append(b);\n      }\n      p.append(document.createTextNode(v));\n      body.append(p);\n    }\n  };\n  draw();\n  const nav = document.createElement('div');\n  nav.innerHTML = promptBar([['page', 'Page'], ['back', 'Back']]).replace('wt-bar', 'wt-prompts');\n  nav.style.marginTop = '1.5vh';\n  box.append(nav);\n  const turn = (dir: number) => {\n    at = (at + dir + pages.length) % pages.length;\n    draw();\n  };\n  box.addEventListener('click', () => turn(1));\n  return {\n    el: layer,\n    update() {\n      if (ctx.input.pressed('uiRight') || ctx.input.pressed('uiDown') || ctx.input.pressed('uiAccept')) turn(1);\n      if (ctx.input.pressed('uiLeft') || ctx.input.pressed('uiUp')) turn(-1);\n      if (ctx.input.pressed('uiCancel')) ctx.pop();\n    },\n    close: closer(layer),\n  };\n}\nvoid lineText;\nE\ncat > labs/game/ui/screens/settings.ts <<'E'\n/**\n * @file Settings, paged at six rows, and Controls: every binding per scheme, keyboard rebinding through the engine's bindings.\n * Music is 10% by default. Erase Save asks in-game, never with `confirm()`.\n */\nimport { prompt } from '../glyphs';\nimport { closer, DEFAULT_SETTINGS, panel, type Ctx, type Screen } from '../ctx';\nimport { createRows, type Row } from '../menu';\nimport { confirmScreen } from './front';\n\nconst pct = (v: number) => `${Math.round(v * 100)}%`;\nconst step = (v: number, dir: number, by = 0.1) => Math.round(Math.max(0, Math.min(1, v + dir * by)) * 100) / 100;\n\n/** Settings. */\nexport function settingsScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'Settings');\n  layer.dataset.ui = 'settings';\n  const s = ctx.settings;\n  const save = () => ctx.saveSettings();\n  const pages: Row[][] = [\n    [\n      { id: 'music', label: 'Music', value: () => pct(s.music), change: (d) => { s.music = step(s.music, d); ctx.sound.audio.volume('music', s.music); save(); } },\n      { id: 'effects', label: 'Effects', value: () => pct(s.effects), change: (d) => { s.effects = step(s.effects, d); ctx.sound.audio.volume('effects', s.effects); save(); } },\n      { id: 'voices', label: 'Voices', value: () => pct(s.voices), change: (d) => { s.voices = step(s.voices, d); ctx.sound.voices = s.voices; save(); } },\n      { id: 'next1', label: 'More settings' },\n      { id: 'back', label: 'Back' },\n    ],\n    [\n      { id: 'icons', label: 'Button icons', value: () => (s.icons === 'ps' ? 'PlayStation' : 'Xbox'), change: () => { s.icons = s.icons === 'ps' ? 'xbox' : 'ps'; ctx.root.dataset.pad = s.icons; save(); } },\n      { id: 'mouse', label: 'Mouse sensitivity', value: () => pct(s.mouse), change: (d) => { s.mouse = Math.max(0.2, Math.min(3, Math.round((s.mouse + d * 0.1) * 10) / 10)); save(); } },\n      { id: 'invert', label: 'Invert look', value: () => (s.invert ? 'On' : 'Off'), change: () => { s.invert = !s.invert; ctx.inspector.set('input.invertY', s.invert); save(); } },\n      { id: 'rumble', label: 'Rumble', value: () => (s.rumble ? 'On' : 'Off'), change: () => { s.rumble = !s.rumble; save(); } },\n      { id: 'next2', label: 'More settings' },\n      { id: 'back', label: 'Back' },\n    ],\n    [\n      { id: 'steadier', label: 'Steadier Hands', value: () => (s.steadier ? 'On' : 'Off'), change: () => { s.steadier = !s.steadier; ctx.run('game.flags', { steadier: s.steadier }); save(); } },\n      { id: 'reduced', label: 'Reduced Motion', value: () => (s.reduced ? 'On' : 'Off'), change: () => { s.reduced = !s.reduced; save(); } },\n      { id: 'fullscreen', label: 'Fullscreen', value: () => (document.fullscreenElement ? 'On' : 'Off'), change: () => { if (document.fullscreenElement) void document.exitFullscreen(); else void document.documentElement.requestFullscreen?.(); } },\n      { id: 'erase', label: 'Erase Save' },\n      { id: 'next3', label: 'First settings' },\n      { id: 'back', label: 'Back' },\n    ],\n  ]; // prettier-ignore\n  let at = 0;\n  const menu = createRows(box, pages[0], ctx.input, (id) => {\n    if (id === 'back') ctx.pop();\n    else if (id.startsWith('next')) {\n      at = (at + 1) % pages.length;\n      menu.setRows(pages[at]);\n    } else if (id === 'erase') {\n      ctx.push(confirmScreen(ctx, 'Erase your save? The cairn, the ages and every stamp.', () => {\n        ctx.store.remove('game');\n        Object.assign(s, { ...DEFAULT_SETTINGS });\n        ctx.sound.audio.volume('music', s.music);\n        save();\n        ctx.say('after', 'tare');\n      }));\n    }\n  }, () => ctx.pop());\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\nconst KEY_ACTIONS: readonly [string, string][] = [['forward', 'Lean forward'], ['back', 'Lean back'], ['left', 'Lean left'], ['right', 'Lean right'], ['footl', 'Left foot'], ['footr', 'Right foot']];\n\n/** Controls: what each verb is, and rebinding for keys. */\nexport function controlsScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'Controls');\n  layer.dataset.ui = 'controls';\n  const note = document.createElement('div');\n  note.className = 'wt-prompts';\n  note.style.marginBottom = '1.2vh';\n  note.innerHTML = [prompt('lean', 'Lean'), prompt('footL', 'Left'), prompt('footR', 'Right'), prompt('both', 'Breathe')].join('');\n  box.append(note);\n  const binds = ctx.input.bindingsFor('actionMap:balance');\n  const label = (action: string) => binds.label(action, 'keyboard');\n  let listening = false;\n  const rows: Row[] = [...KEY_ACTIONS.map(([action, title]) => ({ id: action, label: title, value: () => (listening ? '…' : label(action)) })), { id: 'reset', label: 'Reset keys', value: () => '' }];\n  const shown: Row[] = rows.slice(0, 5).concat({ id: 'more', label: 'More' });\n  let page = 0;\n  const menu = createRows(box, shown, ctx.input, (id) => {\n    if (id === 'more') {\n      page = 1 - page;\n      menu.setRows(page ? rows.slice(5).concat({ id: 'more', label: 'Back to the first' }) : shown);\n    } else if (id === 'reset') {\n      binds.reset();\n    } else if (!listening) {\n      listening = true;\n      void ctx.input.listen('keyboard').then((code) => {\n        listening = false;\n        if (!code) return;\n        const old = binds.codes(id).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse') && !c.startsWith('Arrow'));\n        binds.rebind(id, code, old ? { replace: old } : undefined);\n      });\n    }\n  }, () => {\n    if (!listening) ctx.pop();\n  });\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\nE\ngrep -n \"invert\" engine/input/look.ts | head -3 | cut -c1-120","description":"Write context, shots, HUD, title, settings, about screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12286,"cache_read_input_tokens":371009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12286},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"b5b8d9db-9cbd-48a7-b2bf-4d34b2ffea5f","timestamp":"2026-11-05T10:24:30.240Z","request_id":"req_011CgjcfgE4b8NtQ9cENPRQD","wire_tool_inputs":{"toolu_018BXFC97a6S1iFPKaeby9kD":{"command":"cat > labs/game/ui/ctx.ts <<'E'\n/**\n * @file What every screen shares: the engine, the input, the sound, the save, the settings. A plain object made once in main.ts.\n */\nimport type { Engine, Inspector, Input, Store } from '../../../engine';\nimport type { Sound } from '../audio/sound';\nimport type { Flow } from '../scenes/types';\n\nexport interface Settings {\n  music: number; effects: number; voices: number; icons: 'ps' | 'xbox'; mouse: number; invert: boolean; rumble: boolean;\n  steadier: boolean; reduced: boolean; cpu: boolean; colour: number; look: number; headband: boolean;\n}\n\nexport const DEFAULT_SETTINGS: Settings = {\n  music: 0.1, effects: 0.8, voices: 0.8, icons: 'ps', mouse: 1, invert: false, rumble: true, steadier: false, reduced: false, cpu: true, colour: 0, look: 0, headband: false,\n}; // prettier-ignore\n\n/** A screen on top of play. */\nexport interface Screen {\n  el: HTMLElement;\n  update(dt: number): void;\n  close?(): void;\n}\n\nexport interface Ctx {\n  engine: Engine;\n  inspector: Inspector;\n  input: Input;\n  store: Store;\n  sound: Sound;\n  root: HTMLElement;\n  settings: Settings;\n  stack: Screen[];\n  run(action: string, args?: unknown): void;\n  flow(): Flow;\n  push(screen: Screen): void;\n  pop(): void;\n  clear(): void;\n  say(line: string, who: string, values?: Record<string, string | number>): void;\n  saveSettings(): void;\n  saveGame(): void;\n  hubActive: boolean;\n  fade(then: () => void): void;\n}\n\n/** A centred layer with a panel. */\nexport function panel(ctx: Ctx, title?: string): { layer: HTMLElement; box: HTMLElement } {\n  const layer = document.createElement('div');\n  layer.className = 'wt-layer';\n  const box = document.createElement('div');\n  box.className = 'wt-panel';\n  if (title) {\n    const h = document.createElement('div');\n    h.className = 'wt-h';\n    h.textContent = title;\n    box.append(h);\n  }\n  layer.append(box);\n  ctx.root.append(layer);\n  return { layer, box };\n}\n\n/** Removes a screen's layer as `close`. */\nexport const closer = (el: HTMLElement) => () => el.remove();\nE\ncat > labs/game/ui/shots.ts <<'E'\n/**\n * @file Every camera in the game as a function from the sim to a shot (cameras/stage.ts eases to it): the title's slow orbit,\n * each activity's purpose-built framing, and the finale's wide view of the whole island banking with its tilt.\n */\nimport type { EngineFrame } from '../../../engine';\nimport { SHOT } from '../cameras/stage';\nimport type { EvState, Flow } from '../scenes/types';\nimport { STATIONS } from '../scenes/data/stations';\n\ntype Vec = [number, number, number];\ntype ActorView = { actor?: { x: number; y: number; z: number; yaw: number } };\n\nconst set = (at: Vec, look: Vec, fov = 46, lag = 0.5) => Object.assign(SHOT, { at, look, fov, lag });\n\n/** Reads an actor's feet. */\nexport function feetOf(frame: EngineFrame, id: number): { x: number; y: number; z: number; yaw: number } {\n  const entity = (frame.world as unknown as { get(id: number): ActorView | undefined }).get(id);\n  return entity?.actor ?? { x: 0, y: 8, z: 0, yaw: 0 };\n}\n\n/** Sets the shot for an activity. */\nfunction eventShot(frame: EngineFrame, ev: EvState, guest: { x: number; y: number; z: number; yaw: number }, t: number): void {\n  const { x, y, z } = guest;\n  const d = ev.d as Record<string, number> & { guests?: unknown };\n  switch (ev.id) {\n    case 'check': return void set([x + Math.sin(t * 0.08) * 0.6, y + 1.3, z + 6 - Math.min(2, ev.total / 1200)], [x, y + 1, z], 42);\n    case 'poseA': case 'poseB': case 'poseC': case 'ring': case 'heron': case 'hoopS': case 'stepS': case 'pondS': {\n      if (ev.phase === 'demo') {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return void set([p.x + 2.2, p.y + 1.6, p.z + 5], [p.x, p.y + 1.4, p.z], 42);\n      }\n      const a = 0.6 + Math.sin(t * 0.05) * 0.25;\n      return void set([x + Math.sin(a) * 6.2, y + 2.4, z + Math.cos(a) * 6.2], [x + 0.2, y + 0.9, z - 0.6], 44);\n    }\n    case 'reps': return void set([x + 5, y + 1.6, z + 4.5], [x + 1.6, y + 0.9, z - 1], 46);\n    case 'step': return void set([x, y + 3.4, z + 7], [x, y + 1, z - 0.8], 48);\n    case 'pond': return void set([x, y + 1.1, z - 4.2], [x, y + 0.75, z], 40);\n    case 'line': return void set([x - 7, y + 3.4, z + 2], [x + 3, y + 0.6, z], 48, 0.3);\n    case 'paddle': {\n      const yaw = d.yaw;\n      return void set([x - Math.sin(yaw) * 8, y + 3.2, z - Math.cos(yaw) * 8], [x + Math.sin(yaw) * 3, y + 0.8, z + Math.cos(yaw) * 3], 52, 0.4);\n    }\n    case 'garden': return void set([d.cx, d.cy + 5.2, d.cz + 1.4], [d.cx, d.cy, d.cz], 44, 0.6);\n    case 'plunge':\n      if (ev.phase === 'cards') return void set([x + 5, 2.4, z - 8], [x, 2.6, z - 2], 50, 0.25);\n      if (ev.phase === 'air') return void set([x + 12, Math.max(4, y + 1), z - 3], [x, y + 1, z - 2], 50, 0.12);\n      return void set([x + 7, y + 1.6, z - 1], [x, y + 0.9, z - 2], 46);\n    case 'hoop': return void set([x, y + 1.6, z - 6.5], [x, y + 0.9, z], 46);\n    case 'jog': {\n      const yaw = d.yaw;\n      return void set([x - Math.sin(yaw) * 7, y + 3, z - Math.cos(yaw) * 7], [x + Math.sin(yaw) * 4, y + 1.2, z + Math.cos(yaw) * 4], 56, 0.3);\n    }\n    case 'tilt':\n      if (ev.phase === 'storm') {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return ev.t < 700 ? void set([p.x - 1.1, p.y + 2.6, p.z - 2.2], [p.x, p.y + 2.5, p.z], 40, 0.4) : void set([0, 40, 90], [0, 6, 0], 50, 2);\n      }\n      if (ev.phase === 'east') return void set([x - 12, y + 7, z], [x + 4, y + 1, z], 56, 0.4);\n      if (ev.phase === 'carts') return void set([x - 2, y + 3, z + 7], [x, y + 1, z], 46);\n      if (ev.phase === 'stone') return void set([34, 42, 92], [0, 6, 0], 52, 1);\n      if (ev.t < 500) {\n        const c = (frame.world as unknown as { query(n: string): { cast: { plumb: number } }[] }).query('cast')[0];\n        const p = feetOf(frame, c.cast.plumb);\n        return void set([p.x - 1.1, p.y + 2.6, p.z - 2.2], [p.x, p.y + 2.5, p.z], 40, 0.6);\n      }\n      return void set([Math.sin(t * 0.05) * 90, 26, Math.cos(t * 0.05) * 90], [0, 6, 0], 46, 1.5);\n    default: return void set([x, y + 4, z + 8], [x, y + 1, z]);\n  }\n}\n\n/** Sets this frame's shot; `t` is real seconds. */\nexport function updateShot(frame: EngineFrame, flow: Flow, guestId: number, t: number, reduced: boolean, tilt: { x: number; z: number; story: number }): void {\n  const guest = feetOf(frame, guestId);\n  if (flow.mode === 'event' && flow.ev) eventShot(frame, flow.ev, guest, t);\n  else if (flow.mode === 'credits') set([STATIONS.east.x + Math.sin(t * 0.07) * 18, 10, STATIONS.east.z + Math.cos(t * 0.07) * 18], [STATIONS.east.x, 7.5, STATIONS.east.z], 46, 1.5);\n  else if (flow.mode === 'results' || flow.mode === 'evening') set([guest.x + 5, guest.y + 2.5, guest.z + 5], [guest.x, guest.y + 1, guest.z], 44, 1);\n  else set([Math.sin(t * 0.03) * 150, 58, Math.cos(t * 0.03) * 150], [0, 6, 0], 42, 1.5);\n  SHOT.roll = reduced ? 0 : (flow.mode === 'event' && flow.ev?.id === 'tilt' ? (-tilt.x * Math.PI) / 180 : (tilt.story * Math.PI) / 180) * 0.6;\n}\nE\ncat > labs/game/ui/hud/disc.ts <<'E'\n/**\n * @file The Balance Disc, the HUD's heart: target ring, your dot with a short trail, a guide ring swelling with the breath, a\n * foot pill either side with analog fill. It reads the sim's `wobble` each frame. Rings and targets come from what the\n * running activity asks.\n */\nexport interface DiscView {\n  el: HTMLElement;\n  draw(data: DiscData): void;\n}\n\nexport interface DiscData {\n  x: number; y: number; lungs: number; guide: number; calm: number; l: number; r: number;\n  rings: { x: number; y: number; r: number; color?: string }[];\n  breath: boolean;\n}\n\nconst R = 100;\nconst SVG = 'http://www.w3.org/2000/svg';\n\nexport function createDisc(root: HTMLElement): DiscView {\n  const el = document.createElement('div');\n  el.innerHTML = `<div class=\"wt-disc\" data-ui=\"disc\"><svg viewBox=\"-120 -120 240 240\">\n    <circle r=\"${R}\" fill=\"rgb(251 248 241 / 88%)\" stroke=\"#3a4a55\" stroke-width=\"4\"/>\n    <circle class=\"guide\" r=\"50\" fill=\"none\" stroke=\"#bfe9ff\" stroke-width=\"10\"/>\n    <circle class=\"lungs\" r=\"50\" fill=\"none\" stroke=\"#6aa8e8\" stroke-width=\"3\"/>\n    <g class=\"rings\"></g><polyline class=\"trail\" fill=\"none\" stroke=\"#ff8a70\" stroke-opacity=\".45\" stroke-width=\"6\"/>\n    <circle class=\"dot\" r=\"11\" fill=\"#ff5a4a\" stroke=\"#fff\" stroke-width=\"3\"/></svg></div>\n    <div class=\"wt-foot\" style=\"left:calc(50% - 26vh)\"><i></i><span>L</span></div>\n    <div class=\"wt-foot\" style=\"left:calc(50% + 20vh)\"><i></i><span>R</span></div>`;\n  root.append(el);\n  const q = <T extends Element>(s: string) => el.querySelector<T>(s) as T;\n  const dot = q<SVGCircleElement>('.dot');\n  const trail = q<SVGPolylineElement>('.trail');\n  const guide = q<SVGCircleElement>('.guide');\n  const lungs = q<SVGCircleElement>('.lungs');\n  const rings = q<SVGGElement>('.rings');\n  const feet = el.querySelectorAll<HTMLElement>('.wt-foot i');\n  const history: string[] = [];\n  return {\n    el,\n    draw(data) {\n      const [dx, dy] = [data.x * R, -data.y * R];\n      dot.setAttribute('cx', dx.toFixed(1));\n      dot.setAttribute('cy', dy.toFixed(1));\n      history.push(`${dx.toFixed(0)},${dy.toFixed(0)}`);\n      if (history.length > 14) history.shift();\n      trail.setAttribute('points', history.join(' '));\n      guide.style.display = data.breath ? '' : 'none';\n      lungs.style.display = data.breath ? '' : 'none';\n      guide.setAttribute('r', (20 + data.guide * 70).toFixed(1));\n      lungs.setAttribute('r', (20 + data.lungs * 70).toFixed(1));\n      while (rings.childNodes.length < data.rings.length) rings.append(document.createElementNS(SVG, 'circle'));\n      while (rings.childNodes.length > data.rings.length) rings.lastChild?.remove();\n      data.rings.forEach((ring, i) => {\n        const node = rings.childNodes[i] as SVGCircleElement;\n        node.setAttribute('cx', (ring.x * R).toFixed(1));\n        node.setAttribute('cy', (-ring.y * R).toFixed(1));\n        node.setAttribute('r', (ring.r * R).toFixed(1));\n        node.setAttribute('fill', 'none');\n        node.setAttribute('stroke', ring.color ?? '#22a06b');\n        node.setAttribute('stroke-width', '6');\n      });\n      feet[0].style.height = `${Math.round(data.l * 100)}%`;\n      feet[1].style.height = `${Math.round(data.r * 100)}%`;\n    },\n  };\n}\nE\ncat > labs/game/ui/hud/index.ts <<'E'\n/**\n * @file The HUD in play: the Balance Disc when an activity uses balance, the line at the top, each activity's own gauge, lane,\n * cards or lures, and the prompts for the device used last. Built from what the sim holds; it never writes the sim.\n */\nimport type { EvState, Flow, Wobble, Seat } from '../../scenes/types';\nimport { guideOf } from '../../scenes/wobble';\nimport { POSES } from '../../scenes/data/poses';\nimport { EXERCISES } from '../../scenes/events/reps';\nimport { LINE_LENGTH } from '../../scenes/events/line';\nimport { TRAYS } from '../../scenes/data/trays';\nimport { DIVES } from '../../scenes/events/plunge';\nimport { ACTIVITY_PROMPTS, ACTIVITY_TITLES } from '../titles';\nimport { prompt, promptBar } from '../glyphs';\nimport { createDisc, type DiscData } from './disc';\nimport { drawLure } from './lures';\n\nexport interface Hud { update(flow: Flow, seat: { seat: Seat; wobble: Wobble } | null, tick: number, period: number, pose: number, ringSize: number): void; root: HTMLElement }\n\nconst USES_DISC = new Set(['check', 'poseA', 'poseB', 'poseC', 'ring', 'heron', 'reps', 'line', 'plunge', 'pond', 'pondS', 'paddle', 'step', 'stepS', 'tilt']);\n\nexport function createHud(parent: HTMLElement): Hud {\n  const root = document.createElement('div');\n  root.dataset.ui = 'hud-root';\n  parent.append(root);\n  const disc = createDisc(root);\n  const top = document.createElement('div');\n  top.className = 'wt-top';\n  top.dataset.ui = 'hud-top';\n  const bar = document.createElement('div');\n  const gauge = document.createElement('div');\n  gauge.className = 'wt-gauge';\n  gauge.innerHTML = '<div class=\"band\"></div><div class=\"mark\"></div>';\n  const lane = document.createElement('div');\n  lane.className = 'wt-lane';\n  lane.innerHTML = '<div class=\"line\"></div>';\n  const cards = document.createElement('div');\n  cards.className = 'wt-cards';\n  const lure = document.createElement('div');\n  lure.className = 'wt-lure';\n  root.append(top, bar, gauge, lane, cards, lure);\n  let promptsFor = '';\n  const noteNodes: HTMLElement[] = [];\n\n  /** The rings the disc shows and the line at the top. */\n  function rings(ev: EvState, data: DiscData, ringSize: number, seatIndex: number): string {\n    const d = ev.d as Record<string, unknown>;\n    const title = ACTIVITY_TITLES[ev.id] ?? ev.id;\n    switch (ev.id) {\n      case 'check': {\n        const target = (d.targets as number[][])[d.at as number];\n        if (ev.phase === 'ask') return 'Left foot: yes \\u00b7 Right foot: no';\n        if (ev.phase === 'reach' && target) data.rings = [{ x: target[0], y: target[1], r: 0.16, color: '#ff8a70' }];\n        else if (ev.phase === 'foot') data.rings = [{ x: 0, y: 0, r: 0.3 }];\n        else data.rings = [{ x: 0, y: 0, r: ev.t > 480 ? 0.16 : 0.22 }];\n        if (ev.phase === 'foot') return (d.foot as string) === 'l' ? 'Hold your left foot' : 'Hold your right foot';\n        return ev.phase === 'reach' ? `Reach ${d.at as number} of 6` : 'Stay in the ring';\n      }\n      case 'poseA': case 'poseB': case 'poseC': case 'heron': {\n        const list = d.list as string[];\n        const pose = POSES[list[d.at as number]];\n        if (!pose) return title;\n        const seat = pose.seats[Math.min(d.seatAt as number, pose.seats.length - 1)];\n        data.rings = [{ x: seat[0], y: seat[1], r: ringSize * pose.ring }];\n        data.breath = pose.breath > 0;\n        if (ev.phase === 'enter') {\n          const k = ev.s[seatIndex]?.prog ?? 0;\n          data.rings.push({ x: seat[0] * k, y: seat[1] * k, r: 0.18, color: '#ff8a70' });\n          return `${pose.title}: follow the dot`;\n        }\n        return pose.hold === 'both' ? `${pose.title}: hold both feet` : pose.hold === 'l' ? `${pose.title}: hold your left foot` : pose.title;\n      }\n      case 'ring': data.rings = [{ x: 0, y: 0, r: (d.ring as number) ?? 0.22 }]; return ev.phase === 'lead' ? 'Get ready' : title;\n      case 'pond': case 'pondS': data.breath = true; return `Composure ${Math.round(ev.s[seatIndex]?.composure ?? 1000)}`;\n      case 'reps': {\n        const ex = EXERCISES[d.ex as number];\n        if (!ex) return title;\n        const shown = (d.fake as number) ? `${(d.rep as number) + 1} of ${ex.count + 1}` : `${d.rep as number} of ${ex.count}`;\n        return `Rep ${shown}`;\n      }\n      case 'line': return `${Math.round(d.at as number)} of ${LINE_LENGTH} m \\u00b7 Falls ${d.falls as number}`;\n      case 'paddle': return `Gate ${d.at as number} of 12`;\n      case 'garden': return `Tray ${Math.min((d.tray as number) + 1, TRAYS.length)} of ${TRAYS.length}`;\n      case 'plunge': {\n        data.rings = [{ x: 0, y: 0, r: 0.3 }];\n        data.breath = ev.phase === 'compose';\n        const dive = `Dive ${(d.dive as number) + 1} of ${DIVES}`;\n        return ev.phase === 'go' ? `${dive}: let go at the top` : `${dive}`;\n      }\n      case 'hoop': case 'hoopS': {\n        const s = ev.s[seatIndex];\n        const warn = s?.warn > 0 ? (s.side > 0 ? ' \\u00b7 Hoop from the right' : ' \\u00b7 Hoop from the left') : s?.window > 0 ? ' \\u00b7 Lean!' : '';\n        return `Hoops ${s?.hoops ?? 0}${warn}`;\n      }\n      case 'jog': return (d.dist as number) <= 8 ? 'In the Pace Ribbon' : `Gerald is ${Math.round(d.dist as number)} m ahead`;\n      case 'step': case 'stepS': return `Combo ${ev.s[seatIndex]?.combo ?? 0}`;\n      case 'tilt':\n        if (ev.phase === 'east') {\n          data.breath = false;\n          return `On the terrace: ${d.delivered as number}. Everyone east.`;\n        }\n        if (ev.phase === 'carts') {\n          data.rings = [{ x: 0.3, y: 0, r: 0.45 }];\n          return `Crank the carts: ${Math.round((d.cart as number) * 100)}%`;\n        }\n        if (ev.phase === 'stone') {\n          data.rings = [{ x: 0, y: 0, r: d.ring as number }];\n          data.breath = true;\n          return 'You are the island';\n        }\n        return title;\n      default: return title;\n    }\n  }\n\n  return {\n    root,\n    update(flow, seat, tick, period, _pose, ringSize) {\n      const ev = flow.ev;\n      const on = !!(ev && flow.mode === 'event' && seat);\n      root.style.display = on ? '' : 'none';\n      if (!on || !ev || !seat) return;\n      const data: DiscData = { x: seat.wobble.x, y: seat.wobble.y, lungs: seat.wobble.lungs, guide: guideOf(tick, period), calm: seat.wobble.calm, l: seat.seat.input.l, r: seat.seat.input.r, rings: [], breath: false };\n      top.textContent = rings(ev, data, ringSize, seat.seat.index);\n      const useDisc = USES_DISC.has(ev.id) && !(ev.id === 'tilt' && (ev.phase === 'east' || ev.phase === 'storm' || ev.phase === 'dawn'));\n      disc.el.style.display = useDisc && !(ev.id === 'plunge' && ev.phase === 'air') && !ev.id.startsWith('step') ? '' : 'none';\n      if (useDisc) disc.draw(data);\n      const key = ev.id;\n      if (promptsFor !== key) {\n        promptsFor = key;\n        bar.innerHTML = '';\n        const items = ACTIVITY_PROMPTS[ev.id] ?? [];\n        if (!(USES_DISC.has(ev.id) && !ev.id.startsWith('step'))) bar.innerHTML = promptBar(items);\n        else {\n          const div = document.createElement('div');\n          div.className = 'wt-prompts';\n          div.style.cssText = 'position:absolute;left:50%;top:13vh;transform:translateX(-50%);background:rgb(251 248 241 / 92%);border-radius:3vh;padding:.7vh 2.4vh';\n          div.innerHTML = items.map(([v, l]) => prompt(v, l)).join('');\n          bar.append(div);\n        }\n      }\n      // reps' gauge\n      gauge.style.display = ev.id === 'reps' && ev.phase === 'rep' ? '' : 'none';\n      if (ev.id === 'reps') {\n        const d = ev.d as unknown as { band: number; marker: number };\n        (gauge.firstChild as HTMLElement).style.bottom = `${Math.round(d.band * 76)}%`;\n        (gauge.lastChild as HTMLElement).style.bottom = `${Math.round(Math.min(1, d.marker) * 88 + 6)}%`;\n      }\n      // step's lane\n      lane.style.display = ev.id === 'step' || ev.id === 'stepS' ? '' : 'none';\n      if (ev.id === 'step' || ev.id === 'stepS') {\n        const d = ev.d as unknown as { notes: { t: number; k: string }[] };\n        const s = ev.s[seat.seat.index];\n        const shown = d.notes.slice(s?.at ?? 0, (s?.at ?? 0) + 8);\n        while (noteNodes.length < shown.length) {\n          const n = document.createElement('div');\n          n.className = 'wt-note';\n          lane.append(n);\n          noteNodes.push(n);\n        }\n        noteNodes.forEach((n, i) => {\n          const note = shown[i];\n          n.style.display = note ? '' : 'none';\n          if (!note) return;\n          n.textContent = note.k === 'a' ? '\\u2190L' : note.k === 'd' ? 'R\\u2192' : note.k === 'B' ? 'B' : note.k;\n          n.dataset.k = note.k === 'a' ? 'L' : note.k === 'd' ? 'R' : note.k;\n          n.style.left = `${14 + ((note.t - (ev.phase === 'lead' ? -360 + ev.t : ev.t)) / 240) * 86}%`;\n          n.style.top = note.k === 'R' || note.k === 'd' ? '70%' : note.k === 'B' ? '50%' : '30%';\n        });\n      }\n      // plunge's gauge and cards\n      const dive = ev.id === 'plunge' ? (ev.d as unknown as { cards: number[]; gauge: number }) : null;\n      const showCards = dive && ev.phase === 'cards' && dive.cards.length;\n      cards.style.display = showCards ? '' : 'none';\n      if (showCards && cards.dataset.of !== dive.cards.join()) {\n        cards.dataset.of = dive.cards.join();\n        cards.innerHTML = dive.cards.map((c) => `<div>${c}</div>`).join('');\n      }\n      if (dive && ev.phase === 'go') {\n        gauge.style.display = '';\n        (gauge.firstChild as HTMLElement).style.bottom = '76%';\n        (gauge.lastChild as HTMLElement).style.bottom = `${Math.round(dive.gauge * 94)}%`;\n      }\n      drawLure(lure, ev);\n    },\n  };\n}\nE\ncat > labs/game/ui/hud/lures.ts <<'E'\n/**\n * @file Still Pond's lures as the screen shows them: big prompts for your device, a fake pause menu, a fake disconnect\n * message, fake credits. Each is exactly what it pretends to be, so pressing is your fault.\n */\nimport type { EvState } from '../../scenes/types';\nimport { glyphs } from '../glyphs';\nimport { TITLE } from '../titles';\n\nconst LURES: Readonly<Record<string, () => string>> = {\n  pressNow: () => `<div class=\"wt-big\" style=\"display:flex;gap:2vh;align-items:center\">${glyphs('use')} PRESS NOW</div>`,\n  psst: () => `<div class=\"wt-panel wt-body\" style=\"display:flex;gap:1vh;align-items:center\">${glyphs('use')} Yes</div>`,\n  phone: () => '<div class=\"wt-panel wt-body\">Buzz buzz. One new stone.</div>',\n  fakePause: () => '<div class=\"wt-panel\"><div class=\"wt-h\">Paused</div><div class=\"wt-menu\"><div class=\"wt-row\" data-focus=\"1\">Resume</div><div class=\"wt-row\">Quit to Title</div></div></div>',\n  disconnect: () => '<div class=\"wt-panel wt-body\">Your controller appears to be disconnected.<br/>Press any button.</div>',\n  credits: () => `<div class=\"wt-panel wt-body\"><div class=\"wt-h\">Thanks for playing!</div>${TITLE}<br/><span style=\"display:inline-flex;gap:1vh;align-items:center\">${glyphs('use')} Continue</span></div>`,\n};\n\n/** Draws the lure that's up. */\nexport function drawLure(el: HTMLElement, ev: EvState): void {\n  const id = ev.id === 'pond' || ev.id === 'pondS' ? ((ev.d as { lure?: string }).lure ?? '') : '';\n  if (el.dataset.lure === id) return;\n  el.dataset.lure = id;\n  el.dataset.ui = 'lure';\n  el.innerHTML = id && LURES[id] ? LURES[id]() : '';\n}\nE\ncat > labs/game/ui/screens/front.ts <<'E'\n/**\n * @file The front end: the title (with its touch-only form), the pier where you pick a look, the attract banner, and About.\n */\nimport { lineText } from '../lines';\nimport { promptBar, prompt } from '../glyphs';\nimport { closer, panel, type Ctx, type Screen } from '../ctx';\nimport { createRows, type Row } from '../menu';\nimport { TAGLINE, TITLE } from '../titles';\nimport { TRACKSUITS } from '../../bodies';\nimport { CREDITS, ENGINE_FEEDBACK, ENGINE_QUESTIONS, PROMPT_FEEDBACK, PROMPT_QUESTIONS, SOURCE_INFORMATION, SOURCE_LABELS, TESTING_FEEDBACK, TESTING_QUESTIONS } from '../about-data';\nimport { settingsScreen } from './settings';\nimport { boardScreen } from './programme';\nimport { joinScreen } from './group';\n\nexport interface TitleOptions { touch: () => boolean; onBegin: (fresh: boolean) => void; hasSave: () => boolean }\n\n/** The title screen. */\nexport function titleScreen(ctx: Ctx, options: TitleOptions): Screen {\n  const layer = document.createElement('div');\n  layer.className = 'wt-layer';\n  layer.dataset.ui = 'title';\n  layer.innerHTML = `<div class=\"wt-title\">${TITLE}</div><div class=\"wt-tag\">${TAGLINE}</div>`;\n  const box = document.createElement('div');\n  box.className = 'wt-panel';\n  layer.append(box);\n  ctx.root.append(layer);\n  const touchNote = document.createElement('div');\n  touchNote.className = 'wt-touch';\n  touchNote.textContent = 'Controller or keyboard required';\n  const rows = (): Row[] => {\n    if (options.touch()) return [{ id: 'settings', label: 'Settings' }];\n    const save = options.hasSave();\n    return [\n      { id: 'begin', label: save ? 'Continue' : 'Begin' },\n      ...(save ? [{ id: 'new', label: 'Begin Again' }] : []),\n      { id: 'free', label: 'Free Play', off: !save },\n      { id: 'group', label: 'Group Class' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'about', label: 'About / Credits' },\n    ];\n  };\n  const menu = createRows(box, rows(), ctx.input, (id) => {\n    if (id === 'begin') options.onBegin(false);\n    else if (id === 'new') ctx.push(confirmScreen(ctx, 'Begin again? Your cairn will be taken apart.', () => options.onBegin(true)));\n    else if (id === 'free') ctx.push(boardScreen(ctx, true));\n    else if (id === 'group') ctx.push(joinScreen(ctx));\n    else if (id === 'settings') ctx.push(settingsScreen(ctx));\n    else if (id === 'about') ctx.push(aboutScreen(ctx));\n  }, () => {}, () => ctx.sound.audio.play('sfx:select'));\n  let touchShown: boolean | null = null;\n  return {\n    el: layer,\n    update(dt) {\n      const touch = options.touch();\n      if (touch !== touchShown) {\n        touchShown = touch;\n        touchNote.remove();\n        if (touch) box.prepend(touchNote);\n        menu.setRows(rows());\n      }\n      menu.update(dt);\n    },\n    close: closer(layer),\n  };\n}\n\n/** Are you sure, in-game. */\nexport function confirmScreen(ctx: Ctx, text: string, yes: () => void): Screen {\n  const { layer, box } = panel(ctx);\n  const body = document.createElement('div');\n  body.className = 'wt-body';\n  body.style.marginBottom = '2vh';\n  body.textContent = text;\n  box.append(body);\n  const menu = createRows(box, [{ id: 'no', label: 'No' }, { id: 'yes', label: 'Yes' }], ctx.input, (id) => {\n    ctx.pop();\n    if (id === 'yes') yes();\n  }, () => ctx.pop());\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\n/** The pier: one of three looks, a tracksuit colour. */\nexport function pierScreen(ctx: Ctx, done: () => void): Screen {\n  const { layer, box } = panel(ctx, 'Welcome to Little Fulcrum');\n  const s = ctx.settings;\n  const looks = ['One', 'Two', 'Three'];\n  const colours = ['Coral', 'Blue'];\n  const rows: Row[] = [\n    { id: 'look', label: 'Look', value: () => looks[s.look], change: (dir) => void (s.look = (s.look + dir + 3) % 3) },\n    { id: 'colour', label: 'Tracksuit', value: () => colours[s.colour % 2], change: (dir) => void (s.colour = (s.colour + dir + 2) % 2) },\n    { id: 'go', label: 'Step ashore' },\n  ];\n  const menu = createRows(box, rows, ctx.input, () => {\n    ctx.saveSettings();\n    ctx.pop();\n    done();\n  }, () => {});\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\nvoid TRACKSUITS;\n\n/** The attract banner. */\nexport function attractBanner(ctx: Ctx): HTMLElement {\n  const el = document.createElement('div');\n  el.className = 'wt-banner';\n  el.dataset.ui = 'attract';\n  el.innerHTML = `<div class=\"wt-title\" style=\"font-size:8vh\">${TITLE}</div><div class=\"wt-demo\">DEMO</div><div style=\"margin-top:1.5vh;display:flex;justify-content:center\">${prompt('any', 'Press any button')}</div>`;\n  ctx.root.append(el);\n  return el;\n}\n\n/** About and credits: paged, from the one data file. */\nexport function aboutScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'About / Credits');\n  layer.dataset.ui = 'about';\n  const body = document.createElement('div');\n  body.className = 'wt-about';\n  box.append(body);\n  const qa = (questions: readonly string[], answers: readonly string[]) => questions.map((q, i) => [q, answers[i]] as const);\n  const source = Object.entries(SOURCE_INFORMATION).map(([k, v]) => [SOURCE_LABELS[k], v] as const);\n  const pages: { title: string; rows: readonly (readonly [string, string])[] }[] = [\n    { title: 'Source Information', rows: source.slice(0, 7) },\n    { title: 'Source Information', rows: source.slice(7) },\n    { title: 'Testing Feedback', rows: qa(TESTING_QUESTIONS, TESTING_FEEDBACK) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_QUESTIONS.slice(0, 3), ENGINE_FEEDBACK.slice(0, 3)) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_QUESTIONS.slice(3), ENGINE_FEEDBACK.slice(3)) },\n    { title: 'Prompt Feedback', rows: qa(PROMPT_QUESTIONS, PROMPT_FEEDBACK) },\n    { title: 'Credits', rows: CREDITS.map((c) => ['', c] as const) },\n  ];\n  let at = 0;\n  const heading = box.querySelector('.wt-h') as HTMLElement;\n  const draw = () => {\n    heading.textContent = `${pages[at].title} (${at + 1} of ${pages.length})`;\n    body.innerHTML = '';\n    for (const [k, v] of pages[at].rows) {\n      const p = document.createElement('p');\n      if (k) {\n        const b = document.createElement('b');\n        b.textContent = `${k}: `;\n        p.append(b);\n      }\n      p.append(document.createTextNode(v));\n      body.append(p);\n    }\n  };\n  draw();\n  const nav = document.createElement('div');\n  nav.innerHTML = promptBar([['page', 'Page'], ['back', 'Back']]).replace('wt-bar', 'wt-prompts');\n  nav.style.marginTop = '1.5vh';\n  box.append(nav);\n  const turn = (dir: number) => {\n    at = (at + dir + pages.length) % pages.length;\n    draw();\n  };\n  box.addEventListener('click', () => turn(1));\n  return {\n    el: layer,\n    update() {\n      if (ctx.input.pressed('uiRight') || ctx.input.pressed('uiDown') || ctx.input.pressed('uiAccept')) turn(1);\n      if (ctx.input.pressed('uiLeft') || ctx.input.pressed('uiUp')) turn(-1);\n      if (ctx.input.pressed('uiCancel')) ctx.pop();\n    },\n    close: closer(layer),\n  };\n}\nvoid lineText;\nE\ncat > labs/game/ui/screens/settings.ts <<'E'\n/**\n * @file Settings, paged at six rows, and Controls: every binding per scheme, keyboard rebinding through the engine's bindings.\n * Music is 10% by default. Erase Save asks in-game, never with `confirm()`.\n */\nimport { prompt } from '../glyphs';\nimport { closer, DEFAULT_SETTINGS, panel, type Ctx, type Screen } from '../ctx';\nimport { createRows, type Row } from '../menu';\nimport { confirmScreen } from './front';\n\nconst pct = (v: number) => `${Math.round(v * 100)}%`;\nconst step = (v: number, dir: number, by = 0.1) => Math.round(Math.max(0, Math.min(1, v + dir * by)) * 100) / 100;\n\n/** Settings. */\nexport function settingsScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'Settings');\n  layer.dataset.ui = 'settings';\n  const s = ctx.settings;\n  const save = () => ctx.saveSettings();\n  const pages: Row[][] = [\n    [\n      { id: 'music', label: 'Music', value: () => pct(s.music), change: (d) => { s.music = step(s.music, d); ctx.sound.audio.volume('music', s.music); save(); } },\n      { id: 'effects', label: 'Effects', value: () => pct(s.effects), change: (d) => { s.effects = step(s.effects, d); ctx.sound.audio.volume('effects', s.effects); save(); } },\n      { id: 'voices', label: 'Voices', value: () => pct(s.voices), change: (d) => { s.voices = step(s.voices, d); ctx.sound.voices = s.voices; save(); } },\n      { id: 'next1', label: 'More settings' },\n      { id: 'back', label: 'Back' },\n    ],\n    [\n      { id: 'icons', label: 'Button icons', value: () => (s.icons === 'ps' ? 'PlayStation' : 'Xbox'), change: () => { s.icons = s.icons === 'ps' ? 'xbox' : 'ps'; ctx.root.dataset.pad = s.icons; save(); } },\n      { id: 'mouse', label: 'Mouse sensitivity', value: () => pct(s.mouse), change: (d) => { s.mouse = Math.max(0.2, Math.min(3, Math.round((s.mouse + d * 0.1) * 10) / 10)); save(); } },\n      { id: 'invert', label: 'Invert look', value: () => (s.invert ? 'On' : 'Off'), change: () => { s.invert = !s.invert; ctx.inspector.set('input.invertY', s.invert); save(); } },\n      { id: 'rumble', label: 'Rumble', value: () => (s.rumble ? 'On' : 'Off'), change: () => { s.rumble = !s.rumble; save(); } },\n      { id: 'next2', label: 'More settings' },\n      { id: 'back', label: 'Back' },\n    ],\n    [\n      { id: 'steadier', label: 'Steadier Hands', value: () => (s.steadier ? 'On' : 'Off'), change: () => { s.steadier = !s.steadier; ctx.run('game.flags', { steadier: s.steadier }); save(); } },\n      { id: 'reduced', label: 'Reduced Motion', value: () => (s.reduced ? 'On' : 'Off'), change: () => { s.reduced = !s.reduced; save(); } },\n      { id: 'fullscreen', label: 'Fullscreen', value: () => (document.fullscreenElement ? 'On' : 'Off'), change: () => { if (document.fullscreenElement) void document.exitFullscreen(); else void document.documentElement.requestFullscreen?.(); } },\n      { id: 'erase', label: 'Erase Save' },\n      { id: 'next3', label: 'First settings' },\n      { id: 'back', label: 'Back' },\n    ],\n  ]; // prettier-ignore\n  let at = 0;\n  const menu = createRows(box, pages[0], ctx.input, (id) => {\n    if (id === 'back') ctx.pop();\n    else if (id.startsWith('next')) {\n      at = (at + 1) % pages.length;\n      menu.setRows(pages[at]);\n    } else if (id === 'erase') {\n      ctx.push(confirmScreen(ctx, 'Erase your save? The cairn, the ages and every stamp.', () => {\n        ctx.store.remove('game');\n        Object.assign(s, { ...DEFAULT_SETTINGS });\n        ctx.sound.audio.volume('music', s.music);\n        save();\n        ctx.say('after', 'tare');\n      }));\n    }\n  }, () => ctx.pop());\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\nconst KEY_ACTIONS: readonly [string, string][] = [['forward', 'Lean forward'], ['back', 'Lean back'], ['left', 'Lean left'], ['right', 'Lean right'], ['footl', 'Left foot'], ['footr', 'Right foot']];\n\n/** Controls: what each verb is, and rebinding for keys. */\nexport function controlsScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'Controls');\n  layer.dataset.ui = 'controls';\n  const note = document.createElement('div');\n  note.className = 'wt-prompts';\n  note.style.marginBottom = '1.2vh';\n  note.innerHTML = [prompt('lean', 'Lean'), prompt('footL', 'Left'), prompt('footR', 'Right'), prompt('both', 'Breathe')].join('');\n  box.append(note);\n  const binds = ctx.input.bindingsFor('actionMap:balance');\n  const label = (action: string) => binds.label(action, 'keyboard');\n  let listening = false;\n  const rows: Row[] = [...KEY_ACTIONS.map(([action, title]) => ({ id: action, label: title, value: () => (listening ? '\\u2026' : label(action)) })), { id: 'reset', label: 'Reset keys', value: () => '' }];\n  const shown: Row[] = rows.slice(0, 5).concat({ id: 'more', label: 'More' });\n  let page = 0;\n  const menu = createRows(box, shown, ctx.input, (id) => {\n    if (id === 'more') {\n      page = 1 - page;\n      menu.setRows(page ? rows.slice(5).concat({ id: 'more', label: 'Back to the first' }) : shown);\n    } else if (id === 'reset') {\n      binds.reset();\n    } else if (!listening) {\n      listening = true;\n      void ctx.input.listen('keyboard').then((code) => {\n        listening = false;\n        if (!code) return;\n        const old = binds.codes(id).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse') && !c.startsWith('Arrow'));\n        binds.rebind(id, code, old ? { replace: old } : undefined);\n      });\n    }\n  }, () => {\n    if (!listening) ctx.pop();\n  });\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\nE\ngrep -n \"invert\" engine/input/look.ts | head -3 | cut -c1-120","description":"Write context, shots, HUD, title, settings, about screens"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018BXFC97a6S1iFPKaeby9kD","type":"tool_result","content":"9: * (`input.stickAdsSensitivity` aiming). Pushing the mouse away or the stick forward looks up; `input.invert` and\n18: * scaleLook({ counts: [0, 10], stick: [0, -1] }, { ...options, invert: true }, false); // look down, the stick up\n45:  'input.invert': {","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"4392be77-6868-4bde-93cf-f39b33a64e36","timestamp":"2026-11-05T10:24:30.311Z","tool_use_result":{"stdout":"9: * (`input.stickAdsSensitivity` aiming). Pushing the mouse away or the stick forward looks up; `input.invert` and\n18: * scaleLook({ counts: [0, 10], stick: [0, -1] }, { ...options, invert: true }, false); // look down, the stick up\n45:  'input.invert': {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018BXFC97a6S1iFPKaeby9kD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
