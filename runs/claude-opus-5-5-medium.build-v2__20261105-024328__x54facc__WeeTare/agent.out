n 3,12p; grep -n \"export function createOverlay\" engine/ui/overlay.ts; grep -n \"readonly root\\|label(\\|hud(\" engine/ui/overlay.ts | head -8 | cut -c1-120; sed -n 1,40p engine/input/devices/gamepad.ts | grep -n \"active\\|last\" | head -5","description":"Make reps bots rhythm-led and check","timeout":220000}}}
