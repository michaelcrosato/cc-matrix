{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaWuWXUtWyijpH7MtqS","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25291,"cache_read_input_tokens":206944,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25291},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"15dc60bb-849c-40e4-b37f-ee2763cab375","timestamp":"2026-11-05T09:54:24.465Z","request_id":"req_011CgjaWuBCLBcHLzVp8voZZ","thinking_duration_ms":2518,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaWuWXUtWyijpH7MtqS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LFpKLmJFfgYMCA77TBL7UX","name":"Bash","input":{"command":"python3 - <<'E'\nimport re\np='labs/game/scenes/events/kit.ts';s=open(p).read()\ns=s.replace(\"return [sx * cz, sx * sz * -1 * 0 + 0, cx * sz, cx * cz];\",\"return [sx * cz, -sx * sz, cx * sz, cx * cz];\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/events/reps.ts <<'E'\n/**\n * @file Reps Hall (PLAN.md section 6): the signature \"your thumb is the exercise\". A band moves up and down a gauge at the\n * tempo; your marker is your stick's depth, and it scrubs the body. Stay near the band and the rep is banked. Gerald, beside\n * you, does two for each of yours. Near the end the counter cheats: \"9 of 10\" becomes \"10 of 11\".\n */\nimport { setLoop, setPose } from '../../cast/body';\nimport type { Order } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { rankScore } from './mats';\nimport { balanceAll, bodyPose, clamp, ownProp, phase, playing, standAt, stationAt, groundAt, type Activity } from './kit';\n\n/** Three exercises. `clip` scrubs; `axis` reads the stick; `count` is the reps. */\nexport const EXERCISES = [\n  { id: 'knees', clip: 'RETREAT/DeepKnee', axis: 'y', sign: -1, count: 10, hold: false },\n  { id: 'pushups', clip: 'RETREATLIB/Pushup', axis: 'y', sign: -1, count: 8, hold: true },\n  { id: 'lunges', clip: 'RETREAT/SideLunge', axis: 'x', sign: 0, count: 10, hold: false },\n] as const;\n\nconst DEPTH = 0.62;\nconst WINDOW = 0.2;\nconst INTRO = 150;\n\ninterface RepsData { ex: number; rep: number; phaseT: number; band: number; marker: number; fake: number; sum: number; reps: number; inside: number; steps: number; total: number; banked: number }\n\nconst dataOf = (ev: EvState): RepsData => ev.d as unknown as RepsData;\n\n/** Steps a rep takes now: the band quickens near the end of each exercise. */\nfunction repSteps(w: W, d: RepsData): number {\n  const ex = EXERCISES[d.ex];\n  const late = d.rep >= ex.count - 3 ? 0.85 : 1;\n  return Math.round(gameNumber(w, 'game.reps.tempo') * 60 * late);\n}\n\n/** The band at `k` of a rep: out and back. */\nexport const bandAt = (k: number): number => (k < 0.5 ? k * 2 : 2 - k * 2);\n\n/** Which way a rep goes, on the stick. */\nfunction signOf(d: RepsData): number {\n  const ex = EXERCISES[d.ex];\n  return ex.axis === 'x' ? (d.rep % 2 === 0 ? 1 : -1) : ex.sign;\n}\n\nfunction step(w: W, ev: EvState): void {\n  const d = dataOf(ev);\n  const [e] = playing(w, ev);\n  const { gerald } = castOf(w);\n  balanceAll(w, ev);\n  if (ev.phase === 'intro') {\n    bodyPose(w, e, EXERCISES[d.ex].clip, 0, false, 0.4);\n    if (ev.t === 0) say(w, `reps.${EXERCISES[d.ex].id}`, 'plumb');\n    if (ev.t >= INTRO) {\n      d.phaseT = 0;\n      phase(ev, 'rep');\n    }\n    return;\n  }\n  const ex = EXERCISES[d.ex];\n  const steps = repSteps(w, d);\n  const k = d.phaseT / steps;\n  d.band = bandAt(k);\n  const sign = signOf(d);\n  const value = ex.axis === 'x' ? e.wobble.x : e.wobble.y;\n  d.marker = clamp((value * sign) / DEPTH, 0, 1.2);\n  e.wobble.sway = 1 + (d.total / 28) * 0.6;\n  const heldOk = !ex.hold || (e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5);\n  const off = ex.axis === 'x' ? e.wobble.y : e.wobble.x;\n  d.steps += 1;\n  if (Math.abs(d.marker - d.band) <= WINDOW && heldOk && Math.abs(off) < 0.45) d.inside += 1;\n  const clipT = ex.clip === 'RETREATLIB/Pushup' ? 0.77 * (1 - clamp(d.marker, 0, 1)) + 0.0 : clamp(d.marker, 0, 1);\n  bodyPose(w, e, ex.clip, clipT, ex.axis === 'x' && sign < 0, 0.3);\n  if (gerald >= 0) setLoop(w, gerald, ex.axis === 'y' && ex.id === 'pushups' ? 'RETREATLIB/Pushup' : 'RETREATLIB/Jumping_Jacks_Loop', 2);\n  d.phaseT += 1;\n  if (d.phaseT >= steps) {\n    d.phaseT = 0;\n    const accuracy = d.inside / Math.max(1, d.steps);\n    d.sum += accuracy;\n    d.reps += 1;\n    d.rep += 1;\n    d.total += 1;\n    [d.inside, d.steps] = [0, 0];\n    if (accuracy >= 0.5) d.banked += 1;\n    cue(w, accuracy >= 0.5 ? 'repGood' : 'repMiss');\n    w.emit('rep', { n: d.rep, of: ex.count, ok: accuracy >= 0.5 } as never);\n    if (d.rep === ex.count - 1) {\n      d.fake = 1;\n      say(w, 'reps.cheat', 'plumb');\n    }\n    if (d.rep >= ex.count) {\n      d.ex += 1;\n      d.rep = 0;\n      d.fake = 0;\n      if (d.ex >= EXERCISES.length) {\n        ev.score = rankScore((1000 * d.sum) / Math.max(1, d.reps));\n        ev.done = true;\n        return;\n      }\n      cue(w, 'bell');\n      phase(ev, 'intro');\n    }\n  }\n}\n\nfunction bot(w: W, ev: EvState, _e: SeatE): Order {\n  const d = dataOf(ev);\n  if (ev.phase !== 'rep') return { aim: [0, 0] };\n  const ex = EXERCISES[d.ex];\n  const lead = 24;\n  const k = (d.phaseT + lead) / repSteps(w, d);\n  const want = bandAt(k > 1 ? k - 1 : k) * DEPTH * signOf(d);\n  const feet = ex.hold ? 1 : 0;\n  return { aim: ex.axis === 'x' ? [want, 0] : [0, want], l: feet, r: feet };\n}\n\nexport const REPS: Activity = {\n  id: 'reps', title: 'Reps Hall', station: 'annex', shot: 'reps', map: 'balance', song: 'song:lobby',\n  setup(w, ev) {\n    const c = stationAt(w, 'annex');\n    const [e] = playing(w, ev);\n    const { gerald } = castOf(w);\n    ownProp(w, ev, 'prop:matSeat0', [c.x - 3, groundAt(w, c.x - 3, c.z) + 0.01, c.z - 3]);\n    standAt(w, e.seat.actor, c.x - 3, c.z - 3, Math.PI);\n    if (gerald >= 0) standAt(w, gerald, c.x + 1, c.z - 3, Math.PI);\n    resetWobble(e.wobble);\n    Object.assign(ev.d, { ex: 0, rep: 0, phaseT: 0, band: 0, marker: 0, fake: 0, sum: 0, reps: 0, inside: 0, steps: 0, total: 0, banked: 0 });\n    ev.s[e.seat.index] = {};\n    phase(ev, 'intro');\n  },\n  step, bot,\n  teardown(w) {\n    const { gerald } = castOf(w);\n    if (gerald >= 0) setPose(w, gerald, 'RETREAT/Stand', 0);\n  },\n}; // prettier-ignore\nE\ncat > labs/game/scenes/data/charts.ts <<'E'\n/**\n * @file Step Class's charts as strings, one token an eighth note: L and R are feet, B both (a jump), a and d side steps\n * (lean plus foot), `.` a rest, `|` nothing but reading help. Adding a chart is adding a row.\n */\nexport interface Phrase { readonly bpm: number; readonly chart: string }\n\nexport const PHRASES: readonly Phrase[] = [\n  { bpm: 104, chart: 'L . R . L . R . | L . R . L . R . | L L R . B . . . | L . R . L . R . | L L R . B . . . | R R L . B . . . | a . . . d . . . | L . R . B . . . | L . R . L . R . | L L R . B . . . | a . d . a . d . | B . . . B . . .' },\n  { bpm: 112, chart: 'L . R . a . d . | L R L . R L R . | B . . . L . R . | a . L . d . R . | L R L . B . . . | R L R . B . . . | a . d . L . R . | L L R R B . . . | L R L R L . R . | a . d . a . d . | B . L . B . R . | L R L R B . . . | a . L . d . R . | B . . . B . . .' },\n  { bpm: 120, chart: 'L R L R L . R . | B . a . B . d . | L R L . R L R . | a L d R a L d R | B . B . L R L . | R L R . B . . . | L L R R L L R R | a . d . B . . . | L R L R B . L R | L R B . a . d . | L R L . R L R . | a L d R B . . . | L R L R L R L R | B . . . B . . . | a . d . a . d . | B . B . B . . .' },\n];\n\n/** The short form deals one phrase at this tempo. */\nexport const SHORT_PHRASE: Phrase = {\n  bpm: 112,\n  chart: 'L . R . L . R . | L R L . B . . . | R L R . B . . . | a . . . d . . . | L . R . a . d . | L R L . B . . . | L L R . B . . . | a . d . L . R . | L R L R B . . . | a L d R B . . . | L . R . L . R . | B . . . B . . .',\n};\nE\ncat > labs/game/scenes/events/step.ts <<'E'\n/**\n * @file Step Class (PLAN.md section 6): rhythm on a step platform. Charts become notes timed in whole sim steps, never\n * audio time; the sim's `beat` events fire the claps and kicks on the effects bus, because the music is only a bed. The\n * guests behind you follow your combo: lose it and they fall out of time, one by one, politely.\n */\nimport { setLoop, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { PHRASES, SHORT_PHRASE, type Phrase } from '../data/charts';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { balanceAll, bodyPose, footDown, groundAt, leadIn, ownProp, phase, playing, standAt, stationAt, clamp, type Activity } from './kit';\n\n/** One note: when, in steps from the start, and what. */\nexport interface Note { t: number; k: string }\n\n/** A BPM as an eighth note in steps. */\nconst eighth = (bpm: number): number => (60 / bpm / 2) * 60;\n\n/** The notes and the beats of phrases, scaled by `game.step.bpm`. */\nexport function buildChart(phrases: readonly Phrase[], scale: number): { notes: Note[]; beats: number[]; end: number; phraseAt: number[] } {\n  const notes: Note[] = [];\n  const beats: number[] = [];\n  const phraseAt: number[] = [];\n  let at = 120;\n  for (const phrase of phrases) {\n    const each = eighth(phrase.bpm * scale);\n    phraseAt.push(Math.round(at));\n    const tokens = phrase.chart.split(/\\s+/).filter((token) => token !== '|');\n    tokens.forEach((token, i) => {\n      const t = Math.round(at + i * each);\n      if (i % 2 === 0) beats.push(t);\n      if (token !== '.') notes.push({ t, k: token });\n    });\n    at += tokens.length * each + 60;\n  }\n  return { notes, beats, end: Math.round(at + 60), phraseAt };\n}\n\ninterface StepData { notes: Note[]; beats: number[]; beatAt: number; end: number; outOfTime: number }\nconst dataOf = (ev: EvState): StepData => ev.d as unknown as StepData;\n\n/** The foot a note wants. */\nconst wantFoot = (k: string): 'l' | 'r' | 'b' => (k === 'L' || k === 'a' ? 'l' : k === 'R' || k === 'd' ? 'r' : 'b');\n\n/** Judges a seat's feet against its next notes. */\nfunction judge(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const s = ev.s[e.seat.index];\n  const perfect = gameNumber(w, 'game.step.perfect');\n  const good = gameNumber(w, 'game.step.good');\n  while (s.at < d.notes.length && ev.t > d.notes[s.at].t + good) {\n    s.at += 1;\n    s.miss += 1;\n    s.combo = 0;\n    if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: 'miss', seat: e.seat.index } as never);\n  }\n  const left = footDown(e, 'l');\n  const right = footDown(e, 'r');\n  if (!left && !right) return;\n  const note = d.notes[s.at];\n  if (!note) return;\n  const gap = Math.abs(ev.t - note.t);\n  if (gap > good) return;\n  const want = wantFoot(note.k);\n  const both = e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5;\n  const footOk = want === 'b' ? both : want === 'l' ? left : right;\n  if (!footOk) {\n    if (want !== 'b') {\n      s.combo = 0;\n      s.at += 1;\n      s.miss += 1;\n      if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: 'miss', seat: e.seat.index } as never);\n    }\n    return;\n  }\n  const leanOk = note.k === 'a' ? e.wobble.x < -0.15 : note.k === 'd' ? e.wobble.x > 0.15 : true;\n  const grade = gap <= perfect && leanOk ? 1 : 0.6;\n  s.combo += 1;\n  const mult = 1 + Math.min(0.5, s.combo * 0.025);\n  s.points += grade * mult;\n  s.at += 1;\n  s.hit += 1;\n  s.pose = want === 'b' ? 3 : want === 'l' ? 1 : 2;\n  s.poseT = 16;\n  if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: grade === 1 ? 'perfect' : 'good', seat: e.seat.index, foot: want } as never);\n}\n\n/** The most points a chart could give, at a full combo. */\nfunction maxPoints(count: number): number {\n  let sum = 0;\n  for (let c = 1; c <= count; c++) sum += 1 + Math.min(0.5, c * 0.025);\n  return sum;\n}\n\nfunction body(w: W, e: SeatE, s: Record<string, number>): void {\n  s.poseT = Math.max(0, s.poseT - 1);\n  const k = clamp(s.poseT / 16, 0, 1);\n  if (s.pose === 3) bodyPose(w, e, 'RETREAT/Jump', k, false, 0.5);\n  else bodyPose(w, e, s.pose === 1 ? 'RETREAT/StepUpL' : 'RETREAT/StepUpR', k, false, 0.5);\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  const d = dataOf(ev);\n  while (d.beatAt < d.beats.length && d.beats[d.beatAt] <= ev.t) {\n    w.emit('beat', { n: d.beatAt } as never);\n    d.beatAt += 1;\n  }\n  balanceAll(w, ev);\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    judge(w, ev, e);\n    body(w, e, ev.s[e.seat.index]);\n    e.seat.score = (1000 * ev.s[e.seat.index].points) / maxPoints(d.notes.length);\n  }\n  const first = ev.s[ev.seats[0]];\n  const { extras } = castOf(w);\n  const wantOut = first.combo >= 8 ? 0 : first.combo >= 3 ? 1 : first.combo >= 1 ? 2 : 3;\n  d.outOfTime = wantOut;\n  if (!ev.short) {\n    extras.slice(0, 3).forEach((id, i) => setLoop(w, id, 'RETREATLIB/Dance_Loop', i < 3 - wantOut ? 2 : 0.6));\n  }\n  if (ev.t >= d.end) {\n    ev.score = rankScore((1000 * first.points) / maxPoints(d.notes.length));\n    say(w, ev.score > 750 ? 'step.endGood' : 'step.endFair', 'plumb');\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const d = dataOf(ev);\n  const s = ev.s[e.seat.index];\n  const note = d.notes[s.at];\n  if (!note) return { aim: [0, 0] };\n  if (s.jit === undefined || s.jitFor !== s.at) {\n    s.jit = skill.timing ? w.rng('bot').range(-skill.timing * 1.15, skill.timing * 1.15) : 0;\n    s.jitFor = s.at;\n  }\n  const when = note.t + s.jit;\n  const want = wantFoot(note.k);\n  const near = note.k === 'a' ? -0.5 : note.k === 'd' ? 0.5 : 0;\n  const down = ev.t >= when && ev.t < when + 6;\n  const order: Order = { aim: [note.t - ev.t < 30 ? near : 0, 0] };\n  if (down) {\n    if (want === 'l' || want === 'b') order.l = 1;\n    if (want === 'r' || want === 'b') order.r = 1;\n  }\n  return order;\n}\n\nfunction stepActivity(id: string, title: string, phrases: readonly Phrase[], short: boolean): Activity {\n  return {\n    id, title, station: short ? 'pavilion' : 'annex', shot: short ? 'mat' : 'step', map: 'balance', song: 'song:stepBed', multi: short,\n    setup(w, ev) {\n      Object.assign(ev.d, { ...buildChart(phrases, gameNumber(w, 'game.step.bpm')), beatAt: 0, outOfTime: 0 });\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.sway = 0.45; }\n      ev.seats.forEach((i) => (ev.s[i] = { at: 0, combo: 0, points: 0, hit: 0, miss: 0, pose: 1, poseT: 0 }));\n      if (short) {\n        arrangeClass(w, ev);\n        return phase(ev, 'lead');\n      }\n      const c = stationAt(w, 'annex');\n      const [e] = playing(w, ev);\n      const y = groundAt(w, c.x, c.z + 2);\n      ownProp(w, ev, 'prop:stepPlatform', [c.x, y, c.z + 2]);\n      for (let k = 0; k < 6; k++) ownProp(w, ev, 'prop:floorTile', [c.x - 3.75 + k * 1.5, y + 0.01, c.z + 4.4]);\n      standAt(w, e.seat.actor, c.x, c.z + 2, Math.PI);\n      const { extras, plumb } = castOf(w);\n      if (plumb >= 0) {\n        standAt(w, plumb, c.x, c.z - 3, 0);\n        setPose(w, plumb, 'RETREAT/Stand', 0);\n      }\n      extras.slice(0, 3).forEach((id, i) => standAt(w, id, c.x - 3 + i * 3, c.z + 6, Math.PI));\n      say(w, 'step.intro', 'plumb');\n      phase(ev, 'go');\n    },\n    step, bot,\n    teardown(w) {\n      if (!short) castOf(w).extras.slice(0, 3).forEach((id) => setPose(w, id, 'RETREAT/Stand', 0));\n    },\n  }; // prettier-ignore\n}\n\nexport const STEP = stepActivity('step', 'Step Class', PHRASES, false);\nexport const STEP_SHORT = stepActivity('stepS', 'Step Class', [SHORT_PHRASE], true);\nE\ncat > labs/game/scenes/events/hoop.ts <<'E'\n/**\n * @file Hoop Patrol (PLAN.md section 6). Spin your stick in circles: an angular speed in the band keeps every hoop up;\n * outside it they sink and fall. A new hoop comes every 8 s from a telegraphed side: lean that way in time to catch it.\n * The hip-circle strip scrubs with the stick's angle, so the hips follow your thumb, with increasing dignity. Keyboard:\n * alternate feet at 2.5 Hz or more counts as spinning.\n */\nimport { angDiff } from '../../../../engine/sim-api';\nimport type { Order, Skill } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { arrangeClass, rankScore } from './mats';\nimport { bodyPose, clamp, footDown, groundAt, leadIn, moveProp, ownProp, phase, playing, standAt, stationAt, type Activity } from './kit';\n\nconst EVERY = 480;\nconst WARN = 90;\nconst CATCH = 36;\nconst MAX = 8;\nconst LENGTH = 3600;\nconst SHORT_LENGTH = 2700;\n\ninterface HoopData { length: number; props: number[] }\nconst dataOf = (ev: EvState): HoopData => ev.d as unknown as HoopData;\n\n/** The best hoop-seconds a run of `steps` could hold. */\nfunction bestHoopSeconds(steps: number): number {\n  let sum = 0;\n  for (let t = 0; t < steps; t++) sum += Math.min(MAX, 1 + Math.floor(t / EVERY));\n  return sum / 60;\n}\n\n/** Runs one seat. */\nfunction seatStep(w: W, ev: EvState, e: SeatE): void {\n  const s = ev.s[e.seat.index];\n  const { input } = e.seat;\n  const sx = input.x + e.wobble.mx;\n  const sy = input.y + e.wobble.my;\n  const mag = Math.hypot(sx, sy);\n  const dt = 1 / 60;\n  if (mag > 0.5) {\n    const angle = Math.atan2(sy, sx);\n    s.spin += (Math.abs(angDiff(s.angle, angle)) / dt - s.spin) * 0.05;\n    s.angle = angle;\n  } else s.spin *= 0.97;\n  if (footDown(e, 'l') || footDown(e, 'r')) {\n    const left = footDown(e, 'l');\n    if (left !== !!s.lastLeft) {\n      const gap = ev.t - s.lastFoot;\n      s.footRate = gap > 0 ? 60 / gap : 0;\n      s.lastFoot = ev.t;\n      s.lastLeft = left ? 1 : 0;\n    }\n  }\n  if (ev.t - s.lastFoot > 40) s.footRate = 0;\n  const min = gameNumber(w, 'game.hoop.bandMin');\n  const max = gameNumber(w, 'game.hoop.bandMax');\n  const feetSpin = s.footRate >= 2.5;\n  const inBand = (s.spin >= min && s.spin <= max) || feetSpin;\n  if (feetSpin) s.angle += 7 * dt;\n  s.good = inBand ? 1 : 0;\n  s.height += (inBand ? 0.6 : -0.35) * dt;\n  s.height = Math.min(1, s.height);\n  if (s.height <= 0) {\n    if (s.hoops > 0) {\n      s.hoops -= 1;\n      s.dropped += 1;\n      cue(w, 'hoopDrop');\n      if (s.hoops === 0 && e.seat.index === ev.seats[0]) say(w, 'hoop.drop', 'tare');\n    }\n    s.height = s.hoops > 0 ? 0.5 : 0;\n  }\n  // a new hoop, telegraphed\n  if (s.warn > 0) {\n    s.warn -= 1;\n    if (s.warn === 0) {\n      s.window = CATCH;\n      cue(w, 'hoopWhoosh');\n    }\n  } else if (s.window > 0) {\n    s.window -= 1;\n    const lean = s.side * sx;\n    if (lean > 0.5 || (feetSpin && (s.side < 0 ? input.l : input.r) >= 0.5)) {\n      s.hoops = Math.min(MAX, s.hoops + 1);\n      s.height = Math.max(s.height, 0.5);\n      s.window = 0;\n      s.caught += 1;\n      cue(w, 'hoopCatch', { n: s.hoops });\n    }\n  } else if (ev.t > 0 && ev.t % EVERY === EVERY - WARN) {\n    s.side = w.rng('hoop').chance(0.5) ? 1 : -1;\n    s.warn = WARN;\n    if (e.seat.index === ev.seats[0]) cue(w, 'hoopWarn', { side: s.side });\n  }\n  s.sum += s.hoops / 60;\n  e.seat.score = (1000 * s.sum) / bestHoopSeconds(dataOf(ev).length);\n  e.seat.pose = 'hoop';\n  const turn = ((s.angle / (Math.PI * 2)) % 1 + 1) % 1;\n  bodyPose(w, e, 'RETREAT/HipCircle', turn, false, 0);\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  const d = dataOf(ev);\n  for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') seatStep(w, ev, e);\n  // the first seat's hoops, drawn round its hips\n  const [first] = playing(w, ev);\n  const s = ev.s[first.seat.index];\n  const actor = (w.get(first.seat.actor) as unknown as { actor: { x: number; y: number; z: number } }).actor;\n  d.props.forEach((id, k) => {\n    const up = k < s.hoops;\n    const wobble = Math.sin(w.tick * 0.2 + k) * 0.03 * Math.max(0, 1 - s.good);\n    const y = up ? actor.y + 0.35 + k * 0.1 + s.height * 0.12 + wobble : -30;\n    moveProp(w, id, [actor.x + Math.cos(s.angle + k) * 0.05, y, actor.z + Math.sin(s.angle + k) * 0.05], [Math.sin(s.spin * 0.004) * 0.1, 0, 0, 1]);\n  });\n  if (ev.t >= d.length) {\n    ev.score = rankScore((1000 * s.sum) / bestHoopSeconds(d.length));\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const s = ev.s[e.seat.index];\n  const omega = skill.name === 'sloppy' ? 6.4 : 7;\n  e.seat.bot.a = (e.seat.bot.a ?? 0) + omega / 60 + (skill.jitter ? w.rng('bot').range(-0.02, 0.02) : 0);\n  const a = e.seat.bot.a;\n  if (s.window > 0 && skill.name === 'sloppy' && w.rng('bot').chance(0.4)) return { stick: [Math.cos(a) * 0.2, Math.sin(a) * 0.2] };\n  return { stick: [Math.cos(a), Math.sin(a)], raw: true };\n}\n\nfunction hoopActivity(id: string, short: boolean): Activity {\n  return {\n    id, title: 'Hoop Patrol', station: short ? 'pavilion' : 'hoopBeach', shot: short ? 'mat' : 'hoop', map: 'balance', song: 'song:hoop', multi: short,\n    setup(w, ev) {\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.off = true; }\n      ev.seats.forEach((i) => (ev.s[i] = { angle: 0, spin: 0, hoops: 1, height: 0.8, warn: 0, window: 0, side: 1, sum: 0, good: 0, caught: 0, dropped: 0, lastFoot: -100, footRate: 0, lastLeft: 0 }));\n      const props: number[] = [];\n      for (let k = 0; k < MAX; k++) props.push(ownProp(w, ev, 'prop:hoop', [0, -30, 0]));\n      Object.assign(ev.d, { length: short ? SHORT_LENGTH : LENGTH, props });\n      if (short) {\n        arrangeClass(w, ev);\n        return phase(ev, 'lead');\n      }\n      const c = stationAt(w, 'hoopBeach');\n      const [e] = playing(w, ev);\n      void groundAt;\n      standAt(w, e.seat.actor, c.x, c.z, Math.PI);\n      say(w, 'hoop.intro', 'tare');\n      phase(ev, 'go');\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const HOOP = hoopActivity('hoop', false);\nexport const HOOP_SHORT = hoopActivity('hoopS', true);\nvoid clamp;\nE\n","description":"Write reps, step class and hoop activities"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25291,"cache_read_input_tokens":206944,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25291},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"47dbf515-1da6-450f-acc5-42ccb5e6095a","timestamp":"2026-11-05T09:55:43.607Z","request_id":"req_011CgjaWuBCLBcHLzVp8voZZ","wire_tool_inputs":{"toolu_01LFpKLmJFfgYMCA77TBL7UX":{"command":"python3 - <<'E'\nimport re\np='labs/game/scenes/events/kit.ts';s=open(p).read()\ns=s.replace(\"return [sx * cz, sx * sz * -1 * 0 + 0, cx * sz, cx * cz];\",\"return [sx * cz, -sx * sz, cx * sz, cx * cz];\")\nopen(p,'w').write(s)\nE\ncat > labs/game/scenes/events/reps.ts <<'E'\n/**\n * @file Reps Hall (PLAN.md section 6): the signature \"your thumb is the exercise\". A band moves up and down a gauge at the\n * tempo; your marker is your stick's depth, and it scrubs the body. Stay near the band and the rep is banked. Gerald, beside\n * you, does two for each of yours. Near the end the counter cheats: \"9 of 10\" becomes \"10 of 11\".\n */\nimport { setLoop, setPose } from '../../cast/body';\nimport type { Order } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { rankScore } from './mats';\nimport { balanceAll, bodyPose, clamp, ownProp, phase, playing, standAt, stationAt, groundAt, type Activity } from './kit';\n\n/** Three exercises. `clip` scrubs; `axis` reads the stick; `count` is the reps. */\nexport const EXERCISES = [\n  { id: 'knees', clip: 'RETREAT/DeepKnee', axis: 'y', sign: -1, count: 10, hold: false },\n  { id: 'pushups', clip: 'RETREATLIB/Pushup', axis: 'y', sign: -1, count: 8, hold: true },\n  { id: 'lunges', clip: 'RETREAT/SideLunge', axis: 'x', sign: 0, count: 10, hold: false },\n] as const;\n\nconst DEPTH = 0.62;\nconst WINDOW = 0.2;\nconst INTRO = 150;\n\ninterface RepsData { ex: number; rep: number; phaseT: number; band: number; marker: number; fake: number; sum: number; reps: number; inside: number; steps: number; total: number; banked: number }\n\nconst dataOf = (ev: EvState): RepsData => ev.d as unknown as RepsData;\n\n/** Steps a rep takes now: the band quickens near the end of each exercise. */\nfunction repSteps(w: W, d: RepsData): number {\n  const ex = EXERCISES[d.ex];\n  const late = d.rep >= ex.count - 3 ? 0.85 : 1;\n  return Math.round(gameNumber(w, 'game.reps.tempo') * 60 * late);\n}\n\n/** The band at `k` of a rep: out and back. */\nexport const bandAt = (k: number): number => (k < 0.5 ? k * 2 : 2 - k * 2);\n\n/** Which way a rep goes, on the stick. */\nfunction signOf(d: RepsData): number {\n  const ex = EXERCISES[d.ex];\n  return ex.axis === 'x' ? (d.rep % 2 === 0 ? 1 : -1) : ex.sign;\n}\n\nfunction step(w: W, ev: EvState): void {\n  const d = dataOf(ev);\n  const [e] = playing(w, ev);\n  const { gerald } = castOf(w);\n  balanceAll(w, ev);\n  if (ev.phase === 'intro') {\n    bodyPose(w, e, EXERCISES[d.ex].clip, 0, false, 0.4);\n    if (ev.t === 0) say(w, `reps.${EXERCISES[d.ex].id}`, 'plumb');\n    if (ev.t >= INTRO) {\n      d.phaseT = 0;\n      phase(ev, 'rep');\n    }\n    return;\n  }\n  const ex = EXERCISES[d.ex];\n  const steps = repSteps(w, d);\n  const k = d.phaseT / steps;\n  d.band = bandAt(k);\n  const sign = signOf(d);\n  const value = ex.axis === 'x' ? e.wobble.x : e.wobble.y;\n  d.marker = clamp((value * sign) / DEPTH, 0, 1.2);\n  e.wobble.sway = 1 + (d.total / 28) * 0.6;\n  const heldOk = !ex.hold || (e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5);\n  const off = ex.axis === 'x' ? e.wobble.y : e.wobble.x;\n  d.steps += 1;\n  if (Math.abs(d.marker - d.band) <= WINDOW && heldOk && Math.abs(off) < 0.45) d.inside += 1;\n  const clipT = ex.clip === 'RETREATLIB/Pushup' ? 0.77 * (1 - clamp(d.marker, 0, 1)) + 0.0 : clamp(d.marker, 0, 1);\n  bodyPose(w, e, ex.clip, clipT, ex.axis === 'x' && sign < 0, 0.3);\n  if (gerald >= 0) setLoop(w, gerald, ex.axis === 'y' && ex.id === 'pushups' ? 'RETREATLIB/Pushup' : 'RETREATLIB/Jumping_Jacks_Loop', 2);\n  d.phaseT += 1;\n  if (d.phaseT >= steps) {\n    d.phaseT = 0;\n    const accuracy = d.inside / Math.max(1, d.steps);\n    d.sum += accuracy;\n    d.reps += 1;\n    d.rep += 1;\n    d.total += 1;\n    [d.inside, d.steps] = [0, 0];\n    if (accuracy >= 0.5) d.banked += 1;\n    cue(w, accuracy >= 0.5 ? 'repGood' : 'repMiss');\n    w.emit('rep', { n: d.rep, of: ex.count, ok: accuracy >= 0.5 } as never);\n    if (d.rep === ex.count - 1) {\n      d.fake = 1;\n      say(w, 'reps.cheat', 'plumb');\n    }\n    if (d.rep >= ex.count) {\n      d.ex += 1;\n      d.rep = 0;\n      d.fake = 0;\n      if (d.ex >= EXERCISES.length) {\n        ev.score = rankScore((1000 * d.sum) / Math.max(1, d.reps));\n        ev.done = true;\n        return;\n      }\n      cue(w, 'bell');\n      phase(ev, 'intro');\n    }\n  }\n}\n\nfunction bot(w: W, ev: EvState, _e: SeatE): Order {\n  const d = dataOf(ev);\n  if (ev.phase !== 'rep') return { aim: [0, 0] };\n  const ex = EXERCISES[d.ex];\n  const lead = 24;\n  const k = (d.phaseT + lead) / repSteps(w, d);\n  const want = bandAt(k > 1 ? k - 1 : k) * DEPTH * signOf(d);\n  const feet = ex.hold ? 1 : 0;\n  return { aim: ex.axis === 'x' ? [want, 0] : [0, want], l: feet, r: feet };\n}\n\nexport const REPS: Activity = {\n  id: 'reps', title: 'Reps Hall', station: 'annex', shot: 'reps', map: 'balance', song: 'song:lobby',\n  setup(w, ev) {\n    const c = stationAt(w, 'annex');\n    const [e] = playing(w, ev);\n    const { gerald } = castOf(w);\n    ownProp(w, ev, 'prop:matSeat0', [c.x - 3, groundAt(w, c.x - 3, c.z) + 0.01, c.z - 3]);\n    standAt(w, e.seat.actor, c.x - 3, c.z - 3, Math.PI);\n    if (gerald >= 0) standAt(w, gerald, c.x + 1, c.z - 3, Math.PI);\n    resetWobble(e.wobble);\n    Object.assign(ev.d, { ex: 0, rep: 0, phaseT: 0, band: 0, marker: 0, fake: 0, sum: 0, reps: 0, inside: 0, steps: 0, total: 0, banked: 0 });\n    ev.s[e.seat.index] = {};\n    phase(ev, 'intro');\n  },\n  step, bot,\n  teardown(w) {\n    const { gerald } = castOf(w);\n    if (gerald >= 0) setPose(w, gerald, 'RETREAT/Stand', 0);\n  },\n}; // prettier-ignore\nE\ncat > labs/game/scenes/data/charts.ts <<'E'\n/**\n * @file Step Class's charts as strings, one token an eighth note: L and R are feet, B both (a jump), a and d side steps\n * (lean plus foot), `.` a rest, `|` nothing but reading help. Adding a chart is adding a row.\n */\nexport interface Phrase { readonly bpm: number; readonly chart: string }\n\nexport const PHRASES: readonly Phrase[] = [\n  { bpm: 104, chart: 'L . R . L . R . | L . R . L . R . | L L R . B . . . | L . R . L . R . | L L R . B . . . | R R L . B . . . | a . . . d . . . | L . R . B . . . | L . R . L . R . | L L R . B . . . | a . d . a . d . | B . . . B . . .' },\n  { bpm: 112, chart: 'L . R . a . d . | L R L . R L R . | B . . . L . R . | a . L . d . R . | L R L . B . . . | R L R . B . . . | a . d . L . R . | L L R R B . . . | L R L R L . R . | a . d . a . d . | B . L . B . R . | L R L R B . . . | a . L . d . R . | B . . . B . . .' },\n  { bpm: 120, chart: 'L R L R L . R . | B . a . B . d . | L R L . R L R . | a L d R a L d R | B . B . L R L . | R L R . B . . . | L L R R L L R R | a . d . B . . . | L R L R B . L R | L R B . a . d . | L R L . R L R . | a L d R B . . . | L R L R L R L R | B . . . B . . . | a . d . a . d . | B . B . B . . .' },\n];\n\n/** The short form deals one phrase at this tempo. */\nexport const SHORT_PHRASE: Phrase = {\n  bpm: 112,\n  chart: 'L . R . L . R . | L R L . B . . . | R L R . B . . . | a . . . d . . . | L . R . a . d . | L R L . B . . . | L L R . B . . . | a . d . L . R . | L R L R B . . . | a L d R B . . . | L . R . L . R . | B . . . B . . .',\n};\nE\ncat > labs/game/scenes/events/step.ts <<'E'\n/**\n * @file Step Class (PLAN.md section 6): rhythm on a step platform. Charts become notes timed in whole sim steps, never\n * audio time; the sim's `beat` events fire the claps and kicks on the effects bus, because the music is only a bed. The\n * guests behind you follow your combo: lose it and they fall out of time, one by one, politely.\n */\nimport { setLoop, setPose } from '../../cast/body';\nimport type { Order, Skill } from '../bot/players';\nimport { PHRASES, SHORT_PHRASE, type Phrase } from '../data/charts';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { castOf } from '../cast-ref';\nimport { arrangeClass, rankScore } from './mats';\nimport { balanceAll, bodyPose, footDown, groundAt, leadIn, ownProp, phase, playing, standAt, stationAt, clamp, type Activity } from './kit';\n\n/** One note: when, in steps from the start, and what. */\nexport interface Note { t: number; k: string }\n\n/** A BPM as an eighth note in steps. */\nconst eighth = (bpm: number): number => (60 / bpm / 2) * 60;\n\n/** The notes and the beats of phrases, scaled by `game.step.bpm`. */\nexport function buildChart(phrases: readonly Phrase[], scale: number): { notes: Note[]; beats: number[]; end: number; phraseAt: number[] } {\n  const notes: Note[] = [];\n  const beats: number[] = [];\n  const phraseAt: number[] = [];\n  let at = 120;\n  for (const phrase of phrases) {\n    const each = eighth(phrase.bpm * scale);\n    phraseAt.push(Math.round(at));\n    const tokens = phrase.chart.split(/\\s+/).filter((token) => token !== '|');\n    tokens.forEach((token, i) => {\n      const t = Math.round(at + i * each);\n      if (i % 2 === 0) beats.push(t);\n      if (token !== '.') notes.push({ t, k: token });\n    });\n    at += tokens.length * each + 60;\n  }\n  return { notes, beats, end: Math.round(at + 60), phraseAt };\n}\n\ninterface StepData { notes: Note[]; beats: number[]; beatAt: number; end: number; outOfTime: number }\nconst dataOf = (ev: EvState): StepData => ev.d as unknown as StepData;\n\n/** The foot a note wants. */\nconst wantFoot = (k: string): 'l' | 'r' | 'b' => (k === 'L' || k === 'a' ? 'l' : k === 'R' || k === 'd' ? 'r' : 'b');\n\n/** Judges a seat's feet against its next notes. */\nfunction judge(w: W, ev: EvState, e: SeatE): void {\n  const d = dataOf(ev);\n  const s = ev.s[e.seat.index];\n  const perfect = gameNumber(w, 'game.step.perfect');\n  const good = gameNumber(w, 'game.step.good');\n  while (s.at < d.notes.length && ev.t > d.notes[s.at].t + good) {\n    s.at += 1;\n    s.miss += 1;\n    s.combo = 0;\n    if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: 'miss', seat: e.seat.index } as never);\n  }\n  const left = footDown(e, 'l');\n  const right = footDown(e, 'r');\n  if (!left && !right) return;\n  const note = d.notes[s.at];\n  if (!note) return;\n  const gap = Math.abs(ev.t - note.t);\n  if (gap > good) return;\n  const want = wantFoot(note.k);\n  const both = e.seat.input.l >= 0.5 && e.seat.input.r >= 0.5;\n  const footOk = want === 'b' ? both : want === 'l' ? left : right;\n  if (!footOk) {\n    if (want !== 'b') {\n      s.combo = 0;\n      s.at += 1;\n      s.miss += 1;\n      if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: 'miss', seat: e.seat.index } as never);\n    }\n    return;\n  }\n  const leanOk = note.k === 'a' ? e.wobble.x < -0.15 : note.k === 'd' ? e.wobble.x > 0.15 : true;\n  const grade = gap <= perfect && leanOk ? 1 : 0.6;\n  s.combo += 1;\n  const mult = 1 + Math.min(0.5, s.combo * 0.025);\n  s.points += grade * mult;\n  s.at += 1;\n  s.hit += 1;\n  s.pose = want === 'b' ? 3 : want === 'l' ? 1 : 2;\n  s.poseT = 16;\n  if (e.seat.index === ev.seats[0]) w.emit('stepJudge', { grade: grade === 1 ? 'perfect' : 'good', seat: e.seat.index, foot: want } as never);\n}\n\n/** The most points a chart could give, at a full combo. */\nfunction maxPoints(count: number): number {\n  let sum = 0;\n  for (let c = 1; c <= count; c++) sum += 1 + Math.min(0.5, c * 0.025);\n  return sum;\n}\n\nfunction body(w: W, e: SeatE, s: Record<string, number>): void {\n  s.poseT = Math.max(0, s.poseT - 1);\n  const k = clamp(s.poseT / 16, 0, 1);\n  if (s.pose === 3) bodyPose(w, e, 'RETREAT/Jump', k, false, 0.5);\n  else bodyPose(w, e, s.pose === 1 ? 'RETREAT/StepUpL' : 'RETREAT/StepUpR', k, false, 0.5);\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  const d = dataOf(ev);\n  while (d.beatAt < d.beats.length && d.beats[d.beatAt] <= ev.t) {\n    w.emit('beat', { n: d.beatAt } as never);\n    d.beatAt += 1;\n  }\n  balanceAll(w, ev);\n  for (const e of playing(w, ev)) {\n    if (e.seat.kind === 'ghost') continue;\n    judge(w, ev, e);\n    body(w, e, ev.s[e.seat.index]);\n    e.seat.score = (1000 * ev.s[e.seat.index].points) / maxPoints(d.notes.length);\n  }\n  const first = ev.s[ev.seats[0]];\n  const { extras } = castOf(w);\n  const wantOut = first.combo >= 8 ? 0 : first.combo >= 3 ? 1 : first.combo >= 1 ? 2 : 3;\n  d.outOfTime = wantOut;\n  if (!ev.short) {\n    extras.slice(0, 3).forEach((id, i) => setLoop(w, id, 'RETREATLIB/Dance_Loop', i < 3 - wantOut ? 2 : 0.6));\n  }\n  if (ev.t >= d.end) {\n    ev.score = rankScore((1000 * first.points) / maxPoints(d.notes.length));\n    say(w, ev.score > 750 ? 'step.endGood' : 'step.endFair', 'plumb');\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const d = dataOf(ev);\n  const s = ev.s[e.seat.index];\n  const note = d.notes[s.at];\n  if (!note) return { aim: [0, 0] };\n  if (s.jit === undefined || s.jitFor !== s.at) {\n    s.jit = skill.timing ? w.rng('bot').range(-skill.timing * 1.15, skill.timing * 1.15) : 0;\n    s.jitFor = s.at;\n  }\n  const when = note.t + s.jit;\n  const want = wantFoot(note.k);\n  const near = note.k === 'a' ? -0.5 : note.k === 'd' ? 0.5 : 0;\n  const down = ev.t >= when && ev.t < when + 6;\n  const order: Order = { aim: [note.t - ev.t < 30 ? near : 0, 0] };\n  if (down) {\n    if (want === 'l' || want === 'b') order.l = 1;\n    if (want === 'r' || want === 'b') order.r = 1;\n  }\n  return order;\n}\n\nfunction stepActivity(id: string, title: string, phrases: readonly Phrase[], short: boolean): Activity {\n  return {\n    id, title, station: short ? 'pavilion' : 'annex', shot: short ? 'mat' : 'step', map: 'balance', song: 'song:stepBed', multi: short,\n    setup(w, ev) {\n      Object.assign(ev.d, { ...buildChart(phrases, gameNumber(w, 'game.step.bpm')), beatAt: 0, outOfTime: 0 });\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.sway = 0.45; }\n      ev.seats.forEach((i) => (ev.s[i] = { at: 0, combo: 0, points: 0, hit: 0, miss: 0, pose: 1, poseT: 0 }));\n      if (short) {\n        arrangeClass(w, ev);\n        return phase(ev, 'lead');\n      }\n      const c = stationAt(w, 'annex');\n      const [e] = playing(w, ev);\n      const y = groundAt(w, c.x, c.z + 2);\n      ownProp(w, ev, 'prop:stepPlatform', [c.x, y, c.z + 2]);\n      for (let k = 0; k < 6; k++) ownProp(w, ev, 'prop:floorTile', [c.x - 3.75 + k * 1.5, y + 0.01, c.z + 4.4]);\n      standAt(w, e.seat.actor, c.x, c.z + 2, Math.PI);\n      const { extras, plumb } = castOf(w);\n      if (plumb >= 0) {\n        standAt(w, plumb, c.x, c.z - 3, 0);\n        setPose(w, plumb, 'RETREAT/Stand', 0);\n      }\n      extras.slice(0, 3).forEach((id, i) => standAt(w, id, c.x - 3 + i * 3, c.z + 6, Math.PI));\n      say(w, 'step.intro', 'plumb');\n      phase(ev, 'go');\n    },\n    step, bot,\n    teardown(w) {\n      if (!short) castOf(w).extras.slice(0, 3).forEach((id) => setPose(w, id, 'RETREAT/Stand', 0));\n    },\n  }; // prettier-ignore\n}\n\nexport const STEP = stepActivity('step', 'Step Class', PHRASES, false);\nexport const STEP_SHORT = stepActivity('stepS', 'Step Class', [SHORT_PHRASE], true);\nE\ncat > labs/game/scenes/events/hoop.ts <<'E'\n/**\n * @file Hoop Patrol (PLAN.md section 6). Spin your stick in circles: an angular speed in the band keeps every hoop up;\n * outside it they sink and fall. A new hoop comes every 8 s from a telegraphed side: lean that way in time to catch it.\n * The hip-circle strip scrubs with the stick's angle, so the hips follow your thumb, with increasing dignity. Keyboard:\n * alternate feet at 2.5 Hz or more counts as spinning.\n */\nimport { angDiff } from '../../../../engine/sim-api';\nimport type { Order, Skill } from '../bot/players';\nimport { gameNumber } from '../settings';\nimport { cue, say, type EvState, type SeatE, type W } from '../types';\nimport { resetWobble } from '../wobble';\nimport { arrangeClass, rankScore } from './mats';\nimport { bodyPose, clamp, footDown, groundAt, leadIn, moveProp, ownProp, phase, playing, standAt, stationAt, type Activity } from './kit';\n\nconst EVERY = 480;\nconst WARN = 90;\nconst CATCH = 36;\nconst MAX = 8;\nconst LENGTH = 3600;\nconst SHORT_LENGTH = 2700;\n\ninterface HoopData { length: number; props: number[] }\nconst dataOf = (ev: EvState): HoopData => ev.d as unknown as HoopData;\n\n/** The best hoop-seconds a run of `steps` could hold. */\nfunction bestHoopSeconds(steps: number): number {\n  let sum = 0;\n  for (let t = 0; t < steps; t++) sum += Math.min(MAX, 1 + Math.floor(t / EVERY));\n  return sum / 60;\n}\n\n/** Runs one seat. */\nfunction seatStep(w: W, ev: EvState, e: SeatE): void {\n  const s = ev.s[e.seat.index];\n  const { input } = e.seat;\n  const sx = input.x + e.wobble.mx;\n  const sy = input.y + e.wobble.my;\n  const mag = Math.hypot(sx, sy);\n  const dt = 1 / 60;\n  if (mag > 0.5) {\n    const angle = Math.atan2(sy, sx);\n    s.spin += (Math.abs(angDiff(s.angle, angle)) / dt - s.spin) * 0.05;\n    s.angle = angle;\n  } else s.spin *= 0.97;\n  if (footDown(e, 'l') || footDown(e, 'r')) {\n    const left = footDown(e, 'l');\n    if (left !== !!s.lastLeft) {\n      const gap = ev.t - s.lastFoot;\n      s.footRate = gap > 0 ? 60 / gap : 0;\n      s.lastFoot = ev.t;\n      s.lastLeft = left ? 1 : 0;\n    }\n  }\n  if (ev.t - s.lastFoot > 40) s.footRate = 0;\n  const min = gameNumber(w, 'game.hoop.bandMin');\n  const max = gameNumber(w, 'game.hoop.bandMax');\n  const feetSpin = s.footRate >= 2.5;\n  const inBand = (s.spin >= min && s.spin <= max) || feetSpin;\n  if (feetSpin) s.angle += 7 * dt;\n  s.good = inBand ? 1 : 0;\n  s.height += (inBand ? 0.6 : -0.35) * dt;\n  s.height = Math.min(1, s.height);\n  if (s.height <= 0) {\n    if (s.hoops > 0) {\n      s.hoops -= 1;\n      s.dropped += 1;\n      cue(w, 'hoopDrop');\n      if (s.hoops === 0 && e.seat.index === ev.seats[0]) say(w, 'hoop.drop', 'tare');\n    }\n    s.height = s.hoops > 0 ? 0.5 : 0;\n  }\n  // a new hoop, telegraphed\n  if (s.warn > 0) {\n    s.warn -= 1;\n    if (s.warn === 0) {\n      s.window = CATCH;\n      cue(w, 'hoopWhoosh');\n    }\n  } else if (s.window > 0) {\n    s.window -= 1;\n    const lean = s.side * sx;\n    if (lean > 0.5 || (feetSpin && (s.side < 0 ? input.l : input.r) >= 0.5)) {\n      s.hoops = Math.min(MAX, s.hoops + 1);\n      s.height = Math.max(s.height, 0.5);\n      s.window = 0;\n      s.caught += 1;\n      cue(w, 'hoopCatch', { n: s.hoops });\n    }\n  } else if (ev.t > 0 && ev.t % EVERY === EVERY - WARN) {\n    s.side = w.rng('hoop').chance(0.5) ? 1 : -1;\n    s.warn = WARN;\n    if (e.seat.index === ev.seats[0]) cue(w, 'hoopWarn', { side: s.side });\n  }\n  s.sum += s.hoops / 60;\n  e.seat.score = (1000 * s.sum) / bestHoopSeconds(dataOf(ev).length);\n  e.seat.pose = 'hoop';\n  const turn = ((s.angle / (Math.PI * 2)) % 1 + 1) % 1;\n  bodyPose(w, e, 'RETREAT/HipCircle', turn, false, 0);\n}\n\nfunction step(w: W, ev: EvState): void {\n  if (leadIn(w, ev)) return;\n  const d = dataOf(ev);\n  for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') seatStep(w, ev, e);\n  // the first seat's hoops, drawn round its hips\n  const [first] = playing(w, ev);\n  const s = ev.s[first.seat.index];\n  const actor = (w.get(first.seat.actor) as unknown as { actor: { x: number; y: number; z: number } }).actor;\n  d.props.forEach((id, k) => {\n    const up = k < s.hoops;\n    const wobble = Math.sin(w.tick * 0.2 + k) * 0.03 * Math.max(0, 1 - s.good);\n    const y = up ? actor.y + 0.35 + k * 0.1 + s.height * 0.12 + wobble : -30;\n    moveProp(w, id, [actor.x + Math.cos(s.angle + k) * 0.05, y, actor.z + Math.sin(s.angle + k) * 0.05], [Math.sin(s.spin * 0.004) * 0.1, 0, 0, 1]);\n  });\n  if (ev.t >= d.length) {\n    ev.score = rankScore((1000 * s.sum) / bestHoopSeconds(d.length));\n    ev.done = true;\n  }\n}\n\nfunction bot(w: W, ev: EvState, e: SeatE, skill: Skill): Order {\n  if (ev.phase === 'lead') return {};\n  const s = ev.s[e.seat.index];\n  const omega = skill.name === 'sloppy' ? 6.4 : 7;\n  e.seat.bot.a = (e.seat.bot.a ?? 0) + omega / 60 + (skill.jitter ? w.rng('bot').range(-0.02, 0.02) : 0);\n  const a = e.seat.bot.a;\n  if (s.window > 0 && skill.name === 'sloppy' && w.rng('bot').chance(0.4)) return { stick: [Math.cos(a) * 0.2, Math.sin(a) * 0.2] };\n  return { stick: [Math.cos(a), Math.sin(a)], raw: true };\n}\n\nfunction hoopActivity(id: string, short: boolean): Activity {\n  return {\n    id, title: 'Hoop Patrol', station: short ? 'pavilion' : 'hoopBeach', shot: short ? 'mat' : 'hoop', map: 'balance', song: 'song:hoop', multi: short,\n    setup(w, ev) {\n      for (const e of playing(w, ev)) if (e.seat.kind !== 'ghost') { resetWobble(e.wobble); e.wobble.off = true; }\n      ev.seats.forEach((i) => (ev.s[i] = { angle: 0, spin: 0, hoops: 1, height: 0.8, warn: 0, window: 0, side: 1, sum: 0, good: 0, caught: 0, dropped: 0, lastFoot: -100, footRate: 0, lastLeft: 0 }));\n      const props: number[] = [];\n      for (let k = 0; k < MAX; k++) props.push(ownProp(w, ev, 'prop:hoop', [0, -30, 0]));\n      Object.assign(ev.d, { length: short ? SHORT_LENGTH : LENGTH, props });\n      if (short) {\n        arrangeClass(w, ev);\n        return phase(ev, 'lead');\n      }\n      const c = stationAt(w, 'hoopBeach');\n      const [e] = playing(w, ev);\n      void groundAt;\n      standAt(w, e.seat.actor, c.x, c.z, Math.PI);\n      say(w, 'hoop.intro', 'tare');\n      phase(ev, 'go');\n    },\n    step, bot,\n  }; // prettier-ignore\n}\n\nexport const HOOP = hoopActivity('hoop', false);\nexport const HOOP_SHORT = hoopActivity('hoopS', true);\nvoid clamp;\nE\n","description":"Write reps, step class and hoop activities"}}}
