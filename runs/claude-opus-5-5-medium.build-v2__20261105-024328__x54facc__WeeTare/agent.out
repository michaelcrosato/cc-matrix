'#fff4e0', intensity: 2.1,\").replace(\"ambient: { sky: '#d8e6ff', ground: '#c8c0a8', intensity: 1.9 }\",\"ambient: { sky: '#d8e6ff', ground: '#c8c0a8', intensity: 1.3 }\")\ns=s.replace(\"const fog = { color: '#bfe9ff',\",\"const fog = { color: '#a8def8',\")\ns=s.replace(\"bloom: { scope: 'all', strength: 0.35, threshold: 0.92 },\",\"bloom: { scope: 'all', strength: 0.25, threshold: 0.98 },\").replace(\"grade: { scope: 'all', brightness: 1.08, saturation: 0.92, lift: 0.03 },\",\"grade: { scope: 'all', brightness: 1.02, saturation: 0.95, lift: 0.02 },\")\nopen(p,'w').write(s)\np='labs/game/props/index.ts';s=open(p).read()\ns=s.replace(\"{ p: { width: 1400, height: 0.02, depth: 1400 }, m: 'material:retreatSea' }\",\"{ p: { width: 9000, height: 0.02, depth: 9000 }, m: 'material:retreatSea' }\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/pond.ts';s=open(p).read()\ns=s.replace(\"\"\"        const y = groundAt(w, c.x, c.z);\n        ownProp(w, ev, 'prop:jetty', [c.x, y + 0.5, c.z - 2]);\n        standAt(w, e.seat.actor, c.x, c.z, Math.PI);\"\"\",\"\"\"        const y = groundAt(w, c.x, c.z) + 1.4;\n        Object.assign(ev.d, { perch: [c.x, y + 0.14, c.z + 2] });\n        ownProp(w, ev, 'prop:jetty', [c.x, y, c.z + 4]);\n        hover(w, e.seat.actor, c.x, y + 0.14, c.z + 2, Math.PI);\"\"\")\ns=s.replace(\"\"\"    bodyPose(w, e, 'RETREAT/Nothing', 1, false, 0);\n    e.seat.score\"\"\",\"\"\"    bodyPose(w, e, 'RETREAT/Nothing', 1, false, 0);\n    if (d.perch) hover(w, e.seat.actor, d.perch[0], d.perch[1], d.perch[2], Math.PI);\n    e.seat.score\"\"\")\ns=s.replace(\"gullOn: boolean; length: number }\",\"gullOn: boolean; length: number; perch?: number[] }\")\ns=s.replace(\"groundAt, leadIn,\",\"groundAt, hover, leadIn,\")\nopen(p,'w').write(s)\np='labs/game/ui/titles.ts';s=open(p).read()\ns=s.replace(\"[['lean', 'Your thumb is the exercise'], ['both', 'Palms']]\",\"[['lean', 'Follow the band'], ['both', 'Palms']]\")\nopen(p,'w').write(s)\np='labs/game/ui/shots.ts';s