{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01La3ruyLQJNsEZbWgg48Ua6","type":"tool_result","content":"1-/**\n2- * @file Actors (PLAN.md WP 3.2; WP 3.7 adds the animator): entities that walk, jump and dash through the character\n3: * controller (engine/physics/character.ts). `spawnActor(w, { at, character, player })` adds a capsule body to the\n4- * scene's physics world and spawns an entity with the component `actor` (its body, settings, intents, feet and the\n5- * controller's state), so the sim hashes, captures and restores all of it.\n6- *\n7- * The step (shardfall's order): movers set their velocities (`intents`, `ai`), the system `actors` moves every actor in\n8- * id order (`anim`), the world steps (`physics`), and `actors.readback` copies the feet into `x`, `y`, `z`\n9- * (`readback`). A player actor reads the step's intents: `move`, `jump` (held, pressed) and `dash` (pressed); any other\n10- * the intents its AI writes into `actor.intents`, its presses from the edges of `b`. Events: `jump` `{ id, at }`,\nengine/sim/actors.ts\n195:export interface ActorSpec {\n196-  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n197-  at: Vec3Like;\n198-  /** Its settings (createCharacter). */\n199-  character: Character;\n200-  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n201-  player?: boolean;\n202-  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n203-  yaw?: number;\n204-  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n205-  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n206-  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n207-  body?: string;\n208-  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n209-  clips?: ClipsSpec;\n210-  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n211-  holstered?: boolean;\n212-  /**\n213-   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n214-   * are there from its first step, and a page's first warm-up builds what they draw.\n215-   */\n216-  components?: Readonly<Record<string, object>>;\n217-}\n218-\n219-/**\n220- * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n221- * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n222- * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n223- * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n224- * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n225- * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n226- * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n227- */\n228-export function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n229-  const w = world as unknown as World;\n230-  const physics = physicsOf(w);\n231-  const body = addCharacter(physics, spec.character, spec.at);\n232-  const { x, y, z } = feetOf(physics, body, spec.character);\n233-  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n234-  if (!w.systems.has('actors')) {\n235-    w.systems.add('actors', moveActors, { phase: 'anim' });\n236-    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n237-  }\n238-  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n239-  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n240-  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n241-  if (!w.systems.has('actors.anim')) {\n242-    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n243-    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n244-  }\n245-  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n246-  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n247-  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n248-  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n249-  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n250-}\n251-\n252-/**\n253- * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n254- * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n255- * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\nengine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\nengine/sim/props.ts-153-  world: World<C, E>,\nengine/sim/props.ts-154-  placement: PropPlacement,\nengine/sim/props.ts-155-  options: SpawnPropOptions = {},\nengine/sim/props.ts-156-): number {\nengine/sim/props.ts-157-  const w = world as unknown as World;\nengine/sim/props.ts-158-  const entry = getProp(placement.prop);\nengine/sim/props.ts-159-  const prop = entry.id;\nengine/sim/props.ts-160-  const spec = propBody({ ...placement, prop }, undefined, options.as);\nengine/sim/props.ts-161-  const { position, rotation } = spec ?? propPose({ ...placement, prop });\nengine/sim/props.ts-162-  const body = spec ? physicsOf(w).addBody(spec) : -1;\nengine/sim/props.ts-163-  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\nengine/sim/props.ts-164-  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\nengine/sim/props.ts-165-  const [x, y, z] = position;\nengine/sim/props.ts-166-  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\nengine/sim/props.ts-167-  const switchable = options.on !== undefined || options.group !== undefined;\nengine/sim/props.ts-168-  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\nengine/sim/props.ts-169-  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\nengine/sim/props.ts-170-}\nengine/sim/props.ts-171-\nengine/sim/props.ts-172-/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\nengine/sim/props.ts-173-export function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\nengine/sim/props.ts-174-  if (body < 0) return -1;\nengine/sim/props.ts-175-  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\nengine/sim/props.ts-176-  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\nengine/sim/props.ts-177-}\nengine/app/engine.ts:106:export interface EngineOptions {\nengine/app/engine.ts-107-  /** The canvas it draws into; the page sizes it with CSS. */\nengine/app/engine.ts-108-  canvas: HTMLCanvasElement;\nengine/app/engine.ts-109-  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\nengine/app/engine.ts-110-  scenes: readonly string[];\nengine/app/engine.ts-111-  /**\nengine/app/engine.ts-112-   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\nengine/app/engine.ts-113-   * entry's `materials`); registered unless already.\nengine/app/engine.ts-114-   */\nengine/app/engine.ts-115-  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\nengine/app/engine.ts-116-  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\nengine/app/engine.ts-117-  replays?: Readonly<Record<string, () => Promise<string>>>;\nengine/app/engine.ts-118-  /** The query to read (`location.search`). */\nengine/app/engine.ts-119-  search?: string;\nengine/app/engine.ts-120-  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\nengine/app/engine.ts-121-  hash?: string;\nengine/app/engine.ts-122-  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\nengine/app/engine.ts-123-  registry?: Registry;\nengine/app/engine.ts-124-  /** Where errors and advice go (the shared log). */\nengine/app/engine.ts-125-  log?: Log;\nengine/app/engine.ts-126-  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\nengine/app/engine.ts-127-  touchLayout?: string;\nengine/app/engine.ts-128-  /**\nengine/app/engine.ts-129-   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\nengine/app/engine.ts-130-   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\nengine/app/engine.ts-131-   */\nengine/app/engine.ts-132-  actionMap?: string | ((camera: string) => string);\nengine/app/engine.ts-133-  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\nengine/app/engine.ts-134-  onView?: (action: string) => void;\nengine/app/engine.ts-135-  /** Opens the page's menu, called after the touch menu button has paused the game. */\nengine/app/engine.ts-136-  onMenu?: () => void;\nengine/app/engine.ts-137-  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\nengine/app/engine.ts-138-  onFrame?: (frame: EngineFrame) => void;\nengine/app/engine.ts-139-  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\nengine/app/engine.ts-140-  store?: Store;\nengine/app/engine.ts-141-  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\nengine/app/engine.ts-142-  modal?: () => boolean;\nengine/app/engine.ts-143-  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\nengine/app/engine.ts-144-  cameraInput?: () => CameraInput | undefined;\nengine/app/engine.ts-145-}\nengine/app/engine.ts-146-\nengine/app/engine.ts-147-/** A started engine. */\nengine/app/engine.ts-148-export interface Engine {\nengine/app/engine.ts-149-  /** The inspector, also `window.__engine`; null when the scene could not start. */\nengine/app/engine.ts-150-  readonly inspector: Inspector | null;\nengine/app/engine.ts-151-  /** True once the first frame is drawn; never after a startup error. */\nengine/app/engine.ts-152-  readonly ready: boolean;\nengine/app/engine.ts-153-  /** What the query asked for; null when it could not be read. */\nengine/app/engine.ts-154-  readonly routes: Routes | null;\nengine/app/engine.ts-155-  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\nengine/app/engine.ts-156-  readonly ui: Overlay | null;\nengine/app/engine.ts-157-  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\nengine/app/engine.ts-158-  readonly input: Input | null;\nengine/app/engine.ts-159-  /** Stops the frame loop. */\nengine/app/engine.ts-160-  stop(): void;\nengine/app/engine.ts-161-}\nengine/app/engine.ts-162-\nengine/app/engine.ts-163-/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\nengine/app/engine.ts-164-interface Asked {\nengine/app/engine.ts-165-  playback?: Playback;\nengine/app/engine.ts-166-  error?: unknown;\nengine/app/engine.ts-167-}\nengine/app/engine.ts-168-\nengine/app/engine.ts-169-/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\nengine/app/engine.ts-170-async function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\nengine/app/engine.ts-171-  const load = replays?.[name];\nengine/app/engine.ts-172-  if (!load) {\nengine/app/engine.ts-173-    const names = Object.keys(replays ?? {}).sort();\nengine/app/engine.ts-174-    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\nengine/app/engine.ts-175-  }\nengine/app/engine.ts-176-  try {\nengine/physics/crowd.ts:186:export function addAgent(physics: Physics, agent: CrowdAgent): number {\nengine/physics/crowd.ts-187-  check(\nengine/physics/crowd.ts-188-    isPlainObject(agent) && agent.state === 'queued',\nengine/physics/crowd.ts-189-    'addAgent(agent)',\nengine/physics/crowd.ts-190-    agent?.state,\nengine/physics/crowd.ts-191-    \"an agent in the state 'queued'\",\nengine/physics/crowd.ts-192-  );\nengine/physics/crowd.ts-193-  const { shape, radius, height, density } = agent;\nengine/physics/crowd.ts-194-  check(shape === 'capsule' || shape === 'ball', 'addAgent({ shape })', shape, \"'capsule' or 'ball'\");\nengine/physics/crowd.ts-195-  check(Number.isFinite(radius) && radius > 0, 'addAgent({ radius })', radius, 'a radius above 0');\n/**\n * @file Crowd bodies, sim-side (PLAN.md WP 5.7 core proposal, ADR-0008 amendment 6; §6.4; ADR-0009): what a member of\n * a crowd looks like, and its rig's step. An entity with the component `crowdBody` (`CROWD_BODY_FIELDS`) names its rig\n * (a humanoid in a build, a blob, a floater, a quadruped), where it stands and the rig's state as plain data; the\n * stage draws it\n * through a crowd (engine/gfx/stageCrowd.ts: instanced batches, each body posed at its band's detail), instead of a\n * stand-in.\n *\n * `stepCrowdBody(w, id, body, input)` is the rig's sim step (ADR-0009's `anim.step`: every tick, part of the hash),\n * for a system in the phase `anim`: it loads the rig from `body.state`, steps it with `input` and saves it back, and\n * moves the body to `input.at`. A humanoid's is its animator's (engine/anim/character.ts: the body states, its\n * breathing phase drawn from `rng.entity(id, 'anim')` at its first step, as an actor's); a blob's and a floater's are\n * theirs (engine/anim/blob.ts, floater.ts), the floater's clock spread from the same stream; a quadruped's is its own\n * (engine/anim/quadruped.ts, WP 13.21: its clock spread so, its feet on the world's ground where the world has\n * physics, a raycast through the group `world`, `crowdGround`). The first step fills an\n * empty `state` (a spawned body's default) with the rig at rest, turned to `body.yaw`. The rigs are pooled per world\n * and loaded at every step, so they keep no state of their own: a restore continues exactly.\n *\n * - `rig`: `humanoid` (its `look` is a build id, `build:chibi` when empty), `blob` (its `look` names its features:\n *   `horns`, `ears` or `wings`, none when empty; `size` its radius at rest, `BLOB.radius` when 0), `floater` or\n *   `quadruped` (told `input.quadruped`: to sit, what to look at and how hard to wag).\n * - `x`, `y`, `z` (m): a humanoid's, a blob's or a quadruped's feet, a floater's core; `yaw` (rad): where it faces\n *   (a humanoid's from `input.yaw`, a blob's look, a floater's and a quadruped's heading from their rigs).\n *\n * Invariants: everything a crowd body is in the sim is its component; the step writes only the component; footsteps\n * are not emitted (a crowd's would flood the events). The view poses rigs it loads from the component and never\n * writes it, so drawing, LOD and culling never change the hash.\n *\n * @example\n * import { createWorld } from './world';\n * const w = createWorld({ seed: 1 });\n * const id = w.spawn({ crowdBody: { rig: 'blob', x: 2, z: 3 } });\n * const body = w.get(id)!.crowdBody as CrowdBody;\n * w.run((w) => stepCrowdBody(w, id, body, { at: [2, 0, 3.05], velocity: [0, 0, 3] })); // a slime hopping south\n * [body.z, body.yaw]; // [3.05, 0]: moved, looking south\n * (body.state as { squash: number }).squash; // 0: the blob's state, at rest\n * @see engine/sim/crowdBodies.test.ts\n */\nimport { AnimatorPool, ANIMATOR_FIELDS, type AnimatorData } from '../anim/character';\nimport { Blob, type BlobInput, type BlobState } from '../anim/blob';\nimport { Floater, type FloaterState } from '../anim/floater';\nimport type { GaitProbe } from '../anim/proc/gait';\nimport { Quadruped, type QuadrupedState } from '../anim/quadruped';\nimport { STEP } from '../anim/humanoidRates';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { copyValue, defineSchema } from '../core/schema';\nimport { hasPhysics, physicsOf } from '../physics/binding';\nimport type { Vec3Like } from '../physics/queries';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The rigs a crowd body can have. */\nexport type CrowdRig = 'humanoid' | 'blob' | 'floater' | 'quadruped';\n\n/** A crowd body's fields, for the component `crowdBody`: its rig and look, where it stands, its rig's state. */\nexport const CROWD_BODY_FIELDS = defineSchema({\n  rig: {\n    type: 'string',\n    enum: ['humanoid', 'blob', 'floater', 'quadruped'],\n    default: 'humanoid',\n    description: 'Its rig: a humanoid (an animator), a blob, a floater or a quadruped.',\n  },\n  look: {\n    type: 'string',\n    default: '',\n    description:\n      'What it wears: a humanoid’s build id (build:chibi when empty), a blob’s features (horns, ears or wings; none when empty); a floater and a quadruped have none.',\n  },","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"ceb19777-641c-475a-986e-8192ee46a8aa","timestamp":"2026-11-05T09:44:35.605Z","tool_use_result":{"stdout":"1-/**\n2- * @file Actors (PLAN.md WP 3.2; WP 3.7 adds the animator): entities that walk, jump and dash through the character\n3: * controller (engine/physics/character.ts). `spawnActor(w, { at, character, player })` adds a capsule body to the\n4- * scene's physics world and spawns an entity with the component `actor` (its body, settings, intents, feet and the\n5- * controller's state), so the sim hashes, captures and restores all of it.\n6- *\n7- * The step (shardfall's order): movers set their velocities (`intents`, `ai`), the system `actors` moves every actor in\n8- * id order (`anim`), the world steps (`physics`), and `actors.readback` copies the feet into `x`, `y`, `z`\n9- * (`readback`). A player actor reads the step's intents: `move`, `jump` (held, pressed) and `dash` (pressed); any other\n10- * the intents its AI writes into `actor.intents`, its presses from the edges of `b`. Events: `jump` `{ id, at }`,\nengine/sim/actors.ts\n195:export interface ActorSpec {\n196-  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n197-  at: Vec3Like;\n198-  /** Its settings (createCharacter). */\n199-  character: Character;\n200-  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n201-  player?: boolean;\n202-  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n203-  yaw?: number;\n204-  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n205-  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n206-  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n207-  body?: string;\n208-  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n209-  clips?: ClipsSpec;\n210-  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n211-  holstered?: boolean;\n212-  /**\n213-   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n214-   * are there from its first step, and a page's first warm-up builds what they draw.\n215-   */\n216-  components?: Readonly<Record<string, object>>;\n217-}\n218-\n219-/**\n220- * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n221- * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n222- * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n223- * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n224- * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n225- * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n226- * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n227- */\n228-export function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n229-  const w = world as unknown as World;\n230-  const physics = physicsOf(w);\n231-  const body = addCharacter(physics, spec.character, spec.at);\n232-  const { x, y, z } = feetOf(physics, body, spec.character);\n233-  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n234-  if (!w.systems.has('actors')) {\n235-    w.systems.add('actors', moveActors, { phase: 'anim' });\n236-    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n237-  }\n238-  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n239-  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n240-  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n241-  if (!w.systems.has('actors.anim')) {\n242-    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n243-    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n244-  }\n245-  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n246-  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n247-  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n248-  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n249-  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n250-}\n251-\n252-/**\n253- * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n254- * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n255- * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\nengine/sim/props.ts:152:export function spawnProp<C extends object, E extends EventMap>(\nengine/sim/props.ts-153-  world: World<C, E>,\nengine/sim/props.ts-154-  placement: PropPlacement,\nengine/sim/props.ts-155-  options: SpawnPropOptions = {},\nengine/sim/props.ts-156-): number {\nengine/sim/props.ts-157-  const w = world as unknown as World;\nengine/sim/props.ts-158-  const entry = getProp(placement.prop);\nengine/sim/props.ts-159-  const prop = entry.id;\nengine/sim/props.ts-160-  const spec = propBody({ ...placement, prop }, undefined, options.as);\nengine/sim/props.ts-161-  const { position, rotation } = spec ?? propPose({ ...placement, prop });\nengine/sim/props.ts-162-  const body = spec ? physicsOf(w).addBody(spec) : -1;\nengine/sim/props.ts-163-  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\nengine/sim/props.ts-164-  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\nengine/sim/props.ts-165-  const [x, y, z] = position;\nengine/sim/props.ts-166-  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\nengine/sim/props.ts-167-  const switchable = options.on !== undefined || options.group !== undefined;\nengine/sim/props.ts-168-  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\nengine/sim/props.ts-169-  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\nengine/sim/props.ts-170-}\nengine/sim/props.ts-171-\nengine/sim/props.ts-172-/** The entity whose prop `body` is (a `sceneProp`'s), or −1: the body-to-entity lookup uses and hits read (WP 13.16). */\nengine/sim/props.ts-173-export function propOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\nengine/sim/props.ts-174-  if (body < 0) return -1;\nengine/sim/props.ts-175-  const props = (world as unknown as World).query('sceneProp') as unknown as (ScenePropComponents & { id: number })[];\nengine/sim/props.ts-176-  return props.find((e) => e.sceneProp.body === body)?.id ?? -1;\nengine/sim/props.ts-177-}\nengine/app/engine.ts:106:export interface EngineOptions {\nengine/app/engine.ts-107-  /** The canvas it draws into; the page sizes it with CSS. */\nengine/app/engine.ts-108-  canvas: HTMLCanvasElement;\nengine/app/engine.ts-109-  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\nengine/app/engine.ts-110-  scenes: readonly string[];\nengine/app/engine.ts-111-  /**\nengine/app/engine.ts-112-   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\nengine/app/engine.ts-113-   * entry's `materials`); registered unless already.\nengine/app/engine.ts-114-   */\nengine/app/engine.ts-115-  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\nengine/app/engine.ts-116-  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\nengine/app/engine.ts-117-  replays?: Readonly<Record<string, () => Promise<string>>>;\nengine/app/engine.ts-118-  /** The query to read (`location.search`). */\nengine/app/engine.ts-119-  search?: string;\nengine/app/engine.ts-120-  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\nengine/app/engine.ts-121-  hash?: string;\nengine/app/engine.ts-122-  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\nengine/app/engine.ts-123-  registry?: Registry;\nengine/app/engine.ts-124-  /** Where errors and advice go (the shared log). */\nengine/app/engine.ts-125-  log?: Log;\nengine/app/engine.ts-126-  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\nengine/app/engine.ts-127-  touchLayout?: string;\nengine/app/engine.ts-128-  /**\nengine/app/engine.ts-129-   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\nengine/app/engine.ts-130-   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\nengine/app/engine.ts-131-   */\nengine/app/engine.ts-132-  actionMap?: string | ((camera: string) => string);\nengine/app/engine.ts-133-  /** A view action of the map pressed 