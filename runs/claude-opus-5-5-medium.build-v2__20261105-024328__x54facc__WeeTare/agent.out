{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjhHTTa8zxkXKvVbXjD1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016qGJYh7JcXNKvTjYBs78tZ","name":"Bash","input":{"command":"python3 - <<'E'\nimport re\ndef sub(p,a,b,count=1):\n    s=open(p).read()\n    assert a in s,(p,a[:50])\n    s=s.replace(a,b) if count==0 else s.replace(a,b,count)\n    open(p,'w').write(s)\nT='labs/game/scenes/types.ts'\nsub(T,\"\"\"export const cue = (w: W, name: string, data: Record<string, unknown> = {}): void =>\n  void w.emit('cue', { name, ...data } as never);\"\"\",\"\"\"/** Which effect a cue also bursts, where the first seat stands. */\nconst CUE_FX: Readonly<Record<string, string>> = { splashBig: 'wtSplashBig', splash: 'wtSplash', gullLand: 'wtFeathers', calmWave: 'wtCalm', stamp: 'wtSparkle', pebble: 'wtDust', marbleSink: 'wtSparkle' };\nexport const cue = (w: W, name: string, data: Record<string, unknown> = {}): void => {\n  w.emit('cue', { name, ...data } as never);\n  const fx = CUE_FX[name];\n  if (fx) burst(w, fx, name.startsWith('splash'));\n};\n\n/** Bursts an emitter at the first playing body; on the water when asked. */\nexport function burst(w: W, fx: string, water = false): void {\n  const flow = flowOf(w);\n  const seat = seatOf(w, flow.meSeat);\n  const actor = seat ? (w.get(seat.seat.actor) as unknown as { actor: { x: number; y: number; z: number } } | undefined)?.actor : undefined;\n  if (actor) w.emit(fx as never, { at: [actor.x, water ? 2.05 : actor.y + 0.8, actor.z] } as never);\n}\"\"\")\nsub('labs/game/scenes/events/pond.ts',\"      w.emit('moved', { seat: e.seat.index } as never);\",\"      w.emit('moved', { seat: e.seat.index } as never);\\n      burst(w, 'wtRipple');\")\nsub('labs/game/scenes/events/pond.ts',\"import { cue, say, type EvState\",\"import { burst, cue, say, type EvState\")\n# main cleanup\nM='labs/game/main.ts'\ns=open(M).read()\na=s.index(\"          sound.cue(payload.name as string, payload);\");b=s.index(\"          break;\\n        case 'moved':\")\ns=s[:a]+\"          sound.cue(payload.name as string, payload);\\n\"+s[b:]\ns=s.replace(\"          effect('ripple', frame);\\n\",\"\")\na=s.index(\"  function effect(name: string, frame: EngineFrame): void {\");b=s.index(\"  function guestFeet(frame\")\ns=s[:a]+s[b:]\ns=s.replace(\"  let lastEv = '';\\n\",\"\")\n# attract idle on any front-end menu\ns=s.replace(\"if (flow.mode === 'front' && !attract && !inHub && stack.length === 1) {\",\"if (flow.mode === 'front' && !attract && !inHub && stack.length >= 1) {\")\ns=s.replace(\"      if (title) title.el.style.display = attract ? 'none' : '';\",\"      for (const one of stack) one.el.style.display = attract && !touchOnly ? 'none' : '';\")\n# hub pause\ns=s.replace(\"\"\"      } else if (inHub && stack.length === 0 && input.pressed('pause') && !(navigator.getGamepads?.()[0]?.buttons[8]?.pressed)) {\n        // a session's pause never stops the sim; it is only here so the keys don't feel dead\n        ctx.say('pond.begin', 'plumb');\n      }\"\"\",\"\"\"      } else if (inHub && stack.length === 0 && input.pressed('pause') && !(navigator.getGamepads?.() ?? []).some((pad) => pad?.buttons[8]?.pressed)) {\n        ctx.push(sessionPauseScreen(ctx));\n      }\"\"\")\ns=s.replace(\"import { pauseScreen } from './ui/screens/pause';\",\"import { pauseScreen, sessionPauseScreen } from './ui/screens/pause';\")\n# unlock lines\ns=s.replace(\"\"\"        case 'results':\n          ctx.saveGame();\n          sound.event('results');\n          break;\"\"\",\"\"\"        case 'results':\n          ctx.saveGame();\n          sound.event('results');\n          for (const unlock of UNLOCKS) {\n            const paid = Number(payload.pebbles ?? 0);\n            if (flow.pebbles >= unlock.at && flow.pebbles - paid < unlock.at) ctx.say(`unlock.${unlock.id}`, 'tare');\n          }\n          break;\"\"\")\ns=s.replace(\"import { ACTIVITIES } from './scenes/events';\",\"import { ACTIVITIES } from './scenes/events';\\nimport { UNLOCKS } from './scenes/data/days';\")\n# outfit\ns=s.replace(\"free: false, ...save, steadier: settings.steadier });\",\"free: false, ...save, steadier: settings.steadier, outfit: guestBody(settings.look, settings.colour, settings.headband), outfitBuild: GUEST_BUILDS[settings.look] });\")\n# hint for mouse\ns=s.replace(\"\"\"      publish(flow);\n    },\"\"\",\"\"\"      const wantsClick = root.dataset.device === 'mouse' && flow.mode === 'event' && ev && ACTIVITIES[ev.id]?.map === 'balance' && !document.pointerLockElement && !stack.length;\n      clickHint.style.display = wantsClick ? '' : 'none';\n      publish(flow);\n    },\"\"\")\ns=s.replace(\"  let speechLeft = 0;\\n\",\"\"\"  const clickHint = document.createElement('div');\n  clickHint.className = 'wt-near';\n  clickHint.style.cssText = 'display:none;bottom:auto;top:21vh';\n  clickHint.dataset.ui = 'click-hint';\n  clickHint.textContent = 'Click to lean with the mouse';\n  root.append(clickHint);\n  let speechLeft = 0;\n\"\"\")\ns=s.replace(\"body: guestBody(settings.look, settings.colour),\",\"body: guestBody(settings.look, settings.colour, settings.headband),\")\nopen(M,'w').write(s)\n# sound random\nsub('labs/game/audio/sound.ts',\"else if (Math.random() < 0.3) audio.play('sfx:wtBirds');\",\"else if ((birds = (birds + 1) % 3) === 0) audio.play('sfx:wtBirds');\")\nsub('labs/game/audio/sound.ts',\"  let stormOn = false;\\n\",\"  let birds = 0;\\n\")\nsub('labs/game/audio/sound.ts',\"      stormOn = storm > 0.3;\\n      void stormOn;\\n\",\"\")\n# people\nsub('labs/game/cast/people.ts',\"export const guestBody = (look: number, colour: number): string => `body:guest${look}c${colour}`;\",\"export const guestBody = (look: number, colour: number, headband = false): string => `body:guest${look}c${colour}${headband ? 'h' : ''}`;\")\n# bodies\nB='labs/game/bodies/index.ts'\ns=open(B).read()\ns=s.replace(\"\"\"const eyeArc = (slot: string) => [['box', ['off', 'head', -0.05, 0.14, 0.17], ['off', 'head', -0.02, 0.14, 0.17], 0.018, 0.01, slot], ['box', ['off', 'head', 0.02, 0.14, 0.17], ['off', 'head', 0.05, 0.14, 0.17], 0.018, 0.01, slot]];\nvoid eyeArc;\n\n\"\"\",\"\")\ns=s.replace(\"function person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true): object {\",\"function person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true, eye = 0.12): object {\")\ns=s.replace(\"['eye', 'eyeL', [0.12, 'head'], 'eye'],\",\"['eye', 'eyeL', [eye, 'head'], 'eye'],\")\ns=s.replace(\"\"\"  TRACKSUITS.forEach((suit, c) => defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never)),\n);\"\"\",\"\"\"  TRACKSUITS.forEach((suit, c) => {\n    defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never);\n    const band = [['ball', ['off', 'head', 0, -0.02, [1.3, 'head']], [0.74, 'head'], 'trim']];\n    defineBody(`body:guest${l}c${c}h`, { description: `The guest, look ${l + 1}, headband earned.`, ...person({ ...look, suit, trim: '#ff5a4a' }, band) } as never);\n  }),\n);\"\"\")\ns=s.replace(\"\"\"  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6),\n} as never);\"\"\",\"\"\"  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6, true, 0.035),\n} as never);\ndefineBody('body:plumbOpen', {\n  description: 'Instructor Plumb at dawn, eyes open, once.',\n  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#101014' }, [], 0.85, 0.6, true, 0.2),\n} as never);\"\"\")\nopen(B,'w').write(s)\n# flow: outfit + npc homes + gerald ahead\nF='labs/game/scenes/flow.ts'\ns=open(F).read()\ns=s.replace(\"\"\"    const save = (args ?? {}) as Partial<Flow>;\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n\"\"\",\"\"\"    const { outfit, outfitBuild, ...save } = (args ?? {}) as Partial<Flow> & { outfit?: string; outfitBuild?: string };\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n    if (outfit && outfitBuild) dress(w, outfit, outfitBuild);\n\"\"\")\ns=s.replace(\"\"\"/** The morning: the day turns\"\"\",\"\"\"/** Stands a new guest in the old one's place: a body and build are set when an actor is made. */\nfunction dress(w: W, body: string, build: string): void {\n  const cast = castOf(w);\n  const old = (w.get(cast.guest) as unknown as { actor: { x: number; y: number; z: number }; puppet?: { body: string } } | undefined);\n  if (!old || old.puppet?.body === body) return;\n  const at: [number, number, number] = [old.actor.x, old.actor.y + 0.05, old.actor.z];\n  removeActor(w, cast.guest);\n  cast.guest = spawnPerson(w, { at, body, build, speed: GUEST_SPEED, yaw: Math.PI });\n  guestDressed = cast.guest;\n  for (const e of seatsOf(w)) if (e.seat.index === 0) e.seat.actor = cast.guest;\n}\nlet guestDressed = -1;\n\n/** Where the others go back to after a class: Gerald is already at your next thing, having finished. */\nfunction homeAgain(w: W): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  if (cast.tare < 0 || w.query('roundScene').length) return;\n  standAt(w, cast.plumb, -52, 12, 0);\n  standAt(w, cast.bex, 15, 24, -0.6);\n  standAt(w, cast.nan, -8, 30, 1.8);\n  const next = nextItem(flow);\n  const id = next === 'group' ? 'poseA' : next;\n  const station = (id && ACTIVITIES[id] && STATIONS[ACTIVITIES[id].station]) || STATIONS.plaza;\n  const [x, z] = LANDINGS[Object.entries(STATIONS).find(([, s]) => s === station)?.[0] as StationId];\n  standAt(w, cast.gerald, x + 3.2, z + 1.5, 0.8);\n}\n\n/** The morning: the day turns\"\"\")\ns=s.replace(\"\"\"    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n}\"\"\",\"\"\"    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n  homeAgain(w);\n}\"\"\")\ns=s.replace(\"import { clearBody, setLean } from '../cast/body';\",\"import { removeActor } from '../../../engine/sim-api';\\nimport { clearBody, setLean } from '../cast/body';\\nimport { GUEST_SPEED, spawnPerson } from '../cast/people';\")\ns=s.replace(\"  guestDressed = cast.guest;\\n\",\"\").replace(\"let guestDressed = -1;\\n\",\"\")\nopen(F,'w').write(s)\n# pause session\nP='labs/game/ui/screens/pause.ts'\ns=open(P).read()\ns+=\"\"\"\n/** A session's pause: an overlay that never stops the sim. Resume, volume, button icons; no dev mode, no quitting. */\nexport function sessionPauseScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'The class goes on');\n  layer.dataset.ui = 'session-pause';\n  const s = ctx.settings;\n  const pct = (v: number) => `${Math.round(v * 100)}%`;\n  const step = (v: number, d: number) => Math.round(Math.max(0, Math.min(1, v + d * 0.1)) * 100) / 100;\n  const menu = createRows(box, [\n    { id: 'resume', label: 'Resume' },\n    { id: 'music', label: 'Music', value: () => pct(s.music), change: (d) => { s.music = step(s.music, d); ctx.sound.audio.volume('music', s.music); } },\n    { id: 'effects', label: 'Effects', value: () => pct(s.effects), change: (d) => { s.effects = step(s.effects, d); ctx.sound.audio.volume('effects', s.effects); } },\n    { id: 'icons', label: 'Button icons', value: () => (s.icons === 'ps' ? 'PlayStation' : 'Xbox'), change: () => { s.icons = s.icons === 'ps' ? 'xbox' : 'ps'; ctx.root.dataset.pad = s.icons; } },\n  ], ctx.input, () => ctx.pop(), () => ctx.pop()); // prettier-ignore\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\"\"\"\nopen(P,'w').write(s)\n# settings: tracksuits & headband via a page\nS='labs/game/ui/screens/settings.ts'\ns=open(S).read()\ns=s.replace(\"\"\"      { id: 'next1', label: 'More settings' },\"\"\",\"\"\"      { id: 'suit', label: 'Tracksuit', value: () => String(s.colour + 1), change: (d) => { const n = ctx.flow().pebbles >= 20 ? 6 : 2; s.colour = (s.colour + d + n) % n; save(); } },\n      { id: 'band', label: 'Headband', off: ctx.flow().pebbles < 30, value: () => (s.headband ? 'On' : 'Off'), change: () => { s.headband = !s.headband; save(); } },\n      { id: 'next1', label: 'More settings' },\"\"\")\nopen(S,'w').write(s)\n# dev value\nD='labs/game/ui/dev/panel.ts'\ns=open(D).read()\na=s.index(\"  const valueOf = (path: string) => {\");b=s.index(\"  const setValue =\")\ns=s[:a]+\"  const tuned: Record<string, number> = ((window as unknown as { __wtDev?: Record<string, number> }).__wtDev ??= {});\\n  const valueOf = (path: string) => tuned[path] ?? defaultOf(path);\\n\"+s[b:]\nopen(D,'w').write(s)\n# board expert\nG='labs/game/ui/screens/programme.ts'\ns=open(G).read()\ns=s.replace(\"\"\"      if (expertOpen && lastKey === 'KeyX') {\n        lastKey = '';\n        expert = !expert;\n        draw();\n      }\"\"\",\"\"\"      const triangle = pad?.buttons[3]?.pressed ?? false;\n      if (expertOpen && (lastKey === 'KeyT' || (triangle && !triangleWas))) {\n        lastKey = '';\n        expert = !expert;\n        draw();\n      }\n      triangleWas = triangle;\"\"\")\ns=s.replace(\"let wasPaged = false;\",\"let wasPaged = false;\\nlet triangleWas = false;\")\ns=s.replace(\"promptBar([['page', 'Page'], ['ok', 'Go'], ['back', 'Back']]).replace('wt-bar', 'wt-prompts');\\n  box.append(foot);\",\"promptBar([['page', 'Page'], ['ok', 'Go'], ['back', 'Back'], ...(expertOpen ? ([['more', 'Expert']] as const) : [])]).replace('wt-bar', 'wt-prompts');\\n  box.append(foot);\")\ns=s.replace(\"const flow = ctx.flow();\\n  const { layer, box } = panel(ctx, flow.free ? 'Evening' : `Day ${flow.day} \\\\u2713`);\",\"const flow = ctx.flow();\\n  const stamp = flow.pebbles >= 40 ? '\\\\u2605 Unsettling' : '\\\\u2713';\\n  const { layer, box } = panel(ctx, flow.free ? 'Evening' : `Day ${flow.day} ${stamp}`);\")\nopen(G,'w').write(s)\n# kit clearOwned handles actors; prop part fix\nK='labs/game/scenes/events/kit.ts'\ns=open(K).read()\ns=s.replace(\"\"\"    const entity = world.get(id) as unknown as { sceneProp?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\"\"\",\"\"\"    const entity = world.get(id) as unknown as { sceneProp?: unknown; actor?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\n    else if (entity.actor) removeActor(w, id);\"\"\")\ns=s.replace(\"import { physicsOf, placeActor, removeProp,\",\"import { physicsOf, placeActor, removeActor, removeProp,\")\nopen(K,'w').write(s)\n# tilt eyes twin; plus unused\nTi='labs/game/scenes/events/tilt.ts'\ns=open(Ti).read()\ns=s.replace(\"\"\"  if (ev.t === 360) {\n    w.emit('plumbEyes', { open: true } as never);\n    say(w, 'tilt.hm', 'plumb');\n  }\n  if (ev.t === 480) w.emit('plumbEyes', { open: false } as never);\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\"\"\",\"\"\"  const d = dataOf(ev);\n  // Plumb opens their eyes, once: a twin with open eyes stands in for two seconds, the only time it is ever needed\n  if (ev.t === 360 && plumb >= 0) {\n    say(w, 'tilt.hm', 'plumb');\n    const { actor } = w.get(plumb) as unknown as ActorOf;\n    d.twin = spawnPerson(w, { at: [actor.x, actor.y + 0.05, actor.z], body: 'body:plumbOpen', build: 'build:plumb', speed: 2, yaw: actor.yaw, secondary: { hair: 'ponytail' } });\n    ev.owned.push(d.twin);\n    d.hide = [actor.x, actor.z];\n  }\n  if (ev.t >= 362 && ev.t < 480 && plumb >= 0) hover(w, plumb, d.hide[0], -12, d.hide[1], 0);\n  if (ev.t === 480 && plumb >= 0) {\n    removeActor(w, d.twin);\n    ev.owned.splice(ev.owned.indexOf(d.twin), 1);\n    standAt(w, plumb, d.hide[0], d.hide[1], 0);\n  }\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\"\"\")\ns=s.replace(\"cartLast: number; line: number; only: string }\",\"cartLast: number; line: number; only: string; twin: number; hide: number[] }\")\ns=s.replace(\"import { stepCrowdBody } from '../../../../engine/sim-api';\",\"import { removeActor, stepCrowdBody } from '../../../../engine/sim-api';\\nimport { spawnPerson } from '../../cast/people';\")\ns=s.replace(\"function dawnStep(w: W, ev: EvState, e: SeatE): void {\",\"function dawnStep(w: W, ev: EvState): void {\").replace(\"  void e;\\n\",\"\").replace(\"return dawnStep(w, ev, e);\",\"return dawnStep(w, ev);\")\nopen(Ti,'w').write(s)\n# island credits poses, nan nod, tare bow\nI='labs/game/scenes/island.ts'\ns=open(I).read()\ns=s.replace(\"\"\"  if (flow.mode === 'event') return;\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    setPose(w, id, id === cast.plumb ? 'RETREAT/Stand' : 'RETREAT/Stand', 0);\n    setLean(w, id, 0, 0);\n  }\"\"\",\"\"\"  if (flow.mode === 'event') return;\n  const crew = [cast.plumb, cast.bex, cast.nan, cast.gerald, cast.tare, cast.guest];\n  if (flow.mode === 'credits') {\n    // every guest holding a pose as the camera drifts past\n    const poses = ['RETREAT/Lighthouse', 'RETREAT/Heron', 'RETREAT/Nothing', 'RETREAT/Archer', 'RETREAT/Bow', 'RETREAT/Chair'];\n    crew.forEach((id, k) => {\n      if (w.tick % 60 === 0) standAt(w, id, 66 + k * 3, 6 + (k % 2) * 4, Math.PI / 2);\n      setPose(w, id, poses[k], 1);\n    });\n    return;\n  }\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    const nod = id === cast.nan && flow.nod > 0 ? Math.sin((flow.nod / 90) * Math.PI) : 0;\n    setPose(w, id, nod > 0 ? 'RETREAT/Nod' : 'RETREAT/Stand', nod);\n    setLean(w, id, 0, 0);\n  }\n  flow.nod = Math.max(0, flow.nod - 1);\"\"\")\ns=s.replace(\"import { groundAt, moveProp, tiltQuat } from './events/kit';\",\"import { groundAt, moveProp, standAt, tiltQuat } from './events/kit';\")\nopen(I,'w').write(s)\nsub('labs/game/scenes/pilot.ts',\"    flow.talk[id] = n;\\n\",\"    flow.talk[id] = n;\\n    if (id === 'nan') flow.nod = 90;\\n\")\nsub(T,\"  /** Sitting on a bench. */\",\"  /** Steps left of Old Nan's single, slow nod. */\\n  nod: number;\\n  /** Sitting on a bench. */\")\nsub(T,\"    sit: { type: 'integer',\",\"    nod: { type: 'integer', default: 0, description: 'Steps left of a nod.' },\\n    sit: { type: 'integer',\")\n# tare bow at check, plumb bow at rest\nsub('labs/game/scenes/events/ring.ts',\"    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\\n\",\"    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\\n    const { tare } = castOf(w);\\n    if (tare >= 0) setPose(w, tare, 'RETREAT/Bow', ev.phase === 'ask' ? Math.max(0, Math.sin((ev.t / 90) * Math.PI)) : 0);\\n\")\nsub('labs/game/scenes/events/ring.ts',\"import { breathFeet, type Order\",\"import { setPose } from '../../cast/body';\\nimport { breathFeet, type Order\")\n# hoop unused etc\nsub('labs/game/props/index.ts',\"radialSegments: 24, smooth: true }\",\"radialSegments: 24, smooth: 1 }\")\nE\nnpx tsc -b tsconfig.check.json 2>&1 | grep error | head -20 | cut -c1-220; tail -3 .t/hub.log | cut -c1-500","description":"Apply batch of features and fixes across sim and page","timeout":200000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5174,"cache_read_input_tokens":499024,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5174},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d46f5b4-97b7-46a5-8fb8-5eac466a6eae","uuid":"3d2beeed-d4c4-4f7e-8f93-6b07ea3ad560","timestamp":"2026-11-05T11:24:12.642Z","request_id":"req_011CgjhHTAiGxx9MWNSFPbGW","wire_tool_inputs":{"toolu_016qGJYh7JcXNKvTjYBs78tZ":{"command":"python3 - <<'E'\nimport re\ndef sub(p,a,b,count=1):\n    s=open(p).read()\n    assert a in s,(p,a[:50])\n    s=s.replace(a,b) if count==0 else s.replace(a,b,count)\n    open(p,'w').write(s)\nT='labs/game/scenes/types.ts'\nsub(T,\"\"\"export const cue = (w: W, name: string, data: Record<string, unknown> = {}): void =>\n  void w.emit('cue', { name, ...data } as never);\"\"\",\"\"\"/** Which effect a cue also bursts, where the first seat stands. */\nconst CUE_FX: Readonly<Record<string, string>> = { splashBig: 'wtSplashBig', splash: 'wtSplash', gullLand: 'wtFeathers', calmWave: 'wtCalm', stamp: 'wtSparkle', pebble: 'wtDust', marbleSink: 'wtSparkle' };\nexport const cue = (w: W, name: string, data: Record<string, unknown> = {}): void => {\n  w.emit('cue', { name, ...data } as never);\n  const fx = CUE_FX[name];\n  if (fx) burst(w, fx, name.startsWith('splash'));\n};\n\n/** Bursts an emitter at the first playing body; on the water when asked. */\nexport function burst(w: W, fx: string, water = false): void {\n  const flow = flowOf(w);\n  const seat = seatOf(w, flow.meSeat);\n  const actor = seat ? (w.get(seat.seat.actor) as unknown as { actor: { x: number; y: number; z: number } } | undefined)?.actor : undefined;\n  if (actor) w.emit(fx as never, { at: [actor.x, water ? 2.05 : actor.y + 0.8, actor.z] } as never);\n}\"\"\")\nsub('labs/game/scenes/events/pond.ts',\"      w.emit('moved', { seat: e.seat.index } as never);\",\"      w.emit('moved', { seat: e.seat.index } as never);\\n      burst(w, 'wtRipple');\")\nsub('labs/game/scenes/events/pond.ts',\"import { cue, say, type EvState\",\"import { burst, cue, say, type EvState\")\n# main cleanup\nM='labs/game/main.ts'\ns=open(M).read()\na=s.index(\"          sound.cue(payload.name as string, payload);\");b=s.index(\"          break;\\n        case 'moved':\")\ns=s[:a]+\"          sound.cue(payload.name as string, payload);\\n\"+s[b:]\ns=s.replace(\"          effect('ripple', frame);\\n\",\"\")\na=s.index(\"  function effect(name: string, frame: EngineFrame): void {\");b=s.index(\"  function guestFeet(frame\")\ns=s[:a]+s[b:]\ns=s.replace(\"  let lastEv = '';\\n\",\"\")\n# attract idle on any front-end menu\ns=s.replace(\"if (flow.mode === 'front' && !attract && !inHub && stack.length === 1) {\",\"if (flow.mode === 'front' && !attract && !inHub && stack.length >= 1) {\")\ns=s.replace(\"      if (title) title.el.style.display = attract ? 'none' : '';\",\"      for (const one of stack) one.el.style.display = attract && !touchOnly ? 'none' : '';\")\n# hub pause\ns=s.replace(\"\"\"      } else if (inHub && stack.length === 0 && input.pressed('pause') && !(navigator.getGamepads?.()[0]?.buttons[8]?.pressed)) {\n        // a session's pause never stops the sim; it is only here so the keys don't feel dead\n        ctx.say('pond.begin', 'plumb');\n      }\"\"\",\"\"\"      } else if (inHub && stack.length === 0 && input.pressed('pause') && !(navigator.getGamepads?.() ?? []).some((pad) => pad?.buttons[8]?.pressed)) {\n        ctx.push(sessionPauseScreen(ctx));\n      }\"\"\")\ns=s.replace(\"import { pauseScreen } from './ui/screens/pause';\",\"import { pauseScreen, sessionPauseScreen } from './ui/screens/pause';\")\n# unlock lines\ns=s.replace(\"\"\"        case 'results':\n          ctx.saveGame();\n          sound.event('results');\n          break;\"\"\",\"\"\"        case 'results':\n          ctx.saveGame();\n          sound.event('results');\n          for (const unlock of UNLOCKS) {\n            const paid = Number(payload.pebbles ?? 0);\n            if (flow.pebbles >= unlock.at && flow.pebbles - paid < unlock.at) ctx.say(`unlock.${unlock.id}`, 'tare');\n          }\n          break;\"\"\")\ns=s.replace(\"import { ACTIVITIES } from './scenes/events';\",\"import { ACTIVITIES } from './scenes/events';\\nimport { UNLOCKS } from './scenes/data/days';\")\n# outfit\ns=s.replace(\"free: false, ...save, steadier: settings.steadier });\",\"free: false, ...save, steadier: settings.steadier, outfit: guestBody(settings.look, settings.colour, settings.headband), outfitBuild: GUEST_BUILDS[settings.look] });\")\n# hint for mouse\ns=s.replace(\"\"\"      publish(flow);\n    },\"\"\",\"\"\"      const wantsClick = root.dataset.device === 'mouse' && flow.mode === 'event' && ev && ACTIVITIES[ev.id]?.map === 'balance' && !document.pointerLockElement && !stack.length;\n      clickHint.style.display = wantsClick ? '' : 'none';\n      publish(flow);\n    },\"\"\")\ns=s.replace(\"  let speechLeft = 0;\\n\",\"\"\"  const clickHint = document.createElement('div');\n  clickHint.className = 'wt-near';\n  clickHint.style.cssText = 'display:none;bottom:auto;top:21vh';\n  clickHint.dataset.ui = 'click-hint';\n  clickHint.textContent = 'Click to lean with the mouse';\n  root.append(clickHint);\n  let speechLeft = 0;\n\"\"\")\ns=s.replace(\"body: guestBody(settings.look, settings.colour),\",\"body: guestBody(settings.look, settings.colour, settings.headband),\")\nopen(M,'w').write(s)\n# sound random\nsub('labs/game/audio/sound.ts',\"else if (Math.random() < 0.3) audio.play('sfx:wtBirds');\",\"else if ((birds = (birds + 1) % 3) === 0) audio.play('sfx:wtBirds');\")\nsub('labs/game/audio/sound.ts',\"  let stormOn = false;\\n\",\"  let birds = 0;\\n\")\nsub('labs/game/audio/sound.ts',\"      stormOn = storm > 0.3;\\n      void stormOn;\\n\",\"\")\n# people\nsub('labs/game/cast/people.ts',\"export const guestBody = (look: number, colour: number): string => `body:guest${look}c${colour}`;\",\"export const guestBody = (look: number, colour: number, headband = false): string => `body:guest${look}c${colour}${headband ? 'h' : ''}`;\")\n# bodies\nB='labs/game/bodies/index.ts'\ns=open(B).read()\ns=s.replace(\"\"\"const eyeArc = (slot: string) => [['box', ['off', 'head', -0.05, 0.14, 0.17], ['off', 'head', -0.02, 0.14, 0.17], 0.018, 0.01, slot], ['box', ['off', 'head', 0.02, 0.14, 0.17], ['off', 'head', 0.05, 0.14, 0.17], 0.018, 0.01, slot]];\nvoid eyeArc;\n\n\"\"\",\"\")\ns=s.replace(\"function person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true): object {\",\"function person(slots: Slots, extra: unknown[] = [], calf = 1, torso = 0.8, hair = true, eye = 0.12): object {\")\ns=s.replace(\"['eye', 'eyeL', [0.12, 'head'], 'eye'],\",\"['eye', 'eyeL', [eye, 'head'], 'eye'],\")\ns=s.replace(\"\"\"  TRACKSUITS.forEach((suit, c) => defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never)),\n);\"\"\",\"\"\"  TRACKSUITS.forEach((suit, c) => {\n    defineBody(`body:guest${l}c${c}`, { description: `The guest, look ${l + 1}.`, ...person({ ...look, suit }) } as never);\n    const band = [['ball', ['off', 'head', 0, -0.02, [1.3, 'head']], [0.74, 'head'], 'trim']];\n    defineBody(`body:guest${l}c${c}h`, { description: `The guest, look ${l + 1}, headband earned.`, ...person({ ...look, suit, trim: '#ff5a4a' }, band) } as never);\n  }),\n);\"\"\")\ns=s.replace(\"\"\"  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6),\n} as never);\"\"\",\"\"\"  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#3a4a55' }, [], 0.85, 0.6, true, 0.035),\n} as never);\ndefineBody('body:plumbOpen', {\n  description: 'Instructor Plumb at dawn, eyes open, once.',\n  ...person({ skin: '#d8c0a8', suit: '#bfead6', trim: '#f7fafc', hair: '#6a5a4a', eye: '#101014' }, [], 0.85, 0.6, true, 0.2),\n} as never);\"\"\")\nopen(B,'w').write(s)\n# flow: outfit + npc homes + gerald ahead\nF='labs/game/scenes/flow.ts'\ns=open(F).read()\ns=s.replace(\"\"\"    const save = (args ?? {}) as Partial<Flow>;\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n\"\"\",\"\"\"    const { outfit, outfitBuild, ...save } = (args ?? {}) as Partial<Flow> & { outfit?: string; outfitBuild?: string };\n    if (flow.ev) endWithoutResult(w);\n    Object.assign(flow, { auto: false, bot: '', noTopple: false, drive: false, group: null, ...save, mode: 'roam' });\n    if (outfit && outfitBuild) dress(w, outfit, outfitBuild);\n\"\"\")\ns=s.replace(\"\"\"/** The morning: the day turns\"\"\",\"\"\"/** Stands a new guest in the old one's place: a body and build are set when an actor is made. */\nfunction dress(w: W, body: string, build: string): void {\n  const cast = castOf(w);\n  const old = (w.get(cast.guest) as unknown as { actor: { x: number; y: number; z: number }; puppet?: { body: string } } | undefined);\n  if (!old || old.puppet?.body === body) return;\n  const at: [number, number, number] = [old.actor.x, old.actor.y + 0.05, old.actor.z];\n  removeActor(w, cast.guest);\n  cast.guest = spawnPerson(w, { at, body, build, speed: GUEST_SPEED, yaw: Math.PI });\n  guestDressed = cast.guest;\n  for (const e of seatsOf(w)) if (e.seat.index === 0) e.seat.actor = cast.guest;\n}\nlet guestDressed = -1;\n\n/** Where the others go back to after a class: Gerald is already at your next thing, having finished. */\nfunction homeAgain(w: W): void {\n  const flow = flowOf(w);\n  const cast = castOf(w);\n  if (cast.tare < 0 || w.query('roundScene').length) return;\n  standAt(w, cast.plumb, -52, 12, 0);\n  standAt(w, cast.bex, 15, 24, -0.6);\n  standAt(w, cast.nan, -8, 30, 1.8);\n  const next = nextItem(flow);\n  const id = next === 'group' ? 'poseA' : next;\n  const station = (id && ACTIVITIES[id] && STATIONS[ACTIVITIES[id].station]) || STATIONS.plaza;\n  const [x, z] = LANDINGS[Object.entries(STATIONS).find(([, s]) => s === station)?.[0] as StationId];\n  standAt(w, cast.gerald, x + 3.2, z + 1.5, 0.8);\n}\n\n/** The morning: the day turns\"\"\")\ns=s.replace(\"\"\"    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n}\"\"\",\"\"\"    standAt(w, guest, x, z, 0);\n  }\n  flow.ev = null;\n  homeAgain(w);\n}\"\"\")\ns=s.replace(\"import { clearBody, setLean } from '../cast/body';\",\"import { removeActor } from '../../../engine/sim-api';\\nimport { clearBody, setLean } from '../cast/body';\\nimport { GUEST_SPEED, spawnPerson } from '../cast/people';\")\ns=s.replace(\"  guestDressed = cast.guest;\\n\",\"\").replace(\"let guestDressed = -1;\\n\",\"\")\nopen(F,'w').write(s)\n# pause session\nP='labs/game/ui/screens/pause.ts'\ns=open(P).read()\ns+=\"\"\"\n/** A session's pause: an overlay that never stops the sim. Resume, volume, button icons; no dev mode, no quitting. */\nexport function sessionPauseScreen(ctx: Ctx): Screen {\n  const { layer, box } = panel(ctx, 'The class goes on');\n  layer.dataset.ui = 'session-pause';\n  const s = ctx.settings;\n  const pct = (v: number) => `${Math.round(v * 100)}%`;\n  const step = (v: number, d: number) => Math.round(Math.max(0, Math.min(1, v + d * 0.1)) * 100) / 100;\n  const menu = createRows(box, [\n    { id: 'resume', label: 'Resume' },\n    { id: 'music', label: 'Music', value: () => pct(s.music), change: (d) => { s.music = step(s.music, d); ctx.sound.audio.volume('music', s.music); } },\n    { id: 'effects', label: 'Effects', value: () => pct(s.effects), change: (d) => { s.effects = step(s.effects, d); ctx.sound.audio.volume('effects', s.effects); } },\n    { id: 'icons', label: 'Button icons', value: () => (s.icons === 'ps' ? 'PlayStation' : 'Xbox'), change: () => { s.icons = s.icons === 'ps' ? 'xbox' : 'ps'; ctx.root.dataset.pad = s.icons; } },\n  ], ctx.input, () => ctx.pop(), () => ctx.pop()); // prettier-ignore\n  return { el: layer, update: (dt) => menu.update(dt), close: closer(layer) };\n}\n\"\"\"\nopen(P,'w').write(s)\n# settings: tracksuits & headband via a page\nS='labs/game/ui/screens/settings.ts'\ns=open(S).read()\ns=s.replace(\"\"\"      { id: 'next1', label: 'More settings' },\"\"\",\"\"\"      { id: 'suit', label: 'Tracksuit', value: () => String(s.colour + 1), change: (d) => { const n = ctx.flow().pebbles >= 20 ? 6 : 2; s.colour = (s.colour + d + n) % n; save(); } },\n      { id: 'band', label: 'Headband', off: ctx.flow().pebbles < 30, value: () => (s.headband ? 'On' : 'Off'), change: () => { s.headband = !s.headband; save(); } },\n      { id: 'next1', label: 'More settings' },\"\"\")\nopen(S,'w').write(s)\n# dev value\nD='labs/game/ui/dev/panel.ts'\ns=open(D).read()\na=s.index(\"  const valueOf = (path: string) => {\");b=s.index(\"  const setValue =\")\ns=s[:a]+\"  const tuned: Record<string, number> = ((window as unknown as { __wtDev?: Record<string, number> }).__wtDev ??= {});\\n  const valueOf = (path: string) => tuned[path] ?? defaultOf(path);\\n\"+s[b:]\nopen(D,'w').write(s)\n# board expert\nG='labs/game/ui/screens/programme.ts'\ns=open(G).read()\ns=s.replace(\"\"\"      if (expertOpen && lastKey === 'KeyX') {\n        lastKey = '';\n        expert = !expert;\n        draw();\n      }\"\"\",\"\"\"      const triangle = pad?.buttons[3]?.pressed ?? false;\n      if (expertOpen && (lastKey === 'KeyT' || (triangle && !triangleWas))) {\n        lastKey = '';\n        expert = !expert;\n        draw();\n      }\n      triangleWas = triangle;\"\"\")\ns=s.replace(\"let wasPaged = false;\",\"let wasPaged = false;\\nlet triangleWas = false;\")\ns=s.replace(\"promptBar([['page', 'Page'], ['ok', 'Go'], ['back', 'Back']]).replace('wt-bar', 'wt-prompts');\\n  box.append(foot);\",\"promptBar([['page', 'Page'], ['ok', 'Go'], ['back', 'Back'], ...(expertOpen ? ([['more', 'Expert']] as const) : [])]).replace('wt-bar', 'wt-prompts');\\n  box.append(foot);\")\ns=s.replace(\"const flow = ctx.flow();\\n  const { layer, box } = panel(ctx, flow.free ? 'Evening' : `Day ${flow.day} \\\\u2713`);\",\"const flow = ctx.flow();\\n  const stamp = flow.pebbles >= 40 ? '\\\\u2605 Unsettling' : '\\\\u2713';\\n  const { layer, box } = panel(ctx, flow.free ? 'Evening' : `Day ${flow.day} ${stamp}`);\")\nopen(G,'w').write(s)\n# kit clearOwned handles actors; prop part fix\nK='labs/game/scenes/events/kit.ts'\ns=open(K).read()\ns=s.replace(\"\"\"    const entity = world.get(id) as unknown as { sceneProp?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\"\"\",\"\"\"    const entity = world.get(id) as unknown as { sceneProp?: unknown; actor?: unknown } | undefined;\n    if (!entity) continue;\n    if (entity.sceneProp) removeProp(w, id);\n    else if (entity.actor) removeActor(w, id);\"\"\")\ns=s.replace(\"import { physicsOf, placeActor, removeProp,\",\"import { physicsOf, placeActor, removeActor, removeProp,\")\nopen(K,'w').write(s)\n# tilt eyes twin; plus unused\nTi='labs/game/scenes/events/tilt.ts'\ns=open(Ti).read()\ns=s.replace(\"\"\"  if (ev.t === 360) {\n    w.emit('plumbEyes', { open: true } as never);\n    say(w, 'tilt.hm', 'plumb');\n  }\n  if (ev.t === 480) w.emit('plumbEyes', { open: false } as never);\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\"\"\",\"\"\"  const d = dataOf(ev);\n  // Plumb opens their eyes, once: a twin with open eyes stands in for two seconds, the only time it is ever needed\n  if (ev.t === 360 && plumb >= 0) {\n    say(w, 'tilt.hm', 'plumb');\n    const { actor } = w.get(plumb) as unknown as ActorOf;\n    d.twin = spawnPerson(w, { at: [actor.x, actor.y + 0.05, actor.z], body: 'body:plumbOpen', build: 'build:plumb', speed: 2, yaw: actor.yaw, secondary: { hair: 'ponytail' } });\n    ev.owned.push(d.twin);\n    d.hide = [actor.x, actor.z];\n  }\n  if (ev.t >= 362 && ev.t < 480 && plumb >= 0) hover(w, plumb, d.hide[0], -12, d.hide[1], 0);\n  if (ev.t === 480 && plumb >= 0) {\n    removeActor(w, d.twin);\n    ev.owned.splice(ev.owned.indexOf(d.twin), 1);\n    standAt(w, plumb, d.hide[0], d.hide[1], 0);\n  }\n  if (ev.t === 660) say(w, 'tilt.tare', 'tare');\n  if (plumb >= 0) setPose(w, plumb, 'RETREAT/Stand', 0);\"\"\")\ns=s.replace(\"cartLast: number; line: number; only: string }\",\"cartLast: number; line: number; only: string; twin: number; hide: number[] }\")\ns=s.replace(\"import { stepCrowdBody } from '../../../../engine/sim-api';\",\"import { removeActor, stepCrowdBody } from '../../../../engine/sim-api';\\nimport { spawnPerson } from '../../cast/people';\")\ns=s.replace(\"function dawnStep(w: W, ev: EvState, e: SeatE): void {\",\"function dawnStep(w: W, ev: EvState): void {\").replace(\"  void e;\\n\",\"\").replace(\"return dawnStep(w, ev, e);\",\"return dawnStep(w, ev);\")\nopen(Ti,'w').write(s)\n# island credits poses, nan nod, tare bow\nI='labs/game/scenes/island.ts'\ns=open(I).read()\ns=s.replace(\"\"\"  if (flow.mode === 'event') return;\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    setPose(w, id, id === cast.plumb ? 'RETREAT/Stand' : 'RETREAT/Stand', 0);\n    setLean(w, id, 0, 0);\n  }\"\"\",\"\"\"  if (flow.mode === 'event') return;\n  const crew = [cast.plumb, cast.bex, cast.nan, cast.gerald, cast.tare, cast.guest];\n  if (flow.mode === 'credits') {\n    // every guest holding a pose as the camera drifts past\n    const poses = ['RETREAT/Lighthouse', 'RETREAT/Heron', 'RETREAT/Nothing', 'RETREAT/Archer', 'RETREAT/Bow', 'RETREAT/Chair'];\n    crew.forEach((id, k) => {\n      if (w.tick % 60 === 0) standAt(w, id, 66 + k * 3, 6 + (k % 2) * 4, Math.PI / 2);\n      setPose(w, id, poses[k], 1);\n    });\n    return;\n  }\n  for (const id of [cast.plumb, cast.bex, cast.nan, cast.gerald]) {\n    if (id < 0) continue;\n    const nod = id === cast.nan && flow.nod > 0 ? Math.sin((flow.nod / 90) * Math.PI) : 0;\n    setPose(w, id, nod > 0 ? 'RETREAT/Nod' : 'RETREAT/Stand', nod);\n    setLean(w, id, 0, 0);\n  }\n  flow.nod = Math.max(0, flow.nod - 1);\"\"\")\ns=s.replace(\"import { groundAt, moveProp, tiltQuat } from './events/kit';\",\"import { groundAt, moveProp, standAt, tiltQuat } from './events/kit';\")\nopen(I,'w').write(s)\nsub('labs/game/scenes/pilot.ts',\"    flow.talk[id] = n;\\n\",\"    flow.talk[id] = n;\\n    if (id === 'nan') flow.nod = 90;\\n\")\nsub(T,\"  /** Sitting on a bench. */\",\"  /** Steps left of Old Nan's single, slow nod. */\\n  nod: number;\\n  /** Sitting on a bench. */\")\nsub(T,\"    sit: { type: 'integer',\",\"    nod: { type: 'integer', default: 0, description: 'Steps left of a nod.' },\\n    sit: { type: 'integer',\")\n# tare bow at check, plumb bow at rest\nsub('labs/game/scenes/events/ring.ts',\"    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\\n\",\"    const pose = (t: number) => bodyPose(w, e, 'RETREAT/Stand', t);\\n    const { tare } = castOf(w);\\n    if (tare >= 0) setPose(w, tare, 'RETREAT/Bow', ev.phase === 'ask' ? Math.max(0, Math.sin((ev.t / 90) * Math.PI)) : 0);\\n\")\nsub('labs/game/scenes/events/ring.ts',\"import { breathFeet, type Order\",\"import { setPose } from '../../cast/body';\\nimport { breathFeet, type Order\")\n# hoop unused etc\nsub('labs/game/props/index.ts',\"radialSegments: 24, smooth: true }\",\"radialSegments: 24, smooth: 1 }\")\nE\nnpx tsc -b tsconfig.check.json 2>&1 | grep error | head -20 | cut -c1-220; tail -3 .t/hub.log | cut -c1-500","description":"Apply batch of features and fixes across sim and page","timeout":200000}}}
