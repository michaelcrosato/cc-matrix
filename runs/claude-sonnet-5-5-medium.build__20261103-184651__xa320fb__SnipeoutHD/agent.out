, '...1.1.1....', '....111.....', '.....1......', '.....1......', '....111.....', '...11111....', '..1111111...', '............', '............']\n};\nSN.WeaponIcon = (g, id, x, y, s = 2) => { const col = SN.WEAPONS[id].color; g.fillStyle = col; WI[id].forEach((r, j) => { for (let i = 0; i < 12; i++) if (r[i] === '1') g.fillRect(x + i * s, y + j * s, s, s); }); };\n})();\n"}}}
