aggr: 0 }, team: h.team, control: h.control || 'human', name: h.name, color: h.color, seat: h.seat }));\n  if (o.humanFirst) { const hs = out.filter(e => e.control === 'human'); return hs.concat(out.filter(e => e.control !== 'human')); }\n  return out;\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Rt5ttLPZuJihsuv4Li5Unq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
