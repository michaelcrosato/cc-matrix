{ E.font.text(g,SN.fmtTime(race.time*1000)+' '+Math.round(SN.kmh(race.ships[0].v)),10,10,'#fff'); }); } };\ngame.start({ scenes:{play}, scene:'play', boot:{steps:[\n ['3D', async()=>{ while(!E.World3D) await new Promise(r=>setTimeout(r,50)); await E.World3D.init(game); }],\n ['world', ()=>{ SN.R.load(game,TID); const tr=SN.getTrack(TID);\n   const ents=SN.makeEntrants({seed:3,count:8,humans:[{name:'YOU',team:'kestrel'}],humanFirst:true});\n   race=new SN.Race({track:tr,mode:'race',cls:'flare',laps:3,seed:5,entrants:ents});\n   race.ships[0].inputFn=s=>SN.AI.controls(s,race,true); SN.R.camMode=CAM;\n   for(let i=0;i<SKIP*120;i++) race.step(1/120); SN.R.update(race,race.ships[0],TV,true); }]]}});\n</script></body></html>\nE\nexport TMPDIR=$PWD/.tmp; timeout 120 node tools/shot.mjs \"http://127.0.0.1:34081/proto.html?t=solenne&skip=12\" .tmp/p2.png 7000","is_backgrounded":false,"task_type":"local_bash","uuid":"8b2f1a2e-2193-45ac-ac7a-6fe9897daeb3","session_id":"a73e9f9c-f8ef-4903-be97-67cc0d869215"}
