 if (this.cfg.replay && this.restoreTune) SN.Tune.load(this.restoreTune); }\"),\n])\nsub('src/70-hud.js',[(\"    if (opts.demo) {\",\"    if (opts.replay) { if (Math.floor(HUD.t * 1.2) % 2 === 0) T(g, 'REPLAY', W / 2, 12, '#9fe8ff', { align: 'center', scale: 2 }); SN.Glyph.left(g, [['confirm', 'EXIT REPLAY']], W / 2 - 50, H - 16); }\\n    if (opts.demo) {\")])\nsub('src/95-main.js',[\n(\"cur.onEnd = d => { const sum = SN.summarize(d); go('results', sum); };\",\"cur.onEnd = d => { if (d.cfg.replay) { go('menu'); return; } if (d.frames.length && !d.cfg.versus && !d.cfg.event) SN.replay = { cfg: Object.assign({}, d.cfg), tune: d.tune, frames: d.frames, hash: d.race.hash() }; else if (d.cfg.event || d.cfg.versus) SN.replay = d.cfg.versus ? null : { cfg: Object.assign({}, d.cfg), tune: d.tune, frames: d.frames, hash: d.race.hash() }; const sum = SN.summarize(d); go('results', sum); };\"),\n(\"  update(dt) { if (cur) cur.update(dt); }, draw(r) { if (cur) cur.draw(r); }, exit()\",\"  update(dt) { if (cur) { cur.update(dt); if (cur.cfg.replay && game.input.pressed('confirm') && cur.race.time > .5) { cur.endHandled = true; go('menu'); } } }, draw(r) { if (cur) cur.draw(r); }, exit()\"),\n(\"      if (ev && s.pass) {\",\"      if (SN.replay && SN.replay.cfg.track === s.cfg.track && !s.cfg.versus) items.push({ label: 'WATCH REPLAY', pick: () => startRace(Object.assign({}, SN.replay.cfg, { replay: SN.replay })) });\\n      if (ev && s.pass) {\"),\n])\nE\nnode --check src/95-main.js && node --check src/80-director.js && python3 - <<'E'\np='tests/browser/browser.test.mjs'; s=open(p).read()\nextra=\"\"\"\n    // ---- replay: recorded controls re-simulate to the same hash ----\n    { const rp = await open(); await rp.waitForFunction(() => game.sceneName === 'title', null, { timeout: 60000 });\n      await rp.evaluate(() => { SN.startRace({ mode: 'race', track: 'solenne', cls: 'spark', laps: 1, team: 'kestrel' }); return 1; }); await adv(rp, .3);\n      await rp.evaluate(() => { const d = SN.director(); d.race.human.inputFn = s => { const c = SN.AI.controls(s, d.race, true); d.frames.push(Object.assign({}, c)); return c; }; return 1; });\n      for (let k = 0; k < 12; k++) { await adv(rp, 20); if (await rp.evaluate(() => game.sceneName === 'results')) break; }\n      t.ok(await rp.evaluate(() => !!SN.replay && SN.replay.frames.length > 1000), 'a finished race keeps its recording');\n      await rp.evaluate(() => { SN.startRace(Object.assign({}, SN.replay.cfg, { replay: SN.replay })); return 1; }); await adv(rp, .3);\n      for (let k = 0; k < 12; k++) { await adv(rp, 20); if (await rp.evaluate(() => SN.director() && SN.director().race.over)) break; }\n      t.ok(await rp.evaluate(() => SN.director().race.hash() === SN.replay.hash), 'the replay reproduces the race exactly');\n      t.ok(rp.errs.length === 0, 'replay: no page errors: ' + rp.errs.slice(0, 3).join(' | ')); await rp.close(); }\n\"\"\"\ns=s.replace(\"    // ---- AI Hub session with a stand-in hub ----\", extra+\"    // ---- AI Hub session with a stand-in hub ----\")\nopen(p,'w').write(s)\nE\nnode tools/bundle.mjs && TMPDIR=$PWD/.tmp timeout 900 node tests/run.mjs --browser","uuid":"229e6b21-a3f5-4cf3-b42d-ef017f996d61","session_id":"a73e9f9c-f8ef-4903-be97-67cc0d869215"}
