 { loadSim } from './lib/load.mjs';\nconst SN = loadSim(); const tr = SN.getTrack('karakum');\nconst ents = SN.makeEntrants({ seed: 3, count: 8, humans: [{ name: 'YOU', team: 'kestrel' }], humanFirst: true });\nconst r = new SN.Race({ track: tr, mode: 'race', cls: 'flare', laps: 3, seed: 5, entrants: ents });\nr.ships[0].inputFn = s => SN.AI.controls(s, r, true);\nlet mh = {}; for (let i = 0; i < 120 * 12; i++) { r.step(1 / 120); for (const s of r.ships) { if (s.h > (mh[s.idx] || 0)) mh[s.idx] = s.h; } if (i % 120 == 0) console.log((i / 120), r.ships.map(s => (s.h / 16).toFixed(1) + (s.air ? 'A' : '')).join(' ')); }\nconsole.log(mh);\nE\nnode tests/dbg.mjs"}}}
