 and three.js. Music, sound and voices are synthesized in code. Writing in the deadpan house style of a league run by its own sponsors. Not affiliated with Sony or Studio Liverpool.'\n});\n})();\nE\necho '[\"00-core\",\"11-data-about\",\"20-track\",\"30-sim\",\"50-audio\",\"55-glyphs\",\"60-render\",\"70-hud\",\"75-ui\",\"80-director\",\"85-dev\",\"90-hub\",\"95-main\"]' > src/manifest.json\npython3 - <<'E'\nimport json\nm=json.load(open('src/manifest.json'))\ntags=''.join(f'<script src=\"src/{f}.js\"></script>\\n' for f in m)\nhtml=f'''<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<script src=\"vendor/aihub-session.js\"></script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Snipeout HD</title>\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Finish 3 laps first: fastest time wins\"><meta name=\"hub:session-howto\" content=\"Steer A/D or stick · Thrust W or ✕ · Airbrakes Q/E or L2/R2 · Fire Space or □\">\n<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1-4\">\n<style>html,body{margin:0;height:100%;overflow:hidden;background:#000}#stage{position:relative;width:100%;height:100%;overflow:hidden}#stage canvas{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated}</style>\n<script type=\"importmap\">{{ \"imports\": {{\n  \"three\": \"https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.webgpu.min.js\",\n  \"three/webgpu\": \"https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.webgpu.min.js\",\n  \"three/tsl\": \"https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.tsl.min.js\",\n  \"@dimforge/rapier3d-simd-compat\": \"https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-simd-compat@0.19.3/rapier.mjs\" }} }}</script></head>\n<body><div id=\"stage\"><canvas id=\"