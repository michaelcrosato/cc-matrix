 + (r ? g : 0), w: x1 - x0 - (c ? g : 0), h: y1 - y0 - (r ? g : 0) });\n  });\n}\nfunction _vpCam(game, v, dt) {   // (game.cam's rules in the viewport's size: centred on its focus, inside the bounds, eased)\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\n}\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\nHOOKS.input.push((game, dt) => {\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\n  for (const q of P.slice(1)) {\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamep