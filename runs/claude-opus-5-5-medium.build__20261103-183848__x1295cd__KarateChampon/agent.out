d that presses Start joins until the operation starts (then the seats are fixed for that operation)\\nconst openJoin = () => game.allowJoin({ max: 4, onJoin: (input, n) => { ui.note = { text: 'PLAYER ' + n + ' JOINED', t: 3 }; sfx('coin'); } });\\nconst title = {\\n  enter() { ui.idle = 0; ui.menu = menuOf(['START MISSION', 'HIGH SCORES', 'ABOUT']); A.music(E.songs.title); openJoin(); },\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  draw(r) {\\n    sky(r);\\n    r.overlay(g => {\\n      E.font.title(g, 'OPERATION', WP.W / 2, 40, { scale: 3, align: 'center', colors: ['#ffe9a0', '#ff9a4a'] });\\\"\\\"\\\",\\\"\\\"\\\"  draw(r) {\\n    sky(r);\\n    r.overlay(g => {\\n      if (ui.note && ui.note.t > 0) E.font.text(g, ui.note.text, WP.W / 2, 8, '#7ae0a0', { align: 'center', shadow: '#000' });\\n      E.font.title(g, 'OPERATION', WP.W / 2, 40, { scale: 3, align: 'center', colors: ['#ffe9a0', '#ff9a4a'] });\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"const card = {\\n  enter(data) { card.op = data.op; card.t = 0; if (run) run.op = data.op; },\\\"\\\"\\\",\\\"\\\"\\\"const card = {\\n  enter(data) { card.op = data.op; card.t = 0; if (run) run.op = data.op; openJoin(); },\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  enter(data) {\\n    if (data && data.resume) return;\\n    const op = (data && data.op) || (run && run.op) || 'op1';\\\"\\\"\\\",\\\"\\\"\\\"  enter(data) {\\n    if (data && data.resume) return;\\n    game.allowJoin(false);\\n    const op = (data && data.op) || (run && run.op) || 'op1';\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  update(dt) {\\n    if (!battle || battle.finished) return;\\\"\\\"\\\",\\\"\\\"\\\"  update(dt) {\\n    if (ui.note) ui.note.t -= dt;\\n    if (!battle || battle.finished) return;\\\"\\\"\\\")\\nopen(p,'w').write(s)\\nprint('ok')\\nEOF\\nnode tools/build.mjs >/dev/null && timeout 1500 node tests/run.mjs 2>&1 | tail -3\",\"description\":\"Open co-op joining on title and card; close at battle start\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_se