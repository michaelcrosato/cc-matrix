['play', { op: 1, dev: true, openDev: true }];","+  if (['title', 'about', 'map', 'scores', 'squad', 'credits'].includes(hash)) return [hash, {}];","+  return ['title', {}];","+};","+const scenes = Object.assign({}, WP.SCENES, {","+  attractStart: { enter() { WP.Attract.start(); }, update() {}, draw() {} }","+});","+if (WP.Net) WP.Net.addScenes(scenes);","+// the debug handle (tests, check.mjs, replay)","+game.debug = {","+  snapshot: () => {","+    const s = WP.Play.sim, sc = game.scene;","+    return { scene: sc, attract: !!WP.Play.attract, op: s ? s.opn : null, sim: s && sc === 'play' ? s.snapshot() : null, run: { diff: WP.run.diff, loop: WP.run.loop, done: WP.run.done, perks: WP.run.perks, hostagesFreed: WP.run.hostagesFreed, continues: WP.run.continues },","+      dev: WP.Dev.changed(), errors: game.errors.length, touch: WP.touchOnly(), hub: WP.Net ? WP.Net.state : null };","+  },","+  jump: (op, at) => game.go('play', { op, jump: at }),","+  cheat: (k, on) => { WP.CHEATS[k] = on; },","+  tune: (k, v) => { WP.T[k] = v; },","+  spawn: (type, o) => WP.Play.sim && WP.Play.sim.spawn(type, o || {}).id,","+  aim: (seat, x, y) => { const s = WP.Play.sim; if (s && s.players[seat]) { s.players[seat].x = x; s.players[seat].y = y; } },","+  frames: (seat, fn) => WP.Players.override(seat, fn),","+  sim: () => WP.Play.sim,","+  hub: () => WP.Net && WP.Net.state","+};","+const [first, data] = route();","+game.start({ scenes, scene: first === 'play' || first === 'cutscene' || first === 'ending' ? 'title' : first, boot: { title: 'OPERATION WOLFPACK', steps: [","+  ['Loading the pack', () => { for (const k of Object.keys(WP.RIGS)) WP.HUD.portrait && 0; }],","+  ['Painting the coast', () => { if (WP.hasDOM) WP.Render.viewFor(WP.STAGES[0], 'A'); }],","+  ['Ready', () => { if (first === 'play' || first === 'cutscene' || first === 'ending') game.after(.01, () => { game.go(first, data); if (data.openDev) game.after(.6, () => { game.menu(); WP.Dev.open(); }); }); }]","+] } });","+if 