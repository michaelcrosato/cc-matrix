 (this.confirmed || 0) + 1; }\"\nassert old in s; s=s.replace(old,new)\n# live pause: Options (not while Create is held) opens a menu over the running world; the local fighter is neutral\nold=\"  update(dt) {\\n    this.t += dt; this.stage.update(dt); Net.update(dt);\"\nnew=\"\"\"  update(dt) {\n    this.t += dt; this.stage.update(dt);\n    const I = game.input, create = I.down && (I.map.l3, false) || (typeof navigator !== 'undefined' && (() => { try { const p = navigator.getGamepads && Array.from(navigator.getGamepads() || []).find(x => x); return !!(p && p.buttons[8] && p.buttons[8].pressed); } catch (e) { return false; } })());\n    if (Net.state !== 'ended' && I.pressed('pause') && !create) { Net.menuOpen = !Net.menuOpen; if (Net.menuOpen) this.menu = new Menu([{ label: 'RESUME', fn: () => { Net.menuOpen = false; } }, { label: () => 'SOUND: ' + (game.settings.sound ? 'ON' : 'OFF'), fn: () => game.settings.set('sound', !game.settings.sound) }, { label: () => 'BUTTON SYMBOLS: ' + (KC.padFamily() === 'xbox' ? 'XBOX' : 'PLAYSTATION'), fn: () => game.settings.set('glyphs', KC.padFamily() === 'xbox' ? 'playstation' : 'xbox') }, { label: 'MOVE LIST', fn: () => { Net.menuOpen = false; KC.MoveList.active = true; KC.MoveList.make(); } }], { onCancel: () => { Net.menuOpen = false; } }); I.consumeAll(); }\n    if (Net.menuOpen && this.menu) this.menu.update(dt); else if (KC.MoveList.active) KC.MoveList.update(dt);\n    Net.update(dt);\"\"\"\nassert old in s; s=s.replace(old,new)\nold=\"      if (Net.state === 'ended' || Net.over) {\"\nnew=\"      if (Net.menuOpen && this.menu) { px.blend(g, .5, 'normal', () => px.rect(g, 0, 0, W, H, '#05040a')); KC.title(g, 'PAUSED (THE BOUT GOES ON)', W / 2, 30, 2); this.menu.draw(g, W / 2, 70); }\\n      if (Net.state === 'ended' || Net.over) {\"\nassert old in s; s=s.replace(old,new)\nold=\"    if (B && Net.state === 'play') { B.draw(r);\"\nnew=\"    if (KC.MoveList.active) { KC.MoveList.draw(r); }\\n    if (B && Net.state === 'play') { B.draw(r);\"\nassert old in s; s=s.replace(old,new)\n# local input neutral while a menu is open\ns=s.replace(\"const it = game.paused ? KC.NEUTRAL : KC.readIntent(game.input); buf.push\",\"const it = game.paused || this.menuOpen || KC.MoveList.active ? KC.NEUTRAL : KC.readIntent(game.input); buf.push\")\ns=s.replace(\"const fighting = this.pids && this.pids.includes(this.me), it = fighting && !game.paused ?\",\"const fighting = this.pids && this.pids.includes(this.me), it = fighting && !game.paused && !this.menuOpen && !KC.MoveList.active ?\")\nopen(p,'w').write(s)\nEOF\nsed -i 's/const I = game.input, create = I.down \\&\\& (I.map.l3, false) || /const I = game.input, create = /' src/60-online.js\ncat >> tests/online.test.mjs <<'EOF'\nexport const extra = 1;\nEOF\npython3 - <<'EOF'\np='tests/online.test.mjs'; s=open(p).read()\nold=\"  // the server role: a host with no player of its own\"\nnew=\"\"\"  // live pause in a session: the world keeps running and the local fighter goes neutral; a guest's predicted wind-up\n  { const W = world(2, { latency: 120 }); await W.run(1); W.start(); await W.run(9); const [h, g] = W.copies, hn = h.KC.Net, gn = g.KC.Net;\n    h.I.tap('pause'); await W.run(.1); const k0 = hn.bout.steps; await W.run(1); t.check('live pause: a menu opens and the bout keeps running', hn.menuOpen && hn.bout.steps > k0 + 100 && !h.game.paused, [hn.menuOpen, hn.bout.steps - k0]); h.I.tap('pause'); await W.run(.1); t.check('live pause closes', !hn.menuOpen);\n    const side = gn.pids.indexOf(g.me), pf = gn.pbout.f[side]; await W.run(.5); g.I.hold('tRight'); await W.run(1 / 60); g.I.hold('tRight', false); const predicted = pf.st === 'tech'; await W.run(.6);\n    t.check('the guest predicts its own wind-up at once', predicted, pf.st); t.check('the host confirms it within 250 ms', (gn.confirmed || 0) >= 1, gn.confirmed); }\n  // the server role: a host with no player of its own\"\"\"\nassert old in s; s=s.replace(old,new); s=s.replace(\"export const extra = 1;\