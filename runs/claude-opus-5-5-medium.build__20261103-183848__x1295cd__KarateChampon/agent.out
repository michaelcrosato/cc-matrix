rd' },\\n    quit: KC.SESSION ? false : 'title'\\n  }\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"KC.makeDev(game, KC.S);\\\"\\\"\\\",\\\"\\\"\\\"KC.makeDev(game, KC.S);\\nKC.makeOnline(game, KC.S);\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"const startName = (() => {\\n  const h = (typeof location !== 'undefined' && location.hash || '').replace('#', '').split('/')[0];\\n  return KC.S[h] ? h : 'title';\\n})();\\\"\\\"\\\",\\\"\\\"\\\"const startName = KC.SESSION ? 'session' : (() => {\\n  const h = (typeof location !== 'undefined' && location.hash || '').replace('#', '').split('/')[0];\\n  return KC.S[h] ? h : 'title';\\n})();\\\"\\\"\\\")\\nopen(p,'w').write(s); print('ok')\\np='tools/build.mjs'; s=open(p).read()\\nold=\\\"\\\"\\\"<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\\\\\"\\\"\\\"\\\"\\nassert s.count(old)==1\\ns=s.replace(old,\\\"\\\"\\\"<meta charset=\\\"utf-8\\\">\\n<script>${esc(session)}</script>\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"2-4\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"5\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Win bouts: first to 2 points. Winner stays on.\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Move: left stick/WASD. Strike: right stick, face buttons or IJKL.\\\">\\n<meta name=\\\"viewport\\\\\\\"\\\"\\\"\\\")\\ns=s.replace(\\\"\\\"\\\"  const exit = about;\\\"\\\"\\\",\\\"\\\"\\\"  const exit = about;\\n  const session = readFileSync(path.join(dev, 'vendor/aihub/session.js'), 'utf8');\\\"\\\"\\\")\\nopen(p,'w').write(s); print('build ok')\\nEOF\\nnode tools/build.mjs && grep -c \\\"hub:session\\\" KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315.html 2>/dev/null || grep -c \\\"hub:session\\\" ../KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315.html\",\"description\":\"Wire the session scene and inline the AI Hub client in the build\"