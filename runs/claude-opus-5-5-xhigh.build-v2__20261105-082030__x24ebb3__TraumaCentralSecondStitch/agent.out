 ...spec, id: spec.id ?? `e${sim.nextId++}`, k: spec.k, table: spec.table ?? 0, x: at[0], z: at[1], hidden: !!spec.hidden, locked: !!spec.locked, task: spec.task ?? true, age: 0 };\n  delete e.at;\n  if (e.hiddenBy) e.hidden = true;\n  switch (true) {\n    case POOL_KINDS.has(e.k): {\n      e.r = spec.r ?? 1;\n      e.r0 = e.r;\n      e.grow = spec.grow ?? (e.k === 'bleeder' ? 0.22 : 0);\n      e.max = spec.max ?? e.r * 1.6;\n      e.wasted = 0;\n      break;\n    }\n    case e.k === 'nick': {\n      e.r = spec.r ?? 0.28;\n      e.gelT = 0;\n      e.task = spec.task ?? false;\n      break;\n    }\n    case PULL_KINDS.has(e.k): {\n      if (spec.path) e.path = spec.path;\n      else e.path = arcPath(at, spec.dir ?? -90, spec.pull ?? 1.2, spec.arc ?? 0);\n      e.len = pathLength(e.path);\n      e.s = 0;\n      e.free = false;\n      e.devSum = 0;\n      e.devT = 0;\n      e.speed = 0;\n      e.home = [e.x, e.z];\n      e.rot = spec.rot ?? 0;\n      break;\n    }\n    case CARRY_KINDS.has(e.k): {\n      e.home = [e.x, e.z];\n      e.rot = spec.rot ?? 0;\n      e.rotTo = spec.rotTo ?? null;\n      e.tol = spec.tol ?? 0.6;\n      e.placed = false;\n      break;\n    }\n    case e.k === 'incision' || e.k === 'dressing': {\n      if (spec.ring) e.path = circlePath(at[0], at[1], spec.ring, Math.max(16, Math.round(spec.ring * 18)));\n      else if (spec.path) e.path = spec.path;\n      else e.path = arcPath(at, spec.ang ?? 0, spec.len ?? 2, spec.arc ?? 0);\n      e.len = pathLength(e.path);\n      e.s = 0;\n      e.devSum = 0;\n      e.devLen = 0;\n      const p = pathAt(e.path, 0);\n      e.x = p[0];\n      e.z = p[1];\n      break;\n    }\n    case e.k === 'laceration': {\n      e.len = spec.len ?? 2;\n      e.a = ((spec.ang ?? 0) * Math.PI) / 180;\n      e.slots = Math.max(2, Math.floor(e.len / 0.45) + 1);\n      e.next = 0;\n      e.flip = 0;\n      e.lastTie = -1;\n      e.q = 0;\n      e.misses = 0;\n      e.bleed = spec.bleed ?? true;\n      break;\n    }\n    case LASER_KINDS.has(e.k): {\n      e.r = spec.r ?? 0.34;\n      e.heat = 0;\n      e.stray = 0;\n      break;\n    }\n    case e.k === 'mask': {\n      e.cells = [];\n      if (spec.path) {\n        for (let i = 0; i < spec.path.length - 1; i++) {\n          const a = spec.path[i], b = spec.path[i + 1];\n          const n = Math.max(1, Math.round(Math.hypot(b[0] - a[0], b[1] - a[1]) / 0.3));\n          for (let j = 0; j <= n; j++) {\n            const t = j / n;\n            const x = a[0] + (b[0] - a[0]) * t, z = a[1] + (b[1] - a[1]) * t;\n            if (!e.cells.some((c) => Math.hypot(c[0] - x, c[1] - z) < 0.15)) e.cells.push([round2(x), round2(z), 0]);\n          }\n        }\n      } else {\n        const rx = spec.rx ?? 1.2, rz = spec.rz ?? 1;\n        for (let z = -rz; z <= rz + 1e-6; z += 0.35) {\n          for (let x = -rx; x <= rx + 1e-6; x += 0.35) {\n            if ((x * x) / (rx * rx) + (z * z) / (rz * rz) <= 1.04) e.cells.push([round2(at[0] + x), round2(at[1] + z), 0]);\n          }\n        }\n      }\n      e.need = spec.need ?? 0.92;\n      e.painted = 0;\n      break;\n    }\n    default:\n      break;\n  }\n  return e;\n}\nconst round2 = (v) => Math.round(v * 100) / 100;\n\n/** Which tool this entity wants right now, and where to bring it. null: nothing to do with it (yet). */\nexport function taskOf(sim, e) {\n  if (e.dead || e.inert) return null;\n  if (e.hidden) return e.scanHidden !== false && !e.hiddenBy ? { tool: 'scanner', x: e.x, z: e.z } : null;\n  if (e.locked) return null;\n  if (POOL_KINDS.has(e.k)) return { tool: 'drain', x: e.x, z: e.z };\n  if (e.k === 'nick') return { tool: 'gel', x: e.x, z: e.z };\n  if (PULL_KINDS.has(e.k)) return { tool: 'forceps', x: e.x, z: e.z };\n  if (CARRY_KINDS.has(e.k)) return e.placed ? null : { tool: 'forceps', x: e.x, z: e.z };\n  if (e.k === 'incision') {\n    const p = pathAt(e.path, e.s);\n    return { tool: 'scalpel', x: p[0], z: p[1] };\n  }\n  if (e.k === 'dressing') {\n    const p = pathAt(e.path, e.s);\n    return { tool: 'dressing', x: p[0], z: p[1] };\n  }\n  if (e.k === 'laceration') {\n    const sl = stitchPoint(e, e.next);\n    return { tool: 'suture', x: sl[0], z: sl[1] };\n  }\n  if (LASER_KINDS.has(e.k)) {\n    if (e.k === 'cyst' && !e.scanned) return { tool: 'scanner', x: e.x, z: e.z };\n    if (e.k === 'cyst' && !e.real) return null;\n    return { tool: 'laser', x: e.x, z: e.z };\n  }\n  if (e.k === 'mask') {\n    const c = e.cells.find((m) => !m[2]);\n    return c ? { tool: 'gel', x: c[0], z: c[1] } : null;\n  }\n  return null;\n}\n\n/** Field position of stitch slot i, respecting which end the surgeon started from. */\nexport function stitchPoint(e, i) {\n  const n = e.slots - 1;\n  const u = ((e.flip < 0 ? n - i : i) / n) * e.len;\n  return [e.x + Math.cos(e.a) * u, e.z + Math.sin(e.a) * u];\n}\n\n/** Is this one still in the way of a stage clearing? */\nexport const isOpenTask = (e) => !e.dead && e.task && !e.inert;\n\n/** The nearest thing the seat could usefully do, for the hint diamond and the bot. */\nexport function nextTask(sim, seat, onlyTool = null) {\n  let best = null, bestScore = Infinity;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table) continue;\n    if (!e.task && e.k !== 'nick') continue;\n    const t = taskOf(sim, e);\n    if (!t) continue;\n    if (t.tool !== 'dressing' && !sim.tools.includes(t.tool)) continue;\n    if (onlyTool && t.tool !== onlyTool) continue;\n    const pri = TASK_PRIORITY[e.k] ?? 2;\n    const score = pri * 20 + Math.hypot(t.x - seat.x, t.z - seat.z);\n    if (score < bestScore) { bestScore = score; best = { e, ...t }; }\n  }\n  return best;\n}\nconst TASK_PRIORITY = { pool: 0, bleeder: 0, core: 0, stalk: 0, eye: 1, incision: 1, nick: 4, mask: 3, laceration: 2, dressing: 5 };\n\n/** Every entity the current tool could act on, for aim assist and the soft pulse. */\nexport function validTargets(sim, seat, tool) {\n  const out = [];\n  for (const e of sim.ents) {\n    if (e.table !== seat.table) continue;\n    const t = taskOf(sim, e);\n    if (t && t.tool === tool) out.push(t);\n  }\n  return out;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Fgms5D6nwQezNUERhrHR2V","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk1r7QLjybiT2teu8WdE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GrRkupuDjGRw9eqwC2pm1o","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-082030__x24ebb3/work/TraumaCentralSecondStitch-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-082030/src/sim/tools.js","content":"// The eight instruments plus the contextual dressing, each a physical verb on sim state. Pure.\nimport { clamp, dist, pathAt, projectPath } from '../core/geom.js';\nimport { CARRY_KINDS, GEL_COLS, GEL_ROWS, gelCell, LASER_KINDS, POOL_KINDS, PULL_KINDS, stitchPoint, taskOf } from './entities.js';\n\nconst entById = (sim, id) => sim.ents.find((e) => e.id === id && !e.dead);\n\n/** The tool a seat is really using: a stage can force a contextual one. */\nexport function effectiveTool(sim, seat) {\n  return sim.context && sim.ents.some((e) => e.k === sim.context && e.table === seat.table && !e.dead && !e.hidden) ? sim.context : seat.tool;\n}\n\nexport function useTools(sim, api, seat, inp, dt) {\n  const tool = effectiveTool(sim, seat);\n  const pressed = inp.use && !seat.useWas;\n  seat.act = inp.use ? tool : null;\n  seat.onTarget = false;\n  if (inp.use !== seat.useWas || seat.toolWas !== tool) seat.onceRelease = false;\n  // A heart in systole punishes fine work (Dies Irae).\n  const heart = sim.heart;\n  const fine = tool === 'scalpel' || tool === 'forceps' || tool === 'laser';\n  const inSystole = heart && heart.systole && fine;\n  switch (tool) {\n    case 'drain': drain(sim, api, seat, inp, dt, pressed); break;\n    case 'forceps': forceps(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'scalpel': cut(sim, api, seat, inp, dt, pressed, 'incision', inSystole); break;\n    case 'dressing': cut(sim, api, seat, inp, dt, pressed, 'dressing', false); break;\n    case 'suture': suture(sim, api, seat, inp, dt, pressed); break;\n    case 'laser': laser(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'gel': gel(sim, api, seat, inp, dt, pressed); break;\n    case 'scanner': scanner(sim, api, seat, inp, dt); break;\n    case 'syringe': syringe(sim, api, seat, inp, dt); break;\n    default: break;\n  }\n  if (tool !== 'forceps' && seat.grab) releaseGrab(sim, api, seat);\n  if (tool !== 'scalpel' && tool !== 'dressing') seat.cutting = null;\n  if (tool !== 'syringe') { seat.draw = 0; seat.drawn = false; }\n  if (tool !== 'suture') seat.sutSide = 0;\n  if (tool !== 'drain') seat.dry = 0;\n  seat.useWas = inp.use;\n  seat.toolWas = tool;\n}\n\nfunction systoleSlip(sim, api, seat) {\n  const h = sim.heart;\n  if (h.slipBeat === h.beat) return false;\n  h.slipBeat = h.beat;\n  api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n  api.spawn({ k: 'nick', at: [seat.x, seat.z], table: seat.table });\n  api.emit('systole', { x: seat.x, z: seat.z });\n  return true;\n}\n\nfunction wrongToolCheck(sim, api, seat, tool) {\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const t = taskOf(sim, e);\n    if (!t || t.tool === tool) continue;\n    if (dist(t.x, t.z, seat.x, seat.z) < Math.max(0.6, e.r ?? 0.6)) {\n      api.emit('wrongTool', { want: t.tool, have: tool, seat: seat.id, x: seat.x, z: seat.z });\n      return true;\n    }\n  }\n  return false;\n}\n\n// ---------------------------------------------------------------- Drain\nfunction drain(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.dry = 0; return; }\n  let hit = false;\n  const tol = sim.cfg.toleranceMul;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || !POOL_KINDS.has(e.k)) continue;\n    if (dist(e.x, e.z, seat.x, seat.z) <= e.r + 0.4 * tol) {\n      hit = true;\n      e.r -= (sim.cfg.drainRate * (inp.force ?? 1) + (e.grow || 0)) * dt;\n      if (e.r < 0.2) {\n        const q = e.wasted < 0.35 ? 'clean' : e.wasted < 1.2 ? 'good' : 'sloppy';\n        api.finish(e, seat, q);\n      }\n    }\n  }\n  // Droplets.\n  for (const d of sim.drops) {\n    if (d.table === seat.table && !d.dead && dist(d.x, d.z, seat.x, seat.z) <= 0.7 * tol) {\n      d.dead = true;\n      hit = true;\n      seat.stats.drops = (seat.stats.drops || 0) + 1;\n      api.emit('dropSucked', { x: d.x, z: d.z });\n    }\n  }\n  seat.onTarget = hit;\n  if (hit) { seat.dry = 0; return; }\n  for (const e of sim.ents) if (POOL_KINDS.has(e.k) && e.table === seat.table && !e.dead && !e.hidden) e.wasted += dt;\n  seat.dry = (seat.dry || 0) + dt;\n  if (pressed) wrongToolCheck(sim, api, seat, 'drain');\n  if (seat.dry >= 0.6) {\n    seat.dry = -0.6; // a beat's grace before the next bruise\n    api.addMark(seat.table, { t: 'bruise', x: seat.x, z: seat.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n    api.emit('bruise', { x: seat.x, z: seat.z });\n  }\n}\n\n// ---------------------------------------------------------------- Forceps\nfunction grabbable(e) {\n  return !e.dead && !e.hidden && !e.locked && !e.inert && (PULL_KINDS.has(e.k) || (CARRY_KINDS.has(e.k) && !e.placed));\n}\nfunction releaseGrab(sim, api, seat, fromTear = false) {\n  const e = seat.grab ? entById(sim, seat.grab) : null;\n  seat.grab = null;\n  if (!e) return;\n  e.holders = (e.holders || 1) - 1;\n  if (e.holders > 0) return;\n  e.holders = 0;\n  if (PULL_KINDS.has(e.k)) {\n    if (e.free) {\n      const mean = e.devT > 0 ? e.devSum / e.devT : 0;\n      const tol = sim.cfg.toleranceMul;\n      const q = mean <= 0.25 * tol ? 'clean' : mean <= 0.55 * tol ? 'good' : 'sloppy';\n      api.emit('dish', { x: seat.x, z: seat.z, k: e.k });\n      api.finish(e, seat, q);\n    } else if (e.tether) {\n      api.snapBack(e, seat);\n    } else if (!fromTear) {\n      api.emit('release', { x: seat.x, z: seat.z });\n    }\n  } else if (CARRY_KINDS.has(e.k)) {\n    const d = dist(e.x, e.z, e.to[0], e.to[1]);\n    const rotOk = e.rotTo == null ? 0 : angleDelta(e.rot, e.rotTo);\n    const tol = sim.cfg.toleranceMul;\n    if (d <= e.tol * tol && rotOk <= 15 * tol) {\n      e.x = e.to[0];\n      e.z = e.to[1];\n      if (e.rotTo != null) e.rot = e.rotTo;\n      e.placed = true;\n      e.task = false;\n      const q = e.rotTo != null ? (rotOk <= 5 * tol ? 'clean' : 'good') : d <= 0.3 * tol ? 'clean' : 'good';\n      api.placed(e, seat, q);\n    } else {\n      api.emit('drop', { x: e.x, z: e.z });\n    }\n  }\n}\nexport const angleDelta = (a, b) => {\n  let d = Math.abs(a - b) % 360;\n  if (d > 180) d = 360 - d;\n  return d;\n};\n\nfunction forceps(sim, api, seat, inp, dt, pressed, inSystole) {\n  let held = seat.grab ? entById(sim, seat.grab) : null;\n  if (seat.grab && !held) seat.grab = null;\n  if (!inp.use) {\n    if (held) releaseGrab(sim, api, seat);\n    seat.noGrab = false;\n    return;\n  }\n  if (!held && seat.noGrab) return;\n  const tol = sim.cfg.toleranceMul;\n  if (!held) {\n    let best = null, bd = 0.45 * tol;\n    for (const e of sim.ents) {\n      if (e.table !== seat.table || !grabbable(e)) continue;\n      if (e.holders && !e.twoHanded) continue;\n      const d = dist(e.x, e.z, seat.x, seat.z);\n      if (d <= bd + (e.grabR ?? 0)) { best = e; bd = d; }\n    }\n    if (best) {\n      if (inSystole) { seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n      seat.grab = best.id;\n      best.holders = (best.holders || 0) + 1;\n      api.emit('grab', { x: seat.x, z: seat.z, k: best.k, id: best.id });\n      held = best;\n    } else if (pressed) {\n      wrongToolCheck(sim, api, seat, 'forceps');\n      return;\n    } else return;\n  }\n  seat.onTarget = true;\n  if (inSystole && !held.free) { releaseGrab(sim, api, seat); seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n  if (CARRY_KINDS.has(held.k)) {\n    held.x = seat.x;\n    held.z = seat.z;\n    if (inp.rot) held.rot = ((held.rot + inp.rot) % 360 + 360) % 360;\n    return;\n  }\n  if (held.free) { held.x = seat.x; held.z = seat.z; return; }\n  const p = projectPath(held.path, seat.x, seat.z, Math.max(0, held.s - 0.8), held.s + 1.1);\n  held.devSum += p.d * dt;\n  held.devT += dt;\n  if (p.d > 1 * tol * (held.tearMul ?? 1)) {\n    // Tore tissue.\n    const at = [held.x, held.z];\n    api.mistake(seat, at[0], at[1], 'tear');\n    api.spawn({ k: 'nick', at, table: seat.table });\n    seat.noGrab = true;\n    if (held.tether) { releaseGrab(sim, api, seat); return; }\n    releaseGrab(sim, api, seat, true);\n    return;\n  }\n  let s = p.s;\n  if (held.twoHanded) {\n    // Both hands must pull: progress is what the slower hand has reached.\n    const other = sim.seats.find((o) => o !== seat && o.grab === held.id);\n    if (!other) s = Math.min(s, held.s);\n    else {\n      const q = projectPath(held.path, other.x, other.z, Math.max(0, held.s - 1), held.s + 1.5);\n      s = Math.min(s, q.s);\n    }\n  }\n  if (held.tether) {\n    // The core fights: it only gives ground while being pulled, and it pulls back.\n    const fight = (held.fight ?? 0.5) * sim.cfg.strainSpeedMul;\n    s = Math.min(s, held.s + 2.6 * dt);\n    if (s <= held.s + 0.001) s = Math.max(0, held.s - fight * dt);\n  }\n  const ds = s - held.s;\n  held.speed += (Math.abs(ds) / Math.max(dt, 1e-4) - held.speed) * 0.2;\n  if (held.speedLimit && held.speed > held.speedLimit) {\n    // Too fast: the magnets clack back together.\n    held.s = 0;\n    held.speed = 0;\n    const p0 = pathAt(held.path, 0);\n    held.x = p0[0];\n    held.z = p0[1];\n    api.emit('magnetSnap', { x: held.x, z: held.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    releaseGrab(sim, api, seat, true);\n    seat.noGrab = true;\n    return;\n  }\n  held.s = clamp(s, 0, held.len);\n  const pt = pathAt(held.path, held.s);\n  held.x = pt[0];\n  held.z = pt[1];\n  if (held.s >= held.len - 0.06) {\n    held.free = true;\n    api.emit('pop', { x: held.x, z: held.z, k: held.k });\n    if (held.autoDone) {\n      seat.noGrab = true;\n      for (const o of sim.seats) if (o.grab === held.id) o.grab = null;\n      const mean = held.devT > 0 ? held.devSum / held.devT : 0;\n      api.finish(held, seat, mean <= 0.3 * tol ? 'clean' : mean <= 0.6 * tol ? 'good' : 'sloppy');\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Scalpel and dressing\nfunction cut(sim, api, seat, inp, dt, pressed, kind, inSystole) {\n  if (!inp.use) { seat.cutting = null; seat.noCut = false; return; }\n  if (seat.noCut) return;\n  const tol = sim.cfg.toleranceMul * (kind === 'dressing' ? 2 : 1);\n  let e = seat.cutting ? entById(sim, seat.cutting) : null;\n  if (!e) {\n    seat.cutting = null;\n    let bd = 0.5 * tol;\n    for (const c of sim.ents) {\n      if (c.k !== kind || c.table !== seat.table || c.dead || c.hidden || c.locked) continue;\n      const pt = pathAt(c.path, c.s);\n      const d = dist(pt[0], pt[1], seat.x, seat.z);\n      if (d <= bd) { e = c; bd = d; }\n    }\n    if (!e) {\n      if (pressed) wrongToolCheck(sim, api, seat, kind === 'dressing' ? 'dressing' : 'scalpel');\n      return;\n    }\n    if (inSystole) { seat.noCut = true; systoleSlip(sim, api, seat); return; }\n    seat.cutting = e.id;\n    api.emit(kind === 'dressing' ? 'dressStart' : 'cutStart', { x: seat.x, z: seat.z });\n  }\n  if (inSystole && e.s < e.len) { seat.cutting = null; seat.noCut = true; systoleSlip(sim, api, seat); return; }\n  seat.onTarget = true;\n  const p = projectPath(e.path, seat.x, seat.z, Math.max(0, e.s - 0.3), e.s + 0.9);\n  if (p.d > 0.8 * tol) {\n    seat.cutting = null;\n    seat.noCut = true;\n    if (kind === 'incision') {\n      api.mistake(seat, seat.x, seat.z, 'miscut');\n      api.spawn({ k: 'pool', at: [seat.x, seat.z], r: 0.6, table: seat.table, task: false });\n    }\n    return;\n  }\n  if (p.s > e.s) {\n    const ds = p.s - e.s;\n    e.devSum += p.d * ds;\n    e.devLen += ds;\n    e.s = p.s;\n    api.addCutProgress(e, seat);\n    const pt = pathAt(e.path, e.s);\n    e.x = pt[0];\n    e.z = pt[1];\n  }\n  if (e.s >= e.len - 0.08) {\n    const mean = e.devLen > 0 ? e.devSum / e.devLen : 0;\n    const qt = sim.cfg.toleranceMul * (kind === 'dressing' ? 2.5 : 1);\n    const q = mean <= 0.12 * qt ? 'clean' : mean <= 0.3 * qt ? 'good' : 'sloppy';\n    seat.cutting = null;\n    seat.noCut = true;\n    seat.stats.cutDev = (seat.stats.cutDev || 0) + mean;\n    seat.stats.cuts = (seat.stats.cuts || 0) + 1;\n    api.finish(e, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Suture\nfunction suture(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.sutSide = 0; seat.sutId = null; return; }\n  const tol = sim.cfg.toleranceMul;\n  let l = seat.sutId ? entById(sim, seat.sutId) : null;\n  if (!l) {\n    let bd = 1.3 * tol;\n    for (const e of sim.ents) {\n      if (e.k !== 'laceration' || e.table !== seat.table || e.dead || e.hidden || e.locked) continue;\n      // Either end to start from; after that, the next slot.\n      const pts = e.next === 0 ? [stitchPoint({ ...e, flip: 1 }, 0), stitchPoint({ ...e, flip: -1 }, 0)] : [stitchPoint(e, e.next)];\n      for (const p of pts) {\n        const d = dist(p[0], p[1], seat.x, seat.z);\n        if (d < bd) { bd = d; l = e; }\n      }\n    }\n    if (!l) {\n      if (pressed) wrongToolCheck(sim, api, seat, 'suture');\n      return;\n    }\n    seat.sutId = l.id;\n    seat.sutSide = 0;\n  }\n  const dx = seat.x - l.x, dz = seat.z - l.z;\n  const u = dx * Math.cos(l.a) + dz * Math.sin(l.a);\n  const v = -dx * Math.sin(l.a) + dz * Math.cos(l.a);\n  seat.onTarget = true;\n  if (Math.abs(v) < 0.25) return;\n  const side = v > 0 ? 1 : -1;\n  if (seat.sutSide && side !== seat.sutSide) {\n    if (l.next === 0 && !l.flip) l.flip = u > l.len / 2 ? -1 : 1;\n    const n = l.slots - 1;\n    const slotU = ((l.flip < 0 ? n - l.next : l.next) / n) * l.len;\n    const off = Math.abs(u - slotU);\n    if (off <= 0.4 * tol) {\n      const gap = l.lastTie < 0 ? 0.4 : sim.tick / 60 - l.lastTie;\n      const q = gap >= 0.2 && gap <= 0.7 ? 'clean' : gap <= 1.2 ? 'good' : 'sloppy';\n      l.lastTie = sim.tick / 60;\n      const sp = stitchPoint(l, l.next);\n      l.next++;\n      seat.stats.stitches = (seat.stats.stitches || 0) + 1;\n      api.addMark(seat.table, { t: 'stitch', x: sp[0], z: sp[1], a: l.a });\n      api.emit('stitch', { n: l.next, of: l.slots, x: sp[0], z: sp[1], q });\n      api.rate(seat, q, sp[0], sp[1], 0.4, true);\n      l.q += q === 'clean' ? 0 : q === 'good' ? 0.5 : 1;\n      if (l.next >= l.slots) {\n        const worst = (l.q + l.misses) / l.slots;\n        api.emit('knot', { x: sp[0], z: sp[1] });\n        seat.sutId = null;\n        api.finish(l, seat, worst < 0.2 ? 'clean' : worst < 0.5 ? 'good' : 'sloppy', 0.6);\n        return;\n      }\n    } else if (off < 1.6) {\n      l.misses++;\n      api.emit('stitchMiss', { x: seat.x, z: seat.z });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    }\n  }\n  seat.sutSide = side;\n}\n\n// ---------------------------------------------------------------- Laser\nfunction laser(sim, api, seat, inp, dt, pressed, inSystole) {\n  if (!inp.use) return;\n  const tol = sim.cfg.toleranceMul;\n  let target = null, bd = Infinity;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || e.locked || !LASER_KINDS.has(e.k)) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d <= e.r + 0.25 * tol && d < bd) { bd = d; target = e; }\n  }\n  if (!target) {\n    seat.stray = (seat.stray || 0) + dt;\n    if (pressed) wrongToolCheck(sim, api, seat, 'laser');\n    if (seat.stray > 0.5 * tol) {\n      seat.stray = -0.3;\n      api.addMark(seat.table, { t: 'burn', x: seat.x, z: seat.z });\n      api.mistake(seat, seat.x, seat.z, 'burn');\n    }\n    return;\n  }\n  seat.onTarget = true;\n  if (inSystole) { systoleSlip(sim, api, seat); return; }\n  const stray = Math.max(0, seat.stray || 0);\n  target.stray += stray;\n  seat.stray = 0;\n  target.heat += dt / (sim.cfg.laserTime * (target.burn ?? 1));\n  if (target.heat >= 1) {\n    api.emit('sizzle', { x: target.x, z: target.z, k: target.k });\n    if (target.k === 'cyst' && !target.real) {\n      api.mistake(seat, target.x, target.z, 'falsecyst');\n      target.task = false;\n      api.remove(target);\n      return;\n    }\n    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Gel\nfunction gel(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) return;\n  const R = 0.8;\n  const table = sim.tables[seat.table];\n  let hit = false;\n  const c = gelCell(seat.x, seat.z);\n  if (c >= 0) {\n    const col = c % GEL_COLS, row = Math.floor(c / GEL_COLS);\n    for (let dr = -2; dr <= 2; dr++) {\n      for (let dc = -2; dc <= 2; dc++) {\n        const rr = row + dr, cc = col + dc;\n        if (rr < 0 || cc < 0 || rr >= GEL_ROWS || cc >= GEL_COLS) continue;\n        if (dr * dr + dc * dc > 2.6 * 2.6) continue;\n        table.gel[rr * GEL_COLS + cc] = 10;\n      }\n    }\n  }\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden) continue;\n    if (e.k === 'mask' && !e.locked) {\n      let n = 0;\n      for (const m of e.cells) {\n        if (!m[2] && dist(m[0], m[1], seat.x, seat.z) <= R) { m[2] = 1; hit = true; }\n        if (m[2]) n++;\n      }\n      e.painted = n / e.cells.length;\n      if (e.painted >= e.need) {\n        const rate = e.t0 == null ? 0 : sim.tick / 60 - e.t0;\n        const q = rate < e.cells.length * 0.07 ? 'clean' : rate < e.cells.length * 0.18 ? 'good' : 'sloppy';\n        api.finish(e, seat, q, e.sob ? 0.6 : 1);\n      } else if (e.t0 == null && hit) e.t0 = sim.tick / 60;\n    } else if (e.k === 'nick' && dist(e.x, e.z, seat.x, seat.z) <= R) {\n      e.gelT += dt;\n      hit = true;\n      if (e.gelT >= 1) {\n        api.emit('heal', { x: e.x, z: e.z });\n        seat.stats.heals = (seat.stats.heals || 0) + 1;\n        api.remove(e);\n      }\n    }\n  }\n  seat.onTarget = hit;\n}\n\n// ---------------------------------------------------------------- Scanner\nfunction scanner(sim, api, seat, inp, dt) {\n  if (!inp.use) return;\n  const R = 2.2;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d > R) continue;\n    if (e.hidden && !e.hiddenBy) {\n      api.reveal(e);\n      api.emit('ping', { x: e.x, z: e.z });\n      seat.onTarget = true;\n    } else if (e.k === 'cyst' && !e.scanned) {\n      e.scanned = true;\n      api.emit('ping', { x: e.x, z: e.z, cyst: e.real ? 'real' : 'false' });\n      seat.onTarget = true;\n    } else if (e.k?.startsWith('strain:')) {\n      e.scanT = 2;\n      seat.onTarget = true;\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Syringe\nfunction syringe(sim, api, seat, inp, dt) {\n  const table = sim.tables[seat.table];\n  if (inp.use) {\n    if (sim.doses <= 0) {\n      if (!seat.useWas) api.emit('noDose', { x: seat.x, z: seat.z });\n      return;\n    }\n    if (seat.draw === 0 || seat.draw == null) api.emit('syringeDraw', { seat: seat.id });\n    seat.draw = (seat.draw || 0) + dt;\n    if (seat.draw >= 0.45 && !seat.drawn) {\n      seat.drawn = true;\n      api.emit('syringeReady', { seat: seat.id });\n    }\n    return;\n  }\n  if (seat.useWas && seat.drawn) {\n    sim.doses--;\n    const inRing = dist(seat.x, seat.z, table.ring[0], table.ring[1]) <= 0.8 * sim.cfg.toleranceMul;\n    if (inRing) {\n      table.vitals = Math.min(99, table.vitals + sim.cfg.syringeDose);\n      if (table.fake != null) table.fake = table.vitals;\n      api.emit('inject', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'clean', seat.x, seat.z, 0.3);\n      seat.stats.doses = (seat.stats.doses || 0) + 1;\n      if (sim.heart) { sim.heart.bpm = Math.max(sim.cfg.diesIraeBpm - 12, sim.heart.bpm - 12); api.emit('bpm', { bpm: sim.heart.bpm }); }\n    } else {\n      api.emit('doseWasted', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.6);\n    }\n  }\n  seat.draw = 0;\n  seat.drawn = false;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28572,"cache_read_input_tokens":146139,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28572},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"e4200716-15b6-4ca9-b830-02fc469be861","timestamp":"2026-11-05T15:29:27.066Z","request_id":"req_011Cgk1r76VaHX5FKK3anvnW","wire_tool_inputs":{"toolu_01GrRkupuDjGRw9eqwC2pm1o":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-082030__x24ebb3/work/TraumaCentralSecondStitch-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-082030/src/sim/tools.js","content":"// The eight instruments plus the contextual dressing, each a physical verb on sim state. Pure.\nimport { clamp, dist, pathAt, projectPath } from '../core/geom.js';\nimport { CARRY_KINDS, GEL_COLS, GEL_ROWS, gelCell, LASER_KINDS, POOL_KINDS, PULL_KINDS, stitchPoint, taskOf } from './entities.js';\n\nconst entById = (sim, id) => sim.ents.find((e) => e.id === id && !e.dead);\n\n/** The tool a seat is really using: a stage can force a contextual one. */\nexport function effectiveTool(sim, seat) {\n  return sim.context && sim.ents.some((e) => e.k === sim.context && e.table === seat.table && !e.dead && !e.hidden) ? sim.context : seat.tool;\n}\n\nexport function useTools(sim, api, seat, inp, dt) {\n  const tool = effectiveTool(sim, seat);\n  const pressed = inp.use && !seat.useWas;\n  seat.act = inp.use ? tool : null;\n  seat.onTarget = false;\n  if (inp.use !== seat.useWas || seat.toolWas !== tool) seat.onceRelease = false;\n  // A heart in systole punishes fine work (Dies Irae).\n  const heart = sim.heart;\n  const fine = tool === 'scalpel' || tool === 'forceps' || tool === 'laser';\n  const inSystole = heart && heart.systole && fine;\n  switch (tool) {\n    case 'drain': drain(sim, api, seat, inp, dt, pressed); break;\n    case 'forceps': forceps(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'scalpel': cut(sim, api, seat, inp, dt, pressed, 'incision', inSystole); break;\n    case 'dressing': cut(sim, api, seat, inp, dt, pressed, 'dressing', false); break;\n    case 'suture': suture(sim, api, seat, inp, dt, pressed); break;\n    case 'laser': laser(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'gel': gel(sim, api, seat, inp, dt, pressed); break;\n    case 'scanner': scanner(sim, api, seat, inp, dt); break;\n    case 'syringe': syringe(sim, api, seat, inp, dt); break;\n    default: break;\n  }\n  if (tool !== 'forceps' && seat.grab) releaseGrab(sim, api, seat);\n  if (tool !== 'scalpel' && tool !== 'dressing') seat.cutting = null;\n  if (tool !== 'syringe') { seat.draw = 0; seat.drawn = false; }\n  if (tool !== 'suture') seat.sutSide = 0;\n  if (tool !== 'drain') seat.dry = 0;\n  seat.useWas = inp.use;\n  seat.toolWas = tool;\n}\n\nfunction systoleSlip(sim, api, seat) {\n  const h = sim.heart;\n  if (h.slipBeat === h.beat) return false;\n  h.slipBeat = h.beat;\n  api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n  api.spawn({ k: 'nick', at: [seat.x, seat.z], table: seat.table });\n  api.emit('systole', { x: seat.x, z: seat.z });\n  return true;\n}\n\nfunction wrongToolCheck(sim, api, seat, tool) {\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const t = taskOf(sim, e);\n    if (!t || t.tool === tool) continue;\n    if (dist(t.x, t.z, seat.x, seat.z) < Math.max(0.6, e.r ?? 0.6)) {\n      api.emit('wrongTool', { want: t.tool, have: tool, seat: seat.id, x: seat.x, z: seat.z });\n      return true;\n    }\n  }\n  return false;\n}\n\n// ---------------------------------------------------------------- Drain\nfunction drain(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.dry = 0; return; }\n  let hit = false;\n  const tol = sim.cfg.toleranceMul;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || !POOL_KINDS.has(e.k)) continue;\n    if (dist(e.x, e.z, seat.x, seat.z) <= e.r + 0.4 * tol) {\n      hit = true;\n      e.r -= (sim.cfg.drainRate * (inp.force ?? 1) + (e.grow || 0)) * dt;\n      if (e.r < 0.2) {\n        const q = e.wasted < 0.35 ? 'clean' : e.wasted < 1.2 ? 'good' : 'sloppy';\n        api.finish(e, seat, q);\n      }\n    }\n  }\n  // Droplets.\n  for (const d of sim.drops) {\n    if (d.table === seat.table && !d.dead && dist(d.x, d.z, seat.x, seat.z) <= 0.7 * tol) {\n      d.dead = true;\n      hit = true;\n      seat.stats.drops = (seat.stats.drops || 0) + 1;\n      api.emit('dropSucked', { x: d.x, z: d.z });\n    }\n  }\n  seat.onTarget = hit;\n  if (hit) { seat.dry = 0; return; }\n  for (const e of sim.ents) if (POOL_KINDS.has(e.k) && e.table === seat.table && !e.dead && !e.hidden) e.wasted += dt;\n  seat.dry = (seat.dry || 0) + dt;\n  if (pressed) wrongToolCheck(sim, api, seat, 'drain');\n  if (seat.dry >= 0.6) {\n    seat.dry = -0.6; // a beat's grace before the next bruise\n    api.addMark(seat.table, { t: 'bruise', x: seat.x, z: seat.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n    api.emit('bruise', { x: seat.x, z: seat.z });\n  }\n}\n\n// ---------------------------------------------------------------- Forceps\nfunction grabbable(e) {\n  return !e.dead && !e.hidden && !e.locked && !e.inert && (PULL_KINDS.has(e.k) || (CARRY_KINDS.has(e.k) && !e.placed));\n}\nfunction releaseGrab(sim, api, seat, fromTear = false) {\n  const e = seat.grab ? entById(sim, seat.grab) : null;\n  seat.grab = null;\n  if (!e) return;\n  e.holders = (e.holders || 1) - 1;\n  if (e.holders > 0) return;\n  e.holders = 0;\n  if (PULL_KINDS.has(e.k)) {\n    if (e.free) {\n      const mean = e.devT > 0 ? e.devSum / e.devT : 0;\n      const tol = sim.cfg.toleranceMul;\n      const q = mean <= 0.25 * tol ? 'clean' : mean <= 0.55 * tol ? 'good' : 'sloppy';\n      api.emit('dish', { x: seat.x, z: seat.z, k: e.k });\n      api.finish(e, seat, q);\n    } else if (e.tether) {\n      api.snapBack(e, seat);\n    } else if (!fromTear) {\n      api.emit('release', { x: seat.x, z: seat.z });\n    }\n  } else if (CARRY_KINDS.has(e.k)) {\n    const d = dist(e.x, e.z, e.to[0], e.to[1]);\n    const rotOk = e.rotTo == null ? 0 : angleDelta(e.rot, e.rotTo);\n    const tol = sim.cfg.toleranceMul;\n    if (d <= e.tol * tol && rotOk <= 15 * tol) {\n      e.x = e.to[0];\n      e.z = e.to[1];\n      if (e.rotTo != null) e.rot = e.rotTo;\n      e.placed = true;\n      e.task = false;\n      const q = e.rotTo != null ? (rotOk <= 5 * tol ? 'clean' : 'good') : d <= 0.3 * tol ? 'clean' : 'good';\n      api.placed(e, seat, q);\n    } else {\n      api.emit('drop', { x: e.x, z: e.z });\n    }\n  }\n}\nexport const angleDelta = (a, b) => {\n  let d = Math.abs(a - b) % 360;\n  if (d > 180) d = 360 - d;\n  return d;\n};\n\nfunction forceps(sim, api, seat, inp, dt, pressed, inSystole) {\n  let held = seat.grab ? entById(sim, seat.grab) : null;\n  if (seat.grab && !held) seat.grab = null;\n  if (!inp.use) {\n    if (held) releaseGrab(sim, api, seat);\n    seat.noGrab = false;\n    return;\n  }\n  if (!held && seat.noGrab) return;\n  const tol = sim.cfg.toleranceMul;\n  if (!held) {\n    let best = null, bd = 0.45 * tol;\n    for (const e of sim.ents) {\n      if (e.table !== seat.table || !grabbable(e)) continue;\n      if (e.holders && !e.twoHanded) continue;\n      const d = dist(e.x, e.z, seat.x, seat.z);\n      if (d <= bd + (e.grabR ?? 0)) { best = e; bd = d; }\n    }\n    if (best) {\n      if (inSystole) { seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n      seat.grab = best.id;\n      best.holders = (best.holders || 0) + 1;\n      api.emit('grab', { x: seat.x, z: seat.z, k: best.k, id: best.id });\n      held = best;\n    } else if (pressed) {\n      wrongToolCheck(sim, api, seat, 'forceps');\n      return;\n    } else return;\n  }\n  seat.onTarget = true;\n  if (inSystole && !held.free) { releaseGrab(sim, api, seat); seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n  if (CARRY_KINDS.has(held.k)) {\n    held.x = seat.x;\n    held.z = seat.z;\n    if (inp.rot) held.rot = ((held.rot + inp.rot) % 360 + 360) % 360;\n    return;\n  }\n  if (held.free) { held.x = seat.x; held.z = seat.z; return; }\n  const p = projectPath(held.path, seat.x, seat.z, Math.max(0, held.s - 0.8), held.s + 1.1);\n  held.devSum += p.d * dt;\n  held.devT += dt;\n  if (p.d > 1 * tol * (held.tearMul ?? 1)) {\n    // Tore tissue.\n    const at = [held.x, held.z];\n    api.mistake(seat, at[0], at[1], 'tear');\n    api.spawn({ k: 'nick', at, table: seat.table });\n    seat.noGrab = true;\n    if (held.tether) { releaseGrab(sim, api, seat); return; }\n    releaseGrab(sim, api, seat, true);\n    return;\n  }\n  let s = p.s;\n  if (held.twoHanded) {\n    // Both hands must pull: progress is what the slower hand has reached.\n    const other = sim.seats.find((o) => o !== seat && o.grab === held.id);\n    if (!other) s = Math.min(s, held.s);\n    else {\n      const q = projectPath(held.path, other.x, other.z, Math.max(0, held.s - 1), held.s + 1.5);\n      s = Math.min(s, q.s);\n    }\n  }\n  if (held.tether) {\n    // The core fights: it only gives ground while being pulled, and it pulls back.\n    const fight = (held.fight ?? 0.5) * sim.cfg.strainSpeedMul;\n    s = Math.min(s, held.s + 2.6 * dt);\n    if (s <= held.s + 0.001) s = Math.max(0, held.s - fight * dt);\n  }\n  const ds = s - held.s;\n  held.speed += (Math.abs(ds) / Math.max(dt, 1e-4) - held.speed) * 0.2;\n  if (held.speedLimit && held.speed > held.speedLimit) {\n    // Too fast: the magnets clack back together.\n    held.s = 0;\n    held.speed = 0;\n    const p0 = pathAt(held.path, 0);\n    held.x = p0[0];\n    held.z = p0[1];\n    api.emit('magnetSnap', { x: held.x, z: held.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    releaseGrab(sim, api, seat, true);\n    seat.noGrab = true;\n    return;\n  }\n  held.s = clamp(s, 0, held.len);\n  const pt = pathAt(held.path, held.s);\n  held.x = pt[0];\n  held.z = pt[1];\n  if (held.s >= held.len - 0.06) {\n    held.free = true;\n    api.emit('pop', { x: held.x, z: held.z, k: held.k });\n    if (held.autoDone) {\n      seat.noGrab = true;\n      for (const o of sim.seats) if (o.grab === held.id) o.grab = null;\n      const mean = held.devT > 0 ? held.devSum / held.devT : 0;\n      api.finish(held, seat, mean <= 0.3 * tol ? 'clean' : mean <= 0.6 * tol ? 'good' : 'sloppy');\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Scalpel and dressing\nfunction cut(sim, api, seat, inp, dt, pressed, kind, inSystole) {\n  if (!inp.use) { seat.cutting = null; seat.noCut = false; return; }\n  if (seat.noCut) return;\n  const tol = sim.cfg.toleranceMul * (kind === 'dressing' ? 2 : 1);\n  let e = seat.cutting ? entById(sim, seat.cutting) : null;\n  if (!e) {\n    seat.cutting = null;\n    let bd = 0.5 * tol;\n    for (const c of sim.ents) {\n      if (c.k !== kind || c.table !== seat.table || c.dead || c.hidden || c.locked) continue;\n      const pt = pathAt(c.path, c.s);\n      const d = dist(pt[0], pt[1], seat.x, seat.z);\n      if (d <= bd) { e = c; bd = d; }\n    }\n    if (!e) {\n      if (pressed) wrongToolCheck(sim, api, seat, kind === 'dressing' ? 'dressing' : 'scalpel');\n      return;\n    }\n    if (inSystole) { seat.noCut = true; systoleSlip(sim, api, seat); return; }\n    seat.cutting = e.id;\n    api.emit(kind === 'dressing' ? 'dressStart' : 'cutStart', { x: seat.x, z: seat.z });\n  }\n  if (inSystole && e.s < e.len) { seat.cutting = null; seat.noCut = true; systoleSlip(sim, api, seat); return; }\n  seat.onTarget = true;\n  const p = projectPath(e.path, seat.x, seat.z, Math.max(0, e.s - 0.3), e.s + 0.9);\n  if (p.d > 0.8 * tol) {\n    seat.cutting = null;\n    seat.noCut = true;\n    if (kind === 'incision') {\n      api.mistake(seat, seat.x, seat.z, 'miscut');\n      api.spawn({ k: 'pool', at: [seat.x, seat.z], r: 0.6, table: seat.table, task: false });\n    }\n    return;\n  }\n  if (p.s > e.s) {\n    const ds = p.s - e.s;\n    e.devSum += p.d * ds;\n    e.devLen += ds;\n    e.s = p.s;\n    api.addCutProgress(e, seat);\n    const pt = pathAt(e.path, e.s);\n    e.x = pt[0];\n    e.z = pt[1];\n  }\n  if (e.s >= e.len - 0.08) {\n    const mean = e.devLen > 0 ? e.devSum / e.devLen : 0;\n    const qt = sim.cfg.toleranceMul * (kind === 'dressing' ? 2.5 : 1);\n    const q = mean <= 0.12 * qt ? 'clean' : mean <= 0.3 * qt ? 'good' : 'sloppy';\n    seat.cutting = null;\n    seat.noCut = true;\n    seat.stats.cutDev = (seat.stats.cutDev || 0) + mean;\n    seat.stats.cuts = (seat.stats.cuts || 0) + 1;\n    api.finish(e, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Suture\nfunction suture(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.sutSide = 0; seat.sutId = null; return; }\n  const tol = sim.cfg.toleranceMul;\n  let l = seat.sutId ? entById(sim, seat.sutId) : null;\n  if (!l) {\n    let bd = 1.3 * tol;\n    for (const e of sim.ents) {\n      if (e.k !== 'laceration' || e.table !== seat.table || e.dead || e.hidden || e.locked) continue;\n      // Either end to start from; after that, the next slot.\n      const pts = e.next === 0 ? [stitchPoint({ ...e, flip: 1 }, 0), stitchPoint({ ...e, flip: -1 }, 0)] : [stitchPoint(e, e.next)];\n      for (const p of pts) {\n        const d = dist(p[0], p[1], seat.x, seat.z);\n        if (d < bd) { bd = d; l = e; }\n      }\n    }\n    if (!l) {\n      if (pressed) wrongToolCheck(sim, api, seat, 'suture');\n      return;\n    }\n    seat.sutId = l.id;\n    seat.sutSide = 0;\n  }\n  const dx = seat.x - l.x, dz = seat.z - l.z;\n  const u = dx * Math.cos(l.a) + dz * Math.sin(l.a);\n  const v = -dx * Math.sin(l.a) + dz * Math.cos(l.a);\n  seat.onTarget = true;\n  if (Math.abs(v) < 0.25) return;\n  const side = v > 0 ? 1 : -1;\n  if (seat.sutSide && side !== seat.sutSide) {\n    if (l.next === 0 && !l.flip) l.flip = u > l.len / 2 ? -1 : 1;\n    const n = l.slots - 1;\n    const slotU = ((l.flip < 0 ? n - l.next : l.next) / n) * l.len;\n    const off = Math.abs(u - slotU);\n    if (off <= 0.4 * tol) {\n      const gap = l.lastTie < 0 ? 0.4 : sim.tick / 60 - l.lastTie;\n      const q = gap >= 0.2 && gap <= 0.7 ? 'clean' : gap <= 1.2 ? 'good' : 'sloppy';\n      l.lastTie = sim.tick / 60;\n      const sp = stitchPoint(l, l.next);\n      l.next++;\n      seat.stats.stitches = (seat.stats.stitches || 0) + 1;\n      api.addMark(seat.table, { t: 'stitch', x: sp[0], z: sp[1], a: l.a });\n      api.emit('stitch', { n: l.next, of: l.slots, x: sp[0], z: sp[1], q });\n      api.rate(seat, q, sp[0], sp[1], 0.4, true);\n      l.q += q === 'clean' ? 0 : q === 'good' ? 0.5 : 1;\n      if (l.next >= l.slots) {\n        const worst = (l.q + l.misses) / l.slots;\n        api.emit('knot', { x: sp[0], z: sp[1] });\n        seat.sutId = null;\n        api.finish(l, seat, worst < 0.2 ? 'clean' : worst < 0.5 ? 'good' : 'sloppy', 0.6);\n        return;\n      }\n    } else if (off < 1.6) {\n      l.misses++;\n      api.emit('stitchMiss', { x: seat.x, z: seat.z });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    }\n  }\n  seat.sutSide = side;\n}\n\n// ---------------------------------------------------------------- Laser\nfunction laser(sim, api, seat, inp, dt, pressed, inSystole) {\n  if (!inp.use) return;\n  const tol = sim.cfg.toleranceMul;\n  let target = null, bd = Infinity;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || e.locked || !LASER_KINDS.has(e.k)) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d <= e.r + 0.25 * tol && d < bd) { bd = d; target = e; }\n  }\n  if (!target) {\n    seat.stray = (seat.stray || 0) + dt;\n    if (pressed) wrongToolCheck(sim, api, seat, 'laser');\n    if (seat.stray > 0.5 * tol) {\n      seat.stray = -0.3;\n      api.addMark(seat.table, { t: 'burn', x: seat.x, z: seat.z });\n      api.mistake(seat, seat.x, seat.z, 'burn');\n    }\n    return;\n  }\n  seat.onTarget = true;\n  if (inSystole) { systoleSlip(sim, api, seat); return; }\n  const stray = Math.max(0, seat.stray || 0);\n  target.stray += stray;\n  seat.stray = 0;\n  target.heat += dt / (sim.cfg.laserTime * (target.burn ?? 1));\n  if (target.heat >= 1) {\n    api.emit('sizzle', { x: target.x, z: target.z, k: target.k });\n    if (target.k === 'cyst' && !target.real) {\n      api.mistake(seat, target.x, target.z, 'falsecyst');\n      target.task = false;\n      api.remove(target);\n      return;\n    }\n    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Gel\nfunction gel(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) return;\n  const R = 0.8;\n  const table = sim.tables[seat.table];\n  let hit = false;\n  const c = gelCell(seat.x, seat.z);\n  if (c >= 0) {\n    const col = c % GEL_COLS, row = Math.floor(c / GEL_COLS);\n    for (let dr = -2; dr <= 2; dr++) {\n      for (let dc = -2; dc <= 2; dc++) {\n        const rr = row + dr, cc = col + dc;\n        if (rr < 0 || cc < 0 || rr >= GEL_ROWS || cc >= GEL_COLS) continue;\n        if (dr * dr + dc * dc > 2.6 * 2.6) continue;\n        table.gel[rr * GEL_COLS + cc] = 10;\n      }\n    }\n  }\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden) continue;\n    if (e.k === 'mask' && !e.locked) {\n      let n = 0;\n      for (const m of e.cells) {\n        if (!m[2] && dist(m[0], m[1], seat.x, seat.z) <= R) { m[2] = 1; hit = true; }\n        if (m[2]) n++;\n      }\n      e.painted = n / e.cells.length;\n      if (e.painted >= e.need) {\n        const rate = e.t0 == null ? 0 : sim.tick / 60 - e.t0;\n        const q = rate < e.cells.length * 0.07 ? 'clean' : rate < e.cells.length * 0.18 ? 'good' : 'sloppy';\n        api.finish(e, seat, q, e.sob ? 0.6 : 1);\n      } else if (e.t0 == null && hit) e.t0 = sim.tick / 60;\n    } else if (e.k === 'nick' && dist(e.x, e.z, seat.x, seat.z) <= R) {\n      e.gelT += dt;\n      hit = true;\n      if (e.gelT >= 1) {\n        api.emit('heal', { x: e.x, z: e.z });\n        seat.stats.heals = (seat.stats.heals || 0) + 1;\n        api.remove(e);\n      }\n    }\n  }\n  seat.onTarget = hit;\n}\n\n// ---------------------------------------------------------------- Scanner\nfunction scanner(sim, api, seat, inp, dt) {\n  if (!inp.use) return;\n  const R = 2.2;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d > R) continue;\n    if (e.hidden && !e.hiddenBy) {\n      api.reveal(e);\n      api.emit('ping', { x: e.x, z: e.z });\n      seat.onTarget = true;\n    } else if (e.k === 'cyst' && !e.scanned) {\n      e.scanned = true;\n      api.emit('ping', { x: e.x, z: e.z, cyst: e.real ? 'real' : 'false' });\n      seat.onTarget = true;\n    } else if (e.k?.startsWith('strain:')) {\n      e.scanT = 2;\n      seat.onTarget = true;\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Syringe\nfunction syringe(sim, api, seat, inp, dt) {\n  const table = sim.tables[seat.table];\n  if (inp.use) {\n    if (sim.doses <= 0) {\n      if (!seat.useWas) api.emit('noDose', { x: seat.x, z: seat.z });\n      return;\n    }\n    if (seat.draw === 0 || seat.draw == null) api.emit('syringeDraw', { seat: seat.id });\n    seat.draw = (seat.draw || 0) + dt;\n    if (seat.draw >= 0.45 && !seat.drawn) {\n      seat.drawn = true;\n      api.emit('syringeReady', { seat: seat.id });\n    }\n    return;\n  }\n  if (seat.useWas && seat.drawn) {\n    sim.doses--;\n    const inRing = dist(seat.x, seat.z, table.ring[0], table.ring[1]) <= 0.8 * sim.cfg.toleranceMul;\n    if (inRing) {\n      table.vitals = Math.min(99, table.vitals + sim.cfg.syringeDose);\n      if (table.fake != null) table.fake = table.vitals;\n      api.emit('inject', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'clean', seat.x, seat.z, 0.3);\n      seat.stats.doses = (seat.stats.doses || 0) + 1;\n      if (sim.heart) { sim.heart.bpm = Math.max(sim.cfg.diesIraeBpm - 12, sim.heart.bpm - 12); api.emit('bpm', { bpm: sim.heart.bpm }); }\n    } else {\n      api.emit('doseWasted', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.6);\n    }\n  }\n  seat.draw = 0;\n  seat.drawn = false;\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GrRkupuDjGRw9eqwC2pm1o","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-082030__x24ebb3/work/TraumaCentralSecondStitch-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-082030/src/sim/tools.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"3c5e1873-2865-41d8-9cb0-2c5794353185","timestamp":"2026-11-05T15:29:27.116Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-082030__x24ebb3/work/TraumaCentralSecondStitch-TraumaCenterSecondOpinion-claude-opus-5-5-xhigh-20261105-082030/src/sim/tools.js","content":"// The eight instruments plus the contextual dressing, each a physical verb on sim state. Pure.\nimport { clamp, dist, pathAt, projectPath } from '../core/geom.js';\nimport { CARRY_KINDS, GEL_COLS, GEL_ROWS, gelCell, LASER_KINDS, POOL_KINDS, PULL_KINDS, stitchPoint, taskOf } from './entities.js';\n\nconst entById = (sim, id) => sim.ents.find((e) => e.id === id && !e.dead);\n\n/** The tool a seat is really using: a stage can force a contextual one. */\nexport function effectiveTool(sim, seat) {\n  return sim.context && sim.ents.some((e) => e.k === sim.context && e.table === seat.table && !e.dead && !e.hidden) ? sim.context : seat.tool;\n}\n\nexport function useTools(sim, api, seat, inp, dt) {\n  const tool = effectiveTool(sim, seat);\n  const pressed = inp.use && !seat.useWas;\n  seat.act = inp.use ? tool : null;\n  seat.onTarget = false;\n  if (inp.use !== seat.useWas || seat.toolWas !== tool) seat.onceRelease = false;\n  // A heart in systole punishes fine work (Dies Irae).\n  const heart = sim.heart;\n  const fine = tool === 'scalpel' || tool === 'forceps' || tool === 'laser';\n  const inSystole = heart && heart.systole && fine;\n  switch (tool) {\n    case 'drain': drain(sim, api, seat, inp, dt, pressed); break;\n    case 'forceps': forceps(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'scalpel': cut(sim, api, seat, inp, dt, pressed, 'incision', inSystole); break;\n    case 'dressing': cut(sim, api, seat, inp, dt, pressed, 'dressing', false); break;\n    case 'suture': suture(sim, api, seat, inp, dt, pressed); break;\n    case 'laser': laser(sim, api, seat, inp, dt, pressed, inSystole); break;\n    case 'gel': gel(sim, api, seat, inp, dt, pressed); break;\n    case 'scanner': scanner(sim, api, seat, inp, dt); break;\n    case 'syringe': syringe(sim, api, seat, inp, dt); break;\n    default: break;\n  }\n  if (tool !== 'forceps' && seat.grab) releaseGrab(sim, api, seat);\n  if (tool !== 'scalpel' && tool !== 'dressing') seat.cutting = null;\n  if (tool !== 'syringe') { seat.draw = 0; seat.drawn = false; }\n  if (tool !== 'suture') seat.sutSide = 0;\n  if (tool !== 'drain') seat.dry = 0;\n  seat.useWas = inp.use;\n  seat.toolWas = tool;\n}\n\nfunction systoleSlip(sim, api, seat) {\n  const h = sim.heart;\n  if (h.slipBeat === h.beat) return false;\n  h.slipBeat = h.beat;\n  api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n  api.spawn({ k: 'nick', at: [seat.x, seat.z], table: seat.table });\n  api.emit('systole', { x: seat.x, z: seat.z });\n  return true;\n}\n\nfunction wrongToolCheck(sim, api, seat, tool) {\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const t = taskOf(sim, e);\n    if (!t || t.tool === tool) continue;\n    if (dist(t.x, t.z, seat.x, seat.z) < Math.max(0.6, e.r ?? 0.6)) {\n      api.emit('wrongTool', { want: t.tool, have: tool, seat: seat.id, x: seat.x, z: seat.z });\n      return true;\n    }\n  }\n  return false;\n}\n\n// ---------------------------------------------------------------- Drain\nfunction drain(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.dry = 0; return; }\n  let hit = false;\n  const tol = sim.cfg.toleranceMul;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || !POOL_KINDS.has(e.k)) continue;\n    if (dist(e.x, e.z, seat.x, seat.z) <= e.r + 0.4 * tol) {\n      hit = true;\n      e.r -= (sim.cfg.drainRate * (inp.force ?? 1) + (e.grow || 0)) * dt;\n      if (e.r < 0.2) {\n        const q = e.wasted < 0.35 ? 'clean' : e.wasted < 1.2 ? 'good' : 'sloppy';\n        api.finish(e, seat, q);\n      }\n    }\n  }\n  // Droplets.\n  for (const d of sim.drops) {\n    if (d.table === seat.table && !d.dead && dist(d.x, d.z, seat.x, seat.z) <= 0.7 * tol) {\n      d.dead = true;\n      hit = true;\n      seat.stats.drops = (seat.stats.drops || 0) + 1;\n      api.emit('dropSucked', { x: d.x, z: d.z });\n    }\n  }\n  seat.onTarget = hit;\n  if (hit) { seat.dry = 0; return; }\n  for (const e of sim.ents) if (POOL_KINDS.has(e.k) && e.table === seat.table && !e.dead && !e.hidden) e.wasted += dt;\n  seat.dry = (seat.dry || 0) + dt;\n  if (pressed) wrongToolCheck(sim, api, seat, 'drain');\n  if (seat.dry >= 0.6) {\n    seat.dry = -0.6; // a beat's grace before the next bruise\n    api.addMark(seat.table, { t: 'bruise', x: seat.x, z: seat.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.5);\n    api.emit('bruise', { x: seat.x, z: seat.z });\n  }\n}\n\n// ---------------------------------------------------------------- Forceps\nfunction grabbable(e) {\n  return !e.dead && !e.hidden && !e.locked && !e.inert && (PULL_KINDS.has(e.k) || (CARRY_KINDS.has(e.k) && !e.placed));\n}\nfunction releaseGrab(sim, api, seat, fromTear = false) {\n  const e = seat.grab ? entById(sim, seat.grab) : null;\n  seat.grab = null;\n  if (!e) return;\n  e.holders = (e.holders || 1) - 1;\n  if (e.holders > 0) return;\n  e.holders = 0;\n  if (PULL_KINDS.has(e.k)) {\n    if (e.free) {\n      const mean = e.devT > 0 ? e.devSum / e.devT : 0;\n      const tol = sim.cfg.toleranceMul;\n      const q = mean <= 0.25 * tol ? 'clean' : mean <= 0.55 * tol ? 'good' : 'sloppy';\n      api.emit('dish', { x: seat.x, z: seat.z, k: e.k });\n      api.finish(e, seat, q);\n    } else if (e.tether) {\n      api.snapBack(e, seat);\n    } else if (!fromTear) {\n      api.emit('release', { x: seat.x, z: seat.z });\n    }\n  } else if (CARRY_KINDS.has(e.k)) {\n    const d = dist(e.x, e.z, e.to[0], e.to[1]);\n    const rotOk = e.rotTo == null ? 0 : angleDelta(e.rot, e.rotTo);\n    const tol = sim.cfg.toleranceMul;\n    if (d <= e.tol * tol && rotOk <= 15 * tol) {\n      e.x = e.to[0];\n      e.z = e.to[1];\n      if (e.rotTo != null) e.rot = e.rotTo;\n      e.placed = true;\n      e.task = false;\n      const q = e.rotTo != null ? (rotOk <= 5 * tol ? 'clean' : 'good') : d <= 0.3 * tol ? 'clean' : 'good';\n      api.placed(e, seat, q);\n    } else {\n      api.emit('drop', { x: e.x, z: e.z });\n    }\n  }\n}\nexport const angleDelta = (a, b) => {\n  let d = Math.abs(a - b) % 360;\n  if (d > 180) d = 360 - d;\n  return d;\n};\n\nfunction forceps(sim, api, seat, inp, dt, pressed, inSystole) {\n  let held = seat.grab ? entById(sim, seat.grab) : null;\n  if (seat.grab && !held) seat.grab = null;\n  if (!inp.use) {\n    if (held) releaseGrab(sim, api, seat);\n    seat.noGrab = false;\n    return;\n  }\n  if (!held && seat.noGrab) return;\n  const tol = sim.cfg.toleranceMul;\n  if (!held) {\n    let best = null, bd = 0.45 * tol;\n    for (const e of sim.ents) {\n      if (e.table !== seat.table || !grabbable(e)) continue;\n      if (e.holders && !e.twoHanded) continue;\n      const d = dist(e.x, e.z, seat.x, seat.z);\n      if (d <= bd + (e.grabR ?? 0)) { best = e; bd = d; }\n    }\n    if (best) {\n      if (inSystole) { seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n      seat.grab = best.id;\n      best.holders = (best.holders || 0) + 1;\n      api.emit('grab', { x: seat.x, z: seat.z, k: best.k, id: best.id });\n      held = best;\n    } else if (pressed) {\n      wrongToolCheck(sim, api, seat, 'forceps');\n      return;\n    } else return;\n  }\n  seat.onTarget = true;\n  if (inSystole && !held.free) { releaseGrab(sim, api, seat); seat.noGrab = true; systoleSlip(sim, api, seat); return; }\n  if (CARRY_KINDS.has(held.k)) {\n    held.x = seat.x;\n    held.z = seat.z;\n    if (inp.rot) held.rot = ((held.rot + inp.rot) % 360 + 360) % 360;\n    return;\n  }\n  if (held.free) { held.x = seat.x; held.z = seat.z; return; }\n  const p = projectPath(held.path, seat.x, seat.z, Math.max(0, held.s - 0.8), held.s + 1.1);\n  held.devSum += p.d * dt;\n  held.devT += dt;\n  if (p.d > 1 * tol * (held.tearMul ?? 1)) {\n    // Tore tissue.\n    const at = [held.x, held.z];\n    api.mistake(seat, at[0], at[1], 'tear');\n    api.spawn({ k: 'nick', at, table: seat.table });\n    seat.noGrab = true;\n    if (held.tether) { releaseGrab(sim, api, seat); return; }\n    releaseGrab(sim, api, seat, true);\n    return;\n  }\n  let s = p.s;\n  if (held.twoHanded) {\n    // Both hands must pull: progress is what the slower hand has reached.\n    const other = sim.seats.find((o) => o !== seat && o.grab === held.id);\n    if (!other) s = Math.min(s, held.s);\n    else {\n      const q = projectPath(held.path, other.x, other.z, Math.max(0, held.s - 1), held.s + 1.5);\n      s = Math.min(s, q.s);\n    }\n  }\n  if (held.tether) {\n    // The core fights: it only gives ground while being pulled, and it pulls back.\n    const fight = (held.fight ?? 0.5) * sim.cfg.strainSpeedMul;\n    s = Math.min(s, held.s + 2.6 * dt);\n    if (s <= held.s + 0.001) s = Math.max(0, held.s - fight * dt);\n  }\n  const ds = s - held.s;\n  held.speed += (Math.abs(ds) / Math.max(dt, 1e-4) - held.speed) * 0.2;\n  if (held.speedLimit && held.speed > held.speedLimit) {\n    // Too fast: the magnets clack back together.\n    held.s = 0;\n    held.speed = 0;\n    const p0 = pathAt(held.path, 0);\n    held.x = p0[0];\n    held.z = p0[1];\n    api.emit('magnetSnap', { x: held.x, z: held.z });\n    api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    releaseGrab(sim, api, seat, true);\n    seat.noGrab = true;\n    return;\n  }\n  held.s = clamp(s, 0, held.len);\n  const pt = pathAt(held.path, held.s);\n  held.x = pt[0];\n  held.z = pt[1];\n  if (held.s >= held.len - 0.06) {\n    held.free = true;\n    api.emit('pop', { x: held.x, z: held.z, k: held.k });\n    if (held.autoDone) {\n      seat.noGrab = true;\n      for (const o of sim.seats) if (o.grab === held.id) o.grab = null;\n      const mean = held.devT > 0 ? held.devSum / held.devT : 0;\n      api.finish(held, seat, mean <= 0.3 * tol ? 'clean' : mean <= 0.6 * tol ? 'good' : 'sloppy');\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Scalpel and dressing\nfunction cut(sim, api, seat, inp, dt, pressed, kind, inSystole) {\n  if (!inp.use) { seat.cutting = null; seat.noCut = false; return; }\n  if (seat.noCut) return;\n  const tol = sim.cfg.toleranceMul * (kind === 'dressing' ? 2 : 1);\n  let e = seat.cutting ? entById(sim, seat.cutting) : null;\n  if (!e) {\n    seat.cutting = null;\n    let bd = 0.5 * tol;\n    for (const c of sim.ents) {\n      if (c.k !== kind || c.table !== seat.table || c.dead || c.hidden || c.locked) continue;\n      const pt = pathAt(c.path, c.s);\n      const d = dist(pt[0], pt[1], seat.x, seat.z);\n      if (d <= bd) { e = c; bd = d; }\n    }\n    if (!e) {\n      if (pressed) wrongToolCheck(sim, api, seat, kind === 'dressing' ? 'dressing' : 'scalpel');\n      return;\n    }\n    if (inSystole) { seat.noCut = true; systoleSlip(sim, api, seat); return; }\n    seat.cutting = e.id;\n    api.emit(kind === 'dressing' ? 'dressStart' : 'cutStart', { x: seat.x, z: seat.z });\n  }\n  if (inSystole && e.s < e.len) { seat.cutting = null; seat.noCut = true; systoleSlip(sim, api, seat); return; }\n  seat.onTarget = true;\n  const p = projectPath(e.path, seat.x, seat.z, Math.max(0, e.s - 0.3), e.s + 0.9);\n  if (p.d > 0.8 * tol) {\n    seat.cutting = null;\n    seat.noCut = true;\n    if (kind === 'incision') {\n      api.mistake(seat, seat.x, seat.z, 'miscut');\n      api.spawn({ k: 'pool', at: [seat.x, seat.z], r: 0.6, table: seat.table, task: false });\n    }\n    return;\n  }\n  if (p.s > e.s) {\n    const ds = p.s - e.s;\n    e.devSum += p.d * ds;\n    e.devLen += ds;\n    e.s = p.s;\n    api.addCutProgress(e, seat);\n    const pt = pathAt(e.path, e.s);\n    e.x = pt[0];\n    e.z = pt[1];\n  }\n  if (e.s >= e.len - 0.08) {\n    const mean = e.devLen > 0 ? e.devSum / e.devLen : 0;\n    const qt = sim.cfg.toleranceMul * (kind === 'dressing' ? 2.5 : 1);\n    const q = mean <= 0.12 * qt ? 'clean' : mean <= 0.3 * qt ? 'good' : 'sloppy';\n    seat.cutting = null;\n    seat.noCut = true;\n    seat.stats.cutDev = (seat.stats.cutDev || 0) + mean;\n    seat.stats.cuts = (seat.stats.cuts || 0) + 1;\n    api.finish(e, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Suture\nfunction suture(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) { seat.sutSide = 0; seat.sutId = null; return; }\n  const tol = sim.cfg.toleranceMul;\n  let l = seat.sutId ? entById(sim, seat.sutId) : null;\n  if (!l) {\n    let bd = 1.3 * tol;\n    for (const e of sim.ents) {\n      if (e.k !== 'laceration' || e.table !== seat.table || e.dead || e.hidden || e.locked) continue;\n      // Either end to start from; after that, the next slot.\n      const pts = e.next === 0 ? [stitchPoint({ ...e, flip: 1 }, 0), stitchPoint({ ...e, flip: -1 }, 0)] : [stitchPoint(e, e.next)];\n      for (const p of pts) {\n        const d = dist(p[0], p[1], seat.x, seat.z);\n        if (d < bd) { bd = d; l = e; }\n      }\n    }\n    if (!l) {\n      if (pressed) wrongToolCheck(sim, api, seat, 'suture');\n      return;\n    }\n    seat.sutId = l.id;\n    seat.sutSide = 0;\n  }\n  const dx = seat.x - l.x, dz = seat.z - l.z;\n  const u = dx * Math.cos(l.a) + dz * Math.sin(l.a);\n  const v = -dx * Math.sin(l.a) + dz * Math.cos(l.a);\n  seat.onTarget = true;\n  if (Math.abs(v) < 0.25) return;\n  const side = v > 0 ? 1 : -1;\n  if (seat.sutSide && side !== seat.sutSide) {\n    if (l.next === 0 && !l.flip) l.flip = u > l.len / 2 ? -1 : 1;\n    const n = l.slots - 1;\n    const slotU = ((l.flip < 0 ? n - l.next : l.next) / n) * l.len;\n    const off = Math.abs(u - slotU);\n    if (off <= 0.4 * tol) {\n      const gap = l.lastTie < 0 ? 0.4 : sim.tick / 60 - l.lastTie;\n      const q = gap >= 0.2 && gap <= 0.7 ? 'clean' : gap <= 1.2 ? 'good' : 'sloppy';\n      l.lastTie = sim.tick / 60;\n      const sp = stitchPoint(l, l.next);\n      l.next++;\n      seat.stats.stitches = (seat.stats.stitches || 0) + 1;\n      api.addMark(seat.table, { t: 'stitch', x: sp[0], z: sp[1], a: l.a });\n      api.emit('stitch', { n: l.next, of: l.slots, x: sp[0], z: sp[1], q });\n      api.rate(seat, q, sp[0], sp[1], 0.4, true);\n      l.q += q === 'clean' ? 0 : q === 'good' ? 0.5 : 1;\n      if (l.next >= l.slots) {\n        const worst = (l.q + l.misses) / l.slots;\n        api.emit('knot', { x: sp[0], z: sp[1] });\n        seat.sutId = null;\n        api.finish(l, seat, worst < 0.2 ? 'clean' : worst < 0.5 ? 'good' : 'sloppy', 0.6);\n        return;\n      }\n    } else if (off < 1.6) {\n      l.misses++;\n      api.emit('stitchMiss', { x: seat.x, z: seat.z });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.3);\n    }\n  }\n  seat.sutSide = side;\n}\n\n// ---------------------------------------------------------------- Laser\nfunction laser(sim, api, seat, inp, dt, pressed, inSystole) {\n  if (!inp.use) return;\n  const tol = sim.cfg.toleranceMul;\n  let target = null, bd = Infinity;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden || e.locked || !LASER_KINDS.has(e.k)) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d <= e.r + 0.25 * tol && d < bd) { bd = d; target = e; }\n  }\n  if (!target) {\n    seat.stray = (seat.stray || 0) + dt;\n    if (pressed) wrongToolCheck(sim, api, seat, 'laser');\n    if (seat.stray > 0.5 * tol) {\n      seat.stray = -0.3;\n      api.addMark(seat.table, { t: 'burn', x: seat.x, z: seat.z });\n      api.mistake(seat, seat.x, seat.z, 'burn');\n    }\n    return;\n  }\n  seat.onTarget = true;\n  if (inSystole) { systoleSlip(sim, api, seat); return; }\n  const stray = Math.max(0, seat.stray || 0);\n  target.stray += stray;\n  seat.stray = 0;\n  target.heat += dt / (sim.cfg.laserTime * (target.burn ?? 1));\n  if (target.heat >= 1) {\n    api.emit('sizzle', { x: target.x, z: target.z, k: target.k });\n    if (target.k === 'cyst' && !target.real) {\n      api.mistake(seat, target.x, target.z, 'falsecyst');\n      target.task = false;\n      api.remove(target);\n      return;\n    }\n    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\n  }\n}\n\n// ---------------------------------------------------------------- Gel\nfunction gel(sim, api, seat, inp, dt, pressed) {\n  if (!inp.use) return;\n  const R = 0.8;\n  const table = sim.tables[seat.table];\n  let hit = false;\n  const c = gelCell(seat.x, seat.z);\n  if (c >= 0) {\n    const col = c % GEL_COLS, row = Math.floor(c / GEL_COLS);\n    for (let dr = -2; dr <= 2; dr++) {\n      for (let dc = -2; dc <= 2; dc++) {\n        const rr = row + dr, cc = col + dc;\n        if (rr < 0 || cc < 0 || rr >= GEL_ROWS || cc >= GEL_COLS) continue;\n        if (dr * dr + dc * dc > 2.6 * 2.6) continue;\n        table.gel[rr * GEL_COLS + cc] = 10;\n      }\n    }\n  }\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead || e.hidden) continue;\n    if (e.k === 'mask' && !e.locked) {\n      let n = 0;\n      for (const m of e.cells) {\n        if (!m[2] && dist(m[0], m[1], seat.x, seat.z) <= R) { m[2] = 1; hit = true; }\n        if (m[2]) n++;\n      }\n      e.painted = n / e.cells.length;\n      if (e.painted >= e.need) {\n        const rate = e.t0 == null ? 0 : sim.tick / 60 - e.t0;\n        const q = rate < e.cells.length * 0.07 ? 'clean' : rate < e.cells.length * 0.18 ? 'good' : 'sloppy';\n        api.finish(e, seat, q, e.sob ? 0.6 : 1);\n      } else if (e.t0 == null && hit) e.t0 = sim.tick / 60;\n    } else if (e.k === 'nick' && dist(e.x, e.z, seat.x, seat.z) <= R) {\n      e.gelT += dt;\n      hit = true;\n      if (e.gelT >= 1) {\n        api.emit('heal', { x: e.x, z: e.z });\n        seat.stats.heals = (seat.stats.heals || 0) + 1;\n        api.remove(e);\n      }\n    }\n  }\n  seat.onTarget = hit;\n}\n\n// ---------------------------------------------------------------- Scanner\nfunction scanner(sim, api, seat, inp, dt) {\n  if (!inp.use) return;\n  const R = 2.2;\n  for (const e of sim.ents) {\n    if (e.table !== seat.table || e.dead) continue;\n    const d = dist(e.x, e.z, seat.x, seat.z);\n    if (d > R) continue;\n    if (e.hidden && !e.hiddenBy) {\n      api.reveal(e);\n      api.emit('ping', { x: e.x, z: e.z });\n      seat.onTarget = true;\n    } else if (e.k === 'cyst' && !e.scanned) {\n      e.scanned = true;\n      api.emit('ping', { x: e.x, z: e.z, cyst: e.real ? 'real' : 'false' });\n      seat.onTarget = true;\n    } else if (e.k?.startsWith('strain:')) {\n      e.scanT = 2;\n      seat.onTarget = true;\n    }\n  }\n}\n\n// ---------------------------------------------------------------- Syringe\nfunction syringe(sim, api, seat, inp, dt) {\n  const table = sim.tables[seat.table];\n  if (inp.use) {\n    if (sim.doses <= 0) {\n      if (!seat.useWas) api.emit('noDose', { x: seat.x, z: seat.z });\n      return;\n    }\n    if (seat.draw === 0 || seat.draw == null) api.emit('syringeDraw', { seat: seat.id });\n    seat.draw = (seat.draw || 0) + dt;\n    if (seat.draw >= 0.45 && !seat.drawn) {\n      seat.drawn = true;\n      api.emit('syringeReady', { seat: seat.id });\n    }\n    return;\n  }\n  if (seat.useWas && seat.drawn) {\n    sim.doses--;\n    const inRing = dist(seat.x, seat.z, table.ring[0], table.ring[1]) <= 0.8 * sim.cfg.toleranceMul;\n    if (inRing) {\n      table.vitals = Math.min(99, table.vitals + sim.cfg.syringeDose);\n      if (table.fake != null) table.fake = table.vitals;\n      api.emit('inject', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'clean', seat.x, seat.z, 0.3);\n      seat.stats.doses = (seat.stats.doses || 0) + 1;\n      if (sim.heart) { sim.heart.bpm = Math.max(sim.cfg.diesIraeBpm - 12, sim.heart.bpm - 12); api.emit('bpm', { bpm: sim.heart.bpm }); }\n    } else {\n      api.emit('doseWasted', { x: seat.x, z: seat.z, seat: seat.id });\n      api.rate(seat, 'sloppy', seat.x, seat.z, 0.6);\n    }\n  }\n  seat.draw = 0;\n  seat.drawn = false;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01GrRkupuDjGRw9eqwC2pm1o","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
