{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk44szno9r14Z6jKJt5z","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15040,"cache_read_input_tokens":387106,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15040},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"6b457bc0-6b01-4f17-884e-892e40c83b60","timestamp":"2026-11-05T15:56:14.843Z","request_id":"req_011Cgk44seStcEEY11b2123P","thinking_duration_ms":34973,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk44szno9r14Z6jKJt5z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QAn5D6UDJHQ1U1hoeNvFSr","name":"Bash","input":{"command":"cat > src/view/bust.js <<'EOF'\n// The anime talking head: a real 3D bust with pivots for head, mouth, brows and lids, and an emotion\n// pose table per character. The same models talk in story scenes and, tiny, on the comm strip.\nimport { buildModel, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { BUSTS } from '../content/models/cast.js';\n\nconst SKIN = {\n  ilya: { skin: 0xf2c9a2, skin2: 0xd69e78 }, reyes: { skin: 0xc58a5c, skin2: 0xa26c42 }, sabine: { skin: 0xf3d8c4, skin2: 0xd2ad96 }, bram: { skin: 0xf0c8aa, skin2: 0xd4a084 }, pem: { skin: 0x7c4c34, skin2: 0x5c3624 }, hesper: { skin: 0xf6e4d6, skin2: 0xd8c2b2 },\n  tomasz: { skin: 0xc98f62, skin2: 0xa06c44 }, ottilie: { skin: 0xf0cdb0, skin2: 0xd4a88a }, ollie: { skin: 0xf4d0b0, skin2: 0xd8a888 }, zamboni: { skin: 0xf0cda8, skin2: 0xd2a684 }, anselm: { skin: 0xe6bc94, skin2: 0xc49870 },\n};\n\n// Brow rotation (degrees, positive: inner end down, angry) and height; lid 0 open..1 shut; mouth w,h; head tilt.\nexport const EMOTIONS = {\n  neutral: { brow: 0, browY: 0, lid: 0.12, mouth: [1, 1], tilt: 0, nod: 0 },\n  stern: { brow: 14, browY: -0.02, lid: 0.3, mouth: [0.9, 0.7], tilt: 0, nod: 0.05 },\n  shock: { brow: -16, browY: 0.07, lid: 0, mouth: [0.8, 3], tilt: 0, nod: -0.08, pupil: 0.7 },\n  sad: { brow: -20, browY: 0.02, lid: 0.45, mouth: [0.8, 0.7], tilt: 0.05, nod: 0.12, tear: true },\n  smile: { brow: -6, browY: 0.02, lid: 0.2, mouth: [1.4, 1.5], tilt: -0.04, nod: 0, blush: false },\n  angry: { brow: 26, browY: -0.04, lid: 0.22, mouth: [1.2, 2], tilt: 0, nod: 0.08 },\n  panic: { brow: -22, browY: 0.08, lid: 0, mouth: [1.2, 2.6], tilt: 0.06, nod: -0.04, sweat: true, pupil: 0.65 },\n  blush: { brow: -6, browY: 0.02, lid: 0.3, mouth: [0.8, 0.9], tilt: 0.05, nod: 0.1, blush: true, sweat: false },\n};\n\nexport class BustRig {\n  constructor(ctx, who, o = {}) {\n    this.who = BUSTS[who] ? who : 'ilya';\n    const b = buildModel(BUSTS[this.who], { palette: SKIN[this.who] ?? {} });\n    this.object = b.object;\n    this.meshes = [];\n    this.object.traverse((m) => {\n      if (m.isMesh) {\n        m.receiveShadow = false;\n        m.castShadow = false;\n        m.material = m.material.clone();\n        m.material.userData = { ...m.material.userData, shared: false };\n        m.userData.base = m.material.color.clone();\n        this.meshes.push(m);\n      }\n    });\n    const get = (n) => this.object.getObjectByName(n);\n    this.head = get('head');\n    this.mouth = get('mouth');\n    this.browL = get('browL');\n    this.browR = get('browR');\n    this.lidL = get('lidL');\n    this.lidR = get('lidR');\n    this.pupilL = get('pupilL');\n    this.pupilR = get('pupilR');\n    this.sweat = get('sweat');\n    this.blush = get('blush');\n    this.tear = get('tear');\n    this.glint = get('glint');\n    if (this.sweat) this.sweat.visible = false;\n    if (this.blush) this.blush.visible = false;\n    if (this.tear) this.tear.visible = false;\n    setLookLayer(this.object, 'actors');\n    this.browY0 = this.browL.position.y;\n    this.lidY0 = this.lidL.position.y;\n    this.tearY0 = this.tear?.position.y ?? 0;\n    this.sweatY0 = this.sweat?.position.y ?? 0;\n    this.t = Math.random() * 9;\n    this.emotion = 'neutral';\n    this.cur = { ...EMOTIONS.neutral };\n    this.open = 0;\n    this.blinkIn = 2 + Math.random() * 3;\n    this.blinkT = 0;\n    this.lean = 0;\n    this.leanTo = 0;\n    this.dim = 1;\n    this.dimTo = 1;\n    this.lastDim = -1;\n    this.pose();\n    if (o.parent) o.parent.add(this.object);\n  }\n  setEmotion(e) { this.emotion = EMOTIONS[e] ? e : 'neutral'; }\n  /** A syllable just played. */\n  syllable() { this.open = 1; }\n  setFocus(on) { this.leanTo = on ? 1 : 0; this.dimTo = on ? 1 : 0.42; }\n  pose() {\n    const c = this.cur;\n    const rb = (c.brow * Math.PI) / 180;\n    this.browL.rotation.z = -0.24 - rb;\n    this.browR.rotation.z = 0.24 + rb;\n    this.browL.position.y = this.browY0 + c.browY;\n    this.browR.position.y = this.browY0 + c.browY;\n  }\n  update(dt) {\n    this.t += dt;\n    const target = EMOTIONS[this.emotion];\n    const k = Math.min(1, dt * 12);\n    for (const key of ['brow', 'browY', 'lid', 'tilt', 'nod']) this.cur[key] += (target[key] - this.cur[key]) * k;\n    this.pose();\n    // Mouth follows syllables.\n    this.open = Math.max(0, this.open - dt * 7);\n    const sx = target.mouth[0], sy = target.mouth[1] + this.open * 2.4;\n    this.mouth.scale.set(sx, sy, 1);\n    // Blinks every 2 to 5 s.\n    this.blinkIn -= dt;\n    if (this.blinkIn <= 0) { this.blinkT = 0.12; this.blinkIn = 2 + Math.random() * 3; }\n    this.blinkT = Math.max(0, this.blinkT - dt);\n    const lid = this.blinkT > 0 ? 1 : this.cur.lid;\n    this.lidL.scale.y = 0.01 + lid * 1.6;\n    this.lidR.scale.y = 0.01 + lid * 1.6;\n    const pup = target.pupil ?? 1;\n    this.pupilL.scale.set(pup, pup, 1);\n    this.pupilR.scale.set(pup, pup, 1);\n    // Sway, tilt, lean.\n    this.lean += (this.leanTo - this.lean) * Math.min(1, dt * 7);\n    this.head.rotation.z = Math.sin(this.t * 0.8) * 0.015 + this.cur.tilt;\n    this.head.rotation.x = this.cur.nod + Math.sin(this.t * 0.6) * 0.012 + this.lean * 0.02;\n    this.head.position.y = 1.62 + Math.sin(this.t * 1.2) * 0.008;\n    this.object.position.z = (this.baseZ ?? 0) + this.lean * 0.3;\n    if (this.sweat) { this.sweat.visible = !!target.sweat; this.sweat.position.y = this.sweatY0 - ((this.t * 0.5) % 0.3); }\n    if (this.blush) this.blush.visible = !!target.blush;\n    if (this.tear) { this.tear.visible = !!target.tear; this.tear.position.y = this.tearY0 - ((this.t * 0.35) % 0.35); }\n    if (this.glint) this.glint.visible = Math.sin(this.t * 1.3) > 0.92;\n    // Dim whoever isn't speaking.\n    this.dim += (this.dimTo - this.dim) * Math.min(1, dt * 7);\n    if (Math.abs(this.dim - this.lastDim) > 0.005) {\n      this.lastDim = this.dim;\n      for (const m of this.meshes) m.material.color.copy(m.userData.base).multiplyScalar(this.dim);\n    }\n  }\n}\nEOF\ncat > src/content/lines.js <<'EOF'\n// Reaction pools: barks in surgery, chosen by the comm director. Short and breathless.\nexport const LINES = {\n  reyes: {\n    mistake: [\"That was a person's. You will want to not do that.\", 'Doctor. *Doctor.* Eyes on the patient.', 'I have seen sharper work from the vending machine.', \"He's losing blood faster than this hospital loses money. *Drain it.*\", 'Did you practise on anything first? Fruit, perhaps?', \"That's a mistake. I am writing it down. In pen.\"],\n    clean: ['...Adequate.', \"...Adequate. Don't let it go to your head. It's not attached to anything useful.\", 'Hm.', 'Again. Exactly like that.', 'Do not look so pleased. Keep going.', 'Somebody taught you something. Who was it, so I can thank them.'],\n    lowVitals: ['*Vitals!* Doctor, look at the monitor!', 'Syringe! Now! Quickly, Doctor!', 'He is going. He is going, Doctor!', 'If you are praying, pray with your hands.'],\n    wrongTool: ['Wrong instrument, Doctor. That needs the *{want}*.', 'The *{want}*. It is on the wheel. It has always been on the wheel.', 'You are holding that wrong. And it is the wrong thing. *{want}.*'],\n    doseWasted: ['In the ring. The *ring*, Doctor. That was somebody\\'s dose.', 'You just gave the drape a sedative.'],\n    noDose: ['There are no more doses. There is only you.'],\n    knock: ['It knocked. Do not you dare knock back.', 'There. It is surfacing!'],\n    giftDenied: ['You are out of composure. I can tell from here.'],\n  },\n  sabine: {\n    mistake: ['I saw that.', 'That will be in the report.', 'Show your work. Not that work.'],\n    clean: ['Acceptable.', 'Hm. Continue.', 'Adequate.'],\n    lowVitals: ['You are losing him. I am telling you, not asking.', 'Stabilise. Then we can discuss your hands.'],\n    wrongTool: ['The *{want}*, Doctor.'],\n    doseWasted: ['That was wasteful.'],\n    noDose: ['No doses left. Interesting.'],\n    knock: [\"Don't answer it until you're ready.\"],\n    giftDenied: ['You have not earned that yet.'],\n  },\n  pem: {\n    lowVitals: ['Vitals are in the basement. I would take the stairs, Doctor.', 'Patient is going under, and I mean further than I put him.'],\n  },\n};\nexport const SPEAKER_NAMES = { ilya: 'DR. MARSH', reyes: 'NURSE REYES', sabine: 'DR. ACHTERBERG', bram: 'CHIEF BRAM', pem: 'DR. OKOYE', hesper: 'DR. LINDQVIST', tomasz: 'MR. DOLAN', zamboni: 'THE GREAT ZAMBONI', anselm: 'MR. ANSELM', ottilie: 'OTTILIE', ollie: 'OLLIE' };\nexport const TOOL_NAMES = { scalpel: 'SCALPEL', forceps: 'FORCEPS', suture: 'SUTURE', drain: 'DRAIN', syringe: 'SYRINGE', gel: 'GEL', laser: 'LASER', scanner: 'SCANNER', dressing: 'DRESSING', marker: 'MOVE' };\nEOF\ncat > src/ui/ophud.js <<'EOF'\n// The operation HUD: top strip with vitals, EKG, clock and composure; comm strip below; the tool wheel;\n// rating pop-ups; the paddles and the massage. Anchored to hud.width/height, which vary.\nimport { TOOL_ICONS } from '../content/icons.js';\nimport { SPEAKER_NAMES, TOOL_NAMES } from '../content/lines.js';\nimport { TOOLS } from '../sim/entities.js';\nimport { ZONE_CENTER } from '../sim/op.js';\n\nconst fmt = (t) => { const s = Math.max(0, Math.ceil(t)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };\nconst vitalColor = (v) => (v < 15 ? 'red' : v < 30 ? 'orange' : v < 50 ? 'sand' : 'lime');\n\nexport class Ekg {\n  constructor(n = 90) { this.n = n; this.buf = new Array(n).fill(0); this.head = 0; this.phase = 0; this.acc = 0; this.flat = false; }\n  /** rate in beats/s; jitter 0..1 */\n  update(dt, rate, jitter = 0, flat = false) {\n    this.acc += dt * 60;\n    while (this.acc >= 1) {\n      this.acc -= 1;\n      this.phase += (rate / 60);\n      if (this.phase >= 1) this.phase -= 1;\n      const p = this.phase;\n      let y = 0;\n      if (!flat) {\n        if (p < 0.08) y = Math.sin((p / 0.08) * Math.PI) * 1.4;\n        else if (p > 0.14 && p < 0.17) y = -1.6;\n        else if (p >= 0.17 && p < 0.21) y = 7 * Math.sin(((p - 0.17) / 0.04) * Math.PI);\n        else if (p >= 0.21 && p < 0.25) y = -2.2;\n        else if (p > 0.34 && p < 0.46) y = Math.sin(((p - 0.34) / 0.12) * Math.PI) * 2;\n        if (jitter) y += Math.sin(this.head * 3.1) * jitter * 2.2;\n      }\n      this.buf[this.head] = y;\n      this.head = (this.head + 1) % this.n;\n    }\n  }\n  draw(ui, x, y, color) {\n    for (let i = 0; i < this.n; i++) {\n      const k = (this.head + i) % this.n;\n      const v = Math.round(this.buf[k]);\n      const age = i / this.n;\n      ui.rect(x + i, y - v, 1, 1 + (Math.abs(v) > 2 ? Math.abs(v - Math.round(this.buf[(k + 1) % this.n])) : 0), age < 0.25 ? 'slate' : color);\n    }\n  }\n}\n\nexport class OpHud {\n  constructor(app) {\n    this.app = app;\n    this.popups = [];\n    this.ekg = new Ekg(82);\n    this.tabEkgs = [new Ekg(30), new Ekg(30), new Ekg(30)];\n    this.stampMsg = null;\n    this.bannerT = 0;\n    this.banner = null;\n    this.reminderT = 0;\n    this.wheelHitBoxes = [];\n  }\n\n  popup(text, x, y, color, scale = 2, life = 0.8) {\n    this.popups.push({ text, x, y, color, scale, life, t: 0 });\n    if (this.popups.length > 8) this.popups.shift();\n  }\n  setBanner(text, color = 'white', t = 1.6) { this.banner = { text, color }; this.bannerT = t; }\n\n  draw(ui, st, o, dt) {\n    const w = ui.w, h = ui.h;\n    const app = this.app;\n    const table = st.tables[o.table ?? 0];\n    const multi = st.tables.length > 1;\n    const v = o.vitalsShown;\n    // Top strip.\n    ui.rect(0, 0, w, 20, 'ink');\n    ui.rect(0, 20, w, 1, 'slate');\n    ui.text(4, 2, 'VITALS', { color: 'mist', shadow: false });\n    if (multi) {\n      // Three monitors, clickable tabs.\n      const tabW = Math.min(64, (w * 0.5 - 40) / 3);\n      this.tabs = [];\n      st.tables.forEach((t, i) => {\n        const x = 4 + i * (tabW + 3);\n        const on = i === table.i;\n        ui.rect(x, 1, tabW, 18, on ? 'navy' : 'night');\n        ui.outline(x, 1, tabW, 18, on ? 'sand' : 'slate');\n        const shown = Math.round(t.fake ?? t.vitals);\n        ui.text(x + 3, 3, t.name ?? 'ABC'[i], { color: on ? 'sand' : 'mist', shadow: false });\n        ui.text(x + tabW - 15, 3, String(shown).padStart(2, '0'), { color: vitalColor(shown), shadow: false });\n        ui.rect(x + 3, 13, tabW - 6, 3, 'ink');\n        ui.rect(x + 3, 13, Math.round(((tabW - 6) * shown) / 99), 3, vitalColor(shown));\n        this.tabs.push({ x, y: 1, w: tabW, h: 18, i });\n      });\n    } else {\n      this.tabs = null;\n      ui.text(42, 3, String(Math.round(v)).padStart(2, '0'), { color: vitalColor(v), scale: 2, shadow: false });\n      this.ekg.draw(ui, 74, 11, st.codeBlue ? 'red' : vitalColor(v));\n      if (st.heart && !st.heart.calm) ui.text(74, 2, `${Math.round(st.heart.bpm)} BPM`, { color: st.heart.systole ? 'red' : 'lime', shadow: false });\n    }\n    // Clock, centre.\n    const clockStr = fmt(st.clock);\n    ui.center(3, clockStr, { color: st.clock < 30 ? 'red' : 'white', scale: 2, shadow: false });\n    // Mistakes.\n    const maxM = st.cfgMaxMistakes ?? app.config.maxMistakes;\n    if (maxM > 0) {\n      const mx = w / 2 + 28;\n      for (let i = 0; i < maxM; i++) {\n        const filled = i < st.mistakes;\n        ui.rect(mx + i * 7, 7, 5, 5, filled ? 'red' : 'night');\n        ui.outline(mx + i * 7, 7, 5, 5, filled ? 'white' : 'slate');\n      }\n    }\n    // Composure.\n    if (st.giftsUnlocked) {\n      const barW = 70;\n      const bx = w - barW - 6;\n      const seat = st.seats[o.seatIndex ?? 0];\n      const gift = seat?.gift;\n      const label = gift === 'look' ? 'SECOND LOOK' : 'THE QUIET';\n      ui.right(w - 6, 2, label, { color: st.quiet ? 'cyan' : 'mist', shadow: false });\n      ui.rect(bx, 11, barW, 6, 'night');\n      const cost = gift === 'look' ? app.config.secondLookCost : 20;\n      ui.rect(bx, 11, Math.round((barW * st.composure) / 100), 6, st.composure >= cost ? 'cyan' : 'slate');\n      ui.rect(bx + Math.round((barW * cost) / 100), 10, 1, 8, 'white');\n      ui.outline(bx, 11, barW, 6, 'mist');\n      if (st.composure >= cost) ui.action(bx - ui.actionWidth('gift') - 3, 9, 'gift');\n    }\n    // Cold-time bar (Op 6).\n    if (st.cold != null) {\n      const cw = 96, cx = (w - cw) / 2, cy = 24;\n      ui.rect(cx, cy, cw, 9, 'navy');\n      ui.rect(cx, cy, Math.round((cw * st.cold) / 120), 9, st.cold < 30 ? 'red' : 'sky');\n      ui.outline(cx, cy, cw, 9, 'white');\n      ui.center(cy + 1, `ICE ${fmt(st.cold)}`, { color: 'white', shadow: 'ink' });\n    }\n    this.drawWheels(ui, st, o);\n    this.drawComm(ui, st, o);\n    this.drawHint(ui, st, o);\n    this.drawCursorHud(ui, st, o);\n    // Pop-ups.\n    for (let i = this.popups.length - 1; i >= 0; i--) {\n      const p = this.popups[i];\n      p.t += dt;\n      if (p.t >= p.life) { this.popups.splice(i, 1); continue; }\n      const k = p.t / p.life;\n      const yy = p.y - 8 - k * 12;\n      const m = ui.hud.measure(p.text, p.scale);\n      ui.text(Math.max(2, Math.min(w - m.width - 2, p.x - m.width / 2)), Math.max(22, yy), p.text, { color: p.color, scale: p.scale });\n    }\n    // Banner.\n    if (this.bannerT > 0) {\n      this.bannerT -= dt;\n      ui.center(h * 0.34, this.banner.text, { color: this.banner.color, scale: 3 });\n    }\n    // Big prompt.\n    if (st.prompt) {\n      const lines = ui.wrap(st.prompt.text, w - 60);\n      const by = h * 0.16;\n      ui.rect(20, by - 4, w - 40, lines.length * 11 + 8, 'ink');\n      ui.outline(20, by - 4, w - 40, lines.length * 11 + 8, 'cyan');\n      lines.forEach((l, i) => ui.richCenter(by + i * 11, l, { color: 'cyan' }));\n    }\n    if (this.reminderT > 0) {\n      this.reminderT -= dt;\n      const lines = ui.wrap(st.objective || '', w - 60);\n      const by = h * 0.25;\n      ui.rect(20, by - 4, w - 40, lines.length * 11 + 8, 'night');\n      ui.outline(20, by - 4, w - 40, lines.length * 11 + 8, 'sand');\n      lines.forEach((l, i) => ui.richCenter(by + i * 11, l, { color: 'sand' }));\n    }\n    if (st.codeBlue) this.drawCodeBlue(ui, st);\n    if (st.massage) this.drawMassage(ui, st);\n    if (st.quiet) {\n      ui.rect(0, 21, w, 6, 'ink');\n      ui.center(29, 'THE QUIET', { color: 'cyan' });\n    }\n    if (st.ghostPlay && !o.net) ui.center(29, 'THE SECOND LOOK', { color: 'white' });\n    if (o.coachHints) this.drawCoach(ui, st, o);\n  }\n\n  drawWheels(ui, st, o) {\n    this.wheelHitBoxes.length = 0;\n    const seats = o.seats;\n    const solo = seats.length === 1;\n    const corners = [[ui.w - 52, ui.h - 56], [4, ui.h - 56], [ui.w - 52, 24], [4, 24]];\n    seats.forEach((sv, i) => {\n      if (sv.gone) return;\n      const [x, y] = corners[sv.corner ?? i];\n      this.wheel(ui, x, y, st, sv, solo || sv.showWheel);\n    });\n    // Doses.\n    const sv = seats[0];\n    if (st.tools.includes('syringe')) {\n      const x = ui.w - 74, y = ui.h - 42;\n      ui.hud.sprite(x, y, TOOL_ICONS.syringe.rows, TOOL_ICONS.syringe.c);\n      ui.text(x + 2, y + 13, `x${st.doses}`, { color: st.doses ? 'white' : 'red' });\n      ui.action(x + 1, y - 11, 'syringe');\n    }\n    void sv;\n  }\n  wheel(ui, x, y, st, sv, full) {\n    const seat = st.seats.find((s) => s.id === sv.id);\n    const cx = x + 24, cy = y + 24;\n    const tool = sv.tool ?? seat?.tool;\n    const R = 19;\n    ui.rect(x + 4, y + 4, 40, 40, 'ink');\n    ui.outline(x + 4, y + 4, 40, 40, sv.color ?? 'slate');\n    if (full || sv.wheelOpen) {\n      TOOLS.forEach((t, i) => {\n        const a = (i / 8) * Math.PI * 2 - Math.PI / 2;\n        const px = Math.round(cx + Math.cos(a) * R - 6), py = Math.round(cy + Math.sin(a) * R - 6);\n        const on = st.tools.includes(t);\n        if (!on) { ui.rect(px + 4, py + 4, 4, 4, 'night'); return; }\n        const sel = t === tool;\n        if (sel) ui.rect(px - 1, py - 1, 14, 14, 'sand');\n        else ui.rect(px - 1, py - 1, 14, 14, 'night');\n        ui.hud.sprite(px, py, TOOL_ICONS[t].rows, TOOL_ICONS[t].c);\n        this.wheelHitBoxes.push({ x: px - 1, y: py - 1, w: 14, h: 14, tool: t, seat: sv.id });\n      });\n    }\n    // The current tool, big in the centre.\n    const shown = st.context && seat ? st.context : tool;\n    const ic = TOOL_ICONS[shown] ?? TOOL_ICONS[tool];\n    if (ic) ui.hud.sprite(cx - 6, cy - 6, ic.rows, ic.c);\n    if (sv.showLabel !== false) {\n      const label = TOOL_NAMES[shown] ?? '';\n      ui.right(x + 46, y + 44 + 1, label, { color: 'sand' });\n    }\n  }\n\n  drawComm(ui, st, o) {\n    const w = ui.w, h = ui.h;\n    const c = o.comm;\n    const stripH = 32;\n    const y = h - stripH;\n    const bust = 38;\n    const rightPad = 56;\n    // The bust's window is left open: a real 3D head sits there.\n    ui.rect(bust, y, w - bust, stripH, 'ink');\n    ui.rect(0, y, w, 1, 'slate');\n    ui.outline(0, y, bust, stripH, 'slate');\n    const tx = bust + 5;\n    const lineW = w - tx - rightPad - 4;\n    if (c?.line) {\n      ui.text(tx, y + 3, SPEAKER_NAMES[c.line.who] ?? c.line.who.toUpperCase(), { color: 'sand', shadow: false });\n      const lines = c.wrapped ?? (c.wrapped = ui.wrap(c.line.text, lineW));\n      let left = c.chars;\n      lines.slice(0, 2).forEach((l, i) => {\n        ui.rich(tx, y + 13 + i * 9, l, { chars: left, hi: 'orange', shadow: false });\n        left -= l.replace(/\\*/g, '').length + 1;\n      });\n    } else if (o.noSignal) {\n      const on = Math.sin((o.t ?? 0) * 3) > -0.2;\n      ui.text(tx, y + 12, 'NO SIGNAL', { color: on ? 'red' : 'plum', scale: 2, shadow: false });\n    } else if (st.objective) {\n      ui.text(tx, y + 3, 'OBJECTIVE', { color: 'slate', shadow: false });\n      const lines = ui.wrap(st.objective, lineW);\n      lines.slice(0, 2).forEach((l, i) => ui.rich(tx, y + 13 + i * 9, l, { color: 'mist', shadow: false }));\n    }\n  }\n\n  drawHint(ui, st, o) {\n    if (!o.hint) return;\n    const p = o.hint;\n    const k = Math.sin((o.t ?? 0) * 5) * 2;\n    const x = Math.round(p.sx), y = Math.round(p.sy - 14 + k);\n    for (let d = 0; d < 5; d++) {\n      ui.rect(x - d, y - 4 + d, d * 2 + 1, 1, 'sand');\n      ui.rect(x - d, y + 4 - d, d * 2 + 1, 1, 'sand');\n    }\n    ui.rect(x - 1, y - 1, 3, 3, 'white');\n    if (p.tool && p.tool !== p.have && TOOL_ICONS[p.tool]) {\n      ui.rect(x + 7, y - 7, 14, 14, 'ink');\n      ui.outline(x + 7, y - 7, 14, 14, Math.sin((o.t ?? 0) * 8) > 0 ? 'sand' : 'white');\n      ui.hud.sprite(x + 8, y - 6, TOOL_ICONS[p.tool].rows, TOOL_ICONS[p.tool].c);\n    }\n  }\n\n  drawCursorHud(ui, st, o) {\n    for (const r of o.reticles ?? []) {\n      const x = Math.round(r.sx), y = Math.round(r.sy);\n      const c = r.color ?? (r.on ? 'lime' : 'white');\n      const R = r.use ? 3 : 5;\n      ui.rect(x - R - 2, y, 3, 1, c); ui.rect(x + R, y, 3, 1, c); ui.rect(x, y - R - 2, 1, 3, c); ui.rect(x, y + R, 1, 3, c);\n      if (r.label) ui.text(x + 8, y - 12, r.label, { color: c });\n      if (r.beatRing != null) {\n        const n = 20;\n        const rr = 12 + Math.round(r.beatRing * 6);\n        for (let i = 0; i < n; i += 1) {\n          const a = (i / n) * Math.PI * 2;\n          ui.rect(Math.round(x + Math.cos(a) * rr), Math.round(y + Math.sin(a) * rr), 1, 1, r.beatBad ? 'red' : 'lime');\n        }\n      }\n      if (r.draw > 0) {\n        const bw = 22;\n        ui.rect(x - bw / 2, y + 11, bw, 3, 'ink');\n        ui.rect(x - bw / 2, y + 11, Math.round(bw * Math.min(1, r.draw / 0.45)), 3, r.draw >= 0.45 ? 'cyan' : 'mist');\n      }\n    }\n  }\n\n  drawCoach(ui, st) {\n    const list = [['use', 'USE']];\n    if (st.tools.length > 1) list.push(['tool', 'TOOL']);\n    list.push(['steady', 'STEADY']);\n    ui.hints(list, ui.h - 44, 'left');\n  }\n\n  drawCodeBlue(ui, st) {\n    const cb = st.codeBlue;\n    const w = ui.w, h = ui.h;\n    const pw = Math.min(280, w - 40), ph = 78;\n    const x = (w - pw) / 2, y = h * 0.28;\n    ui.rect(x + 2, y + 2, pw, ph, 'ink');\n    ui.rect(x, y, pw, ph, 0x2a0a18);\n    ui.outline(x, y, pw, ph, 'red', 2);\n    ui.center(y + 6, cb.fib ? 'FIBRILLATION' : 'CODE BLUE', { color: 'red', scale: 2, shadow: false });\n    const gx = x + 14, gw = pw - 28, gy = y + 28;\n    ui.rect(gx, gy, gw, 12, 'ink');\n    const zw = st.cfgZone ?? this.app.config.codeBlueZone;\n    ui.rect(gx + Math.round((ZONE_CENTER - zw / 2) * gw), gy, Math.round(zw * gw), 12, 'green');\n    ui.outline(gx, gy, gw, 12, 'white');\n    const nx = gx + Math.round(cb.charge * gw);\n    ui.rect(nx - 1, gy - 3, 3, 18, cb.charging ? 'white' : 'mist');\n    // Shocks needed.\n    for (let i = 0; i < cb.need; i++) { ui.rect(gx + i * 12, gy + 17, 9, 6, i < cb.shocks ? 'lime' : 'night'); ui.outline(gx + i * 12, gy + 17, 9, 6, 'white'); }\n    ui.right(gx + gw, gy + 16, `${Math.max(0, cb.t).toFixed(1)}S`, { color: cb.t < 4 ? 'red' : 'white', shadow: false });\n    const label = cb.charging ? 'RELEASE IN THE GREEN!' : 'HOLD ';\n    const lw = ui.hud.measure(label, 1).width + (cb.charging ? 0 : ui.actionWidth('paddles') + 26);\n    let lx = (w - lw) / 2;\n    const ly = y + ph - 13;\n    ui.text(lx, ly, label, { color: 'white', shadow: false });\n    if (!cb.charging) {\n      lx += ui.hud.measure(label, 1).width;\n      lx += ui.action(lx, ly - 1, 'paddles') + 3;\n      ui.text(lx, ly, 'BOTH', { color: 'white', shadow: false });\n    }\n  }\n\n  drawMassage(ui, st) {\n    const m = st.massage;\n    const w = ui.w, h = ui.h;\n    const y = h * 0.3;\n    ui.center(y - 16, 'MASSAGE', { color: 'red', scale: 2 });\n    const beat = 1 - Math.min(m.phase, m.period - m.phase) / (m.period / 2);\n    const R = 8 + Math.round(beat * 8);\n    const cx = w / 2, cy = y + 18;\n    for (let i = 0; i < 28; i++) {\n      const a = (i / 28) * 6.283;\n      ui.rect(Math.round(cx + Math.cos(a) * R), Math.round(cy + Math.sin(a) * R), 2, 2, beat > 0.6 ? 'lime' : 'mist');\n    }\n    const wantA = m.next === 'a';\n    ui.action(cx - 44 - ui.actionWidth('left') / 2, cy - 4, wantA ? 'left' : 'left');\n    if (wantA) ui.outline(cx - 48 - ui.actionWidth('left') / 2, cy - 8, ui.actionWidth('left') + 8, 17, 'sand');\n    ui.action(cx + 44 - ui.actionWidth('right') / 2, cy - 4, 'right');\n    if (!wantA) ui.outline(cx + 40 - ui.actionWidth('right') / 2, cy - 8, ui.actionWidth('right') + 8, 17, 'sand');\n    for (let i = 0; i < m.need; i++) { ui.rect(cx - (m.need * 7) / 2 + i * 7, cy + 22, 5, 5, i < m.n ? 'lime' : 'night'); ui.outline(cx - (m.need * 7) / 2 + i * 7, cy + 22, 5, 5, 'white'); }\n  }\n}\nEOF\necho ok","description":"Write bust rig, reaction lines and operation HUD"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15040,"cache_read_input_tokens":387106,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15040},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"cdef0fbb-6c0a-49f9-8143-7964d15c5987","timestamp":"2026-11-05T15:57:51.732Z","request_id":"req_011Cgk44seStcEEY11b2123P","wire_tool_inputs":{"toolu_01QAn5D6UDJHQ1U1hoeNvFSr":{"command":"cat > src/view/bust.js <<'EOF'\n// The anime talking head: a real 3D bust with pivots for head, mouth, brows and lids, and an emotion\n// pose table per character. The same models talk in story scenes and, tiny, on the comm strip.\nimport { buildModel, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { BUSTS } from '../content/models/cast.js';\n\nconst SKIN = {\n  ilya: { skin: 0xf2c9a2, skin2: 0xd69e78 }, reyes: { skin: 0xc58a5c, skin2: 0xa26c42 }, sabine: { skin: 0xf3d8c4, skin2: 0xd2ad96 }, bram: { skin: 0xf0c8aa, skin2: 0xd4a084 }, pem: { skin: 0x7c4c34, skin2: 0x5c3624 }, hesper: { skin: 0xf6e4d6, skin2: 0xd8c2b2 },\n  tomasz: { skin: 0xc98f62, skin2: 0xa06c44 }, ottilie: { skin: 0xf0cdb0, skin2: 0xd4a88a }, ollie: { skin: 0xf4d0b0, skin2: 0xd8a888 }, zamboni: { skin: 0xf0cda8, skin2: 0xd2a684 }, anselm: { skin: 0xe6bc94, skin2: 0xc49870 },\n};\n\n// Brow rotation (degrees, positive: inner end down, angry) and height; lid 0 open..1 shut; mouth w,h; head tilt.\nexport const EMOTIONS = {\n  neutral: { brow: 0, browY: 0, lid: 0.12, mouth: [1, 1], tilt: 0, nod: 0 },\n  stern: { brow: 14, browY: -0.02, lid: 0.3, mouth: [0.9, 0.7], tilt: 0, nod: 0.05 },\n  shock: { brow: -16, browY: 0.07, lid: 0, mouth: [0.8, 3], tilt: 0, nod: -0.08, pupil: 0.7 },\n  sad: { brow: -20, browY: 0.02, lid: 0.45, mouth: [0.8, 0.7], tilt: 0.05, nod: 0.12, tear: true },\n  smile: { brow: -6, browY: 0.02, lid: 0.2, mouth: [1.4, 1.5], tilt: -0.04, nod: 0, blush: false },\n  angry: { brow: 26, browY: -0.04, lid: 0.22, mouth: [1.2, 2], tilt: 0, nod: 0.08 },\n  panic: { brow: -22, browY: 0.08, lid: 0, mouth: [1.2, 2.6], tilt: 0.06, nod: -0.04, sweat: true, pupil: 0.65 },\n  blush: { brow: -6, browY: 0.02, lid: 0.3, mouth: [0.8, 0.9], tilt: 0.05, nod: 0.1, blush: true, sweat: false },\n};\n\nexport class BustRig {\n  constructor(ctx, who, o = {}) {\n    this.who = BUSTS[who] ? who : 'ilya';\n    const b = buildModel(BUSTS[this.who], { palette: SKIN[this.who] ?? {} });\n    this.object = b.object;\n    this.meshes = [];\n    this.object.traverse((m) => {\n      if (m.isMesh) {\n        m.receiveShadow = false;\n        m.castShadow = false;\n        m.material = m.material.clone();\n        m.material.userData = { ...m.material.userData, shared: false };\n        m.userData.base = m.material.color.clone();\n        this.meshes.push(m);\n      }\n    });\n    const get = (n) => this.object.getObjectByName(n);\n    this.head = get('head');\n    this.mouth = get('mouth');\n    this.browL = get('browL');\n    this.browR = get('browR');\n    this.lidL = get('lidL');\n    this.lidR = get('lidR');\n    this.pupilL = get('pupilL');\n    this.pupilR = get('pupilR');\n    this.sweat = get('sweat');\n    this.blush = get('blush');\n    this.tear = get('tear');\n    this.glint = get('glint');\n    if (this.sweat) this.sweat.visible = false;\n    if (this.blush) this.blush.visible = false;\n    if (this.tear) this.tear.visible = false;\n    setLookLayer(this.object, 'actors');\n    this.browY0 = this.browL.position.y;\n    this.lidY0 = this.lidL.position.y;\n    this.tearY0 = this.tear?.position.y ?? 0;\n    this.sweatY0 = this.sweat?.position.y ?? 0;\n    this.t = Math.random() * 9;\n    this.emotion = 'neutral';\n    this.cur = { ...EMOTIONS.neutral };\n    this.open = 0;\n    this.blinkIn = 2 + Math.random() * 3;\n    this.blinkT = 0;\n    this.lean = 0;\n    this.leanTo = 0;\n    this.dim = 1;\n    this.dimTo = 1;\n    this.lastDim = -1;\n    this.pose();\n    if (o.parent) o.parent.add(this.object);\n  }\n  setEmotion(e) { this.emotion = EMOTIONS[e] ? e : 'neutral'; }\n  /** A syllable just played. */\n  syllable() { this.open = 1; }\n  setFocus(on) { this.leanTo = on ? 1 : 0; this.dimTo = on ? 1 : 0.42; }\n  pose() {\n    const c = this.cur;\n    const rb = (c.brow * Math.PI) / 180;\n    this.browL.rotation.z = -0.24 - rb;\n    this.browR.rotation.z = 0.24 + rb;\n    this.browL.position.y = this.browY0 + c.browY;\n    this.browR.position.y = this.browY0 + c.browY;\n  }\n  update(dt) {\n    this.t += dt;\n    const target = EMOTIONS[this.emotion];\n    const k = Math.min(1, dt * 12);\n    for (const key of ['brow', 'browY', 'lid', 'tilt', 'nod']) this.cur[key] += (target[key] - this.cur[key]) * k;\n    this.pose();\n    // Mouth follows syllables.\n    this.open = Math.max(0, this.open - dt * 7);\n    const sx = target.mouth[0], sy = target.mouth[1] + this.open * 2.4;\n    this.mouth.scale.set(sx, sy, 1);\n    // Blinks every 2 to 5 s.\n    this.blinkIn -= dt;\n    if (this.blinkIn <= 0) { this.blinkT = 0.12; this.blinkIn = 2 + Math.random() * 3; }\n    this.blinkT = Math.max(0, this.blinkT - dt);\n    const lid = this.blinkT > 0 ? 1 : this.cur.lid;\n    this.lidL.scale.y = 0.01 + lid * 1.6;\n    this.lidR.scale.y = 0.01 + lid * 1.6;\n    const pup = target.pupil ?? 1;\n    this.pupilL.scale.set(pup, pup, 1);\n    this.pupilR.scale.set(pup, pup, 1);\n    // Sway, tilt, lean.\n    this.lean += (this.leanTo - this.lean) * Math.min(1, dt * 7);\n    this.head.rotation.z = Math.sin(this.t * 0.8) * 0.015 + this.cur.tilt;\n    this.head.rotation.x = this.cur.nod + Math.sin(this.t * 0.6) * 0.012 + this.lean * 0.02;\n    this.head.position.y = 1.62 + Math.sin(this.t * 1.2) * 0.008;\n    this.object.position.z = (this.baseZ ?? 0) + this.lean * 0.3;\n    if (this.sweat) { this.sweat.visible = !!target.sweat; this.sweat.position.y = this.sweatY0 - ((this.t * 0.5) % 0.3); }\n    if (this.blush) this.blush.visible = !!target.blush;\n    if (this.tear) { this.tear.visible = !!target.tear; this.tear.position.y = this.tearY0 - ((this.t * 0.35) % 0.35); }\n    if (this.glint) this.glint.visible = Math.sin(this.t * 1.3) > 0.92;\n    // Dim whoever isn't speaking.\n    this.dim += (this.dimTo - this.dim) * Math.min(1, dt * 7);\n    if (Math.abs(this.dim - this.lastDim) > 0.005) {\n      this.lastDim = this.dim;\n      for (const m of this.meshes) m.material.color.copy(m.userData.base).multiplyScalar(this.dim);\n    }\n  }\n}\nEOF\ncat > src/content/lines.js <<'EOF'\n// Reaction pools: barks in surgery, chosen by the comm director. Short and breathless.\nexport const LINES = {\n  reyes: {\n    mistake: [\"That was a person's. You will want to not do that.\", 'Doctor. *Doctor.* Eyes on the patient.', 'I have seen sharper work from the vending machine.', \"He's losing blood faster than this hospital loses money. *Drain it.*\", 'Did you practise on anything first? Fruit, perhaps?', \"That's a mistake. I am writing it down. In pen.\"],\n    clean: ['...Adequate.', \"...Adequate. Don't let it go to your head. It's not attached to anything useful.\", 'Hm.', 'Again. Exactly like that.', 'Do not look so pleased. Keep going.', 'Somebody taught you something. Who was it, so I can thank them.'],\n    lowVitals: ['*Vitals!* Doctor, look at the monitor!', 'Syringe! Now! Quickly, Doctor!', 'He is going. He is going, Doctor!', 'If you are praying, pray with your hands.'],\n    wrongTool: ['Wrong instrument, Doctor. That needs the *{want}*.', 'The *{want}*. It is on the wheel. It has always been on the wheel.', 'You are holding that wrong. And it is the wrong thing. *{want}.*'],\n    doseWasted: ['In the ring. The *ring*, Doctor. That was somebody\\'s dose.', 'You just gave the drape a sedative.'],\n    noDose: ['There are no more doses. There is only you.'],\n    knock: ['It knocked. Do not you dare knock back.', 'There. It is surfacing!'],\n    giftDenied: ['You are out of composure. I can tell from here.'],\n  },\n  sabine: {\n    mistake: ['I saw that.', 'That will be in the report.', 'Show your work. Not that work.'],\n    clean: ['Acceptable.', 'Hm. Continue.', 'Adequate.'],\n    lowVitals: ['You are losing him. I am telling you, not asking.', 'Stabilise. Then we can discuss your hands.'],\n    wrongTool: ['The *{want}*, Doctor.'],\n    doseWasted: ['That was wasteful.'],\n    noDose: ['No doses left. Interesting.'],\n    knock: [\"Don't answer it until you're ready.\"],\n    giftDenied: ['You have not earned that yet.'],\n  },\n  pem: {\n    lowVitals: ['Vitals are in the basement. I would take the stairs, Doctor.', 'Patient is going under, and I mean further than I put him.'],\n  },\n};\nexport const SPEAKER_NAMES = { ilya: 'DR. MARSH', reyes: 'NURSE REYES', sabine: 'DR. ACHTERBERG', bram: 'CHIEF BRAM', pem: 'DR. OKOYE', hesper: 'DR. LINDQVIST', tomasz: 'MR. DOLAN', zamboni: 'THE GREAT ZAMBONI', anselm: 'MR. ANSELM', ottilie: 'OTTILIE', ollie: 'OLLIE' };\nexport const TOOL_NAMES = { scalpel: 'SCALPEL', forceps: 'FORCEPS', suture: 'SUTURE', drain: 'DRAIN', syringe: 'SYRINGE', gel: 'GEL', laser: 'LASER', scanner: 'SCANNER', dressing: 'DRESSING', marker: 'MOVE' };\nEOF\ncat > src/ui/ophud.js <<'EOF'\n// The operation HUD: top strip with vitals, EKG, clock and composure; comm strip below; the tool wheel;\n// rating pop-ups; the paddles and the massage. Anchored to hud.width/height, which vary.\nimport { TOOL_ICONS } from '../content/icons.js';\nimport { SPEAKER_NAMES, TOOL_NAMES } from '../content/lines.js';\nimport { TOOLS } from '../sim/entities.js';\nimport { ZONE_CENTER } from '../sim/op.js';\n\nconst fmt = (t) => { const s = Math.max(0, Math.ceil(t)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };\nconst vitalColor = (v) => (v < 15 ? 'red' : v < 30 ? 'orange' : v < 50 ? 'sand' : 'lime');\n\nexport class Ekg {\n  constructor(n = 90) { this.n = n; this.buf = new Array(n).fill(0); this.head = 0; this.phase = 0; this.acc = 0; this.flat = false; }\n  /** rate in beats/s; jitter 0..1 */\n  update(dt, rate, jitter = 0, flat = false) {\n    this.acc += dt * 60;\n    while (this.acc >= 1) {\n      this.acc -= 1;\n      this.phase += (rate / 60);\n      if (this.phase >= 1) this.phase -= 1;\n      const p = this.phase;\n      let y = 0;\n      if (!flat) {\n        if (p < 0.08) y = Math.sin((p / 0.08) * Math.PI) * 1.4;\n        else if (p > 0.14 && p < 0.17) y = -1.6;\n        else if (p >= 0.17 && p < 0.21) y = 7 * Math.sin(((p - 0.17) / 0.04) * Math.PI);\n        else if (p >= 0.21 && p < 0.25) y = -2.2;\n        else if (p > 0.34 && p < 0.46) y = Math.sin(((p - 0.34) / 0.12) * Math.PI) * 2;\n        if (jitter) y += Math.sin(this.head * 3.1) * jitter * 2.2;\n      }\n      this.buf[this.head] = y;\n      this.head = (this.head + 1) % this.n;\n    }\n  }\n  draw(ui, x, y, color) {\n    for (let i = 0; i < this.n; i++) {\n      const k = (this.head + i) % this.n;\n      const v = Math.round(this.buf[k]);\n      const age = i / this.n;\n      ui.rect(x + i, y - v, 1, 1 + (Math.abs(v) > 2 ? Math.abs(v - Math.round(this.buf[(k + 1) % this.n])) : 0), age < 0.25 ? 'slate' : color);\n    }\n  }\n}\n\nexport class OpHud {\n  constructor(app) {\n    this.app = app;\n    this.popups = [];\n    this.ekg = new Ekg(82);\n    this.tabEkgs = [new Ekg(30), new Ekg(30), new Ekg(30)];\n    this.stampMsg = null;\n    this.bannerT = 0;\n    this.banner = null;\n    this.reminderT = 0;\n    this.wheelHitBoxes = [];\n  }\n\n  popup(text, x, y, color, scale = 2, life = 0.8) {\n    this.popups.push({ text, x, y, color, scale, life, t: 0 });\n    if (this.popups.length > 8) this.popups.shift();\n  }\n  setBanner(text, color = 'white', t = 1.6) { this.banner = { text, color }; this.bannerT = t; }\n\n  draw(ui, st, o, dt) {\n    const w = ui.w, h = ui.h;\n    const app = this.app;\n    const table = st.tables[o.table ?? 0];\n    const multi = st.tables.length > 1;\n    const v = o.vitalsShown;\n    // Top strip.\n    ui.rect(0, 0, w, 20, 'ink');\n    ui.rect(0, 20, w, 1, 'slate');\n    ui.text(4, 2, 'VITALS', { color: 'mist', shadow: false });\n    if (multi) {\n      // Three monitors, clickable tabs.\n      const tabW = Math.min(64, (w * 0.5 - 40) / 3);\n      this.tabs = [];\n      st.tables.forEach((t, i) => {\n        const x = 4 + i * (tabW + 3);\n        const on = i === table.i;\n        ui.rect(x, 1, tabW, 18, on ? 'navy' : 'night');\n        ui.outline(x, 1, tabW, 18, on ? 'sand' : 'slate');\n        const shown = Math.round(t.fake ?? t.vitals);\n        ui.text(x + 3, 3, t.name ?? 'ABC'[i], { color: on ? 'sand' : 'mist', shadow: false });\n        ui.text(x + tabW - 15, 3, String(shown).padStart(2, '0'), { color: vitalColor(shown), shadow: false });\n        ui.rect(x + 3, 13, tabW - 6, 3, 'ink');\n        ui.rect(x + 3, 13, Math.round(((tabW - 6) * shown) / 99), 3, vitalColor(shown));\n        this.tabs.push({ x, y: 1, w: tabW, h: 18, i });\n      });\n    } else {\n      this.tabs = null;\n      ui.text(42, 3, String(Math.round(v)).padStart(2, '0'), { color: vitalColor(v), scale: 2, shadow: false });\n      this.ekg.draw(ui, 74, 11, st.codeBlue ? 'red' : vitalColor(v));\n      if (st.heart && !st.heart.calm) ui.text(74, 2, `${Math.round(st.heart.bpm)} BPM`, { color: st.heart.systole ? 'red' : 'lime', shadow: false });\n    }\n    // Clock, centre.\n    const clockStr = fmt(st.clock);\n    ui.center(3, clockStr, { color: st.clock < 30 ? 'red' : 'white', scale: 2, shadow: false });\n    // Mistakes.\n    const maxM = st.cfgMaxMistakes ?? app.config.maxMistakes;\n    if (maxM > 0) {\n      const mx = w / 2 + 28;\n      for (let i = 0; i < maxM; i++) {\n        const filled = i < st.mistakes;\n        ui.rect(mx + i * 7, 7, 5, 5, filled ? 'red' : 'night');\n        ui.outline(mx + i * 7, 7, 5, 5, filled ? 'white' : 'slate');\n      }\n    }\n    // Composure.\n    if (st.giftsUnlocked) {\n      const barW = 70;\n      const bx = w - barW - 6;\n      const seat = st.seats[o.seatIndex ?? 0];\n      const gift = seat?.gift;\n      const label = gift === 'look' ? 'SECOND LOOK' : 'THE QUIET';\n      ui.right(w - 6, 2, label, { color: st.quiet ? 'cyan' : 'mist', shadow: false });\n      ui.rect(bx, 11, barW, 6, 'night');\n      const cost = gift === 'look' ? app.config.secondLookCost : 20;\n      ui.rect(bx, 11, Math.round((barW * st.composure) / 100), 6, st.composure >= cost ? 'cyan' : 'slate');\n      ui.rect(bx + Math.round((barW * cost) / 100), 10, 1, 8, 'white');\n      ui.outline(bx, 11, barW, 6, 'mist');\n      if (st.composure >= cost) ui.action(bx - ui.actionWidth('gift') - 3, 9, 'gift');\n    }\n    // Cold-time bar (Op 6).\n    if (st.cold != null) {\n      const cw = 96, cx = (w - cw) / 2, cy = 24;\n      ui.rect(cx, cy, cw, 9, 'navy');\n      ui.rect(cx, cy, Math.round((cw * st.cold) / 120), 9, st.cold < 30 ? 'red' : 'sky');\n      ui.outline(cx, cy, cw, 9, 'white');\n      ui.center(cy + 1, `ICE ${fmt(st.cold)}`, { color: 'white', shadow: 'ink' });\n    }\n    this.drawWheels(ui, st, o);\n    this.drawComm(ui, st, o);\n    this.drawHint(ui, st, o);\n    this.drawCursorHud(ui, st, o);\n    // Pop-ups.\n    for (let i = this.popups.length - 1; i >= 0; i--) {\n      const p = this.popups[i];\n      p.t += dt;\n      if (p.t >= p.life) { this.popups.splice(i, 1); continue; }\n      const k = p.t / p.life;\n      const yy = p.y - 8 - k * 12;\n      const m = ui.hud.measure(p.text, p.scale);\n      ui.text(Math.max(2, Math.min(w - m.width - 2, p.x - m.width / 2)), Math.max(22, yy), p.text, { color: p.color, scale: p.scale });\n    }\n    // Banner.\n    if (this.bannerT > 0) {\n      this.bannerT -= dt;\n      ui.center(h * 0.34, this.banner.text, { color: this.banner.color, scale: 3 });\n    }\n    // Big prompt.\n    if (st.prompt) {\n      const lines = ui.wrap(st.prompt.text, w - 60);\n      const by = h * 0.16;\n      ui.rect(20, by - 4, w - 40, lines.length * 11 + 8, 'ink');\n      ui.outline(20, by - 4, w - 40, lines.length * 11 + 8, 'cyan');\n      lines.forEach((l, i) => ui.richCenter(by + i * 11, l, { color: 'cyan' }));\n    }\n    if (this.reminderT > 0) {\n      this.reminderT -= dt;\n      const lines = ui.wrap(st.objective || '', w - 60);\n      const by = h * 0.25;\n      ui.rect(20, by - 4, w - 40, lines.length * 11 + 8, 'night');\n      ui.outline(20, by - 4, w - 40, lines.length * 11 + 8, 'sand');\n      lines.forEach((l, i) => ui.richCenter(by + i * 11, l, { color: 'sand' }));\n    }\n    if (st.codeBlue) this.drawCodeBlue(ui, st);\n    if (st.massage) this.drawMassage(ui, st);\n    if (st.quiet) {\n      ui.rect(0, 21, w, 6, 'ink');\n      ui.center(29, 'THE QUIET', { color: 'cyan' });\n    }\n    if (st.ghostPlay && !o.net) ui.center(29, 'THE SECOND LOOK', { color: 'white' });\n    if (o.coachHints) this.drawCoach(ui, st, o);\n  }\n\n  drawWheels(ui, st, o) {\n    this.wheelHitBoxes.length = 0;\n    const seats = o.seats;\n    const solo = seats.length === 1;\n    const corners = [[ui.w - 52, ui.h - 56], [4, ui.h - 56], [ui.w - 52, 24], [4, 24]];\n    seats.forEach((sv, i) => {\n      if (sv.gone) return;\n      const [x, y] = corners[sv.corner ?? i];\n      this.wheel(ui, x, y, st, sv, solo || sv.showWheel);\n    });\n    // Doses.\n    const sv = seats[0];\n    if (st.tools.includes('syringe')) {\n      const x = ui.w - 74, y = ui.h - 42;\n      ui.hud.sprite(x, y, TOOL_ICONS.syringe.rows, TOOL_ICONS.syringe.c);\n      ui.text(x + 2, y + 13, `x${st.doses}`, { color: st.doses ? 'white' : 'red' });\n      ui.action(x + 1, y - 11, 'syringe');\n    }\n    void sv;\n  }\n  wheel(ui, x, y, st, sv, full) {\n    const seat = st.seats.find((s) => s.id === sv.id);\n    const cx = x + 24, cy = y + 24;\n    const tool = sv.tool ?? seat?.tool;\n    const R = 19;\n    ui.rect(x + 4, y + 4, 40, 40, 'ink');\n    ui.outline(x + 4, y + 4, 40, 40, sv.color ?? 'slate');\n    if (full || sv.wheelOpen) {\n      TOOLS.forEach((t, i) => {\n        const a = (i / 8) * Math.PI * 2 - Math.PI / 2;\n        const px = Math.round(cx + Math.cos(a) * R - 6), py = Math.round(cy + Math.sin(a) * R - 6);\n        const on = st.tools.includes(t);\n        if (!on) { ui.rect(px + 4, py + 4, 4, 4, 'night'); return; }\n        const sel = t === tool;\n        if (sel) ui.rect(px - 1, py - 1, 14, 14, 'sand');\n        else ui.rect(px - 1, py - 1, 14, 14, 'night');\n        ui.hud.sprite(px, py, TOOL_ICONS[t].rows, TOOL_ICONS[t].c);\n        this.wheelHitBoxes.push({ x: px - 1, y: py - 1, w: 14, h: 14, tool: t, seat: sv.id });\n      });\n    }\n    // The current tool, big in the centre.\n    const shown = st.context && seat ? st.context : tool;\n    const ic = TOOL_ICONS[shown] ?? TOOL_ICONS[tool];\n    if (ic) ui.hud.sprite(cx - 6, cy - 6, ic.rows, ic.c);\n    if (sv.showLabel !== false) {\n      const label = TOOL_NAMES[shown] ?? '';\n      ui.right(x + 46, y + 44 + 1, label, { color: 'sand' });\n    }\n  }\n\n  drawComm(ui, st, o) {\n    const w = ui.w, h = ui.h;\n    const c = o.comm;\n    const stripH = 32;\n    const y = h - stripH;\n    const bust = 38;\n    const rightPad = 56;\n    // The bust's window is left open: a real 3D head sits there.\n    ui.rect(bust, y, w - bust, stripH, 'ink');\n    ui.rect(0, y, w, 1, 'slate');\n    ui.outline(0, y, bust, stripH, 'slate');\n    const tx = bust + 5;\n    const lineW = w - tx - rightPad - 4;\n    if (c?.line) {\n      ui.text(tx, y + 3, SPEAKER_NAMES[c.line.who] ?? c.line.who.toUpperCase(), { color: 'sand', shadow: false });\n      const lines = c.wrapped ?? (c.wrapped = ui.wrap(c.line.text, lineW));\n      let left = c.chars;\n      lines.slice(0, 2).forEach((l, i) => {\n        ui.rich(tx, y + 13 + i * 9, l, { chars: left, hi: 'orange', shadow: false });\n        left -= l.replace(/\\*/g, '').length + 1;\n      });\n    } else if (o.noSignal) {\n      const on = Math.sin((o.t ?? 0) * 3) > -0.2;\n      ui.text(tx, y + 12, 'NO SIGNAL', { color: on ? 'red' : 'plum', scale: 2, shadow: false });\n    } else if (st.objective) {\n      ui.text(tx, y + 3, 'OBJECTIVE', { color: 'slate', shadow: false });\n      const lines = ui.wrap(st.objective, lineW);\n      lines.slice(0, 2).forEach((l, i) => ui.rich(tx, y + 13 + i * 9, l, { color: 'mist', shadow: false }));\n    }\n  }\n\n  drawHint(ui, st, o) {\n    if (!o.hint) return;\n    const p = o.hint;\n    const k = Math.sin((o.t ?? 0) * 5) * 2;\n    const x = Math.round(p.sx), y = Math.round(p.sy - 14 + k);\n    for (let d = 0; d < 5; d++) {\n      ui.rect(x - d, y - 4 + d, d * 2 + 1, 1, 'sand');\n      ui.rect(x - d, y + 4 - d, d * 2 + 1, 1, 'sand');\n    }\n    ui.rect(x - 1, y - 1, 3, 3, 'white');\n    if (p.tool && p.tool !== p.have && TOOL_ICONS[p.tool]) {\n      ui.rect(x + 7, y - 7, 14, 14, 'ink');\n      ui.outline(x + 7, y - 7, 14, 14, Math.sin((o.t ?? 0) * 8) > 0 ? 'sand' : 'white');\n      ui.hud.sprite(x + 8, y - 6, TOOL_ICONS[p.tool].rows, TOOL_ICONS[p.tool].c);\n    }\n  }\n\n  drawCursorHud(ui, st, o) {\n    for (const r of o.reticles ?? []) {\n      const x = Math.round(r.sx), y = Math.round(r.sy);\n      const c = r.color ?? (r.on ? 'lime' : 'white');\n      const R = r.use ? 3 : 5;\n      ui.rect(x - R - 2, y, 3, 1, c); ui.rect(x + R, y, 3, 1, c); ui.rect(x, y - R - 2, 1, 3, c); ui.rect(x, y + R, 1, 3, c);\n      if (r.label) ui.text(x + 8, y - 12, r.label, { color: c });\n      if (r.beatRing != null) {\n        const n = 20;\n        const rr = 12 + Math.round(r.beatRing * 6);\n        for (let i = 0; i < n; i += 1) {\n          const a = (i / n) * Math.PI * 2;\n          ui.rect(Math.round(x + Math.cos(a) * rr), Math.round(y + Math.sin(a) * rr), 1, 1, r.beatBad ? 'red' : 'lime');\n        }\n      }\n      if (r.draw > 0) {\n        const bw = 22;\n        ui.rect(x - bw / 2, y + 11, bw, 3, 'ink');\n        ui.rect(x - bw / 2, y + 11, Math.round(bw * Math.min(1, r.draw / 0.45)), 3, r.draw >= 0.45 ? 'cyan' : 'mist');\n      }\n    }\n  }\n\n  drawCoach(ui, st) {\n    const list = [['use', 'USE']];\n    if (st.tools.length > 1) list.push(['tool', 'TOOL']);\n    list.push(['steady', 'STEADY']);\n    ui.hints(list, ui.h - 44, 'left');\n  }\n\n  drawCodeBlue(ui, st) {\n    const cb = st.codeBlue;\n    const w = ui.w, h = ui.h;\n    const pw = Math.min(280, w - 40), ph = 78;\n    const x = (w - pw) / 2, y = h * 0.28;\n    ui.rect(x + 2, y + 2, pw, ph, 'ink');\n    ui.rect(x, y, pw, ph, 0x2a0a18);\n    ui.outline(x, y, pw, ph, 'red', 2);\n    ui.center(y + 6, cb.fib ? 'FIBRILLATION' : 'CODE BLUE', { color: 'red', scale: 2, shadow: false });\n    const gx = x + 14, gw = pw - 28, gy = y + 28;\n    ui.rect(gx, gy, gw, 12, 'ink');\n    const zw = st.cfgZone ?? this.app.config.codeBlueZone;\n    ui.rect(gx + Math.round((ZONE_CENTER - zw / 2) * gw), gy, Math.round(zw * gw), 12, 'green');\n    ui.outline(gx, gy, gw, 12, 'white');\n    const nx = gx + Math.round(cb.charge * gw);\n    ui.rect(nx - 1, gy - 3, 3, 18, cb.charging ? 'white' : 'mist');\n    // Shocks needed.\n    for (let i = 0; i < cb.need; i++) { ui.rect(gx + i * 12, gy + 17, 9, 6, i < cb.shocks ? 'lime' : 'night'); ui.outline(gx + i * 12, gy + 17, 9, 6, 'white'); }\n    ui.right(gx + gw, gy + 16, `${Math.max(0, cb.t).toFixed(1)}S`, { color: cb.t < 4 ? 'red' : 'white', shadow: false });\n    const label = cb.charging ? 'RELEASE IN THE GREEN!' : 'HOLD ';\n    const lw = ui.hud.measure(label, 1).width + (cb.charging ? 0 : ui.actionWidth('paddles') + 26);\n    let lx = (w - lw) / 2;\n    const ly = y + ph - 13;\n    ui.text(lx, ly, label, { color: 'white', shadow: false });\n    if (!cb.charging) {\n      lx += ui.hud.measure(label, 1).width;\n      lx += ui.action(lx, ly - 1, 'paddles') + 3;\n      ui.text(lx, ly, 'BOTH', { color: 'white', shadow: false });\n    }\n  }\n\n  drawMassage(ui, st) {\n    const m = st.massage;\n    const w = ui.w, h = ui.h;\n    const y = h * 0.3;\n    ui.center(y - 16, 'MASSAGE', { color: 'red', scale: 2 });\n    const beat = 1 - Math.min(m.phase, m.period - m.phase) / (m.period / 2);\n    const R = 8 + Math.round(beat * 8);\n    const cx = w / 2, cy = y + 18;\n    for (let i = 0; i < 28; i++) {\n      const a = (i / 28) * 6.283;\n      ui.rect(Math.round(cx + Math.cos(a) * R), Math.round(cy + Math.sin(a) * R), 2, 2, beat > 0.6 ? 'lime' : 'mist');\n    }\n    const wantA = m.next === 'a';\n    ui.action(cx - 44 - ui.actionWidth('left') / 2, cy - 4, wantA ? 'left' : 'left');\n    if (wantA) ui.outline(cx - 48 - ui.actionWidth('left') / 2, cy - 8, ui.actionWidth('left') + 8, 17, 'sand');\n    ui.action(cx + 44 - ui.actionWidth('right') / 2, cy - 4, 'right');\n    if (!wantA) ui.outline(cx + 40 - ui.actionWidth('right') / 2, cy - 8, ui.actionWidth('right') + 8, 17, 'sand');\n    for (let i = 0; i < m.need; i++) { ui.rect(cx - (m.need * 7) / 2 + i * 7, cy + 22, 5, 5, i < m.n ? 'lime' : 'night'); ui.outline(cx - (m.need * 7) / 2 + i * 7, cy + 22, 5, 5, 'white'); }\n  }\n}\nEOF\necho ok","description":"Write bust rig, reaction lines and operation HUD"}}}
