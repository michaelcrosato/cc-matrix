{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk3vDFfe3sBQD3Ghbxkk","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17121,"cache_read_input_tokens":369985,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17121},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"be18a2b6-bbad-48d8-9207-fd9908ec10ed","timestamp":"2026-11-05T15:54:05.096Z","request_id":"req_011Cgk3vCwoqgwhwpbELcUxV","thinking_duration_ms":22827,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk3vDFfe3sBQD3Ghbxkk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QkYMzesekvbU5AdYMQ9C6E","name":"Bash","input":{"command":"cat > src/app.js <<'EOF'\n// The persistent singleton: survives every stage swap. Save, settings, devices, config, the music\n// director and the shared asset pack live here.\nimport { loadPack, PALETTE } from '../pixel-engine.js';\nimport { ALL_SYLLABLES, renderSyllable, syllableAt, wavDataUrl } from './audio/voice.js';\nimport { MusicDirector } from './audio/director.js';\nimport { SFX_DEFS } from './content/sfx.js';\nimport { createConfig } from './core/config.js';\nimport { SLUG } from './core/meta.js';\nimport { DEFAULT_SETTINGS, loadSave, newProgress, writeSave } from './core/save.js';\nimport { Devices } from './input/devices.js';\n\nconst AUDIO_KEY = 'pixel-engine:audio';\n\nexport const PARTICLE_DEFS = {\n  blood: { count: [3, 6], life: [0.25, 0.6], speed: [0.8, 2.2], gravity: 7, size: [1, 1], colors: ['red', 'plum'], spread: 70 },\n  suck: { count: [1, 3], life: [0.12, 0.26], speed: [1, 2.6], gravity: -2, size: [1, 1], colors: ['red', 'orange'], spread: 40, radius: 0.25 },\n  spark: { count: [4, 8], life: [0.15, 0.4], speed: [1.5, 3.4], gravity: 6, size: [1, 1], colors: ['white', 'sand', 'orange'] },\n  smoke2: { count: [1, 2], life: [0.4, 0.9], speed: [0.5, 1.2], gravity: -1.5, size: [2, 1], colors: ['mist', 'slate'], spread: 25, radius: 0.1 },\n  foam: { count: [2, 4], life: [0.25, 0.55], speed: [0.3, 1], gravity: 1, size: [1, 1], colors: ['lime', 'white'], radius: 0.4 },\n  scanmote: { count: [1, 2], life: [0.3, 0.6], speed: [0.2, 0.6], gravity: -1, size: [1, 1], colors: ['cyan', 'sky'], radius: 1.2 },\n  bonechip: { count: [3, 5], life: [0.2, 0.45], speed: [1, 2.2], gravity: 6, size: [1, 1], colors: ['white', 'sand'] },\n  tear: { count: [3, 5], life: [0.3, 0.6], speed: [0.8, 1.8], gravity: 5, size: [1, 1], colors: ['cyan', 'sky'] },\n  gold: { count: [8, 14], life: [0.5, 1.1], speed: [0.6, 2], gravity: -0.6, size: [1, 1], colors: ['sand', 'white', 'orange'] },\n  gunk: { count: [10, 18], life: [0.4, 0.9], speed: [1, 3], gravity: 6, size: [2, 1], colors: ['lime', 'green', 'plum'] },\n  ice: { count: [2, 4], life: [0.3, 0.7], speed: [0.2, 0.8], gravity: 1, size: [1, 1], colors: ['white', 'cyan'] },\n};\n\nexport const App = {\n  engine: null,\n  ctx: null,\n  devices: new Devices(),\n  config: createConfig(),\n  save: loadSave(),\n  director: new MusicDirector(),\n  overlays: [],\n  frameDt: 1 / 60,\n  idle: 0,\n  kit: null,\n  inited: false,\n  inSession: false,\n  cheats: {},\n  devView: { hitboxes: false, botPlays: false, botSkill: 0.7, simSpeed: 1, stats: false, frameStep: false, stepNow: false },\n  loading: false,\n  log: [],\n\n  async init(ctx) {\n    this.ctx = ctx;\n    this.engine = ctx.engine;\n    this.director.attach(ctx.audio);\n    if (this.inited) return;\n    this.inited = true;\n    this.devices.listen();\n    ctx.engine.input.gamepadButtons = {};\n    ctx.input.preventKeys.add('Tab');\n    for (const k of ['KeyQ', 'KeyE', 'KeyF', 'KeyJ', 'KeyK']) ctx.input.preventKeys.add(k);\n    const container = ctx.engine.renderer.container;\n    if (container?.addEventListener) container.addEventListener('contextmenu', (e) => e.preventDefault());\n\n    // Music is 10% by default: only if the player has never set it.\n    let stored = null;\n    try { stored = typeof localStorage === 'undefined' ? null : localStorage.getItem(AUDIO_KEY); } catch { stored = null; }\n    if (!stored) ctx.audio.setVolume('music', 0.1);\n    ctx.audio.setVolume('sfx', this.save.settings.sound);\n\n    for (const [name, def] of Object.entries(SFX_DEFS)) ctx.audio.register(name, def);\n    this.registerParticles(ctx);\n    // Voices: pre-render syllables in pure JS. They play through the engine's buses and respect mute.\n    await Promise.all(ALL_SYLLABLES.map((s) => ctx.audio.load(s.name, wavDataUrl(renderSyllable(s.t, s.v, s.o)))));\n    try {\n      this.kit = await loadPack('packs/kenney-furniture.json');\n    } catch { this.kit = null; }\n    if (typeof window !== 'undefined') window.__TRAUMA_APP__ = this;\n  },\n  registerParticles(ctx) {\n    for (const [k, def] of Object.entries(PARTICLE_DEFS)) ctx.particles.register(k, def);\n  },\n\n  sfx(name, o) { return this.ctx?.audio.play(name, o); },\n  /** One typewriter character: maybe a syllable. Returns true if it spoke. */\n  voiceChar(who, text, i) {\n    const s = syllableAt(who, text, i);\n    if (!s) return false;\n    const v = this.save.settings.voices;\n    if (v <= 0) return false;\n    this.ctx?.audio.play(s.name, { pitch: s.pitch, volume: s.volume * v });\n    return true;\n  },\n  shake(a) { const k = this.save.settings.shake; if (k > 0) this.engine?.shake.add(a * k); },\n  flash(color = 'white', o = {}) {\n    if (this.save.settings.reduceFlashes) return;\n    this.engine?.screen.flash(color, o);\n  },\n  rumble(o = {}, padIndex) {\n    if (!this.save.settings.rumble) return false;\n    return this.devices.rumble(padIndex, o);\n  },\n  cursor(visible) {\n    const el = this.engine?.renderer?.container;\n    if (el?.style) el.style.cursor = visible ? 'default' : 'none';\n    const cv = this.ctx?.hud?.canvas;\n    if (cv?.style) cv.style.cursor = visible ? 'default' : 'none';\n  },\n  persist() { if (!this.inSession) writeSave(this.save); },\n  newRun(difficulty) {\n    this.save.progress = { ...newProgress(), difficulty };\n    this.save.hasSave = true;\n    this.persist();\n  },\n  resetSettings() {\n    this.save.settings = { ...DEFAULT_SETTINGS };\n    this.ctx?.audio.setVolume('music', 0.1);\n    this.ctx?.audio.setVolume('sfx', this.save.settings.sound);\n    this.persist();\n  },\n\n  /** Swap stages under a transition. */\n  async goto(stage, { kind = 'fade', duration = 0.3, camera } = {}) {\n    if (this.loading) return;\n    this.loading = true;\n    this.overlays.length = 0;\n    const engine = this.engine;\n    const cam = camera ?? stage.cameraConfig ?? { preset: 'fixed', position: [0, 6, 8], target: [0, 1, 0], fov: 40, minZoom: 1, maxZoom: 1 };\n    try {\n      if (!engine.manual) await engine.screen.cover(kind, { duration });\n      await engine.loadGame(stage, { camera: cam });\n      if (!engine.manual) await engine.screen.reveal(kind, { duration });\n      else engine.screen.clear();\n    } finally {\n      this.loading = false;\n    }\n  },\n};\nexport { PALETTE, SLUG };\nEOF\ncat > src/stages/stage.js <<'EOF'\n// The base of every screen: polls devices once per frame, draws overlays on top, tracks idle time.\nimport { THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { UI } from '../ui/hud.js';\n\nexport class Stage {\n  name = 'stage';\n  cameraConfig = null;\n  attractable = false;\n  focus = new THREE.Vector3(0, 0, 0);\n\n  cameraTarget() { return this.focus; }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    await App.init(ctx);\n    App.registerParticles(ctx);\n    this.ui = new UI(App, ctx);\n    this.t = 0;\n    App.director.onStage();\n    await this.build?.(ctx);\n  }\n\n  ready(ctx) {\n    if (typeof window !== 'undefined') window.__GAME__ = { app: App, stage: this, sim: this.sim ?? null, config: App.config, goto: (s) => App.goto(s) };\n    this.onReady?.(ctx);\n  }\n\n  update(ctx, dt) {\n    App.frameDt = dt;\n    App.devices.dt = dt;\n    App.devices.poll(ctx);\n    App.director.update(dt);\n    this.t += dt;\n    ctx.hud.clear();\n    const ov = App.overlays[App.overlays.length - 1];\n    this.frame?.(ctx, dt, !!ov);\n    this.draw?.(ctx, this.ui, dt);\n    for (const o of App.overlays) o.draw?.(this.ui, dt);\n    if (ov) ov.update?.(this.ui, dt);\n    if (this.attractable && !ov) this.trackIdle(ctx, dt);\n    else App.idle = 0;\n    App.cursor(this.showCursor?.() ?? App.devices.last === 'kbm');\n  }\n\n  trackIdle(ctx, dt) {\n    if (App.devices.any) App.idle = 0;\n    else App.idle += dt;\n    if (App.idle >= (App.attractAfter ?? 10) && !App.loading) {\n      App.idle = 0;\n      this.startAttract?.();\n    }\n  }\n  status() { return this.name; }\n}\nEOF\ncat > src/view/hands.js <<'EOF'\n// The surgeon's hand and instruments: a gloved hand plus forearm from below the frame sells first-person\n// presence, and its cast shadow gives depth.\nimport { buildModel, glowMaterial, hologramMaterial, PALETTE, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { handDef, TOOL_DEFS } from '../content/models/index.js';\n\nconst { CylinderGeometry, Group, Mesh } = THREE;\n\nexport const SEAT_GLOVES = [{ glove: 'sky', fold: 'blue' }, { glove: 'white', fold: 'mist' }, { glove: 'green', fold: 'teal' }, { glove: 'sand', fold: 'orange' }];\nexport const COUCH_GLOVES = [{ glove: 'red', fold: 'plum' }, { glove: 'blue', fold: 'navy' }, { glove: 'green', fold: 'teal' }, { glove: 'sand', fold: 'orange' }];\nconst POSES = [\n  { tool: [-0.5, -0.7, 0], hand: [0.88, 1.1, 1.25], rot: [-0.46, -0.72, 0.2] },\n  { tool: [-0.5, 0.7, 0], hand: [-0.88, 1.1, 1.25], rot: [-0.46, 0.72, -0.2] },\n  { tool: [-0.5, -1.5, 0], hand: [1.6, 1.15, 0.2], rot: [-0.46, -1.5, 0.2] },\n  { tool: [-0.5, 1.5, 0], hand: [-1.6, 1.15, 0.2], rot: [-0.46, 1.5, -0.2] },\n];\n\nexport class HandRig {\n  constructor(ctx, seatIndex, o = {}) {\n    this.ctx = ctx;\n    this.seatIndex = seatIndex;\n    this.pose = POSES[seatIndex % 4];\n    this.group = new Group();\n    const gloves = o.gloves ?? SEAT_GLOVES[seatIndex % 4];\n    this.hand = buildModel(handDef, { palette: gloves }).object;\n    this.hand.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n    this.group.add(this.hand);\n    this.tools = {};\n    for (const [name, def] of Object.entries(TOOL_DEFS)) {\n      const obj = buildModel(def).object;\n      obj.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n      obj.visible = false;\n      obj.rotation.set(...this.pose.tool);\n      this.group.add(obj);\n      this.tools[name] = obj;\n    }\n    this.armL = this.tools.forceps.getObjectByName('armL');\n    this.armR = this.tools.forceps.getObjectByName('armR');\n    this.plunger = this.tools.syringe.getObjectByName('plunger');\n    this.bottle = this.tools.gel.getObjectByName('bottle');\n    // The laser's beam.\n    this.beam = new Mesh(new CylinderGeometry(0.06, 0.06, 1, 6), glowMaterial(PALETTE.orange));\n    this.beam.visible = false;\n    this.group.add(this.beam);\n    // The scanner's hologram.\n    this.holo = new Mesh(new CylinderGeometry(2.2, 2.2, 0.06, 24), hologramMaterial({ color: PALETTE.cyan }));\n    this.holo.visible = false;\n    this.group.add(this.holo);\n    setLookLayer(this.group, 'actors');\n    ctx.scene.add(this.group);\n    if (o.ghost) this.makeGhost();\n    this.current = null;\n    this.bob = 0;\n    this.jitter = 0;\n    this.grip = 0;\n  }\n  makeGhost() {\n    const mat = hologramMaterial({ color: PALETTE.white });\n    this.group.traverse((m) => { if (m.isMesh) { m.material = mat; m.castShadow = false; } });\n    this.ghost = true;\n  }\n  setTool(name) {\n    if (name === this.current) return;\n    if (this.current && this.tools[this.current]) this.tools[this.current].visible = false;\n    this.current = name;\n    if (this.tools[name]) this.tools[name].visible = true;\n    this.switching = 0.12;\n  }\n  /** Place the tip at world (x, surface, z). */\n  update(dt, x, y, z, s = {}) {\n    const name = s.tool ?? this.current;\n    this.setTool(name);\n    this.switching = Math.max(0, (this.switching ?? 0) - dt);\n    const use = !!s.use;\n    this.grip += ((use ? 1 : 0) - this.grip) * Math.min(1, dt * 18);\n    this.bob += dt;\n    const hover = name === 'laser' ? 0.9 : name === 'scanner' ? 0.75 : name === 'syringe' ? (use ? 0.2 : 0.35) : name === 'gel' ? 0.4 : (use ? 0.03 : 0.24);\n    let jx = 0, jz = 0;\n    if (use && name === 'drain') { jx = Math.sin(this.bob * 42) * 0.015; jz = Math.cos(this.bob * 37) * 0.015; }\n    const lift = hover + (this.switching > 0 ? 0.3 : 0);\n    const t = this.tools[name];\n    if (t) {\n      t.position.set(x + jx, y + lift, z + jz);\n      t.rotation.set(...this.pose.tool);\n    }\n    this.hand.position.set(x + this.pose.hand[0], y + lift + this.pose.hand[1] - this.grip * 0.03, z + this.pose.hand[2]);\n    this.hand.rotation.set(...this.pose.rot);\n    if (this.hidden !== !!s.hidden) { this.hidden = !!s.hidden; this.group.visible = !this.hidden; }\n    // Forceps jaws.\n    if (name === 'forceps') {\n      const open = (s.holding ? 0.4 : 4) - this.grip * (s.holding ? 0 : 3.2);\n      this.armL.rotation.y = (-open * Math.PI) / 180;\n      this.armR.rotation.y = (open * Math.PI) / 180;\n    }\n    if (name === 'syringe') this.plunger.position.z = 1.5 + (s.draw ?? 0) * 0.7;\n    if (name === 'gel') {\n      const sq = 1 - this.grip * (0.1 + Math.sin(this.bob * 30) * 0.03);\n      this.bottle.scale.set(sq, sq, 1 + (1 - sq));\n    }\n    // Beam.\n    this.beam.visible = name === 'laser' && use && !this.ghost;\n    if (this.beam.visible) {\n      const h = lift + 0.08;\n      this.beam.scale.set(1 + Math.sin(this.bob * 60) * 0.3, h, 1 + Math.sin(this.bob * 60) * 0.3);\n      this.beam.position.set(x, y + h / 2, z);\n    }\n    this.holo.visible = name === 'scanner' && use && !this.ghost;\n    if (this.holo.visible) { this.holo.position.set(x, y + 0.5, z); }\n    if (s.table !== undefined) this.group.visible = !this.hidden;\n  }\n  dispose() { this.ctx.scene.remove(this.group); }\n}\nEOF\ncat > src/view/entviews.js <<'EOF'\n// 3D objects for what's on the field, synced from state by id. Tissue is painted; these stand on it.\nimport { buildModel, glowMaterial, LegStepper, PALETTE, setLookLayer, Squash, SpringChain, THREE, toonMaterial, twoBoneIK } from '../../pixel-engine.js';\nimport { boltDef, cardDef, clampDef, clotDef, coinDef, cystDef, eggDef, fragmentDefs, haloDef, hookDef, introitCoreDef, keyDef, kidneyDef, magnetDef, miserereDef, paleCoreDef, polypDef, shardDef, strandDef, tumorDef, weeperEyeDef, wrathEyeDef, wrathPlateDef } from '../content/models/index.js';\n\nconst { BoxGeometry, Color, Group, Mesh, SphereGeometry, Vector3 } = THREE;\n\nconst PROP_DEFS = { key: keyDef, coin: coinDef, card: cardDef, magnet: magnetDef, shard: shardDef, bolt: boltDef, strand: strandDef };\n\nfunction ownMaterials(obj) {\n  obj.traverse((m) => {\n    if (m.isMesh) {\n      m.material = m.material.clone();\n      m.userData.base = m.material.color.clone();\n      m.material.userData = { ...m.material.userData, shared: false };\n    }\n  });\n}\nconst tmpC = new Color();\n\nexport class EntViews {\n  constructor(ctx, tableViews, fx) {\n    this.ctx = ctx;\n    this.tables = tableViews;\n    this.fx = fx;\n    this.map = new Map();\n    this.group = new Group();\n    ctx.scene.add(this.group);\n    this.dropMeshes = [];\n    this.dropGeo = new SphereGeometry(0.12, 6, 5);\n    this.dropMat = glowMaterial(PALETTE.cyan);\n    this.barGeo = new BoxGeometry(1, 1, 1);\n    this.tendrilMat = toonMaterial(PALETTE.plum);\n    this.tetherMat = toonMaterial(PALETTE.lime);\n    this.flying = [];\n  }\n\n  makeBar(mat, thick = 0.09) {\n    const m = new Mesh(this.barGeo, mat);\n    m.scale.set(thick, thick, 1);\n    m.castShadow = true;\n    setLookLayer(m, 'actors');\n    this.group.add(m);\n    return m;\n  }\n\n  build(e) {\n    let def = null, scale = 1, y = 0;\n    switch (e.k) {\n      case 'hook': def = hookDef; scale = 1.15; break;\n      case 'prop': def = PROP_DEFS[e.prop] ?? keyDef; scale = e.prop === 'strand' ? 1.5 : 1.2; break;\n      case 'magnet': def = magnetDef; scale = 1.3; break;\n      case 'debris': def = PROP_DEFS[e.prop] ?? shardDef; scale = 1.25; break;\n      case 'tumor': def = tumorDef; scale = (e.r ?? 1.1) * 1.3; break;\n      case 'polyp': def = polypDef; scale = (e.r ?? 0.34) * 2.6; break;\n      case 'egg': def = eggDef; scale = (e.r ?? 0.34) * 2.4; break;\n      case 'cyst': def = cystDef; scale = (e.r ?? 0.42) * 2.2; break;\n      case 'clot': def = clotDef; scale = 1.3; break;\n      case 'eye': def = e.heartEye ? wrathEyeDef : weeperEyeDef; scale = e.heartEye ? 1.1 : (e.r ?? 0.55) * 2.1; break;\n      case 'halo': def = haloDef; scale = 1; break;\n      case 'plate': def = wrathPlateDef; scale = 1.2; break;\n      case 'clamp': case 'unclamp': def = clampDef; scale = 1.3; break;\n      case 'fragment': def = fragmentDefs[(Number(String(e.shape ?? e.id).replace(/\\D/g, '')) || 1) - 1] ?? fragmentDefs[0]; scale = 1.05; break;\n      case 'organ': case 'donor': def = kidneyDef; scale = 1.25; break;\n      case 'core': def = e.id === 'palecore' ? paleCoreDef : e.twoHanded ? miserereDef : introitCoreDef; scale = e.twoHanded ? 0.55 : 0.9; break;\n      case 'stalk': def = weeperEyeDef; scale = 1.1; break;\n      case 'strain:miserere': def = miserereDef; scale = 1.1; break;\n      default: return null;\n    }\n    const b = buildModel(def);\n    const obj = b.object;\n    obj.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n    const holder = new Group();\n    holder.add(obj);\n    obj.scale.setScalar(scale);\n    setLookLayer(holder, 'actors');\n    this.group.add(holder);\n    const v = { e, holder, obj, base: scale, squash: new Squash(), y, born: 0, seed: Math.random() };\n    v.squash.amount = 1.5;\n    if (e.k === 'organ' || e.k === 'donor') {\n      ownMaterials(obj);\n      v.tint = true;\n      const col = e.k === 'organ' ? new Color(0x5d3f58) : new Color(0x6a5572);\n      obj.traverse((m) => { if (m.isMesh) m.material.color.copy(col); });\n    }\n    if (e.heartEye || e.k === 'eye') {\n      v.lidA = obj.getObjectByName('lidA');\n      v.lidB = obj.getObjectByName('lidB');\n      v.iris = obj.getObjectByName('iris');\n    }\n    if (e.k === 'core' && !e.twoHanded) {\n      v.tether = this.makeBar(this.tetherMat, 0.11);\n      v.tendrils = [0, 1, 2].map((i) => ({ chain: new SpringChain({ segments: 4, length: 0.16, stiffness: 7, gravity: 3 }), bars: Array.from({ length: 4 }, () => this.makeBar(this.tendrilMat, 0.07)), a: (i / 3) * 6.28 }));\n    }\n    if (e.k === 'stalk') v.tether = this.makeBar(this.tetherMat, 0.13);\n    if (e.k === 'eye' && !e.heartEye) {\n      v.legs = new LegStepper({ legs: [{ rest: [-0.6, 0.3], partners: [1] }, { rest: [0.6, 0.3], partners: [0] }, { rest: [-0.5, -0.4], partners: [3] }, { rest: [0.5, -0.4], partners: [2] }], threshold: 0.28, stepTime: 0.16, lift: 0.14 });\n      v.legBars = Array.from({ length: 8 }, () => this.makeBar(this.tendrilMat, 0.07));\n      for (const b2 of v.legBars) b2.visible = false;\n    }\n    return v;\n  }\n\n  sync(state, s, dt) {\n    const seen = new Set();\n    for (const e of state.ents) {\n      if (e.dead) continue;\n      seen.add(e.id);\n      let v = this.map.get(e.id);\n      if (!v) {\n        v = this.build(e);\n        if (!v) { this.map.set(e.id, { e, none: true }); continue; }\n        this.map.set(e.id, v);\n      }\n      if (v.none) continue;\n      v.e = e;\n      this.place(v, e, state, s, dt);\n    }\n    for (const [id, v] of this.map) {\n      if (seen.has(id)) continue;\n      this.map.delete(id);\n      if (v.none) continue;\n      this.retire(v);\n    }\n    // Things flying to the dish.\n    for (let i = this.flying.length - 1; i >= 0; i--) {\n      const f = this.flying[i];\n      f.t += dt / f.dur;\n      const k = Math.min(1, f.t);\n      f.holder.position.set(f.from.x + (f.to.x - f.from.x) * k, f.from.y + (f.to.y - f.from.y) * k + Math.sin(k * Math.PI) * 1.4, f.from.z + (f.to.z - f.from.z) * k);\n      f.holder.rotation.y += dt * 11;\n      if (k >= 1) {\n        this.flying.splice(i, 1);\n        if (f.keep) { f.holder.rotation.y = f.seed * 6; f.holder.position.x += (f.seed - 0.5) * 0.6; f.holder.position.z += (f.seed - 0.5) * 0.3; f.holder.scale.setScalar(0.7); }\n        else this.group.remove(f.holder);\n        f.done?.();\n      }\n    }\n    // Droplets.\n    const drops = state.drops ?? [];\n    let n = 0;\n    for (const d of drops) {\n      if (d.dead) continue;\n      const tv = this.tables[d.table] ?? this.tables[0];\n      let m = this.dropMeshes[n];\n      if (!m) {\n        m = new Mesh(this.dropGeo, this.dropMat);\n        setLookLayer(m, 'actors');\n        this.group.add(m);\n        this.dropMeshes[n] = m;\n      }\n      m.visible = true;\n      m.position.set(tv.offsetX + d.x, tv.heightAt(d.x, d.z, s) + 0.14, d.z);\n      n++;\n    }\n    for (let i = n; i < this.dropMeshes.length; i++) this.dropMeshes[i].visible = false;\n  }\n\n  place(v, e, state, s, dt) {\n    const tv = this.tables[e.table] ?? this.tables[0];\n    const hidden = e.hidden || (e.k === 'plate' && false);\n    v.holder.visible = !hidden;\n    const surf = tv.heightAt(e.x, e.z, s);\n    v.born = Math.min(1, v.born + dt * 6);\n    let lift = 0;\n    const held = (e.holders ?? 0) > 0;\n    if (held) lift = 0.2;\n    if (e.free) lift = 0.55;\n    if (e.placed) lift = 0;\n    v.holder.position.set(tv.offsetX + e.x, surf + lift, e.z);\n    v.squash.update(dt);\n    if (held && !v.wasHeld) v.squash.kick(-3);\n    v.wasHeld = held;\n    const [h, vs] = v.squash.scale();\n    v.obj.scale.set(v.base * h * v.born, v.base * vs * v.born, v.base * h * v.born);\n    // Per-kind life.\n    if (e.k === 'hook') {\n      const h0 = e.path && e.len > 0 ? e.path : null;\n      if (h0) { const end = h0[h0.length - 1], st = h0[0]; v.obj.rotation.y = -Math.atan2(end[1] - st[1], end[0] - st[0]) + Math.PI / 2; }\n    }\n    if (e.k === 'fragment') v.obj.rotation.y = -((e.rot ?? 0) * Math.PI) / 180;\n    if (e.k === 'plate') {\n      v.obj.rotation.y = -(e.ang ?? 0) - Math.PI / 2;\n      v.obj.rotation.x = -0.25;\n      v.obj.position.y = e.locked ? 0 : 0.12;\n    }\n    if (e.k === 'polyp' || e.k === 'egg') v.obj.position.y = Math.sin(s.t * 3 + v.seed * 6) * 0.03;\n    if (e.k === 'egg' || e.k === 'polyp') {\n      if (e.heat > 0) v.holder.scale.setScalar(1 + Math.sin(s.t * 40) * 0.05 * e.heat);\n    }\n    if (e.k === 'cyst') {\n      // Scanned: real ones show their angry core; false ones go pale and quiet.\n      if (e.scanned && !v.marked) {\n        v.marked = true;\n        const bad = new Mesh(new SphereGeometry(0.2, 8, 6), glowMaterial(e.real ? PALETTE.red : PALETTE.green));\n        bad.position.y = 0.36;\n        v.obj.add(bad);\n      }\n    }\n    if (e.k === 'donor' && v.tint) {\n      const p = e.perfuse ?? 0;\n      tmpC.setHex(0x6a5572).lerp(new Color(0xd65c4f), p);\n      v.obj.traverse((m) => { if (m.isMesh) m.material.color.copy(tmpC); });\n      if (e.placed && p === 0) v.obj.rotation.y = 0;\n    }\n    if (e.k === 'eye') {\n      const openT = e.heartEye ? (e.locked ? 0 : 1) : e.open ? 1 : 0;\n      v.open = (v.open ?? 0) + (openT - (v.open ?? 0)) * Math.min(1, dt * (e.open ? 6 : 12));\n      if (v.lidA) {\n        v.lidA.rotation.x = -v.open * 1.35;\n        v.lidB.rotation.x = v.open * 1.35;\n        if (v.iris) { v.iris.position.x = Math.sin(s.t * 0.7 + v.seed * 9) * 0.1; v.iris.position.z = 0.04 + Math.cos(s.t * 0.9 + v.seed * 4) * 0.08; v.iris.visible = v.open > 0.15; }\n      }\n      if (e.heartEye) { v.obj.visible = !e.locked || (s.beat ?? 0) > 0.2; v.obj.scale.setScalar(v.base * (e.locked ? 0.7 : 1 + (s.beat ?? 0) * 0.08)); }\n      if (v.legs) {\n        const crawling = e.wx != null;\n        for (const b of v.legBars) b.visible = crawling;\n        if (crawling) this.updateLegs(v, tv, e, surf, s, dt);\n      }\n    }\n    if (e.k === 'strain:miserere') {\n      v.obj.position.y = 0.6 + Math.sin(s.t * 1.4) * 0.12;\n      v.obj.rotation.y = Math.sin(s.t * 0.5) * 0.25;\n    }\n    if (e.k === 'core' && v.tether) {\n      const hx = tv.offsetX + e.home[0], hz = e.home[1], hy = tv.heightAt(e.home[0], e.home[1], s) + 0.05;\n      this.stretch(v.tether, hx, hy, hz, v.holder.position.x, v.holder.position.y + 0.36, v.holder.position.z);\n      v.obj.rotation.y = s.t * (held ? 7 : 2);\n      for (const t of v.tendrils) {\n        const root = [v.holder.position.x + Math.cos(t.a + s.t) * 0.28, v.holder.position.y + 0.4, v.holder.position.z + Math.sin(t.a + s.t) * 0.28];\n        t.chain.update(dt, root, [[1, 0, 0], [0, 1, 0], [Math.cos(t.a), 0.3, Math.sin(t.a)]]);\n        for (let i = 0; i < t.bars.length; i++) {\n          const a = t.chain.points[i], b = t.chain.points[i + 1];\n          this.stretch(t.bars[i], a[0], a[1], a[2], b[0], b[1], b[2]);\n        }\n      }\n    }\n    if (e.k === 'stalk' && v.tether) {\n      const hx = tv.offsetX + e.home[0], hz = e.home[1], hy = tv.heightAt(e.home[0], e.home[1], s) + 0.05;\n      this.stretch(v.tether, hx, hy, hz, v.holder.position.x, v.holder.position.y + 0.3, v.holder.position.z);\n    }\n    if (s.hitboxes) this.fx?.hitbox?.(e, tv, surf);\n  }\n\n  updateLegs(v, tv, e, surf, s, dt) {\n    const body = [tv.offsetX + e.x, surf + 0.42, e.z];\n    const vel = [(e.wx - e.x) * 0.6, 0, (e.wz - e.z) * 0.6];\n    v.legs.update(dt, body, 0, vel, (x, z) => tv.heightAt(x - tv.offsetX, z, s));\n    const knee = [0, 0, 0];\n    v.legs.feet.forEach((f, i) => {\n      const hip = [body[0] + (i % 2 ? 0.3 : -0.3), body[1], body[2] + (i < 2 ? 0.14 : -0.14)];\n      twoBoneIK(hip, f.at, 0.42, 0.46, [hip[0] * 1 + (i % 2 ? 0.8 : -0.8), body[1] + 1.2, hip[2]], knee);\n      this.stretch(v.legBars[i * 2], hip[0], hip[1], hip[2], knee[0], knee[1], knee[2]);\n      this.stretch(v.legBars[i * 2 + 1], knee[0], knee[1], knee[2], f.at[0], f.at[1], f.at[2]);\n    });\n  }\n\n  stretch(mesh, ax, ay, az, bx, by, bz) {\n    const dx = bx - ax, dy = by - ay, dz = bz - az;\n    const l = Math.hypot(dx, dy, dz) || 0.001;\n    mesh.position.set((ax + bx) / 2, (ay + by) / 2, (az + bz) / 2);\n    mesh.scale.z = l;\n    mesh.lookAt(bx, by, bz);\n  }\n\n  retire(v) {\n    const e = v.e;\n    if (v.tether) this.group.remove(v.tether);\n    if (v.tendrils) for (const t of v.tendrils) for (const b of t.bars) this.group.remove(b);\n    if (v.legBars) for (const b of v.legBars) this.group.remove(b);\n    const kinds = new Set(['hook', 'prop', 'magnet', 'debris', 'tumor', 'organ', 'plate', 'core', 'unclamp', 'stalk']);\n    if (kinds.has(e.k) && this.fx?.dishAt) {\n      const from = v.holder.position.clone();\n      const to = this.fx.dishAt(e.table);\n      this.flying.push({ holder: v.holder, from, to, t: 0, dur: 0.32, seed: v.seed, keep: e.k === 'hook' || e.k === 'prop' || e.k === 'debris', done: () => this.fx.tink?.(e) });\n      return;\n    }\n    this.group.remove(v.holder);\n  }\n}\nEOF\necho ok","description":"Write App singleton, stage base, hand rig and entity views"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17121,"cache_read_input_tokens":369985,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17121},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"c8c6d52d-282f-4cfd-a828-e91683eeef3b","timestamp":"2026-11-05T15:55:38.695Z","request_id":"req_011Cgk3vCwoqgwhwpbELcUxV","wire_tool_inputs":{"toolu_01QkYMzesekvbU5AdYMQ9C6E":{"command":"cat > src/app.js <<'EOF'\n// The persistent singleton: survives every stage swap. Save, settings, devices, config, the music\n// director and the shared asset pack live here.\nimport { loadPack, PALETTE } from '../pixel-engine.js';\nimport { ALL_SYLLABLES, renderSyllable, syllableAt, wavDataUrl } from './audio/voice.js';\nimport { MusicDirector } from './audio/director.js';\nimport { SFX_DEFS } from './content/sfx.js';\nimport { createConfig } from './core/config.js';\nimport { SLUG } from './core/meta.js';\nimport { DEFAULT_SETTINGS, loadSave, newProgress, writeSave } from './core/save.js';\nimport { Devices } from './input/devices.js';\n\nconst AUDIO_KEY = 'pixel-engine:audio';\n\nexport const PARTICLE_DEFS = {\n  blood: { count: [3, 6], life: [0.25, 0.6], speed: [0.8, 2.2], gravity: 7, size: [1, 1], colors: ['red', 'plum'], spread: 70 },\n  suck: { count: [1, 3], life: [0.12, 0.26], speed: [1, 2.6], gravity: -2, size: [1, 1], colors: ['red', 'orange'], spread: 40, radius: 0.25 },\n  spark: { count: [4, 8], life: [0.15, 0.4], speed: [1.5, 3.4], gravity: 6, size: [1, 1], colors: ['white', 'sand', 'orange'] },\n  smoke2: { count: [1, 2], life: [0.4, 0.9], speed: [0.5, 1.2], gravity: -1.5, size: [2, 1], colors: ['mist', 'slate'], spread: 25, radius: 0.1 },\n  foam: { count: [2, 4], life: [0.25, 0.55], speed: [0.3, 1], gravity: 1, size: [1, 1], colors: ['lime', 'white'], radius: 0.4 },\n  scanmote: { count: [1, 2], life: [0.3, 0.6], speed: [0.2, 0.6], gravity: -1, size: [1, 1], colors: ['cyan', 'sky'], radius: 1.2 },\n  bonechip: { count: [3, 5], life: [0.2, 0.45], speed: [1, 2.2], gravity: 6, size: [1, 1], colors: ['white', 'sand'] },\n  tear: { count: [3, 5], life: [0.3, 0.6], speed: [0.8, 1.8], gravity: 5, size: [1, 1], colors: ['cyan', 'sky'] },\n  gold: { count: [8, 14], life: [0.5, 1.1], speed: [0.6, 2], gravity: -0.6, size: [1, 1], colors: ['sand', 'white', 'orange'] },\n  gunk: { count: [10, 18], life: [0.4, 0.9], speed: [1, 3], gravity: 6, size: [2, 1], colors: ['lime', 'green', 'plum'] },\n  ice: { count: [2, 4], life: [0.3, 0.7], speed: [0.2, 0.8], gravity: 1, size: [1, 1], colors: ['white', 'cyan'] },\n};\n\nexport const App = {\n  engine: null,\n  ctx: null,\n  devices: new Devices(),\n  config: createConfig(),\n  save: loadSave(),\n  director: new MusicDirector(),\n  overlays: [],\n  frameDt: 1 / 60,\n  idle: 0,\n  kit: null,\n  inited: false,\n  inSession: false,\n  cheats: {},\n  devView: { hitboxes: false, botPlays: false, botSkill: 0.7, simSpeed: 1, stats: false, frameStep: false, stepNow: false },\n  loading: false,\n  log: [],\n\n  async init(ctx) {\n    this.ctx = ctx;\n    this.engine = ctx.engine;\n    this.director.attach(ctx.audio);\n    if (this.inited) return;\n    this.inited = true;\n    this.devices.listen();\n    ctx.engine.input.gamepadButtons = {};\n    ctx.input.preventKeys.add('Tab');\n    for (const k of ['KeyQ', 'KeyE', 'KeyF', 'KeyJ', 'KeyK']) ctx.input.preventKeys.add(k);\n    const container = ctx.engine.renderer.container;\n    if (container?.addEventListener) container.addEventListener('contextmenu', (e) => e.preventDefault());\n\n    // Music is 10% by default: only if the player has never set it.\n    let stored = null;\n    try { stored = typeof localStorage === 'undefined' ? null : localStorage.getItem(AUDIO_KEY); } catch { stored = null; }\n    if (!stored) ctx.audio.setVolume('music', 0.1);\n    ctx.audio.setVolume('sfx', this.save.settings.sound);\n\n    for (const [name, def] of Object.entries(SFX_DEFS)) ctx.audio.register(name, def);\n    this.registerParticles(ctx);\n    // Voices: pre-render syllables in pure JS. They play through the engine's buses and respect mute.\n    await Promise.all(ALL_SYLLABLES.map((s) => ctx.audio.load(s.name, wavDataUrl(renderSyllable(s.t, s.v, s.o)))));\n    try {\n      this.kit = await loadPack('packs/kenney-furniture.json');\n    } catch { this.kit = null; }\n    if (typeof window !== 'undefined') window.__TRAUMA_APP__ = this;\n  },\n  registerParticles(ctx) {\n    for (const [k, def] of Object.entries(PARTICLE_DEFS)) ctx.particles.register(k, def);\n  },\n\n  sfx(name, o) { return this.ctx?.audio.play(name, o); },\n  /** One typewriter character: maybe a syllable. Returns true if it spoke. */\n  voiceChar(who, text, i) {\n    const s = syllableAt(who, text, i);\n    if (!s) return false;\n    const v = this.save.settings.voices;\n    if (v <= 0) return false;\n    this.ctx?.audio.play(s.name, { pitch: s.pitch, volume: s.volume * v });\n    return true;\n  },\n  shake(a) { const k = this.save.settings.shake; if (k > 0) this.engine?.shake.add(a * k); },\n  flash(color = 'white', o = {}) {\n    if (this.save.settings.reduceFlashes) return;\n    this.engine?.screen.flash(color, o);\n  },\n  rumble(o = {}, padIndex) {\n    if (!this.save.settings.rumble) return false;\n    return this.devices.rumble(padIndex, o);\n  },\n  cursor(visible) {\n    const el = this.engine?.renderer?.container;\n    if (el?.style) el.style.cursor = visible ? 'default' : 'none';\n    const cv = this.ctx?.hud?.canvas;\n    if (cv?.style) cv.style.cursor = visible ? 'default' : 'none';\n  },\n  persist() { if (!this.inSession) writeSave(this.save); },\n  newRun(difficulty) {\n    this.save.progress = { ...newProgress(), difficulty };\n    this.save.hasSave = true;\n    this.persist();\n  },\n  resetSettings() {\n    this.save.settings = { ...DEFAULT_SETTINGS };\n    this.ctx?.audio.setVolume('music', 0.1);\n    this.ctx?.audio.setVolume('sfx', this.save.settings.sound);\n    this.persist();\n  },\n\n  /** Swap stages under a transition. */\n  async goto(stage, { kind = 'fade', duration = 0.3, camera } = {}) {\n    if (this.loading) return;\n    this.loading = true;\n    this.overlays.length = 0;\n    const engine = this.engine;\n    const cam = camera ?? stage.cameraConfig ?? { preset: 'fixed', position: [0, 6, 8], target: [0, 1, 0], fov: 40, minZoom: 1, maxZoom: 1 };\n    try {\n      if (!engine.manual) await engine.screen.cover(kind, { duration });\n      await engine.loadGame(stage, { camera: cam });\n      if (!engine.manual) await engine.screen.reveal(kind, { duration });\n      else engine.screen.clear();\n    } finally {\n      this.loading = false;\n    }\n  },\n};\nexport { PALETTE, SLUG };\nEOF\ncat > src/stages/stage.js <<'EOF'\n// The base of every screen: polls devices once per frame, draws overlays on top, tracks idle time.\nimport { THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { UI } from '../ui/hud.js';\n\nexport class Stage {\n  name = 'stage';\n  cameraConfig = null;\n  attractable = false;\n  focus = new THREE.Vector3(0, 0, 0);\n\n  cameraTarget() { return this.focus; }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    await App.init(ctx);\n    App.registerParticles(ctx);\n    this.ui = new UI(App, ctx);\n    this.t = 0;\n    App.director.onStage();\n    await this.build?.(ctx);\n  }\n\n  ready(ctx) {\n    if (typeof window !== 'undefined') window.__GAME__ = { app: App, stage: this, sim: this.sim ?? null, config: App.config, goto: (s) => App.goto(s) };\n    this.onReady?.(ctx);\n  }\n\n  update(ctx, dt) {\n    App.frameDt = dt;\n    App.devices.dt = dt;\n    App.devices.poll(ctx);\n    App.director.update(dt);\n    this.t += dt;\n    ctx.hud.clear();\n    const ov = App.overlays[App.overlays.length - 1];\n    this.frame?.(ctx, dt, !!ov);\n    this.draw?.(ctx, this.ui, dt);\n    for (const o of App.overlays) o.draw?.(this.ui, dt);\n    if (ov) ov.update?.(this.ui, dt);\n    if (this.attractable && !ov) this.trackIdle(ctx, dt);\n    else App.idle = 0;\n    App.cursor(this.showCursor?.() ?? App.devices.last === 'kbm');\n  }\n\n  trackIdle(ctx, dt) {\n    if (App.devices.any) App.idle = 0;\n    else App.idle += dt;\n    if (App.idle >= (App.attractAfter ?? 10) && !App.loading) {\n      App.idle = 0;\n      this.startAttract?.();\n    }\n  }\n  status() { return this.name; }\n}\nEOF\ncat > src/view/hands.js <<'EOF'\n// The surgeon's hand and instruments: a gloved hand plus forearm from below the frame sells first-person\n// presence, and its cast shadow gives depth.\nimport { buildModel, glowMaterial, hologramMaterial, PALETTE, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { handDef, TOOL_DEFS } from '../content/models/index.js';\n\nconst { CylinderGeometry, Group, Mesh } = THREE;\n\nexport const SEAT_GLOVES = [{ glove: 'sky', fold: 'blue' }, { glove: 'white', fold: 'mist' }, { glove: 'green', fold: 'teal' }, { glove: 'sand', fold: 'orange' }];\nexport const COUCH_GLOVES = [{ glove: 'red', fold: 'plum' }, { glove: 'blue', fold: 'navy' }, { glove: 'green', fold: 'teal' }, { glove: 'sand', fold: 'orange' }];\nconst POSES = [\n  { tool: [-0.5, -0.7, 0], hand: [0.88, 1.1, 1.25], rot: [-0.46, -0.72, 0.2] },\n  { tool: [-0.5, 0.7, 0], hand: [-0.88, 1.1, 1.25], rot: [-0.46, 0.72, -0.2] },\n  { tool: [-0.5, -1.5, 0], hand: [1.6, 1.15, 0.2], rot: [-0.46, -1.5, 0.2] },\n  { tool: [-0.5, 1.5, 0], hand: [-1.6, 1.15, 0.2], rot: [-0.46, 1.5, -0.2] },\n];\n\nexport class HandRig {\n  constructor(ctx, seatIndex, o = {}) {\n    this.ctx = ctx;\n    this.seatIndex = seatIndex;\n    this.pose = POSES[seatIndex % 4];\n    this.group = new Group();\n    const gloves = o.gloves ?? SEAT_GLOVES[seatIndex % 4];\n    this.hand = buildModel(handDef, { palette: gloves }).object;\n    this.hand.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n    this.group.add(this.hand);\n    this.tools = {};\n    for (const [name, def] of Object.entries(TOOL_DEFS)) {\n      const obj = buildModel(def).object;\n      obj.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n      obj.visible = false;\n      obj.rotation.set(...this.pose.tool);\n      this.group.add(obj);\n      this.tools[name] = obj;\n    }\n    this.armL = this.tools.forceps.getObjectByName('armL');\n    this.armR = this.tools.forceps.getObjectByName('armR');\n    this.plunger = this.tools.syringe.getObjectByName('plunger');\n    this.bottle = this.tools.gel.getObjectByName('bottle');\n    // The laser's beam.\n    this.beam = new Mesh(new CylinderGeometry(0.06, 0.06, 1, 6), glowMaterial(PALETTE.orange));\n    this.beam.visible = false;\n    this.group.add(this.beam);\n    // The scanner's hologram.\n    this.holo = new Mesh(new CylinderGeometry(2.2, 2.2, 0.06, 24), hologramMaterial({ color: PALETTE.cyan }));\n    this.holo.visible = false;\n    this.group.add(this.holo);\n    setLookLayer(this.group, 'actors');\n    ctx.scene.add(this.group);\n    if (o.ghost) this.makeGhost();\n    this.current = null;\n    this.bob = 0;\n    this.jitter = 0;\n    this.grip = 0;\n  }\n  makeGhost() {\n    const mat = hologramMaterial({ color: PALETTE.white });\n    this.group.traverse((m) => { if (m.isMesh) { m.material = mat; m.castShadow = false; } });\n    this.ghost = true;\n  }\n  setTool(name) {\n    if (name === this.current) return;\n    if (this.current && this.tools[this.current]) this.tools[this.current].visible = false;\n    this.current = name;\n    if (this.tools[name]) this.tools[name].visible = true;\n    this.switching = 0.12;\n  }\n  /** Place the tip at world (x, surface, z). */\n  update(dt, x, y, z, s = {}) {\n    const name = s.tool ?? this.current;\n    this.setTool(name);\n    this.switching = Math.max(0, (this.switching ?? 0) - dt);\n    const use = !!s.use;\n    this.grip += ((use ? 1 : 0) - this.grip) * Math.min(1, dt * 18);\n    this.bob += dt;\n    const hover = name === 'laser' ? 0.9 : name === 'scanner' ? 0.75 : name === 'syringe' ? (use ? 0.2 : 0.35) : name === 'gel' ? 0.4 : (use ? 0.03 : 0.24);\n    let jx = 0, jz = 0;\n    if (use && name === 'drain') { jx = Math.sin(this.bob * 42) * 0.015; jz = Math.cos(this.bob * 37) * 0.015; }\n    const lift = hover + (this.switching > 0 ? 0.3 : 0);\n    const t = this.tools[name];\n    if (t) {\n      t.position.set(x + jx, y + lift, z + jz);\n      t.rotation.set(...this.pose.tool);\n    }\n    this.hand.position.set(x + this.pose.hand[0], y + lift + this.pose.hand[1] - this.grip * 0.03, z + this.pose.hand[2]);\n    this.hand.rotation.set(...this.pose.rot);\n    if (this.hidden !== !!s.hidden) { this.hidden = !!s.hidden; this.group.visible = !this.hidden; }\n    // Forceps jaws.\n    if (name === 'forceps') {\n      const open = (s.holding ? 0.4 : 4) - this.grip * (s.holding ? 0 : 3.2);\n      this.armL.rotation.y = (-open * Math.PI) / 180;\n      this.armR.rotation.y = (open * Math.PI) / 180;\n    }\n    if (name === 'syringe') this.plunger.position.z = 1.5 + (s.draw ?? 0) * 0.7;\n    if (name === 'gel') {\n      const sq = 1 - this.grip * (0.1 + Math.sin(this.bob * 30) * 0.03);\n      this.bottle.scale.set(sq, sq, 1 + (1 - sq));\n    }\n    // Beam.\n    this.beam.visible = name === 'laser' && use && !this.ghost;\n    if (this.beam.visible) {\n      const h = lift + 0.08;\n      this.beam.scale.set(1 + Math.sin(this.bob * 60) * 0.3, h, 1 + Math.sin(this.bob * 60) * 0.3);\n      this.beam.position.set(x, y + h / 2, z);\n    }\n    this.holo.visible = name === 'scanner' && use && !this.ghost;\n    if (this.holo.visible) { this.holo.position.set(x, y + 0.5, z); }\n    if (s.table !== undefined) this.group.visible = !this.hidden;\n  }\n  dispose() { this.ctx.scene.remove(this.group); }\n}\nEOF\ncat > src/view/entviews.js <<'EOF'\n// 3D objects for what's on the field, synced from state by id. Tissue is painted; these stand on it.\nimport { buildModel, glowMaterial, LegStepper, PALETTE, setLookLayer, Squash, SpringChain, THREE, toonMaterial, twoBoneIK } from '../../pixel-engine.js';\nimport { boltDef, cardDef, clampDef, clotDef, coinDef, cystDef, eggDef, fragmentDefs, haloDef, hookDef, introitCoreDef, keyDef, kidneyDef, magnetDef, miserereDef, paleCoreDef, polypDef, shardDef, strandDef, tumorDef, weeperEyeDef, wrathEyeDef, wrathPlateDef } from '../content/models/index.js';\n\nconst { BoxGeometry, Color, Group, Mesh, SphereGeometry, Vector3 } = THREE;\n\nconst PROP_DEFS = { key: keyDef, coin: coinDef, card: cardDef, magnet: magnetDef, shard: shardDef, bolt: boltDef, strand: strandDef };\n\nfunction ownMaterials(obj) {\n  obj.traverse((m) => {\n    if (m.isMesh) {\n      m.material = m.material.clone();\n      m.userData.base = m.material.color.clone();\n      m.material.userData = { ...m.material.userData, shared: false };\n    }\n  });\n}\nconst tmpC = new Color();\n\nexport class EntViews {\n  constructor(ctx, tableViews, fx) {\n    this.ctx = ctx;\n    this.tables = tableViews;\n    this.fx = fx;\n    this.map = new Map();\n    this.group = new Group();\n    ctx.scene.add(this.group);\n    this.dropMeshes = [];\n    this.dropGeo = new SphereGeometry(0.12, 6, 5);\n    this.dropMat = glowMaterial(PALETTE.cyan);\n    this.barGeo = new BoxGeometry(1, 1, 1);\n    this.tendrilMat = toonMaterial(PALETTE.plum);\n    this.tetherMat = toonMaterial(PALETTE.lime);\n    this.flying = [];\n  }\n\n  makeBar(mat, thick = 0.09) {\n    const m = new Mesh(this.barGeo, mat);\n    m.scale.set(thick, thick, 1);\n    m.castShadow = true;\n    setLookLayer(m, 'actors');\n    this.group.add(m);\n    return m;\n  }\n\n  build(e) {\n    let def = null, scale = 1, y = 0;\n    switch (e.k) {\n      case 'hook': def = hookDef; scale = 1.15; break;\n      case 'prop': def = PROP_DEFS[e.prop] ?? keyDef; scale = e.prop === 'strand' ? 1.5 : 1.2; break;\n      case 'magnet': def = magnetDef; scale = 1.3; break;\n      case 'debris': def = PROP_DEFS[e.prop] ?? shardDef; scale = 1.25; break;\n      case 'tumor': def = tumorDef; scale = (e.r ?? 1.1) * 1.3; break;\n      case 'polyp': def = polypDef; scale = (e.r ?? 0.34) * 2.6; break;\n      case 'egg': def = eggDef; scale = (e.r ?? 0.34) * 2.4; break;\n      case 'cyst': def = cystDef; scale = (e.r ?? 0.42) * 2.2; break;\n      case 'clot': def = clotDef; scale = 1.3; break;\n      case 'eye': def = e.heartEye ? wrathEyeDef : weeperEyeDef; scale = e.heartEye ? 1.1 : (e.r ?? 0.55) * 2.1; break;\n      case 'halo': def = haloDef; scale = 1; break;\n      case 'plate': def = wrathPlateDef; scale = 1.2; break;\n      case 'clamp': case 'unclamp': def = clampDef; scale = 1.3; break;\n      case 'fragment': def = fragmentDefs[(Number(String(e.shape ?? e.id).replace(/\\D/g, '')) || 1) - 1] ?? fragmentDefs[0]; scale = 1.05; break;\n      case 'organ': case 'donor': def = kidneyDef; scale = 1.25; break;\n      case 'core': def = e.id === 'palecore' ? paleCoreDef : e.twoHanded ? miserereDef : introitCoreDef; scale = e.twoHanded ? 0.55 : 0.9; break;\n      case 'stalk': def = weeperEyeDef; scale = 1.1; break;\n      case 'strain:miserere': def = miserereDef; scale = 1.1; break;\n      default: return null;\n    }\n    const b = buildModel(def);\n    const obj = b.object;\n    obj.traverse((m) => { if (m.isMesh) m.castShadow = true; });\n    const holder = new Group();\n    holder.add(obj);\n    obj.scale.setScalar(scale);\n    setLookLayer(holder, 'actors');\n    this.group.add(holder);\n    const v = { e, holder, obj, base: scale, squash: new Squash(), y, born: 0, seed: Math.random() };\n    v.squash.amount = 1.5;\n    if (e.k === 'organ' || e.k === 'donor') {\n      ownMaterials(obj);\n      v.tint = true;\n      const col = e.k === 'organ' ? new Color(0x5d3f58) : new Color(0x6a5572);\n      obj.traverse((m) => { if (m.isMesh) m.material.color.copy(col); });\n    }\n    if (e.heartEye || e.k === 'eye') {\n      v.lidA = obj.getObjectByName('lidA');\n      v.lidB = obj.getObjectByName('lidB');\n      v.iris = obj.getObjectByName('iris');\n    }\n    if (e.k === 'core' && !e.twoHanded) {\n      v.tether = this.makeBar(this.tetherMat, 0.11);\n      v.tendrils = [0, 1, 2].map((i) => ({ chain: new SpringChain({ segments: 4, length: 0.16, stiffness: 7, gravity: 3 }), bars: Array.from({ length: 4 }, () => this.makeBar(this.tendrilMat, 0.07)), a: (i / 3) * 6.28 }));\n    }\n    if (e.k === 'stalk') v.tether = this.makeBar(this.tetherMat, 0.13);\n    if (e.k === 'eye' && !e.heartEye) {\n      v.legs = new LegStepper({ legs: [{ rest: [-0.6, 0.3], partners: [1] }, { rest: [0.6, 0.3], partners: [0] }, { rest: [-0.5, -0.4], partners: [3] }, { rest: [0.5, -0.4], partners: [2] }], threshold: 0.28, stepTime: 0.16, lift: 0.14 });\n      v.legBars = Array.from({ length: 8 }, () => this.makeBar(this.tendrilMat, 0.07));\n      for (const b2 of v.legBars) b2.visible = false;\n    }\n    return v;\n  }\n\n  sync(state, s, dt) {\n    const seen = new Set();\n    for (const e of state.ents) {\n      if (e.dead) continue;\n      seen.add(e.id);\n      let v = this.map.get(e.id);\n      if (!v) {\n        v = this.build(e);\n        if (!v) { this.map.set(e.id, { e, none: true }); continue; }\n        this.map.set(e.id, v);\n      }\n      if (v.none) continue;\n      v.e = e;\n      this.place(v, e, state, s, dt);\n    }\n    for (const [id, v] of this.map) {\n      if (seen.has(id)) continue;\n      this.map.delete(id);\n      if (v.none) continue;\n      this.retire(v);\n    }\n    // Things flying to the dish.\n    for (let i = this.flying.length - 1; i >= 0; i--) {\n      const f = this.flying[i];\n      f.t += dt / f.dur;\n      const k = Math.min(1, f.t);\n      f.holder.position.set(f.from.x + (f.to.x - f.from.x) * k, f.from.y + (f.to.y - f.from.y) * k + Math.sin(k * Math.PI) * 1.4, f.from.z + (f.to.z - f.from.z) * k);\n      f.holder.rotation.y += dt * 11;\n      if (k >= 1) {\n        this.flying.splice(i, 1);\n        if (f.keep) { f.holder.rotation.y = f.seed * 6; f.holder.position.x += (f.seed - 0.5) * 0.6; f.holder.position.z += (f.seed - 0.5) * 0.3; f.holder.scale.setScalar(0.7); }\n        else this.group.remove(f.holder);\n        f.done?.();\n      }\n    }\n    // Droplets.\n    const drops = state.drops ?? [];\n    let n = 0;\n    for (const d of drops) {\n      if (d.dead) continue;\n      const tv = this.tables[d.table] ?? this.tables[0];\n      let m = this.dropMeshes[n];\n      if (!m) {\n        m = new Mesh(this.dropGeo, this.dropMat);\n        setLookLayer(m, 'actors');\n        this.group.add(m);\n        this.dropMeshes[n] = m;\n      }\n      m.visible = true;\n      m.position.set(tv.offsetX + d.x, tv.heightAt(d.x, d.z, s) + 0.14, d.z);\n      n++;\n    }\n    for (let i = n; i < this.dropMeshes.length; i++) this.dropMeshes[i].visible = false;\n  }\n\n  place(v, e, state, s, dt) {\n    const tv = this.tables[e.table] ?? this.tables[0];\n    const hidden = e.hidden || (e.k === 'plate' && false);\n    v.holder.visible = !hidden;\n    const surf = tv.heightAt(e.x, e.z, s);\n    v.born = Math.min(1, v.born + dt * 6);\n    let lift = 0;\n    const held = (e.holders ?? 0) > 0;\n    if (held) lift = 0.2;\n    if (e.free) lift = 0.55;\n    if (e.placed) lift = 0;\n    v.holder.position.set(tv.offsetX + e.x, surf + lift, e.z);\n    v.squash.update(dt);\n    if (held && !v.wasHeld) v.squash.kick(-3);\n    v.wasHeld = held;\n    const [h, vs] = v.squash.scale();\n    v.obj.scale.set(v.base * h * v.born, v.base * vs * v.born, v.base * h * v.born);\n    // Per-kind life.\n    if (e.k === 'hook') {\n      const h0 = e.path && e.len > 0 ? e.path : null;\n      if (h0) { const end = h0[h0.length - 1], st = h0[0]; v.obj.rotation.y = -Math.atan2(end[1] - st[1], end[0] - st[0]) + Math.PI / 2; }\n    }\n    if (e.k === 'fragment') v.obj.rotation.y = -((e.rot ?? 0) * Math.PI) / 180;\n    if (e.k === 'plate') {\n      v.obj.rotation.y = -(e.ang ?? 0) - Math.PI / 2;\n      v.obj.rotation.x = -0.25;\n      v.obj.position.y = e.locked ? 0 : 0.12;\n    }\n    if (e.k === 'polyp' || e.k === 'egg') v.obj.position.y = Math.sin(s.t * 3 + v.seed * 6) * 0.03;\n    if (e.k === 'egg' || e.k === 'polyp') {\n      if (e.heat > 0) v.holder.scale.setScalar(1 + Math.sin(s.t * 40) * 0.05 * e.heat);\n    }\n    if (e.k === 'cyst') {\n      // Scanned: real ones show their angry core; false ones go pale and quiet.\n      if (e.scanned && !v.marked) {\n        v.marked = true;\n        const bad = new Mesh(new SphereGeometry(0.2, 8, 6), glowMaterial(e.real ? PALETTE.red : PALETTE.green));\n        bad.position.y = 0.36;\n        v.obj.add(bad);\n      }\n    }\n    if (e.k === 'donor' && v.tint) {\n      const p = e.perfuse ?? 0;\n      tmpC.setHex(0x6a5572).lerp(new Color(0xd65c4f), p);\n      v.obj.traverse((m) => { if (m.isMesh) m.material.color.copy(tmpC); });\n      if (e.placed && p === 0) v.obj.rotation.y = 0;\n    }\n    if (e.k === 'eye') {\n      const openT = e.heartEye ? (e.locked ? 0 : 1) : e.open ? 1 : 0;\n      v.open = (v.open ?? 0) + (openT - (v.open ?? 0)) * Math.min(1, dt * (e.open ? 6 : 12));\n      if (v.lidA) {\n        v.lidA.rotation.x = -v.open * 1.35;\n        v.lidB.rotation.x = v.open * 1.35;\n        if (v.iris) { v.iris.position.x = Math.sin(s.t * 0.7 + v.seed * 9) * 0.1; v.iris.position.z = 0.04 + Math.cos(s.t * 0.9 + v.seed * 4) * 0.08; v.iris.visible = v.open > 0.15; }\n      }\n      if (e.heartEye) { v.obj.visible = !e.locked || (s.beat ?? 0) > 0.2; v.obj.scale.setScalar(v.base * (e.locked ? 0.7 : 1 + (s.beat ?? 0) * 0.08)); }\n      if (v.legs) {\n        const crawling = e.wx != null;\n        for (const b of v.legBars) b.visible = crawling;\n        if (crawling) this.updateLegs(v, tv, e, surf, s, dt);\n      }\n    }\n    if (e.k === 'strain:miserere') {\n      v.obj.position.y = 0.6 + Math.sin(s.t * 1.4) * 0.12;\n      v.obj.rotation.y = Math.sin(s.t * 0.5) * 0.25;\n    }\n    if (e.k === 'core' && v.tether) {\n      const hx = tv.offsetX + e.home[0], hz = e.home[1], hy = tv.heightAt(e.home[0], e.home[1], s) + 0.05;\n      this.stretch(v.tether, hx, hy, hz, v.holder.position.x, v.holder.position.y + 0.36, v.holder.position.z);\n      v.obj.rotation.y = s.t * (held ? 7 : 2);\n      for (const t of v.tendrils) {\n        const root = [v.holder.position.x + Math.cos(t.a + s.t) * 0.28, v.holder.position.y + 0.4, v.holder.position.z + Math.sin(t.a + s.t) * 0.28];\n        t.chain.update(dt, root, [[1, 0, 0], [0, 1, 0], [Math.cos(t.a), 0.3, Math.sin(t.a)]]);\n        for (let i = 0; i < t.bars.length; i++) {\n          const a = t.chain.points[i], b = t.chain.points[i + 1];\n          this.stretch(t.bars[i], a[0], a[1], a[2], b[0], b[1], b[2]);\n        }\n      }\n    }\n    if (e.k === 'stalk' && v.tether) {\n      const hx = tv.offsetX + e.home[0], hz = e.home[1], hy = tv.heightAt(e.home[0], e.home[1], s) + 0.05;\n      this.stretch(v.tether, hx, hy, hz, v.holder.position.x, v.holder.position.y + 0.3, v.holder.position.z);\n    }\n    if (s.hitboxes) this.fx?.hitbox?.(e, tv, surf);\n  }\n\n  updateLegs(v, tv, e, surf, s, dt) {\n    const body = [tv.offsetX + e.x, surf + 0.42, e.z];\n    const vel = [(e.wx - e.x) * 0.6, 0, (e.wz - e.z) * 0.6];\n    v.legs.update(dt, body, 0, vel, (x, z) => tv.heightAt(x - tv.offsetX, z, s));\n    const knee = [0, 0, 0];\n    v.legs.feet.forEach((f, i) => {\n      const hip = [body[0] + (i % 2 ? 0.3 : -0.3), body[1], body[2] + (i < 2 ? 0.14 : -0.14)];\n      twoBoneIK(hip, f.at, 0.42, 0.46, [hip[0] * 1 + (i % 2 ? 0.8 : -0.8), body[1] + 1.2, hip[2]], knee);\n      this.stretch(v.legBars[i * 2], hip[0], hip[1], hip[2], knee[0], knee[1], knee[2]);\n      this.stretch(v.legBars[i * 2 + 1], knee[0], knee[1], knee[2], f.at[0], f.at[1], f.at[2]);\n    });\n  }\n\n  stretch(mesh, ax, ay, az, bx, by, bz) {\n    const dx = bx - ax, dy = by - ay, dz = bz - az;\n    const l = Math.hypot(dx, dy, dz) || 0.001;\n    mesh.position.set((ax + bx) / 2, (ay + by) / 2, (az + bz) / 2);\n    mesh.scale.z = l;\n    mesh.lookAt(bx, by, bz);\n  }\n\n  retire(v) {\n    const e = v.e;\n    if (v.tether) this.group.remove(v.tether);\n    if (v.tendrils) for (const t of v.tendrils) for (const b of t.bars) this.group.remove(b);\n    if (v.legBars) for (const b of v.legBars) this.group.remove(b);\n    const kinds = new Set(['hook', 'prop', 'magnet', 'debris', 'tumor', 'organ', 'plate', 'core', 'unclamp', 'stalk']);\n    if (kinds.has(e.k) && this.fx?.dishAt) {\n      const from = v.holder.position.clone();\n      const to = this.fx.dishAt(e.table);\n      this.flying.push({ holder: v.holder, from, to, t: 0, dur: 0.32, seed: v.seed, keep: e.k === 'hook' || e.k === 'prop' || e.k === 'debris', done: () => this.fx.tink?.(e) });\n      return;\n    }\n    this.group.remove(v.holder);\n  }\n}\nEOF\necho ok","description":"Write App singleton, stage base, hand rig and entity views"}}}
