{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk2UcR6fSbKqkew4UX6J","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N5H4G7borAkYBi7JGfAzpZ","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport re\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"if (sim.stages?.[i]?.after) runCommands(sim, def.stages[i].after);\",\"if (def.stages[i].after) runCommands(sim, def.stages[i].after);\")\ns=s.replace(\"sim.gifts.includes('look') | sim.seats.some((s) => s.gift === 'look'))\",\"sim.seats.some((s) => s.gift === 'look'))\")\ns=s.replace(\"import { STRAINS } from './strains/index.js';\",\"import { stepHeart } from './strains/diesirae.js';\\nimport { STRAINS } from './strains/index.js';\")\ns=s.replace(\"    get: (id) => sim.ents.find((e) => e.id === id && !e.dead),\",\"    get: (id) => sim.ents.find((e) => e.id === id && !e.dead),\\n    notify: (e, what, seat) => notifyOwner(sim, e, what, seat),\")\n# heart + markers + cold in world step\ns=s.replace(\"  for (const d of sim.drops) stepDrop(sim, d, dtWorld);\",\"\"\"  stepHeart(sim, dtWorld, sim.api);\n  for (const e of sim.ents) {\n    if (e.k !== 'marker' || e.dead || e.hidden) continue;\n    if (sim.seats.some((s) => s.table === e.table && !s.gone && dist(s.x, s.z, e.x, e.z) <= 0.55)) {\n      emit(sim, 'marker', { x: e.x, z: e.z });\n      removeEnt(sim, e);\n      if (e.onDone) runCommands(sim, e.onDone);\n    }\n  }\n  if (sim.cold != null) {\n    sim.cold -= dtWorld;\n    if (sim.cold <= 0 && !sim.cheats.god) { sim.cold = 0; lose(sim, 'cold'); }\n  }\n  for (const d of sim.drops) stepDrop(sim, d, dtWorld);\"\"\")\n# commands\ns=s.replace(\"    if (c.rand) randomSpawn(sim, c.rand);\",\"\"\"    if (c.rand) randomSpawn(sim, c.rand);\n    if (c.cold !== undefined) { sim.cold = c.cold; emit(sim, 'cold', { cold: c.cold }); }\n    if (c.lock) { const e = sim.ents.find((o) => o.id === c.lock && !o.dead); if (e) e.locked = true; }\n    if (c.unlockEnt) { const e = sim.ents.find((o) => o.id === c.unlockEnt && !o.dead); if (e) e.locked = false; }\n    if (c.ifPersist) runCommands(sim, sim.persist[c.ifPersist] ? c.then : c.else);\n    if (c.count) {\n      sim.counters[c.count] = (sim.counters[c.count] ?? 0) + 1;\n      const line = c.lines?.[sim.counters[c.count] - 1];\n      if (line) say(sim, line);\n    }\"\"\")\ns=s.replace(\"    pain: 0, handGhost: null, tag: 0,\",\"    pain: 0, handGhost: null, tag: 0, counters: {}, cold: null,\")\nopen(p,'w').write(s)\np='src/sim/tools.js'; s=open(p).read()\ns=s.replace(\"\"\"    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\"\"\",\"\"\"    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    if (target.hp != null) {\n      // Eyes survive a burn; their owner decides.\n      api.rate(seat, q, target.x, target.z);\n      target.heat = 0;\n      target.stray = 0;\n      api.notify(target, 'burned', seat);\n      return;\n    }\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\"\"\")\nopen(p,'w').write(s)\np='src/sim/entities.js'; s=open(p).read()\ns=s.replace(\"  if (e.k === 'mask') {\\n    const c = e.cells.find((m) => !m[2]);\\n    return c ? { tool: 'gel', x: c[0], z: c[1] } : null;\\n  }\",\"  if (e.k === 'mask') {\\n    const c = e.cells.find((m) => !m[2]);\\n    return c ? { tool: 'gel', x: c[0], z: c[1] } : null;\\n  }\\n  if (e.k === 'marker') return { tool: 'marker', x: e.x, z: e.z };\")\ns=s.replace(\"if (t.tool !== 'dressing' && !sim.tools.includes(t.tool)) continue;\",\"if (t.tool !== 'dressing' && t.tool !== 'marker' && !sim.tools.includes(t.tool)) continue;\")\nopen(p,'w').write(s)\np='src/sim/bot.js'; s=open(p).read()\ns=s.replace(\"  if (tool !== 'dressing') {\\n    out.tool = tool;\",\"  if (tool !== 'dressing' && tool !== 'marker') {\\n    out.tool = tool;\")\ns=s.replace(\"    default: break;\\n  }\\n  out.x = b.x;\\n  out.z = b.z;\\n  if (context) out.tool = seat.tool;\",\"    default:\\n      moveTo(b, seat, task.x, task.z, speed);\\n      break;\\n  }\\n  out.x = b.x;\\n  out.z = b.z;\\n  if (context) out.tool = seat.tool;\")\nopen(p,'w').write(s)\nEOF\ncat > src/content/ops/_kit.js <<'EOF'\n// Small helpers for writing ops. Everything they return is plain JSON-safe data.\nexport const closeUp = ({ sutures = [], gel = null, dressing = { at: [-3, 0.4], ang: 0, len: 6 }, gelSay = null, sutureSay = null, dressSay = \"reyes|Dress it. Straight line, Doctor. You've seen a line.\" } = {}) => {\n  const out = [];\n  if (sutures.length) out.push({ id: 'close-suture', objective: 'SUTURE THE WOUNDS', say: sutureSay, hint: 'suture', spawn: sutures.map((s) => ({ k: 'laceration', ...s })), until: { clear: ['laceration'] } });\n  if (gel) out.push({ id: 'close-gel', objective: 'GEL THE SITE', say: gelSay, hint: 'gel', spawn: [{ k: 'mask', ...gel }], until: { clear: ['mask'] } });\n  if (dressing) out.push({ id: 'dressing', objective: 'DRESS IT: DRAG THE STRIP ALONG THE LINE', say: dressSay, context: 'dressing', spawn: [{ k: 'dressing', id: 'dress', ...dressing }], until: { clear: ['dressing'] } });\n  return out;\n};\nEOF\ncat > src/content/ops/op1.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nconst COUNT = ['reyes|One.', 'reyes|Two.', 'reyes|Three. Keep breathing, Doctor.', 'reyes|Four.', 'reyes|Five. He stopped screaming at three.', 'reyes|Six.', 'reyes|Seven.', 'reyes|Eight. Slower.', 'reyes|Nine.', 'reyes|Ten.', 'reyes|Eleven. That is the count on the chart.'];\nconst hook = (id, at, dir, arc, extra = {}) => ({ k: 'hook', id, at, dir, arc, pull: 1.25, onDone: [{ count: 'hooks', lines: COUNT }], ...extra });\n\nexport default {\n  id: 'op1', num: 1, title: 'ELEVEN HOOKS', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel'], music: 'or-calm',\n  scene: 'ep1',\n  patient: {\n    name: 'TOMASZ DOLAN', age: 52, job: 'TRAWLER DECKHAND', hook: \"HIS DAUGHTER'S WEDDING IS SATURDAY.\",\n    objective: 'BACK ELEVEN FISHHOOKS OUT OF ONE ARM. THEN THE TWELFTH.',\n    followUp: { S: 'He walked her down the aisle. Dry eyes. Hers, not his.', A: 'He made the wedding. He shows the scar to everyone.', B: 'He made the wedding. He dropped the cake with the bad hand.', C: 'He danced badly. She cried anyway.' },\n  },\n  time: 240, vitals: { start: 85, drain: 0.1 }, doses: 3, ring: [-5.1, 2.1],\n  anyStage: { vitalsBelow: { 50: { say: 'reyes|He is fading. *Syringe.* Draw with {use}, let go in the ring.', unlock: 'syringe' } } },\n  stages: [\n    { id: 'marker', objective: 'MOVE YOUR INSTRUMENT ONTO THE MARKER', say: ['reyes|This is your hand. That is the patient. Do not confuse them.', 'reyes|Move your instrument onto the marker, Doctor.'], spawn: [{ k: 'marker', at: [0, 0.2] }], until: { clear: ['marker'] } },\n    { id: 'pools', objective: 'DRAIN THE BLOOD: HOLD {use} ON A POOL', hint: 'drain', say: ['ilya|I can do this. I can do this. Nurse Reyes, can I do this?', 'reyes|Drain first. You cannot fix what you cannot see. Hold {use}.'],\n      spawn: [{ k: 'pool', id: 'p1', at: [-3, 0.5], r: 1.5 }, { k: 'pool', id: 'p2', at: [2.6, -0.4], r: 1.3 }, hook('h1', [-3.4, 0.7], -70, 0.8, { hiddenBy: 'p1' }), hook('h2', [-2.3, 0.1], -100, -0.8, { hiddenBy: 'p1' }), hook('h3', [2.6, -0.1], -80, 0.8, { hiddenBy: 'p2' })],\n      until: { clear: ['pool'] } },\n    { id: 'hooks', objective: 'FORCEPS: BACK EACH HOOK OUT ALONG ITS ARROW', hint: 'forceps', say: ['reyes|Barbs. Back them out along the *curve*, or they take him with them.', 'reyes|Forceps. Hold {use} on the hook, follow the arrow, then let go.', 'ilya|How do you get eleven fishhooks in one arm?', 'pem|It was a long net.'],\n      spawn: [hook('h4', [-5.2, -0.5], -60, 0.8), hook('h5', [-4.4, 1.5], -80, -0.8), hook('h6', [-0.9, -0.9], -110, 0.8), hook('h7', [-0.2, 1.3], -70, 0.8), hook('h8', [1.2, 0.5], -90, -0.8), hook('h9', [3.9, 1.4], -100, 0.8), hook('h10', [4.6, -0.7], -60, -0.8), hook('h11', [5.3, 1.1], -120, 0.8)],\n      until: { clear: ['hook'] } },\n    ...closeUp({ sutures: [{ id: 'l1', at: [-4.2, 0.2], ang: 8, len: 2.6 }, { id: 'l2', at: [1.4, 0.3], ang: -10, len: 2.6 }], sutureSay: ['reyes|Two lacerations. *Suture.* Zigzag across the wound, slot by slot.', 'reyes|Hold {use} and cross the line. In rhythm. It is not a race. Yet.'], gel: { id: 'rust', at: [0, -0.2], rx: 1.8, rz: 1.1 }, gelSay: ['reyes|Rust. That hook was older than you. *Gel* it. Sweep with {use}.'], dressing: null }),\n    { id: 'dress1', objective: 'DRESS IT: DRAG THE STRIP ALONG THE LINE', context: 'dressing', say: \"reyes|Dress it. Hold {use}. Straight line, Doctor. You've seen a line.\", spawn: [{ k: 'dressing', id: 'dress', at: [-3.2, 1.0], ang: 0, len: 2.6 }], until: { clear: ['dressing'] } },\n    { id: 'twelve', objective: 'ONE MORE HOOK', hint: 'forceps', say: ['ilya|...That is eleven, right?', 'reyes|Twelve. I counted twelve.', 'pem|It was a very long net.'], do: [{ fx: 'shake' }], spawn: [{ k: 'hook', id: 'h12', at: [0.8, -1.4], dir: -100, arc: 0.9, pull: 1.4 }], until: { clear: ['hook'] } },\n    { id: 'dress2', objective: 'FINISH THE DRESSING', context: 'dressing', spawn: [{ k: 'dressing', id: 'dress2', at: [-0.4, 1.0], ang: 0, len: 3.6 }], until: { clear: ['dressing'] } },\n  ],\n};\nEOF\ncat > src/content/ops/op2.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op2', num: 2, title: 'THE VANISHING ACT', arena: 'stomach', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'scanner', 'laser'], music: 'or-calm',\n  scene: 'ep2',\n  patient: {\n    name: 'THE GREAT ZAMBONI', age: 61, job: 'STAGE MAGICIAN', hook: \"HE SWALLOWED SOMETHING DURING HIS ACT. HE WON'T SAY WHAT.\",\n    objective: 'FIND WHAT HE SWALLOWED. TAKE IT OUT. ALL OF IT.',\n    followUp: { S: 'They got it early. He does the coin trick on the ward now. Badly, on purpose.', A: 'Clean margins. He sent the staff a deck of cards, all sevens.', B: 'He starts chemo Monday. He has already made the IV pole disappear.', C: 'He has a year, maybe. He says he has done more with less.' },\n  },\n  time: 300, vitals: { start: 80, drain: 0.15 }, doses: 3, ring: [-5.1, 2.1],\n  onRewind: null,\n  stages: [\n    { id: 'open', objective: 'SCALPEL: FOLLOW THE DOTTED LINE', hint: 'scalpel', say: ['reyes|*Scalpel.* The sharp end goes toward the patient, Doctor. We have discussed this.', 'reyes|Start at the top of the line. Hold {use}. Trace it. Do not improvise.'],\n      spawn: [{ k: 'incision', id: 'midline', at: [-2.8, -0.2], ang: 0, len: 5.6 }], until: { clear: ['incision'] } },\n    { id: 'bleeders', objective: 'DRAIN THE BLEEDERS ALONG THE CUT', hint: 'drain', say: 'reyes|Bleeders. They refill while you admire them. Drain, Doctor.',\n      spawn: [{ k: 'bleeder', id: 'b1', at: [-1.8, 0.9], r: 0.8 }, { k: 'bleeder', id: 'b2', at: [1.2, -1.2], r: 0.8 }, { k: 'bleeder', id: 'b3', at: [2.8, 0.8], r: 0.7 }], until: { clear: ['bleeder'] } },\n    { id: 'scan', objective: 'SCANNER: FIND WHAT HE SWALLOWED', hint: 'scanner', say: ['pem|He told me he swallowed nothing. Then he sneezed and a dove came out.', 'reyes|*Scanner.* Hold {use} and sweep. Four things in there. Find them.'],\n      spawn: [\n        { k: 'prop', id: 'key', prop: 'key', at: [-3.6, -1.2], hidden: true, lance: true, dir: -80, pull: 1.3, lanceAng: 20, onReveal: [{ say: 'ilya|A key. There is a key in his stomach.' }] },\n        { k: 'prop', id: 'coin', prop: 'coin', at: [-1.0, 1.2], hidden: true, lance: true, dir: -100, pull: 1.3, lanceAng: -15, onReveal: [{ say: 'reyes|A coin. The gentleman is at least consistent.' }] },\n        { k: 'prop', id: 'card', prop: 'card', at: [2.0, -1.4], hidden: true, lance: true, dir: -70, pull: 1.3, lanceAng: 10, onReveal: [{ say: 'ilya|...Seven of clubs. Is that your card, Nurse Reyes?' }] },\n        { k: 'magnet', id: 'mag', prop: 'magnet', at: [3.6, 0.8], hidden: true, lance: true, dir: -90, pull: 1.6, speedLimit: 2.4, lanceAng: 0, onReveal: [{ say: 'reyes|Magnets. Pull *slowly* or they snap back. Hold {steady}.' }] },\n      ],\n      until: { clear: ['prop', 'magnet', 'incision'] } },\n    { id: 'turn', objective: 'SCAN AGAIN', hint: 'scanner', music: 'or-tense', say: ['ilya|That is everything. Coin, key, card, magnets. Ta-da.', 'reyes|Scan it again, Doctor.'],\n      spawn: [{ k: 'tumor', id: 'tum', at: [-0.4, -0.4], r: 1.15, hidden: true, dir: -90, pull: 1.7, onReveal: [{ say: ['ilya|...Is that a prop?', \"reyes|...That one isn't a prop.\", 'pem|Sleep well, maestro.'] }] }],\n      until: { clear: ['incision'], flag: 'never' } , timed: [] },\n    { id: 'tumor', objective: 'CUT AROUND THE TUMOUR. LIFT IT OUT.', hint: 'scalpel', say: 'reyes|All the way round. Then forceps. No more jokes in this room.', until: { clear: ['incision', 'tumor'] } },\n    { id: 'polyps', objective: 'LASER: BURN THE FIVE POLYPS', hint: 'laser', say: ['reyes|Satellites. *Laser.* Hold {use} on each until it goes.', 'reyes|Stay on target. Healthy tissue has done nothing to you.'],\n      spawn: [{ k: 'polyp', at: [-3.4, 0.6] }, { k: 'polyp', at: [-1.6, -1.8] }, { k: 'polyp', at: [0.8, 1.5] }, { k: 'polyp', at: [2.6, -0.6] }, { k: 'polyp', at: [4, 1.4] }], until: { clear: ['polyp'] } },\n    { id: 'drain2', objective: 'DRAIN THE FIELD', hint: 'drain', spawn: [{ k: 'pool', at: [-0.4, -0.2], r: 1.2 }], until: { clear: ['pool'] } },\n    ...closeUp({ sutures: [{ at: [-2.6, 0.1], ang: 2, len: 5.2 }], sutureSay: 'reyes|Close him. He has a Saturday show he is not going to make.', gel: { at: [0, 0], rx: 2.1, rz: 1 }, gelSay: 'reyes|Gel. Then we find his family, Doctor. You will do the talking.', dressing: { at: [-3, 1.1], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. Hold {use}. He deserves one straight line today.' }),\n  ],\n};\nEOF\npython3 - <<'EOF'\np='src/content/ops/op2.js'; s=open(p).read()\ns=s.replace(\"until: { clear: ['incision'], flag: 'never' } , timed: [] },\",\"until: { clear: ['marker'], flag: 'tumorFound' } },\")\ns=s.replace(\"hidden: true, dir: -90, pull: 1.7, onReveal: [{ say:\",\"hidden: true, dir: -90, pull: 1.7, onReveal: [{ flag: 'tumorFound' }, { say:\")\nopen(p,'w').write(s)\nEOF\ncat > src/content/ops/op3.js <<'EOF'\n// Night Ferry: three tables, one doctor. The Quiet awakens on the crash at about 70%.\nexport default {\n  id: 'op3', num: 3, title: 'NIGHT FERRY', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep3',\n  patient: {\n    name: 'THREE FERRY PASSENGERS', age: '-', job: 'TABLES A, B AND C', hook: 'A TEACHER. A DECKHAND. A BOY WHO WAS ONLY GOING TO THE DENTIST.',\n    objective: 'THREE TABLES. ONE DOCTOR. KEEP ALL THREE ALIVE.',\n    followUp: { S: 'All three walked out. The boy still has to go to the dentist.', A: 'All three lived. The teacher sends the ward her marking to do.', B: 'All three lived. Nobody is sure how, least of all you.', C: 'Three lived. The ferry company has already sent a coupon.' },\n  },\n  time: 360, vitals: { start: 70, drain: 0.25 }, doses: 5,\n  tables: [{ arena: 'leg', vitals: 70, drain: 0.25, name: 'A' }, { arena: 'hull', vitals: 60, drain: 0.25, name: 'B' }, { arena: 'chestwound', vitals: 55, drain: 0.25, name: 'C' }],\n  stages: [\n    { id: 'batch1', objective: 'THREE TABLES. {table} SWITCHES. WATCH ALL THREE MONITORS.', say: ['reyes|Three tables. One of you. God help them.', 'reyes|{table} to switch tables. Do not fall in love with any of them.'],\n      spawn: [\n        { k: 'pool', table: 0, at: [-1.6, 0.3], r: 1.2 }, { k: 'laceration', table: 0, at: [0.4, 0.4], ang: 6, len: 2.6 },\n        { k: 'debris', table: 1, at: [-2, -0.4], dir: -80, pull: 1.3, prop: 'shard' }, { k: 'debris', table: 1, at: [2.1, 0.6], dir: -100, pull: 1.3, prop: 'bolt' },\n        { k: 'pool', table: 2, at: [0.2, 0], r: 1.3 },\n      ], until: { clear: true } },\n    { id: 'batch2', objective: 'NEW INJURIES ON ALL THREE TABLES', say: 'reyes|Table B has burns. Table C needs opening. Table A is still leaking. Go.',\n      spawn: [\n        { k: 'bleeder', table: 0, at: [2.8, -0.8], r: 0.8 },\n        { k: 'mask', table: 1, at: [0, 0.4], rx: 2, rz: 1.1 }, { k: 'debris', table: 1, at: [-3.6, 1.3], dir: -70, pull: 1.3, prop: 'shard' },\n        { k: 'incision', table: 2, at: [-2.2, 0.4], ang: -6, len: 4.4 },\n      ], until: { clear: true } },\n    { id: 'batch3', objective: 'KEEP MOVING', say: 'pem|Vitals are in the basement. I would take the stairs, Doctor.',\n      spawn: [\n        { k: 'laceration', table: 0, at: [-3.2, -1], ang: -8, len: 2.2 },\n        { k: 'debris', table: 1, at: [3.8, -1.2], dir: -120, pull: 1.3, prop: 'bolt' },\n        { k: 'polyp', table: 2, at: [-1.8, -1.4], r: 0.38 }, { k: 'polyp', table: 2, at: [1.6, -1.2], r: 0.38 }, { k: 'pool', table: 2, at: [0, 1.3], r: 0.9 },\n      ], until: { clear: true } },\n    { id: 'crash', objective: 'TABLE C IS CRASHING. HOLD {gift}.', music: 'or-critical',\n      do: [{ focus: true, table: 2, cue: 'quietAwaken' }, { setVitals: 22, table: 2 }, { unlock: 'gift' }, { composure: 100 }, { prompt: 'HOLD {gift}. THE ROOM GOES QUIET.', promptT: 8 }],\n      say: ['reyes|Table C! His pressure is going! *Doctor!*', 'ilya|No. No no no. Not this one. Not...'],\n      spawn: [\n        { k: 'bleeder', table: 2, at: [-2.2, -0.6], r: 1.05, grow: 0.5, max: 2 }, { k: 'bleeder', table: 2, at: [2.4, -0.4], r: 1.05, grow: 0.5, max: 2 }, { k: 'laceration', table: 2, at: [-1.4, 0.6], ang: 4, len: 2.8 },\n      ],\n      until: { clear: true } },\n    { id: 'after', objective: 'CLOSE THEM. ALL OF THEM.', music: 'or-tense', say: ['ilya|The room... It went quiet. Did the room just go quiet?', 'reyes|You are talking, Doctor. Why are you talking? Sew.'],\n      spawn: [\n        { k: 'pool', table: 0, at: [2, 1.1], r: 0.9 },\n        { k: 'mask', table: 1, at: [-1, -1], rx: 1.6, rz: 0.9 },\n        { k: 'laceration', table: 2, at: [-2.2, -1.8], ang: 2, len: 4.2 },\n      ], until: { clear: true } },\n    { id: 'dressC', objective: 'DRESS TABLE C', context: 'dressing', say: 'reyes|Table C. Dress him. Then go and stand somewhere nobody can see you shake.',\n      do: [{ focus: true, table: 2 }],\n      spawn: [{ k: 'dressing', table: 2, at: [-2.4, 1.4], ang: 0, len: 4.8 }], until: { clear: ['dressing'] } },\n  ],\n};\nEOF\ncat > src/content/ops/op4.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Bone Mend. Sabine's cold commentary replaces some of Reyes's lines.\nconst FRAG = (id, at, to, rot, extra = {}) => ({ k: 'fragment', id, at, to, rot, rotTo: 0, shape: id, ...extra });\n\nexport default {\n  id: 'op4', num: 4, title: 'STICKS AND STONES', arena: 'bone', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-calm',\n  scene: 'ep4', commenter: 'sabine',\n  patient: {\n    name: 'OLLIE BRANDT', age: 16, job: 'FERRY SURVIVOR', hook: 'HE WANTS TO PITCH AGAIN. HE HAS NOT ASKED YOU IF HE CAN. HE ASKED THE NURSE.',\n    objective: 'REBUILD A SHATTERED FOREARM. THE CONSULTANT IS WATCHING.',\n    followUp: { S: 'He threw a strike in April. He has told no one where the scar came from.', A: 'He is pitching again by spring. Sidearm. It suits him.', B: 'He will throw again. Not hard. He has started keeping score instead.', C: 'He keeps the arm. He keeps the ball on the shelf, too.' },\n  },\n  time: 330, vitals: { start: 75, drain: 0.2 }, doses: 3,\n  stages: [\n    { id: 'open', objective: 'OPEN ALONG THE LINE', hint: 'scalpel', say: ['sabine|Dr. Achterberg. I will be watching from the gallery. Begin.', \"sabine|You have two options. The second one is also wrong. Cut.\"], spawn: [{ k: 'incision', at: [-3.2, -2.1], ang: 0, len: 6.4 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN THE FIELD', hint: 'drain', say: 'reyes|There are bone pieces under that. Drain. Gently.',\n      spawn: [{ k: 'pool', id: 'p1', at: [-2.8, 1.4], r: 1.1 }, { k: 'pool', id: 'p2', at: [2.8, 1.3], r: 1.1 }], until: { clear: ['pool'] } },\n    { id: 'mend', objective: 'BONE MEND: CARRY EACH PIECE TO ITS SILHOUETTE, TURN IT, LET GO', hint: 'forceps',\n      say: ['reyes|Forceps. Hold {use} to carry, {rotate} to turn. Fit it to the outline.', 'sabine|Within five degrees is correct. Within fifteen is merely legal.'],\n      spawn: [\n        FRAG('f1', [-3.3, 1.5], [-3.5, 0], 40, { hiddenBy: 'p1' }), FRAG('f2', [-2.1, 1.6], [-2.1, -0.05], -30, { hiddenBy: 'p1' }),\n        FRAG('f3', [-0.6, -1.8], [-0.7, 0.03], 70), FRAG('f4', [0.8, -1.7], [0.7, -0.03], -60),\n        FRAG('f5', [2.3, 1.5], [2.1, 0.05], 25, { hiddenBy: 'p2' }), FRAG('f6', [3.7, -1.7], [3.5, 0], -45),\n      ], until: { clear: ['fragment'] } },\n    { id: 'cement', objective: 'GEL CEMENT ALONG THE SEAMS', hint: 'gel', say: 'reyes|Cement. Gel it along the whole seam. He has to throw with this.', spawn: [{ k: 'mask', path: [[-4.6, 0], [4.6, 0]] }], until: { clear: ['mask'] } },\n    { id: 'artery', objective: 'THE ARTERY: SUTURE IT, FAST', hint: 'suture', music: 'or-tense',\n      do: [{ fx: 'shake' }], say: ['ilya|That is... that is a lot of blood. Why is that a lot of blood?', 'reyes|Radial artery. *Suture!* Now, Doctor!'],\n      spawn: [{ k: 'laceration', id: 'art', at: [-1, 1.7], ang: 0, len: 2.2 }, { k: 'pool', id: 'art-p', at: [0.1, 2.0], r: 1, grow: 0.25, task: false }], until: { clear: ['laceration'] } },\n    { id: 'blue', objective: 'CODE BLUE: HOLD BOTH TRIGGERS, RELEASE IN THE GREEN', say: ['pem|He has flatlined. Terribly sorry. Paddles, Doctor.', 'reyes|Hold both. Let go in the *green*. Twice. Do not touch the table.'],\n      do: [{ setVitals: 8 }, { codeBlue: { then: [{ flag: 'revived' }, { say: 'sabine|Twelve seconds to spare. Do not celebrate. Close.' }] } }], until: { flag: 'revived' } },\n    ...closeUp({ sutures: [{ at: [-3, -2.1], ang: 0, len: 6 }], sutureSay: 'reyes|Close the long cut. In rhythm, Doctor. The boy is sixteen.', gel: { at: [0, -0.1], rx: 2.4, rz: 0.9 }, dressing: { at: [-3, 1.4], ang: 0, len: 6 }, dressSay: 'sabine|Dress it. I will write down that you finished.' }),\n  ],\n  outro: 'sabine|Adequate.',\n};\nEOF\ncat > src/content/ops/op5.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op5', num: 5, title: 'INTROIT', arena: 'liver', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep5', boss: 'introit',\n  patient: {\n    name: 'MR. ANSELM', age: 58, job: 'HARBOUR PILOT', hook: 'HIS ABDOMEN IS LIKE A BAG OF KNIVES. HE FEELS NOTHING. \"ISN\\'T IT WONDERFUL?\"',\n    objective: 'FIND WHAT IS MOVING IN HIS LIVER. TAKE IT OUT.',\n    followUp: { S: 'He woke up in agony and cried with relief. He is back on the harbour.', A: 'He hurts. He complains constantly. Reyes smiles every time.', B: 'He will not pilot again. He has taken up shouting at the ferries from the shore.', C: 'He lives. He asks, some nights, whether it could be put back.' },\n  },\n  time: 360, vitals: { start: 80, drain: 0.3 }, doses: 4,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['reyes|He is smiling, Doctor. His liver looks like a shipwreck, and he is smiling.', 'pem|He told me a joke on the way under. It was quite good.'], spawn: [{ k: 'incision', at: [-3, -2.8], ang: 3, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN', hint: 'drain', spawn: [{ k: 'pool', at: [-2.4, -0.6], r: 1.2 }, { k: 'pool', at: [2.2, 0.4], r: 1.2 }], until: { clear: ['pool'] } },\n    { id: 'scan', objective: 'SCANNER: SOMETHING MOVED', hint: 'scanner', say: ['ilya|It moved. Nurse Reyes, the liver moved.', 'reyes|Livers do not move, Doctor.', 'ilya|This one *knocked*.'],\n      spawn: [{ k: 'strain:introit', id: 'introit', hidden: true, hp: 3, deadFlag: 'introitDead', onReveal: [{ flag: 'found' }, { say: ['reyes|What is that. What *is* that.', 'sabine|...', 'sabine|Get it out.'] }, { music: 'boss-introit' }] }],\n      until: { flag: 'found' } },\n    { id: 'fight', objective: 'WHEN IT KNOCKS: LANCE THE PORE. FORCEPS THE CORE. PULL.', hint: 'scalpel',\n      say: ['sabine|When it surfaces, lance the pore. Short stroke. Do not answer it until you are ready.', 'sabine|Then forceps. Pull against the tether. Do not let go.'],\n      until: { all: [{ flag: 'introitDead' }, { clear: ['laceration'] }] } },\n    { id: 'eggs', objective: 'LASER THE EGGS', hint: 'laser', music: 'or-tense', say: ['reyes|It left something behind. Six. *Laser.* All of them, Doctor.', 'ilya|Eggs. Those are eggs. Why are there eggs?'],\n      spawn: [[-4, -1.6], [-1.8, 1.2], [-0.4, -2], [1.4, 1.4], [3, -1.6], [4.2, 0.6]].map((at) => ({ k: 'egg', at, r: 0.36 })), until: { clear: ['egg'] } },\n    ...closeUp({ sutures: [{ at: [-3, -2.8], ang: 3, len: 6 }], sutureSay: 'reyes|Close him. We are all going to pretend we are calm until he is in recovery.', gel: { at: [0, 0], rx: 2.6, rz: 1.1 }, dressing: { at: [-2.8, 1.8], ang: -2, len: 5.6 } }),\n  ],\n};\nEOF\ncat > src/content/ops/op6.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Cold Hands. Sabine at the table. The first unclamp bursts regardless, and that teaches The Second Look.\nexport default {\n  id: 'op6', num: 6, title: 'COLD HANDS', arena: 'kidneybed', surgeon: 'sabine', gifts: ['look'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-calm',\n  scene: 'ep6',\n  patient: {\n    name: 'ADA OKOYE', age: 47, job: \"PEM'S SISTER. SCHOOL BUS DRIVER.\", hook: 'A DONOR KIDNEY FROM THE MERCY FOUNDATION BANK. PEM IS PASSING GAS FOR HIS OWN SISTER.',\n    objective: 'TRANSPLANT. THE ICE ONLY BUYS YOU TWO MINUTES.',\n    followUp: { S: 'She is back on the route. The children say she drives faster now.', A: 'The kidney took. Pem has stopped making puns for almost a week.', B: 'The kidney took. She will be on pills a long time, and she drives anyway.', C: 'She lives. Pem sits with her in the mornings and says nothing at all.' },\n  },\n  time: 360, vitals: { start: 80, drain: 0.2 }, doses: 3,\n  onRewind: [{ spawn: [{ k: 'clot', id: 'clot', at: [-1.4, -0.9], r: 0.5, unlocks: 'uc1' }] }, { lock: 'uc1' }, { say: 'sabine|There. See it now? *Laser* the clot. Then again.' }, { composure: 0 }],\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['sabine|Reyes. I will take this one. Stand where I can hear you disapprove.', 'reyes|Yes, Doctor. She said it like she meant it.'], spawn: [{ k: 'incision', at: [-3, -2.6], ang: 2, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'clamps', objective: 'FORCEPS: CLAMP BOTH VESSELS', hint: 'forceps', say: 'sabine|Clamp the artery, clamp the vein. Carry each clamp to its mark.',\n      spawn: [{ k: 'clamp', id: 'c1', at: [-5.2, 1.6], to: [-1.4, -0.9], tol: 0.6 }, { k: 'clamp', id: 'c2', at: [-4.4, 1.9], to: [1.4, -0.9], tol: 0.6 }], until: { clear: ['clamp'] } },\n    { id: 'cut', objective: 'SCALPEL: CUT BOTH VESSELS', hint: 'scalpel', say: 'sabine|Short strokes. It is a kidney. It is not your enemy yet.',\n      spawn: [{ k: 'incision', at: [-1.9, -0.25], ang: 0, len: 1, short: true }, { k: 'incision', at: [0.9, -0.25], ang: 0, len: 1, short: true }], until: { clear: ['incision'] } },\n    { id: 'lift', objective: 'FORCEPS: LIFT OUT THE FAILING KIDNEY', hint: 'forceps', say: 'reyes|Out it comes. Mind the ureter. She needs that.', spawn: [{ k: 'organ', id: 'oldkidney', at: [0, 0.7], dir: -90, pull: 2.8, grabR: 0.8, tearMul: 1.8, organ: 'old' }], until: { clear: ['organ'] } },\n    { id: 'donor', objective: 'FETCH THE DONOR KIDNEY FROM THE ICE TRAY', hint: 'forceps', music: 'or-tense',\n      do: [{ cold: 120 }], say: ['reyes|Donor kidney on ice. *Two minutes*, Doctor. The clock on the tray is the one that matters.', 'pem|From the Mercy Foundation bank. Very generous. Very clean paperwork.'],\n      spawn: [{ k: 'donor', id: 'newkidney', at: [4.6, -2.6], to: [0, 0.7], tol: 0.8, grabR: 0.6, keep: true, perfuse: 0 }], until: { clear: ['donor'] } },\n    { id: 'anast', objective: 'SUTURE THE ARTERY, THE VEIN, THE URETER', hint: 'suture', say: 'sabine|Three anastomoses. Short. Precise. Your hands are colder than the ice. Use that.',\n      spawn: [{ k: 'laceration', at: [-1.4, -0.5], ang: 0, len: 1.4, bleed: false }, { k: 'laceration', at: [0.6, -0.6], ang: 0, len: 1.4, bleed: false }, { k: 'laceration', at: [-0.7, 2], ang: 0, len: 1.4, bleed: false }], until: { clear: ['laceration'] } },\n    { id: 'unclamp', objective: 'FORCEPS: PULL THE ARTERY CLAMP', hint: 'forceps', do: [{ cold: null }, { remove: ['c1', 'c2'] }], say: 'sabine|Unclamp. Artery first. Slowly.',\n      spawn: [{ k: 'unclamp', id: 'uc1', at: [-1.4, -0.9], dir: -90, pull: 1.1, onDone: [{ ifPersist: 'looked', then: [{ flag: 'cleanOpen' }], else: [{ flag: 'clotBurst' }, { fx: 'shake' }, { vitals: -10 }, { composure: 100 }, { spawn: [{ k: 'bleeder', id: 'burst1', at: [-1.2, 0], r: 1.4, grow: 0.4, max: 2, task: true }, { k: 'bleeder', id: 'burst2', at: [1.1, 0.4], r: 1, grow: 0.3, max: 1.8, task: true }] }, { say: ['ilya|Clot! There was a clot! Nobody could have seen...', 'sabine|Again.'] }, { prompt: 'PRESS {gift}: THE SECOND LOOK. SEE IT BEFORE IT HAPPENS.', promptT: 12 }] }] }],\n      until: { any: [{ flag: 'clotBurst' }, { flag: 'cleanOpen' }] } },\n    { id: 'again', objective: 'PRESS {gift}. OR DO IT THE SLOW WAY.',\n      timed: [{ at: 8, say: 'sabine|The slow way, then. Drain it. Burn the clot. Do not make this a habit.', spawn: [{ k: 'clot', id: 'clot', at: [-1.4, -0.9], r: 0.5 }] }],\n      until: { any: [{ flag: 'cleanOpen' }, { clear: ['bleeder', 'clot'], time: 0.1 }] } },\n    { id: 'unclamp2', objective: 'PULL THE VEIN CLAMP', hint: 'forceps', say: 'sabine|Now the vein. Watch the colour. This is the part you get to keep.',\n      spawn: [{ k: 'unclamp', id: 'uc2', at: [1.4, -0.9], dir: -90, pull: 1.1, onDone: [{ perfuse: 'newkidney' }, { flag: 'pink' }, { music: 'or-calm' }, { say: ['pem|There she goes. Pinking up. ...That is my sister, you know.', 'sabine|I know.'] }] }], until: { clear: ['unclamp'] } },\n    { id: 'pinks', objective: 'WATCH IT', until: { time: 3.2 } },\n    { id: 'sample', objective: 'SCANNER: CHECK THE DONOR TISSUE SAMPLE', hint: 'scanner', say: 'sabine|One more thing. Scan the sample from the donor kidney. Humour me.',\n      spawn: [{ k: 'polyp', id: 'sample', at: [3.8, 1.7], r: 0.5, hidden: true, task: true, inertUntil: true, onReveal: [{ flag: 'sampleSeen' }, { say: ['ilya|That is... it is asleep. It is the same thing. In the *donor*.', 'sabine|Mercy. Dormant. In the Foundation\\'s own bank.', 'reyes|Show it none, Doctor.'] }, { remove: ['sample'] }] }], until: { flag: 'sampleSeen' } },\n    ...closeUp({ sutures: [{ at: [-3, -2.6], ang: 2, len: 6 }], gel: { at: [0, 1], rx: 2, rz: 0.9 }, dressing: { at: [-2.8, 2.3], ang: 0, len: 5.6 }, dressSay: 'reyes|Dress it. The kidney is the only honest thing that came from that bank.' }),\n  ],\n};\nEOF\ncat > src/content/ops/op7.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op7', num: 7, title: 'LACRIMOSA', arena: 'lung', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep7', boss: 'lacrimosa',\n  patient: {\n    name: 'OTTILIE MARR', age: 49, job: 'HOSPICE NURSE', hook: \"REYES'S OLDEST FRIEND. SHE IS SMILING. SHE WORKED FOR THE FOUNDATION FOR NINE YEARS.\",\n    objective: 'THE LUNG IS WEEPING. MAKE IT STOP.',\n    followUp: { S: 'She feels every breath now. She says thank you for each of them.', A: 'She is back on a ward. A real one. She and Reyes do not discuss it.', B: 'Her lung is half what it was. She climbs the stairs anyway, swearing.', C: 'She lives, on oxygen. Reyes visits. Reyes also, once, cried. Alone.' },\n  },\n  time: 390, vitals: { start: 80, drain: 0.3 }, doses: 4,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['reyes|That is Ottilie. You will be *perfect*, Doctor, or I will know why.', 'ilya|Yes, Nurse Reyes.'], spawn: [{ k: 'incision', at: [-3, -2.9], ang: 0, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN. THEN SCAN.', hint: 'drain', spawn: [{ k: 'pool', at: [-1.8, 0.4], r: 1.1 }, { k: 'pool', at: [2, -0.6], r: 1 }], until: { clear: ['pool'] } },\n    { id: 'scan', objective: 'SCANNER: SOMETHING IS WATCHING', hint: 'scanner', say: 'ilya|It is breathing out of time with her. Why is it out of time with her?',\n      spawn: [{ k: 'marker', id: 'watcher', at: [0, -1.2], hidden: true, onReveal: [{ flag: 'seen' }, { remove: ['watcher'] }] }], until: { flag: 'seen' } },\n    { id: 'fight', objective: 'LASER THE OPEN EYES. DRAIN OR GEL THE TEARS.', music: 'boss-lacrimosa', hint: 'laser',\n      say: ['reyes|Eyes. It has *eyes*. Laser them when they open!', 'sabine|Drain the tears, or lay gel down and let them die on it.', 'sabine|Do not look at them longer than you have to.'],\n      spawn: [{ k: 'strain:lacrimosa', id: 'lacrimosa', deadFlag: 'lacDead', halfLine: \"ilya|It's crawling. It's crawling! Why would it crawl?\", sobLine: ['reyes|The last one. It is going to *sob*. Gel that line, Doctor!', 'sabine|The whole line. Before it breathes out.'] }],\n      until: { flag: 'lacDead' } },\n    { id: 'mop', objective: 'CLEAN UP THE NICKS', hint: 'gel', music: 'or-tense', say: ['reyes|Ottilie. Ottilie, can you hear me.', 'pem|She is awake under there. She just said *ow*.', 'reyes|...Say it again, you old fool. Say it again.'], spawn: [{ k: 'mask', at: [0, 0.3], rx: 2.2, rz: 1 }], until: { clear: ['mask'] } },\n    ...closeUp({ sutures: [{ at: [-3, -2.9], ang: 0, len: 6 }], dressing: { at: [-2.8, 1.9], ang: 0, len: 5.6 }, dressSay: \"reyes|Dress it. Then get out of my theatre for ten minutes. All of you.\" }),\n  ],\n};\nEOF\ncat > src/content/ops/op8.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op8', num: 8, title: 'DIES IRAE', arena: 'heart', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep8', boss: 'diesirae',\n  patient: {\n    name: 'CHIEF CORNELIUS BRAM', age: 68, job: 'CHIEF OF SURGERY', hook: '\"DON\\'T YOU DARE BE GENTLE.\" HE GAVE YOU HIS OLD SCALPEL.',\n    objective: 'IT LIVES ON HIS HEART. WORK BETWEEN THE BEATS.',\n    followUp: { S: 'He retired on the Friday. He is in the gallery on the Monday, criticising.', A: 'His hands have stopped shaking. He is learning, at 68, what that feels like.', B: 'He will not operate again. He is the worst patient the ward has ever had.', C: 'He lives. He walks the corridors at night. Nobody tells him to go home.' },\n  },\n  time: 420, vitals: { start: 75, drain: 0.35 }, doses: 5,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: [\"reyes|That is your Chief. That is your *scalpel*. Whatever you are feeling, stop.\", \"ilya|It is beating very fast. Is it supposed to be that fast?\"], spawn: [{ k: 'incision', at: [-3.6, -3], ang: 2, len: 7.2 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN', hint: 'drain', spawn: [{ k: 'pool', at: [-3, 1], r: 1 }, { k: 'pool', at: [3, 0.6], r: 1 }], until: { clear: ['pool'] } },\n    { id: 'fight', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN. SYRINGE SLOWS HIM.', music: 'boss-diesirae', hint: 'scalpel',\n      say: ['reyes|Everything on the beat, Doctor. Watch the ring. *Red, you wait.*', 'pem|A dose slows him. He has about five doses of patience in him.', 'sabine|Cut a plate in one beat. Lift it in the next. Then burn the eye.'],\n      spawn: [{ k: 'strain:diesirae', id: 'diesirae', cz: -0.3, deadFlag: 'wrathDead', fibLine: \"pem|He's back. Slower, please. I am too old for this.\", arrestLine: ['pem|He has arrested. Your hands, Doctor. Both of them.', 'reyes|*Massage.* Left, right, on the beat. Eight. Count them!'], finalLine: ['bram|...Don\\'t you dare...', 'reyes|Final cut! Now, Doctor! Now!'] }],\n      until: { flag: 'wrathDead' } },\n    { id: 'beat', objective: 'LISTEN', music: 'or-calm', say: ['pem|Sinus rhythm. Seventy-two. Steady as a very old clock.', 'reyes|...Close him up. He will want to check your work.'], until: { time: 3 } },\n    ...closeUp({ sutures: [{ at: [-3.6, -3], ang: 2, len: 7.2 }], gel: { at: [0, 0], rx: 2.6, rz: 1.2 }, dressing: { at: [-3, 2.4], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. That is the first straight line you have ever drawn, Doctor.' }),\n  ],\n};\nEOF\ncat > src/content/ops/op9.js <<'EOF'\n// Libera Me. NO SIGNAL. No hint marker, no voice. Two surgeons, one bot's hand, Reyes on the table.\nconst cyst = (at, real) => ({ k: 'cyst', at, real, scanned: false, r: 0.42, task: real });\n\nexport default {\n  id: 'op9', num: 9, title: 'LIBERA ME', arena: 'chest', surgeon: 'both', gifts: ['quiet', 'look'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: null, noVoice: true, noHint: true,\n  scene: 'ep9', boss: 'libera', pairOp: true,\n  seatDefaults: { surgeon: 'ilya', gift: 'quiet', region: 'right' },\n  partner: { surgeon: 'sabine', gift: 'look', bot: { skill: 0.72 }, region: 'left' },\n  patient: {\n    name: 'NURSE ODALYS REYES', age: 46, job: 'SCRUB NURSE, VERITY GENERAL', hook: 'SHE TOLD YOU TO START WITHOUT HER. THERE IS NOBODY IN YOUR EAR.',\n    objective: 'THE MONITOR IS LYING. EVERYTHING IS LYING. WORK.',\n    followUp: { S: '...Your sutures are crooked, Doctor. She has asked to see the chart. She has corrections.', A: 'She woke up and asked who was minding the instruments.', B: 'She is alive. She has told the night staff you were adequate. You cried.', C: 'She is alive. She will be in a chair for a while. She has already run it over your foot.' },\n  },\n  time: 540, vitals: { start: 70, drain: 0.35 }, doses: 6,\n  stages: [\n    { id: 'quiet0', objective: '', do: [{ fake: 99 }, { music: 'silence' }], until: { time: 1.5 } },\n    { id: 'sanctus', objective: 'THE FIELD LOOKS HEALTHY. SCAN THE CYSTS. BURN THE REAL ONES.', music: 'boss-libera',\n      spawn: [cyst([-4.4, -1.8], true), cyst([-2.6, 0.8], true), cyst([-1.4, -2.3], true), cyst([-0.6, 1.5], false), cyst([-3.6, 1.9], false), cyst([1.2, -2.1], true), cyst([2.2, 0.6], true), cyst([3.4, -1.2], true), cyst([4.4, 1.4], true), cyst([0.9, 0.3], false), cyst([3.2, 1.9], false), cyst([-0.5, -0.7], true)],\n      until: { clear: ['cyst'] }, after: [{ fake: null }, { fx: 'shake' }, { cue: 'trueVitals' }] },\n    { id: 'reprise', objective: 'THE RIGHT HALF IS YOURS. THE LEFT IS HERS. ALL THREE OF THEM AT ONCE.', music: 'boss-libera2',\n      spawn: [\n        { k: 'strain:introit', id: 'introit', hp: 1, deadFlag: 'r1', way: [[-5, -1.8], [-1.5, -2.6], [-1.2, 0.4], [-4.8, 1.2]] },\n        { k: 'strain:lacrimosa', id: 'lacrimosa', count: 2, eyeHp: 2, deadFlag: 'r2', noSob: true, positions: [[3.2, -2.4], [4.6, 1.2]], maxOpen: 1 },\n        { k: 'strain:diesirae', id: 'diesirae', cx: 2.2, cz: 0, ringR: 1.3, rounds: [3], noArrest: true, deadFlag: 'r3', flareEvery: 12, xOff: 2 },\n      ],\n      until: { all: [{ flag: 'r1' }, { flag: 'r2' }, { flag: 'r3' }, { clear: ['laceration'] }] } },\n    { id: 'miserere', objective: 'IT COPIES YOU. KEEP MOVING. {tag} TAGS DOCTORS.', music: 'boss-libera3',\n      spawn: [{ k: 'strain:miserere', id: 'miserere', deadFlag: 'mis', cx: 0, cz: -0.6 }],\n      until: { flag: 'mis' } },\n    { id: 'blue', objective: 'CODE BLUE. YOU KNOW WHAT TO DO.', music: 'silence', do: [{ setVitals: 4 }, { codeBlue: { need: 2, time: 14, restore: 30, then: [{ flag: 'back' }] } }], until: { flag: 'back' } },\n    { id: 'silence', objective: '', music: 'silence', until: { time: 7 }, timed: [{ at: 4.5, say: 'reyes|...Your sutures are crooked, Doctor.', cue: 'reyesBack' }] },\n  ],\n};\nEOF\ncat > src/content/ops/op10.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Do No Harm. Generous clock, soft music, no attacks. After all that action the slowness is the point.\nconst strand = (n, at, line) => ([\n  { k: 'incision', id: `s${n}cut`, at: [at[0] - 0.6, at[1]], ang: 0, len: 1.2, short: true, unlocks: `s${n}` },\n  { k: 'prop', id: `s${n}`, prop: 'strand', at, dir: at[1] > 0 ? 80 : -80, pull: 1.3, speedLimit: 2.6, locked: true, onDone: [{ vitals: 6 }, { painUp: 1 }, { say: line }] },\n]);\n\nexport default {\n  id: 'op10', num: 10, title: 'DO NO HARM', arena: 'spine', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'op10',\n  scene: 'ep10',\n  patient: {\n    name: 'DR. HESPER LINDQVIST', age: 66, job: 'FOUNDER, THE MERCY FOUNDATION', hook: 'SHE TOOK IT FIRST, ELEVEN YEARS AGO. SHE HAS NOT FELT ANYTHING SINCE.',\n    objective: 'NO ONE IS GOING TO ATTACK YOU. TAKE YOUR TIME.',\n    followUp: { S: 'She pleaded guilty to everything, in pain, and refused anything for it.', A: 'She testified from a wheelchair. She wept when the sun was warm.', B: 'She lives. The Foundation does not. She writes to you. You have not replied.', C: 'She lives. She has asked what it was for. You are still working on that.' },\n  },\n  time: 240, vitals: { start: 60, drain: 0.05 }, doses: 2,\n  stages: [\n    { id: 'open', objective: 'SLOWLY. ALONG THE SPINE.', hint: 'scalpel', say: ['reyes|You do not have to do this, Doctor. I will say so once. It is on the chart.', 'ilya|It is my shift.'],\n      do: [{ pain: 0 }], spawn: [{ k: 'strain:pale', id: 'pale', at: [0, 0.2], task: false }, { k: 'incision', at: [-4.4, -2.5], ang: 0, len: 8.8 }], until: { clear: ['incision'] } },\n    { id: 'strands', objective: 'A SHORT CUT. THEN GENTLY, GENTLY LIFT EACH STRAND.', hint: 'scalpel', say: ['reyes|Slow strokes. Slow forceps. It will not fight you. That is what is wrong with it.', 'hesper|I can hear you. I can hear everything. Isn\\'t it strange. Nothing else.'],\n      spawn: [...strand(1, [-3.6, 0.7], 'hesper|...Something. I felt something. A cold.'), ...strand(2, [-1.4, -0.8], 'hesper|That is my back. I had forgotten I had a back.'), ...strand(3, [1.3, 0.8], 'hesper|Oh. Oh, that is... Is it always like this?'), ...strand(4, [3.5, -0.7], 'hesper|It hurts. Doctor. Doctor, it *hurts*.')],\n      until: { clear: ['incision', 'prop'] } },\n    { id: 'core', objective: 'THE LAST OF IT. THE GENTLEST HANDS YOU HAVE.', hint: 'forceps', say: ['hesper|Why? You could have let me go. Why are you doing this?', 'ilya|Because it\\'s my shift.'],\n      spawn: [{ k: 'core', id: 'palecore', at: [0, 0.2], dir: -90, pull: 2.4, speedLimit: 1.8, grabR: 0.3, tearMul: 1.5, onDone: [{ vitals: 15 }, { painUp: 2 }, { remove: ['pale'] }, { say: ['hesper|...Ah. *Ah.* There you are. Eleven years.', 'reyes|Close her, Doctor. Gently. She can feel it now.'] }] }], until: { clear: ['core'] } },\n    ...closeUp({ sutures: [{ at: [-4.4, -2.5], ang: 0, len: 8.8 }], gel: { at: [0, 0.2], rx: 3, rz: 1 }, dressing: { at: [-3, 2.2], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. Straight. ...That will do, Doctor.' }),\n  ],\n};\nEOF\ncat > src/content/ops/pileup.js <<'EOF'\n// Consult's own op: a wave-based chest wound. Survive the clock, clear what you can, save the patient.\nconst SPECS = {\n  hook: { k: 'hook', pull: 1.2, dir: [-120, -60], arc: 0.8, task: false },\n  pool: { k: 'pool', r: [0.8, 1.3], task: false },\n  bleeder: { k: 'bleeder', r: [0.6, 0.9], task: false },\n  lac: { k: 'laceration', len: 2.2, ang: [-25, 25], task: false },\n  polyp: { k: 'polyp', r: 0.38, task: false },\n};\nexport default {\n  id: 'pileup', num: 0, title: 'PILE-UP', arena: 'chest', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'], music: 'or-tense', session: true, consult: true, surviveClock: true,\n  patient: {\n    name: 'NOAH VIK', age: 34, job: 'BUS DRIVER, HARBOUR ROAD', hook: 'THE WHOLE ROAD CAME IN WITH HIM. HE IS THE ONE THEY GAVE YOU.',\n    objective: 'KEEP THE PATIENT ALIVE UNTIL THE CLOCK RUNS OUT. TOP THE TEAM SCORE.',\n    followUp: { S: 'He drove the bus to his own discharge.', A: 'He is sore, loud and alive.', B: 'He lives. He has opinions about the ambulance.', C: 'He lives. Somehow. Nobody will say how.' },\n  },\n  time: 225, vitals: { start: 90, drain: 0.16 }, doses: 6,\n  stages: [\n    { id: 'waves', objective: 'KEEP THE PATIENT ALIVE. EVERYTHING IS YOURS.', say: ['reyes|Harbour Road. Hooks, glass, the lot. Scrub in, all of you.', 'pem|Plenty of patient to go around.'],\n      spawn: [{ k: 'pool', at: [-2.4, 0.4], r: 1.2, task: false }, { k: 'hook', at: [2, 0.6], dir: -90, arc: 0.8, pull: 1.2, task: false }],\n      timed: [\n        { at: 5, every: 18, scaled: true, times: 12, rand: { spec: SPECS.pool, n: 1 } },\n        { at: 12, every: 16, scaled: true, times: 12, rand: { spec: SPECS.hook, n: 2 } },\n        { at: 20, every: 26, scaled: true, times: 8, rand: { spec: SPECS.lac, n: 1 } },\n        { at: 30, every: 20, scaled: true, times: 10, rand: { spec: SPECS.polyp, n: 2 } },\n        { at: 45, every: 30, scaled: true, times: 6, rand: { spec: SPECS.bleeder, n: 2 }, say: 'reyes|Surge! Bleeders! Move, Doctors!' },\n        { at: 185, spawn: [{ k: 'strain:introit', id: 'introit', hp: 1, deadFlag: 'pileIntroit', task: false }], say: ['ilya|It... knocked. Nurse Reyes, this one *knocked*.', 'reyes|Forty seconds, Doctors. Show it none.'], music: 'boss-introit' },\n      ],\n      until: { flag: 'neverEnds' } },\n  ],\n};\nEOF\ncat > src/content/ops/session.js <<'EOF'\n// Trimmed boss fights for AI Hub rounds and Consult: all tools, hints and lines on, at most four minutes.\nconst ALL = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'];\nconst hook = { hook: 'THE HUB DEALT YOU THIS ONE.', followUp: { S: 'Textbook.', A: 'Very good.', B: 'They lived.', C: 'They lived. Barely.' } };\n\nexport const sessionIntroit = {\n  id: 'session-introit', num: 0, title: 'INTROIT (CONSULT)', arena: 'liver', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-introit', session: true, consult: true,\n  patient: { name: 'A HARBOUR PILOT', age: 44, job: 'SMILING', objective: 'WHEN IT KNOCKS: LANCE, GRAB, PULL. THREE TIMES.', ...hook },\n  time: 225, vitals: { start: 90, drain: 0.25 }, doses: 5,\n  stages: [\n    { id: 'fight', objective: 'WHEN IT KNOCKS: LANCE THE PORE. FORCEPS THE CORE. PULL.', say: ['sabine|Do not answer it until you are ready.', 'reyes|Show it none, Doctors.'], spawn: [{ k: 'strain:introit', id: 'introit', hp: 3, deadFlag: 'dead' }, { k: 'pool', at: [-2.2, 0.2], r: 1, task: false }], until: { all: [{ flag: 'dead' }, { clear: ['laceration'] }] } },\n    { id: 'close', objective: 'LASER THE EGGS', spawn: [[-3, -1], [0, 1.2], [3, -1]].map((at) => ({ k: 'egg', at, r: 0.38 })), until: { clear: ['egg'] } },\n  ],\n};\nexport const sessionLacrimosa = {\n  id: 'session-lacrimosa', num: 0, title: 'LACRIMOSA (CONSULT)', arena: 'lung', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-lacrimosa', session: true, consult: true,\n  patient: { name: 'A HOSPICE NURSE', age: 39, job: 'SMILING', objective: 'LASER THE EYES. DRAIN THE TEARS. HOLD THE LINE WHEN IT SOBS.', ...hook },\n  time: 230, vitals: { start: 90, drain: 0.25 }, doses: 5,\n  stages: [\n    { id: 'fight', objective: 'LASER THE OPEN EYES. DRAIN OR GEL THE TEARS.', say: ['reyes|Eyes. Laser them when they open, Doctors!', 'sabine|Do not look at them longer than you have to.'], spawn: [{ k: 'strain:lacrimosa', id: 'lacrimosa', count: 4, eyeHp: 2, sobs: 2, deadFlag: 'dead', sobLine: 'reyes|It is going to *sob*. Gel that line!' }], until: { flag: 'dead' } },\n  ],\n};\nexport const sessionDiesIrae = {\n  id: 'session-diesirae', num: 0, title: 'DIES IRAE (CONSULT)', arena: 'heart', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-diesirae', session: true, consult: true,\n  patient: { name: 'A CHIEF OF SOMETHING', age: 70, job: 'SHOUTING', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN.', ...hook },\n  time: 230, vitals: { start: 85, drain: 0.3 }, doses: 6,\n  stages: [\n    { id: 'fight', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN. SYRINGE SLOWS IT.', say: ['reyes|Everything on the beat. Red, you wait.', 'pem|A dose slows him, Doctors.'], spawn: [{ k: 'strain:diesirae', id: 'diesirae', cz: -0.3, rounds: [2, 2], deadFlag: 'dead', arrestLine: 'reyes|*Massage!* Left, right, on the beat!', finalLine: 'reyes|Final cut! Now!' }], until: { flag: 'dead' } },\n  ],\n};\nEOF\ncat > src/content/ops/pars.js <<'EOF'\n// `par`, calibrated from the bot at full skill by tests/balance.mjs --pars.\nexport const PARS = { op1: 4000, op2: 4000, op3: 4000, op4: 4000, op5: 4000, op6: 4000, op7: 4000, op8: 4000, op9: 4000, op10: 4000, pileup: 4000, 'session-introit': 3000, 'session-lacrimosa': 3000, 'session-diesirae': 3000 };\nEOF\ncat > src/content/ops/index.js <<'EOF'\nimport op1 from './op1.js';\nimport op2 from './op2.js';\nimport op3 from './op3.js';\nimport op4 from './op4.js';\nimport op5 from './op5.js';\nimport op6 from './op6.js';\nimport op7 from './op7.js';\nimport op8 from './op8.js';\nimport op9 from './op9.js';\nimport op10 from './op10.js';\nimport pileup from './pileup.js';\nimport { sessionDiesIrae, sessionIntroit, sessionLacrimosa } from './session.js';\nimport { PARS } from './pars.js';\n\nexport const CAMPAIGN_OPS = [op1, op2, op3, op4, op5, op6, op7, op8, op9, op10];\nexport const SESSION_OPS = [pileup, sessionIntroit, sessionLacrimosa, sessionDiesIrae];\nexport const OPS = Object.fromEntries([...CAMPAIGN_OPS, ...SESSION_OPS].map((o) => [o.id, o]));\nfor (const o of Object.values(OPS)) o.par = PARS[o.id] ?? o.par ?? 4000;\nEOF\npython3 - <<'EOF'\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"    if (c.pain != null) { sim.pain = c.pain; emit(sim, 'pain', { pain: c.pain }); }\",\"    if (c.pain != null) { sim.pain = c.pain; emit(sim, 'pain', { pain: c.pain }); }\\n    if (c.painUp != null) { sim.pain += c.painUp; emit(sim, 'pain', { pain: sim.pain }); }\")\nopen(p,'w').write(s)\nEOF\ncat > tests/simlib.mjs <<'EOF'\n// Helpers for sim tests.\nimport { createConfig } from '../src/core/config.js';\nimport { OPS } from '../src/content/ops/index.js';\nimport { createOp, drainEvents, step } from '../src/sim/op.js';\n\nexport function runBot(id, { skill = 0.7, seed = 7, difficulty = 'resident', maxTicks = 60 * 900, config, seats, cheats, onTick } = {}) {\n  const def = OPS[id];\n  const base = def.seatDefaults ?? {};\n  const sim = createOp(def, { seed, difficulty, config: config ?? createConfig(), seats: seats ?? [{ id: 0, ...base, bot: { skill } }], cheats });\n  let ticks = 0;\n  while (sim.status === 'playing' && ticks < maxTicks) {\n    step(sim, {});\n    drainEvents(sim);\n    onTick?.(sim, ticks);\n    ticks++;\n  }\n  return { sim, ticks };\n}\nEOF\ncat > tests/quick.mjs <<'EOF'\nimport { OPS } from '../src/content/ops/index.js';\nimport { finalTally } from '../src/sim/scoring.js';\nimport { runBot } from './simlib.mjs';\nconst ids = process.argv[2] ? process.argv[2].split(',') : Object.keys(OPS);\nconst skill = Number(process.argv[3] ?? 1);\nfor (const id of ids) {\n  const { sim, ticks } = runBot(id, { skill });\n  const st = sim.def.stages[sim.stage];\n  const tally = sim.status === 'won' ? finalTally(sim) : null;\n  console.log(id.padEnd(18), sim.status.padEnd(8), `t=${(ticks/60).toFixed(0)}s clock=${sim.clock.toFixed(0)} stage=${st.id} (${sim.stage+1}/${sim.def.stages.length}) vit=${sim.tables.map(t=>t.vitals.toFixed(0)).join('/')} mis=${sim.mistakes} doses=${sim.doses} ${sim.failReason??''} ${tally?`total=${tally.total} tech=${tally.technique}`:''} open=${sim.ents.filter(e=>e.task&&!e.dead).map(e=>e.k).slice(0,5)}`);\n}\nEOF\nnode tests/quick.mjs 2>&1 | head -40","description":"Write all op data and run bot through every op","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21528,"cache_read_input_tokens":215280,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21528},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"9356f108-d0a7-4a8f-868f-f12e108ce468","timestamp":"2026-11-05T15:39:10.343Z","request_id":"req_011Cgk2Uc8VagUeRYZYzwd4y","wire_tool_inputs":{"toolu_01N5H4G7borAkYBi7JGfAzpZ":{"command":"python3 - <<'EOF'\nimport re\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"if (sim.stages?.[i]?.after) runCommands(sim, def.stages[i].after);\",\"if (def.stages[i].after) runCommands(sim, def.stages[i].after);\")\ns=s.replace(\"sim.gifts.includes('look') | sim.seats.some((s) => s.gift === 'look'))\",\"sim.seats.some((s) => s.gift === 'look'))\")\ns=s.replace(\"import { STRAINS } from './strains/index.js';\",\"import { stepHeart } from './strains/diesirae.js';\\nimport { STRAINS } from './strains/index.js';\")\ns=s.replace(\"    get: (id) => sim.ents.find((e) => e.id === id && !e.dead),\",\"    get: (id) => sim.ents.find((e) => e.id === id && !e.dead),\\n    notify: (e, what, seat) => notifyOwner(sim, e, what, seat),\")\n# heart + markers + cold in world step\ns=s.replace(\"  for (const d of sim.drops) stepDrop(sim, d, dtWorld);\",\"\"\"  stepHeart(sim, dtWorld, sim.api);\n  for (const e of sim.ents) {\n    if (e.k !== 'marker' || e.dead || e.hidden) continue;\n    if (sim.seats.some((s) => s.table === e.table && !s.gone && dist(s.x, s.z, e.x, e.z) <= 0.55)) {\n      emit(sim, 'marker', { x: e.x, z: e.z });\n      removeEnt(sim, e);\n      if (e.onDone) runCommands(sim, e.onDone);\n    }\n  }\n  if (sim.cold != null) {\n    sim.cold -= dtWorld;\n    if (sim.cold <= 0 && !sim.cheats.god) { sim.cold = 0; lose(sim, 'cold'); }\n  }\n  for (const d of sim.drops) stepDrop(sim, d, dtWorld);\"\"\")\n# commands\ns=s.replace(\"    if (c.rand) randomSpawn(sim, c.rand);\",\"\"\"    if (c.rand) randomSpawn(sim, c.rand);\n    if (c.cold !== undefined) { sim.cold = c.cold; emit(sim, 'cold', { cold: c.cold }); }\n    if (c.lock) { const e = sim.ents.find((o) => o.id === c.lock && !o.dead); if (e) e.locked = true; }\n    if (c.unlockEnt) { const e = sim.ents.find((o) => o.id === c.unlockEnt && !o.dead); if (e) e.locked = false; }\n    if (c.ifPersist) runCommands(sim, sim.persist[c.ifPersist] ? c.then : c.else);\n    if (c.count) {\n      sim.counters[c.count] = (sim.counters[c.count] ?? 0) + 1;\n      const line = c.lines?.[sim.counters[c.count] - 1];\n      if (line) say(sim, line);\n    }\"\"\")\ns=s.replace(\"    pain: 0, handGhost: null, tag: 0,\",\"    pain: 0, handGhost: null, tag: 0, counters: {}, cold: null,\")\nopen(p,'w').write(s)\np='src/sim/tools.js'; s=open(p).read()\ns=s.replace(\"\"\"    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\"\"\",\"\"\"    const q = target.stray < 0.12 ? 'clean' : target.stray < 0.35 ? 'good' : 'sloppy';\n    if (target.hp != null) {\n      // Eyes survive a burn; their owner decides.\n      api.rate(seat, q, target.x, target.z);\n      target.heat = 0;\n      target.stray = 0;\n      api.notify(target, 'burned', seat);\n      return;\n    }\n    api.addMark(seat.table, { t: 'burnt', x: target.x, z: target.z });\n    api.finish(target, seat, q);\"\"\")\nopen(p,'w').write(s)\np='src/sim/entities.js'; s=open(p).read()\ns=s.replace(\"  if (e.k === 'mask') {\\n    const c = e.cells.find((m) => !m[2]);\\n    return c ? { tool: 'gel', x: c[0], z: c[1] } : null;\\n  }\",\"  if (e.k === 'mask') {\\n    const c = e.cells.find((m) => !m[2]);\\n    return c ? { tool: 'gel', x: c[0], z: c[1] } : null;\\n  }\\n  if (e.k === 'marker') return { tool: 'marker', x: e.x, z: e.z };\")\ns=s.replace(\"if (t.tool !== 'dressing' && !sim.tools.includes(t.tool)) continue;\",\"if (t.tool !== 'dressing' && t.tool !== 'marker' && !sim.tools.includes(t.tool)) continue;\")\nopen(p,'w').write(s)\np='src/sim/bot.js'; s=open(p).read()\ns=s.replace(\"  if (tool !== 'dressing') {\\n    out.tool = tool;\",\"  if (tool !== 'dressing' && tool !== 'marker') {\\n    out.tool = tool;\")\ns=s.replace(\"    default: break;\\n  }\\n  out.x = b.x;\\n  out.z = b.z;\\n  if (context) out.tool = seat.tool;\",\"    default:\\n      moveTo(b, seat, task.x, task.z, speed);\\n      break;\\n  }\\n  out.x = b.x;\\n  out.z = b.z;\\n  if (context) out.tool = seat.tool;\")\nopen(p,'w').write(s)\nEOF\ncat > src/content/ops/_kit.js <<'EOF'\n// Small helpers for writing ops. Everything they return is plain JSON-safe data.\nexport const closeUp = ({ sutures = [], gel = null, dressing = { at: [-3, 0.4], ang: 0, len: 6 }, gelSay = null, sutureSay = null, dressSay = \"reyes|Dress it. Straight line, Doctor. You've seen a line.\" } = {}) => {\n  const out = [];\n  if (sutures.length) out.push({ id: 'close-suture', objective: 'SUTURE THE WOUNDS', say: sutureSay, hint: 'suture', spawn: sutures.map((s) => ({ k: 'laceration', ...s })), until: { clear: ['laceration'] } });\n  if (gel) out.push({ id: 'close-gel', objective: 'GEL THE SITE', say: gelSay, hint: 'gel', spawn: [{ k: 'mask', ...gel }], until: { clear: ['mask'] } });\n  if (dressing) out.push({ id: 'dressing', objective: 'DRESS IT: DRAG THE STRIP ALONG THE LINE', say: dressSay, context: 'dressing', spawn: [{ k: 'dressing', id: 'dress', ...dressing }], until: { clear: ['dressing'] } });\n  return out;\n};\nEOF\ncat > src/content/ops/op1.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nconst COUNT = ['reyes|One.', 'reyes|Two.', 'reyes|Three. Keep breathing, Doctor.', 'reyes|Four.', 'reyes|Five. He stopped screaming at three.', 'reyes|Six.', 'reyes|Seven.', 'reyes|Eight. Slower.', 'reyes|Nine.', 'reyes|Ten.', 'reyes|Eleven. That is the count on the chart.'];\nconst hook = (id, at, dir, arc, extra = {}) => ({ k: 'hook', id, at, dir, arc, pull: 1.25, onDone: [{ count: 'hooks', lines: COUNT }], ...extra });\n\nexport default {\n  id: 'op1', num: 1, title: 'ELEVEN HOOKS', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel'], music: 'or-calm',\n  scene: 'ep1',\n  patient: {\n    name: 'TOMASZ DOLAN', age: 52, job: 'TRAWLER DECKHAND', hook: \"HIS DAUGHTER'S WEDDING IS SATURDAY.\",\n    objective: 'BACK ELEVEN FISHHOOKS OUT OF ONE ARM. THEN THE TWELFTH.',\n    followUp: { S: 'He walked her down the aisle. Dry eyes. Hers, not his.', A: 'He made the wedding. He shows the scar to everyone.', B: 'He made the wedding. He dropped the cake with the bad hand.', C: 'He danced badly. She cried anyway.' },\n  },\n  time: 240, vitals: { start: 85, drain: 0.1 }, doses: 3, ring: [-5.1, 2.1],\n  anyStage: { vitalsBelow: { 50: { say: 'reyes|He is fading. *Syringe.* Draw with {use}, let go in the ring.', unlock: 'syringe' } } },\n  stages: [\n    { id: 'marker', objective: 'MOVE YOUR INSTRUMENT ONTO THE MARKER', say: ['reyes|This is your hand. That is the patient. Do not confuse them.', 'reyes|Move your instrument onto the marker, Doctor.'], spawn: [{ k: 'marker', at: [0, 0.2] }], until: { clear: ['marker'] } },\n    { id: 'pools', objective: 'DRAIN THE BLOOD: HOLD {use} ON A POOL', hint: 'drain', say: ['ilya|I can do this. I can do this. Nurse Reyes, can I do this?', 'reyes|Drain first. You cannot fix what you cannot see. Hold {use}.'],\n      spawn: [{ k: 'pool', id: 'p1', at: [-3, 0.5], r: 1.5 }, { k: 'pool', id: 'p2', at: [2.6, -0.4], r: 1.3 }, hook('h1', [-3.4, 0.7], -70, 0.8, { hiddenBy: 'p1' }), hook('h2', [-2.3, 0.1], -100, -0.8, { hiddenBy: 'p1' }), hook('h3', [2.6, -0.1], -80, 0.8, { hiddenBy: 'p2' })],\n      until: { clear: ['pool'] } },\n    { id: 'hooks', objective: 'FORCEPS: BACK EACH HOOK OUT ALONG ITS ARROW', hint: 'forceps', say: ['reyes|Barbs. Back them out along the *curve*, or they take him with them.', 'reyes|Forceps. Hold {use} on the hook, follow the arrow, then let go.', 'ilya|How do you get eleven fishhooks in one arm?', 'pem|It was a long net.'],\n      spawn: [hook('h4', [-5.2, -0.5], -60, 0.8), hook('h5', [-4.4, 1.5], -80, -0.8), hook('h6', [-0.9, -0.9], -110, 0.8), hook('h7', [-0.2, 1.3], -70, 0.8), hook('h8', [1.2, 0.5], -90, -0.8), hook('h9', [3.9, 1.4], -100, 0.8), hook('h10', [4.6, -0.7], -60, -0.8), hook('h11', [5.3, 1.1], -120, 0.8)],\n      until: { clear: ['hook'] } },\n    ...closeUp({ sutures: [{ id: 'l1', at: [-4.2, 0.2], ang: 8, len: 2.6 }, { id: 'l2', at: [1.4, 0.3], ang: -10, len: 2.6 }], sutureSay: ['reyes|Two lacerations. *Suture.* Zigzag across the wound, slot by slot.', 'reyes|Hold {use} and cross the line. In rhythm. It is not a race. Yet.'], gel: { id: 'rust', at: [0, -0.2], rx: 1.8, rz: 1.1 }, gelSay: ['reyes|Rust. That hook was older than you. *Gel* it. Sweep with {use}.'], dressing: null }),\n    { id: 'dress1', objective: 'DRESS IT: DRAG THE STRIP ALONG THE LINE', context: 'dressing', say: \"reyes|Dress it. Hold {use}. Straight line, Doctor. You've seen a line.\", spawn: [{ k: 'dressing', id: 'dress', at: [-3.2, 1.0], ang: 0, len: 2.6 }], until: { clear: ['dressing'] } },\n    { id: 'twelve', objective: 'ONE MORE HOOK', hint: 'forceps', say: ['ilya|...That is eleven, right?', 'reyes|Twelve. I counted twelve.', 'pem|It was a very long net.'], do: [{ fx: 'shake' }], spawn: [{ k: 'hook', id: 'h12', at: [0.8, -1.4], dir: -100, arc: 0.9, pull: 1.4 }], until: { clear: ['hook'] } },\n    { id: 'dress2', objective: 'FINISH THE DRESSING', context: 'dressing', spawn: [{ k: 'dressing', id: 'dress2', at: [-0.4, 1.0], ang: 0, len: 3.6 }], until: { clear: ['dressing'] } },\n  ],\n};\nEOF\ncat > src/content/ops/op2.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op2', num: 2, title: 'THE VANISHING ACT', arena: 'stomach', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'scanner', 'laser'], music: 'or-calm',\n  scene: 'ep2',\n  patient: {\n    name: 'THE GREAT ZAMBONI', age: 61, job: 'STAGE MAGICIAN', hook: \"HE SWALLOWED SOMETHING DURING HIS ACT. HE WON'T SAY WHAT.\",\n    objective: 'FIND WHAT HE SWALLOWED. TAKE IT OUT. ALL OF IT.',\n    followUp: { S: 'They got it early. He does the coin trick on the ward now. Badly, on purpose.', A: 'Clean margins. He sent the staff a deck of cards, all sevens.', B: 'He starts chemo Monday. He has already made the IV pole disappear.', C: 'He has a year, maybe. He says he has done more with less.' },\n  },\n  time: 300, vitals: { start: 80, drain: 0.15 }, doses: 3, ring: [-5.1, 2.1],\n  onRewind: null,\n  stages: [\n    { id: 'open', objective: 'SCALPEL: FOLLOW THE DOTTED LINE', hint: 'scalpel', say: ['reyes|*Scalpel.* The sharp end goes toward the patient, Doctor. We have discussed this.', 'reyes|Start at the top of the line. Hold {use}. Trace it. Do not improvise.'],\n      spawn: [{ k: 'incision', id: 'midline', at: [-2.8, -0.2], ang: 0, len: 5.6 }], until: { clear: ['incision'] } },\n    { id: 'bleeders', objective: 'DRAIN THE BLEEDERS ALONG THE CUT', hint: 'drain', say: 'reyes|Bleeders. They refill while you admire them. Drain, Doctor.',\n      spawn: [{ k: 'bleeder', id: 'b1', at: [-1.8, 0.9], r: 0.8 }, { k: 'bleeder', id: 'b2', at: [1.2, -1.2], r: 0.8 }, { k: 'bleeder', id: 'b3', at: [2.8, 0.8], r: 0.7 }], until: { clear: ['bleeder'] } },\n    { id: 'scan', objective: 'SCANNER: FIND WHAT HE SWALLOWED', hint: 'scanner', say: ['pem|He told me he swallowed nothing. Then he sneezed and a dove came out.', 'reyes|*Scanner.* Hold {use} and sweep. Four things in there. Find them.'],\n      spawn: [\n        { k: 'prop', id: 'key', prop: 'key', at: [-3.6, -1.2], hidden: true, lance: true, dir: -80, pull: 1.3, lanceAng: 20, onReveal: [{ say: 'ilya|A key. There is a key in his stomach.' }] },\n        { k: 'prop', id: 'coin', prop: 'coin', at: [-1.0, 1.2], hidden: true, lance: true, dir: -100, pull: 1.3, lanceAng: -15, onReveal: [{ say: 'reyes|A coin. The gentleman is at least consistent.' }] },\n        { k: 'prop', id: 'card', prop: 'card', at: [2.0, -1.4], hidden: true, lance: true, dir: -70, pull: 1.3, lanceAng: 10, onReveal: [{ say: 'ilya|...Seven of clubs. Is that your card, Nurse Reyes?' }] },\n        { k: 'magnet', id: 'mag', prop: 'magnet', at: [3.6, 0.8], hidden: true, lance: true, dir: -90, pull: 1.6, speedLimit: 2.4, lanceAng: 0, onReveal: [{ say: 'reyes|Magnets. Pull *slowly* or they snap back. Hold {steady}.' }] },\n      ],\n      until: { clear: ['prop', 'magnet', 'incision'] } },\n    { id: 'turn', objective: 'SCAN AGAIN', hint: 'scanner', music: 'or-tense', say: ['ilya|That is everything. Coin, key, card, magnets. Ta-da.', 'reyes|Scan it again, Doctor.'],\n      spawn: [{ k: 'tumor', id: 'tum', at: [-0.4, -0.4], r: 1.15, hidden: true, dir: -90, pull: 1.7, onReveal: [{ say: ['ilya|...Is that a prop?', \"reyes|...That one isn't a prop.\", 'pem|Sleep well, maestro.'] }] }],\n      until: { clear: ['incision'], flag: 'never' } , timed: [] },\n    { id: 'tumor', objective: 'CUT AROUND THE TUMOUR. LIFT IT OUT.', hint: 'scalpel', say: 'reyes|All the way round. Then forceps. No more jokes in this room.', until: { clear: ['incision', 'tumor'] } },\n    { id: 'polyps', objective: 'LASER: BURN THE FIVE POLYPS', hint: 'laser', say: ['reyes|Satellites. *Laser.* Hold {use} on each until it goes.', 'reyes|Stay on target. Healthy tissue has done nothing to you.'],\n      spawn: [{ k: 'polyp', at: [-3.4, 0.6] }, { k: 'polyp', at: [-1.6, -1.8] }, { k: 'polyp', at: [0.8, 1.5] }, { k: 'polyp', at: [2.6, -0.6] }, { k: 'polyp', at: [4, 1.4] }], until: { clear: ['polyp'] } },\n    { id: 'drain2', objective: 'DRAIN THE FIELD', hint: 'drain', spawn: [{ k: 'pool', at: [-0.4, -0.2], r: 1.2 }], until: { clear: ['pool'] } },\n    ...closeUp({ sutures: [{ at: [-2.6, 0.1], ang: 2, len: 5.2 }], sutureSay: 'reyes|Close him. He has a Saturday show he is not going to make.', gel: { at: [0, 0], rx: 2.1, rz: 1 }, gelSay: 'reyes|Gel. Then we find his family, Doctor. You will do the talking.', dressing: { at: [-3, 1.1], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. Hold {use}. He deserves one straight line today.' }),\n  ],\n};\nEOF\npython3 - <<'EOF'\np='src/content/ops/op2.js'; s=open(p).read()\ns=s.replace(\"until: { clear: ['incision'], flag: 'never' } , timed: [] },\",\"until: { clear: ['marker'], flag: 'tumorFound' } },\")\ns=s.replace(\"hidden: true, dir: -90, pull: 1.7, onReveal: [{ say:\",\"hidden: true, dir: -90, pull: 1.7, onReveal: [{ flag: 'tumorFound' }, { say:\")\nopen(p,'w').write(s)\nEOF\ncat > src/content/ops/op3.js <<'EOF'\n// Night Ferry: three tables, one doctor. The Quiet awakens on the crash at about 70%.\nexport default {\n  id: 'op3', num: 3, title: 'NIGHT FERRY', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep3',\n  patient: {\n    name: 'THREE FERRY PASSENGERS', age: '-', job: 'TABLES A, B AND C', hook: 'A TEACHER. A DECKHAND. A BOY WHO WAS ONLY GOING TO THE DENTIST.',\n    objective: 'THREE TABLES. ONE DOCTOR. KEEP ALL THREE ALIVE.',\n    followUp: { S: 'All three walked out. The boy still has to go to the dentist.', A: 'All three lived. The teacher sends the ward her marking to do.', B: 'All three lived. Nobody is sure how, least of all you.', C: 'Three lived. The ferry company has already sent a coupon.' },\n  },\n  time: 360, vitals: { start: 70, drain: 0.25 }, doses: 5,\n  tables: [{ arena: 'leg', vitals: 70, drain: 0.25, name: 'A' }, { arena: 'hull', vitals: 60, drain: 0.25, name: 'B' }, { arena: 'chestwound', vitals: 55, drain: 0.25, name: 'C' }],\n  stages: [\n    { id: 'batch1', objective: 'THREE TABLES. {table} SWITCHES. WATCH ALL THREE MONITORS.', say: ['reyes|Three tables. One of you. God help them.', 'reyes|{table} to switch tables. Do not fall in love with any of them.'],\n      spawn: [\n        { k: 'pool', table: 0, at: [-1.6, 0.3], r: 1.2 }, { k: 'laceration', table: 0, at: [0.4, 0.4], ang: 6, len: 2.6 },\n        { k: 'debris', table: 1, at: [-2, -0.4], dir: -80, pull: 1.3, prop: 'shard' }, { k: 'debris', table: 1, at: [2.1, 0.6], dir: -100, pull: 1.3, prop: 'bolt' },\n        { k: 'pool', table: 2, at: [0.2, 0], r: 1.3 },\n      ], until: { clear: true } },\n    { id: 'batch2', objective: 'NEW INJURIES ON ALL THREE TABLES', say: 'reyes|Table B has burns. Table C needs opening. Table A is still leaking. Go.',\n      spawn: [\n        { k: 'bleeder', table: 0, at: [2.8, -0.8], r: 0.8 },\n        { k: 'mask', table: 1, at: [0, 0.4], rx: 2, rz: 1.1 }, { k: 'debris', table: 1, at: [-3.6, 1.3], dir: -70, pull: 1.3, prop: 'shard' },\n        { k: 'incision', table: 2, at: [-2.2, 0.4], ang: -6, len: 4.4 },\n      ], until: { clear: true } },\n    { id: 'batch3', objective: 'KEEP MOVING', say: 'pem|Vitals are in the basement. I would take the stairs, Doctor.',\n      spawn: [\n        { k: 'laceration', table: 0, at: [-3.2, -1], ang: -8, len: 2.2 },\n        { k: 'debris', table: 1, at: [3.8, -1.2], dir: -120, pull: 1.3, prop: 'bolt' },\n        { k: 'polyp', table: 2, at: [-1.8, -1.4], r: 0.38 }, { k: 'polyp', table: 2, at: [1.6, -1.2], r: 0.38 }, { k: 'pool', table: 2, at: [0, 1.3], r: 0.9 },\n      ], until: { clear: true } },\n    { id: 'crash', objective: 'TABLE C IS CRASHING. HOLD {gift}.', music: 'or-critical',\n      do: [{ focus: true, table: 2, cue: 'quietAwaken' }, { setVitals: 22, table: 2 }, { unlock: 'gift' }, { composure: 100 }, { prompt: 'HOLD {gift}. THE ROOM GOES QUIET.', promptT: 8 }],\n      say: ['reyes|Table C! His pressure is going! *Doctor!*', 'ilya|No. No no no. Not this one. Not...'],\n      spawn: [\n        { k: 'bleeder', table: 2, at: [-2.2, -0.6], r: 1.05, grow: 0.5, max: 2 }, { k: 'bleeder', table: 2, at: [2.4, -0.4], r: 1.05, grow: 0.5, max: 2 }, { k: 'laceration', table: 2, at: [-1.4, 0.6], ang: 4, len: 2.8 },\n      ],\n      until: { clear: true } },\n    { id: 'after', objective: 'CLOSE THEM. ALL OF THEM.', music: 'or-tense', say: ['ilya|The room... It went quiet. Did the room just go quiet?', 'reyes|You are talking, Doctor. Why are you talking? Sew.'],\n      spawn: [\n        { k: 'pool', table: 0, at: [2, 1.1], r: 0.9 },\n        { k: 'mask', table: 1, at: [-1, -1], rx: 1.6, rz: 0.9 },\n        { k: 'laceration', table: 2, at: [-2.2, -1.8], ang: 2, len: 4.2 },\n      ], until: { clear: true } },\n    { id: 'dressC', objective: 'DRESS TABLE C', context: 'dressing', say: 'reyes|Table C. Dress him. Then go and stand somewhere nobody can see you shake.',\n      do: [{ focus: true, table: 2 }],\n      spawn: [{ k: 'dressing', table: 2, at: [-2.4, 1.4], ang: 0, len: 4.8 }], until: { clear: ['dressing'] } },\n  ],\n};\nEOF\ncat > src/content/ops/op4.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Bone Mend. Sabine's cold commentary replaces some of Reyes's lines.\nconst FRAG = (id, at, to, rot, extra = {}) => ({ k: 'fragment', id, at, to, rot, rotTo: 0, shape: id, ...extra });\n\nexport default {\n  id: 'op4', num: 4, title: 'STICKS AND STONES', arena: 'bone', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-calm',\n  scene: 'ep4', commenter: 'sabine',\n  patient: {\n    name: 'OLLIE BRANDT', age: 16, job: 'FERRY SURVIVOR', hook: 'HE WANTS TO PITCH AGAIN. HE HAS NOT ASKED YOU IF HE CAN. HE ASKED THE NURSE.',\n    objective: 'REBUILD A SHATTERED FOREARM. THE CONSULTANT IS WATCHING.',\n    followUp: { S: 'He threw a strike in April. He has told no one where the scar came from.', A: 'He is pitching again by spring. Sidearm. It suits him.', B: 'He will throw again. Not hard. He has started keeping score instead.', C: 'He keeps the arm. He keeps the ball on the shelf, too.' },\n  },\n  time: 330, vitals: { start: 75, drain: 0.2 }, doses: 3,\n  stages: [\n    { id: 'open', objective: 'OPEN ALONG THE LINE', hint: 'scalpel', say: ['sabine|Dr. Achterberg. I will be watching from the gallery. Begin.', \"sabine|You have two options. The second one is also wrong. Cut.\"], spawn: [{ k: 'incision', at: [-3.2, -2.1], ang: 0, len: 6.4 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN THE FIELD', hint: 'drain', say: 'reyes|There are bone pieces under that. Drain. Gently.',\n      spawn: [{ k: 'pool', id: 'p1', at: [-2.8, 1.4], r: 1.1 }, { k: 'pool', id: 'p2', at: [2.8, 1.3], r: 1.1 }], until: { clear: ['pool'] } },\n    { id: 'mend', objective: 'BONE MEND: CARRY EACH PIECE TO ITS SILHOUETTE, TURN IT, LET GO', hint: 'forceps',\n      say: ['reyes|Forceps. Hold {use} to carry, {rotate} to turn. Fit it to the outline.', 'sabine|Within five degrees is correct. Within fifteen is merely legal.'],\n      spawn: [\n        FRAG('f1', [-3.3, 1.5], [-3.5, 0], 40, { hiddenBy: 'p1' }), FRAG('f2', [-2.1, 1.6], [-2.1, -0.05], -30, { hiddenBy: 'p1' }),\n        FRAG('f3', [-0.6, -1.8], [-0.7, 0.03], 70), FRAG('f4', [0.8, -1.7], [0.7, -0.03], -60),\n        FRAG('f5', [2.3, 1.5], [2.1, 0.05], 25, { hiddenBy: 'p2' }), FRAG('f6', [3.7, -1.7], [3.5, 0], -45),\n      ], until: { clear: ['fragment'] } },\n    { id: 'cement', objective: 'GEL CEMENT ALONG THE SEAMS', hint: 'gel', say: 'reyes|Cement. Gel it along the whole seam. He has to throw with this.', spawn: [{ k: 'mask', path: [[-4.6, 0], [4.6, 0]] }], until: { clear: ['mask'] } },\n    { id: 'artery', objective: 'THE ARTERY: SUTURE IT, FAST', hint: 'suture', music: 'or-tense',\n      do: [{ fx: 'shake' }], say: ['ilya|That is... that is a lot of blood. Why is that a lot of blood?', 'reyes|Radial artery. *Suture!* Now, Doctor!'],\n      spawn: [{ k: 'laceration', id: 'art', at: [-1, 1.7], ang: 0, len: 2.2 }, { k: 'pool', id: 'art-p', at: [0.1, 2.0], r: 1, grow: 0.25, task: false }], until: { clear: ['laceration'] } },\n    { id: 'blue', objective: 'CODE BLUE: HOLD BOTH TRIGGERS, RELEASE IN THE GREEN', say: ['pem|He has flatlined. Terribly sorry. Paddles, Doctor.', 'reyes|Hold both. Let go in the *green*. Twice. Do not touch the table.'],\n      do: [{ setVitals: 8 }, { codeBlue: { then: [{ flag: 'revived' }, { say: 'sabine|Twelve seconds to spare. Do not celebrate. Close.' }] } }], until: { flag: 'revived' } },\n    ...closeUp({ sutures: [{ at: [-3, -2.1], ang: 0, len: 6 }], sutureSay: 'reyes|Close the long cut. In rhythm, Doctor. The boy is sixteen.', gel: { at: [0, -0.1], rx: 2.4, rz: 0.9 }, dressing: { at: [-3, 1.4], ang: 0, len: 6 }, dressSay: 'sabine|Dress it. I will write down that you finished.' }),\n  ],\n  outro: 'sabine|Adequate.',\n};\nEOF\ncat > src/content/ops/op5.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op5', num: 5, title: 'INTROIT', arena: 'liver', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep5', boss: 'introit',\n  patient: {\n    name: 'MR. ANSELM', age: 58, job: 'HARBOUR PILOT', hook: 'HIS ABDOMEN IS LIKE A BAG OF KNIVES. HE FEELS NOTHING. \"ISN\\'T IT WONDERFUL?\"',\n    objective: 'FIND WHAT IS MOVING IN HIS LIVER. TAKE IT OUT.',\n    followUp: { S: 'He woke up in agony and cried with relief. He is back on the harbour.', A: 'He hurts. He complains constantly. Reyes smiles every time.', B: 'He will not pilot again. He has taken up shouting at the ferries from the shore.', C: 'He lives. He asks, some nights, whether it could be put back.' },\n  },\n  time: 360, vitals: { start: 80, drain: 0.3 }, doses: 4,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['reyes|He is smiling, Doctor. His liver looks like a shipwreck, and he is smiling.', 'pem|He told me a joke on the way under. It was quite good.'], spawn: [{ k: 'incision', at: [-3, -2.8], ang: 3, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN', hint: 'drain', spawn: [{ k: 'pool', at: [-2.4, -0.6], r: 1.2 }, { k: 'pool', at: [2.2, 0.4], r: 1.2 }], until: { clear: ['pool'] } },\n    { id: 'scan', objective: 'SCANNER: SOMETHING MOVED', hint: 'scanner', say: ['ilya|It moved. Nurse Reyes, the liver moved.', 'reyes|Livers do not move, Doctor.', 'ilya|This one *knocked*.'],\n      spawn: [{ k: 'strain:introit', id: 'introit', hidden: true, hp: 3, deadFlag: 'introitDead', onReveal: [{ flag: 'found' }, { say: ['reyes|What is that. What *is* that.', 'sabine|...', 'sabine|Get it out.'] }, { music: 'boss-introit' }] }],\n      until: { flag: 'found' } },\n    { id: 'fight', objective: 'WHEN IT KNOCKS: LANCE THE PORE. FORCEPS THE CORE. PULL.', hint: 'scalpel',\n      say: ['sabine|When it surfaces, lance the pore. Short stroke. Do not answer it until you are ready.', 'sabine|Then forceps. Pull against the tether. Do not let go.'],\n      until: { all: [{ flag: 'introitDead' }, { clear: ['laceration'] }] } },\n    { id: 'eggs', objective: 'LASER THE EGGS', hint: 'laser', music: 'or-tense', say: ['reyes|It left something behind. Six. *Laser.* All of them, Doctor.', 'ilya|Eggs. Those are eggs. Why are there eggs?'],\n      spawn: [[-4, -1.6], [-1.8, 1.2], [-0.4, -2], [1.4, 1.4], [3, -1.6], [4.2, 0.6]].map((at) => ({ k: 'egg', at, r: 0.36 })), until: { clear: ['egg'] } },\n    ...closeUp({ sutures: [{ at: [-3, -2.8], ang: 3, len: 6 }], sutureSay: 'reyes|Close him. We are all going to pretend we are calm until he is in recovery.', gel: { at: [0, 0], rx: 2.6, rz: 1.1 }, dressing: { at: [-2.8, 1.8], ang: -2, len: 5.6 } }),\n  ],\n};\nEOF\ncat > src/content/ops/op6.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Cold Hands. Sabine at the table. The first unclamp bursts regardless, and that teaches The Second Look.\nexport default {\n  id: 'op6', num: 6, title: 'COLD HANDS', arena: 'kidneybed', surgeon: 'sabine', gifts: ['look'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-calm',\n  scene: 'ep6',\n  patient: {\n    name: 'ADA OKOYE', age: 47, job: \"PEM'S SISTER. SCHOOL BUS DRIVER.\", hook: 'A DONOR KIDNEY FROM THE MERCY FOUNDATION BANK. PEM IS PASSING GAS FOR HIS OWN SISTER.',\n    objective: 'TRANSPLANT. THE ICE ONLY BUYS YOU TWO MINUTES.',\n    followUp: { S: 'She is back on the route. The children say she drives faster now.', A: 'The kidney took. Pem has stopped making puns for almost a week.', B: 'The kidney took. She will be on pills a long time, and she drives anyway.', C: 'She lives. Pem sits with her in the mornings and says nothing at all.' },\n  },\n  time: 360, vitals: { start: 80, drain: 0.2 }, doses: 3,\n  onRewind: [{ spawn: [{ k: 'clot', id: 'clot', at: [-1.4, -0.9], r: 0.5, unlocks: 'uc1' }] }, { lock: 'uc1' }, { say: 'sabine|There. See it now? *Laser* the clot. Then again.' }, { composure: 0 }],\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['sabine|Reyes. I will take this one. Stand where I can hear you disapprove.', 'reyes|Yes, Doctor. She said it like she meant it.'], spawn: [{ k: 'incision', at: [-3, -2.6], ang: 2, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'clamps', objective: 'FORCEPS: CLAMP BOTH VESSELS', hint: 'forceps', say: 'sabine|Clamp the artery, clamp the vein. Carry each clamp to its mark.',\n      spawn: [{ k: 'clamp', id: 'c1', at: [-5.2, 1.6], to: [-1.4, -0.9], tol: 0.6 }, { k: 'clamp', id: 'c2', at: [-4.4, 1.9], to: [1.4, -0.9], tol: 0.6 }], until: { clear: ['clamp'] } },\n    { id: 'cut', objective: 'SCALPEL: CUT BOTH VESSELS', hint: 'scalpel', say: 'sabine|Short strokes. It is a kidney. It is not your enemy yet.',\n      spawn: [{ k: 'incision', at: [-1.9, -0.25], ang: 0, len: 1, short: true }, { k: 'incision', at: [0.9, -0.25], ang: 0, len: 1, short: true }], until: { clear: ['incision'] } },\n    { id: 'lift', objective: 'FORCEPS: LIFT OUT THE FAILING KIDNEY', hint: 'forceps', say: 'reyes|Out it comes. Mind the ureter. She needs that.', spawn: [{ k: 'organ', id: 'oldkidney', at: [0, 0.7], dir: -90, pull: 2.8, grabR: 0.8, tearMul: 1.8, organ: 'old' }], until: { clear: ['organ'] } },\n    { id: 'donor', objective: 'FETCH THE DONOR KIDNEY FROM THE ICE TRAY', hint: 'forceps', music: 'or-tense',\n      do: [{ cold: 120 }], say: ['reyes|Donor kidney on ice. *Two minutes*, Doctor. The clock on the tray is the one that matters.', 'pem|From the Mercy Foundation bank. Very generous. Very clean paperwork.'],\n      spawn: [{ k: 'donor', id: 'newkidney', at: [4.6, -2.6], to: [0, 0.7], tol: 0.8, grabR: 0.6, keep: true, perfuse: 0 }], until: { clear: ['donor'] } },\n    { id: 'anast', objective: 'SUTURE THE ARTERY, THE VEIN, THE URETER', hint: 'suture', say: 'sabine|Three anastomoses. Short. Precise. Your hands are colder than the ice. Use that.',\n      spawn: [{ k: 'laceration', at: [-1.4, -0.5], ang: 0, len: 1.4, bleed: false }, { k: 'laceration', at: [0.6, -0.6], ang: 0, len: 1.4, bleed: false }, { k: 'laceration', at: [-0.7, 2], ang: 0, len: 1.4, bleed: false }], until: { clear: ['laceration'] } },\n    { id: 'unclamp', objective: 'FORCEPS: PULL THE ARTERY CLAMP', hint: 'forceps', do: [{ cold: null }, { remove: ['c1', 'c2'] }], say: 'sabine|Unclamp. Artery first. Slowly.',\n      spawn: [{ k: 'unclamp', id: 'uc1', at: [-1.4, -0.9], dir: -90, pull: 1.1, onDone: [{ ifPersist: 'looked', then: [{ flag: 'cleanOpen' }], else: [{ flag: 'clotBurst' }, { fx: 'shake' }, { vitals: -10 }, { composure: 100 }, { spawn: [{ k: 'bleeder', id: 'burst1', at: [-1.2, 0], r: 1.4, grow: 0.4, max: 2, task: true }, { k: 'bleeder', id: 'burst2', at: [1.1, 0.4], r: 1, grow: 0.3, max: 1.8, task: true }] }, { say: ['ilya|Clot! There was a clot! Nobody could have seen...', 'sabine|Again.'] }, { prompt: 'PRESS {gift}: THE SECOND LOOK. SEE IT BEFORE IT HAPPENS.', promptT: 12 }] }] }],\n      until: { any: [{ flag: 'clotBurst' }, { flag: 'cleanOpen' }] } },\n    { id: 'again', objective: 'PRESS {gift}. OR DO IT THE SLOW WAY.',\n      timed: [{ at: 8, say: 'sabine|The slow way, then. Drain it. Burn the clot. Do not make this a habit.', spawn: [{ k: 'clot', id: 'clot', at: [-1.4, -0.9], r: 0.5 }] }],\n      until: { any: [{ flag: 'cleanOpen' }, { clear: ['bleeder', 'clot'], time: 0.1 }] } },\n    { id: 'unclamp2', objective: 'PULL THE VEIN CLAMP', hint: 'forceps', say: 'sabine|Now the vein. Watch the colour. This is the part you get to keep.',\n      spawn: [{ k: 'unclamp', id: 'uc2', at: [1.4, -0.9], dir: -90, pull: 1.1, onDone: [{ perfuse: 'newkidney' }, { flag: 'pink' }, { music: 'or-calm' }, { say: ['pem|There she goes. Pinking up. ...That is my sister, you know.', 'sabine|I know.'] }] }], until: { clear: ['unclamp'] } },\n    { id: 'pinks', objective: 'WATCH IT', until: { time: 3.2 } },\n    { id: 'sample', objective: 'SCANNER: CHECK THE DONOR TISSUE SAMPLE', hint: 'scanner', say: 'sabine|One more thing. Scan the sample from the donor kidney. Humour me.',\n      spawn: [{ k: 'polyp', id: 'sample', at: [3.8, 1.7], r: 0.5, hidden: true, task: true, inertUntil: true, onReveal: [{ flag: 'sampleSeen' }, { say: ['ilya|That is... it is asleep. It is the same thing. In the *donor*.', 'sabine|Mercy. Dormant. In the Foundation\\'s own bank.', 'reyes|Show it none, Doctor.'] }, { remove: ['sample'] }] }], until: { flag: 'sampleSeen' } },\n    ...closeUp({ sutures: [{ at: [-3, -2.6], ang: 2, len: 6 }], gel: { at: [0, 1], rx: 2, rz: 0.9 }, dressing: { at: [-2.8, 2.3], ang: 0, len: 5.6 }, dressSay: 'reyes|Dress it. The kidney is the only honest thing that came from that bank.' }),\n  ],\n};\nEOF\ncat > src/content/ops/op7.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op7', num: 7, title: 'LACRIMOSA', arena: 'lung', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep7', boss: 'lacrimosa',\n  patient: {\n    name: 'OTTILIE MARR', age: 49, job: 'HOSPICE NURSE', hook: \"REYES'S OLDEST FRIEND. SHE IS SMILING. SHE WORKED FOR THE FOUNDATION FOR NINE YEARS.\",\n    objective: 'THE LUNG IS WEEPING. MAKE IT STOP.',\n    followUp: { S: 'She feels every breath now. She says thank you for each of them.', A: 'She is back on a ward. A real one. She and Reyes do not discuss it.', B: 'Her lung is half what it was. She climbs the stairs anyway, swearing.', C: 'She lives, on oxygen. Reyes visits. Reyes also, once, cried. Alone.' },\n  },\n  time: 390, vitals: { start: 80, drain: 0.3 }, doses: 4,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: ['reyes|That is Ottilie. You will be *perfect*, Doctor, or I will know why.', 'ilya|Yes, Nurse Reyes.'], spawn: [{ k: 'incision', at: [-3, -2.9], ang: 0, len: 6 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN. THEN SCAN.', hint: 'drain', spawn: [{ k: 'pool', at: [-1.8, 0.4], r: 1.1 }, { k: 'pool', at: [2, -0.6], r: 1 }], until: { clear: ['pool'] } },\n    { id: 'scan', objective: 'SCANNER: SOMETHING IS WATCHING', hint: 'scanner', say: 'ilya|It is breathing out of time with her. Why is it out of time with her?',\n      spawn: [{ k: 'marker', id: 'watcher', at: [0, -1.2], hidden: true, onReveal: [{ flag: 'seen' }, { remove: ['watcher'] }] }], until: { flag: 'seen' } },\n    { id: 'fight', objective: 'LASER THE OPEN EYES. DRAIN OR GEL THE TEARS.', music: 'boss-lacrimosa', hint: 'laser',\n      say: ['reyes|Eyes. It has *eyes*. Laser them when they open!', 'sabine|Drain the tears, or lay gel down and let them die on it.', 'sabine|Do not look at them longer than you have to.'],\n      spawn: [{ k: 'strain:lacrimosa', id: 'lacrimosa', deadFlag: 'lacDead', halfLine: \"ilya|It's crawling. It's crawling! Why would it crawl?\", sobLine: ['reyes|The last one. It is going to *sob*. Gel that line, Doctor!', 'sabine|The whole line. Before it breathes out.'] }],\n      until: { flag: 'lacDead' } },\n    { id: 'mop', objective: 'CLEAN UP THE NICKS', hint: 'gel', music: 'or-tense', say: ['reyes|Ottilie. Ottilie, can you hear me.', 'pem|She is awake under there. She just said *ow*.', 'reyes|...Say it again, you old fool. Say it again.'], spawn: [{ k: 'mask', at: [0, 0.3], rx: 2.2, rz: 1 }], until: { clear: ['mask'] } },\n    ...closeUp({ sutures: [{ at: [-3, -2.9], ang: 0, len: 6 }], dressing: { at: [-2.8, 1.9], ang: 0, len: 5.6 }, dressSay: \"reyes|Dress it. Then get out of my theatre for ten minutes. All of you.\" }),\n  ],\n};\nEOF\ncat > src/content/ops/op8.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\nexport default {\n  id: 'op8', num: 8, title: 'DIES IRAE', arena: 'heart', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'or-tense',\n  scene: 'ep8', boss: 'diesirae',\n  patient: {\n    name: 'CHIEF CORNELIUS BRAM', age: 68, job: 'CHIEF OF SURGERY', hook: '\"DON\\'T YOU DARE BE GENTLE.\" HE GAVE YOU HIS OLD SCALPEL.',\n    objective: 'IT LIVES ON HIS HEART. WORK BETWEEN THE BEATS.',\n    followUp: { S: 'He retired on the Friday. He is in the gallery on the Monday, criticising.', A: 'His hands have stopped shaking. He is learning, at 68, what that feels like.', B: 'He will not operate again. He is the worst patient the ward has ever had.', C: 'He lives. He walks the corridors at night. Nobody tells him to go home.' },\n  },\n  time: 420, vitals: { start: 75, drain: 0.35 }, doses: 5,\n  stages: [\n    { id: 'open', objective: 'OPEN', hint: 'scalpel', say: [\"reyes|That is your Chief. That is your *scalpel*. Whatever you are feeling, stop.\", \"ilya|It is beating very fast. Is it supposed to be that fast?\"], spawn: [{ k: 'incision', at: [-3.6, -3], ang: 2, len: 7.2 }], until: { clear: ['incision'] } },\n    { id: 'drain', objective: 'DRAIN', hint: 'drain', spawn: [{ k: 'pool', at: [-3, 1], r: 1 }, { k: 'pool', at: [3, 0.6], r: 1 }], until: { clear: ['pool'] } },\n    { id: 'fight', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN. SYRINGE SLOWS HIM.', music: 'boss-diesirae', hint: 'scalpel',\n      say: ['reyes|Everything on the beat, Doctor. Watch the ring. *Red, you wait.*', 'pem|A dose slows him. He has about five doses of patience in him.', 'sabine|Cut a plate in one beat. Lift it in the next. Then burn the eye.'],\n      spawn: [{ k: 'strain:diesirae', id: 'diesirae', cz: -0.3, deadFlag: 'wrathDead', fibLine: \"pem|He's back. Slower, please. I am too old for this.\", arrestLine: ['pem|He has arrested. Your hands, Doctor. Both of them.', 'reyes|*Massage.* Left, right, on the beat. Eight. Count them!'], finalLine: ['bram|...Don\\'t you dare...', 'reyes|Final cut! Now, Doctor! Now!'] }],\n      until: { flag: 'wrathDead' } },\n    { id: 'beat', objective: 'LISTEN', music: 'or-calm', say: ['pem|Sinus rhythm. Seventy-two. Steady as a very old clock.', 'reyes|...Close him up. He will want to check your work.'], until: { time: 3 } },\n    ...closeUp({ sutures: [{ at: [-3.6, -3], ang: 2, len: 7.2 }], gel: { at: [0, 0], rx: 2.6, rz: 1.2 }, dressing: { at: [-3, 2.4], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. That is the first straight line you have ever drawn, Doctor.' }),\n  ],\n};\nEOF\ncat > src/content/ops/op9.js <<'EOF'\n// Libera Me. NO SIGNAL. No hint marker, no voice. Two surgeons, one bot's hand, Reyes on the table.\nconst cyst = (at, real) => ({ k: 'cyst', at, real, scanned: false, r: 0.42, task: real });\n\nexport default {\n  id: 'op9', num: 9, title: 'LIBERA ME', arena: 'chest', surgeon: 'both', gifts: ['quiet', 'look'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: null, noVoice: true, noHint: true,\n  scene: 'ep9', boss: 'libera', pairOp: true,\n  seatDefaults: { surgeon: 'ilya', gift: 'quiet', region: 'right' },\n  partner: { surgeon: 'sabine', gift: 'look', bot: { skill: 0.72 }, region: 'left' },\n  patient: {\n    name: 'NURSE ODALYS REYES', age: 46, job: 'SCRUB NURSE, VERITY GENERAL', hook: 'SHE TOLD YOU TO START WITHOUT HER. THERE IS NOBODY IN YOUR EAR.',\n    objective: 'THE MONITOR IS LYING. EVERYTHING IS LYING. WORK.',\n    followUp: { S: '...Your sutures are crooked, Doctor. She has asked to see the chart. She has corrections.', A: 'She woke up and asked who was minding the instruments.', B: 'She is alive. She has told the night staff you were adequate. You cried.', C: 'She is alive. She will be in a chair for a while. She has already run it over your foot.' },\n  },\n  time: 540, vitals: { start: 70, drain: 0.35 }, doses: 6,\n  stages: [\n    { id: 'quiet0', objective: '', do: [{ fake: 99 }, { music: 'silence' }], until: { time: 1.5 } },\n    { id: 'sanctus', objective: 'THE FIELD LOOKS HEALTHY. SCAN THE CYSTS. BURN THE REAL ONES.', music: 'boss-libera',\n      spawn: [cyst([-4.4, -1.8], true), cyst([-2.6, 0.8], true), cyst([-1.4, -2.3], true), cyst([-0.6, 1.5], false), cyst([-3.6, 1.9], false), cyst([1.2, -2.1], true), cyst([2.2, 0.6], true), cyst([3.4, -1.2], true), cyst([4.4, 1.4], true), cyst([0.9, 0.3], false), cyst([3.2, 1.9], false), cyst([-0.5, -0.7], true)],\n      until: { clear: ['cyst'] }, after: [{ fake: null }, { fx: 'shake' }, { cue: 'trueVitals' }] },\n    { id: 'reprise', objective: 'THE RIGHT HALF IS YOURS. THE LEFT IS HERS. ALL THREE OF THEM AT ONCE.', music: 'boss-libera2',\n      spawn: [\n        { k: 'strain:introit', id: 'introit', hp: 1, deadFlag: 'r1', way: [[-5, -1.8], [-1.5, -2.6], [-1.2, 0.4], [-4.8, 1.2]] },\n        { k: 'strain:lacrimosa', id: 'lacrimosa', count: 2, eyeHp: 2, deadFlag: 'r2', noSob: true, positions: [[3.2, -2.4], [4.6, 1.2]], maxOpen: 1 },\n        { k: 'strain:diesirae', id: 'diesirae', cx: 2.2, cz: 0, ringR: 1.3, rounds: [3], noArrest: true, deadFlag: 'r3', flareEvery: 12, xOff: 2 },\n      ],\n      until: { all: [{ flag: 'r1' }, { flag: 'r2' }, { flag: 'r3' }, { clear: ['laceration'] }] } },\n    { id: 'miserere', objective: 'IT COPIES YOU. KEEP MOVING. {tag} TAGS DOCTORS.', music: 'boss-libera3',\n      spawn: [{ k: 'strain:miserere', id: 'miserere', deadFlag: 'mis', cx: 0, cz: -0.6 }],\n      until: { flag: 'mis' } },\n    { id: 'blue', objective: 'CODE BLUE. YOU KNOW WHAT TO DO.', music: 'silence', do: [{ setVitals: 4 }, { codeBlue: { need: 2, time: 14, restore: 30, then: [{ flag: 'back' }] } }], until: { flag: 'back' } },\n    { id: 'silence', objective: '', music: 'silence', until: { time: 7 }, timed: [{ at: 4.5, say: 'reyes|...Your sutures are crooked, Doctor.', cue: 'reyesBack' }] },\n  ],\n};\nEOF\ncat > src/content/ops/op10.js <<'EOF'\nimport { closeUp } from './_kit.js';\n\n// Do No Harm. Generous clock, soft music, no attacks. After all that action the slowness is the point.\nconst strand = (n, at, line) => ([\n  { k: 'incision', id: `s${n}cut`, at: [at[0] - 0.6, at[1]], ang: 0, len: 1.2, short: true, unlocks: `s${n}` },\n  { k: 'prop', id: `s${n}`, prop: 'strand', at, dir: at[1] > 0 ? 80 : -80, pull: 1.3, speedLimit: 2.6, locked: true, onDone: [{ vitals: 6 }, { painUp: 1 }, { say: line }] },\n]);\n\nexport default {\n  id: 'op10', num: 10, title: 'DO NO HARM', arena: 'spine', surgeon: 'ilya', gifts: ['quiet'], tools: ['drain', 'forceps', 'suture', 'gel', 'syringe', 'scalpel', 'laser', 'scanner'], music: 'op10',\n  scene: 'ep10',\n  patient: {\n    name: 'DR. HESPER LINDQVIST', age: 66, job: 'FOUNDER, THE MERCY FOUNDATION', hook: 'SHE TOOK IT FIRST, ELEVEN YEARS AGO. SHE HAS NOT FELT ANYTHING SINCE.',\n    objective: 'NO ONE IS GOING TO ATTACK YOU. TAKE YOUR TIME.',\n    followUp: { S: 'She pleaded guilty to everything, in pain, and refused anything for it.', A: 'She testified from a wheelchair. She wept when the sun was warm.', B: 'She lives. The Foundation does not. She writes to you. You have not replied.', C: 'She lives. She has asked what it was for. You are still working on that.' },\n  },\n  time: 240, vitals: { start: 60, drain: 0.05 }, doses: 2,\n  stages: [\n    { id: 'open', objective: 'SLOWLY. ALONG THE SPINE.', hint: 'scalpel', say: ['reyes|You do not have to do this, Doctor. I will say so once. It is on the chart.', 'ilya|It is my shift.'],\n      do: [{ pain: 0 }], spawn: [{ k: 'strain:pale', id: 'pale', at: [0, 0.2], task: false }, { k: 'incision', at: [-4.4, -2.5], ang: 0, len: 8.8 }], until: { clear: ['incision'] } },\n    { id: 'strands', objective: 'A SHORT CUT. THEN GENTLY, GENTLY LIFT EACH STRAND.', hint: 'scalpel', say: ['reyes|Slow strokes. Slow forceps. It will not fight you. That is what is wrong with it.', 'hesper|I can hear you. I can hear everything. Isn\\'t it strange. Nothing else.'],\n      spawn: [...strand(1, [-3.6, 0.7], 'hesper|...Something. I felt something. A cold.'), ...strand(2, [-1.4, -0.8], 'hesper|That is my back. I had forgotten I had a back.'), ...strand(3, [1.3, 0.8], 'hesper|Oh. Oh, that is... Is it always like this?'), ...strand(4, [3.5, -0.7], 'hesper|It hurts. Doctor. Doctor, it *hurts*.')],\n      until: { clear: ['incision', 'prop'] } },\n    { id: 'core', objective: 'THE LAST OF IT. THE GENTLEST HANDS YOU HAVE.', hint: 'forceps', say: ['hesper|Why? You could have let me go. Why are you doing this?', 'ilya|Because it\\'s my shift.'],\n      spawn: [{ k: 'core', id: 'palecore', at: [0, 0.2], dir: -90, pull: 2.4, speedLimit: 1.8, grabR: 0.3, tearMul: 1.5, onDone: [{ vitals: 15 }, { painUp: 2 }, { remove: ['pale'] }, { say: ['hesper|...Ah. *Ah.* There you are. Eleven years.', 'reyes|Close her, Doctor. Gently. She can feel it now.'] }] }], until: { clear: ['core'] } },\n    ...closeUp({ sutures: [{ at: [-4.4, -2.5], ang: 0, len: 8.8 }], gel: { at: [0, 0.2], rx: 3, rz: 1 }, dressing: { at: [-3, 2.2], ang: 0, len: 6 }, dressSay: 'reyes|Dress it. Straight. ...That will do, Doctor.' }),\n  ],\n};\nEOF\ncat > src/content/ops/pileup.js <<'EOF'\n// Consult's own op: a wave-based chest wound. Survive the clock, clear what you can, save the patient.\nconst SPECS = {\n  hook: { k: 'hook', pull: 1.2, dir: [-120, -60], arc: 0.8, task: false },\n  pool: { k: 'pool', r: [0.8, 1.3], task: false },\n  bleeder: { k: 'bleeder', r: [0.6, 0.9], task: false },\n  lac: { k: 'laceration', len: 2.2, ang: [-25, 25], task: false },\n  polyp: { k: 'polyp', r: 0.38, task: false },\n};\nexport default {\n  id: 'pileup', num: 0, title: 'PILE-UP', arena: 'chest', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'], music: 'or-tense', session: true, consult: true, surviveClock: true,\n  patient: {\n    name: 'NOAH VIK', age: 34, job: 'BUS DRIVER, HARBOUR ROAD', hook: 'THE WHOLE ROAD CAME IN WITH HIM. HE IS THE ONE THEY GAVE YOU.',\n    objective: 'KEEP THE PATIENT ALIVE UNTIL THE CLOCK RUNS OUT. TOP THE TEAM SCORE.',\n    followUp: { S: 'He drove the bus to his own discharge.', A: 'He is sore, loud and alive.', B: 'He lives. He has opinions about the ambulance.', C: 'He lives. Somehow. Nobody will say how.' },\n  },\n  time: 225, vitals: { start: 90, drain: 0.16 }, doses: 6,\n  stages: [\n    { id: 'waves', objective: 'KEEP THE PATIENT ALIVE. EVERYTHING IS YOURS.', say: ['reyes|Harbour Road. Hooks, glass, the lot. Scrub in, all of you.', 'pem|Plenty of patient to go around.'],\n      spawn: [{ k: 'pool', at: [-2.4, 0.4], r: 1.2, task: false }, { k: 'hook', at: [2, 0.6], dir: -90, arc: 0.8, pull: 1.2, task: false }],\n      timed: [\n        { at: 5, every: 18, scaled: true, times: 12, rand: { spec: SPECS.pool, n: 1 } },\n        { at: 12, every: 16, scaled: true, times: 12, rand: { spec: SPECS.hook, n: 2 } },\n        { at: 20, every: 26, scaled: true, times: 8, rand: { spec: SPECS.lac, n: 1 } },\n        { at: 30, every: 20, scaled: true, times: 10, rand: { spec: SPECS.polyp, n: 2 } },\n        { at: 45, every: 30, scaled: true, times: 6, rand: { spec: SPECS.bleeder, n: 2 }, say: 'reyes|Surge! Bleeders! Move, Doctors!' },\n        { at: 185, spawn: [{ k: 'strain:introit', id: 'introit', hp: 1, deadFlag: 'pileIntroit', task: false }], say: ['ilya|It... knocked. Nurse Reyes, this one *knocked*.', 'reyes|Forty seconds, Doctors. Show it none.'], music: 'boss-introit' },\n      ],\n      until: { flag: 'neverEnds' } },\n  ],\n};\nEOF\ncat > src/content/ops/session.js <<'EOF'\n// Trimmed boss fights for AI Hub rounds and Consult: all tools, hints and lines on, at most four minutes.\nconst ALL = ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'];\nconst hook = { hook: 'THE HUB DEALT YOU THIS ONE.', followUp: { S: 'Textbook.', A: 'Very good.', B: 'They lived.', C: 'They lived. Barely.' } };\n\nexport const sessionIntroit = {\n  id: 'session-introit', num: 0, title: 'INTROIT (CONSULT)', arena: 'liver', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-introit', session: true, consult: true,\n  patient: { name: 'A HARBOUR PILOT', age: 44, job: 'SMILING', objective: 'WHEN IT KNOCKS: LANCE, GRAB, PULL. THREE TIMES.', ...hook },\n  time: 225, vitals: { start: 90, drain: 0.25 }, doses: 5,\n  stages: [\n    { id: 'fight', objective: 'WHEN IT KNOCKS: LANCE THE PORE. FORCEPS THE CORE. PULL.', say: ['sabine|Do not answer it until you are ready.', 'reyes|Show it none, Doctors.'], spawn: [{ k: 'strain:introit', id: 'introit', hp: 3, deadFlag: 'dead' }, { k: 'pool', at: [-2.2, 0.2], r: 1, task: false }], until: { all: [{ flag: 'dead' }, { clear: ['laceration'] }] } },\n    { id: 'close', objective: 'LASER THE EGGS', spawn: [[-3, -1], [0, 1.2], [3, -1]].map((at) => ({ k: 'egg', at, r: 0.38 })), until: { clear: ['egg'] } },\n  ],\n};\nexport const sessionLacrimosa = {\n  id: 'session-lacrimosa', num: 0, title: 'LACRIMOSA (CONSULT)', arena: 'lung', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-lacrimosa', session: true, consult: true,\n  patient: { name: 'A HOSPICE NURSE', age: 39, job: 'SMILING', objective: 'LASER THE EYES. DRAIN THE TEARS. HOLD THE LINE WHEN IT SOBS.', ...hook },\n  time: 230, vitals: { start: 90, drain: 0.25 }, doses: 5,\n  stages: [\n    { id: 'fight', objective: 'LASER THE OPEN EYES. DRAIN OR GEL THE TEARS.', say: ['reyes|Eyes. Laser them when they open, Doctors!', 'sabine|Do not look at them longer than you have to.'], spawn: [{ k: 'strain:lacrimosa', id: 'lacrimosa', count: 4, eyeHp: 2, sobs: 2, deadFlag: 'dead', sobLine: 'reyes|It is going to *sob*. Gel that line!' }], until: { flag: 'dead' } },\n  ],\n};\nexport const sessionDiesIrae = {\n  id: 'session-diesirae', num: 0, title: 'DIES IRAE (CONSULT)', arena: 'heart', surgeon: 'ilya', gifts: ['quiet', 'look'], tools: ALL, music: 'boss-diesirae', session: true, consult: true,\n  patient: { name: 'A CHIEF OF SOMETHING', age: 70, job: 'SHOUTING', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN.', ...hook },\n  time: 230, vitals: { start: 85, drain: 0.3 }, doses: 6,\n  stages: [\n    { id: 'fight', objective: 'ONLY BETWEEN THE BEATS: CUT, LIFT, BURN. SYRINGE SLOWS IT.', say: ['reyes|Everything on the beat. Red, you wait.', 'pem|A dose slows him, Doctors.'], spawn: [{ k: 'strain:diesirae', id: 'diesirae', cz: -0.3, rounds: [2, 2], deadFlag: 'dead', arrestLine: 'reyes|*Massage!* Left, right, on the beat!', finalLine: 'reyes|Final cut! Now!' }], until: { flag: 'dead' } },\n  ],\n};\nEOF\ncat > src/content/ops/pars.js <<'EOF'\n// `par`, calibrated from the bot at full skill by tests/balance.mjs --pars.\nexport const PARS = { op1: 4000, op2: 4000, op3: 4000, op4: 4000, op5: 4000, op6: 4000, op7: 4000, op8: 4000, op9: 4000, op10: 4000, pileup: 4000, 'session-introit': 3000, 'session-lacrimosa': 3000, 'session-diesirae': 3000 };\nEOF\ncat > src/content/ops/index.js <<'EOF'\nimport op1 from './op1.js';\nimport op2 from './op2.js';\nimport op3 from './op3.js';\nimport op4 from './op4.js';\nimport op5 from './op5.js';\nimport op6 from './op6.js';\nimport op7 from './op7.js';\nimport op8 from './op8.js';\nimport op9 from './op9.js';\nimport op10 from './op10.js';\nimport pileup from './pileup.js';\nimport { sessionDiesIrae, sessionIntroit, sessionLacrimosa } from './session.js';\nimport { PARS } from './pars.js';\n\nexport const CAMPAIGN_OPS = [op1, op2, op3, op4, op5, op6, op7, op8, op9, op10];\nexport const SESSION_OPS = [pileup, sessionIntroit, sessionLacrimosa, sessionDiesIrae];\nexport const OPS = Object.fromEntries([...CAMPAIGN_OPS, ...SESSION_OPS].map((o) => [o.id, o]));\nfor (const o of Object.values(OPS)) o.par = PARS[o.id] ?? o.par ?? 4000;\nEOF\npython3 - <<'EOF'\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"    if (c.pain != null) { sim.pain = c.pain; emit(sim, 'pain', { pain: c.pain }); }\",\"    if (c.pain != null) { sim.pain = c.pain; emit(sim, 'pain', { pain: c.pain }); }\\n    if (c.painUp != null) { sim.pain += c.painUp; emit(sim, 'pain', { pain: sim.pain }); }\")\nopen(p,'w').write(s)\nEOF\ncat > tests/simlib.mjs <<'EOF'\n// Helpers for sim tests.\nimport { createConfig } from '../src/core/config.js';\nimport { OPS } from '../src/content/ops/index.js';\nimport { createOp, drainEvents, step } from '../src/sim/op.js';\n\nexport function runBot(id, { skill = 0.7, seed = 7, difficulty = 'resident', maxTicks = 60 * 900, config, seats, cheats, onTick } = {}) {\n  const def = OPS[id];\n  const base = def.seatDefaults ?? {};\n  const sim = createOp(def, { seed, difficulty, config: config ?? createConfig(), seats: seats ?? [{ id: 0, ...base, bot: { skill } }], cheats });\n  let ticks = 0;\n  while (sim.status === 'playing' && ticks < maxTicks) {\n    step(sim, {});\n    drainEvents(sim);\n    onTick?.(sim, ticks);\n    ticks++;\n  }\n  return { sim, ticks };\n}\nEOF\ncat > tests/quick.mjs <<'EOF'\nimport { OPS } from '../src/content/ops/index.js';\nimport { finalTally } from '../src/sim/scoring.js';\nimport { runBot } from './simlib.mjs';\nconst ids = process.argv[2] ? process.argv[2].split(',') : Object.keys(OPS);\nconst skill = Number(process.argv[3] ?? 1);\nfor (const id of ids) {\n  const { sim, ticks } = runBot(id, { skill });\n  const st = sim.def.stages[sim.stage];\n  const tally = sim.status === 'won' ? finalTally(sim) : null;\n  console.log(id.padEnd(18), sim.status.padEnd(8), `t=${(ticks/60).toFixed(0)}s clock=${sim.clock.toFixed(0)} stage=${st.id} (${sim.stage+1}/${sim.def.stages.length}) vit=${sim.tables.map(t=>t.vitals.toFixed(0)).join('/')} mis=${sim.mistakes} doses=${sim.doses} ${sim.failReason??''} ${tally?`total=${tally.total} tech=${tally.technique}`:''} open=${sim.ents.filter(e=>e.task&&!e.dead).map(e=>e.k).slice(0,5)}`);\n}\nEOF\nnode tests/quick.mjs 2>&1 | head -40","description":"Write all op data and run bot through every op","timeout":300000}}}
