{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk4oZ2xdY57M5AE76KLY","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10545,"cache_read_input_tokens":464372,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10545},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"b0876473-ee65-47f5-be44-94804a3fabc6","timestamp":"2026-11-05T16:05:51.836Z","request_id":"req_011Cgk4oYZSdmxaf66ogUfYF","thinking_duration_ms":33117,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk4oZ2xdY57M5AE76KLY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YH4fnAta3n8hteUYBb1Y2Q","name":"Bash","input":{"command":"cat > src/stages/flow.js <<'EOF'\n// Where the shift goes next. Save after every op.\nimport { App } from '../app.js';\nimport { OP_CAMERA } from './operation.js';\nimport { advance, currentStep } from '../sim/campaign.js';\nimport { betterRank } from '../sim/scoring.js';\n\nexport const CLOSE_CAM = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\nexport { OP_CAMERA };\n\nexport async function goCampaign() {\n  const p = App.save.progress;\n  const s = currentStep(p);\n  if (s.kind === 'scene') {\n    const { StoryStage } = await import('./story.js');\n    return App.goto(new StoryStage({ sceneId: s.id, onDone: () => { App.save.progress = advance(App.save.progress); App.persist(); goCampaign(); } }), { kind: 'dissolve', camera: CLOSE_CAM });\n  }\n  if (s.kind === 'op') {\n    const { BriefingStage } = await import('./briefing.js');\n    return App.goto(new BriefingStage({ opId: s.id, mode: 'story', difficulty: p.difficulty }), { kind: 'fade', camera: CLOSE_CAM });\n  }\n  const { ShiftReportStage } = await import('./results.js');\n  return App.goto(new ShiftReportStage(), { kind: 'fade', camera: CLOSE_CAM });\n}\n\n/** A won op is recorded, and in the campaign the shift moves on. */\nexport function recordOp(opId, tally, mode) {\n  const log = App.save.log;\n  const prev = log[opId];\n  const best = !prev || prev.total < tally.total ? { total: tally.total, rank: betterRank(tally.rank, prev?.rank), pristine: tally.pristine || !!prev?.pristine, mistakes: tally.mistakes } : { ...prev, rank: betterRank(tally.rank, prev.rank), pristine: tally.pristine || !!prev.pristine };\n  log[opId] = best;\n  if (mode === 'story' && App.save.progress) App.save.progress = advance(App.save.progress);\n  App.persist();\n}\nexport async function toTitle(state = 'main') {\n  const { TitleStage } = await import('./title.js');\n  return App.goto(new TitleStage(state), { kind: 'fade' });\n}\nEOF\ncat > src/stages/story.js <<'EOF'\n// A story scene: set plus busts, typewriter text with gibberish voice, the speaker leaning in and the\n// other dimmed. Wide shots use full-body figures and the engine's Timeline.\nimport { THREE, Timeline } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { SPEAKER_NAMES } from '../content/lines.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { pauseAfter } from '../audio/voice.js';\nimport { BustRig } from '../view/bust.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nconst SLOTS = { L: -1.3, R: 1.3 };\nconst FIGS = { ilya: 'Idle', reyes: 'Idle', sabine: 'IdleLook', bram: 'Idle', pem: 'Sit', hesper: 'Idle', tomasz: 'Idle', zamboni: 'Wave', anselm: 'Idle', ottilie: 'Idle', ollie: 'Idle' };\n\nexport class StoryStage extends Stage {\n  name = 'story';\n  constructor(o) {\n    super();\n    this.o = o;\n    this.scene = SCENES[o.sceneId];\n    this.i = -1;\n    this.chars = 0;\n    this.acc = 0;\n    this.pause = 0;\n    this.busts = {};\n    this.slots = { L: null, R: null };\n    this.figures = [];\n    this.markT = 0;\n    this.mark = null;\n    this.skipHold = 0;\n    this.camMode = 'close';\n    this.done = false;\n    this.ambT = 8;\n    this.autoT = 0;\n    this.busy = false;\n  }\n  cameraConfig = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\n\n  async build(ctx) {\n    this.setId = this.scene.set;\n    this.set = new SetView(ctx, this.setId);\n    this.makeKey(ctx);\n    this.placeFigures(ctx);\n    App.director.play(this.scene.music, { now: true });\n    applyLook(ctx.engine, App.save.settings);\n    this.rain = this.scene.rain || this.setId === 'helipad' ? ctx.audio.loop('rainLoop', { volume: this.setId === 'helipad' ? 1 : 0.5 }) : null;\n    this.next();\n  }\n  makeKey(ctx) {\n    // A key light for the faces, whatever the room is doing.\n    this.key?.release();\n    this.key = ctx.lights.request({ position: [0.4, 3, 3.4], color: 0xfff0e0, intensity: 7, radius: 8, priority: 8 });\n  }\n  placeFigures(ctx) {\n    for (const f of this.figures) ctx.scene.remove(f.object);\n    this.figures = [];\n    const who = [...new Set(this.scene.beats.map((b) => b.who).filter(Boolean))].slice(0, this.set.spots?.length ?? 3);\n    const figsFor = { ilya: 'ilya', reyes: 'reyes', sabine: 'sabine', bram: 'bram', pem: 'pem', hesper: 'hesper' };\n    const spots = this.set.spots ?? [];\n    who.forEach((w, i) => {\n      const s = spots[i];\n      if (!s) return;\n      const clip = this.scene.id === 'end' && w === 'reyes' ? 'Sit' : FIGS[w] ?? 'Idle';\n      const f = new Figure(ctx, figsFor[w] ?? 'patient', [s[0], s[1], s[2]], s[3], clip);\n      this.figures.push(f);\n    });\n    // A patient on the table, an orderly in the corridor: rooms should have people in them.\n    if (this.setId === 'corridor') {\n      this.figures.push(new Figure(ctx, 'extra', [2.6, 0, -4.2], -1.2, 'Run'));\n      this.figures.push(new Figure(ctx, 'extra', [-2.8, 0, -7.4], 1.4, 'Walk'));\n    }\n  }\n\n  beat() { return this.scene.beats[this.i]; }\n  next() {\n    this.i++;\n    if (this.i >= this.scene.beats.length) { this.finish(); return; }\n    const b = this.beat();\n    if (b.set && b.set !== this.setId) { this.swapSet(b.set); }\n    this.startBeat(b);\n  }\n  async swapSet(id) {\n    this.busy = true;\n    const ctx = this.ctx;\n    await ctx.engine.screen.cover('fade', { duration: 0.2 });\n    this.set.dispose();\n    ctx.scene.remove(this.set.group);\n    this.setId = id;\n    this.set = new SetView(ctx, id);\n    this.makeKey(ctx);\n    this.placeFigures(ctx);\n    this.busy = false;\n    await ctx.engine.screen.reveal('fade', { duration: 0.2 });\n  }\n  startBeat(b) {\n    this.text = (b.say ?? b.narr ?? '').replace(/\\*/g, '');\n    this.rich = b.say ?? b.narr ?? '';\n    this.chars = 0;\n    this.acc = 0;\n    this.pause = 0;\n    this.wrapped = null;\n    this.camMode = b.cam ?? (b.narr ? 'wide' : b.who ? 'close' : this.camMode);\n    if (b.cam === 'wide' || b.narr) {\n      const w = this.set.wide;\n      const dx = w.position[0], dz = w.position[2];\n      this.tl = new Timeline({ shots: [{ at: 0, position: w.position, target: w.target, fov: w.fov, cut: true }, { at: 7, position: [dx * 0.86, w.position[1] - 0.25, dz * 0.82], target: w.target, fov: w.fov }], bars: 0 });\n      this.tl.play();\n    } else this.tl = null;\n    if (b.who) {\n      const bust = this.ensureBust(b.who);\n      bust.setEmotion(b.emo ?? 'neutral');\n      for (const other of Object.values(this.busts)) if (other !== bust) other.setFocus(false);\n      bust.setFocus(true);\n      this.current = bust;\n    } else this.current = null;\n    if (b.mark) { this.mark = b.mark; this.markT = 0.55; App.sfx('reaction'); }\n    if (b.cue) this.cue(b.cue);\n  }\n  ensureBust(who) {\n    if (!this.busts[who]) {\n      const rig = new BustRig(this.ctx, who);\n      this.ctx.scene.add(rig.object);\n      this.busts[who] = rig;\n    }\n    const rig = this.busts[who];\n    if (this.slots.L !== who && this.slots.R !== who) {\n      // The slot whose occupant spoke longest ago gives way.\n      const free = !this.slots.L ? 'L' : !this.slots.R ? 'R' : this.lastSlot === 'L' ? 'R' : 'L';\n      const old = this.slots[free];\n      if (old && this.busts[old]) this.busts[old].object.visible = false;\n      this.slots[free] = who;\n      rig.object.visible = true;\n      rig.object.position.x = SLOTS[free];\n      rig.object.rotation.y = free === 'L' ? 0.2 : -0.2;\n      rig.popT = 0.25;\n    }\n    this.lastSlot = this.slots.L === who ? 'L' : 'R';\n    return rig;\n  }\n  cue(c) {\n    const ctx = this.ctx;\n    switch (c) {\n      case 'thunder': App.sfx('thunder'); App.flash('white', { duration: 0.25, strength: 0.5 }); App.shake(0.2); break;\n      case 'horn': App.sfx('horn'); break;\n      case 'bell': App.sfx('bell'); break;\n      case 'door': App.sfx('click', { pitch: -9 }); App.sfx('whoosh', { pitch: -3 }); break;\n      case 'reaction': App.sfx('stamp', { volume: 0.5 }); App.shake(0.2); break;\n      case 'tremor': App.shake(0.1); break;\n      case 'collapse': App.sfx('stamp'); App.shake(0.7); App.sfx('flatline', { volume: 0.4 }); break;\n      case 'breach': App.sfx('sobWave'); App.flash('lime', { duration: 0.3, strength: 0.5 }); App.shake(0.8); if (this.set.canister) this.set.canister.rotation.z = 1.3; break;\n      case 'hiss': App.sfx('gelLoop'); App.sfx('whoosh'); ctx.particles.burst('foam', [1.6, 1, -3.6], { count: 24, colors: ['lime', 'white'], speed: 2 }); break;\n      case 'fall': App.sfx('stamp', { volume: 0.7 }); break;\n      case 'wheel': App.sfx('tick'); App.sfx('tick', { pitch: 3 }); break;\n      default: break;\n    }\n  }\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    this.o.onDone?.();\n  }\n  showCursor() { return App.devices.last === 'kbm'; }\n\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figures) f.update(dt);\n    for (const r of Object.values(this.busts)) if (r.object.visible) {\n      r.update(dt);\n      if (r.popT > 0) { r.popT -= dt; r.object.position.y = -Math.max(0, r.popT) * 3; } else r.object.position.y = 0;\n    }\n    const closeUp = this.camMode === 'close';\n    for (const r of Object.values(this.busts)) if (r.object.visible !== undefined) r.object.parent && (r.group = r.object.parent);\n    for (const who of [this.slots.L, this.slots.R]) if (who && this.busts[who]) this.busts[who].object.visible = closeUp;\n    const cam = ctx.camera.camera;\n    if (this.tl) {\n      this.tl.update(dt);\n      const s = this.tl.camera();\n      if (s) {\n        cam.position.set(...s.position);\n        cam.fov = s.fov;\n        cam.updateProjectionMatrix();\n        cam.lookAt(...s.target);\n      }\n    } else {\n      const c = this.set.close;\n      const sw = Math.sin(this.t * 0.4) * 0.03;\n      cam.position.set(c.position[0] + sw, c.position[1], c.position[2]);\n      if (cam.fov !== c.fov) { cam.fov = c.fov; cam.updateProjectionMatrix(); }\n      cam.lookAt(c.target[0], c.target[1], c.target[2]);\n    }\n    // Room sounds under the talk.\n    this.ambT -= dt;\n    if (this.ambT <= 0) {\n      this.ambT = 9 + Math.random() * 10;\n      App.sfx(Math.random() < 0.5 ? 'bell' : 'horn', { volume: 0.5 });\n    }\n    if (overlay || this.busy) return;\n    // Typewriter.\n    const b = this.beat();\n    if (!b) return;\n    if (this.chars < this.text.length) {\n      const rate = 34 * (App.save.settings.textSpeed ?? 1) * (b.narr ? 1.3 : 1);\n      if (this.pause > 0) this.pause -= dt * rate;\n      else {\n        this.acc += dt * rate;\n        while (this.acc >= 1 && this.chars < this.text.length && this.pause <= 0) {\n          this.acc -= 1;\n          const i = this.chars++;\n          if (b.who && App.voiceChar(b.who, this.text, i)) this.current?.syllable();\n          this.pause = pauseAfter(this.text[i], this.text, i);\n        }\n      }\n    }\n    if (this.o.auto) { this.autoT += dt; if (this.autoT > 2.2 && this.chars >= this.text.length) { this.autoT = 0; this.next(); } return; }\n    const d = App.devices;\n    const nav = d.nav;\n    const advance = nav.confirm || d.click;\n    if (advance) {\n      if (this.chars < this.text.length) { this.chars = this.text.length; } else { App.sfx('uiMove'); this.next(); }\n      return;\n    }\n    // Pause, and hold to skip.\n    const holdSkip = ctx.input.isDown('Escape') || d.pads.some((p) => p.down[3]);\n    if (holdSkip) {\n      this.skipHold += dt;\n      if (this.skipHold >= 0.8) { this.skipHold = 0; this.finish(); }\n    } else this.skipHold = 0;\n    if (d.pads.some((p) => p.edge[9] && !p.down[8])) this.openPause();\n    this.markT = Math.max(0, this.markT - dt);\n  }\n  openPause() {\n    import('../ui/overlays.js').then((m) => { if (!App.overlays.length) App.overlays.push(new m.PauseOverlay(this)); });\n  }\n  draw(ctx, ui) {\n    const b = this.beat();\n    if (!b || this.done) return;\n    const w = ui.w, h = ui.h;\n    const boxH = 58;\n    const y = h - boxH - 5;\n    ui.rect(8 + 2, y + 2, w - 16, boxH, 'ink');\n    ui.rect(8, y, w - 16, boxH, 'night');\n    ui.outline(8, y, w - 16, boxH, b.narr ? 'slate' : 'mist');\n    const tx = 20, tw = w - 40;\n    if (!this.wrapped) this.wrapped = ui.wrap(this.rich, tw, 1);\n    if (b.who) {\n      const name = SPEAKER_NAMES[b.who] ?? b.who.toUpperCase();\n      const nw = ui.hud.measure(name, 1).width + 12;\n      ui.rect(tx - 4, y - 6, nw, 13, 'navy');\n      ui.outline(tx - 4, y - 6, nw, 13, 'sand');\n      ui.text(tx + 2, y - 3, name, { color: 'sand', shadow: false });\n    }\n    let left = this.chars;\n    this.wrapped.slice(0, 4).forEach((line, i) => {\n      ui.rich(tx, y + 11 + i * 11, line, { chars: left, hi: 'orange', color: b.narr ? 'mist' : 'white' });\n      left -= line.replace(/\\*/g, '').length + 1;\n    });\n    if (this.chars >= this.text.length && Math.sin(this.t * 6) > -0.3) ui.action(w - 28, y + boxH - 13, 'confirm');\n    // Reaction marks and speed lines.\n    if (this.markT > 0 && this.current && b.mark) {\n      const speakerX = this.slots.L === b.who ? 0.28 : 0.72;\n      const sx = w * speakerX + 54, sy = h * 0.12;\n      if (b.mark === '!') {\n        ui.text(sx, sy, '!', { color: 'white', scale: 5, shadow: 'ink' });\n        for (let i = 0; i < 14; i++) {\n          const a = (i / 14) * 6.283 + this.t;\n          const r0 = 150 + (i % 3) * 30, r1 = r0 + 26;\n          for (let k = 0; k < 6; k++) { const q = r0 + ((r1 - r0) * k) / 5; ui.rect(w / 2 + Math.cos(a) * q * 1.3, h * 0.4 + Math.sin(a) * q * 0.7, 2, 2, 'white'); }\n        }\n      } else if (b.mark === '?') ui.text(sx, sy, '?', { color: 'sand', scale: 5, shadow: 'ink' });\n      else if (b.mark === '...') ui.text(sx - 8, sy + 8, '...', { color: 'white', scale: 3, shadow: 'ink' });\n      else if (b.mark === 'sweat') ui.text(sx, sy + 4, '!?', { color: 'cyan', scale: 3, shadow: 'ink' });\n    }\n    if (this.skipHold > 0) {\n      ui.text(w - 70, 6, 'SKIPPING', { color: 'white' });\n      ui.rect(w - 70, 15, 60 * (this.skipHold / 0.8), 3, 'sand');\n    } else if (!this.o.auto) ui.hints([['skip', 'HOLD TO SKIP']], 5);\n    if (this.o.attractLabel) this.o.attractLabel(ui);\n  }\n  status() { return `story ${this.scene.id} beat=${this.i}/${this.scene.beats.length}`; }\n  dispose() { this.rain?.stop(); this.key?.release(); }\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// The briefing: a clipboard chart over the theatre. Patient name, age, job, hook, the op's title\n// stamped, and the one-line objective. Then the camera dives down onto the field.\nimport { App } from '../app.js';\nimport { DIFFICULTIES } from '../core/config.js';\nimport { OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\nimport { toTitle } from './flow.js';\n\nexport class BriefingStage extends Stage {\n  name = 'briefing';\n  constructor(o) { super(); this.o = o; this.def = OPS[o.opId]; this.slide = 0; this.dive = 0; this.seats = o.seats; }\n  cameraConfig = { preset: 'fixed', position: [5.2, 3.6, 5.2], target: [0, 1.2, -2.8], fov: 38, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.03;\n    this.figs = [new Figure(ctx, this.def.surgeon === 'sabine' ? 'sabine' : 'ilya', [-1.9, 0, -2.2], 1.1), new Figure(ctx, 'reyes', [1.9, 0, -2.3], -1), new Figure(ctx, 'pem', [-3, 0, -3.8], 0.8, 'Sit')];\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play(this.def.music && this.def.music !== 'silence' ? 'title' : 'title');\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs) f.update(dt);\n    this.slide = Math.min(1, this.slide + dt * 3);\n    const cam = ctx.camera.camera;\n    if (this.dive > 0) {\n      this.dive += dt / 1.1;\n      const k = Math.min(1, this.dive);\n      const e = k * k * (3 - 2 * k);\n      cam.position.set(5.2 * (1 - e), 3.6 + e * 0.8, 5.2 + (-3 + 1.4 - 5.2) * e);\n      cam.fov = 38 + e * 12;\n      cam.updateProjectionMatrix();\n      cam.lookAt(0, 1.1 * e + 1.2 * (1 - e), -3 * e + -2.8 * (1 - e));\n      if (k >= 1 && !this.left) { this.left = true; this.launch(); }\n      return;\n    }\n    cam.position.set(5.2 + Math.sin(this.t * 0.2) * 0.2, 3.6, 5.2);\n    cam.lookAt(0, 1.2, -2.8);\n    if (overlay) return;\n    const d = App.devices;\n    if (d.nav.confirm || d.click) { App.sfx('uiConfirm'); App.sfx('whoosh'); this.dive = 0.001; }\n    else if (d.nav.back || d.rightClick) {\n      if (this.o.onBack) this.o.onBack(); else toTitle();\n    }\n  }\n  launch() {\n    App.goto(new OperationStage({ opId: this.o.opId, mode: this.o.mode, difficulty: this.o.difficulty, seats: this.o.seats, startStage: this.o.startStage }), { kind: 'iris', duration: 0.28, camera: OP_CAMERA });\n  }\n  draw(ctx, ui) {\n    if (this.dive > 0) return;\n    const p = this.def.patient;\n    const w = ui.w, h = ui.h;\n    const cw = Math.min(330, w - 30), ch = Math.min(210, h - 40);\n    const x = (w - cw) / 2, y = (h - ch) / 2 + (1 - this.slide) * h - 4;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    const tx = x + 14;\n    ui.text(tx, y + 13, this.def.num ? `OPERATION ${this.def.num}` : 'CONSULT', { color: 0x7a6a4a, shadow: false });\n    ui.text(tx, y + 25, p.name, { color: ink, scale: 2, shadow: false });\n    ui.text(tx, y + 45, `AGE ${p.age}   ${p.job}`, { color: ink, shadow: false });\n    ui.rect(tx, y + 56, cw - 28, 1, 0xa89a78);\n    const hookLines = ui.wrap(p.hook, cw - 30);\n    hookLines.slice(0, 3).forEach((l, i) => ui.text(tx, y + 62 + i * 10, l, { color: ink, shadow: false }));\n    ui.rect(tx, y + 96, cw - 28, 1, 0xa89a78);\n    const obj = ui.wrap(p.objective, cw - 30);\n    obj.slice(0, 2).forEach((l, i) => ui.rich(tx, y + 102 + i * 10, l, { color: 0x8a1f38, shadow: false, hi: 0x8a1f38 }));\n    const ttl = this.def.title;\n    const ts = ui.hud.measure(ttl, 2).width > cw - 30 ? 1 : 2;\n    ui.stamp(x + cw / 2, y + ch - 60, ttl, 0xb13e53, ts);\n    const best = App.save.log[this.def.id];\n    if (best) ui.text(tx, y + ch - 30, `BEST: ${best.rank}${best.pristine ? '  PRISTINE' : ''}`, { color: ink, shadow: false });\n    ui.text(tx, y + ch - 19, DIFFICULTIES[this.o.difficulty ?? 'resident'].label, { color: 0x7a6a4a, shadow: false });\n    const label = 'SCRUB IN';\n    const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + 4;\n    const lx = x + cw - lw - 12;\n    ui.action(lx, y + ch - 19, 'confirm');\n    ui.text(lx + ui.actionWidth('confirm') + 4, y + ch - 18, label, { color: ink, shadow: false });\n  }\n  status() { return `briefing ${this.def.id}`; }\n}\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally one at a time with ticks, the rank stamp slams, Reyes comments,\n// then the patient's follow-up line. Also the shift report at the very end.\nimport { App } from '../app.js';\nimport { OPS, CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { recordOp, goCampaign, toTitle } from './flow.js';\nimport { finalTally } from '../sim/scoring.js';\nimport { BustRig } from '../view/bust.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nconst RANK_COLOR = { S: 0xf4c430, A: 0x38b764, B: 0x3b5dc9, C: 0xb13e53 };\nconst COMMENTS = {\n  reyes: {\n    S: ['...Adequate. I will deny having said so.', \"That was correct. Don't let it go to your head. It's not attached to anything useful.\"],\n    A: ['Competent. Write that down. You will not hear it twice.', 'Hm. You may finish your coffee.'],\n    B: ['The patient lived. That is the job. Barely.', 'Passable. Passable is a word for gravy, Doctor.'],\n    C: [\"They'll keep breathing. Do better.\", 'I have seen sharper work from the vending machine.'],\n  },\n  sabine: {\n    S: ['No notes.', 'I have reviewed the report. It is short. That is praise.'],\n    A: ['Adequate.', 'You may tell people I said so. They will not believe you.'],\n    B: ['Acceptable, in the sense that nobody is suing.', 'You have two options. Improve is one.'],\n    C: ['They lived. I do not know why. Neither do you.', 'I will be writing this one down.'],\n  },\n};\nconst OP1_C = \"He'll keep the arm. Do better.\";\n\nexport class ResultsStage extends Stage {\n  name = 'results';\n  constructor(o) {\n    super();\n    this.o = o;\n    this.def = OPS[o.opId];\n    this.tally = finalTally(o.sim);\n    this.lineI = -1;\n    this.lineT = 0;\n    this.shown = 0;\n    this.slide = 0;\n    this.stampT = -1;\n    this.phase = 0;\n    this.chars = 0;\n    this.commentChars = 0;\n    this.followChars = 0;\n    this.pristineT = -1;\n    recordOp(o.opId, this.tally, o.mode);\n    this.lines = [\n      ['TIME LEFT', this.tally.time], ['VITALS', this.tally.vitals], ['TECHNIQUE', this.tally.technique],\n      ['BEST STREAK', `x${this.tally.bestStreak}`], ['MISTAKES', this.tally.mistakes],\n    ];\n    if (this.tally.penalty) this.lines.push(['SECOND LOOKS', -this.tally.penalty]);\n    this.lines.push(['TOTAL', this.tally.total]);\n    const pool = COMMENTS[this.def.id === 'op9' || this.def.surgeon === 'sabine' ? 'sabine' : 'reyes'][this.tally.rank];\n    this.comment = o.opId === 'op1' && this.tally.rank === 'C' ? OP1_C : pool[o.sim.tick % pool.length];\n    this.commenter = this.def.id === 'op9' || this.def.surgeon === 'sabine' ? 'sabine' : 'reyes';\n    this.follow = this.def.patient.followUp[this.tally.rank];\n    this.seatRows = o.sim.seats.filter((s) => !s.bot).length > 1 ? o.sim.seats.filter((s) => !s.bot) : null;\n  }\n  cameraConfig = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.02;\n    this.bust = new BustRig(ctx, this.commenter);\n    this.bust.object.position.set(1.62, 0, 0.2);\n    this.bust.object.rotation.y = -0.3;\n    ctx.scene.add(this.bust.object);\n    this.key = ctx.lights.request({ position: [1, 3, 3.4], color: 0xfff0e0, intensity: 7, radius: 8, priority: 8 });\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play(this.tally.rank === 'C' ? 'results-sad' : 'results-win', { now: true });\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    this.bust.update(dt);\n    const cam = ctx.camera.camera;\n    cam.position.set(0.2, 1.75, 5.1);\n    cam.lookAt(0, 1.42, 0);\n    this.slide = Math.min(1, this.slide + dt * 2.6);\n    if (this.slide < 1) return;\n    if (this.phase === 0) {\n      this.lineT += dt;\n      if (this.lineT >= 0.34) {\n        this.lineT = 0;\n        this.shown++;\n        App.sfx('tally', { pitch: this.shown });\n        if (this.shown >= this.lines.length) { this.phase = 1; this.stampT = 0.3; }\n      }\n    } else if (this.phase === 1) {\n      this.stampT -= dt;\n      if (this.stampT <= 0) {\n        this.phase = 2;\n        this.slam = 1;\n        App.sfx('stamp');\n        App.shake(0.8);\n        App.rumble({ strong: 1, weak: 0.6, ms: 250 });\n        ctx.engine.hitstop(0.08);\n        this.bust.setEmotion(this.tally.rank === 'C' ? 'stern' : this.tally.rank === 'S' ? 'smile' : 'neutral');\n        if (this.tally.pristine) { this.pristineT = 0.5; }\n      }\n    } else if (this.phase === 2) {\n      this.commentChars += dt * 34;\n      const i = Math.floor(this.commentChars);\n      if (i !== this.lastSyl && i < this.comment.length) { this.lastSyl = i; if (App.voiceChar(this.commenter, this.comment, i)) this.bust.syllable(); }\n      if (this.commentChars >= this.comment.length + 24) this.phase = 3;\n    } else if (this.phase === 3) {\n      this.followChars += dt * 30;\n    }\n    if (this.pristineT > 0) { this.pristineT -= dt; if (this.pristineT <= 0) { App.sfx('stamp', { pitch: 7 }); App.flash('sand', { duration: 0.2, strength: 0.5 }); this.pristineShown = true; } }\n    this.slam = Math.max(0, (this.slam ?? 0) - dt * 4);\n    if (overlay) return;\n    const d = App.devices;\n    if (d.nav.confirm || d.click) {\n      if (this.phase < 3) {\n        this.shown = this.lines.length;\n        if (this.phase < 2) { this.phase = 1; this.stampT = 0; }\n        else { this.commentChars = this.comment.length + 30; this.phase = 3; this.followChars = 999; }\n        return;\n      }\n      if (this.followChars < this.follow.length) { this.followChars = 999; return; }\n      App.sfx('uiConfirm');\n      this.leave();\n    }\n  }\n  async leave() {\n    if (this.leaving) return;\n    this.leaving = true;\n    if (this.o.mode === 'story') return goCampaign();\n    if (this.o.mode === 'consult') {\n      const { ConsultStage } = await import('./consult.js');\n      return App.goto(new ConsultStage());\n    }\n    if (this.o.mode === 'replay' && this.o.fromLog) {\n      const { LogStage } = await import('./log.js');\n      return App.goto(new LogStage(this.o.opId));\n    }\n    return toTitle();\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    const cw = Math.min(250, w * 0.56), ch = Math.min(190, h - 62);\n    const x = 14, y = 16 + (1 - this.slide) * -h;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    ui.text(x + 10, y + 12, this.def.title, { color: ink, shadow: false });\n    ui.text(x + 10, y + 22, this.def.patient.name, { color: 0x7a6a4a, shadow: false });\n    ui.rect(x + 10, y + 32, cw - 20, 1, 0xa89a78);\n    if (this.seatRows) {\n      this.seatRows.forEach((s, i) => {\n        const yy = y + 38 + i * 12;\n        ui.rect(x + 10, yy, 8, 8, ['red', 'sky', 'lime', 'sand'][i % 4]);\n        ui.text(x + 22, yy, s.name ?? `SEAT ${i + 1}`, { color: ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(Math.round(s.score)), { color: ink, shadow: false });\n      });\n      this.lines.slice(0, this.shown).forEach((l, i) => {\n        if (i < 4 && l[0] !== 'TOTAL') return;\n        const yy = y + 38 + this.seatRows.length * 12 + 4;\n        ui.text(x + 10, yy, 'TOTAL', { color: ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(l[1]), { color: ink, shadow: false });\n      });\n    } else {\n      this.lines.slice(0, this.shown).forEach((l, i) => {\n        const yy = y + 38 + i * 12;\n        const isT = l[0] === 'TOTAL';\n        ui.text(x + 10, yy, l[0], { color: isT ? 0x8a1f38 : ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(l[1]), { color: isT ? 0x8a1f38 : ink, shadow: false });\n      });\n    }\n    if (this.phase >= 2) {\n      const scale = 7 + Math.round((this.slam ?? 0) * 6);\n      ui.stamp(x + cw - 34, y + ch - 30, this.tally.rank, RANK_COLOR[this.tally.rank], Math.min(8, scale));\n      if (this.pristineShown) ui.stamp(x + 56, y + ch - 20, 'PRISTINE', 0xc99a1a, 1);\n    }\n    // The comment, the follow-up.\n    const by = h - 58;\n    if (this.phase >= 2) {\n      ui.rect(8, by, w - 16, 52, 'night');\n      ui.outline(8, by, w - 16, 52, 'mist');\n      const nm = this.commenter === 'sabine' ? 'DR. ACHTERBERG' : 'NURSE REYES';\n      ui.text(16, by + 4, nm, { color: 'sand', shadow: false });\n      ui.text(16, by + 15, this.comment.slice(0, Math.floor(this.commentChars)), { color: 'white', shadow: false });\n      if (this.phase >= 3) {\n        const lines = ui.wrap(this.follow, w - 36);\n        let left = Math.floor(this.followChars);\n        lines.slice(0, 2).forEach((l, i) => { ui.text(16, by + 28 + i * 10, l.slice(0, Math.max(0, left)), { color: 'mist', shadow: false }); left -= l.length + 1; });\n        if (Math.sin(this.t * 5) > -0.2) ui.action(w - 26, by + 40, 'confirm');\n      }\n    }\n  }\n  showCursor() { return App.devices.last === 'kbm'; }\n  status() { return `results ${this.def.id} rank=${this.tally.rank} total=${this.tally.total}`; }\n  dispose() { this.key?.release(); }\n}\n\n/** The end of the shift: every rank, a stamp each, then credits and back to title. */\nexport class ShiftReportStage extends Stage {\n  name = 'shiftreport';\n  cameraConfig = { preset: 'fixed', position: [4.5, 3.6, 5.8], target: [0, 1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'morning');\n    this.page = 0;\n    this.creditT = 0;\n    App.director.play('credits', { now: true });\n    applyLook(ctx.engine, App.save.settings);\n    if (App.save.progress) { App.save.progress.finished = true; App.persist(); }\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    const cam = ctx.camera.camera;\n    cam.position.set(4.5 + Math.sin(this.t * 0.1), 3.6, 5.8);\n    cam.lookAt(0, 1, -3);\n    if (overlay) return;\n    const d = App.devices;\n    if (this.page === 1) this.creditT += dt * 12;\n    if (d.nav.confirm || d.click) {\n      App.sfx('uiConfirm');\n      if (this.page === 0) this.page = 1;\n      else toTitle();\n    }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    if (this.page === 0) {\n      const cw = Math.min(340, w - 30), ch = Math.min(226, h - 24);\n      const x = (w - cw) / 2, y = (h - ch) / 2 + 2;\n      ui.clipboard(x, y, cw, ch);\n      const ink = 0x28203a;\n      ui.text(x + 12, y + 12, 'SHIFT REPORT', { color: ink, scale: 2, shadow: false });\n      ui.text(x + 12, y + 32, 'DR. I. MARSH. VERITY GENERAL. SIGNED OFF.', { color: 0x7a6a4a, shadow: false });\n      CAMPAIGN_OPS.forEach((o, i) => {\n        const yy = y + 45 + i * 15;\n        const r = App.save.log[o.id];\n        ui.text(x + 12, yy, `${o.num}`.padStart(2, ' '), { color: 0x7a6a4a, shadow: false });\n        ui.text(x + 30, yy, o.title, { color: ink, shadow: false });\n        if (r) {\n          ui.stamp(x + cw - 24, yy + 3, r.rank, RANK_COLOR[r.rank], 1);\n          if (r.pristine) ui.text(x + cw - 84, yy, 'PRISTINE', { color: 0xc99a1a, shadow: false });\n        }\n      });\n      ui.action(x + cw - 20, y + ch - 13, 'confirm');\n    } else {\n      const lines = ['THE RAIN STOPPED.', '', 'THE TRUTH, STAT.', '', '', 'A GAME WRITTEN IN CODE, ALL OF IT.', '', 'ART, MUSIC, VOICES: CODE.', 'ENGINE: PIXEL ENGINE (MIT).', 'THREE.JS (MIT). RAPIER (APACHE-2.0).', 'FURNITURE KIT BY KENNEY (CC0).', '', '', 'NO ONE SHOULD HURT, HE SAID, ONCE.', 'NOW HE TELLS THEM: IT IS INFORMATION.', '', '', 'OPERATING LOG UNLOCKED.', '', 'YOU HAVE A SEVEN A.M.'];\n      lines.forEach((l, i) => {\n        const y = h + i * 14 - this.creditT;\n        if (y > -10 && y < h) ui.center(y, l, { color: 'white', shadow: 'ink' });\n      });\n      ui.hints([['confirm', 'TITLE']], h - 12);\n    }\n  }\n  status() { return 'shift report'; }\n}\nEOF\ncat > src/stages/title.js <<'EOF'\n// Title and main menu: a dark operating theatre with one swinging lamp. An EKG line draws itself through\n// the title. Ten idle seconds start the attract reel.\nimport { App } from '../app.js';\nimport { SUBTITLE, TITLE } from '../core/meta.js';\nimport { UI } from '../ui/hud.js';\nimport { Menu } from '../ui/menu.js';\nimport { applyLook } from '../view/looks.js';\nimport { Figure } from '../view/figure.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nexport const TITLE_CAM = { preset: 'fixed', position: [5.4, 3.3, 6.2], target: [0, 1.5, -3], fov: 38, minZoom: 1, maxZoom: 1 };\n\nexport class TitleStage extends Stage {\n  name = 'title';\n  attractable = true;\n  cameraConfig = TITLE_CAM;\n  constructor(state = 'title') { super(); this.state = state; this.ekgX = 0; this.menuAlpha = 0; this.flick = 0; }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.12;\n    this.figure = new Figure(ctx, 'patient', [-1.2, 1.2, -3], Math.PI / 2, 'LieIdle');\n    this.figure.object.visible = false;\n    applyLook(ctx.engine, App.save.settings, 1, 0.42, 0);\n    App.director.play('title', { now: App.director.current == null });\n    this.rain = ctx.audio.loop('rainLoop', { volume: 0.35 });\n    this.buildMenu();\n    if (App.touchOnly && !App.attractStarted) { App.attractStarted = true; this.startAttract(); }\n  }\n  buildMenu() {\n    const prog = App.save.progress;\n    const items = [\n      { label: 'ON CALL', blurb: prog ? 'THE SHIFT IS WAITING.' : 'A STORM. 3 A.M. THE CHIEF IS UNREACHABLE.', onConfirm: () => this.onCall() },\n      { label: 'OPERATING LOG', disabled: Object.keys(App.save.log).length === 0, blurb: 'REPLAY CLEARED OPERATIONS.', onConfirm: () => this.openLog() },\n      { label: 'CONSULT', blurb: 'A SECOND PAIR OF HANDS. UP TO FOUR, ON ONE TV.', onConfirm: () => this.openConsult() },\n      { label: 'SETTINGS', blurb: 'SOUND, GLYPHS, AIM, LOOK.', onConfirm: () => this.overlay('SettingsOverlay') },\n      { label: 'ABOUT', blurb: 'SOURCE, FEEDBACK, CREDITS.', onConfirm: () => this.overlay('AboutOverlay') },\n    ];\n    this.menu = new Menu(App, items, { w: 150, y: 150, rowH: 15, rows: 5 });\n    this.menu.fixFocus();\n  }\n  async overlay(name, arg) {\n    const m = await import('../ui/overlays.js');\n    App.overlays.push(new m[name](this, arg));\n  }\n  async onCall() {\n    const m = await import('../ui/overlays.js');\n    App.overlays.push(new m.OnCallOverlay(this));\n  }\n  async openLog() {\n    const { LogStage } = await import('./log.js');\n    App.goto(new LogStage());\n  }\n  async openConsult() {\n    const { ConsultStage } = await import('./consult.js');\n    App.goto(new ConsultStage());\n  }\n  async startAttract() {\n    const { startAttractReel } = await import('./attract.js');\n    startAttractReel();\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    this.ekgX += dt * 90;\n    const cam = ctx.camera.camera;\n    const k = this.state === 'main' ? 1 : 0;\n    this.menuAlpha += (k - this.menuAlpha) * Math.min(1, dt * 6);\n    cam.position.set(5.4 + Math.sin(this.t * 0.13) * 0.8 - this.menuAlpha * 0.6, 3.3 + Math.sin(this.t * 0.2) * 0.12, 6.2);\n    cam.lookAt(0, 1.5, -3);\n    if (overlay) return;\n    if (App.touchOnly) return;\n    const d = App.devices;\n    if (this.state === 'title') {\n      if (d.nav.confirm || d.click || d.nav.start || d.pads.some((p) => p.edge[0])) {\n        App.sfx('uiConfirm');\n        this.state = 'main';\n      }\n    } else {\n      this.menu.update(this.ui);\n      if (d.nav.back || d.rightClick) { this.state = 'title'; App.sfx('uiBack'); }\n    }\n  }\n  drawTitle(ui, y) {\n    const w = ui.w;\n    const mid = y + 12;\n    const scale = w < 400 ? 3 : 4;\n    const tw = ui.hud.measure(TITLE, scale).width;\n    const x = (w - tw) / 2;\n    ui.text(x, y, TITLE, { color: 'white', scale, shadow: 'plum' });\n    ui.center(y + 8 * scale + 4, SUBTITLE, { color: 'sand', scale: 2, shadow: 'plum' });\n    // The EKG line drawing itself through the title.\n    const span = w + 90;\n    const head = this.ekgX % span;\n    for (let px = 0; px < w; px++) {\n      if (px > head) break;\n      const age = head - px;\n      if (age > 260) continue;\n      const p = ((px + 60) % 120) / 120;\n      let yy = 0;\n      if (p > 0.4 && p < 0.44) yy = -5;\n      else if (p >= 0.44 && p < 0.47) yy = 16;\n      else if (p >= 0.47 && p < 0.5) yy = -22;\n      else if (p >= 0.5 && p < 0.53) yy = 9;\n      ui.rect(px, mid + yy, 1, 2, age < 30 ? 'white' : age < 130 ? 'red' : 'plum');\n      if (Math.abs(yy) > 4) { for (let q = 0; q < Math.abs(yy); q += 2) ui.rect(px, mid + Math.sign(yy) * q, 1, 2, age < 130 ? 'red' : 'plum'); }\n    }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    this.drawTitle(ui, Math.round(h * (this.state === 'main' ? 0.1 : 0.2)));\n    if (App.touchOnly) return;\n    if (this.state === 'title') {\n      if (Math.sin(this.t * 3.4) > -0.4) {\n        const label = 'PRESS ';\n        const device = ui.device;\n        const list = device === 'pad' ? [['confirm', '']] : [['confirm', ' OR CLICK']];\n        const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + ui.hud.measure(list[0][1], 1).width + 2;\n        let x = (w - lw) / 2;\n        const y = h * 0.72;\n        ui.text(x, y, label);\n        x += ui.hud.measure(label, 1).width;\n        x += ui.action(x, y - 1, 'confirm') + 2;\n        ui.text(x, y, list[0][1]);\n      }\n      ui.center(h - 12, '\"THE TRUTH, STAT.\" - OVER THE DOOR OF OR-7', { color: 'slate' });\n    } else {\n      this.menu.y = Math.round(h * 0.42);\n      this.menu.draw(ui);\n    }\n  }\n  status() { return `title state=${this.state} idle=${App.idle.toFixed(1)}`; }\n  dispose() { this.rain?.stop(); }\n}\nexport { UI };\nEOF\ncat > src/stages/log.js <<'EOF'\n// The Operating Log: one chart at a time, flip with left and right. Replay anything cleared.\nimport { App } from '../app.js';\nimport { CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { BriefingStage } from './briefing.js';\nimport { CLOSE_CAM, toTitle } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\nimport { TITLE_CAM } from './title.js';\n\nexport class LogStage extends Stage {\n  name = 'log';\n  attractable = true;\n  cameraConfig = TITLE_CAM;\n  constructor(opId) {\n    super();\n    this.list = CAMPAIGN_OPS.filter((o) => App.save.log[o.id] || App.unlockAll);\n    this.i = Math.max(0, this.list.findIndex((o) => o.id === opId));\n    this.dir = 0;\n    this.flip = 0;\n  }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings, 1, 0.5, 0);\n    App.director.play('ward');\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    const cam = ctx.camera.camera;\n    cam.position.set(TITLE_CAM.position[0] + Math.sin(this.t * 0.12) * 0.5, TITLE_CAM.position[1], TITLE_CAM.position[2]);\n    cam.lookAt(...TITLE_CAM.target);\n    this.flip = Math.max(0, this.flip - dt * 5);\n    if (overlay) return;\n    const d = App.devices;\n    if (!this.list.length) { if (d.nav.back || d.nav.confirm) toTitle(); return; }\n    if (d.nav.left) { this.i = (this.i + this.list.length - 1) % this.list.length; this.flip = 1; this.dir = -1; App.sfx('uiMove'); }\n    if (d.nav.right) { this.i = (this.i + 1) % this.list.length; this.flip = 1; this.dir = 1; App.sfx('uiMove'); }\n    const hitL = this.arrowL && this.ui.hit(...this.arrowL), hitR = this.arrowR && this.ui.hit(...this.arrowR);\n    if (d.click && hitL) { this.i = (this.i + this.list.length - 1) % this.list.length; this.flip = 1; App.sfx('uiMove'); return; }\n    if (d.click && hitR) { this.i = (this.i + 1) % this.list.length; this.flip = 1; App.sfx('uiMove'); return; }\n    if (d.nav.confirm || d.click) {\n      const op = this.list[this.i];\n      App.sfx('uiConfirm');\n      App.goto(new BriefingStage({ opId: op.id, mode: 'replay', difficulty: App.save.progress?.difficulty ?? 'resident', onBack: () => App.goto(new LogStage(op.id)) }), { camera: CLOSE_CAM });\n    }\n    if (d.nav.back || d.rightClick) { App.sfx('uiBack'); toTitle(); }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    ui.center(8, 'OPERATING LOG', { color: 'sand', scale: 2 });\n    if (!this.list.length) { ui.center(h / 2, 'NOTHING CLEARED YET.', { color: 'white' }); return; }\n    const op = this.list[this.i];\n    const r = App.save.log[op.id];\n    const cw = Math.min(300, w - 70), ch = 180;\n    const x = (w - cw) / 2 + this.flip * this.dir * 40, y = 32;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    ui.text(x + 12, y + 12, `OPERATION ${op.num}`, { color: 0x7a6a4a, shadow: false });\n    ui.text(x + 12, y + 22, op.title, { color: ink, scale: 2, shadow: false });\n    ui.text(x + 12, y + 44, op.patient.name, { color: ink, shadow: false });\n    ui.text(x + 12, y + 54, op.patient.job, { color: 0x7a6a4a, shadow: false });\n    ui.rect(x + 12, y + 66, cw - 24, 1, 0xa89a78);\n    const rank = r?.rank ?? 'C';\n    const lines = ui.wrap(op.patient.followUp[rank], cw - 26);\n    lines.slice(0, 4).forEach((l, i) => ui.text(x + 12, y + 74 + i * 10, l, { color: ink, shadow: false }));\n    if (r) {\n      ui.text(x + 12, y + ch - 30, `BEST SCORE ${r.total}`, { color: ink, shadow: false });\n      ui.stamp(x + cw - 34, y + ch - 32, r.rank, { S: 0xf4c430, A: 0x38b764, B: 0x3b5dc9, C: 0xb13e53 }[r.rank], 4);\n      if (r.pristine) ui.text(x + 12, y + ch - 19, 'PRISTINE', { color: 0xc99a1a, shadow: false });\n    }\n    this.arrowL = [x - 30, y + ch / 2 - 15, 24, 30];\n    this.arrowR = [x + cw + 6, y + ch / 2 - 15, 24, 30];\n    ui.text(x - 22, y + ch / 2 - 8, '<', { color: 'sand', scale: 2 });\n    ui.text(x + cw + 12, y + ch / 2 - 8, '>', { color: 'sand', scale: 2 });\n    ui.center(y + ch + 7, `${this.i + 1} / ${this.list.length}`, { color: 'mist' });\n    ui.hints([['confirm', 'OPERATE'], ['back', 'BACK']], h - 12);\n  }\n  status() { return `log ${this.list[this.i]?.id}`; }\n}\nexport { OperationStage, OP_CAMERA };\nEOF\ncat > src/stages/consult.js <<'EOF'\n// Consult on one TV: up to four seats, keyboard and mouse plus pads. Press to scrub in, back out to\n// leave, and seat one starts. Never touches the network outside a session.\nimport { App } from '../app.js';\nimport { CAMPAIGN_OPS, OPS, SESSION_OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { toTitle, CLOSE_CAM } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\n\nconst COLORS = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700];\nconst SPOTS = [[-1.9, 0, -2.2, 0.9], [1.9, 0, -2.2, -0.9], [-1.6, 0, -4, 0.6], [1.6, 0, -4, -0.6]];\n\nexport class ConsultStage extends Stage {\n  name = 'consult';\n  attractable = true;\n  cameraConfig = { preset: 'fixed', position: [0, 3.6, 3.8], target: [0, 1.1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  constructor() {\n    super();\n    this.seats = [];\n    this.opI = 0;\n    this.figs = [];\n  }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play('or-calm');\n    // Pile-Up, or any cleared op except the triage and the finale.\n    this.ops = [OPS.pileup, ...SESSION_OPS.filter((o) => o.id !== 'pileup'), ...CAMPAIGN_OPS.filter((o) => (App.save.log[o.id] || App.unlockAll) && o.id !== 'op3' && o.id !== 'op9')];\n  }\n  refreshFigures(ctx) {\n    for (const f of this.figs) ctx.scene.remove(f.object);\n    this.figs = this.seats.map((s, i) => {\n      const f = new Figure(ctx, 'extra', SPOTS[i].slice(0, 3), SPOTS[i][3]);\n      const color = COLORS[i];\n      f.object.traverse((m) => { if (m.isMesh) { m.material = m.material.clone(); m.material.userData = { ...m.material.userData, shared: false }; } });\n      f.object.traverse((m) => { if (m.isMesh && m.name?.startsWith?.('scrub')) m.material.color.setHex(color); });\n      return f;\n    });\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs) f.update(dt);\n    if (overlay) return;\n    const d = App.devices;\n    const has = (b) => this.seats.findIndex((s) => s.binding === b);\n    // Scrub in.\n    const kbmIn = d.click || ctx.input.wasPressed('Enter') || ctx.input.wasPressed('Space');\n    const kbmOut = d.rightClick || ctx.input.wasPressed('Escape');\n    const joins = [];\n    if (kbmIn) joins.push('kbm');\n    d.pads.forEach((p, i) => { if (p.connected && p.edge[0]) joins.push(i); });\n    for (const b of joins) {\n      const at = has(b);\n      if (at === 0) {\n        // Seat one, again: start.\n        this.start();\n        return;\n      }\n      if (at < 0 && this.seats.length < 4) {\n        this.seats.push({ binding: b });\n        App.sfx('uiConfirm');\n        App.rumble({ strong: 0.3, weak: 0.3, ms: 120 }, typeof b === 'number' ? b : undefined);\n        this.refreshFigures(ctx);\n      }\n    }\n    // Leave.\n    const leaves = [];\n    if (kbmOut) leaves.push('kbm');\n    d.pads.forEach((p, i) => { if (p.connected && p.edge[1]) leaves.push(i); });\n    for (const b of leaves) {\n      const at = has(b);\n      if (at >= 0) { this.seats.splice(at, 1); App.sfx('uiBack'); this.refreshFigures(ctx); } else if (this.seats.length === 0) { toTitle(); return; }\n    }\n    if (d.nav.left) { this.opI = (this.opI + this.ops.length - 1) % this.ops.length; App.sfx('uiMove'); }\n    if (d.nav.right) { this.opI = (this.opI + 1) % this.ops.length; App.sfx('uiMove'); }\n    // Seat one may pick with tabs too.\n    if (d.nav.tabL) { this.opI = (this.opI + this.ops.length - 1) % this.ops.length; App.sfx('uiMove'); }\n    if (d.nav.tabR) { this.opI = (this.opI + 1) % this.ops.length; App.sfx('uiMove'); }\n  }\n  start() {\n    if (!this.seats.length) return;\n    App.sfx('uiConfirm');\n    const op = this.ops[this.opI];\n    App.goto(new OperationStage({ opId: op.id, mode: 'consult', difficulty: 'resident', seats: this.seats.map((s) => ({ binding: s.binding })), seed: Math.floor(Math.random() * 1e9) }), { kind: 'iris', camera: OP_CAMERA });\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    ui.center(8, 'CONSULT', { color: 'sand', scale: 3 });\n    ui.center(36, 'A SECOND PAIR OF HANDS', { color: 'mist' });\n    const cw = Math.min(100, (w - 30) / 4), gap = 6, total = cw * 4 + gap * 3;\n    const x0 = (w - total) / 2, y = 55;\n    for (let i = 0; i < 4; i++) {\n      const s = this.seats[i];\n      const x = x0 + i * (cw + gap);\n      ui.rect(x, y, cw, 70, s ? 'night' : 'ink');\n      ui.outline(x, y, cw, 70, s ? COLORS[i] : 'slate', s ? 2 : 1);\n      ui.text(x + 6, y + 6, `SEAT ${i + 1}`, { color: s ? COLORS[i] : 'slate', shadow: false });\n      if (s) {\n        ui.text(x + 6, y + 20, s.binding === 'kbm' ? 'KEYS+MOUSE' : `PAD ${s.binding + 1}`, { color: 'white', shadow: false });\n        ui.text(x + 6, y + 32, i % 2 === 0 ? 'THE QUIET' : 'SECOND LOOK', { color: 'cyan', shadow: false });\n        ui.text(x + 6, y + 52, 'READY', { color: 'lime', shadow: false });\n      } else {\n        const lw = ui.actionWidth('confirm');\n        ui.action(x + 6, y + 30, 'confirm');\n        ui.text(x + 6 + lw + 3, y + 31, 'SCRUB IN', { color: 'mist', shadow: false });\n      }\n    }\n    const op = this.ops?.[this.opI];\n    if (op) {\n      ui.panel(x0, y + 80, total, 50, 'navy', 'sand');\n      ui.text(x0 + 10, y + 86, op.title, { color: 'sand', scale: 2, shadow: false });\n      ui.text(x0 + 10, y + 106, `${op.patient.name}`, { color: 'white', shadow: false });\n      const obj = ui.wrap(op.patient.objective, total - 20);\n      ui.text(x0 + 10, y + 117, obj[0], { color: 'mist', shadow: false });\n      ui.text(x0 - 16, y + 96, '<', { color: 'sand', scale: 2 });\n      ui.text(x0 + total + 6, y + 96, '>', { color: 'sand', scale: 2 });\n    }\n    if (this.seats.length) {\n      const label = 'SEAT 1: ';\n      const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + ui.hud.measure(' STARTS', 1).width + 2;\n      let x = (w - lw) / 2;\n      const yy = y + 138;\n      ui.text(x, yy, label, { color: COLORS[0] });\n      x += ui.hud.measure(label, 1).width;\n      x += ui.action(x, yy - 1, 'confirm') + 2;\n      ui.text(x, yy, ' STARTS');\n    }\n    ui.hints([['back', this.seats.length ? 'LEAVE' : 'BACK']], h - 12);\n  }\n  status() { return `consult seats=${this.seats.length} op=${this.ops?.[this.opI]?.id}`; }\n}\nexport { CLOSE_CAM };\nEOF\ncat > src/stages/attract.js <<'EOF'\n// Attract mode: a looping reel of real sim segments, played by the bot with cheats. Any input exits at\n// once to Title and is swallowed. It never touches saves or settings.\nimport { App } from '../app.js';\nimport { CLOSE_CAM, toTitle } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { StoryStage } from './story.js';\n\nconst GOD = { god: true, infComposure: true, freezeClock: true, unlimitedMistakes: true };\nexport const REEL = [\n  { kind: 'story', scene: 'ep1', seconds: 18, label: 'A STORM. 3 A.M.' },\n  { kind: 'op', op: 'op1', stage: 1, seconds: 26 },\n  { kind: 'op', op: 'op2', stage: 2, seconds: 24 },\n  { kind: 'op', op: 'op3', stage: 0, seconds: 24 },\n  { kind: 'op', op: 'op4', stage: 1, seconds: 22 },\n  { kind: 'op', op: 'op5', stage: 2, seconds: 28, gift: 'quiet' },\n  { kind: 'op', op: 'op6', stage: 7, seconds: 22, gift: 'look', composure: 100 },\n  { kind: 'op', op: 'op7', stage: 3, seconds: 26, gift: 'quiet' },\n  { kind: 'op', op: 'op8', stage: 2, seconds: 30, gift: 'quiet' },\n  { kind: 'op', op: 'pileup', stage: 0, seconds: 24, seats: 4 },\n];\n\nlet reelIndex = 0;\nlet active = false;\n\nexport function startAttractReel(from = 0) {\n  reelIndex = from;\n  active = true;\n  App.inAttract = true;\n  playSegment();\n}\nfunction drawBanner(ui) {\n  const s = 'DEMO - PRESS ANY BUTTON';\n  const blink = Math.sin(performance.now() / 300) > -0.3;\n  const w = ui.hud.measure(s, 1).width + 12;\n  const x = (ui.w - w) / 2;\n  ui.rect(x, 28, w, 12, 'ink');\n  ui.outline(x, 28, w, 12, 'red');\n  if (blink) ui.text(x + 6, 30, s, { color: 'white', shadow: false });\n}\nfunction exitAttract() {\n  if (!active) return;\n  active = false;\n  App.inAttract = false;\n  App.idle = 0;\n  App.devices.swallow = 0.2;\n  toTitle('title');\n}\nfunction playSegment() {\n  if (!active) return;\n  const seg = REEL[reelIndex % REEL.length];\n  reelIndex = (reelIndex + 1) % REEL.length;\n  const watch = {\n    t: 0,\n    armed: 0,\n    frame(stage, ctx, dt) {\n      this.t += dt;\n      this.armed += dt;\n      // Touch-only devices let it run; anything else ends it.\n      if (!App.touchOnly && this.armed > 0.25 && (App.devices.anyPress || App.devices.mouseMoved || App.devices.last === 'pad' && App.devices.pads.some((p) => p.axes.some((a) => a) || p.down.some(Boolean)))) { exitAttract(); return; }\n      if (this.t >= seg.seconds && !App.loading) playSegment();\n    },\n    next() { if (!App.loading) playSegment(); },\n  };\n  if (seg.kind === 'story') {\n    const st = new StoryStage({ sceneId: seg.scene, auto: true, onDone: () => { if (active) playSegment(); }, attractLabel: (ui) => drawBanner(ui) });\n    const orig = st.frame.bind(st);\n    st.frame = (ctx, dt, ov) => { orig(ctx, dt, ov); watch.frame(st, ctx, dt); };\n    App.goto(st, { kind: 'dissolve', camera: CLOSE_CAM });\n    return;\n  }\n  const seats = Array.from({ length: seg.seats ?? 1 }, (_, i) => ({ bot: { skill: 0.55 + i * 0.1, god: true } }));\n  const stage = new OperationStage({ opId: seg.op, mode: 'attract', difficulty: 'resident', startStage: seg.stage, seed: 4242 + reelIndex, seats, gift: seg.gift, composure: seg.composure ?? 60, cheats: GOD, attract: watch, drawExtra: (s, ctx, ui) => drawBanner(ui) });\n  App.goto(stage, { kind: 'blinds', duration: 0.2, camera: OP_CAMERA });\n}\nexport const attractState = () => ({ active, reelIndex });\nEOF\ncat > src/ui/overlays.js <<'EOF'\n// Screens on top of a stage: On Call, Pause, Failure, Settings, About, Dev Mode. All on the HUD canvas,\n// navigable by pad, keys and mouse.\nimport { App } from '../app.js';\nimport { ABOUT_PAGES } from '../content/about.js';\nimport { OPS } from '../content/ops/index.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { DIFFICULTIES, resetConfig, SLIDERS } from '../core/config.js';\nimport { LOOK_CHOICES } from '../view/looks.js';\nimport { Menu } from './menu.js';\n\nconst pop = () => { App.overlays.pop(); };\nconst dim = (ui) => { for (let y = 0; y < ui.h; y += 2) ui.rect(0, y, ui.w, 1, 'ink'); };\nconst pct = (v) => `${Math.round(v * 100)}%`;\n\nexport class OnCallOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const prog = App.save.progress;\n    const items = [];\n    if (prog && !prog.finished) items.push({ label: 'CONTINUE', blurb: `EPISODE ${Math.min(10, prog.episode + 1)} OF 10. ${DIFFICULTIES[prog.difficulty].label}.`, onConfirm: () => this.cont() });\n    items.push({ label: 'NEW SHIFT', blurb: 'A STORM. 3 A.M. THE CHIEF IS UNREACHABLE.', onConfirm: () => this.pick() });\n    this.menu = new Menu(App, items, { w: 170, y: 110, rows: 3, onBack: pop });\n    this.pickMode = false;\n  }\n  async cont() { pop(); (await import('../stages/flow.js')).goCampaign(); }\n  pick() {\n    this.pickMode = true;\n    const items = Object.values(DIFFICULTIES).map((d) => ({ label: d.label, blurb: d.blurb, onConfirm: () => this.begin(d.id) }));\n    this.menu = new Menu(App, items, { w: 170, y: 110, rows: 3, start: 1, onBack: pop });\n  }\n  async begin(d) { App.newRun(d); App.save.settings.difficulty = d; pop(); (await import('../stages/flow.js')).goCampaign(); }\n  update(ui) { this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 230) / 2, 76, 230, 110);\n    ui.center(84, this.pickMode ? 'DIFFICULTY' : 'ON CALL', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\n\nexport class PauseOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const isOp = !!stage.sim;\n    const items = [{ label: 'RESUME', onConfirm: pop }];\n    if (isOp) {\n      items.push({ label: 'RETRY STAGE', blurb: 'BACK TO THE START OF THIS STAGE. RANK CAPPED AT B.', onConfirm: () => stage.retry() });\n      items.push({ label: 'RESTART', blurb: 'THE WHOLE OPERATION AGAIN.', onConfirm: () => { pop(); stage.restart(); } });\n    }\n    items.push({ label: 'SETTINGS', onConfirm: () => App.overlays.push(new SettingsOverlay(stage)) });\n    items.push({ label: 'DEV MODE', blurb: 'BALANCE, CHEATS, JUMP, ACTIONS, VIEW.', onConfirm: () => App.overlays.push(new DevOverlay(stage)) });\n    items.push({ label: 'QUIT TO MENU', blurb: 'YOUR SHIFT IS SAVED AT THE LAST OPERATION.', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    this.menu = new Menu(App, items, { w: 170, y: 76, rows: 6, onBack: pop });\n  }\n  update(ui) {\n    this.menu.update(ui);\n    if (App.devices.nav.start && App.overlays[App.overlays.length - 1] === this && !App.devices.nav.back) pop();\n  }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 220) / 2, 44, 220, 142);\n    ui.center(52, 'PAUSED', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'RESUME']]);\n  }\n}\n\nexport class FailOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    stage.fails = (stage.fails ?? 0) + 1;\n    this.line = stage.failReason === 'clock' ? 'Time. Time of death...' : stage.failReason === 'mistakes' ? 'Doctor. Step away from the table. Time of death...' : stage.failReason === 'cold' ? 'The kidney is gone. So is she. Time of death...' : 'Time of death...';\n    const items = [\n      { label: 'RETRY FROM THIS STAGE', blurb: 'RANK CAPPED AT B.', onConfirm: () => stage.retry() },\n      { label: 'RESTART', blurb: 'THE WHOLE OPERATION AGAIN.', onConfirm: () => { pop(); stage.restart(); } },\n    ];\n    const diff = stage.sim.diffId;\n    if (stage.fails >= 2 && diff !== 'intern') {\n      const lower = diff === 'attending' ? 'resident' : 'intern';\n      items.unshift({ label: `LOWER TO ${DIFFICULTIES[lower].label}`, blurb: 'NOBODY WILL KNOW. REYES WILL KNOW.', onConfirm: () => { if (App.save.progress) { App.save.progress.difficulty = lower; App.persist(); } pop(); stage.restart(lower); } });\n    }\n    if (stage.mode !== 'story') items.push({ label: 'QUIT', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    else items.push({ label: 'QUIT TO MENU', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    this.menu = new Menu(App, items, { w: 220, y: 100, rows: 5 });\n    this.t = 0;\n  }\n  update(ui, dt) { this.t += dt; if (this.t > 0.4) this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.rect(0, 52, ui.w, 30, 'ink');\n    ui.center(55, 'FLATLINE', { color: 'red', scale: 2 });\n    ui.center(74, `NURSE REYES: \"${this.line}\"`, { color: 'white' });\n    ui.rect((ui.w - 250) / 2, 92, 250, 72, 'night');\n    ui.outline((ui.w - 250) / 2, 92, 250, 72, 'red');\n    this.menu.draw(ui);\n  }\n}\n\nexport class SettingsOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const S = App.save.settings;\n    const audio = App.ctx.audio;\n    const step = (key, delta, min = 0, max = 1) => { S[key] = Math.round(Math.min(max, Math.max(min, S[key] + delta)) * 100) / 100; App.persist(); };\n    const cycle = (key, list, dir) => { const i = list.indexOf(S[key]); S[key] = list[(i + dir + list.length) % list.length]; App.persist(); };\n    const volMusic = (d) => { audio.setVolume('music', Math.round(Math.min(1, Math.max(0, audio.volume.music + d)) * 100) / 100); };\n    const volSfx = (d) => { step('sound', d); audio.setVolume('sfx', S.sound); App.sfx('uiMove'); };\n    const LOOKS = LOOK_CHOICES.map((l) => l[0]);\n    const row = (label, value, onLeft, onRight, blurb) => ({ label, value, onLeft, onRight, blurb });\n    const items = [\n      row('MUSIC', () => pct(audio.volume.music), () => volMusic(-0.05), () => volMusic(0.05), 'MUSIC STARTS AT 10%.'),\n      row('SOUND', () => pct(S.sound), () => volSfx(-0.05), () => volSfx(0.05)),\n      row('VOICES', () => pct(S.voices), () => step('voices', -0.05), () => { step('voices', 0.05); App.voiceChar('reyes', 'ah', 0); }),\n      row('BUTTON GLYPHS', () => (S.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), () => cycle('glyphs', ['playstation', 'xbox'], 1), () => cycle('glyphs', ['playstation', 'xbox'], 1)),\n      row('AIM ASSIST', () => S.aimAssist.toUpperCase(), () => cycle('aimAssist', ['off', 'low', 'high'], -1), () => cycle('aimAssist', ['off', 'low', 'high'], 1), 'STICKS AND KEYS ONLY.'),\n      row('CURSOR SPEED', () => pct(S.cursorSpeed), () => step('cursorSpeed', -0.05, 0.4, 2), () => step('cursorSpeed', 0.05, 0.4, 2)),\n      row('RUMBLE', () => (S.rumble ? 'ON' : 'OFF'), () => { S.rumble = !S.rumble; App.persist(); }, () => { S.rumble = !S.rumble; App.persist(); App.rumble({ strong: 0.6, weak: 0.4, ms: 150 }); }),\n      row('GIFT', () => S.giftMode.toUpperCase(), () => cycle('giftMode', ['hold', 'toggle'], 1), () => cycle('giftMode', ['hold', 'toggle'], 1), 'HOLD OR TOGGLE THE QUIET.'),\n      row('LOOK', () => LOOK_CHOICES[Math.max(0, LOOKS.indexOf(S.look))][1], () => { cycle('look', LOOKS, -1); this.refreshLook(); }, () => { cycle('look', LOOKS, 1); this.refreshLook(); }, 'ANY OF THE ENGINE\\'S LOOKS.'),\n      row('PIXEL SIZE', () => String(S.pixelSize), () => { step('pixelSize', -1, 1, 4); this.refreshLook(); }, () => { step('pixelSize', 1, 1, 4); this.refreshLook(); }),\n      row('SCREEN SHAKE', () => pct(S.shake), () => step('shake', -0.25), () => { step('shake', 0.25); App.shake(0.4); }),\n      row('REDUCE FLASHES', () => (S.reduceFlashes ? 'ON' : 'OFF'), () => { S.reduceFlashes = !S.reduceFlashes; App.persist(); }, () => { S.reduceFlashes = !S.reduceFlashes; App.persist(); }),\n      row('TEXT SPEED', () => pct(S.textSpeed), () => step('textSpeed', -0.25, 0.5, 3), () => step('textSpeed', 0.25, 0.5, 3)),\n      row('DIFFICULTY', () => DIFFICULTIES[App.save.progress?.difficulty ?? S.difficulty].label, () => this.diff(-1), () => this.diff(1), 'APPLIES FROM THE NEXT OPERATION.'),\n      { label: 'FULLSCREEN', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), onConfirm: () => this.fullscreen(), onRight: () => this.fullscreen(), onLeft: () => this.fullscreen() },\n      { label: 'RESET', blurb: 'EVERYTHING HERE BACK TO DEFAULTS.', onConfirm: () => { App.resetSettings(); pop(); App.overlays.push(new SettingsOverlay(stage)); } },\n    ];\n    this.menu = new Menu(App, items, { w: 300, y: 42, rows: 8, onBack: pop, rowH: 18 });\n  }\n  diff(dir) {\n    const list = Object.keys(DIFFICULTIES);\n    const cur = App.save.progress?.difficulty ?? App.save.settings.difficulty;\n    const next = list[(list.indexOf(cur) + dir + list.length) % list.length];\n    App.save.settings.difficulty = next;\n    if (App.save.progress) App.save.progress.difficulty = next;\n    App.persist();\n  }\n  refreshLook() {\n    App.engine._gameLook = null;\n    App.engine.setLook(App.engine.look);\n    if (this.stage.updateLook) this.stage.updateLook(App.ctx, true);\n    else import('../view/looks.js').then((m) => m.applyLook(App.engine, App.save.settings));\n  }\n  fullscreen() {\n    if (typeof document === 'undefined') return;\n    if (document.fullscreenElement) document.exitFullscreen?.();\n    else document.documentElement.requestFullscreen?.().catch(() => {});\n  }\n  update(ui) { this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 340) / 2, 12, 340, ui.h - 30);\n    ui.center(20, 'SETTINGS', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\n\nexport class AboutOverlay {\n  constructor() {\n    this.page = 0;\n    this.line = 0;\n    this.pages = null;\n  }\n  layout(ui) {\n    if (this.pages) return;\n    const W = ui.w - 56;\n    this.pages = [];\n    for (const p of ABOUT_PAGES) {\n      const lines = [];\n      for (const [label, text] of p.rows) {\n        if (label) lines.push({ t: label, c: 'sand' });\n        for (const l of ui.wrap(String(text).toUpperCase().replace(/[^A-Z0-9 .,:;!?\\-+%/()[\\]'\"#&*=<>]/g, ' '), W)) lines.push({ t: l, c: 'white' });\n        lines.push({ t: '', c: 'white' });\n      }\n      const perPage = Math.floor((ui.h - 64) / 10);\n      for (let i = 0; i < lines.length; i += perPage) this.pages.push({ title: p.title, lines: lines.slice(i, i + perPage) });\n    }\n  }\n  update(ui) {\n    const d = App.devices;\n    this.layout(ui);\n    const flip = (dir) => { this.page = (this.page + dir + this.pages.length) % this.pages.length; App.sfx('uiMove'); };\n    if (d.nav.left || d.nav.tabL || d.nav.up) flip(-1);\n    if (d.nav.right || d.nav.tabR || d.nav.down || d.nav.confirm || d.click) flip(1);\n    if (d.wheel) flip(d.wheel > 0 ? 1 : -1);\n    if (d.nav.back || d.rightClick) { App.sfx('uiBack'); pop(); }\n  }\n  draw(ui) {\n    this.layout(ui);\n    dim(ui);\n    ui.panel(10, 8, ui.w - 20, ui.h - 22);\n    const p = this.pages[this.page];\n    ui.text(20, 14, p.title, { color: 'sand', scale: 2 });\n    ui.right(ui.w - 20, 16, `${this.page + 1}/${this.pages.length}`, { color: 'mist' });\n    p.lines.forEach((l, i) => ui.text(20, 36 + i * 10, l.t, { color: l.c, shadow: false }));\n    ui.hints([['back', 'BACK']]);\n  }\n}\n\n// ---------------------------------------------------------------- Dev Mode\nconst TABS = ['BALANCE', 'CHEATS', 'JUMP', 'ACTIONS', 'VIEW'];\nexport class DevOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    this.tab = 0;\n    this.jumpOp = 0;\n    this.jumpStage = 0;\n    this.build();\n  }\n  build() {\n    const cfg = App.config;\n    const sim = this.stage.sim;\n    const dv = App.devView;\n    let items = [];\n    if (this.tab === 0) {\n      items = SLIDERS.map(([key, label, min, max, st]) => ({\n        label,\n        value: () => String(Math.round(cfg[key] * 100) / 100),\n        onLeft: () => { cfg[key] = Math.max(min, Math.round((cfg[key] - st) * 1000) / 1000); },\n        onRight: () => { cfg[key] = Math.min(max, Math.round((cfg[key] + st) * 1000) / 1000); },\n      }));\n      items.push({ label: 'RESET TO DEFAULTS', onConfirm: () => resetConfig(cfg) });\n    } else if (this.tab === 1) {\n      const ch = App.cheats;\n      const tog = (label, key) => ({ label, value: () => (ch[key] ? 'ON' : 'OFF'), onConfirm: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; }, onLeft: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; }, onRight: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; } });\n      items = [tog('GOD VITALS', 'god'), tog('INFINITE COMPOSURE', 'infComposure'), tog('FREEZE CLOCK', 'freezeClock'), tog('UNLIMITED MISTAKES', 'unlimitedMistakes'),\n        { label: 'UNLOCK ALL', value: () => (App.unlockAll ? 'ON' : 'OFF'), onConfirm: () => { App.unlockAll = !App.unlockAll; } }];\n    } else if (this.tab === 2) {\n      const ids = Object.keys(OPS);\n      items = [\n        { label: 'OPERATION', value: () => OPS[ids[this.jumpOp]].title, onLeft: () => { this.jumpOp = (this.jumpOp + ids.length - 1) % ids.length; this.jumpStage = 0; }, onRight: () => { this.jumpOp = (this.jumpOp + 1) % ids.length; this.jumpStage = 0; } },\n        { label: 'STAGE', value: () => `${this.jumpStage + 1}: ${OPS[ids[this.jumpOp]].stages[this.jumpStage].id}`, onLeft: () => { const n = OPS[ids[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + n - 1) % n; }, onRight: () => { const n = OPS[ids[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + 1) % n; } },\n        { label: 'GO TO THAT STAGE', onConfirm: async () => { App.overlays.length = 0; const { OperationStage } = await import('../stages/operation.js'); App.goto(new OperationStage({ opId: ids[this.jumpOp], startStage: this.jumpStage, mode: 'replay', difficulty: 'resident', cheats: App.cheats })); } },\n        ...Object.keys(SCENES).map((id) => ({ label: `SCENE: ${SCENES[id].title}`, onConfirm: async () => { App.overlays.length = 0; const { StoryStage } = await import('../stages/story.js'); const { toTitle, CLOSE_CAM } = await import('../stages/flow.js'); App.goto(new StoryStage({ sceneId: id, onDone: () => toTitle() }), { camera: CLOSE_CAM }); } })),\n      ];\n    } else if (this.tab === 3) {\n      const act = (label, fn) => ({ label, onConfirm: () => { if (sim) import('../sim/op.js').then((m) => fn(m.dev, m)); } });\n      const closeAnd = (fn) => (dev, m) => { fn(dev, m); App.overlays.length = 0; };\n      items = [\n        act('COMPLETE STAGE', closeAnd((d) => d.completeStage(sim))),\n        act('WIN OP', closeAnd((d) => d.winOp(sim))),\n        act('FAIL OP', closeAnd((d) => d.failOp(sim))),\n        act('TRIGGER CODE BLUE', closeAnd((d) => d.codeBlue(sim))),\n        act('SPAWN POOL', (d) => d.spawn(sim, 'pool')),\n        act('SPAWN BLEEDER', (d) => d.spawn(sim, 'bleeder')),\n        act('SPAWN LACERATION', (d) => d.spawn(sim, 'laceration')),\n        act('SPAWN HOOK', (d) => d.spawn(sim, 'hook')),\n        act('SPAWN STRAIN', (d) => d.spawn(sim, 'strain')),\n        { label: 'COPY OP JSON TO CONSOLE', onConfirm: () => { console.log(JSON.stringify(this.stage.def ?? {}, null, 1)); this.toast = 'COPIED TO CONSOLE'; } },\n      ];\n    } else {\n      items = [\n        { label: 'HITBOX OVERLAY', value: () => (dv.hitboxes ? 'ON' : 'OFF'), onConfirm: () => { dv.hitboxes = !dv.hitboxes; } },\n        { label: 'BOT PLAYS', value: () => (dv.botPlays ? 'ON' : 'OFF'), onConfirm: () => { dv.botPlays = !dv.botPlays; } },\n        { label: 'BOT SKILL', value: () => dv.botSkill.toFixed(2), onLeft: () => { dv.botSkill = Math.max(0, Math.round((dv.botSkill - 0.05) * 100) / 100); }, onRight: () => { dv.botSkill = Math.min(1, Math.round((dv.botSkill + 0.05) * 100) / 100); } },\n        { label: 'SIM SPEED', value: () => `${dv.simSpeed.toFixed(1)}X`, onLeft: () => { dv.simSpeed = Math.max(0.1, Math.round((dv.simSpeed - 0.1) * 10) / 10); }, onRight: () => { dv.simSpeed = Math.min(3, Math.round((dv.simSpeed + 0.1) * 10) / 10); } },\n        { label: 'FRAME STEP', value: () => (dv.frameStep ? 'ON' : 'OFF'), onConfirm: () => { dv.frameStep = !dv.frameStep; }, blurb: 'WITH IT ON, THE TICK BELOW ADVANCES THE SIM.' },\n        { label: 'STEP ONE TICK', onConfirm: () => { dv.stepNow = true; } },\n        { label: 'FPS AND SIM STATS', value: () => (dv.stats ? 'ON' : 'OFF'), onConfirm: () => { dv.stats = !dv.stats; } },\n      ];\n    }\n    this.menu = new Menu(App, items, { w: 320, y: 46, rows: 11, rowH: 15, onBack: pop });\n  }\n  update(ui) {\n    const d = App.devices;\n    let tab = this.tab;\n    if (d.nav.tabL) tab = (tab + TABS.length - 1) % TABS.length;\n    if (d.nav.tabR) tab = (tab + 1) % TABS.length;\n    if (d.click) {\n      TABS.forEach((t, i) => {\n        const x = this.tabX(ui, i);\n        if (ui.hit(x, 22, 62, 14)) tab = i;\n      });\n    }\n    if (tab !== this.tab) { this.tab = tab; App.sfx('uiMove'); this.build(); return; }\n    this.menu.update(ui);\n  }\n  tabX(ui, i) { return (ui.w - TABS.length * 66) / 2 + i * 66; }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 372) / 2, 6, 372, ui.h - 20);\n    ui.center(10, 'DEV MODE', { color: 'lime' });\n    TABS.forEach((t, i) => {\n      const x = this.tabX(ui, i);\n      ui.rect(x, 22, 62, 14, i === this.tab ? 'navy' : 'ink');\n      ui.outline(x, 22, 62, 14, i === this.tab ? 'lime' : 'slate');\n      ui.text(x + 4, 25, t, { color: i === this.tab ? 'lime' : 'mist', shadow: false });\n    });\n    this.menu.draw(ui);\n    if (this.toast) ui.center(ui.h - 26, this.toast, { color: 'lime' });\n    ui.hints([['tabs', 'TAB'], ['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/content/about.js <<'EOF'\n// The About/Credits screen: paged, big text. Filled in last.\nexport const ABOUT_PAGES = [\n  { title: 'CREDITS', rows: [['ALL ART AND AUDIO', 'written in code.']] },\n];\nEOF\ncat > src/ui/touchgate.js <<'EOF'\n// Touch-only devices: no touch controls. An overlay with the exact text, the engine's settings button,\n// the attract reel running behind. A key or a pad drops the gate and the game plays normally.\nexport function showTouchGate(App) {\n  const el = document.createElement('div');\n  el.id = 'touch-gate';\n  el.textContent = 'Controller or keyboard required';\n  el.style.cssText = 'position:fixed;left:0;right:0;bottom:12%;text-align:center;color:#f4f4f4;background:rgba(13,11,20,.86);font:bold 18px monospace;padding:14px 10px;z-index:50;pointer-events:none';\n  document.body.appendChild(el);\n  const drop = async () => {\n    if (!App.touchOnly) return;\n    App.touchOnly = false;\n    el.remove();\n    const { toTitle } = await import('../stages/flow.js');\n    toTitle('title');\n  };\n  window.addEventListener('keydown', drop, { once: true });\n  window.addEventListener('gamepadconnected', drop, { once: true });\n  const poll = setInterval(() => {\n    if (!App.touchOnly) { clearInterval(poll); return; }\n    if (Array.from(navigator.getGamepads?.() ?? []).some(Boolean)) { clearInterval(poll); drop(); }\n  }, 500);\n}\nEOF\nnode tools/build.mjs 2>&1 | tail -3 && node tests/browser/shot.mjs \"\" tests/tmp/title.png 3000 2>&1 | tail -4","description":"Write story, briefing, results, title, log, consult, attract, overlays","timeout":200000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10545,"cache_read_input_tokens":464372,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10545},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"8480a29f-5cdf-45e4-bc6f-73cbcab1931f","timestamp":"2026-11-05T16:09:57.778Z","request_id":"req_011Cgk4oYZSdmxaf66ogUfYF","wire_tool_inputs":{"toolu_01YH4fnAta3n8hteUYBb1Y2Q":{"command":"cat > src/stages/flow.js <<'EOF'\n// Where the shift goes next. Save after every op.\nimport { App } from '../app.js';\nimport { OP_CAMERA } from './operation.js';\nimport { advance, currentStep } from '../sim/campaign.js';\nimport { betterRank } from '../sim/scoring.js';\n\nexport const CLOSE_CAM = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\nexport { OP_CAMERA };\n\nexport async function goCampaign() {\n  const p = App.save.progress;\n  const s = currentStep(p);\n  if (s.kind === 'scene') {\n    const { StoryStage } = await import('./story.js');\n    return App.goto(new StoryStage({ sceneId: s.id, onDone: () => { App.save.progress = advance(App.save.progress); App.persist(); goCampaign(); } }), { kind: 'dissolve', camera: CLOSE_CAM });\n  }\n  if (s.kind === 'op') {\n    const { BriefingStage } = await import('./briefing.js');\n    return App.goto(new BriefingStage({ opId: s.id, mode: 'story', difficulty: p.difficulty }), { kind: 'fade', camera: CLOSE_CAM });\n  }\n  const { ShiftReportStage } = await import('./results.js');\n  return App.goto(new ShiftReportStage(), { kind: 'fade', camera: CLOSE_CAM });\n}\n\n/** A won op is recorded, and in the campaign the shift moves on. */\nexport function recordOp(opId, tally, mode) {\n  const log = App.save.log;\n  const prev = log[opId];\n  const best = !prev || prev.total < tally.total ? { total: tally.total, rank: betterRank(tally.rank, prev?.rank), pristine: tally.pristine || !!prev?.pristine, mistakes: tally.mistakes } : { ...prev, rank: betterRank(tally.rank, prev.rank), pristine: tally.pristine || !!prev.pristine };\n  log[opId] = best;\n  if (mode === 'story' && App.save.progress) App.save.progress = advance(App.save.progress);\n  App.persist();\n}\nexport async function toTitle(state = 'main') {\n  const { TitleStage } = await import('./title.js');\n  return App.goto(new TitleStage(state), { kind: 'fade' });\n}\nEOF\ncat > src/stages/story.js <<'EOF'\n// A story scene: set plus busts, typewriter text with gibberish voice, the speaker leaning in and the\n// other dimmed. Wide shots use full-body figures and the engine's Timeline.\nimport { THREE, Timeline } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { SPEAKER_NAMES } from '../content/lines.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { pauseAfter } from '../audio/voice.js';\nimport { BustRig } from '../view/bust.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nconst SLOTS = { L: -1.3, R: 1.3 };\nconst FIGS = { ilya: 'Idle', reyes: 'Idle', sabine: 'IdleLook', bram: 'Idle', pem: 'Sit', hesper: 'Idle', tomasz: 'Idle', zamboni: 'Wave', anselm: 'Idle', ottilie: 'Idle', ollie: 'Idle' };\n\nexport class StoryStage extends Stage {\n  name = 'story';\n  constructor(o) {\n    super();\n    this.o = o;\n    this.scene = SCENES[o.sceneId];\n    this.i = -1;\n    this.chars = 0;\n    this.acc = 0;\n    this.pause = 0;\n    this.busts = {};\n    this.slots = { L: null, R: null };\n    this.figures = [];\n    this.markT = 0;\n    this.mark = null;\n    this.skipHold = 0;\n    this.camMode = 'close';\n    this.done = false;\n    this.ambT = 8;\n    this.autoT = 0;\n    this.busy = false;\n  }\n  cameraConfig = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\n\n  async build(ctx) {\n    this.setId = this.scene.set;\n    this.set = new SetView(ctx, this.setId);\n    this.makeKey(ctx);\n    this.placeFigures(ctx);\n    App.director.play(this.scene.music, { now: true });\n    applyLook(ctx.engine, App.save.settings);\n    this.rain = this.scene.rain || this.setId === 'helipad' ? ctx.audio.loop('rainLoop', { volume: this.setId === 'helipad' ? 1 : 0.5 }) : null;\n    this.next();\n  }\n  makeKey(ctx) {\n    // A key light for the faces, whatever the room is doing.\n    this.key?.release();\n    this.key = ctx.lights.request({ position: [0.4, 3, 3.4], color: 0xfff0e0, intensity: 7, radius: 8, priority: 8 });\n  }\n  placeFigures(ctx) {\n    for (const f of this.figures) ctx.scene.remove(f.object);\n    this.figures = [];\n    const who = [...new Set(this.scene.beats.map((b) => b.who).filter(Boolean))].slice(0, this.set.spots?.length ?? 3);\n    const figsFor = { ilya: 'ilya', reyes: 'reyes', sabine: 'sabine', bram: 'bram', pem: 'pem', hesper: 'hesper' };\n    const spots = this.set.spots ?? [];\n    who.forEach((w, i) => {\n      const s = spots[i];\n      if (!s) return;\n      const clip = this.scene.id === 'end' && w === 'reyes' ? 'Sit' : FIGS[w] ?? 'Idle';\n      const f = new Figure(ctx, figsFor[w] ?? 'patient', [s[0], s[1], s[2]], s[3], clip);\n      this.figures.push(f);\n    });\n    // A patient on the table, an orderly in the corridor: rooms should have people in them.\n    if (this.setId === 'corridor') {\n      this.figures.push(new Figure(ctx, 'extra', [2.6, 0, -4.2], -1.2, 'Run'));\n      this.figures.push(new Figure(ctx, 'extra', [-2.8, 0, -7.4], 1.4, 'Walk'));\n    }\n  }\n\n  beat() { return this.scene.beats[this.i]; }\n  next() {\n    this.i++;\n    if (this.i >= this.scene.beats.length) { this.finish(); return; }\n    const b = this.beat();\n    if (b.set && b.set !== this.setId) { this.swapSet(b.set); }\n    this.startBeat(b);\n  }\n  async swapSet(id) {\n    this.busy = true;\n    const ctx = this.ctx;\n    await ctx.engine.screen.cover('fade', { duration: 0.2 });\n    this.set.dispose();\n    ctx.scene.remove(this.set.group);\n    this.setId = id;\n    this.set = new SetView(ctx, id);\n    this.makeKey(ctx);\n    this.placeFigures(ctx);\n    this.busy = false;\n    await ctx.engine.screen.reveal('fade', { duration: 0.2 });\n  }\n  startBeat(b) {\n    this.text = (b.say ?? b.narr ?? '').replace(/\\*/g, '');\n    this.rich = b.say ?? b.narr ?? '';\n    this.chars = 0;\n    this.acc = 0;\n    this.pause = 0;\n    this.wrapped = null;\n    this.camMode = b.cam ?? (b.narr ? 'wide' : b.who ? 'close' : this.camMode);\n    if (b.cam === 'wide' || b.narr) {\n      const w = this.set.wide;\n      const dx = w.position[0], dz = w.position[2];\n      this.tl = new Timeline({ shots: [{ at: 0, position: w.position, target: w.target, fov: w.fov, cut: true }, { at: 7, position: [dx * 0.86, w.position[1] - 0.25, dz * 0.82], target: w.target, fov: w.fov }], bars: 0 });\n      this.tl.play();\n    } else this.tl = null;\n    if (b.who) {\n      const bust = this.ensureBust(b.who);\n      bust.setEmotion(b.emo ?? 'neutral');\n      for (const other of Object.values(this.busts)) if (other !== bust) other.setFocus(false);\n      bust.setFocus(true);\n      this.current = bust;\n    } else this.current = null;\n    if (b.mark) { this.mark = b.mark; this.markT = 0.55; App.sfx('reaction'); }\n    if (b.cue) this.cue(b.cue);\n  }\n  ensureBust(who) {\n    if (!this.busts[who]) {\n      const rig = new BustRig(this.ctx, who);\n      this.ctx.scene.add(rig.object);\n      this.busts[who] = rig;\n    }\n    const rig = this.busts[who];\n    if (this.slots.L !== who && this.slots.R !== who) {\n      // The slot whose occupant spoke longest ago gives way.\n      const free = !this.slots.L ? 'L' : !this.slots.R ? 'R' : this.lastSlot === 'L' ? 'R' : 'L';\n      const old = this.slots[free];\n      if (old && this.busts[old]) this.busts[old].object.visible = false;\n      this.slots[free] = who;\n      rig.object.visible = true;\n      rig.object.position.x = SLOTS[free];\n      rig.object.rotation.y = free === 'L' ? 0.2 : -0.2;\n      rig.popT = 0.25;\n    }\n    this.lastSlot = this.slots.L === who ? 'L' : 'R';\n    return rig;\n  }\n  cue(c) {\n    const ctx = this.ctx;\n    switch (c) {\n      case 'thunder': App.sfx('thunder'); App.flash('white', { duration: 0.25, strength: 0.5 }); App.shake(0.2); break;\n      case 'horn': App.sfx('horn'); break;\n      case 'bell': App.sfx('bell'); break;\n      case 'door': App.sfx('click', { pitch: -9 }); App.sfx('whoosh', { pitch: -3 }); break;\n      case 'reaction': App.sfx('stamp', { volume: 0.5 }); App.shake(0.2); break;\n      case 'tremor': App.shake(0.1); break;\n      case 'collapse': App.sfx('stamp'); App.shake(0.7); App.sfx('flatline', { volume: 0.4 }); break;\n      case 'breach': App.sfx('sobWave'); App.flash('lime', { duration: 0.3, strength: 0.5 }); App.shake(0.8); if (this.set.canister) this.set.canister.rotation.z = 1.3; break;\n      case 'hiss': App.sfx('gelLoop'); App.sfx('whoosh'); ctx.particles.burst('foam', [1.6, 1, -3.6], { count: 24, colors: ['lime', 'white'], speed: 2 }); break;\n      case 'fall': App.sfx('stamp', { volume: 0.7 }); break;\n      case 'wheel': App.sfx('tick'); App.sfx('tick', { pitch: 3 }); break;\n      default: break;\n    }\n  }\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    this.o.onDone?.();\n  }\n  showCursor() { return App.devices.last === 'kbm'; }\n\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figures) f.update(dt);\n    for (const r of Object.values(this.busts)) if (r.object.visible) {\n      r.update(dt);\n      if (r.popT > 0) { r.popT -= dt; r.object.position.y = -Math.max(0, r.popT) * 3; } else r.object.position.y = 0;\n    }\n    const closeUp = this.camMode === 'close';\n    for (const r of Object.values(this.busts)) if (r.object.visible !== undefined) r.object.parent && (r.group = r.object.parent);\n    for (const who of [this.slots.L, this.slots.R]) if (who && this.busts[who]) this.busts[who].object.visible = closeUp;\n    const cam = ctx.camera.camera;\n    if (this.tl) {\n      this.tl.update(dt);\n      const s = this.tl.camera();\n      if (s) {\n        cam.position.set(...s.position);\n        cam.fov = s.fov;\n        cam.updateProjectionMatrix();\n        cam.lookAt(...s.target);\n      }\n    } else {\n      const c = this.set.close;\n      const sw = Math.sin(this.t * 0.4) * 0.03;\n      cam.position.set(c.position[0] + sw, c.position[1], c.position[2]);\n      if (cam.fov !== c.fov) { cam.fov = c.fov; cam.updateProjectionMatrix(); }\n      cam.lookAt(c.target[0], c.target[1], c.target[2]);\n    }\n    // Room sounds under the talk.\n    this.ambT -= dt;\n    if (this.ambT <= 0) {\n      this.ambT = 9 + Math.random() * 10;\n      App.sfx(Math.random() < 0.5 ? 'bell' : 'horn', { volume: 0.5 });\n    }\n    if (overlay || this.busy) return;\n    // Typewriter.\n    const b = this.beat();\n    if (!b) return;\n    if (this.chars < this.text.length) {\n      const rate = 34 * (App.save.settings.textSpeed ?? 1) * (b.narr ? 1.3 : 1);\n      if (this.pause > 0) this.pause -= dt * rate;\n      else {\n        this.acc += dt * rate;\n        while (this.acc >= 1 && this.chars < this.text.length && this.pause <= 0) {\n          this.acc -= 1;\n          const i = this.chars++;\n          if (b.who && App.voiceChar(b.who, this.text, i)) this.current?.syllable();\n          this.pause = pauseAfter(this.text[i], this.text, i);\n        }\n      }\n    }\n    if (this.o.auto) { this.autoT += dt; if (this.autoT > 2.2 && this.chars >= this.text.length) { this.autoT = 0; this.next(); } return; }\n    const d = App.devices;\n    const nav = d.nav;\n    const advance = nav.confirm || d.click;\n    if (advance) {\n      if (this.chars < this.text.length) { this.chars = this.text.length; } else { App.sfx('uiMove'); this.next(); }\n      return;\n    }\n    // Pause, and hold to skip.\n    const holdSkip = ctx.input.isDown('Escape') || d.pads.some((p) => p.down[3]);\n    if (holdSkip) {\n      this.skipHold += dt;\n      if (this.skipHold >= 0.8) { this.skipHold = 0; this.finish(); }\n    } else this.skipHold = 0;\n    if (d.pads.some((p) => p.edge[9] && !p.down[8])) this.openPause();\n    this.markT = Math.max(0, this.markT - dt);\n  }\n  openPause() {\n    import('../ui/overlays.js').then((m) => { if (!App.overlays.length) App.overlays.push(new m.PauseOverlay(this)); });\n  }\n  draw(ctx, ui) {\n    const b = this.beat();\n    if (!b || this.done) return;\n    const w = ui.w, h = ui.h;\n    const boxH = 58;\n    const y = h - boxH - 5;\n    ui.rect(8 + 2, y + 2, w - 16, boxH, 'ink');\n    ui.rect(8, y, w - 16, boxH, 'night');\n    ui.outline(8, y, w - 16, boxH, b.narr ? 'slate' : 'mist');\n    const tx = 20, tw = w - 40;\n    if (!this.wrapped) this.wrapped = ui.wrap(this.rich, tw, 1);\n    if (b.who) {\n      const name = SPEAKER_NAMES[b.who] ?? b.who.toUpperCase();\n      const nw = ui.hud.measure(name, 1).width + 12;\n      ui.rect(tx - 4, y - 6, nw, 13, 'navy');\n      ui.outline(tx - 4, y - 6, nw, 13, 'sand');\n      ui.text(tx + 2, y - 3, name, { color: 'sand', shadow: false });\n    }\n    let left = this.chars;\n    this.wrapped.slice(0, 4).forEach((line, i) => {\n      ui.rich(tx, y + 11 + i * 11, line, { chars: left, hi: 'orange', color: b.narr ? 'mist' : 'white' });\n      left -= line.replace(/\\*/g, '').length + 1;\n    });\n    if (this.chars >= this.text.length && Math.sin(this.t * 6) > -0.3) ui.action(w - 28, y + boxH - 13, 'confirm');\n    // Reaction marks and speed lines.\n    if (this.markT > 0 && this.current && b.mark) {\n      const speakerX = this.slots.L === b.who ? 0.28 : 0.72;\n      const sx = w * speakerX + 54, sy = h * 0.12;\n      if (b.mark === '!') {\n        ui.text(sx, sy, '!', { color: 'white', scale: 5, shadow: 'ink' });\n        for (let i = 0; i < 14; i++) {\n          const a = (i / 14) * 6.283 + this.t;\n          const r0 = 150 + (i % 3) * 30, r1 = r0 + 26;\n          for (let k = 0; k < 6; k++) { const q = r0 + ((r1 - r0) * k) / 5; ui.rect(w / 2 + Math.cos(a) * q * 1.3, h * 0.4 + Math.sin(a) * q * 0.7, 2, 2, 'white'); }\n        }\n      } else if (b.mark === '?') ui.text(sx, sy, '?', { color: 'sand', scale: 5, shadow: 'ink' });\n      else if (b.mark === '...') ui.text(sx - 8, sy + 8, '...', { color: 'white', scale: 3, shadow: 'ink' });\n      else if (b.mark === 'sweat') ui.text(sx, sy + 4, '!?', { color: 'cyan', scale: 3, shadow: 'ink' });\n    }\n    if (this.skipHold > 0) {\n      ui.text(w - 70, 6, 'SKIPPING', { color: 'white' });\n      ui.rect(w - 70, 15, 60 * (this.skipHold / 0.8), 3, 'sand');\n    } else if (!this.o.auto) ui.hints([['skip', 'HOLD TO SKIP']], 5);\n    if (this.o.attractLabel) this.o.attractLabel(ui);\n  }\n  status() { return `story ${this.scene.id} beat=${this.i}/${this.scene.beats.length}`; }\n  dispose() { this.rain?.stop(); this.key?.release(); }\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// The briefing: a clipboard chart over the theatre. Patient name, age, job, hook, the op's title\n// stamped, and the one-line objective. Then the camera dives down onto the field.\nimport { App } from '../app.js';\nimport { DIFFICULTIES } from '../core/config.js';\nimport { OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\nimport { toTitle } from './flow.js';\n\nexport class BriefingStage extends Stage {\n  name = 'briefing';\n  constructor(o) { super(); this.o = o; this.def = OPS[o.opId]; this.slide = 0; this.dive = 0; this.seats = o.seats; }\n  cameraConfig = { preset: 'fixed', position: [5.2, 3.6, 5.2], target: [0, 1.2, -2.8], fov: 38, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.03;\n    this.figs = [new Figure(ctx, this.def.surgeon === 'sabine' ? 'sabine' : 'ilya', [-1.9, 0, -2.2], 1.1), new Figure(ctx, 'reyes', [1.9, 0, -2.3], -1), new Figure(ctx, 'pem', [-3, 0, -3.8], 0.8, 'Sit')];\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play(this.def.music && this.def.music !== 'silence' ? 'title' : 'title');\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs) f.update(dt);\n    this.slide = Math.min(1, this.slide + dt * 3);\n    const cam = ctx.camera.camera;\n    if (this.dive > 0) {\n      this.dive += dt / 1.1;\n      const k = Math.min(1, this.dive);\n      const e = k * k * (3 - 2 * k);\n      cam.position.set(5.2 * (1 - e), 3.6 + e * 0.8, 5.2 + (-3 + 1.4 - 5.2) * e);\n      cam.fov = 38 + e * 12;\n      cam.updateProjectionMatrix();\n      cam.lookAt(0, 1.1 * e + 1.2 * (1 - e), -3 * e + -2.8 * (1 - e));\n      if (k >= 1 && !this.left) { this.left = true; this.launch(); }\n      return;\n    }\n    cam.position.set(5.2 + Math.sin(this.t * 0.2) * 0.2, 3.6, 5.2);\n    cam.lookAt(0, 1.2, -2.8);\n    if (overlay) return;\n    const d = App.devices;\n    if (d.nav.confirm || d.click) { App.sfx('uiConfirm'); App.sfx('whoosh'); this.dive = 0.001; }\n    else if (d.nav.back || d.rightClick) {\n      if (this.o.onBack) this.o.onBack(); else toTitle();\n    }\n  }\n  launch() {\n    App.goto(new OperationStage({ opId: this.o.opId, mode: this.o.mode, difficulty: this.o.difficulty, seats: this.o.seats, startStage: this.o.startStage }), { kind: 'iris', duration: 0.28, camera: OP_CAMERA });\n  }\n  draw(ctx, ui) {\n    if (this.dive > 0) return;\n    const p = this.def.patient;\n    const w = ui.w, h = ui.h;\n    const cw = Math.min(330, w - 30), ch = Math.min(210, h - 40);\n    const x = (w - cw) / 2, y = (h - ch) / 2 + (1 - this.slide) * h - 4;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    const tx = x + 14;\n    ui.text(tx, y + 13, this.def.num ? `OPERATION ${this.def.num}` : 'CONSULT', { color: 0x7a6a4a, shadow: false });\n    ui.text(tx, y + 25, p.name, { color: ink, scale: 2, shadow: false });\n    ui.text(tx, y + 45, `AGE ${p.age}   ${p.job}`, { color: ink, shadow: false });\n    ui.rect(tx, y + 56, cw - 28, 1, 0xa89a78);\n    const hookLines = ui.wrap(p.hook, cw - 30);\n    hookLines.slice(0, 3).forEach((l, i) => ui.text(tx, y + 62 + i * 10, l, { color: ink, shadow: false }));\n    ui.rect(tx, y + 96, cw - 28, 1, 0xa89a78);\n    const obj = ui.wrap(p.objective, cw - 30);\n    obj.slice(0, 2).forEach((l, i) => ui.rich(tx, y + 102 + i * 10, l, { color: 0x8a1f38, shadow: false, hi: 0x8a1f38 }));\n    const ttl = this.def.title;\n    const ts = ui.hud.measure(ttl, 2).width > cw - 30 ? 1 : 2;\n    ui.stamp(x + cw / 2, y + ch - 60, ttl, 0xb13e53, ts);\n    const best = App.save.log[this.def.id];\n    if (best) ui.text(tx, y + ch - 30, `BEST: ${best.rank}${best.pristine ? '  PRISTINE' : ''}`, { color: ink, shadow: false });\n    ui.text(tx, y + ch - 19, DIFFICULTIES[this.o.difficulty ?? 'resident'].label, { color: 0x7a6a4a, shadow: false });\n    const label = 'SCRUB IN';\n    const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + 4;\n    const lx = x + cw - lw - 12;\n    ui.action(lx, y + ch - 19, 'confirm');\n    ui.text(lx + ui.actionWidth('confirm') + 4, y + ch - 18, label, { color: ink, shadow: false });\n  }\n  status() { return `briefing ${this.def.id}`; }\n}\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally one at a time with ticks, the rank stamp slams, Reyes comments,\n// then the patient's follow-up line. Also the shift report at the very end.\nimport { App } from '../app.js';\nimport { OPS, CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { recordOp, goCampaign, toTitle } from './flow.js';\nimport { finalTally } from '../sim/scoring.js';\nimport { BustRig } from '../view/bust.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nconst RANK_COLOR = { S: 0xf4c430, A: 0x38b764, B: 0x3b5dc9, C: 0xb13e53 };\nconst COMMENTS = {\n  reyes: {\n    S: ['...Adequate. I will deny having said so.', \"That was correct. Don't let it go to your head. It's not attached to anything useful.\"],\n    A: ['Competent. Write that down. You will not hear it twice.', 'Hm. You may finish your coffee.'],\n    B: ['The patient lived. That is the job. Barely.', 'Passable. Passable is a word for gravy, Doctor.'],\n    C: [\"They'll keep breathing. Do better.\", 'I have seen sharper work from the vending machine.'],\n  },\n  sabine: {\n    S: ['No notes.', 'I have reviewed the report. It is short. That is praise.'],\n    A: ['Adequate.', 'You may tell people I said so. They will not believe you.'],\n    B: ['Acceptable, in the sense that nobody is suing.', 'You have two options. Improve is one.'],\n    C: ['They lived. I do not know why. Neither do you.', 'I will be writing this one down.'],\n  },\n};\nconst OP1_C = \"He'll keep the arm. Do better.\";\n\nexport class ResultsStage extends Stage {\n  name = 'results';\n  constructor(o) {\n    super();\n    this.o = o;\n    this.def = OPS[o.opId];\n    this.tally = finalTally(o.sim);\n    this.lineI = -1;\n    this.lineT = 0;\n    this.shown = 0;\n    this.slide = 0;\n    this.stampT = -1;\n    this.phase = 0;\n    this.chars = 0;\n    this.commentChars = 0;\n    this.followChars = 0;\n    this.pristineT = -1;\n    recordOp(o.opId, this.tally, o.mode);\n    this.lines = [\n      ['TIME LEFT', this.tally.time], ['VITALS', this.tally.vitals], ['TECHNIQUE', this.tally.technique],\n      ['BEST STREAK', `x${this.tally.bestStreak}`], ['MISTAKES', this.tally.mistakes],\n    ];\n    if (this.tally.penalty) this.lines.push(['SECOND LOOKS', -this.tally.penalty]);\n    this.lines.push(['TOTAL', this.tally.total]);\n    const pool = COMMENTS[this.def.id === 'op9' || this.def.surgeon === 'sabine' ? 'sabine' : 'reyes'][this.tally.rank];\n    this.comment = o.opId === 'op1' && this.tally.rank === 'C' ? OP1_C : pool[o.sim.tick % pool.length];\n    this.commenter = this.def.id === 'op9' || this.def.surgeon === 'sabine' ? 'sabine' : 'reyes';\n    this.follow = this.def.patient.followUp[this.tally.rank];\n    this.seatRows = o.sim.seats.filter((s) => !s.bot).length > 1 ? o.sim.seats.filter((s) => !s.bot) : null;\n  }\n  cameraConfig = { preset: 'fixed', position: [0.2, 1.75, 5.1], target: [0, 1.42, 0], fov: 30, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.02;\n    this.bust = new BustRig(ctx, this.commenter);\n    this.bust.object.position.set(1.62, 0, 0.2);\n    this.bust.object.rotation.y = -0.3;\n    ctx.scene.add(this.bust.object);\n    this.key = ctx.lights.request({ position: [1, 3, 3.4], color: 0xfff0e0, intensity: 7, radius: 8, priority: 8 });\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play(this.tally.rank === 'C' ? 'results-sad' : 'results-win', { now: true });\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    this.bust.update(dt);\n    const cam = ctx.camera.camera;\n    cam.position.set(0.2, 1.75, 5.1);\n    cam.lookAt(0, 1.42, 0);\n    this.slide = Math.min(1, this.slide + dt * 2.6);\n    if (this.slide < 1) return;\n    if (this.phase === 0) {\n      this.lineT += dt;\n      if (this.lineT >= 0.34) {\n        this.lineT = 0;\n        this.shown++;\n        App.sfx('tally', { pitch: this.shown });\n        if (this.shown >= this.lines.length) { this.phase = 1; this.stampT = 0.3; }\n      }\n    } else if (this.phase === 1) {\n      this.stampT -= dt;\n      if (this.stampT <= 0) {\n        this.phase = 2;\n        this.slam = 1;\n        App.sfx('stamp');\n        App.shake(0.8);\n        App.rumble({ strong: 1, weak: 0.6, ms: 250 });\n        ctx.engine.hitstop(0.08);\n        this.bust.setEmotion(this.tally.rank === 'C' ? 'stern' : this.tally.rank === 'S' ? 'smile' : 'neutral');\n        if (this.tally.pristine) { this.pristineT = 0.5; }\n      }\n    } else if (this.phase === 2) {\n      this.commentChars += dt * 34;\n      const i = Math.floor(this.commentChars);\n      if (i !== this.lastSyl && i < this.comment.length) { this.lastSyl = i; if (App.voiceChar(this.commenter, this.comment, i)) this.bust.syllable(); }\n      if (this.commentChars >= this.comment.length + 24) this.phase = 3;\n    } else if (this.phase === 3) {\n      this.followChars += dt * 30;\n    }\n    if (this.pristineT > 0) { this.pristineT -= dt; if (this.pristineT <= 0) { App.sfx('stamp', { pitch: 7 }); App.flash('sand', { duration: 0.2, strength: 0.5 }); this.pristineShown = true; } }\n    this.slam = Math.max(0, (this.slam ?? 0) - dt * 4);\n    if (overlay) return;\n    const d = App.devices;\n    if (d.nav.confirm || d.click) {\n      if (this.phase < 3) {\n        this.shown = this.lines.length;\n        if (this.phase < 2) { this.phase = 1; this.stampT = 0; }\n        else { this.commentChars = this.comment.length + 30; this.phase = 3; this.followChars = 999; }\n        return;\n      }\n      if (this.followChars < this.follow.length) { this.followChars = 999; return; }\n      App.sfx('uiConfirm');\n      this.leave();\n    }\n  }\n  async leave() {\n    if (this.leaving) return;\n    this.leaving = true;\n    if (this.o.mode === 'story') return goCampaign();\n    if (this.o.mode === 'consult') {\n      const { ConsultStage } = await import('./consult.js');\n      return App.goto(new ConsultStage());\n    }\n    if (this.o.mode === 'replay' && this.o.fromLog) {\n      const { LogStage } = await import('./log.js');\n      return App.goto(new LogStage(this.o.opId));\n    }\n    return toTitle();\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    const cw = Math.min(250, w * 0.56), ch = Math.min(190, h - 62);\n    const x = 14, y = 16 + (1 - this.slide) * -h;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    ui.text(x + 10, y + 12, this.def.title, { color: ink, shadow: false });\n    ui.text(x + 10, y + 22, this.def.patient.name, { color: 0x7a6a4a, shadow: false });\n    ui.rect(x + 10, y + 32, cw - 20, 1, 0xa89a78);\n    if (this.seatRows) {\n      this.seatRows.forEach((s, i) => {\n        const yy = y + 38 + i * 12;\n        ui.rect(x + 10, yy, 8, 8, ['red', 'sky', 'lime', 'sand'][i % 4]);\n        ui.text(x + 22, yy, s.name ?? `SEAT ${i + 1}`, { color: ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(Math.round(s.score)), { color: ink, shadow: false });\n      });\n      this.lines.slice(0, this.shown).forEach((l, i) => {\n        if (i < 4 && l[0] !== 'TOTAL') return;\n        const yy = y + 38 + this.seatRows.length * 12 + 4;\n        ui.text(x + 10, yy, 'TOTAL', { color: ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(l[1]), { color: ink, shadow: false });\n      });\n    } else {\n      this.lines.slice(0, this.shown).forEach((l, i) => {\n        const yy = y + 38 + i * 12;\n        const isT = l[0] === 'TOTAL';\n        ui.text(x + 10, yy, l[0], { color: isT ? 0x8a1f38 : ink, shadow: false });\n        ui.right(x + cw - 10, yy, String(l[1]), { color: isT ? 0x8a1f38 : ink, shadow: false });\n      });\n    }\n    if (this.phase >= 2) {\n      const scale = 7 + Math.round((this.slam ?? 0) * 6);\n      ui.stamp(x + cw - 34, y + ch - 30, this.tally.rank, RANK_COLOR[this.tally.rank], Math.min(8, scale));\n      if (this.pristineShown) ui.stamp(x + 56, y + ch - 20, 'PRISTINE', 0xc99a1a, 1);\n    }\n    // The comment, the follow-up.\n    const by = h - 58;\n    if (this.phase >= 2) {\n      ui.rect(8, by, w - 16, 52, 'night');\n      ui.outline(8, by, w - 16, 52, 'mist');\n      const nm = this.commenter === 'sabine' ? 'DR. ACHTERBERG' : 'NURSE REYES';\n      ui.text(16, by + 4, nm, { color: 'sand', shadow: false });\n      ui.text(16, by + 15, this.comment.slice(0, Math.floor(this.commentChars)), { color: 'white', shadow: false });\n      if (this.phase >= 3) {\n        const lines = ui.wrap(this.follow, w - 36);\n        let left = Math.floor(this.followChars);\n        lines.slice(0, 2).forEach((l, i) => { ui.text(16, by + 28 + i * 10, l.slice(0, Math.max(0, left)), { color: 'mist', shadow: false }); left -= l.length + 1; });\n        if (Math.sin(this.t * 5) > -0.2) ui.action(w - 26, by + 40, 'confirm');\n      }\n    }\n  }\n  showCursor() { return App.devices.last === 'kbm'; }\n  status() { return `results ${this.def.id} rank=${this.tally.rank} total=${this.tally.total}`; }\n  dispose() { this.key?.release(); }\n}\n\n/** The end of the shift: every rank, a stamp each, then credits and back to title. */\nexport class ShiftReportStage extends Stage {\n  name = 'shiftreport';\n  cameraConfig = { preset: 'fixed', position: [4.5, 3.6, 5.8], target: [0, 1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  async build(ctx) {\n    this.set = new SetView(ctx, 'morning');\n    this.page = 0;\n    this.creditT = 0;\n    App.director.play('credits', { now: true });\n    applyLook(ctx.engine, App.save.settings);\n    if (App.save.progress) { App.save.progress.finished = true; App.persist(); }\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    const cam = ctx.camera.camera;\n    cam.position.set(4.5 + Math.sin(this.t * 0.1), 3.6, 5.8);\n    cam.lookAt(0, 1, -3);\n    if (overlay) return;\n    const d = App.devices;\n    if (this.page === 1) this.creditT += dt * 12;\n    if (d.nav.confirm || d.click) {\n      App.sfx('uiConfirm');\n      if (this.page === 0) this.page = 1;\n      else toTitle();\n    }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    if (this.page === 0) {\n      const cw = Math.min(340, w - 30), ch = Math.min(226, h - 24);\n      const x = (w - cw) / 2, y = (h - ch) / 2 + 2;\n      ui.clipboard(x, y, cw, ch);\n      const ink = 0x28203a;\n      ui.text(x + 12, y + 12, 'SHIFT REPORT', { color: ink, scale: 2, shadow: false });\n      ui.text(x + 12, y + 32, 'DR. I. MARSH. VERITY GENERAL. SIGNED OFF.', { color: 0x7a6a4a, shadow: false });\n      CAMPAIGN_OPS.forEach((o, i) => {\n        const yy = y + 45 + i * 15;\n        const r = App.save.log[o.id];\n        ui.text(x + 12, yy, `${o.num}`.padStart(2, ' '), { color: 0x7a6a4a, shadow: false });\n        ui.text(x + 30, yy, o.title, { color: ink, shadow: false });\n        if (r) {\n          ui.stamp(x + cw - 24, yy + 3, r.rank, RANK_COLOR[r.rank], 1);\n          if (r.pristine) ui.text(x + cw - 84, yy, 'PRISTINE', { color: 0xc99a1a, shadow: false });\n        }\n      });\n      ui.action(x + cw - 20, y + ch - 13, 'confirm');\n    } else {\n      const lines = ['THE RAIN STOPPED.', '', 'THE TRUTH, STAT.', '', '', 'A GAME WRITTEN IN CODE, ALL OF IT.', '', 'ART, MUSIC, VOICES: CODE.', 'ENGINE: PIXEL ENGINE (MIT).', 'THREE.JS (MIT). RAPIER (APACHE-2.0).', 'FURNITURE KIT BY KENNEY (CC0).', '', '', 'NO ONE SHOULD HURT, HE SAID, ONCE.', 'NOW HE TELLS THEM: IT IS INFORMATION.', '', '', 'OPERATING LOG UNLOCKED.', '', 'YOU HAVE A SEVEN A.M.'];\n      lines.forEach((l, i) => {\n        const y = h + i * 14 - this.creditT;\n        if (y > -10 && y < h) ui.center(y, l, { color: 'white', shadow: 'ink' });\n      });\n      ui.hints([['confirm', 'TITLE']], h - 12);\n    }\n  }\n  status() { return 'shift report'; }\n}\nEOF\ncat > src/stages/title.js <<'EOF'\n// Title and main menu: a dark operating theatre with one swinging lamp. An EKG line draws itself through\n// the title. Ten idle seconds start the attract reel.\nimport { App } from '../app.js';\nimport { SUBTITLE, TITLE } from '../core/meta.js';\nimport { UI } from '../ui/hud.js';\nimport { Menu } from '../ui/menu.js';\nimport { applyLook } from '../view/looks.js';\nimport { Figure } from '../view/figure.js';\nimport { SetView } from '../view/sets.js';\nimport { Stage } from './stage.js';\n\nexport const TITLE_CAM = { preset: 'fixed', position: [5.4, 3.3, 6.2], target: [0, 1.5, -3], fov: 38, minZoom: 1, maxZoom: 1 };\n\nexport class TitleStage extends Stage {\n  name = 'title';\n  attractable = true;\n  cameraConfig = TITLE_CAM;\n  constructor(state = 'title') { super(); this.state = state; this.ekgX = 0; this.menuAlpha = 0; this.flick = 0; }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    this.set.lampSwing = 0.12;\n    this.figure = new Figure(ctx, 'patient', [-1.2, 1.2, -3], Math.PI / 2, 'LieIdle');\n    this.figure.object.visible = false;\n    applyLook(ctx.engine, App.save.settings, 1, 0.42, 0);\n    App.director.play('title', { now: App.director.current == null });\n    this.rain = ctx.audio.loop('rainLoop', { volume: 0.35 });\n    this.buildMenu();\n    if (App.touchOnly && !App.attractStarted) { App.attractStarted = true; this.startAttract(); }\n  }\n  buildMenu() {\n    const prog = App.save.progress;\n    const items = [\n      { label: 'ON CALL', blurb: prog ? 'THE SHIFT IS WAITING.' : 'A STORM. 3 A.M. THE CHIEF IS UNREACHABLE.', onConfirm: () => this.onCall() },\n      { label: 'OPERATING LOG', disabled: Object.keys(App.save.log).length === 0, blurb: 'REPLAY CLEARED OPERATIONS.', onConfirm: () => this.openLog() },\n      { label: 'CONSULT', blurb: 'A SECOND PAIR OF HANDS. UP TO FOUR, ON ONE TV.', onConfirm: () => this.openConsult() },\n      { label: 'SETTINGS', blurb: 'SOUND, GLYPHS, AIM, LOOK.', onConfirm: () => this.overlay('SettingsOverlay') },\n      { label: 'ABOUT', blurb: 'SOURCE, FEEDBACK, CREDITS.', onConfirm: () => this.overlay('AboutOverlay') },\n    ];\n    this.menu = new Menu(App, items, { w: 150, y: 150, rowH: 15, rows: 5 });\n    this.menu.fixFocus();\n  }\n  async overlay(name, arg) {\n    const m = await import('../ui/overlays.js');\n    App.overlays.push(new m[name](this, arg));\n  }\n  async onCall() {\n    const m = await import('../ui/overlays.js');\n    App.overlays.push(new m.OnCallOverlay(this));\n  }\n  async openLog() {\n    const { LogStage } = await import('./log.js');\n    App.goto(new LogStage());\n  }\n  async openConsult() {\n    const { ConsultStage } = await import('./consult.js');\n    App.goto(new ConsultStage());\n  }\n  async startAttract() {\n    const { startAttractReel } = await import('./attract.js');\n    startAttractReel();\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    this.ekgX += dt * 90;\n    const cam = ctx.camera.camera;\n    const k = this.state === 'main' ? 1 : 0;\n    this.menuAlpha += (k - this.menuAlpha) * Math.min(1, dt * 6);\n    cam.position.set(5.4 + Math.sin(this.t * 0.13) * 0.8 - this.menuAlpha * 0.6, 3.3 + Math.sin(this.t * 0.2) * 0.12, 6.2);\n    cam.lookAt(0, 1.5, -3);\n    if (overlay) return;\n    if (App.touchOnly) return;\n    const d = App.devices;\n    if (this.state === 'title') {\n      if (d.nav.confirm || d.click || d.nav.start || d.pads.some((p) => p.edge[0])) {\n        App.sfx('uiConfirm');\n        this.state = 'main';\n      }\n    } else {\n      this.menu.update(this.ui);\n      if (d.nav.back || d.rightClick) { this.state = 'title'; App.sfx('uiBack'); }\n    }\n  }\n  drawTitle(ui, y) {\n    const w = ui.w;\n    const mid = y + 12;\n    const scale = w < 400 ? 3 : 4;\n    const tw = ui.hud.measure(TITLE, scale).width;\n    const x = (w - tw) / 2;\n    ui.text(x, y, TITLE, { color: 'white', scale, shadow: 'plum' });\n    ui.center(y + 8 * scale + 4, SUBTITLE, { color: 'sand', scale: 2, shadow: 'plum' });\n    // The EKG line drawing itself through the title.\n    const span = w + 90;\n    const head = this.ekgX % span;\n    for (let px = 0; px < w; px++) {\n      if (px > head) break;\n      const age = head - px;\n      if (age > 260) continue;\n      const p = ((px + 60) % 120) / 120;\n      let yy = 0;\n      if (p > 0.4 && p < 0.44) yy = -5;\n      else if (p >= 0.44 && p < 0.47) yy = 16;\n      else if (p >= 0.47 && p < 0.5) yy = -22;\n      else if (p >= 0.5 && p < 0.53) yy = 9;\n      ui.rect(px, mid + yy, 1, 2, age < 30 ? 'white' : age < 130 ? 'red' : 'plum');\n      if (Math.abs(yy) > 4) { for (let q = 0; q < Math.abs(yy); q += 2) ui.rect(px, mid + Math.sign(yy) * q, 1, 2, age < 130 ? 'red' : 'plum'); }\n    }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    this.drawTitle(ui, Math.round(h * (this.state === 'main' ? 0.1 : 0.2)));\n    if (App.touchOnly) return;\n    if (this.state === 'title') {\n      if (Math.sin(this.t * 3.4) > -0.4) {\n        const label = 'PRESS ';\n        const device = ui.device;\n        const list = device === 'pad' ? [['confirm', '']] : [['confirm', ' OR CLICK']];\n        const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + ui.hud.measure(list[0][1], 1).width + 2;\n        let x = (w - lw) / 2;\n        const y = h * 0.72;\n        ui.text(x, y, label);\n        x += ui.hud.measure(label, 1).width;\n        x += ui.action(x, y - 1, 'confirm') + 2;\n        ui.text(x, y, list[0][1]);\n      }\n      ui.center(h - 12, '\"THE TRUTH, STAT.\" - OVER THE DOOR OF OR-7', { color: 'slate' });\n    } else {\n      this.menu.y = Math.round(h * 0.42);\n      this.menu.draw(ui);\n    }\n  }\n  status() { return `title state=${this.state} idle=${App.idle.toFixed(1)}`; }\n  dispose() { this.rain?.stop(); }\n}\nexport { UI };\nEOF\ncat > src/stages/log.js <<'EOF'\n// The Operating Log: one chart at a time, flip with left and right. Replay anything cleared.\nimport { App } from '../app.js';\nimport { CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { BriefingStage } from './briefing.js';\nimport { CLOSE_CAM, toTitle } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\nimport { TITLE_CAM } from './title.js';\n\nexport class LogStage extends Stage {\n  name = 'log';\n  attractable = true;\n  cameraConfig = TITLE_CAM;\n  constructor(opId) {\n    super();\n    this.list = CAMPAIGN_OPS.filter((o) => App.save.log[o.id] || App.unlockAll);\n    this.i = Math.max(0, this.list.findIndex((o) => o.id === opId));\n    this.dir = 0;\n    this.flip = 0;\n  }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings, 1, 0.5, 0);\n    App.director.play('ward');\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    const cam = ctx.camera.camera;\n    cam.position.set(TITLE_CAM.position[0] + Math.sin(this.t * 0.12) * 0.5, TITLE_CAM.position[1], TITLE_CAM.position[2]);\n    cam.lookAt(...TITLE_CAM.target);\n    this.flip = Math.max(0, this.flip - dt * 5);\n    if (overlay) return;\n    const d = App.devices;\n    if (!this.list.length) { if (d.nav.back || d.nav.confirm) toTitle(); return; }\n    if (d.nav.left) { this.i = (this.i + this.list.length - 1) % this.list.length; this.flip = 1; this.dir = -1; App.sfx('uiMove'); }\n    if (d.nav.right) { this.i = (this.i + 1) % this.list.length; this.flip = 1; this.dir = 1; App.sfx('uiMove'); }\n    const hitL = this.arrowL && this.ui.hit(...this.arrowL), hitR = this.arrowR && this.ui.hit(...this.arrowR);\n    if (d.click && hitL) { this.i = (this.i + this.list.length - 1) % this.list.length; this.flip = 1; App.sfx('uiMove'); return; }\n    if (d.click && hitR) { this.i = (this.i + 1) % this.list.length; this.flip = 1; App.sfx('uiMove'); return; }\n    if (d.nav.confirm || d.click) {\n      const op = this.list[this.i];\n      App.sfx('uiConfirm');\n      App.goto(new BriefingStage({ opId: op.id, mode: 'replay', difficulty: App.save.progress?.difficulty ?? 'resident', onBack: () => App.goto(new LogStage(op.id)) }), { camera: CLOSE_CAM });\n    }\n    if (d.nav.back || d.rightClick) { App.sfx('uiBack'); toTitle(); }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    ui.center(8, 'OPERATING LOG', { color: 'sand', scale: 2 });\n    if (!this.list.length) { ui.center(h / 2, 'NOTHING CLEARED YET.', { color: 'white' }); return; }\n    const op = this.list[this.i];\n    const r = App.save.log[op.id];\n    const cw = Math.min(300, w - 70), ch = 180;\n    const x = (w - cw) / 2 + this.flip * this.dir * 40, y = 32;\n    ui.clipboard(x, y, cw, ch);\n    const ink = 0x28203a;\n    ui.text(x + 12, y + 12, `OPERATION ${op.num}`, { color: 0x7a6a4a, shadow: false });\n    ui.text(x + 12, y + 22, op.title, { color: ink, scale: 2, shadow: false });\n    ui.text(x + 12, y + 44, op.patient.name, { color: ink, shadow: false });\n    ui.text(x + 12, y + 54, op.patient.job, { color: 0x7a6a4a, shadow: false });\n    ui.rect(x + 12, y + 66, cw - 24, 1, 0xa89a78);\n    const rank = r?.rank ?? 'C';\n    const lines = ui.wrap(op.patient.followUp[rank], cw - 26);\n    lines.slice(0, 4).forEach((l, i) => ui.text(x + 12, y + 74 + i * 10, l, { color: ink, shadow: false }));\n    if (r) {\n      ui.text(x + 12, y + ch - 30, `BEST SCORE ${r.total}`, { color: ink, shadow: false });\n      ui.stamp(x + cw - 34, y + ch - 32, r.rank, { S: 0xf4c430, A: 0x38b764, B: 0x3b5dc9, C: 0xb13e53 }[r.rank], 4);\n      if (r.pristine) ui.text(x + 12, y + ch - 19, 'PRISTINE', { color: 0xc99a1a, shadow: false });\n    }\n    this.arrowL = [x - 30, y + ch / 2 - 15, 24, 30];\n    this.arrowR = [x + cw + 6, y + ch / 2 - 15, 24, 30];\n    ui.text(x - 22, y + ch / 2 - 8, '<', { color: 'sand', scale: 2 });\n    ui.text(x + cw + 12, y + ch / 2 - 8, '>', { color: 'sand', scale: 2 });\n    ui.center(y + ch + 7, `${this.i + 1} / ${this.list.length}`, { color: 'mist' });\n    ui.hints([['confirm', 'OPERATE'], ['back', 'BACK']], h - 12);\n  }\n  status() { return `log ${this.list[this.i]?.id}`; }\n}\nexport { OperationStage, OP_CAMERA };\nEOF\ncat > src/stages/consult.js <<'EOF'\n// Consult on one TV: up to four seats, keyboard and mouse plus pads. Press to scrub in, back out to\n// leave, and seat one starts. Never touches the network outside a session.\nimport { App } from '../app.js';\nimport { CAMPAIGN_OPS, OPS, SESSION_OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { toTitle, CLOSE_CAM } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { Stage } from './stage.js';\n\nconst COLORS = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700];\nconst SPOTS = [[-1.9, 0, -2.2, 0.9], [1.9, 0, -2.2, -0.9], [-1.6, 0, -4, 0.6], [1.6, 0, -4, -0.6]];\n\nexport class ConsultStage extends Stage {\n  name = 'consult';\n  attractable = true;\n  cameraConfig = { preset: 'fixed', position: [0, 3.6, 3.8], target: [0, 1.1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  constructor() {\n    super();\n    this.seats = [];\n    this.opI = 0;\n    this.figs = [];\n  }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings);\n    App.director.play('or-calm');\n    // Pile-Up, or any cleared op except the triage and the finale.\n    this.ops = [OPS.pileup, ...SESSION_OPS.filter((o) => o.id !== 'pileup'), ...CAMPAIGN_OPS.filter((o) => (App.save.log[o.id] || App.unlockAll) && o.id !== 'op3' && o.id !== 'op9')];\n  }\n  refreshFigures(ctx) {\n    for (const f of this.figs) ctx.scene.remove(f.object);\n    this.figs = this.seats.map((s, i) => {\n      const f = new Figure(ctx, 'extra', SPOTS[i].slice(0, 3), SPOTS[i][3]);\n      const color = COLORS[i];\n      f.object.traverse((m) => { if (m.isMesh) { m.material = m.material.clone(); m.material.userData = { ...m.material.userData, shared: false }; } });\n      f.object.traverse((m) => { if (m.isMesh && m.name?.startsWith?.('scrub')) m.material.color.setHex(color); });\n      return f;\n    });\n  }\n  frame(ctx, dt, overlay) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs) f.update(dt);\n    if (overlay) return;\n    const d = App.devices;\n    const has = (b) => this.seats.findIndex((s) => s.binding === b);\n    // Scrub in.\n    const kbmIn = d.click || ctx.input.wasPressed('Enter') || ctx.input.wasPressed('Space');\n    const kbmOut = d.rightClick || ctx.input.wasPressed('Escape');\n    const joins = [];\n    if (kbmIn) joins.push('kbm');\n    d.pads.forEach((p, i) => { if (p.connected && p.edge[0]) joins.push(i); });\n    for (const b of joins) {\n      const at = has(b);\n      if (at === 0) {\n        // Seat one, again: start.\n        this.start();\n        return;\n      }\n      if (at < 0 && this.seats.length < 4) {\n        this.seats.push({ binding: b });\n        App.sfx('uiConfirm');\n        App.rumble({ strong: 0.3, weak: 0.3, ms: 120 }, typeof b === 'number' ? b : undefined);\n        this.refreshFigures(ctx);\n      }\n    }\n    // Leave.\n    const leaves = [];\n    if (kbmOut) leaves.push('kbm');\n    d.pads.forEach((p, i) => { if (p.connected && p.edge[1]) leaves.push(i); });\n    for (const b of leaves) {\n      const at = has(b);\n      if (at >= 0) { this.seats.splice(at, 1); App.sfx('uiBack'); this.refreshFigures(ctx); } else if (this.seats.length === 0) { toTitle(); return; }\n    }\n    if (d.nav.left) { this.opI = (this.opI + this.ops.length - 1) % this.ops.length; App.sfx('uiMove'); }\n    if (d.nav.right) { this.opI = (this.opI + 1) % this.ops.length; App.sfx('uiMove'); }\n    // Seat one may pick with tabs too.\n    if (d.nav.tabL) { this.opI = (this.opI + this.ops.length - 1) % this.ops.length; App.sfx('uiMove'); }\n    if (d.nav.tabR) { this.opI = (this.opI + 1) % this.ops.length; App.sfx('uiMove'); }\n  }\n  start() {\n    if (!this.seats.length) return;\n    App.sfx('uiConfirm');\n    const op = this.ops[this.opI];\n    App.goto(new OperationStage({ opId: op.id, mode: 'consult', difficulty: 'resident', seats: this.seats.map((s) => ({ binding: s.binding })), seed: Math.floor(Math.random() * 1e9) }), { kind: 'iris', camera: OP_CAMERA });\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    ui.center(8, 'CONSULT', { color: 'sand', scale: 3 });\n    ui.center(36, 'A SECOND PAIR OF HANDS', { color: 'mist' });\n    const cw = Math.min(100, (w - 30) / 4), gap = 6, total = cw * 4 + gap * 3;\n    const x0 = (w - total) / 2, y = 55;\n    for (let i = 0; i < 4; i++) {\n      const s = this.seats[i];\n      const x = x0 + i * (cw + gap);\n      ui.rect(x, y, cw, 70, s ? 'night' : 'ink');\n      ui.outline(x, y, cw, 70, s ? COLORS[i] : 'slate', s ? 2 : 1);\n      ui.text(x + 6, y + 6, `SEAT ${i + 1}`, { color: s ? COLORS[i] : 'slate', shadow: false });\n      if (s) {\n        ui.text(x + 6, y + 20, s.binding === 'kbm' ? 'KEYS+MOUSE' : `PAD ${s.binding + 1}`, { color: 'white', shadow: false });\n        ui.text(x + 6, y + 32, i % 2 === 0 ? 'THE QUIET' : 'SECOND LOOK', { color: 'cyan', shadow: false });\n        ui.text(x + 6, y + 52, 'READY', { color: 'lime', shadow: false });\n      } else {\n        const lw = ui.actionWidth('confirm');\n        ui.action(x + 6, y + 30, 'confirm');\n        ui.text(x + 6 + lw + 3, y + 31, 'SCRUB IN', { color: 'mist', shadow: false });\n      }\n    }\n    const op = this.ops?.[this.opI];\n    if (op) {\n      ui.panel(x0, y + 80, total, 50, 'navy', 'sand');\n      ui.text(x0 + 10, y + 86, op.title, { color: 'sand', scale: 2, shadow: false });\n      ui.text(x0 + 10, y + 106, `${op.patient.name}`, { color: 'white', shadow: false });\n      const obj = ui.wrap(op.patient.objective, total - 20);\n      ui.text(x0 + 10, y + 117, obj[0], { color: 'mist', shadow: false });\n      ui.text(x0 - 16, y + 96, '<', { color: 'sand', scale: 2 });\n      ui.text(x0 + total + 6, y + 96, '>', { color: 'sand', scale: 2 });\n    }\n    if (this.seats.length) {\n      const label = 'SEAT 1: ';\n      const lw = ui.hud.measure(label, 1).width + ui.actionWidth('confirm') + ui.hud.measure(' STARTS', 1).width + 2;\n      let x = (w - lw) / 2;\n      const yy = y + 138;\n      ui.text(x, yy, label, { color: COLORS[0] });\n      x += ui.hud.measure(label, 1).width;\n      x += ui.action(x, yy - 1, 'confirm') + 2;\n      ui.text(x, yy, ' STARTS');\n    }\n    ui.hints([['back', this.seats.length ? 'LEAVE' : 'BACK']], h - 12);\n  }\n  status() { return `consult seats=${this.seats.length} op=${this.ops?.[this.opI]?.id}`; }\n}\nexport { CLOSE_CAM };\nEOF\ncat > src/stages/attract.js <<'EOF'\n// Attract mode: a looping reel of real sim segments, played by the bot with cheats. Any input exits at\n// once to Title and is swallowed. It never touches saves or settings.\nimport { App } from '../app.js';\nimport { CLOSE_CAM, toTitle } from './flow.js';\nimport { OperationStage, OP_CAMERA } from './operation.js';\nimport { StoryStage } from './story.js';\n\nconst GOD = { god: true, infComposure: true, freezeClock: true, unlimitedMistakes: true };\nexport const REEL = [\n  { kind: 'story', scene: 'ep1', seconds: 18, label: 'A STORM. 3 A.M.' },\n  { kind: 'op', op: 'op1', stage: 1, seconds: 26 },\n  { kind: 'op', op: 'op2', stage: 2, seconds: 24 },\n  { kind: 'op', op: 'op3', stage: 0, seconds: 24 },\n  { kind: 'op', op: 'op4', stage: 1, seconds: 22 },\n  { kind: 'op', op: 'op5', stage: 2, seconds: 28, gift: 'quiet' },\n  { kind: 'op', op: 'op6', stage: 7, seconds: 22, gift: 'look', composure: 100 },\n  { kind: 'op', op: 'op7', stage: 3, seconds: 26, gift: 'quiet' },\n  { kind: 'op', op: 'op8', stage: 2, seconds: 30, gift: 'quiet' },\n  { kind: 'op', op: 'pileup', stage: 0, seconds: 24, seats: 4 },\n];\n\nlet reelIndex = 0;\nlet active = false;\n\nexport function startAttractReel(from = 0) {\n  reelIndex = from;\n  active = true;\n  App.inAttract = true;\n  playSegment();\n}\nfunction drawBanner(ui) {\n  const s = 'DEMO - PRESS ANY BUTTON';\n  const blink = Math.sin(performance.now() / 300) > -0.3;\n  const w = ui.hud.measure(s, 1).width + 12;\n  const x = (ui.w - w) / 2;\n  ui.rect(x, 28, w, 12, 'ink');\n  ui.outline(x, 28, w, 12, 'red');\n  if (blink) ui.text(x + 6, 30, s, { color: 'white', shadow: false });\n}\nfunction exitAttract() {\n  if (!active) return;\n  active = false;\n  App.inAttract = false;\n  App.idle = 0;\n  App.devices.swallow = 0.2;\n  toTitle('title');\n}\nfunction playSegment() {\n  if (!active) return;\n  const seg = REEL[reelIndex % REEL.length];\n  reelIndex = (reelIndex + 1) % REEL.length;\n  const watch = {\n    t: 0,\n    armed: 0,\n    frame(stage, ctx, dt) {\n      this.t += dt;\n      this.armed += dt;\n      // Touch-only devices let it run; anything else ends it.\n      if (!App.touchOnly && this.armed > 0.25 && (App.devices.anyPress || App.devices.mouseMoved || App.devices.last === 'pad' && App.devices.pads.some((p) => p.axes.some((a) => a) || p.down.some(Boolean)))) { exitAttract(); return; }\n      if (this.t >= seg.seconds && !App.loading) playSegment();\n    },\n    next() { if (!App.loading) playSegment(); },\n  };\n  if (seg.kind === 'story') {\n    const st = new StoryStage({ sceneId: seg.scene, auto: true, onDone: () => { if (active) playSegment(); }, attractLabel: (ui) => drawBanner(ui) });\n    const orig = st.frame.bind(st);\n    st.frame = (ctx, dt, ov) => { orig(ctx, dt, ov); watch.frame(st, ctx, dt); };\n    App.goto(st, { kind: 'dissolve', camera: CLOSE_CAM });\n    return;\n  }\n  const seats = Array.from({ length: seg.seats ?? 1 }, (_, i) => ({ bot: { skill: 0.55 + i * 0.1, god: true } }));\n  const stage = new OperationStage({ opId: seg.op, mode: 'attract', difficulty: 'resident', startStage: seg.stage, seed: 4242 + reelIndex, seats, gift: seg.gift, composure: seg.composure ?? 60, cheats: GOD, attract: watch, drawExtra: (s, ctx, ui) => drawBanner(ui) });\n  App.goto(stage, { kind: 'blinds', duration: 0.2, camera: OP_CAMERA });\n}\nexport const attractState = () => ({ active, reelIndex });\nEOF\ncat > src/ui/overlays.js <<'EOF'\n// Screens on top of a stage: On Call, Pause, Failure, Settings, About, Dev Mode. All on the HUD canvas,\n// navigable by pad, keys and mouse.\nimport { App } from '../app.js';\nimport { ABOUT_PAGES } from '../content/about.js';\nimport { OPS } from '../content/ops/index.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { DIFFICULTIES, resetConfig, SLIDERS } from '../core/config.js';\nimport { LOOK_CHOICES } from '../view/looks.js';\nimport { Menu } from './menu.js';\n\nconst pop = () => { App.overlays.pop(); };\nconst dim = (ui) => { for (let y = 0; y < ui.h; y += 2) ui.rect(0, y, ui.w, 1, 'ink'); };\nconst pct = (v) => `${Math.round(v * 100)}%`;\n\nexport class OnCallOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const prog = App.save.progress;\n    const items = [];\n    if (prog && !prog.finished) items.push({ label: 'CONTINUE', blurb: `EPISODE ${Math.min(10, prog.episode + 1)} OF 10. ${DIFFICULTIES[prog.difficulty].label}.`, onConfirm: () => this.cont() });\n    items.push({ label: 'NEW SHIFT', blurb: 'A STORM. 3 A.M. THE CHIEF IS UNREACHABLE.', onConfirm: () => this.pick() });\n    this.menu = new Menu(App, items, { w: 170, y: 110, rows: 3, onBack: pop });\n    this.pickMode = false;\n  }\n  async cont() { pop(); (await import('../stages/flow.js')).goCampaign(); }\n  pick() {\n    this.pickMode = true;\n    const items = Object.values(DIFFICULTIES).map((d) => ({ label: d.label, blurb: d.blurb, onConfirm: () => this.begin(d.id) }));\n    this.menu = new Menu(App, items, { w: 170, y: 110, rows: 3, start: 1, onBack: pop });\n  }\n  async begin(d) { App.newRun(d); App.save.settings.difficulty = d; pop(); (await import('../stages/flow.js')).goCampaign(); }\n  update(ui) { this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 230) / 2, 76, 230, 110);\n    ui.center(84, this.pickMode ? 'DIFFICULTY' : 'ON CALL', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\n\nexport class PauseOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const isOp = !!stage.sim;\n    const items = [{ label: 'RESUME', onConfirm: pop }];\n    if (isOp) {\n      items.push({ label: 'RETRY STAGE', blurb: 'BACK TO THE START OF THIS STAGE. RANK CAPPED AT B.', onConfirm: () => stage.retry() });\n      items.push({ label: 'RESTART', blurb: 'THE WHOLE OPERATION AGAIN.', onConfirm: () => { pop(); stage.restart(); } });\n    }\n    items.push({ label: 'SETTINGS', onConfirm: () => App.overlays.push(new SettingsOverlay(stage)) });\n    items.push({ label: 'DEV MODE', blurb: 'BALANCE, CHEATS, JUMP, ACTIONS, VIEW.', onConfirm: () => App.overlays.push(new DevOverlay(stage)) });\n    items.push({ label: 'QUIT TO MENU', blurb: 'YOUR SHIFT IS SAVED AT THE LAST OPERATION.', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    this.menu = new Menu(App, items, { w: 170, y: 76, rows: 6, onBack: pop });\n  }\n  update(ui) {\n    this.menu.update(ui);\n    if (App.devices.nav.start && App.overlays[App.overlays.length - 1] === this && !App.devices.nav.back) pop();\n  }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 220) / 2, 44, 220, 142);\n    ui.center(52, 'PAUSED', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'RESUME']]);\n  }\n}\n\nexport class FailOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    stage.fails = (stage.fails ?? 0) + 1;\n    this.line = stage.failReason === 'clock' ? 'Time. Time of death...' : stage.failReason === 'mistakes' ? 'Doctor. Step away from the table. Time of death...' : stage.failReason === 'cold' ? 'The kidney is gone. So is she. Time of death...' : 'Time of death...';\n    const items = [\n      { label: 'RETRY FROM THIS STAGE', blurb: 'RANK CAPPED AT B.', onConfirm: () => stage.retry() },\n      { label: 'RESTART', blurb: 'THE WHOLE OPERATION AGAIN.', onConfirm: () => { pop(); stage.restart(); } },\n    ];\n    const diff = stage.sim.diffId;\n    if (stage.fails >= 2 && diff !== 'intern') {\n      const lower = diff === 'attending' ? 'resident' : 'intern';\n      items.unshift({ label: `LOWER TO ${DIFFICULTIES[lower].label}`, blurb: 'NOBODY WILL KNOW. REYES WILL KNOW.', onConfirm: () => { if (App.save.progress) { App.save.progress.difficulty = lower; App.persist(); } pop(); stage.restart(lower); } });\n    }\n    if (stage.mode !== 'story') items.push({ label: 'QUIT', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    else items.push({ label: 'QUIT TO MENU', onConfirm: async () => { pop(); (await import('../stages/flow.js')).toTitle(); } });\n    this.menu = new Menu(App, items, { w: 220, y: 100, rows: 5 });\n    this.t = 0;\n  }\n  update(ui, dt) { this.t += dt; if (this.t > 0.4) this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.rect(0, 52, ui.w, 30, 'ink');\n    ui.center(55, 'FLATLINE', { color: 'red', scale: 2 });\n    ui.center(74, `NURSE REYES: \"${this.line}\"`, { color: 'white' });\n    ui.rect((ui.w - 250) / 2, 92, 250, 72, 'night');\n    ui.outline((ui.w - 250) / 2, 92, 250, 72, 'red');\n    this.menu.draw(ui);\n  }\n}\n\nexport class SettingsOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    const S = App.save.settings;\n    const audio = App.ctx.audio;\n    const step = (key, delta, min = 0, max = 1) => { S[key] = Math.round(Math.min(max, Math.max(min, S[key] + delta)) * 100) / 100; App.persist(); };\n    const cycle = (key, list, dir) => { const i = list.indexOf(S[key]); S[key] = list[(i + dir + list.length) % list.length]; App.persist(); };\n    const volMusic = (d) => { audio.setVolume('music', Math.round(Math.min(1, Math.max(0, audio.volume.music + d)) * 100) / 100); };\n    const volSfx = (d) => { step('sound', d); audio.setVolume('sfx', S.sound); App.sfx('uiMove'); };\n    const LOOKS = LOOK_CHOICES.map((l) => l[0]);\n    const row = (label, value, onLeft, onRight, blurb) => ({ label, value, onLeft, onRight, blurb });\n    const items = [\n      row('MUSIC', () => pct(audio.volume.music), () => volMusic(-0.05), () => volMusic(0.05), 'MUSIC STARTS AT 10%.'),\n      row('SOUND', () => pct(S.sound), () => volSfx(-0.05), () => volSfx(0.05)),\n      row('VOICES', () => pct(S.voices), () => step('voices', -0.05), () => { step('voices', 0.05); App.voiceChar('reyes', 'ah', 0); }),\n      row('BUTTON GLYPHS', () => (S.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), () => cycle('glyphs', ['playstation', 'xbox'], 1), () => cycle('glyphs', ['playstation', 'xbox'], 1)),\n      row('AIM ASSIST', () => S.aimAssist.toUpperCase(), () => cycle('aimAssist', ['off', 'low', 'high'], -1), () => cycle('aimAssist', ['off', 'low', 'high'], 1), 'STICKS AND KEYS ONLY.'),\n      row('CURSOR SPEED', () => pct(S.cursorSpeed), () => step('cursorSpeed', -0.05, 0.4, 2), () => step('cursorSpeed', 0.05, 0.4, 2)),\n      row('RUMBLE', () => (S.rumble ? 'ON' : 'OFF'), () => { S.rumble = !S.rumble; App.persist(); }, () => { S.rumble = !S.rumble; App.persist(); App.rumble({ strong: 0.6, weak: 0.4, ms: 150 }); }),\n      row('GIFT', () => S.giftMode.toUpperCase(), () => cycle('giftMode', ['hold', 'toggle'], 1), () => cycle('giftMode', ['hold', 'toggle'], 1), 'HOLD OR TOGGLE THE QUIET.'),\n      row('LOOK', () => LOOK_CHOICES[Math.max(0, LOOKS.indexOf(S.look))][1], () => { cycle('look', LOOKS, -1); this.refreshLook(); }, () => { cycle('look', LOOKS, 1); this.refreshLook(); }, 'ANY OF THE ENGINE\\'S LOOKS.'),\n      row('PIXEL SIZE', () => String(S.pixelSize), () => { step('pixelSize', -1, 1, 4); this.refreshLook(); }, () => { step('pixelSize', 1, 1, 4); this.refreshLook(); }),\n      row('SCREEN SHAKE', () => pct(S.shake), () => step('shake', -0.25), () => { step('shake', 0.25); App.shake(0.4); }),\n      row('REDUCE FLASHES', () => (S.reduceFlashes ? 'ON' : 'OFF'), () => { S.reduceFlashes = !S.reduceFlashes; App.persist(); }, () => { S.reduceFlashes = !S.reduceFlashes; App.persist(); }),\n      row('TEXT SPEED', () => pct(S.textSpeed), () => step('textSpeed', -0.25, 0.5, 3), () => step('textSpeed', 0.25, 0.5, 3)),\n      row('DIFFICULTY', () => DIFFICULTIES[App.save.progress?.difficulty ?? S.difficulty].label, () => this.diff(-1), () => this.diff(1), 'APPLIES FROM THE NEXT OPERATION.'),\n      { label: 'FULLSCREEN', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), onConfirm: () => this.fullscreen(), onRight: () => this.fullscreen(), onLeft: () => this.fullscreen() },\n      { label: 'RESET', blurb: 'EVERYTHING HERE BACK TO DEFAULTS.', onConfirm: () => { App.resetSettings(); pop(); App.overlays.push(new SettingsOverlay(stage)); } },\n    ];\n    this.menu = new Menu(App, items, { w: 300, y: 42, rows: 8, onBack: pop, rowH: 18 });\n  }\n  diff(dir) {\n    const list = Object.keys(DIFFICULTIES);\n    const cur = App.save.progress?.difficulty ?? App.save.settings.difficulty;\n    const next = list[(list.indexOf(cur) + dir + list.length) % list.length];\n    App.save.settings.difficulty = next;\n    if (App.save.progress) App.save.progress.difficulty = next;\n    App.persist();\n  }\n  refreshLook() {\n    App.engine._gameLook = null;\n    App.engine.setLook(App.engine.look);\n    if (this.stage.updateLook) this.stage.updateLook(App.ctx, true);\n    else import('../view/looks.js').then((m) => m.applyLook(App.engine, App.save.settings));\n  }\n  fullscreen() {\n    if (typeof document === 'undefined') return;\n    if (document.fullscreenElement) document.exitFullscreen?.();\n    else document.documentElement.requestFullscreen?.().catch(() => {});\n  }\n  update(ui) { this.menu.update(ui); }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 340) / 2, 12, 340, ui.h - 30);\n    ui.center(20, 'SETTINGS', { color: 'sand', scale: 2 });\n    this.menu.draw(ui);\n    ui.hints([['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\n\nexport class AboutOverlay {\n  constructor() {\n    this.page = 0;\n    this.line = 0;\n    this.pages = null;\n  }\n  layout(ui) {\n    if (this.pages) return;\n    const W = ui.w - 56;\n    this.pages = [];\n    for (const p of ABOUT_PAGES) {\n      const lines = [];\n      for (const [label, text] of p.rows) {\n        if (label) lines.push({ t: label, c: 'sand' });\n        for (const l of ui.wrap(String(text).toUpperCase().replace(/[^A-Z0-9 .,:;!?\\-+%/()[\\]'\"#&*=<>]/g, ' '), W)) lines.push({ t: l, c: 'white' });\n        lines.push({ t: '', c: 'white' });\n      }\n      const perPage = Math.floor((ui.h - 64) / 10);\n      for (let i = 0; i < lines.length; i += perPage) this.pages.push({ title: p.title, lines: lines.slice(i, i + perPage) });\n    }\n  }\n  update(ui) {\n    const d = App.devices;\n    this.layout(ui);\n    const flip = (dir) => { this.page = (this.page + dir + this.pages.length) % this.pages.length; App.sfx('uiMove'); };\n    if (d.nav.left || d.nav.tabL || d.nav.up) flip(-1);\n    if (d.nav.right || d.nav.tabR || d.nav.down || d.nav.confirm || d.click) flip(1);\n    if (d.wheel) flip(d.wheel > 0 ? 1 : -1);\n    if (d.nav.back || d.rightClick) { App.sfx('uiBack'); pop(); }\n  }\n  draw(ui) {\n    this.layout(ui);\n    dim(ui);\n    ui.panel(10, 8, ui.w - 20, ui.h - 22);\n    const p = this.pages[this.page];\n    ui.text(20, 14, p.title, { color: 'sand', scale: 2 });\n    ui.right(ui.w - 20, 16, `${this.page + 1}/${this.pages.length}`, { color: 'mist' });\n    p.lines.forEach((l, i) => ui.text(20, 36 + i * 10, l.t, { color: l.c, shadow: false }));\n    ui.hints([['back', 'BACK']]);\n  }\n}\n\n// ---------------------------------------------------------------- Dev Mode\nconst TABS = ['BALANCE', 'CHEATS', 'JUMP', 'ACTIONS', 'VIEW'];\nexport class DevOverlay {\n  constructor(stage) {\n    this.stage = stage;\n    this.tab = 0;\n    this.jumpOp = 0;\n    this.jumpStage = 0;\n    this.build();\n  }\n  build() {\n    const cfg = App.config;\n    const sim = this.stage.sim;\n    const dv = App.devView;\n    let items = [];\n    if (this.tab === 0) {\n      items = SLIDERS.map(([key, label, min, max, st]) => ({\n        label,\n        value: () => String(Math.round(cfg[key] * 100) / 100),\n        onLeft: () => { cfg[key] = Math.max(min, Math.round((cfg[key] - st) * 1000) / 1000); },\n        onRight: () => { cfg[key] = Math.min(max, Math.round((cfg[key] + st) * 1000) / 1000); },\n      }));\n      items.push({ label: 'RESET TO DEFAULTS', onConfirm: () => resetConfig(cfg) });\n    } else if (this.tab === 1) {\n      const ch = App.cheats;\n      const tog = (label, key) => ({ label, value: () => (ch[key] ? 'ON' : 'OFF'), onConfirm: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; }, onLeft: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; }, onRight: () => { ch[key] = !ch[key]; if (sim) sim.cheats = ch; } });\n      items = [tog('GOD VITALS', 'god'), tog('INFINITE COMPOSURE', 'infComposure'), tog('FREEZE CLOCK', 'freezeClock'), tog('UNLIMITED MISTAKES', 'unlimitedMistakes'),\n        { label: 'UNLOCK ALL', value: () => (App.unlockAll ? 'ON' : 'OFF'), onConfirm: () => { App.unlockAll = !App.unlockAll; } }];\n    } else if (this.tab === 2) {\n      const ids = Object.keys(OPS);\n      items = [\n        { label: 'OPERATION', value: () => OPS[ids[this.jumpOp]].title, onLeft: () => { this.jumpOp = (this.jumpOp + ids.length - 1) % ids.length; this.jumpStage = 0; }, onRight: () => { this.jumpOp = (this.jumpOp + 1) % ids.length; this.jumpStage = 0; } },\n        { label: 'STAGE', value: () => `${this.jumpStage + 1}: ${OPS[ids[this.jumpOp]].stages[this.jumpStage].id}`, onLeft: () => { const n = OPS[ids[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + n - 1) % n; }, onRight: () => { const n = OPS[ids[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + 1) % n; } },\n        { label: 'GO TO THAT STAGE', onConfirm: async () => { App.overlays.length = 0; const { OperationStage } = await import('../stages/operation.js'); App.goto(new OperationStage({ opId: ids[this.jumpOp], startStage: this.jumpStage, mode: 'replay', difficulty: 'resident', cheats: App.cheats })); } },\n        ...Object.keys(SCENES).map((id) => ({ label: `SCENE: ${SCENES[id].title}`, onConfirm: async () => { App.overlays.length = 0; const { StoryStage } = await import('../stages/story.js'); const { toTitle, CLOSE_CAM } = await import('../stages/flow.js'); App.goto(new StoryStage({ sceneId: id, onDone: () => toTitle() }), { camera: CLOSE_CAM }); } })),\n      ];\n    } else if (this.tab === 3) {\n      const act = (label, fn) => ({ label, onConfirm: () => { if (sim) import('../sim/op.js').then((m) => fn(m.dev, m)); } });\n      const closeAnd = (fn) => (dev, m) => { fn(dev, m); App.overlays.length = 0; };\n      items = [\n        act('COMPLETE STAGE', closeAnd((d) => d.completeStage(sim))),\n        act('WIN OP', closeAnd((d) => d.winOp(sim))),\n        act('FAIL OP', closeAnd((d) => d.failOp(sim))),\n        act('TRIGGER CODE BLUE', closeAnd((d) => d.codeBlue(sim))),\n        act('SPAWN POOL', (d) => d.spawn(sim, 'pool')),\n        act('SPAWN BLEEDER', (d) => d.spawn(sim, 'bleeder')),\n        act('SPAWN LACERATION', (d) => d.spawn(sim, 'laceration')),\n        act('SPAWN HOOK', (d) => d.spawn(sim, 'hook')),\n        act('SPAWN STRAIN', (d) => d.spawn(sim, 'strain')),\n        { label: 'COPY OP JSON TO CONSOLE', onConfirm: () => { console.log(JSON.stringify(this.stage.def ?? {}, null, 1)); this.toast = 'COPIED TO CONSOLE'; } },\n      ];\n    } else {\n      items = [\n        { label: 'HITBOX OVERLAY', value: () => (dv.hitboxes ? 'ON' : 'OFF'), onConfirm: () => { dv.hitboxes = !dv.hitboxes; } },\n        { label: 'BOT PLAYS', value: () => (dv.botPlays ? 'ON' : 'OFF'), onConfirm: () => { dv.botPlays = !dv.botPlays; } },\n        { label: 'BOT SKILL', value: () => dv.botSkill.toFixed(2), onLeft: () => { dv.botSkill = Math.max(0, Math.round((dv.botSkill - 0.05) * 100) / 100); }, onRight: () => { dv.botSkill = Math.min(1, Math.round((dv.botSkill + 0.05) * 100) / 100); } },\n        { label: 'SIM SPEED', value: () => `${dv.simSpeed.toFixed(1)}X`, onLeft: () => { dv.simSpeed = Math.max(0.1, Math.round((dv.simSpeed - 0.1) * 10) / 10); }, onRight: () => { dv.simSpeed = Math.min(3, Math.round((dv.simSpeed + 0.1) * 10) / 10); } },\n        { label: 'FRAME STEP', value: () => (dv.frameStep ? 'ON' : 'OFF'), onConfirm: () => { dv.frameStep = !dv.frameStep; }, blurb: 'WITH IT ON, THE TICK BELOW ADVANCES THE SIM.' },\n        { label: 'STEP ONE TICK', onConfirm: () => { dv.stepNow = true; } },\n        { label: 'FPS AND SIM STATS', value: () => (dv.stats ? 'ON' : 'OFF'), onConfirm: () => { dv.stats = !dv.stats; } },\n      ];\n    }\n    this.menu = new Menu(App, items, { w: 320, y: 46, rows: 11, rowH: 15, onBack: pop });\n  }\n  update(ui) {\n    const d = App.devices;\n    let tab = this.tab;\n    if (d.nav.tabL) tab = (tab + TABS.length - 1) % TABS.length;\n    if (d.nav.tabR) tab = (tab + 1) % TABS.length;\n    if (d.click) {\n      TABS.forEach((t, i) => {\n        const x = this.tabX(ui, i);\n        if (ui.hit(x, 22, 62, 14)) tab = i;\n      });\n    }\n    if (tab !== this.tab) { this.tab = tab; App.sfx('uiMove'); this.build(); return; }\n    this.menu.update(ui);\n  }\n  tabX(ui, i) { return (ui.w - TABS.length * 66) / 2 + i * 66; }\n  draw(ui) {\n    dim(ui);\n    ui.panel((ui.w - 372) / 2, 6, 372, ui.h - 20);\n    ui.center(10, 'DEV MODE', { color: 'lime' });\n    TABS.forEach((t, i) => {\n      const x = this.tabX(ui, i);\n      ui.rect(x, 22, 62, 14, i === this.tab ? 'navy' : 'ink');\n      ui.outline(x, 22, 62, 14, i === this.tab ? 'lime' : 'slate');\n      ui.text(x + 4, 25, t, { color: i === this.tab ? 'lime' : 'mist', shadow: false });\n    });\n    this.menu.draw(ui);\n    if (this.toast) ui.center(ui.h - 26, this.toast, { color: 'lime' });\n    ui.hints([['tabs', 'TAB'], ['confirm', 'OK'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/content/about.js <<'EOF'\n// The About/Credits screen: paged, big text. Filled in last.\nexport const ABOUT_PAGES = [\n  { title: 'CREDITS', rows: [['ALL ART AND AUDIO', 'written in code.']] },\n];\nEOF\ncat > src/ui/touchgate.js <<'EOF'\n// Touch-only devices: no touch controls. An overlay with the exact text, the engine's settings button,\n// the attract reel running behind. A key or a pad drops the gate and the game plays normally.\nexport function showTouchGate(App) {\n  const el = document.createElement('div');\n  el.id = 'touch-gate';\n  el.textContent = 'Controller or keyboard required';\n  el.style.cssText = 'position:fixed;left:0;right:0;bottom:12%;text-align:center;color:#f4f4f4;background:rgba(13,11,20,.86);font:bold 18px monospace;padding:14px 10px;z-index:50;pointer-events:none';\n  document.body.appendChild(el);\n  const drop = async () => {\n    if (!App.touchOnly) return;\n    App.touchOnly = false;\n    el.remove();\n    const { toTitle } = await import('../stages/flow.js');\n    toTitle('title');\n  };\n  window.addEventListener('keydown', drop, { once: true });\n  window.addEventListener('gamepadconnected', drop, { once: true });\n  const poll = setInterval(() => {\n    if (!App.touchOnly) { clearInterval(poll); return; }\n    if (Array.from(navigator.getGamepads?.() ?? []).some(Boolean)) { clearInterval(poll); drop(); }\n  }, 500);\n}\nEOF\nnode tools/build.mjs 2>&1 | tail -3 && node tests/browser/shot.mjs \"\" tests/tmp/title.png 3000 2>&1 | tail -4","description":"Write story, briefing, results, title, log, consult, attract, overlays","timeout":200000}}}
