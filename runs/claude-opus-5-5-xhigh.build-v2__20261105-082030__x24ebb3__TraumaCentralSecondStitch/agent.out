  if (ready) ui.text(stacked ? w - 44 : 112, yy, 'READY', { color: 'lime', shadow: false });\"\"\")\ns=s.replace(\"\"\"    const dx = w / 2 + 6;\n    ui.text(dx, y + 5, 'CONTROLS', { color: 'sand', shadow: false });\"\"\",\"\"\"    const dx = stacked ? 12 : w / 2 + 6;\n    const cy0 = stacked ? y + 50 : y + 5;\n    ui.text(dx, cy0, 'CONTROLS', { color: 'sand', shadow: false });\"\"\")\ns=s.replace(\"\"\"    cx += ui.action(cx, y + 15, 'move') + 3; ui.text(cx, y + 16, 'MOVE', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 15, 'use') + 3; ui.text(cx, y + 16, 'USE', { color: 'white', shadow: false });\n    cx = dx;\n    cx += ui.action(cx, y + 27, 'tool') + 3; ui.text(cx, y + 28, 'TOOL', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 27, 'gift') + 3; ui.text(cx, y + 28, 'GIFT', { color: 'white', shadow: false });\"\"\",\"\"\"    cx += ui.action(cx, cy0 + 10, 'move') + 3; ui.text(cx, cy0 + 11, 'MOVE', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, cy0 + 10, 'use') + 3; ui.text(cx, cy0 + 11, 'USE', { color: 'white', shadow: false });\n    cx = dx;\n    cx += ui.action(cx, cy0 + 22, 'tool') + 3; ui.text(cx, cy0 + 23, 'TOOL', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, cy0 + 22, 'gift') + 3; ui.text(cx, cy0 + 23, 'GIFT', { color: 'white', shadow: false });\"\"\")\ns=s.replace(\"\"\"    const by = y + 44;\n    const rw = 90, mw = 96;\n    this.readyBox = [dx, by, rw, 13];\n    this.moreBox = [dx + rw + 6, by, mw, 13];\"\"\",\"\"\"    const by = cy0 + 39;\n    const rw = Math.min(90, (w - 28) / 2 - 2), mw = Math.min(96, (w - 28) / 2 + 4);\n    this.readyBox = [dx, by, rw, 13];\n    this.moreBox = [dx + rw + 6, by, mw, 13];\"\"\")\ns=s.replace(\"\"\"    ui.text(dx, y + 64, msg, { color: 'white', shadow: false });\"\"\",\"\"\"    ui.text(dx, cy0 + 59, msg, { color: 'white', shadow: false });\"\"\")\nopen(p,'w').write(s)\np='src/ui/ophud.js'; s=open(p).read()\ns=s.replace(